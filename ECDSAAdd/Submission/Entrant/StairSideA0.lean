/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Win_at_StairSideA` -/
section Merge_StairField2V3Win_at_StairSideA

/-!
# LT47: the selected setup/X between two scratch windows (defect-2 fix)

The fixed program runs `unprefix ; setup ; X ; clearProgram` at both selected setup
sites (`SXW`).  On a state whose twelve window wires hold the window image of a clean
canonical state `s1` (`WinImg`), `unprefix` puts `s1` back on the window (`U_run`), the
setup reads the encoded packet 0 (`mix`), and `clearProgram` restores the window image
(`C_run`).  `sxw_bwd` / `sxw_fwd`: `SXW` maps the record state `t` to `sxState v t` and back.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3Win

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

/-! ## The window wires -/



theorem not_L {q : Wire} (h : ∀ r : Fin 12, FourScratchWindow.label r.val ≠ q) : q ∉ L := by
  rw [mem_L]
  rintro ⟨r, hr⟩
  exact h r hr

theorem label11 : FourScratchWindow.label 11 = base 1037 := by decide +kernel

theorem label_mem (q : Nat) : FourScratchWindow.label q ∈ L := by
  by_cases h : q < 12
  · exact mem_L.mpr ⟨⟨q, h⟩, rfl⟩
  · have e : FourScratchWindow.label q = base 1037 := by
      unfold FourScratchWindow.label
      split_ifs with h1 h2
      · exact absurd h1 (by omega)
      · exact absurd h2 (by omega)
      · rfl
    rw [e, ← label11]
    exact mem_L.mpr ⟨⟨11, by omega⟩, rfl⟩

theorem wires_U : wires FourScratchWindow.unprefix ⊆ L := by
  intro q hq
  rw [FourScratchWindow.supports.2.2] at hq
  exact hq

theorem wires_C : wires FourScratchWindow.clearProgram ⊆ L := by
  intro q hq
  rw [FourScratchWindow.supports.2.1] at hq
  exact hq


/-! ## Window states -/




theorem pull_eq_of (y s : State) (h : ∀ q ∈ L, y.basis q = s.basis q) :
    (FourScratchWindow.pull y).basis = (FourScratchWindow.pull s).basis :=
  funext fun q => h _ (label_mem q)

theorem clean_of_L (y s : State) (h : ∀ q ∈ L, y.basis q = s.basis q)
    (cl : FourScratchWindow.Clean s) : FourScratchWindow.Clean y := by
  unfold FourScratchWindow.Clean
  rw [pull_eq_of y s h]
  exact cl

theorem canon_of_L (y s : State) (h : ∀ q ∈ L, y.basis q = s.basis q) (cn : Canon s) :
    Canon y := by
  unfold Canon
  rw [← FourScratchWindow.code_compat, pull_eq_of y s h, FourScratchWindow.code_compat]
  exact cn


/-- `unprefix` on a window image puts the canonical state back on the window. -/
theorem U_run (t s1 : State) (h : WinImg t.basis s1) (m : List Bool) :
    run FourScratchWindow.unprefix m t = ⟨t.phase, mix t.basis s1⟩ := by
  obtain ⟨cl, cn, ag⟩ := h
  let s1' : State := ⟨t.phase, s1.basis⟩
  have cl' : FourScratchWindow.Clean s1' := cl
  have cn' : Prefix1590Codec.codeOf (FourScratchWindow.pull s1').basis ∈
      Prefix1590Codec.canonicalCodes := cn
  have rt : run FourScratchWindow.unprefix m (run FourScratchWindow.prefixProgram [] s1') = s1' :=
    FourScratchWindow.roundtrip s1' [] m cl' cn'
  have vph : (run FourScratchWindow.prefixProgram [] s1').phase = t.phase :=
    FourScratchWindow.prefix_phase s1' [] cl'
  have vb : ∀ q ∈ L, t.basis q = (run FourScratchWindow.prefixProgram [] s1').basis q := by
    intro q hq
    rw [ag q hq]
    exact congrFun (StairDivLoanTop.run_basis_records _ [] [] s1 s1' rfl) q
  have loc := run_measured_locality FourScratchWindow.unprefix L wires_U t _ m vph.symm vb
  apply State.extensionality
  · have hph : (run FourScratchWindow.unprefix m t).phase = s1'.phase :=
      loc.1.trans (congrArg State.phase rt)
    exact hph
  · funext q
    show (run FourScratchWindow.unprefix m t).basis q = (if q ∈ L then s1.basis q else t.basis q)
    by_cases hq : q ∈ L
    · rw [if_pos hq, loc.2 q hq, rt]
    · rw [if_neg hq]
      exact run_preserves_outside _ m t q (fun h => hq (wires_U h))

/-- `clearProgram` on a state that holds the clean canonical `s1` on the window. -/
theorem C_run (y s1 : State) (cl : FourScratchWindow.Clean s1) (cn : Canon s1)
    (hy : ∀ q ∈ L, y.basis q = s1.basis q) (m : List Bool) :
    run FourScratchWindow.clearProgram m y =
      ⟨y.phase, fun q => if q ∈ L then (run FourScratchWindow.prefixProgram [] s1).basis q
        else y.basis q⟩ := by
  have cly := clean_of_L y s1 hy cl
  have cny := canon_of_L y s1 hy cn
  rw [FourScratchWindow.clear_eq y m [] cly cny]
  apply State.extensionality
  · exact FourScratchWindow.prefix_phase y [] cly
  · funext q
    show (run FourScratchWindow.prefixProgram [] y).basis q =
      (if q ∈ L then (run FourScratchWindow.prefixProgram [] s1).basis q else y.basis q)
    by_cases hq : q ∈ L
    · rw [if_pos hq]
      exact local_basis _ wires_Pf y s1 hy [] [] q hq
    · rw [if_neg hq]
      exact run_preserves_outside _ [] y q (fun h => hq (wires_Pf h))

/-! ## `fieldRename` fixes the window -/

theorem renameCorrection_id' (c : Correction) : renameCorrection (fun q => q) c = c := by
  cases c <;> rfl

theorem renameProgram_id' (P : Program) : renameProgram (fun q => q) P = P := by
  induction P with
  | nil => rfl
  | cons i P ih =>
      have hc : renameCorrection (fun q => q) = id := funext renameCorrection_id'
      have hi : renameInstr (fun q => q) i = i := by
        cases i with
        | X q => rfl
        | CX a q => rfl
        | CCX a b q => rfl
        | measureX q c0 c1 => simp only [renameInstr, hc, List.map_id]
      show renameInstr (fun q => q) i :: renameProgram (fun q => q) P = i :: P
      rw [hi, ih]

theorem field_fix_labels : ∀ r : Fin 12,
    (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
      (HostOB5.hostSwap (FourScratchWindow.label r.val)) = FourScratchWindow.label r.val := by
  decide +kernel

theorem fR_fix (P : Program) (hP : wires P ⊆ L) : StairSchedule.fieldRename P = P := by
  unfold StairSchedule.fieldRename StairSchedule.parityRename
  rw [renameProgram_comp, renameProgram_congr_support _ (fun q => q) P, renameProgram_id']
  intro q hq
  obtain ⟨r, rfl⟩ := mem_L.mp (hP hq)
  exact field_fix_labels r

theorem fR_U : StairSchedule.fieldRename FourScratchWindow.unprefix = FourScratchWindow.unprefix :=
  fR_fix _ wires_U

theorem fR_C : StairSchedule.fieldRename FourScratchWindow.clearProgram =
    FourScratchWindow.clearProgram :=
  fR_fix _ wires_C

/-! ## The selected setup between the windows -/

/-- The selected setup/X of the fixed program, with the window end and restart. -/
def SXW : Program :=
  StairSchedule.fieldRename FourScratchWindow.unprefix ++ StairSchedule.paritySetup ++
    StairSchedule.hostedX ++ StairSchedule.fieldRename FourScratchWindow.clearProgram

theorem host_not_L : FrontierEntry1591Field.host ∉ L :=
  not_L (by decide +kernel)

theorem x511_not_L : base 511 ∉ L :=
  not_L (by decide +kernel)

theorem host_ne_511 : FrontierEntry1591Field.host ≠ base 511 := by decide

theorem mix_off (b : BasisState) (s1 : State) (q : Wire) (hq : q ∉ L) : mix b s1 q = b q := by
  unfold mix
  rw [if_neg hq]

theorem sxw_run (t s1 : State) (h : WinImg t.basis s1) (m : List Bool) :
    run SXW m t = ⟨t.phase, writeBit (writeBit t.basis FrontierEntry1591Field.host
      (t.basis FrontierEntry1591Field.host ^^
        TraceParity5.parity (FrontierEntry1591Field.controls.map (mix t.basis s1))))
      (base 511) (!t.basis (base 511))⟩ := by
  unfold SXW
  rw [fR_U, fR_C, run_append, run_append, run_append, U_run t s1 h,
    StairSchedule.paritySetup,
    ParityHost5.setup_run _ _ _ _ FrontierEntry1591Field.host_not_controls]
  dsimp only
  rw [StairSchedule.hostedX, HostOB5.host_xrun]
  dsimp only
  have mh : mix t.basis s1 FrontierEntry1591Field.host = t.basis FrontierEntry1591Field.host :=
    mix_off _ _ _ host_not_L
  have m5 : mix t.basis s1 (base 511) = t.basis (base 511) := mix_off _ _ _ x511_not_L
  rw [mh]
  generalize TraceParity5.parity (FrontierEntry1591Field.controls.map (mix t.basis s1)) = par
  have w5 : writeBit (mix t.basis s1) FrontierEntry1591Field.host
      (t.basis FrontierEntry1591Field.host ^^ par) (base 511) = t.basis (base 511) := by
    simp only [writeBit, Function.update_of_ne host_ne_511.symm, m5]
  rw [w5]
  have hy : ∀ q ∈ L, (⟨t.phase, writeBit (writeBit (mix t.basis s1) FrontierEntry1591Field.host
      (t.basis FrontierEntry1591Field.host ^^ par)) (base 511) (!t.basis (base 511))⟩ :
        State).basis q = s1.basis q := by
    intro q hq
    have q1 : q ≠ base 511 := fun e => x511_not_L (e ▸ hq)
    have q2 : q ≠ FrontierEntry1591Field.host := fun e => host_not_L (e ▸ hq)
    show writeBit (writeBit (mix t.basis s1) _ _) _ _ q = _
    simp only [writeBit, Function.update_of_ne q1, Function.update_of_ne q2, mix, if_pos hq]
  rw [C_run _ s1 h.1 h.2.1 hy]
  apply State.extensionality
  · rfl
  · funext q
    show (if q ∈ L then (run FourScratchWindow.prefixProgram [] s1).basis q else
        writeBit (writeBit (mix t.basis s1) FrontierEntry1591Field.host
          (t.basis FrontierEntry1591Field.host ^^ par)) (base 511) (!t.basis (base 511)) q) =
      writeBit (writeBit t.basis FrontierEntry1591Field.host
        (t.basis FrontierEntry1591Field.host ^^ par)) (base 511) (!t.basis (base 511)) q
    by_cases hq : q ∈ L
    · have q1 : q ≠ base 511 := fun e => x511_not_L (e ▸ hq)
      have q2 : q ≠ FrontierEntry1591Field.host := fun e => host_not_L (e ▸ hq)
      rw [if_pos hq]
      simp only [writeBit, Function.update_of_ne q1, Function.update_of_ne q2]
      exact (h.2.2 q hq).symm
    · rw [if_neg hq]
      by_cases q1 : q = base 511
      · subst q1
        simp only [writeBit, Function.update_self]
      · by_cases q2 : q = FrontierEntry1591Field.host
        · subst q2
          simp only [writeBit, Function.update_of_ne q1, Function.update_self]
        · simp only [writeBit, Function.update_of_ne q1, Function.update_of_ne q2]
          exact mix_off _ _ _ hq

/-- The state between `FT` and `SXW`: host holds `v`, `base 511` is set. -/
def sxState (v : Bool) (t : State) : State :=
  ⟨t.phase, writeBit (writeBit t.basis FrontierEntry1591Field.host v) (base 511) true⟩

theorem sxw_bwd (t s1 : State) (h : WinImg t.basis s1)
    (h0 : t.basis FrontierEntry1591Field.host = false) (h1 : t.basis (base 511) = false)
    (v : Bool)
    (hp : TraceParity5.parity (FrontierEntry1591Field.controls.map (mix t.basis s1)) = v)
    (m : List Bool) : run SXW m t = sxState v t := by
  rw [sxw_run t s1 h m, h0, h1, hp]
  simp only [Bool.false_xor, Bool.not_false]
  rfl

theorem sx_mix_controls (t s1 : State) (v : Bool) :
    FrontierEntry1591Field.controls.map (mix (sxState v t).basis s1) =
      FrontierEntry1591Field.controls.map (mix t.basis s1) := by
  apply List.map_congr_left
  intro c hc
  have c1 : c ≠ base 511 := fun e => by
    have : base 511 ∈ FrontierEntry1591Field.controls := e ▸ hc
    exact absurd this (by decide +kernel)
  have c2 : c ≠ FrontierEntry1591Field.host := fun e =>
    FrontierEntry1591Field.host_not_controls (e ▸ hc)
  show (if c ∈ L then s1.basis c else (sxState v t).basis c) =
    (if c ∈ L then s1.basis c else t.basis c)
  split_ifs
  · rfl
  · show writeBit (writeBit t.basis _ _) _ _ c = _
    simp only [writeBit, Function.update_of_ne c1, Function.update_of_ne c2]

theorem sxw_fwd (t s1 : State) (h : WinImg t.basis s1)
    (h0 : t.basis FrontierEntry1591Field.host = false) (h1 : t.basis (base 511) = false)
    (v : Bool)
    (hp : TraceParity5.parity (FrontierEntry1591Field.controls.map (mix t.basis s1)) = v)
    (m : List Bool) : run SXW m (sxState v t) = t := by
  have h' : WinImg (sxState v t).basis s1 := by
    refine ⟨h.1, h.2.1, fun q hq => ?_⟩
    have q1 : q ≠ base 511 := fun e => x511_not_L (e ▸ hq)
    have q2 : q ≠ FrontierEntry1591Field.host := fun e => host_not_L (e ▸ hq)
    show writeBit (writeBit t.basis _ _) _ _ q = _
    simp only [writeBit, Function.update_of_ne q1, Function.update_of_ne q2]
    exact h.2.2 q hq
  rw [sxw_run _ s1 h' m, sx_mix_controls, hp]
  apply State.extensionality
  · rfl
  · funext q
    show writeBit (writeBit (writeBit (writeBit t.basis FrontierEntry1591Field.host v)
        (base 511) true) FrontierEntry1591Field.host
        (writeBit (writeBit t.basis FrontierEntry1591Field.host v) (base 511) true
          FrontierEntry1591Field.host ^^ v)) (base 511)
        (!writeBit (writeBit t.basis FrontierEntry1591Field.host v) (base 511) true (base 511)) q =
      t.basis q
    by_cases q1 : q = base 511
    · subst q1
      simp only [writeBit, Function.update_self, Bool.not_true, h1]
    · by_cases q2 : q = FrontierEntry1591Field.host
      · subst q2
        simp only [writeBit, Function.update_of_ne q1, Function.update_self,
          Function.update_of_ne host_ne_511, Bool.xor_self, h0]
      · simp only [writeBit, Function.update_of_ne q1, Function.update_of_ne q2]

