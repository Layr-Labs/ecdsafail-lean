/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Trace_at_QTop` -/
section Merge_StairField2V3Trace_at_QTop

/-!
# LT21: transcript and packet-prefix facts for the segment spec

* `trace_getElem?`, `origin_letters`: `TraceOK x origin` puts the record's
  trace codes `code (next^[j] r0)` on the transcript letters.
* `encodePrefix_eq_allEncode`: the walk's packet prefix at a packet boundary is
  `allEncode` of the completed packets.
* `allEncode_packet`: on a packet's own sites, `allEncode` acts as that
  packet's encoder alone (any injective pool map).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Trace

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg

theorem trace_getElem? : ∀ (n : Nat) (r : SkywalkRails.State) (j : Nat), j < n →
    (SkywalkTrace.trace n r)[j]? = some (SkywalkTrace.code (SkywalkTrace.next^[j] r))
  | 0, _, j, h => absurd h (Nat.not_lt_zero j)
  | n + 1, r, 0, _ => rfl
  | n + 1, r, j + 1, h => by
      have ih := trace_getElem? n (SkywalkTrace.next r) j (by omega)
      simp only [SkywalkTrace.trace, List.getElem?_cons_succ]
      rw [ih, Function.iterate_succ_apply]

theorem origin_letters (x : Nat) (origin : BasisState) (hx : TraceOK x origin) (j : Nat)
    (hj : j < 512) :
    origin (base j) = (SkywalkTrace.code (SkywalkTrace.next^[j]
        (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).1 ∧
    origin (base (1028 + j)) = (SkywalkTrace.code (SkywalkTrace.next^[j]
        (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).2 := by
  have h1 := congrArg (fun l => l[j]?) hx.2.2.1
  simp only [skywalkTapeControls, skywalkSharedTape, List.map_map, List.getElem?_map,
    List.getElem?_range hj, Option.map_some, Function.comp_apply] at h1
  rw [trace_getElem? 512 _ j hj] at h1
  have h2 := Option.some.inj h1
  exact ⟨congrArg Prod.fst h2, congrArg Prod.snd h2⟩

/-! ## Packet prefixes -/

theorem packAfter_not_due (w : Nat → Wire) (n : Nat) (h : n % 5 ≠ 0) :
    Rolling1588.Integer.packAfter w true n = [] := by
  unfold Rolling1588.Integer.packAfter History5.packDue
  simp [h]

theorem packAfter_due (w : Nat → Wire) (a : Nat) :
    Rolling1588.Integer.packAfter w true (5 * a + 5) = Rolling1588.encodeGroup w true a := by
  unfold Rolling1588.Integer.packAfter History5.packDue Rolling1588.Integer.encode
    Rolling1588.encodeGroup
  have e : 5 * a + 5 - 5 = 5 * a := by omega
  by_cases ha : a = 0
  · subst ha; simp
  · simp [e, ha]

theorem prefix_step (w : Nat → Wire) (n : Nat) :
    Rolling1588.Integer.encodePrefix w true (n + 1) =
      Rolling1588.Integer.encodePrefix w true n ++ Rolling1588.Integer.packAfter w true n := rfl

theorem prefix_four (w : Nat → Wire) (n : Nat) :
    Rolling1588.Integer.encodePrefix w true (n + 4) =
      Rolling1588.Integer.encodePrefix w true n ++ Rolling1588.Integer.packAfter w true n ++
        Rolling1588.Integer.packAfter w true (n + 1) ++ Rolling1588.Integer.packAfter w true (n + 2) ++
        Rolling1588.Integer.packAfter w true (n + 3) := by
  show Rolling1588.Integer.encodePrefix w true (n + 3 + 1) = _
  rw [prefix_step]
  show Rolling1588.Integer.encodePrefix w true (n + 2 + 1) ++ _ = _
  rw [prefix_step]
  show Rolling1588.Integer.encodePrefix w true (n + 1 + 1) ++ _ ++ _ = _
  rw [prefix_step, prefix_step]

theorem encodePrefix_boundary_of (w : Nat → Wire) (a : Nat)
    (h1 : Rolling1588.Integer.encodePrefix w true (5 * a + 1) = Rolling1588.allEncode w true a) :
    Rolling1588.Integer.encodePrefix w true (5 * a + 5) = Rolling1588.allEncode w true a := by
  have e := prefix_four w (5 * a + 1)
  rw [show 5 * a + 1 + 4 = 5 * a + 5 by omega] at e
  rw [e, h1, packAfter_not_due w (5 * a + 1) (by omega), packAfter_not_due w (5 * a + 1 + 1) (by omega),
    packAfter_not_due w (5 * a + 1 + 2) (by omega), packAfter_not_due w (5 * a + 1 + 3) (by omega)]
  simp

theorem encodePrefix_eq_allEncode (w : Nat → Wire) : ∀ a,
    Rolling1588.Integer.encodePrefix w true (5 * a + 1) = Rolling1588.allEncode w true a
  | 0 => by
      show Rolling1588.Integer.encodePrefix w true (0 + 1) = []
      rw [prefix_step]
      simp [Rolling1588.Integer.encodePrefix, Rolling1588.Integer.packAfter, History5.packDue]
  | a + 1 => by
      have ih := encodePrefix_eq_allEncode w a
      have hb := encodePrefix_boundary_of w a ih
      show Rolling1588.Integer.encodePrefix w true ((5 * a + 5) + 1) = _
      rw [prefix_step, hb, packAfter_due]
      rfl

theorem encodePrefix_boundary (w : Nat → Wire) (a : Nat) :
    Rolling1588.Integer.encodePrefix w true (5 * a + 5) = Rolling1588.allEncode w true a :=
  encodePrefix_boundary_of w a (encodePrefix_eq_allEncode w a)

/-- On packet `k`'s own sites, `allEncode a` acts as packet `k`'s encoder. -/
theorem allEncode_packet (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (k : Nat) :
    ∀ a, k < a → 5 * a ≤ 512 → ∀ (raw : State) (q : Wire),
      q ∈ wires (Rolling1588.encodeGroup w true k) →
      (run (Rolling1588.allEncode w true a) [] raw).basis q =
        (run (Rolling1588.encodeGroup w true k) [] raw).basis q
  | 0, h, _, _, _, _ => absurd h (Nat.not_lt_zero k)
  | a + 1, h, hb, raw, q, hq => by
      have hsplit : Rolling1588.allEncode w true (a + 1) =
          Rolling1588.allEncode w true a ++ Rolling1588.encodeGroup w true a := rfl
      rw [hsplit, run_append]
      simp only [List.take_nil, List.drop_nil]
      by_cases hka : k = a
      · subst hka
        have dis := Rolling1588.allEncode_disjoint w true hn k k (by omega) le_rfl (by omega)
        have agree : ∀ r ∈ wires (Rolling1588.encodeGroup w true k),
            (run (Rolling1588.allEncode w true k) [] raw).basis r = raw.basis r := fun r hr =>
          run_preserves_outside _ _ _ r (fun h => Finset.disjoint_left.mp dis h hr)
        exact (ECDSAAdd.Arithmetic.run_local_increment _ _ raw [] agree).2 q hq
      · have ih := allEncode_packet w hn k a (by omega) (by omega) raw q hq
        have dis := Rolling1588.windows_disjoint w true hn k a (by omega) (by omega) (by omega)
        rw [run_preserves_outside _ _ _ q (fun h => Finset.disjoint_left.mp dis hq h)]
        exact ih


end ECDSAAdd.Entrant.StairField2V3Trace

end
end Merge_StairField2V3Trace_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Unpack_at_QTop` -/
section Merge_StairField2V3Unpack_at_QTop

/-!
# LT21: unpacking a stored v3 checkpoint

From the relocated compact checkpoint `cmpBits B x` on the row's future payload
and clean row scratch, `unrelocate B` yields LT1's `CompactCode` of the walk at
the row start (`compactCode_after_unrelocate`), and the codec unpack (field 1,
proved) yields `CodecInput` (`codecInput_after_unpack`).  Generic in the row,
per-row data are `decide +kernel` list facts (`rowFacts`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Unpack

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec



/-! ## Arithmetic -/

theorem foldl_range_lt (c : Nat → Bool) : ∀ (n a : Nat),
    (List.range n).foldl (fun acc j => if c j then acc + 2 ^ j else acc) a < a + 2 ^ n
  | 0, a => by simp
  | n + 1, a => by
      rw [List.range_succ, List.foldl_append]
      have ih := foldl_range_lt c n a
      simp only [List.foldl_cons, List.foldl_nil]
      split
      · rw [pow_succ]; omega
      · rw [pow_succ]; omega

theorem compactF_lt (B w v : Nat) : StairCodec.compactF B w v < 2 ^ (B - 2) := by
  unfold StairCodec.compactF
  have h := foldl_range_lt
    (fun j => ((if j + 1 = StairCodec.natBitLength w then false else w.testBit j) ^^
      ((v - 1) / 2).testBit (B - 3 - j))) (B - 2) 0
  simpa using h

theorem lt_pow_natBitLength (x : Nat) : x < 2 ^ StairCodec.natBitLength x := by
  unfold StairCodec.natBitLength
  split
  · simp_all
  · exact Nat.lt_log2_self

theorem natBitLength_mono (a b : Nat) (h : a ≤ b) :
    StairCodec.natBitLength a ≤ StairCodec.natBitLength b :=
  StairBridgeDomain.natBitLength_le_of_lt_pow a _ (lt_of_le_of_lt h (lt_pow_natBitLength b))

/-- The compact word `F + σ·2^(B-2)`: low bits and the sign bit. -/
theorem word_low (F k : Nat) (σ : Bool) (hF : F < 2 ^ k) :
    (F + σ.toNat * 2 ^ k) % 2 ^ k = F := by
  rw [Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hF]

theorem word_sign (F k : Nat) (σ : Bool) (hF : F < 2 ^ k) :
    (F + σ.toNat * 2 ^ k).testBit k = σ := by
  rw [Nat.testBit_eq_decide_div_mod_eq]
  have hpos : 0 < 2 ^ k := by positivity
  have hd : (F + σ.toNat * 2 ^ k) / 2 ^ k = σ.toNat := by
    rw [Nat.add_mul_div_right _ _ hpos, Nat.div_eq_of_lt hF, Nat.zero_add]
  rw [hd]
  cases σ <;> simp

/-! ## Row data -/

def cleanList (B : Nat) : List Wire :=
  StairCodec.reg (physicalLayout B).C (B - 2) ++ [(physicalLayout B).z, (physicalLayout B).t] ++
    (StairCodec.lowDecoder (physicalLayout B) B).sites ++
    (StairCodec.highDecoder (physicalLayout B) B).sites

def aReg (B : Nat) : List Wire := StairCodec.reg (physicalLayout B).A (StairCodec.bitWidth B)

/-- All per-row list facts used below. -/
def RowFacts (B : Nat) : Prop :=
  3 ≤ B ∧ B ≤ 87 ∧
  (moveSites (unrelocPairs B)).Nodup ∧
  restLetters B = (List.range (B - 1)).map (physicalLayout B).S ∧
  (restLetters B).Nodup ∧
  (∀ q ∈ restLetters B, q ∈ futurePayload B) ∧
  (physicalLayout B).D (B - 2) ∉ moveSites (unrelocPairs B) ∧
  (∀ i, i < B → (physicalLayout B).D i ∈ rowSites B ∧ (physicalLayout B).D i ∉ futurePayload B) ∧
  ((physicalLayout B).S (B - 1) ∈ rowSites B ∧ (physicalLayout B).S (B - 1) ∉ futurePayload B ∧
    (physicalLayout B).S (B - 1) ∉ moveSites (unrelocPairs B)) ∧
  (aReg B).Nodup ∧
  (∀ q ∈ aReg B, q ∈ futurePayload B ∧ q ∉ restLetters B ∧ q ∉ moveSites (unrelocPairs B)) ∧
  (∀ q ∈ cleanList B, q ∉ moveSites (unrelocPairs B) ∧ q ∉ restLetters B ∧ q ∉ aReg B ∧
    (q ∈ futurePayload B ∨ (q ∈ rowSites B ∧ q ∉ futurePayload B)))







/-! ## Unrelocation -/

section
variable (B : Nat) (hR : RowFacts B) (x : Nat)

/-- The compact word stored at rest. -/
def restWord : Nat :=
  let z := StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)
  let σ := StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)
  StairCodec.compactF B (z.u - σ.toNat) z.v + σ.toNat * 2 ^ (B - 2)

def lenWord : Nat :=
  let z := StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)
  let σ := StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)
  StairCodec.natBitLength (z.u - σ.toNat)

theorem cmpBits_eq (r : Wire) :
    cmpBits B x r = (StairCodec.registerBasis (restLetters B) (restWord B x) r ||
      StairCodec.registerBasis (aReg B) (lenWord B x) r) := rfl

end

theorem reg_length' (f : Nat → Wire) (n : Nat) : (StairCodec.reg f n).length = n := by
  simp [StairCodec.reg]

theorem reg_getElem (f : Nat → Wire) (n i : Nat) (hi : i < (StairCodec.reg f n).length) :
    (StairCodec.reg f n)[i] = f i := by
  simp [StairCodec.reg]

theorem lenWord_lt (B x : Nat) (h3 : 3 ≤ B)
    (hdom : StairCodec.CodecDomain B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B))) :
    lenWord B x < 2 ^ StairCodec.bitWidth B := by
  obtain ⟨_, hv, _, _, hbits, _⟩ := hdom
  set z := StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)
  set σ := StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)
  have hv1 : 1 ≤ StairCodec.natBitLength z.v := by
    unfold StairCodec.natBitLength
    rw [if_neg (by omega)]
    omega
  have hw : StairCodec.natBitLength (z.u - σ.toNat) ≤ StairCodec.natBitLength z.u :=
    natBitLength_mono _ _ (Nat.sub_le _ _)
  have hlog : B - 1 < 2 ^ ((B - 1).log2 + 1) := Nat.lt_log2_self
  change StairCodec.natBitLength (z.u - σ.toNat) < 2 ^ ((B - 1).log2 + 1)
  omega

theorem compactCode_after_unrelocate (B : Nat) (hR : RowFacts B) (x : Nat)
    (hdom : StairCodec.CodecDomain B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)))
    (u : State)
    (pre1 : ∀ r ∈ futurePayload B, u.basis r = cmpBits B x r)
    (pre2 : ∀ r ∈ rowSites B, r ∉ futurePayload B → u.basis r = false) (m : List Bool) :
    (run (unrelocate B) m u).phase = u.phase ∧
    StairCodec.CompactCode (physicalLayout B) B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)) (run (unrelocate B) m u).basis ∧
    ∀ q, q ∉ moveSites (unrelocPairs B) → (run (unrelocate B) m u).basis q = u.basis q := by
  obtain ⟨h3, h87, hnod, hrest, hrestN, hrestF, hD2, hD, hS, haN, haF, hcl⟩ := hR
  have ok := moveOK_of_nodup _ hnod
  have targets : ∀ q ∈ unrelocPairs B, u.basis q.2 = false := by
    intro q hq
    simp only [unrelocPairs, List.mem_cons, List.mem_map, List.mem_range] at hq
    rcases hq with rfl | ⟨i, hi, rfl⟩
    · exact pre2 _ (hD (B - 1) (by omega)).1 (hD (B - 1) (by omega)).2
    · exact pre2 _ (hD i (by omega)).1 (hD i (by omega)).2
  have mr := moveProgram_run (unrelocPairs B) ok u m targets
  rw [unrelocate_eq]
  set u1 := run (moveProgram (unrelocPairs B)) m u with hu1
  obtain ⟨hph, hmv, hout⟩ := mr
  -- the stored letters
  have restS : ∀ i (hi : i < B - 1), (restLetters B)[i]'(by simp [restLetters]; omega) =
      (physicalLayout B).S i := by
    intro i hi
    simp [hrest]
  have cmpRest : ∀ i (hi : i < B - 1), u.basis ((physicalLayout B).S i) =
      (restWord B x).testBit i := by
    intro i hi
    have hlen : i < (restLetters B).length := by simp [restLetters]; omega
    have hmem : (restLetters B)[i] ∈ restLetters B := List.getElem_mem hlen
    rw [← restS i hi, pre1 _ (hrestF _ hmem), cmpBits_eq,
      registerBasis_get _ hrestN _ _ hlen,
      registerBasis_not_mem _ _ _ (fun h => (haF _ h).2.1 hmem)]
    simp
  have hF := compactF_lt B
    ((StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u -
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)).toNat)
    (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
  refine ⟨hph, ⟨?_, ?_, ?_, ?_, ?_, ?_⟩, hout⟩
  · -- length bits
    have hb := regValue_of_bits (aReg B) u1.basis (lenWord B x) (by
      intro i hi
      have hmem : (aReg B)[i] ∈ aReg B := List.getElem_mem hi
      rw [hout _ (haF _ hmem).2.2, pre1 _ (haF _ hmem).1, cmpBits_eq,
        registerBasis_not_mem _ _ _ (haF _ hmem).2.1, registerBasis_get _ haN _ _ hi]
      simp)
    have hlt := lenWord_lt B x h3 hdom
    simp only [aReg, reg_length'] at hb
    rw [Nat.mod_eq_of_lt hlt] at hb
    exact hb
  · -- merged field
    have hb := regValue_of_bits (StairCodec.reg (physicalLayout B).D (B - 2)) u1.basis
      (restWord B x) (by
        intro i hi
        have hi' : i < B - 2 := by simpa [reg_length'] using hi
        rw [reg_getElem]
        have hp : ((physicalLayout B).S i, (physicalLayout B).D i) ∈ unrelocPairs B := by
          simp only [unrelocPairs, List.mem_cons, List.mem_map, List.mem_range]
          exact Or.inr ⟨i, hi', rfl⟩
        rw [(hmv _ hp).1]
        exact cmpRest i (by omega))
    rw [hb, reg_length', restWord]
    exact word_low _ _ _ hF
  · -- D (B-2) clean
    rw [hout _ hD2]
    exact pre2 _ (hD (B - 2) (by omega)).1 (hD (B - 2) (by omega)).2
  · -- sign
    have hp : ((physicalLayout B).S (B - 2), (physicalLayout B).D (B - 1)) ∈ unrelocPairs B := by
      simp [unrelocPairs]
    rw [(hmv _ hp).1, cmpRest (B - 2) (by omega), restWord]
    exact word_sign _ _ _ hF
  · -- sum rail cleared
    have hb := regValue_of_bits (StairCodec.reg (physicalLayout B).S B) u1.basis 0 (by
      intro i hi
      have hi' : i < B := by simpa [reg_length'] using hi
      rw [reg_getElem, Nat.zero_testBit]
      by_cases hlast : i = B - 1
      · subst hlast
        rw [hout _ hS.2.2]
        exact pre2 _ hS.1 hS.2.1
      · by_cases hsig : i = B - 2
        · subst hsig
          have hp : ((physicalLayout B).S (B - 2), (physicalLayout B).D (B - 1)) ∈
              unrelocPairs B := by simp [unrelocPairs]
          exact (hmv _ hp).2
        · have hp : ((physicalLayout B).S i, (physicalLayout B).D i) ∈ unrelocPairs B := by
            simp only [unrelocPairs, List.mem_cons, List.mem_map, List.mem_range]
            exact Or.inr ⟨i, by omega, rfl⟩
          exact (hmv _ hp).2)
    rw [hb, Nat.zero_mod]
  · -- clean work
    intro q hq
    obtain ⟨hm, hr, ha, hloc⟩ := hcl q hq
    rw [hout _ hm]
    rcases hloc with hf | ⟨hrow, hf⟩
    · rw [pre1 _ hf, cmpBits_eq, registerBasis_not_mem _ _ _ hr, registerBasis_not_mem _ _ _ ha]
      rfl
    · exact pre2 _ hrow hf






end ECDSAAdd.Entrant.StairField2V3Unpack

end
end Merge_StairField2V3Unpack_at_QTop

