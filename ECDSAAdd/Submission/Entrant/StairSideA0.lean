/-! ## Soundness and its composition -/


theorem sound_append {P Q : Program} (hP : Sound P) (hQ : Sound Q) :
    Sound (P ++ Q) :=
  ⟨(gatePhysical_append P Q).mpr ⟨hP.physical, hQ.physical⟩,
    good_append.mpr ⟨hP.good, hQ.good⟩⟩

theorem sound_rename (f : Wire → Wire) (inj : Function.Injective f)
    (hf : ∀ q, InDom q → InDom (f q)) {P : Program} (hP : Sound P) :
    Sound (renameProgram f P) :=
  ⟨gatePhysical_rename f inj P hP.physical, good_rename f hf hP.good⟩

theorem gp_left {P Q : Program} (h : GatePhysical (P ++ Q)) : GatePhysical P :=
  ((gatePhysical_append P Q).mp h).1

theorem gp_right {P Q : Program} (h : GatePhysical (P ++ Q)) : GatePhysical Q :=
  ((gatePhysical_append P Q).mp h).2

theorem unrename_physical (f : Wire → Wire) (P : Program)
    (hp : GatePhysical (renameProgram f P)) : GatePhysical P := by
  intro i hi
  have h := hp (renameInstr f i) (List.mem_map.mpr ⟨i, hi, rfl⟩)
  cases i with
  | X _ => trivial
  | CX _ _ => exact fun e => h (congrArg f e)
  | CCX _ _ _ =>
      exact ⟨fun e => h.1 (congrArg f e),
        fun e => h.2 (congrArg f e)⟩
  | measureX _ _ _ => trivial

theorem sound_sig (i : Nat) (hi : i < 512) {P : Program} (hP : Sound P) :
    Sound (renameProgram (OB5.sig i) P) :=
  sound_rename _ (OB5.sig_injective i (by omega)) (indom_sig i (by omega)) hP

theorem sound_borrow {P : Program} (hP : Sound P) :
    Sound (renameProgram Prefix1590.borrow P) :=
  sound_rename _ Prefix1590.borrow.injective indom_borrow hP

theorem sound_phaseHost {P : Program} (hP : Sound P) :
    Sound (renameProgram Rolling1588Lifetime.phaseHost P) :=
  sound_rename _ Rolling1588Lifetime.phaseHost.injective indom_phaseHost hP

theorem sound_fieldRename {P : Program} (hP : Sound P) :
    Sound (StairSchedule.fieldRename P) :=
  ⟨gatePhysical_rename _ (Equiv.swap
      FrontierEntry1591Field.work FrontierEntry1591Field.host).injective _
      (gatePhysical_rename _ HostOB5.hostSwap_injective _ hP.physical),
    good_fieldRename hP.good⟩

