theorem unpackCutFront_counts (L : Layout) (B j kind : Nat) :
    toffoliCount (unpackCutFront L B j kind) + unpackCutSaves kind = 1 ∧
      measurementCount (unpackCutFront L B j kind) = 0 := by
  unfold unpackCutFront unpackCutSaves
  split_ifs <;> simp [toffoliCount, measurementCount]

theorem unpackStepX_counts (L : Layout) (B j : Nat) (hj : j < B - 2) :
    toffoliCount (unpackStepX L B j) + unpackCutSaves (unpackCutKind B j) = 2 ∧
      measurementCount (unpackStepX L B j) = 1 := by
  have htail : toffoliCount (unpackStep L B j).tail = 1 ∧
      measurementCount (unpackStep L B j).tail = 1 := by
    simp [unpackStep, hj, toffoliCount, measurementCount]
  have hfront := unpackCutFront_counts L B j (unpackCutKind B j)
  rw [unpackStepX, toffoliCount_append, measurementCount_append]
  omega

theorem flatMap_saving_counts (xs : List Nat) (f : Nat → Program) (sv : Nat → Nat)
    (h : ∀ i ∈ xs, toffoliCount (f i) + sv i = 2 ∧ measurementCount (f i) = 1) :
    toffoliCount (xs.flatMap f) + (xs.map sv).sum = 2 * xs.length ∧
      measurementCount (xs.flatMap f) = xs.length := by
  induction xs with
  | nil => simp [toffoliCount, measurementCount]
  | cons i xs ih =>
      have hi := h i (by simp)
      have ht := ih (fun j hj => h j (by simp [hj]))
      simp only [List.flatMap_cons, toffoliCount_append, measurementCount_append,
        List.length_cons, List.map_cons, List.sum_cons]
      omega

theorem unpackSteps_counts (L : Layout) (B : Nat) :
    toffoliCount ((List.range (B - 2)).flatMap (unpackStepX L B)) + unpackCutCount B =
        2 * (B - 2) ∧
      measurementCount ((List.range (B - 2)).flatMap (unpackStepX L B)) = B - 2 := by
  have h := flatMap_saving_counts (List.range (B - 2)) (unpackStepX L B)
    (fun j => unpackCutSaves (unpackCutKind B j)) (by
      intro j hj
      exact unpackStepX_counts L B j (List.mem_range.mp hj))
  simpa [unpackCutCount] using h

private theorem lowBits_length (L : Layout) (B : Nat) :
    (lowBits L B).length = bitWidth B / 2 := by
  simp [lowBits, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)]

private theorem highBits_length (L : Layout) (B : Nat) :
    (highBits L B).length = bitWidth B - bitWidth B / 2 := by
  simp [highBits]

private theorem decoder_pair_cost (L : Layout) (B : Nat) :
    toffoliCount (lowDecoder L B).program + toffoliCount (highDecoder L B).program =
      decoderCost (bitWidth B) ∧
    measurementCount (lowDecoder L B).program = 0 ∧
    measurementCount (highDecoder L B).program = 0 ∧
    measurementCount (eraseDecoder (lowDecoder L B)) +
        measurementCount (eraseDecoder (highDecoder L B)) = decoderCost (bitWidth B) ∧
    toffoliCount (eraseDecoder (lowDecoder L B)) = 0 ∧
    toffoliCount (eraseDecoder (highDecoder L B)) = 0 := by
  have lo := oneHot_counts (lowBits L B) L.lowWork
  have hi := oneHot_counts (highBits L B) L.highWork
  have elo := eraseDecoder_counts (lowDecoder L B)
  have ehi := eraseDecoder_counts (highDecoder L B)
  simp only [lowDecoder, highDecoder] at lo hi elo ehi ⊢
  simp only [lo.1, lo.2.1, lo.2.2, hi.1, hi.2.1, hi.2.2,
    elo.1, elo.2, ehi.1, ehi.2, lowBits_length, highBits_length]
  simp [decoderCost]

theorem decoderInit_counts (d : Decoder) (bits : List Wire) :
    toffoliCount (decoderInit d bits) = 0 ∧ measurementCount (decoderInit d bits) = 0 := by
  exact xOn_counts _

@[simp] private theorem decoderInit_toffoli (d : Decoder) (bits : List Wire) :
    toffoliCount (decoderInit d bits) = 0 := (decoderInit_counts d bits).1

@[simp] private theorem decoderInit_measurements (d : Decoder) (bits : List Wire) :
    measurementCount (decoderInit d bits) = 0 := (decoderInit_counts d bits).2

@[simp] private theorem eraseDecoder_toffoli (d : Decoder) :
    toffoliCount (eraseDecoder d) = 0 := (eraseDecoder_counts d).1

private theorem eraseLowHigh_measurements (L : Layout) (B : Nat) :
    measurementCount (eraseDecoder (lowDecoder L B)) +
      measurementCount (eraseDecoder (highDecoder L B)) = decoderCost (bitWidth B) :=
  (decoder_pair_cost L B).2.2.2.1

private theorem lowHigh_program_toffoli (L : Layout) (B : Nat) :
    toffoliCount (lowDecoder L B).program + toffoliCount (highDecoder L B).program =
      decoderCost (bitWidth B) := (decoder_pair_cost L B).1

theorem pack_counts (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    toffoliCount (pack L B) = 2 * B - 4 ∧
    measurementCount (pack L B) = 3 * B - 3 + decoderCost (bitWidth B) := by
  have ha := packAdder_counts L B hB
  have ht := packFirstStep_counts L B
  have hs := flatMap_uniform_counts (List.range (B - 2)).reverse
    (packStep L B) 1 2 (by
      intro j hj
      have hm : j ∈ List.range (B - 2) := List.mem_reverse.mp hj
      exact packStep_counts_normal L B j (List.mem_range.mp hm))
  have hd := decoder_pair_cost L B
  have hli := decoderInit_counts (lowDecoder L B) (lowBits L B)
  have hhi := decoderInit_counts (highDecoder L B) (highBits L B)
  have helo := eraseDecoder_counts (lowDecoder L B)
  have hehi := eraseDecoder_counts (highDecoder L B)
  simp only [pack, toffoliCount_append, measurementCount_append]
  simp only [cxInto_toffoli, cxInto_measurements, xOn_toffoli, xOn_measurements,
    ha.1, ha.2, ht.1, ht.2, hs.1, hs.2, hli.1, hli.2, hhi.1, hhi.2,
    helo.1, helo.2, hehi.1, hehi.2]
  simp only [List.length_reverse, List.length_range]
  simp only [toffoliCount, measurementCount]
  have herase := eraseLowHigh_measurements L B
  have hprogram := lowHigh_program_toffoli L B
  omega

theorem unpackFull_counts (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    toffoliCount (unpackFull L B) = 3 * B - 4 - unpackCutCount B + decoderCost (bitWidth B) ∧
    measurementCount (unpackFull L B) = 2 * B - 3 := by
  have ha := unpackAdder_counts L B hB
  have ht := unpackLastStep_counts L B
  have hs := unpackSteps_counts L B
  have hs1 : toffoliCount ((List.range (B - 2)).flatMap (unpackStepX L B)) =
