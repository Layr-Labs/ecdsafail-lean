namespace ECDSAAdd.Entrant.StairField2V3Entry

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple

/-! ## Pieces -/













/-! ## Shape lemmas (variable programs only) -/










/-! ## The plan -/




/-- The relation before a segment: agreement outside `Δ i`, the side condition, and the
reference state is the genuine record state after `X`. -/
def RowRel (Δ : Finset Wire) (C : BasisState → BasisState → Prop) (X : Program)
    (s t : State) : Prop :=
  Rel Δ C s t ∧ Reach X t




theorem crel_eq_shared (P : Program) : CRel Eq Eq P P := by
  rintro s t rfl fresh
  exact ⟨fresh, rfl⟩

/-- Selected-only step followed by the rest; the reference list keeps its shape. -/
theorem crel_sel_cons {A B C : State → State → Prop} {P P' Q' : Program}
    (h1 : CRel A B P []) (h2 : CRel B C P' Q') : CRel A C (P ++ P') Q' := by
  have h := crel_append h1 h2
  simpa only [List.nil_append] using h



theorem junction_track_gen {B : State → State → Prop} {P Q : Program}
    (pre : State → Prop) (X : Program)
    (h : CRel (fun s t => s = t ∧ ReachBy pre X s) B P Q) :
    CRel (fun s t => s = t ∧ ReachBy pre X s)
      (fun s t => B s t ∧ ReachBy pre (X ++ Q) t) P Q := by
  rintro s t ⟨rfl, hR⟩ fresh
  obtain ⟨old, hB⟩ := h s s ⟨rfl, hR⟩ fresh
  refine ⟨old, hB, ?_⟩
  obtain ⟨s0, m, hs0, hs⟩ := hR
  refine ⟨s0, padTape (measurementCount X) m ++ old, hs0, ?_⟩
  rw [hs]
