      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact trace
  have input' := Rolling1588.canonical_control_set origin Y 0 state true input
  have parity' := FrontierEntry1591.parity_host_control_set
    FrontierEntry1591Field.controls FrontierEntry1591Field.host (by decide)
    FrontierEntry1591Field.controls_away_control state true parity
  have core := exitFieldHosted_core_run_eq half endpoint origin' ctx' ha' x hx0
    hx trace' (by simp only [origin', writeBit, Function.update_self]) Y
    forced input'
    (by simpa only [forced, writeBit, Function.update_of_ne (show base 511 ≠ base 2400 from by decide)] using in511)
    (by simpa only [forced, writeBit, Function.update_of_ne (show base 1542 ≠ base 2400 from by decide)] using in1542)
    (by simpa only [forced, writeBit, Function.update_of_ne (show FrontierEntry1591Field.work ≠ base 2400 from by decide)] using workIn)
    parity' fresh old
  apply Stack5.local_replace (exitFieldHostedShape StairConcrete.bestLoans)
    Rolling1588.exitFieldHosted
    (wires (exitFieldHostedShape StairConcrete.bestLoans) ∪
      wires Rolling1588.exitFieldHosted)
    Finset.subset_union_left Finset.subset_union_right state forced fresh old
    _ core
  intro q hq
  have ne : q ≠ base 2400 := by
    rintro rfl
    rcases Finset.mem_union.mp hq with h | h
    · exact exitHostedShape_control_free half h
    · exact Rolling1588.exit_control_free h
