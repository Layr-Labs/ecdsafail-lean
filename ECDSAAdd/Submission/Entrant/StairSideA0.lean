    Rolling1588Lifetime.endHalf, InverseEndpointWires.padded, InverseEndpointC.half,
    InverseTailC.borrowed, Bool.false_eq_true, if_false, gateSlots_append,
    rename_gateSlots] at tail ⊢
  omega

