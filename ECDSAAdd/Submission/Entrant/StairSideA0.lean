      omega) (by first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega) hd).2
  have prefixRun : ∀ rec, run P rec s = u := by
    intro rec
    exact FifthCarry.no_records P prefixZero s rec []
  have prefixFrame := carryPrefix_frame (d + 1) bits bs cs cin s [] mappedND
    sourceAway (by simp only [bits, mappedRead_length]; (first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega)) (by first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega) hd
    (fun q hq => clean q (by simp [List.mem_of_mem_take hq]))
  rw [← prefixShape] at prefixFrame
  change u.phase = s.phase ∧ PrefixReady (d + 1) bits bs cs cin u.basis ∧
    ∀ q, q ∉ cs.take (d + 1) → u.basis q = s.basis q at prefixFrame
  have csND : cs.Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp nd q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega
  have tailND : (target :: carryAfter (d + 1) cs cin ::
      (as.drop (d + 1) ++ bs.drop (d + 1) ++
