  groups : Bool → Nat → Nat → Nat → Program
  endPacket : Bool → Nat → Program
  /-- v3 boundary slot: division canonicalisation (default: the record
  `canon760`; OPEN: LT8's loaned variant avoiding the 44 exclusive roles). -/
