theorem v3_entryTailSuffix_counts :
    toffoliCount (StairHostsSchedule.entryTailSuffix hostPlan) =
      toffoliCount (Rolling1588.groups true 100 2) + 1720 +
      toffoliCount (renameProgram (OB5.sig 511) StairConcrete.bestLoans.divEndpoint) +
      toffoliCount HalfFieldOB5.copyN + toffoliCount StairConcrete.bestLoans.canon ∧
    measurementCount (StairHostsSchedule.entryTailSuffix hostPlan) =
      measurementCount (Rolling1588.groups true 100 2) + 1720 +
      measurementCount (renameProgram (OB5.sig 511) StairConcrete.bestLoans.divEndpoint) +
      measurementCount HalfFieldOB5.copyN +
      measurementCount StairConcrete.bestLoans.canon := by
  obtain ⟨g6, g6'⟩ := v3_group_counts true 43 100 2 (by norm_num)
  rw [StairHostsSchedule.entryTailSuffix]
  simp only [StairHostsSchedule.hostedGroup, toffoliCount_append, measurementCount_append,
    StairLoan.rebindMany_counts]
  constructor <;> omega

theorem v3_exitHeadPrefix_counts :
    toffoliCount (StairHostsSchedule.exitHeadPrefix hostPlan) =
      toffoliCount StairConcrete.bestLoans.center + toffoliCount HalfFieldOB5.copyN +
      toffoliCount (StairSchedule.placedEndPacket StairConcrete.bestLoans false 68) +
      toffoliCount (Rolling1588.groups false 100 2) + 1720 ∧
    measurementCount (StairHostsSchedule.exitHeadPrefix hostPlan) =
      measurementCount StairConcrete.bestLoans.center +
      measurementCount HalfFieldOB5.copyN +
      measurementCount (StairSchedule.placedEndPacket StairConcrete.bestLoans false 68) +
      measurementCount (Rolling1588.groups false 100 2) + 1720 := by
  obtain ⟨g6, g6'⟩ := v3_group_counts false 43 100 2 (by norm_num)
  rw [StairHostsSchedule.exitHeadPrefix, StairHostsSchedule.hostedEndpoint]
  simp only [StairHostsSchedule.hostedGroup, toffoliCount_append, measurementCount_append,
    StairLoan.rebindMany_counts]
  constructor <;> omega


/-! ## Boundary components (the only plan input that is not a table row) -/

theorem v3_recordEndPacket_counts (divide : Bool) (d : Nat) :
    toffoliCount (StairSchedule.placedEndPacket StairSchedule.recordLoans divide d) =
        toffoliCount (R2SqEp760.endPacket760 divide) ∧
      measurementCount (StairSchedule.placedEndPacket StairSchedule.recordLoans divide d) =
        measurementCount (R2SqEp760.endPacket760 divide) := by
  have e : StairSchedule.recordLoans.endPacket divide d = R2SqEp760.endPacket760 divide := rfl
  rw [StairSchedule.placedEndPacket, e]
  exact renameProgram_counts _ _

/-- Frozen-program boundary: division endpoint = LT18's `endPacket760DivLoan` (+44), the two
converters are LT8's loaned `canon760Loan` / `center760Loan` (+44 each), the multiplication
endpoint slot holds LT19's 44-site loan `endPacket760Loan44 false` (+132): δE = 88, δX = 176. -/
theorem v3_boundary_counts :
    (toffoliCount (renameProgram (OB5.sig 511) StairConcrete.bestLoans.divEndpoint) +
        toffoliCount StairConcrete.bestLoans.canon =
      toffoliCount (R2SqEp760.endPacket760 true) + toffoliCount R2SqEp760.canon760 + 87 ∧
    measurementCount (renameProgram (OB5.sig 511) StairConcrete.bestLoans.divEndpoint) +
        measurementCount StairConcrete.bestLoans.canon =
      measurementCount (R2SqEp760.endPacket760 true) +
        measurementCount R2SqEp760.canon760 + 87) ∧
    (toffoliCount StairConcrete.bestLoans.center +
        toffoliCount (StairSchedule.placedEndPacket StairConcrete.bestLoans false 68) =
      toffoliCount R2SqEp760.center760 + toffoliCount (R2SqEp760.endPacket760 false) + 175 ∧
    measurementCount StairConcrete.bestLoans.center +
        measurementCount (StairSchedule.placedEndPacket StairConcrete.bestLoans false 68) =
      measurementCount R2SqEp760.center760 +
        measurementCount (R2SqEp760.endPacket760 false) + 175) := by
  have x := StairConcrete.placedEndPacket_counts false 68
  norm_num at x
  obtain ⟨x1, x2⟩ := x
  obtain ⟨q1, q2⟩ := v3_recordEndPacket_counts false 68
  obtain ⟨d1, d2⟩ :=
    renameProgram_counts (OB5.sig 511) CompareDecoder.BoundaryLoan.endPacket760DivLoan
  obtain ⟨l1, l2⟩ := CompareDecoder.BoundaryLoan.endPacket760DivLoan_counts
  obtain ⟨k1, k2⟩ := StairBoundaryLoan.canon760Loan_counts
  obtain ⟨n1, n2⟩ := StairBoundaryLoan.center760Loan_counts
  rw [StairConcrete.bestLoans_divEndpoint, StairConcrete.bestLoans_canon,
    StairConcrete.bestLoans_center]
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> omega

