section Merge_StairEndpointLoan44_at_QTop

/-!
# The 44-site multiplication endpoint `endPacket760Loan44 false`

`tailProgramLoan44` (all three carry sweeps loaned at depth 44) threaded through
the record endpoint wrappers exactly as `StairEndpoint.endPacket760Loan68`:
borrow swap, sign flips, padding, selector loan, packet placement `pi0`, and the
final `760 ↔ 717` swap.  The division endpoint (`divide = true`) is left
definitionally equal to the record one; it is not part of this module's claims.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 12000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairEndpointLoan44

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

private def L : BalancedCircuit.Layout :=
  Q6EndpointCell.ports base (base 2409)

def tailBorrowedLoan44 (L : BalancedCircuit.Layout) : Program :=
  renameProgram (InverseTailC.borrowSwap L) (tailProgramLoan44 L)

def halfLoan44 (L : BalancedCircuit.Layout) : Program :=
  [.X L.sign] ++ tailBorrowedLoan44 L ++ [.X L.sign]

def paddedLoan44 (L : BalancedCircuit.Layout) (c : Wire) : Program :=
  halfLoan44 L ++ List.replicate 256 (Instr.measureX c [] [])

def endHalfLoan44 (divide : Bool) : Program :=
  if divide then Rolling1588Lifetime.endHalf true
  else paddedLoan44 (Q6EndpointCell.ports base (base 2409)) (base 512)

def rawEndLoan44 (divide : Bool) : Program :=
  ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
    (endHalfLoan44 divide)

def endPacketLoan44 (divide : Bool) : Program :=
  renameProgram (shifted Placement5.pi0) (rawEndLoan44 divide)

def endPacket760Loan44 (divide : Bool) : Program :=
  renameProgram (Equiv.swap (base 760) (base 717))
    (endPacketLoan44 divide)

theorem tailBorrowedLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (tailBorrowedLoan44 L)=
        toffoliCount (InverseTailC.borrowed L)+132 ∧
    measurementCount (tailBorrowedLoan44 L)=
        measurementCount (InverseTailC.borrowed L)+132 := by
  have count := tailProgramLoan44_counts L hw
  simp only [tailBorrowedLoan44,InverseTailC.borrowed,renameProgram_counts]
  exact count

theorem halfLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (halfLoan44 L)=toffoliCount (InverseEndpointC.half L)+132 ∧
    measurementCount (halfLoan44 L)=
      measurementCount (InverseEndpointC.half L)+132 := by
  have count := tailBorrowedLoan44_counts L hw
  constructor <;>
    simp only [halfLoan44,InverseEndpointC.half,toffoliCount_append,
      measurementCount_append] <;> omega

theorem paddedLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths)
    (c : Wire) :
    toffoliCount (paddedLoan44 L c)=
        toffoliCount (InverseEndpointWires.padded L c)+132 ∧
    measurementCount (paddedLoan44 L c)=
        measurementCount (InverseEndpointWires.padded L c)+132 := by
  have count := halfLoan44_counts L hw
  constructor <;>
    simp only [paddedLoan44,InverseEndpointWires.padded,toffoliCount_append,
      measurementCount_append] <;> omega








