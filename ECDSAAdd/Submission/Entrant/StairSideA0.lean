section Merge_StairFirstTickV3_at_StairSideA

/-!
# First moved tick on the decoded, oriented checkpoint (LT30)

At each checkpoint row `B` (start `s = startFor B` ∈ {425, 450, 465, 480, 490, 500})
the first moved tick `tickForward s = TickRanges.tick (segmentMap B) s` runs on the
decoded, ORIENTED checkpoint: the previous letter sits on the clean spare 717, and
the two rails are `orientRails (realRails x p s)`, not the record's canonical
stage.  This file proves, for every row:

* `tick_trip` — `tickReverse s ∘ tickForward s = id` on such a checkpoint
  (exit side: LT24 `rowPieces_chain.tick`, `termPieces` link `tick 500`);
* `tick_forward` — the tick advances the re-rooted local stage to `s + 1`;
* `virtual_stage` (naturality) — a local stage at `s + 1` yields a VIRTUAL state
  that agrees with the physical one outside the virtual sites (images under
  `midSegmentMap B` of the past ids `< s`, `1028 + j (j < s)` and `1797`) and
  satisfies the record's `Rolling1588.Integer.Stage (midSegmentMap B) … (s + 1)`;
* `middle_virtual` — the exact `virtual` premise of LT24's `middle_trip_local`
  / `terminal_middle_trip` (agreement on the moved middle programs' wires).

A genuine `Integer.Stage` on the moved map cannot hold physically (the moved
map puts the old letters on clean shadow labels), so the stage is stated on a
virtual state, generically in the row (`virtual_generic`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairFirstTickV3

open ECDSAAdd Arithmetic
open MappedCompressed StairPhysicalLayout

/-! ## Orientation is invisible after one tick (LT14 `StairScheduleRepair`) -/






/-! ## Record hypotheses and the decoded checkpoint -/






/-! ## `Decoded` from the codec output -/


/-- **`Decoded` from the codec interface.**  After `unpack B` (codec unpack and
the sign copy onto `bSite B`) the state is the decoded oriented checkpoint as
soon as `CodecInput`'s two register values hold for the real checkpoint triple,
the sum extension `base 512` and the spare `base 717` are clean, the sign copy
holds the sign, and the future words / future `s` letters / carry bank of the
tick map are clean. -/
theorem decoded_of_codec (B : Nat) (hB : B ∈ budgets) (x p : Nat) (h : RealHyp x p)
    (y : BasisState)
    (hS : regValue (StairCodec.reg (physicalLayout B).S B) y =
      (StairBridgeDomain.realNatState x p (startFor B)).u +
        (StairBridgeDomain.realNatState x p (startFor B)).v)
    (hD : regValue (StairCodec.reg (physicalLayout B).D B) y =
      StairCodec.signedWord B (StairBridgeDomain.realNatState x p (startFor B)).u
        (StairBridgeDomain.realSign x p (startFor B)))
    (h512 : y (base 512) = false)
    (hext : y (bSite B) = StairBridgeDomain.realSign x p (startFor B))
    (h717 : y zeroWire = false)
    (hfA : ∀ j, startFor B + W.compactSkywalkTickPreWidth (startFor B) ≤ j → j < 770 →
      y (segmentMap B j) = false)
    (hfB : ∀ j, 770 + W.compactSkywalkTickPreWidth (startFor B) ≤ j → j < 1028 →
      y (segmentMap B j) = false)
    (hfS : ∀ j, startFor B ≤ j → j < 512 → y (segmentMap B (1028 + j)) = false)
    (hcarry : regValue (wireBlock (segmentMap B) 1540 257) y = 0) :
    Decoded B x p y := by
  obtain ⟨h0, h1, _, hsub, _, _⟩ := budget_range B hB
  have domain := StairBridgeDomain.real_codecDomain x p (startFor B) h.p0 h.x0 h.odd h.lt
    h.xlt h.cop (by omega)
  rw [hsub] at domain
  have vals := canonical_values (physicalLayout B) B _ _ _ (base 512) (bSite B) domain y
    hS hD h512 hext
  unfold Decoded
  rw [StairBridgeDomain.orient_realRails x p _ h.p0 h.odd]
  refine ⟨le_rfl, ?_, ?_, ?_, ?_, hfA, hfB, hfS, hcarry⟩
  · rw [Nat.sub_self, physicalLayout_aWord B hB]
    exact vals.1
  · rw [Nat.sub_self, physicalLayout_bWord B hB]
    exact vals.2
  · rw [Nat.sub_self, segmentMap_previous B hB]
    exact h717
  · intro j h1 h2
    exact absurd h2 (by omega)

