/-! K6 (replay budget): the non-membership in the orientation's wires by one pass over its
instruction list (no `Finset` of wires is built). -/

def k6corrWs : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: k6corrWs cs
  | .CZ a b :: cs => a :: b :: k6corrWs cs

def k6instrWs : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c0 c1 => t :: (k6corrWs c0 ++ k6corrWs c1)

theorem k6_mem_corrWs (q : Wire) (cs : List Correction) :
    q ∈ k6corrWs cs ↔ q ∈ correctionWires cs := by
  induction cs with
  | nil => simp [k6corrWs, correctionWires]
  | cons c cs ih =>
      cases c <;> simp [k6corrWs, correctionWires, ih]

theorem k6_mem_instrWs (q : Wire) (i : Instr) : q ∈ k6instrWs i ↔ q ∈ i.wires := by
  cases i <;> simp [k6instrWs, Instr.wires, k6_mem_corrWs]

theorem k6_not_mem_wires (x : Wire) : ∀ (P : Program),
    P.all (fun i => (k6instrWs i).all (fun q => !Nat.beq q x)) = true → x ∉ wires P
  | [], _ => by simp [wires]
  | i :: P, h => by
    simp only [List.all_cons, Bool.and_eq_true] at h
    rw [wires, Finset.mem_union]
    rintro (hx | hx)
    · have t := List.all_eq_true.mp h.1 x ((k6_mem_instrWs x i).mpr hx)
      simp [Nat.beq_refl] at t
    · exact k6_not_mem_wires x P h.2 hx

