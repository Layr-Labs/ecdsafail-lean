/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3SegSpec_at_StairSideA` -/
section Merge_StairField2V3SegSpec_at_StairSideA

/-!
# LT42: the forward-segment spec `SegSpecT` for the five middle rows

Assembly of LT21's segment ingredients (codec unpack, LT30's first moved tick
and virtual middle stage, orientation at the row end, the closing packet, the
codec pack) into `StairField2V3Seg.SegSpecT` for the concrete CANON v3
provider and the five row pairs `(87,62) (62,47) (47,32) (32,22) (22,12)`.

* `core`: the spec on states that are clean on the shadow labels `≥ base 4000`;
* `low_reduce`: every label of a segment is below `base 4000`, so arbitrary
  shadow contents are irrelevant;
* `segSpec`: the spec itself; `spec0 … spec4`: the five instances.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3SegSpec

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack StairField2V3Pack
open StairField2V3End StairField2V3Decode StairField2V3Walk StairField2V3SegFacts StairField2V3SegFacts2

/-! ## Generic helpers -/

theorem run6 (A B C D E F : Program) (m : List Bool) (s : State) :
    ∃ m1 m2 m3 m4 m5 m6, run (A ++ B ++ C ++ D ++ E ++ F) m s =
      run F m6 (run E m5 (run D m4 (run C m3 (run B m2 (run A m1 s))))) := by
  rw [run_append, run_append, run_append, run_append, run_append]
  exact ⟨_, _, _, _, _, _, rfl⟩

/-- The state with every shadow label (`≥ base 4000`) cleared. -/
def zeroHigh (u : State) : State :=
  ⟨u.phase, fun q => if base 4000 ≤ q then false else u.basis q⟩

theorem low_reduce (P : Program) (hP : ∀ q ∈ wires P, q < base 4000) (m : List Bool)
    (u : State) :
    ((run P m (zeroHigh u)).phase = u.phase → (run P m u).phase = u.phase) ∧
    (∀ q, q < base 4000 → (run P m u).basis q = (run P m (zeroHigh u)).basis q) ∧
    (∀ q, base 4000 ≤ q → (run P m u).basis q = u.basis q) := by
  have agree : ∀ q ∈ wires P, u.basis q = (zeroHigh u).basis q := by
    intro q hq
    have h := hP q hq
    show u.basis q = (if base 4000 ≤ q then false else u.basis q)
    rw [if_neg (Nat.not_le.mpr h)]
  have inc := run_local_increment P u (zeroHigh u) m agree
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have h1 := inc.1
    rw [h] at h1
    change ((run P m u).phase ^^ u.phase) = (u.phase ^^ u.phase) at h1
    revert h1
    generalize (run P m u).phase = a
    generalize u.phase = b
    cases a <;> cases b <;> simp
  · intro q hq
    by_cases hw : q ∈ wires P
    · exact inc.2 q hw
    · rw [run_preserves_outside _ _ _ q hw, run_preserves_outside _ _ _ q hw]
      show u.basis q = (if base 4000 ≤ q then false else u.basis q)
      rw [if_neg (Nat.not_le.mpr hq)]
  · intro q hq
    exact run_preserves_outside _ _ _ q (fun h => absurd (hP q h) (Nat.not_lt.mpr hq))


theorem nonvirt (B : Nat) (hB : B ∈ budgets) (id : Nat)
    (h : ¬ StairFirstTickV3.Virt (startFor B) id) :
    ¬ StairFirstTickV3.virtualSites B (StairPhysicalPrimitives.midSegmentMap B id) :=
  StairFirstTickV3.not_vwire _ (StairFirstTickV3.midSegmentMap_injective B hB) _ id h

theorem hist_facts (l k : Nat) (r : Fin 10) (h1 : l ≤ 5 * k) (h2 : 5 * k + 5 ≤ 512) :
    ¬ StairFirstTickV3.Virt l (History5.historyId (5 * k) r) ∧
    ((5 * k ≤ History5.historyId (5 * k) r ∧ History5.historyId (5 * k) r < 1028) ∨
      1028 + 5 * k ≤ History5.historyId (5 * k) r) := by
  have hr := r.isLt
  unfold StairFirstTickV3.Virt History5.historyId
  by_cases hc : r.val % 2 = 0
  · simp only [hc, ↓reduceIte]
    omega
  · simp only [hc, ↓reduceIte]
    omega


/-- Holes of the record's encoded transcript are zero. -/
theorem recVal_hole (origin : BasisState) (hlegal : NewHistory5.RawLegal base 102 origin)
    (k : Nat) (hk : k < 102) (i : Fin 10) (hi : i = 5 ∨ i = 9) :
    recVal origin (StairField2V3Packet.packetSite k i) = false := by
  -- LT49 (replay budget): `recVal_unfold` instead of `unfold recVal` (41 s → < 0.1 s)
  rw [StairField2V3Packet.recVal_unfold, StairField2V3Packet.packetSite,
    OB5.sig_invol 511 (by decide)]
  exact Rolling1588.allEncode_hole base true base_pool_nodup 102 k (by decide) hk ⟨false, origin⟩ []
    hlegal i hi

/-- The closing packet only touches its own ten sites. -/
theorem closing_wires (k : Nat) (q : Wire)
    (hq : q ∈ wires (renameProgram (OB5.sig 511) (Rolling1588.encodeGroup base true k))) :
    q ∈ pk k := by
  rw [renameProgram_support] at hq
