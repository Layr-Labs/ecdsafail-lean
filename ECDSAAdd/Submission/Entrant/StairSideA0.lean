/-! ## Copies of private record lemmas (`QTop.lean`, same statements) -/

theorem work_away' (q : Wire) (hq : q∈Q6EndpointCell.workIds.map base) :
    q∉(balancedSharedPorts base (base 2409)).r ∧
      q∉(balancedSharedPorts base (base 2409)).y := by
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hq
  simp only [Q6EndpointCell.workIds,List.mem_append,List.mem_cons,List.not_mem_nil,
    List.mem_range'_1,or_false] at hi
  rw [balancedSharedPorts_r,balancedSharedPorts_y]
  exact ⟨OwnPlusHost.not_block i 2056 256 (by omega),
    OwnPlusHost.not_block i 770 256 (by omega)⟩

theorem raw_work_clean' (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State)
    (input : PairFrame (balancedSharedPorts base (base 2409)).r
      (balancedSharedPorts base (base 2409)).y origin (centerWord X) (centerWord Y) s.basis) :
    Q6EndpointCell.Clean base s.basis := by
  have clean := Q6EndpointCell.clean_of_env base origin ctx.env ctx.parity
  intro q hq
  have away := half_work_away q hq
  exact (input.2.2 q away.1 away.2).trans (clean q hq)

theorem endRaw_selected' (divide : Bool) :
    SW.Sel (base 2400) 1 (FrontierSW1591.rawEndS divide) (FrontierReplay1591.rawEnd divide) := by
  have nd : [base 2400,base 510,base 2409].Nodup := by decide
  exact ((SW.Sel.refl _ _ (FrontierSW1591.selHalfE_away divide)).window
    (base 510) (base 2409) (mixedTranscriptUnitTrace.getD 510 (false,false)).1 nd).cast
      (by norm_num) rfl rfl

theorem endRaw_disjoint' (isA divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) :
    Disjoint (wires (Rolling1588.allEncode base isA 102)) (wires (rawEnd divide)) := by
  have old := FrontierReplay1591.rawEnd_disjoint divide ctx.hn ctx.hp
  apply Finset.disjoint_left.mpr
  intro q hq used
  have encoded : q∈wires (NewHistory5.allEncode base 102) := by
    rw [Rolling1588.allEncode_support_eq] at hq
    exact hq
  exact Finset.disjoint_left.mp old encoded
    ((endRaw_selected' divide).sub.wires_sub (Finset.mem_of_mem_erase (rawEnd_support divide used)))

theorem allEncode_far' (isA : Bool) (q : Nat) (low : 512≤q) (high : q<1028 ∨ 1540≤q) :
    base q∉wires (Rolling1588.allEncode base isA 102) := by
  have support := Rolling1588.allEncode_history_support base isA 102 (by decide)
  intro used
  have member := support used
  simp only [List.mem_toFinset,List.mem_append] at member
  rcases member with member|member
  · exact OwnPlusHost.not_block q 0 512 (by omega) member
  · exact OwnPlusHost.not_block q 1028 512 (by omega) member

/-! ## Layer 1: the half -/

theorem endHalfLoan_run_eq (X Y : Fp) (t : State) (m : List Bool)
    (clean : Q6EndpointCell.Clean base t.basis)
    (self : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y t.basis (centerWord X) (centerWord Y) t.basis)
    (hend : (X+(if t.basis (base 2409) then Y else -Y))/2=Y) :
    run endHalfLoan m t = run (endHalf true) m t := by
  have k : measurementCount (CompareDecoder.cellDecoderNext)=514 := decoder_counts_actual.2
  have dec := CompareDecoder.cellDecoderNext_frame t.basis
    (TerminalGraphEndpoint.clean_decoder base (base 2409) t.basis clean) X Y
    hend t (m.take 514) self
  change (run (CompareDecoder.cellDecoderNext) (m.take 514) t).phase=t.phase ∧ _ at dec
  have m512 : base 512∈Q6EndpointCell.workIds.map base :=
    List.mem_map.mpr ⟨512,by simp [Q6EndpointCell.workIds,List.mem_range'_1],rfl⟩
  have away : base 512∉(Q6EndpointCell.ports base (base 2409)).r ∧
      base 512∉(Q6EndpointCell.ports base (base 2409)).y := by
    rw [Q6EndpointCell.ports_r,Q6EndpointCell.ports_y]
    exact ⟨OwnPlusHost.not_block 512 2056 256 (by omega),OwnPlusHost.not_block 512 770 256 (by omega)⟩
  have z512 : (run (CompareDecoder.cellDecoderNext) (m.take 514) t).basis (base 512)=false :=
    (dec.2.2.2 _ away.1 away.2).trans (clean _ m512)
  have eqDec := CompareDecoder.BoundaryLoan.cellDecoderLoan_run_eq_frame t.basis
    (TerminalGraphEndpoint.clean_decoder base (base 2409) t.basis clean) X Y hend t self
    (m.take (measurementCount CompareDecoder.BoundaryLoan.cellDecoderLoan)) (m.take 514)
  rw [endHalfLoan, run_append, eqDec, InverseEndpointWires.pad_run 507 (base 512) _ _ z512,
    endHalf_true, run_append, k, InverseEndpointWires.pad_run 507 (base 512) _ _ z512]

end ECDSAAdd.Entrant.Rolling1588Lifetime
