/-! ## Level 4: the record-shaped division kernel -/

/-- The loaned analogue of the record's `entry_boundary`.  As in the record,
the concrete first-phase runs are abstracted into named states first. -/
theorem shape_entry_boundary (half : HalfReplayHypothesis)
    (hn : (skywalkSharedWires base).Nodup)
    (hlo : History5.HistoryAbove base)
    (ho : ∀ q ∈ [base 2400, base 2409, base 2410], q ∉ skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410)
      (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s t : State)
    (mp mf : List Bool)
    (input : SkywalkArithmeticInput base x Y.val s.basis)
    (hg : s.basis (base 2409) = false) (hs : s.basis (base 2410) = false)
    (phase : t.phase = s.phase)
    (same : ∀ q, q ∉ wireBlock base 2056 256 → t.basis q = s.basis q)
    (halfValue : regValue (wireBlock base 2056 256) t.basis = centerWord (Y / 2)) :
    let beforeA := run (Rolling1588.firstPhase true) mp t
    let beforeB := run (Rolling1588.firstPhase false) mp t
    let after := run (entryFieldHostedShape StairConcrete.bestLoans) mf beforeA
    after.phase = beforeB.phase ∧
      regValue (wireBlock base 2056 256) after.basis = (Y / (x : Fp)).val ∧
      ∀ q, q ∉ wireBlock base 2056 256 → after.basis q = beforeB.basis q := by
  have record := Rolling1588.entry_boundary hn hlo ho hf x Y hx0 hx s t mp mf
    input hg hs phase same halfValue
  obtain ⟨beforeA, beforeAEq⟩ : ∃ beforeA : State,
      run (Rolling1588.firstPhase true) mp t = beforeA := ⟨_, rfl⟩
  obtain ⟨beforeB, beforeBEq⟩ : ∃ beforeB : State,
      run (Rolling1588.firstPhase false) mp t = beforeB := ⟨_, rfl⟩
  obtain ⟨origin, facts, legal, frames⟩ := Rolling1588Lifetime.entry_first_prepared
    hn hlo ho x Y hx0 hx s t mp input phase same halfValue
  have ctx := Rolling1588Lifetime.prepared_context hn ho hf x Y s origin facts
    legal hg hs
  have frameA := frames true
  rw [beforeAEq] at frameA
  have actualInput := FrontierEntry1591Kernel.paired_input x Y.val s t input same
  have bits := Rolling1588Lifetime.first_clean true hn hlo x _ hx0 hx t mp
    actualInput
  have work := Rolling1588Lifetime.first_work_zero true hn x _ t mp actualInput
  have parity := Rolling1588Lifetime.first_parity true hn hlo x _ hx0 hx t mp
    actualInput
  rw [beforeAEq] at bits work parity
  have code := Rolling1588Frame.field_special_at origin.basis (Y / 2) 0 beforeA
    511 (by simp) frameA
  have fixed : OB5.sig 511 (base 511) = base 511 := by decide +kernel
  rw [fixed] at code
  have eq := entryFieldHosted_run_eq half origin.basis ctx facts.sourceZero x hx0
    hx facts.trace Y beforeA frameA
    (code.trans (trace_last x hx0 hx origin.basis facts.trace))
    (bits _ (by simp [FrontierEntry1591Native.workSites])) work parity mf mf
  rw [beforeAEq, beforeBEq] at record
  rw [beforeAEq, beforeBEq]
  dsimp only at record ⊢
  obtain ⟨after, afterEq⟩ : ∃ after : State,
      run Rolling1588.entryFieldHosted mf beforeA = after := ⟨_, rfl⟩
  rw [afterEq] at record eq
  rw [eq]
  exact record



/-- Two outputs with the same `EntryCorrect` characterization are equal. -/
theorem entry_output_unique (s a b : State) (value : Nat)
    (ha : a.phase = s.phase ∧ regValue (wireBlock base 2056 256) a.basis = value ∧
      ∀ q, q ∉ wireBlock base 2056 256 → a.basis q = s.basis q)
    (hb : b.phase = s.phase ∧ regValue (wireBlock base 2056 256) b.basis = value ∧
      ∀ q, q ∉ wireBlock base 2056 256 → b.basis q = s.basis q) :
    a = b := by
  have block := (regValue_eq_iff (wireBlock base 2056 256) a.basis b.basis).mp
    (ha.2.1.trans hb.2.1.symm)
  apply State.extensionality _ _ (ha.1.trans hb.1.symm)
  funext q
  by_cases hq : q ∈ wireBlock base 2056 256
  · exact block q hq
  · exact (ha.2.2 q hq).trans (hb.2.2 q hq).symm


end ECDSAAdd.Entrant.StairLoanRecordKernel

