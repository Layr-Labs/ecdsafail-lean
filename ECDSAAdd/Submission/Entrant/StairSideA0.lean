theorem kbPP4 (x : Nat) (h1 : 1043 ≤ x) (h2 : x < 1301) :
    good39B (StairPlaceFast.phasePlaceB x) = true := by
  unfold StairPlaceFast.phasePlaceB StairPlaceFast.kernelPlaceB
  rw [kbPH (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩))),
    kbSw_id (show x ≠ 785 by omega) (show x ≠ 1813 by omega),
    kbPw_mid (show 1026 ≤ x - 16 by omega) (show x - 16 < 2056 by omega),
    kbKT (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩)))]
  exact kbG_in (a := 4886) (b := 5144) (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩))) (by omega) (by omega)

theorem kbPP6 (x : Nat) (h1 : 1559 ≤ x) (h2 : x < 1672) :
    good39B (StairPlaceFast.phasePlaceB x) = true := by
  unfold StairPlaceFast.phasePlaceB StairPlaceFast.kernelPlaceB
  rw [kbPH (Or.inr (Or.inr (Or.inr ((by omega))))),
    kbSw_id (show x ≠ 785 by omega) (show x ≠ 1813 by omega),
    kbPw_mid (show 1026 ≤ x - 16 by omega) (show x - 16 < 2056 by omega),
    kbKT (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩)))]
  exact kbG_in (a := 5402) (b := 5515) (Or.inr (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩)))) (by omega) (by omega)

theorem kbPP7 (x : Nat) (h1 : 1673 ≤ x) (h2 : x < 1812) :
    good39B (StairPlaceFast.phasePlaceB x) = true := by
  unfold StairPlaceFast.phasePlaceB StairPlaceFast.kernelPlaceB
  rw [kbPH (Or.inr (Or.inr (Or.inr ((by omega))))),
    kbSw_id (show x ≠ 785 by omega) (show x ≠ 1813 by omega),
    kbPw_mid (show 1026 ≤ x - 16 by omega) (show x - 16 < 2056 by omega),
    kbKT (Or.inr (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩))))]
  exact kbG_in (a := 5516) (b := 5655) (Or.inr (Or.inr (Or.inr (Or.inr (⟨by omega, by omega⟩))))) (by omega) (by omega)

theorem kbPP8 (x : Nat) (h1 : 2072 ≤ x) (h2 : x < 2328) :
    good39B (StairPlaceFast.phasePlaceB x) = true := by
  unfold StairPlaceFast.phasePlaceB StairPlaceFast.kernelPlaceB
  rw [kbPH (Or.inr (Or.inr (Or.inr ((by omega))))),
    kbSw_id (show x ≠ 785 by omega) (show x ≠ 1813 by omega),
    kbPw_y (show 2056 ≤ x - 16 by omega) (show x - 16 < 2312 by omega),
    kbKT (Or.inl ⟨by omega, by omega⟩)]
  exact kbG_lo (by omega)

theorem kbPPm (x : Nat) (h1 : 2330 ≤ x) (h2 : x < 2417) :
    good39B (StairPlaceFast.phasePlaceB x) = true := by
  unfold StairPlaceFast.phasePlaceB StairPlaceFast.kernelPlaceB
  rw [kbPH (Or.inr (Or.inr (Or.inr (by omega)))),
    kbSw_id (show x ≠ 785 by omega) (show x ≠ 1813 by omega),
    kbPw_meta (show 2314 ≤ x - 16 by omega) (show x - 16 ≤ 2400 by omega)]
  decide








/-! ## Good label intervals of the two placements used most (probed, then checked once) -/

/-- Labels whose phase placement `PP` is 39-good (intervals). -/
def PPI (x : Nat) : Prop :=
  x < 531 ∨ x = 733 ∨ (739 ≤ x ∧ x < 741) ∨ (786 ≤ x ∧ x < 1301) ∨
    (1556 ≤ x ∧ x < 1813) ∨ (2072 ≤ x ∧ x < 2328) ∨ (2330 ≤ x ∧ x < 2417)

instance instDecPPI (x : Nat) : Decidable (PPI x) := by
  unfold PPI; infer_instance


def ppList : List Nat :=
  List.range' 0 531 ++ [733, 739, 740] ++ List.range' 786 515 ++ List.range' 1556 257 ++
    List.range' 2072 256 ++ List.range' 2330 87

/-- LT46 (replay budget): decided on the closed-form phase placement
(`StairPlaceFast.phasePlace_eqB`; 58 s → ≈ 2 s).  K4-B: symbolic on the affine intervals
(`kbPP*`), only the exceptional labels are evaluated. -/
theorem ppList_good : ∀ x ∈ ppList, Good39 (PP x) := by
  have low : ∀ x, x < 16 → good39B (StairPlaceFast.phasePlaceB x) = true := by
    decide +kernel
  have key : ∀ x ∈ ppList, good39B (StairPlaceFast.phasePlaceB x) = true := by
    intro x hx
    simp only [ppList, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
      or_false] at hx
    rcases hx with ((((hA | hB) | hC) | hD) | hE) | hF
    · rcases Nat.lt_or_ge x 16 with h | h
      · exact low x h
      · exact kbPP1 x h (by omega)
    · rcases hB with rfl | rfl | rfl <;> decide
    · rcases Nat.lt_or_ge x 1042 with h | h
      · exact kbPP3 x (by omega) h
      · rcases Nat.lt_or_ge x 1043 with h' | h'
        · obtain rfl : x = 1042 := by omega
          decide
        · exact kbPP4 x h' (by omega)
    · rcases Nat.lt_or_ge x 1559 with h | h
      · have : x = 1556 ∨ x = 1557 ∨ x = 1558 := by omega
        rcases this with rfl | rfl | rfl <;> decide
      · rcases Nat.lt_or_ge x 1672 with h' | h'
        · exact kbPP6 x h h'
        · rcases Nat.lt_or_ge x 1673 with h'' | h''
          · obtain rfl : x = 1672 := by omega
            decide
          · rcases Nat.lt_or_ge x 1812 with h3 | h3
            · exact kbPP7 x h'' h3
            · obtain rfl : x = 1812 := by omega
              decide
    · exact kbPP8 x (by omega) (by omega)
    · exact kbPPm x (by omega) (by omega)
  intro x hx
  have h := good39_of_B (key x hx)
  rwa [← StairPlaceFast.phasePlace_eqB] at h

theorem ppi_good {x : Nat} (h : PPI x) : Good39 (PP x) := by
  apply ppList_good
  unfold PPI at h
  simp only [ppList, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
    or_false]
  omega

theorem ok39_of_ppi {P : Program} (h : ∀ x ∈ wires P, PPI x) :
    PieceOK StairCertificate.holes39 PP P :=
  ok39_of_good (fun x hx => ppi_good (h x hx))









theorem ok39_of_ppiAll {P : Program} (h : allSites (fun x => decide (PPI x)) P = true) :
    PieceOK StairCertificate.holes39 PP P :=
  ok39_of_ppi (fun x hx => of_decide_eq_true (allSites_sound h x hx))








