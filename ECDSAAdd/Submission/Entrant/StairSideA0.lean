/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanTopGeneric_at_StairSideA` -/
section Merge_StairDivLoanTopGeneric_at_StairSideA

/-!
# Generic run facts for the division-endpoint loan window (LT15)

* `run_basis_xOnly`: a wire targeted only by `X` gates ends flipped by the
  parity of those gates (any state, any record).
* `run_basis_untouched`, `run_basis_endsCleared`: untouched wires keep their
  value; a wire whose last write is a measurement ends at `false`.
* `run_basis_records`: the basis part of a run never depends on the record.
* `run_shift`: a global phase flip commutes with `run`.
* `tapeFree_middle`: if `A ++ (B ++ C)` is record-independent from `s`, then
  `B` is record-independent from every state `run A a s`.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairDivLoanTop

open ECDSAAdd

/-- Target wire of an instruction. -/
def target : Instr → Wire
  | .X t => t
  | .CX _ t => t
  | .CCX _ _ t => t
  | .measureX t _ _ => t

def isXOn (q : Wire) : Instr → Bool
  | .X t => t == q
  | _ => false

def hitsNonX (q : Wire) : Instr → Bool
  | .X _ => false
  | .CX _ t => t == q
  | .CCX _ _ t => t == q
  | .measureX t _ _ => t == q

def isMeasureOn (q : Wire) : Instr → Bool
  | .measureX t _ _ => t == q
  | _ => false

def xParity (q : Wire) : Program → Bool
  | [] => false
  | i :: P => isXOn q i ^^ xParity q P

def untouched (q : Wire) (P : Program) : Bool := P.all (fun i => !(target i == q))

def endsCleared (q : Wire) : Program → Bool
  | [] => false
  | i :: P => endsCleared q P || (isMeasureOn q i && untouched q P)

theorem xor_rc (a b c : Bool) : ((a ^^ b) ^^ c) = ((a ^^ c) ^^ b) := by
  cases a <;> cases b <;> cases c <;> rfl

theorem run_basis_xOnly (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    P.all (fun i => !hitsNonX q i) = true →
      (run P m s).basis q = (s.basis q ^^ xParity q P) := by
  intro P
  induction P with
  | nil =>
      intro m s _
      simp [run, xParity]
  | cons i P ih =>
      intro m s h
      simp only [List.all_cons, Bool.and_eq_true] at h
      obtain ⟨hi, hP⟩ := h
      cases i with
      | X t =>
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          by_cases e : t = q
          · rw [e]
            simp only [writeBit, Function.update_self, beq_self_eq_true]
            cases s.basis q <;> cases xParity q P <;> rfl
          · have hb : (t == q) = false := by simp [e]
            simp only [writeBit, Function.update_of_ne (Ne.symm e), hb]
            cases s.basis q <;> cases xParity q P <;> rfl
      | CX c t =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl
      | CCX a1 a2 t =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl
      | measureX t c0 c1 =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [measureAndCorrect, correct_basis, writeBit,
            Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl

theorem run_basis_untouched (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    untouched q P = true → (run P m s).basis q = s.basis q := by
  intro P
  induction P with
  | nil => intro m s _; rfl
  | cons i P ih =>
      intro m s h
      simp only [untouched, List.all_cons, Bool.and_eq_true] at h
      obtain ⟨hi, hP⟩ := h
      have hP' : untouched q P = true := hP
      cases i with
      | X t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | CX c t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | CCX a1 a2 t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | measureX t c0 c1 =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [measureAndCorrect, correct_basis, writeBit,
            Function.update_of_ne (Ne.symm e)]

theorem run_basis_endsCleared (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    endsCleared q P = true → (run P m s).basis q = false := by
  intro P
  induction P with
  | nil => intro m s h; simp [endsCleared] at h
  | cons i P ih =>
      intro m s h
      simp only [endsCleared, Bool.or_eq_true, Bool.and_eq_true] at h
      rcases h with h | ⟨hm, hu⟩
      · cases i <;> simp only [run] <;> exact ih _ _ h
      · cases i with
        | X t => simp [isMeasureOn] at hm
        | CX c t => simp [isMeasureOn] at hm
        | CCX a1 a2 t => simp [isMeasureOn] at hm
        | measureX t c0 c1 =>
            have e : t = q := by simpa [isMeasureOn] using hm
            subst e
            simp only [run]
            rw [run_basis_untouched _ P _ _ hu]
            simp [measureAndCorrect, writeBit]


theorem correct_shift (cs : List Correction) : ∀ (p b : Bool) (x : BasisState),
    correct cs ⟨p ^^ b, x⟩ = ⟨(correct cs ⟨p, x⟩).phase ^^ b, (correct cs ⟨p, x⟩).basis⟩ := by
  induction cs with
  | nil => intro p b x; rfl
  | cons c cs ih =>
      intro p b x
      cases c with
      | Z t =>
          show correct cs ⟨(p ^^ b) ^^ x t, x⟩ =
            ⟨(correct cs ⟨p ^^ x t, x⟩).phase ^^ b, (correct cs ⟨p ^^ x t, x⟩).basis⟩
          rw [xor_rc p b (x t)]
          exact ih (p ^^ x t) b x
      | CZ a1 a2 =>
          show correct cs ⟨(p ^^ b) ^^ (x a1 && x a2), x⟩ =
            ⟨(correct cs ⟨p ^^ (x a1 && x a2), x⟩).phase ^^ b,
              (correct cs ⟨p ^^ (x a1 && x a2), x⟩).basis⟩
          rw [xor_rc p b (x a1 && x a2)]
          exact ih (p ^^ (x a1 && x a2)) b x

theorem mac_shift (t : Wire) (c0 c1 : List Correction) (r p b : Bool) (x : BasisState) :
    measureAndCorrect t c0 c1 r ⟨p ^^ b, x⟩ =
      ⟨(measureAndCorrect t c0 c1 r ⟨p, x⟩).phase ^^ b,
        (measureAndCorrect t c0 c1 r ⟨p, x⟩).basis⟩ := by
  show correct (if r then c1 else c0) ⟨(p ^^ b) ^^ (r && x t), writeBit x t false⟩ =
    ⟨(correct (if r then c1 else c0) ⟨p ^^ (r && x t), writeBit x t false⟩).phase ^^ b,
      (correct (if r then c1 else c0) ⟨p ^^ (r && x t), writeBit x t false⟩).basis⟩
  rw [xor_rc p b (r && x t)]
  exact correct_shift _ _ b _

theorem run_shift (P : Program) : ∀ (m : List Bool) (p b : Bool) (x : BasisState),
    run P m ⟨p ^^ b, x⟩ = ⟨(run P m ⟨p, x⟩).phase ^^ b, (run P m ⟨p, x⟩).basis⟩ := by
  induction P with
  | nil => intro m p b x; rfl
  | cons i P ih =>
      intro m p b x
      cases i with
      | X t => simp only [run]; exact ih m p b (writeBit x t (!x t))
      | CX c t => simp only [run]; exact ih m p b (writeBit x t (x t ^^ x c))
      | CCX a1 a2 t => simp only [run]; exact ih m p b (writeBit x t (x t ^^ (x a1 && x a2)))
      | measureX t c0 c1 =>
          simp only [run]
          rw [mac_shift]
          exact ih _ _ b _

theorem run_pad (P : Program) : ∀ (a : List Bool) (n : Nat) (s : State),
    run P (a ++ List.replicate n false) s = run P a s := by
  induction P with
  | nil => intro a n s; rfl
  | cons i P ih =>
      intro a n s
      cases i with
      | X t => simp only [run]; exact ih a n _
      | CX c t => simp only [run]; exact ih a n _
      | CCX a1 a2 t => simp only [run]; exact ih a n _
      | measureX t c0 c1 =>
          cases a with
          | nil =>
              cases n with
              | zero => rfl
              | succ n =>
                  simp only [run]
                  exact ih [] n _
          | cons x a =>
              simp only [run]
              exact ih a n _

/-- A record of exactly `k` entries that runs like `l`. -/
def fixLen (l : List Bool) (k : Nat) : List Bool := (l ++ List.replicate k false).take k

theorem fixLen_length (l : List Bool) (k : Nat) : (fixLen l k).length = k := by
  simp only [fixLen, List.length_take, List.length_append, List.length_replicate]
  omega

theorem run_fixLen (P : Program) (l : List Bool) (s : State) :
    run P (fixLen l (measurementCount P)) s = run P l s := by
  unfold fixLen
  rw [run_take, run_pad]

/-- Record independence of a middle block, from record independence of the whole. -/
theorem tapeFree_middle (A B C : Program) (s : State)
    (whole : ∀ m n, run (A ++ (B ++ C)) m s = run (A ++ (B ++ C)) n s)
    (a r r' : List Bool) :
    run B r (run A a s) = run B r' (run A a s) := by
  have key : ∀ r : List Bool,
      run (A ++ (B ++ C))
        (fixLen a (measurementCount A) ++ (fixLen r (measurementCount B) ++ [])) s =
        run C [] (run B r (run A a s)) := by
    intro r
    rw [run_append, List.take_left' (fixLen_length _ _), List.drop_left' (fixLen_length _ _),
      run_fixLen, run_append, List.take_left' (fixLen_length _ _),
      List.drop_left' (fixLen_length _ _), run_fixLen]
  have hb := run_basis_records B r r' (run A a s) (run A a s) rfl
  have hc := whole (fixLen a (measurementCount A) ++ (fixLen r (measurementCount B) ++ []))
    (fixLen a (measurementCount A) ++ (fixLen r' (measurementCount B) ++ []))
  rw [key r, key r'] at hc
  apply State.extensionality _ _ _ hb
  generalize run B r (run A a s) = Y at hc hb ⊢
  generalize run B r' (run A a s) = Y' at hc hb ⊢
  obtain ⟨p, x⟩ := Y
  obtain ⟨p', x'⟩ := Y'
  simp only at hb ⊢
  rw [← hb] at hc
  cases p <;> cases p'
  · rfl
  · exfalso
    have sh : run C [] ⟨true, x⟩ =
        ⟨(run C [] ⟨false, x⟩).phase ^^ true, (run C [] ⟨false, x⟩).basis⟩ :=
      run_shift C [] false true x
    have ph := congrArg State.phase (hc.trans sh)
    revert ph
    cases (run C [] ⟨false, x⟩).phase <;> simp
  · exfalso
    have sh : run C [] ⟨true, x⟩ =
        ⟨(run C [] ⟨false, x⟩).phase ^^ true, (run C [] ⟨false, x⟩).basis⟩ :=
      run_shift C [] false true x
    have ph := congrArg State.phase (hc.symm.trans sh)
    revert ph
    cases (run C [] ⟨false, x⟩).phase <;> simp
  · rfl

/-- Record independence of the whole from `run_basis_records` plus a fixed phase. -/
theorem tapeFree_of_phase (P : Program) (s : State)
    (phase : ∀ m, (run P m s).phase = s.phase) (m n : List Bool) :
    run P m s = run P n s :=
  State.extensionality _ _ ((phase m).trans (phase n).symm)
    (run_basis_records P m n s s rfl)

/-! ## K1 (replay budget): operand lists and bit masks for static program checks

`decide (q ∉ Instr.wires i)` builds a `Finset` per instruction (and per wire `q`); the checks
below test list operands once per instruction and wire sets as one bit mask per program. -/

/-- Operands of a correction list, as a list. -/
def k1corrList : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: k1corrList cs
  | .CZ a b :: cs => a :: b :: k1corrList cs

/-- Operands of one instruction, as a list. -/
def k1wl : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (k1corrList c₀ ++ k1corrList c₁)

theorem k1_mem_corrList (q : Wire) :
    ∀ cs : List Correction, q ∈ correctionWires cs → q ∈ k1corrList cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k1corrList, List.mem_cons]
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (k1_mem_corrList q cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      simp only [k1corrList, List.mem_cons]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (k1_mem_corrList q cs h))

theorem k1_mem_wl (q : Wire) (i : Instr) (h : q ∈ Instr.wires i) : q ∈ k1wl i := by
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_singleton]
      exact h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | measureX t c₀ c₁ =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.mem_append]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl (k1_mem_corrList q c₀ h))
      · exact Or.inr (Or.inr (k1_mem_corrList q c₁ h))

def k1listMask : List Wire → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| k1listMask xs

theorem k1_testBit_listMask : ∀ (l : List Wire) (q : Wire),
    (k1listMask l).testBit q = decide (q ∈ l)
  | [], q => by simp [k1listMask]
  | x :: xs, q => by
    simp only [k1listMask, Nat.testBit_or, k1_testBit_listMask xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm

/-- All operands of a program, as one bit mask. -/
def k1progMask : Program → Nat
  | [] => 0
  | i :: P => k1listMask (k1wl i) ||| k1progMask P

theorem k1_all_not_mem_of_mask (P : Program) (q : Wire) (h : (k1progMask P).testBit q = false) :
    P.all (fun i => decide (q ∉ Instr.wires i)) = true := by
  induction P with
  | nil => rfl
  | cons i P ih =>
    simp only [k1progMask, Nat.testBit_or, Bool.or_eq_false_iff] at h
    have h1 := h.1
    rw [k1_testBit_listMask] at h1
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨fun hm => by simp [k1_mem_wl q i hm] at h1, ih h.2⟩


/-- Non-`X` targets of a program, as one bit mask. -/
def k1hitBit : Instr → Nat
  | .X _ => 0
  | .CX _ t => 2 ^ t
  | .CCX _ _ t => 2 ^ t
  | .measureX t _ _ => 2 ^ t

def k1hitMask : Program → Nat
  | [] => 0
  | i :: P => k1hitBit i ||| k1hitMask P

/-- `X` targets of a program, XOR-ed into one bit mask. -/
def k1xBit : Instr → Nat
  | .X t => 2 ^ t
  | _ => 0

def k1xMask : Program → Nat
  | [] => 0
  | i :: P => k1xBit i ^^^ k1xMask P

theorem k1_testBit_hitBit (q : Wire) (i : Instr) : (k1hitBit i).testBit q = hitsNonX q i := by
  cases i <;> simp only [k1hitBit, hitsNonX, Nat.testBit_two_pow, Nat.zero_testBit] <;>
    exact Bool.eq_iff_iff.mpr (by simp)

theorem k1_testBit_xBit (q : Wire) (i : Instr) : (k1xBit i).testBit q = isXOn q i := by
  cases i with
  | X t =>
    simp only [k1xBit, isXOn, Nat.testBit_two_pow]
    exact Bool.eq_iff_iff.mpr (by simp)
  | CX c t => simp only [k1xBit, isXOn, Nat.zero_testBit]
  | CCX a c t => simp only [k1xBit, isXOn, Nat.zero_testBit]
  | measureX t c₀ c₁ => simp only [k1xBit, isXOn, Nat.zero_testBit]

theorem k1_all_hits (q : Wire) : ∀ P : Program,
    P.all (fun i => !hitsNonX q i) = !(k1hitMask P).testBit q
  | [] => by simp [k1hitMask]
  | i :: P => by
    simp only [List.all_cons, k1hitMask, Nat.testBit_or, k1_testBit_hitBit, k1_all_hits q P,
      Bool.not_or]

theorem k1_xParity (q : Wire) : ∀ P : Program, xParity q P = (k1xMask P).testBit q
  | [] => by simp [xParity, k1xMask]
  | i :: P => by
    simp only [xParity, k1xMask, Nat.testBit_xor, k1_testBit_xBit, k1_xParity q P]

end ECDSAAdd.Entrant.StairDivLoanTop
end Merge_StairDivLoanTopGeneric_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3ZT_at_StairSideA` -/
section Merge_StairField13V3ZT_at_StairSideA

/-!
# Field 13 on v3: static zero tracker (LT29), generic and early

`zt w b P` is a sound static zero tracker for one wire: starting from the
status `b` ("`w` is known to be zero"), the last instruction of `P` that
writes `w` decides the status (a `measureX` on `w` resets `w` to `0` for every
input and every tape; any other write makes it unknown).  The tracker is
tail recursive with the status forced at every write, so kernel evaluation on
packet-sized programs stays shallow.  Composition lemmas (append, renaming,
packet sequences, support) let large programs be split into small checked
pieces; no concrete program run is evaluated anywhere.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic







theorem zt_mono (w : Wire) : ∀ (P : Program) (b : Bool), zt w false P = true → zt w b P = true := by
  intro P
  induction P with
  | nil => intro b h; simp [zt] at h
  | cons i p ih =>
    intro b h
    simp only [zt] at h ⊢
    split
    · rename_i hc; rw [if_pos hc] at h; exact h
    · rename_i hc; rw [if_neg hc] at h; exact ih b h








/-! ## Single-pass tracker for the wires of a window `[lo, lo + width)`

The statuses are the bits of a natural number; every update is forced
(`Nat.beq m m`), so the kernel evaluates the tracker with constant depth. -/










/-! ## LT49 (replay budget): structural reductions of `ztAll` checks -/


/-- Only a resetting suffix needs to be checked (the prefix is arbitrary). -/
theorem ztAll_of_suffix (lo width : Nat) (b : Bool) (ws : List Wire) (X Y : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ztAll lo width false ws Y = true) :
    ztAll lo width b ws (X ++ Y) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_append]
    exact zt_mono w Y _ (zt_of_ztAll lo width false ws Y hr h w hw))

/-- A program that touches none of the wires keeps their status. -/
theorem ztAll_true_of_not_mem (lo width : Nat) (ws : List Wire) (P : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ∀ w ∈ ws, w ∉ wires P) :
    ztAll lo width true ws P = true :=
  ztAll_of_zt lo width true ws P hr (fun w hw => zt_of_not_mem w P true (h w hw))

/-! ## K1 (replay budget): composition lemmas for structural `ztAll` checks

The kernel builds the gate list of a recursive generator (`majority ++ rec ++ erase`) with
left-nested appends, which costs quadratic time in the recursion depth.  These lemmas let a check
descend into a program structurally (renamings that fix the checked wires, append splits) and
evaluate the tracker of a recursive generator through a fused recursion instead. -/

theorem k1_ztM_append (lo width : Nat) : ∀ (A B : Program) (m : Nat),
    ztM lo width m (A ++ B) = ztM lo width (ztM lo width m A) B
  | [], _, _ => rfl
  | i :: A, B, m => by
    by_cases h : lo ≤ tgt i ∧ tgt i < lo + width
    · simp only [List.cons_append, ztM, if_pos h, Nat.beq_refl, cond_true]
      exact k1_ztM_append lo width A B _
    · simp only [List.cons_append, ztM, if_neg h]
      exact k1_ztM_append lo width A B _

/-- A reset status of every listed wire survives a suffix that is checked from status `true`. -/
theorem k1_ztAll_append_true (lo width : Nat) (b : Bool) (ws : List Wire) (A B : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (hA : ztAll lo width b ws A = true)
    (hB : ztAll lo width true ws B = true) : ztAll lo width b ws (A ++ B) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_append, zt_of_ztAll lo width b ws A hr hA w hw]
    exact zt_of_ztAll lo width true ws B hr hB w hw)

/-- An injective renaming that fixes every listed wire does not change the check. -/
theorem k1_ztAll_rename_fixed (lo width : Nat) (b : Bool) (ws : List Wire) (f : Wire → Wire)
    (hf : Function.Injective f) (P : Program) (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (hfix : ∀ w ∈ ws, f w = w) (h : ztAll lo width b ws P = true) :
    ztAll lo width b ws (renameProgram f P) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_rename_fixed f hf w (hfix w hw)]
    exact zt_of_ztAll lo width b ws P hr h w hw)

end ECDSAAdd.Entrant.StairField13V3Clean

end
end Merge_StairField13V3ZT_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3ChkFirstF_at_StairSideA` -/
section Merge_StairField13V3ChkFirstF_at_StairSideA

/-!
# Field 13 on v3: kernel checks for `EntryClean` / `ExitClean` (LT29): first packet core (false)

`decide +kernel` evaluations of the static zero tracker `ztAll`
(`StairField13V3ZT`) on packet-sized programs in their own unrenamed
coordinates.  No program run is evaluated.  One small module per group of
checks, importing only the module that defines the checked programs, so the
checks run in parallel early in the build.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed

/-- K1 (replay budget): the tracker of `EntryRetained5.Affine.add`, fused along its recursion
(linear kernel evaluation; the gate list itself is never built). -/
def k1ztAA (lo width : Nat) :
    Nat → List EntryRetained5.Affine.Bit → List Wire → List Wire → Wire → Nat
  | m, b::b'::bs, y::y'::ys, c::cs, cin =>
      ztM lo width
        (ztM lo width
          (k1ztAA lo width (ztM lo width m (EntryRetained5.Affine.majority b y cin c))
            (b'::bs) (y'::ys) cs c)
          (EntryRetained5.Affine.erase b y cin c))
        (EntryRetained5.Affine.sum b y cin)
  | m, [b], [y], _, cin => ztM lo width m (EntryRetained5.Affine.sum b y cin)
  | m, _, _, _, _ => m

theorem k1_ztM_add (lo width : Nat) :
    ∀ (bs : List EntryRetained5.Affine.Bit) (ys cs : List Wire) (cin : Wire) (m : Nat),
    ztM lo width m (EntryRetained5.Affine.add bs ys cs cin) = k1ztAA lo width m bs ys cs cin
  | [], _, _, _, _ => rfl
  | [_], [], _, _, _ => rfl
  | [_], [_], _, _, _ => rfl
  | [_], _::_::_, _, _, _ => rfl
  | _::_::_, [], _, _, _ => rfl
  | _::_::_, [_], _, _, _ => rfl
  | _::_::_, _::_::_, [], _, _ => rfl
  | b::b'::bs, y::y'::ys, c::cs, cin, m => by
    show ztM lo width m (EntryRetained5.Affine.majority b y cin c ++
        EntryRetained5.Affine.add (b'::bs) (y'::ys) cs c ++ EntryRetained5.Affine.erase b y cin c ++
        EntryRetained5.Affine.sum b y cin) = _
    rw [k1_ztM_append, k1_ztM_append, k1_ztM_append, k1_ztM_add lo width (b'::bs) (y'::ys) cs c]
    rfl

/-- K1 (replay budget): `CleanInverse5.inverse` (built by left-nested appends, quadratic for the
kernel) writes only the targets of its argument. -/
theorem k1_zt_inverse (w : Wire) : ∀ (P : Program) (b : Bool), (∀ i ∈ P, tgt i ≠ w) →
    zt w b (CleanInverse5.inverse P) = b
  | [], _, _ => rfl
  | i :: P, b, h => by
    have hi : tgt i ≠ w := h i (List.mem_cons_self ..)
    have hP : ∀ j ∈ P, tgt j ≠ w := fun j hj => h j (List.mem_cons_of_mem _ hj)
    show zt w b (CleanInverse5.inverse P ++ CleanInverse5.undo i) = b
    rw [zt_append, k1_zt_inverse w P b hP]
    cases i with
    | X t => simp only [tgt] at hi; simp only [CleanInverse5.undo, zt, tgt, if_neg hi]
    | CX c t => simp only [tgt] at hi; simp only [CleanInverse5.undo, zt, tgt, if_neg hi]
    | CCX a c t => simp only [tgt] at hi; simp only [CleanInverse5.undo, zt, tgt, if_neg hi]
    | measureX t c0 c1 => rfl

theorem k1_ztAll_inverse (lo width : Nat) (ws : List Wire) (P : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (h : P.all (fun i => decide (tgt i < lo) || decide (lo + width ≤ tgt i)) = true) :
    ztAll lo width true ws (CleanInverse5.inverse P) = true :=
  ztAll_of_zt lo width true ws _ hr (fun w hw => k1_zt_inverse w P true (fun i hi e => by
    have t := List.all_eq_true.mp h i hi
    simp only [Bool.or_eq_true, decide_eq_true_eq] at t
    rw [e] at t
    rcases t with t | t
    · exact Nat.not_lt.mpr (hr w hw).1 t
    · exact Nat.not_lt.mpr t (hr w hw).2))

/-! K4C (replay budget): the fused adder tracker skips the levels whose four written wires
(`b.wire`, `y`, `cin`, `c`) lie outside the window (no gate list is built for them);
`k4f_aa_eq` shows it equals `k1ztAA`, since out-of-window gates leave the status mask unchanged. -/

theorem k4f_ztM_out (lo width : Nat) : ∀ (P : Program) (m : Nat),
    (∀ i ∈ P, ¬ (lo ≤ tgt i ∧ tgt i < lo + width)) → ztM lo width m P = m
  | [], _, _ => rfl
  | i :: P, m, h => by
    have hi := h i (List.mem_cons_self ..)
    rw [ztM, if_neg hi]
    exact k4f_ztM_out lo width P m (fun j hj => h j (List.mem_cons_of_mem _ hj))

theorem k4f_maj_tgt (b : EntryRetained5.Affine.Bit) (y cin c : Wire) :
    ∀ i ∈ EntryRetained5.Affine.majority b y cin c,
      tgt i = b.wire ∨ tgt i = y ∨ tgt i = cin ∨ tgt i = c := by
  intro i hi
  simp only [EntryRetained5.Affine.majority, EntryRetained5.Affine.view, EntryRetained5.Affine.fan,
    ECDSAAdd.Arithmetic.majority, List.mem_append, List.mem_reverse, List.mem_map, List.mem_cons,
    List.not_mem_nil, or_false] at hi
  rcases hi with (⟨a, -, rfl⟩ | rfl | rfl | rfl | rfl | rfl | rfl) | ⟨a, -, rfl⟩
  all_goals simp [tgt]

theorem k4f_erase_tgt (b : EntryRetained5.Affine.Bit) (y cin c : Wire) :
    ∀ i ∈ EntryRetained5.Affine.erase b y cin c, tgt i = b.wire ∨ tgt i = c := by
  intro i hi
  simp only [EntryRetained5.Affine.erase, EntryRetained5.Affine.view, EntryRetained5.Affine.fan,
    ECDSAAdd.Arithmetic.eraseCarry, List.mem_append, List.mem_reverse, List.mem_map,
    List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with (⟨a, -, rfl⟩ | rfl) | ⟨a, -, rfl⟩
  all_goals simp [tgt]

theorem k4f_sum_tgt (b : EntryRetained5.Affine.Bit) (y cin : Wire) :
    ∀ i ∈ EntryRetained5.Affine.sum b y cin, tgt i = y := by
  intro i hi
  simp only [EntryRetained5.Affine.sum, EntryRetained5.Affine.fan, List.mem_append, List.mem_map,
    List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with ⟨a, -, rfl⟩ | rfl
  all_goals rfl

/-- Window test of one wire. -/
def k4fIn (lo width q : Nat) : Bool := decide (lo ≤ q ∧ q < lo + width)

/-- `k1ztAA` with the out-of-window levels skipped. -/
def k4fAA (lo width : Nat) :
    Nat → List EntryRetained5.Affine.Bit → List Wire → List Wire → Wire → Nat
  | m, b::b'::bs, y::y'::ys, c::cs, cin =>
      if (k4fIn lo width b.wire || k4fIn lo width y || k4fIn lo width cin ||
          k4fIn lo width c) = true then
        ztM lo width
          (ztM lo width
            (k4fAA lo width (ztM lo width m (EntryRetained5.Affine.majority b y cin c))
              (b'::bs) (y'::ys) cs c)
            (EntryRetained5.Affine.erase b y cin c))
          (EntryRetained5.Affine.sum b y cin)
      else k4fAA lo width m (b'::bs) (y'::ys) cs c
  | m, [b], [y], _, cin => ztM lo width m (EntryRetained5.Affine.sum b y cin)
  | m, _, _, _, _ => m

theorem k4f_aa_eq (lo width : Nat) :
    ∀ (m : Nat) (bs : List EntryRetained5.Affine.Bit) (ys cs : List Wire) (cin : Wire),
    k1ztAA lo width m bs ys cs cin = k4fAA lo width m bs ys cs cin
  | _, [], _, _, _ => rfl
  | _, [_], [], _, _ => rfl
  | _, [_], [_], _, _ => rfl
  | _, [_], _::_::_, _, _ => rfl
  | _, _::_::_, [], _, _ => rfl
  | _, _::_::_, [_], _, _ => rfl
  | _, _::_::_, _::_::_, [], _ => rfl
  | m, b::b'::bs, y::y'::ys, c::cs, cin => by
    simp only [k1ztAA, k4fAA]
    split
    · rw [k4f_aa_eq lo width _ (b'::bs) (y'::ys) cs c]
    · rename_i h
      simp only [k4fIn, Bool.or_eq_true, decide_eq_true_eq, not_or] at h
      obtain ⟨⟨⟨hb, hy⟩, hcin⟩, hc⟩ := h
      rw [k4f_ztM_out lo width (EntryRetained5.Affine.majority b y cin c) m (fun i hi => by
        rcases k4f_maj_tgt b y cin c i hi with e | e | e | e <;> rw [e] <;> assumption)]
      rw [k4f_ztM_out lo width (EntryRetained5.Affine.erase b y cin c) _ (fun i hi => by
        rcases k4f_erase_tgt b y cin c i hi with e | e <;> rw [e] <;> assumption)]
      rw [k4f_ztM_out lo width (EntryRetained5.Affine.sum b y cin) _ (fun i hi => by
        rw [k4f_sum_tgt b y cin i hi]; exact hy)]
      exact k4f_aa_eq lo width m (b'::bs) (y'::ys) cs c

set_option maxHeartbeats 0 in
theorem chk_firstCore_false : ztAll 736 45 false (rolesL)
    (Rolling1588.firstCore false) = true := by
  -- LT49 (replay budget): only the resetting suffix of the body (`paddedD ++ triple 2 3 4 d3`,
  -- renamed) with `restore` and the encode is evaluated (≈ 7k of 52k gates).
  simp only [Rolling1588.firstCore, Bool.false_eq_true, ↓reduceIte, G0CarryLoan5.program,
    Rolling1588.firstBodyShort, Rolling1588.firstJointBack,
    ECDSAAdd.Arithmetic.FieldRename.rename_append, List.append_assoc]
  iterate 13 apply ztAll_of_suffix 736 45 _ rolesL _ _ rolesL_window
  -- K1 (replay budget): descend structurally to the last role writer, the inner adder of the
  -- joint inverse's loan; renamings fix the roles, later pieces start from `true`.
  refine k1_ztAll_append_true 736 45 false rolesL _ _ rolesL_window ?_ (by decide +kernel)
  refine k1_ztAll_rename_fixed 736 45 false rolesL _ (Equiv.swap _ _).injective _ rolesL_window
    (by decide +kernel) ?_
  rw [JointInverse1588.paddedD]
