/-! ### merged from `ECDSAAdd.Submission.Entrant.StairEndpoint_at_StairSideA` -/
section Merge_StairEndpoint_at_StairSideA

/-!
# Loan-aware multiplication endpoint

The record multiplication endpoint isolates its modular `p` correction as the
third block of `InverseTailC.program`.  This module replaces only that block
with `StairLoan.pCorrectionLoan68`, then threads the resulting program through
the existing borrow, padding, selector-loan, placement, and retired-760
wrappers.  The division endpoint is left definitionally unchanged.

The semantic equality of the positive loan still needs the clean-carry facts
at the correction boundary.  The definitions and exact resource identities
below do not assume that equality.
-/

set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairEndpoint

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

def tailProgramLoan68 (L : BalancedCircuit.Layout) : Program :=
  InverseTailC.decision L ++ InverseTailC.raw L ++
    StairLoan.pCorrectionLoan68 L ++
    [.CX L.r0 L.parity, .CX (L.ylow.headD L.ymsb) L.parity]

def tailBorrowedLoan68 (L : BalancedCircuit.Layout) : Program :=
  renameProgram (InverseTailC.borrowSwap L) (tailProgramLoan68 L)

def halfLoan68 (L : BalancedCircuit.Layout) : Program :=
  [.X L.sign] ++ tailBorrowedLoan68 L ++ [.X L.sign]

def paddedLoan68 (L : BalancedCircuit.Layout) (c : Wire) : Program :=
  halfLoan68 L ++ List.replicate 256 (Instr.measureX c [] [])

def endHalfLoan68 (divide : Bool) : Program :=
  if divide then Rolling1588Lifetime.endHalf true
  else paddedLoan68 (Q6EndpointCell.ports base (base 2409)) (base 512)

def rawEndLoan68 (divide : Bool) : Program :=
  ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
    (endHalfLoan68 divide)

def endPacketLoan68 (divide : Bool) : Program :=
  renameProgram (shifted Placement5.pi0) (rawEndLoan68 divide)

def endPacket760Loan68 (divide : Bool) : Program :=
  renameProgram (Equiv.swap (base 760) (base 717))
    (endPacketLoan68 divide)










end ECDSAAdd.Entrant.StairEndpoint
end Merge_StairEndpoint_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3K1Loan_at_StairSideA` -/
section Merge_StairField13V3K1Loan_at_StairSideA

/-!
# Field 13 on v3: structural `ztAll` lemmas for the loaned halves (K1, replay budget)

The kernel builds `StairLoan.emitDowns` (and `literalConstAdd`) with left-nested appends, which
costs quadratic time in the number of carry layers.  The loaned-half checks
(`StairField13V3ChkHalf*`) descend structurally into `emitLoan` (append splits, renamings and
`rebindMany` relabellings that fix the checked roles) and evaluate the tracker of the upper
sweep's down-pass through a fused recursion; no gate list of a sweep is built.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed

/-- The tracker of `StairLoan.emitDowns`, fused along the layer list. -/
def k1ztDowns (lo width : Nat) : Nat → List StairLoan.CarryLayer → Nat
  | m, [] => m
  | m, l :: ls => ztM lo width (k1ztDowns lo width m ls) (l.erase ++ l.finish)

theorem k1_ztM_downs (lo width : Nat) : ∀ (ls : List StairLoan.CarryLayer) (m : Nat),
    ztM lo width m (StairLoan.emitDowns ls) = k1ztDowns lo width m ls
  | [], _ => rfl
  | l :: ls, m => by
    show ztM lo width m (StairLoan.emitDowns ls ++ (l.erase ++ l.finish)) = _
    rw [k1_ztM_append, k1_ztM_downs lo width ls m]
    rfl



/-- `rebindMany` swaps only its roles and hosts, so it keeps the check on other wires. -/
theorem k1_ztAll_rebind (lo width : Nat) (b : Bool) (ws : List Wire)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) :
    ∀ (rs hs : List Wire) (P : Program), (∀ w ∈ ws, w ∉ rs ∧ w ∉ hs) →
      ztAll lo width b ws P = true → ztAll lo width b ws (StairLoan.rebindMany rs hs P) = true
  | [], _, _, _, hP => hP
  | _ :: _, [], _, _, hP => hP
  | r :: rs, h :: hs, P, hw, hP => by
    show ztAll lo width b ws (renameProgram (Equiv.swap r h) (StairLoan.rebindMany rs hs P)) = true
    refine k1_ztAll_rename_fixed lo width b ws _ (Equiv.swap r h).injective _ hr
      (fun w hw' => Equiv.swap_apply_of_ne_of_ne
        (fun e => (hw w hw').1 (by rw [e]; exact List.mem_cons_self ..))
        (fun e => (hw w hw').2 (by rw [e]; exact List.mem_cons_self ..)))
      (k1_ztAll_rebind lo width b ws hr rs hs P
        (fun w hw' => ⟨fun m => (hw w hw').1 (List.mem_cons_of_mem _ m),
          fun m => (hw w hw').2 (List.mem_cons_of_mem _ m)⟩) hP)

/-! ## K3 (replay budget, round 2): one d-generic proof per loaned-half family

All kernel evaluation of the loaned-half checks happens once, in closed checks inside the
d-generic theorems `k3_half_false` / `k3_half_true`: the pieces outside the loan on all 44 roles,
the upper down-pass at the deepest loan (`ls.drop 43`), one operand mask of the 43 lowest layers
(the lower down-passes and the borrowed up-passes never touch a role), and the rebind
disjointness (`rolesL` is a nodup list, its first `d` entries are the loaned roles). -/

/-- Operands of a correction list, as a list. -/
def k3cl : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: k3cl cs
  | .CZ a b :: cs => a :: b :: k3cl cs

/-- Operands of an instruction, as a list (no `Finset`). -/
def k3wl : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (k3cl c₀ ++ k3cl c₁)

theorem k3_mem_cl (q : Wire) : ∀ cs : List Correction, q ∈ correctionWires cs → q ∈ k3cl cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k3cl, List.mem_cons]
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (k3_mem_cl q cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      simp only [k3cl, List.mem_cons]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (k3_mem_cl q cs h))

theorem k3_mem_wl (q : Wire) (i : Instr) (h : q ∈ Instr.wires i) : q ∈ k3wl i := by
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_singleton]
      exact h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | measureX t c₀ c₁ =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_cons, List.mem_append]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl (k3_mem_cl q c₀ h))
      · exact Or.inr (Or.inr (k3_mem_cl q c₁ h))

/-- All operands of a program, as one bit mask. -/
def k3progMask : Program → Nat
  | [] => 0
  | i :: P => StairLoan.maskOf (k3wl i) ||| k3progMask P

theorem k3_not_mem_of_mask : ∀ (P : Program) (q : Wire), (k3progMask P).testBit q = false →
    q ∉ wires P
  | [], _, _ => by simp [wires]
  | i :: P, q, h => by
    simp only [k3progMask, Nat.testBit_or, Bool.or_eq_false_iff] at h
    intro hq
    rw [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · have t := h.1
      rw [StairLoan.testBit_maskOf] at t
      exact absurd (k3_mem_wl q i hq) (of_decide_eq_false t)
    · exact k3_not_mem_of_mask P q h.2 hq

theorem k3_avoid (P : Program) (ws : List Wire)
    (h : ws.all (fun w => !(k3progMask P).testBit w) = true) : ∀ w ∈ ws, w ∉ wires P := by
  intro w hw
  apply k3_not_mem_of_mask
  have t := List.all_eq_true.mp h w hw
  simpa using t

theorem k3_avoid_list (l ws : List Wire)
    (h : ws.all (fun w => !(StairLoan.maskOf l).testBit w) = true) : ∀ w ∈ ws, w ∉ l := by
  intro w hw hm
  have t := List.all_eq_true.mp h w hw
