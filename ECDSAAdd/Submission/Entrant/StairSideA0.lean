def relabelInv (q : Wire) : Wire := fPlaceInv (Rolling1588Lifetime.phaseHost.symm q)

theorem relabel_inv (q : Wire) : phaseRelabel (relabelInv q) = q := by
  show Rolling1588Lifetime.phaseHost (fPlace (fPlaceInv (Rolling1588Lifetime.phaseHost.symm q))) = q
