section Merge_StairField2V3RecScratch_at_QTop

/-!
# LT42: the record fact `RecordScratch` for the five middle rows

The genuine record state after the record division prefix `R1 … R5` is zero on
the segment scratch `scratchT B B'` (pulled through `fieldPlace`).

Route (LT32's `StairLoanField7Values.entryGroups_inner`): after the record first
phase, the hosted wrapper and the first packet, the field view of the actual
state agrees off `EP = E ∪ payload0` with a placed record state carrying
`Rolling1588.CutFrame 1`; every record group avoids `EP`, so the agreement and
the frame (`groups_cut_frame`) move to `CutFrame (1+N)` at every segment cut
(`Inv`).  On a `CutFrame` every scratch label is zero (`frame_zero`): it is a
work/hole label, or an origin-clean label off the r/y words and the history
(`Env`), or the selector `base 2409` (`Context.hg0`); the per-row membership is a
finite check (`recFacts_*`, `decide +kernel`).

Sections "Exceptional sites" … "R0_shape" are verbatim copies of LT32's helpers
(`StairLoanField7Values`, which is not in this tree).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3RecScratch

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairOuterPlacement

attribute [local irreducible] wires run

/-! ## Exceptional sites -/

/-- Sites where the actual field-coordinate state may differ from the record frame. -/
def E : List Wire := [base 511, FrontierEntry1591Field.host, base 2400]

/-- The record frame state with the control bit forced (record `local_replace` trick). -/
def force (s : State) : State := ⟨s.phase, writeBit s.basis (base 2400) true⟩

theorem not_E {q : Wire} (h : q ∉ E) :
    q ≠ base 511 ∧ q ≠ FrontierEntry1591Field.host ∧ q ≠ base 2400 := by
  simp only [E, List.mem_cons, List.not_mem_nil, or_false, not_or] at h
  exact h

theorem force_off (s : State) (q : Wire) (h : q ≠ base 2400) :
    (force s).basis q = s.basis q := by
  simp only [force, writeBit, Function.update_of_ne h]

theorem mem_rename_fixed (f : Wire → Wire) (P : Program) (q : Wire)
    (h : q ∈ wires P) (fix : f q = q) : q ∈ wires (renameProgram f P) := by
  rw [renameProgram_support]
  exact Finset.mem_image.mpr ⟨q, h, fix⟩

theorem borrow_fix (q : Wire) (h1 : q ≠ base 768) (h2 : q ≠ base 0) :
    Prefix1590.borrow q = q :=
  Equiv.swap_apply_of_ne_of_ne h1 h2

/-! ## The scratch window -/

theorem history0_not_E : ∀ r : Fin 10, History5.historyMap base 0 r ∉ E := by
  decide +kernel

theorem label_not_E (q : Nat) : FourScratchWindow.label q ∉ E := by
  unfold FourScratchWindow.label
  split_ifs with h1 h2
  · exact history0_not_E ⟨q, h1⟩
  · decide +kernel
  · decide +kernel

theorem pull_basis_eq (y v : State) (agree : ∀ q, q ∉ E → y.basis q = v.basis q) :
    (FourScratchWindow.pull y).basis = (FourScratchWindow.pull v).basis := by
  funext q
  exact agree _ (label_not_E q)

theorem clean_transfer (y v : State) (agree : ∀ q, q ∉ E → y.basis q = v.basis q)
    (clean : FourScratchWindow.Clean v) : FourScratchWindow.Clean y := by
  unfold FourScratchWindow.Clean
  rw [pull_basis_eq y v agree]
  exact clean

theorem member_transfer (y v : State) (agree : ∀ q, q ∉ E → y.basis q = v.basis q)
    (member : Prefix1590Codec.codeAt (History5.historyMap base 0) v.basis ∈
      Prefix1590Codec.canonicalCodes) :
    Prefix1590Codec.codeAt (History5.historyMap base 0) y.basis ∈
      Prefix1590Codec.canonicalCodes := by
  rw [← FourScratchWindow.code_compat, pull_basis_eq y v agree, FourScratchWindow.code_compat]
  exact member

theorem port_split (r : Fin 12) :
    r.val = 5 ∨ r.val = 9 ∨ r.val = 10 ∨ r.val = 11 ∨
      ∃ i : Fin 8, FourScratchWindow.label r = Prefix1590.payload0 i := by
  fin_cases r <;> decide +kernel

theorem payload0_zero : Prefix1590.payload0 0 = base 0 := by decide +kernel

/-- **Scratch window**: after `clearProgram`, the borrowed view of a state that agrees
with a clean record frame state `v` off `E` agrees with `v` off `E` and the payload. -/
theorem window_agree (y v : State) (b : List Bool)
    (agree : ∀ q, q ∉ E → y.basis q = v.basis q)
    (clean : FourScratchWindow.Clean v)
    (member : Prefix1590Codec.codeAt (History5.historyMap base 0) v.basis ∈
      Prefix1590Codec.canonicalCodes)
    (z768 : v.basis (base 768) = false) :
    ∀ q, q ∉ E → (∀ i : Fin 8, q ≠ Prefix1590.payload0 i) →
      (pullState Prefix1590.borrow (run FourScratchWindow.clearProgram b y)).basis q =
        v.basis q := by
  have cy := clean_transfer y v agree clean
  have my := member_transfer y v agree member
  rw [FourScratchWindow.clear_eq y b [] cy my]
  intro q hE hP
  show (run FourScratchWindow.prefixProgram [] y).basis (Prefix1590.borrow q) = v.basis q
  by_cases h768 : q = base 768
  · subst h768
    have hb : Prefix1590.borrow (base 768) = base 0 := Equiv.swap_apply_left _ _
    rw [hb, FourScratchWindow.prefix_zero y [] cy my, z768]
  · have h0 : q ≠ base 0 := by
      intro h
      exact hP 0 (h.trans payload0_zero.symm)
    rw [borrow_fix q h768 h0]
    by_cases used : q ∈ wires FourScratchWindow.prefixProgram
    · rw [FourScratchWindow.supports.1] at used
      obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp used
      have hr' := Finset.mem_range.mp hr
      have out := FourScratchWindow.prefix_clean y [] cy
      rcases port_split ⟨r, hr'⟩ with h | h | h | h | ⟨i, hi⟩
      · have e : r = 5 := h
        subst e
        exact out.1.trans clean.1.symm
      · have e : r = 9 := h
        subst e
        exact out.2.1.trans clean.2.1.symm
      · have e : r = 10 := h
        subst e
        exact out.2.2.1.trans clean.2.2.1.symm
      · have e : r = 11 := h
        subst e
        exact out.2.2.2.trans clean.2.2.2.symm
      · exact absurd hi (hP i)
    · rw [run_preserves_outside _ _ _ _ used]
      exact agree q hE

/-! ## The host/parity wrapper -/

theorem field_pullIn (P : Program) (m : List Bool) (u : State) :
    StairField2V3Seg.pullIn (run (StairSchedule.fieldRename P) m u) =
      pullState Prefix1590.borrow (run P m (pullState HostOB5.hostSwap
        (pullState (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) u))) := by
  unfold StairSchedule.fieldRename StairSchedule.parityRename
  rw [StairRename.rename_run_conjugate
      (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
      (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host).injective
      (fun q => Equiv.swap_apply_self _ _ q),
    StairRename.rename_run_conjugate HostOB5.hostSwap HostOB5.hostSwap_injective
      HostOB5.hostSwap_invol]
  apply State.extensionality
  · rfl
  · funext r
    simp only [StairField2V3Seg.pullIn, pullState, StairOuterPlacement.fieldPlace,
      Equiv.swap_apply_self, HostOB5.hostSwap_invol]

/-- The field-coordinate view of a hosted record state after `paritySetup ++ hostedX`
agrees with the record state off `base 511` and the parity host. -/
theorem hosted_agree (v : State)
    (h2409 : v.basis (base 2409) = false) (h511 : v.basis (base 511) = true)
    (h2410 : v.basis (base 2410) = false) (h1542 : v.basis (base 1542) = false)
    (workIn : v.basis FrontierEntry1591Field.work = false)
    (parity : v.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map v.basis))
    (m : List Bool) (q : Wire) (n511 : q ≠ base 511)
    (nhost : q ≠ FrontierEntry1591Field.host) :
    (run (StairSchedule.paritySetup ++ StairSchedule.hostedX) m v).basis
        ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
          (HostOB5.hostSwap q)) = v.basis q := by
  have hu : run (StairSchedule.paritySetup ++ StairSchedule.hostedX) m v =
      ⟨v.phase, writeBit (writeBit v.basis FrontierEntry1591Field.host false) (base 511)
        (!(writeBit v.basis FrontierEntry1591Field.host false (base 511)))⟩ := by
    rw [run_append, StairSchedule.paritySetup,
      ParityHost5.setup_zero _ _ _ _ FrontierEntry1591Field.host_not_controls parity,
      StairSchedule.hostedX, HostOB5.host_xrun]
  rw [hu]
  have d1 : base 511 ≠ FrontierEntry1591Field.host := by decide
  have d4 : base 511 ≠ FrontierEntry1591Field.work := by decide
  have d5 : base 1542 ≠ FrontierEntry1591Field.host := by decide
  have d6 : base 1542 ≠ FrontierEntry1591Field.work := by decide
  have d7 : base 2410 ≠ FrontierEntry1591Field.host := by decide
  have d8 : base 2410 ≠ FrontierEntry1591Field.work := by decide
  have d11 : base 1542 ≠ base 511 := by decide
  have d12 : base 2410 ≠ base 511 := by decide
  have s1 : HostOB5.hostSwap (base 2409) = base 511 := by decide
  have s2 : HostOB5.hostSwap (base 2410) = base 1542 := by decide
  have s3 : HostOB5.hostSwap (base 1542) = base 2410 := by decide
  by_cases a1 : q = base 2409
  · subst a1
    rw [s1, Equiv.swap_apply_of_ne_of_ne d4 d1]
    simp only [writeBit, Function.update_self, Function.update_of_ne d1, h511, h2409,
      Bool.not_true]
  by_cases a2 : q = base 2410
  · subst a2
    rw [s2, Equiv.swap_apply_of_ne_of_ne d6 d5]
    simp only [writeBit, Function.update_of_ne d11, Function.update_of_ne d5, h1542, h2410]
  by_cases a3 : q = base 1542
  · subst a3
    rw [s3, Equiv.swap_apply_of_ne_of_ne d8 d7]
    simp only [writeBit, Function.update_of_ne d12, Function.update_of_ne d7, h1542, h2410]
  have fix : HostOB5.hostSwap q = q := by
    simp only [HostOB5.hostSwap, if_neg a1, if_neg n511, if_neg a2, if_neg a3]
  rw [fix]
  by_cases a4 : q = FrontierEntry1591Field.work
  · subst a4
    rw [Equiv.swap_apply_left]
    simp only [writeBit, Function.update_of_ne (Ne.symm d1), Function.update_self, workIn]
  · rw [Equiv.swap_apply_of_ne_of_ne a4 nhost]
    simp only [writeBit, Function.update_of_ne n511, Function.update_of_ne nhost]

/-- Field-coordinate view after `paritySetup ++ hostedX` agrees off `E` with the forced
record state. -/
theorem hosted_agree_force (v : State)
    (h2409 : v.basis (base 2409) = false) (h511 : v.basis (base 511) = true)
    (h2410 : v.basis (base 2410) = false) (h1542 : v.basis (base 1542) = false)
    (workIn : v.basis FrontierEntry1591Field.work = false)
    (parity : v.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map v.basis))
    (m : List Bool) :
    ∀ q, q ∉ E →
      (pullState HostOB5.hostSwap
        (pullState (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
          (run (StairSchedule.paritySetup ++ StairSchedule.hostedX) m v))).basis q =
        (force v).basis q := by
  intro q hq
  obtain ⟨n511, nhost, n2400⟩ := not_E hq
  rw [force_off v q n2400]
  exact hosted_agree v h2409 h511 h2410 h1542 workIn parity m q n511 nhost

/-- Locality off `E`: a program avoiding `E` keeps two states agreeing off `E`. -/
theorem run_agree_off (P : Program) (avoid : ∀ q ∈ E, q ∉ wires P) (y v : State)
    (m : List Bool) (agree : ∀ q, q ∉ E → y.basis q = v.basis q) :
    ∀ q, q ∉ E → (run P m y).basis q = (run P m v).basis q := by
  have onP : ∀ q ∈ wires P, y.basis q = v.basis q :=
    fun q hq => agree q (fun hE => avoid q hE hq)
  have inc := ECDSAAdd.Arithmetic.run_local_increment P y v m onP
  intro q hq
  by_cases used : q ∈ wires P
  · exact inc.2 q used
  · rw [run_preserves_outside _ _ _ _ used, run_preserves_outside _ _ _ _ used]
    exact agree q hq

/-! ## Record facts (copies of LT10's private helpers) -/

theorem trace_last (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (origin : BasisState)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int))) :
    origin (base 511) = true := by
  have tr : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511
      (false, false) = (true, false) := by
    rw [trace]
    exact SkywalkTrace.trace512_last x hx0 hx _
  have e : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511
      (false, false) = (origin (base 511), origin (base (1028 + 511))) := by
    simp [skywalkTapeControls, skywalkSharedTape]
  rw [e] at tr
  exact (Prod.mk.inj tr).1


theorem phase_sites_split :
    Rolling1588Lifetime.phaseSites =
      FrontierEntry1591Native.workSites ∪ Rolling1588Lifetime.phaseHosts := by
  ext q
  simp only [Rolling1588Lifetime.phaseSites, Rolling1588Lifetime.phaseHosts,
    FrontierEntry1591Native.workSites, Finset.mem_union, List.mem_toFinset, List.mem_cons,
    List.not_mem_nil, or_false]
  tauto

/-- The record lifetime lemmas speak about the abbreviation `Rolling1588Lifetime.firstPhase`;
rewrite it away BEFORE any unification under `State.basis` (otherwise the elaborator
evaluates the concrete first phase). -/
theorem lf_eq (isA : Bool) :
    Rolling1588Lifetime.firstPhase isA = Rolling1588.firstPhase isA := rfl


/-! ## Membership walks (variable programs) -/

theorem mem_second_of_four (A B C D : Program) (q : Wire) (h : q ∈ wires B) :
    q ∈ wires (A ++ B ++ C ++ D) := by
  rw [wires_append, wires_append, wires_append]
  exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ h))

theorem mem_third_of_four (A B C D : Program) (q : Wire) (h : q ∈ wires C) :
    q ∈ wires (A ++ B ++ C ++ D) := by
  rw [wires_append, wires_append, wires_append]
  exact Finset.mem_union_left _ (Finset.mem_union_right _ h)

theorem mem_first_of_four (A B C D : Program) (q : Wire) (h : q ∈ wires A) :
    q ∈ wires (A ++ B ++ C ++ D) := by
  rw [wires_append, wires_append, wires_append]
  exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ h))

theorem mem_hosted (P : Program) (q : Wire) (h : q ∈ wires P)
    (fix : HostOB5.hostSwap q = q) : q ∈ wires (FrontierEntry1591Field.hosted P) := by
  unfold FrontierEntry1591Field.hosted
  rw [wires_append, wires_append]
  exact Finset.mem_union_right _ (Finset.mem_union_left _ (mem_rename_fixed _ _ _ h fix))

theorem mem_parity (c : List Wire) (w h : Wire) (P : Program) (q : Wire) (hq : q ∈ wires P)
    (fix : Equiv.swap w h q = q) : q ∈ wires (ParityField1591.program c w h P) := by
  unfold ParityField1591.program ParityHostTransport5.program
  rw [wires_append, wires_append]
  exact Finset.mem_union_left _ (Finset.mem_union_right _ (mem_rename_fixed _ _ _ hq fix))


theorem entryField_avoidE : ∀ q ∈ E, q ∉ wires Rolling1588.entryField := by
  intro q hE hq
  simp only [E, List.mem_cons, List.not_mem_nil, or_false] at hE
  rcases hE with rfl | rfl | rfl
  · exact Rolling1588.entryField_hosts_free.1 hq
  · exact Rolling1588.entryHosted_avoids_host (mem_hosted _ _ hq (by decide +kernel))
  · apply Rolling1588.entry_control_free
    unfold Rolling1588.entryFieldHosted
    exact mem_parity _ _ _ _ _ (mem_hosted _ _ hq (by decide +kernel))
      (Equiv.swap_apply_of_ne_of_ne (by decide +kernel) (by decide +kernel))

theorem firstPacket_avoidE : ∀ q ∈ E, q ∉ wires (Rolling1588.placedFirstPacket true) := by
  intro q hE hq
  apply entryField_avoidE q hE
  unfold Rolling1588.entryField
  exact mem_first_of_four _ _ _ _ _ hq

theorem E_borrow_fix (q : Wire) (hE : q ∈ E) : Prefix1590.borrow q = q := by
  simp only [E, List.mem_cons, List.not_mem_nil, or_false] at hE
  rcases hE with rfl | rfl | rfl
  · exact borrow_fix _ (by decide +kernel) (by decide +kernel)
  · exact borrow_fix _ (by decide +kernel) (by decide +kernel)
  · exact borrow_fix _ (by decide +kernel) (by decide +kernel)

theorem entryTail_avoid (q : Wire) (hq : q ∈ wires Rolling1588.entryTail) :
    q ∉ E ∧ ∀ i : Fin 8, q ≠ Prefix1590.payload0 i := by
  refine ⟨?_, ?_⟩
  · intro hE
    apply entryField_avoidE q hE
    unfold Rolling1588.entryField
    exact mem_third_of_four _ _ _ _ _ (mem_rename_fixed _ _ _ hq (E_borrow_fix q hE))
  · intro i h
    subst h
    exact Rolling1588.entryTail_payload_free i hq

theorem groups_prefix_sub (n : Nat) (hn : n ≤ 101) :
    wires (renameProgram (OB5.sig 511) (Rolling1588.groups true 1 n)) ⊆
      wires Rolling1588.entryTail := by
  have h := StairField2V3Entry.groups_true_add n (101 - n) 1
  rw [show n + (101 - n) = 101 by omega] at h
  intro q hq
  unfold Rolling1588.entryTail
  rw [rename_append', h, rename_append', wires_append, wires_append, wires_append,
    wires_append]
  exact Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_union_left _ hq)))


theorem field_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.field_special_at origin X Y state 2409 (by simp) input
  have b := Rolling1588Frame.field_special_at origin X Y state 2410 (by simp) input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

