/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Pack_at_StairSideA` -/
section Merge_StairField2V3Pack_at_StairSideA

/-!
# LT21: packing a v3 checkpoint at a segment end

From LT1's `CodecInput` of the walk at the row start `startFor B` (with the
sign extension on `bSite B`), `StairPhysicalPrimitives.pack B` (sign-extension
clear, codec pack (field 1, proved), relocation) stores exactly `cmpBits B x`
on the row's future payload (`stored_after_pack`).  Generic in the row; per-row
list facts are `decide +kernel` (`packFacts`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Pack

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack

/-! ## Moves -/

theorem moveProgram_append : ∀ (l1 l2 : List (Wire × Wire)),
    moveProgram (l1 ++ l2) = moveProgram l1 ++ moveProgram l2
  | [], _ => rfl
  | (a, b) :: l1, l2 => by
      simp only [List.cons_append, moveProgram, List.append_assoc, moveProgram_append l1 l2]


theorem relocate_eq (B : Nat) : relocate B = moveProgram (relocPairs B) := by
  unfold relocate relocPairs
  rw [flatMap_moveWire, moveProgram_append]
  rfl

/-! ## Bits from register values -/

theorem bits_of_regValue : ∀ (bits : List Wire) (s : BasisState) (X : Nat),
    regValue bits s = X → ∀ i (hi : i < bits.length), s bits[i] = X.testBit i
  | [], _, _, _, i, hi => by simp at hi
  | a :: rest, s, X, h, i, hi => by
      have hv : regValue (a :: rest) s = (if s a then 1 else 0) + 2 * regValue rest s := rfl
      rw [hv] at h
      cases i with
      | zero =>
          simp only [List.getElem_cons_zero, Nat.testBit_zero]
          cases hs : s a <;> simp [hs] at h ⊢ <;> omega
      | succ i =>
          simp only [List.getElem_cons_succ]
          have hr : regValue rest s = X / 2 := by
            cases hs : s a <;> simp [hs] at h <;> omega
          rw [bits_of_regValue rest s (X / 2) hr i (by simp at hi; omega), Nat.testBit_div_two]

theorem testBit_low (F c k i : Nat) (hik : i < k) :
    (F + c * 2 ^ k).testBit i = F.testBit i := by
  rw [Nat.testBit_eq_decide_div_mod_eq, Nat.testBit_eq_decide_div_mod_eq]
  have hpos : 0 < 2 ^ i := by positivity
  have hk : 2 ^ k = 2 ^ i * 2 ^ (k - i) := by rw [← pow_add]; congr 1; omega
  have e : (F + c * 2 ^ k) / 2 ^ i = F / 2 ^ i + c * 2 ^ (k - i) := by
    rw [hk, show c * (2 ^ i * 2 ^ (k - i)) = 2 ^ i * (c * 2 ^ (k - i)) by ring,
      Nat.add_mul_div_left _ _ hpos]
  rw [e]
  have h2 : 2 ∣ 2 ^ (k - i) := dvd_pow_self 2 (by omega)
  obtain ⟨t, ht⟩ := h2
  rw [ht, show c * (2 * t) = 2 * (c * t) by ring, Nat.add_mul_mod_self_left]

/-! ## Row data -/

def PackFactsA (B : Nat) : Prop :=
  3 ≤ B ∧ B ≤ 87 ∧
  (moveSites (relocPairs B)).Nodup ∧
  restLetters B = (List.range (B - 1)).map (physicalLayout B).S ∧
  (restLetters B).Nodup ∧ (aReg B).Nodup ∧
  bSite B ∉ StairCodec.reg (physicalLayout B).S B ∧ bSite B ∉ StairCodec.reg (physicalLayout B).D B ∧
  bSite B ∉ aReg B ∧ bSite B ∉ cleanList B ∧
  bSite B ∉ moveSites (relocPairs B) ∧
  (physicalLayout B).D (B - 1) ≠ bSite B ∧
  (physicalLayout B).D (B - 2) ∉ moveSites (relocPairs B) ∧
  (physicalLayout B).S (B - 1) ∉ moveSites (relocPairs B)

def PackFactsB (B : Nat) : Prop :=
  (∀ q ∈ aReg B, q ∉ restLetters B ∧ q ∉ moveSites (relocPairs B)) ∧
  (∀ q ∈ cleanList B, q ∉ moveSites (relocPairs B)) ∧
  (∀ r ∈ futurePayload B, r ∉ restLetters B → r ∉ aReg B →
    r ∉ moveSites (relocPairs B) ∧ (r = bSite B ∨
      ((r ∉ StairCodec.reg (physicalLayout B).S B ∧ r ∉ StairCodec.reg (physicalLayout B).D B ∧
        r ∉ cleanList B) ∨ r ∈ cleanList B)))

def PackFacts (B : Nat) : Prop := PackFactsA B ∧ PackFactsB B

theorem declared_eq (B : Nat) (q : Wire) :
    q ∈ StairCodec.declaredSites (physicalLayout B) B ↔
      q ∈ StairCodec.reg (physicalLayout B).S B ∨ q ∈ StairCodec.reg (physicalLayout B).D B ∨
        q ∈ aReg B ∨ q ∈ cleanList B := by
  simp only [StairCodec.declaredSites, StairCodec.workSites, aReg, cleanList, List.mem_append,
    List.append_assoc]

/-! K6 (replay budget): the row facts as one Boolean pass per row (bit masks for the
memberships, `nodupMask` for the `Nodup`s), sound for every `B`; only the Boolean is decided. -/

/-- Boolean form of `PackFactsA`. -/
def k6PA (B : Nat) : Bool :=
  Nat.ble 3 B && Nat.ble B 87 && StairLoan.nodupMask (moveSites (relocPairs B)) 0 &&
  decide (restLetters B = (List.range (B - 1)).map (physicalLayout B).S) &&
  StairLoan.nodupMask (restLetters B) 0 && StairLoan.nodupMask (aReg B) 0 &&
  !(StairLoan.maskOf (StairCodec.reg (physicalLayout B).S B)).testBit (bSite B) &&
  !(StairLoan.maskOf (StairCodec.reg (physicalLayout B).D B)).testBit (bSite B) &&
  !(StairLoan.maskOf (aReg B)).testBit (bSite B) &&
  !(StairLoan.maskOf (cleanList B)).testBit (bSite B) &&
  !(StairLoan.maskOf (moveSites (relocPairs B))).testBit (bSite B) &&
  !decide ((physicalLayout B).D (B - 1) = bSite B) &&
  !(StairLoan.maskOf (moveSites (relocPairs B))).testBit ((physicalLayout B).D (B - 2)) &&
  !(StairLoan.maskOf (moveSites (relocPairs B))).testBit ((physicalLayout B).S (B - 1))

theorem k6PA_sound (B : Nat) (h : k6PA B = true) : PackFactsA B := by
  simp only [k6PA, Bool.and_eq_true, Bool.not_eq_true', StairLoan.testBit_maskOf, Nat.ble_eq,
    decide_eq_true_eq, decide_eq_false_iff_not] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩, h10⟩, h11⟩, h12⟩, h13⟩, h14⟩ := h
  exact ⟨h1, h2, (StairLoan.nodupMask_sound _ 0 h3).1, h4, (StairLoan.nodupMask_sound _ 0 h5).1,
    (StairLoan.nodupMask_sound _ 0 h6).1, h7, h8, h9, h10, h11, h12, h13, h14⟩

/-- Boolean form of `PackFactsB`. -/
def k6PB (B : Nat) : Bool :=
  (aReg B).all (fun q => !(StairLoan.maskOf (restLetters B)).testBit q &&
    !(StairLoan.maskOf (moveSites (relocPairs B))).testBit q) &&
  (cleanList B).all (fun q => !(StairLoan.maskOf (moveSites (relocPairs B))).testBit q) &&
  (futurePayload B).all (fun r => (StairLoan.maskOf (restLetters B)).testBit r ||
    (StairLoan.maskOf (aReg B)).testBit r ||
    (!(StairLoan.maskOf (moveSites (relocPairs B))).testBit r && (Nat.beq r (bSite B) ||
      ((!(StairLoan.maskOf (StairCodec.reg (physicalLayout B).S B)).testBit r &&
        !(StairLoan.maskOf (StairCodec.reg (physicalLayout B).D B)).testBit r &&
        !(StairLoan.maskOf (cleanList B)).testBit r) ||
       (StairLoan.maskOf (cleanList B)).testBit r))))

theorem k6PB_sound (B : Nat) (h : k6PB B = true) : PackFactsB B := by
  simp only [k6PB, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', List.all_eq_true,
    StairLoan.testBit_maskOf, decide_eq_true_eq, decide_eq_false_iff_not, Nat.beq_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨h1, h2, fun r hr hR hA => ?_⟩
  rcases h3 r hr with (hR' | hA') | ⟨hM, hb⟩
  · exact absurd hR' hR
  · exact absurd hA' hA
  · exact ⟨hM, hb.imp id (fun h => h.imp (fun h => ⟨h.1.1, h.1.2, h.2⟩) id)⟩

theorem packFactsA : ∀ B ∈ budgets, PackFactsA B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact k6PA_sound _ (by decide +kernel)

theorem packFactsB : ∀ B ∈ budgets, PackFactsB B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact k6PB_sound _ (by decide +kernel)

theorem packFacts (B : Nat) (hB : B ∈ budgets) : PackFacts B :=
  ⟨packFactsA B hB, packFactsB B hB⟩

/-! ## Codec input depends only on the declared sites -/

theorem codecInput_congr (L : StairCodec.Layout) (B u v : Nat) (σ : Bool) (a b : BasisState)
    (h : ∀ q ∈ StairCodec.declaredSites L B, a q = b q)
    (ha : StairCodec.CodecInput L B u v σ a) : StairCodec.CodecInput L B u v σ b := by
  obtain ⟨hS, hD, hW⟩ := ha
  refine ⟨?_, ?_, ?_⟩
  · rw [← hS]
    exact ((regValue_eq_iff _ _ _).mpr (fun w hw => (h w (by
      simp only [StairCodec.declaredSites, List.mem_append]; exact Or.inl (Or.inl hw))).symm))
  · rw [← hD]
    exact ((regValue_eq_iff _ _ _).mpr (fun w hw => (h w (by
      simp only [StairCodec.declaredSites, List.mem_append]; exact Or.inl (Or.inr hw))).symm))
  · intro q hq
    rw [← h q (by simp only [StairCodec.declaredSites, List.mem_append]; exact Or.inr hq)]
    exact hW q hq

theorem registerBasis_mem (bits : List Wire) (X : Nat) (q : Wire)
    (hq : q ∈ bits) : ∃ i, ∃ hi : i < bits.length, bits[i] = q ∧
      StairCodec.registerBasis bits X q = X.testBit i := by
  have hi : bits.idxOf q < bits.length := List.idxOf_lt_length_iff.mpr hq
  have hg : bits[bits.idxOf q] = q := by
    simp
  refine ⟨bits.idxOf q, hi, hg, ?_⟩
  unfold StairCodec.registerBasis
  rw [if_pos hi]


end ECDSAAdd.Entrant.StairField2V3Pack

end
end Merge_StairField2V3Pack_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3End_at_StairSideA` -/
section Merge_StairField2V3End_at_StairSideA

/-!
# LT21: the end of a v3 forward segment

At a row start `e = startFor B` (the end of the previous segment) the moved
walk holds the RAW rails `ρ = realRails x p e` on the full words
`S ++ [base 512]` / `D ++ [bSite B]` with the raw letter on
`letterSite (e - 1)`.  `orient e` (LT14's repaired `orientFull`) then yields
LT1's `CodecInput` of the walk at `e` with the sign extension on `bSite B`
(`codecInput_after_orient`), which is exactly the precondition of
`StairField2V3Pack.stored_after_pack`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3End

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack StairField2V3Pack


def EndFacts (B : Nat) : Prop :=
  3 ≤ B ∧ B ≤ 87 ∧
  (letterSite (startFor B - 1) :: (fullS B ++ fullD B)).Nodup ∧
  bSite B ∉ StairCodec.reg (physicalLayout B).S B ∧ bSite B ∉ StairCodec.reg (physicalLayout B).D B ∧
  base 512 ≠ bSite B ∧
  (∀ q ∈ aReg B ++ cleanList B, q ∉ fullS B ∧ q ∉ fullD B ∧ q ≠ letterSite (startFor B - 1))

/-- K6 (replay budget): Boolean form of `EndFacts` (bit masks, `nodupMask`), sound for every `B`. -/
def k6EB (B : Nat) : Bool :=
  Nat.ble 3 B && Nat.ble B 87 &&
  StairLoan.nodupMask (letterSite (startFor B - 1) :: (fullS B ++ fullD B)) 0 &&
  !(StairLoan.maskOf (StairCodec.reg (physicalLayout B).S B)).testBit (bSite B) &&
  !(StairLoan.maskOf (StairCodec.reg (physicalLayout B).D B)).testBit (bSite B) &&
  !decide (base 512 = bSite B) &&
  (aReg B ++ cleanList B).all (fun q => !(StairLoan.maskOf (fullS B)).testBit q &&
    (!(StairLoan.maskOf (fullD B)).testBit q && !decide (q = letterSite (startFor B - 1))))

theorem k6EB_sound (B : Nat) (h : k6EB B = true) : EndFacts B := by
  simp only [k6EB, Bool.and_eq_true, Bool.not_eq_true', List.all_eq_true, StairLoan.testBit_maskOf,
    Nat.ble_eq, decide_eq_false_iff_not] at h
  obtain ⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩ := h
  exact ⟨h1, h2, (StairLoan.nodupMask_sound _ 0 h3).1, h4, h5, h6, h7⟩

theorem endFacts : ∀ B ∈ budgets, EndFacts B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact k6EB_sound _ (by decide +kernel)

theorem orient_eq (B : Nat) (h87 : B ≤ 87) :
    StairV3Primitives.orient (startFor B) =
      StairField2V3Boundary.orientFull (letterSite (startFor B - 1)) (physicalLayout B) B
        (base 512) (bSite B) := by
  have e : 512 - startFor B = B := by unfold startFor; omega
  unfold StairV3Primitives.orient
  rw [e]
  rfl

theorem workSites_eq (B : Nat) (q : Wire) :
    q ∈ StairCodec.workSites (physicalLayout B) B ↔ q ∈ aReg B ++ cleanList B := by
  simp only [StairCodec.workSites, aReg, cleanList, List.mem_append, List.append_assoc]

/-- **Orientation at a row start gives `CodecInput` with the sign extension.** -/
theorem codecInput_after_orient (B : Nat) (hB : B ∈ budgets) (x : Nat)
    (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (y : State)
    (hl : y.basis (letterSite (startFor B - 1)) =
      (StairBridgeDomain.realRails x ECDSAAdd.p (startFor B)).g)
    (ha : signedRegValue (fullS B) y.basis =
      (StairBridgeDomain.realRails x ECDSAAdd.p (startFor B)).a)
    (hb : signedRegValue (fullD B) y.basis =
      (StairBridgeDomain.realRails x ECDSAAdd.p (startFor B)).b)
    (hwork : ∀ q ∈ StairCodec.workSites (physicalLayout B) B, y.basis q = false)
    (m : List Bool) :
    (run (StairV3Primitives.orient (startFor B)) m y).phase = y.phase ∧
    StairCodec.CodecInput (physicalLayout B) B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B))
      (run (StairV3Primitives.orient (startFor B)) m y).basis ∧
    (run (StairV3Primitives.orient (startFor B)) m y).basis (bSite B) =
      (run (StairV3Primitives.orient (startFor B)) m y).basis ((physicalLayout B).D (B - 1)) ∧
    (run (StairV3Primitives.orient (startFor B)) m y).basis (base 512) = false ∧
    ∀ q, q ∉ fullS B → q ∉ fullD B →
      (run (StairV3Primitives.orient (startFor B)) m y).basis q = y.basis q := by
  obtain ⟨h3, h87, hnd, hbS, hbD, h512b, hws⟩ := endFacts B hB
  obtain ⟨hp0, hodd, _⟩ := p_facts
  have hdom := domain_row B hB x hx0 hx
  have hrho := StairBridgeDomain.orient_realRails x ECDSAAdd.p (startFor B) hp0 hodd
  have sb := StairField2V3Boundary.segmentEnd_boundary (physicalLayout B) B
    (letterSite (startFor B - 1)) (base 512) (bSite B) _ _ _ hdom _ hrho hnd y m hl ha hb
  rw [orient_eq B h87]
  set A := StairField2V3Boundary.orientFull (letterSite (startFor B - 1)) (physicalLayout B) B
    (base 512) (bSite B)
  set E := StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B)
  obtain ⟨oph, oS, oD, o512, obS, oframe⟩ := sb
  have split : run (A ++ E) m y = run E (m.drop (measurementCount A)) (run A m y) := by
    rw [run_append, run_take]
  rw [split] at oph oS oD o512 obS oframe
  set mid := run A m y
  obtain ⟨eph, ebS, eout⟩ := StairBridgeSign.signExtend_run ((physicalLayout B).D (B - 1)) (bSite B) mid
    (m.drop (measurementCount A))
  have back : ∀ q, q ≠ bSite B → mid.basis q = (run E (m.drop (measurementCount A)) mid).basis q :=
    fun q hq => (eout q hq).symm
  refine ⟨?_, ⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · rw [← eph]; exact oph
  · rw [← oS]
    exact (regValue_eq_iff _ _ _).mpr (fun w hw => back w (fun e => hbS (e ▸ hw)))
  · rw [← oD]
    exact (regValue_eq_iff _ _ _).mpr (fun w hw => back w (fun e => hbD (e ▸ hw)))
  · intro q hq
    have hq' := (hws q ((workSites_eq B q).mp hq))
    have hqS : q ∉ StairCodec.reg (physicalLayout B).S B := fun h => hq'.1 (by
      simp only [fullS, List.mem_append]; exact Or.inl h)
    have hqD : q ∉ StairCodec.reg (physicalLayout B).D B := fun h => hq'.2.1 (by
      simp only [fullD, List.mem_append]; exact Or.inl h)
    have hq512 : q ≠ base 512 := fun h => hq'.1 (by
      simp only [fullS, List.mem_append, List.mem_singleton]; exact Or.inr h)
    have hqb : q ≠ bSite B := fun h => hq'.2.1 (by
      simp only [fullD, List.mem_append, List.mem_singleton]; exact Or.inr h)
    rw [back q hqb, oframe q hqS hqD hq512 hqb]
    exact hwork q hq
  · have key : (mid.basis (bSite B) ^^ mid.basis ((physicalLayout B).D (B - 1))) = false :=
      ebS.symm.trans obS
    revert key
    generalize mid.basis (bSite B) = a
    generalize mid.basis ((physicalLayout B).D (B - 1)) = b
    intro key
    cases a <;> cases b <;> simp at key ⊢
  · rw [back _ h512b]; exact o512
  · intro q hqS hqD
    have hqS' : q ∉ StairCodec.reg (physicalLayout B).S B := fun h => hqS (by
      simp only [fullS, List.mem_append]; exact Or.inl h)
    have hqD' : q ∉ StairCodec.reg (physicalLayout B).D B := fun h => hqD (by
      simp only [fullD, List.mem_append]; exact Or.inl h)
    have hq512 : q ≠ base 512 := fun h => hqS (by
      simp only [fullS, List.mem_append, List.mem_singleton]; exact Or.inr h)
    have hqb : q ≠ bSite B := fun h => hqD (by
      simp only [fullD, List.mem_append, List.mem_singleton]; exact Or.inr h)
    rw [back q hqb, oframe q hqS' hqD' hq512 hqb]

end ECDSAAdd.Entrant.StairField2V3End

end
end Merge_StairField2V3End_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Walk_at_StairSideA` -/
section Merge_StairField2V3Walk_at_StairSideA

/-!
# LT21: the moved walk of a v3 forward segment

* `walk_stage`: from LT30's `Decoded` checkpoint, the first moved tick and the
  moved middle reach — on the middle's wires — a VIRTUAL state carrying the
  record's `Rolling1588.Integer.Stage (midSegmentMap B) … (startFor B + 1 + n)`
  (LT30 `middle_virtual_provider` + LT14 `movedForward_run_eq_regular` + the
  record's `regularForward_spec`).
* `stage_end_values`: at a row end `e = startFor B'` such a stage puts the RAW
  rails `realRails x p e` on `fullS B'` / `fullD B'` and the raw letter on
  `letterSite (e - 1)` — exactly the premises of
  `StairField2V3End.codecInput_after_orient`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Walk

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3End

theorem p_hyp (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) : StairFirstTickV3.RealHyp x ECDSAAdd.p := by
  obtain ⟨hp0, hodd, hp⟩ := StairField2V3Unpack.p_facts
  exact ⟨hp0, hx0, hodd, hp, by norm_num [ECDSAAdd.p], hx, StairField2V3Unpack.coprime_of_lt x hx0 hx⟩



/-! ## Values at the row end -/

theorem signedRegValue_congr (r : List Wire) (a b : BasisState) (h : ∀ q ∈ r, a q = b q) :
    signedRegValue r a = signedRegValue r b := by
  unfold signedRegValue
  rw [(regValue_eq_iff r a b).mpr h]


/-- Per-row wire facts at the row end `e = startFor B'` for the middle map of row `B`. -/
def EndWireFacts (B B' : Nat) : Prop :=
  (W.compactSkywalkSignPoolA (StairPhysicalPrimitives.midSegmentMap B) (startFor B')).retained =
      fullS B' ∧
  (W.compactSkywalkSignPoolB (StairPhysicalPrimitives.midSegmentMap B) (startFor B')).retained =
      fullD B' ∧
  StairPhysicalPrimitives.midSegmentMap B (skywalkPoolPreviousId (startFor B')) =
      letterSite (startFor B' - 1) ∧
  (∀ q ∈ fullS B' ++ fullD B' ++ [letterSite (startFor B' - 1)],
    q ∈ (W.compactSkywalkTickLayout (StairPhysicalPrimitives.midSegmentMap B) (startFor B')).wires)

/-- K4C (replay budget): list inclusion from one bit mask of the containing list. -/
theorem k4w_sub (l L : List Wire) (h : l.all (fun q => (StairLoan.maskOf L).testBit q) = true) :
    ∀ q ∈ l, q ∈ L := by
  intro q hq
  have t := List.all_eq_true.mp h q hq
  rw [StairLoan.testBit_maskOf] at t
  exact of_decide_eq_true t

theorem endWireFacts : ∀ pr ∈ rowPairs, EndWireFacts pr.1 pr.2 := by
  intro pr hpr
  simp only [rowPairs, List.mem_cons, List.not_mem_nil, or_false] at hpr
  -- K4C (replay budget): the layout membership on the layout's bit mask (one pass).
  rcases hpr with rfl | rfl | rfl | rfl | rfl
  all_goals
    unfold EndWireFacts
    exact ⟨by decide +kernel, by decide +kernel, by decide +kernel,
      k4w_sub _ _ (by decide +kernel)⟩

theorem pair_mem (B B' : Nat) (h : (B, B') ∈ rowPairs) : B ∈ budgets ∧ B' ∈ budgets ∧
    startFor B' < 512 := by
  simp only [rowPairs, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at h
  rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> decide

/-- **The record stage at a row end gives the raw rails and letter.** -/
theorem stage_end_values (B B' : Nat) (hpair : (B, B') ∈ rowPairs) (x : Nat) (z : State)
    (hz : Rolling1588.Integer.Stage (StairPhysicalPrimitives.midSegmentMap B) true x ECDSAAdd.p
      (startFor B') z.basis) :
    z.basis (letterSite (startFor B' - 1)) = (StairBridgeDomain.realRails x ECDSAAdd.p (startFor B')).g ∧
    signedRegValue (fullS B') z.basis = (StairBridgeDomain.realRails x ECDSAAdd.p (startFor B')).a ∧
    signedRegValue (fullD B') z.basis = (StairBridgeDomain.realRails x ECDSAAdd.p (startFor B')).b := by
  obtain ⟨hB, hB', he⟩ := pair_mem B B' hpair
  obtain ⟨hA, hBw, hprev, hlay⟩ := endWireFacts (B, B') hpair
  have hnod := StairPhysicalPrimitives.midSegmentMap_pool_nodup B hB
  obtain ⟨raw, cs, hbits⟩ := hz
  have F := (W.compactSkywalkStage_fields_iff (StairPhysicalPrimitives.midSegmentMap B)
    (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)) (startFor B') (by omega) hnod
    raw.basis).mp cs
  obtain ⟨fa, fb, fg, _⟩ := F
  have dis := Rolling1588.Integer.prefix_disjoint_layout (StairPhysicalPrimitives.midSegmentMap B) true
    hnod (startFor B') (startFor B') le_rfl he
  have same : ∀ q ∈ fullS B' ++ fullD B' ++ [letterSite (startFor B' - 1)],
      z.basis q = raw.basis q := by
    intro q hq
    rw [hbits]
    exact run_preserves_outside _ _ _ q (fun h => Finset.disjoint_left.mp dis h
      (List.mem_toFinset.mpr (hlay q hq)))
  refine ⟨?_, ?_, ?_⟩
  · rw [same _ (by simp), ← hprev]
    exact fg
  · rw [signedRegValue_congr _ _ _ (fun q hq => same q (by simp [hq])), ← hA]
    exact fa
  · rw [signedRegValue_congr _ _ _ (fun q hq => same q (by simp [hq])), ← hBw]
    exact fb

end ECDSAAdd.Entrant.StairField2V3Walk

end
end Merge_StairField2V3Walk_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Decode_at_StairSideA` -/
section Merge_StairField2V3Decode_at_StairSideA

/-!
# LT21: the decoded checkpoint after `unpack B`

On a tail state holding the stored checkpoint `cmpBits B x` on the row's
future payload, clean on the row's scratch, and clean on the shadow labels
(`≥ base 4000`, never touched by any v3 primitive), the full `unpack B`
(unrelocation, codec unpack, sign copy) produces LT30's `Decoded` checkpoint
(`decoded_after_unpack`).  The zero sites are collected in `ZList B`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Decode

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack StairField2V3Pack





def pw (B : Nat) : Nat := W.compactSkywalkTickPreWidth (startFor B)

def ZFacts (B : Nat) : Prop :=
  bSite B ∉ moveSites (unrelocPairs B) ∧
  bSite B ∉ StairCodec.reg (physicalLayout B).S B ∧ bSite B ∉ StairCodec.reg (physicalLayout B).D B ∧
  bSite B ∉ aReg B ∧ bSite B ∉ cleanList B ∧
  ((bSite B ∈ rowSites B ∧ bSite B ∉ futurePayload B) ∨
    (bSite B ∈ futurePayload B ∧ bSite B ∉ restLetters B ∧ bSite B ∉ aReg B)) ∧
  base 512 ∈ ZList B ∧ zeroWire ∈ ZList B ∧
  (∀ q ∈ unpackSites B, q < base 4000)

def ZFactsA (B : Nat) : Prop :=
  ∀ j ∈ List.range' (startFor B + pw B) (770 - (startFor B + pw B)),
    base 4000 ≤ segmentMap B j ∨ segmentMap B j ∈ ZList B

def ZFactsB (B : Nat) : Prop :=
  ∀ j ∈ List.range' (770 + pw B) (1028 - (770 + pw B)),
    base 4000 ≤ segmentMap B j ∨ segmentMap B j ∈ ZList B

def ZFactsS (B : Nat) : Prop :=
  ∀ j ∈ List.range' (startFor B) (512 - startFor B),
    base 4000 ≤ segmentMap B (1028 + j) ∨ segmentMap B (1028 + j) ∈ ZList B

def ZFactsC (B : Nat) : Prop :=
  ∀ j ∈ List.range' 1540 257, base 4000 ≤ segmentMap B j ∨ segmentMap B j ∈ ZList B

/-! ## LT49 (replay budget): `ZList B` as a bit-mask literal

`ZList B` is a quadratic filter (`futurePayload` / `unpackSites` membership per site); the
kernel re-evaluated it for every fact.  Its bit mask is checked once per budget
(`zlMask_eq`) and membership becomes a `Nat.testBit` on a literal (`mem_zl`). -/







theorem zFacts : ∀ B ∈ budgets, ZFacts B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals unfold ZFacts; simp only [mem_zl]; decide +kernel

/-! ## K4C (replay budget): the `ZFacts*` range checks on their non-trivial parts only

Above label `513` (below `770`), between `858` and `1027`, and from `1627` on, `segMap` is the
shadow branch `base (4000 + q)`, so `base 4000 ≤ segmentMap B j` holds symbolically
(`k4d_hi`); the kernel only checks the remaining ids. -/

theorem k4d_hi (l e j : Nat) (hl : l ≤ 513) (he : e ≤ 599)
    (h : (514 ≤ j ∧ j < 770) ∨ (858 ≤ j ∧ j < 1028) ∨ 1627 ≤ j) :
    base 4000 ≤ segMap l e j := by
  unfold segMap
  split_ifs
  all_goals first
    | (exfalso; omega)
    | exact Nat.add_le_add_right (Nat.le_add_right 4000 j) 16

theorem k4d_bounds : ∀ B ∈ budgets, startFor B ≤ 513 ∧ endFor B ≤ 599 := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> decide

theorem k4d_hiB (B : Nat) (hB : B ∈ budgets) (j : Nat)
    (h : (514 ≤ j ∧ j < 770) ∨ (858 ≤ j ∧ j < 1028) ∨ 1627 ≤ j) :
    base 4000 ≤ segmentMap B j :=
  k4d_hi _ _ j (k4d_bounds B hB).1 (k4d_bounds B hB).2 h

theorem k4dA : ∀ B ∈ budgets,
    ∀ j ∈ List.range' (startFor B + pw B) (514 - (startFor B + pw B)),
      base 4000 ≤ segmentMap B j ∨ (zlMask B).testBit (segmentMap B j) = true := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem k4dB : ∀ B ∈ budgets,
    ∀ j ∈ List.range' (770 + pw B) (858 - (770 + pw B)),
      base 4000 ≤ segmentMap B j ∨ (zlMask B).testBit (segmentMap B j) = true := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem k4dC : ∀ B ∈ budgets,
    ∀ j ∈ List.range' 1540 87,
      base 4000 ≤ segmentMap B j ∨ (zlMask B).testBit (segmentMap B j) = true := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem zFactsA : ∀ B ∈ budgets, ZFactsA B := by
  intro B hB
  unfold ZFactsA
  intro j hj
  rw [List.mem_range'_1] at hj
  by_cases h : 514 ≤ j
  · exact Or.inl (k4d_hiB B hB j (Or.inl ⟨h, by omega⟩))
  · rw [mem_zl]
    exact k4dA B hB j (List.mem_range'_1.mpr ⟨hj.1, by omega⟩)

theorem zFactsB : ∀ B ∈ budgets, ZFactsB B := by
  intro B hB
  unfold ZFactsB
  intro j hj
  rw [List.mem_range'_1] at hj
  by_cases h : 858 ≤ j
  · exact Or.inl (k4d_hiB B hB j (Or.inr (Or.inl ⟨h, by omega⟩)))
  · rw [mem_zl]
    exact k4dB B hB j (List.mem_range'_1.mpr ⟨hj.1, by omega⟩)

theorem zFactsS : ∀ B ∈ budgets, ZFactsS B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals unfold ZFactsS; simp only [mem_zl]; decide +kernel

theorem zFactsC : ∀ B ∈ budgets, ZFactsC B := by
  intro B hB
  unfold ZFactsC
  intro j hj
  rw [List.mem_range'_1] at hj
  by_cases h : 1627 ≤ j
  · exact Or.inl (k4d_hiB B hB j (Or.inr (Or.inr h)))
  · rw [mem_zl]
    exact k4dC B hB j (List.mem_range'_1.mpr ⟨hj.1, by omega⟩)

/-! ## The decoded checkpoint -/

theorem unpack_split (B : Nat) : StairPhysicalPrimitives.unpack B =
    (unrelocate B ++ StairCodec.unpack (physicalLayout B) B) ++
