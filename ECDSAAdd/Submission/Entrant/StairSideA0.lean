/-- `Cv B` with the input fixed to `x`. -/
def CvX (x B : Nat) (a b : BasisState) : Prop :=
  ∃ origin, TraceOK x origin ∧
    ∀ r ∈ futurePayload B, b (fieldPlace r) = recVal origin r ∧ a (fieldPlace r) = cmpBits B x r


theorem mem_Δv (B : Nat) (r : Wire) (hr : r ∈ futurePayload B) : fieldPlace r ∈ Δv B := by
  simp only [Δv, List.mem_toFinset, List.mem_map]
  exact ⟨r, hr, rfl⟩



theorem cvX_local (x B : Nat) : DeltaLocal (Δv B) (CvX x B) := by
  intro a b a' b' ha hb h
  obtain ⟨origin, hx, hv⟩ := h
  refine ⟨origin, hx, ?_⟩
  intro r hr
  obtain ⟨h1, h2⟩ := hv r hr
  exact ⟨(hb _ (mem_Δv B r hr)).symm.trans h1, (ha _ (mem_Δv B r hr)).symm.trans h2⟩

def RelX (x B : Nat) : State → State → Prop := Rel (Δv B) (CvX x B)





