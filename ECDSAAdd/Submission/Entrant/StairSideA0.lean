/-! ## The caller domain -/




theorem caller_index (q : Wire) (hq : q ∈ callerDomain) :
    ∃ i, (i < 2314 ∨ i = 2400 ∨ i = 2409 ∨ i = 2410 ∨ i = 2411) ∧ q = base i := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  refine ⟨i, ?_, rfl⟩
  simp only [callerIndices, List.mem_append, List.mem_range'_1, List.mem_cons,
    List.not_mem_nil, or_false] at hi
  omega

theorem logical_sub_caller : OB5Support.logicalSites ⊆ callerDomain := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  simp only [OB5Support.logicalIndices, List.mem_append, List.mem_range'_1, List.mem_cons,
    List.not_mem_nil, or_false] at hi
  exact base_mem_caller i (by omega)

theorem divisor_caller : (wireBlock base 770 256).toFinset ⊆ callerDomain := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  simp only [List.mem_range'_1] at hi
  exact base_mem_caller i (by omega)

theorem numerator_caller : (wireBlock base 2056 256).toFinset ⊆ callerDomain := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  simp only [List.mem_range'_1] at hi
  exact base_mem_caller i (by omega)

theorem generic_caller : base 2400 ∈ callerDomain := base_mem_caller 2400 (by omega)

/-! ## Injectivity of the record placement on the placed point inventory -/

/-- The record's placed point inventory (LT7's `StairPlacedDomain.placedDomain`). -/
def placedDomain : Finset Wire := (MappedCompressed.pointIndexSites.map base).toFinset

private theorem nodup_map_injD (f : Nat → Wire) (xs : List Nat)
    (nd : (xs.map f).Nodup) (a b : Nat) (ha : a ∈ xs) (hb : b ∈ xs)
    (eq : f a = f b) : a = b := by
  induction xs generalizing a b with
  | nil => simp at ha
  | cons c cs ih =>
    have head := List.nodup_cons.mp nd
    rcases List.mem_cons.mp ha with atHead | inTailA
    · rcases List.mem_cons.mp hb with btHead | inTailB
      · exact atHead.trans btHead.symm
      · have inMap : f b ∈ cs.map f := List.mem_map.mpr ⟨b, inTailB, rfl⟩
        have headEq : f c = f b := (congrArg f atHead).symm.trans eq
        exact (head.1 (headEq.symm ▸ inMap)).elim
    · rcases List.mem_cons.mp hb with btHead | inTailB
      · have inMap : f a ∈ cs.map f := List.mem_map.mpr ⟨a, inTailA, rfl⟩
        have headEq : f a = f c := eq.trans (congrArg f btHead)
        exact (head.1 (headEq ▸ inMap)).elim
      · exact ih head.2 a b inTailA inTailB eq

private theorem swap2_placed (a : Wire) (ha : a ∈ placedDomain) :
    ∃ j, j ∈ MappedCompressed.pointIndexSites ∧ swap2 a = base j := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp ha)
  have m1797 : (1797 : Nat) ∈ MappedCompressed.pointIndexSites :=
    List.mem_append.mpr (Or.inl (List.mem_range'_1.mpr ⟨by norm_num, by norm_num⟩))
  have m769 : (769 : Nat) ∈ MappedCompressed.pointIndexSites :=
    List.mem_append.mpr (Or.inl (List.mem_range'_1.mpr ⟨by norm_num, by norm_num⟩))
  unfold swap2
  split_ifs
  · exact ⟨1797, m1797, rfl⟩
  · exact ⟨769, m769, rfl⟩
  · exact ⟨i, hi, rfl⟩

/-- `wireFn2 L` is injective on the placed point inventory (LT7's argument). -/
theorem placed_injOn (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    ∀ a ∈ placedDomain, ∀ b ∈ placedDomain, wireFn2 L a = wireFn2 L b → a = b := by
  have nd := (MappedCompressed.pointIndexSites_perm L hw).nodup_iff.mpr
    (L.skywalkDirectDeclaredSites_nodup hn)
  intro a ha b hb eq
  obtain ⟨i, hi, hai⟩ := swap2_placed a ha
  obtain ⟨j, hj, hbj⟩ := swap2_placed b hb
  have e : MappedCompressed.pointIndexWire L i =
      MappedCompressed.pointIndexWire L j := by
    have h := eq
    simp only [wireFn2, hai, hbj, MappedCompressed.pointWireFn_base] at h
    exact h
  have ij : i = j :=
    nodup_map_injD (MappedCompressed.pointIndexWire L) _ nd i j hi hj e
  have sw : swap2 a = swap2 b := by rw [hai, hbj, ij]
  calc a = swap2 (swap2 a) := (swap2_involutive a).symm
    _ = swap2 (swap2 b) := by rw [sw]
    _ = b := swap2_involutive b

theorem caller_sub_placed : callerDomain ⊆ placedDomain := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := caller_index q hq
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨i, ?_, rfl⟩
  simp only [MappedCompressed.pointIndexSites, List.mem_append, List.mem_range'_1]
  omega

theorem wireFn2_injOn_caller (L : ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) :
    ∀ a ∈ callerDomain, ∀ b ∈ callerDomain, wireFn2 L a = wireFn2 L b → a = b :=
  fun a ha b hb eq => placed_injOn L hw hn a (caller_sub_placed ha) b (caller_sub_placed hb) eq

/-! ## Shared work and the control wire -/

/-- Every shared work label of the caller domain is placed in the clean dialog
pool. -/
theorem sharedWork_caller (L : ControlledPointLayout) (hw : L.Widths) :
    ∀ q ∈ skywalkSharedWires base, q ∈ callerDomain →
      q ∉ wireBlock base 770 256 → q ∉ wireBlock base 2056 256 →
      wireFn2 L q ∈ L.dialogPool := by
  intro q hq _ hx hy
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
  simp only [List.mem_range'_1] at hi
  have outsideX : i < 770 ∨ 1026 ≤ i := by
    by_contra bad
    exact hx (List.mem_map.mpr ⟨i, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩)
  have outsideY : i < 2056 ∨ 2312 ≤ i := by
    by_contra bad
    exact hy (List.mem_map.mpr ⟨i, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩)
  simp only [wireFn2]
  by_cases h1 : i = 769
  · subst h1
    rw [show swap2 (base 769) = base 1797 by simp [swap2], pointWireFn_base]
    exact pointIndexWire_work_mem L hw 1797 (by omega) (by omega) (by omega)
  · by_cases h2 : i = 1797
    · subst h2
      rw [show swap2 (base 1797) = base 769 by simp only [swap2, base]; simp,
        pointWireFn_base]
      exact pointIndexWire_work_mem L hw 769 (by omega) (by omega) (by omega)
    · rw [swap2_fix (base i)
        (fun e => h1 (by have e' : i + 16 = 769 + 16 := e; omega))
        (fun e => h2 (by have e' : i + 16 = 1797 + 16 := e; omega)),
        pointWireFn_base]
      exact pointIndexWire_work_mem L hw i hi.2 outsideX outsideY

/-- No caller-domain label is placed on the caller's `control` wire. -/
theorem control_not_caller_image (L : ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) :
    ∀ q ∈ callerDomain, wireFn2 L q ≠ L.control := by
  intro q hq eq
  have c2402 : wireFn2 L (base 2402) = L.control := by
    simp only [wireFn2]
    rw [swap2_fix (base 2402) (by decide) (by decide), pointWireFn_base]
    exact (pointIndexWire_metadata L).2.2.1
  have m2402 : base 2402 ∈ placedDomain := by
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨2402, ?_, rfl⟩
    simp only [MappedCompressed.pointIndexSites, List.mem_append, List.mem_range'_1]
    omega
  have same : q = base 2402 :=
    placed_injOn L hw hn q (caller_sub_placed hq) _ m2402 (eq.trans c2402.symm)
  obtain ⟨i, hi, rfl⟩ := caller_index q hq
  have e : i + 16 = 2402 + 16 := same
  omega

