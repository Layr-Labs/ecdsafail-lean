  simp only [wires_append, Finset.mem_union, not_or]
  refine ⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, ?_⟩
  · exact CompareDecoder.BoundaryLoan.not_mem_wires_of_all _ q
