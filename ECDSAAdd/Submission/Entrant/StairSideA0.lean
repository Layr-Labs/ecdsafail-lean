theorem subTop_support (h r cs : List Wire) (cin z u v k : Wire) (hl : (h++[z]).length=(r++[u]).length)
    (hc : cs.length+1=(r++[u]).length) :
    wires (KnownTopAdd.subTop h r cs cin z u v k)⊆(k::cin::(h++[z]++(r++[u])++cs++[v])).toFinset := by
