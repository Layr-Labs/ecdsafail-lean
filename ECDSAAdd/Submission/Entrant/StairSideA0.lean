/-! K4-B (replay budget): the moved ticks and packets of a row only read pool ids in four
intervals (letters, b-rail, histories, carries); the row map sends each of them to a row site
(`kbSeg_row`, structural), so no tick or packet is evaluated. -/





























/-! K4-B (replay budget): `relocate` / `unrelocate` only move rail bits `D i ↔ S i`, `i < B`,
which are declared row sites; proved structurally instead of by evaluation. -/









/-! ## Every primitive wire is a row site -/






















/-- Site list of LT14's `orientFull (letterSite (startFor B - 1)) (physicalLayout B) B
(base 512) (bSite B)` (its `orientFull_support`): all row sites. -/
theorem orientFullSites_rows : ∀ B ∈ budgets,
    ∀ q ∈ letterSite (startFor B - 1) ::
      ((StairCodec.reg (physicalLayout B).S B ++ [base 512]) ++
        (StairCodec.reg (physicalLayout B).D B ++ [bSite B])),
      q ∈ rowSitesL B := by
  -- K4-B (replay budget): structural (all listed sites are rail or explicit row sites)
  intro B _ q hq
  unfold rowSitesL
  rcases List.mem_cons.mp hq with h | h
  · exact List.mem_cons.mpr (Or.inl h)
  · apply List.mem_cons_of_mem
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with (h | h) | (h | h)
    · simp only [rowSites, StairCodec.declaredSites, List.mem_append, h, true_or]
    · subst h
      simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]
    · simp only [rowSites, StairCodec.declaredSites, List.mem_append, h, true_or, or_true]
    · subst h
      simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]

/-- One exported fact for composition with any support lemma: every row site is
physical, avoids all 59 omissions, and has its kernel label in the caller
domain. -/
theorem rowSitesL_sound : ∀ B ∈ budgets, ∀ q ∈ rowSitesL B,
    (place q ∈ StairHoleSupport.recordArena ∧
      place q ∉ StairHoleSupport.oldHoles ∧ place q ∉ physicalHoles) ∧
    fieldPlace q ∈ callerList := by
  intro B hB q hq
  refine ⟨?_, rowSitesL_caller B hB q hq⟩
  have good := rowSitesL_good B hB q hq
  rw [recordArena_eq, oldHoles_eq, physicalHoles_eq_nat]
  exact good

