/-- Every wire written by the record's packet prefix through tick `l` is virtual. -/
theorem encodePrefix_virtual (wm : Nat → Wire) (isA : Bool) (l : Nat) :
    ∀ n, n ≤ l + 1 →
      ∀ q ∈ wires (Rolling1588.Integer.encodePrefix wm isA n), VWire wm l q := by
  intro n
  induction n with
  | zero =>
      intro _ q hq
      simp [Rolling1588.Integer.encodePrefix, wires] at hq
  | succ n ih =>
      intro hn q hq
      simp only [Rolling1588.Integer.encodePrefix, wires_append, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact ih (by omega) q hq
      · rw [Rolling1588.Integer.pack_support_eq] at hq
        unfold History5.packAfter at hq
        split at hq
        · rename_i due
          obtain ⟨k, rfl⟩ := StairPhysicalPrimitives.encode_wires wm (n - 5) q hq
          have hd : 5 ≤ n := by
            simp only [History5.packDue, decide_eq_true_eq] at due
            exact due.1
          refine ⟨History5.historyId (n - 5) k, ?_, rfl⟩
          have hk := k.isLt
          unfold Virt History5.historyId
          split_ifs <;> omega
        · simp [wires] at hq

/-- **Naturality, generic in the row.**  A physical state with the local
re-rooted stage at `l + 1` (rails oriented at `l`) agrees, outside the virtual
sites, with a state satisfying the record's `Integer.Stage` on `wm`. -/
theorem virtual_generic (w wm : Nat → Wire) (l : Nat) (hl : l + 1 < 512)
    (hinj : Function.Injective wm) (hagree : ∀ id, l ≤ id → wm id = w id)
    (isA : Bool) (x p : Nat)
    (hodd : ((StairBridgeDomain.realRails x p l).a +
      (StairBridgeDomain.realRails x p l).b) % 2 = 1)
    (t : State)
    (ht : StairSegment.Stage w l
      (StairBridgeDomain.orientRails (StairBridgeDomain.realRails x p l)) (l + 1) t.basis) :
    ∃ t' : State, t.phase = t'.phase ∧
      (∀ q, ¬ VWire wm l q → t.basis q = t'.basis q) ∧
      Rolling1588.Integer.Stage wm isA x p (l + 1) t'.basis := by
  let r0 := SkywalkRails.encode false false (x : Int) (p : Int)
  let raw : State := ⟨t.phase, rawBasis wm l r0 t.basis⟩
  have hraw : W.CompactSkywalkStage wm r0 (l + 1) raw.basis :=
    raw_stage w wm l hl hinj hagree r0 hodd t ht
  refine ⟨⟨t.phase, (run (Rolling1588.Integer.encodePrefix wm isA (l + 1)) [] raw).basis⟩,
    rfl, ?_, ?_⟩
  swap
  · unfold Rolling1588.Integer.Stage
    exact ⟨raw, hraw, rfl⟩
  intro q hq
  show t.basis q = (run (Rolling1588.Integer.encodePrefix wm isA (l + 1)) [] raw).basis q
  rw [run_preserves_outside _ [] raw q
    (fun h => hq (encodePrefix_virtual wm isA l (l + 1) le_rfl q h))]
  exact (rawBasis_not wm l r0 t.basis q hq).symm

/-! ## Moved middle programs avoid the virtual sites -/

theorem layout_clean (wm : Nat → Wire) (hinj : Function.Injective wm) (l j : Nat)
    (hj : l + 1 ≤ j) (hj2 : j < 512) (q : Wire)
    (hq : q ∈ (W.compactSkywalkTickLayout wm j).wires) : ¬ VWire wm l q := by
  have wb := W.compactSkywalkTick_width_bounds j hj2
  have hah := W.compactSkywalkTick_ah wm j hj2
  have hbh := W.compactSkywalkTick_bh wm j hj2
  unfold SkywalkIntegerLayout.wires at hq
  rw [hah, hbh] at hq
  simp only [List.mem_cons, List.mem_append] at hq
  rcases hq with h | h | h | h | h | (h | h) | h
  · rw [h]
    exact not_vwire wm hinj l (skywalkPoolPreviousId j) (by
      unfold Virt skywalkPoolPreviousId
      split_ifs <;> omega)
  · rw [h]
    exact not_vwire wm hinj l (1028 + j) (by unfold Virt; omega)
  · rw [h]
    exact not_vwire wm hinj l (j + W.compactSkywalkTickPreWidth j) (by unfold Virt; omega)
  · rw [h]
    exact not_vwire wm hinj l j (by unfold Virt; omega)
  · rw [h]
    exact not_vwire wm hinj l 770 (by unfold Virt; omega)
  · exact block_clean wm hinj l _ _ (by intro id h1 h2; unfold Virt; omega) q h
  · exact block_clean wm hinj l _ _ (by intro id h1 h2; unfold Virt; omega) q h
  · have h' : q ∈ wireBlock wm 1540 (W.compactSkywalkTickPreWidth j - 1) := h
    exact block_clean wm hinj l _ _ (by intro id h1 h2; unfold Virt; omega) q h'

theorem packet_clean (wm : Nat → Wire) (hinj : Function.Injective wm) (l j : Nat)
    (hl5 : l % 5 = 0) (hj : l + 1 ≤ j) (hj2 : j < 512)
    (due : History5.packDue j = true) (k : Fin 10) :
    ¬ VWire wm l (History5.historyMap wm (j - 5) k) := by
  have hd : 5 ≤ j ∧ j % 5 = 0 := by
    simp only [History5.packDue, decide_eq_true_eq] at due
    exact due
  have hk := k.isLt
  apply not_vwire wm hinj l
  unfold Virt History5.historyId
  split_ifs <;> omega



/-! ## The six rows -/

theorem midSegmentMap_injective (B : Nat) (hB : B ∈ budgets) :
    Function.Injective (StairPhysicalPrimitives.midSegmentMap B) := by
  obtain ⟨h0, h1, _, _, h2, _⟩ := budget_range B hB
  exact StairPhysicalPrimitives.segMid_injective _ _ h0 h1 h2

theorem midSegmentMap_agree (B : Nat) (hB : B ∈ budgets) :
    ∀ id, startFor B ≤ id → StairPhysicalPrimitives.midSegmentMap B id = segmentMap B id := by
  intro id hid
  exact StairPhysicalPrimitives.midSegmentMap_eq B hB id (by omega)

/-- Virtual sites of row `B`. -/
def virtualSites (B : Nat) (q : Wire) : Prop :=
  VWire (StairPhysicalPrimitives.midSegmentMap B) (startFor B) q

/-- **Naturality at a row.**  After the first moved tick (local stage at
`s + 1`), the physical state agrees outside `virtualSites B` with a virtual
state carrying the record's `Integer.Stage (midSegmentMap B) … (s + 1)`. -/
theorem virtual_stage (B : Nat) (hB : B ∈ budgets) (x p : Nat) (h : RealHyp x p)
    (isA : Bool) (t : State)
    (ht : StairSegment.Stage (segmentMap B) (startFor B)
      (StairBridgeDomain.orientRails (StairBridgeDomain.realRails x p (startFor B)))
      (startFor B + 1) t.basis) :
    ∃ t' : State, t.phase = t'.phase ∧
      (∀ q, ¬ virtualSites B q → t.basis q = t'.basis q) ∧
      Rolling1588.Integer.Stage (StairPhysicalPrimitives.midSegmentMap B) isA x p
        (startFor B + 1) t'.basis := by
  obtain ⟨h0, h1, _, _, _, _⟩ := budget_range B hB
  exact virtual_generic (segmentMap B) (StairPhysicalPrimitives.midSegmentMap B) (startFor B)
    (by omega) (midSegmentMap_injective B hB) (midSegmentMap_agree B hB) isA x p
    (realRails_odd x p _ h.p0 h.odd) t ht




