          | cons b' bs =>
              cases as with
              | nil => simp at habTail
              | cons a' as =>
                  cases cs with
                  | nil => simp at hc
                  | cons c cs =>
                      have child := ih (a' :: as) cs c (by simpa using habTail)
                        (by simpa using hc) (by simp)
                      simp only [Q6LifetimeResearch.compareChain,
                        List.cons_append, child]

private theorem lift_compareChain_tail_post (n : Nat) (as bs cs : List Wire)
    (cin last target : Wire) (s : State) (m : List Bool)
    (hab : as.length = bs.length) (hc : cs.length + 1 = as.length)
    (hn : n ≤ cs.length)
    (nd : (target :: cin :: (as ++ bs ++ (cs ++ [last]))).Nodup)
    (clean : ∀ q ∈ cs ++ [last], s.basis q = false)
    (post : (run (Arithmetic.compareChain none as bs (cs ++ [last]) cin target)
      m s).basis target = false) :
    let u := run (carryPrefix n (mappedRead as false) bs cs cin) [] s
    (run (Arithmetic.compareChain none (as.drop n) (bs.drop n)
      (cs.drop n ++ [last]) (carryAfter n cs cin) target) [] u).basis target =
        false := by
  induction n generalizing as bs cs cin s m with
  | zero =>
      simp only [carryPrefix, List.drop_zero, carryAfter]
      have control : ∀ c ∈ (none : Option Wire),
          c ∉ target :: cin :: (as ++ bs ++ (cs ++ [last])) := by simp
      have carryLen : (cs ++ [last]).length = bs.length := by
        simp only [List.length_append, List.length_singleton]
        omega
      have first := compareChain_correct none as bs (cs ++ [last]) cin target
        nd control hab carryLen s m clean
      have second := compareChain_correct none as bs (cs ++ [last]) cin target
        nd control hab carryLen s [] clean
      exact second.2.2.trans (first.2.2.symm.trans post)
  | succ n ih =>
      cases as with
      | nil => simp at hc
      | cons a as =>
          cases bs with
          | nil => simp at hab
          | cons b bs =>
              cases cs with
              | nil => simp at hn
              | cons c cs =>
                  have habTail : as.length = bs.length := by simpa using hab
                  have hcTail : cs.length + 1 = as.length := by simpa using hc
                  have hnTail : n ≤ cs.length := by simpa using hn
                  have four : [a, b, cin, c].Nodup := by
                    apply List.nodup_iff_count.mpr
                    intro q
                    have h := List.nodup_iff_count.mp nd q
                    simp only [List.count_cons, List.count_append,
                      List.count_nil] at h ⊢
                    omega
                  have tailND :
                      (target :: c :: (as ++ bs ++ (cs ++ [last]))).Nodup := by
                    apply List.nodup_iff_count.mpr
                    intro q
                    have h := List.nodup_iff_count.mp nd q
                    simp only [List.count_cons, List.count_append,
                      List.count_nil] at h ⊢
                    omega
                  let u : State := ⟨s.phase, writeBit s.basis c
                    (carryBit (s.basis a) (s.basis b) (s.basis cin))⟩
                  have head (records : List Bool) :
                      run (majority a b cin c) records s = u := by
                    rw [majority_correct a b cin c four]
                    have zero := clean c (by simp)
                    simp only [zero, Bool.false_xor]
                    rfl
                  have cAway : c ∉ cs ++ [last] := by
                    intro bad
                    have h := List.nodup_iff_count.mp nd c
                    have hp := List.count_pos_iff.mpr bad
                    simp only [List.count_cons, List.count_append, List.count_nil,
                      beq_self_eq_true, if_true] at h hp
                    omega
                  have cleanU : ∀ q ∈ cs ++ [last], u.basis q = false := by
                    intro q hq
                    have ne : q ≠ c := by
                      intro e
                      apply cAway
                      simpa [e] using hq
                    simp only [u, writeBit, Function.update_of_ne ne]
                    exact clean q (by simp [hq])
                  have targetAway : target ∉ wires (eraseCarry a b cin c) := by
                    rw [eraseCarry_wires]
                    simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
                    have h := (List.nodup_cons.mp nd).1
                    refine ⟨?_, ?_, ?_, ?_⟩ <;> intro e <;> apply h <;> simp [e]
                  have tailPost :
                      (run (Arithmetic.compareChain none as bs (cs ++ [last])
                        c target) m u).basis target = false := by
                    have chainShape :
                        Arithmetic.compareChain none (a :: as) (b :: bs)
                          (c :: (cs ++ [last])) cin target =
                        majority a b cin c ++
                          Arithmetic.compareChain none as bs (cs ++ [last])
                            c target ++ eraseCarry a b cin c := by rfl
                    have whole :
                        run (Arithmetic.compareChain none (a :: as) (b :: bs)
                          (c :: (cs ++ [last])) cin target) m s =
                        run (eraseCarry a b cin c)
                          (m.drop (measurementCount
                            (majority a b cin c ++
                              Arithmetic.compareChain none as bs
                                (cs ++ [last]) c target)))
                          (run (Arithmetic.compareChain none as bs
                            (cs ++ [last]) c target) m u) := by
                      rw [chainShape, run_append, run_take, run_append, run_take]
                      simp only [show measurementCount (majority a b cin c) = 0
                        from rfl, List.drop_zero, head]
                    have keep := run_preserves_outside (eraseCarry a b cin c)
                      (m.drop (measurementCount (majority a b cin c ++
                        Arithmetic.compareChain none as bs (cs ++ [last])
                          c target)))
                      (run (Arithmetic.compareChain none as bs (cs ++ [last])
                        c target) m u) target targetAway
                    have fullPost :
                        (run (Arithmetic.compareChain none (a :: as) (b :: bs)
                          (c :: (cs ++ [last])) cin target) m s).basis target =
                            false := by
                      simpa only [List.cons_append] using post
                    rw [whole, keep] at fullPost
                    exact fullPost
                  have tail := ih as bs cs c u m habTail hcTail hnTail tailND
                    cleanU tailPost
                  have headMapped : run (mappedMajority
                      ({wire := some a, flip := false} : MappedBit) b cin c)
                      [] s = u := by
                    simpa [mappedMajority] using head []
                  have prefixStep :
                      run (carryPrefix (n + 1) (mappedRead (a :: as) false)
                        (b :: bs) (c :: cs) cin) [] s =
                      run (carryPrefix n (mappedRead as false) bs cs c) [] u := by
                    change run (mappedMajority
                      ({wire := some a, flip := false} : MappedBit) b cin c ++
                      carryPrefix n (mappedRead as false) bs cs c) [] s =
                      run (carryPrefix n (mappedRead as false) bs cs c) [] u
                    simp only [run_append,
                      show measurementCount (mappedMajority
                        ({wire := some a, flip := false} : MappedBit) b cin c) = 0
                        from (mappedBit_counts
                          ({wire := some a, flip := false} : MappedBit)
                            b cin c).2.1,
                      List.take_zero, List.drop_zero, headMapped]
                  simp only [List.drop_succ_cons, carryAfter]
                  rw [prefixStep]
                  exact tail

