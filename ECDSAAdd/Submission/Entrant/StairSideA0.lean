/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3CleanGroups_at_StairSideA` -/
section Merge_StairField13V3CleanGroups_at_StairSideA

/-!
# Field 13 on v3: every logical packet group keeps the 44 roles zero (LT29)

For a role `w` (exclusive site, raw window `[736, 781)`) and every group used
by the two logical kernels, `zt w true (group) = true`: roles below the
deficit are outside the loaned half (field 5, `wholeHalfSupport`), the others
are reset by the half's own measurements (kernel checks `chk_half_*`); every
other packet component keeps them (`chk_keep_*`), and all renamings fix them.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed
open StairField13V3

/-! ## Keeping and resetting -/


/-- `P` resets `w` to zero. -/
def Resets (w : Wire) (P : Program) : Prop := zt w false P = true

theorem Resets.keeps {w : Wire} {P : Program} (h : Resets w P) : Keeps w P :=
  zt_mono w P true h








theorem pre_swap (a b w : Wire) (ha : a ≠ w) (hb : b ≠ w) :
    ∀ q, Equiv.swap a b q = w ↔ q = w :=
  pre_of_inj _ (Equiv.injective _) w (Equiv.swap_apply_of_ne_of_ne (Ne.symm ha) (Ne.symm hb))


theorem resets_rename (f : Wire → Wire) {w : Wire} (hf : ∀ q, f q = w ↔ q = w) {P : Program}
