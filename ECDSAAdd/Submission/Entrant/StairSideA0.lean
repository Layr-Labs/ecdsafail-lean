  have basis(q:Wire):z.basis q=
      if q∈BalancedCircuit.rawTarget L then
        !(if q∈L.y then s.basis q ^^ s.basis L.sign else s.basis q)
      else if q∈L.y then s.basis q ^^ s.basis L.sign else s.basis q:=by
    rw [show z=run N [] (run S [] s) from rfl,notRegister_correct _ targetDataND]
    change (if q∈BalancedCircuit.rawTarget L then !(run S [] s).basis q else
      (run S [] s).basis q)=_
    rw [GuardCompression.complement_bit L.sign L.y facts.1 signAway s [] q]
  have dataAway(q:Wire)(hq:q∈L.lower::L.parity::L.carry):
      q∉L.y∧q∉BalancedCircuit.rawTarget L:=by
    exact ⟨(OwnQ6Core5.work_away L hn q (by
      simp only [List.mem_cons] at hq
      simp only [BalancedCircuit.work,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
      tauto)).2,Q6RawBorrow.rawTarget_away L hn q hq⟩
  have keep(q:Wire)(hq:q∈L.lower::L.parity::L.carry):z.basis q=s.basis q:=by
    rw [basis,if_neg (dataAway q hq).2,if_neg (dataAway q hq).1]
  have low:z.basis b= !z.basis L.parity:=by
    have bIn:b∈BalancedCircuit.rawTarget L:=by
      simp [b,BalancedCircuit.rawTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low]
    have bNotY:b∉L.y:=by
      intro used
      have away:∀q∈L.r,q∉L.y++L.carry:=List.disjoint_left.mp (List.nodup_append'.mp
        (L.toLayout.dataND (List.nodup_append'.mp hn).2.1)).2.2
      exact away b (by simp [b,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low])
        (List.mem_append_left _ used)
    rw [basis b,if_pos bIn,if_neg bNotY,keep L.parity (by simp),parityValue]
  have cleanOrig:∀q∈L.carry,z.basis q=false:=by
    intro q hq
    exact (keep q (by simp [hq])).trans (clean q hq)
  have cleanC:∀q∈C,z.basis q=false:=by
    intro q hq
    have choice:q∈L.carry∨q=L.lower:=by
      change q∈carries++[unused] at hq
      rw [cshape] at hq
      simp only [List.mem_append,List.mem_singleton] at hq
      rcases hq with (front|lo)|last
      · exact Or.inl (List.mem_of_mem_take front)
      · exact Or.inr lo
      · exact Or.inl (last ▸ unusedIn)
    rcases choice with used|eq
    · exact cleanOrig q used
    · subst q
      exact (keep L.lower (by simp)).trans lower
  have w:=BalancedCircuit.widths L hw
  have sourceLength:(GuardCompression.source L).length=(BalancedCircuit.rawTarget L).length:=by
    rw [GuardCompression.source_len,w.1,w.2.1]
  have cLength:C.length+1=(BalancedCircuit.rawTarget L).length:=by simp [C,clen,w.2.1]
  have originalLength:L.carry.length+1=(BalancedCircuit.rawTarget L).length:=by rw [hw.2.2,w.2.1]
  have transfer:run (addInPlace (GuardCompression.source L) (BalancedCircuit.rawTarget L) C L.sign) n z=
      run oldAdd n z:=readonly_add_carry_eq _ _ C L.carry L.sign targetND facts.2.2
    sourceDis origDis sourceLength cLength originalLength z n n cleanC cleanOrig
  have sourceShape:GuardCompression.source L=(a::x)++[L.ymsb,L.ymsb]:=by
    rw [GuardCompression.source,BalancedCleanup.Layout.y,ysplit,List.append_assoc]
    rfl
  have targetShape:BalancedCircuit.rawTarget L=(b::y)++[L.rmsb,L.one]:=by
    simp only [BalancedCircuit.rawTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      b,y,List.append_assoc]
    rfl
  have carryShape:(c::cs)++[unused]=C:=by rw [←csplit]
  have headPost:
      (run (addInPlace ((a::x)++[L.ymsb,L.ymsb]) ((b::y)++[L.rmsb,L.one])
        ((c::cs)++[unused]) L.sign) n z).basis L.one=
      (run (addInPlace ((a::x)++[L.ymsb,L.ymsb]) ((b::y)++[L.rmsb,L.one])
        ((c::cs)++[unused]) L.sign) n z).basis L.rmsb:=by
    rw [←sourceShape,←targetShape,carryShape,transfer]
    exact post
  let oldUpper:=addInPlace (x++[L.ymsb,L.ymsb]) (y++[L.rmsb,L.one]) (cs++[unused]) c
  let finish:=eraseCarry a b L.sign c++[Instr.CX a b,Instr.CX L.sign b]
  have counts:=List.nodup_iff_count.mp headND
  have hyx:y.length=x.length:=by simp [x,y,hw.1,hw.2.1]
  have oldShape:addInPlace ((a::x)++[L.ymsb,L.ymsb]) ((b::y)++[L.rmsb,L.one])
      ((c::cs)++[unused]) L.sign=majority a b L.sign c++oldUpper++finish := by
    rw [rawHead_add_shape x y cs a b L.sign c L.ymsb L.rmsb L.one unused hyx]
    simp only [oldUpper,finish,List.append_assoc]
  have finishFree(q:Wire)(hq:q∈[L.rmsb,L.one]):q∉wires finish := by
    have sub:wires finish⊆[a,b,L.sign,c].toFinset := by
      intro v used
      simp [finish,eraseCarry,wires,Instr.wires,correctionWires] at used
      simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false]
      tauto
    intro used
    have small:([a,b,L.sign,c]++[L.rmsb,L.one]).Nodup := by
      apply List.nodup_iff_count.mpr;intro v
      have h:=counts v
      simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
      omega
    exact List.disjoint_left.mp (List.nodup_append'.mp small).2.2
      (List.mem_toFinset.mp (sub used)) hq
  have postU:(run oldUpper n (run (majority a b L.sign c) [] z)).basis L.one=
      (run oldUpper n (run (majority a b L.sign c) [] z)).basis L.rmsb := by
    have h:=headPost
    rw [oldShape,inv_triple_run] at h
    simp only [show measurementCount (majority a b L.sign c)=0 from rfl,
      Nat.zero_add,List.drop_zero] at h
    rw [FifthCarry.no_records (majority a b L.sign c) rfl z n []] at h
    rw [run_preserves_outside _ _ _ L.one (finishFree _ (by simp)),
      run_preserves_outside _ _ _ L.rmsb (finishFree _ (by simp))] at h
    exact h
  exact ⟨low,cleanC,postU⟩

end RecordTail

section ConcreteTail
open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

theorem replace_middle_exists_some (A P Q R : Program) (s : State)
    (m : List Bool)
    (middle : ∀ x, ∃ y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s)) :
    ∃ n, run (A ++ P ++ R) m s = run (A ++ Q ++ R) n s := by
  let u := run A (m.take (measurementCount A)) s
  let pm := (m.drop (measurementCount A)).take (measurementCount P)
  let rm := m.drop (measurementCount A + measurementCount P)
  have loan : run (A ++ P ++ R) m s = run R rm (run P pm u) := by
    simp only [List.append_assoc, run_append, run_take, u, pm, rm]
    rw [List.drop_drop, Nat.add_comm]
  obtain ⟨qm, middleEq⟩ := middle pm
  obtain ⟨nAQ, hAQ⟩ :=
    join_records A Q s (m.take (measurementCount A)) qm
  obtain ⟨nAll, hAll⟩ := join_records (A ++ Q) R s nAQ rm
  refine ⟨nAll, ?_⟩
  rw [loan, middleEq, ← hAQ, ← hAll]

/-- Right-associated block replacement: a block `P` may be replaced by `Q`
inside `A ++ (P ++ R)` whenever every record of `P` is matched by some record
of `Q` on the state reached by the common prefix `A`. -/
theorem replace_block_exists (A P Q R : Program) (s : State) (m : List Bool)
    (middle : ∀ x, ∃ y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s)) :
    ∃ n, run (A ++ (P ++ R)) m s = run (A ++ (Q ++ R)) n s := by
  obtain ⟨n, h⟩ := replace_middle_exists_some A P Q R s m middle
  exact ⟨n, by simpa only [List.append_assoc] using h⟩

/-- Complete loaned raw-subtraction tail of the 760 inverse half, from the
record-ready facts at its entry (`inv_tail_ready`). -/
theorem rawSubTailLoan_of_ready (d : Nat) (hd : d ≤ 68) (v : State)
    (m : List Bool)
    (parityValue : v.basis L760.parity = v.basis L760.r0)
    (lower : v.basis L760.lower = false)
    (clean : ∀ q ∈ L760.carry, v.basis q = false)
    (post :
      let u := run (signComplement L760.sign L760.y) [] v
      let z := run (notRegister (BalancedCircuit.rawTarget L760)) [] u
      (run (addInPlace (GuardCompression.source L760)
        (BalancedCircuit.rawTarget L760) L760.carry L760.sign) [] z).basis
          L760.one =
      (run (addInPlace (GuardCompression.source L760)
        (BalancedCircuit.rawTarget L760) L760.carry L760.sign) [] z).basis
          L760.rmsb) :
    ∃ n, run (StairLoan.rawSubTailLoan d L760) m v =
      run (Q6LifetimeResearch.rawSubTail (base 760) L760) n v := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  have facts := inv_raw_head_ready L760 hw hn v [] parityValue lower clean post
  let S := signComplement L760.sign L760.y
  let N := notRegister (BalancedCircuit.rawTarget L760)
  let z := run N [] (run S [] v)
  let Rt : Program := N ++ S ++
    [.CX L760.r0 L760.parity, .CX (L760.ylow.getD 0 0) L760.parity,
      .CX L760.rmsb L760.one]
  let a := L760.ylow.getD 0 0
  let x := L760.ylow.drop 1
  have yne : L760.ylow ≠ [] := by
    intro e
    have h := hw.2.1
    rw [e] at h
    cases h
  have ysplit : L760.ylow = a :: x := inv_nonempty_split L760.ylow yne
  have sourceShape :
      GuardCompression.source L760 = (a :: x) ++ [L760.ymsb, L760.ymsb] := by
    rw [GuardCompression.source, BalancedCleanup.Layout.y, ysplit,
      List.append_assoc]
    rfl
  have sourceHead :
      (GuardCompression.source L760).getD 0 0 = L760.ylow.getD 0 0 := by
    rw [sourceShape]
    rfl
  have sourceTail : (GuardCompression.source L760).drop 1 =
      L760.ylow.drop 1 ++ [L760.ymsb, L760.ymsb] := by
    rw [sourceShape]
    rfl
  have targetShape : BalancedCircuit.rawTarget L760 =
      (L760.r0 :: L760.rtail) ++ [L760.rmsb, L760.one] := by
    simp only [BalancedCircuit.rawTarget, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.append_assoc]
    rfl
  have targetHead : (BalancedCircuit.rawTarget L760).getD 0 0 = L760.r0 := by
    rw [targetShape]
    rfl
  have targetTail : (BalancedCircuit.rawTarget L760).drop 1 =
      L760.rtail ++ [L760.rmsb, L760.one] := by
    rw [targetShape]
    rfl
  have loanShape : StairLoan.rawSubTailLoan d L760 =
      (S ++ N) ++ rawSubHeadLoan d ++ Rt := by
    simp only [StairLoan.rawSubTailLoan, rawSubHeadLoan, S, N, Rt, sourceHead,
      sourceTail, targetHead, targetTail, List.append_assoc]
  have oldShape : Q6LifetimeResearch.rawSubTail (base 760) L760 =
      (S ++ N) ++ rawSubHeadOld ++ Rt := by
    simp only [Q6LifetimeResearch.rawSubTail, rawSubHeadOld, S, N, Rt,
      sourceHead, sourceTail, targetHead, targetTail, List.append_assoc]
  have aZero : measurementCount (S ++ N) = 0 := by
    simp only [S, N, measurementCount_append,
      (signComplement_counts L760.sign L760.y).2,
      (notRegister_counts (BalancedCircuit.rawTarget L760)).2]
  have executeA : run (S ++ N) (m.take (measurementCount (S ++ N))) v = z := by
    rw [aZero, List.take_zero, run_append]
    simpa only [List.take_nil, List.drop_nil] using
      (show run N [] (run S [] v) = z from rfl)
  rw [loanShape, oldShape]
  apply replace_middle_exists_some (S ++ N) (rawSubHeadLoan d) rawSubHeadOld Rt v m
  intro r
  rw [executeA]
  -- LT44 (replay budget): the `post` premise is rewritten into `rawSubHeadLoan_exists`'s form
  -- with explicit states (no definitional cast through `State.basis`; was 31 s of kernel time).
  have post' :
      (run rawSubUpperOld []
        (rawSubUpperInput (run (notRegister (BalancedCircuit.rawTarget L760)) []
          (run (signComplement L760.sign L760.y) [] v)))).basis L760.one =
      (run rawSubUpperOld []
        (rawSubUpperInput (run (notRegister (BalancedCircuit.rawTarget L760)) []
          (run (signComplement L760.sign L760.y) [] v)))).basis L760.rmsb := by
    rw [rawSubUpperOld_eq, rawSubUpperInput_eq]
    exact facts.2.2
  exact rawSubHeadLoan_exists d hd
    (run (notRegister (BalancedCircuit.rawTarget L760)) []
      (run (signComplement L760.sign L760.y) [] v)) r facts.1 facts.2.1 post'

end ConcreteTail

