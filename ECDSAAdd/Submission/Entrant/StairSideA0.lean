theorem label_pre_hist (start : Nat) (hs : start ≤ 507) (w : Wire) (hw : OutHist w) :
    ∀ q, MeasuredCodec5.label (History5.historyMap base start) q = w ↔ q = w := by
  have ne : ∀ x y : Nat, (x < 528 ∨ (1044 ≤ x ∧ x < 1556)) → OutHist y → x ≠ y := by
    intro x y hx hy
    obtain ⟨h1, h2⟩ := hy
    omega
  intro q
  unfold MeasuredCodec5.label
  split
  · rename_i hq
    have key : ∀ (st kk : Nat), st ≤ 507 → kk < 10 →
        (st + kk / 2 + 16 < 528 ∨ (1044 ≤ st + kk / 2 + 16 ∧ st + kk / 2 + 16 < 1556)) ∧
        (1028 + st + kk / 2 + 16 < 528 ∨
          (1044 ≤ 1028 + st + kk / 2 + 16 ∧ 1028 + st + kk / 2 + 16 < 1556)) := by
      intro st kk h1 h2
