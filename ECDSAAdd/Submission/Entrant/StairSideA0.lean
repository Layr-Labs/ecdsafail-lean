section Merge_StairPhysicalPhase_at_StairSideA

/-!
# Phase-context checkpoint pieces of the first row

In the re-planned staircase the first checkpoint (letter 425, budget 87) is
packed at the end of the division forward pass and unpacked at the start of
the multiplication reverse pass.  Both run inside
`Rolling1588Lifetime.phaseHost`, where the record walk keeps its b-rail on the
x I/O word.  The pieces below move the b-rail onto `bSite`, relabel the codec
by `phaseRelabel` so that it acts on the same physical sites as in the field,
and move the b-rail back for the record unwalk.

`phasePieces_good`: every wire of these pieces has, through the phase
placement, an image in the record arena that avoids all 59 omissions.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairPhysicalPhase

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairOuterPlacement StairPhysicalInventory StairPhysicalLayout
  StairPhysicalPrimitives

theorem budget87_mem : (87 : Nat) ∈ budgets := by
  simp [budgets]

/-- The first-row codec programs in field labels (relabelled into the phase below). -/
def phasePack : Program := StairPhysicalPrimitives.pack 87
def phaseUnpack : Program := StairPhysicalPrimitives.unpack 87

/-- Move the b-rail back from `bSite` onto the x I/O word. -/
def phaseBReturn : Program :=
  (List.range 88).flatMap (fun k => moveWire (bSite k) (base (770 + k)))



theorem phaseBReturn_counts :
    toffoliCount phaseBReturn = 0 ∧ measurementCount phaseBReturn = 0 := by
  decide +kernel

theorem kbHSw_id {a b q : Nat} (h1 : q ≠ a) (h2 : q ≠ b) : StairPlaceFast.swB a b q = q := by
  simp only [StairPlaceFast.swB, cond_eq_ite, Nat.beq_eq, if_neg h1, if_neg h2]

/-- K4-B: the phase host map is an involution (three disjoint exchanges). -/
theorem kbPH_invol (x : Nat) : StairPlaceFast.phaseHostB (StairPlaceFast.phaseHostB x) = x := by
  by_cases hs : x = 736 ∨ x = 737 ∨ x = 738 ∨ x = 1042 ∨ x = 1557 ∨ x = 1558
  · rcases hs with rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  · have hfix : StairPlaceFast.phaseHostB x = x := by
      unfold StairPlaceFast.phaseHostB
      rw [kbHSw_id (show x ≠ 1042 by omega) (show x ≠ 737 by omega),
        kbHSw_id (show x ≠ 1557 by omega) (show x ≠ 738 by omega),
        kbHSw_id (show x ≠ 1558 by omega) (show x ≠ 736 by omega)]
    rw [hfix, hfix]








theorem pack_inside : ∀ B ∈ budgets, ∀ r ∈ wires (StairPhysicalPrimitives.pack B), r ∈ rowSites B := by
  intro B hB r hr
