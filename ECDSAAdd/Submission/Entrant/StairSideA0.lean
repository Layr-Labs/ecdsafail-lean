/-- A program none of whose instructions writes `w` keeps it. -/
theorem keeps_of_tgt {w : Wire} : ∀ {P : Program}, (∀ i ∈ P, tgt i ≠ w) → Keeps w P := by
  intro P
  induction P with
  | nil => intro _; rfl
  | cons i p ih =>
    intro h
    unfold Keeps at ih ⊢
    simp only [zt, if_neg (h i (by simp))]
    exact ih (fun x hx => h x (by simp [hx]))

