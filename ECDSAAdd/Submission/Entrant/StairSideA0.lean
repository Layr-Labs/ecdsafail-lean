/-- A tape-free concatenation has a tape-free head (phases via `run_local_increment`). -/
theorem tapeFree_head (A C : Program) (s : State) (free : TapeFree (A ++ C) s) :
    TapeFree A s := by
  intro m n
  apply State.extensionality
  · have h := congrArg State.phase (nested_tapeFree A C s free m [] n [])
    have inc := ECDSAAdd.Arithmetic.run_local_increment C (run A m s) (run A n s) []
      (fun q _ => by rw [run_basis_records _ s s m n rfl])
    have e1 := inc.1
    revert h e1
    generalize (run C [] (run A m s)).phase = a
    generalize (run C [] (run A n s)).phase = b
    generalize (run A m s).phase = c
    generalize (run A n s).phase = d
    intro h e1
    subst h
    cases a <;> cases c <;> cases d <;> simp_all
  · exact run_basis_records _ s s m n rfl



theorem away_of_sub (Δ : Finset Wire) (A B : Program) (sub : wires A ⊆ wires B)
    (away : ∀ q ∈ Δ, q ∉ wires B) : ∀ q ∈ Δ, q ∉ wires A :=
  fun q hq used => away q hq (sub used)



