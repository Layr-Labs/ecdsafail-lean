  have half := loanHalfWindow_physical divide d j active hole hj ha
  have swap := selected_physical (Rolling1588.s j active) (base 2409)
    FrontierSW1591.swapBody (HostOB5.host_ne _ _ (by omega))
      swapBody_physical
  cases divide <;>
    simp only [StairGroups.cell, Bool.false_eq_true, if_false, if_true,
