/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Seg_at_QTop` -/
section Merge_StairField2V3Seg_at_QTop

/-!
# LT21: segment obligations from a pure staircase spec and a record fact

Concrete side condition for a v3 row of budget `B` (start `ℓ = startFor B`):
`Cv B a b` — there are an input `x` and a record transcript `origin` with
`TraceOK x origin`, such that on every future payload site `r`
* the record state holds the A-encoded transcript: `b (fieldPlace r) = recVal origin r`,
* the staircase state holds the compact checkpoint of the walk at `ℓ`:
  `a (fieldPlace r) = cmpBits B x r`.

`Cv B` reads only `Δv B` (`cv_local`).  A segment obligation of `EntryPlanV3b`
follows (`seg_of_spec`) from
* `SegSpecT p B B' ℓ e` — a statement about the *tail-level* staircase program
  `forwardSegment p B B' ℓ e` alone (no record state): from the compact
  checkpoint of row `B` and clean scratch it writes the record's encoded packets
  of the segment, stores the compact checkpoint of row `B'`, leaves the scratch
  clean and touches nothing else; and
* `RecordScratch B B' X` — the genuine record state after the record prefix `X`
  is clean on the segment's scratch sites (`scratchT B B'`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Seg

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3Delta
open StairPhysicalLayout StairOuterPlacement

/-! ## Values -/

/-- Record value at a tail-level future payload site: the A-encoded transcript. -/
def recVal (origin : BasisState) (r : Wire) : Bool :=
  (run (Rolling1588.allEncode base true 102) [] ⟨false, origin⟩).basis (OB5.sig 511 r)

/-- The input and its transcript (the record's `trace` premise). -/
def TraceOK (x : Nat) (origin : BasisState) : Prop :=
  0 < x ∧ x < ECDSAAdd.p ∧
    skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)) ∧
    NewHistory5.RawLegal base 102 origin

/-- Letters holding the relocated merged field and sign at rest. -/
def restLetters (B : Nat) : List Wire :=
  (List.range (B - 1)).map (fun i => letterSite (startFor B + i))

/-- Compact checkpoint bits at rest for the walk of `x` at the row's start. -/
def cmpBits (B x : Nat) (r : Wire) : Bool :=
  let z := StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)
  let σ := StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)
  let w := z.u - σ.toNat
  StairCodec.registerBasis (restLetters B)
      (StairCodec.compactF B w z.v + σ.toNat * 2 ^ (B - 2)) r ||
    StairCodec.registerBasis (StairCodec.reg (physicalLayout B).A (StairCodec.bitWidth B))
      (StairCodec.natBitLength w) r



/-! ## Field coordinates -/

def fieldPlaceInv (q : Wire) : Wire :=
  Prefix1590.borrow (HostOB5.hostSwap
    ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) q))


theorem inv_fieldPlace (r : Wire) : fieldPlaceInv (fieldPlace r) = r := by
  unfold fieldPlace fieldPlaceInv
  simp only [Prefix1590.borrow, Equiv.swap_apply_self, HostOB5.hostSwap_invol]

def pullIn (s : State) : State := ⟨s.phase, fun r => s.basis (fieldPlace r)⟩
def pullOut (u : State) : State := ⟨u.phase, fun q => u.basis (fieldPlaceInv q)⟩

theorem rename_conj (f : Wire → Wire)
    (injective : Function.Injective f) (invol : ∀ q, f (f q) = q)
    (P : Program) (s : State) (m : List Bool) :
    run (renameProgram f P) m s = pullState f (run P m (pullState f s)) := by
  have renamed := ECDSAAdd.run_rename f injective P m s
  have lifted := congrArg (pullState f) renamed
  rw [StairReplay.pullState_involutive f invol] at lifted
  exact lifted

theorem liftF_run (P : Program) (m : List Bool) (s : State) :
    run (liftF P) m s = pullOut (run P m (pullIn s)) := by
  have hb : Function.Injective Prefix1590.borrow := Prefix1590.borrow.injective
  have h1 := rename_conj
    (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
    (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host).injective
    (by intro q; simp) (renameProgram HostOB5.hostSwap (renameProgram Prefix1590.borrow P)) s m
  have h2 := rename_conj HostOB5.hostSwap HostOB5.hostSwap_injective
    HostOB5.hostSwap_invol (renameProgram Prefix1590.borrow P)
  have h3 := rename_conj Prefix1590.borrow hb
    (by intro q; simp [Prefix1590.borrow]) P
  unfold liftF StairSchedule.fieldRename StairSchedule.parityRename
  rw [h1, h2, h3]
  rfl

/-! ## The two remaining statements per segment -/

/-- Scratch sites of the segment between rows `B` and `B'`: all labels of the two
rows plus every moved b-rail / carry label (holes of encoded packets and bank
ports), outside the row's future payload. -/
def allBC : List Wire := (List.range 88).map bSite ++ (List.range 87).map cSite

def scratchT (B B' : Nat) : List Wire :=
  (rowSites B ++ rowSites B' ++ allBC).filter (fun r => decide (r ∉ futurePayload B))


/-- Record fact: after the record prefix `X` the record state is clean on the
segment's scratch sites. -/
def RecordScratch (B B' : Nat) (X : Program) : Prop :=
  ∀ t, Reach X t → ∀ r ∈ scratchT B B', t.basis (fieldPlace r) = false


end ECDSAAdd.Entrant.StairField2V3Seg

end
end Merge_StairField2V3Seg_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Codec_at_QTop` -/
section Merge_StairField2V3Codec_at_QTop

/-!
# LT21: the codec halves of a v3 forward segment

The relocated compact checkpoint `cmpBits B x` (stored on the row's letters
and length sites, `StairField2V3Seg.cmpBits`) is exactly LT1's `CompactCode`
after `unrelocate B`, and LT1's proved `FunctionalSpec` (field 1,
`StairCodecFunctionalV3.codecFunctionalSpec`) then gives `CodecInput`:

* `unrelocate_eq` : `unrelocate B = moveProgram (unrelocPairs B)`;
* `compactCode_after_unrelocate`, `codecInput_after_unpackCodec`.

All statements are generic in the row budget `B ∈ budgets`; the per-row data
are small `decide +kernel` list facts (`RowFacts`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Codec

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg

/-! ## Relocation by CX moves (LT14 `StairChainAlgebra`, verbatim) -/

def moveProgram : List (Wire × Wire) → Program
  | [] => []
  | (a, b) :: rest => [Instr.CX a b, Instr.CX b a] ++ moveProgram rest

def moveSites (pairs : List (Wire × Wire)) : List Wire :=
  pairs.map Prod.fst ++ pairs.map Prod.snd

def MoveOK : List (Wire × Wire) → Prop
  | [] => True
  | (a, b) :: rest =>
      a ≠ b ∧ a ∉ moveSites rest ∧ b ∉ moveSites rest ∧ MoveOK rest

theorem moveOK_of_nodup : ∀ pairs : List (Wire × Wire),
    (moveSites pairs).Nodup → MoveOK pairs
  | [] => fun _ => trivial
  | (a, b) :: rest => fun h => by
      have h' : ((a :: rest.map Prod.fst) ++ (b :: rest.map Prod.snd)).Nodup := h
      obtain ⟨h1, h2, h3⟩ := List.nodup_append.mp h'
      have ha := List.nodup_cons.mp h1
      have hb := List.nodup_cons.mp h2
      refine ⟨?_, ?_, ?_, moveOK_of_nodup rest ?_⟩
      · exact h3 a (by simp) b (by simp)
      · intro hm
        unfold moveSites at hm
        rcases List.mem_append.mp hm with hm | hm
        · exact ha.1 hm
        · exact h3 a (by simp) a (List.mem_cons_of_mem b hm) rfl
      · intro hm
        unfold moveSites at hm
        rcases List.mem_append.mp hm with hm | hm
        · exact h3 b (List.mem_cons_of_mem a hm) b (by simp) rfl
        · exact hb.1 hm
      · unfold moveSites
        exact List.nodup_append.mpr ⟨ha.2, hb.2, fun x hx y hy =>
          h3 x (List.mem_cons_of_mem a hx) y (List.mem_cons_of_mem b hy)⟩

theorem mem_moveSites_fst (pairs : List (Wire × Wire)) (p : Wire × Wire)
    (hp : p ∈ pairs) : p.1 ∈ moveSites pairs := by
  unfold moveSites
  exact List.mem_append_left _ (List.mem_map_of_mem hp)

theorem mem_moveSites_snd (pairs : List (Wire × Wire)) (p : Wire × Wire)
    (hp : p ∈ pairs) : p.2 ∈ moveSites pairs := by
  unfold moveSites
  exact List.mem_append_right _ (List.mem_map_of_mem hp)

theorem moveSites_cons (a b : Wire) (rest : List (Wire × Wire)) (q : Wire) :
    q ∈ moveSites ((a, b) :: rest) ↔ q = a ∨ q = b ∨ q ∈ moveSites rest := by
  unfold moveSites
  simp only [List.map_cons, List.cons_append, List.mem_cons, List.mem_append]
  tauto

theorem moveProgram_run (pairs : List (Wire × Wire)) (ok : MoveOK pairs)
    (s : State) (m : List Bool)
    (targets : ∀ p ∈ pairs, s.basis p.2 = false) :
    (run (moveProgram pairs) m s).phase = s.phase ∧
      (∀ p ∈ pairs, (run (moveProgram pairs) m s).basis p.2 = s.basis p.1 ∧
        (run (moveProgram pairs) m s).basis p.1 = false) ∧
      ∀ q, q ∉ moveSites pairs →
        (run (moveProgram pairs) m s).basis q = s.basis q := by
  induction pairs generalizing s with
  | nil =>
      refine ⟨rfl, ?_, ?_⟩
      · intro p hp
        simp at hp
      · intro q _
        rfl
  | cons p rest ih =>
      obtain ⟨a, b⟩ := p
      obtain ⟨hab, aNotRest, bNotRest, restOk⟩ := ok
      have hb0 : s.basis b = false := targets (a, b) (by simp)
      let s2 : State := ⟨s.phase,
        writeBit (writeBit s.basis b (s.basis b ^^ s.basis a)) a
          (writeBit s.basis b (s.basis b ^^ s.basis a) a ^^
            writeBit s.basis b (s.basis b ^^ s.basis a) b)⟩
      have step : run (moveProgram ((a, b) :: rest)) m s =
          run (moveProgram rest) m s2 := rfl
      have s2b : s2.basis b = s.basis a := by
        simp [s2, writeBit, Function.update, Ne.symm hab, hb0]
      have s2a : s2.basis a = false := by
        simp [s2, writeBit, Function.update, hab, hb0]
      have s2q : ∀ q, q ≠ a → q ≠ b → s2.basis q = s.basis q := by
        intro q ha hb
        simp [s2, writeBit, Function.update, ha, hb]
      have restTargets : ∀ p ∈ rest, s2.basis p.2 = false := by
        intro p hp
        have mem := mem_moveSites_snd rest p hp
        have hpa : p.2 ≠ a := fun e => aNotRest (e ▸ mem)
        have hpb : p.2 ≠ b := fun e => bNotRest (e ▸ mem)
        rw [s2q p.2 hpa hpb]
        exact targets p (List.mem_cons_of_mem _ hp)
      have r := ih restOk s2 restTargets
      rw [step]
      refine ⟨r.1, ?_, ?_⟩
      · intro p hp
        rcases List.mem_cons.mp hp with h | h
        · subst h
          exact ⟨by rw [r.2.2 b bNotRest, s2b], by rw [r.2.2 a aNotRest, s2a]⟩
        · have mem := mem_moveSites_fst rest p h
          have hp1a : p.1 ≠ a := fun e => aNotRest (e ▸ mem)
          have hp1b : p.1 ≠ b := fun e => bNotRest (e ▸ mem)
          exact ⟨(r.2.1 p h).1.trans (s2q p.1 hp1a hp1b), (r.2.1 p h).2⟩
      · intro q hq
        have hq' := fun h => hq ((moveSites_cons a b rest q).mpr h)
        have hqa : q ≠ a := fun e => hq' (Or.inl e)
        have hqb : q ≠ b := fun e => hq' (Or.inr (Or.inl e))
        have hqr : q ∉ moveSites rest := fun e => hq' (Or.inr (Or.inr e))
        rw [r.2.2 q hqr, s2q q hqa hqb]

theorem flatMap_moveWire (f g : Nat → Wire) :
    ∀ L : List Nat, L.flatMap (fun i => moveWire (f i) (g i)) =
      moveProgram (L.map (fun i => (f i, g i)))
  | [] => rfl
  | i :: L => by
      have ih := flatMap_moveWire f g L
      simp only [moveWire] at ih
      simp only [List.flatMap_cons, List.map_cons, moveProgram, moveWire, ih]

/-! ## The relocation of v3 -/

def unrelocPairs (B : Nat) : List (Wire × Wire) :=
  ((physicalLayout B).S (B - 2), (physicalLayout B).D (B - 1)) ::
    (List.range (B - 2)).map (fun i => ((physicalLayout B).S i, (physicalLayout B).D i))

theorem unrelocate_eq (B : Nat) : unrelocate B = moveProgram (unrelocPairs B) := by
  unfold unrelocate unrelocPairs
  rw [flatMap_moveWire]
  rfl

/-! ## Register bits -/

theorem registerBasis_not_mem (bits : List Wire) (X : Nat) (q : Wire) (h : q ∉ bits) :
    StairCodec.registerBasis bits X q = false := by
  unfold StairCodec.registerBasis
  rw [if_neg]
  intro hlt
  exact h (List.idxOf_lt_length_iff.mp hlt)

theorem registerBasis_get (bits : List Wire) (hn : bits.Nodup) (X i : Nat)
    (hi : i < bits.length) :
    StairCodec.registerBasis bits X bits[i] = X.testBit i := by
  unfold StairCodec.registerBasis
  rw [List.Nodup.idxOf_getElem hn i hi, if_pos hi]

theorem mod_two_mul (X M : Nat) (hM : 0 < M) :
    X % (M * 2) = X % 2 + 2 * (X / 2 % M) := by
  have hX := Nat.div_add_mod X 2
  have hQ := Nat.div_add_mod (X / 2) M
  have hlt := Nat.mod_lt (X / 2) hM
  have h2 : X % 2 < 2 := Nat.mod_lt _ (by decide)
  have e : (M * 2) * (X / 2 / M) = 2 * (M * (X / 2 / M)) := by ring
  have hsplit : X = (X % 2 + 2 * (X / 2 % M)) + (M * 2) * (X / 2 / M) := by omega
  conv_lhs => rw [hsplit]
  rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]

/-- Value of a register whose bits are the low bits of `X`. -/
theorem regValue_of_bits : ∀ (bits : List Wire) (s : BasisState) (X : Nat),
    (∀ i (hi : i < bits.length), s bits[i] = X.testBit i) →
    regValue bits s = X % 2 ^ bits.length
  | [], _, X, _ => by simp [regValue, Nat.mod_one]
  | a :: rest, s, X, h => by
      have h0 : s a = X.testBit 0 := h 0 (by simp)
      have hr : ∀ i (hi : i < rest.length), s rest[i] = (X / 2).testBit i := by
        intro i hi
        have := h (i + 1) (by simp; omega)
        simpa [Nat.testBit_div_two] using this
      have ih := regValue_of_bits rest s (X / 2) hr
      have hv : regValue (a :: rest) s = (if s a then 1 else 0) + 2 * regValue rest s := rfl
      rw [hv, ih, h0]
      have hb : (if X.testBit 0 = true then 1 else 0) = X % 2 := by
        rw [Nat.testBit_zero]
        by_cases h2 : X % 2 = 1
        · simp [h2]
        · simp [h2]; omega
      rw [hb, List.length_cons, pow_succ]
      exact (mod_two_mul X (2 ^ rest.length) (by positivity)).symm

end ECDSAAdd.Entrant.StairField2V3Codec

end
