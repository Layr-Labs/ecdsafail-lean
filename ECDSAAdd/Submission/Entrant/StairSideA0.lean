theorem off_of_not_EP (q : Wire) (h : q ∉ EP) : Off q :=
  ⟨fun hE => h (List.mem_append_left _ hE),
   fun i he => h (List.mem_append_right _ (List.mem_map.mpr ⟨i, List.mem_finRange i, he.symm⟩))⟩

theorem run_agree_offP (P : Program) (avoid : ∀ q ∈ wires P, Off q) (y v : State)
    (m : List Bool) (agree : ∀ q, Off q → y.basis q = v.basis q) :
    ∀ q, Off q → (run P m y).basis q = (run P m v).basis q := by
  have onP : ∀ q ∈ wires P, y.basis q = v.basis q := fun q hq => agree q (avoid q hq)
  have inc := ECDSAAdd.Arithmetic.run_local_increment P y v m onP
  intro q hq
  by_cases used : q ∈ wires P
  · exact inc.2 q used
  · rw [run_preserves_outside _ _ _ _ used, run_preserves_outside _ _ _ _ used]
    exact agree q hq

theorem groups_sub (j n : Nat) (hj : 1 ≤ j) (hb : j + n ≤ 102) :
    wires (renameProgram (OB5.sig 511) (Rolling1588.groups true j n)) ⊆
      wires (renameProgram (OB5.sig 511) (Rolling1588.groups true 1 101)) := by
  have h1 := groups_true_add (j - 1) (101 - (j - 1)) 1
  rw [show j - 1 + (101 - (j - 1)) = 101 by omega, show 1 + (j - 1) = j by omega] at h1
  have h2 := groups_true_add n (101 - (j - 1) - n) j
  rw [show n + (101 - (j - 1) - n) = 101 - (j - 1) by omega] at h2
  intro q hq
  rw [h1, h2, rename_append', rename_append', wires_append, wires_append]
  exact Finset.mem_union_right _ (Finset.mem_union_left _ hq)

