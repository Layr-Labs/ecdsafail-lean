/-! ## Level 3: the hosted multiplication field -/

theorem exitFieldHosted_core_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (in511 : state.basis (base 511) = true)
    (in1542 : state.basis (base 1542) = false)
    (workIn : state.basis FrontierEntry1591Field.work = false)
    (parity : state.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map state.basis))
    (fresh old : List Bool) :
    run (exitFieldHostedShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.exitFieldHosted old state := by
  have fieldEq (a b : List Bool) :=
    exitField_run_eq half endpoint origin ctx ha x hx0 hx trace enabled Y state
      input a b
  have result (r : List Bool) :=
    Rolling1588.exitField_frame origin ctx ha x hx0 hx trace enabled Y state r
      input
  have before := canonical_flags origin ctx Y 0 state input
  have after (r : List Bool) := field_flags origin ctx _ _ _ (result r).2
  have workSame (r : List Bool) :
      (run Rolling1588.exitField r state).basis FrontierEntry1591Field.work =
        state.basis FrontierEntry1591Field.work := by
    have a := Rolling1588Frame.canonical_special_at origin Y 0 state 1797
      (by simp) input
    have b := Rolling1588Frame.field_special_at origin _ _ _ 1797 (by simp)
      (result r).2
    have fixed : OB5.sig 511 (base 1797) = FrontierEntry1591Field.work := by
      decide
    simpa only [fixed] using b.trans a.symm
  have payload (r : List Bool) :=
    Rolling1588.exit_payload_xor false true origin ctx.hn (ctx.hp _ (by simp))
      ctx.legal Y 0 _ _ state _ input (result r).2
  have hostedR (r : List Bool) :
      run (FrontierEntry1591Field.hosted Rolling1588.exitField) r state =
        run Rolling1588.exitField r state :=
    HostOB5.hosted_run Rolling1588.exitField state r
      Rolling1588.exitField_hosts_free.1 Rolling1588.exitField_hosts_free.2
      before.1 in511 before.2 in1542 (after r).1 (after r).2
  have wrappedR (r : List Bool) :
      run Rolling1588.exitFieldHosted r state =
        run (FrontierEntry1591Field.hosted Rolling1588.exitField) r state :=
    ParityField1591.run_eq_xor FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host _ state r
      (by decide) FrontierEntry1591Field.host_not_controls
      Rolling1588.exitHosted_avoids_host parity workIn
      (by rw [hostedR r]; exact (workSame r).trans workIn)
      (by rw [hostedR r]; exact payload r)
  have sameOut (r : List Bool) :
      run (exitFieldShape StairConcrete.bestLoans) r state =
        run Rolling1588.exitField r state := fieldEq r r
  have hostsFree := exitFieldShape_hosts_free half
  have hostedB (r : List Bool) :
      run (FrontierEntry1591Field.hosted
          (exitFieldShape StairConcrete.bestLoans)) r state =
        run (exitFieldShape StairConcrete.bestLoans) r state :=
    HostOB5.hosted_run _ state r hostsFree.1 hostsFree.2 before.1 in511
      before.2 in1542 (by rw [sameOut r]; exact (after r).1)
      (by rw [sameOut r]; exact (after r).2)
  have wrappedB (r : List Bool) :
      run (exitFieldHostedShape StairConcrete.bestLoans) r state =
        run (FrontierEntry1591Field.hosted
          (exitFieldShape StairConcrete.bestLoans)) r state :=
    ParityField1591.run_eq_xor FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host _ state r
      (by decide) FrontierEntry1591Field.host_not_controls
      (exitHostedShape_avoids_host half) parity workIn
      (by rw [hostedB r, sameOut r]; exact (workSame r).trans workIn)
      (by rw [hostedB r, sameOut r]; exact payload r)
  rw [wrappedB, hostedB, wrappedR, hostedR]
  exact fieldEq fresh old

theorem exitFieldHosted_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (in511 : state.basis (base 511) = true)
    (in1542 : state.basis (base 1542) = false)
    (workIn : state.basis FrontierEntry1591Field.work = false)
    (parity : state.basis FrontierEntry1591Field.host =
