theorem swapBody_physical : GatePhysical FrontierSW1591.swapBody := by
  have old := Prefix1590.firstBody_physical true
  simp only [Prefix1590.firstBody, G0CarryLoan5.program,
    gatePhysical_append] at old
  have body : GatePhysical (FrontierSW1591.firstBodyS true) :=
    unrename_physical (Equiv.swap (base 768) (base 0))
      (FrontierSW1591.firstBodyS true) old.1.2
  simp only [FrontierSW1591.firstBodyS, if_true,
    gatePhysical_append] at body
  have firstSwap : GatePhysical FrontierSW1591.firstSwapS := body.1
  simp only [FrontierSW1591.firstSwapS, SW.selW,
