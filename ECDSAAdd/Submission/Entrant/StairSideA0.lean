private theorem emitErases_physical_of_downs (ls : List CarryLayer)
    (hp : GatePhysical (emitDowns ls)) : GatePhysical (emitErases ls) := by
  induction ls with
  | nil => simp [emitErases, GatePhysical]
  | cons l ls ih =>
      simp only [emitDowns, CarryLayer.down, gatePhysical_append] at hp
      simp only [emitErases, gatePhysical_append]
      exact ⟨ih hp.1, hp.2.1⟩

/-- Physicality is invariant under the loan transformation.  It follows only
from physicality of the old sweep; no arithmetic-specific proof is needed. -/
theorem emitLoan_physical (d : Nat) (roles : List Wire)
    (ls : List CarryLayer) (top : Program)
    (hp : GatePhysical (emitSweep ls top)) :
    GatePhysical (emitLoan d roles ls top) := by
  have parts : GatePhysical (emitUps ls) ∧ GatePhysical top ∧
      GatePhysical (emitDowns ls) := by
    simpa only [emitSweep, gatePhysical_append, and_assoc] using hp
  have upBoundary : GatePhysical (emitUps (ls.take (d + 1))) := by
    rw [← List.take_append_drop (d + 1) ls, emitUps_append,
      gatePhysical_append] at parts
    exact parts.1.1
  have upBorrowed : GatePhysical (emitUps (ls.take d)) := by
    have ups := parts.1
    rw [← List.take_append_drop d ls, emitUps_append,
      gatePhysical_append] at ups
    exact ups.1
  have downBoundary : GatePhysical (emitDowns (ls.take (d + 1))) := by
    have downs := parts.2.2
    rw [← List.take_append_drop (d + 1) ls, emitDowns_append,
      gatePhysical_append] at downs
    exact downs.2
  have eraseBorrowed : GatePhysical (emitErases (ls.take d)) := by
    have downs := parts.2.2
    rw [← List.take_append_drop d ls, emitDowns_append,
      gatePhysical_append] at downs
    exact emitErases_physical_of_downs (ls.take d) downs.2
  have upper : GatePhysical (emitSweep (ls.drop (d + 1)) top) := by
    have split : GatePhysical (emitUps (ls.take (d + 1)) ++
        emitSweep (ls.drop (d + 1)) top ++ emitDowns (ls.take (d + 1))) := by
      rw [← emitSweep_split (d + 1) ls top]
      exact hp
    simp only [gatePhysical_append] at split
    exact split.1.2
  have rebound : GatePhysical (rebindMany (roles.take d)
      (layerHosts (ls.take d)) (emitSweep (ls.drop (d + 1)) top)) :=
    rebindMany_physical _ _ _ upper
  simp only [emitLoan, gatePhysical_append]
  exact ⟨⟨⟨⟨upBoundary, eraseBorrowed⟩, rebound⟩, upBorrowed⟩, downBoundary⟩

private theorem unrename_physical (f : Wire → Wire) (P : Program)
    (hp : GatePhysical (renameProgram f P)) : GatePhysical P := by
  intro i hi
  have h := hp (renameInstr f i) (List.mem_map.mpr ⟨i, hi, rfl⟩)
  cases i with
  | X _ => trivial
  | CX _ _ => exact fun e => h (congrArg f e)
  | CCX _ _ _ => exact ⟨fun e => h.1 (congrArg f e), fun e => h.2 (congrArg f e)⟩
  | measureX _ _ _ => trivial

private theorem move_physical_iff (r h : Wire) (P : Program) :
    GatePhysical (Q6LifetimeResearch.move r h P) ↔ GatePhysical P := by
  constructor
  · intro hp
    exact unrename_physical (Equiv.swap r h) P (by
      simpa only [Q6LifetimeResearch.move] using hp)
  · intro hp
    simpa only [Q6LifetimeResearch.move] using
      gatePhysical_rename _ (Equiv.swap r h).injective P hp

theorem mappedAddLoan_physical_of_zero (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (h0 : GatePhysical (mappedAddLoan 0 roles bits ys cs cin)) :
    GatePhysical (mappedAddLoan d roles bits ys cs cin) := by
  rw [mappedAddLoan, emitLoan_zero] at h0
  exact emitLoan_physical d roles (mappedLayers bits ys cs cin)
    (mappedTop bits ys cs cin) h0

theorem literalConstAddLoan_physical_of_zero (d : Nat) (roles xs cs : List Wire)
    (cin one : Wire) (k : Nat)
    (h0 : GatePhysical (literalConstAddLoan 0 roles xs cs cin one k))
    (hm : GatePhysical (mappedAddLoan 0 roles
      (mappedConstant none xs.length k) xs cs cin)) :
    GatePhysical (literalConstAddLoan d roles xs cs cin one k) := by
  cases d with
  | zero => exact h0
  | succ d =>
      simp only [literalConstAddLoan, Nat.succ_ne_zero, if_false]
      exact mappedAddLoan_physical_of_zero (d + 1) roles
        (mappedConstant none xs.length k) xs cs cin hm

