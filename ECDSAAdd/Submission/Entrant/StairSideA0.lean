/-!
# Field 12 (`site_avoidance`) for the CANON v3 program, parametric in the hole list

`StairCertificate.HolePlacement holes P` is LT7's parametric placement
(RV5 F4): the program stays inside the record
arena, avoids the 15 old omissions, and avoids every site of `holes`.  The main
theorem `site_avoidance` proves `∀ C, HolePlacement holes (concreteProgram C)`
for every `holes ⊆ physicalHoles` from per-piece facts:

* every piece of the literal program is listed once, together with the map
  that sends its own labels to physical wires (`U` for the finite stage,
  `UG = U ∘ swap ∘ rho` for the generic block, `kernelPlace` for kernel labels,
  `phasePlace = kernelPlace ∘ phaseHost` for the two phases, `lowPlace` for the
  un-borrowed field level, `StairPhysicalInventory.place` for the field tail);
* a piece fact is `PieceOK holes f P`: arena and old-hole freedom (`ArenaOld`)
  plus freedom of the given holes (`HolesFree`);
* the staircase pieces (all forward/reverse segments, `forwardLast`,
  `reverseLast` with the v3 terminals and the s505-fixed reverse middle, the
  parity setup and hosted X) are PROVED here for every sublist of the 44 holes;
* every other piece is a named field of `OpenPieces holes` (owners in the
  report).  `record_ok` / `rec_stage` / `rec_borrowOut` already transport the
  record's own arena and old-hole theorems to two frame pieces; the remaining
  frame extractions are pending.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSiteAvoidance

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly

/-! ## Parametric placement predicates -/

/-- Arena membership and old-omission freedom of a piece under its physical map. -/
abbrev ArenaOld (f : Wire → Wire) (P : Program) : Prop :=
  ∀ x ∈ wires P, f x ∈ StairHoleSupport.recordArena ∧ f x ∉ StairHoleSupport.oldHoles

/-- Freedom of the given holes under the piece's physical map. -/
abbrev HolesFree (holes : List Wire) (f : Wire → Wire) (P : Program) : Prop :=
  ∀ x ∈ wires P, f x ∉ holes

abbrev PieceOK (holes : List Wire) (f : Wire → Wire) (P : Program) : Prop :=
  ArenaOld f P ∧ HolesFree holes f P

theorem PieceOK.append {holes : List Wire} {f : Wire → Wire} {P Q : Program}
    (hP : PieceOK holes f P) (hQ : PieceOK holes f Q) : PieceOK holes f (P ++ Q) := by
  refine ⟨?_, ?_⟩ <;> intro x hx <;> rw [wires_append, Finset.mem_union] at hx <;>
    rcases hx with hx | hx
  · exact hP.1 x hx
  · exact hQ.1 x hx
  · exact hP.2 x hx
  · exact hQ.2 x hx





/-! ## Iterative site checker (no deep `wires` recursion in the kernel) -/

def corrWs : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: corrWs cs
  | .CZ a b :: cs => a :: b :: corrWs cs

def instrWs : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c0 c1 => t :: (corrWs c0 ++ corrWs c1)

theorem mem_corrWs {x : Wire} : ∀ cs : List Correction, x ∈ correctionWires cs → x ∈ corrWs cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      rcases h with h | h
      · simp [corrWs, h]
      · exact List.mem_cons_of_mem _ (mem_corrWs cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      rcases h with (h | h) | h
      · simp [corrWs, h]
      · simp [corrWs, h]
      · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (mem_corrWs cs h))

theorem mem_instrWs {x : Wire} (i : Instr) (h : x ∈ i.wires) : x ∈ instrWs i := by
  cases i with
  | X t => simpa [Instr.wires, instrWs] using h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      rcases h with h | h <;> simp [instrWs, h]
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      rcases h with h | h | h <;> simp [instrWs, h]
  | measureX t c0 c1 =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      rcases h with (h | h) | h
      · simp [instrWs, h]
      · exact List.mem_cons_of_mem _ (List.mem_append_left _ (mem_corrWs c0 h))
      · exact List.mem_cons_of_mem _ (List.mem_append_right _ (mem_corrWs c1 h))

theorem mem_wires_instr {x : Wire} : ∀ P : Program, x ∈ wires P → ∃ i ∈ P, x ∈ instrWs i
  | [], h => by simp [wires] at h
  | i :: P, h => by
      simp only [wires, Finset.mem_union] at h
      rcases h with h | h
      · exact ⟨i, by simp, mem_instrWs i h⟩
      · obtain ⟨j, hj, hx⟩ := mem_wires_instr P h
        exact ⟨j, by simp [hj], hx⟩

/-- Every wire of every instruction passes the Boolean check. -/
def allSites (c : Wire → Bool) (P : Program) : Bool :=
  P.all (fun i => (instrWs i).all c)

theorem allSites_sound {c : Wire → Bool} {P : Program} (h : allSites c P = true) :
    ∀ x ∈ wires P, c x = true := by
  intro x hx
  obtain ⟨i, hi, hxi⟩ := mem_wires_instr P hx
  have hi' := List.all_eq_true.mp h i hi
  exact List.all_eq_true.mp hi' x hxi




