/-! ## Loaned packet groups -/

theorem preserves_label (j : Nat) (hj : j ≤ 101) (q : Wire) (hq : q < 10 ∨ q ∈ callerDomain) :
    MeasuredCodec5.label (History5.historyMap base (5 * j)) q ∈ callerDomain := by
  unfold MeasuredCodec5.label
  split
  · rename_i h
    unfold History5.historyMap
    exact base_mem_caller _ (Or.inl (lt_of_lt_of_le
      (History5.historyId_bound (5 * j) (by omega) ⟨q, h⟩) (by norm_num)))
  · rename_i h
    rcases hq with h' | h'
    · exact absurd h' h
    · exact h'

theorem onPacket_caller (j : Nat) (hj : j ≤ 101) (P : Program)
    (hP : allIn localNat P = true) : wires (Rolling1588.onPacket j P) ⊆ callerDomain := by
  unfold Rolling1588.onPacket
  rw [renameProgram_support]
  intro q hq
  obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hq
  exact preserves_label j hj r (localNat_sound r (allIn_sound localNat P hP r hr))

theorem selW_caller (source flag : Wire) (body : Program) (hs : source ∈ callerDomain)
    (hf : flag ∈ callerDomain) (hb : wires body ⊆ callerDomain) :
    wires (SW.selW source flag body) ⊆ callerDomain := by
  have ns := callerNat_complete _ hs
  have nf := callerNat_complete _ hf
  have a : wires [Instr.CX source flag] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, ns, nf])
  have b : wires [Instr.measureX flag [] [.Z source]] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, corrCaller, ns, nf])
  unfold SW.selW
  exact wires_sub_of_parts _ _ (wires_sub_of_parts _ _ a hb) b

theorem loanWindow_caller (g flag c : Wire) (P : Program) (hg : g ∈ callerDomain)
    (hf : flag ∈ callerDomain) (hc : c ∈ callerDomain) (hP : wires P ⊆ callerDomain) :
    wires (ControlLoan1589.loanWindow g flag c P) ⊆ callerDomain := by
  have ng := callerNat_complete _ hg
  have nf := callerNat_complete _ hf
  have a : wires [Instr.CX g flag, Instr.CX flag g] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, ng, nf])
  have b : wires [Instr.CX flag g, Instr.measureX flag [] [.Z g]] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, corrCaller, ng, nf])
  unfold ControlLoan1589.loanWindow
  exact wires_sub_of_parts _ _
    (wires_sub_of_parts _ _ a (rename_caller _ (preserves_swap c g hc hg) _ hP)) b

theorem g_caller (j k : Nat) (h : 5 * j + k < 2314) : Rolling1588.g j k ∈ callerDomain :=
  base_mem_caller _ (Or.inl h)

theorem s_caller (j k : Nat) (h : 1028 + 5 * j + k < 2314) : Rolling1588.s j k ∈ callerDomain :=
  base_mem_caller _ (Or.inl h)

theorem carry_caller (j : Nat) (h : 516 + 2 * j < 2314) :
    Rolling1588.packetCarry j ∈ callerDomain :=
  base_mem_caller _ (Or.inl h)

/-- The record half on the 760 endpoint has caller support. -/
theorem endpointHalf_caller (divide : Bool) :
    wires (Q6EndpointCell.half divide base (base 2409)) ⊆ callerDomain := by
  apply Q6EndpointCell.half_support
  intro q hq
  simp only [List.mem_toFinset, List.mem_cons, List.mem_map] at hq
  rcases hq with rfl | ⟨i, hi, rfl⟩
  · exact base_mem_caller 2409 (by omega)
  · exact base_mem_caller i (Or.inl (Q6EndpointCell.ids_bound i hi))

/-- Field 5 (current 68-role plan) gives the loaned half caller support. -/
theorem half760Loan_caller (d : Nat) (hd : d ≤ 68) (divide : Bool) :
    wires (StairLoan.half760Loan d divide) ⊆ callerDomain := by
  intro q hq
  have h := StairHalfSupportField.half_support divide d hd hq
  exact endpointHalf_caller divide (Finset.mem_sdiff.mp h).1

theorem halfWindow_caller (divide : Bool) (d j active hole : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain)
    (hj : j ≤ 101) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.halfWindow divide d j active hole) ⊆ callerDomain := by
  unfold StairGroups.halfWindow StairLoanAdapter.concreteHalf760Loan
  exact loanWindow_caller _ _ _ _ (g_caller j active (by omega))
    (base_mem_caller 2409 (by omega)) (carry_caller j (by omega))
    (rename_caller _ (preserves_swap _ _ (base_mem_caller 719 (by omega))
      (s_caller j hole (by omega))) _ hHalf)

theorem swapBody_caller : wires FrontierSW1591.swapBody ⊆ callerDomain :=
  allCaller_sound _ (by decide +kernel)

theorem cell_caller (divide : Bool) (d j active hole : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain)
    (hj : j ≤ 101) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.cell divide d j active hole) ⊆ callerDomain := by
  have hw := halfWindow_caller divide d j active hole hHalf hj ha hh
  have hs := selW_caller _ _ _ (s_caller j active (by omega)) (base_mem_caller 2409 (by omega))
    swapBody_caller
  unfold StairGroups.cell
  cases divide
  · simp only [Bool.false_eq_true, if_false]
    exact wires_sub_of_parts _ _ hs hw
  · simp only [if_true]
    exact wires_sub_of_parts _ _ hw hs

theorem codecPieces_local :
    allIn localNat (Rolling1588.dp ++ ParityCodec5New.untwist) = true ∧
      allIn localNat (ParityCodec5New.twist ++ Rolling1588.ep) = true ∧
      allIn localNat Rolling1588.bridge7 = true ∧
      allIn localNat Rolling1588.bridge7inv = true ∧
      allIn localNat Rolling1588.bridge5 = true := by
  decide +kernel

theorem basePacket_caller (divide : Bool) (d j : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain) (hj : j ≤ 101) :
    wires (StairGroups.basePacket divide d j) ⊆ callerDomain := by
  obtain ⟨c1, c2, c3, c4, c5⟩ := codecPieces_local
  have o1 := onPacket_caller j hj _ c1
  have o2 := onPacket_caller j hj _ c2
  have o3 := onPacket_caller j hj _ c3
  have o4 := onPacket_caller j hj _ c4
  have o5 := onPacket_caller j hj _ c5
  have cl (a : Nat) (ha : a < 5) := cell_caller divide d j a 2 hHalf hj ha (by omega)
  unfold StairGroups.basePacket
  apply wires_sub_of_parts _ _ (wires_sub_of_parts _ _ o1 _) o2
  cases divide
  · simp only [Bool.false_eq_true, if_false]
    exact wires_sub_of_parts _ _ (wires_sub_of_parts _ _ (wires_sub_of_parts _ _
      (wires_sub_of_parts _ _ (wires_sub_of_parts _ _ (wires_sub_of_parts _ _
        (cl 4 (by omega)) o5) (cl 3 (by omega))) (cl 4 (by omega))) o4)
      (cl 4 (by omega))) (cl 3 (by omega))
  · simp only [if_true]
    exact wires_sub_of_parts _ _ (wires_sub_of_parts _ _ (wires_sub_of_parts _ _
      (wires_sub_of_parts _ _ (wires_sub_of_parts _ _ (wires_sub_of_parts _ _
        (cl 3 (by omega)) (cl 4 (by omega))) o3) (cl 4 (by omega))) (cl 3 (by omega)))
      o5) (cl 4 (by omega))

theorem pi_fix (j : Nat) (hj : j ≤ 101) (i : Nat) (hi : 2314 ≤ i) : Placement5.pi j i = i := by
  unfold Placement5.pi
  simp only [Equiv.trans_apply]
  have w1 : i ≠ Placement5.W (2 * j) := by unfold Placement5.W; omega
  have w2 : i ≠ Placement5.W (2 * j + 1) := by unfold Placement5.W; omega
  have h1 : i ≠ Placement5.H (2 * j) := by unfold Placement5.H; omega
  have h2 : i ≠ Placement5.H (2 * j + 1) := by unfold Placement5.H; omega
  have h3 : i ≠ Placement5.H 202 := by unfold Placement5.H; omega
  have h4 : i ≠ Placement5.H 203 := by unfold Placement5.H; omega
  rw [Equiv.swap_apply_of_ne_of_ne w1 h1, Equiv.swap_apply_of_ne_of_ne w2 h2,
    Equiv.swap_apply_of_ne_of_ne h1 h3, Equiv.swap_apply_of_ne_of_ne h2 h4]
  apply Placement5.pi0_outside
  unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
  omega

theorem pi_lt (j : Nat) (hj : j ≤ 101) (i : Nat) (hi : i < 2314) : Placement5.pi j i < 2314 := by
  by_contra hc
  have big : 2314 ≤ Placement5.pi j i := by omega
  have fix := pi_fix j hj _ big
  have same : Placement5.pi j i = Placement5.pi j (Placement5.pi j i) := fix.symm
  have eq := (Placement5.pi j).injective same
  omega

theorem preserves_shifted_pi (j : Nat) (hj : j ≤ 101) :
    PreservesCaller (shifted (Placement5.pi j)) := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := caller_index q hq
  rw [shifted_base]
  rcases hi with h | h | h | h | h
  · exact base_mem_caller _ (Or.inl (pi_lt j hj i h))
  · subst h
    rw [pi_fix j hj 2400 (by norm_num)]
    exact base_mem_caller 2400 (by decide)
  · subst h
    rw [pi_fix j hj 2409 (by norm_num)]
    exact base_mem_caller 2409 (by decide)
  · subst h
    rw [pi_fix j hj 2410 (by norm_num)]
    exact base_mem_caller 2410 (by decide)
  · subst h
    rw [pi_fix j hj 2411 (by norm_num)]
    exact base_mem_caller 2411 (by decide)

theorem packet_caller (divide : Bool) (d j : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain) (hj : j ≤ 101) :
    wires (StairGroups.packet divide d j) ⊆ callerDomain := by
  unfold StairGroups.packet
  exact rename_caller _ (preserves_shifted_pi j hj) _ (basePacket_caller divide d j hHalf hj)

theorem packetSequence_caller (forward : Bool) (p : Nat → Program) (n : Nat) :
    ∀ j, (∀ k, j ≤ k → k < j + n → wires (p k) ⊆ callerDomain) →
      wires (PacketSequence.program forward p j n) ⊆ callerDomain := by
  induction n with
  | zero =>
    intro j _
    simp [PacketSequence.program, wires]
  | succ n ih =>
    intro j h
    have here := h j le_rfl (by omega)
    have rest := ih (j + 1) (fun k h1 h2 => h k (by omega) (by omega))
    cases forward
    · simp only [PacketSequence.program, Bool.false_eq_true, if_false]
      exact wires_sub_of_parts _ _ rest here
    · simp only [PacketSequence.program, if_true]
      exact wires_sub_of_parts _ _ here rest

/-- Loaned packet groups, from the loaned half's caller support. -/
theorem groups_caller (divide : Bool) (d first count : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain)
    (hfc : first + count ≤ 102) :
    wires (StairGroups.groups divide d first count) ⊆ callerDomain := by
  unfold StairGroups.groups
  exact packetSequence_caller divide _ count first
    (fun k h1 h2 => packet_caller divide d k hHalf (by omega))

theorem placedGroups_caller (divide : Bool) (d first count : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain)
    (hfc : first + count ≤ 102) :
    wires (StairSchedule.placedGroups StairConcrete.bestLoans divide d first count) ⊆
      callerDomain := by
  unfold StairSchedule.placedGroups
  exact rename_caller _ (preserves_sig 511 (by omega)) _
    (groups_caller divide d first count hHalf hfc)



