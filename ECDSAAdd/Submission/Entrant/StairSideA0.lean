section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3LastRec

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg

/-- LT48 (replay budget): `recVal` unfolded through a function-level `rfl` (one kernel delta step).
`unfold recVal` realizes `recVal.eq_1`, whose kernel check costs ≈ 40 s per module. -/
theorem recVal_funLR : recVal = fun (origin : BasisState) (r : Wire) =>
    (ECDSAAdd.run (Rolling1588.allEncode ECDSAAdd.Arithmetic.MappedCompressed.base true 102) []
      ⟨false, origin⟩).basis (OB5.sig 511 r) := rfl

theorem recVal_defLR (origin : BasisState) (r : Wire) :
    recVal origin r = (ECDSAAdd.run (Rolling1588.allEncode ECDSAAdd.Arithmetic.MappedCompressed.base true 102) []
      ⟨false, origin⟩).basis (OB5.sig 511 r) :=
  congrFun (congrFun recVal_funLR origin) r

theorem sig_low_list : ∀ id ∈ List.range 1028, OB5.sig 511 (base id) = base id := by
  decide +kernel

theorem sig_low (id : Nat) (h : id < 1028) : OB5.sig 511 (base id) = base id :=
  sig_low_list id (List.mem_range.mpr h)

theorem sig_host : OB5.sig 511 (base 1543) = base 1538 := by
  decide +kernel

theorem pk_off : ∀ k ∈ ([100, 101] : List Nat), ∀ i : Fin 10,
    StairField2V3Packet.packetSite k i ≠ base 512 ∧
      StairField2V3Packet.packetSite k i ≠ base 770 := by
  decide +kernel

theorem reg_one (a : Wire) (rest : List Wire) (s : BasisState)
    (h : regValue (a :: rest) s = 1) : s a = true ∧ ∀ q ∈ rest, s q = false := by
  have h' : (if s a then 1 else 0) + 2 * regValue rest s = 1 := h
  by_cases ha : s a = true
  · rw [if_pos ha] at h'
    exact ⟨ha, (regValue_zero _ _).mp (by omega)⟩
  · rw [if_neg ha] at h'
    omega

theorem code511 (x : Nat) (hx0 : 0 < x) (hxp : x < ECDSAAdd.p) :
    (SkywalkTrace.code (SkywalkTrace.next^[511]
      (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).1 = true := by
  have h := SkywalkTrace.trace512_last x hx0 hxp (false, false)
  rw [List.getD_eq_getElem?_getD, StairField2V3Trace.trace_getElem? 512 _ 511 (by omega)] at h
  exact congrArg Prod.fst h

/-- A raw record stage at tick 512 holds the transcript letters on every packet. -/
theorem raw_packet_base (x : Nat) (origin : BasisState) (hx : TraceOK x origin)
    (raw : BasisState)
    (fpast : ∀ j, j < 512 → raw (base j) =
        (SkywalkTrace.code (SkywalkTrace.next^[j]
          (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).1 ∧
      raw (base (1028 + j)) =
        (SkywalkTrace.code (SkywalkTrace.next^[j]
          (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).2)
    (k : Nat) (hk : 5 * k + 5 ≤ 512) (r : Fin 10) :
    raw (History5.historyMap base (5 * k) r) = origin (History5.historyMap base (5 * k) r) := by
  have hr := r.isLt
  unfold History5.historyMap History5.historyId
  by_cases hc : r.val % 2 = 0
  · simp only [hc, ↓reduceIte]
    obtain ⟨o1, -⟩ := StairField2V3Trace.origin_letters x origin hx (5 * k + r.val / 2) (by omega)
    rw [(fpast (5 * k + r.val / 2) (by omega)).1, o1]
  · simp only [hc, ↓reduceIte]
    obtain ⟨-, o2⟩ := StairField2V3Trace.origin_letters x origin hx (5 * k + r.val / 2) (by omega)
    rw [show 1028 + 5 * k + r.val / 2 = 1028 + (5 * k + r.val / 2) by omega,
      (fpast (5 * k + r.val / 2) (by omega)).2, o2]



end ECDSAAdd.Entrant.StairField2V3LastRec

