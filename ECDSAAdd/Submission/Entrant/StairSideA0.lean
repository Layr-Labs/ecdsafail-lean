/-- Lift the logical tail equality through its clean carry/lower borrow swap.
The two record tapes remain independent. -/
theorem tailBorrowedLoan44_run_eq (s : State) (fresh old : List Bool)
    (Y : Int) (hy : Centered Y)
    (hR : regValue L.r s.basis = encodeWord 256 Y)
    (hY : regValue L.y s.basis = encodeWord 256 Y)
    (clean : ∀ q ∈ BalancedCircuit.work L, s.basis q = false) :
    run (tailBorrowedLoan44 L) fresh s =
      run (InverseTailC.borrowed L) old s := by
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have oneZero : s.basis L.one = false := clean _ (by simp [BalancedCircuit.work])
  have carryZero : ∀ q ∈ L.carry.take 255, s.basis q = false := by
    intro q hq
    exact clean q (by simp [BalancedCircuit.work, List.mem_of_mem_take hq])
  have parityZero : s.basis L.parity = false :=
    clean _ (by simp [BalancedCircuit.work])
  have input : InverseTailC.Frame L s.basis (encodeWord 256 Y) false s.basis :=
    ⟨hR, parityZero, fun _ _ _ => rfl⟩
  have raw := tailProgramLoan44_run_eq s.basis Y hy hY
    oneZero carryZero s fresh old input
  have lastClean : s.basis (InverseTailC.last L) = false :=
    clean _ (by simp [BalancedCircuit.work, InverseTailC.last_mem L hw])
  have lowerClean : s.basis L.lower = false :=
    clean _ (by simp [BalancedCircuit.work])
  have pull : pullState (InverseTailC.borrowSwap L) s = s := by
    exact NewFieldFrameOB5.pull_swap_zero (InverseTailC.last L) L.lower s
      lastClean lowerClean
  have placed := StairLoan.renameProgram_run_eq_of (InverseTailC.borrowSwap L)
    (tailProgramLoan44 L) (InverseTailC.program L) s fresh old
  rw [pull] at placed
  exact placed raw

/-- Thread the borrowed tail equality through the two sign flips forming the
inverse endpoint half. -/
theorem halfLoan44_run_eq (origin : BasisState)
    (clean : ∀ q ∈ BalancedCircuit.work L, origin q = false)
    (X : Fp) (s : State) (fresh old : List Bool)
    (input : PairFrame L.r L.y origin (centerWord X) (centerWord X) s.basis) :
    run (halfLoan44 L) fresh s =
      run (InverseEndpointC.half L) old s := by
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have signAway := BalancedCircuit.flagAway L hn L.sign (by simp)
  have signR : L.sign ∉ L.r := fun h => signAway (by simp [h])
  have signY : L.sign ∉ L.y := fun h => signAway (by simp [h])
  let u := run [.X L.sign] [] s
  have keep (q : Wire) (hq : q ≠ L.sign) : u.basis q = s.basis q := by
    simp [u, run, writeBit, hq]
  have ur : regValue L.r u.basis = encodeWord 256 (centerFp X) := by
    have same := regValue_congr L.r u.basis s.basis
      (fun q hq => keep q (fun e => signR (e ▸ hq)))
    exact same.trans input.1
  have uy : regValue L.y u.basis = encodeWord 256 (centerFp X) := by
    have same := regValue_congr L.y u.basis s.basis
      (fun q hq => keep q (fun e => signY (e ▸ hq)))
    exact same.trans input.2.1
  have uclean : ∀ q ∈ BalancedCircuit.work L, u.basis q = false := by
    intro q hq
    have away := OneBankCore5.work_away L hn q hq
    have qsign : q ≠ L.sign := fun e => OneBankCore5.sign_work L hn (e ▸ hq)
    exact (keep q qsign).trans
      ((input.2.2 q away.1 away.2).trans (clean q hq))
  have middle : ∀ a b,
      run (tailBorrowedLoan44 L) a u =
        run (InverseTailC.borrowed L) b u := by
    intro a b
    exact tailBorrowedLoan44_run_eq u a b (centerFp X) (centerFp_bounds X)
      ur uy uclean
  have tail : ∀ a b,
      run ([.X L.sign] : Program) a
          (run (tailBorrowedLoan44 L) [] u) =
        run ([.X L.sign] : Program) b
          (run (tailBorrowedLoan44 L) [] u) := by
    intro a b
    exact FifthCarry.no_records ([.X L.sign] : Program) rfl _ a b
  simpa only [halfLoan44, InverseEndpointC.half] using
    StairLoan.run_sandwich_independent ([.X L.sign] : Program)
      (tailBorrowedLoan44 L) (InverseTailC.borrowed L)
      ([.X L.sign] : Program) s fresh old rfl middle tail

/-- The 256 padding measurements are inert once the old inverse half has
restored their carry wire. -/
theorem paddedLoan44_run_eq (origin : BasisState)
    (clean : ∀ q ∈ BalancedCircuit.work L, origin q = false)
    (X : Fp) (c : Wire) (s : State) (fresh old : List Bool)
    (input : PairFrame L.r L.y origin (centerWord X) (centerWord X) s.basis)
    (zero : (run (InverseEndpointC.half L)
      (old.take (measurementCount (InverseEndpointC.half L))) s).basis c = false) :
    run (paddedLoan44 L c) fresh s =
      run (InverseEndpointWires.padded L c) old s := by
  rw [paddedLoan44, InverseEndpointWires.padded,
    run_append, run_append]
  have core := halfLoan44_run_eq origin clean X s
    (fresh.take (measurementCount (halfLoan44 L)))
    (old.take (measurementCount (InverseEndpointC.half L))) input
  rw [core]
  rw [InverseEndpointWires.pad_run 256 c _ _ zero,
    InverseEndpointWires.pad_run 256 c _ _ zero]

/-- Concrete multiplication endpoint half, before the selector loan. -/
theorem endHalfLoan44_false_run_eq (origin : BasisState)
    (clean : Q6EndpointCell.Clean base origin) (X : Fp)
    (s : State) (fresh old : List Bool)
    (input : PairFrame L.r L.y origin (centerWord X) (centerWord X) s.basis) :
    run (endHalfLoan44 false) fresh s =
      run (Rolling1588Lifetime.endHalf false) old s := by
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  -- LT44 (replay budget): `oldCoreRecords` is an opaque variable with an equation instead of a
  -- `let`.  With the `let`, the kernel compared `(run (half L) oldCoreRecords s).basis _` with
  -- its unfolded form through the projection `State.basis` (an abbreviation, so no
  -- argument-first shortcut) and evaluated `run` on the whole concrete half twice (86 s).
  obtain ⟨oldCoreRecords, recordsDef⟩ : ∃ r : List Bool,
      r = old.take (measurementCount (InverseEndpointC.half L)) := ⟨_, rfl⟩
  have member : base 512 ∈ Q6EndpointCell.workIds.map base :=
    List.mem_map.mpr ⟨512, by
      simp [Q6EndpointCell.workIds, List.mem_range'_1], rfl⟩
  have workClean : ∀ q ∈ BalancedCircuit.work L, origin q = false :=
    Q6EndpointCell.clean_work base (base 2409) origin clean
  have signAway := BalancedCircuit.flagAway L hn L.sign (by simp)
  have signR : L.sign ∉ L.r := fun h => signAway (by simp [h])
  have signY : L.sign ∉ L.y := fun h => signAway (by simp [h])
  let u := run [.X L.sign] [] s
  have keep (q : Wire) (hq : q ≠ L.sign) : u.basis q = s.basis q := by
    simp [u, run, writeBit, hq]
  have ur : regValue L.r u.basis = encodeWord 256 (centerFp X) := by
    exact (regValue_congr L.r u.basis s.basis
      (fun q hq => keep q (fun e => signR (e ▸ hq)))).trans input.1
  have uy : regValue L.y u.basis = encodeWord 256 (centerFp X) := by
    exact (regValue_congr L.y u.basis s.basis
      (fun q hq => keep q (fun e => signY (e ▸ hq)))).trans input.2.1
  have uclean : ∀ q ∈ BalancedCircuit.work L, u.basis q = false := by
    intro q hq
    have away := OneBankCore5.work_away L hn q hq
    have qsign : q ≠ L.sign := fun e => OneBankCore5.sign_work L hn (e ▸ hq)
    exact (keep q qsign).trans
      ((input.2.2 q away.1 away.2).trans (workClean q hq))
  have borrowed := InverseTailC.borrowed_eq L hw hn (centerFp X)
    (centerFp_bounds X) u oldCoreRecords ur uy uclean
  have core := InverseTailC.program_correct L hw hn (centerFp X)
    (centerFp_bounds X) u oldCoreRecords ur uy uclean
  have cAway := (OneBankCore5.work_away L hn (base 512) member).1
  have zeroProgram :
      (run (InverseTailC.program L) oldCoreRecords u).basis (base 512) = false :=
    (core.2.2 _ cAway).trans (uclean _ member)
  have cSign : base 512 ≠ L.sign := by decide
  have zeroOld :
      (run (InverseEndpointC.half L) oldCoreRecords s).basis (base 512) = false := by
    rw [InverseEndpointC.half, List.append_assoc, run_append, run_take,
      show measurementCount ([.X L.sign] : Program) = 0 from rfl,
      List.drop_zero]
    have head : run ([.X L.sign] : Program) oldCoreRecords s = u :=
      FifthCarry.no_records ([.X L.sign] : Program) rfl s oldCoreRecords []
    rw [head, run_append, run_take, borrowed]
    simpa [run, writeBit, cSign] using zeroProgram
  rw [recordsDef] at zeroOld
  have padded :
      run (paddedLoan44 L (base 512)) fresh s =
        run (InverseEndpointWires.padded L (base 512)) old s := by
    exact paddedLoan44_run_eq origin workClean X (base 512)
      s fresh old input zeroOld
  simp only [endHalfLoan44, Rolling1588Lifetime.endHalf,
    Bool.false_eq_true, if_false]
  exact padded

private def selectorTail (g flag : Wire) : Program :=
  [.CX flag g, .measureX flag [] [.Z g]]

/-- The selector cleanup tail is record-independent once its temporary host
is zero. -/
theorem selectorTail_independent (g flag : Wire) (hne : g ≠ flag)
    (s : State) (hg : s.basis g = false) (a b : List Bool) :
    run (selectorTail g flag) a s = run (selectorTail g flag) b s := by
  obtain ⟨phase, basis⟩ := s
  simp only at hg
  cases a with
  | nil =>
      cases b with
      | nil => rfl
      | cons bh bs =>
          cases hf : basis flag <;> cases bh <;>
            simp [selectorTail, run, measureAndCorrect, correct, writeBit,
              hg, hf, Function.update, hne]
  | cons ah as =>
      cases b with
      | nil =>
          cases hf : basis flag <;> cases ah <;>
            simp [selectorTail, run, measureAndCorrect, correct, writeBit,
              hg, hf, Function.update, hne]
      | cons bh bs =>
          cases hf : basis flag <;> cases ah <;> cases bh <;>
            simp [selectorTail, run, measureAndCorrect, correct, writeBit,
              hg, hf, Function.update, hne]

/-- Congruence for the selector-loan wrapper at one state.  Unlike the
generic record theorem, this form needs no static source-freedom premise: the
two rebound bodies are already proved equal and restore the temporary host. -/
theorem loanWindow_congr_at (g flag c : Wire) (P Q : Program)
    (s : State) (fresh old : List Bool)
    (middle : ∀ a b,
      run (renameProgram (Equiv.swap c g) P) a
          (run ([.CX g flag, .CX flag g] : Program) [] s) =
        run (renameProgram (Equiv.swap c g) Q) b
          (run ([.CX g flag, .CX flag g] : Program) [] s))
    (hostZero :
      (run (renameProgram (Equiv.swap c g) P) []
        (run ([.CX g flag, .CX flag g] : Program) [] s)).basis g = false)
    (hne : g ≠ flag) :
    run (ControlLoan1589.loanWindow g flag c P) fresh s =
      run (ControlLoan1589.loanWindow g flag c Q) old s := by
  let A : Program := [.CX g flag, .CX flag g]
  let RP := renameProgram (Equiv.swap c g) P
  let RQ := renameProgram (Equiv.swap c g) Q
  let T := selectorTail g flag
  have tail : ∀ a b, run T a (run RP [] (run A [] s)) =
      run T b (run RP [] (run A [] s)) := by
    intro a b
    exact selectorTail_independent g flag hne _ hostZero a b
  have whole := StairLoan.run_sandwich_independent A RP RQ T s fresh old
    rfl middle tail
  simpa only [ControlLoan1589.loanWindow, selectorTail, A, RP, RQ, T,
    List.cons_append, List.nil_append, List.append_assoc] using whole

/-- Lift the multiplication half equality through the selector loan, before
packet placement.  The proof uses only the concrete clean input frame: after
the selector copy both loan hosts are zero, and the old endpoint frame
restores the carry host. -/
theorem rawEndLoan44_false_run_eq (s : State) (fresh old : List Bool)
    (X : Fp) (clean : Q6EndpointCell.Clean base s.basis)
    (flagIn : s.basis (base 2409) = false)
    (rValue : regValue L.r s.basis = centerWord X)
    (yValue : regValue L.y s.basis = centerWord X) :
    run (rawEndLoan44 false) fresh s =
      run (Rolling1588Lifetime.rawEnd false) old s := by
  let g := base 510
  let flag := base 2409
  let c := base 719
  -- LT44 (replay budget): `u` is an opaque state with an equation instead of a `let`, and the
  -- facts about `(run _ [] u).basis _` are transported by rewriting.  With the `let`s the kernel
  -- had to unfold the projection `State.basis` on both sides of a cast and evaluated `run` on
  -- the whole concrete endpoint half (45 s).
  obtain ⟨u, uDef⟩ : ∃ u : State,
      u = run ([.CX g flag, .CX flag g] : Program) [] s := ⟨_, rfl⟩
  have gf : g ≠ flag := by
    simpa only [g, flag] using HostOB5.host_ne 510 2409 (by decide)
  have cg : c ≠ g := by
    simpa only [c, g] using HostOB5.host_ne 719 510 (by decide)
  have cf : c ≠ flag := by
    simpa only [c, flag] using HostOB5.host_ne 719 2409 (by decide)
  have carryMember : c ∈ Q6EndpointCell.workIds.map base :=
    List.mem_map.mpr ⟨719, by
      simp [Q6EndpointCell.workIds, List.mem_range'_1, c], rfl⟩
  have ug : u.basis g = false := by
    have flagZero : s.basis flag = false := by
      simpa only [flag] using flagIn
    simp [uDef, run, writeBit, flagZero, gf, Ne.symm gf]
  have uc : u.basis c = false := by
    have cin : s.basis c = false := clean c carryMember
    simp [uDef, run, writeBit, cin, cg, cf, Ne.symm cg, Ne.symm cf]
  have pull : pullState (Equiv.swap c g) u = u :=
    NewFieldFrameOB5.pull_swap_zero c g u uc ug
  have uclean : Q6EndpointCell.Clean base u.basis := by
    intro q hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
    have qg : base i ≠ g := by
      apply HostOB5.host_ne
      have member := hi
      simp only [Q6EndpointCell.workIds, List.mem_append, List.mem_cons,
        List.not_mem_nil, List.mem_range'_1, or_false] at member
      omega
    have qf : base i ≠ flag := by
      simpa only [flag] using HostOB5.host_ne i 2409 (by
        have bound := Q6EndpointCell.work_bound i hi
        omega)
    simpa [uDef, run, writeBit, qg, qf] using
      clean (base i) (List.mem_map.mpr ⟨i, hi, rfl⟩)
  have flagAway : flag ∉ L.r ∧ flag ∉ L.y := by
    simp only [L, Q6EndpointCell.ports_r, Q6EndpointCell.ports_y]
    exact ⟨OwnPlusHost.not_block 2409 2056 256 (by omega),
      OwnPlusHost.not_block 2409 770 256 (by omega)⟩
  have gAway : g ∉ L.r ∧ g ∉ L.y := by
    simp only [L, Q6EndpointCell.ports_r, Q6EndpointCell.ports_y]
    exact ⟨OwnPlusHost.not_block 510 2056 256 (by omega),
      OwnPlusHost.not_block 510 770 256 (by omega)⟩
  have keep (q : Wire) (qg : q ≠ g) (qf : q ≠ flag) :
      u.basis q = s.basis q := by
    simp [uDef, run, writeBit, qg, qf]
  have ur : regValue L.r u.basis = centerWord X := by
    exact (regValue_congr L.r u.basis s.basis (fun q hq =>
      keep q (fun eq => gAway.1 (eq ▸ hq))
        (fun eq => flagAway.1 (eq ▸ hq)))).trans rValue
  have uy : regValue L.y u.basis = centerWord X := by
    exact (regValue_congr L.y u.basis s.basis (fun q hq =>
      keep q (fun eq => gAway.2 (eq ▸ hq))
        (fun eq => flagAway.2 (eq ▸ hq)))).trans yValue
  have self : PairFrame L.r L.y u.basis (centerWord X) (centerWord X) u.basis :=
    ⟨ur, uy, fun _ _ _ => rfl⟩
  have core : ∀ a b,
      run (endHalfLoan44 false) a u =
        run (Rolling1588Lifetime.endHalf false) b u := by
    intro a b
    exact endHalfLoan44_false_run_eq u.basis uclean X
      u a b self
  have middle : ∀ a b,
      run (renameProgram (Equiv.swap c g)
          (endHalfLoan44 false)) a u =
        run (renameProgram (Equiv.swap c g)
          (Rolling1588Lifetime.endHalf false)) b u := by
    intro a b
    have lifted := StairLoan.renameProgram_run_eq_of (Equiv.swap c g)
      (endHalfLoan44 false)
      (Rolling1588Lifetime.endHalf false) u a b
    rw [pull] at lifted
    exact lifted (core a b)
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have oldHalf := Q6EndpointCell.halfE_frame false base (base 2409) hn
    u.basis uclean X X (fun bad => absurd bad (by decide)) u [] self
  have oldEq := Rolling1588Lifetime.endHalf_run_eq false X X u [] uclean
    self (fun bad => absurd bad (by decide)) (fun _ => rfl)
  have carryAway : c ∉ L.r ∧ c ∉ L.y := by
    simp only [L, Q6EndpointCell.ports_r, Q6EndpointCell.ports_y]
    exact ⟨OwnPlusHost.not_block 719 2056 256 (by omega),
      OwnPlusHost.not_block 719 770 256 (by omega)⟩
  have oldCarry :
      (run (Rolling1588Lifetime.endHalf false) [] u).basis c = false := by
    rw [oldEq]
    exact (oldHalf.2.2.2 c carryAway.1 carryAway.2).trans
      (uclean c carryMember)
  have newCarry :
      (run (endHalfLoan44 false) [] u).basis c = false := by
    rw [core [] []]
    exact oldCarry
  have hostZero :
      (run (renameProgram (Equiv.swap c g)
        (endHalfLoan44 false)) [] u).basis g = false := by
    have renamed := ECDSAAdd.run_rename (Equiv.swap c g)
      (Equiv.swap c g).injective (endHalfLoan44 false) [] u
    rw [pull] at renamed
    have atCarry := congrFun (congrArg State.basis renamed) c
    have pulled : ∀ (f : Wire → Wire) (st : State) (q : Wire),
        (pullState f st).basis q = st.basis (f q) := fun _ _ _ => rfl
    rw [pulled, Equiv.swap_apply_left] at atCarry
    exact atCarry.trans newCarry
  have middle' : ∀ a b,
      run (renameProgram (Equiv.swap c g)
          (endHalfLoan44 false)) a
          (run ([.CX g flag, .CX flag g] : Program) [] s) =
        run (renameProgram (Equiv.swap c g)
          (Rolling1588Lifetime.endHalf false)) b
          (run ([.CX g flag, .CX flag g] : Program) [] s) := by
    rw [← uDef]
    exact middle
  have hostZero' :
      (run (renameProgram (Equiv.swap c g)
        (endHalfLoan44 false)) []
        (run ([.CX g flag, .CX flag g] : Program) [] s)).basis g = false := by
    rw [← uDef]
    exact hostZero
  change run (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
      (endHalfLoan44 false)) fresh s =
    run (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
      (Rolling1588Lifetime.endHalf false)) old s
  exact @loanWindow_congr_at g flag c (endHalfLoan44 false)
    (Rolling1588Lifetime.endHalf false) s fresh old middle' hostZero' gf

private theorem history_support_away (P : Program)
    (support : wires P ⊆
      (wireBlock base 0 512 ++ wireBlock base 1028 512).toFinset)
    (i : Nat) (low : 512 ≤ i) (high : i < 1028 ∨ 1540 ≤ i) :
    base i ∉ wires P := by
  intro used
  have member := List.mem_toFinset.mp (support used)
  rcases List.mem_append.mp member with member | member
  · exact OwnPlusHost.not_block i 0 512 (by omega) member
  · exact OwnPlusHost.not_block i 1028 512 (by omega) member

private theorem encoded_raw_inputs (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X : Fp) (s : State)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X X s) :
    Q6EndpointCell.Clean base s.basis ∧
      s.basis (base 2409) = false ∧
      regValue L.r s.basis = centerWord X ∧
      regValue L.y s.basis = centerWord X := by
  obtain ⟨raw, _, pair, encoded⟩ := input
  let E := Rolling1588.allEncode base isA 102
  have support : wires E ⊆
      (wireBlock base 0 512 ++ wireBlock base 1028 512).toFinset := by
    exact Rolling1588.allEncode_history_support base isA 102 (by decide)
  have encoderAway (i : Nat) (low : 512 ≤ i)
      (high : i < 1028 ∨ 1540 ≤ i) : base i ∉ wires E := by
    exact history_support_away E support i low high
  have rAway : ∀ q ∈ L.r, q ∉ wires E := by
    intro q hq
    rw [L, Q6EndpointCell.ports_r, balancedSharedPorts_r] at hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hi
    exact encoderAway i (by omega) (by omega)
  have yAway : ∀ q ∈ L.y, q ∉ wires E := by
    intro q hq
    rw [L, Q6EndpointCell.ports_y, balancedSharedPorts_y] at hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hi
    exact encoderAway i (by omega) (by omega)
  have rawR : regValue L.r raw.basis = centerWord X := pair.1
  have rawY : regValue L.y raw.basis = centerWord X := pair.2.1
  have rValue : regValue L.r s.basis = centerWord X := by
    rw [encoded]
    exact (regValue_congr L.r (run E [] raw).basis raw.basis
      (fun q hq => run_preserves_outside E [] raw q (rAway q hq))).trans rawR
  have yValue : regValue L.y s.basis = centerWord X := by
    rw [encoded]
    exact (regValue_congr L.y (run E [] raw).basis raw.basis
      (fun q hq => run_preserves_outside E [] raw q (yAway q hq))).trans rawY
  have originClean : Q6EndpointCell.Clean base origin :=
    Q6EndpointCell.clean_of_env base origin ctx.env ctx.parity
  have clean : Q6EndpointCell.Clean base s.basis := by
    intro q hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
    have member := hi
    simp only [Q6EndpointCell.workIds, List.mem_append, List.mem_cons,
      List.not_mem_nil, List.mem_range'_1, or_false] at member
    have awayE : base i ∉ wires E := encoderAway i (by omega) (by omega)
    have away := Rolling1588Lifetime.half_work_away (base i)
      (List.mem_map.mpr ⟨i, hi, rfl⟩)
    rw [encoded, run_preserves_outside E [] raw (base i) awayE]
    exact (pair.2.2 (base i) away.1 away.2).trans
      (originClean (base i) (List.mem_map.mpr ⟨i, hi, rfl⟩))
  have flagRaw : raw.basis (base 2409) = false :=
    (pair.2.2 (base 2409) Rolling1588Lifetime.half_flag_away.1
      Rolling1588Lifetime.half_flag_away.2).trans ctx.hg0
  have flagIn : s.basis (base 2409) = false := by
    rw [encoded, run_preserves_outside E [] raw (base 2409)
      (encoderAway 2409 (by omega) (by omega))]
    exact flagRaw
  exact ⟨clean, flagIn, rValue, yValue⟩

/-- Packet-placement replay for the multiplication endpoint. -/
theorem endPacketLoan44_false_run_eq (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X : Fp) (s : State)
    (fresh old : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X X s) :
    run (endPacketLoan44 false) fresh s =
      run (Rolling1588Lifetime.endPacket false) old s := by
  obtain ⟨clean, flagIn, rValue, yValue⟩ :=
    encoded_raw_inputs isA origin ctx X s input
  have rawEq := rawEndLoan44_false_run_eq s fresh old X
    clean flagIn rValue yValue
  have inputZero := Rolling1588.encoded_zero_region base (base 2409) isA
    ctx.hn (ctx.hp _ (by simp)) origin ctx.env ctx.legal X X s input
  have pull := Placement5.shifted_zero_boundary Placement5.pi0
    Placement5.pi0_outside s inputZero
  have lifted := StairLoan.renameProgram_run_eq_of (shifted Placement5.pi0)
    (rawEndLoan44 false) (Rolling1588Lifetime.rawEnd false)
    s fresh old
  rw [pull] at lifted
  exact lifted rawEq

/-- The complete multiplication endpoint equality, including packet
placement and the final `760`-to-`717` retirement swap. -/
theorem endPacket760Loan44_false_run_eq (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X : Fp) (s : State)
    (fresh old : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X X s) :
    run (endPacket760Loan44 false) fresh s =
      run (R2SqEp760.endPacket760 false) old s := by
  have placed := endPacketLoan44_false_run_eq isA origin ctx X s fresh old input
  have oldFrame := (Rolling1588Lifetime.endPacket_frame isA false origin ctx enabled
    X X (fun bad => absurd bad (by decide)) (fun _ => rfl) s old input).2
  have before760 := R2SqEp760.encoded5_760 origin ctx X X s input
  have before717 := R2SqEp760.encoded5_717 origin ctx X X s input
  have after760 :
      (run (endPacketLoan44 false) fresh s).basis (base 760) = false := by
    rw [placed]
    exact R2SqEp760.encoded5_760 origin ctx _ _ _ oldFrame
  have after717 :
      (run (endPacketLoan44 false) fresh s).basis (base 717) = false := by
    rw [placed]
    exact R2SqEp760.encoded5_717 origin ctx _ _ _ oldFrame
  have freshSwap := R2SqEp760.swap_run_eq (base 760) (base 717)
    (endPacketLoan44 false) s fresh before760 before717
    after760 after717
  have oldSwap := R2SqEp760.endPacket760_run_eq isA false origin ctx enabled X X
    (fun bad => absurd bad (by decide)) (fun _ => rfl) s old input
  calc
    run (endPacket760Loan44 false) fresh s =
        run (endPacketLoan44 false) fresh s := freshSwap
    _ = run (Rolling1588Lifetime.endPacket false) old s := placed
    _ = run (R2SqEp760.endPacket760 false) old s := oldSwap.symm


/-! ## Physicality -/

theorem tailBorrowedLoan44_physical (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (tailBorrowedLoan44 L) := by
  exact gatePhysical_rename _ (InverseTailC.borrowSwap L).injective _
    (tailProgramLoan44_physical L hw hn)

theorem halfLoan44_physical (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (halfLoan44 L) := by
  have sign : GatePhysical ([.X L.sign] : Program) := by
    simp [GatePhysical, PhysicalInstr, ProperGate]
  simp only [halfLoan44, gatePhysical_append]
  exact ⟨⟨sign, tailBorrowedLoan44_physical L hw hn⟩, sign⟩

theorem paddedLoan44_physical (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) (c : Wire) :
    GatePhysical (paddedLoan44 L c) := by
  simp only [paddedLoan44, gatePhysical_append]
  exact ⟨halfLoan44_physical L hw hn,
    (InverseEndpointWires.pad_facts 256 c).2.2.2.2⟩






/-! ## Certificate-facing statements -/

/-- Field-6 replay for the 44-site endpoint.  Hypotheses: exactly those of
`R2SqEp760.endPacket760_run_eq isA false` (its `hend` premise is vacuous for
`divide = false`, `hX` is `X = Y`); the two tapes are independent. -/
theorem endPacket760Loan44_run_eq (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400) = true)
    (X Y : Fp) (hX : X = Y) (s : State) (m n : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X Y s) :
    run (endPacket760Loan44 false) m s = run (R2SqEp760.endPacket760 false) n s := by
  subst hX
  exact endPacket760Loan44_false_run_eq isA origin ctx enabled X s m n input






end ECDSAAdd.Entrant.StairEndpointLoan44
end Merge_StairEndpointLoan44_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairEndpointLoan44Avoid_at_QTop` -/
section Merge_StairEndpointLoan44Avoid_at_QTop

/-!
# Static avoidance of the 44 exclusive retired sites by `endPacket760Loan44 false`

A Boolean gate scan `progFree` (sound for `wires`).  LT45: the scan is no longer
evaluated on the complete placed endpoint program, only on its small unchanged blocks;
the loaned sweeps are handled structurally (section `Structural`).
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 12000000

namespace ECDSAAdd.Entrant.StairEndpointLoan44

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

/-! ## Static avoidance of the 44 exclusive sites (kernel-checked) -/

def corrFree (qs : List Wire) : List Correction → Bool
  | [] => true
  | .Z t :: cs => !(qs.contains t) && corrFree qs cs
  | .CZ a b :: cs => !(qs.contains a) && !(qs.contains b) && corrFree qs cs

def instrFree (qs : List Wire) : Instr → Bool
  | .X t => !(qs.contains t)
  | .CX a b => !(qs.contains a) && !(qs.contains b)
  | .CCX a b c => !(qs.contains a) && !(qs.contains b) && !(qs.contains c)
  | .measureX t z o => !(qs.contains t) && corrFree qs z && corrFree qs o

def progFree (qs : List Wire) (P : Program) : Bool := P.all (instrFree qs)

private theorem not_contains {qs : List Wire} {q t : Wire} (h : (!(qs.contains t)) = true)
    (hq : q ∈ qs) : q ≠ t := by
  intro e
  subst e
  have hc : qs.contains q = true := List.contains_iff_mem.mpr hq
  rw [hc] at h
  exact absurd h (by decide)

theorem corrFree_sound (qs : List Wire) (cs : List Correction)
    (h : corrFree qs cs = true) : ∀ q ∈ qs, q ∉ correctionWires cs := by
  induction cs with
  | nil => intro q _ hq; simp [correctionWires] at hq
  | cons c cs ih =>
      intro q hq used
      cases c with
      | Z t =>
          simp only [corrFree, Bool.and_eq_true] at h
          simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at used
          rcases used with e | used
          · exact not_contains h.1 hq e
          · exact ih h.2 q hq used
      | CZ a b =>
          simp only [corrFree, Bool.and_eq_true] at h
          simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
            Finset.mem_singleton] at used
          rcases used with (e | e) | used
          · exact not_contains h.1.1 hq e
          · exact not_contains h.1.2 hq e
          · exact ih h.2 q hq used

theorem instrFree_sound (qs : List Wire) (i : Instr) (h : instrFree qs i = true) :
    ∀ q ∈ qs, q ∉ i.wires := by
  intro q hq used
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at used
      exact not_contains h hq used
  | CX a b =>
      simp only [instrFree, Bool.and_eq_true] at h
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at used
      rcases used with e | e
      · exact not_contains h.1 hq e
      · exact not_contains h.2 hq e
  | CCX a b c =>
      simp only [instrFree, Bool.and_eq_true] at h
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at used
      rcases used with e | e | e
      · exact not_contains h.1.1 hq e
      · exact not_contains h.1.2 hq e
      · exact not_contains h.2 hq e
  | measureX t z o =>
      simp only [instrFree, Bool.and_eq_true] at h
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at used
      rcases used with (e | used) | used
      · exact not_contains h.1.1 hq e
      · exact corrFree_sound qs z h.1.2 q hq used
      · exact corrFree_sound qs o h.2 q hq used

theorem progFree_sound (qs : List Wire) (P : Program) (h : progFree qs P = true) :
    ∀ q ∈ qs, q ∉ wires P := by
  induction P with
  | nil => intro q _ hq; simp [wires] at hq
  | cons i P ih =>
      simp only [progFree, List.all_cons, Bool.and_eq_true] at h
      intro q hq used
      simp only [wires, Finset.mem_union] at used
      rcases used with used | used
      · exact instrFree_sound qs i h.1 q hq used
      · exact ih h.2 q hq used

/-! ## LT45 (replay budget): structural avoidance of the 44 exclusive sites

The kernel used to scan the complete placed endpoint (11,624 instructions, 99 s).
Now only the unchanged small blocks and the first 45 layers of the controlled
comparison are scanned; the three loaned sweeps use LT9's support lemmas
(`mappedAddLoan_support_exact_lift`, `mappedSubLoan_support_exact_lift`,
`emitLoan_support_erase` with `ctl_upper_sweep` / `compareChain_wires`), and the
wrappers (`borrowSwap`, the selector window, `pi0`, the `760 ↔ 717` swap) fix the 44
sites. -/

section Structural

open StairLoan

/-- The 44 exclusive retired sites. -/
def avoidL : List Wire := (List.range' 720 40 ++ List.range' 761 4).map base

/-- No instruction of `P` touches one of the 44 sites. -/
def Free (P : Program) : Prop := ∀ q ∈ avoidL, q ∉ wires P

attribute [local irreducible] ECDSAAdd.wires

theorem free_append {P Q : Program} : Free (P ++ Q) ↔ Free P ∧ Free Q := by
  unfold Free
  constructor
  · intro h
    exact ⟨fun q hq u => h q hq (by rw [wires_append]; exact Finset.mem_union_left _ u),
      fun q hq u => h q hq (by rw [wires_append]; exact Finset.mem_union_right _ u)⟩
  · intro h q hq u
    rw [wires_append, Finset.mem_union] at u
    rcases u with u | u
    · exact h.1 q hq u
    · exact h.2 q hq u

theorem free_rename (f : Equiv.Perm Wire) (fix : ∀ q ∈ avoidL, f q = q) {P : Program}
    (h : Free P) : Free (renameProgram f P) := by
  intro q hq used
  rw [renameProgram_support] at used
  obtain ⟨a, ha, e⟩ := Finset.mem_image.mp used
  have same : a = q := f.injective (e.trans (fix q hq).symm)
  exact h q hq (same ▸ ha)

theorem roles44_take44 : roles44.take 44 = avoidL := by decide +kernel

/-- Disjointness of two lists from a separating predicate (linear checks). -/
theorem disj_of (p : Wire → Bool) (A B : List Wire) (hA : A.all p = true)
    (hB : B.all (fun q => !p q) = true) : ∀ q ∈ A, q ∉ B := by
  intro q hq hb
  have a := List.all_eq_true.mp hA q hq
  have b := List.all_eq_true.mp hB q hb
  rw [a] at b
  exact absurd b (by decide)

/-- The 44 sites as an interval test. -/
def roleB (q : Wire) : Bool :=
  (decide (736 ≤ q) && decide (q < 776)) || (decide (777 ≤ q) && decide (q < 781))

/-- The 44 low carry hosts as an interval test. -/
def hostB (q : Wire) : Bool := decide (528 ≤ q) && decide (q < 572)

/-- The `y` register as an interval test. -/
def yB (q : Wire) : Bool := decide (786 ≤ q) && decide (q < 1042)

theorem avoidL_roleB : avoidL.all roleB = true := by decide +kernel

/-! K4-A (replay budget): `progFree avoidL` with the interval test `roleB` in place of the
44-element `List.contains` (one bound check per wire instead of a 44-element walk). -/

theorem mem_avoidL_k4a (q : Nat) : q ∈ avoidL ↔ (736 ≤ q ∧ q < 776) ∨ (777 ≤ q ∧ q < 781) := by
  unfold avoidL
  rw [List.mem_map]
  constructor
  · rintro ⟨i, hi, rfl⟩
    rw [List.mem_append, List.mem_range'_1, List.mem_range'_1] at hi
    simp only [base]
    omega
  · intro h
    refine ⟨q - 16, ?_, ?_⟩
    · rw [List.mem_append, List.mem_range'_1, List.mem_range'_1]
      omega
    · simp only [base]
      omega

theorem avoidL_contains_k4a (q : Wire) : avoidL.contains q = roleB q := by
  rw [Bool.eq_iff_iff, List.contains_iff_mem, mem_avoidL_k4a]
  simp only [roleB, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq]

def corrFreeR_k4a : List Correction → Bool
  | [] => true
  | .Z t :: cs => !(roleB t) && corrFreeR_k4a cs
  | .CZ a b :: cs => !(roleB a) && !(roleB b) && corrFreeR_k4a cs

def instrFreeR_k4a : Instr → Bool
  | .X t => !(roleB t)
  | .CX a b => !(roleB a) && !(roleB b)
  | .CCX a b c => !(roleB a) && !(roleB b) && !(roleB c)
  | .measureX t z o => !(roleB t) && corrFreeR_k4a z && corrFreeR_k4a o

theorem corrFree_avoidL_k4a (cs : List Correction) : corrFree avoidL cs = corrFreeR_k4a cs := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
      cases c <;> simp only [corrFree, corrFreeR_k4a, avoidL_contains_k4a, ih]

theorem progFree_avoidL_k4a (P : Program) : progFree avoidL P = P.all instrFreeR_k4a := by
  unfold progFree
  congr 1
  funext i
  cases i <;> simp only [instrFree, instrFreeR_k4a, avoidL_contains_k4a, corrFree_avoidL_k4a]

/-- The register blocks of `InverseTailC.prep` touch only their registers. -/
theorem copyRegister_allR_k4a : ∀ (a b : List Wire), a.all (fun q => !roleB q) = true →
    b.all (fun q => !roleB q) = true → (copyRegister none a b).all instrFreeR_k4a = true
  | [], _, _, _ => rfl
  | _ :: _, [], _, _ => rfl
  | x :: a, y :: b, ha, hb => by
    simp only [List.all_cons, Bool.and_eq_true] at ha hb
    simp only [copyRegister, List.all_append, copyRegister_allR_k4a a b ha.2 hb.2, copyGate,
      List.all_cons, List.all_nil, instrFreeR_k4a, ha.1, hb.1, Bool.and_self]

theorem signComplement_allR_k4a (c : Wire) (hc : roleB c = false) (x : List Wire)
    (h : x.all (fun q => !roleB q) = true) : (signComplement c x).all instrFreeR_k4a = true := by
  rw [List.all_eq_true]
  intro i hi
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hi
  have hw' := List.all_eq_true.mp h w hw
  simp only [instrFreeR_k4a, hc, hw', Bool.not_false, Bool.and_self]

theorem notRegister_allR_k4a (r : List Wire) (h : r.all (fun q => !roleB q) = true) :
    (notRegister r).all instrFreeR_k4a = true := by
  rw [List.all_eq_true]
  intro i hi
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hi
  exact List.all_eq_true.mp h w hw

theorem xorConstant_allR_k4a : ∀ (r : List Wire) (k : Nat), r.all (fun q => !roleB q) = true →
    (xorConstant r k).all instrFreeR_k4a = true
  | [], _, _ => rfl
  | w :: r, k, h => by
    simp only [List.all_cons, Bool.and_eq_true] at h
    simp only [xorConstant, List.all_append, xorConstant_allR_k4a r (k / 2) h.2, Bool.and_true]
    split
    · simp only [List.all_cons, List.all_nil, instrFreeR_k4a, h.1, Bool.and_self]
    · rfl

theorem maskedConstant_allR_k4a (c : Wire) (hc : roleB c = false) :
    ∀ (r : List Wire) (k : Nat), r.all (fun q => !roleB q) = true →
      (maskedConstant c r k).all instrFreeR_k4a = true
  | [], _, _ => rfl
  | w :: r, k, h => by
    simp only [List.all_cons, Bool.and_eq_true] at h
    simp only [maskedConstant, List.all_append, maskedConstant_allR_k4a c hc r (k / 2) h.2,
      Bool.and_true]
    split
    · simp only [List.all_cons, List.all_nil, instrFreeR_k4a, hc, h.1, Bool.not_false,
        Bool.and_self]
    · rfl

theorem prep_allR_k4a : (InverseTailC.prep endpointL).all instrFreeR_k4a = true := by
  have h1 := copyRegister_allR_k4a endpointL.y endpointL.r (by decide +kernel) (by decide +kernel)
  have h2 := signComplement_allR_k4a endpointL.ymsb (by decide +kernel) endpointL.ylow
    (by decide +kernel)
  have h3 := xorConstant_allR_k4a endpointL.low (InverseTailC.third + 1) (by decide +kernel)
  have h4 := maskedConstant_allR_k4a endpointL.ymsb (by decide +kernel) endpointL.low
    ((InverseTailC.third + 1) ^^^ InverseTailC.third) (by decide +kernel)
  simp only [InverseTailC.prep, List.all_append, h1, h2, h3, h4, Bool.and_self]

/-- `rotateLeft` touches only its register (no evaluation of the nested appends). -/
theorem rotateLeft_allR_k4a : ∀ r : List Wire, r.all (fun q => !roleB q) = true →
    (rotateLeft r).all instrFreeR_k4a = true
  | [], _ => rfl
  | [_], _ => rfl
  | a :: b :: bs, h => by
    simp only [List.all_cons, Bool.and_eq_true, Bool.not_eq_true'] at h
    have t : (b :: bs).all (fun q => !roleB q) = true := by
      simp only [List.all_cons, Bool.and_eq_true, Bool.not_eq_true']
      exact h.2
    rw [rotateLeft, List.all_append, rotateLeft_allR_k4a (b :: bs) t]
    simp only [swapBits, List.all_cons, List.all_nil, instrFreeR_k4a, h.1, h.2.1, Bool.not_false,
      Bool.and_self]


theorem hosts_hostB : ((endpointL.carry.take 255).take 44).all hostB = true := by
  decide +kernel

theorem endpointL_nodup : endpointL.wires.Nodup :=
  Q6EndpointCell.ports_nodup_injective base (base 2409) base_injective (by
    intro member
    obtain ⟨i, hi, eq⟩ := List.mem_map.mp member
    have same := base_injective eq
    have bound := Q6EndpointCell.ids_bound i hi
    omega)

/-- The data and carry registers of the two mapped sweeps are duplicate free (from the
layout's `Nodup`, no evaluation). -/
theorem data_nodup_of (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    (L.sign :: (L.r ++ L.carry.take 255)).Nodup ∧
      (L.one :: (L.r ++ L.carry.take 255)).Nodup := by
  constructor <;>
  · apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    have t := List.Sublist.count_le q (List.take_sublist 255 L.carry)
    simp only [BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires,
      BalancedCleanup.Layout.r, BalancedCleanup.Layout.low, List.count_cons,
      List.count_append, List.count_nil] at h ⊢
    omega

theorem banks_nodup : (avoidL ++ (endpointL.carry.take 255).take 44).Nodup :=
  StairLoan.nodup_of_mask _ (by decide +kernel)

theorem data_tab :
    (endpointL.r ++ endpointL.carry.take 255).all (fun q =>
      !yB q && !decide (q = endpointL.sign) && !decide (q = endpointL.one) &&
        !decide (q = endpointL.parity)) = true ∧
    (mappedWires (mappedRead endpointL.y false)).all yB = true ∧
    (mappedWires (mappedConstant (some endpointL.parity) 256 p)).all
      (fun q => decide (q = endpointL.parity)) = true ∧
    yB endpointL.sign = false ∧ endpointL.one ≠ endpointL.parity ∧
    endpointL.r.all (fun q => !roleB q) = true ∧
    (mappedWires ((mappedRead endpointL.y false).take 45) ++ endpointL.r.take 45 ++
      (endpointL.carry.take 255).take 45 ++ [endpointL.sign]).all (fun q => !roleB q) = true ∧
    (mappedWires ((mappedConstant (some endpointL.parity) 256 p).take 45) ++
      endpointL.r.take 45 ++ (endpointL.carry.take 255).take 45 ++
        [endpointL.one]).all (fun q => !roleB q) = true := by
  decide +kernel

theorem raw_nd : (endpointL.sign :: (endpointL.r ++ endpointL.carry.take 255)).Nodup :=
  (data_nodup_of endpointL endpointL_nodup).1

theorem corr_nd : (endpointL.one :: (endpointL.r ++ endpointL.carry.take 255)).Nodup :=
  (data_nodup_of endpointL endpointL_nodup).2

theorem raw_away : ∀ q ∈ mappedWires (mappedRead endpointL.y false),
    q ∉ endpointL.sign :: (endpointL.r ++ endpointL.carry.take 255) := by
  intro q hq m
  have hy := List.all_eq_true.mp data_tab.2.1 q hq
  rcases List.mem_cons.mp m with e | m
  · rw [e, data_tab.2.2.2.1] at hy
    exact absurd hy (by decide)
  · have t := List.all_eq_true.mp data_tab.1 q m
    simp [hy] at t

theorem corr_away : ∀ q ∈ mappedWires (mappedConstant (some endpointL.parity) 256 p),
    q ∉ endpointL.one :: (endpointL.r ++ endpointL.carry.take 255) := by
  intro q hq m
  have hy : q = endpointL.parity :=
    of_decide_eq_true (List.all_eq_true.mp data_tab.2.2.1 q hq)
  rcases List.mem_cons.mp m with e | m
  · exact data_tab.2.2.2.2.1 (e.symm.trans hy)
  · have t := List.all_eq_true.mp data_tab.1 q m
    simp [hy] at t

theorem free_of_sdiff {P : Program} {S : Finset Wire}
    (h : wires P ⊆ S \ (roles44.take 44).toFinset) : Free P := by
  intro q hq used
  have t := (Finset.mem_sdiff.mp (h used)).2
  rw [roles44_take44] at t
  exact t (List.mem_toFinset.mpr hq)

theorem rawSweep_free : Free (mappedAddLoan 44 roles44 (mappedRead endpointL.y false)
    endpointL.r (endpointL.carry.take 255) endpointL.sign) := by
  apply free_of_sdiff
  apply StairLoanSupport.mappedAddLoan_support_exact_lift 44 roles44
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · exact raw_nd
  · exact raw_away
  · rw [roles44_take44]
    exact banks_nodup
  · rw [roles44_take44]
    intro r hr m
    exact disj_of roleB _ _ avoidL_roleB data_tab.2.2.2.2.2.2.1 r hr (List.mem_toFinset.mp m)

theorem corrSweep_free : Free (mappedSubLoan 44 roles44
    (mappedConstant (some endpointL.parity) 256 p) endpointL.r (endpointL.carry.take 255)
    endpointL.one) := by
  apply free_of_sdiff
  apply StairLoanSupport.mappedSubLoan_support_exact_lift 44 roles44
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · exact corr_nd
  · exact corr_away
  · rw [roles44_take44]
    exact banks_nodup
  · rw [roles44_take44]
    intro r hr m
    exact disj_of roleB _ _ avoidL_roleB data_tab.2.2.2.2.2.2.2 r hr (List.mem_toFinset.mp m)
  · rw [roles44_take44]
    exact disj_of roleB _ _ avoidL_roleB data_tab.2.2.2.2.2.1

/-- The first 45 layers of the controlled comparison (all that is not rebound). -/
theorem ctl_outside_check :
    progFree avoidL
      (emitUps ((ctlLayers endpointL.ylow endpointL.low (endpointL.carry.take 255)
          endpointL.one).take (44 + 1)) ++
        emitErases ((ctlLayers endpointL.ylow endpointL.low (endpointL.carry.take 255)
          endpointL.one).take 44) ++
        emitUps ((ctlLayers endpointL.ylow endpointL.low (endpointL.carry.take 255)
          endpointL.one).take 44) ++
        emitDowns ((ctlLayers endpointL.ylow endpointL.low (endpointL.carry.take 255)
          endpointL.one).take (44 + 1))) = true := by
  rw [progFree_avoidL_k4a]
  decide +kernel

/-- The upper comparison chain does not touch the 44 hosts. -/
theorem ctl_upper_tab :
    ((some endpointL.sign).toList ++ endpointL.parity ::
      carryAfter (44 + 1) (endpointL.carry.take 255) endpointL.one ::
        (endpointL.ylow.drop (44 + 1) ++ endpointL.low.drop (44 + 1) ++
          (endpointL.carry.take 255).drop (44 + 1))).all (fun q => !hostB q) = true := by
  decide +kernel

theorem ctlSweep_free : Free (ctlLoan 44 roles44 (some endpointL.sign) endpointL.ylow
    endpointL.low (endpointL.carry.take 255) endpointL.one endpointL.parity) := by
  have hab : endpointL.ylow.length = endpointL.low.length := by decide +kernel
  have hc : (endpointL.carry.take 255).length = endpointL.low.length := by decide +kernel
  have hosts := (ctl_prefix_shapes 44 endpointL.ylow endpointL.low (endpointL.carry.take 255)
    endpointL.one hab hc (by decide +kernel)).2.2
  have sup := StairLoanSupport.emitLoan_support_erase 44 roles44
    (ctlLayers endpointL.ylow endpointL.low (endpointL.carry.take 255) endpointL.one)
    (ctlTop (some endpointL.sign) endpointL.parity endpointL.ylow endpointL.low
      (endpointL.carry.take 255) endpointL.one)
    (by rw [hosts, roles44_take44]; decide +kernel)
    (by rw [hosts, roles44_take44]; exact banks_nodup)
    (by
      rw [hosts]
      intro h hh used
      rw [ctl_upper_sweep (44 + 1) _ _ _ _ _ _ hab hc (by decide +kernel),
        compareChain_wires _ _ _ _ _ _ (by decide +kernel) (by decide +kernel)] at used
      exact disj_of hostB _ _ hosts_hostB ctl_upper_tab h hh (List.mem_toFinset.mp used))
    (by rw [roles44_take44]; exact progFree_sound _ _ ctl_outside_check)
  intro q hq used
  rcases Finset.mem_union.mp (sup used) with h | h
  · rw [roles44_take44] at h
    exact (Finset.mem_sdiff.mp h).2 (List.mem_toFinset.mpr hq)
  · rw [hosts] at h
    exact (List.disjoint_left.mp (List.nodup_append'.mp banks_nodup).2.2 hq)
      (List.mem_toFinset.mp h)

/-- The unchanged blocks and the wrapper gates (small programs). -/
theorem static_check :
    (progFree avoidL (InverseTailC.prep endpointL) &&
      progFree avoidL (InverseTailC.prep endpointL).reverse &&
      progFree avoidL (notRegister (endpointL.one :: endpointL.low)) &&
      progFree avoidL [.CX endpointL.sign endpointL.parity] &&
      progFree avoidL (InverseTailC.double endpointL) &&
      progFree avoidL [.X endpointL.sign] &&
      progFree avoidL (signComplement endpointL.sign endpointL.y) &&
      progFree avoidL (signComplement endpointL.ymsb endpointL.r) &&
      progFree avoidL [.CX endpointL.r0 endpointL.parity,
        .CX (endpointL.ylow.headD endpointL.ymsb) endpointL.parity] &&
      progFree avoidL (List.replicate 256 (Instr.measureX (base 512) [] [])) &&
      progFree avoidL [.CX (base 510) (base 2409), .CX (base 2409) (base 510)] &&
      progFree avoidL [.CX (base 2409) (base 510),
        .measureX (base 2409) [] [.Z (base 510)]]) = true := by
  have hd : (InverseTailC.double endpointL).all instrFreeR_k4a = true := by
    rw [InverseTailC.double, List.all_append, rotateLeft_allR_k4a _ (by decide +kernel)]
    decide +kernel
  have hn := notRegister_allR_k4a (endpointL.one :: endpointL.low) (by decide +kernel)
  have hs1 := signComplement_allR_k4a endpointL.sign (by decide +kernel) endpointL.y
    (by decide +kernel)
  have hs2 := signComplement_allR_k4a endpointL.ymsb (by decide +kernel) endpointL.r
    (by decide +kernel)
  simp only [progFree_avoidL_k4a, List.all_reverse, prep_allR_k4a, hd, hn, hs1, hs2,
    Bool.and_true, Bool.true_and]
  decide +kernel

theorem fix_tab : avoidL.all (fun t =>
    decide (InverseTailC.borrowSwap endpointL t = t) &&
      decide (Equiv.swap (base 719) (base 510) t = t) &&
      decide (shifted Placement5.pi0 t = t) &&
      decide (Equiv.swap (base 760) (base 717) t = t)) = true := by
  decide +kernel

theorem tailProgramLoan44_free : Free (tailProgramLoan44 endpointL) := by
  have s := static_check
  simp only [Bool.and_eq_true] at s
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨s1, s2⟩, s3⟩, s4⟩, s5⟩, s6⟩, s7⟩, s8⟩, s9⟩, _⟩, _⟩, _⟩ := s
  have f1 : Free (InverseTailC.prep endpointL) := progFree_sound _ _ s1
  have f2 : Free (InverseTailC.prep endpointL).reverse := progFree_sound _ _ s2
  have f3 : Free (notRegister (endpointL.one :: endpointL.low)) := progFree_sound _ _ s3
  have f4 : Free [Instr.CX endpointL.sign endpointL.parity] := progFree_sound _ _ s4
  have f5 : Free (InverseTailC.double endpointL) := progFree_sound _ _ s5
  have f6 : Free [Instr.X endpointL.sign] := progFree_sound _ _ s6
  have f7 : Free (signComplement endpointL.sign endpointL.y) := progFree_sound _ _ s7
  have f8 : Free (signComplement endpointL.ymsb endpointL.r) := progFree_sound _ _ s8
  have f9 : Free [Instr.CX endpointL.r0 endpointL.parity,
      Instr.CX (endpointL.ylow.headD endpointL.ymsb) endpointL.parity] :=
    progFree_sound _ _ s9
  simp only [tailProgramLoan44, decisionLoan44, compareLtLoan44, rawLoan44, signedAddLoan44,
    correctionLoan44, free_append]
  exact ⟨⟨⟨⟨⟨⟨f1, ⟨f3, ctlSweep_free⟩, f3⟩, f4⟩, f2⟩,
    ⟨⟨f5, f6⟩, ⟨f7, rawSweep_free⟩, f7⟩, f6⟩, ⟨f8, corrSweep_free⟩, f8⟩, f9⟩

theorem endPacket760Loan44_freeS : Free (endPacket760Loan44 false) := by
  have s := static_check
  simp only [Bool.and_eq_true] at s
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨_, _⟩, _⟩, _⟩, _⟩, s6⟩, _⟩, _⟩, _⟩, s10⟩, s11⟩, s12⟩ := s
  have fx : ∀ t ∈ avoidL, InverseTailC.borrowSwap endpointL t = t ∧
      Equiv.swap (base 719) (base 510) t = t ∧ shifted Placement5.pi0 t = t ∧
        Equiv.swap (base 760) (base 717) t = t := by
    intro t ht
    have h := List.all_eq_true.mp fix_tab t ht
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2⟩
  have x : Free [Instr.X endpointL.sign] := progFree_sound _ _ s6
  have pad : Free (List.replicate 256 (Instr.measureX (base 512) [] [])) :=
    progFree_sound _ _ s10
  have pre : Free [Instr.CX (base 510) (base 2409), Instr.CX (base 2409) (base 510)] :=
    progFree_sound _ _ s11
  have post : Free [Instr.CX (base 2409) (base 510),
      Instr.measureX (base 2409) [] [Correction.Z (base 510)]] := progFree_sound _ _ s12
  have half : Free (endHalfLoan44 false) := by
    have e : endHalfLoan44 false = paddedLoan44 endpointL (base 512) := rfl
    rw [e, paddedLoan44, halfLoan44, tailBorrowedLoan44]
    simp only [free_append]
    exact ⟨⟨⟨x, free_rename _ (fun t ht => (fx t ht).1) tailProgramLoan44_free⟩, x⟩, pad⟩
  have raw : Free (rawEndLoan44 false) := by
    rw [rawEndLoan44, ControlLoan1589.loanWindow]
    simp only [free_append]
    exact ⟨⟨pre, free_rename _ (fun t ht => (fx t ht).2.1) half⟩, post⟩
  rw [endPacket760Loan44, endPacketLoan44]
  exact free_rename _ (fun t ht => (fx t ht).2.2.2)
    (free_rename _ (fun t ht => (fx t ht).2.2.1) raw)

end Structural

/-- No gate of the 44-site endpoint touches an exclusive retired site
(`StairPhysicalInventory.exclusiveSites_eq` gives this list). -/
theorem endPacket760Loan44_avoids :
    ∀ q ∈ (List.range' 720 40 ++ List.range' 761 4).map base,
      q ∉ wires (endPacket760Loan44 false) :=
  endPacket760Loan44_freeS

theorem endPacket760Loan44_avoids_roles :
    ∀ q ∈ roles44, q ∉ wires (endPacket760Loan44 false) := by
  rw [roles44_eq]
  exact endPacket760Loan44_avoids

end ECDSAAdd.Entrant.StairEndpointLoan44
end Merge_StairEndpointLoan44Avoid_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairEndpointLoan44Support_at_QTop` -/
section Merge_StairEndpointLoan44Support_at_QTop

/-!
# Support of the 44-site multiplication endpoint

`wires (endPacket760Loan44 false) ⊆ wires (R2SqEp760.endPacket760 false)`:
the loans only reuse low carries the record endpoint already touches, and the
44 retired roles disappear (`endPacket760Loan44_avoids_roles`).  Hence every
arena / old-hole fact proved for the record endpoint transfers verbatim.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairEndpointLoan44

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoan

/-! ## Monotonicity of support envelopes -/

private theorem env_refl (P : Program) (T : Finset Wire) : wires P ⊆ wires P ∪ T :=
  Finset.subset_union_left

private theorem env_append {P P' Q Q' : Program} {T : Finset Wire}
    (h : wires P ⊆ wires Q ∪ T) (h' : wires P' ⊆ wires Q' ∪ T) :
    wires (P ++ P') ⊆ wires (Q ++ Q') ∪ T := by
  intro x hx
  rw [wires_append] at hx ⊢
  rcases Finset.mem_union.mp hx with hx | hx
  · rcases Finset.mem_union.mp (h hx) with hq | ht
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ hq)
    · exact Finset.mem_union_right _ ht
  · rcases Finset.mem_union.mp (h' hx) with hq | ht
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ hq)
    · exact Finset.mem_union_right _ ht

private theorem env_rename {P Q : Program} {T : Finset Wire} (f : Wire → Wire)
    (h : wires P ⊆ wires Q ∪ T) (fix : ∀ t ∈ T, f t = t) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) ∪ T := by
  intro x hx
  rw [renameProgram_support] at hx ⊢
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  rcases Finset.mem_union.mp (h hy) with hq | ht
  · exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨y, hq, rfl⟩)
  · rw [fix y ht]
    exact Finset.mem_union_right _ ht

private theorem env_weaken {P Q : Program} {T T' : Finset Wire}
    (h : wires P ⊆ wires Q ∪ T) (hT : T ⊆ wires Q ∪ T') : wires P ⊆ wires Q ∪ T' := by
  intro x hx
  rcases Finset.mem_union.mp (h hx) with hq | ht
  · exact Finset.mem_union_left _ hq
  · exact hT ht

private theorem env_drop {P : Program} {Q T : Finset Wire} (h : wires P ⊆ Q ∪ T)
    (away : ∀ t ∈ T, t ∉ wires P) : wires P ⊆ Q := by
  intro x hx
  rcases Finset.mem_union.mp (h hx) with hq | ht
  · exact hq
  · exact absurd hx (away x ht)

/-! ## Block envelopes (generic layout) -/

private def T44 : Finset Wire := roles44.toFinset
private def H44 (L : BalancedCircuit.Layout) : Finset Wire := ((L.carry.take 255).take 44).toFinset

private theorem roles44_take : roles44.take 44 = roles44 := by decide +kernel

private theorem loan_env (L : BalancedCircuit.Layout) (ls : List CarryLayer) (top Q : Program)
    (same : emitSweep ls top = Q)
    (hosts : layerHosts (ls.take 44) = (L.carry.take 255).take 44) :
    wires (emitLoan 44 roles44 ls top) ⊆ wires Q ∪ (T44 ∪ H44 L) := by
  intro x hx
  have e := StairLoanSupport.emitLoan_support_envelope 44 roles44 ls top hx
  rw [same, roles44_take, hosts] at e
  rcases Finset.mem_union.mp e with e | e
  · rcases Finset.mem_union.mp e with e | e
    · exact Finset.mem_union_left _ e
    · exact Finset.mem_union_right _ (Finset.mem_union_left _ e)
  · exact Finset.mem_union_right _ (Finset.mem_union_right _ e)

private theorem decision_env (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (decisionLoan44 L) ⊆ wires (InverseTailC.decision L) ∪ (T44 ∪ H44 L) := by
  have w := BalancedCleanup.widths L.toLayout hw
  have shapes := ctl_prefix_shapes 44 L.ylow L.low (L.carry.take 255) L.one
    (hw.2.1.trans w.1.symm) (by simp [List.length_take, hw.2.2, w.1])
    (by simp [List.length_take, hw.2.2])
  have chain := loan_env L (ctlLayers L.ylow L.low (L.carry.take 255) L.one)
    (ctlTop (some L.sign) L.parity L.ylow L.low (L.carry.take 255) L.one)
    (compareChain (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity)
    (compareChain_as_ctlSweep _ _ _ _ _ _).symm shapes.2.2
  unfold decisionLoan44 InverseTailC.decision compareLtLoan44 compareLt ctlLoan
  exact env_append (env_append (env_append (env_refl _ _)
    (env_append (env_append (env_refl _ _) chain) (env_refl _ _))) (env_refl _ _))
    (env_refl _ _)

private theorem raw_env (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (rawLoan44 L) ⊆ wires (InverseTailC.raw L) ∪ (T44 ∪ H44 L) := by
  have w := BalancedCleanup.widths L.toLayout hw
  have hosts := layerHosts_mapped_take 44 (mappedRead L.y false) L.r (L.carry.take 255)
    L.sign (by simp [mappedRead_length, w.2.2.1, w.2.1])
    (by simp [List.length_take, hw.2.2, w.2.1])
  have add := loan_env L (mappedLayers (mappedRead L.y false) L.r (L.carry.take 255) L.sign)
    (mappedTop (mappedRead L.y false) L.r (L.carry.take 255) L.sign)
    (mappedAdd (mappedRead L.y false) L.r (L.carry.take 255) L.sign)
    (mappedAdd_as_sweep _ _ _ _).symm hosts
  unfold rawLoan44 InverseTailC.raw signedAddLoan44 signedAdd mappedAddLoan
  rw [addInPlace_eq_mapped]
  exact env_append (env_append (env_refl _ _)
    (env_append (env_append (env_refl _ _) add) (env_refl _ _))) (env_refl _ _)

private theorem correction_env (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (correctionLoan44 L) ⊆ wires (InverseTailC.correction L) ∪ (T44 ∪ H44 L) := by
  have w := BalancedCleanup.widths L.toLayout hw
  have hosts := layerHosts_mapped_take 44 (mappedConstant (some L.parity) 256 p) L.r
    (L.carry.take 255) L.one (by simp [mappedConstant_length, w.2.1])
    (by simp [List.length_take, hw.2.2, w.2.1])
  have add := loan_env L
    (mappedLayers (mappedConstant (some L.parity) 256 p) L.r (L.carry.take 255) L.one)
    (mappedTop (mappedConstant (some L.parity) 256 p) L.r (L.carry.take 255) L.one)
    (mappedAdd (mappedConstant (some L.parity) 256 p) L.r (L.carry.take 255) L.one)
    (mappedAdd_as_sweep _ _ _ _).symm hosts
  unfold correctionLoan44 InverseTailC.correction mappedSubLoan mappedSub mappedAddLoan
  exact env_append (env_append (env_refl _ _)
    (env_append (env_append (env_refl _ _) add) (env_refl _ _))) (env_refl _ _)

private theorem hosts_in_program (L : BalancedCircuit.Layout) (hw : L.Widths) :
    H44 L ⊆ wires (InverseTailC.program L) ∪ T44 := by
  have w := BalancedCleanup.widths L.toLayout hw
  intro x hx
  apply Finset.mem_union_left
  have hc : x ∈ L.carry.take 255 := List.mem_of_mem_take (List.mem_toFinset.mp hx)
  have inChain : x ∈ wires (compareChain (some L.sign) L.ylow L.low (L.carry.take 255)
      L.one L.parity) := by
    rw [compareChain_wires _ _ _ _ _ _ (hw.2.1.trans w.1.symm)
      (by simp [List.length_take, hw.2.2, w.1])]
    exact List.mem_toFinset.mpr (by simp [hc])
  unfold InverseTailC.program InverseTailC.decision compareLt
  simp only [wires_append, Finset.mem_union]
  tauto

theorem tailProgramLoan44_env (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (tailProgramLoan44 L) ⊆ wires (InverseTailC.program L) ∪ T44 := by
  have whole : wires (tailProgramLoan44 L) ⊆
      wires (InverseTailC.program L) ∪ (T44 ∪ H44 L) := by
    unfold tailProgramLoan44 InverseTailC.program
    exact env_append (env_append (env_append (decision_env L hw) (raw_env L hw))
      (correction_env L hw)) (env_refl _ _)
  apply env_weaken whole
  intro x hx
  rcases Finset.mem_union.mp hx with ht | hh
  · exact Finset.mem_union_right _ ht
  · exact hosts_in_program L hw hh



/-! ## Through the wrappers -/

private theorem fix_borrow : ∀ t ∈ T44,
    InverseTailC.borrowSwap (Q6EndpointCell.ports base (base 2409)) t = t := by
  intro t ht
  have h : ∀ t ∈ roles44,
      InverseTailC.borrowSwap (Q6EndpointCell.ports base (base 2409)) t = t := by
    decide +kernel
  exact h t (List.mem_toFinset.mp ht)

private theorem fix_select : ∀ t ∈ T44, Equiv.swap (base 719) (base 510) t = t := by
  intro t ht
  have h : ∀ t ∈ roles44, Equiv.swap (base 719) (base 510) t = t := by decide +kernel
  exact h t (List.mem_toFinset.mp ht)

private theorem fix_pi0 : ∀ t ∈ T44, shifted Placement5.pi0 t = t := by
  intro t ht
  have h : ∀ t ∈ roles44, shifted Placement5.pi0 t = t := by decide +kernel
  exact h t (List.mem_toFinset.mp ht)

private theorem fix_760 : ∀ t ∈ T44, Equiv.swap (base 760) (base 717) t = t := by
  intro t ht
  have h : ∀ t ∈ roles44, Equiv.swap (base 760) (base 717) t = t := by decide +kernel
  exact h t (List.mem_toFinset.mp ht)

private theorem endHalf_env :
    wires (endHalfLoan44 false) ⊆ wires (Rolling1588Lifetime.endHalf false) ∪ T44 := by
  have hw : (Q6EndpointCell.ports base (base 2409)).Widths :=
    Q6EndpointCell.ports_widths base (base 2409)
  have tail := tailProgramLoan44_env _ hw
  have borrowed := env_rename (InverseTailC.borrowSwap (Q6EndpointCell.ports base (base 2409)))
    tail fix_borrow
  have half := env_append (env_append (env_refl ([.X (base 2409)] : Program) T44) borrowed)
    (env_refl ([.X (base 2409)] : Program) T44)
  have padded := env_append half
    (env_refl (List.replicate 256 (Instr.measureX (base 512) [] [])) T44)
  exact padded

private theorem rawEnd_env :
    wires (rawEndLoan44 false) ⊆ wires (Rolling1588Lifetime.rawEnd false) ∪ T44 := by
  simp only [rawEndLoan44, Rolling1588Lifetime.rawEnd, ControlLoan1589.loanWindow]
  exact env_append (env_append (env_refl _ _)
    (env_rename (Equiv.swap (base 719) (base 510)) endHalf_env fix_select)) (env_refl _ _)

private theorem endPacket_env :
    wires (endPacketLoan44 false) ⊆ wires (Rolling1588Lifetime.endPacket false) ∪ T44 := by
  simp only [endPacketLoan44, Rolling1588Lifetime.endPacket]
  exact env_rename (shifted Placement5.pi0) rawEnd_env fix_pi0

private theorem endPacket760_env :
    wires (endPacket760Loan44 false) ⊆ wires (R2SqEp760.endPacket760 false) ∪ T44 := by
  simp only [endPacket760Loan44, R2SqEp760.endPacket760]
  exact env_rename (Equiv.swap (base 760) (base 717)) endPacket_env fix_760

/-- Every wire of the 44-site endpoint is a wire of the record endpoint. -/
theorem endPacket760Loan44_support :
    wires (endPacket760Loan44 false) ⊆ wires (R2SqEp760.endPacket760 false) := by
  exact env_drop endPacket760_env (fun t ht =>
    endPacket760Loan44_avoids_roles t (List.mem_toFinset.mp ht))

end ECDSAAdd.Entrant.StairEndpointLoan44
end Merge_StairEndpointLoan44Support_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanSupportHalf_at_QTop` -/
section Merge_StairLoanSupportHalf_at_QTop

/-!
# Whole-half support erasure for the staircase loan halves

`StairLoanSupport` proves the component-level support lemmas (inner carry
families, fixed-layout support facts).  This module composes them through the
fixed wire swaps and unchanged frames of the 760-qubit lifetime half and
exposes field 5 of `StairCertificate.StairOpen` (`WholeHalfSupport`) as
`StairLoanSupport.wholeHalfSupport`.
-/

set_option autoImplicit false
set_option maxRecDepth 2000
set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false

namespace ECDSAAdd.Entrant.StairLoanSupport

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField
open StairLoan

/- The fixed 760-site layout is a concrete structure literal.  None of the
proofs below needs its field values (the few concrete facts are decided by the
kernel), and letting the elaborator unfold it makes unification evaluate the
256-entry wire lists. -/
attribute [local irreducible] Q6EndpointCell.ports

private theorem rotateRight_support_list (r : List Wire) :
    wires (rotateRight r) ⊆ r.toFinset := by
  rw [(rotate_wires r).1]
  split <;> simp

private theorem rotateLeft_support_list (r : List Wire) :
    wires (rotateLeft r) ⊆ r.toFinset := by
  rw [(rotate_wires r).2]
  split <;> simp

private theorem rawTarget_staticPool760 :
    (BalancedCircuit.rawTarget L760).toFinset ⊆ staticPool760.toFinset := by
  intro q hq
  simp only [BalancedCircuit.rawTarget, BalancedCleanup.Layout.r,
    BalancedCleanup.Layout.low, staticPool760, List.mem_toFinset,
    List.mem_cons, List.mem_append, List.mem_singleton] at hq ⊢
  tauto

private theorem r_staticPool760 : L760.r.toFinset ⊆ staticPool760.toFinset := by
  intro q hq
  simp only [BalancedCleanup.Layout.r, BalancedCleanup.Layout.low,
    staticPool760, List.mem_toFinset, List.mem_cons, List.mem_append,
    List.mem_singleton] at hq ⊢
  tauto

private theorem y_staticPool760 : L760.y.toFinset ⊆ staticPool760.toFinset := by
  intro q hq
  simp only [BalancedCleanup.Layout.y, staticPool760, List.mem_toFinset,
    List.mem_cons, List.mem_append, List.mem_singleton] at hq ⊢
  tauto

private theorem prepareSign_staticPool760 :
    wires (BalancedCleanup.prepareSign L760.toLayout) ⊆ staticPool760.toFinset := by
  intro q hq
  simp only [BalancedCleanup.prepareSign, wires_append, Finset.mem_union] at hq
  rcases hq with front | complement
  · simp [wires, Instr.wires, staticPool760, List.mem_toFinset] at front ⊢
    tauto
  · have touched := List.mem_toFinset.mp
      (signComplement_wires_subset L760.lower L760.r complement)
    simp only [List.mem_cons] at touched
    rcases touched with rfl | target
    · simp [staticPool760]
    · exact r_staticPool760 (by simpa using target)

private theorem prepareCompare_staticPool760 :
    wires (BalancedCleanup.prepareCompare L760.toLayout) ⊆
      staticPool760.toFinset := by
  intro q hq
  simp only [BalancedCleanup.prepareCompare, wires_append,
    Finset.mem_union] at hq
  simp only [or_assoc] at hq
  rcases hq with rotate | (front | (signY | (lowerY | finish)))
  · exact r_staticPool760 (rotateLeft_support_list L760.r rotate)
  · simp [wires, Instr.wires, staticPool760, List.mem_toFinset] at front ⊢
    tauto
  · have touched := List.mem_toFinset.mp
      (signComplement_wires_subset L760.sign L760.y signY)
    simp only [List.mem_cons] at touched
    rcases touched with rfl | target
    · simp [staticPool760]
    · exact y_staticPool760 (by simpa using target)
  · have touched := List.mem_toFinset.mp
      (signComplement_wires_subset L760.lower L760.y lowerY)
    simp only [List.mem_cons] at touched
    rcases touched with rfl | target
    · simp [staticPool760]
    · exact y_staticPool760 (by simpa using target)
  · simp [wires, Instr.wires, staticPool760, List.mem_toFinset] at finish ⊢
    tauto

private theorem exposure_staticPool760 :
    wires (Q6StructuralCell.exposure L760) ⊆ staticPool760.toFinset := by
  intro q hq
  simp [Q6StructuralCell.exposure, Arithmetic.Q6LowerExposure.expose,
    wires, Instr.wires, staticPool760, List.mem_toFinset] at hq ⊢
  tauto

private theorem forwardU0_away (d : Nat) (hd : d ≤ 68) :
    ∀ q ∈ wires forwardU0, q ∉ (retiredRoles.take d).toFinset := by
  apply support_away_of_staticPool760 d hd forwardU0
  intro q hq
  have small := threeCX_support_list L760.rmsb L760.one rawA760 L760.parity
    L760.r0 L760.parity hq
  apply staticNodes760
  simp only [List.mem_toFinset, List.mem_cons, List.mem_singleton,
    List.not_mem_nil, or_false] at small ⊢
  tauto
private theorem forwardU1_away (d : Nat) (hd : d ≤ 68) :
    ∀ q ∈ wires forwardU1, q ∉ (retiredRoles.take d).toFinset := by
  apply support_away_of_staticPool760 d hd forwardU1
  intro q hq
  simp only [forwardU1, wires_append, Finset.mem_union] at hq
  rcases hq with prepare | rotate
  · simp [OneReuse.newPrepare, wires, Instr.wires, staticPool760,
      List.mem_toFinset] at prepare ⊢
    tauto
  · exact rawTarget_staticPool760 (rotateRight_support_list _ rotate)
private theorem forwardU2_away (d : Nat) (hd : d ≤ 68) :
    ∀ q ∈ wires forwardU2, q ∉ (retiredRoles.take d).toFinset := by
  apply support_away_of_staticPool760 d hd forwardU2
  intro q hq
  simp only [forwardU2, wires_append, Finset.mem_union] at hq
  simp only [or_assoc] at hq
  rcases hq with sign | (bias | (compare | exposure))
  · exact prepareSign_staticPool760 sign
  · have small := x_support_list (L760.rtail.getD 253 0) bias
    have eq : q = L760.rtail.getD 253 0 := by
      simpa only [List.mem_toFinset, List.mem_singleton] using small
    rw [eq]
    exact staticPoints760.2.2.2.2.2.2.1
  · exact prepareCompare_staticPool760 compare
  · exact exposure_staticPool760 exposure
private theorem forwardU3_away (d : Nat) (hd : d ≤ 68) :
    ∀ q ∈ wires forwardU3, q ∉ (retiredRoles.take d).toFinset := by
  apply support_away_of_staticPool760 d hd forwardU3
  intro q hq
  simp only [forwardU3, wires_append, wires_reverse, Finset.mem_union] at hq
