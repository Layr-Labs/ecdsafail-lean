/-! ## The head with an extended backward slice list -/

/-- LT10's `headPrefixShape` with the slice list `(44, 100, 2) :: M`. -/
def headShapeL (loans : StairSchedule.StairLoans) (M : List (Nat × Nat × Nat)) : Program :=
  loans.center ++ HalfFieldOB5.copyN ++
    renameProgram (OB5.sig 511)
      (loans.endPacket false 68 ++ slices loans false ((43, 100, 2) :: M))

/-- The loaned multiplication head followed by the placed slices `M`. -/
def headELL (loans : StairSchedule.StairLoans) (M : List (Nat × Nat × Nat)) : Program :=
  (StairSchedule.paritySetup ++ StairSchedule.hostedX ++
    StairSchedule.fieldRename FourScratchWindow.clearProgram) ++
  liftF (headShapeL loans M)

theorem chain_cons (M : List (Nat × Nat × Nat)) (low : Nat) (h : BackwardChain 100 low M) :
    BackwardChain 102 low ((43, 100, 2) :: M) := by
  show 100 + 2 = 102 ∧ 43 ≤ 68 ∧ 1 ≤ 100 ∧ 100 + 2 ≤ 102 ∧ BackwardChain 100 low M
  exact ⟨rfl, by omega, by omega, by omega, h⟩

private theorem slicesX_cons (loans : StairSchedule.StairLoans) (divide : Bool) (d j n : Nat)
    (rest : List (Nat × Nat × Nat)) :
    slices loans divide ((d, j, n) :: rest) =
      loans.groups divide d j n ++ slices loans divide rest := rfl

/-- LT46 (replay budget): the slice induction for ARBITRARY loan providers.  With the
concrete providers in the induction the kernel unfolded the loaned groups while
comparing the two sides (46.6 s); here nothing can be unfolded. -/
theorem slicesF_sub_gen (L1 L2 : StairSchedule.StairLoans) (f : Wire → Wire)
    (hG : ∀ d, d ≤ 68 → ∀ j n, wires (renameProgram f (L1.groups false d j n)) ⊆
      wires (renameProgram f (L2.groups false d j n))) :
    ∀ (M : List (Nat × Nat × Nat)) (c low : Nat), BackwardChain c low M →
      wires (renameProgram f (slices L1 false M)) ⊆
        wires (renameProgram f (slices L2 false M)) := by
  intro M
  induction M with
  | nil => intro _ _ _ q hq; exact hq
  | cons a rest ih =>
    obtain ⟨d, j, n⟩ := a
    intro c low chain
    obtain ⟨_, hd, _, _, hr⟩ := chain
    rw [slicesX_cons, slicesX_cons, rename_append', rename_append', wires_append, wires_append]
    exact Finset.union_subset_union (hG d hd j n) (ih j low hr)

theorem slicesF_sub : ∀ (M : List (Nat × Nat × Nat)) (c low : Nat),
    BackwardChain c low M →
    wires (renameProgram (OB5.sig 511) (slices StairConcrete.bestLoans false M)) ⊆
      wires (renameProgram (OB5.sig 511) (slices StairSchedule.recordLoans false M)) :=
  slicesF_sub_gen StairConcrete.bestLoans StairSchedule.recordLoans (OB5.sig 511)
    (fun d hd j n => StairLoanGroupSupport.placedGroups_sub false d hd j n)

theorem headShapeL_wires (loans : StairSchedule.StairLoans) (M : List (Nat × Nat × Nat)) :
    wires (headShapeL loans M) =
      wires (StairLoanExitHeadReplay.headPrefixShape loans) ∪
        wires (renameProgram (OB5.sig 511) (slices loans false M)) := by
  ext q
  simp only [headShapeL, StairLoanExitHeadReplay.headPrefixShape,
    StairLoanExitHeadReplay.headSlices, slices, rename_append', wires_append,
    List.append_nil, Finset.mem_union]
  tauto

theorem headShapeL_sub (M : List (Nat × Nat × Nat)) (low : Nat)
    (chain : BackwardChain 100 low M) :
    wires (headShapeL StairConcrete.bestLoans M) ⊆
      wires (headShapeL StairSchedule.recordLoans M) := by
  rw [headShapeL_wires, headShapeL_wires]
  exact Finset.union_subset_union headPrefix_sub (slicesF_sub M 100 low chain)

theorem shape_sub (A B C D F : Program) (f : Wire → Wire) :
    wires (A ++ B ++ renameProgram f (C ++ D)) ⊆
      wires (A ++ B ++ renameProgram f (C ++ (D ++ F))) := by
  intro q hq
  simp only [rename_append', wires_append, Finset.mem_union] at hq ⊢
  tauto

theorem headShapeL_record_sub (M : List (Nat × Nat × Nat)) (low : Nat)
    (chain : BackwardChain 100 low M) (hlow : 1 ≤ low) :
    wires (headShapeL StairSchedule.recordLoans M) ⊆ wires Rolling1588.exitHead := by
  have le := backward_chain_low M 100 low chain
  have c2 : BackwardChain (low + (102 - low)) low ((43, 100, 2) :: M) := by
    rw [show low + (102 - low) = 102 by omega]
    exact chain_cons M low chain
  have hs := backward_slices_record ((43, 100, 2) :: M) low (102 - low) c2
  have hg : Rolling1588.groups false 1 101 =
      Rolling1588.groups false low (102 - low) ++ Rolling1588.groups false 1 (low - 1) := by
    unfold Rolling1588.groups
    have h := StairLoanRecordShape.program_false_add (Rolling1588.packet false) (low - 1) (102 - low) 1
    rw [show low - 1 + (102 - low) = 101 by omega, show 1 + (low - 1) = low by omega] at h
    exact h
  have e : headShapeL StairSchedule.recordLoans M =
      R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
        renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false ++
          slices StairSchedule.recordLoans false ((43, 100, 2) :: M)) := rfl
  rw [e, hs]
  unfold Rolling1588.exitHead
  rw [hg]
  exact shape_sub _ _ _ _ _ _

/-! ## Record-frame replay of the extended head -/

theorem exitLogicalHeadL_run_eq (half : HalfReplayHypothesis)
    (hEnd : EndpointReplay StairConcrete.bestLoans)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) (hXY : X = Y)
    (s : State)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) false origin X Y s)
    (M : List (Nat × Nat × Nat)) (low : Nat) (chain : BackwardChain 100 low M)
    (fresh old : List Bool) :
    run (StairConcrete.bestLoans.endPacket false 68 ++
        slices StairConcrete.bestLoans false ((43, 100, 2) :: M)) fresh s =
      run (R2SqEp760.endPacket760 false ++
        slices StairSchedule.recordLoans false ((43, 100, 2) :: M)) old s := by
  rw [run_append, run_append]
  rw [hEnd origin ctx enabled X Y hXY s _
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input]
  have ending := R2SqEp760.endPacket760_frame false false origin ctx enabled X Y
    (fun bad => absurd bad (by decide)) (fun _ => hXY) s
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input
  have cut := (Rolling1588.cutFrame_end origin _ _ _).mpr ending.2
  exact backward_slices_run_eq half ((43, 100, 2) :: M) 102 low (chain_cons M low chain)
    origin ctx enabled _ _ _ cut _ _

theorem headShapeL_run_eq (half : HalfReplayHypothesis)
    (hEnd : EndpointReplay StairConcrete.bestLoans)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (M : List (Nat × Nat × Nat)) (low : Nat) (chain : BackwardChain 100 low M)
    (fresh old : List Bool) :
    run (headShapeL StairConcrete.bestLoans M) fresh state =
      run (headShapeL StairSchedule.recordLoans M) old state := by
  have centerAt (b : List Bool) :=
    R2SqEp760.center760_frame origin ctx ha Y state b input
  have headEq : ∀ a b,
      run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN) a state =
        run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state := by
    intro a b
    apply StairLoanRecordShape.head_replace _ _ _ state
    · intro a b
      exact StairBoundaryLoan.center760Loan_run_eq origin ctx ha Y state a b input
    · intro b a c
      have v := (centerAt b).2
      exact StairLoanRecordShape.run_eq_of_phase _ _ a c
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ a v).1
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ c v).1
  have wAll : ∀ b, Rolling1588Frame.EncodedFieldFrame false origin (Y / 2)
      (Y / 2) (run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state) := by
    intro b
    rw [run_append]
    exact (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ _ (centerAt _).2).2
  show run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (StairConcrete.bestLoans.endPacket false 68 ++
        slices StairConcrete.bestLoans false ((43, 100, 2) :: M))) fresh state =
    run (R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false ++
        slices StairSchedule.recordLoans false ((43, 100, 2) :: M))) old state
  apply StairLoanRecordShape.both_replace _ _ _ _ state headEq
  intro b a c
  have w := wAll b
  rw [StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    exitLogicalHeadL_run_eq half hEnd origin ctx enabled (Y / 2) (Y / 2) rfl _ w M low chain
      a c]

/-! ## The extended loaned head on `ExitMiddle` states -/


/-! ## Shapes: head ++ groups = extended head -/

theorem shape0 (loans : StairSchedule.StairLoans) :
    StairLoanField7Transport.headEL loans = headELL loans [] := by
  simp only [headELL, headShapeL, StairLoanField7Transport.headEL,
    StairLoanField7Transport.grpFL, slices, StairSchedule.placedEndPacket,
    StairSchedule.placedGroups, liftF, StairSchedule.fieldRename, StairSchedule.parityRename,
    rename_append', StairLoanField7Transport.rename_nil, List.append_nil, List.append_assoc]

/-- One more placed group after the extended head. -/
theorem shape_snoc (loans : StairSchedule.StairLoans) (M : List (Nat × Nat × Nat))
    (d j n : Nat) :
    headELL loans M ++ StairLoanField7Transport.grpFL loans d j n =
      headELL loans (M ++ [(d, j, n)]) := by
  have sl : ∀ (A : List (Nat × Nat × Nat)),
      slices loans false (A ++ [(d, j, n)]) =
        slices loans false A ++ loans.groups false d j n := by
    intro A
    induction A with
    | nil => simp only [List.nil_append, slices, List.append_nil]
    | cons a A ih =>
        obtain ⟨d', j', n'⟩ := a
        simp only [List.cons_append, slices, ih, List.append_assoc]
  have sl' := sl ((43, 100, 2) :: M)
  rw [List.cons_append] at sl'
  simp only [headELL, headShapeL, sl', StairLoanField7Transport.grpFL,
    StairSchedule.placedGroups, liftF, StairSchedule.fieldRename, StairSchedule.parityRename,
    rename_append', List.append_assoc]

