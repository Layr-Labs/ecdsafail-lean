/-- Complete-state replay is stable under an injective wire permutation. -/
theorem rename_replayD (U : Equiv.Perm Wire) (P Q : Program)
    (pre : State → Prop)
    (replay : ∀ s, pre s → ∀ fresh,
      ∃ old, run P fresh s = run Q old s) :
    ∀ s, pre (pullState U s) → ∀ fresh, ∃ old,
      run (renameProgram U P) fresh s = run (renameProgram U Q) old s := by
  intro s hs fresh
  let pulled := pullState U s
  obtain ⟨old, inner⟩ := replay pulled hs fresh
  let support := wires P ∪ wires Q
  refine ⟨old, ?_⟩
  exact ECDSAAdd.run_rename_eq_of_eq U support
    (fun a _ b _ eq => U.injective eq) P Q
    Finset.subset_union_left Finset.subset_union_right fresh old pulled s
    rfl (fun _ _ => rfl) inner


end ECDSAAdd.Entrant.AboveFieldPointDevelop.LT11Final

