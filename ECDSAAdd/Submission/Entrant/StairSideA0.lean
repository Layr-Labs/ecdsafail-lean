def k6sp_oldB (v : Nat) : Bool :=
  Nat.ble 4833 v && (Nat.beq v 5515 || Nat.beq v 5915 || Nat.beq v 4881 || Nat.beq v 4880 ||
    Nat.beq v 4882 || Nat.beq v 5655 || Nat.beq v 4885 || Nat.beq v 5400 || Nat.beq v 5401 ||
    Nat.beq v 4884 || Nat.beq v 4883 || Nat.beq v 4833 || Nat.beq v 4834 || Nat.beq v 4875 ||
    Nat.beq v 9815)

theorem k6sp_old_eq (v : Nat) : StairPhysicalLayout.oldHolesNat.contains v = k6sp_oldB v := by
  rw [Bool.eq_iff_iff]
  simp only [StairPhysicalLayout.oldHolesNat, k6sp_oldB, List.contains_cons, List.contains_nil,
    Bool.or_false, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq, Nat.beq_eq, or_assoc]
  constructor
  · intro h
    refine ⟨?_, h⟩
    rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;> (subst h; decide)
  · intro h
    exact h.2

def k6sp_goodB (v : Nat) : Bool :=
  StairPhysicalLayout.arenaB v && !(k6sp_oldB v) && !(StairPhysicalLayout.newB v)

theorem k6sp_goodB_eq (v : Nat) : StairPhysicalLayout.goodB v = k6sp_goodB v := by
  unfold StairPhysicalLayout.goodB k6sp_goodB
  rw [k6sp_old_eq]

def k6sp_lowB (q : Nat) : Nat :=
  StairPlaceFast.kernelPlaceB (StairPlaceFast.swB 1813 1559
    (StairPlaceFast.swB 2426 1558 (StairPlaceFast.swB 2425 527 q)))

theorem k6sp_low_eq (q : Nat) : StairPhysicalLayout.goodB (lowPlace q) = k6sp_goodB (k6sp_lowB q) := by
  unfold lowPlace k6sp_lowB
  rw [StairPlaceFast.kernelPlace_eqB, StairPlaceFast.hostSwap_eqB, StairPlaceFast.swap_eq_sw,
    ← StairPlaceFast.swB_eq, k6sp_goodB_eq]
  rfl

