    ((GuardCompression.source L).drop 1)
    ((BalancedCircuit.rawTarget L).drop 1)
    (((Q6Structural.q6Carry L).take 255).drop 1)
    (((Q6Structural.q6Carry L).take 255).getD 0 0)
