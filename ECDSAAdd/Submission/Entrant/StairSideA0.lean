/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareBMapped_at_QTop` -/
section Merge_StairSquareBMapped_at_QTop

/-! # LT36 (U3b): mapped-source canonical modular add

`qprogM K bits p` is the record's `qprogTq K p` with the source read as a list of `MappedBit`s
(wire bits and constant bits) instead of the wire list `K.src`.  The sum phase is the record's
`mappedAdd` (already mapped-generic); the borrow-erase phase is `eraseLtChainM`, the record's
`eraseLtChain` with a mapped second operand.  `K.src` is NOT used by the program; it only
appears in the `Nodup` hypothesis of the record lemmas that are reused verbatim.

Purpose: the B body's e-fold adds a 163-bit accumulator into the 256-bit output.  The record
reads all 256 `work` bits (93 of them known zero), so the 256 carries have to sit on
`pad ++ overflowPad ++ …` (which contains the 39 hole sites).  With a mapped source the 93
zero bits become constants, the 93 `work` wires are free and carry the hole positions. -/

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareBMapped
open ECDSAAdd ECDSAAdd.Entrant Arithmetic RecordedQuantum

def zbit : MappedBit := {wire:=none,flip:=false}

/-- `target ^= carry(!a, b, cin)` (borrow of `a - b - cin`), `b` mapped. -/
def borrowM (a : Wire) (b : MappedBit) (cin target : Wire) : Program :=
  [.X a]++(mappedMajority b a cin target++[.X a])

/-- Erase a borrow `target = carry(!a, b, cin)`, `b` mapped. -/
def eraseM (a : Wire) (b : MappedBit) (cin target : Wire) : Program :=
  [.X a]++(mappedEraseCarry b a cin target++[.X a])

/-- `eraseLtChain` with a mapped second operand. -/
def eraseLtChainM : List Wire → List MappedBit → List Wire → Wire → Wire → Program
  | a::a'::as,b::b'::bs,c::cs,cin,target =>
      borrowM a b cin c++eraseLtChainM (a'::as) (b'::bs) cs c target++eraseM a b cin c
  | [a],[b],_,cin,target => eraseM a b cin target
  | _,_,_,_,_ => []

theorem mw_tail (b : MappedBit) (bs : List MappedBit) (q : Wire) (h : q∈mappedWires bs) :
    q∈mappedWires (b::bs) := by
  simp only [mappedWires,List.flatMap_cons,List.mem_append] at h ⊢
  exact Or.inr h

theorem mw_head (b : MappedBit) (bs : List MappedBit) (q : Wire) (h : q∈b.wire) :
    q∈mappedWires (b::bs) := by
  cases hw : b.wire with
  | none => simp [hw] at h
  | some w =>
    have e : w=q := by simpa [hw] using h
    subst e
    simp [mappedWires,hw]

theorem carryBit_comm (a b c : Bool) : carryBit a b c=carryBit b a c := by
  cases a <;> cases b <;> cases c <;> rfl

theorem x_run (a : Wire) (m : List Bool) (s : State) :
    run [.X a] m s=⟨s.phase,writeBit s.basis a (!s.basis a)⟩ := rfl

theorem mc_x (a : Wire) : measurementCount [Instr.X a]=0 := rfl

private theorem three_facts (a cin target : Wire) (hn : [a,cin,target].Nodup) :
    a≠target ∧ a≠cin ∧ cin≠target := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,not_or] at hn
  exact ⟨hn.1.2.1,hn.1.1,hn.2.1.1⟩

theorem borrowM_correct (a : Wire) (b : MappedBit) (cin target : Wire)
    (hn : [a,cin,target].Nodup) (ha : ∀q∈b.wire,q∉[a,cin,target]) (s : State) (m : List Bool) :
    run (borrowM a b cin target) m s=
      ⟨s.phase,writeBit s.basis target
        (s.basis target ^^ carryBit (!s.basis a) (b.value s.basis) (s.basis cin))⟩ := by
  obtain ⟨hat,hac,hct⟩ := three_facts a cin target hn
  have hba : ∀q∈b.wire,q≠a := fun q hq h => ha q hq (by simp [h])
  have hv : b.value (writeBit s.basis a (!s.basis a))=b.value s.basis :=
    mappedBit_value_congr b _ _ (fun q hq => by simp [writeBit,Function.update,hba q hq])
  have e1 : writeBit s.basis a (!s.basis a) target=s.basis target := by
    simp [writeBit,Function.update,Ne.symm hat]
  have e2 : writeBit s.basis a (!s.basis a) a=!s.basis a := by simp [writeBit,Function.update]
  have e3 : writeBit s.basis a (!s.basis a) cin=s.basis cin := by
    simp [writeBit,Function.update,Ne.symm hac]
  unfold borrowM
  rw [run_append,mc_x,List.take_zero,List.drop_zero,x_run,run_append,
    mappedMajority_correct b a cin target hn ha,x_run]
  dsimp only
  rw [hv,e1,e2,e3,carryBit_comm]
  refine congrArg₂ State.mk rfl ?_
  funext q
  by_cases hqa : q=a
  · subst hqa
    simp [writeBit,Function.update,hat]
  · by_cases hqt : q=target
    · subst hqt; simp [writeBit,Function.update,hqa]
    · simp [writeBit,Function.update,hqa,hqt]

theorem eraseM_correct (a : Wire) (b : MappedBit) (cin target : Wire)
    (hn : [a,cin,target].Nodup) (ha : ∀q∈b.wire,q∉[a,cin,target]) (s : State) (m : List Bool)
    (hk : s.basis target=carryBit (!s.basis a) (b.value s.basis) (s.basis cin)) :
    run (eraseM a b cin target) m s=⟨s.phase,writeBit s.basis target false⟩ := by
  obtain ⟨hat,hac,hct⟩ := three_facts a cin target hn
  have hba : ∀q∈b.wire,q≠a := fun q hq h => ha q hq (by simp [h])
  have hv : b.value (writeBit s.basis a (!s.basis a))=b.value s.basis :=
    mappedBit_value_congr b _ _ (fun q hq => by simp [writeBit,Function.update,hba q hq])
  have e1 : writeBit s.basis a (!s.basis a) target=s.basis target := by
    simp [writeBit,Function.update,Ne.symm hat]
  have e2 : writeBit s.basis a (!s.basis a) a=!s.basis a := by simp [writeBit,Function.update]
  have e3 : writeBit s.basis a (!s.basis a) cin=s.basis cin := by
    simp [writeBit,Function.update,Ne.symm hac]
  have hk1 : writeBit s.basis a (!s.basis a) target=
      carryBit (b.value (writeBit s.basis a (!s.basis a))) (writeBit s.basis a (!s.basis a) a)
        (writeBit s.basis a (!s.basis a) cin) := by
    rw [e1,e2,e3,hv,carryBit_comm,hk]
  unfold eraseM
  rw [run_append,mc_x,List.take_zero,List.drop_zero,x_run,run_append,
    mappedEraseCarry_correct b a cin target hn ha ⟨s.phase,writeBit s.basis a (!s.basis a)⟩ _ hk1,x_run]
  dsimp only
  refine congrArg₂ State.mk rfl ?_
  funext q
  by_cases hqa : q=a
  · subst hqa
    simp [writeBit,Function.update,hat]
  · by_cases hqt : q=target
    · subst hqt; simp [writeBit,Function.update,hqa]
    · simp [writeBit,Function.update,hqa,hqt]

theorem borrowM_counts (a : Wire) (b : MappedBit) (cin target : Wire) :
    toffoliCount (borrowM a b cin target)=1 ∧ measurementCount (borrowM a b cin target)=0 := by
  have h := mappedBit_counts b a cin target
  constructor
  · simp only [borrowM,toffoliCount_append,h.1]; rfl
  · simp only [borrowM,measurementCount_append,h.2.1]; rfl

theorem eraseM_counts (a : Wire) (b : MappedBit) (cin target : Wire) :
    toffoliCount (eraseM a b cin target)=0 ∧ measurementCount (eraseM a b cin target)=1 := by
  have h := mappedBit_counts b a cin target
  constructor
  · simp only [eraseM,toffoliCount_append,h.2.2.1]; rfl
  · simp only [eraseM,measurementCount_append,h.2.2.2.1]; rfl

theorem eraseLtChainM_counts (x : List Wire) (y : List MappedBit) (carry : List Wire) (cin target : Wire)
    (hxy : x.length=y.length) (hc : carry.length+1=y.length) :
    toffoliCount (eraseLtChainM x y carry cin target)=y.length-1 ∧
    measurementCount (eraseLtChainM x y carry cin target)=y.length := by
  induction y generalizing x carry cin with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hxy
    | cons a as =>
      cases bs with
      | nil =>
        have ha : as=[] := List.eq_nil_of_length_eq_zero (by simpa using hxy)
        subst ha
        have e := eraseM_counts a b cin target
        simp only [eraseLtChainM]
        exact ⟨e.1,e.2⟩
      | cons b' bs =>
        cases as with
        | nil => simp at hxy
        | cons a' as =>
          cases carry with
          | nil => simp at hc
          | cons c cs =>
            have h := ih (a'::as) cs c (by simpa using hxy) (by simpa using hc)
            have bo := borrowM_counts a b cin c
            have er := eraseM_counts a b cin c
            rw [eraseLtChainM]
            constructor
            · simp only [toffoliCount_append,bo.1,er.1]
              rw [h.1]
              simp [Nat.add_comm]
            · simp only [measurementCount_append,bo.2,er.2]
              rw [h.2]
              simp


/-- Exact erasure of the comparison predicate `x < y + cin` for a mapped `y`. -/
theorem eraseLtChainM_correct (x : List Wire) (y : List MappedBit) (carry : List Wire) (cin target : Wire)
    (hnd : (target::cin::(x++carry)).Nodup)
    (hy : ∀q∈mappedWires y,q∉target::cin::(x++carry))
    (hxy : x.length=y.length) (hc : carry.length+1=y.length)
    (s : State) (m : List Bool)
    (hclean : ∀q∈carry,s.basis q=false)
    (hpred : s.basis target=decide (regValue x s.basis<
      mappedValue y s.basis+(s.basis cin).toNat)) :
    run (eraseLtChainM x y carry cin target) m s=
      ⟨s.phase,writeBit s.basis target false⟩ := by
  induction y generalizing x carry cin s m with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hxy
    | cons a as =>
      have cnt := List.nodup_iff_count.mp hnd
      have hta : target≠a := by
        intro bad; have h := cnt target; subst a
        simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
        omega
      have htcin : target≠cin := by
        intro bad; have h := cnt target; subst cin
        simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
        omega
      have hacin : a≠cin := by
        intro bad; have h := cnt cin; subst a
        simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
        omega
      have hbAway : ∀q∈b.wire,q∉target::cin::((a::as)++carry) := by
        intro q hq
        exact hy q (mw_head b _ q hq)
      cases bs with
      | nil =>
        have ha : as=[] := List.eq_nil_of_length_eq_zero (by simpa using hxy)
        subst ha
        have n3 : [a,cin,target].Nodup := by
          apply List.nodup_iff_count.mpr; intro q
          have h := cnt q
          simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
        have away3 : ∀q∈b.wire,q∉[a,cin,target] := by
          intro q hq bad
          apply hbAway q hq
          simp only [List.mem_cons,List.not_mem_nil,or_false] at bad
          simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
          tauto
        have known : s.basis target=carryBit (!s.basis a) (b.value s.basis) (s.basis cin) := by
          have hp := hpred
          simp only [regValue,List.foldr_cons,List.foldr_nil,mappedValue] at hp
          cases ha : s.basis a <;> cases hb : b.value s.basis <;> cases hi : s.basis cin <;>
            simp_all [carryBit]
        simpa only [eraseLtChainM] using eraseM_correct a b cin target n3 away3 s m known
      | cons b' bs =>
        cases as with
        | nil => simp at hxy
        | cons a' as =>
          cases carry with
          | nil => simp at hc
          | cons c cs =>
            have htc : target≠c := by
              intro bad; have h := cnt target; subst c
              simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
              omega
            have hac : a≠c := by
              intro bad; have h := cnt c; subst a
              simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
              omega
            have hcc : cin≠c := by
              intro bad; have h := cnt c; subst cin
              simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
              omega
            have hccs : c∉cs := by
              intro bad; have h := cnt c
              have pos := List.count_pos_iff.mpr bad
              simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
              omega
            have hcas : c∉a'::as := by
              intro bad; have h := cnt c
              have pos := List.count_pos_iff.mpr bad
              simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h pos
              omega
            have n3 : [a,cin,c].Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := cnt q
              simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
            have away3 : ∀q∈b.wire,q∉[a,cin,c] := by
              intro q hq bad
              apply hbAway q hq
              simp only [List.mem_cons,List.not_mem_nil,or_false] at bad
              simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
              tauto
            have hnd' : (target::c::((a'::as)++cs)).Nodup := by
              apply List.nodup_iff_count.mpr
              intro q; have h := cnt q
              simp only [List.count_cons,List.count_append] at h ⊢
              omega
            have hy' : ∀q∈mappedWires (b'::bs),q∉target::c::((a'::as)++cs) := by
              intro q hq bad
              have hq' : q∈mappedWires (b::b'::bs) := mw_tail b _ q hq
              apply hy q hq'
              simp only [List.mem_cons,List.mem_append] at bad ⊢
              tauto
            have hcy : c∉mappedWires (b'::bs) := by
              intro bad
              exact hy c (mw_tail b _ c bad) (by simp)
            let K := carryBit (!s.basis a) (b.value s.basis) (s.basis cin)
            let s1 : State := ⟨s.phase,writeBit s.basis c K⟩
            have keep (q : Wire) (hq : q≠c) : s1.basis q=s.basis q := by
              simp [s1,writeBit,hq]
            have hzero := hclean c (by simp)
            have first (record : List Bool) : run (borrowM a b cin c) record s=s1 := by
              rw [borrowM_correct _ _ _ _ n3 away3]
              simp [s1,K,hzero]
            have clean' : ∀q∈cs,s1.basis q=false := by
              intro q hq
              rw [keep q (fun bad => hccs (bad ▸ hq))]
              exact hclean q (by simp [hq])
            have vx : regValue (a'::as) s1.basis=regValue (a'::as) s.basis :=
              regValue_congr _ _ _ (fun q hq => keep q (fun bad => hcas (bad ▸ hq)))
            have vy : mappedValue (b'::bs) s1.basis=mappedValue (b'::bs) s.basis :=
              mappedValue_congr _ _ _ (fun q hq => keep q (fun bad => hcy (bad ▸ hq)))
            have pred' : s1.basis target=decide (regValue (a'::as) s1.basis<
                mappedValue (b'::bs) s1.basis+(s1.basis c).toNat) := by
              rw [keep target htc,vx,vy]
              have hk : s1.basis c=K := by simp [s1,writeBit]
              rw [hk]
              have thr := borrow_threshold (s.basis a) (b.value s.basis) (s.basis cin)
                (regValue (a'::as) s.basis) (mappedValue (b'::bs) s.basis)
              have r1 : regValue (a::a'::as) s.basis=(s.basis a).toNat+2*regValue (a'::as) s.basis := by
                cases h : s.basis a <;> simp [regValue,h]
              have r2 : mappedValue (b::b'::bs) s.basis=(b.value s.basis).toNat+2*mappedValue (b'::bs) s.basis := rfl
              have eq : decide (regValue (a::a'::as) s.basis<
                  mappedValue (b::b'::bs) s.basis+(s.basis cin).toNat)=
                  decide (regValue (a'::as) s.basis<mappedValue (b'::bs) s.basis+K.toNat) := by
                apply decide_eq_decide.mpr
                rw [r1,r2]
                exact thr
              exact hpred.trans eq
            let t : State := ⟨s.phase,writeBit s1.basis target false⟩
            have tail (record : List Bool) :
                run (eraseLtChainM (a'::as) (b'::bs) cs c target) record s1=t :=
              ih (a'::as) cs c hnd' hy' (by simpa using hxy) (by simpa using hc)
                s1 record clean' pred'
            have kt (q : Wire) (hqt : q≠target) (hqc : q≠c) : t.basis q=s.basis q := by
              simp [t,writeBit,hqt,keep q hqc]
            have kvalue : t.basis c=K := by simp [t,s1,writeBit,htc.symm]
            have hbt : b.value t.basis=b.value s.basis := by
              apply mappedBit_value_congr
              intro q hq
              apply kt q
              · intro bad; exact hbAway q hq (by simp [bad])
              · intro bad; exact away3 q hq (by simp [bad])
            have clear (record : List Bool) : run (eraseM a b cin c) record t=
                ⟨s.phase,writeBit t.basis c false⟩ := by
              apply eraseM_correct a b cin c n3 away3 t record
              rw [kt a hta.symm hac,kt cin htcin.symm hcc,kvalue,hbt]
            rw [eraseLtChainM]
            simp only [List.append_assoc,run_append,run_take,
              (borrowM_counts _ _ _ _).2,List.take_zero,List.drop_zero]
            rw [first,tail,clear]
            simp only [State.mk.injEq,true_and]
            funext q
            by_cases hqc : q=c <;> by_cases hqt : q=target <;>
              simp_all [t,s1,writeBit,Function.update]

/-! ## Gate-level facts -/

theorem borrowM_physical (a : Wire) (b : MappedBit) (cin target : Wire)
    (hn : [a,cin,target].Nodup) (ha : ∀q∈b.wire,q∉[a,cin,target]) :
    GatePhysical (borrowM a b cin target) := by
  simp only [borrowM,gatePhysical_append]
  exact ⟨by simp [GatePhysical,PhysicalInstr,ProperGate],
    mappedMajority_physical b a cin target hn ha,by simp [GatePhysical,PhysicalInstr,ProperGate]⟩

theorem eraseM_physical (a : Wire) (b : MappedBit) (cin target : Wire) :
    GatePhysical (eraseM a b cin target) := by
  simp only [eraseM,gatePhysical_append]
  exact ⟨by simp [GatePhysical,PhysicalInstr,ProperGate],
    mappedEraseCarry_physical b a cin target,by simp [GatePhysical,PhysicalInstr,ProperGate]⟩

theorem eraseLtChainM_physical (x : List Wire) (y : List MappedBit) (carry : List Wire) (cin target : Wire)
    (hn : (cin::x++carry).Nodup) (hy : ∀q∈mappedWires y,q∉cin::x++carry) :
    GatePhysical (eraseLtChainM x y carry cin target) := by
  induction x generalizing y carry cin with
  | nil => cases y <;> simp [eraseLtChainM,GatePhysical]
  | cons a as ih =>
    cases y with
    | nil => cases as <;> simp [eraseLtChainM,GatePhysical]
    | cons b bs =>
      cases as with
      | nil =>
        cases bs with
        | nil => simpa only [eraseLtChainM] using eraseM_physical a b cin target
        | cons b' bs => simp [eraseLtChainM,GatePhysical]
      | cons a' as =>
        cases bs with
        | nil => simp [eraseLtChainM,GatePhysical]
        | cons b' bs =>
          cases carry with
          | nil => simp [eraseLtChainM,GatePhysical]
          | cons c cs =>
            have cnt := List.nodup_iff_count.mp hn
            have n3 : [a,cin,c].Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := cnt q
              simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
            have away3 : ∀q∈b.wire,q∉[a,cin,c] := by
              intro q hq bad
              have hq' : q∈mappedWires (b::b'::bs) := mw_head b _ q hq
              apply hy q hq'
              simp only [List.mem_cons,List.not_mem_nil,or_false] at bad
              simp only [List.mem_cons,List.mem_append]
              tauto
            have ht : (c::(a'::as)++cs).Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := cnt q
              simp only [List.count_cons,List.count_append] at h ⊢; omega
            have hy' : ∀q∈mappedWires (b'::bs),q∉c::(a'::as)++cs := by
              intro q hq bad
              apply hy q (mw_tail b _ q hq)
              simp only [List.mem_cons,List.mem_append] at bad ⊢
              tauto
            rw [eraseLtChainM]
            simp only [gatePhysical_append]
            exact ⟨⟨borrowM_physical a b cin c n3 away3,ih _ _ _ ht hy'⟩,eraseM_physical a b cin c⟩

theorem borrowM_wires (a : Wire) (b : MappedBit) (cin target : Wire) :
    wires (borrowM a b cin target)⊆(b.wire.toList++[a,cin,target]).toFinset ∧
    wires (eraseM a b cin target)⊆(b.wire.toList++[a,cin,target]).toFinset := by
  have h := mappedBit_wires b a cin target
  constructor
  · intro q hq
    simp only [borrowM,wires_append,Finset.mem_union] at hq
    rcases hq with hq|hq|hq
    · simp [wires,Instr.wires] at hq; simp [hq]
    · exact h.1 hq
    · simp [wires,Instr.wires] at hq; simp [hq]
  · intro q hq
    simp only [eraseM,wires_append,Finset.mem_union] at hq
    rcases hq with hq|hq|hq
    · simp [wires,Instr.wires] at hq; simp [hq]
    · exact h.2.1 hq
    · simp [wires,Instr.wires] at hq; simp [hq]

theorem eraseLtChainM_wires (x : List Wire) (y : List MappedBit) (carry : List Wire) (cin target : Wire) :
    wires (eraseLtChainM x y carry cin target)⊆(x++mappedWires y++carry++[cin,target]).toFinset := by
  induction x generalizing y carry cin with
  | nil => cases y <;> simp [eraseLtChainM,wires]
  | cons a as ih =>
    cases y with
    | nil => cases as <;> simp [eraseLtChainM,wires]
    | cons b bs =>
      cases as with
      | nil =>
        cases bs with
        | nil =>
          intro q hq
          simp only [eraseLtChainM] at hq
          have h := (borrowM_wires a b cin target).2 hq
          simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,
            mappedWires,List.flatMap_cons,List.flatMap_nil,List.append_nil] at h ⊢
          tauto
        | cons b' bs => simp [eraseLtChainM,wires]
      | cons a' as =>
        cases bs with
        | nil => simp [eraseLtChainM,wires]
        | cons b' bs =>
          cases carry with
          | nil => simp [eraseLtChainM,wires]
          | cons c cs =>
            have head := borrowM_wires a b cin c
            have tail := ih (b'::bs) cs c
            intro q hq
            rw [eraseLtChainM] at hq
            simp only [wires_append,Finset.mem_union] at hq
            have hb : ∀w∈b.wire,w∈mappedWires (b::b'::bs) := by
              intro w hw; cases h : b.wire <;> simp_all [mappedWires]
            have hbs : ∀w∈mappedWires (b'::bs),w∈mappedWires (b::b'::bs) :=
              fun w hw => List.mem_append_right _ hw
            rcases hq with (hq|hq)|hq
            · have h := head.1 hq
              simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,
                Option.mem_toList] at h ⊢
              rcases h with h|h|h|h
              · exact Or.inl (Or.inl (Or.inr (hb q h)))
              · tauto
              · tauto
              · tauto
            · have h := tail hq
              simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at h ⊢
              rcases h with ((h|h)|h)|h|h
              · tauto
              · exact Or.inl (Or.inl (Or.inr (hbs q h)))
              · tauto
              · tauto
              · tauto
            · have h := head.2 hq
              simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,
                Option.mem_toList] at h ⊢
              rcases h with h|h|h|h
              · exact Or.inl (Or.inl (Or.inr (hb q h)))
              · tauto
              · tauto
              · tauto


/-! ## The mapped canonical modular add -/

/-- `qprogTq K p` with the source read from `bits` (`K.src` unused by the program). -/
def qprogM (K : MeasuredCanonicalModLayout) (bits : List MappedBit) (p : Nat) : Program :=
  notRegister K.out++mappedAdd (bits++[zbit]) K.extended K.carry K.cin++[.CX K.high K.flag,.X K.flag]++
    mappedConstAdd (some K.flag) K.out (K.carry.take (K.out.length-1)) K.cin p++[.CX K.flag K.high]++
    [.X K.high,.X K.flag]++
    eraseLtChainM K.out bits (K.carry.take (K.out.length-1)) K.cin K.flag

/-- The source bits have the right width and read no wire of the adder. -/
structure BitsOK (K : MeasuredCanonicalModLayout) (n : Nat) (bits : List MappedBit) : Prop where
  len : bits.length=n
  away : ∀q∈mappedWires bits,q∉K.out++K.carry++[K.high,K.cin,K.flag]

theorem mappedWires_zbit (bits : List MappedBit) : mappedWires (bits++[zbit])=mappedWires bits := by
  simp [mappedWires,zbit]

theorem mappedValue_zbit (bits : List MappedBit) (s : BasisState) :
    mappedValue (bits++[zbit]) s=mappedValue bits s := by
  rw [mappedValue_append]
  simp [mappedValue,zbit,MappedBit.value]

theorem bits_off_mutable (K : MeasuredCanonicalModLayout) (n : Nat) (bits : List MappedBit) (hb : BitsOK K n bits)
    (q : Wire) (hq : q∈mappedWires bits) : q∉K.mutable := by
  intro bad
  apply hb.away q hq
  simp only [MeasuredCanonicalModLayout.mutable,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at bad ⊢
  tauto

theorem sumM_frame (K : MeasuredCanonicalModLayout) (n : Nat) (hw : K.Widths n)
    (hn : K.wires.Nodup) (bits : List MappedBit) (hb : BitsOK K n bits) (base : BasisState) (A X : Nat)
    (hs : mappedValue bits base=A) (hAX : A+X<2^(n+1))
    (hc : ∀q∈K.carry,base q=false) (hi : base K.cin=false) :
    Triple (K.Frame base X false false) (mappedAdd (bits++[zbit]) K.extended K.carry K.cin)
      (K.Frame base ((A+X)%2^n) (decide (2^n≤A+X)) false) := by
  have nd : (K.cin::(K.extended++K.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q; have h := List.nodup_iff_count.mp hn q
    simp only [MeasuredCanonicalModLayout.wires,MeasuredCanonicalModLayout.extended,
      List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have away : ∀q∈mappedWires (bits++[zbit]),q∉K.cin::(K.extended++K.carry) := by
    rw [mappedWires_zbit]
    intro q hq bad
    apply hb.away q hq
    simp only [MeasuredCanonicalModLayout.extended,List.mem_cons,List.mem_append,List.not_mem_nil,
      or_false] at bad ⊢
    tauto
  have len : (bits++[zbit]).length=K.extended.length := by
    simp [MeasuredCanonicalModLayout.extended,hb.len,hw.out]
  have carryLen : K.carry.length+1=K.extended.length := by
    simp [hw.carry,MeasuredCanonicalModLayout.extended,hw.out]
  intro s m hf
  have clean := MeasuredCanonicalModLayout.Frame.clean K hn base s.basis X false false hf hc hi
  have val : mappedValue (bits++[zbit]) s.basis=A := by
    rw [mappedValue_zbit,← hs]
    exact mappedValue_congr _ _ _ (fun q hq => hf.2.2.2 q (bits_off_mutable K n bits hb q hq))
  have ext : regValue K.extended s.basis=X := by
    rw [K.extended_value n hw,hf.1,hf.2.1]
    simp
  obtain ⟨hp,he,hv⟩ := mappedAdd_correct (bits++[zbit]) K.extended K.carry K.cin nd away len carryLen s m clean.1
  have total : regValue K.extended (run (mappedAdd (bits++[zbit]) K.extended K.carry K.cin) m s).basis=A+X := by
    rw [hv,val,ext,clean.2,Bool.toNat_false,Nat.add_zero]
    simp [MeasuredCanonicalModLayout.extended,hw.out,Nat.mod_eq_of_lt hAX]
  exact ⟨hp,MeasuredCanonicalModLayout.Frame.afterExtended K n hw hn base s.basis _ X (A+X) false false hf he total⟩

theorem eraseMF_frame (K : MeasuredCanonicalModLayout) (n : Nat) (hw : K.Widths n)
    (hn : K.wires.Nodup) (bits : List MappedBit) (hb : BitsOK K n bits) (npos : 0<n)
    (base : BasisState) (A R : Nat) (H : Bool)
    (ha : mappedValue bits base=A) (hc : ∀q∈K.carry,base q=false) (hi : base K.cin=false) :
    Triple (K.Frame base R H (decide (R<A)))
      (eraseLtChainM K.out bits (K.carry.take (K.out.length-1)) K.cin K.flag)
      (K.Frame base R H false) := by
  have nd : (K.flag::K.cin::(K.out++K.carry.take (K.out.length-1))).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q; have h := List.nodup_iff_count.mp hn q
    have takeBound := (List.take_sublist (K.out.length-1) K.carry).count_le q
    simp only [MeasuredCanonicalModLayout.wires,List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have hy : ∀q∈mappedWires bits,q∉K.flag::K.cin::(K.out++K.carry.take (K.out.length-1)) := by
    intro q hq bad
    apply hb.away q hq
    have h2 : q∈K.carry.take (K.out.length-1) → q∈K.carry := List.mem_of_mem_take
    simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at bad ⊢
    tauto
  have carryLen : (K.carry.take (K.out.length-1)).length+1=bits.length := by
    simp [hw.carry,hw.out,hb.len]; omega
  have away := K.flags_away hn
  intro s m hf
  have clean := MeasuredCanonicalModLayout.Frame.clean K hn base s.basis R H (decide (R<A)) hf hc hi
  have src : mappedValue bits s.basis=A := by
    rw [← ha]
    exact mappedValue_congr _ _ _ (fun q hq => hf.2.2.2 q (bits_off_mutable K n bits hb q hq))
  have pred : s.basis K.flag=decide (regValue K.out s.basis<
      mappedValue bits s.basis+(s.basis K.cin).toNat) := by
    rw [hf.1,src,clean.2,Bool.toNat_false,Nat.add_zero,hf.2.2.1]
  rw [eraseLtChainM_correct K.out bits _ K.cin K.flag nd hy (hw.out.trans hb.len.symm)
    carryLen s m (fun q hq => clean.1 q (List.mem_of_mem_take hq)) pred]
  refine ⟨by trivial,?_,?_,?_,?_⟩
  · apply Eq.trans (regValue_congr _ _ _ ?_) hf.1
    intro q hq
    have ne : q≠K.flag := fun bad => away.2.1 (by simp [MeasuredCanonicalModLayout.extended,←bad,hq])
    simp [writeBit,ne]
  · simpa [writeBit,away.2.2.2] using hf.2.1
  · simp [writeBit]
  · intro q hq
    have ne : q≠K.flag := fun bad => hq (by simp [MeasuredCanonicalModLayout.mutable,bad])
    simpa [writeBit,ne] using hf.2.2.2 q hq

theorem qprogM_frame (K : MeasuredCanonicalModLayout) (n c p : Nat) (hw : K.Widths n)
    (hn : K.wires.Nodup) (bits : List MappedBit) (hb : BitsOK K n bits)
    (npos : 0<n) (hpc : p+c=2^n) (hcp : 0<c)
    (base : BasisState) (A X : Nat) (ha : mappedValue bits base=A)
    (hA : A<p) (hX : X<p) (hc : ∀q∈K.carry,base q=false) (hi : base K.cin=false) :
    Triple (K.Frame base X false false) (qprogM K bits p)
      (K.Frame base ((A+(p-1-X))%p) false false) := by
  have bpos : 0<2^n := by positivity
  have hR : 2^n-1-X=(p-1-X)+c := by omega
  have sumBound : A+(2^n-1-X)<2^(n+1) := by rw [Nat.pow_succ]; omega
  have flagPred : decide (2^n≤A+(2^n-1-X))=decide ((A+(p-1-X))%p<A) := by
    have h := exactFold_recover_flag (p-1-X) A p (by omega) hA
    rw [Nat.add_comm (p-1-X) A] at h
    apply decide_eq_decide.mpr
    rw [h]
    omega
  generalize hr : decide (2^n≤A+(2^n-1-X))=r at flagPred
  have s1 := QCore.not_frame K n hw hn base X
  have s2 := sumM_frame K n hw hn bits hb base A (2^n-1-X) ha sumBound hc hi
  rw [hr] at s2
  have s3 : Triple (K.Frame base ((A+(2^n-1-X))%2^n) r false) [.CX K.high K.flag]
      (K.Frame base ((A+(2^n-1-X))%2^n) r r) := by
    simpa using K.cx_flag_frame hn base ((A+(2^n-1-X))%2^n) r false
  have s4 := QCore.x_flag_frame K hn base ((A+(2^n-1-X))%2^n) r r
  have s5 := QCore.correctionT_frame K n p hw hn (by omega) npos base ((A+(2^n-1-X))%2^n) r (!r) hc hi
  have vlow : ((if !r then p else 0)+(A+(2^n-1-X))%2^n)%2^n=(A+(p-1-X))%p := by
    cases r
    · have small : ¬2^n≤A+(2^n-1-X) := by simpa using hr
      have lt : A+(p-1-X)<p := by omega
      simp only [Bool.not_false,if_true]
      rw [Nat.mod_eq_of_lt (show A+(2^n-1-X)<2^n by omega),Nat.mod_eq_of_lt lt,
        show p+(A+(2^n-1-X))=(A+(p-1-X))+2^n by omega,Nat.add_mod_right,Nat.mod_eq_of_lt (by omega)]
    · have big : 2^n≤A+(2^n-1-X) := by simpa using hr
      have ge : p≤A+(p-1-X) := by omega
      simp only [Bool.not_true,Bool.false_eq_true,if_false,Nat.zero_add]
      rw [Nat.mod_mod,Nat.mod_eq_sub_mod big,Nat.mod_eq_of_lt (by omega),Nat.mod_eq_sub_mod ge,
        Nat.mod_eq_of_lt (by omega)]
      omega
  have hx : (r ^^ !r)=true := by cases r <;> rfl
  rw [vlow,hx] at s5
  have s6 := QCore.x_high_frame K hn base ((A+(p-1-X))%p) true (!r)
  have s7 := QCore.x_flag_frame K hn base ((A+(p-1-X))%p) (!true) (!r)
  simp only [Bool.not_true,Bool.not_not] at s7
  have s8 := eraseMF_frame K n hw hn bits hb npos base A ((A+(p-1-X))%p) false ha hc hi
  rw [←flagPred] at s8
  have all := ((((((s1.seq s2).seq s3).seq s4).seq s5).seq s6).seq s7).seq s8
  simpa only [qprogM,List.append_assoc,List.cons_append,List.singleton_append] using all

theorem qprogM_correct (K : MeasuredCanonicalModLayout) (n c p : Nat) (hw : K.Widths n)
    (hn : K.wires.Nodup) (bits : List MappedBit) (hb : BitsOK K n bits)
    (npos : 0<n) (hpc : p+c=2^n) (hcp : 0<c)
    (A X : Nat) (hA : A<p) (hX : X<p) (s : State) (m : List Bool)
    (ha : mappedValue bits s.basis=A) (hx : regValue K.out s.basis=X)
    (hh : s.basis K.high=false) (hf : s.basis K.flag=false)
    (hc : ∀q∈K.carry,s.basis q=false) (hi : s.basis K.cin=false) :
    (run (qprogM K bits p) m s).phase=s.phase ∧
    regValue K.out (run (qprogM K bits p) m s).basis=(A+(p-1-X))%p ∧
    ∀q,q∉K.out → (run (qprogM K bits p) m s).basis q=s.basis q := by
  have initial : K.Frame s.basis X false false s.basis := ⟨hx,hh,hf,fun _ _ => rfl⟩
  obtain ⟨phase,post⟩ := qprogM_frame K n c p hw hn bits hb npos hpc hcp s.basis A X ha hA hX hc hi s m initial
  refine ⟨phase,post.1,?_⟩
  intro q hq
  by_cases high : q=K.high
  · subst q; exact post.2.1.trans hh.symm
  by_cases flag : q=K.flag
  · subst q; exact post.2.2.1.trans hf.symm
  exact post.2.2.2 q (by simpa only [MeasuredCanonicalModLayout.mutable,List.mem_append,List.mem_cons,
    List.not_mem_nil,or_false,not_or] using ⟨hq,high,flag⟩)

theorem qprogM_counts (K : MeasuredCanonicalModLayout) (n p : Nat) (hw : K.Widths n) (hn : 0<n)
    (bits : List MappedBit) (hbl : bits.length=n) :
    toffoliCount (qprogM K bits p)=3*n-2 ∧ measurementCount (qprogM K bits p)=3*n-1 := by
  have extendedLength : K.extended.length=n+1 := by simp [MeasuredCanonicalModLayout.extended,hw.out]
  have sourceLength : (bits++[zbit]).length=n+1 := by simp [hbl]
  have sumCounts := mappedAdd_counts (bits++[zbit]) K.extended K.carry K.cin
    (sourceLength.trans extendedLength.symm) (by rw [hw.carry,extendedLength])
  have correction := mappedConstAdd_counts (some K.flag) K.out (K.carry.take (K.out.length-1)) K.cin p
    (by simp [hw.carry,hw.out]; omega)
  have eraseCounts := eraseLtChainM_counts K.out bits (K.carry.take (K.out.length-1)) K.cin K.flag
    (hw.out.trans hbl.symm) (by simp [hw.carry,hw.out,hbl]; omega)
  have nc := notRegister_counts K.out
  constructor
  · simp only [qprogM,toffoliCount_append,toffoliCount]
    rw [sumCounts.1,correction.1,eraseCounts.1,nc.1,extendedLength,hbl,hw.out]
    -- K4-D (replay budget): `omega` on the bare arithmetic goal (the count facts are no longer needed)
    clear sumCounts correction eraseCounts nc
    omega
  · simp only [qprogM,measurementCount_append,measurementCount]
    rw [sumCounts.2,correction.2,eraseCounts.2,nc.2,extendedLength,hbl,hw.out]
    clear sumCounts correction eraseCounts nc
    omega


theorem qprogM_support (K : MeasuredCanonicalModLayout) (bits : List MappedBit) (p : Nat) :
    wires (qprogM K bits p)⊆(K.out++K.carry++[K.high,K.cin,K.flag]++mappedWires bits).toFinset := by
  have hn := notRegister_wires K.out
  have hs := mappedAdd_wires_subset (bits++[zbit]) K.extended K.carry K.cin
  rw [mappedWires_zbit] at hs
  have hm := mappedConstAdd_wires_subset (some K.flag) K.out (K.carry.take (K.out.length-1)) K.cin p
  have he := eraseLtChainM_wires K.out bits (K.carry.take (K.out.length-1)) K.cin K.flag
  have tk : ∀q,q∈K.carry.take (K.out.length-1) → q∈K.carry := fun q h => List.mem_of_mem_take h
  intro q hq
  simp only [qprogM,wires_append,Finset.mem_union] at hq
  simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
  rcases hq with ((((((hq|hq)|hq)|hq)|hq)|hq)|hq)
  · rw [hn] at hq; simp only [List.mem_toFinset] at hq; tauto
  · have h := hs hq
    simp only [List.mem_toFinset,List.mem_append,MeasuredCanonicalModLayout.extended,List.mem_cons,
      List.not_mem_nil,or_false] at h
    tauto
  · simp [wires,Instr.wires] at hq; tauto
  · have h := hm hq
    simp only [List.mem_toFinset,List.mem_append,Option.toList_some,List.mem_cons,List.not_mem_nil,
      or_false] at h
    have h2 := tk q
    tauto
  · simp [wires,Instr.wires] at hq; tauto
  · simp [wires,Instr.wires] at hq; tauto
  · have h := he hq
    simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at h
    have h2 := tk q
    tauto

theorem qprogM_physical (K : MeasuredCanonicalModLayout) (bits : List MappedBit) (p n : Nat)
    (hn : K.wires.Nodup) (hb : BitsOK K n bits) : GatePhysical (qprogM K bits p) := by
  have count := List.nodup_iff_count.mp hn
  have hf : K.flag≠K.high := fun h => (K.flags_away hn).2.2.2 h.symm
  have ndsum : (K.cin::K.extended++K.carry).Nodup := by
    apply List.nodup_iff_count.mpr; intro q
    have h := count q
    simp only [MeasuredCanonicalModLayout.wires,MeasuredCanonicalModLayout.extended,
      List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
  have nd : (K.cin::K.out++K.carry.take (K.out.length-1)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q; have h := count q
    have takeBound := (List.take_sublist (K.out.length-1) K.carry).count_le q
    simp only [MeasuredCanonicalModLayout.wires,List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have hsum : GatePhysical (mappedAdd (bits++[zbit]) K.extended K.carry K.cin) := by
    apply mappedAdd_physical _ _ _ _ ndsum
    intro b hbm q hq bad
    have hq' : q∈mappedWires (bits++[zbit]) := by
      simp only [mappedWires,List.mem_flatMap]
      exact ⟨b,hbm,by simpa using hq⟩
    rw [mappedWires_zbit] at hq'
    apply hb.away q hq'
    simp only [MeasuredCanonicalModLayout.extended,List.mem_cons,List.mem_append,List.not_mem_nil,
      or_false] at bad ⊢
    tauto
  have hm : GatePhysical (mappedConstAdd (some K.flag) K.out (K.carry.take (K.out.length-1)) K.cin p) := by
    apply mappedConstAdd_physical _ _ _ _ _ nd
    intro q hq bad
    have eq : q=K.flag := by simpa [eq_comm] using hq
    subst q
    have h := List.nodup_iff_count.mp hn K.flag
    have pos := List.count_pos_iff.mpr bad
    have takeBound := (List.take_sublist (K.out.length-1) K.carry).count_le K.flag
    simp only [MeasuredCanonicalModLayout.wires,List.count_append,List.count_cons,List.count_nil,
      beq_self_eq_true,if_true] at h pos
    omega
  have herase : GatePhysical (eraseLtChainM K.out bits (K.carry.take (K.out.length-1)) K.cin K.flag) := by
    apply eraseLtChainM_physical _ _ _ _ _ nd
    intro q hq bad
    apply hb.away q hq
    have h2 : q∈K.carry.take (K.out.length-1) → q∈K.carry := List.mem_of_mem_take
    simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at bad ⊢
    tauto
  have g1 : GatePhysical [Instr.CX K.high K.flag,Instr.X K.flag] := by
    simpa [GatePhysical,PhysicalInstr,ProperGate] using hf.symm
  have g2 : GatePhysical [Instr.CX K.flag K.high] := by
    simpa [GatePhysical,PhysicalInstr,ProperGate] using hf
  have g3 : GatePhysical [Instr.X K.high,Instr.X K.flag] := by
    simp [GatePhysical,PhysicalInstr,ProperGate]
  simp only [qprogM,gatePhysical_append]
  exact ⟨⟨⟨⟨⟨⟨notRegister_physical K.out,hsum⟩,g1⟩,hm⟩,g2⟩,g3⟩,herase⟩


end ECDSAAdd.Entrant.StairSquareBMapped
end Merge_StairSquareBMapped_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareBEFold_at_QTop` -/
section Merge_StairSquareBEFold_at_QTop

/-! # LT36 (U3b): hole-free e-fold for the B body

The record's e-fold `eFoldTq L c = eFlip ++ (fillInK ++ qprog4Tq L.measuredCore p ++ fillOutKnown) ++ eFlip`
reads the 163-bit accumulator `accReg L = work.take 163` as the full 256-bit `work` register, so
its carries live on `foldCarry` (all of pad, overflowPad, productHigh, workHigh), which contains
the 39 hole sites (carries 204..238, 240..243).  `eFoldB` keeps the fill/unfill pieces and
replaces the middle by the mapped-source adder `qprogM` reading `accReg` + 93 constant zeros;
the hole carries move onto `work[163..201]`, which are zero at the middle's entry. -/

set_option autoImplicit false
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareBEFold
open ECDSAAdd ECDSAAdd.Entrant Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout RecordedQuantum
open StairSquareBMapped ControlLoan1589BFFold

/-- Carry bank of the new middle: `foldCarry` with positions 204..238 and 240..243 replaced by
`work[163..197]` and `work[198..201]`. -/
def carryB (L : CuccaroStreamedSquareWideLayout) : List Wire :=
  L.foldPad.take 199++((L.core.work.drop 163).take 40++((L.foldPad.drop 239).take 1++
    (((L.core.work.drop 163).drop 40).take 4++(L.foldPad.drop 244++[L.core.productHigh,L.core.workHigh]))))

/-- The adder layout (its `src` field is a dummy; `qprogM` does not use it). -/
def coreB (L : CuccaroStreamedSquareWideLayout) : MeasuredCanonicalModLayout :=
  {src:=L.core.product.take 256,out:=L.core.out,carry:=carryB L,
    high:=L.core.outHigh,cin:=L.core.cin,flag:=L.core.modFlag}

def bitsB (L : CuccaroStreamedSquareWideLayout) : List MappedBit :=
  mappedRead (ECDSAAdd.Entrant.accReg L) false++List.replicate 93 zbit

def midB (L : CuccaroStreamedSquareWideLayout) : Program := qprogM (coreB L) (bitsB L) SquareReduction.p

def accFoldB (L : CuccaroStreamedSquareWideLayout) (a : AccItem) : Program :=
  OwnDiagAll12Square.fillInK L a++midB L++SourceFourPrefix130Develop.fillOutKnown L a

def eFoldB (L : CuccaroStreamedSquareWideLayout) (c : Wire) : Program :=
  eFlip L c++(accFoldB L (eItem L)++eFlip L c)

theorem carryB_mem (L : CuccaroStreamedSquareWideLayout) (q : Wire) (hq : q∈carryB L) :
    q∈L.foldPad ∨ q∈L.core.work.drop 163 ∨ q=L.core.productHigh ∨ q=L.core.workHigh := by
  simp only [carryB,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hq
  rcases hq with h|h|h|h|h|h|h
  · exact Or.inl (List.mem_of_mem_take h)
  · exact Or.inr (Or.inl (List.mem_of_mem_take h))
  · exact Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h))
  · exact Or.inr (Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h)))
  · exact Or.inl (List.mem_of_mem_drop h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr h))

theorem carryB_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (carryB L).length=256 := by
  have fp : L.foldPad.length=254 := by simp [foldPad,hw.core.pad,hw.overflowPad]
  simp [carryB,fp,hw.core.work]

theorem coreB_widths (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (coreB L).Widths 256 :=
  ⟨by simp [coreB,hw.core.product],hw.core.out,carryB_length L hw⟩

theorem mappedValue_replicate_zbit (k : Nat) (s : BasisState) :
    mappedValue (List.replicate k zbit) s=0 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [List.replicate_succ,mappedValue,ih]
    simp [zbit,MappedBit.value]

theorem mappedWires_replicate_zbit (k : Nat) : mappedWires (List.replicate k zbit)=[] := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [List.replicate_succ]
    simp only [mappedWires,List.flatMap_cons] at ih ⊢
    rw [ih]
    simp [zbit]

theorem bitsB_value (L : CuccaroStreamedSquareWideLayout) (s : BasisState) :
    mappedValue (bitsB L) s=regValue (ECDSAAdd.Entrant.accReg L) s := by
  rw [bitsB,mappedValue_append,mappedRead_value,mappedValue_replicate_zbit]
  simp

theorem bitsB_wires (L : CuccaroStreamedSquareWideLayout) :
    mappedWires (bitsB L)=ECDSAAdd.Entrant.accReg L := by
  have h : mappedWires (bitsB L)=mappedWires (mappedRead (ECDSAAdd.Entrant.accReg L) false)++
      mappedWires (List.replicate 93 zbit) := by
    simp [bitsB,mappedWires,List.flatMap_append]
  rw [h,mappedRead_wires,mappedWires_replicate_zbit,List.append_nil]

theorem bitsB_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (bitsB L).length=256 := by
  simp [bitsB,mappedRead,ECDSAAdd.Entrant.accReg,hw.core.work]

/-- The new accumulator fold: same triple as `accFoldQ_frameKTq`, under two layout facts
(`hnB`, `hbB`) that are decided for the concrete layout. -/
theorem accFoldB_frame (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (hnB : (coreB L).wires.Nodup) (hbB : BitsOK (coreB L) 256 (bitsB L))
    (base : BasisState) (a : AccItem)
    (hv : AccView L base a) (hc : L.PairClean base) (O : Nat) (hO : O<SquareReduction.p) :
    Triple (SquareFrame L.core.out base O) (accFoldB L a)
      (SquareFrame L.core.out base ((Acc.accVal base 0 a.spec+(SquareReduction.p-1-O))%SquareReduction.p)) := by
  intro s m hf
  have lens := acc_lengths L hw
  have clean := L.squareFrame_clean hn base s.basis O hf hc
  let b0 := s.basis
  have prodOut := L.product_out_disjoint hn
  have auxAway (q : Wire) (hq : q∈L.foldPad++L.core.work++[L.core.productHigh,L.core.outHigh,
      L.core.workHigh,L.core.cin,L.core.normFlag,L.core.modFlag]) : q∉L.core.out :=
    (L.pairAuxAway hn q hq).2
  have workZero : ∀q∈L.core.work,b0 q=false := (regValue_zero _ _).mp clean.work
  have padZero : ∀q∈L.foldPad,b0 q=false := (regValue_zero _ _).mp clean.pad
  have hz : ∀q∈accZ L,b0 q=false := by
    intro q hq
    rcases accZ_mem L q hq with h|h
    · exact padZero q h
    · exact workZero q (List.mem_of_mem_drop h)
  have hb : ∀q∈accBank L,b0 q=false := fun q hq => padZero q (List.mem_of_mem_take hq)
  have hW0 : ∀q∈wTemp L,b0 q=false := fun q hq => workZero q (wTemp_work L q hq)
  have prodNotOut (q : Wire) (hq : q∈L.core.product) : q∉L.core.out :=
    fun ho => List.disjoint_left.mp prodOut hq ho
  have agree0 : ∀q∈L.core.product,b0 q=base q := fun q hq => hf.2 q (prodNotOut q hq)
  let A := Acc.accVal base 0 a.spec
  have hA : A<2^163 := Acc.accVal_lt base 163 a.spec 0 (by norm_num) hv.specValid
  have accZero : regValue (ECDSAAdd.Entrant.accReg L) b0=0 :=
    (regValue_zero _ _).mpr (fun q hq => workZero q (accReg_work L q hq))
  have hbuild := OwnDiagAll12Square.fillInK_triple L hw hn base a hv b0 agree0 hz hb clean.cin hW0
  rw [accFoldB,List.append_assoc,run_append,run_append]
  let mb := measurementCount (OwnDiagAll12Square.fillInK L a)
  let mk := measurementCount (midB L)
  let u := run (OwnDiagAll12Square.fillInK L a) (m.take mb) s
  have eu := hbuild s (m.take mb) ⟨accZero,fun _ _ => rfl⟩
  change u.phase=s.phase ∧ SquareFrame (ECDSAAdd.Entrant.accReg L) b0 A u.basis at eu
  have keepU (q : Wire) (hq : q∈L.foldPad++[L.core.productHigh,L.core.outHigh,L.core.workHigh,L.core.cin,
      L.core.normFlag,L.core.modFlag]++L.core.out++L.core.product++L.core.work.drop 163) : u.basis q=b0 q :=
    eu.2.2 q (accReg_away L hn q hq)
  have accU : mappedValue (bitsB L) u.basis=A := by
    rw [bitsB_value]
    exact eu.2.1
  have outU : regValue L.core.out u.basis=O :=
    (regValue_congr _ _ _ (fun q hq => keepU q (by simp [hq]))).trans hf.1
  have hp : SquareReduction.p+SquareReduction.c=2^256 := by
    norm_num [SquareReduction.p,SquareReduction.B,SquareReduction.c]
  have hAp : A<SquareReduction.p := lt_of_lt_of_le hA (by norm_num [SquareReduction.p,SquareReduction.B,SquareReduction.c])
  have carryU : ∀q∈(coreB L).carry,u.basis q=false := by
    intro q hq
    rcases carryB_mem L q hq with h|h|h|h
    · exact (keepU q (by simp [h])).trans (padZero q h)
    · exact (keepU q (by simp [h])).trans (workZero q (List.mem_of_mem_drop h))
    · subst h; exact (keepU _ (by simp)).trans clean.productHigh
    · subst h; exact (keepU _ (by simp)).trans clean.workHigh
  have ek := qprogM_correct (coreB L) 256 SquareReduction.c SquareReduction.p (coreB_widths L hw)
    hnB (bitsB L) hbB (by decide) hp (by norm_num [SquareReduction.c]) A O hAp hO u ((m.drop mb).take mk)
    accU outU ((keepU _ (by simp [coreB])).trans clean.outHigh)
    ((keepU _ (by simp [coreB])).trans clean.modFlag)
    carryU ((keepU _ (by simp [coreB])).trans clean.cin)
  let v := run (midB L) ((m.drop mb).take mk) u
  change v.phase=u.phase ∧ regValue L.core.out v.basis=(A+(SquareReduction.p-1-O))%SquareReduction.p ∧
    ∀q,q∉L.core.out → v.basis q=u.basis q at ek
  let base2 : BasisState := fun q => if q∈L.core.out then v.basis q else b0 q
  have b2off (q : Wire) (hq : q∉L.core.out) : base2 q=b0 q := by simp [base2,hq]
  have accOut (q : Wire) (hq : q∈ECDSAAdd.Entrant.accReg L) : q∉L.core.out :=
    auxAway q (by simp [accReg_work L q hq])
  have frame2 : SquareFrame (ECDSAAdd.Entrant.accReg L) base2 A v.basis := by
    refine ⟨?_,?_⟩
    · exact (regValue_congr _ _ _ (fun q hq => ek.2.2 q (accOut q hq))).trans eu.2.1
    · intro q hq
      by_cases ho : q∈L.core.out
      · simp [base2,ho]
      · rw [b2off q ho,ek.2.2 q ho]; exact eu.2.2 q hq
  have hz2 : ∀q∈accZ L,base2 q=false := by
    intro q hq
    have ho : q∉L.core.out := by
      simp only [accZ,List.mem_append] at hq
      rcases hq with hq|hq
      · exact auxAway q (by simp [List.mem_of_mem_drop hq])
      · exact auxAway q (by simp [List.mem_of_mem_drop hq])
    rw [b2off q ho]; exact hz q hq
  have hb2 : ∀q∈accBank L,base2 q=false := by
    intro q hq
    have ho : q∉L.core.out := auxAway q (by simp [List.mem_of_mem_take hq])
    rw [b2off q ho]; exact hb q hq
  have hi2 : base2 L.core.cin=false := by
    rw [b2off _ (auxAway _ (by simp))]; exact clean.cin
  have hW2 : ∀q∈wTemp L,base2 q=false := by
    intro q hq
    have ho : q∉L.core.out := auxAway q (by simp [wTemp_work L q hq])
    rw [b2off q ho]; exact hW0 q hq
  have agree2 : ∀q∈L.core.product,base2 q=base q :=
    fun q hq => (b2off q (prodNotOut q hq)).trans (agree0 q hq)
  have hun := SourceFourPrefix130Develop.fillOutKnown_triple L hw hn base a hv base2 agree2 hz2 hb2 hi2 hW2
  have eo := hun v ((m.drop mb).drop mk) frame2
  refine ⟨eo.1.trans (ek.1.trans eu.1),?_,?_⟩
  · have e : regValue L.core.out (run (SourceFourPrefix130Develop.fillOutKnown L a) ((m.drop mb).drop mk) v).basis=
        regValue L.core.out v.basis := by
      apply regValue_congr; intro q hq
      have na : q∉ECDSAAdd.Entrant.accReg L := fun h => accOut q h hq
      rw [eo.2.2 q na]; simp [base2,hq]
    rw [e,ek.2.1]
  · intro q hq
    by_cases ha : q∈ECDSAAdd.Entrant.accReg L
    · have z := (regValue_zero _ _).mp eo.2.1 q ha
      rw [z]
      exact ((regValue_zero _ _).mp hc.work q (accReg_work L q ha)).symm
    · rw [eo.2.2 q ha,b2off q hq]; exact hf.2 q hq

/-- Same statement as the record's `eCore_stepTq`, for the new accumulator fold. -/
theorem eCore_stepB (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (hnB : (coreB L).wires.Nodup) (hbB : BitsOK (coreB L) 256 (bitsB L))
    (base : BasisState) (hc : L.PairClean base) (O E : Nat) (hO : O<SquareReduction.p) :
    Triple (BState L base O E 0) (accFoldB L (eItem L))
      (BState L base ((4294968272*E+(SquareReduction.p-1-O))%SquareReduction.p) E 0) := by
  apply lift_out L hn base O E 0 _ (accFoldB L (eItem L))
  intro s m h
  have tr := accFoldB_frame L hw hn hnB hbB s.basis (eItem L) (eItem_view L hw s.basis)
    (bstate_clean L hn base hc O E s.basis h) O hO s m ⟨h.1,fun _ _ => rfl⟩
  have e : Acc.accVal s.basis 0 (eItem L).spec=4294968272*E := by
    rw [show (eItem L).spec=earlyHTerms (eReg L) from rfl,accVal_earlyH,h.2.1]
  rw [e] at tr
  exact ⟨tr.1,tr.2.1,tr.2.2⟩

/-- The new e-fold, in the form used by the B body proof (`tf` of `LocalSevenBody.frame`). -/
theorem eFoldB_step (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (hnB : (coreB L).wires.Nodup) (hbB : BitsOK (coreB L) 256 (bitsB L))
    (c : Wire) (hcw : c∉L.wires) (base : BasisState) (hc : L.PairClean base) (O E : Nat)
    (hO : O<SquareReduction.p) :
    Triple (BState L base O E 0) (eFoldB L c)
      (BState L base ((4294968272*flipE (base c) E+(SquareReduction.p-1-O))%SquareReduction.p) E 0) := by
  have f1 := eFlip_step L hw hn base c hcw O E 0
  have f2 := eCore_stepB L hw hn hnB hbB base hc O (flipE (base c) E) hO
  have f3 := eFlip_step L hw hn base c hcw ((4294968272*flipE (base c) E+(SquareReduction.p-1-O))%SquareReduction.p)
    (flipE (base c) E) 0
  rw [flipE_flipE] at f3
  exact f1.seq (f2.seq f3)

