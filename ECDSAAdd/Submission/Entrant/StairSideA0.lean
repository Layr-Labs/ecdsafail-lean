/-- Full-State semantic lift for the comparison loan recursion. -/
private theorem lift_compareLoan_run_eq (d : Nat) (roles : List Wire) (forward : Bool)
    (as bs cs : List Wire) (cin last target : Wire)
    (s : State) (m n : List Bool)
    (hab : as.length = bs.length) (hc : cs.length + 1 = bs.length)
    (hd : d + 1 ≤ cs.length)
    (nd : (target :: cin :: (as ++ bs ++ (cs ++ [last]))).Nodup)
    (clean : ∀ q ∈ cs ++ [last], s.basis q = false)
    (roleTail : ∀ q ∈ roles.take d, q ∈ cs.drop (d + 1))
    (post : forward = true →
      (run (Arithmetic.compareChain none as bs (cs ++ [last]) cin target)
        n s).basis target = false) :
    run (compareLoan d roles forward as bs cs cin target) m s =
      run (Q6LifetimeResearch.compareChain forward as bs cs cin target) n s := by
  let bits := mappedRead as false
  let layers := compareLayers forward as bs cs cin target
  let topProgram := compareTop forward as bs cs cin target
  let P := emitUps (layers.take (d + 1))
  let U := emitSweep (layers.drop (d + 1)) topProgram
  let u := run P [] s
  let reference := Arithmetic.compareChain none (as.drop (d + 1))
    (bs.drop (d + 1)) (cs.drop (d + 1) ++ [last])
    (carryAfter (d + 1) cs cin) target
  let v := run reference [] u
  let out := run (Arithmetic.compareChain none as bs (cs ++ [last]) cin target) n s
  have mappedND : (cin :: (bs ++ cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp nd q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega
  have sourceAway : ∀ q ∈ mappedWires bits, q ∉ cin :: (bs ++ cs) := by
    intro q hq bad
    simp only [bits, mappedRead_wires] at hq
    have h := List.nodup_iff_count.mp nd q
    have ha := List.count_pos_iff.mpr hq
    simp only [List.mem_cons, List.mem_append] at bad
    rcases bad with rfl | targetMem | carryMem
    · simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h ha
      first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega
    · have hb := List.count_pos_iff.mpr targetMem
      simp only [List.count_cons, List.count_append, List.count_nil] at h ha hb
      first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega
    · have hcq := List.count_pos_iff.mpr carryMem
      simp only [List.count_cons, List.count_append, List.count_nil] at h ha hcq
      first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega
  have prefixShapes := compare_prefix_shapes (d + 1) forward as bs cs cin target
    hab hc hd
  have borrowShapes := compare_prefix_shapes d forward as bs cs cin target
    hab hc (by first | exact hc | exact hab | exact hd | exact hc.symm | exact hy | exact Nat.le_of_succ_le hd | exact Nat.le_succ _ | exact Nat.le_succ_of_le hd | (rw [← hc]; exact Nat.le_succ_of_le hd) | (rw [bitsLength, ← hc]; exact Nat.le_succ_of_le hd) | (rw [hab]; done) | (rw [← hc]; exact hd) | (rw [hy, ← hc]; exact hd) | (rw [hy, ← hc]; exact Nat.le_of_succ_le hd) | (rw [← hc, Nat.sub_add_comm hd]; done) | (rw [← hc]; exact Nat.le_of_succ_le hd) | omega)
  have prefixShape : P = carryPrefix (d + 1) bits bs cs cin := prefixShapes.1
  have eraseShape : emitErases (layers.take d) = erasePrefix d bits bs cs cin :=
    borrowShapes.2.1
  have borrowShape : emitUps (layers.take d) = carryPrefix d bits bs cs cin :=
    borrowShapes.1
  have hostShape : layerHosts (layers.take d) = cs.take d := borrowShapes.2.2
  have prefixZero : measurementCount P = 0 := by
    rw [prefixShape]
    exact (carryPrefix_counts (d + 1) bits bs cs cin (by
