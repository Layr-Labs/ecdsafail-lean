theorem control_not_pool : L0.control ∉ L0.dialogPool := by
  intro hq
  have nd := List.nodup_iff_count.mp (L0.dialogUsed_nodup hn0) L0.control
  have hpos := List.count_pos_iff.mpr hq
  simp only [dialogUsedWires, List.count_append, List.count_cons, List.count_nil, beq_self_eq_true,
    if_true] at nd
  omega

theorem pool_ne_control (n : Nat) (hn : n < 2613) : L0.core.poolWire n ≠ L0.control := fun e =>
  control_not_pool (e ▸ Square5Placement.pool_member L0 hw0 n hn)



theorem control_ne_generic : L0.control ≠ G0 := by decide +kernel

theorem control_not_K : L0.control ∉ K0.wires := by
  -- K4-B (replay budget): `K0.wires = y ++ x ++ dialogPool.take 775` (as in the record's
  -- `dialogStreamedSquareWide_nodup`), then `control_not_pool`; no pool walk
  have heq : K0.wires = L0.point.y ++ L0.point.x ++ L0.dialogPool.take 775 := by
    calc
      K0.wires =
          K0.core.y ++ K0.core.out ++
            (K0.core.product ++ K0.core.pad ++ K0.core.work ++
              [K0.core.productHigh, K0.core.outHigh, K0.core.workHigh, K0.core.cin,
                K0.core.normFlag, K0.core.modFlag, K0.core.sumCarry] ++
              K0.overflowPad) := by
