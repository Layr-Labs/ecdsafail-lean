/-! ## Hosts and the field-2 side conditions -/

/-- The side conditions of a field-2 plan force the hosts of the row
(`rowBudget i`) to zero on the selected (logical-kernel) side. -/
def HostsSide (C : Fin 6 → BasisState → BasisState → Prop) : Prop :=
  ∀ (i : Fin 6) (a b : BasisState), C i a b →
    ∀ r ∈ StairPhysicalLayout.hosts (StairField2V3Delta.rowBudget i),
