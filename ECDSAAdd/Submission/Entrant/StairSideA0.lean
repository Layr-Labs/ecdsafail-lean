/-- LT43f: inverse of the x-word relabelling of the repaired first-row orientation. -/
def xRelabelInv (q : Wire) : Wire := relabelInv (StairV3Primitives.xSwap q)

theorem xRelabel_inv (q : Wire) : StairV3Primitives.xRelabel (xRelabelInv q) = q := by
