  have b2 : wireBlock LT48K.pwF 717 312 = List.range' 4832 312 := blk 717 312 (by decide)
  have b3 : wireBlock LT48K.pwF 1284 257 = List.range' 5399 257 := blk 1284 257 (by decide)
  have b4 : LT48K.pwF 1800 = 5915 := by decide
