    (Finset.mem_range.mp ha) (Finset.mem_range.mp hb) hne hab

theorem high87_physical (L : Layout) (hn : L.Nodup 87) : GatePhysical (high87Program L) :=
  rename_gatePhysical (high87Map L) (Finset.range 33) Decoder87.pruned (high87_inj L hn)
    Decoder87.support_pruned Decoder87.proper_pruned

theorem high47_physical (L : Layout) (hn : L.Nodup 47) : GatePhysical (high47Program L) :=
  rename_gatePhysical (high47Map L) (Finset.range 16) Decoder3.pruned (high47_inj L hn)
    Decoder3.support_pruned Decoder3.proper_pruned

theorem high22_physical (L : Layout) (hn : L.Nodup 22) : GatePhysical (high22Program L) :=
  rename_gatePhysical (high22Map L) (Finset.range 16) Decoder3.pruned (high22_inj L hn)
    Decoder3.support_pruned Decoder3.proper_pruned

theorem high12_physical (L : Layout) (hn : L.Nodup 12) : GatePhysical (high12Program L) :=
  rename_gatePhysical (high12Map L) (Finset.range 7) Decoder2.pruned (high12_inj L hn)
    Decoder2.support_pruned Decoder2.proper_pruned

theorem highProgram_physical (L : Layout) (B : Nat) (hn : L.Nodup B) :
    GatePhysical (highProgram L B) := by
  by_cases h87 : B = 87
  · subst h87
    rw [highProgram_87]
    exact high87_physical L hn
  by_cases h47 : B = 47
  · subst h47
    rw [highProgram_47]
    exact high47_physical L hn
  by_cases h22 : B = 22
  · subst h22
    rw [highProgram_22]
    exact high22_physical L hn
  by_cases h12 : B = 12
  · subst h12
    rw [highProgram_12]
    exact high12_physical L hn
  rw [highProgram_other L B h87 h47 h22 h12]
  exact (oneHot_physical_core (highBits L B) L.highWork (highDecoder_nodup L B hn)).1

theorem unpack_physical (L : Layout) (B : Nat) (hB : 3 ≤ B) (hn : L.Nodup B) :
    GatePhysical (unpack L B) :=
  unpackWithHigh_physical L B (highProgram L B) (highDecoder L B).program
    (highProgram_physical L B hn) (unpackFull_physical L B hB hn)

def natBitLength (x : Nat) : Nat := if x = 0 then 0 else x.log2 + 1

def signedWord (B u : Nat) (sigma : Bool) : Nat :=
  if sigma then (2 ^ B - u) % 2 ^ B else u % 2 ^ B

def compactF (B w v : Nat) : Nat :=
  (List.range (B - 2)).foldl (fun acc j =>
    if ((if j + 1 = natBitLength w then false else w.testBit j) ^^
      ((v - 1) / 2).testBit (B - 3 - j))
    then acc + 2 ^ j else acc) 0

def CodecDomain (B u v : Nat) (sigma : Bool) : Prop :=
  3 ≤ B ∧ 0 < v ∧ v % 2 = 1 ∧ u + v < 2 ^ B ∧
  natBitLength u + natBitLength v ≤ B ∧
  (u = 0 → v = 1 ∧ sigma = false)

def cleanOn (qs : List Wire) (s : BasisState) : Prop := ∀ q ∈ qs, s q = false


def CompactCode (L : Layout) (B u v : Nat) (sigma : Bool) (s : BasisState) : Prop :=
  let w := u - sigma.toNat
  regValue (reg L.A (bitWidth B)) s = natBitLength w ∧
  regValue (reg L.D (B - 2)) s = compactF B w v ∧
  s (L.D (B - 2)) = false ∧ s (L.D (B - 1)) = sigma ∧
  regValue (reg L.S B) s = 0 ∧
  cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
    (lowDecoder L B).sites ++ (highDecoder L B).sites) s



private theorem nat_lt_pow_bitLength (x : Nat) (hx : 0 < x) :
    x < 2 ^ natBitLength x := by
  have hlog : x.log2 < x.log2 + 1 := by omega
  have hpow := (Nat.log2_lt (by omega : x ≠ 0)).mp hlog
  simpa [natBitLength, ne_of_gt hx] using hpow

/-- Arithmetic non-overlap used by the descending sweep: once the magnitude
still reaches bit `j+1`, the mirrored `v` bit is outside its budget. -/
theorem nonoverlap_zero (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma)
    (hlarge : 2 ^ (j + 1) ≤ u - sigma.toNat) :
    v.testBit (B - 2 - j) = false := by
  have hu : u - sigma.toNat ≤ u := Nat.sub_le _ _
  have hw0 : 0 < u - sigma.toNat := lt_of_lt_of_le (by positivity) hlarge
  have hu0 : 0 < u := lt_of_lt_of_le hw0 hu
  have hub := nat_lt_pow_bitLength u hu0
  have hlen : j + 2 ≤ natBitLength u := by
    by_contra hbad
    have hle : natBitLength u ≤ j + 1 := by omega
    have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hle
    omega
  have hvb := nat_lt_pow_bitLength v hd.2.1
  have hvl : natBitLength v ≤ B - 2 - j := by
    have := hd.2.2.2.2.1
    omega
  have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hvl
  have hvpow : v < 2 ^ (B - 2 - j) := lt_of_lt_of_le hvb hp
  exact Nat.testBit_lt_two_pow hvpow

private theorem odd_half_testBit (v r : Nat) (hodd : v % 2 = 1) :
    ((v - 1) / 2).testBit r = v.testBit (r + 1) := by
  rw [Nat.testBit_succ]
  congr 1
  have hdiv := Nat.mod_add_div v 2
  omega

theorem nonoverlap_half_zero (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 2)
    (hlarge : 2 ^ (j + 1) ≤ u - sigma.toNat) :
    ((v - 1) / 2).testBit (B - 3 - j) = false := by
  rw [odd_half_testBit v (B - 3 - j) hd.2.2.1]
  have hz := nonoverlap_zero B u v sigma j hd hlarge
  have heq : B - 3 - j + 1 = B - 2 - j := by omega
  rwa [heq]

@[simp] private theorem reg_length (f : Nat → Wire) (n : Nat) : (reg f n).length = n := by
  simp [reg]

@[simp] private theorem cxInto_toffoli (c : Wire) (xs : List Wire) :
    toffoliCount (cxInto c xs) = 0 := (cxInto_counts c xs).1

@[simp] private theorem cxInto_measurements (c : Wire) (xs : List Wire) :
    measurementCount (cxInto c xs) = 0 := (cxInto_counts c xs).2

@[simp] private theorem cxTo_toffoli (t : Wire) (xs : List Wire) :
    toffoliCount (cxTo t xs) = 0 := (cxTo_counts t xs).1

@[simp] private theorem cxTo_measurements (t : Wire) (xs : List Wire) :
    measurementCount (cxTo t xs) = 0 := (cxTo_counts t xs).2

