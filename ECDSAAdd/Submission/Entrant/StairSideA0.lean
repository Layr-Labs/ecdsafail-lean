theorem E_borrow_fix (q : Wire) (hE : q ∈ E) : Prefix1590.borrow q = q := by
  simp only [E, List.mem_cons, List.not_mem_nil, or_false] at hE
  rcases hE with rfl | rfl | rfl
  · exact borrow_fix _ (by decide +kernel) (by decide +kernel)
  · exact borrow_fix _ (by decide +kernel) (by decide +kernel)
  · exact borrow_fix _ (by decide +kernel) (by decide +kernel)

theorem entryTail_avoid (q : Wire) (hq : q ∈ wires Rolling1588.entryTail) :
    q ∉ E ∧ ∀ i : Fin 8, q ≠ Prefix1590.payload0 i := by
  refine ⟨?_, ?_⟩
  · intro hE
    apply entryField_avoidE q hE
    unfold Rolling1588.entryField
    exact mem_third_of_four _ _ _ _ _ (mem_rename_fixed _ _ _ hq (E_borrow_fix q hE))
  · intro i h
    subst h
    exact Rolling1588.entryTail_payload_free i hq

theorem groups_prefix_sub (n : Nat) (hn : n ≤ 101) :
    wires (renameProgram (OB5.sig 511) (Rolling1588.groups true 1 n)) ⊆
      wires Rolling1588.entryTail := by
  have h := StairField2V3Entry.groups_true_add n (101 - n) 1
  rw [show n + (101 - n) = 101 by omega] at h
  intro q hq
  unfold Rolling1588.entryTail
  rw [rename_append', h, rename_append', wires_append, wires_append, wires_append,
    wires_append]
  exact Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_union_left _ hq)))

/-- LT46 (replay budget): the inclusion for abstract loans.  With the concrete
`StairConcrete.bestLoans` in the goal the kernel spent 47 s in the rewriting steps. -/
theorem slices_sub_gen (l1 l2 : StairSchedule.StairLoans) (f : Wire → Wire) (divide : Bool)
    (H : ∀ d j n, d ≤ 68 → wires (renameProgram f (l1.groups divide d j n)) ⊆
      wires (renameProgram f (l2.groups divide d j n)))
    (L : List (Nat × Nat × Nat)) : ∀ (c : Nat),
    StairLoanRecordShape.ForwardChain c L →
    wires (renameProgram f (StairLoanRecordShape.slices l1 divide L)) ⊆
      wires (renameProgram f (StairLoanRecordShape.slices l2 divide L)) := by
  induction L with
  | nil => intro c _; exact Finset.Subset.refl _
  | cons x rest ih =>
    obtain ⟨d, j, n⟩ := x
    intro c chain
    obtain ⟨_, hd, _, _, hr⟩ := chain
    show wires (renameProgram f
        (l1.groups divide d j n ++ StairLoanRecordShape.slices l1 divide rest)) ⊆
      wires (renameProgram f
        (l2.groups divide d j n ++ StairLoanRecordShape.slices l2 divide rest))
    rw [rename_append', rename_append', wires_append, wires_append]
    exact Finset.union_subset_union (H d j n hd) (ih (j + n) hr)

theorem slices_placed_sub : ∀ (L : List (Nat × Nat × Nat)) (c : Nat),
    StairLoanRecordShape.ForwardChain c L →
    wires (renameProgram (OB5.sig 511)
        (StairLoanRecordShape.slices StairConcrete.bestLoans true L)) ⊆
      wires (renameProgram (OB5.sig 511)
        (StairLoanRecordShape.slices StairSchedule.recordLoans true L)) :=
  slices_sub_gen _ _ _ _
    (fun d j n hd => StairLoanGroupSupport.placedGroups_sub true d hd j n)

theorem field_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.field_special_at origin X Y state 2409 (by simp) input
  have b := Rolling1588Frame.field_special_at origin X Y state 2410 (by simp) input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

/-! ## Entry: the loaned groups on the record trajectory -/


/-- The loaned group slices equal the record ones on every state reached by the record
division prefix through the first packet (independent tapes).  LT46 (replay budget): the
post-packet tape and state are opaque (`obtain ⟨x, hx⟩ : ∃ x, x = …`) instead of `let`s
(194 s of kernel time → < 0.3 s). -/
theorem entryGroups_inner (half : StairLoanRecordShape.HalfReplayHypothesis) (t0 : State)
    (f : StairConcreteAssembly.EntryFrame t0) (mp mS mF a b : List Bool)
    (L : List (Nat × Nat × Nat)) (hL : StairLoanRecordShape.ForwardChain 1 L)
    (hn : StairLoanRecordShape.sliceCount L ≤ 101) :
    let u := run (StairSchedule.fieldRename (Rolling1588.placedFirstPacket true ++
      FourScratchWindow.clearProgram)) mF
        (run (StairSchedule.paritySetup ++ StairSchedule.hostedX) mS
          (run (Rolling1588.firstPhase true) mp t0))
    run (liftF (renameProgram (OB5.sig 511)
        (StairLoanRecordShape.slices StairConcrete.bestLoans true L))) a u =
      run (liftF (renameProgram (OB5.sig 511)
        (StairLoanRecordShape.slices StairSchedule.recordLoans true L))) b u := by
  intro u
  have actual := FrontierEntry1591Kernel.paired_input f.x f.Y.val f.source t0 f.input
    f.outsideNumerator
  obtain ⟨origin, facts, legal, frames⟩ := Rolling1588Lifetime.entry_first_prepared
    f.sharedNodup f.historyAbove f.selectorsAway f.x f.Y f.x_pos f.x_lt f.source t0 mp
    f.input f.phase f.outsideNumerator f.numerator
  have ctx := Rolling1588Lifetime.prepared_context f.sharedNodup f.selectorsAway
    f.transcript f.x f.Y f.source origin facts legal f.selectorG_zero f.selectorS_zero
  have bits := Rolling1588Lifetime.first_clean true f.sharedNodup f.historyAbove f.x _
    f.x_pos f.x_lt t0 mp actual
  have work := Rolling1588Lifetime.first_work_zero true f.sharedNodup f.x _ t0 mp actual
  have parity := Rolling1588Lifetime.first_parity true f.sharedNodup f.historyAbove f.x _
    f.x_pos f.x_lt t0 mp actual
  have frameA := frames true
  rw [lf_eq] at frameA bits work parity
  obtain ⟨v, hv⟩ : ∃ v : State, run (Rolling1588.firstPhase true) mp t0 = v := ⟨_, rfl⟩
  rw [hv] at frameA bits work parity
  have hu : u = run (StairSchedule.fieldRename (Rolling1588.placedFirstPacket true ++
      FourScratchWindow.clearProgram)) mF
        (run (StairSchedule.paritySetup ++ StairSchedule.hostedX) mS v) := by
    show run _ mF (run _ mS (run (Rolling1588.firstPhase true) mp t0)) = _
    rw [hv]
  rw [hu]
  have code := Rolling1588Frame.field_special_at origin.basis (f.Y / 2) 0 v 511 (by simp)
    frameA
  have fixed : OB5.sig 511 (base 511) = base 511 := by decide +kernel
  rw [fixed] at code
  have in511 : v.basis (base 511) = true :=
    code.trans (trace_last f.x f.x_pos f.x_lt origin.basis facts.trace)
  have in1542 : v.basis (base 1542) = false :=
    bits _ (by simp [FrontierEntry1591Native.workSites])
  have flags := field_flags origin.basis ctx (f.Y / 2) 0 v frameA
  -- the forced record frame
  let origin' := writeBit origin.basis (base 2400) true
  have ctx' := FrontierEntry1591.context_control_set origin.basis ctx true
  have trace' : skywalkTapeControls origin' (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (f.x : Int) (p : Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact facts.trace
  have input' := Rolling1588.frame_control_set origin.basis (f.Y / 2) 0 v true frameA
  have enabled' : origin' (base 2400) = true := by
    simp only [origin', writeBit, Function.update_self]
  -- after the first packet
  obtain ⟨mF1, hmF1⟩ : ∃ x : List Bool,
      x = mF.take (measurementCount (Rolling1588.placedFirstPacket true)) := ⟨_, rfl⟩
  obtain ⟨s1, hs1⟩ : ∃ x : State,
      x = run (Rolling1588.placedFirstPacket true) mF1 (force v) := ⟨_, rfl⟩
  have first := Rolling1588.placedFirstPacket_frame true true origin' ctx' enabled' f.x f.x_lt
    trace' (f.Y / 2) 0 ⟨fun bad => absurd bad (by decide), fun _ => rfl⟩ (force v) mF1 input'
  rw [← hs1] at first
  have codes := Rolling1588.field_prefix_codes origin' ctx' _ _ s1 first.2 f.x f.x_pos f.x_lt
    trace'
  have clean := FourScratchWindow.field_clean origin' ctx' _ _ s1 first.2 codes.1 codes.2.1
  have z768 := Rolling1588.field_768_zero origin' ctx' _ _ s1 first.2
  have cut := (Rolling1588.cutFrame_one origin' _ _ _).mpr first.2
  -- lift and transfer
  rw [StairField2V3Seg.liftF_run, StairField2V3Seg.liftF_run]
  apply congrArg StairField2V3Seg.pullOut
  apply StairLoanField7Transport.replay_transfer _ _ _ s1 _ _
    (slices_placed_sub L 1 hL)
  · intro q hq
    have hq' : q ∈ wires (renameProgram (OB5.sig 511)
        (Rolling1588.groups true 1 (StairLoanRecordShape.sliceCount L))) := by
      rw [← StairLoanRecordShape.forward_slices_record L 1 hL]
      exact hq
    obtain ⟨hE, hP⟩ := entryTail_avoid q (groups_prefix_sub _ hn hq')
    rw [field_pullIn, run_append (Rolling1588.placedFirstPacket true), ← hmF1]
    have B := run_agree_off _ firstPacket_avoidE _ (force v) mF1
      (hosted_agree_force v flags.1 in511 flags.2 in1542 work parity mS)
    rw [← hs1] at B
    exact window_agree _ s1 _ B clean codes.2.2 z768 q hE hP
  · rw [StairRename.rename_run_conjugate (OB5.sig 511)
        (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
      StairRename.rename_run_conjugate (OB5.sig 511)
        (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
      StairLoanRecordShape.forward_slices_run_eq half L 1 hL origin' ctx' enabled' _ _ _ cut
        a b]
















