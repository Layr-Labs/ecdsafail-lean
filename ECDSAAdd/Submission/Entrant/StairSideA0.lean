set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairBoundaryLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-- Composite rename carrying `HalfField.tgt` to the record converter wires. -/
def converterRename (q : Wire) : Wire :=
  Equiv.swap (base 760) (base 772)
    (Rolling1588Lifetime.endpointBorrow
      (OwnQ5Endpoint.swap (OwnQ4Endpoint.swap (OwnGuardEndpoint.swap
        (OwnPlusEndpoint.swap (HalfFieldOB5.endpointMap q))))))

/-- The renamed converter layout of `canon760` / `center760`. -/
def converterLayout760 : BalancedConvert.Layout where
  low := HalfField.tgt.low.map converterRename
  msb := converterRename HalfField.tgt.msb
  carry := HalfField.tgt.carry.map converterRename
  cin := converterRename HalfField.tgt.cin
  one := converterRename HalfField.tgt.one
  flag := converterRename HalfField.tgt.flag

/-! ## LT44 (replay budget): the converters commute with wire renaming

`canon760` / `center760` are six nested renamings of `HalfConvert.canonical` / `.center` on
`HalfField.tgt`.  The two equations below were `decide +kernel` (39 s + 28 s of kernel time:
both programs evaluated gate by gate); they now follow from `rename_canonical` /
`rename_center` and `renameProgram_comp` (< 0.1 s). -/

def renameBit (f : Wire → Wire) (b : MappedBit) : MappedBit := ⟨b.wire.map f, b.flip⟩

def renameLayout (f : Wire → Wire) (L : BalancedConvert.Layout) :
    BalancedConvert.Layout where
  low := L.low.map f
  msb := f L.msb
  carry := L.carry.map f
  cin := f L.cin
  one := f L.one
  flag := f L.flag

theorem renameProgram_append_lt44 (f : Wire → Wire) (P Q : Program) :
    renameProgram f (P ++ Q) = renameProgram f P ++ renameProgram f Q := by
  simp [renameProgram]

theorem rename_mappedMajority (f : Wire → Wire) (b : MappedBit) (y cin t : Wire) :
    renameProgram f (mappedMajority b y cin t) =
      mappedMajority (renameBit f b) (f y) (f cin) (f t) := by
  rcases b with ⟨_ | a, _ | _⟩ <;> rfl

theorem rename_mappedEraseCarry (f : Wire → Wire) (b : MappedBit) (y cin t : Wire) :
    renameProgram f (mappedEraseCarry b y cin t) =
      mappedEraseCarry (renameBit f b) (f y) (f cin) (f t) := by
  rcases b with ⟨_ | a, _ | _⟩ <;> rfl

theorem rename_mappedSum (f : Wire → Wire) (b : MappedBit) (y cin : Wire) :
    renameProgram f (mappedSum b y cin) = mappedSum (renameBit f b) (f y) (f cin) := by
  rcases b with ⟨_ | a, _ | _⟩ <;> rfl

theorem rename_mappedAdd (f : Wire → Wire) : ∀ (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire), renameProgram f (mappedAdd bits ys cs cin) =
      mappedAdd (bits.map (renameBit f)) (ys.map f) (cs.map f) (f cin) := by
  intro bits
  induction bits with
  | nil => intro ys cs cin; simp [mappedAdd, renameProgram]
  | cons b bits ih =>
    intro ys cs cin
    cases bits with
    | nil =>
      cases ys with
      | nil => simp [mappedAdd, renameProgram]
      | cons y ys =>
        cases ys with
        | nil => simp only [mappedAdd, List.map_cons, List.map_nil, rename_mappedSum]
        | cons y' ys => simp [mappedAdd, renameProgram]
    | cons b' bits =>
      cases ys with
      | nil => simp [mappedAdd, renameProgram]
      | cons y ys =>
        cases ys with
        | nil => simp [mappedAdd, renameProgram]
        | cons y' ys =>
          cases cs with
          | nil => simp [mappedAdd, renameProgram]
          | cons c cs =>
            have h := ih (y' :: ys) cs c
            simp only [List.map_cons] at h
            simp only [mappedAdd, List.map_cons, renameProgram_append_lt44, rename_mappedMajority,
              rename_mappedEraseCarry, rename_mappedSum, h]

theorem rename_notRegister (f : Wire → Wire) (r : List Wire) :
    renameProgram f (notRegister r) = notRegister (r.map f) := by
  simp [notRegister, renameProgram, renameInstr, Function.comp_def]

theorem rename_rotateLeft (f : Wire → Wire) : ∀ r : List Wire,
    renameProgram f (rotateLeft r) = rotateLeft (r.map f)
  | [] => rfl
  | [_] => rfl
  | a :: b :: bs => by
    have ih := rename_rotateLeft f (b :: bs)
    simp only [List.map_cons] at ih
    simp only [rotateLeft, List.map_cons, renameProgram_append_lt44, ih]
    rfl

theorem rename_rotateRight (f : Wire → Wire) : ∀ r : List Wire,
    renameProgram f (rotateRight r) = rotateRight (r.map f)
  | [] => rfl
  | [_] => rfl
  | a :: b :: bs => by
    have ih := rename_rotateRight f (b :: bs)
    simp only [List.map_cons] at ih
    simp only [rotateRight, List.map_cons, renameProgram_append_lt44, ih]
    rfl

theorem lowCorrection_rename (f : Wire → Wire) (L : BalancedConvert.Layout) :
    (HalfConvert.lowCorrection L).map (renameBit f) =
      HalfConvert.lowCorrection (renameLayout f L) := by
  simp only [HalfConvert.lowCorrection, List.map_map]
  apply List.map_congr_left
  intro i _
  simp only [Function.comp, renameBit, renameLayout]
  split <;> rfl

theorem lowBit_rename (f : Wire → Wire) (L : BalancedConvert.Layout) :
    f (HalfConvert.lowBit L) = HalfConvert.lowBit (renameLayout f L) := by
  rcases L with ⟨_ | ⟨a, l⟩, m, c, ci, o, fl⟩ <;> rfl

theorem rename_canonical (f : Wire → Wire) (L : BalancedConvert.Layout) :
    renameProgram f (HalfConvert.canonical L) = HalfConvert.canonical (renameLayout f L) := by
  have w : L.word.map f = (renameLayout f L).word := by
    simp [BalancedConvert.Layout.word, renameLayout]
  have t : (L.carry.take 254).map f = (renameLayout f L).carry.take 254 := by
    simp [renameLayout, List.map_take]
  simp only [HalfConvert.canonical, mappedSub, renameProgram_append_lt44, rename_notRegister,
    rename_mappedAdd, rename_rotateLeft, lowCorrection_rename, w, t, ← lowBit_rename]
  rfl

theorem rename_center (f : Wire → Wire) (L : BalancedConvert.Layout) :
    renameProgram f (HalfConvert.center L) = HalfConvert.center (renameLayout f L) := by
  have w : L.word.map f = (renameLayout f L).word := by
    simp [BalancedConvert.Layout.word, renameLayout]
  have t : (L.carry.take 254).map f = (renameLayout f L).carry.take 254 := by
    simp [renameLayout, List.map_take]
  simp only [HalfConvert.center, renameProgram_append_lt44, rename_mappedAdd, rename_rotateRight,
    lowCorrection_rename, w, t, ← lowBit_rename]
  rfl

theorem canon760_eq : R2SqEp760.canon760 = HalfConvert.canonical converterLayout760 := by
  have h := rename_canonical converterRename HalfField.tgt
  rw [show renameLayout converterRename HalfField.tgt = converterLayout760 from rfl] at h
  rw [← h]
  simp only [R2SqEp760.canon760, Rolling1588Lifetime.canon, OwnQ5Endpoint.canonT,
    OwnQ4Endpoint.canonT, OwnGuardEndpoint.canonT, OwnPlusEndpoint.canonT, HalfFieldOB5.canonT,
    HalfField5.canonT, HalfField.canonT, renameProgram_comp]
  rfl

theorem center760_eq : R2SqEp760.center760 = HalfConvert.center converterLayout760 := by
  have h := rename_center converterRename HalfField.tgt
  rw [show renameLayout converterRename HalfField.tgt = converterLayout760 from rfl] at h
  rw [← h]
  simp only [R2SqEp760.center760, Rolling1588Lifetime.center, OwnQ5Endpoint.centerT,
    OwnQ4Endpoint.centerT, OwnGuardEndpoint.centerT, OwnPlusEndpoint.centerT,
    HalfFieldOB5.centerT, HalfField5.centerT, HalfField.centerT, renameProgram_comp]
  rfl

/-! ## K4-A (replay budget): layout facts by transfer through the injective rename

`converterLayout760` is `HalfField.tgt` renamed wire by wire by `converterRename`.  The facts
below used to be decided on the renamed layout (every wire renamed again, and quadratic list or
`Finset` scans: ≈ 38 s of kernel time).  Now the duplicate / disjointness facts are decided on
`HalfField.tgt` with bit masks, and every fact about the 44 retired holes comes from one scan
that inverts the rename on the 44 holes only (`holes_check_k4a`). -/

/-- `converterRename` as one permutation. -/
def converterPerm_k4a : Equiv.Perm Wire :=
  ((((((HalfFieldOB5.endpointMap.trans OwnPlusEndpoint.swap).trans OwnGuardEndpoint.swap).trans
    OwnQ4Endpoint.swap).trans OwnQ5Endpoint.swap).trans Rolling1588Lifetime.endpointBorrow).trans
      (Equiv.swap (base 760) (base 772)))

theorem converterRename_apply_k4a (q : Wire) : converterRename q = converterPerm_k4a q := by
  simp only [converterRename, converterPerm_k4a, Equiv.trans_apply]

theorem converterRename_injective_k4a : Function.Injective converterRename := by
  intro a b h
  rw [converterRename_apply_k4a, converterRename_apply_k4a] at h
  exact converterPerm_k4a.injective h

theorem cl_low_k4a : converterLayout760.low = HalfField.tgt.low.map converterRename := rfl
theorem cl_carry_k4a : converterLayout760.carry = HalfField.tgt.carry.map converterRename := rfl
theorem cl_msb_k4a : converterLayout760.msb = converterRename HalfField.tgt.msb := rfl
theorem cl_cin_k4a : converterLayout760.cin = converterRename HalfField.tgt.cin := rfl
theorem cl_flag_k4a : converterLayout760.flag = converterRename HalfField.tgt.flag := rfl

theorem cl_lowBit_k4a :
    HalfConvert.lowBit converterLayout760 = converterRename (HalfConvert.lowBit HalfField.tgt) :=
  (lowBit_rename converterRename HalfField.tgt).symm

theorem cl_word_k4a : converterLayout760.word = HalfField.tgt.word.map converterRename := by
  simp only [BalancedConvert.Layout.word, List.map_append, List.map_cons, List.map_nil]
  rfl

theorem cl_ladder_k4a : converterLayout760.cin :: (converterLayout760.low ++
      converterLayout760.carry.take 254) =
    (HalfField.tgt.cin :: (HalfField.tgt.low ++ HalfField.tgt.carry.take 254)).map
      converterRename := by
  simp only [List.map_cons, List.map_append, List.map_take]
  rfl

theorem lowCorrection_wire_k4a (L : BalancedConvert.Layout) (b : MappedBit)
    (hb : b ∈ HalfConvert.lowCorrection L) (q : Wire) (hq : q ∈ b.wire.toList) : q = L.flag := by
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hb
  dsimp only at hq
  split at hq
  · simpa using hq
  · simp at hq

theorem mem_mappedWires_lowCorrection_take_k4a (L : BalancedConvert.Layout) (n : Nat) (q : Wire)
    (h : q ∈ mappedWires ((HalfConvert.lowCorrection L).take n)) : q = L.flag := by
  unfold mappedWires at h
  obtain ⟨b, hb, hq⟩ := List.mem_flatMap.mp h
  exact lowCorrection_wire_k4a L b (List.mem_of_mem_take hb) q hq

theorem mem_mappedWires_lowCorrection_k4a (L : BalancedConvert.Layout) (q : Wire)
    (h : q ∈ mappedWires (HalfConvert.lowCorrection L)) : q = L.flag := by
  unfold mappedWires at h
  obtain ⟨b, hb, hq⟩ := List.mem_flatMap.mp h
  exact lowCorrection_wire_k4a L b hb q hq

/-- Disjointness of two wire lists from their bit masks. -/
theorem disjoint_of_maskAnd_k4a (A B : List Wire)
    (h : StairLoan.maskOf A &&& StairLoan.maskOf B = 0) : ∀ q ∈ A, q ∉ B := by
  intro q hA hB
  have e1 : (StairLoan.maskOf A).testBit q = true := by
    rw [StairLoan.testBit_maskOf]
    exact decide_eq_true hA
  have e2 : (StairLoan.maskOf B).testBit q = true := by
    rw [StairLoan.testBit_maskOf]
    exact decide_eq_true hB
  have e3 : (StairLoan.maskOf A &&& StairLoan.maskOf B).testBit q = true := by
    rw [Nat.testBit_and, e1, e2]
    rfl
  rw [h, Nat.zero_testBit] at e3
  exact Bool.false_ne_true e3

theorem tgt_ladder_nodup_k4a :
    (HalfField.tgt.flag :: HalfField.tgt.cin :: (HalfField.tgt.low ++
      HalfField.tgt.carry.take 254)).Nodup :=
  StairLoan.nodup_of_mask _ (by decide +kernel)

theorem tgt_carry_away_k4a :
    StairLoan.maskOf (HalfField.tgt.carry.take 254) &&&
      StairLoan.maskOf (HalfField.tgt.flag :: HalfConvert.lowBit HalfField.tgt ::
        HalfField.tgt.msb :: HalfField.tgt.word) = 0 := by
  decide +kernel

/-- What a retired hole must avoid, on the source layout `HalfField.tgt`. -/
def holeAvoid_k4a : List Wire :=
  HalfField.tgt.flag :: HalfField.tgt.cin :: HalfConvert.lowBit HalfField.tgt ::
    HalfField.tgt.msb :: (HalfField.tgt.low ++ ((HalfField.tgt.carry.take 254).take (44 + 1) ++
      (HalfField.tgt.carry.take 254).take 44))

theorem holeAvoid_mem_k4a {y : Wire} (h : y = HalfField.tgt.flag ∨ y = HalfField.tgt.cin ∨
    y = HalfConvert.lowBit HalfField.tgt ∨ y = HalfField.tgt.msb ∨ y ∈ HalfField.tgt.low ∨
    y ∈ (HalfField.tgt.carry.take 254).take (44 + 1) ∨ y ∈ (HalfField.tgt.carry.take 254).take 44) :
    y ∈ holeAvoid_k4a := by
  simp only [holeAvoid_k4a, List.mem_cons, List.mem_append]
  exact h

/-- One scan over the 44 holes: the rename is inverted on the holes only. -/
theorem holes_check_k4a : exclusiveHoles.all (fun r =>
    (StairLoan.maskOf ((HalfField.tgt.carry.take 254).drop (44 + 1))).testBit
        (converterPerm_k4a.symm r) &&
      !(StairLoan.maskOf holeAvoid_k4a).testBit (converterPerm_k4a.symm r)) = true := by
  decide +kernel

theorem hole_facts_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    (StairLoan.maskOf ((HalfField.tgt.carry.take 254).drop (44 + 1))).testBit
        (converterPerm_k4a.symm r) = true ∧
      (StairLoan.maskOf holeAvoid_k4a).testBit (converterPerm_k4a.symm r) = false := by
  have h := List.all_eq_true.mp holes_check_k4a r (List.mem_of_mem_take hr)
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at h
  exact h

theorem hole_ne_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) {y : Wire} (hy : y ∈ holeAvoid_k4a) :
    converterRename y ≠ r := by
  intro e
  have hx : converterPerm_k4a.symm r = y := by
    rw [← e, converterRename_apply_k4a, Equiv.symm_apply_apply]
  have h := (hole_facts_k4a hr).2
  rw [hx] at h
  exact StairLoan.not_mem_of_maskOf h hy

theorem hole_not_low_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    r ∉ converterLayout760.low := by
  intro h
  rw [cl_low_k4a] at h
  obtain ⟨y, hy, e⟩ := List.mem_map.mp h
  exact hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hy)))))) e

theorem hole_ne_flag_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    r ≠ converterLayout760.flag := fun e =>
  hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inl rfl)) (by rw [e, cl_flag_k4a])

theorem hole_ne_cin_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    r ≠ converterLayout760.cin := fun e =>
  hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inr (Or.inl rfl))) (by rw [e, cl_cin_k4a])

theorem hole_ne_lowBit_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    r ≠ HalfConvert.lowBit converterLayout760 := fun e =>
  hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inr (Or.inr (Or.inl rfl)))) (by rw [e, cl_lowBit_k4a])

theorem hole_ne_msb_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    r ≠ converterLayout760.msb := fun e =>
  hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inr (Or.inr (Or.inr (Or.inl rfl))))) (by rw [e, cl_msb_k4a])

theorem hole_not_word_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) :
    r ∉ converterLayout760.word := by
  intro h
  rw [BalancedConvert.Layout.word, List.mem_append, List.mem_singleton] at h
  rcases h with h | h
  · exact hole_not_low_k4a hr h
  · exact hole_ne_msb_k4a hr h

theorem hole_not_hosts_k4a {r : Wire} (hr : r ∈ exclusiveHoles.take 44) (n : Nat)
    (hn : (HalfField.tgt.carry.take 254).take n = (HalfField.tgt.carry.take 254).take (44 + 1) ∨
      (HalfField.tgt.carry.take 254).take n = (HalfField.tgt.carry.take 254).take 44) :
    r ∉ (converterLayout760.carry.take 254).take n := by
  intro h
  rw [cl_carry_k4a, ← List.map_take, ← List.map_take] at h
  obtain ⟨y, hy, e⟩ := List.mem_map.mp h
  rcases hn with hn | hn <;> rw [hn] at hy
  · exact hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hy))))))) e
  · exact hole_ne_k4a hr (holeAvoid_mem_k4a (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr hy))))))) e

theorem converterLayout760_facts : LadderFacts converterLayout760 where
  widths := ⟨by decide +kernel, by decide +kernel⟩
  -- K4-A: transferred from `HalfField.tgt` through the injective rename
  nodup := by
    rw [cl_ladder_k4a]
    exact List.Nodup.map converterRename_injective_k4a (List.nodup_cons.mp tgt_ladder_nodup_k4a).2
  bitsAway := by
    intro q hq
    rw [mem_mappedWires_lowCorrection_k4a _ _ hq, cl_ladder_k4a, cl_flag_k4a,
      List.mem_map_of_injective converterRename_injective_k4a]
    exact (List.nodup_cons.mp tgt_ladder_nodup_k4a).1
  carryAway := by
    intro q hq
    rw [cl_carry_k4a, ← List.map_take] at hq
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hq
    have d := disjoint_of_maskAnd_k4a _ _ tgt_carry_away_k4a y hy
    simp only [List.mem_cons, not_or] at d
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [cl_word_k4a, List.mem_map_of_injective converterRename_injective_k4a]
      exact d.2.2.2
    · rw [cl_flag_k4a]
      exact fun h => d.1 (converterRename_injective_k4a h)
    · rw [cl_lowBit_k4a]
      exact fun h => d.2.1 (converterRename_injective_k4a h)
    · rw [cl_msb_k4a]
      exact fun h => d.2.2.1 (converterRename_injective_k4a h)

theorem converter_roleTail :
    ∀ q ∈ exclusiveHoles.take 44,
      q ∈ (converterLayout760.carry.take 254).drop (44 + 1) := by
  intro q hq
  rw [cl_carry_k4a, ← List.map_take, ← List.map_drop]
  exact List.mem_map.mpr ⟨_, StairLoan.mem_of_maskOf (hole_facts_k4a hq).1,
    by rw [converterRename_apply_k4a, Equiv.apply_symm_apply]⟩


/-! ## The loaned components -/

/-- The 43 roles lent by the two converters: every exclusive hole except the pool host
`base 720`, whose carry stays on its own site (the depth-43 canonicalisation loan
of submission 34a118c3 / c2bbc37d, here also applied to the centering). -/
def canonRoles : List Wire := exclusiveHoles.drop 1

theorem canonRoles_length : canonRoles.length = 43 := by
  rw [canonRoles, List.length_drop, exclusiveHoles_length]

theorem exclusiveHoles_head1 : exclusiveHoles =
    MappedCompressed.base 720 :: exclusiveHoles.drop 1 := by
  decide +kernel

theorem canonRoles_sub : canonRoles.Sublist exclusiveHoles :=
  List.drop_sublist _ _




theorem canon43_roles {q : Wire} (hq : q ∈ canonRoles.take 43) : q ∈ exclusiveHoles.take 44 := by
  rw [List.take_of_length_le (le_of_eq exclusiveHoles_length)]
  exact canonRoles_sub.subset (List.mem_of_mem_take hq)


theorem canon43_take {l : List Wire} {q : Wire} {m n : Nat} (hmn : m ≤ n) (h : q ∈ l.take m) :
    q ∈ l.take n :=
  (List.take_sublist_take_left hmn).subset h


theorem canon43_roleTail : ∀ q ∈ canonRoles.take 43,
    q ∈ (converterLayout760.carry.take 254).drop (43 + 1) := by
  intro q hq
  exact (List.drop_sublist_drop_left _ (by omega)).subset (converter_roleTail q (canon43_roles hq))

/-! ## The loaned components -/

def canon760Loan : Program := canonicalLoan 43 canonRoles converterLayout760
def center760Loan : Program := centerLoan 43 canonRoles converterLayout760




theorem center760Loan_run_eq_of_clean (s : State)
    (clean : ∀ q ∈ converterLayout760.carry.take 254, s.basis q = false)
    (m n : List Bool) :
    run center760Loan m s = run R2SqEp760.center760 n s := by
  rw [center760_eq]
  exact centerLoan_run_eq 43 canonRoles converterLayout760
    converterLayout760_facts (by omega) canon43_roleTail s clean m n

theorem converter_banks :
    (exclusiveHoles.take 44 ++ (converterLayout760.carry.take 254).take 44).Nodup := by
  have hh : (exclusiveHoles.take 44).Nodup := StairLoan.nodup_of_mask _ (by decide +kernel)
  have hc : ((HalfField.tgt.carry.take 254).take 44).Nodup :=
    StairLoan.nodup_of_mask _ (by decide +kernel)
  have hc' : ((converterLayout760.carry.take 254).take 44).Nodup := by
    rw [cl_carry_k4a, ← List.map_take, ← List.map_take]
    exact List.Nodup.map converterRename_injective_k4a hc
  refine List.Nodup.append hh hc' ?_
  intro a ha hb
  exact hole_not_hosts_k4a ha 44 (Or.inr rfl) hb


theorem converter_roleAwayYs : ∀ r ∈ exclusiveHoles.take 44, r ∉ converterLayout760.low :=
  fun _ hr => hole_not_low_k4a hr

theorem center_roleOuter : ∀ r ∈ exclusiveHoles.take 44,
    r ∉ wires ([Instr.CX (HalfConvert.lowBit converterLayout760) converterLayout760.flag,
      Instr.CX converterLayout760.flag (HalfConvert.lowBit converterLayout760)] ++
        rotateRight converterLayout760.word) ∧
    r ∉ wires [Instr.CX converterLayout760.flag converterLayout760.msb,
      Instr.CX converterLayout760.msb converterLayout760.flag] := by
  intro r hr
  have hf := hole_ne_flag_k4a hr
  have hb := hole_ne_lowBit_k4a hr
  have hm := hole_ne_msb_k4a hr
  refine ⟨?_, ?_⟩
  · rw [wires_append, Finset.mem_union, not_or, (rotate_wires _).1]
    refine ⟨?_, ?_⟩
    · simp [wires, Instr.wires, hf, hb]
    · split
      · simp
      · rw [List.mem_toFinset]
        exact hole_not_word_k4a hr
  · simp [wires, Instr.wires, hf, hm]

theorem canon_roleOuter : ∀ r ∈ exclusiveHoles.take 44,
    r ∉ wires [Instr.CX converterLayout760.msb converterLayout760.flag,
      Instr.CX converterLayout760.flag converterLayout760.msb] ∧
    r ∉ wires (rotateLeft converterLayout760.word ++
      [Instr.CX converterLayout760.flag (HalfConvert.lowBit converterLayout760),
        Instr.CX (HalfConvert.lowBit converterLayout760) converterLayout760.flag]) := by
  intro r hr
  have hf := hole_ne_flag_k4a hr
  have hb := hole_ne_lowBit_k4a hr
  have hm := hole_ne_msb_k4a hr
  refine ⟨?_, ?_⟩
  · simp [wires, Instr.wires, hf, hm]
  · rw [wires_append, Finset.mem_union, not_or, (rotate_wires _).2]
    refine ⟨?_, ?_⟩
    · split
      · simp
      · rw [List.mem_toFinset]
        exact hole_not_word_k4a hr
    · simp [wires, Instr.wires, hf, hb]



/-! ## The converter loans at depth 43 (roles `canonRoles`) -/

theorem canon43_banks :
    (canonRoles.take 43 ++ (converterLayout760.carry.take 254).take 43).Nodup := by
  refine converter_banks.sublist (List.Sublist.append ?_ (List.take_sublist_take_left (by omega)))
  rw [List.take_of_length_le (le_of_eq exclusiveHoles_length)]
  exact (List.take_sublist _ _).trans canonRoles_sub


theorem canon43_roleAway : ∀ r ∈ canonRoles.take 43,
    r ∉ (mappedWires ((HalfConvert.lowCorrection converterLayout760).take (43 + 1)) ++
      converterLayout760.low.take (43 + 1) ++
      (converterLayout760.carry.take 254).take (43 + 1) ++
      [converterLayout760.cin]).toFinset := by
  intro r hr hm
  have hr44 := canon43_roles hr
  rw [List.mem_toFinset] at hm
  simp only [List.mem_append, List.mem_singleton] at hm
  rcases hm with ((h | h) | h) | h
  · exact hole_ne_flag_k4a hr44 (mem_mappedWires_lowCorrection_take_k4a _ _ _ h)
  · exact hole_not_low_k4a hr44 (List.mem_of_mem_take h)
  · exact hole_not_hosts_k4a hr44 (44 + 1) (Or.inl rfl) (canon43_take (by omega) h)
  · exact hole_ne_cin_k4a hr44 h


theorem canon43_support :
    wires canon760Loan ⊆ (wires (HalfConvert.canonical converterLayout760) \
        (canonRoles.take 43).toFinset) ∪
      ((converterLayout760.carry.take 254).take 43).toFinset :=
  canonicalLoan_support 43 canonRoles converterLayout760
    converterLayout760_facts (by omega) (by rw [canonRoles_length])
    canon43_banks canon43_roleAway (fun r hr => converter_roleAwayYs r (canon43_roles hr))
    (fun r hr => canon_roleOuter r (canon43_roles hr))


theorem center43_support :
    wires center760Loan ⊆ (wires (HalfConvert.center converterLayout760) \
        (canonRoles.take 43).toFinset) ∪
      ((converterLayout760.carry.take 254).take 43).toFinset :=
  centerLoan_support 43 canonRoles converterLayout760
    converterLayout760_facts (by omega) (by rw [canonRoles_length])
    canon43_banks canon43_roleAway (fun r hr => center_roleOuter r (canon43_roles hr))




