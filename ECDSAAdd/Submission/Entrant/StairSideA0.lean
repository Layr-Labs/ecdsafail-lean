section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option synthInstance.maxSize 4096
set_option synthInstance.maxHeartbeats 2000000

namespace ECDSAAdd.Entrant.StairField2V3SegFacts2

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack StairField2V3Pack
open StairField2V3End StairField2V3Decode StairField2V3Walk StairField2V3SegFacts




def FactsEnd (B B' : Nat) : Prop :=
  endFor B = startFor B' ∧ startFor B' ∈ ([450, 465, 480, 490, 500] : List Nat)

def FactsLow2 (B B' : Nat) : Prop :=
  ∀ q ∈ StairPhysicalPrimitives.rowSitesL B' ++ futurePayload B ++ futurePayload B' ++ scratchT B B',
    q < base 4000

def FactsPkO (B' : Nat) : Prop :=
  ∀ q ∈ pk (kk B'), q ∉ fullS B' ∧ q ∉ fullD B'

def FactsPkP (B' : Nat) : Prop :=
  ∀ q ∈ packSites B', q ∉ pk (kk B')

def FactsDiff (B B' : Nat) : Prop :=
  ∀ r ∈ futurePayload B, r ∉ futurePayload B' →
    r ∈ pk (kk B') ∨
    (r ∈ (segPk B B').flatMap pk ∧ r ∉ orientSites B' ∧ r ∉ pk (kk B') ∧ r ∉ packSites B')



theorem FactsEnd_ok (B B' : Nat) (h : (B, B') ∈ rowPairs) : FactsEnd B B' := by
  rcases pairs_cases B B' h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals unfold FactsEnd; decide +kernel

/-- LT49 (replay budget): the four lists are checked separately and `scratchT` through
`StairField2V3SegFacts.forall_scratchT` (no evaluation of its quadratic filter). -/
theorem FactsLow2_ok (B B' : Nat) (h : (B, B') ∈ rowPairs) : FactsLow2 B B' := by
  rcases pairs_cases B B' h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals unfold FactsLow2
  all_goals simp only [List.forall_mem_append, StairField2V3SegFacts.forall_scratchT]; decide +kernel

theorem FactsPkO_ok (B B' : Nat) (h : (B, B') ∈ rowPairs) : FactsPkO B' := by
  rcases pairs_cases B B' h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals unfold FactsPkO; decide +kernel

theorem FactsPkP_ok (B B' : Nat) (h : (B, B') ∈ rowPairs) : FactsPkP B' := by
  rcases pairs_cases B B' h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals unfold FactsPkP; simp only [k1_mem_pk]; decide +kernel

/-- K6 (replay budget): Boolean form of `FactsDiff` (literal / list bit masks), sound for
every row pair. -/
def k6DB (B B' : Nat) : Bool :=
  (futurePayload B).all (fun r => (fpMask B').testBit r ||
    ((StairLoan.maskOf (pk (kk B'))).testBit r ||
      ((StairLoan.maskOf ((segPk B B').flatMap pk)).testBit r &&
        (!(StairLoan.maskOf (orientSites B')).testBit r &&
          (!(StairLoan.maskOf (pk (kk B'))).testBit r &&
            !(StairLoan.maskOf (packSites B')).testBit r)))))

theorem k6DB_sound (B B' : Nat) (h : k6DB B B' = true) : FactsDiff B B' := by
  simp only [k6DB, List.all_eq_true, Bool.or_eq_true, Bool.and_eq_true, Bool.not_eq_true',
    StairLoan.testBit_maskOf, decide_eq_true_eq, decide_eq_false_iff_not] at h
  intro r hr hn
  rcases h r hr with h1 | h2
  · exact absurd ((mem_fp B' r).mpr h1) hn
  · exact h2

theorem FactsDiff_ok (B B' : Nat) (h : (B, B') ∈ rowPairs) : FactsDiff B B' := by
  rcases pairs_cases B B' h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals exact k6DB_sound _ _ (by decide +kernel)



