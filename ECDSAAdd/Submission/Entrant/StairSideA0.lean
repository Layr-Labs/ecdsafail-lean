    gateSlots (mappedEraseCarry b y cin target) ≤ 6 := by
  cases b with
  | mk wire flip =>
      cases wire <;> cases flip <;>
        simp [mappedEraseCarry, eraseBorrow, eraseCarry, gateSlots,
          instructionSlots]




