theorem p_facts : 0 < ECDSAAdd.p ∧ ECDSAAdd.p % 2 = 1 ∧ ECDSAAdd.p < 2 ^ 256 := by
  refine ⟨?_, ?_, ?_⟩ <;> norm_num [ECDSAAdd.p]

theorem coprime_of_lt (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) : x.Coprime ECDSAAdd.p :=
  Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd ECDSAAdd.Secp256k1.p_prime).mpr
    (Nat.not_dvd_of_pos_of_lt hx0 hx))

theorem budget_mem_checkpoints (B : Nat) (hB : B ∈ budgets) :
    B ∈ StairSchedule.checkpoints.map Prod.snd := by
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> simp [StairSchedule.checkpoints]

theorem domain_row (B : Nat) (hB : B ∈ budgets) (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) :
    StairCodec.CodecDomain B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)) := by
  obtain ⟨hp0, hodd, hp⟩ := p_facts
  have h87 : B ≤ 87 ∧ 3 ≤ B := by
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> decide
  have h := StairBridgeDomain.real_codecDomain x ECDSAAdd.p (startFor B) hp0 hx0 hodd hp hx
    (coprime_of_lt x hx0 hx) (by unfold startFor; omega)
  have e : 512 - startFor B = B := by unfold startFor; omega
  rwa [e] at h


