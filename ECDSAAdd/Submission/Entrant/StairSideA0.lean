theorem layout_nat (i n x : Nat) (hn1 : n ≤ 514 - i) (hn2 : n ≤ 258) (hi : i < 512)
    (hx1 : 736 ≤ x) (hx2 : x < 781) :
    x ≠ (skywalkPoolPreviousId i) + 16 ∧ x ≠ 1028 + i + 16 ∧ x ≠ i + n + 16 ∧ x ≠ i + 16 ∧
    x ≠ 770 + 16 ∧ (∀ k, i + 1 ≤ k → k < i + 1 + (n - 2) → x ≠ k + 16) ∧
    x ≠ i + n - 1 + 16 ∧ (∀ k, 771 ≤ k → k < 771 + (n - 2) → x ≠ k + 16) ∧
    x ≠ 770 + n - 1 + 16 ∧ (∀ k, 1540 ≤ k → k < 1540 + (n - 1) → x ≠ k + 16) := by
  have hp : skywalkPoolPreviousId i < 512 ∨ skywalkPoolPreviousId i = 1797 := by
    unfold skywalkPoolPreviousId; split <;> omega
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> (try intro k hk1 hk2) <;> omega

theorem mem_wireBlock' {x : Wire} {st c : Nat} (h : x ∈ wireBlock base st c) :
    ∃ a, st ≤ a ∧ a < st + c ∧ x = a + 16 := by
  simp only [wireBlock, List.mem_map, List.mem_range'_1] at h
  obtain ⟨a, ⟨h1, h2⟩, e⟩ := h
  exact ⟨a, h1, h2, e.symm⟩

theorem layout_avoids (i : Nat) (hi : i < 512) {w : Wire} (hw : InWin w) :
    w ∉ (W.compactSkywalkTickLayout base i).wires := by
  have hb := W.compactSkywalkTick_width_bounds i hi
  obtain ⟨hx1, hx2⟩ := hw
  intro hm
  unfold W.compactSkywalkTickLayout SkywalkIntegerLayout.wires SkywalkIntegerLayout.ah
    SkywalkIntegerLayout.bh at hm
  simp only [List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at hm
  generalize W.compactSkywalkTickPreWidth i = n at hb hm
  have H := layout_nat i n w hb.2.2.2.2.1 hb.2.2.2.1 hi hx1 hx2
  rcases hm with h | h | h | h | h | ((h | h) | (h | h)) | h
  · exact H.1 h
  · exact H.2.1 h
  · exact H.2.2.1 h
  · exact H.2.2.2.1 h
  · exact H.2.2.2.2.1 h
  · obtain ⟨k, k1, k2, e⟩ := mem_wireBlock' h
    exact H.2.2.2.2.2.1 k k1 k2 e
