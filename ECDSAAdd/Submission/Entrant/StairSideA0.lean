/-- Generic: reading a renamed run on a state fixed by the renaming. -/
theorem rename_basis (f : Equiv.Perm Wire) (P : Program) (m : List Bool) (t : State)
    (ht : pullState f t = t) (w : Wire) :
    (run (renameProgram f P) m t).basis w = (run P m t).basis (f.symm w) := by
  have rr := run_rename f f.injective P m t
  rw [ht] at rr
  have := congrArg (fun s : State => s.basis (f.symm w)) rr
  simpa [pullState] using this

theorem phaseTargets_sig : ∀ q ∈ phaseTargets, OB5.sig 424 q = q := by
  decide +kernel

theorem phaseTargets_kind : ∀ q ∈ phaseTargets,
    q ∈ (W.compactSkywalkSignPoolB base 425).released ∨ q ∈ wireBlock base 1540 257 ∨
      q ∈ (List.range' 425 87).map (fun j => base (j + 258)) := by
  -- K4C (replay budget): one bit mask per list instead of one list scan per target.
  have h : phaseTargets.all (fun q =>
      (StairLoan.maskOf (W.compactSkywalkSignPoolB base 425).released).testBit q ||
        (StairLoan.maskOf (wireBlock base 1540 257)).testBit q ||
        (StairLoan.maskOf ((List.range' 425 87).map (fun j => base (j + 258)))).testBit q) =
      true := by
    decide +kernel
  intro q hq
  have t := List.all_eq_true.mp h q hq
  simp only [Bool.or_eq_true, StairLoan.testBit_maskOf, decide_eq_true_eq] at t
  rcases t with (t | t) | t
  · exact Or.inl t
  · exact Or.inr (Or.inl t)
  · exact Or.inr (Or.inr t)

/-- Wires off the history letters of packets `start ≤ 507`. -/
abbrev OutHist (q : Nat) : Prop := 528 ≤ q ∧ (q < 1044 ∨ 1556 ≤ q)

theorem phaseTargets_outHist : ∀ q ∈ phaseTargets, OutHist q := by
