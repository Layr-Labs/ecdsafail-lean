/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Couple_at_QTop` -/
section Merge_StairField2V3Couple_at_QTop

/-!
# LT21: coupled simulation chains (generic, placement independent)

A *coupled* step relates a selected run with **some** reference run:
`CRel pre post P Q := ∀ s t, pre s t → ∀ fresh, ∃ old, post (run P fresh s) (run Q old t)`.
Because the reference kernels are tape-free on their inputs, an existential
reference tape is enough (`runEqOn_of_coupled`).

The point of the existential tape: a program shared by both sides can be run
with the *same* tape on both, so it preserves agreement outside a difference
set `Δ` by pure locality (`shared_step`) — no phase lemma about the record
state is needed, only that the program avoids `Δ`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Couple

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open StairField2V3Replay

/-- Coupled step with an existential reference tape. -/
def CRel (pre post : State → State → Prop) (P Q : Program) : Prop :=
  ∀ s t, pre s t → ∀ fresh, ∃ old, post (run P fresh s) (run Q old t)


theorem crel_mono {A A' B B' : State → State → Prop} {P Q : Program}
    (hA : ∀ s t, A' s t → A s t) (hB : ∀ s t, B s t → B' s t)
    (h : CRel A B P Q) : CRel A' B' P Q := by
  intro s t hst fresh
  obtain ⟨o, ho⟩ := h s t (hA s t hst) fresh
  exact ⟨o, hB _ _ ho⟩





/-! ## Agreement outside a difference set -/

/-- Equal phase and equal basis outside `Δ`, plus a side condition `C` that
only reads `Δ` (see `DeltaLocal`). -/
def Rel (Δ : Finset Wire) (C : BasisState → BasisState → Prop) (s t : State) : Prop :=
  AgreeOutside Δ s t ∧ C s.basis t.basis

/-- `C` reads only the `Δ` part of both states. -/
def DeltaLocal (Δ : Finset Wire) (C : BasisState → BasisState → Prop) : Prop :=
  ∀ a b a' b', (∀ q ∈ Δ, a q = a' q) → (∀ q ∈ Δ, b q = b' q) → C a b → C a' b'

/-- A program shared by both sides and avoiding `Δ` preserves the relation,
running both sides on the same tape. -/
theorem shared_step (Δ : Finset Wire) (C : BasisState → BasisState → Prop)
    (local_ : DeltaLocal Δ C) (P : Program) (away : ∀ q ∈ Δ, q ∉ wires P) :
    CRel (Rel Δ C) (Rel Δ C) P P := by
  intro s t hst fresh
  refine ⟨fresh, ?_⟩
  obtain ⟨⟨hph, hout⟩, hC⟩ := hst
  have readP : ∀ q ∈ wires P, s.basis q = t.basis q := by
    intro q hq
    exact hout q (fun hΔ => away q hΔ hq)
  have inc := ECDSAAdd.Arithmetic.run_local_increment P s t fresh readP
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · have h := inc.1
    rw [hph] at h
    revert h
    cases (run P fresh s).phase <;> cases (run P fresh t).phase <;>
      cases t.phase <;> simp
  · intro q hq
    by_cases hP : q ∈ wires P
    · exact inc.2 q hP
    · rw [run_preserves_outside P fresh s q hP, run_preserves_outside P fresh t q hP]
      exact hout q hq
  · apply local_ s.basis t.basis _ _ _ _ hC
    · intro q hq
      exact (run_preserves_outside P fresh s q (away q hq)).symm
    · intro q hq
      exact (run_preserves_outside P fresh t q (away q hq)).symm




/-! ## Reachability of the reference state -/

/-- `t` is reached from an input satisfying `pre` by running `X` (some tape). -/
def ReachBy (pre : State → Prop) (X : Program) (t : State) : Prop :=
  ∃ s0 m, pre s0 ∧ t = run X m s0

/-- Any coupled step can carry the reachability of the reference state. -/
theorem crel_track {A B : State → State → Prop} {P Q : Program}
    (h : CRel A B P Q) (pre : State → Prop) (X : Program) :
    CRel (fun s t => A s t ∧ ReachBy pre X t)
      (fun s t => B s t ∧ ReachBy pre (X ++ Q) t) P Q := by
  rintro s t ⟨hA, s0, m, hs0, rfl⟩ fresh
  obtain ⟨old, hB⟩ := h s _ hA fresh
  refine ⟨old, hB, s0, padTape (measurementCount X) m ++ old, hs0, ?_⟩
  exact nested_run_eq_append X Q m old s0


/-- A selected-only step whose obligation may use the reachability. -/
theorem crel_sel_reach {A B : State → State → Prop} {P : Program}
    (pre : State → Prop) (X : Program)
    (h : CRel (fun s t => A s t ∧ ReachBy pre X t) B P []) :
    CRel (fun s t => A s t ∧ ReachBy pre X t)
      (fun s t => B s t ∧ ReachBy pre X t) P [] := by
  rintro s t ⟨hA, hR⟩ fresh
  obtain ⟨old, hB⟩ := h s t ⟨hA, hR⟩ fresh
  refine ⟨old, hB, ?_⟩
  obtain ⟨s0, m, hs0, rfl⟩ := hR
  refine ⟨s0, padTape (measurementCount X) m ++ old, hs0, ?_⟩
  have e := nested_run_eq_append X [] m old s0
  rw [List.append_nil] at e
  exact e


end ECDSAAdd.Entrant.StairField2V3Couple

end
end Merge_StairField2V3Couple_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanConverterSupport_at_QTop` -/
section Merge_StairLoanConverterSupport_at_QTop

/-!
# The loaned v3 converters stay inside the record converters

`StairBoundaryLoan.canon760Loan` / `center760Loan` (LT8, v3 `bestLoans.canon` /
`bestLoans.center`) are bounded by LT8's `canonicalLoan_support` /
`centerLoan_support` by the record converter plus its own lowest 44 carries.
Every carry of `mappedAdd` is a majority target, so those carries are already
wires of the record converter, and the bound collapses to an inclusion:

* `canon760Loan_sub : wires canon760Loan ⊆ wires R2SqEp760.canon760`
* `center760Loan_sub : wires center760Loan ⊆ wires R2SqEp760.center760`

so every single-wire fact the record proves about its converters transfers.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanConverterSupport

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

attribute [local irreducible] wires run

/-! ## Carries of the mapped adder -/

theorem majority_target (b : MappedBit) (y cin target : Wire) :
    target ∈ wires (mappedMajority b y cin target) := by
  unfold mappedMajority
  rcases hw : b.wire with _ | a <;> cases hf : b.flip <;>
    simp [borrowMajority, majority, wires, Instr.wires]

theorem carry_take_mem_mappedAdd :
    ∀ (n : Nat) (bits : List MappedBit) (ys carry : List Wire) (cin : Wire),
      n < bits.length → n < ys.length →
      ∀ q ∈ carry.take n, q ∈ wires (mappedAdd bits ys carry cin)
  | 0, _, _, _, _, _, _, q, hq => by simp at hq
  | n + 1, bits, ys, carry, cin, hb, hy, q, hq => by
      obtain ⟨b, b', bits', rfl⟩ : ∃ b b' bits', bits = b :: b' :: bits' := by
        match bits, hb with
        | b :: b' :: bits', _ => exact ⟨b, b', bits', rfl⟩
        | [], hb => simp at hb
        | [_], hb => simp at hb
      obtain ⟨y, y', ys', rfl⟩ : ∃ y y' ys', ys = y :: y' :: ys' := by
        match ys, hy with
        | y :: y' :: ys', _ => exact ⟨y, y', ys', rfl⟩
        | [], hy => simp at hy
        | [_], hy => simp at hy
      obtain ⟨c, cs, rfl⟩ : ∃ c cs, carry = c :: cs := by
        match carry, hq with
        | c :: cs, _ => exact ⟨c, cs, rfl⟩
        | [], hq => simp at hq
      simp only [List.take_succ_cons, List.mem_cons] at hq
      simp only [mappedAdd, wires_append, Finset.mem_union]
      rcases hq with rfl | hq
      · exact Or.inl (Or.inl (Or.inl (majority_target b y cin _)))
      · exact Or.inl (Or.inl (Or.inr (carry_take_mem_mappedAdd n (b' :: bits')
          (y' :: ys') cs c (by simp only [List.length_cons] at hb ⊢; omega)
          (by simp only [List.length_cons] at hy ⊢; omega)
          q hq)))

/-! ## Ready for v3: the record converters contain their lowest carries

LT8's `centerLoan_support` / `canonicalLoan_support` bound a loaned converter by
`(wires record \ roles) ∪ (L.carry.take 254).take d`.  The two lemmas below show
those carries are already wires of the record converter, so the bound collapses
to `wires loaned ⊆ wires record` (`sub_of_carry_bound`). -/

theorem center_carries (L : BalancedConvert.Layout) (d : Nat) (hd : d < 255)
    (hl : d < L.low.length) :
    ∀ q ∈ (L.carry.take 254).take d, q ∈ wires (HalfConvert.center L) := by
  intro q hq
  have lenBits : d < (HalfConvert.lowCorrection L).length := by
    simp only [HalfConvert.lowCorrection, List.length_map, List.length_range]
    omega
  have h := carry_take_mem_mappedAdd d _ _ _ L.cin lenBits hl q hq
  simp only [HalfConvert.center, wires_append, Finset.mem_union, h, true_or,
    or_true]

theorem canonical_carries (L : BalancedConvert.Layout) (d : Nat) (hd : d < 255)
    (hl : d < L.low.length) :
    ∀ q ∈ (L.carry.take 254).take d, q ∈ wires (HalfConvert.canonical L) := by
  intro q hq
  have lenBits : d < (HalfConvert.lowCorrection L).length := by
    simp only [HalfConvert.lowCorrection, List.length_map, List.length_range]
    omega
  have h := carry_take_mem_mappedAdd d _ _ _ L.cin lenBits hl q hq
  simp only [HalfConvert.canonical, mappedSub, wires_append, Finset.mem_union, h,
    true_or, or_true]

/-- A support bound of LT8's form collapses to an inclusion once the hosts are
wires of the original. -/
theorem sub_of_carry_bound (P Old : Program) (roles hosts : List Wire)
    (support : wires P ⊆ (wires Old \ roles.toFinset) ∪ hosts.toFinset)
    (hostsIn : ∀ q ∈ hosts, q ∈ wires Old) :
    wires P ⊆ wires Old := by
  intro q hq
  rcases Finset.mem_union.mp (support hq) with h | h
  · exact (Finset.mem_sdiff.mp h).1
  · exact hostsIn q (List.mem_toFinset.mp h)

/-! ## The two v3 loaned converters -/

theorem canon760Loan_sub :
    wires StairBoundaryLoan.canon760Loan ⊆ wires R2SqEp760.canon760 := by
  have lowLen : 43 < StairBoundaryLoan.converterLayout760.low.length := by
    have len := StairBoundaryLoan.ladder_lengths StairBoundaryLoan.converterLayout760
      StairBoundaryLoan.converterLayout760_facts.widths
    omega
  rw [StairBoundaryLoan.canon760_eq]
  exact sub_of_carry_bound _ _ _ _ StairBoundaryLoan.canon43_support
    (canonical_carries StairBoundaryLoan.converterLayout760 43 (by omega) lowLen)

theorem center760Loan_sub :
    wires StairBoundaryLoan.center760Loan ⊆ wires R2SqEp760.center760 := by
  have lowLen : 43 < StairBoundaryLoan.converterLayout760.low.length := by
    have len := StairBoundaryLoan.ladder_lengths StairBoundaryLoan.converterLayout760
      StairBoundaryLoan.converterLayout760_facts.widths
    omega
  rw [StairBoundaryLoan.center760_eq]
  exact sub_of_carry_bound _ _ _ _ StairBoundaryLoan.center43_support
    (center_carries StairBoundaryLoan.converterLayout760 43 (by omega) lowLen)

/-- The v3 provider's converters, in the form the record-shape modules use. -/
theorem bestCanon_sub :
    wires StairConcrete.bestLoans.canon ⊆ wires StairSchedule.recordLoans.canon :=
  canon760Loan_sub

theorem bestCenter_sub :
    wires StairConcrete.bestLoans.center ⊆ wires StairSchedule.recordLoans.center :=
  center760Loan_sub

end ECDSAAdd.Entrant.StairLoanConverterSupport

end
end Merge_StairLoanConverterSupport_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanGroupSupport_at_QTop` -/
section Merge_StairLoanGroupSupport_at_QTop

/-!
# Loaned packet groups stay inside the record groups

`StairGroups.groups divide d j n` (= `bestLoans.groups`) differs from the record
`Rolling1588.groups divide j n` only in its five per-packet halves
`StairLoan.half760Loan d divide`, and `StairLoanSupport.half760Loan_support760`
already bounds a loaned half by the record half (`half760Loan 0`).  Every
wrapper between the half and the group (`loanWindow`, the history renames, the
cells, the packet, `PacketSequence.program`) is monotone in its inner program,
so for every `d ≤ 68`, both directions and every packet range:

* `groups_sub : wires (StairGroups.groups divide d j n) ⊆ wires (Rolling1588.groups divide j n)`
* `placedGroups_sub` / `liftedGroups_sub`: the same after the staircase
  placement `OB5.sig 511` and after LT21's `liftF` (`fieldRename ∘ borrow`);
* `liftedGroups_avoid`: a difference region that avoids LT21's record `grp j n`
  avoids the loaned group as well.

No hypothesis: the only loan fact used is the proved field-5 support lemma.
Everything is stated with variable programs; no concrete program is unfolded.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanGroupSupport

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

attribute [local irreducible] wires StairLoan.half760Loan StairGroups.halfWindow StairGroups.cell Rolling1588.onPacket

/-! ## Monotone wrappers (variable programs) -/

theorem append_sub (P Q P0 Q0 : Program)
    (hp : wires P ⊆ wires P0) (hq : wires Q ⊆ wires Q0) :
    wires (P ++ Q) ⊆ wires (P0 ++ Q0) := by
  rw [wires_append, wires_append]
  exact Finset.union_subset_union hp hq

theorem rename_sub (f : Wire → Wire) (P Q : Program)
    (sub : wires P ⊆ wires Q) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) := by
  rw [renameProgram_support, renameProgram_support]
  exact Finset.image_mono f sub

theorem loanWindow_sub (g flag c : Wire) (P Q : Program) (sub : wires P ⊆ wires Q) :
    wires (ControlLoan1589.loanWindow g flag c P) ⊆
      wires (ControlLoan1589.loanWindow g flag c Q) := by
  unfold ControlLoan1589.loanWindow
  exact append_sub _ _ _ _ (append_sub _ _ _ _ (Finset.Subset.refl _)
    (rename_sub _ _ _ sub)) (Finset.Subset.refl _)

theorem sequence_sub (forward : Bool) (p r : Nat → Program)
    (same : ∀ j, wires (p j) ⊆ wires (r j)) :
    ∀ j n, wires (PacketSequence.program forward p j n) ⊆
      wires (PacketSequence.program forward r j n) := by
  intro j n
  induction n generalizing j with
  | zero =>
      intro q hq
      simp [PacketSequence.program, wires] at hq
  | succ n ih =>
      cases forward <;> simp only [PacketSequence.program, Bool.false_eq_true,
        if_false, if_true]
      · exact append_sub _ _ _ _ (ih (j + 1)) (same j)
      · exact append_sub _ _ _ _ (same j) (ih (j + 1))


/-! ## From the half to the group -/

theorem half_sub (divide : Bool) (d : Nat) (hd : d ≤ 68) :
    wires (StairLoanAdapter.concreteHalf760Loan divide d) ⊆
      wires (StairLoanAdapter.concreteHalf760Loan divide 0) := by
  unfold StairLoanAdapter.concreteHalf760Loan
  intro q hq
  exact (Finset.mem_sdiff.mp (StairLoanSupport.half760Loan_support760 d divide hd hq)).1

theorem halfWindow_sub (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68) :
    wires (StairGroups.halfWindow divide d j active hole) ⊆
      wires (StairGroups.halfWindow divide 0 j active hole) := by
  unfold StairGroups.halfWindow
  exact loanWindow_sub _ _ _ _ _ (rename_sub _ _ _ (half_sub divide d hd))

theorem cell_sub (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68) :
    wires (StairGroups.cell divide d j active hole) ⊆
      wires (StairGroups.cell divide 0 j active hole) := by
  have h := halfWindow_sub divide d j active hole hd
  cases divide <;> simp only [StairGroups.cell, Bool.false_eq_true, if_false, if_true]
  · exact append_sub _ _ _ _ (Finset.Subset.refl _) h
  · exact append_sub _ _ _ _ h (Finset.Subset.refl _)

theorem basePacket_sub (divide : Bool) (d j : Nat) (hd : d ≤ 68) :
    wires (StairGroups.basePacket divide d j) ⊆
      wires (StairGroups.basePacket divide 0 j) := by
  have c := fun active hole => cell_sub divide d j active hole hd
  cases divide <;> simp only [StairGroups.basePacket, Bool.false_eq_true, if_false,
    if_true]
  all_goals repeat (first
    | exact c _ _
    | exact Finset.Subset.refl _
    | apply append_sub)

theorem packet_sub (divide : Bool) (d j : Nat) (hd : d ≤ 68) :
    wires (StairGroups.packet divide d j) ⊆ wires (StairGroups.packet divide 0 j) := by
  unfold StairGroups.packet
  exact rename_sub _ _ _ (basePacket_sub divide d j hd)

/-- **Loaned groups inside the record groups**, every deficit `d ≤ 68`, both
directions, every packet range. -/
theorem groups_sub (divide : Bool) (d : Nat) (hd : d ≤ 68) (j n : Nat) :
    wires (StairGroups.groups divide d j n) ⊆ wires (Rolling1588.groups divide j n) := by
  rw [← StairGroups.groups_zero]
  unfold StairGroups.groups
  exact sequence_sub divide _ _ (fun i => packet_sub divide d i hd) j n

/-! ## Provider, placed and lifted forms -/

theorem bestGroups_sub (divide : Bool) (d : Nat) (hd : d ≤ 68) (j n : Nat) :
    wires (StairConcrete.bestLoans.groups divide d j n) ⊆
      wires (StairSchedule.recordLoans.groups divide d j n) :=
  groups_sub divide d hd j n

theorem placedGroups_sub (divide : Bool) (d : Nat) (hd : d ≤ 68) (j n : Nat) :
    wires (StairSchedule.placedGroups StairConcrete.bestLoans divide d j n) ⊆
      wires (StairSchedule.placedGroups StairSchedule.recordLoans divide d j n) := by
  unfold StairSchedule.placedGroups
  exact rename_sub _ _ _ (bestGroups_sub divide d hd j n)







end ECDSAAdd.Entrant.StairLoanGroupSupport

end
end Merge_StairLoanGroupSupport_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanReplay_at_QTop` -/
section Merge_StairLoanReplay_at_QTop

/-!
# Loan replay through the regular packet boundary

This module starts the field-7 composition at its first nontrivial wrapper.
The directional half theorem is supplied only through the official compiled
`Half760LoanHypothesis`.  The theorem below transports that equality through
the packet-local `719 ↔ s[j,hole]` rebind, retaining independent measurement
tapes.  No checkpoint or whole-kernel equality is assumed.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanReplay

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

abbrev HalfReplayHypothesis : Prop :=
  StairReplay.Half760LoanHypothesis
    (fun divide d => StairLoan.half760Loan d divide)

/-- The official all-depth half replay transported through the history-hole
rebind used by every regular staircase cell. -/
theorem reboundHalf_run_eq (half : HalfReplayHypothesis)
    (divide : Bool) (d j hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (hh : hole < 5) (origin : BasisState)
    (clean : Q6EndpointCell.Clean base origin)
    (holeZero : origin (Rolling1588.s j hole) = false)
    (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis) :
    run (renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole))
      (StairLoan.half760Loan d divide)) fresh s =
      run (Q6EndpointCell.half divide base (base 2409)) old s := by
  have carryMember : base 719 ∈ Q6EndpointCell.workIds.map base :=
    List.mem_map.mpr ⟨719, by
      simp [Q6EndpointCell.workIds, List.mem_range'_1], rfl⟩
  have carryAway := Rolling1588Lifetime.half_work_away _ carryMember
  have holeAway : Rolling1588.s j hole ∉
        (Q6EndpointCell.ports base (base 2409)).r ∧
      Rolling1588.s j hole ∉
        (Q6EndpointCell.ports base (base 2409)).y := by
    rw [Q6EndpointCell.ports_r, Q6EndpointCell.ports_y,
      balancedSharedPorts_r, balancedSharedPorts_y]
    exact ⟨OwnPlusHost.not_block (1028 + 5 * j + hole) 2056 256 (by omega),
      OwnPlusHost.not_block (1028 + 5 * j + hole) 770 256 (by omega)⟩
  have carryIn : s.basis (base 719) = false :=
    (input.2.2 _ carryAway.1 carryAway.2).trans (clean _ carryMember)
  have holeIn : s.basis (Rolling1588.s j hole) = false :=
    (input.2.2 _ holeAway.1 holeAway.2).trans holeZero
  have oldFrame := Q6EndpointCell.half_frame divide base (base 2409)
    Rolling1588Lifetime.half_ports_nodup origin clean X Y s old input
  have carryOut :
      (run (Q6EndpointCell.half divide base (base 2409)) old s).basis
        (base 719) = false :=
    (oldFrame.2.2.2 _ carryAway.1 carryAway.2).trans (clean _ carryMember)
  have holeOut :
      (run (Q6EndpointCell.half divide base (base 2409)) old s).basis
        (Rolling1588.s j hole) = false :=
    (oldFrame.2.2.2 _ holeAway.1 holeAway.2).trans holeZero
  have rawEq := half.run_eq divide d hd origin clean X Y s fresh old input
  have loanCarryOut :
      (run (StairLoan.half760Loan d divide) fresh s).basis
        (base 719) = false := by
    rw [rawEq]
    exact carryOut
  have loanHoleOut :
      (run (StairLoan.half760Loan d divide) fresh s).basis
        (Rolling1588.s j hole) = false := by
    rw [rawEq]
    exact holeOut
  exact (NewFieldFrameOB5.rebind_swap_run (base 719) (Rolling1588.s j hole)
    (StairLoan.half760Loan d divide) s fresh carryIn holeIn
    loanCarryOut loanHoleOut).trans rawEq

/-- Framed form of `reboundHalf_run_eq`, ready for the measured selector
window. -/
theorem reboundHalf_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (hh : hole < 5) (origin : BasisState)
    (clean : Q6EndpointCell.Clean base origin)
    (holeZero : origin (Rolling1588.s j hole) = false)
    (X Y : Fp) :
    Triple
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord X) (centerWord Y))
      (renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole))
        (StairLoan.half760Loan d divide))
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord (if divide then
          (X + (if origin (base 2409) then Y else -Y)) / 2
        else 2 * X + (if origin (base 2409) then -Y else Y)))
        (centerWord Y)) := by
  intro s records input
  rw [reboundHalf_run_eq half divide d j hole hd hj hh origin clean
    holeZero X Y s records [] input]
  exact Q6EndpointCell.half_frame divide base (base 2409)
    Rolling1588Lifetime.half_ports_nodup origin clean X Y s [] input

private theorem numericAway (q : Nat) (hr : q < 2056 ∨ 2312 ≤ q)
    (hy : q < 770 ∨ 1026 ≤ q) :
    base q ∉ (Q6EndpointCell.ports base (base 2409)).r ∧
      base q ∉ (Q6EndpointCell.ports base (base 2409)).y := by
  rw [Q6EndpointCell.ports_r, Q6EndpointCell.ports_y,
    balancedSharedPorts_r, balancedSharedPorts_y]
  exact ⟨OwnPlusHost.not_block q 2056 256 (by omega),
    OwnPlusHost.not_block q 770 256 (by omega)⟩

private theorem flagNotWork :
    base 2409 ∉ Q6EndpointCell.workIds.map base := by
  intro used
  obtain ⟨i, hi, eq⟩ := List.mem_map.mp used
  have same := base_injective eq
  have bound := Q6EndpointCell.work_bound i hi
  omega

private theorem controlNodup (j active : Nat) (hj : j < 102)
    (ha : active < 5) :
    [base 2400, Rolling1588.g j active, base 2409].Nodup := by
  have old := FrontierSW1591.selLetter_nodup (5 * j + active) (by omega)
  simpa only [Rolling1588.g, tapeLetter,
    mixedTape_base_getD (5 * j + active) (by omega), Nat.add_assoc] using old.1

private theorem loanHalf_history_free (half : HalfReplayHypothesis)
    (divide : Bool) (d i : Nat) (hd : d ≤ 68)
    (history : i < 510 ∨ (1028 ≤ i ∧ i < 1538)) :
    base i ∉ wires (StairLoan.half760Loan d divide) := by
  intro used
  have old := (Finset.mem_sdiff.mp (half.support divide d hd used)).1
  exact Rolling1588.half_history_free divide i history old

private theorem loanHalf_control_free (half : HalfReplayHypothesis)
    (divide : Bool) (d : Nat) (hd : d ≤ 68) :
    base 2400 ∉ wires (StairLoan.half760Loan d divide) := by
  intro used
  have old := (Finset.mem_sdiff.mp (half.support divide d hd used)).1
  have member := Q6EndpointCell.half_support divide base (base 2409)
    (base 2409 :: Q6EndpointCell.ids.map base).toFinset
    (Finset.Subset.refl _) old
  simp only [List.mem_toFinset, List.mem_cons, List.mem_map] at member
  rcases member with eq | ⟨i, hi, eq⟩
  · exact (by have := base_injective eq; omega)
  · have same := base_injective eq
    have bound := Q6EndpointCell.ids_bound i hi
    omega

private theorem rebound_active_free (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) :
    Rolling1588.g j active ∉ wires
      (renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole))
        (StairLoan.half760Loan d divide)) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨q, hq, eq⟩ := Finset.mem_image.mp used
  have fixed : Equiv.swap (base 719) (Rolling1588.s j hole)
      (Rolling1588.g j active) = Rolling1588.g j active :=
    Equiv.swap_apply_of_ne_of_ne
      (HostOB5.host_ne _ _ (by omega)) (HostOB5.host_ne _ _ (by omega))
  have same := (Equiv.swap (base 719) (Rolling1588.s j hole)).injective
    (eq.trans fixed.symm)
  rw [same] at hq
  exact loanHalf_history_free half divide d (5 * j + active) hd
    (Or.inl (by omega)) (by simpa only [Rolling1588.g] using hq)

private theorem rebound_control_free (half : HalfReplayHypothesis)
    (divide : Bool) (d j hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (hh : hole < 5) :
    base 2400 ∉ wires
      (renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole))
        (StairLoan.half760Loan d divide)) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨q, hq, eq⟩ := Finset.mem_image.mp used
  have fixed : Equiv.swap (base 719) (Rolling1588.s j hole) (base 2400) =
      base 2400 := Equiv.swap_apply_of_ne_of_ne
        (HostOB5.host_ne _ _ (by omega)) (HostOB5.host_ne _ _ (by omega))
  have same := (Equiv.swap (base 719) (Rolling1588.s j hole)).injective
    (eq.trans fixed.symm)
  rw [same] at hq
  exact loanHalf_control_free half divide d hd hq

/-- The positive-record-delta half remains a complete phase-repaired selected
window.  This theorem is the semantic unit needed by every regular packet. -/
theorem halfWindow_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) (hh : hole < 5)
    (origin : BasisState) (clean : Q6EndpointCell.Clean base origin)
    (enabled : origin (base 2400) = true)
    (flagZero : origin (base 2409) = false)
    (holeZero : origin (Rolling1588.s j hole) = false) (X Y : Fp) :
    Triple
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord X) (centerWord Y))
      (StairGroups.halfWindow divide d j active hole)
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord (if divide then
          (X + (if origin (Rolling1588.g j active) then Y else -Y)) / 2
        else 2 * X + (if origin (Rolling1588.g j active) then -Y else Y)))
        (centerWord Y)) := by
  let g := Rolling1588.g j active
  let flag := base 2409
  let carry := Rolling1588.packetCarry j
  let rebound := renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole))
    (StairLoan.half760Loan d divide)
  have nd := controlNodup j active hj ha
  have bAway := numericAway 2400 (by omega) (by omega)
  have gAway := numericAway (5 * j + active) (by omega) (by omega)
  have fAway := numericAway 2409 (by omega) (by omega)
  have selectedClean : Q6EndpointCell.Clean base
      (mixedTranscriptBase origin (base 2400) g flag false) := by
    intro q hq
    have ne : q ≠ flag := by
      intro eq
      subst q
      exact flagNotWork (by simpa only [flag] using hq)
    simpa only [mixedTranscriptBase, writeBit,
      Function.update_of_ne ne] using clean q hq
  have selectedHole :
      mixedTranscriptBase origin (base 2400) g flag false
        (Rolling1588.s j hole) = false := by
    have ne : Rolling1588.s j hole ≠ flag :=
      HostOB5.host_ne _ _ (by omega)
    simpa only [mixedTranscriptBase, writeBit,
      Function.update_of_ne ne] using holeZero
  have body := reboundHalf_frame half divide d j hole hd hj hh
    (mixedTranscriptBase origin (base 2400) g flag false)
    selectedClean selectedHole X Y
  simp only [mixedTranscriptBase, writeBit, Function.update_self] at body
  have window := transcriptSelectWindow_pairFrame (base 2400) g flag false
    (Q6EndpointCell.ports base flag).r (Q6EndpointCell.ports base flag).y
    nd bAway gAway fAway origin flagZero _ _ _ _ rebound body
  have selected := (SW.Sel.refl (base 2400) rebound
    (rebound_control_free half divide d j hole hd hj hh)).window g flag false nd
  intro state records input
  have stateFlag : state.basis flag = false :=
    (input.2.2 _ fAway.1 fAway.2).trans flagZero
  have stateCarry : state.basis carry = false := by
    have member := Rolling1588.packetCarry_mem_work j hj
    exact (input.2.2 _
      (Rolling1588Lifetime.half_work_away _ member).1
      (Rolling1588Lifetime.half_work_away _ member).2).trans (clean _ member)
  let copied := run [.CX g flag] [] state
  have copiedClean : Q6EndpointCell.Clean base copied.basis :=
    Rolling1588Lifetime.copied_work_clean g state (by
      intro q hq
      exact (input.2.2 _
        (Rolling1588Lifetime.half_work_away q hq).1
        (Rolling1588Lifetime.half_work_away q hq).2).trans (clean q hq))
  have copiedFrame := Rolling1588Lifetime.copied_self_frame g state
    (centerWord X) (centerWord Y)
    (by simpa only [Q6EndpointCell.ports_r] using input.1)
    (by simpa only [Q6EndpointCell.ports_y] using input.2.1)
  have copiedHole : copied.basis (Rolling1588.s j hole) = false := by
    have ne : Rolling1588.s j hole ≠ flag := HostOB5.host_ne _ _ (by omega)
    simpa only [copied, run, writeBit, Function.update_of_ne ne] using
      (input.2.2 _ (numericAway (1028 + 5 * j + hole) (by omega) (by omega)).1
        (numericAway (1028 + 5 * j + hole) (by omega) (by omega)).2).trans holeZero
  have bodyEq (a b : List Bool) :
      run rebound a copied =
        run (Q6EndpointCell.half divide base flag) b copied := by
    exact reboundHalf_run_eq half divide d j hole hd hj hh copied.basis
      copiedClean copiedHole X Y copied a b copiedFrame
  have oldFrame := Q6EndpointCell.half_frame divide base flag
    Rolling1588Lifetime.half_ports_nodup copied.basis copiedClean X Y
    copied records copiedFrame
  have keep : (run rebound records copied).basis flag = copied.basis flag := by
    rw [bodyEq records records]
    exact oldFrame.2.2.2 _
      (by simpa only [Q6EndpointCell.ports_r] using
        Rolling1588Lifetime.half_flag_away.1)
      (by simpa only [Q6EndpointCell.ports_y] using
        Rolling1588Lifetime.half_flag_away.2)
  have carryMember := Rolling1588.packetCarry_mem_work j hj
  have carryAway := Rolling1588Lifetime.half_work_away _ carryMember
  have carryOut : (run rebound records copied).basis carry = false := by
    rw [bodyEq records records]
    exact (oldFrame.2.2.2 _
      (by simpa only [Q6EndpointCell.ports_r] using carryAway.1)
      (by simpa only [Q6EndpointCell.ports_y] using carryAway.2)).trans
        (copiedClean _ carryMember)
  have loan := ControlLoan1589.loanWindow_eq g flag carry rebound state records
    (HostOB5.host_ne _ _ (by omega)) (HostOB5.host_ne _ _ (by omega))
    (HostOB5.host_ne _ _ (by omega))
    (rebound_active_free half divide d j active hole hd hj ha)
    stateFlag stateCarry keep carryOut
  have stateEnabled : state.basis (base 2400) = true :=
    (input.2.2 _ bAway.1 bAway.2).trans enabled
  rw [show StairGroups.halfWindow divide d j active hole =
      ControlLoan1589.loanWindow g flag carry rebound from rfl,
    loan, (selected.eq records state stateEnabled).1]
  simpa only [g, flag, rebound, mixedTranscriptBit, enabled, if_true] using
    window state records input

private theorem swapControlNodup (j active : Nat) (hj : j < 102)
    (ha : active < 5) :
    [base 2400, Rolling1588.s j active, base 2409].Nodup := by
  have old := FrontierSW1591.selLetter_nodup (5 * j + active) (by omega)
  simpa only [Rolling1588.s, tapeLetter,
    mixedTape_base_getD (5 * j + active) (by omega), Nat.add_assoc] using old.2

private theorem selectedSwap_frame (j active : Nat) (hj : j < 102)
    (ha : active < 5) (origin : BasisState)
    (enabled : origin (base 2400) = true)
    (flagZero : origin (base 2409) = false) (X Y : Fp) :
    Triple
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord X) (centerWord Y))
      (SW.selW (Rolling1588.s j active) (base 2409)
        FrontierSW1591.swapBody)
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord (if origin (Rolling1588.s j active) then Y else X))
        (centerWord (if origin (Rolling1588.s j active) then X else Y))) := by
  have nd := swapControlNodup j active hj ha
  have bAway := numericAway 2400 (by omega) (by omega)
  have sAway := numericAway (1028 + 5 * j + active) (by omega) (by omega)
  have fAway := numericAway 2409 (by omega) (by omega)
  have legacy := OneFlagCell.selectSwap_frame base (base 2400)
    (Rolling1588.s j active) (base 2409) false
    FrontierReplay1591.base_sign_nd nd bAway sAway fAway origin flagZero X Y
  have selected := (SW.Sel.refl (base 2400) FrontierSW1591.swapBody
    FrontierSW1591.selSwap_away).window (Rolling1588.s j active)
      (base 2409) false nd
  intro state records input
  have stateEnabled : state.basis (base 2400) = true :=
    (input.2.2 _ bAway.1 bAway.2).trans enabled
  rw [(selected.eq records state stateEnabled).1]
  simpa only [OneFlagCell.selectSwap, FrontierSW1591.swapBody,
    Q6EndpointCell.ports_r, Q6EndpointCell.ports_y,
    mixedTranscriptBit, enabled, if_true] using legacy state records input

/-- One complete regular cell with the loaned half has the record payload and
repairs phase for every measurement stream. -/
theorem cell_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) (hh : hole < 5)
    (origin : BasisState) (clean : Q6EndpointCell.Clean base origin)
    (enabled : origin (base 2400) = true)
    (flagZero : origin (base 2409) = false)
    (holeZero : origin (Rolling1588.s j hole) = false) (X Y : Fp) :
    Triple
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord X) (centerWord Y))
      (StairGroups.cell divide d j active hole)
      (PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord (Q6EndpointCell.payload divide
          (origin (Rolling1588.g j active))
          (origin (Rolling1588.s j active)) (X, Y)).1)
        (centerWord (Q6EndpointCell.payload divide
          (origin (Rolling1588.g j active))
          (origin (Rolling1588.s j active)) (X, Y)).2)) := by
  cases divide
  · let A := if origin (Rolling1588.s j active) then Y else X
    let B := if origin (Rolling1588.s j active) then X else Y
    have first := selectedSwap_frame j active hj ha origin enabled flagZero X Y
    have last := halfWindow_frame half false d j active hole hd hj ha hh
      origin clean enabled flagZero holeZero A B
    cases hs : origin (Rolling1588.s j active) <;>
      simpa only [StairGroups.cell, Bool.false_eq_true, if_false, if_true,
        Q6EndpointCell.payload, skywalkPayloadUncell, A, B, hs] using
        first.seq last
  · let T :=
      (X + (if origin (Rolling1588.g j active) then Y else -Y)) / 2
    have first := halfWindow_frame half true d j active hole hd hj ha hh
      origin clean enabled flagZero holeZero X Y
    have last := selectedSwap_frame j active hj ha origin enabled flagZero T Y
    cases hs : origin (Rolling1588.s j active) <;>
      simpa only [StairGroups.cell, if_true, if_false,
        Q6EndpointCell.payload, skywalkPayloadCell, T, hs] using
        first.seq last

/-- The loaned cell advances the same intermediate packet-code frame as the record
cell. -/
theorem regularCell_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j k logical physical : Nat) (hd : d ≤ 68)
    (hj : j < 102) (hk : k < 3)
    (used : (logical, physical) ∈ Rolling1588.activeSlots divide k)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp)
    (state : State) (records : List Bool)
    (input : Rolling1588.CodeFrame
      (Rolling1588.stageCodeAt divide k (History5.historyMap base (5 * j)))
      origin X Y state) :
    let V := Q6EndpointCell.payload divide (origin (Rolling1588.g j logical))
      (origin (Rolling1588.s j logical)) (X, Y)
    (run (StairGroups.cell divide d j physical 2) records state).phase =
        state.phase ∧
      Rolling1588.CodeFrame
        (Rolling1588.stageCodeAt divide k (History5.historyMap base (5 * j)))
        origin V.1 V.2
        (run (StairGroups.cell divide d j physical 2) records state) := by
  have facts := Rolling1588.stage_frame_facts divide j k hj hk origin ctx
    enabled X Y state input
  have bounds := Rolling1588.activeSlots_bound divide k hk
    (logical, physical) used
  have framed := cell_frame half divide d j physical 2 hd hj bounds.2
    (by decide) state.basis facts.clean facts.enabled facts.flag facts.hole X Y
  have result := framed state records
    ⟨by simpa only [Q6EndpointCell.ports_r] using facts.rValue,
      by simpa only [Q6EndpointCell.ports_y] using facts.yValue,
      fun _ _ _ => rfl⟩
  have controls := facts.active logical physical used
  rw [controls.1, controls.2] at result
  refine ⟨result.1, ?_⟩
  exact Rolling1588.CodeFrame.arithmetic_step _ origin X Y _ _ state _
    (Rolling1588.stageCodeAt_neutral divide k hk _)
    (Rolling1588.stageCodeAt_disjoint divide j k hj hk origin ctx)
    input result.1 (by
      simpa only [Q6EndpointCell.ports_r, Q6EndpointCell.ports_y] using result.2)

attribute [local irreducible] wires

private theorem fieldIds_read (j : Nat) :
    (base 2409 :: Q6EndpointCell.ids.map base).toFinset ⊆
      FrontierReplay1591.readSites (5 * j) :=
  fun _ used => Finset.mem_union_left _ (Finset.mem_union_left _ used)

private theorem id_read (j i : Nat) (used : i ∈ Q6EndpointCell.ids) :
    base i ∈ FrontierReplay1591.readSites (5 * j) :=
  fieldIds_read j (List.mem_toFinset.mpr
    (List.mem_cons_of_mem _ (List.mem_map.mpr ⟨i, used, rfl⟩)))

private theorem flag_read (j : Nat) :
    base 2409 ∈ FrontierReplay1591.readSites (5 * j) :=
  fieldIds_read j (by simp)

private theorem history_read (j active : Nat) (ha : active < 5) :
    Rolling1588.g j active ∈ FrontierReplay1591.readSites (5 * j) ∧
      Rolling1588.s j active ∈ FrontierReplay1591.readSites (5 * j) := by
  have controls := Replay5.history_controls (5 * j) active ha
  rw [← NewHistory5.encode_support_eq] at controls
  exact ⟨Finset.mem_union_right _ controls.1,
    Finset.mem_union_right _ controls.2⟩

private theorem selected_read_support (source flag : Wire) (P : Program)
    (W : Finset Wire) (sourceIn : source ∈ W) (flagIn : flag ∈ W)
    (body : wires P ⊆ W) :
    wires (SW.selW source flag P) ⊆ W := by
  simpa [SW.selW, wires_append, wires, Instr.wires, correctionWires,
    Finset.union_subset_iff, Finset.insert_subset_iff, sourceIn, flagIn] using body

private theorem rename_swap_support (P : Program) (a b : Wire)
    (W : Finset Wire) (old : wires P ⊆ W) (ha : a ∈ W) (hb : b ∈ W) :
    wires (renameProgram (Equiv.swap a b) P) ⊆ W := by
  rw [renameProgram_support]
  intro q used
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp used
  by_cases sameA : i = a
  · subst i
    simpa only [Equiv.swap_apply_left] using hb
  · by_cases sameB : i = b
    · subst i
      simpa only [Equiv.swap_apply_right] using ha
    · simpa only [Equiv.swap_apply_of_ne_of_ne sameA sameB] using old hi

/-- The support component of the compiled half interface is strong enough to
retain the record packet's read region at every loan depth. -/
theorem halfWindow_read_support (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.halfWindow divide d j active hole) ⊆
      FrontierReplay1591.readSites (5 * j) := by
  let W := FrontierReplay1591.readSites (5 * j)
  let P := StairLoan.half760Loan d divide
  let rebound := renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole)) P
  have raw : wires P ⊆ W := by
    intro q used
    have old := (Finset.mem_sdiff.mp (half.support divide d hd used)).1
    exact Q6EndpointCell.half_support divide base (base 2409) W
      (fieldIds_read j) old
  have carry719 : base 719 ∈ W := id_read j 719 (by
    simp only [Q6EndpointCell.ids, List.mem_append, List.mem_cons,
      List.not_mem_nil, List.mem_range'_1, or_false]
    omega)
  have carry : Rolling1588.packetCarry j ∈ W := id_read j (516 + 2 * j) (by
    simp only [Q6EndpointCell.ids, List.mem_append, List.mem_cons,
      List.not_mem_nil, List.mem_range'_1, or_false]
    omega)
  have source := (history_read j active ha).1
  have rebind : wires rebound ⊆ W := rename_swap_support P
    (base 719) (Rolling1588.s j hole) W raw carry719
    (history_read j hole hh).2
  have loanBody :
      (wires rebound).image
        (Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j active)) ⊆ W := by
    rw [← renameProgram_support]
    exact rename_swap_support rebound (Rolling1588.packetCarry j)
      (Rolling1588.g j active) W rebind carry source
  intro q used
  rcases Finset.mem_union.mp
      (ControlLoan1589.loanWindow_support (Rolling1588.g j active)
        (base 2409) (Rolling1588.packetCarry j) rebound used) with edge | body
  · simp only [Finset.mem_insert, Finset.mem_singleton] at edge
    rcases edge with rfl | rfl
    · exact source
    · exact flag_read j
  · exact loanBody body

theorem cell_read_support (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.cell divide d j active hole) ⊆
      FrontierReplay1591.readSites (5 * j) := by
  let W := FrontierReplay1591.readSites (5 * j)
  have swap : wires FrontierSW1591.swapBody ⊆ W := by
    have old : wires FrontierSW1591.swapBody ⊆
        wires (Q6EndpointCell.body true base (base 2409) (base 2409)) := by
      simp only [FrontierSW1591.swapBody, Q6EndpointCell.body, if_true,
        wires_append, Q6EndpointCell.ports_r, Q6EndpointCell.ports_y]
      exact Finset.subset_union_right
    exact old.trans (Q6EndpointCell.body_support true base (base 2409)
      (base 2409) W (fieldIds_read j) (flag_read j))
  have selected := selected_read_support (Rolling1588.s j active) (base 2409)
    FrontierSW1591.swapBody W (history_read j active ha).2 (flag_read j) swap
  have loan := halfWindow_read_support half divide d j active hole hd hj ha hh
  cases divide <;>
    simp only [StairGroups.cell, Bool.false_eq_true, if_false, if_true,
      wires_append, Finset.union_subset_iff] at loan ⊢
  · exact ⟨selected, loan⟩
  · exact ⟨loan, selected⟩

theorem basePacket_read_support (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (hj : j < 102) :
    wires (StairGroups.basePacket divide d j) ⊆
      NewHistory5.groupReadSites base (base 2400) (base 2409) (base 2410)
        (5 * j) ∪ {base 2312} := by
  let W := FrontierReplay1591.readSites (5 * j)
  have join {P Q : Program} (left : wires P ⊆ W) (right : wires Q ⊆ W) :
      wires (P ++ Q) ⊆ W := by
    rw [wires_append, Finset.union_subset_iff]
    exact ⟨left, right⟩
  have opening := Rolling1588.onPacket_read_support j Rolling1588.stageOpen
    Rolling1588.stageOpen_support
  have closing := Rolling1588.onPacket_read_support j Rolling1588.stageClose
    Rolling1588.stageClose_support
  have transfer (direction : Bool) (k : Nat) (hk : k < 2) :=
    Rolling1588.onPacket_read_support j
      (Rolling1588.stageTransition direction k)
      (Rolling1588.stageTransition_support direction k hk)
  have cellAt (direction : Bool) (active : Nat) (ha : active < 5) :=
    cell_read_support half direction d j active 2 hd hj ha (by decide)
  have all : wires (StairGroups.basePacket divide d j) ⊆ W := by
    cases divide
    · simp only [StairGroups.basePacket, Bool.false_eq_true, if_false]
      exact join (join opening
        (join (join (join (join (join (join
          (cellAt false 4 (by decide)) (transfer false 0 (by decide)))
          (cellAt false 3 (by decide))) (cellAt false 4 (by decide)))
          (transfer false 1 (by decide))) (cellAt false 4 (by decide)))
          (cellAt false 3 (by decide)))) closing
    · simp only [StairGroups.basePacket, if_true]
      exact join (join opening
        (join (join (join (join (join (join
          (cellAt true 3 (by decide)) (cellAt true 4 (by decide)))
          (transfer true 0 (by decide))) (cellAt true 4 (by decide)))
          (cellAt true 3 (by decide))) (transfer true 1 (by decide)))
          (cellAt true 4 (by decide)))) closing
  exact all.trans (FrontierReplay1591.readSites_sub (5 * j))

/-- Five loaned cells, together with the unchanged packet scaffolding, transfer
the current packet's code frame exactly as the record packet does. -/
theorem basePacket_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) :
    Rolling1588.StateTriple
      (Rolling1588.CodeFrame
        (Rolling1588.codeEncodeAt divide (History5.historyMap base (5 * j)))
        origin X Y)
      (StairGroups.basePacket divide d j)
      (fun state =>
        let V := Rolling1588.regularPayload divide j origin (X, Y)
        Rolling1588.CodeFrame
          (Rolling1588.codeEncodeAt (!divide)
            (History5.historyMap base (5 * j)))
          origin V.1 V.2 state) := by
  let Frame (direction : Bool) (k : Nat) (V : Fp × Fp) :=
    Rolling1588.CodeFrame
      (Rolling1588.stageCodeAt direction k (History5.historyMap base (5 * j)))
      origin V.1 V.2
  have opening (direction : Bool) (V : Fp × Fp) :
      Rolling1588.StateTriple
        (Rolling1588.CodeFrame
          (Rolling1588.codeEncodeAt direction
            (History5.historyMap base (5 * j)))
          origin V.1 V.2)
        (Rolling1588.onPacket j Rolling1588.stageOpen)
        (Frame direction 0 V) := by
    intro state records input
    exact Rolling1588.regular_open_frame direction j hj origin ctx V.1 V.2
      state records input
  have step (direction : Bool) (k logical physical : Nat) (hk : k < 3)
      (used : (logical, physical) ∈ Rolling1588.activeSlots direction k)
      (V : Fp × Fp) :
      Rolling1588.StateTriple (Frame direction k V)
        (StairGroups.cell direction d j physical 2)
        (Frame direction k
          (Rolling1588.regularStep direction j origin logical V)) := by
    intro state records input
    exact regularCell_frame half direction d j k logical physical hd hj hk used
      origin ctx enabled V.1 V.2 state records input
  have transfer (direction : Bool) (k : Nat) (hk : k < 2) (V : Fp × Fp) :
      Rolling1588.StateTriple (Frame direction k V)
        (Rolling1588.onPacket j (Rolling1588.stageTransition direction k))
        (Frame direction (k + 1) V) := by
    intro state records input
    exact Rolling1588.regular_transition_frame direction j k hj hk origin ctx
      V.1 V.2 state records input
  have closing (direction : Bool) (V : Fp × Fp) :
      Rolling1588.StateTriple (Frame direction 2 V)
        (Rolling1588.onPacket j Rolling1588.stageClose)
        (Rolling1588.CodeFrame
          (Rolling1588.codeEncodeAt (!direction)
            (History5.historyMap base (5 * j)))
          origin V.1 V.2) := by
    intro state records input
    exact Rolling1588.regular_close_frame direction j hj origin ctx V.1 V.2
      state records input
  cases divide
  · let V1 := Rolling1588.regularStep false j origin 4 (X, Y)
    let V2 := Rolling1588.regularStep false j origin 3 V1
    let V3 := Rolling1588.regularStep false j origin 2 V2
    let V4 := Rolling1588.regularStep false j origin 1 V3
    let V5 := Rolling1588.regularStep false j origin 0 V4
    have result := (opening false (X, Y)).seq
      ((step false 0 4 4 (by decide) (by decide) (X, Y)).seq
      ((transfer false 0 (by decide) V1).seq
      ((step false 1 3 3 (by decide) (by decide) V1).seq
      ((step false 1 2 4 (by decide) (by decide) V2).seq
      ((transfer false 1 (by decide) V3).seq
      ((step false 2 1 4 (by decide) (by decide) V3).seq
      ((step false 2 0 3 (by decide) (by decide) V4).seq
        (closing false V5))))))))
    simpa only [StairGroups.basePacket, Rolling1588.stageOpen,
      Rolling1588.stageClose, Rolling1588.stageTransition,
      Rolling1588.regularPayload, Bool.false_eq_true, if_false, if_true,
      show ¬(1 : Nat) = 0 from by decide, List.append_assoc] using result
  · let V1 := Rolling1588.regularStep true j origin 0 (X, Y)
    let V2 := Rolling1588.regularStep true j origin 1 V1
    let V3 := Rolling1588.regularStep true j origin 2 V2
    let V4 := Rolling1588.regularStep true j origin 3 V3
    let V5 := Rolling1588.regularStep true j origin 4 V4
    have result := (opening true (X, Y)).seq
      ((step true 0 0 3 (by decide) (by decide) (X, Y)).seq
      ((step true 0 1 4 (by decide) (by decide) V1).seq
      ((transfer true 0 (by decide) V2).seq
      ((step true 1 2 4 (by decide) (by decide) V2).seq
      ((step true 1 3 3 (by decide) (by decide) V3).seq
      ((transfer true 1 (by decide) V4).seq
      ((step true 2 4 4 (by decide) (by decide) V4).seq
        (closing true V5))))))))
    simpa only [StairGroups.basePacket, Rolling1588.stageOpen,
      Rolling1588.stageClose, Rolling1588.stageTransition,
      Rolling1588.regularPayload, if_true, if_false,
      show ¬(1 : Nat) = 0 from by decide, List.append_assoc] using result

theorem basePacket_replay_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) :
    Rolling1588.StateTriple
      (Rolling1588.CodeFrame
        (Rolling1588.codeEncodeAt divide (History5.historyMap base (5 * j)))
        origin X Y)
      (StairGroups.basePacket divide d j)
      (fun state =>
        let V := CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) (Replay5.letters j))
          (X, Y)
        Rolling1588.CodeFrame
          (Rolling1588.codeEncodeAt (!divide)
            (History5.historyMap base (5 * j)))
          origin V.1 V.2 state) := by
  simpa only [Rolling1588.regularPayload_eq divide j hj origin enabled] using
    basePacket_frame half divide d j hd hj origin ctx enabled X Y

/-- A loaned base packet moves the same history cut as its record counterpart. -/
theorem basePacket_cut_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (first : 1 ≤ j)
    (hj : j < 102) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) :
    Rolling1588.StateTriple
      (Rolling1588.CutFrame (if divide then j else j + 1) origin X Y)
      (StairGroups.basePacket divide d j)
      (fun state =>
        let V := CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) (Replay5.letters j))
          (X, Y)
        Rolling1588.CutFrame (if divide then j + 1 else j)
          origin V.1 V.2 state) := by
  have nonzero : j ≠ 0 := by omega
  cases divide
  · intro state records input
    apply Rolling1588.cut_window_frame (j + 1) j j hj origin X Y _ _
      (StairGroups.basePacket false d j)
      (Rolling1588.otherEncodeCut_step base j 102).symm
      (Rolling1588.otherEncodeCut_body_disjoint (j + 1) j hj origin ctx _
        (basePacket_read_support half false d j hd hj)) _ state records input
    intro current tape frame
    have normalized : Rolling1588.CodeFrame
        (Rolling1588.codeEncodeAt false (History5.historyMap base (5 * j)))
        origin X Y current := by
      simpa [Rolling1588.encodeGroup, nonzero, show ¬j + 1 ≤ j from by omega]
        using frame
    simpa [Rolling1588.encodeGroup, nonzero, show ¬j + 1 ≤ j from by omega]
      using basePacket_replay_frame half false d j hd hj origin ctx enabled X Y
        current tape normalized
  · intro state records input
    apply Rolling1588.cut_window_frame j (j + 1) j hj origin X Y _ _
      (StairGroups.basePacket true d j)
      (Rolling1588.otherEncodeCut_step base j 102)
      (Rolling1588.otherEncodeCut_body_disjoint j j hj origin ctx _
        (basePacket_read_support half true d j hd hj)) _ state records input
    intro current tape frame
    have normalized : Rolling1588.CodeFrame
        (Rolling1588.codeEncodeAt true (History5.historyMap base (5 * j)))
        origin X Y current := by
      simpa [Rolling1588.encodeGroup, nonzero, show ¬j + 1 ≤ j from by omega]
        using frame
    simpa [Rolling1588.encodeGroup, nonzero, show ¬j + 1 ≤ j from by omega]
      using basePacket_replay_frame half true d j hd hj origin ctx enabled X Y
        current tape normalized

theorem packet_cut_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (first : 1 ≤ j)
    (hj : j < 102) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) :
    Rolling1588.StateTriple
      (Rolling1588.CutFrame (if divide then j else j + 1) origin X Y)
      (StairGroups.packet divide d j)
      (fun state =>
        let V := CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) (Replay5.letters j))
          (X, Y)
        Rolling1588.CutFrame (if divide then j + 1 else j)
          origin V.1 V.2 state) := by
  intro state records input
  have raw := basePacket_cut_frame half divide d j hd first hj origin ctx enabled
    X Y state records input
  have same := Replay5.placed_eq (Placement5.pi j)
    (StairGroups.basePacket divide d j)
    (fun q hq => Placement5.pi_outside j q hj hq) state records
    (Rolling1588.cutFrame_zero_region _ origin ctx X Y state input)
    (Rolling1588.cutFrame_zero_region _ origin ctx _ _ _ raw.2)
  change run (StairGroups.packet divide d j) records state =
    run (StairGroups.basePacket divide d j) records state at same
  rw [same]
  exact raw

private theorem cutSequence_frame {alpha : Type} (divide : Bool)
    (P : Nat → Program) (step : Nat → alpha → alpha)
    (F : Nat → alpha → State → Prop) (N : Nat)
    (packetLaw : ∀ j, 1 ≤ j → j < N → ∀ V,
      Rolling1588.StateTriple (F (if divide then j else j + 1) V) (P j)
        (F (if divide then j + 1 else j) (step j V)))
    (j n : Nat) (first : 1 ≤ j) (bound : j + n ≤ N) (V : alpha) :
    Rolling1588.StateTriple
      (F (if divide then j else j + n) V)
      (PacketSequence.program divide P j n)
      (F (if divide then j + n else j)
        (PacketSequence.payload divide step j n V)) := by
  induction n generalizing j V with
  | zero =>
      intro state records input
      simpa only [PacketSequence.program, PacketSequence.payload, Nat.add_zero,
        run] using And.intro (Eq.refl state.phase) input
  | succ n ih =>
      have hj : j < N := by omega
      have index : j + (n + 1) = (j + 1) + n := by omega
      cases divide
      · let W := PacketSequence.payload false step (j + 1) n V
        have later := ih (j + 1) (by omega) (by omega) V
        have last := packetLaw j first hj W
        simpa only [PacketSequence.program, PacketSequence.payload,
          Bool.false_eq_true, if_false, index] using later.seq last
      · have head := packetLaw j first hj V
        have later := ih (j + 1) (by omega) (by omega) (step j V)
        simpa only [PacketSequence.program, PacketSequence.payload, if_true,
          index] using head.seq later

theorem groups_cut_frame (half : HalfReplayHypothesis)
    (divide : Bool) (d j n : Nat) (hd : d ≤ 68) (first : 1 ≤ j)
    (bound : j + n ≤ 102) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) :
    Rolling1588.StateTriple
      (Rolling1588.CutFrame (if divide then j else j + n) origin X Y)
      (StairGroups.groups divide d j n)
      (fun state =>
        let V := Replay5.groupsPayload divide origin j n (X, Y)
        Rolling1588.CutFrame (if divide then j + n else j)
          origin V.1 V.2 state) := by
  let step := fun k V => CompressedFieldSupport.directionalPayload (!divide)
    (mixedTranscriptControls origin (base 2400) (Replay5.letters k)) V
  exact cutSequence_frame divide (StairGroups.packet divide d) step
    (fun k (V : Fp × Fp) => Rolling1588.CutFrame k origin V.1 V.2) 102
    (fun k hk kb V => packet_cut_frame half divide d k hd hk kb origin ctx
      enabled V.1 V.2)
    j n first bound (X, Y)


private theorem cutFrame_unique (cut : Nat) (origin : BasisState) (X Y : Fp)
    (a b : State) (ha : Rolling1588.CutFrame cut origin X Y a)
    (hb : Rolling1588.CutFrame cut origin X Y b)
    (phase : a.phase = b.phase) : a = b := by
  obtain ⟨rawA, phaseA, frameA, encodedA⟩ := ha
  obtain ⟨rawB, phaseB, frameB, encodedB⟩ := hb
  have rawEq : rawA = rawB := by
    apply State.extensionality
    · exact phaseA.trans (phase.trans phaseB.symm)
    · exact PairFrame.unique _ _ origin _ _ _ _ frameA frameB
  rw [encodedA, encodedB, rawEq]

/-- A loaned group slice and the corresponding record group have equal runs
on the exact cut frame, even when their measurement tapes are independent. -/
theorem groups_run_eq (half : HalfReplayHypothesis)
    (divide : Bool) (d j n : Nat) (hd : d ≤ 68) (first : 1 ≤ j)
    (bound : j + n ≤ 102) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) (s : State)
    (fresh old : List Bool)
    (input : Rolling1588.CutFrame (if divide then j else j + n)
      origin X Y s) :
    run (StairGroups.groups divide d j n) fresh s =
      run (Rolling1588.groups divide j n) old s := by
  have loan := groups_cut_frame half divide d j n hd first bound origin ctx
    enabled X Y s fresh input
  have record := Rolling1588.groups_cut_frame divide j n first bound origin ctx
    enabled X Y s old input
  exact cutFrame_unique (if divide then j + n else j) origin
    (Replay5.groupsPayload divide origin j n (X, Y)).1
    (Replay5.groupsPayload divide origin j n (X, Y)).2 _ _ loan.2 record.2
    (loan.1.trans record.1.symm)







end ECDSAAdd.Entrant.StairLoanReplay

end
end Merge_StairLoanReplay_at_QTop

