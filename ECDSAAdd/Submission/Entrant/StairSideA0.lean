theorem recordReverse_physical (isA : Bool) (i n : Nat)
    (bound : i + n ≤ 512) :
    GatePhysical (Rolling1588.reverse isA i n) := by
  induction n generalizing i with
  | zero => simp [Rolling1588.reverse, GatePhysical]
  | succ n ih =>
      have unpack : GatePhysical (Rolling1588.unpackAtTick isA i) := by
        rw [← Rolling1588.Integer.unpackFirst_base]
