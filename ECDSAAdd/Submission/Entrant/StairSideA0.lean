section Merge_StairField2V3Win_at_QTop

/-!
# LT47: the selected setup/X between two scratch windows (defect-2 fix)

The fixed program runs `unprefix ; setup ; X ; clearProgram` at both selected setup
sites (`SXW`).  On a state whose twelve window wires hold the window image of a clean
canonical state `s1` (`WinImg`), `unprefix` puts `s1` back on the window (`U_run`), the
setup reads the encoded packet 0 (`mix`), and `clearProgram` restores the window image
(`C_run`).  `sxw_bwd` / `sxw_fwd`: `SXW` maps the record state `t` to `sxState v t` and back.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3Win

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

/-! ## The window wires -/

/-- The twelve physical window wires. -/
def L : Finset Wire := (Finset.range 12).image FourScratchWindow.label

theorem mem_L {q : Wire} : q ∈ L ↔ ∃ r : Fin 12, FourScratchWindow.label r.val = q := by
  unfold L
  rw [Finset.mem_image]
  constructor
  · rintro ⟨r, hr, rfl⟩
    exact ⟨⟨r, Finset.mem_range.mp hr⟩, rfl⟩
  · rintro ⟨r, rfl⟩
    exact ⟨r.val, Finset.mem_range.mpr r.isLt, rfl⟩






theorem wires_Pf : wires FourScratchWindow.prefixProgram ⊆ L := by
  intro q hq
  rw [FourScratchWindow.supports.1] at hq
  exact hq

/-! ## Window states -/

def Canon (s : State) : Prop :=
  Prefix1590Codec.codeAt (History5.historyMap base 0) s.basis ∈ Prefix1590Codec.canonicalCodes

/-- The window wires of `b` hold the window image of the clean canonical state `s1`. -/
def WinImg (b : BasisState) (s1 : State) : Prop :=
  FourScratchWindow.Clean s1 ∧ Canon s1 ∧
    ∀ q ∈ L, b q = (run FourScratchWindow.prefixProgram [] s1).basis q

/-- `b` off the window, `s1` on it. -/
def mix (b : BasisState) (s1 : State) : BasisState :=
  fun q => if q ∈ L then s1.basis q else b q




/-- The window programs see only the window wires (any phases, any records). -/
theorem local_basis (P : Program) (hP : wires P ⊆ L) (y s : State)
    (h : ∀ q ∈ L, y.basis q = s.basis q) (m n : List Bool) :
    ∀ q ∈ L, (run P m y).basis q = (run P n s).basis q := by
  intro q hq
  have e : (run P n s).basis = (run P m ⟨y.phase, s.basis⟩).basis :=
    StairDivLoanTop.run_basis_records P n m s ⟨y.phase, s.basis⟩ rfl
  rw [e]
  exact (run_measured_locality P L hP y ⟨y.phase, s.basis⟩ m rfl h).2 q hq



/-! ## `fieldRename` fixes the window -/







/-! ## The selected setup between the windows -/











/-! ## The window invariant of the record walk -/

/-- `OB5.sig 511 (payloadWire base i)`: the `i`-th payload control (kernel view). -/
abbrev pctrl (i : Nat) : Wire := OB5.sig 511 (NewHistory5.payloadWire base i)

/-- The packet-0 controls `i ≠ 0` of the actual state (field view) hold the window image
of a clean canonical state `s1`, whose packet-0 controls agree with a record cut frame
of the transcript of `x`. -/
def WinT (x : Nat) (t : State) : Prop :=
  ∃ (s1 : State) (c : Nat) (origin : BasisState) (X Y : Fp) (s' : State),
    FourScratchWindow.Clean s1 ∧ Canon s1 ∧ FrontierReplay1591.Context origin ∧
    StairField2V3Seg.TraceOK x origin ∧
    Rolling1588.CutFrame c origin X Y (pullState (OB5.sig 511) s') ∧
    (∀ i : Fin 8, s'.basis (pctrl i.val) = s1.basis (pctrl i.val)) ∧
    ∀ i : Fin 8, i.val ≠ 0 → (StairField2V3Seg.pullIn t).basis (Prefix1590.payload0 i) =
      (run FourScratchWindow.prefixProgram [] s1).basis (Prefix1590.payload0 i)

theorem pctrl_payload0 : ∀ i : Fin 8, pctrl i.val = Prefix1590.payload0 i := by
  decide +kernel

theorem payload0_facts : ∀ i : Fin 8, i.val ≠ 0 →
    Prefix1590.payload0 i ≠ base 768 ∧ Prefix1590.payload0 i ≠ base 0 ∧
      ∃ r : Fin 12, FourScratchWindow.label r.val = Prefix1590.payload0 i := by
  decide +kernel

theorem L_not_E (q : Wire) (hq : q ∈ L) : q ∉ StairField2V3RecScratch.E := by
  obtain ⟨r, rfl⟩ := mem_L.mp hq
  exact StairField2V3RecScratch.label_not_E r.val

/-- After the scratch clear, the borrowed view of a state that agrees off `E` with a
clean canonical state `s1` holds the window image of `s1` on the packet-0 controls. -/
theorem window_payload (y s1 : State) (b : List Bool)
    (agree : ∀ q, q ∉ StairField2V3RecScratch.E → y.basis q = s1.basis q)
    (clean : FourScratchWindow.Clean s1) (member : Canon s1) (i : Fin 8) (hi : i.val ≠ 0) :
    (pullState Prefix1590.borrow (run FourScratchWindow.clearProgram b y)).basis
        (Prefix1590.payload0 i) =
      (run FourScratchWindow.prefixProgram [] s1).basis (Prefix1590.payload0 i) := by
  have cy := StairField2V3RecScratch.clean_transfer y s1 agree clean
  have my := StairField2V3RecScratch.member_transfer y s1 agree member
  rw [FourScratchWindow.clear_eq y b [] cy my]
  obtain ⟨h768, h0, r, hr⟩ := payload0_facts i hi
  show (run FourScratchWindow.prefixProgram [] y).basis
    (Prefix1590.borrow (Prefix1590.payload0 i)) = _
  rw [StairField2V3RecScratch.borrow_fix _ h768 h0]
  exact local_basis _ wires_Pf y s1 (fun q hq => agree q (L_not_E q hq)) [] [] _
    (mem_L.mpr ⟨r, hr⟩)

/-- A program that avoids the packet-0 controls `i ≠ 0` (field view) keeps `WinT`. -/
theorem winT_lift (x : Nat) (P : Program) (avoid : ∀ q ∈ wires P, StairField2V3RecScratch.Off q)
    (m : List Bool) (t : State) (h : WinT x t) :
    WinT x (run (StairField2V3Entry.liftF P) m t) := by
  obtain ⟨s1, c, origin, X, Y, s', cl, cn, ctx, tr, frame, agree, pay⟩ := h
  refine ⟨s1, c, origin, X, Y, s', cl, cn, ctx, tr, frame, agree, fun i hi => ?_⟩
  rw [StairField2V3RecScratch.pullIn_liftF,
    run_preserves_outside _ _ _ _ (fun hq => (avoid _ hq).2 i rfl)]
  exact pay i hi

end ECDSAAdd.Entrant.StairField2V3Win

end
end Merge_StairField2V3Win_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitRec_at_QTop` -/
section Merge_StairField2V3ExitRec_at_QTop

/-!
# LT43d: record facts of the multiplication (exit) side of field 2

Mirror of LT42's `StairField2V3RecScratch` on the exit side.  After the reference
opening (`ExitMiddleX k x`), the head `headE` and the packet groups in the
multiplication direction down to a cut `c`, the field view of the actual state
agrees off `EP = E ∪ payload0` with a placed record state whose kernel view carries
the record `Rolling1588.CutFrame c origin X Y` (`InvE x c`).  The frame's `origin`
is the forced record preparation state of the input `x` (`TraceOK x origin`).

On a `CutFrame c` the packets `≥ c` are A-encoded, exactly as in
`recVal origin` (`frame_val`: `allEncodeCut c` and `allEncode true` agree off the
history ids of the packets `< c`; the raw state agrees with `origin` off the r/y
words), and the scratch is zero (`StairField2V3RecScratch.frame_zero`).

Sections "Exit helpers" are verbatim copies of LT32's helpers
(`StairLoanField7Values`, which is not in this tree).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3ExitRec

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairField2V3Delta StairField2V3Seg StairField2V3ExitPlanR StairField2V3ExitStepsR
open StairField2V3RecScratch
open StairPhysicalLayout StairOuterPlacement

attribute [local irreducible] wires run

/-! ## Exit helpers (LT32) -/

theorem canonical_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.canonical_special_at origin X Y state 2409
    (by simp) input
  have b := Rolling1588Frame.canonical_special_at origin X Y state 2410
    (by simp) input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

theorem exitHead_avoid (q : Wire) (hq : q ∈ wires Rolling1588.exitHead) : Off q := by
  refine ⟨?_, ?_⟩
  · intro hE
    have inField (r : Wire) (hr : r ∈ wires Rolling1588.exitHead)
        (fix : Prefix1590.borrow r = r) : r ∈ wires Rolling1588.exitField := by
      unfold Rolling1588.exitField
      exact mem_second_of_four _ _ _ _ _ (mem_rename_fixed _ _ _ hr fix)
    simp only [E, List.mem_cons, List.not_mem_nil, or_false] at hE
    rcases hE with rfl | rfl | rfl
    · exact Rolling1588.exitField_hosts_free.1
        (inField _ hq (borrow_fix _ (by decide +kernel) (by decide +kernel)))
    · exact Rolling1588.exitHosted_avoids_host
        (mem_hosted _ _ (inField _ hq (borrow_fix _ (by decide +kernel) (by decide +kernel)))
          (by decide +kernel))
    · apply Rolling1588.exit_control_free
      unfold Rolling1588.exitFieldHosted
      exact mem_parity _ _ _ _ _
        (mem_hosted _ _ (inField _ hq (borrow_fix _ (by decide +kernel) (by decide +kernel)))
          (by decide +kernel))
        (Equiv.swap_apply_of_ne_of_ne (by decide +kernel) (by decide +kernel))
  · intro i h
    subst h
    exact Rolling1588.exitHead_payload_free i hq

/-! ## Pieces of the record head -/

/-- The lifted core of `headE`: center, copy, endpoint. -/
def headCore : Program :=
  R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
    renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false)

theorem headE_shape :
    headE = StairSchedule.paritySetup ++ StairSchedule.hostedX ++
      StairSchedule.fieldRename FourScratchWindow.clearProgram ++ liftF headCore ++
        grpF 100 2 := rfl

theorem headCore_off : ∀ q ∈ wires headCore, Off q := by
  intro q hq
  apply exitHead_avoid
  unfold headCore at hq
  unfold Rolling1588.exitHead
  simp only [rename_append', wires_append, Finset.mem_union] at hq ⊢
  tauto

theorem groupsF_off (j n : Nat) (hj : 1 ≤ j) (hb : j + n ≤ 102) :
    ∀ q ∈ wires (renameProgram (OB5.sig 511) (Rolling1588.groups false j n)), Off q := by
  intro q hq
  apply exitHead_avoid
  have h1 := groups_false_add (j - 1) (102 - j) 1
  rw [show j - 1 + (102 - j) = 101 by omega, show 1 + (j - 1) = j by omega] at h1
  have h2 := groups_false_add n (102 - j - n) j
  rw [show n + (102 - j - n) = 102 - j by omega] at h2
  unfold Rolling1588.exitHead
  rw [h1, h2]
  simp only [rename_append', wires_append, Finset.mem_union]
  tauto

/-! ## The exit invariant -/

/-- At a packet cut `c` on the multiplication side: the field view of the actual
state agrees off `EP` with a placed record state whose kernel view carries the record
`CutFrame c`, for the record preparation state `origin` of the input `x`. -/
def InvE (x c : Nat) (t : State) : Prop :=
  ∃ (origin : BasisState) (X Y : Fp) (s : State),
    FrontierReplay1591.Context origin ∧ origin (base 2400) = true ∧ TraceOK x origin ∧
    regValue (skywalkSharedField base).a origin = 0 ∧
    Rolling1588.CutFrame c origin X Y (pullState (OB5.sig 511) s) ∧
    ∀ q, Off q → (StairField2V3Seg.pullIn t).basis q = s.basis q

/-- One block of multiplication groups moves the cut down. -/
theorem inv_stepE (x j n : Nat) (hj : 1 ≤ j) (hb : j + n ≤ 102) (t : State)
    (h : InvE x (j + n) t) (m : List Bool) : InvE x j (run (grpF j n) m t) := by
  obtain ⟨origin, X, Y, s, ctx, en, tr, ha, frame, agree⟩ := h
  have tri := Rolling1588.groups_cut_frame false j n hj hb origin ctx en X Y
    (pullState (OB5.sig 511) s) m frame
  refine ⟨origin, (Replay5.groupsPayload false origin j n (X, Y)).1,
    (Replay5.groupsPayload false origin j n (X, Y)).2,
    run (renameProgram (OB5.sig 511) (Rolling1588.groups false j n)) m s, ctx, en, tr, ha,
    ?_, ?_⟩
  · rw [StairField2V3Packet.sig_conj,
      StairReplay.pullState_involutive (OB5.sig 511) (OB5.sig_invol 511 (by decide))]
    exact tri.2
  · intro q hq
    unfold grpF
    rw [pullIn_liftF]
    exact run_agree_offP _ (groupsF_off j n hj hb) _ _ m agree q hq

/-- The record frame after the head core, on a canonical record frame. -/
theorem headCore_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (enabled : origin (base 2400) = true) (Y : Fp) (st : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 st) (m : List Bool) :
    ∃ X' Y' : Fp, Rolling1588.CutFrame 102 origin X' Y'
      (pullState (OB5.sig 511) (run headCore m st)) := by
  have w : ∀ b, Rolling1588Frame.EncodedFieldFrame false origin (Y / 2) (Y / 2)
      (run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b st) := by
    intro b
    rw [run_append]
    exact (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ _
      (R2SqEp760.center760_frame origin ctx ha Y st _ input).2).2
  unfold headCore
  rw [run_append (R2SqEp760.center760 ++ HalfFieldOB5.copyN), StairField2V3Packet.sig_conj,
    StairReplay.pullState_involutive (OB5.sig 511) (OB5.sig_invol 511 (by decide))]
  have e := R2SqEp760.endPacket760_frame false false origin ctx enabled (Y / 2) (Y / 2)
    (fun bad => absurd bad (by decide)) (fun _ => rfl) _
    (m.drop (measurementCount (R2SqEp760.center760 ++ HalfFieldOB5.copyN)))
    (w (m.take (measurementCount (R2SqEp760.center760 ++ HalfFieldOB5.copyN))))
  exact ⟨_, _, (Rolling1588.cutFrame_end origin _ _ _).mpr e.2⟩



/-! ## Reachability: the cut along the reference prefixes -/








/-! ## Values on a `CutFrame`: packets `≥ c` are A-encoded -/

/-- `allEncodeCut c` and `allEncode true` agree off the sites of the packets `< c`. -/
theorem cut_true_agree (c : Nat) : ∀ n, n ≤ 102 → ∀ (raw : State) (q : Wire),
    q ∉ wires (Rolling1588.allEncode base true (min c n)) →
    (run (Rolling1588.allEncodeCut base c n) [] raw).basis q =
      (run (Rolling1588.allEncode base true n) [] raw).basis q
  | 0, _, _, _, _ => rfl
  | n + 1, hn, raw, q, hq => by
      have s1 : Rolling1588.allEncodeCut base c (n + 1) =
          Rolling1588.allEncodeCut base c n ++
            Rolling1588.encodeGroup base (decide (c ≤ n)) n := rfl
      have s2 : Rolling1588.allEncode base true (n + 1) =
          Rolling1588.allEncode base true n ++ Rolling1588.encodeGroup base true n := rfl
      rw [s1, s2, run_append, run_append]
      simp only [List.take_nil, List.drop_nil]
      by_cases hc : c ≤ n
      · have hm : min c (n + 1) = c := by omega
        have hm' : min c n = c := by omega
        rw [hm] at hq
        rw [decide_eq_true hc]
        have dis := Rolling1588.allEncode_disjoint base true base_pool_nodup c n (by omega) hc
          (by omega)
        by_cases hG : q ∈ wires (Rolling1588.encodeGroup base true n)
        · refine (ECDSAAdd.Arithmetic.run_local_increment _ _ _ [] ?_).2 q hG
          intro r hr
          exact cut_true_agree c n (by omega) raw r
            (by rw [hm']; exact fun h => Finset.disjoint_left.mp dis h hr)
        · rw [run_preserves_outside _ _ _ q hG, run_preserves_outside _ _ _ q hG]
          exact cut_true_agree c n (by omega) raw q (by rw [hm']; exact hq)
      · have hm : min c (n + 1) = n + 1 := by omega
        have hm' : min c n = n := by omega
        rw [hm, s2, wires_append, Finset.mem_union, not_or] at hq
        have hG : q ∉ wires (Rolling1588.encodeGroup base (decide (c ≤ n)) n) := by
          rw [Rolling1588.encodeGroup_support_eq]
          have h2 := hq.2
          rw [Rolling1588.encodeGroup_support_eq] at h2
          exact h2
        rw [run_preserves_outside _ _ _ q hG, run_preserves_outside _ _ _ q hq.2]
        exact cut_true_agree c n (by omega) raw q (by rw [hm']; exact hq.1)

theorem hist_not_ry : ∀ q ∈ histL, q ∉ ryL := by
  intro q hq hry
  have hid : ∃ id, (id < 512 ∨ (1028 ≤ id ∧ id < 1540)) ∧ base id = q := by
    unfold histL at hq
    rcases List.mem_append.mp hq with h | h
    · obtain ⟨id, -, h2, e⟩ := StairField2V3SegSpec.mem_wireBlock h
      exact ⟨id, Or.inl (by omega), e⟩
    · obtain ⟨id, h1, h2, e⟩ := StairField2V3SegSpec.mem_wireBlock h
      exact ⟨id, Or.inr ⟨h1, by omega⟩, e⟩
  obtain ⟨id, hr, rfl⟩ := hid
  unfold ryL at hry
  rw [balancedSharedPorts_r, balancedSharedPorts_y] at hry
  rcases List.mem_append.mp hry with h | h
  · obtain ⟨id', h1, h2, e⟩ := StairField2V3SegSpec.mem_wireBlock h
    have := base_injective e
    omega
  · obtain ⟨id', h1, h2, e⟩ := StairField2V3SegSpec.mem_wireBlock h
    have := base_injective e
    omega

/-- The A-encoder reads the raw state only off the r/y words. -/
theorem raw_agree (origin : BasisState) (raw : State)
    (off : ∀ q, q ∉ (balancedSharedPorts base (base 2409)).r →
      q ∉ (balancedSharedPorts base (base 2409)).y → raw.basis q = origin q)
    (L : Wire) (hry : L ∉ ryL) :
    (run (Rolling1588.allEncode base true 102) [] raw).basis L =
      (run (Rolling1588.allEncode base true 102) [] ⟨false, origin⟩).basis L := by
  have onP : ∀ q ∈ wires (Rolling1588.allEncode base true 102),
      raw.basis q = (⟨false, origin⟩ : State).basis q := by
    intro q hq
    have hh : q ∈ histL :=
      List.mem_toFinset.mp (Rolling1588.allEncode_history_support base true 102 (by decide) hq)
    have hn := hist_not_ry q hh
    exact off q (fun h => hn (List.mem_append_left _ h)) (fun h => hn (List.mem_append_right _ h))
  by_cases used : L ∈ wires (Rolling1588.allEncode base true 102)
  · exact (ECDSAAdd.Arithmetic.run_local_increment _ _ _ [] onP).2 L used
  · rw [run_preserves_outside _ _ _ _ used, run_preserves_outside _ _ _ _ used]
    exact off L (fun h => hry (List.mem_append_left _ h)) (fun h => hry (List.mem_append_right _ h))

/-- Kernel labels of the history ids of the packets `≥ c` (and the letters above). -/
def highB (c : Nat) (L : Wire) : Bool :=
  decide (16 ≤ L) &&
    ((decide (5 * c ≤ L - 16) && decide (L - 16 < 512)) ||
      (decide (1028 + 5 * c ≤ L - 16) && decide (L - 16 < 1540)))

theorem high_hist (id : Nat) (h : id < 512 ∨ (1028 ≤ id ∧ id < 1540)) : base id ∈ histL := by
  unfold histL wireBlock
  rcases h with h | h
  · exact List.mem_append_left _ (List.mem_map.mpr ⟨id, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩)
  · exact List.mem_append_right _ (List.mem_map.mpr ⟨id, List.mem_range'_1.mpr ⟨h.1, by omega⟩, rfl⟩)

/-- **Values of a record `CutFrame c`** on the labels of the packets `≥ c`: the
A-encoded transcript of `origin`. -/
theorem frame_val (c : Nat) (hc : c ≤ 102) (origin : BasisState) (X Y : Fp) (st : State)
    (frame : Rolling1588.CutFrame c origin X Y st) (L : Wire) (hi : highB c L = true) :
    st.basis L = (run (Rolling1588.allEncode base true 102) [] ⟨false, origin⟩).basis L := by
  obtain ⟨raw, -, pair, enc⟩ := frame
  unfold highB at hi
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq] at hi
  obtain ⟨h16, hid⟩ := hi
  have e : L = base (L - 16) := (Nat.sub_add_cancel h16).symm
  have away : L ∉ wires (Rolling1588.allEncode base true (min c 102)) := by
    rw [Nat.min_eq_left hc, e]
    refine StairField2V3SegSpec.allEncode_avoid base base_injective c (L - 16) ?_
    rcases hid with ⟨h1, h2⟩ | ⟨h1, -⟩
    · exact Or.inl ⟨h1, Nat.lt_of_lt_of_le h2 (by decide)⟩
    · exact Or.inr h1
  have hry : L ∉ ryL := by
    apply hist_not_ry
    rw [e]
    refine high_hist (L - 16) ?_
    rcases hid with ⟨-, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl h2
    · exact Or.inr ⟨Nat.le_trans (Nat.le_add_right 1028 (5 * c)) h1, h2⟩
  rw [enc, cut_true_agree c 102 le_rfl raw L away]
  exact raw_agree origin raw pair.2.2 L hry

/-! ## Site facts of the invariant (arbitrary sites) -/


/-- LT48 (replay budget): `recVal` unfolded through a function-level `rfl` (one kernel delta step).
`unfold recVal` realizes `recVal.eq_1`, whose kernel check costs ≈ 40 s per module. -/
theorem recVal_funER : recVal = fun (origin : BasisState) (r : Wire) =>
    (ECDSAAdd.run (Rolling1588.allEncode ECDSAAdd.Arithmetic.MappedCompressed.base true 102) []
      ⟨false, origin⟩).basis (OB5.sig 511 r) := rfl

theorem recVal_defER (origin : BasisState) (r : Wire) :
    recVal origin r = (ECDSAAdd.run (Rolling1588.allEncode ECDSAAdd.Arithmetic.MappedCompressed.base true 102) []
      ⟨false, origin⟩).basis (OB5.sig 511 r) :=
  congrFun (congrFun recVal_funER origin) r

/-- **Value and zero facts with one transcript.** -/
theorem inv_facts (x c : Nat) (hc : c ≤ 102) (t : State) (h : InvE x c t) :
    ∃ origin, TraceOK x origin ∧
      (∀ r, r ∉ EP → highB c (OB5.sig 511 r) = true →
        t.basis (fieldPlace r) = recVal origin r) ∧
      (∀ r, r ∉ EP → ZeroClass (OB5.sig 511 r) → t.basis (fieldPlace r) = false) := by
  obtain ⟨origin, X', Y', s, ctx, -, tr, -, frame, agree⟩ := h
  have e1 : ∀ r, t.basis (fieldPlace r) = (StairField2V3Seg.pullIn t).basis r := fun _ => rfl
  have e2 : ∀ r, s.basis r = (pullState (OB5.sig 511) s).basis (OB5.sig 511 r) := by
    intro r
    show s.basis r = s.basis (OB5.sig 511 (OB5.sig 511 r))
    rw [OB5.sig_invol 511 (by decide)]
  refine ⟨origin, tr, ?_, ?_⟩
  · intro r hEP hi
    rw [e1, agree r (off_of_not_EP r hEP), e2, recVal_defER]
    exact frame_val c hc _ X' Y' _ frame _ hi
  · intro r hEP hz
    rw [e1, agree r (off_of_not_EP r hEP), e2]
    exact frame_zero c origin ctx X' Y' _ frame _ hz

/-! ## The record facts of the rows -/

/-- Per-row finite check: every future payload site is off `EP` and lands (in kernel
coordinates) on a history label of a packet `≥ c`. -/
def ValFacts (B c : Nat) : Prop :=
  ∀ r ∈ futurePayload B, r ∉ EP ∧ highB c (OB5.sig 511 r) = true

theorem vals_of_inv (x B c : Nat) (hc : c ≤ 102) (vf : ValFacts B c) (t : State)
    (h : InvE x c t) :
    ∃ origin, TraceOK x origin ∧
      (∀ r ∈ futurePayload B, t.basis (fieldPlace r) = recVal origin r) ∧
      (∀ r, r ∉ EP → ZeroClass (OB5.sig 511 r) → t.basis (fieldPlace r) = false) := by
  obtain ⟨origin, tr, hv, hz⟩ := inv_facts x c hc t h
  exact ⟨origin, tr, fun r hr => hv r (vf r hr).1 (vf r hr).2, hz⟩


theorem valFacts0 : ValFacts 87 85 := by unfold ValFacts; decide +kernel
theorem valFacts1 : ValFacts 62 90 := by unfold ValFacts; decide +kernel
theorem valFacts2 : ValFacts 47 93 := by unfold ValFacts; decide +kernel
theorem valFacts3 : ValFacts 32 96 := by unfold ValFacts; decide +kernel
theorem valFacts4 : ValFacts 22 98 := by unfold ValFacts; decide +kernel
theorem valFacts5 : ValFacts 12 100 := by unfold ValFacts; decide +kernel








