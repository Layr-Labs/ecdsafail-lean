  | m, [x], _, cin, _, k => ztM lo width m (literalConstSum (decide (k%2=1)) x cin)
  | m, _, _, _, _, _ => m

theorem k1_ztM_lca (lo width : Nat) : ∀ (xs cs : List Wire) (cin one : Wire) (k m : Nat),
