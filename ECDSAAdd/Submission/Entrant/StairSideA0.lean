abbrev holes : List Wire := StairSqLoopA.holes



/-! K4-D (replay budget): the holes and the layout `LB` in closed form (as `StairSquareBChecks.K4DQ`): `holes`
walked `List.range' 4115 5699` per hole; `K4DE.LB_eq` rewrites `LB` into the same layout with `List.range'`
fields (proved symbolically) so the scans below evaluate short intervals instead of pool slices. -/
namespace K4DE

theorem pw_lt (i : Nat) (h : i < 5699) : Baselines.layout.core.poolWire i = 4115 + i := by
  show (List.range' 4115 5699).getD i 0 = 4115 + i
  simp [List.getD_eq_getElem?_getD, h]

theorem blk (a n : Nat) (h : a + n ≤ 5699) :
    (List.range' a n).map Baselines.layout.core.poolWire = List.range' (4115 + a) n := by
  rw [← List.map_add_range']
  apply List.map_congr_left
  intro x hx
  rw [List.mem_range'_1] at hx
  exact pw_lt x (by omega)

theorem mr (a n : Nat) : (List.range n).map (· + a) = List.range' a n := by
  rw [List.range'_eq_map_range]
  exact List.map_congr_left (fun x _ => Nat.add_comm x a)

/-- `LB` with its fields as intervals. -/
def LBF : CuccaroStreamedSquareWideLayout :=
  ⟨⟨List.range' 258 256, List.range' 2 256, List.range' 4115 258, List.range' 4373 128, List.range' 4501 256,
    4757, 4758, 4759, 4760, 4761, 4762, 4763⟩, List.range' 4764 126⟩


/-! One pass over the instructions (as `StairTerminalV3.K4DT`). -/
def corrOK (c : Wire → Bool) : List Correction → Bool
  | [] => true
  | .Z t :: cs => c t && corrOK c cs
  | .CZ a b :: cs => c a && c b && corrOK c cs

def instrOK (c : Wire → Bool) : Instr → Bool
  | .X t => c t
  | .CX a t => c a && c t
  | .CCX a b t => c a && c b && c t
  | .measureX t c0 c1 => c t && corrOK c c0 && corrOK c c1

/-- Every wire of every instruction of `P` satisfies `c`. -/
def allK (c : Wire → Bool) (P : Program) : Bool := P.all (instrOK c)

theorem corrOK_sound (c : Wire → Bool) :
    ∀ (cs : List Correction), corrOK c cs = true → ∀ q ∈ correctionWires cs, c q = true
  | [], _, q, hq => by simp [correctionWires] at hq
  | .Z t :: cs, h, q, hq => by
    simp only [corrOK, Bool.and_eq_true] at h
    simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with rfl | hq
    · exact h.1
    · exact corrOK_sound c cs h.2 q hq
  | .CZ a b :: cs, h, q, hq => by
    simp only [corrOK, Bool.and_eq_true] at h
    simp only [correctionWires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with (rfl | rfl) | hq
    · exact h.1.1
    · exact h.1.2
    · exact corrOK_sound c cs h.2 q hq

theorem instrOK_sound (c : Wire → Bool) (i : Instr) (h : instrOK c i = true) :
    ∀ q ∈ i.wires, c q = true := by
  intro q hq
  cases i with
  | X t =>
    simp only [Instr.wires, Finset.mem_singleton] at hq
    subst hq
    exact h
  | CX a t =>
    simp only [instrOK, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact h.1
    · exact h.2
  | CCX a b t =>
    simp only [instrOK, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl | rfl
    · exact h.1.1
    · exact h.1.2
    · exact h.2
  | measureX t c0 c1 =>
    simp only [instrOK, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with (rfl | hq) | hq
    · exact h.1.1
    · exact corrOK_sound c c0 h.1.2 q hq
    · exact corrOK_sound c c1 h.2 q hq

theorem allK_sound (c : Wire → Bool) :
    ∀ (P : Program), allK c P = true → ∀ q ∈ wires P, c q = true
  | [], _, q, hq => by simp [wires] at hq
  | i :: P, h, q, hq => by
    simp only [allK, List.all_cons, Bool.and_eq_true] at h
    simp only [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · exact instrOK_sound c i h.1 q hq
    · exact allK_sound c P h.2 q hq

theorem allK_append (c : Wire → Bool) (P Q : Program) : allK c (P ++ Q) = (allK c P && allK c Q) :=
  List.all_append

theorem allK_take (c : Wire → Bool) (P : Program) (i : Nat) (h : allK c P = true) : allK c (P.take i) = true :=
  List.all_eq_true.mpr (fun x hx => List.all_eq_true.mp h x (List.mem_of_mem_take hx))

theorem allK_drop (c : Wire → Bool) (P : Program) (i : Nat) (h : allK c P = true) : allK c (P.drop i) = true :=
  List.all_eq_true.mpr (fun x hx => List.all_eq_true.mp h x (List.mem_of_mem_drop hx))

/-- Off the 39 holes (`[4840, 4875) ∪ [4876, 4880)`). -/
def holeB (x : Nat) : Bool := Nat.blt x 4840 || Nat.ble 4880 x || Nat.beq x 4875

end K4DE

/-! K2 (replay budget): the four scans were `decide +kernel` over `hs.any` per gate (16.2 s eSubK, 16.0 s rebuild,
3.4 s eAddLo, 1.6 s park).  Now: one bit-mask test per gate wire (`K2.touchedAny_of_mask`, a copy of
`StairSquareBChecks.K2Hit`), the record's literal copy of the rebuild (`LocalRebuild.literal`), and the
subtractor's register support for `eSubK`. -/
namespace K2
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

def maskL : List Nat → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| maskL xs

theorem testBit_maskL : ∀ (l : List Nat) (q : Nat), (maskL l).testBit q = decide (q ∈ l)
  | [], q => by simp [maskL]
  | x :: xs, q => by
    simp only [maskL, Nat.testBit_or, testBit_maskL xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm

theorem disj_of_maskL (A B : List Nat) (h : A.all (fun q => !(maskL B).testBit q) = true) :
    ∀ q ∈ A, q ∉ B := by
  intro q hq
  have t := List.all_eq_true.mp h q hq
  rw [testBit_maskL, Bool.not_eq_true', decide_eq_false_iff_not] at t
  exact t

def corrHit (m : Nat) : Correction → Bool
  | .Z a => m.testBit a
  | .CZ a b => m.testBit a || m.testBit b

def instrHit (m : Nat) : Instr → Bool
  | .X a => m.testBit a
  | .CX a b => m.testBit a || m.testBit b
  | .CCX a b d => m.testBit a || m.testBit b || m.testBit d
  | .measureX a cs ds => m.testBit a || cs.any (corrHit m) || ds.any (corrHit m)






section
attribute [local irreducible] ECDSAAdd.wires

theorem subTop_support (h r cs : List Wire) (cin z u v k : Wire) (hl : (h++[z]).length=(r++[u]).length)
    (hc : cs.length+1=(r++[u]).length) :
    wires (KnownTopAdd.subTop h r cs cin z u v k)⊆(k::cin::(h++[z]++(r++[u])++cs++[v])).toFinset := by
  have e : KnownTopAdd.subTop h r cs cin z u v k=[Instr.measureX k [] []]++
      (subInPlace (h++[z]) (r++[u]) cs cin++[Instr.CX u v]) := rfl
  have w1 : wires [Instr.measureX k [] []]={k} := by
    simp [wires,Instr.wires,correctionWires]
  have w2 : wires [Instr.CX u v]={u,v} := by
    simp [wires,Instr.wires]
  rw [e,wires_append,wires_append,subInPlace,wires_append,wires_append,notRegister_wires,
    addInPlace_wires _ _ _ _ hl hc,w1,w2]
  intro q hq
  apply List.mem_toFinset.mpr
  simp only [Finset.mem_union,Finset.mem_singleton,Finset.mem_insert,List.mem_toFinset,List.mem_cons,
    List.mem_append] at hq ⊢
  tauto

end

