/-- LT44 (replay budget): the pool is `List.range' 4115 5699`, so pool wires are arithmetic. -/
theorem poolWire_eq (i : Nat) (h : i < 5699) : Baselines.layout.core.poolWire i = 4115 + i := by
  show (List.range' 4115 5699).getD i 0 = 4115 + i
  simp [List.getD_eq_getElem?_getD, h]




/-- LT44: the record arena as explicit ranges (`StairPhysicalLayout.arenaNat`), from
`poolWire_eq` instead of 1,600 pool-list walks (58 s → 1 s). -/
theorem recordArena_eqN : recordArena =
    [1] ++ List.range' 2 256 ++ List.range' 258 256 ++ [0, 9815, 9814, 4112] ++
      List.range' 4115 515 ++ List.range' 4833 311 ++ List.range' 5399 257 ++ [5915] := by
  have blk : ∀ a n b, b = 4115 + a → a + n ≤ 5699 →
      wireBlock Baselines.layout.core.poolWire a n = List.range' b n := by
    intro a n b hb h
    subst hb
    unfold wireBlock
    rw [← List.map_add_range']
    apply List.map_congr_left
    intro i hi
    exact poolWire_eq i (by have := List.mem_range'_1.mp hi; omega)
  have p1800 : Baselines.layout.core.poolWire 1800 = 5915 := poolWire_eq 1800 (by omega)
  show WrapperOB5.sites Baselines.layout = _
  unfold WrapperOB5.sites
  rw [blk 0 515 4115 rfl (by omega), blk 718 311 4833 rfl (by omega),
    blk 1284 257 5399 rfl (by omega), p1800]
  -- K4-B (replay budget): the pool part is syntactically equal; decide only the point/flag head
  refine congrArg (· ++ [5915]) (congrArg (· ++ List.range' 5399 257)
    (congrArg (· ++ List.range' 4833 311) (congrArg (· ++ List.range' 4115 515) ?_)))
  decide +kernel


