  placedGroups loans true 43 100 2 ++
    renameProgram (OB5.sig 511) loans.divEndpoint ++
    HalfFieldOB5.copyN ++ loans.canon


/-- Multiplication prefix through packets 101 and 100.  The moved setup and
hosted-X occur immediately after this program and before `RSegLast`. -/
def exitHeadPrefix (loans : StairLoans) : Program :=
  loans.center ++ HalfFieldOB5.copyN ++
    placedEndPacket loans false 68 ++
    placedGroups loans false 43 100 2





def parityRename (P : Program) : Program :=
  renameProgram (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) P

def fieldRename (P : Program) : Program :=
  parityRename (renameProgram HostOB5.hostSwap P)

def paritySetup : Program :=
