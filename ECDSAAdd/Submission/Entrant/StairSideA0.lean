    have hk := key start q hs hq
    have n1 : History5.historyMap base start ⟨q, hq⟩ ≠ w := by
      show History5.historyId start ⟨q, hq⟩ + 16 ≠ w
      unfold History5.historyId
      split
      · exact ne _ _ hk.1 hw
      · exact ne _ _ hk.2 hw
    have small : ∀ x : Nat, x < 10 → x < 528 ∨ (1044 ≤ x ∧ x < 1556) := by intro x hx; omega
    have n2 : q ≠ w := ne _ _ (small q hq) hw
    exact ⟨fun e => absurd e n1, fun e => absurd e n2⟩
  · exact Iff.rfl

theorem packAfter_keeps_pt (n : Nat) (hn : n ≤ 512) {q : Wire} (hq : q ∈ phaseTargets) :
    Keeps q (Rolling1588.Integer.packAfter base true n) := by
  have ho := phaseTargets_outHist q hq
  unfold Rolling1588.Integer.packAfter
  split
  · unfold Rolling1588.Integer.encode
    split
    · exact keeps_rename _ (label_pre_hist _ (by omega) q ho)
        (zt_of_ztAll 739 820 true phaseTargets _ phaseTargets_window chk_pkeep_encNew q hq)
    · exact keeps_rename _ (label_pre_hist _ (by omega) q ho)
        (zt_of_ztAll 739 820 true phaseTargets _ phaseTargets_window chk_pkeep_encA q hq)
  · exact keeps_nil q

theorem encodePrefix_keeps_pt {q : Wire} (hq : q ∈ phaseTargets) :
    ∀ n, n ≤ 512 → Keeps q (Rolling1588.Integer.encodePrefix base true n) := by
  intro n
  induction n with
  | zero => intro _; exact keeps_nil q
  | succ n ih =>
    intro h
    show Keeps q (Rolling1588.Integer.encodePrefix base true n ++
      Rolling1588.Integer.packAfter base true n)
    exact keeps_append (ih (by omega)) (packAfter_keeps_pt n (by omega) hq)

/-- Zero facts of a compact walk stage (generic in the tick). -/
theorem stage_fields_zero (r : SkywalkRails.State) (i : Nat) (hi : i ≤ 512) (s : BasisState)
    (hs : W.CompactSkywalkStage base r i s) :
    (∀ j, i ≤ j → j < 512 → s (base (j + 258)) = false) ∧
      (∀ q ∈ wireBlock base 1540 257, s q = false) ∧
      (∀ q ∈ (W.compactSkywalkSignPoolB base i).released, s q = false) := by
