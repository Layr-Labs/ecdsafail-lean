/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCallerEndpointCheck_at_StairSideA` -/
section Merge_StairCallerEndpointCheck_at_StairSideA

/-!
# Caller-domain support of the two loaned boundary endpoints (LT11)

Kernel checks (`allCaller`, `decide +kernel`, as LT1/LT8 check these programs'
counts and avoidance) of the CANON v3 division endpoint
`CompareDecoder.BoundaryLoan.endPacket760DivLoan` (`bestLoans.divEndpoint`) and
of the multiplication endpoint in the `bestLoans.endPacket false 68` slot, which
since Entrant_1806 is LT19's 44-site loan `StairEndpointLoan44.endPacket760Loan44
false` (LT6 adaptation of LT11's 68-loan check).
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## LT44: completeness of the checker (so a structural support proof yields the check) -/

private theorem corrCaller_complete (cs : List Correction)
    (h : correctionWires cs ⊆ callerDomain) : corrCaller cs = true := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    cases c with
    | Z t =>
      simp only [corrCaller, Bool.and_eq_true]
      refine ⟨callerNat_complete t (h ?_), ih (fun q hq => h ?_)⟩
      · simp [correctionWires]
      · simp [correctionWires, hq]
    | CZ a b =>
      simp only [corrCaller, Bool.and_eq_true]
      refine ⟨⟨callerNat_complete a (h ?_), callerNat_complete b (h ?_)⟩,
        ih (fun q hq => h ?_)⟩
      · simp [correctionWires]
      · simp [correctionWires]
      · simp [correctionWires, hq]

private theorem instrCaller_complete (i : Instr) (h : i.wires ⊆ callerDomain) :
    instrCaller i = true := by
  cases i with
  | X t => exact callerNat_complete t (h (by simp [Instr.wires]))
  | CX c t =>
    simp only [instrCaller, Bool.and_eq_true]
    exact ⟨callerNat_complete c (h (by simp [Instr.wires])),
      callerNat_complete t (h (by simp [Instr.wires]))⟩
  | CCX a b t =>
    simp only [instrCaller, Bool.and_eq_true]
    exact ⟨⟨callerNat_complete a (h (by simp [Instr.wires])),
      callerNat_complete b (h (by simp [Instr.wires]))⟩,
      callerNat_complete t (h (by simp [Instr.wires]))⟩
  | measureX t c₀ c₁ =>
    simp only [instrCaller, Bool.and_eq_true]
    exact ⟨⟨callerNat_complete t (h (by simp [Instr.wires])),
      corrCaller_complete c₀ (fun q hq => h (by simp [Instr.wires, hq]))⟩,
      corrCaller_complete c₁ (fun q hq => h (by simp [Instr.wires, hq]))⟩

/-- Completeness: a program supported in the caller domain passes the check. -/
theorem allCaller_complete (P : Program) (h : wires P ⊆ callerDomain) : allCaller P = true := by
  induction P with
  | nil => rfl
  | cons i p ih =>
    simp only [allCaller, Bool.and_eq_true]
    exact ⟨instrCaller_complete i (fun q hq => h (by simp [wires, hq])),
      ih (fun q hq => h (by simp [wires, hq]))⟩

/-- LT45 (replay budget): no kernel evaluation of the division endpoint (30 s → < 1 s).  The
loaned division endpoint only touches wires of the record endpoint
(`Inclusion.endPacket760DivLoan_sub`, structural), which is caller-supported
(`endPacket760_own`); `allCaller` is complete. -/
theorem divLoanEndpoint_check :
    allCaller CompareDecoder.BoundaryLoan.endPacket760DivLoan = true :=
  allCaller_complete _
    (CompareDecoder.BoundaryLoan.Inclusion.endPacket760DivLoan_sub.trans (endPacket760_own true))

/-- LT44 (replay budget): no kernel evaluation of the endpoint (87 s → < 1 s).  The 44-site
endpoint only touches wires of the record endpoint (`endPacket760Loan44_support`), which is
caller-supported (`endPacket760_own`); `allCaller` is complete. -/
theorem multLoanEndpoint_check :
    allCaller (StairEndpointLoan44.endPacket760Loan44 false) = true :=
  allCaller_complete _
    (StairEndpointLoan44.endPacket760Loan44_support.trans (endPacket760_own false))

/-- The v3 division endpoint (`bestLoans.divEndpoint`). -/
theorem divEndpointV3_own : wires StairConcrete.bestLoans.divEndpoint ⊆ callerDomain :=
  allCaller_sound _ divLoanEndpoint_check

/-- The `bestLoans` multiplication endpoint at deficit 68. -/
theorem multEndpointV3_own :
    wires (StairConcrete.bestLoans.endPacket false 68) ⊆ callerDomain := by
  have e : StairConcrete.endPacket false 68 = StairEndpointLoan44.endPacket760Loan44 false := by
    unfold StairConcrete.endPacket
    rw [if_neg (show ¬(false = true) by decide), if_pos (show (68 : Nat) = 68 from rfl)]
  show wires (StairConcrete.endPacket false 68) ⊆ callerDomain
  rw [e]
  exact allCaller_sound _ multLoanEndpoint_check

end ECDSAAdd.Entrant.StairSemanticFinal

end
end Merge_StairCallerEndpointCheck_at_StairSideA

