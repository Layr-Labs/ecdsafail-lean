/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSlotsLedger_at_StairSideA` -/
section Merge_StairSlotsLedger_at_StairSideA

/-!
# Plan-parametric gate-slot ledger (field 11)

A `Plan` is a checkpoint table `rows = [(letter, budget)]` and the loaned
packet-group runs `groups = [(deficit, first, count)]` of one half.  `Costs`
are the per-budget checkpoint slot costs (pack + unpack including sign
extension and rest relocation, orientation), the first-row b-rail move and
return, terminal-block deltas and the per-role per-packet loan slot cost;
`Boundary` holds the four boundary loan deltas.  `Plan.slotDelta` is the total
overhead of both kernels over the record program.  Pure arithmetic: no program
is mentioned here.
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairSlotsPlan

/-! ## 1. The abstract ledger -/

/-- A checkpoint table: rows `(letter, budget)` and loaned group runs
`(deficit, first, count)` of one half. -/
structure Plan where
  rows : List (Nat × Nat)
  groups : List (Nat × Nat × Nat)
  /-- LT47 (defect-2 fix): slots of the extra `unprefix ++ clearProgram` per kernel. -/
  window : Nat := 0

/-- Plan-dependent checkpoint and loan slot costs. -/
structure Costs where
  /-- `gateSlots (pack B) + gateSlots (unpack B)` of the concrete codec,
  including sign extension and rest relocation. -/
  codecPair : Nat → Nat
  /-- Slots of the orientation at a row of budget `B`. -/
  orient : Nat → Nat
  /-- Extra slots of the first-row pack beyond orientation, packet write and
  `pack` (division forward pass: b-rail move). -/
  firstMove : Nat
  /-- Extra slots of the first-row unpack (multiplication: b-rail return). -/
  firstReturn : Nat
  /-- Terminal division block over the record terminal blocks. -/
  forwardTerminal : Nat
  /-- Terminal multiplication block over the record terminal blocks. -/
  reverseTerminal : Nat
  /-- Slots per loaned role per packet (`14 * 20` for the generic loan). -/
  groupRole : Nat

/-- Boundary loan deltas over the record boundary programs. -/
structure Boundary where
  divEnd : Nat
  canon : Nat
  multEnd : Nat
  center : Nat

def Plan.checkpointSlots (P : Plan) (c : Costs) : Nat :=
  (P.rows.map fun r => c.codecPair r.2 + c.orient r.2).sum

def Plan.loanUnits (P : Plan) : Nat :=
  (P.groups.map fun g => g.1 * g.2.2).sum

def Plan.entryDelta (P : Plan) (c : Costs) (b : Boundary) : Nat :=
  P.checkpointSlots c + c.firstMove + c.forwardTerminal +
    c.groupRole * P.loanUnits + b.divEnd + b.canon + P.window

def Plan.exitDelta (P : Plan) (c : Costs) (b : Boundary) : Nat :=
  P.checkpointSlots c + c.firstReturn + c.reverseTerminal +
    c.groupRole * P.loanUnits + b.multEnd + b.center + P.window


/-- Total slot overhead of both kernels over the record program. -/
def Plan.slotDelta (P : Plan) (c : Costs) (b : Boundary) : Nat :=
  P.entryDelta c b + P.exitDelta c b


/-! ### The k = 44 re-plan (coordinator 15:40, PK2 exact point `p1 = 17`) -/

def v3Plan : Plan where
  rows := [(425, 87), (450, 62), (465, 47), (480, 32), (490, 22), (500, 12)]
  groups := [(0, 1, 84), (13, 85, 5), (22, 90, 3), (30, 93, 3), (36, 96, 2),
    (41, 98, 2), (43, 100, 2)]
  window := 767

theorem v3Plan_loanUnits : v3Plan.loanUnits = 461 := by decide

/-- Exact checkpoint slot costs on LT13's `physicalLayout`: generated-codec
pack+unpack totals (`5410, 3656, 2725, 1757, 1173, 582`) plus two sign
extensions and `4 * (B - 1)` relocation CX gates (proved in `StairSlotsV3`). -/
def v3CodecPair (B : Nat) : Nat :=
  if B = 87 then 5744 else if B = 62 then 3907 else if B = 47 then 2908
  else if B = 32 then 1886 else if B = 22 then 1257 else if B = 12 then 628
  else 0

/-- CANON v3 costs: repaired `B + 1`-bit orientation (`3 (B + 1)` slots),
88-move b-rail relocation in both first-row phases, terminal blocks renamed
only, generic 14-slot loans for 20 roles per packet. -/
def v3Costs : Costs where
  codecPair := v3CodecPair
  orient := fun B => 3 * (B + 1)
  firstMove := 176
  firstReturn := 176
  forwardTerminal := 0
  reverseTerminal := 0
  groupRole := 280










/-- LT6 (Entrant_1806+): the multiplication-endpoint slot holds LT19's 44-site
loan `StairEndpointLoan44.endPacket760Loan44 false` (three 44-deep loans), bounded
loosely by `+30,000` (kernel evaluation, `mult44_slots_le`). -/
def v3Boundary1806 : Boundary where
  divEnd := 10000
  canon := 430
  multEnd := 30000
  center := 430

theorem v3_slotDelta_1806 : v3Plan.slotDelta v3Costs v3Boundary1806 = 335174 := by
  decide

/-! ### Cross-check: the superseded eight-row plan reproduces 639,954 -/






end ECDSAAdd.Entrant.StairSlotsPlan

end
