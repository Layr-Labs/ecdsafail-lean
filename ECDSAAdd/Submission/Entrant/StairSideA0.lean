  divEndpoint : Program := R2SqEp760.endPacket760 true

/-- The current programs instantiate the schedule shape while ignoring the new
loan count.  This is useful for checking wrapper placement independently. -/
def recordLoans : StairLoans where
  groups := fun divide _ first count => Rolling1588.groups divide first count
  endPacket := fun divide _ => R2SqEp760.endPacket760 divide



/-- v3: the 44 genuinely omittable roles (LT13 `exclusiveSites`):
`base 720 .. 759, 761 .. 764`, i.e. `retiredRoles.drop 24`. -/
def exclusiveRoleIndices : List Nat := (List.range' 720 45).filter (fun i => i != 760)

def exclusiveRoles : List Wire := exclusiveRoleIndices.map base


def placedGroups (loans : StairLoans) (divide : Bool) (deficit first count : Nat) : Program :=
  renameProgram (OB5.sig 511) (loans.groups divide deficit first count)

def placedEndPacket (loans : StairLoans) (divide : Bool) (deficit : Nat) : Program :=
  renameProgram (OB5.sig 511) (loans.endPacket divide deficit)






