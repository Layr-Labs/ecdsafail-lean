  cases b <;> simp [literalConstStep, literalConstSum, literalConstCarry, tgt]

theorem k4t_erase_tgt (b : Bool) (x cin c one : Wire) :
    ∀ i ∈ literalConstErase b x cin c one, tgt i = c ∨ tgt i = one := by
  cases b <;> simp [literalConstErase, tgt]

