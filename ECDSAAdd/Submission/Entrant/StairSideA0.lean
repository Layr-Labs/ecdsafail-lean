/-! ### merged from `ECDSAAdd.Submission.Entrant.StairRename_at_QTop` -/
section Merge_StairRename_at_QTop

/-!
Exact coordinate transport for the four record rename layers.

The record frames are stated in pulled coordinates; the permutations are not
all fixed on a field state.  In particular the host and prefix layers depend
on their surrounding X/setup and clear/unprefix programs.  This module keeps
the bare rename statement exact instead of assuming those wrappers away.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairRename

open ECDSAAdd

theorem rename_run_conjugate (f : Wire → Wire)
    (injective : Function.Injective f) (invol : ∀ q, f (f q) = q)
    (P : Program) (s : State) (m : List Bool) :
    run (renameProgram f P) m s =
      pullState f (run P m (pullState f s)) := by
  have renamed := ECDSAAdd.run_rename f injective P m s
  have lifted := congrArg (pullState f) renamed
  rw [StairReplay.pullState_involutive f invol] at lifted
  exact lifted






end ECDSAAdd.Entrant.StairRename
end Merge_StairRename_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanRecordShape_at_QTop` -/
section Merge_StairLoanRecordShape_at_QTop

/-!
# Loan replay on the record's own field frames (placement independent)

Field 7 compares the staircase kernel with `bestLoans` against the same kernel
with `recordLoans`.  Under the commutation plan for field 2 both staircase
kernels are related to a *record-shaped* kernel whose 101 packet groups are
cut into the nine staircase slices, each slice and the endpoint taken from
the loan provider.  This module proves the loan-side replay at the record's
logical field boundary, where the record's own cut frames are available:

* `forward_slices_run_eq` / `backward_slices_run_eq`: a chain of loaned slices
  equals the chain of record slices on any cut frame (independent tapes), by
  `StairLoanReplay.groups_run_eq` and the record's `groups_cut_frame`;
* `forward_slices_record` / `backward_slices_record`: the record-loan slices
  are literally `Rolling1588.groups true/false 1 101`;
* `entryLogical_run_eq`: the loaned division field tail (nine slices and the
  loaned endpoint) equals the record's `groups true 1 101 ++ endPacket760
  true` on the record's own input frame (same premises as the record's
  `logical_entry_tail_frame`);
* `exitLogical_run_eq`: the multiplication analogue (premises of
  `logical_exit_head_frame`).

No staircase checkpoint, placement or host plan is involved.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordShape

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

abbrev HalfReplayHypothesis := StairLoanReplay.HalfReplayHypothesis

/-! ## The staircase slices -/

/-- Division slices `(deficit, first packet, count)` in schedule order (v3, k = 44). -/
def entrySliceList : List (Nat × Nat × Nat) :=
  [(0, 1, 84), (13, 85, 5), (22, 90, 3), (30, 93, 3), (36, 96, 2),
   (41, 98, 2), (43, 100, 2)]


def slices (loans : StairSchedule.StairLoans) (divide : Bool) :
    List (Nat × Nat × Nat) → Program
  | [] => []
  | (d, j, n) :: rest => loans.groups divide d j n ++ slices loans divide rest

def sliceCount : List (Nat × Nat × Nat) → Nat
  | [] => 0
  | (_, _, n) :: rest => n + sliceCount rest

/-- Division slices advance the cut upward from `c`. -/
def ForwardChain : Nat → List (Nat × Nat × Nat) → Prop
  | _, [] => True
  | c, (d, j, n) :: rest =>
      j = c ∧ d ≤ 68 ∧ 1 ≤ j ∧ j + n ≤ 102 ∧ ForwardChain (j + n) rest

/-- Multiplication slices move the cut downward from `c` to `low`. -/
def BackwardChain : Nat → Nat → List (Nat × Nat × Nat) → Prop
  | c, low, [] => c = low
  | c, low, (d, j, n) :: rest =>
      j + n = c ∧ d ≤ 68 ∧ 1 ≤ j ∧ j + n ≤ 102 ∧ BackwardChain j low rest

theorem entrySliceList_chain : ForwardChain 1 entrySliceList := by
  simp [ForwardChain, entrySliceList]


theorem entrySliceList_count : sliceCount entrySliceList = 101 := by
  simp [sliceCount, entrySliceList]


/-! ## Splitting the record packet sequence -/

theorem program_true_add (p : Nat → Program) :
    ∀ (a b j : Nat),
      PacketSequence.program true p j (a + b) =
        PacketSequence.program true p j a ++
          PacketSequence.program true p (j + a) b
  | 0, b, j => by simp [PacketSequence.program]
  | a + 1, b, j => by
      have h : a + 1 + b = (a + b) + 1 := by omega
      rw [h]
      simp only [PacketSequence.program, if_true, List.append_assoc]
      rw [program_true_add p a b (j + 1)]
      have hj : j + 1 + a = j + (a + 1) := by omega
      rw [hj]

theorem program_false_add (p : Nat → Program) :
    ∀ (a b j : Nat),
      PacketSequence.program false p j (a + b) =
        PacketSequence.program false p (j + a) b ++
          PacketSequence.program false p j a
  | 0, b, j => by simp [PacketSequence.program]
  | a + 1, b, j => by
      have h : a + 1 + b = (a + b) + 1 := by omega
      rw [h]
      simp only [PacketSequence.program, Bool.false_eq_true, if_false,
        List.append_assoc]
      rw [program_false_add p a b (j + 1)]
      have hj : j + 1 + a = j + (a + 1) := by omega
      rw [hj, List.append_assoc]

theorem forward_slices_record :
    ∀ (L : List (Nat × Nat × Nat)) (c : Nat), ForwardChain c L →
      slices StairSchedule.recordLoans true L =
        Rolling1588.groups true c (sliceCount L)
  | [], c, _ => by
      simp [slices, sliceCount, Rolling1588.groups, PacketSequence.program]
  | (d, j, n) :: rest, c, chain => by
      obtain ⟨hj, _, _, _, hr⟩ := chain
      subst hj
      have ih := forward_slices_record rest (j + n) hr
      change Rolling1588.groups true j n ++
          slices StairSchedule.recordLoans true rest =
        Rolling1588.groups true j (n + sliceCount rest)
      rw [ih]
      simp only [Rolling1588.groups]
      rw [program_true_add]

theorem backward_chain_low :
    ∀ (L : List (Nat × Nat × Nat)) (c low : Nat), BackwardChain c low L →
      low ≤ c
  | [], c, low, chain => by
      simp only [BackwardChain] at chain
      omega
  | (d, j, n) :: rest, c, low, chain => by
      obtain ⟨hc, _, _, _, hr⟩ := chain
      have := backward_chain_low rest j low hr
      omega

theorem backward_slices_record :
    ∀ (L : List (Nat × Nat × Nat)) (low k : Nat),
      BackwardChain (low + k) low L →
      slices StairSchedule.recordLoans false L =
        Rolling1588.groups false low k
  | [], low, k, chain => by
      simp only [BackwardChain] at chain
      have hk : k = 0 := by omega
      subst hk
      simp [slices, Rolling1588.groups, PacketSequence.program]
  | (d, j, n) :: rest, low, k, chain => by
      obtain ⟨hc, _, _, _, hr⟩ := chain
      have hlow := backward_chain_low rest j low hr
      obtain ⟨k', hk'⟩ : ∃ k', j = low + k' := ⟨j - low, by omega⟩
      subst hk'
      have ih := backward_slices_record rest low k' hr
      have hk : k = k' + n := by omega
      subst hk
      change Rolling1588.groups false (low + k') n ++
          slices StairSchedule.recordLoans false rest =
        Rolling1588.groups false low (k' + n)
      rw [ih]
      simp only [Rolling1588.groups]
      rw [program_false_add]

theorem entrySlices_record :
    slices StairSchedule.recordLoans true entrySliceList =
      Rolling1588.groups true 1 101 := by
  rw [forward_slices_record entrySliceList 1 entrySliceList_chain,
    entrySliceList_count]


/-! ## Loaned slices equal record slices on cut frames -/

theorem forward_slices_run_eq (half : HalfReplayHypothesis) :
    ∀ (L : List (Nat × Nat × Nat)) (c : Nat), ForwardChain c L →
    ∀ (origin : BasisState), FrontierReplay1591.Context origin →
    origin (base 2400) = true → ∀ (X Y : Fp) (s : State),
    Rolling1588.CutFrame c origin X Y s → ∀ (fresh old : List Bool),
    run (slices StairConcrete.bestLoans true L) fresh s =
      run (slices StairSchedule.recordLoans true L) old s
  | [], _, _, _, _, _, _, _, _, _, _, _ => rfl
  | (d, j, n) :: rest, c, chain, origin, ctx, enabled, X, Y, s, input,
      fresh, old => by
      obtain ⟨hj, hd, first, bound, hr⟩ := chain
      subst hj
      simp only [slices, run_append]
      have e : run (StairConcrete.bestLoans.groups true d j n)
          (fresh.take (measurementCount
            (StairConcrete.bestLoans.groups true d j n))) s =
        run (StairSchedule.recordLoans.groups true d j n)
          (old.take (measurementCount
            (StairSchedule.recordLoans.groups true d j n))) s :=
        StairLoanReplay.groups_run_eq half true d j n hd first bound origin ctx
          enabled X Y s _ _ input
      rw [e]
      have post := (Rolling1588.groups_cut_frame true j n first bound origin
        ctx enabled X Y s (old.take (measurementCount
          (StairSchedule.recordLoans.groups true d j n))) input).2
      exact forward_slices_run_eq half rest (j + n) hr origin ctx enabled _ _
        _ post _ _

theorem backward_slices_run_eq (half : HalfReplayHypothesis) :
    ∀ (L : List (Nat × Nat × Nat)) (c low : Nat), BackwardChain c low L →
    ∀ (origin : BasisState), FrontierReplay1591.Context origin →
    origin (base 2400) = true → ∀ (X Y : Fp) (s : State),
    Rolling1588.CutFrame c origin X Y s → ∀ (fresh old : List Bool),
    run (slices StairConcrete.bestLoans false L) fresh s =
      run (slices StairSchedule.recordLoans false L) old s
  | [], _, _, _, _, _, _, _, _, _, _, _, _ => rfl
  | (d, j, n) :: rest, c, low, chain, origin, ctx, enabled, X, Y, s, input,
      fresh, old => by
      obtain ⟨hc, hd, first, bound, hr⟩ := chain
      subst hc
      simp only [slices, run_append]
      have e : run (StairConcrete.bestLoans.groups false d j n)
          (fresh.take (measurementCount
            (StairConcrete.bestLoans.groups false d j n))) s =
        run (StairSchedule.recordLoans.groups false d j n)
          (old.take (measurementCount
            (StairSchedule.recordLoans.groups false d j n))) s :=
        StairLoanReplay.groups_run_eq half false d j n hd first bound origin
          ctx enabled X Y s _ _ input
      rw [e]
      have post := (Rolling1588.groups_cut_frame false j n first bound origin
        ctx enabled X Y s (old.take (measurementCount
          (StairSchedule.recordLoans.groups false d j n))) input).2
      exact backward_slices_run_eq half rest j low hr origin ctx enabled _ _
        _ post _ _

/-! ## The logical field boundaries -/



/-! ## Generic congruence for sequential compositions

Programs are variables here, so no concrete program is unfolded. -/

theorem run_eq_of_phase (P : Program) (s : State) (m m' : List Bool)
    (h : (run P m s).phase = s.phase) (h' : (run P m' s).phase = s.phase) :
    run P m s = run P m' s :=
  State.extensionality _ _ (h.trans h'.symm) (run_basis_records P s s m m' rfl)

/-- Replace the head of `A ++ T`: heads agree on `s` for independent tapes and
the common tail is tape-free on every reached state. -/
theorem head_replace (A A' T : Program) (s : State)
    (head : ∀ a b, run A' a s = run A b s)
    (tail : ∀ b a c, run T a (run A b s) = run T c (run A b s))
    (fresh old : List Bool) :
    run (A' ++ T) fresh s = run (A ++ T) old s := by
  rw [run_append, run_append,
    head (fresh.take (measurementCount A')) (old.take (measurementCount A))]
  exact tail _ _ _

/-- Replace both parts of `A ++ T`: heads agree on `s` for independent tapes and
the tails agree on every reached state for independent tapes. -/
theorem both_replace (A A' T T' : Program) (s : State)
    (head : ∀ a b, run A' a s = run A b s)
    (tail : ∀ b a c, run T' a (run A b s) = run T c (run A b s))
    (fresh old : List Bool) :
    run (A' ++ T') fresh s = run (A ++ T) old s := by
  rw [run_append, run_append,
    head (fresh.take (measurementCount A')) (old.take (measurementCount A))]
  exact tail _ _ _


/-! ## Level 1: the placed division tail `Rolling1588.entryTail` -/



/-- The record-shaped division tail with the slices, endpoint and (v3)
canonicaliser from `loans`. -/
