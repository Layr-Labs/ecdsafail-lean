/-! ## Definitions -/

/-- The relocated upper sweep `U` of `emitLoan 44 _ tailL top760`. -/
def upperSweep760 : Program := StairLoan.emitSweep (tailL.drop 45) top760


/-- Wires `upperSame` speaks about (mapped bits are literals, no wires). -/
def sameWires : List Wire :=
  ((xs ++ [cin]).drop 11).take 44 ++ (cs.drop 11).take 44 ++ [cs.getD 10 0]

/-- Everything before the tail layers of the window. -/
def windowPre760 : Program :=
  frontFast fixedLayout ++ upper fixedLayout ++ DirectDecoder.highBlock fixedLayout ++
    DirectDecoder.middle fixedLayout ++ [.X cin] ++ notRegister xs ++ StairLoan.emitUps headL

/-- The unloaned rearranged decoder (`cellDecoderLoan` with `window760 0`). -/
def cellDecoderSweep : Program :=
  frontFast fixedLayout ++ upper fixedLayout ++ DirectDecoder.highBlock fixedLayout ++
    DirectDecoder.middle fixedLayout ++ [.X cin] ++ window760 0 ++
    [.X fixedLayout.sigma, .X cin] ++ restoreSource fixedLayout ++ copySource fixedLayout

def restUpper760 : Program :=
  StairLoan.emitDowns (tailL.take 45) ++ StairLoan.emitDowns headL ++ notRegister xs ++
    [.X fixedLayout.sigma, .X cin] ++ restoreSource fixedLayout ++ copySource fixedLayout

def restWindow760 : Program :=
  StairLoan.emitDowns headL ++ notRegister xs ++
    [.X fixedLayout.sigma, .X cin] ++ restoreSource fixedLayout ++ copySource fixedLayout

/-! ## (a) static: the hosts are never touched -/






/-! ## (b) the tail's low inputs, the tail carry-in, and the retired roles -/


theorem k5_hit_append (P Q : Program) : k1hitMask (P ++ Q) = k1hitMask P ||| k1hitMask Q := by
  induction P with
  | nil => simp [k1hitMask]
  | cons i P ih => simp only [List.cons_append, k1hitMask, ih, Nat.lor_assoc]

theorem k5_x_append (P Q : Program) : k1xMask (P ++ Q) = k1xMask P ^^^ k1xMask Q := by
  induction P with
  | nil => simp [k1xMask]
  | cons i P ih => simp only [List.cons_append, k1xMask, ih, Nat.xor_assoc]

theorem k5_hit_downs (ls : List StairLoan.CarryLayer) :
    k1hitMask (StairLoan.emitDowns ls) = (ls.map (fun l => k1hitMask l.down)).foldr (· ||| ·) 0 :=
  k5_downs_fold ls _ _ 0 k5_hit_append rfl Nat.lor_comm

theorem k5_x_downs (ls : List StairLoan.CarryLayer) :
    k1xMask (StairLoan.emitDowns ls) = (ls.map (fun l => k1xMask l.down)).foldr (· ^^^ ·) 0 :=
  k5_downs_fold ls _ _ 0 k5_x_append rfl Nat.xor_comm

theorem upper_same_check :
    sameWires.all (fun q =>
      upperSweep760.all (fun i => !hitsNonX q i) && !xParity q upperSweep760) = true := by
  -- K1 (replay budget): one hit mask and one X-parity mask per program, not one pass per wire.
  -- K5: the down-pass folded per layer (it is a left-nested append).
  simp only [k1_all_hits, k1_xParity, upperSweep760, StairLoan.emitSweep, k5_hit_append,
    k5_x_append, k5_hit_downs, k5_x_downs]
  decide +kernel

/-- K5: `endsCleared` of a concatenation. -/
theorem k5_endsCleared_append (q : Wire) (A B : Program) :
    endsCleared q (A ++ B) = (endsCleared q B || (endsCleared q A && untouched q B)) := by
  have ua : ∀ A' : Program, untouched q (A' ++ B) = (untouched q A' && untouched q B) := by
    intro A'
    simp only [untouched, List.all_append]
  induction A with
  | nil => simp [endsCleared]
  | cons i A ih =>
      simp only [List.cons_append, endsCleared, ih, ua]
      cases endsCleared q B <;> cases endsCleared q A <;> cases isMeasureOn q i <;>
        cases untouched q A <;> cases untouched q B <;> rfl

/-- K5: measurement targets, as one bit mask. -/
def k5mBit : Instr → Nat
  | .measureX t _ _ => 2 ^ t
  | _ => 0

/-- K5: targets of the other instructions, as one bit mask. -/
def k5wBit : Instr → Nat
  | .X t => 2 ^ t
  | .CX _ t => 2 ^ t
  | .CCX _ _ t => 2 ^ t
  | .measureX _ _ _ => 0

def k5mMask : Program → Nat
  | [] => 0
  | i :: P => k5mBit i ||| k5mMask P

def k5wMask : Program → Nat
  | [] => 0
  | i :: P => k5wBit i ||| k5wMask P

theorem k5_untouched_of_masks (q : Wire) : ∀ P : Program,
    (k5wMask P).testBit q = false → (k5mMask P).testBit q = false → untouched q P = true
  | [], _, _ => rfl
  | i :: P, hw, hm => by
      simp only [k5wMask, k5mMask, Nat.testBit_or, Bool.or_eq_false_iff] at hw hm
      simp only [untouched, List.all_cons, Bool.and_eq_true]
      refine ⟨?_, k5_untouched_of_masks q P hw.2 hm.2⟩
      cases i with
      | measureX t c₀ c₁ =>
          have h := hm.1
          simp only [k5mBit, Nat.testBit_two_pow] at h
          have ne : t ≠ q := fun e => by simp [e] at h
          simp [target, ne]
      | X t =>
          have h := hw.1
          simp only [k5wBit, Nat.testBit_two_pow] at h
          have ne : t ≠ q := fun e => by simp [e] at h
          simp [target, ne]
      | CX c t =>
          have h := hw.1
          simp only [k5wBit, Nat.testBit_two_pow] at h
          have ne : t ≠ q := fun e => by simp [e] at h
          simp [target, ne]
      | CCX a b t =>
          have h := hw.1
          simp only [k5wBit, Nat.testBit_two_pow] at h
          have ne : t ≠ q := fun e => by simp [e] at h
          simp [target, ne]

/-- K5: a wire that only measurements target, and some measurement does, ends cleared. -/
theorem k5_endsCleared_of_masks (q : Wire) : ∀ P : Program,
    (k5wMask P).testBit q = false → (k5mMask P).testBit q = true → endsCleared q P = true
  | [], _, hm => by simp [k5mMask] at hm
  | i :: P, hw, hm => by
      simp only [k5wMask, Nat.testBit_or, Bool.or_eq_false_iff] at hw
      simp only [k5mMask, Nat.testBit_or] at hm
      simp only [endsCleared, Bool.or_eq_true, Bool.and_eq_true]
      cases hP : (k5mMask P).testBit q with
      | true => exact Or.inl (k5_endsCleared_of_masks q P hw.2 hP)
      | false =>
          rw [hP, Bool.or_false] at hm
          refine Or.inr ⟨?_, k5_untouched_of_masks q P hw.2 hP⟩
          cases i with
          | measureX t c₀ c₁ =>
              simp only [k5mBit, Nat.testBit_two_pow, decide_eq_true_eq] at hm
              simp [isMeasureOn, hm]
          | X t => simp [k5mBit] at hm
          | CX c t => simp [k5mBit] at hm
          | CCX a b t => simp [k5mBit] at hm

/-- K5 (replay budget): the roles are cleared by the down-pass alone (only measurements target
them there): two operand masks of the down-pass instead of 44 scans of the sweep. -/
theorem k5_w_append (P Q : Program) : k5wMask (P ++ Q) = k5wMask P ||| k5wMask Q := by
  induction P with
  | nil => simp [k5wMask]
  | cons i P ih => simp only [List.cons_append, k5wMask, ih, Nat.lor_assoc]

theorem k5_m_append (P Q : Program) : k5mMask (P ++ Q) = k5mMask P ||| k5mMask Q := by
  induction P with
  | nil => simp [k5mMask]
  | cons i P ih => simp only [List.cons_append, k5mMask, ih, Nat.lor_assoc]

theorem k5_downs_roles_masks : StairBoundaryLoan.exclusiveHoles.all (fun q =>
    !(k5wMask (StairLoan.emitDowns (tailL.drop 45))).testBit q &&
      (k5mMask (StairLoan.emitDowns (tailL.drop 45))).testBit q) = true := by
  simp only [k5_downs_fold _ k5wMask _ 0 k5_w_append rfl Nat.lor_comm,
    k5_downs_fold _ k5mMask _ 0 k5_m_append rfl Nat.lor_comm]
  decide +kernel

theorem k5_downs_roles_check : StairBoundaryLoan.exclusiveHoles.all
    (fun q => endsCleared q (StairLoan.emitDowns (tailL.drop 45))) = true := by
  rw [List.all_eq_true]
  intro q hq
  have h := List.all_eq_true.mp k5_downs_roles_masks q hq
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at h
  exact k5_endsCleared_of_masks q _ h.1 h.2

theorem k5_upperSweep760_eq :
    upperSweep760 = StairLoan.emitUps (tailL.drop 45) ++ top760 ++ StairLoan.emitDowns (tailL.drop 45) :=
  rfl

theorem upper_roles_check :
    StairBoundaryLoan.exclusiveHoles.all (fun q => endsCleared q upperSweep760) = true := by
  rw [List.all_eq_true]
  intro q hq
  rw [k5_upperSweep760_eq, k5_endsCleared_append, List.all_eq_true.mp k5_downs_roles_check q hq,
    Bool.true_or]

theorem preserved_of_check (P : Program) (q : Wire)
    (h : (P.all (fun i => !hitsNonX q i) && !xParity q P) = true) (s : State) (m : List Bool) :
    (run P m s).basis q = s.basis q := by
  simp only [Bool.and_eq_true, Bool.not_eq_true'] at h
  rw [run_basis_xOnly q P m s h.1, h.2]
  cases s.basis q <;> rfl


/-- (b) in the exact `upperSame` shape, for every state and record. -/
theorem k5_upperSweep760_def : StairLoan.emitSweep (tailL.drop 45) top760 = upperSweep760 := rfl

theorem upper_same_all (s : State) (m : List Bool) :
    ∀ q ∈ ((xs ++ [cin]).drop 11).take 44 ++ (cs.drop 11).take 44 ++ [cs.getD 10 0],
      (run (StairLoan.emitSweep (tailL.drop 45) top760) m s).basis q = s.basis q := by
  -- K5 (replay budget): rewrite to `upperSweep760` first (no kernel unfolding of `run`).
  rw [k5_upperSweep760_def]
  intro q hq
  exact preserved_of_check upperSweep760 q (List.all_eq_true.mp upper_same_check q hq) s m

/-- (b') every retired role ends at `false` after the upper sweep, for every state/record. -/
theorem upper_roles_zero_all (s : State) (m : List Bool) :
    ∀ q ∈ StairBoundaryLoan.exclusiveHoles,
      (run (StairLoan.emitSweep (tailL.drop 45) top760) m s).basis q = false := by
  rw [k5_upperSweep760_def]
  intro q hq
  exact run_basis_endsCleared q upperSweep760 m s (List.all_eq_true.mp upper_roles_check q hq)

/-! ## (c) record independence -/

theorem cellDecoderNext_tapeFree (Y : Fp) (sigma : Bool) (s : State)
    (ys : regValue fixedLayout.y s.basis=centerWord Y)
    (rs : regValue fixedLayout.r s.basis=centerWord ((if sigma then 1 else 3)*Y))
    (sig : s.basis fixedLayout.sigma=sigma)
    (hc : s.basis fixedLayout.h=false) (bc : s.basis fixedLayout.bias=false)
    (cc : ∀q∈fixedLayout.carry,s.basis q=false) (m n : List Bool) :
    run cellDecoderNext m s = run cellDecoderNext n s :=
  tapeFree_of_phase cellDecoderNext s
    (fun m => (cellDecoderNext_correct Y sigma s m ys rs sig hc bc cc).1) m n

/-- Convenience: LT8's part 1 (in this form) gives record independence of the unloaned form. -/
theorem sweepFree_of_part1 (Y : Fp) (sigma : Bool) (s : State)
    (ys : regValue fixedLayout.y s.basis=centerWord Y)
    (rs : regValue fixedLayout.r s.basis=centerWord ((if sigma then 1 else 3)*Y))
    (sig : s.basis fixedLayout.sigma=sigma)
    (hc : s.basis fixedLayout.h=false) (bc : s.basis fixedLayout.bias=false)
    (cc : ∀q∈fixedLayout.carry,s.basis q=false)
    (part1 : ∀ m n, run cellDecoderSweep m s = run cellDecoderNext n s) :
    ∀ m n, run cellDecoderSweep m s = run cellDecoderSweep n s := by
  intro m n
  exact (part1 m m).trans
    ((cellDecoderNext_tapeFree Y sigma s ys rs sig hc bc cc m n).trans (part1 n n).symm)

theorem sweep_shape_upper : cellDecoderSweep =
    (windowPre760 ++ StairLoan.emitUps (tailL.take 45)) ++ (upperSweep760 ++ restUpper760) := by
  unfold cellDecoderSweep window760 windowPre760 upperSweep760 restUpper760
  rw [StairLoan.emitLoan_zero, StairLoan.emitSweep_split 45 tailL top760]
  simp only [List.append_assoc]

theorem sweep_shape_window : cellDecoderSweep =
    windowPre760 ++ (StairLoan.emitSweep tailL top760 ++ restWindow760) := by
  unfold cellDecoderSweep window760 windowPre760 restWindow760
  rw [StairLoan.emitLoan_zero]
  simp only [List.append_assoc]

theorem tailUps45_zero : measurementCount (StairLoan.emitUps (tailL.take 45)) = 0 := by
  decide +kernel

theorem run_pre_upper (s : State) (m : List Bool) :
    run (windowPre760 ++ StairLoan.emitUps (tailL.take 45)) m s =
      run (StairLoan.emitUps (tailL.take 45)) [] (run windowPre760 m s) := by
  rw [run_append, run_take, FifthCarry.no_records _ tailUps45_zero _ _ []]

/-- (c) The upper sweep is record-independent at the state `u` of the loan lemma. -/
theorem upper_tapeFree (s : State) (m : List Bool)
    (sweepFree : ∀ m n, run cellDecoderSweep m s = run cellDecoderSweep n s) :
    ∀ rec, run (StairLoan.emitSweep (tailL.drop 45) top760) rec
        (run (StairLoan.emitUps (tailL.take 45)) [] (run windowPre760 m s)) =
      run (StairLoan.emitSweep (tailL.drop 45) top760) []
        (run (StairLoan.emitUps (tailL.take 45)) [] (run windowPre760 m s)) := by
  intro rec
  have whole : ∀ a b,
      run ((windowPre760 ++ StairLoan.emitUps (tailL.take 45)) ++ (upperSweep760 ++ restUpper760)) a s =
      run ((windowPre760 ++ StairLoan.emitUps (tailL.take 45)) ++ (upperSweep760 ++ restUpper760)) b s := by
    rw [← sweep_shape_upper]
    exact sweepFree
  have h := tapeFree_middle _ _ _ s whole m rec []
  rw [run_pre_upper] at h
  exact h

/-- (c) The whole tail sweep is record-independent at the window state `w'`. -/
theorem window_tapeFree (s : State) (m : List Bool)
    (sweepFree : ∀ m n, run cellDecoderSweep m s = run cellDecoderSweep n s) :
    ∀ rec, run (StairLoan.emitSweep tailL top760) rec (run windowPre760 m s) =
      run (StairLoan.emitSweep tailL top760) [] (run windowPre760 m s) := by
  intro rec
  have whole : ∀ a b,
      run (windowPre760 ++ (StairLoan.emitSweep tailL top760 ++ restWindow760)) a s =
      run (windowPre760 ++ (StairLoan.emitSweep tailL top760 ++ restWindow760)) b s := by
    rw [← sweep_shape_window]
    exact sweepFree
  exact tapeFree_middle _ _ _ s whole m rec []


end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan
end Merge_StairDivLoanTop_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanAssembly_at_StairSideA` -/
section Merge_StairDivLoanAssembly_at_StairSideA

/-!
# Division-endpoint decoder loan: assembly of `cellDecoderLoan_run_eq`

Part 1 (`StairDivLoanRearrange`): `cellDecoderNext` ≡ `cellDecoderUnloan` on every record.
Part 2 (`StairDivLoanPrefix`): the prefix half of the loan lemma on `tailL`.
Part 3 (LT15, `StairDivLoanTop`): the upper-sweep window facts and record independence.

Hypotheses of `cellDecoderLoan_run_eq` are exactly those of `CompareDecoder.cellDecoderNext_correct`.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed BalancedField

theorem cellDecoderSweep_eq_unloan : cellDecoderSweep = cellDecoderUnloan := rfl

theorem loanPre_eq_windowPre760 : loanPre = windowPre760 := rfl

theorem cellDecoderLoan_run_eq (Y : Fp) (sigma : Bool) (s : State) (m n : List Bool)
    (ys : regValue fixedLayout.y s.basis = centerWord Y)
    (rs : regValue fixedLayout.r s.basis = centerWord ((if sigma then 1 else 3) * Y))
    (sig : s.basis fixedLayout.sigma = sigma)
    (hc : s.basis fixedLayout.h = false) (bc : s.basis fixedLayout.bias = false)
    (cc : ∀ q ∈ fixedLayout.carry, s.basis q = false) :
    run cellDecoderLoan m s = run cellDecoderNext n s := by
  have nextFree := cellDecoderNext_tapeFree Y sigma s ys rs sig hc bc cc
  -- K4-D (replay budget): the program names are rewritten to the lemmas' syntactic forms first, so no kernel
  -- conversion has to compare `run P` with `run P'` for `P = P'` only by unfolding
  have sweepFree := sweepFree_of_part1 Y sigma s ys rs sig hc bc cc
    (fun a b => by rw [cellDecoderSweep_eq_unloan]; exact (cellDecoderUnloan_run a s).trans (nextFree a b))
  refine cellDecoderLoan_run_eq_of s m n nextFree (fun a => ⟨loanPre_clean s cc a, ?_, ?_, ?_, ?_⟩)
  · have h := upper_tapeFree s a sweepFree
    rw [← loanPre_eq_windowPre760] at h
    intro rec
    unfold upperState prefixState loanUpper
    exact h rec
  · unfold upperState prefixState loanUpper tailYs tailCs tailCin
    exact upper_same_all _ []
  · unfold upperState prefixState loanUpper
    exact upper_roles_zero_all _ []
  · have h := window_tapeFree s a sweepFree
    rw [← loanPre_eq_windowPre760] at h
    exact h

end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan
end Merge_StairDivLoanAssembly_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanEp1_at_StairSideA` -/
section Merge_StairDivLoanEp1_at_StairSideA

/-!
# Division-endpoint loan: lift of `cellDecoderLoan_run_eq` through the endpoint wrappers

`endPacket760DivLoan` and `R2SqEp760.endPacket760 true` differ only in the decoder inside
`renameProgram (swap 760 717) ∘ renameProgram (shifted pi0) ∘ ControlLoan1589.loanWindow 510 2409 719`.
The lift follows the record's route (`endHalf_run_eq`, `rawEnd_run_eq`, `rawEnd_frame`,
`endPacket_frame`, `endPacket760_run_eq`) with same-record equalities at every layer, and uses
record independence of `endPacket760 true` (phase from `endPacket760_frame`) at the end.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
  Secp256k1 BalancedField Challenge Baselines

/-- `cellDecoderLoan_run_eq` under the hypotheses of `CompareDecoder.cellDecoderNext_frame`. -/
theorem cellDecoderLoan_run_eq_frame (origin : BasisState)
    (clean : ∀q∈work fixedLayout,origin q=false) (X Y : Fp)
    (hend : (X+(if origin fixedLayout.sigma then Y else -Y))/2=Y) (s : State)
    (input : PairFrame fixedLayout.r fixedLayout.y origin (centerWord X) (centerWord Y) s.basis)
    (m n : List Bool) :
    run cellDecoderLoan m s = run cellDecoderNext n s := by
  have cleanS (q : Wire) (hq:q∈work fixedLayout) : s.basis q=false :=
    (input.2.2 q (work_away fixedLayout fixed_nodup q hq).1
      (work_away fixedLayout fixed_nodup q hq).2).trans (clean q hq)
  have sig : s.basis fixedLayout.sigma=origin fixedLayout.sigma := input.2.2 fixedLayout.sigma
    (source_r_away fixedLayout fixed_nodup _ (by tauto))
    (flag_y_away fixedLayout fixed_nodup _ (by simp))
  have rel := terminal_relation X Y (origin fixedLayout.sigma) hend
  have rword : regValue fixedLayout.r s.basis=
      centerWord ((if origin fixedLayout.sigma then 1 else 3)*Y) := by
    rw [input.1,rel]
  exact cellDecoderLoan_run_eq Y (origin fixedLayout.sigma) s m n input.2.1 rword sig
    (cleanS fixedLayout.h (by simp [work])) (cleanS fixedLayout.bias (by simp [work]))
    (fun q hq=>cleanS q (by simp [work,hq]))

end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

namespace ECDSAAdd.Entrant.Rolling1588Lifetime

open Arithmetic MappedCompressed DirectSkywalk Secp256k1 BalancedField OffsetBorrowedCanonical

/-! ## Loaned endpoint pieces -/

def endHalfLoan : Program :=
  CompareDecoder.BoundaryLoan.cellDecoderLoan ++ List.replicate 507 (Instr.measureX (base 512) [] [])

def rawEndLoan : Program :=
  ControlLoan1589.loanWindow (base 510) (base 2409) (base 719) endHalfLoan

theorem endPacket760DivLoan_shape : CompareDecoder.BoundaryLoan.endPacket760DivLoan =
    renameProgram (Equiv.swap (base 760) (base 717))
      (renameProgram (shifted Placement5.pi0) rawEndLoan) := rfl

theorem endPacket760_true_shape : R2SqEp760.endPacket760 true =
    renameProgram (Equiv.swap (base 760) (base 717))
      (renameProgram (shifted Placement5.pi0) (rawEnd true)) := rfl

/-! ## Generic helpers -/


theorem selW_run (g f : Wire) (P : Program) (m : List Bool) (s : State) :
    run (SW.selW g f P) m s =
      run [.measureX f [] [.Z g]] (m.drop (measurementCount P)) (run P m (run [.CX g f] [] s)) := by
  have h0 : measurementCount [Instr.CX g f] = 0 := rfl
  rw [SW.selW, run_append, measurementCount_append, run_append, h0, Nat.zero_add, List.drop_zero,
    List.take_zero, run_take]

/-- The selector measurement is record-independent when flag and source agree. -/
theorem meas_sel (f g : Wire) (hfg : f ≠ g) (Z : State) (h : Z.basis f = Z.basis g)
    (r : List Bool) :
    run [.measureX f [] [.Z g]] r Z = ⟨Z.phase, writeBit Z.basis f false⟩ := by
  show measureAndCorrect f [] [Correction.Z g] (r.headD false) Z = _
  unfold measureAndCorrect
  cases r.headD false
  · show (⟨Z.phase ^^ (false && Z.basis f), writeBit Z.basis f false⟩ : State) = _
    congr 1
    cases Z.phase <;> rfl
  · have hw : writeBit Z.basis f false g = Z.basis g := Function.update_of_ne (Ne.symm hfg) _ _
    show (⟨(Z.phase ^^ (true && Z.basis f)) ^^ writeBit Z.basis f false g,
      writeBit Z.basis f false⟩ : State) = _
    rw [hw, h]
    congr 1
    cases Z.phase <;> cases Z.basis g <;> rfl

