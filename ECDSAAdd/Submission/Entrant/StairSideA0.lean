  [(41, 98, 2), (36, 96, 2), (30, 93, 3), (22, 90, 3), (13, 85, 5)]

theorem zA (loans : StairSchedule.StairLoans) :
    StairLoanField7Transport.headEL loans ++ StairLoanField7Transport.grpFL loans 41 98 2 =
      headELL loans MA := by
