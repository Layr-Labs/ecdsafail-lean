  rw [Rolling1588.encodeGroup_support_eq] at hq0
  obtain ⟨i, rfl⟩ := NewHistory5.history_gate_mem base (5 * k) _ (Or.inl rfl) _ hq0
  exact List.mem_map.mpr ⟨i, List.mem_finRange i, rfl⟩

/-- The raw record stage holds the transcript letters on every completed packet. -/
theorem raw_packet (B : Nat) (x : Nat) (origin : BasisState) (hx : TraceOK x origin)
    (raw : BasisState) (e : Nat)
    (fpast : ∀ j, j < e → raw (StairPhysicalPrimitives.midSegmentMap B j) =
