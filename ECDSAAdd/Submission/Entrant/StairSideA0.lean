/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBoundaryLoanConvert_at_QTop` -/
section Merge_StairBoundaryLoanConvert_at_QTop

/-!
# Boundary carry loans: the two field converters (generic layer)

`canon760` and `center760` are renamed copies of `HalfConvert.canonical` /
`HalfConvert.center`, each one mapped subtraction/addition over a 254-carry
ladder.  The 44 retired roles sit on high carries of that ladder.  This
module replaces the ladder by the existing carry loan
`StairLoan.mappedAddLoan` / `StairLoan.mappedSubLoan` for an arbitrary
`BalancedConvert.Layout` and role list (symbolic wires), and proves:

* `centerLoan_zero` / `canonicalLoan_zero` — depth 0 is the record program;
* `centerLoan_counts` / `canonicalLoan_counts` — exactly `+d` Toffoli and
  `+d` measurements;
* `centerLoan_run_eq` / `canonicalLoan_run_eq` — independent-tape run equality
  with the record converter whenever the ladder is clean on entry;
* `centerLoan_support` / `canonicalLoan_support` — the loaned program uses no
  loaned role (only the `d` lowest carries are added, as hosts);
* `centerLoan_physical` / `canonicalLoan_physical`.

All layout premises are static list facts, discharged once by `decide` at the
concrete 760 layouts.
-/

set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairBoundaryLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-! ## Definitions -/

/-- Loaned halving converter (`HalfConvert.center` with a carry loan). -/
def centerLoan (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout) : Program :=
  [.CX (HalfConvert.lowBit L) L.flag, .CX L.flag (HalfConvert.lowBit L)] ++
    rotateRight L.word ++
    StairLoan.mappedAddLoan d roles (HalfConvert.lowCorrection L) L.low
      (L.carry.take 254) L.cin ++
    [.CX L.flag L.msb, .CX L.msb L.flag]

/-- Loaned canonical converter (`HalfConvert.canonical` with a carry loan). -/
def canonicalLoan (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout) : Program :=
  [.CX L.msb L.flag, .CX L.flag L.msb] ++
    StairLoan.mappedSubLoan d roles (HalfConvert.lowCorrection L) L.low
      (L.carry.take 254) L.cin ++
    rotateLeft L.word ++
    [.CX L.flag (HalfConvert.lowBit L), .CX (HalfConvert.lowBit L) L.flag]



/-! ## Counts -/

theorem lowCorrection_length (L : BalancedConvert.Layout) :
    (HalfConvert.lowCorrection L).length = 255 := by
  simp [HalfConvert.lowCorrection]

theorem ladder_lengths (L : BalancedConvert.Layout) (hw : L.Widths) :
    (HalfConvert.lowCorrection L).length = L.low.length ∧
      (L.carry.take 254).length + 1 = L.low.length ∧
      (L.carry.take 254).length = 254 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [lowCorrection_length, hw.1]
  · simp only [List.length_take, hw.1, hw.2]
    omega
  · simp only [List.length_take, hw.2]
    omega



/-! ## Run equality -/

/-- Static layout facts used by both converters. -/
structure LadderFacts (L : BalancedConvert.Layout) : Prop where
  widths : L.Widths
  nodup : (L.cin :: (L.low ++ L.carry.take 254)).Nodup
  bitsAway : ∀ q ∈ mappedWires (HalfConvert.lowCorrection L),
    q ∉ L.cin :: (L.low ++ L.carry.take 254)
  carryAway : ∀ q ∈ L.carry.take 254,
    q ∉ L.word ∧ q ≠ L.flag ∧ q ≠ HalfConvert.lowBit L ∧ q ≠ L.msb

theorem centerLoan_run_eq (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (F : LadderFacts L) (hd : d + 1 ≤ 254)
    (roleTail : ∀ q ∈ roles.take d, q ∈ (L.carry.take 254).drop (d + 1))
    (s : State) (clean : ∀ q ∈ L.carry.take 254, s.basis q = false)
    (m n : List Bool) :
    run (centerLoan d roles L) m s = run (HalfConvert.center L) n s := by
  have len := ladder_lengths L F.widths
  let A : Program :=
    [.CX (HalfConvert.lowBit L) L.flag, .CX L.flag (HalfConvert.lowBit L)] ++
      rotateRight L.word
  let P := StairLoan.mappedAddLoan d roles (HalfConvert.lowCorrection L) L.low
    (L.carry.take 254) L.cin
  let Q := mappedAdd (HalfConvert.lowCorrection L) L.low (L.carry.take 254) L.cin
  let R : Program := [.CX L.flag L.msb, .CX L.msb L.flag]
  have aZero : measurementCount A = 0 := by
    simp only [A, measurementCount_append, (rotate_counts L.word).2.1]
    rfl
  have cleanA : ∀ q ∈ L.carry.take 254, (run A [] s).basis q = false := by
    intro q hq
    have away := F.carryAway q hq
    have first : (run [Instr.CX (HalfConvert.lowBit L) L.flag,
        Instr.CX L.flag (HalfConvert.lowBit L)] [] s).basis q = s.basis q := by
      simp [run, writeBit, Function.update, away.2.1, away.2.2.1]
    rw [show run A [] s = run (rotateRight L.word) []
        (run [Instr.CX (HalfConvert.lowBit L) L.flag,
          Instr.CX L.flag (HalfConvert.lowBit L)] [] s) by
      rw [show A = [Instr.CX (HalfConvert.lowBit L) L.flag,
          Instr.CX L.flag (HalfConvert.lowBit L)] ++ rotateRight L.word from rfl,
        run_append]
      simp only [List.take_nil, List.drop_nil]]
    rw [(rotate_frame L.word _ []).2.1 q away.1, first]
    exact clean q hq
  have middle : ∀ x y, run P x (run A [] s) = run Q y (run A [] s) := fun x y =>
    StairLoan.mappedAddLoan_run_eq d roles (HalfConvert.lowCorrection L) L.low
      (L.carry.take 254) L.cin (run A [] s) x y F.nodup F.bitsAway len.1 len.2.1
      (by omega) cleanA roleTail
  have tail : ∀ x y, run R x (run P [] (run A [] s)) = run R y (run P [] (run A [] s)) :=
    fun x y => FifthCarry.no_records R rfl _ x y
  show run (A ++ P ++ R) m s = run (A ++ Q ++ R) n s
  exact StairLoan.run_sandwich_independent A P Q R s m n aZero middle tail


/-! ## Support and physicality -/

theorem centerLoan_support (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (F : LadderFacts L) (hd : d + 1 ≤ 254) (hr : d ≤ roles.length)
    (banks : (roles.take d ++ (L.carry.take 254).take d).Nodup)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires ((HalfConvert.lowCorrection L).take (d + 1)) ++
        L.low.take (d + 1) ++ (L.carry.take 254).take (d + 1) ++ [L.cin]).toFinset)
    (roleOuter : ∀ r ∈ roles.take d,
      r ∉ wires ([Instr.CX (HalfConvert.lowBit L) L.flag,
        Instr.CX L.flag (HalfConvert.lowBit L)] ++ rotateRight L.word) ∧
      r ∉ wires [Instr.CX L.flag L.msb, Instr.CX L.msb L.flag]) :
    wires (centerLoan d roles L) ⊆
      (wires (HalfConvert.center L) \ (roles.take d).toFinset) ∪
        ((L.carry.take 254).take d).toFinset := by
  have len := ladder_lengths L F.widths
  have lift := StairLoanSupport.mappedAddLoan_support_lift d roles
    (HalfConvert.lowCorrection L) L.low (L.carry.take 254) L.cin len.1 len.2.1
    (by omega) hr F.nodup F.bitsAway banks roleAway
  intro q hq
  simp only [centerLoan, HalfConvert.center, wires_append, Finset.mem_union,
    Finset.mem_sdiff, List.mem_toFinset] at hq ⊢
  rcases hq with ((pre | rot) | loan) | post
  · left
    refine ⟨Or.inl (Or.inl (Or.inl pre)), fun hr' => (roleOuter q hr').1 ?_⟩
    simp only [wires_append, Finset.mem_union]
    exact Or.inl pre
  · left
    refine ⟨Or.inl (Or.inl (Or.inr rot)), fun hr' => (roleOuter q hr').1 ?_⟩
    simp only [wires_append, Finset.mem_union]
    exact Or.inr rot
  · have h := lift loan
    simp only [Finset.mem_union, Finset.mem_sdiff, List.mem_toFinset] at h
    rcases h with ⟨inOld, notRole⟩ | host
    · exact Or.inl ⟨Or.inl (Or.inr inOld), notRole⟩
    · exact Or.inr host
  · left
    exact ⟨Or.inr post, fun hr' => (roleOuter q hr').2 post⟩

theorem canonicalLoan_support (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (F : LadderFacts L) (hd : d + 1 ≤ 254) (hr : d ≤ roles.length)
    (banks : (roles.take d ++ (L.carry.take 254).take d).Nodup)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires ((HalfConvert.lowCorrection L).take (d + 1)) ++
        L.low.take (d + 1) ++ (L.carry.take 254).take (d + 1) ++ [L.cin]).toFinset)
    (roleAwayYs : ∀ r ∈ roles.take d, r ∉ L.low)
    (roleOuter : ∀ r ∈ roles.take d,
      r ∉ wires [Instr.CX L.msb L.flag, Instr.CX L.flag L.msb] ∧
      r ∉ wires (rotateLeft L.word ++
        [Instr.CX L.flag (HalfConvert.lowBit L), Instr.CX (HalfConvert.lowBit L) L.flag])) :
    wires (canonicalLoan d roles L) ⊆
      (wires (HalfConvert.canonical L) \ (roles.take d).toFinset) ∪
        ((L.carry.take 254).take d).toFinset := by
  have len := ladder_lengths L F.widths
  have lift := StairLoanSupport.mappedSubLoan_support_lift d roles
    (HalfConvert.lowCorrection L) L.low (L.carry.take 254) L.cin len.1 len.2.1
    (by omega) hr F.nodup F.bitsAway banks roleAway roleAwayYs
  intro q hq
  simp only [canonicalLoan, HalfConvert.canonical, wires_append, Finset.mem_union,
    Finset.mem_sdiff, List.mem_toFinset] at hq ⊢
  rcases hq with ((pre | loan) | rot) | post
  · left
    exact ⟨Or.inl (Or.inl (Or.inl pre)), fun hr' => (roleOuter q hr').1 pre⟩
  · have h := lift loan
    simp only [Finset.mem_union, Finset.mem_sdiff, List.mem_toFinset] at h
    rcases h with ⟨inOld, notRole⟩ | host
    · exact Or.inl ⟨Or.inl (Or.inl (Or.inr inOld)), notRole⟩
    · exact Or.inr host
  · left
    refine ⟨Or.inl (Or.inr rot), fun hr' => (roleOuter q hr').2 ?_⟩
    simp only [wires_append, Finset.mem_union]
    exact Or.inl rot
  · left
    refine ⟨Or.inr post, fun hr' => (roleOuter q hr').2 ?_⟩
    simp only [wires_append, Finset.mem_union]
    exact Or.inr post




end ECDSAAdd.Entrant.StairBoundaryLoan
end Merge_StairBoundaryLoanConvert_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairEndpointLoan44Chain_at_QTop` -/
section Merge_StairEndpointLoan44Chain_at_QTop

/-!
# Carry loans for the controlled comparison chain and the plain in-place adder

The multiplication endpoint (`InverseTailC.program`) runs three 255-carry
sweeps: the decision comparator `compareLt (some sign)`, the raw signed add
(`addInPlace`), and the p-correction (`mappedSub`).  `StairLoan` already loans
mapped adders.  This module

* writes `Arithmetic.compareChain control` as an `emitSweep` and proves the
  loaned chain `ctlLoan` equal to it for independent tapes on a clean carry
  bank (`ctlLoan_run_eq`), with exact `+d` counts and physicality;
* identifies `addInPlace xs` with `mappedAdd (mappedRead xs false)`.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 12000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairEndpointLoan44

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoan

/-! ## The controlled comparison chain as a carry sweep -/

def ctlLayers : List Wire → List Wire → List Wire → Wire → List CarryLayer
  | a::as, b::bs, c::cs, cin =>
      { host:=c, up:=majority a b cin c, erase:=eraseCarry a b cin c,
        finish:=[] } :: ctlLayers as bs cs c
  | _, _, _, _ => []

def ctlTop (control : Option Wire) (target : Wire) :
    List Wire → List Wire → List Wire → Wire → Program
  | _::as, _::bs, c::cs, _ => ctlTop control target as bs cs c
  | [], [], [], cin => flipBelow control cin target
  | _, _, _, _ => []

/-- Loaned controlled comparison chain. -/
def ctlLoan (d : Nat) (roles : List Wire) (control : Option Wire)
    (as bs cs : List Wire) (cin target : Wire) : Program :=
  emitLoan d roles (ctlLayers as bs cs cin) (ctlTop control target as bs cs cin)

theorem compareChain_as_ctlSweep (control : Option Wire) (target : Wire)
    (as bs cs : List Wire) (cin : Wire) :
    compareChain control as bs cs cin target =
      emitSweep (ctlLayers as bs cs cin) (ctlTop control target as bs cs cin) := by
  induction as generalizing bs cs cin with
  | nil =>
      cases bs <;> cases cs <;>
        simp [compareChain, ctlLayers, ctlTop, emitSweep, emitUps, emitDowns]
  | cons a as ih =>
      cases bs with
      | nil => simp [compareChain, ctlLayers, ctlTop, emitSweep, emitUps, emitDowns]
      | cons b bs =>
          cases cs with
          | nil => simp [compareChain, ctlLayers, ctlTop, emitSweep, emitUps, emitDowns]
          | cons c cs =>
              have tail := ih bs cs c
              simp only [compareChain, ctlLayers, ctlTop, tail]
              simp [emitSweep, emitUps, emitDowns, CarryLayer.down, List.append_assoc]

theorem ctlLayers_unit (as bs cs : List Wire) (cin : Wire) :
    ∀ l ∈ ctlLayers as bs cs cin, LayerUnit l := by
  induction as generalizing bs cs cin with
  | nil => simp [ctlLayers]
  | cons a as ih =>
      cases bs with
      | nil => simp [ctlLayers]
      | cons b bs =>
          cases cs with
          | nil => simp [ctlLayers]
          | cons c cs =>
              intro l hl
              simp only [ctlLayers, List.mem_cons] at hl
              rcases hl with rfl | hl
              · exact ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩
              · exact ih bs cs c l hl

theorem ctlLayers_length (as bs cs : List Wire) (cin : Wire)
    (hab : as.length = bs.length) (hc : cs.length = bs.length) :
    (ctlLayers as bs cs cin).length = cs.length := by
  induction as generalizing bs cs cin with
  | nil =>
      have be : bs = [] := List.eq_nil_of_length_eq_zero hab.symm
      subst bs
      have ce : cs = [] := List.eq_nil_of_length_eq_zero hc
      subst cs
      rfl
  | cons a as ih =>
      cases bs with
      | nil => simp at hab
      | cons b bs =>
          cases cs with
          | nil => simp at hc
          | cons c cs =>
              simp only [ctlLayers, List.length_cons]
              rw [ih bs cs c (by simpa using hab) (by simpa using hc)]

theorem ctlLoan_counts (d : Nat) (roles : List Wire) (control : Option Wire)
    (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length = bs.length) (hc : cs.length = bs.length)
    (hd : d ≤ cs.length) :
    toffoliCount (ctlLoan d roles control as bs cs cin target) =
        toffoliCount (compareChain control as bs cs cin target) + d ∧
    measurementCount (ctlLoan d roles control as bs cs cin target) =
        measurementCount (compareChain control as bs cs cin target) + d := by
  have len := ctlLayers_length as bs cs cin hab hc
  have loan := emitLoan_counts d roles (ctlLayers as bs cs cin)
    (ctlTop control target as bs cs cin) (by omega) (ctlLayers_unit as bs cs cin)
  rw [← compareChain_as_ctlSweep] at loan
  simpa only [ctlLoan] using loan

theorem ctlLoan_physical (d : Nat) (roles : List Wire) (control : Option Wire)
    (as bs cs : List Wire) (cin target : Wire)
    (hp : GatePhysical (compareChain control as bs cs cin target)) :
    GatePhysical (ctlLoan d roles control as bs cs cin target) := by
  rw [compareChain_as_ctlSweep] at hp
  exact StairLoanSupport.emitLoan_physical d roles _ _ hp

theorem ctl_prefix_shapes (d : Nat) (as bs cs : List Wire) (cin : Wire)
    (hab : as.length = bs.length) (hc : cs.length = bs.length)
    (hd : d ≤ cs.length) :
    emitUps ((ctlLayers as bs cs cin).take d) =
        carryPrefix d (mappedRead as false) bs cs cin ∧
      emitErases ((ctlLayers as bs cs cin).take d) =
        erasePrefix d (mappedRead as false) bs cs cin ∧
      layerHosts ((ctlLayers as bs cs cin).take d) = cs.take d := by
  induction d generalizing as bs cs cin with
  | zero => exact ⟨rfl, rfl, rfl⟩
  | succ d ih =>
      cases as with
      | nil =>
          have be : bs = [] := List.eq_nil_of_length_eq_zero hab.symm
          subst bs
          have ce : cs = [] := List.eq_nil_of_length_eq_zero hc
          subst cs
          simp at hd
      | cons a as =>
          cases bs with
          | nil => simp at hab
          | cons b bs =>
              cases cs with
              | nil => simp at hd
              | cons c cs =>
                  have tail := ih as bs cs c
                    (by simpa using hab) (by simpa using hc) (by simpa using hd)
                  rcases tail with ⟨up, erase, hosts⟩
                  constructor
                  · simpa [ctlLayers, emitUps, carryPrefix, mappedRead,
                      mappedMajority, List.append_assoc] using
                      congrArg (fun P => majority a b cin c ++ P) up
                  constructor
                  · simpa [ctlLayers, emitErases, erasePrefix, mappedRead,
                      mappedEraseCarry, List.append_assoc] using
                      congrArg (fun P => P ++ eraseCarry a b cin c) erase
                  · simpa [ctlLayers, layerHosts] using congrArg (List.cons c) hosts

theorem ctl_upper_sweep (n : Nat) (control : Option Wire) (target : Wire)
    (as bs cs : List Wire) (cin : Wire)
    (hab : as.length = bs.length) (hc : cs.length = bs.length)
    (hn : n ≤ cs.length) :
    emitSweep ((ctlLayers as bs cs cin).drop n) (ctlTop control target as bs cs cin) =
      compareChain control (as.drop n) (bs.drop n) (cs.drop n)
        (carryAfter n cs cin) target := by
  induction n generalizing as bs cs cin with
  | zero => exact (compareChain_as_ctlSweep control target as bs cs cin).symm
  | succ n ih =>
      cases as with
      | nil =>
          have be : bs = [] := List.eq_nil_of_length_eq_zero hab.symm
          subst bs
          have ce : cs = [] := List.eq_nil_of_length_eq_zero hc
          subst cs
          simp at hn
      | cons a as =>
          cases bs with
          | nil => simp at hab
          | cons b bs =>
              cases cs with
              | nil => simp at hn
              | cons c cs =>
                  simp only [ctlLayers, ctlTop, List.drop_succ_cons, carryAfter]
                  exact ih as bs cs c
                    (by simpa using hab) (by simpa using hc) (by simpa using hn)

/-- The comparison chain is record independent on a clean carry bank. -/
theorem compareChain_records (control : Option Wire) (as bs cs : List Wire)
    (cin target : Wire)
    (hn : (target :: cin :: (as ++ bs ++ cs)).Nodup)
    (hctl : ∀ c ∈ control, c ∉ target :: cin :: (as ++ bs ++ cs))
    (hab : as.length = bs.length) (hc : cs.length = bs.length)
    (s : State) (clean : ∀ q ∈ cs, s.basis q = false) (a b : List Bool) :
    run (compareChain control as bs cs cin target) a s =
      run (compareChain control as bs cs cin target) b s := by
  have A := compareChain_correct control as bs cs cin target hn hctl hab hc s a clean
  have B := compareChain_correct control as bs cs cin target hn hctl hab hc s b clean
  apply State.extensionality
  · rw [A.1, B.1]
  · funext q
    by_cases hq : q = target
    · subst hq
      rw [A.2.2, B.2.2]
    · rw [A.2.1 q hq, B.2.1 q hq]

/-- Full-state replay of the loaned controlled comparison chain. -/
theorem ctlLoan_run_eq (d : Nat) (roles : List Wire) (control : Option Wire)
    (as bs cs : List Wire) (cin target : Wire) (s : State) (m n : List Bool)
    (hab : as.length = bs.length) (hc : cs.length = bs.length)
    (hd : d + 1 ≤ cs.length)
    (hn : (target :: cin :: (as ++ bs ++ cs)).Nodup)
    (hctl : ∀ c ∈ control, c ∉ target :: cin :: (as ++ bs ++ cs))
    (clean : ∀ q ∈ cs, s.basis q = false)
    (roleTail : ∀ q ∈ roles.take d, q ∈ cs.drop (d + 1)) :
    run (ctlLoan d roles control as bs cs cin target) m s =
      run (compareChain control as bs cs cin target) n s := by
  let bits := mappedRead as false
  let layers := ctlLayers as bs cs cin
  let topProgram := ctlTop control target as bs cs cin
  let P := emitUps (layers.take (d + 1))
  let U := emitSweep (layers.drop (d + 1)) topProgram
  let u := run P [] s
  let v := run U [] u
  let out := run (emitSweep layers topProgram) [] s
  have bitsLength : bits.length = bs.length := by
    simp only [bits, mappedRead_length]
    exact hab
  have csND : cs.Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    omega
  have mappedND : (cin :: (bs ++ cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    omega
  -- membership in `as` excludes every other listed wire
  have asAway (q : Wire) (hq : q ∈ as) :
      q ≠ target ∧ q ≠ cin ∧ q ∉ bs ∧ q ∉ cs := by
    have h := List.nodup_iff_count.mp hn q
    have hp := List.count_pos_iff.mpr hq
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro e
      subst e
      simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h hp
      omega
    · intro e
      subst e
      simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h hp
      omega
    · intro hb
      have hbp := List.count_pos_iff.mpr hb
      simp only [List.count_cons, List.count_append, List.count_nil] at h hp hbp
      omega
    · intro hb
      have hbp := List.count_pos_iff.mpr hb
      simp only [List.count_cons, List.count_append, List.count_nil] at h hp hbp
      omega
  have csAway (q : Wire) (hq : q ∈ cs) :
      q ≠ target ∧ q ≠ cin ∧ q ∉ bs := by
    have h := List.nodup_iff_count.mp hn q
    have hp := List.count_pos_iff.mpr hq
    refine ⟨?_, ?_, ?_⟩
    · intro e
      subst e
      simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h hp
      omega
    · intro e
      subst e
      simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h hp
      omega
    · intro hb
      have hbp := List.count_pos_iff.mpr hb
      simp only [List.count_cons, List.count_append, List.count_nil] at h hp hbp
      omega
  have targetCin : target ≠ cin := by
    intro e
    subst e
    simp at hn
  have targetBs : target ∉ bs := by
    intro hb
    have h := List.nodup_iff_count.mp hn target
    have hbp := List.count_pos_iff.mpr hb
    simp only [List.count_cons, List.count_append, List.count_nil,
      beq_self_eq_true, if_true] at h hbp
    omega
  have sourceAway : ∀ q ∈ mappedWires bits, q ∉ cin :: (bs ++ cs) := by
    intro q hq bad
    simp only [bits, mappedRead_wires] at hq
    have aw := asAway q hq
    simp only [List.mem_cons, List.mem_append] at bad
    rcases bad with e | bad | bad
    · exact aw.2.1 e
    · exact aw.2.2.1 bad
    · exact aw.2.2.2 bad
  have prefixShapes := ctl_prefix_shapes (d + 1) as bs cs cin hab hc hd
  have borrowShapes := ctl_prefix_shapes d as bs cs cin hab hc (by omega)
  have prefixShape : P = carryPrefix (d + 1) bits bs cs cin := prefixShapes.1
  have eraseShape : emitErases (layers.take d) = erasePrefix d bits bs cs cin :=
    borrowShapes.2.1
  have borrowShape : emitUps (layers.take d) = carryPrefix d bits bs cs cin :=
    borrowShapes.1
  have hostShape : layerHosts (layers.take d) = cs.take d := borrowShapes.2.2
  have prefixZero : measurementCount P = 0 := by
    rw [prefixShape]
    exact (carryPrefix_counts (d + 1) bits bs cs cin (by omega) (by omega) hd).2
  have prefixRun : ∀ rec, run P rec s = u := by
    intro rec
    exact FifthCarry.no_records P prefixZero s rec []
  have prefixFrame := carryPrefix_frame (d + 1) bits bs cs cin s [] mappedND
    sourceAway (by omega) (by omega) hd
    (fun q hq => clean q (List.mem_of_mem_take hq))
  rw [← prefixShape] at prefixFrame
  change u.phase = s.phase ∧ PrefixReady (d + 1) bits bs cs cin u.basis ∧
    ∀ q, q ∉ cs.take (d + 1) → u.basis q = s.basis q at prefixFrame
  have upperShape : U = compareChain control (as.drop (d + 1)) (bs.drop (d + 1))
      (cs.drop (d + 1)) (carryAfter (d + 1) cs cin) target :=
    ctl_upper_sweep (d + 1) control target as bs cs cin hab hc hd
  have tailHab : (as.drop (d + 1)).length = (bs.drop (d + 1)).length := by
    simp only [List.length_drop]
    omega
  have tailHc : (cs.drop (d + 1)).length = (bs.drop (d + 1)).length := by
    simp only [List.length_drop]
    omega
  have carryFull : carryAfter (d + 1) cs cin ∈ cs := carryAfter_succ_mem d cs cin hd
  have carryLow : carryAfter (d + 1) cs cin ∈ cs.take (d + 1) :=
    carryAfter_succ_take_mem d cs cin hd
  have dropDisjoint : ∀ q ∈ cs.take (d + 1), q ∉ cs.drop (d + 1) := by
    intro q low high
    exact List.disjoint_left.mp
      (List.disjoint_take_drop csND (Nat.le_refl (d + 1))) low high
  have tailND : (target :: carryAfter (d + 1) cs cin ::
      ((as.drop (d + 1)) ++ (bs.drop (d + 1)) ++ (cs.drop (d + 1)))).Nodup := by
    have restND : (as ++ bs ++ cs).Nodup :=
      (List.nodup_cons.mp (List.nodup_cons.mp hn).2).2
    have restTailND : ((as.drop (d + 1)) ++ (bs.drop (d + 1)) ++
        (cs.drop (d + 1))).Nodup := by
      apply List.nodup_iff_count.mpr
      intro q
      have h := List.nodup_iff_count.mp restND q
      have ha := (List.drop_sublist (d + 1) as).count_le q
      have hb := (List.drop_sublist (d + 1) bs).count_le q
      have hcs := (List.drop_sublist (d + 1) cs).count_le q
      simp only [List.count_append] at h ha hb hcs ⊢
      omega
    have targetAway : target ∉ (carryAfter (d + 1) cs cin) ::
        ((as.drop (d + 1)) ++ (bs.drop (d + 1)) ++ (cs.drop (d + 1))) := by
      intro used
      simp only [List.mem_cons, List.mem_append] at used
      rcases used with e | (ha | hb) | hcs
      · exact (csAway _ carryFull).1 e.symm
      · exact (asAway _ (List.mem_of_mem_drop ha)).1 rfl
      · exact targetBs (List.mem_of_mem_drop hb)
      · exact (csAway _ (List.mem_of_mem_drop hcs)).1 rfl
    have carryAway : carryAfter (d + 1) cs cin ∉
        (as.drop (d + 1)) ++ (bs.drop (d + 1)) ++ (cs.drop (d + 1)) := by
      intro used
      simp only [List.mem_append] at used
      rcases used with (ha | hb) | hcs
      · exact (asAway _ (List.mem_of_mem_drop ha)).2.2.2 carryFull
      · exact (csAway _ carryFull).2.2 (List.mem_of_mem_drop hb)
      · exact dropDisjoint _ carryLow hcs
    exact List.nodup_cons.mpr ⟨targetAway, List.nodup_cons.mpr ⟨carryAway, restTailND⟩⟩
  have tailCtl : ∀ c ∈ control, c ∉ target :: carryAfter (d + 1) cs cin ::
      ((as.drop (d + 1)) ++ (bs.drop (d + 1)) ++ (cs.drop (d + 1))) := by
    intro c hcm used
    apply hctl c hcm
    simp only [List.mem_cons, List.mem_append] at used ⊢
    rcases used with e | e | (ha | hb) | hcs
    · exact Or.inl e
    · exact Or.inr (Or.inr (Or.inr (e ▸ carryFull)))
    · exact Or.inr (Or.inr (Or.inl (Or.inl (List.mem_of_mem_drop ha))))
    · exact Or.inr (Or.inr (Or.inl (Or.inr (List.mem_of_mem_drop hb))))
    · exact Or.inr (Or.inr (Or.inr (List.mem_of_mem_drop hcs)))
  have cleanU : ∀ q ∈ cs.drop (d + 1), u.basis q = false := by
    intro q hq
    rw [prefixFrame.2.2 q (fun low => dropDisjoint q low hq)]
    exact clean q (List.mem_of_mem_drop hq)
  have upperRun : ∀ rec, run U rec u = v := by
    intro rec
    change run U rec u = run U [] u
    rw [upperShape]
    exact compareChain_records control _ _ _ _ target tailND tailCtl tailHab tailHc
      u cleanU rec []
  have upperFacts := compareChain_correct control (as.drop (d + 1))
    (bs.drop (d + 1)) (cs.drop (d + 1)) (carryAfter (d + 1) cs cin) target
    tailND tailCtl tailHab tailHc u [] cleanU
  have vEq : v = run (compareChain control (as.drop (d + 1)) (bs.drop (d + 1))
      (cs.drop (d + 1)) (carryAfter (d + 1) cs cin) target) [] u := by
    change run U [] u = _
    rw [upperShape]
  have lowAwayUpper : ∀ q ∈ wires U, q ∉ cs.take d := by
    intro q hq low
    rw [upperShape, compareChain_wires control _ _ _ _ target tailHab tailHc] at hq
    have used := List.mem_toFinset.mp hq
    have lowFull : q ∈ cs := List.mem_of_mem_take low
    have lowBoundary : q ∈ cs.take (d + 1) := by
      rw [show cs.take d = (cs.take (d + 1)).take d by simp [List.take_take]] at low
      exact List.mem_of_mem_take low
    simp only [List.mem_append, List.mem_cons] at used
    rcases used with hcm | e | e | (ha | hb) | hcs
    · exact hctl q (by simpa using hcm) (by simp [lowFull])
    · exact (csAway q lowFull).1 e
    · subst e
      exact carryAfter_succ_away d cs cin csND hd low
    · exact (asAway q (List.mem_of_mem_drop ha)).2.2.2 lowFull
    · exact (csAway q lowFull).2.2 (List.mem_of_mem_drop hb)
    · exact dropDisjoint q lowBoundary hcs
  have upperSame : ∀ q ∈ mappedWires (bits.take d) ++ bs.take d ++ cs.take d ++ [cin],
      v.basis q = u.basis q := by
    intro q hq
    rw [vEq]
    apply upperFacts.2.1 q
    intro e
    subst e
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with ((source | lowB) | lowC) | input
    · have z := mappedWires_take_mem d bits q source
      simp only [bits, mappedRead_wires] at z
      exact (asAway q z).1 rfl
    · exact targetBs (List.mem_of_mem_take lowB)
    · exact (csAway q (List.mem_of_mem_take lowC)).1 rfl
    · exact targetCin input
  have upperRoleZero : ∀ q ∈ roles.take d, v.basis q = false := by
    intro q hq
    have tail := roleTail q hq
    rw [vEq, upperFacts.2.1 q (fun e => (csAway q (List.mem_of_mem_drop tail)).1 e),
      prefixFrame.2.2 q (fun low => dropDisjoint q low tail)]
    exact clean q (List.mem_of_mem_drop tail)
  have wholeRun : ∀ rec, run (emitSweep layers topProgram) rec s = out := by
    intro rec
    change run (emitSweep layers topProgram) rec s =
      run (emitSweep layers topProgram) [] s
    rw [← compareChain_as_ctlSweep control target as bs cs cin]
    exact compareChain_records control as bs cs cin target hn hctl hab hc s clean rec []
  have replay := emitLoan_mapped_prefix_run_eq d roles layers topProgram bits bs cs cin
    s u v out m n mappedND sourceAway prefixShape eraseShape borrowShape hostShape
    prefixZero prefixRun prefixFrame.2.1 prefixFrame.2.2
    clean roleTail upperRun lowAwayUpper upperSame upperRoleZero wholeRun
  rw [← compareChain_as_ctlSweep control target as bs cs cin] at replay
  exact replay

/-! ## The plain in-place adder is a mapped adder -/

theorem addInPlace_eq_mapped (as bs cs : List Wire) (cin : Wire) :
    addInPlace as bs cs cin = mappedAdd (mappedRead as false) bs cs cin := by
  induction as generalizing bs cs cin with
  | nil => simp [addInPlace, mappedAdd, mappedRead]
  | cons a as ih =>
      cases as with
      | nil =>
          cases bs with
          | nil => simp [addInPlace, mappedAdd, mappedRead]
          | cons b bs =>
              cases bs with
              | nil => simp [addInPlace, mappedAdd, mappedRead, mappedSum]
              | cons b' bs => simp [addInPlace, mappedAdd, mappedRead]
      | cons a' as =>
          cases bs with
          | nil => simp [addInPlace, mappedAdd, mappedRead]
          | cons b bs =>
              cases bs with
              | nil => simp [addInPlace, mappedAdd, mappedRead]
              | cons b' bs =>
                  cases cs with
                  | nil => simp [addInPlace, mappedAdd, mappedRead]
                  | cons c cs =>
                      have tail := ih (b' :: bs) cs c
                      simp only [addInPlace, tail]
                      simp [mappedAdd, mappedRead, mappedMajority, mappedEraseCarry,
                        mappedSum]

end ECDSAAdd.Entrant.StairEndpointLoan44
end Merge_StairEndpointLoan44Chain_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairEndpointLoan44Tail_at_QTop` -/
section Merge_StairEndpointLoan44Tail_at_QTop

/-!
# The 44-site loaned multiplication tail

`InverseTailC.program` runs three 255-carry sweeps (decision comparator, raw
signed add, p-correction); each one touches all 44 exclusive retired sites
`base 720 .. base 764` (without `base 760`), which are the carries 208..252 of
the endpoint cell.  `tailProgramLoan44` loans each sweep at depth 44 with the
roles `StairLoan.retiredRoles.take 44` (v3 order; = `StairPhysicalInventory.exclusiveSites`)
on the hosts `carry.take 44`.  Cost: exactly `+132` CCX and `+132` measurements.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 12000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairEndpointLoan44

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoan

/-- The 44 retired roles that free a physical site (`exclusiveSites`). -/
-- LT6 (integration on the frozen program): CANON v3 reordered `StairLoan.retiredRoleIndices`
-- (exclusive roles first), so the 44 exclusive roles are `take 44` there; the list is the same.
def roles44 : List Wire := StairLoan.retiredRoles.take 44

theorem roles44_eq : roles44 = (List.range' 720 40 ++ List.range' 761 4).map base := by
  decide +kernel

/-- The concrete endpoint cell. -/
abbrev endpointL : BalancedCircuit.Layout := Q6EndpointCell.ports base (base 2409)

/-! ## Loaned blocks -/

def compareLtLoan44 (L : BalancedCircuit.Layout) : Program :=
  notRegister (L.one :: L.low) ++
    ctlLoan 44 roles44 (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity ++
    notRegister (L.one :: L.low)

def decisionLoan44 (L : BalancedCircuit.Layout) : Program :=
  InverseTailC.prep L ++ compareLtLoan44 L ++ [.CX L.sign L.parity] ++
    (InverseTailC.prep L).reverse

def signedAddLoan44 (L : BalancedCircuit.Layout) : Program :=
  signComplement L.sign L.y ++
    mappedAddLoan 44 roles44 (mappedRead L.y false) L.r (L.carry.take 255) L.sign ++
    signComplement L.sign L.y

def rawLoan44 (L : BalancedCircuit.Layout) : Program :=
  InverseTailC.double L ++ [.X L.sign] ++ signedAddLoan44 L ++ [.X L.sign]

def correctionLoan44 (L : BalancedCircuit.Layout) : Program :=
  signComplement L.ymsb L.r ++
    mappedSubLoan 44 roles44 (mappedConstant (some L.parity) 256 p)
      L.r (L.carry.take 255) L.one ++
    signComplement L.ymsb L.r

def tailProgramLoan44 (L : BalancedCircuit.Layout) : Program :=
  decisionLoan44 L ++ rawLoan44 L ++ correctionLoan44 L ++
    [.CX L.r0 L.parity, .CX (L.ylow.headD L.ymsb) L.parity]

/-! ## Exact counts -/

theorem prep_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (InverseTailC.prep L) = 0 ∧ measurementCount (InverseTailC.prep L) = 0 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have c := copyRegister_counts none L.y L.r (w.2.2.1.trans w.2.1.symm)
  simp only [InverseTailC.prep, toffoliCount_append, measurementCount_append, c.1, c.2,
    signComplement_counts,
    (xorConstant_counts _ _).1, (xorConstant_counts _ _).2,
    (maskedConstant_counts _ _ _).1, (maskedConstant_counts _ _ _).2]
  simp

theorem compareLtLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (compareLtLoan44 L) =
        toffoliCount (compareLt (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity) + 44 ∧
    measurementCount (compareLtLoan44 L) =
        measurementCount (compareLt (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity) + 44 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have ctl := ctlLoan_counts 44 roles44 (some L.sign) L.ylow L.low (L.carry.take 255) L.one
    L.parity (hw.2.1.trans w.1.symm) (by simp [List.length_take, hw.2.2, w.1])
    (by simp [List.length_take, hw.2.2])
  constructor <;>
    simp only [compareLtLoan44, compareLt, toffoliCount_append, measurementCount_append,
      ctl.1, ctl.2] <;> omega

theorem decisionLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (decisionLoan44 L) = toffoliCount (InverseTailC.decision L) + 44 ∧
    measurementCount (decisionLoan44 L) = measurementCount (InverseTailC.decision L) + 44 := by
  have c := compareLtLoan44_counts L hw
  constructor <;>
    simp only [decisionLoan44, InverseTailC.decision, toffoliCount_append,
      measurementCount_append, c.1, c.2] <;> omega

theorem signedAddLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (signedAddLoan44 L) =
        toffoliCount (signedAdd L.sign L.y L.r (L.carry.take 255)) + 44 ∧
    measurementCount (signedAddLoan44 L) =
        measurementCount (signedAdd L.sign L.y L.r (L.carry.take 255)) + 44 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have add := mappedAddLoan_counts 44 roles44 (mappedRead L.y false) L.r (L.carry.take 255)
    L.sign (by simp [mappedRead_length, w.2.2.1, w.2.1])
    (by simp [List.length_take, hw.2.2, w.2.1]) (by simp [List.length_take, hw.2.2])
  constructor <;>
    simp only [signedAddLoan44, signedAdd, addInPlace_eq_mapped, toffoliCount_append,
      measurementCount_append, add.1, add.2] <;> omega

theorem rawLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (rawLoan44 L) = toffoliCount (InverseTailC.raw L) + 44 ∧
    measurementCount (rawLoan44 L) = measurementCount (InverseTailC.raw L) + 44 := by
  have c := signedAddLoan44_counts L hw
  constructor <;>
    simp only [rawLoan44, InverseTailC.raw, toffoliCount_append,
      measurementCount_append, c.1, c.2] <;> omega

theorem correctionLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (correctionLoan44 L) = toffoliCount (InverseTailC.correction L) + 44 ∧
    measurementCount (correctionLoan44 L) = measurementCount (InverseTailC.correction L) + 44 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have sub := mappedSubLoan_counts 44 roles44 (mappedConstant (some L.parity) 256 p) L.r
    (L.carry.take 255) L.one (by simp [mappedConstant_length, w.2.1])
    (by simp [List.length_take, hw.2.2, w.2.1]) (by simp [List.length_take, hw.2.2])
  constructor <;>
    simp only [correctionLoan44, InverseTailC.correction, toffoliCount_append,
      measurementCount_append, sub.1, sub.2] <;> omega

theorem tailProgramLoan44_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (tailProgramLoan44 L) = toffoliCount (InverseTailC.program L) + 132 ∧
    measurementCount (tailProgramLoan44 L) = measurementCount (InverseTailC.program L) + 132 := by
  have d := decisionLoan44_counts L hw
  have r := rawLoan44_counts L hw
  have c := correctionLoan44_counts L hw
  constructor <;>
    simp only [tailProgramLoan44, InverseTailC.program, toffoliCount_append,
      measurementCount_append, d.1, d.2, r.1, r.2, c.1, c.2] <;> omega

/-! ## Physicality -/

theorem tailProgramLoan44_physical (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (tailProgramLoan44 L) := by
  have old := InverseTailC.physical L hw hn
  simp only [InverseTailC.program, InverseTailC.decision, InverseTailC.raw,
    InverseTailC.correction, compareLt, signedAdd, gatePhysical_append] at old
  have chain : GatePhysical (compareChain (some L.sign) L.ylow L.low (L.carry.take 255)
      L.one L.parity) := by tauto
  have add : GatePhysical (addInPlace L.y L.r (L.carry.take 255) L.sign) := by tauto
  have sub : GatePhysical (mappedSub (mappedConstant (some L.parity) 256 p) L.r
      (L.carry.take 255) L.one) := by tauto
  have chainLoan := ctlLoan_physical 44 roles44 (some L.sign) L.ylow L.low
    (L.carry.take 255) L.one L.parity chain
  have addLoan : GatePhysical (mappedAddLoan 44 roles44 (mappedRead L.y false) L.r
      (L.carry.take 255) L.sign) := by
    rw [addInPlace_eq_mapped, mappedAdd_as_sweep] at add
    exact StairLoanSupport.emitLoan_physical 44 roles44 _ _ add
  have subLoan := StairLoanSupport.mappedSubLoan_physical_of_zero 44 roles44
    (mappedConstant (some L.parity) 256 p) L.r (L.carry.take 255) L.one
    (by rw [mappedSubLoan_zero]; exact sub)
  simp only [tailProgramLoan44, decisionLoan44, compareLtLoan44, rawLoan44,
    signedAddLoan44, correctionLoan44, gatePhysical_append]
  tauto

/-! ## Semantic replay on the concrete endpoint cell -/

private theorem carry_away (q : Wire) (hq : q ∈ endpointL.carry.take 255) :
    q ∉ endpointL.y ∧ q ∉ endpointL.r ∧ q ≠ endpointL.sign ∧ q ≠ endpointL.one ∧
      q ≠ endpointL.parity := by
  have hn : endpointL.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have h := List.nodup_iff_count.mp (InverseTailC.inventoryND hn) q
  have hp := List.count_pos_iff.mpr hq
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro hy
    have p := List.count_pos_iff.mpr hy
    simp only [List.count_cons, List.count_append] at h hp p
    omega
  · intro hr
    have p := List.count_pos_iff.mpr hr
    simp only [List.count_cons, List.count_append] at h hp p
    omega
  · intro e
    subst e
    simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h hp
    omega
  · intro e
    subst e
    simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h hp
    omega
  · intro e
    subst e
    simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h hp
    omega

private theorem roleTail44 :
    ∀ q ∈ roles44.take 44, q ∈ (endpointL.carry.take 255).drop (44 + 1) := by
  -- K4-D (replay budget): membership through one bit mask of the carry tail (was a list scan per role)
  have h : (roles44.take 44).all
      (fun q => (StairLoan.maskOf ((endpointL.carry.take 255).drop (44 + 1))).testBit q) = true := by
    decide +kernel
  exact fun q hq => StairLoan.mem_of_maskOf (List.all_eq_true.mp h q hq)

theorem compareLtLoan44_run_eq (s : State) (a b : List Bool)
    (clean : ∀ q ∈ endpointL.carry.take 255, s.basis q = false) :
    run (compareLtLoan44 endpointL) a s =
      run (compareLt (some endpointL.sign) endpointL.ylow endpointL.low
        (endpointL.carry.take 255) endpointL.one endpointL.parity) b s := by
  let L := endpointL
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have w := BalancedCleanup.widths L.toLayout hw
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have inv := InverseTailC.inventoryND hn
  have nd : (L.parity :: L.one :: (L.ylow ++ L.low ++ L.carry.take 255)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp inv q
    simp only [BalancedCleanup.Layout.y, BalancedCleanup.Layout.r,
      List.count_cons, List.count_append, List.count_nil] at h ⊢
    omega
  have ctl : ∀ c ∈ some L.sign,
      c ∉ L.parity :: L.one :: (L.ylow ++ L.low ++ L.carry.take 255) := by
    intro c hc bad
    simp only [Option.mem_some_iff] at hc
    subst c
    have h := List.nodup_iff_count.mp inv L.sign
    have p := List.count_pos_iff.mpr bad
    simp only [BalancedCleanup.Layout.y, BalancedCleanup.Layout.r,
      List.count_cons, List.count_append, List.count_nil,
      beq_self_eq_true, if_true] at h p
    omega
  have oneLowND : (L.one :: L.low).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp nd q
    simp only [List.count_cons, List.count_append] at h ⊢
    omega
  let N := notRegister (L.one :: L.low)
  have zero : measurementCount N = 0 := (notRegister_counts _).2
  have cleanU : ∀ q ∈ L.carry.take 255, (run N [] s).basis q = false := by
    intro q hq
    have away : q ∉ L.one :: L.low := by
      intro bad
      have h := List.nodup_iff_count.mp nd q
      have p1 := List.count_pos_iff.mpr bad
      have p2 := List.count_pos_iff.mpr hq
      simp only [List.count_cons, List.count_append] at h p1 p2
      omega
    change (run (notRegister (L.one :: L.low)) [] s).basis q = false
    rw [notRegister_correct _ oneLowND s []]
    simp only [if_neg away]
    exact clean q hq
  have middle : ∀ x y,
      run (ctlLoan 44 roles44 (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity)
          x (run N [] s) =
        run (compareChain (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity)
          y (run N [] s) := by
    intro x y
    exact ctlLoan_run_eq 44 roles44 (some L.sign) L.ylow L.low (L.carry.take 255) L.one
      L.parity (run N [] s) x y (hw.2.1.trans w.1.symm)
      (by simp [List.length_take, hw.2.2, w.1]) (by simp [List.length_take, hw.2.2])
      nd ctl cleanU roleTail44
  have tail : ∀ x y,
      run N x (run (ctlLoan 44 roles44 (some L.sign) L.ylow L.low (L.carry.take 255)
        L.one L.parity) [] (run N [] s)) =
      run N y (run (ctlLoan 44 roles44 (some L.sign) L.ylow L.low (L.carry.take 255)
        L.one L.parity) [] (run N [] s)) := by
    intro x y
    exact FifthCarry.no_records N zero _ x y
  exact StairLoan.run_sandwich_independent N _ _ N s a b zero middle tail

private theorem prep_keeps_carry (s : State) (m : List Bool) (q : Wire)
    (hq : q ∈ endpointL.carry.take 255) :
    (run (InverseTailC.prep endpointL) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro used
  have member := List.mem_toFinset.mp (InverseTailC.prep_support (L := endpointL) used)
  have away := carry_away q hq
  rcases List.mem_append.mp member with hy | hr
  · exact away.1 hy
  · exact away.2.1 hr

theorem decisionLoan44_run_eq (s : State) (a b : List Bool)
    (clean : ∀ q ∈ endpointL.carry.take 255, s.basis q = false) :
    run (decisionLoan44 endpointL) a s = run (InverseTailC.decision endpointL) b s := by
  let L := endpointL
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have prepZero := (prep_counts L hw).2
  let R : Program := [.CX L.sign L.parity] ++ (InverseTailC.prep L).reverse
  have tailZero : measurementCount R = 0 := by
    simp only [R, measurementCount_append, measurementCount_reverse, prepZero]
    rfl
  have newShape : decisionLoan44 L = InverseTailC.prep L ++ compareLtLoan44 L ++ R := by
    simp only [decisionLoan44, R, List.append_assoc]
  have oldShape : InverseTailC.decision L = InverseTailC.prep L ++
      compareLt (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity ++ R := by
    simp only [InverseTailC.decision, R, List.append_assoc]
  rw [newShape, oldShape]
  have middle : ∀ x y,
      run (compareLtLoan44 L) x (run (InverseTailC.prep L) [] s) =
        run (compareLt (some L.sign) L.ylow L.low (L.carry.take 255) L.one L.parity) y
          (run (InverseTailC.prep L) [] s) := by
    intro x y
    exact compareLtLoan44_run_eq _ x y (fun q hq =>
      (prep_keeps_carry s [] q hq).trans (clean q hq))
  have tail : ∀ x y,
      run R x (run (compareLtLoan44 L) [] (run (InverseTailC.prep L) [] s)) =
        run R y (run (compareLtLoan44 L) [] (run (InverseTailC.prep L) [] s)) := by
    intro x y
    exact FifthCarry.no_records R tailZero _ x y
  exact StairLoan.run_sandwich_independent _ _ _ R s a b prepZero middle tail

theorem rawLoan44_run_eq (s : State) (a b : List Bool)
    (clean : ∀ q ∈ endpointL.carry.take 255, s.basis q = false) :
    run (rawLoan44 endpointL) a s = run (InverseTailC.raw endpointL) b s := by
  let L := endpointL
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have w := BalancedCleanup.widths L.toLayout hw
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have inv := InverseTailC.inventoryND hn
  let A : Program := InverseTailC.double L ++ [.X L.sign] ++ signComplement L.sign L.y
  let R : Program := signComplement L.sign L.y ++ [.X L.sign]
  have newShape : rawLoan44 L = A ++
      mappedAddLoan 44 roles44 (mappedRead L.y false) L.r (L.carry.take 255) L.sign ++ R := by
    simp only [rawLoan44, signedAddLoan44, A, R, List.append_assoc]
  have oldShape : InverseTailC.raw L = A ++
      mappedAdd (mappedRead L.y false) L.r (L.carry.take 255) L.sign ++ R := by
    simp only [InverseTailC.raw, signedAdd, addInPlace_eq_mapped, A, R, List.append_assoc]
  rw [newShape, oldShape]
  have headZero : measurementCount A = 0 := by
    simp only [A, InverseTailC.double, measurementCount_append,
      (rotate_counts L.r).2.2.2, (signComplement_counts _ _).2]
    rfl
  have tailZero : measurementCount R = 0 := by
    simp only [R, measurementCount_append, (signComplement_counts _ _).2]
    rfl
  have ymsbY : L.ymsb ∈ L.y := by simp [BalancedCleanup.Layout.y]
  have rmsbR : L.rmsb ∈ L.r := by simp [BalancedCleanup.Layout.r]
  have cleanA : ∀ q ∈ L.carry.take 255, (run A [] s).basis q = false := by
    intro q hq
    have away := carry_away q hq
    rw [run_preserves_outside A [] s q ?_]
    · exact clean q hq
    intro used
    simp only [A, InverseTailC.double, wires_append, Finset.mem_union] at used
    rcases used with ((cx | rot) | x) | sc
    · simp only [wires, Instr.wires, Finset.union_empty, Finset.mem_insert,
        Finset.mem_singleton] at cx
      rcases cx with e | e
      · exact away.1 (e ▸ ymsbY)
      · exact away.2.1 (e ▸ rmsbR)
    · rw [(rotate_wires L.r).2] at rot
      split_ifs at rot
      · simp at rot
      · exact away.2.1 (List.mem_toFinset.mp rot)
    · simp only [wires, Instr.wires, Finset.union_empty, Finset.mem_singleton] at x
      exact away.2.2.1 x
    · have m := List.mem_toFinset.mp (signComplement_wires_subset _ _ sc)
      rcases List.mem_cons.mp m with e | hy
      · exact away.2.2.1 e
      · exact away.1 hy
  have addND : (L.sign :: (L.r ++ L.carry.take 255)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp inv q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    omega
  have sourceAway : ∀ q ∈ mappedWires (mappedRead L.y false),
      q ∉ L.sign :: (L.r ++ L.carry.take 255) := by
    intro q hq bad
    rw [mappedRead_wires] at hq
    have h := List.nodup_iff_count.mp inv q
    have p := List.count_pos_iff.mpr hq
    have p2 := List.count_pos_iff.mpr bad
    simp only [List.count_cons, List.count_append, List.count_nil] at h p p2
    omega
  have middle : ∀ x y,
      run (mappedAddLoan 44 roles44 (mappedRead L.y false) L.r (L.carry.take 255) L.sign)
          x (run A [] s) =
        run (mappedAdd (mappedRead L.y false) L.r (L.carry.take 255) L.sign) y
          (run A [] s) := by
    intro x y
    exact mappedAddLoan_run_eq 44 roles44 (mappedRead L.y false) L.r (L.carry.take 255)
      L.sign (run A [] s) x y addND sourceAway
      (by simp [mappedRead_length, w.2.2.1, w.2.1])
      (by simp [List.length_take, hw.2.2, w.2.1]) (by simp [List.length_take, hw.2.2])
      cleanA roleTail44
  have tail : ∀ x y,
      run R x (run (mappedAddLoan 44 roles44 (mappedRead L.y false) L.r
        (L.carry.take 255) L.sign) [] (run A [] s)) =
      run R y (run (mappedAddLoan 44 roles44 (mappedRead L.y false) L.r
        (L.carry.take 255) L.sign) [] (run A [] s)) := by
    intro x y
    exact FifthCarry.no_records R tailZero _ x y
  exact StairLoan.run_sandwich_independent A _ _ R s a b headZero middle tail

theorem correctionLoan44_run_eq (s : State) (a b : List Bool)
    (clean : ∀ q ∈ endpointL.carry.take 255, s.basis q = false) :
    run (correctionLoan44 endpointL) a s = run (InverseTailC.correction endpointL) b s := by
  let L := endpointL
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have widths := BalancedCleanup.widths L.toLayout hw
  have hnL : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  let N := signComplement L.ymsb L.r
  have rND : L.r.Nodup := (List.nodup_append'.mp (InverseTailC.yrND hnL)).2.1
  have yAway : L.ymsb ∉ L.r := InverseTailC.ysignAwayR hnL
  have first := signComplement_correct L.ymsb L.r rND yAway s []
  have cleanU : ∀ q ∈ L.carry.take 255, (run N [] s).basis q = false := by
    intro q hq
    exact (first.2.1 q (carry_away q hq).2.1).trans (clean q hq)
  have nd : (L.one :: (L.r ++ L.carry.take 255)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp (InverseTailC.inventoryND hnL) q
    simp only [List.count_cons, List.count_append] at h ⊢
    omega
  have away : ∀ q ∈ mappedWires (mappedConstant (some L.parity) 256 p),
      q ∉ L.one :: (L.r ++ L.carry.take 255) := by
    intro q hq
    have parity := mappedConstant_wires (some L.parity) 256 p q hq
    simp only [Option.mem_some_iff] at parity
    subst q
    intro bad
    have h := List.nodup_iff_count.mp (InverseTailC.inventoryND hnL) L.parity
    have positive := List.count_pos_iff.mpr bad
    simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h positive
    omega
  have zero : measurementCount N = 0 := (signComplement_counts L.ymsb L.r).2
  have middle : ∀ x y,
      run (mappedSubLoan 44 roles44 (mappedConstant (some L.parity) 256 p) L.r
          (L.carry.take 255) L.one) x (run N [] s) =
        run (mappedSub (mappedConstant (some L.parity) 256 p) L.r (L.carry.take 255) L.one)
          y (run N [] s) := by
    intro x y
    exact mappedSubLoan_run_eq 44 roles44 (mappedConstant (some L.parity) 256 p) L.r
      (L.carry.take 255) L.one (run N [] s) x y nd away
      (by rw [mappedConstant_length, widths.2.1])
      (by simp [List.length_take, hw.2.2, widths.2.1]) (by simp [List.length_take, hw.2.2])
      cleanU roleTail44
  have tail : ∀ x y,
      run N x (run (mappedSubLoan 44 roles44 (mappedConstant (some L.parity) 256 p) L.r
          (L.carry.take 255) L.one) [] (run N [] s)) =
      run N y (run (mappedSubLoan 44 roles44 (mappedConstant (some L.parity) 256 p) L.r
          (L.carry.take 255) L.one) [] (run N [] s)) := by
    intro x y
    exact FifthCarry.no_records N zero _ x y
  exact StairLoan.run_sandwich_independent N _ _ N s a b zero middle tail

/-- Independent-tape equality of two programs at one concrete input state. -/
private def RunEqAt (P Q : Program) (s : State) : Prop :=
  ∀ fresh old, run P fresh s = run Q old s

private theorem RunEqAt.append {P Q R S : Program} {s : State}
    (head : RunEqAt P Q s) (tail : RunEqAt R S (run P [] s)) :
    RunEqAt (P ++ R) (Q ++ S) s := by
  intro fresh old
  rw [run_append, run_append]
  have leftMid := (head (fresh.take (measurementCount P)) []).trans
    (head [] []).symm
  have rightMid := head [] (old.take (measurementCount Q))
  calc
    run R (fresh.drop (measurementCount P))
        (run P (fresh.take (measurementCount P)) s) =
      run R (fresh.drop (measurementCount P)) (run P [] s) :=
        congrArg (run R (fresh.drop (measurementCount P))) leftMid
    _ = run S (old.drop (measurementCount Q)) (run P [] s) :=
      tail _ _
    _ = run S (old.drop (measurementCount Q))
        (run Q (old.take (measurementCount Q)) s) :=
      congrArg (run S (old.drop (measurementCount Q))) rightMid

/-- The complete logical multiplication tail with all three sweeps loaned
equals `InverseTailC.program` for independent tapes.  Hypotheses: exactly
those of `StairLoanAdapters.tailProgramLoan68_run_eq` (the record tail frame). -/
theorem tailProgramLoan44_run_eq
    (origin : BasisState) (Y : Int) (hy : Centered Y)
    (hY : regValue endpointL.y origin = encodeWord 256 Y)
    (oneZero : origin endpointL.one = false)
    (carryZero : ∀ q ∈ endpointL.carry.take 255, origin q = false)
    (s : State) (fresh old : List Bool)
    (input : InverseTailC.Frame endpointL origin (encodeWord 256 Y) false s.basis) :
    run (tailProgramLoan44 endpointL) fresh s =
      run (InverseTailC.program endpointL) old s := by
  let L := endpointL
  let D := InverseTailC.decision L
  let D' := decisionLoan44 L
  let R := InverseTailC.raw L
  let R' := rawLoan44 L
  let C := correctionLoan44 L
  let O := InverseTailC.correction L
  let E : Program := [.CX L.r0 L.parity, .CX (L.ylow.headD L.ymsb) L.parity]
  have hw : L.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup
  have carryS : ∀ q ∈ L.carry.take 255, s.basis q = false := fun q hq =>
    (InverseTailC.frame_flag L hn origin _ _ s.basis input q (Or.inr hq)).trans
      (carryZero q hq)
  have decisionEq : RunEqAt D' D s := fun a b => decisionLoan44_run_eq s a b carryS
  have decisionTriple := InverseTailC.decision_triple L hw hn origin Y hy hY
    oneZero carryZero
  let u := run D' [] s
  have uOld : u = run D [] s := decisionEq [] []
  have uFrame : InverseTailC.Frame L origin (encodeWord 256 Y)
      (InverseTailC.reducedFlag (origin L.sign) Y) u.basis := by
    rw [uOld]
    exact (decisionTriple s [] input).2
  have carryU : ∀ q ∈ L.carry.take 255, u.basis q = false := fun q hq =>
    (InverseTailC.frame_flag L hn origin _ _ u.basis uFrame q (Or.inr hq)).trans
      (carryZero q hq)
  have rawEq : RunEqAt R' R u := fun a b => rawLoan44_run_eq u a b carryU
  have rawTriple := InverseTailC.raw_triple L hw hn origin Y hY carryZero
    (InverseTailC.reducedFlag (origin L.sign) Y)
  let v := run R' [] u
  have vOld : v = run R [] u := rawEq [] []
  have vFrame := (rawTriple u [] uFrame).2
  rw [← vOld] at vFrame
  have carryV : ∀ q ∈ L.carry.take 255, v.basis q = false := fun q hq =>
    (InverseTailC.frame_flag L hn origin _ _ v.basis vFrame q (Or.inr hq)).trans
      (carryZero q hq)
  have correctionEq : RunEqAt C O v := fun a b => correctionLoan44_run_eq v a b carryV
  have eraseZero : measurementCount E = 0 := rfl
  have eraseEq : RunEqAt E E (run C [] v) := fun a b =>
    FifthCarry.no_records E eraseZero _ a b
  have correctionErase := RunEqAt.append correctionEq eraseEq
  have rawRest := RunEqAt.append rawEq correctionErase
  have whole := RunEqAt.append decisionEq rawRest
  simpa only [tailProgramLoan44, InverseTailC.program, D, D', R, R', C, O, E,
    List.append_assoc] using whole fresh old

end ECDSAAdd.Entrant.StairEndpointLoan44
end Merge_StairEndpointLoan44Tail_at_QTop

