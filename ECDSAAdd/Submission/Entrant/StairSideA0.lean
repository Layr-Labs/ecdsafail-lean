theorem own_of_paritySwap (P : Program)
    (h : wires (renameProgram (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) P)
      ⊆ callerDomain) : wires P ⊆ callerDomain := by
  apply own_of_renamed _ _ P h
  unfold FrontierEntry1591Field.work FrontierEntry1591Field.host
  exact preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega))

/-- Own support of the record division field. -/
theorem recordEntryField_own : wires Rolling1588.entryField ⊆ callerDomain := by
  have h := Rolling1588.entryFieldHosted_support.trans logical_sub_caller
  unfold Rolling1588.entryFieldHosted ParityField1591.program ParityHostTransport5.program
    FrontierEntry1591Field.hosted at h
