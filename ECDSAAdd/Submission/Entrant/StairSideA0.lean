/-! ### K4-D: `bodyGood_all` -/
namespace K4D

/-- The 18 wires moved by the nine pool swaps of `placeF`. -/
def placeMoved : List Nat :=
  [4881, 5645, 4880, 5646, 4882, 5647, 4885, 5651, 5400, 5652, 5401, 5653, 4884, 5654, 4883, 4890, 4833, 5022]

def PM : Nat := StairLoan.maskOf placeMoved

/-- `placeF` with its pool swaps evaluated. -/
def placeL (z : Nat) : Nat :=
  LT48K.swF 4833 5022 (LT48K.swF 4883 4890 (LT48K.swF 4884 5654 (LT48K.swF 5401 5653 (LT48K.swF 5400 5652
    (LT48K.swF 4885 5651 (LT48K.swF 4882 5647 (LT48K.swF 4880 5646 (LT48K.swF 4881 5645 z))))))))

theorem placeF_eq (x : Nat) : LT48K.placeF x = placeL (LT48K.blockF 202 x) := rfl

theorem placeL_id (z : Nat) (h : PM.testBit z = false) : placeL z = z := by
  have hy := StairLoan.not_mem_of_maskOf h
  simp only [placeMoved, List.mem_cons, List.not_mem_nil, or_false, not_or] at hy
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18⟩ := hy
  unfold placeL
  rw [swF_id 4881 5645 z h1 h2, swF_id 4880 5646 z h3 h4, swF_id 4882 5647 z h5 h6, swF_id 4885 5651 z h7 h8,
    swF_id 5400 5652 z h9 h10, swF_id 5401 5653 z h11 h12, swF_id 4884 5654 z h13 h14,
    swF_id 4883 4890 z h15 h16, swF_id 4833 5022 z h17 h18]

/-- The wires moved by `sqSwap` / `foldPerm`. -/
def bodyIn : List Nat := [4875, 5478, 4834, 5093]

def SM : Nat := StairLoan.maskOf bodyIn

theorem inner_id (x : Nat) (h : SM.testBit x = false) :
    LT48K.swF 4834 5093 (LT48K.swF 4875 5478 x) = x := by
  have hy := StairLoan.not_mem_of_maskOf h
  simp only [bodyIn, List.mem_cons, List.not_mem_nil, or_false, not_or] at hy
  obtain ⟨h1, h2, h3, h4⟩ := hy
  rw [swF_id 4875 5478 x h1 h2, swF_id 4834 5093 x h3 h4]

theorem blockF_R1 (x : Nat) (h : (rM 4630 202).testBit x = true) : LT48K.blockF 202 x = 261 + x := by
  rw [testBit_rM, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at h
  unfold LT48K.blockF
  rw [if_pos h, Nat.add_comm]

theorem blockF_R0 (x : Nat) (h : (rM 4630 202 ||| rM 4891 202).testBit x = false) :
    LT48K.blockF 202 x = x := by
  rw [Nat.testBit_or, Bool.or_eq_false_iff, testBit_rM, testBit_rM] at h
  obtain ⟨h1, h2⟩ := h
  have c1 : ¬(4630 ≤ x ∧ x < 4630 + 202) := fun hc => by
    rw [decide_eq_true hc.1, decide_eq_true hc.2] at h1
    exact absurd h1 (by decide)
  have c2 : ¬(4891 ≤ x ∧ x < 4891 + 202) := fun hc => by
    rw [decide_eq_true hc.1, decide_eq_true hc.2] at h2
    exact absurd h2 (by decide)
  unfold LT48K.blockF
  rw [if_neg c1, if_neg c2]

/-- Body wires checked directly (moved by a swap, or `normFlag`). -/
def bodySpecial : List Nat := [4113, 4761, 4832, 4833, 4834, 4875, 4880, 4881, 4882, 4883, 4884, 4885]

theorem bodySpecial_ok : ∀ x ∈ bodySpecial, LT48K.bodyGoodF x = true := by
  decide +kernel

/-- `bodyGoodF`-good wires: `blockF` image good and not moved by any swap, or one of the checked wires. -/
def ZM : Nat :=
  andNot (((andNot GM (PM ||| UM) >>> 261) &&& rM 4630 202) |||
    andNot (andNot GM (PM ||| UM)) (rM 4630 202 ||| rM 4891 202)) SM ||| StairLoan.maskOf bodySpecial

theorem ZM_sound (x : Nat) (h : ZM.testBit x = true) : LT48K.bodyGoodF x = true := by
  unfold ZM at h
  rw [Nat.testBit_or, Bool.or_eq_true] at h
  rcases h with h | h
  · rw [testBit_andNot, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨hA, hS⟩ := h
    have hz : (andNot GM (PM ||| UM)).testBit (LT48K.blockF 202 x) = true := by
      rw [Nat.testBit_or, Bool.or_eq_true] at hA
      rcases hA with hA | hA
      · rw [Nat.testBit_and, Bool.and_eq_true, Nat.testBit_shiftRight] at hA
        rw [blockF_R1 x hA.2]
        exact hA.1
      · rw [testBit_andNot, Bool.and_eq_true, Bool.not_eq_true'] at hA
        rw [blockF_R0 x hA.2]
        exact hA.1
    rw [testBit_andNot, Bool.and_eq_true, Bool.not_eq_true', Nat.testBit_or, Bool.or_eq_false_iff] at hz
    obtain ⟨hG, hP, hU⟩ := hz
    unfold LT48K.bodyGoodF
    rw [inner_id x hS, placeF_eq, placeL_id _ hP, UGF_id _ hU, ← GM_spec, hG, Bool.or_true]
  · exact bodySpecial_ok x (StairLoan.mem_of_maskOf h)

