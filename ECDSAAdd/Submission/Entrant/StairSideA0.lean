theorem mapped_code_physical (isA : Bool) (f : Fin 10 → Wire)
    (hf : Function.Injective f) :
    GatePhysical
      (renameProgram (MeasuredCodec5.label f) (Rolling1588.codeEncode isA)) ∧
    GatePhysical
      (renameProgram (MeasuredCodec5.label f) (Rolling1588.codeDecode isA)) := by
  have enc : wires (Rolling1588.codeEncode isA) ⊆ Finset.range 10 := by
    simpa only [(Rolling1588.code_support isA).1] using
      (Finset.Subset.refl (Finset.range 10))
  have dec : wires (Rolling1588.codeDecode isA) ⊆ Finset.range 10 := by
    simpa only [(Rolling1588.code_support isA).2] using
      (Finset.Subset.refl (Finset.range 10))
  exact
    ⟨gatePhysical_rename_support _ _
      (fun a ha b hb e =>
        FirstNonzeroCodec.label_inj' f hf a (enc ha) b (enc hb) e)
      (Rolling1588.code_physical isA).1,
    gatePhysical_rename_support _ _
      (fun a ha b hb e =>
        FirstNonzeroCodec.label_inj' f hf a (dec ha) b (dec hb) e)
      (Rolling1588.code_physical isA).2⟩

theorem packFirst_physical (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (isA : Bool) (i : Nat)
    (hi : i < 512) :
    GatePhysical (Rolling1588.Integer.packFirst w isA i) := by
  by_cases first : i = 5
  · subst i
    simp only [Rolling1588.Integer.packFirst, if_pos rfl]
    exact (ParityCodec5New.first_mapped_physical _
      (History5.historyMap_injective w hn 0 (by decide))).1
  · simp only [Rolling1588.Integer.packFirst, if_neg first,
      Rolling1588.Integer.packAfter]
    split
    · have due := History5.packDue_true i ‹History5.packDue i = true›
      have nonzero : i - 5 ≠ 0 := by omega
      simp only [Rolling1588.Integer.encode, if_neg nonzero,
        Rolling1588.encodeAt]
      exact (mapped_code_physical isA _
        (History5.historyMap_injective w hn (i - 5) (by omega))).1
    · simp [GatePhysical]

theorem unpackFirst_physical (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (isA : Bool) (i : Nat)
    (hi : i < 512) :
    GatePhysical (Rolling1588.Integer.unpackFirst w isA i) := by
  by_cases first : i = 5
  · subst i
    simp only [Rolling1588.Integer.unpackFirst, if_pos rfl]
    exact (ParityCodec5New.first_mapped_physical _
      (History5.historyMap_injective w hn 0 (by decide))).2
  · simp only [Rolling1588.Integer.unpackFirst, if_neg first,
      Rolling1588.Integer.decodeBefore]
    split
    · have due := History5.packDue_true i ‹History5.packDue i = true›
