/-- K1 (replay budget): linear bit-mask duplicate scan (`m` holds the wires already seen);
the quadratic `List.Nodup` decision is avoided. -/
def k1nodupMask : List Nat → Nat → Bool
  | [], _ => true
  | x :: xs, m => !(m.testBit x) && k1nodupMask xs (m ||| 2 ^ x)

theorem k1_nodupMask_sound : ∀ (l : List Nat) (m : Nat), k1nodupMask l m = true →
    l.Nodup ∧ ∀ x ∈ l, m.testBit x = false
  | [], _, _ => ⟨List.nodup_nil, fun _ h => absurd h List.not_mem_nil⟩
  | x :: xs, m, h => by
    simp only [k1nodupMask, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨hx, hr⟩ := h
    obtain ⟨nd, av⟩ := k1_nodupMask_sound xs _ hr
    have key : ∀ y ∈ xs, y ≠ x ∧ m.testBit y = false := by
      intro y hy
      have t := av y hy
      rw [Nat.testBit_or, Bool.or_eq_false_iff] at t
      refine ⟨?_, t.1⟩
      rintro rfl
      rw [Nat.testBit_two_pow_self] at t
      exact absurd t.2 (by decide)
    refine ⟨List.nodup_cons.mpr ⟨fun hmem => (key x hmem).1 rfl, nd⟩, ?_⟩
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · exact hx
    · exact (key y hy).2

theorem physicalLayout_nodup : ∀ B ∈ budgets, (physicalLayout B).Nodup B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp only [StairCodec.Layout.Nodup]
  all_goals exact (k1_nodupMask_sound _ 0 (by decide +kernel)).1

/-- The moved first tick sees the unpacked sum rail as its `a` word. -/
theorem physicalLayout_aWord : ∀ B ∈ budgets,
    (W.compactSkywalkTickLayout (segmentMap B) (startFor B)).a =
      StairCodec.reg (physicalLayout B).S B ++ [base 512] := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

