/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareDirectFold_at_QTop` -/
section Merge_StairSquareDirectFold_at_QTop

/-! # LT37 U1: the direct square fold (0 T, 0 M, no pad / overflow wire)

The record folds a 256-bit product source by first copying it into `work`
(`measuredFoldQTq L f = copy ++ qprogTq L.measuredCore p ++ copy`), so the generic adder
`qprogTq` must keep its 256 carries on `foldCarry = pad ++ overflowPad ++ [productHigh, workHigh]`.
For a canonical, unshifted, 256-bit source the copy is unnecessary: run the same generic adder
reading the source directly and use the (clean) `work` register as its carry bank.

`directFoldQTq L f = qprogTq (directCore L f.src) p` has the SAME frame triple as
`measuredFoldQ_frameTq`, the same counts (766 T / 767 M), touches only
`f.src ++ out ++ work ++ [outHigh, cin, modFlag]`, so no wire of `pad`, `overflowPad`,
`productHigh`, `workHigh`, `normFlag`, `sumCarry`, `y`.  Every statement is for a variable
layout / state (re-instantiation of `QCore.qprog_correctTq`). -/

set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareDirectFold
open ECDSAAdd ECDSAAdd.Entrant Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout

/-- The canonical-mod core reading `src` directly, with `work` as its carry bank. -/
def directCore (L : CuccaroStreamedSquareWideLayout) (src : List Wire) : MeasuredCanonicalModLayout :=
  {src:=src,out:=L.core.out,carry:=L.core.work,high:=L.core.outHigh,cin:=L.core.cin,flag:=L.core.modFlag}

/-- The direct fold: `qprogTq` on `directCore`, no source copy. -/
def directFoldQTq (L : CuccaroStreamedSquareWideLayout) (f : MeasuredSquareFold) : Program :=
  qprogTq (directCore L f.src) SquareReduction.p

/-- The only wires a direct fold can touch. -/
def directWires (L : CuccaroStreamedSquareWideLayout) (src : List Wire) : List Wire :=
  src++L.core.out++L.core.work++[L.core.outHigh,L.core.cin,L.core.modFlag]


theorem directCore_widths (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (src : List Wire)
    (hlen : src.length=256) : (directCore L src).Widths 256 :=
  ⟨hlen,hw.core.out,hw.core.work⟩

theorem directCore_nodup (L : CuccaroStreamedSquareWideLayout) (hn : L.wires.Nodup) (src : List Wire)
    (hs : ∀q,src.count q≤L.core.product.count q) : (directCore L src).wires.Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have h := List.nodup_iff_count.mp hn q
  have bound := hs q
  simp only [directCore,MeasuredCanonicalModLayout.wires,CuccaroStreamedSquareWideLayout.wires,
    CuccaroStreamedSquareLayout.wires,List.count_cons,List.count_append,List.count_nil] at h ⊢
  omega

/-! ## Functional contract (same triple as `measuredFoldQ_frameTq`) -/

theorem directFoldQ_correctTq (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (f : MeasuredSquareFold)
    (hs : ∀q,f.src.count q≤L.core.product.count q) (hlen : f.src.length=256)
    (O : Nat) (hO : O<SquareReduction.p) (s : State) (m : List Bool)
    (hA : regValue f.src s.basis<SquareReduction.p)
    (ho : regValue L.core.out s.basis=O) (hc : L.PairClean s.basis) :
    (run (directFoldQTq L f) m s).phase=s.phase ∧
    regValue L.core.out (run (directFoldQTq L f) m s).basis=
      (regValue f.src s.basis+(SquareReduction.p-1-O))%SquareReduction.p ∧
    ∀q,q∉L.core.out → (run (directFoldQTq L f) m s).basis q=s.basis q :=
  QCore.qprog_correctTq (directCore L f.src) 256 SquareReduction.c SquareReduction.p
    (directCore_widths L hw f.src hlen) (directCore_nodup L hn f.src hs) (by decide)
    (by norm_num [SquareReduction.p,SquareReduction.B,SquareReduction.c])
    (by norm_num [SquareReduction.c]) (regValue f.src s.basis) O hA hO s m rfl ho
    hc.outHigh hc.modFlag (fun q hq => (regValue_zero _ _).mp hc.work q hq) hc.cin

theorem directFoldQ_frameTq (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (base : BasisState) (f : MeasuredSquareFold)
    (hv : L.MeasuredFoldView base f) (hcan : f.canonical=true) (hc : L.PairClean base)
    (hlen : f.src.length=256) (hsh : f.shift=0)
    (O : Nat) (hO : O<SquareReduction.p) :
    Triple (SquareFrame L.core.out base O) (directFoldQTq L f)
      (SquareFrame L.core.out base ((measuredFoldPayload base f+(SquareReduction.p-1-O))%SquareReduction.p)) := by
  have away (q : Wire) (hq : q∈f.src) : q∉L.core.out := by
    intro bad
    have h := List.nodup_iff_count.mp hn q
    have a := List.count_pos_iff.mpr hq
    have b := List.count_pos_iff.mpr bad
    have count := hv.count q
    simp only [CuccaroStreamedSquareWideLayout.wires,CuccaroStreamedSquareLayout.wires,List.count_append,
      List.count_cons,List.count_nil] at h
    omega
  intro s m hf
  have source : regValue f.src s.basis=regValue f.src base :=
    regValue_congr _ _ _ (fun q hq => hf.2 q (away q hq))
  have clean := L.squareFrame_clean hn base s.basis O hf hc
  have hA : regValue f.src s.basis<SquareReduction.p := by
    have h := hv.canonical hcan
    rw [hsh,pow_zero,Nat.mul_one] at h
    rw [source]; exact h
  have result := directFoldQ_correctTq L hw hn f hv.count hlen O hO s m hA hf.1 clean
  have pay : measuredFoldPayload base f=regValue f.src s.basis := by
    simp only [measuredFoldPayload,hsh,pow_zero,Nat.mul_one,source]
  refine ⟨result.1,?_,?_⟩
  · rw [pay]; exact result.2.1
  · intro q hq
    exact (result.2.2 q hq).trans (hf.2 q hq)

/-! ## Counts, slots, physicality -/

theorem directFoldQ_countsTq (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (f : MeasuredSquareFold)
    (hlen : f.src.length=256) :
    toffoliCount (directFoldQTq L f)=766 ∧ measurementCount (directFoldQTq L f)=767 := by
  have core := QCore.qprog_countsTq (directCore L f.src) 256 SquareReduction.p
    (directCore_widths L hw f.src hlen) (by decide)
  unfold directFoldQTq
  rw [core.1,core.2]
  exact ⟨by norm_num,by norm_num⟩

theorem directFoldQ_counts_eq (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (f : MeasuredSquareFold)
    (hlen : f.src.length=256) :
    toffoliCount (directFoldQTq L f)=toffoliCount (measuredFoldQTq L f) ∧
    measurementCount (directFoldQTq L f)=measurementCount (measuredFoldQTq L f) := by
  have a := directFoldQ_countsTq L hw f hlen
  have b := measuredFoldQ_countsTq L hw f
  exact ⟨a.1.trans b.1.symm,a.2.trans b.2.symm⟩



theorem directFoldQ_physicalTq (L : CuccaroStreamedSquareWideLayout) (hn : L.wires.Nodup) (f : MeasuredSquareFold)
    (hs : ∀q,f.src.count q≤L.core.product.count q) : GatePhysical (directFoldQTq L f) :=
  QCore.qprog_physicalTq _ _ (directCore_nodup L hn f.src hs)

/-! ## Support and avoidance -/

theorem directFoldQ_supportTq (L : CuccaroStreamedSquareWideLayout) (f : MeasuredSquareFold) :
    ECDSAAdd.wires (directFoldQTq L f)⊆(directWires L f.src).toFinset :=
  QCore.qprog_supportTq (directCore L f.src) SquareReduction.p


theorem directFoldQ_avoid (L : CuccaroStreamedSquareWideLayout) (f : MeasuredSquareFold) (q : Wire)
    (hq : q∉directWires L f.src) : q∉ECDSAAdd.wires (directFoldQTq L f) :=
  fun h => hq (List.mem_toFinset.mp (directFoldQ_supportTq L f h))

/-- The wires a direct fold never touches (for a source inside `product`). -/
def directFree (L : CuccaroStreamedSquareWideLayout) : List Wire :=
  L.core.y++L.core.pad++L.overflowPad++
    [L.core.productHigh,L.core.workHigh,L.core.normFlag,L.core.sumCarry]

theorem directFoldQ_free (L : CuccaroStreamedSquareWideLayout) (hn : L.wires.Nodup) (f : MeasuredSquareFold)
    (hs : ∀q,f.src.count q≤L.core.product.count q) :
    ∀q∈directFree L,q∉ECDSAAdd.wires (directFoldQTq L f) := by
  intro q hq
  apply directFoldQ_avoid
  intro bad
  have h := List.nodup_iff_count.mp hn q
  have a := List.count_pos_iff.mpr hq
  have b := List.count_pos_iff.mpr bad
  have c := hs q
  simp only [directFree,directWires,CuccaroStreamedSquareWideLayout.wires,CuccaroStreamedSquareLayout.wires,
    List.count_append,List.count_cons,List.count_nil] at h a b
  omega

/-- Parametric hole avoidance: any hole list inside `overflowPad` (or `pad`) is avoided. -/
theorem directFoldQ_holes (L : CuccaroStreamedSquareWideLayout) (hn : L.wires.Nodup) (f : MeasuredSquareFold)
    (hs : ∀q,f.src.count q≤L.core.product.count q) (holes : List Wire)
    (hh : ∀q∈holes,q∈L.foldPad) : ∀q∈holes,q∉ECDSAAdd.wires (directFoldQTq L f) := by
  intro q hq
  apply directFoldQ_free L hn f hs
  have h := hh q hq
  simp only [directFree,CuccaroStreamedSquareWideLayout.foldPad,List.mem_append] at h ⊢
  tauto

/-! ## Lower bounds: every wire of a direct fold is a wire of the record fold, or `cin` -/

theorem copyRegister_none_lower (a b : List Wire) (hl : a.length=b.length) :
    ∀q∈a++b,q∈ECDSAAdd.wires (copyRegister none a b) := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => intro q hq; simp at hq
    | cons _ _ => simp at hl
  | cons x xs ih =>
    cases b with
    | nil => simp at hl
    | cons y ys =>
      have ih' := ih ys (by simpa using hl)
      intro q hq
      simp only [copyRegister,wires_append]
      simp only [List.cons_append,List.mem_cons,List.mem_append] at hq
      rcases hq with rfl|hq|rfl|hq
      · exact Finset.mem_union_left _ (by simp [ECDSAAdd.wires,Instr.wires,copyGate])
      · exact Finset.mem_union_right _ (ih' q (List.mem_append_left _ hq))
      · exact Finset.mem_union_left _ (by simp [ECDSAAdd.wires,Instr.wires,copyGate])
      · exact Finset.mem_union_right _ (ih' q (List.mem_append_right _ hq))

theorem notRegister_lower (r : List Wire) : ∀q∈r,q∈ECDSAAdd.wires (notRegister r) := by
  induction r with
  | nil => intro q hq; simp at hq
  | cons x xs ih =>
    intro q hq
    show q∈ECDSAAdd.wires (Instr.X x::notRegister xs)
    simp only [ECDSAAdd.wires,Instr.wires,Finset.mem_union,Finset.mem_singleton]
    rcases List.mem_cons.mp hq with rfl|hq
    · exact Or.inl rfl
    · exact Or.inr (ih q hq)

theorem qprogTq_lower (K : MeasuredCanonicalModLayout) (p : Nat) :
    ∀q∈K.out++[K.high,K.flag],q∈ECDSAAdd.wires (qprogTq K p) := by
  intro q hq
  have hx : ∀u∈[K.high,K.flag],u∈ECDSAAdd.wires [Instr.CX K.high K.flag,Instr.X K.flag] := by
    intro u hu
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hu
    rcases hu with rfl|rfl <;> simp [ECDSAAdd.wires,Instr.wires]
  simp only [List.mem_append] at hq
  rcases hq with hq|hq
  · have h := notRegister_lower _ q hq
    simp only [qprogTq,wires_append,Finset.mem_union]
    tauto
  · have h := hx q hq
    simp only [qprogTq,wires_append,Finset.mem_union]
    tauto

theorem measuredFoldQ_lower (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (f : MeasuredSquareFold)
    (hlen : f.src.length=256) (hsh : f.shift=0) :
    ∀q∈f.src++L.core.work++L.core.out++[L.core.outHigh,L.core.modFlag],
      q∈ECDSAAdd.wires (measuredFoldQTq L f) := by
  have dst : L.foldDestination f=L.core.work := by
    simp only [foldDestination,hsh,List.drop_zero,hlen]
    exact List.take_of_length_le (le_of_eq hw.core.work)
  have cp := copyRegister_none_lower f.src (L.foldDestination f) (by rw [dst,hlen,hw.core.work])
  have qp := qprogTq_lower L.measuredCore SquareReduction.p
  intro q hq
  simp only [List.mem_append] at hq
  have hcp : q∈f.src ∨ q∈L.core.work → q∈ECDSAAdd.wires (copyRegister none f.src (L.foldDestination f)) := by
    intro h
    rcases h with h|h
    · exact cp q (List.mem_append_left _ h)
    · exact cp q (List.mem_append_right _ (by rw [dst]; exact h))
  have hqp : q∈L.core.out ∨ q∈[L.core.outHigh,L.core.modFlag] →
      q∈ECDSAAdd.wires (qprogTq L.measuredCore SquareReduction.p) := by
    intro h
    rcases h with h|h
    · exact qp q (List.mem_append_left _ h)
    · exact qp q (List.mem_append_right _ h)
  simp only [measuredFoldQTq,wires_append,Finset.mem_union]
  tauto

/-- Every wire of the direct fold is a wire of the record fold, or the shared `cin`. -/
theorem directFoldQ_sub_measured (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (f : MeasuredSquareFold)
    (hlen : f.src.length=256) (hsh : f.shift=0) :
    ECDSAAdd.wires (directFoldQTq L f)⊆insert L.core.cin (ECDSAAdd.wires (measuredFoldQTq L f)) := by
  intro q hq
  have h := directFoldQ_supportTq L f hq
  have low := measuredFoldQ_lower L hw f hlen hsh q
  simp only [directWires,List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at h low
  rw [Finset.mem_insert]
  tauto

/-! ## The three folds actually used by the square (negP, rot128F, negRot) -/

theorem negP_count (L : CuccaroStreamedSquareWideLayout) (q : Wire) :
    (negP L).src.count q≤L.core.product.count q :=
  (List.take_sublist 256 _).count_le q

theorem rotated128_count (L : CuccaroStreamedSquareWideLayout) (q : Wire) :
    L.rotated128.count q≤L.core.product.count q := by
  have he := congrArg (List.count q) (List.take_append_drop 128 L.core.product)
  have ht := (List.take_sublist 128 (L.core.product.drop 128)).count_le q
  simp only [CuccaroStreamedSquareWideLayout.rotated128,List.count_append] at he ⊢
  omega

theorem rot128F_count (L : CuccaroStreamedSquareWideLayout) (q : Wire) :
    (rot128F L).src.count q≤L.core.product.count q := rotated128_count L q

theorem negRot_count (L : CuccaroStreamedSquareWideLayout) (q : Wire) :
    (negRot L).src.count q≤L.core.product.count q := rotated128_count L q

theorem negP_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (negP L).src.length=256 := by
  simp only [negP,List.length_take,hw.core.product]; omega

theorem rotated128_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : L.rotated128.length=256 := by
  simp only [CuccaroStreamedSquareWideLayout.rotated128,List.length_append,List.length_take,List.length_drop,
    hw.core.product]
  omega

theorem rot128F_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (rot128F L).src.length=256 :=
  rotated128_length L hw

theorem negRot_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (negRot L).src.length=256 :=
  rotated128_length L hw


end ECDSAAdd.Entrant.StairSquareDirectFold
end Merge_StairSquareDirectFold_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareDirectSlots_at_QTop` -/
section Merge_StairSquareDirectSlots_at_QTop

/-! # LT37: exact gate slots of the direct fold

`gateSlots (directFoldQTq L f) + 512 = gateSlots (measuredFoldQTq L f)`: the direct fold is the record fold minus its
two 256-gate source copies.  Proof: `qprogTq` is natural under any wire renaming (`qprogTq_natural`), gate slots are
rename-invariant (`Baselines.rename_gateSlots`), and renaming every wire to `0` makes two cores of equal width equal. -/

set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace ECDSAAdd.Entrant.StairSquareDirectFold
open ECDSAAdd ECDSAAdd.Entrant Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout

/-- Rename every wire of a canonical-mod core. -/
def mapCore (f : Wire → Wire) (K : MeasuredCanonicalModLayout) : MeasuredCanonicalModLayout :=
  {src:=K.src.map f,out:=K.out.map f,carry:=K.carry.map f,high:=f K.high,cin:=f K.cin,flag:=f K.flag}

theorem mappedConstant_natural (f : Wire → Wire) (c : Option Wire) (n k : Nat) :
    (mappedConstant c n k).map (FieldRename.mapBit f)=mappedConstant (c.map f) n k := by
  induction n generalizing k with
  | zero => rfl
  | succ n ih =>
    simp only [mappedConstant,List.map_cons,ih]
    congr 1
    cases c <;> by_cases h : k%2=1 <;> simp [mappedConstantBit,FieldRename.mapBit,h]

theorem borrowMajority_natural (f : Wire → Wire) (a b c d : Wire) :
    renameProgram f (borrowMajority a b c d)=borrowMajority (f a) (f b) (f c) (f d) := rfl

theorem eraseBorrow_natural (f : Wire → Wire) (a b c d : Wire) :
    renameProgram f (eraseBorrow a b c d)=eraseBorrow (f a) (f b) (f c) (f d) := rfl

theorem eraseLtChain_natural (f : Wire → Wire) (a b carry : List Wire) (cin t : Wire) :
    renameProgram f (eraseLtChain a b carry cin t)=
      eraseLtChain (a.map f) (b.map f) (carry.map f) (f cin) (f t) := by
  induction a generalizing b carry cin with
  | nil => simp [eraseLtChain,renameProgram]
  | cons x xs ih =>
    cases xs with
    | nil =>
      cases b with
      | nil => simp [eraseLtChain,renameProgram]
      | cons y ys =>
        cases ys with
        | nil =>
          simp only [eraseLtChain,List.map_cons,List.map_nil]
          exact eraseBorrow_natural f x y cin t
        | cons y' ys => simp [eraseLtChain,renameProgram]
    | cons x' xs =>
      cases b with
      | nil => simp [eraseLtChain,renameProgram]
      | cons y ys =>
        cases ys with
        | nil => simp [eraseLtChain,renameProgram]
        | cons y' ys =>
          cases carry with
          | nil => simp [eraseLtChain,renameProgram]
          | cons c cs =>
            simp only [eraseLtChain,List.map_cons,FieldRename.rename_append,borrowMajority_natural,
              eraseBorrow_natural,ih]
            try rfl

theorem qprogTq_natural (f : Wire → Wire) (K : MeasuredCanonicalModLayout) (p : Nat) :
    renameProgram f (qprogTq K p)=qprogTq (mapCore f K) p := by
  have hs : renameProgram f K.sum=(mapCore f K).sum := by
    simp only [MeasuredCanonicalModLayout.sum,FieldRename.mappedAdd_natural,MeasuredCanonicalModLayout.extended,
      mapCore,List.map_append,List.map_cons,List.map_nil]
    congr 1
    simp [mappedRead,FieldRename.mapBit,List.map_map,Function.comp_def]
  have hc : renameProgram f (mappedConstAdd (some K.flag) K.out (K.carry.take (K.out.length-1)) K.cin p)=
      mappedConstAdd (some (f K.flag)) (K.out.map f) ((K.carry.map f).take ((K.out.map f).length-1)) (f K.cin) p := by
    simp only [mappedConstAdd,FieldRename.mappedAdd_natural,mappedConstant_natural,List.length_map,List.map_take,
      Option.map_some]
  have he := eraseLtChain_natural f K.out K.src (K.carry.take (K.out.length-1)) K.cin K.flag
  simp only [qprogTq,FieldRename.rename_append,FieldRename.notRegister_natural,hs,hc,he]
  simp only [mapCore,List.map_take,List.length_map]
  try rfl

theorem map_zero_eq (l : List Wire) : l.map (fun _ => (0:Wire))=List.replicate l.length 0 := by
  induction l with
  | nil => rfl
  | cons x xs ih => simp [ih,List.replicate_succ]

/-- Two canonical-mod cores of the same width have programs with the same gate slots. -/
theorem qprogTq_gateSlots_eq (K K' : MeasuredCanonicalModLayout) (n p : Nat)
    (hw : K.Widths n) (hw' : K'.Widths n) :
    Challenge.gateSlots (qprogTq K p)=Challenge.gateSlots (qprogTq K' p) := by
  have a := Baselines.rename_gateSlots (fun _ => (0:Wire)) (qprogTq K p)
  have b := Baselines.rename_gateSlots (fun _ => (0:Wire)) (qprogTq K' p)
  rw [qprogTq_natural] at a b
  have e : mapCore (fun _ => (0:Wire)) K=mapCore (fun _ => (0:Wire)) K' := by
    simp only [mapCore,map_zero_eq,hw.src,hw.out,hw.carry,hw'.src,hw'.out,hw'.carry]
  rw [← a,← b,e]

/-- EXACT: the direct fold is the record fold minus its two 256-gate copies. -/
theorem directFoldQ_slots (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (f : MeasuredSquareFold)
    (hlen : f.src.length=256) (hsh : f.shift=0) :
    Challenge.gateSlots (directFoldQTq L f)+512=Challenge.gateSlots (measuredFoldQTq L f) := by
  have e := qprogTq_gateSlots_eq (directCore L f.src) L.measuredCore 256 SquareReduction.p
    (directCore_widths L hw f.src hlen) (L.measuredCore_widths hw)
  have hd : (L.foldDestination f).length=256 := by
    simp [foldDestination,hsh,hlen,hw.core.work]
  simp only [directFoldQTq,measuredFoldQTq,Challenge.gateSlots_append,Baselines.copyRegister_gateSlots,hd,hlen,e]
  omega

end ECDSAAdd.Entrant.StairSquareDirectFold
end Merge_StairSquareDirectSlots_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareHolesCore_at_QTop` -/
section Merge_StairSquareHolesCore_at_QTop

/-! # LT31: time-local hole hosting by a list of wire swaps (0 T)

`hostRename pairs P` renames `P` by the swaps `(hole, host)` of `pairs`, applied right to left.
This generalises the record's single swap `R2SqEp760.bodySwap` (`poolWire 760 ↔ poolWire 1363`) to an arbitrary
list of (hole, host) pairs. Everything is stated for variable programs and states. -/

open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Arithmetic

namespace ECDSAAdd.Entrant.StairSquareHolesCore

/-- Rename by the swaps of `pairs` (each pair = (hole, host)). -/
def hostRename : List (Wire × Wire) → Program → Program
  | [], P => P
  | ab :: rest, P => renameProgram (Equiv.swap ab.1 ab.2) (hostRename rest P)

def holesOf (pairs : List (Wire × Wire)) : List Wire := pairs.map Prod.fst
def hostsOf (pairs : List (Wire × Wire)) : List Wire := pairs.map Prod.snd

theorem hostRename_counts (pairs : List (Wire × Wire)) (P : Program) :
    toffoliCount (hostRename pairs P) = toffoliCount P ∧
      measurementCount (hostRename pairs P) = measurementCount P := by
  induction pairs with
  | nil => exact ⟨rfl, rfl⟩
  | cons ab rest ih =>
    simp only [hostRename]
    rw [(renameProgram_counts _ _).1, (renameProgram_counts _ _).2]
    exact ih

theorem hostRename_slots (pairs : List (Wire × Wire)) (P : Program) :
    Challenge.gateSlots (hostRename pairs P) = Challenge.gateSlots P := by
  induction pairs with
  | nil => rfl
  | cons ab rest ih =>
    simp only [hostRename]
    rw [Baselines.rename_gateSlots]
    exact ih

theorem hostRename_physical (pairs : List (Wire × Wire)) (P : Program) (h : GatePhysical P) :
    GatePhysical (hostRename pairs P) := by
  induction pairs with
  | nil => exact h
  | cons ab rest ih =>
    exact gatePhysical_rename _ (Equiv.swap ab.1 ab.2).injective _ ih

/-- Run equality: every hole and host is zero at entry, every hole is zero at exit, and no host is
used by `P` (so it stays zero). No disjointness of the pairs is needed. -/
theorem hostRename_run_eq (pairs : List (Wire × Wire)) (P : Program) (s : State) (m : List Bool)
    (holeIn : ∀ ab ∈ pairs, s.basis ab.1 = false) (hostIn : ∀ ab ∈ pairs, s.basis ab.2 = false)
    (holeOut : ∀ ab ∈ pairs, (run P m s).basis ab.1 = false)
    (hostFree : ∀ ab ∈ pairs, ab.2 ∉ wires P) :
    run (hostRename pairs P) m s = run P m s := by
  induction pairs with
  | nil => rfl
  | cons ab rest ih =>
    have ih' := ih (fun x hx => holeIn x (List.mem_cons_of_mem _ hx))
      (fun x hx => hostIn x (List.mem_cons_of_mem _ hx))
      (fun x hx => holeOut x (List.mem_cons_of_mem _ hx))
      (fun x hx => hostFree x (List.mem_cons_of_mem _ hx))
    simp only [hostRename]
    have hb : (run P m s).basis ab.2 = false :=
      (run_preserves_outside P m s ab.2 (hostFree ab (List.mem_cons_self))).trans
        (hostIn ab (List.mem_cons_self))
    rw [← ih']
    apply JointInverse1588.rebind_swap_run ab.1 ab.2 _ s m (holeIn ab (List.mem_cons_self))
      (hostIn ab (List.mem_cons_self))
    · rw [ih']; exact holeOut ab (List.mem_cons_self)
    · rw [ih']; exact hb

/-- Support: the renamed program avoids every hole and adds at most the hosts, provided the 2n wires of
`pairs` are pairwise distinct and no host is used by `P`. -/
theorem hostRename_support (pairs : List (Wire × Wire)) (P : Program)
    (hnd : (holesOf pairs ++ hostsOf pairs).Nodup)
    (hostFree : ∀ ab ∈ pairs, ab.2 ∉ wires P) :
    wires (hostRename pairs P) ⊆
      (wires P \ (holesOf pairs).toFinset) ∪ (hostsOf pairs).toFinset := by
  induction pairs with
  | nil => intro x hx; simp only [hostRename] at hx; simp [holesOf, hostsOf, hx]
  | cons ab rest ih =>
    obtain ⟨a, b⟩ := ab
    simp only [holesOf, hostsOf, List.map_cons, List.cons_append] at hnd
    obtain ⟨ha, h1⟩ := List.nodup_cons.mp hnd
    obtain ⟨hb, hnd'⟩ := List.nodup_cons.mp (List.nodup_middle.mp h1)
    have ih' := ih hnd' (fun x hx => hostFree x (List.mem_cons_of_mem _ hx))
    have bOut : b ∉ hostsOf rest := fun h => hb (List.mem_append_right _ h)
    have bNot : b ∉ wires (hostRename rest P) := by
      intro hb
      rcases Finset.mem_union.mp (ih' hb) with h | h
      · exact hostFree (a, b) List.mem_cons_self (Finset.mem_sdiff.mp h).1
      · exact bOut (List.mem_toFinset.mp h)
    intro x hx
    simp only [hostRename, renameProgram_support, Finset.mem_image] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    by_cases ya : y = a
    · subst ya
      simp [Equiv.swap_apply_left, hostsOf]
    · by_cases yb : y = b
      · exact absurd (yb ▸ hy) bNot
      · rw [Equiv.swap_apply_of_ne_of_ne ya yb]
        rcases Finset.mem_union.mp (ih' hy) with h | h
        · obtain ⟨h1, h2⟩ := Finset.mem_sdiff.mp h
          apply Finset.mem_union_left
          refine Finset.mem_sdiff.mpr ⟨h1, ?_⟩
          simp only [holesOf, List.map_cons, List.toFinset_cons, Finset.mem_insert, not_or]
          exact ⟨ya, by simpa [holesOf] using h2⟩
        · apply Finset.mem_union_right
          simp only [hostsOf, List.map_cons, List.toFinset_cons, Finset.mem_insert]
          exact Or.inr (by simpa [hostsOf] using h)

/-- Avoidance form. -/
theorem hostRename_avoids (pairs : List (Wire × Wire)) (P : Program)
    (hnd : (holesOf pairs ++ hostsOf pairs).Nodup)
    (hostFree : ∀ ab ∈ pairs, ab.2 ∉ wires P) :
    ∀ q ∈ holesOf pairs, q ∉ wires (hostRename pairs P) := by
  intro q hq hw
  rcases Finset.mem_union.mp (hostRename_support pairs P hnd hostFree hw) with h | h
  · exact (Finset.mem_sdiff.mp h).2 (List.mem_toFinset.mpr hq)
  · have := List.nodup_append.mp hnd
    exact this.2.2 q hq q (List.mem_toFinset.mp h) rfl

/-- Time-local form: rename only the middle segment `X` of `A ++ X ++ B`. -/
theorem hostRename_mid_run_eq (pairs : List (Wire × Wire)) (A X B : Program) (s : State) (m : List Bool)
    (holeIn : ∀ ab ∈ pairs, (run A (m.take (measurementCount A)) s).basis ab.1 = false)
    (hostIn : ∀ ab ∈ pairs, (run A (m.take (measurementCount A)) s).basis ab.2 = false)
    (holeOut : ∀ ab ∈ pairs,
      (run X ((m.drop (measurementCount A)).take (measurementCount X))
        (run A (m.take (measurementCount A)) s)).basis ab.1 = false)
    (hostFree : ∀ ab ∈ pairs, ab.2 ∉ wires X) :
    run (A ++ hostRename pairs X ++ B) m s = run (A ++ X ++ B) m s := by
  have mc := (hostRename_counts pairs X).2
  simp only [run_append, measurementCount_append, mc]
  congr 1
  have e1 : List.take (measurementCount A) (List.take (measurementCount A + measurementCount X) m) =
      List.take (measurementCount A) m := by rw [List.take_take]; congr 1; omega
  have e2 : List.drop (measurementCount A) (List.take (measurementCount A + measurementCount X) m) =
      List.take (measurementCount X) (List.drop (measurementCount A) m) := by
    rw [List.drop_take]; congr 1; omega
  rw [e1, e2]
  exact hostRename_run_eq pairs X _ _ holeIn hostIn holeOut hostFree

end ECDSAAdd.Entrant.StairSquareHolesCore
end Merge_StairSquareHolesCore_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSqLoopA_at_QTop` -/
section Merge_StairSqLoopA_at_QTop

/-! # LT38 / U2a: hole-free A loop

The record's A loop `A109SignResearch.loop` keeps 109 cached carries on the cache hosts.  The record also proves
that its NON-cached form `F ++ M ++ (I ++ clear ++ tail)` is run-equal to the plain loop
(`A109Research.plain_loop`).  The non-cached loop never touches the 103 hosts `ReorderedAFixed.hosts`, which are zero
at loop entry, so the hole sites can be renamed onto them for the whole loop (`StairSquareHolesCore.hostRename`).
Cost: +112 Toffoli (the cache saves 109 + 3), same measurements. -/

section
open ECDSAAdd ECDSAAdd.Entrant
namespace ECDSAAdd.Entrant.StairSqLoopA
open Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout ReorderedAFixed A161Low4Ghost
 ControlLoan1589BFFold InverseCarryDevelop ThirdSavedCarryDevelop ManyACarryDevelop
set_option autoImplicit false
set_option linter.unusedVariables false
set_option Elab.async false
set_option maxRecDepth 100000
