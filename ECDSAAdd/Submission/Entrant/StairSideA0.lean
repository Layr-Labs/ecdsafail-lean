    allSites (fun x => goodNat (lowPlace x)) P = true := by
  apply allSites_of_goodB
  have e : (fun x => StairPhysicalLayout.goodB (lowPlace x)) = fun x => k6sp_goodB (k6sp_lowB x) :=
    funext k6sp_low_eq
