/-- K6 (replay budget): Boolean form of `RowFacts` (bit masks, `nodupMask`), sound for every `B`. -/
def k6RB (B : Nat) : Bool :=
  Nat.ble 3 B && Nat.ble B 87 &&
  StairLoan.nodupMask (moveSites (unrelocPairs B)) 0 &&
  decide (restLetters B = (List.range (B - 1)).map (physicalLayout B).S) &&
  StairLoan.nodupMask (restLetters B) 0 &&
  (restLetters B).all (fun q => (StairLoan.maskOf (futurePayload B)).testBit q) &&
  !(StairLoan.maskOf (moveSites (unrelocPairs B))).testBit ((physicalLayout B).D (B - 2)) &&
  (List.range B).all (fun i => (StairLoan.maskOf (rowSites B)).testBit ((physicalLayout B).D i) &&
    !(StairLoan.maskOf (futurePayload B)).testBit ((physicalLayout B).D i)) &&
  ((StairLoan.maskOf (rowSites B)).testBit ((physicalLayout B).S (B - 1)) &&
    (!(StairLoan.maskOf (futurePayload B)).testBit ((physicalLayout B).S (B - 1)) &&
    !(StairLoan.maskOf (moveSites (unrelocPairs B))).testBit ((physicalLayout B).S (B - 1)))) &&
  StairLoan.nodupMask (aReg B) 0 &&
  (aReg B).all (fun q => (StairLoan.maskOf (futurePayload B)).testBit q &&
    (!(StairLoan.maskOf (restLetters B)).testBit q &&
    !(StairLoan.maskOf (moveSites (unrelocPairs B))).testBit q)) &&
  (cleanList B).all (fun q => !(StairLoan.maskOf (moveSites (unrelocPairs B))).testBit q &&
    (!(StairLoan.maskOf (restLetters B)).testBit q && (!(StairLoan.maskOf (aReg B)).testBit q &&
    ((StairLoan.maskOf (futurePayload B)).testBit q || ((StairLoan.maskOf (rowSites B)).testBit q &&
      !(StairLoan.maskOf (futurePayload B)).testBit q)))))

theorem k6RB_sound (B : Nat) (h : k6RB B = true) : RowFacts B := by
  simp only [k6RB, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', List.all_eq_true,
    StairLoan.testBit_maskOf, Nat.ble_eq, decide_eq_true_eq, decide_eq_false_iff_not] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩, h10⟩, h11⟩, h12⟩ := h
  exact ⟨h1, h2, (StairLoan.nodupMask_sound _ 0 h3).1, h4, (StairLoan.nodupMask_sound _ 0 h5).1, h6,
    h7, fun i hi => h8 i (List.mem_range.mpr hi), h9, (StairLoan.nodupMask_sound _ 0 h10).1, h11, h12⟩

theorem rowFacts : ∀ B ∈ budgets, RowFacts B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact k6RB_sound _ (by decide +kernel)

/-! ## Unrelocation -/

section
variable (B : Nat) (hR : RowFacts B) (x : Nat)




