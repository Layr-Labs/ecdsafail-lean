theorem regValue_congr' : ∀ (r : List Wire) (a b : BasisState), (∀ q ∈ r, a q = b q) →
    regValue r a = regValue r b := by
  intro r
  induction r with
  | nil => intro a b _; rfl
  | cons w r ih =>
    intro a b h
    simp only [regValue, List.foldr] at ih ⊢
    rw [h w (by simp), ih a b (fun q hq => h q (by simp [hq]))]


theorem block_disjoint (q : Wire) (hq : q ∈ wireBlock base 770 256) : q ∉ wireBlock base 2056 256 := by
  intro hn
  simp only [wireBlock, List.mem_map, List.mem_range'_1] at hq hn
  obtain ⟨i, hi, rfl⟩ := hq
  obtain ⟨j, hj, e⟩ := hn
  have := base_injective e
  omega

/-- The division kernel input is a skywalk arithmetic input (numerator
`centerWord (Y/2)`). -/
theorem entryInput {t : State} (F : StairConcreteAssembly.EntryFrame t) :
    SkywalkArithmeticInput base F.x (centerWord (F.Y / 2)) t.basis := by
  obtain ⟨hdiv, -, hzero⟩ := F.input
  refine ⟨?_, F.numerator, ?_⟩
  · rw [← hdiv]
    exact regValue_congr' _ _ _ (fun q hq => F.outsideNumerator q (block_disjoint q hq))
  · intro q hq h1 h2
    rw [F.outsideNumerator q h2]
    exact hzero q hq h1 h2

/-- Phase-site zeros of the input. -/
theorem entry_zero {t : State} (F : StairConcreteAssembly.EntryFrame t) (l : Nat)
    (hl : l < 2314) (h1 : ¬(770 ≤ l ∧ l < 1026)) (h2 : ¬(2056 ≤ l ∧ l < 2312)) :
    t.basis (base l) = false := by
  have hin := entryInput F
  apply hin.2.2
  · simp only [skywalkSharedWires, wireBlock, List.mem_map, List.mem_range'_1]
    exact ⟨l, ⟨by omega, by omega⟩, rfl⟩
  · simp only [skywalkArithmeticDivisor, wireBlock, List.mem_map, List.mem_range'_1]
    rintro ⟨i, hi, e⟩
    have := base_injective e
    omega
  · simp only [skywalkArithmeticNumerator, wireBlock, List.mem_map, List.mem_range'_1]
    rintro ⟨i, hi, e⟩
    have := base_injective e
    omega

theorem pull_phaseHost_entry {t : State} (F : StairConcreteAssembly.EntryFrame t) :
    pullState Rolling1588Lifetime.phaseHost t = t := by
  have z (l : Nat) (hl : l = 720 ∨ l = 721 ∨ l = 722 ∨ l = 1026 ∨ l = 1541 ∨ l = 1542) :
      t.basis (base l) = false := by
    apply entry_zero F l <;> omega
  apply State.extensionality
  · rfl
  · funext q
    show t.basis (Rolling1588Lifetime.phaseHost q) = t.basis q
    simp only [Rolling1588Lifetime.phaseHost, Equiv.trans_apply, Equiv.swap_apply_def]
    split_ifs <;> subst_vars <;>
      first
      | rfl
      | (rw [z 720 (by omega), z 1542 (by omega)])
      | (rw [z 721 (by omega), z 1026 (by omega)])
      | (rw [z 722 (by omega), z 1541 (by omega)])
