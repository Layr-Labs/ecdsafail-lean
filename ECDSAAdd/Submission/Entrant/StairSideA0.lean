section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairExitLT24Term

open ECDSAAdd Arithmetic MappedCompressed Secp256k1 OB5
open Rolling1588.Integer

attribute [local irreducible] run wires toffoliCount measurementCount Challenge.gateSlots Rolling1588.forward Rolling1588.reverse Rolling1588.Integer.forward

/-- Record carries are clean at every stage. -/
theorem stage_carry (x i : Nat) (hi : i < 512) (b : BasisState)
    (h : Rolling1588.Integer.Stage base true x p i b) (k : Nat) (hk : k < 257)
    (hl : 1027 + i ≤ 1540 + k) : b (base (1540 + k)) = false := by
  obtain ⟨raw, hraw, rfl⟩ := h
  have virt : ∀ l, 1028 ≤ l → W.compactSkywalkStageVirtual base i raw.basis (base l) =
      raw.basis (base l) := by
    intro l hl
    have ex := W.compactSkywalkStage_expanded base i (by omega)
    apply W.compactSkywalkStage_virtual_outside
    · intro hm
      have hm' : base l ∈ (W.compactSkywalkSignPoolA base i).expanded :=
        List.mem_append_right _ hm
      rw [ex.1] at hm'
      obtain ⟨j, hj, he⟩ := List.mem_map.mp hm'
      have := base_injective he
      simp only [List.mem_range'_1] at hj
      omega
    · intro hm
      have hm' : base l ∈ (W.compactSkywalkSignPoolB base i).expanded :=
        List.mem_append_right _ hm
      rw [ex.2] at hm'
      obtain ⟨j, hj, he⟩ := List.mem_map.mp hm'
      have := base_injective he
      simp only [List.mem_range'_1] at hj
      omega
  have stage := hraw.1
  have carry := (regValue_zero _ _).mp stage.2.2.2.2.2.1
  rw [Rolling1588.Integer.prefix_keep true i (by omega) raw (1540 + k) hl, ← virt (1540 + k) (by omega)]
  apply carry
  exact List.mem_map.mpr ⟨1540 + k, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩

end ECDSAAdd.Entrant.StairExitLT24Term

