      have rest := ih (first + 1) (by omega)
      cases divide <;>
        simp only [StairGroups.groups, PacketSequence.program,
          Bool.false_eq_true, if_false, if_true, gatePhysical_append] at rest ⊢
      · exact ⟨rest, head⟩
      · exact ⟨head, rest⟩


