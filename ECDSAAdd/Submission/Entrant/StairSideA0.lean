private theorem flatMap_uniform_counts (xs : List Nat) (f : Nat → Program) (tc mc : Nat)
    (h : ∀ i ∈ xs, toffoliCount (f i) = tc ∧ measurementCount (f i) = mc) :
    toffoliCount (xs.flatMap f) = xs.length * tc ∧
    measurementCount (xs.flatMap f) = xs.length * mc := by
  induction xs with
  | nil => simp [toffoliCount, measurementCount]
  | cons i xs ih =>
      have hi := h i (by simp)
      have ht := ih (fun j hj => h j (by simp [hj]))
      simp only [List.flatMap_cons, toffoliCount_append, measurementCount_append,
        List.length_cons, hi.1, hi.2, ht.1, ht.2]
      simp [Nat.add_mul, Nat.add_comm]

private theorem adderMiddle_counts (L : Layout) (j : Nat) :
    toffoliCount (adderMiddle L j) = 1 ∧ measurementCount (adderMiddle L j) = 0 :=
  ⟨rfl, rfl⟩

private theorem adderDown_counts (L : Layout) (j : Nat) :
    toffoliCount (adderDown L j) = 0 ∧ measurementCount (adderDown L j) = 1 :=
  ⟨rfl, rfl⟩

private theorem adderTopDown_counts (L : Layout) (B : Nat) :
    toffoliCount (adderTopDown L B) = 0 ∧ measurementCount (adderTopDown L B) = 0 :=
  ⟨rfl, rfl⟩

private theorem packAdder_counts (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    toffoliCount (packAdder L B) = B - 2 ∧ measurementCount (packAdder L B) = B - 1 := by
  have hm := flatMap_uniform_counts (List.range (B - 3))
    (fun r => adderMiddle L (r + 1)) 1 0
    (by intro i hi; exact adderMiddle_counts L (i + 1))
  have hd := flatMap_uniform_counts
    ((List.map (fun r => r + 1) (List.range (B - 3))).reverse)
    (adderDown L) 0 1 (by intro i hi; exact adderDown_counts L i)
  simp only [packAdder, toffoliCount_append, measurementCount_append]
  simp [hm.1, hm.2, hd.1, hd.2, adderTopDown_counts, toffoliCount, measurementCount]
  omega

private theorem unpackAdder_counts (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    toffoliCount (unpackAdder L B) = B - 1 ∧ measurementCount (unpackAdder L B) = B - 2 := by
  have hm := flatMap_uniform_counts (List.range (B - 3))
    (fun r => adderMiddle L (r + 1)) 1 0
    (by intro i hi; exact adderMiddle_counts L (i + 1))
  have hd := flatMap_uniform_counts
    ((List.map (fun r => r + 1) (List.range (B - 3))).reverse)
    (adderDown L) 0 1 (by intro i hi; exact adderDown_counts L i)
  simp only [unpackAdder, toffoliCount_append, measurementCount_append]
  simp [hm.1, hm.2, hd.1, hd.2, adderTopDown_counts, toffoliCount, measurementCount]
  omega

private theorem packStep_counts_normal (L : Layout) (B j : Nat) (hj : j < B - 2) :
    toffoliCount (packStep L B j) = 1 ∧ measurementCount (packStep L B j) = 2 := by
  simp [packStep, hj, toffoliCount, measurementCount]

private theorem packStep_counts_top (L : Layout) (B : Nat) :
    toffoliCount (packStep L B (B - 2)) = 1 ∧
