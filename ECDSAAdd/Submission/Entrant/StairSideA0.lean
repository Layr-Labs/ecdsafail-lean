def terminalPerm : Equiv.Perm Wire :=
  terminalSwaps.foldr (fun p e => (Equiv.swap p.1 p.2).trans e) (Equiv.refl Wire)

/-- The record rail-`b` labels relocated by `terminalPerm`. -/
def terminalRails : List Wire := (List.range 20).map (fun k => base (770 + k))

/-! ## Record blocks and the v3 programs -/









/-! ## Helpers -/



def gateOk : Instr → Bool
  | .X _ => true
  | .CX c t => c != t
  | .CCX a b t => a != t && b != t
  | .measureX _ _ _ => true

theorem gateOk_sound (i : Instr) (h : gateOk i = true) :
    RecordedQuantum.PhysicalInstr (.gate i) := by
  cases i <;> simp_all [gateOk, RecordedQuantum.PhysicalInstr, ProperGate]

theorem gatePhysical_of_all (p : Program) (h : p.all gateOk = true) : GatePhysical p := by
  intro i hi
  exact gateOk_sound i (List.all_eq_true.mp h i hi)

/-! ## Exact counts (δT = 0, δM = 0 against the record terminal blocks) -/

