      L760.low (L760.carry.take 254) L760.lower L760.one
      BalancedCleanup.negativeLiteral t fresh old nd carryLength
      literalBound depth oneT cleanT roleTail)

theorem unfoldLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (fresh : List Bool)
    (lower : s.basis L760.lower = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false) :
    ∃ old, run (StairLoan.unfoldLoan d L760) fresh s =
      run (Q6LifetimeResearch.unfoldStep (base 760) L760) old s := by
  let A : Program :=
    [.CX L760.parity L760.lower, .CX L760.rmsb L760.lower,
      .CCX L760.parity L760.lower L760.one,
      .CX L760.lower L760.rmsb, .CX L760.parity L760.rmsb]
  let P := Q6LifetimeResearch.move (base 760) L760.rmsb
    (StairLoan.mappedSubLoan d StairLoan.retiredRoles
      (ShortBiasedFold.lowBits L760) L760.low
      (L760.carry.take 254) L760.one)
  let Q := Q6LifetimeResearch.move (base 760) L760.rmsb
    (mappedSub (ShortBiasedFold.lowBits L760) L760.low
      (L760.carry.take 254) L760.one)
  let R : Program :=
    [.CX L760.parity L760.rmsb, .CX L760.lower L760.rmsb,
      .CX L760.parity L760.rmsb, .CX L760.rmsb L760.lower,
      .measureX L760.one [] [.CZ L760.parity L760.rmsb]]
  let u := run A (fresh.take (measurementCount A)) s
  let e := Equiv.swap (base 760) L760.rmsb
  -- K4-D (replay budget): every finite fact about `L760` in ONE kernel evaluation
  have K4U : L760.one ∉ L760.carry ∧ L760.rmsb ∉ L760.carry ∧ L760.lower ∉ L760.carry ∧
      L760.parity ∉ L760.carry ∧ L760.lower ≠ L760.rmsb ∧ L760.parity ≠ L760.lower ∧
      L760.parity ≠ L760.rmsb ∧ L760.one ≠ L760.lower ∧ L760.one ≠ L760.rmsb ∧ L760.one ≠ L760.parity ∧
      ECDSAAdd.Entrant.StairLoan.nodupMask (L760.one :: (L760.low ++ L760.carry.take 254)) 0 = true ∧
      (ShortBiasedFold.lowBits L760).length = L760.low.length ∧
      (L760.carry.take 254).length + 1 = L760.low.length ∧ L760.carry.length = 256 := by
    decide +kernel
  have oneAway : L760.one ∉ L760.carry := K4U.1
  have highAway : L760.rmsb ∉ L760.carry := K4U.2.1
  have uHigh : u.basis L760.rmsb = false := by
    simp [u, A, run, writeBit, lower,
      (K4U.2.2.2.2.1 : L760.lower ≠ L760.rmsb),
      (Ne.symm K4U.2.2.2.2.1 : L760.rmsb ≠ L760.lower),
      (K4U.2.2.2.2.2.1 : L760.parity ≠ L760.lower),
      (Ne.symm K4U.2.2.2.2.2.1 : L760.lower ≠ L760.parity),
      (K4U.2.2.2.2.2.2.1 : L760.parity ≠ L760.rmsb),
      (Ne.symm K4U.2.2.2.2.2.2.1 : L760.rmsb ≠ L760.parity),
      (K4U.2.2.2.2.2.2.2.1 : L760.one ≠ L760.lower),
      (Ne.symm K4U.2.2.2.2.2.2.2.1 : L760.lower ≠ L760.one),
      (K4U.2.2.2.2.2.2.2.2.1 : L760.one ≠ L760.rmsb),
      (Ne.symm K4U.2.2.2.2.2.2.2.2.1 : L760.rmsb ≠ L760.one),
      (K4U.2.2.2.2.2.2.2.2.2.1 : L760.one ≠ L760.parity),
      (Ne.symm K4U.2.2.2.2.2.2.2.2.2.1 : L760.parity ≠ L760.one)]
    cases s.basis L760.parity <;> cases s.basis L760.rmsb <;> rfl
  have uClean : ∀ q ∈ L760.carry, u.basis q = false := by
    intro q hq
    have qo : q ≠ L760.one := fun eq => oneAway (eq ▸ hq)
    have qh : q ≠ L760.rmsb := fun eq => highAway (eq ▸ hq)
    have ql : q ≠ L760.lower := by
      intro eq
      subst q
      have : L760.lower ∉ L760.carry := K4U.2.2.1
      exact this hq
    have qp : q ≠ L760.parity := by
      intro eq
      subst q
      have : L760.parity ∉ L760.carry := K4U.2.2.2.1
      exact this hq
    simp only [u, A, measurementCount, List.take_zero, run, writeBit,
      Function.update_of_ne qo, Function.update_of_ne qh,
      Function.update_of_ne ql, Function.update_of_ne qp]
    exact clean q hq
  have pulledClean : ∀ q ∈ L760.carry.take 254,
      (pullState e u).basis q = false := by
    intro q hq
    change u.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = L760.rmsb from
        Equiv.swap_apply_left _ _]
      exact uHigh
    · have qh : q ≠ L760.rmsb := fun eq => highAway
        (eq ▸ List.mem_of_mem_take hq)
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qh]
      exact uClean q (List.mem_of_mem_take hq)
  have nd : (L760.one :: (L760.low ++ L760.carry.take 254)).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4U.2.2.2.2.2.2.2.2.2.2.1
  have sourceAway : ∀ q ∈ mappedWires (ShortBiasedFold.lowBits L760),
      q ∉ L760.one :: (L760.low ++ L760.carry.take 254) := by
    intro q hq
    rw [OneReuse.lowBits_source L760 q hq]
    decide +kernel
  have bitsLength :
      (ShortBiasedFold.lowBits L760).length = L760.low.length := K4U.2.2.2.2.2.2.2.2.2.2.2.1
  have carryLength :
      (L760.carry.take 254).length + 1 = L760.low.length := K4U.2.2.2.2.2.2.2.2.2.2.2.2.1
  have depth : d + 1 ≤ (L760.carry.take 254).length := by
    have width : L760.carry.length = 256 := K4U.2.2.2.2.2.2.2.2.2.2.2.2.2
    simp only [List.length_take]
    omega
  have roleTail := StairLoan.retiredRoles_tail254 d hd
  have middle : ∀ x y, run P x u = run Q y u := by
    intro x y
    apply StairLoan.renameProgram_run_eq_of e
    exact StairLoan.mappedSubLoan_run_eq d StairLoan.retiredRoles
      (ShortBiasedFold.lowBits L760) L760.low (L760.carry.take 254)
      L760.one (pullState e u) x y nd sourceAway bitsLength
      carryLength depth pulledClean roleTail
  have replaced := replace_middle_exists A P Q R s fresh middle
  simpa only [StairLoan.unfoldLoan, Q6LifetimeResearch.unfoldStep,
    A, P, Q, R, List.append_assoc] using replaced

set_option maxHeartbeats 4000000 in
theorem compareBlockLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (fresh : List Bool)
    (one : s.basis L760.one = false)
    (lower : s.basis L760.lower = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false) :
    ∃ old, run (StairLoan.compareBlockLoan d false L760) fresh s =
      run (Q6LifetimeResearch.compare (base 760) false L760) old s := by
  let spine := (Q6Structural.q6Carry L760).take 255
  let last := (Q6Structural.q6Carry L760).getD 255 0
  let a := L760.y.getD 0 0
  let b := L760.r.getD 0 0
  let c := spine.getD 0 0
  let xs := L760.y.drop 1
  let ys := L760.r.drop 1
  let cs := spine.drop 1
  let N := notRegister (L760.one :: L760.r)
  let A := N ++ majority a b L760.one c ++ [.X L760.one]
  let P := Q6LifetimeResearch.move (base 760) L760.one
    (StairLoan.compareLoan d StairLoan.retiredRoles false xs ys cs c
      L760.parity)
  let Q := Q6LifetimeResearch.move (base 760) L760.one
    (Q6LifetimeResearch.compareChain false xs ys cs c L760.parity)
  let R := [.X L760.one] ++ eraseCarry a b L760.one c ++ N
  let v := run N [] s
  let w := run (majority a b L760.one c) [] v
  let u := run [.X L760.one] [] w
  let e := Equiv.swap (base 760) L760.one
  -- K4-D (replay budget): every finite fact about `L760` in ONE kernel evaluation (the layout lists are
  -- evaluated once instead of once per `decide`)
  have K4F : ECDSAAdd.Entrant.StairLoan.nodupMask (L760.one :: L760.r) 0 = true ∧
      ECDSAAdd.Entrant.StairLoan.nodupMask [a, b, L760.one, c] 0 = true ∧
      ECDSAAdd.Entrant.StairLoan.nodupMask (L760.parity :: L760.one ::
        (L760.y ++ L760.r ++ Q6Structural.q6Carry L760)) 0 = true ∧
      spine.length = 255 ∧ xs.length = 255 ∧ ys.length = 255 ∧ cs.length = 254 ∧
      Q6Structural.q6Carry L760 = spine ++ [last] ∧ L760.one ≠ c ∧
      ECDSAAdd.Entrant.StairLoan.nodupMask (L760.parity :: c :: (xs ++ ys ++ (cs ++ [last]))) 0 = true := by
    decide +kernel
  have nND : (L760.one :: L760.r).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4F.1
  have four : [a, b, L760.one, c].Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4F.2.1
  have allND :
      (L760.parity :: L760.one ::
        (L760.y ++ L760.r ++ Q6Structural.q6Carry L760)).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4F.2.2.1
  have spineLength : spine.length = 255 := K4F.2.2.2.1
  have xsLength : xs.length = 255 := K4F.2.2.2.2.1
  have ysLength : ys.length = 255 := K4F.2.2.2.2.2.1
  have csLength : cs.length = 254 := K4F.2.2.2.2.2.2.1
  have fullShape :
      Q6Structural.q6Carry L760 = spine ++ [last] := K4F.2.2.2.2.2.2.2.1
  have spineShape : spine = c :: cs := by
    -- K4C (build budget): a lemma over an arbitrary list instead of `contradiction` / `cases`
    -- on the concrete spine (≈ 52 s of elaboration).
    have key : ∀ l : List Wire, l.length = 255 → l = l.getD 0 0 :: l.drop 1 := by
      intro l hl
      cases l with
      | nil => simp at hl
      | cons q qs => simp
    exact key spine spineLength
  have cleanQ6 : ∀ q ∈ Q6Structural.q6Carry L760,
      s.basis q = false := by
    intro q hq
    simp only [Q6Structural.q6Carry, List.mem_append,
      List.mem_singleton] at hq
    rcases hq with (front | eq) | tail
    · exact clean q (List.mem_of_mem_take front)
    · exact eq ▸ lower
    · exact clean q (List.mem_of_mem_drop tail)
  have executeA :
      run A (fresh.take (measurementCount A)) s = u := by
    have nZero : measurementCount N = 0 := (notRegister_counts _).2
    have majZero : measurementCount (majority a b L760.one c) = 0 := rfl
    simp only [A, List.append_assoc, run_append, run_take, nZero,
      majZero, List.take_zero, List.drop_zero]
    rw [FifthCarry.no_records N nZero s _ [],
      FifthCarry.no_records (majority a b L760.one c) majZero v _ [],
      FifthCarry.no_records [.X L760.one] (by rfl) w _ []]
  have vOne : v.basis L760.one = true := by
    rw [show v = run N [] s from rfl, notRegister_correct _ nND]
    simp [N, one]
  have wOne : w.basis L760.one = true := by
    rw [show w = run (majority a b L760.one c) [] v from rfl,
      majority_correct a b L760.one c four]
    simp [writeBit, K4F.2.2.2.2.2.2.2.2.1, vOne]
  have uOne : u.basis L760.one = false := by
    simp [u, run, writeBit, wOne]
  have tailIn : ∀ q ∈ cs ++ [last],
      q ∈ Q6Structural.q6Carry L760 := by
    intro q hq
    rw [fullShape, spineShape]
    simpa only [List.cons_append, List.mem_cons] using Or.inr hq
  have tailAwayN : ∀ q ∈ cs ++ [last],
      q ∉ L760.one :: L760.r := by
    intro q hq used
    have h := List.nodup_iff_count.mp allND q
    have hcq := List.count_pos_iff.mpr (tailIn q hq)
    have hu := List.count_pos_iff.mpr used
    simp only [List.count_cons, List.count_append, List.count_nil] at h hcq hu
    omega
  have tailAwayC : ∀ q ∈ cs ++ [last], q ≠ c := by
    intro q hq eq
    have h := List.nodup_iff_count.mp allND c
    have hcq := List.count_pos_iff.mpr (tailIn c (eq ▸ hq))
    have hcHead : c ∈ Q6Structural.q6Carry L760 := by
      rw [fullShape, spineShape]
      simp
    have hh := List.count_pos_iff.mpr hcHead
    rw [← eq] at hcq
    simp only [List.count_cons, List.count_append, List.count_nil] at h hcq hh
    have distinct : c ∉ cs ++ [last] := by
      intro bad
      rw [fullShape, spineShape] at h
      have hp := List.count_pos_iff.mpr bad
      simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h hp
      omega
    exact distinct (eq ▸ hq)
  have keepV : ∀ q ∈ cs ++ [last], v.basis q = s.basis q := by
    intro q hq
    rw [show v = run N [] s from rfl, notRegister_correct _ nND]
    simp [tailAwayN q hq]
  have keepW : ∀ q ∈ cs ++ [last], w.basis q = v.basis q := by
    intro q hq
    rw [show w = run (majority a b L760.one c) [] v from rfl,
      majority_correct a b L760.one c four]
    simp [writeBit, tailAwayC q hq]
  have keepU : ∀ q ∈ cs ++ [last], u.basis q = s.basis q := by
    intro q hq
    simp [u, run, writeBit,
      show q ≠ L760.one from fun eq => tailAwayN q hq (by simp [eq]),
      keepW q hq, keepV q hq]
  have nd :
      (L760.parity :: c :: (xs ++ ys ++ (cs ++ [last]))).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4F.2.2.2.2.2.2.2.2.2
  have hab : xs.length = ys.length := by omega
  have hc : cs.length + 1 = ys.length := by omega
  have depth : d + 1 ≤ cs.length := by omega
  have roleTail := StairLoan.retiredRoles_q6Tail d hd
  have pulledClean : ∀ q ∈ cs ++ [last],
      (pullState e u).basis q = false := by
    intro q hq
    change u.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = L760.one from Equiv.swap_apply_left _ _]
      exact uOne
    · have qo : q ≠ L760.one := fun eq => tailAwayN q hq (by simp [eq])
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qo,
        keepU q hq]
      exact cleanQ6 q (tailIn q hq)
  have middle : ∀ x y, run P x u = run Q y u := by
    intro x y
    apply StairLoan.renameProgram_run_eq_of e
    exact compareLoan_false_run_eq d StairLoan.retiredRoles xs ys cs last c
      L760.parity (pullState e u) x y hab hc depth nd pulledClean roleTail
  have replaced := replace_middle_exists A P Q R s fresh (by
    intro x y
    rw [executeA]
    exact middle x y)
  simpa only [StairLoan.compareBlockLoan, Q6LifetimeResearch.compare,
    A, P, Q, R, N, spine, last, a, b, c, xs, ys, cs,
    List.append_assoc] using replaced

end ECDSAAdd.Entrant.StairLoanInverse
end Merge_StairLoanInverseBlocks_at_StairSideA

