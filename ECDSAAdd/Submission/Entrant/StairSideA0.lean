/-- Record carry bits `0 .. 4` of the untick 505 (record coordinates). -/
def carryR : List Wire := (List.range 5).map (fun k => base (1540 + k))




theorem carry_sites_free : ∀ k, k < 5 →
    StairPhysicalLayout.cSite k ∉ StairTerminalV3.forwardSites ∧
      StairPhysicalLayout.cSite k ∉ StairTerminalV3.reverseSites := by
  decide +kernel

theorem swaps_fix (L : List (Wire × Wire)) (s : State)
    (h : ∀ q ∈ L, s.basis q.1 = s.basis q.2) :
    ∀ w, s.basis ((L.foldr (fun p e => (Equiv.swap p.1 p.2).trans e) (Equiv.refl Wire)) w) =
      s.basis w := by
  induction L with
  | nil => intro w; rfl
  | cons q L ih =>
      intro w
      have hq := h q (List.mem_cons_self ..)
      have ih' := ih (fun r hr => h r (List.mem_cons_of_mem _ hr))
      simp only [List.foldr_cons, Equiv.trans_apply]
      rw [ih']
      rw [Equiv.swap_apply_def]
      split_ifs with h1 h2
      · rw [h1]; exact hq.symm
      · rw [h2]; exact hq
      · rfl


theorem pull_inj (e : Equiv.Perm Wire) {s t : State} (h : pullState e s = pullState e t) :
    s = t := by
  apply State.extensionality
  · have h' := congrArg State.phase h
    exact h'
  · funext q
    have := congrFun (congrArg State.basis h) (e.symm q)
    simpa [pullState] using this








