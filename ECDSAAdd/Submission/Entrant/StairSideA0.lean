  simp only [writeBit, Function.update_of_ne ne]

/-! ## Level 4: the record-shaped multiplication kernel -/

/-- The loaned analogue of the record's `exit_boundary` (concrete first-phase
runs abstracted first, as in the record). -/
theorem shape_exit_boundary (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (hn : (skywalkSharedWires base).Nodup)
    (hlo : History5.HistoryAbove base)
    (ho : ∀ q ∈ [base 2400, base 2409, base 2410], q ∉ skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410)
      (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s : State)
    (mp mf : List Bool)
    (input : SkywalkArithmeticInput base x Y.val s.basis)
    (hg : s.basis (base 2409) = false) (hs : s.basis (base 2410) = false) :
    let beforeA := run (Rolling1588.firstPhase false) mp s
    let beforeB := run (Rolling1588.firstPhase true) mp s
    let after := run (exitFieldHostedShape StairConcrete.bestLoans) mf beforeA
    after.phase = beforeB.phase ∧
      regValue (wireBlock base 2056 256) after.basis =
        centerWord (Y * (x : Fp) / 2) ∧
      ∀ q, q ∉ wireBlock base 2056 256 → after.basis q = beforeB.basis q := by
  have record := Rolling1588.exit_boundary hn hlo ho hf x Y hx0 hx s mp mf input
    hg hs
  obtain ⟨beforeA, beforeAEq⟩ : ∃ beforeA : State,
      run (Rolling1588.firstPhase false) mp s = beforeA := ⟨_, rfl⟩
  obtain ⟨beforeB, beforeBEq⟩ : ∃ beforeB : State,
      run (Rolling1588.firstPhase true) mp s = beforeB := ⟨_, rfl⟩
  obtain ⟨origin, facts, legal, frames⟩ := Rolling1588Lifetime.first_prepared
    hn hlo ho x Y hx0 hx s mp input
  have ctx := Rolling1588Lifetime.prepared_context hn ho hf x Y s origin facts
    legal hg hs
  have frameA := frames false
  rw [beforeAEq] at frameA
  have bits := Rolling1588Lifetime.first_clean false hn hlo x Y.val hx0 hx s mp
    input
  have work := Rolling1588Lifetime.first_work_zero false hn x Y.val s mp input
  have parity := Rolling1588Lifetime.first_parity false hn hlo x Y.val hx0 hx s
    mp input
  rw [beforeAEq] at bits work parity
  have code := Rolling1588Frame.canonical_special_at origin.basis Y 0 beforeA 511
    (by simp) frameA
  have fixed : OB5.sig 511 (base 511) = base 511 := by decide +kernel
  rw [fixed] at code
  have eq := exitFieldHosted_run_eq half endpoint origin.basis ctx
    facts.sourceZero x hx0 hx facts.trace Y beforeA frameA
    (code.trans (trace_last x hx0 hx origin.basis facts.trace))
    (bits _ (by simp [FrontierEntry1591Native.workSites])) work parity mf mf
  rw [beforeAEq, beforeBEq] at record
  rw [beforeAEq, beforeBEq]
  dsimp only at record ⊢
  obtain ⟨after, afterEq⟩ : ∃ after : State,
      run Rolling1588.exitFieldHosted mf beforeA = after := ⟨_, rfl⟩
  rw [afterEq] at record eq
  rw [eq]
  exact record


/-- Two outputs pinned by `hostedX` are equal. -/
theorem exit_output_unique (s a b : State) (value value' : Nat)
    (ha : a.phase = s.phase ∧ regValue (wireBlock base 2056 256) a.basis = value ∧
      regValue (wireBlock base 770 258) a.basis = value' ∧
      ∀ q, q ∉ wireBlock base 2056 256 → q ∉ wireBlock base 770 258 →
        a.basis q = s.basis q)
    (hb : b.phase = s.phase ∧ regValue (wireBlock base 2056 256) b.basis = value ∧
      regValue (wireBlock base 770 258) b.basis = value' ∧
      ∀ q, q ∉ wireBlock base 2056 256 → q ∉ wireBlock base 770 258 →
        b.basis q = s.basis q) :
    a = b := by
  have block1 := (regValue_eq_iff (wireBlock base 2056 256) a.basis b.basis).mp
    (ha.2.1.trans hb.2.1.symm)
  have block2 := (regValue_eq_iff (wireBlock base 770 258) a.basis b.basis).mp
    (ha.2.2.1.trans hb.2.2.1.symm)
  apply State.extensionality _ _ (ha.1.trans hb.1.symm)
  funext q
  by_cases h1 : q ∈ wireBlock base 2056 256
  · exact block1 q h1
  · by_cases h2 : q ∈ wireBlock base 770 258
    · exact block2 q h2
    · exact (ha.2.2.2 q h1 h2).trans (hb.2.2.2 q h1 h2).symm


