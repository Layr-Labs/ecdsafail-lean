section Merge_StairBridgeDomain_at_StairSideA

/-!
# Real-walk checkpoint domain and width bridge

This file derives the codec and moved-tick arithmetic premises from the
record's actual 256-bit Skywalk hypotheses.  No checkpoint state, domain, or
fit predicate is assumed as a field of a primitive-provider structure.
-/

set_option autoImplicit false
set_option maxRecDepth 12000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairBridgeDomain

open ECDSAAdd Arithmetic





/-- The canonical sign agrees with the encoded sign away from zero and is
forced to `false` at zero. -/
theorem checkpointSign_encode (G S : Bool) (u v : Nat) :
    checkpointSign
        (SkywalkRails.encode G S (u : Int) (v : Int)) =
      if u = 0 then false else S := by
  cases G <;> cases S <;> by_cases hu : u = 0 <;>
    simp [checkpointSign, SkywalkRails.encode, SkywalkRails.signed,
      SkywalkRails.neg, hu] <;> omega



/-- Iterated protected exponent budget, including terminal padding.  The
terminal branch uses coprimality to derive `(u,v)=(0,1)` and therefore needs
only one remaining exponent bit. -/
theorem iter_exponent_budget : ∀ (i a b : Nat) (z : SkywalkNat.State),
    0 < z.v → z.v % 2 = 1 → z.u.Coprime z.v →
      z.u < 2 ^ a → z.v < 2 ^ b → i < a + b →
      ∃ a' b', a' + b' ≤ a + b - i ∧
        (SkywalkNat.step^[i] z).u < 2 ^ a' ∧
        (SkywalkNat.step^[i] z).v < 2 ^ b' := by
  intro i
  induction i with
  | zero =>
      intro a b z hv hodd hcop hu hvb hi
      exact ⟨a, b, by simp, hu, hvb⟩
  | succ i ih =>
      intro a b z hv hodd hcop hu hvb hi
      by_cases hz : z.u = 0
      · have hvone : z.v = 1 := by
          have hgcd : z.u.gcd z.v = 1 := hcop
          rwa [hz, Nat.gcd_zero_left] at hgcd
        rw [SkywalkNat.iter_fixed_of_u_zero z (i + 1) hz, hz, hvone]
        exact ⟨0, 1, by omega, by norm_num, by norm_num⟩
      · obtain ⟨a₁, b₁, hsum, hu₁, hv₁⟩ :=
          SkywalkNat.step_exponent_budget z a b
            (Nat.pos_of_ne_zero hz) hv hu hvb
        have valid := SkywalkNat.step_v_odd_pos z hv hodd
        have cop := SkywalkNat.step_coprime z hodd hcop
        obtain ⟨a₂, b₂, hsum₂, hu₂, hv₂⟩ :=
          ih a₁ b₁ (SkywalkNat.step z) valid.1 valid.2 cop hu₁ hv₁ (by omega)
        rw [Function.iterate_succ_apply]
        exact ⟨a₂, b₂, by omega, hu₂, hv₂⟩


/-- The actual walk state at every stair checkpoint is in the codec domain.
The strict sum bound and bit-length-sum bound both come from the protected
exponent budget; the zero clause also proves sign normalization. -/
theorem real_codecDomain (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hodd : p % 2 = 1)
    (hp : p < 2 ^ 256) (hx : x < p) (hcop : x.Coprime p)
    (hi : i ≤ 509) :
    StairCodec.CodecDomain (512 - i)
      (realNatState x p i).u (realNatState x p i).v
      (realSign x p i) := by
  let z := realNatState x p i
  have valid := SkywalkNat.iter_valid i (SkywalkNat.init x p) hp0 hodd
  have zcop : z.u.Coprime z.v := by
    change (SkywalkNat.step^[i] (SkywalkNat.init x p)).u.Coprime
      (SkywalkNat.step^[i] (SkywalkNat.init x p)).v
    exact valid.2.2.trans hcop
  obtain ⟨a, b, hab, hua, hvb⟩ :=
    iter_exponent_budget i 256 256 (SkywalkNat.init x p)
      hp0 hodd hcop (hx.trans hp) hp (by omega)
  change z.u < 2 ^ a at hua
  change z.v < 2 ^ b at hvb
  have hbu := natBitLength_le_of_lt_pow z.u a hua
  have hbv := natBitLength_le_of_lt_pow z.v b hvb
  have hsum := W.iter_sum_width x p i hp0 hx0 hodd hp hx hcop (by omega)
  change z.u + z.v ≤ 2 ^ (511 - i) at hsum
  have hpow : 2 ^ (511 - i) < 2 ^ (512 - i) := by
    have he : 512 - i = (511 - i) + 1 := by omega
    rw [he, pow_succ]
    have hpos : 0 < 2 ^ (511 - i) := by positivity
    omega
  have hbits :
      StairCodec.natBitLength (realNatState x p i).u +
        StairCodec.natBitLength (realNatState x p i).v ≤ 512 - i := by
    change StairCodec.natBitLength z.u + StairCodec.natBitLength z.v ≤ 512 - i
    omega
  refine ⟨by omega, valid.1, valid.2.1, lt_of_le_of_lt hsum hpow,
    hbits, ?_⟩
  intro hzero
  have vone : z.v = 1 := by
    have hgcd : z.u.gcd z.v = 1 := zcop
    rwa [hzero, Nat.gcd_zero_left] at hgcd
  refine ⟨vone, ?_⟩
  obtain ⟨G, S, encoded⟩ :=
    SkywalkTrace.iter_encoded i false false (SkywalkNat.init x p) hp0 hodd
  change realRails x p i =
    SkywalkRails.encode G S (z.u : Int) (z.v : Int) at encoded
  rw [realSign, encoded, checkpointSign_encode, hzero]
  rfl







end ECDSAAdd.Entrant.StairBridgeDomain
end Merge_StairBridgeDomain_at_StairSideA

