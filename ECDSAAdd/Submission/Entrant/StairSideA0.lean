/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBoundaryLoanDecoder_at_QTop` -/
section Merge_StairBoundaryLoanDecoder_at_QTop

/-!
# Boundary carry loan: the division endpoint decoder (program and static facts)

`CompareDecoder.cellDecoderNext` touches the 44 exclusive retired sites only in
its literal comparison ladder (`cmpFront` / `cmpBack`, ladder positions
208–252 without 248); the block between them (`lowBlock`) touches exactly the
six ladder carries 5–10, and nothing after `cmpBack` touches the ladder.

`cellDecoderLoan` therefore:
* factors the `X` conjugation of the comparison input out of `borrowPath`
  (`borrowPath` = `notRegister xs ++` mapped literal-borrow layers `++ notRegister xs`);
* keeps the carry inversions only on the six carries `lowBlock` reads
  (the other inversions cancel across `lowBlock`);
* keeps the 11 lowest ladder layers unchanged and runs the remaining 244 layers
  as `StairLoan.emitLoan 44`, hosting the 44 retired roles on ladder carries
  11–54 (freed by measurement and recomputed afterwards).

Proved here (kernel-checked on the concrete program): exact counts
(+44 Toffoli, +44 measurements), avoidance of all 44 sites, physicality.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed

/-- Comparison constant of `cmpFront` / `cmpBack`. -/
def K : Nat := ((ECDSAAdd.p - 1) / 2) / 3

def xs : List Wire := fixedLayout.y.take 255
def cs : List Wire := fixedLayout.carry
def cin : Wire := fixedLayout.Y 255

/-- The literal bits consumed by `borrowPath` (bit `i` of `K`). -/
def borrowBits : List MappedBit :=
  (List.range 256).map (fun i => { wire := none, flip := decide ((K / 2 ^ i) % 2 = 1) })

/-- Mapped literal-borrow layers (no sum writes); the padding entry only keeps
`mappedLayers` producing one layer per ladder carry. -/
def ladder : List StairLoan.CarryLayer :=
  (StairLoan.mappedLayers borrowBits (xs ++ [cin]) cs cin).map
    (fun l => { l with finish := [] })

def headL : List StairLoan.CarryLayer := ladder.take 11
def tailL : List StairLoan.CarryLayer := ladder.drop 11

/-- The six ladder carries read by `lowBlock`. -/
def lowLive : List Wire := (cs.drop 5).take 6

/-- The comparison window's middle, with carry inversions restricted to `lowLive`. -/
def top760 : Program :=
  notRegister xs ++ [.X cin] ++ lowLive.map (fun q => .X q) ++ lowBlock fixedLayout ++
    lowLive.map (fun q => .X q) ++
    [.X cin, .X fixedLayout.sigma, .CX fixedLayout.sigma fixedLayout.h,
      .measureX fixedLayout.h [] [.CZ fixedLayout.sigma (fixedLayout.carry.getLastD cin)]] ++
    notRegister xs

def window760 (d : Nat) : Program :=
  notRegister xs ++ StairLoan.emitUps headL ++
    StairLoan.emitLoan d StairBoundaryLoan.exclusiveHoles tailL top760 ++
    StairLoan.emitDowns headL ++ notRegister xs

/-- The loaned division decoder. -/
def cellDecoderLoan : Program :=
  frontFast fixedLayout ++ upper fixedLayout ++ DirectDecoder.highBlock fixedLayout ++
    DirectDecoder.middle fixedLayout ++ [.X cin] ++ window760 44 ++
    [.X fixedLayout.sigma, .X cin] ++ restoreSource fixedLayout ++ copySource fixedLayout

/-- The loaned division endpoint (same wrappers as `R2SqEp760.endPacket760 true`). -/
def endPacket760DivLoan : Program :=
  renameProgram (Equiv.swap (base 760) (base 717))
    (renameProgram (shifted Placement5.pi0)
      (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
        (cellDecoderLoan ++ List.replicate 507 (Instr.measureX (base 512) [] []))))

/-! ## Static facts -/


/-! ## K5 (replay budget): counts, slots and physicality in one pass

The relocation `rebindMany` inside `emitLoan` (most of the evaluation cost) changes no
count, slot or physicality fact, and the endpoint wrappers are the record's.  One kernel
pass over `k5Flat` (= `cellDecoderLoan` without the rebinding) replaces the former passes
over `cellDecoderLoan` and the two endpoints (counts, physicality, slots). -/





































end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan
end Merge_StairBoundaryLoanDecoder_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBoundaryLoanFrames_at_QTop` -/
section Merge_StairBoundaryLoanFrames_at_QTop

/-!
# Boundary carry loans: the converter ladders are clean on reachable states

The record runs `canon760` on `Rolling1588Frame.EncodedFieldFrame isA origin X 0`
and `center760` on `Rolling1588Frame.EncodedCanonicalFrame isA origin X 0`.  Both
frames are the `OB5.sig 511` pull of the unencoded-plus-`allEncode` frames
`EncodedFieldFrame5` / `EncodedCanonicalFrame5`.  Every ladder wire of
`converterLayout760`, pulled by `OB5.sig 511`, lies in one of five classes
(`ladder_classified`, checked by the kernel):

* `Placement5.workRegion` / `Placement5.holeRegion` — zero in encoded frames
  (`Rolling1588.encoded_zero_region`, resp. the record's canonical-frame
  argument via `encodedCanonical_pool_basis5` + `allEncode_holes_zero`);
* endpoint work wires outside the encoder support and outside both field
  registers — zero on the unencoded state by the record's `base 760` argument;
* the selector `base 2409` — zero by `ctx.hg0`;
* `base 771`, `base 772` — bits of the zero second field register.

Hence the clean-ladder premise of `canon760Loan_run_eq_of_clean` /
`center760Loan_run_eq_of_clean` holds on every reachable input, giving the
unconditional `canon760Loan_run_eq` / `center760Loan_run_eq`.
-/

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairBoundaryLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-- The five classes of a pulled ladder wire (`v = base (v - 16)`). -/
def PulledClass (v : Nat) : Prop :=
  16 ≤ v ∧ (Placement5.workRegion (v - 16) ∨ Placement5.holeRegion (v - 16) ∨
    ((v - 16) ∈ Q6EndpointCell.workIds ∧ 512 ≤ v - 16 ∧ (v - 16 < 1028 ∨ 1540 ≤ v - 16) ∧
      (v - 16 < 770 ∨ 1027 ≤ v - 16) ∧ (v - 16 < 2056 ∨ 2313 ≤ v - 16)) ∨
    v - 16 = 2409 ∨ v - 16 = 771 ∨ v - 16 = 772)


/-- K4-B (replay budget): `OB5.sig 511` with kernel-primitive tests. -/
def kbSig511B (q : Nat) : Nat :=
  cond ((Nat.ble 1301 q && Nat.ble q 1555) || (Nat.ble 1558 q && Nat.ble q 1812)) (3113 - q) q

theorem kbSig511_eq (q : Nat) : OB5.sig 511 q = kbSig511B q := by
  show (if (1301 ≤ q ∧ q ≤ 1044 + 511) ∨ (2069 ≤ q + 511 ∧ q ≤ 1812) then 3113 - q else q) = _
  unfold kbSig511B
  simp only [cond_eq_ite, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]
  split_ifs <;> omega

/-- K4-B (replay budget): `PulledClass` as one Boolean test with kernel-primitive operations. -/
def kbPulledB (v : Nat) : Bool :=
  Nat.ble 16 v &&
    ((Nat.ble 515 (v - 16) && Nat.ble (v - 16) 718) ||
      (Nat.ble 1030 (v - 16) && Nat.ble (v - 16) 1537 &&
        (Nat.beq ((v - 16 - 1030) % 5) 0 || Nat.beq ((v - 16 - 1030) % 5) 2)) ||
      ((Nat.beq (v - 16) 765 || Nat.beq (v - 16) 2312 || Nat.beq (v - 16) 767 ||
          Nat.beq (v - 16) 766 || Nat.beq (v - 16) 768 || Nat.beq (v - 16) 1797 ||
          Nat.beq (v - 16) 1027 || (Nat.ble 512 (v - 16) && Nat.blt (v - 16) 765) ||
          Nat.beq (v - 16) 1540 || Nat.beq (v - 16) 1541 || Nat.beq (v - 16) 1026) &&
        Nat.ble 512 (v - 16) && (Nat.blt (v - 16) 1028 || Nat.ble 1540 (v - 16)) &&
        (Nat.blt (v - 16) 770 || Nat.ble 1027 (v - 16)) &&
        (Nat.blt (v - 16) 2056 || Nat.ble 2313 (v - 16))) ||
      Nat.beq (v - 16) 2409 || Nat.beq (v - 16) 771 || Nat.beq (v - 16) 772)

theorem kbPulledB_sound {v : Nat} (h : kbPulledB v = true) : PulledClass v := by
  unfold kbPulledB at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq] at h
  obtain ⟨h16, h⟩ := h
  refine ⟨h16, ?_⟩
  rcases h with ((((hw | hh) | ⟨⟨⟨⟨hm, h1⟩, h2⟩, h3⟩, h4⟩) | h5) | h6) | h7
  · exact Or.inl hw
  · exact Or.inr (Or.inl ⟨hh.1.1, hh.1.2, hh.2⟩)
  · refine Or.inr (Or.inr (Or.inl ⟨?_, h1, h2, h3, h4⟩))
    simp only [Q6EndpointCell.workIds, List.mem_append, List.mem_cons, List.mem_range'_1,
      List.not_mem_nil, or_false]
    omega
  · exact Or.inr (Or.inr (Or.inr (Or.inl h5)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h6))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h7))))

theorem ladder_classified :
    ∀ q ∈ converterLayout760.carry.take 254, PulledClass (OB5.sig 511 q) := by
  -- K4-B (replay budget): primitive `sig` / class tests, one kernel pass
  have h : (converterLayout760.carry.take 254).all (fun q => kbPulledB (kbSig511B q)) = true := by
    decide +kernel
  intro q hq
  rw [kbSig511_eq]
  exact kbPulledB_sound (List.all_eq_true.mp h q hq)

section Far
attribute [local irreducible] wires Rolling1588.allEncode

/-- Public copy of the record's private `R2SqEp760.allEncode_far`. -/
theorem allEncode_far' (isA : Bool) (q : Nat) (low : 512 ≤ q) (high : q < 1028 ∨ 1540 ≤ q) :
    base q ∉ wires (Rolling1588.allEncode base isA 102) := by
  have support := Rolling1588.allEncode_history_support base isA 102 (by decide)
  intro used
  have member := support used
  simp only [List.mem_toFinset, List.mem_append] at member
  rcases member with member | member
  · exact OwnPlusHost.not_block q 0 512 (by omega) member
  · exact OwnPlusHost.not_block q 1028 512 (by omega) member

end Far

theorem base_sub (v : Nat) (h : 16 ≤ v) : v = base (v - 16) := by
  show v = v - 16 + 16
  omega

theorem origin_work_clean (origin : BasisState) (ctx : FrontierReplay1591.Context origin) :
    ∀ i ∈ Q6EndpointCell.workIds, origin (base i) = false := by
  intro i hi
  apply Q6EndpointCell.clean_of_env base origin ctx.env ctx.parity
  exact List.mem_map.mpr ⟨i, hi, rfl⟩

theorem workRegion_workIds (i : Nat) (h : Placement5.workRegion i) :
    i ∈ Q6EndpointCell.workIds := by
  unfold Placement5.workRegion at h
  simp only [Q6EndpointCell.workIds, List.mem_append, List.mem_cons, List.mem_range'_1,
    List.not_mem_nil, or_false]
  omega


/-- Canonical frame (second register `0`): every classified wire is clean. -/
theorem canonical_pulled_zero {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0) (X : Fp) (t : State)
    (frame : Rolling1588.EncodedCanonicalFrame5 isA origin X 0 t)
    (v : Wire) (hv : PulledClass v) : t.basis v = false := by
  have before := Rolling1588HalfField5.encodedCanonical_pool_basis5 ctx.hn origin ha X t frame
  obtain ⟨h16, cls⟩ := hv
  rw [base_sub v h16]
  obtain ⟨raw, _, pair, encoded⟩ := frame
  have rawZero (i : Nat) (lo : 512 ≤ i) (far : i < 1028 ∨ 1540 ≤ i)
      (notA : i < 770 ∨ 1027 ≤ i) (notZ : i < 2056 ∨ 2313 ≤ i)
      (clean : origin (base i) = false) : t.basis (base i) = false := by
    rw [encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA _ lo far)]
    exact (pair.2.2 _
      (by rw [skywalkShared_field_z]; exact OwnPlusHost.not_block _ 2056 257 (by omega))
      (OwnPlusHost.not_block _ 770 257 (by omega))).trans clean
  rcases cls with work | hole | ⟨wk, lo, far, notY, notR⟩ | sel | y1 | y2
  · have w := work
    unfold Placement5.workRegion at w
    exact rawZero _ (by omega) (by omega) (by omega) (by omega)
      (origin_work_clean origin ctx _ (workRegion_workIds _ work))
  · have pool : base (v - 16) ∈ skywalkPoolWires base := by
      apply List.mem_map.mpr
      refine ⟨v - 16, ?_, rfl⟩
      simp only [List.mem_range'_1]
      unfold Placement5.holeRegion at hole
      omega
    rw [before _ pool]
    have recover := Placement5.hole_recover (v - 16) hole
    rw [← recover.2]
    exact Rolling1588.allEncode_holes_zero base isA base_pool_nodup
      ({phase := false, basis := origin} : State) [] ctx.legal
      (Placement5.holeIndex (v - 16)) recover.1
  · exact rawZero _ lo far notY notR (origin_work_clean origin ctx _ wk)
  · rw [sel]
    exact rawZero 2409 (by omega) (by omega) (by omega) (by omega) ctx.hg0
  · rw [y1, encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA 771 (by omega) (by omega))]
    apply (regValue_zero _ _).mp (by simpa only [ZMod.val_zero] using pair.2.1)
    exact List.mem_map.mpr ⟨771, by simp [List.mem_range'_1], rfl⟩
  · rw [y2, encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA 772 (by omega) (by omega))]
    apply (regValue_zero _ _).mp (by simpa only [ZMod.val_zero] using pair.2.1)
    exact List.mem_map.mpr ⟨772, by simp [List.mem_range'_1], rfl⟩

theorem sig511_invol (q : Wire) : OB5.sig 511 (OB5.sig 511 q) = q :=
  OB5.sig_invol 511 (by decide) q


/-- The `center760` ladder is clean on the record's center input frame. -/
theorem center_ladder_clean {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0) (X : Fp) (s : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame isA origin X 0 s) :
    ∀ q ∈ converterLayout760.carry.take 254, s.basis q = false := by
  intro q hq
  have h := canonical_pulled_zero origin ctx ha X (pullState (OB5.sig 511) s) input
    (OB5.sig 511 q) (ladder_classified q hq)
  change s.basis (OB5.sig 511 (OB5.sig 511 q)) = false at h
  rwa [sig511_invol] at h

/-! ## Unconditional run equalities on reachable states -/


/-- Same frame as `R2SqEp760.center760_run_eq`; independent records. -/
theorem center760Loan_run_eq {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0) (X : Fp) (s : State)
    (m n : List Bool)
    (input : Rolling1588Frame.EncodedCanonicalFrame isA origin X 0 s) :
    run center760Loan m s = run R2SqEp760.center760 n s :=
  center760Loan_run_eq_of_clean s (center_ladder_clean origin ctx ha X s input) m n



end ECDSAAdd.Entrant.StairBoundaryLoan
end Merge_StairBoundaryLoanFrames_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanDivEndpointSupport_at_QTop` -/
section Merge_StairLoanDivEndpointSupport_at_QTop

/-!
# The loaned division endpoint stays inside the record endpoint

LT8's `CompareDecoder.BoundaryLoan.endPacket760DivLoan` (division endpoint with
the 44 exclusive roles hosted on ladder carries 11–54) has the same wrappers as
`R2SqEp760.endPacket760 true`.  This module proves

* `cellDecoderLoan_sub : wires cellDecoderLoan ⊆ wires CompareDecoder.cellDecoderNext`
* `endPacket760DivLoan_sub :
    wires endPacket760DivLoan ⊆ wires (R2SqEp760.endPacket760 true)`

without evaluating either decoder.  Every wire of the loaned comparison window
is a comparison input (`xs`, restored by `restoreSource`), a ladder carry
(`cs`, inverted by `invertCarry` inside `cmpFront`), the carry-in `cin`, or a
wire of the record's `lowBlock` / `cmpBack` middle block.  The ladder facts are
generic in the literal bits; the only concrete check is that the 44 roles are
ladder carries (`holes_in_carry_check`, 44 × 255 comparisons).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan.Inclusion

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed

attribute [local irreducible] wires

/-! ## Variable-program helpers -/

theorem mem_nine {P1 P2 P3 P4 P5 P6 P7 P8 P9 : Program} {q : Wire}
    (h : q ∈ wires P1 ∨ q ∈ wires P2 ∨ q ∈ wires P3 ∨ q ∈ wires P4 ∨
      q ∈ wires P5 ∨ q ∈ wires P6 ∨ q ∈ wires P7 ∨ q ∈ wires P8 ∨ q ∈ wires P9) :
    q ∈ wires (P1 ++ P2 ++ P3 ++ P4 ++ P5 ++ P6 ++ P7 ++ P8 ++ P9) := by
  simp only [wires_append, Finset.mem_union, or_assoc]
  exact h

theorem mem_four {P1 P2 P3 P4 : Program} {q : Wire}
    (h : q ∈ wires P1 ∨ q ∈ wires P2 ∨ q ∈ wires P3 ∨ q ∈ wires P4) :
    q ∈ wires (P1 ++ P2 ++ P3 ++ P4) := by
  simp only [wires_append, Finset.mem_union, or_assoc]
  exact h

theorem append_sub (P Q P0 Q0 : Program)
    (hp : wires P ⊆ wires P0) (hq : wires Q ⊆ wires Q0) :
    wires (P ++ Q) ⊆ wires (P0 ++ Q0) := by
  rw [wires_append, wires_append]
  exact Finset.union_subset_union hp hq

theorem rename_sub (f : Wire → Wire) (P Q : Program)
    (sub : wires P ⊆ wires Q) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) := by
  rw [renameProgram_support, renameProgram_support]
  exact Finset.image_mono f sub

theorem mem_map_X (l : List Wire) (q : Wire) (h : q ∈ wires (l.map Instr.X)) :
    q ∈ l := by
  induction l with
  | nil => simp [wires] at h
  | cons a l ih =>
      simp only [List.map_cons, wires, Instr.wires, Finset.mem_union,
        Finset.mem_singleton] at h
      rcases h with h | h
      · exact List.mem_cons.mpr (Or.inl h)
      · exact List.mem_cons.mpr (Or.inr (ih h))

theorem map_X_mem (l : List Wire) (q : Wire) (h : q ∈ l) :
    q ∈ wires (l.map Instr.X) := by
  induction l with
  | nil => simp at h
  | cons a l ih =>
      simp only [List.map_cons, wires, Instr.wires, Finset.mem_union,
        Finset.mem_singleton]
      rcases List.mem_cons.mp h with h | h
      · exact Or.inl h
      · exact Or.inr (ih h)

theorem map_CX_mem (c : Wire) (l : List Wire) (q : Wire) (h : q ∈ l) :
    q ∈ wires (l.map (fun t => Instr.CX c t)) := by
  induction l with
  | nil => simp at h
  | cons a l ih =>
      simp only [List.map_cons, wires, Finset.mem_union]
      rcases List.mem_cons.mp h with h | h
      · left
        simp [Instr.wires, h]
      · exact Or.inr (ih h)

/-! ## Literal-bit carry layers touch only their inputs, carries and carry-in -/

theorem gate_wires (b : MappedBit) (y c0 c : Wire) (hw : b.wire = none) (q : Wire)
    (hq : q ∈ wires (mappedMajority b y c0 c) ∨ q ∈ wires (mappedEraseCarry b y c0 c)) :
    q = y ∨ q = c0 ∨ q = c := by
  cases hf : b.flip <;>
    simp [mappedMajority, mappedEraseCarry, hw, hf, wires, Instr.wires,
      correctionWires] at hq <;> tauto

theorem layer_facts (bits : List MappedBit) :
    ∀ (ys hs : List Wire) (c0 : Wire), (∀ b ∈ bits, b.wire = none) →
      ∀ l ∈ StairLoan.mappedLayers bits ys hs c0,
        l.host ∈ hs ∧
          ∀ q, q ∈ wires l.up ∨ q ∈ wires l.erase → q ∈ ys ∨ q ∈ hs ∨ q = c0 := by
  induction bits with
  | nil =>
      intro ys hs c0 _ l hl
      simp [StairLoan.mappedLayers] at hl
  | cons b bits ih =>
      intro ys hs c0 hb l hl
      rcases bits with _ | ⟨b', bits'⟩
      · simp [StairLoan.mappedLayers] at hl
      rcases ys with _ | ⟨y, _ | ⟨y', ys'⟩⟩
      · simp [StairLoan.mappedLayers] at hl
      · simp [StairLoan.mappedLayers] at hl
      rcases hs with _ | ⟨c, hs'⟩
      · simp [StairLoan.mappedLayers] at hl
      simp only [StairLoan.mappedLayers, List.mem_cons] at hl
      rcases hl with rfl | hl
      · refine ⟨List.mem_cons.mpr (Or.inl rfl), ?_⟩
        intro q hq
        rcases gate_wires b y c0 c (hb b (List.mem_cons.mpr (Or.inl rfl))) q hq with
          h | h | h
        · exact Or.inl (List.mem_cons.mpr (Or.inl h))
        · exact Or.inr (Or.inr h)
        · exact Or.inr (Or.inl (List.mem_cons.mpr (Or.inl h)))
      · have r := ih (y' :: ys') hs' c
          (fun x hx => hb x (List.mem_cons.mpr (Or.inr hx))) l hl
        refine ⟨List.mem_cons.mpr (Or.inr r.1), ?_⟩
        intro q hq
        rcases r.2 q hq with h | h | h
        · exact Or.inl (List.mem_cons.mpr (Or.inr h))
        · exact Or.inr (Or.inl (List.mem_cons.mpr (Or.inr h)))
        · exact Or.inr (Or.inl (List.mem_cons.mpr (Or.inl h)))

/-- The comparison ladder: hosts are carries, no sum writes, and every wire of
an up/erase step is an input, a carry, or the carry-in. -/
theorem ladder_facts : ∀ l ∈ ladder,
    l.host ∈ cs ∧ l.finish = [] ∧
      ∀ q, q ∈ wires l.up ∨ q ∈ wires l.erase → q ∈ xs ∨ q ∈ cs ∨ q = cin := by
  intro l hl
  unfold ladder at hl
  obtain ⟨l0, h0, rfl⟩ := List.mem_map.mp hl
  have bitsNone : ∀ b ∈ borrowBits, b.wire = none := by
    intro b hb
    unfold borrowBits at hb
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hb
    rfl
  have f := layer_facts borrowBits (xs ++ [cin]) cs cin bitsNone l0 h0
  refine ⟨f.1, rfl, ?_⟩
  intro q hq
  rcases f.2 q hq with h | h | h
  · rcases List.mem_append.mp h with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (List.mem_singleton.mp h))
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr h)

theorem emitUps_all (ls : List StairLoan.CarryLayer) (P : Wire → Prop)
    (h : ∀ l ∈ ls, ∀ q ∈ wires l.up, P q) :
    ∀ q ∈ wires (StairLoan.emitUps ls), P q := by
  induction ls with
  | nil =>
      intro q hq
      simp [StairLoan.emitUps, wires] at hq
  | cons l ls ih =>
      intro q hq
      simp only [StairLoan.emitUps, wires_append, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact h l (List.mem_cons.mpr (Or.inl rfl)) q hq
      · exact ih (fun l' hl' => h l' (List.mem_cons.mpr (Or.inr hl'))) q hq

theorem emitDowns_all (ls : List StairLoan.CarryLayer) (P : Wire → Prop)
    (h : ∀ l ∈ ls, ∀ q ∈ wires l.down, P q) :
    ∀ q ∈ wires (StairLoan.emitDowns ls), P q := by
  induction ls with
  | nil =>
      intro q hq
      simp [StairLoan.emitDowns, wires] at hq
  | cons l ls ih =>
      intro q hq
      simp only [StairLoan.emitDowns, wires_append, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact ih (fun l' hl' => h l' (List.mem_cons.mpr (Or.inr hl'))) q hq
      · exact h l (List.mem_cons.mpr (Or.inl rfl)) q hq

theorem ups_ladder (ls : List StairLoan.CarryLayer) (sub : ∀ l ∈ ls, l ∈ ladder) :
    ∀ q ∈ wires (StairLoan.emitUps ls), q ∈ xs ∨ q ∈ cs ∨ q = cin :=
  emitUps_all ls _ (fun l hl q hq => (ladder_facts l (sub l hl)).2.2 q (Or.inl hq))

theorem downs_ladder (ls : List StairLoan.CarryLayer) (sub : ∀ l ∈ ls, l ∈ ladder) :
    ∀ q ∈ wires (StairLoan.emitDowns ls), q ∈ xs ∨ q ∈ cs ∨ q = cin := by
  apply emitDowns_all ls
  intro l hl q hq
  have f := ladder_facts l (sub l hl)
  unfold StairLoan.CarryLayer.down at hq
  rw [wires_append, f.2.1] at hq
  rcases Finset.mem_union.mp hq with hq | hq
  · exact f.2.2 q (Or.inr hq)
  · simp [wires] at hq

theorem head_ladder : ∀ l ∈ headL, l ∈ ladder :=
  fun _ hl => List.mem_of_mem_take hl

theorem tail_ladder : ∀ l ∈ tailL, l ∈ ladder :=
  fun _ hl => List.mem_of_mem_drop hl

/-- The only concrete check: the 44 roles are ladder carries (positions
208–252 without 248 of `base 512 ..`). -/
theorem holes_in_carry_check :
    StairBoundaryLoan.exclusiveHoles.all (fun q => decide (q ∈ cs)) = true := by
  decide +kernel

theorem holes_in_carry : ∀ q ∈ StairBoundaryLoan.exclusiveHoles, q ∈ cs := by
  intro q hq
  exact of_decide_eq_true (List.all_eq_true.mp holes_in_carry_check q hq)

/-! ## Membership in the record decoder -/

theorem ladder_in_record (q : Wire) (h : q ∈ xs ∨ q ∈ cs ∨ q = cin) :
    q ∈ wires CompareDecoder.cellDecoderNext := by
  unfold CompareDecoder.cellDecoderNext
  rcases h with h | h | h
  · apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_)))))))
    unfold TerminalGraph.restoreSource
    exact map_CX_mem _ _ q h
  · apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))
    unfold CompareDecoder.cmpFront
    apply mem_four
    refine Or.inr (Or.inr (Or.inr ?_))
    unfold CompareDecoder.invertCarry
    exact map_X_mem _ q h
  · apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))
    unfold CompareDecoder.cmpFront
    apply mem_four
    refine Or.inl ?_
    subst h
    simp [wires, Instr.wires, cin]

theorem top760_in_record : ∀ q ∈ wires top760, q ∈ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  unfold top760 at hq
  simp only [wires_append, Finset.mem_union, or_assoc] at hq
  rcases hq with hn | hx | hl | hb | hl' | hk | hn'
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn))
  · refine ladder_in_record q (Or.inr (Or.inr ?_))
    simpa [wires, Instr.wires] using hx
  · have h : q ∈ (cs.drop 5).take 6 := mem_map_X _ q hl
    exact ladder_in_record q (Or.inr (Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h))))
  · unfold CompareDecoder.cellDecoderNext
    apply mem_nine
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hb)))))
  · have h : q ∈ (cs.drop 5).take 6 := mem_map_X _ q hl'
    exact ladder_in_record q (Or.inr (Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h))))
  · unfold CompareDecoder.cellDecoderNext
    apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))))
    unfold CompareDecoder.cmpBack
    apply mem_four
    exact Or.inr (Or.inl hk)
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn'))

theorem emitLoan_in_record :
    ∀ q ∈ wires (StairLoan.emitLoan 44 StairBoundaryLoan.exclusiveHoles tailL top760),
      q ∈ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  have env := StairLoanSupport.emitLoan_support_envelope 44
    StairBoundaryLoan.exclusiveHoles tailL top760 hq
  simp only [Finset.mem_union, List.mem_toFinset] at env
  rcases env with (sweep | role) | host
  · unfold StairLoan.emitSweep at sweep
    simp only [wires_append, Finset.mem_union] at sweep
    rcases sweep with (up | top) | down
    · exact ladder_in_record q (ups_ladder tailL tail_ladder q up)
    · exact top760_in_record q top
    · exact ladder_in_record q (downs_ladder tailL tail_ladder q down)
  · exact ladder_in_record q (Or.inr (Or.inl (holes_in_carry q (List.mem_of_mem_take role))))
  · unfold StairLoan.layerHosts at host
    obtain ⟨l, hl, rfl⟩ := List.mem_map.mp host
    exact ladder_in_record _
      (Or.inr (Or.inl (ladder_facts l (tail_ladder l (List.mem_of_mem_take hl))).1))

theorem window_in_record : ∀ q ∈ wires (window760 44),
    q ∈ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  unfold window760 at hq
  simp only [wires_append, Finset.mem_union, or_assoc] at hq
  rcases hq with hn | hu | hl | hd | hn'
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn))
  · exact ladder_in_record q (ups_ladder headL head_ladder q hu)
  · exact emitLoan_in_record q hl
  · exact ladder_in_record q (downs_ladder headL head_ladder q hd)
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn'))

/-! ## The loaned decoder and endpoint -/

theorem cellDecoderLoan_sub :
    wires cellDecoderLoan ⊆ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  unfold cellDecoderLoan at hq
  simp only [wires_append, Finset.mem_union, or_assoc] at hq
  rcases hq with h | h | h | h | h | h | h | h | h
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inl h)
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inl h))
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inl h)))
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inr (Or.inl h))))
  · refine ladder_in_record q (Or.inr (Or.inr ?_))
    simpa [wires, Instr.wires] using h
  · exact window_in_record q h
  · simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
    rcases h with h | h | h
    · subst h
      unfold CompareDecoder.cellDecoderNext
      apply mem_nine
      refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))))
      unfold CompareDecoder.cmpBack
      apply mem_four
      refine Or.inr (Or.inl ?_)
      simp [wires, Instr.wires]
    · exact ladder_in_record q (Or.inr (Or.inr h))
    · simp at h
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))))))

theorem endPacket760_true_shape :
