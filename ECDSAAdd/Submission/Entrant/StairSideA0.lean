      (good_unpackFirst base f h5 hf base_history_indom)⟩











theorem sound_hostedX : Sound StairSchedule.hostedX :=
  ⟨by simp [StairSchedule.hostedX, GatePhysical, PhysicalInstr, ProperGate],
