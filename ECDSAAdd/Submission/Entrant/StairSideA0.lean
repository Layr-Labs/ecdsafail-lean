/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBridgeDomain_at_QTop` -/
section Merge_StairBridgeDomain_at_QTop

/-!
# Real-walk checkpoint domain and width bridge

This file derives the codec and moved-tick arithmetic premises from the
record's actual 256-bit Skywalk hypotheses.  No checkpoint state, domain, or
fit predicate is assumed as a field of a primitive-provider structure.
-/

set_option autoImplicit false
set_option maxRecDepth 12000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairBridgeDomain

open ECDSAAdd Arithmetic

def realNatState (x p i : Nat) : SkywalkNat.State :=
  SkywalkNat.step^[i] (SkywalkNat.init x p)

def realRails (x p i : Nat) : SkywalkRails.State :=
  SkywalkTrace.next^[i]
    (SkywalkRails.encode false false (x : Int) (p : Int))

/-- The canonical codec sign is the arithmetic sign of the smaller rail.
Unlike the existential sign in `iter_encoded`, this definition normalizes a
zero magnitude to `false`. -/
def checkpointSign (r : SkywalkRails.State) : Bool :=
  SkywalkRails.neg (if r.g then r.a else r.b)

def realSign (x p i : Nat) : Bool := checkpointSign (realRails x p i)


/-- Value-level orientation consumes the raw `g` bit and produces the exact
canonical rail order expected by the codec/tick boundary. -/
def orientRails (r : SkywalkRails.State) : SkywalkRails.State :=
  if r.g then ⟨r.b, r.a, false⟩ else ⟨r.a, r.b, false⟩

theorem orientRails_encode (G S : Bool) (u v : Nat) :
    orientRails (SkywalkRails.encode G S (u : Int) (v : Int)) =
      SkywalkRails.encode false
        (checkpointSign (SkywalkRails.encode G S (u : Int) (v : Int)))
        (u : Int) (v : Int) := by
  cases G <;> cases S <;> by_cases hu : u = 0 <;>
    simp [orientRails, checkpointSign, SkywalkRails.encode,
      SkywalkRails.signed, SkywalkRails.neg, hu]


theorem natBitLength_le_of_lt_pow (x a : Nat) (h : x < 2 ^ a) :
    StairCodec.natBitLength x ≤ a := by
  by_cases hx : x = 0
  · simp [hx, StairCodec.natBitLength]
  · have hlog := (Nat.log2_lt hx).mpr h
    simp [StairCodec.natBitLength, hx]
    omega



/-- One actual record tick satisfies LT2's exact signed range predicate. -/
theorem real_fit (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hodd : p % 2 = 1)
    (hp : p < 2 ^ 256) (hgap : p + 2 ^ 32 ≤ 2 ^ 256)
    (hx : x < p) (hcop : x.Coprime p) (hi : i < 512) :
    StairSegment.Fits i (realRails x p i) := by
  have h := W.narrowSkywalk_iter_fit x p i hp0 hx0 hodd hp hgap hx hcop hi
  dsimp only [realRails] at h
  refine ⟨h.1, ?_, ?_, ?_, ?_⟩
  · simpa only [W.compactSkywalkTickPostWidth] using h.2.1
  · simpa only [W.compactSkywalkTickPostWidth] using h.2.2.1
  · simpa only [W.compactSkywalkTickPostWidth] using h.2.2.2.1
  · simpa only [W.compactSkywalkTickPostWidth] using h.2.2.2.2

/-- Swapping the two rails according to the stored orientation preserves the
arithmetic fit predicate: `route` still selects the same even rail first. -/
theorem fits_orientRails (i : Nat) (r : SkywalkRails.State)
    (h : StairSegment.Fits i r) :
    StairSegment.Fits i (orientRails r) := by
  by_cases hg : r.g = true
  · have routeEq : SkywalkRails.route r.b r.a =
        SkywalkRails.route r.a r.b := by
      have hpar := h.odd
      by_cases ha : r.a % 2 = 0
      · have hb : r.b % 2 ≠ 0 := by
          intro hb
          omega
        simp [SkywalkRails.route, SkywalkRails.odd, ha, hb]
      · have hb : r.b % 2 = 0 := by omega
        simp [SkywalkRails.route, SkywalkRails.odd, ha, hb]
    refine ⟨by simpa [orientRails, hg, Int.add_comm] using h.odd, ?_, ?_, ?_, ?_⟩
    · simpa [orientRails, hg, routeEq] using h.halfMin
    · simpa [orientRails, hg, routeEq] using h.halfMax
    · simpa [orientRails, hg, routeEq] using h.otherMin
    · simpa [orientRails, hg, routeEq] using h.otherMax
  · have hgf : r.g = false := Bool.eq_false_of_not_eq_true hg
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [orientRails, hgf] using h.odd
    · simpa [orientRails, hgf] using h.halfMin
    · simpa [orientRails, hgf] using h.halfMax
    · simpa [orientRails, hgf] using h.otherMin
    · simpa [orientRails, hgf] using h.otherMax

theorem orient_realRails (x p i : Nat) (hp0 : 0 < p) (hodd : p % 2 = 1) :
    orientRails (realRails x p i) =
      SkywalkRails.encode false (realSign x p i)
        ((realNatState x p i).u : Int) ((realNatState x p i).v : Int) := by
  obtain ⟨G, S, encoded⟩ :=
    SkywalkTrace.iter_encoded i false false (SkywalkNat.init x p) hp0 hodd
  change realRails x p i =
    SkywalkRails.encode G S ((realNatState x p i).u : Int)
      ((realNatState x p i).v : Int) at encoded
  rw [realSign, encoded]
  exact orientRails_encode G S (realNatState x p i).u (realNatState x p i).v

/-- Fit for the exact canonical orientation consumed by a moved first tick. -/
theorem canonical_real_fit (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hodd : p % 2 = 1)
    (hp : p < 2 ^ 256) (hgap : p + 2 ^ 32 ≤ 2 ^ 256)
    (hx : x < p) (hcop : x.Coprime p) (hi : i < 512) :
    StairSegment.Fits i
      (SkywalkRails.encode false (realSign x p i)
        ((realNatState x p i).u : Int) ((realNatState x p i).v : Int)) := by
  rw [← orient_realRails x p i hp0 hodd]
  exact fits_orientRails i (realRails x p i)
    (real_fit x p i hp0 hx0 hodd hp hgap hx hcop hi)


end ECDSAAdd.Entrant.StairBridgeDomain
end Merge_StairBridgeDomain_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBridgeFrame_at_QTop` -/
section Merge_StairBridgeFrame_at_QTop

/-!
# Satisfiable one-way checkpoint frame

`CodecInput` describes only the codec rails and codec work sites.  It cannot
be equivalent to a full `StairSegment.Stage`, which additionally constrains
future transcript, word-tail, predecessor, and carry wires.  This module
states those independent facts as an explicit frame and proves only the
sound direction `CodecInput ∧ frame → Stage`.
-/

set_option autoImplicit false
set_option maxRecDepth 12000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairBridgeFrame

open ECDSAAdd Arithmetic

theorem domain_u_lt_half (B u v : Nat) (sigma : Bool)
    (hd : StairCodec.CodecDomain B u v sigma) :
    u < 2 ^ (B - 1) := by
  by_cases hu : u = 0
  · subst u
    positivity
  · have hvbits : 1 ≤ StairCodec.natBitLength v := by
      simp [StairCodec.natBitLength, ne_of_gt hd.2.1]
    have hsum := hd.2.2.2.2.1
    have hubits : StairCodec.natBitLength u ≤ B - 1 := by
      omega
    have hult := StairCodec.nat_lt_pow_natBitLength_spec u
      (Nat.pos_of_ne_zero hu)
    exact hult.trans_le
      (Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hubits)

/-- A codec `signedWord`, followed by one copied sign bit, is exactly the
`B+1`-bit signed integer expected by the walk. -/
theorem extended_signedWord_value (B u v : Nat) (sigma : Bool)
    (hd : StairCodec.CodecDomain B u v sigma) :
    (StairCodec.signedWord B u sigma : Int) +
        ((2 ^ B : Nat) : Int) * sigma.toNat -
        (if sigma then ((2 ^ (B + 1) : Nat) : Int) else 0) =
      SkywalkRails.signed sigma (u : Int) := by
  have huHalf := domain_u_lt_half B u v sigma hd
  cases sigma with
  | false =>
      have huB : u < 2 ^ B := huHalf.trans_le
        (Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (by omega))
      simp [StairCodec.signedWord, SkywalkRails.signed,
        Nat.mod_eq_of_lt huB]
  | true =>
      have hu0 : 0 < u := by
        by_contra h
        have hz : u = 0 := by omega
        exact Bool.noConfusion ((hd.2.2.2.2.2 hz).2)
      have huPow : u ≤ 2 ^ B := by
        exact Nat.le_of_lt (huHalf.trans_le
          (Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (by omega)))
      have hsub : 2 ^ B - u < 2 ^ B := by omega
      rw [show StairCodec.signedWord B u true = 2 ^ B - u by
        simp [StairCodec.signedWord, Nat.mod_eq_of_lt hsub]]
      simp only [Bool.toNat_true, if_true, SkywalkRails.signed]
      rw [Nat.cast_sub huPow]
      have hnext : (2 : Nat) ^ (B + 1) = 2 * (2 : Nat) ^ B := by
        rw [pow_succ, Nat.mul_comm]
      rw [hnext]
      norm_num
      ring



end ECDSAAdd.Entrant.StairBridgeFrame
end Merge_StairBridgeFrame_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Boundary_at_QTop` -/
section Merge_StairField2V3Boundary_at_QTop

/-!
# Exact segment-end checkpoint boundary (with full-width orientation)

At the end of a moved segment the two rails are `(B+1)`-bit signed words in
the raw orientation recorded by the previous letter.  This module proves that
the repaired orientation `orientFull` (both rails *including* their top bits,
see defect G of `StairJunctionAudit`) followed by the existing sign copy
produces exactly `StairCodec.CodecInput` for the canonical checkpoint triple,
with both extension bits clean and every other wire unchanged.  The statement
is placement independent: the codec registers and extension wires are
arbitrary, subject only to distinctness.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Boundary

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed

/-- Orientation of both full rails, controlled by the raw letter. -/
def orientFull (letter : Wire) (L : StairCodec.Layout) (B : Nat)
    (sumExt diffExt : Wire) : Program :=
  swapRegisters letter (StairCodec.reg L.S B ++ [sumExt])
    (StairCodec.reg L.D B ++ [diffExt])

theorem reg_length (f : Nat → Wire) (n : Nat) : (StairCodec.reg f n).length = n := by
  simp [StairCodec.reg]

theorem regValue_single (q : Wire) (s : BasisState) :
    regValue [q] s = if s q then 1 else 0 := by
  cases h : s q <;> simp [regValue, h]

theorem signedWord_lt (B u : Nat) (sigma : Bool) :
    StairCodec.signedWord B u sigma < 2 ^ B := by
  unfold StairCodec.signedWord
  split
  · exact Nat.mod_lt _ (by positivity)
  · exact Nat.mod_lt _ (by positivity)



/-- Value-level decoding of an unsigned `(B+1)`-bit word with top bit `e`. -/
theorem unsigned_top (lo : List Wire) (e : Wire) (s : BasisState) (n : Nat)
    (h : signedRegValue (lo ++ [e]) s = (n : Int)) :
    s e = false ∧ regValue lo s = n := by
  have hmsb := signedRegValue_msb lo e s
  rw [h, regValue_append, regValue_single] at hmsb
  have hlt := regValue_lt lo s
  have hP2 : 2 ^ (lo.length + 1) = 2 * 2 ^ lo.length := by
    rw [pow_succ]
    ring
  rw [hP2] at hmsb
  generalize 2 ^ lo.length = P at hmsb hlt
  generalize regValue lo s = R at hmsb hlt ⊢
  cases he : s e
  · simp [he] at hmsb
    exact ⟨rfl, by omega⟩
  · simp [he] at hmsb
    omega

/-- Value-level decoding of the signed `(B+1)`-bit rail. -/
theorem signed_top (lo : List Wire) (e : Wire) (s : BasisState) (B u v : Nat)
    (sigma : Bool) (hlen : lo.length = B)
    (domain : StairCodec.CodecDomain B u v sigma)
    (h : signedRegValue (lo ++ [e]) s = SkywalkRails.signed sigma (u : Int)) :
    s e = sigma ∧ regValue lo s = StairCodec.signedWord B u sigma := by
  have hmsb := signedRegValue_msb lo e s
  rw [h, regValue_append, regValue_single, hlen] at hmsb
  have hlt := regValue_lt lo s
  rw [hlen] at hlt
  have hW := signedWord_lt B u sigma
  have ext := StairBridgeFrame.extended_signedWord_value B u v sigma domain
  rw [← ext] at hmsb
  have hP2 : 2 ^ (B + 1) = 2 * 2 ^ B := by
    rw [pow_succ]
    ring
  rw [hP2] at hmsb
  generalize 2 ^ B = P at hmsb hlt hW
  generalize regValue lo s = R at hmsb hlt ⊢
  generalize StairCodec.signedWord B u sigma = W at hmsb hW ⊢
  cases he : s e <;> cases sigma <;> simp [he] at hmsb ⊢ <;> omega

/-- The top bit of the low `B`-bit signed word is the sign. -/
theorem signedWord_topBit (L : StairCodec.Layout) (B u v : Nat) (sigma : Bool)
    (domain : StairCodec.CodecDomain B u v sigma) (s : BasisState)
    (h : regValue (StairCodec.reg L.D B) s = StairCodec.signedWord B u sigma) :
    s (L.D (B - 1)) = sigma := by
  have huHalf := StairBridgeFrame.domain_u_lt_half B u v sigma domain
  have hzero := domain.2.2.2.2.2
  obtain ⟨k, rfl⟩ : ∃ k, B = k + 1 := ⟨B - 1, by have := domain.1; omega⟩
  have split : StairCodec.reg L.D (k + 1) = StairCodec.reg L.D k ++ [L.D k] := by
    unfold StairCodec.reg
    rw [List.range_succ, List.map_append]
    rfl
  simp only [Nat.add_sub_cancel] at huHalf ⊢
  rw [split, regValue_append, regValue_single, reg_length] at h
  have hlow := regValue_lt (StairCodec.reg L.D k) s
  rw [reg_length] at hlow
  have hpow : 2 ^ (k + 1) = 2 * 2 ^ k := by
    rw [pow_succ]
    ring
  cases sigma
  · have hu : u < 2 ^ (k + 1) := by omega
    have hw : StairCodec.signedWord (k + 1) u false = u := by
      simp [StairCodec.signedWord, Nat.mod_eq_of_lt hu]
    rw [hw] at h
    cases ht : s (L.D k)
    · rfl
    · simp [ht] at h
      omega
  · have hu0 : 0 < u := by
      by_contra hz
      have := (hzero (by omega)).2
      exact Bool.noConfusion this
    have hw : StairCodec.signedWord (k + 1) u true = 2 ^ (k + 1) - u := by
      simp only [StairCodec.signedWord, if_true]
      exact Nat.mod_eq_of_lt (by omega)
    rw [hw] at h
    cases ht : s (L.D k)
    · simp [ht] at h
      omega
    · rfl

/-- **Segment-end boundary.**  From raw-orientation rails `rho` whose
canonical orientation is `encode false sigma u v`, full orientation and the
sign copy produce `CodecInput`'s two register values with both extension bits
clean, preserving phase and every wire outside the two full rails. -/
theorem segmentEnd_boundary (L : StairCodec.Layout) (B : Nat)
    (letter sumExt diffExt : Wire) (u v : Nat) (sigma : Bool)
    (domain : StairCodec.CodecDomain B u v sigma)
    (rho : SkywalkRails.State)
    (hrho : StairBridgeDomain.orientRails rho =
      SkywalkRails.encode false sigma (u : Int) (v : Int))
    (hnd : (letter :: ((StairCodec.reg L.S B ++ [sumExt]) ++
      (StairCodec.reg L.D B ++ [diffExt]))).Nodup)
    (s : State) (m : List Bool)
    (hletter : s.basis letter = rho.g)
    (ha : signedRegValue (StairCodec.reg L.S B ++ [sumExt]) s.basis = rho.a)
    (hb : signedRegValue (StairCodec.reg L.D B ++ [diffExt]) s.basis = rho.b) :
    let out := run (orientFull letter L B sumExt diffExt ++
      StairBridgeSign.signExtend (L.D (B - 1)) diffExt) m s
    out.phase = s.phase ∧
      regValue (StairCodec.reg L.S B) out.basis = u + v ∧
      regValue (StairCodec.reg L.D B) out.basis = StairCodec.signedWord B u sigma ∧
      out.basis sumExt = false ∧ out.basis diffExt = false ∧
      ∀ q, q ∉ StairCodec.reg L.S B → q ∉ StairCodec.reg L.D B →
        q ≠ sumExt → q ≠ diffExt → out.basis q = s.basis q := by
  intro out
  let A := StairCodec.reg L.S B ++ [sumExt]
  let D := StairCodec.reg L.D B ++ [diffExt]
  have lenA : A.length = B + 1 := by simp [A]
  have lenD : D.length = B + 1 := by simp [D]
  let k := measurementCount (swapRegisters letter A D)
  let s1 := run (swapRegisters letter A D) (m.take k) s
  have sw := swapRegisters_correct letter A D (lenA.trans lenD.symm) hnd s (m.take k)
  have hout : out = run (StairBridgeSign.signExtend (L.D (B - 1)) diffExt)
      (m.drop k) s1 := by
    rw [show out = run (orientFull letter L B sumExt diffExt ++
      StairBridgeSign.signExtend (L.D (B - 1)) diffExt) m s from rfl, run_append]
    rfl
  have key : (StairBridgeDomain.orientRails rho).a = (u : Int) + v ∧
      (StairBridgeDomain.orientRails rho).b = SkywalkRails.signed sigma (u : Int) := by
    rw [hrho]
    simp [SkywalkRails.encode]
  have sA : signedRegValue A s1.basis = (u : Int) + v := by
    have hreg := sw.2.2.1
    unfold signedRegValue at ha hb ⊢
    rw [hreg, hletter]
    unfold StairBridgeDomain.orientRails at key
    cases hg : rho.g
    · have k1 : rho.a = (u : Int) + v := by simpa [hg] using key.1
      rw [if_neg (by decide), ← k1]
      exact ha
    · have k1 : rho.b = (u : Int) + v := by simpa [hg] using key.1
      rw [if_pos rfl, ← k1, lenA, ← lenD]
      exact hb
  have sD : signedRegValue D s1.basis = SkywalkRails.signed sigma (u : Int) := by
    have hreg := sw.2.2.2
    unfold signedRegValue at ha hb ⊢
    rw [hreg, hletter]
    unfold StairBridgeDomain.orientRails at key
    cases hg : rho.g
    · have k2 : rho.b = SkywalkRails.signed sigma (u : Int) := by
        simpa [hg] using key.2
      rw [if_neg (by decide), ← k2]
      exact hb
    · have k2 : rho.a = SkywalkRails.signed sigma (u : Int) := by
        simpa [hg] using key.2
      rw [if_pos rfl, ← k2, lenD, ← lenA]
      exact ha
  have topA := unsigned_top (StairCodec.reg L.S B) sumExt s1.basis (u + v)
    (by exact_mod_cast sA)
  have topD := signed_top (StairCodec.reg L.D B) diffExt s1.basis B u v sigma
    (reg_length _ _) domain sD
  have hsignBit := signedWord_topBit L B u v sigma domain s1.basis topD.2
  -- distinctness facts from `hnd`
  have hnd' := (List.nodup_cons.mp hnd).2
  have dExtNotS : diffExt ∉ StairCodec.reg L.S B := by
    intro hm
    obtain ⟨_, _, h3⟩ := List.nodup_append.mp hnd'
    exact h3 diffExt (List.mem_append_left _ hm) diffExt (by simp) rfl
  have dExtNotD : diffExt ∉ StairCodec.reg L.D B := by
    intro hm
    obtain ⟨_, h2, _⟩ := List.nodup_append.mp hnd'
    have := (List.nodup_append.mp h2).2.2 diffExt hm diffExt (by simp)
    exact this rfl
  have sumNeDiff : sumExt ≠ diffExt := by
    intro e
    obtain ⟨_, _, h3⟩ := List.nodup_append.mp hnd'
    exact h3 sumExt (by simp) diffExt (by simp) e
  have signRun := StairBridgeSign.signExtend_run (L.D (B - 1)) diffExt s1 (m.drop k)
  rw [hout]
  refine ⟨signRun.1.trans sw.1, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← topA.2]
    exact (ECDSAAdd.Arithmetic.regValue_eq_iff _ _ _).mpr (fun q hq =>
      signRun.2.2 q (fun e => dExtNotS (e ▸ hq)))
  · rw [← topD.2]
    exact (ECDSAAdd.Arithmetic.regValue_eq_iff _ _ _).mpr (fun q hq =>
      signRun.2.2 q (fun e => dExtNotD (e ▸ hq)))
  · rw [signRun.2.2 sumExt sumNeDiff]
    exact topA.1
  · rw [signRun.2.1, topD.1, hsignBit]
    cases sigma <;> rfl
  · intro q hS hD hsum hdiff
    rw [signRun.2.2 q hdiff]
    apply sw.2.1
    · intro hm
      rcases List.mem_append.mp hm with hm | hm
      · exact hS hm
      · exact hsum (List.mem_singleton.mp hm)
    · intro hm
      rcases List.mem_append.mp hm with hm | hm
      · exact hD hm
      · exact hdiff (List.mem_singleton.mp hm)



end ECDSAAdd.Entrant.StairField2V3Boundary

end
end Merge_StairField2V3Boundary_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairFirstTickV3_at_QTop` -/
section Merge_StairFirstTickV3_at_QTop

/-!
# First moved tick on the decoded, oriented checkpoint (LT30)

At each checkpoint row `B` (start `s = startFor B` ∈ {425, 450, 465, 480, 490, 500})
the first moved tick `tickForward s = TickRanges.tick (segmentMap B) s` runs on the
decoded, ORIENTED checkpoint: the previous letter sits on the clean spare 717, and
the two rails are `orientRails (realRails x p s)`, not the record's canonical
stage.  This file proves, for every row:

* `tick_trip` — `tickReverse s ∘ tickForward s = id` on such a checkpoint
  (exit side: LT24 `rowPieces_chain.tick`, `termPieces` link `tick 500`);
* `tick_forward` — the tick advances the re-rooted local stage to `s + 1`;
* `virtual_stage` (naturality) — a local stage at `s + 1` yields a VIRTUAL state
  that agrees with the physical one outside the virtual sites (images under
  `midSegmentMap B` of the past ids `< s`, `1028 + j (j < s)` and `1797`) and
  satisfies the record's `Rolling1588.Integer.Stage (midSegmentMap B) … (s + 1)`;
* `middle_virtual` — the exact `virtual` premise of LT24's `middle_trip_local`
  / `terminal_middle_trip` (agreement on the moved middle programs' wires).

A genuine `Integer.Stage` on the moved map cannot hold physically (the moved
map puts the old letters on clean shadow labels), so the stage is stated on a
virtual state, generically in the row (`virtual_generic`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairFirstTickV3

open ECDSAAdd Arithmetic
open MappedCompressed StairPhysicalLayout

/-! ## Orientation is invisible after one tick (LT14 `StairScheduleRepair`) -/

theorem step_orientRails (r : SkywalkRails.State) (hodd : (r.a + r.b) % 2 = 1) :
    SkywalkRails.step (StairBridgeDomain.orientRails r) =
      SkywalkRails.step r := by
  obtain ⟨a, b, g⟩ := r
  have hsum : (a + b) % 2 = 1 := hodd
  cases g with
  | false => rfl
  | true =>
      show SkywalkRails.step ⟨b, a, false⟩ = SkywalkRails.step ⟨a, b, true⟩
      by_cases ha : a % 2 = 0
      · have hb : b % 2 ≠ 0 := by omega
        simp [SkywalkRails.step, SkywalkRails.route, SkywalkRails.odd, ha, hb]
      · have hb : b % 2 = 0 := by omega
        simp [SkywalkRails.step, SkywalkRails.route, SkywalkRails.odd, ha, hb]

theorem next_orientRails (r : SkywalkRails.State) (hodd : (r.a + r.b) % 2 = 1) :
    SkywalkTrace.next (StairBridgeDomain.orientRails r) = SkywalkTrace.next r := by
  simp only [SkywalkTrace.next, step_orientRails r hodd]

theorem code_orientRails (r : SkywalkRails.State) (hodd : (r.a + r.b) % 2 = 1) :
    SkywalkTrace.code (StairBridgeDomain.orientRails r) = SkywalkTrace.code r := by
  simp only [SkywalkTrace.code, step_orientRails r hodd]

theorem railAt_orientRails (r : SkywalkRails.State)
    (hodd : (r.a + r.b) % 2 = 1) (j : Nat) :
    StairSegment.railAt (StairBridgeDomain.orientRails r) (j + 1) =
      StairSegment.railAt r (j + 1) := by
  simp only [StairSegment.railAt, Function.iterate_succ_apply,
    next_orientRails r hodd]

theorem realRails_odd (x p i : Nat) (hp0 : 0 < p) (hodd : p % 2 = 1) :
    ((StairBridgeDomain.realRails x p i).a +
      (StairBridgeDomain.realRails x p i).b) % 2 = 1 := by
  obtain ⟨G, S, encoded⟩ :=
    SkywalkTrace.iter_encoded i false false (SkywalkNat.init x p) hp0 hodd
  have valid := SkywalkNat.iter_valid i (SkywalkNat.init x p) hp0 hodd
  change StairBridgeDomain.realRails x p i = _ at encoded
  rw [encoded]
  exact SkywalkRails.encode_odd_sum G S _ _ (by exact_mod_cast valid.2.1)

/-! ## Record hypotheses and the decoded checkpoint -/

/-- The record's arithmetic hypotheses on the walk input (as in
`StairBridgeFirstTick.real_tick_spec`). -/
structure RealHyp (x p : Nat) : Prop where
  p0 : 0 < p
  x0 : 0 < x
  odd : p % 2 = 1
  lt : p < 2 ^ 256
  gap : p + 2 ^ 32 ≤ 2 ^ 256
  xlt : x < p
  cop : x.Coprime p

/-- The decoded, oriented checkpoint right before the first moved tick: the
re-rooted local stage at the checkpoint itself.  Rail `a` is the word
`reg S B ++ [base 512]`, rail `b` is `reg D B ++ [bSite B]`
(`physicalLayout_aWord/bWord`), the previous letter is `0` on `base 717`, and the
future words, future `s` letters and the carry bank are clean. -/
def Decoded (B x p : Nat) (y : BasisState) : Prop :=
  StairSegment.Stage (segmentMap B) (startFor B)
    (StairBridgeDomain.orientRails (StairBridgeDomain.realRails x p (startFor B)))
    (startFor B) y

theorem budget_range (B : Nat) (hB : B ∈ budgets) :
    425 ≤ startFor B ∧ startFor B ≤ 500 ∧ startFor B % 5 = 0 ∧
      512 - startFor B = B ∧ endFor B ≤ 505 ∧
      StairPhysicalPrimitives.segmentOf (startFor B + 1) = B := by
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> decide


theorem tickReverse_eq (B : Nat) (hB : B ∈ budgets) :
    StairPhysicalPrimitives.tickReverse (startFor B) =
      W.ReverseCarry.compactReceiverTick (segmentMap B) (startFor B) := by
  unfold StairPhysicalPrimitives.tickReverse
  rw [(budget_range B hB).2.2.2.1]

/-! ## `Decoded` from the codec output -/

/-- Register values of the codec interface give the two signed rails (LT14
`StairSegmentBoundary.canonical_values`). -/
theorem canonical_values (L : StairCodec.Layout) (B u v : Nat) (sigma : Bool)
    (sumExt diffExt : Wire) (domain : StairCodec.CodecDomain B u v sigma)
    (s : BasisState)
    (hS : regValue (StairCodec.reg L.S B) s = u + v)
    (hD : regValue (StairCodec.reg L.D B) s = StairCodec.signedWord B u sigma)
    (hsum : s sumExt = false) (hdiff : s diffExt = sigma) :
    signedRegValue (StairCodec.reg L.S B ++ [sumExt]) s = (u : Int) + v ∧
      signedRegValue (StairCodec.reg L.D B ++ [diffExt]) s =
        SkywalkRails.signed sigma (u : Int) := by
  have hlen : (StairCodec.reg L.D B).length = B := by simp [StairCodec.reg]
  have hsingle : ∀ q : Wire, regValue [q] s = if s q then 1 else 0 := by
    intro q
    cases h : s q <;> simp [regValue, h]
  constructor
  · rw [signedRegValue_msb, regValue_append, hsingle, hS, hsum]
    simp
  · rw [signedRegValue_msb, regValue_append, hsingle, hD, hdiff, hlen]
    have ext := StairBridgeFrame.extended_signedWord_value B u v sigma domain
    rw [← ext]
    cases sigma <;> simp


/-! ## The first moved tick: round trip and forward step -/



/-! ## Virtual sites and the virtual raw state -/

/-- Pool ids that hold the record's past at a row starting at `l`: the letters
`g j`, `s j` (`j < l`) and the record scratch id `1797`.  On the moved map these
are shadow labels (plus the old letter `base (l - 1)`). -/
def Virt (l id : Nat) : Prop := id < l ∨ (1028 ≤ id ∧ id < 1028 + l) ∨ id = 1797

/-- Wires that carry a virtual pool id under the moved map `wm`. -/
def VWire (wm : Nat → Wire) (l : Nat) (q : Wire) : Prop := ∃ id, Virt l id ∧ wm id = q

/-- Canonical record value of a virtual pool id. -/
def canon (r0 : SkywalkRails.State) (id : Nat) : Bool :=
  if id = 1797 then false
  else if id < 1028 then (SkywalkTrace.code (SkywalkTrace.next^[id] r0)).1
  else (SkywalkTrace.code (SkywalkTrace.next^[id - 1028] r0)).2

open Classical in
/-- The physical state with the record's past written on the virtual sites. -/
noncomputable def rawBasis (wm : Nat → Wire) (l : Nat) (r0 : SkywalkRails.State)
    (t : BasisState) : BasisState := fun q =>
  if h : VWire wm l q then canon r0 (Classical.choose h) else t q

theorem rawBasis_virt (wm : Nat → Wire) (l : Nat) (r0 : SkywalkRails.State)
    (t : BasisState) (hinj : Function.Injective wm) (id : Nat) (hv : Virt l id) :
    rawBasis wm l r0 t (wm id) = canon r0 id := by
  have h : VWire wm l (wm id) := ⟨id, hv, rfl⟩
  unfold rawBasis
  rw [dif_pos h]
  rw [hinj (Classical.choose_spec h).2]

theorem rawBasis_not (wm : Nat → Wire) (l : Nat) (r0 : SkywalkRails.State)
    (t : BasisState) (q : Wire) (hq : ¬ VWire wm l q) :
    rawBasis wm l r0 t q = t q := by
  unfold rawBasis
  rw [dif_neg hq]

theorem not_vwire (wm : Nat → Wire) (hinj : Function.Injective wm) (l id : Nat)
    (h : ¬ Virt l id) : ¬ VWire wm l (wm id) := by
  rintro ⟨id', hv, he⟩
  exact h (hinj he ▸ hv)

theorem block_take (w : Nat → Wire) (s len n : Nat) (h : n ≤ len) :
    (wireBlock w s len).take n = wireBlock w s n := by
  have e := wireBlock_append w s n (len - n)
  rw [show n + (len - n) = len by omega] at e
  rw [← e]
  exact List.take_left' (wireBlock_length w s n)

theorem block_drop (w : Nat → Wire) (s len n : Nat) (h : n ≤ len) :
    (wireBlock w s len).drop n = wireBlock w (s + n) (len - n) := by
  have e := wireBlock_append w s n (len - n)
  rw [show n + (len - n) = len by omega] at e
  rw [← e]
  exact List.drop_left' (wireBlock_length w s n)

theorem signed_congr (r : List Wire) (s t : BasisState) (h : ∀ q ∈ r, s q = t q) :
    signedRegValue r s = signedRegValue r t := by
  unfold signedRegValue
  rw [regValue_congr r s t h]

theorem block_clean (wm : Nat → Wire) (hinj : Function.Injective wm) (l s n : Nat)
    (h : ∀ id, s ≤ id → id < s + n → ¬ Virt l id) (q : Wire)
    (hq : q ∈ wireBlock wm s n) : ¬ VWire wm l q := by
  unfold wireBlock at hq
  obtain ⟨id, hid, rfl⟩ := List.mem_map.mp hq
  rw [List.mem_range'_1] at hid
  exact not_vwire wm hinj l id (h id hid.1 hid.2)

/-! ## Naturality: the local stage at `l + 1` is a record stage on a virtual state -/

/-! K4-D (replay budget): the non-virtual-id facts used by `raw_stage`, as standalone lemmas (an `omega` inside
`raw_stage` works over its whole context). -/
namespace K4DF
theorem vA (l P id : Nat) (hl : l + 1 < 512) (hP : P ≤ 258) (h1 : l + 1 ≤ id) (h2 : id < l + 1 + P) :
    l ≤ id ∧ ¬ Virt l id := by unfold Virt; omega
theorem vB (l P id : Nat) (hl : l + 1 < 512) (hP : P ≤ 258) (h1 : 770 ≤ id) (h2 : id < 770 + P) :
    l ≤ id ∧ ¬ Virt l id := by unfold Virt; omega
theorem vC (l id : Nat) (hl : l + 1 < 512) (h1 : 1540 ≤ id) (h2 : id < 1540 + 257) :
    l ≤ id ∧ ¬ Virt l id := by unfold Virt; omega
theorem vRA (l P id : Nat) (hl : l + 1 < 512) (hP : P ≤ 258) (h1 : l + 1 + P ≤ id)
    (h2 : id < l + 1 + P + (258 - P)) : l ≤ id ∧ ¬ Virt l id := by unfold Virt; omega
theorem vRB (l P id : Nat) (hl : l + 1 < 512) (hP : P ≤ 258) (h1 : 770 + P ≤ id)
    (h2 : id < 770 + P + (258 - P)) : l ≤ id ∧ ¬ Virt l id := by unfold Virt; omega
end K4DF

set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
/-- The virtual raw state satisfies the record's compact stage on the moved
middle map `wm`, given the local re-rooted stage of the physical state on the
tick map `w` (`w` and `wm` agree on all ids `≥ l`). -/
theorem raw_stage (w wm : Nat → Wire) (l : Nat) (hl : l + 1 < 512)
    (hinj : Function.Injective wm) (hagree : ∀ id, l ≤ id → wm id = w id)
    (r0 : SkywalkRails.State)
    (hodd : ((StairSegment.railAt r0 l).a + (StairSegment.railAt r0 l).b) % 2 = 1)
    (t : State)
    (ht : StairSegment.Stage w l
      (StairBridgeDomain.orientRails (StairSegment.railAt r0 l)) (l + 1) t.basis) :
    W.CompactSkywalkStage wm r0 (l + 1) (rawBasis wm l r0 t.basis) := by
  have hn : (skywalkPoolWires wm).Nodup := by
    unfold skywalkPoolWires wireBlock
    exact List.Nodup.map hinj List.nodup_range'
  rw [W.compactSkywalkStage_fields_iff wm r0 (l + 1) (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega) hn]
  have wb := W.compactSkywalkTick_width_bounds (l + 1) hl
  have hpw : W.compactSkywalkTickPreWidth (l + 1) = W.narrowSkywalkRouteWidth (l + 1) := rfl
  have keep : ∀ id, l ≤ id → ¬ Virt l id →
      rawBasis wm l r0 t.basis (wm id) = t.basis (w id) := by
    intro id h1 h2
    rw [rawBasis_not wm l r0 t.basis _ (not_vwire wm hinj l id h2), hagree id h1]
  have block : ∀ s n, (∀ id, s ≤ id → id < s + n → l ≤ id ∧ ¬ Virt l id) →
      wireBlock wm s n = wireBlock w s n ∧
        ∀ q ∈ wireBlock w s n, rawBasis wm l r0 t.basis q = t.basis q := by
    intro s n h
    constructor
    · unfold wireBlock
      apply List.map_congr_left
      intro id hid
      rw [List.mem_range'_1] at hid
      exact hagree id (h id hid.1 hid.2).1
    · intro q hq
      unfold wireBlock at hq
      obtain ⟨id, hid, rfl⟩ := List.mem_map.mp hq
      rw [List.mem_range'_1] at hid
      have e := hagree id (h id hid.1 hid.2).1
      rw [← e, keep id (h id hid.1 hid.2).1 (h id hid.1 hid.2).2, e]
  have rails : StairSegment.railAt
      (StairBridgeDomain.orientRails (StairSegment.railAt r0 l)) (l + 1 - l) =
        SkywalkTrace.next^[l + 1] r0 := by
    rw [show l + 1 - l = 0 + 1 from Nat.add_sub_cancel_left l 1, railAt_orientRails _ hodd 0]
    show SkywalkTrace.next^[0 + 1] (SkywalkTrace.next^[l] r0) = _
    rw [← Function.iterate_add_apply, show 0 + 1 + l = l + 1 from Nat.add_comm 1 l]
  have retA : (W.compactSkywalkSignPoolA wm (l + 1)).retained =
      wireBlock wm (l + 1) (W.compactSkywalkTickPreWidth (l + 1)) := by
    unfold W.compactSkywalkSignPoolA
    rw [← hpw, compactSkywalkSignWord_retained _ _ (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
      (by rw [skywalkPoolA, wireBlock_length]; (first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)), skywalkPoolA]
    exact block_take wm (l + 1) 258 _ (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
  have retB : (W.compactSkywalkSignPoolB wm (l + 1)).retained =
      wireBlock wm 770 (W.compactSkywalkTickPreWidth (l + 1)) := by
    unfold W.compactSkywalkSignPoolB
    rw [← hpw, compactSkywalkSignWord_retained _ _ (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
      (by rw [skywalkPoolB, wireBlock_length]; (first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)), skywalkPoolB]
    exact block_take wm 770 258 _ (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
  have relA : (W.compactSkywalkSignPoolA wm (l + 1)).released =
      wireBlock wm (l + 1 + W.compactSkywalkTickPreWidth (l + 1))
        (258 - W.compactSkywalkTickPreWidth (l + 1)) := by
    unfold W.compactSkywalkSignPoolA
    rw [← hpw]
    show (skywalkPoolA wm (l + 1)).drop _ = _
    rw [skywalkPoolA]
    exact block_drop wm (l + 1) 258 _ (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
  have relB : (W.compactSkywalkSignPoolB wm (l + 1)).released =
      wireBlock wm (770 + W.compactSkywalkTickPreWidth (l + 1))
        (258 - W.compactSkywalkTickPreWidth (l + 1)) := by
    unfold W.compactSkywalkSignPoolB
    rw [← hpw]
    show (skywalkPoolB wm).drop _ = _
    rw [skywalkPoolB]
    exact block_drop wm 770 258 _ (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
  have bA := block (l + 1) (W.compactSkywalkTickPreWidth (l + 1)) (
    fun id h1 h2 => K4DF.vA l _ id hl wb.2.2.2.1 h1 h2)
  have bB := block 770 (W.compactSkywalkTickPreWidth (l + 1)) (
    fun id h1 h2 => K4DF.vB l _ id hl wb.2.2.2.1 h1 h2)
  have bC := block 1540 257 (
    fun id h1 h2 => K4DF.vC l id hl h1 h2)
  have bRA := block (l + 1 + W.compactSkywalkTickPreWidth (l + 1))
      (258 - W.compactSkywalkTickPreWidth (l + 1)) (fun id h1 h2 => K4DF.vRA l _ id hl wb.2.2.2.1 h1 h2)
  have bRB := block (770 + W.compactSkywalkTickPreWidth (l + 1))
      (258 - W.compactSkywalkTickPreWidth (l + 1)) (fun id h1 h2 => K4DF.vRB l _ id hl wb.2.2.2.1 h1 h2)
  have hprev : skywalkPoolPreviousId (l + 1) = l := by
    unfold skywalkPoolPreviousId
    simp
  dsimp only [W.CompactSkywalkStageFields]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- rail a
    have va := ht.valueA
    rw [W.compactSkywalkTick_a w (l + 1) hl, rails] at va
    rw [retA, bA.1, signed_congr _ _ _ bA.2]
    exact va
  · -- rail b
    have vb := ht.valueB
    rw [W.compactSkywalkTick_b w (l + 1) hl, rails] at vb
    rw [retB, bB.1, signed_congr _ _ _ bB.2]
    exact vb
  · -- previous letter
    have vp := ht.previous
    rw [hprev, rails] at vp
    rw [hprev, keep l le_rfl (by unfold Virt; (first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega))]
    exact vp
  · -- past letters
    intro j hj
    by_cases hjl : j < l
    · rw [rawBasis_virt wm l r0 t.basis hinj j (Or.inl hjl),
        rawBasis_virt wm l r0 t.basis hinj (1028 + j) (Or.inr (Or.inl ⟨by omega, by omega⟩))]
      have e1 : canon r0 j = (SkywalkTrace.code (SkywalkTrace.next^[j] r0)).1 := by
        unfold canon
        rw [if_neg (show j ≠ 1797 by omega), if_pos (show j < 1028 by omega)]
      have e2 : canon r0 (1028 + j) = (SkywalkTrace.code (SkywalkTrace.next^[j] r0)).2 := by
        unfold canon
        rw [if_neg (show 1028 + j ≠ 1797 by omega), if_neg (show ¬ 1028 + j < 1028 by omega),
          Nat.add_sub_cancel_left]
      exact ⟨e1, e2⟩
    · have hjl' : j = l := by omega
      rw [hjl', keep l le_rfl (by unfold Virt; (first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)),
        keep (1028 + l) (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega) (by unfold Virt; (first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega))]
      have h4 := ht.letters l le_rfl (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega)
      have hc : SkywalkTrace.code (StairSegment.railAt
          (StairBridgeDomain.orientRails (StairSegment.railAt r0 l)) (l - l)) =
            SkywalkTrace.code (SkywalkTrace.next^[l] r0) := by
        rw [Nat.sub_self]
        exact code_orientRails _ hodd
      rw [hc] at h4
      exact h4
  · -- future words and future s letters
    intro j hj1 hj2
    constructor
    · rw [keep (j + 258) (by first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega) (by unfold Virt; (first | exact hl | exact wb.2.2.2.1 | exact Nat.lt_of_lt_of_le (by decide) wb.1 | exact Nat.lt_succ_self _ | exact Nat.le_add_right _ _ | exact Nat.le_refl _ | exact Nat.le_succ _ | omega))]
