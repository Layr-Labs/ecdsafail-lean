/-- Every wire named by the park pieces and by the kernel registers, except `ktmp`. -/
def outside (L : CuccaroStreamedSquareWideLayout) (ext : List Wire) (control : Wire) (src dst : List Wire) :
    List Wire :=
  control::L.core.cin::src++L.inputBank.take src.length++dst++L.leafPad++L.leafCarry++L.core.out++ext

/-! ## index helpers -/

theorem slice_index (l : List Wire) (a n : Nat) (q : Wire) (h : q∈(l.drop a).take n) :
    ∃ k, k<l.length ∧ a≤k ∧ k<a+n ∧ l.getD k 0=q := by
  obtain ⟨i,hi,e⟩ := List.mem_iff_getElem.mp h
  have hi' : i<n ∧ i<l.length-a := by simpa only [List.length_take,List.length_drop,Nat.lt_min] using hi
  obtain ⟨h1,h2⟩ := hi'
  refine ⟨a+i,by omega,by omega,by omega,?_⟩
  rw [List.getD_eq_getElem _ _ (by omega),← e]
  simp only [List.getElem_take,List.getElem_drop]

theorem slice_mem (xs : List Wire) (a n k : Nat)
    (hi : k<xs.length) (lo : a≤k) (bound : k<a+n) :
    xs.getD k 0∈(xs.drop a).take n := by
  apply List.mem_take_iff_getElem.mpr
  refine ⟨k-a,by simp only [List.length_drop];omega,?_⟩
  rw [List.getElem_drop,List.getD_eq_getElem _ _ hi]
  congr 1
  omega

theorem getD_index_inj (l : List Wire) (hl : l.Nodup) (i j : Nat) (hi : i<l.length) (hj : j<l.length)
    (h : l.getD i 0=l.getD j 0) : i=j := by
  rw [List.getD_eq_getElem _ _ hi,List.getD_eq_getElem _ _ hj] at h
  exact (List.Nodup.getElem_inj_iff hl).mp h

theorem take_as_slice (l : List Wire) (n : Nat) (q : Wire) (h : q∈l.take n) : q∈(l.drop 0).take n := by
  simpa only [List.drop_zero] using h

theorem rename_fix_free (e : Equiv.Perm Wire) (q : Wire) (P : Program) (fix : e q=q) (free : q∉wires P) :
    q∉wires (renameProgram e P) := by
  rw [renameProgram_support]
  intro h
  obtain ⟨y,hy,hyq⟩ := Finset.mem_image.mp h
  have : y=q := e.injective (hyq.trans fix.symm)
  exact free (this ▸ hy)

