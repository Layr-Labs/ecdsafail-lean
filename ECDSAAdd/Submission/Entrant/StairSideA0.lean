/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Decode_at_QTop` -/
section Merge_StairField2V3Decode_at_QTop

/-!
# LT21: the decoded checkpoint after `unpack B`

On a tail state holding the stored checkpoint `cmpBits B x` on the row's
future payload, clean on the row's scratch, and clean on the shadow labels
(`≥ base 4000`, never touched by any v3 primitive), the full `unpack B`
(unrelocation, codec unpack, sign copy) produces LT30's `Decoded` checkpoint
(`decoded_after_unpack`).  The zero sites are collected in `ZList B`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Decode

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack StairField2V3Pack



/-- Sites touched by `unpack B`. -/
def unpackSites (B : Nat) : List Wire :=
  moveSites (unrelocPairs B) ++ StairCodec.declaredSites (physicalLayout B) B ++ [bSite B]

/-- Sites known to be clean right after `unpack B`. -/
def ZList (B : Nat) : List Wire :=
  (rowSites B ++ StairField2V3Seg.allBC).filter
      (fun q => decide (q ∉ futurePayload B) && decide (q ∉ unpackSites B)) ++
    StairCodec.workSites (physicalLayout B) B ++
    (futurePayload B).filter (fun q => decide (q ∉ restLetters B) && decide (q ∉ aReg B) &&
      decide (q ∉ unpackSites B))







/-! ## LT49 (replay budget): `ZList B` as a bit-mask literal

`ZList B` is a quadratic filter (`futurePayload` / `unpackSites` membership per site); the
kernel re-evaluated it for every fact.  Its bit mask is checked once per budget
(`zlMask_eq`) and membership becomes a `Nat.testBit` on a literal (`mem_zl`). -/

/-- `StairLoan.maskOf (ZList B)`, as literals for the six budgets. -/
def zlMask (B : Nat) : Nat :=
  if B = 87 then
    
  else if B = 62 then
    
  else if B = 47 then
    
  else if B = 32 then
    
  else if B = 22 then
    
  else if B = 12 then
    
  else StairLoan.maskOf (ZList B)

/-- K1 (replay budget): a negated list-membership test as a bit test on the list's mask. -/
theorem k1_decide_not_mem (l : List Wire) (q : Wire) :
    decide (q ∉ l) = !(StairLoan.maskOf l).testBit q := by
  rw [StairLoan.testBit_maskOf]
  simp only [decide_not]

/-- `ZList B` with each membership filter on a list mask: the kernel evaluates every mask once
(a closed term, cached) instead of one list scan per site (quadratic). -/
def k1ZListM (B : Nat) : List Wire :=
  (rowSites B ++ StairField2V3Seg.allBC).filter
      (fun q => !(StairLoan.maskOf (futurePayload B)).testBit q &&
        !(StairLoan.maskOf (unpackSites B)).testBit q) ++
    StairCodec.workSites (physicalLayout B) B ++
    (futurePayload B).filter (fun q => !(StairLoan.maskOf (restLetters B)).testBit q &&
      !(StairLoan.maskOf (aReg B)).testBit q && !(StairLoan.maskOf (unpackSites B)).testBit q)

theorem k1_ZList_eq (B : Nat) : ZList B = k1ZListM B := by
  simp only [ZList, k1ZListM, k1_decide_not_mem]

theorem zlMask_eq (B : Nat) : StairLoan.maskOf (ZList B) = zlMask B := by
  unfold zlMask
  split_ifs with h87 h62 h47 h32 h22 h12
  · subst h87; rw [k1_ZList_eq]; decide +kernel
  · subst h62; rw [k1_ZList_eq]; decide +kernel
  · subst h47; rw [k1_ZList_eq]; decide +kernel
  · subst h32; rw [k1_ZList_eq]; decide +kernel
  · subst h22; rw [k1_ZList_eq]; decide +kernel
  · subst h12; rw [k1_ZList_eq]; decide +kernel
  · rfl

theorem mem_zl (B q : Nat) : q ∈ ZList B ↔ (zlMask B).testBit q = true := by
  rw [← zlMask_eq, StairLoan.testBit_maskOf, decide_eq_true_iff]


/-! ## K4C (replay budget): the `ZFacts*` range checks on their non-trivial parts only

Above label `513` (below `770`), between `858` and `1027`, and from `1627` on, `segMap` is the
shadow branch `base (4000 + q)`, so `base 4000 ≤ segmentMap B j` holds symbolically
(`k4d_hi`); the kernel only checks the remaining ids. -/











