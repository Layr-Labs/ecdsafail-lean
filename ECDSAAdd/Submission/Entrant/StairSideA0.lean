/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3ZT_at_QTop` -/
section Merge_StairField13V3ZT_at_QTop

/-!
# Field 13 on v3: static zero tracker (LT29), generic and early

`zt w b P` is a sound static zero tracker for one wire: starting from the
status `b` ("`w` is known to be zero"), the last instruction of `P` that
writes `w` decides the status (a `measureX` on `w` resets `w` to `0` for every
input and every tape; any other write makes it unknown).  The tracker is
tail recursive with the status forced at every write, so kernel evaluation on
packet-sized programs stays shallow.  Composition lemmas (append, renaming,
packet sequences, support) let large programs be split into small checked
pieces; no concrete program run is evaluated anywhere.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic

/-- The written wire of an instruction. -/
def tgt : Instr → Wire
  | .X t => t
  | .CX _ t => t
  | .CCX _ _ t => t
  | .measureX t _ _ => t

/-- Whether an instruction is a measurement (which resets its target). -/
def isMeas : Instr → Bool
  | .measureX _ _ _ => true
  | _ => false

/-- Static zero tracker for the wire `w`. -/
def zt (w : Wire) : Bool → Program → Bool
  | b, [] => b
  | b, i :: p => if tgt i = w then zt w (isMeas i) p else zt w b p

theorem tgt_mem_wires (i : Instr) : tgt i ∈ i.wires := by
  cases i <;> simp [tgt, Instr.wires]

theorem zt_sound (w : Wire) : ∀ (P : Program) (b : Bool) (m : List Bool) (s : State),
    zt w b P = true → (b = true → s.basis w = false) → (run P m s).basis w = false := by
  intro P
  induction P with
  | nil =>
    intro b m s h hb
    simp only [zt] at h
    exact hb h
  | cons i p ih =>
    intro b m s h hb
    cases i with
    | X t =>
      simp only [zt, tgt, isMeas] at h
      simp only [run]
      by_cases ht : t = w
      · rw [if_pos ht] at h
        exact ih _ _ _ h (fun hf => by simp at hf)
      · rw [if_neg ht] at h
        refine ih _ _ _ h (fun hbt => ?_)
        simp only [writeBit, Function.update, Ne.symm ht, dite_false]
        exact hb hbt
    | CX c t =>
      simp only [zt, tgt, isMeas] at h
      simp only [run]
      by_cases ht : t = w
      · rw [if_pos ht] at h
        exact ih _ _ _ h (fun hf => by simp at hf)
      · rw [if_neg ht] at h
        refine ih _ _ _ h (fun hbt => ?_)
        simp only [writeBit, Function.update, Ne.symm ht, dite_false]
        exact hb hbt
    | CCX a c t =>
      simp only [zt, tgt, isMeas] at h
      simp only [run]
      by_cases ht : t = w
      · rw [if_pos ht] at h
        exact ih _ _ _ h (fun hf => by simp at hf)
      · rw [if_neg ht] at h
        refine ih _ _ _ h (fun hbt => ?_)
        simp only [writeBit, Function.update, Ne.symm ht, dite_false]
        exact hb hbt
    | measureX t c0 c1 =>
      simp only [zt, tgt, isMeas] at h
      simp only [run]
      by_cases ht : t = w
      · rw [if_pos ht] at h
        refine ih _ _ _ h (fun _ => ?_)
        subst ht
        simp [measureAndCorrect, writeBit]
      · rw [if_neg ht] at h
        refine ih _ _ _ h (fun hbt => ?_)
        simp only [measureAndCorrect, correct_basis, writeBit, Function.update, Ne.symm ht,
          dite_false]
        exact hb hbt

theorem zt_append (w : Wire) : ∀ (P Q : Program) (b : Bool),
    zt w b (P ++ Q) = zt w (zt w b P) Q := by
  intro P
  induction P with
  | nil => intro Q b; rfl
  | cons i p ih =>
    intro Q b
    simp only [List.cons_append, zt]
    split <;> exact ih _ _


theorem zt_of_not_mem (w : Wire) : ∀ (P : Program) (b : Bool), w ∉ wires P → zt w b P = b := by
  intro P
  induction P with
  | nil => intro b _; rfl
  | cons i p ih =>
    intro b h
    have hi : w ∉ i.wires := fun hm => h (Finset.mem_union_left _ hm)
    have hp : w ∉ wires p := fun hm => h (Finset.mem_union_right _ hm)
    have ne : tgt i ≠ w := fun e => hi (e ▸ tgt_mem_wires i)
    simp only [zt, if_neg ne]
    exact ih b hp

theorem tgt_rename (f : Wire → Wire) (i : Instr) : tgt (renameInstr f i) = f (tgt i) := by
  cases i <;> rfl

theorem isMeas_rename (f : Wire → Wire) (i : Instr) : isMeas (renameInstr f i) = isMeas i := by
  cases i <;> rfl

theorem zt_rename (f : Wire → Wire) (hf : Function.Injective f) (w : Wire) :
    ∀ (P : Program) (b : Bool), zt (f w) b (renameProgram f P) = zt w b P := by
  intro P
  induction P with
  | nil => intro b; rfl
  | cons i p ih =>
    intro b
    simp only [renameProgram, List.map_cons] at ih ⊢
    simp only [zt, tgt_rename, isMeas_rename, hf.eq_iff]
    split <;> exact ih _

theorem zt_rename_fixed (f : Wire → Wire) (hf : Function.Injective f) (w : Wire)
    (hw : f w = w) (P : Program) (b : Bool) :
    zt w b (renameProgram f P) = zt w b P := by
  have := zt_rename f hf w P b
  rwa [hw] at this



/-! ## Single-pass tracker for the wires of a window `[lo, lo + width)`

The statuses are the bits of a natural number; every update is forced
(`Nat.beq m m`), so the kernel evaluates the tracker with constant depth. -/

/-- Status update of bit `t - lo`: set on a measurement, cleared otherwise. -/
def updMask (lo width m t : Nat) (mz : Bool) : Nat :=
  if mz then m ||| 2 ^ (t - lo) else m &&& ((2 ^ width - 1) ^^^ 2 ^ (t - lo))

def ztM (lo width : Nat) : Nat → Program → Nat
  | m, [] => m
  | m, i :: p =>
      if lo ≤ tgt i ∧ tgt i < lo + width then
        cond (Nat.beq (updMask lo width m (tgt i) (isMeas i)) (updMask lo width m (tgt i) (isMeas i)))
          (ztM lo width (updMask lo width m (tgt i) (isMeas i)) p)
          (ztM lo width (updMask lo width m (tgt i) (isMeas i)) p)
      else ztM lo width m p

theorem updMask_bit (lo width m t w : Nat) (mz : Bool) (ht : lo ≤ t ∧ t < lo + width)
    (hw : lo ≤ w ∧ w < lo + width) :
    (updMask lo width m t mz).testBit (w - lo) = if t = w then mz else m.testBit (w - lo) := by
  have iff : (t - lo = w - lo) ↔ t = w := by omega
  have lt : w - lo < width := by omega
  cases mz <;> simp only [updMask, Bool.false_eq_true, if_false, if_true, Nat.testBit_or,
    Nat.testBit_and, Nat.testBit_xor, Nat.testBit_two_pow, Nat.testBit_two_pow_sub_one,
    iff, lt] <;> by_cases e : t = w <;> simp [e]

theorem ztM_spec (lo width : Nat) : ∀ (P : Program) (m w : Nat), lo ≤ w → w < lo + width →
    (ztM lo width m P).testBit (w - lo) = zt w (m.testBit (w - lo)) P := by
  intro P
  induction P with
  | nil => intro m w _ _; rfl
  | cons i p ih =>
    intro m w h1 h2
    simp only [ztM, zt]
    split
    · rename_i hin
      simp only [Nat.beq_refl, cond_true]
      rw [ih _ w h1 h2, updMask_bit lo width m (tgt i) w (isMeas i) hin ⟨h1, h2⟩]
      by_cases e : tgt i = w
      · rw [if_pos e, if_pos e]
      · rw [if_neg e, if_neg e]
    · rename_i hout
      have ne : tgt i ≠ w := fun e => hout (e ▸ ⟨h1, h2⟩)
      rw [ih m w h1 h2, if_neg ne]

/-- Checked form: every listed wire (inside the window) ends with status `true`. -/
def ztAll (lo width : Nat) (b : Bool) (ws : List Wire) (P : Program) : Bool :=
  ws.all (fun w => (ztM lo width (if b then 2 ^ width - 1 else 0) P).testBit (w - lo))

theorem zt_of_ztAll (lo width : Nat) (b : Bool) (ws : List Wire) (P : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ztAll lo width b ws P = true) :
    ∀ w ∈ ws, zt w b P = true := by
  intro w hw
  unfold ztAll at h
  rw [List.all_eq_true] at h
  have := h w hw
  rw [ztM_spec lo width P _ w (hr w hw).1 (hr w hw).2] at this
  have lt : w - lo < width := Nat.sub_lt_left_of_lt_add (hr w hw).1 (hr w hw).2
  cases b <;> simpa [Nat.testBit_two_pow_sub_one, lt] using this

/-- The 44 exclusive roles (`StairSchedule.exclusiveRoles`, spelled out so
that the kernel checks need no late import). -/
def rolesL : List Wire := ((List.range' 720 45).filter (fun i => i != 760)).map MappedCompressed.base

theorem rolesL_window : ∀ w ∈ rolesL, 736 ≤ w ∧ w < 736 + 45 := by
  decide +kernel


/-! ## LT49 (replay budget): structural reductions of `ztAll` checks -/

theorem ztAll_of_zt (lo width : Nat) (b : Bool) (ws : List Wire) (P : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ∀ w ∈ ws, zt w b P = true) :
    ztAll lo width b ws P = true := by
  unfold ztAll
  rw [List.all_eq_true]
  intro w hw
  rw [ztM_spec lo width P _ w (hr w hw).1 (hr w hw).2]
  have lt : w - lo < width := Nat.sub_lt_left_of_lt_add (hr w hw).1 (hr w hw).2
  have e : (if b then 2 ^ width - 1 else 0).testBit (w - lo) = b := by
    cases b <;> simp [Nat.testBit_two_pow_sub_one, lt]
  rw [e]
  exact h w hw



/-! ## K1 (replay budget): composition lemmas for structural `ztAll` checks

The kernel builds the gate list of a recursive generator (`majority ++ rec ++ erase`) with
left-nested appends, which costs quadratic time in the recursion depth.  These lemmas let a check
descend into a program structurally (renamings that fix the checked wires, append splits) and
evaluate the tracker of a recursive generator through a fused recursion instead. -/




end ECDSAAdd.Entrant.StairField13V3Clean

end
end Merge_StairField13V3ZT_at_QTop

