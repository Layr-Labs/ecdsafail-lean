theorem registerBasis_out (bits : List Wire) (v : Nat) (r : Wire) (h : r ∉ bits) :
    StairCodec.registerBasis bits v r = false := by
  show (if bits.idxOf r < bits.length then v.testBit (bits.idxOf r) else false) = false
  rw [List.idxOf_eq_length h]
  simp

/-- The hosts are future payload letters outside the rest word, so the stored
compact checkpoint is `0` on them. -/
theorem hosts_cmp (B : Nat) (hB : B ∈ StairPhysicalLayout.budgets) (x : Nat) (r : Wire)
    (hr : r ∈ StairPhysicalLayout.hosts B) :
    r ∈ StairPhysicalLayout.futurePayload B ∧ StairField2V3Seg.cmpBits B x r = false := by
  obtain ⟨nd, sub, -⟩ := StairPhysicalLayout.rest_hosts_fit B hB
  have hm : r ∈ StairPhysicalLayout.restSites B ++ StairPhysicalLayout.hosts B :=
    List.mem_append_right _ hr
  refine ⟨sub r hm, ?_⟩
  have out : r ∉ StairPhysicalLayout.restSites B := by
    intro h
    exact (List.nodup_append.mp nd).2.2 r h r hr rfl
  have out1 : r ∉ StairField2V3Seg.restLetters B := fun h => out (List.mem_append_left _ h)
  have out2 : r ∉ StairCodec.reg (StairPhysicalLayout.physicalLayout B).A
      (StairCodec.bitWidth B) := fun h => out (List.mem_append_right _ h)
  have h1 : ∀ v, StairCodec.registerBasis (StairField2V3Seg.restLetters B) v r = false :=
    fun v => registerBasis_out _ v _ out1
  have h2 : ∀ v, StairCodec.registerBasis
      (StairCodec.reg (StairPhysicalLayout.physicalLayout B).A (StairCodec.bitWidth B)) v r = false :=
    fun v => registerBasis_out _ v _ out2
  unfold StairField2V3Seg.cmpBits
  simp only [h1, h2, Bool.or_false]

