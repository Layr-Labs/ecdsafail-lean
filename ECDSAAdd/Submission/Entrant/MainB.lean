  | succ n ih =>
    have head := packet_physical divide j (by omega)
    have rest := ih (j+1) (by omega)
    cases divide <;> simp only [groups,PacketSequence.program,Bool.false_eq_true,if_false,
      if_true,gatePhysical_append] at rest ⊢
