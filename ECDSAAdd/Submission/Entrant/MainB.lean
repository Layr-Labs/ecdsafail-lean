theorem gen_slots (L : ControlledPointLayout) (hw : L.Widths) (cx cy : Fp) :
    gateSlots (gen L cx cy)≤49266614 := by
  have diff:=(gen_delta L cx cy).2.2
  have old:=ControlLoan1589BFFinal.gen_slots L hw cx cy
