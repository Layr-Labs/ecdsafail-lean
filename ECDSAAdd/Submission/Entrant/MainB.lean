private theorem codec_not (j q : Nat) (_hj : j<102)
    (away : q<5*j ∨ 5*j+5≤q ∧ q<1028+5*j ∨ 1033+5*j≤q) :
    base q∉wires (NewHistory5.encode base (5*j)) := by
  intro used
  obtain ⟨i,eq⟩ := NewHistory5.history_gate_mem base (5*j) _ (Or.inl rfl) _ used
  have bound := i.isLt
