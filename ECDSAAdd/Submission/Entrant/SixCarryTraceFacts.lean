theorem noWrite_mono_end (p : Program) (start stop short q : Nat) (hshort : short≤stop)
 (h : noWriteBetween p start stop q=true) : noWriteBetween p start short q=true := by
 unfold noWriteBetween at h ⊢
 apply List.all_eq_true.mpr
 intro gate hgate
 have sub : ((p.drop start).take (short-start)).Sublist ((p.drop start).take (stop-start)) :=
  List.take_sublist_take_left (Nat.sub_le_sub_right hshort start)
 exact (List.all_eq_true.mp h) gate (sub.subset hgate)

