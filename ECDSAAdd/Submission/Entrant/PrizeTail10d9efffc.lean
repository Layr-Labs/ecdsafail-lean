theorem high_from_cut (raw cut:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^144)
    (packed:PackedCut lowerPairs upperPairs 240 1723 1721 1722 (negative S z.u) (decide (Shadow.far 144 15 z))
