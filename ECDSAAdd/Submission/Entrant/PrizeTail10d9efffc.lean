    let v:=run Leave225FullArithmetic.program m s
    v.basis 930=decide (2^144≤mag%(2*2^144)) ∧
    ∀mm,run closePart mm v=⟨v.phase,writeBit (writeBit v.basis 1557 false) 1558 false⟩ := by
