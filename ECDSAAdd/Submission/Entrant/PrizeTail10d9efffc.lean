    (far:s.basis 1721=decide (Shadow.far 144 15 z))
    (side:s.basis 1722=(decide (Shadow.far 144 15 z) && decide (2^144≤z.u))) (quiet:∀q∈Leave225CoreCheckpoint.rawSites,s.basis q=false) :
