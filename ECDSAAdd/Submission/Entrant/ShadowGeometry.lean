  have hd := head_ok j h0 h1
  have lr := lowRest_ok w1 w2; have sm := storeMapped_ok w1 w2; have lc := lowClose_ok w1 w2
  have cl := close_ok w1 w2
  have z0 : ZeroOn s (Zm (maskSites cC ||| far1M (start j))) := by
    intro q hq
