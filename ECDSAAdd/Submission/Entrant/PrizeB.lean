theorem signed (z:SkywalkNat.State) (ref:BasisState)
    (small:min z.u z.v<2^129) (odd:z.v%2=1) (room:Shadow.high 129 15 z+1<2^112)
    (bits:∀i<16,ref (ports.u+i)=(Leave255TrueMiddle.X z).testBit i)
