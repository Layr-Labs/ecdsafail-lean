def history : List Wire := [256, 257, 258, 259, 260, 261, 262, 263, 264, 265, 266, 267, 268, 269, 270]
def low : List (Wire×Wire) := [(407, 922), (408, 923), (409, 924), (410, 925), (411, 926), (412, 927), (413, 928), (414, 929), (415, 930), (416, 931), (417, 932), (418, 933)]
