    out.basis 1556 = en.basis 1556 ∧ out.basis 1557 = en.basis 1557 ∧ out.basis 1558 = en.basis 1558 ∧
    out.basis (a0P20 (start20 j) - 1) = (TrueMiddle20.F j z).testBit 0 ∧
    out.basis (b0P20 (start20 j) - 1) = (en.basis (b0P20 (start20 j) - 1) ^^ (TrueMiddle20.F j z).testBit 0) ∧
