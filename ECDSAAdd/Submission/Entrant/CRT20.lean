  narrow : TrueMiddle20.F j z < 2 ^ (railP (start20 j + 20) - sbP20 (start20 j))

theorem actualNumbers20 (j : Fin 10) (x p : Nat) (good : Bounds x p) :
    Numeric20 j (unsigned (start20 j) x p) := by
  have hg := geom20_facts j; dsimp only at hg
  have hx : x < 2 ^ 256 := lt_trans good.small good.cap
  have hgeo : wpP20 (start20 j) + (sbP20 (start20 j) + 20) = railP (start20 j) ∧
      (start20 j < 257 → 257 ≤ railP (start20 j)) ∧
      (257 ≤ start20 j → railP (start20 j) = 513 - start20 j) := by
    have : ∀ k : Fin 10, wpP20 (start20 k) + (sbP20 (start20 k) + 20) = railP (start20 k) ∧
        (start20 k < 257 → 257 ≤ railP (start20 k)) ∧
        (257 ≤ start20 k → railP (start20 k) = 513 - start20 k) := by decide +kernel
    exact this j
  have env := env_room20 (S := (step^[start20 j] (init x p)).u + (step^[start20 j] (init x p)).v)
    (e := sbP20 (start20 j) + 20) (W := wpP20 (start20 j)) (by
      by_cases hs : start20 j < 257
      · exact Or.inl ⟨by have := hgeo.2.1 hs; omega, by omega, sum_early20 x p _ hx good.cap (by omega)⟩
      · refine Or.inr ⟨by omega, ?_⟩
        rw [show wpP20 (start20 j) - 1 + (sbP20 (start20 j) + 20) = 512 - start20 j by
          have := hgeo.2.2 (by omega); omega]
        exact le_of_lt (scaled_sum_strict20 x p _ good (by omega)))
  have it : step^[20] (step^[start20 j] (init x p)) = step^[start20 j + 20] (init x p) := by
    rw [← Function.iterate_add_apply, Nat.add_comm]
  have hnext : Shadow7.SmallIfFar (nextSb20 (start20 j)) (nextLen20 j) (step^[20] (unsigned (start20 j) x p)) := by
    show Shadow7.SmallIfFar (nextSb20 (start20 j)) (nextLen20 j) (step^[20] (step^[start20 j] (init x p)))
    rw [it]
    unfold nextSb20 nextLen20
    by_cases hlt : j.val < 9
    · have hst : start20 j + 20 < 365 := by unfold start20; omega
      simp only [hlt, hst, ↓reduceIte]
      exact (inputs20 x p (start20 j + 20) hx good.cap (by omega)).1
    · have hst : ¬ (start20 j + 20 < 365) := by unfold start20; have := j.isLt; omega
      simp only [hlt, hst, ↓reduceIte]
      exact (Shadow7.Envelope.inputs x p (start20 j + 20) hx good.cap (by omega)).1
  have hadjTight : Shadow.high (sbP20 (start20 j)) 20 (unsigned (start20 j) x p) + 1 < 2 ^ adjW20 (start20 j) := by
    have hgeo20 : (start20 j < 225 → 45 ≤ start20 j ∧ sbP20 (start20 j) + 20 ≤ 242 ∧ adjW20 (start20 j) + (sbP20 (start20 j) + 20) = 257) ∧
        (265 ≤ start20 j → 257 ≤ start20 j ∧ start20 j ≤ 510 ∧ sbP20 (start20 j) + 20 < 511 - start20 j ∧ adjW20 (start20 j) + (sbP20 (start20 j) + 20) = 512 - start20 j) :=
      (show ∀ k : Fin 10, (start20 k < 225 → 45 ≤ start20 k ∧ sbP20 (start20 k) + 20 ≤ 242 ∧ adjW20 (start20 k) + (sbP20 (start20 k) + 20) = 257) ∧
          (265 ≤ start20 k → 257 ≤ start20 k ∧ start20 k ≤ 510 ∧ sbP20 (start20 k) + 20 < 511 - start20 k ∧ adjW20 (start20 k) + (sbP20 (start20 k) + 20) = 512 - start20 k) from by decide) j
    by_cases h1 : start20 j < 225
    · exact TruncatedAdjust.high_tight_of_bounds x p (start20 j) (sbP20 (start20 j)) 20 (adjW20 (start20 j)) good (Or.inl (hgeo20.1 h1))
    · by_cases h2 : 265 ≤ start20 j
      · exact TruncatedAdjust.high_tight_of_bounds x p (start20 j) (sbP20 (start20 j)) 20 (adjW20 (start20 j)) good (Or.inr (hgeo20.2 h2))
      · have heq : adjW20 (start20 j) = wpP20 (start20 j) := by unfold adjW20; rw [if_neg (by omega)]
        rw [heq]; exact env.1
  exact ⟨inputs20 x p (start20 j) hx good.cap (by omega),
    (iter_valid (start20 j) (init x p) good.positive good.odd).2.1,
    env.1, hadjTight, hnext, terminal_fit_live20 j x p good, terminal_fit_rail20 j x p good⟩

end Envelope

