def onRails15EPlus (j : Fin 4) (i : Nat) (z : SkywalkRails.State) (b : BasisState) : Prop :=
  readyPlus (shape15E j) i z (mappedBasis15E j b)

def unrouted15EHigh (j : Fin 4) (i n : Nat) : Program :=
  renameProgram (windowNet15E j) (backHigh (shape15E j) i n)

theorem route15EFramePlus (j : Fin 4) (i n : Nat) (bound : i + n ≤ 15)
    (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1) :
    Triple (onRails15EPlus j i z) (routed15E j i n)
      (onRails15EPlus j (i + n) (SkywalkTrace.next^[n] z)) := by
  intro s m ready
  have h := semanticPlus (shape15E j) i n bound z odd (pullState (windowNet15E j) s) m ready
  rw [← pull_routed15E j i n bound m s] at h
  exact h

theorem route15EUndoHigh (j : Fin 4) (i n : Nat) (bound : i + n ≤ 15)
    (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1) :
    Restores (onRails15EPlus j i z) (routed15E j i n) (unrouted15EHigh j i n) := by
  intro s m t ready
  have forward := pull_routed15E j i n bound m s
  let actual := run (routed15E j i n) m s
  have bk : pullState (windowNet15E j) (run (unrouted15EHigh j i n) t actual) =
      run (backHigh (shape15E j) i n) t (pullState (windowNet15E j) actual) := by
    rw [unrouted15EHigh, run_rename _ (net15E_injective j)]
  have hm : 1 ≤ (shape15E j).mid := by simp [shape15E]
  have fin := roundtripHigh (shape15E j) i n bound hm z odd
    (pullState (windowNet15E j) s) m t ready
  change pullState (windowNet15E j) actual = _ at forward
  rw [forward, fin] at bk
  apply congrArg₂ State.mk (congrArg State.phase bk)
  funext q
  have h := congrArg (fun x : State => x.basis (windowNet15E j q)) bk
  change (run (unrouted15EHigh j i n) t actual).basis (windowNet15E j (windowNet15E j q)) =
    s.basis (windowNet15E j (windowNet15E j q)) at h
  rwa [net15E_invol j q] at h

theorem head15E_eq (j : Fin 4) : unrouted15EHigh j 0 1 = unrouted15E j 0 1 := by
  rw [(fixed_route15E j 0 1 (by decide)).2]
  simp [unrouted15EHigh, backHigh, receiverSelected, IntegerPacket.backR]

theorem tail15E_counts (j : Fin 4) :
    toffoliCount (unrouted15EHigh j 1 14) + 14 = toffoliCount (unrouted15E j 1 14) ∧
    measurementCount (unrouted15EHigh j 1 14) = measurementCount (unrouted15E j 1 14) + 14 ∧
    Challenge.gateSlots (unrouted15EHigh j 1 14) = Challenge.gateSlots (unrouted15E j 1 14) + 98 := by
  have hm : 1 ≤ (shape15E j).mid := by simp [shape15E]
  have c := backHigh_counts (shape15E j) 1 14 hm (by decide)
  rw [(fixed_route15E j 1 14 (by decide)).2]
  simpa only [unrouted15EHigh, (renameProgram_counts _ _).1, (renameProgram_counts _ _).2,
    Baselines.rename_gateSlots] using c

private theorem untickR15E_slots (p : IntegerPacket.Shape) (i : Nat) :
    Challenge.gateSlots (ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick (IntegerPacket.ports p i)
      (IntegerPacket.ports p i).half.length) ≤ 4900 := by
  have ah : (IntegerPacket.ports p i).ah.length = p.mid + 1 := by
    simp [IntegerPacket.ports, SkywalkIntegerLayout.ah]
  have bh : (IntegerPacket.ports p i).bh.length = p.mid + 1 := by
    simp [IntegerPacket.ports, SkywalkIntegerLayout.bh]
  have hh : (IntegerPacket.ports p i).half.length = p.mid + 2 := by simp [SkywalkIntegerLayout.half, ah]
  have hb : (IntegerPacket.ports p i).b.length = p.mid + 2 := by simp [SkywalkIntegerLayout.b, bh]
  have hc : (IntegerPacket.ports p i).carry.length = p.mid + 1 := by simp [IntegerPacket.ports]
  have w := p.midBound
  have hw : (ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout (IntegerPacket.ports p i)
      (IntegerPacket.ports p i).half.length).Widths (IntegerPacket.ports p i).half.length := by
    constructor
    · simp only [ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout, NarrowSignedRecordLayout.xp,
        List.length_append, List.length_singleton, List.length_take]; omega
    · simp only [ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout, NarrowSignedRecordLayout.yp,
        List.length_append, List.length_singleton, List.length_take]; omega
    · simp only [ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout, List.length_take]; omega
  have r := ECDSAAdd.Entrant.StairSlotsLib.narrowReceiver_slots_exact (ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout (IntegerPacket.ports p i)
      (IntegerPacket.ports p i).half.length) (IntegerPacket.ports p i).half.length hw (by omega)
  have ly : (ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout (IntegerPacket.ports p i)
      (IntegerPacket.ports p i).half.length).y.length = p.mid + 2 := by
    simp only [ECDSAAdd.Arithmetic.narrowSkywalkRecordLayout, NarrowSignedRecordLayout.y,
      NarrowSignedRecordLayout.yp, List.length_append, List.length_take, List.length_drop, List.length_singleton, hb, hh]
    omega
  simp only [ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick, skywalkSignedHalf, Challenge.gateSlots_append,
    swapRegisters_gateSlots, gateSlots_cons, gateSlots_nil, Challenge.instructionSlots, ah, bh, Nat.min_self]
  omega

private theorem backHigh15E_slots (p : IntegerPacket.Shape) (i n : Nat) (hm : 1 ≤ p.mid) :
    Challenge.gateSlots (backHigh p i n) ≤ 5000 * n := by
  induction n generalizing i with
  | zero => simp [backHigh, Challenge.gateSlots]
  | succ n ih =>
    have tail := ih (i + 1)
    have point : Challenge.gateSlots (receiverSelected p i) ≤ 5000 := by
      unfold receiverSelected
      split
      · exact le_trans (untickR15E_slots p i) (by decide)
      · have rc := receiverHigh_counts p i hm
        have ru := untickR15E_slots p i
        omega
    simp only [backHigh, Challenge.gateSlots_append, Nat.mul_succ]
    omega

private theorem back15E_physical (p : IntegerPacket.Shape) (i n : Nat) (bound : i + n ≤ p.length) (hm : 1 ≤ p.mid) :
    GatePhysical (backHigh p i n) := by
  induction n generalizing i with
  | zero => simp [backHigh, GatePhysical]
  | succ n ih =>
    have h := ih (i + 1) (by omega)
    have hv := IntegerPacket.ok p ⟨i, by omega⟩
    have hn : 0 < (IntegerPacket.ports p i).half.length := by simp [SkywalkIntegerLayout.half]
    have point : GatePhysical (receiverSelected p i) := by
      unfold receiverSelected
      split
      · exact ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick_physical _ _ hv hn le_rfl
      · exact receiverHigh_physical p i (by omega) hm
    exact (gatePhysical_append _ _).mpr ⟨h, point⟩

theorem tail15E_slots (j : Fin 4) :
    Challenge.gateSlots (unrouted15EHigh j 1 14) ≤ 70000 := by
  have hm : 1 ≤ (shape15E j).mid := by simp [shape15E]
  simpa only [unrouted15EHigh, Baselines.rename_gateSlots, show 5000 * 14 = 70000 from rfl] using
    backHigh15E_slots (shape15E j) 1 14 hm

theorem tail15E_physical (j : Fin 4) : GatePhysical (unrouted15EHigh j 1 14) := by
  have hm : 1 ≤ (shape15E j).mid := by simp [shape15E]
  exact gatePhysical_rename _ (net15E_injective j) _ (back15E_physical (shape15E j) 1 14 (by simp [shape15E]) hm)

theorem tail15E_covered (j : Fin 4) : WindowCovered.CoveredW (unrouted15EHigh j 1 14) := by
  have hm : 1 ≤ (shape15E j).mid := by simp [shape15E]
  have all (a n : Nat) (bound : a + n ≤ 15) :
      WindowCovered.CoveredW (renameProgram (windowNet15E j) (backHigh (shape15E j) a n)) := by
    induction n generalizing a with
    | zero => intro q hq; simp [backHigh, renameProgram, wires] at hq
    | succ n ih =>
      have ha : a < 15 := by omega
      have hv := IntegerPacket.ok (shape15E j) ⟨a, ha⟩
      have hn : 0 < (IntegerPacket.ports (shape15E j) a).half.length := by simp [SkywalkIntegerLayout.half]
      have sub : wires (receiverSelected (shape15E j) a) ⊆
          (IntegerPacket.ports (shape15E j) a).wires.toFinset := by
        unfold receiverSelected
        split
        · exact ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick_support _ _ hv hn le_rfl
        · exact receiverHigh_support (shape15E j) a ha hm
      have point : WindowCovered.CoveredW (renameProgram (windowNet15E j)
          (receiverSelected (shape15E j) a)) := by
        intro q hq
        rw [renameProgram_support] at hq
        obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
        have mem := List.mem_toFinset.mp (sub hw)
        have dom := ports15E_dom ha mem
        rwa [stable15E ha mem] at dom
      have tail := ih (a + 1) (by omega)
      simpa only [backHigh, renameProgram, List.map_append] using WindowCovered.appW tail point
  exact all 1 14 (by decide)

end TickCut15E

/-! ### Section 2: 15-tick shadow envelope & archive row membership -/

section ShadowMath15E
open SkywalkNat IntegerHigh Shadow HighBankSum
attribute [local irreducible] SkywalkNat.step

theorem inputs15E (x p t : Nat) (hx : x < 2 ^ 256) (hp : p < 2 ^ 256) (ht : t ≤ 497) :
    Shadow7.SmallIfFar (sb15E t) 15 (step^[t] (init x p)) ∧
    Shadow7.EndSmall (sb15E t) (step^[t] (init x p)) := by
  have hb : sb15E t = (497 - t) / 2 := rfl
  refine ⟨?_, ?_⟩
  · intro hfar
    have pos : 0 < limb (sb15E t) 15 := by unfold limb; exact Nat.two_pow_pos _
    have hf := (Nat.le_div_iff_mul_le pos).mp hfar
    have he : limb (sb15E t) 15 = 2 ^ (sb15E t + 15) := rfl
    rw [he] at hf
    obtain ⟨a, c, hac, hu, hv⟩ := Shadow7.Envelope.budget x p hx hp t
    have hbig : 2 ^ (sb15E t + 15) ≤ (step^[t] (init x p)).u ∨
        2 ^ (sb15E t + 15) ≤ (step^[t] (init x p)).v := by omega
    rcases hbig with h | h
    · have ex : sb15E t + 15 < 256 - a := (Nat.pow_lt_pow_iff_right (by decide)).mp (lt_of_le_of_lt h hu)
      exact lt_of_le_of_lt (min_le_right _ _)
        (lt_of_lt_of_le hv (Nat.pow_le_pow_right (by decide) (by omega)))
    · have ex : sb15E t + 15 < 256 - c := (Nat.pow_lt_pow_iff_right (by decide)).mp (lt_of_le_of_lt h hv)
      exact lt_of_le_of_lt (min_le_left _ _)
        (lt_of_lt_of_le hu (Nat.pow_le_pow_right (by decide) (by omega)))
  · have h := Shadow7.Envelope.min_lt x p hx hp (15 + t)
    rw [Function.iterate_add_apply] at h
    have e : 256 - (15 + t + 1) / 2 ≤ sb15E t := by omega
    exact lt_of_lt_of_le h (Nat.pow_le_pow_right (by decide) e)

end ShadowMath15E

/-! ### Section 3: Physical wire geometry & `CRTBarrel` instantiation for `{65, 58, 50, 43}` -/

def wp15E (s : Nat) : Nat := railP s - sb15E s - 15
def adjW15E (s : Nat) : Nat := wp15E s - 1
def e015E (s : Nat) : Nat := 1574 + sb15E s
def a015E (s : Nat) : Nat := s + sb15E s + 32
def b015E (s : Nat) : Nat := 787 + sb15E s
def lows15E (s : Nat) : Nat := 17 + sb15E (s + 15) - sb15E s
def nextWp15E (s : Nat) : Nat := railP (s + 15) - sb15E (s + 15) - 15

def liveW15E (s : Nat) : Nat := (512 - (s + 15)) - sb15E s

def poolW15E (s i : Nat) : Wire :=
  if 1598 + i < e015E s then 1598 + i
  else if 1608 + i + s < 2055 then 1608 + i
  else a015E s + 17 + (1608 + i + s - 2055)

def bankW15E (s i : Nat) : Wire :=
  if i < 3 then e015E s + i
  else if i < wp15E s then bTopP s + 1 + i - wp15E s
  else poolW15E s (i - wp15E s)

def place15E (s q : Nat) : Wire :=
  let n := liveW15E s
  if q < n then bankW15E s q
  else if q < n + 16 then tagsP.getD (q - n) 1560
  else poolW15E s (17 + (q - n - 16) % 10)

def barrel15E (s : Nat) (mir : Bool) : Program :=
  renameProgram (place15E s) (CRTBarrel.logical (liveW15E s) mir)

def barrel15ET (s : Nat) (_mir : Bool) : Nat := (CRTBarrel.measuredCosts (liveW15E s)).1
def barrel15EM (s : Nat) (_mir : Bool) : Nat := (CRTBarrel.measuredCosts (liveW15E s)).2.1
def barrel15ESlots (s : Nat) (mir : Bool) : Nat :=
  let v := (CRTBarrel.measuredCosts (liveW15E s)).2.2
  if mir then v.2 else v.1

theorem geom15E_facts : ∀ j : Fin 4,
    let s := start15E j
    365 ≤ s ∧ s ≤ 410 ∧
    43 ≤ sb15E s ∧ sb15E s ≤ 66 ∧
    1617 ≤ e015E s ∧ e015E s ≤ 1640 ∧
    45 ≤ wp15E s ∧ wp15E s ≤ 67 ∧
    9 ≤ lows15E s ∧ lows15E s ≤ 10 ∧
    37 ≤ nextWp15E s ∧ nextWp15E s ≤ 60 ∧
    CRTBarrel.UsedWidth (liveW15E s) ∧
    liveW15E s ≤ wp15E s + 15 ∧
    lows15E s ≤ liveW15E s ∧
    1608 + 26 + s < 2055 := by
  unfold CRTBarrel.UsedWidth
  decide +kernel

theorem place15E_inj : ∀ j : Fin 4,
    let n := liveW15E (start15E j)
    ∀ a : Fin (n + 26), ∀ b : Fin (n + 26),
      place15E (start15E j) a.val = place15E (start15E j) b.val → a = b := by
  decide +kernel

theorem place15E_dom : ∀ j : Fin 4,
    let n := liveW15E (start15E j)
    ∀ a : Fin (n + 26), WindowCovered.domainW (place15E (start15E j) a.val) = true := by
  decide +kernel

theorem barrel15E_metrics (j : Fin 4) (mir : Bool) :
    toffoliCount (barrel15E (start15E j) mir) = barrel15ET (start15E j) mir ∧
    measurementCount (barrel15E (start15E j) mir) = barrel15EM (start15E j) mir ∧
    gateSlots (barrel15E (start15E j) mir) = barrel15ESlots (start15E j) mir := by
  have hu : CRTBarrel.UsedWidth (liveW15E (start15E j)) :=
    (geom15E_facts j).2.2.2.2.2.2.2.2.2.2.2.2.1
  have hmc : ∀ n, CRTBarrel.UsedWidth n →
      CRTBarrel.Resources.windowPrice n mir =
        ⟨(CRTBarrel.measuredCosts n).1, (CRTBarrel.measuredCosts n).2.1,
         if mir then (CRTBarrel.measuredCosts n).2.2.2 else (CRTBarrel.measuredCosts n).2.2.1⟩ := by
    intro n hn
    unfold CRTBarrel.Resources.windowPrice
    rw [CRTBarrel.basis_size]
    rcases hn with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> cases mir <;> decide +kernel
  have hlog := CRTBarrel.Resources.logical_count (liveW15E (start15E j)) mir (fun pair hp => by
    have hf := CRTBarrel.schedule_fields _ hu pair hp
    exact CRTBarrel.field_count pair.1 hf mir)
  have hren := CRTBarrel.Resources.renamed (place15E (start15E j)) (CRTBarrel.logical (liveW15E (start15E j)) mir)
  rw [hlog, hmc _ hu] at hren
  exact ⟨congrArg CRTBarrel.Resources.Count.t hren,
    congrArg CRTBarrel.Resources.Count.m hren,
    congrArg CRTBarrel.Resources.Count.slots hren⟩

theorem barrel15E_phys (j : Fin 4) (mir : Bool) :
    GatePhysical (barrel15E (start15E j) mir) := by
  have hu : CRTBarrel.UsedWidth (liveW15E (start15E j)) :=
    (geom15E_facts j).2.2.2.2.2.2.2.2.2.2.2.2.1
  have logicalOK := CRTBarrel.logical_fits (liveW15E (start15E j)) hu mir
  have physicalOK := CRTBarrel.Placement.fits_rename (T := fun _ => True) (place15E (start15E j)) _ logicalOK
    (fun _ _ => trivial) (fun a ha b hb eq => congrArg Fin.val (place15E_inj j ⟨a, ha⟩ ⟨b, hb⟩ eq))
  exact fun i hit => (physicalOK i hit).1

theorem barrel15E_cov (j : Fin 4) (mir : Bool) :
    WindowCovered.CoveredW (barrel15E (start15E j) mir) := by
  have hu : CRTBarrel.UsedWidth (liveW15E (start15E j)) :=
    (geom15E_facts j).2.2.2.2.2.2.2.2.2.2.2.2.1
  have hf := CRTBarrel.logical_fits (liveW15E (start15E j)) hu mir
  intro q hq
  rw [barrel15E, renameProgram_support] at hq
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
  have hxlt : x < liveW15E (start15E j) + 26 := CRTBarrel.Placement.support hf x hx
  exact place15E_dom j ⟨x, hxlt⟩

theorem barrel15E_wires (j : Fin 4) (mir : Bool) :
    ∀ q ∈ wires (barrel15E (start15E j) mir),
      (∃ i, i < wp15E (start15E j) + 15 ∧ q = bankW15E (start15E j) i) ∨
      (∃ k, k < 10 ∧ q = poolW15E (start15E j) (17 + k)) ∨ q ∈ tagsP := by
  have htag : ∀ i : Fin 16, tagsP.getD i.val 1560 ∈ tagsP := by decide +kernel
  have hle : liveW15E (start15E j) ≤ wp15E (start15E j) + 15 :=
    (geom15E_facts j).2.2.2.2.2.2.2.2.2.2.2.2.2.1
  intro q hq
  rw [barrel15E, renameProgram_support, Finset.mem_image] at hq
  obtain ⟨x, _, rfl⟩ := hq
  unfold place15E; dsimp only
  split_ifs with h1 h2
  · exact Or.inl ⟨x, Nat.lt_of_lt_of_le h1 hle, rfl⟩
  · exact Or.inr (Or.inr (htag ⟨x - liveW15E (start15E j), by omega⟩))
  · exact Or.inr (Or.inl ⟨(x - liveW15E (start15E j) - 16) % 10, Nat.mod_lt _ (by decide), rfl⟩)

/-- Semantic action of the trailing 15-tick CRT barrel (`widths {65, 58, 50, 43}`):
forward shifts the bank word left by `slot - 1`, mirror unshifts it, preserving exterior and phase. -/
theorem barrel15E_result (j : Fin 4) (mir : Bool) (slot : Fin 17) (v : Nat)
    (s : State) (tape : List Bool)
    (small : v < 2 ^ (liveW15E (start15E j) - (slot.val - 1)))
    (input : HighBankBarrel.holds (bankW15E (start15E j)) (liveW15E (start15E j))
      (v <<< CRTBarrel.entryShift mir slot.val) s)
    (tag : ∀ k : Fin 16, s.basis (tagsP.getD k.val 1560) = decide (slot.val = k.val + 1))
    (scratch : ∀ k < 10, s.basis (poolW15E (start15E j) (17 + k)) = false) :
    HighBankBarrel.Result (bankW15E (start15E j)) (liveW15E (start15E j))
      (v <<< CRTBarrel.exitShift mir slot.val) s (run (barrel15E (start15E j) mir) tape s) := by
  let n := liveW15E (start15E j)
  let dim := n - (slot.val - 1)
  let P := CRTBarrel.logical n mir
  let f := place15E (start15E j)
  let S := Finset.range (n + 26)
  let before := CRTBarrel.entryShift mir slot.val
  let after := CRTBarrel.exitShift mir slot.val
  have hu : CRTBarrel.UsedWidth n := (geom15E_facts j).2.2.2.2.2.2.2.2.2.2.2.2.1
  have scope : wires P ⊆ S := fun _ hw =>
    Finset.mem_range.mpr (CRTBarrel.Placement.support (CRTBarrel.logical_fits n hu mir) _ hw)
  have inj : ∀ a ∈ S, ∀ b ∈ S, f a = f b → a = b := fun a ha b hb eq =>
    congrArg Fin.val (place15E_inj j ⟨a, Finset.mem_range.mp ha⟩ ⟨b, Finset.mem_range.mp hb⟩ eq)
  have bank (k i : Nat) (ik : i < n) :
      (CRTBarrel.frame (CRTBarrel.plain n dim k) v.testBit dim slot.val s.phase).basis i =
        (v <<< k).testBit i := by
    simpa only [CRTBarrel.frame, CRTBarrel.Matrix.basis, CRTBarrel.plain_size, if_pos ik] using
      CRTBarrel.plain_bits n dim k v i small ik
  have placed (q : Nat) (hq : q < n) : f q = bankW15E (start15E j) q := by
    simp [f, place15E, n] at hq ⊢; simp [hq]
  have other (k q : Nat) (qn : n ≤ q) (high : q < n + 26) :
      (CRTBarrel.frame (CRTBarrel.plain n dim k) v.testBit dim slot.val s.phase).basis q =
        s.basis (f q) := by
    have outside : ¬ q < n := Nat.not_lt.mpr qn
    simp only [CRTBarrel.frame, CRTBarrel.Matrix.basis, CRTBarrel.plain_size, if_neg outside]
    change CRTBarrel.flags n slot.val q = s.basis (if q < n then bankW15E (start15E j) q else
      if q < n + 16 then tagsP.getD (q - n) 1560 else poolW15E (start15E j) (17 + (q - n - 16) % 10))
    rw [if_neg outside]
    by_cases mid : q < n + 16
    · have k16 : q - n < 16 := by omega
      simpa [CRTBarrel.flags, qn, mid] using (tag ⟨q - n, k16⟩).symm
    · have pos : q - n - 16 < 10 := by omega
      have val := scratch (q - n - 16) pos
      simpa [CRTBarrel.flags, mid, Nat.mod_eq_of_lt pos] using val.symm
  have result := run_rename_pool f S inj P scope tape
    (CRTBarrel.frame (CRTBarrel.plain n dim before) v.testBit dim slot.val s.phase) s rfl (by
      intro q hq
      by_cases low : q < n
      · rw [bank before q low, placed q low]; exact (input q low).symm
      · exact other before q (Nat.le_of_not_lt low) (Finset.mem_range.mp hq))
  have shift := CRTBarrel.logical_action n hu mir slot.val
    (by have := slot.isLt; omega) (CRTBarrel.coordinates_checked n hu)
    (CRTBarrel.Packed.template_action n hu slot mir) v.testBit s.phase tape
  change run P tape (CRTBarrel.frame (CRTBarrel.plain n dim before) _ _ _ _) =
    CRTBarrel.frame (CRTBarrel.plain n dim after) _ _ _ _ at shift
  rw [shift] at result
  change HighBankBarrel.Result (bankW15E (start15E j)) n (v <<< after) s (run (renameProgram f P) tape s)
  refine ⟨?_, result.1, ?_⟩
  · intro i bound
    have hi : i ∈ S := Finset.mem_range.mpr (Nat.lt_of_lt_of_le bound (Nat.le_add_right _ _))
    have bit := (result.2 i hi).trans (bank after i bound)
    rwa [placed i bound] at bit
  · intro q free
    by_cases hit : q ∈ S.image f
    · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hit
      have above : n ≤ a := by
        by_contra! low
        exact free a low (placed a low)
      change (run (renameProgram f P) tape s).basis (f a) = s.basis (f a)
      exact Eq.trans (result.2 a ha) (other after a above (Finset.mem_range.mp ha))
    · exact run_rename_pool_outside f S P scope tape s q hit

end ECDSAAdd.Entrant.StairPacket.Shadow15End

end


section
/-!
Trailing 15-tick entry & archive semantics (`j : Fin 4`, `s ∈ {365, 380, 395, 410}`):
- `enterP15E` / `enterInvP15E`: exact `EnterProof17.forward` / `EnterProof17.backward`
  instantiated at `(start15E j, sb15E (start15E j))` (6 T fwd / 6 T rev, 2 M fwd / 3 M rev,
  35 / 36 slots), with physicality, coverage, and full `EnterJ15E` semantic bridge
  (`from_full`, `ready_from_cut_at`, `ready_pending_at`, `high_from_cut`, `return_packed`,
  `return_pending`).
- `archiveLoadP15E` / `archiveRestoreP15E` (`j : Fin 3`, closing `365→380`, `380→395`, `395→410`):
  exact 157-wire `ArchiveJ15E` semantics (`load_run`, `restore_run`, `roundtrip`,
  `head_port_eq`, `kept_stock`), counts (`42 T / 49 M` load, `50/51 T / 43/44 M` restore),
  physicality, and domain coverage.
-/

namespace ECDSAAdd.Entrant.StairPacket.Shadow15End

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.IntegerPacket
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Partial
open ECDSAAdd.Entrant.StairPacket.GateMirror
open ECDSAAdd.Entrant.StairPacket.EnterProof17
open ECDSAAdd.Entrant.StairPacket.ArchivePortAction
open ECDSAAdd.Challenge

/-! ### Section 1: Trailing 15-tick entry (`enterP15E` / `enterInvP15E` + `EnterJ15E`) -/

namespace EnterJ15E

set_option maxRecDepth 30000
set_option maxHeartbeats 6000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def h15E (j : Fin 4) : Nat := sb15E (start15E j)

def railA (j : Fin 4) : List Wire :=
  [start15E j + h15E j + 31, start15E j + h15E j + 32]

def railB (j : Fin 4) : List Wire :=
  [h15E j + 801, h15E j + 802]

def gate (j : Fin 4) : Wire := start15E j + 15
def flagN (j : Fin 4) : Wire := h15E j + 1579
def flagF (j : Fin 4) : Wire := h15E j + 1577
def flagU (j : Fin 4) : Wire := h15E j + 1578
def parked (j : Fin 4) : Wire := h15E j + 803

def clear (j : Fin 4) : List Wire :=
  [h15E j + 1574, h15E j + 1575, h15E j + 1576, 1556]

def ports (j : Fin 4) : List Wire :=
  [start15E j + h15E j + 31, start15E j + h15E j + 32,
   h15E j + 801, h15E j + 802, start15E j + 15,
   h15E j + 1579, h15E j + 1577, h15E j + 1578, h15E j + 803,
   h15E j + 1574, h15E j + 1575, h15E j + 1576, 1556]

def map (j : Fin 4) (q : Wire) : Wire := (ports j).getD q 0

def lowerPairs (j : Fin 4) : List (Wire × Wire) :=
  [(start15E j + h15E j + 31, h15E j + 801), (start15E j + h15E j + 32, h15E j + 802)]

def upperPairs (j : Fin 4) : List (Wire × Wire) :=
  (List.range (wp15E (start15E j) - 2)).map fun i =>
    (start15E j + h15E j + 33 + i, h15E j + 803 + i)

def upperTail (j : Fin 4) : List (Wire × Wire) :=
  (List.range (wp15E (start15E j) - 3)).map fun i =>
    (start15E j + h15E j + 34 + i, h15E j + 804 + i)

def saved (j : Fin 4) : List Wire :=
  [h15E j + 1574, h15E j + 1575, h15E j + 1576] ++ (upperTail j).map Prod.snd

def pending (j : Fin 4) : List Wire :=
  [h15E j + 1580, h15E j + 1581, h15E j + 1582]

def lowA (j : Fin 4) : List Wire := List.range' (start15E j + 16) (h15E j + 15)
def lowB (j : Fin 4) : List Wire := List.range' 786 (h15E j + 15)

def safe (j : Fin 4) (q : Wire) : Prop :=
  (q < start15E j + 16 ∨ start15E j + h15E j + 31 ≤ q) ∧ (q < 786 ∨ h15E j + 801 ≤ q)

def lay (j : Fin 4) : SkywalkIntegerLayout := W.compactSkywalkTickLayout base (start15E j)
def pull (j : Fin 4) : Wire → Wire := OB5.sig (start15E j - 1)
def carryPorts (j : Fin 4) : List Wire :=
  ((IntegerPacket.ports (shape15E j) 0).carry).map (windowNet15E j)
def rest (j : Fin 4) : List Wire := (carryPorts j).drop 1
def guarded (j : Fin 4) : List Wire :=
  ports j ++ [flagN j, flagF j, flagU j] ++ RailPair.sites (upperPairs j)

def enterP15E (j : Fin 4) : Program := renameProgram (map j) EnterProof17.forward
def enterInvP15E (j : Fin 4) : Program := renameProgram (map j) EnterProof17.backward

theorem ports_length (j : Fin 4) : (ports j).length = EnterProof17.width := rfl

theorem inc_all : ∀ j : Fin 4, ∀ a b : Fin EnterProof17.width, map j a = map j b → a = b := by
  decide +kernel

theorem inc (j : Fin 4) : ∀ a b : Fin EnterProof17.width, map j a = map j b → a = b := inc_all j

theorem enter15E_counts (j : Fin 4) :
    toffoliCount (enterP15E j) = 6 ∧ toffoliCount (enterInvP15E j) = 6 ∧
    measurementCount (enterP15E j) = 2 ∧ measurementCount (enterInvP15E j) = 3 ∧
    gateSlots (enterP15E j) = 35 ∧ gateSlots (enterInvP15E j) = 36 := by
  have f : toffoliCount EnterProof17.forward = 6 ∧ measurementCount EnterProof17.forward = 2 ∧
      gateSlots EnterProof17.forward = 35 ∧ toffoliCount EnterProof17.backward = 6 ∧
      measurementCount EnterProof17.backward = 3 ∧ gateSlots EnterProof17.backward = 36 := by
    decide +kernel
  simp only [enterP15E, enterInvP15E, (renameProgram_counts _ _).1, (renameProgram_counts _ _).2,
    Baselines.rename_gateSlots, f.1, f.2.1, f.2.2.1, f.2.2.2.1, f.2.2.2.2.1, f.2.2.2.2.2, and_self]

private def instrPhysB : Instr → Bool
  | .X _ => true
  | .CX a t => decide (a ≠ t)
  | .CCX a b t => decide (a ≠ t ∧ b ≠ t)
  | .measureX _ _ _ => true

private theorem instrPhysB_sound {i : Instr} (h : instrPhysB i = true) :
    RecordedQuantum.PhysicalInstr (.gate i) := by
  cases i <;> simp [instrPhysB, RecordedQuantum.PhysicalInstr, ProperGate] at h ⊢
  all_goals exact h

theorem enter15E_phys (j : Fin 4) :
    GatePhysical (enterP15E j) ∧ GatePhysical (enterInvP15E j) := by
  have good : ∀ k : Fin 4,
      (enterP15E k).all instrPhysB = true ∧ (enterInvP15E k).all instrPhysB = true := by
    decide +kernel
  exact ⟨fun i hi => instrPhysB_sound (List.all_eq_true.mp (good j).1 i hi),
    fun i hi => instrPhysB_sound (List.all_eq_true.mp (good j).2 i hi)⟩

private theorem enter17_fwd_sub : wires EnterProof17.forward ⊆ Finset.range 13 := by
  rw [EnterProof17.forward_all]; exact Finset.Subset.rfl

private theorem enter17_bwd_sub : wires EnterProof17.backward ⊆ Finset.range 13 := by
  have sup : wires EnterProof17.forward = wires EnterProof17.backward := by decide +kernel
  rw [← sup, EnterProof17.forward_all]; exact Finset.Subset.rfl

theorem enter15E_cov (j : Fin 4) :
    WindowCovered.CoveredW (enterP15E j) ∧ WindowCovered.CoveredW (enterInvP15E j) := by
  have hdom : ∀ k : Fin 4, ∀ q ∈ ports k, WindowCovered.domainW q = true := by decide +kernel
  have mk : ∀ P : Program, wires P ⊆ Finset.range 13 → WindowCovered.CoveredW (renameProgram (map j) P) := by
    intro P hP q hq
    rw [renameProgram_support] at hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
    have lt : w < (ports j).length := Finset.mem_range.mp (hP hw)
    rw [map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem lt, Option.getD_some]
    exact hdom j _ (List.getElem_mem lt)
  exact ⟨mk _ enter17_fwd_sub, mk _ enter17_bwd_sub⟩

theorem frame (j : Fin 4) :
    start15E j = 365 + 15 * j.val ∧ j.val < 4 ∧
    2 * h15E j + start15E j ≤ 497 ∧
    496 ≤ 2 * h15E j + start15E j ∧
    40 < wp15E (start15E j) ∧ wp15E (start15E j) + h15E j ≤ 242 := by
  have arith : ∀ k : Fin 4,
      2 * h15E k + start15E k ≤ 497 ∧
      496 ≤ 2 * h15E k + start15E k ∧
      40 < wp15E (start15E k) ∧ wp15E (start15E k) + h15E k ≤ 242 := by
    decide +kernel
  exact ⟨rfl, j.isLt, arith j⟩

theorem upperSites (j : Fin 4) {q : Wire} (h : q ∈ RailPair.sites (upperPairs j)) :
    (start15E j + h15E j + 33 ≤ q ∧ q + 2 < start15E j + h15E j + 33 + wp15E (start15E j)) ∨
    (h15E j + 803 ≤ q ∧ q + 2 < h15E j + 803 + wp15E (start15E j)) := by
  simp only [RailPair.sites, upperPairs, List.mem_flatMap, List.mem_map, List.mem_range,
    List.mem_cons, List.not_mem_nil, or_false] at h
  obtain ⟨p, ⟨i, hi, rfl⟩, hp⟩ := h
  simp only [Wire] at *
  rcases hp with rfl | rfl <;> omega

theorem portsRegion (j : Fin 4) {q : Wire} (h : q ∈ ports j) :
    (start15E j + h15E j + 31 ≤ q ∧ q ≤ start15E j + h15E j + 32) ∨
    (h15E j + 801 ≤ q ∧ q ≤ h15E j + 803) ∨
    q = start15E j + 15 ∨
    (h15E j + 1574 ≤ q ∧ q ≤ h15E j + 1579) ∨
    q = 1556 := by
  simp only [ports, List.mem_cons, List.not_mem_nil, or_false] at h
  simp only [Wire] at *
  omega

private theorem aperture_all : ∀ j : Fin 4,
    pull j (gate j) = (lay j).previous ∧
    (railA j).map (pull j) = ((lay j).a.drop (h15E j + 15)).take 2 ∧
    (railB j).map (pull j) = ((lay j).b.drop (h15E j + 15)).take 2 ∧
    h15E j + 15 + 3 ≤ (lay j).a.length ∧
    h15E j + 15 + 3 ≤ (lay j).b.length ∧
    pull j (start15E j + h15E j + 33) = (lay j).a.getD (h15E j + 15 + 2) 0 ∧
    pull j (h15E j + 803) = (lay j).b.getD (h15E j + 15 + 2) 0 ∧
    (∀ q ∈ clear j, pull j q ∈ (lay j).carry) := by
  decide +kernel

theorem park_mem (j : Fin 4) : (start15E j + h15E j + 33, h15E j + 803) ∈ upperPairs j := by
  have f := frame j
  unfold upperPairs
  exact List.mem_map.mpr ⟨0, List.mem_range.mpr (by omega), rfl⟩

theorem protected0 (j : Fin 4) : ∀ q ∈ gate j :: (railA j ++ railB j ++ clear j),
    q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧ q ∉ RailPair.sites (upperPairs j) := by
  have f := frame j
  intro q hq
  simp only [gate, railA, railB, clear, flagN, flagF, flagU, List.mem_cons, List.mem_append,
    List.not_mem_nil, or_false] at hq ⊢
  refine ⟨by simp only [Wire] at *; omega, by simp only [Wire] at *; omega,
    by simp only [Wire] at *; omega, fun hs => ?_⟩
  have u := upperSites j hs
  simp only [Wire] at *
  omega

def layout (j : Fin 4) : EnterProof17.Aperture (lowerPairs j) (upperPairs j) (gate j)
    (flagN j) (flagF j) (flagU j) (ports j) (lay j) (pull j) (h15E j + 15) where
  a := railA j
  b := railB j
  park := (start15E j + h15E j + 33, h15E j + 803)
  spec := ⟨rfl, rfl, clear j, rfl⟩
  g0 := (aperture_all j).1
  xa := (aperture_all j).2.1
  xb := (aperture_all j).2.2.1
  na := (aperture_all j).2.2.2.1
  nb := (aperture_all j).2.2.2.2.1
  parked := park_mem j
  pa := (aperture_all j).2.2.2.2.2.1
  pb := (aperture_all j).2.2.2.2.2.2.1
  protected0 := protected0 j
  temps := (aperture_all j).2.2.2.2.2.2.2

theorem from_full (j : Fin 4) (raw v : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (h15E j) 15 z)
    (p : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (h15E j) 15 z))
      (decide (Shadow.far (h15E j) 15 z ∧ 2 ^ h15E j ≤ z.u))
      (pullState (pull j) raw) v)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    let next := run (enterP15E j) m v
    next.phase = v.phase ∧
    (∀ q ∈ wires EnterProof17.forward,
      next.basis (map j q) = (EnterProof17.shadowRow (h15E j) 15 z G S).testBit q) ∧
    ∀ q ∉ wires (enterP15E j), next.basis q = v.basis q := by
  have src := EnterProof17.read_packed (layout j) raw v z G S p input
  apply EnterProof17.actual_shadow (map j) (enterP15E j) false (h15E j) 15 z G S small (inc j) rfl v m
  intro q h
  have lim : wires EnterProof17.forward ⊆ Finset.range 13 := enter17_fwd_sub
  have hv := EnterProof.bitAt (ports j) v.basis q
    ((show (ports j).length = 13 from rfl) ▸ Finset.mem_range.mp (lim h))
  rw [src] at hv
  exact hv

theorem programCover (j : Fin 4) : wires (enterP15E j) ⊆ (ports j).toFinset := by
  rw [enterP15E, renameProgram_support, EnterProof17.forward_all]
  intro q hq
  obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
  have lt : w < (ports j).length := Finset.mem_range.mp hw
  rw [List.mem_toFinset, map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem lt, Option.getD_some]
  exact List.getElem_mem lt

theorem notWire (j : Fin 4) {q : Wire} (h : q ∉ ports j) : q ∉ wires (enterP15E j) :=
  fun m => h (List.mem_toFinset.mp (programCover j m))

theorem avoid_enter (j : Fin 4) : ∀ q ∈ pending j, q ∉ wires (enterP15E j) := by
  have f := frame j
  intro q hq
  apply notWire j
  intro hp
  have r := portsRegion j hp
  simp only [pending, List.mem_cons, List.not_mem_nil, or_false, Wire] at hq r ⊢
  omega

private theorem low_and_high_all : ∀ j : Fin 4,
    (lowA j).map (pull j) = (lay j).a.take (h15E j + 15) ∧
    (lowB j).map (pull j) = (lay j).b.take (h15E j + 15) ∧
    ((upperTail j).map Prod.fst).map (pull j) = (lay j).a.drop (h15E j + 18) ∧
    ((upperTail j).map Prod.snd).map (pull j) = (lay j).b.drop (h15E j + 18) ∧
    h15E j + 18 ≤ (lay j).a.length ∧
    h15E j + 18 ≤ (lay j).b.length ∧
    (lay j).carry = List.range' 1556 (W.compactSkywalkTickPreWidth (start15E j) - 1) ∧
    h15E j + 18 ≤ W.compactSkywalkTickPreWidth (start15E j) ∧
    (∀ q ∈ guarded j, q < 1557 ∨ h15E j + 1574 ≤ q) ∧
    (IntegerPacket.ports (shape15E j) 0).a.map (windowNet15E j) = lowA j ++ railA j ∧
    (IntegerPacket.ports (shape15E j) 0).b.map (windowNet15E j) = lowB j ++ railB j ∧
    windowNet15E j (IntegerPacket.ports (shape15E j) 0).previous = (ports j).getD 4 0 ∧
    (∀ r : Fin 15, let q := windowNet15E j (IntegerPacket.ports (shape15E j) r).ext
      q ∉ ports j ∧ (q ∈ (upperPairs j).map Prod.fst ∨
        (pull j q = (lay j).ext ∧ q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧ q ∉ RailPair.sites (upperPairs j)))) ∧
    (∀ r : Fin 15, let q := windowNet15E j (IntegerPacket.ports (shape15E j) r).history
      q ∉ ports j ∧ q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧ q ∉ RailPair.sites (upperPairs j)) := by
  decide +kernel

theorem protects (j : Fin 4) (q : Wire) (h : q ∈ lowA j ++ lowB j) :
    q ∉ wires (enterP15E j) ∧ q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧
    q ∉ RailPair.sites (upperPairs j) := by
  have f := frame j
  have hng : q ∉ guarded j := by
    intro mem
    simp only [lowA, lowB, List.mem_append, List.mem_range'_1] at h
    simp only [guarded, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at mem
    rcases mem with (hp | hn) | hs
    · have r := portsRegion j hp; simp only [Wire] at *; omega
    · simp only [flagN, flagF, flagU, Wire] at *; omega
    · have u := upperSites j hs; simp only [Wire] at *; omega
  simp only [guarded, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or] at hng
  exact ⟨notWire j hng.1.1, hng.1.2.1, hng.1.2.2.1, hng.1.2.2.2, hng.2⟩

def placement (j : Fin 4) : EnterProof17.WordPlacement (b := h15E j) (k := 15) (layout j) (enterP15E j) where
  lowA := lowA j
  lowB := lowB j
  al := List.length_range'
  bl := List.length_range'
  xa := (low_and_high_all j).1
  xb := (low_and_high_all j).2.1
  aTop := rfl
  bTop := rfl
  protected0 := protects j
  portsCount := rfl

theorem carryPorts_eq (j : Fin 4) : carryPorts j = List.range' 1556 (h15E j + 16) := by
  have hj := j.isLt
  have hc : (IntegerPacket.ports (shape15E j) 0).carry = List.range' 1556 (h15E j + 16) := rfl
  unfold carryPorts
  rw [hc]
  conv => rhs; rw [← List.map_id (List.range' 1556 _)]
  apply List.map_congr_left
  intro q hq
  rw [List.mem_range'_1] at hq
  simp only [windowNet15E, OB5.sig, start15E, h15E, sb15E, id, Wire] at hq ⊢
  split <;> omega

theorem rest_eq (j : Fin 4) : rest j = List.range' 1557 (h15E j + 15) := by
  rw [rest, carryPorts_eq, List.drop_range']; congr 1

theorem ready_from_cut_at (j : Fin 4) (raw v : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (h15E j) 15 z)
    (p : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (h15E j) 15 z))
      (decide (Shadow.far (h15E j) 15 z ∧ 2 ^ h15E j ≤ z.u))
      (pullState (pull j) raw) v)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (hist : ∀ r : Fin 15,
      raw.basis (pull j (windowNet15E j (IntegerPacket.ports (shape15E j) r).history)) = false) :
    let t := run (enterP15E j) m v
    let T := Shadow.reduced (h15E j) 15 z
    t.phase = v.phase ∧ onRails15E j 0 (SkywalkRails.encode G S T.u T.v) t.basis := by
  obtain ⟨ph, body, outer⟩ := from_full j raw v z G S m small p input
  have lh := low_and_high_all j
  have hcarry : ∀ q ∈ (IntegerPacket.ports (shape15E j) 0).carry,
      windowNet15E j q ∈ (ports j).drop 12 ∨
      (windowNet15E j q ∉ wires (enterP15E j) ∧ pull j (windowNet15E j q) ∈ (lay j).carry ∧
       windowNet15E j q ≠ flagN j ∧ windowNet15E j q ≠ flagF j ∧ windowNet15E j q ≠ flagU j ∧
       windowNet15E j q ∉ RailPair.sites (upperPairs j)) := by
    intro q hq
    have hm : windowNet15E j q ∈ carryPorts j := List.mem_map.mpr ⟨q, hq, rfl⟩
    have hp : carryPorts j = (ports j).drop 12 ++ rest j := by
      rw [rest_eq, carryPorts_eq]
      have e : h15E j + 16 = 1 + (h15E j + 15) := by omega
      rw [e, ← List.range'_append_1]; rfl
    rw [hp, List.mem_append] at hm
    rcases hm with hm | hm
    · exact Or.inl hm
    · have hng : windowNet15E j q ∉ guarded j := by
        intro hg
        have hb := lh.2.2.2.2.2.2.2.2.1 _ hg
        rw [rest_eq, List.mem_range'_1] at hm
        simp only [Wire] at *; omega
      simp only [guarded, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or] at hng
      have hsrc : pull j (windowNet15E j q) ∈ (lay j).carry := by
        rw [rest_eq, List.mem_range'_1] at hm
        rw [lh.2.2.2.2.2.2.1, List.mem_range'_1]
        have hj := j.isLt
        have fix : pull j (windowNet15E j q) = windowNet15E j q := by
          simp only [pull, OB5.sig, start15E, h15E, sb15E, Wire] at hm ⊢
          split <;> omega
        rw [fix]; have := lh.2.2.2.2.2.2.2.1; simp only [Wire] at *; omega
      exact Or.inr ⟨notWire j hng.1.1, hsrc, hng.1.2.1, hng.1.2.2.1, hng.1.2.2.2, hng.2⟩
  refine ⟨ph, ?_⟩
  let post := run (enterP15E j) m v
  have values := EnterProof17.short_rails (enterP15E j) (placement j) z G S small raw v post p input body outer
  have move (qs : List Wire) :
      signedRegValue qs (mappedBasis15E j post.basis) = signedRegValue (qs.map (windowNet15E j)) post.basis := by
    simp only [signedRegValue, List.length_map, PortalValues.unroute]; rfl
  have gval := EnterProof17.actual_tags (ports j) post.basis (h15E j) 15 z G S body
  have sc := EnterProof17.output_values (ports j) post.basis (h15E j) 15 z G S (placement j).portsCount body
  have clean := (regValue_zero _ _).mp sc.2.2
  have hCarry : regValue (IntegerPacket.ports (shape15E j) 0).carry (mappedBasis15E j post.basis) = 0 := by
    rw [regValue_zero]
    intro q hq
    rcases hcarry q hq with h0 | ⟨nw, hsrc, hn, hf, hu, hup⟩
    · exact clean _ h0
    · change post.basis (windowNet15E j q) = false
      rw [outer _ nw, p.unchanged _ hn hf hu hup]
      exact (regValue_zero _ _).mp input.2.2.2.2.2 _ hsrc
  refine ⟨(move _).trans (lh.2.2.2.2.2.2.2.2.2.1 ▸ values.1),
    (move _).trans (lh.2.2.2.2.2.2.2.2.2.2.1 ▸ values.2), ?_, hCarry, ?_⟩
  · change post.basis (windowNet15E j (IntegerPacket.ports (shape15E j) 0).previous) =
      (SkywalkRails.encode G S (Shadow.reduced (h15E j) 15 z).u (Shadow.reduced (h15E j) 15 z).v).g
    rw [lh.2.2.2.2.2.2.2.2.2.2.2.1, gval.1]; cases G <;> rfl
  · intro r _ hr
    have he := lh.2.2.2.2.2.2.2.2.2.2.2.2.1 ⟨r, hr⟩
    have hh := lh.2.2.2.2.2.2.2.2.2.2.2.2.2 ⟨r, hr⟩
    refine ⟨?_, ?_⟩
    · change post.basis (windowNet15E j (IntegerPacket.ports (shape15E j) r).ext) = false
      rw [outer _ (notWire j he.1)]
      rcases he.2 with hpair | ⟨hpl, hn, hf, hu, hup⟩
      · obtain ⟨pr, hpr, eq⟩ := List.mem_map.mp hpair
        rw [← eq]; exact (p.upper pr hpr).1
      · rw [p.unchanged _ hn hf hu hup]; change raw.basis (pull j _) = false; rw [hpl]; exact input.2.2.2.1
    · change post.basis (windowNet15E j (IntegerPacket.ports (shape15E j) r).history) = false
