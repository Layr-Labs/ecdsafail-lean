theorem placed15E_run_eq (j : Fin 4) (s : State) (m : List Bool)
    (h : KeptParity.relation (fun q => s.basis (port15E (start15E j) q))) :
    run (GateMirror.forward (placed15E (start15E j))) m s =
      run (GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 0 8)) m s := by
  let f := port15E (start15E j)
  let t : State := ⟨s.phase, fun q => s.basis (f q)⟩
  have inj (a : Wire) (ha : a ∈ Finset.range 17) (b : Wire) (hb : b ∈ Finset.range 17) (eq : f a = f b) : a = b :=
    congrArg Fin.val (geometry15E j ⟨a, Finset.mem_range.mp ha⟩ ⟨b, Finset.mem_range.mp hb⟩ eq)
  have eq := KeptParity.same t m h
  have boundedNew : wires (GateMirror.forward KeptParity.replacement) ⊆ Finset.range 17 := by decide
  have boundedOld : wires (GateMirror.forward KeptParity.old) ⊆ Finset.range 17 := by decide
  have hf_new : GateMirror.forward (placed15E (start15E j)) = renameProgram f (GateMirror.forward KeptParity.replacement) := rfl
  have hf_old : GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 0 8) =
      renameProgram f (GateMirror.forward KeptParity.old) := rfl
  rw [hf_new, hf_old]
  exact run_rename_eq_of_eq f (Finset.range 17) inj _ _ boundedNew boundedOld m m t s rfl (fun _ _ => rfl) eq

