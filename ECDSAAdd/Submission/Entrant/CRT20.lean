  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem restore_sort : ∀ i, restoreRoute i = i ∨ (23 ≤ i.val ∧ 23 ≤ (restoreRoute i).val) := by
  have h1 : ((restoreRouteList.map Fin.val).all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro i
  simp only [restoreRoute, Fin.ext_iff, ECDSAAdd.Entrant.WSlimV3.fin_getD_val, Fin.val_zero, Fin.isValue,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1]
  revert i
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem restore_scope : ∀ p ∈ restoreMoves, (∃ i, codePorts i = p.1) ∧ (∃ i, codePorts i = p.2) := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem restore_run (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame codePorts (startCols false d) row s) :
    let t := run ((Shadow7.exitRestoreP 425) d) m s
    t.phase = s.phase ∧ Frame rawPorts (endCols false d) row t ∧
    ∀ q, (∀ i, codePorts i ≠ q) → t.basis q = s.basis q := by
  rw [restore_program]
  apply packet false d codePorts rawPorts restoreMap restoreMoves restoreRoute restore_unique _
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) restore_route restore_sort restore_scope row hr s m ready
  intro q h
  have lim : q < 150 := by cases d <;> exact h
  exact ⟨⟨q, by omega⟩, rfl, restore_map ⟨q, lim⟩⟩

theorem code_from_raw : ∀ i, ∃ j, rawPorts j = codePorts i := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem roundtrip (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m n : List Bool)
    (ready : Frame rawPorts raw row s) :
    run ((Shadow7.exitRestoreP 425) d) n (run ((Shadow7.exitLoadP 425) d) m s) = s := by
  have f := load_run d row hr s m ready
  have b := restore_run d row hr _ n f.2.1
  apply state_eq
  · exact b.1.trans f.1
  · intro q
    by_cases h : ∃ i, rawPorts i = q
    · obtain ⟨i, rfl⟩ := h
      exact (b.2.1 i).trans (ready i).symm
    · have no : ∀ i, rawPorts i ≠ q := fun i eq => h ⟨i, eq⟩
      have noc : ∀ i, codePorts i ≠ q := by
        intro i; obtain ⟨j, eq⟩ := code_from_raw i
        exact eq ▸ no j
      exact (b.2.2 q noc).trans (f.2.2 q no)

theorem exit425_dom : ∀ i : Fin 157, WindowCovered.domainW (rawPorts i) = true := by
  decide +kernel

theorem exit425_counts (d : Bool) :
    toffoliCount (Shadow7.exitLoadP 425 d) = 41 ∧
    measurementCount (Shadow7.exitLoadP 425 d) = (if d then 48 else 49) ∧
    toffoliCount (Shadow7.exitRestoreP 425 d) = (if d then 50 else 51) ∧
    measurementCount (Shadow7.exitRestoreP 425 d) = (if d then 43 else 44) := by
  have h := Shadow7.archive_counts ⟨0, by decide⟩ 425 d
  cases d
  · exact ⟨h.2.2.2.2.2.2.1.trans PartialCosts.part9.1, h.2.2.2.2.2.2.2.1.trans PartialCosts.part9.2,
      h.2.2.2.2.2.2.2.2.2.1.trans PartialCosts.part43.1, h.2.2.2.2.2.2.2.2.2.2.1.trans PartialCosts.part43.2⟩
  · exact ⟨h.2.2.2.2.2.2.1.trans PartialCosts.part25.1, h.2.2.2.2.2.2.2.1.trans PartialCosts.part25.2,
      h.2.2.2.2.2.2.2.2.2.1.trans PartialCosts.part57.1, h.2.2.2.2.2.2.2.2.2.2.1.trans PartialCosts.part57.2⟩

theorem load_cover (d : Bool) : wires ((Shadow7.exitLoadP 425) d) ⊆ rawPortsList.toFinset := by
  rw [load_program, wires_append, Finset.union_subset_iff]
  constructor
  · rw [StairArchiveIntegerHook.placed, renameProgram_support]
    intro q member
    obtain ⟨w, used, rfl⟩ := Finset.mem_image.mp member
    have bound := Finset.mem_range.mp (sub (op true d) used)
    have small : w < 155 := by cases d <;> exact bound
    have inside : ∀ j : Fin 155, loadMap j ∈ rawPortsList := by
      (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    exact List.mem_toFinset.mpr (inside ⟨w, small⟩)
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem exit425_phys (d : Bool) :
    GatePhysical (Shadow7.exitLoadP 425 d) ∧ GatePhysical (Shadow7.exitRestoreP 425 d) := by
  have hlenL : (Shadow7.loadPortsXP 425 (bTopP 425 + 1)).length = 155 := Shadow7.loadPortsXP_length 425 _
  have hlenR : (Shadow7.restorePortsXP 425).length = 150 := Shadow7.restorePortsXP_length 425
  have hndL : (Shadow7.loadPortsXP 425 (bTopP 425 + 1)).Nodup := by
    have eq : Shadow7.loadPortsXP 425 (bTopP 425 + 1) = loadMapList := by decide +kernel
    rw [eq]; decide +kernel
  have hndR : (Shadow7.restorePortsXP 425).Nodup := by
    have eq : Shadow7.restorePortsXP 425 = restoreMapList := by decide +kernel
    rw [eq]; decide +kernel
  have hmvL : (Partial.moveLoadPairs 425).all (fun p => decide (p.1 ≠ p.2)) = true := by decide +kernel
  have hmvR : (Partial.moveRestorePairs 425 (bTopP 425 + 1)).all (fun p => decide (p.1 ≠ p.2)) = true := by decide +kernel
  have hpL : GatePhysical (Partial.moveLoadP 425) :=
    (Partial.physical_of_proper _ (Partial.proper_swapsG _ (fun p hp => of_decide_eq_true (List.all_eq_true.mp hmvL p hp)))).1
  have hpR : GatePhysical (Partial.moveRestoreP 425 (bTopP 425 + 1)) :=
    (Partial.physical_of_proper _ (Partial.proper_swapsG _ (fun p hp => of_decide_eq_true (List.all_eq_true.mp hmvR p hp)))).1
  exact ⟨WindowPhysicalW.appP (WindowPhysicalW.load_codec_phys _ hndL hlenL.ge d) hpL,
    WindowPhysicalW.appP (WindowPhysicalW.restore_codec_phys _ hndR hlenR.ge d) hpR⟩

theorem exit425_cov (d : Bool) :
    WindowCovered.CoveredW (Shadow7.exitLoadP 425 d) ∧ WindowCovered.CoveredW (Shadow7.exitRestoreP 425 d) := by
  have hL : WindowCovered.CoveredW (Shadow7.exitLoadP 425 d) := fun q hq => by
    have hm := List.mem_toFinset.mp (load_cover d hq)
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hm
    have hlen : rawPortsList.length = 157 := by decide
    have eq : rawPorts ⟨i, hlen ▸ hi⟩ = rawPortsList[i] := by
      simp [rawPorts, List.getD_eq_getElem?_getD, hi]
    exact eq ▸ exit425_dom ⟨i, hlen ▸ hi⟩
  have hR_sub : wires ((Shadow7.exitRestoreP 425) d) ⊆ codePortsList.toFinset := by
    rw [restore_program, wires_append, Finset.union_subset_iff]
    constructor
    · rw [StairArchiveIntegerHook.placed, renameProgram_support]
      intro q member
      obtain ⟨w, used, rfl⟩ := Finset.mem_image.mp member
      have bound := Finset.mem_range.mp (sub (op false d) used)
      have small : w < 150 := by cases d <;> exact bound
      have inside : ∀ j : Fin 150, restoreMap j ∈ codePortsList := by
        (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
      exact List.mem_toFinset.mpr (inside ⟨w, small⟩)
    · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have hR : WindowCovered.CoveredW (Shadow7.exitRestoreP 425 d) := fun q hq => by
    have hm := List.mem_toFinset.mp (hR_sub hq)
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hm
    have hlen : codePortsList.length = 157 := by decide
    have hc_dom : ∀ k : Fin 157, WindowCovered.domainW (codePorts k) = true := fun k => by
      obtain ⟨r, hr⟩ := code_from_raw k
      exact hr ▸ exit425_dom r
    have eq : codePorts ⟨i, hlen ▸ hi⟩ = codePortsList[i] := by
      simp [codePorts, List.getD_eq_getElem?_getD, hi]
    exact eq ▸ hc_dom ⟨i, hlen ▸ hi⟩
  exact ⟨hL, hR⟩

end ECDSAAdd.Entrant.StairPacket.ArchiveBoundary425

end


section
/-!
Exit portal semantics at tick `425` (`Portal425Flag`):
exact mirror of `Portal420Flag7` for `e = 425` (`sb = 36`, `wp = 36`, `e0 = 1610`,
flags `1613, 1614, 1615`, `gate = 440`, `railA = 493..528`, `railB = 838..873`,
`carry = 1557..1589`, threshold `2^52`, small cutoff `2^36`).
Proves `physical_frame_local` and `release` for `Shadow7.portalP 425` / `Shadow7.portalInvP 425`.
-/

namespace ECDSAAdd.Entrant.StairPacket.Portal425Flag

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.StairPacket.PortalAnd
open ECDSAAdd.Entrant.StairPacket.PortalValues
open ECDSAAdd.Entrant.StairPacket.RailPair

set_option maxRecDepth 30000
set_option maxHeartbeats 8000000
set_option exponentiation.threshold 1024
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def railA : List Wire := List.range' 492 37
def railB : List Wire := List.range' 837 37
def carry : List Wire := List.range' 1557 34
def bulkA : List Wire := railA.drop 2
def bulkB : List Wire := railB.drop 2

def thresholdPairs : List (Wire × Wire) := (List.range 35).map fun i => (494 + i, 1558 + i)
def orientationPairs : List (Wire × Wire) := (List.range 36).map fun i => (838 + i, 1556 + i)

def threshold : Program := latch true none 1556 493 thresholdPairs
def orientation : Program := latch false (some 1613) 1614 837 orientationPairs

def scan : Program :=
  [.CX 528 1615, .CX 873 1615] ++
    RailPair.exchange 440 (railA.zip railB) ++ signComplement 1615 railB

def flags : Program :=
  threshold ++ [.CX 1556 1613, .CX 1613 1556] ++ orientation

def erase : Program :=
  [.X 493, .CCX 838 493 1556] ++
    Companion.eraseM bulkA bulkB carry 1614 1556 ++
    [.measureX 1556 [] [.CZ 838 493], .X 493]

def store : Program :=
  RailPair.transfer false (bulkA.zip bulkB) ++
    signComplement 1615 (railB.take 2) ++
    RailPair.exchange 440 ((railA.take 2).zip (railB.take 2))

def backFlags : Program :=
  PortalAnd.flagsBack2 493 1556 1613 1614 837 thresholdPairs orientationPairs

def backErase : Program :=
  PortalBorrow.wrap 493 838 1556 (PortalBorrow.restore bulkA bulkB carry 1614 1556)

def activeScratch : List Wire :=
  [1557, 1556, 1613, 1614, 1556] ++ thresholdPairs.map Prod.snd ++ orientationPairs.map Prod.snd ++ carry

def pairs : List (Wire × Wire) := railA.zip railB
def loPairs : List (Wire × Wire) := (railA.take 2).zip (railB.take 2)
def hiPairs : List (Wire × Wire) := bulkA.zip bulkB

theorem emitted : Shadow7.portalP 425 = scan ++ flags ++ erase ++ store := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem emitted_back : Shadow7.portalInvP 425 = store.reverse ++ backErase ++ backFlags ++ scan.reverse := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem copy_good : Companion.Geometry bulkA bulkB carry 1614 1556 := by
  constructor <;> (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem flags_spec : flags = PortalAnd.flags2 493 1556 1613 1614 837 thresholdPairs orientationPairs := rfl
theorem erase_spec : erase = PortalBorrow.wrap 493 838 1556 (Companion.eraseM bulkA bulkB carry 1614 1556) := rfl
theorem scan_proper : ProperProgram scan := PortalStatic.proper _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
theorem store_proper : ProperProgram store := PortalStatic.proper _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))

theorem away_scan : ∀ q ∈ activeScratch, q ∉ wires scan :=
  PortalStatic.separated _ _ 1615 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))

theorem flags_do (s : State) (m : List Bool) (h : ∀ q ∈ activeScratch, s.basis q = false) :
    let f := (PortalAnd.digits 493 thresholdPairs).any s.basis
    let u := f && (PortalAnd.digits 837 orientationPairs).any s.basis
    run flags m s = ⟨s.phase, writeBit (writeBit s.basis 1613 f) 1614 u⟩ := by
  rw [flags_spec]
  apply PortalAnd.flags2_run
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · decide
  · exact h _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · exact h _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · exact h _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · intro p hp
    exact h _ (by simp only [activeScratch, List.mem_append]; exact Or.inl (Or.inl (Or.inr (List.mem_map.mpr ⟨p, hp, rfl⟩))))
  · intro p hp
    exact h _ (by simp only [activeScratch, List.mem_append]; exact Or.inl (Or.inr (List.mem_map.mpr ⟨p, hp, rfl⟩)))

theorem flags_return (s : State) (m n : List Bool) (h : ∀ q ∈ activeScratch, s.basis q = false) :
    run backFlags n (run flags m s) = s := by
  rw [flags_spec]
  apply PortalAnd.flags2_undo
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · decide
  · exact h _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · exact h _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · exact h _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · intro p hp
    exact h _ (by simp only [activeScratch, List.mem_append]; exact Or.inl (Or.inl (Or.inr (List.mem_map.mpr ⟨p, hp, rfl⟩))))
  · intro p hp
    exact h _ (by simp only [activeScratch, List.mem_append]; exact Or.inl (Or.inr (List.mem_map.mpr ⟨p, hp, rfl⟩)))

theorem erase_return (s : State) (m n : List Bool) (h : s.basis 1556 = false ∧ ∀ q ∈ carry, s.basis q = false)
    (value : (regValue bulkB s.basis + (s.basis 838 && !s.basis 493).toNat) % 2 ^ bulkB.length =
      copyValue (some 1614) s.basis (regValue bulkA s.basis)) :
    run backErase n (run erase m s) = s := by
  rw [erase_spec]
  apply PortalBorrow.erase_undoM
  · exact copy_good
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · exact h.1
  · exact h.2
  · exact value

theorem portal_return (s : State) (m tape : List Bool) (h : ∀ q ∈ activeScratch, s.basis q = false)
    (ev : ∀ m0 : List Bool,
      (regValue bulkB (run flags m0 (run scan m s)).basis +
        ((run flags m0 (run scan m s)).basis 838 && !(run flags m0 (run scan m s)).basis 493).toNat) %
        2 ^ bulkB.length =
      copyValue (some 1614) (run flags m0 (run scan m s)).basis (regValue bulkA (run flags m0 (run scan m s)).basis)) :
    run (Shadow7.portalInvP 425) tape (run (Shadow7.portalP 425) m s) = s := by
  let v := run scan m s
  have vh : ∀ q ∈ activeScratch, v.basis q = false :=
    fun q hp => (run_preserves_outside _ _ _ _ (away_scan _ hp)).trans (h _ hp)
  have hc (m0 : List Bool) : (run flags m0 v).basis 1556 = false ∧ ∀ q ∈ carry, (run flags m0 v).basis q = false := by
    rw [flags_do v m0 vh]
    have dis : ∀ q ∈ carry, q ≠ 1613 ∧ q ≠ 1614 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    constructor
    · simpa [writeBit] using vh 1556 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
    · intro q hq; simp [writeBit, (dis _ hq).1, (dis _ hq).2, vh q (by simp [activeScratch, hq])]
  rw [emitted, emitted_back]
  simp only [run_append, run_take]
  rw [run_reverse_proper _ store_proper, erase_return _ _ _ (hc _) (ev _), flags_return _ _ _ vh,
    run_reverse_proper _ scan_proper]

theorem source : Source (W.compactSkywalkTickLayout base 425) (OB5.sig 424) 51 528 873 440 pairs := by
