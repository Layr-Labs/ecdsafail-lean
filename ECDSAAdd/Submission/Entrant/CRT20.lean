  have hlc := lowClose20_result j s (run (beforeStore20 j) m s)
    (m.drop (measurementCount (beforeStore20 j))) u.1 (PortalValues.negative u.2 (step^[20] z).u)
    ((step^[20] z).u + (step^[20] z).v) ((step^[20] z).u - (PortalValues.negative u.2 (step^[20] z).u).toNat)
    hprev hbs.2.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.2.2.1
  have hkept : physicalCells20 j (run (leaveP20 j) m s) = xs := by
    unfold physicalCells20
    rw [cells20_eq j, show xs = readCells (shape20 j) 0 20 (mappedBasis20 j s.basis) from h.record.symm, cells20_eq j]
    apply List.map_congr_left; intro k hk
    rw [List.mem_range] at hk
    have ha : (run (leaveP20 j) m s).basis (start20 j + 16 + k) = s.basis (start20 j + 16 + k) :=
      w.2.2.2.2.2.2.2.1 _ (List.mem_map.mpr ⟨k, List.mem_range.mpr hk, rfl⟩)
    have hb : (run (leaveP20 j) m s).basis (swaps20 j k) = s.basis (swaps20 j k) := by
      have hsw := swaps20_bounds j ⟨k, hk⟩; dsimp only at hsw
