theorem high_from_cut (j : Fin 4) (raw cut : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (h15E j) 15 z)
    (packed : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (h15E j) 15 z))
      (decide (Shadow.far (h15E j) 15 z ∧ 2 ^ h15E j ≤ z.u))
      (pullState (pull j) raw) cut)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    regValue (saved j) (run (enterP15E j) m cut).basis =
      if Shadow.far (h15E j) 15 z then Shadow.high (h15E j) 15 z else 0 := by
  have lh := low_and_high_all j
  have tail_sub : ∀ p ∈ upperTail j, p ∈ upperPairs j := by
    intro p hp; unfold upperTail at hp; unfold upperPairs
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hi
    exact List.mem_map.mpr ⟨i + 1, List.mem_range.mpr (by omega),
      congrArg₂ Prod.mk (by unfold Wire; omega) (by unfold Wire; omega)⟩
  have savedLive : ∀ q ∈ (upperTail j).map Prod.snd, q ∉ ports j := by
    have f := frame j
    intro q hq hp
    simp only [upperTail, List.map_map, List.mem_map, List.mem_range, Function.comp] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    have r := portsRegion j hp
    simp only [Wire] at *; omega
  have high := EnterProof17.stored_sub (upperTail j) tail_sub (h15E j + 18) raw cut z G S packed input
    (layout j).g0 lh.2.2.1 lh.2.2.2.1 lh.2.2.2.2.1 lh.2.2.2.2.2.1
  obtain ⟨_, bits, outer⟩ := from_full j raw cut z G S m small packed input
  have bulk := regValue_congr ((upperTail j).map Prod.snd) (run (enterP15E j) m cut).basis cut.basis
    (fun q hit => outer q (notWire j (savedLive q hit)))
  apply EnterProof17.assemble (h15E j) 15 z G S _ (h15E j + 1574) (h15E j + 1575) (h15E j + 1576) _
  · exact bits 9 (by rw [EnterProof17.forward_all]; decide)
  · exact bits 10 (by rw [EnterProof17.forward_all]; decide)
  · exact bits 11 (by rw [EnterProof17.forward_all]; decide)
  · exact bulk.trans high

