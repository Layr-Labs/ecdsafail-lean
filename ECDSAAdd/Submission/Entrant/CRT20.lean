set_option maxRecDepth 25000

/-! ### Section 1: 15-tick trailing integer-packet blocks and routing -/

/-- Start tick of the `j`-th trailing 15-tick block (`365, 380, 395, 410`). -/
def start15E (j : Fin 4) : Nat := 365 + 15 * j.val

/-- Tight shadow cutoff for trailing 15-tick blocks (`365→66, 380→58, 395→51, 410→43, 425→36`). -/
def sb15E (s : Nat) : Nat := (497 - s) / 2

def smallBits15E (j : Fin 4) : Nat := sb15E (start15E j)

def shape15E (j : Fin 4) : IntegerPacket.Shape where
  start := start15E j
  length := 15
  mid := smallBits15E j + 15
  rangeEnd := by have h := j.isLt; simp [start15E]; omega
  extent := by have h := j.isLt; simp [start15E, smallBits15E, sb15E]; omega
  midBound := by simp [smallBits15E, sb15E, start15E]; omega

def net15E (j : Fin 4) (a : Nat) : Wire → Wire := OB5.sig (start15E j + a)

def windowNet15E (j : Fin 4) : Wire → Wire := OB5.sig (start15E j + 14)

def mappedBasis15E (j : Fin 4) (s : BasisState) : BasisState := fun q => s (windowNet15E j q)

def routed15E (j : Fin 4) (a : Nat) : Nat → Program
  | 0 => []
  | n + 1 =>
    renameProgram (net15E j a) (skywalkIntegerTick (IntegerPacket.ports (shape15E j) a)) ++
      routed15E j (a + 1) n

def unrouted15E (j : Fin 4) (a : Nat) : Nat → Program
  | 0 => []
  | n + 1 =>
    unrouted15E j (a + 1) n ++
      renameProgram (net15E j a) (ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick
        (IntegerPacket.ports (shape15E j) a) (IntegerPacket.ports (shape15E j) a).half.length)

def onRails15E (j : Fin 4) (i : Nat) (z : SkywalkRails.State) (b : BasisState) : Prop :=
  ready (shape15E j) i z (mappedBasis15E j b)

def physicalCells15E (j : Fin 4) (s : State) : List (Bool × Bool) :=
  readCells (shape15E j) 0 15 (mappedBasis15E j s.basis)

theorem net15E_injective (j : Fin 4) : Function.Injective (windowNet15E j) := by
  apply OB5.sig_injective
  have h := j.isLt
  simp only [start15E]; omega

theorem net15E_invol (j : Fin 4) (q : Wire) : windowNet15E j (windowNet15E j q) = q := by
  apply OB5.sig_invol
  have h := j.isLt
  simp only [start15E]; omega

theorem stable15E {j : Fin 4} {a q : Nat} (ha : a < 15)
    (hq : q ∈ (IntegerPacket.ports (shape15E j) a).wires) : net15E j a q = windowNet15E j q := by
  have hj := j.isLt
  simp only [IntegerPacket.ports, shape15E, smallBits15E, sb15E, start15E, SkywalkIntegerLayout.wires,
    SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh, List.mem_append, List.mem_cons,
    List.mem_range'_1, List.not_mem_nil, or_false] at hq
  unfold windowNet15E net15E OB5.sig start15E
  split <;> split
  all_goals try rfl
  all_goals
    repeat' first | cases_type And | cases_type Or
    all_goals try simp only [Wire] at *
    all_goals omega

theorem fixed_route15E (j : Fin 4) (a n : Nat) (bound : a + n ≤ 15) :
    routed15E j a n = renameProgram (windowNet15E j) (IntegerPacket.seq (shape15E j) a n) ∧
    unrouted15E j a n = renameProgram (windowNet15E j) (IntegerPacket.backR (shape15E j) a n) := by
  induction n generalizing a with
  | zero => exact ⟨rfl, rfl⟩
  | succ n ih =>
    have ha : a < 15 := by omega
    have h := skywalkIntegerTick_wires_subset _ (IntegerPacket.ok (shape15E j) ⟨a, ha⟩)
    have hn : 0 < (IntegerPacket.ports (shape15E j) a).half.length := by simp [SkywalkIntegerLayout.half]
    have u := ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick_support (IntegerPacket.ports (shape15E j) a) _
      (IntegerPacket.ok (shape15E j) ⟨a, ha⟩) hn le_rfl
    obtain ⟨f, r⟩ := ih (a + 1) (by omega)
    have app (g : Wire → Wire) (P Q : Program) :
        renameProgram g (P ++ Q) = renameProgram g P ++ renameProgram g Q := List.map_append
    simp only [routed15E, unrouted15E, IntegerPacket.seq, IntegerPacket.backR, app, f, r]
    constructor
    · exact congrArg (fun P => P ++ _) (renameProgram_congr_support _ _ _ (fun q hq =>
        stable15E ha (List.mem_toFinset.mp (h.1 hq))))
    · exact congrArg (fun P => _ ++ P) (renameProgram_congr_support _ _ _ (fun q hq =>
        stable15E ha (List.mem_toFinset.mp (u hq))))

theorem routed15E_counts (j : Fin 4) (a n : Nat) (bound : a + n ≤ 15) :
    toffoliCount (routed15E j a n) = n * (2 * (smallBits15E j + 16)) ∧
    measurementCount (routed15E j a n) = n * (smallBits15E j + 16) ∧
    toffoliCount (unrouted15E j a n) = n * (2 * (smallBits15E j + 16) - 1) ∧
    measurementCount (unrouted15E j a n) = n * (smallBits15E j + 16) := by
  obtain ⟨f, r⟩ := fixed_route15E j a n bound
  have hs := IntegerPacket.metrics (shape15E j) a n bound
  have hr := IntegerPacket.metricsR (shape15E j) a n bound
  have mid : (shape15E j).mid + 1 = smallBits15E j + 16 := rfl
  rw [mid] at hs hr
  rw [f, r, (renameProgram_counts _ _).1, (renameProgram_counts _ _).2,
    (renameProgram_counts _ _).1, (renameProgram_counts _ _).2]
  exact ⟨hs.1, hs.2.1, hr.1, hr.2⟩

private theorem integer_tick_phys (L : SkywalkIntegerLayout) (hv : L.Valid) :
    GatePhysical (skywalkIntegerTick L) := by
  have enough : 1 ≤ L.half.length := by simp [SkywalkIntegerLayout.half]
  have narrow := narrowTicks_physical L 1 hv (by decide) enough
  simp only [narrowSkywalkTick, gatePhysical_append] at narrow
  obtain ⟨⟨⟨⟨route, half⟩, _⟩, prev⟩, _⟩ := narrow
  have nd := L.record_nodup hv
  have fresh := (List.nodup_cons.mp nd).1
  have sx : L.ext ≠ L.history := fun e => fresh (e ▸ by simp [SkywalkIntegerLayout.half])
  have sy : L.bSign ≠ L.history := fun e => fresh (e ▸ by simp [SkywalkIntegerLayout.b, SkywalkIntegerLayout.bh])
  have toggle : GatePhysical (skywalkSignToggle L.ext L.bSign L.history) := by
    simp [skywalkSignToggle, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, sx, sy]
  have arithmetic := signedWords_physical L.history L.half L.b L.carry nd
  simp only [skywalkIntegerTick, signedRecord, gatePhysical_append]
  exact ⟨⟨⟨route, half⟩, ⟨⟨toggle, arithmetic.1⟩, toggle⟩⟩, prev⟩

theorem routed15E_phys (j : Fin 4) (a n : Nat) (bound : a + n ≤ 15) :
    GatePhysical (routed15E j a n) ∧ GatePhysical (unrouted15E j a n) := by
  induction n generalizing a with
  | zero => simp [routed15E, unrouted15E, GatePhysical]
  | succ n ih =>
    have ha : a < 15 := by omega
    have valid := IntegerPacket.ok (shape15E j) ⟨a, ha⟩
    have tick := integer_tick_phys (IntegerPacket.ports (shape15E j) a) valid
    have hn : 0 < (IntegerPacket.ports (shape15E j) a).half.length := by simp [SkywalkIntegerLayout.half]
    have untick := ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick_physical (IntegerPacket.ports (shape15E j) a) _
      valid hn le_rfl
    have hj := j.isLt
    have inj := OB5.sig_injective (start15E j + a) (by simp only [start15E]; omega)
    have tail := ih (a + 1) (by omega)
    exact ⟨(gatePhysical_append _ _).2 ⟨gatePhysical_rename _ inj _ tick, tail.1⟩,
      (gatePhysical_append _ _).2 ⟨tail.2, gatePhysical_rename _ inj _ untick⟩⟩

theorem ports15E_dom {j : Fin 4} {a q : Nat} (ha : a < 15)
    (hq : q ∈ (IntegerPacket.ports (shape15E j) a).wires) : WindowCovered.domainW (net15E j a q) = true := by
  have hj := j.isLt
  simp only [IntegerPacket.ports, shape15E, smallBits15E, sb15E, start15E, SkywalkIntegerLayout.wires,
    SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh, List.mem_append, List.mem_cons,
    List.mem_range'_1, List.not_mem_nil, or_false] at hq
  rw [WindowCovered.dom_iff]
  unfold net15E OB5.sig start15E
  split
  all_goals
    repeat' first | cases_type And | cases_type Or
    all_goals try simp only [Wire] at *
    all_goals omega

theorem routed15E_cov (j : Fin 4) (a n : Nat) (bound : a + n ≤ 15) :
    WindowCovered.CoveredW (routed15E j a n) ∧ WindowCovered.CoveredW (unrouted15E j a n) := by
  induction n generalizing a with
  | zero => constructor <;> intro q h <;> simp [routed15E, unrouted15E, wires] at h
  | succ n ih =>
    have ha : a < 15 := by omega
    have step := skywalkIntegerTick_wires_subset _ (IntegerPacket.ok (shape15E j) ⟨a, ha⟩)
    have hn : 0 < (IntegerPacket.ports (shape15E j) a).half.length := by simp [SkywalkIntegerLayout.half]
    have ustep := ECDSAAdd.Entrant.W.ReverseCarry.receiverUntick_support (IntegerPacket.ports (shape15E j) a) _
      (IntegerPacket.ok (shape15E j) ⟨a, ha⟩) hn le_rfl
    have sub := ih (a + 1) (by omega)
    have ok (P : Program) (hp : wires P ⊆ (IntegerPacket.ports (shape15E j) a).wires.toFinset) :
        WindowCovered.CoveredW (renameProgram (net15E j a) P) := by
      intro q hq
      rw [renameProgram_support] at hq
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
      exact ports15E_dom ha (List.mem_toFinset.mp (hp hx))
    exact ⟨WindowCovered.appW (ok _ step.1) sub.1, WindowCovered.appW sub.2 (ok _ ustep)⟩

theorem pull_routed15E (j : Fin 4) (i n : Nat) (bound : i + n ≤ 15) (m : List Bool) (s : State) :
    pullState (windowNet15E j) (run (routed15E j i n) m s) =
      run (IntegerPacket.seq (shape15E j) i n) m (pullState (windowNet15E j) s) := by
  rw [(fixed_route15E j i n bound).1, run_rename _ (net15E_injective j)]

theorem route15E_frame (j : Fin 4) (i n : Nat) (bound : i + n ≤ 15) (z : SkywalkRails.State)
    (odd : (z.a + z.b) % 2 = 1) :
    Triple (onRails15E j i z) (routed15E j i n) (onRails15E j (i + n) (SkywalkTrace.next^[n] z)) := by
  intro s m hready
  have h := IntegerPacket.semantic (shape15E j) i n bound z odd (pullState (windowNet15E j) s) m hready
  rw [← pull_routed15E j i n bound m s] at h
  exact h

theorem route15E_records (j : Fin 4) (i n : Nat) (bound : i + n ≤ 15) (z : SkywalkRails.State)
    (odd : (z.a + z.b) % 2 = 1) (s : State) (m : List Bool) (h : onRails15E j i z s.basis) :
    readCells (shape15E j) i n (mappedBasis15E j (run (routed15E j i n) m s).basis) = SkywalkTrace.trace n z ∧
    ∀ d < i, cell (shape15E j) d (mappedBasis15E j (run (routed15E j i n) m s).basis) =
      cell (shape15E j) d (mappedBasis15E j s.basis) := by
  have hh := IntegerPacket.records (shape15E j) i n bound z odd (pullState (windowNet15E j) s) m h
  rw [← pull_routed15E j i n bound m s] at hh
  exact hh

theorem route15E_undo (j : Fin 4) (i n : Nat) (bound : i + n ≤ 15) (z : SkywalkRails.State)
    (odd : (z.a + z.b) % 2 = 1) :
    Restores (onRails15E j i z) (routed15E j i n) (unrouted15E j i n) := by
  intro s m t hready
  have forward := pull_routed15E j i n bound m s
  let actual := run (routed15E j i n) m s
  have bk : pullState (windowNet15E j) (run (unrouted15E j i n) t actual) =
      run (IntegerPacket.backR (shape15E j) i n) t (pullState (windowNet15E j) actual) := by
    rw [(fixed_route15E j i n bound).2, run_rename _ (net15E_injective j)]
  have fin := IntegerPacket.roundtripR (shape15E j) i n bound z odd (pullState (windowNet15E j) s) m t hready
  change pullState (windowNet15E j) actual = _ at forward
  rw [forward, fin] at bk
  apply congrArg₂ State.mk (congrArg State.phase bk)
  funext q
  have h := congrArg (fun x : State => x.basis (windowNet15E j q)) bk
  change (run (unrouted15E j i n) t actual).basis (windowNet15E j (windowNet15E j q)) =
    s.basis (windowNet15E j (windowNet15E j q)) at h
  rwa [net15E_invol j q] at h


