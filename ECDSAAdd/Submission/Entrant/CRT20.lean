private theorem farUClose20_run (j : Fin 10) (s : State) (m : List Bool)
    (h57 : s.basis 1557 = HighBankControl.parity s.basis (swaps20G (start20 j)))
    (h58 : s.basis 1558 = ((s.basis (e0P20 (start20 j) + 3) && s.basis 1557) ^^ s.basis (e0P20 (start20 j) + 4))) :
    let u := run (farUClose20 j) m s
    u.phase = s.phase ∧ u.basis 1557 = false ∧ u.basis 1558 = false ∧
    ∀ q, q ≠ 1557 → q ≠ 1558 → u.basis q = s.basis q := by
  obtain ⟨n57, n58, nf, ns, ne5758, nef57, nef58, nes57, nes58, nefs⟩ := farU20_layout j
  dsimp only
  unfold farUClose20
  rw [run_append, run_take]
  have hmid : run [.CX (e0P20 (start20 j) + 4) 1558, .measureX 1558 [] [.CZ (e0P20 (start20 j) + 3) 1557]] m s =
      ⟨s.phase, writeBit s.basis 1558 false⟩ := by
