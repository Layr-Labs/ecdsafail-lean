            .cx (a0P20 s - 1 + 0) (e0P20 s + 6)] ++ headC1_20 s))))))) := leaveBefore20_split4 s
  have h1 := h
  rw [hsp] at h1
  simp only [allW_append_iff] at h1
  have hz : P (b + 1584) := h1.1 (.cx (s + b + 57) (b + 1584)) (by simp [firstRows20, fix0P20]) _ (by simp [Gate.wires])
  have hc := h1.2.1 (.ccx (s + 35) (b + 806) (s + b + 56)) (by simp [cell21_20])
  have hs35 : P (s + 35) := hc (s + 35) (by simp [Gate.wires])
  have hb807 : P (b + 806) := hc (b + 806) (by simp [Gate.wires])
  have ha57 : P (s + b + 56) := hc (s + b + 56) (by simp [Gate.wires])
  have hshort : AllW P (shortCell20 s b) := by
    intro g hg q hq; simp only [shortCell20, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq <;>
      rcases hq with rfl | rfl | rfl <;> assumption
  have hpop : AllW P [.pop (s + 35) (b + 807) (s + b + 57)] := by
    intro g hg q hq; simp only [List.mem_singleton] at hg; subst hg
    exact h1.2.2.2.1 (.ccx (s + 35) (b + 807) (s + b + 57)) List.mem_cons_self q hq
  have hflag : AllW P [.cx (b + 1583) 1559] := by
    intro g hg q hq; simp only [List.mem_singleton] at hg; subst hg
    exact h1.2.2.2.2.2.1 (.make (b + 1582) (b + 1583) 1559) List.mem_cons_self q (by simp [Gate.wires] at hq ⊢; tauto)
  have hrow0 : AllW P [.make (tagsP20.getD 0 0) (a0P20 s - 1 + 0) (e0P20 s + 6), .cx (e0P20 s + 6) (a0P20 s - 1 + 0)] := by
    have hr := h1.2.2.2.2.2.2.2.1 (.ccx (tagsP20.getD 0 0) (e0P20 s + 6) (a0P20 s - 1 + 0)) (by simp)
    intro g hg q hq; simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl <;> simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq <;>
      rcases hq with rfl | rfl | rfl <;> exact hr _ (by simp [Gate.wires])
  have hg20 := geom20_facts j
  have hwp2 : 2 ≤ wpP20 s := by dsimp only [s]; omega
  have hc1 := h1.2.2.2.2.2.2.2.2
  rw [headC1_20_split_core s, allW_append_iff] at hc1
  have hcore : AllW P (leaveAdjustCore20Short s) := fun g hg =>
    hc1.2 g (leaveAdjustCore20Short_mem s hwp2 g hg)
  unfold beforeRow20 beforeRow20Pre; dsimp only
  simp only [allW_append_iff]
  exact ⟨⟨⟨⟨⟨⟨⟨⟨⟨h1.1, hshort⟩, h1.2.2.1⟩, hpop⟩, h1.2.2.2.2.1⟩, hflag⟩, h1.2.2.2.2.2.2.1⟩, hrow0⟩, hc1.1⟩, hcore⟩

theorem afterRow20_allW {P : Wire → Prop} (j : Fin 10) (h : AllW P (leaveAfter20 (start20 j)))
    (h7 : P (e0P20 (start20 j) + 7)) :
    AllW P (afterRow20 (start20 j)) := by
  have hL : lowsP20 (start20 j) ≤ 21 := by
    have : ∀ k : Fin 10, lowsP20 (start20 k) ≤ 21 := by decide
    exact this j
  let s := start20 j; let top := a0P20 s + lowsP20 s - 2
  have h1 := h
  rw [leaveAfter20_split4_red s hL] at h1
  simp only [allW_append_iff] at h1
  have hd1 := h1.2.2.1
  rw [tailD1_20_splitSel s, allW_append_iff, allW_append_iff] at hd1
  have hsel : AllW P (selRecvOps20 s) := by
    intro g hg q hq
    have inc := List.all_eq_true.mp (List.all_eq_true.mp (selRecvOps20_wires_covered j) g hg) q hq
    rcases Bool.or_eq_true_iff.mp inc with he | hm
    · rw [of_decide_eq_true he]; exact h7
    · obtain ⟨k, hk, hw⟩ := List.mem_flatMap.mp (List.contains_iff_mem.mp hm)
      exact h1.2.2.1 k hk q hw
  have hd1s : AllW P (tailD1_20Sel s) := by
    unfold tailD1_20Sel; simp only [allW_append_iff]; exact ⟨hd1.1, hsel, hd1.2.2⟩
  have hfl : AllW P [.cx (e0P20 s + 4) 1559] := by
    intro g hg q hq; simp only [List.mem_singleton] at hg; subst hg
    exact h1.2.2.2.1 (.pop (e0P20 s + 3) (e0P20 s + 4) 1559) List.mem_cons_self q (by simp [Gate.wires] at hq ⊢; tauto)
  have htop : AllW P [.cx top 1559] := by
    intro g hg q hq; simp only [List.mem_singleton] at hg; subst hg
    exact h1.2.2.2.2.2.1 (.make 1558 top 1559) List.mem_cons_self q (by simp [Gate.wires] at hq ⊢; tauto)
  change AllW P (tailD0_20 s ++ tailD1_20Sel s ++ [.cx (e0P20 s + 4) 1559] ++ tailE0_20 s ++
    [.cx top 1559] ++ chainMid20 s ++ [.cx top 1559] ++ tailE1_20 s)
  simp only [allW_append_iff]
  exact ⟨⟨⟨⟨⟨⟨⟨h1.1, hd1s⟩, hfl⟩, h1.2.2.2.2.1⟩, htop⟩, h1.2.2.2.2.2.2.1⟩, htop⟩, h1.2.2.2.2.2.2.2.2⟩

theorem leave20Red_ok (j : Fin 10) :
    Proper (beforeRow20 (start20 j)) ∧ AllW (fun q => WindowCovered.domainW q = true) (beforeRow20 (start20 j)) ∧
    Proper (afterRow20 (start20 j)) ∧ AllW (fun q => WindowCovered.domainW q = true) (afterRow20 (start20 j)) := by
  have hb := leaveBefore20_ok j
  have ha := leaveAfter20_ok j
  obtain ⟨hps, hp1, hp2, hp3, hp4, hp5, hp6, hpsel⟩ := red20_patches_proper j
  have hL : lowsP20 (start20 j) ≤ 21 := by
    have : ∀ k : Fin 10, lowsP20 (start20 k) ≤ 21 := by decide
    exact this j
  have hbp : Proper (beforeRow20 (start20 j)) := by
    have hg20 := geom20_facts j
    have h0 := hb.1; rw [leaveBefore20_split4 (start20 j), headC1_20_split_core (start20 j)] at h0
    have h0' := List.all_eq_true.mpr h0
    simp only [List.all_append, Bool.and_eq_true] at h0'
    have hcore_p : (leaveAdjustCore20Short (start20 j)).all proper = true :=
      List.all_eq_true.mpr fun g hg => List.all_eq_true.mp h0'.2.2.2.2.2.2.2.2.2 g
        (leaveAdjustCore20Short_mem (start20 j) (by omega) g hg)
    apply List.all_eq_true.mp
    simp only [beforeRow20, beforeRow20Pre, List.all_append, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true]
    exact ⟨⟨⟨⟨⟨⟨⟨⟨⟨h0'.1, hps⟩, h0'.2.2.1⟩, hp1⟩, h0'.2.2.2.2.1⟩, hp2⟩,
      h0'.2.2.2.2.2.2.1⟩, ⟨hp3, hp4⟩⟩, h0'.2.2.2.2.2.2.2.2.1⟩, hcore_p⟩
  have hap : Proper (afterRow20 (start20 j)) := by
    have h0 := ha.1; rw [leaveAfter20_split4_red (start20 j) hL, tailD1_20_splitSel (start20 j)] at h0
    have h0' := List.all_eq_true.mpr h0
    simp only [List.all_append, Bool.and_eq_true] at h0'
    apply List.all_eq_true.mp
    simp only [afterRow20, tailD1_20Sel, List.all_append, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true]
    exact ⟨⟨⟨⟨⟨⟨⟨h0'.1, ⟨h0'.2.2.1.1, hpsel, h0'.2.2.1.2.2⟩⟩, hp5⟩, h0'.2.2.2.2.1⟩, hp6⟩, h0'.2.2.2.2.2.2.1⟩, hp6⟩,
      h0'.2.2.2.2.2.2.2.2⟩
  have h7dom : WindowCovered.domainW (e0P20 (start20 j) + 7) = true := by
    have : ∀ k : Fin 10, WindowCovered.domainW (e0P20 (start20 k) + 7) = true := by decide
    exact this j
  exact ⟨hbp, beforeRow20_allW j hb.2, hap, afterRow20_allW j ha.2 h7dom⟩

