    ∀ g ∈ leaveAdjust20Short s, g ∈ leaveAdjust20 s := by
  intro g hg
  simp only [leaveAdjust20Short, leaveAdjust20, List.mem_append] at hg ⊢
  rcases hg with h1 | h2
  · exact Or.inl h1
  · exact Or.inr (leaveAdjustCore20Short_mem s hw g h2)

