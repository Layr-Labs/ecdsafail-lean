theorem native_carry20 (j : Fin 10) (z : SkywalkRails.State) (s : State)
    (ready : onRails20 j 20 z s.basis)
    (top : s.basis (e0P20 (start20 j) - 1) = false)
    (top2 : s.basis (e0P20 (start20 j) - 2) = false) :
    ∀ q : Wire, 1556 ≤ q → q < e0P20 (start20 j) → s.basis q = false := by
  have hg := geom20_facts j; dsimp only at hg
  have hsum : e0P20 (start20 j) + start20 j ≤ 2045 := by
    have : ∀ k : Fin 10, e0P20 (start20 k) + start20 k ≤ 2045 := by decide +kernel
    exact this j
  intro q lo hi
  by_cases htop : (q : Nat) + 2 < e0P20 (start20 j)
  · have hmem : q ∈ (IntegerPacket.ports (shape20 j) 20).carry := by
      simp only [IntegerPacket.ports, shape20, smallBits20, List.mem_range'_1, e0P20, Wire] at htop lo ⊢
      omega
    have hfix : windowNet20 j q = q := by
      show OB5.sig (start20 j + 19) q = q
      exact sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)
    have hzero := (regValue_zero _ _).mp ready.2.2.2.1 q hmem
    change s.basis (windowNet20 j q) = false at hzero
    rwa [hfix] at hzero
  · by_cases h1 : (q : Nat) = e0P20 (start20 j) - 1
    · have eq : q = e0P20 (start20 j) - 1 := by unfold Wire at *; omega
      rw [eq]; exact top
    · have eq : q = e0P20 (start20 j) - 2 := by unfold Wire at *; omega
      rw [eq]; exact top2

theorem saved20_eq_ys20 : ∀ j : Fin 10, EnterJ20.saved j = ys20 j := by decide +kernel

theorem assemble20 (j : Fin 10) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (numbers : Numeric20 j z)
    (rails : onRails20 j 20 (SkywalkTrace.next^[20] (SkywalkRails.encode g0 s0
      (TrueMiddle20.r j z).u (TrueMiddle20.r j z).v)) s.basis)
    (record : readCells (shape20 j) 0 20 (mappedBasis20 j s.basis) =
      SkywalkTrace.trace 20 (SkywalkRails.encode g0 s0 z.u z.v))
    (saved : regValue (ys20 j) s.basis =
        (if Shadow.far (sbP20 (start20 j)) 20 z then Shadow.high (sbP20 (start20 j)) 20 z else 0) ∧
      s.basis (e0P20 (start20 j) + 5) = false ∧
      s.basis (e0P20 (start20 j) + 3) = decide (Shadow.far (sbP20 (start20 j)) 20 z) ∧
      s.basis (e0P20 (start20 j) + 4) = decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
    (flag6 : s.basis (e0P20 (start20 j) + 6) = false)
    (flag7 : s.basis (e0P20 (start20 j) + 7) = false)
    (tail : ∀ q ∈ tailTemps20 j, s.basis q = false)
    (top : s.basis (e0P20 (start20 j) - 1) = false)
    (top2 : s.basis (e0P20 (start20 j) - 2) = false)
    (parked : s.basis (b0P20 (start20 j) + 21) = false) :
    Inputs20 j s z g0 s0 := by
  have hg := geom20_facts j; dsimp only at hg
  have hready : onRails20 j 20 (SkywalkRails.encode (flags20 z g0 s0).1 (flags20 z g0 s0).2
      (step^[20] (TrueMiddle20.r j z)).u (step^[20] (TrueMiddle20.r j z)).v) s.basis :=
    (WideReference20.same_shadow20 (sbP20 (start20 j)) z numbers.small.1 numbers.odd g0 s0).1 ▸ rails
  have cl := native_carry20 j _ s hready top top2
  have htail : ∀ q : Nat, e0P20 (start20 j) + 10 ≤ q → q < e0P20 (start20 j) + 10 + (wpP20 (start20 j) - 1 - (e0P20 (start20 j) - 1603)) →
      s.basis q = false := fun q h1 h2 => tail q (by simp only [tailTemps20, List.mem_range'_1]; omega)
  refine ⟨numbers, hready, saved.2.1, ?_, ?_, ?_, ?_, ?_, saved.1, ?_, saved.2.2.1, ?_, record, top, top2, parked⟩
  · intro q hq
    simp only [fullC20, List.mem_cons, List.mem_map, List.mem_range] at hq
    rcases hq with rfl | rfl | rfl | ⟨i, hi, rfl⟩ <;> exact cl _ (by unfold Wire; omega) (by unfold Wire; omega)
  · intro p hp
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hi
    exact cl _ (by dsimp only; unfold Wire; omega) (by dsimp only; unfold Wire; omega)
  · intro q hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    rcases pool20_cases j i with ⟨h1, ep⟩ | ⟨h1, ep⟩
    · rw [ep]; exact cl _ (by unfold Wire at *; omega) (by unfold Wire at *; omega)
    · rw [ep]; exact htail _ (by omega) (by omega)
  · intro q h1 h2; exact cl q (by unfold Wire; omega) (by unfold Wire; omega)
  · intro i h1 h2
    have hbc := bank20_cases j h2
    rcases hbc with ⟨_, _⟩ | ⟨_, _, _, _, _⟩ | ⟨_, eb, hhi, _⟩
    · omega
    · omega
    · rw [eb]; exact cl _ (by unfold Wire at *; omega) (by unfold Wire at *; omega)
  · intro q hq
    simp only [watched20, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_range'_1] at hq
    rcases hq with (rfl | rfl) | ⟨h1, h2⟩
    · exact flag6
    · exact flag7
    · exact cl q (by unfold Wire; omega) (by unfold Wire; omega)
  · rw [saved.2.2.2]; by_cases hf : Shadow.far (sbP20 (start20 j)) 20 z <;> simp [hf]

