section
namespace ECDSAAdd.Entrant.MarginK1
set_option exponentiation.threshold 1024

open SkywalkNat IntegerHigh

/-! ## Section 1: Tight Guard & High-Rail Relation (`guard1`, `Rel1`) -/

def guard1 : Nat → Nat → Nat
  | 0, _ => 1
  | r + 1, s => 2 * guard1 r s + s

theorem guard1_zero (s : Nat) : guard1 0 s = 1 := rfl
theorem guard1_succ (r s : Nat) : guard1 (r + 1) s = 2 * guard1 r s + s := rfl

theorem guard1_pos (r s : Nat) : 0 < guard1 r s := by
  induction r with
  | zero => simp [guard1]
  | succ r ih => rw [guard1_succ]; omega

theorem guard1_formula (r s : Nat) : guard1 r s + s = 2 ^ r * (s + 1) := by
  induction r with
  | zero => simp [guard1]; omega
  | succ r ih => rw [guard1_succ, pow_succ]; nlinarith

theorem guard1_succ_gt (r s : Nat) : s < guard1 (r + 1) s := by
  have h := guard1_pos r s
  rw [guard1_succ]; omega

theorem guard1_mono (r : Nat) {a b : Nat} (h : a ≤ b) : guard1 r a ≤ guard1 r b := by
  induction r with
  | zero => simp [guard1]
  | succ r ih => simp only [guard1_succ]; omega

/-- Tight high-rail coupling: `B ≥ guard1 r s` and `s < D` (invariant across all steps). -/
inductive Rel1 (r : Nat) : SkywalkNat.State → SkywalkNat.State → Prop where
  | left (B s D : Nat) (h : guard1 r s ≤ B) (hD : s < D) :
      Rel1 r ⟨B + 2 ^ r * D, s⟩ ⟨B, s⟩
  | right (B s D : Nat) (h : guard1 r s ≤ B) (hD : s < D) :
      Rel1 r ⟨s, B + 2 ^ r * D⟩ ⟨s, B⟩

theorem long_u1 (r B s D : Nat) (h : guard1 r s ≤ B) :
    step^[r] ⟨B + 2 ^ r * D, s⟩ =
      let t := step^[r] ⟨B, s⟩
      ⟨t.u + D, t.v⟩ := by
  induction r generalizing B with
  | zero => simp
  | succ r ih =>
    have hh : 2 * guard1 r s + s ≤ B := by simpa [guard1_succ] using h
    have hp := guard1_pos r s
    have large : s ≤ B := by omega
    have nz : B ≠ 0 := by omega
    let d := 2 ^ r * D
    have fact : 2 ^ (r + 1) * D = 2 * d := by simp [d, pow_succ]; ring
    have parity : (B + 2 * d) % 2 = B % 2 := by omega
    simp only [Function.iterate_succ_apply, fact]
    by_cases isEven : B % 2 = 0
    · have base : step ⟨B, s⟩ = ⟨B / 2, s⟩ := by simp [step, nz, isEven]
      have big : step ⟨B + 2 * d, s⟩ = ⟨B / 2 + d, s⟩ := by
        have z : B + 2 * d ≠ 0 := by omega
        simp only [step, if_neg z, parity, if_pos isEven]
        congr 1; omega
      rw [base, big]
      exact ih _ (by omega)
    · have base : step ⟨B, s⟩ = ⟨(B - s) / 2, s⟩ := by simp [step, nz, isEven, large]
      have big : step ⟨B + 2 * d, s⟩ = ⟨(B - s) / 2 + d, s⟩ := by
        have z : B + 2 * d ≠ 0 := by omega
        have l : s ≤ B + 2 * d := by omega
        simp only [step, if_neg z, parity, if_neg isEven, if_pos l]
        congr 1; omega
      rw [base, big]
      exact ih _ (by omega)

private theorem evenStep1 (s B : Nat) (e : s % 2 = 0) : step ⟨s, B⟩ = ⟨s / 2, B⟩ := by
  by_cases z : s = 0
  · subst s; rfl
  · simp [step, z, e]

theorem long_v1 (k B s D : Nat) (ready : guard1 k s ≤ B) :
    let t := step^[k] ⟨s, B⟩
    let shift := wait k s
    let gap := 2 ^ shift * D
    step^[k] ⟨s, B + 2 ^ k * D⟩ =
      if shift = k then ⟨t.u, t.v + gap⟩ else ⟨t.u + gap, t.v⟩ := by
  induction k generalizing s B D with
  | zero => simp [wait]
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    dsimp only
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply]
    by_cases e : s % 2 = 0
    · rw [evenStep1 _ _ e, evenStep1 _ _ e]
      have hb := guard1_mono k (a := s / 2) (b := s) (by omega)
      have h := ih B (s / 2) (2 * D) (by omega)
      simp only [wait, e, if_true, Nat.succ.injEq, pow_succ] at *
      simpa only [Nat.mul_assoc] using h
    · have hb : s < B := by omega
      have big : s < B + 2 ^ (k + 1) * D := by omega
      have nz : s ≠ 0 := by omega
      simp only [step, if_neg nz, if_neg e, if_neg (Nat.not_le.mpr hb),
        if_neg (Nat.not_le.mpr big), wait, Nat.zero_ne_add_one, if_false, pow_zero, one_mul]
      have pow : 2 ^ (k + 1) * D = 2 * (2 ^ k * D) := by rw [pow_succ]; ring
      rw [pow, show (B + 2 * (2 ^ k * D) - s) / 2 = (B - s) / 2 + 2 ^ k * D by omega]
      exact long_u1 k ((B - s) / 2) s D (by omega)

theorem right_sum1 (k B s D : Nat) (ready : guard1 k s ≤ B) :
    let small := step^[k] ⟨s, B⟩
    let full := step^[k] ⟨s, B + 2 ^ k * D⟩
    full.u + full.v = small.u + small.v + 2 ^ (wait k s) * D := by
  dsimp only
  rw [long_v1 _ _ _ _ ready]
  split <;> dsimp only <;> omega

theorem advance1 {r : Nat} {z t : SkywalkNat.State} (h : Rel1 (r + 1) z t) :
    letter z = letter t ∧ Rel1 r (step z) (step t) := by
  cases h with
  | left B s D ready hD =>
    have hp := guard1_pos r s
    have hh : 2 * guard1 r s + s ≤ B := by simpa [guard1_succ] using ready
    let d := 2 ^ r * D
    have pow : 2 ^ (r + 1) * D = 2 * d := by simp [d, pow_succ]; ring
    rw [pow]
    have eqp : (B + 2 * d) % 2 = B % 2 := by omega
    have nb : B ≠ 0 := by omega
    have nn : B + 2 * d ≠ 0 := by omega
    constructor
    · simp [letter, eqp, show ¬ B + 2 * d < s by omega, show ¬ B < s by omega]
    · by_cases e : B % 2 = 0
      · simp only [step, if_neg nn, if_neg nb, eqp, if_pos e]
        rw [show (B + 2 * d) / 2 = B / 2 + d by omega]
        exact .left _ _ D (by omega) hD
      · simp only [step, if_neg nn, if_neg nb, eqp, if_neg e,
          if_pos (show s ≤ B + 2 * d by omega), if_pos (show s ≤ B by omega)]
        rw [show (B + 2 * d - s) / 2 = (B - s) / 2 + d by omega]
        exact .left _ _ D (by omega) hD
  | right B s D ready hD =>
    have hp := guard1_pos r s
    have hh : 2 * guard1 r s + s ≤ B := by simpa [guard1_succ] using ready
    let d := 2 ^ r * D
    have pow : 2 ^ (r + 1) * D = 2 * d := by simp [d, pow_succ]; ring
    rw [pow]
    constructor
    · simp [letter, show s < B + 2 * d by omega, show s < B by omega]
    · by_cases zero : s = 0
      · subst s
        simp only [step]
        simpa [d, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using
          (Rel1.right B 0 (2 * D) (by omega) (by omega) : Rel1 r _ _)
      · by_cases e : s % 2 = 0
        · simp only [step, if_neg zero, if_pos e]
          have bound := guard1_mono r (a := s / 2) (b := s) (by omega)
          simpa [d, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using
            (Rel1.right B (s / 2) (2 * D) (by omega) (by omega) : Rel1 r _ _)
        · simp only [step, if_neg zero, if_neg e,
            if_neg (show ¬ B + 2 * d ≤ s by omega), if_neg (show ¬ B ≤ s by omega)]
          rw [show (B + 2 * d - s) / 2 = (B - s) / 2 + d by omega]
          exact .left _ _ D (by omega) hD

theorem letters_eq1 {k : Nat} {z t : SkywalkNat.State} (h : Rel1 k z t) :
    letters k z = letters k t := by
  induction k generalizing z t with
  | zero => rfl
  | succ k ih =>
    obtain ⟨hl, hr⟩ := advance1 h
    simp only [letters, hl, ih hr]

theorem different1 {r : Nat} {z t : SkywalkNat.State} (h : Rel1 (r + 1) z t) :
    z.u ≠ z.v ∧ t.u ≠ t.v := by
  cases h with
  | left B s D ready _ =>
    have := guard1_succ_gt r s
    change B + 2 ^ (r + 1) * D ≠ s ∧ B ≠ s
    omega
  | right B s D ready _ =>
    have := guard1_succ_gt r s
    change s ≠ B + 2 ^ (r + 1) * D ∧ s ≠ B
    omega

theorem terminalRel1 {k : Nat} {z r : SkywalkNat.State} (h : Rel1 k z r) :
    Rel1 0 (step^[k] z) (step^[k] r) := by
  induction k generalizing z r with
  | zero => exact h
  | succ k ih =>
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply]
    exact ih (advance1 h).2

private theorem letters_length1 (k : Nat) (z : SkywalkNat.State) : (letters k z).length = k := by
  induction k generalizing z with
  | zero => rfl
  | succ k ih => simp [letters, ih]

theorem left_product1 (k B s : Nat) (ready : guard1 k s ≤ B) (odd : s % 2 = 1) :
    let out := step^[k] ⟨B, s⟩
    out.v = s ∧ 2 ^ k * out.u + mask (letters k ⟨B, s⟩) * s = B := by
  induction k generalizing B with
  | zero => simp [mask, letters]
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    have nz : B ≠ 0 := by omega
    have le : s ≤ B := by omega
    dsimp only
    rw [Function.iterate_succ_apply]
    by_cases e : B % 2 = 0
    · have st : step ⟨B, s⟩ = ⟨B / 2, s⟩ := by simp [step, nz, e]
      obtain ⟨v, prod⟩ := ih (B / 2) (by omega)
      simp only [letters, mask, letter, e, if_true, st, Nat.zero_add, pow_succ]
      exact ⟨v, by nlinarith only [prod, show 2 * (B / 2) = B by omega]⟩
    · have st : step ⟨B, s⟩ = ⟨(B - s) / 2, s⟩ := by simp [step, nz, e, le]
      obtain ⟨v, prod⟩ := ih ((B - s) / 2) (by omega)
      simp only [letters, mask, letter, e, if_false, not_lt.mpr le, Nat.one_ne_zero, st, pow_succ]
      exact ⟨v, by nlinarith only [prod, show 2 * ((B - s) / 2) + s = B by omega]⟩

theorem right_product1 (k B s : Nat) (ready : guard1 k s ≤ B) (odd : B % 2 = 1) :
    let out := step^[k] ⟨s, B⟩
    let t := wait k s
    let small := remainder k s
    2 ^ k * (out.u + out.v) + (mask (letters k ⟨s, B⟩) + 2 ^ (t + t)) * small =
      2 ^ t * (B + s) + 2 ^ k * small := by
  induction k generalizing s B with
  | zero => simp [wait, remainder, letters, mask, Nat.add_comm]
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    dsimp only
    rw [Function.iterate_succ_apply]
    by_cases e : s % 2 = 0
    · have st : step ⟨s, B⟩ = ⟨s / 2, B⟩ := evenStep1 s B e
      have gm := guard1_mono k (a := s / 2) (b := s) (by omega)
      have prev := ih B (s / 2) (by omega) odd
      have tw := waited k (s / 2)
      simp only [wait, remainder, e, if_true, letters, mask, letter, st, Nat.zero_add,
        show wait k (s / 2) + 1 + (wait k (s / 2) + 1) = (wait k (s / 2) + wait k (s / 2)) + 1 + 1 by omega,
        pow_succ]
      dsimp only at prev
      rw [pow_add] at prev ⊢
      have w : 2 ^ (wait k (s / 2)) * (2 ^ (wait k (s / 2)) * remainder k (s / 2)) =
          2 ^ (wait k (s / 2)) * (s / 2) := congrArg (fun x : Nat => 2 ^ (wait k (s / 2)) * x) tw
      have twice := congrArg (fun x : Nat => 2 ^ (wait k (s / 2)) * x) (show s = 2 * (s / 2) by omega)
      dsimp only at twice
      nlinarith only [prev, w, twice]
    · have lt : s < B := by omega
      have nz : s ≠ 0 := by omega
      have so : s % 2 = 1 := by omega
      have st : step ⟨s, B⟩ = ⟨(B - s) / 2, s⟩ := by simp [step, nz, e, Nat.not_le.mpr lt]
      obtain ⟨v, prod⟩ := left_product1 k ((B - s) / 2) s (by omega) so
      simp only [wait, remainder, letters, mask, letter, e, if_false, lt, if_true, st, v,
        Nat.reduceEqDiff, Nat.zero_add, pow_zero, one_mul, pow_succ]
      nlinarith only [prod, show 2 * ((B - s) / 2) + s = B by omega]

theorem first_exchange1 (k B s : Nat) (ready : guard1 k s ≤ B) :
    (letters k ⟨s, B⟩).idxOf 2 = wait k s := by
  induction k generalizing s with
  | zero => rfl
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    by_cases e : s % 2 = 0
    · have sm := guard1_mono k (a := s / 2) (b := s) (by omega)
      have tail := ih (s / 2) (by omega)
      simpa [letters, letter, wait, e, evenStep1 s B e, List.idxOf_cons] using congrArg Nat.succ tail
    · simp [letters, letter, wait, e, show s < B by omega]

theorem lead_wait1 (k B s : Nat) (ready : guard1 k s ≤ B) :
    lead (oddBits (letters k ⟨s, B⟩)) = wait k s := by
  induction k generalizing s with
  | zero => rfl
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    by_cases e : s % 2 = 0
    · have gm := guard1_mono k (a := s / 2) (b := s) (by omega)
      have tail := ih (s / 2) (by omega)
      simpa [letters, oddBits, letter, wait, e, evenStep1 s B e, lead] using congrArg Nat.succ tail
    · simp [letters, oddBits, letter, wait, e, show s < B by omega, lead]

/-- Universal `[U, 2U)` digit theorem: `S / C ∈ {0, 1, 2}` and off `1`, crossing direction selects `0` vs `2`. -/
theorem digit1 {P Q C U A S J x : Nat}
    (p : 0 < P) (q : 0 < Q) (c : 0 < C) (scale : P * C = Q * U)
    (low : U ≤ A) (high : A < 2 * U) (_maskBound : J < P)
    (short : x < C) (_smallInput : Q * x < U)
    (identity : P * S + (J + Q * Q) * x = Q * A + P * x) :
    (S / C = 0 ∨ S / C = 1 ∨ S / C = 2) ∧
    (S / C ≠ 1 → (if P < J + Q * Q then S / C = 0 else S / C = 2)) := by
  have low' := Nat.mul_le_mul_left Q low
  have high' := Nat.mul_lt_mul_of_pos_left high q
  have room := Nat.mul_lt_mul_of_pos_left short p
  have top : S < 3 * C := by
    by_contra! bad
    have bad' := Nat.mul_le_mul_left P bad
    nlinarith only [scale, high', room, identity, bad', Nat.zero_le ((J + Q * Q) * x)]
  have top' : S / C < 3 := (Nat.div_lt_iff_lt_mul c).mpr top
  have bot' : 0 ≤ S / C := Nat.zero_le _
  refine ⟨by omega, fun crossed => ?_⟩
  split
  next negCase =>
    have neg := Nat.mul_le_mul_right x (Nat.le_of_lt negCase)
    have cap : S < 2 * C := by
      by_contra! bad
      have bad' := Nat.mul_le_mul_left P bad
      nlinarith only [identity, neg, scale, high', bad']
    have := (Nat.div_lt_iff_lt_mul c).mpr cap
    omega
  next posCase =>
    have pos := Nat.mul_le_mul_right x (Nat.le_of_not_gt posCase)
    have floor : 1 * C ≤ S := by
      by_contra! bad
      have bad' := Nat.mul_lt_mul_of_pos_left bad p
      nlinarith only [identity, pos, scale, low', bad']
    have := (Nat.le_div_iff_mul_le c).mpr floor
    omega

theorem right_digit1 (k B s V : Nat) (ready : guard1 k s ≤ B) (odd : B % 2 = 1)
    (small : s < V) (low : 2 ^ k * V ≤ B + s) (high : B + s < 2 * (2 ^ k * V)) :
    let z : SkywalkNat.State := ⟨s, B⟩
    let o := step^[k] z
    let t := wait k s
    let d := (o.u + o.v) / (2 ^ t * V)
    (d = 0 ∨ d = 1 ∨ d = 2) ∧ (d ≠ 1 → if 2 ^ k < mask (letters k z) + 2 ^ (t + t) then d = 0 else d = 2) := by
  dsimp only
  have p := Nat.two_pow_pos k
  have q := Nat.two_pow_pos (wait k s)
  have c := Nat.mul_pos q (show 0 < V by omega)
  have w := waited k s
  have sx : remainder k s ≤ s := by
    calc remainder k s ≤ 2 ^ (wait k s) * remainder k s := Nat.le_mul_of_pos_left _ q
      _ = s := w
  have hV := Nat.le_mul_of_pos_left V p
  have hvq := Nat.le_mul_of_pos_left V q
  have h := right_product1 k B s ready odd
  dsimp only at h
  rw [pow_add] at h ⊢
  exact digit1 p q c (by ring) low high (by simpa [letters_length1] using mask_lt (letters k ⟨s, B⟩))
    (by omega) (by omega) h

theorem left_digit1 (k B s V : Nat) (ready : guard1 k s ≤ B) (odd : s % 2 = 1)
    (small : s < V) (low : 2 ^ k * V ≤ B + s) (high : B + s < 2 * (2 ^ k * V)) :
    let out := step^[k] ⟨B, s⟩
    (out.u + out.v) / V = 1 ∨ (out.u + out.v) / V = 2 := by
  dsimp only
  obtain ⟨v, prod⟩ := left_product1 k B s ready odd
  have mb : mask (letters k ⟨B, s⟩) < 2 ^ k := by simpa [letters_length1] using mask_lt (letters k ⟨B, s⟩)
  have maskCost := Nat.mul_le_mul_right s (show mask (letters k ⟨B, s⟩) + 1 ≤ 2 ^ k by omega)
  have pos := Nat.two_pow_pos k
  have vpos : 0 < V := by omega
  have cap := Nat.mul_lt_mul_of_pos_left small pos
  rw [v]
  have lo : 1 * V ≤ (step^[k] ⟨B, s⟩).u + s := by
    by_contra! h
    have hh := Nat.mul_lt_mul_of_pos_left h pos
    nlinarith only [hh, prod, low, maskCost]
  have hi : (step^[k] ⟨B, s⟩).u + s < 3 * V := by
    by_contra! h
    have hh := Nat.mul_le_mul_left (2 ^ k) h
    nlinarith only [hh, prod, high, cap, Nat.zero_le (mask (letters k ⟨B, s⟩) * s), Nat.zero_le s]
  have := (Nat.le_div_iff_mul_le vpos).mpr lo
  have := (Nat.div_lt_iff_lt_mul vpos).mpr hi
  omega

theorem corrected_digit1 (k B s V : Nat) (hk : 0 < k) (ready : guard1 k s ≤ B)
    (odd : B % 2 = 1) (small : s < V) (low : 2 ^ k * V ≤ B + s) (high : B + s < 2 * (2 ^ k * V)) :
    let z : SkywalkNat.State := ⟨s, B⟩
    let out := step^[k] z
    let bits := oddBits (letters k z)
    let d := (out.u + out.v) / (2 ^ (wait k s) * V)
    d = if d = 1 then 1 else if IntegerHigh.negative bits then 0 else 2 := by
  dsimp only
  have len (n : Nat) (z : SkywalkNat.State) : (oddBits (letters n z)).length = n := by
    induction n generalizing z with
    | zero => rfl
    | succ n ih => simpa [oddBits, letters] using congrArg Nat.succ (ih (step z))
  have rule := selector (oddBits (letters k ⟨s, B⟩)) (by rwa [len])
  rw [len, mask_bits, lead_wait1 k B s ready] at rule
  obtain ⟨_, cross⟩ := right_digit1 k B s V ready odd small low high
  split
  next h => exact h
  next h =>
    specialize cross h
    split
    next neg => simpa only [if_pos (rule.mp neg)] using cross
    next pos => simpa only [if_neg (fun h => pos (rule.mpr h))] using cross

/-! ## Section 2: Archive Trace Orientation under `Rel1` -/

section ArchiveTrace1
open SkywalkRails StairArchiveRaw StairArchiveTrace

theorem orientation1 {k : Nat} {z t : SkywalkNat.State} (h : Rel1 (k + 1) z t) :
    decide (letter z = 2) = (!decide (z.v < z.u) && !decide (letter z = 0)) ∧
    decide ((SkywalkNat.step z).v < (SkywalkNat.step z).u) = (decide (z.v < z.u) || !decide (letter z = 0)) := by
  cases h with
  | left B s D large hD =>
    have hp := guard1_pos k s
    have lim : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using large
    have hpow : 2 ≤ 2 ^ (k + 1) := by
      rw [pow_succ]; have := Nat.two_pow_pos k; omega
    have hD2 : 2 * (s + 1) ≤ 2 ^ (k + 1) * D := by nlinarith
    generalize big : B + 2 ^ (k + 1) * D = x
    have guard : 3 * s + 2 ≤ x := by omega
    by_cases even : x % 2 = 0
    · simp [letter, SkywalkNat.step, show x ≠ 0 by omega, even, show s < x by omega, show s < x / 2 by omega]
    · simp [letter, SkywalkNat.step, show x ≠ 0 by omega, even, show s < x by omega,
        show ¬ x < s by omega, show s ≤ x by omega, show s < (x - s) / 2 by omega]
  | right B s D large hD =>
    have hp := guard1_pos k s
    have lim : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using large
    have hpow : 2 ≤ 2 ^ (k + 1) := by
      rw [pow_succ]; have := Nat.two_pow_pos k; omega
    have hD2 : 2 * (s + 1) ≤ 2 ^ (k + 1) * D := by nlinarith
    generalize big : B + 2 ^ (k + 1) * D = x
    have guard : 3 * s + 2 ≤ x := by omega
    by_cases zero : s = 0
    · subst s; simp [letter, SkywalkNat.step]
    · by_cases even : s % 2 = 0
      · simp [letter, SkywalkNat.step, zero, even, show ¬ x < s by omega, show ¬ x < s / 2 by omega]
      · simp [letter, SkywalkNat.step, zero, even, show ¬ x < s by omega, show s < x by omega,
          show ¬ x ≤ s by omega, show s < (x - s) / 2 by omega]

theorem signed1 {k : Nat} {z t : SkywalkNat.State} (h : Rel1 k z t)
    (g sign : Bool) (pos : 0 < z.v) (odd : z.v % 2 = 1) :
    chain (decide (z.v < z.u)) (SkywalkTrace.trace k (encode g sign z.u z.v)) := by
  induction k generalizing z t g sign with
  | zero => trivial
  | succ n ih =>
    obtain ⟨neq, _⟩ := different1 h
    obtain ⟨_, tail⟩ := advance1 h
    obtain ⟨zp, zo⟩ := step_v_odd_pos z pos odd
    obtain ⟨record, orient⟩ := orientation1 h
    rw [SkywalkTrace.trace, IntegerHigh.recorded z g sign pos odd neq]
    simp only [chain, SkywalkTrace.next, step_reencode g sign z pos odd]
    exact ⟨record, orient ▸ ih tail _ _ zp zo⟩

theorem far_suffix1 (pre : Nat) {z t : SkywalkNat.State} (h : Rel1 (pre + 10) z t)
    (g sign cross : Bool) (pos : 0 < z.v) (odd : z.v % 2 = 1) :
    let all := SkywalkTrace.trace (pre + 10) (encode g sign z.u z.v)
    let xs := all.drop pre
    let u := afterFlags (decide (z.v < z.u)) (all.take pre)
    ∃ row < 63145, ∀ q < 23, (rawCol q).testBit row = rawBit (read xs) true u cross q := by
  let all := SkywalkTrace.trace (pre + 10) (encode g sign z.u z.v)
  have len : (all.drop pre).length = 10 := by
    simp only [all, List.length_drop, SkywalkTrace.trace_length]; omega
  apply list_member _ len
  · simp
  · intro _ i hi
    exact chain_bits _ _ (suffix pre all _ (signed1 h g sign pos odd)) i (by omega)

end ArchiveTrace1

/-! ## Section 3: Universal `Shadow1` (`limb1 b k = 2^(b+k)`, `V = 2^b`) -/

def limb1 (b k : Nat) : Nat := 2 ^ (b + k)
def high1 (b k : Nat) (z : SkywalkNat.State) : Nat := (z.u + z.v) / limb1 b k
def far1 (b k : Nat) (z : SkywalkNat.State) : Prop := 2 ≤ high1 b k z
instance (b k : Nat) (z : SkywalkNat.State) : Decidable (far1 b k z) := inferInstanceAs (Decidable (2 ≤ _))
def gap1 (b k : Nat) (z : SkywalkNat.State) : Nat := (high1 b k z - 1) * limb1 b k

def reduced1 (b k : Nat) (z : SkywalkNat.State) : SkywalkNat.State :=
  if far1 b k z then
    if 2 ^ b ≤ z.u then ⟨z.u - gap1 b k z, z.v⟩ else ⟨z.u, z.v - gap1 b k z⟩
  else z

theorem scale1 (b k : Nat) : limb1 b k = 2 ^ k * 2 ^ b := by
  rw [limb1, Nat.add_comm, pow_add]

theorem guard1_tight (b k s : Nat) (hs : s < 2 ^ b) : guard1 k s + s ≤ limb1 b k := by
  have a : s + 1 ≤ 2 ^ b := by omega
  have mul := Nat.mul_le_mul_left (2 ^ k) a
  rw [guard1_formula, scale1]
  exact mul

theorem represented1 (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b)
    (h : far1 b k z) :
    Rel1 k z (reduced1 b k z) ∧
    limb1 b k ≤ (reduced1 b k z).u + (reduced1 b k z).v ∧
    (reduced1 b k z).u + (reduced1 b k z).v < 2 * limb1 b k := by
  let U := limb1 b k
  let H := high1 b k z
  let R := (z.u + z.v) % U
  have hu : 0 < U := by simp [U, limb1]
  have hr : R < U := Nat.mod_lt _ hu
  have decomp : z.u + z.v = R + U * H := (Nat.mod_add_div _ _).symm
  have hh : 2 ≤ H := h
  have remove : U * H = gap1 b k z + U := by
    change U * H = (H - 1) * U + U
    rw [show (H - 1) * U + U = (H - 1 + 1) * U by ring, show H - 1 + 1 = H by omega, Nat.mul_comm]
  have bound : 2 ^ b ≤ U := by
    dsimp [U, limb1]
    exact Nat.pow_le_pow_right (by decide) (by omega)
  have form : gap1 b k z = 2 ^ k * (2 ^ b * (H - 1)) := by
    change (H - 1) * limb1 b k = _
    rw [scale1]; ring
  have hDge : 2 ^ b ≤ 2 ^ b * (H - 1) := by
    have : 1 ≤ H - 1 := by omega
    exact Nat.le_mul_of_pos_right _ this
  rw [reduced1, if_pos h]
  split
  · rename_i big
    have hv : z.v < 2 ^ b := by omega
    have t := guard1_tight b k z.v hv
    have gu : guard1 k z.v ≤ z.u - gap1 b k z := by omega
    have eq : z.u = (z.u - gap1 b k z) + 2 ^ k * (2 ^ b * (H - 1)) := by omega
    constructor
    · conv_lhs => rw [show z = ⟨(z.u - gap1 b k z) + 2 ^ k * (2 ^ b * (H - 1)), z.v⟩
                           from by cases z; exact congrArg₂ SkywalkNat.State.mk eq rfl]
      exact .left _ _ _ gu (by omega)
    · change U ≤ z.u - gap1 b k z + z.v ∧ z.u - gap1 b k z + z.v < 2 * U
      omega
  · rename_i little
    have hu_lt : z.u < 2 ^ b := by omega
    have t := guard1_tight b k z.u hu_lt
    have gv : guard1 k z.u ≤ z.v - gap1 b k z := by omega
    have eq : z.v = (z.v - gap1 b k z) + 2 ^ k * (2 ^ b * (H - 1)) := by omega
    constructor
    · conv_lhs => rw [show z = ⟨z.u, (z.v - gap1 b k z) + 2 ^ k * (2 ^ b * (H - 1))⟩
                           from by cases z; exact congrArg₂ SkywalkNat.State.mk rfl eq]
      exact .right _ _ _ gv (by omega)
    · change U ≤ z.u + (z.v - gap1 b k z) ∧ z.u + (z.v - gap1 b k z) < 2 * U
      omega

theorem rail1 (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b) (far : far1 b k z) :
    let r := reduced1 b k z
    let D := 2 ^ b * (high1 b k z - 1)
    (2 ^ b ≤ z.u → r.v = z.v ∧ z.u = r.u + 2 ^ k * D ∧ guard1 k r.v ≤ r.u) ∧
    (z.u < 2 ^ b → r.u = z.u ∧ z.v = r.v + 2 ^ k * D ∧ guard1 k r.u ≤ r.v) := by
  dsimp only
  have hr := (represented1 b k z small far).2.1
  have amount : gap1 b k z = 2 ^ k * (2 ^ b * (high1 b k z - 1)) := by rw [gap1, scale1]; ring
  have base : 2 ^ b ≤ limb1 b k := Nat.pow_le_pow_right (by decide) (by omega)
  constructor
  · intro h
    have sh : z.v < 2 ^ b := by omega
    rw [reduced1, if_pos far, if_pos h] at hr ⊢
    dsimp only at hr ⊢
    exact ⟨rfl, by omega, by have t := guard1_tight b k z.v sh; omega⟩
  · intro h
    rw [reduced1, if_pos far, if_neg (Nat.not_le.mpr h)] at hr ⊢
    dsimp only at hr ⊢
    exact ⟨rfl, by omega, by have t := guard1_tight b k z.u h; omega⟩

theorem actual_residue_limb1 (b k : Nat) (z : SkywalkNat.State) (sg : Bool)
    (small : min z.u z.v < 2 ^ b) :
    let T := reduced1 b k z
    let e := StairPacket.PortalValues.negative sg z.u
    (T.u + T.v) % limb1 b k = (z.u + z.v) % limb1 b k ∧
    (T.u - e.toNat) % limb1 b k = (z.u - e.toNat) % limb1 b k := by
  dsimp only
  have periodic (N d : Nat) (eq : d ≤ N) (mul : limb1 b k ∣ d) : (N - d) % limb1 b k = N % limb1 b k := by
    obtain ⟨j, rfl⟩ := mul
    conv_rhs => rw [show N = N - limb1 b k * j + limb1 b k * j by omega, Nat.add_mul_mod_self_left]
  have dep : limb1 b k ∣ gap1 b k z := Nat.dvd_mul_left (limb1 b k) (high1 b k z - 1)
  by_cases hf : far1 b k z
  · obtain ⟨_, bound, _⟩ := represented1 b k z small hf
    have light : 2 ^ b ≤ limb1 b k := Nat.pow_le_pow_right (by decide) (by omega)
    have hpos : 0 < 2 ^ b := Nat.two_pow_pos b
    have hsum_ge : gap1 b k z + limb1 b k ≤ z.u + z.v := by
      have hdecomp := (Nat.mod_add_div (z.u + z.v) (limb1 b k)).symm
      have h2 : 2 ≤ high1 b k z := hf
      have hmul : (high1 b k z - 1) * limb1 b k + limb1 b k = limb1 b k * high1 b k z := by
        rw [show (high1 b k z - 1) * limb1 b k + limb1 b k = (high1 b k z - 1 + 1) * limb1 b k by ring,
          show high1 b k z - 1 + 1 = high1 b k z by omega, Nat.mul_comm]
      unfold gap1 high1 at *; omega
    rw [reduced1, if_pos hf]
    by_cases hl : 2 ^ b ≤ z.u
    · rw [if_pos hl]; dsimp only
      have hv : z.v < 2 ^ b := by omega
      have hge : gap1 b k z + 1 ≤ z.u := by omega
      have eBound : (StairPacket.PortalValues.negative sg z.u).toNat ≤ 1 := by
        cases StairPacket.PortalValues.negative sg z.u <;> decide
      have hx : z.u - gap1 b k z + z.v = (z.u + z.v) - gap1 b k z := by omega
      have hm : z.u - gap1 b k z - (StairPacket.PortalValues.negative sg z.u).toNat =
          (z.u - (StairPacket.PortalValues.negative sg z.u).toNat) - gap1 b k z := by omega
      rw [hx, hm]
      exact ⟨periodic _ _ (by omega) dep, periodic _ _ (by omega) dep⟩
    · rw [if_neg hl]; dsimp only
      have hu_lt : z.u < 2 ^ b := by omega
      have hge : gap1 b k z ≤ z.v := by omega
      have hx : z.u + (z.v - gap1 b k z) = (z.u + z.v) - gap1 b k z := by omega
      rw [hx]
      exact ⟨periodic _ _ (by omega) dep, rfl⟩
  · simp [reduced1, hf]

/-! ## Section 4: High-Bank Sum & Leave Restore Truth at `E = b` (`Margin-(k+1)`) -/

section LeaveShadow1
open StairPacket.HighBankSum StairPacket.HighBankAdjust StairPacket.LeaveCompanion

def cross1 (d : Nat) : Bool := decide (d ≠ 1)

theorem decode1 (d : Nat) (n : Bool) (h : d = if d = 1 then 1 else if n then 0 else 2) :
    d + 1 = (cross1 d).toNat + 2 * (!(cross1 d && n)).toNat := by
  by_cases e : d = 1
  · simp [e, cross1]
  · rw [if_neg e] at h
    cases n <;> simp only [Bool.false_eq_true, ite_false, ite_true] at h <;> subst d <;> decide

theorem value1 (F S H w E t : Nat) (c neg : Bool)
    (gap : F = S + 2 ^ t * (2 ^ E * (H - 1))) (far : 2 ≤ H)
    (room : H - 1 + S / 2 ^ E / 2 ^ t < 2 ^ w) (legal : neg = true → c = true)
    (digit : S / 2 ^ E / 2 ^ t + 1 = c.toNat + 2 * (!neg).toNat) :
    F / 2 ^ E = 2 ^ t * adjusted H w c neg + S / 2 ^ E % 2 ^ t := by
  have h := corrected H w (S / 2 ^ E / 2 ^ t + 1) c neg far (by omega) legal digit
  have h' : adjusted H w c neg = H - 1 + S / 2 ^ E / 2 ^ t := by omega
  rw [h', gap, show 2 ^ t * (2 ^ E * (H - 1)) = 2 ^ E * (2 ^ t * (H - 1)) by ring,
    Nat.add_mul_div_left _ _ (by positivity), Nat.mul_add]
  have decomposition := Nat.mod_add_div (S / 2 ^ E) (2 ^ t)
  omega

theorem step_sum_le (z : SkywalkNat.State) : total (step z) ≤ total z := by
  unfold total step; split_ifs <;> (try dsimp only) <;> omega

theorem iter_sum_nonincrease1 (k : Nat) (z : SkywalkNat.State) :
    total (step^[k] z) ≤ total z := by
  induction k generalizing z with
  | zero => exact le_rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply]
    exact le_trans (ih (step z)) (step_sum_le z)

theorem right1_sum (k B s H w E : Nat) (hk : 0 < k) (ready : guard1 k s ≤ B)
    (odd : B % 2 = 1) (small : s < 2 ^ E) (low : 2 ^ k * 2 ^ E ≤ B + s) (high : B + s < 2 * (2 ^ k * 2 ^ E))
    (far : 2 ≤ H) :
    let z : SkywalkNat.State := ⟨s, B⟩
    let S := total (step^[k] z)
    let F := total (step^[k] ⟨s, B + 2 ^ k * (2 ^ E * (H - 1))⟩)
    let t := wait k s
    let d := S / 2 ^ E / 2 ^ t
    let neg := cross1 d && IntegerHigh.negative (oddBits (letters k z))
    H - 1 + d < 2 ^ w →
      d + 1 = (cross1 d).toNat + 2 * (!neg).toNat ∧
      F / 2 ^ E = 2 ^ t * adjusted H w (cross1 d) neg + S / 2 ^ E % 2 ^ t := by
  dsimp only
  intro room
  have q := corrected_digit1 k B s (2 ^ E) hk ready odd small low high
  dsimp only at q
  rw [Nat.mul_comm (2 ^ _) (2 ^ E), ← Nat.div_div_eq_div_mul] at q
  have digit := decode1 _ _ q
  exact ⟨digit, value1 _ _ _ _ _ _ _ _ (right_sum1 k B s _ ready) far room
    (fun hn => (Bool.and_eq_true_iff.mp hn).1) digit⟩

theorem left1_sum (k B s H w E : Nat) (ready : guard1 k s ≤ B)
    (odd : s % 2 = 1) (small : s < 2 ^ E) (low : 2 ^ k * 2 ^ E ≤ B + s) (high : B + s < 2 * (2 ^ k * 2 ^ E))
    (far : 2 ≤ H) :
    let S := total (step^[k] ⟨B, s⟩)
    let F := total (step^[k] ⟨B + 2 ^ k * (2 ^ E * (H - 1)), s⟩)
    let d := S / 2 ^ E
    H - 1 + d < 2 ^ w →
      d + 1 = (cross1 d).toNat + 2 ∧ F / 2 ^ E = adjusted H w (cross1 d) false := by
  dsimp only
  intro room
  have h := left_digit1 k B s (2 ^ E) ready odd small low high
  dsimp only at h
  have digit : total (step^[k] ⟨B, s⟩) / 2 ^ E + 1 = (cross1 (total (step^[k] ⟨B, s⟩) / 2 ^ E)).toNat + 2 := by
    rcases h with h | h <;> simp [total, h, cross1]
  have gap : total (step^[k] ⟨B + 2 ^ k * (2 ^ E * (H - 1)), s⟩) =
      total (step^[k] ⟨B, s⟩) + 2 ^ E * (H - 1) := by
    rw [long_u1 k B s _ ready]
    dsimp [total]; omega
  have actual := value1 _ _ H w E 0 _ false (by simpa only [pow_zero, one_mul] using gap)
    far (by simpa only [pow_zero, Nat.div_one] using room) (by simp)
    (by simpa only [pow_zero, Nat.div_one, Bool.not_false, Bool.toNat_true, Nat.mul_one] using digit)
  exact ⟨digit, by simpa only [pow_zero, one_mul, Nat.mod_one, Nat.add_zero] using actual⟩

theorem far_result1 (b k w : Nat) (hk : 0 < k) (z : SkywalkNat.State)
    (small : min z.u z.v < 2 ^ b) (far : far1 b k z) (odd : z.v % 2 = 1)
    (enough : high1 b k z + 1 < 2 ^ w) :
    let r := reduced1 b k z
    let S := total (step^[k] r)
    let F := total (step^[k] z)
    let t := if 2 ^ b ≤ z.u then 0 else wait k z.u
    let d := S / 2 ^ b / 2 ^ t
    let neg := cross1 d && (!(decide (2 ^ b ≤ z.u)) && IntegerHigh.negative (oddBits (letters k r)))
    d + 1 = (cross1 d).toNat + 2 * (!neg).toNat ∧
      F / 2 ^ b = 2 ^ t * adjusted (high1 b k z) w (cross1 d) neg + S / 2 ^ b % 2 ^ t := by
  let r := reduced1 b k z
  let H := high1 b k z
  let V := 2 ^ b
  let D := V * (H - 1)
  have sides := rail1 b k z small far
  have bounds := (represented1 b k z small far).2
  rw [scale1] at bounds
  have hH : 2 ≤ H := far
  have h2k : 2 ∣ 2 ^ k := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : k ≠ 0)
    rw [pow_succ]; exact ⟨2 ^ m, by ring⟩
  dsimp only
  by_cases h : 2 ^ b ≤ z.u
  · obtain ⟨eqV, eqU, guarded⟩ := sides.1 h
    have shape : z = ⟨r.u + 2 ^ k * D, r.v⟩ := SkywalkNat.State.ext eqU eqV.symm
    have short : r.v < V := by dsimp [r, V]; omega
    have rodd : r.v % 2 = 1 := eqV ▸ odd
    have dcap := left_digit1 k r.u r.v V guarded rodd short bounds.1 bounds.2
    change total (step^[k] r) / V = 1 ∨ total (step^[k] r) / V = 2 at dcap
    have room : H - 1 + total (step^[k] r) / V < 2 ^ w := by change H + 1 < 2 ^ w at enough; omega
    have outcome := left1_sum k r.u r.v H w b guarded rodd short bounds.1 bounds.2 hH room
    rw [← shape] at outcome
    simpa only [if_pos h, decide_eq_true h, Bool.not_true, Bool.false_and, Bool.and_false,
      Bool.not_false, Bool.toNat_true, Nat.mul_one, pow_zero, Nat.div_one, one_mul,
      Nat.mod_one, Nat.add_zero] using outcome
  · obtain ⟨eqU, eqV, guarded⟩ := sides.2 (Nat.lt_of_not_ge h)
    have shape : z = ⟨r.u, r.v + 2 ^ k * D⟩ := SkywalkNat.State.ext eqU.symm eqV
    have short : r.u < V := by dsimp [r, V]; omega
    have rodd : r.v % 2 = 1 := by
      obtain ⟨m, hm⟩ := h2k
      have : z.v = r.v + 2 * (m * D) := by rw [eqV, hm]; ring
      omega
    have dcap := (right_digit1 k r.v r.u V guarded rodd short
      (by simpa only [Nat.add_comm r.v r.u] using bounds.1)
      (by simpa only [Nat.add_comm r.v r.u] using bounds.2)).1
    change total (step^[k] r) / (2 ^ (wait k r.u) * V) = 0 ∨
      total (step^[k] r) / (2 ^ (wait k r.u) * V) = 1 ∨
      total (step^[k] r) / (2 ^ (wait k r.u) * V) = 2 at dcap
    rw [Nat.mul_comm (2 ^ _) V, ← Nat.div_div_eq_div_mul] at dcap
    have room : H - 1 + total (step^[k] r) / V / 2 ^ (wait k r.u) < 2 ^ w := by
      change H + 1 < 2 ^ w at enough; omega
    have outcome := right1_sum k r.v r.u H w b hk guarded rodd short
      (by simpa only [Nat.add_comm r.v r.u] using bounds.1)
      (by simpa only [Nat.add_comm r.v r.u] using bounds.2) hH room
    rw [← shape] at outcome
    have waits : wait k z.u = wait k r.u := congrArg (wait k) eqU.symm
    simpa only [if_neg h, decide_eq_false h, Bool.not_false, Bool.true_and, waits] using outcome

theorem near_result1 (b k : Nat) (z : SkywalkNat.State) (close : ¬ far1 b k z) :
    reduced1 b k z = z ∧ total (step^[k] z) / 2 ^ b < 2 ^ (k + 1) := by
  refine ⟨by simp [reduced1, close], ?_⟩
  have lt : (z.u + z.v) / limb1 b k < 2 := Nat.lt_of_not_ge close
  have lim := (Nat.div_lt_iff_lt_mul (by unfold limb1; positivity)).mp lt
  have hpow : 2 * limb1 b k = 2 ^ (k + 1) * 2 ^ b := by
    rw [scale1, pow_succ]; ring
  have noninc := iter_sum_nonincrease1 k z
  apply (Nat.div_lt_iff_lt_mul (by positivity)).mpr
  dsimp only [total] at noninc ⊢
  omega

/-- Exact `far_u` indicator: whether `F_end.u` receives a positive `2^b * J` high-bank gap. -/
def farU (b k : Nat) (z : SkywalkNat.State) : Prop :=
  far1 b k z ∧ (2 ^ b ≤ z.u ∨ wait k z.u < k)

instance (b k : Nat) (z : SkywalkNat.State) : Decidable (farU b k z) := by
  unfold farU; infer_instance

/-- Exact gap decomposition of `(F_end, r_end)` at `V = 2^b`. -/
theorem limbGaps1_exact (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b) :
    let F := step^[k] z
    let r := step^[k] (reduced1 b k z)
    (farU b k z → ∃ a : Nat, 0 < a ∧ F.u = r.u + 2 ^ b * a ∧ F.v = r.v ∧ r.v < 2 ^ b) ∧
    (¬ farU b k z → ∃ c : Nat, (0 < k → 2 ∣ c) ∧ F.u = r.u ∧ F.v = r.v + 2 ^ b * c) := by
  dsimp only
  constructor
  · intro ⟨hf, hside⟩
    let r0 := reduced1 b k z
    let H := high1 b k z - 1
    have hH : 0 < H := by dsimp [H]; unfold far1 at hf; omega
    let D := 2 ^ b * H
    have sides := rail1 b k z small hf
    by_cases hl : 2 ^ b ≤ z.u
    · obtain ⟨rv, fullU, valid⟩ := sides.1 hl
      have shape : z = ⟨r0.u + 2 ^ k * D, r0.v⟩ := SkywalkNat.State.ext fullU rv.symm
      have res := long_u1 k r0.u r0.v D valid
      rw [← shape] at res
      have hv_end : (step^[k] r0).v = r0.v := by
        have hstep : ∀ n B s, guard1 n s ≤ B → (step^[n] ⟨B, s⟩).v = s := by
          intro n; induction n with
          | zero => intro B s _; rfl
          | succ n ih =>
            intro B s hB
            have hh : 2 * guard1 n s + s ≤ B := by simpa [guard1_succ] using hB
            have hp := guard1_pos n s
            rw [Function.iterate_succ_apply]
            by_cases e : B % 2 = 0
            · have st : step ⟨B, s⟩ = ⟨B / 2, s⟩ := by simp [step, show B ≠ 0 by omega, e]
              rw [st]; exact ih _ _ (by omega)
            · have st : step ⟨B, s⟩ = ⟨(B - s) / 2, s⟩ := by
                simp [step, show B ≠ 0 by omega, e, show s ≤ B by omega]
              rw [st]; exact ih _ _ (by omega)
        exact hstep k r0.u r0.v valid
      have hv_small : (step^[k] r0).v < 2 ^ b := by rw [hv_end, rv]; omega
      rw [res]
      exact ⟨H, hH, rfl, rfl, hv_small⟩
    · have hw : wait k z.u < k := hside.resolve_left hl
      obtain ⟨ru, fullV, valid⟩ := sides.2 (Nat.lt_of_not_ge hl)
      have shape : z = ⟨r0.u, r0.v + 2 ^ k * D⟩ := SkywalkNat.State.ext ru.symm fullV
      have res := long_v1 k r0.v r0.u D valid
      dsimp only at res
      rw [← shape] at res
      have hw' : wait k r0.u ≠ k := by rw [ru]; omega
      rw [if_neg hw'] at res
      have hrv : (step^[k] r0).v < 2 ^ b := by
        have hle : ∀ n B s, guard1 n s ≤ B → wait n s < n → (step^[n] ⟨s, B⟩).v ≤ s := by
          intro n; induction n with
          | zero => intro _ _ _ h0; omega
          | succ n ih =>
            intro B s hB hwn
            have hh : 2 * guard1 n s + s ≤ B := by simpa [guard1_succ] using hB
            have hp := guard1_pos n s
            rw [Function.iterate_succ_apply]
            by_cases e : s % 2 = 0
            · rw [evenStep1 s B e]
              have gm := guard1_mono n (a := s / 2) (b := s) (by omega)
              have hwn' : wait n (s / 2) < n := by simp [wait, e] at hwn; omega
              have := ih B (s / 2) (by omega) hwn'
              omega
            · have st : step ⟨s, B⟩ = ⟨(B - s) / 2, s⟩ := by
                simp [step, show s ≠ 0 by omega, e, show ¬ B ≤ s by omega]
              rw [st]
              have hstep : ∀ m A t, guard1 m t ≤ A → (step^[m] ⟨A, t⟩).v = t := by
                intro m; induction m with
                | zero => intro _ _ _; rfl
                | succ m ihm =>
                  intro A t hA
                  have hhm : 2 * guard1 m t + t ≤ A := by simpa [guard1_succ] using hA
                  have hpm := guard1_pos m t
                  rw [Function.iterate_succ_apply]
                  by_cases em : A % 2 = 0
                  · rw [show step ⟨A, t⟩ = ⟨A / 2, t⟩ by simp [step, show A ≠ 0 by omega, em]]
                    exact ihm _ _ (by omega)
                  · rw [show step ⟨A, t⟩ = ⟨(A - t) / 2, t⟩ by
                      simp [step, show A ≠ 0 by omega, em, show t ≤ A by omega]]
                    exact ihm _ _ (by omega)
              rw [hstep n ((B - s) / 2) s (by omega)]
        have := hle k r0.v r0.u valid (by rw [ru]; exact hw)
        have h_eq : ({ u := r0.u, v := r0.v } : SkywalkNat.State) = r0 := rfl
        rw [h_eq] at this
        exact lt_of_le_of_lt this (by dsimp only [r0]; omega)
      rw [res]
      refine ⟨2 ^ wait k r0.u * H, Nat.mul_pos (Nat.two_pow_pos _) hH, ?_, rfl, hrv⟩
      dsimp only [D]; ring
  · intro hnot
    by_cases hf : far1 b k z
    · have hlt : ¬ (2 ^ b ≤ z.u) := fun hl => hnot ⟨hf, Or.inl hl⟩
      have hge : ¬ (wait k z.u < k) := fun hw => hnot ⟨hf, Or.inr hw⟩
      have hwait_le : ∀ n s, wait n s ≤ n := by
        intro n; induction n with
        | zero => intro _; simp [wait]
        | succ n ih => intro s; unfold wait; split <;> [have := ih (s / 2); skip] <;> omega
      have hweq : wait k z.u = k := by have := hwait_le k z.u; omega
      let r0 := reduced1 b k z
      let H := high1 b k z - 1
      let D := 2 ^ b * H
      obtain ⟨ru, fullV, valid⟩ := (rail1 b k z small hf).2 (Nat.lt_of_not_ge hlt)
      have shape : z = ⟨r0.u, r0.v + 2 ^ k * D⟩ := SkywalkNat.State.ext ru.symm fullV
      have res := long_v1 k r0.v r0.u D valid
      dsimp only at res
      rw [← shape] at res
      have hweq' : wait k r0.u = k := by rw [ru]; exact hweq
      rw [if_pos hweq'] at res
      have hr0 : ({ u := r0.u, v := r0.v } : SkywalkNat.State) = r0 := rfl
      rw [hr0] at res
      rw [res]
      refine ⟨2 ^ k * H, ?_, rfl, ?_⟩
      · intro hk
        obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : k ≠ 0)
        rw [pow_succ]; exact ⟨2 ^ m * H, by ring⟩
      · dsimp only [D]; rw [hweq']; ring
    · refine ⟨0, fun _ => ⟨0, rfl⟩, ?_, ?_⟩ <;> simp [reduced1, hf]

private theorem rel0_pos_left {F r : SkywalkNat.State} (ht : Rel1 0 F r) (hgt : r.u < F.u) : 0 < r.u := by
  cases ht with
  | left B s D hB _ =>
    have hB1 : 1 ≤ B := by simpa [guard1] using hB
    dsimp only; omega
  | right B s D _ _ =>
    dsimp only at hgt; omega

theorem pos_iff1 (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b) :
    0 < (step^[k] z).u ↔ 0 < (step^[k] (reduced1 b k z)).u := by
  have ⟨h1, h2⟩ := limbGaps1_exact b k z small
  by_cases hfu : farU b k z
  · obtain ⟨a, ha, hFu, _, _⟩ := h1 hfu
    have hpos_a : 0 < 2 ^ b * a := Nat.mul_pos (Nat.two_pow_pos b) ha
    have hru : 0 < (step^[k] (reduced1 b k z)).u :=
      rel0_pos_left (terminalRel1 (represented1 b k z small hfu.1).1) (by omega)
    have hFu_pos : 0 < (step^[k] z).u := by omega
    tauto
  · obtain ⟨_, _, hFu, _⟩ := h2 hfu
    rw [hFu]

/-- Exact `long_F` characterization: `2^b ≤ F.u - e ↔ 2^b ≤ r.u - e ∨ farU b k z`. -/
theorem longF_iff1 (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b)
    (e : Nat) (he : e ≤ 1) :
    let F := step^[k] z
    let r := step^[k] (reduced1 b k z)
    2 ^ b ≤ F.u - e ↔ (2 ^ b ≤ r.u - e ∨ farU b k z) := by
  dsimp only
  have ⟨h1, h2⟩ := limbGaps1_exact b k z small
  by_cases hfu : farU b k z
  · obtain ⟨a, ha, hFu, _, _⟩ := h1 hfu
    have hpos_a : 0 < 2 ^ b * a := Nat.mul_pos (Nat.two_pow_pos b) ha
    have hpos : 0 < (step^[k] (reduced1 b k z)).u :=
      rel0_pos_left (terminalRel1 (represented1 b k z small hfu.1).1) (by omega)
    have hge : 2 ^ b ≤ 2 ^ b * a := Nat.le_mul_of_pos_right _ ha
    constructor
    · intro _; exact Or.inr hfu
    · intro _; rw [hFu]; omega
  · obtain ⟨_, _, hFu, _⟩ := h2 hfu
    rw [hFu]
    simp [hfu]

/-- Exact `erasePop` safety when `long_F ≠ long_r`: both `r.u - e < 2^b` and `r.u + r.v < 2^(b+1)`,
so all bits `≥ b+1` of both `r.u - e` and `r.u + r.v` are `0` and `upperBorrow (2^b) r.u r.v e = 0`. -/
theorem erase_with_longF1 (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b)
    (e : Nat) (he : e ≤ 1)
    (hshort : ¬ 2 ^ b ≤ (step^[k] (reduced1 b k z)).u - e) (hfu : farU b k z) :
    let r := step^[k] (reduced1 b k z)
    (r.u - e) / 2 ^ (b + 1) = 0 ∧
    (r.u + r.v) / 2 ^ (b + 1) = 0 ∧
    upperBorrow (2 ^ b) r.u r.v e = 0 := by
  dsimp only
  obtain ⟨_, _, _, _, hrv⟩ := (limbGaps1_exact b k z small).1 hfu
  have h2 : 2 ^ (b + 1) = 2 * 2 ^ b := by rw [pow_succ]; ring
  have hru : (step^[k] (reduced1 b k z)).u - e < 2 ^ b := Nat.lt_of_not_ge hshort
  have hsum : (step^[k] (reduced1 b k z)).u + (step^[k] (reduced1 b k z)).v < 2 ^ (b + 1) := by omega
  refine ⟨Nat.div_eq_of_lt (by omega), Nat.div_eq_of_lt hsum, ?_⟩
  unfold upperBorrow
  rw [Nat.mod_eq_of_lt (by omega : (step^[k] (reduced1 b k z)).u - e < 2 * 2 ^ b)]
  simp [hshort]

/-- Exact 2-CNOT bit-`b` parity sync (`G4`): for all `k ≥ 1`,
`bit b (F.u - e) = bit b (r.u - e) ⊕ bit b (r.u + r.v) ⊕ bit b (F.u + F.v)`. -/
theorem bitB_sync1 (b k : Nat) (hk : 0 < k) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b)
    (e : Nat) (he : e ≤ 1) (her : e ≤ (step^[k] (reduced1 b k z)).u) :
    let F := step^[k] z
    let r := step^[k] (reduced1 b k z)
    (F.u - e).testBit b =
      ((r.u - e).testBit b ^^ (r.u + r.v).testBit b ^^ (F.u + F.v).testBit b) := by
  dsimp only
  have testBit_add_pow2 (x a : Nat) :
      (x + 2 ^ b * a).testBit b = (x.testBit b ^^ decide (a % 2 = 1)) := by
    rw [Nat.testBit_eq_decide_div_mod_eq, Nat.testBit_eq_decide_div_mod_eq,
      Nat.add_mul_div_left _ _ (Nat.two_pow_pos b), Nat.add_mod]
    have h1 : x / 2 ^ b % 2 < 2 := Nat.mod_lt _ (by decide)
    have h2 : a % 2 < 2 := Nat.mod_lt _ (by decide)
    interval_cases (x / 2 ^ b % 2) <;> interval_cases (a % 2) <;> decide
  have ⟨h1, h2⟩ := limbGaps1_exact b k z small
  by_cases hfu : farU b k z
  · obtain ⟨a, _, hFu, hFv, _⟩ := h1 hfu
    have hsub : (step^[k] z).u - e = ((step^[k] (reduced1 b k z)).u - e) + 2 ^ b * a := by omega
    have hsum : (step^[k] z).u + (step^[k] z).v =
        ((step^[k] (reduced1 b k z)).u + (step^[k] (reduced1 b k z)).v) + 2 ^ b * a := by omega
    rw [hsub, hsum, testBit_add_pow2, testBit_add_pow2]
    cases ((step^[k] (reduced1 b k z)).u - e).testBit b <;>
      cases ((step^[k] (reduced1 b k z)).u + (step^[k] (reduced1 b k z)).v).testBit b <;>
      cases decide (a % 2 = 1) <;> rfl
  · obtain ⟨c, hc, hFu, hFv⟩ := h2 hfu
    obtain ⟨m, hm⟩ := hc hk
    have hsum : (step^[k] z).u + (step^[k] z).v =
        ((step^[k] (reduced1 b k z)).u + (step^[k] (reduced1 b k z)).v) + 2 ^ b * c := by omega
    rw [hsum, hFu, testBit_add_pow2]
    have hcm : c % 2 = 0 := by omega
    rw [hcm]
    simp

/-- Low `b` bits of `u + v` and `u - e` are preserved identically across `reduced1`. -/
theorem retainedModB1 (b k : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b) (sg : Bool) :
    let F := step^[k] z
    let r := step^[k] (reduced1 b k z)
    let e := StairPacket.PortalValues.negative sg r.u
    StairPacket.PortalValues.negative sg F.u = e ∧
    (F.u + F.v) % 2 ^ b = (r.u + r.v) % 2 ^ b ∧
    (F.u - e.toNat) % 2 ^ b = (r.u - e.toNat) % 2 ^ b := by
  dsimp only
  have hpos := pos_iff1 b k z small
  have he : (StairPacket.PortalValues.negative sg (step^[k] (reduced1 b k z)).u).toNat ≤
      (step^[k] (reduced1 b k z)).u := by
    by_cases p : 0 < (step^[k] (reduced1 b k z)).u
    · have : (StairPacket.PortalValues.negative sg (step^[k] (reduced1 b k z)).u).toNat ≤ 1 := by
        cases StairPacket.PortalValues.negative sg (step^[k] (reduced1 b k z)).u <;> decide
      omega
    · simp [StairPacket.PortalValues.negative, p]
  refine ⟨by simp only [StairPacket.PortalValues.negative, hpos], ?_, ?_⟩
  · have ⟨h1, h2⟩ := limbGaps1_exact b k z small
    by_cases hfu : farU b k z
    · obtain ⟨a, _, hFu, hFv, _⟩ := h1 hfu
      have hsum : (step^[k] z).u + (step^[k] z).v =
          (step^[k] (reduced1 b k z)).u + (step^[k] (reduced1 b k z)).v + 2 ^ b * a := by omega
      rw [hsum, Nat.add_mul_mod_self_left]
    · obtain ⟨c, _, hFu, hFv⟩ := h2 hfu
      have hsum : (step^[k] z).u + (step^[k] z).v =
          (step^[k] (reduced1 b k z)).u + (step^[k] (reduced1 b k z)).v + 2 ^ b * c := by omega
      rw [hsum, Nat.add_mul_mod_self_left]
  · have ⟨h1, h2⟩ := limbGaps1_exact b k z small
    by_cases hfu : farU b k z
    · obtain ⟨a, _, hFu, _, _⟩ := h1 hfu
      rw [hFu, show (step^[k] (reduced1 b k z)).u + 2 ^ b * a -
          (StairPacket.PortalValues.negative sg (step^[k] (reduced1 b k z)).u).toNat =
          ((step^[k] (reduced1 b k z)).u -
          (StairPacket.PortalValues.negative sg (step^[k] (reduced1 b k z)).u).toNat) + 2 ^ b * a by omega,
        Nat.add_mul_mod_self_left]
    · obtain ⟨_, _, hFu, _⟩ := h2 hfu
      rw [hFu]

/-- Universal upper-rail restore at `half = 2^b` using `long_F` and `F_borrow`. -/
theorem restored1 (b k w : Nat) (z : SkywalkNat.State) (small : min z.u z.v < 2 ^ b) (sg : Bool) :
    let F := step^[k] z
    let r := step^[k] (reduced1 b k z)
    let e := (StairPacket.PortalValues.negative sg r.u).toNat
    ((if (2 ^ b ≤ r.u - e ∨ farU b k z) then ((F.u + F.v) / 2 ^ (b + 1)) % 2 ^ w else 0) +
        2 ^ w - upperBorrow (2 ^ b) F.u F.v e) % 2 ^ w =
      ((F.u - e) / 2 ^ (b + 1)) % 2 ^ w := by
  let F := step^[k] z
  let r := step^[k] (reduced1 b k z)
  let e := (StairPacket.PortalValues.negative sg r.u).toNat
  have le : e ≤ 1 := by cases h : StairPacket.PortalValues.negative sg r.u <;> simp [e, h]
  have pos : 0 < F.u ↔ 0 < r.u := pos_iff1 b k z small
  have eu : e ≤ F.u := by
    by_cases h : 0 < F.u
    · omega
    · have no : ¬ 0 < r.u := fun hr => h (pos.mpr hr)
      simp [e, StairPacket.PortalValues.negative, no]
  have sm : min F.u F.v < 2 ^ b := lt_of_le_of_lt (StairPacket.LeaveShadowRails.min_iter k z) small
  have out := upper_restore (2 ^ b) F.u F.v e (2 ^ w) (Nat.two_pow_pos _) le eu sm (Nat.two_pow_pos _)
  have hlong := (longF_iff1 b k z small e le).symm
  have two : 2 * 2 ^ b = 2 ^ (b + 1) := (Nat.mul_comm _ _).trans (pow_succ 2 b).symm
  change ((if 2 ^ b ≤ r.u - e ∨ farU b k z then ((F.u + F.v) / 2 ^ (b + 1)) % 2 ^ w else 0) +
      2 ^ w - upperBorrow (2 ^ b) F.u F.v e) % 2 ^ w = _
  have hite : (if 2 ^ b ≤ r.u - e ∨ farU b k z then ((F.u + F.v) / 2 ^ (b + 1)) % 2 ^ w else 0) =
      (if 2 ^ b ≤ F.u - e then ((F.u + F.v) / 2 ^ (b + 1)) % 2 ^ w else 0) := by
    by_cases hc : 2 ^ b ≤ F.u - e
    · rw [if_pos hc, if_pos (hlong.mpr hc)]
    · rw [if_neg hc, if_neg (fun h => hc (hlong.mp h))]
  rw [hite]
  simpa only [two] using out

/-- `ScanRow16` top-bit-zero bound at `Margin-(k+1)`: for any `k ≥ 1`, `r_end.u < 2^(b+k)`. -/
theorem scanRow_u_lt (b k : Nat) (hk : 0 < k) (z : SkywalkNat.State)
    (small : min z.u z.v < 2 ^ b) :
    (step^[k] (reduced1 b k z)).u < 2 ^ (b + k) := by
  have step_u_le (w : SkywalkNat.State) : (step w).u ≤ (w.u + w.v) / 2 := by
    unfold step; split_ifs <;> (try dsimp only) <;> omega
  have r0_sum : (reduced1 b k z).u + (reduced1 b k z).v < 2 * 2 ^ (b + k) := by
    by_cases hf : far1 b k z
    · exact (represented1 b k z small hf).2.2
    · rw [reduced1, if_neg hf]
      have lt : (z.u + z.v) / limb1 b k < 2 := Nat.lt_of_not_ge hf
      have := (Nat.div_lt_iff_lt_mul (by unfold limb1; positivity)).mp lt
      unfold limb1 at this; omega
  obtain ⟨m, hm⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
  subst hm
  rw [Function.iterate_succ_apply']
  have hnoninc := iter_sum_nonincrease1 m (reduced1 b (m + 1) z)
  have hu := step_u_le (step^[m] (reduced1 b (m + 1) z))
  dsimp only [total] at hnoninc
  omega

end LeaveShadow1

/-! ## Section 5: Universal Envelope (`SmallIfFar1`) & Instantiations for All 22 Blocks -/

theorem smallIfFar1 (b k t : Nat) (z : SkywalkNat.State)
    (hbk : 511 - t ≤ 2 * b + k) (hprod : z.u * z.v < 2 ^ (511 - t)) (hf : far1 b k z) :
    min z.u z.v < 2 ^ b := by
  by_contra h
  have hu : 2 ^ b ≤ z.u := by omega
  have hv : 2 ^ b ≤ z.v := by omega
  have hsum : 2 * 2 ^ (b + k) ≤ z.u + z.v := by
    have := (Nat.le_div_iff_mul_le (by unfold limb1; positivity)).mp hf
    unfold limb1 at this; omega
  have hmax : 2 ^ (b + k) ≤ max z.u z.v := by omega
  have hmul : 2 ^ b * 2 ^ (b + k) ≤ z.u * z.v := by
    by_cases hle : z.u ≤ z.v
    · rw [max_eq_right hle] at hmax
      exact Nat.mul_le_mul hu hmax
    · rw [max_eq_left (by omega)] at hmax
      rw [Nat.mul_comm (2 ^ b)]
      exact Nat.mul_le_mul hmax hv
  have hpow : 2 ^ (511 - t) ≤ 2 ^ b * 2 ^ (b + k) := by
    rw [← pow_add]
    exact Nat.pow_le_pow_right (by decide) (by omega)
  omega


/-! ## Section 6: Exact Swap Parity for `farU` (`farU = side ⊕ (far ∧ ⊕swaps)`) -/

def xorList : List Bool → Bool
  | [] => false
  | b :: bs => b ^^ xorList bs

private theorem letters_no_swap (k B s : Nat) (ready : guard1 k s ≤ B) :
    xorList ((letters k ⟨B, s⟩).map (fun a => decide (a = 2))) = false := by
  induction k generalizing B with
  | zero => rfl
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    by_cases e : B % 2 = 0
    · have st : step ⟨B, s⟩ = ⟨B / 2, s⟩ := by simp [step, show B ≠ 0 by omega, e]
      simp only [letters, letter, e, ↓reduceIte, st, List.map_cons, xorList,
        show decide (0 = 2) = false by decide, Bool.false_xor]
      exact ih (B / 2) (by omega)
    · have hle : ¬ B < s := by omega
      have st : step ⟨B, s⟩ = ⟨(B - s) / 2, s⟩ := by simp [step, show B ≠ 0 by omega, e, hle]
      simp only [letters, letter, e, hle, ↓reduceIte, st, List.map_cons, xorList,
        show decide (1 = 2) = false by decide, Bool.false_xor]
      exact ih ((B - s) / 2) (by omega)

private theorem letters_right_xor (k B s : Nat) (ready : guard1 k s ≤ B) :
    xorList ((letters k ⟨s, B⟩).map (fun a => decide (a = 2))) = decide (wait k s < k) := by
  induction k generalizing s with
  | zero => rfl
  | succ k ih =>
    have hh : 2 * guard1 k s + s ≤ B := by simpa [guard1_succ] using ready
    have hp := guard1_pos k s
    by_cases e : s % 2 = 0
    · have gm := guard1_mono k (a := s / 2) (b := s) (by omega)
      have st : step ⟨s, B⟩ = ⟨s / 2, B⟩ := by
        by_cases hz : s = 0
        · subst hz; rfl
        · simp [step, hz, e]
      have hw : wait (k + 1) s = wait k (s / 2) + 1 := by simp [wait, e]
      simp only [letters, letter, e, ↓reduceIte, st, List.map_cons, xorList, hw,
        show decide (0 = 2) = false by decide, Bool.false_xor]
      rw [ih (s / 2) (by omega)]
      exact decide_eq_decide.mpr ⟨by omega, by omega⟩
    · have lt : s < B := by omega
      have st : step ⟨s, B⟩ = ⟨(B - s) / 2, s⟩ := by simp [step, show s ≠ 0 by omega, e, lt]
      have hw : wait (k + 1) s = 0 := by simp [wait, e]
      simp only [letters, letter, e, lt, ↓reduceIte, st, List.map_cons, xorList, hw, Nat.zero_lt_succ, decide_true]
      rw [letters_no_swap k ((B - s) / 2) s (by omega)]
      rfl

private theorem swapLetters1 {k : Nat} {z t : SkywalkNat.State} (h : Rel1 k z t)
    (g s : Bool) (odd : z.v % 2 = 1) :
    (SkywalkTrace.trace k (SkywalkRails.encode g s z.u z.v)).map Prod.snd =
      (letters k t).map (fun a => decide (a = 2)) := by
  induction k generalizing z t g s with
  | zero => rfl
  | succ k ih =>
    have pos : 0 < z.v := by omega
    obtain ⟨eq, tail⟩ := advance1 h
    simp only [SkywalkTrace.trace, letters, List.map_cons,
      ECDSAAdd.Entrant.IntegerHigh.recorded z g s pos odd (different1 h).1, eq,
      SkywalkTrace.next, ECDSAAdd.SkywalkRails.step_reencode g s z pos odd]
    exact congrArg (_ :: ·) (ih tail _ _ (SkywalkNat.step_v_odd_pos z pos odd).2)

theorem swaps_xor1 (b k : Nat) (z : SkywalkNat.State) (g s : Bool)
    (small : min z.u z.v < 2 ^ b) (odd : z.v % 2 = 1) (far : far1 b k z) :
    xorList ((SkywalkTrace.trace k (SkywalkRails.encode g s z.u z.v)).map Prod.snd) =
      (!decide (2 ^ b ≤ z.u) && decide (wait k z.u < k)) := by
  let r := reduced1 b k z
  have tape := swapLetters1 (represented1 b k z small far).1 g s odd
  rw [tape]
  change xorList ((letters k r).map (fun a => decide (a = 2))) = _
  by_cases hl : 2 ^ b ≤ z.u
  · have h := (rail1 b k z small far).1 hl
    have eq : r = ⟨r.u, z.v⟩ := SkywalkNat.State.ext rfl h.1
    have guard : guard1 k z.v ≤ r.u := h.1 ▸ h.2.2
    rw [eq, letters_no_swap k r.u z.v guard]
    simp [hl]
  · have h := (rail1 b k z small far).2 (Nat.lt_of_not_ge hl)
    have eq : r = ⟨z.u, r.v⟩ := SkywalkNat.State.ext h.1 rfl
    have guard : guard1 k z.u ≤ r.v := h.1 ▸ h.2.2
    rw [eq, letters_right_xor k r.v z.u guard]
    simp [hl]

theorem farU_eq_xor (b k : Nat) (z : SkywalkNat.State) :
    decide (farU b k z) =
      ((decide (far1 b k z) && decide (2 ^ b ≤ z.u)) ^^
        (decide (far1 b k z) && (!decide (2 ^ b ≤ z.u) && decide (wait k z.u < k)))) := by
  by_cases f : far1 b k z <;> by_cases u : 2 ^ b ≤ z.u <;> by_cases w : wait k z.u < k <;>
    simp [farU, f, u, w]

end ECDSAAdd.Entrant.MarginK1

namespace ECDSAAdd.Entrant.MarginK1
