theorem return_packed (j : Fin 4) (raw v : State) (z : SkywalkNat.State) (G S : Bool) (m n : List Bool)
    (small : Shadow7.SmallIfFar (h15E j) 15 z)
    (p : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (h15E j) 15 z))
      (decide (Shadow.far (h15E j) 15 z ∧ 2 ^ h15E j ≤ z.u))
      (pullState (pull j) raw) v)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    run (enterInvP15E j) n (run (enterP15E j) m v) = v :=
  EnterProof17.return_packed (layout j) (map j) (enterP15E j) (enterInvP15E j)
    (inc j) (fun _ => rfl) (ports_length j) rfl rfl raw v z G S small p input m n

