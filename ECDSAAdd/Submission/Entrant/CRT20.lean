        rw [huSel_q (bTopP (start20 j) + 1 + i - wpP20 (start20 j)) (fun r _ => by omega), if_neg (by simp only [List.mem_range'_1]; omega)]
        exact hkeptE (bTopP (start20 j) + 1 + i - wpP20 (start20 j)) (by omega)
