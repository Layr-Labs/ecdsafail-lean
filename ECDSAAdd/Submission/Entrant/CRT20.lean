def maskP20 (j : Fin 10) : Program :=
  [.X 1557, .CX (a0P20 (start20 j) - 1) 1557, .CCX (b0P20 (start20 j) - 1) 1557 1558]
def borrowG4_20 (j : Fin 10) : Program :=
  [.X 1557, .CX (a0P20 (start20 j) - 1) 1557, .CCX (b0P20 (start20 j) - 1) 1557 1558]
def releaseMaskP20_core (j : Fin 10) : Program :=
  [.measureX 1558 [] [.CZ (b0P20 (start20 j) - 1) 1557], .CX (a0P20 (start20 j) - 1) 1557, .X 1557]
def farUOpen20 (j : Fin 10) : Program :=
  HighBankControl.toggles 1557 (swaps20G (start20 j)) ++
  [.CCX (e0P20 (start20 j) + 3) 1557 1558, .CX (e0P20 (start20 j) + 4) 1558]
def farUClose20 (j : Fin 10) : Program :=
  [.CX (e0P20 (start20 j) + 4) 1558, .measureX 1558 [] [.CZ (e0P20 (start20 j) + 3) 1557]] ++
  HighBankControl.toggles 1557 (swaps20G (start20 j))
def FarUReady20 (j : Fin 10) (z : SkywalkNat.State) (s : State) : Prop :=
  s.basis (e0P20 (start20 j) + 3) = decide (Shadow.far (sbP20 (start20 j)) 20 z) ∧
  s.basis (e0P20 (start20 j) + 4) = (decide (Shadow.far (sbP20 (start20 j)) 20 z) && decide (2 ^ sbP20 (start20 j) ≤ z.u)) ∧
  (Shadow.far (sbP20 (start20 j)) 20 z →
    HighBankControl.parity s.basis (swaps20G (start20 j)) =
      (!decide (2 ^ sbP20 (start20 j) ≤ z.u) && decide (IntegerHigh.wait 20 z.u < 20)))

def entryLeave20 (s : Nat) : List Gate :=
