def storeW15E (s i : Nat) : Wire :=
  let q := if 1558 + i < 1598 then 1558 + i else 1573 + i
  if q < e015E s then q else q + 10

def moves15E (s : Nat) : List (Wire × Wire) :=
  ((List.range (nextWp15E s - 2)).map fun i =>
    (bankW15E s (lows15E s + i), bTopP (s + 15) + 3 + i - nextWp15E s)) ++
  [(1557, e015E (s + 15) + 3), (1558, e015E (s + 15) + 4), (e015E s + 5, e015E (s + 15) + 5),
   (e015E s + 3, e015E (s + 15) + 6), (e015E s + 7, e015E (s + 15) + 7),
