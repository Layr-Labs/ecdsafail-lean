theorem pending20_layout (j : Fin 10) :
    (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs20 j)).Nodup := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hperm : (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs20 j)).Perm
      (1557 :: (1558 : Wire) :: ((pendingPairs20 j).map Prod.fst ++ (pendingPairs20 j).map Prod.snd)) :=
    List.Perm.cons _ (List.Perm.cons _ (sites_perm20 _))
  rw [hperm.nodup_iff]
  have hfst_nd : ((pendingPairs20 j).map Prod.fst).Nodup := by
    rw [pending20_fst, List.nodup_cons]
    refine ⟨?_, List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range⟩
    · intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := lowsP20 (start20 j) + i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
        (rw [eb] at e; unfold Wire at *; omega)
    · rw [List.mem_range] at ha hb
      have := bank20_inj j (by omega) (by omega) e; omega
  have hsnd_nd : ((pendingPairs20 j).map Prod.snd).Nodup := by
    simp only [pendingPairs20, List.map_map, Function.comp]
    refine List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range
    simp only [Function.comp_apply] at e
    dsimp only [storeWire20] at e
    split_ifs at e <;> ((try unfold Wire at *); omega)
  have hfst_range : ∀ q ∈ (pendingPairs20 j).map Prod.fst,
      (q : Nat) ≤ 1043 ∨ (1603 ≤ (q : Nat) ∧ (q : Nat) ≤ 1622) := by
    intro q hq; rw [pending20_fst, List.mem_cons] at hq
    rcases hq with rfl | hm
    · left; unfold Wire; omega
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := lowsP20 (start20 j) + i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
      · omega
      · left; unfold Wire at *; omega
      · right; rw [eb]; unfold Wire at *; omega
  have hsnd_range : ∀ q ∈ (pendingPairs20 j).map Prod.snd,
      (1559 ≤ (q : Nat) ∧ (q : Nat) ≤ 1602) ∨ 1623 ≤ (q : Nat) := by
    intro q hq
    simp only [pendingPairs20, List.map_map, Function.comp, List.mem_map, List.mem_range] at hq
    obtain ⟨k, hk, rfl⟩ := hq
    dsimp only [storeWire20]
    split_ifs <;> ((try unfold Wire at *); omega)
  have hdisj : ∀ a ∈ (pendingPairs20 j).map Prod.fst, ∀ b ∈ (pendingPairs20 j).map Prod.snd, a ≠ b := by
    intro a ha b hb eq; subst eq
    rcases hfst_range a ha with x | x <;> rcases hsnd_range a hb with y | y <;> unfold Wire at * <;> omega
  rw [List.nodup_cons, List.nodup_cons]
  refine ⟨?_, ?_, List.nodup_append.mpr ⟨hfst_nd, hsnd_nd, hdisj⟩⟩
  · intro hm; simp only [List.mem_cons, List.mem_append] at hm
    rcases hm with h | h | h
    · exact (by decide : (1557 : Wire) ≠ 1558) h
    · rcases hfst_range 1557 h with a | a <;> unfold Wire at * <;> omega
    · rcases hsnd_range 1557 h with a | a <;> unfold Wire at * <;> omega
  · intro hm; simp only [List.mem_append] at hm
    rcases hm with h | h
    · rcases hfst_range 1558 h with a | a <;> unfold Wire at * <;> omega
    · rcases hsnd_range 1558 h with a | a <;> unfold Wire at * <;> omega

