section

/-!
# 20-Tick Shadow Leave Exact Roundtrip (`Shadow7Wide20Roundtrip`)

Proves `leave20_roundtrip`: for every 20-tick block `j : Fin 10` (`s = 165, 185, ..., 325`) and every
admitted input state `Inputs20 j s z g0 s0`, running `leaveInvP20 j` after `leaveP20 j` recovers `s`
for arbitrary measurement tapes `m, n`.

Decomposition:
1. `barrel20_roundtrip`: exact inverse of `barrel20 (start20 j) false` / `true` from `barrel20_result`.
2. `leaveBefore20_ready` & `leaveBefore20_prepared`: `GateMirror.bit_sound` on `entryLeave20 ++ selPrefix20`
   plus `Partial.safe_addG` on `leaveAdjust20`.
3. `leaveAfter20_ready` & `leaveAfter20_prepared`: `GateMirror.bit_sound` on `afterHead20`, `lowRest20`,
   `leaveStoreMapped20`, plus `Partial.safe_eventsG` + `noMake` on `leaveLowClose20 ++ leaveClose20`.
4. `leave20_roundtrip`: composes `GateMirror.invert` + `barrel20_roundtrip` + `GateMirror.invert`.
-/

namespace ECDSAAdd.Entrant.StairPacket.Shadow20.LeaveCut20

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.IntegerPacket
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Partial
open ECDSAAdd.Entrant.StairPacket.GateMirror
open ECDSAAdd.Entrant.StairPacket.Shadow
open ECDSAAdd.Entrant.StairPacket.Shadow20
open SkywalkNat IntegerHigh

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

/-! ### Section 1: Tape Independence & `barrel20_roundtrip` -/

theorem run_basis_any20 (p : Program) : ∀ (m n : List Bool) (s s' : State), s.basis = s'.basis →
    (run p m s).basis = (run p n s').basis := by
  induction p with
  | nil => intro _ _ _ _ h; exact h
  | cons i p ih =>
    intro m n s s' h
    cases i <;> simp only [run, measureAndCorrect] <;> apply ih <;> simp [correct_basis, h]

theorem state_eq_of_phase_basis {a b : State} (hp : a.phase = b.phase) (hb : a.basis = b.basis) : a = b := by
  cases a; cases b; simp only at hp hb; subst hp hb; rfl

private theorem phase_step_any20 (P Q : Program) (s : State)
    (hP : ∀ t, (run P t s).phase = s.phase)
    (hPQ : ∀ t, (run (P ++ Q) t s).phase = s.phase) :
    ∀ m n, (run Q n (run P m s)).phase = (run P m s).phase := by
  intro m n
  have h1 : run P (m.take (measurementCount P) ++ List.replicate (measurementCount P - m.length) false) s = run P m s :=
    state_eq_of_phase_basis ((hP _).trans (hP m).symm) (run_basis_any20 P _ m s s rfl)
  let t0 := m.take (measurementCount P) ++ List.replicate (measurementCount P - m.length) false
  have hlen : t0.length = measurementCount P := by simp only [t0, List.length_append, List.length_take, List.length_replicate]; omega
  have hdrop : (t0 ++ n).drop (measurementCount P) = n := by rw [← hlen, List.drop_left]
  have htake : (t0 ++ n).take (measurementCount P) = t0 := by rw [← hlen, List.take_left]
  have hrun := hPQ (t0 ++ n)
  rw [run_append, htake, hdrop, h1] at hrun
  exact hrun.trans (hP m).symm

attribute [local irreducible] run barrel20 in
theorem barrel20_roundtrip (j : Fin 10) (slot : Fin 22) (v : Nat) (u : State) (m n : List Bool)
    (small : v < 2 ^ (liveW20 (start20 j) - (slot.val - 1)))
    (input : HighBankBarrel.holds (bankW20 (start20 j)) (liveW20 (start20 j))
      (v <<< CRTBarrel20.entryShift false slot.val) u)
    (tag : ∀ k < 21, u.basis (tagsP20.getD k 0) = decide (slot.val = k + 1))
    (scratch : ∀ k < 10, u.basis (poolW20 (start20 j) (22 + k)) = false) :
    run (barrel20 (start20 j) true) n (run (barrel20 (start20 j) false) m u) = u := by
  have hg := geom20_facts j; dsimp only at hg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hf := barrel20_result j false slot v u m small input tag scratch
  have htag_out : ∀ k < 21, HighBankBarrel.outside (bankW20 (start20 j)) (liveW20 (start20 j)) (tagsP20.getD k 0) := by
    intro k hk i hi e
    have tr := tagsP20_getD_range hk
    rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
      (rw [eb] at e; unfold Wire at *; omega)
  have hscr_out : ∀ k < 10, HighBankBarrel.outside (bankW20 (start20 j)) (liveW20 (start20 j)) (poolW20 (start20 j) (22 + k)) := by
    intro k hk i hi e
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp] at e
    rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
      (rw [eb] at e; unfold Wire at *; omega)
  have hshift : CRTBarrel20.exitShift false slot.val = CRTBarrel20.entryShift true slot.val := by
    simp [CRTBarrel20.exitShift, CRTBarrel20.entryShift]
  have hshift0 : CRTBarrel20.exitShift true slot.val = CRTBarrel20.entryShift false slot.val := by
    simp [CRTBarrel20.exitShift, CRTBarrel20.entryShift]
  have hb := barrel20_result j true slot v (run (barrel20 (start20 j) false) m u) n small
    (hshift ▸ hf.bits)
    (fun k hk => (hf.frame _ (htag_out k hk)).trans (tag k hk))
    (fun k hk => (hf.frame _ (hscr_out k hk)).trans (scratch k hk))
  apply state_eq_of_phase_basis (hb.phase.trans hf.phase)
  funext q
  by_cases hmem : ∃ i < liveW20 (start20 j), bankW20 (start20 j) i = q
  · obtain ⟨i, hi, rfl⟩ := hmem
    rw [hb.bits i hi, hshift0, input i hi]
  · have hout : HighBankBarrel.outside (bankW20 (start20 j)) (liveW20 (start20 j)) q := fun i hi e => hmem ⟨i, hi, e.symm⟩
    exact (hb.frame q hout).trans (hf.frame q hout)

/-! ### Section 2: `bitCheck` Certificates for `leaveBefore20` & `leaveAfter20` -/

private def maskSubset (a b : Nat) : Bool := (a ||| b) == b

private theorem masked_of_subset {s : State} {a b : Nat} (hsub : maskSubset a b = true)
    (hb : Masked s b) : Masked s a := by
  intro q hq
  have heq : a ||| b = b := of_decide_eq_true hsub
  have htb : (a ||| b).testBit q = b.testBit q := congrArg (fun n : Nat => n.testBit q) heq
  rw [Nat.testBit_or, hq, Bool.true_or] at htb
  exact hb q htb.symm

private theorem testBit_one_shl (a q : Nat) : (1 <<< a).testBit q = decide (a = q) := by
  rw [Nat.testBit_shiftLeft]
  by_cases h : a ≤ q
  · by_cases he : a = q
    · subst he; simp
    · have hne : q - a ≠ 0 := by omega
      have hdiv : 1 / 2 ^ (q - a) = 0 := Nat.div_eq_of_lt (Nat.one_lt_two_pow hne)
      rw [decide_eq_true h, Bool.true_and, decide_eq_false he, Nat.testBit, Nat.shiftRight_eq_div_pow, hdiv]
      rfl
  · rw [decide_eq_false h, Bool.false_and]
    exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq, Bool.false_eq_true, false_iff]; omega)

private theorem testBit_interval (lo w q : Nat) :
    (GateMirror.interval lo w).testBit q = decide (lo ≤ q ∧ q < lo + w) := by
  unfold GateMirror.interval
  rw [Nat.testBit_shiftLeft]
  by_cases h1 : lo ≤ q
  · simp only [decide_eq_true h1, Bool.true_and, Nat.testBit_two_pow_sub_one, ge_iff_le]
    exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; omega)
  · simp only [decide_eq_false h1, Bool.false_and]
    exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq, Bool.false_eq_true, false_iff, not_and]; omega)

private def checkMask (gs : List Gate) (post allow : Nat) : Bool :=
  match bitCheck gs post with
  | some pre => maskSubset pre allow
  | none => false

private theorem ready_of_checkMask (gs : List Gate) (s : State) (post allow : Nat)
    (hc : checkMask gs post allow = true) (hallow : Masked s allow) :
    Ready s gs ∧ Masked (run (GateMirror.forward gs) [] s) post := by
  unfold checkMask at hc
  cases hx : bitCheck gs post with
  | none => simp [hx] at hc
  | some pre =>
    simp only [hx] at hc
    have hs := bit_sound gs s pre post hx (masked_of_subset hc hallow)
    exact ⟨hs.2.1, hs.2.2⟩

