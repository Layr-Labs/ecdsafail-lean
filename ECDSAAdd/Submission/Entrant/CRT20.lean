      simp only [run, measureAndCorrect, ECDSAAdd.correct, writeBit,
        Function.update_of_ne nes58, Function.update_self, h1, List.headD_nil, Bool.false_eq_true, ↓reduceIte,
        Bool.false_and, Bool.xor_false]
      apply congrArg (State.mk s.phase); funext q
      by_cases eq : q = 1558
      · subst eq; simp [Function.update_self]
      · simp [Function.update_of_ne eq]
    | cons b bs =>
      cases b
      · simp only [run, measureAndCorrect, ECDSAAdd.correct,
          writeBit, Function.update_of_ne nes58, Function.update_self, h1, List.headD_cons, Bool.false_eq_true, ↓reduceIte,
          Bool.false_and, Bool.xor_false]
        apply congrArg (State.mk s.phase); funext q
        by_cases eq : q = 1558
        · subst eq; simp [Function.update_self]
        · simp [Function.update_of_ne eq]
      · simp only [run, measureAndCorrect, ECDSAAdd.correct,
          writeBit, Function.update_of_ne nes58, Function.update_self, Function.update_of_ne nef58,
          Function.update_of_ne ne5758, h1, List.headD_cons, ↓reduceIte, Bool.true_and]
        have hph : (s.phase ^^ (s.basis (e0P20 (start20 j) + 3) && s.basis 1557) ^^
