def program (d : Bool) : Program := renameProgram (OB5.sig 425) (Rolling1588.packAtTick d 415)
def reverse (d : Bool) : Program := renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick d 415)
def history (q : Fin 10) : Wire := OB5.sig 425 (History5.historyMap base 410 q)

def stepFwd425 (d : Bool) : Program := if d then EndOrient425.physP else EndTick425.physP
def stepRev425 (d : Bool) : Program := if d then EndOrient425.physP else EndTick425.physQ

def endSlice425 (d : Bool) : Program := stepFwd425 d ++ (program d ++ Shadow7.exitLoadP 425 d)
def endUndo425 (d : Bool) : Program := Shadow7.exitRestoreP 425 d ++ (reverse d ++ stepRev425 d)

def lastWindow425 (d : Bool) : Program := parkP425 ++ (Shadow7.portalInvP 425 ++ endSlice425 d)
def lastUnwind425 (d : Bool) : Program := endUndo425 d ++ (Shadow7.portalP 425 ++ parkInvP425)

theorem histInj : Function.Injective history := by
  have hnd : ((List.finRange 10).map history).Nodup := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro a b hab
  have heq : ((List.finRange 10).map history)[a.val]'(by simp) = ((List.finRange 10).map history)[b.val]'(by simp) := by
    simpa using hab
  exact Fin.ext ((List.Nodup.getElem_inj_iff hnd).mp heq)

theorem equals (d : Bool) :
    program d = Rolling1588.codeEncodeAt d history ∧
    reverse d = Rolling1588.codeDecodeAt d history := by
  have labEq : ∀ q ∈ Finset.range 10,
      (OB5.sig 425 ∘ MeasuredCodec5.label (History5.historyMap base 410)) q =
        MeasuredCodec5.label history q := by
    intro q hq; have lt := Finset.mem_range.mp hq
    simp only [Function.comp, MeasuredCodec5.label, dif_pos lt, history]
  refine ⟨?_, ?_⟩
  · unfold program Rolling1588.packAtTick Rolling1588.codeEncodeAt
    rw [if_neg (by decide : (415 : Nat) ≠ 5)]
    simp only [show History5.packDue 415 = true by decide, ↓reduceIte, renameProgram_comp]
    exact renameProgram_congr_support _ _ _ (fun q hq => labEq q ((Rolling1588.code_support d).1 ▸ hq))
  · unfold reverse Rolling1588.unpackAtTick Rolling1588.codeDecodeAt
    rw [if_neg (by decide : (415 : Nat) ≠ 5)]
    simp only [show History5.packDue 415 = true by decide, ↓reduceIte, renameProgram_comp]
    exact renameProgram_congr_support _ _ _ (fun q hq => labEq q ((Rolling1588.code_support d).2 ▸ hq))

theorem source_law (d : Bool) (s : State) (m : List Bool) (ok : MeasuredCodec5.legalAt history s.basis) :
    (run (program d) m s).phase = s.phase ∧ ∀ t, run (reverse d) t (run (program d) m s) = s := by
  rw [(equals d).1, (equals d).2]
  exact ⟨(Rolling1588.codeEncodeAt_correct d history histInj s m ok).1,
    fun t => Rolling1588.codeRoundtripAt d history histInj s m t ok⟩

theorem pack_support (d : Bool) : wires (program d) ⊆ ((List.finRange 10).map history).toFinset := by
  rw [(equals d).1, Rolling1588.codeEncodeAt, renameProgram_support, (Rolling1588.code_support d).1]
  intro q hq
  obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
  have lt := Finset.mem_range.mp hw
  simp only [MeasuredCodec5.label, dif_pos lt, List.mem_toFinset, List.mem_map, List.mem_finRange, true_and]
  exact ⟨⟨w, lt⟩, rfl⟩

theorem outside (d : Bool) (q : Wire) (no : ∀ v : Fin 10, q ≠ history v) (m : List Bool) (s : State) :
    (run (program d) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro mem
  obtain ⟨v, _, eq⟩ := List.mem_map.mp (List.mem_toFinset.mp (pack_support d mem))
  exact no v eq.symm

private theorem exit425_hist_geom_ok1 :
    (∀ r : Fin 5,
      history ⟨2 * r.val, by omega⟩ = windowNet15E sourceIdx425 (ports (shape15E sourceIdx425) r).a0 ∧
      history ⟨2 * r.val + 1, by omega⟩ = windowNet15E sourceIdx425 (ports (shape15E sourceIdx425) r).history) := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

private theorem exit425_hist_geom_ok2 :
    let lw := EndTick425.L.wires
    (List.finRange 10).all (fun i =>
      let w := history i
      decide (OB5.sig 425 w ∉ lw) || decide (w = 440)) = true := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

private theorem exit425_hist_geom_ok3 :
    let hw := (List.finRange 10).map history
    (List.finRange 157).all (fun q =>
      let rq := rawPorts q
      hw.all (fun w => decide (rq ≠ w))) = true := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem exit425_hist_geom :
    (∀ r : Fin 5,
      history ⟨2 * r.val, by omega⟩ = windowNet15E sourceIdx425 (ports (shape15E sourceIdx425) r).a0 ∧
      history ⟨2 * r.val + 1, by omega⟩ = windowNet15E sourceIdx425 (ports (shape15E sourceIdx425) r).history) ∧
    (∀ i : Fin 10, EndOrient425.readOnly (history i) ∧ EndTick425.readOnly (history i)) ∧
    (∀ q : Fin 157, ∀ v : Fin 10, rawPorts q ≠ history v) := by
  refine ⟨exit425_hist_geom_ok1, fun i => ⟨EndOrient425.hist_readOnly i, ?_⟩, fun q v => ?_⟩
  · have h := List.all_eq_true.mp exit425_hist_geom_ok2 i (List.mem_finRange i)
    simp only [Bool.or_eq_true, decide_eq_true_eq] at h
    exact h
  · have hq := List.all_eq_true.mp exit425_hist_geom_ok3 q (List.mem_finRange q)
    have hv := List.all_eq_true.mp hq (history v) (List.mem_map.mpr ⟨v, List.mem_finRange v, rfl⟩)
    exact of_decide_eq_true hv

structure Transition425 (inverse : Program) (s tick : State) : Prop where
  phase : tick.phase = s.phase
  keptFive : ∀ i, tick.basis (history i) = s.basis (history i)
  keptBank : ∀ i : Fin 23, tick.basis (rawPorts ⟨i, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩) =
    s.basis (rawPorts ⟨i, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩)
  scratch : ∀ i : Fin 157, 23 ≤ i.val → tick.basis (rawPorts i) = false
  undo : ∀ n, run inverse n tick = s

theorem observe_orient (raw tags : State) (m : List Bool)
    (hscr : ∀ i : Fin 157, 23 ≤ i.val → (ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)).basis (rawPorts i) = false) :
    let start := ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)
    Transition425 EndOrient425.physP start (run EndOrient425.physP m start) := by
  let s := ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)
  refine ⟨EndOrient425.zero_phase s m,
    fun i => EndOrient425.observes _ (exit425_hist_geom.2.1 i).1 s m,
    fun i => EndOrient425.observes _ (EndOrient425.bank_readOnly i) s m,
    fun i hi => (run_preserves_outside _ m s _ (EndOrient425.scratch_off i hi)).trans (hscr i hi),
    fun n => EndOrient425.self_inverse s m n⟩

theorem observe_tick (d : Bool) (x : Nat) (hx0 : 0 < x) (hx : x < p) (raw original tags : State)
    (read : EndTick425.Reads raw original) (stage : Rolling1588.Integer.Stage base d x p 425 original.basis)
    (hist : raw.basis (base (1028 + 425)) = false) (swapSlot : raw.basis (base (2053 - 425)) = false)
    (hosts : ∀ k : Fin 134, 512 ≤ k.val + 425 → raw.basis (790 + k.val) = false) (m : List Bool) :
    let start := ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)
    Transition425 EndTick425.physQ start (run EndTick425.physP m start) := by
  let s := ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)
  have h := EndTick425.exposed d x hx0 hx raw original tags read stage hist swapSlot hosts m
  have u := (EndTick425.physical d x hx0 hx raw original tags read stage hist swapSlot m).2
  exact ⟨h.1, fun i => EndTick425.observes _ (exit425_hist_geom.2.1 i).2 s m h.2.1,
    fun i => EndTick425.observes _ (EndTick425.oldBank i) s m h.2.1, h.2.2, u⟩

