  · simp only [writeBit, Function.update_self, Function.update_of_ne ne5758]
    rw [show Function.update s.basis 1558 false = writeBit s.basis 1558 false from rfl, hpar, h57, Bool.xor_self]
  · simp [writeBit, Function.update_of_ne ne5758.symm, Function.update_self]
  · intro q h1 h2; simp [writeBit, Function.update_of_ne h1, Function.update_of_ne h2]

