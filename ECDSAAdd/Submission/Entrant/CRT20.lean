private theorem step425_cov (d : Bool) :
    WindowCovered.CoveredW (NativePack425.stepFwd425 d) ∧ WindowCovered.CoveredW (NativePack425.stepRev425 d) := by
  cases d
  · have hsup := EndTick425.supports
    have hren : ∀ R : Program, wires R ⊆ EndTick425.L.wires.toFinset →
        WindowCovered.CoveredW (renameProgram (OB5.sig 425) R) := by
      intro R hR q hq
      rw [renameProgram_support] at hq
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
      exact List.all_eq_true.mp endTick425_L_dom x (List.mem_toFinset.mp (hR hx))
    exact ⟨hren _ hsup.1, hren _ hsup.2⟩
  · exact ⟨EndOrient425.cov, EndOrient425.cov⟩

private theorem packW_cov425 (d : Bool) (s t : Nat) (lo : 45 ≤ t) (ts : t ≤ s) (hi : s ≤ 425) (t5 : t % 5 = 0) :
    WindowCovered.CoveredW (packW d s t) ∧ WindowCovered.CoveredW (unpackW d s t) := by
  have due : History5.packDue t = true := by simp only [History5.packDue, decide_eq_true_eq]; omega
  have c := WindowCovered.pack_cells d t (by omega) due
  constructor
  · intro q hq; rw [packW, renameProgram_support] at hq; obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
    obtain ⟨r, r1, r2, e⟩ := c.1 x hx
    rw [WindowCovered.dom_iff]; unfold OB5.sig
    rcases e with rfl | rfl <;> simp only [base, Wire] <;> split <;> omega
  · intro q hq; rw [unpackW, renameProgram_support] at hq; obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
    obtain ⟨r, r1, r2, e⟩ := c.2 x hx
    rw [WindowCovered.dom_iff]; unfold OB5.sig
    rcases e with rfl | rfl <;> simp only [base, Wire] <;> split <;> omega

