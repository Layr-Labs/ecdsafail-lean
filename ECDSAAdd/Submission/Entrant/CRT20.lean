theorem return_pending (j : Fin 4) (raw pre : State) (z : SkywalkNat.State) (G S : Bool) (m n : List Bool)
    (small : Shadow7.SmallIfFar (h15E j) 15 z)
    (cut : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (h15E j) 15 z))
      (decide (Shadow.far (h15E j) 15 z ∧ 2 ^ h15E j ≤ z.u))
      (pullState (pull j) raw) (eraseSites (pending j) pre))
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    run (enterInvP15E j) n (run (enterP15E j) m pre) = pre := by
  have avoidInv : ∀ q ∈ pending j, q ∉ wires (enterInvP15E j) := by
    intro q hq hw
    rw [enterInvP15E, renameProgram_support] at hw
    obtain ⟨w, hw', rfl⟩ := Finset.mem_image.mp hw
    have lim : wires EnterProof17.backward ⊆ Finset.range 13 := enter17_bwd_sub
    have lt : w < (ports j).length := Finset.mem_range.mp (lim hw')
    have hp : map j w ∈ ports j := by
      rw [map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem lt, Option.getD_some]
      exact List.getElem_mem lt
    have r := portsRegion j hp
    have f := frame j
    simp only [pending, List.mem_cons, List.not_mem_nil, or_false, Wire] at hq r ⊢
    omega
  have eqF := erase_run (pending j) (enterP15E j) (avoid_enter j) m pre
  have eqB := erase_run (pending j) (enterInvP15E j) avoidInv n (run (enterP15E j) m pre)
  have rt := return_packed j raw (eraseSites (pending j) pre) z G S m n small cut input
  rw [eqF, eqB] at rt
  apply state_eq
  · simpa [eraseSites] using congrArg State.phase rt
  · intro q
    by_cases hp : q ∈ pending j
    · exact (run_preserves_outside _ n _ q (avoidInv q hp)).trans
        (run_preserves_outside _ m _ q (avoid_enter j q hp))
    · have h1 := congrArg (fun st : State => st.basis q) rt
      simpa only [eraseSites, hp, if_false] using h1

