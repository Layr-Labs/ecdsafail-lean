  odd : z.v % 2 = 1
  room : Shadow.high (sbP20 (start20 j)) 20 z + 1 < 2 ^ wpP20 (start20 j)
  adjTight : Shadow.high (sbP20 (start20 j)) 20 z + 1 < 2 ^ adjW20 (start20 j)
  nextFarSmall : Shadow7.SmallIfFar (nextSb20 (start20 j)) (nextLen20 j) (step^[20] z)
