    have hfwd (m : List Bool) : run (GateMirror.forward (leaveAdjustCore20Short (start20 j))) m uPre =
        run (GateMirror.forward (leaveAdjustCore20 (start20 j))) [] uPre := by
      have hf1 : GateMirror.forward (leaveAdjustCore20Short (start20 j)) =
          HighBankAdjust.adjust ys' cs' (e0P20 (start20 j) + 3) 1601 := by
        simp only [leaveAdjustCore20Short, forward_adjustG, ys', cs']
      have hf2 : GateMirror.forward (leaveAdjustCore20 (start20 j)) =
          HighBankAdjust.adjust (ys' ++ [ytop]) (cs' ++ [ctop]) (e0P20 (start20 j) + 3) 1601 := by
        rw [← hys_eq, ← hcs_eq]; simp only [leaveAdjustCore20, forward_adjustG, ys20, carries20]
      rw [hf1, hf2]
      exact TruncatedAdjust.adjust_eq ys' cs' ytop ctop (e0P20 (start20 j) + 3) 1601
        nd_full nd_short habs (by simp [ys', cs']; omega) uPre m (hcs_eq ▸ hcar_uPre) hsmall hpos_cin
    have hphys' : Proper (leaveAdjustCore20Short (start20 j)) := fun g hg =>
      vCore.physical g (leaveAdjustCore20Short_mem (start20 j) hw2 g hg)
    have hclean' : ∀ q ∈ cs', uPre.basis q = false := fun q hq => hcar_uPre q (hcs_eq ▸ List.mem_append_left _ hq)
    have hready' : Ready uPre (leaveAdjustCore20Short (start20 j)) := by
      have hdisj : ∀ c ∈ cs', c ∉ ys' := fun c hc hy =>
        (List.nodup_append'.mp (List.nodup_cons.mp nd_short).2).2.2 hy hc
      have hcs_nd : cs'.Nodup := (List.nodup_append'.mp (List.nodup_cons.mp nd_short).2).2.1
      exact TruncatedAdjust.ready_adjustG ys' cs' (e0P20 (start20 j) + 3) 1601 uPre
        (by simp [ys', cs']; omega) hcs_nd hdisj hclean'
    have hprep' : Prepared uPre (leaveAdjustCore20Short (start20 j)) := by
      apply all_prepared _ uPre hphys'
      intro t
      rw [hfwd t]
      have hf2 : GateMirror.forward (leaveAdjustCore20 (start20 j)) =
          HighBankAdjust.adjust (ys20 j) (carries20 j) (e0P20 (start20 j) + 3) 1601 := by
        simp only [leaveAdjustCore20, forward_adjustG, ys20, carries20]
      rw [hf2]
      exact (HighBankAdjust.correct (ys20 j) (carries20 j) (e0P20 (start20 j) + 3) 1601
        (middle20_adjust_nodup j) (hys_eq ▸ habs)
        (by simp [ys20, carries20]; omega) uPre [] hcar_uPre).1
    refine ⟨hfwd, fun n => ?_⟩
    rw [← hfwd []]
    exact invert (leaveAdjustCore20Short (start20 j)) uPre hphys' hprep' hready' [] n
  · have heq : leaveAdjustCore20Short (start20 j) = leaveAdjustCore20 (start20 j) := by
