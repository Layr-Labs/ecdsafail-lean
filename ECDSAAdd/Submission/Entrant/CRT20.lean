/-! ### Section 2: Trailing 15-tick archives (`j : Fin 3`, closing `365→380`, `380→395`, `395→410`) -/

def archScratch15E (t e0 k : Nat) : Wire :=
  let w := if 1556 + k < e0 then 1556 + k else 1566 + k
  if w + t < 2068 then w else bTopP t + 4 + (w + t - 2068)

def loadPorts15E (j : Fin 3) : List Wire :=
  let t := start15E ⟨j.val + 1, by omega⟩
  let e0 := e015E t
  cellsLoadP t ++ [e0 + 6, e0 + 7, e0 + 8] ++ (List.range 132).map (archScratch15E t e0)

def restorePorts15E (j : Fin 3) : List Wire :=
  let t := start15E ⟨j.val + 1, by omega⟩
  let e0 := e015E t
  cellsRestoreP t ++ (List.range 134).map (archScratch15E t e0)

def archiveLoadP15E (j : Fin 3) (d : Bool) : Program :=
  let t := start15E ⟨j.val + 1, by omega⟩
  renameProgram (fun q => (loadPorts15E j).getD q 0)
    (if d then ReducedWindowArchives.load0 else ReducedWindowArchives.load1) ++ moveLoadP t

def archiveRestoreP15E (j : Fin 3) (d : Bool) : Program :=
  let t := start15E ⟨j.val + 1, by omega⟩
  renameProgram (fun q => (restorePorts15E j).getD q 0)
    (if d then ReducedWindowArchives.restore0 else ReducedWindowArchives.restore1) ++
    moveRestoreP t (e015E t + 6)

attribute [local irreducible] ReducedWindowArchives.load0 ReducedWindowArchives.load1
  ReducedWindowArchives.restore0 ReducedWindowArchives.restore1 in
theorem archive15E_counts (j : Fin 3) (d : Bool) :
    toffoliCount (archiveLoadP15E j d) = 41 ∧
    measurementCount (archiveLoadP15E j d) = (if d then 48 else 49) ∧
    toffoliCount (archiveRestoreP15E j d) = (if d then 50 else 51) ∧
    measurementCount (archiveRestoreP15E j d) = (if d then 43 else 44) := by
  obtain ⟨l1, l2, _, l4, l5, _⟩ := moves_counts (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩) + 6)
  obtain ⟨m1, m2, _, m4, m5, _⟩ := moves240_counts
  have r1 : ∀ (f : Wire → Wire) (p : Program), toffoliCount (renameProgram f p) = toffoliCount p :=
    fun f p => (renameProgram_counts f p).1
  have r2 : ∀ (f : Wire → Wire) (p : Program), measurementCount (renameProgram f p) = measurementCount p :=
    fun f p => (renameProgram_counts f p).2
  have hL : toffoliCount (archiveLoadP15E j d) = toffoliCount (archiveLoad240 d) ∧
      measurementCount (archiveLoadP15E j d) = measurementCount (archiveLoad240 d) := by
    simp only [archiveLoadP15E, archiveLoad240, toffoliCount_append, measurementCount_append,
      r1, r2, l1, l2, m1, m2, and_self]
  have hR : toffoliCount (archiveRestoreP15E j d) = toffoliCount (archiveRestore240 d) ∧
      measurementCount (archiveRestoreP15E j d) = measurementCount (archiveRestore240 d) := by
    simp only [archiveRestoreP15E, archiveRestore240, toffoliCount_append, measurementCount_append,
      r1, r2, l4, l5, m4, m5, and_self]
  cases d
  · exact ⟨hL.1.trans PartialCosts.part9.1, hL.2.trans PartialCosts.part9.2,
      hR.1.trans PartialCosts.part43.1, hR.2.trans PartialCosts.part43.2⟩
  · exact ⟨hL.1.trans PartialCosts.part25.1, hL.2.trans PartialCosts.part25.2,
      hR.1.trans PartialCosts.part57.1, hR.2.trans PartialCosts.part57.2⟩

def Band15E (t e0 q : Nat) : Prop :=
  q < bTopP t + 4 ∨ (934 ≤ q ∧ q < 1556) ∨ 2068 ≤ q + t ∨ (e0 ≤ q ∧ q < e0 + 10)

instance (t e0 q : Nat) : Decidable (Band15E t e0 q) := by unfold Band15E; infer_instance

private theorem arch15E_params (j : Fin 3) :
    let t := start15E ⟨j.val + 1, by omega⟩
    let e0 := e015E t
    380 ≤ t ∧ t ≤ 410 ∧ bTopP t = 1298 - t ∧ 1617 ≤ e0 ∧ e0 ≤ 1632 := by
  have h : ∀ k : Fin 3,
      let t := start15E ⟨k.val + 1, by omega⟩
      let e0 := e015E t
      380 ≤ t ∧ t ≤ 410 ∧ bTopP t = 1298 - t ∧ 1617 ≤ e0 ∧ e0 ≤ 1632 := by
    decide +kernel
  exact h j

private theorem archScratch15E_inj (j : Fin 3) {a b : Nat} (ha : a < 134) (hb : b < 134)
    (e : archScratch15E (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩)) a =
         archScratch15E (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩)) b) :
    a = b := by
  obtain ⟨ht1, ht2, hbt, he1, he2⟩ := arch15E_params j
  unfold archScratch15E at e; dsimp only at e
  rw [hbt] at e
  split_ifs at e <;> (unfold Wire at *; omega)

private theorem archScratch15E_off (j : Fin 3) {k q : Nat} (hk : k < 134)
    (hb : Band15E (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩)) q) :
    archScratch15E (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩)) k ≠ q := by
  obtain ⟨ht1, ht2, hbt, he1, he2⟩ := arch15E_params j
  unfold archScratch15E; dsimp only
  unfold Band15E at hb
  rw [hbt] at hb ⊢
  rcases hb with h1 | ⟨h1, h2⟩ | h1 | ⟨h1, h2⟩ <;> split_ifs <;> (unfold Wire at *; omega)

private theorem archScratch15E_dom (j : Fin 3) {k : Nat} (hk : k < 134) :
    WindowCovered.domainW
      (archScratch15E (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩)) k) = true := by
  obtain ⟨ht1, ht2, hbt, he1, he2⟩ := arch15E_params j
  rw [WindowCovered.dom_iff]
  unfold archScratch15E; dsimp only
  rw [hbt]
  split_ifs <;> (unfold Wire at *; omega)

private theorem archHeads15E_ok : ∀ j : Fin 3,
    let t := start15E ⟨j.val + 1, by omega⟩
    let e0 := e015E t
    let headL := cellsLoadP t ++ [e0 + 6, e0 + 7, e0 + 8]
    let headR := cellsRestoreP t
    headL.length = 23 ∧ headL.Nodup ∧ headL.all WindowCovered.domainW = true ∧
    headL.all (fun q => decide (Band15E t e0 q)) = true ∧
    headR.length = 16 ∧ headR.Nodup ∧ headR.all WindowCovered.domainW = true ∧
    headR.all (fun q => decide (Band15E t e0 q)) = true ∧
    (swapsG (moveLoadPairs t)).all (fun g => proper g && g.wires.all WindowCovered.domainW) = true ∧
    (swapsG (moveRestorePairs t (e0 + 6))).all
      (fun g => proper g && g.wires.all WindowCovered.domainW) = true := by
  decide +kernel

private theorem archive15E_ports_ok (j : Fin 3) :
    (loadPorts15E j).length = 155 ∧ (loadPorts15E j).Nodup ∧
    (∀ q ∈ loadPorts15E j, WindowCovered.domainW q = true) ∧
    (restorePorts15E j).length = 150 ∧ (restorePorts15E j).Nodup ∧
    (∀ q ∈ restorePorts15E j, WindowCovered.domainW q = true) := by
  have hh := archHeads15E_ok j
  let t := start15E ⟨j.val + 1, by omega⟩
  let e0 := e015E t
  have hscr_nd : ∀ n, n ≤ 134 → ((List.range n).map (archScratch15E t e0)).Nodup := fun n hn =>
    List.Nodup.map_on (fun a ha b hb e =>
      archScratch15E_inj j (lt_of_lt_of_le (List.mem_range.mp ha) hn)
        (lt_of_lt_of_le (List.mem_range.mp hb) hn) e) List.nodup_range
  have hscr_dom : ∀ n, n ≤ 134 → ∀ q ∈ (List.range n).map (archScratch15E t e0),
      WindowCovered.domainW q = true := by
    intro n hn q hq
    obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hq
    exact archScratch15E_dom j (lt_of_lt_of_le (List.mem_range.mp hk) hn)
  have hdisj : ∀ (hd : List Wire) (n : Nat), n ≤ 134 →
      hd.all (fun q => decide (Band15E t e0 q)) = true →
      ∀ a ∈ hd, ∀ b ∈ (List.range n).map (archScratch15E t e0), a ≠ b := by
    intro hd n hn hall a ha b hb eq
    subst eq
    obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb
    exact archScratch15E_off j (lt_of_lt_of_le (List.mem_range.mp hk) hn)
      (of_decide_eq_true (List.all_eq_true.mp hall _ ha)) rfl
  refine ⟨by rw [loadPorts15E, List.length_append, hh.1]; simp, ?_, ?_,
    by rw [restorePorts15E, List.length_append, hh.2.2.2.2.1]; simp, ?_, ?_⟩
  · rw [loadPorts15E, List.nodup_append]
    exact ⟨hh.2.1, hscr_nd 132 (by decide), hdisj _ 132 (by decide) hh.2.2.2.1⟩
  · intro q hq; rw [loadPorts15E, List.mem_append] at hq
    rcases hq with hq | hq
    · exact List.all_eq_true.mp hh.2.2.1 q hq
    · exact hscr_dom 132 (by decide) q hq
  · rw [restorePorts15E, List.nodup_append]
    exact ⟨hh.2.2.2.2.2.1, hscr_nd 134 (by decide), hdisj _ 134 (by decide) hh.2.2.2.2.2.2.2.1⟩
  · intro q hq; rw [restorePorts15E, List.mem_append] at hq
    rcases hq with hq | hq
    · exact List.all_eq_true.mp hh.2.2.2.2.2.2.1 q hq
    · exact hscr_dom 134 (by decide) q hq

attribute [local irreducible] ReducedWindowArchives.load0 ReducedWindowArchives.load1
  ReducedWindowArchives.restore0 ReducedWindowArchives.restore1 in
theorem archive15E_phys (j : Fin 3) (d : Bool) :
    GatePhysical (archiveLoadP15E j d) ∧ GatePhysical (archiveRestoreP15E j d) := by
  have h := archive15E_ports_ok j
  have hh := archHeads15E_ok j
  exact ⟨WindowPhysicalW.appP (WindowPhysicalW.load_codec_phys _ h.2.1 h.1.ge d)
      (physical_of_proper _ (fun g hg => (Bool.and_eq_true_iff.mp (List.all_eq_true.mp hh.2.2.2.2.2.2.2.2.1 g hg)).1)).1,
    WindowPhysicalW.appP (WindowPhysicalW.restore_codec_phys _ h.2.2.2.2.1 h.2.2.2.1.ge d)
      (physical_of_proper _ (fun g hg => (Bool.and_eq_true_iff.mp (List.all_eq_true.mp hh.2.2.2.2.2.2.2.2.2 g hg)).1)).1⟩

attribute [local irreducible] ReducedWindowArchives.load0 ReducedWindowArchives.load1
  ReducedWindowArchives.restore0 ReducedWindowArchives.restore1 in
theorem archive15E_cov (j : Fin 3) (d : Bool) :
    WindowCovered.CoveredW (archiveLoadP15E j d) ∧ WindowCovered.CoveredW (archiveRestoreP15E j d) := by
  have h := archive15E_ports_ok j
  have hh := archHeads15E_ok j
  have hmvL : AllW (fun q => WindowCovered.domainW q = true) (swapsG (moveLoadPairs (start15E ⟨j.val + 1, by omega⟩))) :=
    fun g hg q hq => List.all_eq_true.mp (Bool.and_eq_true_iff.mp (List.all_eq_true.mp hh.2.2.2.2.2.2.2.2.1 g hg)).2 q hq
  have hmvR : AllW (fun q => WindowCovered.domainW q = true)
      (swapsG (moveRestorePairs (start15E ⟨j.val + 1, by omega⟩) (e015E (start15E ⟨j.val + 1, by omega⟩) + 6))) :=
    fun g hg q hq => List.all_eq_true.mp (Bool.and_eq_true_iff.mp (List.all_eq_true.mp hh.2.2.2.2.2.2.2.2.2 g hg)).2 q hq
  constructor
  · rw [archiveLoadP15E]
    refine WindowCovered.appW (fun q hq => ?_) (allW_programs hmvL).1
    rw [renameProgram_support] at hq
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hq
    have hplt : p < 155 := by cases d; exact Partial.load1_ports p hp; exact Partial.load0_ports p hp
    rw [List.getD_eq_getElem _ _ (by rw [h.1]; exact hplt)]
    exact h.2.2.1 _ (List.getElem_mem _)
  · rw [archiveRestoreP15E]
    refine WindowCovered.appW (fun q hq => ?_) (allW_programs hmvR).1
    rw [renameProgram_support] at hq
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hq
    have hplt : p < 150 := by cases d; exact Partial.restore1_ports p hp; exact Partial.restore0_ports p hp
    rw [List.getD_eq_getElem _ _ (by rw [h.2.2.2.1]; exact hplt)]
    exact h.2.2.2.2.2 _ (List.getElem_mem _)

namespace ArchiveJ15E

open ECDSAAdd.Entrant.StairArchiveIntegerHook
open ECDSAAdd.Entrant.CodecBitSliceVerify
open ECDSAAdd.Entrant.StairPacket.ArchiveJ

set_option maxRecDepth 30000
set_option maxHeartbeats 5000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def nextTick (j : Fin 3) : Nat := start15E ⟨j.val + 1, by omega⟩
def rawHead (j : Fin 3) : List Wire := cellsLoadP (nextTick j) ++ [e015E (nextTick j) + 6, e015E (nextTick j) + 7, e015E (nextTick j) + 8]
def scratch (j : Fin 3) : List Wire := (List.range 134).map (archScratch15E (nextTick j) (e015E (nextTick j)))
def rawPortsList (j : Fin 3) : List Wire := rawHead j ++ scratch j
def rawPorts (j : Fin 3) (i : Fin 157) : Wire := (rawPortsList j).getD i 0
def codeTail (j : Fin 3) : List Wire :=
  let t := nextTick j
  [2069 - (t - 8), 2069 - (t - 6), 2069 - (t - 3), 2069 - (t - 1),
   e015E t + 6, e015E t + 7, e015E t + 8]
def codePortsList (j : Fin 3) : List Wire :=
  cellsRestoreP (nextTick j) ++ scratch j ++ codeTail j
def codePorts (j : Fin 3) (i : Fin 157) : Wire := (codePortsList j).getD i 0
def loadMap (j : Fin 3) (q : Wire) : Wire := (loadPorts15E j).getD q 0
def restoreMap (j : Fin 3) (q : Wire) : Wire := (restorePorts15E j).getD q 0
def loadMoves (j : Fin 3) : List (Wire × Wire) := (moveLoadPairs (nextTick j)).map Prod.swap
def restoreMoves (j : Fin 3) : List (Wire × Wire) := (moveRestorePairs (nextTick j) (e015E (nextTick j) + 6)).map Prod.swap

theorem rawLength (j : Fin 3) : (rawPortsList j).length = 157 := by
  simp [rawPortsList, rawHead, scratch, cellsLoadP]

theorem codeLength (j : Fin 3) : (codePortsList j).length = 157 := by
  simp [codePortsList, scratch, cellsRestoreP, codeTail]

theorem raw_scratch (j : Fin 3) {k : Nat} (hk : k < 134) :
    (rawPortsList j).getD (23 + k) 0 = archScratch15E (nextTick j) (e015E (nextTick j)) k := by
  rw [rawPortsList, List.getD_append_right _ _ _ _ (by simp [rawHead, cellsLoadP]), scratch]
  have e : 23 + k - (rawHead j).length = k := by simp [rawHead, cellsLoadP]
  rw [e, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk]; rfl

theorem code_scratch (j : Fin 3) {k : Nat} (hk : k < 134) :
    (codePortsList j).getD (16 + k) 0 = archScratch15E (nextTick j) (e015E (nextTick j)) k := by
  rw [codePortsList, List.append_assoc, List.getD_append_right _ _ _ _ (by simp [cellsRestoreP])]
  have e : 16 + k - (cellsRestoreP (nextTick j)).length = k := by simp [cellsRestoreP]
  rw [e, List.getD_append _ _ _ _ (by simp [scratch]; exact hk), scratch,
    List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk]; rfl

private theorem heads_all : ∀ j : Fin 3,
    (rawHead j).Nodup ∧ (∀ q ∈ rawHead j, Band15E (nextTick j) (e015E (nextTick j)) q) ∧
    (cellsRestoreP (nextTick j) ++ codeTail j).Nodup ∧
    (∀ q ∈ cellsRestoreP (nextTick j) ++ codeTail j, Band15E (nextTick j) (e015E (nextTick j)) q) ∧
    (∀ q ∈ cellsRestoreP (nextTick j) ++ codeTail j, q ∈ rawHead j) ∧
    (∀ p ∈ loadMoves j, p.1 ∈ rawHead j ∧ p.2 ∈ rawHead j ∧ p.1 ≠ p.2) ∧
    (∀ p ∈ restoreMoves j, p.1 ≠ p.2 ∧
      (p.1 ∈ cellsRestoreP (nextTick j) ++ codeTail j ∨ ∃ c < 7, p.1 = archScratch15E (nextTick j) (e015E (nextTick j)) c) ∧
      (p.2 ∈ cellsRestoreP (nextTick j) ++ codeTail j ∨ ∃ c < 7, p.2 = archScratch15E (nextTick j) (e015E (nextTick j)) c)) := by
  decide +kernel

private theorem routes_head_all : ∀ j : Fin 3, ∀ k : Fin 157,
    ((k.val < 16 ∨ 150 ≤ k.val) → backMap (loadMoves j) (codePorts j k) = rawPorts j (loadRoute k)) ∧
    (k.val < 30 → backMap (restoreMoves j) (rawPorts j k) = codePorts j (restoreRoute k)) := by
  decide +kernel

theorem scratch_nodup (j : Fin 3) : (scratch j).Nodup :=
  List.Nodup.map_on (fun _ ha _ hb h =>
    archScratch15E_inj j (List.mem_range.mp ha) (List.mem_range.mp hb) h) List.nodup_range

theorem rawNodup (j : Fin 3) : (rawPortsList j).Nodup := by
  obtain ⟨hn, hb, -⟩ := heads_all j
  rw [rawPortsList, List.nodup_append]
  refine ⟨hn, scratch_nodup j, fun a ha b hb' eq => ?_⟩
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb'
  exact archScratch15E_off j (List.mem_range.mp hk) (hb a ha) eq.symm

theorem codeNodup (j : Fin 3) : (codePortsList j).Nodup := by
  obtain ⟨-, -, hn, hb, -⟩ := heads_all j
  rw [codePortsList, List.nodup_append, List.nodup_append]
  rw [List.nodup_append] at hn
  refine ⟨⟨hn.1, scratch_nodup j, fun a ha b hb' eq => ?_⟩, hn.2.1, fun a ha b hb' eq => ?_⟩
  · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb'
    exact archScratch15E_off j (List.mem_range.mp hk) (hb a (List.mem_append_left _ ha)) eq.symm
  · rcases List.mem_append.mp ha with ha | ha
    · exact hn.2.2 a ha b hb' eq
    · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp ha
      exact archScratch15E_off j (List.mem_range.mp hk) (hb b (List.mem_append_right _ hb')) eq

theorem load_unique (j : Fin 3) : Function.Injective (rawPorts j) :=
  injective_list (rawPortsList j) (rawLength j) (rawNodup j)

theorem restore_unique (j : Fin 3) : Function.Injective (codePorts j) :=
  injective_list (codePortsList j) (codeLength j) (codeNodup j)

private theorem raw_mem_fin (j : Fin 3) {q : Wire} (h : q ∈ rawPortsList j) :
    ∃ k : Fin 157, rawPorts j k = q := by
  obtain ⟨idx, hlt, rfl⟩ := List.getElem_of_mem h
  refine ⟨⟨idx, (rawLength j) ▸ hlt⟩, ?_⟩
  simp only [rawPorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlt, Option.getD_some]

private theorem code_mem_fin (j : Fin 3) {q : Wire} (h : q ∈ codePortsList j) :
    ∃ k : Fin 157, codePorts j k = q := by
  obtain ⟨idx, hlt, rfl⟩ := List.getElem_of_mem h
  refine ⟨⟨idx, (codeLength j) ▸ hlt⟩, ?_⟩
  simp only [codePorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlt, Option.getD_some]

theorem load_map (j : Fin 3) (q : Fin 155) : loadMap j q = rawPorts j ⟨q, by omega⟩ := by
  have hsplit : rawPortsList j = loadPorts15E j ++
      [archScratch15E (nextTick j) (e015E (nextTick j)) 132,
       archScratch15E (nextTick j) (e015E (nextTick j)) 133] := by
    simp only [rawPortsList, loadPorts15E, rawHead, scratch, nextTick, List.append_assoc]
    rw [show (134 : Nat) = 132 + 2 by decide, List.range_add, List.map_append]
    rfl
  simp only [loadMap, rawPorts, hsplit]
  rw [List.getD_append _ _ _ _ (by simp [loadPorts15E, cellsLoadP])]

theorem restore_map (j : Fin 3) (q : Fin 150) : restoreMap j q = codePorts j ⟨q, by omega⟩ := by
  change (restorePorts15E j).getD q 0 = (restorePorts15E j ++ codeTail j).getD q 0
  rw [List.getD_append _ _ _ _ (by simp [restorePorts15E, cellsRestoreP])]

theorem load_route (j : Fin 3) : ∀ k, backMap (loadMoves j) (codePorts j k) = rawPorts j (loadRoute k) := by
  intro k
  by_cases h : k.val < 16 ∨ 150 ≤ k.val
  · exact (routes_head_all j k).1 h
  · have m := (routes_mid k).1 (by omega) (by omega)
    have hc : codePorts j k = archScratch15E (nextTick j) (e015E (nextTick j)) (k.val - 16) := by
      have e := code_scratch j (k := k.val - 16) (by omega); rw [show 16 + (k.val - 16) = k.val by omega] at e; exact e
    have hr : rawPorts j (loadRoute k) = archScratch15E (nextTick j) (e015E (nextTick j)) (k.val - 16) := by
      have e := raw_scratch j (k := k.val - 16) (by omega); rw [show 23 + (k.val - 16) = k.val + 7 by omega, ← m] at e; exact e
    rw [hc, hr]
    apply backMap_outside
    intro p hp
    obtain ⟨h1, h2, -⟩ := (heads_all j).2.2.2.2.2.1 p hp
    have b := (heads_all j).2.1
    exact ⟨archScratch15E_off j (by omega) (b _ h1), archScratch15E_off j (by omega) (b _ h2)⟩

theorem restore_route (j : Fin 3) : ∀ k, backMap (restoreMoves j) (rawPorts j k) = codePorts j (restoreRoute k) := by
  intro k
  by_cases h : k.val < 30
  · exact (routes_head_all j k).2 h
  · have m := (routes_mid k).2 (by omega)
    have hr : rawPorts j k = archScratch15E (nextTick j) (e015E (nextTick j)) (k.val - 23) := by
      have e := raw_scratch j (k := k.val - 23) (by omega); rw [show 23 + (k.val - 23) = k.val by omega] at e; exact e
    have hc : codePorts j (restoreRoute k) = archScratch15E (nextTick j) (e015E (nextTick j)) (k.val - 23) := by
      have e := code_scratch j (k := k.val - 23) (by omega); rw [show 16 + (k.val - 23) = (restoreRoute k).val by omega] at e; exact e
    rw [hr, hc]
    apply backMap_outside
    intro p hp
    obtain ⟨-, h1, h2⟩ := (heads_all j).2.2.2.2.2.2 p hp
    have b := (heads_all j).2.2.2.1
    have off (q : Wire) (hq : q ∈ cellsRestoreP (nextTick j) ++ codeTail j ∨
        ∃ c < 7, q = archScratch15E (nextTick j) (e015E (nextTick j)) c) :
        archScratch15E (nextTick j) (e015E (nextTick j)) (k.val - 23) ≠ q := by
      rcases hq with hq | ⟨c, hc, rfl⟩
      · exact archScratch15E_off j (by omega) (b _ hq)
      · intro eq; have := archScratch15E_inj j (by omega) (by omega) eq; omega
    exact ⟨off _ h1, off _ h2⟩

theorem load_scope (j : Fin 3) : ∀ p ∈ loadMoves j, (∃ i, rawPorts j i = p.1) ∧ (∃ i, rawPorts j i = p.2) := by
  intro p hp
  obtain ⟨h1, h2, -⟩ := (heads_all j).2.2.2.2.2.1 p hp
  exact ⟨raw_mem_fin j (List.mem_append_left _ h1), raw_mem_fin j (List.mem_append_left _ h2)⟩

theorem restore_scope (j : Fin 3) : ∀ p ∈ restoreMoves j, (∃ i, codePorts j i = p.1) ∧ (∃ i, codePorts j i = p.2) := by
  intro p hp
  obtain ⟨-, h1, h2⟩ := (heads_all j).2.2.2.2.2.2 p hp
  have mem (q : Wire) (hq : q ∈ cellsRestoreP (nextTick j) ++ codeTail j ∨
      ∃ c < 7, q = archScratch15E (nextTick j) (e015E (nextTick j)) c) :
      q ∈ codePortsList j := by
    rw [codePortsList]
    rcases hq with hq | ⟨c, hc, rfl⟩
    · rcases List.mem_append.mp hq with hq | hq
      · exact List.mem_append_left _ (List.mem_append_left _ hq)
      · exact List.mem_append_right _ hq
    · exact List.mem_append_left _ (List.mem_append_right _ (List.mem_map.mpr ⟨c, List.mem_range.mpr (by omega), rfl⟩))
  exact ⟨code_mem_fin j (mem _ h1), code_mem_fin j (mem _ h2)⟩

private theorem code_from_raw (j : Fin 3) (i : Fin 157) : ∃ k : Fin 157, rawPorts j k = codePorts j i := by
  have hi : i.val < (codePortsList j).length := (codeLength j).symm ▸ i.isLt
  have hmem : codePorts j i ∈ codePortsList j := by
    simp only [codePorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some]
    exact List.getElem_mem hi
  have sub := (heads_all j).2.2.2.2.1
  apply raw_mem_fin j
  rw [rawPortsList]
  rw [codePortsList] at hmem
  rcases List.mem_append.mp hmem with h1 | h2
  · rcases List.mem_append.mp h1 with h1a | h1b
    · exact List.mem_append_left _ (sub _ (List.mem_append_left _ h1a))
    · exact List.mem_append_right _ h1b
  · exact List.mem_append_left _ (sub _ (List.mem_append_right _ h2))

theorem load_program (j : Fin 3) (d : Bool) :
    archiveLoadP15E j d = placed (loadMap j) (op true d) ++
      moves (loadMoves j) := by
  cases d <;> rfl

theorem restore_program (j : Fin 3) (d : Bool) :
    archiveRestoreP15E j d = placed (restoreMap j) (op false d) ++
      moves (restoreMoves j) := by
  cases d <;> rfl

theorem load_run (j : Fin 3) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame (rawPorts j) (startCols true d) row s) :
    let t := run (archiveLoadP15E j d) m s
    t.phase = s.phase ∧ Frame (codePorts j) (endCols true d) row t ∧
    ∀ q, (∀ i, rawPorts j i ≠ q) → t.basis q = s.basis q := by
  rw [load_program]
  apply packet true d (rawPorts j) (codePorts j) (loadMap j) (loadMoves j)
    ArchiveJ.loadRoute (load_unique j) _ (fun p hp => ((heads_all j).2.2.2.2.2.1 p hp).2.2)
    (load_route j) ArchiveJ.load_sort (load_scope j) row hr s m ready
  intro q h
  have lim : q < 155 := by cases d <;> exact h
  exact ⟨⟨q, by omega⟩, rfl, load_map j ⟨q, lim⟩⟩

theorem restore_run (j : Fin 3) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame (codePorts j) (startCols false d) row s) :
    let t := run (archiveRestoreP15E j d) m s
    t.phase = s.phase ∧ Frame (rawPorts j) (endCols false d) row t ∧
    ∀ q, (∀ i, codePorts j i ≠ q) → t.basis q = s.basis q := by
  rw [restore_program]
  apply packet false d (codePorts j) (rawPorts j) (restoreMap j) (restoreMoves j)
    ArchiveJ.restoreRoute (restore_unique j) _ (fun p hp => ((heads_all j).2.2.2.2.2.2 p hp).1)
    (restore_route j) ArchiveJ.restore_sort (restore_scope j) row hr s m ready
  intro q h
  have lim : q < 150 := by cases d <;> exact h
  exact ⟨⟨q, by omega⟩, rfl, restore_map j ⟨q, lim⟩⟩

theorem roundtrip (j : Fin 3) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m n : List Bool)
    (ready : Frame (rawPorts j) raw row s) :
    run (archiveRestoreP15E j d) n (run (archiveLoadP15E j d) m s) = s := by
  have f := load_run j d row hr s m ready
  have b := restore_run j d row hr _ n f.2.1
  apply state_eq
  · exact b.1.trans f.1
  · intro q
    by_cases h : ∃ i, rawPorts j i = q
    · obtain ⟨i, rfl⟩ := h
      exact (b.2.1 i).trans (ready i).symm
    · have no : ∀ i, rawPorts j i ≠ q := fun i eq => h ⟨i, eq⟩
      have noc : ∀ i, codePorts j i ≠ q := by
        intro i; obtain ⟨k, eq⟩ := code_from_raw j i
        exact eq ▸ no k
      exact (b.2.2 q noc).trans (f.2.2 q no)

theorem head_port_eq (j : Fin 3) (i : Fin 16) :
    codePorts j ⟨i.val, by omega⟩ = (cellsRestoreP (nextTick j)).getD i 0 := by
  rw [codePorts, codePortsList, List.append_assoc,
    List.getD_append _ _ _ _ (by simp [cellsRestoreP])]

end ArchiveJ15E

end ECDSAAdd.Entrant.StairPacket.Shadow15End

