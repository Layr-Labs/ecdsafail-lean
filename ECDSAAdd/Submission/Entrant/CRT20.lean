def leaveLowClose15E (s : Nat) : List Gate :=
  let L := lows15E s
  xsG ((List.range 15).map (s + 16 + ·)) ++
  ((List.range L).map fun i => .cx (e015E s + 5) (b015E s - 1 + i)) ++
  ((List.range L).flatMap fun i => cswapG (s + 30) (b015E s - 1 + i) (a015E s - 1 + i))

def leaveLowStore15E (s : Nat) : List Gate :=
  let L := lows15E s - 1
  let bs := (List.range L).map (b015E s + ·)
  [.cx (e015E s + 3) 1560, .cx 1559 1560, .pop (e015E s + 3) (e015E s + 4) 1559,
   .cx (a015E s - 1) 1557, .x 1557, .make (b015E s - 1) 1557 1558] ++
  ((List.range L).map fun i => .make 1556 (a015E s + i) (b015E s + i)) ++ xsG bs ++
  addG bs ((List.range (L - 1)).map (1559 + ·)) 1558 ++ xsG bs ++
  [.pop (b015E s - 1) 1557 1558, .cx (a015E s - 1) 1557, .x 1557]

def leaveStoreMapped15E (s : Nat) : List Gate :=
  let L := lows15E s
  let top := a015E s + L - 2
