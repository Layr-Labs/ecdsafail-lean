      · rw [if_pos hf]
        exact Nat.le_trans (by decide) hf
      · exfalso
        have hu3 : uSel.basis (e0P20 (start20 j) + 3) = false := by
          rw [huSel_q _ (fun r _ => by omega), if_neg (by simp only [List.mem_range'_1]; omega)]
          exact (hkeptE _ (by omega)).trans (by rw [h.far, decide_eq_false hf])
        have hu6 : uSel.basis (e0P20 (start20 j) + 6) = false := by
