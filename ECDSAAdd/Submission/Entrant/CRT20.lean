    have hsmall : regValue (ys' ++ [ytop]) uPre.basis + 1 < 2 ^ ys'.length := by
      rw [← hys_eq, hbank_uPre, h.bank]
      simp only [ys', List.length_map, List.length_range]
      split_ifs
      · exact h.adjTight
      · have hpos : 1 ≤ adjW20 (start20 j) := (adjW20_ge1 j).1
        have h2 : 2 ≤ 2 ^ adjW20 (start20 j) := by
          calc 2 = 2 ^ 1 := rfl
