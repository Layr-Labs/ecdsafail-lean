theorem archiveCut20 (j : Fin 10) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    PastFacts20 j (ArchiveJ20.rawPorts j) z g0 s0
