theorem tail20_geom : ∀ j : Fin 10,
    let s := start20 j
    sbP20 s + lowsP20 s = nextSb20 s + nextLen20 j + 2 ∧
    (sbP20 s = nextSb20 s + 10 ∨ sbP20 s = nextSb20 s + 7) ∧
    lowsP20 s + (nextWp20 s - 2) = railP (s + 20) - sbP20 s ∧
    b0P20 s + lowsP20 s - 1 = bTopP (s + 20) + 3 - nextWp20 s ∧
    railP (s + 20) - (sbP20 s + lowsP20 s) = nextWp20 s - 2 ∧
    lowsP20 s + (nextWp20 s - 2) ≤ wpP20 s + 20 ∧
    1640 ≤ nextE0_20 s ∧ nextE0_20 s ≤ 1732 ∧
    nextSb20 s + nextLen20 j < sbP20 s + lowsP20 s := by
  decide +kernel

private theorem source_append20 (xs ys : List (Wire × Wire)) (q : Wire) :
    LeaveRelocation.source (xs ++ ys) q = LeaveRelocation.source xs (LeaveRelocation.source ys q) :=
  List.foldr_append ..

private theorem reloc20_bank_bounds (j : Fin 10) (k : Nat) (hk : k < nextWp20 (start20 j) - 2) :
    b0P20 (start20 j) + lowsP20 (start20 j) - 1 + k < (bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ∧
    ((bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ≤ 1043 ∨
      (1603 ≤ (bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ∧
       (bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ≤ 1622)) ∧
    bTopP (start20 j + 20) + 3 + k - nextWp20 (start20 j) = b0P20 (start20 j) + lowsP20 (start20 j) - 1 + k := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbp : bTopP (start20 j) + 1 - wpP20 (start20 j) = b0P20 (start20 j) + 19 := by
    have : ∀ m : Fin 10, bTopP (start20 m) + 1 - wpP20 (start20 m) = b0P20 (start20 m) + 19 := by decide +kernel
    exact this j
  have hsub : bTopP (start20 j + 20) + 3 + k - nextWp20 (start20 j) =
      b0P20 (start20 j) + lowsP20 (start20 j) - 1 + k := by
    have hge : nextWp20 (start20 j) ≤ bTopP (start20 j + 20) + 3 := by
      have : ∀ m : Fin 10, nextWp20 (start20 m) ≤ bTopP (start20 m + 20) + 3 := by decide +kernel
      exact this j
    omega
  rcases bank20_cases j (i := lowsP20 (start20 j) + k) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
  · omega
  · refine ⟨by rw [eb]; unfold Wire at *; omega, Or.inl (by unfold Wire at *; omega), hsub⟩
  · refine ⟨by rw [eb]; unfold Wire at *; omega, Or.inr ⟨by rw [eb]; unfold Wire at *; omega, by rw [eb]; unfold Wire at *; omega⟩, hsub⟩

private theorem movesP20_away (j : Fin 10) (q : Nat) (hq : q < b0P20 (start20 j) + lowsP20 (start20 j) - 1) :
    ∀ p ∈ movesP20 (start20 j), (q : Wire) ≠ p.1 ∧ (q : Wire) ≠ p.2 := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  intro p hp
  simp only [movesP20, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with ⟨k, hk, rfl⟩ | hfl
  · have hb := reloc20_bank_bounds j k hk
    exact ⟨by dsimp only; unfold Wire at *; omega, by dsimp only; rw [hb.2.2]; unfold Wire at *; omega⟩
  · rcases hfl with rfl | rfl | rfl | rfl | rfl | rfl <;>
      (dsimp only; exact ⟨by omega, by omega⟩)

private theorem reloc20_flagTail_eval (j : Fin 10) :
    let s := start20 j
    let fl := [(1557, nextE0_20 s + 3), (1558, nextE0_20 s + 4),
        (e0P20 s + 5, nextE0_20 s + 5), (e0P20 s + 3, nextE0_20 s + 6),
        (e0P20 s + 7, nextE0_20 s + 7), (e0P20 s + 6, nextE0_20 s + 8)]
    LeaveRelocation.source fl (nextE0_20 s + 3) = 1557 ∧
    LeaveRelocation.source fl (nextE0_20 s + 4) = 1558 ∧
    LeaveRelocation.source fl (nextE0_20 s + 5) = e0P20 s + 5 ∧
    LeaveRelocation.source fl (nextE0_20 s + 6) = e0P20 s + 3 ∧
    LeaveRelocation.source fl (nextE0_20 s + 7) = e0P20 s + 7 ∧
    LeaveRelocation.source fl (nextE0_20 s + 8) = e0P20 s + 6 := by
  revert j; decide +kernel

theorem reloc20_flags (j : Fin 10) :
    let s := start20 j
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 3) = 1557 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 4) = 1558 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 5) = e0P20 s + 5 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 6) = e0P20 s + 3 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 7) = e0P20 s + 7 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 8) = e0P20 s + 6 := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hbank_out : ∀ q : Nat, (1557 ≤ q ∧ q ≤ 1558) ∨ 1640 ≤ q →
      ∀ p ∈ (List.range (nextWp20 (start20 j) - 2)).map (fun i => (bankW20 (start20 j) (lowsP20 (start20 j) + i),
        bTopP (start20 j + 20) + 3 + i - nextWp20 (start20 j))), (q : Wire) ≠ p.1 ∧ (q : Wire) ≠ p.2 := by
    intro q hq p hp; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk
    have hb := reloc20_bank_bounds j k hk
    have hbt2 : bTopP (start20 j + 20) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
    exact ⟨by dsimp only; unfold Wire at *; omega, by dsimp only; rw [hb.2.2]; unfold Wire at *; omega⟩
  have hfl := reloc20_flagTail_eval j; dsimp only at hfl
  have htail (q : Wire) : LeaveRelocation.source (movesP20 (start20 j)) q =
      LeaveRelocation.source ((List.range (nextWp20 (start20 j) - 2)).map fun i =>
        (bankW20 (start20 j) (lowsP20 (start20 j) + i), bTopP (start20 j + 20) + 3 + i - nextWp20 (start20 j)))
      (LeaveRelocation.source [(1557, nextE0_20 (start20 j) + 3), (1558, nextE0_20 (start20 j) + 4),
        (e0P20 (start20 j) + 5, nextE0_20 (start20 j) + 5), (e0P20 (start20 j) + 3, nextE0_20 (start20 j) + 6),
        (e0P20 (start20 j) + 7, nextE0_20 (start20 j) + 7), (e0P20 (start20 j) + 6, nextE0_20 (start20 j) + 8)] q) :=
    source_append20 _ _ q
  dsimp only
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [htail, hfl.1]; exact LeaveRelocation.outside _ 1557 (hbank_out 1557 (Or.inl (by omega)))
  · rw [htail, hfl.2.1]; exact LeaveRelocation.outside _ 1558 (hbank_out 1558 (Or.inl (by omega)))
  · rw [htail, hfl.2.2.1]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 5) (hbank_out (e0P20 (start20 j) + 5) (Or.inr (by omega)))
  · rw [htail, hfl.2.2.2.1]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 3) (hbank_out (e0P20 (start20 j) + 3) (Or.inr (by omega)))
  · rw [htail, hfl.2.2.2.2.1]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 7) (hbank_out (e0P20 (start20 j) + 7) (Or.inr (by omega)))
  · rw [htail, hfl.2.2.2.2.2]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 6) (hbank_out (e0P20 (start20 j) + 6) (Or.inr (by omega)))

theorem reloc20_upper (j : Fin 10) (i : Fin (nextWp20 (start20 j) - 2)) :
    LeaveRelocation.source (movesP20 (start20 j)) (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) =
      bankW20 (start20 j) (lowsP20 (start20 j) + i.val) ∧
    LeaveRelocation.source (movesP20 (start20 j)) (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) =
      a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbi := reloc20_bank_bounds j i.val i.isLt
  constructor
  · let f := fun k => (bankW20 (start20 j) (lowsP20 (start20 j) + k), bTopP (start20 j + 20) + 3 + k - nextWp20 (start20 j))
    have hfl_out : LeaveRelocation.source
        [(1557, nextE0_20 (start20 j) + 3), (1558, nextE0_20 (start20 j) + 4),
         (e0P20 (start20 j) + 5, nextE0_20 (start20 j) + 5), (e0P20 (start20 j) + 3, nextE0_20 (start20 j) + 6),
         (e0P20 (start20 j) + 7, nextE0_20 (start20 j) + 7), (e0P20 (start20 j) + 6, nextE0_20 (start20 j) + 8)]
        (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) = b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val := by
      apply LeaveRelocation.outside; intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      have hhi : b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val ≤ 1043 := by
        have := i.isLt; unfold bTopP railP at *; split_ifs at * <;> omega
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩
    rw [movesP20, source_append20, hfl_out]
    have hsplit : List.range (nextWp20 (start20 j) - 2) =
        List.range i.val ++ i.val :: List.range' (i.val + 1) (nextWp20 (start20 j) - 2 - (i.val + 1)) := by
      have hi := i.isLt
      rw [List.range_eq_range', List.range_eq_range']
      conv_lhs => rw [show nextWp20 (start20 j) - 2 = i.val + ((nextWp20 (start20 j) - 2 - (i.val + 1)) + 1) by omega]
      rw [← List.range'_append_1, Nat.zero_add]; rfl
    rw [hsplit, List.map_append, List.map_cons, source_append20]
    have hdrop : LeaveRelocation.source
        ((List.range' (i.val + 1) (nextWp20 (start20 j) - 2 - (i.val + 1))).map f)
        (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) = b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val := by
      apply LeaveRelocation.outside; intro p hp
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range'_1] at hk
      have hbk := reloc20_bank_bounds j k (by omega)
      exact ⟨by dsimp only [f]; unfold Wire at *; omega, by dsimp only [f]; rw [hbk.2.2]; unfold Wire at *; omega⟩
    change LeaveRelocation.source ((List.range i.val).map f)
      (LeaveRelocation.flip (f i.val).1 (f i.val).2
        (LeaveRelocation.source ((List.range' (i.val + 1) _).map f) (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val))) = _
    rw [hdrop]; dsimp only [f, LeaveRelocation.flip]
    rw [hbi.2.2, if_neg (by unfold Wire at *; omega), if_pos rfl]
    apply LeaveRelocation.outside; intro p hp
