theorem leave20_roundtrip (j : Fin 10) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    ∀ m n : List Bool, run (leaveInvP20 j) n (run (leaveP20 j) m s) = s := by
  intro m n
  obtain ⟨hbf_ready, _, hbf_prep⟩ := leaveBefore20_valid j s z g0 s0 h
  have h_mid := barrel20_mid_rt j s m z g0 s0 h
  obtain ⟨haf_prep, haf_ready⟩ := leaveAfter20_valid j s m z g0 s0 h
  let uB := run (GateMirror.forward (leaveBefore20 (start20 j))) m s
  let uA := run (barrel20 (start20 j) false) (m.drop (measurementCount (GateMirror.forward (leaveBefore20 (start20 j))))) uB
  rw [leaveP20_def, leaveInvP20_def]
  simp only [run_append, run_take]
  have hinvA := GateMirror.invert (leaveAfter20 (start20 j)) uA (leaveAfter20_ok j).1 haf_prep haf_ready
    ((m.drop (measurementCount (GateMirror.forward (leaveBefore20 (start20 j))))).drop (measurementCount (barrel20 (start20 j) false))) n
  have hinvB := (h_mid (n.drop (measurementCount (inverse (leaveAfter20 (start20 j)))))).1
  have hinvF := GateMirror.invert (leaveBefore20 (start20 j)) s (leaveBefore20_ok j).1 hbf_prep hbf_ready m
    ((n.drop (measurementCount (inverse (leaveAfter20 (start20 j))))).drop (measurementCount (barrel20 (start20 j) true)))
  dsimp only [uA, uB] at hinvA hinvB
  simp only [measurementCount_append, List.drop_drop, Nat.add_comm] at hinvA hinvF ⊢
  rw [hinvA, hinvB, hinvF]

end RoundtripPieces


