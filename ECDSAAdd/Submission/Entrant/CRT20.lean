theorem clean_for (raw : State) (z : SkywalkNat.State) (route sg : Bool)
    (record : SkywalkIntegerInput (W.compactSkywalkTickLayout base 425)
      (SkywalkRails.encode route sg z.u z.v).a (SkywalkRails.encode route sg z.u z.v).b route raw.basis) :
    ∀ q ∈ activeScratch, (pullState (OB5.sig 424) raw).basis q = false := by
  have pool : ∀ q ∈ activeScratch, OB5.sig 424 q ∈ (W.compactSkywalkTickLayout base 425).carry := by
    decide +kernel
  exact fun q hq => (regValue_zero _ _).mp record.2.2.2.2.2 _ (pool _ hq)

theorem erase_ready (z : SkywalkNat.State) (small : Shadow7.SmallIfFar 36 15 z) (raw : State) (m : List Bool)
    (route sg : Bool)
    (record : SkywalkIntegerInput (W.compactSkywalkTickLayout base 425)
      (SkywalkRails.encode route sg z.u z.v).a (SkywalkRails.encode route sg z.u z.v).b route raw.basis)
    (m0 : List Bool) :
    (regValue bulkB (run flags m0 (run scan m (pullState (OB5.sig 424) raw))).basis +
      ((run flags m0 (run scan m (pullState (OB5.sig 424) raw))).basis 838 &&
        !(run flags m0 (run scan m (pullState (OB5.sig 424) raw))).basis 493).toNat) % 2 ^ bulkB.length =
      copyValue (some 1614) (run flags m0 (run scan m (pullState (OB5.sig 424) raw))).basis
        (regValue bulkA (run flags m0 (run scan m (pullState (OB5.sig 424) raw))).basis) := by
  let origin := pullState (OB5.sig 424) raw
  let v := run scan m origin
  let w := run flags m0 v
  let far := decide (2 * 2 ^ 51 ≤ z.u + z.v)
  let long := decide (2 * 2 ^ 51 ≤ z.u + z.v ∧ 2 ^ 36 ≤ z.u)
  have short : 2 * 2 ^ 51 ≤ z.u + z.v → min z.u z.v < 2 ^ 36 := fun f =>
    small ((Nat.le_div_iff_mul_le (Nat.two_pow_pos _)).mpr f)
  have clean := clean_for raw z route sg record
  have vs : ∀ q ∈ activeScratch, v.basis q = false :=
    fun q mem => (run_preserves_outside _ m origin q (away_scan _ mem)).trans (clean q mem)
  have fresh : origin.basis 1615 = false := by
    apply (regValue_zero _ _).mp record.2.2.2.2.2 (OB5.sig 424 1615); decide +kernel
  have first := scan_input _ _ _ _ _ _ _ _ source geom raw m _ _ route sg record fresh
  rw [← scan_shape, show pairs.map Prod.fst = railA by decide +kernel,
    show pairs.map Prod.snd = railB by decide +kernel] at first
  obtain ⟨_, _, left, right⟩ := first
  have wf : w = ⟨v.phase, writeBit (writeBit v.basis 1613 far) 1614 long⟩ :=
    flags_values v m0 _ _ sg short vs left right
  have keep (q : Wire) (qf : q ≠ 1613) (qu : q ≠ 1614) : w.basis q = v.basis q := by
    rw [wf]; simp [writeBit, qf, qu]
  have vals (r : List Wire) (sub : ∀ q ∈ r, q ∈ railA ++ railB) : regValue r w.basis = regValue r v.basis :=
    regValue_congr _ _ _ (fun q h => keep _ (pot _ (sub q h)).1 (pot _ (sub q h)).2)
  exact erase_input w _ _ sg short
    ((vals _ (fun _ h => List.mem_append_left _ h)).trans left)
    ((vals _ (fun _ h => List.mem_append_right _ h)).trans right) (by rw [wf]; simp [long, writeBit])

theorem physical_frame_local (z : SkywalkNat.State) (small : Shadow7.SmallIfFar 36 15 z) (raw : State) (m : List Bool)
    (route sg : Bool)
    (record : SkywalkIntegerInput (W.compactSkywalkTickLayout base 425)
      (SkywalkRails.encode route sg z.u z.v).a (SkywalkRails.encode route sg z.u z.v).b route raw.basis) :
    let origin := pullState (OB5.sig 424) raw
    PackedCut loPairs hiPairs 440 1615 1613 1614 (negative sg z.u)
      (decide (2 * 2 ^ 51 ≤ z.u + z.v)) (decide (2 * 2 ^ 51 ≤ z.u + z.v ∧ 2 ^ 36 ≤ z.u))
      origin (run (Shadow7.portalP 425) m origin) := by
  let origin := pullState (OB5.sig 424) raw
  let v := run scan m origin
  let t1 := m.drop (measurementCount scan)
  let w := run flags t1 v
  let t2 := m.drop (measurementCount (scan ++ flags))
  let x := run erase t2 w
  let t3 := m.drop (measurementCount (scan ++ flags ++ erase))
  let far := decide (2 * 2 ^ 51 ≤ z.u + z.v)
  let long := decide (2 * 2 ^ 51 ≤ z.u + z.v ∧ 2 ^ 36 ≤ z.u)
  have short : 2 * 2 ^ 51 ≤ z.u + z.v → min z.u z.v < 2 ^ 36 := fun f =>
    small ((Nat.le_div_iff_mul_le (Nat.two_pow_pos _)).mpr f)
  have clean := clean_for raw z route sg record
  have vs : ∀ q ∈ activeScratch, v.basis q = false :=
    fun q mem => (run_preserves_outside _ m origin q (away_scan _ mem)).trans (clean q mem)
  have fresh : origin.basis 1615 = false := by
    apply (regValue_zero _ _).mp record.2.2.2.2.2 (OB5.sig 424 1615); decide +kernel
  have first := scan_input _ _ _ _ _ _ _ _ source geom raw m _ _ route sg record fresh
  rw [← scan_shape, show pairs.map Prod.fst = railA by decide +kernel,
    show pairs.map Prod.snd = railB by decide +kernel] at first
  obtain ⟨neg, _, left, right⟩ := first
  have wf : w = ⟨v.phase, writeBit (writeBit v.basis 1613 far) 1614 long⟩ :=
    flags_values v t1 _ _ sg short vs left right
  have keep (q : Wire) (qf : q ≠ 1613) (qu : q ≠ 1614) : w.basis q = v.basis q := by
    rw [wf]; simp [writeBit, qf, qu]
  have cv : w.basis 1556 = false ∧ ∀ q ∈ carry, w.basis q = false := by
    refine ⟨(keep _ (by decide) (by decide)).trans (vs _ (by decide +kernel)), ?_⟩
    intro q hq
    exact (keep q (carry_apart _ hq).1 (carry_apart _ hq).2).trans (vs _ (by simp [activeScratch, hq]))
  have vals (r : List Wire) (sub : ∀ q ∈ r, q ∈ railA ++ railB) : regValue r w.basis = regValue r v.basis :=
    regValue_congr _ _ _ (fun q h => keep _ (pot _ (sub q h)).1 (pot _ (sub q h)).2)
  have xe := erase_values w t2 _ _ sg short cv
    ((vals _ (fun _ h => List.mem_append_left _ h)).trans left)
    ((vals _ (fun _ h => List.mem_append_right _ h)).trans right) (by rw [wf]; simp [long, writeBit])
  have scanned := scan_run 528 873 440 1615 pairs geom origin m fresh
  rw [← scan_shape] at scanned
  have sign : (origin.basis 528 ^^ origin.basis 873) = negative sg z.u := scanned.2.1.symm.trans neg
  rw [sign, pair_split] at scanned
  have clearHi : ∀ p ∈ hiPairs, x.basis p.2 = false := by
    intro p hp
    have hy : p.2 ∈ hiPairs.map Prod.snd := List.mem_map.mpr ⟨p, hp, rfl⟩
    exact (regValue_zero _ _).mp xe.2.2 p.2 (hi_y ▸ hy)
  have stored := store_run 440 1615 loPairs hiPairs bankLayout.store x t3 clearHi
  rw [← store_shape] at stored
  rw [emitted]
  simp only [run_append, run_take]
  apply packed loPairs hiPairs 440 1615 1613 1614 _ far long origin v w x (run store t3 x)
    bankLayout scanned.1 neg scanned.2.2.1 scanned.2.2.2 wf
  · rw [hi_y]; exact xe
  · exact stored.1
  · exact stored.2.1
  · exact stored.2.2.1
  · exact stored.2.2.2
  · decide +kernel

theorem release (z : SkywalkNat.State) (small : Shadow7.SmallIfFar 36 15 z) (raw packed : State) (m : List Bool)
    (route sg : Bool)
    (record : SkywalkIntegerInput (W.compactSkywalkTickLayout base 425)
      (SkywalkRails.encode route sg z.u z.v).a (SkywalkRails.encode route sg z.u z.v).b route raw.basis)
    (cut : PackedCut loPairs hiPairs 440 1615 1613 1614 (negative sg z.u)
      (decide (2 * 2 ^ 51 ≤ z.u + z.v)) (decide (2 * 2 ^ 51 ≤ z.u + z.v ∧ 2 ^ 36 ≤ z.u))
      (pullState (OB5.sig 424) raw) packed) :
    run (Shadow7.portalInvP 425) m packed = pullState (OB5.sig 424) raw := by
  rw [cut.unique (physical_frame_local z small raw [] route sg record)]
  exact portal_return _ [] m (clean_for raw z route sg record) (erase_ready z small raw [] route sg record)

