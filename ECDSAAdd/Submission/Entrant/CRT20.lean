        apply congrArg (State.mk s.phase); funext q
        by_cases eq : q = 1558
        · subst eq; simp [Function.update_self]
        · simp [Function.update_of_ne eq]
  rw [hmid, HighBankControl.toggle_run 1557 (swaps20G (start20 j)) (writeBit s.basis 1558 false) _ _ n57 (fun _ _ => rfl)]
  have hpar : HighBankControl.parity (writeBit s.basis 1558 false) (swaps20G (start20 j)) =
