/-- Tightened 20-tick high-bank adjust width: on early blocks (`s < 225`, i.e. `j ∈ {0, 1, 2}`)
    and late blocks (`265 ≤ s`, i.e. `j ∈ {5, 6, 7, 8}`), the signed rail width `wpP20 s` has
    an unused top bit above `Shadow.high (sbP20 s) 20 z + 1`. -/
def adjW20 (s : Nat) : Nat :=
  if s < 225 ∨ 265 ≤ s then wpP20 s - 1 else wpP20 s

def leaveAdjustCore20Short (s : Nat) : List Gate :=
  adjustG ((List.range (adjW20 s)).map (bankW20 s))
    ((List.range (adjW20 s - 1)).map (poolW20 s)) (e0P20 s + 3) 1601

def leaveAdjust20Short (s : Nat) : List Gate :=
  [.cx (e0P20 s + 6) (e0P20 s + 3)] ++ leaveAdjustCore20Short s

theorem adjW20_ge1 (j : Fin 10) : 1 ≤ adjW20 (start20 j) ∧ adjW20 (start20 j) ≤ wpP20 (start20 j) := by
  have : ∀ k : Fin 10, 1 ≤ adjW20 (start20 k) ∧ adjW20 (start20 k) ≤ wpP20 (start20 k) := by decide
  exact this j

theorem leaveAdjustCore20Short_mem (s : Nat) (hw : 2 ≤ wpP20 s) :
    ∀ g ∈ leaveAdjustCore20Short s, g ∈ leaveAdjustCore20 s := by
  by_cases h : s < 225 ∨ 265 ≤ s
  · have hadj : adjW20 s = wpP20 s - 1 := if_pos h
    have hwp : wpP20 s = adjW20 s + 1 := by omega
    have hwp1 : wpP20 s - 1 = (adjW20 s - 1) + 1 := by omega
    have hys : (List.range (wpP20 s)).map (bankW20 s) =
        (List.range (adjW20 s)).map (bankW20 s) ++ [bankW20 s (adjW20 s)] := by
      rw [hwp, List.range_succ, List.map_append, List.map_singleton]
    have hcs : (List.range (wpP20 s - 1)).map (poolW20 s) =
        (List.range (adjW20 s - 1)).map (poolW20 s) ++ [poolW20 s (adjW20 s - 1)] := by
      rw [hwp1, List.range_succ, List.map_append, List.map_singleton]
    intro g hg
    unfold leaveAdjustCore20
    rw [hys, hcs]
    exact TruncatedAdjust.adjustG_mem _ _ _ _ _ _ (by simp; omega) g hg
  · have hadj : adjW20 s = wpP20 s := if_neg h
    intro g hg
    simpa only [leaveAdjustCore20Short, leaveAdjustCore20, hadj] using hg

