        obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hz; rw [List.mem_range] at hk
        rcases bank20_cases j (i := k) (by omega) with ⟨_, e⟩ | ⟨_, _, e, _, _⟩ | ⟨_, e, _, _⟩ <;>
          (dsimp only; rw [e]; (try unfold Wire at *); omega)
      · cases hw
  · rw [columnsP20, List.pairwise_map]
    refine List.Pairwise.imp_of_mem (fun {a b} ha hb hab => ?_) List.pairwise_lt_range
    rw [List.mem_range] at ha hb
    have hne : a ≠ b := Nat.ne_of_lt hab
    have hbi := fun e => hne (bank20_inj j (by omega) (by omega) e)
    rcases bank20_cases j (i := a) (by omega) with ⟨_, ea⟩ | ⟨_, _, ea, _, _⟩ | ⟨_, ea, _, _⟩ <;>
      rcases bank20_cases j (i := b) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
      refine ⟨by dsimp only; (try unfold Wire at *); omega, by dsimp only; rw [eb]; (try unfold Wire at *); omega,
              by dsimp only; rw [ea]; (try unfold Wire at *); omega, hbi⟩

private theorem kept10_run (j : Fin 10) (s : State) (m : List Bool) (X : Nat) (k : Mode20)
    (h1623 : s.basis 1623 = if Selector20.enabled20 k then ((X / 2 ^ Selector20.key20 k) / 2 % 2 == 1) else false)
    (htags : ∀ i : Nat, i < 10 → s.basis (tagsP20.getD i 0) = (Selector20.enabled20 k && decide (i = Selector20.key20 k)))
    (hX : ∀ i : Nat, i < 22 → s.basis (a0P20 (start20 j) - 1 + i) =
      if Selector20.enabled20 k && decide (i = Selector20.key20 k) then false else X.testBit i)
    (hbound : Selector20.enabled20 k = true → X / 2 ^ Selector20.key20 k ≤ 2)
    (hdead : Selector20.enabled20 k = true → 10 ≤ Selector20.key20 k → (X / 2 ^ Selector20.key20 k) / 2 % 2 = 0) :
    let out := run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) - 1 + i) 1623 0 10)) m s
    out.phase = s.phase ∧
    (∀ i : Nat, i < 22 → out.basis (a0P20 (start20 j) - 1 + i) =
      if Selector20.enabled20 k then (X % 2 ^ Selector20.key20 k).testBit i else X.testBit i) ∧
    (∀ q : Wire, (∀ i : Nat, i < 10 → q ≠ a0P20 (start20 j) - 1 + (i + 1)) → out.basis q = s.basis q) := by
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, hwp1, hwp2, hlo1, hlo2, huw, hlw1, hlw2, htop⟩ := geom20_facts j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hstep : ∀ (p n : Nat) (st : State) (tp : List Bool), p + n ≤ 10 →
      (∀ i, p ≤ i → i < p + n → st.basis (tagsP20.getD i 0) = s.basis (tagsP20.getD i 0)) →
      st.basis 1623 = s.basis 1623 →
      (run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) - 1 + i) 1623 p n)) tp st).phase = st.phase ∧
      (∀ i, p ≤ i → i < p + n →
        (run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) - 1 + i) 1623 p n)) tp st).basis
          (a0P20 (start20 j) - 1 + (i + 1)) =
        (st.basis (a0P20 (start20 j) - 1 + (i + 1)) ^^ (s.basis (tagsP20.getD i 0) && s.basis 1623))) ∧
      (∀ q, (∀ i, p ≤ i → i < p + n → q ≠ a0P20 (start20 j) - 1 + (i + 1)) →
        (run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) - 1 + i) 1623 p n)) tp st).basis q = st.basis q) := by
    intro p n; induction n generalizing p with
    | zero => intro st tp _ _ _; exact ⟨rfl, fun _ h1 h2 => by omega, fun _ _ => rfl⟩
    | succ n ih =>
      intro st tp hpn htg h23
      have hsplit : GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) - 1 + i) 1623 p (n + 1)) =
          [Instr.CCX (tagsP20.getD p 0) 1623 (a0P20 (start20 j) - 1 + (p + 1))] ++
            GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) - 1 + i) 1623 (p + 1) n) := rfl
      rw [hsplit, run_append, run_take]
      have hdrop : tp.drop (measurementCount [Instr.CCX (tagsP20.getD p 0) 1623 (a0P20 (start20 j) - 1 + (p + 1))]) = tp := rfl
      rw [hdrop]
      let st1 := run [Instr.CCX (tagsP20.getD p 0) 1623 (a0P20 (start20 j) - 1 + (p + 1))] tp st
      have hst1 : st1 = ⟨st.phase, writeBit st.basis (a0P20 (start20 j) - 1 + (p + 1))
          (st.basis (a0P20 (start20 j) - 1 + (p + 1)) ^^ (st.basis (tagsP20.getD p 0) && st.basis 1623))⟩ := rfl
      have hneT : ∀ i < 10, tagsP20.getD i 0 ≠ a0P20 (start20 j) - 1 + (p + 1) := fun i hi => by
        have tr := tagsP20_getD_range (k := i) (by omega); (try unfold Wire at *); omega
      have hrec := ih (p + 1) st1 tp (by omega)
        (fun i h1 h2 => by rw [hst1]; simp only [writeBit, Function.update_of_ne (hneT i (by omega)), htg i (by omega) (by omega)])
        (by rw [hst1]; simp only [writeBit, Function.update_of_ne (show (1623 : Wire) ≠ a0P20 (start20 j) - 1 + (p + 1) by (try unfold Wire at *); omega), h23])
      refine ⟨hrec.1.trans (by rw [hst1]), fun i h1 h2 => ?_, fun q hq => ?_⟩
      · by_cases eq : i = p
        · subst eq
          rw [hrec.2.2 _ (fun i' h1' h2' => by omega), hst1]
          simp only [writeBit, Function.update_self, htg i (by omega) (by omega), h23]
        · rw [hrec.2.1 i (by omega) (by omega), hst1]
          simp only [writeBit, Function.update_of_ne (show a0P20 (start20 j) - 1 + (i + 1) ≠ a0P20 (start20 j) - 1 + (p + 1) by omega)]
      · rw [hrec.2.2 q (fun i h1 h2 => hq i (by omega) (by omega)), hst1]
        simp only [writeBit, Function.update_of_ne (hq p (by omega) (by omega))]
  have hrun := hstep 0 10 s m (by decide) (fun _ _ _ => rfl) rfl
  refine ⟨hrun.1, ?_, fun q hq => hrun.2.2 q (fun i _ hi => hq i hi)⟩
  intro i hi
  cases hen : Selector20.enabled20 k
  · have hno : ∀ r < 10, s.basis (tagsP20.getD r 0) = false := fun r hr => by rw [htags r hr, hen]; rfl
    by_cases h1 : 1 ≤ i ∧ i ≤ 10
    · rw [show a0P20 (start20 j) - 1 + i = a0P20 (start20 j) - 1 + ((i - 1) + 1) by (try unfold Wire at *); omega,
        hrun.2.1 (i - 1) (by omega) (by omega), hno (i - 1) (by omega)]
      simp only [Bool.false_and, Bool.xor_false, show a0P20 (start20 j) - 1 + (i - 1 + 1) = a0P20 (start20 j) - 1 + i by (try unfold Wire at *); omega,
        hX i hi, hen, Bool.false_and, Bool.false_eq_true, if_false]
    · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega), hX i hi, hen]; rfl
  · simp only [if_true]
    have hb := hbound hen
    by_cases hlt : i < Selector20.key20 k
    · rw [Nat.testBit_mod_two_pow, decide_eq_true hlt, Bool.true_and]
      by_cases h1 : 1 ≤ i ∧ i ≤ 10
      · rw [show a0P20 (start20 j) - 1 + i = a0P20 (start20 j) - 1 + ((i - 1) + 1) by (try unfold Wire at *); omega,
          hrun.2.1 (i - 1) (by omega) (by omega)]
        have hf : s.basis (tagsP20.getD (i - 1) 0) = false := by
          rw [htags (i - 1) (by omega), hen, Bool.true_and, decide_eq_false (by omega)]
        rw [hf, Bool.false_and, Bool.xor_false,
          show a0P20 (start20 j) - 1 + (i - 1 + 1) = a0P20 (start20 j) - 1 + i by (try unfold Wire at *); omega, hX i hi, hen, Bool.true_and,
          decide_eq_false (by omega)]; rfl
      · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega), hX i hi, hen, Bool.true_and,
          decide_eq_false (by omega)]; rfl
    · rw [Nat.testBit_mod_two_pow, decide_eq_false hlt, Bool.false_and]
      by_cases heq : i = Selector20.key20 k
      · subst heq
        by_cases h1 : 1 ≤ Selector20.key20 k ∧ Selector20.key20 k ≤ 10
        · rw [show a0P20 (start20 j) - 1 + Selector20.key20 k = a0P20 (start20 j) - 1 + ((Selector20.key20 k - 1) + 1) by (try unfold Wire at *); omega,
            hrun.2.1 (Selector20.key20 k - 1) (by omega) (by omega)]
          have hf : s.basis (tagsP20.getD (Selector20.key20 k - 1) 0) = false := by
            rw [htags _ (by omega), hen, Bool.true_and, decide_eq_false (by omega)]
          rw [hf, Bool.false_and, Bool.xor_false,
            show a0P20 (start20 j) - 1 + (Selector20.key20 k - 1 + 1) = a0P20 (start20 j) - 1 + Selector20.key20 k by (try unfold Wire at *); omega]
          simp only [hX _ hi, hen, Bool.true_and, decide_true, if_true]
        · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega)]
          simp only [hX _ hi, hen, Bool.true_and, decide_true, if_true]
      · by_cases heq1 : i = Selector20.key20 k + 1
        · subst heq1
          by_cases hk10 : Selector20.key20 k < 10
          · rw [hrun.2.1 (Selector20.key20 k) (by omega) hk10, htags _ hk10, hen, Bool.true_and, decide_eq_true rfl,
              Bool.true_and, h1623, if_pos hen]
            simp only [hX _ hi, hen, Bool.true_and, decide_eq_false (show Selector20.key20 k + 1 ≠ Selector20.key20 k by omega),
              Bool.false_eq_true, if_false]
            have hbit : X.testBit (Selector20.key20 k + 1) = ((X / 2 ^ Selector20.key20 k) / 2 % 2 == 1) := by
              rw [Nat.testBit_eq_decide_div_mod_eq, Nat.pow_succ, ← Nat.div_div_eq_div_mul]; rfl
            rw [hbit]; exact Bool.xor_self _
          · rw [hrun.2.2 _ (fun r _ hr => by omega)]
            simp only [hX _ hi, hen, Bool.true_and, decide_eq_false (show Selector20.key20 k + 1 ≠ Selector20.key20 k by omega),
              Bool.false_eq_true, if_false]
            have hbit : X.testBit (Selector20.key20 k + 1) = ((X / 2 ^ Selector20.key20 k) / 2 % 2 == 1) := by
              rw [Nat.testBit_eq_decide_div_mod_eq, Nat.pow_succ, ← Nat.div_div_eq_div_mul]; rfl
            rw [hbit, hdead hen (by omega)]; rfl
        · have hhi : X.testBit i = false := by
            rw [Nat.testBit_eq_decide_div_mod_eq]
            have hlt4 : X < 2 ^ i := by
              have : X < 4 * 2 ^ Selector20.key20 k := by
                have h1 := Nat.mul_le_mul_left (2 ^ Selector20.key20 k) hb
                have h2 := Nat.div_add_mod X (2 ^ Selector20.key20 k)
                have h3 := Nat.mod_lt X (Nat.two_pow_pos (Selector20.key20 k))
                omega
              calc X < 2 ^ 2 * 2 ^ Selector20.key20 k := this
                _ = 2 ^ (2 + Selector20.key20 k) := (Nat.pow_add 2 2 _).symm
                _ ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (by omega)
            rw [Nat.div_eq_of_lt hlt4]; rfl
          by_cases h1 : 1 ≤ i ∧ i ≤ 10
          · rw [show a0P20 (start20 j) - 1 + i = a0P20 (start20 j) - 1 + ((i - 1) + 1) by (try unfold Wire at *); omega,
              hrun.2.1 (i - 1) (by omega) (by omega)]
            have hf : s.basis (tagsP20.getD (i - 1) 0) = false := by
              rw [htags _ (by omega), hen, Bool.true_and, decide_eq_false (by omega)]
            rw [hf, Bool.false_and, Bool.xor_false,
              show a0P20 (start20 j) - 1 + (i - 1 + 1) = a0P20 (start20 j) - 1 + i by (try unfold Wire at *); omega]
            simp only [hX i hi, hen, Bool.true_and, decide_eq_false heq, Bool.false_eq_true, if_false, hhi]
          · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega)]
            simp only [hX i hi, hen, Bool.true_and, decide_eq_false heq, Bool.false_eq_true, if_false, hhi]

