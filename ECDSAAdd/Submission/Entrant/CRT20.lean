set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def physP : Program := renameProgram xRelabel (StairV3Primitives.orient 425)

def rawA : List Wire := StairCodec.reg (StairPhysicalLayout.physicalLayout 87).S 87 ++ [base 512]
def rawB : List Wire := StairCodec.reg (StairPhysicalLayout.physicalLayout 87).D 87 ++ [StairPhysicalLayout.bSite 87]
def rawAll : List Wire := StairPhysicalLayout.letterSite 424 :: (rawA ++ rawB)

def regA : List Wire := rawA.map xRelabel
def regB : List Wire := rawB.map xRelabel
def allSites : List Wire := 440 :: (regA ++ regB)

private theorem xRelabel_inj : Function.Injective xRelabel := fun a b h => by
  have := congrArg StairExitLT24.xRelabelInv h
  simpa only [StairExitLT24.xRelabelInv_relabel] using this

private def xRelabelB (w : Wire) : Wire :=
  StairV3Primitives.xSwap (StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB w))

private theorem xRelabel_eqB (w : Wire) : xRelabel w = xRelabelB w := by
  rw [xRelabel, xRelabelB, StairPhysicalV3.phaseRelabel_eqB]

private theorem xRelabel_440 : xRelabel (StairPhysicalLayout.letterSite 424) = 440 := by
  rw [xRelabel_eqB]; decide +kernel

private theorem rename_copyRegister (f : Wire → Wire) (c : Option Wire) (a b : List Wire) :
    renameProgram f (copyRegister c a b) = copyRegister (c.map f) (a.map f) (b.map f) := by
  induction a generalizing b with
  | nil => cases b <;> rfl
  | cons x xs ih =>
    cases b with
    | nil => rfl
    | cons y ys =>
      simp only [copyRegister, List.map_cons, renameProgram, List.map_append]
      congr 1
      · cases c <;> rfl
      · exact ih ys

private theorem rename_swapRegisters (f : Wire → Wire) (c : Wire) (a b : List Wire) :
    renameProgram f (swapRegisters c a b) = swapRegisters (f c) (a.map f) (b.map f) := by
  simp only [swapRegisters, renameProgram, List.map_append]
  have h1 := rename_copyRegister f none b a
  have h2 := rename_copyRegister f (some c) a b
  simp only [renameProgram, Option.map_none, Option.map_some] at h1 h2
  rw [h1, h2]

private theorem orient425_eq_swap :
    StairV3Primitives.orient 425 =
      swapRegisters (StairPhysicalLayout.letterSite 424) rawA rawB := by
  unfold StairV3Primitives.orient StairV3Primitives.orientFull rawA rawB
  have h1 : (425 : Nat) - 1 = 424 := rfl
  have h2 : (512 : Nat) - 425 = 87 := rfl
  rw [h1, h2]

attribute [local irreducible] swapRegisters in
theorem physP_eq_swap : physP = swapRegisters 440 regA regB := by
  rw [physP, orient425_eq_swap, rename_swapRegisters, xRelabel_440]
  rfl

theorem reg_len : regA.length = regB.length := by
  simp only [regA, regB, List.length_map]; decide

theorem allSites_eq_map : allSites = rawAll.map xRelabel := by
  simp only [allSites, rawAll, regA, regB, List.map_cons, List.map_append, xRelabel_440]

theorem allSites_nodup : allSites.Nodup := by
  have hraw : rawAll.Nodup := by decide +kernel
  rw [allSites_eq_map]
  exact hraw.map xRelabel_inj

theorem physP_wires_sub : wires physP ⊆ allSites.toFinset :=
  physP_eq_swap ▸ swapRegisters_wires 440 regA regB reg_len

theorem counts :
    toffoliCount physP = 88 ∧ measurementCount physP = 0 ∧ gateSlots physP = 264 := by
  have hr := swapRegisters_resources 440 regA regB reg_len allSites_nodup
  have hs : gateSlots (StairV3Primitives.orient 425) = 264 := by decide +kernel
  refine ⟨by rw [physP_eq_swap]; exact hr.1.trans (by simp [regA]; decide),
    by rw [physP_eq_swap]; exact hr.2.1,
    by rw [physP, Baselines.rename_gateSlots, hs]⟩

theorem phys : GatePhysical physP :=
  gatePhysical_rename xRelabel xRelabel_inj _
    ((RecordedQuantum.physical_embed _).mp
      (RecordedQuantum.physical_of_proper _ (PortalStatic.proper _ (by decide +kernel))))

private def bank23L : List Wire := (List.finRange 23).map fun i => rawPorts ⟨i.val, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩
private def scratch134L : List Wire := (List.finRange 134).map fun k => rawPorts ⟨23 + k.val, by have := k.isLt; omega⟩
private def hist10L : List Wire := (List.finRange 10).map fun q => OB5.sig 425 (History5.historyMap base 410 q)

private theorem allSites_audit :
    rawAll.all (fun w =>
      let q := xRelabelB w
      WindowCovered.domainW q &&
      decide (Stair44WalkMap.rest q = q) &&
      decide (q ∉ ParkEndpoint425.dst) &&
      decide (q = 440 ∨ q ∉ bank23L) &&
      decide (q ∉ scratch134L) &&
      decide (q = 440 ∨ q ∉ hist10L) &&
      decide ((440 ≤ (q : Nat) ∧ (q : Nat) ≤ 528) ∨ (786 ≤ (q : Nat) ∧ (q : Nat) ≤ 873))) = true := by
  decide +kernel

private theorem allSites_prop {q : Wire} (hq : q ∈ allSites) :
    WindowCovered.domainW q = true ∧
    Stair44WalkMap.rest q = q ∧
    q ∉ ParkEndpoint425.dst ∧
    (q = 440 ∨ q ∉ bank23L) ∧
    q ∉ scratch134L ∧
    (q = 440 ∨ q ∉ hist10L) ∧
    ((440 ≤ (q : Nat) ∧ (q : Nat) ≤ 528) ∨ (786 ≤ (q : Nat) ∧ (q : Nat) ≤ 873)) := by
  rw [allSites_eq_map] at hq
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hq
  rw [xRelabel_eqB]
  have ha := List.all_eq_true.mp allSites_audit w hw
  simp only [Bool.and_eq_true, decide_eq_true_eq] at ha
  exact ⟨ha.1.1.1.1.1.1, ha.1.1.1.1.1.2, ha.1.1.1.1.2, ha.1.1.1.2, ha.1.1.2, ha.1.2, ha.2⟩

theorem allSites_range : ∀ q ∈ allSites,
    (440 ≤ (q : Nat) ∧ (q : Nat) ≤ 528) ∨ (786 ≤ (q : Nat) ∧ (q : Nat) ≤ 873) :=
  fun _ hq => (allSites_prop hq).2.2.2.2.2.2

theorem wires_range : ∀ q ∈ wires physP,
    (440 ≤ (q : Nat) ∧ (q : Nat) ≤ 528) ∨ (786 ≤ (q : Nat) ∧ (q : Nat) ≤ 873) :=
  fun _ hq => allSites_range _ (List.mem_toFinset.mp (physP_wires_sub hq))

theorem not_wire_of_range {q : Wire}
    (h : ¬ ((440 ≤ (q : Nat) ∧ (q : Nat) ≤ 528) ∨ (786 ≤ (q : Nat) ∧ (q : Nat) ≤ 873))) :
    q ∉ wires physP :=
  fun hw => h (wires_range q hw)

theorem cov : WindowCovered.CoveredW physP := fun q hq =>
  (allSites_prop (List.mem_toFinset.mp (physP_wires_sub hq))).1

theorem rest_fixed : ∀ q ∈ wires physP, Stair44WalkMap.rest q = q := fun q hq =>
  (allSites_prop (List.mem_toFinset.mp (physP_wires_sub hq))).2.1

private theorem rename_id_prog (P : Program) : renameProgram id P = P := by
  have hc : ∀ cs : List Correction, cs.map (renameCorrection id) = cs := fun cs => by
    induction cs with
    | nil => rfl
    | cons c cs ihc => cases c <;> simp [renameCorrection, ihc]
  induction P with
  | nil => rfl
  | cons g gs ih =>
    simp only [renameProgram, List.map_cons] at ih ⊢
    cases g <;> simp [renameInstr, hc, ih]

attribute [local irreducible] physP in
theorem rename_rest : renameProgram Stair44WalkMap.rest physP = physP :=
  (renameProgram_congr_support Stair44WalkMap.rest id physP rest_fixed).trans (rename_id_prog physP)

theorem stashP : ∀ q ∈ ParkEndpoint425.dst, q ∉ wires physP := fun q hq hw =>
  (allSites_prop (List.mem_toFinset.mp (physP_wires_sub hw))).2.2.1 hq

attribute [local irreducible] swapRegisters xRelabel run in
theorem zero_phase (s : State) (m : List Bool) :
    (run physP m s).phase = s.phase := by
  rw [physP_eq_swap]
  exact (swapRegisters_correct 440 regA regB reg_len allSites_nodup s m).1

attribute [local irreducible] swapRegisters xRelabel run in
theorem control_unchanged (s : State) (m : List Bool) :
    (run physP m s).basis 440 = s.basis 440 := by
  rw [physP_eq_swap]
  have hnd := List.nodup_cons.mp allSites_nodup
  have hna : 440 ∉ regA := fun h => hnd.1 (List.mem_append_left _ h)
  have hnb : 440 ∉ regB := fun h => hnd.1 (List.mem_append_right _ h)
  exact (swapRegisters_correct 440 regA regB reg_len allSites_nodup s m).2.1 440 hna hnb

attribute [local irreducible] swapRegisters xRelabel run in
theorem self_inverse (s : State) (m n : List Bool) :
    run physP n (run physP m s) = s := by
  rw [physP_eq_swap]
  let s1 := run (swapRegisters 440 regA regB) m s
  let s2 := run (swapRegisters 440 regA regB) n s1
  have h1 := swapRegisters_correct 440 regA regB reg_len allSites_nodup s m
  have h2 := swapRegisters_correct 440 regA regB reg_len allSites_nodup s1 n
  have hnd := List.nodup_cons.mp allSites_nodup
  have hna : 440 ∉ regA := fun h => hnd.1 (List.mem_append_left _ h)
  have hnb : 440 ∉ regB := fun h => hnd.1 (List.mem_append_right _ h)
  have hc : s1.basis 440 = s.basis 440 := h1.2.1 440 hna hnb
  have hA : regValue regA s2.basis = regValue regA s.basis := by
    change regValue regA (run (swapRegisters 440 regA regB) n s1).basis = _
    rw [h2.2.2.1, hc, h1.2.2.1, h1.2.2.2]
    cases s.basis 440 <;> rfl
  have hB : regValue regB s2.basis = regValue regB s.basis := by
    change regValue regB (run (swapRegisters 440 regA regB) n s1).basis = _
    rw [h2.2.2.2, hc, h1.2.2.1, h1.2.2.2]
    cases s.basis 440 <;> rfl
  have hndAB := List.nodup_append.mp hnd.2
  apply State.extensionality
  · exact h2.1.trans h1.1
  · funext q
    by_cases hqa : q ∈ regA
    · exact (regValue_eq_iff regA s2.basis s.basis).mp hA q hqa
    · by_cases hqb : q ∈ regB
      · exact (regValue_eq_iff regB s2.basis s.basis).mp hB q hqb
      · exact (h2.2.1 q hqa hqb).trans (h1.2.1 q hqa hqb)

def readOnly (q : Wire) : Prop := q ∉ allSites ∨ q = 440

instance (q : Wire) : Decidable (readOnly q) := by unfold readOnly; infer_instance

theorem observes (q : Wire) (h : readOnly q) (s : State) (m : List Bool) :
    (run physP m s).basis q = s.basis q := by
  rcases h with h | rfl
  · exact run_preserves_outside _ _ _ _ (fun hw => h (List.mem_toFinset.mp (physP_wires_sub hw)))
  · exact control_unchanged s m

theorem bank_readOnly : ∀ i : Fin 23, readOnly (rawPorts ⟨i, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩) := by
  intro i
  by_cases hm : rawPorts ⟨i, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩ ∈ allSites
  · right
    have hp := (allSites_prop hm).2.2.2.1
    rcases hp with h440 | hnb
    · exact h440
    · exact False.elim (hnb (List.mem_map.mpr ⟨i, List.mem_finRange i, rfl⟩))
  · exact Or.inl hm

theorem hist_readOnly : ∀ q : Fin 10, readOnly (OB5.sig 425 (History5.historyMap base 410 q)) := by
  intro q
  by_cases hm : OB5.sig 425 (History5.historyMap base 410 q) ∈ allSites
  · right
    have hp := (allSites_prop hm).2.2.2.2.2.1
    rcases hp with h440 | hnh
    · exact h440
    · exact False.elim (hnh (List.mem_map.mpr ⟨q, List.mem_finRange q, rfl⟩))
  · exact Or.inl hm

theorem readOnly_of_range {q : Wire}
    (h : q = 440 ∨ ¬ ((440 ≤ (q : Nat) ∧ (q : Nat) ≤ 528) ∨ (786 ≤ (q : Nat) ∧ (q : Nat) ≤ 873))) :
    readOnly q := by
  rcases h with rfl | hout
  · exact Or.inr rfl
  · exact Or.inl (fun hm => hout (allSites_range q hm))

theorem scratch_off : ∀ i : Fin 157, 23 ≤ i.val → rawPorts i ∉ wires physP := by
  intro i hi hw
  have hp := (allSites_prop (List.mem_toFinset.mp (physP_wires_sub hw))).2.2.2.2.1
  apply hp
  let k : Fin 134 := ⟨i.val - 23, by have := i.isLt; omega⟩
  refine List.mem_map.mpr ⟨k, List.mem_finRange k, ?_⟩
  congr 1; apply Fin.ext; dsimp only [k]; omega

end ECDSAAdd.Entrant.StairPacket.EndOrient425

/-! ### `EndTick425` (`d = false` exit step: `TickRanges.tick base 425`) -/

namespace ECDSAAdd.Entrant.StairPacket.EndTick425

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Secp256k1
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.ParkEndpoint425
open ECDSAAdd.Entrant.StairPacket.ArchiveBoundary425

set_option maxRecDepth 30000
set_option maxHeartbeats 5000000
set_option exponentiation.threshold 1024
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def L : SkywalkIntegerLayout := W.compactSkywalkTickLayout base 425
def P : Program := TickRanges.tick base 425
def Q : Program := W.ReverseCarry.compactReceiverTick base 425
def physP : Program := renameProgram (OB5.sig 425) P
def physQ : Program := renameProgram (OB5.sig 425) Q
def canonical : Program := W.compactSkywalkTick base 425
def Reads (a b : State) : Prop := ∀ q ∈ L.wires.toFinset, a.basis q = b.basis q

theorem supports : wires P ⊆ L.wires.toFinset ∧ wires Q ⊆ L.wires.toFinset :=
  ⟨(TickRanges.tick_support base 425 (by decide) base_pool_nodup).trans
    (W.repairedTick_support base 425 (by decide) base_pool_nodup),
   W.ReverseCarry.compactReceiverTick_support base 425 (by decide) base_pool_nodup⟩

theorem counts :
    toffoliCount physP = 172 ∧ measurementCount physP = 87 ∧
    toffoliCount physQ = 172 ∧ measurementCount physQ = 86 := by
  have ft := TickRanges.tick_counts base 425 (by decide) base_pool_nodup
  have rt := W.repairedTick_counts base 425 (by decide) base_pool_nodup
  have st := W.compactSkywalkTick_counts base 425 (by decide) base_pool_nodup
  have bt := W.ReverseCarry.compactReceiverTick_counts base 425 (by decide) base_pool_nodup
  have ot := W.compactSkywalkReverseTick_counts base 425 (by decide) base_pool_nodup
  simp only [physP, physQ, P, Q, (renameProgram_counts _ _).1, (renameProgram_counts _ _).2]
  have h1 : W.compactSkywalkTickPreWidth 425 = 88 ∧ W.compactSkywalkTickPostWidth 425 = 87 ∧
      W.repairDue 425 = 1 ∧ W.fwdDue 425 = 0 ∧ TickRanges.due 425 = 0 ∧ ¬ W.trimTick 425 := by
    unfold W.compactSkywalkTickPreWidth W.compactSkywalkTickPostWidth W.narrowSkywalkRouteWidth
      W.narrowSkywalkWidth W.repairDue W.fwdDue TickRanges.due W.trimTick
    decide
  simp only [h1.2.2.2.2.2, if_false] at rt st bt ot
  omega

theorem physical_free (R : Program) (sub : wires R ⊆ L.wires.toFinset) (q : Wire)
    (off : OB5.sig 425 q ∉ L.wires) : q ∉ wires (renameProgram (OB5.sig 425) R) := by
  rw [JointForward1588.wires_rename_image]
  intro h
  obtain ⟨w, mem, rfl⟩ := Finset.mem_image.mp h
  rw [OB5.sig_invol 425 (by decide)] at off
  exact off (List.mem_toFinset.mp (sub mem))

theorem spared : ∀ q ∈ ParkEndpoint425.dst, OB5.sig 425 q ∉ L.wires := by decide +kernel
theorem stashP : ∀ q ∈ ParkEndpoint425.dst, q ∉ wires physP := fun q hit => physical_free P supports.1 q (spared q hit)
theorem stashQ : ∀ q ∈ ParkEndpoint425.dst, q ∉ wires physQ := fun q hit => physical_free Q supports.2 q (spared q hit)

theorem apply_old (d : Bool) (x : Nat) (hx0 : 0 < x) (hx : x < p) (actual original : State)
    (read : Reads actual original) (stage : Rolling1588.Integer.Stage base d x p 425 original.basis) (a b : List Bool) :
    run P a actual = run canonical b actual := by
  obtain ⟨w, sw, agree⟩ := Rolling1588.Integer.old_stage_local base d base_pool_nodup x p 425 (by decide) original stage
  have old := TickRanges.tick_eq5 x hx0 hx 425 (by decide) w a sw
  have same := Stack5.local_replace P (W.repairedTick base 425) L.wires.toFinset supports.1
    (W.repairedTick_support base 425 (by decide) base_pool_nodup) original w a a agree old
  have ⟨hp0, hpo, hp, cop⟩ := StackOB5.prime_facts x hx0 hx
  have gap : p + 2 ^ 32 ≤ 2 ^ 256 := by norm_num [p]
  have reference := Rolling1588.Integer.repaired_eq base d base_pool_nodup x p 425 hp0 hx0 hpo hp gap hx cop (by decide) original a b stage
  exact Stack5.local_replace P canonical L.wires.toFinset supports.1
    (W.compactSkywalkTick_support base 425 (by decide) base_pool_nodup) actual original a b read (same.trans reference)

theorem compact_undo (d : Bool) (x : Nat) (hx0 : 0 < x) (hx : x < p) (actual original : State)
    (read : Reads actual original) (stage : Rolling1588.Integer.Stage base d x p 425 original.basis) (a b : List Bool) :
    run Q b (run canonical a actual) = actual := by
  obtain ⟨ref, stock, agree⟩ := EndTick4207.local_reference 425 (by decide) d x original stage
  have ⟨hp0, hpo, hp, cop⟩ := StackOB5.prime_facts x hx0 hx
  have gap : p + 2 ^ 32 ≤ 2 ^ 256 := by norm_num [p]
  exact EndTick4207.undo_on_domain base base_pool_nodup x p 425 (by decide) hp0 hx0 hpo hp gap hx cop actual ref a b stock
    (fun q h => (read _ (List.mem_toFinset.mpr h)).trans (agree _ (List.mem_toFinset.mpr h)))

theorem physical (d : Bool) (x : Nat) (hx0 : 0 < x) (hx : x < p) (raw original tags : State)
    (read : Reads raw original) (stage : Rolling1588.Integer.Stage base d x p 425 original.basis)
    (hist : raw.basis (base (1028 + 425)) = false) (swapSlot : raw.basis (base (2053 - 425)) = false)
    (m : List Bool) :
    let start := ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)
    let out := run physP m start
    out = ParkEndpoint425.stash tags (pullState (OB5.sig 425) (run canonical [] raw)) ∧
    ∀ t, run physQ t out = start := by
  have pre : pullState (OB5.sig 424) raw = pullState (OB5.sig 425) raw :=
    OB5.pull_step 425 (by decide) raw hist (fun _ => swapSlot)
  have result : run physP m (ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)) =
      ParkEndpoint425.stash tags (pullState (OB5.sig 425) (run canonical [] raw)) := by
    rw [ParkEndpoint425.commutes _ stashP, pre, physP, OB5.run_rename _ (by decide),
      apply_old d x hx0 hx raw original read stage m []]
  refine ⟨result, ?_⟩
  intro t
  rw [result, ParkEndpoint425.commutes _ stashQ, physQ, OB5.run_rename _ (by decide),
    compact_undo d x hx0 hx raw original read stage, ← pre]

def readOnly (q : Wire) : Prop := OB5.sig 425 q ∉ L.wires ∨ q = 440

instance (q : Wire) : Decidable (readOnly q) := by unfold readOnly; infer_instance

theorem observes (q : Wire) (h : readOnly q) (s : State) (m : List Bool)
    (prev : (run physP m s).basis 440 = s.basis 440) : (run physP m s).basis q = s.basis q := by
  rcases h with h | rfl
  · exact run_preserves_outside _ _ _ _ (physical_free P supports.1 _ h)
  · exact prev

private theorem oldBank_ok :
    let lw := L.wires
    (List.finRange 23).all (fun i =>
      let w := rawPorts ⟨i.val, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩
      decide (OB5.sig 425 w ∉ lw) || decide (w = 440)) = true := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem oldBank : ∀ i : Fin 23, readOnly (rawPorts ⟨i, Nat.lt_trans i.isLt (by decide : 23 < 157)⟩) := by
  intro i
  have h := List.all_eq_true.mp oldBank_ok i (List.mem_finRange i)
  simp only [Bool.or_eq_true, decide_eq_true_eq] at h
  exact h

theorem scratch_table : ∀ i : Fin 157, 23 ≤ i.val →
    rawPorts i ∉ ParkEndpoint425.dst ∧ OB5.sig 425 (rawPorts i) = Shadow7.scratchX 425 (i.val - 23) := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

private theorem exposed_lanes_ok :
    ∀ k : Fin 134,
      if k.val + 425 < 512 then
        1556 + k.val ∈ L.carry ∧ 1556 + k.val ∈ wireBlock base 1540 257
      else
        (790 + k.val : Wire) ∉ L.wires := by
  have hall :
      (let lc := L.carry
       let wb := wireBlock base 1540 257
       let lw := L.wires
       (List.finRange 134).all (fun k =>
         if k.val + 425 < 512 then
           decide (1556 + k.val ∈ lc) && decide (1556 + k.val ∈ wb)
         else
           decide ((790 + k.val : Wire) ∉ lw))) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro k
  have hk := List.all_eq_true.mp hall k (List.mem_finRange k)
  by_cases hlt : k.val + 425 < 512
  · simp only [hlt, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hk ⊢
    exact hk
  · simp only [hlt, ↓reduceIte, decide_eq_true_eq] at hk ⊢
    exact hk

theorem exposed (d : Bool) (x : Nat) (hx0 : 0 < x) (hx : x < p) (raw original tags : State)
    (read : Reads raw original) (stage : Rolling1588.Integer.Stage base d x p 425 original.basis)
    (hist : raw.basis (base (1028 + 425)) = false) (swapSlot : raw.basis (base (2053 - 425)) = false)
    (hosts : ∀ k : Fin 134, 512 ≤ k.val + 425 → raw.basis (790 + k.val) = false) (m : List Bool) :
    let start := ParkEndpoint425.stash tags (pullState (OB5.sig 424) raw)
    let out := run physP m start
    out.phase = start.phase ∧ out.basis 440 = start.basis 440 ∧
    ∀ i : Fin 157, 23 ≤ i.val → out.basis (rawPorts i) = false := by
  obtain ⟨ref, old, ag⟩ := EndTick4207.local_reference 425 (by decide) d x original stage
  have ⟨hp0, hpo, hp, cop⟩ := StackOB5.prime_facts x hx0 hx
  have gap : p + 2 ^ 32 ≤ 2 ^ 256 := by norm_num [p]
  have r : Reads raw ref := fun q h => (read q h).trans (ag q h)
  have next := (W.compactSkywalkStageStep base base_pool_nodup x p 425 hp0 hx0 hpo hp gap hx cop (by decide) ref [] old).2
  have post := EndTick4207.canonical_reads 425 (by decide) ref raw r []
  have hph : (run canonical [] raw).phase = raw.phase := by
    have st := (W.compactSkywalkStageStep base base_pool_nodup x p 425 hp0 hx0 hpo hp gap hx cop (by decide) ref [] old).1
    have inc := (run_local_increment canonical raw ref [] (fun q h =>
      r q (W.compactSkywalkTick_support base 425 (by decide) base_pool_nodup h))).1
    change (run canonical [] ref).phase = ref.phase at st
    rw [st, Bool.xor_self] at inc
    revert inc
    generalize (run canonical [] raw).phase = a
    generalize raw.phase = b
    cases a <;> cases b <;> simp
  have h440 : (run canonical [] raw).basis 440 = raw.basis 440 := by
    have prev : 440 ∈ L.wires.toFinset := EndTick4207.previous_member 425
    have a := EndTick4207.pastG 425 424 (by decide) (by decide) _ _ old
    have b := EndTick4207.pastG 426 424 (by decide) (by decide) _ _ next
    exact (post _ prev).trans (b.trans (a.symm.trans (r _ prev).symm))
  have hscr : ∀ k : Fin 134, (run canonical [] raw).basis (Shadow7.scratchX 425 k.val) = false := fun k => by
    have hl := exposed_lanes_ok k
    by_cases hk : k.val + 425 < 512
    · rw [if_pos hk] at hl
      rw [Shadow7.scratchX_plain 425 k.val (by decide) hk]
      exact (post _ (EndTick4207.carry_member 425 _ hl.1)).trans
        (EndTick4207.full_carry 426 (by decide) _ _ next _ hl.2)
    · rw [if_neg hk] at hl
      rw [Shadow7.scratchX_host 425 k.val (by decide) (by decide) (by omega),
        run_preserves_outside canonical [] raw _ (fun used => hl
          (List.mem_toFinset.mp (W.compactSkywalkTick_support base 425 (by decide) base_pool_nodup used)))]
      exact hosts k (by omega)
  have out := (physical d x hx0 hx raw original tags read stage hist swapSlot m).1
  have h440_off : (440 : Wire) ∉ ParkEndpoint425.dst := by decide
  have hsig440 : OB5.sig 425 440 = 440 ∧ OB5.sig 424 440 = 440 := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  dsimp only
  rw [out]
  refine ⟨?_, ?_, fun i hi => ?_⟩
  · simp only [ParkEndpoint425.stash, pullState]
    exact hph
  · simp only [ParkEndpoint425.stash, if_neg h440_off, pullState, hsig440.1, hsig440.2]
    exact h440
  · have ⟨off, eq⟩ := scratch_table i hi
    simp only [ParkEndpoint425.stash, if_neg off, pullState]
    exact (congrArg (run canonical [] raw).basis eq).trans (hscr ⟨i.val - 23, by have := i.isLt; omega⟩)

