private theorem pool_origin20 {s prevLen curLen x p : Nat} (hprev : prevLen ≤ s) (hc : 1 ≤ curLen)
    (limit : s + curLen ≤ 512) (good : Bounds x p) (raw history : State) (dom : Domain s x p raw)
    (q : Nat) (hq1 : s + curLen + 16 ≤ q) (hq2 : q < 1044)
    (rel : q ∈ (W.compactSkywalkSignPoolA base (s + curLen)).released ∨
           q ∈ (W.compactSkywalkSignPoolB base (s + curLen)).released) :
    (WideReference20.origin s prevLen curLen raw history).basis q = false := by
  have ident : OB5.sig (s + curLen - 1) q = q := by
    unfold OB5.sig; rw [if_neg (by (try unfold Wire at *); omega)]
  have clear : q ∉ WideReference20.sites s prevLen curLen := by
    intro hit
    have old := (WideReference20.mem_sites (by omega) q).mp hit
    rw [ident] at old
    obtain ⟨r, _, lt, h | h⟩ := WideReference20.old_cell old <;> omega
  rw [WideReference20.outside s prevLen curLen raw history q clear, ident]
  obtain ⟨ref, coh, valid⟩ := dom
  have stepCoh := coherent_span s curLen limit raw ref coh []
  have stepVal := full_span s curLen x p limit good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime ref [] valid
  have notE : ¬ Earlier (s + curLen) q := by
    rintro ⟨r, hr, h | h⟩ <;> simp only [base, Wire] at * <;> omega
  rw [stepCoh.2 q notE]
  rcases rel with rA | rB
  · exact stepVal.2.1 q rA
  · exact stepVal.2.2 q rB

private theorem band_origin20 {s prevLen curLen x p : Nat} (hprev : prevLen ≤ s) (hc : 1 ≤ curLen)
    (limit : s + curLen ≤ 512) (good : Bounds x p) (raw history : State) (dom : Domain s x p raw)
    (q : Nat) (low : 1301 ≤ q) (high : q ≤ 1044 + (s + curLen - 1)) :
    (WideReference20.origin s prevLen curLen raw history).basis q = false := by
  have map : OB5.sig (s + curLen - 1) q = (3113 - q : Nat) := by
    unfold OB5.sig; rw [if_pos (by (try unfold Wire at *); omega)]
  have clear : q ∉ WideReference20.sites s prevLen curLen := by
    intro hit
    have old := (WideReference20.mem_sites (by omega) q).mp hit
    rw [map] at old
    obtain ⟨r, _, lt, h | h⟩ := WideReference20.old_cell old <;> omega
  rw [WideReference20.outside s prevLen curLen raw history q clear, map]
  exact full_carry s curLen x p limit good raw dom [] _ (by omega) (by omega)

theorem releasedOrigin20 (j : Fin 10) (x p : Nat) (good : Bounds x p) (raw history : State)
    (dom : Domain (start20 j) x p raw) (q : Nat) (site : releasedSite20 j q) :
    (WideReference20.origin (start20 j) (prevLen20 j) 20 raw history).basis q = false := by
  have hg := geom20_facts j; dsimp only at hg
  have hw := width20 j; unfold W.compactSkywalkTickPreWidth at hw
  have hR : railP (start20 j) ≤ 258 ∧ railP (start20 j + 20) ≤ railP (start20 j) := by
    unfold railP; constructor <;> split_ifs <;> omega
  have hprev : prevLen20 j ≤ start20 j := by unfold prevLen20; split_ifs <;> omega
  unfold releasedSite20 at site
  rcases site with ⟨shrink, rfl⟩ | ⟨lo, hi⟩ | ⟨lo, hi⟩
  · exact pool_origin20 hprev (by decide) (by omega) good raw history dom _ (by omega) (by omega)
      (Or.inl (poolA_released _ _ (by omega) (by omega) (by omega)))
  · exact pool_origin20 hprev (by decide) (by omega) good raw history dom _ (by omega) (by omega)
      (Or.inr (poolB_released _ _ (by omega) (by omega) (by omega)))
  · exact band_origin20 hprev (by decide) (by omega) good raw history dom q lo (by omega)

attribute [local irreducible] run SkywalkNat.step leaveP20 in
theorem releasedActual20 (j : Fin 10) (x p : Nat) (good : Bounds x p) (raw v : State)
    (dom : Domain (start20 j) x p raw) (m : List Bool)
    (pre : ∀ q : Wire, (railP (start20 j + 20) < railP (start20 j) ∧ q = start20 j + 36 + railP (start20 j + 20)) ∨
      (1301 ≤ q ∧ q ≤ 1063 + start20 j) → v.basis q = false)
    (clear : ∀ q ∈ zeros20 j, (run (leaveP20 j) m v).basis q = false) :
    ∀ q : Wire, releasedSite20 j q → (run (leaveP20 j) m v).basis q = (WideReference20.origin (start20 j) (prevLen20 j) 20 raw v).basis q := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hR : railP (start20 j + 20) ≤ railP (start20 j) := by unfold railP; split_ifs <;> omega
  have hrelA : railP (start20 j + 20) < railP (start20 j) → a0P20 (start20 j) + 21 < start20 j + 36 + railP (start20 j + 20) := by
    have : ∀ k : Fin 10, railP (start20 k + 20) < railP (start20 k) → a0P20 (start20 k) + 21 < start20 k + 36 + railP (start20 k + 20) := by
      decide +kernel
    exact this j
  intro q site
  rw [releasedOrigin20 j x p good raw v dom q site]
  rcases site with ⟨shrink, hq⟩ | ⟨lo, hi⟩ | ⟨lo, hi⟩
  · have hlt := hrelA shrink
    have hloB : start20 j + 36 + railP (start20 j + 20) < b0P20 (start20 j) - 1 := by
      unfold railP at *; split_ifs at * <;> omega
    rw [leave20_keeps j q (by unfold leaveBox20; unfold Wire at *; omega) m v]
    exact pre q (Or.inl ⟨shrink, hq⟩)
  · exact clear q (by simp only [zeros20, List.mem_append, List.mem_range'_1, bTopP]; right; unfold Wire at *; omega)
  · rw [leave20_keeps j q (by unfold leaveBox20; unfold Wire at *; omega) m v]
    exact pre q (Or.inr ⟨lo, hi⟩)

private theorem cells20_eq_local (j : Fin 10) (b : BasisState) :
    readCells (shape20 j) 0 20 (mappedBasis20 j b) =
      (List.range 20).map (fun k => (b (start20 j + 16 + k), b (swaps20 j k))) := by
  have hg := geom20_facts j; dsimp only at hg
  have hgeom : ∀ k : Fin 20,
      windowNet20 j (IntegerPacket.ports (shape20 j) k.val).a0 = start20 j + 16 + k.val ∧
      windowNet20 j (IntegerPacket.ports (shape20 j) k.val).history = swaps20 j k.val := fun k => by
    have hk := k.isLt
    constructor
    · show OB5.sig (start20 j + 19) (start20 j + k.val + 16) = start20 j + 16 + k.val
      rw [sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)]
      (try unfold Wire at *); omega
    · show OB5.sig (start20 j + 19) (start20 j + k.val + 16 + 1028) = OB5.sig (start20 j + 19) (start20 j + 1044 + k.val)
      congr 1; (try unfold Wire at *); omega
  have aux : ∀ i n, i + n ≤ 20 → readCells (shape20 j) i n (mappedBasis20 j b) =
      (List.range' i n).map (fun k => (b (start20 j + 16 + k), b (swaps20 j k))) := by
    intro i n; induction n generalizing i with
    | zero => intro _; rfl
    | succ n ih =>
      intro hn
      simp only [readCells, List.range'_succ, List.map_cons]
      have h0 := hgeom ⟨i, by omega⟩
      congr 1
      · change (b (windowNet20 j (IntegerPacket.ports (shape20 j) i).a0),
            b (windowNet20 j (IntegerPacket.ports (shape20 j) i).history)) = _
        rw [h0.1, h0.2]
      · exact ih (i + 1) (by omega)
  simpa [List.range_eq_range'] using aux 0 20 (by decide)

private theorem recorded_equal20 (j : Fin 10) (x p : Nat) (good : Bounds x p) (raw history : State)
    (dom : Domain (start20 j) x p raw) (g sg : Bool)
    (input : InputAt (start20 j) (SkywalkRails.encode g sg (unsigned (start20 j) x p).u (unsigned (start20 j) x p).v) raw)
    (record : physicalCells20 j history = SkywalkTrace.trace 20 (SkywalkRails.encode g sg (unsigned (start20 j) x p).u (unsigned (start20 j) x p).v))
    (k : Fin 20) :
    (history.basis (start20 j + 16 + k.val), history.basis (swaps20 j k.val)) =
      ((WideReference20.origin (start20 j) (prevLen20 j) 20 raw history).basis (start20 j + 16 + k.val),
       (WideReference20.origin (start20 j) (prevLen20 j) 20 raw history).basis (swaps20 j k.val)) := by
  have hg := geom20_facts j; dsimp only at hg
  have eqCan := unique_input input (fixed_input _ _ _ (by omega) good raw dom)
  rw [eqCan] at record
  have hcell : (history.basis (start20 j + 16 + k.val), history.basis (swaps20 j k.val)) =
      SkywalkTrace.code (WideReference.canonical (start20 j + k.val) x p) := by
    have hc := congrArg (fun l : List (Bool × Bool) => StairArchiveRaw.read l k.val) record
    have hread : StairArchiveRaw.read (physicalCells20 j history) k.val =
        (history.basis (start20 j + 16 + k.val), history.basis (swaps20 j k.val)) := by
      unfold physicalCells20 StairArchiveRaw.read
      rw [cells20_eq_local j history.basis]
      have hlt : k.val < ((List.range 20).map (fun r => (history.basis (start20 j + 16 + r), history.basis (swaps20 j r)))).length := by
        simp [k.isLt]
      rw [List.getElem?_eq_getElem hlt, Option.getD_some, List.getElem_map, List.getElem_range]
    dsimp only at hc
    rw [hread, WideReference.read_trace _ _ k.isLt] at hc
    have reorder : WideReference.canonical (start20 j + k.val) x p =
        SkywalkTrace.next^[k.val] (WideReference.canonical (start20 j) x p) := by
      rw [Nat.add_comm]; exact Function.iterate_add_apply _ _ _ _
    exact hc.trans (congrArg _ reorder.symm)
  have hspan := WideReference.trace_sites (start20 j) 20 x p (by omega) good raw [] dom
    (start20 j + k.val) (by omega) (by have := k.isLt; omega)
  have h19 : start20 j + 20 - 1 = start20 j + 19 := by omega
  have hprev : prevLen20 j ≤ start20 j := by unfold prevLen20; split_ifs <;> omega
  have h1out : (start20 j + 16 + k.val : Wire) ∉ WideReference20.sites (start20 j) (prevLen20 j) 20 := by
    intro hm; have old := (WideReference20.mem_sites (by omega) _).mp hm
    rw [h19] at old
    have hfix : OB5.sig (start20 j + 19) (start20 j + 16 + k.val) = start20 j + 16 + k.val :=
      sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)
    rw [hfix] at old; obtain ⟨r, _, lt, h | h⟩ := WideReference20.old_cell old <;> omega
  have h2out : swaps20 j k.val ∉ WideReference20.sites (start20 j) (prevLen20 j) 20 := by
    intro hm; have old := (WideReference20.mem_sites (by omega) _).mp hm
    rw [h19] at old
    have hinv : OB5.sig (start20 j + 19) (swaps20 j k.val) = start20 j + 1044 + k.val :=
      OB5.sig_invol (start20 j + 19) (by omega) (start20 j + 1044 + k.val)
    rw [hinv] at old; obtain ⟨r, _, lt, h | h⟩ := WideReference20.old_cell old <;> omega
  have hfix1 : OB5.sig (start20 j + 19) (start20 j + 16 + k.val) = base (start20 j + k.val) := by
    rw [sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)]
    simp only [base, Wire]; omega
  have hinv2 : OB5.sig (start20 j + 19) (swaps20 j k.val) = base (1028 + (start20 j + k.val)) := by
    have hi := OB5.sig_invol (start20 j + 19) (by omega) (start20 j + 1044 + k.val)
    change OB5.sig (start20 j + 19) (swaps20 j k.val) = 1028 + (start20 j + k.val) + 16
    exact hi.trans (by (try unfold Wire at *); omega)
  rw [WideReference20.outside _ _ _ _ _ _ h1out, WideReference20.outside _ _ _ _ _ _ h2out, h19, hfix1, hinv2]
  exact hcell.trans (Prod.ext hspan.1 hspan.2).symm

attribute [local irreducible] run SkywalkNat.step leaveP20 in
theorem frameHistory20 (j : Fin 10) (x p : Nat) (good : Bounds x p) (raw s : State) (m : List Bool) (g sg : Bool)
    (domain : Domain (start20 j) x p raw)
    (input : InputAt (start20 j) (SkywalkRails.encode g sg (unsigned (start20 j) x p).u (unsigned (start20 j) x p).v) raw)
    (record : physicalCells20 j s = SkywalkTrace.trace 20 (SkywalkRails.encode g sg (unsigned (start20 j) x p).u (unsigned (start20 j) x p).v))
    (kept : physicalCells20 j (run (leaveP20 j) m s) = physicalCells20 j s)
    (extra : ∀ q : Wire, releasedSite20 j q → (run (leaveP20 j) m s).basis q = (WideReference20.origin (start20 j) (prevLen20 j) 20 raw s).basis q) :
    ∀ q, leftovers20 j q → (run (leaveP20 j) m s).basis q = (WideReference20.origin (start20 j) (prevLen20 j) 20 raw s).basis q := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  let out := run (leaveP20 j) m s
  let o := WideReference20.origin (start20 j) (prevLen20 j) 20 raw s
  have agree (k : Fin 20) : out.basis (start20 j + 16 + k.val) = o.basis (start20 j + 16 + k.val) ∧
      out.basis (swaps20 j k.val) = o.basis (swaps20 j k.val) := by
    have old := recorded_equal20 j x p good raw s domain g sg input record k
    have hnow := congrArg (fun l : List (Bool × Bool) => l[k.val]?) kept
    dsimp only at hnow
    unfold physicalCells20 at hnow
    rw [cells20_eq_local j out.basis, cells20_eq_local j s.basis] at hnow
    have hlt1 : k.val < ((List.range 20).map (fun r => (out.basis (start20 j + 16 + r), out.basis (swaps20 j r)))).length := by simp [k.isLt]
    have hlt2 : k.val < ((List.range 20).map (fun r => (s.basis (start20 j + 16 + r), s.basis (swaps20 j r)))).length := by simp [k.isLt]
    rw [List.getElem?_eq_getElem hlt1, List.getElem?_eq_getElem hlt2] at hnow
    simp only [Option.some.injEq, List.getElem_map, List.getElem_range] at hnow
    have eq := hnow.trans old
    exact ⟨congrArg Prod.fst eq, congrArg Prod.snd eq⟩
  have inSites : (start20 j + 15 : Wire) ∈ WideReference20.sites (start20 j) (prevLen20 j) 20 := by
    rw [WideReference20.mem_sites (by omega), sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)]
    unfold WideReference20.oldSites
    refine List.mem_flatMap.mpr ⟨start20 j - 1, List.mem_range'_1.mpr ⟨by unfold prevLen20; split_ifs <;> omega, by unfold prevLen20; split_ifs <;> omega⟩, ?_⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false, base]; left; (try unfold Wire at *); omega
  have previous : out.basis (start20 j + 15) = o.basis (start20 j + 15) := by
    rw [show o.basis (start20 j + 15) = s.basis (start20 j + 15) from WideReference20.inside _ _ _ _ _ _ inSites]
    exact leave20_keeps j _ (by unfold leaveBox20; (try unfold Wire at *); omega) m s
  intro q residual
  unfold leftovers20 at residual; unfold Wire at residual
  rcases residual with ⟨lo, hi⟩ | ⟨lo, hi⟩ | rel | ⟨lo, hi, top⟩
  · by_cases e : (q : Nat) = start20 j + 15
    · rw [e]; exact previous
    · have a := (agree ⟨q - (start20 j + 16), by unfold Wire at *; omega⟩).1; dsimp only at a
      rwa [show start20 j + 16 + ((q : Nat) - (start20 j + 16)) = q by unfold Wire at *; omega] at a
  · by_cases moved : 1301 ≤ (q : Nat)
    · exact extra q (Or.inr (Or.inr ⟨moved, by omega⟩))
    · have a := (agree ⟨q - (start20 j + 1044), by unfold Wire at *; omega⟩).2; dsimp only at a
      rwa [show swaps20 j ((q : Nat) - (start20 j + 1044)) = q by
        unfold swaps20 OB5.sig; rw [if_neg (by unfold Wire at *; omega)]; unfold Wire at *; omega] at a
  · exact extra q rel
  · have a := (agree ⟨2069 - start20 j - q, by unfold Wire at *; omega⟩).2; dsimp only at a
    rwa [show swaps20 j (2069 - start20 j - (q : Nat)) = q by
      unfold swaps20 OB5.sig; rw [if_pos (by unfold Wire at *; omega)]; unfold Wire at *; omega] at a

end ECDSAAdd.Entrant.StairPacket.Shadow20.LeaveCut20
