abbrev sourceIdx425 : Fin 4 := ⟨3, by decide⟩

private def swapPairs : List (Wire × Wire) := pairs.map Prod.swap

private theorem parkP425_eq_moves : parkP425 = moves swapPairs := by decide
private theorem parkInvP425_eq_moves : parkInvP425 = moves swapPairs.reverse := by decide

theorem park (s : State) (m : List Bool) (empty : ∀ q ∈ dst, s.basis q = false) :
    run parkP425 m s = stash s (eraseSites src s) := by
  rw [parkP425_eq_moves, moves_run _ (by decide) s m]
  apply congrArg₂ State.mk rfl
  funext q
  by_cases dest : q ∈ dst
  · have hbm : ∀ w ∈ dst, backMap swapPairs w = backMap pairs w := by decide
    simp [stash, dest, hbm _ dest]
  by_cases source : q ∈ src
  · have toDst : ∀ w ∈ src, backMap swapPairs w ∈ dst := by decide
    simp [stash, eraseSites, dest, source, empty _ (toDst _ source)]
  · simp only [src, List.mem_cons, List.not_mem_nil, or_false, not_or] at source
    have nod := dest
    simp only [dst, List.mem_cons, List.not_mem_nil, or_false, not_or] at nod
    simp [stash, eraseSites, dest, src, swapPairs, pairs, backMap, source.1, source.2.1, source.2.2, nod.1, nod.2.1, nod.2.2]

theorem park_undo (s : State) (m n : List Bool) :
    run parkInvP425 n (run parkP425 m s) = s := by
  rw [parkP425_eq_moves, parkInvP425_eq_moves, moves_run _ (by decide), moves_run _ (by decide)]
  apply congrArg₂ State.mk rfl
  funext q
  by_cases h : q ∈ src ++ dst
  · have inv : ∀ w ∈ src ++ dst, backMap swapPairs (backMap swapPairs.reverse w) = w := by decide
    exact congrArg s.basis (inv _ h)
  · simp only [List.mem_append, src, dst, List.mem_cons, List.not_mem_nil, or_false, not_or] at h
    rcases h with ⟨⟨h1, h2, h3⟩, ⟨h4, h5, h6⟩⟩
    simp [swapPairs, pairs, backMap, h1, h2, h3, h4, h5, h6]

def misses425 (i : Instr) : Bool := decide (874 ∉ i.wires ∧ 875 ∉ i.wires ∧ 876 ∉ i.wires)

theorem misses425_all (P : Program) (h : P.all misses425 = true) : ∀ q ∈ dst, q ∉ wires P := by
  intro q hq
  induction P with
  | nil => simp [wires]
  | cons i P ih =>
    simp only [List.all_cons, Bool.and_eq_true] at h
    have hi : 874 ∉ i.wires ∧ 875 ∉ i.wires ∧ 876 ∉ i.wires := of_decide_eq_true h.1
    simp only [wires, Finset.mem_union, not_or]
    exact ⟨by
      rcases List.mem_cons.mp hq with rfl | h'
      · exact hi.1
      · rcases List.mem_cons.mp h' with rfl | h''
        · exact hi.2.1
        · obtain rfl := List.mem_singleton.mp h''; exact hi.2.2, ih h.2⟩

theorem avoid : ∀ q ∈ dst, q ∉ wires (Shadow7.portalP 425) := misses425_all _ (by decide +kernel)
theorem avoidInv : ∀ q ∈ dst, q ∉ wires (Shadow7.portalInvP 425) := misses425_all _ (by decide +kernel)

theorem parked_release (z : SkywalkNat.State) (small : Shadow7.SmallIfFar 36 15 z) (raw s : State) (m n : List Bool)
    (route sg : Bool)
    (input : SkywalkIntegerInput (W.compactSkywalkTickLayout base 425)
      (SkywalkRails.encode route sg z.u z.v).a (SkywalkRails.encode route sg z.u z.v).b route raw.basis)
    (cut : PackedCut loPairs hiPairs 440 1615 1613 1614 (PortalValues.negative sg z.u)
      (decide (2 * 2 ^ 51 ≤ z.u + z.v)) (decide (2 * 2 ^ 51 ≤ z.u + z.v ∧ 2 ^ 36 ≤ z.u))
      (pullState (OB5.sig 424) raw) (eraseSites src s))
    (empty : ∀ q ∈ dst, s.basis q = false) :
    let out := run (Shadow7.portalInvP 425) n (run parkP425 m s)
    out = stash s (pullState (OB5.sig 424) raw) ∧
    ∀ a b, run parkInvP425 b (run (Shadow7.portalP 425) a out) = s := by
  have fw (a : List Bool) := cut.unique (physical_frame_local z small raw a route sg input)
  have endEq : run (Shadow7.portalInvP 425) n (run parkP425 m s) = stash s (pullState (OB5.sig 424) raw) := by
    rw [park _ _ empty, commutes _ avoidInv, release z small raw _ n route sg input cut]
  refine ⟨endEq, ?_⟩
  intro a b
  rw [endEq, commutes _ avoid, ← fw, ← park s m empty, park_undo]

theorem clear_dest (d : Bool) (seed p : Nat) (raw : State)
    (stage : Rolling1588.Integer.Stage base d seed p 425 raw.basis) :
    ∀ q ∈ dst, (pullState (OB5.sig 424) raw).basis q = false := by
  have rel : ∀ q ∈ dst, OB5.sig 424 q ∈ (W.compactSkywalkSignPoolB base 425).released := by decide +kernel
  have bounds : ∀ q ∈ dst, 425 + 16 < OB5.sig 424 q ∧ OB5.sig 424 q < 1044 := by decide +kernel
  intro q hit
  exact ParkEndpoint4207.dormant 425 d seed p raw (OB5.sig 424 q) stage
    (ParkEndpoint4207.above_history 425 (by decide) d _ (bounds _ hit).1 (bounds _ hit).2) (rel _ hit)

def ordinary425 (q : Wire) : Prop :=
  q ∉ src ∧ q ∉ dst ∧ q ≠ 1615 ∧ q ≠ 1613 ∧ q ≠ 1614 ∧ q ∉ RailPair.sites hiPairs

instance (q : Wire) : Decidable (ordinary425 q) := by unfold ordinary425; infer_instance

theorem past_sites425 : ∀ r : Fin 15,
    ordinary425 (windowNet15E sourceIdx425 (ports (shape15E sourceIdx425) r).a0) ∧
    ordinary425 (windowNet15E sourceIdx425 (ports (shape15E sourceIdx425) r).history) := by
  ((try unfold ordinary425); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem past_cells425 (raw s : State) (n f u : Bool)
    (cut : PackedCut loPairs hiPairs 440 1615 1613 1614 n f u (pullState (OB5.sig 424) raw) (eraseSites src s)) :
    physicalCells15E sourceIdx425 (stash s (pullState (OB5.sig 424) raw)) = physicalCells15E sourceIdx425 s := by
  have ear (q : Wire) (clean : ordinary425 q) : (stash s (pullState (OB5.sig 424) raw)).basis q = s.basis q := by
    obtain ⟨hs, hd, hn, hf, hu, hh⟩ := clean
    have eq := cut.unchanged _ hn hf hu hh
    simpa [stash, eraseSites, hs, hd] using eq.symm
  have aux : ∀ (i k : Nat), i + k ≤ 15 →
      readCells (shape15E sourceIdx425) i k (mappedBasis15E sourceIdx425 (stash s (pullState (OB5.sig 424) raw)).basis) =
      readCells (shape15E sourceIdx425) i k (mappedBasis15E sourceIdx425 s.basis) := by
    intro i k
    induction k generalizing i with
    | zero => intro _; rfl
    | succ k ih =>
      intro hk
      simp only [readCells]
      exact congrArg₂ List.cons
        (Prod.ext (ear _ (past_sites425 ⟨i, by omega⟩).1) (ear _ (past_sites425 ⟨i, by omega⟩).2))
        (ih (i + 1) (by omega))
  exact aux 0 15 (by decide)

theorem empty_from_cut425 (raw s : State) (n f u : Bool)
    (cut : PackedCut loPairs hiPairs 440 1615 1613 1614 n f u (pullState (OB5.sig 424) raw) (eraseSites src s))
    (source : ∀ q ∈ dst, (pullState (OB5.sig 424) raw).basis q = false) :
    ∀ q ∈ dst, s.basis q = false := by
  have regular : ∀ q ∈ dst, q ∉ src ∧ q ≠ 1615 ∧ q ≠ 1613 ∧ q ≠ 1614 ∧ q ∉ RailPair.sites hiPairs := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro q member
  obtain ⟨out, hn, hf, hu, hh⟩ := regular _ member
  have eq := cut.unchanged q hn hf hu hh
  simpa [eraseSites, out] using eq.trans (source _ member)

