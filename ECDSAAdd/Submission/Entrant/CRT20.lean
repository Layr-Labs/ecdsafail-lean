  have ch2 : GateMirror.forward (chainG (fun i => (1558 + i : Wire)) (fun i => b0P20 (start20 j) - 1 + i)
      [.cx (1558 + lowsP20 (start20 j)) 1556, .x 1556] 0 (lowsP20 (start20 j))) =
