private theorem phys_flatten (ls : List Program) (h : ∀ p ∈ ls, GatePhysical p) :
    GatePhysical ls.flatten := by
  induction ls with
  | nil => intro i hi; cases hi
  | cons p ps ih =>
    exact WindowPhysicalW.appP (h p List.mem_cons_self) (ih fun q hq => h q (List.mem_cons_of_mem _ hq))

private theorem cov_flatten (ls : List Program) (h : ∀ p ∈ ls, WindowCovered.CoveredW p) :
    WindowCovered.CoveredW ls.flatten := by
  induction ls with
  | nil => intro q hq; simp [wires] at hq
  | cons p ps ih =>
    exact WindowCovered.appW (h p List.mem_cons_self) (ih fun q hq => h q (List.mem_cons_of_mem _ hq))

