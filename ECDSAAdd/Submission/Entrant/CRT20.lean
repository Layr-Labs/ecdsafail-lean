set_option maxRecDepth 30000
set_option maxHeartbeats 5000000
set_option linter.unusedSimpArgs false

def src : List Wire := [1616, 1617, 1618]
def dst : List Wire := [874, 875, 876]
def pairs : List (Wire × Wire) := [(874, 1616), (875, 1617), (876, 1618)]

def parkOps425 : List Gate := swapsG [(874, 1616), (875, 1617), (876, 1618)]
def parkP425 : Program := GateMirror.forward parkOps425
def parkInvP425 : Program := GateMirror.inverse parkOps425

theorem park425_counts :
    toffoliCount parkP425 = 0 ∧ toffoliCount parkInvP425 = 0 ∧
    measurementCount parkP425 = 0 ∧ measurementCount parkInvP425 = 0 ∧
    Challenge.gateSlots parkP425 = 9 ∧ Challenge.gateSlots parkInvP425 = 9 := by
  decide +kernel

theorem park425_phys :
    GatePhysical parkP425 ∧ GatePhysical parkInvP425 := by
  exact physical_of_proper parkOps425 (by decide)

theorem park425_cov :
    WindowCovered.CoveredW parkP425 ∧ WindowCovered.CoveredW parkInvP425 := by
  have hall : AllW (fun q => WindowCovered.domainW q = true) parkOps425 := fun g hg q hq =>
    List.all_eq_true.mp (List.all_eq_true.mp
      (by decide : parkOps425.all (fun g => g.wires.all WindowCovered.domainW) = true) g hg) q hq
  exact allW_programs hall

def stash (payload : State) (s : State) : State :=
  ⟨s.phase, fun q => if q ∈ dst then payload.basis (backMap pairs q) else s.basis q⟩

theorem commutes (p : Program) (free : ∀ q ∈ dst, q ∉ wires p) (m : List Bool) (payload s : State) :
    run p m (stash payload s) = stash payload (run p m s) := by
  have agree : ∀ q ∈ wires p, (stash payload s).basis q = s.basis q := by
    intro q hq
    have hnd : q ∉ dst := fun hd => free q hd hq
    simp [stash, hnd]
  have eq := run_local_increment p (stash payload s) s m agree
  apply state_eq
  · have hp := eq.1
    change ((run p m (stash payload s)).phase ^^ s.phase) = ((run p m s).phase ^^ s.phase) at hp
    change (run p m (stash payload s)).phase = (run p m s).phase
    revert hp
    cases (run p m (stash payload s)).phase <;> cases (run p m s).phase <;> cases s.phase <;> decide
  · intro q
    by_cases hq : q ∈ wires p
    · have hnd : q ∉ dst := fun hd => free q hd hq
      simpa [stash, hnd] using eq.2 q hq
    · have p1 := run_preserves_outside p m (stash payload s) q hq
      have p2 := run_preserves_outside p m s q hq
      by_cases hd : q ∈ dst
      · simpa [stash, hd] using p1
      · simp only [stash, hd, ↓reduceIte] at p1 ⊢
        exact p1.trans p2.symm

theorem tag_address (s other : State) :
    (stash s other).basis 874 = s.basis 1616 ∧
