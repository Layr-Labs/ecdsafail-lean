private theorem allW_uncomputeOps {P : Wire → Prop} {gs : List Gate} (h : AllW P gs) : AllW P (uncomputeOps gs) := by
  intro g hg q hq
  rw [uncomputeOps, List.mem_reverse, List.mem_map] at hg
  obtain ⟨x, hx, rfl⟩ := hg
  rw [wires_flipGate] at hq
  exact h x hx q hq

