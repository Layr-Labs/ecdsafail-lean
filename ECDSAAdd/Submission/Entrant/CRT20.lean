/-! ### Section 1: Tail Definitions & Structural Decomposition -/

def smallA20 (j : Fin 10) : List Wire :=
  (List.range (lowsP20 (start20 j) - 1)).map (a0P20 (start20 j) + ·)

def smallM20 (j : Fin 10) : List Wire :=
  (List.range (lowsP20 (start20 j) - 1)).map (b0P20 (start20 j) + ·)

def smallC20 (j : Fin 10) : List Wire :=
  (List.range (lowsP20 (start20 j) - 2)).map (1559 + ·)

def releaseMaskP20 (j : Fin 10) : Program := releaseMaskP20_core j

def pendingPairs20 (j : Fin 10) : List (Wire × Wire) :=
  let s := start20 j
  let L := lowsP20 s
  let H := liveW20 s - L
  (List.range (H + 1)).map fun k =>
    (if k = 0 then a0P20 s + L - 2 else bankW20 s (L + k - 1), storeWire20 s (k + 1))

def clearFlagPairs20 (j : Fin 10) : List (Wire × Wire) :=
  (List.range (lowsP20 (start20 j))).map fun k => (b0P20 (start20 j) - 1 + k, 1559 + k)

def low20 (j : Fin 10) : List (Wire × Wire) :=
  (List.range (lowsP20 (start20 j))).map fun i => (a0P20 (start20 j) - 1 + i, b0P20 (start20 j) - 1 + i)

def events20 (j : Fin 10) : List (Wire × Wire) :=
  ([(0, 1556), (1, 1559), (2, 1560), (3, 1561), (4, 1562),
    (5, 1563), (6, 1564), (7, 1565), (8, 1566), (9, 1567)]).map fun p => (swaps20 j p.1, p.2)

def nextLen20 (j : Fin 10) : Nat := if j.val < 9 then 20 else 15

def fullProg20 (j : Fin 10) : Program :=
  core20Prog j ++ (borrowG4_20 j ++ Companion.restore (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558)

def beforeStore20 (j : Fin 10) : Program :=
  fullProg20 j ++ (releaseMaskP20 j ++ GateMirror.forward (leaveStoreMapped20 (start20 j)))

def storeMapped20 (j : Fin 10) : Program :=
  beforeStore20 j ++ GateMirror.forward (leaveLowClose20 (start20 j))

private theorem forward_chainG20 (c seq : Nat → Wire) (out : Wire) : ∀ (i n : Nat),
    GateMirror.forward (chainG c seq [.cx (c (i + n)) out, .x out] i n) =
      PortalAnd.chain true none out (c i) ((List.range n).map fun k => (seq (i + k), c (i + k + 1)))
  | i, 0 => by simp [chainG, PortalAnd.chain, PortalAnd.target, GateMirror.forward, front]
  | i, n + 1 => by
    have ih := forward_chainG20 c seq out (i + 1) n
    rw [show i + 1 + n = i + (n + 1) by omega] at ih
    have el : (List.range (n + 1)).map (fun k => (seq (i + k), c (i + k + 1))) =
        (seq i, c (i + 1)) :: (List.range n).map (fun k => (seq (i + 1 + k), c (i + 1 + k + 1))) := by
      rw [List.range_succ_eq_map, List.map_cons, List.map_map]
      refine congrArg₂ List.cons rfl (List.map_congr_left fun k _ => ?_)
      show (seq (i + (k + 1)), c (i + (k + 1) + 1)) = (seq (i + 1 + k), c (i + 1 + k + 1))
      rw [show i + (k + 1) = i + 1 + k by omega]
    show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) ::
      (chainG c seq [.cx (c (i + (n + 1))) out, .x out] (i + 1) n ++ [.pop (c i) (seq i) (c (i + 1))])) = _
    rw [show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) :: _) =
      front (.make (c i) (seq i) (c (i + 1))) :: GateMirror.forward _ from rfl,
      forward_app, ih, el]
    rfl

private theorem forward_eventsG20 : ∀ (ps : List (Wire × Wire)) (a out : Wire),
    GateMirror.forward (eventsG a out ps) = LeaveNoSwap.block a out ps
  | [], _, _ => rfl
  | (x, t) :: ps, a, out => by
    show GateMirror.forward ([.x x, .make a x t] ++ (eventsG t out ps ++ [.pop a x t, .x x])) = _
    rw [forward_app, forward_app, forward_eventsG20 ps t out]; rfl

private theorem forward_swapsG20 : ∀ ps : List (Wire × Wire),
    GateMirror.forward (swapsG ps) = LeaveRelocation.program ps
  | [] => rfl
  | (a, b) :: ps => by
    show GateMirror.forward ([.cx a b, .cx b a, .cx a b] ++ swapsG ps) =
      [.CX a b, .CX b a, .CX a b] ++ LeaveRelocation.program ps
    rw [forward_app, forward_swapsG20 ps]; rfl

private theorem storeWire20_zero (s : Nat) : storeWire20 s 0 = 1558 := by
  unfold storeWire20 e0P20; dsimp only
  split_ifs <;> ((try unfold Wire at *); omega)

private theorem pending20_fst (j : Fin 10) :
    (pendingPairs20 j).map Prod.fst =
      (a0P20 (start20 j) + lowsP20 (start20 j) - 2) ::
        (List.range (liveW20 (start20 j) - lowsP20 (start20 j))).map (fun i => bankW20 (start20 j) (lowsP20 (start20 j) + i)) := by
  simp only [pendingPairs20, List.map_map, Function.comp]
  rw [List.range_succ_eq_map, List.map_cons, List.map_map]
  simp only [Function.comp, if_pos, Nat.succ_ne_zero, if_false]
  congr 1

private theorem clearFlag20_fst (j : Fin 10) :
