private theorem schedule20_ok (j : Fin 10) (ref : BasisState) (k : Mode20)
    (htags : ∀ i < 21, ref (tagsP20.getD i 0) = (Selector20.enabled20 k && decide (i = Selector20.key20 k))) :
    schedule ref (if Selector20.enabled20 k then Selector20.key20 k else 22) false 0 (columnsP20 (start20 j)) = true := by
  have haux : ∀ (t : Nat) (ht : t ≤ 22) (a : Bool),
      a = decide ((if Selector20.enabled20 k then Selector20.key20 k else 22) < t) →
      schedule ref (if Selector20.enabled20 k then Selector20.key20 k else 22) a t
        ((List.range' t (22 - t)).map fun i =>
          ⟨decide (i < lowsP20 (start20 j)), if i < 21 then some (tagsP20.getD i 0) else none,
           a0P20 (start20 j) - 1 + i, bankW20 (start20 j) i⟩) = true := by
    intro t ht; induction hlen : 22 - t generalizing t with
    | zero => intro a _; simp [schedule]
    | succ d ih =>
      intro a ha
      rw [show List.range' t (d + 1) = t :: List.range' (t + 1) d from rfl, List.map_cons, schedule]
      have ht22 : t < 22 := by omega
      have hnext : (a ^^ HighBankJoin.control ref (if t < 21 then some (tagsP20.getD t 0) else none)) =
          decide ((if Selector20.enabled20 k then Selector20.key20 k else 22) ≤ t) := by
        rw [ha]
        cases hen : Selector20.enabled20 k
        · simp only [Bool.false_eq_true, if_false, decide_eq_false (show ¬ 22 < t by omega),
            decide_eq_false (show ¬ 22 ≤ t by omega), Bool.false_xor]
          split_ifs with h21
          · simp only [HighBankJoin.control, Option.map_some, Option.getD_some, htags t h21, hen, Bool.false_and]
          · rfl
        · simp only [if_true]
          have hkle : Selector20.key20 k ≤ 20 := by have := k.isLt; unfold Selector20.key20; omega
          split_ifs with h21
          · simp only [HighBankJoin.control, Option.map_some, Option.getD_some, htags t h21, hen, Bool.true_and]
            by_cases hlt : Selector20.key20 k < t
            · rw [decide_eq_true hlt, decide_eq_false (show t ≠ Selector20.key20 k by omega),
                decide_eq_true (show Selector20.key20 k ≤ t by omega)]; rfl
            · by_cases heq : t = Selector20.key20 k
              · subst heq; rw [decide_eq_false (by omega), decide_eq_true rfl, decide_eq_true (le_refl _)]; rfl
              · rw [decide_eq_false hlt, decide_eq_false heq, decide_eq_false (show ¬ Selector20.key20 k ≤ t by omega)]; rfl
          · simp only [HighBankJoin.control, Option.map_none, Option.getD_none,
              decide_eq_true (show Selector20.key20 k < t by omega),
              decide_eq_true (show Selector20.key20 k ≤ t by omega), Bool.xor_false]
      rw [hnext, beq_self_eq_true, Bool.true_and]
      exact ih (t + 1) (by omega) (by omega) _ (Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; omega))
  simpa [columnsP20, List.range_eq_range'] using haux 0 (by decide) false (by cases Selector20.enabled20 k <;> simp)

private theorem clrAll_basis_at (ctrl : Wire) (q : Wire) :
    ∀ (rs : List MoveChain.Row) (st : State),
      (∀ r ∈ rs, r.1 ≠ ctrl ∧ r.2 ≠ ctrl ∧ ∀ r' ∈ rs, r.1 ≠ r'.2) →
      (rs.map Prod.snd).Nodup →
      (MoveChain.clrAll ctrl rs st).basis q =
        match rs.find? (fun r => decide (r.2 = q)) with
        | none => st.basis q
        | some r => st.basis q ^^ (st.basis r.1 && st.basis ctrl) := by
  intro rs; induction rs with
  | nil => intro st _ _; rfl
  | cons r rs ih =>
    intro st hsep hnd
    have hnd' := List.nodup_cons.mp hnd
    have hsep_t : ∀ x ∈ rs, x.1 ≠ ctrl ∧ x.2 ≠ ctrl ∧ ∀ x' ∈ rs, x.1 ≠ x'.2 :=
      fun x hx => ⟨(hsep x (List.mem_cons_of_mem _ hx)).1, (hsep x (List.mem_cons_of_mem _ hx)).2.1,
        fun x' hx' => (hsep x (List.mem_cons_of_mem _ hx)).2.2 x' (List.mem_cons_of_mem _ hx')⟩
    show (MoveChain.clrAll _ rs (MoveChain.clr _ r st)).basis _ = _
    rw [ih _ hsep_t hnd'.2]
    by_cases e : r.2 = q
    · have hnone : rs.find? (fun x => decide (x.2 = q)) = none := by
        rw [List.find?_eq_none]; intro x hx; simp only [decide_eq_true_eq]
        intro ex; exact hnd'.1 (List.mem_map.mpr ⟨x, hx, ex.trans e.symm⟩)
      rw [hnone]; simp only [List.find?_cons, e, decide_true, MoveChain.clr, MoveChain.wb_same]
    · simp only [List.find?_cons, decide_eq_false e]
      cases hf : rs.find? (fun x => decide (x.2 = q)) with
      | none => exact MoveChain.wb_other _ _ _ _ (Ne.symm e)
      | some r' =>
        have hr' := List.mem_of_find?_eq_some hf
        have hne1 : q ≠ r.2 := Ne.symm e
        have hne2 : r'.1 ≠ r.2 := (hsep r' (List.mem_cons_of_mem _ hr')).2.2 r List.mem_cons_self
        have hne3 : ctrl ≠ r.2 := Ne.symm (hsep r List.mem_cons_self).2.1
        simp only [MoveChain.clr, MoveChain.wb_other _ _ _ _ hne1, MoveChain.wb_other _ _ _ _ hne2,
          MoveChain.wb_other _ _ _ _ hne3]

attribute [local irreducible] run in
private theorem core20_retire_result (j : Fin 10) (z : SkywalkNat.State) (k : Mode20)
    (en u10 : State) (n8 : List Bool)
    (hmode : k = farMode20 (en.basis (e0P20 (start20 j) + 3)) (en.basis (e0P20 (start20 j) + 4)) z.u)
    (hhist : ∀ i < 20, u10.basis (start20 j + 16 + i) = en.basis (start20 j + 16 + i))
    (h1602 : u10.basis 1602 = (u10.basis (e0P20 (start20 j) + 6) && u10.basis 1601))
    (h59_601 : ∀ q : Wire, 1559 ≤ q → q ≤ 1601 → u10.basis q = sym20 j k en.basis q)
    (hswaps : right20 k = true → ∀ i < 20, i ≤ key20 k → u10.basis (swaps20 j i) = decide (i = key20 k))
    (h3 : u10.basis (e0P20 (start20 j) + 3) = en.basis (e0P20 (start20 j) + 3))
    (h4 : u10.basis (e0P20 (start20 j) + 4) = en.basis (e0P20 (start20 j) + 4)) :
    run (GateMirror.forward (leaveFix11_20 (start20 j) ++ leaveFix12_20 (start20 j) ++ lowSign20 (start20 j))) n8 u10 =
      ⟨u10.phase, cleared20 u10.basis⟩ := by
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, _, _, _, _, _, _, _, _⟩ := geom20_facts j
  have hretDom : ∀ o ∈ Selector20.retireOps20 Selector20.canonPorts, inDom20 o.dst ∧ ∀ a ∈ o.args, inDom20 a := by
    intro o ho
    have h := Bool.and_eq_true_iff.mp (List.all_eq_true.mp op_in_dom o (List.mem_append_right _ ho))
    exact ⟨of_decide_eq_true h.1, fun a ha => of_decide_eq_true (List.all_eq_true.mp h.2 a ha)⟩
  have hrefs_sel : ∀ (q : Nat), 1559 ≤ q → q ≤ 1601 →
      ∀ w ∈ LeaveSelector.refs (sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k) q),
        100 ≤ w ∧ w < 120 := by
    intro q h1 h2 w hw
    have hq := List.all_eq_true.mp (prepOps20_refs_ok k) q (by simp only [List.mem_range'_1]; omega)
    exact of_decide_eq_true (List.all_eq_true.mp hq w hw)
  have hrefs_sign : ∀ w ∈ LeaveSelector.refs (Selector20.signExpr20 Selector20.canonPorts k), 100 ≤ w ∧ w < 120 := by
    intro w hw; exact of_decide_eq_true (List.all_eq_true.mp (signExpr20_refs_ok k) w hw)
  have hread_agree : ∀ (e : Expr), (∀ w ∈ LeaveSelector.refs e, 100 ≤ w ∧ w < 120) →
      e.read (fun w => en.basis (σ20 j w)) = e.read (fun w => u10.basis (σ20 j w)) := by
    intro e he; apply LeaveSelector.readAgree
    intro w hw; obtain ⟨h1, h2⟩ := he w hw
    have hσ : σ20 j w = start20 j + 16 + (w - 100) := by unfold σ20; rw [if_pos ⟨h1, h2⟩]
    rw [hσ, hhist (w - 100) (by unfold Wire at *; omega)]
  have hret_match : ∀ q, inDom20 q →
      u10.basis (σ20 j q) = (Selector20.post20 Selector20.canonPorts k q).read (fun w => u10.basis (σ20 j w)) := by
    intro q hq
