theorem entry20_parity (j : Fin 10) (s : State) (m : List Bool) :
    parityBits20 (ports20 j) (run (GateMirror.forward (entryLeave20 (start20 j))) m s).basis = oddRead20 j s.basis := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have he0 : e0P20 (start20 j) = 1579 + sbP20 (start20 j) := rfl
  have hdst0 : ∀ q ∈ history20 j, q ∉ (GateMirror.forward (fix0P20 (start20 j) (sbP20 (start20 j)))).map destination := by
    have hall : ∀ k : Fin 10, (fix0P20 (start20 k) (sbP20 (start20 k))).all (fun g =>
        decide (GateMirror.target g < start20 k + 16 ∨ start20 k + 35 < GateMirror.target g)) = true := by decide +kernel
    intro q hq hm; rw [forward_map_dest] at hm
    obtain ⟨g, hg', he⟩ := List.mem_map.mp hm
    have ht := of_decide_eq_true (List.all_eq_true.mp (hall j) g hg')
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi; rw [he] at ht; unfold Wire at ht; omega
  have hdst2 : ∀ q ∈ history20 j, q ∉ (GateMirror.forward (fix2P20 (start20 j) (sbP20 (start20 j)))).map destination := by
    have hall : ∀ k : Fin 10, (fix2P20 (start20 k) (sbP20 (start20 k))).all (fun g =>
        decide (GateMirror.target g < start20 k + 16 ∨ start20 k + 35 < GateMirror.target g)) = true := by decide +kernel
    intro q hq hm; rw [forward_map_dest] at hm
    obtain ⟨g, hg', he⟩ := List.mem_map.mp hm
    have ht := of_decide_eq_true (List.all_eq_true.mp (hall j) g hg')
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi; rw [he] at ht; unfold Wire at ht; omega
  unfold parityBits20 oddRead20 entryLeave20
  apply List.map_congr_left; intro i hi; rw [List.mem_range] at hi
  have hmem : (ports20 j).g + i ∈ history20 j := List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩
  rw [forward_app, run_append, run_take, preserved _ _ _ _ (hdst2 _ hmem),
    forward_app, run_append, run_take, fix1_20_forward,
    notRegister_correct (history20 j) (history20_nodup j)]
  simp only [hmem, ↓reduceIte, preserved _ _ _ _ (hdst0 _ hmem)]

/-! ### Section 2: 20-Tick Selector Physical Lifting & `MoveChain.moved` -/

open Selector20

def actualMode20 (b : Nat) (z : SkywalkNat.State) : Mode20 :=
  if far b 20 z then
    if 2 ^ b ≤ z.u then 1 else ⟨2 + wait 20 z.u, by have := wait_le 20 z.u; omega⟩
  else 0

def farMode20 (f u : Bool) (small : Nat) : Mode20 :=
  if f then if u then 1 else ⟨2 + wait 20 small, by have := wait_le 20 small; omega⟩ else 0

theorem mode20_flags (f u : Bool) (small : Nat) :
    left20 (farMode20 f u small) = (f && u) ∧
    right20 (farMode20 f u small) = (f && !u) ∧
    enabled20 (farMode20 f u small) = f ∧
    (f && !u = true → key20 (farMode20 f u small) = wait 20 small) := by
  cases f <;> cases u <;> simp [left20, right20, enabled20, key20, farMode20]
  omega

/-- Wire renaming from `canonPorts` (`g=100..119`, `u=200..220`, `crossing=300`, `near=301`) to `ports20 j`. -/
def σ20 (j : Fin 10) (q : Wire) : Wire :=
  if 100 ≤ q ∧ q < 120 then start20 j + 16 + (q - 100)
  else if 200 ≤ q ∧ q < 221 then a0P20 (start20 j) - 1 + (q - 200)
  else if q = 300 then e0P20 (start20 j) + 6
  else if q = 301 then e0P20 (start20 j) + 7
  else q

abbrev inDom20 (q : Wire) : Prop :=
  (100 ≤ q ∧ q < 120) ∨ (200 ≤ q ∧ q < 221) ∨ q = 300 ∨ q = 301 ∨ (1559 ≤ q ∧ q ≤ 1602)

theorem σ20_inj (j : Fin 10) {a b : Wire} (ha : inDom20 a) (hb : inDom20 b) (e : σ20 j a = σ20 j b) : a = b := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  unfold inDom20 at ha hb
  unfold σ20 at e
  unfold Wire at *
  split_ifs at e <;> omega

def mapOp (f : Wire → Wire) : Op → Op
  | .xor a t => .xor (f a) (f t)
  | .mix a b t => .mix (f a) (f b) (f t)
  | .save a b t => .save (f a) (f b) (f t)

theorem op_in_dom :
    (prepOps20 canonPorts ++ retireOps20 canonPorts).all (fun o =>
      decide (inDom20 o.dst) && o.args.all (fun a => decide (inDom20 a))) = true := by
  decide +kernel

theorem prep_map_eq (j : Fin 10) :
    (prepOps20 canonPorts).map (mapOp (σ20 j)) = prepOps20 (ports20 j) ∧
    (retireOps20 canonPorts).map (mapOp (σ20 j)) = retireOps20 (ports20 j) := by
  revert j; decide +kernel

theorem trace_congr {P : Wire → Prop} (l : List Op) (b1 b2 : BasisState)
    (hdom : ∀ o ∈ l, P o.dst ∧ ∀ a ∈ o.args, P a)
    (heq : ∀ x, P x → b1 x = b2 x) :
    ∀ x, P x → trace l b1 x = trace l b2 x := by
  induction l generalizing b1 b2 with
  | nil => intro x hx; exact heq x hx
  | cons hd tl iht =>
    intro x hx
    apply iht _ _ (fun o' h => hdom o' (List.mem_cons_of_mem _ h)) (fun y hy => ?_) x hx
    have hh := hdom hd List.mem_cons_self
    cases hd with
    | xor a t =>
      simp only [Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : y = t
      · subst e; simp [heq y hy, heq a (hh.2 a (by simp [Op.args]))]
      · simp [e, heq y hy]
    | mix a b t =>
      simp only [Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : y = t
      · subst e; simp [heq y hy, heq a (hh.2 a (by simp [Op.args])), heq b (hh.2 b (by simp [Op.args]))]
      · simp [e, heq y hy]
    | save a b t =>
      simp only [Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : y = t
      · subst e; simp [heq y hy, heq a (hh.2 a (by simp [Op.args])), heq b (hh.2 b (by simp [Op.args]))]
      · simp [e, heq y hy]

theorem enter_mapOp (f : Wire → Wire) (P : Wire → Prop) (inj : ∀ x y, P x → P y → f x = f y → x = y)
    (ops : List Op) (hdom : ∀ o ∈ ops, P o.dst ∧ ∀ a ∈ o.args, P a)
    (v : BasisState) (q : Wire) (hq : P q) :
    trace (ops.map (mapOp f)) v (f q) = trace ops (fun w => v (f w)) q := by
  induction ops generalizing v with
  | nil => rfl
  | cons o os ih =>
    have ho := hdom o List.mem_cons_self
    have hrest : ∀ o' ∈ os, P o'.dst ∧ ∀ a ∈ o'.args, P a := fun o' h => hdom o' (List.mem_cons_of_mem _ h)
    change trace (os.map (mapOp f)) ((mapOp f o).step v) (f q) = trace os (o.step (fun w => v (f w))) q
    rw [ih hrest]
    refine trace_congr os _ _ hrest (fun x hx => ?_) q hq
    cases o with
    | xor a t =>
      simp only [mapOp, Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : x = t
      · subst e; simp
      · have ne : f x ≠ f t := fun h => e (inj x t hx ho.1 h)
        simp [e, ne]
    | mix a b t =>
      simp only [mapOp, Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : x = t
      · subst e; simp
      · have ne : f x ≠ f t := fun h => e (inj x t hx ho.1 h)
        simp [e, ne]
    | save a b t =>
      simp only [mapOp, Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : x = t
      · subst e; simp
      · have ne : f x ≠ f t := fun h => e (inj x t hx ho.1 h)
        simp [e, ne]

theorem exit_mapOp (f : Wire → Wire) (P : Wire → Prop) (inj : ∀ x y, P x → P y → f x = f y → x = y)
    (ops : List Op) (hdom : ∀ o ∈ ops, P o.dst ∧ ∀ a ∈ o.args, P a)
    (v : BasisState) (g : Sym) (hv : validExit ops g = true) (s : State) (m : List Bool)
    (matchDom : ∀ q, P q → s.basis (f q) = (g q).read (fun w => v (f w))) :
    let out := run ((ops.map (mapOp f)).map Op.exit) m s
    out.phase = s.phase ∧
    (∀ q, P q → out.basis (f q) = (erased ops g q).read (fun w => v (f w))) ∧
    (∀ q, (∀ o ∈ ops, q ≠ f o.dst) → out.basis q = s.basis q) := by
  induction ops generalizing g s m with
  | nil => exact ⟨rfl, matchDom, fun _ _ => rfl⟩
  | cons o os ih =>
    obtain ⟨hc, ht⟩ := Bool.and_eq_true_iff.mp hv
    have ho := hdom o List.mem_cons_self
    have hrest : ∀ o' ∈ os, P o'.dst ∧ ∀ a ∈ o'.args, P a := fun o' h => hdom o' (List.mem_cons_of_mem _ h)
    have hstep :
        let st1 := run [(mapOp f o).exit] m s
        st1.phase = s.phase ∧
        (∀ q, P q → st1.basis (f q) = (LeaveSelector.erase o g q).read (fun w => v (f w))) ∧
        (∀ q, q ≠ f o.dst → st1.basis q = s.basis q) := by
      cases o with
      | save a b t =>
        obtain ⟨ta, tb, heq⟩ : t ≠ a ∧ t ≠ b ∧ g t = conj (g a) (g b) := by simpa [checkExit] using hc
        have fta : f t ≠ f a := fun e => ta (inj t a ho.1 (ho.2 a (by simp [Op.args])) e)
        have ftb : f t ≠ f b := fun e => tb (inj t b ho.1 (ho.2 b (by simp [Op.args])) e)
        have ha : s.basis (f a) = (g a).read (fun w => v (f w)) := matchDom a (ho.2 a (by simp [Op.args]))
        have hb : s.basis (f b) = (g b).read (fun w => v (f w)) := matchDom b (ho.2 b (by simp [Op.args]))
        have ht0 : s.basis (f t) = (s.basis (f a) && s.basis (f b)) := by
          rw [matchDom t ho.1, heq, read_conj, ha, hb]
        cases hm : m.headD false
        · simp only [mapOp, Op.exit, run, measureAndCorrect, hm, Bool.false_eq_true, ↓reduceIte, correct,
            Bool.false_and, Bool.xor_false, Op.dst, writeBit]
          refine ⟨trivial, fun q hq => ?_, fun q hne => by simp [Function.update, hne]⟩
          by_cases e : q = t
          · subst e; simp [LeaveSelector.erase, Expr.read]
          · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
            simp [LeaveSelector.erase, e, ne, matchDom q hq]
        · simp only [mapOp, Op.exit, run, measureAndCorrect, hm, ↓reduceIte, correct,
            Bool.true_and, Op.dst, writeBit, ht0, Function.update_of_ne fta.symm, Function.update_of_ne ftb.symm]
          refine ⟨by cases s.phase <;> cases s.basis (f a) <;> cases s.basis (f b) <;> rfl,
            fun q hq => ?_, fun q hne => by simp [Function.update, hne]⟩
          by_cases e : q = t
          · subst e; simp [LeaveSelector.erase, Expr.read]
          · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
            simp [LeaveSelector.erase, e, ne, matchDom q hq]
      | xor a t =>
        refine ⟨rfl, fun q hq => ?_, fun q hne => by
          dsimp only [Op.dst] at hne
          simp [mapOp, Op.exit, Op.enter, run, writeBit, Function.update, hne]⟩
        simp only [mapOp, Op.exit, Op.enter, run, writeBit, Function.update]
        by_cases e : q = t
        · subst e; simp [LeaveSelector.erase, symbolic, Op.dst, read_xor,
            matchDom q hq, matchDom a (ho.2 a (by simp [Op.args]))]
        · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
          simp [LeaveSelector.erase, symbolic, Op.dst, e, ne, matchDom q hq]
      | mix a b t =>
        refine ⟨rfl, fun q hq => ?_, fun q hne => by
          dsimp only [Op.dst] at hne
          simp [mapOp, Op.exit, Op.enter, run, writeBit, Function.update, hne]⟩
        simp only [mapOp, Op.exit, Op.enter, run, writeBit, Function.update]
        by_cases e : q = t
        · subst e; simp [LeaveSelector.erase, symbolic, Op.dst, read_xor, read_conj,
            matchDom q hq, matchDom a (ho.2 a (by simp [Op.args])), matchDom b (ho.2 b (by simp [Op.args]))]
        · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
          simp [LeaveSelector.erase, symbolic, Op.dst, e, ne, matchDom q hq]
    dsimp only at hstep ⊢
    have hrun : run (((o :: os).map (mapOp f)).map Op.exit) m s =
        run ((os.map (mapOp f)).map Op.exit) (m.drop (measurementCount [(mapOp f o).exit]))
          (run [(mapOp f o).exit] m s) := by
      rw [List.map_cons, List.map_cons, ← List.singleton_append, run_append, run_take]
    rw [hrun]
    have htail := ih hrest (LeaveSelector.erase o g) ht (run [(mapOp f o).exit] m s)
      (m.drop (measurementCount [(mapOp f o).exit])) hstep.2.1
    exact ⟨htail.1.trans hstep.1, htail.2.1, fun q hq =>
      (htail.2.2 q (fun o' ho' => hq o' (List.mem_cons_of_mem _ ho'))).trans
        (hstep.2.2 q (hq o List.mem_cons_self))⟩

theorem swaps20_bounds : ∀ j : Fin 10, ∀ i : Fin 20,
    ((swaps20 j i.val : Nat) = start20 j + 1044 + i.val ∧ start20 j + 1044 + i.val ≤ 1300) ∨
    (e0P20 (start20 j) + 10 ≤ (swaps20 j i.val : Nat) ∧ (swaps20 j i.val : Nat) ≤ 1812) := by
  decide +kernel

private theorem hit20_nodup : ∀ j : Fin 10, ∀ i : Fin 20,
    ([1560, swaps20 j i.val, LeaveSelector.tags i.val] : List Wire).Nodup := by
  decide +kernel

private theorem hit20_disj : ∀ j : Fin 10, ∀ i i' : Fin 20,
    LeaveSelector.tags i.val ≠ swaps20 j i'.val := by
  decide +kernel

theorem hit20_layout (j : Fin 10) :
    HighBankFirstHit.Layout 1560 (swaps20 j) LeaveSelector.tags 0 20 := by
  refine ⟨fun i _ hi => hit20_nodup j ⟨i, by omega⟩, fun i _ hi i' _ hi' =>
    ⟨by simp [LeaveSelector.tags]; omega, (hit20_disj j ⟨i, by omega⟩ ⟨i', by omega⟩).symm⟩⟩

theorem swaps20_disj_tags (j : Fin 10) (i k : Fin 20) :
    swaps20 j i.val ≠ LeaveSelector.tags k.val := by
  have hg := geom20_facts j; dsimp only at hg
  have hb := swaps20_bounds j i
  simp only [LeaveSelector.tags]; unfold Wire at *; omega

theorem fix34_eq (j : Fin 10) :
    GateMirror.forward (leaveFix3_20 (sbP20 (start20 j))) =
      (flagOps (e0P20 (start20 j) + 3) (e0P20 (start20 j) + 4) false).map Op.enter ∧
    GateMirror.forward (leaveFix4_20 (start20 j)) =
      HighBankFirstHit.putAll 1560 (swaps20 j) LeaveSelector.tags 0 20 ∧
    GateMirror.forward (leaveFix11_20 (start20 j)) = (retireOps20 (ports20 j)).map Op.exit ∧
    GateMirror.forward (leaveFix12_20 (start20 j)) =
      HighBankFirstHit.dropAll 1560 (swaps20 j) LeaveSelector.tags 0 20 ∧
    GateMirror.forward (lowSign20 (start20 j)) =
      (flagOps (e0P20 (start20 j) + 3) (e0P20 (start20 j) + 4) true).reverse.map Op.exit := by
  revert j; decide +kernel

theorem fix5_move_eq (j : Fin 10) :
    GateMirror.forward (leaveFix5Pre20 (start20 j)) ++
      MoveChain.mux (e0P20 (start20 j) + 6) (moveRows20 (start20 j)) ++
      GateMirror.forward (leaveFix5Post20 (start20 j)) =
    (prepOps20 (ports20 j)).map Op.enter := by
  revert j; decide +kernel

theorem move20_geom : ∀ j : Fin 10,
    MoveChain.apart (e0P20 (start20 j) + 6) (moveRows20 (start20 j)) = true ∧
    MoveChain.lone (moveRows20 (start20 j)) = true ∧
    (moveRows20 (start20 j)).all (fun r =>
      (GateMirror.forward (leaveFix5Post20 (start20 j))).all (MoveChain.quiet (e0P20 (start20 j) + 6) r)) = true := by
  decide +kernel

private theorem fix5pre_dest : ∀ j : Fin 10,
    (leaveFix5Pre20 (start20 j)).all (fun g =>
      decide ((1581 ≤ GateMirror.target g ∧ GateMirror.target g ≤ 1599) ∨
        GateMirror.target g = e0P20 (start20 j) + 7)) = true := by
  decide +kernel

private theorem fix5post_dest : ∀ j : Fin 10,
    (leaveFix5Post20 (start20 j)).all (fun g =>
      decide (GateMirror.target g = 1601 ∨ GateMirror.target g = 1602)) = true := by
  decide +kernel

def selPrefix20 (s : Nat) : List Gate :=
  leaveFix3_20 (sbP20 s) ++ leaveFix4_20 s ++ leaveFix5Move20 s

/-- Symbolic state after `prepOps20` on canonical ports, evaluated at `v ∘ σ20 j`. -/
def sym20 (j : Fin 10) (k : Mode20) (v : BasisState) (q : Wire) : Bool :=
  (sim (prepOps20 canonPorts) (start20Sel canonPorts k) q).read (fun w => v (σ20 j w))

private theorem mc5pre_zero : ∀ j : Fin 10,
    measurementCount (GateMirror.forward (leaveFix5Pre20 (start20 j))) = 0 := by
  decide +kernel

private theorem mc5post_zero : ∀ j : Fin 10,
    measurementCount (GateMirror.forward (leaveFix5Post20 (start20 j))) = 0 := by
  decide +kernel

attribute [local irreducible] run in
theorem selPrefix20_run (j : Fin 10) (s : State) (m : List Bool) (small : Nat) (k : Mode20)
    (mode : k = farMode20 (s.basis (e0P20 (start20 j) + 3)) (s.basis (e0P20 (start20 j) + 4)) small)
    (zero : ∀ q ∈ watched20 j, s.basis q = false)
    (events : right20 k = true → ∀ i < 20, i ≤ key20 k → s.basis (swaps20 j i) = decide (i = key20 k)) :
    let out := run (GateMirror.forward (selPrefix20 (start20 j))) m s
    let ref := ⟨s.phase, fun q => if q ∈ List.range' 1559 44 ∨ q = e0P20 (start20 j) + 6 ∨ q = e0P20 (start20 j) + 7
      then (if q = e0P20 (start20 j) + 6 then sym20 j k s.basis 300
            else if q = e0P20 (start20 j) + 7 then sym20 j k s.basis 301
            else sym20 j k s.basis q)
      else s.basis q⟩
    out = MoveChain.clrAll (e0P20 (start20 j) + 6) (moveRows20 (start20 j)) ref := by
  have hg := geom20_facts j; dsimp only at hg
  have hmf := mode20_flags (s.basis (e0P20 (start20 j) + 3)) (s.basis (e0P20 (start20 j) + 4)) small
  rw [← mode] at hmf
  have z59 : s.basis 1559 = false := zero _ (by simp [watched20, List.mem_range'_1])
  have z60 : s.basis 1560 = false := zero _ (by simp [watched20, List.mem_range'_1])
  have zW : ∀ q : Nat, 1559 ≤ q → q ≤ 1602 → s.basis q = false := fun q h1 h2 =>
    zero q (by simp only [watched20, List.mem_append, List.mem_range'_1]; right; omega)
  have zc : s.basis (e0P20 (start20 j) + 6) = false := zero _ (by simp [watched20])
  have zn : s.basis (e0P20 (start20 j) + 7) = false := zero _ (by simp [watched20])
  have hf3 := flag_prepare (e0P20 (start20 j) + 3) (e0P20 (start20 j) + 4) false s m
    (by unfold Wire; omega) (by unfold Wire; omega) z59 z60
  let st1 : State := ⟨s.phase, flagUpdate (e0P20 (start20 j) + 3) (e0P20 (start20 j) + 4) s.basis⟩
  have hclean4 : ∀ i : Nat, 0 ≤ i → i < 0 + 20 → st1.basis (LeaveSelector.tags i) = false := fun i _ hi => by
    simp only [st1, flagUpdate, LeaveSelector.tags]
    rw [if_neg (by unfold Wire; omega), if_neg (by unfold Wire; omega)]; exact zW _ (by omega) (by omega)
  have hf4_frame := HighBankFirstHit.put_frame (hit20_layout j) st1
    (m.drop (measurementCount (GateMirror.forward (leaveFix3_20 (sbP20 (start20 j)))))) hclean4
  let st2 := run (HighBankFirstHit.putAll 1560 (swaps20 j) LeaveSelector.tags 0 20)
    (m.drop (measurementCount (GateMirror.forward (leaveFix3_20 (sbP20 (start20 j)))))) st1
  have st2_phase : st2.phase = s.phase := hf4_frame.1
  have st2_dom : ∀ q, inDom20 q → st2.basis (σ20 j q) = (start20Sel canonPorts k q).read (fun w => s.basis (σ20 j w)) := by
    intro q hq
    by_cases hr : right20 k = true
    · have hw : st1.basis 1560 = decide (0 ≤ key20 k) := by
        simp [st1, flagUpdate, hmf.2.1.symm, hr]
      have hraw : ∀ i : Nat, 0 ≤ i → i < 0 + 20 → i ≤ key20 k → st1.basis (swaps20 j i) = decide (i = key20 k) := by
        intro i _ hi hle
        have hb := swaps20_bounds j ⟨i, by omega⟩; dsimp only at hb
        have hne : swaps20 j i ≠ 1559 ∧ swaps20 j i ≠ 1560 := by unfold Wire at *; omega
        simp only [st1, flagUpdate, if_neg hne.1, if_neg hne.2]; exact events hr i (by omega) hle
      obtain ⟨hwait, htags⟩ := HighBankFirstHit.one_hot (hit20_layout j) st1 _ (key20 k) hw hclean4 hraw
      have hkey_le : key20 k ≤ 20 := by have := k.isLt; unfold key20; omega
      by_cases q59 : q = 1559
      · subst q59; have hσ : σ20 j 1559 = 1559 := rfl
        rw [hσ, hf4_frame.2 1559 (by decide) (fun i _ _ e => by unfold LeaveSelector.tags Wire at e; omega)]
        simp [st1, flagUpdate, start20Sel, Expr.read, hmf.1]
      · by_cases q60 : q = 1560
        · subst q60; have hσ : σ20 j 1560 = 1560 := rfl
          rw [hσ, hwait]
          simp only [start20Sel, if_neg (by decide : (1560 : Wire) ≠ 1559), ite_true, Expr.read, hot20, hr, Bool.true_and]
          by_cases h20 : key20 k = 20
          · rw [h20]; rfl
          · rw [decide_eq_false (by omega), decide_eq_false (by omega)]
        · by_cases qhit : 1561 ≤ q ∧ q ≤ 1580
          · have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> (unfold Wire at *; omega)
            rw [hσ]
            have ht' := htags (q - 1561) (by omega) (by unfold Wire at *; omega)
            change st2.basis (1561 + (q - 1561)) = decide (q - 1561 = key20 k) at ht'
            rw [show (1561 + (q - 1561) : Wire) = q by unfold Wire at *; omega] at ht'
            rw [ht']; simp only [start20Sel, if_neg q59, if_neg q60, if_pos qhit, Expr.read, hot20, hr, Bool.true_and]
            exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; exact eq_comm)
          · have hneq60 : σ20 j q ≠ 1560 := fun e =>
              q60 (σ20_inj j hq (Or.inr (Or.inr (Or.inr (Or.inr (by decide))))) e)
            have hneqH : ∀ i : Nat, 0 ≤ i → i < 0 + 20 → σ20 j q ≠ LeaveSelector.tags i := fun i _ hi e => by
              have hσt : σ20 j (LeaveSelector.tags i) = LeaveSelector.tags i := by
                unfold σ20 LeaveSelector.tags; split_ifs <;> (unfold Wire at *; omega)
              have hd : inDom20 (LeaveSelector.tags i) :=
                Or.inr (Or.inr (Or.inr (Or.inr (by simp only [LeaveSelector.tags]; unfold Wire at *; omega))))
              have := σ20_inj j hq hd (e.trans hσt.symm)
              simp only [LeaveSelector.tags] at this; unfold Wire at *; omega
            rw [hf4_frame.2 _ hneq60 hneqH]
            have hneq59 : σ20 j q ≠ 1559 := fun e =>
              q59 (σ20_inj j hq (Or.inr (Or.inr (Or.inr (Or.inr (by decide))))) e)
            simp only [st1, flagUpdate, if_neg hneq59, if_neg hneq60]
            by_cases q81 : 1581 ≤ q ∧ q ≤ 1602
            · have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> (unfold Wire at *; omega)
              rw [hσ]; simp [start20Sel, q59, q60, qhit, q81, Expr.read,
                zW q (by unfold Wire at *; omega) (by unfold Wire at *; omega)]
            · by_cases q300 : q = 300
              · subst q300; simp [σ20, start20Sel, canonPorts, Expr.read, zc]
              · by_cases q301 : q = 301
                · subst q301; simp [σ20, start20Sel, canonPorts, Expr.read, zn]
                · simp [start20Sel, canonPorts, q59, q60, qhit, q81, q300, q301, Expr.read]
    · have hrf : right20 k = false := Bool.eq_false_iff.mpr hr
      have hw : st1.basis 1560 = false := by simp [st1, flagUpdate, hmf.2.1.symm, hrf]
      have hinact : st2 = st1 := HighBankFirstHit.inactive (hit20_layout j) st1 _ hw hclean4
      rw [hinact]
      by_cases q59 : q = 1559
      · subst q59; simp [st1, flagUpdate, σ20, start20Sel, Expr.read, hmf.1]
      · by_cases q60 : q = 1560
        · subst q60; simp [st1, flagUpdate, σ20, start20Sel, hot20, hrf, Expr.read, hmf.2.1.symm]
        · have hneq59 : σ20 j q ≠ 1559 := fun e =>
            q59 (σ20_inj j hq (Or.inr (Or.inr (Or.inr (Or.inr (by decide))))) e)
          have hneq60 : σ20 j q ≠ 1560 := fun e =>
            q60 (σ20_inj j hq (Or.inr (Or.inr (Or.inr (Or.inr (by decide))))) e)
          simp only [st1, flagUpdate, if_neg hneq59, if_neg hneq60]
          by_cases qhit : 1561 ≤ q ∧ q ≤ 1580
          · have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> (unfold Wire at *; omega)
            rw [hσ]; simp [start20Sel, q59, q60, qhit, hot20, hrf, Expr.read,
              zW q (by unfold Wire at *; omega) (by unfold Wire at *; omega)]
          · by_cases q81 : 1581 ≤ q ∧ q ≤ 1602
            · have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> (unfold Wire at *; omega)
              rw [hσ]; simp [start20Sel, q59, q60, qhit, q81, Expr.read,
                zW q (by unfold Wire at *; omega) (by unfold Wire at *; omega)]
            · by_cases q300 : q = 300
              · subst q300; simp [σ20, start20Sel, canonPorts, Expr.read, zc]
              · by_cases q301 : q = 301
                · subst q301; simp [σ20, start20Sel, canonPorts, Expr.read, zn]
                · simp [start20Sel, canonPorts, q59, q60, qhit, q81, q300, q301, Expr.read]
  have st2_out : ∀ q, q ∉ List.range' 1559 44 → q ≠ e0P20 (start20 j) + 6 → q ≠ e0P20 (start20 j) + 7 →
      st2.basis q = s.basis q := by
    intro q hq _ _
    simp only [List.mem_range'_1] at hq
    rw [hf4_frame.2 q (by unfold Wire at *; omega) (fun i _ hi e => by simp [LeaveSelector.tags] at e; unfold Wire at *; omega)]
    simp only [st1, flagUpdate, if_neg (show q ≠ 1559 by unfold Wire at *; omega),
      if_neg (show q ≠ 1560 by unfold Wire at *; omega)]
  have hprepDom : ∀ o ∈ prepOps20 canonPorts, inDom20 o.dst ∧ ∀ a ∈ o.args, inDom20 a := by
    intro o ho
    have h := Bool.and_eq_true_iff.mp (List.all_eq_true.mp op_in_dom o (List.mem_append_left _ ho))
    exact ⟨of_decide_eq_true h.1, fun a ha => of_decide_eq_true (List.all_eq_true.mp h.2 a ha)⟩
  let uPrep := run ((prepOps20 (ports20 j)).map Op.enter) [] st2
  have huPrep_eq : uPrep = ⟨s.phase, fun q => if q ∈ List.range' 1559 44 ∨ q = e0P20 (start20 j) + 6 ∨ q = e0P20 (start20 j) + 7
      then (if q = e0P20 (start20 j) + 6 then sym20 j k s.basis 300
            else if q = e0P20 (start20 j) + 7 then sym20 j k s.basis 301
            else sym20 j k s.basis q)
      else s.basis q⟩ := by
    rw [show uPrep = ⟨st2.phase, trace (prepOps20 (ports20 j)) st2.basis⟩ from enter_run _ [] st2]
    apply congrArg₂ State.mk st2_phase
    funext q
    rw [← (prep_map_eq j).1]
    have hdst_all : ∀ o ∈ prepOps20 canonPorts,
        (1581 ≤ o.dst ∧ o.dst ≤ 1602) ∨ o.dst = 300 ∨ o.dst = 301 := by decide +kernel
    by_cases hmem : q ∈ List.range' 1559 44 ∨ q = e0P20 (start20 j) + 6 ∨ q = e0P20 (start20 j) + 7
    · rw [if_pos hmem]
      have hint := interpreted (fun w => s.basis (σ20 j w)) (prepOps20 canonPorts) (start20Sel canonPorts k)
      rcases hmem with h44 | rfl | rfl
      · simp only [List.mem_range'_1] at h44
        have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> (unfold Wire at *; omega)
        have hqdom : inDom20 q := Or.inr (Or.inr (Or.inr (Or.inr (by unfold Wire at *; omega))))
        rw [if_neg (by unfold Wire at *; omega), if_neg (by unfold Wire at *; omega)]
        conv_lhs => rw [← hσ]
        rw [enter_mapOp (σ20 j) inDom20 (fun x y hx hy => σ20_inj j hx hy) (prepOps20 canonPorts) hprepDom st2.basis q hqdom,
          trace_congr (prepOps20 canonPorts) _ _ hprepDom st2_dom q hqdom, ← congrFun hint q]; rfl
      · rw [if_pos rfl]
        have hσ : σ20 j 300 = e0P20 (start20 j) + 6 := rfl
        have hqdom : inDom20 300 := Or.inr (Or.inr (Or.inl rfl))
        rw [← hσ, enter_mapOp (σ20 j) inDom20 (fun x y hx hy => σ20_inj j hx hy) (prepOps20 canonPorts) hprepDom st2.basis 300 hqdom,
          trace_congr (prepOps20 canonPorts) _ _ hprepDom st2_dom 300 hqdom, ← congrFun hint 300]; rfl
      · rw [if_neg (by unfold Wire; omega), if_pos rfl]
        have hσ : σ20 j 301 = e0P20 (start20 j) + 7 := rfl
        have hqdom : inDom20 301 := Or.inr (Or.inr (Or.inr (Or.inl rfl)))
        rw [← hσ, enter_mapOp (σ20 j) inDom20 (fun x y hx hy => σ20_inj j hx hy) (prepOps20 canonPorts) hprepDom st2.basis 301 hqdom,
          trace_congr (prepOps20 canonPorts) _ _ hprepDom st2_dom 301 hqdom, ← congrFun hint 301]; rfl
    · rw [if_neg hmem]
      push_neg at hmem
      have hnotDst : ∀ o ∈ (prepOps20 canonPorts).map (mapOp (σ20 j)), q ≠ o.dst := by
        intro o ho
        obtain ⟨o0, ho0, rfl⟩ := List.mem_map.mp ho
        have hdst := hdst_all o0 ho0
        have eqd : (mapOp (σ20 j) o0).dst = σ20 j o0.dst := by cases o0 <;> rfl
        rw [eqd]
        rcases hdst with ⟨h1, h2⟩ | h3 | h4
        · have : σ20 j o0.dst = o0.dst := by unfold σ20; split_ifs <;> (unfold Wire at *; omega)
          rw [this]; intro e; exact hmem.1 (by rw [e]; simp only [List.mem_range'_1]; unfold Wire at *; omega)
        · rw [h3]; exact hmem.2.1
        · rw [h4]; exact hmem.2.2
      have hstay : ∀ (l : List Op) (b : BasisState), (∀ o ∈ l, q ≠ o.dst) → trace l b q = b q := by
        intro l; induction l with
        | nil => intro b _; rfl
        | cons hd tl iht =>
          intro b hne
          change trace tl (hd.step b) q = b q
          rw [iht _ (fun o ho => hne o (List.mem_cons_of_mem _ ho))]
          simp [Op.step, writeBit, hne hd List.mem_cons_self]
      rw [hstay _ _ hnotDst]
      exact st2_out q hmem.1 hmem.2.1 hmem.2.2
  have hmc5pre : measurementCount (GateMirror.forward (leaveFix5Pre20 (start20 j))) = 0 := mc5pre_zero j
