attribute [local irreducible] barrel15E GateMirror.forward inverse toffoliCount measurementCount gateSlots in
theorem leave15E_counts (j : Fin 4) :
    let s := start15E j
    toffoliCount (leaveP15E j) = adjW15E s + liveW15E s + 3 * lows15E s + 97 + barrel15ET s false ∧
    toffoliCount (leaveInvP15E j) = adjW15E s + liveW15E s + 2 * lows15E s + 128 + barrel15ET s true ∧
    measurementCount (leaveP15E j) = adjW15E s + liveW15E s + lows15E s + 88 + barrel15EM s false ∧
    measurementCount (leaveInvP15E j) = adjW15E s + liveW15E s + 2 * lows15E s + 57 + barrel15EM s true ∧
    gateSlots (leaveP15E j) =
      6 * adjW15E s + 5 * liveW15E s + 10 * lows15E s + 650 + 3 * nextWp15E s + barrel15ESlots s false ∧
    gateSlots (leaveInvP15E j) =
      6 * adjW15E s + 5 * liveW15E s + 11 * lows15E s + 619 + 3 * nextWp15E s + barrel15ESlots s true := by
  have hs := leave15E_gate_counts j
  have cb : Counts (beforeRow15E (start15E j)) ((beforeRow15E (start15E j)).countP isCCX)
      ((beforeRow15E (start15E j)).countP isMake) ((beforeRow15E (start15E j)).countP isPop)
      (beforeRow15E (start15E j)).length := ⟨rfl, rfl, rfl, rfl⟩
  have ca : Counts (afterRow15E (start15E j)) ((afterRow15E (start15E j)).countP isCCX)
      ((afterRow15E (start15E j)).countP isMake) ((afterRow15E (start15E j)).countP isPop)
      (afterRow15E (start15E j)).length := ⟨rfl, rfl, rfl, rfl⟩
  obtain ⟨bt1, bm1, bs1, bt2, bm2, bs2⟩ := cb.programs
  obtain ⟨at1, am1, as1, at2, am2, as2⟩ := ca.programs
  obtain ⟨f1, f2, f3⟩ := barrel15E_metrics j false
  obtain ⟨g1, g2, g3⟩ := barrel15E_metrics j true
  dsimp only
  simp only [leaveP15E, leaveInvP15E, toffoliCount_append, measurementCount_append, gateSlots_append,
    bt1, bt2, bm1, bm2, bs1, bs2, at1, at2, am1, am2, as1, as2, f1, f2, f3, g1, g2, g3]
  refine ⟨by omega, by omega, by omega, by omega, by omega, by omega⟩

attribute [local irreducible] barrel15E GateMirror.forward inverse in
theorem leave15E_phys (j : Fin 4) :
    GatePhysical (leaveP15E j) ∧ GatePhysical (leaveInvP15E j) := by
  have ok := leave15E_gates_ok j
  have pb := physical_of_proper _ (fun g hg => (Bool.and_eq_true_iff.mp (List.all_eq_true.mp ok.1 g hg)).1)
  have pa := physical_of_proper _ (fun g hg => (Bool.and_eq_true_iff.mp (List.all_eq_true.mp ok.2 g hg)).1)
  exact ⟨WindowPhysicalW.appP (WindowPhysicalW.appP pb.1 (barrel15E_phys j false)) pa.1,
    WindowPhysicalW.appP (WindowPhysicalW.appP pa.2 (barrel15E_phys j true)) pb.2⟩

attribute [local irreducible] barrel15E GateMirror.forward inverse in
theorem leave15E_cov (j : Fin 4) :
    WindowCovered.CoveredW (leaveP15E j) ∧ WindowCovered.CoveredW (leaveInvP15E j) := by
  have ok := leave15E_gates_ok j
  obtain ⟨bf, bi⟩ := allW_programs (fun g hg q hq =>
    List.all_eq_true.mp (Bool.and_eq_true_iff.mp (List.all_eq_true.mp ok.1 g hg)).2 q hq)
  obtain ⟨af, ai⟩ := allW_programs (fun g hg q hq =>
    List.all_eq_true.mp (Bool.and_eq_true_iff.mp (List.all_eq_true.mp ok.2 g hg)).2 q hq)
  exact ⟨WindowCovered.appW (WindowCovered.appW bf (barrel15E_cov j false)) af,
    WindowCovered.appW (WindowCovered.appW ai (barrel15E_cov j true)) bi⟩

def leaveBox15E (s : Nat) (q : Wire) : Prop :=
  (s + 16 ≤ q ∧ q ≤ s + 30) ∨
  (a015E s - 1 ≤ q ∧ q ≤ a015E s + 22) ∨
  (b015E s - 1 ≤ q ∧ q ≤ bTopP s) ∨
  (1556 ≤ q ∧ q + s ≤ 2069)

instance (s : Nat) (q : Wire) : Decidable (leaveBox15E s q) := by unfold leaveBox15E; infer_instance

private theorem leave15E_inBox : ∀ j : Fin 4,
    (beforeRow15E (start15E j)).all (fun g => g.wires.all (fun q => decide (leaveBox15E (start15E j) q))) = true ∧
    (afterRow15E (start15E j)).all (fun g => g.wires.all (fun q => decide (leaveBox15E (start15E j) q))) = true := by
  decide +kernel

theorem leave15E_keeps (j : Fin 4) (q : Wire) (hq : ¬ leaveBox15E (start15E j) q) (m : List Bool) (s : State) :
    (run (leaveP15E j) m s).basis q = s.basis q := by
  have hb := leave15E_inBox j
  have hbo : q ∉ wires (GateMirror.forward (beforeRow15E (start15E j))) := fun hw => by
    have ha : AllW (leaveBox15E (start15E j)) (beforeRow15E (start15E j)) := fun g hg w hwg =>
      of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp hb.1 g hg) w hwg)
    exact hq ((allW_programs ha).1 q hw)
  have hao : q ∉ wires (GateMirror.forward (afterRow15E (start15E j))) := fun hw => by
    have ha : AllW (leaveBox15E (start15E j)) (afterRow15E (start15E j)) := fun g hg w hwg =>
      of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp hb.2 g hg) w hwg)
    exact hq ((allW_programs ha).1 q hw)
  have hbr : q ∉ wires (barrel15E (start15E j) false) := fun hw => by
    have bw := barrel15E_wires j false q hw
    have hg := geom15E_facts j
    have hbw : ∀ k : Fin 4,
        (∀ i : Fin (wp15E (start15E k) + 15), leaveBox15E (start15E k) (bankW15E (start15E k) i.val)) ∧
        (∀ i : Fin 10, leaveBox15E (start15E k) (poolW15E (start15E k) (17 + i.val))) := by
      decide +kernel
    have htags : ∀ w ∈ tagsP, 1560 ≤ w ∧ w ≤ 1576 := by decide
    apply hq
    rcases bw with ⟨i, hi, rfl⟩ | ⟨k, hk, rfl⟩ | ht
    · exact (hbw j).1 ⟨i, hi⟩
    · exact (hbw j).2 ⟨k, hk⟩
    · have ht' := htags q ht
      unfold leaveBox15E; right; right; right; unfold Wire at *; omega
  simp only [leaveP15E, run_append, run_take]
  rw [run_preserves_outside _ _ _ _ hao, run_preserves_outside _ _ _ _ hbr,
    run_preserves_outside _ _ _ _ hbo]

theorem leave15E_keeps_mirror (j : Fin 4) (q : Wire) (hq : 2070 ≤ (q : Nat) + start15E j)
    (m : List Bool) (s : State) :
    (run (leaveP15E j) m s).basis q = s.basis q := by
  apply leave15E_keeps j q _ m s
  have hg := geom15E_facts j
  unfold leaveBox15E a015E b015E bTopP railP
  split_ifs <;> (simp only [Wire] at *; omega)

