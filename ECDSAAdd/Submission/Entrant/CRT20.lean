theorem ready_pending_at (j : Fin 4) (raw pre : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (h15E j) 15 z)
    (cut : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (h15E j) 15 z))
      (decide (Shadow.far (h15E j) 15 z ∧ 2 ^ h15E j ≤ z.u))
      (pullState (pull j) raw) (eraseSites (pending j) pre))
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (hist : ∀ r : Fin 15,
      raw.basis (pull j (windowNet15E j (IntegerPacket.ports (shape15E j) r).history)) = false) :
    let t := run (enterP15E j) m pre
    let T := Shadow.reduced (h15E j) 15 z
    t.phase = pre.phase ∧ onRails15E j 0 (SkywalkRails.encode G S T.u T.v) t.basis ∧
      ∀ q ∈ pending j, t.basis q = pre.basis q := by
  have eq := erase_run (pending j) (enterP15E j) (avoid_enter j) m pre
  have real := ready_from_cut_at j raw (eraseSites (pending j) pre) z G S m small cut input hist
  rw [eq] at real
  refine ⟨real.1, zero_congr15E j _ _ ?_ _ real.2,
    fun q mem => run_preserves_outside _ m pre _ (avoid_enter j _ mem)⟩
  intro q used
  have absent : q ∉ pending j := fun h => avoid_live j _ h used
  simp only [eraseSites, absent, ↓reduceIte]

