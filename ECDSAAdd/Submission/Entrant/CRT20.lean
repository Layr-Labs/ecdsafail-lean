  · intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    rw [hclose]; dsimp only; rw [hrl.1 ⟨i, hi⟩, wb_ne _ (by unfold Wire; omega), hv_eq]
    exact hlc.2.1 _ (List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩)
  · intro i
    rw [hclose]; dsimp only; rw [(hrl.2 i).1, (hrl.2 i).2, wb_ne _ (by unfold Wire; omega),
      wb_ne _ (by unfold Wire; omega), hv_eq]
    exact hlc.2.2.1 i
  · intro i
    rw [hclose]; dsimp only; rw [(hru i).1]
    have hidx : lowsP20 (start20 j) + i.val < wpP20 (start20 j) + 20 := by have := i.isLt; omega
    have hbc := bank20_cases j hidx
    have hneq : bankW20 (start20 j) (lowsP20 (start20 j) + i.val) ≠ e0P20 (start20 j) + 4 ∧
