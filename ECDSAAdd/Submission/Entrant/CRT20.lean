    (rw [eb] at he; rcases hq with rfl | ⟨_, _⟩ | rfl <;> (unfold Wire at *; omega))

private def xorList (f : BasisState) : List Wire → Bool
  | [] => false
  | w :: ws => f w ^^ xorList f ws

private theorem run_cxs_into (srcs : List Wire) (dst : Wire) (hnd : dst ∉ srcs) (t : List Bool) (ph : Bool) (f : BasisState) :
    run (GateMirror.forward (srcs.map (fun w => Gate.cx w dst))) t ⟨ph, f⟩ =
      ⟨ph, writeBit f dst (f dst ^^ xorList f srcs)⟩ := by
  induction srcs generalizing f with
  | nil =>
    simp only [List.map_nil, GateMirror.forward, run, xorList, Bool.xor_false, writeBit, State.mk.injEq, true_and]
    funext q; by_cases hq : q = dst <;> simp [Function.update_apply, hq]
  | cons w ws ih =>
    have hnd' : dst ∉ ws := fun hm => hnd (List.mem_cons_of_mem _ hm)
    simp only [List.map_cons, GateMirror.forward, front, run]
    change run (GateMirror.forward (ws.map (fun w => Gate.cx w dst))) t ⟨ph, writeBit f dst (f dst ^^ f w)⟩ = _
    rw [ih hnd' (writeBit f dst (f dst ^^ f w))]
    have hx : xorList (writeBit f dst (f dst ^^ f w)) ws = xorList f ws := by
      clear ih hnd
      induction ws with
      | nil => rfl
      | cons a as iha =>
        have ha : a ≠ dst := fun e => hnd' (e ▸ List.mem_cons_self ..)
        rw [xorList, xorList, iha (fun hm => hnd' (List.mem_cons_of_mem _ hm))]
        simp only [writeBit, Function.update_of_ne ha]
    rw [hx]
    simp only [xorList, writeBit, Function.update_self, Function.update_idem, State.mk.injEq, true_and]
    funext q; by_cases hq : q = dst
    · subst hq; simp only [Function.update_self]; cases f q <;> cases f w <;> cases xorList f ws <;> rfl
    · simp only [Function.update_of_ne hq]

private theorem xorList_congr (srcs : List Wire) (f g : BasisState) (h : ∀ w ∈ srcs, f w = g w) :
    xorList f srcs = xorList g srcs := by
  induction srcs with
  | nil => rfl
  | cons w ws ih => simp only [xorList, h w List.mem_cons_self, ih (fun a ha => h a (List.mem_cons_of_mem _ ha))]

private theorem xorList_append (f : BasisState) (xs ys : List Wire) :
    xorList f (xs ++ ys) = (xorList f xs ^^ xorList f ys) := by
  induction xs with
  | nil => simp [xorList]
  | cons a as ih =>
    simp only [List.cons_append, xorList, ih]
    cases f a <;> cases xorList f as <;> cases xorList f ys <;> rfl

private theorem xorList_reverse (srcs : List Wire) (f : BasisState) :
    xorList f srcs.reverse = xorList f srcs := by
  induction srcs with
  | nil => rfl
  | cons w ws ih =>
    rw [List.reverse_cons, xorList_append, ih]; simp only [xorList, Bool.xor_false]
    cases f w <;> cases xorList f ws <;> rfl

private theorem pop_selRecv_gen (a b dst : Wire) (srcs : List Wire) (hnd : dst ∉ srcs) (u : State)
    (hpar : u.basis dst = xorList u.basis srcs) :
    (∀ t, run (GateMirror.forward (srcs.map (fun w => Gate.cx w dst))) t u =
      run (GateMirror.forward [.pop a b dst]) [] u) ∧
    (∀ t, run (GateMirror.inverse (srcs.map (fun w => Gate.cx w dst))) t
      (run (GateMirror.forward [.pop a b dst]) [] u) = u) := by
  cases u with | mk ph f =>
  simp only at hpar
  constructor
  · intro t
    rw [run_cxs_into srcs dst hnd t ph f]
    simp only [GateMirror.forward, front, List.map_cons, List.map_nil, run, GateMirror.erase,
      measureAndCorrect, ECDSAAdd.correct, List.headD_nil, Bool.false_eq_true, ↓reduceIte,
      Bool.false_and, Bool.xor_false, State.mk.injEq, true_and]
    funext q; by_cases hq : q = dst
    · subst hq; simp [writeBit, hpar]
    · simp [writeBit, Function.update_of_ne hq]
  · intro t
    have hinv : GateMirror.inverse (srcs.map (fun w => Gate.cx w dst)) =
        GateMirror.forward (srcs.reverse.map (fun w => Gate.cx w dst)) := by
      simp only [GateMirror.inverse, GateMirror.forward, List.map_reverse, List.map_map, Function.comp_def, front, GateMirror.back]
    rw [hinv]
    simp only [GateMirror.forward, front, List.map_cons, List.map_nil, run, GateMirror.erase,
      measureAndCorrect, ECDSAAdd.correct, List.headD_nil, Bool.false_eq_true, ↓reduceIte,
      Bool.false_and, Bool.xor_false]
    have hndR : dst ∉ srcs.reverse := fun hm => hnd (List.mem_reverse.mp hm)
    change run (GateMirror.forward (srcs.reverse.map (fun w => Gate.cx w dst))) t ⟨ph, writeBit f dst false⟩ = ⟨ph, f⟩
    rw [run_cxs_into srcs.reverse dst hndR t ph (writeBit f dst false)]
    have hx : xorList (writeBit f dst false) srcs.reverse = xorList f srcs := by
      rw [xorList_congr srcs.reverse _ f (fun w hw => by
        have hne : w ≠ dst := fun e => hndR (e ▸ hw)
        simp [writeBit, Function.update_of_ne hne]), xorList_reverse]
    rw [hx]
    simp only [writeBit, Function.update_self, Function.update_idem, Bool.false_xor, State.mk.injEq, true_and]
    funext q; by_cases hq : q = dst
    · subst hq; simp [Function.update_self, hpar]
    · simp [Function.update_of_ne hq]

private theorem red20_aft_fprog (sc : Nat) :
