theorem store_shape : store = RailPair.store 440 1615 loPairs hiPairs := by decide +kernel
theorem hi_y : hiPairs.map Prod.snd = bulkB := by decide +kernel
theorem noOverlap : ∀ p ∈ hiPairs, p.1 ∉ hiPairs.map Prod.snd := by decide +kernel
theorem bankLayout : CutLayout loPairs hiPairs 440 1615 1613 1614 := by
  constructor <;> first | constructor <;> decide +kernel | decide +kernel
theorem pot : ∀ w ∈ railA ++ railB, w ≠ 1613 ∧ w ≠ 1614 := by decide +kernel
theorem carry_apart : ∀ w ∈ carry, w ≠ 1613 ∧ w ≠ 1614 := by decide +kernel

theorem flags_values (q : State) (m : List Bool) (u v : Nat) (sg : Bool)
    (small : 2 * 2 ^ 51 ≤ u + v → min u v < 2 ^ 36)
    (scratch : ∀ k ∈ activeScratch, q.basis k = false)
    (x : regValue railA q.basis = (u + v) / 2 ^ 51)
    (y : regValue railB q.basis = (u - (negative sg u).toNat) / 2 ^ 51) :
    let far := decide (2 * 2 ^ 51 ≤ u + v)
    let long := decide (2 * 2 ^ 51 ≤ u + v ∧ 2 ^ 36 ≤ u)
    run flags m q = ⟨q.phase, writeBit (writeBit q.basis 1613 far) 1614 long⟩ := by
  have act := PortalValues.actual_flags_shadow7 492 493 thresholdPairs orientationPairs 837 railA railB
    (by decide +kernel) (by decide +kernel) q.basis (2 ^ 51) (2 ^ 36) u v (negative sg u).toNat
    (by decide) (by decide) small (by cases negative sg u <;> decide) x y
  rw [flags_do q m scratch, act.2, act.1]

theorem erase_input (q : State) (u v : Nat) (sg : Bool)
    (small : 2 * 2 ^ 51 ≤ u + v → min u v < 2 ^ 36)
    (x : regValue railA q.basis = (u + v) / 2 ^ 51)
    (y : regValue railB q.basis = (u - (negative sg u).toNat) / 2 ^ 51)
    (mode : q.basis 1614 = decide (2 * 2 ^ 51 ≤ u + v ∧ 2 ^ 36 ≤ u)) :
    (regValue bulkB q.basis + (q.basis 838 && !q.basis 493).toNat) % 2 ^ bulkB.length =
      copyValue (some 1614) q.basis (regValue bulkA q.basis) := by
  apply PortalValues.input_eq_shadow7 492 493 837 838 1614 bulkA bulkB q.basis (2 ^ 51) (2 ^ 36) u v (negative sg u).toNat
  · decide
  · decide
  · exact small
  · cases negative sg u <;> decide
  · by_cases pos : 0 < u <;> cases sg <;> simp_all [negative]; omega
  · exact x
  · exact y
  · exact mode
  · decide +kernel

theorem erase_values (q : State) (m : List Bool) (u v : Nat) (sg : Bool)
    (small : 2 * 2 ^ 51 ≤ u + v → min u v < 2 ^ 36)
    (fresh : q.basis 1556 = false ∧ ∀ w ∈ carry, q.basis w = false)
    (x : regValue railA q.basis = (u + v) / 2 ^ 51)
    (y : regValue railB q.basis = (u - (negative sg u).toNat) / 2 ^ 51)
    (mode : q.basis 1614 = decide (2 * 2 ^ 51 ≤ u + v ∧ 2 ^ 36 ≤ u)) :
