      ([.ccx (sc + 35) (b + 807) (sc + b + 57)] ++ (headA1_20 sc ++
        ([.make (b + 1582) (b + 1583) 1559] ++ (headC0_20 sc ++
          ([.cx (a0P20 sc - 1 + 0) (e0P20 sc + 6), .ccx (tagsP20.getD 0 0) (e0P20 sc + 6) (a0P20 sc - 1 + 0),
            .cx (a0P20 sc - 1 + 0) (e0P20 sc + 6)] ++ headC1_20Pre sc))))))) =
      (entryLeave20 sc ++ selPrefix20 sc) ++ [.cx (e0P20 sc + 6) (e0P20 sc + 3)] := by
  have hsp := leaveBefore20_split4 sc
  rw [headC1_20_split_core sc] at hsp
  have h1 : (firstRows20 sc (sbP20 sc) ++ (cell21_20 sc (sbP20 sc) ++ (headEnd20 sc (sbP20 sc) ++
      ([.ccx (sc + 35) (sbP20 sc + 807) (sc + sbP20 sc + 57)] ++ (headA1_20 sc ++
        ([.make (sbP20 sc + 1582) (sbP20 sc + 1583) 1559] ++ (headC0_20 sc ++
          ([.cx (a0P20 sc - 1 + 0) (e0P20 sc + 6), .ccx (tagsP20.getD 0 0) (e0P20 sc + 6) (a0P20 sc - 1 + 0),
            .cx (a0P20 sc - 1 + 0) (e0P20 sc + 6)] ++ headC1_20Pre sc)))))))) ++ leaveAdjustCore20 sc =
      ((entryLeave20 sc ++ selPrefix20 sc) ++ [.cx (e0P20 sc + 6) (e0P20 sc + 3)]) ++ leaveAdjustCore20 sc := by
    rw [← leaveBefore20_split_core sc, hsp]; simp only [List.append_assoc]
