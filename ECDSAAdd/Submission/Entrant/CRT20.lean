def forward425Cut (d : Bool) : Program := (MixedFredCut425.forwardL425C d).flatten
def reverse425Cut (d : Bool) : Program := (MixedFredCut425.reverseL425C d).flatten

theorem mixedCut425_run_eq (d : Bool) :
    run (forward425Cut d) = run (forward425 d) ∧
    run (reverse425Cut d) = run (reverse425 d) :=
  ⟨funext fun m => funext fun s => (MixedFredCut425.fwd_mixed425_cut d).run_eq m s,
   funext fun m => funext fun s => (MixedFredCut425.rev_mixed425_cut d).run_eq m s⟩

theorem mixedCut425_counts (d : Bool) :
    toffoliCount (forward425Cut d) = (if d then 127512 else 127596) ∧
    toffoliCount (reverse425Cut d) = (if d then 127566 else 127672) ∧
    measurementCount (forward425Cut d) = (if d then 65823 else 65932) ∧
    measurementCount (reverse425Cut d) = (if d then 65499 else 65607) := by
  have hmc := mixed425_counts d
  have htf := (MixedFredCut425.fwd_mixed425_cut d).tc_eq
  have htr := (MixedFredCut425.rev_mixed425_cut d).tc_eq
  have hmf := (MixedFredCut425.fwd_mixed425_cut d).mc_eq
  have hmr := (MixedFredCut425.rev_mixed425_cut d).mc_eq
  change toffoliCount (forward425Cut d) + 4 * 23 = toffoliCount (forward425 d) at htf
  change toffoliCount (reverse425Cut d) + 4 * 23 = toffoliCount (reverse425 d) at htr
  change measurementCount (forward425Cut d) = measurementCount (forward425 d) at hmf
  change measurementCount (reverse425Cut d) = measurementCount (reverse425 d) at hmr
  cases d <;> simp only [Bool.false_eq_true, ↓reduceIte] at hmc ⊢ <;>
    exact ⟨by omega, by omega, by omega, by omega⟩

