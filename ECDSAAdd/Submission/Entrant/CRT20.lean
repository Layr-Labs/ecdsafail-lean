theorem load_map : ∀ q : Fin 155, loadMap q = rawPorts ⟨q, by omega⟩ := by
  have h1 : (loadMapList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (rawPortsList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro q
  simp only [loadMap, rawPorts, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2]
  revert q
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem load_route : ∀ i, backMap loadMoves (codePorts i) = rawPorts (loadRoute i) := by
  have h1 : (codePortsList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (rawPortsList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h3 : ((loadRouteList.map Fin.val).all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro i
  simp only [codePorts, rawPorts, loadRoute, ECDSAAdd.Entrant.WSlimV3.fin_getD_val, Fin.val_zero, Fin.isValue,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h3]
  revert i
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem load_sort : ∀ i, loadRoute i = i ∨ (16 ≤ i.val ∧ 16 ≤ (loadRoute i).val) := by
  have h1 : ((loadRouteList.map Fin.val).all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro i
  simp only [loadRoute, Fin.ext_iff, ECDSAAdd.Entrant.WSlimV3.fin_getD_val, Fin.val_zero, Fin.isValue,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1]
  revert i
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem load_scope : ∀ p ∈ loadMoves, (∃ i, rawPorts i = p.1) ∧ (∃ i, rawPorts i = p.2) := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem load_run (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame rawPorts (startCols true d) row s) :
    let t := run ((Shadow7.exitLoadP 425) d) m s
    t.phase = s.phase ∧ Frame codePorts (endCols true d) row t ∧
    ∀ q, (∀ i, rawPorts i ≠ q) → t.basis q = s.basis q := by
  rw [load_program]
  apply packet true d rawPorts codePorts loadMap loadMoves loadRoute load_unique _
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) load_route load_sort load_scope row hr s m ready
  intro q h
  have lim : q < 155 := by cases d <;> exact h
  exact ⟨⟨q, by omega⟩, rfl, load_map ⟨q, lim⟩⟩

theorem restore_map : ∀ q : Fin 150, restoreMap q = codePorts ⟨q, by omega⟩ := by
  have h1 : (restoreMapList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (codePortsList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro q
  simp only [restoreMap, codePorts, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2]
  revert q
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem restore_route : ∀ i, backMap restoreMoves (rawPorts i) = codePorts (restoreRoute i) := by
  have h1 : (rawPortsList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (codePortsList.all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h3 : ((restoreRouteList.map Fin.val).all fun x => decide (x < 2 ^ 11)) = true := by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  intro i
  simp only [codePorts, rawPorts, restoreRoute, ECDSAAdd.Entrant.WSlimV3.fin_getD_val, Fin.val_zero, Fin.isValue,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2,
    ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h3]
