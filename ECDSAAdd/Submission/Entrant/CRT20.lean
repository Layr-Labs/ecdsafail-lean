  (Shadow7.fix5P s h).take 27 ++ rowGates (e015E s + 6) (moveRows15E s) ++ (Shadow7.fix5P s h).drop 43

def leaveAdjustCore15E (s : Nat) : List Gate :=
  adjustG ((List.range (wp15E s)).map (bankW15E s))
    ((List.range (wp15E s - 1)).map (poolW15E s)) (e015E s + 3) 1596

def leaveAdjustCore15EShort (s : Nat) : List Gate :=
