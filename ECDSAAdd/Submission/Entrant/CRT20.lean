    have h := forward_chainG20 (storeWire20 (start20 j))
      (fun i => if i = 0 then a0P20 (start20 j) + lowsP20 (start20 j) - 2 else bankW20 (start20 j) (lowsP20 (start20 j) + i - 1))
      1557 0 (liveW20 (start20 j) - lowsP20 (start20 j) + 1)
