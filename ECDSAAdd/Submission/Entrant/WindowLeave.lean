    refine (kept col).trans ?_
    rw [chronological col]
    exact (Shadow7.native_raw_read sourceIdx before i young).trans (by simp [rawBit,young])
  · have eq:i=20 ∨ i=21 ∨ i=22:=by omega
    rcases eq with rfl|rfl|rfl
