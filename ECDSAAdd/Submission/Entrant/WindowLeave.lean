  and_intros <;> first | trivial | (intro x hx; cases hx) | omega | exact Nat.ne_of_gt (by omega) | exact Nat.ne_of_lt (by omega)

theorem parkP_physical (e : Nat) (h0 : 60 ≤ e) (h1 : e ≤ 420) :
