theorem park_proper (e : Nat) (h0 : 60 ≤ e) (h1 : e ≤ 420) : ∀ g ∈ parkOps e, proper g = true := by
  have f1 : sbP e + 40 ≤ railP e := by unfold railP sbP; split_ifs <;> omega
