    q=start j+15 ∨ (Shadow7.sbP (start j)+1574≤q ∧ q≤Shadow7.sbP (start j)+1579) ∨ (1556≤q ∧ q≤1563) := by
  simp only [ports,List.mem_cons,List.not_mem_nil,or_false] at h
