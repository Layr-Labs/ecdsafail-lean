/-- `Enter{s}.layout`. -/
def layout (j : Fin 25) : EnterProof17.Aperture (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j) (ports j)
    (lay j) (pull j) (Shadow7.sbP (start j)+15+1) where
