  have f3 : sbP e = (498 - e - (1 - (90 - e) - e / 405) - (1 - (e - 60)))/2 := rfl
  have f4 : e ≤ 255 ∨ railP e = 513 - e := by unfold railP; split_ifs <;> omega
  have he : e0P e = 1574 + sbP e := rfl
  have hb : bTopP e = 785 + railP e := rfl
