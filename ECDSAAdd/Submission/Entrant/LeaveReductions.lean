theorem archive20_phys (j : Fin 9) (d : Bool) :
    GatePhysical (archiveLoadP20 j d) ∧ GatePhysical (archiveRestoreP20 j d) := by
  have h := archPorts20_ok j
  have hh := archHeads20_ok j
