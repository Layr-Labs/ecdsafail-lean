def neg (j : Fin 9) (z : SkywalkNat.State) : Bool :=
  cross17 (d j z) && (!(decide (2 ^ sbP20 (start20 j) ≤ z.u)) && IntegerHigh.negative (oddBits (letters 20 (r j z))))
