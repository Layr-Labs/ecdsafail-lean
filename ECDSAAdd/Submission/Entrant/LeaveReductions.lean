    have h56 : leaveBox20 (start20 j) 1556 := by unfold leaveBox20; right; right; right; left; decide
    have h57 : leaveBox20 (start20 j) 1557 := by unfold leaveBox20; right; right; right; left; decide
    have h58 : leaveBox20 (start20 j) 1558 := by unfold leaveBox20; right; right; right; left; decide
    have ht1 : inBox20 j [.cx (storeWire20 (start20 j) (liveW20 (start20 j) - lowsP20 (start20 j) + 1)) 1557, .x 1557] := fun g hg' q hq => by
