    have nN : (1566 + kk : Wire) ≠ EnterJ20.flagN j := by simp only [EnterJ20.flagN, e0P20, EnterJ20.h20, Wire] at *; omega
    have nF : (1566 + kk : Wire) ≠ EnterJ20.flagF j := by simp only [EnterJ20.flagF, e0P20, EnterJ20.h20, Wire] at *; omega
    have nU : (1566 + kk : Wire) ≠ EnterJ20.flagU j := by simp only [EnterJ20.flagU, e0P20, EnterJ20.h20, Wire] at *; omega
    have nP : (1566 + kk : Wire) ∉ EnterJ20.pending j := by
      simp only [EnterJ20.pending, List.mem_cons, List.not_mem_nil, or_false, e0P20, EnterJ20.h20, Wire] at *; omega
    have nLo : (1566 + kk : Wire) ∉ RailPair.sites (EnterJ20.lowerPairs j) := by
      simp only [RailPair.sites, EnterJ20.lowerPairs, List.flatMap_cons, List.flatMap_nil,
        List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.append_nil, Wire]
      omega
    have nHi : (1566 + kk : Wire) ∉ RailPair.sites (EnterJ20.upperPairs j) := fun m => by
