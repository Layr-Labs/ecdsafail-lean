            refine ⟨fun t ht e => ?_, fun r hr => ?_⟩
            · rcases bank20_cases j ht with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;> (rw [eb] at e; unfold Wire at *; omega)
            · obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hr; rw [List.mem_range] at ht
              rcases bank20_cases j (i := t) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
                (dsimp only; rw [eb]; unfold Wire at *; omega)
          rw [hc.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 _ (by omega) (by omega) (by omega) hout.1 hout.2]
          exact (entry20_keep j _ (by omega) s m).trans h.parked
        · have hk : p - (b0P20 (start20 j) + 20) < lowsP20 (start20 j) := by omega
          have hfr : ((columnsP20 (start20 j))[p - (b0P20 (start20 j) + 20)]'(by simp [columnsP20]; omega)).free = p := by
            simp only [columnsP20, List.getElem_map, List.getElem_range, HighBankJoin.Column.free, decide_eq_true_eq]
