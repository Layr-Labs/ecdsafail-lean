          List.mem_cons, List.not_mem_nil, or_false, or_assoc] at h1
        have hy0In : L.ylow.getD 0 0 ∈ wires (StairLoan.forwardLoan d L) := by
          have hy0 : L.ylow.getD 0 0 ∈ wires (GuardCompression.seed L) := by
