    simp only [StairLoan.compareBlockLoan, Q6LifetimeResearch.move, gatePhysical_append] at hcmBlk
    have hcmOld : GatePhysical (compareLoan d retiredRoles true (L.y.drop 1) (L.r.drop 1)
