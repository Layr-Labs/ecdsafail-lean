    apply viaCut _ (scratch20_support j lo hi) nf ne nN nF nU nP nLo nHi
    rw [pl]; exact carryTop _ (by omega) (by omega)

def prevLen20 (j : Fin 9) : Nat := if j.val = 0 then 15 else 20

private theorem admin_outside20 (j : Fin 9) (q : Wire) (hq : q ∈ prevRawHead20 j ++ support20 j) :
    WideReference20.Box20 (start20 j) 20 q ∨ q ∈ WideReference20.sites (start20 j) (prevLen20 j) 20 := by
  have f := EnterJ20.frame j
  have hg := geom20_facts j
  have inSites (r : Nat) (hr1 : start20 j - prevLen20 j ≤ r) (hr2 : r < start20 j) :
      base r ∈ WideReference20.sites (start20 j) (prevLen20 j) 20 ∧
      OB5.sig (start20 j) (base (1028 + r)) ∈ WideReference20.sites (start20 j) (prevLen20 j) 20 ∧
      OB5.sig (start20 j) (base r) = base r := by
    have idA : OB5.sig (start20 j + 19) (base r) = base r :=
      sig_fixed (by intro h; simp only [base, Wire] at *; omega) (by intro h; simp only [base, Wire] at *; omega)
    have idAs : OB5.sig (start20 j) (base r) = base r :=
      sig_fixed (by intro h; simp only [base, Wire] at *; omega) (by intro h; simp only [base, Wire] at *; omega)
    have eqB : OB5.sig (start20 j) (base (1028 + r)) = OB5.sig (start20 j + 19) (base (1028 + r)) := by
      rw [OB5.sig_base (start20 j) (1028 + r) (by omega),
        OB5.sig_base (start20 j + 19) (1028 + r) (by omega)]
      simp only [base, Wire] at *; split_ifs <;> omega
    refine ⟨?_, ?_, idAs⟩
    · rw [← idA]; unfold WideReference20.sites
      refine List.mem_map.mpr ⟨base r, ?_, rfl⟩
      unfold WideReference20.oldSites
      simp only [List.mem_flatMap, List.mem_cons]
      exact ⟨r, List.mem_range'.mpr ⟨r - (start20 j - prevLen20 j), by unfold prevLen20; split_ifs <;> omega, by omega⟩, Or.inl rfl⟩
    · unfold WideReference20.sites
      refine List.mem_map.mpr ⟨base (1028 + r), ?_, eqB.symm⟩
      unfold WideReference20.oldSites
      simp only [List.mem_flatMap, List.mem_cons]
      exact ⟨r, List.mem_range'.mpr ⟨r - (start20 j - prevLen20 j), by unfold prevLen20; split_ifs <;> omega, by omega⟩, Or.inr (Or.inl rfl)⟩
  have flagBox (n : Nat) (hn : n = 6 ∨ n = 7 ∨ n = 8) :
      WideReference20.Box20 (start20 j) 20 (e0P20 (start20 j) + n) := by
    have he0 : e0P20 (start20 j) = 1579 + sbP20 (start20 j) := rfl
    unfold WideReference20.Box20; right; right; left
    simp only [Wire] at *; rcases hn with rfl | rfl | rfl <;> omega
  simp only [List.mem_append] at hq
  rcases hq with hq | hq
  · have hhead : prevRawHead20 j = cellsLoadP (start20 j) ++ [e0P20 (start20 j) + 6, e0P20 (start20 j) + 7, e0P20 (start20 j) + 8] := by
      unfold prevRawHead20
      by_cases h0 : j.val = 0
      · simp only [h0, ↓reduceIte, Archive150.rawHead, Archive150.flagBase]
        rw [show start20 j = 165 by simp [start20, h0]]
      · simp only [h0, ↓reduceIte, ArchiveJ20.rawHead, ArchiveJ20.endTick, ArchiveJ20.flagBase]
        have hpv : (prev20 j).val = j.val - 1 := rfl
        have he : start20 (prev20 j) + 20 = start20 j := by unfold start20; rw [hpv]; omega
        have hn : nextE0_20 (start20 (prev20 j)) = e0P20 (start20 j) := by
          unfold nextE0_20; rw [he, if_pos (by omega)]
        rw [he, hn]
    rw [hhead, cellsLoadP] at hq
    simp only [List.mem_append, List.mem_flatMap, List.mem_range, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with ⟨k, hk, hq⟩ | hq
    · rcases hq with rfl | rfl
      · right
        have cell := inSites (start20 j - 10 + k) (by unfold prevLen20; split_ifs <;> omega) (by omega)
        have addr : base (start20 j - 10 + k) = start20 j + 6 + k := by simp only [base, Wire]; omega
        rw [← addr]; exact cell.1
      · right
        have cell := inSites (start20 j - 10 + k) (by unfold prevLen20; split_ifs <;> omega) (by omega)
        have addr : base (1028 + (start20 j - 10 + k)) = start20 j + 1034 + k := by simp only [base, Wire]; omega
        rw [← addr]; exact cell.2.1
    · left
      rcases hq with rfl | rfl | rfl
      · exact flagBox 6 (Or.inl rfl)
      · exact flagBox 7 (Or.inr (Or.inl rfl))
      · exact flagBox 8 (Or.inr (Or.inr rfl))
  · simp only [support20, List.mem_flatMap, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false] at hq
    obtain ⟨v, ⟨v1, v2⟩, hq⟩ := hq
    have hv1 : start20 j - prevLen20 j ≤ v := by unfold prevLen20; split_ifs at v1 ⊢ <;> omega
    have hv2 : v < start20 j := by split_ifs at v2 <;> omega
    right
    rcases hq with rfl | rfl
    · have cell := inSites v hv1 hv2; rw [cell.2.2]; exact cell.1
    · exact (inSites v hv1 hv2).2.1

theorem agree_origin20 (j : Fin 9) (d : Bool) (raw s : State) (m t : List Bool) (neg far long : Bool)
    (packed : PackedCut (EnterJ20.lowerPairs j) (EnterJ20.upperPairs j) (EnterJ20.gate j) (EnterJ20.flagN j)
      (EnterJ20.flagF j) (EnterJ20.flagU j) neg far long
      (pullState (EnterJ20.pull j) raw) (eraseSites (EnterJ20.pending j) s))
    (q : Wire) (ext : ¬ WideReference20.Box20 (start20 j) 20 q)
    (still : ¬ (1301 ≤ (q : Nat) ∧ (q : Nat) ≤ 1044 + (start20 j + 19)))
    (mirror : ¬ (2069 ≤ (q : Nat) + (start20 j + 19) ∧ (q : Nat) ≤ 1812)) :
    let history := run (body20 j (withArchive20 j d)) t (run (enterP20 j) m s)
    history.basis q = (WideReference20.origin (start20 j) (prevLen20 j) 20 raw history).basis q := by
  intro history
  have f := EnterJ20.frame j
  have hg := geom20_facts j
  have hw := route_width (start20 j + 19) (by omega)
  have h0 := route_width (start20 j) (by omega)
  have hwp : wpP20 (start20 j) = W.narrowSkywalkRouteWidth (start20 j) - sbP20 (start20 j) - 21 := by
    rw [wpP20, route_eq _ (by omega)]; rfl
  have wn : windowNet20 j q = q := sig_fixed still mirror
  have pullId : OB5.sig (start20 j - 1) q = q :=
    sig_fixed (fun h => still ⟨h.1, by simp only [Wire] at *; omega⟩)
      (fun h => mirror ⟨by simp only [Wire] at *; omega, h.2⟩)
  have notMay : ¬ MayTouch20 j q := by
    intro mt; apply ext
    unfold MayTouch20 at mt
    have mid : (shape20 j).mid = sbP20 (start20 j) + 21 := rfl
    rw [mid] at mt; unfold WideReference20.Box20
    rw [show start20 j + 20 - 1 = start20 j + 19 by omega]
    simp only [Wire] at *; omega
  have port : q ∉ EnterJ20.ports j := fun mem => by
    apply ext; have r := EnterJ20.portsRegion j mem
    unfold WideReference20.Box20
    rw [show start20 j + 20 - 1 = start20 j + 19 by omega]
    simp only [EnterJ20.h20, Wire] at *; omega
  apply WideReference20.box_origin20 (by omega) (by decide) (by omega) ext raw history
  intro notSite
  have notAdmin : q ∉ support20 j ++ prevRawPortsList20 j := by
    intro mem
    rw [prevRaw_split, List.mem_append, List.mem_append] at mem
    rcases mem with mem | mem | mem
    · rcases admin_outside20 j q (List.mem_append_right _ mem) with b | b
      · exact ext b
      · exact notSite b
    · rcases admin_outside20 j q (List.mem_append_left _ mem) with b | b
      · exact ext b
      · exact notSite b
    · have sb := prevScratch20_bounds j mem
      apply ext; unfold WideReference20.Box20; simp only [Wire] at *; omega
  have stay := ext_head20 (enterP20 j) j (withArchive20 j d) (support20 j ++ prevRawPortsList20 j) s m t q
    (by rwa [wn]) (EnterJ20.notWire j port) notAdmin (admin_cover20 j d)
  have hn : q ≠ EnterJ20.flagN j := fun eq => ext (by rw [eq]; unfold WideReference20.Box20 EnterJ20.flagN EnterJ20.h20; simp only [Wire] at *; omega)
  have hf : q ≠ EnterJ20.flagF j := fun eq => ext (by rw [eq]; unfold WideReference20.Box20 EnterJ20.flagF EnterJ20.h20; simp only [Wire] at *; omega)
  have hu : q ≠ EnterJ20.flagU j := fun eq => ext (by rw [eq]; unfold WideReference20.Box20 EnterJ20.flagU EnterJ20.h20; simp only [Wire] at *; omega)
  have hi : q ∉ RailPair.sites (EnterJ20.upperPairs j) := fun m => by
    apply ext; have u := EnterJ20.upperSites j m
    unfold WideReference20.Box20
    rw [show start20 j + 20 - 1 = start20 j + 19 by omega]
    simp only [EnterJ20.h20, Wire] at *; omega
  have pend : q ∉ EnterJ20.pending j := fun mem => by
    apply ext; simp only [EnterJ20.pending, List.mem_cons, List.not_mem_nil, or_false] at mem
    unfold WideReference20.Box20; simp only [EnterJ20.h20, Wire] at *
    rcases mem with rfl | rfl | rfl <;> omega
  have old := packed.unchanged q hn hf hu hi
  rw [stay]
  simpa only [eraseSites, if_neg pend, EnterJ20.pull, pullId] using old

end NativeJ20

