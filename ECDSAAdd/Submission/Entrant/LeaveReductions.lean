          if_neg (show ¬(1559 ≤ e0P20 (start20 j) + 4 ∧ e0P20 (start20 j) + 4 ≤ 1602) by (try unfold Wire at *); omega),
          h3, h4]
        exact hmf.2.1
      · simp only [if_neg q59, if_neg q60]
        by_cases qh : 1561 ≤ q ∧ q ≤ 1580
        · simp [qh, show 1559 ≤ q ∧ q ≤ 1602 by unfold Wire at *; omega]
        · by_cases qr : 1581 ≤ q ∧ q ≤ 1602
          · simp [qh, show 1559 ≤ q ∧ q ≤ 1602 by unfold Wire at *; omega, hu11_zero q qr.1 qr.2]
