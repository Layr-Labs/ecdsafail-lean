theorem tail_clean (j : Fin 26) (h1 : 1≤j.val) (h21 : j.val≤24) (d:Bool) (x p:Nat) (raw s:State)
    (domain:WideReference.Domain (start j) x p raw) (a b:List Bool) (neg far long:Bool)
