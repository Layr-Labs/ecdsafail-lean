    have f:=EnterJ7.frame j
    have zero:raw.basis q=false:=WideReference.domain_carry (by simp only [start]; omega) domain q
      (by simp only [Shadow7.e0P,Wire] at *; omega) (by simp only [Shadow7.e0P,Wire] at *; omega)
