    exact hist_inj345.2.2.2 ⟨w, lt⟩ i eq
  have okB' : MeasuredCodec5.legalAt histB345 mid.basis := by
    rw [MeasuredCodec5.legalAt_iff] at okB ⊢
    intro i; rw [hBpres, hBpres]; exact okB i
  have hA := Rolling1588.codeEncodeAt_correct d histA345 hist_inj345.1 s m okA
  have hB := Rolling1588.codeEncodeAt_correct d histB345 hist_inj345.2.1 mid
    (m.drop (measurementCount (MixedWindow.packW d 345 330))) okB'
  unfold packProg345 packRev345
  rw [run_append, run_take]
  refine ⟨?_, fun t => ?_⟩
  · rw [e2f]; exact hB.1.trans (by simpa [mid, e1f] using hA.1)
  · rw [run_append, run_take]
    have r2 := Rolling1588.codeRoundtripAt d histB345 hist_inj345.2.1 mid
      (m.drop (measurementCount (MixedWindow.packW d 345 330))) t okB'
    rw [← e2f, ← e2r] at r2
    have r1 := Rolling1588.codeRoundtripAt d histA345 hist_inj345.1 s m
      (t.drop (measurementCount (MixedWindow.unpackW d 345 335))) okA
