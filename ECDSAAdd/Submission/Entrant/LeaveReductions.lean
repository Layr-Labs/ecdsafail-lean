  have zeroE : ∀ q ∈ watched j, en.basis q = false := fun q hq => (watchedOK q hq).trans (h.zero q hq)
  have base : ∀ q : Nat, 1561 ≤ q → q ≤ 1597 → en.basis q = false := by
