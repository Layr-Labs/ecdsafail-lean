  unfold b0P20; omega

private theorem pending20_eval (j : Fin 9) (v : BasisState) (F : Nat) (hF : F < 2 ^ liveW20 (start20 j))
    (hbits : ∀ i < liveW20 (start20 j), v (live20 j i) = F.testBit i)
    (h58 : v 1558 = false) :
    (PortalAnd.digits 1558 (pendingPairs20 j)).any v = decide (1 ≤ F / 2 ^ (lowsP20 (start20 j) - 1)) := by
  have hg := geom20_facts j; dsimp only at hg
  simp only [PortalAnd.digits, List.any_cons, h58, Bool.false_or]
  have hval := EnterProof.value_of_bits ((pendingPairs20 j).map Prod.fst) v (F / 2 ^ (lowsP20 (start20 j) - 1)) (by
    intro i hi
    have hlen : ((pendingPairs20 j).map Prod.fst).length = liveW20 (start20 j) - lowsP20 (start20 j) + 1 := by
      simp [pendingPairs20]
    rw [hlen] at hi
    have hget : ((pendingPairs20 j).map Prod.fst).getD i 0 = live20 j (lowsP20 (start20 j) - 1 + i) := by
      simp only [pendingPairs20, List.map_map, Function.comp, List.getD_eq_getElem?_getD, List.getElem?_map,
        List.getElem?_range hi, Option.map_some, Option.getD_some]
      by_cases iz : i = 0
      · subst iz; simp only [if_true, Nat.add_zero, live20, if_pos (by omega : lowsP20 (start20 j) - 1 < lowsP20 (start20 j))]
        unfold Wire; omega
      · simp only [iz, if_false, live20, if_neg (by omega : ¬ (lowsP20 (start20 j) - 1 + i < lowsP20 (start20 j)))]
        congr 1; omega
    rw [hget, hbits _ (by omega), Nat.testBit_div_two_pow, Nat.add_comm])
  have hlen : ((pendingPairs20 j).map Prod.fst).length = liveW20 (start20 j) - lowsP20 (start20 j) + 1 := by
    simp [pendingPairs20]
  have hlt : F / 2 ^ (lowsP20 (start20 j) - 1) < 2 ^ ((pendingPairs20 j).map Prod.fst).length := by
    rw [hlen]
    apply (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr
    rw [← Nat.pow_add, show liveW20 (start20 j) - lowsP20 (start20 j) + 1 + (lowsP20 (start20 j) - 1) =
        liveW20 (start20 j) by omega]
    exact hF
  rw [Nat.mod_eq_of_lt hlt] at hval
  rw [LeaveCompanion.any_positive, hval]
  exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; omega)

private theorem pending20_far (j : Fin 9) (z : SkywalkNat.State) :
    (1 ≤ TrueMiddle20.F j z / 2 ^ (lowsP20 (start20 j) - 1)) ↔
      far (nextSb20 (start20 j)) (nextLen20 j) (step^[20] z) := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  unfold TrueMiddle20.F HighBankSum.total far Shadow.high limb
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  have hdiv : (step^[20] z).u + (step^[20] z).v = (step^[20] z).u + (step^[20] z).v := rfl
  have e : 2 ^ (sbP20 (start20 j) + 1 + (lowsP20 (start20 j) - 1)) =
      2 * 2 ^ (nextSb20 (start20 j) + nextLen20 j + 1) := by
    rw [show sbP20 (start20 j) + 1 + (lowsP20 (start20 j) - 1) = (nextSb20 (start20 j) + nextLen20 j + 1) + 1 by omega,
      Nat.pow_succ, Nat.mul_comm]
  rw [e, Nat.le_div_iff_mul_le (by positivity : 0 < 2 * 2 ^ (nextSb20 (start20 j) + nextLen20 j + 1)),
    Nat.le_div_iff_mul_le (by positivity : 0 < 2 ^ (nextSb20 (start20 j) + nextLen20 j + 1))]
  omega

/-! ### Section 4: `beforeStore20` & `storeMapped20` Forward Semantics -/

attribute [local irreducible] run SkywalkNat.step barrel20 core20Prog fullProg20 beforeStore20 storeMapped20 leaveP20 in
theorem beforeStore20_result (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State)
    (G sg : Bool) (small : Small20 (sbP20 (start20 j)) z) (odd : z.v % 2 = 1)
    (room : high (sbP20 (start20 j)) 20 z + 1 < 2 ^ wpP20 (start20 j))
    (fit : TrueMiddle20.F j z < 2 ^ liveW20 (start20 j))
    (nextSmall : Shadow7.SmallIfFar (nextSb20 (start20 j)) (nextLen20 j) (step^[20] z))
    (ready : onRails20 j 20 (SkywalkRails.encode G sg
      (step^[20] (TrueMiddle20.r j z)).u (step^[20] (TrueMiddle20.r j z)).v) s.basis)
    (fresh : s.basis (e0P20 (start20 j) + 5) = false)
    (scratch : ∀ q ∈ 1556 :: 1557 :: 1558 :: fullC20, s.basis q = false)
    (temp : ∀ p ∈ longPairs20 j, s.basis p.2 = false)
    (clean : ∀ q ∈ carries20 j, s.basis q = false)
    (cPool : ∀ q : Nat, 1623 ≤ q → q < e0P20 (start20 j) → s.basis q = false)
    (padding : ∀ i, wpP20 (start20 j) ≤ i → i < wpP20 (start20 j) + 20 → s.basis (bankW20 (start20 j) i) = false)
    (bank : regValue (ys20 j) s.basis = if far (sbP20 (start20 j)) 20 z then high (sbP20 (start20 j)) 20 z else 0)
    (zero : ∀ q ∈ watched20 j, s.basis q = false)
    (par : oddRead20 j s.basis = oddBits (letters 20 (TrueMiddle20.r j z)))
    (farBit : s.basis (e0P20 (start20 j) + 3) = decide (far (sbP20 (start20 j)) 20 z))
    (sideBit : s.basis (e0P20 (start20 j) + 4) =
      (decide (far (sbP20 (start20 j)) 20 z) && decide (2 ^ sbP20 (start20 j) ≤ z.u)))
    (events : right20 (actualMode20 (sbP20 (start20 j)) z) = true →
      ∀ i < 20, i ≤ key20 (actualMode20 (sbP20 (start20 j)) z) →
        s.basis (swaps20 j i) = decide (i = key20 (actualMode20 (sbP20 (start20 j)) z))) :
    let a := step^[20] z
    let sign := PortalValues.negative sg a.u
    let mag := a.u - sign.toNat
    let nf := decide (far (nextSb20 (start20 j)) (nextLen20 j) a)
    let c := run (core20Prog j) m s
    let f := run (fullProg20 j) m s
    let out := run (beforeStore20 j) m s
    out.phase = s.phase ∧ out.basis 1556 = false ∧ out.basis 1557 = nf ∧
    out.basis 1558 = (nf && decide (2 ^ nextSb20 (start20 j) ≤ a.u)) ∧
    regValue (smallM20 j) out.basis = (mag / 2 ^ (sbP20 (start20 j) + 1)) % 2 ^ lowsP20 (start20 j) ∧
    (∀ i < wpP20 (start20 j) + 20, out.basis (live20 j i) = (TrueMiddle20.F j z).testBit i) ∧
    out.basis (e0P20 (start20 j) + 5) = sign ∧
    (∀ q ∈ history20 j, out.basis q = !s.basis q) ∧
    (∀ i : Fin (lowsP20 (start20 j) + 1),
      out.basis (a0P20 (start20 j) - 1 + i.val) = (a.u + a.v).testBit (sbP20 (start20 j) + i.val) ∧
      out.basis (b0P20 (start20 j) - 1 + i.val) = mag.testBit (sbP20 (start20 j) + i.val)) ∧
    (∀ q, q ≠ 1556 → q ≠ 1557 → q ≠ 1558 → out.basis q = f.basis q) ∧
    (∀ q, q ∉ smallM20 j → f.basis q = c.basis q) := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have he0 : e0P20 (start20 j) = 1579 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hcrt : ∀ k < 10, s.basis (poolW20 (start20 j) (22 + k)) = false := fun k hk => by
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp]; exact cPool _ (by omega) (by omega)
  have hc := core20_result j s m z G sg small odd room fit ready fresh scratch temp clean
    (cPool 1623 (by decide) (by omega)) (cPool 1624 (by decide) (by omega)) hcrt
    padding bank zero par farBit sideBit events
  have hfront := entry20_core j s m z G sg small ready fresh scratch temp
  have hmask := entry20_mask j s m z G sg ready fresh scratch temp
  have hpar := entry20_parity j s m
  have hlow := retainedLow20 (sbP20 (start20 j)) z small.1 sg
  have hrest := restored20 (sbP20 (start20 j)) (lowsP20 (start20 j)) z small sg
  dsimp only at hc hfront hmask hlow hrest
  let en := run (GateMirror.forward (entryLeave20 (start20 j))) m s
  let c := run (core20Prog j) m s
  let m1 := m.drop (measurementCount (core20Prog j))
  let f := run (fullProg20 j) m s
  have hf_eq : f = run (Companion.restore (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558) m1 c := by
    simp only [f, fullProg20, run_append, run_take, c, m1]
  have hsc : ∀ q ∈ smallC20 j, c.basis q = false := by
    intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    exact hc.2.2.2.1 _ (by unfold Wire at *; omega) (by unfold Wire at *; omega)
  have hsm0 : regValue (smallM20 j) c.basis = 0 := by
    apply (regValue_zero _ _).mpr; intro q hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    exact (regValue_zero _ _).mp hc.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 _
      (List.mem_map.mpr ⟨i, List.mem_range.mpr (by omega), rfl⟩)
  have hcomp := Companion.write (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558
    (small20_geometry j) c m1 hsc hsm0
  rw [← hf_eq] at hcomp
