    · obtain ⟨_, same, _, port, pend, hn, hf, hu, hi, nf⟩ := top_geometry20 j (q := 1556 + kk) topw
      have ns : (1556 + kk : Wire) ∉ support20 j := fun h =>
        (tailHead20_all j _ (List.mem_append_right _ h)).2.1 (by unfold Wire; omega)
      have nLo : (1556 + kk : Wire) ∉ RailPair.sites (EnterJ20.lowerPairs j) := by
        simp only [RailPair.sites, EnterJ20.lowerPairs, List.flatMap_cons, List.flatMap_nil,
          List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.append_nil, Wire]
        omega
      apply viaCut _ ns nf port hn hf hu pend nLo hi
      rw [same]; exact carryTop _ (by omega) (by omega)
    · have on := ready_after_head20 j (packProg20 j d) (run (enterP20 j) m s)
        (m.drop (measurementCount (enterP20 j)))
        ((m.drop (measurementCount (enterP20 j))).drop (measurementCount (routed20 j 0 1)))
        Z parity active (fun t => pack_retains20 j d false t _)
      have hmem : (1556 + kk : Wire) ∈ (IntegerPacket.ports (shape20 j) 1).carry.map (windowNet20 j) := by
        apply List.mem_map.mpr
        refine ⟨1556 + kk, ?_, ?_⟩
        · simp only [IntegerPacket.ports, shape20, smallBits20, e0P20, List.mem_range'_1, Wire] at *; omega
        · show OB5.sig (start20 j + 19) (1556 + kk) = 1556 + kk
          refine sig_fixed ?_ ?_ <;> (intro h; simp only [Wire] at *; omega)
      obtain ⟨c, hc, eq⟩ := List.mem_map.mp hmem
      unfold onRails20 at on
      rw [← eq]; exact (regValue_zero _ _).mp on.2.2.2.1 _ hc
  · rw [if_neg low]
    have lo : e0P20 (start20 j) + 10 ≤ 1566 + kk := by omega
    have hi : 1566 + kk ≤ 1699 := by omega
    have pl : EnterJ20.pull j (1566 + kk) = 1566 + kk :=
      sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)
    have wn : windowNet20 j (1566 + kk) = 1566 + kk :=
      sig_fixed (by intro h; simp only [Wire] at *; omega) (by intro h; simp only [Wire] at *; omega)
    have nf : firstUnchanged20 j (1566 + kk) := by
