    intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
  have notSM (p : Wire) (hp : p < b0P20 (start20 j) ∨ b0P20 (start20 j) + lowsP20 (start20 j) ≤ p) : p ∉ smallM20 j := by
    intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
