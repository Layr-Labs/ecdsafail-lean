-- Section 3: Odd-word multiplication endpoint (`InverseTailCOdd`)
-- ============================================================================
section
set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 6000000
set_option linter.unusedSimpArgs false
