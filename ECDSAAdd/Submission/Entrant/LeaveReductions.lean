private theorem capped_half20 {bound k n d : Nat} (h : 2 ^ k * n < bound) (hd : d ≤ n) :
    2 ^ (k + 1) * (d / 2) < bound := by
  rw [pow_succ, Nat.mul_assoc]
  exact lt_of_le_of_lt (Nat.mul_le_mul_left _ (show 2 * (d / 2) ≤ n by omega)) h

private theorem next_capped20 {bound : Nat} (z : SkywalkNat.State) (a b : Nat)
    (hu : 2 ^ a * z.u < bound) (hv : 2 ^ b * z.v < bound) :
    ∃ c d : Nat, c + d = a + b + 1 ∧ 2 ^ c * (step z).u < bound ∧ 2 ^ d * (step z).v < bound := by
  unfold step
  split_ifs with zero even order
  · exact ⟨a + 1, b, by omega, by have hc : 0 < bound := lt_of_le_of_lt (Nat.zero_le _) hu; simpa [zero] using hc, hv⟩
  · exact ⟨a + 1, b, by omega, capped_half20 hu (le_refl _), hv⟩
  · exact ⟨a + 1, b, by omega, capped_half20 hu (Nat.sub_le _ _), hv⟩
  · exact ⟨b + 1, a, by omega, capped_half20 hv (Nat.sub_le _ _), hu⟩

private theorem capped_scales20 {bound : Nat} (x p t : Nat) (hx : x < bound) (hp : p < bound) :
    let z := step^[t] (init x p)
    ∃ a b : Nat, a + b = t ∧ 2 ^ a * z.u < bound ∧ 2 ^ b * z.v < bound := by
  induction t with
  | zero => exact ⟨0, 0, rfl, by simpa [init] using hx, by simpa [init] using hp⟩
  | succ i ih =>
    obtain ⟨a, b, count, hu, hv⟩ := ih
    obtain ⟨c, d, total, nu, nv⟩ := next_capped20 (step^[i] (init x p)) a b hu hv
    rw [Function.iterate_succ_apply']
    exact ⟨c, d, by omega, nu, nv⟩

private theorem unscale20 {a u : Nat} (pos : 0 < u) (h : 2 ^ a * u < 2 ^ 256) :
    a < 256 ∧ u < 2 ^ (256 - a) := by
  have lt : a < 256 := by
    by_contra! lo
    have hp := Nat.pow_le_pow_right (by decide : 0 < 2) lo
    have hm := Nat.mul_le_mul_left (2 ^ a) pos
    rw [Nat.mul_one] at hm
    omega
  refine ⟨lt, Nat.lt_of_mul_lt_mul_left (a := 2 ^ a) ?_⟩
  rw [← pow_add, Nat.add_sub_of_le lt.le]
  exact h

private theorem add_lt_mul_of_lt {u v A B : Nat} (hu1 : 1 ≤ u) (hv1 : 1 ≤ v) (hu : u < A) (hv : v < B) :
    u + v < A * B := by
  have h1 : u + v ≤ u * v + 1 := by
    cases hu' : u with
    | zero => omega
    | succ u0 =>
      cases hv' : v with
      | zero => omega
      | succ v0 =>
        have h0 : 0 ≤ u0 * v0 := Nat.zero_le _
        have hm : (u0 + 1) * (v0 + 1) = u0 * v0 + u0 + v0 + 1 := by ring
        omega
  have h2 : u * v + 1 ≤ (A - 1) * (B - 1) + 1 :=
    Nat.add_le_add_right (Nat.mul_le_mul (by omega) (by omega)) 1
  have hA : 1 ≤ A := by omega
  have hB : 1 ≤ B := by omega
  have h3 : (A - 1) * (B - 1) + 1 < A * B := by
    cases hA' : A with
    | zero => omega
    | succ a0 =>
      cases hB' : B with
      | zero => omega
      | succ b0 =>
        simp only [Nat.add_sub_cancel]
        have hm : (a0 + 1) * (b0 + 1) = a0 * b0 + a0 + b0 + 1 := by ring
        have : 1 ≤ a0 + b0 := by omega
        omega
  omega

theorem scaled_sum_strict20 (x p t : Nat) (good : Bounds x p) (ht : t < 512) :
    (step^[t] (init x p)).u + (step^[t] (init x p)).v < 2 ^ (512 - t) := by
  let z := step^[t] (init x p)
  change z.u + z.v < 2 ^ (512 - t)
  have valid := iter_valid t (init x p) good.positive good.odd
  change 0 < z.v ∧ z.v % 2 = 1 ∧ z.u.gcd z.v = x.gcd p at valid
  by_cases empty : z.u = 0
  · have hg := valid.2.2
    rw [empty, Nat.gcd_zero_left] at hg
    have one : z.v = 1 := hg.trans good.coprime
    rw [empty, one, Nat.zero_add]
    exact Nat.one_lt_two_pow (by omega)
  · obtain ⟨a, b, total, hu, hv⟩ := capped_scales20 x p t (lt_trans good.small good.cap) good.cap
    obtain ⟨aa, smallU⟩ := unscale20 (Nat.pos_of_ne_zero empty) (show 2 ^ a * z.u < 2 ^ 256 from hu)
    obtain ⟨bb, smallV⟩ := unscale20 valid.1 (show 2 ^ b * z.v < 2 ^ 256 from hv)
    have hmul := add_lt_mul_of_lt (Nat.pos_of_ne_zero empty) valid.1 smallU smallV
    rw [← pow_add, show 256 - a + (256 - b) = 512 - t by omega] at hmul
    exact hmul

private theorem gap_any_small20 {a v p : Nat} (h : 2 ^ a * v ≤ p) : v ≤ p := by
  have mul := Nat.mul_le_mul_right v (show 1 ≤ 2 ^ a from Nat.two_pow_pos _)
  simpa using mul.trans h

private theorem gap_large_exp20 {a v p : Nat} (ha : 224 ≤ a) (value : 2 ^ a * v ≤ p) (cap : p < 2 ^ 256) :
    v < 2 ^ 32 := by
  apply Nat.lt_of_mul_lt_mul_left (a := 2 ^ 224)
  have power := Nat.pow_le_pow_right (by decide : 0 < 2) ha
  calc 2 ^ 224 * v ≤ 2 ^ a * v := Nat.mul_le_mul_right _ power
       _ ≤ p := value
       _ < 2 ^ 224 * 2 ^ 32 := by norm_num at cap ⊢; exact cap

private theorem early_ceiling20 {a b u v p t : Nat} (h : a + b = t) (hu : 2 ^ a * u ≤ p)
    (hv : 2 ^ b * v ≤ p) (cap : p < 2 ^ 256) (gap : p + 2 ^ 32 ≤ 2 ^ 256) (ht : 224 ≤ t) : u + v < 2 ^ 256 := by
  by_cases az : a = 0
  · have small := gap_large_exp20 (a := b) (by omega) hv cap
    have big := gap_any_small20 hu
    omega
  by_cases bz : b = 0
  · have small := gap_large_exp20 (a := a) (by omega) hu cap
    have big := gap_any_small20 hv
    omega
  have ua := Nat.mul_le_mul_right u (Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 1 ≤ a))
  have vb := Nat.mul_le_mul_right v (Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 1 ≤ b))
  simp only [pow_one] at ua vb
  omega

private theorem gap_one_side20 {b v p t : Nat} (hb : b + 255 = t) (hv : 2 ^ b * v ≤ p)
    (gap : p + 2 ^ 32 ≤ 2 ^ 256) (hi : t ≤ 286) : v + 1 < 2 ^ (511 - t) := by
  have low : 2 ^ b < 2 ^ 32 := Nat.pow_lt_pow_right (by decide) (by omega)
  apply Nat.lt_of_mul_lt_mul_left (a := 2 ^ b)
  rw [← pow_add, show b + (511 - t) = 256 by omega, Nat.mul_add, Nat.mul_one]
  omega

private theorem mid_ceiling20 {a b u v p t : Nat} (h : a + b = t) (hu : 2 ^ a * u ≤ p)
    (hv : 2 ^ b * v ≤ p) (pu : 0 < u) (pv : 0 < v) (cap : p < 2 ^ 256)
    (gap : p + 2 ^ 32 ≤ 2 ^ 256) (hi : t ≤ 286) : u + v < 2 ^ (511 - t) := by
  obtain ⟨_, smallU⟩ := unscale20 pu (lt_of_le_of_lt hu cap)
  obtain ⟨_, smallV⟩ := unscale20 pv (lt_of_le_of_lt hv cap)
  by_cases ea : a = 255
  · have vs := gap_one_side20 (b := b) (by omega) hv gap hi
    rw [ea] at smallU; norm_num at smallU; omega
  by_cases eb : b = 255
  · have us := gap_one_side20 (b := a) (by omega) hu gap hi
    rw [eb] at smallV; norm_num at smallV; omega
  have ub := smallU.trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 256 - a ≤ 510 - t))
  have vb := smallV.trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 256 - b ≤ 510 - t))
  rw [show 511 - t = (510 - t) + 1 by omega, pow_succ]
  omega

theorem prime_gap_sum20 (x p t : Nat) (good : Bounds x p) (lo : 224 ≤ t) (hi : t ≤ 286) :
    (step^[t] (init x p)).u + (step^[t] (init x p)).v < 2 ^ (min 256 (511 - t)) := by
  let z := step^[t] (init x p)
  change z.u + z.v < 2 ^ (min 256 (511 - t))
  obtain ⟨a, b, total, hu, hv⟩ := capped_scales20 x p t (bound := p + 1) (by have := good.small; omega) (by omega)
  have xu : 2 ^ a * z.u ≤ p := Nat.le_of_lt_succ hu
  have xv : 2 ^ b * z.v ≤ p := Nat.le_of_lt_succ hv
  by_cases early : 256 ≤ 511 - t
  · rw [Nat.min_eq_left early]; exact early_ceiling20 total xu xv good.cap good.gap lo
  rw [Nat.min_eq_right (by omega)]
  have valid := iter_valid t (init x p) good.positive good.odd
  change 0 < z.v ∧ z.v % 2 = 1 ∧ z.u.gcd z.v = x.gcd p at valid
  by_cases empty : z.u = 0
  · have hg := valid.2.2
    rw [empty, Nat.gcd_zero_left] at hg
    rw [empty, hg.trans good.coprime, Nat.zero_add]
    exact Nat.one_lt_two_pow (by omega)
  exact mid_ceiling20 total xu xv (Nat.pos_of_ne_zero empty) valid.1 good.cap good.gap hi

theorem env_room20 {S e W : Nat}
    (case : (257 ≤ W + e ∧ e ≤ 254 ∧ S ≤ 2 ^ 256 + 2 ^ 255) ∨ (2 ≤ W ∧ S ≤ 2 ^ (W - 1 + e))) :
    S / 2 ^ e + 1 < 2 ^ W ∧ S < 2 ^ (W + e) := by
  rcases case with ⟨hR, he, hS⟩ | ⟨hW, hS⟩
  · have hk : (255 - e) + e = 255 := by omega
    have h255 : (2 : Nat) ^ 255 = 2 ^ (255 - e) * 2 ^ e := by rw [← pow_add, hk]
    have h3 : (2 : Nat) ^ 256 + 2 ^ 255 = 2 ^ e * (3 * 2 ^ (255 - e)) := by
      rw [show (2 : Nat) ^ 256 = 2 * 2 ^ 255 by norm_num, h255]; ring
    have hdiv : S / 2 ^ e ≤ 3 * 2 ^ (255 - e) := Nat.div_le_of_le_mul (by rw [← h3]; exact hS)
    have h4 : 4 * 2 ^ (255 - e) ≤ 2 ^ W := by
      calc 4 * 2 ^ (255 - e) = 2 ^ (255 - e + 2) := by rw [pow_add]; ring
        _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) (by omega)
    have h6 : 2 ≤ 2 ^ (255 - e) := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (255 - e) := Nat.pow_le_pow_right (by norm_num) (by omega)
    clear h3 h255
    refine ⟨?_, ?_⟩
    · generalize S / 2 ^ e = D at *; generalize 2 ^ (255 - e) = X at *; generalize 2 ^ W = Y at *; omega
    · calc S ≤ 2 ^ 256 + 2 ^ 255 := hS
        _ < 2 ^ 257 := by norm_num
        _ ≤ 2 ^ (W + e) := Nat.pow_le_pow_right (by norm_num) hR
  · have hdiv : S / 2 ^ e ≤ 2 ^ (W - 1) :=
      Nat.div_le_of_le_mul (by rw [← pow_add, show e + (W - 1) = W - 1 + e by omega]; exact hS)
    have hpow : (2 : Nat) ^ W = 2 * 2 ^ (W - 1) := by rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ W)]
    have h6 : 2 ≤ 2 ^ (W - 1) := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (W - 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    refine ⟨?_, ?_⟩
    · rw [hpow]; generalize S / 2 ^ e = D at *; generalize 2 ^ (W - 1) = X at *; omega
    · calc S ≤ 2 ^ (W - 1 + e) := hS
        _ < 2 ^ (W + e) := Nat.pow_lt_pow_right (by norm_num) (by omega)

private theorem sum_early20 (x p t : Nat) (hx : x < 2 ^ 256) (hp : p < 2 ^ 256) (ht : 1 ≤ t) :
    (step^[t] (init x p)).u + (step^[t] (init x p)).v ≤ 2 ^ 256 + 2 ^ 255 := by
  obtain ⟨k, rfl⟩ : ∃ k, t = k + 1 := ⟨t - 1, by omega⟩
  have h : (step^[k + 1] (init x p)).u + (step^[k + 1] (init x p)).v ≤ 2 ^ 256 + 2 ^ 256 / 2 :=
    LeaveBankEnvelope.after_first x p (2 ^ 256) hx.le hp.le k
  have e : (2 : Nat) ^ 256 / 2 = 2 ^ 255 := by norm_num
  rw [e] at h
  exact h

theorem terminal_fit_live20 (j : Fin 9) (x p : Nat) (good : Bounds x p) :
    TrueMiddle20.F j (step^[start20 j] (init x p)) < 2 ^ liveW20 (start20 j) := by
  have hg := geom20_facts j; dsimp only at hg
  have hx : x < 2 ^ 256 := lt_trans good.small good.cap
  have it : step^[20] (step^[start20 j] (init x p)) = step^[start20 j + 20] (init x p) := by
    rw [← Function.iterate_add_apply, Nat.add_comm]
  unfold liveW20 TrueMiddle20.F HighBankSum.total
  split_ifs with mid late
  · have fits : sbP20 (start20 j) + 1 ≤ min 256 (511 - (start20 j + 20)) := by omega
    rw [it, Nat.div_lt_iff_lt_mul (by positivity), ← pow_add, Nat.sub_add_cancel fits]
    exact prime_gap_sum20 x p _ good mid.1 mid.2
  · have fits : sbP20 (start20 j) + 1 ≤ 512 - (start20 j + 20) := by omega
    rw [it, Nat.div_lt_iff_lt_mul (by positivity), ← pow_add, Nat.sub_add_cancel fits]
    exact scaled_sum_strict20 x p _ good (by omega)
  · have hlt : start20 j + 20 < 224 := by omega
    have fits : sbP20 (start20 j) + 1 ≤ min 257 (railP (start20 j + 20)) := by
      unfold railP; split_ifs <;> omega
    rw [it, Nat.div_lt_iff_lt_mul (by positivity), ← pow_add, Nat.sub_add_cancel fits]
    calc (step^[start20 j + 20] (init x p)).u + (step^[start20 j + 20] (init x p)).v
        ≤ 2 ^ 256 + 2 ^ 255 := sum_early20 x p _ hx good.cap (by omega)
      _ < 2 ^ 257 := by norm_num
      _ ≤ 2 ^ min 257 (railP (start20 j + 20)) :=
          Nat.pow_le_pow_right (by norm_num) (by unfold railP; split_ifs <;> omega)

theorem terminal_fit_rail20 (j : Fin 9) (x p : Nat) (good : Bounds x p) :
