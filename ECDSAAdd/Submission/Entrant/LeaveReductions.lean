  rw [(equals j (by omega) d).1,(equals j (by omega) d).2,Rolling1588.codeEncodeAt,Rolling1588.codeDecodeAt,
    renameProgram_support,renameProgram_support,(Rolling1588.code_support d).1,(Rolling1588.code_support d).2]
