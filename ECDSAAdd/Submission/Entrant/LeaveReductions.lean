theorem barrel_box (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (mir : Bool) :
    ∀ q ∈ wires (CRTBarrel.barrel (start j) mir), leaveBox (start j) q := by
