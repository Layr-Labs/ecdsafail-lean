    have her : GatePhysical (eraseCarry (L.r.getD 0 0) (L.y.getD 0 0) L.one (((Q6Structural.q6Carry L).take 255).getD 0 0)) := by
      simp [eraseCarry, GatePhysical, PhysicalInstr, ProperGate]
    have hda : ∀ a ∈ L.r.drop 1,
