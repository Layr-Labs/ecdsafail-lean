theorem allW_swapL {P : Wire → Prop} (a c b b' : List Gate) (sub : ∀ g' ∈ b', ∀ q ∈ g'.wires, ∃ g ∈ b, q ∈ g.wires)
    (h : AllW P (a ++ (b ++ c))) : AllW P (a ++ (b' ++ c)) := by
