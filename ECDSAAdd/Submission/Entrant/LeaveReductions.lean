theorem leaveP20Red_pair (j : Fin 9) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    (∀ m, run (leaveP20Red j) m s = run (leaveP20 j) m s) ∧
    (∀ m n, run (leaveInvP20Red j) n (run (leaveP20Red j) m s) = s) := by
  let sc := start20 j; let b := sbP20 sc; let top := a0P20 sc + lowsP20 sc - 1
  have hg := geom20_facts j; dsimp only at hg
  have hsc_eq : sc = start20 j := rfl
  have hb_eq : b = sbP20 (start20 j) := rfl
  have ha0 : a0P20 sc = sc + b + 37 := rfl
  have hb0 : b0P20 sc = 787 + b := rfl
