    by_cases q59 : q = 1559
    · subst q59; simp only [if_pos rfl, if_neg (by decide : (1559 : Wire) ≠ 1560), if_neg (by omega : ¬(1561 ≤ 1559 ∧ 1559 ≤ 1580)),
        if_neg (show ¬(1559 ≤ e0P20 (start20 j) + 3 ∧ e0P20 (start20 j) + 3 ≤ 1602) by (try unfold Wire at *); omega),
        if_neg (show ¬(1559 ≤ e0P20 (start20 j) + 4 ∧ e0P20 (start20 j) + 4 ≤ 1602) by (try unfold Wire at *); omega),
