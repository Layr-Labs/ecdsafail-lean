private theorem run_sign8_20 (a b c d t : Wire) (m : List Bool) (s : State)
    (at' : a ≠ t) (bt : b ≠ t) (ct : c ≠ t) (dt : d ≠ t) (ba : b ≠ a) :
    let u := run [.CX a t, .CX c t, .CX d t, .CX b a] m s
    u.phase = s.phase ∧
    u.basis t = (((s.basis t ^^ s.basis a) ^^ s.basis c) ^^ s.basis d) ∧
    u.basis a = (s.basis a ^^ s.basis b) ∧
    ∀ q, q ≠ t → q ≠ a → u.basis q = s.basis q := by
  have hat : t ≠ a := at'.symm
  refine ⟨rfl, ?_, ?_, ?_⟩
  · simp [run, writeBit, Function.update, at', ct, dt, hat]
  · simp [run, writeBit, Function.update, at', bt, ct, dt, hat, ba]
  · intro q hqt hqa; simp [run, writeBit, Function.update, hqt, hqa]

private theorem run_sign10_20 (a b c d t : Wire) (m : List Bool) (s : State)
    (at' : a ≠ t) (bt : b ≠ t) (ct : c ≠ t) (dt : d ≠ t) :
