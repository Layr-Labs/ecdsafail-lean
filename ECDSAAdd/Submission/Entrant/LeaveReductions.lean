theorem admitted20 (j : Fin 9) (d : Bool) (x p : Nat) (good : Bounds x p) (raw s : State) (m : List Bool)
    (domain : Domain (start20 j) x p raw) (G S : Bool)
    (cut : PackedCut (EnterJ20.lowerPairs j) (EnterJ20.upperPairs j) (EnterJ20.gate j) (EnterJ20.flagN j)
      (EnterJ20.flagF j) (EnterJ20.flagU j) (PortalValues.negative S (unsigned (start20 j) x p).u)
      (decide (Shadow.far (sbP20 (start20 j)) 20 (unsigned (start20 j) x p)))
      (decide (Shadow.far (sbP20 (start20 j)) 20 (unsigned (start20 j) x p) ∧
        2 ^ sbP20 (start20 j) ≤ (unsigned (start20 j) x p).u))
      (pullState (EnterJ20.pull j) raw) (eraseSites (EnterJ20.pending j) s))
    (input : SkywalkIntegerInput (EnterJ20.lay j)
      (SkywalkRails.encode G S (unsigned (start20 j) x p).u (unsigned (start20 j) x p).v).a
      (SkywalkRails.encode G S (unsigned (start20 j) x p).u (unsigned (start20 j) x p).v).b G raw.basis)
    (scratch : ∀ k : Fin 157, 23 ≤ k.val →
      let pre := run (enterP20 j) m s
      let tape := m.drop (measurementCount (enterP20 j))
      (run (packProg20 j d) (tape.drop (measurementCount (routed20 j 0 1))) (run (routed20 j 0 1) tape pre)).basis
        (prevRawPorts20 j k) = false)
    (past : SkywalkNat.State) (pg ps cross : Bool) (po : past.v % 2 = 1)
    (pm : PrevSmall20 j past) (prior : PrevPast20 j past pg ps cross s) :
    let out := run (nextWindow20 j d) m s
    Inputs20 j out (unsigned (start20 j) x p) G S ∧
    out.phase = s.phase ∧
    (∃ row < 63145, PrevRowTruth20 j past pg ps row ∧ Kept (prevCodePorts20 j) d row out ∧
      ∀ k : Fin 3, out.basis (e0P20 (start20 j) + 6 + k.val) = false) ∧
    (∀ q ∈ tailTemps20 j, out.basis q = false) ∧
    (∀ t, run (nextUnwind20 j d) t out = s) := by
  have hg := geom20_facts j; dsimp only at hg
  have numbers := actualNumbers20 j x p good
  have hist := WideReference20.pulled_history20 j domain
  have win := next_window20 j d raw s m (unsigned (start20 j) x p) G S numbers.odd numbers.small.1
    cut input hist scratch past pg ps cross po pm prior
  have hrec := real_receipt20 j d raw s m (unsigned (start20 j) x p) G S numbers.odd numbers.small.1
    cut input hist scratch past pg ps cross po pm prior
  let pre := run (enterP20 j) m s
  let tape := m.drop (measurementCount (enterP20 j))
  have runEq : run (nextWindow20 j d) m s = run (body20 j (withArchive20 j d)) tape pre := by
    simp only [nextWindow20, window20, run_append, run_take, pre, tape]
  have sv := saved_with_pending20 j d raw s (unsigned (start20 j) x p) G S m tape numbers.small.1 cut input
  have pk := parked_clean20 j d raw s (unsigned (start20 j) x p) G S m tape numbers.small.1 cut input
  let T := Shadow.reduced (sbP20 (start20 j)) 20 (unsigned (start20 j) x p)
  let Z := SkywalkRails.encode G S T.u T.v
  have to' : T.v % 2 = 1 := shadow_odd20 (sbP20 (start20 j)) _ numbers.small.1 numbers.odd
  have parity : (Z.a + Z.b) % 2 = 1 := SkywalkRails.encode_odd_sum G S _ _ (by omega)
  have ready0 := EnterJ20.ready_pending_at j raw s (unsigned (start20 j) x p) G S m numbers.small.1 cut input hist
  obtain ⟨_, row, limit, _, frame⟩ := admits20 j d s m tape (tape.drop (measurementCount (routed20 j 0 1)))
    Z parity ready0.2.1 scratch past pg ps cross po pm prior
  have final := archive_result20 j d row limit _ _ frame
  have tl := tail_clean20 j d x p raw s domain m tape _ _ _ cut row final
  have tp := top_clean20 j d x p raw s domain m tape _ _ _ cut row final (e0P20 (start20 j) - 1) (by unfold Wire; omega)
  obtain ⟨row', lim', truth', kept', flags'⟩ := hrec
  dsimp only
  refine ⟨?_, win.1, ⟨row', lim', truth', kept', flags'⟩, fun q hq => runEq ▸ tl q hq, win.2.2.2⟩
  apply assemble20 j _ (unsigned (start20 j) x p) G S numbers win.2.1 win.2.2.1
  · rw [runEq, ← saved20_eq_ys20 j]
    have eN : e0P20 (start20 j) + 5 = EnterJ20.flagN j := by unfold e0P20 EnterJ20.flagN EnterJ20.h20; omega
    have eF : e0P20 (start20 j) + 3 = EnterJ20.flagF j := by unfold e0P20 EnterJ20.flagF EnterJ20.h20; omega
    have eU : e0P20 (start20 j) + 4 = EnterJ20.flagU j := by unfold e0P20 EnterJ20.flagU EnterJ20.h20; omega
    rw [eN, eF, eU]; exact sv
  · simpa using flags' 0
  · simpa using flags' 1
  · intro q hq; rw [runEq]; exact tl q hq
  · rw [runEq]; exact tp
  · rw [runEq]
    have epk : b0P20 (start20 j) + 22 = EnterJ20.parked j := by unfold b0P20 EnterJ20.parked EnterJ20.h20; omega
    rw [epk]; exact pk

/-! ### Section 3: Archive Cut, Boundary Rails, Boundary Clean & Certified Cuts -/

private theorem reloc20_swaps_untouched (j : Fin 9) (k : Fin 20) :
    LeaveRelocation.source (movesP20 (start20 j)) (swaps20 j k.val) = swaps20 j k.val := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hb := swaps20_bounds j k
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbt2 : bTopP (start20 j + 20) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hge : nextWp20 (start20 j) ≤ bTopP (start20 j + 20) + 3 := by
    have : ∀ m : Fin 9, nextWp20 (start20 m) ≤ bTopP (start20 m + 20) + 3 := by decide +kernel
    exact this j
  apply LeaveRelocation.outside; intro p hp
  simp only [movesP20, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with ⟨i, hi, rfl⟩ | hfl
  · have hbc := bank20_cases j (i := lowsP20 (start20 j) + i) (by omega)
    constructor
    · rcases hbc with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
        (dsimp only; rw [eb]; rcases hb with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega))
    · dsimp only
      have hdst : bTopP (start20 j + 20) + 3 + i - nextWp20 (start20 j) ≤ 1043 := by omega
      rcases hb with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega)
  · have hne : nextE0_20 (start20 j) + 8 < e0P20 (start20 j) + 10 := by
      have : ∀ m : Fin 9, nextE0_20 (start20 m) + 8 < e0P20 (start20 m) + 10 := by decide +kernel
      exact this j
    rcases hfl with rfl | rfl | rfl | rfl | rfl | rfl <;>
      (rcases hb with ⟨_, _⟩ | ⟨_, _⟩ <;> exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega⟩)

attribute [local irreducible] run SkywalkNat.step barrel20 core20Prog fullProg20 beforeStore20 storeMapped20 leaveP20 in
theorem archiveCut20 (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    PastFacts20 j (ArchiveJ20.rawPorts j) z g0 s0
      (HighBankSum.crossBit (TrueMiddle20.d j z)) (run (leaveP20 j) m s) := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  let u := flags20 z g0 s0
  let xs := SkywalkTrace.trace 20 (SkywalkRails.encode g0 s0 z.u z.v)
  have par := recordedParity20 j s z g0 s0 h.small h.odd h.record
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have w := whole20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
    xs (SkywalkTrace.trace_length _ _) (certifiedChain20 _ _ _ _ h.small h.odd)
    (firstSwap20 _ _ _ _ h.small h.odd) ev.1
  have hcrt : ∀ k < 10, s.basis (poolW20 (start20 j) (22 + k)) = false := fun k hk => by
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp]; exact h.cPool _ (by omega) (by omega)
  have hc := core20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.ready
    h.fresh h.scratch h.temp h.clean (h.cPool 1623 (by decide) (by omega)) (h.cPool 1624 (by decide) (by omega)) hcrt
    h.padding h.bank h.zero par h.far h.side ev.2
  have hbs := beforeStore20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
  have hprev : s.basis (start20 j + 35) = u.1 := by
    have hr := h.ready.2.2.1
    have hp : start20 j + 35 = windowNet20 j (IntegerPacket.ports (shape20 j) 20).previous := by
      have : ∀ k : Fin 9, start20 k + 35 = windowNet20 k (IntegerPacket.ports (shape20 k) 20).previous := by
        decide +kernel
      exact this j
    rw [hp]
    change mappedBasis20 j s.basis _ = _ at hr
    cases hu : (flags20 z g0 s0).1 <;> simpa only [u, hu, mappedBasis20, SkywalkRails.encode] using hr
  have hlc := lowClose20_result j s (run (beforeStore20 j) m s)
    (m.drop (measurementCount (beforeStore20 j))) u.1 (PortalValues.negative u.2 (step^[20] z).u)
    ((step^[20] z).u + (step^[20] z).v) ((step^[20] z).u - (PortalValues.negative u.2 (step^[20] z).u).toNat)
    hprev hbs.2.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.2.2.1
  have hkept : physicalCells20 j (run (leaveP20 j) m s) = xs := by
    unfold physicalCells20
    rw [cells20_eq j, show xs = readCells (shape20 j) 0 20 (mappedBasis20 j s.basis) from h.record.symm, cells20_eq j]
    apply List.map_congr_left; intro k hk
    rw [List.mem_range] at hk
    have ha : (run (leaveP20 j) m s).basis (start20 j + 16 + k) = s.basis (start20 j + 16 + k) :=
      w.2.2.2.2.2.2.2.1 _ (List.mem_map.mpr ⟨k, List.mem_range.mpr hk, rfl⟩)
    have hb : (run (leaveP20 j) m s).basis (swaps20 j k) = s.basis (swaps20 j k) := by
      have hsw := swaps20_bounds j ⟨k, hk⟩; dsimp only at hsw
      have hwb := w.2.2.2.2.2.2.2.2.2.2 (swaps20 j k)
      rw [reloc20_swaps_untouched j ⟨k, hk⟩] at hwb
      have hne4 : swaps20 j k ≠ e0P20 (start20 j) + 4 := by rcases hsw with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega)
      rw [hwb, writeBit, Function.update_of_ne hne4]
      have hsm_eq : run (storeMapped20 j) m s =
          run (GateMirror.forward (leaveLowClose20 (start20 j))) (m.drop (measurementCount (beforeStore20 j)))
            (run (beforeStore20 j) m s) := by
        simp only [storeMapped20, run_append, run_take]
      rw [hsm_eq]
      have hnotLow : swaps20 j k ∉ RailPair.sites (low20 j) := by
        intro hm; obtain ⟨p, hp, hq⟩ := List.mem_flatMap.mp hm
        obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hi
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
        rcases hq with e | e <;> rcases hsw with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega)
      have hnotHist : swaps20 j k ∉ history20 j := by
        intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
        rcases hsw with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega)
      have hnotSM : swaps20 j k ∉ smallM20 j := by
        intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
        rcases hsw with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega)
      have haway : HighBankBarrel.outside (bankW20 (start20 j)) (wpP20 (start20 j) + 20) (swaps20 j k) ∧
          (∀ r ∈ columnsP20 (start20 j), swaps20 j k ≠ r.shadow ∧ swaps20 j k ≠ r.tube) := by
        refine ⟨fun t ht e => ?_, fun r hr => ?_⟩
        · rcases bank20_cases j ht with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
            (rw [eb] at e; rcases hsw with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega))
        · obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hr; rw [List.mem_range] at ht
          rcases bank20_cases j (i := t) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
            (dsimp only; rw [eb]; rcases hsw with ⟨_, _⟩ | ⟨_, _⟩ <;> (unfold Wire at *; omega))
      rw [hlc.2.2.2 _ hnotLow hnotHist]
      rcases hsw with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · rw [hbs.2.2.2.2.2.2.2.2.2.1 _ (by unfold Wire at *; omega) (by unfold Wire at *; omega) (by unfold Wire at *; omega),
          hbs.2.2.2.2.2.2.2.2.2.2 _ hnotSM,
          hc.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 _ (by unfold Wire at *; omega) (by unfold Wire at *; omega)
            (by unfold Wire at *; omega) haway.1 haway.2]
        exact entry20_keep j _ (by unfold Wire at *; omega) s m
      · rw [hbs.2.2.2.2.2.2.2.2.2.1 _ (by unfold Wire at *; omega) (by unfold Wire at *; omega) (by unfold Wire at *; omega),
          hbs.2.2.2.2.2.2.2.2.2.2 _ hnotSM,
          hc.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 _ (by unfold Wire at *; omega) (by unfold Wire at *; omega)
            (by unfold Wire at *; omega) haway.1 haway.2]
        exact entry20_keep j _ (by unfold Wire at *; omega) s m
    exact Prod.ext ha hb
  have hp20 : ArchiveJ20.rawPorts j 20 = nextE0_20 (start20 j) + 6 := by
    have : ∀ r : Fin 9, ArchiveJ20.rawPorts r 20 = nextE0_20 (start20 r) + 6 := by decide +kernel
    exact this j
  have hp21 : ArchiveJ20.rawPorts j 21 = nextE0_20 (start20 j) + 7 := by
    have : ∀ r : Fin 9, ArchiveJ20.rawPorts r 21 = nextE0_20 (start20 r) + 7 := by decide +kernel
    exact this j
  have hp22 : ArchiveJ20.rawPorts j 22 = nextE0_20 (start20 j) + 8 := by
    have : ∀ r : Fin 9, ArchiveJ20.rawPorts r 22 = nextE0_20 (start20 r) + 8 := by decide +kernel
    exact this j
  refine ⟨hkept, ?_, ?_, ?_⟩
  · rw [hp20]; exact w.2.2.2.2.1
  · rw [hp21, hkept, w.2.2.2.2.2.1]
    by_cases hf : Shadow.far (sbP20 (start20 j)) 20 z
    · rw [orient20 _ _ h.small hf]
    · simp [hf]
  · rw [hp22]; exact w.2.2.2.2.2.2.1

end ECDSAAdd.Entrant.StairPacket.Shadow20.LeaveCut20
