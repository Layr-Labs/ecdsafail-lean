abbrev r (j : Fin 9) (z : SkywalkNat.State) := Shadow.reduced (sbP20 (start20 j)) 20 z
def key (j : Fin 9) (z : SkywalkNat.State) : Fin 21 :=
  ⟨if 2 ^ sbP20 (start20 j) ≤ z.u then 0 else wait 20 z.u, by have := wait_le 20 z.u; split <;> omega⟩
def X (j : Fin 9) (z : SkywalkNat.State) : Nat := total (step^[20] (r j z)) / 2 ^ (sbP20 (start20 j) + 1)
def F (j : Fin 9) (z : SkywalkNat.State) : Nat := total (step^[20] z) / 2 ^ (sbP20 (start20 j) + 1)
