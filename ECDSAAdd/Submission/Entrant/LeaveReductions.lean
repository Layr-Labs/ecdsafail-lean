/-! ### Section 1: Tail Definitions & Structural Decomposition -/

def smallA20 (j : Fin 9) : List Wire :=
  (List.range (lowsP20 (start20 j))).map (a0P20 (start20 j) + ·)

def smallM20 (j : Fin 9) : List Wire :=
  (List.range (lowsP20 (start20 j))).map (b0P20 (start20 j) + ·)

def smallC20 (j : Fin 9) : List Wire :=
  (List.range (lowsP20 (start20 j) - 1)).map (1559 + ·)

def releaseMaskP20 (j : Fin 9) : Program :=
  GateMirror.forward [.pop (b0P20 (start20 j) - 1) 1557 1558, .cx (a0P20 (start20 j) - 1) 1557, .x 1557]

def pendingPairs20 (j : Fin 9) : List (Wire × Wire) :=
  let s := start20 j
  let L := lowsP20 s
  let H := liveW20 s - L
  (List.range (H + 1)).map fun k =>
    (if k = 0 then a0P20 s + L - 1 else bankW20 s (L + k - 1), storeWire20 s (k + 1))

def clearFlagPairs20 (j : Fin 9) : List (Wire × Wire) :=
  (List.range (lowsP20 (start20 j) + 1)).map fun k => (b0P20 (start20 j) - 1 + k, 1559 + k)

def low20 (j : Fin 9) : List (Wire × Wire) :=
  (List.range (lowsP20 (start20 j) + 1)).map fun i => (a0P20 (start20 j) - 1 + i, b0P20 (start20 j) - 1 + i)

def events20 (j : Fin 9) : List (Wire × Wire) :=
  ([(0, 1556), (1, 1559), (2, 1560), (3, 1561), (4, 1562),
    (5, 1563), (6, 1564), (7, 1565), (8, 1566), (9, 1567)]).map fun p => (swaps20 j p.1, p.2)

def nextLen20 (j : Fin 9) : Nat := if j.val < 8 then 20 else 15

def fullProg20 (j : Fin 9) : Program :=
  core20Prog j ++ Companion.restore (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558

def beforeStore20 (j : Fin 9) : Program :=
  fullProg20 j ++ (releaseMaskP20 j ++ GateMirror.forward (leaveStoreMapped20 (start20 j)))

def storeMapped20 (j : Fin 9) : Program :=
  beforeStore20 j ++ GateMirror.forward (leaveLowClose20 (start20 j))

private theorem forward_chainG20 (c seq : Nat → Wire) (out : Wire) : ∀ (i n : Nat),
    GateMirror.forward (chainG c seq [.cx (c (i + n)) out, .x out] i n) =
      PortalAnd.chain true none out (c i) ((List.range n).map fun k => (seq (i + k), c (i + k + 1)))
  | i, 0 => by simp [chainG, PortalAnd.chain, PortalAnd.target, GateMirror.forward, front]
  | i, n + 1 => by
    have ih := forward_chainG20 c seq out (i + 1) n
    rw [show i + 1 + n = i + (n + 1) by omega] at ih
    have el : (List.range (n + 1)).map (fun k => (seq (i + k), c (i + k + 1))) =
        (seq i, c (i + 1)) :: (List.range n).map (fun k => (seq (i + 1 + k), c (i + 1 + k + 1))) := by
      rw [List.range_succ_eq_map, List.map_cons, List.map_map]
      refine congrArg₂ List.cons rfl (List.map_congr_left fun k _ => ?_)
      show (seq (i + (k + 1)), c (i + (k + 1) + 1)) = (seq (i + 1 + k), c (i + 1 + k + 1))
      rw [show i + (k + 1) = i + 1 + k by omega]
    show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) ::
      (chainG c seq [.cx (c (i + (n + 1))) out, .x out] (i + 1) n ++ [.pop (c i) (seq i) (c (i + 1))])) = _
    rw [show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) :: _) =
      front (.make (c i) (seq i) (c (i + 1))) :: GateMirror.forward _ from rfl,
      forward_app, ih, el]
    rfl

private theorem forward_eventsG20 : ∀ (ps : List (Wire × Wire)) (a out : Wire),
    GateMirror.forward (eventsG a out ps) = LeaveNoSwap.block a out ps
  | [], _, _ => rfl
  | (x, t) :: ps, a, out => by
    show GateMirror.forward ([.x x, .make a x t] ++ (eventsG t out ps ++ [.pop a x t, .x x])) = _
    rw [forward_app, forward_app, forward_eventsG20 ps t out]; rfl

private theorem forward_swapsG20 : ∀ ps : List (Wire × Wire),
    GateMirror.forward (swapsG ps) = LeaveRelocation.program ps
  | [] => rfl
  | (a, b) :: ps => by
    show GateMirror.forward ([.cx a b, .cx b a, .cx a b] ++ swapsG ps) =
      [.CX a b, .CX b a, .CX a b] ++ LeaveRelocation.program ps
    rw [forward_app, forward_swapsG20 ps]; rfl

private theorem storeWire20_zero (s : Nat) : storeWire20 s 0 = 1558 := by
  unfold storeWire20 e0P20; dsimp only
  split_ifs <;> ((try unfold Wire at *); omega)

private theorem pending20_fst (j : Fin 9) :
    (pendingPairs20 j).map Prod.fst =
      (a0P20 (start20 j) + lowsP20 (start20 j) - 1) ::
        (List.range (liveW20 (start20 j) - lowsP20 (start20 j))).map (fun i => bankW20 (start20 j) (lowsP20 (start20 j) + i)) := by
  simp only [pendingPairs20, List.map_map, Function.comp]
  rw [List.range_succ_eq_map, List.map_cons, List.map_map]
  simp only [Function.comp, if_pos, Nat.succ_ne_zero, if_false]
  congr 1

private theorem clearFlag20_fst (j : Fin 9) :
    (clearFlagPairs20 j).map Prod.fst = (List.range (lowsP20 (start20 j) + 1)).map (b0P20 (start20 j) - 1 + ·) := by
  simp only [clearFlagPairs20, List.map_map]; rfl

theorem lowStore20_parts (j : Fin 9) :
    GateMirror.forward (leaveLowStore20 (start20 j)) =
      GateMirror.forward (lowSign20 (start20 j)) ++
      (Companion.restore (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558 ++ releaseMaskP20 j) := by
  have hc : GateMirror.forward ((List.range (lowsP20 (start20 j))).map
      fun i => Gate.make 1556 (a0P20 (start20 j) + i) (b0P20 (start20 j) + i)) =
      copyRegister (some 1556) (smallA20 j) (smallM20 j) := by
    rw [smallA20, smallM20, LeaveJ7.copy_map]; simp only [GateMirror.forward, List.map_map]; rfl
  simp only [leaveLowStore20, forward_app, forward_addG, LeaveJ7.forward_xsG', hc,
    Companion.restore, HighBankUnit.sub, mappedSub, smallM20, smallC20, List.append_assoc]
  rfl

theorem storeMapped20_parts (j : Fin 9) :
    GateMirror.forward (leaveStoreMapped20 (start20 j)) =
      latch true none 1557 1558 (pendingPairs20 j) ++
        ([.CCX 1556 1557 1558] ++ latch true none 1556 1558 (clearFlagPairs20 j)) := by
  have ch1 : GateMirror.forward (chainG (storeWire20 (start20 j))
      (fun i => if i = 0 then a0P20 (start20 j) + lowsP20 (start20 j) - 1 else bankW20 (start20 j) (lowsP20 (start20 j) + i - 1))
      [.cx (storeWire20 (start20 j) (liveW20 (start20 j) - lowsP20 (start20 j) + 1)) 1557, .x 1557]
      0 (liveW20 (start20 j) - lowsP20 (start20 j) + 1)) =
      PortalAnd.chain true none 1557 1558 (pendingPairs20 j) := by
    have h := forward_chainG20 (storeWire20 (start20 j))
      (fun i => if i = 0 then a0P20 (start20 j) + lowsP20 (start20 j) - 1 else bankW20 (start20 j) (lowsP20 (start20 j) + i - 1))
      1557 0 (liveW20 (start20 j) - lowsP20 (start20 j) + 1)
    simp only [Nat.zero_add, storeWire20_zero] at h
    exact h
  have ch2 : GateMirror.forward (chainG (fun i => (1558 + i : Wire)) (fun i => b0P20 (start20 j) - 1 + i)
      [.cx (1558 + (lowsP20 (start20 j) + 1)) 1556, .x 1556] 0 (lowsP20 (start20 j) + 1)) =
      PortalAnd.chain true none 1556 1558 (clearFlagPairs20 j) := by
    have h := forward_chainG20 (fun i => (1558 + i : Wire)) (fun i => b0P20 (start20 j) - 1 + i)
      1556 0 (lowsP20 (start20 j) + 1)
    simp only [Nat.zero_add] at h
    have e : (List.range (lowsP20 (start20 j) + 1)).map (fun k => (b0P20 (start20 j) - 1 + k, (1558 + (k + 1) : Wire))) =
        clearFlagPairs20 j := by
      simp only [clearFlagPairs20]; apply List.map_congr_left; intro k _
      simp only [Prod.mk.injEq, true_and]; unfold Wire; omega
    rw [← e]; exact h
  have fc (g : Gate) (gs : List Gate) : GateMirror.forward (g :: gs) = front g :: GateMirror.forward gs := rfl
  have fn : GateMirror.forward [] = [] := rfl
  simp only [leaveStoreMapped20, forward_app, LeaveJ7.forward_xsG', ch1, ch2, PortalAnd.latch, PortalAnd.digits,
    pending20_fst, clearFlag20_fst, fc, fn, front, GateMirror.erase, notRegister, List.map_cons, List.map_nil,
    List.map_append, List.reverse_cons, List.append_assoc, List.cons_append, List.singleton_append, List.nil_append,
    if_true, ↓reduceIte]

theorem lowClose20_parts (j : Fin 9) :
    GateMirror.forward (leaveLowClose20 (start20 j)) =
      notRegister (history20 j) ++ RailPair.store (start20 j + 35) (e0P20 (start20 j) + 5) (low20 j) [] := by
  have e1 : GateMirror.forward ((List.range (lowsP20 (start20 j) + 1)).map
      fun i => Gate.cx (e0P20 (start20 j) + 5) (b0P20 (start20 j) - 1 + i)) =
      signComplement (e0P20 (start20 j) + 5) ((low20 j).map Prod.snd) := by
    simp only [GateMirror.forward, signComplement, low20, List.map_map]; rfl
  have e2 : GateMirror.forward ((List.range (lowsP20 (start20 j) + 1)).flatMap
      fun i => cswapG (start20 j + 35) (b0P20 (start20 j) - 1 + i) (a0P20 (start20 j) - 1 + i)) =
      exchange (start20 j + 35) (low20 j) := by
    simp only [GateMirror.forward, exchange, low20, List.map_flatMap, List.flatMap_map]; rfl
  simp only [leaveLowClose20, forward_app, LeaveJ7.forward_xsG', e1, e2, RailPair.store, RailPair.transfer,
    List.flatMap_nil, List.nil_append, List.append_assoc]
  rfl

theorem close20_parts (j : Fin 9) :
    GateMirror.forward (leaveClose20 (start20 j)) =
      GateMirror.forward (closeFlag20 (start20 j)) ++
        LeaveRelocation.program (movesP20 (start20 j)) := by
  unfold leaveClose20
  rw [forward_app, forward_swapsG20]

theorem leaveP20_split (j : Fin 9) :
    leaveP20 j = storeMapped20 j ++ GateMirror.forward (leaveClose20 (start20 j)) := by
  have h1 := lowStore20_parts j
  unfold leaveP20 leaveBefore20 leaveAfter20 storeMapped20 beforeStore20 fullProg20 core20Prog work20Prog
    entryLeave20 selPrefix20
  simp only [forward_app, List.append_assoc]
  rw [h1]
  simp only [List.append_assoc]

/-! ### Section 2: Layout & Geometry Facts -/

private theorem sites_perm20 : ∀ ps : List (Wire × Wire), (PortalAnd.sites ps).Perm (ps.map Prod.fst ++ ps.map Prod.snd)
  | [] => by simp [PortalAnd.sites]
  | p :: ps => by
    have ih := sites_perm20 ps
    change (p.1 :: p.2 :: PortalAnd.sites ps).Perm (p.1 :: (ps.map Prod.fst ++ p.2 :: ps.map Prod.snd))
    exact List.Perm.cons _ ((List.Perm.cons _ ih).trans List.perm_middle.symm)

theorem small20_geometry : ∀ j : Fin 9,
    Companion.Geometry (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558 := by
  intro j; constructor <;> revert j <;> decide +kernel

theorem pending20_layout (j : Fin 9) :
    (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs20 j)).Nodup := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hperm : (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs20 j)).Perm
      (1557 :: (1558 : Wire) :: ((pendingPairs20 j).map Prod.fst ++ (pendingPairs20 j).map Prod.snd)) :=
    List.Perm.cons _ (List.Perm.cons _ (sites_perm20 _))
  rw [hperm.nodup_iff]
  have hfst_nd : ((pendingPairs20 j).map Prod.fst).Nodup := by
    rw [pending20_fst, List.nodup_cons]
    refine ⟨?_, List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range⟩
    · intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := lowsP20 (start20 j) + i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
        (rw [eb] at e; unfold Wire at *; omega)
    · rw [List.mem_range] at ha hb
      have := bank20_inj j (by omega) (by omega) e; omega
  have hsnd_nd : ((pendingPairs20 j).map Prod.snd).Nodup := by
    simp only [pendingPairs20, List.map_map, Function.comp]
    refine List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range
    simp only [Function.comp_apply] at e
    dsimp only [storeWire20] at e
    split_ifs at e <;> ((try unfold Wire at *); omega)
  have hfst_range : ∀ q ∈ (pendingPairs20 j).map Prod.fst,
      (q : Nat) ≤ 1043 ∨ (1603 ≤ (q : Nat) ∧ (q : Nat) ≤ 1622) := by
    intro q hq; rw [pending20_fst, List.mem_cons] at hq
    rcases hq with rfl | hm
    · left; unfold Wire; omega
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := lowsP20 (start20 j) + i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
      · omega
      · left; unfold Wire at *; omega
      · right; rw [eb]; unfold Wire at *; omega
  have hsnd_range : ∀ q ∈ (pendingPairs20 j).map Prod.snd,
      (1559 ≤ (q : Nat) ∧ (q : Nat) ≤ 1602) ∨ 1623 ≤ (q : Nat) := by
    intro q hq
    simp only [pendingPairs20, List.map_map, Function.comp, List.mem_map, List.mem_range] at hq
    obtain ⟨k, hk, rfl⟩ := hq
    dsimp only [storeWire20]
    split_ifs <;> ((try unfold Wire at *); omega)
  have hdisj : ∀ a ∈ (pendingPairs20 j).map Prod.fst, ∀ b ∈ (pendingPairs20 j).map Prod.snd, a ≠ b := by
    intro a ha b hb eq; subst eq
    rcases hfst_range a ha with x | x <;> rcases hsnd_range a hb with y | y <;> unfold Wire at * <;> omega
  rw [List.nodup_cons, List.nodup_cons]
  refine ⟨?_, ?_, List.nodup_append.mpr ⟨hfst_nd, hsnd_nd, hdisj⟩⟩
  · intro hm; simp only [List.mem_cons, List.mem_append] at hm
    rcases hm with h | h | h
    · exact (by decide : (1557 : Wire) ≠ 1558) h
    · rcases hfst_range 1557 h with a | a <;> unfold Wire at * <;> omega
    · rcases hsnd_range 1557 h with a | a <;> unfold Wire at * <;> omega
  · intro hm; simp only [List.mem_append] at hm
    rcases hm with h | h
    · rcases hfst_range 1558 h with a | a <;> unfold Wire at * <;> omega
    · rcases hsnd_range 1558 h with a | a <;> unfold Wire at * <;> omega

theorem clearFlag20_layout : ∀ j : Fin 9,
    (1556 :: (1558 : Wire) :: PortalAnd.sites (clearFlagPairs20 j)).Nodup := by
  decide +kernel

theorem low20_geometry : ∀ j : Fin 9,
    StoreGeometry (start20 j + 35) (e0P20 (start20 j) + 5) (low20 j) [] := by
  intro j; constructor <;> revert j <;> decide +kernel

theorem events20_layout : ∀ j : Fin 9,
    ((e0P20 (start20 j) + 4 : Wire) :: (e0P20 (start20 j) + 7 : Wire) :: PortalAnd.sites (events20 j)).Nodup := by
  decide +kernel

theorem moves20_diff : ∀ j : Fin 9, ∀ p ∈ movesP20 (start20 j), p.1 ≠ p.2 := by
  decide +kernel

theorem tail20_geom : ∀ j : Fin 9,
    let s := start20 j
    sbP20 s + lowsP20 s = nextSb20 s + nextLen20 j + 2 ∧
    (sbP20 s = nextSb20 s + 10 ∨ sbP20 s = nextSb20 s + 7) ∧
    lowsP20 s + (nextWp20 s - 2) = railP (s + 20) - (sbP20 s + 1) ∧
    b0P20 s + lowsP20 s = bTopP (s + 20) + 3 - nextWp20 s ∧
    railP (s + 20) - (sbP20 s + lowsP20 s + 1) = nextWp20 s - 2 ∧
    lowsP20 s + (nextWp20 s - 2) ≤ wpP20 s + 20 ∧
    1650 ≤ nextE0_20 s ∧ nextE0_20 s ≤ 1732 ∧
    nextSb20 s + nextLen20 j + 1 < sbP20 s + lowsP20 s := by
  decide +kernel

private theorem source_append20 (xs ys : List (Wire × Wire)) (q : Wire) :
    LeaveRelocation.source (xs ++ ys) q = LeaveRelocation.source xs (LeaveRelocation.source ys q) :=
  List.foldr_append ..

private theorem reloc20_bank_bounds (j : Fin 9) (k : Nat) (hk : k < nextWp20 (start20 j) - 2) :
    b0P20 (start20 j) + lowsP20 (start20 j) + k < (bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ∧
    ((bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ≤ 1043 ∨
      (1603 ≤ (bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ∧
       (bankW20 (start20 j) (lowsP20 (start20 j) + k) : Nat) ≤ 1622)) ∧
    bTopP (start20 j + 20) + 3 + k - nextWp20 (start20 j) = b0P20 (start20 j) + lowsP20 (start20 j) + k := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbp : bTopP (start20 j) + 1 - wpP20 (start20 j) = b0P20 (start20 j) + 20 := by
    have : ∀ m : Fin 9, bTopP (start20 m) + 1 - wpP20 (start20 m) = b0P20 (start20 m) + 20 := by decide +kernel
    exact this j
  have hsub : bTopP (start20 j + 20) + 3 + k - nextWp20 (start20 j) =
      b0P20 (start20 j) + lowsP20 (start20 j) + k := by
    have hge : nextWp20 (start20 j) ≤ bTopP (start20 j + 20) + 3 := by
      have : ∀ m : Fin 9, nextWp20 (start20 m) ≤ bTopP (start20 m + 20) + 3 := by decide +kernel
      exact this j
    omega
  rcases bank20_cases j (i := lowsP20 (start20 j) + k) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
  · omega
  · refine ⟨by rw [eb]; unfold Wire at *; omega, Or.inl (by unfold Wire at *; omega), hsub⟩
  · refine ⟨by rw [eb]; unfold Wire at *; omega, Or.inr ⟨by rw [eb]; unfold Wire at *; omega, by rw [eb]; unfold Wire at *; omega⟩, hsub⟩

private theorem movesP20_away (j : Fin 9) (q : Nat) (hq : q < b0P20 (start20 j) + lowsP20 (start20 j)) :
    ∀ p ∈ movesP20 (start20 j), (q : Wire) ≠ p.1 ∧ (q : Wire) ≠ p.2 := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  intro p hp
  simp only [movesP20, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with ⟨k, hk, rfl⟩ | hfl
  · have hb := reloc20_bank_bounds j k hk
    exact ⟨by dsimp only; unfold Wire at *; omega, by dsimp only; rw [hb.2.2]; unfold Wire at *; omega⟩
  · rcases hfl with rfl | rfl | rfl | rfl | rfl | rfl <;>
      (dsimp only; exact ⟨by omega, by omega⟩)

private theorem reloc20_flagTail_eval (j : Fin 9) :
    let s := start20 j
    let fl := [(1557, nextE0_20 s + 3), (1558, nextE0_20 s + 4),
        (e0P20 s + 5, nextE0_20 s + 5), (e0P20 s + 3, nextE0_20 s + 6),
        (e0P20 s + 7, nextE0_20 s + 7), (e0P20 s + 6, nextE0_20 s + 8)]
    LeaveRelocation.source fl (nextE0_20 s + 3) = 1557 ∧
    LeaveRelocation.source fl (nextE0_20 s + 4) = 1558 ∧
    LeaveRelocation.source fl (nextE0_20 s + 5) = e0P20 s + 5 ∧
    LeaveRelocation.source fl (nextE0_20 s + 6) = e0P20 s + 3 ∧
    LeaveRelocation.source fl (nextE0_20 s + 7) = e0P20 s + 7 ∧
    LeaveRelocation.source fl (nextE0_20 s + 8) = e0P20 s + 6 := by
  revert j; decide +kernel

theorem reloc20_flags (j : Fin 9) :
    let s := start20 j
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 3) = 1557 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 4) = 1558 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 5) = e0P20 s + 5 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 6) = e0P20 s + 3 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 7) = e0P20 s + 7 ∧
    LeaveRelocation.source (movesP20 s) (nextE0_20 s + 8) = e0P20 s + 6 := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hbank_out : ∀ q : Nat, (1557 ≤ q ∧ q ≤ 1558) ∨ 1650 ≤ q →
      ∀ p ∈ (List.range (nextWp20 (start20 j) - 2)).map (fun i => (bankW20 (start20 j) (lowsP20 (start20 j) + i),
        bTopP (start20 j + 20) + 3 + i - nextWp20 (start20 j))), (q : Wire) ≠ p.1 ∧ (q : Wire) ≠ p.2 := by
    intro q hq p hp; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk
    have hb := reloc20_bank_bounds j k hk
    have hbt2 : bTopP (start20 j + 20) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
    exact ⟨by dsimp only; unfold Wire at *; omega, by dsimp only; rw [hb.2.2]; unfold Wire at *; omega⟩
  have hfl := reloc20_flagTail_eval j; dsimp only at hfl
  have htail (q : Wire) : LeaveRelocation.source (movesP20 (start20 j)) q =
      LeaveRelocation.source ((List.range (nextWp20 (start20 j) - 2)).map fun i =>
        (bankW20 (start20 j) (lowsP20 (start20 j) + i), bTopP (start20 j + 20) + 3 + i - nextWp20 (start20 j)))
      (LeaveRelocation.source [(1557, nextE0_20 (start20 j) + 3), (1558, nextE0_20 (start20 j) + 4),
        (e0P20 (start20 j) + 5, nextE0_20 (start20 j) + 5), (e0P20 (start20 j) + 3, nextE0_20 (start20 j) + 6),
        (e0P20 (start20 j) + 7, nextE0_20 (start20 j) + 7), (e0P20 (start20 j) + 6, nextE0_20 (start20 j) + 8)] q) :=
    source_append20 _ _ q
  dsimp only
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [htail, hfl.1]; exact LeaveRelocation.outside _ 1557 (hbank_out 1557 (Or.inl (by omega)))
  · rw [htail, hfl.2.1]; exact LeaveRelocation.outside _ 1558 (hbank_out 1558 (Or.inl (by omega)))
  · rw [htail, hfl.2.2.1]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 5) (hbank_out (e0P20 (start20 j) + 5) (Or.inr (by omega)))
  · rw [htail, hfl.2.2.2.1]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 3) (hbank_out (e0P20 (start20 j) + 3) (Or.inr (by omega)))
  · rw [htail, hfl.2.2.2.2.1]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 7) (hbank_out (e0P20 (start20 j) + 7) (Or.inr (by omega)))
  · rw [htail, hfl.2.2.2.2.2]; exact LeaveRelocation.outside _ (e0P20 (start20 j) + 6) (hbank_out (e0P20 (start20 j) + 6) (Or.inr (by omega)))

theorem reloc20_upper (j : Fin 9) (i : Fin (nextWp20 (start20 j) - 2)) :
    LeaveRelocation.source (movesP20 (start20 j)) (b0P20 (start20 j) + lowsP20 (start20 j) + i.val) =
      bankW20 (start20 j) (lowsP20 (start20 j) + i.val) ∧
    LeaveRelocation.source (movesP20 (start20 j)) (a0P20 (start20 j) + lowsP20 (start20 j) + i.val) =
      a0P20 (start20 j) + lowsP20 (start20 j) + i.val := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbi := reloc20_bank_bounds j i.val i.isLt
  constructor
  · let f := fun k => (bankW20 (start20 j) (lowsP20 (start20 j) + k), bTopP (start20 j + 20) + 3 + k - nextWp20 (start20 j))
    have hfl_out : LeaveRelocation.source
        [(1557, nextE0_20 (start20 j) + 3), (1558, nextE0_20 (start20 j) + 4),
         (e0P20 (start20 j) + 5, nextE0_20 (start20 j) + 5), (e0P20 (start20 j) + 3, nextE0_20 (start20 j) + 6),
         (e0P20 (start20 j) + 7, nextE0_20 (start20 j) + 7), (e0P20 (start20 j) + 6, nextE0_20 (start20 j) + 8)]
        (b0P20 (start20 j) + lowsP20 (start20 j) + i.val) = b0P20 (start20 j) + lowsP20 (start20 j) + i.val := by
      apply LeaveRelocation.outside; intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      have hhi : b0P20 (start20 j) + lowsP20 (start20 j) + i.val ≤ 1043 := by
        have := i.isLt; unfold bTopP railP at *; split_ifs at * <;> omega
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩
    rw [movesP20, source_append20, hfl_out]
    have hsplit : List.range (nextWp20 (start20 j) - 2) =
        List.range i.val ++ i.val :: List.range' (i.val + 1) (nextWp20 (start20 j) - 2 - (i.val + 1)) := by
      have hi := i.isLt
      rw [List.range_eq_range', List.range_eq_range']
      conv_lhs => rw [show nextWp20 (start20 j) - 2 = i.val + ((nextWp20 (start20 j) - 2 - (i.val + 1)) + 1) by omega]
      rw [← List.range'_append_1, Nat.zero_add]; rfl
    rw [hsplit, List.map_append, List.map_cons, source_append20]
    have hdrop : LeaveRelocation.source
        ((List.range' (i.val + 1) (nextWp20 (start20 j) - 2 - (i.val + 1))).map f)
        (b0P20 (start20 j) + lowsP20 (start20 j) + i.val) = b0P20 (start20 j) + lowsP20 (start20 j) + i.val := by
      apply LeaveRelocation.outside; intro p hp
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range'_1] at hk
      have hbk := reloc20_bank_bounds j k (by omega)
      exact ⟨by dsimp only [f]; unfold Wire at *; omega, by dsimp only [f]; rw [hbk.2.2]; unfold Wire at *; omega⟩
    change LeaveRelocation.source ((List.range i.val).map f)
      (LeaveRelocation.flip (f i.val).1 (f i.val).2
        (LeaveRelocation.source ((List.range' (i.val + 1) _).map f) (b0P20 (start20 j) + lowsP20 (start20 j) + i.val))) = _
    rw [hdrop]; dsimp only [f, LeaveRelocation.flip]
    rw [hbi.2.2, if_neg (by unfold Wire at *; omega), if_pos rfl]
    apply LeaveRelocation.outside; intro p hp
    obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk
    have hbk := reloc20_bank_bounds j k (by have := i.isLt; omega)
    refine ⟨fun eq => ?_, by dsimp only [f]; rw [hbk.2.2]; unfold Wire at *; omega⟩
    have := bank20_inj j (by have := i.isLt; omega) (by have := i.isLt; omega) eq; omega
  · exact LeaveRelocation.outside _ _ (movesP20_away j _ (by
      have := i.isLt; have : start20 j + sbP20 (start20 j) + 37 + lowsP20 (start20 j) + (nextWp20 (start20 j) - 2) ≤ 787 + sbP20 (start20 j) + lowsP20 (start20 j) := by
        have : ∀ m : Fin 9, nextWp20 (start20 m) ≤ 120 := by decide +kernel
        have := this j; omega
      omega))

