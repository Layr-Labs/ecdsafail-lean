    have u96eq : u'.basis 1596 = (prior j (LeaveSelector.actualMode (Shadow7.sbP (start j)) z) 1596).read a.basis :=
      (preq _ (by unfold Wire at *; omega)).trans ((u_eq_u0 _ (by unfold Wire at *; omega)).trans (sym 1596))
