    (initial : ∀ q, 1556 ≤ q → q < Shadow7.e0P (start j) → s.basis q = false)
    (extra : ∀ q, Shadow7.e0P (start j) + 10 ≤ q → q < Shadow7.e0P (start j) + 10 + min (Shadow7.wpP (start j) - 1 - (Shadow7.e0P (start j) - 1598)) (2045 - start j - Shadow7.e0P (start j)) →
