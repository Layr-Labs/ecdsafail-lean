  have hxD : gateSlots ([Instr.X (Q6EndpointCell.ports base (base 2409)).lower] : Program) = 1 := rfl
  simp only [shortConstAddLoan, StairLoan.unnormalizeLoan, StairLoan.normalizeLoan,
