/-! ### Section 1: Wide/Short Words, `highZero20`, and `boundaryRails20` -/

def L20 (j : Fin 9) : SkywalkIntegerLayout :=
  W.compactSkywalkTickLayout base (start20 j + 20)

def shortL20 (j : Fin 9) : SkywalkIntegerLayout :=
  IntegerPacket.ports (shape20 j) 20

theorem width20 (j : Fin 9) : W.compactSkywalkTickPreWidth (start20 j + 20) = railP (start20 j + 20) := by
  have hg := geom20_facts j; dsimp only at hg
  unfold W.compactSkywalkTickPreWidth W.narrowSkywalkRouteWidth railP
  split_ifs <;> omega

theorem wideMapping20 (j : Fin 9) (i : Nat) (hi : i < railP (start20 j + 20)) :
    (L20 j).a.getD i 0 = OB5.sig (start20 j + 19) (start20 j + 36 + i) ∧
    (L20 j).b.getD i 0 = OB5.sig (start20 j + 19) (786 + i) := by
  have hg := geom20_facts j; dsimp only at hg
  have hw := width20 j
  have r : railP (start20 j + 20) ≤ 258 := by unfold railP; split_ifs <;> omega
  have hi' : i < W.compactSkywalkTickPreWidth (start20 j + 20) := by omega
  rw [L20, W.compactSkywalkTick_a base (start20 j + 20) (by omega),
    W.compactSkywalkTick_b base (start20 j + 20) (by omega),
    W.wireBlock_getD base (start20 j + 20) _ i hi', W.wireBlock_getD base 770 _ i hi']
  unfold OB5.sig base
  constructor
  · rw [if_neg (by unfold Wire; omega)]; unfold Wire; omega
  · rw [if_neg (by unfold Wire; omega)]; unfold Wire; omega

theorem shortMapping20 (j : Fin 9) (i : Nat) (hi : i < sbP20 (start20 j)) :
    windowNet20 j ((shortL20 j).a.getD i 0) = start20 j + 36 + i ∧
    windowNet20 j ((shortL20 j).b.getD i 0) = 786 + i := by
  have hg := geom20_facts j; dsimp only at hg
  have hm : i < smallBits20 j + 21 + 1 := by unfold smallBits20; omega
  have ga : (shortL20 j).a.getD i 0 = start20 j + 36 + i := by
    show ((start20 j + 20 + 16) :: (List.range' (start20 j + 20 + 16 + 1) (smallBits20 j + 21) ++
      [start20 j + 20 + 16 + (smallBits20 j + 21 + 1)])).getD i 0 = _
    rcases i with _ | i
    · simp only [List.getD_cons_zero]
    · have hlen : i < (List.range' (start20 j + 20 + 16 + 1) (smallBits20 j + 21)).length := by
        rw [List.length_range']; unfold smallBits20; omega
      rw [List.getD_cons_succ, List.getD_append _ _ _ _ hlen, List.getD_eq_getElem?_getD,
        List.getElem?_range' (by unfold smallBits20; omega), Option.getD_some]
      omega
  have gb : (shortL20 j).b.getD i 0 = 786 + i := by
    show (786 :: (List.range' 787 (smallBits20 j + 21) ++ [786 + (smallBits20 j + 21 + 1)])).getD i 0 = _
    rcases i with _ | i
    · simp only [List.getD_cons_zero]
    · have hlen : i < (List.range' 787 (smallBits20 j + 21)).length := by
        rw [List.length_range']; unfold smallBits20; omega
      rw [List.getD_cons_succ, List.getD_append _ _ _ _ hlen, List.getD_eq_getElem?_getD,
        List.getElem?_range' (by unfold smallBits20; omega), Option.getD_some]
      omega
  rw [ga, gb]
  unfold windowNet20 OB5.sig
  constructor
  · rw [if_neg (by unfold Wire; omega)]
  · rw [if_neg (by unfold Wire; omega)]

theorem wide20 (j : Fin 9) (a : SkywalkNat.State) (G sg : Bool) (raw : State)
    (input : SkywalkIntegerInput (L20 j) (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis)
    (i : Fin (railP (start20 j + 20))) :
    let o := pullState (OB5.sig (start20 j + 19)) raw
    let e := PortalValues.negative sg a.u
    let pos := (a.u + a.v).testBit i.val
    let neg := (a.u - e.toNat).testBit i.val ^^ e
    o.basis (start20 j + 36 + i.val) = (if G then neg else pos) ∧ o.basis (786 + i.val) = (if G then pos else neg) := by
  have hg := geom20_facts j; dsimp only at hg
  have hw := width20 j
  have maxA : railP (start20 j + 20) ≤ (L20 j).a.length := by
    rw [L20, W.compactSkywalkTick_a base (start20 j + 20) (by omega), wireBlock_length]; omega
  have maxB : railP (start20 j + 20) ≤ (L20 j).b.length := by
    rw [L20, W.compactSkywalkTick_b base (start20 j + 20) (by omega), wireBlock_length]; omega
  have h := LeaveSignedCoordinates.pair (L20 j) G sg a.u a.v i.val raw.basis input.1 input.2.1 input.2.2.1
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  rw [(wideMapping20 j i.val i.isLt).1, (wideMapping20 j i.val i.isLt).2] at h
  exact h

theorem short20 (j : Fin 9) (a : SkywalkNat.State) (G sg : Bool) (s : State)
    (ready : onRails20 j 20 (SkywalkRails.encode G sg a.u a.v) s.basis) (i : Fin (sbP20 (start20 j))) :
    let e := PortalValues.negative sg a.u
    let pos := (a.u + a.v).testBit i.val
    let neg := (a.u - e.toNat).testBit i.val ^^ e
    s.basis (start20 j + 36 + i.val) = (if G then neg else pos) ∧ s.basis (786 + i.val) = (if G then pos else neg) := by
  have hg := geom20_facts j; dsimp only at hg
  have maxA : sbP20 (start20 j) ≤ (shortL20 j).a.length := by
    show sbP20 (start20 j) ≤ ((start20 j + 20 + 16) :: (List.range' (start20 j + 20 + 16 + 1) (smallBits20 j + 21) ++
      [start20 j + 20 + 16 + (smallBits20 j + 21 + 1)])).length
    simp only [List.length_cons, List.length_append, List.length_range', List.length_singleton]
    unfold smallBits20; omega
  have maxB : sbP20 (start20 j) ≤ (shortL20 j).b.length := by
    show sbP20 (start20 j) ≤ (786 :: (List.range' 787 (smallBits20 j + 21) ++ [786 + (smallBits20 j + 21 + 1)])).length
    simp only [List.length_cons, List.length_append, List.length_range', List.length_singleton]
    unfold smallBits20; omega
  have prev : mappedBasis20 j s.basis (shortL20 j).previous = G := by cases G <;> exact ready.2.2.1
  have h := LeaveSignedCoordinates.pair (shortL20 j) G sg a.u a.v i.val (mappedBasis20 j s.basis) ready.1 ready.2.1 prev
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  unfold mappedBasis20 at h; dsimp only at h
  rw [(shortMapping20 j i.val i.isLt).1, (shortMapping20 j i.val i.isLt).2] at h
  exact h

attribute [local irreducible] run SkywalkNat.step barrel20 core20Prog fullProg20 beforeStore20 storeMapped20 leaveP20 in
theorem highZero20 (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0)
    (top : ∀ q : Nat, a0P20 (start20 j) + 22 ≤ q → q ≤ start20 j + 35 + railP (start20 j + 20) → s.basis q = false) :
    ∀ i : Fin (nextWp20 (start20 j) - 2),
      (run (leaveP20 j) m s).basis (a0P20 (start20 j) + lowsP20 (start20 j) + i.val) = false := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  let u := flags20 z g0 s0
  let xs := SkywalkTrace.trace 20 (SkywalkRails.encode g0 s0 z.u z.v)
  have par := recordedParity20 j s z g0 s0 h.small h.odd h.record
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have w := whole20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
    xs (SkywalkTrace.trace_length _ _) (certifiedChain20 _ _ _ _ h.small h.odd)
    (firstSwap20 _ _ _ _ h.small h.odd) ev.1
  have hcrt : ∀ k < 10, s.basis (poolW20 (start20 j) (22 + k)) = false := fun k hk => by
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp]; exact h.cPool _ (by omega) (by omega)
  have hc := core20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.ready
    h.fresh h.scratch h.temp h.clean (h.cPool 1623 (by decide) (by omega)) (h.cPool 1624 (by decide) (by omega)) hcrt
    h.padding h.bank h.zero par h.far h.side ev.2
  have hbs := beforeStore20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
  have hprev : s.basis (start20 j + 35) = u.1 := by
    have hr := h.ready.2.2.1
