  exact ⟨fun bad => hb.1 (KnownBHeadResearch.support bad), clearOff, fun bad => out (keepB_cached_wires bad),
    B95Research.top_off h hA, B95Research.middle_fresh h hA, B95Research.preInv_off h hA,
