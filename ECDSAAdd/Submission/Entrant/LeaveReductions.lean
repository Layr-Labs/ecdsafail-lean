theorem unshiftHalfOdd_slots_le (L : Layout) (hw : L.Widths) :
    gateSlots (unshiftHalfOdd L) ≤ 5075 := by
  have len := (BalancedCleanup.widths L.toLayout hw).2.1
  have hr := (rotate_gateSlots_le L.r).2
  rw [len] at hr
  have ha := addHalfOdd_slots_le L
