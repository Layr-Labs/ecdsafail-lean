    rcases hbc with ⟨_, _⟩ | ⟨_, _, _, _, _⟩ | ⟨_, eb, hhi, _⟩
    · omega
    · omega
    · rw [eb]; exact cl _ (by unfold Wire at *; omega) (by unfold Wire at *; omega)
  · intro q hq
    simp only [watched20, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_range'_1] at hq
    rcases hq with (rfl | rfl) | ⟨h1, h2⟩
    · exact flag6
