              by dsimp only; rw [ea]; (try unfold Wire at *); omega, hbi⟩

private theorem kept10_run (j : Fin 9) (s : State) (m : List Bool) (X : Nat) (k : Mode20)
    (h1623 : s.basis 1623 = if Selector20.enabled20 k then ((X / 2 ^ Selector20.key20 k) / 2 % 2 == 1) else false)
    (htags : ∀ i : Nat, i < 10 → s.basis (tagsP20.getD i 0) = (Selector20.enabled20 k && decide (i = Selector20.key20 k)))
    (hX : ∀ i : Nat, i < 22 → s.basis (a0P20 (start20 j) + i) =
      if Selector20.enabled20 k && decide (i = Selector20.key20 k) then false else X.testBit i)
    (hbound : Selector20.enabled20 k = true → X / 2 ^ Selector20.key20 k ≤ 2)
    (hdead : Selector20.enabled20 k = true → 10 ≤ Selector20.key20 k → (X / 2 ^ Selector20.key20 k) / 2 % 2 = 0) :
    let out := run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) + i) 1623 0 10)) m s
    out.phase = s.phase ∧
    (∀ i : Nat, i < 22 → out.basis (a0P20 (start20 j) + i) =
      if Selector20.enabled20 k then (X % 2 ^ Selector20.key20 k).testBit i else X.testBit i) ∧
    (∀ q : Wire, (∀ i : Nat, i < 10 → q ≠ a0P20 (start20 j) + (i + 1)) → out.basis q = s.basis q) := by
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, hwp1, hwp2, hlo1, hlo2, huw, hlw1, hlw2, htop⟩ := geom20_facts j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hstep : ∀ (p n : Nat) (st : State) (tp : List Bool), p + n ≤ 10 →
      (∀ i, p ≤ i → i < p + n → st.basis (tagsP20.getD i 0) = s.basis (tagsP20.getD i 0)) →
      st.basis 1623 = s.basis 1623 →
      (run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) + i) 1623 p n)) tp st).phase = st.phase ∧
      (∀ i, p ≤ i → i < p + n →
        (run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) + i) 1623 p n)) tp st).basis
          (a0P20 (start20 j) + (i + 1)) =
        (st.basis (a0P20 (start20 j) + (i + 1)) ^^ (s.basis (tagsP20.getD i 0) && s.basis 1623))) ∧
      (∀ q, (∀ i, p ≤ i → i < p + n → q ≠ a0P20 (start20 j) + (i + 1)) →
        (run (GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) + i) 1623 p n)) tp st).basis q = st.basis q) := by
    intro p n; induction n generalizing p with
    | zero => intro st tp _ _ _; exact ⟨rfl, fun _ h1 h2 => by omega, fun _ _ => rfl⟩
    | succ n ih =>
      intro st tp hpn htg h23
      have hsplit : GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) + i) 1623 p (n + 1)) =
          [Instr.CCX (tagsP20.getD p 0) 1623 (a0P20 (start20 j) + (p + 1))] ++
            GateMirror.forward (keptG (tagsP20.getD · 0) (fun i => a0P20 (start20 j) + i) 1623 (p + 1) n) := rfl
      rw [hsplit, run_append, run_take]
      have hdrop : tp.drop (measurementCount [Instr.CCX (tagsP20.getD p 0) 1623 (a0P20 (start20 j) + (p + 1))]) = tp := rfl
      rw [hdrop]
      let st1 := run [Instr.CCX (tagsP20.getD p 0) 1623 (a0P20 (start20 j) + (p + 1))] tp st
      have hst1 : st1 = ⟨st.phase, writeBit st.basis (a0P20 (start20 j) + (p + 1))
          (st.basis (a0P20 (start20 j) + (p + 1)) ^^ (st.basis (tagsP20.getD p 0) && st.basis 1623))⟩ := rfl
      have hneT : ∀ i < 10, tagsP20.getD i 0 ≠ a0P20 (start20 j) + (p + 1) := fun i hi => by
        have tr := tagsP20_getD_range (k := i) (by omega); (try unfold Wire at *); omega
      have hrec := ih (p + 1) st1 tp (by omega)
        (fun i h1 h2 => by rw [hst1]; simp only [writeBit, Function.update_of_ne (hneT i (by omega)), htg i (by omega) (by omega)])
        (by rw [hst1]; simp only [writeBit, Function.update_of_ne (show (1623 : Wire) ≠ a0P20 (start20 j) + (p + 1) by (try unfold Wire at *); omega), h23])
      refine ⟨hrec.1.trans (by rw [hst1]), fun i h1 h2 => ?_, fun q hq => ?_⟩
      · by_cases eq : i = p
        · subst eq
          rw [hrec.2.2 _ (fun i' h1' h2' => by omega), hst1]
          simp only [writeBit, Function.update_self, htg i (by omega) (by omega), h23]
        · rw [hrec.2.1 i (by omega) (by omega), hst1]
          simp only [writeBit, Function.update_of_ne (show a0P20 (start20 j) + (i + 1) ≠ a0P20 (start20 j) + (p + 1) by omega)]
      · rw [hrec.2.2 q (fun i h1 h2 => hq i (by omega) (by omega)), hst1]
        simp only [writeBit, Function.update_of_ne (hq p (by omega) (by omega))]
  have hrun := hstep 0 10 s m (by decide) (fun _ _ _ => rfl) rfl
  refine ⟨hrun.1, ?_, fun q hq => hrun.2.2 q (fun i _ hi => hq i hi)⟩
  intro i hi
  cases hen : Selector20.enabled20 k
  · have hno : ∀ r < 10, s.basis (tagsP20.getD r 0) = false := fun r hr => by rw [htags r hr, hen]; rfl
    by_cases h1 : 1 ≤ i ∧ i ≤ 10
    · rw [show a0P20 (start20 j) + i = a0P20 (start20 j) + ((i - 1) + 1) by (try unfold Wire at *); omega,
        hrun.2.1 (i - 1) (by omega) (by omega), hno (i - 1) (by omega)]
      simp only [Bool.false_and, Bool.xor_false, show a0P20 (start20 j) + (i - 1 + 1) = a0P20 (start20 j) + i by (try unfold Wire at *); omega,
        hX i hi, hen, Bool.false_and, Bool.false_eq_true, if_false]
    · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega), hX i hi, hen]; rfl
  · simp only [if_true]
    have hb := hbound hen
    by_cases hlt : i < Selector20.key20 k
    · rw [Nat.testBit_mod_two_pow, decide_eq_true hlt, Bool.true_and]
      by_cases h1 : 1 ≤ i ∧ i ≤ 10
      · rw [show a0P20 (start20 j) + i = a0P20 (start20 j) + ((i - 1) + 1) by (try unfold Wire at *); omega,
          hrun.2.1 (i - 1) (by omega) (by omega)]
        have hf : s.basis (tagsP20.getD (i - 1) 0) = false := by
          rw [htags (i - 1) (by omega), hen, Bool.true_and, decide_eq_false (by omega)]
        rw [hf, Bool.false_and, Bool.xor_false,
          show a0P20 (start20 j) + (i - 1 + 1) = a0P20 (start20 j) + i by (try unfold Wire at *); omega, hX i hi, hen, Bool.true_and,
          decide_eq_false (by omega)]; rfl
      · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega), hX i hi, hen, Bool.true_and,
          decide_eq_false (by omega)]; rfl
    · rw [Nat.testBit_mod_two_pow, decide_eq_false hlt, Bool.false_and]
      by_cases heq : i = Selector20.key20 k
      · subst heq
        by_cases h1 : 1 ≤ Selector20.key20 k ∧ Selector20.key20 k ≤ 10
        · rw [show a0P20 (start20 j) + Selector20.key20 k = a0P20 (start20 j) + ((Selector20.key20 k - 1) + 1) by (try unfold Wire at *); omega,
            hrun.2.1 (Selector20.key20 k - 1) (by omega) (by omega)]
          have hf : s.basis (tagsP20.getD (Selector20.key20 k - 1) 0) = false := by
            rw [htags _ (by omega), hen, Bool.true_and, decide_eq_false (by omega)]
          rw [hf, Bool.false_and, Bool.xor_false,
            show a0P20 (start20 j) + (Selector20.key20 k - 1 + 1) = a0P20 (start20 j) + Selector20.key20 k by (try unfold Wire at *); omega]
          simp only [hX _ hi, hen, Bool.true_and, decide_true, if_true]
        · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega)]
          simp only [hX _ hi, hen, Bool.true_and, decide_true, if_true]
      · by_cases heq1 : i = Selector20.key20 k + 1
        · subst heq1
          by_cases hk10 : Selector20.key20 k < 10
          · rw [hrun.2.1 (Selector20.key20 k) (by omega) hk10, htags _ hk10, hen, Bool.true_and, decide_eq_true rfl,
              Bool.true_and, h1623, if_pos hen]
            simp only [hX _ hi, hen, Bool.true_and, decide_eq_false (show Selector20.key20 k + 1 ≠ Selector20.key20 k by omega),
              Bool.false_eq_true, if_false]
            have hbit : X.testBit (Selector20.key20 k + 1) = ((X / 2 ^ Selector20.key20 k) / 2 % 2 == 1) := by
              rw [Nat.testBit_eq_decide_div_mod_eq, Nat.pow_succ, ← Nat.div_div_eq_div_mul]; rfl
            rw [hbit]; exact Bool.xor_self _
          · rw [hrun.2.2 _ (fun r _ hr => by omega)]
            simp only [hX _ hi, hen, Bool.true_and, decide_eq_false (show Selector20.key20 k + 1 ≠ Selector20.key20 k by omega),
              Bool.false_eq_true, if_false]
            have hbit : X.testBit (Selector20.key20 k + 1) = ((X / 2 ^ Selector20.key20 k) / 2 % 2 == 1) := by
              rw [Nat.testBit_eq_decide_div_mod_eq, Nat.pow_succ, ← Nat.div_div_eq_div_mul]; rfl
            rw [hbit, hdead hen (by omega)]; rfl
        · have hhi : X.testBit i = false := by
            rw [Nat.testBit_eq_decide_div_mod_eq]
            have hlt4 : X < 2 ^ i := by
              have : X < 4 * 2 ^ Selector20.key20 k := by
                have h1 := Nat.mul_le_mul_left (2 ^ Selector20.key20 k) hb
                have h2 := Nat.div_add_mod X (2 ^ Selector20.key20 k)
                have h3 := Nat.mod_lt X (Nat.two_pow_pos (Selector20.key20 k))
                omega
              calc X < 2 ^ 2 * 2 ^ Selector20.key20 k := this
                _ = 2 ^ (2 + Selector20.key20 k) := (Nat.pow_add 2 2 _).symm
                _ ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (by omega)
            rw [Nat.div_eq_of_lt hlt4]; rfl
          by_cases h1 : 1 ≤ i ∧ i ≤ 10
          · rw [show a0P20 (start20 j) + i = a0P20 (start20 j) + ((i - 1) + 1) by (try unfold Wire at *); omega,
              hrun.2.1 (i - 1) (by omega) (by omega)]
            have hf : s.basis (tagsP20.getD (i - 1) 0) = false := by
              rw [htags _ (by omega), hen, Bool.true_and, decide_eq_false (by omega)]
            rw [hf, Bool.false_and, Bool.xor_false,
              show a0P20 (start20 j) + (i - 1 + 1) = a0P20 (start20 j) + i by (try unfold Wire at *); omega]
            simp only [hX i hi, hen, Bool.true_and, decide_eq_false heq, Bool.false_eq_true, if_false, hhi]
          · rw [hrun.2.2 _ (fun r _ hr => by (try unfold Wire at *); omega)]
            simp only [hX i hi, hen, Bool.true_and, decide_eq_false heq, Bool.false_eq_true, if_false, hhi]

/-- Program from `leaveAdjust20` through `lowSign20` (with direct `CRTBarrel20`). -/
def work20Prog (j : Fin 9) : Program :=
  GateMirror.forward (leaveAdjust20 (start20 j)) ++ barrel20 (start20 j) false ++
  GateMirror.forward (fix8P20 (start20 j) ++ leaveJoinMove20 (start20 j) ++ fix10P20 (start20 j) ++
    leaveFix11_20 (start20 j) ++ leaveFix12_20 (start20 j) ++ lowSign20 (start20 j))

def core20Prog (j : Fin 9) : Program :=
  GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j)) ++ work20Prog j

def cleared20 (b : BasisState) : BasisState := fun q =>
  if 1559 ≤ q ∧ q ≤ 1602 then false else b q

private theorem live20_row (j : Fin 9) (i : Fin 22) :
    live20 j i.val = (columnsP20 (start20 j))[i.val].keep := by
  simp only [live20, columnsP20, List.getElem_map, List.getElem_range, Column.keep]
  by_cases h : i.val < lowsP20 (start20 j) <;> simp [h]

private theorem schedule20_ok (j : Fin 9) (ref : BasisState) (k : Mode20)
    (htags : ∀ i < 21, ref (tagsP20.getD i 0) = (Selector20.enabled20 k && decide (i = Selector20.key20 k))) :
    schedule ref (if Selector20.enabled20 k then Selector20.key20 k else 22) false 0 (columnsP20 (start20 j)) = true := by
  have haux : ∀ (t : Nat) (ht : t ≤ 22) (a : Bool),
      a = decide ((if Selector20.enabled20 k then Selector20.key20 k else 22) < t) →
      schedule ref (if Selector20.enabled20 k then Selector20.key20 k else 22) a t
        ((List.range' t (22 - t)).map fun i =>
          ⟨decide (i < lowsP20 (start20 j)), if i < 21 then some (tagsP20.getD i 0) else none,
           a0P20 (start20 j) + i, bankW20 (start20 j) i⟩) = true := by
    intro t ht; induction hlen : 22 - t generalizing t with
    | zero => intro a _; simp [schedule]
    | succ d ih =>
      intro a ha
      rw [show List.range' t (d + 1) = t :: List.range' (t + 1) d from rfl, List.map_cons, schedule]
      have ht22 : t < 22 := by omega
      have hnext : (a ^^ HighBankJoin.control ref (if t < 21 then some (tagsP20.getD t 0) else none)) =
          decide ((if Selector20.enabled20 k then Selector20.key20 k else 22) ≤ t) := by
        rw [ha]
        cases hen : Selector20.enabled20 k
        · simp only [Bool.false_eq_true, if_false, decide_eq_false (show ¬ 22 < t by omega),
            decide_eq_false (show ¬ 22 ≤ t by omega), Bool.false_xor]
          split_ifs with h21
          · simp only [HighBankJoin.control, Option.map_some, Option.getD_some, htags t h21, hen, Bool.false_and]
          · rfl
        · simp only [if_true]
          have hkle : Selector20.key20 k ≤ 20 := by have := k.isLt; unfold Selector20.key20; omega
          split_ifs with h21
          · simp only [HighBankJoin.control, Option.map_some, Option.getD_some, htags t h21, hen, Bool.true_and]
            by_cases hlt : Selector20.key20 k < t
            · rw [decide_eq_true hlt, decide_eq_false (show t ≠ Selector20.key20 k by omega),
                decide_eq_true (show Selector20.key20 k ≤ t by omega)]; rfl
            · by_cases heq : t = Selector20.key20 k
              · subst heq; rw [decide_eq_false (by omega), decide_eq_true rfl, decide_eq_true (le_refl _)]; rfl
              · rw [decide_eq_false hlt, decide_eq_false heq, decide_eq_false (show ¬ Selector20.key20 k ≤ t by omega)]; rfl
          · simp only [HighBankJoin.control, Option.map_none, Option.getD_none,
              decide_eq_true (show Selector20.key20 k < t by omega),
              decide_eq_true (show Selector20.key20 k ≤ t by omega), Bool.xor_false]
      rw [hnext, beq_self_eq_true, Bool.true_and]
      exact ih (t + 1) (by omega) (by omega) _ (Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; omega))
  simpa [columnsP20, List.range_eq_range'] using haux 0 (by decide) false (by cases Selector20.enabled20 k <;> simp)

private theorem clrAll_basis_at (ctrl : Wire) (q : Wire) :
    ∀ (rs : List MoveChain.Row) (st : State),
      (∀ r ∈ rs, r.1 ≠ ctrl ∧ r.2 ≠ ctrl ∧ ∀ r' ∈ rs, r.1 ≠ r'.2) →
      (rs.map Prod.snd).Nodup →
      (MoveChain.clrAll ctrl rs st).basis q =
        match rs.find? (fun r => decide (r.2 = q)) with
        | none => st.basis q
        | some r => st.basis q ^^ (st.basis r.1 && st.basis ctrl) := by
  intro rs; induction rs with
  | nil => intro st _ _; rfl
  | cons r rs ih =>
    intro st hsep hnd
    have hnd' := List.nodup_cons.mp hnd
    have hsep_t : ∀ x ∈ rs, x.1 ≠ ctrl ∧ x.2 ≠ ctrl ∧ ∀ x' ∈ rs, x.1 ≠ x'.2 :=
      fun x hx => ⟨(hsep x (List.mem_cons_of_mem _ hx)).1, (hsep x (List.mem_cons_of_mem _ hx)).2.1,
        fun x' hx' => (hsep x (List.mem_cons_of_mem _ hx)).2.2 x' (List.mem_cons_of_mem _ hx')⟩
    show (MoveChain.clrAll _ rs (MoveChain.clr _ r st)).basis _ = _
    rw [ih _ hsep_t hnd'.2]
    by_cases e : r.2 = q
    · have hnone : rs.find? (fun x => decide (x.2 = q)) = none := by
        rw [List.find?_eq_none]; intro x hx; simp only [decide_eq_true_eq]
        intro ex; exact hnd'.1 (List.mem_map.mpr ⟨x, hx, ex.trans e.symm⟩)
      rw [hnone]; simp only [List.find?_cons, e, decide_true, MoveChain.clr, MoveChain.wb_same]
    · simp only [List.find?_cons, decide_eq_false e]
      cases hf : rs.find? (fun x => decide (x.2 = q)) with
      | none => exact MoveChain.wb_other _ _ _ _ (Ne.symm e)
      | some r' =>
        have hr' := List.mem_of_find?_eq_some hf
        have hne1 : q ≠ r.2 := Ne.symm e
        have hne2 : r'.1 ≠ r.2 := (hsep r' (List.mem_cons_of_mem _ hr')).2.2 r List.mem_cons_self
        have hne3 : ctrl ≠ r.2 := Ne.symm (hsep r List.mem_cons_self).2.1
        simp only [MoveChain.clr, MoveChain.wb_other _ _ _ _ hne1, MoveChain.wb_other _ _ _ _ hne2,
          MoveChain.wb_other _ _ _ _ hne3]

