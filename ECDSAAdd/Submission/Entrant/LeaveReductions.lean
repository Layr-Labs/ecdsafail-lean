    rw [show 345 + 15 - 1 = 359 from rfl]
    simp only [Shadow7.shape, Shadow7.smallBits, j20_start, j20_sb, Wire] at mt ⊢; omega
  have port : q ∉ EnterJ7.ports j20 := fun mem => by
    apply ext; have r := EnterJ7.portsRegion j20 mem
    unfold WideReference20.Box20
    rw [show 345 + 15 - 1 = 359 from rfl]
    simp only [j20_start, j20_sb, Wire] at r ⊢; omega
  apply WideReference20.box_origin20 (by decide) (by decide) (by decide) ext raw history
  intro notSite
  have notAdmin : q ∉ support345 ++ ArchiveJ20.rawPortsList k8 := by
    intro mem
    have hall : (support345 ++ ArchiveJ20.rawHead k8).all (fun w =>
        decide (w ∈ WideReference20.sites 345 20 15 ∨ (1556 ≤ w ∧ w ≤ 1812 ∧ w + 345 ≤ 2069))) = true := by
      decide +kernel
    rw [ArchiveJ20.raw_split, List.mem_append, List.mem_append] at mem
    rcases mem with h | h | h
    · rcases of_decide_eq_true (List.all_eq_true.mp hall q (List.mem_append_left _ h)) with b | b
      · exact notSite b
      · exact ext (Or.inr (Or.inr (Or.inl b)))
    · rcases of_decide_eq_true (List.all_eq_true.mp hall q (List.mem_append_right _ h)) with b | b
      · exact notSite b
      · exact ext (Or.inr (Or.inr (Or.inl b)))
    · obtain ⟨i, hi, eq⟩ := List.mem_map.mp h; rw [List.mem_range] at hi
      have sb : 1556 ≤ (q : Nat) ∧ (q : Nat) ≤ 1699 := by
        rw [← eq]; unfold archScratch20; dsimp only; split_ifs <;> (unfold Wire; omega)
      apply ext; unfold WideReference20.Box20; simp only [Wire] at *; omega
  have stay := Shadow7.ext_head (Shadow7.enterP j20) j20 (withArchive345 d) (support345 ++ ArchiveJ20.rawPortsList k8)
    s m t q (by rwa [wn]) (EnterJ7.notWire j20 port) notAdmin (admin_cover345 d)
  have hn : q ≠ EnterJ7.flagN j20 := fun eq => ext (by rw [eq, j20_flags.1]; unfold WideReference20.Box20; omega)
  have hf : q ≠ EnterJ7.flagF j20 := fun eq => ext (by rw [eq, j20_flags.2.1]; unfold WideReference20.Box20; omega)
  have hu : q ≠ EnterJ7.flagU j20 := fun eq => ext (by rw [eq, j20_flags.2.2.1]; unfold WideReference20.Box20; omega)
  have hi : q ∉ RailPair.sites (EnterJ7.upperPairs j20) := fun m => by
    apply ext; have u := EnterJ7.upperSites j20 m
    unfold WideReference20.Box20
    rw [show 345 + 15 - 1 = 359 from rfl]
    simp only [j20_start, j20_sb, j20_wp, Wire] at u ⊢; omega
  have pend : q ∉ EnterJ7.pending j20 := fun m => by
    apply ext; rw [j20_flags.2.2.2] at m
    simp only [List.mem_cons, List.not_mem_nil, or_false] at m
    unfold WideReference20.Box20; simp only [Wire] at *; rcases m with rfl | rfl | rfl <;> omega
  have old := packed.unchanged q hn hf hu hi
  change (run (Shadow7.body j20 (withArchive345 d)) t (run (Shadow7.enterP j20) m s)).basis q = _
  rw [stay]
  simpa only [eraseSites, if_neg pend, EnterJ7.pull, pullId] using old

