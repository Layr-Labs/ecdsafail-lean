  rw [beforeC5_split, beforeC5_cut]
  refine allW_swapL _ _ _ _ (fun g' hg' q hq => ⟨.ccx (Partial.tagsP.getD 0 0) (Shadow7.e0P s + 6) (Shadow7.a0P s + 0),
    by simp, ?_⟩) h4
