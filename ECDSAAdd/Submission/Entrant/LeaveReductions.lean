  obtain ⟨vbJ, v10⟩ := v9.parts
  obtain ⟨vd1, v11⟩ := v10.parts
  obtain ⟨vb3, ve⟩ := v11.parts
  have emitted (m : List Bool) : run (GateMirror.forward a0 ++ f0 ++ GateMirror.forward a1 ++ f1 ++ GateMirror.forward c0 ++ fR ++
