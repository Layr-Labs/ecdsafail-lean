private theorem core20_retire_result (j : Fin 9) (z : SkywalkNat.State) (k : Mode20)
    (en u10 : State) (n8 : List Bool)
    (hmode : k = farMode20 (en.basis (e0P20 (start20 j) + 3)) (en.basis (e0P20 (start20 j) + 4)) z.u)
    (hhist : ∀ i < 20, u10.basis (start20 j + 16 + i) = en.basis (start20 j + 16 + i))
    (h1602 : u10.basis 1602 = (u10.basis (e0P20 (start20 j) + 6) && u10.basis 1601))
    (h59_601 : ∀ q : Wire, 1559 ≤ q → q ≤ 1601 → u10.basis q = sym20 j k en.basis q)
    (hswaps : right20 k = true → ∀ i < 20, i ≤ key20 k → u10.basis (swaps20 j i) = decide (i = key20 k))
    (h3 : u10.basis (e0P20 (start20 j) + 3) = en.basis (e0P20 (start20 j) + 3))
    (h4 : u10.basis (e0P20 (start20 j) + 4) = en.basis (e0P20 (start20 j) + 4)) :
    run (GateMirror.forward (leaveFix11_20 (start20 j) ++ leaveFix12_20 (start20 j) ++ lowSign20 (start20 j))) n8 u10 =
      ⟨u10.phase, cleared20 u10.basis⟩ := by
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, _, _, _, _, _, _, _, _⟩ := geom20_facts j
  have hretDom : ∀ o ∈ Selector20.retireOps20 Selector20.canonPorts, inDom20 o.dst ∧ ∀ a ∈ o.args, inDom20 a := by
    intro o ho
    have h := Bool.and_eq_true_iff.mp (List.all_eq_true.mp op_in_dom o (List.mem_append_right _ ho))
    exact ⟨of_decide_eq_true h.1, fun a ha => of_decide_eq_true (List.all_eq_true.mp h.2 a ha)⟩
  have hrefs_sel : ∀ (q : Nat), 1559 ≤ q → q ≤ 1601 →
      ∀ w ∈ LeaveSelector.refs (sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k) q),
        100 ≤ w ∧ w < 120 := by
    intro q h1 h2 w hw
    have hq := List.all_eq_true.mp (prepOps20_refs_ok k) q (by simp only [List.mem_range'_1]; omega)
    exact of_decide_eq_true (List.all_eq_true.mp hq w hw)
  have hrefs_sign : ∀ w ∈ LeaveSelector.refs (Selector20.signExpr20 Selector20.canonPorts k), 100 ≤ w ∧ w < 120 := by
    intro w hw; exact of_decide_eq_true (List.all_eq_true.mp (signExpr20_refs_ok k) w hw)
  have hread_agree : ∀ (e : Expr), (∀ w ∈ LeaveSelector.refs e, 100 ≤ w ∧ w < 120) →
      e.read (fun w => en.basis (σ20 j w)) = e.read (fun w => u10.basis (σ20 j w)) := by
    intro e he; apply LeaveSelector.readAgree
    intro w hw; obtain ⟨h1, h2⟩ := he w hw
    have hσ : σ20 j w = start20 j + 16 + (w - 100) := by unfold σ20; rw [if_pos ⟨h1, h2⟩]
    rw [hσ, hhist (w - 100) (by unfold Wire at *; omega)]
  have hret_match : ∀ q, inDom20 q →
      u10.basis (σ20 j q) = (Selector20.post20 Selector20.canonPorts k q).read (fun w => u10.basis (σ20 j w)) := by
    intro q hq
    unfold Selector20.post20
    have hcp300 : Selector20.canonPorts.crossing = 300 := rfl
    have hcp301 : Selector20.canonPorts.near = 301 := rfl
    rw [hcp300, hcp301]
    by_cases h300 : q = 300 ∨ q = 301
    · simp only [h300, if_true, Expr.read]
    · simp only [h300, if_false]
      by_cases h1602 : q = 1602
      · subst h1602; simp only [if_true, read_conj, Expr.read]
        have hσ2 : σ20 j 1602 = 1602 := rfl
        have hσ300 : σ20 j 300 = e0P20 (start20 j) + 6 := rfl
        rw [hσ2, hσ300, h1602, h59_601 1601 (by decide) (by decide), sym20,
          (Selector20.selector20_certs k).2.2.2.1, hread_agree _ hrefs_sign]
      · simp only [if_neg h1602]
        by_cases h59 : 1559 ≤ q ∧ q ≤ 1601
        · have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> ((try unfold Wire at *); omega)
          rw [hσ, h59_601 q h59.1 h59.2, sym20]
          exact hread_agree _ (hrefs_sel q h59.1 h59.2)
        · have hnotDst : ∀ o ∈ Selector20.prepOps20 Selector20.canonPorts, q ≠ o.dst := by
            intro o ho; have := prepOps20_dst_range o ho; unfold Wire at *; omega
          rw [LeaveSelector.sim_outside _ _ _ hnotDst]
          unfold Selector20.start20Sel Selector20.canonPorts
          have : q ≠ 1559 ∧ q ≠ 1560 ∧ ¬(1561 ≤ q ∧ q ≤ 1580) ∧ ¬(1581 ≤ q ∧ q ≤ 1602) ∧ q ≠ 300 ∧ q ≠ 301 := by unfold Wire at *; omega
          simp [this, Expr.read]
  have hRet11 := exit_mapOp (σ20 j) inDom20 (fun x y hx hy => σ20_inj j hx hy)
    (Selector20.retireOps20 Selector20.canonPorts) hretDom u10.basis
    (Selector20.post20 Selector20.canonPorts k) (Selector20.selector20_certs k).2.2.2.2.2.1 u10 n8 hret_match
  rw [(prep_map_eq j).2, ← (fix34_eq j).2.2.1] at hRet11
  generalize hu11 : run (GateMirror.forward (leaveFix11_20 (start20 j))) n8 u10 = u11 at hRet11
  let n9 := n8.drop (measurementCount (GateMirror.forward (leaveFix11_20 (start20 j))))
  have hret_dst_out : ∀ q : Nat, ¬ (1581 ≤ q ∧ q ≤ 1602) →
      ∀ o ∈ Selector20.retireOps20 Selector20.canonPorts, q ≠ σ20 j o.dst := by
    intro q hq o ho
    have hd := retireOps20_dst_range o ho
    have hσ : σ20 j o.dst = o.dst := by unfold σ20; split_ifs <;> ((try unfold Wire at *); omega)
    rw [hσ]; intro e; exact hq (e ▸ hd)
  have hu11_keep : ∀ q : Nat, ¬ (1581 ≤ q ∧ q ≤ 1602) → u11.basis q = u10.basis q := fun q hq =>
