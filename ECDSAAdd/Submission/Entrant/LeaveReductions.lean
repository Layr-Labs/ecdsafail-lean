  have ut (q : Wire) (low : 1559 ≤ q) (high : q ≤ 1576) :
      u.basis q = (run (GateMirror.forward (Shadow7.moveA (start j))) [] s).basis q := by
    rw [hu]; exact tail_keeps j lo (by omega) s q low high
