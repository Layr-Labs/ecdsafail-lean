  have hcl := SumSavedSquare.clear_counts K0 hwK E0 K0.core.sum K0.core.product hext.len (K0.core.sum_length hwK.core) sp hall
  have hbl : K0.core.sum.length = 129 := K0.core.sum_length hwK.core
  dsimp only at hk
