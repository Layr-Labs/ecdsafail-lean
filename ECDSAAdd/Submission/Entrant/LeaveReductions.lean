  have hc : (carries20 j).Nodup := List.Nodup.map_on (fun a _ b _ e => by
    rcases pool20_cases j a with ⟨_, ea⟩ | ⟨_, ea⟩ <;> rcases pool20_cases j b with ⟨_, eb⟩ | ⟨_, eb⟩ <;>
      (rw [ea, eb] at e; (try unfold Wire at *); omega)) List.nodup_range
