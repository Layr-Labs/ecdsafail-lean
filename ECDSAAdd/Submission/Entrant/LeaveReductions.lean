private def SplitCfg.Q5F (c : SplitCfg) : KRegs :=
  if c.n = 128 then
    { h := 33, bank := ((LowZero18LowK.ktmp StairSquareBChecks.K4DQ.LBF).take 66).take (c.n - 63) ++ [c.zpad],
      dst := (E0F.take 132).take (2 * (c.n - 63)) ++ [c.zdst0, c.zdst1],
