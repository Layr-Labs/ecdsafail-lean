private theorem hcar_after20 (j : Fin 9) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    ∀ q ∈ carries20 j,
      (run (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))) [] s).basis q = false := by
  have hg := geom20_facts j; dsimp only at hg
  intro q hq
  have hnotDst : q ∉ (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))).map LeaveReadoutFrame.destination := by
    rw [forward_map_dest]; intro hm
    obtain ⟨g, hg', e⟩ := List.mem_map.mp hm
    have ht := of_decide_eq_true (List.all_eq_true.mp (beforeFixed20_targets j) g hg')
    rw [e] at ht
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    rcases pool20_cases j i with ⟨_, ep⟩ | ⟨_, ep⟩ <;> (rw [ep] at ht; unfold Wire at *; omega)
  exact (LeaveReadoutFrame.preserved _ _ _ _ hnotDst).trans (h.clean q hq)

theorem leaveBefore20_valid (j : Fin 9) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    Ready s (leaveBefore20 (start20 j)) ∧
    (∀ t, (run (GateMirror.forward (leaveBefore20 (start20 j))) t s).phase = s.phase) ∧
    Prepared s (leaveBefore20 (start20 j)) := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  let u := flags20 z g0 s0
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have hcar_after := hcar_after20 j s z g0 s0 h
  have hbf_split := leaveBefore20_split (start20 j)
  have hbf_clean : Masked s (preMask20 (start20 j)) := by
    intro q hq
    unfold preMask20 at hq
    rw [Nat.testBit_or, Nat.testBit_or, testBit_interval, testBit_one_shl, testBit_one_shl] at hq
    simp only [Bool.or_eq_true, decide_eq_true_eq] at hq
    rcases hq with (⟨h1, h2⟩ | h6) | h7
    · by_cases h59 : q < 1559
      · exact h.scratch q (by simp only [List.mem_cons]; unfold Wire at *; omega)
      · exact h.zero q (by simp only [watched20, List.mem_append, List.mem_range'_1]; right; unfold Wire at *; omega)
    · rw [← h6]; exact h.zero _ (by simp [watched20])
    · rw [← h7]; exact h.zero _ (by simp [watched20])
  have hbf1 := ready_of_checkMask _ s 0 (preMask20 (start20 j)) (beforeFixed20_check j) hbf_clean
  have hbf2 : Ready (run (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))) [] s) (leaveAdjust20 (start20 j)) := by
    have hadj_safe : Safe (leaveAdjust20 (start20 j)) (fun q => q ∈ carries20 j) (fun q => q ∈ carries20 j) := by
      unfold leaveAdjust20 leaveAdjustCore20 adjustG
      have hys_out : ∀ y ∈ ys20 j, y ∉ carries20 j := by
        intro y hy hc
        obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hy; rw [List.mem_range] at hi
        obtain ⟨k, hk, e⟩ := List.mem_map.mp hc; rw [List.mem_range] at hk
        rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
          rcases pool20_cases j k with ⟨_, ep⟩ | ⟨_, ep⟩ <;> (rw [eb, ep] at e; unfold Wire at *; omega)
      have h3_out : (e0P20 (start20 j) + 3 : Wire) ∉ carries20 j := by
        intro hc; obtain ⟨k, hk, e⟩ := List.mem_map.mp hc; rw [List.mem_range] at hk
        rcases pool20_cases j k with ⟨_, ep⟩ | ⟨_, ep⟩ <;> (rw [ep] at e; unfold Wire at *; omega)
      have hcar_nd : (carries20 j).Nodup := by
        refine List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range
        rw [List.mem_range] at ha hb
        rcases pool20_cases j a with ⟨_, ea⟩ | ⟨_, ea⟩ <;>
          rcases pool20_cases j b with ⟨_, eb⟩ | ⟨_, eb⟩ <;> (rw [ea, eb] at e; unfold Wire at *; omega)
      refine safe_append (safe_lit (fun g hg' => by simp at hg'; subst hg'; rfl)
        (fun g hg' => by simp at hg'; subst hg'; exact h3_out))
        (safe_append (safe_frame' (noMake_cxsG _ _) (allAT_cxsG _ _ trivial hys_out))
          (safe_append (safe_addG _ _ _ _ (fun _ h => h) hcar_nd hys_out)
            (safe_frame' (noMake_cxsG _ _) (allAT_cxsG _ _ trivial hys_out))))
    exact (hadj_safe _ hcar_after).1
  have hbf_ready : Ready s (leaveBefore20 (start20 j)) := by
    rw [hbf_split]; exact ready_append _ _ s hbf1.1 hbf2
  -- Phase preservation of `leaveBefore20` and `barrel20` + exact barrel input facts
  have hfront (t : List Bool) := entry20_core j s t z u.1 u.2 h.small h.ready h.fresh h.scratch h.temp
  have hbf_phase (t : List Bool) : (run (GateMirror.forward (leaveBefore20 (start20 j))) t s).phase = s.phase := by
    rw [hbf_split, forward_app, run_append, run_take, forward_app, run_append, run_take]
    let en := run (GateMirror.forward (entryLeave20 (start20 j))) t s
    let t1 := t.drop (measurementCount (GateMirror.forward (entryLeave20 (start20 j))))
    have hkeptE (q : Nat) (ok : ¬ ((a0P20 (start20 j) - 1 ≤ q ∧ q ≤ a0P20 (start20 j) + 21) ∨
        (b0P20 (start20 j) - 1 ≤ q ∧ q ≤ b0P20 (start20 j) + 21) ∨
        (start20 j + 16 ≤ q ∧ q ≤ start20 j + 35) ∨
        (1556 ≤ q ∧ q ≤ 1578) ∨ q = e0P20 (start20 j) + 5)) : en.basis q = s.basis q :=
      entry20_keep j q ok s t
    have hzeroE : ∀ q ∈ watched20 j, en.basis q = false := by
      intro q hq; simp only [watched20, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_range'_1] at hq
      rcases hq with (rfl | rfl) | ⟨lo, hi⟩
      · exact (hkeptE _ (by omega)).trans (h.zero _ (by simp [watched20]))
      · exact (hkeptE _ (by omega)).trans (h.zero _ (by simp [watched20]))
      · by_cases h78 : q ≤ 1578
        · exact ((hfront t).2.2.2.2.2.2 q (by
            simp only [List.mem_cons, fullM20, List.mem_map, List.mem_range, not_or, not_exists, not_and]
            exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega, by unfold Wire at *; omega,
              fun i hi e => by unfold Wire at *; omega⟩)
            (Or.inr (by unfold Wire at *; omega)) (by unfold Wire at *; omega) (fun hm => by
              obtain ⟨p, hp, hq'⟩ := List.mem_flatMap.mp hm; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp
              rw [List.mem_range] at hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hq'
              rcases hq' with e | e <;> (unfold Wire at *; omega))).trans (h.zero q (by simp only [watched20, List.mem_append, List.mem_range'_1]; right; unfold Wire at *; omega))
        · exact (hkeptE q (by unfold Wire at *; omega)).trans (h.zero q (by simp only [watched20, List.mem_append, List.mem_range'_1]; right; unfold Wire at *; omega))
    have hmodeE : actualMode20 (sbP20 (start20 j)) z =
        farMode20 (en.basis (e0P20 (start20 j) + 3)) (en.basis (e0P20 (start20 j) + 4)) z.u := by
      rw [hkeptE _ (by omega), hkeptE _ (by omega), h.far, h.side]
      by_cases hf : Shadow.far (sbP20 (start20 j)) 20 z <;> by_cases hu : 2 ^ sbP20 (start20 j) ≤ z.u <;>
        simp [actualMode20, farMode20, hf, hu]
    have hevE : Selector20.right20 (actualMode20 (sbP20 (start20 j)) z) = true →
        ∀ i < 20, i ≤ Selector20.key20 (actualMode20 (sbP20 (start20 j)) z) →
          en.basis (swaps20 j i) = decide (i = Selector20.key20 (actualMode20 (sbP20 (start20 j)) z)) := fun on i hi hle =>
      (hkeptE _ (swaps20_away_entry j ⟨i, hi⟩)).trans (ev.2 on i hi hle)
    have hsel := selPrefix20_run j en t1 z.u (actualMode20 (sbP20 (start20 j)) z) hmodeE hzeroE hevE
    have hsel_ph : (run (GateMirror.forward (selPrefix20 (start20 j))) t1 en).phase = s.phase := by
      rw [hsel]
      have aux : ∀ (rs : List MoveChain.Row) (st : State), (MoveChain.clrAll (e0P20 (start20 j) + 6) rs st).phase = st.phase := by
        intro rs; induction rs with | nil => intro _; rfl | cons _ _ ih => intro st; exact ih _
      exact (aux _ _).trans (hfront t).1
    have hsplitA := leaveAdjust20_forward j
    let uSel := run (GateMirror.forward (selPrefix20 (start20 j))) t1 en
    let uPre : State := ⟨uSel.phase, writeBit uSel.basis (e0P20 (start20 j) + 3)
      (uSel.basis (e0P20 (start20 j) + 3) ^^ uSel.basis (e0P20 (start20 j) + 6))⟩
    have hcar_uPre : ∀ q ∈ carries20 j, uPre.basis q = false := by
      intro q hq
      have hne3 : q ≠ e0P20 (start20 j) + 3 := by
        obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
        rcases pool20_cases j i with ⟨_, ep⟩ | ⟨_, ep⟩ <;> (rw [ep]; unfold Wire at *; omega)
      have hb_eq : uSel.basis q = (run (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))) [] s).basis q := by
        have hba := run_basis_any20 (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))) t [] s s rfl
        conv_lhs at hba => rw [forward_app, run_append, run_take]
        exact congrFun hba q
      simp only [uPre, writeBit, Function.update_of_ne hne3, hb_eq]
      exact hcar_after q hq
    have habs : (1601 : Wire) ∉ ys20 j := by
      intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;> (rw [eb] at e; unfold Wire at *; omega)
    have hadj := HighBankAdjust.correct (ys20 j) (carries20 j) (e0P20 (start20 j) + 3) 1601
      (middle20_adjust_nodup j) habs (by simp [carries20, ys20]; omega) uPre
      (t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j))))) hcar_uPre
    rw [hsplitA, run_append, run_take]
    have hcx : run [.CX (e0P20 (start20 j) + 6) (e0P20 (start20 j) + 3)]
        (t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j))))) uSel = uPre :=
      run_cx20 _ _ _ _
    have hdropA : (t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j))))).drop
        (measurementCount [.CX (e0P20 (start20 j) + 6) (e0P20 (start20 j) + 3)]) =
        t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j)))) := by
      rw [mc_cx20, List.drop_zero]
    have hrunPre : run (GateMirror.forward (selPrefix20 (start20 j)))
        (t.drop (measurementCount (GateMirror.forward (entryLeave20 (start20 j)))))
        (run (GateMirror.forward (entryLeave20 (start20 j))) t s) = uSel := rfl
    have hdrop0 : t.drop (measurementCount (GateMirror.forward (entryLeave20 (start20 j)) ++ GateMirror.forward (selPrefix20 (start20 j)))) =
        t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j)))) := by
      simp only [t1, measurementCount_append, List.drop_drop, Nat.add_comm]
    rw [hrunPre, hdrop0, hcx, hdropA]
    exact hadj.1.trans hsel_ph
  have hbf_prep : Prepared s (leaveBefore20 (start20 j)) :=
    all_prepared _ s (leaveBefore20_ok j).1 hbf_phase
  exact ⟨hbf_ready, hbf_phase, hbf_prep⟩

theorem barrel20_mid_rt (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
  (h : Inputs20 j s z g0 s0) :
  let uB := run (GateMirror.forward (leaveBefore20 (start20 j))) m s
  ∀ t, run (barrel20 (start20 j) true) t
      (run (barrel20 (start20 j) false) (m.drop (measurementCount (GateMirror.forward (leaveBefore20 (start20 j))))) uB) = uB ∧
    (run (barrel20 (start20 j) false) t uB).phase = uB.phase := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  let u := flags20 z g0 s0
  have par := recordedParity20 j s z g0 s0 h.small h.odd h.record
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have hcrt : ∀ k < 10, s.basis (poolW20 (start20 j) (22 + k)) = false := fun k hk => by
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp]; exact h.cPool _ (by omega) (by omega)
  have hbf_split := leaveBefore20_split (start20 j)
  have hcar_after := hcar_after20 j s z g0 s0 h
  let uB := run (GateMirror.forward (leaveBefore20 (start20 j))) m s
  have hfront0 := entry20_core j s m z u.1 u.2 h.small h.ready h.fresh h.scratch h.temp
  let en := run (GateMirror.forward (entryLeave20 (start20 j))) m s
  let t1 := m.drop (measurementCount (GateMirror.forward (entryLeave20 (start20 j))))
  let k := actualMode20 (sbP20 (start20 j)) z
  have hkeptE (q : Nat) (ok : ¬ ((a0P20 (start20 j) - 1 ≤ q ∧ q ≤ a0P20 (start20 j) + 21) ∨
      (b0P20 (start20 j) - 1 ≤ q ∧ q ≤ b0P20 (start20 j) + 21) ∨
      (start20 j + 16 ≤ q ∧ q ≤ start20 j + 35) ∨
      (1556 ≤ q ∧ q ≤ 1578) ∨ q = e0P20 (start20 j) + 5)) : en.basis q = s.basis q :=
    entry20_keep j q ok s m
  have hzeroE : ∀ q ∈ watched20 j, en.basis q = false := by
    intro q hq; simp only [watched20, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, List.mem_range'_1] at hq
    rcases hq with (rfl | rfl) | ⟨lo, hi⟩
    · exact (hkeptE _ (by omega)).trans (h.zero _ (by simp [watched20]))
    · exact (hkeptE _ (by omega)).trans (h.zero _ (by simp [watched20]))
    · by_cases h78 : q ≤ 1578
      · exact (hfront0.2.2.2.2.2.2 q (by
          simp only [List.mem_cons, fullM20, List.mem_map, List.mem_range, not_or, not_exists, not_and]
          exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega, by unfold Wire at *; omega,
            fun i hi e => by unfold Wire at *; omega⟩)
          (Or.inr (by unfold Wire at *; omega)) (by unfold Wire at *; omega) (fun hm => by
            obtain ⟨p, hp, hq'⟩ := List.mem_flatMap.mp hm; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp
            rw [List.mem_range] at hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hq'
            rcases hq' with e | e <;> (unfold Wire at *; omega))).trans (h.zero q (by simp only [watched20, List.mem_append, List.mem_range'_1]; right; unfold Wire at *; omega))
      · exact (hkeptE q (by unfold Wire at *; omega)).trans (h.zero q (by simp only [watched20, List.mem_append, List.mem_range'_1]; right; unfold Wire at *; omega))
  have hmodeE : k = farMode20 (en.basis (e0P20 (start20 j) + 3)) (en.basis (e0P20 (start20 j) + 4)) z.u := by
    rw [hkeptE _ (by omega), hkeptE _ (by omega), h.far, h.side]
    by_cases hf : Shadow.far (sbP20 (start20 j)) 20 z <;> by_cases hu : 2 ^ sbP20 (start20 j) ≤ z.u <;>
      simp [k, actualMode20, farMode20, hf, hu]
  have hevE : Selector20.right20 k = true → ∀ i < 20, i ≤ Selector20.key20 k → en.basis (swaps20 j i) = decide (i = Selector20.key20 k) := fun on i hi hle =>
    (hkeptE _ (swaps20_away_entry j ⟨i, hi⟩)).trans (ev.2 on i hi hle)
  have hsel := selPrefix20_run j en t1 z.u k hmodeE hzeroE hevE
  let uSel := run (GateMirror.forward (selPrefix20 (start20 j))) t1 en
  let uPre : State := ⟨uSel.phase, writeBit uSel.basis (e0P20 (start20 j) + 3)
    (uSel.basis (e0P20 (start20 j) + 3) ^^ uSel.basis (e0P20 (start20 j) + 6))⟩
  have hsplitA := leaveAdjust20_forward j
  have huB_eq : uB = run (HighBankAdjust.adjust (ys20 j) (carries20 j) (e0P20 (start20 j) + 3) 1601)
      (t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j))))) uPre := by
    simp only [uB, hbf_split, forward_app, run_append, run_take, hsplitA, en, t1, uSel]
    have hdrop0 : m.drop (measurementCount (GateMirror.forward (entryLeave20 (start20 j)) ++ GateMirror.forward (selPrefix20 (start20 j)))) =
        t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j)))) := by
      simp only [t1, measurementCount_append, List.drop_drop, Nat.add_comm]
    rw [hdrop0, run_cx20, mc_cx20, List.drop_zero]
  have hcar_uPre : ∀ q ∈ carries20 j, uPre.basis q = false := by
    intro q hq
    have hne3 : q ≠ e0P20 (start20 j) + 3 := by
      obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
      rcases pool20_cases j i with ⟨_, ep⟩ | ⟨_, ep⟩ <;> (rw [ep]; unfold Wire at *; omega)
    have hb_eq : uSel.basis q = (run (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))) [] s).basis q := by
      have hba := run_basis_any20 (GateMirror.forward (entryLeave20 (start20 j) ++ selPrefix20 (start20 j))) m [] s s rfl
      conv_lhs at hba => rw [forward_app, run_append, run_take]
      exact congrFun hba q
    simp only [uPre, writeBit, Function.update_of_ne hne3, hb_eq]; exact hcar_after q hq
  have habs : (1601 : Wire) ∉ ys20 j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
    rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;> (rw [eb] at e; unfold Wire at *; omega)
  have hadj := HighBankAdjust.correct (ys20 j) (carries20 j) (e0P20 (start20 j) + 3) 1601
    (middle20_adjust_nodup j) habs (by simp [carries20, ys20]; omega) uPre
    (t1.drop (measurementCount (GateMirror.forward (selPrefix20 (start20 j))))) hcar_uPre
  rw [← huB_eq] at hadj
  -- Build slot : Fin 22 and value H < 2^(liveW20 - (slot - 1))
  let slot : Fin 22 := if Selector20.enabled20 k then ⟨Selector20.key20 k + 1, by have := k.isLt; unfold Selector20.key20; omega⟩ else ⟨0, by decide⟩
  have htag_uB : ∀ r < 21, uB.basis (tagsP20.getD r 0) = decide (slot.val = r + 1) := by
    intro r hr
    have tr := tagsP20_getD_range hr
    have hnout : tagsP20.getD r 0 ∉ ys20 j := by
      intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;> (rw [eb] at e; unfold Wire at *; omega)
    rw [hadj.2.1 _ hnout]
    simp only [uPre, writeBit, Function.update_of_ne (show tagsP20.getD r 0 ≠ e0P20 (start20 j) + 3 by unfold Wire at *; omega)]
    change uSel.basis (tagsP20.getD r 0) = _
    dsimp only [uSel]; rw [hsel]
    have hclr_tag : ∀ (rs : List MoveChain.Row) (st : State), (∀ row ∈ rs, tagsP20.getD r 0 ≠ row.2) →
        (MoveChain.clrAll (e0P20 (start20 j) + 6) rs st).basis (tagsP20.getD r 0) = st.basis (tagsP20.getD r 0) := by
      intro rs; induction rs with | nil => intro _ _; rfl | cons row rs ih =>
        intro st hne; exact (ih _ (fun r' hr' => hne r' (List.mem_cons_of_mem _ hr'))).trans
          (MoveChain.wb_other _ _ _ _ (hne row List.mem_cons_self))
    rw [hclr_tag _ _ (fun row hrow => by obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hrow; rw [List.mem_range] at hi; unfold Wire at *; omega)]
    have hmem : tagsP20.getD r 0 ∈ List.range' 1559 44 ∨ tagsP20.getD r 0 = e0P20 (start20 j) + 6 ∨
        tagsP20.getD r 0 = e0P20 (start20 j) + 7 := Or.inl (by simp only [List.mem_range'_1]; unfold Wire at *; omega)
    simp only [if_pos hmem, if_neg (show tagsP20.getD r 0 ≠ e0P20 (start20 j) + 6 by unfold Wire at *; omega),
      if_neg (show tagsP20.getD r 0 ≠ e0P20 (start20 j) + 7 by unfold Wire at *; omega)]
    have hval : sym20 j k en.basis (tagsP20.getD r 0) = (Selector20.enabled20 k && decide (r = Selector20.key20 k)) := by
      unfold sym20; rw [(Selector20.selector20_certs k).1 ⟨r, hr⟩]; rfl
    rw [hval]
    by_cases hen : Selector20.enabled20 k = true
    · simp only [slot, hen, ↓reduceIte, Bool.true_and]; exact decide_eq_decide.mpr (by omega)
    · have henf : Selector20.enabled20 k = false := Bool.eq_false_iff.mpr hen
      simp only [slot, henf, Bool.false_eq_true, ↓reduceIte, Bool.false_and]
      exact (decide_eq_false (by omega)).symm
  have hscr_uB : ∀ r < 10, uB.basis (poolW20 (start20 j) (22 + r)) = false := by
    intro r hr
