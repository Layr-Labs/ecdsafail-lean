      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
      exact pdom x (List.mem_toFinset.mp (hp hx))
    exact ⟨WindowCovered.appW (ok _ step.1) sub.1, WindowCovered.appW sub.2 (ok _ ustep)⟩

