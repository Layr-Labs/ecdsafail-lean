    have stillD : (Shadow7.moveRows (start j)).all (fun r => (GateMirror.forward D).all (MoveChain.quiet (Shadow7.e0P (start j) + 6) r)) = true := by
      rw [List.all_eq_true]; intro r hr; rw [List.all_eq_true]; intro g hg
