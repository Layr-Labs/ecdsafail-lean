    (Shadow7.b0P 150 - 1 + 12) (Shadow7.a0P 150 - 1 + 12) := rfl

theorem Dblk150_S2 : Dblk150 = S2 (150 + 30) (Shadow7.b0P 150 - 1 + 12) (Shadow7.a0P 150 - 1 + 12)
