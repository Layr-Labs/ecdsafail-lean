private theorem retain_watch345 (d : Bool) (row : Nat) (s t : State)
    (clean : ∀ k : Fin 157, 23 ≤ k.val → ArchiveJ20.rawPorts k8 k ∈ Shadow7.watch j20 →
      s.basis (ArchiveJ20.rawPorts k8 k) = false)
    (frame : Frame (ArchiveJ20.codePorts k8) (code d) row t)
    (outside : ∀ q, (∀ k, ArchiveJ20.rawPorts k8 k ≠ q) → t.basis q = s.basis q) :
    ∀ q ∈ Shadow7.watch j20, t.basis q = s.basis q := by
  intro q hq
  by_cases mem : ∃ k, ArchiveJ20.rawPorts k8 k = q
  · obtain ⟨k, rfl⟩ := mem
    have hk : 23 ≤ k.val := by
      by_contra! bad
      have hmem : ArchiveJ20.rawPorts k8 k ∈ ArchiveJ20.rawHead k8 := by
        show (ArchiveJ20.rawPortsList k8).getD k.val 0 ∈ ArchiveJ20.rawHead k8
        rw [ArchiveJ20.raw_split, List.getD_append _ _ _ _ (by simp [ArchiveJ20.rawHead, cellsLoadP]; exact bad)]
        rw [List.getD_eq_getElem _ _ (by simp [ArchiveJ20.rawHead, cellsLoadP]; exact bad)]
        exact List.getElem_mem _
      exact (of_decide_eq_true (List.all_eq_true.mp watch345_disj.2 _ hq)) hmem
    have hsc : ArchiveJ20.rawPorts k8 k = ArchiveJ20.codePorts k8 ⟨k.val - 7, by omega⟩ := by
      have hlt : k.val - 23 < 134 := by omega
      have hr := ArchiveJ20.raw_scratch k8 (k := k.val - 23) hlt
      have hc := ArchiveJ20.code_scratch k8 (k := k.val - 23) hlt
      rw [show 23 + (k.val - 23) = k.val by omega] at hr
      rw [show 16 + (k.val - 23) = k.val - 7 by omega] at hc
      exact hr.trans hc.symm
    rw [clean k hk hq, hsc, frame, archive_blank _ _ (by dsimp; omega), Nat.zero_testBit]
  · exact outside _ (fun k eq => mem ⟨k, eq⟩)

theorem admin345 (d : Bool) (s : State) (m : List Bool) (z : SkywalkRails.State)
    (active : Shadow7.onRails j20 1 z s.basis)
    (okA : MeasuredCodec5.legalAt histA345 s.basis)
    (okB : MeasuredCodec5.legalAt histB345 s.basis)
    (row : Nat) (limit : row < 63145)
    (raw : Frame (ArchiveJ20.rawPorts k8) ArchivePortAction.raw row (run (packProg345 d) m s))
    (clean : ∀ k : Fin 157, 23 ≤ k.val → ArchiveJ20.rawPorts k8 k ∈ Shadow7.watch j20 →
      (run (packProg345 d) m s).basis (ArchiveJ20.rawPorts k8 k) = false) :
    let out := run (withArchive345 d) m s
    Shadow7.AdminResult j20 (fromArchive345 d) s out ∧ Frame (ArchiveJ20.codePorts k8) (code d) row out := by
  let p := run (packProg345 d) m s
  let tape := m.drop (measurementCount (packProg345 d))
