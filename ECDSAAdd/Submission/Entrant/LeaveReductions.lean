        all_goals omega
    have ok : ∀ P : Program, wires P ⊆ (IntegerPacket.ports (Shadow7.shape j) a).wires.toFinset →
        WindowCovered.CoveredW (renameProgram (OB5.sig (start j + a)) P) := by
      intro P hp q hq
