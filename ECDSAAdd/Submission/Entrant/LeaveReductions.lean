theorem archive_result20 (j : Fin 9) (d : Bool) (row : Nat) (lim : row < 63145) (s : State) (m : List Bool)
    (raw0 : Frame (prevRawPorts20 j) raw row (run (packProg20 j d) m s)) :
    Frame (prevCodePorts20 j) (code d) row (run (withArchive20 j d) m s) :=
