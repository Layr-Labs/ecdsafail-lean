  have f:=EnterJ7.frame j
  have hj:=j.isLt
  simp only [Shadow7.e0P] at hq
  refine ⟨?_,?_,?_,fun m=>?_,fun m=>?_,?_,?_,?_,fun m=>?_⟩
  · show @Eq Nat (OB5.sigNat (start j+14) q) q
