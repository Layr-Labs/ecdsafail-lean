    unfold leaveBox20
    exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp (fixedAfter20_box j) g hg') q hq)
  have h13 : inBox20 j (leaveLowStore20 (start20 j)) := by
    unfold leaveLowStore20
    have hbs : ∀ q ∈ (List.range (lowsP20 (start20 j))).map (b0P20 (start20 j) + ·), leaveBox20 (start20 j) q := by
      intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
