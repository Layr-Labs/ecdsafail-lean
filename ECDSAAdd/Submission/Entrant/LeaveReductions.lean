theorem box20_of_leaveBox20 (j : Fin 9) (q : Wire) (h : leaveBox20 (start20 j) q)
    (nm : ¬ (2070 ≤ (q : Nat) + start20 j ∧ (q : Nat) ≤ 1812)) :
    WideReference20.Box20 (start20 j) 20 q := by
  have hg := geom20_facts j; dsimp only at hg
  have h19 : railP (start20 j) ≤ 258 ∧ railP (start20 j + 19) ≤ 258 ∧
      a0P20 (start20 j) + 21 ≤ start20 j + 35 + railP (start20 j + 19) ∧
      a0P20 (start20 j) + 21 ≤ 529 ∧
      bTopP (start20 j) = 785 + railP (start20 j) := by
    have : ∀ m : Fin 9, railP (start20 m) ≤ 258 ∧ railP (start20 m + 19) ≤ 258 ∧
        a0P20 (start20 m) + 21 ≤ start20 m + 35 + railP (start20 m + 19) ∧
        a0P20 (start20 m) + 21 ≤ 529 ∧
        bTopP (start20 m) = 785 + railP (start20 m) := by decide +kernel
    exact this j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  unfold leaveBox20 at h
  unfold WideReference20.Box20
  rw [show start20 j + 20 - 1 = start20 j + 19 by omega,
    route_rail20 (start20 j) (by omega), route_rail20 (start20 j + 19) (by omega)]
  unfold Wire at *
  rcases h with h | h | h | h | h
  · left; omega
  · left; omega
  · right; left; omega
  · right; right; left; omega
  · right; right; right; omega

private def leaveBound20 (s : Nat) (q : Wire) : Prop := (q : Nat) + s ≤ 2069

