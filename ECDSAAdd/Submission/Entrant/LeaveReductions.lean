private theorem firstBodyModelOdd_readSites_and_g0 (half : Bool → Program) (divide : Bool)
    (hsup : OddHalfSupport (half divide)) :
    wires (firstBodyModelOdd half divide) ⊆ FrontierReplay1591.readSites 0 ∧
