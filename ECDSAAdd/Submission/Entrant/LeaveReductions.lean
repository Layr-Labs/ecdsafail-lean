      rcases bank20_cases j (i := ia) (by omega) with ⟨_, ea⟩ | ⟨_, _, ea, _, _⟩ | ⟨_, ea, _, _⟩ <;>
        (rw [ea] at he; have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl; (try unfold Wire at *); omega)
    · obtain ⟨ib, hib, he⟩ := List.mem_map.mp ha; rw [List.mem_range] at hib
      rcases pool20_cases j ib with ⟨_, eb⟩ | ⟨_, eb⟩ <;> (rw [eb] at he; (try unfold Wire at *); omega)
  · obtain ⟨ia, hia, rfl⟩ := List.mem_map.mp ha; rw [List.mem_range] at hia
    obtain ⟨ib, hib, rfl⟩ := List.mem_map.mp hb; rw [List.mem_range] at hib
    rcases bank20_cases j (i := ia) (by omega) with ⟨_, ea⟩ | ⟨_, _, ea, _, _⟩ | ⟨_, ea, _, _⟩ <;>
      rcases pool20_cases j ib with ⟨_, eb⟩ | ⟨_, eb⟩ <;>
      (rw [ea, eb] at e; have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl; (try unfold Wire at *); omega)

theorem cols20_wellPlaced (j : Fin 9) :
    WellPlaced 1624 (columnsP20 (start20 j)) ∧ (columnsP20 (start20 j)).Pairwise Apart := by
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, hwp1, hwp2, hlo1, hlo2, huw, hlw1, hlw2, htop⟩ := geom20_facts j
