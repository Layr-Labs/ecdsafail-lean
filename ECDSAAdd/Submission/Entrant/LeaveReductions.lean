private theorem leaveBound20_app {s : Nat} {a b : List Gate}
    (ha : AllW (leaveBound20 s) a) (hb : AllW (leaveBound20 s) b) : AllW (leaveBound20 s) (a ++ b) :=
  fun g hg => (List.mem_append.mp hg).elim (ha g) (hb g)

private theorem leaveBound20_xsG {s : Nat} {xs : List Wire} (h : ∀ q ∈ xs, leaveBound20 s q) :
