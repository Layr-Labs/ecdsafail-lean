def carries20 (j : Fin 9) : List Wire := (List.range (wpP20 (start20 j) - 1)).map (poolW20 (start20 j))
def live20 (j : Fin 9) (i : Nat) : Wire :=
  if i < lowsP20 (start20 j) then a0P20 (start20 j) + i else bankW20 (start20 j) i

def lowSign20 (s : Nat) : List Gate :=
  [.cx (e0P20 s + 3) 1560, .cx 1559 1560, .pop (e0P20 s + 3) (e0P20 s + 4) 1559]

def oddRead20 (j : Fin 9) (v : BasisState) : List Bool :=
  (List.range 20).map fun i => !v ((ports20 j).g + i)

def parityBits20 (p : LeaveSelector.Ports) (v : BasisState) : List Bool :=
  (List.range 20).map fun i => v (p.g + i)

private theorem scan20_emitted : ∀ j : Fin 9,
    GateMirror.forward (fix0P20 (start20 j) (sbP20 (start20 j))) =
      RailPair.scan (a0P20 (start20 j) + 21) (b0P20 (start20 j) + 21) (start20 j + 35)
        (e0P20 (start20 j) + 5) (scanPairs20 j) := by
  decide +kernel

private theorem scan20_layout : ∀ j : Fin 9,
    ScanGeometry (a0P20 (start20 j) + 21) (b0P20 (start20 j) + 21) (start20 j + 35)
      (e0P20 (start20 j) + 5) (scanPairs20 j) := by
  intro j; constructor <;> revert j <;> decide +kernel

private theorem scan20_ports : ∀ j : Fin 9,
    (scanPairs20 j).map Prod.fst = ((IntegerPacket.ports (shape20 j) 20).a.drop (sbP20 (start20 j))).map (windowNet20 j) ∧
    (scanPairs20 j).map Prod.snd = ((IntegerPacket.ports (shape20 j) 20).b.drop (sbP20 (start20 j))).map (windowNet20 j) ∧
    a0P20 (start20 j) + 21 = windowNet20 j (IntegerPacket.ports (shape20 j) 20).aSign ∧
    b0P20 (start20 j) + 21 = windowNet20 j (IntegerPacket.ports (shape20 j) 20).bSign ∧
    start20 j + 35 = windowNet20 j (IntegerPacket.ports (shape20 j) 20).previous ∧
    sbP20 (start20 j) ≤ (IntegerPacket.ports (shape20 j) 20).a.length ∧
    sbP20 (start20 j) ≤ (IntegerPacket.ports (shape20 j) 20).b.length := by
  decide +kernel

private theorem fix2_20_parts : ∀ j : Fin 9,
    GateMirror.forward (fix2P20 (start20 j) (sbP20 (start20 j))) =
      latch true none 1556 (b0P20 (start20 j) - 1) (longPairs20s j) ++
        (maskP20 j ++ Companion.eraseM (fullA20s j) (fullM20s j) fullC19 1556 1558) := by
  decide +kernel

private theorem long20s_layout : ∀ j : Fin 9,
    (1556 :: (b0P20 (start20 j) - 1) :: PortalAnd.sites (longPairs20s j)).Nodup := by
  decide +kernel

private theorem full20s_geometry : ∀ j : Fin 9,
    Companion.Geometry (fullA20s j) (fullM20s j) fullC19 1556 1558 := by
  intro j; constructor <;> revert j <;> decide +kernel

theorem entry20_dest : ∀ j : Fin 9, (entryLeave20 (start20 j)).all (fun g =>
    (decide (a0P20 (start20 j) - 1 ≤ GateMirror.target g) && decide (GateMirror.target g ≤ a0P20 (start20 j) + 21)) ||
    (decide (b0P20 (start20 j) - 1 ≤ GateMirror.target g) && decide (GateMirror.target g ≤ b0P20 (start20 j) + 21)) ||
    (decide (start20 j + 16 ≤ GateMirror.target g) && decide (GateMirror.target g ≤ start20 j + 35)) ||
    (decide (1556 ≤ GateMirror.target g) && decide (GateMirror.target g ≤ 1578)) ||
    decide (GateMirror.target g = e0P20 (start20 j) + 5)) = true := by
  decide +kernel

theorem forward_map_dest (gs : List Gate) :
    (GateMirror.forward gs).map destination = gs.map GateMirror.target := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    simp only [GateMirror.forward, List.map_cons] at ih ⊢
    rw [ih]; cases g <;> rfl

theorem entry20_keep (j : Fin 9) (q : Nat)
    (hq : ¬ ((a0P20 (start20 j) - 1 ≤ q ∧ q ≤ a0P20 (start20 j) + 21) ∨
      (b0P20 (start20 j) - 1 ≤ q ∧ q ≤ b0P20 (start20 j) + 21) ∨
      (start20 j + 16 ≤ q ∧ q ≤ start20 j + 35) ∨
      (1556 ≤ q ∧ q ≤ 1578) ∨ q = e0P20 (start20 j) + 5)) (s : State) (m : List Bool) :
    (run (GateMirror.forward (entryLeave20 (start20 j))) m s).basis q = s.basis q := by
  apply LeaveReadoutFrame.preserved
  intro hm
  rw [forward_map_dest] at hm
  obtain ⟨g, hg, e⟩ := List.mem_map.mp hm
  have h := List.all_eq_true.mp (entry20_dest j) g hg
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
  rw [e] at h; exact hq (by unfold Wire at *; omega)

theorem fix1_20_forward (j : Fin 9) :
    GateMirror.forward (leaveFix1_20 (start20 j)) = notRegister (history20 j) := rfl

private theorem history20_nodup (j : Fin 9) : (history20 j).Nodup :=
  List.Nodup.map (fun _ _ e => Nat.add_left_cancel e) List.nodup_range

private theorem flip20_dest (j : Fin 9) (q : Wire) (hq : q < start20 j + 16 ∨ start20 j + 35 < q) :
    q ∉ (GateMirror.forward (leaveFix1_20 (start20 j))).map destination := by
  rw [fix1_20_forward]
  simp only [history20, notRegister, List.map_map, List.mem_map, List.mem_range, not_exists, not_and]
  intro i hi e; simp only [Function.comp, destination] at e; unfold Wire at *; omega

theorem inputRow20 (b : Nat) (z : SkywalkNat.State) (small : Shadow7.SmallIfFar b 20 z) :
    let a := SkywalkNat.step^[20] (Shadow.reduced b 20 z)
    a.u < 2 ^ 21 * 2 ^ b ∧ (min a.u a.v < 2 ^ b → 2 ^ b ≤ a.u → a.u + a.v < 2 ^ 21 * 2 ^ b) := by
  have hb := Nat.two_pow_pos b
  have hlim : 2 * Shadow.limb b 20 = 2 ^ 22 * 2 ^ b := by rw [scale20, pow_succ]; ring
  have hS : (Shadow.reduced b 20 z).u + (Shadow.reduced b 20 z).v < 2 ^ 22 * 2 ^ b := by
    by_cases f : Shadow.far b 20 z
    · have upper := (Shadow.represented b 20 z (small f) f).2.2; omega
    · simp only [Shadow.reduced, if_neg f]
      have upper := (Nat.div_lt_iff_lt_mul (by unfold Shadow.limb; positivity)).mp (Nat.lt_of_not_ge f)
      omega
  dsimp only
  rw [show (20 : Nat) = 18 + 1 + 1 from rfl, Function.iterate_succ_apply', Function.iterate_succ_apply']
  have hc0 := SkywalkNat.iter_sum_nonincrease 18 (Shadow.reduced b 20 z)
  generalize SkywalkNat.step^[18] (Shadow.reduced b 20 z) = c at hc0 ⊢
  have h1 := LeaveShadowRails.step_u_half c
  have h2 := SkywalkNat.step_sum_nonincrease c
  generalize SkywalkNat.step c = d at h1 h2 ⊢
  have h3 := LeaveShadowRails.step_u_half d
  refine ⟨by omega, fun hmin hlong => ?_⟩
  unfold SkywalkNat.step at hmin hlong ⊢
  split_ifs at hmin hlong ⊢ <;> (try dsimp only at hmin hlong ⊢) <;> omega

theorem inputScan20_result (j : Fin 9) (s : State) (tape : List Bool) (u v : Nat)
    (G sg : Bool) (ready : onRails20 j 20 (SkywalkRails.encode G sg u v) s.basis)
    (fresh : s.basis (e0P20 (start20 j) + 5) = false) :
    let t := run (GateMirror.forward (fix0P20 (start20 j) (sbP20 (start20 j)))) tape s
    let e := PortalValues.negative sg u
    t.phase = s.phase ∧ t.basis (e0P20 (start20 j) + 5) = e ∧
      (∀ i < 23, t.basis (a0P20 (start20 j) - 1 + i) = ((u + v) / 2 ^ sbP20 (start20 j)).testBit i ∧
        t.basis (b0P20 (start20 j) - 1 + i) = ((u - e.toNat) / 2 ^ sbP20 (start20 j)).testBit i) ∧
      ∀ q, q ≠ e0P20 (start20 j) + 5 → q ∉ RailPair.sites (scanPairs20 j) → t.basis q = s.basis q := by
  obtain ⟨pl, pr, pa, pb, pg, la, lb⟩ := scan20_ports j
  rw [scan20_emitted j]
  let L := IntegerPacket.ports (shape20 j) 20
  let e := PortalValues.negative sg u
  have gh : mappedBasis20 j s.basis L.previous = G := by
    have eq := ready.2.2.1; cases G <;> exact eq
  have math := signedWords L G sg u v (mappedBasis20 j s.basis) ready.1 ready.2.1 gh
  have gg : s.basis (start20 j + 35) = G := pg ▸ gh
  have ss : (s.basis (a0P20 (start20 j) + 21) ^^ s.basis (b0P20 (start20 j) + 21)) = e := by
    rw [pa, pb]; exact math.2.1
  have act := RailPair.scan_run _ _ _ _ _ (scan20_layout j) s tape fresh
  have vals := scan_values _ _ _ _ _ (scan20_layout j) s tape fresh
  dsimp only at vals act ⊢
  set st := run (RailPair.scan (a0P20 (start20 j) + 21) (b0P20 (start20 j) + 21) (start20 j + 35)
    (e0P20 (start20 j) + 5) (scanPairs20 j)) tape s
  have hout : st.basis (e0P20 (start20 j) + 5) = e ∧
      regValue ((scanPairs20 j).map Prod.fst) st.basis = (u + v) / 2 ^ sbP20 (start20 j) ∧
      regValue ((scanPairs20 j).map Prod.snd) st.basis = (u - e.toNat) / 2 ^ sbP20 (start20 j) := by
    refine ⟨act.2.1.trans ss, ?_⟩
    rw [gg, ss] at vals
    rw [pl, pr] at vals ⊢
    simp only [unroute, shiftedValue, la, lb] at vals ⊢
    obtain ⟨pos, mag⟩ := math.2.2
    cases G <;> simp only [wordPos, wordSigned, ite_true, Bool.false_eq_true, ite_false] at pos mag vals
    all_goals exact ⟨vals.1.trans (congrArg (· / 2 ^ sbP20 (start20 j)) pos),
      vals.2.trans (congrArg (· / 2 ^ sbP20 (start20 j)) mag)⟩
  refine ⟨act.1, hout.1, ?_, act.2.2.1⟩
  intro i hi
  have g1 : ((scanPairs20 j).map Prod.fst).getD i 0 = a0P20 (start20 j) - 1 + i := by
    simp [scanPairs20, List.getD_eq_getElem?_getD, hi]
  have g2 : ((scanPairs20 j).map Prod.snd).getD i 0 = b0P20 (start20 j) - 1 + i := by
    simp [scanPairs20, List.getD_eq_getElem?_getD, hi]
  have len1 : ((scanPairs20 j).map Prod.fst).length = 23 := by simp [scanPairs20]
  have len2 : ((scanPairs20 j).map Prod.snd).length = 23 := by simp [scanPairs20]
  have hb1 := HighBankAdjust.bit_read ((scanPairs20 j).map Prod.fst) i st.basis (by rw [len1]; exact hi)
  have hb2 := HighBankAdjust.bit_read ((scanPairs20 j).map Prod.snd) i st.basis (by rw [len2]; exact hi)
  rw [g1, hout.2.1] at hb1; rw [g2, hout.2.2] at hb2
  exact ⟨hb1, hb2⟩

attribute [local irreducible] run SkywalkNat.step fix0P20 leaveFix1_20 fix2P20 latch Companion.eraseM in
theorem entry20_core (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State)
    (G sg : Bool) (small : Small20 (sbP20 (start20 j)) z)
    (ready : onRails20 j 20 (SkywalkRails.encode G sg
      (SkywalkNat.step^[20] (Shadow.reduced (sbP20 (start20 j)) 20 z)).u
      (SkywalkNat.step^[20] (Shadow.reduced (sbP20 (start20 j)) 20 z)).v) s.basis)
    (fresh : s.basis (e0P20 (start20 j) + 5) = false)
    (scratch : ∀ q ∈ 1556 :: 1557 :: 1558 :: fullC20, s.basis q = false)
    (temp : ∀ p ∈ longPairs20 j, s.basis p.2 = false) :
    let a := SkywalkNat.step^[20] (Shadow.reduced (sbP20 (start20 j)) 20 z)
    let e := PortalValues.negative sg a.u
    let out := run (GateMirror.forward (entryLeave20 (start20 j))) m s
    out.phase = s.phase ∧ regValue (fullM20 j) out.basis = 0 ∧ out.basis (e0P20 (start20 j) + 5) = e ∧
      out.basis 1556 = decide (2 ^ sbP20 (start20 j) ≤ a.u - e.toNat) ∧
      (out.basis 1558).toNat = upperBorrow (2 ^ sbP20 (start20 j)) a.u a.v e.toNat ∧
      (∀ i < 23, out.basis (a0P20 (start20 j) - 1 + i) = ((a.u + a.v) / 2 ^ sbP20 (start20 j)).testBit i) ∧
      ∀ q, q ∉ 1556 :: 1557 :: 1558 :: fullM20 j → (q < start20 j + 16 ∨ start20 j + 35 < q) →
        q ≠ e0P20 (start20 j) + 5 → q ∉ RailPair.sites (scanPairs20 j) → out.basis q = s.basis q := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have he0 : e0P20 (start20 j) = 1579 + sbP20 (start20 j) := rfl
  intro a e out
  have scanActual := inputScan20_result j s m a.u a.v G sg ready fresh
  generalize hu : run (GateMirror.forward (fix0P20 (start20 j) (sbP20 (start20 j)))) m s = u at scanActual
  generalize ht : m.drop (measurementCount (GateMirror.forward (fix0P20 (start20 j) (sbP20 (start20 j))))) = t
  generalize hv : run (GateMirror.forward (leaveFix1_20 (start20 j))) t u = v
  have hist (q : Wire) (hq : q < start20 j + 16 ∨ start20 j + 35 < q) : v.basis q = u.basis q := by
    rw [← hv]; exact preserved _ _ _ _ (flip20_dest j q hq)
  have vphase : v.phase = u.phase := by
    rw [← hv, fix1_20_forward, notRegister_correct _ (history20_nodup j)]
  have outputBits (i : Nat) (hi : i < 23) :
      v.basis (a0P20 (start20 j) - 1 + i) = ((a.u + a.v) / 2 ^ sbP20 (start20 j)).testBit i ∧
      v.basis (b0P20 (start20 j) - 1 + i) = ((a.u - e.toNat) / 2 ^ sbP20 (start20 j)).testBit i := by
    rw [hist _ (Or.inr (by unfold Wire; omega)), hist _ (Or.inr (by unfold Wire; omega))]
    exact scanActual.2.2.1 i hi
  have same (q : Wire) (h1q : q < start20 j + 16 ∨ start20 j + 35 < q) (h2q : q ≠ e0P20 (start20 j) + 5)
      (h3q : q ∉ RailPair.sites (scanPairs20 j)) : v.basis q = s.basis q :=
    (hist _ h1q).trans (scanActual.2.2.2 _ h2q h3q)
  have scanLt : ∀ q ∈ RailPair.sites (scanPairs20 j), (q : Nat) < 1556 := by
    intro q hq
    obtain ⟨p, hp, hq'⟩ := List.mem_flatMap.mp hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq'
    rcases hq' with rfl | rfl <;> unfold Wire <;> omega
  have away (q : Nat) (hq : 1556 ≤ q ∧ q ≤ 1602) :
      (q < start20 j + 16 ∨ start20 j + 35 < q) ∧ q ≠ e0P20 (start20 j) + 5 ∧
        q ∉ RailPair.sites (scanPairs20 j) :=
    ⟨Or.inr (by omega), by omega, fun hm => by have hlt := scanLt q hm; unfold Wire at *; omega⟩
  have clean : ∀ q ∈ 1556 :: 1557 :: 1558 :: fullC20, v.basis q = false := by
    intro q h
    have hr : 1556 ≤ q ∧ q ≤ 1602 := by
      simp only [List.mem_cons, fullC20, List.mem_map, List.mem_range] at h
      rcases h with rfl | rfl | rfl | ⟨i, hi, rfl⟩ <;> (unfold Wire at *; omega)
    obtain ⟨a1, a2, a3⟩ := away q hr
    rw [same q a1 a2 a3]; exact scratch _ h
  have temps : ∀ p ∈ longPairs20s j, v.basis p.2 = false := by
    intro p h
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp h; rw [List.mem_range] at hi
    have hr : 1556 ≤ (1557 + i : Nat) ∧ (1557 + i : Nat) ≤ 1602 := by omega
    obtain ⟨a1, a2, a3⟩ := away _ hr
    rw [same _ a1 a2 a3]
