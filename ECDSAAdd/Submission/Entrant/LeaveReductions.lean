  · have bc := Shadow7.bank_cases w1 (by omega) hi
    have r := Shadow7.rail_win w1 (by omega)
    unfold leaveBox; ((try unfold Wire at *); omega)
  · have pc := Shadow7.pool_cases (i := 17+k) w1 (by omega)
