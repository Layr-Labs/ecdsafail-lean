  · rw [hclose]; dsimp only; rw [hrf.2.2.1, wb_ne _ (by unfold Wire; omega),
      hv_bs _ (by unfold Wire; omega) (by unfold Wire; omega)]; exact hbs.2.2.2.2.2.2.1
  · rw [hclose]; dsimp only; rw [hrf.2.2.2.1, wb_ne _ (by unfold Wire; omega)]; exact hv3
  · rw [hclose]; dsimp only; rw [hrf.2.2.2.2.1, wb_ne _ (by unfold Wire; omega), hv7]; exact hvp.1
  · rw [hclose]; dsimp only; rw [hrf.2.2.2.2.2, wb_ne _ (by unfold Wire; omega)]; exact hv6
  · intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
