    intro q hq
    simp only [LeaveJ7.CoreCheckpoint.rawSites, List.mem_append, List.mem_range'_1, List.mem_singleton] at hq
    rcases hq with (⟨lo, hi⟩ | ⟨lo, hi⟩) | p17
    rotate_right
