  by_cases hf : far sb 20 z
  · by_cases hu : 2 ^ sb ≤ z.u
    · refine ⟨?_, fun _ => ?_, fun _ => ?_, fun h => absurd hf h⟩
      · simp only [actualMode20, hf, hu, if_true, decide_true, Selector20.enabled20]; rfl
      · simp only [actualMode20, hf, hu, if_true, Selector20.key20]; rfl
      · simp only [actualMode20, hf, hu, if_true, decide_true, Bool.not_true, Selector20.right20]; rfl
    · refine ⟨?_, fun _ => ?_, fun _ => ?_, fun h => absurd hf h⟩
      · simp only [actualMode20, hf, hu, if_true, if_false, decide_true, Selector20.enabled20]
        exact decide_eq_true (by omega)
      · simp only [actualMode20, hf, hu, if_true, if_false, Selector20.key20]; omega
      · simp only [actualMode20, hf, hu, if_true, if_false, decide_false, Bool.not_false, Selector20.right20]
        exact decide_eq_true (by omega)
  · refine ⟨?_, fun h => absurd h hf, fun h => absurd h hf, fun _ => ?_⟩
    · simp only [actualMode20, hf, if_false, decide_false, Selector20.enabled20]; rfl
    · simp only [actualMode20, hf, if_false, Selector20.right20]; rfl

private theorem odd_eq_not_cross (d : Nat) (b : Bool) (h : d + 1 = (cross17 d).toNat + 2 * b.toNat) :
    decide (d % 2 = 1) = !cross17 d := by
  cases hc : cross17 d <;> cases b <;> rw [hc] at h <;>
    simp only [Bool.toNat_false, Bool.toNat_true, Bool.not_false, Bool.not_true,
      decide_eq_true_eq, decide_eq_false_iff_not] at h ⊢ <;> omega

private theorem bit1_eq_xor (d : Nat) (sg : Bool)
    (h : d + 1 = (cross17 d).toNat + 2 * (!(cross17 d && sg)).toNat) :
    ((((true ^^ !cross17 d) ^^ sg) ^^ (!cross17 d && sg)) = (d / 2 % 2 == 1)) := by
  cases hc : cross17 d <;> cases sg <;> rw [hc] at h <;>
    simp only [Bool.toNat_false, Bool.toNat_true, Bool.not_false, Bool.not_true,
      Bool.true_and, Bool.false_and, Bool.true_xor, Bool.false_xor] at h ⊢
  · have hd : d = 1 := by omega
    rw [hd]; rfl
  · have hd : d = 1 := by omega
    rw [hd]; rfl
  · have hd : d = 2 := by omega
    rw [hd]; rfl
  · have hd : d = 0 := by omega
    rw [hd]; rfl

theorem trueControls20 (j : Fin 9) (z : SkywalkNat.State) (small : Small20 (sbP20 (start20 j)) z)
    (odd : z.v % 2 = 1) (room : high (sbP20 (start20 j)) 20 z + 1 < 2 ^ wpP20 (start20 j))
    (v : BasisState)
    (bits : ∀ i < 21, v (a0P20 (start20 j) + i) = (TrueMiddle20.X j z).testBit i)
    (par : parityBits20 (ports20 j) v = oddBits (letters 20 (TrueMiddle20.r j z))) :
    let k := actualMode20 (sbP20 (start20 j)) z
    sym20 j k v 300 = (if far (sbP20 (start20 j)) 20 z then !cross17 (TrueMiddle20.d j z) else false) ∧
    sym20 j k v 1602 = (sym20 j k v 300 && sym20 j k v 1601) ∧
    (far (sbP20 (start20 j)) 20 z → sym20 j k v 1601 =
      (!(decide (2 ^ sbP20 (start20 j) ≤ z.u)) && IntegerHigh.negative (oddBits (letters 20 (TrueMiddle20.r j z))))) ∧
    sym20 j k v 301 = Selector20.nearby20 k := by
  let k := actualMode20 (sbP20 (start20 j)) z
  have hmp := actualMode20_props (sbP20 (start20 j)) z
  have h300 : sym20 j k v 300 = (Selector20.crossing20 Selector20.canonPorts k).read (fun w => v (σ20 j w)) := by
    change (sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k)
      Selector20.canonPorts.crossing).read (fun w => v (σ20 j w)) = _
    rw [(Selector20.selector20_certs k).2.2.1]
  have h1601 : sym20 j k v 1601 = (Selector20.signExpr20 Selector20.canonPorts k).read (fun w => v (σ20 j w)) := by
    unfold sym20; rw [(Selector20.selector20_certs k).2.2.2.1]
  have h1602 : sym20 j k v 1602 = (sym20 j k v 300 && sym20 j k v 1601) := by
    rw [h300, h1601]; unfold sym20
    rw [(Selector20.selector20_certs k).2.2.2.2.1, read_conj]
  have h301 : sym20 j k v 301 = Selector20.nearby20 k := by
    change (sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k)
      Selector20.canonPorts.near).read (fun w => v (σ20 j w)) = _
    rw [(Selector20.selector20_certs k).2.1]; rfl
  refine ⟨?_, h1602, ?_, h301⟩
  · rw [h300]
    by_cases hf : far (sbP20 (start20 j)) 20 z
    · have hk_en : Selector20.enabled20 k = true := hmp.1.trans (decide_eq_true hf)
      have hk_key : Selector20.key20 k = (TrueMiddle20.key j z).val := hmp.2.1 hf
      have hk_lt : Selector20.key20 k < 21 := by rw [hk_key]; exact (TrueMiddle20.key j z).isLt
      have hσu : σ20 j (200 + Selector20.key20 k) = a0P20 (start20 j) + Selector20.key20 k := by
        unfold σ20; simp only [Wire] at *
        rw [if_neg (by omega), if_pos (by omega)]
        congr 1; omega
      rw [Selector20.crossing20, hk_en, if_pos rfl, Expr.read, Selector20.canonPorts, hσu, bits _ hk_lt, if_pos hf, hk_key]
      rw [Nat.testBit_eq_decide_div_mod_eq]
      change decide (TrueMiddle20.d j z % 2 = 1) = !cross17 (TrueMiddle20.d j z)
      exact odd_eq_not_cross (TrueMiddle20.d j z) (!TrueMiddle20.neg j z)
        (far_result20 (sbP20 (start20 j)) (wpP20 (start20 j)) z small hf odd room).1
    · have hk_en : Selector20.enabled20 k = false := hmp.1.trans (decide_eq_false hf)
      rw [Selector20.crossing20, hk_en, if_neg (by decide), if_neg hf]; rfl
  · intro hf
    rw [h1601]
    have hk_key : Selector20.key20 k = (TrueMiddle20.key j z).val := hmp.2.1 hf
    by_cases hu : 2 ^ sbP20 (start20 j) ≤ z.u
    · have hrt : Selector20.right20 k = false := (hmp.2.2.1 hf).trans (by rw [decide_eq_true hu]; rfl)
      rw [Selector20.signExpr20, hrt, Bool.false_and, if_neg (by decide), decide_eq_true hu]; rfl
    · have hrt : Selector20.right20 k = true := (hmp.2.2.1 hf).trans (by rw [decide_eq_false hu]; rfl)
      have hrails := (rail20 (sbP20 (start20 j)) z (small.1 hf) hf).2 (Nat.lt_of_not_ge hu)
      have heq : TrueMiddle20.r j z = ⟨z.u, (TrueMiddle20.r j z).v⟩ := SkywalkNat.State.ext hrails.1 rfl
      have hlead : IntegerHigh.lead (oddBits (letters 20 (TrueMiddle20.r j z))) = Selector20.key20 k := by
        have hg' := hrails.2.2; rw [hrails.1] at hg'
        rw [heq, lead_wait 20 _ _ hg', hk_key]
        simp only [TrueMiddle20.key, if_neg hu]
      rw [decide_eq_false hu, Bool.not_false, Bool.true_and, Selector20.signExpr20, hrt, Bool.true_and,
        IntegerHigh.negative, hlead]
      by_cases hz : 0 < Selector20.key20 k
      · simp only [hz, decide_true, if_true, Bool.true_and, Selector20.suffixExpr20]
        rw [fold_suffix20_aux, Expr.read, Bool.true_and, ← par, parityBits20, ← List.map_drop, List.all_map]
        rw [Bool.eq_iff_iff, List.all_eq_true, List.all_eq_true]
        refine forall_congr' fun i => imp_congr_right fun hi => ?_
        have hi20 : i < 20 := List.mem_range.mp (List.mem_of_mem_drop hi)
        have hσg : σ20 j (100 + i) = start20 j + 16 + i := by
          unfold σ20; simp only [Wire]; rw [if_pos (by omega)]; congr 1; omega
        simp only [Selector20.canonPorts, ports20, Function.comp, id_eq, hσg]
      · simp only [hz, decide_false, if_false, Bool.false_and]; rfl

theorem middle20_adjust_nodup (j : Fin 9) :
