private theorem lowOdd_bits_away :
    ∀ b ∈ lowCorrectionOdd converterLayout760, ∀ q ∈ b.wire,
      q ∉ converterLayout760.cin :: converterLayout760.low ++ converterLayout760.carry.take 254 := by
