  have oc := LowZero18KG.clear_counts (LowZero18LowK.kgS K0 E0 src dst) wOld
  have pm := LowZero18Square.patchKG_counts K0 (LowZero18LowK.kg K0 E0 src dst)
  let K :=
    { LowZero18LowK.kgH K0 E0 src dst with
