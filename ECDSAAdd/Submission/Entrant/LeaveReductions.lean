    · intro ab hab; obtain ⟨y, hy, he⟩ := List.mem_map.mp hab
      have h1 : ab.1 = y := by rw [← he]
      rw [h1]; exact hOut y hy
    · exact loopB_pairs_free
  rw [hEq]; exact r

