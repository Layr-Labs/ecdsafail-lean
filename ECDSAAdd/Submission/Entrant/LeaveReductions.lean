/-! ### Section 5: 20-Tick Pending History, `whole20_result` & `leave20_keeps` -/

theorem pending20 (f u : Bool) (xs : List (Bool × Bool)) (w : Fin 21) (len : xs.length = 20)
    (ok : f = true → StairArchiveTrace.chain u xs)
    (read : f = true → u = false → ∀ i (h : i < xs.length), i ≤ w.val → xs[i].2 = decide (i = w.val)) :
    let k : Selector20.Mode20 := if f then (if u then 1 else ⟨2 + w.val, by have := w.isLt; omega⟩) else 0
    Selector20.nearby20 k = (f && StairArchiveTrace.afterFlags u (xs.take 10)) ∧
      ((f && u) ^^ (Selector20.nearby20 k && !(xs.take 10).any Prod.snd)) = false := by
  cases f with
  | false => simp [Selector20.nearby20, Selector20.enabled20]
  | true =>
    have b : w.val ≤ xs.length := by rw [len]; have := w.isLt; omega
    have hword := LeavePendingHistory.firstBits (xs.map Prod.snd) 10 (by simp [len])
    rw [← List.map_take, List.any_map] at hword
    change (xs.take 10).any Prod.snd = decide ((xs.map Prod.snd).idxOf true < 10) at hword
    cases u with
    | true =>
      simp only [LeavePendingHistory.traceFlags true xs 10 (ok rfl),
        LeavePendingHistory.initialTrue xs (ok rfl) 10]
      simp [Selector20.nearby20, Selector20.enabled20, Selector20.key20]
    | false =>
      have hidx := LeavePendingHistory.firstExchangeIndex xs w.val b (read rfl rfl)
      rw [hidx] at hword
      simp only [LeavePendingHistory.traceFlags false xs 10 (ok rfl), hword]
      simp [Selector20.nearby20, Selector20.enabled20, Selector20.key20]

theorem lowClose20_result (j : Fin 9) (s v : State) (m : List Bool) (G sign : Bool)
    (sum mag : Nat) (previous : s.basis (start20 j + 35) = G)
    (hist : ∀ q ∈ history20 j, v.basis q = !s.basis q)
    (signed : v.basis (e0P20 (start20 j) + 5) = sign)
    (words : ∀ i : Fin (lowsP20 (start20 j) + 1),
      v.basis (a0P20 (start20 j) - 1 + i.val) = sum.testBit (sbP20 (start20 j) + i.val) ∧
      v.basis (b0P20 (start20 j) - 1 + i.val) = mag.testBit (sbP20 (start20 j) + i.val)) :
