          have hcf := hc.2.2.1 ⟨p - (b0P20 (start20 j) + 20), by omega⟩; dsimp only at hcf; rwa [hfr] at hcf
  have hfl := src20_flags_back j; dsimp only at hfl
  have hR : railP (start20 j + 20) ≤ railP (start20 j) ∧ railP (start20 j) ≤ railP (start20 j + 20) + 20 := by
