  have midEq : run KnownAMidStaged.body (m.drop (measurementCount (ReorderedAPlain.build ReorderedAFixed.acc ReorderedAFixed.pad ReorderedAFixed.bank ReorderedAFixed.L.core.cin ReorderedAFixed.src)))
