private theorem nextFlag20_orientation (j : Fin 9) (a : SkywalkNat.State) (sign : Nat) (bit : sign ≤ 1)
    (small : Shadow7.SmallIfFar (nextSb20 (start20 j)) (nextLen20 j) a)
    (hfar : far (nextSb20 (start20 j)) (nextLen20 j) a) :
    (2 ^ sbP20 (start20 j) ≤ a.u - sign) ↔ (2 ^ nextSb20 (start20 j) ≤ a.u) := by
  have hsm := small hfar
  have tg := tail20_geom j; dsimp only at tg
  have lower := (Nat.le_div_iff_mul_le (by unfold limb; positivity : 0 < limb (nextSb20 (start20 j)) (nextLen20 j))).mp hfar
  unfold limb at lower
  have hpow : 2 ^ (nextSb20 (start20 j) + nextLen20 j + 1) =
      2 ^ (nextLen20 j + 1) * 2 ^ nextSb20 (start20 j) := by
    rw [show nextSb20 (start20 j) + nextLen20 j + 1 = nextSb20 (start20 j) + (nextLen20 j + 1) by omega,
      Nat.pow_add, Nat.mul_comm]
  rw [hpow] at lower
  have hL : 2 ^ 16 ≤ 2 ^ (nextLen20 j + 1) := by
    apply Nat.pow_le_pow_right (by decide); unfold nextLen20; split <;> omega
  rcases tg.2.1 with h10 | h7
  · have p1 : 2 ^ sbP20 (start20 j) = 1024 * 2 ^ nextSb20 (start20 j) := by
      rw [h10, Nat.pow_add, Nat.mul_comm]
    rw [p1]
    have hbig : 2 ^ 16 * 2 ^ nextSb20 (start20 j) ≤ 2 ^ (nextLen20 j + 1) * 2 ^ nextSb20 (start20 j) :=
      Nat.mul_le_mul_right _ hL
    generalize 2 ^ nextSb20 (start20 j) = P at *
    constructor <;> intro h <;> omega
  · have p1 : 2 ^ sbP20 (start20 j) = 128 * 2 ^ nextSb20 (start20 j) := by
      rw [h7, Nat.pow_add, Nat.mul_comm]
    rw [p1]
    have hbig : 2 ^ 16 * 2 ^ nextSb20 (start20 j) ≤ 2 ^ (nextLen20 j + 1) * 2 ^ nextSb20 (start20 j) :=
      Nat.mul_le_mul_right _ hL
    generalize 2 ^ nextSb20 (start20 j) = P at *
    constructor <;> intro h <;> omega

private theorem nextFlag20_boundNear (j : Fin 9) (a : SkywalkNat.State) (sign : Nat)
    (near : ¬ far (nextSb20 (start20 j)) (nextLen20 j) a) :
    a.u - sign < (2 * 2 ^ sbP20 (start20 j)) * 2 ^ (smallM20 j).length := by
  have tg := tail20_geom j; dsimp only at tg
  have lo : (a.u + a.v) / limb (nextSb20 (start20 j)) (nextLen20 j) < 2 := Nat.lt_of_not_ge near
  have lim := (Nat.div_lt_iff_lt_mul (by unfold limb; positivity)).mp lo
  unfold limb at lim
  have hlen : (smallM20 j).length = lowsP20 (start20 j) := by simp [smallM20]
  rw [hlen]
  have he : 2 * 2 ^ sbP20 (start20 j) * 2 ^ lowsP20 (start20 j) =
      2 * (2 * 2 ^ (nextSb20 (start20 j) + nextLen20 j + 1)) := by
    rw [show 2 * 2 ^ sbP20 (start20 j) * 2 ^ lowsP20 (start20 j) = 2 ^ (sbP20 (start20 j) + lowsP20 (start20 j) + 1) by
          rw [Nat.pow_succ, Nat.pow_add]; ring,
        show 2 * (2 * 2 ^ (nextSb20 (start20 j) + nextLen20 j + 1)) = 2 ^ (nextSb20 (start20 j) + nextLen20 j + 3) by
          rw [Nat.pow_succ, Nat.pow_succ]; ring]
    congr 1; omega
  rw [he]; omega

private theorem clearFlag20_digits (j : Fin 9) :
    PortalAnd.digits 1558 (clearFlagPairs20 j) = 1558 :: (b0P20 (start20 j) - 1) :: smallM20 j := by
  simp only [PortalAnd.digits, clearFlagPairs20, smallM20, List.map_map, Function.comp]
  rw [List.range_succ_eq_map, List.map_cons, List.map_map]
  simp only [Function.comp, Nat.add_zero]
  congr 2
