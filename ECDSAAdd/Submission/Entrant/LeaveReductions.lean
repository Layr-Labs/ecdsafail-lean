section

/-!
# 22-Bank Mixed-Window Stock & Field Geometry (`MixedGeo`, `MixedArchiveSuffix`)

Replaces uniform 25-bank `StockWindowGeo` / `ArchiveStockSuffixW` geometry for the
mixed 15/20-tick window over ticks `[45, 420]`:
- **22 field archive banks**:
  `bankList = [10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 70, 73, 76, 79, 82]`
  covering `44` archived 5-tick groups (`packed`) and `32` plain 5-tick groups (`plain`)
  partitioning all `76` five-tick groups in `[40, 420)`.
- Every bank `b : Fin 22` has:
  - `groupId b = bankList.getD b.val 0`,
  - `bankTick b = 5 * groupId b - 5` (chronology start tick for `ArchiveStockRows.Chronology`),
  - `endTick b = 5 * groupId b + 10` (archive tick; 10 archived ticks `[5 * groupId b, endTick b)`),
  - `bankSite b j = (Partial.cellsRestoreP (endTick b)).getD j 0`,
  - exact port identity with `StairArchiveRelease.fieldPort (groupId b)`, `ArchiveJ7`/`Archive150`/`ArchiveJ20`/`ExitPorts420`,
    `Stair44WalkMap.rest`, `Rolling1588Lifetime.phaseHost`, and `NewHistory5.payloadWire`.
- `MixedArchiveSuffix`: proves all 22 archive banks (`352` cells) are untouched by the stock
  forward/reverse suffix ticks `[421, 512)`.
-/

namespace ECDSAAdd.Entrant.StairPacket.Shadow20.MixedGeo

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Partial
open ECDSAAdd.Entrant.StairPacket.ArchivePortAction

set_option maxRecDepth 25000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

/-- The 22 active field archive banks for the mixed 15/20-tick `[45, 420]` window. -/
def bankList : List Nat :=
  [10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 70, 73, 76, 79, 82]

abbrev Bank := Fin 22

def groupId (b : Bank) : Nat := bankList.getD b.val 0

/-- Chronology start tick (`5 * groupId b - 5`) matching `ArchiveStockRows.Chronology`. -/
def bankTick (b : Bank) : Nat := 5 * groupId b - 5

/-- Archive restoration tick (`5 * groupId b + 10`; archived 10 ticks are `[5 * groupId b, endTick b)`). -/
def endTick (b : Bank) : Nat := 5 * groupId b + 10

/-- Start tick of 5-tick pack group `i ∈ 0..75` over `[40, 420)`. -/
def gstart (i : Nat) : Nat := 40 + 5 * i

def slot (i : Nat) : Fin 10 → Wire := History5.historyMap base (gstart i)

/-- The 44 archived 5-tick groups (2 per bank: `groupId b - 8` and `groupId b - 7`). -/
def packed : List Nat :=
  (List.finRange 22).flatMap fun b => [groupId b - 8, groupId b - 7]

/-- The 32 plain 5-tick groups packed natively by the mixed window. -/
def plain : List Nat :=
  (List.range 76).filter fun i => !packed.contains i

/-- The 88 erased B-side hole wires (letters 5 and 9 of each archived group). -/
def holes : List Wire :=
  packed.flatMap fun i => [base (1028 + gstart i + 2), base (1028 + gstart i + 4)]

def logical (sw : Bool) (r : Nat) : Wire := if sw then base (1028 + r) else base r
def site (e : Nat) (sw : Bool) (r : Nat) : Wire := OB5.sig e (logical sw r)
def offset (j : Fin 16) : Nat := 5 * (j.val / 8) + [0, 0, 1, 1, 2, 3, 3, 4].getD (j.val % 8) 0
def swap (j : Fin 16) : Bool := j.val % 8 ∈ [1, 3, 6]
def index (j : Fin 16) : Fin 10 := ⟨if j.val % 8 < 5 then j.val % 8 else j.val % 8 + 1, by split <;> omega⟩

def groupOf (b : Bank) (j : Fin 16) : Nat := groupId b - 8 + j.val / 8

/-- Lookup bank index `b : Bank` owning archived group `i ∈ packed`. -/
def bankOf (i : Nat) : Bank :=
  match (List.finRange 22).find? (fun b => i == groupId b - 8 || i == groupId b - 7) with
  | some b => b
  | none => ⟨0, by decide⟩

def packet (i : Nat) : Nat := bankTick (bankOf i)
def high (i : Nat) : Bool := decide (i = groupId (bankOf i) - 7)
def tile (k : Nat) (hi : Bool) : Nat := k + 5 + (if hi then 5 else 0)

/-- Code cell `j` of bank `b` (`cellsRestoreP (endTick b)`). -/
def bankSite (b : Bank) (j : Fin 16) : Wire := (Partial.cellsRestoreP (endTick b)).getD j 0

/-- All `22 × 16 = 352` archive code cells of the mixed window. -/
def archives : List Wire :=
  (List.finRange 22).flatMap fun b => (List.finRange 16).map (bankSite b)

/-- Unified 157-port descriptor for bank `b : Fin 22`. -/
def bankPorts (exitPorts : Ports) (b : Bank) : Ports :=
  if h1 : b.val < 7 then ArchiveJ7.codePorts ⟨b.val, by omega⟩
  else if h2 : b.val = 7 then Archive150.codePorts
  else if h3 : b.val < 17 then ArchiveJ20.codePorts ⟨b.val - 8, by omega⟩
  else if h4 : b.val < 21 then ArchiveJ7.codePorts ⟨b.val + 3, by omega⟩
  else exitPorts

def siteAt (exitPorts : Ports) (b : Bank) (j : Fin 16) : Wire :=
  bankPorts exitPorts b ⟨j.val, by omega⟩

theorem stable (i e r : Nat) (hi : i ≤ 511) (he : e ≤ 511) (ri : r < i) (re : r < e) (sw : Bool) :
    OB5.sig i (logical sw r) = site e sw r := by
  show OB5.sigNat i (logical sw r) = OB5.sigNat e (logical sw r)
  cases sw <;> simp only [logical, base, Bool.false_eq_true, if_false, if_true, OB5.sigNat] <;>
    split_ifs with h1 h2 h2 <;> (try rcases h1 with h1 | h1) <;> (try rcases h2 with h2 | h2) <;> omega

theorem cells (t : Nat) (lo : 10 ≤ t) (hi : t ≤ 511) (j : Fin 16) :
    (Partial.cellsRestoreP t).getD j 0 = OB5.sig t (logical (swap j) (t - 10 + offset j)) := by
  show _ = OB5.sigNat t (logical (swap j) (t - 10 + offset j))
  rcases j with ⟨j, hj⟩
  interval_cases j <;>
    simp only [Partial.cellsRestoreP, List.getD_cons_zero, List.getD_cons_succ, logical, swap, offset, base,
      OB5.sig_nat, List.mem_cons, List.not_mem_nil, or_false, List.getD, List.getElem?_cons_zero,
      List.getElem?_cons_succ, Option.getD_some] <;>
    first | rfl | (simp only [OB5.sigNat]; split_ifs with h1 h2 <;> (try rcases h1 with h1 | h1) <;>
      (try rcases h2 with h2 | h2) <;> omega) | (norm_num [OB5.sigNat]; split_ifs <;> omega)

private theorem bank_bounds : ∀ b : Bank,
    10 ≤ groupId b ∧ groupId b ≤ 82 ∧
    endTick b ≤ 420 ∧
    endTick b = bankTick b + 15 ∧
    bankOf (groupId b - 8) = b ∧
    bankOf (groupId b - 7) = b := by
  decide +kernel

theorem bank_site (b : Bank) (j : Fin 16) :
    bankSite b j = site 420 (swap j) (bankTick b + 5 + offset j) ∧ bankTick b + 5 + offset j < 420 := by
  have hb := bank_bounds b
  have ho : offset j ≤ 9 := by rcases j with ⟨j, hj⟩; interval_cases j <;> simp [offset]
  refine ⟨?_, by omega⟩
  rw [bankSite, cells _ (by unfold endTick; omega) (by omega)]
  rw [show endTick b - 10 + offset j = bankTick b + 5 + offset j by omega]
  exact stable _ 420 _ (by omega) (by decide) (by omega) (by omega) _

theorem chart (b : Bank) (j : Fin 16) :
    bankSite b j = OB5.sig 420 (slot (groupOf b j) (index j)) ∧
    packet (groupOf b j) = bankTick b ∧
    groupOf b j ∈ packed ∧
    high (groupOf b j) = decide (8 ≤ j.val) := by
  have hb := bank_bounds b
  have bs := (bank_site b j).1
  have hdiv : j.val / 8 = 0 ∨ j.val / 8 = 1 := by have := j.isLt; omega
  have hbo : bankOf (groupOf b j) = b := by
    unfold groupOf
    rcases hdiv with h0 | h1
    · rw [h0, Nat.add_zero]; exact hb.2.2.2.2.1
    · rw [h1, show groupId b - 8 + 1 = groupId b - 7 by omega]; exact hb.2.2.2.2.2
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [bs, site]; congr 1
    have hgt : bankTick b + 5 = 5 * groupId b := by unfold bankTick; omega
    rcases j with ⟨j, hj⟩
    interval_cases j <;>
      simp [logical, swap, offset, slot, History5.historyMap, History5.historyId, index, groupOf, gstart, base] <;>
      omega
  · simp only [packet, hbo]
  · simp only [packed, groupOf, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false]
    exact ⟨b, by rcases hdiv with h0 | h1 <;> omega⟩
  · unfold high; rw [hbo]; unfold groupOf
    congr 1; apply propext; have := j.isLt; omega

theorem bank_mem (b : Bank) (j : Fin 16) : bankSite b j ∈ archives := by
  simp only [archives, List.mem_flatMap, List.mem_finRange, List.mem_map, true_and]
  exact ⟨b, j, rfl⟩

theorem archive_old : ∀ q ∈ archives, ∃ sw r, r < 420 ∧ q = site 420 sw r := by
  intro q hq
  simp only [archives, List.mem_flatMap, List.mem_finRange, List.mem_map, true_and] at hq
  obtain ⟨b, j, rfl⟩ := hq
  obtain ⟨eq, lt⟩ := bank_site b j
  exact ⟨_, _, lt, eq⟩

theorem sparse : ∀ i ∈ packed, ∀ j : Fin 10,
    (j = 5 ∨ j = 9) ∧ slot i j ∈ holes ∨ OB5.sig 420 (slot i j) ∈ archives := by
  intro i hi j
  have hi' := hi
  simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false] at hi'
  obtain ⟨b, hib⟩ := hi'
  have hb := bank_bounds b
  by_cases hole : j = 5 ∨ j = 9
  · left
    refine ⟨hole, ?_⟩
    simp only [holes, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false]
    refine ⟨i, hi, ?_⟩
    rcases hole with rfl | rfl
    · left; simp [slot, History5.historyMap, History5.historyId, base]
    · right; simp [slot, History5.historyMap, History5.historyId, base]
  · right
    let hiBit : Nat := if i = groupId b - 8 then 0 else 1
    let k : Nat := 8 * hiBit + (if j.val < 5 then j.val else j.val - 1)
    have hk : k < 16 := by have := j.isLt; simp only [k, hiBit]; split <;> split <;> omega
    have gi : groupOf b ⟨k, hk⟩ = i := by
      have hjlt := j.isLt
      have h9 : j.val ≠ 9 := fun h => hole (Or.inr (Fin.ext h))
      simp only [groupOf, k, hiBit]
      rcases hib with rfl | rfl <;> (split_ifs <;> omega)
    have ij : index ⟨k, hk⟩ = j := by
      apply Fin.ext; simp only [index, k, hiBit]
      have := j.isLt
      have h5 : j.val ≠ 5 := fun h => hole (Or.inl (Fin.ext h))
      have h9 : j.val ≠ 9 := fun h => hole (Or.inr (Fin.ext h))
      split <;> split <;> split <;> omega
    have c := (chart b ⟨k, hk⟩).1
    rw [gi, ij] at c
    rw [← c]
    exact bank_mem b _

theorem hole_slot : ∀ q ∈ holes, ∃ i ∈ packed, ∃ j : Fin 10, q = slot i j := by
  intro q hq
  simp only [holes, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hq
  obtain ⟨i, hi, e | e⟩ := hq
  · exact ⟨i, hi, 5, by simp [e, slot, History5.historyMap, History5.historyId, base]⟩
  · exact ⟨i, hi, 9, by simp [e, slot, History5.historyMap, History5.historyId, base]⟩

theorem distinct (i h : Nat) (hi : gstart i + 5 ≤ 1028) (hh : gstart h + 5 ≤ 1028)
    (ne : i ≠ h) (a b : Fin 10) : slot i a ≠ slot h b := by
  have := a.isLt; have := b.isLt
  intro eq
  have e2 : History5.historyId (gstart i) a + 16 = History5.historyId (gstart h) b + 16 := eq
  simp only [History5.historyId, gstart] at e2 hi hh
  split_ifs at e2 <;> omega

theorem split_all (i : Nat) (hi : i < 76) : i ∈ plain ∨ i ∈ packed := by
  by_cases hp : packed.contains i
  · right; exact List.contains_iff_mem.mp hp
  · left
    simp only [plain, List.mem_filter, List.mem_range, Bool.not_eq_true', Bool.eq_false_iff]
    exact ⟨hi, hp⟩

theorem plain_nodup : plain.Nodup := List.Nodup.filter _ List.nodup_range

theorem packed_lt {i : Nat} (h : i ∈ packed) : i < 76 := by
  simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false] at h
  obtain ⟨b, hb⟩ := h
  have bnd := bank_bounds b
  omega

theorem plain_lt {i : Nat} (h : i ∈ plain) : i < 76 :=
  List.mem_range.mp (List.mem_filter.mp h).1

theorem packed_chart {i : Nat} (hi : i ∈ packed) :
    gstart i = tile (packet i) (high i) ∧
    45 ≤ packet i ∧ packet i + 15 ≤ 420 ∧
    ∃ b : Bank, packet i = bankTick b := by
  simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false] at hi
  obtain ⟨b, rfl | rfl⟩ := hi
  · have hb := bank_bounds b
    refine ⟨?_, ?_, ?_, b, ?_⟩
    · simp only [gstart, tile, packet, high, hb.2.2.2.2.1, bankTick]
      rw [decide_eq_false (by omega), if_neg Bool.false_ne_true]; omega
    · simp only [packet, hb.2.2.2.2.1, bankTick]; omega
    · simp only [packet, hb.2.2.2.2.1]; omega
    · simp only [packet, hb.2.2.2.2.1]
  · have hb := bank_bounds b
    refine ⟨?_, ?_, ?_, b, ?_⟩
    · simp only [gstart, tile, packet, high, hb.2.2.2.2.2, bankTick, decide_true, if_true]; omega
    · simp only [packet, hb.2.2.2.2.2, bankTick]; omega
    · simp only [packet, hb.2.2.2.2.2]; omega
    · simp only [packet, hb.2.2.2.2.2]

theorem site_eq (exitPorts : Ports)
    (exitCells : ∀ j : Fin 16, exitPorts ⟨j.val, by omega⟩ = (Partial.cellsRestoreP 420).getD j 0)
    (b : Bank) (j : Fin 16) : siteAt exitPorts b j = bankSite b j := by
  simp only [siteAt, bankPorts, bankSite]
  split_ifs with h1 h2 h3 h4
  · have hw : ArchiveJ7.codePorts ⟨b.val, by omega⟩ ⟨j.val, by omega⟩ =
        (Partial.cellsRestoreP (start ⟨b.val, by omega⟩ + 15)).getD j 0 := by
      rw [ArchiveJ7.codePorts, ArchiveJ7.code_split, List.append_assoc,
        List.getD_append _ _ _ _ (by simp [Partial.cellsRestoreP])]
    rw [hw]; congr 2
    rcases b with ⟨bv, hbv⟩; interval_cases bv <;> rfl
  · rw [Archive150.head_port_eq j]; congr 2
    rcases b with ⟨bv, hbv⟩; subst h2; rfl
  · rw [ArchiveJ20.head_port_eq ⟨b.val - 8, by omega⟩ j]; congr 2
    rcases b with ⟨bv, hbv⟩; simp only at h1 h2 h3; interval_cases bv <;> first | rfl | omega
  · have hw : ArchiveJ7.codePorts ⟨b.val + 3, by omega⟩ ⟨j.val, by omega⟩ =
        (Partial.cellsRestoreP (start ⟨b.val + 3, by omega⟩ + 15)).getD j 0 := by
      rw [ArchiveJ7.codePorts, ArchiveJ7.code_split, List.append_assoc,
        List.getD_append _ _ _ _ (by simp [Partial.cellsRestoreP])]
    rw [hw]; congr 2
    rcases b with ⟨bv, hbv⟩; simp only at h1 h2 h3 h4; interval_cases bv <;> rfl
  · rw [exitCells j]; congr 2
    have hb21 : b.val = 21 := by have := b.isLt; omega
    rcases b with ⟨bv, hbv⟩; subst hb21; rfl

theorem bank_rep (exitPorts : Ports)
    (exitCells : ∀ j : Fin 16, exitPorts ⟨j.val, by omega⟩ = (Partial.cellsRestoreP 420).getD j 0)
    (q : Wire) (h : q ∈ archives) : ∃ (b : Bank) (j : Fin 16), siteAt exitPorts b j = q := by
  simp only [archives, List.mem_flatMap, List.mem_finRange, List.mem_map, true_and] at h
  obtain ⟨b, j, rfl⟩ := h
  exact ⟨b, j, site_eq exitPorts exitCells b j⟩

/-- Port-by-port identity with field banks, walk maps, parity ports, and pool bounds. -/
theorem field_ports : ∀ (b : Bank) (i : Fin 16),
    StairArchiveRelease.fieldPort (groupId b) i.val = bankSite b i := by
  decide +kernel

theorem parity_ports : ∀ (b : Bank) (i : Fin 16),
    OB5.sig 511 (NewHistory5.payloadWire base (8 * groupId b + i.val)) = bankSite b i := by
  decide +kernel

theorem fixed_rest : ∀ (b : Bank) (i : Fin 16),
    Stair44WalkMap.rest (bankSite b i) = bankSite b i := by
  decide +kernel

theorem fixed_phaseHost : ∀ (b : Bank) (i : Fin 16),
    Rolling1588Lifetime.phaseHost (bankSite b i) = bankSite b i := by
  decide +kernel

theorem fixed_fieldPlace : ∀ (b : Bank) (i : Fin 16),
    StairOuterPlacement.fieldPlace (bankSite b i) = bankSite b i := by
  decide +kernel

theorem sites_in_pool : ∀ (b : Bank) (i : Fin 16),
    16 ≤ bankSite b i ∧ bankSite b i ≤ 1812 := by
  decide +kernel

/-- Field-bank index set (`Finset Nat`) and inverse lookup from `groupId`. -/
def bankIds : Finset Nat :=
  {10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 70, 73, 76, 79, 82}

def bankOfGroup (j : Nat) : Bank :=
  match (List.finRange 22).find? (fun b => groupId b == j) with
  | some b => b
  | none => ⟨0, by decide⟩

def fieldRows (r : Bank → Nat) (j : Nat) : Nat := r (bankOfGroup j)

theorem rowsAt (r : Bank → Nat) (b : Bank) : fieldRows r (groupId b) = r b := by
  have h : ∀ k : Bank, bankOfGroup (groupId k) = k := by decide +kernel
  rw [fieldRows, h b]

theorem idAt : ∀ j ∈ bankIds, ∃ b : Bank, groupId b = j := by decide +kernel

theorem mem_bankIds : ∀ b : Bank, groupId b ∈ bankIds := by decide +kernel

theorem whole_iff (q : Wire) :
    q ∈ bankIds.biUnion (fun j => (Finset.range 16).image (StairArchiveRelease.fieldPort j)) ↔
      q ∈ archives := by
  simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_range, archives,
    List.mem_flatMap, List.mem_finRange, List.mem_map, true_and]
  constructor
  · rintro ⟨j, hj, i, hi, rfl⟩
    obtain ⟨b, rfl⟩ := idAt j hj
    exact ⟨b, ⟨i, hi⟩, (field_ports b ⟨i, hi⟩).symm⟩
  · rintro ⟨b, i, rfl⟩
    exact ⟨groupId b, mem_bankIds b, i.val, i.isLt, field_ports b i⟩

/-- History cells of ticks `[t, t + 10)` for census proofs. -/
def cells10 (t : Nat) : List Wire := (List.range' t 10).flatMap fun r => [base r, base (1028 + r)]

theorem cell_letter (b : Bank) (a : Nat) (ha : a < 10) :
    base (bankTick b + 5 + a) = slot (groupId b - 8 + a / 5) ⟨2 * (a % 5), by omega⟩ ∧
    base (1028 + (bankTick b + 5 + a)) = slot (groupId b - 8 + a / 5) ⟨2 * (a % 5) + 1, by omega⟩ := by
  have hb := bank_bounds b
  have hgt : bankTick b + 5 = 5 * groupId b := by unfold bankTick; omega
  simp only [slot, History5.historyMap, History5.historyId, gstart, Fin.val_mk]
  constructor
  · rw [if_pos (by omega)]; congr 1; omega
  · rw [if_neg (by omega)]; congr 1; omega

theorem cells_census (b : Bank) :
    ∀ w ∈ cells10 (endTick b - 10), w ∈ holes ∨ OB5.sig 420 w ∈ archives := by
  have hb := bank_bounds b
  intro w hw
  simp only [cells10, List.mem_flatMap, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false] at hw
  obtain ⟨r, ⟨r1, r2⟩, e⟩ := hw
  have hstart : endTick b - 10 = bankTick b + 5 := by omega
  let a := r - (bankTick b + 5)
  have ha : a < 10 := by omega
  have hr : bankTick b + 5 + a = r := by omega
  have hi : groupId b - 8 + a / 5 ∈ packed := by
    simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false]
    exact ⟨b, by omega⟩
  have cl := cell_letter b a ha
  rw [hr] at cl
  have sp := sparse _ hi
  rcases e with rfl | rfl
  · rw [cl.1]
    rcases sp ⟨2 * (a % 5), by omega⟩ with ⟨_, h⟩ | h
    · exact Or.inl h
    · exact Or.inr h
  · rw [cl.2]
    rcases sp ⟨2 * (a % 5) + 1, by omega⟩ with ⟨_, h⟩ | h
    · exact Or.inl h
    · exact Or.inr h

end ECDSAAdd.Entrant.StairPacket.Shadow20.MixedGeo

namespace ECDSAAdd.Entrant.StairPacket.Shadow20.MixedArchiveSuffix

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Shadow20.MixedGeo

set_option maxRecDepth 15000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false

private theorem no_pack (i : Nat) (lo : 421 ≤ i) (hi : i < 512) (r : Nat) (old : r < 420) (d sw : Bool) :
    logical sw r ∉ wires (Rolling1588.Integer.packFirst base d i) ∧
    logical sw r ∉ wires (Rolling1588.unpackAtTick d i) := by
  have disjoint (due : History5.packDue i = true) (j : Fin 10) :
      logical sw r ≠ History5.historyMap base (i - 5) j := by
    simp only [History5.packDue, decide_eq_true_eq] at due
    have lim := j.isLt
    cases sw <;> simp only [logical, Bool.false_eq_true, if_false, if_true,
      History5.historyMap, History5.historyId, base, Wire]
    all_goals split_ifs <;> omega
  constructor
  · intro h
    rw [Rolling1588.Integer.packFirst, if_neg (show i ≠ 5 by omega),
      Rolling1588.Integer.pack_support_eq] at h
    unfold History5.packAfter at h
    split at h
    · rename_i due
      obtain ⟨j, eq⟩ := History5.history_gate_mem base (i - 5) _ (Or.inl rfl) _ h
      exact disjoint due j eq
    · simp [wires] at h
  · intro h
    rw [← Rolling1588.Integer.unpackFirst_base, Rolling1588.Integer.unpackFirst,
      if_neg (show i ≠ 5 by omega), Rolling1588.Integer.decodeBefore_support_eq] at h
    unfold History5.decodeBefore at h
    split at h
    · rename_i due
      obtain ⟨j, eq⟩ := History5.history_gate_mem base (i - 5) _ (Or.inr rfl) _ h
      exact disjoint due j eq
    · simp [wires] at h

private theorem one (d sw : Bool) (r i : Nat) (old : r < 420) (lo : 421 ≤ i) (hi : i < 512) :
    site 420 sw r ∉ wires (renameProgram (OB5.sig i) (TickRanges.tick base i ++ Rolling1588.Integer.packFirst base d i)) ∧
    site 420 sw r ∉ wires (renameProgram (OB5.sig i) (Rolling1588.unpackAtTick d i ++ W.ReverseCarry.compactReceiverTick base i)) := by
  have past : WideReference.Earlier i (logical sw r) := ⟨r, by omega, by cases sw <;> simp [logical]⟩
  have off := WideReference.away hi past
  have pack := no_pack i lo hi r old d sw
  have pre (q : Wire) (eq : OB5.sig i q = site 420 sw r) : q = logical sw r := by
    rw [← MixedGeo.stable i 420 r (by omega) (by decide) (by omega) old sw] at eq
    exact OB5.sig_injective i (by omega) eq
  constructor <;> intro h <;> rw [renameProgram_support] at h <;>
    obtain ⟨q, mem, eq⟩ := Finset.mem_image.mp h <;> rw [pre q eq, wires_append, Finset.mem_union] at mem
  · rcases mem with tick | packet
    · exact off (List.mem_toFinset.mp (W.repairedTick_support base i hi base_pool_nodup
        (TickRanges.tick_support base i hi base_pool_nodup tick)))
    · exact pack.1 packet
  · rcases mem with packet | tick
    · exact pack.2 packet
    · exact off (List.mem_toFinset.mp (W.ReverseCarry.compactReceiverTick_support base i hi base_pool_nodup tick))

theorem suffix (d sw : Bool) (r i n : Nat) (old : r < 420) (lo : 421 ≤ i) (hi : i + n ≤ 512) :
    site 420 sw r ∉ wires (Rolling1588TickGap.forward d i n) ∧
    site 420 sw r ∉ wires (Rolling1588.reverse d i n) := by
  induction n generalizing i with
  | zero => simp [Rolling1588TickGap.forward, Rolling1588.reverse, wires]
  | succ n ih =>
    have a := one d sw r i old lo (by omega)
    have b := ih (i + 1) (by omega) (by omega)
    simp only [Rolling1588TickGap.forward, Rolling1588.reverse, wires_append, Finset.mem_union, not_or]
    exact ⟨⟨a.1, b.1⟩, ⟨b.2, a.2⟩⟩

theorem safe (d : Bool) (i n : Nat) (lo : 421 ≤ i) (hi : i + n ≤ 512) (q : Wire) (mem : q ∈ archives) :
    q ∉ wires (Rolling1588TickGap.forward d i n) ∧ q ∉ wires (Rolling1588.reverse d i n) := by
  obtain ⟨sw, r, old, rfl⟩ := archive_old q mem
  exact suffix d sw r i n old lo hi

def Same (a b : State) : Prop := a.phase = b.phase ∧ ∀ q, q ∉ archives → a.basis q = b.basis q

theorem independent (P : Program) (off : ∀ q ∈ archives, q ∉ wires P)
    (m : List Bool) (s t : State) (same : Same s t) :
    Same (run P m s) (run P m t) ∧ ∀ q ∈ archives, (run P m s).basis q = s.basis q := by
  have eqs := pool_run_agrees P (wires P) (Finset.Subset.refl _) m s t same.1
    (fun q h => same.2 q (fun mem => off q mem h))
  refine ⟨⟨eqs.1, ?_⟩, fun q mem => run_preserves_outside _ m s _ (off q mem)⟩
  intro q ext
  by_cases use : q ∈ wires P
  · exact eqs.2 q use
  · rw [run_preserves_outside _ m s _ use, run_preserves_outside _ m t _ use]
    exact same.2 q ext

end ECDSAAdd.Entrant.StairPacket.Shadow20.MixedArchiveSuffix
