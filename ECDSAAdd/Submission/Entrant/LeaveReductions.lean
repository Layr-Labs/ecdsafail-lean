  have hu11_zero : ∀ q : Nat, 1581 ≤ q → q ≤ 1602 → u11.basis q = false := by
    intro q h1 h2
    have hσ : σ20 j q = q := by unfold σ20; split_ifs <;> ((try unfold Wire at *); omega)
    rw [← hσ, hRet11.2.1 q (Or.inr (Or.inr (Or.inr (Or.inr ⟨by unfold Wire at *; omega, h2⟩))))]
    have hc := of_decide_eq_true (List.all_eq_true.mp (Selector20.selector20_certs k).2.2.2.2.2.2 q
      (by simp only [List.mem_range'_1]; omega))
    rw [hc]; simp [Selector20.restored20Sel, Selector20.start20Sel, Selector20.canonPorts,
      show q ≠ 300 by omega, show q ≠ 301 by omega, show q ≠ 1559 by omega, show q ≠ 1560 by omega,
      show ¬(1561 ≤ q ∧ q ≤ 1580) by omega, h1, h2, Expr.read]
  have hu11_59 : u11.basis 1559 = left20 k := by
    rw [hu11_keep 1559 (by omega), h59_601 1559 (by decide) (by decide), sym20]
    have h59 : sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k) 1559 =
        .bit (left20 k) := by
      rw [LeaveSelector.sim_outside _ _ _ (fun o ho => by have := prepOps20_dst_range o ho; unfold Wire at *; omega)]; rfl
    rw [h59]; rfl
  have hu11_60 : u11.basis 1560 = hot20 k 20 := by
    rw [hu11_keep 1560 (by omega), h59_601 1560 (by decide) (by decide), sym20]
    have h60 : sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k) 1560 =
        .bit (hot20 k 20) := by
      rw [LeaveSelector.sim_outside _ _ _ (fun o ho => by have := prepOps20_dst_range o ho; unfold Wire at *; omega)]; rfl
    rw [h60]; rfl
  have hu11_hits : ∀ i < 20, u11.basis (LeaveSelector.tags i) = hot20 k i := by
    intro i hi
    rw [hu11_keep _ (by simp [LeaveSelector.tags]; unfold Wire at *; omega),
      h59_601 _ (by simp [LeaveSelector.tags]; unfold Wire at *; omega) (by simp [LeaveSelector.tags]; unfold Wire at *; omega), sym20]
    have hti : sim (Selector20.prepOps20 Selector20.canonPorts) (Selector20.start20Sel Selector20.canonPorts k) (1561 + i) =
        .bit (hot20 k i) := by
      rw [LeaveSelector.sim_outside _ _ _ (fun o ho => by have := prepOps20_dst_range o ho; unfold Wire at *; omega)]
      simp [Selector20.start20Sel, show 1561 + i ≠ 1559 by omega, show 1561 + i ≠ 1560 by omega,
        show 1561 ≤ 1561 + i ∧ 1561 + i ≤ 1580 by omega]
    exact congrArg (Expr.read _) hti
  have hu11_swaps : right20 k = true → ∀ i < 20, i ≤ key20 k → u11.basis (swaps20 j i) = decide (i = key20 k) := by
    intro hr i hi hle
    have sw := swaps20_bounds j ⟨i, hi⟩
    rw [hu11_keep _ (by dsimp only at sw; (try unfold Wire at *); omega)]
    exact hswaps hr i hi hle
  have hu12_eq : run (GateMirror.forward (leaveFix12_20 (start20 j))) n9 u11 =
      ⟨u11.phase, fun q => if q = 1560 then right20 k else if 1561 ≤ q ∧ q ≤ 1580 then false else u11.basis q⟩ := by
    rw [(fix34_eq j).2.2.2.1]
    by_cases hr : right20 k = true
    · have hkey_le : key20 k ≤ 20 := by have := k.isLt; unfold key20; omega
      have hrt := HighBankFirstHit.retire_selected (hit20_layout j) u11 n9
        (fun i hi r hr' => swaps20_disj_tags j ⟨i, hi⟩ ⟨r, hr'⟩) (key20 k)
        (by simpa [hot20, hr, show (key20 k = 20) = (20 ≤ key20 k) by apply propext; omega] using hu11_60)
        (fun i hi => by simpa [hot20, hr, eq_comm] using hu11_hits i hi) (hu11_swaps hr)
      rw [hrt]; apply congrArg₂ State.mk rfl; funext q
      unfold HighBankFirstHit.retireBasis
      by_cases q60 : q = 1560
      · subst q60; simp [hr]
      · simp only [if_neg q60]
        by_cases qh : 1561 ≤ q ∧ q ≤ 1580
        · rw [if_pos ⟨q - 1561, by unfold Wire at *; omega, by simp [LeaveSelector.tags]; unfold Wire at *; omega⟩, if_pos qh]
        · rw [if_neg (fun ⟨i, hi, e⟩ => qh (by simp [LeaveSelector.tags] at e; unfold Wire at *; omega)), if_neg qh]
    · have hrf : right20 k = false := Bool.eq_false_iff.mpr hr
      have hrt := HighBankFirstHit.retire_inactive (hit20_layout j) u11 n9
        (by simpa [hot20, hrf] using hu11_60) (fun i hi => by simpa [hot20, hrf] using hu11_hits i hi)
      rw [hrt]; apply congrArg₂ State.mk rfl; funext q
      by_cases q60 : q = 1560
      · subst q60; simpa [hot20, hrf] using hu11_60
      · by_cases qh : 1561 ≤ q ∧ q ≤ 1580
        · simp only [if_neg q60, if_pos qh]
          have := hu11_hits (q - 1561) (by unfold Wire at *; omega)
          simp only [LeaveSelector.tags, show 1561 + (q - 1561) = q by unfold Wire at *; omega, hot20, hrf, Bool.false_and] at this
          exact this
        · simp [q60, qh]
  generalize hu12 : run (GateMirror.forward (leaveFix12_20 (start20 j))) n9 u11 = u12 at hu12_eq
  let n10 := n9.drop (measurementCount (GateMirror.forward (leaveFix12_20 (start20 j))))
  have hmf := mode20_flags (en.basis (e0P20 (start20 j) + 3)) (en.basis (e0P20 (start20 j) + 4)) z.u
  rw [← hmode] at hmf
  have huFin_eq : run (GateMirror.forward (lowSign20 (start20 j))) n10 u12 = ⟨u12.phase, cleared20 u10.basis⟩ := by
    rw [(fix34_eq j).2.2.2.2]
