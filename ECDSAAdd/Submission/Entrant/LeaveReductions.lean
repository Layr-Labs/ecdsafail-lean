def scanPairs20 (j : Fin 9) : List (Wire × Wire) :=
  (List.range 23).map fun i => (a0P20 (start20 j) - 1 + i, b0P20 (start20 j) - 1 + i)

def history20 (j : Fin 9) : List Wire := (List.range 20).map (start20 j + 16 + ·)
def longPairs20 (j : Fin 9) : List (Wire × Wire) := (List.range 22).map fun i => (b0P20 (start20 j) + i, 1557 + i)
def longPairs21 (j : Fin 9) : List (Wire × Wire) := (List.range 21).map fun i => (b0P20 (start20 j) + i, 1557 + i)
def fullA20 (j : Fin 9) : List Wire := (List.range 22).map (a0P20 (start20 j) + ·)
def fullM20 (j : Fin 9) : List Wire := (List.range 22).map (b0P20 (start20 j) + ·)
def fullA21 (j : Fin 9) : List Wire := (List.range 21).map (a0P20 (start20 j) + ·)
def fullM21 (j : Fin 9) : List Wire := (List.range 21).map (b0P20 (start20 j) + ·)
def fullC20 : List Wire := (List.range 20).map (1559 + ·)
def longPairs20s (j : Fin 9) : List (Wire × Wire) := (List.range 20).map fun i => (b0P20 (start20 j) + i, 1557 + i)
def fullA20s (j : Fin 9) : List Wire := (List.range 20).map (a0P20 (start20 j) + ·)
def fullM20s (j : Fin 9) : List Wire := (List.range 20).map (b0P20 (start20 j) + ·)
