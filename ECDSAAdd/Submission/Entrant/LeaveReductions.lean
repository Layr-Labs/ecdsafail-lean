  have undoA7 (l : List Bool) := va7.undo_run [] l
  have undoA6 (l : List Bool) := va6.undo_run [] l
  have undoA5 (l : List Bool) := va5.undo_run [] l
  have undoA3 (l : List Bool) := va3.undo_run [] l
  have undoA2 (l : List Bool) := va2.undo_run [] l
