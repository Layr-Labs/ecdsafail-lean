/-! ### Section 2: Symbolic 20-Stride Relocation Inverse & `boundaryClean20` -/

private def bankPair20 (s i : Nat) : Wire × Wire :=
  (bankW20 s (lowsP20 s + i), bTopP (s + 20) + 3 + i - nextWp20 s)

private def flagPairs20 (s : Nat) : List (Wire × Wire) :=
  [(1557, nextE0_20 s + 3), (1558, nextE0_20 s + 4),
   (e0P20 s + 5, nextE0_20 s + 5), (e0P20 s + 3, nextE0_20 s + 6),
   (e0P20 s + 7, nextE0_20 s + 7), (e0P20 s + 6, nextE0_20 s + 8)]

private theorem moves20_split (s : Nat) :
    movesP20 s = (List.range (nextWp20 s - 2)).map (bankPair20 s) ++ flagPairs20 s := rfl

private theorem flip20_fst {a b : Wire} : LeaveRelocation.flip a b a = b := by
  simp [LeaveRelocation.flip]

private theorem flip20_snd {a b : Wire} (h : a ≠ b) : LeaveRelocation.flip a b b = a := by
  simp [LeaveRelocation.flip, Ne.symm h]

private theorem flip20_ne {a b q : Wire} (h1 : q ≠ a) (h2 : q ≠ b) : LeaveRelocation.flip a b q = q := by
  simp [LeaveRelocation.flip, h1, h2]

private theorem src20_succ (f : Nat → Wire × Wire) (i : Nat) (q : Wire) :
    LeaveRelocation.source ((List.range (i + 1)).map f) q =
      LeaveRelocation.source ((List.range i).map f) (LeaveRelocation.flip (f i).1 (f i).2 q) := by
  rw [List.range_succ, List.map_append, List.map_singleton, LeaveRelocation.append]; rfl

private theorem src20_untouched (f : Nat → Wire × Wire) (n : Nat) (q : Wire)
    (h : ∀ k < n, q ≠ (f k).1 ∧ q ≠ (f k).2) :
    LeaveRelocation.source ((List.range n).map f) q = q := by
  apply LeaveRelocation.outside; intro p hp
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk; exact h k hk

private theorem src20_above (f : Nat → Wire × Wire) (i : Nat) (q : Wire) (n : Nat) (hi : i ≤ n)
    (h : ∀ k, i ≤ k → k < n → q ≠ (f k).1 ∧ q ≠ (f k).2) :
    LeaveRelocation.source ((List.range n).map f) q = LeaveRelocation.source ((List.range i).map f) q := by
  have sp : List.range n = List.range i ++ List.range' i (n - i) := by
    rw [List.range_eq_range', List.range_eq_range']
    conv_lhs => rw [show n = i + (n - i) by omega]
    rw [← List.range'_append_1, Nat.zero_add]
  rw [sp, List.map_append, LeaveRelocation.append]
  congr 1; apply LeaveRelocation.outside; intro p hp
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range'_1] at hk; exact h k hk.1 (by omega)

private theorem chain20_geo (j : Fin 9) :
    let s := start20 j
    let D0 := b0P20 s + lowsP20 s
    let n := nextWp20 s - 2
    let m := wpP20 s - lowsP20 s
    (∀ i, (bankPair20 s i).2 = D0 + i) ∧
    (∀ i, i < m → (bankPair20 s i).1 = D0 + 20 + i) ∧
    (∀ i, m ≤ i → (bankPair20 s i).1 = 1603 + i - m) ∧
    m ≤ n ∧ n ≤ m + 20 ∧ 20 ≤ n ∧
    D0 + 19 + m = bTopP s ∧ D0 + n = bTopP (s + 20) + 1 ∧
    bTopP s ≤ 1043 ∧ bTopP (s + 20) ≤ bTopP s ∧
    1623 ≤ nextE0_20 s ∧ nextE0_20 s + 8 < e0P20 s ∧
    e0P20 s ≤ nextE0_20 s + 15 ∧
    lowsP20 s + 3 ≤ wpP20 s ∧ bTopP s + 1 - wpP20 s = b0P20 s + 20 := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hnum : ∀ k : Fin 9,
      let s := start20 k
      let D0 := b0P20 s + lowsP20 s
      let n := nextWp20 s - 2
      let m := wpP20 s - lowsP20 s
      m ≤ n ∧ n ≤ m + 20 ∧ 20 ≤ n ∧
      D0 + 19 + m = bTopP s ∧ D0 + n = bTopP (s + 20) + 1 ∧
      bTopP s ≤ 1043 ∧ bTopP (s + 20) ≤ bTopP s ∧
      1623 ≤ nextE0_20 s ∧ nextE0_20 s + 8 < e0P20 s ∧
      e0P20 s ≤ nextE0_20 s + 15 ∧
      lowsP20 s + 3 ≤ wpP20 s ∧ bTopP s + 1 - wpP20 s = b0P20 s + 20 ∧
      nextWp20 s ≤ bTopP (s + 20) + 3 := by decide +kernel
  have hn := hnum j; dsimp only at hn
  refine ⟨fun i => ?_, fun i hi => ?_, fun i hi => ?_,
    hn.1, hn.2.1, hn.2.2.1, hn.2.2.2.1, hn.2.2.2.2.1, hn.2.2.2.2.2.1, hn.2.2.2.2.2.2.1,
    hn.2.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2.2.2.2.1,
    hn.2.2.2.2.2.2.2.2.2.2.2.1⟩
  · unfold bankPair20; dsimp only; unfold Wire; omega
  · unfold bankPair20 bankW20; dsimp only
    rw [if_neg (by omega), if_pos (by omega)]; unfold Wire; omega
  · unfold bankPair20 bankW20; dsimp only
    rw [if_neg (by omega), if_neg (by omega)]; unfold Wire; omega

private theorem src20_chain (j : Fin 9) :
    ∀ i, i < nextWp20 (start20 j) - 2 →
      LeaveRelocation.source ((List.range i).map (bankPair20 (start20 j))) (b0P20 (start20 j) + lowsP20 (start20 j) + i) =
        b0P20 (start20 j) + lowsP20 (start20 j) + i % 20 := by
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have ab (k : Nat) :
      ((bankPair20 (start20 j) k).1 = b0P20 (start20 j) + lowsP20 (start20 j) + 20 + k ∧ k < wpP20 (start20 j) - lowsP20 (start20 j)) ∨
      ((bankPair20 (start20 j) k).1 = 1603 + k - (wpP20 (start20 j) - lowsP20 (start20 j)) ∧ wpP20 (start20 j) - lowsP20 (start20 j) ≤ k) := by
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · exact Or.inl ⟨hB k b, b⟩
    · exact Or.inr ⟨hP k (by omega), by omega⟩
  intro i
  induction i using Nat.strong_induction_on with
  | _ i ih =>
    intro hi
    by_cases small : i < 20
    · rw [src20_untouched (bankPair20 (start20 j)) i _ (by
        intro k hk; rw [hd k]
        rcases ab k with ⟨e, ek⟩ | ⟨e, ek⟩ <;> rw [e] <;> constructor <;> (unfold Wire; omega))]
      rw [Nat.mod_eq_of_lt small]
    · have kB : i - 20 < wpP20 (start20 j) - lowsP20 (start20 j) := by omega
      rw [src20_above (bankPair20 (start20 j)) (i - 20 + 1) _ i (by omega) (by
        intro k a b; rw [hd k]
        rcases ab k with ⟨e, ek⟩ | ⟨e, ek⟩ <;> rw [e] <;> constructor <;> (unfold Wire; omega))]
      rw [src20_succ, show (b0P20 (start20 j) + lowsP20 (start20 j) + i : Wire) = (bankPair20 (start20 j) (i - 20)).1 by
        rw [hB _ kB]; unfold Wire; omega, flip20_fst, hd (i - 20), ih (i - 20) (by omega) (by omega)]
      congr 1; omega

private theorem src20_top (j : Fin 9) (i : Nat) (hi : i < nextWp20 (start20 j) - 2)
    (top : lowsP20 (start20 j) + i < wpP20 (start20 j) → nextWp20 (start20 j) - 2 ≤ i + 20) :
    LeaveRelocation.source (movesP20 (start20 j)) (bankW20 (start20 j) (lowsP20 (start20 j) + i)) =
      b0P20 (start20 j) + lowsP20 (start20 j) + i % 20 := by
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have ab (k : Nat) :
      ((bankPair20 (start20 j) k).1 = b0P20 (start20 j) + lowsP20 (start20 j) + 20 + k ∧ k < wpP20 (start20 j) - lowsP20 (start20 j)) ∨
      ((bankPair20 (start20 j) k).1 = 1603 + k - (wpP20 (start20 j) - lowsP20 (start20 j)) ∧ wpP20 (start20 j) - lowsP20 (start20 j) ≤ k) := by
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · exact Or.inl ⟨hB k b, b⟩
    · exact Or.inr ⟨hP k (by omega), by omega⟩
  have top' : nextWp20 (start20 j) - 2 ≤ i + 20 ∨ wpP20 (start20 j) - lowsP20 (start20 j) ≤ i := by
    by_cases b : lowsP20 (start20 j) + i < wpP20 (start20 j)
    · exact Or.inl (top b)
    · exact Or.inr (by omega)
  have ai : bankW20 (start20 j) (lowsP20 (start20 j) + i) = (bankPair20 (start20 j) i).1 := rfl
  rw [moves20_split, LeaveRelocation.append, ai]
  rw [LeaveRelocation.outside (flagPairs20 (start20 j)) (bankPair20 (start20 j) i).1 (by
    intro p hp; simp only [flagPairs20, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases ab i with ⟨e, ei⟩ | ⟨e, ei⟩ <;> rw [e] <;>
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩)]
  rw [src20_above (bankPair20 (start20 j)) (i + 1) _ (nextWp20 (start20 j) - 2) (by omega) (by
    intro k a b; rw [hd k]
    rcases ab k with ⟨e, ek⟩ | ⟨e, ek⟩ <;> rcases ab i with ⟨e', ei⟩ | ⟨e', ei⟩ <;> rw [e, e'] <;>
      exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩)]
  rw [src20_succ, flip20_fst, hd i]
  exact src20_chain j i hi

private theorem src20_flags_back (j : Fin 9) :
    let s := start20 j
    LeaveRelocation.source (movesP20 s) 1557 = nextE0_20 s + 3 ∧
    LeaveRelocation.source (movesP20 s) 1558 = nextE0_20 s + 4 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 5) = nextE0_20 s + 5 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 3) = nextE0_20 s + 6 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 7) = nextE0_20 s + 7 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 6) = nextE0_20 s + 8 := by
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have bankOut (x : Wire) (hx : nextE0_20 (start20 j) ≤ x) :
      LeaveRelocation.source ((List.range (nextWp20 (start20 j) - 2)).map (bankPair20 (start20 j))) x = x := by
    apply src20_untouched; intro k hk; rw [hd k]
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · rw [hB k b]; exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩
    · rw [hP k (by omega)]; exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩
  have fl : ∀ x, LeaveRelocation.source (flagPairs20 (start20 j)) x =
      LeaveRelocation.flip 1557 (nextE0_20 (start20 j) + 3)
        (LeaveRelocation.flip 1558 (nextE0_20 (start20 j) + 4)
          (LeaveRelocation.flip (e0P20 (start20 j) + 5) (nextE0_20 (start20 j) + 5)
            (LeaveRelocation.flip (e0P20 (start20 j) + 3) (nextE0_20 (start20 j) + 6)
              (LeaveRelocation.flip (e0P20 (start20 j) + 7) (nextE0_20 (start20 j) + 7)
                (LeaveRelocation.flip (e0P20 (start20 j) + 6) (nextE0_20 (start20 j) + 8) x))))) := fun _ => rfl
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · rw [moves20_split, LeaveRelocation.append, fl]
    simp (disch := (unfold Wire; omega)) only [flip20_ne, flip20_fst, flip20_snd]
    exact bankOut _ (by unfold Wire; omega)

private theorem src20_out (j : Fin 9) (q : Wire)
    (bank : q < b0P20 (start20 j) + lowsP20 (start20 j) ∨ (bTopP (start20 j) < q ∧ q < 1603) ∨
      1603 + (nextWp20 (start20 j) - 2) - (wpP20 (start20 j) - lowsP20 (start20 j)) ≤ q)
    (flags : q ≠ 1557 ∧ q ≠ 1558 ∧ q ≠ e0P20 (start20 j) + 3 ∧ q ≠ e0P20 (start20 j) + 5 ∧
      q ≠ e0P20 (start20 j) + 6 ∧ q ≠ e0P20 (start20 j) + 7 ∧
      (q < nextE0_20 (start20 j) + 3 ∨ nextE0_20 (start20 j) + 8 < q)) :
    LeaveRelocation.source (movesP20 (start20 j)) q = q := by
  have hg := geom20_facts j; dsimp only at hg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
