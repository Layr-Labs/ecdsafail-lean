    { h := 32, bank := c.RF.hi, dst := c.RF.dhi, S := c.qS33, T := c.T2, z := c.qZ30,
      pad := StairSquareBChecks.K4DQ.LBF.leafPad, carry := c.qCarry, cin := StairSquareBChecks.K4DQ.LBF.core.cin }
