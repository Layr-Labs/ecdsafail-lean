      dsimp only; unfold Wire at *; omega
    let uFlags := LeaveJ7.Admission.flags z g sg
    have par := RecordedParity.result j (Nat.zero_le _) (by omega) s z g sg ⟨h.farSmall, h.endSmall⟩ h.odd h.record
