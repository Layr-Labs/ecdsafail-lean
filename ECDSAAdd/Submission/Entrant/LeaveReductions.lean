    exact ReorderedCacheBits.forward_values 4 33 H (((2 ^ 138 - 48 * H) % 2 ^ 138) / 1024) (976 * H / 1024)
      A109Research.xs A109Research.ys A109Research.cs ReorderedBPrefixResearch.cin t
