      run (GateMirror.forward bJ) [] (run (GateMirror.forward (a0 ++ (b0 ++ (a1 ++ (b1 ++ (c0 ++ (bR ++ (c1 ++ (b2 ++ d0))))))))) [] s))
    (backJ : ∀ t, run rJ t (run (GateMirror.forward bJ) []
      (run (GateMirror.forward (a0 ++ (b0 ++ (a1 ++ (b1 ++ (c0 ++ (bR ++ (c1 ++ (b2 ++ d0))))))))) [] s)) =
      run (GateMirror.forward (a0 ++ (b0 ++ (a1 ++ (b1 ++ (c0 ++ (bR ++ (c1 ++ (b2 ++ d0))))))))) [] s)
