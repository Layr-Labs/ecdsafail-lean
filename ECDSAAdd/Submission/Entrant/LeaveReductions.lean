private theorem leaveBound20_addG {s : Nat} : ∀ (xs cs : List Wire) (c0 : Wire),
    (∀ q ∈ xs, leaveBound20 s q) → (∀ q ∈ cs, leaveBound20 s q) → leaveBound20 s c0 →
    AllW (leaveBound20 s) (addG xs cs c0)
  | x :: y :: xs, c :: cs, c0, hx, hc, h0 => by
    unfold addG
    have h1 : AllW (leaveBound20 s) [.make x c0 c] := fun g hg q hq => by
      simp only [List.mem_singleton] at hg; subst hg
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl; exact hx _ List.mem_cons_self; exact h0; exact hc _ List.mem_cons_self
    have h2 : AllW (leaveBound20 s) [.pop x c0 c, .cx c0 x] := fun g hg q hq => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl <;> simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      · rcases hq with rfl | rfl | rfl; exact hx _ List.mem_cons_self; exact h0; exact hc _ List.mem_cons_self
      · rcases hq with rfl | rfl; exact h0; exact hx _ List.mem_cons_self
    exact leaveBound20_app (leaveBound20_app h1
      (leaveBound20_addG (y :: xs) cs c (fun q hq => hx q (List.mem_cons_of_mem _ hq))
        (fun q hq => hc q (List.mem_cons_of_mem _ hq)) (hc c List.mem_cons_self))) h2
  | [x], _, c0, hx, _, h0 => fun g hg q hq => by
    simp only [addG, List.mem_singleton] at hg; subst hg
    simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl; exact h0; exact hx _ List.mem_cons_self
  | [], _, _, _, _, _ => fun g hg => by simp [addG] at hg
  | _ :: _ :: _, [], _, _, _, _ => fun g hg => by simp [addG] at hg

private theorem leaveBound20_chainG {s : Nat} (w a : Nat → Wire) (body : List Gate) (hb : AllW (leaveBound20 s) body) :
    ∀ k n, (∀ i, k ≤ i → i ≤ k + n → leaveBound20 s (w i)) →
      (∀ i, k ≤ i → i < k + n → leaveBound20 s (a i)) → AllW (leaveBound20 s) (chainG w a body k n)
  | _, 0, _, _ => hb
  | k, n + 1, hw, ha => by
    have h1 : AllW (leaveBound20 s) [.make (w k) (a k) (w (k + 1))] := fun g hg q hq => by
      simp only [List.mem_singleton] at hg; subst hg
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl
      · exact hw k (le_refl _) (by omega)
      · exact ha k (le_refl _) (by omega)
      · exact hw (k + 1) (by omega) (by omega)
    have h2 : AllW (leaveBound20 s) [.pop (w k) (a k) (w (k + 1))] := fun g hg q hq => by
      simp only [List.mem_singleton] at hg; subst hg
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl
      · exact hw k (le_refl _) (by omega)
      · exact ha k (le_refl _) (by omega)
      · exact hw (k + 1) (by omega) (by omega)
    exact leaveBound20_app (leaveBound20_app h1
      (leaveBound20_chainG w a body hb (k + 1) n (fun i h1 h2 => hw i (by omega) (by omega))
        (fun i h1 h2 => ha i (by omega) (by omega)))) h2

private theorem leaveBefore20_bound (j : Fin 9) : AllW (leaveBound20 (start20 j)) (leaveBefore20 (start20 j)) := by
  have hg := geom20_facts j; dsimp only at hg
  have he0 := leaveBound20_e0 j
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbk (i : Nat) (hi : i < wpP20 (start20 j) + 20) : leaveBound20 (start20 j) (bankW20 (start20 j) i) := by
    rcases bank20_cases j hi with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
      (unfold leaveBound20; try rw [eb]; unfold Wire at *; omega)
  have hpl (i : Nat) (hi : i < wpP20 (start20 j) - 1) : leaveBound20 (start20 j) (poolW20 (start20 j) i) := by
    rcases pool20_cases j i with ⟨_, ep⟩ | ⟨_, ep⟩ <;> (unfold leaveBound20; rw [ep]; unfold Wire at *; omega)
  have hsp : leaveBefore20 (start20 j) = (entryLeave20 (start20 j) ++ selPrefix20 (start20 j)) ++ leaveAdjust20 (start20 j) := by
    simp only [leaveBefore20, entryLeave20, selPrefix20, List.append_assoc]
  rw [hsp]
  refine leaveBound20_app (fun g hg' r hr => by
    unfold leaveBound20
    exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp (leaveBound20_fixedBefore j) g hg') r hr)) ?_
  unfold leaveAdjust20 leaveAdjustCore20 adjustG
  have hys : ∀ r ∈ (List.range (wpP20 (start20 j))).map (bankW20 (start20 j)), leaveBound20 (start20 j) r := by
    intro r hr; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hr; rw [List.mem_range] at hi; exact hbk i (by omega)
