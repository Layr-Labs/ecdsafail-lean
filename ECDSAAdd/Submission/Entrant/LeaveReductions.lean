-- ==== begin Shadow7Wide20Reentry ====
section

/-!
# Re-entry Block `j20` (`s = 345`, 15-Tick Window Following 20-Tick Block `k8` at `s = 325`)

Proves the complete native window head semantics for the 15-tick re-entry block `j20 = ⟨20, _⟩`
(`start j20 = 345`), which packs the first 10 ticks (`325..334`) of the final 20-tick block
`k8 = ⟨8, _⟩` (`start20 k8 = 325`) via `packW d 345 330 ++ packW d 345 335` and archives its
last 10 ticks (`335..344`) + 3 flags via `archiveLoadP20 k8 d`, delivering all inputs needed by
the standard 15-tick `CRTBarrel.leave j20`!
-/

namespace ECDSAAdd.Entrant.StairPacket.Shadow20.Reentry345

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.IntegerPacket
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Partial
open ECDSAAdd.Entrant.StairPacket.ArchivePortAction
open ECDSAAdd.Entrant.StairArchiveRaw
open ECDSAAdd.Entrant.StairArchiveTrace
open ECDSAAdd.Entrant.StairArchiveIntegerHook
open ECDSAAdd.Entrant.StairPacket.EnterProof
open ECDSAAdd.Entrant.StairPacket.WideReference
open ECDSAAdd.Entrant.StairPacket.Shadow20
open ECDSAAdd.Entrant.StairPacket.Shadow20.WideReference20
open SkywalkRails

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option exponentiation.threshold 1024

abbrev j20 : Fin 26 := MixedWindow.j20
abbrev k8 : Fin 9 := MixedWindow.k8

private theorem j20_start : start j20 = 345 := rfl
private theorem j20_sb : Shadow7.sbP 345 = 76 := by decide
private theorem j20_wp : Shadow7.wpP 345 = 76 := by decide
private theorem j20_e0 : Shadow7.e0P 345 = 1650 := by decide
private theorem j20_flags :
    EnterJ7.flagN j20 = 1655 ∧ EnterJ7.flagF j20 = 1653 ∧ EnterJ7.flagU j20 = 1654 ∧
    EnterJ7.pending j20 = [1656, 1657, 1658] := by decide +kernel

def packProg345 (d : Bool) : Program :=
  MixedWindow.packW d 345 330 ++ MixedWindow.packW d 345 335

def packRev345 (d : Bool) : Program :=
  MixedWindow.unpackW d 345 335 ++ MixedWindow.unpackW d 345 330

def withArchive345 (d : Bool) : Program :=
  packProg345 d ++ archiveLoadP20 k8 d

def fromArchive345 (d : Bool) : Program :=
  archiveRestoreP20 k8 d ++ packRev345 d

def window345 (d : Bool) : Program := Shadow7.body j20 (withArchive345 d)
def unwind345 (d : Bool) : Program := Shadow7.unbody j20 (fromArchive345 d)

def nextWindow345 (d : Bool) : Program := Shadow7.enterP j20 ++ window345 d
def nextUnwind345 (d : Bool) : Program := unwind345 d ++ Shadow7.enterInvP j20

def histA345 : Fin 10 → Wire := fun i => OB5.sig 345 (History5.historyMap base 325 i)
def histB345 : Fin 10 → Wire := fun i => OB5.sig 345 (History5.historyMap base 330 i)

def support345 : List Wire :=
  (List.range' 325 10).flatMap fun v => [OB5.sig 345 (base v), OB5.sig 345 (base (1028 + v))]

def fourHoles345 : List Wire := (ArchiveJ20.codeTail k8).take 4

def tailTemps345 : List Wire :=
  List.range' (Shadow7.e0P 345 + 9) (min 1813 (2055 - 345) - (Shadow7.e0P 345 + 9))

def protectedSites345 : List Wire :=
  [EnterJ7.flagN j20, EnterJ7.flagF j20, EnterJ7.flagU j20] ++ EnterJ7.saved j20

private theorem hist_inj345 :
    Function.Injective histA345 ∧ Function.Injective histB345 ∧
    (∀ i : Fin 10, histA345 i ∈ support345 ∧ histB345 i ∈ support345) ∧
    (∀ i j : Fin 10, histA345 i ≠ histB345 j) := by
  decide +kernel

theorem pack_codes345_aux (d : Bool) :
    wires (MixedWindow.packW d 345 330) ⊆ support345.toFinset ∧
    wires (MixedWindow.unpackW d 345 330) ⊆ support345.toFinset ∧
    wires (MixedWindow.packW d 345 335) ⊆ support345.toFinset ∧
    wires (MixedWindow.unpackW d 345 335) ⊆ support345.toFinset ∧
    MixedWindow.packW d 345 330 = Rolling1588.codeEncodeAt d histA345 ∧
    MixedWindow.unpackW d 345 330 = Rolling1588.codeDecodeAt d histA345 ∧
    MixedWindow.packW d 345 335 = Rolling1588.codeEncodeAt d histB345 ∧
    MixedWindow.unpackW d 345 335 = Rolling1588.codeDecodeAt d histB345 := by
  have subA : ∀ i : Fin 10, histA345 i ∈ support345 := fun i => (hist_inj345.2.2.1 i).1
  have subB : ∀ i : Fin 10, histB345 i ∈ support345 := fun i => (hist_inj345.2.2.1 i).2
  have labEq (t : Nat) (h : Fin 10 → Wire) (heq : ∀ i : Fin 10, OB5.sig 345 (History5.historyMap base t i) = h i) :
      ∀ q ∈ Finset.range 10, (OB5.sig 345 ∘ MeasuredCodec5.label (History5.historyMap base t)) q = MeasuredCodec5.label h q := by
    intro q hq; have lt := Finset.mem_range.mp hq
    simp only [Function.comp, MeasuredCodec5.label, dif_pos lt]; exact heq ⟨q, lt⟩
  have eqA : MixedWindow.packW d 345 330 = Rolling1588.codeEncodeAt d histA345 ∧
      MixedWindow.unpackW d 345 330 = Rolling1588.codeDecodeAt d histA345 := by
    refine ⟨?_, ?_⟩
    · unfold MixedWindow.packW Rolling1588.packAtTick Rolling1588.codeEncodeAt
      rw [if_neg (by decide), if_pos (by decide), renameProgram_comp]
      exact renameProgram_congr_support _ _ _ (fun q hq => labEq 325 histA345 (fun _ => rfl) q ((Rolling1588.code_support d).1 ▸ hq))
    · unfold MixedWindow.unpackW Rolling1588.unpackAtTick Rolling1588.codeDecodeAt
      rw [if_neg (by decide), if_pos (by decide), renameProgram_comp]
      exact renameProgram_congr_support _ _ _ (fun q hq => labEq 325 histA345 (fun _ => rfl) q ((Rolling1588.code_support d).2 ▸ hq))
  have eqB : MixedWindow.packW d 345 335 = Rolling1588.codeEncodeAt d histB345 ∧
      MixedWindow.unpackW d 345 335 = Rolling1588.codeDecodeAt d histB345 := by
    refine ⟨?_, ?_⟩
    · unfold MixedWindow.packW Rolling1588.packAtTick Rolling1588.codeEncodeAt
      rw [if_neg (by decide), if_pos (by decide), renameProgram_comp]
      exact renameProgram_congr_support _ _ _ (fun q hq => labEq 330 histB345 (fun _ => rfl) q ((Rolling1588.code_support d).1 ▸ hq))
    · unfold MixedWindow.unpackW Rolling1588.unpackAtTick Rolling1588.codeDecodeAt
      rw [if_neg (by decide), if_pos (by decide), renameProgram_comp]
      exact renameProgram_congr_support _ _ _ (fun q hq => labEq 330 histB345 (fun _ => rfl) q ((Rolling1588.code_support d).2 ▸ hq))
  have cover (h : Fin 10 → Wire) (hs : ∀ i, h i ∈ support345) :
      wires (Rolling1588.codeEncodeAt d h) ⊆ support345.toFinset ∧
      wires (Rolling1588.codeDecodeAt d h) ⊆ support345.toFinset := by
    rw [Rolling1588.codeEncodeAt, Rolling1588.codeDecodeAt, renameProgram_support, renameProgram_support,
      (Rolling1588.code_support d).1, (Rolling1588.code_support d).2]
    have img : Finset.image (MeasuredCodec5.label h) (Finset.range 10) ⊆ support345.toFinset := by
      intro q hq; obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      have lt := Finset.mem_range.mp hw
      simp only [MeasuredCodec5.label, dif_pos lt, List.mem_toFinset]; exact hs ⟨w, lt⟩
    exact ⟨img, img⟩
  exact ⟨eqA.1 ▸ (cover histA345 subA).1, eqA.2 ▸ (cover histA345 subA).2,
    eqB.1 ▸ (cover histB345 subB).1, eqB.2 ▸ (cover histB345 subB).2,
    eqA.1, eqA.2, eqB.1, eqB.2⟩

theorem pack_codes345 (d : Bool) :
    wires (packProg345 d) ⊆ support345.toFinset ∧ wires (packRev345 d) ⊆ support345.toFinset := by
  have h := pack_codes345_aux d
  exact ⟨by rw [packProg345, wires_append, Finset.union_subset_iff]; exact ⟨h.1, h.2.2.1⟩,
    by rw [packRev345, wires_append, Finset.union_subset_iff]; exact ⟨h.2.2.2.1, h.2.1⟩⟩

private theorem watch345_disj :
    (Shadow7.watch j20).all (fun q => decide (q ∉ support345)) = true ∧
    (Shadow7.watch j20).all (fun q => decide (q ∉ ArchiveJ20.rawHead k8)) = true := by
  decide +kernel

theorem pack_retains345 (d back : Bool) (s : State) (m : List Bool) :
    ∀ q ∈ Shadow7.watch j20, (run (if back then packRev345 d else packProg345 d) m s).basis q = s.basis q := by
  intro q hq
  apply run_preserves_outside; intro used
  have seen : q ∈ support345.toFinset := by
    cases back; exact (pack_codes345 d).1 used; exact (pack_codes345 d).2 used
  exact (of_decide_eq_true (List.all_eq_true.mp watch345_disj.1 q hq)) (List.mem_toFinset.mp seen)

theorem pack_source_law345 (d : Bool) (s : State) (m : List Bool)
    (okA : MeasuredCodec5.legalAt histA345 s.basis)
    (okB : MeasuredCodec5.legalAt histB345 s.basis) :
    (run (packProg345 d) m s).phase = s.phase ∧
    ∀ t, run (packRev345 d) t (run (packProg345 d) m s) = s := by
  have hc := pack_codes345_aux d
  have e1f := hc.2.2.2.2.1; have e1r := hc.2.2.2.2.2.1
  have e2f := hc.2.2.2.2.2.2.1; have e2r := hc.2.2.2.2.2.2.2
  let mid := run (MixedWindow.packW d 345 330) m s
  have hBpres : ∀ i : Fin 10, mid.basis (histB345 i) = s.basis (histB345 i) := by
    intro i; apply run_preserves_outside; intro used
    rw [e1f, Rolling1588.codeEncodeAt, renameProgram_support, (Rolling1588.code_support d).1] at used
    obtain ⟨w, hw, eq⟩ := Finset.mem_image.mp used
    have lt := Finset.mem_range.mp hw
