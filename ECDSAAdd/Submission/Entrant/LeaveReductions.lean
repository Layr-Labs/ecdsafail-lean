/-! ### Section 6: Exact Footprint & Frame Preservation (`leave20_keeps`) -/

/-- Exact bounding box of `leaveP20 j` (strictly inside `WideReference20.Box20 (start20 j) 20` plus
scratch/flags/history, disjoint from all other blocks' archive code cells and lower short rails). -/
def leaveBox20 (s : Nat) (q : Wire) : Prop :=
  (s + 16 ≤ q ∧ q ≤ s + 35) ∨
  (a0P20 s - 1 ≤ q ∧ q ≤ a0P20 s + 21) ∨
  (b0P20 s - 1 ≤ q ∧ q ≤ bTopP s) ∨
  (1556 ≤ q ∧ q ≤ 1812) ∨
  (s + 1044 ≤ q ∧ q ≤ s + 1063 ∧ q ≤ 1300)

private def inBox20 (j : Fin 9) (gs : List Gate) : Prop :=
  ∀ g ∈ gs, ∀ q ∈ g.wires, leaveBox20 (start20 j) q

private theorem inBox20_app {j : Fin 9} {a b : List Gate} (ha : inBox20 j a) (hb : inBox20 j b) :
    inBox20 j (a ++ b) := fun g hg =>
  (List.mem_append.mp hg).elim (ha g) (hb g)

private theorem inBox20_xsG {j : Fin 9} {xs : List Wire} (hx : ∀ q ∈ xs, leaveBox20 (start20 j) q) :
    inBox20 j (xsG xs) := by
  intro g hg q hq
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hg
  simp only [Gate.wires, List.mem_singleton] at hq
  exact hq ▸ hx w hw

private theorem inBox20_cxsG {j : Fin 9} {c : Wire} {xs : List Wire}
    (hc : leaveBox20 (start20 j) c) (hx : ∀ q ∈ xs, leaveBox20 (start20 j) q) :
    inBox20 j (cxsG c xs) := by
  intro g hg q hq
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hg
  simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl
  · exact hc
  · exact hx _ hw

private theorem inBox20_cons {j : Fin 9} {g : Gate} {gs : List Gate}
    (hg : ∀ q ∈ g.wires, leaveBox20 (start20 j) q) (hgs : inBox20 j gs) : inBox20 j (g :: gs) := by
  intro g' hg'
  rcases List.mem_cons.mp hg' with rfl | hmem
  · exact hg
  · exact hgs g' hmem

private theorem inBox20_addG {j : Fin 9} : ∀ (a c : List Wire) (o : Wire),
    (∀ q ∈ a, leaveBox20 (start20 j) q) → (∀ q ∈ c, leaveBox20 (start20 j) q) →
    leaveBox20 (start20 j) o → inBox20 j (addG a c o)
  | y :: y' :: ys, c :: cs, cin, ha, hc, ho => by
      unfold addG
      refine inBox20_cons ?_ (inBox20_app (inBox20_addG (y' :: ys) cs c
        (fun q hq => ha q (List.mem_cons_of_mem _ hq))
        (fun q hq => hc q (List.mem_cons_of_mem _ hq))
        (hc c List.mem_cons_self)) ?_)
      · intro q hq; simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
        rcases hq with rfl | rfl | rfl
        · exact ha _ List.mem_cons_self
        · exact ho
        · exact hc _ List.mem_cons_self
      · intro g hg q hq; simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
        rcases hg with rfl | rfl <;> simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
        · rcases hq with rfl | rfl | rfl
          · exact ha _ List.mem_cons_self
          · exact ho
          · exact hc _ List.mem_cons_self
        · rcases hq with rfl | rfl
          · exact ho
          · exact ha _ List.mem_cons_self
  | [y], _, cin, ha, _, ho => fun g hg q hq => by
      simp only [addG, List.mem_singleton] at hg; subst hg
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl; exact ho; exact ha _ List.mem_cons_self
  | [], _, _, _, _, _ => fun g hg => by simp [addG] at hg
  | _ :: _ :: _, [], _, _, _, _ => fun g hg => by simp [addG] at hg

private theorem inBox20_chainG {j : Fin 9} (c seq : Nat → Wire) (tail : List Gate)
    (htail : inBox20 j tail) : ∀ (i n : Nat),
    (∀ k, i ≤ k → k ≤ i + n → leaveBox20 (start20 j) (c k)) →
    (∀ k, i ≤ k → k < i + n → leaveBox20 (start20 j) (seq k)) →
    inBox20 j (chainG c seq tail i n)
  | _, 0, _, _ => htail
  | i, n + 1, hc, hseq => by
    unfold chainG
    refine inBox20_cons ?_ (inBox20_app (inBox20_chainG c seq tail htail (i + 1) n
      (fun k h1 h2 => hc k (by omega) (by omega)) (fun k h1 h2 => hseq k (by omega) (by omega))) ?_)
    · intro q hq; simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl
      · exact hc i (le_refl _) (by omega)
      · exact hseq i (le_refl _) (by omega)
      · exact hc (i + 1) (by omega) (by omega)
    · intro g hg q hq; simp only [List.mem_singleton] at hg; subst hg
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl
      · exact hc i (le_refl _) (by omega)
      · exact hseq i (le_refl _) (by omega)
      · exact hc (i + 1) (by omega) (by omega)

private theorem inBox20_eventsG {j : Fin 9} : ∀ (ps : List (Wire × Wire)) (a out : Wire),
    leaveBox20 (start20 j) a → leaveBox20 (start20 j) out →
    (∀ p ∈ ps, leaveBox20 (start20 j) p.1 ∧ leaveBox20 (start20 j) p.2) →
    inBox20 j (eventsG a out ps)
  | [], a, out, ha, ho, _ => fun g hg q hq => by
    simp only [eventsG, List.mem_singleton] at hg; subst hg
    simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl; exact ha; exact ho
  | (x, t) :: ps, a, out, ha, ho, hp => by
    unfold eventsG
    have hxt := hp (x, t) List.mem_cons_self
    refine inBox20_app ?_ (inBox20_app (inBox20_eventsG ps t out hxt.2 ho
      (fun p h => hp p (List.mem_cons_of_mem _ h))) ?_)
    · intro g hg q hq; simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl <;> simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      · exact hq ▸ hxt.1
      · rcases hq with rfl | rfl | rfl; exact ha; exact hxt.1; exact hxt.2
    · intro g hg q hq; simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl <;> simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      · rcases hq with rfl | rfl | rfl; exact ha; exact hxt.1; exact hxt.2
      · exact hq ▸ hxt.1

private theorem inBox20_swapsG {j : Fin 9} {ps : List (Wire × Wire)}
    (hp : ∀ p ∈ ps, leaveBox20 (start20 j) p.1 ∧ leaveBox20 (start20 j) p.2) :
    inBox20 j (swapsG ps) := by
  intro g hg q hq
  obtain ⟨p, hpm, hgm⟩ := List.mem_flatMap.mp hg
  have hp0 := hp p hpm
  simp only [swapG, List.mem_cons, List.not_mem_nil, or_false] at hgm
  rcases hgm with rfl | rfl | rfl <;> simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq <;>
    rcases hq with rfl | rfl
  · exact hp0.1
  · exact hp0.2
  · exact hp0.2
  · exact hp0.1
  · exact hp0.1
  · exact hp0.2

private theorem fixedBefore20_box : ∀ j : Fin 9,
    (entryLeave20 (start20 j) ++ selPrefix20 (start20 j)).all (fun g => g.wires.all fun q =>
      decide ((start20 j + 16 ≤ q ∧ q ≤ start20 j + 35) ∨
        (a0P20 (start20 j) - 1 ≤ q ∧ q ≤ a0P20 (start20 j) + 21) ∨
        (b0P20 (start20 j) - 1 ≤ q ∧ q ≤ bTopP (start20 j)) ∨
        (1556 ≤ q ∧ q ≤ 1812) ∨
        (start20 j + 1044 ≤ q ∧ q ≤ start20 j + 1063 ∧ q ≤ 1300))) = true := by
  decide +kernel

private theorem fixedAfter20_box : ∀ j : Fin 9,
    (fix8P20 (start20 j) ++ leaveJoinMove20 (start20 j) ++ fix10P20 (start20 j) ++
      leaveFix11_20 (start20 j) ++ leaveFix12_20 (start20 j)).all (fun g => g.wires.all fun q =>
      decide ((start20 j + 16 ≤ q ∧ q ≤ start20 j + 35) ∨
        (a0P20 (start20 j) - 1 ≤ q ∧ q ≤ a0P20 (start20 j) + 21) ∨
        (b0P20 (start20 j) - 1 ≤ q ∧ q ≤ bTopP (start20 j)) ∨
        (1556 ≤ q ∧ q ≤ 1812) ∨
        (start20 j + 1044 ≤ q ∧ q ≤ start20 j + 1063 ∧ q ≤ 1300))) = true := by
  decide +kernel

private theorem bTop20_bounds : ∀ j : Fin 9,
    b0P20 (start20 j) + lowsP20 (start20 j) ≤ bTopP (start20 j) ∧ bTopP (start20 j) ≤ 1043 := by
  decide +kernel

private theorem bankW20_inBox (j : Fin 9) (i : Nat) (hi : i < wpP20 (start20 j) + 20) :
    leaveBox20 (start20 j) (bankW20 (start20 j) i) := by
  have hg := geom20_facts j; dsimp only at hg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt := (bTop20_bounds j).2
  rcases bank20_cases j hi with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
  · rw [eb]; unfold leaveBox20; right; right; right; left; unfold Wire at *; omega
  · unfold leaveBox20; right; right; left; unfold Wire at *; omega
  · rw [eb]; unfold leaveBox20; right; right; right; left; unfold Wire at *; omega

private theorem leaveBefore20_inBox (j : Fin 9) : inBox20 j (leaveBefore20 (start20 j)) := by
  have hg := geom20_facts j; dsimp only at hg
  have hfix : inBox20 j (entryLeave20 (start20 j) ++ selPrefix20 (start20 j)) := fun g hg' q hq => by
    unfold leaveBox20
    exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp (fixedBefore20_box j) g hg') q hq)
  have hadj : inBox20 j (leaveAdjust20 (start20 j)) := by
    unfold leaveAdjust20 leaveAdjustCore20 adjustG
    have hys : ∀ q ∈ (List.range (wpP20 (start20 j))).map (bankW20 (start20 j)), leaveBox20 (start20 j) q := by
      intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
      exact bankW20_inBox j i (by omega)
    have hcar : ∀ q ∈ (List.range (wpP20 (start20 j) - 1)).map (poolW20 (start20 j)), leaveBox20 (start20 j) q := by
      intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
      rcases pool20_cases j i with ⟨_, ep⟩ | ⟨_, ep⟩ <;>
        (rw [ep]; unfold leaveBox20; right; right; right; left; unfold Wire at *; omega)
    have h3 : leaveBox20 (start20 j) (e0P20 (start20 j) + 3) := by unfold leaveBox20; right; right; right; left; unfold Wire; omega
    have h6 : leaveBox20 (start20 j) (e0P20 (start20 j) + 6) := by unfold leaveBox20; right; right; right; left; unfold Wire; omega
    have h1601 : leaveBox20 (start20 j) 1601 := by unfold leaveBox20; right; right; right; left; decide
    have hcx : inBox20 j [.cx (e0P20 (start20 j) + 6) (e0P20 (start20 j) + 3)] := fun g hg' q hq => by
      simp only [List.mem_singleton] at hg'; subst hg'
      simp only [Gate.wires, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl; exact h6; exact h3
    exact inBox20_app hcx (inBox20_app (inBox20_cxsG h1601 hys) (inBox20_app (inBox20_addG _ _ _ hys hcar h3) (inBox20_cxsG h1601 hys)))
  have hsp : leaveBefore20 (start20 j) = (entryLeave20 (start20 j) ++ selPrefix20 (start20 j)) ++ leaveAdjust20 (start20 j) := by
    simp only [leaveBefore20, entryLeave20, selPrefix20, List.append_assoc]
  rw [hsp]; exact inBox20_app hfix hadj

private theorem events20_inBox : ∀ j : Fin 9,
