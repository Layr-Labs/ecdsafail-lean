-- Verified gate replacement helper: B84GateReplacement
section
namespace B84ReplacementResearch
open ECDSAAdd B84WindowResearch
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

def repair : Program := [.CX 4339 4404, .CX 4370 4404, .CX 4629 4404,
 .CX 4661 4404, .CX 4760 4404]

theorem xor_five (x a r0 r1 r2 r3 r4 : Bool)
 (h : (((((a ^^ r0) ^^ r1) ^^ r2) ^^ r3) ^^ r4) = false) :
 (x ^^ a) = (((((x ^^ r0) ^^ r1) ^^ r2) ^^ r3) ^^ r4) := by
 decide +kernel +revert

theorem repair_measurements : measurementCount repair = 0 := by decide +kernel

theorem state_ext {s t : State} (hp : s.phase=t.phase) (hb : s.basis=t.basis) : s=t := by
 cases s
 cases t
 cases hp
 cases hb
 rfl

theorem gate_replacement (s : State) (m : List Bool) (h : query s.basis = false) :
 run [.CCX 4660 4403 4404] m s = run repair m s := by
 have hv := xor_five (s.basis 4404) (s.basis 4660 && s.basis 4403)
  (s.basis 4339) (s.basis 4370) (s.basis 4629) (s.basis 4661) (s.basis 4760) h
 apply state_ext
 · simp [run,repair]
 · funext q
   by_cases hq : q=4404
   · subst q
     exact hv
   · simp [run,repair,writeBit,Function.update_apply,hq]

#print axioms gate_replacement
end B84ReplacementResearch

end


-- Verified gate replacement helper: B84ReplaceGeneric
section
namespace B84ReplaceGenericResearch
open ECDSAAdd B84WindowResearch B84ReplacementResearch
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

theorem after_prefix (pre post : Program)
 (h : ∀ (s : State) (m : List Bool), query (run pre m s).basis = false)
 (s : State) (m : List Bool) :
 run (pre ++ ([.CCX 4660 4403 4404] ++ post)) m s =
 run (pre ++ (repair ++ post)) m s := by
 conv_lhs => rw [run_append]
 conv_rhs => rw [run_append]
 have he := gate_replacement (run pre (m.take (measurementCount pre)) s) []
  (h s (m.take (measurementCount pre)))
 rw [run_append,run_append,repair_measurements]
 simpa only [measurementCount,List.take_zero,List.drop_zero] using
  congrArg (run post (m.drop (measurementCount pre))) he

theorem old_shape_of_lookup (p : Program) (i : Nat) (g : Instr)
 (h : p[i]? = some g) : p = p.take i ++ ([g] ++ p.drop (i+1)) := by
 obtain ⟨hi,hg⟩ := List.getElem?_eq_some_iff.mp h
 have hd := List.drop_eq_getElem_cons hi
 rw [hg] at hd
 exact (List.take_append_drop i p).symm.trans (congrArg (fun q => p.take i ++ q) hd)

def segment (p : Program) (start len : Nat) : Program :=
 ((p.drop start).take len).map B84WindowResearch.stripPhase

theorem segment_split (p : Program) (start n m : Nat) :
 segment p start (n+m) = segment p start n ++ segment p (start+n) m := by
 simp only [segment,List.take_add,List.map_append,List.drop_drop]

#print axioms after_prefix
end B84ReplaceGenericResearch

end


-- Verified gate replacement helper: B84ResourceGeneric
