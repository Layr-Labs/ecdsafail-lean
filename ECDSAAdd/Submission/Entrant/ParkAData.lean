-- Verified gate replacement helper: B84SupportGeneric
section
namespace B84SupportResearch
open ECDSAAdd ECDSAAdd.Arithmetic
set_option maxHeartbeats 10000000
set_option linter.unusedSimpArgs false

theorem instruction_wires_subset {p : Program} {i : Instr} (hi : i ∈ p) : i.wires ⊆ wires p := by
 induction p with
 | nil => simp at hi
 | cons j p ih =>
  rcases List.mem_cons.mp hi with h|h
  · subst j; exact Finset.subset_union_left
  · exact Finset.Subset.trans (ih h) Finset.subset_union_right

theorem context_support (p q : Program) (hs : wires q ⊆ wires p) (pre post : Program) :
 wires (pre ++ (q ++ post)) ⊆ wires (pre ++ (p ++ post)) := by
 simp only [wires_append]
 exact Finset.union_subset_union (Finset.Subset.refl _) (Finset.union_subset_union hs (Finset.Subset.refl _))

theorem replacement_support (pre old new post : Program)
 (hs : wires new ⊆ wires (pre ++ (old ++ post))) :
 wires (pre ++ (new ++ post)) ⊆ wires (pre ++ (old ++ post)) := by
 intro w hw
 simp only [wires_append,Finset.mem_union] at hw ⊢
 rcases hw with h | h | h
 · exact Or.inl h
 · have hh:=hs h; simpa only [wires_append,Finset.mem_union] using hh
 · exact Or.inr (Or.inr h)

theorem replacement_physical (pre old new post : Program)
 (hp : GatePhysical (pre ++ (old ++ post))) (hn : GatePhysical new) :
 GatePhysical (pre ++ (new ++ post)) := by
 simp only [gatePhysical_append] at hp ⊢
 exact ⟨hp.1,hn,hp.2.2⟩

#print axioms replacement_support
end B84SupportResearch

end


