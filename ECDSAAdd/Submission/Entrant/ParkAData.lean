theorem take_map_segment (p : Program) (a b : Nat) :
 (p.take (a+b)).map stripPhase = (p.take a).map stripPhase ++ B84ReplaceGenericResearch.segment p a b := by
 simp only [List.take_add,List.map_append,B84ReplaceGenericResearch.segment]

theorem condition_of_stripped (p pre : Program)
 (h : p.map stripPhase = pre ++ window) (s : State) (m : List Bool) :
 query (run p m s).basis = false := by
 rw [run_basis]
 rw [← basisRun_stripPhase p s.basis]
 rw [h,basisRun_append]
