set_option linter.unusedSimpArgs false

theorem repair_toffoli : toffoliCount repair = 0 := by decide +kernel
theorem repair_slots : gateSlots repair = 5 := by decide +kernel
theorem singleton_toffoli : toffoliCount [.CCX 4660 4403 4404] = 1 := rfl
theorem singleton_measurements : measurementCount [.CCX 4660 4403 4404] = 0 := rfl
theorem singleton_slots : gateSlots [.CCX 4660 4403 4404] = 1 := rfl

theorem slots_append (p q : Program) : gateSlots (p++q) = gateSlots p + gateSlots q := by
 simp [gateSlots,List.map_append,List.sum_append]

theorem one_less_toffoli (pre post : Program) :
 toffoliCount (pre ++ (repair ++ post)) + 1 =
 toffoliCount (pre ++ ([.CCX 4660 4403 4404] ++ post)) := by
 simp only [toffoliCount_append,repair_toffoli,singleton_toffoli]
 omega

theorem same_measurements (pre post : Program) :
 measurementCount (pre ++ (repair ++ post)) =
 measurementCount (pre ++ ([.CCX 4660 4403 4404] ++ post)) := by
 simp only [measurementCount_append,repair_measurements,singleton_measurements]

theorem four_more_slots (pre post : Program) :
 gateSlots (pre ++ (repair ++ post)) =
 gateSlots (pre ++ ([.CCX 4660 4403 4404] ++ post)) + 4 := by
 simp only [slots_append,repair_slots,singleton_slots]
 omega

#print axioms one_less_toffoli
#print axioms four_more_slots
end B84ResourceResearch

