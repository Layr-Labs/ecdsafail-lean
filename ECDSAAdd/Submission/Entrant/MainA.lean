    apply Equiv.swap_apply_of_ne_of_ne
    · intro e
      have :=pool_inj L hw hn 1800 1285 (by omega) (by omega) e
      omega
    · intro e
      have :=pool_inj L hw hn 1800 1537 (by omega) (by omega) e
