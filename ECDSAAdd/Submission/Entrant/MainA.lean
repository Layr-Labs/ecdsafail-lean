theorem firstPlacement_g0 : shifted (Placement5.pi 0) (base 0)=base 0 := by decide +kernel
theorem firstPlacement_parity : shifted (Placement5.pi 0) (base 768)=base 768 := by decide +kernel
theorem firstSig_g0 : OB5.sig 511 (base 0)=base 0 := by decide +kernel
theorem firstSig_parity : OB5.sig 511 (base 768)=base 768 := by decide +kernel

theorem wireFn2_parity (L : ControlledPointLayout) :
    wireFn2 L (base 768)=L.core.poolWire 768 := rfl

theorem wireFn2_g0 (L : ControlledPointLayout) :
    wireFn2 L (base 0)=L.core.poolWire 0 := rfl

theorem old_entryField_shape : FrontierEntry1591Field.entryField=
    renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS true) ++ entryTail := by
  simp only [FrontierEntry1591Field.entryField,FrontierSW1591.replayS,
    FrontierSW1591.logicalReplayS,if_true,renameProgram,List.map_append,entryTail,List.append_assoc]

theorem old_exitField_shape : FrontierEntry1591Field.exitField=
    exitHead ++ renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS false) := by
  simp only [FrontierEntry1591Field.exitField,FrontierSW1591.replayS,
    FrontierSW1591.logicalReplayS,Bool.false_eq_true,if_false,renameProgram,
    List.map_append,exitHead,List.append_assoc]

theorem entryTail_support : wires entryTail⊆wires FrontierEntry1591Field.entryField := by
  rw [old_entryField_shape,wires_append]
  exact Finset.subset_union_right

theorem exitHead_support : wires exitHead⊆wires FrontierEntry1591Field.exitField := by
  rw [old_exitField_shape,wires_append]
