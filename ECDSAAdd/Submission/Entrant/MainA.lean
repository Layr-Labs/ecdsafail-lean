    (ParityCodec5New.first_mapped_support (History5.historyMap base 0)).2

theorem firstBody_support (divide : Bool) :
    wires (firstBody divide)⊆(wires (FrontierSW1591.baseFirstPacketS divide)).erase (base 768) :=
  G0CarryLoan5.support_to (base 1028) (base 0) (base 768) _ _
    (old_body_sub divide)
    (old_codec_sub divide (codec_mem 1)) (old_codec_sub divide (codec_mem 0))
    (by decide) (by decide) (old_firstBody_g0_free divide)

theorem baseFirstPacket_support (divide : Bool) :
    wires (baseFirstPacket divide)⊆wires (FrontierSW1591.baseFirstPacketS divide) := by
  have dc:=firstDecode_support_eq.subset.trans (old_decode_sub divide)
  have en:=firstEncode_support_eq.subset.trans (old_codec_sub divide)
  have body:=(firstBody_support divide).trans (Finset.erase_subset _ _)
  intro q used
  simp only [baseFirstPacket,wires_append,Finset.mem_union] at used
  rcases used with used|used|used
  · exact dc used
  · exact body used
  · exact en used

theorem baseFirstPacket_768_free (divide : Bool) : base 768∉wires (baseFirstPacket divide) := by
  have dc : base 768∉wires firstDecode := by
    intro used
    have eq : wires (NewHistory5.decode base 0)=wires (NewHistory5.encode base 0) := by
      change wires (ParityCodec5New.decodeAt _)=wires (ParityCodec5New.encodeAt _)
      rw [(ParityCodec5New.supportAt_exact _).2,(ParityCodec5New.supportAt_exact _).1]
    exact codec_not768 _ (firstDecode_support_eq.subset.trans eq.subset) used
  have en:=codec_not768 _ firstEncode_support_eq.subset
  have body:=G0CarryLoan5.avoids_carry (base 1028) (base 0) (base 768)
    (FrontierSW1591.firstBodyS divide) (by decide) (by decide) (old_firstBody_g0_free divide)
  simpa only [baseFirstPacket,wires_append,Finset.mem_union,not_or] using
    And.intro dc (And.intro body en)

