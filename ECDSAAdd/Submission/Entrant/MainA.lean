    (D : Fp → Program) (S P : Program)
    (df : ∀ c k,k ∈ genericOmissions → L.core.poolWire k ∉ wires (D c))
    (sf : ∀ k,k ∈ genericOmissions → L.core.poolWire k ∉ wires S)
