private theorem rename_sub (f : Wire→Wire) (P Q : Program) (sub : wires P⊆wires Q) :
    wires (renameProgram f P)⊆wires (renameProgram f Q) := by
  rw [renameProgram_support,renameProgram_support]
  exact Finset.image_mono f sub

private theorem rename_away (f : Wire→Wire) (hf : Function.Injective f)
    (a b : Wire) (P : Program) (fix : f a=b) (free : a∉wires P) :
    b∉wires (renameProgram f P) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨old,used,eq⟩:=Finset.mem_image.mp used
  exact free (hf (eq.trans fix.symm) ▸ used)

private theorem append_sub (P Q A B : Program) (p : wires P⊆wires A)
    (q : wires Q⊆wires B) : wires (P++Q)⊆wires (A++B) := by
