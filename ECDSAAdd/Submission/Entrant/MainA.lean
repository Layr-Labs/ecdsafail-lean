-- ===== ECDSAAdd.Submission.Entrant.Prefix1590Program =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.FrontierEntry1591KernelProgram
-- consolidated import: import ECDSAAdd.Submission.Entrant.G0CarryLoan5
-- consolidated import: import ECDSAAdd.Submission.Entrant.PrefixZero1590Circuit

set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Prefix1590
open Arithmetic MappedCompressed DirectSkywalk
attribute [local irreducible] wires run

def borrow : Equiv.Perm Wire := Equiv.swap (base 768) (base 0)

def firstBody (divide : Bool) : Program :=
  G0CarryLoan5.program (base 1028) (base 0) (base 768)
    (FrontierSW1591.firstBodyS divide)

def firstDecode : Program :=
  ParityCodec5New.decodeAtFirst (History5.historyMap base 0)

def firstEncode : Program :=
  ParityCodec5New.encodeAtFirst (History5.historyMap base 0)

def baseFirstPacket (divide : Bool) : Program :=
  firstDecode ++ (firstBody divide ++ firstEncode)

def firstPacket (divide : Bool) : Program :=
  renameProgram (shifted (Placement5.pi 0)) (baseFirstPacket divide)

def placedFirstPacket (divide : Bool) : Program :=
  renameProgram (OB5.sig 511) (firstPacket divide)

def entryTail : Program :=
  renameProgram (OB5.sig 511)
    (FrontierSW1591.groupsS true 1 101 ++ FrontierSW1591.endPacketS true) ++
      (HalfFieldOB5.copyN ++ OwnQ5Endpoint.canonT)

def exitHead : Program :=
