    (Prefix1590Square.physical L hw hn)

theorem support_eq (L : ControlledPointLayout) :
    wires (program L)=(wires (Prefix1590Square.program L)).image (swap L) := by
  unfold program
  exact renameProgram_support _ _

theorem support (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    wires (program L)⊆(OB5Support.sites L).toFinset := by
  unfold program swap
  exact OwnDiagAll12Placed.swap_support _ _ _ _ (Prefix1590Square.support L hw hn)
    (List.mem_toFinset.mpr (OB5Support.pool_in_sites L _ (OB5Support.pool_mem L 718
      (Or.inr (Or.inl ⟨by omega,by omega⟩)))))
    (List.mem_toFinset.mpr (OB5Support.pool_in_sites L _ (OB5Support.pool_mem L 907
      (Or.inr (Or.inl ⟨by omega,by omega⟩)))))

theorem retired_free (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.core.poolWire 718∉wires (program L) := by
  unfold program swap
  exact OwnDiagAll12Placed.swap_target_free _ _ _ (spare_free L hw hn)

theorem retired_free718 (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.core.poolWire 718∉wires (program L) := retired_free L hw hn

private theorem values_unique {L : ControlledPointLayout} {X Y : Fp} {G : Bool}
    {origin a b : BasisState} (ha : PointDialogValues L X Y G origin a)
    (hb : PointDialogValues L X Y G origin b) : a=b := by
  funext q
  by_cases hx : q∈L.point.x
  · exact (regValue_eq_iff _ _ _).mp (ha.x.trans hb.x.symm) q hx
  · by_cases hy : q∈L.point.y
    · exact (regValue_eq_iff _ _ _).mp (ha.y.trans hb.y.symm) q hy
    · have away : q∉L.point.x++L.point.y := by
        simpa only [List.mem_append,not_or] using And.intro hx hy
      exact (ha.rest q away).trans (hb.rest q away).symm

/-- Complete State equality for independent old and new measurement streams. -/
theorem state_eq (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (X Y : Fp) (G : Bool) (origin : BasisState) (s : State) (m mOld : List Bool)
    (v : PointDialogValues L X Y G origin s.basis) :
    run (program L) m s=run (Prefix1590Square.program L) mOld s := by
  have fresh := correct L hw hn X Y G origin s m v
  have prior := Prefix1590Square.correct L hw hn X Y G origin s mOld v
  apply State.extensionality
  · exact fresh.1.trans prior.1.symm
  · exact values_unique fresh.2 prior.2

theorem square_free (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (k : Nat) (hk : k∈[1800,766,765,767,770,1285,1286,769,768,718]) :
    L.core.poolWire k∉wires (program L) := by
  by_cases h : k=718
  · subst k
    exact retired_free L hw hn
  have hkold : k∈[1800,766,765,767,770,1285,1286,769,768] := by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hk ⊢
    omega
  have fix : swap L (L.core.poolWire k)=L.core.poolWire k :=
    pool_swap_fix L hw hn 718 907 k (by omega) (by omega)
      (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hkold;omega) h
      (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hkold;omega)
  unfold program
  exact OwnPlusHost.rename_avoid _ _ _ fix (Prefix1590Square.square_free L hw hn k hkold)

theorem old_free (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (k : Nat) (hk : k∈[1800,766,765,767,770,1285,1286,769,768]) :
    L.core.poolWire k∉wires (program L) :=
  square_free L hw hn k (by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hk ⊢
    omega)

end ECDSAAdd.Entrant.ControlLoan1589Square
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.ControlLoan1589Program =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.FrontierEntry1591Callers
-- consolidated import: import ECDSAAdd.Submission.Entrant.Prefix1590Program
-- consolidated import: import ECDSAAdd.Submission.Entrant.ControlLoan1589Loan
-- consolidated import: import ECDSAAdd.Submission.Entrant.ControlLoan1589Square

/-! Fixed V142 control-loan program. Proofs are in separate modules. -/

namespace ECDSAAdd.Entrant.ControlLoan1589
open Arithmetic Secp256k1 Challenge Baselines ControlledPointLayout
  MappedCompressed CompressedPointDialog CompressedAllocation
  CompressedFieldSupport DirectSkywalk BalancedField History5 EntryFuse EntryFuseFinite

/-- Placement5.pi j sends this raw carry to post-placement label718. -/
def packetCarry (j : Nat) : Wire := base (516 + 2*j)

def halfWindow (divide : Bool) (j : Nat) (g : Wire) : Program :=
  loanWindow g (base 2409) (packetCarry j)
    (Q6EndpointCell.half divide base (base 2409))

def cell (divide : Bool) (j : Nat) (g sw : Wire) : Program :=
  if divide then
    halfWindow true j g ++ SW.selW sw (base 2409) FrontierSW1591.swapBody
  else
    SW.selW sw (base 2409) FrontierSW1591.swapBody ++ halfWindow false j g

def rawReplay (divide : Bool) (j : Nat) : List MixedTranscriptLetter → Program
  | [] => []
  | l::ls =>
      if divide then cell true j l.1.1 l.1.2 ++ rawReplay true j ls
      else rawReplay false j ls ++ cell false j l.1.1 l.1.2

def basePacket (divide : Bool) (j : Nat) : Program :=
  NewHistory5.decode base (5*j) ++
    rawReplay divide j (Replay5.letters j) ++
    NewHistory5.encode base (5*j)

def packet (divide : Bool) (j : Nat) : Program :=
  renameProgram (shifted (Placement5.pi j)) (basePacket divide j)

def groups (divide : Bool) (j n : Nat) : Program :=
  PacketSequence.program divide (packet divide) j n

/-- G0 has no half-kernel. Retain its existing first-swap specialization. -/
def firstBody (divide : Bool) : Program :=
  if divide then
    FrontierSW1591.firstSwapS ++ rawReplay true 0 Replay5.restLetters
  else
    rawReplay false 0 Replay5.restLetters ++ FrontierSW1591.firstSwapMS

/-- Retain the Q1590 first-trit loan of parity carry768 onto G0. -/
def firstBorrowedBody (divide : Bool) : Program :=
  G0CarryLoan5.program (base 1028) (base 0) (base 768) (firstBody divide)

def firstPacket (divide : Bool) : Program :=
  renameProgram (shifted (Placement5.pi 0))
    (Prefix1590.firstDecode ++ firstBorrowedBody divide ++ Prefix1590.firstEncode)

def placedFirstPacket (divide : Bool) : Program :=
  renameProgram (OB5.sig 511) (firstPacket divide)

/-- At either conversion boundary the ordinary selector is clean and unused. -/
def endpointBorrow : Equiv.Perm Wire :=
  Equiv.swap (base 718) (base 2409)

def center : Program := renameProgram endpointBorrow OwnQ5Endpoint.centerT
def canon : Program := renameProgram endpointBorrow OwnQ5Endpoint.canonT

/-- The pi0 end packet already omits718 and is deliberately unchanged. -/
def entryTail : Program :=
  renameProgram (OB5.sig 511)
    (groups true 1 101 ++ FrontierSW1591.endPacketS true) ++
      (HalfFieldOB5.copyN ++ canon)

def exitHead : Program :=
  center ++ (HalfFieldOB5.copyN ++
    renameProgram (OB5.sig 511)
      (FrontierSW1591.endPacketS false ++ groups false 1 101))

def entryField : Program :=
  placedFirstPacket true ++
    (Prefix1590.prefixProgram ++
      (renameProgram Prefix1590.borrow entryTail ++ Prefix1590.unprefix))

def exitField : Program :=
  Prefix1590.prefixProgram ++
    (renameProgram Prefix1590.borrow exitHead ++
      (Prefix1590.unprefix ++ placedFirstPacket false))

def entryFieldHosted : Program :=
  ParityField1591.program FrontierEntry1591Field.controls
    FrontierEntry1591Field.work FrontierEntry1591Field.host
    (FrontierEntry1591Field.hosted entryField)

def exitFieldHosted : Program :=
  ParityField1591.program FrontierEntry1591Field.controls
    FrontierEntry1591Field.work FrontierEntry1591Field.host
    (FrontierEntry1591Field.hosted exitField)

/-- All three exchanges act on distinct pairs; only the 1026 host changes. -/
def phaseHost : Equiv.Perm Wire :=
  (Equiv.swap (base 1026) (base 721)).trans
    ((Equiv.swap (base 1541) (base 719)).trans
      (Equiv.swap (base 1542) (base 720)))

def kernel (F : Program) : Program :=
  renameProgram phaseHost FrontierEntry1591Kernel.firstPhase ++
    (F ++ renameProgram phaseHost FrontierEntry1591Kernel.lastPhase)

def entryKernel : Program := kernel entryFieldHosted
def exitKernel : Program := kernel exitFieldHosted

/--907 is an unused square normFlag site after blockPerm202, and is already
counted by the other program segments. This is a static renaming, not a SWAP. -/
def square (L : ControlledPointLayout) : Program := ControlLoan1589Square.program L

def gen (L : ControlledPointLayout) (cx cy : Fp) : Program :=
  All12Generic.gen L (FrontierEntry1591Callers.division entryKernel L)
    (square L) (FrontierEntry1591Callers.exit exitKernel L) cx cy

/-- Complete program, with the protected contract and existing wrapper unchanged. -/
def program (C : Point) : Program :=
  match C with
  | .zero => []
  | @WeierstrassCurve.Affine.Point.some _ _ _ cx cy _ =>
      Edges.wrapper layout C cy (gen layout cx cy)

def candidateEntry : Challenge.Entry := fun C => normalizeProgram (program C)

end ECDSAAdd.Entrant.ControlLoan1589
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.FrontierEntry1591FieldControl =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.FrontierEntry1591Endpoints
-- consolidated import: import ECDSAAdd.Submission.Entrant.FrontierEntry1591Replay

set_option maxRecDepth 20000
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.FrontierEntry1591
open Arithmetic MappedCompressed Secp256k1 BalancedField OffsetBorrowedCanonical
attribute [local irreducible] run wires

private theorem control_not_block (start len : Nat) (bound : start+len≤2400) :
    base 2400∉wireBlock base start len := by
  intro used
  obtain ⟨i,hi,eq⟩ := List.mem_map.mp used
  have same := base_injective eq
  simp only [List.mem_range'_1] at hi
  omega

private theorem encoder_control_free : base 2400∉wires (NewHistory5.allEncode base 102) := by
  intro used
  have mem := List.mem_toFinset.mp (NewHistory5.allEncode_history_support base 102 (by decide) used)
  simp only [List.mem_append] at mem
  rcases mem with mem|mem
  all_goals
    obtain ⟨i,hi,eq⟩ := List.mem_map.mp mem
    have same := base_injective eq
    simp only [List.mem_range'_1] at hi
    omega

private theorem pair_control_set (r y : List Wire) (hr : base 2400∉r) (hy : base 2400∉y)
    (origin bits : BasisState) (A B : Nat) (value : Bool) (frame : PairFrame r y origin A B bits) :
    PairFrame r y (writeBit origin (base 2400) value) A B (writeBit bits (base 2400) value) := by
  have same (qs : List Wire) (off : base 2400∉qs) :
      regValue qs (writeBit bits (base 2400) value)=regValue qs bits := by
    apply regValue_congr
    intro q hq
    have ne : q≠base 2400 := fun eq => off (eq ▸ hq)
    simp only [writeBit,Function.update_of_ne ne]
  refine ⟨(same r hr).trans frame.1,(same y hy).trans frame.2.1,?_⟩
  intro q qr qy
  by_cases eq : q=base 2400
  · subst q
    simp only [writeBit,Function.update_self]
  · simpa only [writeBit,Function.update_of_ne eq] using frame.2.2 q qr qy

theorem run_control_set (P : Program) (off : base 2400∉wires P)
    (s : State) (m : List Bool) (value : Bool) :
    run P m ⟨s.phase,writeBit s.basis (base 2400) value⟩=
      ⟨(run P m s).phase,writeBit (run P m s).basis (base 2400) value⟩ := by
  let t : State := ⟨s.phase,writeBit s.basis (base 2400) value⟩
  have agrees := pool_run_agrees P (wires P) (Finset.Subset.refl _) m t s rfl (by
    intro q hq
    have ne : q≠base 2400 := fun eq => off (eq ▸ hq)
    simp only [t,writeBit,Function.update_of_ne ne])
  apply State.extensionality
  · exact agrees.1
  · funext q
    change (run P m t).basis q=writeBit (run P m s).basis (base 2400) value q
    by_cases eq : q=base 2400
    · subst q
      simpa only [t,writeBit,Function.update_self] using run_preserves_outside P m t _ off
    · have update : writeBit (run P m s).basis (base 2400) value q=(run P m s).basis q := by
        simp only [writeBit,Function.update_of_ne eq]
      rw [update]
      by_cases used : q∈wires P
      · exact agrees.2 q used
      · exact (run_preserves_outside P m t q used).trans
          ((show t.basis q=s.basis q from by simp only [t,writeBit,Function.update_of_ne eq]).trans
            (run_preserves_outside P m s q used).symm)

theorem run_control_unset (P : Program) (off : base 2400∉wires P)
    (s : State) (m : List Bool) (value : Bool) :
    run P m s=⟨(run P m ⟨s.phase,writeBit s.basis (base 2400) value⟩).phase,
      writeBit (run P m ⟨s.phase,writeBit s.basis (base 2400) value⟩).basis
        (base 2400) (s.basis (base 2400))⟩ := by
  rw [run_control_set P off s m value]
  apply State.extensionality
  · rfl
  · funext q
    by_cases eq : q=base 2400
    · subst q
      simpa only [writeBit,Function.update_self] using run_preserves_outside P m s _ off
    · simp only [writeBit,Function.update_of_ne eq]

private theorem pull_control_set (s : State) (value : Bool) :
    pullState (OB5.sig 511) ⟨s.phase,writeBit s.basis (base 2400) value⟩=
      ⟨(pullState (OB5.sig 511) s).phase,
        writeBit (pullState (OB5.sig 511) s).basis (base 2400) value⟩ := by
  apply State.extensionality
  · rfl
  · funext q
    by_cases eq : q=base 2400
    · subst q
      change writeBit s.basis (base 2400) value (OB5.sig 511 (base 2400))=
        writeBit (pullState (OB5.sig 511) s).basis (base 2400) value (base 2400)
      rw [OneFlagSW.selSig_2400]
      simp only [writeBit,Function.update_self]
    · have ne : OB5.sig 511 q≠base 2400 := fun h => eq
        (OB5.sig_injective 511 (by decide) (h.trans OneFlagSW.selSig_2400.symm))
      simp only [pullState,writeBit,Function.update_of_ne eq,Function.update_of_ne ne]

theorem frame_control_set (origin : BasisState) (X Y : Fp) (s : State) (value : Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin X Y s) :
    NewFieldFrameOB5.EncodedFieldFrame (writeBit origin (base 2400) value) X Y
      ⟨s.phase,writeBit s.basis (base 2400) value⟩ := by
  obtain ⟨raw,phase,frame,encoded⟩ := input
  refine ⟨⟨raw.phase,writeBit raw.basis (base 2400) value⟩,phase,?_,?_⟩
  · apply pair_control_set _ _ _ _ origin raw.basis _ _ value frame
    · rw [balancedSharedPorts_r]
      exact control_not_block 2056 256 (by decide)
    · rw [balancedSharedPorts_y]
      exact control_not_block 770 256 (by decide)
  · rw [pull_control_set,encoded,run_control_set _ encoder_control_free]

theorem canonical_control_set (origin : BasisState) (X Y : Fp) (s : State) (value : Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin X Y s) :
    NewFieldFrameOB5.EncodedCanonicalFrame (writeBit origin (base 2400) value) X Y
      ⟨s.phase,writeBit s.basis (base 2400) value⟩ := by
  obtain ⟨raw,phase,frame,encoded⟩ := input
  refine ⟨⟨raw.phase,writeBit raw.basis (base 2400) value⟩,phase,?_,?_⟩
  · apply pair_control_set _ _ _ _ origin raw.basis _ _ value frame
    · rw [skywalkShared_field_z]
      exact control_not_block 2056 257 (by decide)
    · exact control_not_block 770 257 (by decide)
  · rw [pull_control_set,encoded,run_control_set _ encoder_control_free]

theorem context_control_set (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (value : Bool) : FrontierReplay1591.Context (writeBit origin (base 2400) value) := by
  refine ⟨ctx.hn,ctx.ho,ctx.hp,ctx.hf,?_,?_,?_,?_,?_⟩
  · simpa only [writeBit,Function.update_of_ne (show base 2409≠base 2400 from by decide)] using ctx.hg0
  · simpa only [writeBit,Function.update_of_ne (show base 2410≠base 2400 from by decide)] using ctx.hs0
  · exact env_write base (base 2400) (ctx.ho _ (by simp)) origin value ctx.env
  · intro j hj
    have same (q : Fin 10) :
        (writeBit origin (base 2400) value) (History5.historyMap base (5*j) q)=
          origin (History5.historyMap base (5*j) q) := by
      have bound := History5.historyId_bound (5*j) (by omega) q
      have ne : History5.historyMap base (5*j) q≠base 2400 := by
        intro eq
        have eq := base_injective eq
        omega
      simp only [writeBit,Function.update_of_ne ne]
    apply (MeasuredCodec5.legalAt_iff _ _).mpr
    intro i
    rw [same,same]
    exact (MeasuredCodec5.legalAt_iff _ _).mp (ctx.legal j hj) i
  · simpa only [writeBit,Function.update_of_ne (show base 2312≠base 2400 from by decide)] using ctx.parity

theorem source_zero_control_set (origin : BasisState) (value : Bool)
    (ha : regValue (skywalkSharedField base).a origin=0) :
    regValue (skywalkSharedField base).a (writeBit origin (base 2400) value)=0 := by
  apply Eq.trans (regValue_congr _ _ _ ?_) ha
  intro q hq
  have ne : q≠base 2400 := fun eq => control_not_block 770 257 (by decide) (eq ▸ hq)
  simp only [writeBit,Function.update_of_ne ne]

theorem trace_control_set (origin : BasisState) (value : Bool) :
    skywalkTapeControls (writeBit origin (base 2400) value) (skywalkSharedTape base)=
      skywalkTapeControls origin (skywalkSharedTape base) := by
  simp only [skywalkTapeControls,skywalkSharedTape,List.map_map]
  apply List.map_congr_left
  intro i hi
  have bound := List.mem_range.mp hi
  have first : base i≠base 2400 := by intro eq; have same := base_injective eq; omega
  have second : base (1028+i)≠base 2400 := by intro eq; have same := base_injective eq; omega
  simp only [Function.comp_apply,writeBit,Function.update_of_ne first,Function.update_of_ne second]

theorem parity_host_control_set (controls : List Wire) (host : Wire)
    (away : host≠base 2400) (off : base 2400∉controls) (s : State) (value : Bool)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    (writeBit s.basis (base 2400) value) host=
      TraceParity5.parity (controls.map (writeBit s.basis (base 2400) value)) := by
  have same : controls.map (writeBit s.basis (base 2400) value)=controls.map s.basis := by
    apply List.map_congr_left
    intro q hq
    have ne : q≠base 2400 := fun eq => off (eq ▸ hq)
    simp only [writeBit,Function.update_of_ne ne]
  rw [same]
  simpa only [writeBit,Function.update_of_ne away] using parity

end ECDSAAdd.Entrant.FrontierEntry1591
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.FrontierEntry1591FieldFrames =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.FrontierEntry1591Field
-- consolidated import: import ECDSAAdd.Submission.Entrant.FrontierEntry1591FieldControl

set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.FrontierEntry1591Field
open Arithmetic MappedCompressed Secp256k1 BalancedField OffsetBorrowedCanonical
attribute [local irreducible] run wires

def entryPlain : Program :=
  FrontierReplay1591.replay true ++ (HalfFieldOB5.copyN ++ OwnQ5Endpoint.canonT)

def exitPlain : Program :=
  OwnQ5Endpoint.centerT ++ (HalfFieldOB5.copyN ++ FrontierReplay1591.replay false)

theorem entry_sel : SW.Sel (base 2400) 1020 entryField entryPlain := by
  have tail : base 2400∉wires (HalfFieldOB5.copyN++OwnQ5Endpoint.canonT) := by
    intro used
    apply OneFlagEntryRaw.selField5.away
    change base 2400∈wires (OneFlagSW.replayS true++(HalfFieldOB5.copyN++OwnQ5Endpoint.canonT))
    rw [wires_append]
    exact Finset.mem_union_right _ used
  exact ((FrontierSW1591.selReplay_sel true).append (SW.Sel.refl _ _ tail)).cast
    (by omega) rfl rfl

theorem exit_sel : SW.Sel (base 2400) 1020 exitField exitPlain := by
  have leftPart : base 2400∉wires (OwnQ5Endpoint.centerT++HalfFieldOB5.copyN) := by
    intro used
    apply OneFlagExitRaw.selField.away
    change base 2400∈wires (OwnQ5Endpoint.centerT++(HalfFieldOB5.copyN++OneFlagSW.replayS false))
    simp only [wires_append] at used ⊢
    rcases Finset.mem_union.mp used with h|h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ (Finset.mem_union_left _ h)
  have h := (SW.Sel.refl _ _ leftPart).append (FrontierSW1591.selReplay_sel false)
  simpa only [entryField,exitField,exitPlain,List.append_assoc,Nat.zero_add] using h

theorem entryPlain_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (A : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin A 0 s) :
    (run entryPlain m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin
        (2*(if origin (base 2400) then A/(x:Fp) else A)) 0 (run entryPlain m s) := by
  let Z := if origin (base 2400) then A/(x:Fp) else A
  have result := run_three_states (FrontierReplay1591.replay true) HalfFieldOB5.copyN OwnQ5Endpoint.canonT
    (fun a d => NewFieldFrameOB5.EncodedFieldFrame origin A 0 a →
      d.phase=a.phase ∧ NewFieldFrameOB5.EncodedCanonicalFrame origin (2*Z) 0 d) (by
      intro a b c d m1 m2 m3 h1 h2 h3 hin
      have first := FrontierReplay1591.forward_frame origin ctx x hx0 hx trace A a m1 hin
      rw [h1] at first
      have middle := NewHalfFieldOB5.copy_clear ctx.hn origin Z b m2 first.2
      rw [h2] at middle
      have last := NewOwnQ5Endpoint.canon_frame ctx.hn (ctx.hp _ (by simp)) origin
        ctx.env ctx.legal ctx.parity ha Z c m3 middle.2
      change (run OwnQ5Endpoint.canonT m3 c).phase=c.phase ∧
        NewFieldFrameOB5.EncodedCanonicalFrame origin (2*Z) 0 (run OwnQ5Endpoint.canonT m3 c) at last
      rw [h3] at last
      exact ⟨last.1.trans (middle.1.trans first.1),last.2⟩) s m
  exact result input

theorem exitPlain_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s) :
    (run exitPlain m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin
        (if origin (base 2400) then Y/2*(x:Fp) else Y/2) 0 (run exitPlain m s) := by
  let Z := if origin (base 2400) then Y/2*(x:Fp) else Y/2
  have result := run_three_states OwnQ5Endpoint.centerT HalfFieldOB5.copyN (FrontierReplay1591.replay false)
    (fun a d => NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 a →
      d.phase=a.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin Z 0 d) (by
      intro a b c d m1 m2 m3 h1 h2 h3 hin
      have first := NewOwnQ5Endpoint.center_frame ctx.hn (ctx.hp _ (by simp)) origin
        ctx.env ctx.legal ctx.parity ha Y a m1 hin
      change (run OwnQ5Endpoint.centerT m1 a).phase=a.phase ∧
        NewFieldFrameOB5.EncodedFieldFrame origin (Y/2) 0 (run OwnQ5Endpoint.centerT m1 a) at first
      rw [h1] at first
      have middle := NewHalfFieldOB5.copy_fill ctx.hn origin (Y/2) b m2 first.2
      rw [h2] at middle
      have last := FrontierReplay1591.inverse_frame origin ctx x hx0 hx trace (Y/2) c m3 middle.2
      rw [h3] at last
      exact ⟨last.1.trans (middle.1.trans first.1),last.2⟩) s m
  exact result input

