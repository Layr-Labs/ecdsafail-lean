private theorem old_firstBody_sel (divide : Bool) :
    SW.Sel (base 2400) 9 (FrontierSW1591.firstBodyS divide) (FrontierReplay1591.firstBody divide) := by
  have rest := FrontierSW1591.selRaw_sel divide Replay5.restLetters FrontierSW1591.selRest_nodup
  have len : Replay5.restLetters.length=4 := by simp [Replay5.restLetters]
  rw [len] at rest
  cases divide
  · simpa only [FrontierSW1591.firstBodyS,FrontierReplay1591.firstBody,Bool.false_eq_true,if_false] using
      (rest.append FrontierSW1591.selFirstSwapM_sel).cast (by norm_num) rfl rfl
  · simpa only [FrontierSW1591.firstBodyS,FrontierReplay1591.firstBody,if_true] using
      (FrontierSW1591.selFirstSwap_sel.append rest).cast (by norm_num) rfl rfl

attribute [local irreducible] FrontierSW1591.firstBodyS

private theorem old_firstBody_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (FrontierSW1591.firstBodyS divide)
      (PairFrame rawR rawY origin (centerWord (Replay5.firstPayload divide origin (X,Y)).1)
        (centerWord (Replay5.firstPayload divide origin (X,Y)).2)) := by
  intro s m input
  rw [((old_firstBody_sel divide).eq m s (raw_enabled origin enabled _ _ s input)).1]
  exact FrontierReplay1591.firstBody_frame divide origin ctx X Y hz s m input

private theorem firstBody_eq (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (s : State) (m : List Bool)
    (input : PairFrame rawR rawY origin (centerWord X) (centerWord Y) s.basis) :
    run (firstBody divide) m s=run (FrontierSW1591.firstBodyS divide) m s := by
  cases divide
  · simpa only [firstBody,FrontierSW1591.firstBodyS,Bool.false_eq_true,if_false] using
      append_right_eq (rawReplay false 0 Replay5.restLetters)
        (FrontierSW1591.rawReplayS false Replay5.restLetters) FrontierSW1591.firstSwapMS s m
        (rawReplay_measurements false 0 Replay5.restLetters)
        (fun records => rawReplay_eq false 0 (by decide) _ rest_indices (rest_layout origin ctx)
          origin ctx enabled X Y s records input)
  · let A : Fp := if origin (base 1028) then Y else X
    let B : Fp := if origin (base 1028) then X else Y
    have swap : Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
        FrontierSW1591.firstSwapS (PairFrame rawR rawY origin (centerWord A) (centerWord B)) := by
      simpa only [FrontierSW1591.firstSwapS,Nat.add_zero] using old_swap_frame 0 (by decide) origin ctx enabled X Y
    have result := append_frame_eq FrontierSW1591.firstSwapS FrontierSW1591.firstSwapS
      (rawReplay true 0 Replay5.restLetters) (FrontierSW1591.rawReplayS true Replay5.restLetters)
      (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (PairFrame rawR rawY origin (centerWord A) (centerWord B)) rfl (fun _ _ _ => rfl) swap
      (fun a records hin => rawReplay_eq true 0 (by decide) _ rest_indices (rest_layout origin ctx)
        origin ctx enabled A B a records hin) s m input
    simpa only [firstBody,FrontierSW1591.firstBodyS,if_true] using result

private theorem firstBody_support (divide : Bool) :
    wires (firstBody divide)⊆wires (FrontierSW1591.firstBodyS divide) := by
  have rest := rawReplay_support divide 0 (by decide) _ rest_indices
  cases divide
  · simpa only [firstBody,FrontierSW1591.firstBodyS,Bool.false_eq_true,if_false] using
      append_support _ _ _ _ rest (Finset.Subset.refl _)
  · simpa only [firstBody,FrontierSW1591.firstBodyS,if_true] using
      append_support _ _ _ _ (Finset.Subset.refl _) rest

private theorem firstBody_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y)) (firstBody divide)
      (PairFrame rawR rawY origin (centerWord (Replay5.firstPayload divide origin (X,Y)).1)
        (centerWord (Replay5.firstPayload divide origin (X,Y)).2)) := by
  intro s m input
  rw [firstBody_eq divide origin ctx enabled X Y s m input]
  exact old_firstBody_frame divide origin ctx enabled X Y hz s m input

private theorem firstBorrowedBody_support (divide : Bool) :
    wires (firstBorrowedBody divide)⊆wires (Prefix1590.firstBody divide) := by
  have middle := rename_support (Equiv.swap (base 768) (base 0)) _ _ (firstBody_support divide)
  unfold firstBorrowedBody Prefix1590.firstBody G0CarryLoan5.program
  exact append_support _ _ _ _
    (append_support _ _ _ _ (Finset.Subset.refl _) middle) (Finset.Subset.refl _)

theorem firstBorrowedBody_read_support (divide : Bool) :
    wires (firstBorrowedBody divide)⊆
      NewHistory5.groupReadSites base (base 2400) (base 2409) (base 2410) 0 ∪ {base 2312} :=
  (firstBorrowedBody_support divide).trans (Prefix1590.firstBody_read_support divide)

private theorem firstBorrowedBody_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0)
    (first : (origin (base 0)).toNat+2*(origin (base 1028)).toNat<3 ∧
      (origin (base 0)=true ∨ origin (base 1028)=true)) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y)) (firstBorrowedBody divide)
      (PairFrame rawR rawY origin (centerWord (Replay5.firstPayload divide origin (X,Y)).1)
        (centerWord (Replay5.firstPayload divide origin (X,Y)).2)) := by
  have correct := firstBody_frame divide origin ctx enabled X Y hz
  have outside (q : Nat) (hq : q=0 ∨ q=768 ∨ q=1028) :
      base q∉wireBlock base 2056 256 ∧ base q∉wireBlock base 770 256 :=
    ⟨OwnPlusHost.not_block q 2056 256 (by omega),OwnPlusHost.not_block q 770 256 (by omega)⟩
  have clean : origin (base 768)=false :=
    NewOwnPlusEndpoint.env_zero origin ctx.env ctx.parity 768 (Or.inr rfl)
  have off : base 0∉wires (firstBody divide) :=
    fun used => Prefix1590.old_firstBody_g0_free divide (firstBody_support divide used)
  have borrowed := G0CarryLoan5.pair_frame
    (wireBlock base 2056 256) (wireBlock base 770 256) origin
    (centerWord X) (centerWord Y)
    (centerWord (Replay5.firstPayload divide origin (X,Y)).1)
    (centerWord (Replay5.firstPayload divide origin (X,Y)).2)
    (base 1028) (base 0) (base 768) (firstBody divide) (by decide) (by decide)
    (outside 1028 (by simp)) (outside 0 (by simp)) (outside 768 (by simp))
    off clean first.1 first.2 (by simpa only [rawR,rawY,balancedSharedPorts_r,balancedSharedPorts_y] using correct)
  simpa only [firstBorrowedBody,rawR,rawY,balancedSharedPorts_r,balancedSharedPorts_y] using borrowed

theorem firstPacket_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (x : Nat) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0)
    (s : State) (m : List Bool) (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    (run (firstPacket divide) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (Replay5.firstPayload divide origin (X,Y)).1 (Replay5.firstPayload divide origin (X,Y)).2
        (run (firstPacket divide) m s) := by
  let P := Prefix1590.firstDecode++(firstBorrowedBody divide++Prefix1590.firstEncode)
  have first := Prefix1590.first_trit_of_trace origin ctx x hx trace
  have fresh := Prefix1590.first_window_frame origin ctx X Y _ _ (firstBorrowedBody divide)
    (firstBorrowedBody_read_support divide)
    (firstBorrowedBody_frame divide origin ctx enabled X Y hz first) first.2 s m input
  have placed := Replay5.placed_eq (Placement5.pi 0) P
    (fun q hq => Placement5.pi_outside 0 q (by decide) hq) s m
    (NewHistory5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp))
      origin ctx.env ctx.legal X Y s input)
    (NewHistory5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp))
      origin ctx.env ctx.legal _ _ _ fresh.2)
  have same : run (firstPacket divide) m s=run P m s := by
    simpa only [firstPacket,P,List.append_assoc] using placed
  rw [same]
  exact fresh

theorem placedFirstPacket_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (x : Nat) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0)
    (s : State) (m : List Bool) (input : NewFieldFrameOB5.EncodedFieldFrame origin X Y s) :
    (run (placedFirstPacket divide) m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin
        (Replay5.firstPayload divide origin (X,Y)).1 (Replay5.firstPayload divide origin (X,Y)).2
        (run (placedFirstPacket divide) m s) :=
  NewFieldFrameOB5.placed_step (firstPacket divide) origin X Y _ _
    (fun a records h => firstPacket_frame divide origin ctx enabled x hx trace X Y hz a records h) s m input

private theorem placed_field_unique (origin : BasisState) (X Y : Fp) (s t : State)
    (hs : NewFieldFrameOB5.EncodedFieldFrame origin X Y s)
    (ht : NewFieldFrameOB5.EncodedFieldFrame origin X Y t) (phase : s.phase=t.phase) : s=t := by
  have pulled := encoded_field_unique origin X Y (pullState (OB5.sig 511) s) (pullState (OB5.sig 511) t)
    hs ht phase
  apply State.extensionality
  · exact phase
  · funext q
    have equal := congrArg (fun u : State => u.basis (OB5.sig 511 q)) pulled
    simpa only [pullState,OB5.sig_invol 511 (by decide)] using equal

private theorem placed_canonical_unique (origin : BasisState) (X Y : Fp) (s t : State)
    (hs : NewFieldFrameOB5.EncodedCanonicalFrame origin X Y s)
    (ht : NewFieldFrameOB5.EncodedCanonicalFrame origin X Y t) (phase : s.phase=t.phase) : s=t := by
  have pulled := NewHistory5.encoded_canonical_unique origin X Y
    (pullState (OB5.sig 511) s) (pullState (OB5.sig 511) t) hs ht phase
  apply State.extensionality
  · exact phase
  · funext q
    have equal := congrArg (fun u : State => u.basis (OB5.sig 511 q)) pulled
    simpa only [pullState,OB5.sig_invol 511 (by decide)] using equal

/-- The retained G0 loan and every record segment agree with the old first packet. -/
theorem placedFirstPacket_run_eq_old (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (x : Nat) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0)
    (s : State) (m n : List Bool) (input : NewFieldFrameOB5.EncodedFieldFrame origin X Y s) :
    run (placedFirstPacket divide) m s=run (Prefix1590.placedFirstPacket divide) n s := by
  have a := placedFirstPacket_frame divide origin ctx enabled x hx trace X Y hz s m input
  have b := Prefix1590.placedFirstPacket_frame divide origin ctx enabled x hx trace X Y hz s n input
  exact placed_field_unique origin _ _ _ _ a.2 b.2 (a.1.trans b.1.symm)



theorem packet_support (divide : Bool) (j : Nat) (hj : j<102) :
    wires (packet divide j)⊆wires (FrontierSW1591.packetS divide j) := by
  have raw := rawReplay_support divide j hj _ (letters_indices j hj)
  have body : wires (basePacket divide j)⊆wires (FrontierSW1591.basePacketS divide j) := by
    unfold basePacket FrontierSW1591.basePacketS
    exact append_support _ _ _ _
      (append_support _ _ _ _ (Finset.Subset.refl _) raw) (Finset.Subset.refl _)
  simpa only [packet,FrontierSW1591.packetS] using
    rename_support (shifted (Placement5.pi j)) _ _ body

theorem groups_support (divide : Bool) (j n : Nat) (bound : j+n≤102) :
    wires (groups divide j n)⊆wires (FrontierSW1591.groupsS divide j n) := by
  induction n generalizing j with
  | zero => exact Finset.Subset.refl _
  | succ n ih =>
    have head := packet_support divide j (by omega)
    have tail := ih (j+1) (by omega)
    cases divide
    · simpa only [groups,FrontierSW1591.groupsS,PacketSequence.program,
        Bool.false_eq_true,if_false] using append_support _ _ _ _ tail head
    · simpa only [groups,FrontierSW1591.groupsS,PacketSequence.program,if_true] using
        append_support _ _ _ _ head tail

theorem placedFirstPacket_support (divide : Bool) :
    wires (placedFirstPacket divide)⊆wires (Prefix1590.placedFirstPacket divide) := by
  have body : wires (Prefix1590.firstDecode++(firstBorrowedBody divide++Prefix1590.firstEncode))⊆
      wires (Prefix1590.baseFirstPacket divide) := by
    unfold Prefix1590.baseFirstPacket
    exact append_support _ _ _ _ (Finset.Subset.refl _)
      (append_support _ _ _ _ (firstBorrowedBody_support divide) (Finset.Subset.refl _))
  have packetSub := rename_support (shifted (Placement5.pi 0)) _ _ body
  simpa only [placedFirstPacket,firstPacket,Prefix1590.placedFirstPacket,Prefix1590.firstPacket,
    Prefix1590.baseFirstPacket,List.append_assoc] using rename_support (OB5.sig 511) _ _ packetSub

private theorem selW_free (source flag q : Wire) (P : Program)
    (hs : q≠source) (hf : q≠flag) (off : q∉wires P) :
    q∉wires (SW.selW source flag P) := by
  simp [SW.selW,wires_append,wires,Instr.wires,correctionWires,hs,hf,off]

private theorem carry_swap_free (j : Nat) (hj : j<102) :
    packetCarry j∉wires FrontierSW1591.swapBody := by
  intro used
  have member := swapRegisters_wires (base 2409) rawR rawY (by
    rw [rawR,rawY,balancedSharedPorts_r,balancedSharedPorts_y,wireBlock_length,wireBlock_length]) used
  have away := work_away (packetCarry j) (packetCarry_mem_work j hj)
  simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at member
  rcases member with eq|used|used
  · exact (HostOB5.host_ne (516+2*j) 2409 (by omega)) eq
  · exact away.1 used
  · exact away.2 used

private theorem cell_carry_free (divide : Bool) (j i : Nat) (hj : j<102) (hi : i<510) :
    packetCarry j∉wires (cell divide j (base i) (base (1028+i))) := by
  have half := halfWindow_avoids_carry divide j i hj hi
  have swap := selW_free (base (1028+i)) (base 2409) (packetCarry j) FrontierSW1591.swapBody
    (HostOB5.host_ne _ _ (by omega)) (HostOB5.host_ne _ _ (by omega)) (carry_swap_free j hj)
  cases divide
  · simpa only [cell,Bool.false_eq_true,if_false,wires_append,Finset.mem_union,not_or] using
      And.intro swap half
  · simpa only [cell,if_true,wires_append,Finset.mem_union,not_or] using And.intro half swap

private theorem rawReplay_carry_free (divide : Bool) (j : Nat) (hj : j<102)
    (ls : List MixedTranscriptLetter) (indices : Indexed ls) :
    packetCarry j∉wires (rawReplay divide j ls) := by
  induction ls with
  | nil => simp [rawReplay,wires]
  | cons l ls ih =>
    obtain ⟨i,hi,hg,hs⟩ := indices l (by simp)
    have head : packetCarry j∉wires (cell divide j l.1.1 l.1.2) := by
      rw [hg,hs]
      exact cell_carry_free divide j i hj hi
    have tail := ih (fun q hq => indices q (List.mem_cons_of_mem l hq))
    cases divide
    · simpa only [rawReplay,Bool.false_eq_true,if_false,wires_append,Finset.mem_union,not_or] using
        And.intro tail head
    · simpa only [rawReplay,if_true,wires_append,Finset.mem_union,not_or] using And.intro head tail

private theorem codec_carry_free (j : Nat) (hj : j<102) (start : Nat) (bound : start+5≤512)
    (P : Program) (shape : P=NewHistory5.encode base start ∨ P=NewHistory5.decode base start) :
    packetCarry j∉wires P := by
  intro used
  obtain ⟨q,eq⟩ := NewHistory5.history_gate_mem base start P shape _ used
  have same := base_injective eq
  have region := History5.historyId_region start bound q
  change 516+2*j=History5.historyId start q at same
  omega

private theorem basePacket_carry_free (divide : Bool) (j : Nat) (hj : j<102) :
    packetCarry j∉wires (basePacket divide j) := by
  have dc := codec_carry_free j hj (5*j) (by omega) _ (Or.inr rfl)
  have en := codec_carry_free j hj (5*j) (by omega) _ (Or.inl rfl)
  have body := rawReplay_carry_free divide j hj _ (letters_indices j hj)
  simpa only [basePacket,wires_append,Finset.mem_union,not_or] using And.intro (And.intro dc body) en

private theorem rename_avoids_image (f : Wire→Wire) (hf : Function.Injective f)
    (P : Program) (q : Wire) (off : q∉wires P) : f q∉wires (renameProgram f P) := by
  intro used
  rw [renameProgram_support] at used
  obtain ⟨a,ha,eq⟩ := Finset.mem_image.mp used
  exact off (hf eq ▸ ha)

private theorem placed_carry (j : Nat) (hj : j<102) :
    shifted (Placement5.pi j) (packetCarry j)=base 718 := by
  change shifted (Placement5.pi j) (base (516+2*j))=base 718
  rw [shifted_base]
  have selected := Placement5.pi_selected_odd j hj
  have raw : Placement5.W (2*j+1)=516+2*j := by unfold Placement5.W;omega
  rw [raw] at selected
  exact congrArg base selected

theorem packet_718_free (divide : Bool) (j : Nat) (hj : j<102) :
    base 718∉wires (packet divide j) := by
  rw [←placed_carry j hj]
  exact rename_avoids_image _ (shifted (Placement5.pi j)).injective _ _
    (basePacket_carry_free divide j hj)

theorem groups_718_free (divide : Bool) (j n : Nat) (bound : j+n≤102) :
    base 718∉wires (groups divide j n) := by
  induction n generalizing j with
  | zero => simp [groups,PacketSequence.program,wires]
  | succ n ih =>
    have head := packet_718_free divide j (by omega)
    have tail := ih (j+1) (by omega)
    cases divide
    · simpa only [groups,PacketSequence.program,Bool.false_eq_true,if_false,
        wires_append,Finset.mem_union,not_or] using And.intro tail head
    · simpa only [groups,PacketSequence.program,if_true,wires_append,Finset.mem_union,not_or] using
        And.intro head tail

private theorem firstBody_carry_free (divide : Bool) :
    packetCarry 0∉wires (firstBody divide) := by
  have rest := rawReplay_carry_free divide 0 (by decide) _ rest_indices
  have swap := selW_free (base 1028) (base 2409) (packetCarry 0) FrontierSW1591.swapBody
    (by decide) (by decide) (carry_swap_free 0 (by decide))
  have swapM : packetCarry 0∉wires FrontierSW1591.firstSwapMS := by
    apply selW_free _ _ _ _ (by decide) (by decide)
    simpa only [FrontierSW1591.swapBodyM,UncompSwap.mswap_wires,FrontierSW1591.swapBody] using
      carry_swap_free 0 (by decide)
  cases divide
  · simpa only [firstBody,Bool.false_eq_true,if_false,wires_append,Finset.mem_union,not_or] using
      And.intro rest swapM
  · simpa only [firstBody,if_true,wires_append,Finset.mem_union,not_or] using And.intro swap rest

private theorem first_raw_carry_free (divide : Bool) :
    packetCarry 0∉wires (Prefix1590.firstDecode++firstBorrowedBody divide++Prefix1590.firstEncode) := by
  have body := G0CarryLoan5.avoids_other (base 1028) (base 0) (base 768) (packetCarry 0)
    (firstBody divide) (by decide) (by decide) (by decide) (firstBody_carry_free divide)
  have dc : packetCarry 0∉wires Prefix1590.firstDecode := by
    intro used
    have sub := (ParityCodec5New.first_mapped_support (History5.historyMap base 0)).2.subset
    exact codec_carry_free 0 (by decide) 0 (by decide) _ (Or.inr rfl) (sub used)
  have en : packetCarry 0∉wires Prefix1590.firstEncode := by
    intro used
    have sub := (ParityCodec5New.first_mapped_support (History5.historyMap base 0)).1.subset
    exact codec_carry_free 0 (by decide) 0 (by decide) _ (Or.inl rfl) (sub used)
  simpa only [firstBorrowedBody,wires_append,Finset.mem_union,not_or] using And.intro (And.intro dc body) en

theorem placedFirstPacket_718_free (divide : Bool) :
    base 718∉wires (placedFirstPacket divide) := by
  have first : base 718∉wires (firstPacket divide) := by
    rw [←placed_carry 0 (by decide)]
    exact rename_avoids_image _ (shifted (Placement5.pi 0)).injective _ _ (first_raw_carry_free divide)
  have fix : OB5.sig 511 (base 718)=base 718 := by decide +kernel
  rw [←fix]
  exact rename_avoids_image _ (OB5.sig_injective 511 (by decide)) _ _ first



private theorem append_support_extra (P Q P0 Q0 : Program) (extra : Wire)
    (hp : wires P⊆wires P0∪{extra}) (hq : wires Q⊆wires Q0∪{extra}) :
    wires (P++Q)⊆wires (P0++Q0)∪{extra} := by
  rw [wires_append,wires_append]
  intro q hq'
  rcases Finset.mem_union.mp hq' with h|h
  · rcases Finset.mem_union.mp (hp h) with h|h
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ h)
    · exact Finset.mem_union_right _ h
  · rcases Finset.mem_union.mp (hq h) with h|h
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ h)
    · exact Finset.mem_union_right _ h

private theorem rename_support_extra (f : Wire→Wire) (P Q : Program) (extra : Wire)
    (fixed : f extra=extra) (sub : wires P⊆wires Q∪{extra}) :
    wires (renameProgram f P)⊆wires (renameProgram f Q)∪{extra} := by
  rw [renameProgram_support,renameProgram_support]
  intro q used
  obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp used
  rcases Finset.mem_union.mp (sub ha) with old|fresh
  · exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨a,old,rfl⟩)
  · have eq : a=extra := Finset.mem_singleton.mp fresh
    subst a
    exact Finset.mem_union_right _ (Finset.mem_singleton.mpr fixed)

private theorem endpoint_support_extra (P : Program) (free : base 2409∉wires P) :
    wires (renameProgram endpointBorrow P)⊆wires P∪{base 2409} := by
  rw [renameProgram_support]
  intro q used
  obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp used
  by_cases eq : a=base 718
  · subst a
    exact Finset.mem_union_right _ (by simp only [endpointBorrow,Equiv.swap_apply_left,Finset.mem_singleton])
  have away : a≠base 2409 := fun eq => free (eq ▸ ha)
  rw [endpointBorrow,Equiv.swap_apply_of_ne_of_ne eq away]
  exact Finset.mem_union_left _ ha

theorem entryTail_support : wires entryTail⊆wires Prefix1590.entryTail∪{base 2409} := by
  have body : wires (groups true 1 101++FrontierSW1591.endPacketS true)⊆
      wires (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true) :=
    append_support _ _ _ _ (groups_support true 1 101 (by decide)) (Finset.Subset.refl _)
  have replay : wires (renameProgram (OB5.sig 511) (groups true 1 101++FrontierSW1591.endPacketS true))⊆
      wires (renameProgram (OB5.sig 511)
        (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true))∪{base 2409} :=
    (rename_support (OB5.sig 511) _ _ body).trans Finset.subset_union_left
  have endpoint := endpoint_support_extra OwnQ5Endpoint.canonT endpoint_2409_free.2
  have tail := append_support_extra HalfFieldOB5.copyN canon HalfFieldOB5.copyN
    OwnQ5Endpoint.canonT (base 2409) Finset.subset_union_left endpoint
  simpa only [entryTail,Prefix1590.entryTail] using append_support_extra _ _ _ _ (base 2409) replay tail

theorem exitHead_support : wires exitHead⊆wires Prefix1590.exitHead∪{base 2409} := by
  have body : wires (FrontierSW1591.endPacketS false++groups false 1 101)⊆
      wires (FrontierSW1591.endPacketS false++FrontierSW1591.groupsS false 1 101) :=
    append_support _ _ _ _ (Finset.Subset.refl _) (groups_support false 1 101 (by decide))
  have replay : wires (renameProgram (OB5.sig 511) (FrontierSW1591.endPacketS false++groups false 1 101))⊆
      wires (renameProgram (OB5.sig 511)
        (FrontierSW1591.endPacketS false++FrontierSW1591.groupsS false 1 101))∪{base 2409} :=
    (rename_support (OB5.sig 511) _ _ body).trans Finset.subset_union_left
  have tail := append_support_extra HalfFieldOB5.copyN _ HalfFieldOB5.copyN _ (base 2409)
    Finset.subset_union_left replay
  simpa only [exitHead,Prefix1590.exitHead] using append_support_extra _ _ _ _ (base 2409)
    (endpoint_support_extra OwnQ5Endpoint.centerT endpoint_2409_free.1) tail

private theorem payload_not_selector (i : Fin 8) : Prefix1590.payload0 i≠base 2409 := by
  fin_cases i <;> decide +kernel

theorem entryTail_payload_free (i : Fin 8) : Prefix1590.payload0 i∉wires entryTail := by
  intro used
  rcases Finset.mem_union.mp (entryTail_support used) with old|fresh
  · exact Prefix1590.entryTail_payload_free i old
  · exact payload_not_selector i (Finset.mem_singleton.mp fresh)

theorem exitHead_payload_free (i : Fin 8) : Prefix1590.payload0 i∉wires exitHead := by
  intro used
  rcases Finset.mem_union.mp (exitHead_support used) with old|fresh
  · exact Prefix1590.exitHead_payload_free i old
  · exact payload_not_selector i (Finset.mem_singleton.mp fresh)


private theorem logical_entry_tail_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin
      (Replay5.firstPayload true origin (Y,0)).1 (Replay5.firstPayload true origin (Y,0)).2 s) :
    (run (groups true 1 101++FrontierSW1591.endPacketS true) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin (Y/(x:Fp)) (Y/(x:Fp))
        (run (groups true 1 101++FrontierSW1591.endPacketS true) m s) := by
  let mg:=m.take (measurementCount (groups true 1 101))
  let me:=m.drop (measurementCount (groups true 1 101))
  let mid:=run (groups true 1 101) mg s
  have g := groups_frame true 1 101 (by decide) origin ctx enabled _ _ s mg input
  have oldE := ((FrontierSW1591.selEnd_sel true).eq me mid
    ((Prefix1590.logical_control origin _ _ mid g.2).trans enabled)).1
  have payload:=Replay5.forward_payload origin x Y hx0 hx trace
  have e:=FrontierReplay1591.endPacket_frame true origin ctx _ _ (fun _ => by
    rw [Prod.mk.eta,payload]
    exact (congrArg Prod.snd payload).symm.trans (by simp only [Replay5.endPayload])) mid me g.2
  rw [←oldE] at e
  rw [run_append]
  refine ⟨e.1.trans g.1,?_⟩
  simpa only [Prod.mk.eta,Replay5.forward_payload origin x Y hx0 hx trace,enabled,if_true] using e.2

theorem entryTail_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin
      (Replay5.firstPayload true origin (Y,0)).1 (Replay5.firstPayload true origin (Y,0)).2 s) :
    (run entryTail m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 (run entryTail m s) := by
  have result:=run_three_states
    (renameProgram (OB5.sig 511) (groups true 1 101++FrontierSW1591.endPacketS true))
    HalfFieldOB5.copyN canon
    (fun a d => NewFieldFrameOB5.EncodedFieldFrame origin
      (Replay5.firstPayload true origin (Y,0)).1 (Replay5.firstPayload true origin (Y,0)).2 a →
      d.phase=a.phase ∧ NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 d) (by
      intro a b c d m1 m2 m3 h1 h2 h3 hin
      have first:=NewFieldFrameOB5.placed_step
        (groups true 1 101++FrontierSW1591.endPacketS true) origin _ _ _ _
        (fun raw records h => logical_entry_tail_frame origin ctx enabled x hx0 hx trace Y raw records h)
        a m1 hin
      rw [h1] at first
      have middle:=NewHalfFieldOB5.copy_clear ctx.hn origin (Y/(x:Fp)) b m2 first.2
      rw [h2] at middle
      have last := canon_frame origin ctx ha (Y/(x:Fp)) c m3 middle.2
      rw [h3] at last
      exact ⟨last.1.trans (middle.1.trans first.1),last.2⟩) s m
  simpa only [entryTail] using result input

theorem entryField_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin Y 0 s) :
    (run entryField m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 (run entryField m s) := by
  let mp:=m.take (measurementCount (placedFirstPacket true))
  let mt:=m.drop (measurementCount (placedFirstPacket true))
  let mid:=run (placedFirstPacket true) mp s
  have first:=placedFirstPacket_frame true origin ctx enabled x hx trace Y 0
    (fun e => absurd e (by decide)) s mp input
  have tail:=entryTail_frame origin ctx ha enabled x hx0 hx trace Y mid (mt.drop 5) first.2
  have before:=Prefix1590.field_prefix_codes origin ctx _ _ mid first.2 x hx0 hx trace
  have after:=Prefix1590.canonical_prefix_codes origin ctx _ _ (run entryTail (mt.drop 5) mid) tail.2 x hx0 hx trace
  have window:=Prefix1590.prefix_window_run_eq entryTail
    (Prefix1590.prefixProgram++(renameProgram Prefix1590.borrow entryTail++Prefix1590.unprefix)) rfl entryTail_payload_free mid mt
    before.1 before.2.1 after.1 after.2.1
    (Prefix1590.field_768_zero origin ctx _ _ mid first.2)
    (Prefix1590.canonical_768_zero origin ctx _ _ (run entryTail (mt.drop 5) mid) tail.2)
    (Prefix1590.prefix_zero_of_codes mid before)
  rw [entryField,run_append,window]
  exact ⟨tail.1.trans first.1,tail.2⟩


private theorem exit_append_frame (P Q : Program) (A B C : State → Prop)
    (first : ∀s m,A s → (run P m s).phase=s.phase ∧ B (run P m s))
    (second : ∀s m,B s → (run Q m s).phase=s.phase ∧ C (run Q m s))
    (s : State) (m : List Bool) (input : A s) :
    (run (P++Q) m s).phase=s.phase ∧ C (run (P++Q) m s) := by
  simp only [run_append]
  have a:=first s (m.take (measurementCount P)) input
  have b:=second (run P (m.take (measurementCount P)) s) (m.drop (measurementCount P)) a.2
  exact ⟨b.1.trans a.1,b.2⟩

private theorem exit_state_transport (P : State → Prop) (a b : State)
    (eq : a=b) (result : P b) : P a := by
  cases eq
  exact result

private theorem exit_program_transport (P Q : Program) (eq : P=Q)
    (s : State) (m : List Bool) (A : State → Prop) (result : A (run Q m s)) :
    A (run P m s) := by
  cases eq
  exact result

def exitHeadPayload (origin : BasisState) (Y : Fp) : Fp×Fp :=
  Replay5.groupsPayload false origin 1 101 (Replay5.endPayload false origin (Y/2,Y/2))

theorem logicalExitHead_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    (run (FrontierSW1591.endPacketS false++groups false 1 101) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (Replay5.groupsPayload false origin 1 101 (Replay5.endPayload false origin (X,Y))).1
        (Replay5.groupsPayload false origin 1 101 (Replay5.endPayload false origin (X,Y))).2
        (run (FrontierSW1591.endPacketS false++groups false 1 101) m s) := by
  let E:=Replay5.endPayload false origin (X,Y)
  let G:=Replay5.groupsPayload false origin 1 101 E
  have selected := FrontierSW1591.selEnd_sel false
  have ending (t : State) (records : List Bool)
      (h : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y t) :
      (run (FrontierSW1591.endPacketS false) records t).phase=t.phase ∧
        NewHistory5.EncodedFieldFrame5 base (base 2409) origin E.1 E.2
          (run (FrontierSW1591.endPacketS false) records t) := by
    rw [(selected.eq records t ((encoded_control origin X Y t h).trans enabled)).1]
    exact FrontierReplay1591.endPacket_frame false origin ctx X Y
      (fun bad => absurd bad (by decide)) t records h
  exact exit_append_frame (FrontierSW1591.endPacketS false) (groups false 1 101)
    (NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y)
    (NewHistory5.EncodedFieldFrame5 base (base 2409) origin E.1 E.2)
    (NewHistory5.EncodedFieldFrame5 base (base 2409) origin G.1 G.2) ending
    (fun t records h => by
      simpa only [Prod.mk.eta] using groups_frame false 1 101 (by decide)
        origin ctx enabled E.1 E.2 t records h) s m input

theorem exitHead_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (enabled : origin (base 2400)=true) (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s) :
    (run exitHead m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin (exitHeadPayload origin Y).1
        (exitHeadPayload origin Y).2 (run exitHead m s) := by
  have result:=run_three_states center HalfFieldOB5.copyN
    (renameProgram (OB5.sig 511)
      (FrontierSW1591.endPacketS false++groups false 1 101))
    (fun a d => NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 a →
      d.phase=a.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin
        (exitHeadPayload origin Y).1 (exitHeadPayload origin Y).2 d) (by
      intro a b c d m1 m2 m3 h1 h2 h3 hin
      have first := center_frame origin ctx ha Y a m1 hin
      rw [h1] at first
      have middle:=NewHalfFieldOB5.copy_fill ctx.hn origin (Y/2) b m2 first.2
      rw [h2] at middle
      have last:=NewFieldFrameOB5.placed_step
        (FrontierSW1591.endPacketS false++groups false 1 101)
        origin (Y/2) (Y/2) (exitHeadPayload origin Y).1 (exitHeadPayload origin Y).2
        (logicalExitHead_frame origin ctx enabled (Y/2) (Y/2)) c m3 middle.2
      rw [h3] at last
      exact ⟨last.1.trans (middle.1.trans first.1),last.2⟩) s m
  exact exit_program_transport exitHead _ (by unfold exitHead;rfl) s m
    (fun out => out.phase=s.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin
      (exitHeadPayload origin Y).1 (exitHeadPayload origin Y).2 out) (result input)

theorem exitHead_first_zero (origin : BasisState) (x : Nat) (Y : Fp)
    (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    (Replay5.firstPayload false origin (exitHeadPayload origin Y)).2=0 := by
  simpa only [exitHeadPayload] using
    congrArg Prod.snd (Replay5.inverse_payload origin x (Y/2) hx0 hx trace)


theorem exitHead_borrow_run_eq (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (enabled : origin (base 2400)=true) (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s) :
    run (Prefix1590.prefixProgram++(renameProgram Prefix1590.borrow exitHead++Prefix1590.unprefix)) m s=run exitHead (m.drop 5) s := by
  have old:=exitHead_frame origin ctx ha enabled Y s (m.drop 5) input
  have before:=Prefix1590.canonical_prefix_codes origin ctx Y 0 s input x hx0 hx trace
  have after:=Prefix1590.field_prefix_codes origin ctx _ _ (run exitHead (m.drop 5) s) old.2 x hx0 hx trace
  exact Prefix1590.prefix_window_run_eq exitHead _ rfl exitHead_payload_free s m
    before.1 before.2.1 after.1 after.2.1
    (Prefix1590.canonical_768_zero origin ctx Y 0 s input)
    (Prefix1590.field_768_zero origin ctx _ _ _ old.2) (Prefix1590.prefix_zero_of_codes s before)

theorem exitField_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (enabled : origin (base 2400)=true) (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s) :
    (run exitField m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin (Y/2*(x:Fp)) 0 (run exitField m s) := by
  let W:=Prefix1590.prefixProgram++(renameProgram Prefix1590.borrow exitHead++Prefix1590.unprefix)
  let H:=exitHeadPayload origin Y
  let F:=Replay5.firstPayload false origin H
  have result:=exit_append_frame W (placedFirstPacket false)
    (NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0)
    (NewFieldFrameOB5.EncodedFieldFrame origin H.1 H.2)
    (NewFieldFrameOB5.EncodedFieldFrame origin F.1 F.2)
    (fun t records h => by
      have old:=exitHead_frame origin ctx ha enabled Y t (records.drop 5) h
      exact exit_state_transport
        (fun out => out.phase=t.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin H.1 H.2 out) _ _
        (exitHead_borrow_run_eq origin ctx ha x hx0 hx trace enabled Y t records h) old)
    (fun t records h => by
      have zero : (Replay5.firstPayload false origin (H.1,H.2)).2=0 := by
        simpa only [H,Prod.mk.eta] using exitHead_first_zero origin x Y hx0 hx trace
      simpa only [F,Prod.mk.eta] using placedFirstPacket_frame false origin ctx enabled x hx trace
        H.1 H.2 (fun _ => zero) t records h) s m input
  have payload : F=(Y/2*(x:Fp),0) := by
    simpa only [F,H,exitHeadPayload,enabled,if_true] using
      Replay5.inverse_payload origin x (Y/2) hx0 hx trace
  have finished : (run (W++placedFirstPacket false) m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin (Y/2*(x:Fp)) 0
        (run (W++placedFirstPacket false) m s) := by
    simpa only [payload] using result
  have shape : exitField=W++placedFirstPacket false := by
    dsimp only [W]
    unfold exitField
    simp only [List.append_assoc]
  exact exit_program_transport exitField _ shape s m
    (fun out => out.phase=s.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin (Y/2*(x:Fp)) 0 out)
    finished




/-- The full entry restores the same state for every measurement record. -/
theorem entryField_run_eq_old (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m n : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin Y 0 s) :
    run entryField m s=run Prefix1590.entryField n s := by
  have fresh := entryField_frame origin ctx ha enabled x hx0 hx trace Y s m input
  have old := Prefix1590.entryField_frame origin ctx ha enabled x hx0 hx trace Y s n input
  exact placed_canonical_unique origin _ _ _ _ fresh.2 old.2 (fresh.1.trans old.1.symm)

/-- The full exit restores the same state for every measurement record. -/
theorem exitField_run_eq_old (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (enabled : origin (base 2400)=true) (Y : Fp) (s : State) (m n : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s) :
    run exitField m s=run Prefix1590.exitField n s := by
  have fresh := exitField_frame origin ctx ha x hx0 hx trace enabled Y s m input
  have old := Prefix1590.exitField_frame origin ctx ha x hx0 hx trace enabled Y s n input
  exact placed_field_unique origin _ _ _ _ fresh.2 old.2 (fresh.1.trans old.1.symm)

theorem entryField_support : wires entryField⊆wires Prefix1590.entryField∪{base 2409} := by
  have fixed : Prefix1590.borrow (base 2409)=base 2409 := by decide +kernel
  have body := rename_support_extra Prefix1590.borrow _ _ (base 2409) fixed entryTail_support
  have last := append_support_extra _ Prefix1590.unprefix _ Prefix1590.unprefix (base 2409)
    body Finset.subset_union_left
  have tail := append_support_extra Prefix1590.prefixProgram _ Prefix1590.prefixProgram _
    (base 2409) Finset.subset_union_left last
  simpa only [entryField,Prefix1590.entryField] using append_support_extra _ _ _ _ (base 2409)
    ((placedFirstPacket_support true).trans Finset.subset_union_left) tail

theorem exitField_support : wires exitField⊆wires Prefix1590.exitField∪{base 2409} := by
  have fixed : Prefix1590.borrow (base 2409)=base 2409 := by decide +kernel
  have body := rename_support_extra Prefix1590.borrow _ _ (base 2409) fixed exitHead_support
  have last := append_support_extra Prefix1590.unprefix _ Prefix1590.unprefix _ (base 2409)
    Finset.subset_union_left ((placedFirstPacket_support false).trans Finset.subset_union_left)
  have tail := append_support_extra _ _ _ _ (base 2409) body last
  simpa only [exitField,Prefix1590.exitField] using append_support_extra Prefix1590.prefixProgram _
    Prefix1590.prefixProgram _ (base 2409) Finset.subset_union_left tail

private theorem hosted_support_extra (P Q : Program)
    (sub : wires P⊆wires Q∪{base 2409}) :
    wires (FrontierEntry1591Field.hosted P)⊆wires (FrontierEntry1591Field.hosted Q) := by
  intro q used
  simp only [FrontierEntry1591Field.hosted,wires_append,Finset.mem_union] at used ⊢
  rcases used with start|body|last
  · exact Or.inl start
  · rw [renameProgram_support] at body
    obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp body
    rcases Finset.mem_union.mp (sub ha) with old|extra
    · exact Or.inr (Or.inl (by rw [renameProgram_support];exact Finset.mem_image.mpr ⟨a,old,rfl⟩))
    · have eq : a=base 2409 := Finset.mem_singleton.mp extra
      subst a
      exact Or.inl (by decide +kernel)
  · exact Or.inr (Or.inr last)

private theorem parity_support_mono (P Q : Program) (sub : wires P⊆wires Q) :
    wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host P)⊆
    wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host Q) := by
  unfold ParityField1591.program ParityHostTransport5.program
  exact append_support _ _ _ _ (append_support _ _ _ _ (Finset.Subset.refl _)
    (rename_support _ _ _ sub)) (Finset.Subset.refl _)

theorem entryHosted_support :
    wires (FrontierEntry1591Field.hosted entryField)⊆wires Prefix1590.entryHosted :=
  hosted_support_extra _ _ entryField_support

theorem exitHosted_support :
    wires (FrontierEntry1591Field.hosted exitField)⊆wires Prefix1590.exitHosted :=
  hosted_support_extra _ _ exitField_support

theorem entryFieldHosted_support : wires entryFieldHosted⊆wires Prefix1590.entry :=
  parity_support_mono _ _ entryHosted_support

theorem exitFieldHosted_support : wires exitFieldHosted⊆wires Prefix1590.exit :=
  parity_support_mono _ _ exitHosted_support

private abbrev entryHostedRaw : Program := FrontierEntry1591Field.hosted entryField
private abbrev exitHostedRaw : Program := FrontierEntry1591Field.hosted exitField

open FrontierEntry1591Field (controls work host numerator field_canonical_outside
  controls_away_numerator field_special_at controls_away_control canonical_numerator_value)

private theorem entryHosted_avoids_host : host∉wires entryHostedRaw :=
  fun used => FrontierEntry1591Field.entryHosted_avoids_host
    (Prefix1590.entryHosted_subset (entryHosted_support used))

private theorem exitHosted_avoids_host : host∉wires exitHostedRaw :=
  fun used => FrontierEntry1591Field.exitHosted_avoids_host
    (Prefix1590.exitHosted_subset (exitHosted_support used))

private theorem raw_free_extra (P Q : Program) (sub : wires P⊆wires Q∪{base 2409})
    (q : Wire) (away : q≠base 2409) (off : q∉wires Q) : q∉wires P := by
  intro used
  rcases Finset.mem_union.mp (sub used) with old|extra
  · exact off old
  · exact away (Finset.mem_singleton.mp extra)


theorem entryField_768_free : base 768∉wires entryField :=
  raw_free_extra _ _ entryField_support _ (by decide) Prefix1590.entryField_768_free

theorem exitField_768_free : base 768∉wires exitField :=
  raw_free_extra _ _ exitField_support _ (by decide) Prefix1590.exitField_768_free

private theorem entryField_hosts_free : base 511∉wires entryField ∧ base 1542∉wires entryField :=
  ⟨raw_free_extra _ _ entryField_support _ (by decide)
      (fun used => FrontierEntry1591Field.entryField_host_free.1 (Prefix1590.entryField_subset used)),
    raw_free_extra _ _ entryField_support _ (by decide)
      (fun used => FrontierEntry1591Field.entryField_host_free.2 (Prefix1590.entryField_subset used))⟩

private theorem exitField_hosts_free : base 511∉wires exitField ∧ base 1542∉wires exitField :=
  ⟨raw_free_extra _ _ exitField_support _ (by decide)
      (fun used => FrontierEntry1591Field.exitField_host_free.1 (Prefix1590.exitField_subset used)),
    raw_free_extra _ _ exitField_support _ (by decide)
      (fun used => FrontierEntry1591Field.exitField_host_free.2 (Prefix1590.exitField_subset used))⟩

private theorem entry_control_free : base 2400∉wires entryFieldHosted :=
  fun used => FrontierEntry1591Field.entry_control_away (Prefix1590.entry_subset (entryFieldHosted_support used))

private theorem exit_control_away : base 2400∉wires exitFieldHosted :=
  fun used => Prefix1590.exit_control_away (exitFieldHosted_support used)


theorem entry_run_eq (s : State) (m : List Bool)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis))
    (workIn : s.basis work=false) (workOut : (run entryHostedRaw m s).basis work=false)
    (payload : ∀q∈controls,(run entryHostedRaw m s).basis q=s.basis q) :
    run entryFieldHosted m s=run entryHostedRaw m s :=
  ParityField1591.run_eq controls work host entryHostedRaw s m (by decide)
    FrontierEntry1591Field.host_not_controls entryHosted_avoids_host parity workIn workOut payload

theorem entry_core_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (enabled : origin (base 2400)=true) (Z : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin Z 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis work=false)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    (run entryFieldHosted m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Z/(x:Fp))) 0 (run entryFieldHosted m s) := by
  have result := entryField_frame origin ctx ha enabled x hx0 hx trace Z s m input
  have outside := field_canonical_outside origin ctx ha Z _ s _ input result.2 result.1
  have g0 : s.basis (base 2409)=false := by
    have bit := field_special_at origin Z 0 s 2409 (by simp) input
    have fix : OB5.sig 511 (base 2409)=base 2409 := by decide +kernel
    exact (fix ▸ bit).trans ctx.hg0
  have s0 : s.basis (base 2410)=false := by
    have bit := field_special_at origin Z 0 s 2410 (by simp) input
    have fix : OB5.sig 511 (base 2410)=base 2410 := by decide +kernel
    exact (fix ▸ bit).trans ctx.hs0
  have gOff : base 2409∉numerator := OwnPlusHost.not_block 2409 2056 256 (by omega)
  have sOff : base 2410∉numerator := OwnPlusHost.not_block 2410 2056 256 (by omega)
  have hostedEq : run entryHostedRaw m s=run entryField m s :=
    HostOB5.hosted_run entryField s m entryField_hosts_free.1 entryField_hosts_free.2
      g0 in511 s0 in1542 ((outside _ gOff).trans g0) ((outside _ sOff).trans s0)
  have allEq := entry_run_eq s m parity workIn
    (by rw [hostedEq];exact (outside work (OwnPlusHost.not_block 1797 2056 256 (by omega))).trans workIn)
    (by intro q hq;rw [hostedEq];exact outside q (controls_away_numerator q hq))
  rw [allEq,hostedEq]
  exact result

private theorem double_half_div (Y W : Fp) : 2*(Y/2/W)=Y/W := by
  have two : (2:Fp)≠0 := by decide
  rw [div_div,mul_comm (2:Fp) W,←div_div,mul_div_cancel₀ _ two]

private theorem restore_origin (origin : BasisState) :
    writeBit (writeBit origin (base 2400) true) (base 2400) (origin (base 2400))=origin := by
  funext q
  by_cases eq : q=base 2400
  · subst q;simp only [writeBit,Function.update_self]
  · simp only [writeBit,Function.update_of_ne eq]

private theorem canonical_unforce (P : Program) (off : base 2400∉wires P)
    (origin : BasisState) (s forced : State) (m : List Bool)
    (forceEq : forced=⟨s.phase,writeBit s.basis (base 2400) true⟩)
    (B : Fp) (control : s.basis (base 2400)=origin (base 2400))
    (result : (run P m forced).phase=forced.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame (writeBit origin (base 2400) true) B 0 (run P m forced)) :
    (run P m s).phase=s.phase ∧ NewFieldFrameOB5.EncodedCanonicalFrame origin B 0 (run P m s) := by
  subst forced
  have back := FrontierEntry1591.canonical_control_set (writeBit origin (base 2400) true) B 0
    (run P m ⟨s.phase,writeBit s.basis (base 2400) true⟩) (origin (base 2400)) result.2
  have undo := FrontierEntry1591.run_control_unset P off s m true
  refine ⟨(congrArg State.phase undo).trans result.1,?_⟩
  rw [undo]
  simpa only [restore_origin,control] using back

theorem entry_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin (Y/2) 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis work=false)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    (run entryFieldHosted m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (Y/(x:Fp)) 0 (run entryFieldHosted m s) := by
  let origin' := writeBit origin (base 2400) true
  let forced : State := ⟨s.phase,writeBit s.basis (base 2400) true⟩
  have ctx' := FrontierEntry1591.context_control_set origin ctx true
  have ha' := FrontierEntry1591.source_zero_control_set origin true ha
  have trace' : skywalkTapeControls origin' (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact trace
  have input' := FrontierEntry1591.frame_control_set origin (Y/2) 0 s true input
  have parity' := FrontierEntry1591.parity_host_control_set controls host (by decide)
    controls_away_control s true parity
  have result := entry_core_frame origin' ctx' ha' x hx0 hx trace'
    (by simp only [origin',writeBit,Function.update_self]) (Y/2) forced m input'
    (by simpa only [forced,writeBit,Function.update_of_ne (show base 511≠base 2400 from by decide)] using in511)
    (by simpa only [forced,writeBit,Function.update_of_ne (show base 1542≠base 2400 from by decide)] using in1542)
    (by simpa only [forced,writeBit,Function.update_of_ne (show work≠base 2400 from by decide)] using workIn)
    parity'
  rw [double_half_div] at result
  have control : s.basis (base 2400)=origin (base 2400) := by
    have bit := field_special_at origin (Y/2) 0 s 2400 (by simp) input
    rwa [OneFlagSW.selSig_2400] at bit
  exact canonical_unforce entryFieldHosted entry_control_free origin s forced m rfl (Y/(x:Fp)) control result


/-- The parity and host wrappers preserve complete-State equality for all records. -/
theorem entryFieldHosted_run_eq_old (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m n : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin (Y/2) 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis work=false)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    run entryFieldHosted m s=run Prefix1590.entry n s := by
  have fresh := entry_frame origin ctx ha x hx0 hx trace Y s m input in511 in1542 workIn parity
  have old := Prefix1590.entry_frame origin ctx ha x hx0 hx trace Y s n input in511 in1542 workIn parity
  exact placed_canonical_unique origin _ _ _ _ fresh.2 old.2 (fresh.1.trans old.1.symm)

theorem entry_result (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (virtual actual : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 virtual)
    (phase : actual.phase=virtual.phase)
    (same : ∀q,q∉numerator → actual.basis q=virtual.basis q)
    (half : regValue numerator actual.basis=centerWord (Y/2))
    (in511 : actual.basis (base 511)=true) (in1542 : actual.basis (base 1542)=false)
    (workIn : actual.basis work=false)
    (parity : actual.basis host=TraceParity5.parity (controls.map actual.basis)) :
    (run entryFieldHosted m actual).phase=actual.phase ∧
      regValue numerator (run entryFieldHosted m actual).basis=(Y/(x:Fp)).val ∧
      ∀q,q∉numerator → (run entryFieldHosted m actual).basis q=actual.basis q := by
  have fieldInput := FrontierEntry1591EntryFrame.canonical_to_field ctx.hn origin ctx.parity ctx.env.2.2
    Y virtual actual phase same half input
  have result := entry_frame origin ctx ha x hx0 hx trace Y actual m fieldInput in511 in1542 workIn parity
  exact ⟨result.1,canonical_numerator_value origin ctx _ _ result.2,
    field_canonical_outside origin ctx ha _ _ actual _ fieldInput result.2 result.1⟩


private theorem exit_field_unforce (P : Program) (off : base 2400∉wires P)
    (origin : BasisState) (s forced : State) (m : List Bool)
    (forceEq : forced=⟨s.phase,writeBit s.basis (base 2400) true⟩)
    (B : Fp) (control : s.basis (base 2400)=origin (base 2400))
    (result : (run P m forced).phase=forced.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame (writeBit origin (base 2400) true) B 0 (run P m forced)) :
    (run P m s).phase=s.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin B 0 (run P m s) := by
  subst forced
  have back:=FrontierEntry1591.frame_control_set (writeBit origin (base 2400) true) B 0
    (run P m ⟨s.phase,writeBit s.basis (base 2400) true⟩) (origin (base 2400)) result.2
  have undo:=FrontierEntry1591.run_control_unset P off s m true
  have restore : writeBit (writeBit origin (base 2400) true) (base 2400)
      (origin (base 2400))=origin := by
    funext q
    by_cases eq : q=base 2400
    · subst q;simp only [writeBit,Function.update_self]
    · simp only [writeBit,Function.update_of_ne eq]
  refine ⟨(congrArg State.phase undo).trans result.1,?_⟩
  rw [undo]
  simpa only [restore,control] using back


theorem exit_core_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (enabled : origin (base 2400)=true) (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis FrontierEntry1591Field.work=false)
    (parity : s.basis FrontierEntry1591Field.host=
      TraceParity5.parity (FrontierEntry1591Field.controls.map s.basis)) :
    (run exitFieldHosted m s).phase=s.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin
      (Y/2*(x:Fp)) 0 (run exitFieldHosted m s) := by
  have result:=exitField_frame origin ctx ha x hx0 hx trace enabled Y s m input
  have outside:=FrontierEntry1591Field.canonical_field_outside origin ctx ha Y _ s _ input result.2 result.1
  have g0 : s.basis (base 2409)=false := by
    have bit:=FrontierEntry1591Field.canonical_special_at origin Y 0 s 2409 (by simp) input
    have fix : OB5.sig 511 (base 2409)=base 2409 := by decide +kernel
    exact (fix ▸ bit).trans ctx.hg0
  have s0 : s.basis (base 2410)=false := by
    have bit:=FrontierEntry1591Field.canonical_special_at origin Y 0 s 2410 (by simp) input
    have fix : OB5.sig 511 (base 2410)=base 2410 := by decide +kernel
    exact (fix ▸ bit).trans ctx.hs0
  have gOff : base 2409∉FrontierEntry1591Field.numerator :=
    OwnPlusHost.not_block 2409 2056 256 (by omega)
  have sOff : base 2410∉FrontierEntry1591Field.numerator :=
    OwnPlusHost.not_block 2410 2056 256 (by omega)
  have free511 := exitField_hosts_free.1
  have free1542 := exitField_hosts_free.2
  have hostedEq : run exitHostedRaw m s=run exitField m s :=
    HostOB5.hosted_run exitField s m free511 free1542 g0 in511 s0 in1542
      ((outside _ gOff).trans g0) ((outside _ sOff).trans s0)
  have hostFree : FrontierEntry1591Field.host∉wires exitHostedRaw := exitHosted_avoids_host
  have allEq:=ParityField1591.run_eq FrontierEntry1591Field.controls FrontierEntry1591Field.work
    FrontierEntry1591Field.host exitHostedRaw s m (by decide)
    FrontierEntry1591Field.host_not_controls hostFree parity workIn
    (by
      rw [hostedEq]
      exact (outside FrontierEntry1591Field.work
        (OwnPlusHost.not_block 1797 2056 256 (by omega))).trans workIn)
    (by
      intro q hq
      rw [hostedEq]
      exact outside q (FrontierEntry1591Field.controls_away_numerator q hq))
  have wrappedEq : run exitFieldHosted m s=run exitHostedRaw m s :=
    exit_program_transport exitFieldHosted _ (by unfold exitFieldHosted;rfl) s m
      (fun out => out=run exitHostedRaw m s) allEq
  exact exit_state_transport
    (fun out => out.phase=s.phase ∧ NewFieldFrameOB5.EncodedFieldFrame origin (Y/2*(x:Fp)) 0 out)
    _ _ (wrappedEq.trans hostedEq) result

theorem exit_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis FrontierEntry1591Field.work=false)
    (parity : s.basis FrontierEntry1591Field.host=
      TraceParity5.parity (FrontierEntry1591Field.controls.map s.basis)) :
    (run exitFieldHosted m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin (Y*(x:Fp)/2) 0 (run exitFieldHosted m s) := by
  let origin':=writeBit origin (base 2400) true
  let forced : State:=⟨s.phase,writeBit s.basis (base 2400) true⟩
  have ctx':=FrontierEntry1591.context_control_set origin ctx true
  have ha':=FrontierEntry1591.source_zero_control_set origin true ha
  have trace' : skywalkTapeControls origin' (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact trace
  have input':=FrontierEntry1591.canonical_control_set origin Y 0 s true input
  have parity':=FrontierEntry1591.parity_host_control_set FrontierEntry1591Field.controls
    FrontierEntry1591Field.host (by decide) FrontierEntry1591Field.controls_away_control s true parity
  have result:=exit_core_frame origin' ctx' ha' x hx0 hx trace'
    (by simp only [origin',writeBit,Function.update_self]) Y forced m input'
    (by simpa only [forced,writeBit,Function.update_of_ne (show base 511≠base 2400 from by decide)] using in511)
    (by simpa only [forced,writeBit,Function.update_of_ne (show base 1542≠base 2400 from by decide)] using in1542)
    (by simpa only [forced,writeBit,Function.update_of_ne (show FrontierEntry1591Field.work≠base 2400 from by decide)] using workIn)
    parity'
  have value : Y/2*(x:Fp)=Y*(x:Fp)/2 := by simp only [div_eq_mul_inv];ring
  rw [value] at result
  have control : s.basis (base 2400)=origin (base 2400) := by
    have bit:=FrontierEntry1591Field.canonical_special_at origin Y 0 s 2400 (by simp) input
    rwa [OneFlagSW.selSig_2400] at bit
  exact exit_field_unforce exitFieldHosted exit_control_away origin s forced m rfl (Y*(x:Fp)/2) control result



/-- The parity and host wrappers preserve complete-State equality for all records. -/
theorem exitFieldHosted_run_eq_old (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m n : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis work=false)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    run exitFieldHosted m s=run Prefix1590.exit n s := by
  have fresh := exit_frame origin ctx ha x hx0 hx trace Y s m input in511 in1542 workIn parity
  have old := Prefix1590.exit_frame origin ctx ha x hx0 hx trace Y s n input in511 in1542 workIn parity
  exact placed_field_unique origin _ _ _ _ fresh.2 old.2 (fresh.1.trans old.1.symm)

theorem exit_result (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis FrontierEntry1591Field.work=false)
    (parity : s.basis FrontierEntry1591Field.host=
      TraceParity5.parity (FrontierEntry1591Field.controls.map s.basis)) :
    (run exitFieldHosted m s).phase=s.phase ∧
      regValue FrontierEntry1591Field.numerator (run exitFieldHosted m s).basis=centerWord (Y*(x:Fp)/2) ∧
      ∀q,q∉FrontierEntry1591Field.numerator → (run exitFieldHosted m s).basis q=s.basis q := by
  have result:=exit_frame origin ctx ha x hx0 hx trace Y s m input in511 in1542 workIn parity
  exact ⟨result.1,FrontierEntry1591Field.field_numerator_value origin _ _ _ result.2,
