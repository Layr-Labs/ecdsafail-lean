theorem firstPacket_metrics (divide : Bool) :
    toffoliCount (placedFirstPacket divide)+3=
      toffoliCount (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) ∧
    measurementCount (placedFirstPacket divide)=
      measurementCount (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) ∧
    gateSlots (placedFirstPacket divide)=
      gateSlots (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide))+8 := by
  have body:=firstBody_counts divide
  have bodySlots:=firstBody_slots divide
  have codec:=ParityCodec5New.first_countsAt (History5.historyMap base 0)
  have codecSlots:=ParityCodec5New.first_slotsAt (History5.historyMap base 0)
  have enc:=NewHistory5.encode_counts base 0
  have dec:=NewHistory5.decode_counts base 0
  have encSlots : gateSlots (NewHistory5.encode base 0)=144 := (ParityCodec5New.slotsAt _).1
  have decSlots : gateSlots (NewHistory5.decode base 0)=142 := (ParityCodec5New.slotsAt _).2
  simp only [placedFirstPacket,firstPacket,baseFirstPacket,firstDecode,firstEncode,
    FrontierSW1591.firstPacketS,FrontierSW1591.baseFirstPacketS,
    toffoliCount_append,measurementCount_append,gateSlots_append,renameProgram_counts,rename_gateSlots]
