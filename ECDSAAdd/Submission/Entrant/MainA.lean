    FrontierEntry1591Kernel.lastPhase
  have sb:=FrontierEntry1591Native.relocated_slots FrontierEntry1591Kernel.firstPhase Q
    FrontierEntry1591Kernel.lastPhase
  simp only [FrontierEntry1591Native.kernel,toffoliCount_append,measurementCount_append,
    gateSlots_append] at a b sa sb
