theorem first_window_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y A B : Fp) (body : Program)
    (support : wires body⊆NewHistory5.groupReadSites base (base 2400) (base 2409) (base 2410) 0 ∪ {base 2312})
    (correct : Triple (PairFrame (balancedSharedPorts base (base 2409)).r
      (balancedSharedPorts base (base 2409)).y origin (centerWord X) (centerWord Y)) body
      (PairFrame (balancedSharedPorts base (base 2409)).r
        (balancedSharedPorts base (base 2409)).y origin (centerWord A) (centerWord B)))
    (nonzero : origin (base 0)=true ∨ origin (base 1028)=true)
    (s : State) (m : List Bool) (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    let out:=run (firstDecode++(body++firstEncode)) m s
    out.phase=s.phase ∧ NewHistory5.EncodedFieldFrame5 base (base 2409) origin A B out := by
  obtain ⟨raw,phase,frame,eq⟩:=input
  let other:=NewHistory5.otherEncode base 0 102
  let mb:=m.drop 2
  let rawOut:=run body mb raw
  have pool:=skywalkShared_integer_nodup base ctx.hn
  have hf:=NewHistory5.historyMap_injective base pool 0 (by decide)
  have leg:=NewHistory5.frame_history_legal base (base 2409) ctx.hn
    (ctx.hp _ (by simp)) 102 (by decide) origin raw.basis _ _ ctx.legal frame
  have nz : raw.basis (History5.historyMap base 0 0)=true ∨
      raw.basis (History5.historyMap base 0 1)=true := by
    rw [raw_prefix_eq origin raw.basis ctx _ _ frame 0,
      raw_prefix_eq origin raw.basis ctx _ _ frame 1]
    exact nonzero
  have hE:=NewHistory5.otherEncode_disjoint base pool 102 0 (by decide) (by decide)
  have hB:=NewFieldFrameOB5.otherEncode_body_disjoint base (base 2400) (base 2409) (base 2410)
    ctx.hn (ctx.hp _ (by simp)) (ctx.hp _ (by simp)) (ctx.hp _ (by simp))
    102 0 (by decide) (by decide) body support
  have firstESupport : wires firstEncode=wires (NewHistory5.encode base 0) := by
    simpa only [firstEncode,NewHistory5.encode] using
      (ParityCodec5New.first_mapped_support (History5.historyMap base 0)).1
  have firstDSupport : wires firstDecode=wires (NewHistory5.encode base 0) := by
    rw [firstDecode,(ParityCodec5New.first_mapped_support _).2,NewHistory5.encode,
      (ParityCodec5New.supportAt_exact _).2,(ParityCodec5New.supportAt_exact _).1]
  have hEF : Disjoint (wires other) (wires firstEncode) := by rw [firstESupport];exact hE
  have hDF : Disjoint (wires other) (wires firstDecode) := by rw [firstDSupport];exact hE
  have result:=correct raw mb frame
  have outLeg:=NewHistory5.frame_history_legal base (base 2409) ctx.hn
    (ctx.hp _ (by simp)) 102 (by decide) origin rawOut.basis _ _ ctx.legal result.2
  have outNZ : rawOut.basis (History5.historyMap base 0 0)=true ∨
      rawOut.basis (History5.historyMap base 0 1)=true := by
    rw [raw_prefix_eq origin rawOut.basis ctx _ _ result.2 0,
      raw_prefix_eq origin rawOut.basis ctx _ _ result.2 1]
    exact nonzero
  have decoded : run firstDecode (m.take 2)
      (run other [] (run (NewHistory5.encode base 0) [] raw))=run other [] raw := by
    have round:=ParityCodec5New.roundtripAtFirst (History5.historyMap base 0) hf raw [] (m.take 2)
      (leg 0 (by decide)) nz
    rw [ParityCodec5New.encodeAt_eq _ hf raw [] (leg 0 (by decide)) nz] at round
    have decodedPair : run firstDecode (m.take 2) (run (NewHistory5.encode base 0) [] raw)=raw := by
      simpa only [firstDecode,NewHistory5.encode] using round
    calc
      _=run other [] (run firstDecode (m.take 2) (run (NewHistory5.encode base 0) [] raw)) :=
        (run_disjoint_commute other firstDecode hDF [] (m.take 2) _).symm
      _=run other [] raw := by rw [decodedPair]
  have encoded : run firstEncode (mb.drop (measurementCount body)) rawOut=
      run (NewHistory5.encode base 0) [] rawOut := by
    rw [show firstEncode=ParityCodec5New.encodeAtFirst (History5.historyMap base 0) from rfl,
      ParityCodec5New.encodeAt_eq _ hf rawOut _ (outLeg 0 (by decide)) outNZ]
    exact ParityCodec5New.encodeAt_independent _ hf rawOut _ [] (outLeg 0 (by decide))
  have actual : run (firstDecode++(body++firstEncode)) m s=
      run (NewHistory5.allEncode base 102) [] rawOut := by
    have factor:=NewHistory5.allEncode_factor base pool 102 0 (by decide) (by decide) raw
    have back:=NewHistory5.allEncode_factor base pool 102 0 (by decide) (by decide) rawOut
    have dm : measurementCount firstDecode=2 := by
      simpa only [firstDecode] using
        (ParityCodec5New.first_countsAt (History5.historyMap base 0)).2.2.2
    rw [run_three_records,dm,eq,factor,decoded]
    rw [←run_disjoint_commute other body hB [] mb raw]
    rw [←run_disjoint_commute other firstEncode hEF [] (mb.drop (measurementCount body)) rawOut]
    rw [encoded,←back]
  dsimp only
  rw [actual]
  have encPhase:=NewHistory5.allEncode_zero_phase base pool 102 (by decide) rawOut
  exact ⟨encPhase.trans (result.1.trans phase),rawOut,encPhase.symm,result.2,rfl⟩

theorem firstPacket_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (x : Nat) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0)
    (s : State) (m : List Bool) (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    (run (firstPacket divide) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (Replay5.firstPayload divide origin (X,Y)).1 (Replay5.firstPayload divide origin (X,Y)).2
        (run (firstPacket divide) m s) := by
  have first:=first_trit_of_trace origin ctx x hx trace
  have fresh:=first_window_frame origin ctx X Y _ _ (firstBody divide) (firstBody_read_support divide)
    (firstBody_frame divide origin ctx enabled X Y hz first) first.2 s m input
  have eq:=Replay5.placed_eq (Placement5.pi 0) (baseFirstPacket divide)
    (fun q hq => Placement5.pi_outside 0 q (by decide) hq) s m
    (NewHistory5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp))
      origin ctx.env ctx.legal X Y s input)
    (NewHistory5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp))
      origin ctx.env ctx.legal _ _ _ fresh.2)
  have same : run (firstPacket divide) m s=run (baseFirstPacket divide) m s := by
    simpa only [firstPacket] using eq
  rw [same]
  simpa only [baseFirstPacket] using fresh

theorem placedFirstPacket_frame (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (x : Nat) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (X Y : Fp) (hz : divide=false → (Replay5.firstPayload divide origin (X,Y)).2=0)
    (s : State) (m : List Bool) (input : NewFieldFrameOB5.EncodedFieldFrame origin X Y s) :
    (run (placedFirstPacket divide) m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedFieldFrame origin
        (Replay5.firstPayload divide origin (X,Y)).1 (Replay5.firstPayload divide origin (X,Y)).2
        (run (placedFirstPacket divide) m s) :=
  NewFieldFrameOB5.placed_step (firstPacket divide) origin X Y _ _
    (fun a records h => firstPacket_frame divide origin ctx enabled x hx trace X Y hz a records h) s m input

private theorem prefix_support_member (q : Wire) (h : q∈wires prefixProgram) :
    ∃r : Fin 10,q=History5.historyMap base 0 r := by
  have converted : q∈wires (NewHistory5.encode base 0) := by
    simpa only [prefixProgram,Prefix1590Codec.perm_support] using h
  exact NewHistory5.history_gate_mem base 0 _ (Or.inl rfl) q converted

private theorem first_port_split (q : Fin 10) :
    q=5 ∨ q=9 ∨ ∃i : Fin 8,NewHistory5.payloadPort i=q := by
  fin_cases q <;> decide +kernel

theorem prefix_holes (s : State) (m : List Bool)
    (h5 : s.basis (base 1030)=false) (h9 : s.basis (base 1032)=false) :
    (run prefixProgram m s).basis (base 1030)=false ∧ (run prefixProgram m s).basis (base 1032)=false := by
  simpa only [prefixProgram,Prefix1590Codec.perm] using
    Prefix1590Codec.VAt_holes (History5.historyMap base 0)
      (History5.historyMap_injective base base_pool_nodup 0 (by decide)) s m h5 h9

theorem prefix_phase (s : State) (m : List Bool)
    (h5 : s.basis (base 1030)=false) (h9 : s.basis (base 1032)=false) :
    (run prefixProgram m s).phase=s.phase := by
  simpa only [prefixProgram] using Prefix1590Codec.perm_phase base base_pool_nodup s m h5 h9

theorem prefix_independent (s : State) (m n : List Bool)
    (h5 : s.basis (base 1030)=false) (h9 : s.basis (base 1032)=false) :
    run prefixProgram m s=run prefixProgram n s := by
  simpa only [prefixProgram] using Prefix1590Codec.perm_independent base base_pool_nodup s m n h5 h9

private theorem prefix_768_free : base 768∉wires prefixProgram := by
  intro used
  obtain ⟨q,eq⟩:=prefix_support_member _ used
  have same:=base_injective eq
  have hq:=q.isLt
  change 768=History5.historyId 0 q at same
  unfold History5.historyId at same
  split_ifs at same <;> omega

private theorem prefix_agrees_on_program (P : Program)
    (free : ∀i : Fin 8,payload0 i∉wires P) (s : State) (m : List Bool)
    (h5 : s.basis (base 1030)=false) (h9 : s.basis (base 1032)=false) :
    ∀q∈wires P,(run prefixProgram m s).basis q=s.basis q := by
  intro q hq
  by_cases used : q∈wires prefixProgram
  · obtain ⟨r,rfl⟩:=prefix_support_member q used
    rcases first_port_split r with rfl|rfl|⟨i,hi⟩
    · exact (prefix_holes s m h5 h9).1.trans h5.symm
    · exact (prefix_holes s m h5 h9).2.trans h9.symm
    · exact False.elim (free i (by simpa only [payload0,hi] using hq))
  · exact run_preserves_outside prefixProgram m s q used

theorem prefix_window_run_eq (P Window : Program)
    (shape : Window=prefixProgram++(renameProgram borrow P++unprefix))
    (free : ∀i : Fin 8,payload0 i∉wires P) (s : State) (m : List Bool)
    (h5 : s.basis (base 1030)=false) (h9 : s.basis (base 1032)=false)
    (o5 : (run P (m.drop 5) s).basis (base 1030)=false)
    (o9 : (run P (m.drop 5) s).basis (base 1032)=false)
    (workIn : s.basis (base 768)=false) (workOut : (run P (m.drop 5) s).basis (base 768)=false)
    (zero : (run prefixProgram [] s).basis (base 0)=false) : run Window m s=run P (m.drop 5) s := by
  let mr:=m.drop 5
  let v:=run prefixProgram [] s
  let out:=run P mr s
  have phase : v.phase=s.phase := prefix_phase s [] h5 h9
  have locality:=run_measured_locality P (wires P) (Finset.Subset.refl _) v s mr phase
    (prefix_agrees_on_program P free s [] h5 h9)
  have firstSame : ∀q∈wires prefixProgram,out.basis q=s.basis q := by
    intro q hq
    obtain ⟨r,rfl⟩:=prefix_support_member q hq
    rcases first_port_split r with rfl|rfl|⟨i,hi⟩
    · exact o5.trans h5.symm
    · exact o9.trans h9.symm
    · exact run_preserves_outside P mr s _ (by simpa only [payload0,hi] using free i)
  have sameV:=run_local_increment prefixProgram out s [] firstSame
  have commute : run P mr v=run prefixProgram [] out := by
    apply State.extensionality
    · exact locality.1.trans (prefix_phase out [] o5 o9).symm
    · funext q
      by_cases used : q∈wires P
      · exact (locality.2 q used).trans
          (prefix_agrees_on_program P free out [] o5 o9 q used).symm
      · rw [run_preserves_outside P mr v q used]
        by_cases hv : q∈wires prefixProgram
        · exact (sameV.2 q hv).symm
        · rw [run_preserves_outside prefixProgram [] out q hv,
            run_preserves_outside prefixProgram [] s q hv,run_preserves_outside P mr s q used]
  have vwork : v.basis (base 768)=false :=
    (run_preserves_outside prefixProgram [] s _ prefix_768_free).trans workIn
  have owork : (run P mr v).basis (base 768)=false := by
    rw [commute]
    exact (run_preserves_outside prefixProgram [] out _ prefix_768_free).trans workOut
  have rebound : run (renameProgram borrow P) mr v=run P mr v := by
    simpa only [ParityHostTransport5.program,borrow] using
      ParityHostTransport5.run_eq (base 768) (base 0) P v mr vwork zero owork (free 0)
  have em : measurementCount prefixProgram=5 := by
    simpa only [prefixProgram] using (Prefix1590Codec.perm_counts base).2
  have rm := (renameProgram_counts borrow P).2
  have pre : run prefixProgram (m.take (measurementCount prefixProgram)) s=v :=
    prefix_independent s _ [] h5 h9
  have execution : run Window m s=
      run unprefix (mr.drop (measurementCount P)) (run (renameProgram borrow P) mr v) := by
    rw [shape,run_three_records,pre,rm,em]
  rw [execution,rebound,commute]
  simpa only [prefixProgram,unprefix] using
    Prefix1590Codec.perm_roundtrip base base_pool_nodup out [] (mr.drop (measurementCount P)) o5 o9

private theorem codeAt_pull_sig (s : State) :
    Prefix1590Codec.codeAt (History5.historyMap base 0) (pullState (OB5.sig 511) s).basis=
      Prefix1590Codec.codeAt (History5.historyMap base 0) s.basis := by
  have same (q : Nat) (hq : q<10) :
      (pullState (OB5.sig 511) s).basis (Prefix1590Codec.label (History5.historyMap base 0) q)=
        s.basis (Prefix1590Codec.label (History5.historyMap base 0) q) := by
    simpa only [Prefix1590Codec.label,MeasuredCodec5.label,dif_pos hq,pullState] using
      congrArg s.basis (firstSig_history ⟨q,hq⟩)
  have congrCode (a b : BasisState) (agree : ∀q<10,a q=b q) :
      Prefix1590Codec.codeOf a=Prefix1590Codec.codeOf b := by
    simp only [Prefix1590Codec.codeOf,agree 0 (by decide),agree 1 (by decide),
      agree 2 (by decide),agree 3 (by decide),agree 4 (by decide),agree 6 (by decide),
      agree 7 (by decide),agree 8 (by decide)]
  exact congrCode _ _ same

theorem field_prefix_codes (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State) (input : NewFieldFrameOB5.EncodedFieldFrame origin X Y s)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    s.basis (base 1030)=false ∧ s.basis (base 1032)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap base 0) s.basis∈Prefix1590Codec.canonicalCodes := by
  have codes:=Prefix1590Domain.encoded_frame_prefix_codes base (base 2409) ctx.hn
    (ctx.hp _ (by simp)) origin X Y (pullState (OB5.sig 511) s) input x hx0 hx trace
  refine ⟨?_,?_,?_⟩
  · simpa only [pullState,firstSig_history 5] using codes.1
  · simpa only [pullState,firstSig_history 9] using codes.2.1
  · rw [←codeAt_pull_sig s]
    exact codes.2.2

theorem canonical_prefix_codes (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State) (input : NewFieldFrameOB5.EncodedCanonicalFrame origin X Y s)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    s.basis (base 1030)=false ∧ s.basis (base 1032)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap base 0) s.basis∈Prefix1590Codec.canonicalCodes := by
  have codes:=Prefix1590Domain.encoded_canonical_prefix_codes (skywalkShared_integer_nodup base ctx.hn) origin X Y
    (pullState (OB5.sig 511) s) input x hx0 hx trace
  refine ⟨?_,?_,?_⟩
  · simpa only [pullState,firstSig_history 5] using codes.1
  · simpa only [pullState,firstSig_history 9] using codes.2.1
  · rw [←codeAt_pull_sig s]
    exact codes.2.2

theorem prefix_zero_of_codes (s : State)
    (codes : s.basis (base 1030)=false ∧ s.basis (base 1032)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap base 0) s.basis∈Prefix1590Codec.canonicalCodes) :
    (run prefixProgram [] s).basis (base 0)=false := by
  simpa only [prefixProgram] using
    Prefix1590Codec.perm_zero base base_pool_nodup s [] codes.1 codes.2.1 codes.2.2

theorem field_768_zero (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State) (input : NewFieldFrameOB5.EncodedFieldFrame origin X Y s) :
    s.basis (base 768)=false :=
  (NewOwnPlusEndpoint.field_at origin X Y s 768 (Or.inr rfl) input).trans
    (NewOwnPlusEndpoint.env_zero origin ctx.env ctx.parity 768 (Or.inr rfl))

theorem canonical_768_zero (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State) (input : NewFieldFrameOB5.EncodedCanonicalFrame origin X Y s) :
    s.basis (base 768)=false :=
  (NewOwnPlusEndpoint.canonical_at origin X Y s 768 (Or.inr rfl) input).trans
    (NewOwnPlusEndpoint.env_zero origin ctx.env ctx.parity 768 (Or.inr rfl))

theorem logical_control (origin : BasisState) (X Y : Fp) (s : State)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    s.basis (base 2400)=origin (base 2400) := by
  obtain ⟨raw,_,frame,encoded⟩:=input
  have rawControl : raw.basis (base 2400)=origin (base 2400) := by
    apply frame.2.2
    · rw [balancedSharedPorts_r]
      exact OwnPlusHost.not_block 2400 2056 256 (by omega)
    · rw [balancedSharedPorts_y]
      exact OwnPlusHost.not_block 2400 770 256 (by omega)
  rw [encoded]
  exact (run_preserves_outside _ [] raw _
    (FrontierEntry1591Field.encoder_special_away 2400 (by simp))).trans rawControl

private theorem logical_entry_tail_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin
      (Replay5.firstPayload true origin (Y,0)).1 (Replay5.firstPayload true origin (Y,0)).2 s) :
    (run (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin (Y/(x:Fp)) (Y/(x:Fp))
        (run (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true) m s) := by
  let mg:=m.take (measurementCount (FrontierSW1591.groupsS true 1 101))
  let me:=m.drop (measurementCount (FrontierSW1591.groupsS true 1 101))
  let mid:=run (FrontierSW1591.groupsS true 1 101) mg s
  have oldG := ((FrontierSW1591.selGroups_sel true 1 101 (by decide)).eq mg s
    ((logical_control origin _ _ s input).trans enabled)).1
  have g:=FrontierReplay1591.groups_frame true 1 101 (by decide) origin ctx _ _ s mg input
  rw [←oldG] at g
  have oldE := ((FrontierSW1591.selEnd_sel true).eq me mid
    ((logical_control origin _ _ mid g.2).trans enabled)).1
  have payload:=Replay5.forward_payload origin x Y hx0 hx trace
  have e:=FrontierReplay1591.endPacket_frame true origin ctx _ _ (fun _ => by
    rw [Prod.mk.eta,payload]
    exact (congrArg Prod.snd payload).symm.trans (by simp only [Replay5.endPayload])) mid me g.2
  rw [←oldE] at e
  rw [run_append]
  refine ⟨e.1.trans g.1,?_⟩
  simpa only [Prod.mk.eta,Replay5.forward_payload origin x Y hx0 hx trace,enabled,if_true] using e.2

theorem entryTail_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin
      (Replay5.firstPayload true origin (Y,0)).1 (Replay5.firstPayload true origin (Y,0)).2 s) :
    (run entryTail m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 (run entryTail m s) := by
  have result:=run_three_states
    (renameProgram (OB5.sig 511) (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true))
    HalfFieldOB5.copyN OwnQ5Endpoint.canonT
    (fun a d => NewFieldFrameOB5.EncodedFieldFrame origin
      (Replay5.firstPayload true origin (Y,0)).1 (Replay5.firstPayload true origin (Y,0)).2 a →
      d.phase=a.phase ∧ NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 d) (by
      intro a b c d m1 m2 m3 h1 h2 h3 hin
      have first:=NewFieldFrameOB5.placed_step
        (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true) origin _ _ _ _
        (fun raw records h => logical_entry_tail_frame origin ctx enabled x hx0 hx trace Y raw records h)
        a m1 hin
      rw [h1] at first
      have middle:=NewHalfFieldOB5.copy_clear ctx.hn origin (Y/(x:Fp)) b m2 first.2
      rw [h2] at middle
      have last:=NewOwnQ5Endpoint.canon_frame ctx.hn (ctx.hp _ (by simp)) origin
        ctx.env ctx.legal ctx.parity ha (Y/(x:Fp)) c m3 middle.2
      change (run OwnQ5Endpoint.canonT m3 c).phase=c.phase ∧
        NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 (run OwnQ5Endpoint.canonT m3 c) at last
      rw [h3] at last
      exact ⟨last.1.trans (middle.1.trans first.1),last.2⟩) s m
  simpa only [entryTail] using result input

theorem entryField_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (enabled : origin (base 2400)=true) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin Y 0 s) :
    (run entryField m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Y/(x:Fp))) 0 (run entryField m s) := by
  let mp:=m.take (measurementCount (placedFirstPacket true))
  let mt:=m.drop (measurementCount (placedFirstPacket true))
  let mid:=run (placedFirstPacket true) mp s
  have first:=placedFirstPacket_frame true origin ctx enabled x hx trace Y 0
    (fun e => absurd e (by decide)) s mp input
  have tail:=entryTail_frame origin ctx ha enabled x hx0 hx trace Y mid (mt.drop 5) first.2
  have before:=field_prefix_codes origin ctx _ _ mid first.2 x hx0 hx trace
  have after:=canonical_prefix_codes origin ctx _ _ (run entryTail (mt.drop 5) mid) tail.2 x hx0 hx trace
  have window:=prefix_window_run_eq entryTail
    (prefixProgram++(renameProgram borrow entryTail++unprefix)) rfl entryTail_payload_free mid mt
    before.1 before.2.1 after.1 after.2.1
    (field_768_zero origin ctx _ _ mid first.2)
    (canonical_768_zero origin ctx _ _ (run entryTail (mt.drop 5) mid) tail.2)
    (prefix_zero_of_codes mid before)
  rw [entryField,run_append,window]
  exact ⟨tail.1.trans first.1,tail.2⟩

open FrontierEntry1591Field (controls work host numerator field_canonical_outside
  controls_away_numerator field_special_at controls_away_control canonical_numerator_value)

private theorem entryHosted_avoids_host : host∉wires entryHosted :=
  fun used => FrontierEntry1591Field.entryHosted_avoids_host (entryHosted_subset used)

private theorem entryField_hosts_free : base 511∉wires entryField ∧ base 1542∉wires entryField :=
  ⟨fun used => FrontierEntry1591Field.entryField_host_free.1 (entryField_subset used),
   fun used => FrontierEntry1591Field.entryField_host_free.2 (entryField_subset used)⟩

private theorem entry_control_free : base 2400∉wires entry :=
  fun used => FrontierEntry1591Field.entry_control_away (entry_subset used)

private theorem field_entry_free (i : Nat) (hi : i∈FrontierEntry1591Callers.logicalOmissions) :
    base i∉wires entry :=
  fun used => FrontierEntry1591Field.entry_free i hi (entry_subset used)

theorem entry_run_eq (s : State) (m : List Bool)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis))
    (workIn : s.basis work=false) (workOut : (run entryHosted m s).basis work=false)
    (payload : ∀q∈controls,(run entryHosted m s).basis q=s.basis q) :
    run entry m s=run entryHosted m s :=
  ParityField1591.run_eq controls work host entryHosted s m (by decide)
    FrontierEntry1591Field.host_not_controls entryHosted_avoids_host parity workIn workOut payload

theorem entry_core_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (enabled : origin (base 2400)=true) (Z : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin Z 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis work=false)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    (run entry m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (2*(Z/(x:Fp))) 0 (run entry m s) := by
  have result := entryField_frame origin ctx ha enabled x hx0 hx trace Z s m input
  have outside := field_canonical_outside origin ctx ha Z _ s _ input result.2 result.1
  have g0 : s.basis (base 2409)=false := by
    have bit := field_special_at origin Z 0 s 2409 (by simp) input
    have fix : OB5.sig 511 (base 2409)=base 2409 := by decide +kernel
    exact (fix ▸ bit).trans ctx.hg0
  have s0 : s.basis (base 2410)=false := by
    have bit := field_special_at origin Z 0 s 2410 (by simp) input
    have fix : OB5.sig 511 (base 2410)=base 2410 := by decide +kernel
    exact (fix ▸ bit).trans ctx.hs0
  have gOff : base 2409∉numerator := OwnPlusHost.not_block 2409 2056 256 (by omega)
  have sOff : base 2410∉numerator := OwnPlusHost.not_block 2410 2056 256 (by omega)
  have hostedEq : run entryHosted m s=run entryField m s :=
    HostOB5.hosted_run entryField s m entryField_hosts_free.1 entryField_hosts_free.2
      g0 in511 s0 in1542 ((outside _ gOff).trans g0) ((outside _ sOff).trans s0)
  have allEq := entry_run_eq s m parity workIn
    (by rw [hostedEq];exact (outside work (OwnPlusHost.not_block 1797 2056 256 (by omega))).trans workIn)
    (by intro q hq;rw [hostedEq];exact outside q (controls_away_numerator q hq))
  rw [allEq,hostedEq]
  exact result

private theorem double_half_div (Y W : Fp) : 2*(Y/2/W)=Y/W := by
  have two : (2:Fp)≠0 := by decide
  rw [div_div,mul_comm (2:Fp) W,←div_div,mul_div_cancel₀ _ two]

private theorem restore_origin (origin : BasisState) :
    writeBit (writeBit origin (base 2400) true) (base 2400) (origin (base 2400))=origin := by
  funext q
  by_cases eq : q=base 2400
  · subst q;simp only [writeBit,Function.update_self]
  · simp only [writeBit,Function.update_of_ne eq]

private theorem canonical_unforce (P : Program) (off : base 2400∉wires P)
    (origin : BasisState) (s forced : State) (m : List Bool)
    (forceEq : forced=⟨s.phase,writeBit s.basis (base 2400) true⟩)
    (B : Fp) (control : s.basis (base 2400)=origin (base 2400))
    (result : (run P m forced).phase=forced.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame (writeBit origin (base 2400) true) B 0 (run P m forced)) :
    (run P m s).phase=s.phase ∧ NewFieldFrameOB5.EncodedCanonicalFrame origin B 0 (run P m s) := by
  subst forced
  have back := FrontierEntry1591.canonical_control_set (writeBit origin (base 2400) true) B 0
    (run P m ⟨s.phase,writeBit s.basis (base 2400) true⟩) (origin (base 2400)) result.2
  have undo := FrontierEntry1591.run_control_unset P off s m true
  refine ⟨(congrArg State.phase undo).trans result.1,?_⟩
  rw [undo]
  simpa only [restore_origin,control] using back

theorem entry_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedFieldFrame origin (Y/2) 0 s)
    (in511 : s.basis (base 511)=true) (in1542 : s.basis (base 1542)=false)
    (workIn : s.basis work=false)
    (parity : s.basis host=TraceParity5.parity (controls.map s.basis)) :
    (run entry m s).phase=s.phase ∧
      NewFieldFrameOB5.EncodedCanonicalFrame origin (Y/(x:Fp)) 0 (run entry m s) := by
  let origin' := writeBit origin (base 2400) true
  let forced : State := ⟨s.phase,writeBit s.basis (base 2400) true⟩
  have ctx' := FrontierEntry1591.context_control_set origin ctx true
  have ha' := FrontierEntry1591.source_zero_control_set origin true ha
  have trace' : skywalkTapeControls origin' (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact trace
  have input' := FrontierEntry1591.frame_control_set origin (Y/2) 0 s true input
  have parity' := FrontierEntry1591.parity_host_control_set controls host (by decide)
    controls_away_control s true parity
  have result := entry_core_frame origin' ctx' ha' x hx0 hx trace'
    (by simp only [origin',writeBit,Function.update_self]) (Y/2) forced m input'
    (by simpa only [forced,writeBit,Function.update_of_ne (show base 511≠base 2400 from by decide)] using in511)
    (by simpa only [forced,writeBit,Function.update_of_ne (show base 1542≠base 2400 from by decide)] using in1542)
    (by simpa only [forced,writeBit,Function.update_of_ne (show work≠base 2400 from by decide)] using workIn)
    parity'
  rw [double_half_div] at result
  have control : s.basis (base 2400)=origin (base 2400) := by
    have bit := field_special_at origin (Y/2) 0 s 2400 (by simp) input
    rwa [OneFlagSW.selSig_2400] at bit
  exact canonical_unforce entry entry_control_free origin s forced m rfl (Y/(x:Fp)) control result

theorem entry_result (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (virtual actual : State) (m : List Bool)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 virtual)
    (phase : actual.phase=virtual.phase)
    (same : ∀q,q∉numerator → actual.basis q=virtual.basis q)
    (half : regValue numerator actual.basis=centerWord (Y/2))
    (in511 : actual.basis (base 511)=true) (in1542 : actual.basis (base 1542)=false)
    (workIn : actual.basis work=false)
    (parity : actual.basis host=TraceParity5.parity (controls.map actual.basis)) :
    (run entry m actual).phase=actual.phase ∧
      regValue numerator (run entry m actual).basis=(Y/(x:Fp)).val ∧
      ∀q,q∉numerator → (run entry m actual).basis q=actual.basis q := by
  have fieldInput := FrontierEntry1591EntryFrame.canonical_to_field ctx.hn origin ctx.parity ctx.env.2.2
    Y virtual actual phase same half input
  have result := entry_frame origin ctx ha x hx0 hx trace Y actual m fieldInput in511 in1542 workIn parity
  exact ⟨result.1,canonical_numerator_value origin ctx _ _ result.2,
    field_canonical_outside origin ctx ha _ _ actual _ fieldInput result.2 result.1⟩


section Kernel
open FrontierEntry1591Callers FrontierEntry1591Kernel
attribute [local irreducible] firstPhase lastPhase rawEntryKernel entryKernel
  NewStackOB5.stackForwardT FrontierEntry1591Native.forward

private theorem trace_last (x : Nat) (hx0 : 0<x) (hx : x<p) (origin : BasisState)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    origin (base 511)=true := by
  have tr : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511 (false,false)=
      (true,false) := by
    rw [trace]
    exact SkywalkTrace.trace512_last x hx0 hx _
  have e : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511 (false,false)=
      (origin (base 511),origin (base (1028+511))) := by
    simp [skywalkTapeControls,skywalkSharedTape]
  rw [e] at tr
  exact (Prod.mk.inj tr).1

private theorem prepared511 (origin : BasisState) (Y : Fp) (s : State)
    (input : NewFieldFrameOB5.EncodedCanonicalFrame origin Y 0 s)
    (last : origin (base 511)=true) : s.basis (base 511)=true := by
  have bit := FrontierEntry1591Field.canonical_special_at origin Y 0 s 511 (by simp) input
  have fix : OB5.sig 511 (base 511)=base 511 := by decide +kernel
  exact (fix ▸ bit).trans last

private theorem context (hn : (skywalkSharedWires base).Nodup)
    (ho : ∀q∈[base 2400,base 2409,base 2410],q∉skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (s origin : State) (facts : PreparationFacts x Y s origin)
    (legal : History5.RawLegal base 102 origin.basis)
    (hg : s.basis (base 2409)=false) (hs : s.basis (base 2410)=false) :
    FrontierReplay1591.Context origin.basis := by
  have hp : ∀q∈[base 2400,base 2409,base 2410],q∉skywalkPoolWires base := by
    intro q hq bad
    exact ho q hq (arith_block_subset_shared base 0 1798 (by omega) bad)
  exact ⟨hn,ho,hp,hf,(facts.controls _ (by simp)).trans hg,
    (facts.controls _ (by simp)).trans hs,facts.env,legal,facts.targetHigh⟩


private theorem pool_composed (N F C First : Program)
    (shape : First=N++(F++C))
    (hN : wires N⊆(skywalkPoolWires base).toFinset)
    (hF : wires F⊆(skywalkPoolWires base).toFinset)
    (hC : wires C⊆(skywalkPoolWires base).toFinset)
    (s t : State) (m : List Bool) (phase : s.phase=t.phase)
    (same : ∀q,q∉wireBlock base 2056 256 → s.basis q=t.basis q) :
    (run First m s).phase=(run First m t).phase ∧
      (∀q,q∉wireBlock base 2056 256 → (run First m s).basis q=(run First m t).basis q) ∧
      (∀q,q∈wireBlock base 2056 256 → (run First m t).basis q=t.basis q) := by
  let mn := m.take (measurementCount N)
  let rest := m.drop (measurementCount N)
  let mi := rest.take (measurementCount F)
  let mc := rest.drop (measurementCount F)
  let a1 := run N mn t
  let a2 := run F mi a1
  let a3 := run C mc a2
  have paired := EntryFuse.pool_three N F C hN hF hC s t mn mi mc phase same
    a1 a2 a3 rfl rfl rfl
  simpa only [shape,run_append] using paired

private theorem field_numerator_inputs (virtual actual : State) (value : Nat)
    (same : ∀q,q∉wireBlock base 2056 256 → actual.basis q=virtual.basis q)
    (half : regValue (wireBlock base 2056 256) actual.basis=value) :
    (∀q,q∉FrontierEntry1591Field.numerator → actual.basis q=virtual.basis q) ∧
      regValue FrontierEntry1591Field.numerator actual.basis=value := by
  exact ⟨same,half⟩

private theorem field_work_inputs (actual : State)
    (work : actual.basis (base 1797)=false)
    (parity : actual.basis (base 1543)=TraceParity5.parity (payloadControls.map actual.basis)) :
    actual.basis FrontierEntry1591Field.work=false ∧
      actual.basis FrontierEntry1591Field.host=
        TraceParity5.parity (FrontierEntry1591Field.controls.map actual.basis) := by
  exact ⟨work,parity⟩

private theorem field_output_result (before after : State) (value : Nat)
    (result : after.phase=before.phase ∧
      regValue FrontierEntry1591Field.numerator after.basis=value ∧
      ∀q,q∉FrontierEntry1591Field.numerator → after.basis q=before.basis q) :
    after.phase=before.phase ∧ regValue (wireBlock base 2056 256) after.basis=value ∧
      ∀q,q∉wireBlock base 2056 256 → after.basis q=before.basis q := by
  exact result

theorem entry_boundary (hn : (skywalkSharedWires base).Nodup) (hlo : History5.HistoryAbove base)
    (ho : ∀q∈[base 2400,base 2409,base 2410],q∉skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0<x) (hx : x<p) (s t : State) (mp mf : List Bool)
    (input : SkywalkArithmeticInput base x Y.val s.basis)
    (hg : s.basis (base 2409)=false) (hs : s.basis (base 2410)=false)
    (phase : t.phase=s.phase)
    (same : ∀q,q∉wireBlock base 2056 256 → t.basis q=s.basis q)
    (half : regValue (wireBlock base 2056 256) t.basis=centerWord (Y/2)) :
    let before := run firstPhase mp t
    let after := run entry mf before
    after.phase=before.phase ∧ regValue (wireBlock base 2056 256) after.basis=(Y/(x:Fp)).val ∧
      ∀q,q∉wireBlock base 2056 256 → after.basis q=before.basis q := by
  have paired' : (run firstPhase mp s).phase=(run firstPhase mp t).phase ∧
      (∀q,q∉wireBlock base 2056 256 → (run firstPhase mp s).basis q=(run firstPhase mp t).basis q) ∧
      (∀q,q∈wireBlock base 2056 256 → (run firstPhase mp t).basis q=t.basis q) :=
    pool_composed (FrontierEntry1591Native.forward base) NewStackOB5.stackForwardT
      (skywalkArithmeticClear base) firstPhase (by unfold firstPhase;rfl)
      (FrontierEntry1591Native.native_pool base base_pool_nodup).1
      forward_pool EntryFuse.clear_pool5 s t mp phase.symm (fun q hq => (same q hq).symm)
  obtain ⟨origin,facts,legal,frame⟩ := first_prepared hn hlo ho x Y hx0 hx s mp input
  have ctx := context hn ho hf x Y s origin facts legal hg hs
  have actualInput := paired_input x Y.val s t input same
  have bits := first_clean hn x _ hx0 hx t mp actualInput
  have high : (run firstPhase mp t).basis (base 1542)=false :=
    bits _ (by simp [FrontierEntry1591Native.workSites])
  have code : (run firstPhase mp t).basis (base 511)=true :=
    (paired'.2.1 _ (OwnPlusHost.not_block 511 2056 256 (by omega))).symm.trans
      (prepared511 origin.basis Y _ frame (trace_last x hx0 hx origin.basis facts.trace))
  have target : regValue (wireBlock base 2056 256) (run firstPhase mp t).basis=centerWord (Y/2) :=
    (regValue_congr _ _ _ paired'.2.2).trans half
  have parity := first_parity hn hlo x _ hx0 hx t mp actualInput
  have numeratorInputs := field_numerator_inputs (run firstPhase mp s) (run firstPhase mp t)
    (centerWord (Y/2)) (fun q hq => (paired'.2.1 q hq).symm) target
  have workInputs := field_work_inputs (run firstPhase mp t)
    (first_work_zero hn x _ t mp actualInput) parity
  exact field_output_result (run firstPhase mp t)
    (run entry mf (run firstPhase mp t)) (Y/(x:Fp)).val
    (entry_result origin.basis ctx facts.sourceZero x hx0 hx facts.trace Y
      (run firstPhase mp s) (run firstPhase mp t) mf frame paired'.1.symm
      numeratorInputs.1 numeratorInputs.2 code high workInputs.1 workInputs.2)


theorem raw_entry_correct : EntryCorrect rawEntryKernel := by
  intro hn hlo ho hf x Y hx0 hx s t m input hg hs phase same half
  have actualInput := paired_input x Y.val s t input same
  have result := raw_result entry hn hlo x _ hx0 hx t m
    (Y/(x:Fp)).val actualInput
    (fun mp mf => entry_boundary hn hlo ho hf x Y hx0 hx s t mp mf input hg hs phase same half)
  simpa only [rawEntryKernel,skywalkArithmeticResult,if_true] using
    And.intro (result.1.trans phase) (And.intro result.2.1
      (fun q hq => (result.2.2 q hq).trans (same q hq)))


private theorem away_work_host (q : Wire) (hq : q∈FrontierEntry1591Native.workSites∪
    FrontierEntry1591Native.hostSites) : q∉wireBlock base 2056 256 := by
  simp only [FrontierEntry1591Native.workSites,FrontierEntry1591Native.hostSites,
    Finset.mem_union,List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hq
  rcases hq with (rfl|rfl|rfl)|(rfl|rfl|rfl) <;>
    exact OwnPlusHost.not_block _ 2056 256 (by omega)

private theorem field_work_free (F : Program)
    (free : ∀i∈logicalOmissions,base i∉wires F) :
    ∀q∈FrontierEntry1591Native.workSites,q∉wires F := by
  intro q hq
  simp only [FrontierEntry1591Native.workSites,List.mem_toFinset,List.mem_cons,
    List.not_mem_nil,or_false] at hq
  rcases hq with rfl|rfl|rfl <;> exact free _ (by simp [logicalOmissions])

private theorem hosted_alias_run_eq (First F Last Raw Hosted : Program)
    (rawShape : Raw=FrontierEntry1591Native.kernel First F Last)
    (hostedShape : Hosted=FrontierEntry1591Native.relocated First F Last)
    (s : State) (m : List Bool)
    (input : ∀q∈FrontierEntry1591Native.workSites∪FrontierEntry1591Native.hostSites,s.basis q=false)
    (first_free : ∀q∈FrontierEntry1591Native.hostSites,q∉wires First)
    (first_clean : ∀mi,∀q∈FrontierEntry1591Native.workSites,(run First mi s).basis q=false)
    (field_free : ∀q∈FrontierEntry1591Native.workSites,q∉wires F)
    (last_free : ∀q∈FrontierEntry1591Native.hostSites,q∉wires Last)
    (output : ∀q∈FrontierEntry1591Native.workSites∪FrontierEntry1591Native.hostSites,
      (run Raw m s).basis q=false) :
    run Hosted m s=run Raw m s := by
  have eq := FrontierEntry1591Native.hosted_kernel_run_eq First F Last s m input first_free
    (first_clean (m.take (measurementCount First))) field_free last_free
    (by simpa only [rawShape] using output)
  simpa only [hostedShape,rawShape] using eq

private theorem state_predicate_transport (P : State → Prop) (a b : State)
    (eq : a=b) (result : P b) : P a := by
  cases eq
  exact result

theorem entry_correct : EntryCorrect entryKernel := by
  intro hn hlo ho hf x Y hx0 hx s t m input hg hs phase same half
  have result := raw_entry_correct hn hlo ho hf x Y hx0 hx s t m input hg hs phase same half
  have actualInput := paired_input x Y.val s t input same
  have output : ∀q∈FrontierEntry1591Native.workSites∪FrontierEntry1591Native.hostSites,
      (run rawEntryKernel m t).basis q=false := by
    intro q hq
    exact (result.2.2 q (away_work_host q hq)).trans
      (FrontierEntry1591Native.caller_clean_sites x Y.val s input q hq)
  have eq := hosted_alias_run_eq firstPhase entry lastPhase rawEntryKernel entryKernel
    (by unfold rawEntryKernel;rfl) (by unfold entryKernel;rfl)
    t m (FrontierEntry1591Native.caller_clean_sites_paired x Y.val s t input same)
    first_host_free (fun mi => first_clean hn x _ hx0 hx t mi actualInput)
    (field_work_free _ field_entry_free) last_host_free output
  exact state_predicate_transport
    (fun out => out.phase=s.phase ∧
      regValue (wireBlock base 2056 256) out.basis=(skywalkArithmeticResult true x Y).val ∧
      ∀q,q∉wireBlock base 2056 256 → out.basis q=s.basis q)
    (run entryKernel m t) (run rawEntryKernel m t) eq result



end Kernel

