    renameProgram (OB5.sig 511)
      (FrontierSW1591.endPacketS false ++ FrontierSW1591.groupsS false 1 101))

def prefixProgram : Program := Prefix1590Codec.perm base
def unprefix : Program := Prefix1590Codec.invPerm base

def entryField : Program :=
  placedFirstPacket true ++ (prefixProgram ++ (renameProgram borrow entryTail ++ unprefix))

def exitField : Program :=
  prefixProgram ++ (renameProgram borrow exitHead ++ (unprefix ++ placedFirstPacket false))

def entryHosted : Program := FrontierEntry1591Field.hosted entryField
def exitHosted : Program := FrontierEntry1591Field.hosted exitField

def entry : Program := ParityField1591.program FrontierEntry1591Field.controls
  FrontierEntry1591Field.work FrontierEntry1591Field.host entryHosted

def exit : Program := ParityField1591.program FrontierEntry1591Field.controls
  FrontierEntry1591Field.work FrontierEntry1591Field.host exitHosted

def rawEntryKernel : Program := FrontierEntry1591Native.kernel
  FrontierEntry1591Kernel.firstPhase entry FrontierEntry1591Kernel.lastPhase

def rawExitKernel : Program := FrontierEntry1591Native.kernel
  FrontierEntry1591Kernel.firstPhase exit FrontierEntry1591Kernel.lastPhase

def entryKernel : Program := FrontierEntry1591Native.relocated
  FrontierEntry1591Kernel.firstPhase entry FrontierEntry1591Kernel.lastPhase

def exitKernel : Program := FrontierEntry1591Native.relocated
