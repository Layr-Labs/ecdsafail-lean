private theorem hosted_768_free (P : Program) (free : base 768∉wires P) :
    base 768∉wires (FrontierEntry1591Field.hosted P) := by
  have middle:=rename_away HostOB5.hostSwap HostOB5.hostSwap_injective
    (base 768) (base 768) P (by decide +kernel) free
  have edge : base 768∉wires [Instr.X (base 511)] := by
    simp [wires,Instr.wires,base]
  simpa only [FrontierEntry1591Field.hosted,wires_append,Finset.mem_union,not_or] using
    And.intro edge (And.intro middle edge)

private theorem parity_768_free (P : Program) (free : base 768∉wires P) :
    base 768∉wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host P) := by
  have noControls : base 768∉FrontierEntry1591Field.controls := by
    intro used
    obtain ⟨i,eq,hi⟩:=FrontierEntry1591Field.controls_index _ used
    have same:=base_injective eq
    omega
  have fix : Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host (base 768)=base 768 := by
    decide +kernel
  intro used
  rcases Finset.mem_union.mp (ParityField1591.support _ _ _ P used) with used|used
  · rcases Finset.mem_insert.mp used with same|used
    · exact (by decide : base 768≠FrontierEntry1591Field.host) same
    · exact noControls (List.mem_toFinset.mp used)
  · obtain ⟨old,used,eq⟩:=Finset.mem_image.mp used
    exact free ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host).injective
      (eq.trans fix.symm) ▸ used)

