def payload0 (i : Fin 8) : Wire :=
  History5.historyMap base 0 (NewHistory5.payloadPort i)

private def payloadId (i : Fin 8) : Nat :=
  History5.historyId 0 (NewHistory5.payloadPort i)

private theorem payloadId_region (i : Fin 8) :
    payloadId i<5 ∨ payloadId i=1028 ∨ payloadId i=1029 ∨ payloadId i=1031 := by
  fin_cases i <;> decide +kernel

private theorem payload_field_free (i : Fin 8) :
    payload0 i∉FrontierReplay1591.fieldSites := by
  intro used
  change base (payloadId i)∈FrontierReplay1591.fieldSites at used
  rcases List.mem_cons.mp (List.mem_toFinset.mp used) with eq|used
  · have same:=base_injective eq
    have bounds:=payloadId_region i
    omega
  · obtain ⟨j,hj,eq⟩:=List.mem_map.mp used
    have same:=base_injective eq
    have bounds:=payloadId_region i
    simp only [Q6EndpointCell.ids,List.mem_append,List.mem_cons,List.not_mem_nil,
      List.mem_range'_1,or_false] at hj
    omega

private theorem payload_ne_flag (i : Fin 8) : payload0 i≠base 2409 := by
  intro eq
  have same:=base_injective eq
  have bounds:=payloadId_region i
  change payloadId i=2409 at same
  omega

private theorem fixed_rename_away (f : Wire→Wire) (hf : Function.Injective f)
    (P : Program) (q : Wire) (fix : f q=q) (off : q∉wires P) :
    q∉wires (renameProgram f P) := by
  intro used
  rw [renameProgram_support] at used
  obtain ⟨old,used,eq⟩:=Finset.mem_image.mp used
  exact off (hf (eq.trans fix.symm) ▸ used)

private theorem selW_free (source flag q : Wire) (P : Program)
    (hs : q≠source) (hf : q≠flag) (off : q∉wires P) :
    q∉wires (SW.selW source flag P) := by
  simp [SW.selW,wires_append,wires,Instr.wires,correctionWires,hs,hf,off]

private theorem half_payload_free (divide : Bool) (i : Fin 8) :
    payload0 i∉wires (Q6EndpointCell.half divide base (base 2409)) :=
  fun used => payload_field_free i
    (Q6EndpointCell.half_support divide base (base 2409) FrontierReplay1591.fieldSites
      (Finset.Subset.refl _) used)

private theorem swap_payload_free (i : Fin 8) : payload0 i∉wires FrontierSW1591.swapBody := by
  have sub : wires FrontierSW1591.swapBody⊆
      wires (Q6EndpointCell.body true base (base 2409) (base 2409)) := by
    simp only [FrontierSW1591.swapBody,Q6EndpointCell.body,if_true,wires_append,
      Q6EndpointCell.ports_r,Q6EndpointCell.ports_y]
    exact Finset.subset_union_right
  have flag : base 2409∈FrontierReplay1591.fieldSites := by
    simp [FrontierReplay1591.fieldSites]
  exact fun used => payload_field_free i
    (Q6EndpointCell.body_support true base (base 2409) (base 2409)
      FrontierReplay1591.fieldSites (Finset.Subset.refl _) flag (sub used))

private theorem rawReplayS_payload_free (divide : Bool) (ls : List MixedTranscriptLetter)
    (i : Fin 8) (controls : ∀l∈ls,payload0 i≠l.1.1 ∧ payload0 i≠l.1.2) :
    payload0 i∉wires (FrontierSW1591.rawReplayS divide ls) := by
  induction ls with
  | nil => simp [FrontierSW1591.rawReplayS,wires]
  | cons l ls ih =>
    have head:=controls l (List.mem_cons_self ..)
    have half:=selW_free l.1.1 (base 2409) (payload0 i)
      (Q6EndpointCell.half divide base (base 2409)) head.1 (payload_ne_flag i)
      (half_payload_free divide i)
    have swap:=selW_free l.1.2 (base 2409) (payload0 i) FrontierSW1591.swapBody
      head.2 (payload_ne_flag i) (swap_payload_free i)
    have rest:=ih (fun k hk => controls k (List.mem_cons_of_mem _ hk))
    cases divide <;> simp only [FrontierSW1591.rawReplayS,FrontierSW1591.cellS,
      Bool.false_eq_true,if_false,if_true,wires_append,Finset.mem_union,not_or] at half rest ⊢
    · exact ⟨rest,swap,half⟩
    · exact ⟨⟨half,swap⟩,rest⟩

theorem old_firstBody_g0_free (divide : Bool) :
    base 0∉wires (FrontierSW1591.firstBodyS divide) := by
  have field : payload0 0=base 0 := rfl
  have rest : base 0∉wires (FrontierSW1591.rawReplayS divide Replay5.restLetters) := by
    rw [←field]
    apply rawReplayS_payload_free
    intro l hl
    obtain ⟨k,hk,rfl⟩:=List.mem_map.mp hl
    have bounds:=List.mem_range'_1.mp hk
    simp only [tapeLetter,mixedTape_base_getD k (by omega),field,
      ne_eq,base_injective.eq_iff]
    omega
  have swap : base 0∉wires FrontierSW1591.firstSwapS :=
    selW_free _ _ _ _ (by decide) (by decide) (field ▸ swap_payload_free 0)
  have swapM : base 0∉wires FrontierSW1591.firstSwapMS := by
    apply selW_free _ _ _ _ (by decide) (by decide)
    simpa only [FrontierSW1591.swapBodyM,UncompSwap.mswap_wires,
      FrontierSW1591.swapBody] using (field ▸ swap_payload_free 0)
  cases divide <;> simp only [FrontierSW1591.firstBodyS,Bool.false_eq_true,
    if_false,if_true,wires_append,Finset.mem_union,not_or] at rest ⊢
  · exact ⟨rest,swapM⟩
  · exact ⟨swap,rest⟩

private theorem payload_codec_free (start : Nat) (hs : 5≤start)
    (bound : start+5≤512) (P : Program)
    (hp : P=NewHistory5.encode base start ∨ P=NewHistory5.decode base start) (i : Fin 8) :
    payload0 i∉wires P := by
  intro used
  obtain ⟨q,eq⟩:=NewHistory5.history_gate_mem base start P hp _ used
  have same:=base_injective eq
  have bounds:=payloadId_region i
  change payloadId i=History5.historyId start q at same
  have hq:=q.isLt
  unfold History5.historyId at same
  split_ifs at same <;> omega

private theorem payload_read_free (j : Nat) (hi : j<102) (hj : 1≤j) (i : Fin 8) :
    payload0 i∉FrontierReplay1591.readSites (5*j) := by
  intro used
  simp only [FrontierReplay1591.readSites,Finset.mem_union] at used
  rcases used with (used|used)|used
  · exact payload_field_free i used
  · have bounds:=payloadId_region i
    simp only [Finset.mem_insert,Finset.mem_singleton] at used
    rcases used with eq|eq
    all_goals have same:=base_injective eq;change payloadId i=_ at same;omega
  · exact payload_codec_free _ (by omega) (by omega) _ (Or.inl rfl) i used

private theorem payload_pi_fixed (j : Nat) (hj : j<102) (i : Fin 8) :
    shifted (Placement5.pi j) (payload0 i)=payload0 i := by
  change shifted (Placement5.pi j) (base (payloadId i))=base (payloadId i)
  rw [shifted_base,Placement5.pi_outside j _ hj]
  have bounds:=payloadId_region i
  unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
  omega

private theorem packet_payload_free (divide : Bool) (j : Nat) (hj : j<102)
    (hlo : 1≤j) (i : Fin 8) : payload0 i∉wires (FrontierSW1591.packetS divide j) := by
  have raw : payload0 i∉wires (FrontierReplay1591.basePacket divide j) := by
    have body := fun used => payload_read_free j hj hlo i
      (FrontierReplay1591.body_support divide j hj used)
    simpa only [FrontierReplay1591.basePacket,wires_append,Finset.mem_union,not_or] using
      And.intro (And.intro (payload_codec_free _ (by omega) (by omega) _ (Or.inr rfl) i) body)
        (payload_codec_free _ (by omega) (by omega) _ (Or.inl rfl) i)
  have placed := fixed_rename_away _ (shifted (Placement5.pi j)).injective _ _
    (payload_pi_fixed j hj i) raw
  exact fun used => placed ((FrontierSW1591.selPacket_sel divide j hj).sub.wires_sub used)

private theorem groups_payload_free (divide : Bool) (j n : Nat) (hj : 1≤j)
    (bound : j+n≤102) (i : Fin 8) :
    payload0 i∉wires (FrontierSW1591.groupsS divide j n) := by
  induction n generalizing j with
  | zero => simp [FrontierSW1591.groupsS,PacketSequence.program,wires]
  | succ n ih =>
    have head:=packet_payload_free divide j (by omega) hj i
    have rest:=ih (j+1) (by omega) (by omega)
    cases divide <;> simp only [FrontierSW1591.groupsS,PacketSequence.program,
      Bool.false_eq_true,if_false,if_true,wires_append,Finset.mem_union,not_or]
    · exact ⟨rest,head⟩
    · exact ⟨head,rest⟩

private theorem end_payload_free (divide : Bool) (i : Fin 8) :
    payload0 i∉wires (FrontierSW1591.endPacketS divide) := by
  have halfE : payload0 i∉wires (Q6EndpointCell.halfE divide base (base 2409)) :=
    fun used => half_payload_free divide i (Q6EndpointCell.halfE_wires divide _ _ used)
  have source : payload0 i≠base 510 := by
    intro eq
    have same:=base_injective eq
    have bounds:=payloadId_region i
    change payloadId i=510 at same
    omega
  have raw := selW_free (base 510) (base 2409) (payload0 i) _ source
    (payload_ne_flag i) halfE
  apply fixed_rename_away _ (shifted Placement5.pi0).injective _ _ _ raw
  change shifted Placement5.pi0 (base (payloadId i))=base (payloadId i)
  rw [shifted_base,Placement5.pi0_outside]
  have bounds:=payloadId_region i
  unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
  omega

private theorem payload0_raw_away (i : Fin 8) :
    payload0 i∉(HalfField.ids.map base).toFinset := by
  intro used
  obtain ⟨j,hj,eq⟩:=List.mem_map.mp (List.mem_toFinset.mp used)
  have same:=base_injective eq
  change j=payloadId i at same
  have bounds:=payloadId_region i
  simp only [HalfField.ids,List.mem_append,List.mem_cons,List.not_mem_nil,
    List.mem_range'_1,or_false] at hj
  omega

private theorem payload0_endpoint_fixed (i : Fin 8) :
    HalfFieldOB5.endpointMap (payload0 i)=payload0 i ∧
    OwnPlusEndpoint.swap (payload0 i)=payload0 i ∧
    OwnGuardEndpoint.swap (payload0 i)=payload0 i ∧
    OwnQ4Endpoint.swap (payload0 i)=payload0 i ∧
    OwnQ5Endpoint.swap (payload0 i)=payload0 i := by
  fin_cases i <;> decide +kernel

private theorem endpoint_payload0_away (i : Fin 8) (P : Program)
    (sub : wires P⊆(HalfField.ids.map base).toFinset) :
    payload0 i∉wires
      (renameProgram OwnQ5Endpoint.swap
        (renameProgram OwnQ4Endpoint.swap
          (renameProgram OwnGuardEndpoint.swap
            (renameProgram OwnPlusEndpoint.swap
              (renameProgram HalfFieldOB5.endpointMap P))))) := by
  have fix:=payload0_endpoint_fixed i
  have h0 : payload0 i∉wires P := fun used => payload0_raw_away i (sub used)
  have h1:=fixed_rename_away HalfFieldOB5.endpointMap HalfFieldOB5.endpointMap.injective
    P (payload0 i) fix.1 h0
  have h2:=fixed_rename_away OwnPlusEndpoint.swap OwnPlusEndpoint.swap.injective
    _ (payload0 i) fix.2.1 h1
  have h3:=fixed_rename_away OwnGuardEndpoint.swap OwnGuardEndpoint.swap.injective
    _ (payload0 i) fix.2.2.1 h2
  have h4:=fixed_rename_away OwnQ4Endpoint.swap OwnQ4Endpoint.swap.injective
    _ (payload0 i) fix.2.2.2.1 h3
  exact fixed_rename_away OwnQ5Endpoint.swap OwnQ5Endpoint.swap.injective
    _ (payload0 i) fix.2.2.2.2 h4

theorem endpoint_payload0_free (i : Fin 8) :
    payload0 i∉wires OwnQ5Endpoint.centerT ∧
    payload0 i∉wires OwnQ5Endpoint.canonT ∧
    payload0 i∉wires HalfFieldOB5.copyN := by
  refine ⟨?_,?_,?_⟩
  · simpa only [OwnQ5Endpoint.centerT,OwnQ4Endpoint.centerT,
      OwnGuardEndpoint.centerT,OwnPlusEndpoint.centerT,HalfFieldOB5.centerT,
      HalfField5.centerT] using
        endpoint_payload0_away i HalfField.centerT HalfField.centerT_sites
  · simpa only [OwnQ5Endpoint.canonT,OwnQ4Endpoint.canonT,
      OwnGuardEndpoint.canonT,OwnPlusEndpoint.canonT,HalfFieldOB5.canonT,
      HalfField5.canonT] using
        endpoint_payload0_away i HalfField.canonT HalfField.canonT_sites
  · have raw : payload0 i∉wires HalfField.copyN :=
      fun used => payload0_raw_away i (HalfField.copyN_sites used)
    simpa only [HalfFieldOB5.copyN,HalfField5.copyN] using raw

theorem entryTail_payload_free (i : Fin 8) : payload0 i∉wires entryTail := by
  have raw : payload0 i∉wires
      (FrontierSW1591.groupsS true 1 101++FrontierSW1591.endPacketS true) := by
    simpa only [wires_append,Finset.mem_union,not_or] using
      And.intro (groups_payload_free true 1 101 (by omega) (by omega) i) (end_payload_free true i)
  have placed:=fixed_rename_away _ (OB5.sig_injective 511 (by decide)) _ _
    (firstSig_history (NewHistory5.payloadPort i)) raw
  simpa only [entryTail,wires_append,Finset.mem_union,not_or] using
    And.intro placed (And.intro (endpoint_payload0_free i).2.2 (endpoint_payload0_free i).2.1)

theorem exitHead_payload_free (i : Fin 8) : payload0 i∉wires exitHead := by
  have raw : payload0 i∉wires
      (FrontierSW1591.endPacketS false++FrontierSW1591.groupsS false 1 101) := by
    simpa only [wires_append,Finset.mem_union,not_or] using
      And.intro (end_payload_free false i) (groups_payload_free false 1 101 (by omega) (by omega) i)
  have placed:=fixed_rename_away _ (OB5.sig_injective 511 (by decide)) _ _
    (firstSig_history (NewHistory5.payloadPort i)) raw
  simpa only [exitHead,wires_append,Finset.mem_union,not_or] using
    And.intro (endpoint_payload0_free i).1 (And.intro (endpoint_payload0_free i).2.2 placed)

theorem entryTail_g0_free : base 0∉wires entryTail := entryTail_payload_free 0
theorem exitHead_g0_free : base 0∉wires exitHead := exitHead_payload_free 0

end ECDSAAdd.Entrant.Prefix1590
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.ControlLoan1589Loan =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.OneFlag
-- consolidated import: import ECDSAAdd.Submission.Entrant.G0CarryLoan5
-- consolidated import: import ECDSAAdd.Framework.CleanWireRebind

/-! Generic selector-window carry loan. The copied selector retains the source
bit while its old wire is a clean carry host. All record tapes and the full
incoming phase are retained. Concrete half-frame facts are supplied internally
by the field proof; this module adds no entry-contract premise. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.ControlLoan1589
open Arithmetic RecordedQuantum Challenge Baselines
attribute [local irreducible] run wires toffoliCount measurementCount

def loanWindow (g flag c : Wire) (P : Program) : Program :=
  [.CX g flag, .CX flag g] ++
    renameProgram (Equiv.swap c g) P ++
    [.CX flag g, .measureX flag [] [.Z g]]

private theorem pull_swap_invol (a b : Wire) (s : State) :
    pullState (Equiv.swap a b) (pullState (Equiv.swap a b) s)=s := by
  apply State.extensionality
  · rfl
  · funext q
    change s.basis (Equiv.swap a b (Equiv.swap a b q))=s.basis q
    rw [Equiv.swap_apply_self]

private theorem rebind_swap_run (a b : Wire) (P : Program) (s : State) (m : List Bool)
    (ha : s.basis a=false) (hb : s.basis b=false)
    (oa : (run P m s).basis a=false) (ob : (run P m s).basis b=false) :
    run (renameProgram (Equiv.swap a b) P) m s=run P m s := by
  have eq := ECDSAAdd.run_rename (Equiv.swap a b) (Equiv.swap a b).injective P m s
  rw [pullState_zero_swap a b s ha hb,
    ←pullState_zero_swap a b (run P m s) oa ob] at eq
  have both := congrArg (pullState (Equiv.swap a b)) eq
  simpa only [pull_swap_invol] using both

private theorem cx_run (a b : Wire) (s : State) (m : List Bool) :
    run [.CX a b] m s=⟨s.phase,writeBit s.basis b (s.basis b ^^ s.basis a)⟩ := by
  simp only [run]

/-- Clear and restore the source around a body that does not read it. The
selector and carry boundary facts are about the original body's own run. -/
private theorem loan_body_eq (g flag c : Wire) (P : Program) (s : State) (m : List Bool)
    (gf : g≠flag) (cg : c≠g) (off : g∉wires P)
    (same : s.basis g=s.basis flag) (clean : s.basis c=false)
    (keep : (run P m s).basis flag=s.basis flag)
    (out : (run P m s).basis c=false) :
    run ([.CX flag g] ++ renameProgram (Equiv.swap c g) P ++ [.CX flag g]) m s=
      run P m s := by
  let t : State := ⟨s.phase,writeBit s.basis g false⟩
  have start : run [.CX flag g] [] s=t := by
    rw [cx_run,same,Bool.xor_self]
  have shifted : run P m t=
      ⟨(run P m s).phase,writeBit (run P m s).basis g false⟩ :=
    G0CarryLoan5.run_write_outside P g off s m false
  have tc : t.basis c=false := by
    simp only [t,writeBit,Function.update_of_ne cg,clean]
  have tg : t.basis g=false := by simp only [t,writeBit,Function.update_self]
  have oc : (run P m t).basis c=false := by
    rw [shifted]
    simp only [writeBit,Function.update_of_ne cg,out]
  have og : (run P m t).basis g=false :=
    (run_preserves_outside P m t g off).trans tg
  have rebound := rebind_swap_run c g P t m tc tg oc og
  have finish : run [.CX flag g] (m.drop (measurementCount P)) (run P m t)=run P m s := by
    rw [shifted,cx_run]
    have target : (run P m s).basis g=(run P m s).basis flag :=
      (run_preserves_outside P m s g off).trans (same.trans keep.symm)
    apply State.extensionality
    · rfl
    · funext q
      by_cases eq : q=g
      · subst q
        simp only [writeBit,Function.update_self,Function.update_of_ne (Ne.symm gf),
          Bool.false_xor,target]
      · simp only [writeBit,Function.update_of_ne eq]
  have em : measurementCount [.CX flag g]=0 := by simp only [measurementCount]
  have count := (renameProgram_counts (Equiv.swap c g) P).2
  have reboundTake : run (renameProgram (Equiv.swap c g) P)
      (m.take (measurementCount P)) t=run P m t := by
    rw [←count,run_take]
    exact rebound
  simp only [List.append_assoc,run_append,em,List.take_zero,List.drop_zero,count]
  rw [start,reboundTake]
  exact finish

private theorem append_run_eq (P Q Tail : Program) (s : State) (m : List Bool)
    (count : measurementCount P=measurementCount Q) (eq : run P m s=run Q m s) :
    run (P++Tail) m s=run (Q++Tail) m s := by
  rw [run_append,run_append,run_take,run_take,count,eq]

/-- Full-State equality for arbitrary incoming phase and every record list,
including short and empty lists. The two added CX gates consume no record. -/
theorem loanWindow_eq (g flag c : Wire) (P : Program) (s : State) (m : List Bool)
    (gf : g≠flag) (cg : c≠g) (cf : c≠flag) (off : g∉wires P)
    (flagIn : s.basis flag=false) (carryIn : s.basis c=false)
    (keep : (run P m (run [.CX g flag] [] s)).basis flag=
      (run [.CX g flag] [] s).basis flag)
    (carryOut : (run P m (run [.CX g flag] [] s)).basis c=false) :
    run (loanWindow g flag c P) m s=run (SW.selW g flag P) m s := by
  let a := run [.CX g flag] [] s
  let B : Program := [.CX flag g] ++ renameProgram (Equiv.swap c g) P ++ [.CX flag g]
  let Tail : Program := [.measureX flag [] [.Z g]]
  have same : a.basis g=a.basis flag := by
    simp [a,run,writeBit,Function.update,gf,flagIn]
  have clean : a.basis c=false := by
    simp [a,run,writeBit,Function.update,cf,carryIn]
  have block : run B m a=run P m a :=
    loan_body_eq g flag c P a m gf cg off same clean keep carryOut
  have count : measurementCount B=measurementCount P := by
    simp only [B,measurementCount_append,(renameProgram_counts (Equiv.swap c g) P).2,
      measurementCount,Nat.zero_add,Nat.add_zero]
  have shape : loanWindow g flag c P=[.CX g flag]++(B++Tail) := by
    simp only [loanWindow,B,Tail,List.append_assoc,List.cons_append,List.nil_append]
  have headCount : measurementCount [.CX g flag]=0 := by simp only [measurementCount]
  calc
    run (loanWindow g flag c P) m s=run (B++Tail) m a := by
      rw [shape]
      simpa only [headCount,List.take_zero,List.drop_zero,a] using
        run_append [.CX g flag] (B++Tail) m s
    _=run (P++Tail) m a := append_run_eq B P Tail a m count block
    _=run (SW.selW g flag P) m s := by
      symm
      simpa only [SW.selW,Tail,List.append_assoc,headCount,List.take_zero,List.drop_zero,a] using
        run_append [.CX g flag] (P++Tail) m s

theorem loanWindow_counts (g flag c : Wire) (P : Program) :
    toffoliCount (loanWindow g flag c P)=toffoliCount (SW.selW g flag P) ∧
    measurementCount (loanWindow g flag c P)=measurementCount (SW.selW g flag P) := by
  constructor <;> simp only [loanWindow,SW.selW,toffoliCount_append,measurementCount_append,
    (renameProgram_counts (Equiv.swap c g) P).1,(renameProgram_counts (Equiv.swap c g) P).2,
    toffoliCount,measurementCount,Nat.zero_add,Nat.add_zero]

theorem loanWindow_measurements (g flag c : Wire) (P : Program) :
    measurementCount (loanWindow g flag c P)=measurementCount P+1 := by
  rw [(loanWindow_counts g flag c P).2]
  simp only [SW.selW,measurementCount_append,measurementCount,Nat.zero_add,Nat.add_zero]

theorem loanWindow_slots (g flag c : Wire) (P : Program) :
    gateSlots (loanWindow g flag c P)=gateSlots (SW.selW g flag P)+2 := by
  rw [SW.selW_slots]
  simp only [loanWindow,gateSlots_append,Baselines.rename_gateSlots,
    gateSlots_cons,gateSlots_nil,instructionSlots,List.length_cons,List.length_nil]
  omega

theorem loanWindow_physical (g flag c : Wire) (P : Program)
    (gf : g≠flag) (hp : GatePhysical P) : GatePhysical (loanWindow g flag c P) := by
  have head : GatePhysical [.CX g flag,.CX flag g] := by
    simp [GatePhysical,PhysicalInstr,ProperGate,gf,Ne.symm gf]
  have tail : GatePhysical [.CX flag g,.measureX flag [] [.Z g]] := by
    simp [GatePhysical,PhysicalInstr,ProperGate,gf,Ne.symm gf]
  simpa only [loanWindow,gatePhysical_append] using And.intro
    (And.intro head (gatePhysical_rename _ (Equiv.swap c g).injective _ hp)) tail

theorem loanWindow_support (g flag c : Wire) (P : Program) :
    wires (loanWindow g flag c P)⊆{g,flag}∪(wires P).image (Equiv.swap c g) := by
  simp [loanWindow,wires_append,renameProgram_support,wires,Instr.wires,correctionWires]

theorem loanWindow_avoids_carry (g flag c : Wire) (P : Program)
    (cg : c≠g) (cf : c≠flag) (off : g∉wires P) : c∉wires (loanWindow g flag c P) := by
  intro used
  rcases Finset.mem_union.mp (loanWindow_support g flag c P used) with h|h
  · simp only [Finset.mem_insert,Finset.mem_singleton] at h
    exact h.elim cg cf
  · obtain ⟨a,ha,eq⟩ := Finset.mem_image.mp h
    have same : a=g := (Equiv.swap c g).injective (eq.trans (Equiv.swap_apply_right c g).symm)
    exact off (same ▸ ha)

theorem loanWindow_support_to (g flag c : Wire) (P : Program) (S : Finset Wire)
    (old : wires P⊆S) (hg : g∈S) (hf : flag∈S)
    (cg : c≠g) (cf : c≠flag) (off : g∉wires P) :
    wires (loanWindow g flag c P)⊆S.erase c := by
  intro q used
  have away : q≠c := fun eq => loanWindow_avoids_carry g flag c P cg cf off (eq ▸ used)
  refine Finset.mem_erase.mpr ⟨away,?_⟩
  rcases Finset.mem_union.mp (loanWindow_support g flag c P used) with h|h
  · simp only [Finset.mem_insert,Finset.mem_singleton] at h
    rcases h with rfl|rfl <;> assumption
  · obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp h
    by_cases ac : a=c
    · subst a
      simpa only [Equiv.swap_apply_left] using hg
    have ag : a≠g := fun eq => off (eq ▸ ha)
    simpa only [Equiv.swap_apply_of_ne_of_ne ac ag] using old ha

theorem loanWindow_support_erase (g flag c : Wire) (P : Program)
    (cg : c≠g) (cf : c≠flag) (off : g∉wires P) :
    wires (loanWindow g flag c P)⊆(wires (SW.selW g flag P)).erase c := by
  have support : wires (SW.selW g flag P)={g,flag}∪wires P := by
    ext q
    simp [SW.selW,wires_append,wires,Instr.wires,correctionWires]
  apply loanWindow_support_to g flag c P _ _ _ _ cg cf off
  · intro q hq
    rw [support]
    exact Finset.mem_union_right _ hq
  · rw [support]
    simp
  · rw [support]
    simp

end ECDSAAdd.Entrant.ControlLoan1589
