  exact Finset.union_subset_union p q

private theorem codec_mem (i : Fin 10) :
    History5.historyMap base 0 i∈wires (NewHistory5.encode base 0) := by
  change History5.historyMap base 0 i∈wires (ParityCodec5New.encodeAt _)
  rw [(ParityCodec5New.supportAt_exact _).1]
  exact Finset.mem_image.mpr ⟨i,Finset.mem_univ _,rfl⟩

private theorem codec_not768 (P : Program)
    (sub : wires P⊆wires (NewHistory5.encode base 0)) : base 768∉wires P := by
  intro used
  obtain ⟨i,eq⟩:=NewHistory5.history_gate_mem base 0 _ (Or.inl rfl) _ (sub used)
  have bound:=i.isLt
  have same:=base_injective eq
  unfold History5.historyMap History5.historyId at same
  split_ifs at same <;> omega

