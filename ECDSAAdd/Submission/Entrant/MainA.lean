namespace ECDSAAdd.Entrant.ControlLoan1589
open Arithmetic MappedCompressed DirectSkywalk Secp256k1 BalancedField OffsetBorrowedCanonical
attribute [local irreducible] run wires wireBlock

private abbrev rawR : List Wire := (balancedSharedPorts base (base 2409)).r
private abbrev rawY : List Wire := (balancedSharedPorts base (base 2409)).y

private theorem raw_flag_away : base 2409∉rawR ∧ base 2409∉rawY := by
  rw [rawR,rawY,balancedSharedPorts_r,balancedSharedPorts_y]
  exact ⟨OwnPlusHost.not_block 2409 2056 256 (by omega),
    OwnPlusHost.not_block 2409 770 256 (by omega)⟩

private theorem work_away (q : Wire) (hq : q∈Q6EndpointCell.workIds.map base) :
    q∉rawR ∧ q∉rawY := by
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hq
  rw [rawR,rawY,balancedSharedPorts_r,balancedSharedPorts_y]
  simp only [Q6EndpointCell.workIds,List.mem_append,List.mem_cons,List.not_mem_nil,
    List.mem_range'_1,or_false] at hi
  exact ⟨OwnPlusHost.not_block i 2056 256 (by omega),
    OwnPlusHost.not_block i 770 256 (by omega)⟩

private theorem raw_work_clean (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Nat) (s : State) (input : PairFrame rawR rawY origin X Y s.basis) :
    Q6EndpointCell.Clean base s.basis := by
  have clean := Q6EndpointCell.clean_of_env base origin ctx.env ctx.parity
  intro q hq
  have away := work_away q hq
  exact (input.2.2 q away.1 away.2).trans (clean q hq)

private theorem copied_work_clean (g : Wire) (s : State)
    (clean : Q6EndpointCell.Clean base s.basis) :
    Q6EndpointCell.Clean base (run [.CX g (base 2409)] [] s).basis := by
  intro q hq
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hq
  have bound := Q6EndpointCell.work_bound i hi
  have away : base i≠base 2409 := HostOB5.host_ne i 2409 (by omega)
  simpa only [run,writeBit,Function.update_of_ne away] using
    clean (base i) (List.mem_map.mpr ⟨i,hi,rfl⟩)

private theorem copied_self_frame (g : Wire) (origin : BasisState) (X Y : Nat)
    (s : State) (input : PairFrame rawR rawY origin X Y s.basis) :
    PairFrame rawR rawY (run [.CX g (base 2409)] [] s).basis X Y
      (run [.CX g (base 2409)] [] s).basis := by
  have same (q : Wire) (away : q≠base 2409) :
      (run [.CX g (base 2409)] [] s).basis q=s.basis q := by
    simp only [run,writeBit,Function.update_of_ne away]
  refine ⟨?_,?_,fun _ _ _ => rfl⟩
  · exact (regValue_congr rawR _ _ (fun q hq => same q
      (fun eq => raw_flag_away.1 (eq ▸ hq)))).trans input.1
  · exact (regValue_congr rawY _ _ (fun q hq => same q
      (fun eq => raw_flag_away.2 (eq ▸ hq)))).trans input.2.1

private theorem half_nodup (origin : BasisState) (ctx : FrontierReplay1591.Context origin) :
    (Q6EndpointCell.ports base (base 2409)).wires.Nodup :=
  Q6EndpointCell.ports_nodup base (base 2409) ctx.hn (fun used =>
    ctx.ho _ (by simp) (balancedSharedLayout_mapSubset base Q6EndpointCell.ids
      Q6EndpointCell.ids_bound used))

theorem half_history_free (divide : Bool) (i : Nat) (hi : i<510) :
    base i∉wires (Q6EndpointCell.half divide base (base 2409)) := by
  intro used
  have member := Q6EndpointCell.half_support divide base (base 2409)
    (base 2409::Q6EndpointCell.ids.map base).toFinset (Finset.Subset.refl _) used
  simp only [List.mem_toFinset,List.mem_cons,List.mem_map] at member
  rcases member with eq|⟨j,hj,eq⟩
  · have same := base_injective eq
    omega
  · have same := base_injective eq
    simp only [Q6EndpointCell.ids,List.mem_append,List.mem_cons,List.not_mem_nil,
      List.mem_range'_1,or_false] at hj
    omega

theorem packetCarry_mem_work (j : Nat) (hj : j<102) :
    packetCarry j∈Q6EndpointCell.workIds.map base := by
  apply List.mem_map.mpr
  refine ⟨516+2*j,?_,rfl⟩
  simp only [Q6EndpointCell.workIds,List.mem_append,List.mem_cons,List.not_mem_nil,
    List.mem_range'_1,or_false]
  omega

/-- The actual half discharges every local loan premise from its ordinary raw frame. -/
theorem halfWindow_eq (divide : Bool) (j i : Nat) (hj : j<102) (hi : i<510)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State) (m : List Bool)
    (input : PairFrame (balancedSharedPorts base (base 2409)).r
      (balancedSharedPorts base (base 2409)).y origin (centerWord X) (centerWord Y) s.basis) :
    run (halfWindow divide j (base i)) m s=
      run (SW.selW (base i) (base 2409) (Q6EndpointCell.half divide base (base 2409))) m s := by
  let copied := run [.CX (base i) (base 2409)] [] s
  have rawClean := raw_work_clean origin ctx _ _ s input
  have copiedClean := copied_work_clean (base i) s rawClean
  have self := copied_self_frame (base i) origin _ _ s input
  have halfResult := Q6EndpointCell.half_frame divide base (base 2409) (half_nodup origin ctx)
    copied.basis copiedClean X Y copied m (by
      simpa only [Q6EndpointCell.ports_r,Q6EndpointCell.ports_y] using self)
  have carryMember := packetCarry_mem_work j hj
  have carryAway := work_away (packetCarry j) carryMember
  have flagIn : s.basis (base 2409)=false :=
    (input.2.2 _ raw_flag_away.1 raw_flag_away.2).trans ctx.hg0
  have keep : (run (Q6EndpointCell.half divide base (base 2409)) m copied).basis (base 2409)=
      copied.basis (base 2409) := by
    apply halfResult.2.2.2
    · simpa only [Q6EndpointCell.ports_r] using raw_flag_away.1
    · simpa only [Q6EndpointCell.ports_y] using raw_flag_away.2
  have carryOut : (run (Q6EndpointCell.half divide base (base 2409)) m copied).basis
      (packetCarry j)=false := by
    apply Eq.trans (halfResult.2.2.2 _ ?_ ?_) (copiedClean _ carryMember)
    · simpa only [Q6EndpointCell.ports_r] using carryAway.1
    · simpa only [Q6EndpointCell.ports_y] using carryAway.2
  have gf : base i≠base 2409 := HostOB5.host_ne i 2409 (by omega)
  have cg : packetCarry j≠base i := HostOB5.host_ne (516+2*j) i (by omega)
  have cf : packetCarry j≠base 2409 := HostOB5.host_ne (516+2*j) 2409 (by omega)
  simpa only [halfWindow] using loanWindow_eq (base i) (base 2409) (packetCarry j)
    (Q6EndpointCell.half divide base (base 2409)) s m gf cg cf
    (half_history_free divide i hi) flagIn (rawClean _ carryMember) keep carryOut

theorem halfWindow_support (divide : Bool) (j i : Nat) (hj : j<102) (hi : i<510) :
    wires (halfWindow divide j (base i))⊆
      (wires (SW.selW (base i) (base 2409)
        (Q6EndpointCell.half divide base (base 2409)))).erase (packetCarry j) := by
  have cg : packetCarry j≠base i := HostOB5.host_ne (516+2*j) i (by omega)
  have cf : packetCarry j≠base 2409 := HostOB5.host_ne (516+2*j) 2409 (by omega)
  simpa only [halfWindow] using loanWindow_support_erase (base i) (base 2409) (packetCarry j)
    (Q6EndpointCell.half divide base (base 2409)) cg cf (half_history_free divide i hi)

theorem halfWindow_avoids_carry (divide : Bool) (j i : Nat) (hj : j<102) (hi : i<510) :
    packetCarry j∉wires (halfWindow divide j (base i)) := by
  intro used
  exact (Finset.mem_erase.mp (halfWindow_support divide j i hj hi used)).1 rfl


attribute [local irreducible] measurementCount

private theorem numeric_away (q : Nat) (hr : q<2056 ∨ 2312≤q) (hy : q<770 ∨ 1026≤q) :
    base q∉rawR ∧ base q∉rawY := by
  rw [rawR,rawY,balancedSharedPorts_r,balancedSharedPorts_y]
  exact ⟨OwnPlusHost.not_block q 2056 256 (by omega),
    OwnPlusHost.not_block q 770 256 (by omega)⟩

private theorem raw_enabled (origin : BasisState) (enabled : origin (base 2400)=true)
    (X Y : Nat) (s : State) (input : PairFrame rawR rawY origin X Y s.basis) :
    s.basis (base 2400)=true :=
  (input.2.2 _ (numeric_away 2400 (by omega) (by omega)).1
    (numeric_away 2400 (by omega) (by omega)).2).trans enabled

private theorem control_nodup (i : Nat) (hi : i<510) :
    [base 2400,base i,base 2409].Nodup ∧
      [base 2400,base (1028+i),base 2409].Nodup := by
  have old := FrontierSW1591.selLetter_nodup i hi
  simpa only [tapeLetter,mixedTape_base_getD i (by omega)] using old

private theorem old_swap_frame (i : Nat) (hi : i<510) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true) (X Y : Fp) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (SW.selW (base (1028+i)) (base 2409) FrontierSW1591.swapBody)
      (PairFrame rawR rawY origin
        (centerWord (if origin (base (1028+i)) then Y else X))
        (centerWord (if origin (base (1028+i)) then X else Y))) := by
  have outside (q : Nat) (hr : q<2056 ∨ 2312≤q) (hy : q<770 ∨ 1026≤q) :
      base q∉(Q6EndpointCell.ports base (base 2409)).r ∧
      base q∉(Q6EndpointCell.ports base (base 2409)).y := by
    simpa only [Q6EndpointCell.ports_r,Q6EndpointCell.ports_y] using numeric_away q hr hy
  have legacy := OneFlagCell.selectSwap_frame base (base 2400) (base (1028+i)) (base 2409) false
    FrontierReplay1591.base_sign_nd (control_nodup i hi).2
    (outside 2400 (by omega) (by omega)) (outside (1028+i) (by omega) (by omega))
    (outside 2409 (by omega) (by omega)) origin ctx.hg0 X Y
  have body : Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (transcriptSelectWindow (base 2400) (base (1028+i)) (base 2409) false FrontierSW1591.swapBody)
      (PairFrame rawR rawY origin
        (centerWord (if origin (base (1028+i)) then Y else X))
        (centerWord (if origin (base (1028+i)) then X else Y))) := by
    simpa only [OneFlagCell.selectSwap,FrontierSW1591.swapBody,Q6EndpointCell.ports_r,
      Q6EndpointCell.ports_y,mixedTranscriptBit,enabled,if_true] using legacy
  have selected := (SW.Sel.refl (base 2400) FrontierSW1591.swapBody
    FrontierSW1591.selSwap_away).window (base (1028+i)) (base 2409) false (control_nodup i hi).2
  intro s m input
  rw [(selected.eq m s (raw_enabled origin enabled _ _ s input)).1]
  exact body s m input

theorem halfWindow_measurements (divide : Bool) (j : Nat) (g : Wire) :
    measurementCount (halfWindow divide j g)=
      measurementCount (SW.selW g (base 2409) (Q6EndpointCell.half divide base (base 2409))) :=
  (loanWindow_counts g (base 2409) (packetCarry j) (Q6EndpointCell.half divide base (base 2409))).2

theorem cell_measurements (divide : Bool) (j : Nat) (g sw : Wire) :
    measurementCount (cell divide j g sw)=measurementCount (FrontierSW1591.cellS divide g sw) := by
  cases divide <;> simp only [cell,FrontierSW1591.cellS,Bool.false_eq_true,if_false,if_true,
    measurementCount_append,halfWindow_measurements]

theorem rawReplay_measurements (divide : Bool) (j : Nat) (ls : List MixedTranscriptLetter) :
    measurementCount (rawReplay divide j ls)=measurementCount (FrontierSW1591.rawReplayS divide ls) := by
  induction ls with
  | nil => simp only [rawReplay,FrontierSW1591.rawReplayS,measurementCount]
  | cons l ls ih =>
    cases divide <;> simp only [rawReplay,FrontierSW1591.rawReplayS,Bool.false_eq_true,if_false,if_true,
      measurementCount_append,cell_measurements,ih]

private theorem append_right_eq (P P0 Q : Program) (s : State) (m : List Bool)
    (count : measurementCount P=measurementCount P0)
    (same : ∀records,run P records s=run P0 records s) :
    run (P++Q) m s=run (P0++Q) m s := by
  rw [run_append,run_append,count,same]

/-- Complete-State equality for an actual ordinary letter in either direction. -/
theorem cell_eq (divide : Bool) (j i : Nat) (hj : j<102) (hi : i<510)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m : List Bool)
    (input : PairFrame (balancedSharedPorts base (base 2409)).r
      (balancedSharedPorts base (base 2409)).y origin (centerWord X) (centerWord Y) s.basis) :
    run (cell divide j (base i) (base (1028+i))) m s=
      run (FrontierSW1591.cellS divide (base i) (base (1028+i))) m s := by
  cases divide
  · let A : Fp := if origin (base (1028+i)) then Y else X
    let B : Fp := if origin (base (1028+i)) then X else Y
    have swapped := old_swap_frame i hi origin ctx enabled X Y s
      (m.take (measurementCount (SW.selW (base (1028+i)) (base 2409) FrontierSW1591.swapBody))) input
    simp only [cell,FrontierSW1591.cellS,Bool.false_eq_true,if_false,run_append]
    exact halfWindow_eq false j i hj hi origin ctx A B _ _ swapped.2
  · simpa only [cell,FrontierSW1591.cellS,if_true] using
      append_right_eq (halfWindow true j (base i))
        (SW.selW (base i) (base 2409) (Q6EndpointCell.half true base (base 2409)))
        (SW.selW (base (1028+i)) (base 2409) FrontierSW1591.swapBody) s m
        (halfWindow_measurements true j (base i))
        (fun records => halfWindow_eq true j i hj hi origin ctx X Y s records input)

private def Indexed (ls : List MixedTranscriptLetter) : Prop :=
  ∀l∈ls,∃i,i<510 ∧ l.1.1=base i ∧ l.1.2=base (1028+i)

private theorem old_raw_frame (divide : Bool) (ls : List MixedTranscriptLetter)
    (indices : Indexed ls)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) ls)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (FrontierSW1591.rawReplayS divide ls)
      (PairFrame rawR rawY origin
        (centerWord (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) ls) (X,Y)).1)
        (centerWord (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) ls) (X,Y)).2)) := by
  have selected := FrontierSW1591.selRaw_sel divide ls (by
    intro l hl
    obtain ⟨i,hi,hg,hs⟩ := indices l hl
    rw [hg,hs]
    exact control_nodup i hi)
  intro s m input
  rw [(selected.eq m s (raw_enabled origin enabled _ _ s input)).1]
  exact FrontierReplay1591.raw_frame divide ls hf origin ctx X Y s m input

private theorem old_cell_frame (divide : Bool) (l : MixedTranscriptLetter)
    (indices : Indexed [l])
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) [l])
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (FrontierSW1591.cellS divide l.1.1 l.1.2)
      (PairFrame rawR rawY origin
        (centerWord (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) [l]) (X,Y)).1)
        (centerWord (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) [l]) (X,Y)).2)) := by
  have result := old_raw_frame divide [l] indices hf origin ctx enabled X Y
  cases divide <;> simpa only [FrontierSW1591.rawReplayS,Bool.false_eq_true,if_false,if_true,
    List.nil_append,List.append_nil] using result

private theorem append_frame_eq (P P0 Q Q0 : Program) (A B : BasisState → Prop)
    (count : measurementCount P=measurementCount P0)
    (first : ∀s m,A s.basis → run P m s=run P0 m s)
    (frame : Triple A P0 B)
    (second : ∀s m,B s.basis → run Q m s=run Q0 m s)
    (s : State) (m : List Bool) (input : A s.basis) :
    run (P++Q) m s=run (P0++Q0) m s := by
  rw [run_append,run_append,count,first s (m.take (measurementCount P0)) input]
  exact second _ _ (frame s (m.take (measurementCount P0)) input).2

private theorem run_eq_program_transport (P Q A B : Program)
    (left : P=A) (right : Q=B) (s : State) (m : List Bool)
    (result : run A m s=run B m s) : run P m s=run Q m s := by
  subst P
  subst Q
  exact result

private theorem triple_run_transfer (P Q : Program) (A B : BasisState → Prop)
    (equal : ∀s m,A s.basis → run P m s=run Q m s)
    (frame : Triple A Q B) : Triple A P B := by
  intro s m input
  rw [equal s m input]
  exact frame s m input

private theorem replay_triple_transport (P Q : Program) (shape : P=Q)
    (A B : BasisState → Prop) (frame : Triple A Q B) : Triple A P B := by
  cases shape
  exact frame

/-- Record splitting stays inside the abstract Triple.seq theorem. -/
private theorem replay_frame_of_cells {α β : Type}
    (P : Bool → List α → Program) (C : Bool → α → Program)
    (nilProgram : ∀d,P d []=[])
    (consProgram : ∀d l ls,P d (l::ls)=
      if d then C true l++P true ls else P false ls++C false l)
    (F : β → BasisState → Prop) (K : Bool → List α → β → β)
    (nilPayload : ∀d V,K d [] V=V)
    (consPayload : ∀d l ls V,K d (l::ls) V=
      if d then K true ls (K true [l] V) else K false [l] (K false ls V))
    (Good : α → Prop)
    (cells : ∀d l,Good l → ∀V,Triple (F V) (C d l) (F (K d [l] V)))
    (divide : Bool) (ls : List α) (good : ∀l∈ls,Good l) (V : β) :
    Triple (F V) (P divide ls) (F (K divide ls V)) := by
  induction ls generalizing divide V with
  | nil =>
    intro s m input
    simpa only [nilProgram,nilPayload,run] using And.intro (Eq.refl s.phase) input
  | cons l ls ih =>
    have headGood := good l (List.mem_cons_self ..)
    have tailGood : ∀a∈ls,Good a := fun a ha => good a (List.mem_cons_of_mem l ha)
    cases divide
    · have tail := ih false tailGood V
      have head := cells false l headGood (K false ls V)
      have result := tail.seq head
      have shape : P false (l::ls)=P false ls++C false l := by
        simp only [consProgram,Bool.false_eq_true,if_false]
      have value : K false (l::ls) V=K false [l] (K false ls V) := by
        simpa only [Bool.false_eq_true,if_false] using consPayload false l ls V
      rw [value]
      exact replay_triple_transport _ _ shape _ _ result
    · have head := cells true l headGood V
      have tail := ih true tailGood (K true [l] V)
      have result := head.seq tail
      have shape : P true (l::ls)=C true l++P true ls := by
        simp only [consProgram,if_true]
      have value : K true (l::ls) V=K true ls (K true [l] V) := by
        simpa only [if_true] using consPayload true l ls V
      rw [value]
      exact replay_triple_transport _ _ shape _ _ result

private theorem loan_cell_frame (divide : Bool) (j : Nat) (hj : j<102)
    (l : MixedTranscriptLetter) (indices : Indexed [l])
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) [l])
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y))
      (cell divide j l.1.1 l.1.2)
      (PairFrame rawR rawY origin
        (centerWord (CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) [l]) (X,Y)).1)
        (centerWord (CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) [l]) (X,Y)).2)) := by
  have old := old_cell_frame divide l indices hf origin ctx enabled X Y
  refine triple_run_transfer _ _ _ _ ?_ old
  intro s m input
  obtain ⟨i,hi,hg,hs⟩ := indices l (by simp)
  exact run_eq_program_transport (cell divide j l.1.1 l.1.2)
    (FrontierSW1591.cellS divide l.1.1 l.1.2)
    (cell divide j (base i) (base (1028+i)))
    (FrontierSW1591.cellS divide (base i) (base (1028+i)))
    (congrArg₂ (cell divide j) hg hs) (congrArg₂ (FrontierSW1591.cellS divide) hg hs)
    s m (cell_eq divide j i hj hi origin ctx enabled X Y s m input)

private theorem rawReplay_frame (divide : Bool) (j : Nat) (hj : j<102)
    (ls : List MixedTranscriptLetter) (indices : Indexed ls)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) ls)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Triple (PairFrame rawR rawY origin (centerWord X) (centerWord Y)) (rawReplay divide j ls)
      (PairFrame rawR rawY origin
        (centerWord (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) ls) (X,Y)).1)
        (centerWord (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) ls) (X,Y)).2)) := by
  let K : Bool → List MixedTranscriptLetter → Fp×Fp → Fp×Fp := fun d letters V =>
    CompressedFieldSupport.directionalPayload (!d) (mixedTranscriptControls origin (base 2400) letters) V
  let Good : MixedTranscriptLetter → Prop := fun l => Indexed [l] ∧
    MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) [l]
  have each : ∀l∈ls,Good l := by
    intro l hl
    constructor
    · intro a ha
      have eq : a=l := by simpa only [List.mem_singleton] using ha
      subst a
      exact indices l hl
    · intro a ha
      have eq : a=l := by simpa only [List.mem_singleton] using ha
      subst a
      exact hf l hl
  have nilPayload : ∀d V,K d [] V=V := by
    intro d V
    cases d <;> rfl
  have consPayload : ∀d l letters V,K d (l::letters) V=
      if d then K true letters (K true [l] V) else K false [l] (K false letters V) := by
    intro d l letters V
    cases d <;> simp only [K,CompressedFieldSupport.directionalPayload,Bool.not_false,Bool.not_true,
      Bool.false_eq_true,if_false,if_true,mixedTranscriptControls,List.map_cons,List.map_nil,
      skywalkPayloadReplay,skywalkPayloadReplayInverse]
  exact replay_frame_of_cells (fun d letters => rawReplay d j letters)
    (fun d l => cell d j l.1.1 l.1.2)
    (fun d => by simp only [rawReplay])
    (fun d l letters => by simp only [rawReplay])
    (fun V => PairFrame rawR rawY origin (centerWord V.1) (centerWord V.2)) K
    nilPayload consPayload Good
    (fun d l good V => by
      simpa only [Prod.mk.eta] using
        loan_cell_frame d j hj l good.1 good.2 origin ctx enabled V.1 V.2)
    divide ls each (X,Y)

/-- Complete frames compare independent record streams without concrete count casts. -/
private theorem rawReplay_eq (divide : Bool) (j : Nat) (hj : j<102)
    (ls : List MixedTranscriptLetter) (indices : Indexed ls)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) ls)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m : List Bool)
    (input : PairFrame rawR rawY origin (centerWord X) (centerWord Y) s.basis) :
    run (rawReplay divide j ls) m s=run (FrontierSW1591.rawReplayS divide ls) m s :=
  PairFrame.program_eq rawR rawY origin (centerWord X) (centerWord Y) _ _
    (rawReplay divide j ls) (FrontierSW1591.rawReplayS divide ls)
    (rawReplay_frame divide j hj ls indices hf origin ctx enabled X Y)
    (old_raw_frame divide ls indices hf origin ctx enabled X Y) s m m input

private theorem tape_indices (i : Nat) (hi : i<510) :
    (tapeLetter i).1.1=base i ∧ (tapeLetter i).1.2=base (1028+i) := by
  simp only [tapeLetter,mixedTape_base_getD i (by omega)]
  exact ⟨True.intro,True.intro⟩

private theorem letters_indices (j : Nat) (hj : j<102) : Indexed (Replay5.letters j) := by
  intro l hl
  obtain ⟨k,hk,rfl⟩ := List.mem_map.mp hl
  have bound := List.mem_range.mp hk
  exact ⟨5*j+k,by omega,(tape_indices _ (by omega)).1,(tape_indices _ (by omega)).2⟩

private theorem rest_indices : Indexed Replay5.restLetters := by
  intro l hl
  obtain ⟨k,hk,rfl⟩ := List.mem_map.mp hl
  have bound := List.mem_range'_1.mp hk
  exact ⟨k,by omega,(tape_indices _ (by omega)).1,(tape_indices _ (by omega)).2⟩

private theorem append_support (P Q P0 Q0 : Program)
    (hp : wires P⊆wires P0) (hq : wires Q⊆wires Q0) :
    wires (P++Q)⊆wires (P0++Q0) := by
  rw [wires_append,wires_append]
  exact Finset.union_subset_union hp hq

private theorem rename_support (f : Wire→Wire) (P Q : Program) (sub : wires P⊆wires Q) :
    wires (renameProgram f P)⊆wires (renameProgram f Q) := by
  rw [renameProgram_support,renameProgram_support]
  exact Finset.image_mono f sub

private theorem cell_support (divide : Bool) (j i : Nat) (hj : j<102) (hi : i<510) (sw : Wire) :
    wires (cell divide j (base i) sw)⊆wires (FrontierSW1591.cellS divide (base i) sw) := by
  have half (d : Bool) := (halfWindow_support d j i hj hi).trans (Finset.erase_subset _ _)
  cases divide
  · simpa only [cell,FrontierSW1591.cellS,Bool.false_eq_true,if_false] using
      append_support _ _ _ _ (Finset.Subset.refl _) (half false)
  · simpa only [cell,FrontierSW1591.cellS,if_true] using
      append_support _ _ _ _ (half true) (Finset.Subset.refl _)

private theorem rawReplay_support (divide : Bool) (j : Nat) (hj : j<102)
    (ls : List MixedTranscriptLetter) (indices : Indexed ls) :
    wires (rawReplay divide j ls)⊆wires (FrontierSW1591.rawReplayS divide ls) := by
  induction ls with
  | nil => exact Finset.Subset.refl _
  | cons l ls ih =>
    obtain ⟨i,hi,hg,hs⟩ := indices l (by simp)
    have head : wires (cell divide j l.1.1 l.1.2)⊆wires (FrontierSW1591.cellS divide l.1.1 l.1.2) := by
      rw [hg]
      exact cell_support divide j i hj hi l.1.2
    have tail := ih (fun q hq => indices q (List.mem_cons_of_mem l hq))
    cases divide
    · simpa only [rawReplay,FrontierSW1591.rawReplayS,Bool.false_eq_true,if_false] using
        append_support _ _ _ _ tail head
    · simpa only [rawReplay,FrontierSW1591.rawReplayS,if_true] using
        append_support _ _ _ _ head tail

theorem body_read_support (divide : Bool) (j : Nat) (hj : j<102) :
    wires (rawReplay divide j (Replay5.letters j))⊆
      NewHistory5.groupReadSites base (base 2400) (base 2409) (base 2410) (5*j) ∪ {base 2312} := by
  have selected := FrontierSW1591.selRaw_sel divide (Replay5.letters j)
    (FrontierSW1591.selLetters_nodup j hj)
  have old : wires (FrontierReplay1591.rawReplay divide (Replay5.letters j))⊆
      NewHistory5.groupReadSites base (base 2400) (base 2409) (base 2410) (5*j) ∪ {base 2312} := by
    simpa only [FrontierReplay1591.body] using FrontierReplay1591.body_read_support divide j hj
  exact ((rawReplay_support divide j hj _ (letters_indices j hj)).trans selected.sub.wires_sub).trans old

theorem body_frame (divide : Bool) (j : Nat) (hj : j<102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Triple (PairFrame (balancedSharedPorts base (base 2409)).r
      (balancedSharedPorts base (base 2409)).y origin (centerWord X) (centerWord Y))
      (rawReplay divide j (Replay5.letters j))
      (PairFrame (balancedSharedPorts base (base 2409)).r
        (balancedSharedPorts base (base 2409)).y origin
        (centerWord (CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)).1)
        (centerWord (CompressedFieldSupport.directionalPayload (!divide)
          (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)).2)) :=
  rawReplay_frame divide j hj _ (letters_indices j hj) (Replay5.letters_layouts ctx.hf j hj)
    origin ctx enabled X Y

theorem packet_frame (divide : Bool) (j : Nat) (hj : j<102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    (run (packet divide j) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)).1
        (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)).2
        (run (packet divide j) m s) := by
  have raw := body_frame divide j hj origin ctx enabled X Y
  have fresh := NewFieldFrameOB5.encoded_window_step base (base 2400) (base 2409) (base 2410)
    ctx.hn ctx.hp j hj origin X Y _ _ _ (body_read_support divide j hj) raw s m input ctx.legal
  have placed := Replay5.placed_eq (Placement5.pi j) (basePacket divide j)
    (fun q hq => Placement5.pi_outside j q hj hq) s m
    (NewHistory5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp))
      origin ctx.env ctx.legal X Y s input)
    (NewHistory5.encoded_zero_region base (base 2409) ctx.hn (ctx.hp _ (by simp))
      origin ctx.env ctx.legal _ _ _ fresh.2)
  have same : run (packet divide j) m s=run (basePacket divide j) m s := by
    simpa only [packet] using placed
  rw [same]
  simpa only [basePacket,List.append_assoc] using fresh

theorem groups_frame (divide : Bool) (j n : Nat) (bound : j+n≤102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    (run (groups divide j n) m s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (Replay5.groupsPayload divide origin j n (X,Y)).1 (Replay5.groupsPayload divide origin j n (X,Y)).2
        (run (groups divide j n) m s) := by
  have result := PacketSequence.frame divide (packet divide) (packet divide)
    (fun k V => CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) (Replay5.letters k)) V)
    (fun V t => NewHistory5.EncodedFieldFrame5 base (base 2409) origin V.1 V.2 t) 102 (fun _ => rfl)
    (fun k hk V t records h => ⟨rfl,packet_frame divide k hk origin ctx enabled V.1 V.2 t records h⟩)
    j n bound (X,Y) s m input
  exact result.2

private theorem encoded_control (origin : BasisState) (X Y : Fp) (s : State)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    s.basis (base 2400)=origin (base 2400) := by
  obtain ⟨raw,_,frame,encoded⟩ := input
  have same : raw.basis (base 2400)=origin (base 2400) :=
    frame.2.2 _ (numeric_away 2400 (by omega) (by omega)).1
      (numeric_away 2400 (by omega) (by omega)).2
  rw [encoded]
  exact (run_preserves_outside _ [] raw _
    (FrontierEntry1591Field.encoder_special_away 2400 (by simp))).trans same

private theorem encoded_field_unique (origin : BasisState) (X Y : Fp) (s t : State)
    (hs : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s)
    (ht : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y t) (phase : s.phase=t.phase) : s=t := by
  obtain ⟨a,ha,fa,ea⟩ := hs
  obtain ⟨b,hb,fb,eb⟩ := ht
  have raw : a=b := by
    apply State.extensionality
    · exact ha.trans (phase.trans hb.symm)
    · exact PairFrame.unique _ _ origin _ _ _ _ fa fb
  rw [ea,eb,raw]

/-- Independent complete measurement lists give the identical restored packet state. -/
theorem packet_run_eq_old (divide : Bool) (j : Nat) (hj : j<102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m n : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    run (packet divide j) m s=run (FrontierSW1591.packetS divide j) n s := by
  have a := packet_frame divide j hj origin ctx enabled X Y s m input
  have old := FrontierReplay1591.packet_frame divide j hj origin ctx X Y s n input
  have selected := (FrontierSW1591.selPacket_sel divide j hj).eq n s
    ((encoded_control origin X Y s input).trans enabled)
  have b : (run (FrontierSW1591.packetS divide j) n s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)).1
        (CompressedFieldSupport.directionalPayload (!divide) (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)).2
        (run (FrontierSW1591.packetS divide j) n s) := by rw [selected.1];exact old
  exact encoded_field_unique origin _ _ _ _ a.2 b.2 (a.1.trans b.1.symm)

theorem groups_run_eq_old (divide : Bool) (j n : Nat) (bound : j+n≤102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (m records : List Bool)
    (input : NewHistory5.EncodedFieldFrame5 base (base 2409) origin X Y s) :
    run (groups divide j n) m s=run (FrontierSW1591.groupsS divide j n) records s := by
  have a := groups_frame divide j n bound origin ctx enabled X Y s m input
  have old := FrontierReplay1591.groups_frame divide j n bound origin ctx X Y s records input
  have selected := (FrontierSW1591.selGroups_sel divide j n bound).eq records s
    ((encoded_control origin X Y s input).trans enabled)
  have b : (run (FrontierSW1591.groupsS divide j n) records s).phase=s.phase ∧
      NewHistory5.EncodedFieldFrame5 base (base 2409) origin
        (Replay5.groupsPayload divide origin j n (X,Y)).1 (Replay5.groupsPayload divide origin j n (X,Y)).2
        (run (FrontierSW1591.groupsS divide j n) records s) := by rw [selected.1];exact old
  exact encoded_field_unique origin _ _ _ _ a.2 b.2 (a.1.trans b.1.symm)

private theorem rest_layout (origin : BasisState) (ctx : FrontierReplay1591.Context origin) :
    MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) Replay5.restLetters := by
