namespace ECDSAAdd.Entrant.Q6Structural
open Arithmetic FieldRename BalancedCircuit

def q6Carry (L : BalancedCircuit.Layout) : List Wire :=
  L.carry.take 254 ++ [L.lower] ++ L.carry.drop 255

def carryLayout (L : BalancedCircuit.Layout) : BalancedCircuit.Layout :=
  {L with carry:=q6Carry L}

theorem carryLayout_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    mapCircuit f (carryLayout L)=carryLayout (mapCircuit f L) := by
  simp only [carryLayout,q6Carry,mapCircuit,mapCleanup,List.map_append,List.map_cons,List.map_nil,
    List.map_take,List.map_drop]

def rawAdd (L : BalancedCircuit.Layout) := FifthCarry.rawAdd (carryLayout L)
def rawSub (L : BalancedCircuit.Layout) := FifthCarry2.rawSub (carryLayout L)
def compareForward (L : BalancedCircuit.Layout) := TopCarryBorrow.program (carryLayout L)
def compareInverse (L : BalancedCircuit.Layout) := CarryBorrow.program (carryLayout L)

theorem rawAdd_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (rawAdd L)=rawAdd (mapCircuit f L) := by
  rw [rawAdd,FifthCarry.rawAdd_natural,carryLayout_natural]; rfl

theorem rawSub_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (rawSub L)=rawSub (mapCircuit f L) := by
  rw [rawSub,FifthCarry2.rawSub_natural,carryLayout_natural]; rfl

theorem compareForward_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (compareForward L)=compareForward (mapCircuit f L) := by
  rw [compareForward,TopCarryBorrow.program_natural,carryLayout_natural]; rfl

theorem compareInverse_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (compareInverse L)=compareInverse (mapCircuit f L) := by
  rw [compareInverse,CarryBorrow.program_natural,carryLayout_natural]; rfl

private theorem fixedMap (f : Wire→Wire) (xs : List Wire) (h : ∀q∈xs,f q=q) : xs.map f=xs := by
  simpa using List.map_congr_left h

private theorem swap_carry (xs : List Wire) (lower : Wire) (nd : (lower::xs).Nodup)
    (hi : 254<xs.length) :
    xs.map (Equiv.swap (xs.getD 254 0) lower)=xs.take 254++[lower]++xs.drop 255 := by
  have split : xs=xs.take 254++xs[254]::xs.drop 255 := by
    rw [←List.drop_eq_getElem_cons hi,List.take_append_drop]
  have shape : (lower::(xs.take 254++xs[254]::xs.drop 255)).Nodup := split ▸ nd
  have lo : lower∉xs := (List.nodup_cons.mp nd).1
  have parts := List.nodup_append'.mp (List.nodup_cons.mp shape).2
  have front : xs[254]∉xs.take 254 := fun h=>List.disjoint_left.mp parts.2.2 h (List.mem_cons_self)
  have back : xs[254]∉xs.drop 255 := (List.nodup_cons.mp parts.2.1).1
  have get : xs.getD 254 0=xs[254] := List.getD_eq_getElem _ _ hi
  have fp : (xs.take 254).map (Equiv.swap xs[254] lower)=xs.take 254 := by
    apply fixedMap
    intro q h
    exact Equiv.swap_apply_of_ne_of_ne (fun e=>front (e ▸ h))
      (fun e=>lo (e ▸ List.mem_of_mem_take h))
  have bp : (xs.drop 255).map (Equiv.swap xs[254] lower)=xs.drop 255 := by
    apply fixedMap
    intro q h
    exact Equiv.swap_apply_of_ne_of_ne (fun e=>back (e ▸ h))
      (fun e=>lo (e ▸ List.mem_of_mem_drop h))
  rw [get]
  calc
    xs.map (Equiv.swap xs[254] lower) =
      (xs.take 254++xs[254]::xs.drop 255).map (Equiv.swap xs[254] lower) :=
        congrArg (fun ys : List Wire=>ys.map (Equiv.swap xs[254] lower)) split
    _ = _ := by simp only [List.map_append,List.map_cons,fp,bp,Equiv.swap_apply_left,List.append_assoc,List.singleton_append]

def core (L : BalancedCircuit.Layout) : List Wire :=
  [L.r0,L.rmsb,L.ymsb,L.sign,L.parity,L.one,L.sourceGuard,L.cout,L.minus,L.plus]++L.rtail++L.ylow

private theorem coreND (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    (L.lower::L.carry++core L).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have nd:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
  simp only [core,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,
    List.count_cons,List.count_append,List.count_nil] at nd ⊢
  omega

theorem map_swap (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    mapCircuit (Equiv.swap (L.carry.getD 254 0) L.lower) L=
      {carryLayout L with lower:=L.carry.getD 254 0} := by
  have idx : 254<L.carry.length := by rw [hw.2.2];omega
  have am : L.carry.getD 254 0∈L.carry := by
    rw [List.getD_eq_getElem _ _ idx];exact List.getElem_mem _
  have nd := coreND L hn
  have dc := List.nodup_append'.mp (List.nodup_cons.mp nd).2
  have lowerAway := (List.nodup_cons.mp nd).1
  have aAway : L.carry.getD 254 0∉core L := fun h=>List.disjoint_left.mp dc.2.2 am h
  have fixed (q : Wire) (h : q∈core L) : Equiv.swap (L.carry.getD 254 0) L.lower q=q := by
    apply Equiv.swap_apply_of_ne_of_ne
    · intro e;exact aAway (e ▸ h)
    · intro e;exact lowerAway (List.mem_append_right _ (e ▸ h))
  have rt := fixedMap _ L.rtail (fun q h=>fixed q (by simp [core,h]))
  have yl := fixedMap _ L.ylow (fun q h=>fixed q (by simp [core,h]))
  have cnd : (L.lower::L.carry).Nodup := by
    apply List.nodup_iff_count.mpr;intro q
    have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_cons,List.count_append] at h ⊢;omega
  have cc := swap_carry L.carry L.lower cnd idx
  have f0:=fixed L.r0 (by simp [core])
  have f1:=fixed L.rmsb (by simp [core])
  have f2:=fixed L.ymsb (by simp [core])
  have f3:=fixed L.sign (by simp [core])
  have f4:=fixed L.parity (by simp [core])
  have f5:=fixed L.one (by simp [core])
  have f6:=fixed L.sourceGuard (by simp [core])
  have f7:=fixed L.cout (by simp [core])
  have f8:=fixed L.minus (by simp [core])
  have f9:=fixed L.plus (by simp [core])
  simp only [mapCircuit,mapCleanup,rt,yl,cc,f0,f1,f2,f3,f4,f5,f6,f7,f8,f9,
    Equiv.swap_apply_right,carryLayout,q6Carry]

private theorem rawAdd_lower (L : BalancedCircuit.Layout) (a : Wire) :
    FifthCarry.rawAdd {L with lower:=a}=FifthCarry.rawAdd L := rfl
private theorem rawSub_lower (L : BalancedCircuit.Layout) (a : Wire) :
    FifthCarry2.rawSub {L with lower:=a}=FifthCarry2.rawSub L := rfl
private theorem compareForward_lower (L : BalancedCircuit.Layout) (a : Wire) :
    TopCarryBorrow.program {L with lower:=a}=TopCarryBorrow.program L := rfl
private theorem compareInverse_lower (L : BalancedCircuit.Layout) (a : Wire) :
    CarryBorrow.program {L with lower:=a}=CarryBorrow.program L := rfl

theorem rawAdd_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    renameProgram (Equiv.swap (L.carry.getD 254 0) L.lower) (FifthCarry.rawAdd L)=rawAdd L := by
  rw [FifthCarry.rawAdd_natural,map_swap L hw hn,rawAdd_lower];rfl

theorem rawSub_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    renameProgram (Equiv.swap (L.carry.getD 254 0) L.lower) (FifthCarry2.rawSub L)=rawSub L := by
  rw [FifthCarry2.rawSub_natural,map_swap L hw hn,rawSub_lower];rfl

theorem compareForward_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    renameProgram (Equiv.swap (L.carry.getD 254 0) L.lower) (TopCarryBorrow.program L)=compareForward L := by
  rw [TopCarryBorrow.program_natural,map_swap L hw hn,compareForward_lower];rfl

theorem compareInverse_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    renameProgram (Equiv.swap (L.carry.getD 254 0) L.lower) (CarryBorrow.program L)=compareInverse L := by
  rw [CarryBorrow.program_natural,map_swap L hw hn,compareInverse_lower];rfl
end ECDSAAdd.Entrant.Q6Structural

set_option maxHeartbeats 3000000
