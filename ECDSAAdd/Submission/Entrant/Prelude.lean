  rw [xv,hlen] at r
  have act := ht.advance hn 0 (-(signedDiagValue (regValue R.lo base.basis) R.h : Int)) r
  simpa only [show (vec A B S T) 0=A from rfl,vec0,sub_eq_add_neg] using act

