theorem generic_ok (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) :
    GenericOK L hc (program L cx cy) :=
  fun R b f hg => boundary_generic L hw hn R b f hc hg

