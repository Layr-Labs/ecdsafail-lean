attribute [local irreducible] wires run toffoliCount measurementCount gateSlots
  rawReplay FrontierSW1591.rawReplayS firstBody FrontierSW1591.firstBodyS
  groups FrontierSW1591.groupsS Prefix1590.entryTail Prefix1590.exitHead
