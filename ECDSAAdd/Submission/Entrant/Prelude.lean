theorem otherEncode_member (w : Nat → Wire) (n j : Nat) (q : Wire)
    (h : q∈wires (otherEncode w j n)) : ∃k,k<n ∧ k≠j ∧ q∈wires (encode w (5*k)) := by
  induction n with
