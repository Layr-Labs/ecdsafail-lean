    rw [unary_half]
    exact h.1
  have yy : regValue L.y s.basis=encodeWord 256 (if origin J then centerFp Z else 0) := by
    rw [source_word]
    exact h.2.1
  have out:=jointHD_frame L hw hn J G hJ hG hJG (origin J) (origin G) (centerFp Z)
