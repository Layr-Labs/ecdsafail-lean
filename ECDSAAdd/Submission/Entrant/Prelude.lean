  exact ⟨rename _ (OwnGuardEndpoint.support.1),rename _ (OwnGuardEndpoint.support.2)⟩
theorem prior_free765 : base 765∉wires centerT ∧ base 765∉wires canonT := by
  have fix : swap (base 765)=base 765 := by decide +kernel
  exact ⟨OwnPlusHost.rename_avoid _ _ _ fix OwnGuardEndpoint.plus_free.1,
    OwnPlusHost.rename_avoid _ _ _ fix OwnGuardEndpoint.plus_free.2⟩

