theorem triple_erase_bound {S : Finset Wire} {l : List Wire} {x y z : Wire}
    (sub : S⊆l.toFinset) (hx : x∉S) (hy : y∉S) (hz : z∉S)
    (xl : x∈l) (yl : y∈l) (zl : z∈l) (xy : x≠y) (xz : x≠z) (yz : y≠z) :
    S.card≤l.length-3 := by
