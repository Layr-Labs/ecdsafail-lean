def Good (w a : Nat) (p q : Program) : Prop :=
  (∀i∈p,target i<w) ∧ (∀i∈q,target i<w) ∧
  (eval a p (inputs w a)).1=true ∧ (eval a q (inputs w a)).1=true ∧ (eval a p (inputs w a)).2=(eval a q (inputs w a)).2
