-- ===== ECDSAAdd.Submission.Entrant.Kernel5 =====
section

set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Kernel5
open Arithmetic Secp256k1 DirectSkywalk MappedCompressed CompressedFieldSupport
open NativeFirstDirect OffsetBorrowedCanonical History5
attribute [local irreducible] run wires History5.allEncode literalSkywalkSeed
  compactSkywalkForward NativeFirstDirect.forward NativeFirstDirect.reference skywalkArithmeticClear

def actualKernel5 (divide : Bool) : Program :=
  NativeFirstDirect.forward base++compactForward5 base 1 511++skywalkArithmeticClear base++
