namespace ECDSAAdd.Entrant.OwnGuardEndpoint
open Arithmetic MappedCompressed
theorem support : wires centerT⊆OB5Support.segSites ∧ wires canonT⊆OB5Support.segSites := by
  have mem (q : Nat) (hq : q=765 ∨ q=767) : base q∈OB5Support.segSites := by
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨q,?_,rfl⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false]
    omega
  have rename (P : Program) (hp : wires P⊆OB5Support.segSites) :
      wires (renameProgram swap P)⊆OB5Support.segSites := by
    rw [renameProgram_support]
    intro q hq
    obtain ⟨old,used,rfl⟩:=Finset.mem_image.mp hq
    by_cases a:old=base 765
    · subst old; simpa only [swap,Equiv.swap_apply_left] using mem 767 (Or.inr rfl)
    · by_cases b:old=base 767
      · subst old; simpa only [swap,Equiv.swap_apply_right] using mem 765 (Or.inl rfl)
      · simpa only [swap,Equiv.swap_apply_of_ne_of_ne a b] using hp used
  exact ⟨rename _ (OwnPlusEndpoint.support.1),rename _ (OwnPlusEndpoint.support.2)⟩
theorem prior_free : base 766∉wires centerT ∧ base 766∉wires canonT := by
  have fix : swap (base 766)=base 766 := by decide +kernel
  exact ⟨OwnPlusHost.rename_avoid _ _ _ fix OwnPlusEndpoint.plus_free.1,
    OwnPlusHost.rename_avoid _ _ _ fix OwnPlusEndpoint.plus_free.2⟩
end ECDSAAdd.Entrant.OwnGuardEndpoint

