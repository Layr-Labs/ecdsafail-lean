-- ===== ECDSAAdd.Submission.Entrant.CompactHistory5 =====
section

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.History5
open Arithmetic Secp256k1

def integerSites5 (w : Nat → Wire) : Finset Wire :=
  (wireBlock w 0 515++wireBlock w 770 1028).toFinset

theorem integerSites5_mem (w : Nat → Wire) (q : Wire) :
    q∈integerSites5 w ↔ ∃j,j < 1798 ∧ (j < 515 ∨ 770 ≤ j) ∧ q=w j := by
  simp only [integerSites5,List.mem_toFinset,List.mem_append,wireBlock,List.mem_map,
    List.mem_range'_1]
  constructor
  · rintro (⟨j,hj,rfl⟩|⟨j,hj,rfl⟩)
    · exact ⟨j,by omega,Or.inl (by omega),rfl⟩
    · exact ⟨j,by omega,Or.inr (by omega),rfl⟩
  · rintro ⟨j,hj,(ha|hb),rfl⟩
    · exact Or.inl ⟨j,by omega,rfl⟩
    · exact Or.inr ⟨j,by omega,rfl⟩

theorem integerSites5_pool (w : Nat → Wire) :
    integerSites5 w⊆(skywalkPoolWires w).toFinset := by
  intro q hq
  obtain ⟨j,hj,_,rfl⟩ := (integerSites5_mem w q).mp hq
  simp only [skywalkPoolWires,wireBlock,List.mem_toFinset,List.mem_map,List.mem_range'_1]
  exact ⟨j,by omega,rfl⟩

theorem compactTick_middle_unused (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i : Nat) (hi : i < 512)
    (j : Nat) (hlo : 515 ≤ j) (hhi : j < 770) :
    w j∉(compactSkywalkTickLayout w i).wires := by
  have width := compactSkywalkTick_width_bounds i hi
  apply compactSkywalkStage_tick_away w i hi hn j (by omega)
  · unfold skywalkPoolPreviousId
    split_ifs <;> omega
  all_goals omega

theorem compactTick_support5 (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i : Nat) (hi : i < 512) :
    wires (compactSkywalkTick w i)⊆integerSites5 w ∧
    wires (compactSkywalkReverseTick w i)⊆integerSites5 w := by
  have lift (q : Wire) (hq : q∈(compactSkywalkTickLayout w i).wires) :
      q∈integerSites5 w := by
    have pool := compactSkywalkTick_local_support w i hi hq
    simp only [skywalkPoolWires,wireBlock,List.mem_map,List.mem_range'_1] at pool
    obtain ⟨j,hj,rfl⟩ := pool
    apply (integerSites5_mem w (w j)).mpr
    refine ⟨j,by omega,?_,rfl⟩
    by_cases small : j < 515
    · exact Or.inl small
    · exact Or.inr (by
        by_contra bad
        exact compactTick_middle_unused w hn i hi j (by omega) (by omega) hq)
  exact ⟨fun q hq => lift q (List.mem_toFinset.mp (compactSkywalkTick_support w i hi hn hq)),
    fun q hq => lift q (List.mem_toFinset.mp (compactSkywalkReverseTick_support w i hi hn hq))⟩

/-- A five-letter group is not used after the tick that consumes its last G. -/
theorem historyId_away_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (start i : Nat)
    (hs : start+5 ≤ 512) (hlate : start+6 ≤ i) (hi : i < 512) (j : Fin 10) :
    w (historyId start j)∉(compactSkywalkTickLayout w i).wires := by
  have width := compactSkywalkTick_width_bounds i hi
  have hpos : i ≠ 0 := by omega
  apply compactSkywalkStage_tick_away w i hi hn (historyId start j)
    (historyId_bound start hs j)
  all_goals
    have hj := j.isLt
    unfold historyId
    split_ifs <;> (try simp only [skywalkPoolPreviousId,if_neg hpos]) <;> omega

theorem history_support5 (w : Nat → Wire) (start : Nat) (hs : start+5 ≤ 512) :
    wires (encode w start)⊆integerSites5 w ∧ wires (decode w start)⊆integerSites5 w := by
  have lift (p : Program) (hp : p=encode w start ∨ p=decode w start) :
      wires p⊆integerSites5 w := by
    intro q hq
    obtain ⟨j,rfl⟩ := history_gate_mem w start p hp q hq
    apply (integerSites5_mem w _).mpr
    have region := historyId_region start hs j
    exact ⟨historyId start j,historyId_bound start hs j,by omega,rfl⟩
  exact ⟨lift _ (Or.inl rfl),lift _ (Or.inr rfl)⟩

theorem pack_support5 (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    wires (packAfter w i)⊆integerSites5 w ∧ wires (decodeBefore w i)⊆integerSites5 w := by
  cases due : packDue i
  · simp [packAfter,decodeBefore,due,wires]
  · have bounds := packDue_true i due
    simpa only [packAfter,decodeBefore,due,if_true] using history_support5 w (i-5) (by omega)

theorem history_disjoint_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (_hlo : HistoryAbove w)
    (start i : Nat) (hs : start+5 ≤ 512) (hlate : start+6 ≤ i) (hi : i < 512) :
    Disjoint (wires (encode w start)) (wires (compactSkywalkTick w i)) := by
  apply Finset.disjoint_left.mpr
  intro q hq ht
  obtain ⟨j,rfl⟩ := history_gate_mem w start _ (Or.inl rfl) q hq
  exact historyId_away_compactTick w hn start i hs hlate hi j
    (List.mem_toFinset.mp (compactSkywalkTick_support w i hi hn ht))

theorem history_disjoint_compactReverseTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (_hlo : HistoryAbove w)
    (start i : Nat) (hs : start+5 ≤ 512) (hlate : start+6 ≤ i) (hi : i < 512) :
    Disjoint (wires (decode w start)) (wires (compactSkywalkReverseTick w i)) := by
  apply Finset.disjoint_left.mpr
  intro q hq ht
  obtain ⟨j,rfl⟩ := history_gate_mem w start _ (Or.inr rfl) q hq
  exact historyId_away_compactTick w hn start i hs hlate hi j
    (List.mem_toFinset.mp (compactSkywalkReverseTick_support w i hi hn ht))

theorem prefix_disjoint_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : HistoryAbove w)
    (n i : Nat) (hni : n ≤ i) (hi : i < 512) :
    Disjoint (wires (encodePrefix w n)) (wires (compactSkywalkTick w i)) := by
  induction n with
  | zero => simp [encodePrefix,wires]
  | succ n ih =>
    have prior := ih (by omega)
    have current : Disjoint (wires (packAfter w n)) (wires (compactSkywalkTick w i)) := by
      cases due : packDue n
      · simp [packAfter,due,wires]
      · have bounds := packDue_true n due
        have d := history_disjoint_compactTick w hn hlo (n-5) i (by omega) (by omega) hi
        simpa only [packAfter,due,if_true] using d
    simp only [encodePrefix,wires_append,Finset.disjoint_union_left]
    exact ⟨prior,current⟩

theorem prefix_disjoint_compactReverseTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : HistoryAbove w)
    (n i : Nat) (hni : n ≤ i) (hi : i < 512) :
    Disjoint (wires (encodePrefix w n)) (wires (compactSkywalkReverseTick w i)) := by
  induction n with
  | zero => simp [encodePrefix,wires]
  | succ n ih =>
    have prior := ih (by omega)
    have current : Disjoint (wires (packAfter w n)) (wires (compactSkywalkReverseTick w i)) := by
      cases due : packDue n
      · simp [packAfter,due,wires]
      · have bounds := packDue_true n due
        have d := history_disjoint_compactReverseTick w hn hlo (n-5) i (by omega) (by omega) hi
        have eq : wires (encode w (n-5))=wires (decode w (n-5)) := by
          simp only [encode,decode,(MeasuredCodec5.supportAt_exact _).1,(MeasuredCodec5.supportAt_exact _).2]
        simpa only [packAfter,due,if_true,eq] using d
    simp only [encodePrefix,wires_append,Finset.disjoint_union_left]
    exact ⟨prior,current⟩

/-- The unchanged integer stage supplies each physical ternary letter. -/



theorem compactStage_ternary (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i : Nat)
    (hp0 : 0 < p) (hpo : p%2=1) (hi : i ≤ 512) (s : BasisState)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    ∀j,j < i → (s (w j) && s (w (1028+j)))=false := by
  have fields := (compactSkywalkStage_fields_iff w _ i hi hn s).mp h
  have tape := fields.2.2.2.1
  intro j hj
  rw [(tape j hj).1,(tape j hj).2]
  exact skywalkRecordedSymbol_legal x p j hp0 hpo

theorem stage_group_legal (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i start : Nat)
    (hp0 : 0 < p) (hpo : p%2=1) (hs : start+5 ≤ i) (hi : i ≤ 512) (s : BasisState)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    MeasuredCodec5.legalAt (historyMap w start) s := by
  apply (MeasuredCodec5.legalAt_iff _ _).mpr
  intro j
  have letter := compactStage_ternary w hn x p i hp0 hpo hi s h (start+j.val) (by omega)
  have even : historyId start ⟨2*j.val,by omega⟩=start+j.val := by
    change (if (2*j.val)%2=0 then start+(2*j.val)/2 else 1028+start+(2*j.val)/2)=start+j.val
    split_ifs <;> omega
  have odd : historyId start ⟨2*j.val+1,by omega⟩=1028+start+j.val := by
    change (if (2*j.val+1)%2=0 then start+(2*j.val+1)/2 else 1028+start+(2*j.val+1)/2)=
      1028+start+j.val
    split_ifs <;> omega
  simpa only [historyMap,even,odd,Nat.add_assoc] using letter


theorem rawLegal_of_compactStage (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i n : Nat)
    (hp0 : 0 < p) (hpo : p%2=1) (hn5 : 5*n ≤ i) (hi : i ≤ 512) (s : BasisState)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    RawLegal w n s := by
  intro j hj
  exact stage_group_legal w hn x p i (5*j) hp0 hpo (by omega) hi s h

