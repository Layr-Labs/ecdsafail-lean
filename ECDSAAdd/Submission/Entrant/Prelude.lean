-- ===== ECDSAAdd.Submission.Entrant.HalfFieldOB5Support =====
section

/-! Actual endpoint support follows from the finite input-site image. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.HalfFieldOB5Support
open Arithmetic MappedCompressed
attribute [local irreducible] wires HalfField.centerT HalfField.canonT HalfField.copyN

private def preFrame (i : Nat) : Prop :=
  (i < 1542 ∧ i ≠ 769 ∧ i ≠ 511 ∧ i ≠ 1539) ∨ i=1796 ∨ i=1797 ∨ (2056 ≤ i ∧ i < 2312)

private theorem bank_index (i : Nat) : HalfFieldOB5.bank i =
    if 512 ≤ i ∧ i < 767 then i+1028 else if 1540 ≤ i ∧ i < 1795 then i-1028 else i := rfl

private theorem endpoint_apply (q : Wire) : HalfFieldOB5.endpointMap q =
    OB5.sig 511 (Equiv.swap (base 1796) (base 1285)
      (shifted (Placement5.pi 51) (shifted HalfFieldOB5.bank q))) := rfl

attribute [local irreducible] HalfFieldOB5.bank HalfFieldOB5.endpointMap HalfFieldOB5.relocate
  Placement5.pi OB5.sig shifted

private theorem banked (i : Nat) (hi : i∈HalfField.ids) :
    preFrame (HalfFieldOB5.bank i) ∧ HalfFieldOB5.bank i ≠ 1285 ∧
      ¬Placement5.holeRegion (HalfFieldOB5.bank i) := by
  simp only [HalfField.ids,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at hi
  rw [bank_index]
  unfold preFrame Placement5.holeRegion
  split_ifs <;> omega

private theorem perm_frame (e : Equiv.Perm Nat)
    (fix : ∀i,¬Placement5.zeroRegion i → e i=i) (i : Nat) (hi : preFrame i) : preFrame (e i) := by
  have bounded (i : Nat) (hi : i<1542) : e i<1542 := by
    by_contra hn
    have outside : ¬Placement5.zeroRegion (e i) := by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega
    have same := e.injective (fix (e i) outside)
    omega
  have no769 (i : Nat) (hi : i≠769) : e i≠769 := by
    intro eq
    have same := e.injective (eq.trans (fix 769 (by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega)).symm)
    exact hi same
  rcases hi with h|h|h|h
  · have noC (c : Nat) (hc : ¬Placement5.zeroRegion c) (k : Nat) (hk : k≠c) : e k≠c := by
      intro eq
      exact hk (e.injective (eq.trans (fix c hc).symm))
    exact Or.inl ⟨bounded i h.1,no769 i h.2.1,
      noC 511 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.1,
      noC 1539 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.2⟩
  all_goals
    have outside : ¬Placement5.zeroRegion i := by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega
    rw [fix i outside]
    unfold preFrame
    omega

private theorem sigma_mem (i : Nat) (hi : preFrame i) (safe : ¬Placement5.omitted i)
    (noFlag : i≠1796) : OB5.sig 511 (base i)∈OB5Support.segSites := by
  rw [OB5.sig_base 511 i (by decide)]
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨_,?_,rfl⟩
  simp only [OB5Support.segIndices,List.mem_append,List.mem_range'_1,List.mem_cons,
    List.not_mem_nil,or_false]
  unfold preFrame Placement5.omitted at *
  split_ifs <;> omega

/-- The bank, codec placement, flag swap, and final sign map use retained sites. -/
theorem endpoint_image (i : Nat) (hi : i∈HalfField.ids) :
    HalfFieldOB5.endpointMap (base i)∈OB5Support.segSites := by
  have before := banked i hi
  let u := Placement5.pi 51 (HalfFieldOB5.bank i)
  have frame : preFrame u := perm_frame (Placement5.pi 51)
    (fun q hq => Placement5.pi_outside 51 q (by decide) hq) _ before.1
  have safe : ¬Placement5.omitted u := Placement5.nonhole_pi_safe 51 _ (by decide) before.2.2
  have fix : Placement5.pi 51 1285=1285 := by
    simpa only [show Placement5.H (2*51)=1285 by decide] using Placement5.pi_current_even 51 (by decide)
  have noHole : u≠1285 := by
    intro eq
    exact before.2.1 ((Placement5.pi 51).injective (eq.trans fix.symm))
  rw [endpoint_apply,shifted_base,shifted_base]
  change OB5.sig 511 (Equiv.swap (base 1796) (base 1285) (base u))∈OB5Support.segSites
  by_cases flag : u=1796
  · rw [flag,Equiv.swap_apply_left,OB5.sig_base 511 1285 (by decide)]
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨1796,?_,by decide⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false]
    omega
  · rw [Equiv.swap_apply_of_ne_of_ne (fun eq => flag (base_injective eq))
      (fun eq => noHole (base_injective eq))]
    exact sigma_mem u frame safe flag

private theorem relocated_support (P : Program)
    (hP : wires P⊆(HalfField.ids.map base).toFinset) :
    wires (renameProgram HalfFieldOB5.endpointMap P)⊆OB5Support.segSites := by
  rw [renameProgram_support]
  intro q hq
  obtain ⟨old,used,rfl⟩ := Finset.mem_image.mp hq
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp (hP used))
  exact endpoint_image i hi

theorem center_support : wires HalfFieldOB5.centerT⊆OB5Support.segSites :=
  relocated_support HalfField.centerT HalfField.centerT_sites

theorem canon_support : wires HalfFieldOB5.canonT⊆OB5Support.segSites :=
  relocated_support HalfField.canonT HalfField.canonT_sites

theorem copy_support : wires HalfFieldOB5.copyN⊆OB5Support.segSites := by
  intro q hq
  have h := copyRegister_wires_subset none HalfField.ports.r HalfField.ports.y (by
    simpa only [HalfFieldOB5.copyN, HalfField5.copyN, HalfField.copyN] using hq)
  have pr : HalfField.ports.r = wireBlock base 2056 256 := balancedSharedPorts_r base (base 2409)
  have py : HalfField.ports.y = wireBlock base 770 256 := balancedSharedPorts_y base (base 2409)
  rw [pr,py] at h
  simp only [Option.toList_none,List.nil_append,List.mem_toFinset,List.mem_append,
    wireBlock,List.mem_map,List.mem_range'_1] at h
  rcases h with ⟨i,hi,rfl⟩|⟨i,hi,rfl⟩
  all_goals
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨i,?_,rfl⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_cons,List.not_mem_nil,
      List.mem_range'_1,or_false]
    omega

end ECDSAAdd.Entrant.HalfFieldOB5Support


section
namespace ECDSAAdd.Entrant.OwnPlusEndpoint
open Arithmetic MappedCompressed
theorem support : wires centerT⊆OB5Support.segSites ∧ wires canonT⊆OB5Support.segSites := by
  have mem (q : Nat) (hq : q=766 ∨ q=768) : base q∈OB5Support.segSites := by
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨q,?_,rfl⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false]
    omega
  have rename (P : Program) (hp : wires P⊆OB5Support.segSites) :
      wires (renameProgram swap P)⊆OB5Support.segSites := by
    rw [renameProgram_support]
    intro q hq
    obtain ⟨old,used,rfl⟩:=Finset.mem_image.mp hq
    by_cases a:old=base 766
    · subst old; simpa only [swap,Equiv.swap_apply_left] using mem 768 (Or.inr rfl)
    · by_cases b:old=base 768
      · subst old; simpa only [swap,Equiv.swap_apply_right] using mem 766 (Or.inl rfl)
      · simpa only [swap,Equiv.swap_apply_of_ne_of_ne a b] using hp used
  exact ⟨rename _ HalfFieldOB5Support.center_support,rename _ HalfFieldOB5Support.canon_support⟩
end ECDSAAdd.Entrant.OwnPlusEndpoint

end


end


-- ===== ECDSAAdd.Submission.Entrant.OB5ReplaySupport =====
section

/-! Actual one-bank replay support after both field and late-sign placement. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneBankReplay5Support
open Arithmetic MappedCompressed OneBankReplay5
attribute [local irreducible] wires

private def preFrame (i : Nat) : Prop :=
  (i<1542 ∧ i≠769 ∧ i≠511 ∧ i≠1539) ∨ i=1797 ∨ (2056 ≤ i ∧ i ≤ 2312) ∨ i=2400 ∨ i=2409 ∨ i=2410

private theorem sigma_mem (i : Nat) (hi : preFrame i) (safe : ¬Placement5.omitted i) :
    OB5.sig 511 (base i)∈OB5Support.segSites := by
  rw [OB5.sig_base 511 i (by decide)]
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨_,?_,rfl⟩
  simp only [OB5Support.segIndices,List.mem_append,List.mem_range'_1,List.mem_cons,
    List.not_mem_nil,or_false]
  unfold preFrame Placement5.omitted at *
  split_ifs <;> omega

private theorem perm_frame (e : Equiv.Perm Nat)
    (fix : ∀i,¬Placement5.zeroRegion i → e i=i) (i : Nat) (hi : preFrame i) : preFrame (e i) := by
  have bounded (i : Nat) (hi : i<1542) : e i<1542 := by
    by_contra hn
    have outside : ¬Placement5.zeroRegion (e i) := by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega
    have same := e.injective (fix (e i) outside)
    omega
  have no769 (i : Nat) (hi : i≠769) : e i≠769 := by
    intro eq
    have same := e.injective (eq.trans (fix 769 (by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega)).symm)
    exact hi same
  rcases hi with h|h|h|h|h|h
  · have noC (c : Nat) (hc : ¬Placement5.zeroRegion c) (k : Nat) (hk : k≠c) : e k≠c := by
      intro eq
      exact hk (e.injective (eq.trans (fix c hc).symm))
    exact Or.inl ⟨bounded i h.1,no769 i h.2.1,
      noC 511 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.1,
      noC 1539 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.2⟩
  all_goals
    have outside : ¬Placement5.zeroRegion i := by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega
    rw [fix i outside]
    unfold preFrame
    omega

private theorem pi_mem (j i : Nat) (hj : j<102) (hi : preFrame i)
    (hole : ¬Placement5.holeRegion i) :
    OB5.sig 511 (base (Placement5.pi j i))∈OB5Support.segSites :=
  sigma_mem _ (perm_frame (Placement5.pi j) (fun q hq => Placement5.pi_outside j q hj hq) i hi)
    (Placement5.nonhole_pi_safe j i hj hole)

private theorem pi0_mem (i : Nat) (hi : preFrame i) (hole : ¬Placement5.holeRegion i) :
    OB5.sig 511 (base (Placement5.pi0 i))∈OB5Support.segSites :=
  sigma_mem _ (perm_frame Placement5.pi0 Placement5.pi0_outside i hi)
    (Placement5.nonhole_pi0_safe i hole)

private theorem field_index (i : Nat) (hi : i∈OneBankCell5.ids) :
    preFrame i ∧ ¬Placement5.holeRegion i := by
  simp only [OneBankCell5.ids,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at hi
  unfold preFrame Placement5.holeRegion
  omega

private theorem history_pi_mem (j : Nat) (hj : j<102) (r : Fin 10) :
    OB5.sig 511 (base (Placement5.pi j (History5.historyId (5*j) r)))∈OB5Support.segSites := by
  have bounds := History5.historyId_region (5*j) (by omega) r
  have low : preFrame (History5.historyId (5*j) r) := by
    have hr := r.isLt
    unfold preFrame History5.historyId
    split <;> omega
  by_cases hole : Placement5.holeRegion (History5.historyId (5*j) r)
  · have h : History5.historyId (5*j) r=Placement5.H (2*j) ∨
        History5.historyId (5*j) r=Placement5.H (2*j+1) := by
      have hr := r.isLt
      have he : Placement5.H (2*j)=1030+5*j := by unfold Placement5.H; omega
      have ho : Placement5.H (2*j+1)=1032+5*j := by unfold Placement5.H; omega
      rw [he,ho]
      unfold History5.historyId at hole ⊢
      split_ifs at hole ⊢ <;> unfold Placement5.holeRegion at hole <;> omega
    rcases h with h|h
    · rw [h,Placement5.pi_current_even j hj]
      apply sigma_mem
      · have b := Placement5.H_bound (2*j) (by omega)
        unfold preFrame
        omega
      · have b := Placement5.H_bound (2*j) (by omega)
        unfold Placement5.omitted
        omega
    · rw [h,Placement5.pi_current_odd j hj]
      apply sigma_mem
      · have b := Placement5.H_bound (2*j+1) (by omega)
        unfold preFrame
        omega
      · have b := Placement5.H_bound (2*j+1) (by omega)
        unfold Placement5.omitted
        omega
  · exact pi_mem j _ hj low hole

private theorem read_placed (j : Nat) (hj : j<102) (q : Wire) (hq : q∈readSites (5*j)) :
    OB5.sig 511 (shifted (Placement5.pi j) q)∈OB5Support.segSites := by
  simp only [readSites,Finset.mem_union] at hq
  rcases hq with (h|h)|h
  · rcases List.mem_cons.mp (List.mem_toFinset.mp h) with rfl|h
    · rw [shifted_base]
      exact pi_mem j 2409 hj (by unfold preFrame; omega) (by unfold Placement5.holeRegion; omega)
    · obtain ⟨i,hi,rfl⟩ := List.mem_map.mp h
      rw [shifted_base]
      exact pi_mem j i hj (field_index i hi).1 (field_index i hi).2
  · simp only [Finset.mem_insert,Finset.mem_singleton] at h
    rcases h with rfl|rfl
    · rw [shifted_base]
      exact pi_mem j 2400 hj (by unfold preFrame; omega) (by unfold Placement5.holeRegion; omega)
    · rw [shifted_base]
      exact pi_mem j 2410 hj (by unfold preFrame; omega) (by unfold Placement5.holeRegion; omega)
  · obtain ⟨r,rfl⟩ := History5.history_gate_mem base (5*j) _ (Or.inl rfl) q h
    rw [History5.historyMap,shifted_base]
    exact history_pi_mem j hj r

private theorem stage_placed_support (j : Nat) (hj : j<102) (P : Program)
    (hP : wires P⊆readSites (5*j)) :
    wires (renameProgram (OB5.sig 511) (renameProgram (shifted (Placement5.pi j)) P))⊆OB5Support.segSites := by
  rw [renameProgram_support (OB5.sig 511) (renameProgram (shifted (Placement5.pi j)) P)]
  intro q hq
  obtain ⟨middle,hmid,eqSig⟩ := Finset.mem_image.mp hq
  rw [renameProgram_support (shifted (Placement5.pi j)) P] at hmid
  obtain ⟨old,hold,eqPi⟩ := Finset.mem_image.mp hmid
  rw [←eqSig,←eqPi]
  exact read_placed j hj old (hP hold)

private theorem codec_read (start : Nat) (P : Program)
    (hp : P=History5.encode base start ∨ P=History5.decode base start) : wires P⊆readSites start := by
  intro q hq
  obtain ⟨r,rfl⟩ := History5.history_gate_mem base start P hp q hq
  exact Finset.mem_union_right _ (History5.history_site_mem base start r)

theorem packet_support (divide : Bool) (j : Nat) (hj : j<102) :
    wires (renameProgram (OB5.sig 511) (packet divide j))⊆OB5Support.segSites := by
  apply stage_placed_support j hj
  simp only [basePacket,wires_append,Finset.union_subset_iff]
  exact ⟨⟨codec_read _ _ (Or.inr rfl),body_support divide j hj⟩,codec_read _ _ (Or.inl rfl)⟩

theorem firstPacket_support (divide : Bool) :
    wires (renameProgram (OB5.sig 511) (firstPacket divide))⊆OB5Support.segSites := by
  apply stage_placed_support 0 (by decide)
  simp only [baseFirstPacket,wires_append,Finset.union_subset_iff]
  exact ⟨⟨codec_read _ _ (Or.inr rfl),firstBody_support divide⟩,codec_read _ _ (Or.inl rfl)⟩

theorem endPacket_support (divide : Bool) :
    wires (renameProgram (OB5.sig 511) (endPacket divide))⊆OB5Support.segSites := by
  rw [renameProgram_support (OB5.sig 511) (endPacket divide)]
  intro q hq
  obtain ⟨middle,hmid,eqSig⟩ := Finset.mem_image.mp hq
  rw [endPacket,renameProgram_support (shifted Placement5.pi0) (rawEnd divide)] at hmid
  obtain ⟨old,hold,eqPi⟩ := Finset.mem_image.mp hmid
  rw [←eqSig,←eqPi]
  rcases Finset.mem_union.mp (rawEnd_support divide hold) with h|h
  · rcases List.mem_cons.mp (List.mem_toFinset.mp h) with rfl|h
    · rw [shifted_base]
      exact pi0_mem 2409 (by unfold preFrame; omega) (by unfold Placement5.holeRegion; omega)
    · obtain ⟨i,hi,rfl⟩ := List.mem_map.mp h
      rw [shifted_base]
      exact pi0_mem i (field_index i hi).1 (field_index i hi).2
  · simp only [Finset.mem_insert,Finset.mem_singleton] at h
    rcases h with rfl|rfl
    · rw [shifted_base]
      exact pi0_mem 2400 (by unfold preFrame; omega) (by unfold Placement5.holeRegion; omega)
    · rw [shifted_base]
      exact pi0_mem 510 (by unfold preFrame; omega) (by unfold Placement5.holeRegion; omega)

theorem groups_support (divide : Bool) (j n : Nat) (bound : j+n≤102) :
    wires (renameProgram (OB5.sig 511) (groups divide j n))⊆OB5Support.segSites := by
  induction n generalizing j with
  | zero => simp [groups,PacketSequence.program,renameProgram,wires]
  | succ n ih =>
    have head := packet_support divide j (by omega)
    have rest := ih (j+1) (by omega)
    simp only [groups] at rest
    cases divide <;> simp only [groups,PacketSequence.program,Bool.false_eq_true,if_false,if_true,
      FieldRename.rename_append,wires_append,Finset.union_subset_iff] at rest ⊢
    · exact ⟨rest,head⟩
    · exact ⟨head,rest⟩

theorem replay_support (divide : Bool) : wires (replay divide)⊆OB5Support.segSites := by
  have first := firstPacket_support divide
  have middle := groups_support divide 1 101 (by decide)
  have last := endPacket_support divide
  cases divide <;> simp only [replay,logicalReplay,Bool.false_eq_true,if_false,if_true,
    FieldRename.rename_append,wires_append,Finset.union_subset_iff] at first middle last ⊢
  · exact ⟨⟨last,middle⟩,first⟩
  · exact ⟨⟨first,middle⟩,last⟩

end ECDSAAdd.Entrant.OneBankReplay5Support

end


-- ===== ECDSAAdd.Submission.Entrant.HostOB5 =====
section

/-! Selector hosting for the five-trit one-bank field segment: during the segment the
orientation selector `2409` lives on label `511` (orientation bit of the padding round 511,
constant `1`, complemented around the segment) and the swap selector `2410` lives on label
`1542` (the final placement of tick 511's sign record, constant `0`). -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
namespace ECDSAAdd.Entrant.HostOB5
open Arithmetic MappedCompressed

def hostSwap (q : Wire) : Wire :=
  if q = base 2409 then base 511 else if q = base 511 then base 2409 else
  if q = base 2410 then base 1542 else if q = base 1542 then base 2410 else q

theorem host_ne (a b : Nat) (h : a ≠ b) : base a ≠ base b := fun e => h (base_injective e)

theorem hostSwap_invol (q : Wire) : hostSwap (hostSwap q) = q := by
  have a1 := host_ne 2409 511 (by omega)
  have a2 := host_ne 2409 2410 (by omega)
  have a3 := host_ne 2409 1542 (by omega)
  have a4 := host_ne 511 2410 (by omega)
  have a5 := host_ne 511 1542 (by omega)
  have a6 := host_ne 2410 1542 (by omega)
  by_cases h1 : q = base 2409
  · subst h1; simp [hostSwap, a1, a1.symm, a2, a2.symm, a3, a3.symm, a4, a4.symm, a5, a5.symm, a6, a6.symm]
  · by_cases h2 : q = base 511
    · subst h2; simp [hostSwap, a1, a1.symm, a2, a2.symm, a3, a3.symm, a4, a4.symm, a5, a5.symm, a6, a6.symm]
    · by_cases h3 : q = base 2410
      · subst h3; simp [hostSwap, a1, a1.symm, a2, a2.symm, a3, a3.symm, a4, a4.symm, a5, a5.symm, a6, a6.symm]
      · by_cases h4 : q = base 1542
        · subst h4; simp [hostSwap, a1, a1.symm, a2, a2.symm, a3, a3.symm, a4, a4.symm, a5, a5.symm, a6, a6.symm]
        · simp [hostSwap, h1, h2, h3, h4]

theorem hostSwap_injective : Function.Injective hostSwap := by
  intro a b h
  have := congrArg hostSwap h
  rwa [hostSwap_invol, hostSwap_invol] at this

theorem host_pull (t : State) (h2 : t.basis (base 2409) = t.basis (base 511))
    (h4 : t.basis (base 2410) = t.basis (base 1542)) :
    pullState hostSwap t = t := by
  apply State.extensionality
  · rfl
  · funext q
    simp only [pullState, hostSwap]
    split_ifs with c d e f
    · subst c; exact h2.symm
    · subst d; exact h2
    · subst e; exact h4.symm
    · subst f; exact h4
    · rfl

theorem host_run (P : Program) (s : State) (m : List Bool)
    (hP2 : base 511 ∉ wires P) (hP4 : base 1542 ∉ wires P)
    (h2 : s.basis (base 2409) = false) (h3 : s.basis (base 511) = false)
    (h4 : s.basis (base 2410) = false) (h5 : s.basis (base 1542) = false)
    (hout2 : (run P m s).basis (base 2409) = false)
    (hout4 : (run P m s).basis (base 2410) = false) :
    run (renameProgram hostSwap P) m s = run P m s := by
  have r := run_rename hostSwap hostSwap_injective P m s
  rw [host_pull s (h2.trans h3.symm) (h4.trans h5.symm)] at r
  have keep2 : (run P m s).basis (base 511) = false := (run_preserves_outside P m s _ hP2).trans h3
  have keep4 : (run P m s).basis (base 1542) = false := (run_preserves_outside P m s _ hP4).trans h5
  have back : run (renameProgram hostSwap P) m s =
      pullState hostSwap (pullState hostSwap (run (renameProgram hostSwap P) m s)) := by
    apply State.extensionality
    · rfl
    · funext q; simp only [pullState, hostSwap_invol]
  rw [back, r, host_pull _ (hout2.trans keep2.symm) (hout4.trans keep4.symm)]

theorem host_xrun (q : Wire) (s : State) (m : List Bool) :
    run [Instr.X q] m s = ⟨s.phase, writeBit s.basis q (!s.basis q)⟩ := by simp only [run]

theorem hosted_run (P : Program) (s : State) (m : List Bool)
    (hP2 : base 511 ∉ wires P) (hP4 : base 1542 ∉ wires P)
    (h2 : s.basis (base 2409) = false) (h3 : s.basis (base 511) = true)
    (h4 : s.basis (base 2410) = false) (h5 : s.basis (base 1542) = false)
    (hout2 : (run P m s).basis (base 2409) = false)
    (hout4 : (run P m s).basis (base 2410) = false) :
    run ([.X (base 511)] ++ (renameProgram hostSwap P ++ [.X (base 511)])) m s = run P m s := by
  have dis : Disjoint (wires [Instr.X (base 511)]) (wires P) := by
    rw [Finset.disjoint_left]
    intro q hq hp
    have e : q = base 511 := by simpa [wires, Instr.wires] using hq
    exact hP2 (e ▸ hp)
  have comm := run_disjoint_commute [Instr.X (base 511)] P dis [] m s
  have flip (u : State) (q : Wire) (hq : q ≠ base 511) :
      (run [Instr.X (base 511)] [] u).basis q = u.basis q := by
    rw [host_xrun]; simp [writeBit, Function.update_of_ne hq]
  have flip511 (u : State) : (run [Instr.X (base 511)] [] u).basis (base 511) = !u.basis (base 511) := by
    rw [host_xrun]; simp [writeBit]
  have n2 : base 2409 ≠ base 511 := host_ne 2409 511 (by omega)
  have n4 : base 2410 ≠ base 511 := host_ne 2410 511 (by omega)
  have n5 : base 1542 ≠ base 511 := host_ne 1542 511 (by omega)
  have inner := host_run P (run [Instr.X (base 511)] [] s) m hP2 hP4
    ((flip s _ n2).trans h2)
    (by simp [flip511, h3])
    ((flip s _ n4).trans h4)
    ((flip s _ n5).trans h5)
    (by rw [← comm, flip _ _ n2]; exact hout2)
    (by rw [← comm, flip _ _ n4]; exact hout4)
  have xx (u : State) (m' : List Bool) :
      run [Instr.X (base 511)] m' (run [Instr.X (base 511)] [] u) = u := by
    rw [host_xrun, host_xrun]
    apply State.extensionality
    · rfl
    · funext q
      by_cases hq : q = base 511
      · subst hq; simp [writeBit]
      · simp [writeBit, Function.update_of_ne hq]
  have hc : measurementCount [Instr.X (base 511)] = 0 := rfl
  rw [run_append, hc, List.take_zero, List.drop_zero, run_append, run_take, inner, ← comm]
  exact xx _ _

/-- The five-trit tape encoder only packs rounds `0`–`509`. -/
theorem enc_free (n : Nat) (hn : n ≤ 102) (l : Nat) (hl : l = 511 ∨ l = 1539) :
    base l ∉ wires (History5.allEncode base n) := by
  induction n with
  | zero => simp [History5.allEncode, wires]
  | succ n ih =>
    simp only [History5.allEncode, wires_append, Finset.mem_union, not_or]
    refine ⟨ih (by omega), ?_⟩
    intro hq
    obtain ⟨r, hr⟩ := History5.history_gate_mem base (5*n) _ (Or.inl rfl) _ hq
    simp only [History5.historyMap] at hr
    have same := base_injective hr
    have hr' := r.isLt
    unfold History5.historyId at same
    split_ifs at same <;> omega

end ECDSAAdd.Entrant.HostOB5

end


-- ===== Tick511Gates =====
section

/-! The last integer tick on its forced input.

By `SkywalkNat.terminates_511` the Skywalk state before tick `511` is
terminal: its two rails are `(0, 1)` with orientation `true`, or `(1, 0)`
with orientation `false`, and every work, carry and fresh history bit of
the tick is clean.  On exactly these inputs the forward tick (three
Toffolis, one measurement) acts as two CX gates, and on the forward outputs
the reverse tick (three Toffolis, one measurement) acts as their inverse.
Both facts hold for every incoming phase, every value outside the ten tick
wires and every measurement record.

The ten physical wires are `base 510`, `base 511`–`base 514`,
`base 770`–`base 772`, `base 1539` (the tick's fresh history site) and
`base 1540` (its carry). -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant
open Arithmetic MappedCompressed

/-- Gate list of `compactSkywalkTick base 511`. -/
def tickExF : Program :=
  [.CX 787 528, .CX 788 529, .CCX 527 528 787, .CCX 527 529 788, .CX 787 528, .CX 788 529,
   .CX 527 786, .CX 529 530, .X 1555, .CX 529 1555, .CX 787 1555, .CX 1555 528, .CX 1555 529,
   .CX 528 786, .CX 528 1555, .CCX 786 1555 1556, .CX 528 1556, .CX 528 1555, .CX 528 786,
   .CX 529 787, .CX 1556 787,
   .measureX 1556 [] [.CZ 528 786, .CZ 528 1555, .CZ 786 1555],
   .CX 528 786, .CX 1555 786, .CX 1555 528, .CX 1555 529, .X 1555, .CX 529 1555, .CX 787 1555,
   .CX 1555 788, .CX 526 527, .CX 529 530, .CX 787 788]

/-- Gate list of `compactSkywalkReverseTick base 511`. -/
def tickExR : Program :=
  [.CX 787 788, .CX 529 530, .CX 526 527, .CX 1555 788, .X 1555, .CX 529 1555, .CX 787 1555,
   .X 786, .X 787, .CX 1555 528, .CX 1555 529, .CX 528 786, .CX 528 1555, .CCX 786 1555 1556,
   .CX 528 1556, .CX 528 1555, .CX 528 786, .CX 529 787, .CX 1556 787,
   .measureX 1556 [] [.CZ 528 786, .CZ 528 1555, .CZ 786 1555],
   .CX 528 786, .CX 1555 786, .CX 1555 528, .CX 1555 529, .X 786, .X 787, .X 1555,
   .CX 529 1555, .CX 787 1555, .CX 529 530, .CX 527 786, .CX 787 528, .CX 788 529,
   .CCX 527 528 787, .CCX 527 529 788, .CX 787 528, .CX 788 529]

theorem tick511_explicit : compactSkywalkTick base 511 = tickExF := by decide +kernel
theorem rtick511_explicit : compactSkywalkReverseTick base 511 = tickExR := by decide +kernel

/-- Clifford form of forward tick `511` on its forced input. -/
def tickF : Program := [.CX (base 511) (base 770), .CX (base 510) (base 511)]

/-- Clifford form of reverse tick `511` on the forward outputs. -/
def tickR : Program := [.CX (base 510) (base 511), .CX (base 511) (base 770)]

/-- The ten physical wires of tick `511`. -/
def tickSites : List Wire := [526, 527, 528, 529, 530, 786, 787, 788, 1555, 1556]

theorem tickExF_wires : wires tickExF = tickSites.toFinset := by decide +kernel
theorem tickExR_wires : wires tickExR = tickSites.toFinset := by decide +kernel
theorem tickF_wires : wires tickF ⊆ tickSites.toFinset := by decide +kernel
theorem tickR_wires : wires tickR ⊆ tickSites.toFinset := by decide +kernel

theorem tickExF_counts : toffoliCount tickExF = 3 ∧ measurementCount tickExF = 1 := by
  decide +kernel
theorem tickExR_counts : toffoliCount tickExR = 3 ∧ measurementCount tickExR = 1 := by
  decide +kernel
theorem tickF_run (m : List Bool) (s : State) : run tickF m s = run tickF [] s := rfl
theorem tickR_run (m : List Bool) (s : State) : run tickR m s = run tickR [] s := rfl

theorem tickF_counts : toffoliCount tickF = 0 ∧ measurementCount tickF = 0 := by decide +kernel
theorem tickR_counts : toffoliCount tickR = 0 ∧ measurementCount tickR = 0 := by decide +kernel

/-- Forced input of the forward tick: orientation `G`, rails `(0,1)` or `(1,0)`. -/
def preBits (G : Bool) : BasisState := fun q =>
  if q = 526 then G else if q = 527 then !G else if q = 786 then G else false

/-- Forward output: orientation record `true`, half rail `0`, odd rail `1`. -/
def postBits (G : Bool) : BasisState := fun q =>
  if q = 526 then G else if q = 527 then true else if q = 786 then true else false

theorem concreteF : ∀ G : Bool, ∀ c ∈ [([] : List Bool), [false], [true]],
    (run tickExF c ⟨false, preBits G⟩).phase = false ∧
    (run tickF [] ⟨false, preBits G⟩).phase = false ∧
    ∀ q ∈ tickSites,
      (run tickExF c ⟨false, preBits G⟩).basis q = (run tickF [] ⟨false, preBits G⟩).basis q ∧
      (run tickF [] ⟨false, preBits G⟩).basis q = postBits G q := by
  decide +kernel

theorem concreteR : ∀ G : Bool, ∀ c ∈ [([] : List Bool), [false], [true]],
    (run tickExR c ⟨false, postBits G⟩).phase = false ∧
    (run tickR [] ⟨false, postBits G⟩).phase = false ∧
    ∀ q ∈ tickSites,
      (run tickExR c ⟨false, postBits G⟩).basis q = (run tickR [] ⟨false, postBits G⟩).basis q := by
  decide +kernel

theorem state_ext {s t : State} (h1 : s.phase = t.phase) (h2 : s.basis = t.basis) : s = t := by
  cases s; cases t; cases h1; cases h2; rfl

private theorem xor_false_cancel (a b c : Bool) (h : (a ^^ b) = (c ^^ false)) (hc : c = false) :
    a = b := by
  subst hc; cases a <;> cases b <;> simp_all

/-- A one-measurement block equals a measurement-free block on every state
that agrees with the concrete witness `k` on the ten tick wires. -/
theorem forced_of_concrete (P Q : Program) (k : BasisState)
    (hP : wires P = tickSites.toFinset) (hQ : wires Q ⊆ tickSites.toFinset)
    (hm : measurementCount P = 1)
    (conc : ∀ c ∈ [([] : List Bool), [false], [true]],
      (run P c ⟨false, k⟩).phase = false ∧ (run Q [] ⟨false, k⟩).phase = false ∧
      ∀ q ∈ tickSites, (run P c ⟨false, k⟩).basis q = (run Q [] ⟨false, k⟩).basis q)
    (s : State) (hs : ∀ q ∈ tickSites, s.basis q = k q) (m : List Bool) :
    run P m s = run Q [] s := by
  let t : State := ⟨false, k⟩
  have agreeP : ∀ q ∈ wires P, s.basis q = t.basis q := by
    intro q hq
    rw [hP] at hq
    exact hs q (List.mem_toFinset.mp hq)
  have agreeQ : ∀ q ∈ wires Q, s.basis q = t.basis q := fun q hq =>
    hs q (List.mem_toFinset.mp (hQ hq))
  have take : run P m s = run P (m.take 1) s := by
    rw [← hm]; exact (run_take P m s).symm
  have hc : m.take 1 ∈ [([] : List Bool), [false], [true]] := by
    rcases m with _ | ⟨b, m⟩
    · simp
    · cases b <;> simp
  obtain ⟨c1, c2, c3⟩ := conc _ hc
  have incP := run_local_increment P s t (m.take 1) agreeP
  have incQ := run_local_increment Q s t [] agreeQ
  rw [take]
  apply state_ext
  · rw [xor_false_cancel _ _ _ incP.1 c1, xor_false_cancel _ _ _ incQ.1 c2]
  · funext q
    by_cases hq : q ∈ tickSites
    · have hpq : q ∈ wires P := by rw [hP]; exact List.mem_toFinset.mpr hq
      rw [incP.2 q hpq, c3 q hq]
      by_cases hqq : q ∈ wires Q
      · exact (incQ.2 q hqq).symm
      · rw [run_preserves_outside Q [] s q hqq, run_preserves_outside Q [] t q hqq]
        exact (hs q hq).symm
    · have hpq : q ∉ wires P := by rw [hP]; exact fun h => hq (List.mem_toFinset.mp h)
      have hqq : q ∉ wires Q := fun h => hq (List.mem_toFinset.mp (hQ h))
      rw [run_preserves_outside P _ s q hpq, run_preserves_outside Q [] s q hqq]

/-- Forward tick `511` on its forced input is `tickF`. -/
theorem tick511_forced (G : Bool) (s : State) (hs : ∀ q ∈ tickSites, s.basis q = preBits G q)
    (m : List Bool) : run (compactSkywalkTick base 511) m s = run tickF [] s := by
  rw [tick511_explicit]
  apply forced_of_concrete tickExF tickF (preBits G) tickExF_wires tickF_wires
    tickExF_counts.2 _ s hs m
  intro c hc
  have h := concreteF G c hc
  exact ⟨h.1, h.2.1, fun q hq => (h.2.2 q hq).1⟩

/-- Reverse tick `511` on the forward outputs is `tickR`. -/
theorem rtick511_forced (G : Bool) (s : State) (hs : ∀ q ∈ tickSites, s.basis q = postBits G q)
    (m : List Bool) : run (compactSkywalkReverseTick base 511) m s = run tickR [] s := by
  rw [rtick511_explicit]
  exact forced_of_concrete tickExR tickR (postBits G) tickExR_wires tickR_wires
    tickExR_counts.2 (concreteR G) s hs m

/-- The forward output on the ten tick wires. -/
theorem tickF_post (G : Bool) (s : State) (hs : ∀ q ∈ tickSites, s.basis q = preBits G q) :
    ∀ q ∈ tickSites, (run tickF [] s).basis q = postBits G q := by
  intro q hq
  have agree : ∀ q ∈ wires tickF, s.basis q = (⟨false, preBits G⟩ : State).basis q :=
    fun q hq' => hs q (List.mem_toFinset.mp (tickF_wires hq'))
  have inc := run_local_increment tickF s ⟨false, preBits G⟩ [] agree
  have c := (concreteF G [] (by simp)).2.2 q hq
  by_cases hw : q ∈ wires tickF
  · rw [inc.2 q hw]; exact c.2
  · rw [run_preserves_outside tickF [] s q hw, hs q hq, ← c.2,
      run_preserves_outside tickF [] _ q hw]

end ECDSAAdd.Entrant
end


section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant
open Arithmetic MappedCompressed Secp256k1 History5
theorem signed3_bits (a b c : Wire) (s : BasisState) (v : Int) (h : signedRegValue [a, b, c] s = v)
    (hv : v = 0 ∨ v = 1) : s a = decide (v = 1) ∧ s b = false ∧ s c = false := by
  unfold signedRegValue signedDecode at h
  simp only [regValue, List.length] at h
  rcases hv with rfl | rfl <;>
  cases ha : s a <;> cases hb : s b <;> cases hc : s c <;> simp [ha, hb, hc] at h ⊢

theorem retainedA511 : (compactSkywalkSignPoolA base 511).retained = [base 511, base 512, base 513] := by
  decide +kernel
theorem retainedB511 : (compactSkywalkSignPoolB base 511).retained = [base 770, base 771, base 772] := by
  decide +kernel
theorem releasedA511 : base 514 ∈ (compactSkywalkSignPoolA base 511).released := by decide +kernel
theorem tickSites_pool : ∀ q ∈ tickSites, q ∈ skywalkPoolWires base := by decide +kernel
theorem tickSites_tick : ∀ q ∈ tickSites, q ∈ wires (compactSkywalkTick base 511) := by
  intro q hq
  rw [tick511_explicit, tickExF_wires]
  exact List.mem_toFinset.mpr hq

attribute [local irreducible] run W.compactSkywalkStageVirtual SkywalkTrace.next Nat.iterate
  W.compactSkywalkTick Arithmetic.compactSkywalkTick History5.encodePrefix

theorem stage511_bits5 (x : Nat) (hx0 : 0 < x) (hx : x < p) (s : State)
    (stage : W.CompressedCompactStage5 base x p 511 s.basis) :
    ∃G : Bool,∀q∈tickSites,s.basis q=preBits G q := by
  have hp0 : 0<p := by norm_num [p]
  have hpo : p%2=1 := by norm_num [p]
  have hp : p<2^256 := by norm_num [p]
  have cop := (StackOB5.prime_facts x hx0 hx).2.2.2
  obtain ⟨raw, hraw, hbits⟩ := stage
  have hrawOld : Arithmetic.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 511 raw.basis :=
    (W.compactSkywalkStage_eq base _ 511 (by decide +kernel) raw.basis).mp hraw
  have fields := (compactSkywalkStage_fields_iff base _ 511 (by omega) base_pool_nodup raw.basis).mp hrawOld
  obtain ⟨readA, readB, prev, -, future, carry, -, cleanA, -⟩ := fields
  obtain ⟨G, S, encoded⟩ := SkywalkTrace.iter_encoded 511 false false (SkywalkNat.init x p) hp0 hpo
  have terminal := SkywalkNat.terminates_511 p x hp0 hx0 hpo hp hx cop
  change SkywalkTrace.next^[511] (SkywalkRails.encode false false (x : Int) (p : Int)) =
    SkywalkRails.encode G S ((SkywalkNat.step^[511] (SkywalkNat.init x p)).u : Int)
      ((SkywalkNat.step^[511] (SkywalkNat.init x p)).v : Int) at encoded
  rw [terminal.1, terminal.2] at encoded
  rw [encoded, retainedA511] at readA
  rw [encoded, retainedB511] at readB
  rw [encoded] at prev
  have fut := future 511 (le_refl _) (by omega)
  have c1540 : raw.basis (base 1540) = false :=
    (regValue_zero _ _).mp carry _ (List.mem_map.mpr ⟨1540, by simp, rfl⟩)
  have c514 : raw.basis (base 514) = false := cleanA _ releasedA511
  have prev' : raw.basis (base 510) = G := by
    have h : skywalkPoolPreviousId 511 = 510 := rfl
    rw [h] at prev
    cases G <;> simpa [SkywalkRails.encode] using prev
  have bitsA : raw.basis (base 511) = !G ∧ raw.basis (base 512) = false ∧ raw.basis (base 513) = false := by
    cases G <;> cases S
    all_goals
      have h := signed3_bits _ _ _ raw.basis _ readA (by simp [SkywalkRails.encode, SkywalkRails.signed])
      simpa [SkywalkRails.encode, SkywalkRails.signed] using h
  have bitsB : raw.basis (base 770) = G ∧ raw.basis (base 771) = false ∧ raw.basis (base 772) = false := by
    cases G <;> cases S
    all_goals
      have h := signed3_bits _ _ _ raw.basis _ readB (by simp [SkywalkRails.encode, SkywalkRails.signed])
      simpa [SkywalkRails.encode, SkywalkRails.signed] using h
  refine ⟨G, ?_⟩
  have disj := W.prefix_disjoint_compactTick base base_pool_nodup (by intro j hj; change 10≤j+16; omega) 511 511 (le_refl _) (by omega)
  intro q hq
  have hbits' : s.basis q = raw.basis q := by
    rw [hbits]
    apply run_preserves_outside
    exact fun h => Finset.disjoint_left.mp disj h (by
      have eq : W.compactSkywalkTick base 511=Arithmetic.compactSkywalkTick base 511 := by decide +kernel
      rw [eq]
      exact tickSites_tick q hq)
  rw [hbits']
  simp only [tickSites, List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact prev'
  · exact bitsA.1
  · exact bitsA.2.1
  · exact bitsA.2.2
  · exact c514
  · exact bitsB.1
  · exact bitsB.2.1
  · exact bitsB.2.2
  · exact fut.2
  · exact c1540


end ECDSAAdd.Entrant
end
section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
namespace ECDSAAdd.Entrant.Stack5
open Arithmetic Secp256k1 History5
attribute [local irreducible] run forward5 W.compactForward5
 theorem forward_spec (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p i n : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i+n ≤ 512) :
    Triple (W.CompressedCompactStage5 w x p i) (forward5 w i n) (W.CompressedCompactStage5 w x p (i+n)) := by
  intro s m hs
  rw [forward_eq w hn hlo x p hp0 hx0 hpo hp hq hx hc n i hi s m [] hs]
  exact W.compactForward5_spec w hn hlo x p i n hp0 hx0 hpo hp hq hx hc hi s [] hs
end ECDSAAdd.Entrant.Stack5
end
section
namespace ECDSAAdd.Entrant
open Arithmetic MappedCompressed
 theorem repaired511_explicit : W.repairedTick base 511=tickExF := by
  have eq : W.repairedTick base 511=Arithmetic.compactSkywalkTick base 511 := by decide +kernel
  exact eq.trans tick511_explicit
 theorem receiver511_explicit : W.ReverseCarry.compactReceiverTick base 511=tickExR := by
  have eq : W.ReverseCarry.compactReceiverTick base 511=Arithmetic.compactSkywalkReverseTick base 511 := by decide +kernel
  exact eq.trans rtick511_explicit
 theorem repaired511_forced (G : Bool) (s : State) (hs : ∀q∈tickSites,s.basis q=preBits G q) (m : List Bool) :
    run (W.repairedTick base 511) m s=run tickF [] s := by
  rw [repaired511_explicit,←tick511_explicit]
  exact tick511_forced G s hs m
 theorem receiver511_forced (G : Bool) (s : State) (hs : ∀q∈tickSites,s.basis q=postBits G q) (m : List Bool) :
    run (W.ReverseCarry.compactReceiverTick base 511) m s=run tickR [] s := by
  rw [receiver511_explicit,←rtick511_explicit]
  exact rtick511_forced G s hs m
 theorem pack5115 : History5.packAfter base 511=[] := by decide +kernel
 theorem decode5115 : History5.decodeBefore base 511=[] := by decide +kernel
end ECDSAAdd.Entrant
end
section
namespace ECDSAAdd.Entrant.Stack5
open Arithmetic
 theorem forward_snoc (w : Nat → Wire) (i n : Nat) :
    forward5 w i (n+1)=forward5 w i n++(W.repairedTick w (i+n)++History5.packAfter w (i+n)) := by
  induction n generalizing i with
  | zero => simp [forward5]
  | succ n ih =>
    rw [forward5,ih (i+1),forward5]
    rw [show i+1+n=i+(n+1) by omega]
    simp only [List.append_assoc]
end ECDSAAdd.Entrant.Stack5
end
-- ===== Tick510Gates =====
section

/-! Tick `510` on its forced input.

By `W.iter_sum_width` the Skywalk state before tick `510` has `u+v ≤ 2`, so its
rails are `encode G S u 1` with `u ∈ {0,1}`: at most six basis inputs on the eleven
tick wires `base 509`–`base 513`, `base 770`–`base 772`, `base 1538` (fresh history),
`base 1540`–`base 1541` (carry).  These inputs are affinely independent, so every
Toffoli of the forward tick is affine on them: the forward tick equals a Clifford
circuit followed by two measured erasures of the quadratic letters `G·s` and `G·T`.
On the forward outputs the first carry Toffoli of the reverse tick equals
`1 ⊕ base 511`, so it and the following `CX` become one `X`; the routing Fredkins stay. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
