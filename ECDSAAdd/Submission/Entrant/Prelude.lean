    Finset.union_empty,Finset.singleton_subset_iff,Finset.union_subset_iff,ports_sign] using
    And.intro (And.intro sg k) sg

theorem body_support (divide : Bool) (w : Nat → Wire) (sign eff : Wire) (W : Finset Wire)
