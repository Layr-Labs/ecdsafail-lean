  simp only [List.nodup_cons,List.mem_cons,not_or] at ndr
  intro e
  interval_cases i
  · rw [e0] at e;subst e
    rcases hq with h|h
    · exact ndr.1.2.2.2.1 h
    · exact ndr.1.2.2.2.2 h
  · rw [e1] at e;subst e
    rcases hq with h|h
    · exact ndr.2.1.2.2.1 h
    · exact ndr.2.1.2.2.2 h
  · rw [e2] at e;subst e
