theorem entryField_host_free : base 511∉wires entryField ∧ base 1542∉wires entryField := by
  rw [entryField_support_eq]
  exact ⟨fun h => OneFlagEntryRaw.field_free.1 (OneFlagEntryRaw.selField5.sub.wires_sub h),
