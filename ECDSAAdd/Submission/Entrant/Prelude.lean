-- ===== ECDSAAdd.Submission.Entrant.OB5IntegerSupport =====
section

/-! The emitted retired-sign integer programs fit the one-bank inventory. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.OB5Support
