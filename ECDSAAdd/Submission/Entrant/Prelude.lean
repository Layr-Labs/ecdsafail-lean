  all_goals first
    | (obtain ⟨i,hi,rfl⟩ := List.mem_map.mp h
       simp only [List.mem_range'_1] at hi
       apply Equiv.swap_apply_of_ne_of_ne
       · intro eq
         have := pool_inj L hw hn i 684 (by omega) (by omega) eq
         omega
