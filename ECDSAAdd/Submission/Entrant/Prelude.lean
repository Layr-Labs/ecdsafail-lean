theorem checkMF : ∀G S : Bool, ∀uv∈pairs509, ∀c∈recsUpTo 5,
 runN_t8 (tick509ExF++tick510ExF) c (false,input509 G S uv)=runN_t8 tickMF c (false,input509 G S uv) :=
