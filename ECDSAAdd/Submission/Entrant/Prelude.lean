def sharedIds : List Nat := [765,1026]++balancedSharedIds++List.range' 512 253++[766,767,768]

theorem sharedSites_perm (w : Nat → Wire) (sign : Wire) :
    (sharedSites w sign).Perm (sign::sign::sharedIds.map w) := by
