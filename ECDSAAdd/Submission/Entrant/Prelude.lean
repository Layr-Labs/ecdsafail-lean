theorem support_transport (L : ControlledPointLayout) (S : Finset Wire)
    (old : wires (OwnQ4Square.program L)⊆S)
    (a : L.core.poolWire 770∈S) (b : L.core.poolWire 1536∈S) : wires (program L)⊆S := by
