    have rest := ih (fun k hk=>controls k (List.mem_cons_of_mem l hk))
    cases divide <;> simp only [rawReplay,Bool.false_eq_true,if_false,if_true,wires_append,
      Finset.mem_union,not_or] at c rest ⊢
