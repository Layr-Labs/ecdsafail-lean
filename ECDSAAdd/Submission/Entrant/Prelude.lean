    · by_cases a1032 : a=base 1032
      · subst a1032
        exact hole_free ha
      · rw [Equiv.swap_apply_of_ne_of_ne a719 a1032] at eq
        subst eq
        exact lo _ (Or.inr (Or.inr rfl)) ha
  · have e := Finset.mem_singleton.mp (pad_wires (base 512) 506 used)
    rw [base_injective.eq_iff] at e
    omega



































