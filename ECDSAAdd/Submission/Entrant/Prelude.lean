 change (!(b L.sigma && b L.h) && seedOK (b (L.Y 29)) (b L.sigma) (b (L.A 29)) (bExpected L b 30) &&
  !(b (L.A 29) && bExpected L b 30 && !b L.h))=true
 simp only [Bool.and_eq_true,Bool.not_eq_true',hh,nd,seedOK_iff]
