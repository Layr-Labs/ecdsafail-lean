def recordPad : Program → List Bool → List Bool
  | [], _ => []
  | .measureX _ _ _ :: p, [] => false::recordPad p []
  | .measureX _ _ _ :: p, b::bs => b::recordPad p bs
  | _::p, m => recordPad p m

