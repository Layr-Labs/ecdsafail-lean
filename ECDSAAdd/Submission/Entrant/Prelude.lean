 theorem field_kernel_free (divide : Bool) :
    base 1026∉wires (OwnQ6Core5.kernel divide (OneBankCell5.ports base (base 2409))) := by
  simpa only [OwnQ6Core5.kernel,OwnQ5Fixed.kernel] using OwnQ5Fixed.kernel_free divide
 theorem hosted_field_free (divide : Bool) : base 1026∉wires (KernelOB5.segH divide) :=
