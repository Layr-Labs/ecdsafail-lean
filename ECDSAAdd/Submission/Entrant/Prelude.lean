        omega
      exact kn (pool_inj layout layout_widths layout_nodup k 718 kb (by omega) same)
    · exact old k hk used
  have oldw (k : Nat) (hk : k<2613) (kn : k≠718)
      (free : layout.core.poolWire k∉wires P) : layout.core.poolWire k∉wires witness := by
