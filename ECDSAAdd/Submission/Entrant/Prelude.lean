set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 2000000
namespace ECDSAAdd.Arithmetic.Q6LowerExposure
open BalancedCleanup

def expose (sign low first : Wire) : Program :=
  [.X low,.CX sign low,.CX first low]

theorem expose_correct (sign low first : Wire) (hs : sign≠low) (hf : first≠low)
    (s : State) (m : List Bool)
    (h : s.basis first=!(s.basis sign ^^ s.basis low)) :
    (run (expose sign low first) m s).phase=s.phase ∧
    (run (expose sign low first) m s).basis low=false ∧
    (∀q,q≠low→(run (expose sign low first) m s).basis q=s.basis q) := by
  refine ⟨rfl,?_,?_⟩
  · cases a : s.basis sign <;> cases b : s.basis low <;>
      simp [expose,run,writeBit,hs,hf,h,a,b]
  · intro q hq; simp [expose,run,writeBit,hq]

theorem expose_counts (sign low first : Wire) :
    toffoliCount (expose sign low first)=0 ∧
    measurementCount (expose sign low first)=0 := by constructor <;> rfl

theorem prepareCompare_low_relation (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (X : Nat) (hX : X<2^255) (s : State) (m : List Bool)
    (hr : regValue L.r s.basis=X) :
    let t := run (prepareCompare L) m s
    t.basis L.r0=!(t.basis L.sign ^^ t.basis L.lower) := by
  let v1 := run (rotateLeft L.r) m s
  let ins : Program := [.X L.r0,.CX L.sign L.r0,.CX L.lower L.r0]
  let v2 := run ins m v1
  let v3 := run (signComplement L.sign L.y) m v2
  let v4 := run (signComplement L.lower L.y) m v3
  let v5 := run [.X L.rmsb] m v4
  let v6 := run [.X L.ymsb] m v5
  have w := widths L hw
  have d := List.nodup_append'.mp (L.dataND hn)
  have dr := d.1
  have dy := (List.nodup_append'.mp d.2.1).1
  have dis := d.2.2
  have r0R : L.r0∈L.r := by simp [Layout.r,Layout.low]
  have rmR : L.rmsb∈L.r := by simp [Layout.r]
  have r0Y : L.r0∉L.y := fun h => List.disjoint_left.mp dis r0R (by simp [h])
  have away (q : Wire) (hq : q∈[L.sign,L.lower]) : q∉L.r ∧ q∉L.y := by
    have a := L.flagAway hn q (by simp only [List.mem_cons] at hq ⊢; tauto)
    exact ⟨fun h => a (by simp [h]),fun h => a (by simp [h])⟩
  have sr : L.sign≠L.r0 := fun e => (away _ (by simp)).1 (e ▸ r0R)
  have lr : L.lower≠L.r0 := fun e => (away _ (by simp)).1 (e ▸ r0R)
  have rot := (rotateLeft_spec L.r dr X (by rw [w.2.1]; omega) s m hr).2
  have low0 : v1.basis L.r0=false := by
    change (if v1.basis L.r0 then 1 else 0)+2*regValue (L.rtail++[L.rmsb]) v1.basis=2*X at rot
    cases e : v1.basis L.r0
    · rfl
    · simp [e] at rot; omega
  have rel2 : v2.basis L.r0=!(v2.basis L.sign ^^ v2.basis L.lower) := by
    cases a : v1.basis L.sign <;> cases b : v1.basis L.lower <;>
      simp [v2,ins,run,writeBit,sr,lr,low0,a,b]
  have sc := signComplement_correct L.sign L.y dy (away _ (by simp)).2 v2 m
  have lc := signComplement_correct L.lower L.y dy (away _ (by simp)).2 v3 m
  have preserve (q : Wire) (hq : q∈[L.r0,L.sign,L.lower]) : v6.basis q=v2.basis q := by
    have qy : q∉L.y := by
      simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
      rcases hq with rfl|rfl|rfl
      · exact r0Y
      · exact (away _ (by simp)).2
      · exact (away _ (by simp)).2
    have qm : q≠L.rmsb := by
      have cnt := List.nodup_iff_count.mp hn q
      simp only [Layout.wires] at cnt
      intro eq; subst q
      simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
      rcases hq with e|e|e <;> rw [e] at cnt <;>
        simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true,List.count_nil] at cnt <;> omega
    have qym : q≠L.ymsb := fun e => qy (by simp [Layout.y,e])
    have tail : v6.basis q=v4.basis q := by simp [v6,v5,run,writeBit,qm,qym]
    exact tail.trans ((lc.2.1 q qy).trans (sc.2.1 q qy))
  have emptyRot (t : State) : run (rotateLeft L.r) (m.take 0) t=run (rotateLeft L.r) m t := by
    simpa only [(rotate_counts L.r).2.2.2] using run_take (rotateLeft L.r) m t
  have emptyS (t : State) : run (signComplement L.sign L.y) (m.take 0) t=run (signComplement L.sign L.y) m t := by
    simpa only [(signComplement_counts L.sign L.y).2] using run_take (signComplement L.sign L.y) m t
  have emptyL (t : State) : run (signComplement L.lower L.y) (m.take 0) t=run (signComplement L.lower L.y) m t := by
    simpa only [(signComplement_counts L.lower L.y).2] using run_take (signComplement L.lower L.y) m t
  have execute : run (prepareCompare L) m s=v6 := by
    simp only [prepareCompare,List.append_assoc,run_append,
      (rotate_counts L.r).2.2.2,(signComplement_counts L.sign L.y).2,
      (signComplement_counts L.lower L.y).2,measurementCount,List.drop_zero,emptyRot,emptyS,emptyL]
    rfl
  change (run (prepareCompare L) m s).basis L.r0=!
    ((run (prepareCompare L) m s).basis L.sign ^^ (run (prepareCompare L) m s).basis L.lower)
  rw [execute,preserve _ (by simp),preserve _ (by simp),preserve _ (by simp)]
  exact rel2
end ECDSAAdd.Arithmetic.Q6LowerExposure
#print axioms ECDSAAdd.Arithmetic.Q6LowerExposure.prepareCompare_low_relation

set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6ComparatorBorrow
open Arithmetic Arithmetic.Q6LowerExposure

def borrowed (a low sign first : Wire) (P : Program) : Program :=
  expose sign low first++renameProgram (Equiv.swap a low) P++(expose sign low first).reverse

theorem borrowed_correct (a low sign first : Wire) (hs : sign≠low) (hf : first≠low)
    (ha : a≠low) (P : Program) (free : low∉wires P)
    (s : State) (m : List Bool)
    (relation : s.basis first=!(s.basis sign ^^ s.basis low))
    (clean : s.basis a=false)
    (outclean : (run P m s).basis a=false)
    (outsign : (run P m s).basis sign=s.basis sign)
    (outfirst : (run P m s).basis first=s.basis first) :
    run (borrowed a low sign first P) m s=run P m s := by
  let E := expose sign low first
  let u := run E m s
  let v := run P m u
  let t := run P m s
  have eu := expose_correct sign low first hs hf s m relation
  have apart : OneReuse.Apart low u s := ⟨eu.1,eu.2.2⟩
  have eq := OneReuse.away_congr low P free u s m apart
  have vl : v.basis low=false :=
    (run_preserves_outside P m u low free).trans eu.2.1
  have ua : u.basis a=false := (eu.2.2 a ha).trans clean
  have va : v.basis a=false := (eq.2 a ha).trans outclean
  have rb := FieldFrameOB5.rebind_swap_run a low P u m ua eu.2.1 va vl
  have tail : run E.reverse (m.drop (measurementCount P)) v=t := by
    apply State.extensionality
    · exact eq.1
    · funext q
      by_cases hq : q=low
      · subst q
        have vs : v.basis sign=s.basis sign := (eq.2 sign hs).trans outsign
        have vf : v.basis first=s.basis first := (eq.2 first hf).trans outfirst
        have tl : t.basis low=s.basis low := run_preserves_outside P m s low free
        cases x : s.basis sign <;> cases y : s.basis low <;>
          simp [E,expose,List.reverse_cons,run,writeBit,hs,hf,vl,vs,vf,tl,relation,x,y]
      · have keep : (run E.reverse (m.drop (measurementCount P)) v).basis q=v.basis q := by
          simp [E,expose,List.reverse_cons,run,writeBit,hq]
        exact keep.trans (eq.2 q hq)
  have em : measurementCount E=0 := (expose_counts sign low first).2
  have er (rec : List Bool) (st : State) : run E rec st=run E m st := by
    simp [E,expose,run]
  have renamedCount : measurementCount (renameProgram (Equiv.swap a low) P)=measurementCount P :=
    (renameProgram_counts _ _).2
  have er0 : run (expose sign low first) (m.take 0) s=u := by
    change run E (m.take 0) s=run E m s
    exact er _ _
  have takeP : run (renameProgram (Equiv.swap a low) P) (m.take (measurementCount P)) u=
      run (renameProgram (Equiv.swap a low) P) m u := by
    simpa only [renamedCount] using run_take (renameProgram (Equiv.swap a low) P) m u
  simp only [borrowed,List.append_assoc,run_append,
    (expose_counts sign low first).2,List.drop_zero,renamedCount]
  rw [er0,takeP,rb]
  exact tail
end ECDSAAdd.Entrant.Q6ComparatorBorrow
#print axioms ECDSAAdd.Entrant.Q6ComparatorBorrow.borrowed_correct

set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6ComparatorBorrow
open Arithmetic Arithmetic.Q6LowerExposure

theorem compare_frame_borrow (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (P : Program) (free : L.lower∉wires P)
    (s : State) (m : List Bool) (ho : s.basis L.one=false)
    (hc : ∀q∈L.carry,s.basis q=false)
    (relation : s.basis L.r0=!(s.basis L.sign ^^ s.basis L.lower))
    (eq : run P m s=run (compareLt none L.y L.r L.carry L.one L.parity) m s) :
    run (borrowed a L.lower L.sign L.r0 P) m s=run P m s := by
  have cnt := List.nodup_iff_count.mp (BalancedCircuit.allND L hn)
  have ne (x y : Wire) (hxy : x∈[L.sign,L.lower,L.parity,L.r0])
      (hy : y∈L.carry) : x≠y := by
    intro e
    have hx := cnt x
    have cy : 0<List.count x L.carry := List.count_pos_iff.mpr (e ▸ hy)
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hxy
    rcases hxy with rfl|rfl|rfl|rfl <;>
      simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
        BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at hx <;> omega
  have sL : L.sign≠L.lower := by
    intro e;have h:=cnt L.sign
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil] at h
    rw [←e] at h;simp at h;omega
  have rL : L.r0≠L.lower := by
    intro e;have h:=cnt L.r0
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil] at h
    rw [←e] at h;simp at h;omega
  have sP : L.sign≠L.parity := by
    intro e;have h:=cnt L.sign
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil] at h
    rw [←e] at h;simp at h;omega
  have rP : L.r0≠L.parity := by
    intro e;have h:=cnt L.r0
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil] at h
    rw [←e] at h;simp at h;omega
  have w := BalancedCleanup.widths L.toLayout hw
  have cmp := compareLt_correct none L.y L.r L.carry L.one L.parity
    (L.toLayout.compareND (List.nodup_append'.mp hn).2.1) (by simp)
    (w.2.2.1.trans w.2.1.symm) (hw.2.2.trans w.2.1.symm) s m ho hc
  apply borrowed_correct a L.lower L.sign L.r0 sL rL (Ne.symm (ne _ _ (by simp) ha)) P free s m relation (hc a ha)
  · rw [eq,cmp.2.1 a (Ne.symm (ne _ _ (by simp) ha)),hc a ha]
  · rw [eq];exact cmp.2.1 _ sP
  · rw [eq];exact cmp.2.1 _ rP

theorem carry_program_lower_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.lower∉wires (CarryBorrow.program L) := by
  rw [CarryBorrow.program_support_eq L hw]
  intro bad
  have nd : (L.lower::(L.parity::L.one::L.y++L.r++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have away := (List.nodup_cons.mp nd).1
  have used := List.mem_toFinset.mp bad
  have takeMem : L.lower∈L.carry.take 255 → L.lower∈L.carry := List.mem_of_mem_take
  apply away
  simp only [List.mem_cons,List.mem_append] at used ⊢
  tauto


theorem actual_forward_compare_borrow (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (s : State) (m : List Bool) (ho : s.basis L.one=false)
    (hc : ∀q∈L.carry,s.basis q=false)
    (relation : s.basis L.r0=!(s.basis L.sign ^^ s.basis L.lower))
    (ht : s.basis L.parity=decide (regValue L.y s.basis<regValue L.r s.basis)) :
    run (borrowed a L.lower L.sign L.r0 (TopCarryBorrow.program L)) m s=
      run (TopCarryBorrow.program L) m s := by
  exact compare_frame_borrow L hw hn a ha _
    (fun h=>(carry_program_lower_free L hw hn) ((TopCarryBorrow.program_support_subset L hw) h))
    s m ho hc relation (TopCarryBorrow.program_eq L hw hn s m ho hc ht)

theorem actual_inverse_compare_borrow (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (s : State) (m : List Bool) (ho : s.basis L.one=false)
    (hc : ∀q∈L.carry,s.basis q=false)
    (relation : s.basis L.r0=!(s.basis L.sign ^^ s.basis L.lower)) :
    run (borrowed a L.lower L.sign L.r0 (CarryBorrow.program L)) m s=
      run (CarryBorrow.program L) m s := by
  exact compare_frame_borrow L hw hn a ha _ (carry_program_lower_free L hw hn)
    s m ho hc relation (CarryBorrow.program_eq L hw hn s m ho hc)
end ECDSAAdd.Entrant.Q6ComparatorBorrow
#print axioms ECDSAAdd.Entrant.Q6ComparatorBorrow.compare_frame_borrow

set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6RawBorrow
open Arithmetic GuardCompression BalancedCircuit

theorem rawTarget_away (L : BalancedCircuit.Layout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈L.lower::L.parity::L.carry) : q∉rawTarget L := by
  have nd : ((L.lower::L.parity::L.carry)++rawTarget L).Nodup := by
    apply List.nodup_iff_count.mpr
    intro a
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) a
    simp only [rawTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  exact fun h=>List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 hq h

theorem rawAdd_borrow (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (s : State) (m : List Bool)
    (hz : s.basis L.one=s.basis L.rmsb) (hc : ∀q∈L.carry,s.basis q=false)
    (hl : s.basis L.lower=false) :
    run (renameProgram (Equiv.swap a L.lower) (FifthCarry.rawAdd L)) m s=
      run (FifthCarry.rawAdd L) m s := by
  have eq := FifthCarry.rawAdd_eq L hw hn s m hz hc
  have corr:=GuardCompression.rawAdd_correct L hw hn s m ((regValue_zero _ _).mpr hc)
  apply FieldFrameOB5.rebind_swap_run a L.lower _ s m (hc a ha) hl
  · rw [eq];exact (corr.2.1 a (rawTarget_away L hn a (by simp [ha]))).trans (hc a ha)
  · rw [eq];exact (corr.2.1 L.lower (rawTarget_away L hn _ (by simp))).trans hl

theorem rawSub_actual_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hc : ∀q∈L.carry,s.basis q=false)
    (hp : s.basis L.parity=false)
    (cond : (run (GuardCompression.rawSub L) m s).basis L.one=
      (run (GuardCompression.rawSub L) m s).basis L.rmsb) :
    run (FifthCarry2.rawSub L) m s=run (GuardCompression.rawSub L) m s := by
  have idx : 255<L.carry.length := by rw [hw.2.2];omega
  have lastMem : L.carry.getD 255 0∈L.carry := by
    rw [List.getD_eq_getElem _ _ idx];exact List.getElem_mem _
  have eq:=GuardCompression.rawSubT_eq L hw hn s m hc cond
  have corr:=GuardCompression.rawSub_correct L hw hn s m ((regValue_zero _ _).mpr hc)
  have zeroLast : (run (GuardCompression.rawSubT L) m s).basis (L.carry.getD 255 0)=false := by
    rw [eq];exact (corr.2.1 _ (rawTarget_away L hn _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ lastMem)))).trans (hc _ lastMem)
  have zeroPar : (run (GuardCompression.rawSubT L) m s).basis L.parity=false := by
    exact (run_preserves_outside _ _ _ _ (BigABorrowParity.rawTop_parity_free L hn)).trans hp
  rw [←FifthCarry2.rawSub_swap L hw hn,
    FieldFrameOB5.rebind_swap_run _ _ _ s m (hc _ lastMem) hp zeroLast zeroPar,eq]

theorem rawSub_borrow (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (s : State) (m : List Bool)
    (hc : ∀q∈L.carry,s.basis q=false) (hl : s.basis L.lower=false)
    (hp : s.basis L.parity=false)
    (cond : (run (GuardCompression.rawSub L) m s).basis L.one=
      (run (GuardCompression.rawSub L) m s).basis L.rmsb) :
    run (renameProgram (Equiv.swap a L.lower) (FifthCarry2.rawSub L)) m s=
      run (FifthCarry2.rawSub L) m s := by
  have eq:=rawSub_actual_eq L hw hn s m hc hp cond
  have corr:=GuardCompression.rawSub_correct L hw hn s m ((regValue_zero _ _).mpr hc)
  apply FieldFrameOB5.rebind_swap_run a L.lower _ s m (hc a ha) hl
  · rw [eq];exact (corr.2.1 a (rawTarget_away L hn a (by simp [ha]))).trans (hc a ha)
  · rw [eq];exact (corr.2.1 L.lower (rawTarget_away L hn _ (by simp))).trans hl

theorem inverse_prefix_lower_clean (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : BalancedField.Centered R) (hy : BalancedField.Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    (run (FifthCarry.inversePrefix L) m s).basis L.lower=false := by
  have preEq := (FifthCarry.inverse_prefix_eq L hw hn s m hc).trans
    (FifthCarry.old_prefix_eq L hw hn B R Y hr hy s m hs hR hY hc)
  rw [preEq]
  let v := run (GuardCompression.inversePrefix L) m s
  let r := m.drop (measurementCount (GuardCompression.inversePrefix L))
  have clean:=FifthCarry.short_prefix_clean L hw hn B R Y hr hy s m hs hR hY hc
  have raw:=GuardCompression.rawSub_correct L hw hn v r clean
  have rawLower : (run (GuardCompression.rawSub L) r v).basis L.lower=v.basis L.lower :=
    raw.2.1 _ (rawTarget_away L hn _ (by simp))
  have sd:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at sd
  have lp : L.lower≠L.parity := by tauto
  have lo : L.lower≠L.one := by tauto
  have seedLower (t : State) (rec : List Bool) :
      (run (GuardCompression.seed L).reverse rec t).basis L.lower=t.basis L.lower := by
    simp [GuardCompression.seed,List.reverse_cons,run,writeBit,lp,lo]
  have final := (GuardCompression.inverse_correct L hw hn B R Y hr hy s m hs hR hY hc).2.2.1
    L.lower (by simp [work])
  have shape : GuardCompression.inverse L=GuardCompression.inversePrefix L++
      GuardCompression.rawSub L++(GuardCompression.seed L).reverse := rfl
  rw [shape,run_append,run_take,seedLower,run_append,run_take] at final
  exact rawLower.symm.trans final
end ECDSAAdd.Entrant.Q6RawBorrow
#print axioms ECDSAAdd.Entrant.Q6RawBorrow.rawAdd_borrow
#print axioms ECDSAAdd.Entrant.Q6RawBorrow.rawSub_borrow

set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6CompareReady
open Arithmetic Arithmetic.BalancedField Arithmetic.BalancedCleanup

theorem normalized_bound (L : BalancedCleanup.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (R : Int) (hr : Centered R) (s : State) (m : List Bool)
    (hR : regValue L.r s.basis=encodeWord 256 R) (hz : s.basis L.lower=false)
    (ho : s.basis L.one=false) (hc : ∀q∈L.carry,s.basis q=false) :
    regValue L.r (run (prepareSign L++normalize L) m s).basis<2^255 := by
  let s1 := run (prepareSign L) m s
  let ms := m.drop (measurementCount (prepareSign L))
  let s2 := run (normalize L) ms s1
  have w := widths L hw
  have nd := L.normND hn
  have oa : L.one∉L.r := fun h=>L.flagAway hn L.one (by simp) (by simp [h])
  have ol : L.one≠L.lower := by
    have h:=List.nodup_iff_count.mp (L.flagsND hn) L.one
    intro e;simp [List.count_cons,e] at h;omega
  have ca (q : Wire) (hq : q∈L.carry) : q∉L.r ∧ q≠L.lower := by
    have d:=List.nodup_append'.mp (L.dataND hn)
    exact ⟨fun h=>List.disjoint_left.mp d.2.2 h (by simp [hq]),
      fun e=>L.flagAway hn L.lower (by simp) (by simp [←e,hq])⟩
  have v1 := prepareSign_value L hw hn R hr s m hR hz
  have one1 : s1.basis L.one=false := (v1.2.2 _ oa ol).trans ho
  have clean1 : ∀q∈L.carry,s1.basis q=false :=
    fun q hq=>(v1.2.2 q (ca q hq).1 (ca q hq).2).trans (hc q hq)
  have rm0 : s1.basis L.rmsb=false := by
    have hi:=regValue_highBit L.low L.rmsb s1.basis
    rw [w.1] at hi
    change s1.basis L.rmsb=true ↔ 2^255≤regValue L.r s1.basis at hi
    rw [v1.1] at hi
    have b:=magnitude_bounds R hr
    have p:=constants
    have cast:=Int.toNat_of_nonneg b.1
    cases e:s1.basis L.rmsb
    · rfl
    · simp [e] at hi;omega
  have low1 : regValue L.low s1.basis=(magnitude R).toNat := by
    have h : regValue L.r s1.basis=(magnitude R).toNat := v1.1
    rw [Layout.r,regValue_append] at h;simpa [regValue,rm0] using h
  have v2:=normalize_value L hw hn R hr s1 ms low1 v1.2.1 one1 clean1
  have rmAway : L.rmsb∉L.low := by
    have d:=List.nodup_append'.mp (List.nodup_append'.mp (L.dataND hn)).1
    exact fun h=>List.disjoint_left.mp d.2.2 h (by simp)
  have R2 : regValue L.r s2.basis=encodeWord 255 (normalizedR R) := by
    have val : regValue L.low s2.basis=encodeWord 255 (normalizedR R) := v2.2.1
    have high : s2.basis L.rmsb=s1.basis L.rmsb := v2.2.2 _ rmAway
    rw [Layout.r,regValue_append,val];simp [regValue,high,rm0]
  have actual : run (prepareSign L++normalize L) m s=s2 := by
    rw [run_append,run_take]
  rw [actual,R2]
  exact encodeWord_bound 255 _

theorem forwardPrefix_bound (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    regValue L.r (run (FifthCarry2.forwardPrefix L) m s).basis<2^255 := by
  rw [FifthCarry2.forwardPrefix_shifted L hw hn s m hc]
  have apart:=FifthCarry.forward_prefix_apart L hw hn B X Y hx hy s (false::m) hs hr hyr hc
  have post:=ShortBiasedFold.prefixPost L hw hn B X Y hx hy s (false::m) hs hr hyr hc
  have eq : regValue L.r (run (FifthCarry.oldForwardPrefix L) (false::m) s).basis=
      regValue L.r (run (ShortBiasedFold.biasedPrefix L) (false::m) s).basis := by
    apply regValue_congr
    intro q hq
    exact apart.2 q (fun e=>BalancedCircuit.flagAway L hn L.sourceGuard (by simp)
      (by simp [←e,hq]))
  rw [eq,post.value]
  exact encodeWord_bound 255 _
end ECDSAAdd.Entrant.Q6CompareReady
#print axioms ECDSAAdd.Entrant.Q6CompareReady.normalized_bound
#print axioms ECDSAAdd.Entrant.Q6CompareReady.forwardPrefix_bound

set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6CleanupBorrow
open Arithmetic Arithmetic.BalancedField BalancedCircuit Q6ComparatorBorrow Arithmetic.Q6LowerExposure
attribute [local irreducible] run

theorem borrowed_counts (a low sign first : Wire) (P : Program) :
    toffoliCount (borrowed a low sign first P)=toffoliCount P ∧
    measurementCount (borrowed a low sign first P)=measurementCount P := by
  simp [borrowed,toffoliCount_append,measurementCount_append,toffoliCount_reverse,
    measurementCount_reverse,(renameProgram_counts _ _).1,(renameProgram_counts _ _).2,
    (expose_counts sign low first).1,(expose_counts sign low first).2]

def cleanup (L : BalancedCircuit.Layout) (a : Wire) : Program :=
  BalancedCleanup.prepareCompare L.toLayout++
    borrowed a L.lower L.sign L.r0 (TopCarryBorrow.program L)++FifthCarry2.cleanupRest L

theorem prepare_M (L : BalancedCleanup.Layout) : measurementCount (BalancedCleanup.prepareCompare L)=0 := by
  simp only [BalancedCleanup.prepareCompare,measurementCount_append,(signComplement_counts _ _).2,
    (rotate_counts L.r).2.2.2]
  norm_num [measurementCount]

theorem cleanup_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (s : State) (m : List Bool)
    (ho : s.basis L.one=false) (hc : ∀q∈L.carry,s.basis q=false)
    (bound : regValue L.r s.basis<2^255)
    (hp : (run (CarryBorrow.cleanup L) m s).basis L.parity=false) :
    run (cleanup L a) m s=run (FifthCarry2.cleanup L) m s := by
  let v := run (BalancedCleanup.prepareCompare L.toLayout) [] s
  have ready:=CarryBorrow.prepareCompare_clean L hw hn s [] ho hc
  have oldShape : CarryBorrow.cleanup L=BalancedCleanup.prepareCompare L.toLayout++
      (CarryBorrow.program L++FifthCarry2.cleanupRest L) := by
    simp only [CarryBorrow.cleanup,FifthCarry2.cleanupRest,List.append_assoc]
  have out : run (CarryBorrow.cleanup L) m s=run (FifthCarry2.cleanupRest L)
      (m.drop (measurementCount (CarryBorrow.program L))) (run (CarryBorrow.program L) m v) := by
    rw [oldShape,run_append,prepare_M,List.take_zero,List.drop_zero,run_append,run_take]
  have fin : (run (CarryBorrow.program L) m v).basis L.parity=false := by
    rw [out,run_preserves_outside _ _ _ _ (FifthCarry2.cleanupRest_free L hw hn)] at hp
    exact hp
  have eqOld:=CarryBorrow.program_eq L hw hn v m ready.1 ready.2
  have w:=BalancedCleanup.widths L.toLayout hw
  have cmp:=compareLt_correct none L.y L.r L.carry L.one L.parity
    (L.toLayout.compareND (List.nodup_append'.mp hn).2.1) (by simp)
    (w.2.2.1.trans w.2.1.symm) (hw.2.2.trans w.2.1.symm) v m ready.1 ready.2
  rw [eqOld,cmp.2.2] at fin
  simp only [controlValue,Bool.true_and] at fin
  have par : v.basis L.parity=decide (regValue L.y v.basis<regValue L.r v.basis) := by
    revert fin
    cases v.basis L.parity <;> cases decide (regValue L.y v.basis<regValue L.r v.basis) <;> decide
  have relation := prepareCompare_low_relation L.toLayout hw (List.nodup_append'.mp hn).2.1
    (regValue L.r s.basis) bound s [] rfl
  have eq:=actual_forward_compare_borrow L hw hn a ha v m ready.1 ready.2 relation par
  have count := (borrowed_counts a L.lower L.sign L.r0 (TopCarryBorrow.program L)).2
  simp only [cleanup,FifthCarry2.cleanup,List.append_assoc,run_append,run_take,
    prepare_M,List.drop_zero,List.take_zero,count]
  have takeB:=run_take (borrowed a L.lower L.sign L.r0 (TopCarryBorrow.program L)) m v
  rw [count] at takeB
  rw [takeB,eq]

def recoverPrefix (L : BalancedCircuit.Layout) (a : Wire) : Program :=
  CarryBorrow.recoverBefore L++borrowed a L.lower L.sign L.r0 (CarryBorrow.program L)++
    (BalancedCleanup.prepareCompare L.toLayout).reverse

theorem recoverPrefix_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (R : Int) (hr : BalancedField.Centered R)
    (s : State) (m : List Bool) (hR : regValue L.r s.basis=encodeWord 256 R)
    (hl : s.basis L.lower=false) (ho : s.basis L.one=false)
    (hc : ∀q∈L.carry,s.basis q=false) :
    run (recoverPrefix L a) m s=run (CarryBorrow.recoverPrefix L) m s := by
  let v:=run (CarryBorrow.recoverBefore L) m s
  let records:=m.drop (measurementCount (CarryBorrow.recoverBefore L))
  let P:=BalancedCleanup.prepareSign L.toLayout++BalancedCleanup.normalize L.toLayout
  let u:=run P m s
  have ready:=CarryBorrow.recoverBefore_clean L hw hn s m ho hc
  have bound:=Q6CompareReady.normalized_bound L.toLayout hw (List.nodup_append'.mp hn).2.1 R hr s m hR hl ho hc
  have shape : CarryBorrow.recoverBefore L=P++BalancedCleanup.prepareCompare L.toLayout := rfl
  have relation : v.basis L.r0=!(v.basis L.sign ^^ v.basis L.lower) := by
    change (run (CarryBorrow.recoverBefore L) m s).basis L.r0=!
      ((run (CarryBorrow.recoverBefore L) m s).basis L.sign ^^ (run (CarryBorrow.recoverBefore L) m s).basis L.lower)
    rw [shape,run_append,run_take]
    exact prepareCompare_low_relation L.toLayout hw (List.nodup_append'.mp hn).2.1
      (regValue L.r u.basis) bound u (m.drop (measurementCount P)) rfl
  have eq:=actual_inverse_compare_borrow L hw hn a ha v records ready.1 ready.2 relation
  have count:=(borrowed_counts a L.lower L.sign L.r0 (CarryBorrow.program L)).2
  simp only [recoverPrefix,CarryBorrow.recoverPrefix,List.append_assoc,run_append,run_take,count]
  have takeB:=run_take (borrowed a L.lower L.sign L.r0 (CarryBorrow.program L)) records v
  rw [count] at takeB
  rw [takeB,eq]
end ECDSAAdd.Entrant.Q6CleanupBorrow
#print axioms ECDSAAdd.Entrant.Q6CleanupBorrow.cleanup_eq

set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6RawBorrow
open Arithmetic GuardCompression BalancedCircuit
theorem rawSub_flag_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.lower,L.parity]) : q∉wires (GuardCompression.rawSub L) := by
  have away : q∉L.sign::(L.y++rawTarget L++L.carry) := by
    have nd : ([L.lower,L.parity]++(L.sign::(L.y++rawTarget L++L.carry))).Nodup := by
      apply List.nodup_iff_count.mpr;intro w
      have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) w
      simp only [rawTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
        List.count_cons,List.count_append,List.count_nil] at h ⊢;omega
    exact fun h=>List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 hq h
  have w:=BalancedCircuit.widths L hw
  have sub:=subInPlace_wires (source L) (rawTarget L) L.carry L.sign
    ((source_len L).trans (w.1.trans w.2.1.symm)) (by rw [hw.2.2,w.2.1])
  intro used
  simp only [GuardCompression.rawSub,wires_append,Finset.mem_union] at used
  rcases used with (h|h)|h
  · have z:=List.mem_toFinset.mp (signComplement_wires_subset L.sign L.y h)
    apply away
    simp only [List.mem_cons,List.mem_append] at z ⊢;tauto
  · rw [sub] at h
    have z:=List.mem_toFinset.mp h
    have src : q∈source L→q∈L.y := source_sub L q
    apply away
    simp only [List.mem_cons,List.mem_append] at z ⊢;tauto
  · have z:=List.mem_toFinset.mp (signComplement_wires_subset L.sign L.y h)
    apply away
    simp only [List.mem_cons,List.mem_append] at z ⊢;tauto

end ECDSAAdd.Entrant.Q6RawBorrow

set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6Cell
open Arithmetic Arithmetic.BalancedField BalancedCircuit
attribute [local irreducible] run

def rawAdd (L : Layout) (a : Wire) := renameProgram (Equiv.swap a L.lower) (FifthCarry.rawAdd L)
def rawSub (L : Layout) (a : Wire) := renameProgram (Equiv.swap a L.lower) (FifthCarry2.rawSub L)
def forwardPrefix (L : Layout) (a : Wire) : Program :=
  GuardCompression.seed L++rawAdd L a++OneReuse.remainder L
def forwardCore (L : Layout) (a : Wire) : Program := forwardPrefix L a++Q6CleanupBorrow.cleanup L a
def forward (L : Layout) (a : Wire) : Program := forwardCore L a++[.measureX L.one [] []]

theorem forwardPrefix_counts (L : Layout) (a : Wire) :
    toffoliCount (forwardPrefix L a)=toffoliCount (FifthCarry2.forwardPrefix L) ∧
    measurementCount (forwardPrefix L a)=measurementCount (FifthCarry2.forwardPrefix L) := by
  simp only [forwardPrefix,FifthCarry2.forwardPrefix,rawAdd,toffoliCount_append,measurementCount_append,
    (renameProgram_counts _ _).1,(renameProgram_counts _ _).2]
  trivial

theorem cleanup_counts (L : Layout) (a : Wire) :
    toffoliCount (Q6CleanupBorrow.cleanup L a)=toffoliCount (FifthCarry2.cleanup L) ∧
    measurementCount (Q6CleanupBorrow.cleanup L a)=measurementCount (FifthCarry2.cleanup L) := by
  simp only [Q6CleanupBorrow.cleanup,FifthCarry2.cleanup,toffoliCount_append,measurementCount_append,
    (Q6CleanupBorrow.borrowed_counts _ _ _ _ _).1,(Q6CleanupBorrow.borrowed_counts _ _ _ _ _).2]
  trivial

theorem forwardPrefix_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (s : State) (m : List Bool)
    (hc : ∀q∈work L,s.basis q=false) :
    run (forwardPrefix L a) m s=run (FifthCarry2.forwardPrefix L) m s := by
  have ready:=FifthCarry.seed_ready L hn s m hc
  have sd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at sd
  have lp : L.lower≠L.parity := by tauto
  have lo : L.lower≠L.one := by tauto
  have lower : (run (GuardCompression.seed L) m s).basis L.lower=false := by
    simpa [GuardCompression.seed,run,writeBit,lp,lo] using hc L.lower (by simp [work])
  have eq:=Q6RawBorrow.rawAdd_borrow L hw hn a ha (run (GuardCompression.seed L) m s)
    m ready.1 ready.2 lower
  have count:measurementCount (rawAdd L a)=measurementCount (FifthCarry.rawAdd L) :=
    (renameProgram_counts _ _).2
  simp only [forwardPrefix,FifthCarry2.forwardPrefix,List.append_assoc,run_append,run_take,
    show measurementCount (GuardCompression.seed L)=0 from rfl,List.drop_zero,List.take_zero,count]
  have seedNorm : run (GuardCompression.seed L) [] s=run (GuardCompression.seed L) m s := by
    simp [GuardCompression.seed,run]
  rw [seedNorm]
  have takeB:=run_take (rawAdd L a) m (run (GuardCompression.seed L) m s)
  rw [count] at takeB
  change run (rawAdd L a) m (run (GuardCompression.seed L) m s)=_ at eq
  rw [takeB,eq]

theorem forwardCore_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (forwardCore L a) m s=run (FifthCarry2.forwardCore L) m s := by
  have preEq:=forwardPrefix_eq L hw hn a ha s m hc
  have preClean:=FifthCarry.forward_prefix_clean L hw hn B X Y hx hy s (false::m) hs hr hyr hc
  rw [←FifthCarry2.forwardPrefix_shifted L hw hn s m hc] at preClean
  have bound:=Q6CompareReady.forwardPrefix_bound L hw hn B X Y hx hy s m hs hr hyr hc
  have old:=FifthCarry.forward_correct L hw hn B X Y hx hy s m hs hr hyr hc
  have shape:FifthCarry.forward L=FifthCarry2.forwardPrefix L++CarryBorrow.cleanup L := by
    simp only [FifthCarry.forward,FifthCarry2.forwardPrefix,List.append_assoc]
  rw [shape,run_append,run_take] at old
  have ce:=Q6CleanupBorrow.cleanup_eq L hw hn a ha (run (FifthCarry2.forwardPrefix L) m s)
    (m.drop (measurementCount (FifthCarry2.forwardPrefix L))) preClean.1 preClean.2 bound
    (old.2.2.1 L.parity (by simp [work]))
  simp only [forwardCore,FifthCarry2.forwardCore,run_append,run_take,(forwardPrefix_counts L a).2]
  have takeB:=run_take (forwardPrefix L a) m s
  rw [(forwardPrefix_counts L a).2] at takeB
  rw [takeB,preEq,ce]

theorem forward_counts (L : Layout) (a : Wire) :
    toffoliCount (forward L a)=toffoliCount (FifthCarry2.forward L) ∧
    measurementCount (forward L a)=measurementCount (FifthCarry2.forward L) := by
  simp only [forward,FifthCarry2.forward,forwardCore,FifthCarry2.forwardCore,
    toffoliCount_append,measurementCount_append,(forwardPrefix_counts L a).1,
    (forwardPrefix_counts L a).2,(cleanup_counts L a).1,(cleanup_counts L a).2]
  trivial

theorem forward_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (forward L a) m s=run (FifthCarry2.forward L) m s := by
  have eq:=forwardCore_eq L hw hn a ha B X Y hx hy s m hs hr hyr hc
  have count:measurementCount (forwardCore L a)=measurementCount (FifthCarry2.forwardCore L) := by
    simp only [forwardCore,FifthCarry2.forwardCore,measurementCount_append,
      (forwardPrefix_counts L a).2,(cleanup_counts L a).2]
  simp only [forward,FifthCarry2.forward,run_append,run_take,count]
  have takeB:=run_take (forwardCore L a) m s
  rw [count] at takeB
  rw [takeB,eq]
end ECDSAAdd.Entrant.Q6Cell
#print axioms ECDSAAdd.Entrant.Q6Cell.forward_eq

set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Q6Cell
open Arithmetic Arithmetic.BalancedField BalancedCircuit
attribute [local irreducible] run

def inversePrefix (L : Layout) (a : Wire) : Program :=
  Q6CleanupBorrow.recoverPrefix L a++BiasedInverse.unbiasView L++OneReuse.restoreRaw L

def inverse (L : Layout) (a : Wire) : Program := inversePrefix L a++
  [.CX L.r0 L.parity]++rawSub L a++[.CX L.rmsb L.one]

theorem recoverPrefix_counts (L : Layout) (a : Wire) :
    toffoliCount (Q6CleanupBorrow.recoverPrefix L a)=toffoliCount (CarryBorrow.recoverPrefix L) ∧
    measurementCount (Q6CleanupBorrow.recoverPrefix L a)=measurementCount (CarryBorrow.recoverPrefix L) := by
  simp only [Q6CleanupBorrow.recoverPrefix,CarryBorrow.recoverPrefix,
    toffoliCount_append,measurementCount_append,(Q6CleanupBorrow.borrowed_counts _ _ _ _ _).1,
    (Q6CleanupBorrow.borrowed_counts _ _ _ _ _).2]
  trivial

theorem inversePrefix_counts (L : Layout) (a : Wire) :
    toffoliCount (inversePrefix L a)=toffoliCount (FifthCarry.inversePrefix L) ∧
    measurementCount (inversePrefix L a)=measurementCount (FifthCarry.inversePrefix L) := by
  simp only [inversePrefix,FifthCarry.inversePrefix,toffoliCount_append,measurementCount_append,
    (recoverPrefix_counts L a).1,(recoverPrefix_counts L a).2]
  trivial

theorem inversePrefix_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (R : Int) (hr : Centered R)
    (s : State) (m : List Bool) (hR : signedRegValue L.r s.basis=R)
    (hc : ∀q∈work L,s.basis q=false) :
    run (inversePrefix L a) m s=run (FifthCarry.inversePrefix L) m s := by
  have widths:=BalancedCircuit.widths L hw
  have word:=word_encoding L.r 256 (BalancedCleanup.widths L.toLayout hw).2.1 s.basis R hR
  have eq:=Q6CleanupBorrow.recoverPrefix_eq L hw hn a ha R hr s m word
    (hc _ (by simp [work])) (hc _ (by simp [work])) (fun q hq=>hc q (by simp [work,hq]))
  have takeB:=run_take (Q6CleanupBorrow.recoverPrefix L a) m s
  rw [(recoverPrefix_counts L a).2] at takeB
  simp only [inversePrefix,FifthCarry.inversePrefix,List.append_assoc,run_append,run_take,
    (recoverPrefix_counts L a).2]
  rw [takeB,eq]

theorem inverse_counts (L : Layout) (a : Wire) :
    toffoliCount (inverse L a)=toffoliCount (FifthCarry2.inverse L) ∧
    measurementCount (inverse L a)=measurementCount (FifthCarry2.inverse L) := by
  simp only [inverse,FifthCarry2.inverse,rawSub,toffoliCount_append,measurementCount_append,
    (inversePrefix_counts L a).1,(inversePrefix_counts L a).2,
    (renameProgram_counts _ _).1,(renameProgram_counts _ _).2]
  trivial

theorem inverse_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a : Wire) (ha : a∈L.carry) (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (inverse L a) m s=run (FifthCarry2.inverse L) m s := by
  let v:=run (FifthCarry.inversePrefix L) m s
  let u:=run [.CX L.r0 L.parity] [] v
  let records:=m.drop (measurementCount (FifthCarry.inversePrefix L))
  have preEq:=inversePrefix_eq L hw hn a ha R hr s m hR hc
  have oldEq:=FifthCarry.inverse_prefix_eq L hw hn s m hc
  have guardEq:=oldEq.trans (FifthCarry.old_prefix_eq L hw hn B R Y hr hy s m hs hR hY hc)
  have carry : ∀q∈L.carry,v.basis q=false := by
    change ∀q∈L.carry,(run (FifthCarry.inversePrefix L) m s).basis q=false
    rw [oldEq]
    exact FifthCarry.inverse_prefix_carry_clean L hw hn B R Y hr hy s m hs hR hY hc
  have lower:=Q6RawBorrow.inverse_prefix_lower_clean L hw hn B R Y hr hy s m hs hR hY hc
  have parity:=GuardCompression.inverse_prefix_parity_unseeded L hw hn B R Y hr hy s m hs hR hY hc
  have pRel : v.basis L.parity=v.basis L.r0 := by
    change (run (FifthCarry.inversePrefix L) m s).basis L.parity=
      (run (FifthCarry.inversePrefix L) m s).basis L.r0
    rw [guardEq]
    exact parity.2
  have sd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at sd
  have lp : L.lower≠L.parity := by tauto
  have op : L.one≠L.parity := by tauto
  have rp : L.rmsb≠L.parity := by tauto
  have fp : L.r0≠L.parity := by tauto
  have apart : OneReuse.Apart L.parity u v := by
    refine ⟨by simp [u,run],?_⟩
    intro q hq;simp [u,run,writeBit,hq]
  have cleanU : ∀q∈L.carry,u.basis q=false := by
    intro q hq
    have qp : q≠L.parity := by
      intro eq
      exact flagAway L hn L.parity (by simp) (by simp [←eq,hq])
    exact (apart.2 q qp).trans (carry q hq)
  have lowU : u.basis L.lower=false := (apart.2 _ lp).trans lower
  have parU : u.basis L.parity=false := by
    simp [u,run,writeBit,pRel,fp]
  have cond:=FifthCarry.inverse_raw_output_dup L hw hn B R Y hr hy s m hs hR hY hc
  dsimp only at cond
  rw [←oldEq,←FifthCarry.inverse_prefix_measurements L hw hn] at cond
  have rel:=OneReuse.away_congr L.parity (GuardCompression.rawSub L)
    (Q6RawBorrow.rawSub_flag_free L hw hn _ (by simp)) u v records apart
  have condU : (run (GuardCompression.rawSub L) records u).basis L.one=
      (run (GuardCompression.rawSub L) records u).basis L.rmsb := by
    rw [rel.2 _ op,rel.2 _ rp]
    exact cond
  have rawEq : run (rawSub L a) records u=run (FifthCarry2.rawSub L) records u :=
    Q6RawBorrow.rawSub_borrow L hw hn a ha u records cleanU lowU parU condU
  have preTake:=run_take (inversePrefix L a) m s
  rw [(inversePrefix_counts L a).2] at preTake
  have rawCount:measurementCount (rawSub L a)=measurementCount (FifthCarry2.rawSub L) :=
    (renameProgram_counts _ _).2
  have rawTake:=run_take (rawSub L a) records u
  rw [rawCount] at rawTake
  simp only [inverse,FifthCarry2.inverse,List.append_assoc,run_append,run_take,
    (inversePrefix_counts L a).2,rawCount,measurementCount,List.drop_zero]
  rw [preTake,preEq]
  change run [.CX L.rmsb L.one] _ (run (rawSub L a) (records.take _) u)=
    run [.CX L.rmsb L.one] _ (run (FifthCarry2.rawSub L) records u)
  rw [rawTake,rawEq]
end ECDSAAdd.Entrant.Q6Cell
