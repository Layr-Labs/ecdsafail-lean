  simpa only [firstBorrowedBody,Prefix1590.firstBody] using
    metrics_G0 (firstBody divide) (FrontierSW1591.firstBodyS divide) 8 (firstBody_metrics divide)

private theorem firstPacket_metrics (divide : Bool) :
