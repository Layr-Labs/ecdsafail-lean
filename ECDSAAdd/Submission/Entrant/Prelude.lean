theorem otherEncode_disjoint (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (n j : Nat) (bound : 5*n≤512) (hj : j<n) :
    Disjoint (wires (otherEncode w j n)) (wires (encode w (5*j))) := by
