namespace ECDSAAdd.Entrant.Q6StructuralCell
open Arithmetic FieldRename BalancedCircuit Arithmetic.Q6LowerExposure Q6Structural

def exposure (L : BalancedCircuit.Layout) := expose L.sign L.lower L.r0

def cleanup (L : BalancedCircuit.Layout) : Program :=
  BalancedCleanup.prepareCompare L.toLayout++
    (exposure L++compareForward L++(exposure L).reverse)++FifthCarry2.cleanupRest L

def recoverPrefix (L : BalancedCircuit.Layout) : Program :=
  CarryBorrow.recoverBefore L++(exposure L++compareInverse L++(exposure L).reverse)++
    (BalancedCleanup.prepareCompare L.toLayout).reverse

def forwardPrefix (L : BalancedCircuit.Layout) : Program :=
  GuardCompression.seed L++Q6Structural.rawAdd L++OneReuse.remainder L

def forward (L : BalancedCircuit.Layout) : Program :=
  (forwardPrefix L++cleanup L)++[.measureX L.one [] []]

def inversePrefix (L : BalancedCircuit.Layout) : Program :=
  recoverPrefix L++BiasedInverse.unbiasView L++OneReuse.restoreRaw L

def inverse (L : BalancedCircuit.Layout) : Program :=
  inversePrefix L++[.CX L.r0 L.parity]++Q6Structural.rawSub L++[.CX L.rmsb L.one]

theorem forward_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    forward L=Q6Cell.forward L (L.carry.getD 254 0) := by
  rw [forward,Q6Cell.forward,Q6Cell.forwardCore,Q6Cell.forwardPrefix,
    Q6CleanupBorrow.cleanup,Q6ComparatorBorrow.borrowed,Q6Cell.rawAdd]
  rw [Q6Structural.rawAdd_eq L hw hn,Q6Structural.compareForward_eq L hw hn]
  rfl

theorem inverse_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    inverse L=Q6Cell.inverse L (L.carry.getD 254 0) := by
  rw [inverse,Q6Cell.inverse,Q6Cell.inversePrefix,Q6CleanupBorrow.recoverPrefix,
    Q6ComparatorBorrow.borrowed,Q6Cell.rawSub]
  rw [Q6Structural.rawSub_eq L hw hn,Q6Structural.compareInverse_eq L hw hn]
  rfl

theorem cleanup_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (cleanup L)=cleanup (mapCircuit f L) := by
  simp only [cleanup,FifthCarry2.cleanupRest,BalancedCleanup.unnormalize,BalancedCleanup.prepareCompare,
    rename_append,rename_reverse,Q6Structural.compareForward_natural,prepareSign_natural,literalConstAdd_natural,
    rotateLeft_natural,signComplement_natural,low_map,r_map,y_map,List.map_take]
  simp only [exposure,expose,mapCircuit,mapCleanup,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
    BalancedCleanup.Layout.y,List.map_append,List.map_cons,List.map_nil,renameProgram,renameInstr]

theorem recoverPrefix_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (recoverPrefix L)=recoverPrefix (mapCircuit f L) := by
  simp only [recoverPrefix,CarryBorrow.recoverBefore,BalancedCleanup.normalize,BalancedCleanup.prepareCompare,
    rename_append,rename_reverse,Q6Structural.compareInverse_natural,prepareSign_natural,literalConstAdd_natural,
    rotateLeft_natural,signComplement_natural,low_map,r_map,y_map,List.map_take]
  simp only [exposure,expose,mapCircuit,mapCleanup,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
    BalancedCleanup.Layout.y,List.map_append,List.map_cons,List.map_nil,renameProgram,renameInstr]

theorem forward_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    renameProgram f (forward L)=forward (mapCircuit f L) := by
  have hy:L.ylow≠[] := by intro eq;have h:=hw.2.1;rw [eq] at h;simp at h
  simp only [forward,forwardPrefix,rename_append,GuardCompression.seed_natural f L hy,
    Q6Structural.rawAdd_natural,OneReuse.remainder_natural f L hw,cleanup_natural]
  rfl

theorem inverse_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    renameProgram f (inverse L)=inverse (mapCircuit f L) := by
  simp only [inverse,inversePrefix,rename_append,recoverPrefix_natural,
    ShortKernelDependencies.bi_unbiasView_natural f L hw,OneReuse.restoreRaw_natural,Q6Structural.rawSub_natural]
  simp only [mapCircuit,mapCleanup,renameProgram,renameInstr,List.map_cons,List.map_nil,List.map_append]

theorem carry_widths (L : BalancedCircuit.Layout) (hw : L.Widths) : (carryLayout L).Widths := by
  exact ⟨hw.1,hw.2.1,by simp [carryLayout,q6Carry,List.length_take,List.length_drop,hw.2.2]⟩

theorem carry_take (L : BalancedCircuit.Layout) (hw : L.Widths) :
    (carryLayout L).carry.take 254=L.carry.take 254 := by
  simp [carryLayout,q6Carry,List.take_append,List.take_take,List.length_take,hw.2.2]

private theorem unchanged (L : BalancedCircuit.Layout) (hw : L.Widths) :
    OneReuse.remainder (carryLayout L)=OneReuse.remainder L ∧
    OneReuse.restoreRaw (carryLayout L)=OneReuse.restoreRaw L ∧
    FifthCarry2.cleanupRest (carryLayout L)=FifthCarry2.cleanupRest L ∧
    CarryBorrow.recoverBefore (carryLayout L)=CarryBorrow.recoverBefore L := by
  simp only [OneReuse.remainder,OneReuse.restoreRaw,FifthCarry2.cleanupRest,CarryBorrow.recoverBefore,
    OneReuse.foldWindow,OneReuse.unfoldWindow,BalancedCleanup.normalize,BalancedCleanup.unnormalize,
    carry_take L hw]
  constructor
  · rfl
  constructor
  · rfl
  constructor <;> rfl

private theorem exposure_support (L : BalancedCircuit.Layout) :
    wires (exposure L)⊆(carryLayout L).wires.toFinset := by
  intro q h
  simp only [exposure,expose,wires,Instr.wires,Finset.mem_union,Finset.mem_insert,
    Finset.mem_singleton,Finset.notMem_empty,or_false] at h
  simp only [List.mem_toFinset,carryLayout,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
    BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,
    List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
  tauto

section
attribute [local irreducible] wires FifthCarry.rawAdd OneReuse.remainder GuardCompression.seed
  BalancedCleanup.prepareCompare BalancedCleanup.prepareSign BalancedCleanup.unnormalize
  CarryBorrow.program TopCarryBorrow.program BiasedInverse.unbiasView OneReuse.restoreRaw

theorem forward_support (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (forward L)⊆(carryLayout L).wires.toFinset := by
  have old:=FifthCarry2.forward_support (carryLayout L) (carry_widths L hw)
  have ex:=exposure_support L
  have seed : GuardCompression.seed (carryLayout L)=GuardCompression.seed L := by unfold GuardCompression.seed; rfl
  have prep : BalancedCleanup.prepareCompare (carryLayout L).toLayout=BalancedCleanup.prepareCompare L.toLayout := by unfold BalancedCleanup.prepareCompare; rfl
  have view : BiasedInverse.unbiasView (carryLayout L)=BiasedInverse.unbiasView L := by unfold BiasedInverse.unbiasView BalancedCleanup.prepareSign; rfl
  simp only [FifthCarry2.forward,FifthCarry2.forwardCore,FifthCarry2.forwardPrefix,FifthCarry2.cleanup,
    wires_append,Finset.union_subset_iff,(unchanged L hw).1,(unchanged L hw).2.2.1,seed,prep] at old
  simp only [forward,forwardPrefix,cleanup,Q6Structural.rawAdd,Q6Structural.compareForward,
    wires_append,wires_reverse,Finset.union_subset_iff]
  tauto

theorem inverse_support (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (inverse L)⊆(carryLayout L).wires.toFinset := by
  have old:=FifthCarry2.inverse_support (carryLayout L) (carry_widths L hw)
  have ex:=exposure_support L
  have seed : GuardCompression.seed (carryLayout L)=GuardCompression.seed L := by unfold GuardCompression.seed; rfl
  have prep : BalancedCleanup.prepareCompare (carryLayout L).toLayout=BalancedCleanup.prepareCompare L.toLayout := by unfold BalancedCleanup.prepareCompare; rfl
  have view : BiasedInverse.unbiasView (carryLayout L)=BiasedInverse.unbiasView L := by unfold BiasedInverse.unbiasView BalancedCleanup.prepareSign; rfl
  simp only [FifthCarry2.inverse,FifthCarry.inversePrefix,CarryBorrow.recoverPrefix,
    wires_append,Finset.union_subset_iff,(unchanged L hw).2.1,(unchanged L hw).2.2.2,prep,view,wires_reverse] at old
  simp only [inverse,inversePrefix,recoverPrefix,Q6Structural.rawSub,Q6Structural.compareInverse,
    wires_append,wires_reverse,Finset.union_subset_iff]
  tauto

end


theorem carryLayout_away (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 254 0∉(carryLayout L).wires := by
  let a := L.carry.getD 254 0
  have idx : 254<L.carry.length := by rw [hw.2.2];omega
  have am : a∈L.carry := by
    dsimp [a];rw [List.getD_eq_getElem _ _ idx];exact List.getElem_mem _
  have nd : (L.lower::L.carry++Q6Structural.core L).Nodup := by
    apply List.nodup_iff_count.mpr;intro q
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    simp only [Q6Structural.core,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,
      List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have low : L.lower∉L.carry := fun h=>(List.nodup_cons.mp nd).1 (List.mem_append_left _ h)
  have nc : a∉Q6Structural.core L := fun h=>
    List.disjoint_left.mp (List.nodup_append'.mp (List.nodup_cons.mp nd).2).2.2 am h
  have cm : L.carry.map (Equiv.swap a L.lower)=q6Carry L :=
    congrArg BalancedCleanup.Layout.carry (congrArg BalancedCircuit.Layout.toLayout (Q6Structural.map_swap L hw hn))
  have ncarry : a∉q6Carry L := by
    rw [←cm]
    intro h
    obtain ⟨q,hq,e⟩:=List.mem_map.mp h
    have back : Equiv.swap a L.lower L.lower=a := Equiv.swap_apply_right _ _
    have same:q=L.lower := (Equiv.swap a L.lower).injective (e.trans back.symm)
    exact low (same ▸ hq)
  intro used
  have choices : a=L.lower ∨ a∈q6Carry L ∨ a∈Q6Structural.core L := by
    simp only [carryLayout,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
      BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,
      List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at used
    simp only [Q6Structural.core,List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
    tauto
  rcases choices with h|h|h
  · exact low (h ▸ am)
  · exact ncarry h
  · exact nc h

theorem forward_retired_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 254 0∉wires (forward L) := fun h=>
  carryLayout_away L hw hn (List.mem_toFinset.mp (forward_support L hw h))

theorem inverse_retired_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 254 0∉wires (inverse L) := fun h=>
  carryLayout_away L hw hn (List.mem_toFinset.mp (inverse_support L hw h))


theorem kernel_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (forward L)=1020 ∧ measurementCount (forward L)=1021 ∧
    toffoliCount (inverse L)=1020 ∧ measurementCount (inverse L)=1021 := by
  have old:=FifthCarry2.kernel_counts (carryLayout L) (carry_widths L hw)
  have seed : GuardCompression.seed (carryLayout L)=GuardCompression.seed L := rfl
  have prep : BalancedCleanup.prepareCompare (carryLayout L).toLayout=BalancedCleanup.prepareCompare L.toLayout := rfl
  have view : BiasedInverse.unbiasView (carryLayout L)=BiasedInverse.unbiasView L := rfl
  simp only [FifthCarry2.forward,FifthCarry2.forwardCore,FifthCarry2.forwardPrefix,FifthCarry2.cleanup,
    FifthCarry2.inverse,FifthCarry.inversePrefix,CarryBorrow.recoverPrefix,
    toffoliCount_append,measurementCount_append,toffoliCount_reverse,measurementCount_reverse,
    (unchanged L hw).1,(unchanged L hw).2.1,(unchanged L hw).2.2.1,(unchanged L hw).2.2.2,seed,prep,view] at old
  simp only [forward,forwardPrefix,cleanup,inverse,inversePrefix,recoverPrefix,
    Q6Structural.rawAdd,Q6Structural.rawSub,Q6Structural.compareForward,Q6Structural.compareInverse,
    toffoliCount_append,measurementCount_append,toffoliCount_reverse,measurementCount_reverse,
    exposure,expose,toffoliCount,measurementCount]
  simpa only [carryLayout,Nat.add_zero,Nat.zero_add,List.length_map] using old

theorem forward_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (forward L)=toffoliCount (FifthCarry2.forward L) ∧
    measurementCount (forward L)=measurementCount (FifthCarry2.forward L) := by
  have a:=kernel_counts L hw
  have b:=FifthCarry2.kernel_counts L hw
  exact ⟨a.1.trans b.1.symm,a.2.1.trans b.2.1.symm⟩

theorem inverse_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (inverse L)=toffoliCount (FifthCarry2.inverse L) ∧
    measurementCount (inverse L)=measurementCount (FifthCarry2.inverse L) := by
  have a:=kernel_counts L hw
  have b:=FifthCarry2.kernel_counts L hw
  exact ⟨a.2.2.1.trans b.2.2.1.symm,a.2.2.2.trans b.2.2.2.symm⟩


private theorem carry_subset (L : BalancedCircuit.Layout) : (carryLayout L).wires⊆L.wires := by
  intro q h
  have tc : q∈L.carry.take 254 → q∈L.carry := List.mem_of_mem_take
  have dc : q∈L.carry.drop 255 → q∈L.carry := List.mem_of_mem_drop
  simp only [carryLayout,q6Carry,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
    BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,
    List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at h ⊢
  tauto

theorem unused_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus,L.minus]) :
    q∉wires (forward L) ∧ q∉wires (inverse L) := by
  have ff : forward (FifthCarry2.resetUnused L)=forward L := rfl
  have ii : inverse (FifthCarry2.resetUnused L)=inverse L := rfl
  have f:=forward_support (FifthCarry2.resetUnused L) hw
  have i:=inverse_support (FifthCarry2.resetUnused L) hw
  rw [ff] at f
  rw [ii] at i
  exact ⟨fun h=>OneReuse.reset_unused_away L hn q hq (carry_subset _ (List.mem_toFinset.mp (f h))),
    fun h=>OneReuse.reset_unused_away L hn q hq (carry_subset _ (List.mem_toFinset.mp (i h)))⟩

private theorem resetLast_ignored (L : BalancedCircuit.Layout) (hw : L.Widths) :
    forward (FifthCarry.resetLast L)=forward L ∧ inverse (FifthCarry.resetLast L)=inverse L := by
  simp only [forward,forwardPrefix,cleanup,inverse,inversePrefix,recoverPrefix,
    Q6Structural.rawAdd,Q6Structural.rawSub,Q6Structural.compareForward,Q6Structural.compareInverse,
    FifthCarry.rawAdd,FifthCarry2.rawSub,FifthCarry2.borrowedCarry,CarryBorrow.program,TopCarryBorrow.program,
    OneReuse.remainder,OneReuse.restoreRaw,OneReuse.foldWindow,OneReuse.unfoldWindow,
    CarryBorrow.recoverBefore,FifthCarry2.cleanupRest,BalancedCleanup.normalize,BalancedCleanup.unnormalize]
  simp only [carryLayout,q6Carry,FifthCarry.resetLast,exposure]
  simp [List.take_append,List.take_take,List.length_take,hw.2.2,List.drop_append]
  constructor <;> rfl

theorem kernels_last_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 255 0∉wires (forward L) ∧ L.carry.getD 255 0∉wires (inverse L) := by
  have f:=forward_support (FifthCarry.resetLast L) (FifthCarry.resetLast_widths L hw)
  have i:=inverse_support (FifthCarry.resetLast L) (FifthCarry.resetLast_widths L hw)
  rw [(resetLast_ignored L hw).1] at f
  rw [(resetLast_ignored L hw).2] at i
  exact ⟨fun h=>FifthCarry.resetLast_away L hw hn (carry_subset _ (List.mem_toFinset.mp (f h))),
    fun h=>FifthCarry.resetLast_away L hw hn (carry_subset _ (List.mem_toFinset.mp (i h)))⟩

theorem forward_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (forward L)=Challenge.gateSlots (FifthCarry2.forward (carryLayout L))+6 := by
  have seed : GuardCompression.seed (carryLayout L)=GuardCompression.seed L := rfl
  have prep : BalancedCleanup.prepareCompare (carryLayout L).toLayout=BalancedCleanup.prepareCompare L.toLayout := rfl
  have es : Challenge.gateSlots (exposure L)=3 := rfl
  simp only [forward,forwardPrefix,cleanup,FifthCarry2.forward,FifthCarry2.forwardCore,FifthCarry2.forwardPrefix,
    FifthCarry2.cleanup,Q6Structural.rawAdd,Q6Structural.compareForward,
    Challenge.gateSlots_append,Baselines.reverse_gateSlots,es,
    (unchanged L hw).1,(unchanged L hw).2.2.1,seed,prep]
  simp only [carryLayout]
  omega

theorem inverse_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (inverse L)=Challenge.gateSlots (FifthCarry2.inverse (carryLayout L))+6 := by
  have prep : BalancedCleanup.prepareCompare (carryLayout L).toLayout=BalancedCleanup.prepareCompare L.toLayout := rfl
  have view : BiasedInverse.unbiasView (carryLayout L)=BiasedInverse.unbiasView L := rfl
  have es : Challenge.gateSlots (exposure L)=3 := rfl
  simp only [inverse,inversePrefix,recoverPrefix,FifthCarry2.inverse,FifthCarry.inversePrefix,CarryBorrow.recoverPrefix,
    Q6Structural.rawSub,Q6Structural.compareInverse,Challenge.gateSlots_append,Baselines.reverse_gateSlots,es,
    (unchanged L hw).2.1,(unchanged L hw).2.2.2,prep,view]
  simp only [carryLayout]
  omega

end ECDSAAdd.Entrant.Q6StructuralCell

set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
namespace ECDSAAdd.Entrant.OwnQ6Core5
open Arithmetic Secp256k1 BalancedField BalancedCircuit

/-- One-bank cleanup after the checked narrow core. -/
def forward (L : Layout) : Program :=
  LaneI.coreProgramI L ++ BalancedCleanup.program L.toLayout ++ [.CX L.ymsb L.sourceGuard]

def kernel (divide : Bool) (L : Layout) : Program :=
  if divide then Q6StructuralCell.forward L else Q6StructuralCell.inverse L

def oldKernel (divide : Bool) (L : Layout) : Program :=
  if divide then BalancedCircuit.program L else BalancedInverse.program L

theorem counts (divide : Bool) (L : Layout) (hw : L.Widths) :
    toffoliCount (kernel divide L)=1020 ∧ measurementCount (kernel divide L)=1021 := by
  have h:=Q6StructuralCell.kernel_counts L hw
  cases divide
  · exact ⟨h.2.2.1,h.2.2.2⟩
  · exact ⟨h.1,h.2.1⟩

theorem state_eq (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m m' : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (kernel divide L) m s=run (oldKernel divide L) m' s := by
  have idx : 254<L.carry.length := by rw [hw.2.2];omega
  have mem : L.carry.getD 254 0∈L.carry := by
    rw [List.getD_eq_getElem _ _ idx];exact List.getElem_mem _
  have eq : run (kernel divide L) m s=run (OneBankCore5.kernel divide L) m s := by
    cases divide
    · simp only [kernel,OneBankCore5.kernel,Bool.false_eq_true,if_false]
      rw [Q6StructuralCell.inverse_eq L hw hn]
      exact Q6Cell.inverse_eq L hw hn _ mem B X Y hx hy s m hs hr hyr hc
    · simp only [kernel,OneBankCore5.kernel,if_true]
      rw [Q6StructuralCell.forward_eq L hw hn]
      exact Q6Cell.forward_eq L hw hn _ mem B X Y hx hy s m hs hr hyr hc
  exact eq.trans (OneBankCore5.state_eq divide L hw hn B X Y hx hy s m m' hs hr hyr hc)

theorem work_away (L : Layout) (hn : L.wires.Nodup) (q : Wire)
    (hq : q∈work L) : q∉L.r ∧ q∉L.y := by
  have h := List.nodup_iff_count.mp (allND L hn) q
  have hw := List.count_pos_iff.mpr hq
  constructor <;> intro hd <;> have hc := List.count_pos_iff.mpr hd
  all_goals
    simp only [work,List.count_append,List.count_cons,List.count_nil] at h hw
    omega

theorem sign_work (L : Layout) (hn : L.wires.Nodup) : L.sign∉work L := by
  have nd : (L.sign::work L).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [Layout.wires,BalancedCleanup.Layout.wires,work,List.count_append,
      List.count_cons,List.count_nil] at h ⊢
    omega
  exact (List.nodup_cons.mp nd).1

def half (divide : Bool) (L : Layout) : Program :=
  [.X L.sign]++kernel divide L++[.X L.sign]

def oldHalf (divide : Bool) (L : Layout) : Program :=
  [.X L.sign]++oldKernel divide L++[.X L.sign]

/-- Complete State equality, for each independent incoming phase and record. -/
theorem half_eq (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (base : BasisState) (hc : ∀q∈work L,base q=false) (X Y : Fp)
    (s : State) (m : List Bool)
    (h : PairFrame L.r L.y base (centerWord X) (centerWord Y) s.basis) :
    run (half divide L) m s=run (oldHalf divide L) m s := by
  have aw := flagAway L hn L.sign (by simp)
  have sa : L.sign∉L.r ∧ L.sign∉L.y :=
    ⟨fun h => aw (by simp [h]),fun h => aw (by simp [h])⟩
  unfold half oldHalf
  rw [List.append_assoc,List.append_assoc]
  apply LaneI.seq_eq _ _ _ _ s m rfl rfl
  generalize eu : run [.X L.sign] (m.take (measurementCount [.X L.sign])) s=u
  have us := BalancedCleanupOffset.x_run L.sign s (m.take (measurementCount [.X L.sign]))
  rw [eu] at us
  have uf (q : Wire) (hq : q≠L.sign) : u.basis q=s.basis q := by
    rw [us]
    simp only [writeBit,Function.update_of_ne hq]
  have ug : u.basis L.sign= !base L.sign := by
    rw [us]
    simp only [writeBit,Function.update_self,h.2.2 L.sign sa.1 sa.2]
  have uv (r : List Wire) (a : L.sign∉r) : regValue r u.basis=regValue r s.basis :=
    regValue_congr _ _ _ (fun q hq => uf q (fun e => a (e ▸ hq)))
  have ur : signedRegValue L.r u.basis=centerFp X := by
    rw [signedRegValue,uv L.r sa.1,h.1,(BalancedCleanup.widths L.toLayout hw).2.1,centerWord_decode]
  have uy : signedRegValue L.y u.basis=centerFp Y := by
    rw [signedRegValue,uv L.y sa.2,h.2.1,(BalancedCleanup.widths L.toLayout hw).2.2.1,centerWord_decode]
  have uc : ∀q∈work L,u.basis q=false := by
    intro q hq
    have a := work_away L hn q hq
    exact (uf q (fun e => sign_work L hn (e ▸ hq))).trans
      ((h.2.2 q a.1 a.2).trans (hc q hq))
  rw [run_append, run_append]
  have qx : ∀ (r1 r2 : List Bool) (t : State), run [Instr.X L.sign] r1 t = run [Instr.X L.sign] r2 t := by
    intro r1 r2 t; rfl
  rw [qx _ (List.drop (measurementCount (oldKernel divide L)) _),
    state_eq divide L hw hn (!base L.sign) (centerFp X) (centerFp Y)
    (centerFp_bounds X) (centerFp_bounds Y) u _ _ ug ur uy uc]

section Natural
open FieldRename
attribute [local irreducible] literalConstAdd compareLt rotateLeft rotateRight signComplement
  addInPlace subInPlace mappedAdd mappedSub

theorem cleanup_natural (f : Wire → Wire) (L : BalancedCleanup.Layout) :
    renameProgram f (BalancedCleanup.program L)=BalancedCleanup.program (mapCleanup f L) := by
  simp only [BalancedCleanup.program,BalancedCleanup.normalize,BalancedCleanup.unnormalize,
    BalancedCleanup.prepareCompare,rename_append,rename_reverse,prepareSign_natural,
    literalConstAdd_natural,rotateLeft_natural,signComplement_natural,compareLt_natural,
    low_map,r_map,y_map,List.map_take]
  rfl

theorem bits_natural (f : Wire → Wire) (L : Layout) :
    (LaneI.foldBitsI L).map (mapBit f)=LaneI.foldBitsI (mapCircuit f L) := by
  simp only [LaneI.foldBitsI,List.map_map]
  congr 1
  funext i
  dsimp [Function.comp_def,mapBit,mapCircuit]
  split_ifs <;> rfl

theorem fold_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (LaneI.foldI L)=LaneI.foldI (mapCircuit f L) ∧
    renameProgram f (LaneI.undoFoldI L)=LaneI.undoFoldI (mapCircuit f L) := by
  constructor <;>
    simp only [LaneI.foldI,LaneI.undoFoldI,rename_append,mappedAdd_natural,mappedSub_natural,
      bits_natural,foldTarget_map]
  all_goals
    simp only [mapCircuit,mapCleanup,List.map_take,renameProgram,List.map_cons,List.map_nil,renameInstr]

theorem kernel_natural (f : Wire → Wire) (divide : Bool) (L : Layout) (hy : L.ylow≠[])
    (hw : L.Widths) :
    renameProgram f (kernel divide L)=kernel divide (mapCircuit f L) := by
  cases divide
  · simpa only [kernel,Bool.false_eq_true,if_false] using Q6StructuralCell.inverse_natural f L hw
  · simpa only [kernel,if_true] using Q6StructuralCell.forward_natural f L hw

end Natural

theorem carry_inside (L : Layout) :
    (Q6Structural.carryLayout L).wires.toFinset⊆L.wires.toFinset := by
  intro q hq
  have takeMem : q∈L.carry.take 254→q∈L.carry := List.mem_of_mem_take
  have dropMem : q∈L.carry.drop 255→q∈L.carry := List.mem_of_mem_drop
  simp only [List.mem_toFinset,Q6Structural.carryLayout,Q6Structural.q6Carry,
    Layout.wires,BalancedCleanup.Layout.wires,List.mem_cons,List.mem_append,
    List.not_mem_nil,or_false] at hq ⊢
  tauto

theorem support (divide : Bool) (L : Layout) (hw : L.Widths) :
    wires (kernel divide L)⊆L.wires.toFinset := by
  cases divide
  · exact (Q6StructuralCell.inverse_support L hw).trans (carry_inside L)
  · exact (Q6StructuralCell.forward_support L hw).trans (carry_inside L)

section Slots
open Baselines Challenge

theorem cleanup_gateSlots_le (L : BalancedCleanup.Layout) (hw : L.Widths) :
    gateSlots (BalancedCleanup.program L)≤13000 := by
  have w := BalancedCleanup.widths L hw
  have a := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.negativeLiteral
  have b := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.positiveLiteral
  have r := (rotate_gateSlots_le L.r).2
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  rw [w.1] at a b
  rw [w.2.1] at r
  rw [w.2.1,w.2.2.1] at c
  simp only [BalancedCleanup.program,BalancedCleanup.prepareSign,BalancedCleanup.normalize,
    BalancedCleanup.unnormalize,BalancedCleanup.prepareCompare,gateSlots_append,reverse_gateSlots,
    signComplement_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,w.2.1,w.2.2.1]
  omega

theorem kernel_gateSlots_le (divide : Bool) (L : Layout) (hw : L.Widths) :
    gateSlots (kernel divide L)≤(if divide then 24000 else 25000) := by
  cases divide
  · simp only [kernel,Bool.false_eq_true,if_false,Q6StructuralCell.inverse_slots L hw]
    have h:=FifthCarry2.q6_inverse_slots_tight (Q6Structural.carryLayout L) (Q6StructuralCell.carry_widths L hw)
    omega
  · simp only [kernel,if_true,Q6StructuralCell.forward_slots L hw]
    have h:=FifthCarry2.q6_forward_slots_tight (Q6Structural.carryLayout L) (Q6StructuralCell.carry_widths L hw)
    omega

end Slots

def body (divide : Bool) (L : Layout) (eff : Wire) : Program :=
  if divide then half true L++swapRegisters eff L.r L.y
  else swapRegisters eff L.r L.y++half false L

def oldBody (divide : Bool) (L : Layout) (eff : Wire) : Program :=
  if divide then balancedTranscriptBody L eff else balancedInverseTranscriptBody L eff

theorem body_support (divide : Bool) (L : Layout) (eff : Wire) (hw : L.Widths) :
    wires (body divide L eff)⊆(eff::L.wires).toFinset := by
  have h:=ShortBiasedProperties.body_support divide L eff hw (kernel divide L) (support divide L hw)
  cases divide <;> simpa only [body,half,Bool.false_eq_true,if_false,if_true] using h

theorem kernel_unused_free (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus,L.minus]) : q∉wires (kernel divide L) := by
  cases divide
  · exact (Q6StructuralCell.unused_free L hw hn q hq).2
  · exact (Q6StructuralCell.unused_free L hw hn q hq).1

theorem kernel_last_free (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 255 0∉wires (kernel divide L) := by
  cases divide
  · exact (Q6StructuralCell.kernels_last_free L hw hn).2
  · exact (Q6StructuralCell.kernels_last_free L hw hn).1

theorem kernel_retired_free (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 254 0∉wires (kernel divide L) := by
  cases divide
  · exact Q6StructuralCell.inverse_retired_free L hw hn
  · exact Q6StructuralCell.forward_retired_free L hw hn

theorem kernel_physical (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (kernel divide L) := by
  cases divide
  · simp only [kernel,Bool.false_eq_true,if_false]
    rw [Q6StructuralCell.inverse_eq L hw hn]
    exact Q6Resources.inverse_physical L hw hn _
  · simp only [kernel,if_true]
    rw [Q6StructuralCell.forward_eq L hw hn]
    exact Q6Resources.forward_physical L hw hn _

end ECDSAAdd.Entrant.OwnQ6Core5
