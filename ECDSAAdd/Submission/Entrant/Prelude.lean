    (ArithmeticOB5.logical_sub_old (hp used)) (base 766) slot mapped
  exact free (back ▸ used)

theorem pfix_avoid766 (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.core.poolWire 766∉wires (pfix L) := by
