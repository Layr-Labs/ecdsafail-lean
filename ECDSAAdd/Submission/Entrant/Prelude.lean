  obtain ⟨r1,r2,r3,r4,rt,c0,c1,c2,c3,ct,hr,hct,e0,e1,e2,e3,f0,f1,f2,f3⟩ := atoms L hw
  have ndr := EntryHalf5.target_nodup L hn
  rw [hr] at ndr hq
