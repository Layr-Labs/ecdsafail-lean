  simp only [padded,kernel,wires_append,Finset.mem_union,renameProgram_support] at hq
  rcases hq with hq|hq
  · obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hq
    by_cases a719 : a=base 719
