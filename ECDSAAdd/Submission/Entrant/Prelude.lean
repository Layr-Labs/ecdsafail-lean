  simp only [Metrics] at body ⊢
  simp only [placedFirstPacket,firstPacket,Prefix1590.placedFirstPacket,Prefix1590.firstPacket,
    Prefix1590.baseFirstPacket,toffoliCount_append,measurementCount_append,gateSlots_append,
