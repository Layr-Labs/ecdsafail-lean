theorem ids_shared (j : Nat) (hj : j∈ids) : j=2312 ∨ j∈sharedIds := by
  simp only [ids,sharedIds,balancedSharedIds,List.mem_append,List.mem_cons,
    List.not_mem_nil,List.mem_range'_1,or_false] at hj ⊢
