    toffoliCount (fastNeg K g p k)=3*n-2 ∧ measurementCount (fastNeg K g p k)=3*n-1 := by
  have m1 := maskedConstant_counts g K.src (2^K.out.length-1-k)
  have m2 := maskedConstant_counts g K.src (k+1)
