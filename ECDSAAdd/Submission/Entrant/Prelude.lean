theorem cell_support (divide : Bool) (w : Nat → Wire) (b g sw sign eff : Wire) (ig is : Bool)
    (W : Finset Wire) (hi : (sign::ids.map w).toFinset⊆W)
    (hb : b∈W) (hg : g∈W) (hs : sw∈W) (he : eff∈W) :
    wires (cell divide w b g sw sign eff ig is)⊆W := by
