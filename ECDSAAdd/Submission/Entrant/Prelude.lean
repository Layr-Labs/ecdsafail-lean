section Flags
variable (L : ControlledPointLayout) (hn : L.wires.Nodup)
include hn

theorem genFlagN_run (s : State) (m : List Bool) :
    run (genFlagN L) m s = ⟨s.phase, writeBit s.basis L.genericSelect
      (((s.basis L.genericSelect ^^ (s.basis L.control && s.basis L.point.finite)) ^^
        s.basis L.doubleSelect) ^^ s.basis L.core.equalNegY)⟩ := by
  have sep := dialogFlag_separation L hn
  simp only [inPlaceFlags, List.nodup_cons, List.mem_cons, not_or] at sep
  have hfin : L.point.finite ∉ L.control :: L.inPlaceFlags := by
    have hh := List.nodup_iff_count_le_one.mp (L.dialogUsed_nodup hn) L.point.finite
    have hp : 1 ≤ (PointAddLayout.pointWires L.point).count L.point.finite :=
      List.count_pos_iff.mpr (by simp [PointAddLayout.pointWires])
    simp only [dialogUsedWires, List.count_append] at hh
    have hc : (L.control :: L.inPlaceFlags).count L.point.finite = 0 := by
      show ([L.control] ++ L.inPlaceFlags).count _ = 0
      rw [List.count_append]; omega
    exact List.count_eq_zero.mp hc
  simp only [inPlaceFlags, List.mem_cons, not_or] at hfin
  have h1 : L.control ≠ L.genericSelect := by tauto
  have h2 : L.point.finite ≠ L.genericSelect := by tauto
  have h3 : L.doubleSelect ≠ L.genericSelect := by tauto
  have h5 : L.core.equalNegY ≠ L.genericSelect := by tauto
  simp only [genFlagN, run]
  congr 1
  funext q
  by_cases hq : q = L.genericSelect
  · subst hq; simp [writeBit, h1, h2, h3, h5]
  · simp [writeBit, hq]

theorem genFlagN_flag (R : Point) (b O D I G E H K : Bool) :
    Triple (PointDialogBoundary L R b (dialogFlagState L O D I G E H K)) (genFlagN L)
      (PointDialogBoundary L R b (dialogFlagState L O D
        (((I ^^ (b && pointFinite R)) ^^ D) ^^ H) G E H K)) := by
  have hr := dialogFlagState_read L hn O D I G E H K
  intro s m v
  have hh := genFlagN_run L hn s m
  have hfin : s.basis L.point.finite = pointFinite R := ((point_holds _ _ _).mp v.point).1
  have rd (q : Wire) (hq : q ∈ L.inPlaceFlags) : s.basis q = dialogFlagState L O D I G E H K q := v.flags q hq
  have eD := rd L.doubleSelect (by simp [inPlaceFlags])
  have eI := rd L.genericSelect (by simp [inPlaceFlags])
  have eH := rd L.core.equalNegY (by simp [inPlaceFlags])
  rw [hr.2.1] at eD; rw [hr.2.2.1] at eI; rw [hr.2.2.2.2.2.1] at eH
  rw [eD, eI, eH, hfin, v.control] at hh
  refine ⟨by rw [hh], v.withFlags hn ?_ ?_⟩
  · intro q hq
    rw [hh]
    have u := (dialogFlagState_update L hn O D I G E H K
      (((I ^^ (b && pointFinite R)) ^^ D) ^^ H)).2.2.1 q hq
    rw [← u]
    by_cases he : q = L.genericSelect
    · subst he; simp [writeBit]
    · simp [writeBit, he, rd q hq]
  · intro q hq
    rw [hh]
    have hqt : q ≠ L.genericSelect := fun he => hq (he ▸ by simp [inPlaceFlags])
    simp [writeBit, hqt]

end Flags

section Fold
variable (L : ControlledPointLayout) (hn : L.wires.Nodup)
include hn

                                                                                          
                                    
                                        
                                                                         
                                              
































/-- A state that changes only control and flags keeps the point and the pool. -/
theorem boundary_upd {R : Point} {b b' : Bool} {f f' s t : BasisState}
    (v : PointDialogBoundary L R b f s)
    (ht : ∀ q, q ≠ L.control → q ∉ L.inPlaceFlags → t q = s q) (hc : t L.control = b')
    (hf : ∀ q ∈ L.inPlaceFlags, t q = f' q) : PointDialogBoundary L R b' f' t := by
  have pt (q : Wire) (hq : q ∈ PointAddLayout.pointWires L.point) : q ≠ L.control ∧ q ∉ L.inPlaceFlags := by
    have used := List.nodup_iff_count.mp (L.dialogUsed_nodup hn) q
    have a := List.count_pos_iff.mpr hq
    simp only [dialogUsedWires, List.count_append] at used
    refine ⟨fun e => ?_, fun e => ?_⟩
    · have : 0 < List.count q [L.control] := List.count_pos_iff.mpr (by simp [e])
      omega
    · have := List.count_pos_iff.mpr e; omega
  have pl (q : Wire) (hq : q ∈ L.dialogPool) : q ≠ L.control ∧ q ∉ L.inPlaceFlags := by
    have used := List.nodup_iff_count.mp (L.dialogUsed_nodup hn) q
    have a := List.count_pos_iff.mpr hq
    simp only [dialogUsedWires, List.count_append] at used
    refine ⟨fun e => ?_, fun e => ?_⟩
    · have : 0 < List.count q [L.control] := List.count_pos_iff.mpr (by simp [e])
      omega
    · have := List.count_pos_iff.mpr e; omega
  have hpt (q : Wire) (hq : q ∈ PointAddLayout.pointWires L.point) : t q = s q :=
    ht q (pt q hq).1 (pt q hq).2
  have hp := (point_holds _ _ _).mp v.point
  refine ⟨(point_holds _ _ _).mpr ⟨?_, ?_, ?_⟩, hc, hf, ?_⟩
  · rw [hpt _ (by simp [PointAddLayout.pointWires])]; exact hp.1
  · rw [regValue_congr L.point.x t s (fun q hq => hpt q (by simp [PointAddLayout.pointWires, hq]))]
    exact hp.2.1
  · rw [regValue_congr L.point.y t s (fun q hq => hpt q (by simp [PointAddLayout.pointWires, hq]))]
    exact hp.2.2
  · rw [regValue_congr L.dialogPool t s (fun q hq => ht q (pl q hq).1 (pl q hq).2)]
    exact v.clean

omit hn in
theorem state_other (D D' G H H' : Bool) (q : Wire)
    (hd : q ≠ L.doubleSelect) (he : q ≠ L.core.equalNegY) :
    dialogFlagState L false D G false false H false q = dialogFlagState L false D' G false false H' false q := by
  simp only [dialogFlagState, writeBit, Function.update_apply, hd, he, if_false]









































































end Fold

section DHFlag
variable (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)

include hw in
theorem dh_xk_mem (k : Nat) (hk : k < 256) : L.point.x.getD k 0 ∈ L.point.x := by
  have hl : k < L.point.x.length := by rw [show L.point.x.length = 256 from hw.inputX]; exact hk
  rw [List.getD_eq_getElem _ _ hl]; exact List.getElem_mem hl

include hw in
theorem dh_pool_mem (i : Nat) (hi : i < 3) : L.core.poolWire i ∈ L.dialogPool.take 3 := by
  rw [pool_block L hw 3 (by omega)]
  exact List.mem_map.mpr ⟨i, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩

include hw hn in
theorem dh_nodup (k : Nat) (hk : k < 256) :
    [L.point.finite, L.point.x.getD k 0, yLow L, L.control, L.doubleSelect, L.genericSelect,
      L.core.equalNegY, L.core.poolWire 0, L.core.poolWire 1, L.core.poolWire 2].Nodup := by
  have hxk : L.point.x.getD k 0 ∈ L.point.x := by
    have hl : k < L.point.x.length := by rw [show L.point.x.length = 256 from hw.inputX]; exact hk
    rw [List.getD_eq_getElem _ _ hl]; exact List.getElem_mem hl
  have hy0 : yLow L ∈ L.point.y := by
    have hl : 0 < L.point.y.length := by rw [show L.point.y.length = 256 from hw.inputY]; norm_num
    unfold yLow
    cases hy : L.point.y with
    | nil => rw [hy] at hl; simp at hl
    | cons a t => simp
  have hp3 : L.dialogPool.take 3 = [L.core.poolWire 0, L.core.poolWire 1, L.core.poolWire 2] := by
    rw [pool_block L hw 3 (by omega)]; rfl
  have sub : [L.point.finite, L.point.x.getD k 0, yLow L, L.control, L.doubleSelect, L.genericSelect,
      L.core.equalNegY, L.core.poolWire 0, L.core.poolWire 1, L.core.poolWire 2].Sublist L.dialogUsedWires := by
    have p1 : [L.point.finite, L.point.x.getD k 0, yLow L].Sublist (PointAddLayout.pointWires L.point) := by
      simp only [PointAddLayout.pointWires]
      exact List.Sublist.cons₂ _ ((List.singleton_sublist.mpr hxk).append (List.singleton_sublist.mpr hy0))
    have p2 : [L.doubleSelect, L.genericSelect, L.core.equalNegY].Sublist L.inPlaceFlags := by
      simp only [inPlaceFlags]
      exact .cons _ (.cons₂ _ (.cons₂ _ (.cons _ (.cons _ (.cons₂ _ (.cons _ .slnil))))))
    have p3 : [L.core.poolWire 0, L.core.poolWire 1, L.core.poolWire 2].Sublist L.dialogPool := by
      rw [← hp3]; exact List.take_sublist _ _
    have := ((p1.append (List.Sublist.refl [L.control])).append p2).append p3
    simpa only [dialogUsedWires, List.cons_append, List.nil_append, List.singleton_append,
      List.append_assoc] using this
  exact (L.dialogUsed_nodup hn).sublist sub

include hw hn in
theorem dh_flag (k : Nat) (hk : k < 256) (enD enH cx cy : Bool) (R : Point) (b D G H D' H' : Bool)
    (hD : D' = (D ^^ (enD && b && pointFinite R && !G && ((pointX R).testBit k == cx) &&
      (yBit R == cy))))
    (hH : H' = (H ^^ (enH && b && pointFinite R && !G && ((pointX R).testBit k != cx)))) :
    Triple (PointDialogBoundary L R b (dialogFlagState L false D G false false H false))
      (DHGadget.gadget L.control L.point.finite L.genericSelect L.doubleSelect L.core.equalNegY
        (L.point.x.getD k 0) (yLow L) (L.core.poolWire 0) (L.core.poolWire 1) (L.core.poolWire 2) enD enH cx cy)
      (PointDialogBoundary L R b (dialogFlagState L false D' G false false H' false)) := by
  intro s m v
  have nd := dh_nodup L hw hn k hk
  have pool3 : ∀ i, i < 3 → s.basis (L.core.poolWire i) = false := by
    intro i hi
    apply (regValue_zero _ _).mp v.clean
    have mem : L.core.poolWire i ∈ L.dialogPool.take 3 := by
      rw [pool_block L hw 3 (by omega)]
      exact List.mem_map.mpr ⟨i, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩
    exact List.mem_of_mem_take mem
  have run := DHGadget.gadget_run L.control L.point.finite L.genericSelect L.doubleSelect L.core.equalNegY
    (L.point.x.getD k 0) (yLow L) (L.core.poolWire 0) (L.core.poolWire 1) (L.core.poolWire 2) enD enH cx cy nd s m (pool3 0 (by omega))
    (pool3 1 (by omega)) (pool3 2 (by omega))
  have hr := dialogFlagState_read L hn false D G false false H false
  have hr' := dialogFlagState_read L hn false D' G false false H' false
  have pt := (point_holds _ _ _).mp v.point
  have vc := v.control
  have vd := (v.flags _ (by simp [inPlaceFlags])).trans hr.2.1
  have vg := (v.flags _ (by simp [inPlaceFlags])).trans hr.2.2.1
  have ve := (v.flags _ (by simp [inPlaceFlags])).trans hr.2.2.2.2.2.1
  have xbit : s.basis (L.point.x.getD k 0) = (pointX R).testBit k := by
    have hl : k < L.point.x.length := by rw [show L.point.x.length = 256 from hw.inputX]; exact hk
    have e := regValue_bit L.point.x k 0 s.basis hl
    rw [pt.2.1] at e
    rw [Nat.testBit_eq_decide_div_mod_eq]
    generalize s.basis (L.point.x.getD k 0) = v at e ⊢
    have h2 : pointX R / 2^k % 2 < 2 := Nat.mod_lt _ (by norm_num)
    cases v
    · simp only [Bool.toNat_false] at e; simp only [Bool.false_eq, decide_eq_false_iff_not]; omega
    · simp only [Bool.toNat_true] at e; simp only [Bool.true_eq, decide_eq_true_eq]; omega
  have ybit : s.basis (yLow L) = yBit R := by
    have hne : L.point.y ≠ [] := by
      intro e; have := (show L.point.y.length = 256 from hw.inputY); rw [e] at this; simp at this
    have e := regValue_headBit L.point.y hne s.basis
    rw [pt.2.2] at e
    have hh : yLow L = L.point.y.head! := by
      unfold yLow; cases hy : L.point.y with
      | nil => exact absurd hy hne
      | cons a t => rfl
    rw [hh, e]
    simp only [yBit]
    apply Bool.eq_iff_iff.mpr
    simp only [decide_eq_true_eq]
    omega
  have dg : L.doubleSelect ≠ L.core.equalNegY := by
    simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or] at nd; exact nd.2.2.2.2.1.2.1
  rw [run]
  refine ⟨rfl, boundary_upd L hn v ?_ ?_ ?_⟩
  · intro q hc hf
    have hd : q ≠ L.doubleSelect := fun e => hf (e ▸ by simp [inPlaceFlags])
    have he : q ≠ L.core.equalNegY := fun e => hf (e ▸ by simp [inPlaceFlags])
    simp [hd, he]
  · have cd : L.control ≠ L.doubleSelect := by
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or] at nd; exact nd.2.2.2.1.1
    have ch : L.control ≠ L.core.equalNegY := by
      simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or] at nd; exact nd.2.2.2.1.2.2.1
    simp [cd, ch, vc]
  · intro q hq
    by_cases hd : q = L.doubleSelect
    · rw [hd]; simp only [if_true]; rw [hr'.2.1, vd, vc, vg, xbit, ybit, pt.1, hD]
    by_cases he : q = L.core.equalNegY
    · rw [he]; simp only [if_neg (Ne.symm dg), if_true]; rw [hr'.2.2.2.2.2.1, ve, vc, vg, xbit, pt.1, hH]
    · simp only [hd, he, if_false]
      rw [v.flags q hq]
      exact state_other L D D' G H H' q hd he

include hw hn in
theorem clrDH_flag (C : Point) (cy : Fp) (R : Point) (b D G H D' H' : Bool)
    (hD : D' = (D ^^ (decide (cy≠-cy) && b && pointFinite R && !G &&
      ((pointX R).testBit (DHClass.kx C) == DHClass.cxk C) && (yBit R == yBit C))))
    (hH : H' = (H ^^ (exceptionBit C && b && pointFinite R && !G &&
      ((pointX R).testBit (DHClass.kx C) != DHClass.cxk C)))) :
    Triple (PointDialogBoundary L R b (dialogFlagState L false D G false false H false))
      (clrDH L C cy)
      (PointDialogBoundary L R b (dialogFlagState L false D' G false false H' false)) :=
  dh_flag L hw hn (DHClass.kx C) (DHClass.kx_lt C) _ _ _ _ R b D G H D' H' hD hH

