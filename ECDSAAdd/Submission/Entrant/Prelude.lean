      exact (hx q hq).symm
    · have hq' : q∉Finset.range 10 := fun h => hq (Finset.mem_range.mp h)
      rw [invV_outside _ _ q hq',V_outside _ _ q hq']

private theorem raw_to_codes (P : Program) (hs : wires P⊆Finset.range 10)
    (finite : ∀x<1024,x∈rawWords → safe P x=true ∧
      (bitRun P x).testBit 5=false ∧ (bitRun P x).testBit 9=false ∧
      codeOf (bitsOf (bitRun P x))∈canonicalCodes)
    (s : State) (m : List Bool) (member : rawCodeOf s.basis∈rawWords) :
    (run P m s).basis 5=false ∧ (run P m s).basis 9=false ∧
      codeOf (run P m s).basis∈canonicalCodes := by
  have f := finite (rawCodeOf s.basis) (rawCodeOf_lt s.basis) member
  have model := local_model P hs s m f.1
  refine ⟨(model.2 5 (by decide)).trans f.2.1,
    (model.2 9 (by decide)).trans f.2.2.1,?_⟩
  rw [codeOf_congr _ _ model.2]
  exact f.2.2.2

theorem raw_to_canonical_regular (s : State) (m : List Bool) (member : rawCodeOf s.basis∈rawWords) :
    (run ParityCodec5New.encode m s).basis 5=false ∧
    (run ParityCodec5New.encode m s).basis 9=false ∧
    codeOf (run ParityCodec5New.encode m s).basis∈canonicalCodes :=
  raw_to_codes _ ParityCodec5New.support.1 finite_raw_regular s m member

/-- Only these ten local ports are renamed. -/
def VAt (f : Fin 10→Wire) : Program := renameProgram (label f) V
def invVAt (f : Fin 10→Wire) : Program := renameProgram (label f) invV

def codeAt (f : Fin 10→Wire) (b : BasisState) : Nat := codeOf (fun q => b (label f q))
                                                                                                




theorem VAt_counts (f : Fin 10→Wire) : toffoliCount (VAt f)= 11 ∧ measurementCount (VAt f)= 5 := by
  simpa only [VAt,(renameProgram_counts (label f) V).1,
    (renameProgram_counts (label f) V).2] using V_counts

theorem invVAt_counts (f : Fin 10→Wire) : toffoliCount (invVAt f)= 11 ∧ measurementCount (invVAt f)= 5 := by
  simpa only [invVAt,(renameProgram_counts (label f) invV).1,
    (renameProgram_counts (label f) invV).2] using invV_counts

theorem VAt_slots (f : Fin 10→Wire) : gateSlots (VAt f)= 52 := by
  simpa only [VAt,rename_gateSlots] using V_slots

theorem invVAt_slots (f : Fin 10→Wire) : gateSlots (invVAt f)= 52 := by
  simpa only [invVAt,rename_gateSlots] using invV_slots

theorem VAt_support_exact (f : Fin 10→Wire) : wires (VAt f)=Finset.univ.image f := by
  calc
    wires (VAt f)=wires (ParityCodec5New.encodeAt f) := by
      simp only [VAt,ParityCodec5New.encodeAt,renameProgram_support,V_support_exact,
        ParityCodec5New.support_exact.1]
    _=Finset.univ.image f := (ParityCodec5New.supportAt_exact f).1

theorem invVAt_support_exact (f : Fin 10→Wire) : wires (invVAt f)=Finset.univ.image f := by
  calc
    wires (invVAt f)=wires (ParityCodec5New.encodeAt f) := by
      simp only [invVAt,ParityCodec5New.encodeAt,renameProgram_support,invV_support_exact,
        ParityCodec5New.support_exact.1]
    _=Finset.univ.image f := (ParityCodec5New.supportAt_exact f).1

                                                                                            
                                 
                                                                                                         

                                                                                                  
                                 
                                                                                                                  















































































