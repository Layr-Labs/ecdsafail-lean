theorem bi_restoreRaw_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (BiasedInverse.restoreRaw L)=BiasedInverse.restoreRaw (mapCircuit f L) := by
  have rm : (mapCircuit f L).r=L.r.map f := r_map f L.toLayout
  simp only [BiasedInverse.restoreRaw,BiasedInverse.unfoldBias,rename_append,
    bi_selectors_natural,mappedSub_natural,bi_biasBits_map,bi_release_natural,
    rotateLeft_natural,rawTarget_map,rm,List.map_take]
  rfl

/-- Relabeling uses the valid result width so the selected high bit is present. -/
theorem biasedInverse_natural (f : Wire → Wire) (L : BalancedCircuit.Layout)
    (hy : L.ylow ≠ []) (hw : L.Widths) :
    renameProgram f (BiasedInverse.program L)=BiasedInverse.program (mapCircuit f L) := by
  simp only [BiasedInverse.program,rename_append,rename_reverse,
    bi_recoverPrefix_natural,bi_unbiasView_natural f L hw,bi_restoreRaw_natural,
    rawSubtract_natural,seedViews_natural f L hy]
  rfl

end Naturality
end ECDSAAdd.Entrant

end



section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit
abbrev Layout := BalancedCircuit.Layout

def source (L : Layout) : List Wire:=L.y++[L.ymsb]
def rawAdd (L : Layout) : Program:=
  signComplement L.sign L.y++addInPlace (source L) (rawTarget L) L.carry L.sign++signComplement L.sign L.y
def rawSub (L : Layout) : Program:=
  signComplement L.sign L.y++subInPlace (source L) (rawTarget L) L.carry L.sign++signComplement L.sign L.y

def seed (L : Layout) : Program:=
  [.CX L.rmsb L.one,.CX (L.ylow.getD 0 0) L.parity,.CX L.r0 L.parity]

def cleanup (L : Layout) : Program:=
  BalancedCleanup.prepareCompare L.toLayout++
    (compareLt none L.y L.r L.carry L.one L.parity++
      ((BalancedCleanup.prepareCompare L.toLayout).reverse++
        (BalancedCleanup.unnormalize L.toLayout++(BalancedCleanup.prepareSign L.toLayout).reverse)))

def forward (L : Layout) : Program:=seed L++(rawAdd L++(ShortBiasedFold.remainder L++cleanup L))
def inverse (L : Layout) : Program:=
  BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L++ShortBiasedInverse.restoreRaw L++rawSub L++(seed L).reverse

theorem forward_ignores_guard (L : Layout) (w : Wire) :
    forward {L with sourceGuard:=w}=forward L := by rfl
theorem inverse_ignores_guard (L : Layout) (w : Wire) :
    inverse {L with sourceGuard:=w}=inverse L := by rfl
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic Instr
theorem addInPlace_readonly_correct (x y carry : List Wire) (cin : Wire)
    (hnd : (cin :: (y ++ carry)).Nodup)
    (hdis : List.Disjoint x (cin :: (y ++ carry))) (hx : x.length = y.length)
    (hc : carry.length + 1 = y.length) (s : State) (m : List Bool)
    (hclean : ∀ w ∈ carry, s.basis w = false) :
    (run (addInPlace x y carry cin) m s).phase = s.phase ∧
    (∀ w, w ∉ y → (run (addInPlace x y carry cin) m s).basis w = s.basis w) ∧
    regValue y (run (addInPlace x y carry cin) m s).basis =
      (regValue x s.basis + regValue y s.basis + (s.basis cin).toNat) % 2^y.length := by
  induction y generalizing x carry cin s m with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hx
    | cons a as =>
    have hcin : cin ∉ a :: as ++ b :: bs ++ carry := by
      simp only [List.mem_append,not_or]
      exact ⟨⟨fun h => List.disjoint_left.mp hdis h (by simp),
        fun h => (List.nodup_cons.mp hnd).1 (List.mem_append_left _ h)⟩,
        fun h => (List.nodup_cons.mp hnd).1 (List.mem_append_right _ h)⟩
    have hbk : ((b :: bs) ++ carry).Nodup := (List.nodup_cons.mp hnd).2
    have hdisA : List.Disjoint (a :: as) ((b :: bs) ++ carry) := by
      apply List.disjoint_left.mpr
      intro w hw hh
      exact List.disjoint_left.mp hdis hw (List.mem_cons_of_mem _ hh)
    obtain ⟨hbs, hk, hdisB⟩ := List.nodup_append'.mp hbk
    have hca : cin ≠ a := fun h => hcin (by simp [h])
    have hcb : cin ≠ b := fun h => hcin (by simp [h])
    have hcbs : cin ∉ bs := fun h => hcin (by simp [h])
    have hab : a ≠ b := fun h => List.disjoint_left.mp hdisA List.mem_cons_self (by simp [h])
    have habs : a ∉ bs := fun h => List.disjoint_left.mp hdisA List.mem_cons_self (by simp [h])
    have hbbs : b ∉ bs := (List.nodup_cons.mp hbs).1
    let A := s.basis a
    let B := s.basis b
    let C := s.basis cin
    cases bs with
    | nil =>
      have hx0 : as = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
      have hc0 : carry = [] := List.eq_nil_of_length_eq_zero (by simpa using hc)
      subst hx0 hc0
      simp only [addInPlace, run]
      refine ⟨trivial, ?_, ?_⟩
      · intro w hw
        have hwb : w ≠ b := by simpa using hw
        simp [writeBit, hwb]
      · simp only [regValue, List.foldr_cons, List.foldr_nil, List.length_cons, List.length_nil,
          writeBit, Function.update_self, Function.update_of_ne hcb]
        cases s.basis a <;> cases s.basis b <;> cases s.basis cin <;> simp
    | cons b' bs' =>
      cases as with
      | nil => simp at hx
      | cons a' as' =>
      cases carry with
      | nil => simp at hc
      | cons c cs =>
      have hx' : (a' :: as').length = (b' :: bs').length := by simpa using hx
      have hc' : cs.length + 1 = (b' :: bs').length := by simpa using hc
      have hbc : b ≠ c := fun h => List.disjoint_left.mp hdisB List.mem_cons_self (by simp [h])
      have hcbs' : c ∉ b' :: bs' := fun h =>
        List.disjoint_left.mp hdisB (List.mem_cons_of_mem _ h) List.mem_cons_self
      have hccs : c ∉ cs := (List.nodup_cons.mp hk).1
      have hac : a ≠ c := fun h => List.disjoint_left.mp hdisA List.mem_cons_self (by simp [h])
      have hcas : c ∉ a' :: as' := fun h =>
        List.disjoint_left.mp hdisA (List.mem_cons_of_mem _ h) (by simp)
      have hcc : cin ≠ c := fun h => hcin (by simp [h])
      have h4 : [a, b, cin, c].Nodup := by
        simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
          not_or, not_false_eq_true, and_true]
        exact ⟨⟨hab, Ne.symm hca, hac⟩, ⟨Ne.symm hcb, hbc⟩, hcc⟩
      have hnd' : (c :: ((b' :: bs') ++ cs)).Nodup := by
        apply List.nodup_cons.mpr
        refine ⟨?_,List.nodup_append'.mpr ⟨(List.nodup_cons.mp hbs).2,(List.nodup_cons.mp hk).2,?_⟩⟩
        · simp only [List.mem_append,not_or]; exact ⟨hcbs',hccs⟩
        · exact List.disjoint_left.mpr (fun w hw hh =>
            List.disjoint_left.mp hdisB (List.mem_cons_of_mem _ hw) (List.mem_cons_of_mem _ hh))
      have hdis' : List.Disjoint (a' :: as') (c :: ((b' :: bs') ++ cs)) := by
        apply List.disjoint_left.mpr
        intro w hw hh
        rcases List.mem_cons.mp hh with rfl|hh
        · exact hcas hw
        · rcases List.mem_append.mp hh with hh|hh
          · exact List.disjoint_left.mp hdisA (List.mem_cons_of_mem _ hw)
              (List.mem_append_left _ (List.mem_cons_of_mem _ hh))
          · exact List.disjoint_left.mp hdisA (List.mem_cons_of_mem _ hw)
              (List.mem_append_right _ (List.mem_cons_of_mem _ hh))
      have hzero : s.basis c = false := hclean c (by simp)
      -- 第一步：进位写入 c
      let s1 : State := ⟨s.phase, writeBit s.basis c (carryBit A B C)⟩
      have hfirst (record : List Bool) : run (majority a b cin c) record s = s1 := by
        rw [majority_correct _ _ _ _ h4]
        simp [s1, hzero, A, B, C]
      have hs1 (w : Wire) (hw : w ≠ c) : s1.basis w = s.basis w := by simp [s1, writeBit, hw]
      have hclean' : ∀ d ∈ cs, s1.basis d = false := by
        intro d hd
        rw [hs1 d (fun h => hccs (h ▸ hd))]
        exact hclean d (by simp [hd])
      -- 第二步：高位递归
      obtain ⟨hphase, hsame, hsum⟩ := ih (a' :: as') cs c hnd' hdis' hx' hc' s1 m hclean'
      set t := run (addInPlace (a' :: as') (b' :: bs') cs c) m s1 with ht
      have heq (w : Wire) (hw : w ∉ b' :: bs') : t.basis w = s1.basis w := hsame w hw
      have htA : t.basis a = A := by rw [heq a habs, hs1 a hac]
      have htB : t.basis b = B := by rw [heq b hbbs, hs1 b hbc]
      have htC : t.basis cin = C := by rw [heq cin hcbs, hs1 cin hcc]
      have htK : t.basis c = carryBit A B C := by rw [heq c hcbs']; simp [s1, writeBit]
      -- 第三步：擦除本位进位（x、y、cin 仍是原值）
      have herase (record : List Bool) : run (eraseCarry a b cin c) record t =
          ⟨t.phase, writeBit t.basis c false⟩ :=
        eraseCarry_correct _ _ _ _ hac hbc hcc t (by rw [htA, htB, htC, htK]) record
      -- 第四步：写和位
      have hlast (record : List Bool) :
          run [CX a b, CX cin b] record ⟨t.phase, writeBit t.basis c false⟩ =
            ⟨t.phase, writeBit (writeBit t.basis c false) b (sumBit A B C)⟩ := by
        simp only [run]
        apply congrArg (State.mk t.phase)
        funext w
        by_cases hwb : w = b
        · subst hwb
          simp only [writeBit, Function.update_self, Function.update_of_ne hcb,
            Function.update_of_ne hac, Function.update_of_ne hbc, Function.update_of_ne hcc,
            htA, htB, htC, sumBit]
          cases A <;> cases B <;> cases C <;> rfl
        · simp [writeBit, Function.update, hwb]
      -- 组合：按右结合展开，各段记录由 run_take 收回
      have hm0 : measurementCount (majority a b cin c) = 0 := rfl
      simp only [addInPlace, List.append_assoc, run_append, run_take, hm0, List.take_zero,
        List.drop_zero]
      rw [hfirst, ← ht, herase, hlast]
      refine ⟨hphase, ?_, ?_⟩
      · intro w hw
        have hw' : w ≠ b ∧ w ∉ b' :: bs' := by simpa only [List.mem_cons, not_or] using hw
        change (writeBit (writeBit t.basis c false) b (sumBit A B C)) w = s.basis w
        rw [writeBit, Function.update_of_ne hw'.1]
        by_cases hwc : w = c
        · subst hwc; simp [writeBit, hzero]
        · rw [writeBit, Function.update_of_ne hwc, heq w hw'.2, hs1 w hwc]
      · have hbs_t : regValue (b' :: bs') (writeBit (writeBit t.basis c false) b (sumBit A B C)) =
            regValue (b' :: bs') t.basis := by
          apply regValue_congr
          intro w hw
          have hwb : w ≠ b := fun h => hbbs (h ▸ hw)
          have hwc : w ≠ c := fun h => hcbs' (h ▸ hw)
          simp [writeBit, hwb, hwc]
        have hx1 : regValue (a' :: as') s1.basis = regValue (a' :: as') s.basis :=
          regValue_congr _ _ _ (fun w hw => hs1 w (fun h => hcas (h ▸ hw)))
        have hy1 : regValue (b' :: bs') s1.basis = regValue (b' :: bs') s.basis :=
          regValue_congr _ _ _ (fun w hw => hs1 w (fun h => hcbs' (h ▸ hw)))
        have hc1 : s1.basis c = carryBit A B C := by simp [s1, writeBit]
        change (if (writeBit (writeBit t.basis c false) b (sumBit A B C)) b then 1 else 0) +
            2 * regValue (b' :: bs') (writeBit (writeBit t.basis c false) b (sumBit A B C)) = _
        rw [hbs_t, hsum, hx1, hy1, hc1]
        simp only [writeBit, Function.update_self, List.length_cons]
        have hnum := sum_value_step A B C (regValue (a' :: as') s.basis)
          (regValue (b' :: bs') s.basis) (b' :: bs').length
        simp only [List.length_cons] at hnum
        simpa only [regValue, List.foldr_cons, Bool.toNat, Bool.cond_eq_ite, A, B, C] using hnum



theorem subInPlace_readonly_correct (xs ys carry : List Wire) (cin : Wire)
    (hn : (cin::(ys++carry)).Nodup)
    (hdis : List.Disjoint xs (cin::(ys++carry))) (hl : xs.length=ys.length)
    (hc : carry.length+1=ys.length) (s : State) (m : List Bool)
    (hclean : ∀q∈carry,s.basis q=false) :
    (run (subInPlace xs ys carry cin) m s).phase=s.phase ∧
    (∀q,q∉ys → (run (subInPlace xs ys carry cin) m s).basis q=s.basis q) ∧
    regValue ys (run (subInPlace xs ys carry cin) m s).basis=
      (regValue ys s.basis+2^ys.length-regValue xs s.basis-(s.basis cin).toNat)%2^ys.length := by
  have words := List.nodup_cons.mp hn
  have split : List.Disjoint xs (ys++carry) := by
    apply List.disjoint_left.mpr
    intro q hq hh
    exact List.disjoint_left.mp hdis hq (List.mem_cons_of_mem _ hh)
  have nd := List.nodup_append'.mp words.2
  let u : State := ⟨s.phase,fun q => if q∈ys then !s.basis q else s.basis q⟩
  have ci : cin∉ys := fun h => words.1 (by simp [h])
  have clean : ∀q∈carry,u.basis q=false := by
    intro q hq; have away : q∉ys := fun h => List.disjoint_left.mp nd.2.2 h hq
    simp only [show u.basis q=s.basis q from by simp [u,away],hclean q hq]
  have source : regValue xs u.basis=regValue xs s.basis :=
    regValue_congr _ _ _ (fun q hq => by simp [u,show q∉ys from fun h => List.disjoint_left.mp split hq (by simp [h])])
  have input : regValue ys u.basis=2^ys.length-1-regValue ys s.basis := by
    rw [regValue_congr ys _ (fun q => !s.basis q) (by intro q hq; simp [u,hq]),regValue_complement]
  have add := addInPlace_readonly_correct xs ys carry cin hn hdis hl hc u m clean
  apply BalancedInverse.complement_sandwich ys nd.1 (addInPlace xs ys carry cin)
    (regValue xs s.basis) (s.basis cin).toNat s m
    (by simpa only [hl] using regValue_lt xs s.basis) (by cases s.basis cin <;> decide)
  simpa only [source,input,show u.basis cin=s.basis cin from by simp [u,ci]] using add


end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic Instr

theorem complement_run (q : Wire) (x : List Wire) (hq : q∉x)
    (s : State) (m : List Bool) :
    run (signComplement q x) m s = if s.basis q then run (notRegister x) m s else s := by
  induction x generalizing s with
  | nil => cases s.basis q <;> rfl
  | cons a x ih =>
    have hqa : q≠a := fun h => hq (by simp [h])
    have hqt : q∉x := fun h => hq (List.mem_cons_of_mem _ h)
    simp only [signComplement,List.map_cons,run]
    change run (signComplement q x) m
      ⟨s.phase,writeBit s.basis a (s.basis a ^^ s.basis q)⟩ = _
    rw [ih hqt]
    cases hs : s.basis q <;> simp [hs,writeBit,hqa,notRegister,run]

theorem complement_bit (q : Wire) (x : List Wire) (hn : x.Nodup) (hq : q∉x)
    (s : State) (m : List Bool) (a : Wire) :
    (run (signComplement q x) m s).basis a=
      if a∈x then s.basis a ^^ s.basis q else s.basis a := by
  rw [complement_run q x hq]
  cases hs:s.basis q
  · simp [hs]
  · simp only [hs,if_true,notRegister_correct x hn]
    by_cases ha:a∈x <;> simp [ha]

theorem complement_read (q : Wire) (data source : List Wire)
    (hn : data.Nodup) (hq : q∉data) (sub : ∀a∈source,a∈data)
    (s : State) (m : List Bool) :
    regValue source (run (signComplement q data) m s).basis=
      if s.basis q then 2^source.length-1-regValue source s.basis else regValue source s.basis := by
  cases hs:s.basis q
  · apply regValue_congr
    intro a ha
    simp [complement_bit q data hn hq s m a,sub a ha,hs]
  · rw [regValue_congr source _ (fun a=>!s.basis a) (by
      intro a ha
      simp [complement_bit q data hn hq s m a,sub a ha,hs]),regValue_complement]
    simp [hs]

def signedReadAdd (q : Wire) (data source target carry : List Wire) : Program :=
  signComplement q data++addInPlace source target carry q++signComplement q data

theorem signedReadAdd_correct (q : Wire) (data source target carry : List Wire)
    (nd : data.Nodup) (sep : List.Disjoint data (q::target++carry))
    (hn : (q::target++carry).Nodup) (sub : ∀a∈source,a∈data)
    (hl : source.length=target.length) (hc : carry.length+1=target.length)
    (s : State) (m : List Bool) (clean : ∀a∈carry,s.basis a=false) :
    (run (signedReadAdd q data source target carry) m s).phase=s.phase ∧
    (∀a,a∉target → (run (signedReadAdd q data source target carry) m s).basis a=s.basis a) ∧
    regValue target (run (signedReadAdd q data source target carry) m s).basis=
      signedWordValue target.length (s.basis q) (regValue source s.basis) (regValue target s.basis) := by
  have away : q∉data:=fun h=>List.disjoint_left.mp sep h (by simp)
  have sourceSep : List.Disjoint source (q::target++carry):=
    List.disjoint_left.mpr (fun a ha hh=>List.disjoint_left.mp sep (sub a ha) hh)
  have notData (a : Wire) (ha : a∈q::target++carry) : a∉data:=
    fun h=>List.disjoint_left.mp sep h ha
  let u:=run (signComplement q data) m s
  have first:=signComplement_correct q data nd away s m
  have ctrl : u.basis q=s.basis q:=first.2.1 q away
  have targetValue : regValue target u.basis=regValue target s.basis:=
    regValue_congr _ _ _ (fun a ha=>first.2.1 a (notData a (by simp [ha])))
  have cl : ∀a∈carry,u.basis a=false:=fun a ha=>
    (first.2.1 a (notData a (by simp [ha]))).trans (clean a ha)
  have sourceValue := complement_read q data source nd away sub s m
  have ad:=addInPlace_readonly_correct source target carry q hn sourceSep hl hc u m cl
  let v:=run (addInPlace source target carry q) m u
  have ctrl2 : v.basis q=s.basis q:=(ad.2.1 q
    (fun h=>(List.nodup_cons.mp hn).1 (by simp [h]))).trans ctrl
  have untouched (a : Wire) (ha : a∈data) : v.basis a=u.basis a:=
    ad.2.1 a (fun h=>List.disjoint_left.mp sep ha (by simp [h]))
  let z:=run (signComplement q data) (m.drop (measurementCount (addInPlace source target carry q))) v
  have last:=signComplement_correct q data nd away v
    (m.drop (measurementCount (addInPlace source target carry q)))
  have eq : run (signedReadAdd q data source target carry) m s=z := by
    simp only [signedReadAdd,List.append_assoc,run_append,run_take,
      (signComplement_counts q data).2,List.drop_zero]
    rw [show run (signComplement q data) (m.take 0) s=run (signComplement q data) m s by
      simpa only [(signComplement_counts q data).2] using run_take (signComplement q data) m s]
  rw [eq]
  refine ⟨last.1.trans (ad.1.trans first.1),?_,?_⟩
  · intro a ha
    by_cases hd:a∈data
    · change (run (signComplement q data) _ v).basis a=s.basis a
      rw [complement_bit q data nd away,if_pos hd,untouched a hd,ctrl2]
      change ((run (signComplement q data) m s).basis a ^^ s.basis q)=s.basis a
      rw [complement_bit q data nd away,if_pos hd]
      cases s.basis a <;> cases s.basis q <;> rfl
    · exact (last.2.1 a hd).trans ((ad.2.1 a ha).trans (first.2.1 a hd))
  · have target2 : regValue target z.basis=regValue target v.basis:=
      regValue_congr _ _ _ (fun a ha=>last.2.1 a (notData a (by simp [ha])))
    rw [target2,ad.2.2,targetValue,sourceValue,ctrl]
    cases hs:s.basis q
    · simp [hs,signedWordValue,Nat.add_comm]
    · have bound:=regValue_lt source s.basis
      simp only [hs,if_true,Bool.toNat_true,signedWordValue]
      congr 1
      simp only [hl] at bound ⊢
      omega
def signedReadSub (q : Wire) (data source target carry : List Wire) : Program :=
  signComplement q data++subInPlace source target carry q++signComplement q data

theorem signedReadSub_correct (q : Wire) (data source target carry : List Wire)
    (nd : data.Nodup) (sep : List.Disjoint data (q::target++carry))
    (hn : (q::target++carry).Nodup) (sub : ∀a∈source,a∈data)
    (hl : source.length=target.length) (hc : carry.length+1=target.length)
    (s : State) (m : List Bool) (clean : ∀a∈carry,s.basis a=false) :
    (run (signedReadSub q data source target carry) m s).phase=s.phase ∧
    (∀a,a∉target → (run (signedReadSub q data source target carry) m s).basis a=s.basis a) ∧
    regValue target (run (signedReadSub q data source target carry) m s).basis=
      signedWordValue target.length (!s.basis q) (regValue source s.basis) (regValue target s.basis) := by
  have away : q∉data:=fun h=>List.disjoint_left.mp sep h (by simp)
  have sourceSep : List.Disjoint source (q::target++carry):=
    List.disjoint_left.mpr (fun a ha hh=>List.disjoint_left.mp sep (sub a ha) hh)
  have notData (a : Wire) (ha : a∈q::target++carry) : a∉data:=
    fun h=>List.disjoint_left.mp sep h ha
  let u:=run (signComplement q data) m s
  have first:=signComplement_correct q data nd away s m
  have ctrl : u.basis q=s.basis q:=first.2.1 q away
  have targetValue : regValue target u.basis=regValue target s.basis:=
    regValue_congr _ _ _ (fun a ha=>first.2.1 a (notData a (by simp [ha])))
  have cl : ∀a∈carry,u.basis a=false:=fun a ha=>
    (first.2.1 a (notData a (by simp [ha]))).trans (clean a ha)
  have sourceValue := complement_read q data source nd away sub s m
  have ad:=subInPlace_readonly_correct source target carry q hn sourceSep hl hc u m cl
  let v:=run (subInPlace source target carry q) m u
  have ctrl2 : v.basis q=s.basis q:=(ad.2.1 q
    (fun h=>(List.nodup_cons.mp hn).1 (by simp [h]))).trans ctrl
  have untouched (a : Wire) (ha : a∈data) : v.basis a=u.basis a:=
    ad.2.1 a (fun h=>List.disjoint_left.mp sep ha (by simp [h]))
  let z:=run (signComplement q data) (m.drop (measurementCount (subInPlace source target carry q))) v
  have last:=signComplement_correct q data nd away v
    (m.drop (measurementCount (subInPlace source target carry q)))
  have eq : run (signedReadSub q data source target carry) m s=z := by
    simp only [signedReadSub,List.append_assoc,run_append,run_take,
      (signComplement_counts q data).2,List.drop_zero]
    rw [show run (signComplement q data) (m.take 0) s=run (signComplement q data) m s by
      simpa only [(signComplement_counts q data).2] using run_take (signComplement q data) m s]
  rw [eq]
  refine ⟨last.1.trans (ad.1.trans first.1),?_,?_⟩
  · intro a ha
    by_cases hd:a∈data
    · change (run (signComplement q data) _ v).basis a=s.basis a
      rw [complement_bit q data nd away,if_pos hd,untouched a hd,ctrl2]
      change ((run (signComplement q data) m s).basis a ^^ s.basis q)=s.basis a
      rw [complement_bit q data nd away,if_pos hd]
      cases s.basis a <;> cases s.basis q <;> rfl
    · exact (last.2.1 a hd).trans ((ad.2.1 a ha).trans (first.2.1 a hd))
  · have target2 : regValue target z.basis=regValue target v.basis:=
      regValue_congr _ _ _ (fun a ha=>last.2.1 a (notData a (by simp [ha])))
    rw [target2,ad.2.2,targetValue,sourceValue,ctrl]
    cases hs:s.basis q
    · simp [hs,signedWordValue]
    · have bound:=regValue_lt source s.basis
      simp only [hs,if_true,Bool.not_true,Bool.toNat_true,signedWordValue,Bool.false_eq_true,if_false]
      congr 1
      simp only [hl] at bound ⊢
      omega
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
theorem rawFacts (L : Layout) (hn : L.wires.Nodup) :
    L.y.Nodup ∧ List.Disjoint L.y (L.sign::rawTarget L++L.carry) ∧
    (L.sign::rawTarget L++L.carry).Nodup := by
  have all : (L.sign::(L.y++rawTarget L++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (rawLayoutND L hn) q
    simp only [rawSource,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have split:=List.nodup_append'.mp (show (L.y++(rawTarget L++L.carry)).Nodup from by
    simpa only [List.append_assoc] using (List.nodup_cons.mp all).2)
  refine ⟨split.1,?_,?_⟩
  · apply List.disjoint_left.mpr
    intro q hq hh
    rcases List.mem_cons.mp hh with rfl|hh
    · exact (List.nodup_cons.mp all).1 (by simp [hq])
    · exact List.disjoint_left.mp split.2.2 hq hh
  · apply List.nodup_cons.mpr
    exact ⟨fun h=>(List.nodup_cons.mp all).1 (by
      simpa only [List.append_assoc] using List.mem_append_right L.y h),split.2.1⟩

theorem source_sub (L : Layout) (a : Wire) (ha : a∈source L) : a∈L.y := by
  simp only [source,List.mem_append,List.mem_singleton] at ha
  rcases ha with h|rfl
  · exact h
  · simp [BalancedCleanup.Layout.y]

theorem source_len (L : Layout) : (source L).length=(rawSource L).length := by
  simp [source,rawSource]

theorem rawAdd_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0) :
    (run (rawAdd L) m s).phase=s.phase ∧
    (∀a,a∉rawTarget L → (run (rawAdd L) m s).basis a=s.basis a) ∧
    regValue (rawTarget L) (run (rawAdd L) m s).basis=
      signedWordValue 257 (s.basis L.sign) (regValue (source L) s.basis) (regValue (rawTarget L) s.basis) := by
  have facts:=rawFacts L hn
  have w:=widths L hw
  simpa only [rawAdd,signedReadAdd,w.2.1] using signedReadAdd_correct L.sign L.y (source L) (rawTarget L) L.carry
    facts.1 facts.2.1 facts.2.2 (source_sub L) (by rw [source_len];omega) (by omega) s m
    ((regValue_zero _ _).mp clean)

theorem rawSub_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0) :
    (run (rawSub L) m s).phase=s.phase ∧
    (∀a,a∉rawTarget L → (run (rawSub L) m s).basis a=s.basis a) ∧
    regValue (rawTarget L) (run (rawSub L) m s).basis=
      signedWordValue 257 (!s.basis L.sign) (regValue (source L) s.basis) (regValue (rawTarget L) s.basis) := by
  have facts:=rawFacts L hn
  have w:=widths L hw
  simpa only [rawSub,signedReadSub,w.2.1] using signedReadSub_correct L.sign L.y (source L) (rawTarget L) L.carry
    facts.1 facts.2.1 facts.2.2 (source_sub L) (by rw [source_len];omega) (by omega) s m
    ((regValue_zero _ _).mp clean)

theorem source_value (L : Layout) (s : BasisState) (copy : s L.sourceGuard=s L.ymsb) :
    regValue (source L) s=regValue (rawSource L) s := by
  rw [source,rawSource,regValue_append,regValue_append]
  simp [regValue,copy]
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField

theorem oldAdd_modular (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0) :
    (run (BalancedCircuit.rawAdd L) m s).phase=s.phase ∧
    regValue (rawTarget L) (run (BalancedCircuit.rawAdd L) m s).basis=
      signedWordValue 257 (s.basis L.sign) (regValue (rawSource L) s.basis) (regValue (rawTarget L) s.basis) := by
  have w:=widths L hw
  have old:=signedAdd_spec L.sign (rawSource L) (rawTarget L) L.carry (rawLayoutND L hn)
    (by omega) (by omega) (s.basis L.sign) (regValue (rawSource L) s.basis)
    (regValue (rawTarget L) s.basis) s m ⟨⟨⟨rfl,rfl⟩,rfl⟩,clean⟩
  refine ⟨?_,?_⟩
  · simpa only [BalancedCircuit.rawAdd,signedAdd] using old.1
  · simpa only [BalancedCircuit.rawAdd,signedAdd,w.2.1] using old.2.1.2

theorem rawAdd_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0)
    (copy : s.basis L.sourceGuard=s.basis L.ymsb) :
    run (rawAdd L) m s=run (BalancedCircuit.rawAdd L) m s := by
  have fresh:=rawAdd_correct L hw hn s m clean
  have old:=oldAdd_modular L hw hn s m clean
  have value : regValue (rawTarget L) (run (rawAdd L) m s).basis=
      regValue (rawTarget L) (run (BalancedCircuit.rawAdd L) m s).basis := by
    rw [fresh.2.2,old.2,source_value L s.basis copy]
  apply State.extensionality
  · exact fresh.1.trans old.1.symm
  · funext q
    by_cases hq:q∈rawTarget L
    · exact (regValue_eq_iff _ _ _).mp value q hq
    · exact (fresh.2.1 q hq).trans (BalancedCircuit.rawAdd_frame L hw hn s m clean q hq).symm

theorem rawSub_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0)
    (copy : s.basis L.sourceGuard=s.basis L.ymsb) :
    run (rawSub L) m s=run (BalancedInverse.rawSubtract L) m s := by
  have fresh:=rawSub_correct L hw hn s m clean
  have old:=BalancedInverse.rawSubtract_modular L hw hn s m clean
  have value : regValue (rawTarget L) (run (rawSub L) m s).basis=
      regValue (rawTarget L) (run (BalancedInverse.rawSubtract L) m s).basis := by
    rw [fresh.2.2,old.2.2,source_value L s.basis copy]
  apply State.extensionality
  · exact fresh.1.trans old.1.symm
  · funext q
    by_cases hq:q∈rawTarget L
    · exact (regValue_eq_iff _ _ _).mp value q hq
    · exact (fresh.2.1 q hq).trans (old.2.1 q hq).symm
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic
attribute [local irreducible] wires run

theorem copy_sandwich_cancel (a b : Wire) (P : Program)
    (free : b∉wires P) (s : State) (m : List Bool)
    (stable : (run P m (run [.CX a b] [] s)).basis a=s.basis a) :
    run ([.CX a b]++P++[.CX a b]) m s=run P m s := by
  let c:=run [.CX a b] [] s
  let u:=run P m c
  let t:=run P m s
  have read (q : Wire) (hq : q∈wires P) : c.basis q=s.basis q := by
    have qb:q≠b:=fun e=>free (e ▸ hq)
    simp [c,run,writeBit,qb]
  have increment:=run_local_increment P c s m read
  have phase:u.phase=t.phase := by
    have h:=increment.1
    rw [show c.phase=s.phase by simp [c,run]] at h
    change (u.phase ^^ s.phase)=(t.phase ^^ s.phase) at h
    cases hu:u.phase <;> cases ht:t.phase <;> cases hs:s.phase <;> simp_all
  have outside (q : Wire) (qb : q≠b) : u.basis q=t.basis q := by
    by_cases hp:q∈wires P
    · exact increment.2 q hp
    · exact (run_preserves_outside P m c q hp).trans
        ((by simp [c,run,writeBit,qb] : c.basis q=s.basis q).trans
          (run_preserves_outside P m s q hp).symm)
  have ub:u.basis b=(s.basis b ^^ s.basis a) := by
    have cb:c.basis b=(s.basis b ^^ s.basis a):=by simp [c,run,writeBit]
    exact (run_preserves_outside P m c b free).trans cb
  have tb:t.basis b=s.basis b:=run_preserves_outside P m s b free
  have ua:u.basis a=s.basis a:=stable
  have actual : run ([.CX a b]++P++[.CX a b]) m s=
      run [.CX a b] (m.drop (measurementCount P)) u := by
    simp only [List.append_assoc,run_append,show measurementCount [Instr.CX a b]=0 from rfl,
      List.take_zero,List.drop_zero,run_take]
    rfl
  rw [actual]
  apply State.extensionality
  · simpa only [run] using phase
  · funext q
    by_cases qb:q=b
    · subst q
      simp only [run,writeBit,Function.update_self]
      change (u.basis b ^^ u.basis a)=t.basis b
      rw [ub,ua,tb]
      cases s.basis b <;> cases s.basis a <;> rfl
    · simp only [run]
      change writeBit u.basis b (u.basis b ^^ u.basis a) q=t.basis q
      rw [writeBit,Function.update_of_ne qb]
      exact outside q qb

theorem copy_sandwich_source (a b : Wire) (ne : a≠b) (P : Program)
    (s : State) (m : List Bool) :
    (run ([.CX a b]++P++[.CX a b]) m s).basis a=
      (run P m (run [.CX a b] [] s)).basis a := by
  simp only [List.append_assoc,run_append,show measurementCount [Instr.CX a b]=0 from rfl,
    List.take_zero,List.drop_zero,run_take]
  simp only [run,writeBit,Function.update_of_ne ne]

end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run wires

theorem seeded_raw_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (rawAdd L) m (run (seedViews L) m s)=
      run (BalancedCircuit.rawAdd L) m (run (seedViews L) m s) := by
  have seed:=compose_seed_frame L hw hn s m hc
  have scalar:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have ys : (run (seedViews L) m s).basis L.ymsb=s.basis L.ymsb:=
    seed.2.2 _ (by tauto) (by tauto) (by tauto)
  apply rawAdd_eq L hw hn
  · apply (regValue_zero _ _).mpr
    intro q hq
    have cv:=compose_clean_views L hn q (by simp [hq])
    have qo:q≠L.one:=fun e=>cv.1 (e ▸ (by simp [rawTarget]))
    exact (seed.2.2 q cv.2.1 qo cv.2.2.1).trans (hc q cv.2.2.2)
  · exact seed.2.1.trans ys.symm

theorem old_forward_sandwich (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawAdd L)=measurementCount (BalancedCircuit.rawAdd L))
    (s : State) (m : List Bool) (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (ShortBiasedFold.program L) m s=
      run ([.CX L.ymsb L.sourceGuard]++forward L++[.CX L.ymsb L.sourceGuard]) m s := by
  let tail:=ShortBiasedFold.remainder L++cleanup L++[.CX L.ymsb L.sourceGuard]
  have eq : run (seedViews L++(BalancedCircuit.rawAdd L++tail)) m s=
      run (seedViews L++(rawAdd L++tail)) m s := by
    simp only [run_append,run_take,show measurementCount (seedViews L)=0 from rfl,List.drop_zero]
    rw [show run (seedViews L) (m.take 0) s=run (seedViews L) m s by
      simpa only [show measurementCount (seedViews L)=0 from rfl] using run_take (seedViews L) m s]
    rw [seeded_raw_eq L hw hn s m hc,sameM]
  simpa only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,BiasedCircuit.cleanupSuffix,
    forward,cleanup,tail,seedViews,seed,List.append_assoc] using eq

theorem forward_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawAdd L)=measurementCount (BalancedCircuit.rawAdd L))
    (free : L.sourceGuard∉wires (forward L))
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (forward L) m s=run (ShortBiasedFold.program L) m s := by
  have old:=ShortBiasedFold.program_correct L hw hn B X Y hx hy s m hs hr hyr hc
  have same:=old_forward_sandwich L hw hn sameM s m hc
  have scalar:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have ne:L.ymsb≠L.sourceGuard:=by tauto
  have notR:L.ymsb∉L.r:=by
    intro h
    have split:=List.nodup_append'.mp (show (BalancedCircuit.rawSource L++(rawTarget L++L.carry)).Nodup from by
      simpa only [List.append_assoc] using (List.nodup_cons.mp (rawLayoutND L hn)).2)
    have hy:L.ymsb∈BalancedCircuit.rawSource L:=by simp [BalancedCircuit.rawSource,BalancedCleanup.Layout.y]
    have ht:L.ymsb∈rawTarget L++L.carry:=by simp [rawTarget,h]
    exact List.disjoint_left.mp split.2.2 hy ht
  have out : (run ([.CX L.ymsb L.sourceGuard]++forward L++[.CX L.ymsb L.sourceGuard]) m s).basis L.ymsb=
      s.basis L.ymsb := by rw [←same]; exact old.2.2.2 _ notR
  have stable : (run (forward L) m (run [.CX L.ymsb L.sourceGuard] [] s)).basis L.ymsb=s.basis L.ymsb := by
    rw [←copy_sandwich_source L.ymsb L.sourceGuard ne]
    exact out
  exact (copy_sandwich_cancel L.ymsb L.sourceGuard (forward L) free s m stable).symm.trans same.symm
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 3000000
