section
-- Parity/top-carry follow-up helper PublicRawTop
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
def rawSubT (L : Layout) : Program:=
  signComplement L.sign L.y++TopCarry.subInPlaceTop (source L) (rawTarget L) L.carry L.sign++
    signComplement L.sign L.y
private theorem topcarry_PublicRawTop_gt_top_affine (A A' B B' C : Bool)
    (hX : A.toNat + 2 * A'.toNat < 1 ∨ 3 ≤ A.toNat + 2 * A'.toNat)
    (hS : (A.toNat + 2 * A'.toNat + (B.toNat + 2 * B'.toNat) + C.toNat) % 4 < 1 ∨
      3 ≤ (A.toNat + 2 * A'.toNat + (B.toNat + 2 * B'.toNat) + C.toNat) % 4) :
    carryBit A B C = (B ^^ B' ^^ C) := by
  revert hX hS
  cases A <;> cases A' <;> cases B <;> cases B' <;> cases C <;> decide

/-- `TopCarry.addInPlaceTop_eq` for a read-only source that may repeat wires. -/
theorem addInPlaceTop_ro_eq : ∀ (n : Nat) (x y carry : List Wire) (cin : Wire),
    y.length = n + 2 → x.length = y.length → carry.length + 1 = y.length →
    (cin :: (y ++ carry)).Nodup → List.Disjoint x (cin :: (y ++ carry)) →
    ∀ (s : State) (m : List Bool),
    (∀ w ∈ carry, s.basis w = false) →
    (regValue x s.basis < 2^n ∨ 3 * 2^n ≤ regValue x s.basis) →
    ((regValue x s.basis + regValue y s.basis + (s.basis cin).toNat) % 2^(n+2) < 2^n ∨
      3 * 2^n ≤ (regValue x s.basis + regValue y s.basis + (s.basis cin).toNat) % 2^(n+2)) →
    run (TopCarry.addInPlaceTop x y carry cin) m s = run (addInPlace x y carry cin) m s := by
  intro n
  induction n with
  | zero =>
    intro x y carry cin hy hx hc hnd hdis s m hclean hX hS
    obtain ⟨a, a', b, b', c, rfl, rfl, rfl⟩ := TopCarry.shape_two hy hx hc
    have hcnt := List.nodup_iff_count.mp hnd
    have hk : [b, cin, c].Nodup := by
      apply List.nodup_iff_count.mpr; intro w; have := hcnt w
      simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
    have away : a ∉ [b, cin, c] := by
      intro mem
      apply List.disjoint_left.mp hdis (List.mem_cons_self)
      simp only [List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at mem ⊢
      tauto
    have h4 : [a, b, cin, c].Nodup := List.nodup_cons.mpr ⟨away, hk⟩
    have hbc : b ≠ c := fun h => by
      have := hcnt c; subst h
      simp only [List.count_cons, List.count_append, List.count_nil, beq_self_eq_true, if_true] at this; omega
    have hb'c : b' ≠ c := fun h => by
      have := hcnt c; subst h
      simp only [List.count_cons, List.count_append, List.count_nil, beq_self_eq_true, if_true] at this; omega
    have hcc : cin ≠ c := fun h => by
      have := hcnt c; subst h
      simp only [List.count_cons, List.count_append, List.count_nil, beq_self_eq_true, if_true] at this; omega
    have hzero : s.basis c = false := hclean c (by simp)
    have hK : carryBit (s.basis a) (s.basis b) (s.basis cin) =
        (s.basis b ^^ s.basis b' ^^ s.basis cin) := by
      apply topcarry_PublicRawTop_gt_top_affine _ (s.basis a') _ _ _
      · simpa [TopCarry.regValue_cons', TopCarry.regValue_nil'] using hX
      · simpa [TopCarry.regValue_cons', TopCarry.regValue_nil'] using hS
    have hm1 : measurementCount ([.CX b c, .CX b' c, .CX cin c] : Program) = 0 := rfl
    have hm2 : measurementCount (majority a b cin c) = 0 := rfl
    have hmid : run ([.CX b c, .CX b' c, .CX cin c] : Program) [] s = run (majority a b cin c) [] s := by
      rw [majority_correct _ _ _ _ h4]
      simp only [run]
      apply State.extensionality
      · rfl
      · funext w
        simp only [writeBit, Function.update]
        by_cases hwc : w = c
        · subst hwc
          simp [hbc, hb'c, hcc, hzero, hK]
        · simp [hwc]
    simp only [TopCarry.addInPlaceTop, addInPlace, if_pos (rfl : ([] : List Wire) = []), List.append_assoc]
    exact TopCarry.run_head_congr _ _ _ m s hm1 hm2 hmid
  | succ n ih =>
    intro x y carry cin hy hx hc hnd hdis s m hclean hX hS
    obtain ⟨a, a', a'', as, b, b', b'', bs, c, cs, rfl, rfl, rfl⟩ := TopCarry.shape_succ hy hx hc
    have hcnt := List.nodup_iff_count.mp hnd
    have hk : [b, cin, c].Nodup := by
      apply List.nodup_iff_count.mpr; intro w; have := hcnt w
      simp only [List.count_cons, List.count_append, List.count_nil] at this ⊢; omega
    have away : a ∉ [b, cin, c] := by
      intro mem
      apply List.disjoint_left.mp hdis (List.mem_cons_self)
      simp only [List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at mem ⊢
      tauto
    have h4 : [a, b, cin, c].Nodup := List.nodup_cons.mpr ⟨away, hk⟩
    have hnd' : (c :: ((b' :: b'' :: bs) ++ cs)).Nodup := by
      apply List.nodup_iff_count.mpr; intro w; have := hcnt w
      simp only [List.count_cons, List.count_append] at this ⊢; omega
    have hdis' : List.Disjoint (a' :: a'' :: as) (c :: ((b' :: b'' :: bs) ++ cs)) := by
      apply List.disjoint_left.mpr
      intro w hw hh
      apply List.disjoint_left.mp hdis (List.mem_cons_of_mem _ hw)
      simp only [List.mem_cons, List.mem_append] at hh ⊢
      tauto
    have hcx : c ∉ a' :: a'' :: as := fun h =>
      List.disjoint_left.mp hdis (List.mem_cons_of_mem _ h) (by simp)
    have hcy : c ∉ b' :: b'' :: bs := fun h => by
      have h1 := hcnt c; have h2 := List.count_pos_iff.mpr h
      simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h1 h2; omega
    have hccs : c ∉ cs := fun h => by
      have h1 := hcnt c; have h2 := List.count_pos_iff.mpr h
      simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h1 h2; omega
    have hzero : s.basis c = false := hclean c (by simp)
    let A := s.basis a
    let B := s.basis b
    let C := s.basis cin
    let s1 : State := ⟨s.phase, writeBit s.basis c (carryBit A B C)⟩
    have hfirst (record : List Bool) : run (majority a b cin c) record s = s1 := by
      rw [majority_correct _ _ _ _ h4]; simp [s1, hzero, A, B, C]
    have hs1 (w : Wire) (hw : w ≠ c) : s1.basis w = s.basis w := by simp [s1, writeBit, hw]
    have hclean' : ∀ d ∈ cs, s1.basis d = false := by
      intro d hd; rw [hs1 d (fun h => hccs (h ▸ hd))]; exact hclean d (by simp [hd])
    have hxs : regValue (a' :: a'' :: as) s1.basis = regValue (a' :: a'' :: as) s.basis :=
      regValue_congr _ _ _ (fun w hw => hs1 w (fun h => hcx (h ▸ hw)))
    have hys : regValue (b' :: b'' :: bs) s1.basis = regValue (b' :: b'' :: bs) s.basis :=
      regValue_congr _ _ _ (fun w hw => hs1 w (fun h => hcy (h ▸ hw)))
    have hc1 : s1.basis c = carryBit A B C := by simp [s1, writeBit]
    rw [TopCarry.regValue_cons' a, TopCarry.regValue_cons' b] at hS
    rw [TopCarry.regValue_cons' a] at hX
    have step := sum_value_step A B C (regValue (a' :: a'' :: as) s.basis)
      (regValue (b' :: b'' :: bs) s.basis) (n+2)
    have hsb : (sumBit A B C).toNat ≤ 1 := by cases sumBit A B C <;> decide
    have hA : (s.basis a).toNat ≤ 1 := by cases s.basis a <;> decide
    have hp1 : 2^(n+1) = 2 * 2^n := by rw [pow_succ]; ring
    have hX' : regValue (a' :: a'' :: as) s1.basis < 2^n ∨
        3 * 2^n ≤ regValue (a' :: a'' :: as) s1.basis := by
      rw [hxs]; omega
    have hS' : (regValue (a' :: a'' :: as) s1.basis + regValue (b' :: b'' :: bs) s1.basis +
          (s1.basis c).toNat) % 2^(n+2) < 2^n ∨
        3 * 2^n ≤ (regValue (a' :: a'' :: as) s1.basis + regValue (b' :: b'' :: bs) s1.basis +
          (s1.basis c).toNat) % 2^(n+2) := by
      rw [hxs, hys, hc1]
      change (sumBit A B C).toNat + 2 * ((regValue (a' :: a'' :: as) s.basis +
        regValue (b' :: b'' :: bs) s.basis + (carryBit A B C).toNat) % 2^(n+2)) =
        ((A.toNat + 2 * regValue (a' :: a'' :: as) s.basis) +
          (B.toNat + 2 * regValue (b' :: b'' :: bs) s.basis) + C.toNat) % 2^(n+2+1) at step
      rw [show n+2+1 = n+1+2 by omega] at step
      generalize (regValue (a' :: a'' :: as) s.basis + regValue (b' :: b'' :: bs) s.basis +
        (carryBit A B C).toNat) % 2^(n+2) = S' at step ⊢
      generalize ((A.toNat + 2 * regValue (a' :: a'' :: as) s.basis) +
        (B.toNat + 2 * regValue (b' :: b'' :: bs) s.basis) + C.toNat) % 2^(n+1+2) = S at step hS
      omega
    have hmc : measurementCount (TopCarry.addInPlaceTop (a' :: a'' :: as) (b' :: b'' :: bs) cs c) =
        measurementCount (addInPlace (a' :: a'' :: as) (b' :: b'' :: bs) cs c) := by
      rw [(TopCarry.addInPlaceTop_counts n _ _ _ c (by simpa using hy) (by simpa using hx)
          (by simpa using hc)).2,
        (addInPlace_counts _ _ _ c (by simpa using hx) (by simpa using hc)).2]
      simp only [List.length_cons] at hy ⊢
      omega
    have hm0 : measurementCount (majority a b cin c) = 0 := rfl
    simp only [TopCarry.addInPlaceTop, addInPlace, List.cons_ne_nil, if_false]
    rw [List.append_assoc (majority a b cin c ++ _), List.append_assoc (majority a b cin c ++ _)]
    apply TopCarry.run_mid_congr _ _ _ _ m s hm0 hmc
    intro record
    rw [hfirst]
    exact ih _ _ _ c (by simpa using hy) (by simpa using hx) (by simpa using hc) hnd' hdis' s1 record
      hclean' hX' hS'

theorem source_ext (L : Layout) (hw : L.Widths) (st : BasisState) :
    regValue (source L) st<2^255 ∨ 3*2^255≤regValue (source L) st := by
  have hl : L.ylow.length=255 := hw.2.1
  have hv : regValue (source L) st=regValue L.ylow st+2^255*(st L.ymsb).toNat+2^256*(st L.ymsb).toNat := by
    rw [source,BalancedCleanup.Layout.y,regValue_append,regValue_append,TopCarry.regValue_single,
      List.length_append,hl,List.length_singleton]
  have lt := regValue_lt L.ylow st
  rw [hl] at lt
  have p : (2:Nat)^256=2*2^255 := by norm_num
  rw [hv]
  cases st L.ymsb <;> simp only [Bool.toNat_false,Bool.toNat_true] <;> omega

theorem target_ext (L : Layout) (hw : L.Widths) (st : BasisState) (h : st L.one=st L.rmsb) :
    regValue (rawTarget L) st<2^255 ∨ 3*2^255≤regValue (rawTarget L) st := by
  have hl : L.low.length=255 := (BalancedCleanup.widths L.toLayout hw).1
  have hv : regValue (rawTarget L) st=regValue L.low st+2^255*(st L.rmsb).toNat+2^256*(st L.one).toNat := by
    rw [rawTarget,BalancedCleanup.Layout.r,regValue_append,regValue_append,TopCarry.regValue_single,
      TopCarry.regValue_single,List.length_append,hl,List.length_singleton]
  have lt := regValue_lt L.low st
  rw [hl] at lt
  have p : (2:Nat)^256=2*2^255 := by norm_num
  rw [hv,h]
  cases st L.rmsb <;> simp only [Bool.toNat_false,Bool.toNat_true] <;> omega

/-- The affine top is exact whenever the old raw subtraction leaves a sign-extended target. -/
theorem rawSubT_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (v : State) (r : List Bool) (clean : ∀q∈L.carry,v.basis q=false)
    (cond : (run (rawSub L) r v).basis L.one=(run (rawSub L) r v).basis L.rmsb) :
    run (rawSubT L) r v=run (rawSub L) r v := by
  have facts:=rawFacts L hn
  have w:=widths L hw
  have slen : (source L).length=257 := by rw [source_len]; exact w.1
  have tlen : (rawTarget L).length=257 := w.2.1
  have clen : L.carry.length=256 := hw.2.2
  have nd : (L.sign::(rawTarget L++L.carry)).Nodup := facts.2.2
  have tnd : (rawTarget L).Nodup := (List.nodup_append'.mp (List.nodup_cons.mp nd).2).1
  have dis : List.Disjoint (source L) (L.sign::(rawTarget L++L.carry)) := by
    apply List.disjoint_left.mpr
    intro q hq hm
    exact List.disjoint_left.mp facts.2.1 (source_sub L q hq) hm
  have sy : L.sign∉L.y := fun h => List.disjoint_left.mp facts.2.1 h (by simp)
  have ty (a : Wire) (ha : a∈rawTarget L) : a∉L.y :=
    fun h => List.disjoint_left.mp facts.2.1 h (by simp [ha])
  have cy (a : Wire) (ha : a∈L.carry) : a∉L.y :=
    fun h => List.disjoint_left.mp facts.2.1 h (by simp [ha])
  have ct (a : Wire) (ha : a∈L.carry) : a∉rawTarget L := fun h =>
    List.disjoint_left.mp (List.nodup_append'.mp (List.nodup_cons.mp nd).2).2.2 h ha
  have mSC : measurementCount (signComplement L.sign L.y)=0 := (signComplement_counts _ _).2
  have mNR : measurementCount (notRegister (rawTarget L))=0 := (notRegister_counts _).2
  obtain ⟨u,eu⟩ : ∃ u, u=run (signComplement L.sign L.y) [] v := ⟨_,rfl⟩
  obtain ⟨v',ev⟩ : ∃ v', v'=run (notRegister (rawTarget L)) [] u := ⟨_,rfl⟩
  have first := signComplement_correct L.sign L.y facts.1 sy v []
  rw [← eu] at first
  have second := notRegister_correct (rawTarget L) tnd u []
  rw [← ev] at second
  have vb (a : Wire) (ha : a∉rawTarget L) : v'.basis a=u.basis a := by rw [second]; simp [ha]
  have eOld : run (rawSub L) r v=
      run (addInPlace (source L) (rawTarget L) L.carry L.sign++
        (notRegister (rawTarget L)++signComplement L.sign L.y)) r v' := by
    simp only [rawSub,subInPlace,List.append_assoc]
    rw [TopCarry.run_zero_head _ _ r v mSC,← eu,TopCarry.run_zero_head _ _ r u mNR,← ev]
  have eNew : run (rawSubT L) r v=
      run (TopCarry.addInPlaceTop (source L) (rawTarget L) L.carry L.sign++
        (notRegister (rawTarget L)++signComplement L.sign L.y)) r v' := by
    simp only [rawSubT,TopCarry.subInPlaceTop,List.append_assoc]
    rw [TopCarry.run_zero_head _ _ r v mSC,← eu,TopCarry.run_zero_head _ _ r u mNR,← ev]
  have clean' : ∀a∈L.carry,v'.basis a=false := fun a ha =>
    (vb a (ct a ha)).trans ((first.2.1 a (cy a ha)).trans (clean a ha))
  have hX := source_ext L hw v'.basis
  -- the adder output is the complement of the final target, hence sign-extended
  let k := measurementCount (addInPlace (source L) (rawTarget L) L.carry L.sign)
  have add := addInPlace_readonly_correct (source L) (rawTarget L) L.carry L.sign nd dis
    (by omega) (by omega) v' (r.take k) clean'
  obtain ⟨A,eA⟩ : ∃ A, A=run (addInPlace (source L) (rawTarget L) L.carry L.sign) (r.take k) v' := ⟨_,rfl⟩
  rw [← eA] at add
  have fin : run (rawSub L) r v=
      run (notRegister (rawTarget L)++signComplement L.sign L.y) (r.drop k) A := by
    rw [eOld,run_append,eA]
  have oneT : L.one∈rawTarget L := by simp [rawTarget]
  have rmsbT : L.rmsb∈rawTarget L := by
    simp [rawTarget,BalancedCleanup.Layout.r]
  have tailBit (q : Wire) (hq : q∈rawTarget L) (r' : List Bool) (t : State) :
      (run (notRegister (rawTarget L)++signComplement L.sign L.y) r' t).basis q=!t.basis q := by
    rw [run_append,notRegister_correct _ tnd]
    have h3 := signComplement_correct L.sign L.y facts.1 sy
      ⟨t.phase,fun w => if w∈rawTarget L then !t.basis w else t.basis w⟩
      (r'.drop (measurementCount (notRegister (rawTarget L))))
    rw [h3.2.1 q (ty q hq)]
    simp [hq]
  have aeq : A.basis L.one=A.basis L.rmsb := by
    have c := cond
    rw [fin,tailBit _ oneT,tailBit _ rmsbT] at c
    simpa using c
  have hS : (regValue (source L) v'.basis+regValue (rawTarget L) v'.basis+(v'.basis L.sign).toNat)%
        2^(255+2)<2^255 ∨
      3*2^255≤(regValue (source L) v'.basis+regValue (rawTarget L) v'.basis+(v'.basis L.sign).toNat)%
        2^(255+2) := by
    have e : (regValue (source L) v'.basis+regValue (rawTarget L) v'.basis+(v'.basis L.sign).toNat)%
        2^(255+2)=regValue (rawTarget L) A.basis := by
      rw [add.2.2,tlen]
    rw [e]
    exact target_ext L hw A.basis aeq
  have hmc : measurementCount (TopCarry.addInPlaceTop (source L) (rawTarget L) L.carry L.sign)=
      measurementCount (addInPlace (source L) (rawTarget L) L.carry L.sign) := by
    rw [(TopCarry.addInPlaceTop_counts 255 _ _ _ _ (by omega) (by omega) (by omega)).2,
      (addInPlace_counts _ _ _ _ (by omega) (by omega)).2,tlen]
  rw [eNew,eOld]
  apply TopCarry.run_congr_head _ _ _ r v' hmc
  intro r'
  exact addInPlaceTop_ro_eq 255 (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
    (by omega) nd dis v' r' clean' hX hS
end ECDSAAdd.Entrant.GuardCompression

end

section
-- Parity/top-carry follow-up helper BorrowParity
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.Entrant
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.BigABorrowParity
attribute [local irreducible] run wires

theorem pair_pull (a b : Wire) (s : State) (ha : s.basis a=false) (hb : s.basis b=false) :
    pullState (Equiv.swap a b) s=s := by
  apply State.extensionality
  · rfl
  · funext q
    by_cases h : q=a
    · subst q; simp [pullState,ha,hb]
    · by_cases h' : q=b
      · subst q; simp [pullState,ha,hb]
      · change s.basis (Equiv.swap a b q)=s.basis q
        rw [Equiv.swap_apply_of_ne_of_ne h h']

theorem borrow_eq (a b : Wire) (P : Program) (s : State) (m : List Bool)
    (ha : s.basis a=false) (hb : s.basis b=false)
    (ha' : (run P m s).basis a=false) (hb' : (run P m s).basis b=false) :
    run (renameProgram (Equiv.swap a b) P) m s=run P m s := by
  apply MappedCompressed.pullState_perm_injective (Equiv.swap a b)
  rw [run_rename _ (Equiv.swap a b).injective,pair_pull a b s ha hb,pair_pull a b _ ha' hb']

/-- Move parity erasure before raw subtraction, then borrow it as the last
carry. All hypotheses are actual input/output frame assertions, not promises
about phases or shared measurement outcomes. -/
theorem early_clear_tail (P : Program) (a y p last : Wire) (s : State) (m : List Bool)
    (free : p∉wires P) (same : s.basis p=s.basis a)
    (lp : last≠p) (last0 : s.basis last=false)
    (lastout : (run P m (run [.CX a p] [] s)).basis last=false)
    (oldClears : (run [.CX a p,.CX y p] [] (run P m s)).basis p=false) :
    run (renameProgram (Equiv.swap last p) P) m (run [.CX a p] [] s)=
      run [.CX a p,.CX y p] [] (run P m s) := by
  obtain ⟨c,hc⟩ : ∃c : State,run [.CX a p] [] s=c := ⟨_,rfl⟩
  have cp : c.basis p=false := by
    rw [←hc]
    simp [run,writeBit,same]
  have cl : c.basis last=false := by
    rw [←hc]
    simp [run,writeBit,Function.update_of_ne lp,last0]
  have pp : (run P m c).basis p=false := (run_preserves_outside _ _ _ _ free).trans cp
  have pl : (run P m c).basis last=false := by simpa only [hc] using lastout
  have borrowed := borrow_eq last p P c m cl cp pl pp
  rw [hc,borrowed]
  have apart : OneReuse.Apart p c s := by
    rw [←hc]
    refine ⟨?_,?_⟩
    · simp [run]
    intro q hq
    simp [run,writeBit,Function.update_of_ne hq]
  have related := OneReuse.away_congr p P free c s m apart
  apply State.extensionality
  · simpa only [run] using related.1
  · funext q
    by_cases qp : q=p
    · subst q
      exact pp.trans oldClears.symm
    · simpa only [run,writeBit,Function.update_of_ne qp] using related.2 q qp
end ECDSAAdd.Entrant.BigABorrowParity

end

section
-- Parity/top-carry follow-up helper InversePrefixParity
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.Entrant
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField BiasedInverse ShortBiasedInverse
attribute [local irreducible] run measurementCount
theorem inverse_prefix_parity_ready (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    let t:=run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)
    regValue L.carry t.basis=0 ∧ t.basis L.sourceGuard=t.basis L.ymsb ∧
    t.basis L.parity=t.basis L.r0 := by
  let X := BalancedInverse.result B R Y
  let T := rawSum B X Y
  let P := originalParity T
  let u0 := run [.CX L.ymsb L.sourceGuard] m s
  let u1 := run (recoverPrefix L) m u0
  let m1 := m.drop (measurementCount (recoverPrefix L))
  let u2 := run (unbiasView L) m1 u1
  let m2 := m1.drop (measurementCount (unbiasView L))
  let u3 := run (ShortBiasedInverse.restoreRaw L) m2 u2
  have hx : Centered X := BalancedInverse.result_bounds B R Y
  have ht : -(2*q)≤T ∧ T≤2*q := rawSum_bounds B X Y hx hy
  have half : halfResult T=R := BalancedInverse.result_half B R Y hr hy
  have par : decide (q < |2*R-signedY B Y|)=P := BalancedInverse.result_parity B R Y hr hy
  have w := BalancedCleanup.widths L.toLayout hw
  have rwid := BalancedCircuit.widths L hw
  have cnd : L.toLayout.wires.Nodup := (List.nodup_append'.mp hn).2.1
  have nd := scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  rcases nd with ⟨⟨h0_1,h0_2,h0_3,h0_4,h0_5,h0_6,h0_7,h0_8,h0_9,h0_10⟩,⟨h1_2,h1_3,h1_4,h1_5,h1_6,h1_7,h1_8,h1_9,h1_10⟩,⟨h2_3,h2_4,h2_5,h2_6,h2_7,h2_8,h2_9,h2_10⟩,⟨h3_4,h3_5,h3_6,h3_7,h3_8,h3_9,h3_10⟩,⟨h4_5,h4_6,h4_7,h4_8,h4_9,h4_10⟩,⟨h5_6,h5_7,h5_8,h5_9,h5_10⟩,⟨h6_7,h6_8,h6_9,h6_10⟩,⟨h7_8,h7_9,h7_10⟩,⟨h8_9,h8_10⟩,h9_10⟩
  have h0_1r := Ne.symm h0_1
  have h0_2r := Ne.symm h0_2
  have h0_3r := Ne.symm h0_3
  have h0_4r := Ne.symm h0_4
  have h0_5r := Ne.symm h0_5
  have h0_6r := Ne.symm h0_6
  have h0_7r := Ne.symm h0_7
  have h0_8r := Ne.symm h0_8
  have h0_9r := Ne.symm h0_9
  have h0_10r := Ne.symm h0_10
  have h1_2r := Ne.symm h1_2
  have h1_3r := Ne.symm h1_3
  have h1_4r := Ne.symm h1_4
  have h1_5r := Ne.symm h1_5
  have h1_6r := Ne.symm h1_6
  have h1_7r := Ne.symm h1_7
  have h1_8r := Ne.symm h1_8
  have h1_9r := Ne.symm h1_9
  have h1_10r := Ne.symm h1_10
  have h2_3r := Ne.symm h2_3
  have h2_4r := Ne.symm h2_4
  have h2_5r := Ne.symm h2_5
  have h2_6r := Ne.symm h2_6
  have h2_7r := Ne.symm h2_7
  have h2_8r := Ne.symm h2_8
  have h2_9r := Ne.symm h2_9
  have h2_10r := Ne.symm h2_10
  have h3_4r := Ne.symm h3_4
  have h3_5r := Ne.symm h3_5
  have h3_6r := Ne.symm h3_6
  have h3_7r := Ne.symm h3_7
  have h3_8r := Ne.symm h3_8
  have h3_9r := Ne.symm h3_9
  have h3_10r := Ne.symm h3_10
  have h4_5r := Ne.symm h4_5
  have h4_6r := Ne.symm h4_6
  have h4_7r := Ne.symm h4_7
  have h4_8r := Ne.symm h4_8
  have h4_9r := Ne.symm h4_9
  have h4_10r := Ne.symm h4_10
  have h5_6r := Ne.symm h5_6
  have h5_7r := Ne.symm h5_7
  have h5_8r := Ne.symm h5_8
  have h5_9r := Ne.symm h5_9
  have h5_10r := Ne.symm h5_10
  have h6_7r := Ne.symm h6_7
  have h6_8r := Ne.symm h6_8
  have h6_9r := Ne.symm h6_9
  have h6_10r := Ne.symm h6_10
  have h7_8r := Ne.symm h7_8
  have h7_9r := Ne.symm h7_9
  have h7_10r := Ne.symm h7_10
  have h8_9r := Ne.symm h8_9
  have h8_10r := Ne.symm h8_10
  have h9_10r := Ne.symm h9_10
  have flagR (f : Wire) (hf : f∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one]) :
      f∉L.r := fun h => flagAway L hn f hf (by simp [h])
  have away (a : Wire)
      (ha : a∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower]++L.y++L.carry) :
      a∉rawTarget L := compose_raw_away L hn a ha
  have neq (a : Wire) (ha : a∈L.y++L.carry)
      (f : Wire) (hf : f∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one]) : a≠f :=
    by
      intro e
      apply flagAway L hn f hf
      subst a
      simp only [List.mem_append] at ha ⊢
      tauto
  have nr (a : Wire) (ha : a∈L.y++L.carry) : a∉L.r := by
    have d := (List.nodup_append'.mp (allND L hn)).2.1
    have dn : (L.r++(L.y++L.carry)).Nodup := by
      simpa only [List.append_assoc] using d
    exact fun h => List.disjoint_left.mp (List.nodup_append'.mp dn).2.2 h ha
  have f0 (a : Wire) (ha : a≠L.sourceGuard) : u0.basis a=s.basis a := by
    simp [u0,run,writeBit,ha]
  have g0 : u0.basis L.sourceGuard=s.basis L.ymsb := by
    simp [u0,run,writeBit,hc L.sourceGuard (by simp [work])]
  have r0 : regValue L.r u0.basis=encodeWord 256 R := by
    apply Eq.trans _ (word_encoding L.r 256 w.2.1 s.basis R hR)
    exact regValue_congr _ _ _ (fun a ha => f0 a
      (fun e => flagR L.sourceGuard (by simp) (e ▸ ha)))
  have y0 : regValue L.y u0.basis=encodeWord 256 Y := by
    apply Eq.trans _ (word_encoding L.y 256 w.2.2.1 s.basis Y hY)
    exact regValue_congr _ _ _ (fun a ha => f0 a (neq a (by simp [ha]) _ (by simp)))
  have z0 (a : Wire) (ha : a∈work L) (hg : a≠L.sourceGuard) : u0.basis a=false :=
    (f0 a hg).trans (hc a ha)
  have pre := recoverPrefix_correct L hw cnd R Y B hr hy u0 m r0 y0
    ((f0 _ (by assumption)).trans hs) (z0 _ (by simp [work]) (by assumption))
    (z0 _ (by simp [work]) (by assumption))
    (fun a ha => z0 a (by simp [work,ha]) (neq a (by simp [ha]) _ (by simp)))
  have p1 : u1.basis L.parity=P := by
    rw [pre.2.2.2.1,z0 _ (by simp [work]) (by assumption),par]
    exact Bool.false_xor P
  have view := unbiasView_correct L hw cnd R hr u1 m1 pre.2.1 pre.2.2.1
  have f2 (a : Wire) (ar : a∉L.r) (al : a≠L.lower) (ap : a≠L.parity) : u2.basis a=u0.basis a :=
    (view.2.2.2 a ar al).trans (pre.2.2.2.2 a ar al ap)
  have p2 : u2.basis L.parity=P :=
    (view.2.2.2 _ (flagR _ (by simp)) (by assumption)).trans p1
  have r2 : regValue L.r u2.basis=encodeWord 256 (biased (halfResult T)) := by
    rw [half]; exact view.2.1
  have restore := ShortBiasedInverse.restoreRaw_correct L hw hn T ht u2 m2 p2 r2 view.2.2.1
    ((f2 _ (flagR _ (by simp)) (by assumption) (by assumption)).trans (z0 _ (by simp [work]) (by assumption)))
    ((f2 _ (flagR _ (by simp)) (by assumption) (by assumption)).trans (z0 _ (by simp [work]) (by assumption)))
    (fun a ha => (f2 a (nr a (by simp [ha])) (neq a (by simp [ha]) _ (by simp))
      (neq a (by simp [ha]) _ (by simp))).trans
      (z0 a (by simp [work,ha]) (neq a (by simp [ha]) _ (by simp))))
  have f3 (a : Wire) (ar : a∉rawTarget L) (al : a≠L.lower) (am : a≠L.minus)
      (ap : a≠L.parity) : u3.basis a=u0.basis a :=
    (restore.2.2.2.2 a ar al am).trans
      (f2 a (fun h => ar (by simp [rawTarget,h])) al ap)
  have g3 : u3.basis L.sourceGuard=u3.basis L.ymsb := by
    have g := (f3 _ (away _ (by simp)) (by assumption) (by assumption) (by assumption)).trans g0
    have y := (f3 L.ymsb (away _ (by simp [BalancedCleanup.Layout.y]))
      (by assumption) (by assumption) (by assumption)).trans (f0 _ (by assumption))
    exact g.trans y.symm
  have carry3 : regValue L.carry u3.basis=0 := by
    apply (regValue_zero _ _).mpr
    intro a ha
    exact (f3 a (away a (by simp [ha])) (neq a (by simp [ha]) _ (by simp))
      (neq a (by simp [ha]) _ (by simp)) (neq a (by simp [ha]) _ (by simp))).trans
      (z0 a (by simp [work,ha]) (neq a (by simp [ha]) _ (by simp)))
  have actual : run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)=u3 := by
    simp only [inversePrefix,List.append_assoc,run_append,run_take]
    change run (ShortBiasedInverse.restoreRaw L) m2 (run (unbiasView L) m1
      (run (recoverPrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)))=u3
    have ce : run [.CX L.ymsb L.sourceGuard] [] s=u0:=by simp only [u0,run]
    rw [ce]
  have p3 : u3.basis L.parity=P :=
    (restore.2.2.2.2 _ (away _ (by simp)) (by assumption) (by assumption)).trans p2
  have r3 : u3.basis L.r0=P := by
    have raw : signedRegValue (rawTarget L) u3.basis=T := by
      unfold signedRegValue
      rw [rwid.2.1,restore.2.1]
      apply decode_encodeWord 257 (by norm_num)
      have constants := BalancedField.constants
      norm_num at ⊢
      omega
    apply word_parity L.r0 (L.rtail++[L.rmsb,L.one]) u3.basis T
    simpa [rawTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,List.append_assoc] using raw
  rw [actual]
  exact ⟨carry3,g3,p3.trans r3.symm⟩
end ECDSAAdd.Entrant.GuardCompression

end

section
-- Parity/top-carry follow-up helper InverseParityUnseeded
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

theorem inverse_prefix_parity_unseeded (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    let t:=run (inversePrefix L) m s
    regValue L.carry t.basis=0 ∧ t.basis L.parity=t.basis L.r0 := by
  have ready := inverse_prefix_parity_ready L hw hn B R Y hr hy s m hs hR hY hc
  have free : L.sourceGuard∉wires (inversePrefix L) := by
    intro bad
    apply (guard_free L hw hn).2
    have sub : wires (inversePrefix L)⊆wires (inverse L) := by
      simp only [inversePrefix,inverse,wires_append]
      intro q hq
      simp only [Finset.mem_union] at hq ⊢
      tauto
    exact sub bad
  have apart : OneReuse.Apart L.sourceGuard s (run [.CX L.ymsb L.sourceGuard] [] s) := by
    refine ⟨by simp [run],?_⟩
    intro q hq
    simp [run,writeBit,Function.update_of_ne hq]
  have out := OneReuse.away_congr L.sourceGuard (inversePrefix L) free s _ m apart
  have nd := scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have cp (a : Wire) (ha : a∈L.carry) : a≠L.sourceGuard := by
    intro eq
    exact flagAway L hn L.sourceGuard (by simp) (by simp [←eq,ha])
  have reg : regValue L.carry (run (inversePrefix L) m s).basis=
      regValue L.carry (run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)).basis :=
    regValue_congr _ _ _ (fun a ha=>out.2 a (cp a ha))
  refine ⟨reg.trans ready.1,?_⟩
  exact (out.2 _ (by tauto)).trans (ready.2.2.trans (out.2 _ (by tauto)).symm)
end ECDSAAdd.Entrant.GuardCompression

end

section
-- Parity/top-carry follow-up helper BorrowInverse
namespace ECDSAAdd.Entrant.BigABorrowParity
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField GuardCompression
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

def inverseBorrow (L : BalancedCircuit.Layout) (last : Wire) : Program :=
  inversePrefix L ++ [.CX L.r0 L.parity] ++
    renameProgram (Equiv.swap last L.parity) (rawSubT L) ++ [.CX L.rmsb L.one]

/-- Complete inverse-tail phase transport. Its premises expose exactly the
arithmetic facts supplied by the old inverse contract and top-carry theorem. -/
theorem inverse_tail_eq (L : BalancedCircuit.Layout) (last : Wire) (s : State) (m : List Bool)
    (free : L.parity∉wires (rawSubT L))
    (same : s.basis L.parity=s.basis L.r0)
    (lp : last≠L.parity) (last0 : s.basis last=false)
    (lastout : (run (rawSubT L) m (run [.CX L.r0 L.parity] [] s)).basis last=false)
    (oldClears : (run [.CX L.r0 L.parity,.CX (L.ylow.getD 0 0) L.parity] []
      (run (rawSubT L) m s)).basis L.parity=false) :
    run ([.CX L.r0 L.parity] ++ renameProgram (Equiv.swap last L.parity) (rawSubT L) ++
      [.CX L.rmsb L.one]) m s =
    run (rawSubT L ++ (seed L).reverse) m s := by
  have eq := early_clear_tail (rawSubT L) L.r0 (L.ylow.getD 0 0) L.parity last
    s m free same lp last0 lastout oldClears
  have lift := congrArg (fun t=>run [.CX L.rmsb L.one] [] t) eq
  simpa only [List.append_assoc,run_append,run_take,show measurementCount
    [.CX L.r0 L.parity]=0 from rfl,List.take_zero,List.drop_zero,
    seed,List.reverse_cons,List.reverse_nil,List.nil_append,List.cons_append,
    List.singleton_append,run] using lift
end ECDSAAdd.Entrant.BigABorrowParity

end

section
-- Parity/top-carry follow-up helper BorrowActual
namespace ECDSAAdd.Entrant.BigABorrowParity
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField GuardCompression
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

theorem rawTop_parity_free (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.parity∉wires (rawSubT L) := by
  have nd := scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have away := flagAway L hn L.parity (by simp)
  have ps : L.parity≠L.sign := by tauto
  have po : L.parity≠L.one := by tauto
  have sourceFree : L.parity∉source L := fun h=>away (by simpa [source,List.mem_append] using Or.inr (Or.inl (source_sub L _ h)))
  have targetFree : L.parity∉rawTarget L := by
    simp only [rawTarget,List.mem_append,List.mem_singleton]
    exact not_or.mpr ⟨fun h=>away (by simp [h]),po⟩
  have cy : L.parity∉L.y := fun h=>away (by simp [h])
  have cc : L.parity∉L.carry := fun h=>away (by simp [h])
  intro used
  simp only [rawSubT,wires_append,Finset.mem_union] at used
  rcases used with (h|h)|h
  · have bad := signComplement_wires_subset L.sign L.y h
    simp [ps,cy] at bad
  · have bad := TopCarry.subInPlaceTop_wires (source L) (rawTarget L) L.carry L.sign h
    simp [ps,sourceFree,targetFree,cc] at bad
  · have bad := signComplement_wires_subset L.sign L.y h
    simp [ps,cy] at bad

theorem inverseBorrow_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (last : Wire) (hlast : last∈L.carry)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (inverseBorrow L last) m s=run (GuardCompression.inverse L) m s := by
  obtain ⟨v,hv⟩ : ∃v:State,run (inversePrefix L) m s=v := ⟨_,rfl⟩
  let r:=m.drop (measurementCount (inversePrefix L))
  have ready:=inverse_prefix_parity_unseeded L hw hn B R Y hr hy s m hs hR hY hc
  rw [hv] at ready
  have actual : run (GuardCompression.inverse L) m s=
      run (rawSub L++(seed L).reverse) r v := by
    have shape : GuardCompression.inverse L=inversePrefix L++(rawSub L++(seed L).reverse) := by
      simp only [GuardCompression.inverse,inversePrefix,List.append_assoc]
    rw [shape,run_append,run_take,hv]
  have old:=GuardCompression.inverse_correct L hw hn B R Y hr hy s m hs hR hY hc
  rw [actual] at old
  have nd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have parOne : L.parity≠L.one := by tauto
  have rmsbOne : L.rmsb≠L.one := by tauto
  have rmsbPar : L.rmsb≠L.parity := by tauto
  have r0One : L.r0≠L.one := by tauto
  have lowYOne : L.ylow.getD 0 0≠L.one := by
    have mem : L.ylow.getD 0 0∈L.ylow := by
      rw [List.getD_eq_getElem _ _ (by have:=hw.2.1; omega)]
      exact List.getElem_mem _
    intro eq
    apply flagAway L hn L.one (by simp)
    simp only [List.mem_append]
    apply Or.inl; apply Or.inr
    rw [←eq]
    simp only [BalancedCleanup.Layout.y,List.mem_append,List.mem_singleton]
    exact Or.inl mem
  have peelOne (t : State) (ms : List Bool) :
      (run (seed L).reverse ms t).basis L.one=(t.basis L.one ^^ t.basis L.rmsb) := by
    simp [seed,run,writeBit,Function.update_of_ne,Ne.symm parOne,parOne,
      rmsbPar,Ne.symm rmsbPar,rmsbOne,r0One,lowYOne]
  have cond : (run (rawSub L) r v).basis L.one=(run (rawSub L) r v).basis L.rmsb := by
    have one:=old.2.2.1 L.one (by simp [work])
    simp only [run_append,run_take] at one
    rw [peelOne] at one
    revert one
    generalize (run (rawSub L) r v).basis L.one=a
    generalize (run (rawSub L) r v).basis L.rmsb=b
    cases a <;> cases b <;> decide
  have topEq:=rawSubT_eq L hw hn v r ((regValue_zero _ _).mp ready.1) cond
  have free:=rawTop_parity_free L hn
  have lp : last≠L.parity := by
    intro eq
    exact flagAway L hn L.parity (by simp) (by simp [←eq,hlast])
  have lastT : last∉rawTarget L := by
    have facts:=rawFacts L hn
    have d:List.Disjoint (rawTarget L) L.carry :=
      (List.nodup_append'.mp (List.nodup_cons.mp facts.2.2).2).2.2
    exact fun h=>List.disjoint_left.mp d h hlast
  have last0 : v.basis last=false := (regValue_zero _ _).mp ready.1 last hlast
  have lastAfter : (run (rawSubT L) r v).basis last=false := by
    rw [topEq]
    exact ((rawSub_correct L hw hn v r ready.1).2.1 last lastT).trans last0
  have apart : OneReuse.Apart L.parity (run [.CX L.r0 L.parity] [] v) v := by
    refine ⟨by simp [run],?_⟩
    intro q hq
    simp [run,writeBit,Function.update_of_ne hq]
  have rel:=OneReuse.away_congr L.parity (rawSubT L) free _ v r apart
  have lastout : (run (rawSubT L) r (run [.CX L.r0 L.parity] [] v)).basis last=false :=
    (rel.2 last lp).trans lastAfter
  have oldClears : (run [.CX L.r0 L.parity,.CX (L.ylow.getD 0 0) L.parity] []
      (run (rawSubT L) r v)).basis L.parity=false := by
    rw [topEq]
    have par:=old.2.2.1 L.parity (by simp [work])
    simpa only [run_append,run_take,seed,List.reverse_cons,List.reverse_nil,List.nil_append,
      List.cons_append,List.singleton_append,run,writeBit,Function.update_of_ne parOne] using par
  have eq:=inverse_tail_eq L last v r free ready.2 lp last0 lastout oldClears
  have shape : inverseBorrow L last=inversePrefix L++([.CX L.r0 L.parity] ++
      renameProgram (Equiv.swap last L.parity) (rawSubT L) ++ [.CX L.rmsb L.one]) := by
    simp only [inverseBorrow,List.append_assoc]
  rw [shape,run_append,run_take,hv,eq,actual]
  simp only [run_append,run_take]
  rw [topEq]
  have counts : measurementCount (rawSubT L)=measurementCount (rawSub L) := by
    have w:=BalancedCircuit.widths L hw
    have a:=TopCarry.subInPlaceTop_counts 255 (source L) (rawTarget L) L.carry L.sign
      (by rw [w.2.1]) (by rw [source_len,w.1,w.2.1]) (by rw [hw.2.2,w.2.1])
    have b:=raw_counts L hw
    simp only [rawSubT,measurementCount_append,a.2,(signComplement_counts _ _).2]
    omega
  rw [counts]
end ECDSAAdd.Entrant.BigABorrowParity

end

section
-- Parity/top-carry follow-up helper BorrowResources
namespace ECDSAAdd.Entrant.BigABorrowParity
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField GuardCompression
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] wires

def borrowTail (L : BalancedCircuit.Layout) (last : Wire) : Program :=
  [.CX L.r0 L.parity] ++ renameProgram (Equiv.swap last L.parity) (rawSubT L) ++
    [.CX L.rmsb L.one]

theorem borrowTail_counts (L : BalancedCircuit.Layout) (hw : L.Widths) (last : Wire) :
    toffoliCount (borrowTail L last)=255 ∧ measurementCount (borrowTail L last)=256 := by
  have w:=BalancedCircuit.widths L hw
  have a:=TopCarry.subInPlaceTop_counts 255 (source L) (rawTarget L) L.carry L.sign
    (by rw [w.2.1]) (by rw [source_len,w.1,w.2.1]) (by rw [hw.2.2,w.2.1])
  have raw : toffoliCount (rawSubT L)=255 ∧ measurementCount (rawSubT L)=256 := by
    simp only [rawSubT,toffoliCount_append,measurementCount_append,a.1,a.2,
      (signComplement_counts _ _).1,(signComplement_counts _ _).2]
    norm_num
  have r:=renameProgram_counts (Equiv.swap last L.parity) (rawSubT L)
  simp only [borrowTail,toffoliCount_append,measurementCount_append]
  rw [r.1,r.2,raw.1,raw.2]
  norm_num [toffoliCount,measurementCount]

theorem swap_removes (P : Program) (last p : Wire) (free : p∉wires P) :
    last∉wires (renameProgram (Equiv.swap last p) P) := by
  rw [renameProgram_support]
  intro h
  obtain ⟨q,hq,eq⟩:=Finset.mem_image.mp h
  have qeq : q=p := (Equiv.swap last p).injective (eq.trans (Equiv.swap_apply_right last p).symm)
  subst q
  exact free hq

theorem borrowTail_last_free (L : BalancedCircuit.Layout) (hn : L.wires.Nodup)
    (last : Wire) (hlast : last∈L.carry) : last∉wires (borrowTail L last) := by
  have nd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have neq (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one]) :
      last≠q := fun eq=>flagAway L hn q hq (by simp [←eq,hlast])
  have lastR : last∉L.r := by
    have all:=allND L hn
    have tail: (L.r++L.y++L.carry).Nodup := (List.nodup_append'.mp all).2.1
    have dis:List.Disjoint L.r L.carry := by
      exact (List.disjoint_append_left.mp (List.nodup_append'.mp tail).2.2).1
    exact fun h=>List.disjoint_left.mp dis h hlast
  have lr0 : last≠L.r0 := fun eq=>lastR (by simp [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,eq])
  have lrmsb : last≠L.rmsb := fun eq=>lastR (by simp [BalancedCleanup.Layout.r,eq])
  have lp:=neq L.parity (by simp)
  have lo:=neq L.one (by simp)
  have noRaw:=swap_removes (rawSubT L) last L.parity (rawTop_parity_free L hn)
  simp only [borrowTail,wires_append,Finset.mem_union,not_or]
  refine ⟨⟨?_,noRaw⟩,?_⟩
  · simp [wires,Instr.wires,lr0,lp]
  · simp [wires,Instr.wires,lrmsb,lo]

/-- A checked replacement prefix can be grafted without opening its circuit. -/
theorem checked_head_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (last : Wire) (hlast : last∈L.carry) (head : Program)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false)
    (eq : run head m s=run (inversePrefix L) m s)
    (count : measurementCount head=measurementCount (inversePrefix L)) :
    run (head++borrowTail L last) m s=run (GuardCompression.inverse L) m s := by
  have shape : inverseBorrow L last=inversePrefix L++borrowTail L last := by
    simp only [inverseBorrow,borrowTail,List.append_assoc]
  rw [←inverseBorrow_eq L hw hn last hlast B R Y hr hy s m hs hR hY hc,shape]
  simp only [run_append,run_take]
  rw [count,eq]

/-- Any prefix already avoiding the old carry retains that omission. -/
theorem checked_head_free (L : BalancedCircuit.Layout) (hn : L.wires.Nodup)
    (last : Wire) (hlast : last∈L.carry) (head : Program) (free : last∉wires head) :
    last∉wires (head++borrowTail L last) := by
  simp only [wires_append,Finset.mem_union,not_or]
  exact ⟨free,borrowTail_last_free L hn last hlast⟩

def oneReuseHead (L : BalancedCircuit.Layout) : Program :=
  BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L++OneReuse.restoreRaw L

theorem oneReuseHead_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    measurementCount (oneReuseHead L)=measurementCount (inversePrefix L) := by
  simp only [oneReuseHead,inversePrefix,measurementCount_append,OneReuse.restore_measurements L hw]

theorem oneReuseHead_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (oneReuseHead L) m s=run (inversePrefix L) m s := by
  let first:=BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L
  have clean:=OneReuse.inverse_view_clean L hw hn B R Y hr hy s m hs hR hY hc
  have eq:=OneReuse.restoreRaw_eq L hw hn (run first m s)
    (m.drop (measurementCount first)) clean.1 clean.2
  change run (first++OneReuse.restoreRaw L) m s=
    run (first++ShortBiasedInverse.restoreRaw L) m s
  simp only [run_append,run_take]
  exact eq
end ECDSAAdd.Entrant.BigABorrowParity

end

section
-- Parity/top-carry follow-up helper TopChainBorrow
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.TopCarryBorrow
open ECDSAAdd.Arithmetic FieldRename CarryBorrow
attribute [local irreducible] run wires compareChain majority eraseCarry

def headChainTop (a b c cin target : Wire) (xs ys cs : List Wire) : Program :=
  majority a b cin c++[.X cin]++TopCarry.compareChainTop xs ys (cs++[cin]) c target++
    [.X cin]++eraseCarry a b cin c

private theorem topcarry_TopChainBorrow_map_fixed (f : Wire → Wire) (xs : List Wire) (h : ∀q∈xs,f q=q) : xs.map f=xs := by
  induction xs with
  | nil=>rfl
  | cons x xs ih=>
    simp only [List.map_cons]
    rw [h x (by simp),ih (fun q hq=>h q (by simp [hq]))]

theorem chain_rename (a b c cin target last : Wire) (xs ys cs : List Wire)
    (nd : (target::cin::((a::xs)++(b::ys)++(c::(cs++[last])))).Nodup) :
    renameProgram (Equiv.swap cin last) (TopCarry.compareChainTop xs ys (cs++[last]) c target)=
      TopCarry.compareChainTop xs ys (cs++[cin]) c target := by
  let f:=Equiv.swap cin last
  have all : (cin::last::(target::c::xs++ys++cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q;have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have away : ∀q∈target::c::xs++ys++cs,q≠cin ∧ q≠last := by
    intro q hq
    have count:=List.nodup_iff_count.mp all q
    have pos:=List.count_pos_iff.mpr hq
    simp only [List.count_cons] at count
    constructor <;> intro eq <;> subst q <;> simp_all
  have fix (q : Wire) (hq : q∈target::c::xs++ys++cs) : f q=q :=
    Equiv.swap_apply_of_ne_of_ne (away q hq).1 (away q hq).2
  have mx : xs.map f=xs := topcarry_TopChainBorrow_map_fixed f xs (fun q hq=>fix q (by simp [hq]))
  have my : ys.map f=ys := topcarry_TopChainBorrow_map_fixed f ys (fun q hq=>fix q (by simp [hq]))
  have mc : cs.map f=cs := topcarry_TopChainBorrow_map_fixed f cs (fun q hq=>fix q (by simp [hq]))
  have fl : f last=cin := Equiv.swap_apply_right cin last
  change renameProgram f _=_
  rw [TopCarry.compareChainTop_natural,mx,my,List.map_append,mc]
  simp only [List.map_cons,List.map_nil,fl,Option.map_none]
  rw [fix c (by simp),fix target (by simp)]

theorem headChainTop_eq (a b c cin target last : Wire) (xs ys cs : List Wire)
    (nd : (target::cin::((a::xs)++(b::ys)++(c::(cs++[last])))).Nodup)
    (hx : xs.length=ys.length) (hc : (cs++[last]).length=ys.length)
    (s : State) (m : List Bool) (hi : s.basis cin=true)
    (clean : ∀q∈cs++[last],s.basis q=false) (hy : ys≠[])
    (htop : let u:=run (majority a b cin c) [] s
      u.basis target = !decide (2^ys.length ≤ regValue xs u.basis + regValue ys u.basis + (u.basis c).toNat)) :
    run (headChainTop a b c cin target xs ys cs) m s=
      run (compareChain none (a::xs) (b::ys) (c::(cs++[last])) cin target) m s := by
  let P:=TopCarry.compareChainTop xs ys (cs++[last]) c target
  let u : State:=⟨s.phase,writeBit s.basis c
    (s.basis c ^^ carryBit (s.basis a) (s.basis b) (s.basis cin))⟩
  have nAll : (cin::(target::c::xs++ys++cs++[last])).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q;have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have n4 : [a,b,cin,c].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q;have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have ne : cin≠last := by
    intro eq
    have h:=List.nodup_iff_count.mp nAll last
    simp only [List.count_cons,List.count_append,List.count_nil,eq] at h
    simp at h
  have ct : last≠target := by
    intro eq
    have h:=List.nodup_iff_count.mp nAll last
    simp only [List.count_cons,List.count_append,List.count_nil,←eq] at h
    simp at h; omega
  have ic : cin≠c := by
    intro eq
    have h:=List.nodup_iff_count.mp nAll c
    simp only [List.count_cons,List.count_append,List.count_nil,eq] at h
    simp at h
  have qc (q : Wire) (hq : q∈cs++[last]) : q≠c := by
    intro eq
    have pos:=List.count_pos_iff.mpr hq
    have h:=List.nodup_iff_count.mp nAll q
    simp only [List.count_cons,List.count_append,List.count_nil,←eq] at h
    simp only [List.count_append,List.count_cons,List.count_nil] at pos
    simp only [beq_iff_eq] at pos
    simp at h; omega
  have free : cin∉wires P := by
    change cin∉wires (TopCarry.compareChainTop xs ys (cs++[last]) c target)
    intro used
    have used':=TopCarry.compareChainTop_wires xs ys (cs++[last]) c target used
    have h:=(List.nodup_cons.mp nAll).1
    simp only [List.mem_toFinset,List.nil_append,List.mem_cons,List.mem_append,List.not_mem_nil,or_false,not_or] at h used'
    tauto
  have hu : u.basis cin=true := by simp [u,writeBit,Function.update,ic,hi]
  have cu (q : Wire) (hq : q∈cs++[last]) : u.basis q=false := by
    simpa only [u,writeBit,Function.update_of_ne (qc q hq)] using clean q hq
  have tailnd : (target::c::(xs++ys++(cs++[last]))).Nodup := by
    simpa only [List.append_assoc] using (List.nodup_cons.mp nAll).2
  have result:=compareChain_correct none xs ys (cs++[last]) c target tailnd (by simp) hx hc u m cu
  have first (record : List Bool) : run (majority a b cin c) record s=u := by
    exact majority_correct a b cin c n4 s record
  have topEq : run P m u=run (compareChain none xs ys (cs++[last]) c target) m u := by
    apply TopCarry.compareChainTop_eq _ _ _ _ _ tailnd hx hc hy u m cu
    simpa only [first] using htop
  have reset : (run P m u).basis last=false := by
    rw [topEq]
    exact (result.2.1 last ct).trans (cu last (by simp))
  have same:=borrow_eq cin last P free ne u m hu (cu last (by simp)) reset
  have bm : measurementCount (borrow cin last P)=measurementCount P := by
    simp only [borrow,measurementCount_append,(renameProgram_counts (Equiv.swap cin last) P).2]
    norm_num [measurementCount]
  have ns : headChainTop a b c cin target xs ys cs=
      majority a b cin c++(borrow cin last P++eraseCarry a b cin c) := by
    simp only [headChainTop,borrow,P,List.append_assoc]
    rw [chain_rename a b c cin target last xs ys cs nd]
  let Q:=compareChain none xs ys (cs++[last]) c target
  have os : compareChain none (a::xs) (b::ys) (c::(cs++[last])) cin target=
      majority a b cin c++(Q++eraseCarry a b cin c) := by simp only [Q,compareChain,List.append_assoc]
  have pq : measurementCount P=measurementCount Q := by
    exact TopCarry.compareChainTop_measurements xs ys (cs++[last]) c target hx hc hy
  have mc : measurementCount (majority a b cin c)=0 := by simp [majority,measurementCount]
  rw [ns,os]
  conv_lhs => rw [run_append,first,mc,List.drop_zero]
  conv_rhs => rw [run_append,first,mc,List.drop_zero]
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  rw [bm,same,pq,topEq]
end ECDSAAdd.Entrant.TopCarryBorrow

end

section
-- Parity/top-carry follow-up helper TopHeadCondition
namespace ECDSAAdd.Entrant.TopCarryBorrow
open ECDSAAdd.Arithmetic
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run

private theorem topcarry_TopHeadCondition_threshold (A B C : Bool) (X Y n : Nat) :
    (2^(n+1) ≤ (A.toNat+2*X)+(B.toNat+2*Y)+C.toNat) ↔
      (2^n ≤ X+Y+(carryBit A B C).toNat) := by
  have h:=fullAdder_bit_value A B C
  have bit:(sumBit A B C).toNat≤1 := by cases sumBit A B C <;> decide
  rw [pow_succ]
  omega

theorem head_condition (a b c cin target last : Wire) (xs ys cs : List Wire)
    (nd : (target::cin::((a::xs)++(b::ys)++(c::(cs++[last])))).Nodup)
    (s : State) (hz : s.basis c=false)
    (htop : s.basis target = !decide (2^(b::ys).length ≤
      regValue (a::xs) s.basis+regValue (b::ys) s.basis+(s.basis cin).toNat)) :
    let u:=run (majority a b cin c) [] s
    u.basis target = !decide (2^ys.length ≤ regValue xs u.basis+
      regValue ys u.basis+(u.basis c).toNat) := by
  have cnt:=List.nodup_iff_count.mp nd
  have four:[a,b,cin,c].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q;have h:=cnt q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have tc : target≠c := by
    intro eq;have h:=cnt c
    simp only [List.count_cons,List.count_append,List.count_nil,eq,beq_self_eq_true,if_true] at h
    omega
  have ac (q : Wire) (hq : q∈xs++ys) : q≠c := by
    intro eq
    have h:=cnt c
    have pos:=List.count_pos_iff.mpr hq
    simp only [List.count_cons,List.count_append,List.count_nil,←eq,beq_self_eq_true,if_true] at h
    simp only [List.count_append] at pos
    omega
  let u:State:=⟨s.phase,writeBit s.basis c (carryBit (s.basis a) (s.basis b) (s.basis cin))⟩
  have actual:run (majority a b cin c) [] s=u := by
    rw [majority_correct a b cin c four]
    simp only [hz,Bool.false_xor]
    rfl
  have frame(q : Wire)(hq:q≠c):u.basis q=s.basis q := by simp [u,writeBit,Function.update_of_ne hq]
  have xv:regValue xs u.basis=regValue xs s.basis := regValue_congr _ _ _ (fun q hq=>frame q (ac q (by simp [hq])))
  have yv:regValue ys u.basis=regValue ys s.basis := regValue_congr _ _ _ (fun q hq=>frame q (ac q (by simp [hq])))
  have cv:u.basis c=carryBit (s.basis a) (s.basis b) (s.basis cin) := by simp [u,writeBit]
  rw [actual]
  dsimp only
  rw [frame target tc,xv,yv,cv,htop]
  congr 2
  apply propext
  rw [TopCarry.regValue_cons',TopCarry.regValue_cons',List.length_cons,topcarry_TopHeadCondition_threshold]
end ECDSAAdd.Entrant.TopCarryBorrow

end

section
-- Parity/top-carry follow-up helper TopCompareBorrow
namespace ECDSAAdd.Entrant.TopCarryBorrow
open ECDSAAdd.Arithmetic
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

def compareHeadTop (a b c cin target : Wire) (xs ys cs : List Wire) : Program :=
  notRegister (cin::b::ys)++headChainTop a b c cin target xs ys cs++notRegister (cin::b::ys)

theorem compareHeadTop_eq (a b c cin target last : Wire) (xs ys cs : List Wire)
    (hnd : (target::cin::((a::xs)++(b::ys)++(c::(cs++[last])))).Nodup)
    (hxt : xs.length=ys.length) (hct : (cs++[last]).length=ys.length) (hy : ys≠[])
    (s : State) (m : List Bool) (hcin : s.basis cin=false)
    (hclean : ∀q∈c::(cs++[last]),s.basis q=false)
    (htgt : s.basis target=decide (regValue (a::xs) s.basis<regValue (b::ys) s.basis)) :
    run (compareHeadTop a b c cin target xs ys cs) m s=
      run (compareLt none (a::xs) (b::ys) (c::(cs++[last])) cin target) m s := by
  have hx:(a::xs).length=(b::ys).length := by simp [hxt]
  have hc:(c::(cs++[last])).length=(b::ys).length := by simp [hct]
  have hcnt := List.nodup_iff_count.mp hnd
  have hny : (cin :: (b::ys)).Nodup := by
    apply List.nodup_iff_count.mpr; intro w; have := hcnt w
    simp only [List.count_cons, List.count_append] at this ⊢; omega
  have htcy : target ∉ cin :: (b::ys) := fun h => by
    have h1 := hcnt target; have h2 := List.count_pos_iff.mpr h
    simp only [List.count_cons, List.count_append, beq_self_eq_true, if_true] at h1 h2; omega
  have hxcy : ∀ w ∈ (a::xs), w ∉ cin :: (b::ys) := fun w hw h => by
    have h1 := hcnt w; have h2 := List.count_pos_iff.mpr h; have h3 := List.count_pos_iff.mpr hw
    simp only [List.count_cons, List.count_append,List.count_nil] at h1 h2 h3; omega
  have hkcy : ∀ w ∈ (c::(cs++[last])), w ∉ cin :: (b::ys) := fun w hw h => by
    have h1 := hcnt w; have h2 := List.count_pos_iff.mpr h; have h3 := List.count_pos_iff.mpr hw
    simp only [List.count_cons, List.count_append,List.count_nil] at h1 h2 h3; omega
  let s1 : State := ⟨s.phase, fun w => if w ∈ cin :: (b::ys) then !s.basis w else s.basis w⟩
  have hfirst (record : List Bool) : run (notRegister (cin :: (b::ys))) record s = s1 :=
    notRegister_correct _ hny s record
  have hclean1 : ∀ w ∈ (c::(cs++[last])), s1.basis w = false := fun w hw => by
    simp [s1, hkcy w hw, hclean w hw]
  have hx1 : regValue (a::xs) s1.basis = regValue (a::xs) s.basis :=
    regValue_congr _ _ _ (fun w hw => by simp [s1, hxcy w hw])
  have hy1 : regValue (b::ys) s1.basis = 2^(b::ys).length - 1 - regValue (b::ys) s.basis := by
    rw [regValue_congr (b::ys) _ (fun w => !s.basis w) (by intro w hw; simp [s1, hw]), regValue_complement]
  have hcin1 : s1.basis cin = true := by simp [s1, hcin]
  have htgt1 : s1.basis target = s.basis target := by simp [s1, htcy]
  have hX : regValue (a::xs) s.basis < 2^(b::ys).length := by
    have := regValue_lt (a::xs) s.basis; rwa [hx] at this
  have hY : regValue (b::ys) s.basis < 2^(b::ys).length := regValue_lt (b::ys) s.basis
  have htop : s1.basis target =
      !decide (2^(b::ys).length ≤ regValue (a::xs) s1.basis + regValue (b::ys) s1.basis + (s1.basis cin).toNat) := by
    rw [htgt1, hx1, hy1, hcin1, htgt]
    have hiff : (2^(b::ys).length ≤ regValue (a::xs) s.basis + (2^(b::ys).length - 1 - regValue (b::ys) s.basis) + true.toNat) ↔
        regValue (b::ys) s.basis ≤ regValue (a::xs) s.basis := by
      simp only [Bool.toNat_true]; omega
    rw [decide_eq_decide.mpr hiff, ← decide_not]
    exact decide_eq_decide.mpr Nat.not_le.symm
  have hmc : measurementCount (headChainTop a b c cin target xs ys cs)=
      measurementCount (compareChain none (a::xs) (b::ys) (c::(cs++[last])) cin target) := by
    have t:=TopCarry.compareChainTop_counts xs ys (cs++[cin]) c target hxt
      (by simpa using hct) hy
    have old:=(compareChain_counts none (a::xs) (b::ys) (c::(cs++[last])) cin target hx hc).2
    simp only [headChainTop,measurementCount_append,t.2,old]
    norm_num [majority,eraseCarry,measurementCount]
  have hm0 : measurementCount (notRegister (cin::b::ys))=0 := (notRegister_counts _).2
  simp only [compareHeadTop,compareLt]
  apply TopCarry.run_mid_congr _ _ _ _ m s hm0 hmc
  intro record
  rw [hfirst]
  apply headChainTop_eq a b c cin target last xs ys cs hnd hxt hct s1 record hcin1
    (fun q hq=>hclean1 q (List.mem_cons_of_mem c hq)) hy
  apply head_condition a b c cin target last xs ys cs hnd s1 (hclean1 c (by simp)) htop
end ECDSAAdd.Entrant.TopCarryBorrow

end

section
-- Parity/top-carry follow-up helper TopCompareResources
namespace ECDSAAdd.Entrant.TopCarryBorrow
open ECDSAAdd.Arithmetic
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] wires

theorem compareHeadTop_counts (a b c cin target : Wire) (xs ys cs : List Wire)
    (hx : xs.length=ys.length) (hc : (cs++[cin]).length=ys.length) (hy : ys≠[]) :
    toffoliCount (compareHeadTop a b c cin target xs ys cs)+1=(b::ys).length ∧
      measurementCount (compareHeadTop a b c cin target xs ys cs)=(b::ys).length := by
  have t:=TopCarry.compareChainTop_counts xs ys (cs++[cin]) c target hx hc hy
  have n:=notRegister_counts (cin::b::ys)
  simp only [compareHeadTop,headChainTop,toffoliCount_append,measurementCount_append,
    n.1,n.2]
  norm_num [majority,eraseCarry,toffoliCount,measurementCount] at t ⊢
  omega

theorem headChainTop_support (a b c cin target : Wire) (xs ys cs : List Wire) :
    wires (headChainTop a b c cin target xs ys cs)⊆
      (target::cin::a::b::c::xs++ys++cs).toFinset := by
  have main:=TopCarry.compareChainTop_wires xs ys (cs++[cin]) c target
  have maj : wires (majority a b cin c)={a,b,cin,c} := by
    ext q; simp [majority,wires,Instr.wires]; tauto
  intro q hq
  simp only [headChainTop,wires_append,Finset.mem_union,maj,eraseCarry_wires] at hq
  simp only [List.mem_toFinset,List.mem_cons,List.mem_append]
  rcases hq with (((h|h)|h)|h)|h
  · simp only [Finset.mem_insert,Finset.mem_singleton] at h; tauto
  · simp [wires,Instr.wires] at h; tauto
  · have h':=main h
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append,List.mem_singleton] at h'
    tauto
  · simp [wires,Instr.wires] at h; tauto
  · simp only [Finset.mem_insert,Finset.mem_singleton] at h; tauto

theorem compareHeadTop_support (a b c cin target : Wire) (xs ys cs : List Wire) :
    wires (compareHeadTop a b c cin target xs ys cs)⊆
      (target::cin::a::b::c::xs++ys++cs).toFinset := by
  intro q hq
  simp only [compareHeadTop,wires_append,Finset.mem_union,notRegister_wires] at hq
  rcases hq with (h|h)|h
  · simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at h ⊢; tauto
  · exact headChainTop_support a b c cin target xs ys cs h
  · simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at h ⊢; tauto

theorem compareHeadTop_last_free (a b c cin target last : Wire) (xs ys cs : List Wire)
    (nd : (target::cin::((a::xs)++(b::ys)++(c::(cs++[last])))).Nodup) :
    last∉wires (compareHeadTop a b c cin target xs ys cs) := by
  intro used
  have pos:=List.count_pos_iff.mpr (List.mem_toFinset.mp (compareHeadTop_support a b c cin target xs ys cs used))
  have count:=List.nodup_iff_count.mp nd last
  simp only [List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at pos count
  omega
end ECDSAAdd.Entrant.TopCarryBorrow

end

section
-- Parity/top-carry follow-up helper TopCompareProgram
namespace ECDSAAdd.Entrant.TopCarryBorrow
open ECDSAAdd.Arithmetic
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

def compare : List Wire → List Wire → List Wire → Wire → Wire → Program
  | a::xs,b::ys,c::cs,cin,target=>compareHeadTop a b c cin target xs ys cs
  | _,_,_,_,_=>[]

theorem compare_eq (xs ys spine : List Wire) (cin target last : Wire)
    (hn : spine≠[]) (nd : (target::cin::(xs++ys++(spine++[last]))).Nodup)
    (hx : xs.length=ys.length) (hc : spine.length+1=ys.length) (hy : 2≤ys.length)
    (s : State) (m : List Bool) (hi : s.basis cin=false)
    (clean : ∀q∈spine++[last],s.basis q=false)
    (ht : s.basis target=decide (regValue xs s.basis<regValue ys s.basis)) :
    run (compare xs ys spine cin target) m s=
      run (compareLt none xs ys (spine++[last]) cin target) m s := by
  cases spine with
  | nil=>exact False.elim (hn rfl)
  | cons c cs=>
    cases xs with
    | nil=>simp at hx; simp [←hx] at hc
    | cons a xs=>
      cases ys with
      | nil=>simp at hx
      | cons b ys=>
        exact compareHeadTop_eq a b c cin target last xs ys cs nd
          (by simpa using hx) (by simpa using hc)
          (by intro eq; simp [eq] at hy) s m hi
          (fun q hq=>clean q hq) ht

theorem compare_counts (xs ys spine : List Wire) (cin target : Wire)
    (hn : spine≠[]) (hx : xs.length=ys.length) (hc : spine.length+1=ys.length)
    (hy : 2≤ys.length) :
    toffoliCount (compare xs ys spine cin target)+1=ys.length ∧
      measurementCount (compare xs ys spine cin target)=ys.length := by
  cases spine with
  | nil=>exact False.elim (hn rfl)
  | cons c cs=>
    cases xs with
    | nil=>simp at hx; simp [←hx] at hc
    | cons a xs=>
      cases ys with
      | nil=>simp at hx
      | cons b ys=>
        exact compareHeadTop_counts a b c cin target xs ys cs (by simpa using hx)
          (by simpa using hc) (by intro eq; simp [eq] at hy)

def program (L : BalancedCircuit.Layout) : Program :=
  compare L.y L.r (L.carry.take 255) L.one L.parity

private theorem topcarry_TopCompareProgram_carry_split (L : BalancedCircuit.Layout) (hw : L.Widths) :
    L.carry=L.carry.take 255++[L.carry.getD 255 0] := by
  have idx : 255<L.carry.length := by rw [hw.2.2]; omega
  have split : L.carry.take 255++[L.carry.getD 255 0]=L.carry.take 256 := by
    conv_rhs=>rw [show 256=255+1 from rfl,List.take_add_one]
    rw [List.getD_eq_getElem _ _ idx,List.getElem?_eq_getElem idx]
    rfl
  rw [split,←hw.2.2]
  simp

theorem program_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hi : s.basis L.one=false)
    (clean : ∀q∈L.carry,s.basis q=false)
    (ht : s.basis L.parity=decide (regValue L.y s.basis<regValue L.r s.basis)) :
    run (program L) m s=run (compareLt none L.y L.r L.carry L.one L.parity) m s := by
  have nd : (L.parity::L.one::(L.y++L.r++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q;have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have w:=BalancedCleanup.widths L.toLayout hw
  have split:=topcarry_TopCompareProgram_carry_split L hw
  have len : (L.carry.take 255).length=255 := by simp [List.length_take,hw.2.2]
  have ne : L.carry.take 255≠[] := by intro eq; simp [eq] at len
  have eq:=compare_eq L.y L.r (L.carry.take 255) L.one L.parity (L.carry.getD 255 0) ne
    (by rw [←split];exact nd) (w.2.2.1.trans w.2.1.symm)
    (by rw [len,w.2.1]) (by rw [w.2.1]; decide) s m hi (by rw [←split];exact clean) ht
  simpa only [program,←split] using eq

theorem program_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (program L)=255 ∧ measurementCount (program L)=256 := by
  have w:=BalancedCleanup.widths L.toLayout hw
  have len : (L.carry.take 255).length=255 := by simp [List.length_take,hw.2.2]
  have ne : L.carry.take 255≠[] := by intro eq;simp [eq] at len
  have h:=compare_counts L.y L.r (L.carry.take 255) L.one L.parity ne
    (w.2.2.1.trans w.2.1.symm) (by rw [len,w.2.1]) (by rw [w.2.1]; decide)
  rw [w.2.1] at h
  change toffoliCount (compare L.y L.r (L.carry.take 255) L.one L.parity)=255 ∧
    measurementCount (compare L.y L.r (L.carry.take 255) L.one L.parity)=256
  omega

theorem compare_last_free (xs ys spine : List Wire) (cin target last : Wire)
    (nd : (target::cin::(xs++ys++(spine++[last]))).Nodup) :
    last∉wires (compare xs ys spine cin target) := by
  cases xs with
  | nil=>simp [compare,wires]
  | cons a xs=>
    cases ys with
    | nil=>simp [compare,wires]
    | cons b ys=>
      cases spine with
      | nil=>simp [compare,wires]
      | cons c cs=>exact compareHeadTop_last_free a b c cin target last xs ys cs nd

theorem program_last_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 255 0∉wires (program L) := by
  have nd : (L.parity::L.one::(L.y++L.r++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q;have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  apply compare_last_free
  rw [←topcarry_TopCompareProgram_carry_split L hw]
  exact nd
end ECDSAAdd.Entrant.TopCarryBorrow

end

section
-- Parity/top-carry follow-up helper TopCompareAdapters
namespace ECDSAAdd.Entrant.TopCarryBorrow
open ECDSAAdd.Arithmetic FieldRename RecordedQuantum
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
set_option linter.unusedSimpArgs false
attribute [local irreducible] wires

theorem head_natural (f : Wire→Wire) (a b c cin target : Wire) (xs ys cs : List Wire) :
    renameProgram f (headChainTop a b c cin target xs ys cs)=
      headChainTop (f a) (f b) (f c) (f cin) (f target) (xs.map f) (ys.map f) (cs.map f) := by
  simp only [headChainTop,rename_append,majority_natural,eraseCarry_natural,
    TopCarry.compareChainTop_natural,List.map_append,List.map_cons,List.map_nil]
  rfl

theorem compare_natural (f : Wire→Wire) (xs ys cs : List Wire) (cin target : Wire) :
    renameProgram f (compare xs ys cs cin target)=compare (xs.map f) (ys.map f) (cs.map f) (f cin) (f target) := by
  cases xs <;> cases ys <;> cases cs <;> simp only [compare,List.map_nil,List.map_cons]
  all_goals first
    | simp only [compareHeadTop,rename_append,notRegister_natural,head_natural,List.map_cons]
    | rfl

theorem program_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (program L)=program (mapCircuit f L) := by
  simpa [program,mapCircuit,mapCleanup,BalancedCleanup.Layout.y,BalancedCleanup.Layout.r,
    BalancedCleanup.Layout.low,List.map_take,List.map_append] using
      compare_natural f L.y L.r (L.carry.take 255) L.one L.parity

theorem head_physical (a b c cin target : Wire) (xs ys cs : List Wire)
    (nd : (target::cin::a::b::c::(xs++ys++cs)).Nodup) :
    GatePhysical (headChainTop a b c cin target xs ys cs) := by
  have hm : [a,b,cin,c].Nodup := by
    apply List.nodup_iff_count.mpr; intro q
    have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
  have ht : (target::c::(xs++ys++(cs++[cin]))).Nodup := by
    apply List.nodup_iff_count.mpr; intro q
    have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
  have tail:=TopCarry.compareChainTop_physical xs ys (cs++[cin]) c target ht
  simp only [headChainTop,gatePhysical_append]
  exact ⟨⟨⟨⟨majority_physical _ _ _ _ hm,by simp [GatePhysical,PhysicalInstr,ProperGate]⟩,tail⟩,
    by simp [GatePhysical,PhysicalInstr,ProperGate]⟩,eraseCarry_physical _ _ _ _⟩

theorem compare_support (xs ys cs : List Wire) (cin target : Wire) :
    wires (compare xs ys cs cin target)⊆(target::cin::(xs++ys++cs)).toFinset := by
  cases xs with
  | nil=>cases ys <;> cases cs <;> simp [compare,wires]
  | cons a xs=>
    cases ys with
    | nil=>cases cs <;> simp [compare,wires]
    | cons b ys=>
      cases cs with
      | nil=>simp [compare,wires]
      | cons c cs=>
        intro q hq
        have h:=compareHeadTop_support a b c cin target xs ys cs hq
        simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at h ⊢
        tauto

theorem program_support_subset (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (program L)⊆wires (CarryBorrow.program L) := by
  rw [CarryBorrow.program_support_eq L hw]
  exact compare_support L.y L.r (L.carry.take 255) L.one L.parity

theorem compare_physical (xs ys cs : List Wire) (cin target : Wire)
    (nd : (target::cin::(xs++ys++cs)).Nodup) : GatePhysical (compare xs ys cs cin target) := by
  cases xs with
  | nil=>cases ys <;> cases cs <;> simp [compare,GatePhysical]
  | cons a xs=>
    cases ys with
    | nil=>cases cs <;> simp [compare,GatePhysical]
    | cons b ys=>
      cases cs with
      | nil=>simp [compare,GatePhysical]
      | cons c cs=>
        have nd' : (target::cin::a::b::c::(xs++ys++cs)).Nodup := by
          apply List.nodup_iff_count.mpr
          intro q;have h:=List.nodup_iff_count.mp nd q
          simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢;omega
        simp only [compare,compareHeadTop,gatePhysical_append]
        exact ⟨⟨notRegister_physical _,head_physical a b c cin target xs ys cs nd'⟩,notRegister_physical _⟩

theorem program_physical (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) : GatePhysical (program L) := by
  apply compare_physical
  apply List.nodup_iff_count.mpr
  intro q
  have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
  have ct : List.count q (L.carry.take 255)≤List.count q L.carry := by
    conv_rhs=>rw [CarryBorrow.carry_split L hw,List.count_append]
    omega
  simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢;omega

open Baselines Challenge in
theorem compare_slots (xs ys cs : List Wire) (cin target : Wire) :
    gateSlots (compare xs ys cs cin target)≤10*xs.length+2*ys.length+6 := by
  cases xs with
  | nil=>cases ys <;> cases cs <;> simp [compare]
  | cons a xs=>
    cases ys with
    | nil=>cases cs <;> simp [compare]
    | cons b ys=>
      cases cs with
      | nil=>simp [compare]
      | cons c cs=>
        have h:=TopCarry.compareChainTop_gateSlots_le xs ys (cs++[cin]) c target
        simp only [compare,compareHeadTop,headChainTop,gateSlots_append,notRegister_gateSlots,
          majority_gateSlots,eraseCarry_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,List.length_cons]
        omega

theorem program_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (program L)≤3078 := by
  have h:=compare_slots L.y L.r (L.carry.take 255) L.one L.parity
  have w:=BalancedCleanup.widths L.toLayout hw
  rw [w.2.2.1,w.2.1] at h
  exact h
end ECDSAAdd.Entrant.TopCarryBorrow

end

section
-- Parity/top-carry follow-up helper PublicRawPhysical
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField RecordedQuantum
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
theorem addInPlaceTop_ro_physical (x y carry : List Wire) (cin : Wire)
    (hn : (cin :: y ++ carry).Nodup)
    (hd : List.Disjoint x (cin :: y ++ carry)) : GatePhysical (TopCarry.addInPlaceTop x y carry cin) := by
  induction x generalizing y carry cin with
  | nil => simp [TopCarry.addInPlaceTop,GatePhysical]
  | cons a xs ih =>
    cases xs with
    | nil =>
      cases y with
      | nil => simp [TopCarry.addInPlaceTop,GatePhysical]
      | cons b ys =>
        cases ys with
        | cons b' ys => simp [TopCarry.addInPlaceTop,GatePhysical]
        | nil =>
          have hab : a ≠ b := by
            intro e
            exact List.disjoint_left.mp hd List.mem_cons_self (by simp [e])
          have hcb : cin ≠ b := by
            intro e; subst cin
            have h := List.nodup_iff_count.mp hn b
            simp only [List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
            omega
          simp [TopCarry.addInPlaceTop,GatePhysical,PhysicalInstr,ProperGate,hab,hcb]
    | cons a' xs =>
      cases y with
      | nil => simp [TopCarry.addInPlaceTop,GatePhysical]
      | cons b ys =>
        cases ys with
        | nil => simp [TopCarry.addInPlaceTop,GatePhysical]
        | cons b' ys =>
          cases carry with
          | nil => simp [TopCarry.addInPlaceTop,GatePhysical]
          | cons k ks =>
            have hk5 : [b,cin,k,b'].Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := List.nodup_iff_count.mp hn q
              simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
            have hs : [a,b,cin,k].Nodup := by
              have hk : [b,cin,k].Nodup := by
                apply List.nodup_iff_count.mpr; intro q
                have h := List.nodup_iff_count.mp hn q
                simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
              have away : a∉[b,cin,k] := by
                intro mem
                apply List.disjoint_left.mp hd List.mem_cons_self
                simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at mem ⊢
                tauto
              exact List.nodup_cons.mpr ⟨away,hk⟩
            have ht : (k :: (b'::ys) ++ ks).Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := List.nodup_iff_count.mp hn q
              simp only [List.count_cons,List.count_append] at h ⊢; omega
            have hdis : List.Disjoint (a'::xs) (k :: (b'::ys) ++ ks) := by
              apply List.disjoint_left.mpr
              intro w hw hh
              apply List.disjoint_left.mp hd (List.mem_cons_of_mem _ hw)
              simp only [List.mem_cons,List.mem_append] at hh ⊢
              tauto
            have htail := ih (b'::ys) ks k ht hdis
            simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
              not_or,not_false_eq_true,and_true] at hk5
            rw [TopCarry.addInPlaceTop]
            simp only [gatePhysical_append]
            refine ⟨⟨⟨?_,htail⟩,eraseCarry_physical _ _ _ _⟩,?_⟩
            · split_ifs
              · simp [GatePhysical,PhysicalInstr,ProperGate,hk5.1.2.1,Ne.symm hk5.2.2,
                  hk5.2.1.1]
              · exact majority_physical _ _ _ _ hs
            · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
                not_or,not_false_eq_true,and_true] at hs
              have hcb : cin ≠ b := Ne.symm hs.2.1.1
              simp [GatePhysical,PhysicalInstr,ProperGate,hs.1.1,hcb]

theorem rawSubTop_physical (L : Layout) (hn : L.wires.Nodup) : GatePhysical (rawSubT L) := by
  have facts:=rawFacts L hn
  have dis : List.Disjoint (source L) (L.sign::rawTarget L++L.carry) := by
    apply List.disjoint_left.mpr
    intro q hq hm
    exact List.disjoint_left.mp facts.2.1 (source_sub L q hq) hm
  have sc : GatePhysical (signComplement L.sign L.y) := by
    simp only [signComplement,GatePhysical,List.mem_map]
    intro i hi
    obtain ⟨q,hq,rfl⟩:=hi
    have ne : L.sign≠q := fun e=>List.disjoint_left.mp facts.2.1 hq (by simp [e])
    simpa [PhysicalInstr,ProperGate] using ne
  have a:=addInPlaceTop_ro_physical (source L) (rawTarget L) L.carry L.sign facts.2.2 dis
  have b : GatePhysical (TopCarry.subInPlaceTop (source L) (rawTarget L) L.carry L.sign) := by
    simp only [TopCarry.subInPlaceTop,gatePhysical_append]
    exact ⟨⟨notRegister_physical _,a⟩,notRegister_physical _⟩
  simpa only [rawSubT,gatePhysical_append] using And.intro (And.intro sc b) sc
end ECDSAAdd.Entrant.GuardCompression

end

section
-- Parity/top-carry follow-up helper FifthCarry2Inverse
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField GuardCompression FieldRename
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

def borrowedCarry (L : BalancedCircuit.Layout) : List Wire := L.carry.take 255++[L.parity]
def rawSub (L : BalancedCircuit.Layout) : Program :=
  signComplement L.sign L.y++TopCarry.subInPlaceTop (source L) (rawTarget L) (borrowedCarry L) L.sign++
    signComplement L.sign L.y

def inverse (L : BalancedCircuit.Layout) : Program := FifthCarry.inversePrefix L++
  [.CX L.r0 L.parity]++rawSub L++[.CX L.rmsb L.one]

private theorem topcarry_FifthCarry2Inverse_fixedMap (f : Wire→Wire) (xs : List Wire) (h : ∀q∈xs,f q=q) : xs.map f=xs := by
  induction xs with
  | nil=>rfl
  | cons a xs ih=>simp only [List.map_cons];rw [h a (by simp),ih (fun q hq=>h q (by simp [hq]))]

theorem rawSub_swap (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    renameProgram (Equiv.swap (L.carry.getD 255 0) L.parity) (rawSubT L)=rawSub L := by
  let last:=L.carry.getD 255 0
  let f:=Equiv.swap last L.parity
  have split:=CarryBorrow.carry_split L hw
  have all : (last::L.parity::(L.sign::L.y++rawTarget L++L.carry.take 255)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (allND L hn) q
    have sp:=congrArg (List.count q) split
    simp only [rawTarget,Layout.wires,BalancedCleanup.Layout.wires,BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,List.count_append,List.count_cons,List.count_nil] at h sp ⊢
    dsimp only [last] at *
    omega
  have away (q : Wire) (hq : q∈L.sign::L.y++rawTarget L++L.carry.take 255) : q≠last ∧ q≠L.parity := by
    have h:=List.nodup_iff_count.mp all q
    have pos:=List.count_pos_iff.mpr hq
    simp only [List.count_cons] at h
    constructor <;> intro eq <;> subst q <;> simp only [beq_self_eq_true,if_true] at h <;> omega
  have fix(q : Wire)(hq:q∈L.sign::L.y++rawTarget L++L.carry.take 255) : f q=q :=
    Equiv.swap_apply_of_ne_of_ne (away q hq).1 (away q hq).2
  have fy : L.y.map f=L.y := topcarry_FifthCarry2Inverse_fixedMap f _ (fun q hq=>fix q (by simp [hq]))
  have fs : (source L).map f=source L := topcarry_FifthCarry2Inverse_fixedMap f _ (fun q hq=>fix q (by simp [source_sub L q hq]))
  have ft : (rawTarget L).map f=rawTarget L := topcarry_FifthCarry2Inverse_fixedMap f _ (fun q hq=>fix q (by simp [hq]))
  have fc : L.carry.map f=borrowedCarry L := by
    rw [split,List.map_append,topcarry_FifthCarry2Inverse_fixedMap f _ (fun q hq=>fix q (by simp [hq]))]
    simp [f,last,borrowedCarry]
  change renameProgram f (rawSubT L)=rawSub L
  simp only [rawSubT,rename_append,signComplement_natural,TopCarry.subInPlaceTop_natural,
    fy,fs,ft,fc,fix L.sign (by simp),rawSub]

theorem inverse_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (inverse L) m s=run (GuardCompression.inverse L) m s := by
  have idx:255<L.carry.length := by rw [hw.2.2];omega
  have mem:L.carry.getD 255 0∈L.carry := by rw [List.getD_eq_getElem _ _ idx];exact List.getElem_mem _
  have eq:(run (FifthCarry.inversePrefix L) m s)=run (GuardCompression.inversePrefix L) m s :=
    (FifthCarry.inverse_prefix_eq L hw hn s m hc).trans
      (BigABorrowParity.oneReuseHead_eq L hw hn B R Y hr hy s m hs hR hY hc)
  have count:measurementCount (FifthCarry.inversePrefix L)=measurementCount (GuardCompression.inversePrefix L) :=
    (FifthCarry.inverse_prefix_measurements L hw hn).trans (BigABorrowParity.oneReuseHead_counts L hw)
  have out:=BigABorrowParity.checked_head_eq L hw hn _ mem (FifthCarry.inversePrefix L)
    B R Y hr hy s m hs hR hY hc eq count
  simpa only [inverse,BigABorrowParity.borrowTail,rawSub_swap L hw hn,List.append_assoc] using out
end ECDSAAdd.Entrant.FifthCarry2

end

section
-- Parity/top-carry follow-up helper FifthCarry2Forward
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] run wires

def cleanupRest (L : BalancedCircuit.Layout) : Program :=
  (BalancedCleanup.prepareCompare L.toLayout).reverse++
    (BalancedCleanup.unnormalize L.toLayout++(BalancedCleanup.prepareSign L.toLayout).reverse)
def cleanup (L : BalancedCircuit.Layout) : Program :=
  BalancedCleanup.prepareCompare L.toLayout++TopCarryBorrow.program L++cleanupRest L
theorem rest_parity_away (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.parity∉wires ((BalancedCleanup.prepareCompare L.toLayout).reverse++
      (BalancedCleanup.unnormalize L.toLayout++
        ((BalancedCleanup.prepareSign L.toLayout).reverse++[.CX L.ymsb L.sourceGuard]))) := by
  have cnd : L.toLayout.wires.Nodup := (List.nodup_append'.mp hn).2.1
  have pa := BalancedCleanup.clifford_parity_away L.toLayout hw cnd
  have nd := BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have pl : L.parity≠L.lower := fun e => by simp [e] at nd
  have po : L.parity≠L.one := fun e => by simp [e] at nd
  have py : L.parity≠L.ymsb := fun e => by simp [e] at nd
  have pg : L.parity≠L.sourceGuard := fun e => by simp [e] at nd
  have ar : L.parity∉L.r := fun h => BalancedCircuit.flagAway L hn L.parity (by simp) (by simp [h])
  have ac : L.parity∉L.carry := fun h => BalancedCircuit.flagAway L hn L.parity (by simp) (by simp [h])
  have lit : L.parity∉wires (literalConstAdd L.low (L.carry.take 254) L.lower L.one
      BalancedCleanup.positiveLiteral) := by
    intro h
    have hh := literalConstAdd_wires L.low (L.carry.take 254) L.lower L.one
      BalancedCleanup.positiveLiteral h
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at hh
    rcases hh with e|e|e|e
    · exact po e
    · exact pl e
    · exact ar (by simp [BalancedCleanup.Layout.r,e])
    · exact ac (List.mem_of_mem_take e)
  simp [wires_append,wires_reverse,BalancedCleanup.unnormalize,pa.1,pa.2,lit,wires,Instr.wires,
    pl,py,pg]

theorem cleanupRest_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.parity∉wires (cleanupRest L) := by
  intro used
  apply rest_parity_away L hw hn
  simp only [cleanupRest,List.append_assoc,wires_append,Finset.mem_union] at used ⊢
  tauto

theorem cleanup_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (ho : s.basis L.one=false) (hc : ∀q∈L.carry,s.basis q=false)
    (hp : (run (CarryBorrow.cleanup L) m s).basis L.parity=false) :
    run (cleanup L) m s=run (CarryBorrow.cleanup L) m s := by
  obtain ⟨v,hv⟩ : ∃v:State,run (BalancedCleanup.prepareCompare L.toLayout) [] s=v := ⟨_,rfl⟩
  have ready:=CarryBorrow.prepareCompare_clean L hw hn s [] ho hc
  rw [hv] at ready
  have preM : measurementCount (BalancedCleanup.prepareCompare L.toLayout)=0 := by
    simp only [BalancedCleanup.prepareCompare,measurementCount_append,(signComplement_counts _ _).2,
      (rotate_counts L.r).2.2.2]
    norm_num [measurementCount]
  have oldShape : CarryBorrow.cleanup L=BalancedCleanup.prepareCompare L.toLayout++
      (CarryBorrow.program L++cleanupRest L) := by simp only [CarryBorrow.cleanup,cleanupRest,List.append_assoc]
  have out : run (CarryBorrow.cleanup L) m s=run (cleanupRest L)
      (m.drop (measurementCount (CarryBorrow.program L))) (run (CarryBorrow.program L) m v) := by
    rw [oldShape,run_append,preM,List.take_zero,List.drop_zero,hv,run_append,run_take]
  have fin : (run (CarryBorrow.program L) m v).basis L.parity=false := by
    rw [out,run_preserves_outside _ _ _ _ (cleanupRest_free L hw hn)] at hp
    exact hp
  have eqOld:=CarryBorrow.program_eq L hw hn v m ready.1 ready.2
  have w:=BalancedCleanup.widths L.toLayout hw
  have cmp:=compareLt_correct none L.y L.r L.carry L.one L.parity
    (L.toLayout.compareND (List.nodup_append'.mp hn).2.1) (by simp)
    (w.2.2.1.trans w.2.1.symm) (hw.2.2.trans w.2.1.symm) v m ready.1 ready.2
  rw [eqOld,cmp.2.2] at fin
  simp only [controlValue,Bool.true_and] at fin
  have par : v.basis L.parity=decide (regValue L.y v.basis<regValue L.r v.basis) := by
    revert fin
    cases v.basis L.parity <;> cases decide (regValue L.y v.basis<regValue L.r v.basis) <;> decide
  have eq:= (TopCarryBorrow.program_eq L hw hn v m ready.1 ready.2 par).trans eqOld.symm
  have count:measurementCount (TopCarryBorrow.program L)=measurementCount (CarryBorrow.program L) :=
    (TopCarryBorrow.program_counts L hw).2.trans (CarryBorrow.program_counts L hw).2.symm
  have shape : cleanup L=BalancedCleanup.prepareCompare L.toLayout++
      (TopCarryBorrow.program L++cleanupRest L) := by simp only [cleanup,List.append_assoc]
  have preEq : run (BalancedCleanup.prepareCompare L.toLayout) m s=v :=
    (FifthCarry.no_records _ preM s m []).trans hv
  rw [shape,oldShape]
  simp only [run_append,run_take,preM,List.drop_zero,List.take_zero,hv,preEq]
  rw [count,eq]

def forwardPrefix (L : BalancedCircuit.Layout) : Program :=
  GuardCompression.seed L++FifthCarry.rawAdd L++OneReuse.remainder L

def forwardCore (L : BalancedCircuit.Layout) : Program := forwardPrefix L++cleanup L

theorem forwardPrefix_shifted (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hc : ∀q∈work L,s.basis q=false) :
    run (forwardPrefix L) m s=run (FifthCarry.oldForwardPrefix L) (false::m) s := by
  have seed:=FifthCarry.seed_ready L hn s m hc
  have seed_norm(r : List Bool) : run (GuardCompression.seed L) r s=run (GuardCompression.seed L) m s :=
    FifthCarry.no_records _ (by rfl) _ _ _
  have eq:=FifthCarry.rawAdd_eq_records L hw hn (run (GuardCompression.seed L) m s)
    (m.take 255) ((false::m).take 256) seed.1 seed.2
  have newM : measurementCount (FifthCarry.rawAdd L)=255 := (FifthCarry.raw_counts L hw).2.1
  have oldM : measurementCount (GuardCompression.rawAdd L)=256 := (GuardCompression.raw_counts L hw).2.1
  simp only [forwardPrefix,FifthCarry.oldForwardPrefix,OneReuse.rawPrefix,List.append_assoc,
    run_append,run_take,show measurementCount (GuardCompression.seed L)=0 from rfl,
    List.drop_zero,seed_norm,newM,oldM,List.drop_succ_cons]
  rw [eq]

theorem forwardCore_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (forwardCore L) m s=run (FifthCarry.forward L) m s := by
  have old:=FifthCarry.forward_correct L hw hn B X Y hx hy s m hs hr hyr hc
  have preClean:=FifthCarry.forward_prefix_clean L hw hn B X Y hx hy s (false::m) hs hr hyr hc
  rw [←forwardPrefix_shifted L hw hn s m hc] at preClean
  have shape:FifthCarry.forward L=forwardPrefix L++CarryBorrow.cleanup L := by
    simp only [FifthCarry.forward,forwardPrefix,List.append_assoc]
  rw [shape,run_append,run_take] at old
  have ready:=cleanup_eq L hw hn (run (forwardPrefix L) m s)
    (m.drop (measurementCount (forwardPrefix L))) preClean.1 preClean.2 (old.2.2.1 L.parity (by simp [work]))
  rw [forwardCore,shape]
  simp only [run_append,run_take]
  exact ready

/-- A clean measurement equalizes forward/inverse record cursors without T
cost or an extra wire. This keeps the existing uniform replay API exact. -/
def forward (L : BalancedCircuit.Layout) : Program := forwardCore L++[.measureX L.one [] []]

theorem forward_eq (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (forward L) m s=run (FifthCarry.forward L) m s := by
  have eq:=forwardCore_eq L hw hn B X Y hx hy s m hs hr hyr hc
  have old:=FifthCarry.forward_correct L hw hn B X Y hx hy s m hs hr hyr hc
  have clean : (run (FifthCarry.forward L) m s).basis L.one=false := old.2.2.1 L.one (by simp [work])
  rw [forward,run_append,run_take,eq]
  apply State.extensionality
  · simp [run,measureAndCorrect,correct,clean]
  · funext q
    by_cases h:q=L.one
    · subst q;simp [run,measureAndCorrect,correct,writeBit,clean]
    · simp [run,measureAndCorrect,correct,writeBit,Function.update_of_ne h]
end ECDSAAdd.Entrant.FifthCarry2

end

section
-- Parity/top-carry follow-up helper FifthCarry2Resources
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
set_option linter.unusedSimpArgs false

theorem raw_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (rawSub L)=255 ∧ measurementCount (rawSub L)=256 := by
  have w:=BalancedCircuit.widths L hw
  have a:=TopCarry.subInPlaceTop_counts 255 (GuardCompression.source L) (rawTarget L)
    (borrowedCarry L) L.sign (by rw [w.2.1])
    (by rw [GuardCompression.source_len,w.1,w.2.1])
    (by simp [borrowedCarry,List.length_take,hw.2.2,w.2.1])
  simp only [rawSub,toffoliCount_append,measurementCount_append,a.1,a.2,
    (signComplement_counts _ _).1,(signComplement_counts _ _).2]
  norm_num

theorem kernel_counts (L : BalancedCircuit.Layout) (hw : L.Widths) :
    toffoliCount (forward L)=1020 ∧ measurementCount (forward L)=1021 ∧
    toffoliCount (inverse L)=1020 ∧ measurementCount (inverse L)=1021 := by
  have old:=FifthCarry.kernel_counts L hw
  have raw:=raw_counts L hw
  have oldRaw:=FifthCarry.raw_counts L hw
  have newCmp:=TopCarryBorrow.program_counts L hw
  have oldCmp:=CarryBorrow.program_counts L hw
  simp only [FifthCarry.forward,FifthCarry.inverse,toffoliCount_append,measurementCount_append,
    CarryBorrow.cleanup] at old
  simp only [forward,forwardCore,forwardPrefix,cleanup,cleanupRest,inverse,toffoliCount_append,measurementCount_append,
    raw.1,raw.2,newCmp.1,newCmp.2]
  simp only [toffoliCount_append,measurementCount_append,oldCmp.1,oldCmp.2,oldRaw.2.2.1,oldRaw.2.2.2] at old
  norm_num [GuardCompression.seed,toffoliCount,measurementCount] at old ⊢
  omega

theorem forward_correct (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    let t:=run (forward L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (halfResult (rawSum B X Y)) ∧
    (∀q∈work L,t.basis q=false) ∧ (∀q,q∉L.r → t.basis q=s.basis q) := by
  rw [forward_eq L hw hn B X Y hx hy s m hs hr hyr hc]
  exact FifthCarry.forward_correct L hw hn B X Y hx hy s m hs hr hyr hc

theorem inverse_correct (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    let t:=run (inverse L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (BalancedInverse.result B R Y) ∧
    (∀q∈work L,t.basis q=false) ∧ (∀q,q∉L.r → t.basis q=s.basis q) := by
  rw [inverse_eq L hw hn B R Y hr hy s m hs hR hY hc]
  exact GuardCompression.inverse_correct L hw hn B R Y hr hy s m hs hR hY hc
end ECDSAAdd.Entrant.FifthCarry2

end

section
-- Parity/top-carry follow-up helper FifthCarry2Natural
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic FieldRename ShortKernelDependencies
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
set_option linter.unusedSimpArgs false

theorem cleanup_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (cleanup L)=cleanup (mapCircuit f L) := by
  simp only [cleanup,cleanupRest,BalancedCleanup.unnormalize,BalancedCleanup.prepareCompare,
    rename_append,rename_reverse,TopCarryBorrow.program_natural,prepareSign_natural,literalConstAdd_natural,
    rotateLeft_natural,signComplement_natural,low_map,r_map,y_map,List.map_take]
  simp only [mapCircuit,mapCleanup,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
    BalancedCleanup.Layout.y,List.map_append,List.map_cons,List.map_nil,renameProgram,renameInstr]

theorem forward_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    renameProgram f (forward L)=forward (mapCircuit f L) := by
  have hy:L.ylow≠[] := by intro eq;have h:=hw.2.1;rw [eq] at h;simp at h
  simp only [forward,forwardCore,forwardPrefix,rename_append,GuardCompression.seed_natural f L hy,
    FifthCarry.rawAdd_natural,OneReuse.remainder_natural f L hw,cleanup_natural]
  rfl

theorem rawSub_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (rawSub L)=rawSub (mapCircuit f L) := by
  simp only [rawSub,rename_append,signComplement_natural,TopCarry.subInPlaceTop_natural]
  simp [borrowedCarry,GuardCompression.source,BalancedCircuit.rawTarget,mapCircuit,mapCleanup,
    BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,List.map_take]

theorem inverse_natural (f : Wire→Wire) (L : BalancedCircuit.Layout) (_hy : L.ylow≠[]) (hw : L.Widths) :
    renameProgram f (inverse L)=inverse (mapCircuit f L) := by
  simp only [inverse,FifthCarry.inversePrefix,rename_append,CarryBorrow.recoverPrefix_natural,
    bi_unbiasView_natural f L hw,OneReuse.restoreRaw_natural,rawSub_natural]
  rfl
end ECDSAAdd.Entrant.FifthCarry2

end

section
-- Parity/top-carry follow-up helper FifthCarry2Physical
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic BalancedCircuit RecordedQuantum
set_option maxRecDepth 8192
set_option maxHeartbeats 2400000
set_option linter.unusedSimpArgs false

theorem rawSub_physical (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (rawSub L) := by
  rw [←rawSub_swap L hw hn]
  exact gatePhysical_rename _ (Equiv.swap _ _).injective _ (GuardCompression.rawSubTop_physical L hn)

theorem forward_physical (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (forward L) := by
  have old:=FifthCarry.forward_physical L hw hn
  have cmp:=TopCarryBorrow.program_physical L hw hn
  simp only [FifthCarry.forward,CarryBorrow.cleanup,gatePhysical_append] at old
  simp only [forward,forwardCore,forwardPrefix,cleanup,cleanupRest,gatePhysical_append]
  have pad : GatePhysical ([.measureX L.one [] []]:Program) := by simp [GatePhysical,PhysicalInstr]
  tauto

theorem inverse_physical (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (inverse L) := by
  have old:=FifthCarry.inverse_physical L hw hn
  have raw:=rawSub_physical L hw hn
  have nd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have p:L.r0≠L.parity := by tauto
  have q:L.rmsb≠L.one := by tauto
  have c1:GatePhysical ([.CX L.r0 L.parity]:Program) := by simp [GatePhysical,PhysicalInstr,ProperGate,p]
  have c2:GatePhysical ([.CX L.rmsb L.one]:Program) := by simp [GatePhysical,PhysicalInstr,ProperGate,q]
  simp only [FifthCarry.inverse,gatePhysical_append] at old
  simp only [inverse,gatePhysical_append]
  tauto
end ECDSAAdd.Entrant.FifthCarry2

end

section
-- Parity/top-carry follow-up helper FifthCarry2Support
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic BalancedCircuit
set_option maxRecDepth 8192
set_option maxHeartbeats 800000
set_option linter.unusedSimpArgs false
attribute [local irreducible] wires

theorem rawSub_support (L : BalancedCircuit.Layout) : wires (rawSub L)⊆L.wires.toFinset := by
  have fit(q : Wire)(hq:q∈L.sign::(L.y++GuardCompression.source L++rawTarget L++borrowedCarry L)) : q∈L.wires := by
    have take:q∈L.carry.take 255→q∈L.carry := List.mem_of_mem_take
    simp only [borrowedCarry,GuardCompression.source,rawTarget,BalancedCircuit.Layout.wires,
      BalancedCleanup.Layout.wires,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,BalancedCleanup.Layout.y,
      List.mem_cons,List.mem_append,List.mem_singleton,List.not_mem_nil,or_false] at hq ⊢
    simp only [BalancedCleanup.Layout.low] at take
    tauto
  have sc:wires (signComplement L.sign L.y)⊆L.wires.toFinset := by
    intro q hq
    have h:=signComplement_wires_subset L.sign L.y hq
    apply List.mem_toFinset.mpr;apply fit q
    simp only [List.mem_toFinset,List.mem_cons] at h
    simp only [List.mem_cons,List.mem_append]
    tauto
  have sub:wires (TopCarry.subInPlaceTop (GuardCompression.source L) (rawTarget L) (borrowedCarry L) L.sign)⊆L.wires.toFinset := by
    intro q hq
    have h:=TopCarry.subInPlaceTop_wires _ _ _ _ hq
    apply List.mem_toFinset.mpr;apply fit q
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at h ⊢
    tauto
  simp only [rawSub,wires_append,Finset.union_subset_iff]
  exact ⟨⟨sc,sub⟩,sc⟩

section
attribute [local irreducible] FifthCarry.rawAdd OneReuse.remainder GuardCompression.seed
  BalancedCleanup.prepareCompare BalancedCleanup.prepareSign BalancedCleanup.unnormalize
  CarryBorrow.program TopCarryBorrow.program

theorem forward_support (L : BalancedCircuit.Layout) (hw : L.Widths) : wires (forward L)⊆L.wires.toFinset := by
  have old:=FifthCarry.forward_support L hw
  have cmp:=TopCarryBorrow.program_support_subset L hw
  have cleanSub : wires (cleanup L)⊆wires (CarryBorrow.cleanup L) := by
    simp only [cleanup,cleanupRest,CarryBorrow.cleanup,wires_append,Finset.union_assoc]
    exact Finset.union_subset_union (fun _ h=>h)
      (Finset.union_subset_union cmp (fun _ h=>h))
  have coreSub : wires (forwardCore L)⊆wires (FifthCarry.forward L) := by
    simp only [forwardCore,forwardPrefix,FifthCarry.forward,wires_append,Finset.union_assoc]
    exact Finset.union_subset_union (fun _ h=>h) (Finset.union_subset_union (fun _ h=>h)
      (Finset.union_subset_union (fun _ h=>h) cleanSub))
  simp only [forward,wires_append,Finset.union_subset_iff]
  refine ⟨coreSub.trans old,?_⟩
  intro q hq
  simp [wires,Instr.wires,correctionWires] at hq
  subst q
  simp [BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires]

end

theorem inverse_support (L : BalancedCircuit.Layout) (hw : L.Widths) : wires (inverse L)⊆L.wires.toFinset := by
  have old:=FifthCarry.inverse_support L hw
  have raw:=rawSub_support L
  have first:wires (FifthCarry.inversePrefix L)⊆L.wires.toFinset := by
    intro q hq;apply old
    simp only [FifthCarry.inverse,wires_append,Finset.mem_union]
    tauto
  have c1:wires ([.CX L.r0 L.parity]:Program)⊆L.wires.toFinset := by
    intro q hq
    simp [wires,Instr.wires] at hq
    simp only [List.mem_toFinset,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
      BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
    tauto
  have c2:wires ([.CX L.rmsb L.one]:Program)⊆L.wires.toFinset := by
    intro q hq
    simp [wires,Instr.wires] at hq
    simp only [List.mem_toFinset,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
      BalancedCleanup.Layout.r,List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
    tauto
  simp only [inverse,wires_append,Finset.union_subset_iff]
  exact ⟨⟨⟨first,c1⟩,raw⟩,c2⟩

def resetUnused (L : BalancedCircuit.Layout) : BalancedCircuit.Layout := FifthCarry.resetUnused L

theorem forward_ignores_unused (L : BalancedCircuit.Layout) : forward (resetUnused L)=forward L := by rfl
theorem inverse_ignores_unused (L : BalancedCircuit.Layout) : inverse (resetUnused L)=inverse L := by rfl

theorem unused_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus,L.minus]) :
    q∉wires (forward L) ∧ q∉wires (inverse L) := by
  have f:=forward_support (resetUnused L) hw
  have i:=inverse_support (resetUnused L) hw
  rw [forward_ignores_unused] at f
  rw [inverse_ignores_unused] at i
  exact ⟨fun h=>OneReuse.reset_unused_away L hn q hq (List.mem_toFinset.mp (f h)),
    fun h=>OneReuse.reset_unused_away L hn q hq (List.mem_toFinset.mp (i h))⟩

theorem resetLast_ignored (L : BalancedCircuit.Layout) (hw : L.Widths) :
    forward (FifthCarry.resetLast L)=forward L ∧ inverse (FifthCarry.resetLast L)=inverse L := by
  have take:=FifthCarry.resetLast_takes L hw
  simp only [forward,forwardCore,forwardPrefix,cleanup,cleanupRest,inverse,FifthCarry.inversePrefix,
    FifthCarry.rawAdd,rawSub,borrowedCarry,CarryBorrow.recoverPrefix,CarryBorrow.recoverBefore,
    CarryBorrow.program,OneReuse.remainder,OneReuse.restoreRaw,TopCarryBorrow.program,
    OneReuse.foldWindow,OneReuse.unfoldWindow,BalancedCleanup.normalize,BalancedCleanup.unnormalize,take.1,take.2]
  constructor <;> rfl

theorem kernels_last_free (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.carry.getD 255 0∉wires (forward L) ∧ L.carry.getD 255 0∉wires (inverse L) := by
  have f:=forward_support (FifthCarry.resetLast L) (FifthCarry.resetLast_widths L hw)
  have i:=inverse_support (FifthCarry.resetLast L) (FifthCarry.resetLast_widths L hw)
  rw [(resetLast_ignored L hw).1] at f
  rw [(resetLast_ignored L hw).2] at i
  exact ⟨fun h=>FifthCarry.resetLast_away L hw hn (List.mem_toFinset.mp (f h)),
    fun h=>FifthCarry.resetLast_away L hw hn (List.mem_toFinset.mp (i h))⟩
end ECDSAAdd.Entrant.FifthCarry2

end

section
-- Parity/top-carry follow-up helper FifthCarry2Slots
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.FifthCarry2
open ECDSAAdd.Arithmetic ECDSAAdd.Challenge ECDSAAdd.Baselines
theorem rawSub_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    gateSlots (rawSub L)≤5000 := by
  have w:=BalancedCleanup.widths L.toLayout hw
  have kw:=BalancedCircuit.widths L hw
  have a:=TopCarry.subInPlaceTop_gateSlots_le (GuardCompression.source L) (BalancedCircuit.rawTarget L)
    (borrowedCarry L) L.sign
  rw [GuardCompression.source_len,kw.1,kw.2.1] at a
  simp only [rawSub,gateSlots_append,signComplement_gateSlots,w.2.2.1]
  omega

theorem forward_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    gateSlots (forward L) ≤ 24000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have kw := BalancedCircuit.widths L hw
  have hb : (ShortBiasedFold.lowBits L).length=255 := by exact ShortBiasedFold.lowBits_length L
  have a := (FifthCarry.raw_slots L hw).1
  have r := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).1
  have l := (rotate_gateSlots_le L.r).2
  have m := mappedAdd_gateSlots_le (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one
  have u := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.positiveLiteral
  have c := TopCarryBorrow.program_slots L hw
  rw [kw.2.1] at r
  rw [w.2.1] at l
  rw [hb] at m
  rw [w.1] at u
  simp only [forward,forwardCore,forwardPrefix,cleanup,cleanupRest,GuardCompression.seed,OneReuse.remainder,
    OneReuse.newPrepare,OneReuse.foldWindow,
    BiasedCircuit.flipBias,GuardCompression.seed,
    BalancedCleanup.prepareSign,BalancedCleanup.prepareCompare,
    BalancedCleanup.unnormalize,gateSlots_append,reverse_gateSlots,signComplement_gateSlots,
    gateSlots_cons,gateSlots_nil,instructionSlots,kw.1,w.2.1,w.2.2.1,List.length_cons,List.length_nil]
  omega

theorem inverse_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (inverse L) ≤ 25000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have rw := BalancedCircuit.widths L hw
  have a := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.negativeLiteral
  have c := CarryBorrow.program_slots L hw
  have b := mappedSub_gateSlots_le (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one
  have s := rawSub_slots L hw
  have r := (rotate_gateSlots_le L.r).2
  have rt := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).2
  rw [w.1] at a
  have bl : (ShortBiasedFold.lowBits L).length=255 := ShortBiasedFold.lowBits_length L
  rw [bl,w.1] at b
  rw [w.2.1] at r
  rw [rw.2.1] at rt
  simp only [inverse,FifthCarry.inversePrefix,CarryBorrow.recoverPrefix,CarryBorrow.recoverBefore,BiasedInverse.unbiasView,
    OneReuse.restoreRaw,OneReuse.unfoldWindow,
    BalancedCleanup.prepareSign,BalancedCleanup.normalize,
    BalancedCleanup.prepareCompare,GuardCompression.seed,gateSlots_append,reverse_gateSlots,
    signComplement_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,
    w.2.1,w.2.2.1,rw.1,List.length_cons,List.length_nil]
  omega
end ECDSAAdd.Entrant.FifthCarry2

end
namespace ECDSAAdd.Entrant.OneBankCore5
open Arithmetic Secp256k1 BalancedField BalancedCircuit

/-- One-bank cleanup after the checked narrow core. -/
def forward (L : Layout) : Program :=
  LaneI.coreProgramI L ++ BalancedCleanup.program L.toLayout ++ [.CX L.ymsb L.sourceGuard]

def kernel (divide : Bool) (L : Layout) : Program :=
  if divide then FifthCarry2.forward L else FifthCarry2.inverse L

def oldKernel (divide : Bool) (L : Layout) : Program :=
  if divide then BalancedCircuit.program L else BalancedInverse.program L

theorem counts (divide : Bool) (L : Layout) (hw : L.Widths) :
    toffoliCount (kernel divide L)=1020 ∧ measurementCount (kernel divide L)=1021 := by
  cases divide
  · simpa only [kernel,Bool.false_eq_true,if_false] using And.intro (FifthCarry2.kernel_counts L hw).2.2.1 (FifthCarry2.kernel_counts L hw).2.2.2
  · simpa only [kernel,if_true] using And.intro (FifthCarry2.kernel_counts L hw).1 (FifthCarry2.kernel_counts L hw).2.1

theorem state_eq (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m m' : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (kernel divide L) m s=run (oldKernel divide L) m' s := by
  cases divide
  · have fresh := FifthCarry2.inverse_correct L hw hn B X Y hx hy s m hs hr hyr hc
    have old := BalancedInverse.program_correct L hw hn B X Y hx hy s m' hs hr hyr hc
    simp only [kernel,oldKernel,Bool.false_eq_true,if_false]
    apply State.extensionality
    · exact fresh.1.trans old.1.symm
    · funext q
      by_cases hq : q∈L.r
      · exact (regValue_eq_iff L.r _ _).mp (fresh.2.1.trans old.2.1.symm) q hq
      · exact (fresh.2.2.2 q hq).trans (old.2.2.2 q hq).symm
  · have fresh := FifthCarry2.forward_correct L hw hn B X Y hx hy s m hs hr hyr hc
    have old := BalancedCircuit.program_correct L hw hn B X Y hx hy s m' hs hr hyr hc
    simp only [kernel,oldKernel,if_true]
    apply State.extensionality
    · exact fresh.1.trans old.1.symm
    · funext q
      by_cases hq : q∈L.r
      · exact (regValue_eq_iff L.r _ _).mp (fresh.2.1.trans old.2.1.symm) q hq
      · exact (fresh.2.2.2 q hq).trans (old.2.2.2 q hq).symm

theorem work_away (L : Layout) (hn : L.wires.Nodup) (q : Wire)
    (hq : q∈work L) : q∉L.r ∧ q∉L.y := by
  have h := List.nodup_iff_count.mp (allND L hn) q
  have hw := List.count_pos_iff.mpr hq
  constructor <;> intro hd <;> have hc := List.count_pos_iff.mpr hd
  all_goals
    simp only [work,List.count_append,List.count_cons,List.count_nil] at h hw
    omega

theorem sign_work (L : Layout) (hn : L.wires.Nodup) : L.sign∉work L := by
  have nd : (L.sign::work L).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [Layout.wires,BalancedCleanup.Layout.wires,work,List.count_append,
      List.count_cons,List.count_nil] at h ⊢
    omega
  exact (List.nodup_cons.mp nd).1

def half (divide : Bool) (L : Layout) : Program :=
  [.X L.sign]++kernel divide L++[.X L.sign]

def oldHalf (divide : Bool) (L : Layout) : Program :=
  [.X L.sign]++oldKernel divide L++[.X L.sign]

/-- Complete State equality, for each independent incoming phase and record. -/
theorem half_eq (divide : Bool) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (base : BasisState) (hc : ∀q∈work L,base q=false) (X Y : Fp)
    (s : State) (m : List Bool)
    (h : PairFrame L.r L.y base (centerWord X) (centerWord Y) s.basis) :
    run (half divide L) m s=run (oldHalf divide L) m s := by
  have aw := flagAway L hn L.sign (by simp)
  have sa : L.sign∉L.r ∧ L.sign∉L.y :=
    ⟨fun h => aw (by simp [h]),fun h => aw (by simp [h])⟩
  unfold half oldHalf
  rw [List.append_assoc,List.append_assoc]
  apply LaneI.seq_eq _ _ _ _ s m rfl rfl
  generalize eu : run [.X L.sign] (m.take (measurementCount [.X L.sign])) s=u
  have us := BalancedCleanupOffset.x_run L.sign s (m.take (measurementCount [.X L.sign]))
  rw [eu] at us
  have uf (q : Wire) (hq : q≠L.sign) : u.basis q=s.basis q := by
    rw [us]
    simp only [writeBit,Function.update_of_ne hq]
  have ug : u.basis L.sign= !base L.sign := by
    rw [us]
    simp only [writeBit,Function.update_self,h.2.2 L.sign sa.1 sa.2]
  have uv (r : List Wire) (a : L.sign∉r) : regValue r u.basis=regValue r s.basis :=
    regValue_congr _ _ _ (fun q hq => uf q (fun e => a (e ▸ hq)))
  have ur : signedRegValue L.r u.basis=centerFp X := by
    rw [signedRegValue,uv L.r sa.1,h.1,(BalancedCleanup.widths L.toLayout hw).2.1,centerWord_decode]
  have uy : signedRegValue L.y u.basis=centerFp Y := by
    rw [signedRegValue,uv L.y sa.2,h.2.1,(BalancedCleanup.widths L.toLayout hw).2.2.1,centerWord_decode]
  have uc : ∀q∈work L,u.basis q=false := by
    intro q hq
    have a := work_away L hn q hq
    exact (uf q (fun e => sign_work L hn (e ▸ hq))).trans
      ((h.2.2 q a.1 a.2).trans (hc q hq))
  rw [run_append, run_append]
  have qx : ∀ (r1 r2 : List Bool) (t : State), run [Instr.X L.sign] r1 t = run [Instr.X L.sign] r2 t := by
    intro r1 r2 t; rfl
  rw [qx _ (List.drop (measurementCount (oldKernel divide L)) _),
    state_eq divide L hw hn (!base L.sign) (centerFp X) (centerFp Y)
    (centerFp_bounds X) (centerFp_bounds Y) u _ _ ug ur uy uc]

section Natural
open FieldRename
attribute [local irreducible] literalConstAdd compareLt rotateLeft rotateRight signComplement
  addInPlace subInPlace mappedAdd mappedSub

theorem cleanup_natural (f : Wire → Wire) (L : BalancedCleanup.Layout) :
    renameProgram f (BalancedCleanup.program L)=BalancedCleanup.program (mapCleanup f L) := by
  simp only [BalancedCleanup.program,BalancedCleanup.normalize,BalancedCleanup.unnormalize,
    BalancedCleanup.prepareCompare,rename_append,rename_reverse,prepareSign_natural,
    literalConstAdd_natural,rotateLeft_natural,signComplement_natural,compareLt_natural,
    low_map,r_map,y_map,List.map_take]
  rfl

theorem bits_natural (f : Wire → Wire) (L : Layout) :
    (LaneI.foldBitsI L).map (mapBit f)=LaneI.foldBitsI (mapCircuit f L) := by
  simp only [LaneI.foldBitsI,List.map_map]
  congr 1
  funext i
  dsimp [Function.comp_def,mapBit,mapCircuit]
  split_ifs <;> rfl

theorem fold_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (LaneI.foldI L)=LaneI.foldI (mapCircuit f L) ∧
    renameProgram f (LaneI.undoFoldI L)=LaneI.undoFoldI (mapCircuit f L) := by
  constructor <;>
    simp only [LaneI.foldI,LaneI.undoFoldI,rename_append,mappedAdd_natural,mappedSub_natural,
      bits_natural,foldTarget_map]
  all_goals
    simp only [mapCircuit,mapCleanup,List.map_take,renameProgram,List.map_cons,List.map_nil,renameInstr]

theorem kernel_natural (f : Wire → Wire) (divide : Bool) (L : Layout) (hy : L.ylow≠[])
    (hw : L.Widths) :
    renameProgram f (kernel divide L)=kernel divide (mapCircuit f L) := by
  cases divide
  · simpa only [kernel,Bool.false_eq_true,if_false] using
      FifthCarry2.inverse_natural f L hy hw
  · simpa only [kernel,if_true] using FifthCarry2.forward_natural f L hw
end Natural

theorem support (divide : Bool) (L : Layout) (hw : L.Widths) :
    wires (kernel divide L)⊆L.wires.toFinset := by
  cases divide
  · simpa only [kernel,Bool.false_eq_true,if_false] using FifthCarry2.inverse_support L hw
  · simpa only [kernel,if_true] using FifthCarry2.forward_support L hw

section Slots
open Baselines Challenge

theorem cleanup_gateSlots_le (L : BalancedCleanup.Layout) (hw : L.Widths) :
    gateSlots (BalancedCleanup.program L)≤13000 := by
  have w := BalancedCleanup.widths L hw
  have a := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.negativeLiteral
  have b := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.positiveLiteral
  have r := (rotate_gateSlots_le L.r).2
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  rw [w.1] at a b
  rw [w.2.1] at r
  rw [w.2.1,w.2.2.1] at c
  simp only [BalancedCleanup.program,BalancedCleanup.prepareSign,BalancedCleanup.normalize,
    BalancedCleanup.unnormalize,BalancedCleanup.prepareCompare,gateSlots_append,reverse_gateSlots,
    signComplement_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,w.2.1,w.2.2.1]
  omega

theorem kernel_gateSlots_le (divide : Bool) (L : Layout) (hw : L.Widths) :
    gateSlots (kernel divide L)≤(if divide then 24000 else 25000) := by
  cases divide
  · simpa only [kernel,Bool.false_eq_true,if_false] using FifthCarry2.inverse_slots L hw
  · simpa only [kernel,if_true] using FifthCarry2.forward_slots L hw
end Slots

def body (divide : Bool) (L : Layout) (eff : Wire) : Program :=
  if divide then half true L++swapRegisters eff L.r L.y
  else swapRegisters eff L.r L.y++half false L

def oldBody (divide : Bool) (L : Layout) (eff : Wire) : Program :=
  if divide then balancedTranscriptBody L eff else balancedInverseTranscriptBody L eff

theorem body_support (divide : Bool) (L : Layout) (eff : Wire) (hw : L.Widths) :
    wires (body divide L eff)⊆(eff::L.wires).toFinset := by
  have h:=ShortBiasedProperties.body_support divide L eff hw (kernel divide L) (support divide L hw)
  cases divide <;> simpa only [body,half,Bool.false_eq_true,if_false,if_true] using h

end ECDSAAdd.Entrant.OneBankCore5

