    have b : L.dialogPool.take 945=wireBlock L.core.poolWire 0 945 := by
      simp only [dialogPool,List.take_take,Nat.min_eq_left (show 945 ≤ 2613 by omega)]
      exact (L.core.pool_prefix hw 945 (by omega)).symm
    rw [b] at hm
