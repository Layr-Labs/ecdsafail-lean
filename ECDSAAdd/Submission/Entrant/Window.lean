theorem admin_outside (j : Fin 23) (h2 : 2≤j.val) (h21 : j.val≤21) (hne : start j≠WideReference.firstBlock)
    (q : Wire) (hq : q∈ArchiveJ.rawHead (prev j)++support j) :
