/-- dadon's `LeaveCompanion{s}.clearFlag_value`. -/
theorem clearFlag_value (j : Fin 23) (h0 : 1 ≤ j.val) (h1 : j.val ≤ 21) (s : State) (m : List Bool) (half mag : Nat)
