namespace ECDSAAdd.Entrant.WSlimMain
open ECDSAAdd
/-! Generic single-pass lemmas. Proof-only helpers: they let a
`decide +kernel` run ONE Bool pass over a concrete program instead of building the program-wide
`Finset` of `wires` (quadratic `Finset.union`, deep non-tail recursion). -/

/-- Wires of a correction list, as a list. -/
def corrList : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: corrList cs
  | .CZ a b :: cs => a :: b :: corrList cs

/-- Wires of an instruction, as a list (same members as `Instr.wires`). -/
def instrList : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (corrList c₀ ++ corrList c₁)

theorem mem_correctionWires_iff (q : Wire) (cs : List Correction) :
    q ∈ correctionWires cs ↔ q ∈ corrList cs := by
  induction cs with
  | nil => simp [correctionWires, corrList]
  | cons c cs ih => cases c <;> simp [correctionWires, corrList, ih]

theorem mem_instr_wires_iff (q : Wire) (i : Instr) : q ∈ i.wires ↔ q ∈ instrList i := by
  cases i <;> simp [Instr.wires, instrList, mem_correctionWires_iff]

/-- `∀ q ∈ wires P, p q` from one Bool pass over `P`. -/
theorem forall_mem_wires_of_all {P : Program} {p : Wire → Bool}
    (h : P.all (fun i => (instrList i).all p) = true) : ∀ q ∈ wires P, p q = true := by
  intro q hq
  induction P with
  | nil => simp [wires] at hq
  | cons i P ih =>
    simp only [List.all_cons, Bool.and_eq_true] at h
    simp only [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · exact List.all_eq_true.mp h.1 q ((mem_instr_wires_iff q i).mp hq)
    · exact ih h.2 hq

/-- `wires P ⊆ T` from one Bool pass over `P`. -/
theorem wires_subset_of_all {P : Program} {T : Finset Wire}
    (h : P.all (fun i => (instrList i).all (fun q => decide (q ∈ T))) = true) : wires P ⊆ T := by
  intro q hq
  simpa using forall_mem_wires_of_all h q hq

/-- `wires P ⊆ Finset.range n` from one Bool pass over `P` (no list membership). -/
theorem wires_subset_range_of_all {P : Program} {n : Nat}
    (h : P.all (fun i => (instrList i).all (fun q => decide (q < n))) = true) : wires P ⊆ Finset.range n := by
  intro q hq
  simpa using forall_mem_wires_of_all h q hq

/-- `∀ q ∈ S, q ∉ wires P` from one Bool pass over `P`. -/
theorem not_mem_wires_of_all {P : Program} {S : List Wire}
    (h : P.all (fun i => (instrList i).all (fun q => !S.contains q)) = true) : ∀ q ∈ S, q ∉ wires P := by
  intro q hq hw
  have := forall_mem_wires_of_all h q hw
  simp_all

/-- Bit mask of a list of naturals (`foldl`, GMP `|||` / `2^x`). -/
def maskOf (l : List Nat) : Nat := l.foldl (fun m x => m ||| 2 ^ x) 0

theorem testBit_foldl_mask (l : List Nat) (acc x : Nat) :
    (l.foldl (fun m y => m ||| 2 ^ y) acc).testBit x = (acc.testBit x || decide (x ∈ l)) := by
  induction l generalizing acc with
  | nil => simp
  | cons y l ih =>
    rw [List.foldl_cons, ih, Nat.testBit_or, Nat.testBit_two_pow]
    by_cases h : x = y <;> simp [h, eq_comm]

theorem testBit_maskOf (l : List Nat) (x : Nat) : (maskOf l).testBit x = decide (x ∈ l) := by
  simp [maskOf, testBit_foldl_mask]

/-- `∀ q ∈ S, q ∉ l` from one pass over `S` against the mask of `l`. -/
theorem not_mem_of_mask {l S : List Nat} (h : S.all (fun q => !(maskOf l).testBit q) = true) :
    ∀ q ∈ S, q ∉ l := by
  intro q hq hl
  have := List.all_eq_true.mp h q hq
  simp [testBit_maskOf, hl] at this

/-- `∀ q ∈ S, q ∈ l` from one pass over `S` against the mask of `l`. -/
theorem mem_of_mask {l S : List Nat} (h : S.all (fun q => (maskOf l).testBit q) = true) :
    ∀ q ∈ S, q ∈ l := by
  intro q hq
  have := List.all_eq_true.mp h q hq
  simpa [testBit_maskOf] using this

/-- One-pass duplicate check with a bit mask accumulator (raw `List.rec`). -/
def nodupB (l : List Nat) : Nat → Bool :=
  @List.rec Nat (fun _ => Nat → Bool) (fun _ => true)
    (fun x _ ih acc => !(acc.testBit x) && ih (acc ||| 2 ^ x)) l

theorem nodupB_spec : ∀ (l : List Nat) (acc : Nat), nodupB l acc = true →
    l.Nodup ∧ ∀ x ∈ l, acc.testBit x = false
  | [], _, _ => ⟨List.nodup_nil, by simp⟩
  | x :: l, acc, h => by
    have h' : (!(acc.testBit x) && nodupB l (acc ||| 2 ^ x)) = true := h
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at h'
    obtain ⟨hx, hl⟩ := h'
    obtain ⟨nd, fresh⟩ := nodupB_spec l _ hl
    refine ⟨List.nodup_cons.mpr ⟨fun hm => ?_, nd⟩, ?_⟩
    · have := fresh x hm; rw [Nat.testBit_or, Nat.testBit_two_pow] at this; simp at this
    · intro y hy
      rcases List.mem_cons.mp hy with rfl | hy
      · exact hx
      · have := fresh y hy; rw [Nat.testBit_or] at this; simp only [Bool.or_eq_false_iff] at this; exact this.1

theorem nodup_of_nodupB {l : List Nat} (h : nodupB l 0 = true) : l.Nodup := (nodupB_spec l 0 h).1

end ECDSAAdd.Entrant.WSlimMain
end

