    (fun q hq => (hr q).trans (data q hq).symm)
  rw [ref] at phys
  exact ⟨phys.1, fun q hq => (phys.2 q hq).trans (result q),
    fun q hq => run_rename_pool_outside f _ p subp m actual q hq⟩

