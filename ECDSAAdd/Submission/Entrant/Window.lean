namespace ECDSAAdd.Entrant.StairPacket.HighBankBarrel
open HighBankControl HighBankShift

def stage (c : Wire) (w : Nat → Wire) (xs : List Wire) (d n : Nat) : Program :=
  toggles c xs ++ (program c w d n ++ toggles c xs)

def holds (w : Nat → Wire) (len x : Nat) (s : State) := ∀ i<len, s.basis (w i) = x.testBit i

def outside (w : Nat → Wire) (len q : Nat) := ∀ i<len, q ≠ w i

structure Result (w : Nat → Wire) (len x : Nat) (s t : State) : Prop where
  bits : holds w len x t
  phase : t.phase = s.phase
  frame : ∀ q, outside w len q → t.basis q = s.basis q

theorem number {c w d n len x} (L : Layout c w len) (hd : 0<d) (fits : n+d≤len)
    (xs : List Wire) (away : c ∉ xs) (sep : ∀ q ∈ xs, outside w len q)
    (s : State) (m : List Bool) (clean : s.basis c=false) (data : holds w len x s) (bound : x<2^n) :
    Result w len (if parity s.basis xs then x <<< d else x) s (run (stage c w xs d n) m s) := by
  let bit := parity s.basis xs
  let u : State := ⟨s.phase,writeBit s.basis c bit⟩
  let v := run (program c w d n) m u
  have sub : Layout c w (n+d) :=
    ⟨fun i hi j hj => L.injective i (by omega) j (by omega),fun i hi => L.separate i (by omega)⟩
  have eq : run (stage c w xs d n) m s = ⟨v.phase,writeBit v.basis c (s.basis c)⟩ := by
    simpa [stage,u,v,bit,clean] using wrapped sub hd xs away
      (fun q h i hi => sep q h i (by omega)) s m
  have rd (i : Nat) (hi : i<len) : u.basis (w i) = x.testBit i := by
    simpa [u,writeBit,Function.update,Ne.symm (L.separate i hi)] using data i hi
  have f := frame sub hd u m
  rw [eq]
  constructor
  · intro i hi
    change writeBit v.basis c _ (w i) = _
    rw [writeBit,Function.update_of_ne (Ne.symm (L.separate i hi))]
    have keep (h : n + d ≤ i) : v.basis (w i) = x.testBit i := by
      exact (f.2 (w i) (fun j hj e => by have := L.injective i hi j (by omega) e; omega)).trans (rd i hi)
    by_cases b : bit
    · have uc : u.basis c=true := by simp [u,writeBit,b]
      have zero (j : Nat) (hj : n≤j) (hj' : j<n+d) : u.basis (w j)=false := by
        rw [rd j (by omega)]
        exact Nat.testBit_lt_two_pow (bound.trans_le (Nat.pow_le_pow_right (by decide) hj))
      rw [if_pos b,Nat.testBit_shiftLeft]
      by_cases active : i<n+d
      · rw [show v.basis (w i) = _ from enabled sub hd u m uc zero i active]
        by_cases h : i<d
        · simp [h,show ¬(i ≥ d) by omega]
        · simp [h,show i≥d by omega,rd (i-d) (by omega)]
      · have h₁ : x.testBit i=false := Nat.testBit_lt_two_pow (bound.trans_le (Nat.pow_le_pow_right (by decide) (by omega)))
        have h₂ : x.testBit (i-d)=false := Nat.testBit_lt_two_pow (bound.trans_le (Nat.pow_le_pow_right (by decide) (by omega)))
        simp [keep (by omega),h₁,h₂]
    · have uc : u.basis c=false := by simpa [u,writeBit] using Bool.eq_false_iff.mpr b
      rw [if_neg b]
      exact (congrArg (fun t : State => t.basis (w i)) (disabled sub hd u m uc)).trans (rd i hi)
  · exact f.1
  · intro q h
    by_cases e : q=c
    · subst q; simp [writeBit]
    · change writeBit v.basis c _ q = _
      rw [writeBit,Function.update_of_ne e]
      exact (f.2 q (fun i hi => h i (by omega))).trans (by simp [u,writeBit,Function.update,e])


theorem parity_congr {a b : BasisState} {xs : List Wire} (eq : ∀ q ∈ xs, a q = b q) :
    parity a xs = parity b xs := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    rw [parity,parity,eq x (by simp),ih (fun q h => eq q (List.mem_cons_of_mem _ h))]

theorem start {w len x} {s : State} (data : holds w len x s) :
    ∀ m, Result w len (x <<< 0) s (run [] m s) := by
  intro m
  simpa using (show Result w len x s s from ⟨data,rfl,fun _ _ => rfl⟩)

theorem next {P w c n d len x amount target} {s : State} {xs : List Wire}
    (L : Layout c w len) (hd : 0<d) (fits : n+d≤len)
    (away : c ∉ xs) (sep : ∀ q ∈ xs, outside w len q)
    (clean : s.basis c=false) (room : x <<< amount < 2^n)
    (add : amount + (if parity s.basis xs then d else 0) = target)
    (prev : ∀ m, Result w len (x <<< amount) s (run P m s)) :
    ∀ m, Result w len (x <<< target) s (run (P ++ stage c w xs d n) m s) := by
  intro m
  rw [run_append,run_take]
  let t := run P m s
  have h := prev m
  have tc : t.basis c=false := (h.frame c L.separate).trans clean
  have eq : parity t.basis xs = parity s.basis xs := parity_congr (fun q hq => h.frame q (sep q hq))
  have v := number L hd fits xs away sep t (m.drop (measurementCount P)) tc h.bits room
  rw [eq] at v
  have amountEq : (if parity s.basis xs then (x <<< amount) <<< d else x <<< amount) = x <<< target := by
    rw [← add]
    cases parity s.basis xs <;> simp [Nat.shiftLeft_add]
  rw [amountEq] at v
  exact ⟨v.bits,v.phase.trans h.phase,fun q hq => (v.frame q hq).trans (h.frame q hq)⟩

theorem room {x width a n : Nat} (small : x < 2^width) (fit : width+a ≤ n) :
    x <<< a < 2^n := by
  rw [Nat.shiftLeft_eq]
  exact lt_of_lt_of_le (Nat.mul_lt_mul_of_pos_right small (by positivity : 0 < 2^a))
    ((Nat.pow_add 2 width a).ge.trans (Nat.pow_le_pow_right (by decide) fit))

end ECDSAAdd.Entrant.StairPacket.HighBankBarrel

