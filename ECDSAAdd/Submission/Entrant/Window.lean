theorem stock_history (d:Bool) (x p i:Nat) (s:State) (stage:Rolling1588.Integer.Stage base d x p i s.basis)
    (j:Nat) (after:i≤j) (limit:j<512) : s.basis (base (1028+j))=false:=by
