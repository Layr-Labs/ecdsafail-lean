      calc
        a+8*V=a+8*(V%M+M*(V/M)) := by rw [Nat.mod_add_div]
        _=a+8*(V%M)+(8*M)*(V/M) := by ring
    _=a+8*(V%M) := by rw [Nat.add_mul_mod_self_left,Nat.mod_eq_of_lt bound]


