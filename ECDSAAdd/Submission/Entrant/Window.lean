def pairs : List (Wire×Wire) := [(407, 922), (408, 923), (409, 924), (410, 925), (411, 926), (412, 927), (413, 928), (414, 929), (415, 930), (416, 931), (417, 932), (418, 933), (419, 934), (420, 935), (421, 936), (422, 937), (423, 938), (424, 939), (425, 940)]
def scanPart := (leave240.take 78)
abbrev L := IntegerPacket.ports (shape 11) 15
theorem emitted : scanPart=scan 425 940 270 1715 pairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem layout : ScanGeometry 425 940 270 1715 pairs := ⟨by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)⟩

theorem result (s : State) (tape : List Bool) (u v : Nat) (G sg : Bool)
    (ready : onRails 11 15 (SkywalkRails.encode G sg u v) s.basis) (fresh:s.basis 1715=false) :
    let t:=run scanPart tape s
    let e:=negative sg u
    t.phase=s.phase ∧ t.basis 1715=e ∧
      (∀i<19,t.basis (407+i)=((u+v)/2^136).testBit i ∧ t.basis (922+i)=((u-e.toNat)/2^136).testBit i) ∧
      ∀q,q≠1715 → q∉sites pairs → t.basis q=s.basis q := by
  rw [emitted]
  have out:=scanRouted 11 136 425 940 270 1715 pairs layout (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) s tape u v G sg ready fresh (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  have frame:=scan_run _ _ _ _ _ layout s tape fresh
  refine ⟨frame.1,out.1,?_,frame.2.2.1⟩
  intro i hi
  have geom : ∀j:Fin 19,(pairs.map Prod.fst).getD j 0=407+j.val ∧ (pairs.map Prod.snd).getD j 0=922+j.val := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  let ix:Fin 19:=⟨i,hi⟩
  rw [←(geom ix).1,←(geom ix).2,HighBankAdjust.bit_read (pairs.map Prod.fst) ix (run (scan 425 940 270 1715 pairs) tape s).basis hi,HighBankAdjust.bit_read (pairs.map Prod.snd) ix (run (scan 425 940 270 1715 pairs) tape s).basis hi,out.2.1,out.2.2]
  exact ⟨rfl,rfl⟩

