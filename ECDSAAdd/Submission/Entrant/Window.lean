theorem body_keeps (j:Fin 23) (P:Program) (ps:Ports) (d:Bool) (row:Nat) (s:State) (m:List Bool)
    (off:∀i:Fin 16,ps ⟨i.val,by omega⟩∉spanSites j 1 14)
