  exact append_sub _ _ _ _ (append_sub _ _ _ _ (append_sub _ _ _ _ (append_sub _ _ _ _
    (append_sub _ _ _ _ (append_sub _ _ _ _ (c 3 2) (c 4 2)) (Finset.Subset.refl _)) (c 4 2)) (c 3 2))
