    simp only [Bool.false_eq_true,if_false,if_true] at ins
    exact ⟨⟨⟨⟨rot,ins⟩,sg⟩,lo⟩,top⟩


theorem junction_flip_bias_resources (retired : Wire) (L : Layout) (hw : L.Widths)
