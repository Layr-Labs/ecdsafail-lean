  refine ⟨⟨arr.1.trans old.1,fun q h=>(untouched _ h).trans (stay _ h),?_⟩,arr.2.1⟩
  intro n
  rw [run_append,run_take]
  change run (reverse d) _ (run (Partial.archiveRestore255 d) _ a)=s
  rw [roundtrip d row limit p tape _ raw]
  exact old.2 _
