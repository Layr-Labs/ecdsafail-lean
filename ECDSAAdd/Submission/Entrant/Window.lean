    intro q hq
    obtain ⟨w1, w2⟩ := start_win j h0 h1
    have rr := rail_win w1 w2
    simp only [LeaveJ.smallC, List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact h.1 ⟨i, by omega⟩
