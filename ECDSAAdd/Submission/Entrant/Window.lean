    AllW (hfree s) (leaveAdjust s) ∧ AllW (hfree s) (leaveBarrel s) ∧ AllW (hfree s) (leaveJoin s) ∧
    AllW (hfree s) (lowRest s) ∧ AllW (hfree s) (leaveStoreMapped s) ∧ AllW (hfree s) (leaveLowClose s) ∧
    AllW (hfree s) (swapsG (movesP s)) := by
