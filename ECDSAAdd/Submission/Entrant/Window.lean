  have paired:∀w∈([1299, 1300, 1812, 1811, 1810, 1810, 1811, 1812, 1300, 1299, 285, 284, 283, 282, 281, 280, 279, 278, 277, 276, 275, 274, 273, 272, 271, 285, 284, 283, 282, 281, 280, 279, 278, 277, 276, 275, 274, 273, 272, 271]:List Wire),flip w [1299, 1300, 1812, 1811, 1810, 1810, 1811, 1812, 1300, 1299, 285, 284, 283, 282, 281, 280, 279, 278, 277, 276, 275, 274, 273, 272, 271, 285, 284, 283, 282, 281, 280, 279, 278, 277, 276, 275, 274, 273, 272, 271]=false:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have all:=cancel_all _ paired q
  rw [all,Bool.xor_false]

