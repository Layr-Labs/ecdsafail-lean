namespace ECDSAAdd.Entrant.StairPacket.HighBankAdjust
open Arithmetic HighBankUnit

theorem bit_read (ys : List Wire) (i : Nat) (b : BasisState) (hi : i<ys.length) :
    b (ys.getD i 0) = (regValue ys b).testBit i := by
  have h := regValue_bit ys i 0 b hi
  cases hb : b (ys.getD i 0) <;> cases ht : (regValue ys b).testBit i <;>
    simp_all [Bool.toNat,Nat.testBit_eq_decide_div_mod_eq]

def adjust (ys cs : List Wire) (cin neg : Wire) : Program :=
  signComplement neg ys ++ (add ys cs cin ++ signComplement neg ys)

def adjusted (x width : Nat) (cin neg : Bool) :=
  if neg then (x+2^width-cin.toNat)%2^width else (x+cin.toNat)%2^width

theorem correct (ys cs : List Wire) (cin neg : Wire) (hn : (cin::(ys++cs)).Nodup)
    (negOut : neg∉ys) (size : cs.length+1=ys.length) (s : State) (m : List Bool)
    (clean : ∀q∈cs,s.basis q=false) :
    let r := run (adjust ys cs cin neg) m s
    r.phase=s.phase ∧ (∀ q ∉ ys, r.basis q=s.basis q) ∧
      regValue ys r.basis = adjusted (regValue ys s.basis) ys.length (s.basis cin) (s.basis neg) := by
  have nd := List.nodup_cons.mp hn
  have sep := List.nodup_append'.mp nd.2
  have co : cin ∉ ys := fun h => nd.1 (List.mem_append_left _ h)
  let u := run (signComplement neg ys) m s
  let v := run (add ys cs cin) m u
  have a := signComplement_correct neg ys sep.1 negOut s m
  have b := add_correct ys cs cin hn size u m (fun q h => (a.2.1 q
    (fun hq => (List.disjoint_left.mp sep.2.2 hq h))).trans (clean q h))
  have z := signComplement_correct neg ys sep.1 negOut v (m.drop (measurementCount (add ys cs cin)))
  dsimp only
  rw [adjust,run_append,run_take,(signComplement_counts neg ys).2,List.drop_zero,run_append,run_take]
  refine ⟨z.1.trans (b.1.trans a.1),fun q h => (z.2.1 q h).trans ((b.2.1 q h).trans (a.2.1 q h)),?_⟩
  change regValue ys (run (signComplement neg ys) _ v).basis = _
  rw [z.2.2,show v.basis neg=s.basis neg from (b.2.1 _ negOut).trans (a.2.1 _ negOut)]
  have val : regValue ys v.basis = (regValue ys u.basis+(s.basis cin).toNat)%2^ys.length := by
    simpa only [show u.basis cin=s.basis cin from a.2.1 _ co] using b.2.2
  rw [val,show regValue ys u.basis = _ from a.2.2]
  cases hs : s.basis neg
  · rfl
  · exact complement_unit _ _ _ (regValue_lt _ _)

end ECDSAAdd.Entrant.StairPacket.HighBankAdjust

end

