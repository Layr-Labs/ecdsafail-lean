      · obtain rfl:=List.mem_singleton.mp tail
        exact (x.upper _ hp).2.trans (y.upper _ hp).2.symm
    · exact (x.unchanged _ hn hf hu hh).trans (y.unchanged _ hn hf hu hh).symm
  cases a;cases b;congr
