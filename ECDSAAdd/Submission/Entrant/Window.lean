            rfl
  | cons c cs ih =>
    cases xs with
    | nil => simp at hc
    | cons a xs =>
      cases xs with
      | nil => simp at hc
      | cons a' as =>
        cases as with
        | nil => simp at hc
        | cons a'' as =>
          cases ys with
          | nil => simp at hy
          | cons b ys =>
            cases ys with
            | nil => simp at hy
