    · rintro (h1 | ⟨i, hi, e⟩)
      · exact ⟨⟨k, h⟩, Nat.lt_succ_self k, of_decide_eq_true h1⟩
      · exact ⟨i, Nat.lt_succ_of_lt hi, e⟩
    · rintro ⟨i, hi, e⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | hi
      · exact Or.inr ⟨i, hi, e⟩
      · left
        apply decide_eq_true
        have hk : (⟨k, h⟩ : Fin n) = i := Fin.ext hi.symm
        rw [hk]; exact e

