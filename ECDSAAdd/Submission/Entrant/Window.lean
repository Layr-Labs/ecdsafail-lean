        (fun i hi => ⟨⟨trivial, bank_workT j h0 h1 i (by omega)⟩, ⟨trivial, bank_workT j h0 h1 (i+d) (by omega)⟩⟩)
    exact allAT_append (allAT_append (allAT_append (st _ _ _ (by omega)) (st _ _ _ (by omega))) (st _ _ _ (by omega)))
