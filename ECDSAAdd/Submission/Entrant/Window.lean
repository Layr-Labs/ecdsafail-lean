    (regValue_zero _ _).mpr (fun q hq => h.2.2.2 q (smallM_mag j h0 h1 q hq))
  have rest := LeaveJ.restore_run j h0 h1 c (m.drop (measurementCount (CoreCheckpoint.program j))) cleanCs clearM
