def Exterior (i top q:Nat):Prop :=
  ¬((i+15≤q ∧ q≤top) ∨ (786≤q ∧ q≤1042) ∨ (1556≤q ∧ q≤1812) ∨ (1044+i≤q ∧ q<1044+i+15))
