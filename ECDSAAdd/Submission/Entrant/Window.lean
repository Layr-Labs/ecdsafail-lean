    (bank : regValue (LeaveJ.ys j) s.basis = if Shadow.far (sbP (start j)) 15 z then Shadow.high (sbP (start j)) 15 z else 0)
    (zero : ∀ q ∈ LeaveJ.watched j, s.basis q = false)
