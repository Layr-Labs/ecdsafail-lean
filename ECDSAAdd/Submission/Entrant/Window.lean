  have pad:∀i:Fin 112,97 ≤ i.val → unmodified (wire i):=by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave225FullArithmetic.unmodified); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
