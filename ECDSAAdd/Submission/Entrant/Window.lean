theorem saved_at_leave (d:Bool) (raw cut:State) (z:SkywalkNat.State) (G S:Bool) (head ticks:List Bool)
    (small:min z.u z.v<2^144) (packed:PackedCut Enter225.lowerPairs Enter225.upperPairs 240 1723 1721 1722
