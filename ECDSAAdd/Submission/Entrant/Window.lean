theorem work_dest (j : Fin 23) (h0 : 1 ≤ j.val) (h1 : j.val ≤ 21) :
    ∀ q ∈ (GateMirror.forward (workOps (start j))).map LeaveReadoutFrame.destination, workT j q := by
