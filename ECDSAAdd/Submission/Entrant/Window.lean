namespace ECDSAAdd.Entrant.StairPacket.EnterProof
open Arithmetic CodecBitSliceVerify

def Formula (r : Nat) : Prop :=
  ∀ q:Fin width,(get input q).testBit r=r.testBit q ∧ (get output q).testBit r=(result r).testBit q
instance (r:Nat) : Decidable (Formula r) := inferInstanceAs (Decidable (∀_:Fin width,_))

def Interval (lo n : Nat) : Prop := ∀ j : Fin n, Formula (lo+j)
instance (lo n:Nat) : Decidable (Interval lo n) := inferInstanceAs (Decidable (∀_:Fin n,_))

theorem combine (lo n : Nat) (a:Interval lo n) (b:Interval (lo+n) n) : Interval lo (n+n) := by
  intro j
  by_cases h:j.val<n
  · exact a ⟨j,h⟩
  · have hj:=j.isLt
    have rhs:=b ⟨j.val-n,by omega⟩
    change Formula (lo+n+(j.val-n)) at rhs
    change Formula (lo+j.val)
    rwa [show lo+n+(j.val-n)=lo+j.val by omega] at rhs

-- WSLIM: `Interval lo n` from one flattened pass: rows lo..lo+n-1, and per row the 23 input/output columns walked
-- in step (no `getElem?` lookups, no `Fin` instances; bits compared with accelerated `>>>`/`&&&`/`Nat.beq`).
noncomputable def wslimBitEq (a i b k : Nat) : Bool :=
  Nat.beq ((a >>> i) &&& 1) ((b >>> k) &&& 1)

theorem wslimBitEq_iff (a i b k : Nat) : wslimBitEq a i b k = true ↔ a.testBit i = b.testBit k := by
  unfold wslimBitEq
  rw [Nat.beq_eq, Nat.and_one_is_mod, Nat.and_one_is_mod, Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow,
    Nat.testBit_eq_decide_div_mod_eq, Nat.testBit_eq_decide_div_mod_eq]
  rcases Nat.mod_two_eq_zero_or_one (a / 2 ^ i) with h1 | h1 <;>
    rcases Nat.mod_two_eq_zero_or_one (b / 2 ^ k) with h2 | h2 <;> simp [h1, h2]

/-- columns `ins`/`outs` = wires q, q+1, … at row `r`: input bit = bit q of `r`, output bit = bit q of `res` -/
noncomputable def wslimCols (r res : Nat) (ins : List Nat) : List Nat → Nat → Bool :=
  List.rec (motive := fun _ => List Nat → Nat → Bool) (fun _ _ => true)
    (fun a _ ih outs q => List.rec (motive := fun _ => Bool) false
      (fun b bs _ => wslimBitEq a r r q && wslimBitEq b r res q && ih bs (q + 1)) outs) ins

theorem wslimCols_sound (r res : Nat) : ∀ (ins outs : List Nat) (q : Nat), wslimCols r res ins outs q = true →
    ∀ i (hi : i < ins.length), ∃ hj : i < outs.length,
      ins[i].testBit r = r.testBit (q + i) ∧ outs[i].testBit r = res.testBit (q + i)
  | [], _, _, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | a :: as, [], q, h, _, _ => absurd h (by intro h'; cases h')
  | a :: as, b :: bs, q, h, i, hi => by
    have h' : (wslimBitEq a r r q && wslimBitEq b r res q && wslimCols r res as bs (q + 1)) = true := h
    simp only [Bool.and_eq_true, wslimBitEq_iff] at h'
    cases i with
    | zero => exact ⟨Nat.zero_lt_succ _, by simpa using h'.1.1, by simpa using h'.1.2⟩
    | succ i =>
      obtain ⟨hj, e1, e2⟩ := wslimCols_sound r res as bs (q + 1) h'.2 i (Nat.lt_of_succ_lt_succ hi)
      refine ⟨Nat.succ_lt_succ hj, ?_, ?_⟩
      · simpa [Nat.add_assoc, Nat.add_comm 1 i] using e1
      · simpa [Nat.add_assoc, Nat.add_comm 1 i] using e2

noncomputable def wslimRows (lo : Nat) (n : Nat) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun j ih => wslimCols (lo + j) (result (lo + j)) input output 0 && ih) n

theorem wslim_formula (r : Nat) (hl : input.length = width) (h : wslimCols r (result r) input output 0 = true) :
    Formula r := by
  intro q
  have hq : q.val < input.length := by rw [hl]; exact q.isLt
  obtain ⟨hj, e1, e2⟩ := wslimCols_sound r (result r) input output 0 h q.val hq
  simp only [Nat.zero_add] at e1 e2
  unfold CodecBitSliceVerify.get
  rw [List.getElem?_eq_getElem hq, List.getElem?_eq_getElem hj]
  exact ⟨e1, e2⟩

theorem wslim_interval (lo : Nat) (hl : input.length = width) : ∀ n, wslimRows lo n = true → Interval lo n
  | 0, _, j => absurd j.isLt (Nat.not_lt_zero _)
  | n + 1, h, j => by
    have h' : (wslimCols (lo + n) (result (lo + n)) input output 0 && wslimRows lo n) = true := h
    rw [Bool.and_eq_true] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.mp j.isLt with hj | hj
    · exact wslim_interval lo hl n h'.2 ⟨j.val, hj⟩
    · show Formula (lo + j.val)
      rw [hj]
      exact wslim_formula (lo + n) hl h'.1

theorem wslim_input_length : input.length = width := by decide
end ECDSAAdd.Entrant.StairPacket.EnterProof

