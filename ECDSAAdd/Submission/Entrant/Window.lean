    (parity:∀q∈paritySites,ref q=s.basis q)
    (product:s.basis 1597=(s.basis 1716 && (signExpr ports k).read ref))
    (leftFlag:left k=(s.basis 1713 && s.basis 1714)) (rightFlag:right k=(s.basis 1713 && !s.basis 1714))
