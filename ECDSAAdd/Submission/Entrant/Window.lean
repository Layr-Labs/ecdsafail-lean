    (cut:PackedCut loPairs hiPairs 285 1700 1698 1699 (PortalValues.negative sg z.u)
      (decide (3*2^137≤z.u+z.v)) (decide (3*2^137≤z.u+z.v ∧ 2^121≤z.u))
