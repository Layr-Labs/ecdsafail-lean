      ≤ a0P (start j) - 1 + 18 := Nat.add_le_add_left ile _
    _ = a0P (start j) + 17 := by
        rw [show (18 : Nat) = 1 + 17 from rfl, ← Nat.add_assoc, Nat.sub_add_cancel one]
    _ ≤ 633 + 17 := Nat.add_le_add_right ha 17
