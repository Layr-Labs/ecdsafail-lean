theorem lowShape : beforeTags=notRegister history++store 270 1715 low [] := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem tailShape : afterLow=LeaveNoSwap.block 1717 1714 events++lastPart := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem split : ending=beforeTags++afterLow := by simp only [ECDSAAdd.Entrant.WSlimV3.seg_drop, eq_self, ending, beforeTags, afterLow]

theorem lowResult (s:State) (m:List Bool) :
    let h:=fun q=>if q∈history then !s.basis q else s.basis q
