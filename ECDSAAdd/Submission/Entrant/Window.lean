scoped instance (priority := high) decForallFinNe (n q : Nat) (f : Fin n → Nat) :
    Decidable (∀ i : Fin n, q ≠ f i) :=
  decidable_of_iff ((famMaskAux n f n (Nat.le_refl n)).testBit q = false) (by
    rw [← Bool.not_eq_true, famMaskAux_testBit]
