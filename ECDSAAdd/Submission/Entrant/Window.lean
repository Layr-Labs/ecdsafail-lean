  have low : (sumBit A B C).toNat≤1 := by cases sumBit A B C <;> decide
  have pow : n+2+1=n+3 := by omega
  rw [pow] at sum
  unfold Extended at h ⊢
  have step : 2^(n+1)=2*2^n := by rw [Nat.pow_succ,Nat.mul_comm]
  rw [←sum,step] at h
  omega


