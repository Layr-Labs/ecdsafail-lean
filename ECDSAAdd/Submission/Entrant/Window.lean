  exact Nat.div_le_div_right (show 513 - s ≤ 423 by omega)

theorem a0_le (j : Fin 23) (h0 : 1 ≤ j.val) (h1 : j.val ≤ 21) : a0P (start j) ≤ 633 := by
  have w := start_win j h0 h1
  simp only [a0P]
  have sb := sb_hi (start j) w.1
