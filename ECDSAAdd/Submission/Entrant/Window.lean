          simp_all [GatePhysical,RecordedQuantum.PhysicalInstr,ProperGate,ne_comm]
        simpa only [CoherentTail.addPrefix,gatePhysical_append] using
          And.intro (And.intro (And.intro (majority_physical _ _ _ _ headND) step)
