  have ydecode : signedRegValue L.y u.basis=Y := by
    unfold signedRegValue
    rw [widths.2.2.1,uy]
    exact decode_encodeWord 256 (by decide) Y hy
  have target : signedRegValue (rawTarget L) u.basis=X :=
