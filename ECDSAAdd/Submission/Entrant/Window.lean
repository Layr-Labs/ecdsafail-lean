theorem inverts (s:State) (phase:∀m,(run Partial.leave240 m s).phase=s.phase)
    (initial:∀q, 1556≤q → q≤1709 → s.basis q=false)
    (core:zeros (run (Partial.leave240.take 2395) [] s) [1560,1576,1596,1613,1614])
