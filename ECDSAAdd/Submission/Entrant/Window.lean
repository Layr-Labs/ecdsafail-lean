theorem junction_not_resources (retired : Wire) (L : Layout) (hn : L.wires.Nodup)
    (member : retired∈L.carry.take 254) (xs : List Wire)
    (data : ∀q∈xs,q∈[L.sign,L.parity,L.lower,L.one]++L.r++L.y) :
