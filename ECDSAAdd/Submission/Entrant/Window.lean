    (flagIn : state.basis (base 2409)=false) (holeIn : state.basis (s j hole)=false) :
    run (halfWindowWith P j active hole) records state=
      run (SW.selW (g j active) (base 2409)
        P) records state := by
  let copied := run [.CX (g j active) (base 2409)] [] state
  let original := P
  let fresh := P
