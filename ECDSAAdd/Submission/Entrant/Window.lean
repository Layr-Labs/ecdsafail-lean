    rw [Relocated.src_out _ w1 w2 q (Or.inr (Or.inr (by first | omega | (unfold Wire; omega)))) ⟨by first | omega | (unfold Wire; omega), by first | omega | (unfold Wire; omega), f3, f5, f6, f7, Or.inr (by first | omega | (unfold Wire; omega))⟩]
