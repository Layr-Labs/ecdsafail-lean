namespace ECDSAAdd.Entrant.StairPacket.HighBankControl

def toggles (c : Wire) (xs : List Wire) : Program := xs.map (fun q => .CX q c)

def parity (read : BasisState) : List Wire → Bool
  | [] => false
  | q::qs => read q ^^ parity read qs

theorem toggle_run (c : Wire) (xs : List Wire) (read : BasisState) (s : State) (m : List Bool)
    (away : c ∉ xs) (same : ∀ q ∈ xs, s.basis q = read q) :
    run (toggles c xs) m s = ⟨s.phase,writeBit s.basis c (s.basis c ^^ parity read xs)⟩ := by
  induction xs generalizing s with
  | nil =>
    apply congrArg₂ State.mk rfl
    funext q
    by_cases h : q=c <;> simp [parity,writeBit,Function.update,h]
  | cons q qs ih =>
    have rest : c ∉ qs := fun h => away (by simp [h])
    let t : State := ⟨s.phase,writeBit s.basis c (s.basis c ^^ s.basis q)⟩
    change run (toggles c qs) m t = _
    have agree : ∀ a ∈ qs, t.basis a = read a := by
      intro a ha
      have h : a ≠ c := fun h => rest (h ▸ ha)
      simpa [t,writeBit,Function.update,h] using same a (List.mem_cons_of_mem _ ha)
    rw [ih t rest agree]
    apply congrArg₂ State.mk rfl
    funext a
    by_cases h : a=c
    · subst a
      simp [t,writeBit,parity,same q (by simp)]
    · simp [t,writeBit,Function.update,h]

theorem toggle_measures (c : Wire) (xs : List Wire) : measurementCount (toggles c xs) = 0 := by
  induction xs with
  | nil => rfl
  | cons q qs ih => exact ih

/-- Compute the stride selector, apply the controlled permutation and restore the selector. -/
theorem wrapped {c w d n} (L : HighBankShift.Layout c w (n+d)) (hd : 0<d)
    (xs : List Wire) (away : c ∉ xs) (outside : ∀ q ∈ xs, ∀ i<n+d, q ≠ w i)
    (s : State) (m : List Bool) :
    let u : State := ⟨s.phase,writeBit s.basis c (s.basis c ^^ parity s.basis xs)⟩
    let v := run (HighBankShift.program c w d n) m u
    run (toggles c xs ++ (HighBankShift.program c w d n ++ toggles c xs)) m s =
      ⟨v.phase,writeBit v.basis c (s.basis c)⟩ := by
  dsimp only
  rw [run_append,run_take,toggle_measures,List.drop_zero,run_append,run_take,
    (HighBankShift.counts c w d n).2,List.drop_zero,
    toggle_run c xs s.basis s m away (fun _ _ => rfl)]
  let u : State := ⟨s.phase,writeBit s.basis c (s.basis c ^^ parity s.basis xs)⟩
  let v := run (HighBankShift.program c w d n) m u
  change run (toggles c xs) m v = ⟨v.phase,writeBit v.basis c (s.basis c)⟩
  have frame := (HighBankShift.frame L hd u m).2
  have agree : ∀ q ∈ xs, v.basis q = s.basis q := by
    intro q h
    have ne : q ≠ c := fun eq => away (eq ▸ h)
    exact (frame q (outside q h)).trans (by simp [u,writeBit,Function.update,ne])
  have vc : v.basis c = (s.basis c ^^ parity s.basis xs) :=
    (frame c L.separate).trans (by simp [u,writeBit])
  rw [toggle_run c xs s.basis v m away agree,vc]
  simp

end ECDSAAdd.Entrant.StairPacket.HighBankControl

end

