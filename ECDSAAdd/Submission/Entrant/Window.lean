theorem value (z:SkywalkNat.State) :
    Leave225TrueMiddle.F z/2^7=Shadow.high 136 15 (endpoint z) := by
  change ((endpoint z).u+(endpoint z).v)/2^145/2^7=_ 
  rw [Nat.div_div_eq_div_mul]
