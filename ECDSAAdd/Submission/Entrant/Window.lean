theorem layout : ScanGeometry 433 933 285 1708 pairs := ⟨by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)⟩

theorem result (s : State) (tape : List Bool) (u v : Nat) (G sg : Bool)
    (ready : onRails 12 15 (SkywalkRails.encode G sg u v) s.basis) (fresh:s.basis 1708=false) :
    let t:=run scanPart tape s
    let e:=negative sg u
    t.phase=s.phase ∧ t.basis 1708=e ∧
      (∀i<19,t.basis (415+i)=((u+v)/2^129).testBit i ∧ t.basis (915+i)=((u-e.toNat)/2^129).testBit i) ∧
      ∀q,q≠1708 → q∉sites pairs → t.basis q=s.basis q := by
  rw [emitted]
  have out:=scanRouted 12 129 433 933 285 1708 pairs layout (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) s tape u v G sg ready fresh (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  have frame:=scan_run _ _ _ _ _ layout s tape fresh
  refine ⟨frame.1,out.1,?_,frame.2.2.1⟩
  intro i hi
  have geom : ∀j:Fin 19,(pairs.map Prod.fst).getD j 0=415+j.val ∧ (pairs.map Prod.snd).getD j 0=915+j.val := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  let ix:Fin 19:=⟨i,hi⟩
  rw [←(geom ix).1,←(geom ix).2,HighBankAdjust.bit_read (pairs.map Prod.fst) ix (run (scan 433 933 285 1708 pairs) tape s).basis hi,HighBankAdjust.bit_read (pairs.map Prod.snd) ix (run (scan 433 933 285 1708 pairs) tape s).basis hi,out.2.1,out.2.2]
  exact ⟨rfl,rfl⟩

