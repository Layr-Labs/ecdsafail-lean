        | nil => simp at hy
        | cons b ys =>
          cases ys with
          | nil => simp at hy
          | cons z zs =>
            have zz : zs=[] := List.eq_nil_of_length_eq_zero (by simp only [List.length_cons,List.length_nil] at hy; omega)
