section
namespace ECDSAAdd.Entrant.StairPacket.NativeJ
open Arithmetic MappedCompressed IntegerPacket SkywalkRails EnterProof Partial ArchivePortAction WideReference
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
attribute [local irreducible] run SkywalkNat.step

/-- dadon's `NativePack{s}.stock_endpoint`, generic (interior blocks `2 ≤ j ≤ 12`, next block `k = j+1`): the
leave's output is the next block's packed cut, and the next pack's archive facts hold. -/
theorem stock_endpoint (j k : Fin 23) (hk : k.val=j.val+1) (h2 : 2≤j.val) (h12 : j.val≤18)
    (hne : start j≠WideReference.firstBlock) (d:Bool) (x p:Nat) (good:Bounds x p) (raw s:State)
    (m n:List Bool) (domain:Domain (start j) x p raw) (G S:Bool)
    (cut:PackedCut (EnterJ.lowerPairs j) (EnterJ.upperPairs j) (EnterJ.gate j) (EnterJ.flagN j) (EnterJ.flagF j)
      (EnterJ.flagU j) (PortalValues.negative S (unsigned (start j) x p).u)
      (decide (Shadow.far (sbP (start j)) 15 (unsigned (start j) x p)))
      (decide (Shadow.far (sbP (start j)) 15 (unsigned (start j) x p) ∧ 2^(sbP (start j))≤(unsigned (start j) x p).u))
      (pullState (EnterJ.pull j) raw) (eraseSites (EnterJ.pending j) s))
    (input:SkywalkIntegerInput (EnterJ.lay j) (encode G S (unsigned (start j) x p).u (unsigned (start j) x p).v).a
      (encode G S (unsigned (start j) x p).u (unsigned (start j) x p).v).b G raw.basis)
    (scratch:∀k:Fin 157,23≤k.val →
      let pre:=run (Partial.enterP j) m s
      let tape:=m.drop (measurementCount (Partial.enterP j))
      (run (program j d) (tape.drop (measurementCount (routed j 0 1))) (run (routed j 0 1) tape pre)).basis
        (ArchiveJ.rawPorts (prev j) k)=false)
    (pg ps cross:Bool)
    (prior:PastFacts (prev j) (ArchiveJ.rawPorts (prev j)) (sbP (start (prev j))) (unsigned (start (prev j)) x p) pg ps cross s)
    (band : ∀q:Nat,1301≤q → q≤1058+start j → (run (nextWindow j d) m s).basis q=false) :
    PackedCut (EnterJ.lowerPairs k) (EnterJ.upperPairs k) (EnterJ.gate k) (EnterJ.flagN k) (EnterJ.flagF k)
      (EnterJ.flagU k)
      (PortalValues.negative (LeaveJ.Admission.flags (unsigned (start j) x p) G S).2 (unsigned (start k) x p).u)
      (decide (Shadow.far (sbP (start k)) 15 (unsigned (start k) x p)))
      (decide (Shadow.far (sbP (start k)) 15 (unsigned (start k) x p) ∧ 2^(sbP (start k))≤(unsigned (start k) x p).u))
      (pullState (EnterJ.pull k) (endRaw (start j) raw (run (nextWindow j d) m s)))
      (eraseSites (EnterJ.pending k) (run (leaveP j) n (run (nextWindow j d) m s))) ∧
    PastFacts j (ArchiveJ.rawPorts j) (sbP (start j)) (unsigned (start j) x p) G S
      (HighBankSum.cross (LeaveJ.TrueMiddle.d j (unsigned (start j) x p)))
      (run (leaveP j) n (run (nextWindow j d) m s)) := by
  obtain ⟨w1, w2⟩ := start_win j (by omega) (by omega)
  have numbers:=LeaveJ.Admission.actualNumbers j (by omega) (by omega) x p good
  have old:=LeaveJ.Admission.actualNumbers (prev j) (by simp only [prev]; omega) (by simp only [prev]; omega) x p good
  have hist:=pulled_history j rfl domain
  have native:=from_domain j h2 (by omega) d x p good raw s m domain G S cut input scratch pg ps cross prior
  obtain ⟨_,_,_,_,tags⟩:=real_receipt j (by omega) (by omega) d raw s m (unsigned (start j) x p) G S numbers.odd
    numbers.small cut input hist scratch (unsigned (start (prev j)) x p) pg ps cross old.odd old.small prior
  let pre:=run (Partial.enterP j) m s
  let tape:=m.drop (measurementCount (Partial.enterP j))
  let T:=Shadow.reduced (sbP (start j)) 15 (unsigned (start j) x p)
  let Z:=encode G S T.u T.v
  have to':T.v%2=1:=shadow_odd (sbP (start j)) (unsigned (start j) x p) numbers.small numbers.odd
  have parity:(Z.a+Z.b)%2=1:=encode_odd_sum G S _ _ (by omega)
  have ready:=EnterJ.ready_pending_at j raw s (unsigned (start j) x p) G S m numbers.small cut input hist
  obtain ⟨_,row,limit,frame⟩:=admits j (by omega) (by omega) d s m tape (tape.drop (measurementCount (routed j 0 1))) Z parity
    ready.2.1 scratch (unsigned (start (prev j)) x p) pg ps cross old.odd old.small prior
  have final:=archive_result j (by omega) (by omega) d row limit _ _ frame
  have tail:=tail_clean j (by omega) (by omega) d x p raw s domain m tape _ _ _ cut row final
  have runEq : run (nextWindow j d) m s = run (body j (withArchive j d)) tape pre := by
    simp only [nextWindow, window, run_append, run_take, pre, tape]
  have gg (g s:Bool) (u v:Int) : (encode g s u v).g=g:=by cases g <;> rfl
  have orig:InputAt (start j) (encode G S (unsigned (start j) x p).u (unsigned (start j) x p).v) raw:=by
    unfold InputAt;rw [gg];exact input
  have h := native.1
  have ph := native.2.1
  refine ⟨?_, LeaveJ.ArchiveCut.result j (by omega) (by omega) (run (nextWindow j d) m s) n (unsigned (start j) x p) G S h⟩
  have bit : (run (nextWindow j d) m s).basis (e0P (start j)+8) = false := by
    have t2 := tags ⟨2, by omega⟩
    have e : e0P (start j) + 8 = sbP (start j)+1580+(⟨2, by omega⟩:Fin 3).val := by simp only [e0P]; omega
    rw [e]; exact t2
  rw [runEq] at h ph band bit ⊢
  exact LeaveJ.BodyCut.result j k hk h2 h12 hne d x p good raw s m tape n _ _ _ G S domain cut orig h ph bit tail band

end ECDSAAdd.Entrant.StairPacket.NativeJ
end

-- ==== build-chain: the generic stock chain of the window 120..255 (exit 270) ====
-- ==== build-chain: skeleton: FinalW (from Main), hand-off AtJ/ReadyW, the leaf statements, the three step forms ====
/-! build-chain skeleton: the 120..255 stock chain (exit 270) over the generic fold, with every missing leaf as a
named hypothesis (`*Spec`). Part A (the restated fold chain) and Part B (generic hand-off, FinalW) go into Window;
the leaves are proved one by one and the `Leaves` bundle disappears. -/

-- Part A (the restated fold chain) is in Window since w4r 4295495.

-- ===== Part B: FinalW (moved from Main), the generic hand-off and the window's Before =====
section
namespace ECDSAAdd.Entrant.StairPacket.ArchiveStockRows
open Arithmetic IntegerPacket SkywalkRails WideReference StairArchiveRaw StairArchiveTrace CodecBitSliceVerify ArchivePortAction

/-- par-d2: `Final` for the window of blocks `j1 .. jn`, whose exit tick is `start jn+15` (moved here from Main). -/
structure FinalW (j1 jn : Fin 23) (exitPorts : Ports) (d:Bool) (x p:Nat) (out:State) : Prop where
  saved : ∀ k : Fin 23, j1.val ≤ k.val → k.val < jn.val →
    ∃row<63145,Chronology (start k) x p row ∧ Kept (ArchiveJ.codePorts k) d row out
  last : ∃row<63145,Chronology (start jn) x p row ∧ Frame exitPorts (code d) row out

/-- The code ports of bank `b` of the window `j1 .. jn` (`j1+b ≤ jn`). -/
def bankPorts (j1 jn : Fin 23) (exitPorts : Ports) (b : Nat) : Ports :=
  if h : j1.val+b < jn.val then ArchiveJ.codePorts ⟨j1.val+b,by omega⟩ else exitPorts

/-- `StockArchiveBanks.keptAt`, generic: every bank's 16 code cells are kept with their block's chronology. -/
theorem FinalW.bank {j1 jn : Fin 23} {exitPorts : Ports} {d:Bool} {x p:Nat} {out:State}
    (res : FinalW j1 jn exitPorts d x p out) (b : Nat) (hb : j1.val+b ≤ jn.val) :
    ∃row<63145,Chronology (start j1+15*b) x p row ∧ Kept (bankPorts j1 jn exitPorts b) d row out := by
  unfold bankPorts
  by_cases h:j1.val+b<jn.val
  · rw [dif_pos h]
    have e:start j1+15*b=start ⟨j1.val+b,by omega⟩:=by simp only [start]; omega
    rw [e]
    exact res.saved ⟨j1.val+b,by omega⟩ (Nat.le_add_right _ _) h
  · rw [dif_neg h]
    have e:start j1+15*b=start jn:=by simp only [start]; omega
    obtain ⟨r,l,t,f⟩:=res.last
    refine ⟨r,l,?_,fun j=>f ⟨j,by omega⟩⟩
    rw [e]; exact t

/-- The window's final archive state: every saved key of blocks 3..11 and block 12's exit frame (`FinalW 3 12`). -/
abbrev Final (d:Bool) (x p:Nat) (out:State) : Prop :=
  FinalW ⟨3,by decide⟩ ⟨18,by decide⟩ ArchiveBoundary360.codePorts d x p out

end ECDSAAdd.Entrant.StairPacket.ArchiveStockRows
end

section
namespace ECDSAAdd.Entrant.StairPacket.StockWindowW
open Arithmetic MappedCompressed IntegerPacket WideReference SkywalkRails Partial ArchivePortAction ArchiveStockRows
open StockWindowTicket WindowFold WindowChain Secp256k1
set_option linter.unusedVariables false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

/-- dadon's `At240`/`At255` for any block `k` (the saved keys are `window_strong`'s `Key`). -/
structure AtJ (k : Fin 23) (d:Bool) (x p:Nat) (raw s:State) (g sg pg ps:Bool) : Prop where
  domain : Domain (start k) x p raw
  input : InputAt (start k) (signedAt (start k) x p g sg) raw
  cut : PackedCut (EnterJ.lowerPairs k) (EnterJ.upperPairs k) (EnterJ.gate k) (EnterJ.flagN k) (EnterJ.flagF k)
      (EnterJ.flagU k) (flagNeg (start k) x p sg)
      (decide (farAt (sbP (start k)) (start k) x p))
      (decide (farAt (sbP (start k)) (start k) x p ∧ 2^(sbP (start k))≤(unsigned (start k) x p).u))
      (pullState (EnterJ.pull k) raw) (eraseSites (EnterJ.pending k) s)
  facts : PastFacts (NativeJ.prev k) (ArchiveJ.rawPorts (NativeJ.prev k)) (sbP (start (NativeJ.prev k)))
      (unsigned (start (NativeJ.prev k)) x p) pg ps
      (HighBankSum.cross (LeaveJ.TrueMiddle.d (NativeJ.prev k) (unsigned (start (NativeJ.prev k)) x p))) s
  pastCanonical : signedAt (start (NativeJ.prev k)) x p pg ps=WideReference.canonical (start (NativeJ.prev k)) x p

/-- The hand-off at tick `t` (a block start). -/
def ReadyW (d:Bool) (x p:Nat) (t:Nat) (s:State) : Prop :=
  ∃ k : Fin 23, start k=t ∧ ∃ raw g sg pg ps, AtJ k d x p raw s g sg pg ps

/-- Block `i`'s saved archive key (dadon's `Saved (start i) x p (codePorts) d`). -/
def KeyW (d:Bool) (x p:Nat) (i:Fin 23) (s:State) : Prop :=
  ∃row<63145, Chronology (start i) x p row ∧ Kept (ArchiveJ.codePorts i) d row s

/-- The window's precondition: the stock walk at tick 120 (dadon's `Before` at 225). -/
def BeforeW (d:Bool) (x p:Nat) (s:State) := ∃raw:State,
  Rolling1588.Integer.Stage base d x p 120 raw.basis ∧ s=pullState (OB5.sig 119) raw

/-- The last block's frame at the exit (dadon's `Final.last`). -/
def LastW (d:Bool) (x p:Nat) (s:State) : Prop :=
  ∃row<63145,Chronology 345 x p row ∧ Frame ArchiveBoundary360.codePorts (code d) row s

/-- par-c2's archive-scratch hypothesis of `NativeJ.from_domain(_matched)`. -/
def ScratchAt (j : Fin 23) (d:Bool) (m:List Bool) (s:State) : Prop :=
  ∀k:Fin 157,23≤k.val →
    let pre:=run (Partial.enterP j) m s
    let tape:=m.drop (measurementCount (Partial.enterP j))
    (run (NativeJ.program j d) (tape.drop (measurementCount (StairPacket.routed j 0 1)))
      (run (StairPacket.routed j 0 1) tape pre)).basis
      (ArchiveJ.rawPorts (NativeJ.prev j) k)=false

-- ===== Leaves (statements fixed here; each becomes a theorem) =====

/-- L1: generic `NativePack{s}.stock_endpoint` (interior block `j`, next block `k = j+1`). -/
abbrev EndpointSpec : Prop :=
  ∀ (j k : Fin 23), k.val=j.val+1 → 4≤j.val → j.val≤18 → ∀ (d:Bool) (x p:Nat) (good:Bounds x p) (raw s:State)
    (m n:List Bool) (domain:Domain (start j) x p raw) (G S:Bool)
    (cut:PackedCut (EnterJ.lowerPairs j) (EnterJ.upperPairs j) (EnterJ.gate j) (EnterJ.flagN j) (EnterJ.flagF j)
      (EnterJ.flagU j) (PortalValues.negative S (unsigned (start j) x p).u)
      (decide (Shadow.far (sbP (start j)) 15 (unsigned (start j) x p)))
      (decide (Shadow.far (sbP (start j)) 15 (unsigned (start j) x p) ∧ 2^(sbP (start j))≤(unsigned (start j) x p).u))
      (pullState (EnterJ.pull j) raw) (eraseSites (EnterJ.pending j) s))
    (input:SkywalkIntegerInput (EnterJ.lay j) (encode G S (unsigned (start j) x p).u (unsigned (start j) x p).v).a
      (encode G S (unsigned (start j) x p).u (unsigned (start j) x p).v).b G raw.basis)
    (scratch:ScratchAt j d m s) (pg ps cross:Bool)
    (prior:PastFacts (NativeJ.prev j) (ArchiveJ.rawPorts (NativeJ.prev j)) (sbP (start (NativeJ.prev j)))
      (unsigned (start (NativeJ.prev j)) x p) pg ps cross s),
    PackedCut (EnterJ.lowerPairs k) (EnterJ.upperPairs k) (EnterJ.gate k) (EnterJ.flagN k) (EnterJ.flagF k)
      (EnterJ.flagU k)
      (PortalValues.negative (LeaveJ.Admission.flags (unsigned (start j) x p) G S).2 (unsigned (start k) x p).u)
      (decide (Shadow.far (sbP (start k)) 15 (unsigned (start k) x p)))
      (decide (Shadow.far (sbP (start k)) 15 (unsigned (start k) x p) ∧ 2^(sbP (start k))≤(unsigned (start k) x p).u))
      (pullState (EnterJ.pull k) (endRaw (start j) raw (run (NativeJ.nextWindow j d) m s)))
      (eraseSites (EnterJ.pending k) (run (leaveP j) n (run (NativeJ.nextWindow j d) m s))) ∧
    PastFacts j (ArchiveJ.rawPorts j) (sbP (start j)) (unsigned (start j) x p) G S
      (HighBankSum.cross (LeaveJ.TrueMiddle.d j (unsigned (start j) x p)))
      (run (leaveP j) n (run (NativeJ.nextWindow j d) m s))

/-- L2: the archive scratch of block `j` is clean after its pack (par-d2's ScratchWrap). -/
abbrev ScratchSpec : Prop :=
  ∀ (j : Fin 23), 2≤j.val → j.val≤19 → ∀ (d:Bool) (x p:Nat) (good:Bounds x p) (raw s:State) (g sg pg ps:Bool)
    (m:List Bool), AtJ j d x p raw s g sg pg ps → ScratchAt j d m s

/-- L3: the leave undoes (GlueB's `Admission.Inputs.roundtrip`). -/
abbrev RoundtripSpec : Prop :=
  ∀ (j : Fin 23), 2≤j.val → j.val≤19 → ∀ (v:State) (z:SkywalkNat.State) (G S:Bool),
    LeaveJ.Admission.Inputs j v z G S → ∀ m n:List Bool, run (leaveInvP j) n (run (leaveP j) m v)=v

/-- L4: the leave of block `k` keeps block `k-1`'s saved code cells (dadon's `ArchiveWindowPreserve.after{s}`). -/
abbrev KeepLeaveSpec : Prop :=
  ∀ (k : Fin 23), 2≤k.val → k.val≤18 → ∀ q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts (NativeJ.prev k)),
    ∀ (v:State) (n:List Bool), (run (leaveP k) n v).basis q=v.basis q

/-- L5: block `k`'s whole step keeps the code cells of every older block `i' ≤ k-2` (dadon's `entering{s}`). -/
abbrev KeepOlderSpec : Prop :=
  ∀ (i k i' : Fin 23), k.val=i.val+1 → 2≤ i'.val → i'.val+2≤k.val → k.val≤18 → ∀ (d:Bool),
    ∀ q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts i'), ∀ (s:State) (m:List Bool),
    (run (nextF WindowParams.params d i k).flatten m s).basis q=s.basis q

/-- L6: the exit pieces keep the code cells of blocks `3..11` (dadon's `ArchiveWindowPreserve.last`). -/
abbrev KeepExitSpec : Prop :=
  ∀ (i : Fin 23), 3≤ i.val → i.val≤17 → ∀ (d:Bool), ∀ q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts i),
    ∀ (s:State) (m:List Bool), (run (exitF WindowParams.params d 360).flatten m s).basis q=s.basis q

/-- L7: the exit pieces at 270 are dadon's exit (par-b's `Check.lean` decides). -/
abbrev ExitProgSpec : Prop :=
  ∀ d:Bool, (exitF WindowParams.params d 360).flatten=NativePack360.lastWindow d ∧
    (exitR WindowParams.params d 360).flatten=NativePack360.lastUnwind d

/-- L8: the generic hand-off at block 13 is dadon's exit hand-off (pairs, flags and raw ports). -/
abbrev ExitBridgeSpec : Prop :=
  EnterJ.lowerPairs ⟨19,by decide⟩=Portal360Flag.loPairs ∧ EnterJ.upperPairs ⟨19,by decide⟩=Portal360Flag.hiPairs ∧
  EnterJ.gate ⟨19,by decide⟩=375 ∧ EnterJ.flagN ⟨19,by decide⟩=1655 ∧ EnterJ.flagF ⟨19,by decide⟩=1653 ∧
  EnterJ.flagU ⟨19,by decide⟩=1654 ∧ EnterJ.pending ⟨19,by decide⟩=ParkEndpoint360.src ∧
  ArchiveJ.rawPorts ⟨18,by decide⟩ 20=1656 ∧ ArchiveJ.rawPorts ⟨18,by decide⟩ 21=1657 ∧
  ArchiveJ.rawPorts ⟨18,by decide⟩ 22=1658

/-- L9: the first block's endpoint at 120 (dadon's `NativePack225.stock_endpoint`, first form). -/
abbrev FirstSpec : Prop :=
  ∀ (d:Bool) (x p:Nat) (good:Bounds x p) (raw:State) (m n:List Bool)
    (stage:Rolling1588.Integer.Stage base d x p 120 raw.basis),
    ∃g s:Bool,
      InputAt 120 (encode g s (unsigned 120 x p).u (unsigned 120 x p).v) raw ∧
      LeaveJ.Admission.Inputs WindowParams.first
        (run (portalP 120 ++ NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw))
        (unsigned 120 x p) g s ∧
      PackedCut (EnterJ.lowerPairs ⟨4,by decide⟩) (EnterJ.upperPairs ⟨4,by decide⟩) (EnterJ.gate ⟨4,by decide⟩)
        (EnterJ.flagN ⟨4,by decide⟩) (EnterJ.flagF ⟨4,by decide⟩) (EnterJ.flagU ⟨4,by decide⟩)
        (PortalValues.negative (LeaveJ.Admission.flags (unsigned 120 x p) g s).2 (unsigned 135 x p).u)
        (decide (Shadow.far (sbP 135) 15 (unsigned 135 x p)))
        (decide (Shadow.far (sbP 135) 15 (unsigned 135 x p) ∧ 2^(sbP 135)≤(unsigned 135 x p).u))
        (pullState (EnterJ.pull ⟨4,by decide⟩)
          (endRaw 120 raw (run (portalP 120 ++ NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw))))
        (eraseSites (EnterJ.pending ⟨4,by decide⟩) (run (leaveP WindowParams.first) n
          (run (portalP 120 ++ NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw)))) ∧
      PastFacts WindowParams.first (ArchiveJ.rawPorts WindowParams.first) (sbP 120) (unsigned 120 x p) g s
        (HighBankSum.cross (LeaveJ.TrueMiddle.d WindowParams.first (unsigned 120 x p)))
        (run (leaveP WindowParams.first) n
          (run (portalP 120 ++ NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw)))

/-- L10: the first window (portal 120, enter, pack) keeps the phase and undoes (dadon's `NativePack225.first_window`). -/
abbrev FirstBackSpec : Prop :=
  ∀ (d:Bool) (x p:Nat) (good:Bounds x p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d x p 120 raw.basis),
    (run (portalP 120 ++ NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw)).phase=raw.phase ∧
    ∀k, run (NativeFirstJ.enteredUnwind WindowParams.first d ++ portalInvP 120) k
      (run (portalP 120 ++ NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw))=
      pullState (OB5.sig 119) raw

structure Leaves : Prop where
  endpoint : EndpointSpec
  scratch : ScratchSpec
  roundtrip : RoundtripSpec
  keepLeave : KeepLeaveSpec
  keepOlder : KeepOlderSpec
  keepExit : KeepExitSpec
  exitProg : ExitProgSpec
  exitBridge : ExitBridgeSpec
  first : FirstSpec
  firstBack : FirstBackSpec

-- ===== Program bridges =====

theorem prev_of (i k : Fin 23) (hk : k.val=i.val+1) : NativeJ.prev k=i := Fin.ext (by simp only [NativeJ.prev]; omega)

theorem start_succ (i k : Fin 23) (hk : k.val=i.val+1) : start k=start i+15 := by simp only [StairPacket.start]; omega

theorem next_eq (d:Bool) (i k : Fin 23) (hk : k.val=i.val+1) :
    (nextF WindowParams.params d i k).flatten=NativeJ.nextWindow k d++leaveP k := by
  have e:=prev_of i k hk
  subst e
  simp only [nextF,WindowParams.params,ofParts,List.flatten_cons,List.flatten_nil,List.append_nil,
    NativeJ.nextWindow,NativeJ.window,StairPacket.body,NativeJ.withArchive,NativeJ.program,List.append_assoc]

theorem nextR_eq (d:Bool) (i k : Fin 23) (hk : k.val=i.val+1) :
    (nextR WindowParams.params d i k).flatten=leaveInvP k++NativeJ.nextUnwind k d := by
  have e:=prev_of i k hk
  subst e
  simp only [nextR,WindowParams.params,ofParts,List.flatten_cons,List.flatten_nil,List.append_nil,
    NativeJ.nextUnwind,NativeJ.unwind,StairPacket.unbody,NativeJ.fromArchive,NativeJ.reverse,List.append_assoc]

theorem first_eq (d:Bool) :
    (WindowParams.params.portal (start WindowParams.first) :: firstF WindowParams.params d WindowParams.first).flatten=
      (portalP 120++NativeFirstJ.enteredWindow WindowParams.first d)++leaveP WindowParams.first := by
  have h120:start WindowParams.first=120:=rfl
  simp only [h120,firstF,WindowParams.params,ofParts,List.flatten_cons,List.flatten_nil,List.append_nil,
    NativeFirstJ.enteredWindow,NativeFirstJ.window,StairPacket.body,NativeFirstJ.program,List.append_assoc]

theorem firstR_eq (d:Bool) :
    (firstR WindowParams.params d WindowParams.first++[WindowParams.params.portalInv (start WindowParams.first)]).flatten=
      leaveInvP WindowParams.first++(NativeFirstJ.enteredUnwind WindowParams.first d++portalInvP 120) := by
  have h120:start WindowParams.first=120:=rfl
  simp only [h120,firstR,WindowParams.params,ofParts,List.cons_append,List.nil_append,List.flatten_cons,List.flatten_nil,
    List.append_nil,NativeFirstJ.enteredUnwind,NativeFirstJ.unwind,StairPacket.unbody,NativeFirstJ.reverse,List.append_assoc]

theorem exitTick_ship : exitTick WindowParams.first WindowParams.rest=360 := by decide

-- ===== The three step forms =====

/-- Interior block `k` (dadon's `step240`/`step255`). -/
theorem interior (L : Leaves) (d:Bool) (x p:Nat) (good:Bounds x p) (i k : Fin 23) (hk : k.val=i.val+1)
    (h4 : 4≤k.val) (h12 : k.val≤18) :
    Checked (nextF WindowParams.params d i k).flatten (nextR WindowParams.params d i k).flatten
      (ReadyW d x p (start k)) (ReadyW d x p (start k+15)) := by
  rw [next_eq d i k hk,nextR_eq d i k hk]
  apply pair (F:=NativeJ.nextWindow k d) (F':=leaveP k) (R:=NativeJ.nextUnwind k d) (R':=leaveInvP k)
  intro s m h
  obtain ⟨k1',e0,raw,g,sg,pg,ps,pre⟩:=h
  have same0:k1'=k:=Fin.ext (by have := e0; simp only [StairPacket.start] at this; omega)
  rw [same0] at pre
  let k0:=k
  let v:=run (NativeJ.nextWindow k0 d) m s
  let n:=m.drop (measurementCount (NativeJ.nextWindow k0 d))
  let out:=run (leaveP k0) n v
  let raw':=endRaw (start k0) raw v
  let k1:Fin 23:=⟨k0.val+1,by omega⟩
  have p1:NativeJ.prev k1=k0:=prev_of k0 k1 rfl
  have s1:start k1=start k0+15:=start_succ k0 k1 rfl
  let flags:=LeaveJ.Admission.flags (unsigned (start k0) x p) g sg
  have h2 : 2≤k0.val := by omega
  have h19 : k0.val≤19 := by omega
  have curr:=readInput (start k0) x p raw g sg pre.input
  have scr:=L.scratch k0 h2 h19 d x p good raw s g sg pg ps m pre
  have native:=NativeJ.from_domain_matched k0 h2 h19 d x p good raw s m pre.domain g sg pre.cut curr scr pg ps _ pre.facts
  obtain ⟨cut,facts⟩:=L.endpoint k0 k1 rfl h4 h12 d x p good raw s m n pre.domain g sg pre.cut curr scr pg ps _ pre.facts
  have hin:=native.1
  have carried:=stepInput_gen (start k0) (sbP (start k0)) x p (by simp only [StairPacket.start]; omega)
    (by simp only [StairPacket.start]; omega) good raw v g sg pre.domain pre.input hin.small
  have lastPhase:out.phase=raw'.phase:=cutPhase cut
  have prevPhase:s.phase=raw.phase:=cutPhase pre.cut
  have ph:=lastPhase.trans ((endRaw_phase (start k0) x p (by simp only [StairPacket.start]; omega) good raw v
    pre.domain).trans prevPhase.symm)
  have canon:=unique_input pre.input (fixed_input _ _ _ (by simp only [StairPacket.start]; omega) good raw pre.domain)
  refine ⟨ph,⟨k1,s1,raw',flags.1,flags.2,g,sg,?_⟩,fun t=>L.roundtrip k0 h2 h19 v _ g sg hin n t,native.2.2.2⟩
  refine ⟨?_,?_,cut,?_,?_⟩
  · rw [s1]; exact carried.1
  · rw [s1]; exact carried.2
  · rw [p1]; exact facts
  · rw [p1]; exact canon

/-- First block at 120 (dadon's `step225`). -/
theorem firstStep (L : Leaves) (d:Bool) (x p:Nat) (good:Bounds x p) :
    Checked (WindowParams.params.portal (start WindowParams.first) :: firstF WindowParams.params d WindowParams.first).flatten
      (firstR WindowParams.params d WindowParams.first++[WindowParams.params.portalInv (start WindowParams.first)]).flatten
      (BeforeW d x p) (ReadyW d x p (start WindowParams.first+15)) := by
  rw [first_eq d,firstR_eq d]
  apply pair (F:=portalP 120++NativeFirstJ.enteredWindow WindowParams.first d) (F':=leaveP WindowParams.first)
    (R:=NativeFirstJ.enteredUnwind WindowParams.first d++portalInvP 120) (R':=leaveInvP WindowParams.first)
  intro s m h
  obtain ⟨raw,stage,rfl⟩:=h
  let v:=run (portalP 120++NativeFirstJ.enteredWindow WindowParams.first d) m (pullState (OB5.sig 119) raw)
  let n:=m.drop (measurementCount (portalP 120++NativeFirstJ.enteredWindow WindowParams.first d))
  let out:=run (leaveP WindowParams.first) n v
  let raw':=endRaw 120 raw v
  obtain ⟨g,sg,input,hin,cut,facts⟩:=L.first d x p good raw m n stage
  let flags:=LeaveJ.Admission.flags (unsigned 120 x p) g sg
  have dom:=initial 120 x p (by decide) d raw stage
  have carried:=stepInput_gen 120 (sbP 120) x p (by decide) (by decide) good raw v g sg dom input hin.small
  have base:out.phase=raw'.phase:=cutPhase cut
  have ph:=base.trans (endRaw_phase 120 x p (by decide) good raw v dom)
  have back:=L.firstBack d x p good raw m stage
  exact ⟨ph,⟨⟨4,by decide⟩,rfl,raw',flags.1,flags.2,g,sg,carried.1,carried.2,cut,facts,
    unique_input input (fixed_input 120 x p (by decide) good raw dom)⟩,
    fun t=>L.roundtrip WindowParams.first (by decide) (by decide) v _ g sg hin n t,back.2⟩

/-- The exit at 270 (dadon's `step270`, without the saved keys, which `window_strong` carries). -/
theorem exitStep (L : Leaves) (d:Bool) (x:Nat) (good:Bounds x p) :
    Checked (exitF WindowParams.params d 360).flatten (exitR WindowParams.params d 360).flatten
      (ReadyW d x p 360) (LastW d x p) := by
  obtain ⟨ef,er⟩:=L.exitProg d
  rw [ef,er]
  intro s m h
  obtain ⟨k,ek,raw,g,sg,pg,ps,pre⟩:=h
  have k13:k=⟨19,by decide⟩:=Fin.ext (by have := ek; simp only [StairPacket.start] at this; show k.val=19; omega)
  subst k13
  obtain ⟨bl,bu,bg,bn,bf,bu',bp,r20,r21,r22⟩:=L.exitBridge
  let z:=unsigned 360 x p
  have short:min z.u z.v<2^76:=true_small x p 360 (lt_trans good.small good.cap) good.cap (by decide)
  have old:=LeaveJ.Admission.actualNumbers ⟨18,by decide⟩ (by decide) (by decide) x p good
  have eq:farAt 76 360 x p=(3*2^92≤z.u+z.v):=by
    apply propext;unfold farAt Shadow.far Shadow.high Shadow.limb;exact Nat.le_div_iff_mul_le (by positivity)
  have cut:=pre.cut
  have e13:start (⟨19,by decide⟩:Fin 23)=360:=rfl
  have sb:sbP 360=76:=by decide
  rw [bl,bu,bg,bn,bf,bu',bp] at cut
  simp only [e13,sb] at cut
  have facts:=pre.facts
  have mode:s.basis 1656=decide (Shadow.far 84 15 (unsigned 345 x p)):=by rw [←r20]; exact facts.far
  have side:s.basis 1657=(decide (Shadow.far 84 15 (unsigned 345 x p)) &&
      StairArchiveTrace.afterFlags (decide ((unsigned 345 x p).v<(unsigned 345 x p).u))
        ((physicalCells ArchiveBoundary360.sourceIdx s).take 5)):=by rw [←r21]; exact facts.suffix
  have cross:s.basis 1658=(decide (Shadow.far 84 15 (unsigned 345 x p)) &&
      HighBankSum.cross (LeaveJ.TrueMiddle.d ⟨18,by decide⟩ (unsigned 345 x p))):=by rw [←r22]; exact facts.crossed
  have last:=NativePack360.matched_from_domain d x good.nonzero good.small raw s m pre.domain z short g sg
    (readInput 360 x p raw g sg pre.input) (by simpa only [eq] using cut) (unsigned 345 x p) pg ps _
    old.odd old.small facts.records mode side cross
  obtain ⟨r,lim,truth,frame⟩:=last.2.1
  have pc:signedAt 345 x p pg ps=WideReference.canonical 345 x p:=pre.pastCanonical
  have chr:Chronology 345 x p r:=by unfold Chronology;rw [←pc];exact truth
  exact ⟨last.1,⟨r,lim,chr,frame⟩,last.2.2⟩

theorem mem_rest {k : Fin 23} (h : k ∈ WindowParams.rest) : 4 ≤ k.val ∧ k.val ≤ 18 := by
  simp only [WindowParams.rest,List.mem_filter,Bool.and_eq_true,decide_eq_true_eq] at h
  omega

theorem rest_eq : WindowParams.rest=[⟨4,by decide⟩,⟨5,by decide⟩,⟨6,by decide⟩,⟨7,by decide⟩,⟨8,by decide⟩,
    ⟨9,by decide⟩,⟨10,by decide⟩,⟨11,by decide⟩,⟨12,by decide⟩,⟨13,by decide⟩,⟨14,by decide⟩,⟨15,by decide⟩,⟨16,by decide⟩,⟨17,by decide⟩,⟨18,by decide⟩] := by decide

theorem consec_ship : Consec WindowParams.first WindowParams.rest := by
  rw [rest_eq]
  exact ⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,trivial⟩

/-- Block `k` saves block `i = k-1`'s key (dadon's `selected{s}` / `Saved` part of `step{s}`). -/
theorem receiptW (L : Leaves) (d:Bool) (x p:Nat) (good:Bounds x p) (i k : Fin 23) (hk : k.val=i.val+1)
    (h2 : 2≤k.val) (h12 : k.val≤18) :
    ∀ s m, ReadyW d x p (start k) s → KeyW d x p i (run (nextF WindowParams.params d i k).flatten m s) := by
  intro s m h
  obtain ⟨k1',e0,raw,g,sg,pg,ps,pre⟩:=h
  have same0:k1'=k:=Fin.ext (by have := e0; simp only [StairPacket.start] at this; omega)
  rw [same0] at pre
  have pk:=prev_of i k hk
  rw [next_eq d i k hk,←pk]
  simp only [run_append,run_take]
  have curr:=readInput (start k) x p raw g sg pre.input
  have scr:=L.scratch k h2 (by omega) d x p good raw s g sg pg ps m pre
  have native:=NativeJ.from_domain_matched k h2 (by omega) d x p good raw s m pre.domain g sg pre.cut curr scr pg ps _ pre.facts
  obtain ⟨row,bound,truth,kept⟩:=native.2.2.1
  have chr:Chronology (start (NativeJ.prev k)) x p row:=by unfold Chronology;rw [←pre.pastCanonical];exact truth
  exact ⟨row,bound,chr,ArchiveWindowPreserve.keep kept (fun q hq=>L.keepLeave k h2 h12 q hq _ _)⟩

theorem keepW (L : Leaves) (d:Bool) (x p:Nat) (i k : Fin 23) (hk : k.val=i.val+1) (h12 : k.val≤18) :
    ∀ s m, ReadyW d x p (start k) s → ∀ i' : Fin 23, 3 ≤ i'.val → i'.val< i.val → KeyW d x p i' s →
      KeyW d x p i' (run (nextF WindowParams.params d i k).flatten m s) := by
  intro s m _ i' h1 h2 key
  obtain ⟨r,lim,chr,kept⟩:=key
  exact ⟨r,lim,chr,ArchiveWindowPreserve.keep kept (fun q hq=>L.keepOlder i k i' hk (by omega) (by omega) h12 d q hq s m)⟩

/-- The window's stock chain, 120..255, exit 270 (`StockWindowChain.checked`'s new body). -/
theorem checkedW (L : Leaves) (d:Bool) (x:Nat) (good:Bounds x p) :
    Checked (forwardW WindowParams.params d WindowParams.first WindowParams.rest)
      (reverseW WindowParams.params d WindowParams.first WindowParams.rest)
      (BeforeW d x p) (FinalW WindowParams.first ⟨18,by decide⟩ ArchiveBoundary360.codePorts d x p) := by
  have f3:WindowParams.first.val=3:=rfl
  have bl:blockOf (exitTick WindowParams.first WindowParams.rest)=19:=by rw [exitTick_ship]; rfl
  have h:=window_strong WindowParams.params d (ReadyW d x p) (KeyW d x p) (BeforeW d x p) (LastW d x p)
    WindowParams.first WindowParams.rest consec_ship (firstStep L d x p good)
    (fun i k hm hk=>interior L d x p good i k hk (mem_rest hm).1 (mem_rest hm).2)
    (fun i k hm hk=>receiptW L d x p good i k hk (by have := mem_rest hm; omega) (by have := mem_rest hm; omega))
    (fun i k hm hk s m r i' h1 h2=>keepW L d x p i k hk (by have := mem_rest hm; omega) s m r i' (by omega) h2)
    (by rw [exitTick_ship]; exact exitStep L d x good)
    (by
      intro s m _ i h1 h2 key
      rw [bl] at h2
      revert key
      rw [exitTick_ship]
      intro key
      obtain ⟨r,lim,chr,kept⟩:=key
      exact ⟨r,lim,chr,ArchiveWindowPreserve.keep kept (fun q hq=>L.keepExit i (by omega) (by omega) d q hq s m)⟩)
  refine checked_mono h ?_
  intro s ⟨last,saved⟩
  refine ⟨fun k h1 h2=>saved k h1 (by rw [bl]; have h2':k.val<18:=h2; omega),last⟩

end ECDSAAdd.Entrant.StairPacket.StockWindowW
end

-- ==== build-chain: the exit at 270 is the record exit ====
/-! build-chain leaves L7 (ExitProg) and L8 (ExitBridge): the generic exit at 270 is dadon's. -/
section
namespace ECDSAAdd.Entrant.StairPacket.StockWindowW
open Arithmetic MappedCompressed IntegerPacket WideReference SkywalkRails Partial ArchivePortAction ArchiveStockRows
open StockWindowTicket WindowFold WindowChain
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

theorem exitBridge : ExitBridgeSpec := by
  refine ⟨?_,?_,rfl,rfl,rfl,rfl,?_,?_,?_,?_⟩ <;> (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem exitLoad_eq (d : Bool) : exitLoadP 360 d=archiveLoad360 d := by cases d <;> rfl
theorem exitRestore_eq (d : Bool) : exitRestoreP 360 d=archiveRestore360 d := by cases d <;> rfl
theorem park_eq : parkP 360=park360 ∧ parkInvP 360=park360Inv := ⟨rfl, rfl⟩
theorem portal_eq : portalP 360=portal360 ∧ portalInvP 360=portal360Inv := ⟨rfl, rfl⟩

theorem exitProg : ExitProgSpec := by
  intro d
  have pk := park_eq
  have pt := portal_eq
  have ld := exitLoad_eq d
  have rs := exitRestore_eq d
  constructor
  · simp only [exitF,WindowParams.params,ofParts,List.flatten_cons,List.flatten_nil,List.append_nil,pk.1,pt.2,ld,
      NativePack360.lastWindow,NativePack360.endSlice,EndTick360.physP,EndTick360.P,NativePack360.program,List.append_assoc]
  · simp only [exitR,WindowParams.params,ofParts,List.flatten_cons,List.flatten_nil,List.append_nil,pk.2,pt.1,rs,
      NativePack360.lastUnwind,NativePack360.endUndo,EndTick360.physQ,EndTick360.Q,NativePack360.reverse,List.append_assoc]

end ECDSAAdd.Entrant.StairPacket.StockWindowW
end

-- ==== build-chain: archive-key footprints ====
/-! build-chain: the archive-key footprint leaves L4 (KeepLeave), L5 (KeepOlder), L6 (KeepExit). A saved key of
block `i` sits on the 16 code cells of `cellsRestoreP (start i+15)`: the cells of ticks `t-10..t-1` and their
history cells (`t = start i+15 ≤ 255`, where `OB5.sig t` fixes them). -/

section
namespace ECDSAAdd.Entrant.StairPacket.StockWindowW
open Arithmetic MappedCompressed IntegerPacket WideReference SkywalkRails Partial ArchivePortAction ArchiveStockRows
open StockWindowTicket WindowFold WindowChain
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
attribute [local irreducible] run

/-- `OB5.sig i` fixes the wires below the moved band. -/
theorem fix_low (i q : Nat) (h : q < 1301) (h2 : q + i < 2069) : OB5.sig i q = q :=
  WideReference.sig_fixed (by intro h'; simp only [Wire] at *; omega) (by intro h'; simp only [Wire] at *; omega)

/-- The saved key cells of block `i` are its archive's first 16 code ports. -/
theorem bank_cells (i : Fin 23) (q : Wire) (h : q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts i)) :
    q ∈ cellsRestoreP (start i + 15) := by
  obtain ⟨j, -, rfl⟩ := List.mem_map.mp h
  have hl : (cellsRestoreP (start i + 15)).length = 16 := by simp [cellsRestoreP]
  have hj : j.val < (cellsRestoreP (start i + 15)).length := by rw [hl]; exact j.isLt
  simp only [ArchiveJ.codePorts, ArchiveJ.code_split, List.append_assoc]
  rw [List.getD_append _ _ _ _ hj, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj, Option.getD_some]
  exact List.getElem_mem _

/-- Closed form of those cells while the sig frame fixes them (`t ≤ 255`). -/
theorem cells_range (t : Nat) (ht : t ≤ 255) (q : Nat) (h : q ∈ cellsRestoreP t) :
    (t+6 ≤ q ∧ q ≤ t+15) ∨ (t+1034 ≤ q ∧ q ≤ t+1042) := by
  have e0 : OB5.sig t (t+1034) = t+1034 := fix_low t (t+1034) (by omega) (by omega)
  have e1 : OB5.sig t (t+1035) = t+1035 := fix_low t (t+1035) (by omega) (by omega)
  have e3 : OB5.sig t (t+1037) = t+1037 := fix_low t (t+1037) (by omega) (by omega)
  have e5 : OB5.sig t (t+1039) = t+1039 := fix_low t (t+1039) (by omega) (by omega)
  have e6 : OB5.sig t (t+1040) = t+1040 := fix_low t (t+1040) (by omega) (by omega)
  have e8 : OB5.sig t (t+1042) = t+1042 := fix_low t (t+1042) (by omega) (by omega)
  simp only [cellsRestoreP, e0, e1, e3, e5, e6, e8, List.mem_cons, List.not_mem_nil, or_false] at h
  rcases h with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> omega

theorem key_range (i : Fin 23) (hi : i.val ≤ 11) (q : Nat)
    (h : q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts i)) :
    (start i+21 ≤ q ∧ q ≤ start i+30) ∨ (start i+1049 ≤ q ∧ q ≤ start i+1057) := by
  have c := cells_range (start i + 15) (by simp only [StairPacket.start]; omega) q (bank_cells i q h)
  omega

/-- Closed form of the cells once the sig frame moves their history half (`t ≥ 267`): `2071-t .. 2079-t`. -/
theorem cells_range_moved (t : Nat) (ht : 267 ≤ t) (ht2 : t ≤ 1000) (q : Nat) (h : q ∈ cellsRestoreP t) :
    (t+6 ≤ q ∧ q ≤ t+15) ∨ (2071 ≤ q+t ∧ q+t ≤ 2079) := by
  have e0 : OB5.sig t (t+1034) = 3113-(t+1034) := c13_sig_low t (t+1034) (by omega) (by omega)
  have e1 : OB5.sig t (t+1035) = 3113-(t+1035) := c13_sig_low t (t+1035) (by omega) (by omega)
  have e3 : OB5.sig t (t+1037) = 3113-(t+1037) := c13_sig_low t (t+1037) (by omega) (by omega)
  have e5 : OB5.sig t (t+1039) = 3113-(t+1039) := c13_sig_low t (t+1039) (by omega) (by omega)
  have e6 : OB5.sig t (t+1040) = 3113-(t+1040) := c13_sig_low t (t+1040) (by omega) (by omega)
  have e8 : OB5.sig t (t+1042) = 3113-(t+1042) := c13_sig_low t (t+1042) (by omega) (by omega)
  simp only [cellsRestoreP, e0, e1, e3, e5, e6, e8, List.mem_cons, List.not_mem_nil, or_false] at h
  rcases h with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> omega

/-- Key cells of every block: blocks `≤ 11` as in `key_range`; blocks `≥ 12` (`t = start i+15 ≥ 270`) keep the low
half `start i+21 .. start i+30` and have their history half moved to `2056-start i .. 2064-start i`. -/
theorem key_range3 (i : Fin 23) (q : Nat) (h : q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts i)) :
    (start i+21 ≤ q ∧ q ≤ start i+30) ∨ (start i ≤ 240 ∧ start i+1049 ≤ q ∧ q ≤ start i+1057) ∨
    (255 ≤ start i ∧ 2056 ≤ q+start i ∧ q+start i ≤ 2064) := by
  have hl := i.isLt
  by_cases h11 : i.val ≤ 11
  · have c := key_range i h11 q h
    have : start i ≤ 240 := by simp only [StairPacket.start]; omega
    omega
  · have c := cells_range_moved (start i + 15) (by simp only [StairPacket.start]; omega)
      (by simp only [StairPacket.start]; omega) q (bank_cells i q h)
    have : 255 ≤ start i := by simp only [StairPacket.start]; omega
    omega

/-- The stock tick at `e`, placed by `OB5.sig e`, misses `q` when `OB5.sig e q` is off its layout (`EndTick.physical_free`
at any tick). -/
theorem c13_tick_free (e : Nat) (he : e ≤ 511) (R : Program)
    (sub : wires R ⊆ (W.compactSkywalkTickLayout base e).wires.toFinset) (q : Wire)
    (off : OB5.sig e q ∉ (W.compactSkywalkTickLayout base e).wires) : q ∉ wires (renameProgram (OB5.sig e) R) := by
  rw [JointForward1588.wires_rename_image]
  intro h
  obtain ⟨w, mem, rfl⟩ := Finset.mem_image.mp h
  rw [OB5.sig_invol e he] at off
  exact off (List.mem_toFinset.mp (sub mem))

/-- The exit at 360 sees a block-`≤ 17` key cell either unmoved (blocks `≤ 11`, or a low half) or as one of the moved
history halves of blocks 12..17 (`2056-start i .. 2064-start i`, within `1726..1809`). -/
theorem c15_exit_split (i : Fin 23) (hi : i.val ≤ 17) (q : Nat)
    (h : q ∈ ArchiveWindowPreserve.bank (ArchiveJ.codePorts i)) :
    (((start i+21 ≤ q ∧ q ≤ start i+30) ∨ (start i+1049 ≤ q ∧ q ≤ start i+1057)) ∧ (q < start i+1049 ∨ start i ≤ 240)) ∨
    (1726 ≤ q ∧ q ≤ 1809) := by
  have c3 := key_range3 i q h
  have : start i ≤ 330 := by simp only [StairPacket.start]; omega
  omega

/-- A key cell below `1301` or at/above `1700` is off the archive scratch band (`ArchiveJ.Band`). -/
theorem c15_band (t q : Nat) (h : q < 1301 ∨ 1700 ≤ q) : ArchiveJ.Band t q := by
  rcases h with h | h
  · exact Or.inl h
  · exact Or.inr (Or.inr (Or.inr (Or.inl h)))

/-- Stock-form exit archive at a moved exit tick `e` (`267 ≤ e ≤ 369`): every wire has `q + e < 2086` (cells `e+6..e+15`
and `2070-e..2079-e`, flags `bTop(e)+1..3 = 1299-e..1301-e`, scratch `≤ 1699`), below every moved key cell of blocks
`start ≤ e-30` (`q + start ≥ 2056`). -/
theorem c13_exitLoad_below (e : Nat) (d : Bool) (he : 267 ≤ e) (he2 : e ≤ 369) :
    ∀ q : Nat, q ∈ wires (exitLoadP e d) → q + e < 2086 := by
  intro q hq
  have hb : bTopP e + e = 1298 := by unfold bTopP railP; split_ifs <;> omega
  rw [exitLoadP, wires_append, Finset.mem_union] at hq
  rcases hq with hq | hq
  · have hP : ∀ q ∈ wires (if d then StairArchiveGates.integer_load0 else StairArchiveGates.integer_load1), q < 155 := by
      cases d
      · exact load1_ports
      · exact load0_ports
    obtain ⟨p', hp, rfl⟩ := mem_wires_rename _ hq
    have hports : ∀ p : Nat, p < 155 → (loadPortsWP e (bTopP e + 1)).getD p 0 + e < 2086 := by
      intro p hp'
      by_cases h1 : p < 20
      · rw [loadPortsWP_cell e _ p h1]
        have hc : (cellsLoadP e).length = 20 := by simp [cellsLoadP]
        rw [List.getD_eq_getElem _ _ (by omega)]
        have cell : ∀ x : Nat, x ∈ cellsLoadP e → x + e < 2086 := by
          intro x hx
          unfold cellsLoadP at hx
          obtain ⟨k, hk, hx⟩ := List.mem_flatMap.mp hx
          have hk' := List.mem_range.mp hk
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl
          · omega
          · rw [c13_sig_low e (e+1034+k) (by omega) (by omega)]; omega
        exact cell _ (List.getElem_mem _)
      by_cases h2 : p < 23
      · obtain ⟨i, rfl⟩ : ∃ i, p = 20 + i := ⟨p - 20, by omega⟩
        rw [loadPortsWP_flag e _ i (by omega)]; simp only [Wire] at *; omega
      · obtain ⟨k, rfl⟩ : ∃ k, p = 23 + k := ⟨p - 23, by omega⟩
        rw [loadPortsWP_scratch e _ k (by omega), scratchS_window e k (by omega) (by omega)]
        have := scratchW_le e k (by omega); simp only [Wire] at *; omega
    exact hports p' (hP p' hp)
  · have s6 : OB5.sig e (e+1036) = 3113-(e+1036) := c13_sig_low e _ (by omega) (by omega)
    have s7 : OB5.sig e (e+1037) = 3113-(e+1037) := c13_sig_low e _ (by omega) (by omega)
    have s8 : OB5.sig e (e+1038) = 3113-(e+1038) := c13_sig_low e _ (by omega) (by omega)
    have s9 : OB5.sig e (e+1039) = 3113-(e+1039) := c13_sig_low e _ (by omega) (by omega)
    have s10 : OB5.sig e (e+1040) = 3113-(e+1040) := c13_sig_low e _ (by omega) (by omega)
    have s11 : OB5.sig e (e+1041) = 3113-(e+1041) := c13_sig_low e _ (by omega) (by omega)
    have s12 : OB5.sig e (e+1042) = 3113-(e+1042) := c13_sig_low e _ (by omega) (by omega)
    have h : AllW (fun q : Nat => q + e < 2086) (swapsG (moveLoadPairs e)) := by
      apply allW_swapsG
      intro pr hpr
      simp only [moveLoadPairs, List.mem_cons, List.not_mem_nil, or_false] at hpr
      rcases hpr with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
        simp only [s6, s7, s8, s9, s10, s11, s12] <;> omega
    exact (allW_programs h).1 q hq

/-- Exit 360 (per-exit `decide`): the portal inverse and the park stay below `1726` (block 17's moved history half). -/
theorem exit360_portal_low : ∀ q : Nat, q ∈ wires (portalInvP 360) → q < 1726 := by
  have h : AllW (fun q => q < 1726) (portalOps 360) := by unfold AllW; decide +kernel
  exact fun q hq => (allW_programs h).2 q hq
theorem exit360_park_low : ∀ q : Nat, q ∈ wires (parkP 360) → q < 1726 := by
  have h : AllW (fun q => q < 1726) (parkOps 360) := by unfold AllW; decide +kernel
  exact fun q hq => (allW_programs h).1 q hq

theorem keepLeave : KeepLeaveSpec := by
  intro k h2 h12 q hq v n
  have pk : start (NativeJ.prev k) + 21 = start k + 6 := by simp only [NativeJ.prev, StairPacket.start]; omega
  have pk' : start (NativeJ.prev k) + 1049 = start k + 1034 := by simp only [NativeJ.prev, StairPacket.start]; omega
  have c := key_range3 (NativeJ.prev k) q hq
  obtain ⟨w1, w2⟩ := start_win k (by omega) (by omega)
  obtain ⟨r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, ew, ew', ee, ee', et, et', ea, eb, el, r20, r21⟩ := rail_win w1 w2
  exact LeaveJ.leave_keeps k (by omega) (by omega) q (by unfold leaveBox2; simp only [Wire] at *; omega) n v
/-- Block `k`'s head and leave never touch an older block's key cells. -/
theorem keepOlder : KeepOlderSpec := by
  intro i k i' hk h2 hik h12 d q hq s m
  have hs : start i' + 30 ≤ start k := by simp only [StairPacket.start]; omega
  have c := key_range3 i' q hq
  obtain ⟨w1, w2⟩ := start_win k (by omega) (by omega)
  obtain ⟨r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, ew, ew', ee, ee', et, et', ea, eb, el, r20, r21⟩ := rail_win w1 w2
  have sk : start k ≤ 345 := by simp only [StairPacket.start]; omega
  have pk : NativeJ.prev k = i := Fin.ext (by simp only [NativeJ.prev]; omega)
  rw [next_eq d i k hk]
  simp only [run_append, run_take]
  rw [LeaveJ.leave_keeps k (by omega) (by omega) q (by unfold leaveBox2; simp only [Wire] at *; omega)]
  simp only [NativeJ.nextWindow, NativeJ.window, run_append, run_take]
  have native : ¬MayTouch k (windowNet k q) := by
    show ¬MayTouch k (OB5.sig (start k + 14) q)
    unfold MayTouch
    have mid : (shape k).mid = sbP (start k)+17 := rfl
    rw [mid, OB5.sig_nat]
    unfold OB5.sigNat
    split_ifs <;> simp only [Wire] at * <;> omega
  have port : q ∉ EnterJ.ports k := by
    simp only [EnterJ.ports, List.mem_cons, List.not_mem_nil, or_false]
    simp only [Wire] at *
    omega
  have admin : q ∉ NativeJ.support k ++ ArchiveJ.rawPortsList (NativeJ.prev k) := by
    rw [List.mem_append, ArchiveJ.raw_split]
    intro mem
    rcases mem with mem | mem
    · simp only [NativeJ.support, List.mem_flatMap, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
        or_false] at mem
      obtain ⟨v, ⟨v1, v2⟩, e | e⟩ := mem
      · rw [OB5.sig_nat] at e; unfold OB5.sigNat at e
        split_ifs at e <;> simp only [MappedCompressed.base, Wire] at * <;> omega
      · rw [OB5.sig_nat] at e; unfold OB5.sigNat at e
        split_ifs at e <;> simp only [MappedCompressed.base, Wire] at * <;> omega
    · rw [List.mem_append] at mem
      have tk : start (NativeJ.prev k) + 15 = start k := by simp only [NativeJ.prev, StairPacket.start]; omega
      rcases mem with mem | mem
      · simp only [ArchiveJ.rawHead, cellsLoadP, List.mem_append, List.mem_flatMap, List.mem_range, List.mem_cons,
          List.not_mem_nil, or_false, tk] at mem
        rcases mem with ⟨c', hc, e | e⟩ | e
        · simp only [Wire] at *; omega
        · rw [OB5.sig_nat] at e; unfold OB5.sigNat at e
          split_ifs at e <;> simp only [Wire] at * <;> omega
        · simp only [e0P, Wire] at *; omega
      · obtain ⟨kk, hkk, e⟩ := List.mem_map.mp mem
        rw [tk] at e
        exact ArchiveJ.band_off (start k) (by omega) (List.mem_range.mp hkk) (c15_band _ _ (by simp only [Wire] at *; omega)) e
  exact WideReference.ext_head (enterP k) k (NativeJ.withArchive k d) _ s m _ q native (EnterJ.notWire k port) admin
    (NativeJ.admin_cover k (by omega) (by omega) d)
/-- The exit pieces at 360 never touch the window's key cells (blocks 3..17; blocks 12..17's history halves are moved). -/
theorem keepExit : KeepExitSpec := by
  intro i h3 h11 d q hq s m
  have si : 120 ≤ start i ∧ start i ≤ 330 := by simp only [StairPacket.start]; omega
  have tsub : wires (TickRanges.tick base 360) ⊆ (W.compactSkywalkTickLayout base 360).wires.toFinset :=
    (TickRanges.tick_support base 360 (by decide) base_pool_nodup).trans
      (W.repairedTick_support base 360 (by decide) base_pool_nodup)
  simp only [exitF, WindowParams.params, ofParts, List.flatten_cons, List.flatten_nil, List.append_nil, run_append, run_take]
  rcases c15_exit_split i h11 q hq with ⟨c, h240⟩ | hq'
  swap
  · -- blocks 12..14's moved history halves `1726..1809`
    rw [run_preserves_outside (exitLoadP 360 d) _ _ q
      (fun hit => absurd (c13_exitLoad_below 360 d (by decide) (by decide) q hit) (by omega))]
    rw [run_preserves_outside _ _ _ q (fun hit => by
      rw [renameProgram_support] at hit
      obtain ⟨w, hw, e⟩ := Finset.mem_image.mp hit
      have pc := (WindowCovered.pack_cells d 350 (by decide) (by decide)).1 w hw
      obtain ⟨r, r1, r2, er | er⟩ := pc <;> rw [er, OB5.sig_nat] at e <;> unfold OB5.sigNat at e <;>
        split_ifs at e <;> simp only [MappedCompressed.base, Wire] at * <;> omega)]
    have nt := c13_tick_free 360 (by decide) _ tsub q (by
      rw [c13_sig_high 360 q (by omega) (by omega)]
      exact WideReference.away (by decide) (c13_earlier 360 q (by omega) (by omega)))
    rw [run_preserves_outside _ _ _ q nt]
    rw [run_preserves_outside (portalInvP 360) _ _ q (fun hit => absurd (exit360_portal_low q hit) (by omega))]
    rw [run_preserves_outside (parkP 360) _ _ q (fun hit => absurd (exit360_park_low q hit) (by omega))]
  · have fixed : OB5.sig 360 q = q := fix_low _ _ (by simp only [Wire] at *; omega) (by simp only [Wire] at *; omega)
    -- exit archive load
    rw [run_preserves_outside (exitLoadP 360 d) _ _ q (fun hit => by
      have f := exitLoadP_wiresW 360 d (by decide) q hit
      have hb : bTopP 360 = 938 := by decide
      unfold archFootW at f; rw [hb] at f; simp only [Wire] at *; omega)]
    -- stock pack at 260
    rw [run_preserves_outside _ _ _ q (fun hit => by
      rw [renameProgram_support] at hit
      obtain ⟨w, hw, e⟩ := Finset.mem_image.mp hit
      have pc := (WindowCovered.pack_cells d 350 (by decide) (by decide)).1 w hw
      obtain ⟨r, r1, r2, er | er⟩ := pc <;> rw [er, OB5.sig_nat] at e <;> unfold OB5.sigNat at e <;>
        rcases c with ⟨lo, hi⟩ | ⟨lo, hi⟩ <;> split_ifs at e <;> simp only [MappedCompressed.base, Wire] at * <;> omega)]
    -- the stock tick at 270
    have nt : q ∉ wires (renameProgram (OB5.sig 360) (TickRanges.tick base 360)) :=
      c13_tick_free 360 (by decide) _ tsub q (by
        rw [fixed]
        apply WideReference.away (by decide)
        rcases c with ⟨lo, hi⟩ | ⟨lo, hi⟩
        · have hn : ∀ n : Nat, 16 ≤ n → n = n - 16 + 16 := fun n h => by omega
          exact ⟨q - 16, by omega, Or.inl (hn q (by omega))⟩
        · have hn : ∀ n : Nat, 1044 ≤ n → n = 1028 + (n - 1044) + 16 := fun n h => by omega
          exact ⟨q - 1044, by omega, Or.inr (hn q (by omega))⟩)
    rw [run_preserves_outside _ _ _ q nt]
    -- exit portal (inverse) and park
    rw [run_preserves_outside (portalInvP 360) _ _ q (fun hit => by
      have f := (portal_wires 360 (by decide) (by decide)).2 q hit
      have hr : railP 360 = 153 := by decide
      unfold footP at f; rw [hr] at f; simp only [Wire] at *; omega)]
    rw [run_preserves_outside (parkP 360) _ _ q (fun hit => by
      have f := (park_wires 360 (by decide) (by decide)).1 q hit
      have hr : railP 360 = 153 := by decide
      unfold parkFootP at f; rw [hr] at f; simp only [Wire] at *; omega)]
end ECDSAAdd.Entrant.StairPacket.StockWindowW
end

-- ==== build-chain: endpoint, scratch, roundtrip ====
/-! build-chain: the skeleton's leaves L1 (Endpoint), L2 (Scratch), L3 (Roundtrip). -/

section
namespace ECDSAAdd.Entrant.StairPacket.NativeJ
open Arithmetic MappedCompressed IntegerPacket SkywalkRails EnterProof Partial ArchivePortAction WideReference
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
attribute [local irreducible] run SkywalkNat.step

/-- The sig band `[1301, s+1058]` is clean after block `j`'s head: empty before 243; at 255 the wires
`1301..1313`, which the head never touches and which hold future history (clean) in the stock reference
(dadon's `Leave255ReleasedActual.mirror`). -/
theorem band_clean (j : Fin 23) (h2 : 2 ≤ j.val) (h12 : j.val ≤ 18) (d:Bool) (x p:Nat) (raw s:State) (m:List Bool)
    (domain:Domain (start j) x p raw) (neg far long:Bool)
    (cut:PackedCut (EnterJ.lowerPairs j) (EnterJ.upperPairs j) (EnterJ.gate j) (EnterJ.flagN j) (EnterJ.flagF j)
      (EnterJ.flagU j) neg far long (pullState (EnterJ.pull j) raw) (eraseSites (EnterJ.pending j) s)) :
    ∀ q:Nat, 1301 ≤ q → q ≤ 1058 + start j → (run (nextWindow j d) m s).basis q = false := by
  intro q lo hi
  by_cases e12 : j.val = 12
  · have hj : j = ⟨12, by decide⟩ := Fin.ext e12
    subst hj
    have mem : q ∈ List.range' 1301 13 := List.mem_range'_1.mpr ⟨lo, by simp only [StairPacket.start] at hi; omega⟩
    have marks : ∀ q ∈ List.range' 1301 13, ¬MayTouch ⟨12,by decide⟩ (windowNet ⟨12,by decide⟩ q) ∧
        q ∉ support ⟨12,by decide⟩ ++ ArchiveJ.rawPortsList (prev ⟨12,by decide⟩) ∧ q ∉ EnterJ.ports ⟨12,by decide⟩ ∧
        q ∉ EnterJ.pending ⟨12,by decide⟩ ∧ EnterJ.pull ⟨12,by decide⟩ q = q ∧ q ≠ EnterJ.flagN ⟨12,by decide⟩ ∧
        q ≠ EnterJ.flagF ⟨12,by decide⟩ ∧ q ≠ EnterJ.flagU ⟨12,by decide⟩ ∧
        q ∉ RailPair.sites (EnterJ.lowerPairs ⟨12,by decide⟩) ∧ q ∉ RailPair.sites (EnterJ.upperPairs ⟨12,by decide⟩) := by
      (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    obtain ⟨off, adminOff, enterOff, pendOff, pullId, hn, hf, hu, nlo, nhi⟩ := marks q mem
    have split : run (nextWindow ⟨12,by decide⟩ d) m s = run (body ⟨12,by decide⟩ (withArchive ⟨12,by decide⟩ d))
        (m.drop (measurementCount (enterP ⟨12,by decide⟩))) (run (enterP ⟨12,by decide⟩) m s) := by
      simp only [nextWindow, window, run_append, run_take]
    rw [split]
    have normal := WideReference.ext_head (enterP _) _ (withArchive _ d) _ s m
      (m.drop (measurementCount (enterP ⟨12,by decide⟩))) q off (EnterJ.notWire _ enterOff)
      adminOff (admin_cover _ (by decide) (by decide) d)
    rw [normal]
    have fr := cut.frame q hn hf hu nlo nhi
    have e1 : (eraseSites (EnterJ.pending ⟨12,by decide⟩) s).basis q = s.basis q := by
      show (if q ∈ EnterJ.pending ⟨12,by decide⟩ then false else s.basis q) = s.basis q
      rw [if_neg pendOff]
    rw [← e1, fr]
    show raw.basis (EnterJ.pull ⟨12,by decide⟩ q) = false
    rw [pullId]
    have qid : q = MappedCompressed.base (1028 + (q - 1044)) := by
      show q = 1028 + (q - 1044) + 16; omega
    have hq : q ≤ 1313 := by simp only [StairPacket.start] at hi; omega
    rw [qid]
    exact WideReference.future_history (by simp only [StairPacket.start]; omega) (by omega) domain
  · by_cases e13 : j.val = 13
    · -- agent13/agent15: at 270 the band is `[1301, 1328]`; the head never touches it; in the entry frame `OB5.sig 269` it
      -- is the dead carries `1800..1812` (`1301..1313`, clean in every domain state) and the future history `1314..1328`.
      have hj : j = ⟨13, by decide⟩ := Fin.ext e13
      subst hj
      have mem : q ∈ List.range' 1301 28 := List.mem_range'_1.mpr ⟨lo, by simp only [StairPacket.start] at hi; omega⟩
      have marks : ∀ q ∈ List.range' 1301 28, ¬MayTouch ⟨13,by decide⟩ (windowNet ⟨13,by decide⟩ q) ∧
          q ∉ support ⟨13,by decide⟩ ++ ArchiveJ.rawPortsList (prev ⟨13,by decide⟩) ∧ q ∉ EnterJ.ports ⟨13,by decide⟩ ∧
          q ∉ EnterJ.pending ⟨13,by decide⟩ ∧ q ≠ EnterJ.flagN ⟨13,by decide⟩ ∧
          q ≠ EnterJ.flagF ⟨13,by decide⟩ ∧ q ≠ EnterJ.flagU ⟨13,by decide⟩ ∧
          q ∉ RailPair.sites (EnterJ.lowerPairs ⟨13,by decide⟩) ∧ q ∉ RailPair.sites (EnterJ.upperPairs ⟨13,by decide⟩) := by
        (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
      obtain ⟨off, adminOff, enterOff, pendOff, hn, hf, hu, nlo, nhi⟩ := marks q mem
      have split : run (nextWindow ⟨13,by decide⟩ d) m s = run (body ⟨13,by decide⟩ (withArchive ⟨13,by decide⟩ d))
          (m.drop (measurementCount (enterP ⟨13,by decide⟩))) (run (enterP ⟨13,by decide⟩) m s) := by
        simp only [nextWindow, window, run_append, run_take]
      rw [split]
      have normal := WideReference.ext_head (enterP _) _ (withArchive _ d) _ s m
        (m.drop (measurementCount (enterP ⟨13,by decide⟩))) q off (EnterJ.notWire _ enterOff)
        adminOff (admin_cover _ (by decide) (by decide) d)
      rw [normal]
      have fr := cut.frame q hn hf hu nlo nhi
      have e1 : (eraseSites (EnterJ.pending ⟨13,by decide⟩) s).basis q = s.basis q := by
        show (if q ∈ EnterJ.pending ⟨13,by decide⟩ then false else s.basis q) = s.basis q
        rw [if_neg pendOff]
      rw [← e1, fr]
      show raw.basis (OB5.sig (start ⟨13,by decide⟩ - 1) q) = false
      have st : start ⟨13,by decide⟩ - 1 = 269 := rfl
      by_cases h13 : q ≤ 1313
      · rw [st, c13_sig_low 269 q lo (by omega)]
        exact WideReference.domain_carry (by decide) domain (3113 - q) (by omega) (by omega)
      · have fx : OB5.sig (start ⟨13,by decide⟩ - 1) q = q := by
          rw [st]; exact c13_fix_mid 269 q (by omega) (by omega)
        rw [fx]
        have qid : q = MappedCompressed.base (1028 + (q - 1044)) := by
          show q = 1028 + (q - 1044) + 16; omega
        rw [qid]
        exact WideReference.future_history (by omega) (by omega) domain
    · by_cases e14 : j.val = 14
      · -- agent13/agent15: at 285 the band is `[1301, 1343]`; the head never touches it; in the entry frame `OB5.sig 284` it
        -- is the dead carries `1785..1812` (`1301..1328`, clean in every domain state) and the future history `1329..1343`.
        have hj : j = ⟨14, by decide⟩ := Fin.ext e14
        subst hj
        have mem : q ∈ List.range' 1301 43 := List.mem_range'_1.mpr ⟨lo, by simp only [StairPacket.start] at hi; omega⟩
        have marks : ∀ q ∈ List.range' 1301 43, ¬MayTouch ⟨14,by decide⟩ (windowNet ⟨14,by decide⟩ q) ∧
            q ∉ support ⟨14,by decide⟩ ++ ArchiveJ.rawPortsList (prev ⟨14,by decide⟩) ∧ q ∉ EnterJ.ports ⟨14,by decide⟩ ∧
