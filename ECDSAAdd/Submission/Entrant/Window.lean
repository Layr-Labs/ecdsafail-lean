      rw [e]; exact t
    · have t := tags ⟨1, by omega⟩
      have e : e0P (start j) + 7 = sbP (start j)+1580+1 := by simp only [e0P]; omega
      rw [e]; exact t
    · rw [runEq]
      apply tail q
      simp only [tailTemps, List.mem_range'_1]
      (try unfold Wire at *); omega

