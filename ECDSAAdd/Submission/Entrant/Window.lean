      (∀q,outside wire 127 q → (∀a∈columns,q≠a.shadow ∧ q≠a.tube) → (cleared t.basis) q=cleared s.basis q) := by
  have base (q:Wire) (diff:q≠1613) : t.basis q=a.basis q := by rw [fix];simp [writeBit,diff]
