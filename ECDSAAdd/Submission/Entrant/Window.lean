namespace ECDSAAdd.Entrant.WSlimMain

/-- `LeaveRelocation.flip` with Bool `Nat.beq` tests. -/
def flipB (a b q : Nat) : Nat := cond (Nat.beq q a) b (cond (Nat.beq q b) a q)

/-- `LeaveRelocation.source` through the raw `List.rec` recursor (kernel-cheap: no `brecOn`). -/
def sourceR (xs : List (Nat × Nat)) (q : Nat) : Nat :=
  @List.rec (Nat × Nat) (fun _ => Nat) q (fun p _ ih => flipB p.1 p.2 ih) xs

theorem flip_eq_flipB (a b q : Nat) : ECDSAAdd.Entrant.StairPacket.LeaveRelocation.flip a b q = flipB a b q := by
  unfold ECDSAAdd.Entrant.StairPacket.LeaveRelocation.flip flipB
  cases h1 : Nat.beq q a with
  | true => rw [if_pos (Nat.eq_of_beq_eq_true h1)]; rfl
  | false =>
    rw [if_neg (Nat.ne_of_beq_eq_false h1)]
    cases h2 : Nat.beq q b with
    | true => rw [if_pos (Nat.eq_of_beq_eq_true h2)]; rfl
    | false => rw [if_neg (Nat.ne_of_beq_eq_false h2)]; rfl

theorem source_eq_sourceR : ∀ (xs : List (Nat × Nat)) (q : Nat),
    ECDSAAdd.Entrant.StairPacket.LeaveRelocation.source xs q = sourceR xs q
  | [], _ => rfl
  | p :: xs, q => by
    show ECDSAAdd.Entrant.StairPacket.LeaveRelocation.flip p.1 p.2
        (ECDSAAdd.Entrant.StairPacket.LeaveRelocation.source xs q) = flipB p.1 p.2 (sourceR xs q)
    rw [source_eq_sourceR xs q, flip_eq_flipB]

/-- A wire below every pair element is fixed by `source`. -/
theorem source_fresh_of_lt {n : Nat} : ∀ {xs : List (Nat × Nat)} (_ : ∀ p ∈ xs, n ≤ p.1 ∧ n ≤ p.2) {q : Nat} (_ : q < n),
    ECDSAAdd.Entrant.StairPacket.LeaveRelocation.source xs q = q
  | [], _, _, _ => rfl
  | p :: xs, h, q, hq => by
    show ECDSAAdd.Entrant.StairPacket.LeaveRelocation.flip p.1 p.2
        (ECDSAAdd.Entrant.StairPacket.LeaveRelocation.source xs q) = q
    rw [source_fresh_of_lt (fun r hr => h r (List.mem_cons_of_mem _ hr)) hq]
    have h1 := (h p List.mem_cons_self).1; have h2 := (h p List.mem_cons_self).2
    unfold ECDSAAdd.Entrant.StairPacket.LeaveRelocation.flip
    rw [if_neg (show ¬ q = p.1 by omega), if_neg (show ¬ q = p.2 by omega)]

end ECDSAAdd.Entrant.WSlimMain
