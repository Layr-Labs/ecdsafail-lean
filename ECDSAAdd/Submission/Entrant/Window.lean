  | cons i p ih =>
    simp only [List.all_cons, Bool.and_eq_true] at h
    have a : ∀ q∈i.wires, q<w := of_decide_eq_true h.1
    rw [wires, Finset.union_subset_iff]
    exact ⟨fun q hq => Finset.mem_range.mpr (a q hq), ih h.2⟩

