    (nextSmall : min (step^[15] z).u (step^[15] z).v < 2^(sbP ((start j) + 15)))
    (bound : LeaveJ.TrueMiddle.F j z < 2^(wpP (start j) + 15)) (xs : List (Bool × Bool)) (len : xs.length = 15)
