  have signAway : L.sign∉L.r := fun bad => BalancedCircuit.flagAway L hn L.sign (by simp) (by simp [bad])
  have signNe : L.sign≠L.parity ∧ L.sign≠L.lower ∧ L.sign≠L.one := by
    have n := scalarND L hn
