-- WSLIM: remaining `decide +kernel` sites use the scoped bit-mask instances of ECDSAAdd.Entrant.WSlimMac (92 sites)
section

namespace ECDSAAdd.Entrant.HighBankJoin
open Arithmetic RecordedQuantum

/-- Each output column retains either the shadow site (before take) or the
tube site (at and after take). The other site is available as a clean ancilla. -/
def pair (low : Bool) (active shadow tube : Wire) : Program :=
  if low then [.CX tube shadow,.CCX active shadow tube]
  else [.CX shadow tube,.CX tube shadow,.CCX active tube shadow]

theorem pair_run (low : Bool) (a s w : Wire) (distinct : [a,s,w].Nodup)
    (input : State) (m : List Bool)
    (clean : if input.basis a then input.basis s=false else input.basis w=false) :
    let out := run (pair low a s w) m input
    out.phase=input.phase ∧
    out.basis (if low then s else w)=(input.basis s ^^ input.basis w) ∧
    out.basis (if low then w else s)=false ∧
    ∀ q, q≠s → q≠w → out.basis q=input.basis q := by
  obtain ⟨has,haw,hsw⟩ : a≠s ∧ a≠w ∧ s≠w := by simpa [and_assoc] using distinct
  dsimp only
  cases low <;> cases ha : input.basis a <;> cases hs : input.basis s <;> cases hw : input.basis w <;>
    simp_all [pair,run,writeBit,Function.update,Ne.symm hsw]

theorem pair_counts (low : Bool) (a s w : Wire) :
    toffoliCount (pair low a s w)=1 ∧ measurementCount (pair low a s w)=0 := by
  cases low <;> exact ⟨rfl,rfl⟩

theorem pair_physical (low : Bool) (a s w : Wire) (distinct : [a,s,w].Nodup) :
    GatePhysical (pair low a s w) := by
  obtain ⟨has,haw,hsw⟩ : a≠s ∧ a≠w ∧ s≠w := by simpa [and_assoc] using distinct
  cases low <;> simp_all [pair,GatePhysical,PhysicalInstr,ProperGate,ne_comm]

/-- The two literal CCX operations in each one-hot digit-clear row. -/
def clearDigit (hot cross d1 lo hi : Wire) : Program := [.CCX hot cross lo,.CCX hot d1 hi]

theorem clear_run (h c d a b : Wire) (distinct : [h,c,d,a,b].Nodup) (s : State) (m : List Bool) :
    let out := run (clearDigit h c d a b) m s
    out.phase=s.phase ∧
    out.basis a=(s.basis a ^^ (s.basis h && s.basis c)) ∧
    out.basis b=(s.basis b ^^ (s.basis h && s.basis d)) ∧
    ∀ q, q≠a → q≠b → out.basis q=s.basis q := by
  have dif : h≠a ∧ d≠a ∧ a≠b := by simp_all [List.nodup_cons]
  obtain ⟨ha,da,ab⟩ := dif
  simp [clearDigit,run,writeBit,Function.update,ha,da,ab,Ne.symm ab]
  intro q qa qb; simp [qa,qb]

/-- Clearing the two indicated digit positions produces exactly the low
remainder, including columns outside the stored two-bit digit. -/
theorem cleared_bits (X t j : Nat) (cross d1 : Bool)
    (digit : X/2^t = cross.toNat + 2*d1.toNat) :
    ((X.testBit j ^^ (decide (j=t) && cross)) ^^ (decide (j=t+1) && d1)) =
      (X%2^t).testBit j := by
  let r := X%2^t
  have hr : r<2^t := Nat.mod_lt _ (Nat.two_pow_pos _)
  have bits := Nat.testBit_two_pow_mul_add (X/2^t) hr j
  rw [show 2^t*(X/2^t)+r=X from Nat.div_add_mod _ _] at bits
  rw [bits]
  by_cases lt : j<t
  · simp [lt,show j≠t by omega,show j≠t+1 by omega,r]
  have zero := Nat.testBit_lt_two_pow (lt_of_lt_of_le hr (Nat.pow_le_pow_right (by decide) (show t≤j by omega)))
  change r.testBit j=false at zero
  change _=r.testBit j
  rw [zero,if_neg lt,digit]
  by_cases e : j=t
  · subst j; cases cross <;> cases d1 <;> simp
  by_cases e1 : j=t+1
  · subst j; cases cross <;> cases d1 <;> simp <;> decide
  have high : 2≤j-t := by omega
  have small : cross.toNat+2*d1.toNat<4 := by cases cross <;> cases d1 <;> decide
  have powBound : 2^2 ≤ 2^(j-t) := Nat.pow_le_pow_right (by decide) high
  have zero' := Nat.testBit_lt_two_pow (lt_of_lt_of_le small powBound)
  simp [e,e1,zero']

/-- At each column the shifted tube and the cleared shadow have disjoint
support. Their XOR is the matching bit of the reassembled positive word. -/
theorem merged_bits (X bank t j : Nat) :
    let a := (X%2^t).testBit j
    let b := (2^t*bank).testBit j
    (if t≤j then a=false else b=false) ∧
    (a ^^ b)=(2^t*bank+X%2^t).testBit j := by
  have hr := Nat.mod_lt X (Nat.two_pow_pos t)
  dsimp only
  rw [Nat.testBit_two_pow_mul_add bank hr j,Nat.testBit_two_pow_mul]
  by_cases h : t≤j
  · have z := Nat.testBit_lt_two_pow (lt_of_lt_of_le hr (Nat.pow_le_pow_right (by decide) h))
    simp [h,Nat.not_lt.mpr h,z]
  · simp [h,Nat.lt_of_not_ge h]

end ECDSAAdd.Entrant.HighBankJoin

end

section

namespace ECDSAAdd.Entrant.HighBankShift
open Arithmetic

/-- Emitted CX a b, CCX c b a, CX a b moves a to b on the enabled branch. -/
def program (c : Wire) (w : Nat → Wire) (d : Nat) : Nat → Program
  | 0 => []
  | n+1 => cswap c (w (n+d)) (w n) ++ program c w d n

theorem counts (c : Wire) (w : Nat → Wire) (d n : Nat) :
    toffoliCount (program c w d n) = n ∧ measurementCount (program c w d n) = 0 := by
  induction n with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    simp only [program,toffoliCount_append,measurementCount_append]
    change 1+_=_ ∧ 0+_=_
    omega

private theorem step (c : Wire) (w : Nat → Wire) (d n : Nat) (m : List Bool) (s : State) :
    run (program c w d (n+1)) m s =
    run (program c w d n) m (run (cswap c (w (n+d)) (w n)) m s) := by
  rw [program,run_append,run_take]
  rfl

structure Layout (c : Wire) (w : Nat → Wire) (len : Nat) : Prop where
  injective : ∀ i < len, ∀ j < len, w i = w j → i = j
  separate : ∀ i < len, c ≠ w i

private theorem Layout.prefix {c w a b} (L : Layout c w b) (h : a ≤ b) : Layout c w a :=
  ⟨fun i hi j hj => L.injective i (by omega) j (by omega), fun i hi => L.separate i (by omega)⟩

private theorem distinct {c w n d} (L : Layout c w (n+1+d)) (hd : 0<d) :
    [c,w (n+d),w n].Nodup := by
  have h : w (n+d) ≠ w n := fun eq => by
    have := L.injective (n+d) (by omega) n (by omega) eq
    omega
  simp [L.separate (n+d) (by omega), L.separate n (by omega),h]

theorem physical {c w d n} (L : Layout c w (n+d)) (hd : 0<d) :
    GatePhysical (program c w d n) := by
  induction n with
  | zero => simp [program,GatePhysical]
  | succ n ih =>
    exact (gatePhysical_append _ _).mpr ⟨cswap_physical _ _ _ (distinct L hd), ih (L.prefix (by omega))⟩

theorem frame {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (m : List Bool) :
    (run (program c w d n) m s).phase=s.phase ∧
    ∀ q, (∀ i<n+d, q≠w i) → (run (program c w d n) m s).basis q=s.basis q := by
  induction n generalizing s with
  | zero => exact ⟨rfl,fun _ _ => rfl⟩
  | succ n ih =>
    rw [step]
    obtain ⟨hp,he,_,_⟩ := cswap_correct _ _ _ (distinct L hd) s m
    obtain ⟨ip,ie⟩ := ih (L.prefix (by omega)) (run (cswap c (w (n+d)) (w n)) m s)
    exact ⟨ip.trans hp,fun q hout => (ie q (fun i hi => hout i (by omega))).trans
      (he q (hout (n+d) (by omega)) (hout n (by omega)))⟩

theorem disabled {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (m : List Bool)
    (hc : s.basis c = false) : run (program c w d n) m s = s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [step]
    obtain ⟨hp,he,ha,hb⟩ := cswap_correct _ _ _ (distinct L hd) s m
    have same : run (cswap c (w (n+d)) (w n)) m s = s := by
      apply congrArg₂ State.mk hp
      funext q
      by_cases hq : q=w (n+d)
      · subst q; simpa only [hc,Bool.false_eq_true,if_false] using ha
      by_cases hj : q=w n
      · subst q; simpa only [hc,Bool.false_eq_true,if_false] using hb
      exact he q hq hj
    rw [same]
    exact ih (L.prefix (by omega))

theorem enabled {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (m : List Bool)
    (hc : s.basis c = true) (clean : ∀ i : Nat, n ≤ i → i < n + d → s.basis (w i)=false) :
    ∀ j<n+d, (run (program c w d n) m s).basis (w j) =
      if j<d then false else s.basis (w (j-d)) := by
  induction n generalizing s with
  | zero =>
    intro j hj
    rw [if_pos (show j<d by omega)]
    exact clean j (by omega) hj
  | succ n ih =>
    let t := run (cswap c (w (n+d)) (w n)) m s
    obtain ⟨_,he,ha,hb⟩ := cswap_correct _ _ _ (distinct L hd) s m
    have far : t.basis (w (n+d))=s.basis (w n) := by simpa only [hc,if_true] using ha
    have cleared : t.basis (w n)=false := by
      simpa only [hc,if_true,clean (n+d) (by omega) (by omega)] using hb
    have keep (i : Nat) (hi : i<n+1+d) (h₁ : i≠n+d) (h₂ : i≠n) : t.basis (w i)=s.basis (w i) :=
      he (w i) (fun eq => h₁ (L.injective _ hi _ (by omega) eq))
        (fun eq => h₂ (L.injective _ hi _ (by omega) eq))
    have tc := (he c (L.separate _ (by omega)) (L.separate _ (by omega))).trans hc
    have smaller := L.prefix (show n+d≤n+1+d by omega)
    have lower := ih smaller t tc (by
      intro i lo hi
      by_cases h : i=n
      · simpa [h] using cleared
      exact (keep i (by omega) (by omega) h).trans (clean _ (by omega) (by omega)))
    intro j hj
    rw [step]
    change (run (program c w d n) m t).basis (w j) = _
    by_cases h : j<n+d
    · rw [lower j h]
      split_ifs with small
      · rfl
      exact keep (j-d) (by omega) (by omega) (by omega)
    have top : j=n+d := by omega
    subst j
    have untouched := (frame smaller hd t m).2 (w (n+d)) (fun i hi eq => by
      have := L.injective (n+d) (by omega) i (by omega) eq
      omega)
    simpa only [if_neg (show ¬ n+d<d by omega), Nat.add_sub_cancel] using untouched.trans far

end ECDSAAdd.Entrant.HighBankShift

end

section

namespace ECDSAAdd.Entrant.HighBankUnit
open Arithmetic

def zeros (width : Nat) : List MappedBit := List.replicate width ⟨none,false⟩

private theorem zeroFacts (n : Nat) (b : BasisState) :
    mappedWires (zeros n)=[] ∧ mappedValue (zeros n) b=0 := by
  induction n with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    simpa [zeros,List.replicate_succ,mappedWires,mappedValue,MappedBit.value] using ih

def add (ys carry : List Wire) (cin : Wire) := mappedAdd (zeros ys.length) ys carry cin
def sub (ys carry : List Wire) (cin : Wire) := mappedSub (zeros ys.length) ys carry cin

theorem add_correct (ys carry : List Wire) (cin : Wire) (hn : (cin::(ys++carry)).Nodup)
    (hc : carry.length+1=ys.length) (s : State) (m : List Bool) (clean : ∀q∈carry,s.basis q=false) :
    (run (add ys carry cin) m s).phase=s.phase ∧
    (∀q,q∉ys → (run (add ys carry cin) m s).basis q=s.basis q) ∧
    regValue ys (run (add ys carry cin) m s).basis=
      (regValue ys s.basis+(s.basis cin).toNat)%2^ys.length := by
  obtain ⟨hw,hv⟩ := zeroFacts ys.length s.basis
  simpa only [add,hv,Nat.zero_add] using mappedAdd_correct (zeros ys.length) ys carry cin hn
    (by simp [hw]) (by simp [zeros]) hc s m clean

theorem complement_unit (b : Bool) (Y N : Nat) (h : Y<N) :
    N-1-((N-1-Y+b.toNat)%N)=(Y+N-b.toNat)%N := by
  cases b
  · simp only [Bool.toNat_false,Nat.add_zero,Nat.sub_zero,Nat.add_mod_right]
    rw [Nat.mod_eq_of_lt h, Nat.mod_eq_of_lt (show N-1-Y<N by omega)]
    omega
  · simp only [Bool.toNat_true]
    by_cases hz : Y=0
    · subst Y
      rw [show N-1-0+1=N by omega,Nat.mod_self,Nat.mod_eq_of_lt (show 0+N-1<N by omega)]
      omega
    · rw [Nat.mod_eq_of_lt (show N-1-Y+1<N by omega),
        show Y+N-1=(Y-1)+N by omega,Nat.add_mod_right,Nat.mod_eq_of_lt (show Y-1<N by omega)]
      omega

theorem sub_correct (ys carry : List Wire) (cin : Wire) (hn : (cin::(ys++carry)).Nodup)
    (hc : carry.length+1=ys.length) (s : State) (m : List Bool) (clean : ∀q∈carry,s.basis q=false) :
    (run (sub ys carry cin) m s).phase=s.phase ∧
    (∀q,q∉ys → (run (sub ys carry cin) m s).basis q=s.basis q) ∧
    regValue ys (run (sub ys carry cin) m s).basis=
      (regValue ys s.basis+2^ys.length-(s.basis cin).toNat)%2^ys.length := by
  have nd := (List.nodup_append'.mp (List.nodup_cons.mp hn).2).1
  have away (q : Wire) (hq : q∈cin::carry) : q∉ys := by
    intro bad
    have count := List.nodup_iff_count.mp hn q
    have a := List.count_pos_iff.mpr hq
    have b := List.count_pos_iff.mpr bad
    simp only [List.count_cons,List.count_append] at count a
    omega
  let s1 : State := ⟨s.phase,fun q => if q∈ys then !s.basis q else s.basis q⟩
  have first (r : List Bool) : run (notRegister ys) r s=s1 := notRegister_correct ys nd s r
  have keep (q : Wire) (hq : q∉ys) : s1.basis q=s.basis q := by simp [s1,hq]
  have ci := keep cin (away cin (by simp))
  have inverted : regValue ys s1.basis=2^ys.length-1-regValue ys s.basis := by
    rw [regValue_congr ys s1.basis (fun q => !s.basis q) (by intro q hq; simp [s1,hq]),regValue_complement]
  obtain ⟨phase,same,value⟩ := add_correct ys carry cin hn hc s1 m
    (fun q hq => (keep q (away q (by simp [hq]))).trans (clean q hq))
  let t := run (mappedAdd (zeros ys.length) ys carry cin) m s1
  have flipValue : regValue ys (fun q => if q∈ys then !t.basis q else t.basis q)=
      2^ys.length-1-regValue ys t.basis := by
    rw [regValue_congr ys _ (fun q => !t.basis q) (by intro q hq; simp [hq]),regValue_complement]
  simp only [sub,mappedSub,List.append_assoc,run_append,run_take,(notRegister_counts ys).2,
    List.take_zero,List.drop_zero]
  rw [first]
  change (run (notRegister ys) _ t).phase=s.phase ∧ _
  rw [notRegister_correct ys nd]
  refine ⟨phase,fun q hq => ?_,?_⟩
  · simp only [hq,if_false]
    exact (same q hq).trans (keep q hq)
  · rw [flipValue,show regValue ys t.basis=_ from value,inverted,ci]
    exact complement_unit _ _ _ (regValue_lt ys s.basis)

theorem counts (ys carry : List Wire) (cin : Wire) (hc : carry.length+1=ys.length) :
    (toffoliCount (add ys carry cin)=ys.length-1 ∧ measurementCount (add ys carry cin)=ys.length-1) ∧
    (toffoliCount (sub ys carry cin)=ys.length-1 ∧ measurementCount (sub ys carry cin)=ys.length-1) :=
  ⟨mappedAdd_counts _ _ _ _ (by simp [zeros]) hc,mappedSub_counts _ _ _ _ (by simp [zeros]) hc⟩

end ECDSAAdd.Entrant.HighBankUnit

end

section

namespace ECDSAAdd.Entrant.IntegerHigh
set_option exponentiation.threshold 1024
open SkywalkNat

/-- A positive long word at r remaining ticks has an elementary uniform guard.
For any 0≤s, both (B/2) and ((B-s)/2) exceed the next guard. -/
def guard : Nat → Nat → Nat
  | 0, s => s+1
  | r+1, s => 2*guard r s+s

theorem guard_zero (s : Nat) : guard 0 s = s+1 := rfl
theorem guard_succ (r s : Nat) : guard (r+1) s = 2*guard r s+s := rfl
theorem guard_formula (r s : Nat) : guard r s+s = 2^r*(2*s+1) := by
  induction r with
  | zero => simp [guard]; omega
  | succ r ih => rw [guard_succ,pow_succ]; nlinarith
theorem guard_gt (r s : Nat) : s < guard r s := by
  induction r with
  | zero => simp [guard_zero]
  | succ r ih => rw [guard_succ]; omega

theorem guard_small (r s b : Nat) (hs : s < 2^b) :
    guard r s ≤ 2^(b+r+1) := by
  have a : 2*s+1 ≤ 2*2^b := by omega
  have mul := Nat.mul_le_mul_left (2^r) a
  have f := guard_formula r s
  rw [pow_succ,pow_add]
  nlinarith

/-- Runs in which u is the long rail have identical odd/even letters and
retain a gap 2^r D at termination. The short rail is exact. -/
theorem long_u (r B s D : Nat) (h : guard r s ≤ B) :
    (step^[r] ⟨B+2^r*D,s⟩) =
      let t := step^[r] ⟨B,s⟩
      ⟨t.u+D,t.v⟩ := by
  induction r generalizing B with
  | zero => simp
  | succ r ih =>
    have hh : 2*guard r s+s ≤ B := by simpa [guard_succ] using h
    have hg := guard_gt r s
    have large : s ≤ B := by omega
    have nz : B ≠ 0 := by omega
    let d := 2^r*D
    have fact : 2^(r+1)*D=2*d := by simp [d,pow_succ]; ring
    have parity : (B+2*d)%2=B%2 := by omega
    simp only [Function.iterate_succ_apply,fact]
    by_cases isEven : B%2=0
    · have base : step ⟨B,s⟩=⟨B/2,s⟩ := by simp [step,nz,isEven]
      have big : step ⟨B+2*d,s⟩=⟨B/2+d,s⟩ := by
        have z : B+2*d≠0 := by omega
        simp only [step,if_neg z,parity,if_pos isEven]
        congr 1; omega
      rw [base,big]
      exact ih _ (by omega)
    · have base : step ⟨B,s⟩=⟨(B-s)/2,s⟩ := by simp [step,nz,isEven,large]
      have big : step ⟨B+2*d,s⟩=⟨(B-s)/2+d,s⟩ := by
        have z : B+2*d≠0 := by omega
        have l : s≤B+2*d := by omega
        simp only [step,if_neg z,parity,if_neg isEven,if_pos l]
        congr 1; omega
      rw [base,big]
      exact ih _ (by omega)


theorem guard_mono (r : Nat) {a b : Nat} (h : a≤b) : guard r a ≤ guard r b := by
  induction r with
  | zero => simpa [guard] using h
  | succ r ih => simp only [guard_succ]; omega

/-- Both states have the same short rail. The long rail differs by a
multiple of the upcoming packet denominator. -/
inductive Rel (r : Nat) : SkywalkNat.State → SkywalkNat.State → Prop where
  | left (B s D : Nat) (h : guard r s ≤ B) :
      Rel r ⟨B+2^r*D,s⟩ ⟨B,s⟩
  | right (B s D : Nat) (h : guard r s ≤ B) :
      Rel r ⟨s,B+2^r*D⟩ ⟨s,B⟩

def letter (z : SkywalkNat.State) : Nat :=
  if z.u%2=0 then 0 else if z.u<z.v then 2 else 1

theorem advance {r : Nat} {z t : SkywalkNat.State} (h : Rel (r+1) z t) :
    letter z = letter t ∧ Rel r (step z) (step t) := by
  cases h with
  | left B s D ready =>
    have lo := guard_gt r s
    have hh : 2*guard r s+s ≤ B := by simpa [guard_succ] using ready
    let d := 2^r*D
    have pow : 2^(r+1)*D=2*d := by simp [d,pow_succ]; ring
    rw [pow]
    have eqp : (B+2*d)%2=B%2 := by omega
    have nb : B ≠ 0 := by omega
    have nn : B+2*d≠0 := by omega
    constructor
    · simp [letter,eqp,show ¬B+2*d<s by omega,show ¬B<s by omega]
    · by_cases e : B%2=0
      · simp only [step,if_neg nn,if_neg nb,eqp,if_pos e]
        rw [show (B+2*d)/2=B/2+d by omega]
        exact .left _ _ D (by omega)
      · simp only [step,if_neg nn,if_neg nb,eqp,if_neg e,if_pos (show s≤B+2*d by omega),
          if_pos (show s≤B by omega)]
        rw [show (B+2*d-s)/2=(B-s)/2+d by omega]
        exact .left _ _ D (by omega)
  | right B s D ready =>
    have lo := guard_gt r s
    have hh : 2*guard r s+s ≤ B := by simpa [guard_succ] using ready
    let d := 2^r*D
    have pow : 2^(r+1)*D=2*d := by simp [d,pow_succ]; ring
    rw [pow]
    constructor
    · simp [letter,show s<B+2*d by omega,show s<B by omega]
    · by_cases zero : s=0
      · subst s
        simp only [step]
        simpa [d,Nat.mul_assoc,Nat.mul_left_comm,Nat.mul_comm] using
          (Rel.right B 0 (2*D) (by omega) : Rel r _ _)
      · by_cases e : s%2=0
        · simp only [step,if_neg zero,if_pos e]
          have bound := guard_mono r (a:=s/2) (b:=s) (by omega)
          simpa [d,Nat.mul_assoc,Nat.mul_left_comm,Nat.mul_comm] using
            (Rel.right B (s/2) (2*D) (by omega) : Rel r _ _)
        · simp only [step,if_neg zero,if_neg e,if_neg (show ¬B+2*d≤s by omega),
            if_neg (show ¬B≤s by omega)]
          rw [show (B+2*d-s)/2=(B-s)/2+d by omega]
          exact .left _ _ D (by omega)

def letters : Nat → SkywalkNat.State → List Nat
  | 0, _ => []
  | k+1, z => letter z :: letters k (step z)

theorem same_letters {r : Nat} {z t : SkywalkNat.State} (h : Rel r z t) :
    letters r z = letters r t := by
  induction r generalizing z t with
  | zero => rfl
  | succ r ih =>
    obtain ⟨first,tail⟩ := advance h
    simp only [letters,first,ih tail]

theorem different {r : Nat} {z t : SkywalkNat.State} (h : Rel r z t) :
    z.u≠z.v ∧ t.u≠t.v := by
  cases h with
  | left B s D h =>
    have := guard_gt r s
    change B+2^r*D≠s ∧ B≠s
    omega
  | right B s D h =>
    have := guard_gt r s
    change s≠B+2^r*D ∧ s≠B
    omega

/-- The live product bound implies the packet's claimed short coordinate. -/
theorem min_bound (u v i b : Nat) (hp : 2 ^ i * (u * v) < 2 ^ 512) (hb : 512 ≤ i + b + b) :
    min u v < 2 ^ b := by
  by_contra fail
  have both : 2^b≤u ∧ 2^b≤v := by simpa [not_lt,le_min_iff] using fail
  have mul := Nat.mul_le_mul_left (2^i) (Nat.mul_le_mul both.1 both.2)
  have powers : 2^512 ≤ 2^(i+b+b) := Nat.pow_le_pow_right (by decide) hb
  rw [pow_add,pow_add] at powers
  rw [Nat.mul_assoc] at powers
  omega

end ECDSAAdd.Entrant.IntegerHigh

end

section

namespace ECDSAAdd.Entrant.IntegerPacket
open Arithmetic


structure Shape where
  start : Nat
  length : Nat
  mid : Nat
  rangeEnd : start+length ≤ 510
  extent : start+length+mid+18 < 786
  midBound : mid ≤ 256

variable (p : Shape)

def ports (j : Nat) : SkywalkIntegerLayout :=
  let a := p.start+j+16
  {a0:=a,b0:=786,ext:=a+(p.mid+2),history:=a+1028,
   previous:=a-1,aSign:=a+(p.mid+1),bSign:=786+(p.mid+1),
   aMid:=List.range' (a+1) p.mid,bMid:=List.range' 787 p.mid,
   carry:=List.range' 1556 (p.mid+1)}

set_option maxRecDepth 8192
set_option maxHeartbeats 2000000

theorem ok (j : Fin p.length) : (ports p j).Valid := by
  constructor
  · simp [ports,List.length_range']
  · simp [ports,SkywalkIntegerLayout.ah,List.length_range']
  · have hj := j.isLt
    have hr := p.rangeEnd
    have he := p.extent
    have hm := p.midBound
    have ranges (a n : Nat) : (List.range' a n).Nodup := List.nodup_range' 1 (by decide)
    simp only [ports,SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,
      SkywalkIntegerLayout.bh,List.nodup_cons,List.nodup_append,ranges,
      List.nodup_nil,List.mem_append,List.mem_cons,
      List.mem_range'_1] 
    simp only [List.not_mem_nil,or_false,true_and,and_true]
    repeat' apply And.intro
    all_goals
      repeat' intro
      repeat' first | cases_type And | cases_type Or
      all_goals
        subst_vars
        try simp only [Wire] at *
        all_goals omega

def seq (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => skywalkIntegerTick (ports p i) ++ seq (i+1) n

def back (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => back (i+1) n ++ skywalkIntegerUntick (ports p i)

theorem executed (j : Fin p.length) (A B : Int) (G : Bool) (parity : (A+B)%2=1) :
    Triple (SkywalkIntegerInput (ports p j) A B G) (skywalkIntegerTick (ports p j))
      (SkywalkIntegerOutput (ports p j) A B G) :=
  skywalkIntegerTick_spec _ (ok p j) A B G parity

theorem metrics (i n : Nat) (hi : i+n≤p.length) :
    toffoliCount (seq p i n) = n*(2*(p.mid+1)) ∧ measurementCount (seq p i n) = n*(p.mid+1) ∧
    toffoliCount (back p i n) = n*(2*(p.mid+1)) ∧ measurementCount (back p i n) = n*(p.mid+1) := by
  induction n generalizing i with
  | zero => simp [seq,back,toffoliCount,measurementCount]
  | succ n ih =>
    have valid := ok p ⟨i,by omega⟩
    change (ports p i).Valid at valid
    obtain ⟨ft,fm,bt,bm⟩ := skywalkIntegerTick_counts _ valid
    obtain ⟨a,b,c,d⟩ := ih (i+1) (by omega)
    simp only [seq,back,toffoliCount_append,measurementCount_append,a,b,c,d]
    have eq : (ports p i).ah.length=p.mid+1 := by simp [ports,SkywalkIntegerLayout.ah]
    rw [eq] at ft fm bt bm
    simp [ft,fm,bt,bm,Nat.succ_mul,Nat.add_comm]


/-- Besides the current rails and history selector, all future extension and
event slots inside the ten-step segment start clean. -/
def ready (j : Nat) (z : SkywalkRails.State) (s : BasisState) : Prop :=
  signedRegValue (ports p j).a s=z.a ∧ signedRegValue (ports p j).b s=z.b ∧
  s (ports p j).previous=z.g ∧ regValue (ports p j).carry s=0 ∧
  ∀d,j≤d → d<p.length → s (ports p d).ext=false ∧ s (ports p d).history=false

private theorem connect (j : Fin p.length) :
    (ports p (j+1:Nat)).a=(ports p j).half ∧ (ports p (j+1:Nat)).previous=(ports p j).a0 := by
  have slide (a n : Nat) : List.range' a n ++ [a+n] = a::List.range' (a+1) n := by
    calc
      _ = List.range' a (n+1) := List.range'_append_1
      _ = _ := List.range'_succ
  have c := congrArg (fun l => l++[p.start+(j:Nat)+p.mid+18])
    (slide (p.start+(j:Nat)+17) p.mid)
  constructor
  · simpa [ports,SkywalkIntegerLayout.a,SkywalkIntegerLayout.ah,
      SkywalkIntegerLayout.half,Nat.add_assoc,Nat.add_left_comm,Nat.add_comm] using c.symm
  · simp [ports]
    omega

private theorem away {j d : Nat} (lt : j<d) (hd : d<p.length) :
    (ports p d).ext∉(ports p j).wires ∧ (ports p d).history∉(ports p j).wires := by
  have hr := p.rangeEnd
  have he := p.extent
  have hm := p.midBound
  simp only [ports,SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,
    SkywalkIntegerLayout.bh,List.mem_append,List.mem_cons,List.mem_range'_1,List.not_mem_nil,or_false]
  constructor <;> intro bad
  all_goals
    repeat' first | cases_type And | cases_type Or
    all_goals
      try simp only [Wire] at *
      all_goals omega

theorem nextOdd (z : SkywalkRails.State) (h : (z.a+z.b)%2=1) :
    ((SkywalkTrace.next z).a+(SkywalkTrace.next z).b)%2=1 := by
  have odd : (SkywalkRails.route z.a z.b).2%2=1 := by
    unfold SkywalkRails.route SkywalkRails.odd
    split <;> simp_all
    all_goals omega
  change ((SkywalkRails.step z).h+(SkywalkRails.step z).k)%2=1
  simp only [SkywalkRails.step]
  split <;> omega

attribute [local irreducible] run skywalkIntegerTick skywalkIntegerUntick signedRegValue regValue

theorem one {j : Nat} (hj : j<p.length) (z : SkywalkRails.State)
    (h : (z.a+z.b)%2=1) :
    Triple (ready p j z) (skywalkIntegerTick (ports p j)) (ready p (j+1) (SkywalkTrace.next z)) := by
  intro s m input
  obtain ⟨ha,hb,hprev,hcarry,clean⟩ := input
  obtain ⟨ext,hist⟩ := clean j (by omega) hj
  obtain ⟨phase,a,b,g,_,_,carry⟩ :=
    executed p ⟨j,hj⟩ _ _ _ h s m ⟨ha,hb,hprev,ext,hist,hcarry⟩
  obtain ⟨nextA,previous⟩ := connect p ⟨j,hj⟩
  refine ⟨phase,?_,b,?_,carry,?_⟩
  · change signedRegValue (ports p (j+1)).a _=_
    rw [nextA]
    exact a
  · change (run (skywalkIntegerTick (ports p j)) m s).basis (ports p (j+1)).previous=(SkywalkRails.step z).g
    rw [previous]
    exact g
  · intro d jd hd
    obtain ⟨ex,hi⟩ := away p (j:=j) (d:=d) (by omega) hd
    have support := (skywalkIntegerTick_wires_subset (ports p j) (ok p ⟨j,hj⟩)).1
    obtain ⟨e0,h0⟩ := clean d (by omega) hd
    exact ⟨(run_preserves_outside _ m s _ (fun hm => ex (List.mem_toFinset.mp (support hm)))).trans e0,
      (run_preserves_outside _ m s _ (fun hm => hi (List.mem_toFinset.mp (support hm)))).trans h0⟩

theorem semantic (i n : Nat) (bound : i+n≤p.length) (z : SkywalkRails.State)
    (odd : (z.a+z.b)%2=1) :
    Triple (ready p i z) (seq p i n) (ready p (i+n) (SkywalkTrace.next^[n] z)) := by
  induction n generalizing i z with
  | zero =>
    intro s m h
    simpa [seq,run] using And.intro (rfl : s.phase=s.phase) h
  | succ n ih =>
    have a := one p (j:=i) (by omega) z odd
    have b := ih (i+1) (by omega) (SkywalkTrace.next z) (nextOdd z odd)
    simpa only [seq,Function.iterate_succ_apply,show i+(n+1)=i+1+n by omega] using a.seq b



end ECDSAAdd.Entrant.IntegerPacket

