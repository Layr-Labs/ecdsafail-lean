  exact ⟨(post _ prev).trans (b.trans (a.symm.trans (pre _ prev).symm)),
    fun k=>(post _ (carry_member 270 _ (scratch_lanes k).1)).trans (full_carry 271 (by decide) _ _ next _ (scratch_lanes k).2)⟩

