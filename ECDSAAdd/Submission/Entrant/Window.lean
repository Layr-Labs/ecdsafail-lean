def interior:Program := (leave240.drop 172).take 2287
def closePart:Program := (leave240.drop 2459).take 3
theorem openShape : openPart=[.X 1557,.CX 407 1557,.CCX 922 1557 1558] := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem closeShape : closePart=[.measureX 1558 [] [.CZ 922 1557],.CX 407 1557,.X 1557] := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem layout : ∀q∈[407,922,1557,1558],q∉interior.map destination := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem released (s:State) (m₀ m₁ m₂:List Bool) (x:s.basis 1557=false) (y:s.basis 1558=false) :
    let u:=run openPart m₀ s
    let v:=run interior m₁ u
    run closePart m₂ v=⟨v.phase,writeBit (writeBit v.basis 1557 false) 1558 false⟩ := by
  let u:=run openPart m₀ s
  let v:=run interior m₁ u
