  dsimp only at input ⊢
  have math:=LeaveRestoreTruth.restored 144 10 z small sg
  have sign:=(LeaveRestoreTruth.truth 144 z small sg).2.2.2
  rw [show smallM.length=10 from rfl,copyValue,input.1,input.2.1,input.2.2,sign]
