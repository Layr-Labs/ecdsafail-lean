  let c := cs.getD 0 0
  let x := L.ylow.drop 1
  let tail := cs.drop 1
  let clear : Program := [.X L.r0,.CX L.parity L.r0]
  let body := renameProgram (Equiv.swap retired L.r0)
    (Q6LifetimeResearch.addTop (x++[L.ymsb,L.ymsb]) (L.rtail++[L.rmsb,L.one]) tail c)
