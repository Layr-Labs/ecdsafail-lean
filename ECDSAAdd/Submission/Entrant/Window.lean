  omega

/-- `Enter{s}.layout`. -/
def layout (j : Fin 23) : Aperture (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j) (ports j)
    (lay j) (pull j) (sbP (start j)+15) where
