    (small:min a.u a.v<2^136) (far:Shadow.far 136 15 a) :
    (2^144≤a.u-sign) ↔ (2^136≤a.u) := by
  have lower:= (Nat.le_div_iff_mul_le (by decide : 0<Shadow.limb 136 15)).mp far
  change 3*2^152≤a.u+a.v at lower
