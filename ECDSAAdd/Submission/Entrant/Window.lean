  refine ⟨(flagAt 1698 1557 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by decide)).trans before.2.2.1,
    (flagAt 1699 1558 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by decide)).trans before.2.2.2.1,
    (flagAt 1700 1708 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by decide)).trans coords.1,?_,?_,?_⟩
