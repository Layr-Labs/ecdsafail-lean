      simp [po,sn]
      omega
    simp [sg,po,sn,originalParity]

















theorem oddFold_contract (s : Bool) (R Y : Int) (hr : OddDomain R) (hy : OddDomain Y) :
    oddFold (oddSum s R Y)=
