theorem tailFirstBase_readSites_support (j : Nat) (hj : j < 102) :
    wires (tailFirstBase j)⊆FrontierReplay1591.readSites (5*j) := by
  have opening := onPacket_read_support j stageOpen stageOpen_support
  have closing := onPacket_read_support j stageClose stageClose_support
  have transfer (d : Bool) (k : Nat) (hk : k<2) :=
    onPacket_read_support j (stageTransition d k) (stageTransition_support d k hk)
  have cellAt (d : Bool) (active : Nat) (ha : active<5) :=
    cell_read_support d j active 2 hj ha (by decide)
  have first := cellWith_read_support false _ mstart_support j 4 2 hj (by decide) (by decide)
  have t0 := transfer false 0 (by decide)
  have t1 := transfer false 1 (by decide)
  simp only [stageOpen,stageClose,stageTransition,Bool.false_eq_true,if_true,if_false,
    show ¬(1:Nat)=0 from by decide] at opening closing t0 t1
  simp only [tailFirstBase,wires_append,Finset.union_subset_iff]
  exact ⟨⟨opening,⟨⟨⟨⟨⟨⟨first,t0⟩,
    cellAt false 3 (by decide)⟩,cellAt false 4 (by decide)⟩,t1⟩,
    cellAt false 4 (by decide)⟩,cellAt false 3 (by decide)⟩⟩,closing⟩

theorem tailLastBase_readSites_support (j : Nat) (hj : j < 102) :
    wires (tailLastBase j)⊆FrontierReplay1591.readSites (5*j) := by
  have opening := onPacket_read_support j stageOpen stageOpen_support
  have closing := onPacket_read_support j stageClose stageClose_support
  have transfer (d : Bool) (k : Nat) (hk : k<2) :=
    onPacket_read_support j (stageTransition d k) (stageTransition_support d k hk)
  have cellAt (d : Bool) (active : Nat) (ha : active<5) :=
    cell_read_support d j active 2 hj ha (by decide)
  have last := cellWith_read_support false _ mend_support j 3 2 hj (by decide) (by decide)
  have t0 := transfer false 0 (by decide)
  have t1 := transfer false 1 (by decide)
  simp only [stageOpen,stageClose,stageTransition,Bool.false_eq_true,if_true,if_false,
    show ¬(1:Nat)=0 from by decide] at opening closing t0 t1
  simp only [tailLastBase,wires_append,Finset.union_subset_iff]
  exact ⟨⟨opening,⟨⟨⟨⟨⟨⟨cellAt false 4 (by decide),t0⟩,
    cellAt false 3 (by decide)⟩,cellAt false 4 (by decide)⟩,t1⟩,
    cellAt false 4 (by decide)⟩,last⟩⟩,closing⟩

theorem tailFirstBase_read_support (j : Nat) (hj : j < 102) :
    wires (tailFirstBase j)⊆NewHistory5.groupReadSites base (base 2400)
      (base 2409) (base 2410) (5*j) ∪ {base 2312} :=
  (tailFirstBase_readSites_support j hj).trans (FrontierReplay1591.readSites_sub (5*j))

theorem tailLastBase_read_support (j : Nat) (hj : j < 102) :
    wires (tailLastBase j)⊆NewHistory5.groupReadSites base (base 2400)
      (base 2409) (base 2410) (5*j) ∪ {base 2312} :=
  (tailLastBase_readSites_support j hj).trans (FrontierReplay1591.readSites_sub (5*j))

