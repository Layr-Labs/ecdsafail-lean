  have heqBody := erased_eq L.R 13 u (run (lowBlockOdd L) (m.take 14) u) her
  have hfree : ∀ q ∈ (List.range 13).map L.R, q ∉ wires (cmpBackOdd ++ [.X L.sigma]) := by
    intro q hq hw
