  have hreq : run (window760Odd0 ++ [.X L.sigma]) m s =
      run (cmpFrontOdd ++ lowBlockOdd L ++ cmpBackOdd ++ [.X L.sigma]) m s := by
    have h := (window760Odd0_REq.append (LREq.refl [Instr.X L.sigma])).2 m s
