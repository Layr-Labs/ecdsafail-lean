    have hchk : (mappedWires (ShortBiasedFold.lowBits L760)).all
        (fun q => decide (q ∉ L760.one :: (L760.low ++ L760.carry.take 254))) = true := by decide +kernel
    exact fun q hq => of_decide_eq_true (List.all_eq_true.mp hchk q hq)
