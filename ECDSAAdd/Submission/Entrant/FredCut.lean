theorem leaveInv_counts (k : Fin 26) (hk : k.val ≤ 24) (hL : 1 ≤ Shadow7.lowsP (start k)) :
    toffoliCount (P.leaveInv k) = toffoliCount (Pcut.leaveInv k) + 2 ∧
