 have shape : bodyWith cm=FullBTemp.prefixP L++(loopWith cm++FullBTemp.suffixP L c) := by
  simp only [bodyWith,foldWith,FullBTemp.prefixP,FullBTemp.suffixP,List.append_assoc]
 rw [shape]
 simp only [gatePhysical_append]
