  simp only [suffix,wires_append,Finset.mem_union,not_or]
  exact ⟨⟨slice 5376 1596,fOff⟩,fun h=>off (drop_subset _ 6982 h)⟩
 simp only [program,wires_append,Finset.mem_union,not_or]
