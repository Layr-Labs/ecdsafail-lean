    sqHost ext∉wires (renameProgram (SquareCarryLoan719.foldPerm L ext)
      (FullASelectedDevelop.hostedAD L (LowZero18Square.foldPerm L ext) control d)) := by
  have nd := (List.nodup_cons.mp hn).2
