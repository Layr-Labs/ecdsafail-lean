 rw [←commute_erase D q dq,erase_cleanup,commute_erase D q dq]

theorem retime(B C D:Program)(q z:Wire)(ne:q≠z)
 (bq:q∉wires B)(bz:z∉wires B)(cq:q∉wires C)(dq:q∉wires D)
 (s:State)(m:List Bool)(hz:s.basis z=false):
