theorem square761_free (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.core.poolWire 760∉wires (program761 L) := by
  have controlND : (L.core.generic::L.dialogStreamedSquareWide.wires).Nodup := by
