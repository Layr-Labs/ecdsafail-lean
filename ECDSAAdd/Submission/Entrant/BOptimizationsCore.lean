    exact pool_fix761 L hw hn k a b kb ha hb (fun e => na (e ▸ hk)) (fun e => nb (e ▸ hk))
  simp only [SquareCarryLoan719BF.place]
  apply rename_ins_set _ _ _ _ _ (f 718 907 (by omega) (by omega) (by decide) (by decide))
