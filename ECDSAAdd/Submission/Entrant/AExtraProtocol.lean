#print axioms actual_ready

theorem tail_compiled : (compileManyChunked? suffix ParkAData.p33).isSome=true :=
 ParkAChain.isSome _ _ _ AWideSteps.chain
#print axioms tail_compiled

private theorem transport (qs : List Wire) (p q : Program) (e:p=q)
 (h:(compileManyChunked? qs p).isSome=true) : (compileManyChunked? qs q).isSome=true := e ▸ h

theorem actual_compiled : (compileManyChunked? (loans L) (aMiddle L c)).isSome=true := by
 have h:=ParkAChain.extend_isSome ParkAStagedProof.chain tail_compiled
 rw [hosts_split]
 exact transport _ _ _ ParkAStagedProof.input_eq h
#print axioms actual_compiled
