section
set_option Elab.async false
set_option maxHeartbeats 6000000
namespace ECDSAAdd.Entrant.AWideTemp
open Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout ThirdSavedCarryDevelop InverseCarryDevelop ControlLoan1589BFFold ZeroReadDevelop
theorem gain_of_success (L:CuccaroStreamedSquareWideLayout) (hw:L.Widths) (g:Wire)
 (ready:BankReady L g (loans L)) (success:(compileManyChunked? (loans L) (aMiddle L g)).isSome=true):
 toffoliCount (aFoldSelected L g)+62≤toffoliCount (aFoldTriple L g):=by
 unfold aFoldSelected
 dsimp only
 rw[dif_pos ready]
 cases he:compileManyChunked? (loans L) (aMiddle L g) with
 | none=>simp[he]at success
 | some cm=>exact (aFoldMany_resources 62 L hw g (loans L) cm.out (by decide) ready.1 cm.proof).1

theorem actual_fold_gain:
 toffoliCount (aFoldSelected Baselines.layout.dialogStreamedSquareWide Baselines.layout.core.generic)+62≤
 toffoliCount (aFoldTriple Baselines.layout.dialogStreamedSquareWide Baselines.layout.core.generic):=
 gain_of_success _ (ControlledPointLayout.dialogStreamedSquareWide_widths Baselines.layout Baselines.layout_widths) _ AWideStaged.actual_ready AWideStaged.actual_compiled

theorem body_gain (L:CuccaroStreamedSquareWideLayout) (g:Wire)
 (h:toffoliCount (aFoldSelected L g)+62≤toffoliCount (aFoldTriple L g)):
 toffoliCount (aBodySelected L g)+62≤toffoliCount (aBodyTriple L g):=by
 simp only[aBodySelected,aBodyTriple,toffoliCount_append]
 omega

theorem eU_off_aBodySelected (L:CuccaroStreamedSquareWideLayout) (hw:L.Widths) (hn:L.wires.Nodup)
 (c:Wire) (hc:c∉L.wires):eU L∉wires (aBodySelected L c):=by
 intro h
 rcases Finset.mem_insert.mp (aBodySelected_refined L hw c h) with e|h
 · exact (ThirdSavedCarryDevelop.spare_ne_eU L hw hn) e.symm
 · exact InverseCarryDevelop.eU_off_aBodyDual L hw hn c hc h

theorem hostedASelected_fold_support (L:CuccaroStreamedSquareWideLayout) (hw:L.Widths)
 (hn:L.wires.Nodup) (ext:List Wire) (c:Wire) (hlen:300≤ext.length) (away:∀q∈ext,q∉L.wires):
 wires (hostedASelected L (LowZero18Square.foldPerm L ext) c)⊆(c::L.wires).toFinset:=by
 rw [hostedASelected_eq L _ c (ParkCarryDevelop.fold_fixes_sumCarry L hw hn ext hlen away)]
 exact aBodySelected_support L hw hn c

#print axioms actual_fold_gain
end ECDSAAdd.Entrant.AWideTemp

