namespace ECDSAAdd.Entrant.IntegerPacket
open Arithmetic Challenge Baselines

theorem tick_slots (p : Shape) (i : Nat) :
    gateSlots (skywalkIntegerTick (ports p i))=17*(p.mid+2)-4 ∧
    gateSlots (skywalkIntegerUntick (ports p i))=19*(p.mid+2)-4 := by
  apply skywalkIntegerTick_gateSlots_exact _ (p.mid+2)
  all_goals simp [ports,SkywalkIntegerLayout.half,SkywalkIntegerLayout.ah,
    SkywalkIntegerLayout.b,SkywalkIntegerLayout.bh]

theorem seq_slots (p : Shape) (i n : Nat) :
    gateSlots (seq p i n)=n*(17*(p.mid+2)-4) ∧
    gateSlots (back p i n)=n*(19*(p.mid+2)-4) := by
  induction n generalizing i with
  | zero => simp [seq,back]
  | succ n ih =>
    have h := tick_slots p i
    have t := ih (i+1)
    simp only [seq,back,gateSlots_append,h.1,h.2,t.1,t.2]
    exact ⟨(Nat.add_comm _ _).trans (Nat.succ_mul _ _).symm,(Nat.succ_mul _ _).symm⟩
end ECDSAAdd.Entrant.IntegerPacket

