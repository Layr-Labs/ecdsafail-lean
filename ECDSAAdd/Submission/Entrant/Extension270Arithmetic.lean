theorem head45_physical (d : Bool) : GatePhysical (head45 d) := by
  have h:=PartialPhysical.forward45plus1_physical d
  rw [oldForwardSplit,gatePhysical_append] at h
  exact h.1

theorem back45_physical (d : Bool) : GatePhysical (back45 d) := by
  have h:=PartialPhysical.reverse45plus1_physical d
  rw [oldReverseSplit,gatePhysical_append] at h
  exact h.2

private theorem codecs260_physical (d : Bool) :
    GatePhysical (renameProgram (OB5.sig 270) (Rolling1588.packAtTick d 260)) ∧
    GatePhysical (renameProgram (OB5.sig 270) (Rolling1588.unpackAtTick d 260)) := by
  cases d <;> constructor <;> apply physicalGateCheck_correct <;> decide +kernel
private theorem codecs275_physical (d : Bool) :
    GatePhysical (renameProgram (OB5.sig 285) (Rolling1588.packAtTick d 275)) ∧
    GatePhysical (renameProgram (OB5.sig 285) (Rolling1588.unpackAtTick d 275)) := by
  cases d <;> constructor <;> apply physicalGateCheck_correct <;> decide +kernel
private theorem bridges_physical (d : Bool) : GatePhysical (Internal270.load d) ∧
    GatePhysical (Internal270.restore d) ∧ GatePhysical (Terminal285.load d) ∧
    GatePhysical (Terminal285.restore d) := by
  cases d <;> repeat' apply And.intro
  all_goals apply physicalGateCheck_correct
  all_goals decide +kernel

theorem block270_physical (d : Bool) : GatePhysical (block270 d) ∧ GatePhysical (unblock270 d) := by
  have a:=PartialPhysical.route ⟨13,by decide⟩ 0 1 (by decide)
  have b:=PartialPhysical.route ⟨13,by decide⟩ 1 14 (by decide)
  have c:=codecs260_physical d
  have e:=bridges_physical d
  simp only [block270,unblock270,gatePhysical_append]
  repeat' apply And.intro
  all_goals first
    | exact enter270_physical
    | exact enterInv270_physical
    | exact leave270_physical
    | exact leaveInv270_physical
    | exact a.1
    | exact a.2
    | exact b.1
    | exact b.2
    | exact c.1
    | exact c.2
    | exact e.1
    | exact e.2.1

theorem terminal285_physical (d : Bool) : GatePhysical (terminal285 d) ∧ GatePhysical (unterminal285 d) := by
  have c:=codecs275_physical d
  have e:=bridges_physical d
  have f:GatePhysical (renameProgram (OB5.sig 285) (TickRanges.tick base 285)) :=
    gatePhysical_rename _ (OB5.sig_injective 285 (by decide)) _
      (TickRanges.tick_physical base 285 (by decide) base_pool_nodup)
  have r:GatePhysical (renameProgram (OB5.sig 285) (W.ReverseCarry.compactReceiverTick base 285)) :=
    gatePhysical_rename _ (OB5.sig_injective 285 (by decide)) _
      (W.ReverseCarry.compactReceiverTick_physical base 285 (by decide) base_pool_nodup)
  simp only [terminal285,unterminal285,gatePhysical_append]
  repeat' apply And.intro
  all_goals first
    | exact park285_physical
    | exact parkInv285_physical
    | exact portal285_physical
    | exact portalInv285_physical
    | exact c.1
    | exact c.2
    | exact e.2.2.1
    | exact e.2.2.2
    | exact f
    | exact r

theorem forward_physical (d : Bool) : GatePhysical (forward60plus1 d) := by
  simp only [forward60plus1,gatePhysical_append]
  exact ⟨⟨head45_physical d,(block270_physical d).1⟩,(terminal285_physical d).1⟩

theorem backward_physical (d : Bool) : GatePhysical (reverse60plus1 d) := by
  simp only [reverse60plus1,gatePhysical_append]
  exact ⟨⟨(terminal285_physical d).2,(block270_physical d).2⟩,back45_physical d⟩
end ECDSAAdd.Entrant.StairPacket.Extension270
