import ECDSAAdd.Submission.Entrant.Window
import ECDSAAdd.Baselines.SlotSignedInteger

namespace ECDSAAdd.Baselines
open Arithmetic Challenge

/-- Exact slots for a nonempty, full-width in-place addition. -/
theorem addInPlace_gateSlots_exact (x y cs : List Wire) (c : Wire)
    (nonempty : 0 < x.length) (same : x.length = y.length)
    (carry : cs.length + 1 = x.length) :
    gateSlots (addInPlace x y cs c) = 12*x.length-10 := by
  induction x, y, cs, c using addInPlace.induct with
  | case1 a a' xs b b' ys d ds c ih =>
    have sub : gateSlots (addInPlace (a'::xs) (b'::ys) ds d) =
        12*(a'::xs).length-10 :=
      ih (by simp) (by simpa using same) (by simpa using carry)
    simp only [addInPlace,gateSlots_append,majority_gateSlots,eraseCarry_gateSlots,
      gateSlots_cons,gateSlots_nil,instructionSlots,List.length_cons] at sub ⊢
    omega
  | case2 a b cs c => simp [addInPlace,gateSlots_cons,instructionSlots]
  | case3 x y cs c missing =>
    cases x with
    | nil => simp at nonempty
    | cons a xs =>
      cases y with
      | nil => simp at same
      | cons b ys =>
        cases xs with
        | nil => simp_all
        | cons a' xs =>
          cases ys with
          | nil => simp at same
          | cons b' ys =>
            cases cs with
            | nil => simp at carry
            | cons d ds => exact False.elim (by apply missing a a' xs b b' ys d ds <;> rfl)

end ECDSAAdd.Baselines

namespace ECDSAAdd.Baselines
open Arithmetic Challenge

theorem signedWord_gateSlots_exact (q : Wire) (xs ys cs : List Wire)
    (nonempty : 0<xs.length) (same : xs.length=ys.length)
    (carry : cs.length+1=xs.length) :
    gateSlots (signedAdd q xs ys cs)=14*xs.length-10 ∧
    gateSlots (signedSub q xs ys cs)=16*xs.length-10 := by
  have h := addInPlace_gateSlots_exact xs ys cs q nonempty same carry
  simp only [signedAdd,signedSub,gateSlots_append,signComplement_gateSlots,notRegister_gateSlots]
  omega

theorem signedRecord_gateSlots_exact (sx sy q : Wire) (xs ys cs : List Wire)
    (nonempty : 0<xs.length) (same : xs.length=ys.length)
    (carry : cs.length+1=xs.length) :
    gateSlots (signedRecord sx sy q xs ys cs)=14*xs.length-4 ∧
    gateSlots (signedUnrecord sx sy q xs ys cs)=16*xs.length-4 := by
  have h := signedWord_gateSlots_exact q xs ys cs nonempty same carry
  simp only [signedRecord,signedUnrecord,skywalkSignToggle,gateSlots_append,
    gateSlots_cons,gateSlots_nil,instructionSlots]
  omega

theorem skywalkIntegerTick_gateSlots_exact (L : SkywalkIntegerLayout) (n : Nat)
    (positive : 0<n) (half : L.half.length=n) (target : L.b.length=n)
    (left : L.ah.length+1=n) (right : L.bh.length+1=n)
    (carry : L.carry.length+1=n) :
    gateSlots (skywalkIntegerTick L)=17*n-4 ∧
    gateSlots (skywalkIntegerUntick L)=19*n-4 := by
  have h := signedRecord_gateSlots_exact L.ext L.bSign L.history L.half L.b L.carry
    (by omega) (by omega) (by omega)
  have high : L.ah.length=L.bh.length := by omega
  rw [half] at h
  simp only [skywalkIntegerTick,skywalkIntegerUntick,skywalkRoute,skywalkSignedHalf,
    gateSlots_append,swapRegisters_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,
    high,Nat.min_self]
  omega
end ECDSAAdd.Baselines

namespace ECDSAAdd.Entrant.StairPacket.Extension270.StockTailCosts
open Arithmetic MappedCompressed Challenge
set_option maxRecDepth 12000
set_option maxHeartbeats 2000000
attribute [local irreducible] toffoliCount measurementCount

def widthT (i : Nat) := (W.compactSkywalkTickPreWidth i-1)+(W.compactSkywalkTickPostWidth i-1)
def widthM (i : Nat) := W.compactSkywalkTickPostWidth i-1

theorem tick (i : Nat) (hi : i<511) :
    toffoliCount (TickRanges.tick base i)=widthT i-TickRanges.due i-W.repairDue i-W.fwdDue i ∧
    measurementCount (TickRanges.tick base i)=widthM i+W.repairDue i ∧
    toffoliCount (W.ReverseCarry.compactReceiverTick base i)=widthT i-1-(if W.trimTick i then 1 else 0) ∧
    measurementCount (W.ReverseCarry.compactReceiverTick base i)=widthM i := by
  have a:=TickRanges.tick_counts base i (by omega) base_pool_nodup
  have b:=W.repairedTick_counts base i (by omega) base_pool_nodup
  have c:=W.compactSkywalkTick_counts base i (by omega) base_pool_nodup
  have e:=W.ReverseCarry.compactReceiverTick_counts base i hi base_pool_nodup
  have f:=W.compactSkywalkReverseTick_counts base i (by omega) base_pool_nodup
  unfold widthT widthM
  exact ⟨by omega,by omega,by omega,by omega⟩

private theorem code (d : Bool) :
    toffoliCount (Rolling1588.codeEncode d)=9 ∧ measurementCount (Rolling1588.codeEncode d)=4 ∧
    toffoliCount (Rolling1588.codeDecode d)=11 ∧ measurementCount (Rolling1588.codeDecode d)=2 := by
  cases d <;> decide +kernel

theorem pack (d : Bool) (i : Nat) (lo : 6 ≤ i) :
    toffoliCount (Rolling1588.Integer.packFirst base d i)=(if History5.packDue i then 9 else 0) ∧
    measurementCount (Rolling1588.Integer.packFirst base d i)=(if History5.packDue i then 4 else 0) ∧
    toffoliCount (Rolling1588.unpackAtTick d i)=(if History5.packDue i then 11 else 0) ∧
    measurementCount (Rolling1588.unpackAtTick d i)=(if History5.packDue i then 2 else 0) := by
  have neq : i≠5 := by omega
  have sub : i-5≠0 := by omega
  simp only [Rolling1588.Integer.packFirst,Rolling1588.Integer.packAfter,Rolling1588.Integer.encode,
    Rolling1588.encodeAt,Rolling1588.codeEncodeAt,Rolling1588.unpackAtTick,if_neg neq,if_neg sub]
  cases History5.packDue i <;> simp only [Bool.false_eq_true,if_false,if_true,
    (renameProgram_counts _ _).1,(renameProgram_counts _ _).2]
  · simp [toffoliCount,measurementCount]
  · exact code d

def sum (f : Nat→Nat) (i : Nat) : Nat→Nat
  | 0 => 0
  | n+1 => f i+sum f (i+1) n

def forwardT (i : Nat) := widthT i-TickRanges.due i-W.repairDue i-W.fwdDue i+
  (if History5.packDue i then 9 else 0)
def forwardM (i : Nat) := widthM i+W.repairDue i+(if History5.packDue i then 4 else 0)
def reverseT (i : Nat) := widthT i-1-(if W.trimTick i then 1 else 0)+(if History5.packDue i then 11 else 0)
def reverseM (i : Nat) := widthM i+(if History5.packDue i then 2 else 0)

theorem forward (d : Bool) (i n : Nat) (lo : 6 ≤ i) (hi : i+n ≤ 511) :
    toffoliCount (Rolling1588TickGap.forward d i n)=sum forwardT i n ∧
    measurementCount (Rolling1588TickGap.forward d i n)=sum forwardM i n := by
  induction n generalizing i with
  | zero => simp [Rolling1588TickGap.forward,sum,toffoliCount,measurementCount]
  | succ n ih =>
    have t:=tick i (by omega)
    have p:=pack d i lo
    have tail:=ih (i+1) (by omega) (by omega)
    simp only [Rolling1588TickGap.forward,toffoliCount_append,measurementCount_append,
      (renameProgram_counts _ _).1,(renameProgram_counts _ _).2,sum,forwardT,forwardM]
    exact ⟨by omega,by omega⟩

theorem reverse (d : Bool) (i n : Nat) (lo : 6 ≤ i) (hi : i+n ≤ 511) :
    toffoliCount (Rolling1588.reverse d i n)=sum reverseT i n ∧
    measurementCount (Rolling1588.reverse d i n)=sum reverseM i n := by
  induction n generalizing i with
  | zero => simp [Rolling1588.reverse,sum,toffoliCount,measurementCount]
  | succ n ih =>
    have t:=tick i (by omega)
    have p:=pack d i lo
    have tail:=ih (i+1) (by omega) (by omega)
    simp only [Rolling1588.reverse,toffoliCount_append,measurementCount_append,
      (renameProgram_counts _ _).1,(renameProgram_counts _ _).2,sum,reverseT,reverseM]
    exact ⟨by omega,by omega⟩

theorem sums271 : sum forwardT 271 15=7002 ∧ sum forwardM 271 15=3522 ∧
    sum reverseT 271 15=7008 ∧ sum reverseM 271 15=3501 := by decide +kernel

theorem counts271 (d : Bool) :
    toffoliCount (Rolling1588TickGap.forward d 271 15)=7002 ∧
    measurementCount (Rolling1588TickGap.forward d 271 15)=3522 ∧
    toffoliCount (Rolling1588.reverse d 271 15)=7008 ∧
    measurementCount (Rolling1588.reverse d 271 15)=3501 := by
  have f:=forward d 271 15 (by decide) (by decide)
  have r:=reverse d 271 15 (by decide) (by decide)
  rw [sums271.1,sums271.2.1] at f
  rw [sums271.2.2.1,sums271.2.2.2] at r
  exact ⟨f.1,f.2,r⟩
end ECDSAAdd.Entrant.StairPacket.Extension270.StockTailCosts

