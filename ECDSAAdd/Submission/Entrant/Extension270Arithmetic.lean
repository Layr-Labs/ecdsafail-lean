open Arithmetic Challenge Baselines

theorem routed_slots (j : Fin 23) (i n : Nat) (bound : i+n≤15) :
    gateSlots (routed j i n)=n*(17*((shape j).mid+2)-4) ∧
    gateSlots (unrouted j i n)=n*(19*((shape j).mid+2)-4) := by
  have h := fixed_route j i n bound
  rw [h.1,h.2,rename_gateSlots,rename_gateSlots]
  exact IntegerPacket.seq_slots (shape j) i n

theorem routed13_slots (i n : Nat) (bound : i+n≤15) :
    gateSlots (routed ⟨13,by decide⟩ i n)=2376*n ∧
    gateSlots (unrouted ⟨13,by decide⟩ i n)=2656*n := by
  have h := routed_slots ⟨13,by decide⟩ i n bound
  change gateSlots (routed ⟨13,by decide⟩ i n)=n*2376 ∧
    gateSlots (unrouted ⟨13,by decide⟩ i n)=n*2656 at h
  simpa only [Nat.mul_comm] using h
end ECDSAAdd.Entrant.StairPacket.Extension270

