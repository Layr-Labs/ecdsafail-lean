private theorem mask_union_mem (A B C : List Nat)
    (h : A.all (fun q => (StairSquareBChecks.LT48B.maskL B).testBit q || (StairSquareBChecks.LT48B.maskL C).testBit q) = true) :
    ∀ q ∈ A, q ∈ B ∨ q ∈ C := by
