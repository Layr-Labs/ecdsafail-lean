  have hSL : Q.S.length = 34 := w.hS; have hTL : Q.T.length = 68 := w.hT
  have r32 := rawMake_rawClear_counts Q.lo Q.dlo Q.pad Q.carry Q.cin (by omega) (by omega) w.hpad (by omega)
