    rw [balancedSharedPorts_r, balancedSharedPorts_y] at hm
    simp only [List.mem_toFinset, List.mem_cons, List.mem_append, wireBlock, List.mem_map,
      List.mem_range'_1] at hm
    rcases hm with rfl | ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
