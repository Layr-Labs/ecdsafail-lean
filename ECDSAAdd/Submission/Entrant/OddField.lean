    have hrem : (a ^ 2 + 2 ^ 32 * a + 2 ^ 64 * b64) % 2 ^ 65 = (rawValue 32 a + W + 1) % 2 ^ 65 := by
      have hmod2 : ((rawValue 32 a + W + 1) % 2 ^ 65 + 2 ^ 64 * b64 + 2 ^ 64 * b64) % 2 ^ 65 =
