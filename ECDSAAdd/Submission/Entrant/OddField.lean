      · simp only [GatePhysical, PhysicalInstr, ProperGate, List.mem_cons, List.not_mem_nil, or_false]
        intro g hg; rcases hg with rfl | rfl | rfl | rfl | rfl | rfl
        · trivial
        · trivial
        · exact ⟨hd2.2.1, hd2.2.2.1⟩
        · trivial
