section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic MappedCompressed BalancedField BalancedCircuit
open MeasuredCodec5 (sim run_sim bitsOf)
open CodecBitSliceVerify (packBits pack_testBit)

private def stock (u v : Bool) : Program :=
  mappedAdd [⟨none,u⟩, ⟨none,v⟩] [0,1] [3] 2

def top (u v : Bool) (a b cin : Wire) : Program :=
  mappedMajority ⟨none,u⟩ a cin b ++
    (if v then [.X b] else []) ++ mappedSum ⟨none,u⟩ a cin

private theorem table : ∀ (u v : Bool) (x : Fin 8) (m ph : Bool),
    sim (stock u v) [m] ph x.val = sim (top u v 0 1 2) [m] ph x.val := by
  decide +kernel

private theorem oneBit (p : Program) (h : measurementCount p ≤ 1) (m : List Bool) (s : State) :
    run p m s = run p [m.headD false] s := by
  cases m with
  | nil => exact (run_replicate_false p 1 s).symm
  | cons b t =>
    change run p (b::t) s = run p [b] s
    rw [← run_take p (b::t) s, ← run_take p [b] s]
    interval_cases z : measurementCount p <;> rfl

private theorem pack_lt (xs : List Bool) : packBits xs < 2^xs.length := by
  induction xs with
  | nil => decide
  | cons b bs ih =>
    cases b with
    | false => change 2 * packBits bs < 2 ^ (bs.length + 1); rw [Nat.pow_succ]; omega
    | true => change 2 * packBits bs + 1 < 2 ^ (bs.length + 1); rw [Nat.pow_succ]; omega

theorem top_correct (u v : Bool) (f : Wire → Wire)
    (hf : ∀ a ∈ Finset.range 4, ∀ b ∈ Finset.range 4, f a = f b → a = b)
    (m : List Bool) (s : State) (zero : s.basis (f 3) = false) :
    run (renameProgram f (stock u v)) m s = run (renameProgram f (top u v 0 1 2)) m s := by
  let bs := (List.range 3).map (fun i => s.basis (f i))
  have len : bs.length = 3 := by simp [bs]
  have valueBound := pack_lt bs
  rw [len] at valueBound
  let x : Fin 8 := ⟨packBits bs, valueBound⟩
  apply run_rename_eq_of_eq f (Finset.range 4) hf _ _
    (by cases u <;> cases v <;> decide) (by cases u <;> cases v <;> decide)
    m m ⟨s.phase,bitsOf x.val⟩ s rfl
  · intro i hi
    have bound : i < 4 := Finset.mem_range.mp hi
    change (packBits bs).testBit i = s.basis (f i)
    rw [pack_testBit]
    by_cases small : i < 3
    · simp [bs,small]
    · have eq : i = 3 := Nat.le_antisymm (Nat.le_of_lt_succ bound) (Nat.le_of_not_gt small)
      subst i
      simp [List.getElem?_eq_none len.le,zero]
  · rw [oneBit (stock u v) (by cases u <;> cases v <;> decide) m,
        oneBit (top u v 0 1 2) (by cases u <;> cases v <;> decide) m,
        run_sim,run_sim,table u v x]

theorem top_counts (u v : Bool) : toffoliCount (top u v 0 1 2) = 1 ∧
    measurementCount (top u v 0 1 2) = 0 ∧ 3 ∉ wires (top u v 0 1 2) := by
  cases u <;> cases v <;> decide

private abbrev L := Q6EndpointCell.ports base (base 2409)

def short (d k : Nat) : Program :=
  let bits := mappedConstant none 252 (k/8)
  let layers := StairLoan.mappedLayers bits (L.low.drop 3) (L.carry.take 251) (L.low.getD 2 0)
  let last := top ((k/8).testBit 250) ((k/8).testBit 251)
    (L.low.getD 253 0) (L.low.getD 254 0) (L.carry.getD 249 0)
  let hosts := if d ≤ 41 then [base 762,base 763,base 764,base 1540,base 768,base 1027]
    else [base 764,base 1540,base 768,base 1027]
  let n := min d 41 - hosts.length
  StairLoan.rebindMany ((StairLoan.retiredRoles.take (min d 41)).drop n) hosts
    (StairLoan.emitLoan n StairLoan.retiredRoles (layers.take 250) last) ++ [.X (L.low.getD 2 0)]

end ECDSAAdd.Entrant.LiteralTop

end

section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic StairLoan

theorem bind_append (rs hs : List Wire) (p q : Program) :
    rebindMany rs hs (p ++ q) = rebindMany rs hs p ++ rebindMany rs hs q := by
  induction rs generalizing hs with
  | nil => rfl
  | cons r rs ih =>
    cases hs with
    | nil => rfl
    | cons h hs => simp only [rebindMany, ih, renameProgram, List.map_append]

def before (d : Nat) (roles : List Wire) (ls : List CarryLayer) : Program :=
  emitUps (ls.take (d+1)) ++ emitErases (ls.take d) ++
    rebindMany (roles.take d) (layerHosts (ls.take d)) (emitUps (ls.drop (d+1)))

def afterTop (d : Nat) (roles : List Wire) (ls : List CarryLayer) : Program :=
  rebindMany (roles.take d) (layerHosts (ls.take d)) (emitDowns (ls.drop (d+1))) ++
    (emitUps (ls.take d) ++ emitDowns (ls.take (d+1)))

theorem splitTop (d : Nat) (roles : List Wire) (ls : List CarryLayer) (high : Program) :
    emitLoan d roles ls high = before d roles ls ++
      (rebindMany (roles.take d) (layerHosts (ls.take d)) high ++ afterTop d roles ls) := by
  simp only [emitLoan,emitSweep,before,afterTop,bind_append,List.append_assoc]

theorem splitLast (d : Nat) (roles : List Wire) (ls : List CarryLayer) (l : CarryLayer)
    (high : Program) (depth : d+1 ≤ ls.length) :
    emitLoan d roles (ls ++ [l]) high = before d roles ls ++
      (rebindMany (roles.take d) (layerHosts (ls.take d)) (l.up ++ high ++ l.down) ++ afterTop d roles ls) := by
  have hd : d ≤ ls.length := by omega
  simp only [emitLoan,emitSweep,before,afterTop,List.take_append_of_le_length depth,
    List.take_append_of_le_length hd,List.drop_append_of_le_length depth,emitUps_append,emitDowns_append,
    emitUps, emitDowns, List.append_nil, List.nil_append, bind_append, List.append_assoc]

abbrev oldTile (u v : Bool) : Program := mappedAdd [⟨none,u⟩,⟨none,v⟩] [0,1] [3] 2

theorem tilePad (u v : Bool) (f : Wire → Wire)
    (hf : ∀ a ∈ Finset.range 4, ∀ b ∈ Finset.range 4, f a = f b → a = b)
    (s : State) (zero : s.basis (f 3) = false) :
    FlagEntry.Pad (renameProgram f (top u v 0 1 2)) (renameProgram f (oldTile u v))
      s s (fun d => false :: d) := by
  have hn : measurementCount (renameProgram f (top u v 0 1 2)) = 0 :=
    (renameProgram_counts _ _).2.trans (top_counts u v).2.1
  have ho : measurementCount (renameProgram f (oldTile u v)) = 1 :=
    (renameProgram_counts _ _).2.trans (by cases u <;> cases v <;> decide)
  constructor
  · intro tape
    exact (FifthCarry.no_records _ hn s tape (false::tape)).trans
      (top_correct u v f hf (false::tape) s zero).symm
  · intro tape
    rw [hn,ho]
    rfl

theorem replaceLast (d : Nat) (roles : List Wire) (ls : List CarryLayer) (l : CarryLayer)
    (high compact : Program) (depth : d+1 ≤ ls.length) (u v : Bool) (f : Wire → Wire)
    (hf : ∀ a ∈ Finset.range 4, ∀ b ∈ Finset.range 4, f a = f b → a = b)
    (orig : rebindMany (roles.take d) (layerHosts (ls.take d)) (l.up ++ high ++ l.down) =
      renameProgram f (oldTile u v))
    (new : rebindMany (roles.take d) (layerHosts (ls.take d)) compact = renameProgram f (top u v 0 1 2))
    (fresh : f 3 ∉ wires (before d roles ls)) (s : State) (zero : s.basis (f 3) = false)
    (tape : List Bool) :
    ∃ tape', run (emitLoan d roles ls compact) tape s = run (emitLoan d roles (ls ++ [l]) high) tape' s := by
  rw [splitLast d roles ls l high depth,splitTop d roles ls compact,orig,new]
  let a := before d roles ls
  let tail := afterTop d roles ls
  have pad := FlagEntry.Pad.prefix a a
    (renameProgram f (top u v 0 1 2) ++ tail) (renameProgram f (oldTile u v) ++ tail)
    s s (fun b => false::b) rfl (fun b =>
      (tilePad u v f hf (run a b s) ((run_preserves_outside a b s (f 3) fresh).trans zero)).append tail)
  exact ⟨_,pad.run_eq tape⟩

end ECDSAAdd.Entrant.LiteralTop

end

section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic MappedCompressed BalancedCircuit BalancedField StairLoan

def constant (dir : Bool) := if dir then h.toNat else encodeWord 255 (-h)
def input (dir : Bool) := mappedConstant none 252 (constant dir / 8)
private abbrev yy := L.low.drop 3
private abbrev cs := L.carry.take 251
private abbrev cin := L.low.getD 2 0
def levels (dir : Bool) := mappedLayers (input dir) yy cs cin
def lower (dir : Bool) := (levels dir).take 250
private abbrev a := base 2309
private abbrev b := base 2310
private abbrev c := base 761
private abbrev z := base 762
def lastLevel (dir : Bool) : CarryLayer :=
  ⟨z, mappedMajority ⟨none,dir⟩ a c z, mappedEraseCarry ⟨none,dir⟩ a c z, mappedSum ⟨none,dir⟩ a c⟩
def high (dir : Bool) := mappedSum ⟨none,!dir⟩ b z
def smallTop (dir : Bool) := top dir (!dir) a b c

set_option maxRecDepth 16000
set_option maxHeartbeats 3000000

private theorem levelShape (dir : Bool) : levels dir = lower dir ++ [lastLevel dir] := by
  have e : (levels dir).drop 250 = [lastLevel dir] := by cases dir <;> rfl
  rw [← e]
  exact (List.take_append_drop 250 _).symm

private theorem highShape (dir : Bool) : mappedTop (input dir) yy cs cin = high dir := by
  cases dir <;> rfl

private theorem lowerSize (dir : Bool) : (lower dir).length = 250 := by
  have len := mappedLayers_length (input dir) yy cs cin
    (by cases dir <;> rfl) (by decide)
  change (levels dir).length = 251 at len
  simp [lower,len]

private def wire : Wire → Wire
  | 0 => a
  | 1 => b
  | 2 => c
  | _ => z

private theorem wire_inj : ∀ i ∈ Finset.range 4, ∀ j ∈ Finset.range 4, wire i = wire j → i=j := by
  decide

private theorem tiles (dir : Bool) :
    (lastLevel dir).up ++ high dir ++ (lastLevel dir).down = renameProgram wire (oldTile dir (!dir)) ∧
    smallTop dir = renameProgram wire (top dir (!dir) 0 1 2) := by cases dir <;> decide

private theorem fixHost (q : Wire) (rs hs : List Wire) (hr : q ∉ rs) (hh : q ∉ hs) :
    StairArchiveInactive.rebinder rs hs q = q := by
  induction rs generalizing hs with
  | nil => rfl
  | cons r rs ih =>
    cases hs with
    | nil => rfl
    | cons h hs =>
      simp only [List.mem_cons,not_or] at hr hh
      change Equiv.swap r h (StairArchiveInactive.rebinder rs hs q) = q
      rw [ih hs hr.2 hh.2,Equiv.swap_apply_of_ne_of_ne hr.1 hh.1]

private theorem lowerClear (dir : Bool) :
    z ∉ wires (emitUps (lower dir)) ∧ z ∉ wires (emitErases (lower dir)) := by
  have both : C163Touch.touched (emitUps (lower dir) ++ emitErases (lower dir)) z = false := by
    cases dir <;> decide +kernel
  have away := HighConsumedStreamResearch.untouched _ _ both
  simpa only [wires_append,Finset.mem_union,not_or] using away

private theorem erase_append (x y : List CarryLayer) :
    emitErases (x ++ y) = emitErases y ++ emitErases x := by
  induction x with
  | nil => simp [emitErases]
  | cons _ xs ih => simp only [List.cons_append,emitErases,ih,List.append_assoc]

private theorem parts_clear (q : Wire) (xs : List CarryLayer) (n : Nat)
    (hu : q ∉ wires (emitUps xs)) (he : q ∉ wires (emitErases xs)) :
    (q ∉ wires (emitUps (xs.take (n+1))) ∧ q ∉ wires (emitUps (xs.drop (n+1)))) ∧
      q ∉ wires (emitErases (xs.take n)) := by
  have join := congrArg emitUps (List.take_append_drop (n+1) xs)
  rw [emitUps_append] at join
  rw [←join,wires_append,Finset.mem_union,not_or] at hu
  have erase := congrArg emitErases (List.take_append_drop n xs)
  rw [erase_append] at erase
  rw [←erase,wires_append,Finset.mem_union,not_or] at he
  exact ⟨hu,he.2⟩

def core (n : Nat) (dir : Bool) := emitLoan n retiredRoles (lower dir) (smallTop dir)

theorem core_correct (n : Nat) (bound : n ≤ 37) (dir : Bool) (s : State) (zero : s.basis z = false)
    (m : List Bool) : ∃ m', run (core n dir) m s = run (mappedAddLoan n retiredRoles (input dir) yy cs cin) m' s := by
  let ls := lower dir
  let rs := retiredRoles.take n
  let hs := layerHosts (ls.take n)
  let perm := StairArchiveInactive.rebinder rs hs
  have d : n+1 ≤ ls.length := by rw [show ls.length = 250 from lowerSize dir]; omega
  have rclear : z ∉ rs := fun hit =>
    (by decide : z ∉ retiredRoles.take 37) ((List.take_sublist_take_left bound).subset hit)
  have hostShape : hs = cs.take n := by
    dsimp only [hs,ls,lower]
    rw [List.take_take, Nat.min_eq_left (by omega : n ≤ 250)]
    exact layerHosts_mapped_take n (input dir) yy cs cin
      (by cases dir <;> rfl) (by decide)
  have hclear : z ∉ hs := by
    rw [hostShape]
    exact fun hit => (by decide : z ∉ cs.take 37) ((List.take_sublist_take_left bound).subset hit)
  have unchanged : perm (wire 3) = z := fixHost z rs hs rclear hclear
  have fresh : perm (wire 3) ∉ wires (before n retiredRoles ls) := by
    rw [unchanged]
    have avoid := lowerClear dir
    have ⟨⟨u,v⟩,e⟩ := parts_clear z ls n avoid.1 avoid.2
    simp only [before,wires_append,Finset.mem_union,not_or]
    exact ⟨⟨u,e⟩, rebindMany_preserves_fresh rs hs _ z (by simpa [List.mem_append] using And.intro rclear hclear) v⟩
  have oldPart : rebindMany rs hs ((lastLevel dir).up ++ high dir ++ (lastLevel dir).down) =
      renameProgram (perm ∘ wire) (oldTile dir (!dir)) := by
    rw [StairArchiveInactive.hosts_eq,(tiles dir).1,renameProgram_comp]
  have newPart : rebindMany rs hs (smallTop dir) = renameProgram (perm ∘ wire) (top dir (!dir) 0 1 2) := by
    rw [StairArchiveInactive.hosts_eq,(tiles dir).2,renameProgram_comp]
  have result := replaceLast n retiredRoles ls (lastLevel dir) (high dir) (smallTop dir) d dir (!dir) (perm ∘ wire)
    (fun i hi j hj eq => wire_inj i hi j hj (perm.injective eq)) oldPart newPart fresh s
    ((congrArg s.basis unchanged).trans zero) m
  change ∃ tape', run (core n dir) m s =
    run (emitLoan n retiredRoles (levels dir) (mappedTop (input dir) yy cs cin)) tape' s
  rw [levelShape, highShape]
  exact result

end ECDSAAdd.Entrant.LiteralTop

end

section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic MappedCompressed BalancedCircuit BalancedField StairLoan

set_option maxRecDepth 16000

private abbrev ys := L.low.drop 3
private abbrev carry := L.carry.take 251
private abbrev init := L.low.getD 2 0
private def hosts (d : Nat) : List Wire :=
  if d ≤ 41 then [base 762,base 763,base 764,base 1540,base 768,base 1027]
  else [base 764,base 1540,base 768,base 1027]
private def depth (d : Nat) := min d 41 - (hosts d).length
private def moved (d : Nat) := (retiredRoles.take (min d 41)).drop (depth d)
def referenceAdd (dir : Bool) := literalConstAdd ys carry init L.one (constant dir / 8)

private theorem shape (d : Nat) (dir : Bool) :
    short d (constant dir) = rebindMany (moved d) (hosts d) (core (depth d) dir) ++ [.X init] := by
  cases dir <;> rfl

private theorem depth_le (d : Nat) : depth d ≤ 37 := by
  have h := Nat.min_le_right d 41
  unfold depth hosts
  split <;> simp only [List.length_cons,List.length_nil] <;> omega

private theorem roleTail (n : Nat) (hn : n ≤ 37) :
    ∀ q ∈ retiredRoles.take n, q ∈ carry.drop (n+1) := by
  have bound : (retiredRoles.take 37).all (fun q => (maskOf (carry.drop 38)).testBit q) = true := by decide +kernel
  intro q hq
  have last := mem_of_maskOf (List.all_eq_true.mp bound q ((List.take_sublist_take_left hn).subset hq))
  rw [show 38 = (n+1) + (38-(n+1)) by omega, ←List.drop_drop] at last
  exact List.mem_of_mem_drop last

private theorem nodup : (L.one :: init :: (ys ++ carry)).Nodup := nodup_of_mask _ (by decide +kernel)

private theorem core_literal (n : Nat) (hn : n ≤ 37) (dir : Bool) (s : State) (m r : List Bool)
    (hcar : ∀ q ∈ L.carry, s.basis q = false) (hone : s.basis L.one = false) :
    run (core n dir) m s = run (referenceAdd dir) r s := by
  obtain ⟨m',eq⟩ := core_correct n hn dir s (hcar _ (by decide)) m
  rw [eq]
  have clean : ∀ q ∈ carry, s.basis q = false := fun q hq => hcar q (List.mem_of_mem_take hq)
  have away : ∀ q ∈ mappedWires (input dir), q ∉ init :: (ys ++ carry) := by
    intro q hq
    have impossible := mappedConstant_wires none 252 (constant dir / 8) q hq
    simp at impossible
  have step := mappedAddLoan_run_eq n retiredRoles (input dir) ys carry init s m' r
    (List.nodup_cons.mp nodup).2 away (by cases dir <;> rfl) (by decide)
    (by change n+1 ≤ 251; omega) clean (roleTail n hn)
  exact step.trans (mappedLiteral_run_eq ys carry init L.one (constant dir / 8) s r r nodup
    (by decide) (by cases dir <;> decide +kernel) hone clean)

private theorem ports_safe (d : Nat) (q : Wire) (hq : q ∈ moved d ++ hosts d) :
    (q ∈ L.carry ∨ q = L.parity ∨ q = L.one) ∧ q ∉ ys := by
  let allHosts := [base 762,base 763,base 764,base 1540,base 768,base 1027]
  have safe : (retiredRoles.take 41 ++ allHosts).all (fun x =>
      decide ((x ∈ L.carry ∨ x = L.parity ∨ x = L.one) ∧ x ∉ ys)) = true := by decide +kernel
  apply of_decide_eq_true (List.all_eq_true.mp safe q ?_)
  rcases List.mem_append.mp hq with h | h
  · exact List.mem_append_left _ ((List.take_sublist_take_left (Nat.min_le_right d 41)).subset (List.mem_of_mem_drop h))
  · apply List.mem_append_right
    unfold hosts at h
    split at h
    · exact h
    · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ h)

theorem short_correct (d : Nat) (dir : Bool) (s : State) (m r : List Bool)
    (hcar : ∀ q ∈ L.carry, s.basis q = false) (hone : s.basis L.one = false)
    (hpar : s.basis L.parity = false) :
    run (short d (constant dir)) m s = run (referenceAdd dir ++ [.X init]) r s := by
  have clean (q : Wire) (hq : q ∈ moved d ++ hosts d) : s.basis q = false := by
    rcases (ports_safe d q hq).1 with carryWire | rfl | rfl
    · exact hcar q carryWire
    · exact hpar
    · exact hone
  let p := core (depth d) dir
  have eq (t : List Bool) : run p t s = run (referenceAdd dir) [] s :=
    core_literal _ (depth_le d) dir s t [] hcar hone
  have result := literalConstAdd_correct ys carry init L.one (constant dir / 8) nodup (by decide) s []
    hone (fun q hq => hcar q (List.mem_of_mem_take hq))
  have same (t : List Bool) :
      run (rebindMany (moved d) (hosts d) p) t s = run (referenceAdd dir) (r.take (measurementCount (referenceAdd dir))) s := by
    rw [rebindMany_run _ _ p s t clean (fun q hq => by
      rw [eq]; exact (result.2.1 q (ports_safe d q hq).2).trans (clean q hq))]
    exact core_literal _ (depth_le d) dir s t _ hcar hone
  rw [shape, run_append, run_append, same]
  exact FifthCarry.no_records [.X init] rfl _ _ _

end ECDSAAdd.Entrant.LiteralTop

end

section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic MappedCompressed BalancedCircuit BalancedField StairLoan

set_option maxRecDepth 24000
set_option maxHeartbeats 6000000

private def sources := L.low ++ L.carry.take 250

private theorem oldCover (n : Nat) (hn : n ≤ 37) (dir : Bool) :
    wires (core n dir) ⊆ wires (mappedAddLoan n retiredRoles (input dir) yy carry cin) := by
  have eq : levels dir = lower dir ++ [lastLevel dir] := by
    have tail : (levels dir).drop 250 = [lastLevel dir] := by cases dir <;> rfl
    rw [←tail]
    exact (List.take_append_drop 250 _).symm
  have highEq : mappedTop (input dir) yy carry cin = high dir := by cases dir <;> rfl
  have len : (lower dir).length = 250 := by cases dir <;> rfl
  have tile : wires (smallTop dir) ⊆ wires ((lastLevel dir).up ++ high dir ++ (lastLevel dir).down) := by
    cases dir <;> decide
  change wires (emitLoan n retiredRoles (lower dir) (smallTop dir)) ⊆
    wires (emitLoan n retiredRoles (levels dir) (mappedTop (input dir) yy carry cin))
  rw [eq,highEq,splitLast _ _ _ _ _ (by omega),splitTop]
  simp only [wires_append] at tile
  simp only [wires_append,StairArchiveInactive.hosts_eq,renameProgram_support]
  exact Finset.union_subset_union (by rfl) (Finset.union_subset_union (Finset.image_mono _ tile) (by rfl))

private theorem clearPrefix (n : Nat) (hn : n ≤ 37) (dir : Bool) (q : Wire)
    (used : q ∈ wires (core n dir)) : q ∉ retiredRoles.take n := by
  have nd : (cin :: (yy ++ carry)).Nodup := nodup_of_mask _ (by decide +kernel)
  have big : (retiredRoles.take 37 ++ carry.take 37).Nodup := nodup_of_mask _ (by decide +kernel)
  have banks := big.sublist (List.Sublist.append (List.take_sublist_take_left hn) (List.take_sublist_take_left hn))
  have away : ∀ q ∈ mappedWires (input dir), False := fun q hq => by
    have h := mappedConstant_wires none 252 (constant dir / 8) q hq
    simp at h
  have dis : (retiredRoles.take 37).all (fun x => !(maskOf (yy ++ carry.take 38 ++ [cin])).testBit x) = true := by
    decide +kernel
  have bound := StairLoanSupport.mappedAddLoan_support_lift n retiredRoles (input dir) yy carry cin
    (by cases dir <;> rfl) (by decide) (by change n+1 ≤ 251; omega)
    (by rw [retiredRoles_length]; omega) nd (fun v hit => (away v hit).elim) banks (by
      intro r hr hh
      have off := List.all_eq_true.mp dis r ((List.take_sublist_take_left hn).subset hr)
      have mem : r ∈ yy ++ carry.take 38 ++ [cin] := by
        simp only [List.mem_toFinset,List.mem_append,List.mem_singleton] at hh ⊢
        rcases hh with ((src | dest) | c) | inputWire
        · exact (away r (mappedWires_take_mem (n+1) (input dir) r src)).elim
        · exact Or.inl (Or.inl (List.mem_of_mem_take dest))
        · exact Or.inl (Or.inr ((List.take_sublist_take_left (by omega : n+1 ≤ 38)).subset c))
        · exact Or.inr inputWire
      have bit : (maskOf (yy ++ carry.take 38 ++ [cin])).testBit r = true := by
        rw [testBit_maskOf]
        exact decide_eq_true mem
      change (!(maskOf (yy ++ carry.take 38 ++ [cin])).testBit r) = true at off
      rw [bit] at off
      exact Bool.noConfusion off)
  rcases Finset.mem_union.mp (bound (oldCover n hn dir used)) with h | h
  · exact fun v => (Finset.mem_sdiff.mp h).2 (List.mem_toFinset.mpr v)
  · exact fun v => (List.nodup_append'.mp banks).2.2 v (List.mem_toFinset.mp h)

theorem sourceCover (n : Nat) (hn : n ≤ 37) (dir : Bool) (q : Wire)
    (used : q ∈ wires (core n dir)) : q ∈ sources ∧ q ∉ retiredRoles.take n := by
  have off := clearPrefix n hn dir q used
  have upper (w : Wire) (h : w ∈ wires (emitSweep (lower dir) (smallTop dir))) : w ∈ sources := by
    let usedBits := WireColumns.circuit (emitSweep (lower dir) (smallTop dir))
    have cover : usedBits &&& maskOf sources = usedBits := by cases dir <;> decide +kernel
    have bit := (WireColumns.circuit_bit _ _).mpr h
    have eq := congrArg (fun x : Nat => x.testBit w) cover
    apply mem_of_maskOf
    simpa only [usedBits,Nat.testBit_and,bit,Bool.true_and] using eq
  have hosts : layerHosts ((lower dir).take n) = carry.take n := by
    unfold lower levels
    rw [List.take_take,Nat.min_eq_left (by omega : n ≤ 250)]
    exact layerHosts_mapped_take n (input dir) yy carry cin (by cases dir <;> rfl) (by decide)
  have env := StairLoanSupport.emitLoan_support_envelope n retiredRoles (lower dir) (smallTop dir) used
  rw [hosts] at env
  refine ⟨?_,off⟩
  rcases Finset.mem_union.mp env with h | h
  · rcases Finset.mem_union.mp h with h | h
    · exact upper q h
    · exact (off (List.mem_toFinset.mp h)).elim
  · apply List.mem_append_right
    have v := List.mem_toFinset.mp h
    rw [List.take_take,Nat.min_eq_left (by omega : n ≤ 251)] at v
    exact (List.take_sublist_take_left (by omega : n ≤ 250)).subset v

end ECDSAAdd.Entrant.LiteralTop

end

section
namespace ECDSAAdd.Entrant.LiteralTop.Bank
open Arithmetic MappedCompressed BalancedCircuit BalancedField StairLoan

set_option maxRecDepth 18000

private abbrev L := Q6EndpointCell.ports base (base 2409)
def hosts (d : Nat) : List Wire := if d ≤ 41 then
  [base 762,base 763,base 764,base 1540,base 768,base 1027] else [base 764,base 1540,base 768,base 1027]
def depth (d : Nat) := min d 41 - (hosts d).length
def moved (d : Nat) := (retiredRoles.take (min d 41)).drop (depth d)

private def swapBits (a b mask : Nat) :=
  if mask.testBit a == mask.testBit b then mask else mask ^^^ (2 ^ a ||| 2 ^ b)

private theorem swapBits_at (a b mask q : Nat) :
    (swapBits a b mask).testBit (Equiv.swap a b q) = mask.testBit q := by
  by_cases same : a = b
  · subst b
    simp [swapBits]
  by_cases left : q = a
  · subst q
    cases ha : mask.testBit a <;> cases hb : mask.testBit b <;>
      simp [swapBits,ha,hb,Nat.testBit_xor,Nat.testBit_or,same]
  by_cases right : q = b
  · subst q
    cases ha : mask.testBit a <;> cases hb : mask.testBit b <;>
      simp [swapBits,ha,hb,Nat.testBit_xor,Nat.testBit_or,Ne.symm same]
  rw [Equiv.swap_apply_of_ne_of_ne left right]
  unfold swapBits
  split <;> simp [Nat.testBit_xor,Nat.testBit_or,Ne.symm left,Ne.symm right]

private def swapMask : List Wire → List Wire → Nat → Nat
  | r :: rs,h :: hs,mask => swapBits r h (swapMask rs hs mask)
  | _,_,mask => mask

private theorem swapMask_at (rs hs : List Wire) (mask q : Nat) :
    (swapMask rs hs mask).testBit (StairArchiveInactive.rebinder rs hs q) = mask.testBit q := by
  induction rs generalizing hs with
  | nil => rfl
  | cons r rs ih =>
    cases hs with
    | nil => rfl
    | cons h hs =>
      change (swapBits r h (swapMask rs hs mask)).testBit (Equiv.swap r h (StairArchiveInactive.rebinder rs hs q)) = _
      rw [swapBits_at,ih]

private def without (m r : Nat) := m ^^^ (m &&& r)
private theorem without_at (m r q : Nat) : (without m r).testBit q = (m.testBit q && !r.testBit q) := by
  simp only [without,Nat.testBit_xor,Nat.testBit_and]
  cases m.testBit q <;> cases r.testBit q <;> rfl

private def sourceMask (d : Nat) := without (maskOf (L.low ++ L.carry.take 250)) (maskOf (retiredRoles.take (depth d)))
private def allowedMask (d : Nat) := maskOf (L.low ++ [L.one,L.parity]) |||
  without (maskOf (L.carry.take 254)) (maskOf (retiredRoles.take d))
private def fits (d : Nat) : Bool :=
  let mask := swapMask (moved d) (hosts d) (sourceMask d)
  (mask &&& allowedMask d) == mask
private theorem depths : (List.range 44).all (fun d => (d < 6 || d == 42) || fits d) = true := by
  decide +kernel

theorem outer (d q : Nat) (hd : d ≤ 43) (h6 : 6 ≤ d) (h42 : d ≠ 42)
    (used : q ∈ L.low ++ L.carry.take 250) (off : q ∉ retiredRoles.take (depth d)) :
    let v := StairArchiveInactive.rebinder (moved d) (hosts d) q
    v ∈ L.low ∨ v = L.one ∨ v = L.parity ∨ (v ∈ L.carry.take 254 ∧ v ∉ retiredRoles.take d) := by
  let v := StairArchiveInactive.rebinder (moved d) (hosts d) q
  have ok := List.all_eq_true.mp depths d (List.mem_range.mpr (by omega))
  have f : fits d = true := by simpa [show ¬d<6 by omega,h42] using ok
  let image := swapMask (moved d) (hosts d) (sourceMask d)
  have cover : image &&& allowedMask d = image := beq_iff_eq.mp f
  have bit : image.testBit v = true := by
    change (swapMask _ _ _).testBit (StairArchiveInactive.rebinder _ _ q) = true
    rw [swapMask_at]
    simp only [sourceMask,without_at,testBit_maskOf]
    simp [used,off]
  have e := congrArg (fun a : Nat => a.testBit v) cover
  have h : (allowedMask d).testBit v = true := by simpa only [Nat.testBit_and,bit,Bool.true_and] using e
  simp [allowedMask,Nat.testBit_or,without_at,testBit_maskOf,List.mem_append,or_assoc] at h
  exact h

end ECDSAAdd.Entrant.LiteralTop.Bank

end

section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic Challenge MappedCompressed BalancedCircuit BalancedField StairLoan

set_option maxRecDepth 24000

private abbrev canonical := Q6EndpointCell.ports base (base 2409)
private def rows (L : BalancedCircuit.Layout) (dir : Bool) :=
  (mappedLayers (input dir) (L.low.drop 3) (L.carry.take 251) (L.low.getD 2 0)).take 250
private def last (L : BalancedCircuit.Layout) (dir : Bool) :=
  top dir (!dir) (L.low.getD 253 0) (L.low.getD 254 0) (L.carry.getD 249 0)

def program (d : Nat) (L : BalancedCircuit.Layout) (dir : Bool) :=
  rebindMany (Bank.moved d) (Bank.hosts d)
    (emitLoan (Bank.depth d) retiredRoles (rows L dir) (last L dir)) ++ [.X (L.low.getD 2 0)]

theorem canonical_eq (d : Nat) (dir : Bool) : program d canonical dir = short d (constant dir) := by
  cases dir <;> rfl

theorem depth_value (d : Nat) (hi : d ≤ 43) (h42 : d ≠ 42) : Bank.depth d = d-6 := by
  unfold Bank.depth Bank.hosts
  by_cases low : d ≤ 41
  · simp [low]
  · have eq : d = 43 := by omega
    subst d
    rfl

theorem program_counts (d : Nat) (L : BalancedCircuit.Layout) (hw : L.Widths) (dir : Bool)
    (hi : d ≤ 43) (h42 : d ≠ 42) :
    toffoliCount (program d L dir) = 251+(d-6) ∧ measurementCount (program d L dir) = 250+(d-6) := by
  have hlow := (BalancedCleanup.widths L.toLayout hw).1
  have hs : (L.low.drop 3).length = 252 := by simp [hlow]
  have hc : (L.carry.take 251).length = 251 := by simp [hw.2.2]
  have units : ∀ l ∈ rows L dir, LayerUnit l := fun l hit =>
    mappedLayers_unit (input dir) _ _ _ l (List.mem_of_mem_take hit)
  have len : (rows L dir).length = 250 := by
    have eq := mappedLayers_length (input dir) (L.low.drop 3) (L.carry.take 251) (L.low.getD 2 0)
      (by rw [hs]; exact mappedConstant_length _ _ _) (by rw [hs,hc])
    simp only [rows,List.length_take,eq,hc]
    rfl
  have depth := depth_value d hi h42
  have loan := emitLoan_counts (Bank.depth d) retiredRoles (rows L dir) (last L dir) (by omega) units
  have sweep := emitSweep_counts (rows L dir) (last L dir) units
  have topCost : toffoliCount (last L dir) = 1 ∧ measurementCount (last L dir) = 0 := by
    cases dir <;> exact ⟨rfl,rfl⟩
  simp only [program,toffoliCount_append,measurementCount_append,rebindMany_counts]
  rw [loan.1,loan.2,sweep.1,sweep.2,topCost.1,topCost.2,len,depth]
  change 1+250+(d-6)+0 = 251+(d-6) ∧ 0+250+(d-6)+0 = 250+(d-6)
  omega

private theorem loan_slots (n : Nat) (rs : List Wire) (ls : List CarryLayer) (p : Program) :
    gateSlots (emitLoan n rs ls p) = gateSlots (emitSweep ls p) +
      gateSlots (emitUps (ls.take n)) + gateSlots (emitErases (ls.take n)) := by
  rw [emitSweep_split (n+1) ls p]
  simp only [emitLoan,gateSlots_append,StairSlotsLib.rebindMany_slots]
  omega

private theorem slots_mono (n : Nat) (ls : List CarryLayer) (p : Program) :
    gateSlots (emitLoan n retiredRoles ls p) ≤ gateSlots (emitLoan (n+1) retiredRoles ls p) := by
  rw [loan_slots,loan_slots,List.take_add,emitUps_append,StairLoanSupport.emitErases_append]
  simp only [gateSlots_append]
  omega

theorem core_slots (n : Nat) (hn : n ≤ 37) (dir : Bool) :
    gateSlots (core n dir) ≤ gateSlots (mappedAddLoan (n+1) retiredRoles (input dir)
      (canonical.low.drop 3) (canonical.carry.take 251) (canonical.low.getD 2 0)) := by
  have eq : levels dir = lower dir ++ [lastLevel dir] := by
    have tail : (levels dir).drop 250 = [lastLevel dir] := by cases dir <;> rfl
    rw [←tail]
    exact (List.take_append_drop 250 _).symm
  have hs : mappedTop (input dir) (canonical.low.drop 3) (canonical.carry.take 251)
      (canonical.low.getD 2 0) = high dir := by cases dir <;> rfl
  have len : (lower dir).length = 250 := by cases dir <;> rfl
  have tile : gateSlots (smallTop dir) ≤ gateSlots ((lastLevel dir).up ++ high dir ++ (lastLevel dir).down) := by
    cases dir <;> decide
  change _ ≤ gateSlots (emitLoan (n+1) retiredRoles (levels dir) _)
  rw [hs]
  apply Nat.le_trans _ (slots_mono n (levels dir) (high dir))
  rw [core,eq,splitLast _ _ _ _ _ (by omega),splitTop]
  simp only [gateSlots_append,StairSlotsLib.rebindMany_slots] at tile ⊢
  omega

end ECDSAAdd.Entrant.LiteralTop

end

section
namespace ECDSAAdd.Entrant.LiteralTop
open Arithmetic Challenge MappedCompressed BalancedCircuit BalancedField StairLoan

private abbrev layout := Q6EndpointCell.ports base (base 2409)

theorem support (d : Nat) (lo : 6 ≤ d) (hi : d ≤ 43) (h42 : d ≠ 42) (dir : Bool)
    (q : Wire) (hit : q ∈ wires (program d layout dir)) :
    q ∈ layout.low ∨ q = layout.one ∨ q = layout.parity ∨ (q ∈ layout.carry.take 254 ∧ q ∉ retiredRoles.take d) := by
  change q ∈ wires (rebindMany (Bank.moved d) (Bank.hosts d) (core (Bank.depth d) dir) ++
    [.X (layout.low.getD 2 0)]) at hit
  rw [wires_append,Finset.mem_union] at hit
  rcases hit with h | h
  · rw [StairArchiveInactive.hosts_eq,renameProgram_support,Finset.mem_image] at h
    obtain ⟨v,hv,rfl⟩ := h
    have bound : Bank.depth d ≤ 37 := by rw [depth_value d hi h42]; omega
    have source := sourceCover _ bound dir v hv
    exact Bank.outer d v hi lo h42 source.1 source.2
  · have eq : q = layout.low.getD 2 0 := by simpa [wires,Instr.wires] using h
    subst q
    exact Or.inl (by decide)

theorem moved_support (d : Nat) (lo : 6 ≤ d) (hi : d ≤ 43) (h42 : d ≠ 42) (dir : Bool) :
    wires (Q6LifetimeResearch.move (base 760) layout.rmsb (program d layout dir)) ⊆
    (layout.low.toFinset ∪ {layout.one,layout.parity,layout.rmsb} ∪
      ((layout.carry.take 254).toFinset \ (retiredRoles.take d).toFinset)).erase (base 760) := by
  have out : layout.rmsb ∉ layout.low ∧ layout.rmsb ≠ layout.one ∧ layout.rmsb ≠ layout.parity ∧
      layout.rmsb ∉ layout.carry.take 254 := by decide +kernel
  intro q used
  rw [Q6LifetimeResearch.move,renameProgram_support,Finset.mem_image] at used
  obtain ⟨v,hv,rfl⟩ := used
  have hs := support d lo hi h42 dir v hv
  have ne : v ≠ layout.rmsb := by
    intro e
    subst v
    rcases hs with h | h | h | h
    · exact out.1 h
    · exact out.2.1 h
    · exact out.2.2.1 h
    · exact out.2.2.2 h.1
  by_cases h760 : v = base 760
  · subst v
    rw [Equiv.swap_apply_left]
    exact Finset.mem_erase.mpr ⟨by decide,by simp⟩
  · rw [Equiv.swap_apply_of_ne_of_ne h760 ne]
    apply Finset.mem_erase.mpr
    refine ⟨h760,?_⟩
    simp only [Finset.mem_union,Finset.mem_insert,Finset.mem_singleton,Finset.mem_sdiff,List.mem_toFinset]
    tauto

end ECDSAAdd.Entrant.LiteralTop

end

