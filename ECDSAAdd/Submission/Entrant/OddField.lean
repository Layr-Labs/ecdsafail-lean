    measurementCount (LowZero18Diagonal.makeC Q) = DiagSq.cost Q - 4 - DiagSq.parR Q + (Q.bank.length - Q.h) := by
  have m := LowZero18Diagonal.make_counts Q w he
  have sc := Q.scl1591_counts w
