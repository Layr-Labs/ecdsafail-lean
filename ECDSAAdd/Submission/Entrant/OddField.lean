      · simp only [GatePhysical, PhysicalInstr, ProperGate, List.mem_cons, List.not_mem_nil, or_false]
        intro g hg; rcases hg with rfl | rfl | rfl; exact hd2.2.2.2; exact hd2.1; trivial
      · apply gp_reverse
