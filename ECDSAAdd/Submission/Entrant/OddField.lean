    (heu0 : ControlLoan1589BFFold.eU K0 ∈ parkHosts → s.basis (ControlLoan1589BFFold.eU K0) = false)
    (callback : ∀ t : State, ∀ m : List Bool,
      regValue c.dst t.basis = (if s.basis G0 then regValue c.src s.basis else 0) ^ 2 →
