theorem route_cut_sequence_frame {α : Type} (divide : Bool)
    (P : Nat→Program) (step : Nat→α→α) (F : Nat→α→State→Prop) (N : Nat)
    (packetLaw : ∀j,1≤j → j<N → ∀V,
