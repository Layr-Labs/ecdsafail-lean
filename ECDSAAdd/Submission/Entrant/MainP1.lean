theorem flagTargets_away (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) :
    ∀ q ∈ flagTargets j, q ≠ 1557 ∧ q ≠ 1558 := by
  obtain ⟨w1, w2⟩ := start_win7 j h0 (by omega)
