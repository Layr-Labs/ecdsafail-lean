theorem fold_tail_mode (oddMode sub : Bool) (p l o t : Wire) (nd : [p,l,o,t].Nodup)
    (s : State) (m : List Bool) (top0 : s.basis t=false)
    (product : s.basis o=(s.basis p && s.basis l)) :
