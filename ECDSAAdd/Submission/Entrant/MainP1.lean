theorem topHead_all : ∀ j : Fin 26, 1≤j.val → j.val≤24 → ∀q∈ArchiveJ7.rawHead (prev j)++support j,
    q≠Shadow7.sbP (start j)+1573 ∧ q≠Shadow7.sbP (start j)+803 := by
