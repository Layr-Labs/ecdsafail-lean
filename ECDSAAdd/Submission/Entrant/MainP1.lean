    simp only [Wire] at *
    omega
  · intro q hq hm
    have b:(q:Nat)=Shadow7.sbP (start j)+803:=by simpa only [EnterJ7.parked,List.mem_singleton] using hq
    have tick:start (prev j)+15=start j:=by simp only [prev,start]; omega
