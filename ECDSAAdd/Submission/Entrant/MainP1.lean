    have b:(q:Nat)=Shadow7.sbP (start j)+803:=by simpa only [EnterJ7.parked,List.mem_singleton] using hq
    simp only [EnterJ7.pending,List.mem_cons,List.not_mem_nil,or_false] at hp
    simp only [Wire] at *
