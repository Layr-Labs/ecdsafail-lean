  · intro j; dsimp only
    by_cases hc : j.val ≤ 24
    · rw [if_pos ((inBlocks_iff j).mpr hc)]; exact (leave_metrics j (Nat.zero_le _) hc).2.2.2.2.2.le
    · rw [if_neg (mt (inBlocks_iff j).mp hc), (leave_other j hc).2]
