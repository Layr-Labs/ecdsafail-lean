theorem live_away (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (i : Nat) (hi : i < Shadow7.wpP (start j) + 15) :
    (live j i : Wire) ≠ 1556 ∧ (live j i : Wire) ≠ 1557 ∧ (live j i : Wire) ≠ 1558 := by
