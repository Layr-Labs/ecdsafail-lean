  apply run_preserves_outside
  intro used
  have seen:q∈(support j).toFinset:=by
    cases back
    · exact (codes j h d).1 used
    · exact (codes j h d).2 used
  exact disjoint j _ (List.mem_toFinset.mp seen) hq

