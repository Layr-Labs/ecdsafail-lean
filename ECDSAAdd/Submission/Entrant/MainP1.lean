      carryErase constant a b cin k++carrySum constant a b cin) m s).phase=s.phase ∧ _
  rw [actual]
  refine ⟨high.1,?_,?_⟩
  · have targetKeep : regValue (y++[t,z])
        (writeBit (writeBit v.basis k false) b (sumBit A B C))=regValue (y++[t,z]) v.basis := by
      apply regValue_congr
      intro q hq
