    have ce : cs=[] := List.eq_nil_of_length_eq_zero hc
    subst ys cs
    intro q hq
    simpa [CoherentTail.addPrefix,CoherentTail.program,wires,Instr.wires,or_assoc,or_left_comm,or_comm] using hq
  | cons x xs ih =>
    cases ys with
