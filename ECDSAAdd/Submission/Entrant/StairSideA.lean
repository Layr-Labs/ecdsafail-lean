theorem host_avoid_controls : FrontierEntry1591Field.host ∉ FrontierEntry1591Field.controls := by
  decide +kernel

theorem setup_invol (s : State) :
    run StairSchedule.paritySetup [] (run StairSchedule.paritySetup [] s) = s := by
  simp only [StairSchedule.paritySetup]
  rw [ParityHost5.setup_run _ _ _ _ host_avoid_controls,
    ParityHost5.setup_run _ _ _ _ host_avoid_controls]
  apply State.extensionality
  · rfl
  · funext q
    have keep : FrontierEntry1591Field.controls.map
        (writeBit s.basis FrontierEntry1591Field.host
          (s.basis FrontierEntry1591Field.host ^^
            TraceParity5.parity (FrontierEntry1591Field.controls.map s.basis))) =
        FrontierEntry1591Field.controls.map s.basis := by
      apply List.map_congr_left
      intro a ha
      have ah : a ≠ FrontierEntry1591Field.host := fun e => host_avoid_controls (e ▸ ha)
      simp [writeBit, ah]
    simp only [keep]
    by_cases qh : q = FrontierEntry1591Field.host
    · subst qh
      simp [writeBit]
    · simp [writeBit, qh]

theorem SX_invol (s : State) : run SX [] (run SX [] s) = s := by
  have nm : measurementCount StairSchedule.hostedX = 0 := rfl
  have x2 : ∀ t, run StairSchedule.hostedX [] (run StairSchedule.hostedX [] t) = t := by
