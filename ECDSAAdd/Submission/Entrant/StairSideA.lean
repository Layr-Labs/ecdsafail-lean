  have c2 := counts_chainG (1558 + ·) (b0P s - 1 + ·)
    (⟨rfl, rfl, rfl, rfl⟩ : Counts [.cx (1558+(L+1)) 1556, .x 1556] 0 0 0 2) 0 (L+1)
  have x1 := counts_xsG hi
