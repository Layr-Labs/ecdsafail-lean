/-! ## Generic helpers -/

theorem run6 (A B C D E F : Program) (m : List Bool) (s : State) :
    ∃ m1 m2 m3 m4 m5 m6, run (A ++ B ++ C ++ D ++ E ++ F) m s =
      run F m6 (run E m5 (run D m4 (run C m3 (run B m2 (run A m1 s))))) := by
  rw [run_append, run_append, run_append, run_append, run_append]
  exact ⟨_, _, _, _, _, _, rfl⟩

/-- The state with every shadow label (`≥ base 4000`) cleared. -/
def zeroHigh (u : State) : State :=
  ⟨u.phase, fun q => if base 4000 ≤ q then false else u.basis q⟩

theorem low_reduce (P : Program) (hP : ∀ q ∈ wires P, q < base 4000) (m : List Bool)
    (u : State) :
    ((run P m (zeroHigh u)).phase = u.phase → (run P m u).phase = u.phase) ∧
    (∀ q, q < base 4000 → (run P m u).basis q = (run P m (zeroHigh u)).basis q) ∧
    (∀ q, base 4000 ≤ q → (run P m u).basis q = u.basis q) := by
  have agree : ∀ q ∈ wires P, u.basis q = (zeroHigh u).basis q := by
    intro q hq
    have h := hP q hq
    show u.basis q = (if base 4000 ≤ q then false else u.basis q)
    rw [if_neg (Nat.not_le.mpr h)]
  have inc := run_local_increment P u (zeroHigh u) m agree
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have h1 := inc.1
    rw [h] at h1
    change ((run P m u).phase ^^ u.phase) = (u.phase ^^ u.phase) at h1
    revert h1
    generalize (run P m u).phase = a
    generalize u.phase = b
    cases a <;> cases b <;> simp
  · intro q hq
    by_cases hw : q ∈ wires P
    · exact inc.2 q hw
    · rw [run_preserves_outside _ _ _ q hw, run_preserves_outside _ _ _ q hw]
      show u.basis q = (if base 4000 ≤ q then false else u.basis q)
      rw [if_neg (Nat.not_le.mpr hq)]
  · intro q hq
    exact run_preserves_outside _ _ _ q (fun h => absurd (hP q h) (Nat.not_lt.mpr hq))


theorem nonvirt (B : Nat) (hB : B ∈ budgets) (id : Nat)
    (h : ¬ StairFirstTickV3.Virt (startFor B) id) :
