/-- Removing a nodup list of absent members from an arena lowers its cardinal
bound by the exact list length.  This is the arbitrary-length form of the
record's hand-written `qubits_fifteen` witness chain. -/
theorem card_le_arena_minus_omissions
    (used : Finset Wire) (arena holes : List Wire)
    (sub : used ⊆ arena.toFinset)
    (free : ∀ q ∈ holes, q ∉ used)
    (inside : ∀ q ∈ holes, q ∈ arena)
    (holesNodup : holes.Nodup) :
    used.card ≤ arena.length - holes.length := by
  induction holes generalizing arena with
  | nil =>
      simp only [List.length_nil, Nat.sub_zero]
      exact (Finset.card_le_card sub).trans (List.toFinset_card_le arena)
  | cons q qs ih =>
      have nd := List.nodup_cons.mp holesNodup
      have qfree : q ∉ used := free q (by simp)
      have qinside : q ∈ arena := inside q (by simp)
      have next : used ⊆ (arena.erase q).toFinset := by
        intro r hr
        apply List.mem_toFinset.mpr
        apply (List.mem_erase_of_ne (fun e : r = q => qfree (e ▸ hr))).mpr
        exact List.mem_toFinset.mp (sub hr)
      have restFree : ∀ r ∈ qs, r ∉ used := by
        intro r hr
        exact free r (by simp [hr])
      have restInside : ∀ r ∈ qs, r ∈ arena.erase q := by
        intro r hr
        apply (List.mem_erase_of_ne ?_).mpr
        · exact inside r (by simp [hr])
        · intro e
          exact nd.1 (e ▸ hr)
      have bound := ih (arena := arena.erase q) next restFree restInside nd.2
      rw [List.length_erase_of_mem qinside] at bound
      simp only [List.length_cons]
      omega

/-- Inventory theorem over the current final 1,601-site envelope. -/
theorem qubits_with_omissions (P : Program) (holes : List Wire)
    (sub : ioWires ∪ wires P ⊆ (WrapperOB5.sites Baselines.layout).toFinset)
    (free : ∀ q ∈ holes, q ∉ ioWires ∪ wires P)
    (inside : ∀ q ∈ holes, q ∈ WrapperOB5.sites Baselines.layout)
    (holesNodup : holes.Nodup) :
    qubits P ≤ 1601 - holes.length := by
  have bound := card_le_arena_minus_omissions
    (ioWires ∪ wires P) (WrapperOB5.sites Baselines.layout) holes
    sub free inside holesNodup
  have len := WrapperOB5.sites_length Baselines.layout Baselines.layout_widths
  unfold Challenge.qubits
  rw [len] at bound
  exact bound

