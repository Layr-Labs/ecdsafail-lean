    gateSlots (Partial.reverse45plus1 false) ≤ 1557832 := by
  show gateSlots (reverseW params true first rest) ≤ 1557692 ∧ gateSlots (reverseW params false first rest) ≤ 1557832
  rw [measure_reverse gateSlots gateSlots_append, measure_reverse gateSlots gateSlots_append]
  exact ⟨(reverseL_le slots_le true first rest).trans slot_sums.2.2.1,
