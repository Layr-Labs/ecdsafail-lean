theorem histMaskK_eq : StairLoan.maskOf histL = histMaskK := by decide +kernel
theorem cleanMaskK_eq : StairLoan.maskOf cleanL = cleanMaskK := by decide +kernel

/-- `zrB` with `Nat.ble` / `Nat.beq` only. -/
def zrK (L : Nat) : Bool :=
  (Nat.ble 531 L && Nat.ble L 734) ||
    (Nat.ble 1046 L && Nat.ble L 1553 && (Nat.beq ((L - 1046) % 5) 0 || Nat.beq ((L - 1046) % 5) 2))

theorem zrB_of_zrK {L : Nat} (h : zrK L = true) : zrB L = true := by
  unfold zrK at h
  unfold zrB Placement5.workRegion Placement5.holeRegion
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq] at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq]
  omega

/-- `ZeroClass` as one Boolean test on bit masks. -/
def zcB (L : Nat) : Bool :=
  zrK L || (!(ryMaskK.testBit L) && !(histMaskK.testBit L) &&
    (cleanMaskK.testBit L || Nat.beq L 2425))

theorem zcB_sound {L : Nat} (h : zcB L = true) : ZeroClass L := by
  unfold zcB at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, Bool.not_eq_true', Nat.beq_eq] at h
  rcases h with h | ⟨⟨h1, h2⟩, h3⟩
  · exact Or.inl (zrB_of_zrK h)
  · refine Or.inr ⟨StairLoan.not_mem_of_maskOf (ryMaskK_eq ▸ h1),
      StairLoan.not_mem_of_maskOf (histMaskK_eq ▸ h2), ?_⟩
    rcases h3 with h3 | h3
    · exact Or.inl (StairLoan.mem_of_maskOf (cleanMaskK_eq ▸ h3))
    · exact Or.inr h3

/-- `OB5.sig 511` with `Nat.ble` only. -/
def sigK (q : Nat) : Nat :=
  if (Nat.ble 1301 q && Nat.ble q 1555) || (Nat.ble 1558 q && Nat.ble q 1812) then 3113 - q else q

theorem sigK_eq (q : Nat) : sigK q = OB5.sig 511 q := by
  unfold sigK OB5.sig
  by_cases h : 1301 ≤ q ∧ q ≤ 1044 + 511 ∨ 2069 ≤ q + 511 ∧ q ≤ 1812
  · rw [if_pos h, if_pos]
    simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]; omega
  · rw [if_neg h, if_neg]
    simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]; omega

/-- The per-row check of `RecFacts` as one linear pass over the unfiltered site list. -/
def recCheck (B B' : Nat) : Bool :=
  (StairPhysicalLayout.rowSites B ++ StairPhysicalLayout.rowSites B' ++ StairField2V3Seg.allBC).all
    (fun r => (StairField2V3SegFacts.fpMask B).testBit r ||
      (!(epMaskK.testBit r) && zcB (sigK r)))

theorem recFacts_of (B B' : Nat) (h : recCheck B B' = true) : RecFacts B B' := by
  unfold RecFacts
  rw [StairField2V3SegFacts.forall_scratchT]
  intro r hr hf
  have hc := List.all_eq_true.mp h r hr
  simp only [hf, Bool.false_or, Bool.and_eq_true, Bool.not_eq_true'] at hc
  exact ⟨StairLoan.not_mem_of_maskOf (epMaskK_eq ▸ hc.1), sigK_eq r ▸ zcB_sound hc.2⟩

