        toffoliCount (StairSchedule.placedEndPacket StairConcrete.bestLoans false 68) =
      toffoliCount R2SqEp760.center760 + toffoliCount (R2SqEp760.endPacket760 false) + 176 ∧
    measurementCount StairConcrete.bestLoans.center +
        measurementCount (StairSchedule.placedEndPacket StairConcrete.bestLoans false 68) =
      measurementCount R2SqEp760.center760 +
        measurementCount (R2SqEp760.endPacket760 false) + 176) := by
  have x := StairConcrete.placedEndPacket_counts false 68
  norm_num at x
  obtain ⟨x1, x2⟩ := x
  obtain ⟨q1, q2⟩ := v3_recordEndPacket_counts false 68
  obtain ⟨d1, d2⟩ :=
    renameProgram_counts (OB5.sig 511) CompareDecoder.BoundaryLoan.endPacket760DivLoan
  obtain ⟨l1, l2⟩ := CompareDecoder.BoundaryLoan.endPacket760DivLoan_counts
  obtain ⟨k1, k2⟩ := StairBoundaryLoan.canon760Loan_counts
  obtain ⟨n1, n2⟩ := StairBoundaryLoan.center760Loan_counts
  rw [StairConcrete.bestLoans_divEndpoint, StairConcrete.bestLoans_canon,
    StairConcrete.bestLoans_center]
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> omega

