      (∀ q ∈ CT, q < base 4000) ∧ (∀ q ∈ futurePayload 12, q < base 4000) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> decide +kernel




/-! ## `LastTrip` -/


theorem notΔ (r : Wire) (hr : r ∉ futurePayload 12) :
    StairOuterPlacement.fieldPlace r ∉ StairField2V3Delta.Δv 12 := by
  intro h
  simp only [StairField2V3Delta.Δv, List.mem_toFinset, List.mem_map] at h
  obtain ⟨f, hf, he⟩ := h
  have := StairField2V3Delta.fieldPlace_injective he
  subst this
  exact hr hf


