section Merge_StairPlacedDomain_at_StairSideA

/-!
# Injectivity domain of the record point placement

`wireFn2 L` is injective on every label of the 2,314-label shared point pool
and on the twelve metadata labels (`MappedCompressed.pointIndexSites`), not
only on the record's tighter `OB5Support.logicalSites`.  The staircase codec
and slack-host sites `515..716` lie in this domain.
-/

section

set_option autoImplicit false
set_option maxHeartbeats 2000000

namespace ECDSAAdd.Entrant.StairPlacedDomain

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

def placedDomain : Finset Wire :=
  (MappedCompressed.pointIndexSites.map base).toFinset

private theorem nodup_map_inj' (f : Nat → Wire) (xs : List Nat)
    (nd : (xs.map f).Nodup) (a b : Nat) (ha : a ∈ xs) (hb : b ∈ xs)
    (eq : f a = f b) : a = b := by
  induction xs generalizing a b with
  | nil => simp at ha
  | cons c cs ih =>
    have head := List.nodup_cons.mp nd
    rcases List.mem_cons.mp ha with atHead | inTailA
    · rcases List.mem_cons.mp hb with btHead | inTailB
      · exact atHead.trans btHead.symm
      · have inMap : f b ∈ cs.map f := List.mem_map.mpr ⟨b, inTailB, rfl⟩
        have headEq : f c = f b := (congrArg f atHead).symm.trans eq
        exact (head.1 (headEq.symm ▸ inMap)).elim
    · rcases List.mem_cons.mp hb with btHead | inTailB
      · have inMap : f a ∈ cs.map f := List.mem_map.mpr ⟨a, inTailA, rfl⟩
        have headEq : f a = f c := eq.trans (congrArg f btHead)
        exact (head.1 (headEq ▸ inMap)).elim
      · exact ih head.2 a b inTailA inTailB eq

private theorem swap2_domain (a : Wire) (ha : a ∈ placedDomain) :
    ∃ j, j ∈ MappedCompressed.pointIndexSites ∧ swap2 a = base j := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp ha)
  have m1797 : (1797 : Nat) ∈ MappedCompressed.pointIndexSites :=
    List.mem_append.mpr (Or.inl (List.mem_range'_1.mpr ⟨by norm_num, by norm_num⟩))
  have m769 : (769 : Nat) ∈ MappedCompressed.pointIndexSites :=
    List.mem_append.mpr (Or.inl (List.mem_range'_1.mpr ⟨by norm_num, by norm_num⟩))
  unfold swap2
  split_ifs
  · exact ⟨1797, m1797, rfl⟩
  · exact ⟨769, m769, rfl⟩
  · exact ⟨i, hi, rfl⟩

theorem wireFn2_injOn (L : ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) :
    ∀ a ∈ placedDomain, ∀ b ∈ placedDomain, wireFn2 L a = wireFn2 L b → a = b := by
  have nd := (MappedCompressed.pointIndexSites_perm L hw).nodup_iff.mpr
    (L.skywalkDirectDeclaredSites_nodup hn)
  intro a ha b hb eq
  obtain ⟨i, hi, hai⟩ := swap2_domain a ha
  obtain ⟨j, hj, hbj⟩ := swap2_domain b hb
  have e : MappedCompressed.pointIndexWire L i =
      MappedCompressed.pointIndexWire L j := by
    have h := eq
    simp only [wireFn2, hai, hbj, MappedCompressed.pointWireFn_base] at h
    exact h
  have ij : i = j :=
    nodup_map_inj' (MappedCompressed.pointIndexWire L) _ nd i j hi hj e
  have sw : swap2 a = swap2 b := by rw [hai, hbj, ij]
  calc a = swap2 (swap2 a) := (swap2_involutive a).symm
    _ = swap2 (swap2 b) := by rw [sw]
    _ = b := swap2_involutive b


end ECDSAAdd.Entrant.StairPlacedDomain

end
end Merge_StairPlacedDomain_at_StairSideA

