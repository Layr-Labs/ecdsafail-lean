        Bool.false_eq_true,if_false,toffoliCount_append,measurementCount_append,
        Bool.false_and] at head tail ⊢
      exact ⟨by omega,by omega⟩
    · have indicator : (if j=101 then 257 else 0)+(if j+1≤101 ∧ 101<j+1+n then 257 else 0)=
