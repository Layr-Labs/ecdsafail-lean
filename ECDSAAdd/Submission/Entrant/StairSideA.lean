  wireBlock w 0 258 ++ wireBlock w 770 515 ++ wireBlock w 1540 258 ++ [w 514, w 721, w 722, g]

theorem in_tSites (w : Nat → Wire) (g : Wire) (i : Nat)
    (hi : i < 258 ∨ (770 ≤ i ∧ i < 1285) ∨ (1540 ≤ i ∧ i < 1798) ∨ i = 514 ∨ i = 721 ∨ i = 722) :
    w i ∈ tSites w g := by
  simp only [tSites, List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
  rcases hi with h | h | h | h | h | h
  · exact Or.inl (Or.inl (Or.inl (List.mem_map.mpr ⟨i, by simp only [List.mem_range'_1]; omega, rfl⟩)))
  · exact Or.inl (Or.inl (Or.inr (List.mem_map.mpr ⟨i, by simp only [List.mem_range'_1]; omega, rfl⟩)))
  · exact Or.inl (Or.inr (List.mem_map.mpr ⟨i, by simp only [List.mem_range'_1]; omega, rfl⟩))
  · subst h; exact Or.inr (Or.inl rfl)
  · subst h; exact Or.inr (Or.inr (Or.inl rfl))
  · subst h; exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))

