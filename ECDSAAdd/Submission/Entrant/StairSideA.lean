theorem low_pair (P : Program) (hP : ∀ q ∈ wires P, q < base 4000) (m : List Bool)
    (s t : State) (h : ∀ q, q < base 4000 → s.basis q = t.basis q) :
    ((run P m s).phase ^^ s.phase) = ((run P m t).phase ^^ t.phase) ∧
    (∀ q, q < base 4000 → (run P m s).basis q = (run P m t).basis q) ∧
    (∀ q, base 4000 ≤ q → (run P m s).basis q = s.basis q) := by
  have agree : ∀ q ∈ wires P, s.basis q = t.basis q := fun q hq => h q (hP q hq)
  have inc := run_local_increment P s t m agree
  refine ⟨inc.1, ?_, ?_⟩
  · intro q hq
    by_cases hw : q ∈ wires P
    · exact inc.2 q hw
    · rw [run_preserves_outside _ _ _ q hw, run_preserves_outside _ _ _ q hw]
      exact h q hq
  · intro q hq
    exact run_preserves_outside _ _ _ q (fun hw => absurd (hP q hw) (Nat.not_lt.mpr hq))


