  · exact renamed_footW _ _ 150 _ _ (by cases d <;> first | exact restore0_ports | exact restore1_ports)
      (fun p hp => restorePortsXP_footW _ _ p he hp) q hq
  · exact (allW_programs (moves_footW e (bTopP e + 1) (by omega)).2).1 q hq

