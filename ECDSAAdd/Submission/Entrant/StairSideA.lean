set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 12000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairEndpointLoan44

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField












/-- K6 (replay budget): the two cases as separate lemmas, so that no `if` on `divide` has to be
reduced inside a gate-count equation (that made the kernel evaluate both counts, ≈ 6 s). -/
theorem k6_endHalfLoan44_counts_true :
    toffoliCount (endHalfLoan44 true) = toffoliCount (Rolling1588Lifetime.endHalf true) + 0 ∧
    measurementCount (endHalfLoan44 true) = measurementCount (Rolling1588Lifetime.endHalf true) + 0 := by
  rw [endHalfLoan44, if_pos rfl, Nat.add_zero, Nat.add_zero]
  exact ⟨rfl, rfl⟩

theorem k6_endHalfLoan44_counts_false :
    toffoliCount (endHalfLoan44 false) = toffoliCount (Rolling1588Lifetime.endHalf false) + 132 ∧
    measurementCount (endHalfLoan44 false) =
      measurementCount (Rolling1588Lifetime.endHalf false) + 132 := by
  rw [endHalfLoan44, if_neg Bool.false_ne_true, Rolling1588Lifetime.endHalf, if_neg Bool.false_ne_true]
  exact paddedLoan44_counts _ (Q6EndpointCell.ports_widths base (base 2409)) (base 512)

theorem endHalfLoan44_counts (divide : Bool) :
    toffoliCount (endHalfLoan44 divide)=
        toffoliCount (Rolling1588Lifetime.endHalf divide)+
          (if divide then 0 else 132) ∧
    measurementCount (endHalfLoan44 divide)=
        measurementCount (Rolling1588Lifetime.endHalf divide)+
          (if divide then 0 else 132) := by
  cases divide
  · rw [if_neg Bool.false_ne_true]; exact k6_endHalfLoan44_counts_false
  · rw [if_pos rfl]; exact k6_endHalfLoan44_counts_true

theorem rawEndLoan44_counts (divide : Bool) :
    toffoliCount (rawEndLoan44 divide)=
        toffoliCount (Rolling1588Lifetime.rawEnd divide)+
          (if divide then 0 else 132) ∧
    measurementCount (rawEndLoan44 divide)=
        measurementCount (Rolling1588Lifetime.rawEnd divide)+
          (if divide then 0 else 132) := by
  have fresh := ControlLoan1589.loanWindow_counts (base 510) (base 2409)
    (base 719) (endHalfLoan44 divide)
  have old := ControlLoan1589.loanWindow_counts (base 510) (base 2409)
    (base 719) (Rolling1588Lifetime.endHalf divide)
  have delta := endHalfLoan44_counts divide
  constructor
  · rw [rawEndLoan44,fresh.1,Rolling1588Lifetime.rawEnd,old.1]
    simp only [SW.selW,toffoliCount_append,toffoliCount]
    omega
  · rw [rawEndLoan44,fresh.2,Rolling1588Lifetime.rawEnd,old.2]
    simp only [SW.selW,measurementCount_append,measurementCount]
    omega

theorem endPacketLoan44_counts (divide : Bool) :
    toffoliCount (endPacketLoan44 divide)=
        toffoliCount (Rolling1588Lifetime.endPacket divide)+
          (if divide then 0 else 132) ∧
    measurementCount (endPacketLoan44 divide)=
        measurementCount (Rolling1588Lifetime.endPacket divide)+
          (if divide then 0 else 132) := by
  simpa only [endPacketLoan44,Rolling1588Lifetime.endPacket,
    renameProgram_counts] using rawEndLoan44_counts divide

theorem endPacket760Loan44_counts (divide : Bool) :
    toffoliCount (endPacket760Loan44 divide)=
        toffoliCount (R2SqEp760.endPacket760 divide)+
          (if divide then 0 else 132) ∧
    measurementCount (endPacket760Loan44 divide)=
        measurementCount (R2SqEp760.endPacket760 divide)+
          (if divide then 0 else 132) := by
  simpa only [endPacket760Loan44,R2SqEp760.endPacket760,
    renameProgram_counts] using endPacketLoan44_counts divide


/-! ## Replay -/














/-! ## Physicality -/




theorem endHalfLoan44_physical (divide : Bool) :
    GatePhysical (endHalfLoan44 divide) := by
  have hw : (Q6EndpointCell.ports base (base 2409)).Widths :=
    Q6EndpointCell.ports_widths base (base 2409)
  cases divide
  · exact paddedLoan44_physical _ hw Rolling1588Lifetime.half_ports_nodup (base 512)
  · simpa only [endHalfLoan44, if_true] using
      Rolling1588Lifetime.endHalf_physical true

theorem rawEndLoan44_physical (divide : Bool) :
    GatePhysical (rawEndLoan44 divide) := by
  exact ControlLoan1589.loanWindow_physical (base 510) (base 2409)
    (base 719) (endHalfLoan44 divide) (by decide)
    (endHalfLoan44_physical divide)

theorem endPacketLoan44_physical (divide : Bool) :
    GatePhysical (endPacketLoan44 divide) := by
  exact gatePhysical_rename _ (shifted Placement5.pi0).injective _
    (rawEndLoan44_physical divide)

theorem endPacket760Loan44_physical (divide : Bool) :
    GatePhysical (endPacket760Loan44 divide) := by
  exact gatePhysical_rename _ (Equiv.swap (base 760) (base 717)).injective _
    (endPacketLoan44_physical divide)


/-! ## Certificate-facing statements -/


/-- Exact resources: `+132` CCX and `+132` measurements against the record
multiplication endpoint (three 44-deep loans). -/
theorem endPacket760Loan44_false_counts :
    toffoliCount (endPacket760Loan44 false) =
        toffoliCount (R2SqEp760.endPacket760 false) + 132 ∧
    measurementCount (endPacket760Loan44 false) =
        measurementCount (R2SqEp760.endPacket760 false) + 132 := by
  simpa using endPacket760Loan44_counts false

theorem endPacket760Loan44_false_physical : GatePhysical (endPacket760Loan44 false) :=
  endPacket760Loan44_physical false


/-- Certificate-facing multiplication obligation for the 44-site endpoint
(same quantifier shape as `StairEndpoint.MultiplicationRunSpec`). -/
def MultiplicationRunSpec44 : Prop :=
  ∀ isA origin, FrontierReplay1591.Context origin →
    origin (base 2400) = true → ∀ X Y, X = Y → ∀ s fresh old,
    Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X Y s →
    run (endPacket760Loan44 false) fresh s =
      run (R2SqEp760.endPacket760 false) old s

theorem multiplicationRunSpec44 : MultiplicationRunSpec44 :=
  fun isA origin ctx enabled X Y hX s fresh old input =>
    endPacket760Loan44_run_eq isA origin ctx enabled X Y hX s fresh old input

end ECDSAAdd.Entrant.StairEndpointLoan44
end Merge_StairEndpointLoan44_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanSupportHalf_at_StairSideA` -/
section Merge_StairLoanSupportHalf_at_StairSideA

/-!
# Whole-half support erasure for the staircase loan halves

`StairLoanSupport` proves the component-level support lemmas (inner carry
families, fixed-layout support facts).  This module composes them through the
fixed wire swaps and unchanged frames of the 760-qubit lifetime half and
exposes field 5 of `StairCertificate.StairOpen` (`WholeHalfSupport`) as
`StairLoanSupport.wholeHalfSupport`.
-/

set_option autoImplicit false
set_option maxRecDepth 2000
set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySimpa false

namespace ECDSAAdd.Entrant.StairLoanSupport

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField
open StairLoan

/- The fixed 760-site layout is a concrete structure literal.  None of the
proofs below needs its field values (the few concrete facts are decided by the
kernel), and letting the elaborator unfold it makes unification evaluate the
256-entry wire lists. -/
attribute [local irreducible] Q6EndpointCell.ports
























/-- Field 5 of the staircase certificate: every positive or zero loan depth
omits exactly the borrowed role prefix from the original endpoint support. -/
theorem wholeHalfSupport :
    ∀ divide d, d ≤ 68 →
      wires (half760Loan d divide) ⊆
        wires (Q6EndpointCell.half divide base (base 2409)) \
          (retiredRoles.take d).toFinset := by
  intro divide d hd q hq
  have loan := Finset.mem_sdiff.mp (half760Loan_support760 d divide hd hq)
  have old : q ∈ wires (R2Life760.half760 divide) := by
    simpa only [half760Loan_zero] using loan.1
  have endpoint := Finset.mem_erase.mp (R2Life760.half760_support divide old)
  exact Finset.mem_sdiff.mpr ⟨endpoint.2, loan.2⟩

end ECDSAAdd.Entrant.StairLoanSupport
end Merge_StairLoanSupportHalf_at_StairSideA

