/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitGates_at_StairSideA` -/
section Merge_StairField2V3ExitGates_at_StairSideA

/-!
# Gate-level inverses for the exit round trips (LT24)

Measurement-free X/CX/CCX programs whose targets are never their own
controls are inverted by their reversal (`run_reverse_cancel`); gates whose
targets avoid each other's controls commute (`single_commute`), so a list of
pairwise commuting gates runs like its reversal (`run_reverse_eq`).
Application: `swapRegisters` (the codec orientation) is an involution on the
whole state (`swapRegisters_involution`).
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairField2V3ExitGates

open ECDSAAdd Arithmetic

def NoMeas : Instr → Prop
  | .measureX _ _ _ => False
  | _ => True

def tgt : Instr → Wire
  | .X t => t
  | .CX _ t => t
  | .CCX _ _ t => t
  | .measureX t _ _ => t

def ctrlWires : Instr → List Wire
  | .X _ => []
  | .CX a _ => [a]
  | .CCX a b _ => [a, b]
  | .measureX _ _ _ => []

def ctrl : Instr → BasisState → Bool
  | .X _, _ => true
  | .CX a _, s => s a
  | .CCX a b _, s => s a && s b
  | .measureX _ _ _, _ => false

theorem ctrl_congr (g : Instr) (b b' : BasisState) (h : ∀ q ∈ ctrlWires g, b q = b' q) :
    ctrl g b = ctrl g b' := by
  cases g with
  | X t => rfl
  | CX a t => exact h a (by simp [ctrlWires])
  | CCX a c t =>
      simp only [ctrl]
      rw [h a (by simp [ctrlWires]), h c (by simp [ctrlWires])]
  | measureX t c0 c1 => rfl

theorem run_single (g : Instr) (hg : NoMeas g) (m : List Bool) (s : State) :
    run [g] m s = ⟨s.phase, Function.update s.basis (tgt g) (s.basis (tgt g) ^^ ctrl g s.basis)⟩ := by
  cases g with
  | X t =>
      simp only [run, writeBit, tgt, ctrl, Bool.xor_true]
  | CX a t => simp only [run, writeBit, tgt, ctrl]
  | CCX a c t => simp only [run, writeBit, tgt, ctrl]
  | measureX t c0 c1 => exact absurd hg (by simp [NoMeas])

theorem run_cons (g : Instr) (P : Program) (hg : NoMeas g) (m : List Bool) (s : State) :
    run (g :: P) m s = run P m (run [g] [] s) := by
  cases g with
  | X t => rfl
  | CX a t => rfl
  | CCX a c t => rfl
  | measureX t c0 c1 => exact absurd hg (by simp [NoMeas])

def Good (g : Instr) : Prop := NoMeas g ∧ tgt g ∉ ctrlWires g

theorem single_involution (g : Instr) (hg : Good g) (s : State) :
    run [g] [] (run [g] [] s) = s := by
  rw [run_single g hg.1, run_single g hg.1]
  apply State.extensionality
  · rfl
  · funext q
    have hc : ctrl g (Function.update s.basis (tgt g)
        (s.basis (tgt g) ^^ ctrl g s.basis)) = ctrl g s.basis := by
      apply ctrl_congr
      intro r hr
      have hne : r ≠ tgt g := fun e => hg.2 (e ▸ hr)
      simp [Function.update_of_ne hne]
    simp only [hc]
    by_cases hq : q = tgt g
    · subst hq
      simp
    · simp [Function.update_of_ne hq]

/-- Two good gates commute when neither target is a wire of the other gate. -/
def Commutes (g h : Instr) : Prop :=
  tgt g ∉ ctrlWires h ∧ tgt h ∉ ctrlWires g ∧ tgt g ≠ tgt h

theorem single_commute (g h : Instr) (hg : NoMeas g) (hh : NoMeas h) (c : Commutes g h)
    (s : State) : run [g] [] (run [h] [] s) = run [h] [] (run [g] [] s) := by
  obtain ⟨c1, c2, c3⟩ := c
  rw [run_single g hg, run_single h hh, run_single h hh, run_single g hg]
  have eg : ctrl g (Function.update s.basis (tgt h) (s.basis (tgt h) ^^ ctrl h s.basis)) =
      ctrl g s.basis := by
    apply ctrl_congr
    intro r hr
    have hne : r ≠ tgt h := fun e => c2 (e ▸ hr)
    simp [Function.update_of_ne hne]
  have eh : ctrl h (Function.update s.basis (tgt g) (s.basis (tgt g) ^^ ctrl g s.basis)) =
      ctrl h s.basis := by
    apply ctrl_congr
    intro r hr
    have hne : r ≠ tgt g := fun e => c1 (e ▸ hr)
    simp [Function.update_of_ne hne]
  apply State.extensionality
  · rfl
  · simp only [eg, eh]
    funext q
    by_cases hq1 : q = tgt g
    · subst hq1
      simp [Function.update_of_ne c3, Function.update_of_ne (Ne.symm c3)]
    · by_cases hq2 : q = tgt h
      · subst hq2
        simp [Function.update_of_ne c3, Function.update_of_ne (Ne.symm c3)]
      · simp [Function.update_of_ne hq1, Function.update_of_ne hq2]

theorem run_noMeas_tape (P : Program) (hP : ∀ g ∈ P, NoMeas g) (m : List Bool) (s : State) :
    run P m s = run P [] s := by
  induction P generalizing s with
  | nil => rfl
  | cons g P ih =>
      rw [run_cons g P (hP g (by simp)) m, run_cons g P (hP g (by simp)) [],
        ih (fun x hx => hP x (by simp [hx]))]

theorem run_append_nil (P Q : Program) (s : State) : run (P ++ Q) [] s = run Q [] (run P [] s) := by
  rw [run_append]
  simp

/-- Reversal inverts a good measurement-free program. -/
theorem run_reverse_cancel (P : Program) (hP : ∀ g ∈ P, Good g) (s : State) :
    run P.reverse [] (run P [] s) = s := by
  induction P generalizing s with
  | nil => rfl
  | cons g P ih =>
      have hg := hP g (by simp)
      have hP' : ∀ x ∈ P, Good x := fun x hx => hP x (by simp [hx])
      rw [run_cons g P hg.1, List.reverse_cons,
        run_append_nil,
        ih hP' _, single_involution g hg]

/-- A gate commuting with every gate of `P` commutes with `P`. -/
theorem single_commute_list (g : Instr) (P : Program) (hg : NoMeas g)
    (hP : ∀ x ∈ P, NoMeas x ∧ Commutes g x) (s : State) :
    run [g] [] (run P [] s) = run P [] (run [g] [] s) := by
  induction P generalizing s with
  | nil => rfl
  | cons x P ih =>
      have hx := hP x (by simp)
      rw [run_cons x P hx.1, run_cons x P hx.1,
        ih (fun y hy => hP y (by simp [hy])), single_commute g x hg hx.1 hx.2]

/-- Pairwise commuting gates run like their reversal. -/
theorem run_reverse_eq (P : Program) (hP : ∀ g ∈ P, NoMeas g)
    (hc : P.Pairwise Commutes) (s : State) :
    run P.reverse [] s = run P [] s := by
  induction P generalizing s with
  | nil => rfl
  | cons g P ih =>
      have hg := hP g (by simp)
      have hP' : ∀ x ∈ P, NoMeas x := fun x hx => hP x (by simp [hx])
      rw [List.pairwise_cons] at hc
      rw [List.reverse_cons,
        run_append_nil,
        ih hP' hc.2, run_cons g P hg,
        single_commute_list g P hg (fun x hx => ⟨hP' x hx, hc.1 x hx⟩)]


/-! ## Register copies and swaps -/

theorem mem_copy (ctl : Option Wire) :
    ∀ (src dst : List Wire) (x : Instr), x ∈ copyRegister ctl src dst →
      ∃ a ∈ src, ∃ b ∈ dst, x = copyGate ctl a b
  | a :: src, b :: dst, x, hx => by
      simp only [copyRegister, List.singleton_append, List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact ⟨a, by simp, b, by simp, rfl⟩
      · obtain ⟨a', ha, b', hb, rfl⟩ := mem_copy ctl src dst x hx
        exact ⟨a', by simp [ha], b', by simp [hb], rfl⟩
  | [], _, x, hx => by simp [copyRegister] at hx
  | _ :: _, [], x, hx => by simp [copyRegister] at hx

theorem copyGate_noMeas (ctl : Option Wire) (a b : Wire) : NoMeas (copyGate ctl a b) := by
  cases ctl <;> trivial

theorem copyGate_tgt (ctl : Option Wire) (a b : Wire) : tgt (copyGate ctl a b) = b := by
  cases ctl <;> rfl

theorem mem_copyGate_ctrl (ctl : Option Wire) (a b q : Wire)
    (hq : q ∈ ctrlWires (copyGate ctl a b)) : q = a ∨ q ∈ ctl.toList := by
  cases ctl with
  | none => simp [copyGate, ctrlWires] at hq; exact Or.inl hq
  | some c =>
      simp [copyGate, ctrlWires] at hq
      rcases hq with h | h
      · exact Or.inr (by simp [h])
      · exact Or.inl h

theorem copy_props (ctl : Option Wire) :
    ∀ (src dst : List Wire), (∀ a ∈ src, ∀ b ∈ dst, a ≠ b) →
      (∀ c ∈ ctl.toList, c ∉ dst) → dst.Nodup →
      (∀ g ∈ copyRegister ctl src dst, Good g) ∧ (copyRegister ctl src dst).Pairwise Commutes
  | a :: src, b :: dst, hsd, hc, hd => by
      have hd' := List.nodup_cons.mp hd
      have ih := copy_props ctl src dst (fun x hx y hy => hsd x (by simp [hx]) y (by simp [hy]))
        (fun c hcm hcd => hc c hcm (by simp [hcd])) hd'.2
      have hab : a ≠ b := hsd a (by simp) b (by simp)
      have good : Good (copyGate ctl a b) := by
        refine ⟨copyGate_noMeas ctl a b, ?_⟩
        rw [copyGate_tgt]
        intro hm
        rcases mem_copyGate_ctrl ctl a b b hm with h | h
        · exact hab h.symm
        · exact hc b h (by simp)
      simp only [copyRegister, List.singleton_append, List.pairwise_cons, List.mem_cons]
      refine ⟨?_, ?_, ih.2⟩
      · intro g hg
        rcases hg with rfl | hg
        · exact good
        · exact ih.1 g hg
      · intro x hx
        obtain ⟨a', ha', b', hb', rfl⟩ := mem_copy ctl src dst x hx
        refine ⟨?_, ?_, ?_⟩
        · rw [copyGate_tgt]
          intro hm
          rcases mem_copyGate_ctrl ctl a' b' b hm with h | h
          · exact hsd a' (by simp [ha']) b (by simp) h.symm
          · exact hc b h (by simp)
        · rw [copyGate_tgt]
          intro hm
          rcases mem_copyGate_ctrl ctl a b b' hm with h | h
          · exact hsd a (by simp) b' (by simp [hb']) h.symm
          · exact hc b' h (by simp [hb'])
        · rw [copyGate_tgt, copyGate_tgt]
          intro e
          exact hd'.1 (e ▸ hb')
  | [], _, _, _, _ => by simp [copyRegister]
  | _ :: _, [], _, _, _ => by simp [copyRegister]

/-- `swapRegisters` is an involution on the whole state. -/
theorem swapRegisters_involution (c : Wire) (a b : List Wire)
    (hab : ∀ x ∈ a, ∀ y ∈ b, x ≠ y) (hcb : c ∉ b)
    (ha : a.Nodup) (hb : b.Nodup) (s : State) (m n : List Bool) :
    run (swapRegisters c a b) m (run (swapRegisters c a b) n s) = s := by
  have pA := copy_props none b a (fun x hx y hy e => hab y hy x hx e.symm) (by simp) ha
  have pM := copy_props (some c) a b hab (by simpa using hcb) hb
  have goodS : ∀ g ∈ swapRegisters c a b, Good g := by
    intro g hg
    simp only [swapRegisters, List.mem_append] at hg
    rcases hg with (hg | hg) | hg
    · exact pA.1 g hg
    · exact pM.1 g hg
    · exact pA.1 g hg
  have nmS : ∀ g ∈ swapRegisters c a b, NoMeas g := fun g hg => (goodS g hg).1
  have revA : ∀ t, run (copyRegister none b a).reverse [] t = run (copyRegister none b a) [] t :=
    run_reverse_eq _ (fun g hg => (pA.1 g hg).1) pA.2
  have revM : ∀ t, run (copyRegister (some c) a b).reverse [] t =
      run (copyRegister (some c) a b) [] t :=
    run_reverse_eq _ (fun g hg => (pM.1 g hg).1) pM.2
  have revS : run (swapRegisters c a b).reverse [] (run (swapRegisters c a b) [] s) =
      run (swapRegisters c a b) [] (run (swapRegisters c a b) [] s) := by
    simp only [swapRegisters, List.reverse_append, List.append_assoc]
    simp only [run_append_nil, revA, revM]
  rw [run_noMeas_tape _ nmS m, run_noMeas_tape _ nmS n, ← revS]
  exact run_reverse_cancel _ goodS s

end ECDSAAdd.Entrant.StairField2V3ExitGates

end
end Merge_StairField2V3ExitGates_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairHolesGeneric_at_StairSideA` -/
section Merge_StairHolesGeneric_at_StairSideA

/-!
# S4: tracked replay of a re-hosted program against the frozen program (variable programs)

The frozen program is a concatenation of segments `P₁ ++ P₂ ++ …`; the re-hosted program
replaces every segment by `P'ᵢ`.  Between two segments the new run is the frozen run with a
wire permutation applied: `new = pullState τ.symm frozen` (`τ` moves each site whose window is
open to its host).  `SegReplay R τ₀ τ₁ P' P` is that statement for one segment, for every
frozen state in `R` (the frozen states that can reach the segment):

* `segReplay_rename`: `P' = renameProgram τ P` is tracked by `τ` on both sides, no hypothesis;
* `segReplay_fixed`: a frozen segment that `τ` does not move is tracked by `τ`, unchanged;
* `segReplay_eq`: a segment with equal runs on `R` (e.g. the square) is tracked by the identity;
* `SegReplay.conv_in` / `conv_out`: the tracking permutation may change at a boundary where
  the frozen states do not see the difference (`pull_mul_swap`: opening or closing the window
  of site `a` on host `h` when both are zero);
* `SegReplay.append`, `Chain.segReplay`: composition; the reachable set of the next segment is
  `After R P` (frozen states after one run of `P` from `R`).

`Keeps q P` / `Resets q P` / `ZeroOn R q` are the zero-tracking facts used at window ends:
an untouched wire keeps zero (`keeps_of_not_mem`), a wire whose run ends reset is zero after.
Everything here is for variable programs, wires and states.
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairHoles

open ECDSAAdd

/-! ## Reachable frozen states -/

/-- Frozen states after one run of `P` (any tape) from a state of `R`. -/
def After (R : State → Prop) (P : Program) (t : State) : Prop :=
  ∃ s m, R s ∧ t = run P m s

theorem After.intro {R : State → Prop} {P : Program} {s : State} (hs : R s) (m : List Bool) :
    After R P (run P m s) := ⟨s, m, hs, rfl⟩


theorem after_append {R : State → Prop} {P Q : Program} {t : State}
    (h : After R (P ++ Q) t) : After (After R P) Q t := by
  obtain ⟨s, m, hs, rfl⟩ := h
  rw [run_append]
  exact After.intro (After.intro hs _) _

theorem after_nil {R : State → Prop} {t : State} (h : After R [] t) : R t := by
  obtain ⟨s, m, hs, rfl⟩ := h
  exact hs


/-! ## Zero tracking -/

/-- Every state of `R` has wire `q` at zero. -/
def ZeroOn (R : State → Prop) (q : Wire) : Prop := ∀ s, R s → s.basis q = false

/-- `P` keeps wire `q` at zero. -/
def Keeps (q : Wire) (P : Program) : Prop :=
  ∀ s m, s.basis q = false → (run P m s).basis q = false

/-- `P` leaves wire `q` at zero whatever the input. -/
def Resets (q : Wire) (P : Program) : Prop := ∀ s m, (run P m s).basis q = false

theorem keeps_of_not_mem {q : Wire} {P : Program} (h : q ∉ wires P) : Keeps q P := by
  intro s m hs
  rw [run_preserves_outside P m s q h]
  exact hs




theorem Resets.append_keeps {q : Wire} {P Q : Program} (hP : Resets q P) (hQ : Keeps q Q) :
    Resets q (P ++ Q) := by
  intro s m
  rw [run_append]
  exact hQ _ _ (hP _ _)

theorem Resets.append_right {q : Wire} (P : Program) {Q : Program} (hQ : Resets q Q) :
    Resets q (P ++ Q) := by
  intro s m
  rw [run_append]
  exact hQ _ _


theorem Resets.rename {q : Wire} {P : Program} (f : Wire → Wire) (hf : Function.Injective f)
    (h : Resets q P) : Resets (f q) (renameProgram f P) := by
  intro s m
  have e := run_rename f hf P m s
  have k : (run P m (pullState f s)).basis q = false := h _ _
  rw [← e] at k
  exact k




/-- An untouched label stays untouched through an injective level map. -/
theorem not_mem_rename {q : Wire} {P : Program} (f : Wire → Wire) (hf : Function.Injective f)
    (h : q ∉ wires P) : f q ∉ wires (renameProgram f P) := by
  intro hw
  rw [renameProgram_support] at hw
  obtain ⟨x, hx, e⟩ := Finset.mem_image.mp hw
  have := hf e
  subst this
  exact h hx


theorem ZeroOn.after {R : State → Prop} {q : Wire} {P : Program} (z : ZeroOn R q)
    (k : Keeps q P) : ZeroOn (After R P) q := by
  rintro t ⟨s, m, hs, rfl⟩
  exact k s m (z s hs)

theorem ZeroOn.after_resets (R : State → Prop) {q : Wire} {P : Program} (k : Resets q P) :
    ZeroOn (After R P) q := by
  rintro t ⟨s, m, -, rfl⟩
  exact k s m

/-! ## Pulled states -/


theorem pull_symm_pull (τ : Equiv.Perm Wire) (t : State) :
    pullState τ.symm (pullState τ t) = t := by
  apply State.extensionality
  · rfl
  · funext q
    change t.basis (τ (τ.symm q)) = t.basis q
    rw [Equiv.apply_symm_apply]

theorem pull_pull_symm (τ : Equiv.Perm Wire) (t : State) :
    pullState τ (pullState τ.symm t) = t := by
  apply State.extensionality
  · rfl
  · funext q
    change t.basis (τ.symm (τ q)) = t.basis q
    rw [Equiv.symm_apply_apply]

theorem pull_one (s : State) : pullState (Equiv.refl Wire).symm s = s :=
  State.extensionality _ _ rfl (funext fun _ => rfl)



theorem pull_swap (a h : Wire) (s : State) (ha : s.basis a = false) (hh : s.basis h = false) :
    pullState (Equiv.swap a h).symm s = s := by
  rw [Equiv.symm_swap]
  exact pullState_zero_swap a h s ha hh

/-! ## Renames -/

theorem renameCorrection_id (c : Correction) : renameCorrection (fun q => q) c = c := by
  cases c <;> rfl

theorem renameInstr_id (i : Instr) : renameInstr (fun q => q) i = i := by
  have e : renameCorrection (fun q => q) = id := funext renameCorrection_id
  cases i <;> simp only [renameInstr, e, List.map_id]

theorem renameProgram_id (P : Program) : renameProgram (fun q => q) P = P := by
  have e : renameInstr (fun q => q) = id := funext renameInstr_id
  simp only [renameProgram, e, List.map_id]

/-- A rename that fixes the wires of the program does nothing. -/
theorem renameProgram_fixed (f : Wire → Wire) (P : Program) (h : ∀ q ∈ wires P, f q = q) :
    renameProgram f P = P := by
  rw [renameProgram_congr_support f (fun q => q) P h, renameProgram_id]

theorem renameProgram_append (f : Wire → Wire) (P Q : Program) :
    renameProgram f (P ++ Q) = renameProgram f P ++ renameProgram f Q := by
  simp only [renameProgram, List.map_append]

/-- A label-level swap seen through a level map that is injective on the labels in play. -/
theorem rename_swap_comm (f : Wire → Wire) (a h : Wire) (P : Program)
    (inj : ∀ x ∈ wires P, (f x = f a → x = a) ∧ (f x = f h → x = h)) :
    renameProgram f (renameProgram (Equiv.swap a h) P) =
      renameProgram (Equiv.swap (f a) (f h)) (renameProgram f P) := by
  rw [renameProgram_comp, renameProgram_comp]
  apply renameProgram_congr_support
  intro x hx
  simp only [Function.comp_apply]
  by_cases xa : x = a
  · subst xa
    rw [Equiv.swap_apply_left, Equiv.swap_apply_left]
  · by_cases xh : x = h
    · subst xh
      rw [Equiv.swap_apply_right, Equiv.swap_apply_right]
    · rw [Equiv.swap_apply_of_ne_of_ne xa xh,
        Equiv.swap_apply_of_ne_of_ne (fun e => xa ((inj x hx).1 e))
          (fun e => xh ((inj x hx).2 e))]

/-! ## Tracked replay of one segment -/

/-- On every frozen state of `R`, the new segment `P'` started from the frozen state seen
through `τ₀` ends in the frozen result seen through `τ₁`, for every tape. -/
def SegReplay (R : State → Prop) (τ₀ τ₁ : Equiv.Perm Wire) (P' P : Program) : Prop :=
  measurementCount P' = measurementCount P ∧
    ∀ s, R s → ∀ m, run P' m (pullState τ₀.symm s) = pullState τ₁.symm (run P m s)


theorem SegReplay.append {R : State → Prop} {τ₀ τ₁ τ₂ : Equiv.Perm Wire} {P' P Q' Q : Program}
    (h1 : SegReplay R τ₀ τ₁ P' P) (h2 : SegReplay (After R P) τ₁ τ₂ Q' Q) :
    SegReplay R τ₀ τ₂ (P' ++ Q') (P ++ Q) := by
  refine ⟨by rw [measurementCount_append, measurementCount_append, h1.1, h2.1], ?_⟩
  intro s hs m
  rw [run_append, run_append, h1.1]
  have e1 := h1.2 s hs (m.take (measurementCount P))
  have e2 := h2.2 _ (After.intro hs (m.take (measurementCount P)))
    (m.drop (measurementCount P))
  rw [e1, e2]

/-- A segment renamed by the tracking permutation: no hypothesis. -/
theorem segReplay_rename (R : State → Prop) (τ : Equiv.Perm Wire) (P : Program) :
    SegReplay R τ τ (renameProgram τ P) P := by
  refine ⟨(renameProgram_counts τ P).2, fun s _ m => ?_⟩
  have e := run_rename τ τ.injective P m (pullState τ.symm s)
  rw [pull_pull_symm] at e
  rw [← e, pull_symm_pull]

/-- A frozen segment that the tracking permutation does not move. -/
theorem segReplay_fixed (R : State → Prop) (τ : Equiv.Perm Wire) (P : Program)
    (h : ∀ q ∈ wires P, τ q = q) : SegReplay R τ τ P P := by
  have k := segReplay_rename R τ P
  rw [renameProgram_fixed τ P h] at k
  exact k

theorem segReplay_refl (R : State → Prop) (P : Program) : SegReplay R (Equiv.refl Wire) (Equiv.refl Wire) P P :=
  segReplay_fixed R (Equiv.refl Wire) P (fun _ _ => rfl)

/-- A segment with equal runs on the reachable frozen states (no window open). -/
theorem segReplay_eq {R : State → Prop} {P' P : Program}
    (hc : measurementCount P' = measurementCount P)
    (h : ∀ s, R s → ∀ m, run P' m s = run P m s) : SegReplay R (Equiv.refl Wire) (Equiv.refl Wire) P' P := by
  refine ⟨hc, fun s hs m => ?_⟩
  rw [pull_one, pull_one]
  exact h s hs m

/-- Change of the tracking permutation before the segment. -/
theorem SegReplay.conv_in {R : State → Prop} {τ₀ τ₀' τ₁ : Equiv.Perm Wire} {P' P : Program}
    (h : ∀ s, R s → pullState τ₀.symm s = pullState τ₀'.symm s)
    (k : SegReplay R τ₀' τ₁ P' P) : SegReplay R τ₀ τ₁ P' P :=
  ⟨k.1, fun s hs m => by rw [h s hs]; exact k.2 s hs m⟩

/-- Change of the tracking permutation after the segment. -/
theorem SegReplay.conv_out {R : State → Prop} {τ₀ τ₁ τ₁' : Equiv.Perm Wire} {P' P : Program}
    (h : ∀ t, After R P t → pullState τ₁'.symm t = pullState τ₁.symm t)
    (k : SegReplay R τ₀ τ₁' P' P) : SegReplay R τ₀ τ₁ P' P :=
  ⟨k.1, fun s hs m => by rw [k.2 s hs m]; exact h _ (After.intro hs m)⟩

/-- A tracked replay with no window open at either end is run equality. -/
theorem SegReplay.run_eq {R : State → Prop} {P' P : Program} (k : SegReplay R (Equiv.refl Wire) (Equiv.refl Wire) P' P)
    {s : State} (hs : R s) (m : List Bool) : run P' m s = run P m s := by
  have e := k.2 s hs m
  rw [pull_one, pull_one] at e
  exact e

/-! ## One site, one host: the four positions of a segment in a window -/

section Window

variable {R : State → Prop} {P : Program} (a h : Wire)

/-- The window opens at this segment: both wires are zero before it. -/
theorem segReplay_open (za : ZeroOn R a) (zh : ZeroOn R h) :
    SegReplay R (Equiv.refl Wire) (Equiv.swap a h) (renameProgram (Equiv.swap a h) P) P :=
  (segReplay_rename R (Equiv.swap a h) P).conv_in (fun s hs => by
    rw [pull_one, pull_swap a h s (za s hs) (zh s hs)])

/-- The window closes at this segment: both wires are zero after it. -/
theorem segReplay_close (za : ZeroOn (After R P) a) (zh : ZeroOn (After R P) h) :
    SegReplay R (Equiv.swap a h) (Equiv.refl Wire) (renameProgram (Equiv.swap a h) P) P :=
  (segReplay_rename R (Equiv.swap a h) P).conv_out (fun t ht => by
    rw [pull_one, pull_swap a h t (za t ht) (zh t ht)])

/-- The window is this segment alone. -/
theorem segReplay_window (za : ZeroOn R a) (zh : ZeroOn R h)
    (za' : ZeroOn (After R P) a) (zh' : ZeroOn (After R P) h) :
    SegReplay R (Equiv.refl Wire) (Equiv.refl Wire) (renameProgram (Equiv.swap a h) P) P :=
  (segReplay_open a h za zh).conv_out (fun t ht => by
    rw [pull_one, pull_swap a h t (za' t ht) (zh' t ht)])

/-- A frozen segment inside the window that touches neither wire. -/
theorem segReplay_idle (ha : a ∉ wires P) (hh : h ∉ wires P) :
    SegReplay R (Equiv.swap a h) (Equiv.swap a h) P P :=
  segReplay_fixed R _ P (fun _ hq =>
    Equiv.swap_apply_of_ne_of_ne (fun e => ha (e ▸ hq)) (fun e => hh (e ▸ hq)))

end Window

/-! ## Chains of segments -/

/-- A chain of tracked segments `(new, frozen, permutation after)`. -/
def Chain : (State → Prop) → Equiv.Perm Wire → List (Program × Program × Equiv.Perm Wire) →
    Equiv.Perm Wire → Prop
  | _, τ₀, [], τe => τ₀ = τe
  | R, τ₀, (P', P, τ₁) :: l, τe => SegReplay R τ₀ τ₁ P' P ∧ Chain (After R P) τ₁ l τe

/-- The new program of a chain. -/
def chainNew (l : List (Program × Program × Equiv.Perm Wire)) : Program :=
  (l.map (fun x => x.1)).flatten

/-- The frozen program of a chain. -/
def chainOld (l : List (Program × Program × Equiv.Perm Wire)) : Program :=
  (l.map (fun x => x.2.1)).flatten

theorem Chain.segReplay : ∀ (l : List (Program × Program × Equiv.Perm Wire))
    (R : State → Prop) (τ₀ τe : Equiv.Perm Wire), Chain R τ₀ l τe →
    SegReplay R τ₀ τe (chainNew l) (chainOld l)
  | [], R, τ₀, τe, h => by
      have e : τ₀ = τe := h
      subst e
      exact segReplay_fixed R τ₀ [] (fun _ hq => by simp [wires] at hq)
  | (P', P, τ₁) :: l, R, τ₀, τe, h => by
      have ih := Chain.segReplay l (After R P) τ₁ τe h.2
      have k := SegReplay.append h.1 ih
      simpa only [chainNew, chainOld, List.map_cons, List.flatten_cons] using k

/-- A closed chain is run equality on every reachable start state. -/
theorem Chain.run_eq {l : List (Program × Program × Equiv.Perm Wire)} {R : State → Prop}
    (h : Chain R (Equiv.refl Wire) l (Equiv.refl Wire)) {s : State} (hs : R s) (m : List Bool) :
    run (chainNew l) m s = run (chainOld l) m s :=
  (Chain.segReplay l R _ _ h).run_eq hs m

end ECDSAAdd.Entrant.StairHoles

end
end Merge_StairHolesGeneric_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoan_at_StairSideA` -/
section Merge_StairLoan_at_StairSideA

/-!
# Staircase carry loans

The local primitive used by the staircase field schedule is independent of the
arithmetic performed at the top of a carry sweep.  Once a prefix of carries has
been computed, `erasePrefix` erases it in the only safe order (high to low).
The same prefix is recomputed low to high by `carryPrefix` after the upper
program has returned the borrowed sites clean.

`loanWindow d ... upper` is therefore the common `+d` CCX / `+d` measurement
piece inserted at each of the four sweep tops of a regular half.  The sources
are `MappedBit`s, so the one construction covers ordinary, complemented, and
constant-source adders.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-! ## LT44 (replay budget): linear list checks with a bit mask

`List.Nodup` and list membership by `decide` are quadratic / linear walks over unevaluated
wire lists (≈ 47 s of kernel time for one 770-wire `Nodup`).  With a `Nat` bit mask the kernel
does one GMP `|||` / `>>>` per element (< 1 s). -/






















































theorem literalConstAddLoan_counts (d : Nat) (roles xs carry : List Wire)
    (cin one : Wire) (k : Nat) (hc : carry.length+1=xs.length)
    (hd : d≤carry.length) :
    toffoliCount (literalConstAddLoan d roles xs carry cin one k)=
        toffoliCount (literalConstAdd xs carry cin one k)+d ∧
    measurementCount (literalConstAddLoan d roles xs carry cin one k)=
        measurementCount (literalConstAdd xs carry cin one k)+d := by
  cases d with
  | zero => simp [literalConstAddLoan]
  | succ d =>
      have bits : (mappedConstant none xs.length k).length=xs.length :=
        mappedConstant_length none xs.length k
      have loan := mappedAddLoan_counts (d+1) roles
        (mappedConstant none xs.length k) xs carry cin bits hc hd
      have mapped := mappedAdd_counts (mappedConstant none xs.length k)
        xs carry cin bits hc
      have literal := literalConstAdd_counts xs carry cin one k hc
      simp only [literalConstAddLoan,Nat.succ_ne_zero,if_false]
      constructor <;> omega







theorem compareLayers_unit (forward : Bool) (as bs cs : List Wire)
    (cin target : Wire) :
    ∀l∈compareLayers forward as bs cs cin target,LayerUnit l := by
  induction as generalizing bs cs cin with
  | nil => simp [compareLayers]
  | cons a as ih =>
      cases as with
      | nil => simp [compareLayers]
      | cons a' as =>
          cases bs with
          | nil => simp [compareLayers]
          | cons b bs =>
              cases bs with
              | nil => simp [compareLayers]
              | cons b' bs =>
                  cases cs with
                  | nil => simp [compareLayers]
                  | cons c cs =>
                      intro l hl
                      simp only [compareLayers,List.mem_cons] at hl
                      rcases hl with rfl|hl
                      · exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩
                      · exact ih (b'::bs) cs c l hl

theorem compareLayers_length (forward : Bool) (as bs cs : List Wire)
    (cin target : Wire) (hab : as.length=bs.length)
    (hc : cs.length+1=as.length) :
    (compareLayers forward as bs cs cin target).length=cs.length := by
  induction as generalizing bs cs cin with
  | nil => simp at hc
  | cons a as ih =>
      cases bs with
      | nil => simp at hab
      | cons b bs =>
          cases as with
          | nil =>
              have bl : bs=[] := List.eq_nil_of_length_eq_zero (by simpa using hab.symm)
              subst bs
              have cl : cs=[] := List.eq_nil_of_length_eq_zero (by
                simp only [List.length_cons,List.length_nil] at hc
                omega)
              subst cs
              rfl
          | cons a' as =>
              cases bs with
              | nil => simp at hab
              | cons b' bs =>
                  cases cs with
                  | nil => simp at hc
                  | cons c cs =>
                      simp only [compareLayers,List.length_cons]
                      rw [ih (b'::bs) cs c (by simpa using hab) (by simpa using hc)]

theorem compareLoan_counts (d : Nat) (roles : List Wire) (forward : Bool)
    (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length=bs.length) (hc : cs.length+1=as.length)
    (hd : d≤cs.length) :
    toffoliCount (compareLoan d roles forward as bs cs cin target)=
      toffoliCount (Q6LifetimeResearch.compareChain forward as bs cs cin target)+d ∧
    measurementCount (compareLoan d roles forward as bs cs cin target)=
      measurementCount (Q6LifetimeResearch.compareChain forward as bs cs cin target)+d := by
  have len := compareLayers_length forward as bs cs cin target hab hc
  have loan := emitLoan_counts d roles (compareLayers forward as bs cs cin target)
    (compareTop forward as bs cs cin target) (by omega)
    (compareLayers_unit forward as bs cs cin target)
  rw [←compareChain_as_sweep] at loan
  simpa only [compareLoan] using loan





theorem prefixLayers_unit (xs ys carry : List Wire) (a t z cin : Wire) :
    ∀l∈prefixLayers xs ys carry a t z cin,LayerUnit l := by
  induction xs generalizing ys carry cin with
  | nil => simp [prefixLayers]
  | cons x xs ih =>
      cases ys with
      | nil => simp [prefixLayers]
      | cons y ys =>
          cases carry with
          | nil => simp [prefixLayers]
          | cons c cs =>
              intro l hl
              simp only [prefixLayers,List.mem_cons] at hl
              rcases hl with rfl|hl
              · exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩
              · exact ih ys cs c l hl

theorem prefixLayers_length (xs ys carry : List Wire) (a t z cin : Wire)
    (hy : ys.length=xs.length) (hc : carry.length=xs.length) :
    (prefixLayers xs ys carry a t z cin).length=carry.length := by
  induction xs generalizing ys carry cin with
  | nil =>
      have ye : ys=[] := List.eq_nil_of_length_eq_zero hy
      have ce : carry=[] := List.eq_nil_of_length_eq_zero hc
      subst ys; subst carry; rfl
  | cons x xs ih =>
      cases ys with
      | nil => simp at hy
      | cons y ys =>
          cases carry with
          | nil => simp at hc
          | cons c cs =>
              simp only [prefixLayers,List.length_cons]
              rw [ih ys cs c (by simpa using hy) (by simpa using hc)]

theorem addPrefixLoan_counts (d : Nat) (roles xs ys carry : List Wire)
    (a t z cin : Wire) (hy : ys.length=xs.length) (hc : carry.length=xs.length)
    (hd : d≤carry.length) :
    toffoliCount (addPrefixLoan d roles xs ys carry a t z cin)=
      toffoliCount (CoherentTail.addPrefix xs ys carry a t z cin)+d ∧
    measurementCount (addPrefixLoan d roles xs ys carry a t z cin)=
      measurementCount (CoherentTail.addPrefix xs ys carry a t z cin)+d := by
  have len := prefixLayers_length xs ys carry a t z cin hy hc
  have loan := emitLoan_counts d roles (prefixLayers xs ys carry a t z cin)
    (prefixTop xs ys carry a t z cin) (by omega)
    (prefixLayers_unit xs ys carry a t z cin)
  rw [←addPrefix_as_sweep] at loan
  simpa only [addPrefixLoan] using loan





theorem addTopLayers_unit (as bs cs : List Wire) (cin : Wire) :
    ∀l∈addTopLayers as bs cs cin,LayerUnit l := by
  induction as generalizing bs cs cin with
  | nil => simp [addTopLayers]
  | cons a as ih =>
      cases as with
      | nil => simp [addTopLayers]
      | cons a' as =>
          cases bs with
          | nil => simp [addTopLayers]
          | cons b bs =>
              cases bs with
              | nil => simp [addTopLayers]
              | cons b' bs =>
                  cases as with
                  | nil =>
                      cases bs with
                      | nil => simp [addTopLayers]
                      | cons b'' bs =>
                          cases cs with
                          | nil => simp [addTopLayers]
                          | cons c cs =>
                              intro l hl
                              simp only [addTopLayers,List.mem_cons] at hl
                              rcases hl with rfl|hl
                              · exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩
                              · exact ih (b'::b''::bs) cs c l hl
                  | cons a'' as =>
                      cases cs with
                      | nil => simp [addTopLayers]
                      | cons c cs =>
                          intro l hl
                          simp only [addTopLayers,List.mem_cons] at hl
                          rcases hl with rfl|hl
                          · exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩
                          · exact ih (b'::bs) cs c l hl

theorem addTopLayers_length (as bs cs : List Wire) (cin : Wire)
    (hab : as.length=bs.length) (hc : cs.length+2=as.length)
    (two : 2≤as.length) :
    (addTopLayers as bs cs cin).length=cs.length := by
  induction as generalizing bs cs cin with
  | nil => simp at two
  | cons a as ih =>
      cases as with
      | nil => simp at two
      | cons a' as =>
          cases bs with
          | nil => simp at hab
          | cons b bs =>
              cases bs with
              | nil => simp at hab
              | cons b' bs =>
                  cases as with
                  | nil =>
                      have bt : bs=[] := List.eq_nil_of_length_eq_zero (by simpa using hab.symm)
                      subst bs
                      have ct : cs=[] := List.eq_nil_of_length_eq_zero (by
                        simp only [List.length_cons,List.length_nil] at hc
                        omega)
                      subst cs
                      rfl
                  | cons a'' as =>
                      cases cs with
                      | nil => simp at hc
                      | cons c cs =>
                          simp only [addTopLayers,List.length_cons]
                          have tailHab : (a'::a''::as).length=(b'::bs).length := by
                            simpa using hab
                          have tailHc : cs.length+2=(a'::a''::as).length := by
                            simpa using hc
                          have tailTwo : 2≤(a'::a''::as).length := by simp
                          rw [ih (b'::bs) cs c tailHab tailHc tailTwo]

theorem addTopLoan_counts (d : Nat) (roles as bs cs : List Wire) (cin : Wire)
    (hab : as.length=bs.length) (hc : cs.length+2=as.length)
    (hd : d≤cs.length) :
    toffoliCount (addTopLoan d roles as bs cs cin)=
      toffoliCount (Q6LifetimeResearch.addTop as bs cs cin)+d ∧
    measurementCount (addTopLoan d roles as bs cs cin)=
      measurementCount (Q6LifetimeResearch.addTop as bs cs cin)+d := by
  have len := addTopLayers_length as bs cs cin hab hc (by omega)
  have loan := emitLoan_counts d roles (addTopLayers as bs cs cin)
    (addTopTop as bs cs cin) (by omega) (addTopLayers_unit as bs cs cin)
  rw [←addTop_as_sweep] at loan
  simpa only [addTopLoan] using loan







/-! Concrete loaned lifetime-half components. -/








theorem rawAddLoan_counts (d : Nat) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hd : d≤68) :
    toffoliCount (rawAddLoan d L)=
        toffoliCount (Q6LifetimeResearch.rawAdd (base 760) L)+d ∧
    measurementCount (rawAddLoan d L)=
        measurementCount (Q6LifetimeResearch.rawAdd (base 760) L)+d := by
  have w := BalancedCleanup.widths L.toLayout hw
  have ql : (Q6Structural.q6Carry L).length=256 :=
    (Q6StructuralCell.carry_widths L hw).2.2
  have yl : L.ylow.length=255 := hw.2.1
  have rl : L.low.length=255 := w.1
  have cl : ((Q6Structural.q6Carry L).take 255).length=255 := by
    simp [List.length_take,ql]
  have add := addPrefixLoan_counts d retiredRoles
    (L.ylow.drop 1) (L.low.drop 1)
    (((Q6Structural.q6Carry L).take 255).drop 1)
    L.ymsb L.rmsb L.one (((Q6Structural.q6Carry L).take 255).getD 0 0)
    (by simp [yl,rl]) (by simp [yl,cl]) (by simp [cl]; omega)
  constructor
  · simp only [rawAddLoan,Q6LifetimeResearch.rawAdd,Q6LifetimeResearch.move,
      toffoliCount_append,toffoliCount_reverse,(renameProgram_counts _ _).1]
    omega
  · simp only [rawAddLoan,Q6LifetimeResearch.rawAdd,Q6LifetimeResearch.move,
      measurementCount_append,measurementCount_reverse,(renameProgram_counts _ _).2]
    omega

theorem foldLoan_counts (d : Nat) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hd : d≤68) :
    toffoliCount (foldLoan d L)=
        toffoliCount (Q6LifetimeResearch.fold (base 760) L)+d ∧
    measurementCount (foldLoan d L)=
        measurementCount (Q6LifetimeResearch.fold (base 760) L)+d := by
  have w := BalancedCleanup.widths L.toLayout hw
  have bl : (ShortBiasedFold.lowBits L).length=255 :=
    ShortBiasedFold.lowBits_length L
  have ll : L.low.length=255 := w.1
  have cl : (L.carry.take 254).length=254 := by
    simp [List.length_take,hw.2.2]
  have add := mappedAddLoan_counts d retiredRoles (ShortBiasedFold.lowBits L)
    L.low (L.carry.take 254) L.one (by omega) (by omega) (by omega)
  constructor
  · simp only [foldLoan,Q6LifetimeResearch.fold,Q6LifetimeResearch.move,
      toffoliCount_append,(renameProgram_counts _ _).1]
    omega
  · simp only [foldLoan,Q6LifetimeResearch.fold,Q6LifetimeResearch.move,
      measurementCount_append,(renameProgram_counts _ _).2]
    omega

theorem unfoldLoan_counts (d : Nat) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hd : d≤68) :
    toffoliCount (unfoldLoan d L)=
        toffoliCount (Q6LifetimeResearch.unfoldStep (base 760) L)+d ∧
    measurementCount (unfoldLoan d L)=
        measurementCount (Q6LifetimeResearch.unfoldStep (base 760) L)+d := by
  have w := BalancedCleanup.widths L.toLayout hw
  have bl : (ShortBiasedFold.lowBits L).length=255 :=
    ShortBiasedFold.lowBits_length L
  have ll : L.low.length=255 := w.1
  have cl : (L.carry.take 254).length=254 := by
    simp [List.length_take,hw.2.2]
  have add := mappedSubLoan_counts d retiredRoles (ShortBiasedFold.lowBits L)
