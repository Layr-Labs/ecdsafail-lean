/-! ## Layer 1: the half -/

theorem endHalfLoan_run_eq (X Y : Fp) (t : State) (m : List Bool)
    (clean : Q6EndpointCell.Clean base t.basis)
    (self : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y t.basis (centerWord X) (centerWord Y) t.basis)
    (hend : (X+(if t.basis (base 2409) then Y else -Y))/2=Y) :
    run endHalfLoan m t = run (endHalf true) m t := by
  have k : measurementCount (CompareDecoder.cellDecoderNext)=514 := decoder_counts_actual.2
  have dec := CompareDecoder.cellDecoderNext_frame t.basis
    (TerminalGraphEndpoint.clean_decoder base (base 2409) t.basis clean) X Y
    hend t (m.take 514) self
  change (run (CompareDecoder.cellDecoderNext) (m.take 514) t).phase=t.phase ∧ _ at dec
  have m512 : base 512∈Q6EndpointCell.workIds.map base :=
    List.mem_map.mpr ⟨512,by simp [Q6EndpointCell.workIds,List.mem_range'_1],rfl⟩
  have away : base 512∉(Q6EndpointCell.ports base (base 2409)).r ∧
