set_option maxHeartbeats 8000000

namespace ECDSAAdd.Entrant.StairS2

open ECDSAAdd Arithmetic StairField13V3Clean

theorem zt_eraseCarry_self (a b c z : Wire) (s : Bool) : zt z s (eraseCarry a b c z) = true := by
  simp [eraseCarry, zt, tgt, isMeas]

theorem zt_eraseCarry_other (a b c z q : Wire) (s : Bool) (h : z ≠ q) :
    zt q s (eraseCarry a b c z) = s := by
  simp [eraseCarry, zt, tgt, h]

/-- Every carry of a Gidney compare chain is reset (its last write is its own `eraseCarry`). -/
theorem zt_compareChain (ctrl : Option Wire) : ∀ (xs ys cs : List Wire) (cin t q : Wire) (b : Bool),
    xs.length = ys.length → ys.length = cs.length → cs.Nodup → q ∈ cs →
      zt q b (compareChain ctrl xs ys cs cin t) = true := by
  intro xs
  induction xs with
  | nil =>
    intro ys cs cin t q b h1 h2 _ hq
    have : cs = [] := by
      rcases ys with _ | ⟨_, _⟩
      · rcases cs with _ | ⟨_, _⟩
        · rfl
        · simp at h2
      · simp at h1
    subst this
    simp at hq
  | cons a as ih =>
    intro ys cs cin t q b h1 h2 hnd hq
    rcases ys with _ | ⟨y, ys⟩
    · simp at h1
    rcases cs with _ | ⟨c, cs⟩
    · simp at h2
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h1 h2
    obtain ⟨hcn, hnd'⟩ := List.nodup_cons.mp hnd
    simp only [compareChain]
    rw [zt_append]
    by_cases hqc : q = c
    · subst hqc
      exact zt_eraseCarry_self _ _ _ _ _
    · have hq' : q ∈ cs := by
        rcases List.mem_cons.mp hq with e | e
        · exact absurd e hqc
        · exact e
      rw [zt_eraseCarry_other _ _ _ _ _ _ (Ne.symm hqc), zt_append]
      exact ih ys cs c t q _ h1 h2 hnd' hq'

