namespace ECDSAAdd.Entrant.IntegerHigh
open SkywalkNat

/-- Little-endian oddness bits, read from the three-way chronological history. -/
def mask : List Nat → Nat
  | [] => 0
  | l::ls => (if l=0 then 0 else 1)+2*mask ls

theorem mask_lt (ls : List Nat) : mask ls < 2^ls.length := by
  induction ls with
  | nil => decide
  | cons a l ih =>
    simp only [mask,List.length_cons,pow_succ]
    split <;> omega

private theorem letters_length (k : Nat) (z : SkywalkNat.State) : (letters k z).length=k := by
  induction k generalizing z with
  | zero => rfl
  | succ k ih => simp [letters,ih]

/-- Exact division numerator when u is long and the odd v is fixed. -/
theorem left_product (k B s : Nat) (ready : guard k s ≤ B) (odd : s%2=1) :
    let out := step^[k] ⟨B,s⟩
    out.v=s ∧ 2^k*out.u+mask (letters k ⟨B,s⟩)*s=B := by
  induction k generalizing B with
  | zero => simp [mask,letters]
  | succ k ih =>
    have hh : 2*guard k s+s ≤ B := (guard_step ready).1
    have lo : s < B := (guard_step ready).2
    have nz : B ≠ 0 := by omega
    have le : s≤B := by omega
    dsimp only
    rw [Function.iterate_succ_apply]
    by_cases e : B%2=0
    · have st : step ⟨B,s⟩=⟨B/2,s⟩ := by simp [step,nz,e]
      obtain ⟨v,prod⟩ := ih (B/2) (by omega)
      simp only [letters,mask,letter,e,if_true,st,Nat.zero_add,pow_succ]
      exact ⟨v,by nlinarith only [prod,show 2*(B/2)=B by omega]⟩
    · have st : step ⟨B,s⟩=⟨(B-s)/2,s⟩ := by simp [step,nz,e,le]
      obtain ⟨v,prod⟩ := ih ((B-s)/2) (by omega)
      simp only [letters,mask,letter,e,if_false,not_lt.mpr le,Nat.one_ne_zero,st,pow_succ]
      exact ⟨v,by nlinarith only [prod,show 2*((B-s)/2)+s=B by omega]⟩

def remainder (k s : Nat) : Nat := match k with
  | 0 => s
  | k+1 => if s%2=0 then remainder k (s/2) else s

theorem waited (k s : Nat) : 2^(wait k s)*remainder k s=s := by
  induction k generalizing s with
  | zero => simp [wait,remainder]
  | succ k ih =>
    by_cases e : s%2=0
    · simp only [wait,remainder,e,if_true,pow_succ]
      nlinarith only [ih (s/2),show 2*(s/2)=s by omega]
    · simp [wait,remainder,e]

/-- Full signed displacement as a natural-number equality. Comparing the mask
plus 2^(2t) with 2^k therefore selects the direction whenever a crossing occurs. -/
theorem right_product (k B s : Nat) (ready : guard k s ≤ B) (odd : B%2=1) :
    let out := step^[k] ⟨s,B⟩
    let t := wait k s
    let small := remainder k s
    2^k*(out.u+out.v)+(mask (letters k ⟨s,B⟩)+2^(t+t))*small =
      2^t*(B+s)+2^k*small := by
  induction k generalizing s B with
  | zero => simp [wait,remainder,letters,mask,Nat.add_comm]
  | succ k ih =>
    have hh : 2*guard k s+s ≤ B := (guard_step ready).1
    have hg : s < B := (guard_step ready).2
    dsimp only
    rw [Function.iterate_succ_apply]
    by_cases e : s%2=0
    · have st : step ⟨s,B⟩=⟨s/2,B⟩ := by
        by_cases hz : s=0
        · subst s; rfl
        · simp [step,hz,e]
      have gm := guard_mono k (a:=s/2) (b:=s) (by omega)
      have prev := ih B (s/2) (by omega) odd
      have t := waited k (s/2)
      simp only [wait,remainder,e,if_true,letters,mask,letter,st,Nat.zero_add,
        show wait k (s/2)+1+(wait k (s/2)+1)=(wait k (s/2)+wait k (s/2))+1+1 by omega,pow_succ]
      dsimp only at prev
      rw [pow_add] at prev ⊢
      have w : 2^(wait k (s/2)) * (2^(wait k (s/2)) * remainder k (s/2)) =
          2^(wait k (s/2))*(s/2) := congrArg (fun x : Nat => 2^(wait k (s/2))*x) t
      have twice := congrArg (fun x : Nat => 2^(wait k (s/2))*x) (show s=2*(s/2) by omega)
      dsimp only at twice
      nlinarith only [prev,w,twice]
    · have lt : s<B := by omega
      have nz : s≠0 := by omega
      have so : s%2=1 := by omega
      have st : step ⟨s,B⟩=⟨(B-s)/2,s⟩ := by simp [step,nz,e,Nat.not_le.mpr lt]
      obtain ⟨v,prod⟩ := left_product k ((B-s)/2) s (by omega) so
      simp only [wait,remainder,letters,mask,letter,e,if_false,lt,if_true,st,v,
        Nat.reduceEqDiff,Nat.zero_add,pow_zero,one_mul,pow_succ]
      nlinarith only [prod,show 2*((B-s)/2)+s=B by omega]

/-- Convert the scaled correction identity into the digit actually consumed by
the high-bank circuit. P=2^k, Q=2^wait, C is the outgoing bit boundary and U
the incoming one. The crossing bit distinguishes the centre from the sole
possible adjacent digit in the decoded direction. -/
theorem digit {P Q C U A S J x : Nat}
    (p : 0<P) (q : 0<Q) (c : 0<C) (scale : P*C=Q*U)
    (low : 2*U≤A) (high : A<3*U) (maskBound : J<P)
    (short : x<C) (smallInput : Q*x<U)
    (identity : P*S+(J+Q*Q)*x=Q*A+P*x) :
    (S/C=1 ∨ S/C=2 ∨ S/C=3) ∧
    (S/C≠2 → (if P<J+Q*Q then S/C=1 else S/C=3)) := by
  have low' := Nat.mul_le_mul_left Q low
  have high' := Nat.mul_lt_mul_of_pos_left high q
  have room := Nat.mul_lt_mul_of_pos_left short p
  have debt := Nat.mul_lt_mul_of_pos_left smallInput q
  have smallMask := Nat.mul_le_mul_right x (Nat.le_of_lt maskBound)
  have bot : C ≤ S := by
    by_contra! bad
    have bad' := Nat.mul_lt_mul_of_pos_left bad p
    nlinarith only [scale,low',debt,smallMask,identity,bad']
  have top : S < 4*C := by
    by_contra! bad
    have bad' := Nat.mul_le_mul_left P bad
    nlinarith only [scale,high',room,identity,bad',Nat.zero_le ((J+Q*Q)*x)]
  have bot' : 1≤S/C := (Nat.le_div_iff_mul_le c).mpr (by omega)
  have top' : S/C<4 := (Nat.div_lt_iff_lt_mul c).mpr top
  refine ⟨by omega,fun crossed => ?_⟩
  split
  next negative =>
    have neg := Nat.mul_le_mul_right x (Nat.le_of_lt negative)
    have cap : S < 3*C := by
      by_contra! bad
      have bad' := Nat.mul_le_mul_left P bad
      nlinarith only [identity,neg,scale,high',bad']
    have := (Nat.div_lt_iff_lt_mul c).mpr cap
    omega
  next positive =>
    have pos := Nat.mul_le_mul_right x (Nat.le_of_not_gt positive)
    have floor : 2*C ≤ S := by
      by_contra! bad
      have bad' := Nat.mul_lt_mul_of_pos_left bad p
      nlinarith only [identity,pos,scale,low',bad']
    have := (Nat.le_div_iff_mul_le c).mpr floor
    omega

/-- Margin 17 (`A ∈ [U,2U)`): the digit consumed by the high-bank circuit lies in {0,1,2}; off the centre 1 the
crossing bit selects 0 (negative) or 2. Same proof as `digit` with the window moved down by `U`. -/
theorem digit17 {P Q C U A S J x : Nat}
    (p : 0<P) (q : 0<Q) (c : 0<C) (scale : P*C=Q*U)
    (low : U≤A) (high : A<2*U) (_maskBound : J<P)
    (short : x<C) (_smallInput : Q*x<U)
    (identity : P*S+(J+Q*Q)*x=Q*A+P*x) :
    (S/C=0 ∨ S/C=1 ∨ S/C=2) ∧
    (S/C≠1 → (if P<J+Q*Q then S/C=0 else S/C=2)) := by
  have low' := Nat.mul_le_mul_left Q low
  have high' := Nat.mul_lt_mul_of_pos_left high q
  have room := Nat.mul_lt_mul_of_pos_left short p
  have top : S < 3*C := by
    by_contra! bad
    have bad' := Nat.mul_le_mul_left P bad
    nlinarith only [scale,high',room,identity,bad',Nat.zero_le ((J+Q*Q)*x)]
  have top' : S/C<3 := (Nat.div_lt_iff_lt_mul c).mpr top
  have bot' : 0≤S/C := Nat.zero_le _
  refine ⟨by omega,fun crossed => ?_⟩
  split
  next negative =>
    have neg := Nat.mul_le_mul_right x (Nat.le_of_lt negative)
    have cap : S < 2*C := by
      by_contra! bad
      have bad' := Nat.mul_le_mul_left P bad
      nlinarith only [identity,neg,scale,high',bad']
    have := (Nat.div_lt_iff_lt_mul c).mpr cap
    omega
  next positive =>
    have pos := Nat.mul_le_mul_right x (Nat.le_of_not_gt positive)
    have floor : 1*C ≤ S := by
      by_contra! bad
      have bad' := Nat.mul_lt_mul_of_pos_left bad p
      nlinarith only [identity,pos,scale,low',bad']
    have := (Nat.le_div_iff_mul_le c).mpr floor
    omega

theorem right_digit17 (k B s V : Nat) (ready : guard k s ≤ B) (odd : B%2=1)
    (small : s<V) (low : 2^k*V≤B+s) (high : B+s<2*(2^k*V)) :
    let z : SkywalkNat.State := ⟨s,B⟩
    let o := step^[k] z
    let t := wait k s
    let d := (o.u+o.v)/(2^t*V)
    (d=0 ∨ d=1 ∨ d=2) ∧ (d≠1 → if 2^k<mask (letters k z)+2^(t+t) then d=0 else d=2) := by
  dsimp only
  have p := Nat.two_pow_pos k
  have q := Nat.two_pow_pos (wait k s)
  have c := Nat.mul_pos q (show 0<V by omega)
  have w := waited k s
  have sx : remainder k s ≤ s := by
    calc remainder k s ≤ 2^(wait k s)*remainder k s := Nat.le_mul_of_pos_left _ q
         _ = s := w
  have hV := Nat.le_mul_of_pos_left V p
  have hvq := Nat.le_mul_of_pos_left V q
  have h := right_product k B s ready odd
  dsimp only at h
  rw [pow_add] at h ⊢
  exact digit17 p q c (by ring) low high (by simpa [letters_length] using mask_lt (letters k ⟨s,B⟩))
    (by omega) (by omega) h

theorem left_digit17 (k B s V : Nat) (ready : guard k s ≤ B) (odd : s%2=1)
    (small : s<V) (low : 2^k*V≤B+s) (high : B+s<2*(2^k*V)) :
    let out := step^[k] ⟨B,s⟩
    (out.u+out.v)/V=1 ∨ (out.u+out.v)/V=2 := by
  dsimp only
  obtain ⟨v,prod⟩ := left_product k B s ready odd
  have mb : mask (letters k ⟨B,s⟩)<2^k := by simpa [letters_length] using mask_lt (letters k ⟨B,s⟩)
  have maskCost := Nat.mul_le_mul_right s (show mask (letters k ⟨B,s⟩)+1 ≤ 2^k by omega)
  have pos := Nat.two_pow_pos k
  have vpos : 0<V := by omega
  have cap := Nat.mul_lt_mul_of_pos_left small pos
  rw [v]
  have lo : 1*V≤(step^[k] ⟨B,s⟩).u+s := by
    by_contra! h
    have hh := Nat.mul_lt_mul_of_pos_left h pos
    nlinarith only [hh,prod,low,maskCost]
  have hi : (step^[k] ⟨B,s⟩).u+s<3*V := by
    by_contra! h
    have hh := Nat.mul_le_mul_left (2^k) h
    nlinarith only [hh,prod,high,cap,Nat.zero_le (mask (letters k ⟨B,s⟩)*s),Nat.zero_le s]
  have := (Nat.le_div_iff_mul_le vpos).mpr lo
  have := (Nat.div_lt_iff_lt_mul vpos).mpr hi
  omega

theorem right_digit (k B s V : Nat) (ready : guard k s ≤ B) (odd : B%2=1)
    (small : s<V) (low : 2*(2^k*V)≤B+s) (high : B+s<3*(2^k*V)) :
    let z : SkywalkNat.State := ⟨s,B⟩
    let o := step^[k] z
    let t := wait k s
    let d := (o.u+o.v)/(2^t*V)
    (d=1 ∨ d=2 ∨ d=3) ∧ (d≠2 → if 2^k<mask (letters k z)+2^(t+t) then d=1 else d=3) := by
  dsimp only
  have p := Nat.two_pow_pos k
  have q := Nat.two_pow_pos (wait k s)
  have c := Nat.mul_pos q (show 0<V by omega)
  have w := waited k s
  have sx : remainder k s ≤ s := by
    calc remainder k s ≤ 2^(wait k s)*remainder k s := Nat.le_mul_of_pos_left _ q
         _ = s := w
  have hV := Nat.le_mul_of_pos_left V p
  have hvq := Nat.le_mul_of_pos_left V q
  have h := right_product k B s ready odd
  dsimp only at h
  rw [pow_add] at h ⊢
  exact digit p q c (by ring) low high (by simpa [letters_length] using mask_lt (letters k ⟨s,B⟩))
    (by omega) (by omega) h

theorem left_digit (k B s V : Nat) (ready : guard k s ≤ B) (odd : s%2=1)
    (small : s<V) (low : 2*(2^k*V)≤B+s) (high : B+s<3*(2^k*V)) :
    let out := step^[k] ⟨B,s⟩
    (out.u+out.v)/V=2 ∨ (out.u+out.v)/V=3 := by
  dsimp only
  obtain ⟨v,prod⟩ := left_product k B s ready odd
  have mb : mask (letters k ⟨B,s⟩)<2^k := by simpa [letters_length] using mask_lt (letters k ⟨B,s⟩)
  have maskCost := Nat.mul_le_mul_right s (show mask (letters k ⟨B,s⟩)+1 ≤ 2^k by omega)
  have pos := Nat.two_pow_pos k
  have vpos : 0<V := by omega
  have cap := Nat.mul_lt_mul_of_pos_left small pos
  rw [v]
  have lo : 2*V≤(step^[k] ⟨B,s⟩).u+s := by
    by_contra! h
    have hh := Nat.mul_lt_mul_of_pos_left h pos
    nlinarith only [hh,prod,low,maskCost]
  have hi : (step^[k] ⟨B,s⟩).u+s<4*V := by
    by_contra! h
    have hh := Nat.mul_le_mul_left (2^k) h
    nlinarith only [hh,prod,high,cap,Nat.zero_le (mask (letters k ⟨B,s⟩)*s),Nat.zero_le s]
  have := (Nat.le_div_iff_mul_le vpos).mpr lo
  have := (Nat.div_lt_iff_lt_mul vpos).mpr hi
  omega

end ECDSAAdd.Entrant.IntegerHigh

