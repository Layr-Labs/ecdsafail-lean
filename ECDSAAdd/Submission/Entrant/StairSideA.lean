/-! ## Soundness and its composition -/


theorem sound_append {P Q : Program} (hP : Sound P) (hQ : Sound Q) :
    Sound (P ++ Q) :=
  ⟨(gatePhysical_append P Q).mpr ⟨hP.physical, hQ.physical⟩,
    good_append.mpr ⟨hP.good, hQ.good⟩⟩

theorem sound_rename (f : Wire → Wire) (inj : Function.Injective f)
    (hf : ∀ q, InDom q → InDom (f q)) {P : Program} (hP : Sound P) :
    Sound (renameProgram f P) :=
  ⟨gatePhysical_rename f inj P hP.physical, good_rename f hf hP.good⟩

theorem gp_left {P Q : Program} (h : GatePhysical (P ++ Q)) : GatePhysical P :=
  ((gatePhysical_append P Q).mp h).1

theorem gp_right {P Q : Program} (h : GatePhysical (P ++ Q)) : GatePhysical Q :=
  ((gatePhysical_append P Q).mp h).2

theorem unrename_physical (f : Wire → Wire) (P : Program)
    (hp : GatePhysical (renameProgram f P)) : GatePhysical P := by
  intro i hi
  have h := hp (renameInstr f i) (List.mem_map.mpr ⟨i, hi, rfl⟩)
  cases i with
  | X _ => trivial
  | CX _ _ => exact fun e => h (congrArg f e)
  | CCX _ _ _ =>
      exact ⟨fun e => h.1 (congrArg f e),
        fun e => h.2 (congrArg f e)⟩
  | measureX _ _ _ => trivial

theorem sound_sig (i : Nat) (hi : i < 512) {P : Program} (hP : Sound P) :
    Sound (renameProgram (OB5.sig i) P) :=
  sound_rename _ (OB5.sig_injective i (by omega)) (indom_sig i (by omega)) hP

theorem sound_borrow {P : Program} (hP : Sound P) :
    Sound (renameProgram Prefix1590.borrow P) :=
  sound_rename _ Prefix1590.borrow.injective indom_borrow hP

theorem sound_phaseHost {P : Program} (hP : Sound P) :
    Sound (renameProgram Rolling1588Lifetime.phaseHost P) :=
  sound_rename _ Rolling1588Lifetime.phaseHost.injective indom_phaseHost hP

theorem sound_fieldRename {P : Program} (hP : Sound P) :
    Sound (StairSchedule.fieldRename P) :=
  ⟨gatePhysical_rename _ (Equiv.swap
      FrontierEntry1591Field.work FrontierEntry1591Field.host).injective _
      (gatePhysical_rename _ HostOB5.hostSwap_injective _ hP.physical),
    good_fieldRename hP.good⟩

theorem sound_rebindMany (roles hosts : List Wire) {P : Program}
    (hr : ∀ r ∈ roles, InDom r) (hh : ∀ q ∈ hosts, InDom q) (hP : Sound P) :
    Sound (StairLoan.rebindMany roles hosts P) :=
  ⟨StairLoan.rebindMany_physical roles hosts P hP.physical,
    good_rebindMany roles hosts P hr hh hP.good⟩

theorem exclusiveRoles_indom : ∀ r ∈ StairSchedule.exclusiveRoles, InDom r := by
  decide +kernel

theorem exclusiveRoles_drop_indom (d : Nat) :
    ∀ r ∈ StairSchedule.exclusiveRoles.drop d, InDom r :=
  fun r hr => exclusiveRoles_indom r (List.mem_of_mem_drop hr)

/-! ## Record pieces -/






theorem recordReverse_physical (isA : Bool) (i n : Nat)
    (bound : i + n ≤ 512) :
    GatePhysical (Rolling1588.reverse isA i n) := by
  induction n generalizing i with
  | zero => simp [Rolling1588.reverse, GatePhysical]
  | succ n ih =>
      have unpack : GatePhysical (Rolling1588.unpackAtTick isA i) := by
        rw [← Rolling1588.Integer.unpackFirst_base]
        exact unpackFirst_physical base base_pool_nodup isA i (by omega)
      simp only [Rolling1588.reverse, gatePhysical_append]
      exact ⟨ih (i + 1) (by omega),
        gatePhysical_rename _ (OB5.sig_injective i (by omega)) _
          ((gatePhysical_append _ _).mpr
            ⟨unpack,
              W.ReverseCarry.compactReceiverTick_physical base i
                (by omega) base_pool_nodup⟩)⟩

/-- Record packet write at letter `f` (inside a segment). -/
theorem sound_packAt (f : Nat) (h5 : 5 < f) (hf : f < 512) :
    Sound (renameProgram (OB5.sig f) (Rolling1588.Integer.packFirst base true f)) :=
  ⟨gatePhysical_rename _ (OB5.sig_injective f (by omega)) _
      (packFirst_physical base base_pool_nodup true f hf),
    good_rename _ (indom_sig f (by omega))
      (good_packFirst base f h5 hf base_history_indom)⟩

/-- Record packet read at letter `f` (inside a reverse segment). -/
theorem sound_unpackAt (f : Nat) (h5 : 5 < f) (hf : f < 512) :
    Sound (renameProgram (OB5.sig f) (Rolling1588.unpackAtTick true f)) := by
  rw [← Rolling1588.Integer.unpackFirst_base]
  exact ⟨gatePhysical_rename _ (OB5.sig_injective f (by omega)) _
      (unpackFirst_physical base base_pool_nodup true f hf),
    good_rename _ (indom_sig f (by omega))
      (good_unpackFirst base f h5 hf base_history_indom)⟩











theorem sound_hostedX : Sound StairSchedule.hostedX :=
  ⟨by simp [StairSchedule.hostedX, GatePhysical, PhysicalInstr, ProperGate],
    rec_hostedX⟩

theorem append_middle_physical (A B C : Program)
    (h : GatePhysical (A ++ B ++ C)) : GatePhysical B :=
  gp_right (gp_left h)

theorem append_middle_right_physical (A B C : Program)
    (h : GatePhysical (A ++ (B ++ C))) : GatePhysical B :=
  gp_left (gp_right h)

theorem recordEntryField_physical :
    GatePhysical Rolling1588.entryField := by
  have h := Rolling1588.entryFieldHosted_physical
  have transported : GatePhysical
      (ParityHostTransport5.program FrontierEntry1591Field.work
        FrontierEntry1591Field.host
        (FrontierEntry1591Field.hosted Rolling1588.entryField)) := by
    rw [Rolling1588.entryFieldHosted, ParityField1591.program] at h
    exact append_middle_physical _ _ _ h
  have hosted : GatePhysical
      (FrontierEntry1591Field.hosted Rolling1588.entryField) := by
    rw [ParityHostTransport5.program] at transported
    exact unrename_physical
      (Equiv.swap FrontierEntry1591Field.work
        FrontierEntry1591Field.host)
      (FrontierEntry1591Field.hosted Rolling1588.entryField)
      transported
  have placed : GatePhysical
      (renameProgram HostOB5.hostSwap Rolling1588.entryField) := by
    rw [FrontierEntry1591Field.hosted] at hosted
    exact append_middle_right_physical _ _ _ hosted
  exact unrename_physical HostOB5.hostSwap Rolling1588.entryField placed

theorem recordExitField_physical :
    GatePhysical Rolling1588.exitField := by
  have h := Rolling1588.exitFieldHosted_physical
  have transported : GatePhysical
      (ParityHostTransport5.program FrontierEntry1591Field.work
        FrontierEntry1591Field.host
        (FrontierEntry1591Field.hosted Rolling1588.exitField)) := by
    rw [Rolling1588.exitFieldHosted, ParityField1591.program] at h
    exact append_middle_physical _ _ _ h
  have hosted : GatePhysical
      (FrontierEntry1591Field.hosted Rolling1588.exitField) := by
    rw [ParityHostTransport5.program] at transported
    exact unrename_physical
      (Equiv.swap FrontierEntry1591Field.work
        FrontierEntry1591Field.host)
      (FrontierEntry1591Field.hosted Rolling1588.exitField)
      transported
  have placed : GatePhysical
      (renameProgram HostOB5.hostSwap Rolling1588.exitField) := by
    rw [FrontierEntry1591Field.hosted] at hosted
    exact append_middle_right_physical _ _ _ hosted
  exact unrename_physical HostOB5.hostSwap Rolling1588.exitField placed


/-! ## Loaned packet groups (from the field-9 antecedent's support) -/

theorem swapBody_physical : GatePhysical FrontierSW1591.swapBody := by
  have old := Prefix1590.firstBody_physical true
  simp only [Prefix1590.firstBody, G0CarryLoan5.program,
    gatePhysical_append] at old
  have body : GatePhysical (FrontierSW1591.firstBodyS true) :=
    unrename_physical (Equiv.swap (base 768) (base 0))
      (FrontierSW1591.firstBodyS true) old.1.2
  simp only [FrontierSW1591.firstBodyS, if_true,
    gatePhysical_append] at body
  have firstSwap : GatePhysical FrontierSW1591.firstSwapS := body.1
  simp only [FrontierSW1591.firstSwapS, SW.selW,
    gatePhysical_append] at firstSwap
  exact firstSwap.1.2

theorem selected_physical (source flag : Wire) (P : Program)
    (away : source ≠ flag) (physical : GatePhysical P) :
    GatePhysical (SW.selW source flag P) := by
  have first : GatePhysical [.CX source flag] := by
    simp [GatePhysical, PhysicalInstr, ProperGate, away]
  have last : GatePhysical [.measureX flag [] [.Z source]] := by
    simp [GatePhysical, PhysicalInstr]
  simpa only [SW.selW, gatePhysical_append] using
    And.intro (And.intro first physical) last

theorem loanHalfWindow_physical (divide : Bool)
    (d j active hole : Nat) (hj : j < 102) (ha : active < 5) :
    GatePhysical (StairGroups.halfWindow divide d j active hole) := by
  apply ControlLoan1589.loanWindow_physical
  · exact HostOB5.host_ne _ _ (by omega)
  · exact gatePhysical_rename _
      (Equiv.swap (base 719) (Rolling1588.s j hole)).injective _
      (by
        simpa only [StairLoanAdapter.concreteHalf760Loan] using
          StairLoanSupport.half760Loan_physical d divide)

theorem loanCell_physical (divide : Bool)
    (d j active hole : Nat) (hj : j < 102) (ha : active < 5) :
    GatePhysical (StairGroups.cell divide d j active hole) := by
  have half := loanHalfWindow_physical divide d j active hole hj ha
  have swap := selected_physical (Rolling1588.s j active) (base 2409)
    FrontierSW1591.swapBody (HostOB5.host_ne _ _ (by omega))
      swapBody_physical
  cases divide <;>
    simp only [StairGroups.cell, Bool.false_eq_true, if_false, if_true,
      gatePhysical_append]
  · exact ⟨swap, half⟩
  · exact ⟨half, swap⟩

theorem onPacket_physical (j : Nat) (hj : j < 102)
    (P : Program) (support : wires P ⊆ Finset.range 10)
    (physical : GatePhysical P) :
    GatePhysical (Rolling1588.onPacket j P) :=
  gatePhysical_rename_support _ P
    (fun a ha b hb eq =>
      FirstNonzeroCodec.label_inj'
        (History5.historyMap base (5 * j))
        (History5.historyMap_injective base base_pool_nodup
          (5 * j) (by omega))
        a (support ha) b (support hb) eq) physical

theorem stage_physical :
    GatePhysical Rolling1588.stageOpen ∧
    GatePhysical Rolling1588.stageClose ∧
    ∀ divide k, k < 2 →
      GatePhysical (Rolling1588.stageTransition divide k) := by
  refine ⟨?_, ?_, ?_⟩
  · apply physicalGateCheck_correct
    decide +kernel
  · apply physicalGateCheck_correct
    decide +kernel
  · intro divide k hk
    apply physicalGateCheck_correct
    cases divide <;> interval_cases k <;> decide +kernel

theorem loanBasePacket_physical (divide : Bool)
    (d j : Nat) (hj : j < 102) :
    GatePhysical (StairGroups.basePacket divide d j) := by
  have opening := onPacket_physical j hj
    Rolling1588.stageOpen Rolling1588.stageOpen_support stage_physical.1
  have closing := onPacket_physical j hj
    Rolling1588.stageClose Rolling1588.stageClose_support stage_physical.2.1
  have transfer (b : Bool) (k : Nat) (hk : k < 2) :=
    onPacket_physical j hj (Rolling1588.stageTransition b k)
      (Rolling1588.stageTransition_support b k hk)
      (stage_physical.2.2 b k hk)
  have cellAt (k : Nat) (hk : k < 5) :=
    loanCell_physical divide d j k 2 hj hk
  cases divide <;>
    simp only [StairGroups.basePacket, Rolling1588.stageOpen,
      Rolling1588.stageClose, Bool.false_eq_true, if_false, if_true,
      gatePhysical_append]
  all_goals repeat' apply And.intro
  all_goals first
    | exact opening
    | exact closing
    | exact transfer false 0 (by decide)
    | exact transfer false 1 (by decide)
    | exact transfer true 0 (by decide)
    | exact transfer true 1 (by decide)
    | exact cellAt 3 (by decide)
    | exact cellAt 4 (by decide)

theorem loanGroups_physical (divide : Bool)
    (d first count : Nat) (bound : first + count ≤ 102) :
    GatePhysical (StairGroups.groups divide d first count) := by
  induction count generalizing first with
  | zero => simp [StairGroups.groups, PacketSequence.program, GatePhysical]
  | succ count ih =>
      have head : GatePhysical (StairGroups.packet divide d first) :=
        gatePhysical_rename _ (shifted (Placement5.pi first)).injective _
          (loanBasePacket_physical divide d first (by omega))
      have rest := ih (first + 1) (by omega)
      cases divide <;>
        simp only [StairGroups.groups, PacketSequence.program,
          Bool.false_eq_true, if_false, if_true, gatePhysical_append] at rest ⊢
      · exact ⟨rest, head⟩
      · exact ⟨head, rest⟩


