/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSlotsLib_at_StairSideA` -/
section Merge_StairSlotsLib_at_StairSideA

/-!
# Plan-independent gate-slot lemmas

The reusable part of the field-11 slot ledger (`StairSlots`), separated from
the eight-row schedule so that it survives re-plans of the checkpoint table:
loan and group slot bounds, the endpoint loan, wire-blind tick and moved-walk
slot equalities, and additivity of the record walks and packet groups.
Every statement is about generic programs or record programs; nothing here
refers to a checkpoint table, a host plan, or a concrete assembly.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSlotsLib

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines

attribute [local irreducible] StairEndpoint.endHalfLoan68 StairEndpoint.rawEndLoan68 StairEndpoint.endPacketLoan68 StairEndpoint.endPacket760Loan68 Rolling1588Lifetime.endHalf Rolling1588Lifetime.rawEnd Rolling1588Lifetime.endPacket R2SqEp760.endPacket760

theorem rebindMany_slots (roles hosts : List Wire) (P : Program) :
    gateSlots (StairLoan.rebindMany roles hosts P) = gateSlots P := by
  induction roles generalizing hosts with
  | nil => rfl
  | cons r roles ih =>
      cases hosts with
      | nil => rfl
      | cons h hosts =>
          simp only [StairLoan.rebindMany, rename_gateSlots, ih]

def SlotUnit (l : StairLoan.CarryLayer) : Prop :=
  gateSlots l.up <= 8 ∧ gateSlots l.erase <= 6

def SlotUnit10 (l : StairLoan.CarryLayer) : Prop :=
  gateSlots l.up <= 6 ∧ gateSlots l.erase <= 4

theorem emitUps_slots_le (ls : List StairLoan.CarryLayer)
    (h : ∀ l ∈ ls, SlotUnit l) :
    gateSlots (StairLoan.emitUps ls) <= 8 * ls.length := by
  induction ls with
  | nil => simp [StairLoan.emitUps, gateSlots]
  | cons l ls ih =>
      have head := (h l (by simp)).1
      have tail := ih (by
        intro x hx
        exact h x (by simp [hx]))
      simp only [StairLoan.emitUps, gateSlots_append, List.length_cons]
      omega

theorem emitErases_slots_le (ls : List StairLoan.CarryLayer)
    (h : ∀ l ∈ ls, SlotUnit l) :
    gateSlots (StairLoan.emitErases ls) <= 6 * ls.length := by
  induction ls with
  | nil => simp [StairLoan.emitErases, gateSlots]
  | cons l ls ih =>
      have head := (h l (by simp)).2
      have tail := ih (by
        intro x hx
        exact h x (by simp [hx]))
      simp only [StairLoan.emitErases, gateSlots_append, List.length_cons]
      omega

theorem emitLoan_slots_le (d : Nat) (roles : List Wire)
    (ls : List StairLoan.CarryLayer) (top : Program)
    (hd : d <= ls.length) (h : ∀ l ∈ ls, SlotUnit l) :
    gateSlots (StairLoan.emitLoan d roles ls top) <=
      gateSlots (StairLoan.emitSweep ls top) + 14 * d := by
  have borrowed : ∀ l ∈ ls.take d, SlotUnit l := by
    intro l hl
    exact h l (List.mem_of_mem_take hl)
  have up := emitUps_slots_le (ls.take d) borrowed
  have erase := emitErases_slots_le (ls.take d) borrowed
  have len : (ls.take d).length = d := by
    simp [List.length_take, Nat.min_eq_left hd]
  rw [StairLoan.emitSweep_split (d + 1)]
  simp only [StairLoan.emitLoan, gateSlots_append, rebindMany_slots]
  rw [len] at up erase
  omega

theorem emitUps_slots_le6 (ls : List StairLoan.CarryLayer)
    (h : ∀ l ∈ ls, SlotUnit10 l) :
    gateSlots (StairLoan.emitUps ls) <= 6 * ls.length := by
  induction ls with
  | nil => simp [StairLoan.emitUps, gateSlots]
  | cons l ls ih =>
      have head := (h l (by simp)).1
      have tail := ih (by
        intro x hx
        exact h x (by simp [hx]))
      simp only [StairLoan.emitUps, gateSlots_append, List.length_cons]
      omega

theorem emitErases_slots_le4 (ls : List StairLoan.CarryLayer)
    (h : ∀ l ∈ ls, SlotUnit10 l) :
    gateSlots (StairLoan.emitErases ls) <= 4 * ls.length := by
  induction ls with
  | nil => simp [StairLoan.emitErases, gateSlots]
  | cons l ls ih =>
      have head := (h l (by simp)).2
      have tail := ih (by
        intro x hx
        exact h x (by simp [hx]))
      simp only [StairLoan.emitErases, gateSlots_append, List.length_cons]
      omega

theorem emitLoan_slots_le10 (d : Nat) (roles : List Wire)
    (ls : List StairLoan.CarryLayer) (top : Program)
    (hd : d <= ls.length) (h : ∀ l ∈ ls, SlotUnit10 l) :
    gateSlots (StairLoan.emitLoan d roles ls top) <=
      gateSlots (StairLoan.emitSweep ls top) + 10 * d := by
  have borrowed : ∀ l ∈ ls.take d, SlotUnit10 l := by
    intro l hl
    exact h l (List.mem_of_mem_take hl)
  have up := emitUps_slots_le6 (ls.take d) borrowed
  have erase := emitErases_slots_le4 (ls.take d) borrowed
  have len : (ls.take d).length = d := by
    simp [List.length_take, Nat.min_eq_left hd]
  rw [StairLoan.emitSweep_split (d + 1)]
  simp only [StairLoan.emitLoan, gateSlots_append, rebindMany_slots]
  rw [len] at up erase
  omega

theorem majority_slots_le (a b cin c : Wire) :
    gateSlots (majority a b cin c) <= 8 := by
  simp [majority, gateSlots, instructionSlots]

theorem eraseCarry_slots_le (a b cin c : Wire) :
    gateSlots (eraseCarry a b cin c) <= 6 := by
  simp [eraseCarry, gateSlots, instructionSlots]

theorem mappedLayers_slotUnit (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire) :
    ∀ l ∈ StairLoan.mappedLayers bits ys cs cin, SlotUnit l := by
  induction bits generalizing ys cs cin with
  | nil => simp [StairLoan.mappedLayers]
  | cons b bits ih =>
      cases bits with
      | nil => simp [StairLoan.mappedLayers]
      | cons b' bits =>
          cases ys with
          | nil => simp [StairLoan.mappedLayers]
          | cons y ys =>
              cases ys with
              | nil => simp [StairLoan.mappedLayers]
              | cons y' ys =>
                  cases cs with
                  | nil => simp [StairLoan.mappedLayers]
                  | cons c cs =>
                      intro l hl
                      simp only [StairLoan.mappedLayers, List.mem_cons] at hl
                      rcases hl with rfl | hl
                      · exact ⟨StairLoan.mappedMajority_slots_le b y cin c,
                          StairLoan.mappedEraseCarry_slots_le b y cin c⟩
                      · exact ih (y' :: ys) cs c l hl

def MappedUnit10 (b : MappedBit) : Prop :=
  ∀ y cin target,
    gateSlots (mappedMajority b y cin target) <= 6 ∧
      gateSlots (mappedEraseCarry b y cin target) <= 4

theorem mappedConstantBit_some_unit10 (q : Wire) (value : Bool) :
    MappedUnit10 (mappedConstantBit (some q) value) := by
  intro y cin target
  cases value <;>
    simp [MappedUnit10, mappedConstantBit, mappedMajority,
      mappedEraseCarry, majority, eraseCarry, gateSlots, instructionSlots]

theorem mappedConstant_some_units10 (q : Wire) (n k : Nat) :
    ∀ b ∈ mappedConstant (some q) n k, MappedUnit10 b := by
  induction n generalizing k with
  | zero => simp [mappedConstant]
  | succ n ih =>
      intro b hb
      simp only [mappedConstant, List.mem_cons] at hb
      rcases hb with rfl | hb
      · exact mappedConstantBit_some_unit10 q _
      · exact ih (k / 2) b hb

theorem mappedLayers_slotUnit10 (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hbits : ∀ b ∈ bits, MappedUnit10 b) :
    ∀ l ∈ StairLoan.mappedLayers bits ys cs cin, SlotUnit10 l := by
  induction bits generalizing ys cs cin with
  | nil => simp [StairLoan.mappedLayers]
  | cons b bits ih =>
      cases bits with
      | nil => simp [StairLoan.mappedLayers]
      | cons b' bits =>
          cases ys with
          | nil => simp [StairLoan.mappedLayers]
          | cons y ys =>
              cases ys with
              | nil => simp [StairLoan.mappedLayers]
              | cons y' ys =>
                  cases cs with
                  | nil => simp [StairLoan.mappedLayers]
                  | cons c cs =>
                      intro l hl
                      simp only [StairLoan.mappedLayers, List.mem_cons] at hl
                      rcases hl with rfl | hl
                      · exact hbits b (by simp) y cin c
                      · apply ih (y' :: ys) cs c
                        · intro x hx
                          exact hbits x (by simp [hx])
                        · exact hl

theorem prefixLayers_slotUnit (xs ys carry : List Wire)
    (a t z cin : Wire) :
    ∀ l ∈ StairLoan.prefixLayers xs ys carry a t z cin, SlotUnit l := by
  induction xs generalizing ys carry cin with
  | nil => simp [StairLoan.prefixLayers]
  | cons x xs ih =>
      cases ys with
      | nil => simp [StairLoan.prefixLayers]
      | cons y ys =>
          cases carry with
          | nil => simp [StairLoan.prefixLayers]
          | cons c cs =>
              intro l hl
              simp only [StairLoan.prefixLayers, List.mem_cons] at hl
              rcases hl with rfl | hl
              · exact ⟨majority_slots_le x y cin c,
                  eraseCarry_slots_le x y cin c⟩
              · exact ih ys cs c l hl

theorem compareLayers_slotUnit (forward : Bool) (as bs cs : List Wire)
    (cin target : Wire) :
    ∀ l ∈ StairLoan.compareLayers forward as bs cs cin target, SlotUnit l := by
  induction as generalizing bs cs cin with
  | nil => simp [StairLoan.compareLayers]
  | cons a as ih =>
      cases as with
      | nil => simp [StairLoan.compareLayers]
      | cons a' as =>
          cases bs with
          | nil => simp [StairLoan.compareLayers]
          | cons b bs =>
              cases bs with
              | nil => simp [StairLoan.compareLayers]
              | cons b' bs =>
                  cases cs with
                  | nil => simp [StairLoan.compareLayers]
                  | cons c cs =>
                      intro l hl
                      simp only [StairLoan.compareLayers, List.mem_cons] at hl
                      rcases hl with rfl | hl
                      · exact ⟨majority_slots_le a b cin c,
                          eraseCarry_slots_le a b cin c⟩
                      · exact ih (b' :: bs) cs c l hl

theorem addTopLayers_slotUnit (as bs cs : List Wire) (cin : Wire) :
    ∀ l ∈ StairLoan.addTopLayers as bs cs cin, SlotUnit l := by
  induction as generalizing bs cs cin with
  | nil => simp [StairLoan.addTopLayers]
  | cons a as ih =>
      cases as with
      | nil => simp [StairLoan.addTopLayers]
      | cons a' as =>
          cases bs with
          | nil => simp [StairLoan.addTopLayers]
          | cons b bs =>
              cases bs with
              | nil => simp [StairLoan.addTopLayers]
              | cons b' bs =>
                  cases as with
                  | nil =>
                      cases bs with
                      | nil => simp [StairLoan.addTopLayers]
                      | cons b'' bs =>
                          cases cs with
                          | nil => simp [StairLoan.addTopLayers]
                          | cons c cs =>
                              intro l hl
                              simp only [StairLoan.addTopLayers, List.mem_cons] at hl
                              rcases hl with rfl | hl
                              · exact ⟨majority_slots_le a b cin c,
                                  eraseCarry_slots_le a b cin c⟩
                              · exact ih (b' :: b'' :: bs) cs c l hl
                  | cons a'' as =>
                      cases cs with
                      | nil => simp [StairLoan.addTopLayers]
                      | cons c cs =>
                          intro l hl
                          simp only [StairLoan.addTopLayers, List.mem_cons] at hl
                          rcases hl with rfl | hl
                          · exact ⟨majority_slots_le a b cin c,
                              eraseCarry_slots_le a b cin c⟩
                          · exact ih (b' :: bs) cs c l hl

theorem mappedAddLoan_slots_le (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d <= cs.length) :
    gateSlots (StairLoan.mappedAddLoan d roles bits ys cs cin) <=
      gateSlots (mappedAdd bits ys cs cin) + 14 * d := by
  have len := StairLoan.mappedLayers_length bits ys cs cin hb hc
  have bound := emitLoan_slots_le d roles
    (StairLoan.mappedLayers bits ys cs cin)
    (StairLoan.mappedTop bits ys cs cin) (by omega)
    (mappedLayers_slotUnit bits ys cs cin)
  rw [← StairLoan.mappedAdd_as_sweep] at bound
  simpa only [StairLoan.mappedAddLoan] using bound

theorem mappedSubLoan_slots_le (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d <= cs.length) :
    gateSlots (StairLoan.mappedSubLoan d roles bits ys cs cin) <=
      gateSlots (mappedSub bits ys cs cin) + 14 * d := by
  have h := mappedAddLoan_slots_le d roles bits ys cs cin hb hc hd
  simp only [StairLoan.mappedSubLoan, mappedSub, gateSlots_append] at h ⊢
  omega

theorem mappedAddLoan_some_slots_le (d : Nat) (roles : List Wire)
    (q : Wire) (n k : Nat) (ys cs : List Wire) (cin : Wire)
    (hb : (mappedConstant (some q) n k).length = ys.length)
    (hc : cs.length + 1 = ys.length) (hd : d <= cs.length) :
    gateSlots (StairLoan.mappedAddLoan d roles
        (mappedConstant (some q) n k) ys cs cin) <=
      gateSlots (mappedAdd (mappedConstant (some q) n k) ys cs cin) +
        10 * d := by
  have len := StairLoan.mappedLayers_length
    (mappedConstant (some q) n k) ys cs cin hb hc
  have bound := emitLoan_slots_le10 d roles
    (StairLoan.mappedLayers (mappedConstant (some q) n k) ys cs cin)
    (StairLoan.mappedTop (mappedConstant (some q) n k) ys cs cin)
    (by omega)
    (mappedLayers_slotUnit10 (mappedConstant (some q) n k) ys cs cin
      (mappedConstant_some_units10 q n k))
  rw [← StairLoan.mappedAdd_as_sweep] at bound
  simpa only [StairLoan.mappedAddLoan] using bound

theorem mappedSubLoan_some_slots_le (d : Nat) (roles : List Wire)
    (q : Wire) (n k : Nat) (ys cs : List Wire) (cin : Wire)
    (hb : (mappedConstant (some q) n k).length = ys.length)
    (hc : cs.length + 1 = ys.length) (hd : d <= cs.length) :
    gateSlots (StairLoan.mappedSubLoan d roles
        (mappedConstant (some q) n k) ys cs cin) <=
      gateSlots (mappedSub (mappedConstant (some q) n k) ys cs cin) +
        10 * d := by
  have h := mappedAddLoan_some_slots_le d roles q n k ys cs cin hb hc hd
  simp only [StairLoan.mappedSubLoan, mappedSub, gateSlots_append] at h ⊢
  omega

/-- The mapped encoding selected by a positive literal loan is no more
expensive than the record's specialized literal cells. -/
theorem mappedConstant_add_slots_le (xs carry : List Wire)
    (cin one : Wire) (k : Nat) :
    gateSlots (mappedAdd (mappedConstant none xs.length k) xs carry cin) <=
      gateSlots (literalConstAdd xs carry cin one k) := by
  induction xs generalizing carry cin k with
  | nil => simp [mappedConstant, mappedAdd, literalConstAdd, gateSlots]
  | cons x xs ih =>
      cases xs with
      | nil =>
          by_cases bit : k % 2 = 1 <;>
            simp [mappedConstant, mappedConstantBit, mappedAdd, literalConstAdd,
              mappedSum, literalConstSum, gateSlots, instructionSlots, bit]
      | cons x' xs =>
          cases carry with
          | nil => simp [mappedConstant, mappedAdd, literalConstAdd, gateSlots]
          | cons c cs =>
              have rest := ih cs c (k / 2)
              by_cases bit : k % 2 = 1
              · simp [mappedConstant, mappedConstantBit, mappedAdd,
                  literalConstAdd, mappedMajority, mappedEraseCarry,
                  mappedSum, literalConstStep, literalConstSum,
                  literalConstCarry, literalConstErase, bit,
                  gateSlots_append, gateSlots, instructionSlots] at rest ⊢
                omega
              · simp [mappedConstant, mappedConstantBit, mappedAdd,
                  literalConstAdd, mappedMajority, mappedEraseCarry,
                  mappedSum, literalConstStep, literalConstSum,
                  literalConstCarry, literalConstErase, bit,
                  gateSlots_append, gateSlots, instructionSlots] at rest ⊢
                omega

theorem literalConstAddLoan_slots_le (d : Nat) (roles xs carry : List Wire)
    (cin one : Wire) (k : Nat) (hc : carry.length + 1 = xs.length)
    (hd : d <= carry.length) :
    gateSlots (StairLoan.literalConstAddLoan d roles xs carry cin one k) <=
      gateSlots (literalConstAdd xs carry cin one k) + 14 * d := by
  cases d with
  | zero => simp [StairLoan.literalConstAddLoan]
  | succ d =>
      have bits : (mappedConstant none xs.length k).length = xs.length :=
        mappedConstant_length none xs.length k
      have loan := mappedAddLoan_slots_le (d + 1) roles
        (mappedConstant none xs.length k) xs carry cin bits hc hd
      have mapped := mappedConstant_add_slots_le xs carry cin one k
      simp only [StairLoan.literalConstAddLoan, Nat.succ_ne_zero, if_false]
      omega

theorem addPrefixLoan_slots_le (d : Nat) (roles xs ys carry : List Wire)
    (a t z cin : Wire) (hy : ys.length = xs.length)
    (hc : carry.length = xs.length) (hd : d <= carry.length) :
