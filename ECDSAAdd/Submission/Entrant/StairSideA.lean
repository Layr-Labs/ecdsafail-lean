/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanRecordExit_at_StairSideA` -/
section Merge_StairLoanRecordExit_at_StairSideA

/-!
# Multiplication side of the record-level loan replay (Levels 1–2 and support)

Mirror of `StairLoanRecordShape` / `StairLoanRecordSupport` for the record's
multiplication field: the loaned head `exitHeadShape bestLoans` (record
`center760`, `copyN`, then the loaned 68-deficit endpoint and the nine loaned
slices under `OB5.sig 511`) and the loaned field `exitFieldShape bestLoans`
(scratch window and the unchanged final first packet).

* `exitHead_run_eq`, `exitField_run_eq`: equal to the record's `exitHead` /
  `exitField` on the record's own input frames, independent tapes;
* `exitHeadShape_payload_free`: payload freeness (record facts plus the loaned
  slices; the loaned endpoint sits inside the record endpoint,
  `StairLoanExitSupport.bestExitEndpoint_sub`);
* `exitFieldShape_old_support`: `wires (exitFieldShape bestLoans) ⊆
  wires ControlLoan1589.exitField`, and the hosted single-wire facts.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordExit

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoanRecordShape StairLoanRecordSupport StairLoanExitSupport

attribute [local irreducible] wires run

/-! ## Copies of private record helpers -/

private theorem append_sub (P Q P0 Q0 : Program)
    (hp : wires P ⊆ wires P0) (hq : wires Q ⊆ wires Q0) :
    wires (P ++ Q) ⊆ wires (P0 ++ Q0) := by
  rw [wires_append, wires_append]
  exact Finset.union_subset_union hp hq

private theorem rename_sub (f : Wire → Wire) (P Q : Program)
    (sub : wires P ⊆ wires Q) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) := by
  rw [renameProgram_support, renameProgram_support]
  exact Finset.image_mono f sub

private theorem fixed_rename_free (f : Wire → Wire)
    (injective : Function.Injective f) (P : Program) (q : Wire)
    (fixed : f q = q) (free : q ∉ wires P) : q ∉ wires (renameProgram f P) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨a, ha, eq⟩ := Finset.mem_image.mp used
  exact free (injective (eq.trans fixed.symm) ▸ ha)

private theorem raw_free_extra (P Q : Program)
    (sub : wires P ⊆ wires Q ∪ {base 2409})
    (q : Wire) (away : q ≠ base 2409) (off : q ∉ wires Q) : q ∉ wires P := by
  intro used
  rcases Finset.mem_union.mp (sub used) with old | extra
  · exact off old
  · exact away (Finset.mem_singleton.mp extra)

private theorem hosted_sub (P Q : Program) (sub : wires P ⊆ wires Q) :
    wires (FrontierEntry1591Field.hosted P) ⊆
      wires (FrontierEntry1591Field.hosted Q) :=
  append_sub _ _ _ _ (Finset.Subset.refl _)
    (append_sub _ _ _ _ (rename_sub _ _ _ sub) (Finset.Subset.refl _))

private theorem parity_sub (P Q : Program) (sub : wires P ⊆ wires Q) :
    wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host P) ⊆
    wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host Q) := by
  unfold ParityField1591.program ParityHostTransport5.program
  exact append_sub _ _ _ _ (append_sub _ _ _ _ (Finset.Subset.refl _)
    (rename_sub _ _ _ sub)) (Finset.Subset.refl _)

/-! ## Level 1: the placed multiplication head `Rolling1588.exitHead` -/

def exitHeadShape (loans : StairSchedule.StairLoans) : Program :=
  loans.center ++ HalfFieldOB5.copyN ++
    renameProgram (OB5.sig 511)
      (loans.endPacket false 68 ++ slices loans false exitSliceList)

theorem exitHeadShape_record :
    exitHeadShape StairSchedule.recordLoans = Rolling1588.exitHead := by
  unfold exitHeadShape
  rw [exitSlices_record]
  rfl

theorem exitHead_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (fresh old : List Bool) :
    run (exitHeadShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.exitHead old state := by
  have centerAt (b : List Bool) :=
    R2SqEp760.center760_frame origin ctx ha Y state b input
  have headEq : ∀ a b,
      run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN) a state =
        run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state := by
    intro a b
    apply head_replace _ _ _ state
    · intro a b
      exact StairBoundaryLoan.center760Loan_run_eq origin ctx ha Y state a b input
    · intro b a c
      have v := (centerAt b).2
      exact run_eq_of_phase _ _ a c
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ a v).1
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ c v).1
  have wAll : ∀ b, Rolling1588Frame.EncodedFieldFrame false origin (Y / 2)
      (Y / 2) (run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state) := by
    intro b
    rw [run_append]
    exact (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ _ (centerAt _).2).2
  show run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (StairConcrete.bestLoans.endPacket false 68 ++
        slices StairConcrete.bestLoans false exitSliceList)) fresh state =
    run (R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false ++
        Rolling1588.groups false 1 101)) old state
  apply both_replace _ _ _ _ state headEq
  intro b a c
  have w := wAll b
  rw [StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    exitLogical_run_eq half endpoint origin ctx enabled (Y / 2) (Y / 2) rfl _ w
      a c]

/-! ## Payload freeness of the loaned head -/

theorem backward_slices_payload_free (half : HalfReplayHypothesis) :
    ∀ (L : List (Nat × Nat × Nat)) (c low : Nat), BackwardChain c low L →
      ∀ (i : Fin 8),
        Prefix1590.payload0 i ∉ wires (slices StairConcrete.bestLoans false L)
  | [], _, _, _, _ => by simp [slices, wires]
  | (d, j, n) :: rest, c, low, chain, i => by
      obtain ⟨_, hd, first, bound, hr⟩ := chain
      have head : Prefix1590.payload0 i ∉
          wires (StairConcrete.bestLoans.groups false d j n) := fun used =>
        loanGroups_payload_free half false d hd j n first bound i
          (StairConcrete.bestGroups_wires_sub false d j n used)
      have tail := backward_slices_payload_free half rest j low hr i
      simp only [slices, wires_append, Finset.mem_union, not_or]
      exact ⟨head, tail⟩

theorem exitShape_payload_free_of (C C' D E E' A A' : Program) (i : Fin 8)
    (recordFree : Prefix1590.payload0 i ∉
      wires (C ++ D ++ renameProgram (OB5.sig 511) (E ++ A)))
    (centerSub : wires C' ⊆ wires C)
    (endSub : wires E' ⊆ wires E)
    (sliceFree : Prefix1590.payload0 i ∉ wires A') :
    Prefix1590.payload0 i ∉
      wires (C' ++ D ++ renameProgram (OB5.sig 511) (E' ++ A')) := by
  have split (P Q : Program) : renameProgram (OB5.sig 511) (P ++ Q) =
      renameProgram (OB5.sig 511) P ++ renameProgram (OB5.sig 511) Q := by
    simp [renameProgram]
  have placedA := fixed_rename_free _ (OB5.sig_injective 511 (by decide)) _ _
    (Prefix1590.firstSig_history (NewHistory5.payloadPort i)) sliceFree
  have placedE : wires (renameProgram (OB5.sig 511) E') ⊆
      wires (renameProgram (OB5.sig 511) E) := rename_sub _ _ _ endSub
  rw [split] at recordFree ⊢
  simp only [wires_append, Finset.mem_union, not_or] at recordFree ⊢
  exact ⟨⟨fun h => recordFree.1.1 (centerSub h), recordFree.1.2⟩,
    fun h => recordFree.2.1 (placedE h), placedA⟩

theorem exitHeadShape_payload_free (half : HalfReplayHypothesis) (i : Fin 8) :
    Prefix1590.payload0 i ∉ wires (exitHeadShape StairConcrete.bestLoans) := by
  have recordFree := Rolling1588.exitHead_payload_free i
  rw [← exitHeadShape_record] at recordFree
  exact exitShape_payload_free_of _ _ _ _ _ _ _ i recordFree
    StairLoanConverterSupport.bestCenter_sub bestExitEndpoint_sub
    (backward_slices_payload_free half exitSliceList 102 1 exitSliceList_chain i)

/-! ## Level 2: the multiplication field `Rolling1588.exitField` -/

def exitFieldShape (loans : StairSchedule.StairLoans) : Program :=
  FourScratchWindow.clearProgram ++
    renameProgram Prefix1590.borrow (exitHeadShape loans) ++
    FourScratchWindow.unprefix ++ Rolling1588.placedFirstPacket false

theorem exitFieldShape_record :
    exitFieldShape StairSchedule.recordLoans = Rolling1588.exitField := by
  unfold exitFieldShape
  rw [exitHeadShape_record]
  rfl

theorem exitField_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (fresh old : List Bool) :
    run (exitFieldShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.exitField old state := by
  have shapeB : exitFieldShape StairConcrete.bestLoans =
      (FourScratchWindow.clearProgram ++
        (renameProgram Prefix1590.borrow
            (exitHeadShape StairConcrete.bestLoans) ++
          FourScratchWindow.unprefix)) ++ Rolling1588.placedFirstPacket false := by
    simp only [exitFieldShape, List.append_assoc]
  have shapeR : Rolling1588.exitField =
      (FourScratchWindow.clearProgram ++
        (renameProgram Prefix1590.borrow Rolling1588.exitHead ++
          FourScratchWindow.unprefix)) ++ Rolling1588.placedFirstPacket false := by
    simp only [Rolling1588.exitField, List.append_assoc]
  rw [shapeB, shapeR]
  have before := Rolling1588.canonical_prefix_codes origin ctx Y 0 state input x
    hx0 hx trace
  have headAt (r : List Bool) :=
    Rolling1588.exitHead_frame origin ctx ha enabled Y state r input
  have windowR (r : List Bool) :
      run (FourScratchWindow.clearProgram ++
          (renameProgram Prefix1590.borrow Rolling1588.exitHead ++
            FourScratchWindow.unprefix)) r state =
        run Rolling1588.exitHead (r.drop 6) state := by
    have after := Rolling1588.field_prefix_codes origin ctx _ _ _
      (headAt (r.drop 6)).2 x hx0 hx trace
    exact FourScratchWindow.window_run_eq Rolling1588.exitHead _ rfl
      Rolling1588.exitHead_payload_free state r
      (FourScratchWindow.canonical_clean origin ctx ha Y state input before.1
        before.2.1)
      (FourScratchWindow.field_clean origin ctx _ _ _ (headAt (r.drop 6)).2
        after.1 after.2.1)
      (Rolling1588.canonical_768_zero origin ctx Y 0 state input)
      (Rolling1588.field_768_zero origin ctx _ _ _ (headAt (r.drop 6)).2)
      before.2.2
  apply head_replace _ _ _ state
  · intro a b
    have headEq := exitHead_run_eq half endpoint origin ctx ha enabled Y state
      input (a.drop 6) (b.drop 6)
    have after := Rolling1588.field_prefix_codes origin ctx _ _ _
      (headAt (b.drop 6)).2 x hx0 hx trace
    have windowB := FourScratchWindow.window_run_eq
      (exitHeadShape StairConcrete.bestLoans) _ rfl
      (exitHeadShape_payload_free half) state a
      (FourScratchWindow.canonical_clean origin ctx ha Y state input before.1
        before.2.1)
      (by rw [headEq]; exact FourScratchWindow.field_clean origin ctx _ _ _ (headAt (b.drop 6)).2 after.1 after.2.1)
      (Rolling1588.canonical_768_zero origin ctx Y 0 state input)
      (by rw [headEq]; exact Rolling1588.field_768_zero origin ctx _ _ _ (headAt (b.drop 6)).2)
      before.2.2
    rw [windowB, windowR b]
    exact headEq
  · intro b a c
    rw [windowR b]
    have head := headAt (b.drop 6)
    have zero : (Replay5.firstPayload false origin
        ((Rolling1588.exitHeadPayload origin Y).1,
          (Rolling1588.exitHeadPayload origin Y).2)).2 = 0 := by
      simpa only [Prod.mk.eta] using
        Rolling1588.exitHead_first_zero origin x Y hx0 hx trace
    have firstAt (r : List Bool) :=
      Rolling1588.placedFirstPacket_frame false true origin ctx enabled x hx
        trace _ _ ⟨fun _ => zero, fun bad => absurd bad (by decide)⟩ _ r head.2
    exact run_eq_of_phase _ _ a c (firstAt a).1 (firstAt c).1

/-! ## The loaned multiplication field inside `ControlLoan1589.exitField` -/

theorem loanSlicesBack_old_support (half : HalfReplayHypothesis) :
    ∀ (L : List (Nat × Nat × Nat)) (low k : Nat),
      BackwardChain (low + k) low L →
      wires (slices StairConcrete.bestLoans false L) ⊆
        wires (ControlLoan1589.groups false low k)
  | [], low, k, chain => by
      simp only [BackwardChain] at chain
      have hk : k = 0 := by omega
      subst hk
      simp [slices, ControlLoan1589.groups, PacketSequence.program, wires]
  | (d, j, n) :: rest, low, k, chain => by
      obtain ⟨hc, hd, _, bound, hr⟩ := chain
      have hlow := backward_chain_low rest j low hr
      obtain ⟨k', hk'⟩ : ∃ k', j = low + k' := ⟨j - low, by omega⟩
      subst hk'
      have hk : k = k' + n := by omega
      subst hk
      have head := (StairConcrete.bestGroups_wires_sub false d (low + k') n).trans
        (loanGroups_old_support half false d hd (low + k') n bound)
      have tail := loanSlicesBack_old_support half rest low k' hr
      have split : ControlLoan1589.groups false low (k' + n) =
          ControlLoan1589.groups false (low + k') n ++
            ControlLoan1589.groups false low k' := by
        simp only [ControlLoan1589.groups]
        exact program_false_add _ k' n low
      simp only [slices, split, wires_append, Finset.union_subset_iff]
      exact ⟨head.trans Finset.subset_union_left,
        tail.trans Finset.subset_union_right⟩

theorem exitSlices_old_support (half : HalfReplayHypothesis) :
    wires (slices StairConcrete.bestLoans false exitSliceList) ⊆
      wires (ControlLoan1589.groups false 1 101) :=
  loanSlicesBack_old_support half exitSliceList 1 101 exitSliceList_chain

theorem exit_field_shape_union (Cl U Pf Cc Cc' Cp E E' A A' : Program)
    (centerSub : wires Cc' ⊆ wires Cc)
    (endSub : wires E' ⊆ wires E) :
    wires (Cl ++ renameProgram Prefix1590.borrow
        (Cc' ++ Cp ++ renameProgram (OB5.sig 511) (E' ++ A')) ++ U ++ Pf) ⊆
      wires (Cl ++ renameProgram Prefix1590.borrow
        (Cc ++ Cp ++ renameProgram (OB5.sig 511) (E ++ A)) ++ U ++ Pf) ∪
        wires (renameProgram Prefix1590.borrow
          (renameProgram (OB5.sig 511) A')) := by
  have hE : ((wires E').image (OB5.sig 511)).image Prefix1590.borrow ⊆
      ((wires E).image (OB5.sig 511)).image Prefix1590.borrow :=
    Finset.image_subset_image (Finset.image_subset_image endSub)
  have hC : (wires Cc').image Prefix1590.borrow ⊆
      (wires Cc).image Prefix1590.borrow :=
    Finset.image_subset_image centerSub
  simp only [wires_append, renameProgram_support, Finset.image_union]
  intro q used
  have hE' := fun h => hE (a := q) h
  have hC' := fun h => hC (a := q) h
  simp only [Finset.mem_union] at used ⊢
  tauto

theorem old_exit_field_groups (Pp Up Pf Cc Cp G E : Program) :
    wires (renameProgram Prefix1590.borrow (renameProgram (OB5.sig 511) G)) ⊆
      wires (Pp ++ (renameProgram Prefix1590.borrow
        (Cc ++ (Cp ++ renameProgram (OB5.sig 511) (E ++ G))) ++ (Up ++ Pf))) := by
  simp only [renameProgram, List.map_append, wires_append]
  intro q used
  simp only [Finset.mem_union] at used ⊢
  tauto

theorem exitFieldShape_old_support (half : HalfReplayHypothesis) :
    wires (exitFieldShape StairConcrete.bestLoans) ⊆
      wires ControlLoan1589.exitField := by
  have union := exit_field_shape_union FourScratchWindow.clearProgram
    FourScratchWindow.unprefix (Rolling1588.placedFirstPacket false)
    R2SqEp760.center760 StairConcrete.bestLoans.center HalfFieldOB5.copyN
    (StairSchedule.recordLoans.endPacket false 68)
    (StairConcrete.bestLoans.endPacket false 68)
    (slices StairSchedule.recordLoans false exitSliceList)
    (slices StairConcrete.bestLoans false exitSliceList)
    StairLoanConverterSupport.center760Loan_sub bestExitEndpoint_sub
  have shapeR : Rolling1588.exitField =
