        gatePhysical_rename _ (OB5.sig_injective i (by omega)) _
          ((gatePhysical_append _ _).mpr
            ⟨unpack,
              W.ReverseCarry.compactReceiverTick_physical base i
                (by omega) base_pool_nodup⟩)⟩

