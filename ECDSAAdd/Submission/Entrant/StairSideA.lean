/-! ## Packet reads/writes at the checkpoint ticks (direct check) -/

theorem packet_checkpoints :
    ∀ f ∈ [385, 410, 425, 430, 450, 465, 480, 490, 500],
      allCaller (renameProgram (OB5.sig f) (Rolling1588.Integer.packFirst base true f)) = true ∧
      allCaller (renameProgram (OB5.sig f) (Rolling1588.unpackAtTick true f)) = true := by
  decide +kernel

theorem packet_checkpoints_own (f : Nat)
    (hf : f ∈ [385, 410, 425, 430, 450, 465, 480, 490, 500]) :
    wires (renameProgram (OB5.sig f) (Rolling1588.Integer.packFirst base true f)) ⊆ callerDomain ∧
      wires (renameProgram (OB5.sig f) (Rolling1588.unpackAtTick true f)) ⊆ callerDomain :=
  ⟨allCaller_sound _ (packet_checkpoints f hf).1, allCaller_sound _ (packet_checkpoints f hf).2⟩

