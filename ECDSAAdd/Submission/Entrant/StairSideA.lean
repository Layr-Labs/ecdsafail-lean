  rcases hx with (hdec | hbody) | henc
  · obtain ⟨i, hi⟩ := History5.history_gate_mem base 0 _ (Or.inr rfl) x hdec
    exact hist i hi
  · have hs := Q6EndpointReplay.firstBody_support divide hbody
    simp only [Q6EndpointReplay.readSites, Q6EndpointReplay.fieldSites, Finset.mem_union,
