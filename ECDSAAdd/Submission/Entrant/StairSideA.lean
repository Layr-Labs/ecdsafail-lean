/-!
# Field 13 on v3: static zero tracker (LT29), generic and early

`zt w b P` is a sound static zero tracker for one wire: starting from the
status `b` ("`w` is known to be zero"), the last instruction of `P` that
writes `w` decides the status (a `measureX` on `w` resets `w` to `0` for every
input and every tape; any other write makes it unknown).  The tracker is
tail recursive with the status forced at every write, so kernel evaluation on
packet-sized programs stays shallow.  Composition lemmas (append, renaming,
packet sequences, support) let large programs be split into small checked
pieces; no concrete program run is evaluated anywhere.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic







theorem zt_mono (w : Wire) : ∀ (P : Program) (b : Bool), zt w false P = true → zt w b P = true := by
  intro P
  induction P with
  | nil => intro b h; simp [zt] at h
  | cons i p ih =>
    intro b h
    simp only [zt] at h ⊢
    split
    · rename_i hc; rw [if_pos hc] at h; exact h
    · rename_i hc; rw [if_neg hc] at h; exact ih b h








/-! ## Single-pass tracker for the wires of a window `[lo, lo + width)`

The statuses are the bits of a natural number; every update is forced
(`Nat.beq m m`), so the kernel evaluates the tracker with constant depth. -/










/-! ## LT49 (replay budget): structural reductions of `ztAll` checks -/


/-- Only a resetting suffix needs to be checked (the prefix is arbitrary). -/
theorem ztAll_of_suffix (lo width : Nat) (b : Bool) (ws : List Wire) (X Y : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ztAll lo width false ws Y = true) :
    ztAll lo width b ws (X ++ Y) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_append]
    exact zt_mono w Y _ (zt_of_ztAll lo width false ws Y hr h w hw))

/-- A program that touches none of the wires keeps their status. -/
theorem ztAll_true_of_not_mem (lo width : Nat) (ws : List Wire) (P : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ∀ w ∈ ws, w ∉ wires P) :
    ztAll lo width true ws P = true :=
  ztAll_of_zt lo width true ws P hr (fun w hw => zt_of_not_mem w P true (h w hw))

/-! ## K1 (replay budget): composition lemmas for structural `ztAll` checks

The kernel builds the gate list of a recursive generator (`majority ++ rec ++ erase`) with
left-nested appends, which costs quadratic time in the recursion depth.  These lemmas let a check
descend into a program structurally (renamings that fix the checked wires, append splits) and
evaluate the tracker of a recursive generator through a fused recursion instead. -/

theorem k1_ztM_append (lo width : Nat) : ∀ (A B : Program) (m : Nat),
    ztM lo width m (A ++ B) = ztM lo width (ztM lo width m A) B
  | [], _, _ => rfl
  | i :: A, B, m => by
    by_cases h : lo ≤ tgt i ∧ tgt i < lo + width
    · simp only [List.cons_append, ztM, if_pos h, Nat.beq_refl, cond_true]
      exact k1_ztM_append lo width A B _
    · simp only [List.cons_append, ztM, if_neg h]
      exact k1_ztM_append lo width A B _

/-- A reset status of every listed wire survives a suffix that is checked from status `true`. -/
theorem k1_ztAll_append_true (lo width : Nat) (b : Bool) (ws : List Wire) (A B : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (hA : ztAll lo width b ws A = true)
    (hB : ztAll lo width true ws B = true) : ztAll lo width b ws (A ++ B) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_append, zt_of_ztAll lo width b ws A hr hA w hw]
    exact zt_of_ztAll lo width true ws B hr hB w hw)

/-- An injective renaming that fixes every listed wire does not change the check. -/
theorem k1_ztAll_rename_fixed (lo width : Nat) (b : Bool) (ws : List Wire) (f : Wire → Wire)
    (hf : Function.Injective f) (P : Program) (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (hfix : ∀ w ∈ ws, f w = w) (h : ztAll lo width b ws P = true) :
    ztAll lo width b ws (renameProgram f P) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_rename_fixed f hf w (hfix w hw)]
    exact zt_of_ztAll lo width b ws P hr h w hw)

end ECDSAAdd.Entrant.StairField13V3Clean

end
