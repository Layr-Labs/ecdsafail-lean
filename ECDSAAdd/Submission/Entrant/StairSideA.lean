theorem reverse_succ_counts (isA : Bool) (i n j k : Nat) (hj : j = i + 1)
    (hk : k = n + 1) :
    toffoliCount (Rolling1588.reverse isA i k) =
        toffoliCount (Rolling1588.reverse isA j n) +
          toffoliCount (Rolling1588.unpackAtTick isA i) +
          toffoliCount (W.ReverseCarry.compactReceiverTick base i) ∧
      measurementCount (Rolling1588.reverse isA i k) =
        measurementCount (Rolling1588.reverse isA j n) +
          measurementCount (Rolling1588.unpackAtTick isA i) +
          measurementCount (W.ReverseCarry.compactReceiverTick base i) := by
  subst hj
  subst hk
  refine ⟨?_, ?_⟩ <;>
    simp only [Rolling1588.reverse, toffoliCount_append,
      measurementCount_append, renameProgram_counts] <;> omega


theorem reverse_counts_add (isA : Bool) (n : Nat) :
    ∀ i m j k : Nat, j = i + n → k = n + m →
      toffoliCount (Rolling1588.reverse isA i k) =
          toffoliCount (Rolling1588.reverse isA i n) +
            toffoliCount (Rolling1588.reverse isA j m) ∧
        measurementCount (Rolling1588.reverse isA i k) =
          measurementCount (Rolling1588.reverse isA i n) +
            measurementCount (Rolling1588.reverse isA j m) := by
  induction n with
  | zero =>
    intro i m j k hj hk
    rw [hj, hk]
    have z1 : toffoliCount (Rolling1588.reverse isA i 0) = 0 := rfl
    have z2 : measurementCount (Rolling1588.reverse isA i 0) = 0 := rfl
    simp only [Nat.add_zero, Nat.zero_add]
    constructor <;> omega
  | succ n ih =>
    intro i m j k hj hk
    subst hj
    subst hk
    obtain ⟨r1, r2⟩ := ih (i + 1) m (i + (n + 1)) (n + m) (by omega) rfl
    rw [show n + 1 + m = (n + m) + 1 by omega]
    simp only [Rolling1588.reverse, toffoliCount_append,
      measurementCount_append, renameProgram_counts]
    constructor <;> omega

theorem program_counts_add (fw : Bool) (p : Nat → Program) (n : Nat) :
    ∀ j m j' k : Nat, j' = j + n → k = n + m →
      toffoliCount (PacketSequence.program fw p j k) =
          toffoliCount (PacketSequence.program fw p j n) +
            toffoliCount (PacketSequence.program fw p j' m) ∧
        measurementCount (PacketSequence.program fw p j k) =
          measurementCount (PacketSequence.program fw p j n) +
            measurementCount (PacketSequence.program fw p j' m) := by
  induction n with
  | zero =>
    intro j m j' k hj hk
    rw [hj, hk]
    have z1 : toffoliCount (PacketSequence.program fw p j 0) = 0 := rfl
    have z2 : measurementCount (PacketSequence.program fw p j 0) = 0 := rfl
    simp only [Nat.add_zero, Nat.zero_add]
    constructor <;> omega
  | succ n ih =>
    intro j m j' k hj hk
    subst hj
    subst hk
    obtain ⟨r1, r2⟩ := ih (j + 1) m (j + (n + 1)) (n + m) (by omega) rfl
    rw [show n + 1 + m = (n + m) + 1 by omega]
    cases fw with
    | false =>
      have e1 : PacketSequence.program false p j (n + m + 1) =
          PacketSequence.program false p (j + 1) (n + m) ++ p j := rfl
      have e2 : PacketSequence.program false p j (n + 1) =
          PacketSequence.program false p (j + 1) n ++ p j := rfl
      rw [e1, e2]
      simp only [toffoliCount_append, measurementCount_append]
      constructor <;> omega
    | true =>
      have e1 : PacketSequence.program true p j (n + m + 1) =
          p j ++ PacketSequence.program true p (j + 1) (n + m) := rfl
      have e2 : PacketSequence.program true p j (n + 1) =
          p j ++ PacketSequence.program true p (j + 1) n := rfl
      rw [e1, e2]
      simp only [toffoliCount_append, measurementCount_append]
      constructor <;> omega

theorem groups_counts_add (divide : Bool) (j n m j' k : Nat)
    (hj : j' = j + n) (hk : k = n + m) :
    toffoliCount (Rolling1588.groups divide j k) =
        toffoliCount (Rolling1588.groups divide j n) +
          toffoliCount (Rolling1588.groups divide j' m) ∧
      measurementCount (Rolling1588.groups divide j k) =
        measurementCount (Rolling1588.groups divide j n) +
          measurementCount (Rolling1588.groups divide j' m) :=
  program_counts_add divide (Rolling1588.packet divide) n j m j' k hj hk


