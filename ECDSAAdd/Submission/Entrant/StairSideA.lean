section Merge_StairCallerParts_at_StairSideA

/-!
# Caller-domain support of the record pieces of the hosted kernels (LT11)

Every hosted kernel of the staircase (current CANON and the k = 44 re-plan)
is assembled from (i) the placed checkpoint primitives (LT13:
`StairPhysicalPrimitives.physicalPrimitives_caller`), (ii) hosted/loaned
groups and boundary components, and (iii) unchanged record pieces: tick
ranges of the record walk, the six-tick bridge, the terminal reverse bridge,
packet writes/reads at checkpoint ticks, the native first tick, the clears and
the scalar glue.  This module proves (iii).

Method.  The record kernels `InverseFiveEntry23.entryKernel15` and
`ParityXExitInverse23Kernel.kernelXN k` have support in
`OB5Support.logicalSites ⊆ callerDomain` (record theorems `entry_support530`,
`kernelXN_support`).  Their phases contain the record pieces as literal
append factors (after the tick-range split lemmas below).  Since
`phaseHost` is a permutation whose inverse preserves the caller domain, the
pieces' own labels are caller labels (`own_of_renamed`); every new wrapper
(`phaseHost`, `Prefix1590.borrow`, `fieldRename`, `OB5.sig i`) preserves the
caller domain (`StairCallerCheck`), so the pieces stay inside it wherever the
re-planned schedule places them.  Small field pieces are checked by
`decide +kernel` on `allCaller`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## Generic support tools -/

theorem sub_left (P Q : Program) : wires P ⊆ wires (P ++ Q) := by
  rw [wires_append]
  exact Finset.subset_union_left

theorem sub_right (P Q : Program) : wires Q ⊆ wires (P ++ Q) := by
  rw [wires_append]
  exact Finset.subset_union_right


theorem preserves_swap_symm (a b : Wire) (ha : a ∈ callerDomain) (hb : b ∈ callerDomain) :
    PreservesCaller (Equiv.swap a b).symm := by
  rw [Equiv.symm_swap]
  exact preserves_swap a b ha hb

theorem preserves_symm_trans (e₁ e₂ : Equiv.Perm Wire) (h₁ : PreservesCaller e₁.symm)
    (h₂ : PreservesCaller e₂.symm) : PreservesCaller (e₁.trans e₂).symm := by
  intro q hq
  rw [Equiv.symm_trans_apply]
  exact h₁ _ (h₂ q hq)

theorem preserves_phaseHost_symm : PreservesCaller Rolling1588Lifetime.phaseHost.symm := by
  unfold Rolling1588Lifetime.phaseHost
  exact preserves_symm_trans _ _
    (preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega)))
    (preserves_symm_trans _ _
      (preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega)))
      (preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega))))

/-- Own labels from renamed labels, for a permutation whose inverse preserves the
caller domain. -/
theorem own_of_renamed (e : Equiv.Perm Wire) (he : PreservesCaller e.symm) (P : Program)
    (h : wires (renameProgram e P) ⊆ callerDomain) : wires P ⊆ callerDomain := by
  intro q hq
  have img : e q ∈ wires (renameProgram e P) := by
    rw [renameProgram_support]
    exact Finset.mem_image_of_mem _ hq
  have back := he _ (h img)
  simpa only [Equiv.symm_apply_apply] using back

theorem own_of_phaseHost (P : Program)
    (h : wires (renameProgram Rolling1588Lifetime.phaseHost P) ⊆ callerDomain) :
    wires P ⊆ callerDomain :=
  own_of_renamed _ preserves_phaseHost_symm P h

/-! ## Tick-range split lemmas -/


theorem reverse_split (isA : Bool) (m : Nat) : ∀ i n : Nat,
    Rolling1588.reverse isA i (m + n) =
      Rolling1588.reverse isA (i + m) n ++ Rolling1588.reverse isA i m := by
  induction m with
  | zero =>
    intro i n
    simp [Rolling1588.reverse]
  | succ m ih =>
    intro i n
    rw [Nat.succ_add]
    simp only [Rolling1588.reverse]
    rw [ih (i + 1) n, List.append_assoc, show i + 1 + m = i + (m + 1) by omega]

