/-- Labels whose field-tail placement `TP` is 39-good (intervals). -/
def TPI (x : Nat) : Prop :=
  x < 16 ∨ (17 ≤ x ∧ x < 527) ∨ (528 ≤ x ∧ x < 531) ∨ x = 733 ∨ (736 ≤ x ∧ x < 741) ∨
    x = 784 ∨ (786 ≤ x ∧ x < 1042) ∨ (1043 ≤ x ∧ x < 1301) ∨ x = 1556 ∨
    (1560 ≤ x ∧ x < 1814) ∨ (2072 ≤ x ∧ x < 2328) ∨ (2330 ≤ x ∧ x < 2417) ∨ x = 2425

instance instDecTPI (x : Nat) : Decidable (TPI x) := by
  unfold TPI; infer_instance

def tpList : List Nat :=
  List.range' 0 16 ++ List.range' 17 510 ++ [528, 529, 530, 733, 736, 737, 738, 739, 740, 784] ++
    List.range' 786 256 ++ List.range' 1043 258 ++ [1556] ++ List.range' 1560 254 ++
    List.range' 2072 256 ++ List.range' 2330 87 ++ [2425]

/-- LT46 (replay budget): decided on the closed-form field-tail placement
(`StairPlaceFast.outerPlace_eqB`; 53 s → ≈ 2.5 s). -/
theorem tpList_good : ∀ x ∈ tpList, Good39 (TP x) := by
  have hB : tpList.all (fun x => good39B (StairPlaceFast.outerPlaceB x)) = true := by
    decide +kernel
  intro x hx
  have h := good39_of_B (List.all_eq_true.mp hB x hx)
  rwa [← StairPlaceFast.outerPlace_eqB] at h

theorem tpi_good {x : Nat} (h : TPI x) : Good39 (TP x) := by
  apply tpList_good
  unfold TPI at h
  simp only [tpList, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
    or_false]
  omega

theorem ok39_of_tpi {P : Program} (h : ∀ x ∈ wires P, TPI x) :
    PieceOK StairCertificate.holes39 TP P :=
  ok39_of_good (fun x hx => tpi_good (h x hx))


