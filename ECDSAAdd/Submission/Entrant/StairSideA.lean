section

namespace ECDSAAdd.Entrant.HighBankJoin
open Arithmetic

structure Column where
  low : Bool
  hot : Option Wire
  shadow : Wire
  tube : Wire

def Column.keep (r : Column) := if r.low then r.shadow else r.tube
def Column.free (r : Column) := if r.low then r.tube else r.shadow
def toggle (a : Wire) : Option Wire → Program
  | none => []
  | some w => [.CX w a]
def control (b : BasisState) (h : Option Wire) := (h.map b).getD false

def word (a : Wire) : List Column → Program
  | [] => []
  | r::rs => toggle a r.hot ++ (pair r.low a r.shadow r.tube ++
      (word a rs ++ toggle a r.hot))

def nextBasis (r : Column) (b : BasisState) : BasisState :=
  writeBit (writeBit b r.keep (b r.shadow ^^ b r.tube)) r.free false

/-- The reference transformation writes only the two data sites in each row. -/
def joined : List Column → BasisState → BasisState
  | [],b => b
  | r::rs,b => joined rs (nextBasis r b)

def WellPlaced (a : Wire) (rs : List Column) :=
  (∀ r∈rs, [a,r.shadow,r.tube].Nodup) ∧
  ∀ r∈rs, ∀ h∈r.hot, h≠a ∧ ∀ v∈rs, h≠v.shadow ∧ h≠v.tube

/-- Check the clean branch at the running prefix XOR of the one-hot controls. -/
def Admissible (ref : BasisState) : Bool → List Column → BasisState → Prop
  | _,[],_ => True
  | active,r::rs,b =>
    let on := active ^^ control ref r.hot
    (if on then b r.shadow=false else b r.tube=false) ∧
      Admissible ref on rs (nextBasis r b)

private theorem pushRun (p q : Program) (h : measurementCount p=0) (s : State) (m : List Bool) :
    run (p++q) m s=run q m (run p m s) := by rw [run_append,run_take,h,List.drop_zero]

private theorem toggle_mc (a : Wire) (h : Option Wire) : measurementCount (toggle a h)=0 := by
  cases h <;> rfl

theorem word_counts (a : Wire) (rs : List Column) :
    toffoliCount (word a rs)=rs.length ∧ measurementCount (word a rs)=0 := by
  induction rs with
  | nil => exact ⟨rfl,rfl⟩
  | cons r rs ih =>
    have ht : toffoliCount (toggle a r.hot)=0 := by cases r.hot <;> rfl
    simp [word,ih.1,ih.2,ht,toggle_mc,(pair_counts r.low a r.shadow r.tube).1,
      (pair_counts r.low a r.shadow r.tube).2,Nat.add_comm]

private theorem toggle_run (a : Wire) (h : Option Wire) (s : State) (m : List Bool) :
    run (toggle a h) m s=⟨s.phase,writeBit s.basis a (s.basis a ^^ control s.basis h)⟩ := by
  cases h with
  | none =>
    apply congrArg₂ State.mk rfl
    funext q
    by_cases eq : q=a <;> simp [control,writeBit,Function.update,eq]
  | some w => rfl

private theorem unaffected (r : Column) (b : BasisState) (q : Wire) (x : q≠r.shadow) (y : q≠r.tube) :
    nextBasis r b q=b q := by
  cases h : r.low <;> simp [nextBasis,Column.keep,Column.free,h,writeBit,Function.update,x,y]

theorem joined_frame (rs : List Column) (b : BasisState) (q : Wire)
    (h : ∀ r∈rs, q≠r.shadow ∧ q≠r.tube) : joined rs b q=b q := by
  induction rs generalizing b with
  | nil => rfl
  | cons r rs ih =>
    exact (ih _ (fun v hv => h v (by simp [hv]))).trans
      (unaffected r b q (h r (by simp)).1 (h r (by simp)).2)

private theorem pair_basis (r : Column) (a : Wire) (s : State) (m : List Bool)
    (hn : [a,r.shadow,r.tube].Nodup)
    (ok : if s.basis a then s.basis r.shadow=false else s.basis r.tube=false) :
    run (pair r.low a r.shadow r.tube) m s=⟨s.phase,nextBasis r s.basis⟩ := by
  obtain ⟨ph,ke,fr,same⟩ := pair_run r.low _ _ _ hn s m ok
  apply congrArg₂ State.mk ph
  funext q
  have neq : r.shadow≠r.tube := by simpa [and_assoc] using (List.nodup_cons.mp hn).2
  cases v : r.low <;> by_cases hs : q=r.shadow <;> by_cases ht : q=r.tube <;>
    simp_all [nextBasis,Column.keep,Column.free,writeBit,Function.update]

private theorem commute (r : Column) (b : BasisState) (a : Wire) (x : Bool)
    (has : a≠r.shadow) (hat : a≠r.tube) :
    nextBasis r (writeBit b a x)=writeBit (nextBasis r b) a x := by
  funext q
  by_cases eq : q=a
  · subst q; rw [unaffected _ _ _ has hat]; simp [writeBit]
  · cases h : r.low <;> simp [nextBasis,Column.keep,Column.free,h,writeBit,Function.update,
        eq,Ne.symm has,Ne.symm hat]

private theorem read_eq {h : Option Wire} {b ref : BasisState}
    (eq : ∀ q∈h, b q=ref q) : control b h=control ref h := by
  cases h with
  | none => rfl
  | some w => exact eq w rfl

private theorem retoggle (a : Wire) (h : Option Wire) (ref b : BasisState)
    (ph active : Bool) (m : List Bool) (dis : ∀ w∈h, w≠a ∧ b w=ref w) :
    run (toggle a h) m ⟨ph,writeBit b a active⟩ =
      ⟨ph,writeBit b a (active ^^ control ref h)⟩ := by
  rw [toggle_run]
  have ctrl := read_eq (h:=h) (b:=writeBit b a active) (ref:=ref) (by
    intro w hw
    simpa [writeBit,Function.update,(dis w hw).1] using (dis w hw).2)
  rw [ctrl]
  apply congrArg₂ State.mk rfl
  funext q
  by_cases e : q=a <;> simp [e,writeBit,Function.update]

theorem word_run (a : Wire) (rs : List Column) (ref b : BasisState)
    (ph active : Bool) (m : List Bool) (layout : WellPlaced a rs)
    (ctrl : ∀ r∈rs, ∀ w∈r.hot, b w=ref w) (ok : Admissible ref active rs b) :
    run (word a rs) m ⟨ph,writeBit b a active⟩ =
      ⟨ph,writeBit (joined rs b) a active⟩ := by
  induction rs generalizing b active with
  | nil => rfl
  | cons r rs ih =>
    let on := active ^^ control ref r.hot
    have nd := layout.1 r (by simp)
    obtain ⟨ns,nt,_⟩ : a≠r.shadow ∧ a≠r.tube ∧ r.shadow≠r.tube := by simpa [and_assoc] using nd
    have sub : WellPlaced a rs :=
      ⟨fun v hv => layout.1 v (by simp [hv]),fun v hv w hw => ⟨(layout.2 v (by simp [hv]) w hw).1,
         fun z hz => (layout.2 v (by simp [hv]) w hw).2 z (by simp [hz])⟩⟩
    obtain ⟨clean,rest⟩ := ok
    have update : run (pair r.low a r.shadow r.tube) m ⟨ph,writeBit b a on⟩ =
        ⟨ph,writeBit (nextBasis r b) a on⟩ := by
      rw [pair_basis _ _ _ _ nd (by simpa [writeBit,Function.update,Ne.symm ns,Ne.symm nt,on] using clean)]
      rw [commute _ _ _ _ ns nt]
    have outer (w : Wire) (hw : w∈r.hot) := layout.2 r (by simp) w hw
    have first := retoggle a r.hot ref b ph active m
      (fun w hw => ⟨(outer w hw).1,ctrl r (by simp) w hw⟩)
    have inner := ih (nextBasis r b) on sub (fun z hz w hw => by
      have g := (layout.2 z (by simp [hz]) w hw).2 r (by simp)
      exact (unaffected r b w g.1 g.2).trans (ctrl z (by simp [hz]) w hw)) rest
    have last := retoggle a r.hot ref (joined (r::rs) b) ph on m (fun w hw =>
      ⟨(outer w hw).1,(joined_frame _ _ _ (outer w hw).2).trans (ctrl r (by simp) w hw)⟩)
    rw [word,pushRun _ _ (toggle_mc _ _),first,pushRun _ _ (pair_counts _ _ _ _).2,update,
        pushRun _ _ (word_counts _ _).2,inner]
    simpa [on] using last

def Apart (r v : Column) := r.shadow≠v.shadow ∧ r.shadow≠v.tube ∧
  r.tube≠v.shadow ∧ r.tube≠v.tube

theorem joined_at (rs : List Column) (b : BasisState) (dis : rs.Pairwise Apart)
    (distinct : ∀ r∈rs, r.shadow≠r.tube) (v : Column) (hv : v∈rs) :
    joined rs b v.keep=(b v.shadow ^^ b v.tube) ∧ joined rs b v.free=false := by
  induction rs generalizing b with
  | nil => cases hv
  | cons r rs ih =>
    obtain ⟨head,tail⟩ := List.pairwise_cons.mp dis
    rcases List.mem_cons.mp hv with eq|mem
    · subst v
      have keep := joined_frame rs (nextBasis r b) r.keep (fun c hc => by
        obtain ⟨ss,st,ts,tt⟩ := head c hc
        cases h : r.low <;> simp_all [Column.keep])
      have fr := joined_frame rs (nextBasis r b) r.free (fun c hc => by
        obtain ⟨ss,st,ts,tt⟩ := head c hc
        cases h : r.low <;> simp_all [Column.free])
      change joined rs (nextBasis r b) _=_ ∧ joined rs (nextBasis r b) _=_
      rw [keep,fr]
      have ne := distinct r (by simp)
      cases h : r.low <;> simp [nextBasis,Column.keep,Column.free,h,writeBit,Function.update,ne,Ne.symm ne]
    · obtain ⟨ss,st,ts,tt⟩ := head v mem
      have inner := ih (nextBasis r b) tail (fun c hc => distinct c (by simp [hc])) mem
      rw [unaffected r b v.shadow (Ne.symm ss) (Ne.symm ts),
          unaffected r b v.tube (Ne.symm st) (Ne.symm tt)] at inner
      exact inner

/-- Input-only precondition, read against a single immutable bank snapshot. -/
def CleanColumns (ref : BasisState) : Bool → List Column → BasisState → Prop
  | _,[],_ => True
  | active,r::rs,b =>
    let on := active ^^ control ref r.hot
    (if on then b r.shadow=false else b r.tube=false) ∧ CleanColumns ref on rs b

private theorem clean_congr (rs : List Column) (ref b f : BasisState) (active : Bool)
    (eq : ∀ r∈rs, b r.shadow=f r.shadow ∧ b r.tube=f r.tube) :
    CleanColumns ref active rs b ↔ CleanColumns ref active rs f := by
  induction rs generalizing active with
  | nil => rfl
  | cons r rs ih =>
    simp only [CleanColumns,(eq r (by simp)).1,(eq r (by simp)).2]
    rw [ih _ (fun v hv => eq v (by simp [hv]))]

theorem admissible (rs : List Column) (ref b : BasisState) (active : Bool)
    (dis : rs.Pairwise Apart) (h : CleanColumns ref active rs b) : Admissible ref active rs b := by
  induction rs generalizing active b with
  | nil => trivial
  | cons r rs ih =>
    obtain ⟨head,tail⟩ := List.pairwise_cons.mp dis
    exact ⟨h.1,ih _ _ tail ((clean_congr rs ref (nextBasis r b) b _ (fun v hv => by
      obtain ⟨ss,st,ts,tt⟩ := head v hv
      exact ⟨unaffected _ _ _ (Ne.symm ss) (Ne.symm ts),unaffected _ _ _ (Ne.symm st) (Ne.symm tt)⟩)).mpr h.2)⟩

end ECDSAAdd.Entrant.HighBankJoin

end

section

namespace ECDSAAdd.Entrant.IntegerHigh
open SkywalkNat SkywalkRails

/-- Off the tie, the unsigned three-way letter determines both actually
recorded bits independently of the incoming signs and orientation. -/
theorem recorded (z : SkywalkNat.State) (g s : Bool)
    (hv : 0<z.v) (ho : z.v%2=1) (neq : z.u≠z.v) :
    SkywalkTrace.code (encode g s z.u z.v) =
      (decide (letter z=0),decide (letter z=2)) := by
  have h := SkywalkTrace.code_classified g s z hv ho
  generalize hc : SkywalkTrace.code (encode g s z.u z.v)=c at h ⊢
  rcases c with ⟨a,b⟩
  dsimp only at h
  by_cases e : z.u%2=0
  · simp [letter,e,h.1,h.2.1 e]
  · by_cases lt : z.u<z.v
    · have hb : b=true := by
        cases b
        · have bad := h.2.2.2 e rfl; omega
        · rfl
      simp [letter,e,lt,h.1,hb]
    · have hb : b=false := by
        cases b
        · rfl
        · have bad := h.2.2.1 e rfl; omega
      simp [letter,e,lt,h.1,hb]

theorem trace_eq {k : Nat} {z t : SkywalkNat.State} (h : Rel k z t)
    (gz sz gt st : Bool) (zp : 0<z.v) (zo : z.v%2=1) (tp : 0<t.v) (to' : t.v%2=1) :
    SkywalkTrace.trace k (encode gz sz z.u z.v) = SkywalkTrace.trace k (encode gt st t.u t.v) := by
  induction k generalizing z t gz sz gt st with
  | zero => rfl
  | succ k ih =>
    obtain ⟨hz,ht⟩ := different h
    obtain ⟨l,tail⟩ := advance h
    obtain ⟨zp',zo'⟩ := step_v_odd_pos z zp zo
    obtain ⟨tp',to''⟩ := step_v_odd_pos t tp to'
    simp only [SkywalkTrace.trace,recorded z gz sz zp zo hz,recorded t gt st tp to' ht,l,
      SkywalkTrace.next,step_reencode gz sz z zp zo,step_reencode gt st t tp to']
    rw [ih tail _ _ _ _ zp' zo' tp' to'']


end ECDSAAdd.Entrant.IntegerHigh

end

