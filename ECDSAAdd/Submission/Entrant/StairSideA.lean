    accVal a (writeBit st t v) T = accVal a st T := by
  induction T with
  | nil => rfl
  | cons x r ih =>
    obtain ⟨i, p, c⟩ := x
    have hx := h (i, p, c) (by simp)
    have hr := ih (fun y hy => h y (by simp [hy]))
    simp only [accVal, hr]
    simp [writeBit, hx.1, hx.2]

/-- Toggle `t` by `v`. -/
