  have i0r2 : i0 ≠ tr.r2 := fun e => ix.2.2.2.1 (e ▸ hi0)
  have zp := zeroPorts_maps (it.map (fun i => xs.getD i 0)) work (by simp [hitl, hwl])
  -- the remap's CX controls are the pivot wires, never a remapped wire
