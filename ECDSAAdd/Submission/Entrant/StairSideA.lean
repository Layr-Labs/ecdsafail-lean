/-- Per-row finite check: every scratch label is off `EP` and lands (in kernel
coordinates) on a frame-zero label. -/
def RecFacts (B B' : Nat) : Prop :=
  ∀ r ∈ StairField2V3Seg.scratchT B B', r ∉ EP ∧ ZeroClass (OB5.sig 511 r)

theorem rec_of_inv (B B' c : Nat) (X : Program) (facts : RecFacts B B')
    (h : ∀ t, Reach X t → Inv c t) : StairField2V3Seg.RecordScratch B B' X := by
  intro t ht r hr
  obtain ⟨origin, X', Y', s, ctx, -, frame, agree⟩ := h t ht
  obtain ⟨hEP, hz⟩ := facts r hr
  have e1 : t.basis (fieldPlace r) = (StairField2V3Seg.pullIn t).basis r := rfl
  have e2 : s.basis r = (pullState (OB5.sig 511) s).basis (OB5.sig 511 r) := by
    show s.basis r = s.basis (OB5.sig 511 (OB5.sig 511 r))
    rw [OB5.sig_invol 511 (by decide)]
  rw [e1, agree r (off_of_not_EP r hEP), e2]
  exact frame_zero c origin ctx X' Y' _ frame _ hz

