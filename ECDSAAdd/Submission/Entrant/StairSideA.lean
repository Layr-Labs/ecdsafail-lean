  obtain ⟨v, hv, rfl⟩ := List.mem_map.mp h
  rw [hf] at e
  exact hw (e ▸ hv)





theorem getD_mem_kx (l : List Wire) (k : Nat) (d : Wire) : l.getD k d ∈ l ∨ l.getD k d = d := by
  rw [List.getD_eq_getElem?_getD]
  cases h : l[k]? with
  | none => right; rfl
  | some v => left; exact List.mem_of_getElem? h


theorem cons3_kx {α : Type} (l : List α) (h : 3 ≤ l.length) : ∃ a x x2 xs, l = a::x::x2::xs :=
  match l, h with
  | a::x::x2::xs, _ => ⟨a, x, x2, xs, rfl⟩
  | [], h => by simp at h
  | [_], h => by simp at h
  | [_, _], h => by simp at h














theorem ai_zt_kx (a x x2 b y y2 c w : Wire) (xs ys cs : List Wire)
    (hb : b ≠ w) (hy : y ≠ w) (hc : c ≠ w) (cin : Wire) (bb : Bool) :
    zt w bb (addInPlace (a::x::x2::xs) (b::y::y2::ys) (c::w::cs) cin) = true := by
  rw [addInPlace, addInPlace]
  simp only [zt_append]
  simp [eraseCarry, zt, tgt, isMeas, hb, hy, hc]

theorem fwd_zt_kx (L : SkywalkIntegerLayout) (n : Nat) (w : Wire) (P0 cl : Program)
    (a x x2 b y y2 c : Wire) (xs ys cs : List Wire)
    (hX : (narrowSkywalkRecordLayout L n).x.take n = a::x::x2::xs)
    (hY : (narrowSkywalkRecordLayout L n).y.take n = b::y::y2::ys)
    (hC : (narrowSkywalkRecordLayout L n).carry.take (n-1) = c::w::cs)
    (hc : c ≠ w) (hXw : w ∉ a::x::x2::xs) (hYw : w ∉ b::y::y2::ys)
    (hq : L.history ≠ w) (hyd : w ∉ (narrowSkywalkRecordLayout L n).y.drop n) (ha0 : L.a0 ≠ w)
    (hcl : ∀ ins ∈ cl, tgt ins ≠ w) (bb : Bool) :
    zt w bb (P0 ++ narrowSignedRecord (narrowSkywalkRecordLayout L n) n ++ [.CX L.previous L.a0] ++ cl)
      = true := by
  have hq' : (narrowSkywalkRecordLayout L n).q ≠ w := hq
  have hb : b ≠ w := fun e => hYw (by simp [e])
  have hy : y ≠ w := fun e => hYw (by simp [e])
  unfold narrowSignedRecord signedRecord signedAdd
  rw [hX, hY, hC]
  apply zt_suf_kx _ _ _ _ _ hcl
  apply zt_suf_kx
  · apply zt_pre_kx
    intro b1
    apply zt_suf_kx
    · apply zt_suf_kx
      · apply zt_pre_kx
        intro b2
        apply zt_suf_kx
        · apply zt_pre_kx
          intro b3
          exact ai_zt_kx a x x2 b y y2 c w xs ys cs hb hy hc _ _
        · exact map_tgt_kx _ (fun _ => rfl) _ w hXw
      · intro ins h
        simp only [skywalkSignToggle, List.mem_cons, List.not_mem_nil, or_false] at h
        rcases h with rfl | rfl | rfl <;> exact hq'
    · exact map_tgt_kx _ (fun _ => rfl) _ w hyd
  · intro ins h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with rfl; exact ha0







