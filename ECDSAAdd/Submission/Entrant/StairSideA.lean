/-!
# Division-endpoint loan: lift of `cellDecoderLoan_run_eq` through the endpoint wrappers

`endPacket760DivLoan` and `R2SqEp760.endPacket760 true` differ only in the decoder inside
`renameProgram (swap 760 717) ∘ renameProgram (shifted pi0) ∘ ControlLoan1589.loanWindow 510 2409 719`.
The lift follows the record's route (`endHalf_run_eq`, `rawEnd_run_eq`, `rawEnd_frame`,
`endPacket_frame`, `endPacket760_run_eq`) with same-record equalities at every layer, and uses
record independence of `endPacket760 true` (phase from `endPacket760_frame`) at the end.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.Rolling1588Lifetime

open Arithmetic MappedCompressed DirectSkywalk Secp256k1 BalancedField OffsetBorrowedCanonical
attribute [local irreducible] run wires

/-! ## Layer 3: the encoded frame -/

theorem rawEndLoan_far_or (q : Wire) (used : q ∈ wires rawEndLoan) :
    q ∈ wires (rawEnd true) ∨ (528 ≤ q ∧ (q < 1044 ∨ 1556 ≤ q)) := by
  simp only [rawEndLoan, ControlLoan1589.loanWindow, wires_append, Finset.mem_union,
    renameProgram_support, Finset.mem_image] at used
  rcases used with (h | ⟨w, hw, rfl⟩) | h
  · left
    simp only [rawEnd, ControlLoan1589.loanWindow, wires_append, Finset.mem_union]
    exact Or.inl (Or.inl h)
  · have far := endHalfLoan_far w hw
    by_cases e : w = base 719
    · left
      subst e
      rw [Equiv.swap_apply_left]
      simp only [rawEnd, ControlLoan1589.loanWindow, wires_append, Finset.mem_union]
      exact Or.inl (Or.inl (by simp [wires, Instr.wires]))
    · right
      have ne510 : w ≠ base 510 := by
        intro h
        have lo := far.1
        rw [h] at lo
        exact absurd lo (by decide)
      rw [Equiv.swap_apply_of_ne_of_ne e ne510]
      exact far
  · left
    simp only [rawEnd, ControlLoan1589.loanWindow, wires_append, Finset.mem_union]
    exact Or.inr h

theorem rawEndLoan_disjoint (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) :
    Disjoint (wires (Rolling1588.allEncode base isA 102)) (wires rawEndLoan) := by
  have old := endRaw_disjoint' isA true origin ctx
  apply Finset.disjoint_left.mpr
  intro q hq used
  rcases rawEndLoan_far_or q used with inR | far
  · exact Finset.disjoint_left.mp old hq inR
  · have f1 : (528 : Nat) ≤ (q : Nat) := far.1
    have f2 : (q : Nat) < 1044 ∨ (1556 : Nat) ≤ (q : Nat) := far.2
    have e : q = base (q - 16) :=
      (Nat.sub_add_cancel (Nat.le_trans (by decide : (16 : Nat) ≤ 528) f1)).symm
    have high : q - 16 < 1028 ∨ 1540 ≤ q - 16 := by
      rcases f2 with h | h
      · exact Or.inl (Nat.sub_lt_left_of_lt_add (Nat.le_trans (by decide : (16 : Nat) ≤ 528) f1) h)
      · exact Or.inr (Nat.le_sub_of_add_le h)
    rw [e] at hq
    exact allEncode_far' isA (q - 16) (Nat.le_sub_of_add_le f1) high hq

theorem rawEndLoan_encoded (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (hend : (Replay5.endPayload true origin (X,Y)).1=Y) (s : State) (m : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X Y s) :
    run rawEndLoan m s = run (rawEnd true) m s := by
  obtain ⟨raw,_,frame,encoded⟩ := input
  have outside (q : Nat) (hq : q=510 ∨ q=2400 ∨ q=2409) :
      raw.basis (base q)=origin (base q) := by
    apply frame.2.2
    · rw [balancedSharedPorts_r]
      exact OwnPlusHost.not_block q 2056 256 (by omega)
    · rw [balancedSharedPorts_y]
      exact OwnPlusHost.not_block q 770 256 (by omega)
  have directEnd : (X+(if raw.basis (base 510) then Y else -Y))/2=Y := by
    simpa only [Replay5.endPayload,mixedTranscriptBit,enabled,if_true,
      outside 510 (by simp)] using hend
  have loan := rawEndLoan_run_eq X Y raw m (raw_work_clean' origin ctx X Y raw frame)
    ((outside 2409 (by simp)).trans ctx.hg0) frame.1 frame.2.1 directEnd
  rw [encoded,
    ← run_disjoint_commute (Rolling1588.allEncode base isA 102) rawEndLoan
      (rawEndLoan_disjoint isA origin ctx) [] m raw,
    ← run_disjoint_commute (Rolling1588.allEncode base isA 102) (rawEnd true)
      (endRaw_disjoint' isA true origin ctx) [] m raw,
    loan]

/-! ## Layers 4–5: the two renamings -/

theorem endPacketLoan_run_eq (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (hend : (Replay5.endPayload true origin (X,Y)).1=Y) (s : State) (m : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X Y s) :
    run (renameProgram (shifted Placement5.pi0) rawEndLoan) m s =
      run (renameProgram (shifted Placement5.pi0) (rawEnd true)) m s := by
  have zeroIn := Rolling1588.encoded_zero_region base (base 2409) isA ctx.hn (ctx.hp _ (by simp))
    origin ctx.env ctx.legal X Y s input
  have fixS : pullState (shifted Placement5.pi0) s = s :=
    Placement5.shifted_zero_boundary Placement5.pi0 Placement5.pi0_outside s zeroIn
  apply pullState_perm_injective (shifted Placement5.pi0)
  rw [ECDSAAdd.run_rename _ (shifted Placement5.pi0).injective,
    ECDSAAdd.run_rename _ (shifted Placement5.pi0).injective, fixS]
  exact rawEndLoan_encoded isA origin ctx enabled X Y hend s m input

theorem endPacket760DivLoan_same_record (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400)=true)
    (X Y : Fp) (hend : (Replay5.endPayload true origin (X,Y)).1=Y) (s : State) (m : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X Y s) :
    run CompareDecoder.BoundaryLoan.endPacket760DivLoan m s =
      run (R2SqEp760.endPacket760 true) m s := by
  have fixS : pullState (Equiv.swap (base 760) (base 717)) s = s :=
    pullState_zero_swap (base 760) (base 717) s
      (R2SqEp760.encoded5_760 origin ctx X Y s input) (R2SqEp760.encoded5_717 origin ctx X Y s input)
  rw [endPacket760DivLoan_shape, endPacket760_true_shape]
  apply pullState_perm_injective (Equiv.swap (base 760) (base 717))
  rw [ECDSAAdd.run_rename _ (Equiv.swap (base 760) (base 717)).injective,
    ECDSAAdd.run_rename _ (Equiv.swap (base 760) (base 717)).injective, fixS]
  exact endPacketLoan_run_eq isA origin ctx enabled X Y hend s m input

end ECDSAAdd.Entrant.Rolling1588Lifetime

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic MappedCompressed BalancedField

/-- The loaned division endpoint runs as the record's division endpoint
(hypotheses as `R2SqEp760.endPacket760_run_eq` with `divide = true`). -/
theorem endPacket760DivLoan_run_eq (isA : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (enabled : origin (base 2400) = true)
    (X Y : Fp) (hend : (Replay5.endPayload true origin (X, Y)).1 = Y)
    (s : State) (m n : List Bool)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X Y s) :
    run endPacket760DivLoan m s = run (R2SqEp760.endPacket760 true) n s := by
  have phase : ∀ r, (run (R2SqEp760.endPacket760 true) r s).phase = s.phase := fun r =>
    (R2SqEp760.endPacket760_frame isA true origin ctx enabled X Y (fun _ => hend)
      (fun h => by cases h) s r input).1
  exact (Rolling1588Lifetime.endPacket760DivLoan_same_record isA origin ctx enabled X Y hend s m
    input).trans (StairDivLoanTop.tapeFree_of_phase _ s phase m n)

