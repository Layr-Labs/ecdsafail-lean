evaluation; the gate list itself is never built). -/
def k1ztLCA (lo width : Nat) : Nat → List Wire → List Wire → Wire → Wire → Nat → Nat
  | m, x::x'::xs, c::cs, cin, one, k =>
      ztM lo width
        (k1ztLCA lo width (ztM lo width m (literalConstStep (decide (k%2=1)) x cin c))
          (x'::xs) cs c one (k/2))
        (literalConstErase (decide (k%2=1)) x cin c one)
  | m, [x], _, cin, _, k => ztM lo width m (literalConstSum (decide (k%2=1)) x cin)
  | m, _, _, _, _, _ => m

theorem k1_ztM_lca (lo width : Nat) : ∀ (xs cs : List Wire) (cin one : Wire) (k m : Nat),
    ztM lo width m (literalConstAdd xs cs cin one k) = k1ztLCA lo width m xs cs cin one k
  | [], _, _, _, _, _ => rfl
  | [_], _, _, _, _, _ => rfl
  | _::_::_, [], _, _, _, _ => rfl
  | x::x'::xs, c::cs, cin, one, k, m => by
    show ztM lo width m (literalConstStep (decide (k%2=1)) x cin c ++
        literalConstAdd (x'::xs) cs c one (k/2) ++ literalConstErase (decide (k%2=1)) x cin c one) = _
    rw [k1_ztM_append, k1_ztM_append, k1_ztM_lca lo width (x'::xs) cs c one (k/2)]
    rfl

