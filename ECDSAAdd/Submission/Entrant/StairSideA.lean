  change carries = c :: cs at csplit
  have cleanHead : ∀ q ∈ c :: (cs ++ [unused]), v.basis q = false := by
    intro q hq
    apply carryView q
    change q ∈ carries ++ [unused]
    rw [csplit]
    simpa only [List.cons_append] using hq
  exact majorityClear_ready a b L760.sign c L760.parity L760.rmsb
    L760.one (cs ++ [unused]) v four cAway bAway parityC bC aC signC
    clearNe topNe pv topV cleanHead

private theorem rawTail_geometry :
    let carries := (Q6Structural.q6Carry L760).take 255
    let b := L760.r0
    let c := carries.getD 0 0
    let xs := L760.ylow.drop 1
    let ys := L760.rtail
    let cs := carries.drop 1
    let unused := L760.carry.getD 255 0
    xs.length = 254 ∧ ys.length = 254 ∧ cs.length = 254 ∧
      L760.one ≠ base 760 ∧ L760.one ≠ b ∧
      L760.rmsb ≠ base 760 ∧ L760.rmsb ≠ b ∧
      b ∉ cs ++ [unused] ∧
      (xs ++ [L760.ymsb] ++ ys ++ [L760.rmsb, L760.one] ++
        cs ++ [unused, c]).Nodup := by
  -- LT44 (replay budget): the big `Nodup` by a linear bit-mask scan (was 42 s by `decide`)
  intro carries b c xs ys cs unused
  -- K4-D (replay budget): the mask scan and the other facts in ONE kernel evaluation (shared layout lists)
  have all : ECDSAAdd.Entrant.StairLoan.nodupMask (L760.ylow.drop 1 ++ [L760.ymsb] ++ L760.rtail ++
      [L760.rmsb, L760.one] ++ ((Q6Structural.q6Carry L760).take 255).drop 1 ++
      [L760.carry.getD 255 0, ((Q6Structural.q6Carry L760).take 255).getD 0 0]) 0 = true ∧
      (L760.ylow.drop 1).length = 254 ∧ L760.rtail.length = 254 ∧
      (((Q6Structural.q6Carry L760).take 255).drop 1).length = 254 ∧
      L760.one ≠ base 760 ∧ L760.one ≠ L760.r0 ∧
      L760.rmsb ≠ base 760 ∧ L760.rmsb ≠ L760.r0 ∧
      L760.r0 ∉ ((Q6Structural.q6Carry L760).take 255).drop 1 ++ [L760.carry.getD 255 0] := by
    decide +kernel
  have nd : (L760.ylow.drop 1 ++ [L760.ymsb] ++ L760.rtail ++ [L760.rmsb, L760.one] ++
      ((Q6Structural.q6Carry L760).take 255).drop 1 ++
      [L760.carry.getD 255 0, ((Q6Structural.q6Carry L760).take 255).getD 0 0]).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ all.1
  have rest := all.2
  exact ⟨rest.1, rest.2.1, rest.2.2.1, rest.2.2.2.1, rest.2.2.2.2.1, rest.2.2.2.2.2.1,
    rest.2.2.2.2.2.2.1, rest.2.2.2.2.2.2.2, nd⟩

private theorem rawPulled_ready (u : State)
    (ready :
