/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSiteEasyGroups_at_StairSideA` -/
section Merge_StairSiteEasyGroups_at_StairSideA

/-!
# Field 12 on CANON 1945: the 14 hosted packet groups (LT35)

See `StairSiteEasyGroupsBase` for the method.  Labels of a hosted group are hosts
(fresh: LT25 `hostPlan_group_fresh`; `TPI` by `hostFacts`) or non-rebound labels of the
placed loaned group.  Those are `Mj j z` for a packet `j` and a label `z` of the
loaned base packet: fixed letters / `swapBody` labels (`fixedTable`), history code
images (`codeTable`), or a placed label of a loaned half, which by LT9's
`half760Loan_support760` is a record half760 label (`half760_in`) outside the loaned
roles `retiredRoles.take d = exclusiveRoles.take d` (`halfTable0`, `halfSpecTable`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance

theorem tgt_of_list {d j : Nat} {P : Program} (L : List Wire) (hP : ∀ z ∈ wires P, z ∈ L)
    (hL : ∀ z ∈ L, GC (Mj j z)) : Tgt d j P := by
  intro z hz
  have g := hL z (hP z hz)
  exact ⟨fun m => g.1 (List.mem_of_mem_take m), Or.inr g.2⟩

theorem tgt_fixed {d j : Nat} {P : Program} (hj : j ∈ List.range' 1 101)
    (hP : ∀ z ∈ wires P, z ∈ fixedL j) : Tgt d j P :=
  tgt_of_list (fixedL j) hP (fun z hz => fixedTable j hj z hz)

theorem tgt_swapBody {d j : Nat} (hj : j ∈ List.range' 1 101) :
    Tgt d j FrontierSW1591.swapBody := by
  intro z hz
  have sw := swapBody_in z hz
  have g : GC (Mj j z) := by
    by_cases hs : z ∈ piSpec j
    · exact swSpecTable j hj z hs sw
    · rw [Mj_eq j z hs]
      exact swTable z (swI_mem sw)
  exact ⟨fun m => g.1 (List.mem_of_mem_take m), Or.inr g.2⟩

theorem tgt_onPacket {d j : Nat} {X : Program} (hj : j ∈ List.range' 1 101)
    (hX : allSites (fun z => decide (z < 10)) X = true) : Tgt d j (Rolling1588.onPacket j X) := by
  intro x hx
  unfold Rolling1588.onPacket at hx
  rw [renameProgram_support] at hx
  obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
  have g := codeTable j hj z (small_code X hX z hz)
  exact ⟨fun m => g.1 (List.mem_of_mem_take m), Or.inr g.2⟩

theorem retired_take (d : Nat) (hd : d ≤ 44) :
    StairLoan.retiredRoles.take d = StairSchedule.exclusiveRoles.take d := by
  have e : StairLoan.retiredRoles = StairSchedule.exclusiveRoles ++
      (List.range' 696 24).map base := by
    decide +kernel
  rw [e, List.take_append_of_le_length (by rw [StairSchedule.exclusiveRoles_length]; exact hd)]

theorem tgt_half {d j a : Nat} {divide : Bool} (hj : j ∈ List.range' 1 101) (ha : a ∈ [3, 4])
    (hd : d ≤ 44) :
    Tgt d j (renameProgram (Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j a))
      (renameProgram (Equiv.swap (base 719) (Rolling1588.s j 2))
        (StairLoanAdapter.concreteHalf760Loan divide d))) := by
  intro z hz
  rw [renameProgram_support] at hz
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
  rw [renameProgram_support] at hy
  obtain ⟨h, hh, rfl⟩ := Finset.mem_image.mp hy
  have f5 := StairLoanSupport.half760Loan_support760 d divide (by omega) hh
  rw [Finset.mem_sdiff, StairLoan.half760Loan_zero] at f5
  have hI : HalfI h := half760_in divide h f5.1
  have notTake : h ∉ StairSchedule.exclusiveRoles.take d := by
    rw [← retired_take d hd]
    exact fun m => f5.2 (List.mem_toFinset.mpr m)
  have hc : HC j a h := by
    by_cases hs : h ∈ specW j a
    · exact halfSpecTable j hj a ha h hs hI
    · have e := halfPlace_eq j a h hs
      have n719 : h ≠ base 719 := fun e => hs (by rw [e]; simp [specW])
      have t := halfTable0 h (halfI_mem hI) n719
      unfold HC
      unfold HC0 at t
      rw [e]
      exact t
  rcases hc with ⟨hr, he⟩ | g
  · change halfPlace j a h ∉ _ ∧ (halfPlace j a h ∈ _ ∨ _)
    rw [he]
    exact ⟨notTake, Or.inl hr⟩
  · exact ⟨fun m => g.1 (List.mem_of_mem_take m), Or.inr g.2⟩

theorem tgt_fixedAll {d j : Nat} {P : Program} (hj : j ∈ List.range' 1 101)
    (h : allSites (fun z => decide (z ∈ fixedL j)) P = true) : Tgt d j P :=
  tgt_fixed hj (fun z hz => of_decide_eq_true (allSites_sound h z hz))

theorem tgt_halfWindow {d j a : Nat} {divide : Bool} (hj : j ∈ List.range' 1 101)
    (ha : a ∈ [3, 4]) (hd : d ≤ 44) : Tgt d j (StairGroups.halfWindow divide d j a 2) := by
  unfold StairGroups.halfWindow ControlLoan1589.loanWindow
  rw [tgt_append, tgt_append]
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl
  · exact ⟨⟨tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL]),
      tgt_half hj (by decide) hd⟩, tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL])⟩
  · exact ⟨⟨tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL]),
      tgt_half hj (by decide) hd⟩, tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL])⟩

theorem tgt_selW {d j a : Nat} (hj : j ∈ List.range' 1 101) (ha : a ∈ [3, 4]) :
    Tgt d j (SW.selW (Rolling1588.s j a) (base 2409) FrontierSW1591.swapBody) := by
  unfold SW.selW
  rw [tgt_append, tgt_append]
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl
  · exact ⟨⟨tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL]), tgt_swapBody hj⟩,
      tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL])⟩
  · exact ⟨⟨tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL]), tgt_swapBody hj⟩,
      tgt_fixedAll hj (by simp [allSites, instrWs, corrWs, fixedL])⟩

section
attribute [local irreducible] SW.selW Rolling1588.onPacket StairGroups.halfWindow

theorem basePacket_tgt (divide : Bool) (d j : Nat) (hj : j ∈ List.range' 1 101) (hd : d ≤ 44) :
    Tgt d j (StairGroups.basePacket divide d j) := by
  cases divide <;>
    simp only [StairGroups.basePacket, StairGroups.cell, Bool.false_eq_true, ↓reduceIte,
      tgt_append] <;>
    repeat' constructor
  all_goals first
    | exact tgt_halfWindow hj (by decide) hd
    | exact tgt_selW hj (by decide)
    | exact tgt_onPacket hj (by decide +kernel)

end

/-! ## The hosted groups -/

/-- The scheduled groups (both directions use the same seven triples). -/
def schedule : List (Nat × Nat × Nat) :=
  [(0, 1, 84), (14, 85, 5), (23, 90, 3), (31, 93, 3), (37, 96, 2), (42, 98, 2), (44, 100, 2)]

theorem schedule_bounds : ∀ g ∈ schedule, g.1 ≤ 44 ∧ 1 ≤ g.2.1 ∧ g.2.1 + g.2.2 ≤ 102 := by
  decide

/-- Host facts for the scheduled deficits (`hp.group` is direction-independent). -/
theorem hostFacts : ∀ g ∈ schedule,
    (∀ r ∈ StairSchedule.exclusiveRoles.drop g.1, r ∉ hp.group true g.1 g.2.1 g.2.2) ∧
    (StairSchedule.exclusiveRoles.drop g.1).Nodup ∧ (hp.group true g.1 g.2.1 g.2.2).Nodup ∧
    (StairSchedule.exclusiveRoles.drop g.1).length ≤ (hp.group true g.1 g.2.1 g.2.2).length ∧
    ∀ h ∈ hp.group true g.1 g.2.1 g.2.2, TPI h := by
  decide +kernel

theorem group_dir (divide : Bool) (d f c : Nat) :
    hp.group divide d f c = hp.group true d f c := rfl

theorem hostsFresh (divide : Bool) (d f c : Nat) (hg : (d, f, c) ∈ schedule) :
    ∀ q ∈ hp.group divide d f c,
      q ∉ wires (StairSchedule.placedGroups StairConcrete.bestLoans divide d f c) := by
  by_cases h44 : d = 44
  · subst h44
    intro q hq
    simp [hp, StairConcreteAssembly.hostPlan, StairV3Primitives.hostPlan] at hq
  · apply StairField13V3Fresh.hostPlan_group_fresh divide d f c
    simp only [schedule, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hg ⊢
    omega

theorem hostedGroup39 (divide : Bool) (d f c : Nat) (hg : (d, f, c) ∈ schedule) :
    PieceOK StairCertificate.holes39 TP (StairHostsSchedule.hostedGroup hp divide d f c) := by
  obtain ⟨hd, hf, hc⟩ := schedule_bounds _ hg
  obtain ⟨disj, nr, nh, hlen, htpi⟩ := hostFacts _ hg
  simp only at hd hf hc disj nr nh hlen htpi
  rw [← group_dir divide] at disj nh hlen htpi
  apply ok39_of_tpi
  intro x hx
  unfold StairHostsSchedule.hostedGroup at hx
  rcases rebind_mem _ _ _ (hostsFresh divide d f c hg) disj nr nh hlen x hx with hh | ⟨hP, hnr⟩
  · exact htpi x hh
  · change x ∈ wires (renameProgram (OB5.sig 511) (StairGroups.groups divide d f c)) at hP
    rw [renameProgram_support] at hP
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hP
    obtain ⟨j, hj1, hj2, hjw⟩ := seq_mem divide (StairGroups.packet divide d) c f w hw
    unfold StairGroups.packet at hjw
    rw [renameProgram_support] at hjw
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hjw
    have hjr : j ∈ List.range' 1 101 := List.mem_range'_1.mpr ⟨by omega, by omega⟩
    obtain ⟨nt, hr⟩ := basePacket_tgt divide d j hjr hd z hz
    rcases hr with hr | hr
    · exfalso
      rw [← List.take_append_drop d StairSchedule.exclusiveRoles, List.mem_append] at hr
      rcases hr with hr | hr
      · exact nt hr
      · exact hnr hr
    · exact hr

theorem groups39 : ∀ g ∈ entryGroups,
    PieceOK StairCertificate.holes39 TP (StairHostsSchedule.hostedGroup hp true g.1 g.2.1 g.2.2) := by
  intro g hg
  exact hostedGroup39 true g.1 g.2.1 g.2.2 (by
    simp only [entryGroups, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)

theorem groupsExit39 : ∀ g ∈ exitGroups,
    PieceOK StairCertificate.holes39 TP (StairHostsSchedule.hostedGroup hp false g.1 g.2.1 g.2.2) := by
  intro g hg
  exact hostedGroup39 false g.1 g.2.1 g.2.2 (by
    simp only [exitGroups, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)

