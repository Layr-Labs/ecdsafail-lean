theorem slices_false_sub : ∀ (L : List (Nat × Nat × Nat)) (c low : Nat),
    BackwardChain c low L →
    wires (renameProgram (OB5.sig 511) (slices StairConcrete.bestLoans false L)) ⊆
      wires (renameProgram (OB5.sig 511) (slices StairSchedule.recordLoans false L))
  | [], _, _, _ => by
      -- LT50 (replay budget): both empty slices to `[]` separately (the simp cast compared the two
      -- loan providers `bestLoans` / `recordLoans` field by field in the kernel: 47 s)
      intro q hq
      rw [show slices StairConcrete.bestLoans false [] = [] from rfl] at hq
      rw [show slices StairSchedule.recordLoans false [] = [] from rfl]
      exact hq
  | (d, j, n) :: rest, _, low, chain => by
      obtain ⟨_, hd, _, _, hr⟩ := chain
      have g := StairLoanGroupSupport.placedGroups_sub false d hd j n
      unfold StairSchedule.placedGroups at g
      simp only [slices, rename_append', wires_append]
      exact Finset.union_subset_union g (slices_false_sub rest j low hr)

theorem headShape_sub (L : List (Nat × Nat × Nat)) (c low : Nat)
    (chain : BackwardChain c low L) :
