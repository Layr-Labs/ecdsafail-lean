section Merge_StairCertificate_at_StairSideA

/-!
# Final staircase certificate boundary

This module keeps the final outer program as data because the record wrapper
has not yet selected the new kernels.  Every circuit-local fact has its own
named field, while the outer wrapper composition remains a separate premise.
The certificate proof itself uses the checked staircase ledgers, omission
inventory, and normalizer theorems.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCertificate

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines



/-- CANON v3 certificate bounds with qubit bound `q`.  T and M are LOOSE
(coordinator / RV6 G4: final program ≈ 2,169,611 T / 1,520,902 M), so late
endpoint swaps cannot break field 10; slots = 50,515,743 + `bestSlotDelta`. -/
def v3Bounds (q : Nat) : Challenge.Bounds := ⟨2170000, 1521500, q, 51155937⟩





/-- One direction of the positive-depth half replay theorem. -/
def PositiveHalfRunSpec (divide : Bool) : Prop :=
  ∀ d, 0 < d → d ≤ 68 → ∀ origin,
    Q6EndpointCell.Clean base origin → ∀ X Y s fresh old,
    PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis →
    run (StairLoan.half760Loan d divide) fresh s =
      run (Q6EndpointCell.half divide base (base 2409)) old s

/-- The whole-half omission theorem still required from the support worker. -/
def WholeHalfSupport : Prop :=
  ∀ divide d, d ≤ 68 →
    wires (StairLoan.half760Loan d divide) ⊆
      wires (Q6EndpointCell.half divide base (base 2409)) \
        (StairLoan.retiredRoles.take d).toFinset


/-! ## Qubit bound, parametric in the proved hole list

`HoleList holes` are static facts about a concrete list of omitted arena
sites (decidable); `HolePlacement holes P` says the program avoids the 15
record omissions and every listed hole.  The bound is
`qubits P ≤ 1601 − 15 − holes.length`, so a partial field 12 (fewer holes
proved free) still yields a valid, smaller improvement; the full v3 placement
is `holes = StairPhysicalInventory.physicalHoles` (44 holes, Q = 1,542, see
`StairCertificateV3`). -/

structure HoleList (holes : List Wire) : Prop where
  nodup : holes.Nodup
  inside : ∀ q ∈ holes, q ∈ StairHoleSupport.recordArena
  ioFree : ∀ q ∈ holes, q ∉ ioWires
  disjoint : StairHoleSupport.oldHoles.Disjoint holes

structure HolePlacement (holes : List Wire) (P : Program) : Prop where
  insideArena : ioWires ∪ wires P ⊆ StairHoleSupport.recordArena.toFinset
  oldFree : ∀ q ∈ StairHoleSupport.oldHoles, q ∉ wires P
  holesFree : ∀ q ∈ holes, q ∉ wires P

theorem qubits_le_holes (holes : List Wire) (hl : HoleList holes) (P : Program)
    (h : HolePlacement holes P) :
    qubits P ≤ 1586 - holes.length := by
  have nd : (StairHoleSupport.oldHoles ++ holes).Nodup :=
    List.nodup_append'.mpr ⟨StairHoleSupport.oldHoles_nodup, hl.nodup, hl.disjoint⟩
  have bound := StairInventory.qubits_with_omissions P
    (StairHoleSupport.oldHoles ++ holes) h.insideArena ?free ?inside nd
  · rw [List.length_append, StairHoleSupport.oldHoles_length] at bound
    omega
  · intro q hq used
    rcases List.mem_append.mp hq with old | new
    · rcases Finset.mem_union.mp used with io | program
      · exact StairHoleSupport.oldHoles_io_free q old io
      · exact h.oldFree q old program
    · rcases Finset.mem_union.mp used with io | program
      · exact hl.ioFree q new io
      · exact h.holesFree q new program
  · intro q hq
    rcases List.mem_append.mp hq with old | new
    · exact StairHoleSupport.oldHoles_inside q old
    · exact hl.inside q new










end ECDSAAdd.Entrant.StairCertificate

end
end Merge_StairCertificate_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Replay_at_StairSideA` -/
section Merge_StairField2V3Replay_at_StairSideA

/-!
# LT21: generic replay composition for field 2 (CANON v3)

The generic part of `StairCheckpointReplay` (from `RunEqOn` to
`checkpoint_composition`, verbatim) — that module's old eight-row section no
longer builds on v3 (`row_budget_mem` names the old budgets) — together with
LT14's placement-independent tape algebra (`StairChainAlgebra`) and
relational steps (`StairChainSteps`), in one namespace.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3Replay

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

def RunEqOn (pre : State → Prop) (selected reference : Program) : Prop :=
  ∀ s, pre s → ∀ fresh old,
    run selected fresh s = run reference old s

structure ReplayStep (pre post : State → Prop)
    (selected reference : Program) : Prop where
  run_eq : RunEqOn pre selected reference
  reference_post : ∀ s, pre s → ∀ records, post (run reference records s)

inductive ReplayChain : (State → Prop) → (State → Prop) →
    List Program → List Program → Prop where
  | nil (pre : State → Prop) : ReplayChain pre pre [] []
  | cons {pre middle post : State → Prop}
      {selected reference : Program} {selectedRest referenceRest : List Program}
      (step : ReplayStep pre middle selected reference)
      (rest : ReplayChain middle post selectedRest referenceRest) :
      ReplayChain pre post (selected :: selectedRest)
        (reference :: referenceRest)

def concatPrograms : List Program → Program
  | [] => []
  | P :: Ps => P ++ concatPrograms Ps

theorem replayChain_run_eq {pre post : State → Prop}
    {selected reference : List Program}
    (chain : ReplayChain pre post selected reference) :
    RunEqOn pre (concatPrograms selected) (concatPrograms reference) := by
  induction chain with
  | nil pred =>
      intro s _ fresh old
      rfl
  | @cons before middle after P Q Ps Qs step rest ih =>
      intro s hs fresh old
      simp only [concatPrograms, run_append]
      have first := step.run_eq s hs
        (fresh.take (measurementCount P))
        (old.take (measurementCount Q))
      have middleState : middle
          (run Q (old.take (measurementCount Q)) s) :=
        step.reference_post s hs (old.take (measurementCount Q))
      rw [first]
      exact ih (run Q (old.take (measurementCount Q)) s) middleState
        (fresh.drop (measurementCount P)) (old.drop (measurementCount Q))
















/-! ## Measurement tapes -/






/-- Tape independence of one program on one state. -/
def TapeFree (P : Program) (s : State) : Prop :=
  ∀ m n, run P m s = run P n s

theorem tapeFree_of_phase (P : Program) (s : State)
    (phase : ∀ m, (run P m s).phase = s.phase) : TapeFree P s := by
  intro m n
  apply State.extensionality
  · exact (phase m).trans (phase n).symm
  · exact ECDSAAdd.Arithmetic.run_basis_records P s s m n rfl

/-- Nested runs of the two halves of a tape-free concatenation do not depend
on either tape. -/
theorem nested_tapeFree (P Q : Program) (s : State)
    (free : TapeFree (P ++ Q) s) (m n m' n' : List Bool) :
    run Q n (run P m s) = run Q n' (run P m' s) := by
  rw [nested_run_eq_append, nested_run_eq_append]
  exact free _ _








end ECDSAAdd.Entrant.StairField2V3Replay

end
end Merge_StairField2V3Replay_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Couple_at_StairSideA` -/
section Merge_StairField2V3Couple_at_StairSideA

/-!
# LT21: coupled simulation chains (generic, placement independent)

A *coupled* step relates a selected run with **some** reference run:
`CRel pre post P Q := ∀ s t, pre s t → ∀ fresh, ∃ old, post (run P fresh s) (run Q old t)`.
Because the reference kernels are tape-free on their inputs, an existential
reference tape is enough (`runEqOn_of_coupled`).

The point of the existential tape: a program shared by both sides can be run
with the *same* tape on both, so it preserves agreement outside a difference
set `Δ` by pure locality (`shared_step`) — no phase lemma about the record
state is needed, only that the program avoids `Δ`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Couple

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open StairField2V3Replay


theorem crel_append {A B C : State → State → Prop} {P Q P' Q' : Program}
    (h1 : CRel A B P Q) (h2 : CRel B C P' Q') : CRel A C (P ++ P') (Q ++ Q') := by
  intro s t hst fresh
  obtain ⟨o1, h1'⟩ := h1 s t hst (fresh.take (measurementCount P))
  obtain ⟨o2, h2'⟩ := h2 _ _ h1' (fresh.drop (measurementCount P))
  refine ⟨padTape (measurementCount Q) o1 ++ o2, ?_⟩
  rw [run_append, ← nested_run_eq_append]
  exact h2'





/-- From a coupled chain ending in equality and a tape-free reference, the
run equality for independent tapes. -/
theorem runEqOn_of_coupled {pre : State → Prop} {P Q : Program}
    (chain : CRel (fun s t => pre s ∧ s = t) Eq P Q)
    (refFree : ∀ s, pre s → TapeFree Q s) :
    RunEqOn pre P Q := by
  intro s hs fresh old
  obtain ⟨o, ho⟩ := chain s s ⟨hs, rfl⟩ fresh
  rw [ho]
  exact refFree s hs o old

/-! ## Agreement outside a difference set -/







