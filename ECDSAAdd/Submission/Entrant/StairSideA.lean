theorem firstPacket_avoid_payload (divide : Bool) (B : Nat) (hB : B ∈ budgets) :
    ∀ r ∈ futurePayload B, r ∉ wires (Rolling1588.placedFirstPacket divide) := by
  intro r hr hw
  have h1 := Rolling1588.placedFirstPacket_old_support divide hw
  have h2 := ControlLoan1589.placedFirstPacket_support divide h1
  have h3 := Prefix1590.placedFirstPacket_support divide h2
  rw [renameProgram_support] at h3
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp h3
  rw [FrontierSW1591.first_support_eq] at hq
  have h4 := (OneFlagSW.selFirstPacket_sel divide).sub.wires_sub hq
  have h5 := OneFlagReplay.firstPacket_subset_old divide h4
