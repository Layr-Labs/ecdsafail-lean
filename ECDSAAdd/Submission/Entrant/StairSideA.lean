/-! ### K2 (replay budget): the e-fill pieces by their support, not by a scan

`fillIn_free`/`fillOut_free` were one `decide +kernel` scan each (41 s / 36 s of kernel time: the kernel builds the
~3,900 gates of the early-H accumulation and tests 40 wires per gate).  The holes sit in `accZ` beyond index 29,
and the early H terms (shift 4/10/6/32 of the 130-wire `eReg`) pad with at most `accZ.take 29`, so the record's
register-level support lemma (`Acc.sbuild_support`) applied with `Z := (accZ L).take 29` already excludes them;
only the 40-wire disjointness against that support list is checked concretely (bit mask). -/
section K2FillSec
set_option maxRecDepth 100000


namespace K2Fill

theorem tx_take (Z : List Wire) (K w : Nat) (f : MeasuredSquareFold) (h : w-f.shift-f.src.length≤K) :
    Acc.tx (Z.take K) w f=Acc.tx Z w f := by
  simp only [Acc.tx,List.take_take,Nat.min_eq_left h]

theorem fits_take (acc Z bank : List Wire) (cin : Wire) (w K : Nat) (f : MeasuredSquareFold)
    (hf : Acc.Fits acc Z bank cin w f) (hK : w-f.shift-f.src.length≤K) :
    Acc.Fits acc (Z.take K) bank cin w f := by
  refine ⟨⟨hf.len,?_,hf.bankLen⟩,?_⟩
  · rw [List.length_take]
    exact Nat.le_min.mpr ⟨hK,hf.zpad⟩
  · have s : (cin::(f.src++acc++Z.take K++bank)).Sublist (cin::(f.src++acc++Z++bank)) :=
      List.Sublist.cons₂ cin (((List.Sublist.refl (f.src++acc)).append (List.take_sublist K Z)).append
        (List.Sublist.refl bank))
    exact hf.nd.sublist s

theorem early_take (acc Z bank : List Wire) (cin : Wire) (src : List Wire) (K : Nat)
    (hs : src.length=130) (hK : 29≤K) :
    Acc.sbuild acc (Z.take K) bank cin 163 (earlyHTerms src)=Acc.sbuild acc Z bank cin 163 (earlyHTerms src) ∧
    Acc.sunbuild acc (Z.take K) bank cin 163 (earlyHTerms src)=Acc.sunbuild acc Z bank cin 163 (earlyHTerms src) := by
  have e4 := tx_take Z K 163 (Acc.earlyTerm src false 4) (by simp only [Acc.earlyTerm,hs]; omega)
  have e10 := tx_take Z K 141 (Acc.earlyTerm src false 10) (by simp only [Acc.earlyTerm,hs]; omega)
  have e6 := tx_take Z K 141 (Acc.earlyTerm src true 6) (by simp only [Acc.earlyTerm,hs]; omega)
  have e32 := tx_take Z K 163 (Acc.earlyTerm src false 32) (by simp only [Acc.earlyTerm,hs]; omega)
  have e10' := tx_take Z K 163 (Acc.earlyTerm src false 10) (by simp only [Acc.earlyTerm,hs]; omega)
  have e6' := tx_take Z K 163 (Acc.earlyTerm src true 6) (by simp only [Acc.earlyTerm,hs]; omega)
  simp only [Acc.sbuild,Acc.sunbuild,earlyHTerms,Acc.earlyBuild,Acc.earlyUnbuild,Acc.baseBuild,Acc.baseUnbuild,
    Acc.build,Acc.unbuild,Acc.earlyPrefix,Acc.earlyPrefixClear,Acc.seedOp,Acc.op,Acc.earlyTerm_src,
    e4,e10,e6,e32,e10',e6',and_self]

/-- Support of the B body's e-fill pieces: the sources, the accumulator, the first 29 wires of `accZ`
(the early H terms pad by at most 29), the bank, and `cin`. -/
def efillS (L : CuccaroStreamedSquareWideLayout) : List Wire :=
  L.core.cin::(eReg L++accReg L++(accZ L).take 29++accBank L)

theorem efill_support (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    wires (OwnDiagAll12Square.fillInK L (eItem L))⊆(efillS L).toFinset ∧
    wires (SourceFourPrefix130Develop.fillOutKnown L (eItem L))⊆(efillS L).toFinset := by
  have st := eItem_static L hw
  have rel := SourceFourPrefix130Develop.fillKnown_rel L hw (eItem L) st.2.1
  have hl := eReg_length L hw
  have hacc := (acc_lengths L hw).1
  have tm : (eItem L).terms=earlyHTerms (eReg L) := rfl
  have hfits : ∀f∈earlyHTerms (eReg L),Acc.Fits (accReg L) ((accZ L).take 29) (accBank L) L.core.cin 163 f := by
    intro f hf
    have h0 := fits_of L hw hn f (st.1 f (tm ▸ hf)) (st.2.1 f (tm ▸ hf))
    apply fits_take _ _ _ _ _ _ _ h0
    simp only [earlyHTerms,List.mem_cons,List.not_mem_nil,or_false] at hf
    rcases hf with rfl|rfl|rfl|rfl <;> simp only [Acc.earlyTerm,hl] <;> omega
  have hS : ∀f∈earlyHTerms (eReg L),(L.core.cin::(f.src++accReg L++(accZ L).take 29++accBank L)).toFinset⊆
      (efillS L).toFinset := by
    intro f hf
    simp only [earlyHTerms,List.mem_cons,List.not_mem_nil,or_false] at hf
    rcases hf with rfl|rfl|rfl|rfl <;> exact Finset.Subset.refl _
  have sup := Acc.sbuild_support (accReg L) ((accZ L).take 29) (accBank L) L.core.cin 163 hacc
    (earlyHTerms (eReg L)) hfits _ hS
  have eqs := early_take (accReg L) (accZ L) (accBank L) L.core.cin (eReg L) 29 hl (Nat.le_refl _)
  rw [eqs.1,eqs.2] at sup
  have t0 : tempIn L (eItem L)=[] := rfl
  have t1 : tempOut L (eItem L)=[] := rfl
  have s0 : splitIn L (eItem L)=[] := rfl
  have s1 : splitOut L (eItem L)=[] := rfl
  have fI : wires (fillIn L (eItem L))⊆(efillS L).toFinset := by
    rw [fillIn,t0,t1,s0,s1,tm]
    simpa only [List.nil_append,List.append_nil] using sup.1
  have fO : wires (fillOut L (eItem L))⊆(efillS L).toFinset := by
    rw [fillOut,t0,t1,s0,s1,tm]
    simpa only [List.nil_append,List.append_nil] using sup.2
  exact ⟨rel.1.2.2.1.trans fI,rel.2.2.2.1.trans fO⟩

end K2Fill


end K2FillSec



section K2SubSec
set_option maxRecDepth 100000

namespace K2Sub
attribute [local irreducible] ECDSAAdd.wires

theorem subTop_support (h r cs : List Wire) (cin z u v k : Wire) (hl : (h++[z]).length=(r++[u]).length)
    (hc : cs.length+1=(r++[u]).length) :
    wires (KnownTopAdd.subTop h r cs cin z u v k)⊆(k::cin::(h++[z]++(r++[u])++cs++[v])).toFinset := by
  have e : KnownTopAdd.subTop h r cs cin z u v k=[Instr.measureX k [] []]++
      (subInPlace (h++[z]) (r++[u]) cs cin++[Instr.CX u v]) := rfl
  have w1 : wires [Instr.measureX k [] []]={k} := by
    simp [wires,Instr.wires,correctionWires]
  have w2 : wires [Instr.CX u v]={u,v} := by
    simp [wires,Instr.wires]
  rw [e,wires_append,wires_append,subInPlace,wires_append,wires_append,notRegister_wires,
    addInPlace_wires _ _ _ _ hl hc,w1,w2]
  intro q hq
  apply List.mem_toFinset.mpr
  simp only [Finset.mem_union,Finset.mem_singleton,Finset.mem_insert,List.mem_toFinset,List.mem_cons,
    List.mem_append] at hq ⊢
  tauto

end K2Sub


end K2SubSec



/-- K4-D (replay budget): `mid_in_layout` for every layout (no list evaluation). -/
theorem K4DQ.mid_wires (L : CuccaroStreamedSquareWideLayout) :
    ∀ q ∈ (coreB L).out ++ (coreB L).carry ++ [(coreB L).high, (coreB L).cin, (coreB L).flag] ++
      ECDSAAdd.Entrant.accReg L, q ∈ L.wires := by
  have sc : ∀ q, q ∈ L.core.wires → q ∈ L.wires := fun q h => List.mem_append_left _ h
  have sw : ∀ q, q ∈ L.core.work → q ∈ L.wires := fun q h =>
    sc q (by simp [CuccaroStreamedSquareLayout.wires, h])
  have so : ∀ q, q ∈ L.core.out → q ∈ L.wires := fun q h =>
    sc q (by simp [CuccaroStreamedSquareLayout.wires, h])
  have sf : ∀ q, q ∈ L.foldPad → q ∈ L.wires := by
    intro q h
    rcases List.mem_append.mp h with h | h
    · exact sc q (by simp [CuccaroStreamedSquareLayout.wires, h])
    · exact List.mem_append_right _ h
  intro q hq
  rcases List.mem_append.mp hq with hq | hq
  · rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · exact so q hq
      · simp only [coreB, carryB, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hq
        rcases hq with h | h | h | h | h | h | h
        · exact sf q (List.mem_of_mem_take h)
        · exact sw q (List.mem_of_mem_drop (List.mem_of_mem_take h))
        · exact sf q (List.mem_of_mem_drop (List.mem_of_mem_take h))
        · exact sw q (List.mem_of_mem_drop (List.mem_of_mem_drop (List.mem_of_mem_take h)))
        · exact sf q (List.mem_of_mem_drop h)
        · subst h; exact sc _ (by simp [CuccaroStreamedSquareLayout.wires])
        · subst h; exact sc _ (by simp [CuccaroStreamedSquareLayout.wires])
    · simp only [coreB, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with h | h | h <;> (subst h; exact sc _ (by simp [CuccaroStreamedSquareLayout.wires]))
  · exact sw q (List.mem_of_mem_take hq)


/-! ### K4-D (replay budget): the per-bit slot counts as literals

`LT48B.majS b` etc. evaluate a small program per bit; `K4DS.majC` etc. are their values by the shape of the
bit, and `addC`/`eltC`/`elC`/`skC`/`esC` the same recursions as `addS`/... with those literals. -/
namespace K4DS
open LT48B

def majC : MappedBit → Nat
  | ⟨none, false⟩ => 1 | ⟨none, true⟩ => 3 | ⟨some _, false⟩ => 6 | ⟨some _, true⟩ => 8
def ecC : MappedBit → Nat
  | ⟨none, false⟩ => 2 | ⟨none, true⟩ => 4 | ⟨some _, false⟩ => 4 | ⟨some _, true⟩ => 6
def sumC : MappedBit → Nat
  | ⟨none, false⟩ => 1 | ⟨none, true⟩ => 2 | ⟨some _, false⟩ => 2 | ⟨some _, true⟩ => 3
def bmC : MappedBit → Nat
  | ⟨none, false⟩ => 3 | ⟨none, true⟩ => 5 | ⟨some _, false⟩ => 8 | ⟨some _, true⟩ => 10
def emC : MappedBit → Nat
  | ⟨none, false⟩ => 4 | ⟨none, true⟩ => 6 | ⟨some _, false⟩ => 6 | ⟨some _, true⟩ => 8

theorem majC_eq (b : MappedBit) : majS b = majC b := by rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem ecC_eq (b : MappedBit) : ecS b = ecC b := by rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem sumC_eq (b : MappedBit) : sumS b = sumC b := by rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem bmC_eq (b : MappedBit) : bmS b = bmC b := by rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem emC_eq (b : MappedBit) : emS b = emC b := by rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem bmaj_val : bmajS = 8 := rfl
theorem eb_val : ebS = 6 := rfl

def addC : List MappedBit → List Wire → List Wire → Nat
  | b::b'::bits, _::y'::ys, _::cs => majC b + addC (b'::bits) (y'::ys) cs + ecC b + sumC b
  | [b], [_], _ => sumC b
  | _, _, _ => 0

theorem addC_eq : ∀ (bs : List MappedBit) (ys cs : List Wire), addS bs ys cs = addC bs ys cs
  | b::b'::bits, y::y'::ys, d::ds => by
    simp only [addS, addC, addC_eq (b'::bits) (y'::ys) ds, majC_eq, ecC_eq, sumC_eq]
  | [b], [y], cs => by simp only [addS, addC, sumC_eq]
  | [], _, _ => rfl
  | [_], [], _ => rfl
  | [_], _::_::_, _ => rfl
  | _::_::_, [], _ => rfl
  | _::_::_, [_], _ => rfl
  | _::_::_, _::_::_, [] => rfl

def eltC : List Wire → List MappedBit → List Wire → Nat
  | _::a'::as, b::b'::bs, _::cs => bmC b + eltC (a'::as) (b'::bs) cs + emC b
  | [_], [b], _ => emC b
  | _, _, _ => 0

theorem eltC_eq : ∀ (as : List Wire) (bs : List MappedBit) (cs : List Wire), eltS as bs cs = eltC as bs cs
  | a::a'::as, b::b'::bs, c::cs => by
    simp only [eltS, eltC, eltC_eq (a'::as) (b'::bs) cs, bmC_eq, emC_eq]
  | [a], [b], cs => by simp only [eltS, eltC, emC_eq]
  | [], _, _ => rfl
  | [_], [], _ => rfl
  | [_], _::_::_, _ => rfl
  | _::_::_, [], _ => rfl
  | _::_::_, [_], _ => rfl
  | _::_::_, _::_::_, [] => rfl

def elC : List Wire → List Wire → List Wire → Nat
  | _::a'::as, _::b'::bs, _::cs => 8 + elC (a'::as) (b'::bs) cs + 6
  | [_], [_], _ => 6
  | _, _, _ => 0

theorem elC_eq : ∀ (as bs cs : List Wire), elS as bs cs = elC as bs cs
  | a::a'::as, b::b'::bs, c::cs => by
    simp only [elS, elC, elC_eq (a'::as) (b'::bs) cs, bmaj_val, eb_val]
  | [a], [b], cs => by simp only [elS, elC, eb_val]
  | [], _, _ => rfl
  | [_], [], _ => rfl
  | [_], _::_::_, _ => rfl
  | _::_::_, [], _ => rfl
  | _::_::_, [_], _ => rfl
  | _::_::_, _::_::_, [] => rfl

def skC : Nat → List MappedBit → List Wire → List Wire → Nat
  | 0, bits, ys, cs => addC bits ys cs
  | k+1, b::b'::bits, _::y'::ys, _::cs => skC k (b'::bits) (y'::ys) cs + ecC b + sumC b
  | _+1, bits, ys, cs => addC bits ys cs

theorem skC_eq : ∀ (k : Nat) (bits : List MappedBit) (ys cs : List Wire), skS k bits ys cs = skC k bits ys cs
  | 0, bits, ys, cs => addC_eq bits ys cs
  | k+1, b::b'::bits, y::y'::ys, c::cs => by
    simp only [skS, skC, skC_eq k (b'::bits) (y'::ys) cs, ecC_eq, sumC_eq]
  | _+1, [], ys, cs => addC_eq [] ys cs
  | _+1, [b], ys, cs => addC_eq [b] ys cs
  | _+1, b::b'::bits, [], cs => addC_eq (b::b'::bits) [] cs
  | _+1, b::b'::bits, [y], cs => addC_eq (b::b'::bits) [y] cs
  | _+1, b::b'::bits, y::y'::ys, [] => addC_eq (b::b'::bits) (y::y'::ys) []

def esC : Nat → List Wire → List Wire → List Wire → Nat
  | 0, xs, ys, cs => elC xs ys cs
  | k+1, _::a'::as, _::b'::bs, _::cs => esC k (a'::as) (b'::bs) cs + 6
  | _+1, xs, ys, cs => elC xs ys cs

theorem esC_eq : ∀ (k : Nat) (xs ys cs : List Wire), esS k xs ys cs = esC k xs ys cs
  | 0, xs, ys, cs => elC_eq xs ys cs
  | k+1, a::a'::as, b::b'::bs, c::cs => by
    simp only [esS, esC, esC_eq k (a'::as) (b'::bs) cs, eb_val]
  | _+1, [], ys, cs => elC_eq [] ys cs
  | _+1, [a], ys, cs => elC_eq [a] ys cs
  | _+1, a::a'::as, [], cs => elC_eq (a::a'::as) [] cs
  | _+1, a::a'::as, [b], cs => elC_eq (a::a'::as) [b] cs
  | _+1, a::a'::as, b::b'::bs, [] => elC_eq (a::a'::as) (b::b'::bs) []

end K4DS


end ECDSAAdd.Entrant.StairSquareBChecks
end Merge_StairSquareBChecks_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareBEFoldK_at_QTop` -/
section Merge_StairSquareBEFoldK_at_QTop

/-! # LT36 (U3b): the new B e-fold on the concrete layout — drop-in package

`efold = eFoldB LowAccCarryDevelop.L LowAccCarryDevelop.c` replaces the record's
`LocalEFoldOptimize.improved` (= `eFoldTq L c` with two CCX→CX patches) in the B body.
* `efold_spec`   : the e-fold triple in the shape used by the B body proof (`frameG`'s `efoldSpec`);
* `efold_avoids` : no hole site (pool 725..759, 761..764) and not `normFlag`;
* `efold_counts` : T = record + 10, M equal; `efold_slots_le` : slots ≤ record;
* `efold_support`: inside `c :: L.wires`; `efold_physical`. -/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareBEFoldK
open ECDSAAdd ECDSAAdd.Entrant Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout RecordedQuantum
open ControlLoan1589BFFold StairSquareBMapped StairSquareBEFold StairSquareBChecks
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 100000000



/-- Generic count relation: the mapped middle costs the 8 Toffolis that `qprog4Tq` skips. -/
theorem eFoldB_counts (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (c : Wire) :
    toffoliCount (eFoldB L c)=toffoliCount (eFoldTq L c)+8 ∧
    measurementCount (eFoldB L c)=measurementCount (eFoldTq L c) := by
  have m := qprogM_counts (coreB L) 256 SquareReduction.p (coreB_widths L hw) (by decide) (bitsB L) (bitsB_length L hw)
  have q4 := Q4.q4_countsTq L.measuredCore 256 SquareReduction.p (L.measuredCore_widths hw) (by decide)
  have qt := QCore.qprog_countsTq L.measuredCore 256 SquareReduction.p (L.measuredCore_widths hw) (by decide)
  simp only [eFoldB,eFoldTq,accFoldB,accFoldQ4KTq,midB,toffoliCount_append,measurementCount_append] at m ⊢
  constructor <;> omega









