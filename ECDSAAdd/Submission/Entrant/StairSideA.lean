/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodec_at_StairSideA` -/
section Merge_StairCodec_at_StairSideA

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! A generated, budget-parametric checkpoint codec.  The construction is the
low-space sweep circuit from `PK2`: `S=u+v`, `D=±u`, and the compact word is
`bitlen (u-σ)`, the merged low word `F`, and `σ`. -/





























































































































































































def CodecInput (L : Layout) (B u v : Nat) (sigma : Bool) (s : BasisState) : Prop :=
  regValue (reg L.S B) s = u + v ∧
  regValue (reg L.D B) s = signedWord B u sigma ∧
  cleanOn (workSites L B) s











































/-- Exact run-level obligation left by the generated resource module.  It is a
proposition, not an assumed theorem: integration may name it without adding an
extra assumption while the sweep-invariant proof is developed. -/
def FunctionalSpec (L : Layout) (B : Nat) : Prop :=
  GatePhysical (pack L B) ∧ GatePhysical (unpack L B) ∧
  ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
    (∀ s m, CodecInput L B u v sigma s.basis →
      (run (pack L B) m s).phase = s.phase ∧
      CompactCode L B u v sigma (run (pack L B) m s).basis) ∧
    (∀ s m, CompactCode L B u v sigma s.basis →
      (run (unpack L B) m s).phase = s.phase ∧
      CodecInput L B u v sigma (run (unpack L B) m s).basis)



end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodec_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecSweep_at_StairSideA` -/
section Merge_StairCodecSweep_at_StairSideA

set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Arithmetic facts for the custom known-top carry-in adder. -/

private theorem nat_lt_pow_natBitLength (x : Nat) (hx : 0 < x) :
    x < 2 ^ natBitLength x := by
  have hlog : x.log2 < x.log2 + 1 := by omega
  have hpow := (Nat.log2_lt (by omega : x ≠ 0)).mp hlog
  simpa [natBitLength, ne_of_gt hx] using hpow

theorem domain_sub_sigma_add (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    u - sigma.toNat + sigma.toNat = u := by
  cases sigma with
  | false => simp
  | true =>
      simp only [Bool.toNat_true]
      have hu : 0 < u := by
        by_contra hz
        have hz' : u = 0 := by omega
        have := (hd.2.2.2.2.2 hz').2
        contradiction
      omega

theorem domain_v_lt_top (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) : v < 2 ^ (B - 1) := by
  by_cases hu : u = 0
  · have hv : v = 1 := (hd.2.2.2.2.2 hu).1
    subst v
    have hB : B - 1 ≠ 0 := by
      have := hd.1
      omega
    exact Nat.one_lt_two_pow hB
  · have hu0 : 0 < u := Nat.pos_of_ne_zero hu
    have hul : 1 ≤ natBitLength u := by
      simp [natBitLength, hu]
    have hvl : natBitLength v ≤ B - 1 := by
      have := hd.2.2.2.2.1
      omega
    have hvb := nat_lt_pow_natBitLength v hd.2.1
    have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hvl
    exact lt_of_lt_of_le hvb hp


/-! A circuit-independent statement of the descending Pack B sweep.  LT1 can
instantiate `d` and `s` with its private rail observations and combine the
step theorem with its private decoder transition lemmas. -/









@[simp] theorem packSweepStep_z (B r : Nat) (st : SweepState) :
    (packSweepStep B r st).z = st.z ^^ (st.d (r - 1) && st.z) := by
  cases hd : st.d (r - 1) <;> cases hz : st.z <;>
    simp [packSweepStep, hd, hz]

@[simp] theorem packSweepStep_d_self (B r : Nat) (st : SweepState) :
    (packSweepStep B r st).d (r - 1) =
      st.d (r - 1) ^^ (st.d (r - 1) && st.z) ^^
        (if r - 1 < B - 2 then st.s (B - 2 - (r - 1)) else false) := by
  by_cases hj : r - 1 < B - 2
  · cases hd : st.d (r - 1) <;> cases hz : st.z <;>
      cases hs : st.s (B - 2 - (r - 1)) <;>
        simp [packSweepStep, hj, hd, hz, hs]
  · cases hd : st.d (r - 1) <;> cases hz : st.z <;>
      simp [packSweepStep, hj, hd, hz]















def initialSweepState (B w v : Nat) : SweepState :=
  { a := 0
    z := true
    d := fun i => w.testBit i
    s := fun i => if i = 0 then false else (v - 1).testBit i }

end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecSweep_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecUnsweep_at_StairSideA` -/
section Merge_StairCodecUnsweep_at_StairSideA

set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Circuit-independent semantics of the ascending sweep in `unpack`.  LT1's
private run lemmas can instantiate `d` and `s` with rail observations and use
the split-one-hot theorem below for the two decoder controls. -/





def unpackMarker (w j : Nat) : Bool := sweepMarker w (j + 1)

def UnpackSweepInvariant (B u v : Nat) (sigma : Bool) (j : Nat)
    (st : SweepState) : Prop :=
  let w := u - sigma.toNat
  j ≤ B - 1 ∧
  st.z = decide (w < 2 ^ j) ∧
  st.a = (if j < natBitLength w then natBitLength w else 0) ∧
  (∀ i, i < B - 1 →
    st.d i = if i < j then w.testBit i else payloadBit B w v i) ∧
  (∀ i, i < B - 2 →
    st.s (B - 2 - i) = if i < j then halfBit B v i else false)

/-- Exact classical update of an `unpackStep`.  The `a` field records the
semantic register value; on the invariant, a selected `k=j+1` is XORed out to
zero.  The `s` target is written before its value is XORed into `d`, matching
the instruction order. -/
def unpackSweepStep (B j : Nat) (st : SweepState) : SweepState :=
  let t := decide (st.a = j + 1)
  let z' := st.z ^^ t
  let normal := j < B - 2
  let mirror := B - 2 - j
  let restoredS := st.s mirror ^^ (st.d j && z')
  { a := if t then 0 else st.a
    z := z'
    d := fun i => if i = j then
      st.d i ^^ (if normal then restoredS else false) ^^ t
      else st.d i
    s := fun i => if normal && decide (i = mirror) then restoredS else st.s i }

@[simp] theorem unpackSweepStep_a (B j : Nat) (st : SweepState) :
    (unpackSweepStep B j st).a =
      (if decide (st.a = j + 1) then 0 else st.a) := by
  rfl

@[simp] theorem unpackSweepStep_z (B j : Nat) (st : SweepState) :
    (unpackSweepStep B j st).z = (st.z ^^ decide (st.a = j + 1)) := by
  rfl

/-- The current semantic A value makes the decoder product equal the marker
for this ascending position. -/
theorem unpack_marker_from_a (w j : Nat) :
    decide ((if j < natBitLength w then natBitLength w else 0) = j + 1) =
      unpackMarker w j := by
  rw [unpackMarker, sweepMarker_eq w (j + 1) (by omega)]
  by_cases heq : natBitLength w = j + 1
  · have hj : j < natBitLength w := by omega
    simp [heq, hj]
  · by_cases hj : j < natBitLength w
    · simp [hj, heq]
    · have hne : (0 : Nat) ≠ j + 1 := by omega
      simp [hj, heq, hne]


/-- The initial decoder product used to compute z is true exactly for the
terminal word `w=0`. -/
theorem initial_split_decoder_selected (lo w : Nat) (low high : Nat → Bool)
    (h : SplitOneHot lo (natBitLength w) low high) :
    (high 0 && low 0) = decide (w < 1) := by
  have hsel := splitOneHot_selected lo (natBitLength w) 0 low high h
  simp only [Nat.zero_div, Nat.zero_mod] at hsel
  rw [hsel]
  by_cases hw : w = 0
  · subst w
    simp [natBitLength]
  · simp [natBitLength, hw]

/-- Reverse direction of the pack thermometer equation. -/
theorem unsweep_z_step (w j : Nat) :
    (decide (w < 2 ^ j) ^^ unpackMarker w j) = decide (w < 2 ^ (j + 1)) := by
  have h := sweep_z_step w (j + 1) (by omega)
  simp only [unpackMarker, Nat.add_sub_cancel] at h ⊢
  cases hhi : decide (w < 2 ^ (j + 1)) <;>
    cases hm : sweepMarker w (j + 1) <;> simp_all

theorem unsweep_a_step (w j : Nat) :
    (if unpackMarker w j then 0
     else if j < natBitLength w then natBitLength w else 0) =
      (if j + 1 < natBitLength w then natBitLength w else 0) := by
  rw [unpackMarker, sweepMarker_eq w (j + 1) (by omega)]
  by_cases heq : natBitLength w = j + 1
  · have hj : j < natBitLength w := by omega
    have hn : ¬ j + 1 < natBitLength w := by omega
    simp [heq, hj, hn]
  · by_cases hj : j < natBitLength w
    · have hnext : j + 1 < natBitLength w := by omega
      simp [heq, hj, hnext]
    · have hnext : ¬ j + 1 < natBitLength w := by omega
      simp [heq, hj, hnext]

/-- The reconstructed mirrored S bit is exactly `(v-1)/2` at this position. -/
theorem unsweep_s_step (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 2) :
    (payloadBit B (u - sigma.toNat) v j &&
        decide (u - sigma.toNat < 2 ^ (j + 1))) =
      halfBit B v j := by
  have h := packSweep_arithmetic_step B u v sigma (j + 1) hd (by omega)
    (by simpa using hj)
  simpa [Nat.add_sub_cancel] using h.2.2.2.1.symm

/-- After reconstructing S and undoing the marker, the compact payload bit is
the original bit of `w`.  The statement includes the top position, where no S
wire exists. -/
theorem unsweep_d_step (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 1) :
    let w := u - sigma.toNat
    (payloadBit B w v j ^^
        (if j < B - 2 then
          payloadBit B w v j && decide (w < 2 ^ (j + 1))
         else false) ^^
        unpackMarker w j) = w.testBit j := by
  dsimp only
  rw [show unpackMarker (u - sigma.toNat) j =
    sweepMarker (u - sigma.toNat) (j + 1) by rfl]
  by_cases hn : j < B - 2
  · have hs := unsweep_s_step B u v sigma j hd hn
    have ht := sweep_trim_step (u - sigma.toNat) (j + 1) (by omega)
    simp only [Nat.add_sub_cancel] at ht
    rw [if_pos hn, hs, payloadBit, if_pos hn, ← ht]
    cases hbit : (u - sigma.toNat).testBit j <;>
      cases hm : unpackMarker (u - sigma.toNat) j <;>
        cases hv : halfBit B v j <;> simp
  · have hjtop : j = B - 2 := by omega
    have ht := sweep_trim_step (u - sigma.toNat) (j + 1) (by omega)
    simp only [Nat.add_sub_cancel] at ht
    rw [if_neg hn, payloadBit, if_neg hn, ← ht]
    cases hbit : (u - sigma.toNat).testBit j <;>
      cases hm : unpackMarker (u - sigma.toNat) j <;> simp

/-- The measured-t correction monomial equals the erased marker. -/
theorem unsweep_t_fix (w j : Nat) :
    (w.testBit j && decide (w < 2 ^ (j + 1))) = unpackMarker w j := by
  simp [unpackMarker, sweepMarker]

/-- One general-B ascending position preserves the complete inverse-sweep
invariant, including the two rail families. -/
theorem unpackSweepStep_invariant (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 1) (st : SweepState)
    (hinv : UnpackSweepInvariant B u v sigma j st) :
    UnpackSweepInvariant B u v sigma (j + 1) (unpackSweepStep B j st) := by
  let w := u - sigma.toNat
  change j ≤ B - 1 ∧
    st.z = decide (w < 2 ^ j) ∧
    st.a = (if j < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      st.d i = if i < j then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      st.s (B - 2 - i) = if i < j then halfBit B v i else false) at hinv
  change j + 1 ≤ B - 1 ∧
    (unpackSweepStep B j st).z = decide (w < 2 ^ (j + 1)) ∧
    (unpackSweepStep B j st).a =
      (if j + 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      (unpackSweepStep B j st).d i =
        if i < j + 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      (unpackSweepStep B j st).s (B - 2 - i) =
        if i < j + 1 then halfBit B v i else false)
  have hbound : j + 1 ≤ B - 1 := by omega
  have hz := hinv.2.1
  have ha := hinv.2.2.1
  have hdrail := hinv.2.2.2.1
  have hsrail := hinv.2.2.2.2
  have hmarker : decide (st.a = j + 1) = unpackMarker w j := by
    rw [ha]
    exact unpack_marker_from_a w j
  have hznext : (st.z ^^ decide (st.a = j + 1)) = decide (w < 2 ^ (j + 1)) := by
    rw [hz, hmarker]
    exact unsweep_z_step w j
  have hznext' : (st.z ^^ unpackMarker w j) = decide (w < 2 ^ (j + 1)) := by
    rw [← hmarker]
    exact hznext
  constructor
  · exact hbound
  constructor
  · rw [unpackSweepStep_z]
    exact hznext
  constructor
  · rw [unpackSweepStep_a, hmarker, ha]
    exact unsweep_a_step w j
  constructor
  · intro i hi
    by_cases hij : i = j
    · subst i
      have hdj : st.d j = payloadBit B w v j := by
        simpa using hdrail j hj
      by_cases hn : j < B - 2
      · have hsj : st.s (B - 2 - j) = false := by
          simpa using hsrail j hn
        simp only [unpackSweepStep, hmarker, hdj, hn, Bool.true_and,
          decide_true, if_true, hsj, Bool.false_xor]
        rw [hznext']
        simpa [w, hn] using unsweep_d_step B u v sigma j hd hj
      · simp only [unpackSweepStep, hmarker, hdj, hn, if_true, if_false]
        simpa [w, hn] using unsweep_d_step B u v sigma j hd hj
    · by_cases hil : i < j
      · have hinext : i < j + 1 := by omega
        simp [unpackSweepStep, hij, hdrail i hi, hil, hinext]
      · have hinext : ¬ i < j + 1 := by omega
        simp [unpackSweepStep, hij, hdrail i hi, hil, hinext]
  · intro i hi
    by_cases hjn : j < B - 2
    · by_cases hij : i = j
      · subst i
        have hdj : st.d j = payloadBit B w v j := by
          simpa using hdrail j (by omega)
        have hsj : st.s (B - 2 - j) = false := by
          simpa using hsrail j hjn
        have hs := unsweep_s_step B u v sigma j hd hjn
        simp only [unpackSweepStep, hjn, Bool.true_and, decide_true, if_true,
          hsj, Bool.false_xor, hdj, hmarker]
        rw [hznext', hs]
        simp
      · have hmirror : B - 2 - i ≠ B - 2 - j := by
          intro heq
          apply hij
          exact (tsub_right_inj (by omega) (by omega)).mp heq
        by_cases hil : i < j
        · have hinext : i < j + 1 := by omega
          simp [unpackSweepStep, hjn, hmirror, hsrail i hi, hil, hinext]
        · have hinext : ¬ i < j + 1 := by omega
          simp [unpackSweepStep, hjn, hmirror, hsrail i hi, hil, hinext]
    · have hji : i < j := by omega
      have hnext : i < j + 1 := by omega
      simp only [unpackSweepStep, hjn, if_false]
      simp [hsrail i hi, hji, hnext]

def unpackSweepRun (B : Nat) : Nat → Nat → SweepState → SweepState
  | _, 0, st => st
  | j, n + 1, st => unpackSweepRun B (j + 1) n (unpackSweepStep B j st)

/-- General-position induction: any prefix of the ascending inverse sweep
preserves the unpack invariant. -/
theorem unpackSweepRun_invariant (B u v : Nat) (sigma : Bool) (j n : Nat)
    (hd : CodecDomain B u v sigma) (hjn : j + n ≤ B - 1) (st : SweepState)
    (hinv : UnpackSweepInvariant B u v sigma j st) :
    UnpackSweepInvariant B u v sigma (j + n) (unpackSweepRun B j n st) := by
  induction n generalizing j st with
  | zero => simpa [unpackSweepRun] using hinv
  | succ n ih =>
      have hj : j < B - 1 := by omega
      have hnext : j + 1 + n ≤ B - 1 := by omega
      rw [unpackSweepRun]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        ih (j + 1) hnext (unpackSweepStep B j st)
          (unpackSweepStep_invariant B u v sigma j hd hj st hinv)




/-- The compact scalar state immediately after decoder construction and the
initial z CCX satisfies the inverse-sweep invariant at position zero. -/
def initialUnpackSweepState (B w v : Nat) : SweepState :=
  { a := natBitLength w
    z := decide (w < 1)
    d := fun i => payloadBit B w v i
    s := fun _ => false }

theorem initialUnpackSweepState_invariant (B u v : Nat) (sigma : Bool)
    (_hd : CodecDomain B u v sigma) :
    UnpackSweepInvariant B u v sigma 0
      (initialUnpackSweepState B (u - sigma.toNat) v) := by
  simp [UnpackSweepInvariant, initialUnpackSweepState]

/-- Full inverse sweep: A is zero, z is one (and is cleared by the following
X), D contains `w`, and every reconstructed S payload bit is present. -/
theorem unpackSweep_full (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    UnpackSweepInvariant B u v sigma (B - 1)
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) := by
  have h0 := initialUnpackSweepState_invariant B u v sigma hd
  simpa using unpackSweepRun_invariant B u v sigma 0 (B - 1) hd (by omega)
    _ h0

/-- Component form of the full invariant, ready for LT1's final X, decoder
clear, and ripple-adder bridge. -/
theorem unpackSweep_full_values (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    let st := unpackSweepRun B 0 (B - 1)
      (initialUnpackSweepState B (u - sigma.toNat) v)
    st.a = 0 ∧ st.z = true ∧
    (∀ i, i < B - 1 → st.d i = (u - sigma.toNat).testBit i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i) := by
  let st := unpackSweepRun B 0 (B - 1)
    (initialUnpackSweepState B (u - sigma.toNat) v)
  have hfull := unpackSweep_full B u v sigma hd
  change UnpackSweepInvariant B u v sigma (B - 1) st at hfull
  change st.a = 0 ∧ st.z = true ∧
    (∀ i, i < B - 1 → st.d i = (u - sigma.toNat).testBit i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i)
  have hz := hfull.2.1
  have ha := hfull.2.2.1
  have hdrail := hfull.2.2.2.1
  have hsrail := hfull.2.2.2.2
  have hlen := domain_w_bitLength_le B u v sigma hd
  have hw := domain_w_lt_top B u v sigma hd
  constructor
  · rw [ha]
    simp [show ¬ B - 1 < natBitLength (u - sigma.toNat) by omega]
  constructor
  · rw [hz]
    simp [hw]
  constructor
  · intro i hi
    simpa [hi] using hdrail i hi
  · intro i hi
    have hi' : i < B - 1 := by omega
    simpa [hi'] using hsrail i hi

end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecUnsweep_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecSpec_at_StairSideA` -/
section Merge_StairCodecSpec_at_StairSideA

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Run-level integration of the generated codec with the public arithmetic
invariants.  This file is kept separate so the generator and its resource
proofs remain protected-import-only. -/

def packedBits (f : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n + 1 => packedBits f n + if f n then 2 ^ n else 0

theorem fold_range_bits_eq_packedBits (f : Nat → Bool) (n : Nat) :
    (List.range n).foldl
      (fun acc i => if f i then acc + 2 ^ i else acc) 0 = packedBits f n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [List.range_succ, List.foldl_append, ih]
      cases h : f n <;> simp [packedBits, h]

theorem packedBits_bound (f : Nat → Bool) (n : Nat) : packedBits f n < 2 ^ n := by
  induction n with
  | zero => simp [packedBits]
  | succ n ih =>
      cases h : f n <;> simp [packedBits, h, pow_succ] <;> omega

theorem packedBits_testBit (f : Nat → Bool) (n i : Nat) (hi : i < n) :
    (packedBits f n).testBit i = f i := by
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hin : i = n
      · subst i
        cases h : f n
        · simp [packedBits, h, Nat.testBit_lt_two_pow (packedBits_bound f n)]
        · simp only [packedBits, h, Bool.true_eq, if_true]
          rw [Nat.add_comm, Nat.testBit_two_pow_add_eq,
            Nat.testBit_lt_two_pow (packedBits_bound f n)]
          rfl
      · have hi' : i < n := by omega
        cases h : f n
        · simp [packedBits, h, ih hi']
        · simp only [packedBits, h, Bool.true_eq, if_true]
          rw [Nat.add_comm, Nat.testBit_two_pow_add_gt hi']
          exact ih hi'

theorem packedBits_congr (f g : Nat → Bool) (n : Nat)
    (h : ∀ i, i < n → f i = g i) : packedBits f n = packedBits g n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [packedBits, h n (by omega), ih (fun i hi => h i (by omega))]

theorem compactF_eq_packedBits (B w v : Nat) :
    compactF B w v = packedBits (payloadBit B w v) (B - 2) := by
  unfold compactF
  rw [fold_range_bits_eq_packedBits]
  apply packedBits_congr
  intro i hi
  simp [payloadBit, trimmedBit, halfBit, hi]

theorem compactF_testBit (B w v i : Nat) (hi : i < B - 2) :
    (compactF B w v).testBit i = payloadBit B w v i := by
  rw [compactF_eq_packedBits]
  exact packedBits_testBit _ _ _ hi

theorem compactF_bound (B w v : Nat) : compactF B w v < 2 ^ (B - 2) := by
  rw [compactF_eq_packedBits]
  exact packedBits_bound _ _


theorem payloadBit_top_false (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    payloadBit B (u - sigma.toNat) v (B - 2) = false := by
  let w := u - sigma.toNat
  change payloadBit B w v (B - 2) = false
  have hB : 3 ≤ B := hd.1
  have hlen := domain_w_bitLength_le B u v sigma hd
  change natBitLength w ≤ B - 1 at hlen
  simp only [payloadBit, show ¬ B - 2 < B - 2 by omega, if_false, Bool.xor_false]
  unfold trimmedBit
  have hindex : B - 2 + 1 = B - 1 := by omega
  rw [hindex]
  by_cases heq : B - 1 = natBitLength w
  · rw [if_pos heq]
  · rw [if_neg heq]
    apply Nat.testBit_lt_two_pow
    by_cases hw : w = 0
    · rw [hw]
      positivity
    · have hshort : natBitLength w ≤ B - 2 := by omega
      have hpow := nat_lt_pow_natBitLength_spec w (Nat.pos_of_ne_zero hw)
      have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hshort
      exact lt_of_lt_of_le hpow hp


def RealizesUnpackLive (L : Layout) (B : Nat) (st : SweepState)
    (marker : Bool) (basis : BasisState) : Prop :=
  regValue (reg L.A (bitWidth B)) basis = st.a ∧
  basis L.z = st.z ∧ basis L.t = marker ∧
  (∀ i, i < B - 1 → basis (L.D i) = st.d i) ∧
  (∀ i, i < B - 2 → basis (L.S (B - 2 - i)) = st.s (B - 2 - i)) ∧
  (∀ q ∈ (lowDecoder L B).sites, basis q =
    decoderBasis (lowDecoder L B) (lowBits L B)
      (st.a % 2 ^ (bitWidth B / 2)) q) ∧
  (∀ q ∈ (highDecoder L B).sites, basis q =
    decoderBasis (highDecoder L B) (highBits L B)
      (st.a / 2 ^ (bitWidth B / 2)) q)



theorem run_append_zero_left_spec (p q : Program)
    (hz : measurementCount p = 0) (m : List Bool) (s : State) :
    run (p ++ q) m s = run q m (run p m s) := by
  rw [run_append, hz, List.take_zero, List.drop_zero]
  have ht := run_take p m s
  simpa only [hz, List.take_zero] using congrArg (run q m) ht





/-- A controlled decoder delta is an exact conditional transition from the
selected word back to the zero word, with a full outside-sites frame. -/
theorem decoderDelta_run_reverse_bool (d : Decoder) (bits : List Wire) (x : Nat)
    (control : Wire) (hsites : d.sites.Nodup) (hc : control ∉ d.sites)
    (s : State) (m : List Bool)
    (hcurrent : ∀ q ∈ d.sites, s.basis q = decoderBasis d bits x q) :
    (run (cxInto control (decoderDelta d bits x)) m s).phase = s.phase ∧
    (∀ q ∈ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        if s.basis control then decoderBasis d bits 0 q
        else decoderBasis d bits x q) ∧
    (∀ q ∉ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q = s.basis q) := by
  have hdelta : (decoderDelta d bits x).Nodup := hsites.filter _
  have hc' : control ∉ decoderDelta d bits x := by
    intro hm
    exact hc (List.mem_of_mem_filter hm)
  rw [cxInto_run control _ hdelta hc']
  constructor
  · rfl
  constructor
  · intro q hq
    have hcur := hcurrent q hq
    cases hctrl : s.basis control <;>
      cases h0 : decoderBasis d bits 0 q <;>
      cases hxq : decoderBasis d bits x q <;>
      simp_all [decoderDelta, hq]
  · intro q hq
    have hnot : q ∉ decoderDelta d bits x := by
      intro hm
      exact hq (List.mem_of_mem_filter hm)
    cases hctrl : s.basis control <;> simp [hctrl, hnot]

theorem decoderDelta_run_selected (d : Decoder) (bits : List Wire)
    (current x : Nat) (control : Wire) (hsites : d.sites.Nodup)
    (hc : control ∉ d.sites) (s : State) (m : List Bool)
    (hcurrent : ∀ q ∈ d.sites, s.basis q = decoderBasis d bits current q)
    (hselected : s.basis control = true → current = x) :
    (run (cxInto control (decoderDelta d bits x)) m s).phase = s.phase ∧
    (∀ q ∈ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        decoderBasis d bits (if s.basis control then 0 else current) q) ∧
    (∀ q ∉ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q = s.basis q) := by
  cases hctrl : s.basis control
  · have hdelta : (decoderDelta d bits x).Nodup := hsites.filter _
    have hc' : control ∉ decoderDelta d bits x := by
      intro hm
      exact hc (List.mem_of_mem_filter hm)
    rw [cxInto_run control _ hdelta hc']
    constructor
    · rfl
    constructor
    · intro q hq
      simpa [hctrl] using hcurrent q hq
    · intro q hq
      simp [hctrl]
  · have heq := hselected hctrl
    subst current
    simpa [hctrl] using decoderDelta_run_reverse_bool d bits x control hsites hc
      s m hcurrent






theorem lowDecoder_sites (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hclean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false) :
    ∀ q ∈ (lowDecoder L B).sites,
      (run (lowDecoder L B).program m s).basis q =
        decoderBasis (lowDecoder L B) (lowBits L B)
          (value % 2 ^ (bitWidth B / 2)) q := by
  have hbits : ∀ i, i < (lowBits L B).length →
      s.basis ((lowBits L B).getD i 0) =
        (value % 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact lowBits_read L B value i s.basis hvalue hi
  simpa [lowDecoder] using oneHot_run_sites (lowBits L B) L.lowWork
    (lowDecoder_nodup L B hn) s m (value % 2 ^ (bitWidth B / 2)) hbits hclean

theorem highDecoder_sites (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hclean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false) :
    ∀ q ∈ (highDecoder L B).sites,
      (run (highDecoder L B).program m s).basis q =
        decoderBasis (highDecoder L B) (highBits L B)
          (value / 2 ^ (bitWidth B / 2)) q := by
  have hbits : ∀ i, i < (highBits L B).length →
      s.basis ((highBits L B).getD i 0) =
        (value / 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact highBits_read L B value i s.basis hvalue hi
  simpa [highDecoder] using oneHot_run_sites (highBits L B) L.highWork
    (highDecoder_nodup L B hn) s m (value / 2 ^ (bitWidth B / 2)) hbits hclean

/-- The two decoder programs establish their complete generated-site states,
not only the externally selected outputs.  This is the state form consumed by
the controlled decoder deltas in every inverse-sweep step. -/
theorem decoderPair_sites (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false)
    (hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false) :
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      out.basis q = s.basis q) := by
  let lowState := run (lowDecoder L B).program m s
  have hlo := lowDecoder_output L B value hn s m hvalue hbound hlClean
  have hloSites := lowDecoder_sites L B value hn s m hvalue hlClean
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), lowState.basis q = s.basis q := by
    intro q hq
    apply hlo.2.1 q
    intro hsite
    exact sep_A_rest L B hn hq (by simp [hsite]) rfl
  have hAValue : regValue (reg L.A (bitWidth B)) lowState.basis = value :=
    (regValue_congr _ _ _ hAFrame).trans hvalue
  have hhClean' : ∀ q ∈ (highDecoder L B).sites, lowState.basis q = false := by
    intro q hq
    rw [hlo.2.1 q]
    · exact hhClean q hq
    · intro hlq
      exact sep_low_high L B hn hlq hq rfl
  have hhi := highDecoder_output L B value hn lowState m hAValue hbound hhClean'
  have hhiSites := highDecoder_sites L B value hn lowState m hAValue hhClean'
  let out := run (highDecoder L B).program m lowState
  refine ⟨hhi.1.trans hlo.1, ?_, hhiSites, ?_⟩
  · intro q hq
    rw [hhi.2.1 q]
    · exact hloSites q hq
    · intro hhq
      exact sep_low_high L B hn hq hhq rfl
  · intro q hlq hhq
    exact (hhi.2.1 q hhq).trans (hlo.2.1 q hlq)






def aTargets (L : Layout) (B k : Nat) : List Wire :=
  ((List.range (bitWidth B)).filter (fun b => k.testBit b)).map L.A

theorem aTargets_nodup (L : Layout) (B k : Nat) (hn : L.Nodup B) :
    (aTargets L B k).Nodup := by
  have hs : List.Sublist
      ((List.range (bitWidth B)).filter (fun b => k.testBit b))
      (List.range (bitWidth B)) := List.filter_sublist
  have hm := hs.map L.A
  exact (A_nodup L B hn).sublist (by simpa [aTargets, reg] using hm)

theorem aTargets_mem_iff (L : Layout) (B k i : Nat) (hn : L.Nodup B)
    (hi : i < bitWidth B) : L.A i ∈ aTargets L B k ↔ k.testBit i = true := by
  constructor
  · intro hm
    simp only [aTargets, List.mem_map] at hm
    rcases hm with ⟨r, hr, heq⟩
    have hrr := (List.mem_filter.mp hr).1
    have hrb := (List.mem_filter.mp hr).2
    have hre : r = i := by
      apply List.inj_on_of_nodup_map (by simpa only [reg] using A_nodup L B hn)
      · exact hrr
      · exact List.mem_range.mpr hi
      · exact heq
    simpa [hre] using hrb
  · intro hb
    apply List.mem_map.mpr
    refine ⟨i, ?_, rfl⟩
    exact List.mem_filter.mpr ⟨List.mem_range.mpr hi, hb⟩

theorem aTargets_run_value (L : Layout) (B current k : Nat)
    (hn : L.Nodup B) (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = current)
    (hselected : s.basis L.t = true → current = k) :
    let out := run (cxInto L.t (aTargets L B k)) m s
    out.phase = s.phase ∧
    regValue (reg L.A (bitWidth B)) out.basis =
      (if s.basis L.t then 0 else current) ∧
    (∀ q ∉ reg L.A (bitWidth B), out.basis q = s.basis q) := by
  have ht : L.t ∉ aTargets L B k := by
    intro hm
    simp only [aTargets, List.mem_map] at hm
    rcases hm with ⟨i, hi, heq⟩
    have hir := (List.mem_filter.mp hi).1
    have hA : L.A i ∈ reg L.A (bitWidth B) := reg_mem L.A _ i
      (List.mem_range.mp hir)
    exact sep_A_rest L B hn hA (by simp) heq
  rw [cxInto_run L.t _ (aTargets_nodup L B k hn) ht]
  constructor
  · rfl
  constructor
  · cases hctrl : s.basis L.t
    · simpa [hctrl] using hvalue
    · have heq : current = k := hselected hctrl
      apply (regValue_zero (reg L.A (bitWidth B)) _).mpr
      intro q hq
      obtain ⟨i, hi, hqi⟩ := List.mem_iff_getElem.mp hq
      have hwire : (reg L.A (bitWidth B))[i] = L.A i := by simp [reg]
      rw [hwire] at hqi
      have hreg : i < (reg L.A (bitWidth B)).length := hi
      have hget : (reg L.A (bitWidth B)).getD i 0 = L.A i := by
        rw [List.getD_eq_getElem _ _ hreg, hwire]
      have hbit := regValue_getD_testBit (reg L.A (bitWidth B)) i 0 s.basis hreg
      rw [hget, hvalue, heq] at hbit
      rw [← hqi]
      have hi' : i < bitWidth B := by simpa [reg] using hi
      cases hb : k.testBit i
      · have hnot : L.A i ∉ aTargets L B k := by
          rw [aTargets_mem_iff L B k i hn hi']
          simp [hb]
        simp [hctrl, hnot, hbit, hb]
      · have hmem : L.A i ∈ aTargets L B k :=
          (aTargets_mem_iff L B k i hn hi').2 hb
        simp [hctrl, hmem, hbit, hb]
  · intro q hq
    have hnot : q ∉ aTargets L B k := by
      intro hm
      apply hq
      simp only [aTargets, List.mem_map] at hm
      rcases hm with ⟨i, hi, rfl⟩
      exact reg_mem L.A _ i (List.mem_range.mp (List.mem_filter.mp hi).1)
    cases hctrl : s.basis L.t <;> simp [hctrl, hnot]

theorem unpackStep_front (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let out := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    out.phase = s.phase ∧
    out.basis L.t = decide (st.a = k) ∧
    out.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → out.basis q = s.basis q) := by
  let k := j + 1
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have haBound : st.a < 2 ^ bitWidth B := by
    rw [← ha]
    simpa [reg] using regValue_lt (reg L.A (bitWidth B)) s.basis
  have hkB : k < B := by omega
  have hk : k < 2 ^ bitWidth B :=
    lt_of_lt_of_le hkB (bitWidth_bound B (by omega))
  have hsel := pairDecoder_selected_of_sites L B st.a k hn s.basis ha
    haBound hk hlow hhigh
  have hsel' :
      (s.basis (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z) &&
        s.basis (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z)) =
          decide (st.a = k) := by
    rw [hsel]
    simp [eq_comm]
  have hselJ :
      (s.basis (outAt (highDecoder L B) ((j + 1) / 2 ^ (bitWidth B / 2)) L.z) &&
        s.basis (outAt (lowDecoder L B) ((j + 1) % 2 ^ (bitWidth B / 2)) L.z)) =
          decide (st.a = j + 1) := by
    simpa only [k] using hsel'
  have hzt := sep_z_t L B hn
  refine ⟨rfl, ?_, ?_, ?_⟩
  · simp [run, writeBit, Function.update, ht, hselJ, hzt, Ne.symm hzt]
  · simp [run, writeBit, Function.update, ht, hselJ, hz, hzt, Ne.symm hzt]
  · intro q hqt hqz
    simp [run, writeBit, Function.update, hqt, hqz]

theorem unpackStep_rails (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let out := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    out.phase = s.phase ∧
    out.basis L.t = decide (st.a = k) ∧
    out.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    out.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 →
      out.basis (L.S (B - 2 - j)) =
        (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → out.basis q = s.basis q) := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let out := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  have hf := unpackStep_front L B j hn hj st s m hr
  change front.phase = s.phase ∧
    front.basis L.t = decide (st.a = k) ∧
    front.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → front.basis q = s.basis q) at hf
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hDmem : L.D j ∈ reg L.D B := reg_mem L.D B j (by omega)
  have hDt : L.D j ≠ L.t := sep_D_work L B hn hDmem (by simp [workSites])
  have hDz : L.D j ≠ L.z := sep_D_work L B hn hDmem (by simp [workSites])
  have hfD : front.basis (L.D j) = st.d j :=
    (hf.2.2.2 (L.D j) hDt hDz).trans (hdrail j hj)
  have hzt := sep_z_t L B hn
  change out.phase = s.phase ∧
    out.basis L.t = decide (st.a = k) ∧
    out.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    out.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 → out.basis (L.S (B - 2 - j)) =
      (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → out.basis q = s.basis q)
  by_cases hnormal : j < B - 2
  · have hSmem : L.S (B - 2 - j) ∈ reg L.S B :=
      reg_mem L.S B (B - 2 - j) (by omega)
    have hSt : L.S (B - 2 - j) ≠ L.t :=
      sep_S_rest L B hn hSmem (by simp [workSites])
    have hSz : L.S (B - 2 - j) ≠ L.z :=
      sep_S_rest L B hn hSmem (by simp [workSites])
    have hSD : L.S (B - 2 - j) ≠ L.D j :=
      sep_S_rest L B hn hSmem (by simp [workSites, hDmem])
    have hfS : front.basis (L.S (B - 2 - j)) = st.s (B - 2 - j) :=
      (hf.2.2.2 (L.S (B - 2 - j)) hSt hSz).trans (hsrail j hnormal)
    have hout : out = run ([.CCX (L.D j) L.z (L.S (B - 2 - j)),
        .CX (L.S (B - 2 - j)) (L.D j), .CX L.t (L.D j)] : Program) m front := by
      dsimp only [out]
      rw [if_pos hnormal]
      rfl
    refine ⟨by rw [hout]; simpa [run] using hf.1,
      ?_, ?_, ?_, ?_, ?_⟩
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.1, hDt, hSt,
        hSD, Ne.symm hDt, Ne.symm hSt, Ne.symm hSD]
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.2.1, hDz, hSz,
        hSD, Ne.symm hDz, Ne.symm hSz, Ne.symm hSD]
    · rw [hout]
      simp [run, unpackSweepStep, writeBit, Function.update,
        hf.2.1, hf.2.2.1, hfD, hfS, hDt, hDz, hSt, hSz, hSD,
        Ne.symm hDt, Ne.symm hDz, Ne.symm hSt, Ne.symm hSz, Ne.symm hSD,
        hnormal, k]
    · intro _
      rw [hout]
      simp [run, unpackSweepStep, writeBit, Function.update,
        hf.2.1, hf.2.2.1, hfD, hfS, hDt, hDz, hSt, hSz, hSD,
        Ne.symm hDt, Ne.symm hDz, Ne.symm hSt, Ne.symm hSz, Ne.symm hSD,
        hnormal, k]
    · intro q hqt hqz hqD hqS
      rw [hout]
      simp [run, writeBit, Function.update, hqt, hqz, hqD, hqS,
        hf.2.2.2 q hqt hqz]
  · have hout : out = run ([.CX L.t (L.D j)] : Program) m front := by
      dsimp only [out]
      rw [if_neg hnormal]
      rfl
    refine ⟨by rw [hout]; simpa [run] using hf.1,
      ?_, ?_, ?_, ?_, ?_⟩
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.1, hDt, Ne.symm hDt]
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.2.1, hDz, Ne.symm hDz]
    · rw [hout]
      simp [run, unpackSweepStep, writeBit, Function.update,
        hf.2.1, hf.2.2.1, hfD, hDt, hDz, Ne.symm hDt, Ne.symm hDz,
        hnormal, k]
    · intro h
      contradiction
    · intro q hqt hqz hqD hqS
      rw [hout]
      simp [run, writeBit, Function.update, hqt, hqD,
        hf.2.2.2 q hqt hqz]

theorem unpackStep_decoders (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let rail := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
      (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
    let out := run (cxInto L.t (decoderDelta (highDecoder L B)
      (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        ((unpackSweepStep B j st).a % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        ((unpackSweepStep B j st).a / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      out.basis q = rail.basis q) := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let rail := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
  let out := run (cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
  have hrails := unpackStep_rails L B j hn hj st s m hr
  change rail.phase = s.phase ∧
    rail.basis L.t = decide (st.a = k) ∧
    rail.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    rail.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 → rail.basis (L.S (B - 2 - j)) =
      (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → rail.basis q = s.basis q) at hrails
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hLowRail : ∀ q ∈ (lowDecoder L B).sites, rail.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (st.a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hrails.2.2.2.2.2 q]
    · exact hlow q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
    · have hD : L.D j ≠ q := sep_D_work L B hn (reg_mem L.D B j (by omega))
        (by simp [workSites, hq])
      exact Ne.symm hD
    · have hS : L.S (B - 2 - j) ≠ q := sep_S_rest L B hn
        (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hq])
      exact Ne.symm hS
  have htLow : L.t ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have hselectLow : rail.basis L.t = true →
      st.a % 2 ^ (bitWidth B / 2) = k % 2 ^ (bitWidth B / 2) := by
    intro htrue
    rw [hrails.2.1] at htrue
    have heq : st.a = k := by simpa using htrue
    rw [heq]
  have hlo := decoderDelta_run_selected (lowDecoder L B) (lowBits L B)
    (st.a % 2 ^ (bitWidth B / 2)) (k % 2 ^ (bitWidth B / 2)) L.t
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 htLow rail m
    hLowRail hselectLow
  have hHighRail : ∀ q ∈ (highDecoder L B).sites, rail.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (st.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hrails.2.2.2.2.2 q]
    · exact hhigh q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
    · have hD : L.D j ≠ q := sep_D_work L B hn (reg_mem L.D B j (by omega))
        (by simp [workSites, hq])
      exact Ne.symm hD
    · have hS : L.S (B - 2 - j) ≠ q := sep_S_rest L B hn
        (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hq])
      exact Ne.symm hS
  have htHigh : L.t ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have hlowT : lowState.basis L.t = rail.basis L.t := hlo.2.2 L.t htLow
  have hHighLowState : ∀ q ∈ (highDecoder L B).sites, lowState.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (st.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hlo.2.2 q]
    · exact hHighRail q hq
    · intro hlq
      exact sep_low_high L B hn hlq hq rfl
  have hselectHigh : lowState.basis L.t = true →
      st.a / 2 ^ (bitWidth B / 2) = k / 2 ^ (bitWidth B / 2) := by
    intro htrue
    rw [hlowT, hrails.2.1] at htrue
    have heq : st.a = k := by simpa using htrue
    rw [heq]
  have hhi := decoderDelta_run_selected (highDecoder L B) (highBits L B)
    (st.a / 2 ^ (bitWidth B / 2)) (k / 2 ^ (bitWidth B / 2)) L.t
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 htHigh lowState m
    hHighLowState hselectHigh
  have hnextA : (unpackSweepStep B j st).a =
      (if rail.basis L.t then 0 else st.a) := by
    rw [hrails.2.1]
    rfl
  change out.phase = s.phase ∧ _
  refine ⟨hhi.1.trans (hlo.1.trans hrails.1), ?_, ?_, ?_⟩
  · intro q hq
    rw [hhi.2.2 q]
    · rw [hlo.2.1 q hq, hnextA]
      cases rail.basis L.t <;> simp
    · intro hhq
      exact sep_low_high L B hn hq hhq rfl
  · intro q hq
    rw [hhi.2.1 q hq, hlowT, hnextA]
    cases rail.basis L.t <;> simp
  · intro q hlq hhq
    exact (hhi.2.2 q hhq).trans (hlo.2.2 q hlq)

theorem unpackStep_live (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let rail := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
      (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
    let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
      (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
    let out := run (cxInto L.t (aTargets L B k)) m decoderState
    out.phase = s.phase ∧
      RealizesUnpackLive L B (unpackSweepStep B j st)
        (decide (st.a = k)) out.basis := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let rail := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
  let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
  let out := run (cxInto L.t (aTargets L B k)) m decoderState
  have hrails := unpackStep_rails L B j hn hj st s m hr
  change rail.phase = s.phase ∧
    rail.basis L.t = decide (st.a = k) ∧
    rail.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    rail.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 → rail.basis (L.S (B - 2 - j)) =
      (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → rail.basis q = s.basis q) at hrails
  have hdec := unpackStep_decoders L B j hn hj st s m hr
  change decoderState.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, decoderState.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        ((unpackSweepStep B j st).a % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, decoderState.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        ((unpackSweepStep B j st).a / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      decoderState.basis q = rail.basis q) at hdec
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hArail : ∀ q ∈ reg L.A (bitWidth B), rail.basis q = s.basis q := by
    intro q hq
    apply hrails.2.2.2.2.2 q
    · exact sep_A_rest L B hn hq (by simp)
    · exact sep_A_rest L B hn hq (by simp)
    · exact Ne.symm (sep_D_work L B hn (reg_mem L.D B j (by omega))
        (by simp [workSites, hq]))
    · exact Ne.symm (sep_S_rest L B hn
        (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hq]))
  have hAdecoder : ∀ q ∈ reg L.A (bitWidth B),
      decoderState.basis q = s.basis q := by
    intro q hq
    rw [hdec.2.2.2 q]
    · exact hArail q hq
    · intro hlq
      exact sep_A_rest L B hn hq (by simp [hlq]) rfl
    · intro hhq
      exact sep_A_rest L B hn hq (by simp [hhq]) rfl
  have hAvalue : regValue (reg L.A (bitWidth B)) decoderState.basis = st.a :=
    (regValue_congr _ _ _ hAdecoder).trans ha
  have htLow : L.t ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have htHigh : L.t ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have htDecoder : decoderState.basis L.t = rail.basis L.t :=
    hdec.2.2.2 L.t htLow htHigh
  have hselected : decoderState.basis L.t = true → st.a = k := by
    intro htrue
    rw [htDecoder, hrails.2.1] at htrue
    simpa using htrue
  have hAout := aTargets_run_value L B st.a k hn decoderState m hAvalue hselected
  change out.phase = decoderState.phase ∧
    regValue (reg L.A (bitWidth B)) out.basis =
      (if decoderState.basis L.t then 0 else st.a) ∧
    (∀ q ∉ reg L.A (bitWidth B), out.basis q = decoderState.basis q) at hAout
  have hnextA : (unpackSweepStep B j st).a =
      (if decoderState.basis L.t then 0 else st.a) := by
    rw [htDecoder, hrails.2.1]
    rfl
  have hnotA_D (i : Nat) (hi : i < B) : L.D i ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_D_work L B hn (reg_mem L.D B i hi) (by simp [workSites, hq]) rfl
  have hnotA_S (i : Nat) (hi : i < B) : L.S i ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_S_rest L B hn (reg_mem L.S B i hi) (by simp [workSites, hq]) rfl
  have hnotA_z : L.z ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_A_rest L B hn hq (by simp) rfl
  have hnotA_t : L.t ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_A_rest L B hn hq (by simp) rfl
  have hpost (q : Wire) (hAq : q ∉ reg L.A (bitWidth B))
      (hlq : q ∉ (lowDecoder L B).sites)
      (hhq : q ∉ (highDecoder L B).sites) : out.basis q = rail.basis q :=
    (hAout.2.2 q hAq).trans (hdec.2.2.2 q hlq hhq)
  have hzPost : out.basis L.z = (unpackSweepStep B j st).z := by
    rw [hpost L.z hnotA_z]
    · exact hrails.2.2.1
    · intro hq
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq) rfl
    · intro hq
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have htPost : out.basis L.t = decide (st.a = k) := by
    rw [hpost L.t hnotA_t htLow htHigh, hrails.2.1]
  have hDPost : ∀ i, i < B - 1 →
      out.basis (L.D i) = (unpackSweepStep B j st).d i := by
    intro i hi
    have hDi : L.D i ∈ reg L.D B := reg_mem L.D B i (by omega)
    have hlD : L.D i ∉ (lowDecoder L B).sites := by
      intro hq
      exact sep_D_work L B hn hDi (by simp [workSites, hq]) rfl
    have hhD : L.D i ∉ (highDecoder L B).sites := by
      intro hq
      exact sep_D_work L B hn hDi (by simp [workSites, hq]) rfl
    rw [hpost (L.D i) (hnotA_D i (by omega)) hlD hhD]
    by_cases hij : i = j
    · subst i
      exact hrails.2.2.2.1
    · rw [hrails.2.2.2.2.2 (L.D i)]
      · rw [hdrail i hi]
        simp [unpackSweepStep, hij]
      · exact sep_D_work L B hn hDi (by simp [workSites])
      · exact sep_D_work L B hn hDi (by simp [workSites])
      · exact reg_ne L.D B i j (D_nodup L B hn) (by omega) (by omega) hij
      · exact Ne.symm (sep_S_rest L B hn
          (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hDi]))
  have hSPost : ∀ i, i < B - 2 →
      out.basis (L.S (B - 2 - i)) =
        (unpackSweepStep B j st).s (B - 2 - i) := by
    intro i hi
    have hindex : B - 2 - i < B := by omega
    have hSi : L.S (B - 2 - i) ∈ reg L.S B :=
      reg_mem L.S B (B - 2 - i) hindex
    have hlS : L.S (B - 2 - i) ∉ (lowDecoder L B).sites := by
      intro hq
      exact sep_S_rest L B hn hSi (by simp [workSites, hq]) rfl
    have hhS : L.S (B - 2 - i) ∉ (highDecoder L B).sites := by
      intro hq
      exact sep_S_rest L B hn hSi (by simp [workSites, hq]) rfl
    rw [hpost _ (hnotA_S _ hindex) hlS hhS]
    by_cases hij : i = j
    · subst i
      exact hrails.2.2.2.2.1 hi
    · have hmirror : B - 2 - i ≠ B - 2 - j := by
        intro heq
        apply hij
        exact (tsub_right_inj (by omega) (by omega)).mp heq
      rw [hrails.2.2.2.2.2 (L.S (B - 2 - i))]
      · rw [hsrail i hi]
        simp [unpackSweepStep, hij, hmirror]
      · exact sep_S_rest L B hn hSi (by simp [workSites])
      · exact sep_S_rest L B hn hSi (by simp [workSites])
      · exact sep_S_rest L B hn hSi
          (by exact List.mem_append_left (workSites L B) (reg_mem L.D B j (by omega)))
      · exact reg_ne L.S B (B - 2 - i) (B - 2 - j) (S_nodup L B hn)
          hindex (by omega) hmirror
  have hLowPost : ∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        ((unpackSweepStep B j st).a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hAout.2.2 q]
    · exact hdec.2.1 q hq
    · intro hAq
      exact sep_A_rest L B hn hAq (by simp [hq]) rfl
  have hHighPost : ∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        ((unpackSweepStep B j st).a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hAout.2.2 q]
    · exact hdec.2.2.1 q hq
    · intro hAq
      exact sep_A_rest L B hn hAq (by simp [hq]) rfl
  refine ⟨hAout.1.trans hdec.1, ?_⟩
  exact ⟨hAout.2.1.trans hnextA.symm, hzPost, htPost, hDPost, hSPost,
    hLowPost, hHighPost⟩

theorem unpackStep_staged_correct (L : Layout) (B u v j : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (hj : j < B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : UnpackSweepInvariant B u v sigma j st)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let rail := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
      (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
    let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
      (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
    let live := run (cxInto L.t (aTargets L B k)) m decoderState
    let out := run ([.measureX L.t [] [.CZ (L.D j) L.z]] : Program) m live
    out.phase = s.phase ∧
      RealizesUnpackSweep L B (unpackSweepStep B j st) out.basis := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let rail := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
  let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
  let live := run (cxInto L.t (aTargets L B k)) m decoderState
  let out := run ([.measureX L.t [] [.CZ (L.D j) L.z]] : Program) m live
  have hlive := unpackStep_live L B j hn hj st s m hr
  change live.phase = s.phase ∧
    RealizesUnpackLive L B (unpackSweepStep B j st)
      (decide (st.a = k)) live.basis at hlive
  rcases hlive.2 with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  let w := u - sigma.toNat
  have hinv' := hinv
  change j ≤ B - 1 ∧ st.z = decide (w < 2 ^ j) ∧
    st.a = (if j < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      st.d i = if i < j then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      st.s (B - 2 - i) = if i < j then halfBit B v i else false) at hinv'
  have hnextInv := unpackSweepStep_invariant B u v sigma j hd hj st hinv
  change j + 1 ≤ B - 1 ∧
    (unpackSweepStep B j st).z = decide (w < 2 ^ (j + 1)) ∧
    (unpackSweepStep B j st).a =
      (if j + 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      (unpackSweepStep B j st).d i =
        if i < j + 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      (unpackSweepStep B j st).s (B - 2 - i) =
        if i < j + 1 then halfBit B v i else false) at hnextInv
  have hmarker : decide (st.a = k) = unpackMarker w j := by
    rw [hinv'.2.2.1]
    simpa [k] using unpack_marker_from_a w j
  have hnextD : (unpackSweepStep B j st).d j = w.testBit j := by
    simpa using hnextInv.2.2.2.1 j hj
  have htValue : live.basis L.t =
      (live.basis (L.D j) && live.basis L.z) := by
    rw [ht, hdrail j hj, hz, hmarker, hnextD, hnextInv.2.1]
    exact (unsweep_t_fix w j).symm
  have hDt : L.D j ≠ L.t := sep_D_work L B hn
    (reg_mem L.D B j (by omega)) (by simp [workSites])
  have hout := erase_and_correct L.t (L.D j) L.z hDt
    (sep_z_t L B hn) live htValue m
  change out = ⟨live.phase, writeBit live.basis L.t false⟩ at hout
  have hframe (q : Wire) (hqt : q ≠ L.t) : out.basis q = live.basis q := by
    rw [hout]
    simp [writeBit, hqt]
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), out.basis q = live.basis q := by
    intro q hq
    apply hframe q
    exact sep_A_rest L B hn hq (by simp)
  change out.phase = s.phase ∧
    RealizesUnpackSweep L B (unpackSweepStep B j st) out.basis
  refine ⟨by rw [hout]; exact hlive.1, ?_⟩
  refine ⟨(regValue_congr _ _ _ hAFrame).trans ha, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hframe L.z (sep_z_t L B hn)]
    exact hz
  · rw [hout]
    simp [writeBit]
  · intro i hi
    rw [hframe (L.D i)]
    · exact hdrail i hi
    · exact sep_D_work L B hn (reg_mem L.D B i (by omega)) (by simp [workSites])
  · intro i hi
    rw [hframe (L.S (B - 2 - i))]
    · exact hsrail i hi
    · exact sep_S_rest L B hn (reg_mem L.S B (B - 2 - i) (by omega))
        (by simp [workSites])
  · intro q hq
    rw [hframe q]
    · exact hlow q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
  · intro q hq
    rw [hframe q]
    · exact hhigh q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))

/-- Exact generated-program form of one ascending inverse-sweep position. -/
theorem unpackStep_correct (L : Layout) (B u v j : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (hj : j < B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : UnpackSweepInvariant B u v sigma j st)
    (hr : RealizesUnpackSweep L B st s.basis) :
    (run (unpackStep L B j) m s).phase = s.phase ∧
      RealizesUnpackSweep L B (unpackSweepStep B j st)
        (run (unpackStep L B j) m s).basis := by
  let k := j + 1
  let p0 : Program := [.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z]
  let p12 : Program := (if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++ [.CX L.t (L.D j)]
  let pLow := cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))
  let pHigh := cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))
  let pA := cxInto L.t (aTargets L B k)
  let pM : Program := [.measureX L.t [] [.CZ (L.D j) L.z]]
  let front := run p0 m s
  let rail := run p12 m front
  let lowState := run pLow m rail
  let decoderState := run pHigh m lowState
  let live := run pA m decoderState
  let out := run pM m live
  have hs := unpackStep_staged_correct L B u v j sigma hd hn hj st s m hinv hr
  change out.phase = s.phase ∧
    RealizesUnpackSweep L B (unpackSweepStep B j st) out.basis at hs
  have hshape : unpackStep L B j =
      p0 ++ (p12 ++ (pLow ++ (pHigh ++ (pA ++ pM)))) := by
    simp [unpackStep, k, p0, p12, pLow, pHigh, pA, pM, aTargets,
      List.append_assoc]
  have hz0 : measurementCount p0 = 0 := by simp [p0, measurementCount]
  have hz12 : measurementCount p12 = 0 := by
    by_cases hnormal : j < B - 2 <;> simp [p12, hnormal, measurementCount]
  have hzLow : measurementCount pLow = 0 := by
    exact cxInto_measurementCount _ _
  have hzHigh : measurementCount pHigh = 0 := by
    exact cxInto_measurementCount _ _
  have hzA : measurementCount pA = 0 := by
    exact cxInto_measurementCount _ _
  have hrun : run (unpackStep L B j) m s = out := by
    rw [hshape]
    rw [run_append_zero_left_spec p0 _ hz0]
    rw [run_append_zero_left_spec p12 _ hz12]
    rw [run_append_zero_left_spec pLow _ hzLow]
    rw [run_append_zero_left_spec pHigh _ hzHigh]
    rw [run_append_zero_left_spec pA _ hzA]
  rw [hrun]
  exact hs

def unpackSweepProgram (L : Layout) (B : Nat) : Nat → Nat → Program
  | _, 0 => []
  | j, n + 1 => unpackStep L B j ++ unpackSweepProgram L B (j + 1) n

theorem unpackSweepProgram_eq_range (L : Layout) (B j n : Nat) :
    unpackSweepProgram L B j n =
      (List.range' j n).flatMap (unpackStep L B) := by
  induction n generalizing j with
  | zero => rfl
  | succ n ih =>
      simp [unpackSweepProgram, List.range'_succ, ih]

theorem unpackSweepProgram_correct (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (j n : Nat)
    (hjn : j + n ≤ B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hinv : UnpackSweepInvariant B u v sigma j st)
    (hr : RealizesUnpackSweep L B st s.basis) :
    (run (unpackSweepProgram L B j n) m s).phase = s.phase ∧
    RealizesUnpackSweep L B (unpackSweepRun B j n st)
      (run (unpackSweepProgram L B j n) m s).basis := by
  induction n generalizing j st s m with
  | zero =>
      constructor
      · rfl
      · exact hr
  | succ n ih =>
      have hj : j < B - 1 := by omega
      have hnext : j + 1 + n ≤ B - 1 := by omega
      let first := run (unpackStep L B j)
        (m.take (measurementCount (unpackStep L B j))) s
      have hfirst := unpackStep_correct L B u v j sigma hd hn hj st s
        (m.take (measurementCount (unpackStep L B j))) hinv hr
      change first.phase = s.phase ∧
        RealizesUnpackSweep L B (unpackSweepStep B j st) first.basis at hfirst
      have hinvNext := unpackSweepStep_invariant B u v sigma j hd hj st hinv
      have hrest := ih (j + 1) hnext (unpackSweepStep B j st) first
        (m.drop (measurementCount (unpackStep L B j))) hinvNext hfirst.2
      rw [unpackSweepProgram, run_append]
      change (run (unpackSweepProgram L B (j + 1) n)
        (m.drop (measurementCount (unpackStep L B j))) first).phase = s.phase ∧ _
      refine ⟨hrest.1.trans hfirst.1, ?_⟩
      simpa [unpackSweepRun] using hrest.2

theorem unpackSweepProgram_zero_eq (L : Layout) (B : Nat) (hmin : 3 ≤ B) :
    unpackSweepProgram L B 0 (B - 1) =
      (List.range (B - 2)).flatMap (unpackStep L B) ++
        unpackStep L B (B - 2) := by
  rw [unpackSweepProgram_eq_range]
  have hB : B - 1 = (B - 2) + 1 := by omega
  rw [hB, List.range'_concat, List.flatMap_append]
  rw [← List.range_eq_range']
  simp


theorem compact_decoderPair_output (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let value := natBitLength (u - sigma.toNat)
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧ PairDecoderOneHotAt L B value out.basis ∧
      (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
        out.basis q = s.basis q) := by
  let value := natBitLength (u - sigma.toNat)
  change regValue (reg L.A (bitWidth B)) s.basis = value ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc
  have hbound : value < 2 ^ bitWidth B := by
    have hlen := domain_w_bitLength_le B u v sigma hd
    have hB : 3 ≤ B := hd.1
    calc
      value ≤ B - 1 := hlen
      _ < B := by omega
      _ ≤ 2 ^ bitWidth B := bitWidth_bound B (by omega)
  have hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inl (Or.inr hq)
  have hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inr hq
  exact decoderPair_output L B value hn s m hc.1 hbound hlClean hhClean

theorem compact_decoderPair_sites (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let value := natBitLength (u - sigma.toNat)
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      out.basis q = s.basis q) := by
  let value := natBitLength (u - sigma.toNat)
  change regValue (reg L.A (bitWidth B)) s.basis = value ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc
  have hbound : value < 2 ^ bitWidth B := by
    have hlen := domain_w_bitLength_le B u v sigma hd
    have hB : 3 ≤ B := hd.1
    calc
      value ≤ B - 1 := hlen
      _ < B := by omega
      _ ≤ 2 ^ bitWidth B := bitWidth_bound B (by omega)
  have hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inl (Or.inr hq)
  have hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inr hq
  exact decoderPair_sites L B value hn s m hc.1 hbound hlClean hhClean

/-- The concrete decoder controls immediately after the two unpack decoder
programs select zero exactly for the terminal magnitude. -/
theorem compact_initial_decoder_marker (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧
    (out.basis (outAt (highDecoder L B) 0 L.z) &&
      out.basis (outAt (lowDecoder L B) 0 L.z)) =
        decide (u - sigma.toNat < 1) := by
  let lowState := run (lowDecoder L B).program m s
  let out := run (highDecoder L B).program m lowState
  have hp := compact_decoderPair_output L B u v sigma hd hn s m hc
  refine ⟨hp.1, ?_⟩
  have hm := initial_split_decoder_selected (bitWidth B / 2)
    (u - sigma.toNat)
    (decoderValue (lowDecoder L B) out.basis)
    (decoderValue (highDecoder L B) out.basis) hp.2.1
  have hlo : 0 < (lowDecoder L B).outputs.length := by
    rw [lowDecoder, oneHot_outputs_length]
    positivity
  have hhi : 0 < (highDecoder L B).outputs.length := by
    rw [highDecoder, oneHot_outputs_length]
    positivity
  have hloFallback : outAt (lowDecoder L B) 0 L.z =
      outAt (lowDecoder L B) 0 0 := by
    simp only [outAt]
    rw [List.getD_eq_getElem _ _ hlo, List.getD_eq_getElem _ _ hlo]
  have hhiFallback : outAt (highDecoder L B) 0 L.z =
      outAt (highDecoder L B) 0 0 := by
    simp only [outAt]
    rw [List.getD_eq_getElem _ _ hhi, List.getD_eq_getElem _ _ hhi]
  simpa [out, lowState, decoderValue, hlo, hhi, hloFallback, hhiFallback] using hm

theorem ccx_clean_target (a b target : Wire) (s : State) (m : List Bool)
    (hclean : s.basis target = false) :
    let out := run ([.CCX a b target] : Program) m s
    out.phase = s.phase ∧
    out.basis target = (s.basis a && s.basis b) ∧
    (∀ q, q ≠ target → out.basis q = s.basis q) := by
  simp [run, writeBit, hclean]
  intro q hq
  simp [Function.update, hq]

/-- The initial CCX of `unpack` turns the decoder-zero product into the
thermometer bit and leaves the split decoder invariant intact. -/
theorem compact_initial_z (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let lowState := run (lowDecoder L B).program m s
    let decoderState := run (highDecoder L B).program m lowState
    let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
    out.phase = s.phase ∧
    out.basis L.z = decide (u - sigma.toNat < 1) ∧
    PairDecoderOneHotAt L B (natBitLength (u - sigma.toNat)) out.basis := by
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  have hp := compact_decoderPair_output L B u v sigma hd hn s m hc
  have hm := compact_initial_decoder_marker L B u v sigma hd hn s m hc
  have hc' := hc
  change regValue (reg L.A (bitWidth B)) s.basis = natBitLength (u - sigma.toNat) ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc'
  have hzInput : s.basis L.z = false := by
    apply hc'.2.2.2.2.2 L.z
    simp
  have hzLow : L.z ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have hzHigh : L.z ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have hzDecoder : decoderState.basis L.z = false := by
    exact (hp.2.2 L.z hzLow hzHigh).trans hzInput
  have hgate := ccx_clean_target (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z decoderState m hzDecoder
  have hpair : PairDecoderOneHotAt L B (natBitLength (u - sigma.toNat)) out.basis := by
    rcases hp.2.1 with ⟨hlow, hhigh⟩
    constructor
    · intro i
      rw [← hlow i]
      unfold decoderValue
      split
      next hi =>
        rw [hgate.2.2]
        have heq : outAt (lowDecoder L B) i 0 =
            outAt (lowDecoder L B) i L.z := by
          simp only [outAt]
          rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hi]
        rw [heq]
        exact low_output_ne_z L B i hn hi
      next => rfl
    · intro i
      rw [← hhigh i]
      unfold decoderValue
      split
      next hi =>
        rw [hgate.2.2]
        have heq : outAt (highDecoder L B) i 0 =
            outAt (highDecoder L B) i L.z := by
          simp only [outAt]
          rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hi]
        rw [heq]
        exact high_output_ne_z L B i hn hi
      next => rfl
  refine ⟨hgate.1.trans hp.1, ?_, hpair⟩
  rw [hgate.2.1]
  exact hm.2

/-- Complete generated-site state after the initial inverse-sweep marker CCX.
The marker target is disjoint from both decoder work areas, so their exact
internal basis states survive unchanged. -/
theorem compact_initial_z_sites (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let value := natBitLength (u - sigma.toNat)
    let lowState := run (lowDecoder L B).program m s
    let decoderState := run (highDecoder L B).program m lowState
    let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) := by
  let value := natBitLength (u - sigma.toNat)
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  have hp := compact_decoderPair_sites L B u v sigma hd hn s m hc
  have hinit := compact_initial_z L B u v sigma hd hn s m hc
  refine ⟨hinit.1, ?_, ?_⟩
  · intro q hq
    have hqz : q ≠ L.z := by
      exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
    change (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q = _
    rw [show (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q =
        decoderState.basis q by simp [run, writeBit, hqz]]
    exact hp.2.1 q hq
  · intro q hq
    have hqz : q ≠ L.z := by
      exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
    change (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q = _
    rw [show (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q =
        decoderState.basis q by simp [run, writeBit, hqz]]
    exact hp.2.2.1 q hq

/-- The concrete prefix of `unpack` realizes LT8's scalar inverse-sweep
initial state, including all rail bits and complete decoder work states. -/
theorem compact_initial_realizes (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let lowState := run (lowDecoder L B).program m s
    let decoderState := run (highDecoder L B).program m lowState
    let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
    out.phase = s.phase ∧
      RealizesUnpackSweep L B
        (initialUnpackSweepState B (u - sigma.toNat) v) out.basis := by
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  have hp := compact_decoderPair_sites L B u v sigma hd hn s m hc
  have hz := compact_initial_z L B u v sigma hd hn s m hc
  have hsites := compact_initial_z_sites L B u v sigma hd hn s m hc
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hl : q ∉ (lowDecoder L B).sites)
      (hh : q ∉ (highDecoder L B).sites) : out.basis q = s.basis q := by
    change (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q = _
    rw [show (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q =
        decoderState.basis q by simp [run, writeBit, hqz]]
    exact hp.2.2.2 q hl hh
  have hc' := hc
  change regValue (reg L.A (bitWidth B)) s.basis = natBitLength (u - sigma.toNat) ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc'
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), out.basis q = s.basis q := by
    intro q hq
    apply hframe q
    · exact sep_A_rest L B hn hq (by simp) 
    · intro hsite
      exact sep_A_rest L B hn hq (by simp [hsite]) rfl
    · intro hsite
      exact sep_A_rest L B hn hq (by simp [hsite]) rfl
  have htInput : s.basis L.t = false := by
    apply hc'.2.2.2.2.2 L.t
    simp
  have htOut : out.basis L.t = false := by
    rw [hframe L.t (Ne.symm (sep_z_t L B hn))]
    · exact htInput
    · intro hsite
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hsite) rfl
    · intro hsite
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hsite) rfl
  have hSZero : ∀ q ∈ reg L.S B, s.basis q = false :=
    (regValue_zero (reg L.S B) s.basis).mp hc'.2.2.2.2.1
  refine ⟨hz.1, ?_⟩
  change RealizesUnpackSweep L B
    (initialUnpackSweepState B (u - sigma.toNat) v) out.basis
  refine ⟨(regValue_congr _ _ _ hAFrame).trans hc'.1, hz.2.1, htOut, ?_, ?_,
    hsites.2.1, hsites.2.2⟩
  · intro i hi
    change out.basis (L.D i) = payloadBit B (u - sigma.toNat) v i
    have hDi : L.D i ∈ reg L.D B := reg_mem L.D B i (by omega)
    have hDFrame : out.basis (L.D i) = s.basis (L.D i) := by
      apply hframe (L.D i)
      · exact sep_D_work L B hn hDi (by simp [workSites])
      · intro hsite
        exact sep_D_work L B hn hDi (by simp [workSites, hsite]) rfl
      · intro hsite
        exact sep_D_work L B hn hDi (by simp [workSites, hsite]) rfl
    by_cases hilow : i < B - 2
    · have hreg : i < (reg L.D (B - 2)).length := by simpa [reg] using hilow
      have hwire : (reg L.D (B - 2)).getD i 0 = L.D i := by
        rw [List.getD_eq_getElem _ _ hreg]
        simp [reg]
      have hbit := regValue_getD_testBit (reg L.D (B - 2)) i 0 s.basis hreg
      rw [hwire] at hbit
      rw [hc'.2.1] at hbit
      rw [hDFrame]
      exact hbit.trans (compactF_testBit B (u - sigma.toNat) v i hilow)
    · have hitop : i = B - 2 := by omega
      subst i
      rw [hDFrame, hc'.2.2.1]
      exact (payloadBit_top_false B u v sigma hd).symm
  · intro i hi
    have hindex : B - 2 - i < B := by omega
    have hSi : L.S (B - 2 - i) ∈ reg L.S B :=
      reg_mem L.S B (B - 2 - i) hindex
    have hSFrame : out.basis (L.S (B - 2 - i)) = s.basis (L.S (B - 2 - i)) := by
      apply hframe (L.S (B - 2 - i))
      · exact sep_S_rest L B hn hSi (by simp [workSites])
      · intro hsite
        exact sep_S_rest L B hn hSi (by simp [workSites, hsite]) rfl
      · intro hsite
        exact sep_S_rest L B hn hSi (by simp [workSites, hsite]) rfl
    rw [hSFrame, hSZero _ hSi]
    rfl

theorem compact_unpack_sweep (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let init : Program := (lowDecoder L B).program ++ (highDecoder L B).program ++
      [.CCX (outAt (highDecoder L B) 0 L.z)
        (outAt (lowDecoder L B) 0 L.z) L.z]
    let sweepPrefix := init ++ unpackSweepProgram L B 0 (B - 1)
    let out := run sweepPrefix m s
    out.phase = s.phase ∧
    RealizesUnpackSweep L B
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) out.basis := by
  let init : Program := (lowDecoder L B).program ++ (highDecoder L B).program ++
    [.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z]
  let sweepPrefix := init ++ unpackSweepProgram L B 0 (B - 1)
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let initial := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  let out := run sweepPrefix m s
  have hi := compact_initial_realizes L B u v sigma hd hn s m hc
  change initial.phase = s.phase ∧
    RealizesUnpackSweep L B
      (initialUnpackSweepState B (u - sigma.toNat) v) initial.basis at hi
  have hzLow : measurementCount (lowDecoder L B).program = 0 := by
    exact oneHot_program_measurements _ _
  have hzHigh : measurementCount (highDecoder L B).program = 0 := by
    exact oneHot_program_measurements _ _
  have hzInit : measurementCount init = 0 := by
    simp [init, measurementCount, hzLow, hzHigh]
  have hinitRun : run init m s = initial := by
    have hshape : init = (lowDecoder L B).program ++
        ((highDecoder L B).program ++
          [.CCX (outAt (highDecoder L B) 0 L.z)
            (outAt (lowDecoder L B) 0 L.z) L.z]) := by
      simp [init, List.append_assoc]
    rw [hshape]
    rw [run_append_zero_left_spec (lowDecoder L B).program _ hzLow]
    rw [run_append_zero_left_spec (highDecoder L B).program _ hzHigh]
  have hsweep := unpackSweepProgram_correct L B u v sigma hd hn 0 (B - 1)
    (by omega) (initialUnpackSweepState B (u - sigma.toNat) v) initial m
    (initialUnpackSweepState_invariant B u v sigma hd) hi.2
  have hout : out = run (unpackSweepProgram L B 0 (B - 1)) m initial := by
    dsimp only [out, sweepPrefix]
    rw [run_append_zero_left_spec init _ hzInit, hinitRun]
  change out.phase = s.phase ∧
    RealizesUnpackSweep L B
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) out.basis
  rw [hout]
  exact ⟨hsweep.1.trans hi.1, hsweep.2⟩

/-! The shortened unpack adder is most convenient to expose recursively.  A
`fuel` of `n` allocates carries at positions `j, ..., j+n-1`; the terminal
position `j+n` writes its outgoing carry directly into the following S bit. -/

def unpackAdderUp (L : Layout) (j : Nat) (prev carry : Wire) : Program :=
  [.CX prev (L.S j), .CX prev (L.D j),
   .CCX (L.S j) (L.D j) carry, .CX prev carry]

def unpackAdderDown (L : Layout) (j : Nat) (prev carry : Wire) : Program :=
  [.CX prev carry, .measureX carry [] [.CZ (L.S j) (L.D j)],
   .CX prev (L.D j), .CX (L.D j) (L.S j)]

def unpackAdderTerminal (L : Layout) (j : Nat) (prev : Wire) : Program :=
  [.CX prev (L.S j), .CX prev (L.D j),
   .CX prev (L.S (j + 1)), .CCX (L.S j) (L.D j) (L.S (j + 1)),
   .CX prev (L.D j), .CX (L.D j) (L.S j)]

def unpackAdderLadder (L : Layout) : Nat → Nat → Wire → Program
  | 0, j, prev => unpackAdderTerminal L j prev
  | n + 1, j, prev =>
      unpackAdderUp L j prev (L.C j) ++
      unpackAdderLadder L n (j + 1) (L.C j) ++
      unpackAdderDown L j prev (L.C j)

theorem unpackAdderLadder_expand (L : Layout) (j n : Nat) (prev : Wire) :
    unpackAdderLadder L (n + 1) j prev =
      unpackAdderUp L j prev (L.C j) ++
      (List.range' (j + 1) n).flatMap (adderMiddle L) ++
      unpackAdderTerminal L (j + n + 1) (L.C (j + n)) ++
      (List.range' (j + 1) n).reverse.flatMap (adderDown L) ++
      unpackAdderDown L j prev (L.C j) := by
  induction n generalizing j prev with
  | zero => simp [unpackAdderLadder]
  | succ n ih =>
      rw [unpackAdderLadder]
      rw [ih (j := j + 1) (prev := L.C j)]
      simp only [List.range'_succ, List.flatMap_cons, List.reverse_cons,
        List.flatMap_append, List.flatMap_singleton]
      simp [unpackAdderUp, unpackAdderDown, adderMiddle, adderDown,
        List.append_assoc]
      congr 2 <;> omega

theorem unpackAdder_eq_ladder (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    unpackAdder L B =
      unpackAdderLadder L (B - 2) 0 (L.D (B - 1)) := by
  have hfuel : B - 2 = (B - 3) + 1 := by omega
  rw [hfuel, unpackAdderLadder_expand]
  have hrange : List.range' 1 (B - 3) =
      (List.range (B - 3)).map (fun r => r + 1) := by
    rw [List.range'_eq_map_range]
    apply List.map_congr_left
    intro r hr
    omega
  rw [hrange]
  have hcarry : B - 3 = B - 2 - 1 := by omega
  have hterm : B - 2 - 1 + 1 = B - 2 := by omega
  have hplus : B - 2 + 1 = B - 1 := by omega
  simp [unpackAdder, unpackAdderUp, unpackAdderDown, unpackAdderTerminal,
    adderTopDown, hcarry, hterm, List.append_assoc]
  rw [List.flatMap_map]
  simp [hplus]

def railSegment (f : Nat → Wire) (j n : Nat) : List Wire :=
  (List.range' j n).map f

@[simp] theorem railSegment_zero (f : Nat → Wire) (j : Nat) :
    railSegment f j 0 = [] := rfl

@[simp] theorem railSegment_succ (f : Nat → Wire) (j n : Nat) :
    railSegment f j (n + 1) = f j :: railSegment f (j + 1) n := by
  simp [railSegment, List.range'_succ]

theorem unpackAdderUp_correct (sWire dWire prev carry : Wire)
    (hn : [sWire, dWire, prev, carry].Nodup) (s : State) (m : List Bool)
    (hclean : s.basis carry = false) :
    let p : Program :=
      [.CX prev sWire, .CX prev dWire, .CCX sWire dWire carry, .CX prev carry]
    let out := run p m s
    out.phase = s.phase ∧
    out.basis sWire = (s.basis sWire ^^ s.basis prev) ∧
    out.basis dWire = (s.basis dWire ^^ s.basis prev) ∧
    out.basis carry = carryBit (s.basis dWire) (s.basis sWire) (s.basis prev) ∧
    (∀ q, q ∉ [sWire, dWire, carry] → out.basis q = s.basis q) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  obtain ⟨⟨hsd, hsp, hsc⟩, ⟨hdp, hdc⟩, hpc⟩ := hn
  dsimp
  refine ⟨rfl, ?_, ?_, ?_, ?_⟩
  · simp [run, writeBit, Function.update, hsd, hsp, hsc, hdp, hdc, hpc,
      Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp, Ne.symm hdc,
      Ne.symm hpc]
  · simp [run, writeBit, Function.update, hsd, hsp, hsc, hdp, hdc, hpc,
      Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp, Ne.symm hdc,
      Ne.symm hpc]
  · cases hs : s.basis sWire <;> cases hd : s.basis dWire <;>
      cases hp : s.basis prev <;>
      simp [run, writeBit, Function.update, hsd, hsp, hsc, hdp, hdc, hpc,
        Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp, Ne.symm hdc,
        Ne.symm hpc, hclean, carryBit, hs, hd, hp]
  · intro q hq
    simp only [List.mem_cons, List.mem_singleton, not_or] at hq
    simp [run, writeBit, Function.update, hq.1, hq.2.1, hq.2.2]

theorem unpackAdderDown_correct (sWire dWire prev carry : Wire)
    (hn : [sWire, dWire, prev, carry].Nodup) (s : State) (m : List Bool)
    (S D P : Bool)
    (hs : s.basis sWire = (S ^^ P)) (hd : s.basis dWire = (D ^^ P))
    (hp : s.basis prev = P)
    (hc : s.basis carry = carryBit D S P) :
    let p : Program :=
      [.CX prev carry, .measureX carry [] [.CZ sWire dWire],
       .CX prev dWire, .CX dWire sWire]
    let out := run p m s
    out.phase = s.phase ∧ out.basis sWire = sumBit D S P ∧
    out.basis dWire = D ∧ out.basis carry = false ∧
    (∀ q, q ∉ [sWire, dWire, carry] → out.basis q = s.basis q) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  obtain ⟨⟨hsd, hsp, hsc⟩, ⟨hdp, hdc⟩, hpc⟩ := hn
  dsimp
  cases S <;> cases D <;> cases P <;> cases hm : m.headD false <;>
    simp_all [run, measureAndCorrect, ECDSAAdd.correct, writeBit, Function.update,
      carryBit, sumBit, Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp,
      Ne.symm hdc, Ne.symm hpc]

theorem unpackAdderTerminal_correct (sWire dWire top prev : Wire)
    (hn : [sWire, dWire, top, prev].Nodup) (s : State) (m : List Bool)
    (htop : s.basis top = false) :
    let p : Program :=
      [.CX prev sWire, .CX prev dWire, .CX prev top,
       .CCX sWire dWire top, .CX prev dWire, .CX dWire sWire]
    let out := run p m s
    out.phase = s.phase ∧
    regValue [sWire, top] out.basis =
      regValue [dWire] s.basis + regValue [sWire] s.basis +
        (s.basis prev).toNat ∧
    (∀ q, q ∉ [sWire, top] → out.basis q = s.basis q) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  obtain ⟨⟨hsd, hst, hsp⟩, ⟨hdt, hdp⟩, htp⟩ := hn
  dsimp
  refine ⟨rfl, ?_, ?_⟩
  · cases hs : s.basis sWire <;> cases hd : s.basis dWire <;>
      cases hp : s.basis prev <;>
      simp [run, regValue, writeBit, Function.update, hsd, hst, hsp, hdt, hdp,
        htp, Ne.symm hsd, Ne.symm hst, Ne.symm hsp, Ne.symm hdt, Ne.symm hdp,
        Ne.symm htp, htop, hs, hd, hp]
  · intro q hq
    simp only [List.mem_cons, List.mem_singleton, not_or] at hq
    by_cases hqd : q = dWire
    · subst q
      simp [run, writeBit, Function.update, hsd, hst, hsp, hdt, hdp, htp,
        Ne.symm hsd, Ne.symm hst, Ne.symm hsp, Ne.symm hdt, Ne.symm hdp,
        Ne.symm htp]
    · by_cases hqp : q = prev
      · subst q
        simp [run, writeBit, Function.update, hsd, hst, hsp, hdt, hdp, htp,
          Ne.symm hsd, Ne.symm hst, Ne.symm hsp, Ne.symm hdt, Ne.symm hdp,
          Ne.symm htp]
      · simp [run, writeBit, Function.update, hq.1, hq.2, hqd, hqp]

theorem nodup_of_subcount {α : Type} [BEq α] [LawfulBEq α]
    (xs ys : List α) (hn : xs.Nodup)
    (hsub : ∀ q, ys.count q ≤ xs.count q) : ys.Nodup := by
  apply List.nodup_iff_count_le_one.mpr
  intro q
  exact (hsub q).trans (List.nodup_iff_count_le_one.mp hn q)

theorem regValue_cons_spec (q : Wire) (qs : List Wire) (b : BasisState) :
    regValue (q :: qs) b = (b q).toNat + 2 * regValue qs b := by
  cases hq : b q <;> simp [regValue, hq]

/-- Exact semantic contract of the recursively exposed shortened adder.  It
adds an `(n+1)`-bit D segment and carry-in into an `(n+2)`-bit S segment whose
top bit is initially clean, restores every non-S wire, and restores phase for
every measurement tape. -/
theorem unpackAdderLadder_correct (L : Layout) (n j : Nat) (prev : Wire)
    (s : State) (m : List Bool)
    (hn : (prev :: railSegment L.D j (n + 1) ++
      railSegment L.S j (n + 2) ++ railSegment L.C j n).Nodup)
    (hclean : ∀ q ∈ railSegment L.C j n, s.basis q = false)
    (htop : s.basis (L.S (j + n + 1)) = false) :
    let out := run (unpackAdderLadder L n j prev) m s
    out.phase = s.phase ∧
    regValue (railSegment L.S j (n + 2)) out.basis =
      regValue (railSegment L.D j (n + 1)) s.basis +
      regValue (railSegment L.S j (n + 1)) s.basis +
      (s.basis prev).toNat ∧
    (∀ q, q ∉ railSegment L.S j (n + 2) → out.basis q = s.basis q) := by
  induction n generalizing j prev s m with
  | zero =>
      have hD0 : railSegment L.D j 1 = [L.D j] := by
        simp only [railSegment_succ, railSegment_zero]
      have hS0 : railSegment L.S j 2 = [L.S j, L.S (j + 1)] := by
        rw [show 2 = 1 + 1 by omega, railSegment_succ, railSegment_succ]
        rfl
      have hn0 : (prev :: [L.D j] ++ [L.S j, L.S (j + 1)]).Nodup := by
        simpa [hD0, hS0] using hn
      have hterm : [L.S j, L.D j, L.S (j + 1), prev].Nodup := by
        apply nodup_of_subcount (prev :: [L.D j] ++ [L.S j, L.S (j + 1)]) _ hn0
        intro q
        simp only [List.count_cons, List.count_append, List.count_nil]
        omega
      have h := unpackAdderTerminal_correct (L.S j) (L.D j) (L.S (j + 1))
        prev hterm s m htop
      simpa [unpackAdderLadder, hD0, hS0] using h
  | succ n ih =>
      let up := unpackAdderUp L j prev (L.C j)
      let tail := unpackAdderLadder L n (j + 1) (L.C j)
      let down := unpackAdderDown L j prev (L.C j)
      let u := run up m s
      let v := run tail m u
      let out := run down (m.drop (measurementCount tail)) v
      have hDall : railSegment L.D j (n + 2) =
          L.D j :: railSegment L.D (j + 1) (n + 1) := by
        simpa only using railSegment_succ L.D j (n + 1)
      have hSall : railSegment L.S j (n + 3) =
          L.S j :: railSegment L.S (j + 1) (n + 2) := by
        rw [show n + 3 = (n + 2) + 1 by omega, railSegment_succ]
      have hSlow : railSegment L.S j (n + 2) =
          L.S j :: railSegment L.S (j + 1) (n + 1) := by
        simpa only using railSegment_succ L.S j (n + 1)
      have hCall : railSegment L.C j (n + 1) =
          L.C j :: railSegment L.C (j + 1) n := by
        exact railSegment_succ L.C j n
      have hnNorm : (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
          (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
          (L.C j :: railSegment L.C (j + 1) n)).Nodup := by
        simpa [hDall, hSall, hCall] using hn
      have hupN : [L.S j, L.D j, prev, L.C j].Nodup := by
        apply nodup_of_subcount
          (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
            (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
            (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
        intro q
        simp only [List.count_cons, List.count_append, List.count_nil]
        omega
      have hcj : s.basis (L.C j) = false := hclean (L.C j) (by rw [hCall]; simp)
      have hup := unpackAdderUp_correct (L.S j) (L.D j) prev (L.C j)
        hupN s m hcj
      change u.phase = s.phase ∧
        u.basis (L.S j) = (s.basis (L.S j) ^^ s.basis prev) ∧
        u.basis (L.D j) = (s.basis (L.D j) ^^ s.basis prev) ∧
        u.basis (L.C j) = carryBit (s.basis (L.D j)) (s.basis (L.S j))
          (s.basis prev) ∧
        (∀ q, q ∉ [L.S j, L.D j, L.C j] → u.basis q = s.basis q) at hup
      have htailN : (L.C j :: railSegment L.D (j + 1) (n + 1) ++
          railSegment L.S (j + 1) (n + 2) ++ railSegment L.C (j + 1) n).Nodup := by
        apply nodup_of_subcount
          (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
            (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
            (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
        intro q
        simp only [List.count_cons, List.count_append]
        omega
      have hcurrentAway : ∀ q ∈ railSegment L.C (j + 1) n,
          q ∉ [L.S j, L.D j, L.C j] := by
        intro q hq
        have hsep : ([L.S j, L.D j, L.C j] ++
            railSegment L.C (j + 1) n).Nodup := by
          apply nodup_of_subcount
            (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
              (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
              (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
          intro r
          simp only [List.count_cons, List.count_append, List.count_nil]
          omega
        have hd := (List.nodup_append'.mp hsep).2.2
        intro hm
        exact List.disjoint_left.mp hd hm hq
      have htailClean : ∀ q ∈ railSegment L.C (j + 1) n,
          u.basis q = false := by
        intro q hq
        rw [hup.2.2.2.2 q (hcurrentAway q hq)]
        exact hclean q (by simp [hq])
      have hheadS : ([L.S j, L.D j, prev, L.C j] ++
          railSegment L.S (j + 1) (n + 2)).Nodup := by
        apply nodup_of_subcount
          (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
            (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
            (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
        intro r
        simp only [List.count_cons, List.count_append, List.count_nil]
        omega
      have htopMem : L.S (j + 1 + n + 1) ∈
          railSegment L.S (j + 1) (n + 2) := by
        apply List.mem_map.mpr
        refine ⟨j + 1 + n + 1, ?_, rfl⟩
        rw [List.mem_range'_1]
        omega
      have htopAway : L.S (j + 1 + n + 1) ∉ [L.S j, L.D j, L.C j] := by
        have hsep : ([L.S j, L.D j, L.C j] ++
            railSegment L.S (j + 1) (n + 2)).Nodup := by
          apply nodup_of_subcount
            (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
              (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
              (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
          intro r
          simp only [List.count_cons, List.count_append, List.count_nil]
          omega
        exact fun hm => List.disjoint_left.mp (List.nodup_append'.mp hsep).2.2 hm htopMem
      have htopU : u.basis (L.S (j + 1 + n + 1)) = false := by
        rw [hup.2.2.2.2 _ htopAway]
        have hidx : j + 1 + n + 1 = j + (n + 1) + 1 := by omega
        rw [hidx]
        exact htop
      have htail := ih (j + 1) (L.C j) u m htailN htailClean htopU
      change v.phase = u.phase ∧
        regValue (railSegment L.S (j + 1) (n + 2)) v.basis =
          regValue (railSegment L.D (j + 1) (n + 1)) u.basis +
          regValue (railSegment L.S (j + 1) (n + 1)) u.basis +
          (u.basis (L.C j)).toNat ∧
        (∀ q, q ∉ railSegment L.S (j + 1) (n + 2) →
          v.basis q = u.basis q) at htail
      have hheadAway : ∀ q ∈ [L.S j, L.D j, prev, L.C j],
          q ∉ railSegment L.S (j + 1) (n + 2) := by
        intro q hq hm
        exact List.disjoint_left.mp (List.nodup_append'.mp hheadS).2.2 hq hm
      have hvS : v.basis (L.S j) = (s.basis (L.S j) ^^ s.basis prev) := by
        rw [htail.2.2 (L.S j) (hheadAway _ (by simp))]
        exact hup.2.1
      have hvD : v.basis (L.D j) = (s.basis (L.D j) ^^ s.basis prev) := by
        rw [htail.2.2 (L.D j) (hheadAway _ (by simp))]
        exact hup.2.2.1
      have hvP : v.basis prev = s.basis prev := by
        rw [htail.2.2 prev (hheadAway _ (by simp))]
        have hprevList : (prev :: [L.S j, L.D j, L.C j]).Nodup := by
          apply nodup_of_subcount [L.S j, L.D j, prev, L.C j] _ hupN
          intro r
          simp only [List.count_cons, List.count_nil]
          omega
        exact hup.2.2.2.2 prev (List.nodup_cons.mp hprevList).1
      have hvC : v.basis (L.C j) = carryBit (s.basis (L.D j))
          (s.basis (L.S j)) (s.basis prev) := by
        rw [htail.2.2 (L.C j) (hheadAway _ (by simp))]
        exact hup.2.2.2.1
      have hdown := unpackAdderDown_correct (L.S j) (L.D j) prev (L.C j)
        hupN v (m.drop (measurementCount tail)) (s.basis (L.S j))
        (s.basis (L.D j)) (s.basis prev) hvS hvD hvP hvC
      change out.phase = v.phase ∧
        out.basis (L.S j) = sumBit (s.basis (L.D j)) (s.basis (L.S j))
          (s.basis prev) ∧
        out.basis (L.D j) = s.basis (L.D j) ∧
        out.basis (L.C j) = false ∧
        (∀ q, q ∉ [L.S j, L.D j, L.C j] → out.basis q = v.basis q) at hdown
      have hupCount : measurementCount up = 0 := by
        simp [up, unpackAdderUp, measurementCount]
      have hrun : run (unpackAdderLadder L (n + 1) j prev) m s = out := by
        simp only [unpackAdderLadder]
        rw [run_append, measurementCount_append, hupCount, Nat.zero_add]
        rw [run_append, hupCount, List.take_zero, List.drop_zero]
        rw [run_take]
        rfl
      rw [hrun]
      refine ⟨hdown.1.trans (htail.1.trans hup.1), ?_, ?_⟩
      · have htailD : regValue (railSegment L.D (j + 1) (n + 1)) u.basis =
            regValue (railSegment L.D (j + 1) (n + 1)) s.basis := by
          apply regValue_congr
          intro q hq
          apply hup.2.2.2.2 q
          have hsep : ([L.S j, L.D j, L.C j] ++
              railSegment L.D (j + 1) (n + 1)).Nodup := by
            apply nodup_of_subcount
              (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
                (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
                (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
            intro r
            simp only [List.count_cons, List.count_append, List.count_nil]
            omega
          intro hm
          exact List.disjoint_left.mp (List.nodup_append'.mp hsep).2.2 hm hq
        have htailS : regValue (railSegment L.S (j + 1) (n + 1)) u.basis =
            regValue (railSegment L.S (j + 1) (n + 1)) s.basis := by
          apply regValue_congr
          intro q hq
          apply hup.2.2.2.2 q
          have hqFull : q ∈ railSegment L.S (j + 1) (n + 2) := by
            rcases List.mem_map.mp hq with ⟨i, hi, rfl⟩
            apply List.mem_map.mpr
            refine ⟨i, ?_, rfl⟩
            simp only [List.mem_range'_1] at hi ⊢
            omega
          intro hm
          exact List.disjoint_left.mp (List.nodup_append'.mp hheadS).2.2
            (by
              simp only [List.mem_cons] at hm ⊢
              tauto) hqFull
        have houtTail : regValue (railSegment L.S (j + 1) (n + 2)) out.basis =
            regValue (railSegment L.S (j + 1) (n + 2)) v.basis := by
          apply regValue_congr
          intro q hq
          apply hdown.2.2.2.2 q
          have hsep : ([L.S j, L.D j, L.C j] ++
              railSegment L.S (j + 1) (n + 2)).Nodup := by
            apply nodup_of_subcount
              (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
                (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
                (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
            intro r
            simp only [List.count_cons, List.count_append, List.count_nil]
            omega
          intro hm
          exact List.disjoint_left.mp (List.nodup_append'.mp hsep).2.2 hm hq
        rw [hSall, hDall, hSlow]
        rw [regValue_cons_spec, regValue_cons_spec, regValue_cons_spec]
        rw [hdown.2.1, houtTail, htail.2.1, htailD, htailS, hup.2.2.2.1]
        have hbit := fullAdder_bit_value (s.basis (L.D j))
          (s.basis (L.S j)) (s.basis prev)
        omega
      · intro q hq
        rw [hSall] at hq
        simp only [List.mem_cons, not_or] at hq
        by_cases hqD : q = L.D j
        · subst q
          exact hdown.2.2.1
        by_cases hqC : q = L.C j
        · subst q
          rw [hdown.2.2.2.1]
          exact hcj.symm
        rw [hdown.2.2.2.2 q (by simp [hq.1, hqD, hqC])]
        rw [htail.2.2 q hq.2]
        apply hup.2.2.2.2 q
        simp [hq.1, hqD, hqC]

theorem railSegment_zero_eq_reg (f : Nat → Wire) (n : Nat) :
    railSegment f 0 n = reg f n := by
  simp only [railSegment, reg, List.range_eq_range']

theorem reg_succ_spec (f : Nat → Wire) (n : Nat) :
    reg f (n + 1) = reg f n ++ [f n] := by
  simp [reg, List.range_succ, List.map_append]

theorem regValue_snoc_spec (xs : List Wire) (q : Wire) (b : BasisState) :
    regValue (xs ++ [q]) b =
      regValue xs b + 2 ^ xs.length * (b q).toNat := by
  induction xs with
  | nil => cases h : b q <;> simp [regValue, h]
  | cons x xs ih =>
      rw [List.cons_append, regValue_cons_spec, regValue_cons_spec, ih]
      rw [List.length_cons, Nat.pow_succ]
      ring

theorem regValue_reg_succ (f : Nat → Wire) (n : Nat) (b : BasisState) :
    regValue (reg f (n + 1)) b =
      regValue (reg f n) b + 2 ^ n * (b (f n)).toNat := by
  rw [reg_succ_spec, regValue_snoc_spec]
  simp [reg]

theorem reg_mem_mono (f : Nat → Wire) (n m : Nat) {q : Wire}
    (hnm : n ≤ m) (hq : q ∈ reg f n) : q ∈ reg f m := by
  simp only [reg, List.mem_map, List.mem_range] at hq ⊢
  rcases hq with ⟨i, hi, rfl⟩
  exact ⟨i, by omega, rfl⟩

theorem regValue_bound_spec (qs : List Wire) (b : BasisState) :
    regValue qs b < 2 ^ qs.length := by
  induction qs with
  | nil => simp [regValue]
  | cons q qs ih =>
      rw [regValue_cons_spec, List.length_cons, Nat.pow_succ]
      cases hq : b q <;> simp <;> omega

theorem regValue_eq_of_bits (qs : List Wire) (b : BasisState) (x : Nat)
    (hx : x < 2 ^ qs.length)
    (hbits : ∀ i, i < qs.length → b (qs.getD i 0) = x.testBit i) :
    regValue qs b = x := by
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < qs.length
  · rw [← regValue_getD_testBit qs i 0 b hi]
    exact hbits i hi
  · have hpow : 2 ^ qs.length ≤ 2 ^ i :=
      Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (by omega)
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (regValue_bound_spec qs b) hpow),
      Nat.testBit_lt_two_pow (lt_of_lt_of_le hx hpow)]

theorem odd_half_testBit_spec (v i : Nat) (hv : v % 2 = 1) (hi : 0 < i) :
    ((v - 1) / 2).testBit (i - 1) = v.testBit i := by
  have hhalf : (v - 1) / 2 = v / 2 := by omega
  rw [hhalf, show i = (i - 1) + 1 by omega, Nat.testBit_succ]
  rfl

theorem unpackSweepSites_cases (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ unpackSweepSites L B) :
    q ∈ reg L.A (bitWidth B) ∨
      (∃ i, i < B - 1 ∧ q = L.D i) ∨
      (∃ i, i < B - 2 ∧ q = L.S (i + 1)) ∨
      q ∈ [L.z, L.t] ++ (lowDecoder L B).sites ++ (highDecoder L B).sites := by
  simp only [unpackSweepSites] at hq
  rcases List.mem_append.mp hq with hq | hhigh
  · rcases List.mem_append.mp hq with hq | hlow
    · rcases List.mem_append.mp hq with hq | hzt
      · rcases List.mem_append.mp hq with hq | hs
        · rcases List.mem_append.mp hq with hA | hD
          · exact Or.inl hA
          · simp only [reg, List.mem_map, List.mem_range] at hD
            rcases hD with ⟨i, hi, heq⟩
            exact Or.inr (Or.inl ⟨i, hi, heq.symm⟩)
        · simp only [List.mem_map, List.mem_range] at hs
          rcases hs with ⟨i, hi, heq⟩
          exact Or.inr (Or.inr (Or.inl ⟨i, hi, heq.symm⟩))
      · exact Or.inr (Or.inr (Or.inr (by
          simp only [List.mem_append]
          exact Or.inl (Or.inl hzt))))
    · exact Or.inr (Or.inr (Or.inr (by
        simp only [List.mem_append]
        exact Or.inl (Or.inr hlow))))
  · exact Or.inr (Or.inr (Or.inr (by
      simp only [List.mem_append]
      exact Or.inr hhigh)))

theorem unpackSweep_rest_mem_work (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ [L.z, L.t] ++ (lowDecoder L B).sites ++
      (highDecoder L B).sites) : q ∈ workSites L B := by
  simp only [workSites, List.mem_append] at hq ⊢
  tauto

theorem carry_not_unpackSweepSites (L : Layout) (B : Nat) (hn : L.Nodup B)
    {q : Wire} (hq : q ∈ reg L.C (B - 2)) :
    q ∉ unpackSweepSites L B := by
  intro ha
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_A_rest L B hn hA (by simp [hq])) rfl
  · rcases hD with ⟨i, hi, rfl⟩
    exact (sep_D_work L B hn (reg_mem L.D B i (by omega))
      (by simp [workSites, hq])) rfl
  · rcases hS with ⟨i, hi, rfl⟩
    exact (sep_S_rest L B hn (reg_mem L.S B (i + 1) (by omega))
      (by simp [workSites, hq])) rfl
  · exact (sep_C_rest L B hn hq hrest) rfl

theorem sign_not_unpackSweepSites (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.D (B - 1) ∉ unpackSweepSites L B := by
  intro ha
  have htop : L.D (B - 1) ∈ reg L.D B := reg_mem L.D B (B - 1) (by omega)
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_D_work L B hn htop (by simp [workSites, hA])) rfl
  · rcases hD with ⟨i, hi, heq⟩
    exact (reg_ne L.D B (B - 1) i (D_nodup L B hn) (by omega) (by omega)
      (by omega)) heq
  · rcases hS with ⟨i, hi, heq⟩
    exact (sep_S_rest L B hn (reg_mem L.S B (i + 1) (by omega))
      (by simp [htop])) heq.symm
  · exact (sep_D_work L B hn htop (unpackSweep_rest_mem_work L B hrest)) rfl

theorem sZero_not_unpackSweepSites (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.S 0 ∉ unpackSweepSites L B := by
  intro ha
  have hs0 : L.S 0 ∈ reg L.S B := reg_mem L.S B 0 (by omega)
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_S_rest L B hn hs0 (by simp [workSites, hA])) rfl
  · rcases hD with ⟨i, hi, heq⟩
    exact (sep_S_rest L B hn hs0
      (by simp [reg_mem L.D B i (by omega)])) heq
  · rcases hS with ⟨i, hi, heq⟩
    exact (reg_ne L.S B 0 (i + 1) (S_nodup L B hn) (by omega) (by omega)
      (by omega)) heq
  · exact (sep_S_rest L B hn hs0 (by
      exact List.mem_append_right (reg L.D B)
        (unpackSweep_rest_mem_work L B hrest))) rfl

theorem sTop_not_unpackSweepSites (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.S (B - 1) ∉ unpackSweepSites L B := by
  intro ha
  have hst : L.S (B - 1) ∈ reg L.S B := reg_mem L.S B (B - 1) (by omega)
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_S_rest L B hn hst (by simp [workSites, hA])) rfl
  · rcases hD with ⟨i, hi, heq⟩
    exact (sep_S_rest L B hn hst
      (by simp [reg_mem L.D B i (by omega)])) heq
  · rcases hS with ⟨i, hi, heq⟩
    exact (reg_ne L.S B (B - 1) (i + 1) (S_nodup L B hn) (by omega) (by omega)
      (by omega)) heq
  · exact (sep_S_rest L B hn hst (by
      exact List.mem_append_right (reg L.D B)
        (unpackSweep_rest_mem_work L B hrest))) rfl

theorem unpackSweepPrefix_frame (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (s : State) (m : List Bool) {q : Wire} (hq : q ∉ unpackSweepSites L B) :
    (run (unpackSweepPrefix L B) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro hw
  exact hq (List.mem_toFinset.mp (unpackSweepPrefix_support_active L B hB hw))

theorem unpackSweepPrefix_eq_spec (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    unpackSweepPrefix L B =
      ((lowDecoder L B).program ++ (highDecoder L B).program ++
        [.CCX (outAt (highDecoder L B) 0 L.z)
          (outAt (lowDecoder L B) 0 L.z) L.z]) ++
        unpackSweepProgram L B 0 (B - 1) := by
  rw [unpackSweepProgram_zero_eq L B hB]
  simp only [unpackSweepPrefix, List.append_assoc]

theorem compact_unpack_sweep_literal (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let out := run (unpackSweepPrefix L B) m s
    out.phase = s.phase ∧
    RealizesUnpackSweep L B
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) out.basis := by
  rw [unpackSweepPrefix_eq_spec L B hd.1]
  exact compact_unpack_sweep L B u v sigma hd hn s m hc


def unpackCleanup (L : Layout) (B : Nat) : Program :=
  [.X L.z] ++ decoderInit (lowDecoder L B) (lowBits L B) ++
    decoderInit (highDecoder L B) (highBits L B) ++ [.X (L.S 0)]

theorem unpackCleanup_run (L : Layout) (B : Nat) (s : State) (m : List Bool) :
    run (unpackCleanup L B) m s =
      run [.X (L.S 0)] m
        (run (decoderInit (highDecoder L B) (highBits L B)) m
          (run (decoderInit (lowDecoder L B) (lowBits L B)) m
            (run [.X L.z] m s))) := by
  have hlo := (decoderInit_counts (lowDecoder L B) (lowBits L B)).2
  have hhi := (decoderInit_counts (highDecoder L B) (highBits L B)).2
  have hz0 : measurementCount ([.X L.z] : Program) = 0 := rfl
  have hz01 : measurementCount
      (([.X L.z] : Program) ++ decoderInit (lowDecoder L B) (lowBits L B)) = 0 := by
    rw [measurementCount_append, hz0, hlo]
  have hz012 : measurementCount
      (([.X L.z] : Program) ++ decoderInit (lowDecoder L B) (lowBits L B) ++
        decoderInit (highDecoder L B) (highBits L B)) = 0 := by
    rw [measurementCount_append, hz01, hhi]
  simp only [unpackCleanup]
  rw [run_append_zero_left_spec _ _ hz012,
    run_append_zero_left_spec _ _ hz01,
    run_append_zero_left_spec _ _ hz0]

theorem unpackCleanup_adder_input (L : Layout) (B w v : Nat) (sigma : Bool)
    (hB : 3 ≤ B) (hn : L.Nodup B) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis)
    (hfull : st.a = 0 ∧ st.z = true ∧
      (∀ i, i < B - 1 → st.d i = w.testBit i) ∧
      (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i))
    (hw : w < 2 ^ (B - 1)) (hv : v % 2 = 1) (hvtop : v < 2 ^ (B - 1))
    (hC : ∀ q ∈ reg L.C (B - 2), s.basis q = false)
    (hSig : s.basis (L.D (B - 1)) = sigma)
    (hS0 : s.basis (L.S 0) = false)
    (hStop : s.basis (L.S (B - 1)) = false) :
    let out := run (unpackCleanup L B) m s
    out.phase = s.phase ∧
    regValue (reg L.D (B - 1)) out.basis = w ∧
    regValue (reg L.S B) out.basis = v ∧
    out.basis (L.S (B - 1)) = false ∧
    out.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), out.basis q = false) ∧
    cleanOn (workSites L B) out.basis := by
  let zed := run [.X L.z] m s
  let lowOut := run (decoderInit (lowDecoder L B) (lowBits L B)) m zed
  let highOut := run (decoderInit (highDecoder L B) (highBits L B)) m lowOut
  let out := run [.X (L.S 0)] m highOut
  have hzPhase : zed.phase = s.phase := by simp [zed, run]
  have hzFrame : ∀ q, q ≠ L.z → zed.basis q = s.basis q := by
    intro q hq
    simp [zed, run, writeBit, Function.update, hq]
  have hzValue : zed.basis L.z = false := by
    simp [zed, run, writeBit, Function.update, hr.2.1, hfull.2.1]
  have hlowCurrent : ∀ q ∈ (lowDecoder L B).sites,
      zed.basis q = decoderBasis (lowDecoder L B) (lowBits L B) 0 q := by
    intro q hq
    have hqz : q ≠ L.z := by
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left _ hq)).symm
    rw [hzFrame q hqz, hr.2.2.2.2.2.1 q hq, hfull.1]
    simp
  have hlowN : (lowDecoder L B).sites.Nodup :=
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1
  have hlo := decoderInit_clear_full (lowDecoder L B) (lowBits L B) hlowN
    zed m hlowCurrent
  change lowOut.phase = zed.phase ∧
      (∀ q ∈ (lowDecoder L B).sites, lowOut.basis q = false) ∧
      (∀ q ∉ (lowDecoder L B).sites, lowOut.basis q = zed.basis q) at hlo
  have hhighCurrent : ∀ q ∈ (highDecoder L B).sites,
      lowOut.basis q = decoderBasis (highDecoder L B) (highBits L B) 0 q := by
    intro q hq
    have hqz : q ≠ L.z := by
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq)).symm
    have hqlow : q ∉ (lowDecoder L B).sites := by
      intro hm
      exact (sep_low_high L B hn hm hq) rfl
    rw [hlo.2.2 q hqlow, hzFrame q hqz, hr.2.2.2.2.2.2 q hq, hfull.1]
    simp
  have hhighN : (highDecoder L B).sites.Nodup :=
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1
  have hhi := decoderInit_clear_full (highDecoder L B) (highBits L B) hhighN
    lowOut m hhighCurrent
  change highOut.phase = lowOut.phase ∧
      (∀ q ∈ (highDecoder L B).sites, highOut.basis q = false) ∧
      (∀ q ∉ (highDecoder L B).sites, highOut.basis q = lowOut.basis q) at hhi
  have houtPhase : out.phase = s.phase := by
    simp [out, run, hhi.1, hlo.1, hzPhase]
  have houtFrame : ∀ q, q ≠ L.z → q ∉ (lowDecoder L B).sites →
      q ∉ (highDecoder L B).sites → q ≠ L.S 0 → out.basis q = s.basis q := by
    intro q hqz hql hqh hqs
    have hlast : out.basis q = highOut.basis q := by
      simp [out, run, writeBit, Function.update, hqs]
    exact hlast.trans ((hhi.2.2 q hqh).trans ((hlo.2.2 q hql).trans
      (hzFrame q hqz)))
  have houtD : regValue (reg L.D (B - 1)) out.basis = w := by
    apply regValue_eq_of_bits _ _ w
    · simpa [reg] using hw
    · intro i hi
      have hi' : i < B - 1 := by simpa [reg] using hi
      have hwire : (reg L.D (B - 1)).getD i 0 = L.D i := by
        rw [List.getD_eq_getElem _ _ hi]
        simp [reg]
      rw [hwire, houtFrame]
      · exact (hr.2.2.2.1 i hi').trans (hfull.2.2.1 i hi')
      · exact sep_D_work L B hn (reg_mem L.D B i (by omega)) (by simp [workSites])
      · intro hq
        exact (sep_D_work L B hn (reg_mem L.D B i (by omega))
          (by simp [workSites, hq])) rfl
      · intro hq
        exact (sep_D_work L B hn (reg_mem L.D B i (by omega))
          (by simp [workSites, hq])) rfl
      · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
          (by simp [reg_mem L.D B i (by omega)])).symm
  have hpreS0 : highOut.basis (L.S 0) = false := by
    have hsLow : L.S 0 ∉ (lowDecoder L B).sites := by
      intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])) rfl
    have hsHigh : L.S 0 ∉ (highDecoder L B).sites := by
      intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])) rfl
    have hsz : L.S 0 ≠ L.z :=
      sep_S_rest L B hn (reg_mem L.S B 0 (by omega)) (by simp [workSites])
    exact (hhi.2.2 (L.S 0) hsHigh).trans
      ((hlo.2.2 (L.S 0) hsLow).trans ((hzFrame (L.S 0) hsz).trans hS0))
  have houtS : regValue (reg L.S B) out.basis = v := by
    apply regValue_eq_of_bits _ _ v
    · have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat))
          (show B - 1 ≤ B by omega)
      simpa [reg] using lt_of_lt_of_le hvtop hp
    · intro i hi
      have hi' : i < B := by simpa [reg] using hi
      have hwire : (reg L.S B).getD i 0 = L.S i := by
        rw [List.getD_eq_getElem _ _ hi]
        simp [reg]
      rw [hwire]
      by_cases hi0 : i = 0
      · subst i
        have hvbit : v.testBit 0 = true := by simp [Nat.testBit_zero, hv]
        simp [out, run, writeBit, Function.update, hpreS0, hvbit]
      · by_cases hitop : i = B - 1
        · subst i
          rw [houtFrame]
          · exact hStop.trans (Nat.testBit_lt_two_pow hvtop).symm
          · exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
              (by simp [workSites])
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
              (by simp [workSites, hq])) rfl
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
              (by simp [workSites, hq])) rfl
          · exact reg_ne L.S B (B - 1) 0 (S_nodup L B hn) (by omega)
              (by omega) (by omega)
        · have himid : 0 < i ∧ i < B - 1 := by omega
          rw [houtFrame]
          · have hk : B - 2 - i < B - 2 := by omega
            have hs := hr.2.2.2.2.1 (B - 2 - i) hk
            have hindex : B - 2 - (B - 2 - i) = i := by omega
            rw [hindex] at hs
            have hst := hfull.2.2.2 (B - 2 - i) hk
            rw [hindex] at hst
            rw [hs, hst, halfBit]
            have hbitIndex : B - 3 - (B - 2 - i) = i - 1 := by omega
            rw [hbitIndex]
            exact odd_half_testBit_spec v i hv himid.1
          · exact sep_S_rest L B hn (reg_mem L.S B i hi') (by simp [workSites])
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B i hi')
              (by simp [workSites, hq])) rfl
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B i hi')
              (by simp [workSites, hq])) rfl
          · exact reg_ne L.S B i 0 (S_nodup L B hn) hi' (by omega) hi0
  have houtStop : out.basis (L.S (B - 1)) = false := by
    rw [houtFrame]
    · exact hStop
    · exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites])
    · intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · exact reg_ne L.S B (B - 1) 0 (S_nodup L B hn) (by omega) (by omega)
        (by omega)
  have houtSig : out.basis (L.D (B - 1)) = sigma := by
    rw [houtFrame]
    · exact hSig
    · exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites])
    · intro hq
      exact (sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · intro hq
      exact (sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [reg_mem L.D B (B - 1) (by omega)])).symm
  have houtC : ∀ q ∈ reg L.C (B - 2), out.basis q = false := by
    intro q hq
    rw [houtFrame]
    · exact hC q hq
    · exact sep_C_rest L B hn hq (by simp)
    · intro hm
      exact (sep_C_rest L B hn hq (by
        exact List.mem_append_right [L.z, L.t]
          (List.mem_append_left _ hm))) rfl
    · intro hm
      exact (sep_C_rest L B hn hq (by
        exact List.mem_append_right [L.z, L.t]
          (List.mem_append_right _ hm))) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
  have houtA : ∀ q ∈ reg L.A (bitWidth B), out.basis q = false := by
    have hzero := (regValue_zero (reg L.A (bitWidth B)) s.basis).mp
      (hr.1.trans hfull.1)
    intro q hq
    rw [houtFrame]
    · exact hzero q hq
    · exact sep_A_rest L B hn hq (by simp)
    · intro hm
      exact (sep_A_rest L B hn hq (by
        simp only [List.mem_append]
        exact Or.inl (Or.inr hm))) rfl
    · intro hm
      exact (sep_A_rest L B hn hq (by
        simp only [List.mem_append]
        exact Or.inr hm)) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
  have houtZ : out.basis L.z = false := by
    have hzS : L.z ≠ L.S 0 := by
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites])).symm
    have hzLow : L.z ∉ (lowDecoder L B).sites := by
      intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left _ hm)) rfl
    have hzHigh : L.z ∉ (highDecoder L B).sites := by
      intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right _ hm)) rfl
    have hlast : out.basis L.z = highOut.basis L.z := by
      simp [out, run, writeBit, Function.update, hzS]
    exact hlast.trans ((hhi.2.2 L.z hzHigh).trans
      ((hlo.2.2 L.z hzLow).trans hzValue))
  have houtT : out.basis L.t = false := by
    rw [houtFrame]
    · exact hr.2.2.1
    · exact (sep_z_t L B hn).symm
    · intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left _ hm)) rfl
    · intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right _ hm)) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites])).symm
  have houtLow : ∀ q ∈ (lowDecoder L B).sites, out.basis q = false := by
    intro q hq
    have hqHigh : q ∉ (highDecoder L B).sites := by
      intro hm
      exact (sep_low_high L B hn hq hm) rfl
    have hqS : q ≠ L.S 0 := by
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
    have hlast : out.basis q = highOut.basis q := by
      simp [out, run, writeBit, Function.update, hqS]
    exact hlast.trans ((hhi.2.2 q hqHigh).trans (hlo.2.1 q hq))
  have houtHigh : ∀ q ∈ (highDecoder L B).sites, out.basis q = false := by
    intro q hq
    have hqS : q ≠ L.S 0 := by
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
    have hlast : out.basis q = highOut.basis q := by
      simp [out, run, writeBit, Function.update, hqS]
    exact hlast.trans (hhi.2.1 q hq)
  have houtWork : cleanOn (workSites L B) out.basis := by
    intro q hq
    simp only [workSites] at hq
    rcases List.mem_append.mp hq with hq | hhigh
    · rcases List.mem_append.mp hq with hq | hlow
      · rcases List.mem_append.mp hq with hq | hzt
        · rcases List.mem_append.mp hq with hA | hCq
          · exact houtA q hA
          · exact houtC q hCq
        · simp only [List.mem_cons, List.not_mem_nil, or_false] at hzt
          rcases hzt with rfl | rfl
          · exact houtZ
          · exact houtT
      · exact houtLow q hlow
    · exact houtHigh q hhigh
  rw [unpackCleanup_run]
  exact ⟨houtPhase, houtD, houtS, houtStop, houtSig, houtC, houtWork⟩

theorem compact_unpack_cleanup (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (mp mc : List Bool) (hc : CompactCode L B u v sigma s.basis) :
    let prefixOut := run (unpackSweepPrefix L B) mp s
    let out := run (unpackCleanup L B) mc prefixOut
    out.phase = s.phase ∧
    regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
    regValue (reg L.S B) out.basis = v ∧
    out.basis (L.S (B - 1)) = false ∧
    out.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), out.basis q = false) ∧
    cleanOn (workSites L B) out.basis := by
  let st := unpackSweepRun B 0 (B - 1)
    (initialUnpackSweepState B (u - sigma.toNat) v)
  let prefixOut := run (unpackSweepPrefix L B) mp s
  let out := run (unpackCleanup L B) mc prefixOut
  have hp := compact_unpack_sweep_literal L B u v sigma hd hn s mp hc
  change prefixOut.phase = s.phase ∧ RealizesUnpackSweep L B st prefixOut.basis at hp
  have hvals := unpackSweep_full_values B u v sigma hd
  change st.a = 0 ∧ st.z = true ∧
    (∀ i, i < B - 1 → st.d i = (u - sigma.toNat).testBit i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i) at hvals
  have hc' := hc
  change regValue (reg L.A (bitWidth B)) s.basis = natBitLength (u - sigma.toNat) ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc'
  have hSZero : ∀ q ∈ reg L.S B, s.basis q = false :=
    (regValue_zero (reg L.S B) s.basis).mp hc'.2.2.2.2.1
  have hpC : ∀ q ∈ reg L.C (B - 2), prefixOut.basis q = false := by
    intro q hq
    rw [unpackSweepPrefix_frame L B hd.1 s mp (carry_not_unpackSweepSites L B hn hq)]
    exact hc'.2.2.2.2.2 q (by simp [hq])
  have hpSig : prefixOut.basis (L.D (B - 1)) = sigma := by
    rw [unpackSweepPrefix_frame L B hd.1 s mp
      (sign_not_unpackSweepSites L B hd.1 hn)]
    exact hc'.2.2.2.1
  have hpS0 : prefixOut.basis (L.S 0) = false := by
    rw [unpackSweepPrefix_frame L B hd.1 s mp
      (sZero_not_unpackSweepSites L B hd.1 hn)]
    exact hSZero _ (reg_mem L.S B 0 (by have := hd.1; omega))
  have hpStop : prefixOut.basis (L.S (B - 1)) = false := by
    rw [unpackSweepPrefix_frame L B hd.1 s mp
      (sTop_not_unpackSweepSites L B hd.1 hn)]
    exact hSZero _ (reg_mem L.S B (B - 1) (by have := hd.1; omega))
  have hclean := unpackCleanup_adder_input L B (u - sigma.toNat) v sigma hd.1 hn
    st prefixOut mc hp.2 hvals (domain_w_lt_top B u v sigma hd) hd.2.2.1
    (domain_v_lt_top B u v sigma hd) hpC hpSig hpS0 hpStop
  change out.phase = prefixOut.phase ∧
    regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
    regValue (reg L.S B) out.basis = v ∧
    out.basis (L.S (B - 1)) = false ∧
    out.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), out.basis q = false) ∧
    cleanOn (workSites L B) out.basis at hclean
  exact ⟨hclean.1.trans hp.1, hclean.2⟩

/-- Concrete semantic interface of the literal shortened unpack adder.  The
low D word and the incoming S word are added without overflow into S; all
other wires, including D and the carry bank, are restored exactly. -/
theorem unpackAdder_correct (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) (s : State) (m : List Bool) (w v : Nat) (sigma : Bool)
    (hD : regValue (reg L.D (B - 1)) s.basis = w)
    (hS : regValue (reg L.S B) s.basis = v)
    (hStop : s.basis (L.S (B - 1)) = false)
    (hSig : s.basis (L.D (B - 1)) = sigma)
    (hclean : ∀ q ∈ reg L.C (B - 2), s.basis q = false) :
    let out := run (unpackAdder L B) m s
    out.phase = s.phase ∧
    regValue (reg L.S B) out.basis = w + v + sigma.toNat ∧
    (∀ q, q ∉ reg L.S B → out.basis q = s.basis q) := by
  have hBm1 : B = (B - 1) + 1 := by omega
  have hBm2 : B - 1 = (B - 2) + 1 := by omega
  have hDfull : reg L.D B = reg L.D (B - 1) ++ [L.D (B - 1)] := by
    conv_lhs => rw [hBm1, reg_succ_spec]
  have hcontractN : (L.D (B - 1) :: reg L.D (B - 1) ++
      reg L.S B ++ reg L.C (B - 2)).Nodup := by
    apply nodup_of_subcount (declaredSites L B)
    · exact hn
    · intro q
      simp only [declaredSites, hDfull, workSites, List.count_cons,
        List.count_append, List.count_nil]
      omega
  have hcontractN' : (L.D (B - 1) :: railSegment L.D 0 (B - 2 + 1) ++
      railSegment L.S 0 (B - 2 + 2) ++ railSegment L.C 0 (B - 2)).Nodup := by
    have hlen1 : B - 2 + 1 = B - 1 := by omega
    have hlen2 : B - 2 + 2 = B := by omega
    simpa [railSegment_zero_eq_reg, hlen1, hlen2] using hcontractN
  have htopIndex : 0 + (B - 2) + 1 = B - 1 := by omega
  have hl := unpackAdderLadder_correct L (B - 2) 0 (L.D (B - 1)) s m
    hcontractN'
    (by simpa [railSegment_zero_eq_reg] using hclean)
    (by rw [htopIndex]; exact hStop)
  have heq := unpackAdder_eq_ladder L B hB
  rw [heq]
  change (run (unpackAdderLadder L (B - 2) 0 (L.D (B - 1))) m s).phase =
      s.phase ∧
    regValue (reg L.S B)
      (run (unpackAdderLadder L (B - 2) 0 (L.D (B - 1))) m s).basis =
      w + v + sigma.toNat ∧
    (∀ q, q ∉ reg L.S B →
      (run (unpackAdderLadder L (B - 2) 0 (L.D (B - 1))) m s).basis q =
        s.basis q)
  have hSlow : regValue (reg L.S (B - 1)) s.basis = v := by
    rw [hBm1, regValue_reg_succ, hStop, Bool.toNat_false, Nat.mul_zero,
      Nat.add_zero] at hS
    exact hS
  have hlength1 : B - 2 + 1 = B - 1 := by omega
  have hlength2 : B - 2 + 2 = B := by omega
  simpa [railSegment_zero_eq_reg, hlength1, hlength2, hD, hSlow, hSig] using hl

theorem compact_unpack_finish_staged (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (mp mc ma mx : List Bool) (hc : CompactCode L B u v sigma s.basis) :
    let prefixOut := run (unpackSweepPrefix L B) mp s
    let clean := run (unpackCleanup L B) mc prefixOut
    let added := run (unpackAdder L B) ma clean
    let out := run (cxInto (L.D (B - 1)) (reg L.D (B - 1))) mx added
    out.phase = s.phase ∧ CodecInput L B u v sigma out.basis := by
  let prefixOut := run (unpackSweepPrefix L B) mp s
  let clean := run (unpackCleanup L B) mc prefixOut
  let added := run (unpackAdder L B) ma clean
  let out := run (cxInto (L.D (B - 1)) (reg L.D (B - 1))) mx added
  change out.phase = s.phase ∧ CodecInput L B u v sigma out.basis
  have hcl := compact_unpack_cleanup L B u v sigma hd hn s mp mc hc
  change clean.phase = s.phase ∧
    regValue (reg L.D (B - 1)) clean.basis = u - sigma.toNat ∧
    regValue (reg L.S B) clean.basis = v ∧
    clean.basis (L.S (B - 1)) = false ∧
    clean.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), clean.basis q = false) ∧
    cleanOn (workSites L B) clean.basis at hcl
  have hadd := unpackAdder_correct L B hd.1 hn clean ma (u - sigma.toNat) v sigma
    hcl.2.1 hcl.2.2.1 hcl.2.2.2.1 hcl.2.2.2.2.1 hcl.2.2.2.2.2.1
  change added.phase = clean.phase ∧
    regValue (reg L.S B) added.basis =
      u - sigma.toNat + v + sigma.toNat ∧
    (∀ q, q ∉ reg L.S B → added.basis q = clean.basis q) at hadd
  have hsum : regValue (reg L.S B) added.basis = u + v := by
    rw [hadd.2.1]
    have hu := domain_sub_sigma_add B u v sigma hd
    omega
  have hDlowAdded : regValue (reg L.D (B - 1)) added.basis = u - sigma.toNat := by
    refine (regValue_congr _ _ _ ?_).trans hcl.2.1
    intro q hq
    apply hadd.2.2 q
    intro hs
    exact (sep_S_rest L B hn hs (by
      exact List.mem_append_left (workSites L B)
        (reg_mem_mono L.D (B - 1) B (by omega) hq))) rfl
  have hSigAdded : added.basis (L.D (B - 1)) = sigma := by
    rw [hadd.2.2]
    · exact hcl.2.2.2.2.1
    · intro hs
      exact (sep_S_rest L B hn hs (by
        exact List.mem_append_left (workSites L B)
          (reg_mem L.D B (B - 1) (by have := hd.1; omega)))) rfl
  have hWorkAdded : cleanOn (workSites L B) added.basis := by
    intro q hq
    rw [hadd.2.2]
    · exact hcl.2.2.2.2.2.2 q hq
    · intro hs
      exact (sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq)) rfl
  have hDlowN : (reg L.D (B - 1)).Nodup := by
    have hshape : reg L.D B = reg L.D (B - 1) ++ [L.D (B - 1)] := by
      conv_lhs => rw [show B = (B - 1) + 1 by have := hd.1; omega,
        reg_succ_spec]
    have hfull := D_nodup L B hn
    rw [hshape] at hfull
    exact (List.nodup_append.mp hfull).1
  have hSigNotLow : L.D (B - 1) ∉ reg L.D (B - 1) := by
    intro hq
    simp only [reg, List.mem_map, List.mem_range] at hq
    rcases hq with ⟨i, hi, heq⟩
    exact (reg_ne L.D B (B - 1) i (D_nodup L B hn)
      (by have := hd.1; omega) (by omega) (by omega)) heq.symm
  have hcx := cxInto_run (L.D (B - 1)) (reg L.D (B - 1)) hDlowN hSigNotLow
    added mx
  change out = ⟨added.phase, fun q =>
    if added.basis (L.D (B - 1)) && decide (q ∈ reg L.D (B - 1))
    then !added.basis q else added.basis q⟩ at hcx
  have hcxPhase : out.phase = added.phase := by rw [hcx]
  have hcxFrame : ∀ q, q ∉ reg L.D (B - 1) → out.basis q = added.basis q := by
    intro q hq
    rw [hcx]
    simp [hq]
  have hSOut : regValue (reg L.S B) out.basis = u + v := by
    refine (regValue_congr _ _ _ ?_).trans hsum
    intro q hq
    apply hcxFrame q
    intro hdq
    exact (sep_S_rest L B hn hq (by
      exact List.mem_append_left (workSites L B)
        (reg_mem_mono L.D (B - 1) B (by omega) hdq))) rfl
  have hWorkOut : cleanOn (workSites L B) out.basis := by
    intro q hq
    rw [hcxFrame]
    · exact hWorkAdded q hq
    · intro hdq
      have hdFull : q ∈ reg L.D B := by
        simp only [reg, List.mem_map, List.mem_range] at hdq ⊢
        rcases hdq with ⟨i, hi, rfl⟩
        exact ⟨i, by omega, rfl⟩
      exact (sep_D_work L B hn hdFull hq) rfl
  have hDOut : regValue (reg L.D B) out.basis = signedWord B u sigma := by
    have hBshape : B = (B - 1) + 1 := by have := hd.1; omega
    have hpow : 2 ^ B = 2 * 2 ^ (B - 1) := by
      calc
        2 ^ B = 2 ^ ((B - 1) + 1) := congrArg (fun n => 2 ^ n) hBshape
        _ = 2 * 2 ^ (B - 1) := by rw [Nat.pow_succ]; ring
    cases sigma with
    | false =>
        have hlow : regValue (reg L.D (B - 1)) out.basis = u := by
          refine (regValue_congr (reg L.D (B - 1)) out.basis added.basis ?_).trans ?_
          · intro q hq
            rw [hcx]
            simp [hSigAdded]
          · simpa using hDlowAdded
        have htop : out.basis (L.D (B - 1)) = false := by
          rw [hcxFrame _ hSigNotLow, hSigAdded]
        have huB : u < 2 ^ B := lt_of_le_of_lt (Nat.le_add_right u v) hd.2.2.2.1
        calc
          regValue (reg L.D B) out.basis =
              regValue (reg L.D (B - 1)) out.basis +
                2 ^ (B - 1) * (out.basis (L.D (B - 1))).toNat := by
            conv_lhs => rw [hBshape, regValue_reg_succ]
          _ = u := by rw [hlow, htop]; simp
          _ = signedWord B u false := by
            simp [signedWord, Nat.mod_eq_of_lt huB]
    | true =>
        have hlow : regValue (reg L.D (B - 1)) out.basis =
            2 ^ (B - 1) - 1 - (u - 1) := by
          rw [regValue_congr (reg L.D (B - 1)) out.basis
            (fun q => !added.basis q) (by
              intro q hq
              rw [hcx]
              simp [hSigAdded, hq]), regValue_complement, hDlowAdded]
          simp [reg]
        have htop : out.basis (L.D (B - 1)) = true := by
          rw [hcxFrame _ hSigNotLow, hSigAdded]
        have hu0 : 0 < u := by
          by_contra hz
          have hz' : u = 0 := by omega
          have hs := (hd.2.2.2.2.2 hz').2
          contradiction
        have huB : u < 2 ^ B := lt_of_le_of_lt (Nat.le_add_right u v) hd.2.2.2.1
        have hsub : 2 ^ B - u < 2 ^ B := by omega
        have hw := domain_w_lt_top B u v true hd
        simp only [Bool.toNat_true] at hw
        calc
          regValue (reg L.D B) out.basis =
              regValue (reg L.D (B - 1)) out.basis +
                2 ^ (B - 1) * (out.basis (L.D (B - 1))).toNat := by
            conv_lhs => rw [hBshape, regValue_reg_succ]
          _ = (2 ^ (B - 1) - 1 - (u - 1)) + 2 ^ (B - 1) := by
            rw [hlow, htop]
            simp
          _ = 2 ^ B - u := by
            rw [hpow]
            have hcut : 2 ^ (B - 1) - 1 - (u - 1) = 2 ^ (B - 1) - u := by
              omega
            have hule : u ≤ 2 ^ (B - 1) := by omega
            rw [hcut]
            omega
          _ = signedWord B u true := by
            simp [signedWord, Nat.mod_eq_of_lt hsub]
  exact ⟨hcxPhase.trans (hadd.1.trans hcl.1), hSOut, hDOut, hWorkOut⟩

theorem unpack_eq_stages (L : Layout) (B : Nat) :
    unpack L B = unpackSweepPrefix L B ++
      (unpackCleanup L B ++
        (unpackAdder L B ++ cxInto (L.D (B - 1)) (reg L.D (B - 1)))) := by
  simp [unpack, unpackSweepPrefix, unpackCleanup, List.append_assoc]

/-- Exact semantic direction of the literal generated inverse codec, for every
measurement tape. -/
theorem unpack_spec (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    (run (unpack L B) m s).phase = s.phase ∧
    CodecInput L B u v sigma (run (unpack L B) m s).basis := by
  let P := unpackSweepPrefix L B
  let C := unpackCleanup L B
  let A := unpackAdder L B
  let X := cxInto (L.D (B - 1)) (reg L.D (B - 1))
  let mp := m.take (measurementCount P)
  let m1 := m.drop (measurementCount P)
  let mc := m1.take (measurementCount C)
  let m2 := m1.drop (measurementCount C)
  let ma := m2.take (measurementCount A)
  let mx := m2.drop (measurementCount A)
  have hs := compact_unpack_finish_staged L B u v sigma hd hn s mp mc ma mx hc
  rw [unpack_eq_stages]
  change (run (P ++ (C ++ (A ++ X))) m s).phase = s.phase ∧
    CodecInput L B u v sigma (run (P ++ (C ++ (A ++ X))) m s).basis
  simp only [run_append]
  simpa only [P, C, A, X, mp, m1, mc, m2, ma, mx] using hs


/-- Exact handoff to the forward-codec proof: a pack theorem of the shape
proved by the companion module, together with the completed inverse theorem,
closes the public `FunctionalSpec`. -/
theorem functionalSpec_of_pack (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B)
    (hpack : ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
      ∀ s m, CodecInput L B u v sigma s.basis →
        (run (pack L B) m s).phase = s.phase ∧
        CompactCode L B u v sigma (run (pack L B) m s).basis) :
    FunctionalSpec L B := by
  refine ⟨pack_physical L B hB hn, unpack_physical L B hB hn, ?_⟩
  intro u v sigma hd hn'
  exact ⟨hpack u v sigma hd hn', unpack_spec L B u v sigma hd hn'⟩

end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecSpec_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBridgeSign_at_StairSideA` -/
section Merge_StairBridgeSign_at_StairSideA

/-!
# Signed codec-to-walk rail extension

The compact codec stores two `B`-bit rails.  A compact Skywalk tick consumes
signed `(B+1)`-bit rails.  The sum rail has a clean zero extension; the signed
difference rail needs one physical CX from its retained sign bit.  The same CX
clears that extension before packing in the opposite direction.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairBridgeSign

open ECDSAAdd Arithmetic RecordedQuantum


theorem signExtend_counts (sign extension : Wire) :
    toffoliCount (signExtend sign extension) = 0 ∧
      measurementCount (signExtend sign extension) = 0 := by
  exact ⟨rfl, rfl⟩







end ECDSAAdd.Entrant.StairBridgeSign
end Merge_StairBridgeSign_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecPackA_at_StairSideA` -/
section Merge_StairCodecPackA_at_StairSideA

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec.PackA

open ECDSAAdd Arithmetic
open Arithmetic.RecordedRailCarry Arithmetic.RecordedRailRipple

/-! Run-level correctness of the forward checkpoint codec.  The first part
exposes the private known-top ripple ladder through a public, structurally
identical program and proves its exact frame. -/







def packUpA (source target prev carry : Wire) : Program :=
  [.CX prev target, .CX prev source, .CCX target source carry, .CX prev carry]

def packDownA (source target prev carry : Wire) : Program :=
  [.CX prev carry, .measureX carry [] [.CZ target source],
   .CX prev source, .CX source target]

def packTopA (source target prev top : Wire) : Program :=
  [.CX prev target, .CX prev source,
   .X top, .measureX top [] [.Z prev, .CZ target source], .X top,
   .CX prev source, .CX source target]

def knownTopAdderA : List Wire → List Wire → Wire → List Wire → Wire → Program
  | [source], [target], prev, [], top => packTopA source target prev top
  | source :: source' :: sources, target :: target' :: targets,
      prev, carry :: carries, top =>
      packUpA source target prev carry ++
      knownTopAdderA (source' :: sources) (target' :: targets)
        carry carries top ++
      packDownA source target prev carry
  | _, _, _, _, _ => []


theorem packTopA_wide_frame (source target prev top : Wire)
    (hn : [prev, source, target, top].Nodup) (s : State) (m : List Bool)
    (hlow : 2 ^ ([target] : List Wire).length ≤
      regValue [target, top] s.basis + regValue [source] s.basis +
        (s.basis prev).toNat)
    (hhigh : regValue [target, top] s.basis + regValue [source] s.basis +
        (s.basis prev).toNat < 2 ^ (([target] : List Wire).length + 1)) :
    let out := run (packTopA source target prev top) m s
    out.phase = s.phase ∧
    regValue [target, top] out.basis =
      regValue [target, top] s.basis + regValue [source] s.basis +
        (s.basis prev).toNat ∧
    (∀ q, q ∉ ([target, top] : List Wire) → out.basis q = s.basis q) := by
  dsimp only
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil,
    List.nodup_nil, not_or, not_false_eq_true, and_true] at hn
  rcases hn with ⟨⟨hps, hpt, hpo⟩, ⟨hst, hso⟩, hto⟩
  have hsp := Ne.symm hps
  have htp := Ne.symm hpt
  have hop := Ne.symm hpo
  have hts := Ne.symm hst
  have hos := Ne.symm hso
  have hot := Ne.symm hto
  cases hs : s.basis source <;> cases ht : s.basis target <;>
    cases hp : s.basis prev <;> cases ho : s.basis top <;>
    cases hm : m.headD false <;>
    simp_all [packTopA, run, measureAndCorrect, ECDSAAdd.correct,
      regValue, writeBit, Function.update]
  all_goals intro q hq
  all_goals
    have hqt : q ≠ target := by intro h; exact hq (by simp [h])
    by_cases hqo : q = top <;> by_cases hqs : q = source <;>
      by_cases hqp : q = prev <;>
      simp_all [packTopA, run, measureAndCorrect, ECDSAAdd.correct,
        regValue, writeBit, Function.update]

theorem packUpA_run_eq (source target prev carry : Wire)
    (hn : [source, target, prev, carry].Nodup) (s : State) (m : List Bool) :
    run (packUpA source target prev carry) m s =
      run (carryStep source target (some prev) carry) m s := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  rcases hn with ⟨⟨hst, hsp, hsc⟩, ⟨htp, htc⟩, hpc⟩
  have hts := Ne.symm hst
  have hps := Ne.symm hsp
  have hcs := Ne.symm hsc
  have hpt := Ne.symm htp
  have hct := Ne.symm htc
  have hcp := Ne.symm hpc
  apply State.extensionality
  · rfl
  · funext q
    by_cases hqs : q = source <;> by_cases hqt : q = target <;>
      by_cases hqp : q = prev <;> by_cases hqc : q = carry <;>
      simp_all [packUpA, carryStep, run, writeBit, Function.update,
        Bool.and_comm]

theorem packDownA_run_eq (source target prev carry : Wire)
    (hn : [source, target, prev, carry].Nodup) (s : State) (m : List Bool) :
    run (packDownA source target prev carry) m s =
      run (unwindStep source target (some prev) carry) m s := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  rcases hn with ⟨⟨hst, hsp, hsc⟩, ⟨htp, htc⟩, hpc⟩
  have hts := Ne.symm hst
  have hps := Ne.symm hsp
  have hcs := Ne.symm hsc
  have hpt := Ne.symm htp
  have hct := Ne.symm htc
  have hcp := Ne.symm hpc
  apply State.extensionality
  · cases hs : s.basis source <;> cases ht : s.basis target <;>
      cases hp : s.basis prev <;> cases hc : s.basis carry <;>
      cases hm : m.headD false <;> cases hphase : s.phase <;>
      simp_all [packDownA, unwindStep, run, measureAndCorrect,
        ECDSAAdd.correct, writeBit, Function.update]
  · funext q
    by_cases hqs : q = source <;> by_cases hqt : q = target <;>
      by_cases hqp : q = prev <;> by_cases hqc : q = carry <;>
      cases hm : m.headD false <;>
      simp_all [packDownA, unwindStep, run, measureAndCorrect,
        ECDSAAdd.correct, writeBit, Function.update]


theorem knownTopAdderA_wide_frame (source target work : List Wire)
    (shape : Arithmetic.RecordedRailVented.Shape source target work)
    (prev top : Wire) (s : State) (m : List Bool)
    (hn : ([prev] ++ source ++ target ++ work ++ [top]).Nodup)
    (hclean : ∀ q ∈ work, s.basis q = false)
    (hlow : 2 ^ target.length ≤
      regValue (target ++ [top]) s.basis + regValue source s.basis +
        (s.basis prev).toNat)
    (hhigh : regValue (target ++ [top]) s.basis + regValue source s.basis +
        (s.basis prev).toNat < 2 ^ (target.length + 1)) :
    let out := run (knownTopAdderA source target prev work top) m s
    out.phase = s.phase ∧
    regValue (target ++ [top]) out.basis =
      regValue (target ++ [top]) s.basis + regValue source s.basis +
        (s.basis prev).toNat ∧
    (∀ q, q ∉ target ++ [top] → out.basis q = s.basis q) := by
  induction shape generalizing prev s m with
  | one source target =>
      have hn' : [prev, source, target, top].Nodup := by
        simpa only [List.append_assoc, List.append_nil, List.cons_append,
          List.nil_append] using hn
      simpa only [knownTopAdderA, List.cons_append, List.nil_append] using
        packTopA_wide_frame source target prev top hn' s m hlow hhigh
  | step source0 source1 target0 target1 carry sources targets carries shape ih =>
      let sourceTail := source1 :: sources
      let targetTail := target1 :: targets
      let carryValue := carryFn (s.basis source0) (s.basis target0) (s.basis prev)
      let computed := computedBits source0 target0 carry (some prev) s.basis
      obtain ⟨hnHead, hnTail, hsourceTarget, htargetTarget, hcarryTarget,
          haway, hprev⟩ :=
        Arithmetic.RecordedRailVented.step_layout source0 target0 carry top
          sourceTail targetTail carries (some prev) (by
            simpa only [Option.toList_some, List.singleton_append] using hn)
      have hcomputed := computed_head source0 target0 carry (some prev) s.basis hnHead
      have hsame : ∀ q ∈ sourceTail ++ targetTail ++ carries ++ [top],
          computed q = s.basis q := by
        intro q hq
        obtain ⟨hqs, hqt, hqc⟩ := haway q hq
        simp [computed, computedBits, writeBit, hqs, hqt, hqc]
      have hsource : ∀ q ∈ sourceTail, computed q = s.basis q :=
        fun q hq => hsame q (by simp [hq])
      have htargetWide : ∀ q ∈ targetTail ++ [top],
          computed q = s.basis q := fun q hq => hsame q (by
            simp only [List.mem_append, List.mem_cons, List.not_mem_nil,
              or_false] at hq ⊢
            tauto)
      have hcleanTail : ∀ q ∈ carries, computed q = false := by
        intro q hq
        rw [hsame q (by simp [hq])]
        exact hclean q (by simp [hq])
      have hcarryZero : s.basis carry = false := hclean carry (by simp)
      have hcarryValue : computed carry = carryValue := hcomputed.2.2.1
      have hsourceReg := regValue_congr sourceTail computed s.basis hsource
      have htargetWideReg := regValue_congr (targetTail ++ [top])
        computed s.basis htargetWide
      have hfullEq :
          regValue (target0 :: (targetTail ++ [top])) s.basis +
              regValue (source0 :: sourceTail) s.basis + (s.basis prev).toNat =
            (s.basis target0 ^^ s.basis source0 ^^ s.basis prev).toNat +
              2 * (regValue (targetTail ++ [top]) s.basis +
                regValue sourceTail s.basis +
                (carryFn (s.basis source0) (s.basis target0)
                  (s.basis prev)).toNat) := by
        rw [Arithmetic.RecordedRailVented.reg_cons target0
            (targetTail ++ [top]),
          Arithmetic.RecordedRailVented.reg_cons source0 sourceTail]
        have hw := Arithmetic.RecordedRailVented.wide_step
          (s.basis source0) (s.basis target0) (s.basis prev)
          (regValue sourceTail s.basis)
          (regValue (targetTail ++ [top]) s.basis)
        omega
      have hpow : 2 ^ (target0 :: targetTail).length =
          2 * 2 ^ targetTail.length := by simp [pow_succ, Nat.mul_comm]
      have htailLow : 2 ^ targetTail.length ≤
          regValue (targetTail ++ [top]) computed +
            regValue sourceTail computed + (computed carry).toNat := by
        rw [htargetWideReg, hsourceReg, hcarryValue]
        dsimp only [carryValue]
        have hbit :
            (s.basis target0 ^^ s.basis source0 ^^ s.basis prev).toNat ≤ 1 := by
          cases (s.basis target0 ^^ s.basis source0 ^^ s.basis prev) <;> decide
        have hlow' : 2 * 2 ^ targetTail.length ≤
            regValue (target0 :: (targetTail ++ [top])) s.basis +
              regValue (source0 :: sourceTail) s.basis +
                (s.basis prev).toNat := by
          rw [← hpow]
          simpa only [sourceTail, targetTail, List.cons_append] using hlow
        rw [hfullEq] at hlow'
        omega
      have htailHigh :
          regValue (targetTail ++ [top]) computed +
              regValue sourceTail computed + (computed carry).toNat <
            2 ^ (targetTail.length + 1) := by
        rw [htargetWideReg, hsourceReg, hcarryValue]
        dsimp only [carryValue]
        have hpowHigh : 2 ^ ((target0 :: targetTail).length + 1) =
            2 * 2 ^ (targetTail.length + 1) := by
          simp [pow_succ, Nat.mul_comm, Nat.add_assoc]
        have hhigh' :
            regValue (target0 :: (targetTail ++ [top])) s.basis +
                regValue (source0 :: sourceTail) s.basis +
                  (s.basis prev).toNat <
              2 * 2 ^ (targetTail.length + 1) := by
          rw [← hpowHigh]
          simpa only [sourceTail, targetTail, List.cons_append] using hhigh
        rw [hfullEq] at hhigh'
        omega
      let tail := run
        (knownTopAdderA sourceTail targetTail carry carries top)
        (m.take (measurementCount
          (knownTopAdderA sourceTail targetTail carry carries top)))
        ⟨s.phase, computed⟩
      have htail := ih carry ⟨s.phase, computed⟩
        (m.take (measurementCount
          (knownTopAdderA sourceTail targetTail carry carries top)))
        hnTail hcleanTail htailLow htailHigh
      change tail.phase = s.phase ∧
        regValue (targetTail ++ [top]) tail.basis =
          regValue (targetTail ++ [top]) computed +
            regValue sourceTail computed + (computed carry).toNat ∧
        (∀ q, q ∉ targetTail ++ [top] → tail.basis q = computed q) at htail
      obtain ⟨htPhase, htSum, htOutside⟩ := htail
      have htSumOriginal : regValue (targetTail ++ [top]) tail.basis =
          regValue (targetTail ++ [top]) s.basis +
            regValue sourceTail s.basis +
              (carryFn (s.basis source0) (s.basis target0)
                (s.basis prev)).toNat := by
        rw [htSum, htargetWideReg, hsourceReg, hcarryValue]
      have htSource : tail.basis source0 =
          (s.basis source0 ^^ s.basis prev) :=
        (htOutside source0 hsourceTarget).trans hcomputed.1
      have htTarget : tail.basis target0 =
          (s.basis target0 ^^ s.basis prev) :=
        (htOutside target0 htargetTarget).trans hcomputed.2.1
      have htCarry : tail.basis carry = carryValue :=
        (htOutside carry hcarryTarget).trans hcarryValue
      have htPrev : tail.basis prev = s.basis prev :=
        (htOutside prev (hprev prev (by simp))).trans hcomputed.2.2.2
      have hcarry : tail.basis carry =
          ((tail.basis source0 && tail.basis target0) ^^ tail.basis prev) := by
        rw [htCarry, htSource, htTarget, htPrev]
        rfl
      have hnActual : [source0, target0, prev, carry].Nodup := by
        have hnLinear : [prev, source0, target0, carry].Nodup := by
          simpa only [Option.toList_some, List.singleton_append] using hnHead
        apply List.nodup_iff_count.mpr
        intro q
        have h := List.nodup_iff_count.mp hnLinear q
        simp only [List.count_cons, List.count_nil] at h ⊢
        omega
      have hcompute : run (packUpA source0 target0 prev carry) [] s =
          ⟨s.phase, computed⟩ := by
        rw [packUpA_run_eq source0 target0 prev carry hnActual]
        exact carryStep_state source0 target0 carry (some prev) hnHead
          s.basis s.phase [] hcarryZero
      let outBits := writeBit (writeBit (writeBit tail.basis carry false)
        source0 (tail.basis source0 ^^ tail.basis prev))
        target0 (tail.basis target0 ^^
          (tail.basis source0 ^^ tail.basis prev))
      have hdown : run (packDownA source0 target0 prev carry)
          (m.drop (measurementCount
            (knownTopAdderA sourceTail targetTail carry carries top))) tail =
          ⟨s.phase, outBits⟩ := by
        rw [packDownA_run_eq source0 target0 prev carry hnActual]
        rw [unwind_state source0 target0 carry (some prev) hnHead
          tail.basis tail.phase _ hcarry, htPhase]
        simp only [incomingValue]
        rfl
      have hrun : run
          (knownTopAdderA (source0 :: sourceTail) (target0 :: targetTail)
            prev (carry :: carries) top) m s = ⟨s.phase, outBits⟩ := by
        rw [show knownTopAdderA (source0 :: sourceTail)
            (target0 :: targetTail) prev (carry :: carries) top =
          packUpA source0 target0 prev carry ++
            (knownTopAdderA sourceTail targetTail carry carries top ++
              packDownA source0 target0 prev carry) by rfl]
        simp only [run_append]
        have hupCount : measurementCount
            (packUpA source0 target0 prev carry) = 0 := by
          simp [packUpA, measurementCount]
        rw [hupCount, List.take_zero, List.drop_zero, hcompute]
        change run (packDownA source0 target0 prev carry)
          (m.drop (measurementCount
            (knownTopAdderA sourceTail targetTail carry carries top))) tail = _
        exact hdown
      dsimp only
      rw [hrun]
      have hout := unwound_head source0 target0 carry (some prev)
        s.basis tail.basis hnHead htSource htTarget htPrev
      change outBits source0 = s.basis source0 ∧
        outBits target0 = ((s.basis target0 ^^ s.basis source0) ^^
          s.basis prev) ∧ outBits carry = false at hout
      have htailOut : ∀ q ∈ sourceTail ++ targetTail ++ carries ++ [top],
          outBits q = tail.basis q := by
        intro q hq
        obtain ⟨hqs, hqt, hqc⟩ := haway q hq
        simp [outBits, writeBit, hqs, hqt, hqc]
      refine ⟨rfl, ?_, ?_⟩
      · have htailTarget := regValue_congr (targetTail ++ [top])
          outBits tail.basis (by
            intro q hq
            apply htailOut
            simp only [List.mem_append, List.mem_cons, List.not_mem_nil,
              or_false] at hq ⊢
            tauto)
        change regValue (target0 :: (targetTail ++ [top])) outBits =
          regValue (target0 :: (targetTail ++ [top])) s.basis +
            regValue (source0 :: sourceTail) s.basis +
              (s.basis prev).toNat
        rw [Arithmetic.RecordedRailVented.reg_cons target0
            (targetTail ++ [top]), hout.2.1, htailTarget, htSumOriginal,
          Arithmetic.RecordedRailVented.reg_cons source0 sourceTail,
          Arithmetic.RecordedRailVented.reg_cons target0
            (targetTail ++ [top])]
        have hw := Arithmetic.RecordedRailVented.wide_step
          (s.basis source0) (s.basis target0) (s.basis prev)
          (regValue sourceTail s.basis)
          (regValue (targetTail ++ [top]) s.basis)
        omega
      · intro q hq
        have hqTarget : q ≠ target0 := by intro h; exact hq (by simp [h])
        have hqTail : q ∉ targetTail ++ [top] := by
          intro h
          exact hq (by simpa only [targetTail] using List.mem_cons_of_mem target0 h)
        by_cases hqSource : q = source0
        · subst q; exact hout.1
        by_cases hqCarry : q = carry
        · subst q; exact hout.2.2.trans hcarryZero.symm
        simp [outBits, writeBit, hqSource, hqTarget, hqCarry,
          htOutside q hqTail, computed, computedBits]

def packAdderA : List Wire → List Wire → List Wire → Wire → Wire → Program
  | [source], [target], [], prev, top => packTopA source target prev top
  | source :: source' :: sources, target :: target' :: targets,
      carry :: carries, prev, top =>
      packUpA source target prev carry ++
      packAdderA (source' :: sources) (target' :: targets) carries carry top ++
      packDownA source target prev carry
  | _, _, _, _, _ => []

theorem packAdderA_eq_knownTopAdderA (source target work : List Wire)
    (shape : Arithmetic.RecordedRailVented.Shape source target work)
    (prev top : Wire) :
    packAdderA source target work prev top =
      knownTopAdderA source target prev work top := by
  induction shape generalizing prev with
  | one source target => rfl
  | step source0 source1 target0 target1 carry sources targets carries shape ih =>
      change packUpA source0 target0 prev carry ++
          packAdderA (source1 :: sources) (target1 :: targets) carries carry top ++
          packDownA source0 target0 prev carry =
        packUpA source0 target0 prev carry ++
          knownTopAdderA (source1 :: sources) (target1 :: targets)
            carry carries top ++
          packDownA source0 target0 prev carry
      rw [ih carry]

def packAdderLadderA (L : Layout) : Nat → Nat → Wire → Program
  | 0, j, prev => packTopA (L.D j) (L.S j) prev (L.S (j + 1))
  | n + 1, j, prev =>
      packUpA (L.D j) (L.S j) prev (L.C j) ++
      packAdderLadderA L n (j + 1) (L.C j) ++
      packDownA (L.D j) (L.S j) prev (L.C j)

theorem packAdderLadderA_expand (L : Layout) (j n : Nat) (prev : Wire) :
    packAdderLadderA L (n + 1) j prev =
      packUpA (L.D j) (L.S j) prev (L.C j) ++
      (List.range' (j + 1) n).flatMap (adderMiddle L) ++
      packTopA (L.D (j + n + 1)) (L.S (j + n + 1))
        (L.C (j + n)) (L.S (j + n + 2)) ++
      (List.range' (j + 1) n).reverse.flatMap (adderDown L) ++
      packDownA (L.D j) (L.S j) prev (L.C j) := by
  induction n generalizing j prev with
  | zero => simp [packAdderLadderA]
  | succ n ih =>
      rw [packAdderLadderA]
      rw [ih (j := j + 1) (prev := L.C j)]
      simp only [List.range'_succ, List.flatMap_cons, List.reverse_cons,
        List.flatMap_append, List.flatMap_singleton]
      simp [packUpA, packDownA, adderMiddle, adderDown,
        List.append_assoc]
      congr 2 <;> omega

def generatedPackAdderA (L : Layout) (B : Nat) : Program :=
  let sig := L.D (B - 1)
  let first :=
    [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
     .CX sig (L.C 0)]
  let middle := (List.range (B - 3)).flatMap (fun r => adderMiddle L (r + 1))
  let j := B - 2
  let top :=
    [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
     .X (L.S (B - 1)),
     .measureX (L.S (B - 1)) []
       [.Z (L.C (j - 1)), .CZ (L.S j) (L.D j)],
     .X (L.S (B - 1))]
  let down := adderTopDown L B ++
    ((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)
  first ++ middle ++ top ++ down ++
    [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
     .CX sig (L.D 0), .CX (L.D 0) (L.S 0)]

theorem generatedPackAdderA_eq_ladder (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    generatedPackAdderA L B =
      packAdderLadderA L (B - 2) 0 (L.D (B - 1)) := by
  have hfuel : B - 2 = (B - 3) + 1 := by omega
  rw [hfuel, packAdderLadderA_expand]
  have hrange : List.range' 1 (B - 3) =
      (List.range (B - 3)).map (fun r => r + 1) := by
    rw [List.range'_eq_map_range]
    apply List.map_congr_left
    intro r hr
    omega
  rw [hrange]
  have hcarry : B - 3 = B - 2 - 1 := by omega
  have hterm : B - 2 - 1 + 1 = B - 2 := by omega
  have hplus : B - 2 + 1 = B - 1 := by omega
  have htop2 : B - 2 - 1 + 2 = B - 1 := by omega
  simp [generatedPackAdderA, packUpA, packDownA, packTopA,
    adderTopDown, hcarry, hterm, List.append_assoc]
  rw [List.flatMap_map]
  simp [hplus, htop2]

theorem packAdderLadderA_eq_packAdderA (L : Layout) (n j : Nat) (prev : Wire) :
    packAdderLadderA L n j prev =
      packAdderA (railSegment L.D j (n + 1))
        (railSegment L.S j (n + 1)) (railSegment L.C j n)
        prev (L.S (j + n + 1)) := by
  induction n generalizing j prev with
  | zero => simp [packAdderLadderA, packAdderA, railSegment]
  | succ n ih =>
      simp [packAdderLadderA, packAdderA, ih, List.append_assoc]
      congr 2
      all_goals omega

theorem generatedPackAdderA_eq_public (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    generatedPackAdderA L B =
      packAdderA (reg L.D (B - 1)) (reg L.S (B - 1))
        (reg L.C (B - 2)) (L.D (B - 1)) (L.S (B - 1)) := by
  rw [generatedPackAdderA_eq_ladder L B hB,
    packAdderLadderA_eq_packAdderA]
  have htop : B - 2 + 1 = B - 1 := by omega
  simp [railSegment, reg, List.range_eq_range', htop]

theorem reg_snocA (f : Nat → Wire) (n : Nat) :
    reg f (n + 1) = reg f n ++ [f n] := by
  simp [reg, List.range_succ]

theorem codecAdder_shapeA (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    Arithmetic.RecordedRailVented.Shape
      (reg L.D (B - 1)) (reg L.S (B - 1)) (reg L.C (B - 2)) := by
  apply Arithmetic.RecordedRailVented.aligned_shape
  simp [Arithmetic.RecordedRailVented.Aligned, reg]
  omega

theorem codecAdder_nodupA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) :
    ([L.D (B - 1)] ++ reg L.D (B - 1) ++ reg L.S (B - 1) ++
      reg L.C (B - 2) ++ [L.S (B - 1)]).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have hall := List.nodup_iff_count.mp hn q
  have hBs : B - 1 + 1 = B := by omega
  have hD := reg_snocA L.D (B - 1)
  have hS := reg_snocA L.S (B - 1)
  rw [hBs] at hD hS
  simp only [Layout.Nodup, declaredSites, workSites, List.count_append,
    List.count_cons, List.count_nil] at hall ⊢
  rw [hD, hS] at hall
  simp only [List.count_append, List.count_cons, List.count_nil] at hall
  omega


theorem codecPackAdder_wide_frameA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) (s : State) (m : List Bool)
    (hclean : ∀ q ∈ reg L.C (B - 2), s.basis q = false)
    (hlow : 2 ^ (B - 1) ≤
      regValue (reg L.S B) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat)
    (hhigh : regValue (reg L.S B) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat < 2 ^ B) :
    let out := run (generatedPackAdderA L B) m s
    out.phase = s.phase ∧
    regValue (reg L.S B) out.basis =
      regValue (reg L.S B) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat ∧
    (∀ q, q ∉ reg L.S B → out.basis q = s.basis q) := by
  rw [generatedPackAdderA_eq_public L B hB,
    packAdderA_eq_knownTopAdderA _ _ _ (codecAdder_shapeA L B hB)]
  have hf := knownTopAdderA_wide_frame (reg L.D (B - 1))
    (reg L.S (B - 1)) (reg L.C (B - 2))
    (codecAdder_shapeA L B hB) (L.D (B - 1)) (L.S (B - 1)) s m
    (codecAdder_nodupA L B hB hn) hclean
  have hlen : (reg L.S (B - 1)).length = B - 1 := by simp [reg]
  have hBs : B - 1 + 1 = B := by omega
  have hreg := reg_snocA L.S (B - 1)
  rw [hBs] at hreg
  rw [hreg] at hlow hhigh ⊢
  have hlow' : 2 ^ (reg L.S (B - 1)).length ≤
      regValue (reg L.S (B - 1) ++ [L.S (B - 1)]) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat := by simpa only [hlen] using hlow
  have hhigh' : regValue (reg L.S (B - 1) ++ [L.S (B - 1)]) s.basis +
      regValue (reg L.D (B - 1)) s.basis +
      (s.basis (L.D (B - 1))).toNat <
      2 ^ ((reg L.S (B - 1)).length + 1) := by
    simpa only [hlen, hBs] using hhigh
  exact hf hlow' hhigh'


@[simp] theorem xOnA_measurementCount (targets : List Wire) :
    measurementCount (xOnA targets) = 0 := by
  induction targets with
  | nil => simp [xOnA, measurementCount]
  | cons q qs ih => simpa [xOnA, measurementCount] using ih


theorem Dlow_nodupA (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.D (B - 1)).Nodup :=
  (D_nodup L B hn).sublist (by
    simpa only [reg] using
      (List.range_sublist.mpr (Nat.sub_le B 1)).map L.D)

theorem Dtop_not_DlowA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.D (B - 1) ∉ reg L.D (B - 1) := by
  intro hm
  simp only [reg, List.mem_map, List.mem_range] at hm
  rcases hm with ⟨i, hi, heq⟩
  exact reg_ne L.D B (B - 1) i (D_nodup L B hn) (by omega) (by omega)
    (by omega) heq.symm

theorem signedWord_splitA (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    (if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
      else u - sigma.toNat) + 2 ^ (B - 1) * sigma.toNat =
      signedWord B u sigma := by
  have hB : 3 ≤ B := hd.1
  have hsum : u < 2 ^ B := lt_of_le_of_lt (Nat.le_add_right u v) hd.2.2.2.1
  cases sigma with
  | false =>
      simp [signedWord, Nat.mod_eq_of_lt hsum]
  | true =>
      have hadd := domain_sub_sigma_add B u v true hd
      have hw := domain_w_lt_top B u v true hd
      simp only [Bool.toNat_true] at hadd hw
      have hu0 : 0 < u := by
        by_contra hu
        have hu' : u = 0 := by omega
        have hb := (hd.2.2.2.2.2 hu').2
        contradiction
      have hpow : 2 ^ B = 2 ^ (B - 1) * 2 := by
        conv_lhs => rw [show B = (B - 1) + 1 by omega, pow_succ]
      have hdiff : 2 ^ B - u < 2 ^ B := by omega
      have huTop : u ≤ 2 ^ (B - 1) := by omega
      have hsub : 2 ^ (B - 1) - 1 - (u - 1) = 2 ^ (B - 1) - u := by omega
      simp only [Bool.true_eq, if_true, Bool.toNat_true, signedWord]
      rw [Nat.mod_eq_of_lt hdiff, hpow, hsub]
      omega

theorem codecInput_signComplementA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (cxInto (L.D (B - 1)) (reg L.D (B - 1))) m s
    out.phase = s.phase ∧
      regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
      out.basis (L.D (B - 1)) = sigma ∧
      regValue (reg L.S B) out.basis = u + v ∧
      cleanOn (workSites L B) out.basis := by
  have hB : 3 ≤ B := hd.1
  let dlow := reg L.D (B - 1)
  let sig := L.D (B - 1)
  let out := run (cxInto sig dlow) m s
  rcases hc with ⟨hS, hD, hwork⟩
  have hsign := cxInto_run sig dlow (Dlow_nodupA L B hn)
    (Dtop_not_DlowA L B hB hn) s m
  change out = ⟨s.phase, fun q =>
    if s.basis sig && decide (q ∈ dlow) then !s.basis q else s.basis q⟩ at hsign
  have hframe : ∀ q, q ∉ dlow → out.basis q = s.basis q := by
    intro q hq
    rw [hsign]
    simp [hq]
  have hphase : out.phase = s.phase := by rw [hsign]
  have hregD : reg L.D B = dlow ++ [sig] := by
    simp only [dlow, sig]
    conv_lhs => rw [show B = (B - 1) + 1 by omega, reg_snocA]
  have hsingle : regValue [sig] s.basis = (s.basis sig).toNat := by
    cases hs : s.basis sig <;> simp [regValue, hs]
  have hdecomp : regValue dlow s.basis + 2 ^ (B - 1) * (s.basis sig).toNat =
      (if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
       else u - sigma.toNat) + 2 ^ (B - 1) * sigma.toNat := by
    have hw := signedWord_splitA B u v sigma hd
    rw [hregD, regValue_append, hsingle] at hD
    simpa [dlow, reg] using hD.trans hw.symm
  have hdBound : regValue dlow s.basis < 2 ^ (B - 1) := by
    simpa [dlow, reg] using regValue_lt dlow s.basis
  have hwBound := domain_w_lt_top B u v sigma hd
  have hexpectedBound :
      (if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
       else u - sigma.toNat) < 2 ^ (B - 1) := by
    cases sigma with
    | false => simpa using hwBound
    | true =>
        simp only [Bool.true_eq, if_true, Bool.toNat_true]
        have hp : 0 < 2 ^ (B - 1) := by positivity
        omega
  have hsig : s.basis sig = sigma := by
    cases sigma with
    | false =>
        cases hs : s.basis sig with
        | false => rfl
        | true =>
            simp only [hs, Bool.toNat_true, Bool.toNat_false, if_false,
              Nat.mul_zero, Nat.add_zero, Nat.mul_one] at hdecomp hexpectedBound
            omega
    | true =>
        cases hs : s.basis sig with
        | false =>
            simp only [hs, Bool.toNat_false, Bool.toNat_true, if_true,
              Nat.mul_zero, Nat.add_zero, Nat.mul_one] at hdecomp hexpectedBound
            omega
        | true => rfl
  have hdlow : regValue dlow s.basis =
      if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
      else u - sigma.toNat := by
    rw [hsig] at hdecomp
    omega
  refine ⟨hphase, ?_, ?_, ?_, ?_⟩
  · change regValue dlow out.basis = _
    rw [hsign]
    change regValue dlow (fun q =>
      if s.basis sig && decide (q ∈ dlow) then !s.basis q else s.basis q) = _
    cases sigma with
    | false =>
        simp [hsig, hdlow]
    | true =>
        rw [regValue_congr dlow _ (fun q => !s.basis q) (by
          intro q hq
          simp [hsig, hq]), regValue_complement, hdlow]
        simp only [Bool.toNat_true, Bool.true_eq, if_true]
        have hwLe : u - 1 ≤ 2 ^ (B - 1) - 1 := by
          simpa only [Bool.toNat_true] using Nat.le_pred_of_lt hwBound
        simpa [dlow, reg] using Nat.sub_sub_self hwLe
  · rw [hframe sig (Dtop_not_DlowA L B hB hn), hsig]
  · rw [regValue_congr (reg L.S B) out.basis s.basis]
    · exact hS
    · intro q hq
      apply hframe q
      intro hdq
      have hqD : q ∈ reg L.D B :=
        reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hdq
      exact sep_S_rest L B hn hq (by simp [hqD]) rfl
  · intro q hq
    rw [hframe q]
    · exact hwork q hq
    · intro hdq
      have hqD : q ∈ reg L.D B :=
        reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hdq
      exact sep_D_work L B hn hqD hq rfl

theorem odd_prev_testBitA (v i : Nat) (hodd : v % 2 = 1) (hi : 0 < i) :
    (v - 1).testBit i = v.testBit i := by
  obtain ⟨r, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : i ≠ 0)
  rw [Nat.testBit_succ]
  have hdiv := Nat.mod_add_div v 2
  have hhalf : (v - 1) / 2 = v / 2 := by omega
  rw [hhalf, Nat.testBit_succ]

def packArithmeticA (L : Layout) (B : Nat) : Program :=
  cxInto (L.D (B - 1)) (reg L.D (B - 1)) ++
  xOnA (reg L.S B) ++ generatedPackAdderA L B ++ xOnA (reg L.S B) ++
  [.X (L.S 0)]

set_option maxHeartbeats 800000 in
theorem packArithmetic_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packArithmeticA L B) m s
    out.phase = s.phase ∧
      regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
      out.basis (L.D (B - 1)) = sigma ∧
      out.basis (L.S 0) = false ∧
      (∀ i, 0 < i → i < B → out.basis (L.S i) = (v - 1).testBit i) ∧
      cleanOn (workSites L B) out.basis := by
  have hB : 3 ≤ B := hd.1
  let dlow := reg L.D (B - 1)
  let slow := reg L.S (B - 1)
  let carry := reg L.C (B - 2)
  let sig := L.D (B - 1)
  let stop := L.S (B - 1)
  let sfull := reg L.S B
  let p0 := cxInto sig dlow
  let p1 := xOnA sfull
  let p2 := generatedPackAdderA L B
  let p3 := xOnA sfull
  let p4 : Program := [.X (L.S 0)]
  let s0 := run p0 m s
  let s1 := run p1 m s0
  let s2 := run p2 (m.take (measurementCount p2)) s1
  let rest := m.drop (measurementCount p2)
  let s3 := run p3 rest s2
  let out := run p4 rest s3
  have h0 := codecInput_signComplementA L B u v sigma hd hn s m hc
  change s0.phase = s.phase ∧ regValue dlow s0.basis = u - sigma.toNat ∧
    s0.basis sig = sigma ∧ regValue sfull s0.basis = u + v ∧
    cleanOn (workSites L B) s0.basis at h0
  have h1 := xOn_frameA sfull (S_nodup L B hn) s0 m
  change s1.phase = s0.phase ∧
    regValue sfull s1.basis = 2 ^ sfull.length - 1 - regValue sfull s0.basis ∧
    (∀ q, q ∉ sfull → s1.basis q = s0.basis q) at h1
  have hslen : sfull.length = B := by simp [sfull, reg]
  have hS1 : regValue sfull s1.basis = 2 ^ B - 1 - (u + v) := by
    rw [h1.2.1, hslen, h0.2.2.2.1]
  have hD1 : regValue dlow s1.basis = u - sigma.toNat := by
    rw [regValue_congr dlow s1.basis s0.basis]
    · exact h0.2.1
    · intro q hq
      apply h1.2.2 q
      intro hs
      exact sep_S_rest L B hn hs (by
        have hqD : q ∈ reg L.D B :=
          reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
        simp [hqD]) rfl
  have hsig1 : s1.basis sig = sigma := by
    rw [h1.2.2 sig]
    · exact h0.2.2.1
    · intro hs
      exact sep_S_rest L B hn hs (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)]) rfl
  have hwork1 : cleanOn (workSites L B) s1.basis := by
    intro q hq
    rw [h1.2.2 q]
    · exact h0.2.2.2.2 q hq
    · intro hs
      exact sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq) rfl
  have hregS : slow ++ [stop] = sfull := by
    simp only [slow, stop, sfull]
    symm
    exact (by
      have h := reg_snocA L.S (B - 1)
      rw [show B - 1 + 1 = B by omega] at h
      exact h)
  have htotal : regValue sfull s1.basis + regValue dlow s1.basis +
      (s1.basis sig).toNat = 2 ^ B - 1 - v := by
    rw [hS1, hD1, hsig1]
    have hadd := domain_sub_sigma_add B u v sigma hd
    have hsum := hd.2.2.2.1
    omega
  have hvTop := domain_v_lt_top B u v sigma hd
  have hpow : 2 ^ B = 2 * 2 ^ (B - 1) := by
    calc
      2 ^ B = 2 ^ ((B - 1) + 1) := by
        congr 1
        omega
      _ = 2 ^ (B - 1) * 2 := by exact pow_succ 2 (B - 1)
      _ = 2 * 2 ^ (B - 1) := Nat.mul_comm _ _
  have hlow : 2 ^ (B - 1) ≤
      regValue sfull s1.basis + regValue dlow s1.basis +
        (s1.basis sig).toNat := by
    rw [htotal]
    omega
  have hhigh : regValue sfull s1.basis + regValue dlow s1.basis +
      (s1.basis sig).toNat < 2 ^ B := by
    rw [htotal]
    have hvB : v < 2 ^ B := lt_of_lt_of_le hvTop (by rw [hpow]; omega)
    omega
  have hadd := codecPackAdder_wide_frameA L B hB hn s1
    (m.take (measurementCount p2)) (fun q hq => hwork1 q (by
      unfold workSites
      simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
      have hq' : q ∈ reg L.C (B - 2) := by simpa only [carry] using hq
      tauto)) hlow hhigh
  change s2.phase = s1.phase ∧
    regValue sfull s2.basis =
      regValue sfull s1.basis + regValue dlow s1.basis +
        (s1.basis sig).toNat ∧
    (∀ q, q ∉ sfull → s2.basis q = s1.basis q) at hadd
  have hS2 : regValue sfull s2.basis = 2 ^ B - 1 - v :=
    hadd.2.1.trans htotal
  have hD2 : regValue dlow s2.basis = u - sigma.toNat := by
    rw [regValue_congr dlow s2.basis s1.basis]
    · exact hD1
    · intro q hq
      apply hadd.2.2 q
      intro hs
      exact sep_S_rest L B hn hs (by
        have hqD : q ∈ reg L.D B :=
          reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
        simp [hqD]) rfl
  have hsig2 : s2.basis sig = sigma := by
    rw [hadd.2.2 sig]
    · exact hsig1
    · intro hs
      exact sep_S_rest L B hn hs (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)]) rfl
  have hwork2 : cleanOn (workSites L B) s2.basis := by
    intro q hq
    rw [hadd.2.2 q]
    · exact hwork1 q hq
    · intro hs
      exact sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq) rfl
  have h3 := xOn_frameA sfull (S_nodup L B hn) s2 rest
  change s3.phase = s2.phase ∧
    regValue sfull s3.basis = 2 ^ sfull.length - 1 - regValue sfull s2.basis ∧
    (∀ q, q ∉ sfull → s3.basis q = s2.basis q) at h3
  have hS3 : regValue sfull s3.basis = v := by
    rw [h3.2.1, hslen, hS2]
    have hvB : v < 2 ^ B := lt_of_lt_of_le hvTop (by rw [hpow]; omega)
    exact Nat.sub_sub_self (by omega : v ≤ 2 ^ B - 1)
  have hS30 : s3.basis (L.S 0) = true := by
    have hi : 0 < sfull.length := by rw [hslen]; omega
    have hb := regValue_getD_testBit sfull 0 0 s3.basis hi
    have hw : sfull.getD 0 0 = L.S 0 := by
      rw [List.getD_eq_getElem _ _ hi]
      simp [sfull, reg]
    rw [hw, hS3] at hb
    exact hb.trans (Nat.mod_two_eq_one_iff_testBit_zero.mp hd.2.2.1)
  have hS3bits : ∀ i, 0 < i → i < B →
      s3.basis (L.S i) = (v - 1).testBit i := by
    intro i hi0 hiB
    have hi : i < sfull.length := by simpa [hslen] using hiB
    have hb := regValue_getD_testBit sfull i 0 s3.basis hi
    have hw : sfull.getD i 0 = L.S i := by
      rw [List.getD_eq_getElem _ _ hi]
      simp [sfull, reg]
    rw [hw, hS3] at hb
    exact hb.trans (odd_prev_testBitA v i hd.2.2.1 hi0).symm
  have hD3 : regValue dlow s3.basis = u - sigma.toNat := by
    rw [regValue_congr dlow s3.basis s2.basis]
    · exact hD2
    · intro q hq
      apply h3.2.2 q
      intro hs
      exact sep_S_rest L B hn hs (by
        have hqD : q ∈ reg L.D B :=
          reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
        simp [hqD]) rfl
  have hsig3 : s3.basis sig = sigma := by
    rw [h3.2.2 sig]
    · exact hsig2
    · intro hs
      exact sep_S_rest L B hn hs (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)]) rfl
  have hwork3 : cleanOn (workSites L B) s3.basis := by
    intro q hq
    rw [h3.2.2 q]
    · exact hwork2 q hq
    · intro hs
      exact sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq) rfl
  have hrun : run (packArithmeticA L B) m s = out := by
    have hshape : packArithmeticA L B =
        p0 ++ (p1 ++ (p2 ++ (p3 ++ p4))) := by
      dsimp only [p0, p1, p2, p3, p4]
      simp only [packArithmeticA, List.append_assoc, sig, dlow, sfull]
    rw [hshape]
    rw [run_append_zero_left_spec p0 _ (cxInto_measurementCount sig dlow)]
    rw [run_append_zero_left_spec p1 _ (by simp [p1])]
    rw [run_append]
    change run (p3 ++ p4) rest s2 = out
    rw [run_append_zero_left_spec p3 p4 (by simp [p3])]
  rw [hrun]
  refine ⟨rfl.trans (h3.1.trans (hadd.1.trans (h1.1.trans h0.1))),
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [regValue_congr dlow out.basis s3.basis]
    · exact hD3
    · intro q hq
      have hqD : q ∈ reg L.D B :=
        reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
      have hne : q ≠ L.S 0 := (sep_S_rest L B hn
        (reg_mem L.S B 0 (by omega)) (by simp [hqD])).symm
      simp [out, p4, run, writeBit, hne]
  · have hne : sig ≠ L.S 0 := (sep_S_rest L B hn
      (reg_mem L.S B 0 (by omega)) (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)])).symm
    have hneD : L.D (B - 1) ≠ L.S 0 := by simpa only [sig] using hne
    change Function.update s3.basis (L.S 0) (!s3.basis (L.S 0))
      (L.D (B - 1)) = sigma
    simp [Function.update, hneD]
    simpa only [sig] using hsig3
  · simp [out, p4, run, writeBit, hS30]
  · intro i hi0 hiB
    have hne : L.S i ≠ L.S 0 :=
      reg_ne L.S B i 0 (S_nodup L B hn) hiB (by omega) (by omega)
    simp [out, p4, run, writeBit, hne, hS3bits i hi0 hiB]
  · intro q hq
    have hne : q ≠ L.S 0 := by
      intro heq
      subst q
      exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (List.mem_append_right (reg L.D B) hq) rfl
    simp [out, p4, run, writeBit, hne, hwork3 q hq]

theorem initialSweepState_invariantA (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) :
    PackSweepInvariant B u v sigma (B - 1)
      (initialSweepState B (u - sigma.toNat) v) := by
  let w := u - sigma.toNat
  have hlen : natBitLength w ≤ B - 1 := by
    simpa [w] using domain_w_bitLength_le B u v sigma hdomain
  have hw : w < 2 ^ (B - 1) := by
    simpa [w] using domain_w_lt_top B u v sigma hdomain
  change B - 1 ≤ B - 1 ∧ true = decide (w < 2 ^ (B - 1)) ∧
    0 = (if B - 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 → w.testBit i =
      if i < B - 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      (if B - 2 - i = 0 then false else (v - 1).testBit (B - 2 - i)) =
        if i < B - 1 then halfBit B v i else false)
  refine ⟨le_rfl, by simp [hw], ?_, ?_, ?_⟩
  · rw [if_neg (by omega : ¬B - 1 < natBitLength w)]
  · intro i hi
    simp [hi]
  · intro i hi
    have hindex : B - 2 - i = (B - 3 - i) + 1 := by omega
    rw [if_pos (by omega : i < B - 1), if_neg (by omega : ¬B - 2 - i = 0)]
    simp only [halfBit, hindex, Nat.testBit_succ]

def packInitA (L : Layout) (B : Nat) : Program :=
  packArithmeticA L B ++ [.X L.z] ++
    decoderInit (lowDecoder L B) (lowBits L B) ++
    decoderInit (highDecoder L B) (highBits L B)

set_option maxHeartbeats 800000 in
theorem packInit_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packInitA L B) m s
    out.phase = s.phase ∧
      PackSweepInvariant B u v sigma (B - 1)
        (initialSweepState B (u - sigma.toNat) v) ∧
      RealizesUnpackSweep L B
        (initialSweepState B (u - sigma.toNat) v) out.basis := by
  have hB : 3 ≤ B := hd.1
  let p0 := packArithmeticA L B
  let pz : Program := [.X L.z]
  let pl := decoderInit (lowDecoder L B) (lowBits L B)
  let ph := decoderInit (highDecoder L B) (highBits L B)
  let s0 := run p0 (m.take (measurementCount p0)) s
  let rest := m.drop (measurementCount p0)
  let s1 := run pz rest s0
  let s2 := run pl rest s1
  let out := run ph rest s2
  have h0 := packArithmetic_correctA L B u v sigma hd hn s
    (m.take (measurementCount p0)) hc
  change s0.phase = s.phase ∧
    regValue (reg L.D (B - 1)) s0.basis = u - sigma.toNat ∧
    s0.basis (L.D (B - 1)) = sigma ∧ s0.basis (L.S 0) = false ∧
    (∀ i, 0 < i → i < B → s0.basis (L.S i) = (v - 1).testBit i) ∧
    cleanOn (workSites L B) s0.basis at h0
  have hz0 : s0.basis L.z = false := h0.2.2.2.2.2 L.z (by simp [workSites])
  have hz1 : s1.basis L.z = true := by
    simp [s1, pz, run, writeBit, hz0]
  have hzFrame : ∀ q, q ≠ L.z → s1.basis q = s0.basis q := by
    intro q hq
    simp [s1, pz, run, writeBit, hq]
  have hLowClean : ∀ q ∈ (lowDecoder L B).sites, s1.basis q = false := by
    intro q hq
    rw [hzFrame q]
    · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
  have hLow := decoderInit_run (lowDecoder L B) (lowBits L B)
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 s1 rest hLowClean
  change s2.phase = s1.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, s2.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B) 0 q) ∧
    (∀ q ∉ (lowDecoder L B).sites, s2.basis q = s1.basis q) at hLow
  have hHighClean : ∀ q ∈ (highDecoder L B).sites, s2.basis q = false := by
    intro q hq
    rw [hLow.2.2 q]
    · rw [hzFrame q]
      · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_right (lowDecoder L B).sites hq))
    · intro hl
      exact sep_low_high L B hn hl hq rfl
  have hHigh := decoderInit_run (highDecoder L B) (highBits L B)
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 s2 rest hHighClean
  change out.phase = s2.phase ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B) 0 q) ∧
    (∀ q ∉ (highDecoder L B).sites, out.basis q = s2.basis q) at hHigh
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hql : q ∉ (lowDecoder L B).sites)
      (hqh : q ∉ (highDecoder L B).sites) : out.basis q = s0.basis q := by
    rw [hHigh.2.2 q hqh, hLow.2.2 q hql, hzFrame q hqz]
  have hrun : run (packInitA L B) m s = out := by
    rw [show packInitA L B = p0 ++ (pz ++ (pl ++ ph)) by
      simp [packInitA, p0, pz, pl, ph, List.append_assoc]]
    rw [run_append]
    change run (pz ++ (pl ++ ph)) rest s0 = out
    rw [run_append_zero_left_spec pz _ (by simp [pz, measurementCount])]
    rw [run_append_zero_left_spec pl _
      (decoderInit_counts (lowDecoder L B) (lowBits L B)).2]
  rw [hrun]
  refine ⟨hHigh.1.trans (hLow.1.trans h0.1),
    initialSweepState_invariantA B u v sigma hd, ?_⟩
  change RealizesUnpackSweep L B
    (initialSweepState B (u - sigma.toNat) v) out.basis
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have hAfalse : ∀ q ∈ reg L.A (bitWidth B), out.basis q = false := by
      intro q hq
      rw [hframe q]
      · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
      · exact sep_A_rest L B hn hq (by simp)
      · intro hs
        exact sep_A_rest L B hn hq (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_A_rest L B hn hq (by simp [workSites, hs]) rfl
    exact (regValue_zero (reg L.A (bitWidth B)) out.basis).mpr hAfalse
  · rw [hHigh.2.2 L.z, hLow.2.2 L.z]
    · exact hz1
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hs) rfl
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hs) rfl
  · rw [hframe L.t]
    · exact h0.2.2.2.2.2 L.t (by simp [workSites])
    · exact Ne.symm (sep_z_t L B hn)
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hs) rfl
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hs) rfl
  · intro i hi
    have hDi : L.D i ∈ reg L.D B := reg_mem L.D B i (by omega)
    rw [hframe (L.D i)]
    · have hlen : i < (reg L.D (B - 1)).length := by simpa [reg] using hi
      have hb := regValue_getD_testBit (reg L.D (B - 1)) i 0 s0.basis hlen
      have hw : (reg L.D (B - 1)).getD i 0 = L.D i := by
        rw [List.getD_eq_getElem _ _ hlen]
        simp [reg]
      rw [hw, h0.2.1] at hb
      exact hb
    · exact sep_D_work L B hn hDi (by simp [workSites])
    · intro hs
      exact sep_D_work L B hn hDi (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_D_work L B hn hDi (by simp [workSites, hs]) rfl
  · intro i hi
    have hindex0 : 0 < B - 2 - i := by omega
    have hindexB : B - 2 - i < B := by omega
    rw [hframe (L.S (B - 2 - i))]
    · simpa [initialSweepState, ne_of_gt hindex0] using
        h0.2.2.2.2.1 (B - 2 - i) hindex0 hindexB
    · exact sep_S_rest L B hn (reg_mem L.S B _ hindexB) (by simp [workSites])
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B _ hindexB)
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B _ hindexB)
        (by simp [workSites, hs]) rfl
  · intro q hq
    rw [hHigh.2.2 q]
    · simpa using hLow.2.1 q hq
    · intro hh
      exact sep_low_high L B hn hq hh rfl
  · intro q hq
    simpa [initialSweepState] using hHigh.2.1 q hq

/-! Circuit-independent descending-sweep induction. -/

















def packSweepProgramA (L : Layout) (B : Nat) : Nat → Nat → Program
  | _, 0 => []
  | r, n + 1 =>
      packStep L B (r - 1) ++ packSweepProgramA L B (r - 1) n

theorem packSweepProgramA_correct (L : Layout) (B u v r n : Nat)
    (sigma : Bool) (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (hnr : n ≤ r) (hrB : r ≤ B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma r st)
    (hreal : RealizesUnpackSweep L B st s.basis) :
    let out := run (packSweepProgramA L B r n) m s
    out.phase = s.phase ∧
      ∃ fin, PackSweepInvariant B u v sigma (r - n) fin ∧
        RealizesUnpackSweep L B fin out.basis := by
  induction n generalizing r st s m with
  | zero =>
      refine ⟨rfl, st, ?_, hreal⟩
      simpa using hinv
  | succ n ih =>
      have hr : 0 < r := by omega
      have hn' : n ≤ r - 1 := by omega
      let firstProgram := packStep L B (r - 1)
      let firstTape := m.take (measurementCount firstProgram)
      let restTape := m.drop (measurementCount firstProgram)
      let first := run firstProgram firstTape s
      let next := packSweepStep B r st
      have hfirst := packStep_correctA L B u v r sigma hdomain hn hr hrB
        st s firstTape hinv hreal
      change first.phase = s.phase ∧
        PackSweepInvariant B u v sigma (r - 1) next ∧
        RealizesUnpackSweep L B next first.basis at hfirst
      have hrest := ih (r := r - 1) (st := next) (s := first)
        (m := restTape) hn' (by omega) hfirst.2.1 hfirst.2.2
      let out := run (packSweepProgramA L B (r - 1) n) restTape first
      change out.phase = first.phase ∧
        ∃ fin, PackSweepInvariant B u v sigma (r - 1 - n) fin ∧
          RealizesUnpackSweep L B fin out.basis at hrest
      rw [packSweepProgramA, run_append]
      change out.phase = s.phase ∧
        ∃ fin, PackSweepInvariant B u v sigma (r - (n + 1)) fin ∧
          RealizesUnpackSweep L B fin out.basis
      refine ⟨hrest.1.trans hfirst.1, ?_⟩
      simpa [Nat.sub_sub, Nat.add_comm] using hrest.2

theorem packSweepProgramA_eq_generated (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    packSweepProgramA L B (B - 1) (B - 1) =
      packStep L B (B - 2) ++
        (List.range (B - 2)).reverse.flatMap (packStep L B) := by
  rw [show B - 1 = (B - 2) + 1 by omega, packSweepProgramA]
  rw [show B - 2 + 1 - 1 = B - 2 by omega]
  congr 1
  induction B - 2 with
  | zero => rfl
  | succ n ih =>
      rw [packSweepProgramA]
      rw [List.range_succ, List.reverse_append, List.flatMap_append]
      simp only [List.reverse_singleton, List.flatMap_singleton,
        List.singleton_append]
      rw [show n + 1 - 1 = n by omega, ih]

theorem packStep_wires_eq_unpackStepA (L : Layout) (B j : Nat) :
    wires (packStep L B j) = wires (unpackStep L B j) := by
  ext q
  simp only [packStep, unpackStep]
  split_ifs <;>
    simp only [wires_append, wires, Instr.wires, correctionWires,
      Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.notMem_empty, or_false] <;>
    aesop

theorem packStep_support_activeA (L : Layout) (B j : Nat) (hj : j < B - 1) :
    wires (packStep L B j) ⊆ (unpackSweepSites L B).toFinset := by
  rw [packStep_wires_eq_unpackStepA]
  exact unpackStep_support_active L B j hj

theorem packSweepProgramA_support (L : Layout) (B r n : Nat)
    (hnr : n ≤ r) (hrB : r ≤ B - 1) :
    wires (packSweepProgramA L B r n) ⊆ (unpackSweepSites L B).toFinset := by
  induction n generalizing r with
  | zero => simp [packSweepProgramA, wires]
  | succ n ih =>
      rw [packSweepProgramA, wires_append]
      apply Finset.union_subset
      · apply packStep_support_activeA
        omega
      · apply ih (r - 1)
        · omega
        · omega

theorem packSweepProgramA_frame (L : Layout) (B r n : Nat)
    (hnr : n ≤ r) (hrB : r ≤ B - 1) (s : State) (m : List Bool)
    {q : Wire} (hq : q ∉ unpackSweepSites L B) :
    (run (packSweepProgramA L B r n) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro hw
  exact hq (List.mem_toFinset.mp (packSweepProgramA_support L B r n hnr hrB hw))

theorem packInit_staticA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packInitA L B) m s
    out.basis (L.D (B - 1)) = sigma ∧
      out.basis (L.S 0) = false ∧
      out.basis (L.S (B - 1)) = false ∧
      (∀ q ∈ reg L.C (B - 2), out.basis q = false) := by
  have hB := hd.1
  let p0 := packArithmeticA L B
  let pz : Program := [.X L.z]
  let pl := decoderInit (lowDecoder L B) (lowBits L B)
  let ph := decoderInit (highDecoder L B) (highBits L B)
  let s0 := run p0 (m.take (measurementCount p0)) s
  let rest := m.drop (measurementCount p0)
  let s1 := run pz rest s0
  let s2 := run pl rest s1
  let out := run ph rest s2
  have h0 := packArithmetic_correctA L B u v sigma hd hn s
    (m.take (measurementCount p0)) hc
  change s0.phase = s.phase ∧
    regValue (reg L.D (B - 1)) s0.basis = u - sigma.toNat ∧
    s0.basis (L.D (B - 1)) = sigma ∧ s0.basis (L.S 0) = false ∧
    (∀ i, 0 < i → i < B → s0.basis (L.S i) = (v - 1).testBit i) ∧
    cleanOn (workSites L B) s0.basis at h0
  have hzFrame : ∀ q, q ≠ L.z → s1.basis q = s0.basis q := by
    intro q hq
    simp [s1, pz, run, writeBit, hq]
  have hLowClean : ∀ q ∈ (lowDecoder L B).sites, s1.basis q = false := by
    intro q hq
    rw [hzFrame q]
    · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
  have hLow := decoderInit_run (lowDecoder L B) (lowBits L B)
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 s1 rest hLowClean
  change s2.phase = s1.phase ∧ _ ∧
    (∀ q ∉ (lowDecoder L B).sites, s2.basis q = s1.basis q) at hLow
  have hHighClean : ∀ q ∈ (highDecoder L B).sites, s2.basis q = false := by
    intro q hq
    rw [hLow.2.2 q]
    · rw [hzFrame q]
      · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_right (lowDecoder L B).sites hq))
    · intro hl
      exact sep_low_high L B hn hl hq rfl
  have hHigh := decoderInit_run (highDecoder L B) (highBits L B)
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 s2 rest hHighClean
  change out.phase = s2.phase ∧ _ ∧
    (∀ q ∉ (highDecoder L B).sites, out.basis q = s2.basis q) at hHigh
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hql : q ∉ (lowDecoder L B).sites)
      (hqh : q ∉ (highDecoder L B).sites) : out.basis q = s0.basis q := by
    rw [hHigh.2.2 q hqh, hLow.2.2 q hql, hzFrame q hqz]
  have hrun : run (packInitA L B) m s = out := by
    rw [show packInitA L B = p0 ++ (pz ++ (pl ++ ph)) by
      simp [packInitA, p0, pz, pl, ph, List.append_assoc]]
    rw [run_append]
    change run (pz ++ (pl ++ ph)) rest s0 = out
    rw [run_append_zero_left_spec pz _ (by simp [pz, measurementCount])]
    rw [run_append_zero_left_spec pl _
      (decoderInit_counts (lowDecoder L B) (lowBits L B)).2]
  rw [hrun]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hframe (L.D (B - 1))]
    · exact h0.2.2.1
    · exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites])
    · intro hs
      exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
  · rw [hframe (L.S 0)]
    · exact h0.2.2.2.1
    · exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites])
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hs]) rfl
  · rw [hframe (L.S (B - 1))]
    · rw [h0.2.2.2.2.1 (B - 1) (by omega) (by omega)]
      apply Nat.testBit_lt_two_pow
      have hv := domain_v_lt_top B u v sigma hd
      omega
    · exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites])
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
  · intro q hq
    rw [hframe q]
    · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
    · exact sep_C_rest L B hn hq (by simp)
    · intro hs
      exact sep_C_rest L B hn hq (by simp [hs]) rfl
    · intro hs
      exact sep_C_rest L B hn hq (by simp [hs]) rfl

def packSweepCoreA (L : Layout) (B : Nat) : Program :=
  packInitA L B ++ packSweepProgramA L B (B - 1) (B - 1)

set_option maxHeartbeats 800000 in
theorem packSweepCore_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packSweepCoreA L B) m s
    out.phase = s.phase ∧
      ∃ fin,
        PackSweepInvariant B u v sigma 0 fin ∧
        RealizesUnpackSweep L B fin out.basis ∧
        out.basis (L.D (B - 1)) = sigma ∧
        out.basis (L.S 0) = false ∧
        out.basis (L.S (B - 1)) = false ∧
        (∀ q ∈ reg L.C (B - 2), out.basis q = false) := by
  let pi := packInitA L B
  let ps := packSweepProgramA L B (B - 1) (B - 1)
  let mid := run pi (m.take (measurementCount pi)) s
  let rest := m.drop (measurementCount pi)
  let out := run ps rest mid
  have hi := packInit_correctA L B u v sigma hd hn s
    (m.take (measurementCount pi)) hc
  change mid.phase = s.phase ∧
    PackSweepInvariant B u v sigma (B - 1)
      (initialSweepState B (u - sigma.toNat) v) ∧
    RealizesUnpackSweep L B
      (initialSweepState B (u - sigma.toNat) v) mid.basis at hi
  have histatic := packInit_staticA L B u v sigma hd hn s
    (m.take (measurementCount pi)) hc
  change mid.basis (L.D (B - 1)) = sigma ∧
    mid.basis (L.S 0) = false ∧
    mid.basis (L.S (B - 1)) = false ∧
    (∀ q ∈ reg L.C (B - 2), mid.basis q = false) at histatic
  have hs := packSweepProgramA_correct L B u v (B - 1) (B - 1) sigma hd hn
    (by omega) (by omega) (initialSweepState B (u - sigma.toNat) v)
    mid rest hi.2.1 hi.2.2
  have hs' : out.phase = mid.phase ∧ ∃ fin,
      PackSweepInvariant B u v sigma 0 fin ∧
      RealizesUnpackSweep L B fin out.basis := by
    simpa only [Nat.sub_self] using hs
  have hrun : run (packSweepCoreA L B) m s = out := by
    simp only [packSweepCoreA, run_append, pi, ps, mid, rest, out]
  rw [hrun]
  refine ⟨hs'.1.trans hi.1, ?_⟩
  rcases hs'.2 with ⟨fin, hfin, hreal⟩
  refine ⟨fin, hfin, hreal, ?_, ?_, ?_, ?_⟩
  · rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (sign_not_unpackSweepSites L B hd.1 hn)]
    exact histatic.1
  · rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (sZero_not_unpackSweepSites L B hd.1 hn)]
    exact histatic.2.1
  · rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (sTop_not_unpackSweepSites L B hd.1 hn)]
    exact histatic.2.2.1
  · intro q hq
    rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (carry_not_unpackSweepSites L B hn hq)]
    exact histatic.2.2.2 q hq





theorem terminalSweepValuesA (B u v : Nat) (sigma : Bool) (fin : SweepState)
    (hinv : PackSweepInvariant B u v sigma 0 fin) :
    let w := u - sigma.toNat
    fin.a = natBitLength w ∧
      fin.z = decide (0 = fin.a) ∧
      (∀ i, i < B - 1 → fin.d i = payloadBit B w v i) ∧
      (∀ i, i < B - 2 → fin.s (B - 2 - i) = false) := by
  let w := u - sigma.toNat
  change 0 ≤ B - 1 ∧ fin.z = decide (w < 2 ^ 0) ∧
    fin.a = (if 0 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 → fin.d i =
      if i < 0 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 → fin.s (B - 2 - i) =
      if i < 0 then halfBit B v i else false) at hinv
  rcases hinv with ⟨_, hz, ha, hd, hs⟩
  have ha' : fin.a = natBitLength w := by
    by_cases hw : w = 0
    · simp [hw, natBitLength] at ha ⊢
      exact ha
    · have hp : 0 < natBitLength w := by simp [natBitLength, hw]
      simpa [hp] using ha
  refine ⟨ha', ?_, ?_, ?_⟩
  · rw [hz, ha']
    by_cases hw : w = 0
    · simp [hw, natBitLength]
    · have hwpos : 0 < w := Nat.pos_of_ne_zero hw
      have hp : 0 < natBitLength w := by simp [natBitLength, hw]
      simp [hw, hwpos, hp, Nat.ne_of_gt hp, Ne.symm (Nat.ne_of_gt hp)]
  · intro i hi
    simpa using hd i hi
  · intro i hi
    simpa using hs i hi

def packFinalizeA (L : Layout) (B : Nat) : Program :=
  [.measureX L.z []
      [.CZ (outAt (highDecoder L B) 0 L.z) (outAt (lowDecoder L B) 0 L.z)]] ++
    eraseDecoderA (highDecoder L B) ++ eraseDecoderA (lowDecoder L B)

theorem eraseHighA_run (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hsites : ∀ q ∈ (highDecoder L B).sites, s.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) :
    run (eraseDecoderA (highDecoder L B)) m s =
      ⟨s.phase, fun q => if q ∈ (highDecoder L B).sites then false
        else s.basis q⟩ := by
  have hx : value / 2 ^ (bitWidth B / 2) < 2 ^ (highBits L B).length := by
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simp only [highBits, reg, List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul hp, ← pow_add]
    have hlo : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hlo, Nat.mul_comm] using hbound
  have hbits : ∀ i, i < (highBits L B).length →
      s.basis ((highBits L B).getD i 0) =
        (value / 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact highBits_read L B value i s.basis hvalue hi
  simpa only [highDecoder] using eraseDecoderA_run
    (highBits L B) L.highWork (highDecoder_nodup L B hn) s m
    (value / 2 ^ (bitWidth B / 2)) hx hbits (by
      simpa only [highDecoder] using hsites)

theorem eraseLowA_run (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hsites : ∀ q ∈ (lowDecoder L B).sites, s.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) :
    run (eraseDecoderA (lowDecoder L B)) m s =
      ⟨s.phase, fun q => if q ∈ (lowDecoder L B).sites then false
        else s.basis q⟩ := by
  have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
  have hx : value % 2 ^ (bitWidth B / 2) < 2 ^ (lowBits L B).length := by
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using
      Nat.mod_lt value hp
  have hbits : ∀ i, i < (lowBits L B).length →
      s.basis ((lowBits L B).getD i 0) =
        (value % 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact lowBits_read L B value i s.basis hvalue hi
  simpa only [lowDecoder] using eraseDecoderA_run
    (lowBits L B) L.lowWork (lowDecoder_nodup L B hn) s m
    (value % 2 ^ (bitWidth B / 2)) hx hbits (by
      simpa only [lowDecoder] using hsites)

set_option maxHeartbeats 1200000 in
theorem packFinalize_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (fin : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma 0 fin)
    (hreal : RealizesUnpackSweep L B fin s.basis)
    (hsig : s.basis (L.D (B - 1)) = sigma)
    (hs0 : s.basis (L.S 0) = false)
    (hstop : s.basis (L.S (B - 1)) = false)
    (hcarry : ∀ q ∈ reg L.C (B - 2), s.basis q = false) :
    let out := run (packFinalizeA L B) m s
    out.phase = s.phase ∧ CompactCode L B u v sigma out.basis := by
  have hB := hdomain.1
  let pz : Program := [.measureX L.z []
    [.CZ (outAt (highDecoder L B) 0 L.z) (outAt (lowDecoder L B) 0 L.z)]]
  let ph := eraseDecoderA (highDecoder L B)
  let pl := eraseDecoderA (lowDecoder L B)
  let mz := m.take (measurementCount pz)
  let rest := m.drop (measurementCount pz)
  let mh := rest.take (measurementCount ph)
  let ml := rest.drop (measurementCount ph)
  let zOut := run pz mz s
  let highOut := run ph mh zOut
  let out := run pl ml highOut
  have hterm := terminalSweepValuesA B u v sigma fin hinv
  change fin.a = natBitLength (u - sigma.toNat) ∧
    fin.z = decide (0 = fin.a) ∧
    (∀ i, i < B - 1 → fin.d i = payloadBit B (u - sigma.toNat) v i) ∧
    (∀ i, i < B - 2 → fin.s (B - 2 - i) = false) at hterm
  rcases hreal with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have haBound : fin.a < 2 ^ bitWidth B := by
    rw [← ha]
    simpa [reg] using regValue_lt (reg L.A (bitWidth B)) s.basis
  have hzeroBound : 0 < 2 ^ bitWidth B := by positivity
  have hsel := pairDecoder_selected_of_sites L B fin.a 0 hn s.basis ha
    haBound hzeroBound hlow hhigh
  have houtBounds := decoderOutputBoundsA L B 0 (by omega) hB
  have hleft : outAt (highDecoder L B) 0 L.z ≠ L.z :=
    high_output_ne_z L B 0 hn (by simpa using houtBounds.2)
  have hright : outAt (lowDecoder L B) 0 L.z ≠ L.z :=
    low_output_ne_z L B 0 hn (by simpa using houtBounds.1)
  have hzvalue : s.basis L.z =
      (s.basis (outAt (highDecoder L B) 0 L.z) &&
        s.basis (outAt (lowDecoder L B) 0 L.z)) := by
    rw [hz, hterm.2.1]
    simpa using hsel.symm
  have hzrun := measureCZ_resetA L.z
    (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) s mz hleft hright hzvalue
  change zOut = ⟨s.phase, writeBit s.basis L.z false⟩ at hzrun
  have hzFrame : ∀ q, q ≠ L.z → zOut.basis q = s.basis q := by
    intro q hq
    rw [hzrun]
    simp [writeBit, Function.update, hq]
  have hzA : regValue (reg L.A (bitWidth B)) zOut.basis = fin.a := by
    refine (regValue_congr _ _ _ ?_).trans ha
    intro q hq
    apply hzFrame q
    exact sep_A_rest L B hn hq (by simp)
  have hzHigh : ∀ q ∈ (highDecoder L B).sites, zOut.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (fin.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hzFrame q]
    · exact hhigh q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
  have hherase := eraseHighA_run L B fin.a hn zOut mh hzA haBound hzHigh
  change highOut = ⟨zOut.phase, fun q =>
    if q ∈ (highDecoder L B).sites then false else zOut.basis q⟩ at hherase
  have hhFrame : ∀ q, q ∉ (highDecoder L B).sites →
      highOut.basis q = zOut.basis q := by
    intro q hq
    rw [hherase]
    simp [hq]
  have hhA : regValue (reg L.A (bitWidth B)) highOut.basis = fin.a := by
    refine (regValue_congr _ _ _ ?_).trans hzA
    intro q hq
    apply hhFrame q
    intro hs
    exact sep_A_rest L B hn hq (by simp [hs]) rfl
  have hhLow : ∀ q ∈ (lowDecoder L B).sites, highOut.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (fin.a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hhFrame q]
    · rw [hzFrame q]
      · exact hlow q hq
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_left (highDecoder L B).sites hq))
    · intro hh
      exact sep_low_high L B hn hq hh rfl
  have hlerase := eraseLowA_run L B fin.a hn highOut ml hhA hhLow
  change out = ⟨highOut.phase, fun q =>
    if q ∈ (lowDecoder L B).sites then false else highOut.basis q⟩ at hlerase
  have hlFrame : ∀ q, q ∉ (lowDecoder L B).sites →
      out.basis q = highOut.basis q := by
    intro q hq
    rw [hlerase]
    simp [hq]
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hql : q ∉ (lowDecoder L B).sites)
      (hqh : q ∉ (highDecoder L B).sites) : out.basis q = s.basis q := by
    rw [hlFrame q hql, hhFrame q hqh, hzFrame q hqz]
  have hrun : run (packFinalizeA L B) m s = out := by
    have hshape : packFinalizeA L B = pz ++ (ph ++ pl) := by
      rfl
    rw [hshape, run_append]
    change run (ph ++ pl) rest zOut = out
    rw [run_append]
  rw [hrun]
  refine ⟨?_, ?_⟩
  · rw [hlerase, hherase, hzrun]
  · change CompactCode L B u v sigma out.basis
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hAout : regValue (reg L.A (bitWidth B)) out.basis = fin.a := by
        refine (regValue_congr _ _ _ ?_).trans ha
        intro q hq
        apply hframe q
        · exact sep_A_rest L B hn hq (by simp)
        · intro hs
          exact sep_A_rest L B hn hq (by simp [hs]) rfl
        · intro hs
          exact sep_A_rest L B hn hq (by simp [hs]) rfl
      exact hAout.trans hterm.1
    · apply regValue_eq_of_bits
      · simpa [reg] using compactF_bound B (u - sigma.toNat) v
      · intro i hi
        have hi' : i < B - 2 := by simpa [reg] using hi
        have hget : (reg L.D (B - 2)).getD i 0 = L.D i := by
          rw [List.getD_eq_getElem _ _ hi]
          simp [reg]
        rw [hget, hframe (L.D i)]
        · rw [hdrail i (by omega), hterm.2.2.1 i (by omega)]
          exact (compactF_testBit B (u - sigma.toNat) v i hi').symm
        · exact sep_D_work L B hn (reg_mem L.D B i (by omega))
            (by simp [workSites])
        · intro hs
          exact sep_D_work L B hn (reg_mem L.D B i (by omega))
            (by simp [workSites, hs]) rfl
        · intro hs
          exact sep_D_work L B hn (reg_mem L.D B i (by omega))
            (by simp [workSites, hs]) rfl
    · rw [hframe (L.D (B - 2))]
      · rw [hdrail (B - 2) (by omega), hterm.2.2.1 (B - 2) (by omega)]
        exact payloadBit_top_false B u v sigma hdomain
      · exact sep_D_work L B hn (reg_mem L.D B (B - 2) (by omega))
          (by simp [workSites])
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 2) (by omega))
          (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 2) (by omega))
          (by simp [workSites, hs]) rfl
    · rw [hframe (L.D (B - 1))]
      · exact hsig
      · exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
          (by simp [workSites])
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
          (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
          (by simp [workSites, hs]) rfl
    · apply (regValue_zero (reg L.S B) out.basis).mpr
      intro q hq
      simp only [reg, List.mem_map, List.mem_range] at hq
      rcases hq with ⟨i, hi, rfl⟩
      rw [hframe (L.S i)]
      · by_cases hi0 : i = 0
        · simpa [hi0] using hs0
        by_cases hitop : i = B - 1
        · simpa [hitop] using hstop
        · have hj : B - 2 - i < B - 2 := by omega
          have heq : B - 2 - (B - 2 - i) = i := by omega
          rw [← heq, hsrail (B - 2 - i) hj,
            hterm.2.2.2 (B - 2 - i) hj]
      · exact sep_S_rest L B hn (reg_mem L.S B i hi) (by simp [workSites])
      · intro hs
        exact sep_S_rest L B hn (reg_mem L.S B i hi)
          (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_S_rest L B hn (reg_mem L.S B i hi)
          (by simp [workSites, hs]) rfl
    · intro q hq
      have hcases : q ∈ reg L.C (B - 2) ∨ q = L.z ∨ q = L.t ∨
          q ∈ (lowDecoder L B).sites ∨ q ∈ (highDecoder L B).sites := by
        simp only [List.mem_append, List.mem_cons, List.not_mem_nil,
          or_false] at hq
        tauto
      rcases hcases with hq | hq | hq | hq | hq
      · rw [hframe q]
        · exact hcarry q hq
        · exact sep_C_rest L B hn hq (by simp)
        · intro hs
          exact sep_C_rest L B hn hq (by simp [hs]) rfl
        · intro hs
          exact sep_C_rest L B hn hq (by simp [hs]) rfl
      · subst q
        have hzLow : L.z ∉ (lowDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_left (highDecoder L B).sites hs) rfl
        have hzHigh : L.z ∉ (highDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right (lowDecoder L B).sites hs) rfl
        rw [hlFrame L.z hzLow, hhFrame L.z hzHigh, hzrun]
        simp [writeBit, Function.update]
      · subst q
        have htLow : L.t ∉ (lowDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_left (highDecoder L B).sites hs) rfl
        have htHigh : L.t ∉ (highDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right (lowDecoder L B).sites hs) rfl
        rw [hframe L.t (Ne.symm (sep_z_t L B hn)) htLow htHigh]
        exact ht
      · rw [hlerase]
        simp [hq]
      · rw [hlFrame q]
        · rw [hherase]
          simp [hq]
        · intro hl
          exact sep_low_high L B hn hl hq rfl

def generatedPackA (L : Layout) (B : Nat) : Program :=
  let ld := lowDecoder L B
  let hd := highDecoder L B
  cxInto (L.D (B - 1)) (reg L.D (B - 1)) ++
  xOnA (reg L.S B) ++ generatedPackAdderA L B ++ xOnA (reg L.S B) ++
  [.X (L.S 0)] ++ [.X L.z] ++
  decoderInit ld (lowBits L B) ++ decoderInit hd (highBits L B) ++
  packStep L B (B - 2) ++
  ((List.range (B - 2)).reverse.flatMap (packStep L B)) ++
  [.measureX L.z [] [.CZ (outAt hd 0 L.z) (outAt ld 0 L.z)]] ++
  eraseDecoderA hd ++ eraseDecoderA ld

theorem pack_eq_init_first_finalizeA (L : Layout) (B : Nat) :
    pack L B = packInitA L B ++
      (packFirstStep L B ++
        (List.range (B - 2)).reverse.flatMap (packStep L B) ++ packFinalizeA L B) := by
  simp [pack, packInitA, packArithmeticA, packFinalizeA, List.append_assoc]
  rfl

theorem pack_run_core_finalizeA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CodecInput L B u v sigma s.basis) :
    run (pack L B) m s = run (packSweepCoreA L B ++ packFinalizeA L B) m s := by
  have hi := packInit_correctA L B u v sigma hd hn s
    (m.take (measurementCount (packInitA L B))) hc
  have hz : (run (packInitA L B)
      (m.take (measurementCount (packInitA L B))) s).basis L.z = true := hi.2.2.2.1
  rw [pack_eq_init_first_finalizeA]
  have he : packSweepCoreA L B ++ packFinalizeA L B = packInitA L B ++
      (packStep L B (B - 2) ++
        ((List.range (B - 2)).reverse.flatMap (packStep L B) ++ packFinalizeA L B)) := by
    simp only [packSweepCoreA, packSweepProgramA_eq_generated L B hd.1,
      List.append_assoc]
  rw [he]
  conv_lhs => rw [run_append]
  conv_rhs => rw [run_append]
  simpa only [List.append_assoc] using
    packFirstStep_run_suffix L B
      ((List.range (B - 2)).reverse.flatMap (packStep L B) ++ packFinalizeA L B)
      _ _ hz

set_option maxHeartbeats 1200000 in
theorem pack_spec (L : Layout) (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (s : State) (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    (run (pack L B) m s).phase = s.phase ∧
      CompactCode L B u v sigma (run (pack L B) m s).basis := by
  let pc := packSweepCoreA L B
  let pf := packFinalizeA L B
  let mc := m.take (measurementCount pc)
  let mf := m.drop (measurementCount pc)
  let mid := run pc mc s
  let out := run pf mf mid
  have hcore := packSweepCore_correctA L B u v sigma hdomain hn s mc hc
  change mid.phase = s.phase ∧ ∃ fin,
    PackSweepInvariant B u v sigma 0 fin ∧
    RealizesUnpackSweep L B fin mid.basis ∧
    mid.basis (L.D (B - 1)) = sigma ∧
    mid.basis (L.S 0) = false ∧
    mid.basis (L.S (B - 1)) = false ∧
    (∀ q ∈ reg L.C (B - 2), mid.basis q = false) at hcore
  rcases hcore.2 with ⟨fin, hinv, hreal, hsig, hs0, hstop, hcarry⟩
  have hfinal := packFinalize_correctA L B u v sigma hdomain hn fin mid mf
    hinv hreal hsig hs0 hstop hcarry
  change out.phase = mid.phase ∧ CompactCode L B u v sigma out.basis at hfinal
  have hrun : run (pack L B) m s = out := by
    rw [pack_run_core_finalizeA L B u v sigma hdomain hn s m hc]
    simp only [run_append, pc, pf, mc, mf, mid, out]
  rw [hrun]
  exact ⟨hfinal.1.trans hcore.1, hfinal.2⟩

theorem pack_handoff (L : Layout) (B : Nat) :
    ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
      ∀ s m, CodecInput L B u v sigma s.basis →
        (run (pack L B) m s).phase = s.phase ∧
        CompactCode L B u v sigma (run (pack L B) m s).basis := by
  intro u v sigma hdomain hn s m hc
  exact pack_spec L B u v sigma hdomain hn s m hc

theorem functionalSpecA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : FunctionalSpec L B := by
  exact functionalSpec_of_pack L B hB hn (pack_handoff L B)

end ECDSAAdd.Entrant.StairCodec.PackA
end Merge_StairCodecPackA_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanTopGeneric_at_StairSideA` -/
section Merge_StairDivLoanTopGeneric_at_StairSideA

/-!
# Generic run facts for the division-endpoint loan window (LT15)

* `run_basis_xOnly`: a wire targeted only by `X` gates ends flipped by the
  parity of those gates (any state, any record).
* `run_basis_untouched`, `run_basis_endsCleared`: untouched wires keep their
  value; a wire whose last write is a measurement ends at `false`.
* `run_basis_records`: the basis part of a run never depends on the record.
* `run_shift`: a global phase flip commutes with `run`.
* `tapeFree_middle`: if `A ++ (B ++ C)` is record-independent from `s`, then
  `B` is record-independent from every state `run A a s`.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairDivLoanTop

open ECDSAAdd

/-- Target wire of an instruction. -/
def target : Instr → Wire
  | .X t => t
  | .CX _ t => t
  | .CCX _ _ t => t
  | .measureX t _ _ => t

def isXOn (q : Wire) : Instr → Bool
  | .X t => t == q
  | _ => false

def hitsNonX (q : Wire) : Instr → Bool
  | .X _ => false
  | .CX _ t => t == q
  | .CCX _ _ t => t == q
  | .measureX t _ _ => t == q

def isMeasureOn (q : Wire) : Instr → Bool
  | .measureX t _ _ => t == q
  | _ => false

def xParity (q : Wire) : Program → Bool
  | [] => false
  | i :: P => isXOn q i ^^ xParity q P

def untouched (q : Wire) (P : Program) : Bool := P.all (fun i => !(target i == q))

def endsCleared (q : Wire) : Program → Bool
  | [] => false
  | i :: P => endsCleared q P || (isMeasureOn q i && untouched q P)

theorem xor_rc (a b c : Bool) : ((a ^^ b) ^^ c) = ((a ^^ c) ^^ b) := by
  cases a <;> cases b <;> cases c <;> rfl

theorem run_basis_xOnly (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    P.all (fun i => !hitsNonX q i) = true →
      (run P m s).basis q = (s.basis q ^^ xParity q P) := by
  intro P
  induction P with
  | nil =>
      intro m s _
      simp [run, xParity]
  | cons i P ih =>
      intro m s h
      simp only [List.all_cons, Bool.and_eq_true] at h
      obtain ⟨hi, hP⟩ := h
      cases i with
      | X t =>
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          by_cases e : t = q
          · rw [e]
            simp only [writeBit, Function.update_self, beq_self_eq_true]
            cases s.basis q <;> cases xParity q P <;> rfl
          · have hb : (t == q) = false := by simp [e]
            simp only [writeBit, Function.update_of_ne (Ne.symm e), hb]
            cases s.basis q <;> cases xParity q P <;> rfl
      | CX c t =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl
      | CCX a1 a2 t =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl
      | measureX t c0 c1 =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [measureAndCorrect, correct_basis, writeBit,
            Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl

theorem run_basis_untouched (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    untouched q P = true → (run P m s).basis q = s.basis q := by
  intro P
  induction P with
  | nil => intro m s _; rfl
  | cons i P ih =>
      intro m s h
      simp only [untouched, List.all_cons, Bool.and_eq_true] at h
      obtain ⟨hi, hP⟩ := h
      have hP' : untouched q P = true := hP
      cases i with
      | X t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | CX c t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | CCX a1 a2 t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | measureX t c0 c1 =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [measureAndCorrect, correct_basis, writeBit,
            Function.update_of_ne (Ne.symm e)]

theorem run_basis_endsCleared (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    endsCleared q P = true → (run P m s).basis q = false := by
  intro P
  induction P with
  | nil => intro m s h; simp [endsCleared] at h
  | cons i P ih =>
      intro m s h
      simp only [endsCleared, Bool.or_eq_true, Bool.and_eq_true] at h
      rcases h with h | ⟨hm, hu⟩
      · cases i <;> simp only [run] <;> exact ih _ _ h
      · cases i with
        | X t => simp [isMeasureOn] at hm
        | CX c t => simp [isMeasureOn] at hm
        | CCX a1 a2 t => simp [isMeasureOn] at hm
        | measureX t c0 c1 =>
            have e : t = q := by simpa [isMeasureOn] using hm
            subst e
            simp only [run]
            rw [run_basis_untouched _ P _ _ hu]
            simp [measureAndCorrect, writeBit]


theorem correct_shift (cs : List Correction) : ∀ (p b : Bool) (x : BasisState),
    correct cs ⟨p ^^ b, x⟩ = ⟨(correct cs ⟨p, x⟩).phase ^^ b, (correct cs ⟨p, x⟩).basis⟩ := by
  induction cs with
  | nil => intro p b x; rfl
  | cons c cs ih =>
      intro p b x
      cases c with
      | Z t =>
          show correct cs ⟨(p ^^ b) ^^ x t, x⟩ =
            ⟨(correct cs ⟨p ^^ x t, x⟩).phase ^^ b, (correct cs ⟨p ^^ x t, x⟩).basis⟩
          rw [xor_rc p b (x t)]
          exact ih (p ^^ x t) b x
      | CZ a1 a2 =>
          show correct cs ⟨(p ^^ b) ^^ (x a1 && x a2), x⟩ =
            ⟨(correct cs ⟨p ^^ (x a1 && x a2), x⟩).phase ^^ b,
              (correct cs ⟨p ^^ (x a1 && x a2), x⟩).basis⟩
          rw [xor_rc p b (x a1 && x a2)]
          exact ih (p ^^ (x a1 && x a2)) b x

theorem mac_shift (t : Wire) (c0 c1 : List Correction) (r p b : Bool) (x : BasisState) :
    measureAndCorrect t c0 c1 r ⟨p ^^ b, x⟩ =
      ⟨(measureAndCorrect t c0 c1 r ⟨p, x⟩).phase ^^ b,
        (measureAndCorrect t c0 c1 r ⟨p, x⟩).basis⟩ := by
  show correct (if r then c1 else c0) ⟨(p ^^ b) ^^ (r && x t), writeBit x t false⟩ =
    ⟨(correct (if r then c1 else c0) ⟨p ^^ (r && x t), writeBit x t false⟩).phase ^^ b,
      (correct (if r then c1 else c0) ⟨p ^^ (r && x t), writeBit x t false⟩).basis⟩
  rw [xor_rc p b (r && x t)]
  exact correct_shift _ _ b _

theorem run_shift (P : Program) : ∀ (m : List Bool) (p b : Bool) (x : BasisState),
    run P m ⟨p ^^ b, x⟩ = ⟨(run P m ⟨p, x⟩).phase ^^ b, (run P m ⟨p, x⟩).basis⟩ := by
  induction P with
  | nil => intro m p b x; rfl
  | cons i P ih =>
      intro m p b x
      cases i with
      | X t => simp only [run]; exact ih m p b (writeBit x t (!x t))
      | CX c t => simp only [run]; exact ih m p b (writeBit x t (x t ^^ x c))
      | CCX a1 a2 t => simp only [run]; exact ih m p b (writeBit x t (x t ^^ (x a1 && x a2)))
      | measureX t c0 c1 =>
          simp only [run]
          rw [mac_shift]
          exact ih _ _ b _

theorem run_pad (P : Program) : ∀ (a : List Bool) (n : Nat) (s : State),
    run P (a ++ List.replicate n false) s = run P a s := by
  induction P with
  | nil => intro a n s; rfl
  | cons i P ih =>
      intro a n s
      cases i with
      | X t => simp only [run]; exact ih a n _
      | CX c t => simp only [run]; exact ih a n _
      | CCX a1 a2 t => simp only [run]; exact ih a n _
      | measureX t c0 c1 =>
          cases a with
          | nil =>
              cases n with
              | zero => rfl
              | succ n =>
                  simp only [run]
                  exact ih [] n _
          | cons x a =>
              simp only [run]
              exact ih a n _

/-- A record of exactly `k` entries that runs like `l`. -/
def fixLen (l : List Bool) (k : Nat) : List Bool := (l ++ List.replicate k false).take k

theorem fixLen_length (l : List Bool) (k : Nat) : (fixLen l k).length = k := by
  simp only [fixLen, List.length_take, List.length_append, List.length_replicate]
  omega

theorem run_fixLen (P : Program) (l : List Bool) (s : State) :
    run P (fixLen l (measurementCount P)) s = run P l s := by
  unfold fixLen
  rw [run_take, run_pad]

/-- Record independence of a middle block, from record independence of the whole. -/
theorem tapeFree_middle (A B C : Program) (s : State)
    (whole : ∀ m n, run (A ++ (B ++ C)) m s = run (A ++ (B ++ C)) n s)
    (a r r' : List Bool) :
    run B r (run A a s) = run B r' (run A a s) := by
  have key : ∀ r : List Bool,
      run (A ++ (B ++ C))
        (fixLen a (measurementCount A) ++ (fixLen r (measurementCount B) ++ [])) s =
        run C [] (run B r (run A a s)) := by
    intro r
    rw [run_append, List.take_left' (fixLen_length _ _), List.drop_left' (fixLen_length _ _),
      run_fixLen, run_append, List.take_left' (fixLen_length _ _),
      List.drop_left' (fixLen_length _ _), run_fixLen]
  have hb := run_basis_records B r r' (run A a s) (run A a s) rfl
  have hc := whole (fixLen a (measurementCount A) ++ (fixLen r (measurementCount B) ++ []))
    (fixLen a (measurementCount A) ++ (fixLen r' (measurementCount B) ++ []))
  rw [key r, key r'] at hc
  apply State.extensionality _ _ _ hb
  generalize run B r (run A a s) = Y at hc hb ⊢
  generalize run B r' (run A a s) = Y' at hc hb ⊢
  obtain ⟨p, x⟩ := Y
  obtain ⟨p', x'⟩ := Y'
  simp only at hb ⊢
  rw [← hb] at hc
  cases p <;> cases p'
  · rfl
  · exfalso
    have sh : run C [] ⟨true, x⟩ =
        ⟨(run C [] ⟨false, x⟩).phase ^^ true, (run C [] ⟨false, x⟩).basis⟩ :=
      run_shift C [] false true x
    have ph := congrArg State.phase (hc.trans sh)
    revert ph
    cases (run C [] ⟨false, x⟩).phase <;> simp
  · exfalso
    have sh : run C [] ⟨true, x⟩ =
        ⟨(run C [] ⟨false, x⟩).phase ^^ true, (run C [] ⟨false, x⟩).basis⟩ :=
      run_shift C [] false true x
    have ph := congrArg State.phase (hc.symm.trans sh)
    revert ph
    cases (run C [] ⟨false, x⟩).phase <;> simp
  · rfl

/-- Record independence of the whole from `run_basis_records` plus a fixed phase. -/
theorem tapeFree_of_phase (P : Program) (s : State)
    (phase : ∀ m, (run P m s).phase = s.phase) (m n : List Bool) :
    run P m s = run P n s :=
  State.extensionality _ _ ((phase m).trans (phase n).symm)
    (run_basis_records P m n s s rfl)

/-! ## K1 (replay budget): operand lists and bit masks for static program checks

`decide (q ∉ Instr.wires i)` builds a `Finset` per instruction (and per wire `q`); the checks
below test list operands once per instruction and wire sets as one bit mask per program. -/

/-- Operands of a correction list, as a list. -/
def k1corrList : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: k1corrList cs
  | .CZ a b :: cs => a :: b :: k1corrList cs

/-- Operands of one instruction, as a list. -/
def k1wl : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (k1corrList c₀ ++ k1corrList c₁)

theorem k1_mem_corrList (q : Wire) :
    ∀ cs : List Correction, q ∈ correctionWires cs → q ∈ k1corrList cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k1corrList, List.mem_cons]
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (k1_mem_corrList q cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      simp only [k1corrList, List.mem_cons]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (k1_mem_corrList q cs h))

theorem k1_mem_wl (q : Wire) (i : Instr) (h : q ∈ Instr.wires i) : q ∈ k1wl i := by
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_singleton]
      exact h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | measureX t c₀ c₁ =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.mem_append]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl (k1_mem_corrList q c₀ h))
      · exact Or.inr (Or.inr (k1_mem_corrList q c₁ h))

def k1listMask : List Wire → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| k1listMask xs

theorem k1_testBit_listMask : ∀ (l : List Wire) (q : Wire),
    (k1listMask l).testBit q = decide (q ∈ l)
  | [], q => by simp [k1listMask]
  | x :: xs, q => by
    simp only [k1listMask, Nat.testBit_or, k1_testBit_listMask xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm

/-- All operands of a program, as one bit mask. -/
def k1progMask : Program → Nat
  | [] => 0
  | i :: P => k1listMask (k1wl i) ||| k1progMask P

theorem k1_all_not_mem_of_mask (P : Program) (q : Wire) (h : (k1progMask P).testBit q = false) :
    P.all (fun i => decide (q ∉ Instr.wires i)) = true := by
  induction P with
  | nil => rfl
  | cons i P ih =>
    simp only [k1progMask, Nat.testBit_or, Bool.or_eq_false_iff] at h
    have h1 := h.1
    rw [k1_testBit_listMask] at h1
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨fun hm => by simp [k1_mem_wl q i hm] at h1, ih h.2⟩


/-- Non-`X` targets of a program, as one bit mask. -/
def k1hitBit : Instr → Nat
  | .X _ => 0
  | .CX _ t => 2 ^ t
  | .CCX _ _ t => 2 ^ t
  | .measureX t _ _ => 2 ^ t

def k1hitMask : Program → Nat
  | [] => 0
  | i :: P => k1hitBit i ||| k1hitMask P

/-- `X` targets of a program, XOR-ed into one bit mask. -/
def k1xBit : Instr → Nat
  | .X t => 2 ^ t
  | _ => 0

def k1xMask : Program → Nat
  | [] => 0
  | i :: P => k1xBit i ^^^ k1xMask P

theorem k1_testBit_hitBit (q : Wire) (i : Instr) : (k1hitBit i).testBit q = hitsNonX q i := by
  cases i <;> simp only [k1hitBit, hitsNonX, Nat.testBit_two_pow, Nat.zero_testBit] <;>
    exact Bool.eq_iff_iff.mpr (by simp)

theorem k1_testBit_xBit (q : Wire) (i : Instr) : (k1xBit i).testBit q = isXOn q i := by
  cases i with
  | X t =>
    simp only [k1xBit, isXOn, Nat.testBit_two_pow]
    exact Bool.eq_iff_iff.mpr (by simp)
  | CX c t => simp only [k1xBit, isXOn, Nat.zero_testBit]
  | CCX a c t => simp only [k1xBit, isXOn, Nat.zero_testBit]
  | measureX t c₀ c₁ => simp only [k1xBit, isXOn, Nat.zero_testBit]

theorem k1_all_hits (q : Wire) : ∀ P : Program,
    P.all (fun i => !hitsNonX q i) = !(k1hitMask P).testBit q
  | [] => by simp [k1hitMask]
  | i :: P => by
    simp only [List.all_cons, k1hitMask, Nat.testBit_or, k1_testBit_hitBit, k1_all_hits q P,
      Bool.not_or]

theorem k1_xParity (q : Wire) : ∀ P : Program, xParity q P = (k1xMask P).testBit q
  | [] => by simp [xParity, k1xMask]
  | i :: P => by
    simp only [xParity, k1xMask, Nat.testBit_xor, k1_testBit_xBit, k1_xParity q P]

end ECDSAAdd.Entrant.StairDivLoanTop
end Merge_StairDivLoanTopGeneric_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3ZT_at_StairSideA` -/
section Merge_StairField13V3ZT_at_StairSideA

/-!
# Field 13 on v3: static zero tracker (LT29), generic and early

`zt w b P` is a sound static zero tracker for one wire: starting from the
status `b` ("`w` is known to be zero"), the last instruction of `P` that
writes `w` decides the status (a `measureX` on `w` resets `w` to `0` for every
input and every tape; any other write makes it unknown).  The tracker is
tail recursive with the status forced at every write, so kernel evaluation on
packet-sized programs stays shallow.  Composition lemmas (append, renaming,
packet sequences, support) let large programs be split into small checked
pieces; no concrete program run is evaluated anywhere.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic















/-! ## Single-pass tracker for the wires of a window `[lo, lo + width)`

The statuses are the bits of a natural number; every update is forced
(`Nat.beq m m`), so the kernel evaluates the tracker with constant depth. -/










/-! ## LT49 (replay budget): structural reductions of `ztAll` checks -/


/-- Only a resetting suffix needs to be checked (the prefix is arbitrary). -/
theorem ztAll_of_suffix (lo width : Nat) (b : Bool) (ws : List Wire) (X Y : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) (h : ztAll lo width false ws Y = true) :
    ztAll lo width b ws (X ++ Y) = true :=
  ztAll_of_zt lo width b ws _ hr (fun w hw => by
    rw [zt_append]
    exact zt_mono w Y _ (zt_of_ztAll lo width false ws Y hr h w hw))


/-! ## K1 (replay budget): composition lemmas for structural `ztAll` checks

