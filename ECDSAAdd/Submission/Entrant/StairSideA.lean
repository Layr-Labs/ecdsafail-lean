namespace K4DT

def corrOK (c : Wire → Bool) : List Correction → Bool
  | [] => true
  | .Z t :: cs => c t && corrOK c cs
  | .CZ a b :: cs => c a && c b && corrOK c cs

def instrOK (c : Wire → Bool) : Instr → Bool
  | .X t => c t
  | .CX a t => c a && c t
  | .CCX a b t => c a && c b && c t
  | .measureX t c0 c1 => c t && corrOK c c0 && corrOK c c1

/-- Every wire of every instruction of `P` satisfies `c`. -/
def allK (c : Wire → Bool) (P : Program) : Bool := P.all (instrOK c)

theorem corrOK_sound (c : Wire → Bool) :
    ∀ (cs : List Correction), corrOK c cs = true → ∀ q ∈ correctionWires cs, c q = true
  | [], _, q, hq => by simp [correctionWires] at hq
  | .Z t :: cs, h, q, hq => by
    simp only [corrOK, Bool.and_eq_true] at h
    simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with rfl | hq
    · exact h.1
    · exact corrOK_sound c cs h.2 q hq
  | .CZ a b :: cs, h, q, hq => by
    simp only [corrOK, Bool.and_eq_true] at h
    simp only [correctionWires, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with (rfl | rfl) | hq
    · exact h.1.1
    · exact h.1.2
    · exact corrOK_sound c cs h.2 q hq

theorem instrOK_sound (c : Wire → Bool) (i : Instr) (h : instrOK c i = true) :
    ∀ q ∈ i.wires, c q = true := by
  intro q hq
  cases i with
  | X t =>
    simp only [Instr.wires, Finset.mem_singleton] at hq
    subst hq
    exact h
  | CX a t =>
    simp only [instrOK, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact h.1
    · exact h.2
  | CCX a b t =>
    simp only [instrOK, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl | rfl
    · exact h.1.1
    · exact h.1.2
    · exact h.2
  | measureX t c0 c1 =>
    simp only [instrOK, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with (rfl | hq) | hq
    · exact h.1.1
    · exact corrOK_sound c c0 h.1.2 q hq
    · exact corrOK_sound c c1 h.2 q hq

theorem allK_sound (c : Wire → Bool) :
    ∀ (P : Program), allK c P = true → ∀ q ∈ wires P, c q = true
  | [], _, q, hq => by simp [wires] at hq
  | i :: P, h, q, hq => by
    simp only [allK, List.all_cons, Bool.and_eq_true] at h
    simp only [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · exact instrOK_sound c i h.1 q hq
    · exact allK_sound c P h.2 q hq

/-- Support from one pass, for a variable program. -/
theorem sub_of_allK {P : Program} {S : List Wire} {c : Wire → Bool} (hc : ∀ q, c q = true → q ∈ S)
    (h : allK c P = true) : wires P ⊆ S.toFinset :=
  fun q hq => List.mem_toFinset.mpr (hc q (allK_sound c P h q hq))

end K4DT

/-- Record labels of `Six505.cand6` (before `OB5.sig 510`). -/
def cand6Sites : List Wire :=
  (List.range' 504 10).map base ++ (List.range' 770 14).map base ++
    (List.range' 1533 6).map base

/-- K4-D: `cand6Sites` = `[520, 530) ∪ [786, 800) ∪ [1549, 1555)` as an interval test. -/
def K4DT.c6B (q : Nat) : Bool :=
  (Nat.ble 520 q && Nat.blt q 530) || (Nat.ble 786 q && Nat.blt q 800) || (Nat.ble 1549 q && Nat.blt q 1555)

theorem K4DT.c6_mem (q : Nat) (h : K4DT.c6B q = true) : q ∈ cand6Sites := by
  simp only [K4DT.c6B, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq] at h
  unfold cand6Sites
  simp only [List.mem_append, List.mem_map, List.mem_range'_1]
  rcases h with (⟨h1, h2⟩ | ⟨h1, h2⟩) | ⟨h1, h2⟩
  · exact Or.inl (Or.inl ⟨q - 16, ⟨by omega, by omega⟩, by simp only [base]; omega⟩)
  · exact Or.inl (Or.inr ⟨q - 16, ⟨by omega, by omega⟩, by simp only [base]; omega⟩)
  · exact Or.inr ⟨q - 16, ⟨by omega, by omega⟩, by simp only [base]; omega⟩






/-! ## Support and avoidance -/

/-- The 39 field-tail sites of `forwardTerminalV3`. -/
def forwardSites : List Wire :=
  (List.range' 500 11).map base ++ [base 2409, base 512, base 513] ++
    (List.range 14).map StairPhysicalLayout.bSite ++ [base 1797] ++
      (List.range' 1544 10).map base

/-- The 36 field-tail sites of `reverseTerminalV3`. -/
def reverseSites : List Wire :=
  (List.range' 505 6).map base ++ [base 2409, base 512, base 513, base 514] ++
    (List.range 20).map StairPhysicalLayout.bSite ++ [base 1797] ++
      (List.range' 1544 5).map base

/-- The kernel-level caller domain (`StairPhysicalPrimitives.callerList`). -/
def callerList : List Wire :=
  (List.range' 0 2314 ++ [2400, 2409, 2410, 2411]).map base

/-- Static facts of a field-tail site: inside the final arena, not an old
omission, not one of the 44 new omissions (all under
`place = kernelPlace ∘ fieldPlace`), not one of the 44 exclusive roles (raw and
under `fieldPlace`), and in the caller domain under `fieldPlace`. -/
abbrev SiteOK (q : Wire) : Prop :=
  StairPhysicalLayout.Good q ∧ q ∉ StairPhysicalInventory.exclusiveSites ∧
    StairOuterPlacement.fieldPlace q ∉ StairPhysicalInventory.exclusiveSites ∧
    StairOuterPlacement.fieldPlace q ∈ callerList

/-- Per record wire `x`: off the rail-`b` bits the relabelled wire has the
record's kernel image (`fieldPlace ∘ terminalPerm = phaseHost`), the relabelled
wire is a good site, and it is listed in `S`. -/
abbrev TermOK (S : List Wire) (x : Wire) : Prop :=
  (x ∉ terminalRails →
      StairOuterPlacement.fieldPlace (terminalPerm x) = Rolling1588Lifetime.phaseHost x) ∧
    SiteOK (terminalPerm x) ∧ terminalPerm x ∈ S

/-! ## LT50 (replay budget): kernel-fast form of `TermOK`

`decide` on `TermOK` walked the pool for every placement and scanned the 2,318-element caller list
and the 1,600-element arena (≈ 0.3 s per wire).  `termOKB` uses the closed-form placements of
`StairPlaceFast`, interval tests and literal exchanges; `termOK_of_B` is its soundness. -/

/-- `terminalPerm` as literal exchanges, applied first pair first. -/
def termPermB (l : List (Wire × Wire)) (x : Nat) : Nat :=
  l.foldl (fun y p => StairPlaceFast.swB p.1 p.2 y) x

theorem foldr_swaps_apply (l : List (Wire × Wire)) (x : Wire) :
    (l.foldr (fun p e => (Equiv.swap p.1 p.2).trans e) (Equiv.refl Wire)) x = termPermB l x := by
  induction l generalizing x with
  | nil => rfl
  | cons p ps ih =>
    rw [List.foldr_cons, Equiv.trans_apply, ih, StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq]
    all_goals simp only [termPermB, List.foldl_cons]

theorem terminalPerm_eqB (x : Wire) : terminalPerm x = termPermB terminalSwaps x := by
  unfold terminalPerm
  exact foldr_swaps_apply terminalSwaps x

def railsB (x : Nat) : Bool := decide (786 ≤ x) && decide (x < 806)

def exclB (v : Nat) : Bool :=
  (decide (736 ≤ v) && decide (v < 776)) || (decide (777 ≤ v) && decide (v < 781))

def callB (v : Nat) : Bool :=
  (decide (16 ≤ v) && decide (v < 2330)) || v == 2416 || v == 2425 || v == 2426 || v == 2427

def siteOKB (q : Nat) : Bool :=
  StairPhysicalLayout.goodB (StairPlaceFast.outerPlaceB q) && !(exclB q) &&
    !(exclB (StairPlaceFast.fieldPlaceB q)) && callB (StairPlaceFast.fieldPlaceB q)

def termOKB (S : List Wire) (x : Nat) : Bool :=
  (railsB x || StairPlaceFast.fieldPlaceB (termPermB terminalSwaps x) == StairPlaceFast.phaseHostB x) &&
    siteOKB (termPermB terminalSwaps x) && S.contains (termPermB terminalSwaps x)

theorem mem_rails_of {x : Nat} (h : railsB x = true) : x ∈ terminalRails := by
  simp only [railsB, Bool.and_eq_true, decide_eq_true_eq] at h
  unfold terminalRails
  rw [List.mem_map]
  exact ⟨x - 786, List.mem_range.mpr (by omega), by simp only [base]; omega⟩

theorem not_excl_of {v : Nat} (h : exclB v = false) :
    v ∉ StairPhysicalInventory.exclusiveSites := by
  rw [StairPhysicalInventory.exclusiveSites_eq]
  simp only [exclB, Bool.or_eq_false_iff, Bool.and_eq_false_iff, decide_eq_false_iff_not] at h
  intro hm
  obtain ⟨i, hi, e⟩ := List.mem_map.mp hm
  simp only [List.mem_append, List.mem_range'_1] at hi
  simp only [base] at e
  omega

theorem mem_callerT_of {v : Nat} (h : callB v = true) : v ∈ callerList := by
  unfold callerList
  rw [List.mem_map]
  simp only [callB, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  rcases h with (((⟨h1, h2⟩ | h3) | h4) | h5) | h6
  · exact ⟨v - 16, List.mem_append_left _ (List.mem_range'_1.mpr ⟨by omega, by omega⟩),
      by simp only [base]; omega⟩
  · exact ⟨2400, List.mem_append_right _ (by simp), by simp only [base]; omega⟩
  · exact ⟨2409, List.mem_append_right _ (by simp), by simp only [base]; omega⟩
  · exact ⟨2410, List.mem_append_right _ (by simp), by simp only [base]; omega⟩
  · exact ⟨2411, List.mem_append_right _ (by simp), by simp only [base]; omega⟩

theorem termOK_of_B {S : List Wire} {x : Wire} (h : termOKB S x = true) : TermOK S x := by
  unfold termOKB at h
  rw [Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨⟨hr, hs⟩, hm⟩ := h
  unfold siteOKB at hs
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at hs
  obtain ⟨⟨⟨hg, he1⟩, he2⟩, hc⟩ := hs
  have ep : terminalPerm x = termPermB terminalSwaps x := terminalPerm_eqB x
  have ef : StairOuterPlacement.fieldPlace (terminalPerm x) =
      StairPlaceFast.fieldPlaceB (termPermB terminalSwaps x) := by
    rw [ep, StairPlaceFast.fieldPlace_eqB]
  have hp : StairPhysicalInventory.place (terminalPerm x) =
      StairPlaceFast.outerPlaceB (termPermB terminalSwaps x) := by
    rw [ep, show StairPhysicalInventory.place (termPermB terminalSwaps x) =
      StairOuterPlacement.outerPlace (termPermB terminalSwaps x) from rfl, StairPlaceFast.outerPlace_eqB]
  have g := StairPhysicalLayout.good_of_goodB _ hg
  rw [← hp] at g
  refine ⟨fun hx => ?_, ⟨g, ?_, ?_, ?_⟩, ?_⟩
  · rw [ef, StairPlaceFast.phaseHost_eqB]
    rcases (Bool.or_eq_true _ _).mp hr with hr | hr
    · exact absurd (mem_rails_of hr) hx
    · exact beq_iff_eq.mp hr
  · rw [ep]
    exact not_excl_of (Bool.not_eq_true' _ |>.mp he1)
  · rw [ef]
    exact not_excl_of (Bool.not_eq_true' _ |>.mp he2)
  · rw [ef]
    exact mem_callerT_of hc
  · rw [ep]
    exact List.contains_iff_mem.mp hm





theorem siteOK_spec {q : Wire} (h : SiteOK q) :
    StairPhysicalInventory.place q ∈ StairHoleSupport.recordArena ∧
      StairPhysicalInventory.place q ∉ StairHoleSupport.oldHoles ∧
      StairPhysicalInventory.place q ∉ StairPhysicalInventory.physicalHoles ∧
      q ∉ StairPhysicalInventory.exclusiveSites ∧
      StairOuterPlacement.fieldPlace q ∉ StairPhysicalInventory.exclusiveSites ∧
      StairOuterPlacement.fieldPlace q ∈ callerList := by
  rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq,
    StairPhysicalLayout.physicalHoles_eq_nat]
  exact ⟨h.1.1, h.1.2.1, h.1.2.2, h.2.1, h.2.2.1, h.2.2.2⟩



/-! ## Placement of the relabelling -/





/-! ## Run-level transport (the replay form for the field-2 chain) -/



/-- Generic relabelled replay: if the staircase state agrees with a record
state through `f` on the record block's wires, then after the blocks they still
agree through `f` there (for independent tapes), the phase increments agree,
and nothing outside the relabelled support changes. -/
theorem rename_replay (f : Equiv.Perm Wire) (R : Program) (s r : State)
    (m n : List Bool)
    (agree : ∀ q ∈ wires R, s.basis (f q) = r.basis q) :
    (∀ q ∈ wires R,
        (run (renameProgram f R) m s).basis (f q) = (run R n r).basis q) ∧
      (((run (renameProgram f R) m s).phase ^^ s.phase) =
        ((run R m r).phase ^^ r.phase)) ∧
      (∀ q, q ∉ wires (renameProgram f R) →
        (run (renameProgram f R) m s).basis q = s.basis q) := by
  have conj := run_rename f f.injective R m s
  have loc := run_local_increment R (pullState f s) r m agree
  have hb : ∀ q, (run (renameProgram f R) m s).basis (f q) =
      (run R m (pullState f s)).basis q := by
    intro q
    exact congrArg (fun t : State => t.basis q) conj
  have hp : (run (renameProgram f R) m s).phase = (run R m (pullState f s)).phase := by
    have h := congrArg State.phase conj
    exact h
  refine ⟨?_, ?_, ?_⟩
  · intro q hq
    rw [hb q, loc.2 q hq]
    exact congrFun (run_basis_records R r r m n rfl) q
  · rw [hp]
    exact loc.1
  · intro q hq
    exact run_preserves_outside (renameProgram f R) m s q hq



