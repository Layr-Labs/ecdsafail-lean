  have eqDec := CompareDecoder.BoundaryLoan.cellDecoderLoan_run_eq_frame t.basis
    (TerminalGraphEndpoint.clean_decoder base (base 2409) t.basis clean) X Y hend t self
    (m.take (measurementCount CompareDecoder.BoundaryLoan.cellDecoderLoan)) (m.take 514)
  rw [endHalfLoan, run_append, eqDec, InverseEndpointWires.pad_run 507 (base 512) _ _ z512,
    endHalf_true, run_append, k, InverseEndpointWires.pad_run 507 (base 512) _ _ z512]

