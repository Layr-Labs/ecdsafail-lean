theorem v3_pack_physical : ∀ B ∈ StairPhysicalLayout.budgets,
    GatePhysical (StairPhysicalPrimitives.pack B) := by
  -- LT50 (replay budget): the codec part by the generic `StairCodec.pack_physical` on the layout's
  -- `Nodup` (`physicalLayout_nodup`, needed anyway); only the sign extension and the relocation
  -- are evaluated (20.8 s → ≈ 1 s)
  intro B hB
  have hc := StairCodec.pack_physical (StairPhysicalLayout.physicalLayout B) B
    (StairPhysicalPrimitives.budget_three B hB) (StairPhysicalLayout.physicalLayout_nodup B hB)
  rw [StairPhysicalPrimitives.pack]
  refine (gatePhysical_append _ _).mpr ⟨(gatePhysical_append _ _).mpr ⟨?_, hc⟩, ?_⟩
  all_goals
    simp only [StairPhysicalLayout.budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
    all_goals exact CodecBitSliceVerify.physical_of_check _ (by decide +kernel)

theorem v3_unpack_physical : ∀ B ∈ StairPhysicalLayout.budgets,
    GatePhysical (StairPhysicalPrimitives.unpack B) := by
