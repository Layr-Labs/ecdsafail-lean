  | .enter0 => ReducedWindowArchives.enter0
  | .switch0 => ReducedWindowArchives.switch0
  | .leave0 => ReducedWindowArchives.leave0
  | .enter1 => ReducedWindowArchives.enter1
  | .switch1 => ReducedWindowArchives.switch1
  | .leave1 => ReducedWindowArchives.leave1

