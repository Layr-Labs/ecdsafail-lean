  have hsub : 122 ≤ 513 - s := by omega
  have : 61 * 2 ≤ 513 - s := by simpa using hsub
  exact (Nat.le_div_iff_mul_le (by decide : 0 < 2)).mpr this

theorem sb_hi (s : Nat) (hs : 90 ≤ s) : sbP s ≤ 211 := by
