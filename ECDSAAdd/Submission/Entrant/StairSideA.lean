    (firstSlot h divide).Local := by
  have e : firstSlot h divide =
      slot fieldMap StairSchedule.exclusiveRoles (h.firstPacket divide)
        (Rolling1588.placedFirstPacket divide) := by
    simp only [firstSlot, slot, fieldRename_eq]
  rw [e]
  exact slot_local fieldMap fieldMap_injective _ _ _







