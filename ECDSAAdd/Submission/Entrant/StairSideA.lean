/-! ## Finer per-slot form: hosts need only be zero BEFORE the slot

The "after" half of a slot obligation splits into the roles being zero after
the logical piece (the group cleans its scratch roles) and a static fact: the
hosts are not wires of the logical piece. -/

/-- Logical prefix of a piece list before position `j`. -/
def cut (ps : List Piece) (j : Nat) : Program := ((ps.take j).map Piece.L).flatten

theorem cut_succ : ∀ (ps : List Piece) (j : Nat) (hj : j < ps.length),
    cut ps (j + 1) = cut ps j ++ (ps[j]).L
  | [], _, hj => absurd hj (by simp)
  | pc :: ps, 0, _ => by simp [cut]
  | pc :: ps, j + 1, hj => by
    have ih := cut_succ ps j (by simp only [List.length_cons] at hj; omega)
    simp only [cut, List.take_succ_cons, List.map_cons, List.flatten_cons,
      List.getElem_cons_succ] at ih ⊢
    rw [ih, List.append_assoc]


theorem slot_after (pre : State → Prop) (X : Program) (F : Wire → Wire)
    (hF : Function.Injective F) (rs hs : List Wire) (P : Program)
    (before : CutClean pre X ((rs ++ hs).map F))
    (rolesAfter : CutClean pre (X ++ renameProgram F P) (rs.map F))
    (hostsFresh : ∀ q ∈ hs, q ∉ wires P) :
    CutClean pre (X ++ renameProgram F P) ((rs ++ hs).map F) := by
  intro s h0 m q hq
  rw [List.map_append, List.mem_append] at hq
  rcases hq with hq | hq
  · exact rolesAfter s h0 m q hq
  · obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hq
    have nf : F x ∉ wires (renameProgram F P) := by
      rw [renameProgram_support]
      intro hm
      obtain ⟨y, hy, hxy⟩ := Finset.mem_image.mp hm
      exact hostsFresh x hx (hF hxy ▸ hy)
    rw [run_append, run_preserves_outside _ _ _ _ nf]
    exact before s h0 _ (F x) (by
      rw [List.map_append]
      exact List.mem_append_right _ (List.mem_map.mpr ⟨x, hx, rfl⟩))

/-- The three parts of one hosted slot at position `j` of `ps`. -/
structure SlotParts (pre : State → Prop) (ps : List Piece) (j : Nat)
    (rs hs : List Wire) (F : Wire → Wire) (P : Program) : Prop where
  before : CutClean pre (cut ps j) ((rs ++ hs).map F)
  rolesAfter : CutClean pre (cut ps (j + 1)) (rs.map F)
  hostsFresh : ∀ q ∈ hs, q ∉ wires P

theorem slotParts_clean (pre : State → Prop) (ps : List Piece) (j : Nat)
    (hj : j < ps.length) (F : Wire → Wire) (hF : Function.Injective F)
    (rs hs : List Wire) (P : Program) (hpc : ps[j] = slot F rs hs P)
    (c : SlotParts pre ps j rs hs F P) :
    CutClean pre (cut ps j) (ps[j]).moved ∧ CutClean pre (cut ps (j + 1)) (ps[j]).moved := by
  have b := c.before
  have r := c.rolesAfter
  rw [cut_succ ps j hj, hpc] at r ⊢
  exact ⟨b, slot_after pre _ F hF rs hs P b r c.hostsFresh⟩

theorem groupSlot_eq (h : StairHostsSchedule.HostPlan) (divide : Bool)
    (d first count : Nat) : groupSlot h divide d first count =
      slot lowMap (StairSchedule.exclusiveRoles.drop d) (h.group divide d first count)
        (StairSchedule.placedGroups StairConcrete.bestLoans divide d first count) := by
  simp only [groupSlot, slot, lowRename_eq, StairHostsSchedule.hostedGroup]

theorem firstSlot_eq (h : StairHostsSchedule.HostPlan) (divide : Bool) :
    firstSlot h divide = slot fieldMap StairSchedule.exclusiveRoles (h.firstPacket divide)
      (Rolling1588.placedFirstPacket divide) := by
  simp only [firstSlot, slot, fieldRename_eq]








