theorem closing_wires (k : Nat) (q : Wire)
    (hq : q ∈ wires (renameProgram (OB5.sig 511) (Rolling1588.encodeGroup base true k))) :
    q ∈ pk k := by
  rw [renameProgram_support] at hq
  obtain ⟨q0, hq0, rfl⟩ := Finset.mem_image.mp hq
