/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanInversePrefix_at_StairSideA` -/
section Merge_StairLoanInversePrefix_at_StairSideA

/-!
# Record inverse-prefix boundary facts (field 4 support)

Public copies of the record's private inverse-prefix lemmas of
`Q6LifetimeProof` (DeadCarry, module `Q6LifetimeInverse`), renamed with an
`inv` prefix, plus the exact block-entry facts needed by the loaned inverse
blocks: the state before `normalize`, before the comparison chain, before
`unfoldStep`, and before `rawSubTail`, each on the record prefix of
`Q6LifetimeResearch.inverse retired L`.
-/

set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairLoanInverse

section RecordCopies
open Arithmetic BalancedCircuit Arithmetic.BalancedField
open Q6LifetimeProof
attribute [local irreducible] run

def invRecoverProgram (retired : Wire) (L : BalancedCircuit.Layout) : Program :=
  recoverBefore retired L++
    (Q6StructuralCell.exposure L++Q6LifetimeResearch.compare retired false L++
      (Q6StructuralCell.exposure L).reverse)++
    (BalancedCleanup.prepareCompare L.toLayout).reverse

def invPrefixProgram (retired : Wire) (L : BalancedCircuit.Layout) : Program :=
  invRecoverProgram retired L++BiasedInverse.unbiasView L++
    Q6LifetimeResearch.unfoldStep retired L++rotateLeft (BalancedCircuit.rawTarget L)++
    [.CX L.parity L.r0]

theorem inv_append_run (P Q : Program) (m : List Bool) (s : State) :
    run (P++Q) m s=run Q (m.drop (measurementCount P)) (run P m s) := by
  rw [run_append,run_take]

theorem inv_zero_tail_run (P Q : Program) (s : State) (m : List Bool)
    (zero : measurementCount Q=0) :
    run (P++Q) m s=run Q [] (run P m s) := by
  rw [inv_append_run]
  exact FifthCarry.no_records Q zero _ _ []

theorem inv_join_records (P Q : Program) (s : State) (m n : List Bool) :
    ∃records,run (P++Q) records s=run Q n (run P m s) := by
  let headRecords:=(m++List.replicate (measurementCount P) false).take (measurementCount P)
  have headLength:headRecords.length=measurementCount P := by
    simp only [headRecords,List.length_take,List.length_append,List.length_replicate]
    omega
  have headRun:run P headRecords s=run P m s := by
    change run P ((m++List.replicate (measurementCount P) false).take (measurementCount P)) s=_
    rw [run_take,run_pad_false]
  have take:(headRecords++n).take (measurementCount P)=headRecords := by
    rw [List.take_append,headLength,Nat.sub_self,List.take_zero,List.append_nil,
      ←headLength,List.take_length]
  have drop:(headRecords++n).drop (measurementCount P)=n := by
    rw [List.drop_append,headLength,Nat.sub_self,List.drop_zero,
      ←headLength,List.drop_length,List.nil_append]
  refine ⟨headRecords++n,?_⟩
  rw [run_append,take,drop,headRun]

theorem inv_unbias_zero (L : BalancedCircuit.Layout) :
    measurementCount (BiasedInverse.unbiasView L)=0 := by
  have signZero:measurementCount (BalancedCleanup.prepareSign L.toLayout)=0 := by
    simp only [BalancedCleanup.prepareSign,measurementCount_append,
      (signComplement_counts L.lower L.r).2]
    rfl
  simp only [BiasedInverse.unbiasView,measurementCount_append,measurementCount_reverse,signZero]
  rfl

theorem inv_recover_eq_old (retired : Wire) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup)
    (member : retired∈(L.carry.take 254).drop 1)
    (R : Int) (hr : Centered R) (s : State) (m : List Bool)
    (hR : regValue L.r s.basis=encodeWord 256 R)
    (hl : s.basis L.lower=false) (ho : s.basis L.one=false)
    (hc : ∀q∈L.carry,s.basis q=false) (hp : s.basis L.parity=false) :
    run (invRecoverProgram retired L) m s=run (BiasedInverse.recoverPrefix L) [] s := by
  have memberCarry:retired∈L.carry := List.mem_of_mem_take (List.mem_of_mem_drop member)
  have beforeEq:=recover_before_eq retired L hw hn memberCarry R hr s m hR hl ho hc
  have ready:=inverse_compare_ready retired L hw hn memberCarry R hr s m hR hl ho hc hp
  obtain ⟨v,vEq⟩ : ∃v : State,run (CarryBorrow.recoverBefore L) [] s=v := ⟨_,rfl⟩
  dsimp only at ready
  rw [beforeEq,vEq] at ready
  let W:=Q6StructuralCell.exposure L++Q6LifetimeResearch.compare retired false L++
    (Q6StructuralCell.exposure L).reverse
  let tail:=(BalancedCleanup.prepareCompare L.toLayout).reverse
  have tailZero:measurementCount tail=0 := by
    rw [show tail=(BalancedCleanup.prepareCompare L.toLayout).reverse from rfl,
      measurementCount_reverse,Q6CleanupBorrow.prepare_M]
  have windowEq:=compare_window_eq retired false L hw hn member v
    (m.drop (measurementCount (recoverBefore retired L))) []
    ready.1 ready.2.1 ready.2.2.1 (by simp)
  have newRun:run (invRecoverProgram retired L) m s=
      run tail [] (run (CarryBorrow.program L) [] v) := by
    have shape:invRecoverProgram retired L=recoverBefore retired L++(W++tail) := by
      simp only [invRecoverProgram,W,tail,List.append_assoc]
    rw [shape,inv_append_run,beforeEq,vEq,inv_zero_tail_run W tail _ _ tailZero]
    exact congrArg (run tail []) windowEq
  have oldRun:run (CarryBorrow.recoverPrefix L) [] s=
      run tail [] (run (CarryBorrow.program L) [] v) := by
    simp only [CarryBorrow.recoverPrefix,inv_append_run,List.drop_nil,vEq,tail]
  exact newRun.trans (oldRun.symm.trans (CarryBorrow.recoverPrefix_eq L hw hn s [] ho hc))

theorem inv_old_view_ready (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    let v:=run (BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L) [] s
    v.basis L.lower=false ∧ ∀q∈L.carry,v.basis q=false := by
  have cnd:L.toLayout.wires.Nodup := (List.nodup_append'.mp hn).2.1
  have widths:=BalancedCleanup.widths L.toLayout hw
  obtain ⟨u,uEq⟩ : ∃u : State,run (BiasedInverse.recoverPrefix L) [] s=u := ⟨_,rfl⟩
  obtain ⟨v,vEq⟩ : ∃v : State,run (BiasedInverse.unbiasView L) [] u=v := ⟨_,rfl⟩
  have pre:=BiasedInverse.recoverPrefix_correct L hw cnd R Y B hr hy s []
    (word_encoding L.r 256 widths.2.1 s.basis R hR)
    (word_encoding L.y 256 widths.2.2.1 s.basis Y hY) hs
    (clean _ (by simp [BalancedCircuit.work]))
    (clean _ (by simp [BalancedCircuit.work]))
    (fun q hq=>clean q (by simp [BalancedCircuit.work,hq]))
  rw [uEq] at pre
  have view:=BiasedInverse.unbiasView_correct L hw cnd R hr u [] pre.2.1 pre.2.2.1
  rw [vEq] at view
  have carryND:(L.r++L.carry).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have away(q:Wire)(hq:q∈L.carry):q∉L.r ∧ q≠L.lower ∧ q≠L.parity := by
    refine ⟨?_,?_,?_⟩
    · exact fun used=>List.disjoint_left.mp (List.nodup_append'.mp carryND).2.2 used hq
    · exact fun eq=>BalancedCircuit.flagAway L hn L.lower (by simp) (by simp [←eq,hq])
    · exact fun eq=>BalancedCircuit.flagAway L hn L.parity (by simp) (by simp [←eq,hq])
  have actual:run (BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L) [] s=v := by
    rw [inv_append_run]
    simp only [List.drop_nil,uEq,vEq]
  rw [actual]
  refine ⟨view.2.2.1,?_⟩
  intro q hq
  have out:=(away q hq)
  exact (view.2.2.2 q out.1 out.2.1).trans
    ((pre.2.2.2.2 q out.1 out.2.1 out.2.2).trans
      (clean q (by simp [BalancedCircuit.work,hq])))

theorem inv_prefix_eq_guard (retired : Wire) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup)
    (member : retired∈(L.carry.take 254).drop 1)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    ∃records,run (invPrefixProgram retired L) m s=
      run (GuardCompression.inversePrefix L) records s := by
  let oldView:=BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L
  let newView:=invRecoverProgram retired L++BiasedInverse.unbiasView L
  let Z:Program:=rotateLeft (BalancedCircuit.rawTarget L)++[.CX L.parity L.r0]
  have widths:=BalancedCleanup.widths L.toLayout hw
  have recoverEq:=inv_recover_eq_old retired L hw hn member R hr s m
    (word_encoding L.r 256 widths.2.1 s.basis R hR)
    (clean _ (by simp [BalancedCircuit.work]))
    (clean _ (by simp [BalancedCircuit.work]))
    (fun q hq=>clean q (by simp [BalancedCircuit.work,hq]))
    (clean _ (by simp [BalancedCircuit.work]))
  have viewEq:run newView m s=run oldView [] s := by
    rw [show newView=invRecoverProgram retired L++BiasedInverse.unbiasView L from rfl,
      inv_zero_tail_run _ _ _ _ (inv_unbias_zero L),recoverEq]
    rw [show oldView=BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L from rfl,
      inv_zero_tail_run _ _ _ _ (inv_unbias_zero L)]
  obtain ⟨v,vEq⟩ : ∃v : State,run oldView [] s=v := ⟨_,rfl⟩
  have ready:=inv_old_view_ready L hw hn B R Y hr hy s hs hR hY clean
  change (run oldView [] s).basis L.lower=false ∧
    (∀q∈L.carry,(run oldView [] s).basis q=false) at ready
  rw [vEq] at ready
  have zZero:measurementCount Z=0 := by
    simp only [Z,measurementCount_append,(rotate_counts (BalancedCircuit.rawTarget L)).2.2.2]
    rfl
  have tailEq(records:List Bool):
      run (Q6LifetimeResearch.unfoldStep retired L++Z) records v=
        run (OneReuse.restoreRaw L) records v := by
    have oldShape:OneReuse.restoreRaw L=OneReuse.unfoldWindow L++Z := by
      simp only [OneReuse.restoreRaw,Z,List.append_assoc]
    rw [oldShape,inv_zero_tail_run _ Z _ _ zZero,inv_zero_tail_run _ Z _ _ zZero,
      unfold_eq_old retired L hw hn (List.mem_of_mem_drop member) v records ready.1 ready.2]
  let tailRecords:=m.drop (measurementCount newView)
  have newRun:run (invPrefixProgram retired L) m s=run (OneReuse.restoreRaw L) tailRecords v := by
    have shape:invPrefixProgram retired L=newView++(Q6LifetimeResearch.unfoldStep retired L++Z) := by
      simp only [invPrefixProgram,newView,Z,List.append_assoc]
    rw [shape,inv_append_run,viewEq,vEq]
    exact tailEq tailRecords
  obtain ⟨records,joined⟩:=inv_join_records oldView (OneReuse.restoreRaw L) s [] tailRecords
  rw [vEq] at joined
  have oldShape:oldView++OneReuse.restoreRaw L=FifthCarry.oldInversePrefix L := by
    simp only [oldView,FifthCarry.oldInversePrefix,List.append_assoc]
  rw [oldShape] at joined
  refine ⟨records,newRun.trans (joined.symm.trans ?_)⟩
  exact FifthCarry.old_prefix_eq L hw hn B R Y hr hy s records hs hR hY clean


/-- State before the comparison chain: after `recoverBefore` and the
lower-exposure view. -/
theorem inv_compare_block_ready (retired : Wire) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) (member : retired∈L.carry)
    (R : Int) (hr : Centered R) (s : State) (m : List Bool)
    (hR : regValue L.r s.basis=encodeWord 256 R) (hl : s.basis L.lower=false)
    (ho : s.basis L.one=false) (hc : ∀q∈L.carry,s.basis q=false)
    (hp : s.basis L.parity=false) :
    (run (Q6StructuralCell.exposure L) [] (run (recoverBefore retired L) m s)).basis L.one=false ∧
    (run (Q6StructuralCell.exposure L) [] (run (recoverBefore retired L) m s)).basis L.lower=false ∧
    (∀q∈L.carry,
      (run (Q6StructuralCell.exposure L) [] (run (recoverBefore retired L) m s)).basis q=false) := by
  have ready:=inverse_compare_ready retired L hw hn member R hr s m hR hl ho hc hp
  dsimp only at ready
  generalize run (recoverBefore retired L) m s=v at ready ⊢
  have scalar:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have sl:L.sign≠L.lower:=by tauto
  have ol:L.one≠L.lower:=by tauto
  have lowerR:L.lower∉L.r:=fun used=>BalancedCircuit.flagAway L hn L.lower
    (by simp) (by simp [used])
  have rl:L.r0≠L.lower:=fun eq=>lowerR (by
    simp [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,←eq])
  have expose:=Q6LowerExposure.expose_correct L.sign L.lower L.r0 sl rl v [] ready.2.2.1
  refine ⟨(expose.2.2 _ ol).trans ready.1,expose.2.1,?_⟩
  intro q hq
  have ql:q≠L.lower:=fun eq=>BalancedCircuit.flagAway L hn L.lower
    (by simp) (by simp [←eq,hq])
  exact (expose.2.2 q ql).trans (ready.2.1 q hq)

/-- State before `unfoldStep`: after the recovered comparison and the
unbiased view. -/
theorem inv_unfold_block_ready (retired : Wire) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup)
    (member : retired∈(L.carry.take 254).drop 1)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    (run (invRecoverProgram retired L++BiasedInverse.unbiasView L) m s).basis L.lower=false ∧
    ∀q∈L.carry,
      (run (invRecoverProgram retired L++BiasedInverse.unbiasView L) m s).basis q=false := by
  have widths:=BalancedCleanup.widths L.toLayout hw
  have recoverEq:=inv_recover_eq_old retired L hw hn member R hr s m
    (word_encoding L.r 256 widths.2.1 s.basis R hR)
    (clean _ (by simp [BalancedCircuit.work]))
    (clean _ (by simp [BalancedCircuit.work]))
    (fun q hq=>clean q (by simp [BalancedCircuit.work,hq]))
    (clean _ (by simp [BalancedCircuit.work]))
  have ready:=inv_old_view_ready L hw hn B R Y hr hy s hs hR hY clean
  have viewEq:run (invRecoverProgram retired L++BiasedInverse.unbiasView L) m s=
      run (BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L) [] s := by
    rw [inv_zero_tail_run _ _ _ _ (inv_unbias_zero L),recoverEq,
      inv_zero_tail_run _ _ _ _ (inv_unbias_zero L)]
  rw [viewEq]
  exact ready

/-- State before `rawSubTail`: the record facts consumed by
`Q6LifetimeProof.raw_sub_tail_eq`, for every record list of the tail. -/
theorem inv_tail_ready (retired : Wire) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup)
    (member : retired∈(L.carry.take 254).drop 1)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    let v:=run (invPrefixProgram retired L) m s
    v.basis L.parity=v.basis L.r0 ∧ v.basis L.lower=false ∧
    (∀q∈L.carry,v.basis q=false) ∧
    ∀n,
      let u:=run (signComplement L.sign L.y) [] v
      let z:=run (notRegister (BalancedCircuit.rawTarget L)) [] u
      (run (addInPlace (GuardCompression.source L) (BalancedCircuit.rawTarget L)
        L.carry L.sign) n z).basis L.one=
      (run (addInPlace (GuardCompression.source L) (BalancedCircuit.rawTarget L)
        L.carry L.sign) n z).basis L.rmsb := by
  obtain ⟨records,prefixEq⟩:=inv_prefix_eq_guard retired L hw hn member B R Y hr hy
    s m hs hR hY clean
  have ready:=GuardCompression.inverse_prefix_parity_unseeded L hw hn B R Y hr hy
    s records hs hR hY clean
  have lower:=Q6RawBorrow.inverse_prefix_lower_clean L hw hn B R Y hr hy
    s records hs hR hY clean
  have fifthEq:run (FifthCarry.inversePrefix L) records s=
      run (GuardCompression.inversePrefix L) records s:=
    (FifthCarry.inverse_prefix_eq L hw hn s records clean).trans
      (FifthCarry.old_prefix_eq L hw hn B R Y hr hy s records hs hR hY clean)
  rw [fifthEq] at lower
  have post:=fun n=>inverse_plain_add_output_copy L hw hn B R Y hr hy s records n
    hs hR hY clean
  dsimp only at ready post ⊢
  rw [prefixEq]
  exact ⟨ready.2,lower,(regValue_zero _ _).mp ready.1,post⟩

end RecordCopies

section Prepared
open Arithmetic Arithmetic.BalancedField Arithmetic.BalancedCleanup
open Q6LifetimeProof

/-- State before the literal normalize adder: `prepareSign` leaves the flag
`one`, every carry, and the high result bit clean. -/
theorem inv_prepared_ready (L : BalancedCleanup.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (R : Int) (hr : Centered R) (s : State) (m : List Bool)
    (hR : regValue L.r s.basis=encodeWord 256 R) (hz : s.basis L.lower=false)
    (ho : s.basis L.one=false) (hc : ∀q∈L.carry,s.basis q=false) :
    (run (BalancedCleanup.prepareSign L) m s).basis L.one=false ∧
    (∀q∈L.carry,(run (BalancedCleanup.prepareSign L) m s).basis q=false) ∧
    (run (BalancedCleanup.prepareSign L) m s).basis L.rmsb=false := by
  have v:=BalancedCleanup.prepareSign_value L hw hn R hr s m hR hz
  have high:=prepared_rmsb_zero L hw hn R hr s m hR hz
  have oneAway:L.one∉L.r:=fun h=>L.flagAway hn L.one (by simp) (by simp [h])
  have oneLower:L.one≠L.lower:=by
    have h:=List.nodup_iff_count.mp (L.flagsND hn) L.one
    intro e
    simp [List.count_cons,e] at h
    omega
  have carryAway(q : Wire)(hq:q∈L.carry):q∉L.r∧q≠L.lower:=by
    have d:=List.nodup_append'.mp (L.dataND hn)
    exact ⟨fun h=>List.disjoint_left.mp d.2.2 h (by simp [hq]),
      fun e=>L.flagAway hn L.lower (by simp) (by simp [←e,hq])⟩
  exact ⟨(v.2.2 _ oneAway oneLower).trans ho,
    fun q hq=>(v.2.2 q (carryAway q hq).1 (carryAway q hq).2).trans (hc q hq),high⟩

end Prepared

end ECDSAAdd.Entrant.StairLoanInverse
end Merge_StairLoanInversePrefix_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanInverseRawHead_at_StairSideA` -/
section Merge_StairLoanInverseRawHead_at_StairSideA

/-!
# Raw-subtraction head replay for the inverse carry-loan half

The expensive dependent-top instantiation is isolated here so its heartbeat
budget and linter work do not force recompilation of the core and block layers.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairLoanInverse

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField
open StairLoan

def rawSubHeadLoan (d : Nat) : Program :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  let a := L.ylow.getD 0 0
  let b := L.r0
  let c := carries.getD 0 0
  majority a b L.sign c ++ [.X b, .CX L.parity b] ++
    Q6LifetimeResearch.move (base 760) b
      (StairLoan.addTopLoan d StairLoan.retiredRoles
        (L.ylow.drop 1 ++ [L.ymsb, L.ymsb])
        (L.rtail ++ [L.rmsb, L.one]) (carries.drop 1) c) ++
    [.CX L.parity b, .X b] ++ eraseCarry a b L.sign c ++
    [.CX a b, .CX L.sign b]

def rawSubHeadOld : Program :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  let a := L.ylow.getD 0 0
  let b := L.r0
  let c := carries.getD 0 0
  majority a b L.sign c ++ [.X b, .CX L.parity b] ++
    Q6LifetimeResearch.move (base 760) b
      (Q6LifetimeResearch.addTop (L.ylow.drop 1 ++ [L.ymsb, L.ymsb])
        (L.rtail ++ [L.rmsb, L.one]) (carries.drop 1) c) ++
    [.CX L.parity b, .X b] ++ eraseCarry a b L.sign c ++
    [.CX a b, .CX L.sign b]

theorem rawHead_add_shape (x y carry : List Wire)
    (a b cin first topSource topTarget topCopy unused : Wire) :
    y.length = x.length →
    addInPlace ((a :: x) ++ [topSource, topSource])
        ((b :: y) ++ [topTarget, topCopy])
        ((first :: carry) ++ [unused]) cin =
      majority a b cin first ++
        addInPlace (x ++ [topSource, topSource])
          (y ++ [topTarget, topCopy]) (carry ++ [unused]) first ++
        eraseCarry a b cin first ++ [.CX a b, .CX cin b] := by
  intro hy
  cases x <;> cases y
  · rfl
  · simp at hy
  · simp at hy
  · rfl

def rawSubUpperOld : Program :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  addInPlace ((L.ylow.drop 1) ++ [L.ymsb, L.ymsb])
    (L.rtail ++ [L.rmsb, L.one])
    (carries.drop 1 ++ [L.carry.getD 255 0]) (carries.getD 0 0)

def rawSubUpperInput (s : State) : State :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  run (majority (L.ylow.getD 0 0) L.r0 L.sign (carries.getD 0 0)) [] s

/-- LT44 (replay budget): the two definitions as explicit equations, so that hypotheses about
`(run rawSubUpperOld [] (rawSubUpperInput s)).basis _` are transported by rewriting.  Passing
them through a definitional cast made the kernel unfold the projection `State.basis` and
evaluate `run` on the concrete adder (≈ 31 s per use). -/
theorem rawSubUpperOld_eq : rawSubUpperOld =
    addInPlace (L760.ylow.drop 1 ++ [L760.ymsb, L760.ymsb])
      (L760.rtail ++ [L760.rmsb, L760.one])
      (((Q6Structural.q6Carry L760).take 255).drop 1 ++ [L760.carry.getD 255 0])
      (((Q6Structural.q6Carry L760).take 255).getD 0 0) := rfl

theorem rawSubUpperInput_eq (s : State) : rawSubUpperInput s =
    run (majority (L760.ylow.getD 0 0) L760.r0 L760.sign
      (((Q6Structural.q6Carry L760).take 255).getD 0 0)) [] s := rfl

/-- Port facts of the ordinary upper adder (public copy of the record's
    private `prefix_ports`). -/
theorem upper_ports (x y carry : List Wire) (a t z last cin : Wire)
    (nd : (x++[a]++y++[t,z]++carry++[last,cin]).Nodup) :
    (cin::((y++[t,z])++(carry++[last]))).Nodup ∧
      List.Disjoint (x++[a,a]) (cin::((y++[t,z])++(carry++[last]))) := by
  constructor
  · apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  · have split:((x++[a])++(y++[t,z]++carry++[last,cin])).Nodup := by
      simpa only [List.append_assoc] using nd
    have dis:=(List.nodup_append'.mp split).2.2
    apply List.disjoint_left.mpr
    intro q hq bad
    apply List.disjoint_left.mp dis
    · simpa only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_self] using hq
    · simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at bad ⊢
      tauto

/-! ## Generic raw-subtraction head replay

The concrete theorem below is a cheap instantiation of `rawHeadLoan_generic`,
whose proof never inspects a concrete wire list (all disjointness facts come
from one `Nodup` hypothesis, as in the record's `raw_sub_head_loan_eq`). -/

theorem inv_head_split (xs : List Wire) (h : xs≠[]) :
    xs=xs.getD 0 0::xs.drop 1 := by
  cases xs with
  | nil => exact False.elim (h rfl)
  | cons a xs => rfl

set_option maxHeartbeats 4000000 in
/-- Loaned version of the record's `raw_sub_head_loan_eq` (any wires). -/
theorem rawHeadLoan_generic (d : Nat) (roles x y carry : List Wire)
    (a b cin first parity topSource topTarget topCopy unused retired : Wire)
    (hy : y.length=x.length) (hc : carry.length=x.length) (hd : d+1≤carry.length)
    (nd : ([a,b,cin,first,parity]++x++[topSource]++y++[topTarget,topCopy]++
      carry++[unused]).Nodup) (member : retired∈carry)
    (roleTail : ∀q∈roles.take d,q∈carry.drop (d+1))
    (s : State) (fresh : List Bool)
    (low : s.basis b= !s.basis parity)
    (clean : ∀q∈first::(carry++[unused]),s.basis q=false)
    (post : (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) [] (run (majority a b cin first) [] s)).basis topCopy=
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) [] (run (majority a b cin first) [] s)).basis topTarget) :
    ∃ old, run (majority a b cin first++[.X b,.CX parity b]++
        Q6LifetimeResearch.move retired b
          (StairLoan.addTopLoan d roles (x++[topSource,topSource])
            (y++[topTarget,topCopy]) carry first)++
        [.CX parity b,.X b]++eraseCarry a b cin first++[.CX a b,.CX cin b]) fresh s=
      run (majority a b cin first++[.X b,.CX parity b]++
        Q6LifetimeResearch.move retired b
          (Q6LifetimeResearch.addTop (x++[topSource,topSource])
            (y++[topTarget,topCopy]) carry first)++
        [.CX parity b,.X b]++eraseCarry a b cin first++[.CX a b,.CX cin b]) old s := by
  let clear:Program:=[.X b,.CX parity b]
  let A:=majority a b cin first++clear
  let P:=Q6LifetimeResearch.move retired b
    (StairLoan.addTopLoan d roles (x++[topSource,topSource]) (y++[topTarget,topCopy]) carry first)
  let Q:=Q6LifetimeResearch.move retired b
    (Q6LifetimeResearch.addTop (x++[topSource,topSource]) (y++[topTarget,topCopy]) carry first)
  let R:Program:=[.CX parity b,.X b]++eraseCarry a b cin first++[.CX a b,.CX cin b]
  let u:=run (majority a b cin first) [] s
  let t:=run clear [] u
  have counts:=List.nodup_iff_count.mp nd
  have four:[a,b,cin,first].Nodup := by
    apply List.nodup_iff_count.mpr;intro q
    have h:=counts q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have split:([a,b,cin,parity]++(x++[topSource]++y++[topTarget,topCopy]++
      carry++[unused,first])).Nodup := by
    apply List.nodup_iff_count.mpr;intro q
    have h:=counts q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have upperND:(x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]).Nodup :=
    (List.nodup_append'.mp split).2.1
  have dis:List.Disjoint [a,b,cin,parity]
      (x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]) :=
    (List.nodup_append'.mp split).2.2
  have ports:=upper_ports x y carry topSource topTarget topCopy unused first upperND
  have parityNe:parity≠b := by
    have small:([a,b,cin,parity]:List Wire).Nodup := (List.nodup_append'.mp split).1
    simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at small
    tauto
  have oldSupport:wires (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
      (carry++[unused]) first)⊆
      (x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]).toFinset := by
    rw [addInPlace_wires _ _ _ _ (by simp [hy]) (by simp [hy,hc])]
    intro q used
    simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at used ⊢
    tauto
  have apart:Disjoint (wires clear) (wires (addInPlace (x++[topSource,topSource])
      (y++[topTarget,topCopy]) (carry++[unused]) first)) := by
    apply Finset.disjoint_left.mpr
    intro q left right
    have ls:q∈[a,b,cin,parity] := by
      simp [clear,wires,Instr.wires] at left
      simp only [List.mem_cons,List.not_mem_nil,or_false]
      tauto
    exact List.disjoint_left.mp dis ls (List.mem_toFinset.mp (oldSupport right))
  have clearKeeps(v:State)(q:Wire)(hq:q≠b)(ms:List Bool):
      (run clear ms v).basis q=v.basis q := by
    simp [clear,run,writeBit,hq]
  have bAway(q:Wire)(hq:q∈x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]):q≠b :=
    fun eq=>List.disjoint_left.mp dis (by simp) (eq ▸ hq)
  have firstEq:u=⟨s.phase,writeBit s.basis first
      (carryBit (s.basis a) (s.basis b) (s.basis cin))⟩ := by
    rw [show u=run (majority a b cin first) [] s from rfl,
      majority_correct a b cin first four]
    simp only [clean first (by simp),Bool.false_xor]
  have beforeFirst(q:Wire)(hq:q∈[a,b,cin,parity]++x++[topSource]++y++
      [topTarget,topCopy]++carry++[unused]):q≠first := by
    intro eq
    have h:=counts first
    have pos:=List.count_pos_iff.mpr (eq ▸ hq)
    simp only [List.count_append,List.count_cons,List.count_nil,beq_self_eq_true,if_true] at h pos
    omega
  have keep(q:Wire)(hq:q∈[a,b,cin,parity]++x++[topSource]++y++
      [topTarget,topCopy]++carry++[unused]):u.basis q=s.basis q := by
    rw [firstEq]
    simp only [writeBit,Function.update_of_ne (beforeFirst q hq)]
  have cleanU:∀q∈carry++[unused],u.basis q=false := by
    intro q hq
    exact (keep q (by simp only [List.mem_append,List.mem_cons,List.not_mem_nil,
      or_false] at hq ⊢;tauto)).trans (clean q (List.mem_cons_of_mem first hq))
  have ready:t.basis b=false ∧ (∀q∈carry++[unused],t.basis q=false) := by
    constructor
    · have rel:u.basis b= !u.basis parity := by
        simpa only [keep b (by simp),keep parity (by simp)] using low
      simp only [t,clear,run,writeBit,Function.update_self,Function.update_of_ne parityNe]
      rw [rel]
      cases u.basis parity <;> rfl
    · intro q hq
      rw [clearKeeps u q (bAway q (by simp only [List.mem_append,List.mem_cons,
        List.not_mem_nil,or_false] at hq ⊢;tauto)) []]
      exact cleanU q hq
  have postU(n:List Bool):
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n u).basis topCopy=
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n u).basis topTarget := by
    rw [CoherentTail.readonly_record_independent (x++[topSource,topSource])
      (y++[topTarget,topCopy]) (carry++[unused]) first ports.1 ports.2
      (by simp [hy]) (by simp [hy,hc]) u n [] cleanU]
    exact post
  have postT(n:List Bool):
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n t).basis topCopy=
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n t).basis topTarget := by
    rw [show t=run clear [] u from rfl,
      ←run_disjoint_commute clear _ apart [] n u,
      clearKeeps _ topCopy (bAway _ (by simp)) [],
      clearKeeps _ topTarget (bAway _ (by simp)) []]
    exact postU n
  have pullEq:pullState (Equiv.swap retired b) t=t :=
    FieldFrameOB5.pull_swap_zero retired b t (ready.2 retired (by simp [member])) ready.1
  have middle:∀m n,run P m t=run Q n t := by
    intro m n
    apply StairLoan.renameProgram_run_eq_of (Equiv.swap retired b)
    rw [pullEq]
    exact addTopLoan_run_eq d roles x y carry topSource topTarget topCopy unused first
      t m n hy hc hd upperND ready.2 roleTail (postT n)
  have aZero:measurementCount A=0 := rfl
  have executeA:run A (fresh.take (measurementCount A)) s=t := by
    rw [aZero,List.take_zero]
    show run (majority a b cin first++clear) [] s=t
    rw [run_append]
    simpa only [List.take_nil,List.drop_nil] using (show run clear [] u=t from rfl)
  obtain ⟨old,h⟩:=replace_middle_exists A P Q R s fresh (by
    intro m n
    rw [executeA]
    exact middle m n)
  exact ⟨old,by simpa only [A,P,Q,R,clear,List.append_assoc] using h⟩

section HeadLayout
open Arithmetic BalancedCircuit Arithmetic.BalancedField

set_option maxHeartbeats 2000000 in
/-- Layout facts of the raw-subtraction head (copied from the set-up of the
record's `Q6LifetimeProof.raw_sub_tail_eq`). -/
theorem inv_head_layout (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    let carries:=(Q6Structural.q6Carry L).take 255
    carries=carries.getD 0 0::carries.drop 1 ∧
    (carries.drop 1).length=254 ∧
    L.rtail.length=(L.ylow.drop 1).length ∧
    (carries.drop 1).length=(L.ylow.drop 1).length ∧
    ([L.ylow.getD 0 0,L.r0,L.sign,carries.getD 0 0,L.parity]++L.ylow.drop 1++[L.ymsb]++
      L.rtail++[L.rmsb,L.one]++carries.drop 1++[L.carry.getD 255 0]).Nodup ∧
    (∀ r ∈ (L.carry.take 254).drop 1, r ∈ carries.drop 1) := by
  let carries:=(Q6Structural.q6Carry L).take 255
  let a:=L.ylow.getD 0 0
  let b:=L.r0
  let c:=carries.getD 0 0
  let x:=L.ylow.drop 1
  let y:=L.rtail
  let cs:=carries.drop 1
  let unused:=L.carry.getD 255 0
  let C:=carries++[unused]
  have cshape:carries=L.carry.take 254++[L.lower]:=by
    simp [carries,Q6Structural.q6Carry,List.take_append,List.take_take,List.length_take,hw.2.2]
  have clen:carries.length=255:=by rw [cshape];simp [List.length_take,hw.2.2]
  have yne:L.ylow≠[]:=by intro e;have h:=hw.2.1;rw [e] at h;cases h
  have cne:carries≠[]:=by intro e;rw [e] at clen;cases clen
  have ysplit:L.ylow=a::x:=inv_head_split L.ylow yne
  have csplit:carries=c::cs:=inv_head_split carries cne
  have unusedIn:unused∈L.carry:=by
    have h:255<L.carry.length:=by rw [hw.2.2];omega
    dsimp only [unused]
    rw [List.getD_eq_getElem _ _ h]
    exact List.getElem_mem _
  have rawND:(L.ylow++[L.ymsb]++L.low++[L.rmsb,L.one]++carries++
      [unused,L.sign,L.parity]).Nodup:=by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    rw [CarryBorrow.carry_split L hw] at h
    have take:List.count q (L.carry.take 254)≤List.count q (L.carry.take 255):=by
      simpa only [List.take_take,show min 254 255=254 from rfl] using
        (List.take_sublist 254 (L.carry.take 255)).count_le q
    rw [cshape]
    dsimp only [unused]
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have headND:([a,b,L.sign,c,L.parity]++x++[L.ymsb]++y++[L.rmsb,L.one]++cs++[unused]).Nodup:=by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp rawND q
    rw [ysplit,csplit] at h
    dsimp only [b,y]
    simp only [BalancedCleanup.Layout.low,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have memberTail:∀ r ∈ (L.carry.take 254).drop 1, r ∈ cs := by
    intro r member
    change r∈carries.drop 1
    rw [cshape,List.drop_append]
    have len:(L.carry.take 254).length=254:=by simp [List.length_take,hw.2.2]
    simp only [len,show 1-254=0 from rfl,List.drop_zero,List.mem_append,List.mem_singleton]
    exact Or.inl member
  have csLen:cs.length=254:=by simp [cs,clen]
  have hyx:y.length=x.length:=by simp [x,y,hw.1,hw.2.1]
  have hcx:cs.length=x.length:=by simp [x,cs,clen,hw.2.1]
  exact ⟨csplit,csLen,hyx,hcx,headND,memberTail⟩

end HeadLayout

