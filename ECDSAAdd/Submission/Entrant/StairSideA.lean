/-!
# Caller-domain support of the schedule constructors (LT11)

Constructor-level lemmas for the hosted kernels, stated for an arbitrary
primitive provider `p` and loan provider: the checkpoint segments
(`StairSchedule.forwardSegment` / `reverseSegment`, identical in the current
CANON and the k = 44 re-plan), the placed endpoint, and the v3 group hosting
`rebindMany (exclusive roles) hosts (placedGroups …)`.

`own_of_fieldPlace` converts LT13's kernel-level facts
(`fieldPlace q ∈ callerList`, `StairPhysicalPrimitives.physicalPrimitives_caller`)
into own-label support: `fieldPlace` is a composite of involutive
caller-preserving swaps.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## The field-tail placement and its inverse -/

/-- LT13's `StairOuterPlacement.fieldPlace`, restated. -/
def fieldPlaceB (q : Wire) : Wire :=
  (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
    (HostOB5.hostSwap (Prefix1590.borrow q))


/-- Inverse direction: a label whose field placement is a caller label is a
caller label. -/
theorem caller_of_fieldPlaceB (q : Wire) (h : fieldPlaceB q ∈ callerDomain) : q ∈ callerDomain := by
  unfold fieldPlaceB at h
  have h1 : HostOB5.hostSwap (Prefix1590.borrow q) ∈ callerDomain := by
    have := preserves_paritySwap _ h
    simpa only [Equiv.swap_apply_self] using this
  have h2 : Prefix1590.borrow q ∈ callerDomain := by
    have := preserves_hostSwap _ h1
    rwa [HostOB5.hostSwap_invol] at this
  have h3 := preserves_borrow _ h2
  unfold Prefix1590.borrow at h3
  simpa only [Equiv.swap_apply_self] using h3


