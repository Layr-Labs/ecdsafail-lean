/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3Fresh_at_StairSideA` -/
section Merge_StairField13V3Fresh_at_StairSideA

/-!
# Field 13 on v3: static freshness of the hosts (LT25)

v3 hosts are s-history letters `sLetter t = OB5.sig 511 (base (1028 + t))` of
future payload ticks (`StairPhysicalLayout.hosts B`, ticks `t ≡ 0, 1, 3 mod 5`,
`t ≥ startFor B`).  A placed loaned packet group over packets `[j, j+n)` touches
no history letter of any other packet, and the placed first packet touches no
history letter of packets `1..101`.  This discharges the `hostsFresh` part of
every hosted slot (`StairField13V3.SlotParts`).  Ported from LT9's 1337
`windowHosts_fresh` (letters `g`) to history letters; field-5 support only, no
run equality.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField13V3Fresh

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField

attribute [local irreducible] run wires

/-! ## LT9's read-region bounds (verbatim) -/

theorem fieldIds_read' (j : Nat) :
    (base 2409 :: Q6EndpointCell.ids.map base).toFinset ⊆
      FrontierReplay1591.readSites (5 * j) :=
  fun _ used => Finset.mem_union_left _ (Finset.mem_union_left _ used)

theorem id_read' (j i : Nat) (used : i ∈ Q6EndpointCell.ids) :
    base i ∈ FrontierReplay1591.readSites (5 * j) :=
  fieldIds_read' j (List.mem_toFinset.mpr
    (List.mem_cons_of_mem _ (List.mem_map.mpr ⟨i, used, rfl⟩)))

theorem flag_read' (j : Nat) :
    base 2409 ∈ FrontierReplay1591.readSites (5 * j) :=
  fieldIds_read' j (by simp)

theorem history_read' (j active : Nat) (ha : active < 5) :
    Rolling1588.g j active ∈ FrontierReplay1591.readSites (5 * j) ∧
      Rolling1588.s j active ∈ FrontierReplay1591.readSites (5 * j) := by
  have controls := Replay5.history_controls (5 * j) active ha
  rw [← NewHistory5.encode_support_eq] at controls
  exact ⟨Finset.mem_union_right _ controls.1,
    Finset.mem_union_right _ controls.2⟩

theorem selected_read_support' (source flag : Wire) (P : Program)
    (W : Finset Wire) (sourceIn : source ∈ W) (flagIn : flag ∈ W)
    (body : wires P ⊆ W) :
    wires (SW.selW source flag P) ⊆ W := by
  simpa [SW.selW, wires_append, wires, Instr.wires, correctionWires,
    Finset.union_subset_iff, Finset.insert_subset_iff, sourceIn, flagIn] using body

theorem rename_swap_support' (P : Program) (a b : Wire)
    (W : Finset Wire) (old : wires P ⊆ W) (ha : a ∈ W) (hb : b ∈ W) :
    wires (renameProgram (Equiv.swap a b) P) ⊆ W := by
  rw [renameProgram_support]
  intro q used
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp used
  by_cases sameA : i = a
  · subst i
    simpa only [Equiv.swap_apply_left] using hb
  · by_cases sameB : i = b
    · subst i
      simpa only [Equiv.swap_apply_right] using ha
    · simpa only [Equiv.swap_apply_of_ne_of_ne sameA sameB] using old hi

/-- LT10's `halfWindow_read_support` with the field-5 support theorem in
place of the full half-replay hypothesis. -/
theorem halfWindow_read_support' (divide : Bool) (d j active hole : Nat)
    (hd : d ≤ 68) (hj : j < 102) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.halfWindow divide d j active hole) ⊆
      FrontierReplay1591.readSites (5 * j) := by
  let W := FrontierReplay1591.readSites (5 * j)
  let P := StairLoan.half760Loan d divide
  let rebound := renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole)) P
  have raw : wires P ⊆ W := by
    intro q used
    have old := (Finset.mem_sdiff.mp
      (StairLoanSupport.wholeHalfSupport divide d hd used)).1
    exact Q6EndpointCell.half_support divide base (base 2409) W
      (fieldIds_read' j) old
  have carry719 : base 719 ∈ W := id_read' j 719 (by
    simp only [Q6EndpointCell.ids, List.mem_append, List.mem_cons,
      List.not_mem_nil, List.mem_range'_1, or_false]
    omega)
  have carry : Rolling1588.packetCarry j ∈ W := id_read' j (516 + 2 * j) (by
    simp only [Q6EndpointCell.ids, List.mem_append, List.mem_cons,
      List.not_mem_nil, List.mem_range'_1, or_false]
    omega)
  have source := (history_read' j active ha).1
  have rebind : wires rebound ⊆ W := rename_swap_support' P
    (base 719) (Rolling1588.s j hole) W raw carry719
    (history_read' j hole hh).2
  have loanBody :
      (wires rebound).image
        (Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j active)) ⊆ W := by
    rw [← renameProgram_support]
    exact rename_swap_support' rebound (Rolling1588.packetCarry j)
      (Rolling1588.g j active) W rebind carry source
  intro q used
  rcases Finset.mem_union.mp
      (ControlLoan1589.loanWindow_support (Rolling1588.g j active)
        (base 2409) (Rolling1588.packetCarry j) rebound used) with edge | body
  · simp only [Finset.mem_insert, Finset.mem_singleton] at edge
    rcases edge with rfl | rfl
    · exact source
    · exact flag_read' j
  · exact loanBody body

theorem cell_read_support' (divide : Bool) (d j active hole : Nat)
    (hd : d ≤ 68) (hj : j < 102) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.cell divide d j active hole) ⊆
      FrontierReplay1591.readSites (5 * j) := by
  let W := FrontierReplay1591.readSites (5 * j)
  have swap : wires FrontierSW1591.swapBody ⊆ W := by
    have old : wires FrontierSW1591.swapBody ⊆
        wires (Q6EndpointCell.body true base (base 2409) (base 2409)) := by
      simp only [FrontierSW1591.swapBody, Q6EndpointCell.body, if_true,
        wires_append, Q6EndpointCell.ports_r, Q6EndpointCell.ports_y]
      exact Finset.subset_union_right
    exact old.trans (Q6EndpointCell.body_support true base (base 2409)
      (base 2409) W (fieldIds_read' j) (flag_read' j))
  have selected := selected_read_support' (Rolling1588.s j active) (base 2409)
    FrontierSW1591.swapBody W (history_read' j active ha).2 (flag_read' j) swap
  have loan := halfWindow_read_support' divide d j active hole hd hj ha hh
  cases divide <;>
    simp only [StairGroups.cell, Bool.false_eq_true, if_false, if_true,
      wires_append, Finset.union_subset_iff] at loan ⊢
  · exact ⟨selected, loan⟩
  · exact ⟨loan, selected⟩

/-- Read-region bound for the loaned base packet at every deficit (LT10's
statement, field-5 support only). -/
theorem loanedBasePacket_read_support (divide : Bool) (d j : Nat)
    (hd : d ≤ 68) (hj : j < 102) :
    wires (StairGroups.basePacket divide d j) ⊆
      NewHistory5.groupReadSites base (base 2400) (base 2409) (base 2410)
        (5 * j) ∪ {base 2312} := by
  let W := FrontierReplay1591.readSites (5 * j)
  have join {P Q : Program} (left : wires P ⊆ W) (right : wires Q ⊆ W) :
      wires (P ++ Q) ⊆ W := by
    rw [wires_append, Finset.union_subset_iff]
    exact ⟨left, right⟩
  have opening := Rolling1588.onPacket_read_support j Rolling1588.stageOpen
    Rolling1588.stageOpen_support
  have closing := Rolling1588.onPacket_read_support j Rolling1588.stageClose
    Rolling1588.stageClose_support
  have transfer (direction : Bool) (k : Nat) (hk : k < 2) :=
    Rolling1588.onPacket_read_support j
      (Rolling1588.stageTransition direction k)
      (Rolling1588.stageTransition_support direction k hk)
  have cellAt (direction : Bool) (active : Nat) (ha : active < 5) :=
    cell_read_support' direction d j active 2 hd hj ha (by decide)
  have all : wires (StairGroups.basePacket divide d j) ⊆ W := by
    cases divide
    · simp only [StairGroups.basePacket, Bool.false_eq_true, if_false]
      exact join (join opening
        (join (join (join (join (join (join
          (cellAt false 4 (by decide)) (transfer false 0 (by decide)))
          (cellAt false 3 (by decide))) (cellAt false 4 (by decide)))
          (transfer false 1 (by decide))) (cellAt false 4 (by decide)))
          (cellAt false 3 (by decide)))) closing
    · simp only [StairGroups.basePacket, if_true]
      exact join (join opening
        (join (join (join (join (join (join
          (cellAt true 3 (by decide)) (cellAt true 4 (by decide)))
          (transfer true 0 (by decide))) (cellAt true 4 (by decide)))
          (cellAt true 3 (by decide))) (transfer true 1 (by decide)))
          (cellAt true 4 (by decide)))) closing
  exact all.trans (FrontierReplay1591.readSites_sub (5 * j))





/-! ## History letters -/

/-- No history letter `1028 + t` is a shared field site. -/
theorem hist_not_sharedSites (t : Nat) (ht : t < 512) :
    base (1028 + t) ∉ CompressedFieldSupport.sharedSites base (base 2409) := by
  intro h
  simp [CompressedFieldSupport.sharedSites, balancedSharedPorts,
    BalancedCircuit.Layout.wires, BalancedCleanup.Layout.wires,
    OffsetCleanupBorrowedCaller.carry, wireBlock, MappedCompressed.base] at h
  omega

theorem hist_not_encode (t i : Nat) (ht : t < 512) (hi : i < 102) (hne : t / 5 ≠ i) :
    base (1028 + t) ∉ wires (NewHistory5.encode base (5 * i)) := by
  intro h
  rw [NewHistory5.encode_support_eq] at h
  obtain ⟨q, hq⟩ := History5.history_gate_mem base (5 * i) _ (Or.inl rfl) _ h
  have bound := q.isLt
  have hq' : base (1028 + t) = base (History5.historyId (5 * i) q) := hq
  have hv : 1028 + t = History5.historyId (5 * i) q := base_injective hq'
  unfold History5.historyId at hv
  split at hv <;> omega

theorem hist_not_groupRead (t i : Nat) (ht : t < 510) (hi : i < 102) (hne : t / 5 ≠ i) :
    base (1028 + t) ∉ NewHistory5.groupReadSites base (base 2400) (base 2409)
      (base 2410) (5 * i) ∪ {base 2312} := by
  intro h
  simp only [NewHistory5.groupReadSites, Finset.mem_union, Finset.mem_insert,
    Finset.mem_singleton, List.mem_toFinset] at h
  rcases h with (((shared | flag) | enc) | last)
  · exact hist_not_sharedSites t (by omega) shared
  · rcases flag with eq | eq
    · have same := base_injective eq
      omega
    · have same := base_injective eq
      omega
  · exact hist_not_encode t i (by omega) hi hne enc
  · have same := base_injective last
    omega

/-- A placed loaned packet does not touch the history letter of any other
packet, outside the hole ticks `t ≡ 2, 4 (mod 5)`. -/
theorem loanedPacket_hist_free (divide : Bool) (d i t : Nat) (hd : d ≤ 68)
    (hi : i < 102) (ht : t < 510) (hne : t / 5 ≠ i) (h2 : t % 5 ≠ 2) (h4 : t % 5 ≠ 4) :
    base (1028 + t) ∉ wires (StairGroups.packet divide d i) := by
  intro used
  rw [StairGroups.packet, renameProgram_support] at used
  obtain ⟨x, hx, eq⟩ := Finset.mem_image.mp used
  have fixed : shifted (Placement5.pi i) (base (1028 + t)) = base (1028 + t) := by
    rw [shifted_base, Placement5.pi_outside i (1028 + t) hi (by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega)]
  have same : x = base (1028 + t) :=
    (shifted (Placement5.pi i)).injective (eq.trans fixed.symm)
  subst x
  exact hist_not_groupRead t i ht hi hne
    (loanedBasePacket_read_support divide d i hd hi hx)

theorem loanedGroups_hist_free (divide : Bool) (d : Nat) (hd : d ≤ 68)
    (t : Nat) (ht : t < 510) (h2 : t % 5 ≠ 2) (h4 : t % 5 ≠ 4) :
    ∀ n j, j + n ≤ 102 → (t / 5 < j ∨ j + n ≤ t / 5) →
      base (1028 + t) ∉ wires (StairGroups.groups divide d j n) := by
  intro n
  induction n with
  | zero =>
      intro j _ _ used
      simp [StairGroups.groups, PacketSequence.program, wires] at used
  | succ n ih =>
      intro j bound outside used
      have head := loanedPacket_hist_free divide d j t hd (by omega) ht
        (by omega) h2 h4
      have rest := ih (j + 1) (by omega) (by omega)
      cases divide <;>
        simp only [StairGroups.groups, PacketSequence.program,
          Bool.false_eq_true, if_false, if_true, wires_append,
          Finset.mem_union] at used rest
      · rcases used with h | h
        · exact rest h
        · exact head h
      · rcases used with h | h
        · exact head h
        · exact rest h

/-- The placed loaned group does not touch the history letters `sLetter t` of
packets outside its range (non-hole ticks). -/
theorem placedGroups_sLetter_free (divide : Bool) (d j n : Nat) (hd : d ≤ 68)
    (bound : j + n ≤ 102) (t : Nat) (ht : t < 510) (h2 : t % 5 ≠ 2) (h4 : t % 5 ≠ 4)
    (outside : t / 5 < j ∨ j + n ≤ t / 5) :
    StairPhysicalLayout.sLetter t ∉ wires (StairSchedule.placedGroups StairConcrete.bestLoans
      divide d j n) := by
  intro used
  change OB5.sig 511 (base (1028 + t)) ∈ wires (renameProgram (OB5.sig 511)
    (StairGroups.groups divide d j n)) at used
  rw [renameProgram_support] at used
  obtain ⟨x, hx, eq⟩ := Finset.mem_image.mp used
  have same : x = base (1028 + t) := OB5.sig_injective 511 (by omega) eq
  subst x
  exact loanedGroups_hist_free divide d hd t ht h2 h4 n j bound outside hx

/-! ## The v3 hosts are future non-hole history letters -/

theorem hosts_ticks (B : Nat) (hl : StairPhysicalLayout.startFor B % 5 = 0)
    (hle : StairPhysicalLayout.startFor B ≤ 510) :
    ∀ q ∈ StairPhysicalLayout.hosts B, ∃ t, q = StairPhysicalLayout.sLetter t ∧ t < 510 ∧
      t % 5 ≠ 2 ∧ t % 5 ≠ 4 ∧ StairPhysicalLayout.startFor B / 5 ≤ t / 5 := by
  intro q hq
  unfold StairPhysicalLayout.hosts at hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_of_mem_take hq)
  rw [List.mem_range] at hi
  refine ⟨_, rfl, ?_⟩
  generalize StairPhysicalLayout.startFor B = l at hl hle hi ⊢
  generalize StairCodec.bitWidth B = w at hi ⊢
  unfold StairPhysicalLayout.payloadTick
  split_ifs <;> omega

theorem budgets_start (B : Nat) (hB : B ∈ StairPhysicalLayout.budgets) :
    StairPhysicalLayout.startFor B % 5 = 0 ∧ StairPhysicalLayout.startFor B ≤ 510 := by
  simp only [StairPhysicalLayout.budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> decide

/-- Host freshness for a placed loaned group that ends at or before the row's
start packet. -/
theorem hosts_fresh_group (B : Nat) (hB : B ∈ StairPhysicalLayout.budgets)
    (divide : Bool) (d j n : Nat) (hd : d ≤ 68) (bound : j + n ≤ 102)
    (before : j + n ≤ StairPhysicalLayout.startFor B / 5) :
    ∀ q ∈ StairPhysicalLayout.hosts B,
      q ∉ wires (StairSchedule.placedGroups StairConcrete.bestLoans divide d j n) := by
  intro q hq
  obtain ⟨hl, hle⟩ := budgets_start B hB
  obtain ⟨t, rfl, ht, h2, h4, hs⟩ := hosts_ticks B hl hle q hq
  exact placedGroups_sLetter_free divide d j n hd bound t ht h2 h4 (Or.inr (by omega))

/-- The concrete plan's group hosts are fresh for their own logical group, at
every scheduled deficit below 44. -/
theorem hostPlan_group_fresh (divide : Bool) (d f c : Nat)
    (hsched : (d, f, c) ∈ [(0, 1, 84), (14, 85, 5), (23, 90, 3), (31, 93, 3),
      (37, 96, 2), (42, 98, 2)]) :
    ∀ q ∈ StairConcreteAssembly.hostPlan.group divide d f c,
      q ∉ wires (StairSchedule.placedGroups StairConcrete.bestLoans divide d f c) := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hsched
  rcases hsched with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ |
    ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
  · exact hosts_fresh_group 87 (by decide) divide 0 1 84 (by omega) (by omega) (by decide)
  · exact hosts_fresh_group 62 (by decide) divide 14 85 5 (by omega) (by omega) (by decide)
  · exact hosts_fresh_group 47 (by decide) divide 23 90 3 (by omega) (by omega) (by decide)
  · exact hosts_fresh_group 32 (by decide) divide 31 93 3 (by omega) (by omega) (by decide)
  · exact hosts_fresh_group 22 (by decide) divide 37 96 2 (by omega) (by omega) (by decide)
  · exact hosts_fresh_group 12 (by decide) divide 42 98 2 (by omega) (by omega) (by decide)

/-! ## First packets -/

theorem hist_not_firstCodec (t : Nat) (ht : t < 510) (hne : t / 5 ≠ 0)
    (f : Fin 10 → Wire) (hf : f = History5.historyMap base 0)
    (P : Program) (support : wires P ⊆ Finset.univ.image f) :
    base (1028 + t) ∉ wires P := by
  intro used
  obtain ⟨q, _, hq⟩ := Finset.mem_image.mp (support used)
  subst hf
  have bound := q.isLt
  have hq' : base (History5.historyId 0 q) = base (1028 + t) := hq
  have hv := base_injective hq'
  unfold History5.historyId at hv
  split at hv <;> omega

/-- The placed first packet touches no non-hole history letter of packets
`1 .. 101`. -/
theorem firstPacket_sLetter_free (divide : Bool) (t : Nat) (ht : t < 510)
    (hne : t / 5 ≠ 0) (h2 : t % 5 ≠ 2) (h4 : t % 5 ≠ 4) :
    StairPhysicalLayout.sLetter t ∉ wires (Rolling1588.placedFirstPacket divide) := by
  intro used
  change OB5.sig 511 (base (1028 + t)) ∈ wires (renameProgram (OB5.sig 511)
    (Rolling1588.firstPacket divide)) at used
  rw [renameProgram_support] at used
  obtain ⟨x, hx, eq⟩ := Finset.mem_image.mp used
  have sx : x = base (1028 + t) := OB5.sig_injective 511 (by omega) eq
  subst sx
