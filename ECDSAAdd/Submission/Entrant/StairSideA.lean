        | exact (hextx f (by simp)).2 (e ▸ hw) | exact (hextx g (by simp)).2 (e ▸ hw)
        | exact (hextx g1 (by simp)).2 (e ▸ hw) | exact (hextx wB (by simp)).2 (e ▸ hw)
