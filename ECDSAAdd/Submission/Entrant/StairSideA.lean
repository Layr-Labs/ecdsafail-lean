/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCallerCheck_at_QTop` -/
section Merge_StairCallerCheck_at_QTop

/-!
# A Boolean support checker for the caller domain (LT11, fields 8 and 9)

`allCaller P = true` says that every wire of every instruction of `P`
(including both correction lists of every measurement) is a caller-domain
label: `base i` with `i < 2314`, or one of the four scalar labels
`base 2400, 2409, 2410, 2411`.  It is a plain structural recursion with
`Nat` comparisons, so `decide +kernel` evaluates it on a concrete program.

`allCaller_sound` turns it into `wires P ⊆ callerDomain`, the support premise
`EntrySupportD` / `ExitSupportD` of field 8 (and, by `placed_of_caller`, the
placed-domain premise of field 9).

The structural rules (`allCaller_append`, `allCaller_rename`) and the
`PreservesCaller` facts for the wrapper renamings (`phaseHost`,
`Prefix1590.borrow`, `HostOB5.hostSwap`, the parity swap, `OB5.sig i`) let a
kernel be checked component by component.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## Numeric membership -/







/-! ## The checker -/







/-! ## Structural rules -/



/-- A label map that sends the caller domain into itself. -/
def PreservesCaller (f : Wire → Wire) : Prop := ∀ q ∈ callerDomain, f q ∈ callerDomain



theorem preserves_swap (a b : Wire) (ha : a ∈ callerDomain) (hb : b ∈ callerDomain) :
    PreservesCaller (Equiv.swap a b) := by
  intro q hq
  rcases eq_or_ne q a with rfl | hqa
  · rw [Equiv.swap_apply_left]; exact hb
  rcases eq_or_ne q b with rfl | hqb
  · rw [Equiv.swap_apply_right]; exact ha
  rw [Equiv.swap_apply_of_ne_of_ne hqa hqb]
  exact hq


/-! ## The wrapper renamings preserve the caller domain -/


theorem preserves_borrow : PreservesCaller Prefix1590.borrow := by
  unfold Prefix1590.borrow
  exact preserves_swap _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega))

theorem preserves_hostSwap : PreservesCaller HostOB5.hostSwap := by
  intro q hq
  unfold HostOB5.hostSwap
  split_ifs
  · exact base_mem_caller _ (by omega)
  · exact base_mem_caller _ (by omega)
  · exact base_mem_caller _ (by omega)
  · exact base_mem_caller _ (by omega)
  · exact hq

theorem preserves_paritySwap :
    PreservesCaller (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) := by
  unfold FrontierEntry1591Field.work FrontierEntry1591Field.host
  exact preserves_swap _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega))







end ECDSAAdd.Entrant.StairSemanticFinal

end
