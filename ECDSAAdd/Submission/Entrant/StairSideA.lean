theorem packetSequence_slots_le (divide : Bool) (P Q : Nat → Program)
    (extra first count : Nat)
    (step : ∀ j, gateSlots (P j) <= gateSlots (Q j) + extra) :
    gateSlots (PacketSequence.program divide P first count) <=
      gateSlots (PacketSequence.program divide Q first count) + extra * count := by
  induction count generalizing first with
  | zero => simp [PacketSequence.program, gateSlots]
  | succ count ih =>
      have head := step first
      have rest := ih (first + 1)
      cases divide <;>
        simp only [PacketSequence.program, Bool.false_eq_true, if_false,
          if_true, gateSlots_append, Nat.mul_succ] at head rest ⊢ <;>
        omega

