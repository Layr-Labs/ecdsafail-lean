section Merge_StairCodec_at_StairSideA

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! A generated, budget-parametric checkpoint codec.  The construction is the
low-space sweep circuit from `PK2`: `S=u+v`, `D=±u`, and the compact word is
`bitlen (u-σ)`, the merged low word `F`, and `σ`. -/





























































































































































































def CodecInput (L : Layout) (B u v : Nat) (sigma : Bool) (s : BasisState) : Prop :=
  regValue (reg L.S B) s = u + v ∧
  regValue (reg L.D B) s = signedWord B u sigma ∧
  cleanOn (workSites L B) s











































/-- Exact run-level obligation left by the generated resource module.  It is a
proposition, not an assumed theorem: integration may name it without adding an
extra assumption while the sweep-invariant proof is developed. -/
def FunctionalSpec (L : Layout) (B : Nat) : Prop :=
  GatePhysical (pack L B) ∧ GatePhysical (unpack L B) ∧
  ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
    (∀ s m, CodecInput L B u v sigma s.basis →
      (run (pack L B) m s).phase = s.phase ∧
      CompactCode L B u v sigma (run (pack L B) m s).basis) ∧
    (∀ s m, CompactCode L B u v sigma s.basis →
      (run (unpack L B) m s).phase = s.phase ∧
      CodecInput L B u v sigma (run (unpack L B) m s).basis)



end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodec_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecSweep_at_StairSideA` -/
section Merge_StairCodecSweep_at_StairSideA

set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Arithmetic facts for the custom known-top carry-in adder. -/

private theorem nat_lt_pow_natBitLength (x : Nat) (hx : 0 < x) :
    x < 2 ^ natBitLength x := by
  have hlog : x.log2 < x.log2 + 1 := by omega
  have hpow := (Nat.log2_lt (by omega : x ≠ 0)).mp hlog
  simpa [natBitLength, ne_of_gt hx] using hpow

theorem domain_sub_sigma_add (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    u - sigma.toNat + sigma.toNat = u := by
  cases sigma with
  | false => simp
  | true =>
      simp only [Bool.toNat_true]
      have hu : 0 < u := by
        by_contra hz
        have hz' : u = 0 := by omega
        have := (hd.2.2.2.2.2 hz').2
        contradiction
      omega

theorem domain_v_lt_top (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) : v < 2 ^ (B - 1) := by
  by_cases hu : u = 0
  · have hv : v = 1 := (hd.2.2.2.2.2 hu).1
    subst v
    have hB : B - 1 ≠ 0 := by
      have := hd.1
      omega
    exact Nat.one_lt_two_pow hB
  · have hu0 : 0 < u := Nat.pos_of_ne_zero hu
    have hul : 1 ≤ natBitLength u := by
      simp [natBitLength, hu]
    have hvl : natBitLength v ≤ B - 1 := by
      have := hd.2.2.2.2.1
      omega
    have hvb := nat_lt_pow_natBitLength v hd.2.1
    have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hvl
    exact lt_of_lt_of_le hvb hp


/-! A circuit-independent statement of the descending Pack B sweep.  LT1 can
instantiate `d` and `s` with its private rail observations and combine the
step theorem with its private decoder transition lemmas. -/









@[simp] theorem packSweepStep_z (B r : Nat) (st : SweepState) :
    (packSweepStep B r st).z = st.z ^^ (st.d (r - 1) && st.z) := by
  cases hd : st.d (r - 1) <;> cases hz : st.z <;>
    simp [packSweepStep, hd, hz]

@[simp] theorem packSweepStep_d_self (B r : Nat) (st : SweepState) :
    (packSweepStep B r st).d (r - 1) =
      st.d (r - 1) ^^ (st.d (r - 1) && st.z) ^^
        (if r - 1 < B - 2 then st.s (B - 2 - (r - 1)) else false) := by
  by_cases hj : r - 1 < B - 2
  · cases hd : st.d (r - 1) <;> cases hz : st.z <;>
      cases hs : st.s (B - 2 - (r - 1)) <;>
        simp [packSweepStep, hj, hd, hz, hs]
  · cases hd : st.d (r - 1) <;> cases hz : st.z <;>
      simp [packSweepStep, hj, hd, hz]















def initialSweepState (B w v : Nat) : SweepState :=
  { a := 0
    z := true
    d := fun i => w.testBit i
    s := fun i => if i = 0 then false else (v - 1).testBit i }

end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecSweep_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecUnsweep_at_StairSideA` -/
section Merge_StairCodecUnsweep_at_StairSideA

set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Circuit-independent semantics of the ascending sweep in `unpack`.  LT1's
private run lemmas can instantiate `d` and `s` with rail observations and use
the split-one-hot theorem below for the two decoder controls. -/





def unpackMarker (w j : Nat) : Bool := sweepMarker w (j + 1)

def UnpackSweepInvariant (B u v : Nat) (sigma : Bool) (j : Nat)
    (st : SweepState) : Prop :=
  let w := u - sigma.toNat
  j ≤ B - 1 ∧
  st.z = decide (w < 2 ^ j) ∧
  st.a = (if j < natBitLength w then natBitLength w else 0) ∧
  (∀ i, i < B - 1 →
    st.d i = if i < j then w.testBit i else payloadBit B w v i) ∧
  (∀ i, i < B - 2 →
    st.s (B - 2 - i) = if i < j then halfBit B v i else false)

/-- Exact classical update of an `unpackStep`.  The `a` field records the
semantic register value; on the invariant, a selected `k=j+1` is XORed out to
zero.  The `s` target is written before its value is XORed into `d`, matching
the instruction order. -/
def unpackSweepStep (B j : Nat) (st : SweepState) : SweepState :=
  let t := decide (st.a = j + 1)
  let z' := st.z ^^ t
  let normal := j < B - 2
  let mirror := B - 2 - j
  let restoredS := st.s mirror ^^ (st.d j && z')
  { a := if t then 0 else st.a
    z := z'
    d := fun i => if i = j then
      st.d i ^^ (if normal then restoredS else false) ^^ t
      else st.d i
    s := fun i => if normal && decide (i = mirror) then restoredS else st.s i }

@[simp] theorem unpackSweepStep_a (B j : Nat) (st : SweepState) :
    (unpackSweepStep B j st).a =
      (if decide (st.a = j + 1) then 0 else st.a) := by
  rfl

@[simp] theorem unpackSweepStep_z (B j : Nat) (st : SweepState) :
    (unpackSweepStep B j st).z = (st.z ^^ decide (st.a = j + 1)) := by
  rfl

/-- The current semantic A value makes the decoder product equal the marker
for this ascending position. -/
theorem unpack_marker_from_a (w j : Nat) :
    decide ((if j < natBitLength w then natBitLength w else 0) = j + 1) =
      unpackMarker w j := by
  rw [unpackMarker, sweepMarker_eq w (j + 1) (by omega)]
  by_cases heq : natBitLength w = j + 1
  · have hj : j < natBitLength w := by omega
    simp [heq, hj]
  · by_cases hj : j < natBitLength w
    · simp [hj, heq]
    · have hne : (0 : Nat) ≠ j + 1 := by omega
      simp [hj, heq, hne]


/-- The initial decoder product used to compute z is true exactly for the
terminal word `w=0`. -/
theorem initial_split_decoder_selected (lo w : Nat) (low high : Nat → Bool)
    (h : SplitOneHot lo (natBitLength w) low high) :
    (high 0 && low 0) = decide (w < 1) := by
  have hsel := splitOneHot_selected lo (natBitLength w) 0 low high h
  simp only [Nat.zero_div, Nat.zero_mod] at hsel
  rw [hsel]
  by_cases hw : w = 0
  · subst w
    simp [natBitLength]
  · simp [natBitLength, hw]

/-- Reverse direction of the pack thermometer equation. -/
theorem unsweep_z_step (w j : Nat) :
    (decide (w < 2 ^ j) ^^ unpackMarker w j) = decide (w < 2 ^ (j + 1)) := by
  have h := sweep_z_step w (j + 1) (by omega)
  simp only [unpackMarker, Nat.add_sub_cancel] at h ⊢
  cases hhi : decide (w < 2 ^ (j + 1)) <;>
    cases hm : sweepMarker w (j + 1) <;> simp_all

theorem unsweep_a_step (w j : Nat) :
    (if unpackMarker w j then 0
     else if j < natBitLength w then natBitLength w else 0) =
      (if j + 1 < natBitLength w then natBitLength w else 0) := by
  rw [unpackMarker, sweepMarker_eq w (j + 1) (by omega)]
  by_cases heq : natBitLength w = j + 1
  · have hj : j < natBitLength w := by omega
    have hn : ¬ j + 1 < natBitLength w := by omega
    simp [heq, hj, hn]
  · by_cases hj : j < natBitLength w
    · have hnext : j + 1 < natBitLength w := by omega
      simp [heq, hj, hnext]
    · have hnext : ¬ j + 1 < natBitLength w := by omega
      simp [heq, hj, hnext]

/-- The reconstructed mirrored S bit is exactly `(v-1)/2` at this position. -/
theorem unsweep_s_step (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 2) :
    (payloadBit B (u - sigma.toNat) v j &&
        decide (u - sigma.toNat < 2 ^ (j + 1))) =
      halfBit B v j := by
  have h := packSweep_arithmetic_step B u v sigma (j + 1) hd (by omega)
    (by simpa using hj)
  simpa [Nat.add_sub_cancel] using h.2.2.2.1.symm

/-- After reconstructing S and undoing the marker, the compact payload bit is
the original bit of `w`.  The statement includes the top position, where no S
wire exists. -/
theorem unsweep_d_step (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 1) :
    let w := u - sigma.toNat
    (payloadBit B w v j ^^
        (if j < B - 2 then
          payloadBit B w v j && decide (w < 2 ^ (j + 1))
         else false) ^^
        unpackMarker w j) = w.testBit j := by
  dsimp only
  rw [show unpackMarker (u - sigma.toNat) j =
    sweepMarker (u - sigma.toNat) (j + 1) by rfl]
  by_cases hn : j < B - 2
  · have hs := unsweep_s_step B u v sigma j hd hn
    have ht := sweep_trim_step (u - sigma.toNat) (j + 1) (by omega)
    simp only [Nat.add_sub_cancel] at ht
    rw [if_pos hn, hs, payloadBit, if_pos hn, ← ht]
    cases hbit : (u - sigma.toNat).testBit j <;>
      cases hm : unpackMarker (u - sigma.toNat) j <;>
        cases hv : halfBit B v j <;> simp
  · have hjtop : j = B - 2 := by omega
    have ht := sweep_trim_step (u - sigma.toNat) (j + 1) (by omega)
    simp only [Nat.add_sub_cancel] at ht
    rw [if_neg hn, payloadBit, if_neg hn, ← ht]
    cases hbit : (u - sigma.toNat).testBit j <;>
      cases hm : unpackMarker (u - sigma.toNat) j <;> simp

/-- The measured-t correction monomial equals the erased marker. -/
theorem unsweep_t_fix (w j : Nat) :
    (w.testBit j && decide (w < 2 ^ (j + 1))) = unpackMarker w j := by
  simp [unpackMarker, sweepMarker]

/-- One general-B ascending position preserves the complete inverse-sweep
invariant, including the two rail families. -/
theorem unpackSweepStep_invariant (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 1) (st : SweepState)
    (hinv : UnpackSweepInvariant B u v sigma j st) :
    UnpackSweepInvariant B u v sigma (j + 1) (unpackSweepStep B j st) := by
  let w := u - sigma.toNat
  change j ≤ B - 1 ∧
    st.z = decide (w < 2 ^ j) ∧
    st.a = (if j < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      st.d i = if i < j then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      st.s (B - 2 - i) = if i < j then halfBit B v i else false) at hinv
  change j + 1 ≤ B - 1 ∧
    (unpackSweepStep B j st).z = decide (w < 2 ^ (j + 1)) ∧
    (unpackSweepStep B j st).a =
      (if j + 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      (unpackSweepStep B j st).d i =
        if i < j + 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      (unpackSweepStep B j st).s (B - 2 - i) =
        if i < j + 1 then halfBit B v i else false)
  have hbound : j + 1 ≤ B - 1 := by omega
  have hz := hinv.2.1
  have ha := hinv.2.2.1
  have hdrail := hinv.2.2.2.1
  have hsrail := hinv.2.2.2.2
  have hmarker : decide (st.a = j + 1) = unpackMarker w j := by
    rw [ha]
    exact unpack_marker_from_a w j
  have hznext : (st.z ^^ decide (st.a = j + 1)) = decide (w < 2 ^ (j + 1)) := by
    rw [hz, hmarker]
    exact unsweep_z_step w j
  have hznext' : (st.z ^^ unpackMarker w j) = decide (w < 2 ^ (j + 1)) := by
    rw [← hmarker]
    exact hznext
  constructor
  · exact hbound
  constructor
  · rw [unpackSweepStep_z]
    exact hznext
  constructor
  · rw [unpackSweepStep_a, hmarker, ha]
    exact unsweep_a_step w j
  constructor
  · intro i hi
    by_cases hij : i = j
    · subst i
      have hdj : st.d j = payloadBit B w v j := by
        simpa using hdrail j hj
      by_cases hn : j < B - 2
      · have hsj : st.s (B - 2 - j) = false := by
          simpa using hsrail j hn
        simp only [unpackSweepStep, hmarker, hdj, hn, Bool.true_and,
          decide_true, if_true, hsj, Bool.false_xor]
        rw [hznext']
        simpa [w, hn] using unsweep_d_step B u v sigma j hd hj
      · simp only [unpackSweepStep, hmarker, hdj, hn, if_true, if_false]
        simpa [w, hn] using unsweep_d_step B u v sigma j hd hj
    · by_cases hil : i < j
      · have hinext : i < j + 1 := by omega
        simp [unpackSweepStep, hij, hdrail i hi, hil, hinext]
      · have hinext : ¬ i < j + 1 := by omega
        simp [unpackSweepStep, hij, hdrail i hi, hil, hinext]
  · intro i hi
    by_cases hjn : j < B - 2
    · by_cases hij : i = j
      · subst i
        have hdj : st.d j = payloadBit B w v j := by
          simpa using hdrail j (by omega)
        have hsj : st.s (B - 2 - j) = false := by
          simpa using hsrail j hjn
        have hs := unsweep_s_step B u v sigma j hd hjn
        simp only [unpackSweepStep, hjn, Bool.true_and, decide_true, if_true,
          hsj, Bool.false_xor, hdj, hmarker]
        rw [hznext', hs]
        simp
      · have hmirror : B - 2 - i ≠ B - 2 - j := by
          intro heq
          apply hij
          exact (tsub_right_inj (by omega) (by omega)).mp heq
        by_cases hil : i < j
        · have hinext : i < j + 1 := by omega
          simp [unpackSweepStep, hjn, hmirror, hsrail i hi, hil, hinext]
        · have hinext : ¬ i < j + 1 := by omega
          simp [unpackSweepStep, hjn, hmirror, hsrail i hi, hil, hinext]
    · have hji : i < j := by omega
      have hnext : i < j + 1 := by omega
      simp only [unpackSweepStep, hjn, if_false]
      simp [hsrail i hi, hji, hnext]

def unpackSweepRun (B : Nat) : Nat → Nat → SweepState → SweepState
  | _, 0, st => st
  | j, n + 1, st => unpackSweepRun B (j + 1) n (unpackSweepStep B j st)

/-- General-position induction: any prefix of the ascending inverse sweep
preserves the unpack invariant. -/
theorem unpackSweepRun_invariant (B u v : Nat) (sigma : Bool) (j n : Nat)
    (hd : CodecDomain B u v sigma) (hjn : j + n ≤ B - 1) (st : SweepState)
    (hinv : UnpackSweepInvariant B u v sigma j st) :
    UnpackSweepInvariant B u v sigma (j + n) (unpackSweepRun B j n st) := by
  induction n generalizing j st with
  | zero => simpa [unpackSweepRun] using hinv
  | succ n ih =>
      have hj : j < B - 1 := by omega
      have hnext : j + 1 + n ≤ B - 1 := by omega
      rw [unpackSweepRun]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        ih (j + 1) hnext (unpackSweepStep B j st)
          (unpackSweepStep_invariant B u v sigma j hd hj st hinv)




/-- The compact scalar state immediately after decoder construction and the
initial z CCX satisfies the inverse-sweep invariant at position zero. -/
def initialUnpackSweepState (B w v : Nat) : SweepState :=
  { a := natBitLength w
    z := decide (w < 1)
    d := fun i => payloadBit B w v i
    s := fun _ => false }

theorem initialUnpackSweepState_invariant (B u v : Nat) (sigma : Bool)
    (_hd : CodecDomain B u v sigma) :
    UnpackSweepInvariant B u v sigma 0
      (initialUnpackSweepState B (u - sigma.toNat) v) := by
  simp [UnpackSweepInvariant, initialUnpackSweepState]

/-- Full inverse sweep: A is zero, z is one (and is cleared by the following
X), D contains `w`, and every reconstructed S payload bit is present. -/
theorem unpackSweep_full (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    UnpackSweepInvariant B u v sigma (B - 1)
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) := by
  have h0 := initialUnpackSweepState_invariant B u v sigma hd
  simpa using unpackSweepRun_invariant B u v sigma 0 (B - 1) hd (by omega)
    _ h0

/-- Component form of the full invariant, ready for LT1's final X, decoder
clear, and ripple-adder bridge. -/
theorem unpackSweep_full_values (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    let st := unpackSweepRun B 0 (B - 1)
      (initialUnpackSweepState B (u - sigma.toNat) v)
    st.a = 0 ∧ st.z = true ∧
    (∀ i, i < B - 1 → st.d i = (u - sigma.toNat).testBit i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i) := by
  let st := unpackSweepRun B 0 (B - 1)
    (initialUnpackSweepState B (u - sigma.toNat) v)
  have hfull := unpackSweep_full B u v sigma hd
  change UnpackSweepInvariant B u v sigma (B - 1) st at hfull
  change st.a = 0 ∧ st.z = true ∧
    (∀ i, i < B - 1 → st.d i = (u - sigma.toNat).testBit i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i)
  have hz := hfull.2.1
  have ha := hfull.2.2.1
  have hdrail := hfull.2.2.2.1
  have hsrail := hfull.2.2.2.2
  have hlen := domain_w_bitLength_le B u v sigma hd
  have hw := domain_w_lt_top B u v sigma hd
  constructor
  · rw [ha]
    simp [show ¬ B - 1 < natBitLength (u - sigma.toNat) by omega]
  constructor
  · rw [hz]
    simp [hw]
  constructor
  · intro i hi
    simpa [hi] using hdrail i hi
  · intro i hi
    have hi' : i < B - 1 := by omega
    simpa [hi'] using hsrail i hi

end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecUnsweep_at_StairSideA

