theorem kbIndom_of (n j : Nat) (hj : j < 2314 ∨ j = 2400 ∨ j = 2409 ∨ j = 2410 ∨ j = 2411)
    (e : j + 16 = StairPlaceFast.fieldPlaceB n) : InDomN n := by
