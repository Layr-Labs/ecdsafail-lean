theorem headShape_record_sub (L : List (Nat × Nat × Nat)) (low : Nat) (hlow : 1 ≤ low)
    (chain : BackwardChain 102 low L) :
    wires (headShape StairSchedule.recordLoans L) ⊆ wires Rolling1588.exitHead := by
  have hle := backward_chain_low L 102 low chain
  have hk : low + (102 - low) = 102 := by omega
  have chain' : BackwardChain (low + (102 - low)) low L := by
    rw [hk]
    exact chain
  have hs := backward_slices_record L low (102 - low) chain'
  have hg : Rolling1588.groups false 1 101 =
      Rolling1588.groups false low (102 - low) ++ Rolling1588.groups false 1 (low - 1) := by
    unfold Rolling1588.groups
    have h := StairLoanRecordShape.program_false_add (Rolling1588.packet false) (low - 1) (102 - low) 1
    rw [show low - 1 + (102 - low) = 101 by omega, show 1 + (low - 1) = low by omega] at h
    exact h
  rw [headShape_record_eq, hs]
  unfold Rolling1588.exitHead
  rw [hg]
  exact shape_sub_gen _ _ _ _ _ _

/-! ## Record-frame replay for an arbitrary backward chain -/

theorem logicalShape_run_eq (half : HalfReplayHypothesis)
    (hEnd : EndpointReplay StairConcrete.bestLoans)
    (L : List (Nat × Nat × Nat)) (low : Nat) (chain : BackwardChain 102 low L)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) (hXY : X = Y)
    (s : State)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) false origin X Y s)
    (fresh old : List Bool) :
    run (StairConcrete.bestLoans.endPacket false 68 ++
        slices StairConcrete.bestLoans false L) fresh s =
      run (R2SqEp760.endPacket760 false ++
        slices StairSchedule.recordLoans false L) old s := by
  rw [run_append, run_append]
  rw [hEnd origin ctx enabled X Y hXY s _
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input]
  have ending := R2SqEp760.endPacket760_frame false false origin ctx enabled X Y
    (fun bad => absurd bad (by decide)) (fun _ => hXY) s
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input
  have cut := (Rolling1588.cutFrame_end origin _ _ _).mpr ending.2
  exact backward_slices_run_eq half L 102 low chain origin ctx enabled _ _ _ cut _ _

theorem headShape_run_eq (half : HalfReplayHypothesis)
    (hEnd : EndpointReplay StairConcrete.bestLoans)
    (L : List (Nat × Nat × Nat)) (low : Nat) (chain : BackwardChain 102 low L)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (fresh old : List Bool) :
    run (headShape StairConcrete.bestLoans L) fresh state =
      run (headShape StairSchedule.recordLoans L) old state := by
  have centerAt (b : List Bool) :=
    R2SqEp760.center760_frame origin ctx ha Y state b input
  have headEq : ∀ a b,
      run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN) a state =
        run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state := by
    intro a b
    apply head_replace _ _ _ state
    · intro a b
      exact StairBoundaryLoan.center760Loan_run_eq origin ctx ha Y state a b input
    · intro b a c
      have v := (centerAt b).2
      exact run_eq_of_phase _ _ a c
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ a v).1
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ c v).1
  have wAll : ∀ b, Rolling1588Frame.EncodedFieldFrame false origin (Y / 2)
      (Y / 2) (run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state) := by
    intro b
    rw [run_append]
    exact (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ _ (centerAt _).2).2
  rw [headShape_record_eq]
  show run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (StairConcrete.bestLoans.endPacket false 68 ++
        slices StairConcrete.bestLoans false L)) fresh state =
    run (R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false ++
        slices StairSchedule.recordLoans false L)) old state
  apply both_replace _ _ _ _ state headEq
  intro b a c
  have w := wAll b
  rw [StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    logicalShape_run_eq half hEnd L low chain origin ctx enabled (Y / 2) (Y / 2) rfl _ w a c]

