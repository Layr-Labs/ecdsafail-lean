namespace ECDSAAdd.Entrant.HighBankJoin
open Arithmetic RecordedQuantum

def digits (hot bank : Nat → Wire) (c d start : Nat) : Nat → Program
  | 0 => []
  | n+1 => clearDigit (hot start) c d (bank start) (bank (start+1)) ++
      digits hot bank c d (start+1) n

structure DigitLayout (h b : Nat → Wire) (c d start n : Nat) : Prop where
  row : ∀ i : Nat, start ≤ i → i <start+n → [h i,c,d,b i,b (i+1)].Nodup
  separate : ∀ i : Nat, start ≤ i → i <start+n → ∀ j : Nat, start ≤ j → j ≤ start+n → h i≠b j

private theorem DigitLayout.next {h b c d p n} (L : DigitLayout h b c d p (n+1)) :
    DigitLayout h b c d (p+1) n :=
  ⟨fun i lo hi => L.row i (by omega) (by omega),
   fun i lo hi j lj uj => L.separate i (by omega) (by omega) j (by omega) (by omega)⟩

private theorem digit_step (h b : Nat → Wire) (c d p n : Nat) (s : State) (m : List Bool) :
    run (digits h b c d p (n+1)) m s =
    run (digits h b c d (p+1) n) m (run (clearDigit (h p) c d (b p) (b (p+1))) m s) := by
  rw [digits,run_append,run_take]
  rfl

theorem digit_quiet (h c d a b : Wire) (L : [h,c,d,a,b].Nodup) (s : State) (m : List Bool)
    (off : s.basis h=false) : run (clearDigit h c d a b) m s=s := by
  obtain ⟨ph,lo,hi,other⟩ := clear_run _ _ _ _ _ L s m
  apply congrArg₂ State.mk ph
  funext q
  change (run (clearDigit h c d a b) m s).basis q=s.basis q
  by_cases ea : q = a
  · subst q; simpa [off] using lo
  by_cases eb : q=b
  · subst q; simpa [off] using hi
  exact other q ea eb

theorem digits_quiet {h b c d p n} (L : DigitLayout h b c d p n) (s : State) (m : List Bool)
    (off : ∀ i : Nat, p ≤ i → i <p+n → s.basis (h i)=false) : run (digits h b c d p n) m s=s := by
  induction n generalizing p with
  | zero => rfl
  | succ n ih =>
    rw [digit_step,digit_quiet _ _ _ _ _ (L.row p (by omega) (by omega)) s m (off _ (by omega) (by omega))]
    exact ih L.next (fun i lo hi => off i (by omega) (by omega))

theorem digits_selected {h b c d p n} (L : DigitLayout h b c d p n) (s : State) (m : List Bool)
    (t : Nat) (low : p ≤ t) (high : t<p+n)
    (control : ∀ i : Nat, p ≤ i → i <p+n → s.basis (h i)=decide (i=t)) :
    run (digits h b c d p n) m s=run (clearDigit (h t) c d (b t) (b (t+1))) m s := by
  induction n generalizing p with
  | zero => omega
  | succ n ih =>
    rw [digit_step]
    have row := L.row p (by omega) (by omega)
    by_cases eq : p=t
    · subst p
      apply digits_quiet L.next
      intro i lo hi
      have a := L.separate i (by omega) (by omega)
      have diff : i≠t := by omega
      exact ((clear_run _ _ _ _ _ row s m).2.2.2 _ (a t (by omega) (by omega))
          (a (t+1) (by omega) (by omega))).trans (by simpa [diff] using control i (by omega) (by omega))
    · rw [digit_quiet _ _ _ _ _ row s m (by simpa [eq] using control p (by omega) (by omega))]
      exact ih L.next (by omega) (by omega) (fun i lo hi => control i (by omega) (by omega))

theorem digits_counts (h b : Nat → Wire) (c d p n : Nat) :
    toffoliCount (digits h b c d p n)=2*n ∧ measurementCount (digits h b c d p n)=0 := by
  induction n generalizing p with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    obtain ⟨tc,mc⟩ := ih (p+1)
    simp only [digits,toffoliCount_append,measurementCount_append,tc,mc]
    change 2+_=2*(n+1) ∧ 0+0=0
    omega

theorem digits_physical {h b c d p n} (L : DigitLayout h b c d p n) :
    GatePhysical (digits h b c d p n) := by
  induction n generalizing p with
  | zero => simp [digits,GatePhysical]
  | succ n ih =>
    apply (gatePhysical_append _ _).mpr
    refine ⟨?_,ih L.next⟩
    have hn := L.row p (by omega) (by omega)
    simp_all [clearDigit,GatePhysical,PhysicalInstr,ProperGate,List.nodup_cons,ne_comm]

/-- The entire emitted loop clears the high digit of X for every physical
bank column j, even when the two adjacent rows target the same address. -/
theorem digits_remainder {h b c d p n} (L : DigitLayout h b c d p n)
    (s : State) (m : List Bool) (t : Nat) (low : p ≤ t) (high : t < p+n)
    (control : ∀ i : Nat, p ≤ i → i < p+n → s.basis (h i)=decide (i=t))
    (X width : Nat) (bw : p+n < width) (sep : ∀ i < width, ∀ j < width, b i=b j → i=j)
    (bits : ∀ j < width, s.basis (b j)=X.testBit j)
    (digit : X/2^t=(s.basis c).toNat+2*(s.basis d).toNat) :
    let out := run (digits h b c d p n) m s
    out.phase=s.phase ∧ (∀ j < width, out.basis (b j)=(X%2^t).testBit j) ∧
    ∀ q, q≠b t → q≠b (t+1) → out.basis q=s.basis q := by
  dsimp only
  rw [digits_selected L s m t low high control]
  obtain ⟨ph,lo,hi,away⟩ := clear_run _ _ _ _ _ (L.row t low high) s m
  refine ⟨ph,?_,away⟩
  have on : s.basis (h t)=true := by simpa using control t low high
  intro j hj
  rw [←cleared_bits X t j _ _ digit]
  by_cases e : j=t
  · subst j; simpa [on,bits t hj] using lo
  by_cases e1 : j=t+1
  · subst j; simpa [on,bits (t+1) hj] using hi
  simpa [e,e1,bits j hj] using away (b j)
    (fun eq => e (sep j hj t (by omega) eq)) (fun eq => e1 (sep j hj (t+1) (by omega) eq))

end ECDSAAdd.Entrant.HighBankJoin

end

section

namespace ECDSAAdd.Entrant.IntegerHigh
open SkywalkNat

/-- Number of initial even ticks of the small u before it exchanges with the far v. -/
def wait : Nat → Nat → Nat
  | 0,_ => 0
  | k+1,s => if s%2=0 then (wait k (s/2))+1 else 0

theorem wait_le (k s : Nat) : wait k s ≤ k := by
  induction k generalizing s with
  | zero => simp [wait]
  | succ k ih => simp only [wait]; split <;> first | omega | exact Nat.succ_le_succ (ih _)

private theorem evenStep (s B : Nat) (e : s%2=0) :
    step ⟨s,B⟩=⟨s/2,B⟩ := by
  by_cases z : s=0
  · subst s; rfl
  · simp [step,z,e]

/-- For a far word in the second rail the retained high gap loses a factor of
two only on ticks that move the large rail. The final location and magnitude
are determined by the number of waits, including an all-even packet. -/
theorem long_v (k B s D : Nat) (ready : guard k s ≤ B) :
    let t := step^[k] ⟨s,B⟩
    let shift := wait k s
    let gap := 2^shift*D
    step^[k] ⟨s,B+2^k*D⟩ =
      if shift=k then ⟨t.u,t.v+gap⟩ else ⟨t.u+gap,t.v⟩ := by
  induction k generalizing s B D with
  | zero => simp [wait]
  | succ k ih =>
    have hh : 2*guard k s+s ≤ B := by simpa [guard_succ] using ready
    have lo := guard_gt k s
    dsimp only
    rw [Function.iterate_succ_apply,Function.iterate_succ_apply]
    by_cases e : s%2=0
    · rw [evenStep _ _ e,evenStep _ _ e]
      have hb := guard_mono k (a:=s/2) (b:=s) (by omega)
      have h := ih B (s/2) (2*D) (by omega)
      simp only [wait,e,if_true,Nat.succ.injEq,pow_succ] at *
      simpa only [Nat.mul_assoc] using h
    · have hb : s<B := by omega
      have big : s<B+2^(k+1)*D := by omega
      have nz : s≠0 := by omega
      simp only [step,if_neg nz,if_neg e,if_neg (Nat.not_le.mpr hb),if_neg (Nat.not_le.mpr big),
        wait,Nat.zero_ne_add_one,if_false,pow_zero,one_mul]
      have pow : 2^(k+1)*D=2*(2^k*D) := by rw [pow_succ]; ring
      rw [pow,show (B+2*(2^k*D)-s)/2=(B-s)/2+2^k*D by omega]
      exact long_u k ((B-s)/2) s D (by omega)

/-- The barrel selector is available from the recorded three-way letters alone. -/
theorem first_exchange (k B s : Nat) (ready : guard k s ≤ B) :
    (letters k ⟨s,B⟩).idxOf 2 = wait k s := by
  induction k generalizing s with
  | zero => rfl
  | succ k ih =>
    have hh : 2*guard k s+s ≤ B := by simpa [guard_succ] using ready
    have lo := guard_gt k s
    by_cases e : s%2=0
    · have sm := guard_mono k (a:=s/2) (b:=s) (by omega)
      have tail := ih (s/2) (by omega)
      simpa [letters,letter,wait,e,evenStep s B e,List.idxOf_cons] using congrArg Nat.succ tail
    · simp [letters,letter,wait,e,show s<B by omega]

/-- Split the true sum at the selected bit boundary. Its lower part comes
directly from the simulated short state; its upper part adds the saved high gap. -/
theorem sum_split (S H E t : Nat) :
    S+2^t*(2^E*(H-2)) =
      S%2^(E+t)+2^(E+t)*(H-2+S/2^(E+t)) := by
  have fact := Nat.mod_add_div S (2^(E+t))
  rw [Nat.mul_add,Nat.add_comm (2^(E+t)*(H-2)),←Nat.add_assoc]
  rw [fact,pow_add]
  ring

theorem right_sum (k B s D : Nat) (ready : guard k s ≤ B) :
    let small := step^[k] ⟨s,B⟩
    let full := step^[k] ⟨s,B+2^k*D⟩
    full.u+full.v=small.u+small.v+2^(wait k s)*D := by
  dsimp only
  rw [long_v _ _ _ _ ready]
  split <;> dsimp only <;> omega

end ECDSAAdd.Entrant.IntegerHigh

end

section

namespace ECDSAAdd.Entrant.StairPacket.HighBankLookup

theorem mergeSlice (xs : List α) (a n : Nat) :
    (xs.drop a).take n ++ xs.drop (a+n) = xs.drop a := by
  simpa only [List.drop_drop] using List.take_append_drop n (xs.drop a)

theorem lookupLayout {bank : List Wire} {c len : Nat} (bound : len ≤ bank.length)
    (distinct : bank.Nodup) (absent : c ∉ bank) :
    HighBankShift.Layout c (bank.getD · 0) len := by
  constructor
  · intro i hi j hj eq
    have hi' : i < bank.length := by omega
    have hj' : j < bank.length := by omega
    rw [List.getD_eq_getElem _ _ hi', List.getD_eq_getElem _ _ hj'] at eq
    have p := List.pairwise_iff_getElem.mp distinct
    by_contra h
    rcases Nat.lt_or_gt_of_ne h with h | h
    · exact (p i j hi' hj' h) eq
    · exact (p j i hj' hi' h) eq.symm
  · intro i hi
    have h : i < bank.length := by omega
    rw [List.getD_eq_getElem _ _ h]
    intro eq
    exact absent (eq ▸ List.getElem_mem h)

end ECDSAAdd.Entrant.StairPacket.HighBankLookup

end

section

namespace ECDSAAdd.Entrant.HighBankShift
open Arithmetic

def undoProgram (c : Wire) (w : Nat → Wire) (d : Nat) : Nat → Program
  | 0 => []
  | n+1 => undoProgram c w d n ++ cswap c (w (n+d)) (w n)

theorem undo_measurements (c : Wire) (w : Nat → Wire) (d n : Nat) :
    measurementCount (undoProgram c w d n) = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => simp [undoProgram,measurementCount_append,ih,cswap,measurementCount]

theorem undo_run {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (f r : List Bool) :
    run (undoProgram c w d n) r (run (program c w d n) f s) = s := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    have sub : Layout c w (n+d) :=
      ⟨fun i hi j hj => L.injective i (by omega) j (by omega),
       fun i hi => L.separate i (by omega)⟩
    have ne : w (n+d) ≠ w n := fun eq => by
      have := L.injective (n+d) (by omega) n (by omega) eq
      omega
    have distinct : [c,w (n+d),w n].Nodup := by
      simp [L.separate (n+d) (by omega), L.separate n (by omega),ne]
    rw [program,undoProgram,run_append,run_append,run_take,run_take,undo_measurements]
    change run (cswap c (w (n+d)) (w n)) r
      (run (undoProgram c w d n) r (run (program c w d n) f (run (cswap c (w (n+d)) (w n)) f s))) = s
    rw [ih sub]
    exact cswap_twice c _ _ distinct s f

end ECDSAAdd.Entrant.HighBankShift

end

section

namespace ECDSAAdd.Entrant.HighBankJoin
open Arithmetic

structure Column where
  low : Bool
  hot : Option Wire
  shadow : Wire
  tube : Wire

def Column.keep (r : Column) := if r.low then r.shadow else r.tube
def Column.free (r : Column) := if r.low then r.tube else r.shadow
def toggle (a : Wire) : Option Wire → Program
  | none => []
  | some w => [.CX w a]
def control (b : BasisState) (h : Option Wire) := (h.map b).getD false

def word (a : Wire) : List Column → Program
  | [] => []
  | r::rs => toggle a r.hot ++ (pair r.low a r.shadow r.tube ++
      (word a rs ++ toggle a r.hot))

def nextBasis (r : Column) (b : BasisState) : BasisState :=
  writeBit (writeBit b r.keep (b r.shadow ^^ b r.tube)) r.free false

/-- The reference transformation writes only the two data sites in each row. -/
def joined : List Column → BasisState → BasisState
  | [],b => b
  | r::rs,b => joined rs (nextBasis r b)

def WellPlaced (a : Wire) (rs : List Column) :=
  (∀ r∈rs, [a,r.shadow,r.tube].Nodup) ∧
  ∀ r∈rs, ∀ h∈r.hot, h≠a ∧ ∀ v∈rs, h≠v.shadow ∧ h≠v.tube

/-- Check the clean branch at the running prefix XOR of the one-hot controls. -/
def Admissible (ref : BasisState) : Bool → List Column → BasisState → Prop
  | _,[],_ => True
  | active,r::rs,b =>
    let on := active ^^ control ref r.hot
    (if on then b r.shadow=false else b r.tube=false) ∧
      Admissible ref on rs (nextBasis r b)

private theorem pushRun (p q : Program) (h : measurementCount p=0) (s : State) (m : List Bool) :
    run (p++q) m s=run q m (run p m s) := by rw [run_append,run_take,h,List.drop_zero]

private theorem toggle_mc (a : Wire) (h : Option Wire) : measurementCount (toggle a h)=0 := by
  cases h <;> rfl

theorem word_counts (a : Wire) (rs : List Column) :
    toffoliCount (word a rs)=rs.length ∧ measurementCount (word a rs)=0 := by
  induction rs with
  | nil => exact ⟨rfl,rfl⟩
  | cons r rs ih =>
    have ht : toffoliCount (toggle a r.hot)=0 := by cases r.hot <;> rfl
    simp [word,ih.1,ih.2,ht,toggle_mc,(pair_counts r.low a r.shadow r.tube).1,
      (pair_counts r.low a r.shadow r.tube).2,Nat.add_comm]

private theorem toggle_run (a : Wire) (h : Option Wire) (s : State) (m : List Bool) :
    run (toggle a h) m s=⟨s.phase,writeBit s.basis a (s.basis a ^^ control s.basis h)⟩ := by
  cases h with
  | none =>
    apply congrArg₂ State.mk rfl
    funext q
    by_cases eq : q=a <;> simp [control,writeBit,Function.update,eq]
  | some w => rfl

private theorem unaffected (r : Column) (b : BasisState) (q : Wire) (x : q≠r.shadow) (y : q≠r.tube) :
    nextBasis r b q=b q := by
  cases h : r.low <;> simp [nextBasis,Column.keep,Column.free,h,writeBit,Function.update,x,y]

theorem joined_frame (rs : List Column) (b : BasisState) (q : Wire)
    (h : ∀ r∈rs, q≠r.shadow ∧ q≠r.tube) : joined rs b q=b q := by
  induction rs generalizing b with
  | nil => rfl
  | cons r rs ih =>
    exact (ih _ (fun v hv => h v (by simp [hv]))).trans
      (unaffected r b q (h r (by simp)).1 (h r (by simp)).2)

private theorem pair_basis (r : Column) (a : Wire) (s : State) (m : List Bool)
    (hn : [a,r.shadow,r.tube].Nodup)
    (ok : if s.basis a then s.basis r.shadow=false else s.basis r.tube=false) :
    run (pair r.low a r.shadow r.tube) m s=⟨s.phase,nextBasis r s.basis⟩ := by
  obtain ⟨ph,ke,fr,same⟩ := pair_run r.low _ _ _ hn s m ok
  apply congrArg₂ State.mk ph
  funext q
  have neq : r.shadow≠r.tube := by simpa [and_assoc] using (List.nodup_cons.mp hn).2
  cases v : r.low <;> by_cases hs : q=r.shadow <;> by_cases ht : q=r.tube <;>
    simp_all [nextBasis,Column.keep,Column.free,writeBit,Function.update]

private theorem commute (r : Column) (b : BasisState) (a : Wire) (x : Bool)
    (has : a≠r.shadow) (hat : a≠r.tube) :
    nextBasis r (writeBit b a x)=writeBit (nextBasis r b) a x := by
  funext q
  by_cases eq : q=a
  · subst q; rw [unaffected _ _ _ has hat]; simp [writeBit]
  · cases h : r.low <;> simp [nextBasis,Column.keep,Column.free,h,writeBit,Function.update,
        eq,Ne.symm has,Ne.symm hat]

theorem joined_commute (rs : List Column) (b : BasisState) (a : Wire) (x : Bool)
    (h : ∀ r∈rs, a≠r.shadow ∧ a≠r.tube) :
    joined rs (writeBit b a x)=writeBit (joined rs b) a x := by
  induction rs generalizing b with
  | nil => rfl
  | cons r rs ih =>
    change joined rs (nextBasis r (writeBit b a x))=_
    rw [commute _ _ _ _ (h r (by simp)).1 (h r (by simp)).2]
    exact ih _ (fun v hv => h v (by simp [hv]))

private theorem read_eq {h : Option Wire} {b ref : BasisState}
    (eq : ∀ q∈h, b q=ref q) : control b h=control ref h := by
  cases h with
  | none => rfl
  | some w => exact eq w rfl

private theorem retoggle (a : Wire) (h : Option Wire) (ref b : BasisState)
    (ph active : Bool) (m : List Bool) (dis : ∀ w∈h, w≠a ∧ b w=ref w) :
    run (toggle a h) m ⟨ph,writeBit b a active⟩ =
      ⟨ph,writeBit b a (active ^^ control ref h)⟩ := by
  rw [toggle_run]
  have ctrl := read_eq (h:=h) (b:=writeBit b a active) (ref:=ref) (by
    intro w hw
    simpa [writeBit,Function.update,(dis w hw).1] using (dis w hw).2)
  rw [ctrl]
  apply congrArg₂ State.mk rfl
  funext q
  by_cases e : q=a <;> simp [e,writeBit,Function.update]

theorem word_run (a : Wire) (rs : List Column) (ref b : BasisState)
    (ph active : Bool) (m : List Bool) (layout : WellPlaced a rs)
    (ctrl : ∀ r∈rs, ∀ w∈r.hot, b w=ref w) (ok : Admissible ref active rs b) :
    run (word a rs) m ⟨ph,writeBit b a active⟩ =
      ⟨ph,writeBit (joined rs b) a active⟩ := by
  induction rs generalizing b active with
  | nil => rfl
  | cons r rs ih =>
    let on := active ^^ control ref r.hot
    have nd := layout.1 r (by simp)
    obtain ⟨ns,nt,_⟩ : a≠r.shadow ∧ a≠r.tube ∧ r.shadow≠r.tube := by simpa [and_assoc] using nd
    have sub : WellPlaced a rs :=
      ⟨fun v hv => layout.1 v (by simp [hv]),fun v hv w hw => ⟨(layout.2 v (by simp [hv]) w hw).1,
         fun z hz => (layout.2 v (by simp [hv]) w hw).2 z (by simp [hz])⟩⟩
    obtain ⟨clean,rest⟩ := ok
    have update : run (pair r.low a r.shadow r.tube) m ⟨ph,writeBit b a on⟩ =
        ⟨ph,writeBit (nextBasis r b) a on⟩ := by
      rw [pair_basis _ _ _ _ nd (by simpa [writeBit,Function.update,Ne.symm ns,Ne.symm nt,on] using clean)]
      rw [commute _ _ _ _ ns nt]
    have outer (w : Wire) (hw : w∈r.hot) := layout.2 r (by simp) w hw
    have first := retoggle a r.hot ref b ph active m
      (fun w hw => ⟨(outer w hw).1,ctrl r (by simp) w hw⟩)
    have inner := ih (nextBasis r b) on sub (fun z hz w hw => by
      have g := (layout.2 z (by simp [hz]) w hw).2 r (by simp)
      exact (unaffected r b w g.1 g.2).trans (ctrl z (by simp [hz]) w hw)) rest
    have last := retoggle a r.hot ref (joined (r::rs) b) ph on m (fun w hw =>
      ⟨(outer w hw).1,(joined_frame _ _ _ (outer w hw).2).trans (ctrl r (by simp) w hw)⟩)
    rw [word,pushRun _ _ (toggle_mc _ _),first,pushRun _ _ (pair_counts _ _ _ _).2,update,
        pushRun _ _ (word_counts _ _).2,inner]
    simpa [on] using last

def Apart (r v : Column) := r.shadow≠v.shadow ∧ r.shadow≠v.tube ∧
  r.tube≠v.shadow ∧ r.tube≠v.tube

theorem joined_at (rs : List Column) (b : BasisState) (dis : rs.Pairwise Apart)
    (distinct : ∀ r∈rs, r.shadow≠r.tube) (v : Column) (hv : v∈rs) :
    joined rs b v.keep=(b v.shadow ^^ b v.tube) ∧ joined rs b v.free=false := by
  induction rs generalizing b with
  | nil => cases hv
  | cons r rs ih =>
    obtain ⟨head,tail⟩ := List.pairwise_cons.mp dis
    rcases List.mem_cons.mp hv with eq|mem
    · subst v
      have keep := joined_frame rs (nextBasis r b) r.keep (fun c hc => by
        obtain ⟨ss,st,ts,tt⟩ := head c hc
        cases h : r.low <;> simp_all [Column.keep])
      have fr := joined_frame rs (nextBasis r b) r.free (fun c hc => by
        obtain ⟨ss,st,ts,tt⟩ := head c hc
        cases h : r.low <;> simp_all [Column.free])
      change joined rs (nextBasis r b) _=_ ∧ joined rs (nextBasis r b) _=_
      rw [keep,fr]
      have ne := distinct r (by simp)
      cases h : r.low <;> simp [nextBasis,Column.keep,Column.free,h,writeBit,Function.update,ne,Ne.symm ne]
    · obtain ⟨ss,st,ts,tt⟩ := head v mem
      have inner := ih (nextBasis r b) tail (fun c hc => distinct c (by simp [hc])) mem
      rw [unaffected r b v.shadow (Ne.symm ss) (Ne.symm ts),
          unaffected r b v.tube (Ne.symm st) (Ne.symm tt)] at inner
      exact inner

/-- Input-only precondition, read against a single immutable bank snapshot. -/
def CleanColumns (ref : BasisState) : Bool → List Column → BasisState → Prop
  | _,[],_ => True
  | active,r::rs,b =>
    let on := active ^^ control ref r.hot
    (if on then b r.shadow=false else b r.tube=false) ∧ CleanColumns ref on rs b

private theorem clean_congr (rs : List Column) (ref b f : BasisState) (active : Bool)
    (eq : ∀ r∈rs, b r.shadow=f r.shadow ∧ b r.tube=f r.tube) :
    CleanColumns ref active rs b ↔ CleanColumns ref active rs f := by
  induction rs generalizing active with
  | nil => rfl
  | cons r rs ih =>
    simp only [CleanColumns,(eq r (by simp)).1,(eq r (by simp)).2]
    rw [ih _ (fun v hv => eq v (by simp [hv]))]

theorem admissible (rs : List Column) (ref b : BasisState) (active : Bool)
    (dis : rs.Pairwise Apart) (h : CleanColumns ref active rs b) : Admissible ref active rs b := by
  induction rs generalizing active b with
  | nil => trivial
  | cons r rs ih =>
    obtain ⟨head,tail⟩ := List.pairwise_cons.mp dis
    exact ⟨h.1,ih _ _ tail ((clean_congr rs ref (nextBasis r b) b _ (fun v hv => by
      obtain ⟨ss,st,ts,tt⟩ := head v hv
      exact ⟨unaffected _ _ _ (Ne.symm ss) (Ne.symm ts),unaffected _ _ _ (Ne.symm st) (Ne.symm tt)⟩)).mpr h.2)⟩

theorem word_physical (a : Wire) (rs : List Column) (layout : WellPlaced a rs) :
    GatePhysical (word a rs) := by
  induction rs with
  | nil => simp [word,GatePhysical]
  | cons r rs ih =>
    have sub : WellPlaced a rs :=
      ⟨fun v hv => layout.1 v (by simp [hv]),fun v hv w hw => ⟨(layout.2 v (by simp [hv]) w hw).1,
         fun z hz => (layout.2 v (by simp [hv]) w hw).2 z (by simp [hz])⟩⟩
    have tg : GatePhysical (toggle a r.hot) := by
      cases e : r.hot with
      | none => simp [toggle,GatePhysical]
      | some w =>
        have ne := (layout.2 r (by simp) w (by simp [e])).1
        simp [toggle,GatePhysical,RecordedQuantum.PhysicalInstr,ProperGate,ne]
    simp only [word,gatePhysical_append]
    exact ⟨tg,pair_physical _ _ _ _ (layout.1 r (by simp)),ih sub,tg⟩

end ECDSAAdd.Entrant.HighBankJoin

end

