theorem preserves_label (j : Nat) (hj : j ≤ 101) (q : Wire) (hq : q < 10 ∨ q ∈ callerDomain) :
    MeasuredCodec5.label (History5.historyMap base (5 * j)) q ∈ callerDomain := by
