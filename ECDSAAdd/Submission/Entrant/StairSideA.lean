    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (hDown : ztAll lo width false ws (StairLoan.emitDowns (ls.drop (D + 1))) = true)
    (hUps : ∀ w ∈ ws, w ∉ wires (StairLoan.emitUps (ls.take (D + 1))))
    (hDowns : ∀ w ∈ ws, w ∉ wires (StairLoan.emitDowns (ls.take (D + 1))))
    (hHosts : ∀ w ∈ ws, w ∉ StairLoan.layerHosts (ls.take (D + 1)))
    (hRoles : ∀ w ∈ ws.drop d, w ∉ roles.take d) :
    ztAll lo width false (ws.drop d) (StairLoan.emitLoan d roles ls top) = true := by
  have hr' : ∀ w ∈ ws.drop d, lo ≤ w ∧ w < lo + width := k3_forall_drop d hr
  simp only [StairLoan.emitLoan]
  refine k1_ztAll_append_true lo width false _ _ _ hr' ?_
    (ztAll_true_of_not_mem lo width _ _ hr' (fun w hw => k3_downs_sub w _ _
      (k3_take_sub ls (d + 1) (D + 1) (by omega)) (hDowns w (List.mem_of_mem_drop hw))))
  refine k1_ztAll_append_true lo width false _ _ _ hr' ?_
