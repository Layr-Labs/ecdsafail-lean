section Merge_StairLoanRecordShape_at_StairSideA

/-!
# Loan replay on the record's own field frames (placement independent)

Field 7 compares the staircase kernel with `bestLoans` against the same kernel
with `recordLoans`.  Under the commutation plan for field 2 both staircase
kernels are related to a *record-shaped* kernel whose 101 packet groups are
cut into the nine staircase slices, each slice and the endpoint taken from
the loan provider.  This module proves the loan-side replay at the record's
logical field boundary, where the record's own cut frames are available:

* `forward_slices_run_eq` / `backward_slices_run_eq`: a chain of loaned slices
  equals the chain of record slices on any cut frame (independent tapes), by
  `StairLoanReplay.groups_run_eq` and the record's `groups_cut_frame`;
* `forward_slices_record` / `backward_slices_record`: the record-loan slices
  are literally `Rolling1588.groups true/false 1 101`;
* `entryLogical_run_eq`: the loaned division field tail (nine slices and the
  loaned endpoint) equals the record's `groups true 1 101 ++ endPacket760
  true` on the record's own input frame (same premises as the record's
  `logical_entry_tail_frame`);
* `exitLogical_run_eq`: the multiplication analogue (premises of
  `logical_exit_head_frame`).

No staircase checkpoint, placement or host plan is involved.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordShape

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField


/-! ## The staircase slices -/


/-- Multiplication slices in schedule order (packets descend). -/
def exitSliceList : List (Nat × Nat × Nat) :=
  [(44, 100, 2), (42, 98, 2), (37, 96, 2), (31, 93, 3), (23, 90, 3),
   (14, 85, 5), (0, 1, 84)]






theorem exitSliceList_chain : BackwardChain 102 1 exitSliceList := by
  simp [BackwardChain, exitSliceList]



/-! ## Splitting the record packet sequence -/







theorem exitSlices_record :
    slices StairSchedule.recordLoans false exitSliceList =
      Rolling1588.groups false 1 101 :=
  backward_slices_record exitSliceList 1 101 exitSliceList_chain

/-! ## Loaned slices equal record slices on cut frames -/



/-! ## The logical field boundaries -/

/-- Division: the loaned field tail (nine slices and the loaned endpoint)
against the record's `groups true 1 101 ++ endPacket760 true`, on the input
frame of the record's `logical_entry_tail_frame`. -/
theorem entryLogical_run_eq (half : HalfReplayHypothesis)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (x : Nat) (hx0 : 0 < x)
    (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) (s : State)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) true origin
      (Replay5.firstPayload true origin (Y, 0)).1
      (Replay5.firstPayload true origin (Y, 0)).2 s)
    (fresh old : List Bool) :
    run (slices StairConcrete.bestLoans true entrySliceList ++
        StairConcrete.bestLoans.divEndpoint) fresh s =
      run (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true)
        old s := by
  rw [run_append, run_append]
  have cut := (Rolling1588.cutFrame_one origin _ _ s).mpr input
  have e : run (slices StairConcrete.bestLoans true entrySliceList)
      (fresh.take (measurementCount
        (slices StairConcrete.bestLoans true entrySliceList))) s =
    run (Rolling1588.groups true 1 101)
      (old.take (measurementCount (Rolling1588.groups true 1 101))) s := by
    rw [← entrySlices_record]
    exact forward_slices_run_eq half entrySliceList 1 entrySliceList_chain
      origin ctx enabled _ _ s cut _ _
  rw [e]
  have group := Rolling1588.allGroups_frame true origin ctx enabled _ _ s
    (old.take (measurementCount (Rolling1588.groups true 1 101))) input
  have payload := Replay5.forward_payload origin x Y hx0 hx trace
  exact CompareDecoder.BoundaryLoan.endPacket760DivLoan_run_eq false origin ctx enabled _ _
    (by
      rw [Prod.mk.eta, payload]
      exact (congrArg Prod.snd payload).symm.trans
        (by simp only [Replay5.endPayload]))
    _ _ _ group.2

/-- Multiplication: the loaned endpoint followed by the nine loaned slices
against the record's `endPacket760 false ++ groups false 1 101`, on the input
frame of the record's `logical_exit_head_frame`. -/
theorem exitLogical_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) (hXY : X = Y)
    (s : State)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) false origin X Y
      s)
    (fresh old : List Bool) :
    run (StairConcrete.bestLoans.endPacket false 68 ++
        slices StairConcrete.bestLoans false exitSliceList) fresh s =
      run (R2SqEp760.endPacket760 false ++ Rolling1588.groups false 1 101)
        old s := by
  rw [run_append, run_append]
  have e : run (StairConcrete.bestLoans.endPacket false 68)
      (fresh.take (measurementCount
        (StairConcrete.bestLoans.endPacket false 68))) s =
    run (R2SqEp760.endPacket760 false)
      (old.take (measurementCount (R2SqEp760.endPacket760 false))) s :=
    StairLoanReplay.multiplicationEndPacket_run_eq endpoint false origin ctx
      enabled X Y hXY s _ _ input
  rw [e]
  have ending := R2SqEp760.endPacket760_frame false false origin ctx enabled X Y
    (fun bad => absurd bad (by decide)) (fun _ => hXY) s
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input
  have cut := (Rolling1588.cutFrame_end origin _ _ _).mpr ending.2
  rw [← exitSlices_record]
  exact backward_slices_run_eq half exitSliceList 102 1 exitSliceList_chain
    origin ctx enabled _ _ _ cut _ _

/-! ## Generic congruence for sequential compositions

Programs are variables here, so no concrete program is unfolded. -/




/-- Replace the body of `H ++ X`: the common head is tape-free on `s` and the
bodies agree on every reached state for independent tapes. -/
theorem tail_replace (H X X' : Program) (s : State)
    (head : ∀ a b, run H a s = run H b s)
    (body : ∀ b a c, run X' a (run H b s) = run X c (run H b s))
    (fresh old : List Bool) :
    run (H ++ X') fresh s = run (H ++ X) old s := by
  rw [run_append, run_append,
    head (fresh.take (measurementCount H)) (old.take (measurementCount H))]
  exact body _ _ _

/-! ## Level 1: the placed division tail `Rolling1588.entryTail` -/

/-- Copy of the record's private `logical_entry_tail_frame`. -/
theorem logicalTail_frame (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (x : Nat) (hx0 : 0 < x)
    (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) :
    Rolling1588.StateTriple
      (Rolling1588.EncodedFieldFrame5 base (base 2409) true origin
        (Replay5.firstPayload true origin (Y, 0)).1
        (Replay5.firstPayload true origin (Y, 0)).2)
      (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true)
      (Rolling1588.EncodedFieldFrame5 base (base 2409) false origin
        (Y / (x : Fp)) (Y / (x : Fp))) := by
  intro state records input
  have group := Rolling1588.allGroups_frame true origin ctx enabled _ _ state
    (records.take (measurementCount (Rolling1588.groups true 1 101))) input
  have payload := Replay5.forward_payload origin x Y hx0 hx trace
  have ending := R2SqEp760.endPacket760_frame false true origin ctx enabled _ _
    (fun _ => by
      rw [Prod.mk.eta, payload]
      exact (congrArg Prod.snd payload).symm.trans
        (by simp only [Replay5.endPayload]))
    (fun bad => absurd bad (by decide))
    (run (Rolling1588.groups true 1 101)
      (records.take (measurementCount (Rolling1588.groups true 1 101))) state)
    (records.drop (measurementCount (Rolling1588.groups true 1 101))) group.2
  rw [run_append]
  refine ⟨ending.1.trans group.1, ?_⟩
  simpa only [Prod.mk.eta, payload, enabled, if_true] using ending.2

/-- Copy of the record's private `placed_transfer`. -/
theorem placedTransfer (before after : Bool) (P : Program)
    (origin : BasisState) (X Y A B : Fp)
    (correct : Rolling1588.StateTriple
      (Rolling1588.EncodedFieldFrame5 base (base 2409) before origin X Y) P
      (Rolling1588.EncodedFieldFrame5 base (base 2409) after origin A B)) :
    Rolling1588.StateTriple (Rolling1588Frame.EncodedFieldFrame before origin X Y)
      (renameProgram (OB5.sig 511) P)
      (Rolling1588Frame.EncodedFieldFrame after origin A B) := by
  intro state records input
  have result := correct (pullState (OB5.sig 511) state) records input
  have renamed := ECDSAAdd.run_rename (OB5.sig 511)
    (OB5.sig_injective 511 (by decide)) P records state
  rw [← renamed] at result
  exact result



theorem entryTail_run_eq (half : HalfReplayHypothesis)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (x : Nat) (hx0 : 0 < x)
    (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) (st : State)
    (input : Rolling1588Frame.EncodedFieldFrame true origin
      (Replay5.firstPayload true origin (Y, 0)).1
      (Replay5.firstPayload true origin (Y, 0)).2 st)
    (fresh old : List Bool) :
    run (entryTailShape StairConcrete.bestLoans) fresh st =
      run Rolling1588.entryTail old st := by
  have placedEq : ∀ a b,
      run (renameProgram (OB5.sig 511)
          (slices StairConcrete.bestLoans true entrySliceList ++
            StairConcrete.bestLoans.divEndpoint)) a st =
        run (renameProgram (OB5.sig 511)
          (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true)) b st := by
    intro a b
    rw [StairRename.rename_run_conjugate (OB5.sig 511)
        (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
      StairRename.rename_run_conjugate (OB5.sig 511)
        (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
      entryLogical_run_eq half origin ctx enabled x hx0 hx trace Y
        (pullState (OB5.sig 511) st) input a b]
  have placedFrame := placedTransfer true false
    (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true) origin _ _ _ _
    (logicalTail_frame origin ctx enabled x hx0 hx trace Y)
  have copyFree : ∀ b a c,
      run HalfFieldOB5.copyN a (run (renameProgram (OB5.sig 511)
          (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true)) b st) =
        run HalfFieldOB5.copyN c (run (renameProgram (OB5.sig 511)
          (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true)) b st) := by
    intro b a c
    have w := (placedFrame st b input).2
    exact run_eq_of_phase _ _ a c
      (Rolling1588HalfFieldOB5.copy_clear ctx.hn origin _ _ a w).1
      (Rolling1588HalfFieldOB5.copy_clear ctx.hn origin _ _ c w).1
  have canonEq : ∀ b a c,
      run StairConcrete.bestLoans.canon a (run (renameProgram (OB5.sig 511)
          (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true) ++
            HalfFieldOB5.copyN) b st) =
        run R2SqEp760.canon760 c (run (renameProgram (OB5.sig 511)
          (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true) ++
            HalfFieldOB5.copyN) b st) := by
    intro b a c
    rw [run_append]
    have w := (placedFrame st (b.take (measurementCount (renameProgram
      (OB5.sig 511) (Rolling1588.groups true 1 101 ++
        R2SqEp760.endPacket760 true)))) input).2
    have v := (Rolling1588HalfFieldOB5.copy_clear ctx.hn origin _ _
      (b.drop (measurementCount (renameProgram (OB5.sig 511)
        (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true)))) w).2
    exact StairBoundaryLoan.canon760Loan_run_eq origin ctx _ _ a c v
  have inner : ∀ a b,
      run (renameProgram (OB5.sig 511)
          (slices StairConcrete.bestLoans true entrySliceList ++
            StairConcrete.bestLoans.divEndpoint) ++ HalfFieldOB5.copyN) a st =
        run (renameProgram (OB5.sig 511)
          (Rolling1588.groups true 1 101 ++ R2SqEp760.endPacket760 true) ++
            HalfFieldOB5.copyN) b st :=
    fun a b => head_replace _ _ _ st placedEq copyFree a b
  exact both_replace _ _ _ _ st inner canonEq fresh old

/-! ## Payload freeness of the loaned slices

Copies of the record's private helpers (`QTop.lean`, `Rolling1588` field
support section), then the loaned versions via `basePacket_readSites_support`. -/

private def payloadId (i : Fin 8) : Nat :=
  History5.historyId 0 (NewHistory5.payloadPort i)

private theorem payload_region (i : Fin 8) :
    (payloadId i < 5 ∨ 1028 ≤ payloadId i ∧ payloadId i < 1033) ∧
      payloadId i ≠ 1030 ∧ payloadId i ≠ 1032 := by
  fin_cases i <;> decide

private theorem payload_field_free (i : Fin 8) :
    Prefix1590.payload0 i ∉ FrontierReplay1591.fieldSites := by
  intro used
  simp only [FrontierReplay1591.fieldSites, List.mem_toFinset, List.mem_cons,
    List.mem_map] at used
  have region := payload_region i
  rcases used with eq | ⟨q, hq, eq⟩
  · have same := base_injective eq
    change payloadId i = 2409 at same
    omega
  · have same := base_injective eq
    change q = payloadId i at same
    simp only [Q6EndpointCell.ids, List.mem_append, List.mem_cons,
      List.not_mem_nil, List.mem_range'_1, or_false] at hq
    omega

private theorem payload_not (i : Fin 8) (q : Nat)
    (outside : q < 1028 ∧ 5 ≤ q ∨ 1033 ≤ q) : Prefix1590.payload0 i ≠ base q := by
  intro eq
  have same := base_injective eq
  change payloadId i = q at same
  have region := payload_region i
  omega

private theorem payload_read_free (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (i : Fin 8) :
    Prefix1590.payload0 i ∉ FrontierReplay1591.readSites (5 * j) := by
  intro used
  simp only [FrontierReplay1591.readSites, Finset.mem_union] at used
  rcases used with (field | flags) | history
  · exact payload_field_free i field
  · simp only [Finset.mem_insert, Finset.mem_singleton] at flags
    exact flags.elim (payload_not i 2400 (Or.inr (by decide)))
      (payload_not i 2410 (Or.inr (by decide)))
  · obtain ⟨port, eq⟩ := NewHistory5.history_gate_mem base (5 * j) _
      (Or.inl rfl) _ history
    have same := base_injective eq
    have region := payload_region i
    have bound := port.isLt
    change payloadId i = History5.historyId (5 * j) port at same
    unfold History5.historyId at same
    split_ifs at same <;> omega

private theorem fixed_rename_free (f : Wire → Wire)
    (injective : Function.Injective f) (P : Program) (q : Wire)
    (fixed : f q = q) (free : q ∉ wires P) : q ∉ wires (renameProgram f P) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨a, ha, eq⟩ := Finset.mem_image.mp used
  exact free (injective (eq.trans fixed.symm) ▸ ha)

private theorem payload_pi_fixed (j : Nat) (hj : j < 102) (i : Fin 8) :
    shifted (Placement5.pi j) (Prefix1590.payload0 i) = Prefix1590.payload0 i := by
  change shifted (Placement5.pi j) (base (payloadId i)) = base (payloadId i)
  rw [shifted_base, Placement5.pi_outside j _ hj]
  have region := payload_region i
  unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
  omega

theorem basePacket_readSites_support (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (hj : j < 102) :
    wires (StairGroups.basePacket divide d j) ⊆
      FrontierReplay1591.readSites (5 * j) := by
  let W := FrontierReplay1591.readSites (5 * j)
  have join {P Q : Program} (left : wires P ⊆ W) (right : wires Q ⊆ W) :
      wires (P ++ Q) ⊆ W := by
    rw [wires_append, Finset.union_subset_iff]
    exact ⟨left, right⟩
  have opening := Rolling1588.onPacket_read_support j Rolling1588.stageOpen
    Rolling1588.stageOpen_support
  have closing := Rolling1588.onPacket_read_support j Rolling1588.stageClose
    Rolling1588.stageClose_support
  have transfer (direction : Bool) (k : Nat) (hk : k < 2) :=
    Rolling1588.onPacket_read_support j
      (Rolling1588.stageTransition direction k)
      (Rolling1588.stageTransition_support direction k hk)
  have cellAt (direction : Bool) (active : Nat) (ha : active < 5) :=
    StairLoanReplay.cell_read_support half direction d j active 2 hd hj ha
      (by decide)
  cases divide
  · simp only [StairGroups.basePacket, Bool.false_eq_true, if_false]
    exact join (join opening
      (join (join (join (join (join (join
        (cellAt false 4 (by decide)) (transfer false 0 (by decide)))
        (cellAt false 3 (by decide))) (cellAt false 4 (by decide)))
        (transfer false 1 (by decide))) (cellAt false 4 (by decide)))
        (cellAt false 3 (by decide)))) closing
  · simp only [StairGroups.basePacket, if_true]
    exact join (join opening
      (join (join (join (join (join (join
        (cellAt true 3 (by decide)) (cellAt true 4 (by decide)))
        (transfer true 0 (by decide))) (cellAt true 4 (by decide)))
        (cellAt true 3 (by decide))) (transfer true 1 (by decide)))
        (cellAt true 4 (by decide)))) closing

theorem loanPacket_payload_free (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (first : 1 ≤ j) (hj : j < 102)
    (i : Fin 8) : Prefix1590.payload0 i ∉ wires (StairGroups.packet divide d j) :=
  fixed_rename_free _ (shifted (Placement5.pi j)).injective _ _
    (payload_pi_fixed j hj i)
    (fun used => payload_read_free j first hj i
      (basePacket_readSites_support half divide d j hd hj used))

theorem loanGroups_payload_free (half : HalfReplayHypothesis)
    (divide : Bool) (d : Nat) (hd : d ≤ 68) :
    ∀ (j n : Nat), 1 ≤ j → j + n ≤ 102 → ∀ (i : Fin 8),
      Prefix1590.payload0 i ∉ wires (StairGroups.groups divide d j n)
  | _, 0, _, _, _ => by simp [StairGroups.groups, PacketSequence.program, wires]
  | j, n + 1, first, bound, i => by
      have head := loanPacket_payload_free half divide d j hd first (by omega) i
      have tail := loanGroups_payload_free half divide d hd (j + 1) n (by omega)
        (by omega) i
      cases divide <;> simp only [StairGroups.groups, PacketSequence.program,
        Bool.false_eq_true, if_false, if_true, wires_append, Finset.mem_union,
        not_or] at tail ⊢
      · exact ⟨tail, head⟩
      · exact ⟨head, tail⟩

theorem slices_payload_free (half : HalfReplayHypothesis) :
    ∀ (L : List (Nat × Nat × Nat)) (c : Nat), ForwardChain c L → ∀ (i : Fin 8),
      Prefix1590.payload0 i ∉ wires (slices StairConcrete.bestLoans true L)
  | [], _, _, _ => by simp [slices, wires]
  | (d, j, n) :: rest, c, chain, i => by
      obtain ⟨_, hd, first, bound, hr⟩ := chain
      have head := loanGroups_payload_free half true d hd j n first bound i
      have tail := slices_payload_free half rest (j + n) hr i
      simp only [slices, wires_append, Finset.mem_union, not_or]
      exact ⟨head, tail⟩

/-- Generic transfer (variable programs): a placed tail whose slice part is
replaced by a payload-free one and whose endpoint is unchanged stays
payload free. -/
theorem tailShape_payload_free_of (A A' E E' C D D' : Program) (i : Fin 8)
    (recordFree : Prefix1590.payload0 i ∉
      wires (renameProgram (OB5.sig 511) (A ++ E) ++ C ++ D))
    (sliceFree : Prefix1590.payload0 i ∉ wires A')
    (endSub : wires E' ⊆ wires E)
    (canonSub : wires D' ⊆ wires D) :
    Prefix1590.payload0 i ∉
      wires (renameProgram (OB5.sig 511) (A' ++ E') ++ C ++ D') := by
  have placed := fixed_rename_free _ (OB5.sig_injective 511 (by decide)) _ _
    (Prefix1590.firstSig_history (NewHistory5.payloadPort i)) sliceFree
  have placedE : wires (renameProgram (OB5.sig 511) E') ⊆
      wires (renameProgram (OB5.sig 511) E) := by
    rw [renameProgram_support, renameProgram_support]
    exact Finset.image_mono _ endSub
  have endIn : wires (renameProgram (OB5.sig 511) E) ⊆
      wires (renameProgram (OB5.sig 511) (A ++ E) ++ C ++ D) := by
    intro q hq
    simp only [renameProgram, List.map_append, wires_append, Finset.mem_union] at hq ⊢
    tauto
  have endFree : Prefix1590.payload0 i ∉ wires (renameProgram (OB5.sig 511) E') :=
    fun h => recordFree (endIn (placedE h))
  simp only [renameProgram, List.map_append, wires_append, Finset.mem_union,
    not_or] at recordFree placed endFree ⊢
  exact ⟨⟨⟨placed, endFree⟩, recordFree.1.2⟩, fun h => recordFree.2 (canonSub h)⟩

theorem entryTailShape_payload_free (half : HalfReplayHypothesis) (i : Fin 8) :
    Prefix1590.payload0 i ∉ wires (entryTailShape StairConcrete.bestLoans) := by
  have recordFree := Rolling1588.entryTail_payload_free i
  rw [← entryTailShape_record] at recordFree
  exact tailShape_payload_free_of _ _ _ _ _ _ _ i recordFree
    (slices_payload_free half entrySliceList 1 entrySliceList_chain i)
    CompareDecoder.BoundaryLoan.Inclusion.endPacket760DivLoan_sub
    StairLoanConverterSupport.bestCanon_sub

/-! ## Level 2: the division field `Rolling1588.entryField` (scratch window) -/



theorem entryField_run_eq (half : HalfReplayHypothesis)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (enabled : origin (base 2400) = true) (x : Nat) (hx0 : 0 < x)
    (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame true origin Y 0 state)
    (fresh old : List Bool) :
    run (entryFieldShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.entryField old state := by
  have shapeB : entryFieldShape StairConcrete.bestLoans =
      Rolling1588.placedFirstPacket true ++
        (FourScratchWindow.clearProgram ++
          (renameProgram Prefix1590.borrow
              (entryTailShape StairConcrete.bestLoans) ++
            FourScratchWindow.unprefix)) := by
    simp only [entryFieldShape, List.append_assoc]
  have shapeR : Rolling1588.entryField =
      Rolling1588.placedFirstPacket true ++
        (FourScratchWindow.clearProgram ++
          (renameProgram Prefix1590.borrow Rolling1588.entryTail ++
            FourScratchWindow.unprefix)) := by
    simp only [Rolling1588.entryField, List.append_assoc]
  rw [shapeB, shapeR]
  have firstAt (b : List Bool) :=
    Rolling1588.placedFirstPacket_frame true true origin ctx enabled x hx trace
      Y 0 ⟨fun bad => absurd bad (by decide), fun _ => rfl⟩ state b input
  apply tail_replace _ _ _ state
  · intro a b
    exact run_eq_of_phase _ _ a b (firstAt a).1 (firstAt b).1
  · intro b a c
    have first := firstAt b
    have tailEq := entryTail_run_eq half origin ctx enabled x hx0 hx trace Y
      _ first.2 (a.drop 6) (c.drop 6)
    have tail := Rolling1588.entryTail_frame origin ctx ha enabled x hx0 hx
      trace Y _ (c.drop 6) first.2
    have before := Rolling1588.field_prefix_codes origin ctx _ _ _ first.2 x
      hx0 hx trace
    have after := Rolling1588.canonical_prefix_codes origin ctx _ _ _ tail.2 x
      hx0 hx trace
    have recordClean := FourScratchWindow.canonical_clean origin ctx ha _ _
      tail.2 after.1 after.2.1
    have record768 := Rolling1588.canonical_768_zero origin ctx _ _ _ tail.2
    have windowB := FourScratchWindow.window_run_eq
      (entryTailShape StairConcrete.bestLoans) _ rfl
      (entryTailShape_payload_free half) _ a
      (FourScratchWindow.field_clean origin ctx _ _ _ first.2 before.1
        before.2.1)
      (by rw [tailEq]; exact recordClean)
      (Rolling1588.field_768_zero origin ctx _ _ _ first.2)
      (by rw [tailEq]; exact record768) before.2.2
    have windowR := FourScratchWindow.window_run_eq Rolling1588.entryTail _ rfl
      Rolling1588.entryTail_payload_free _ c
      (FourScratchWindow.field_clean origin ctx _ _ _ first.2 before.1
        before.2.1)
      recordClean
      (Rolling1588.field_768_zero origin ctx _ _ _ first.2)
      record768 before.2.2
    rw [windowB, windowR]
    exact tailEq

end ECDSAAdd.Entrant.StairLoanRecordShape

end
end Merge_StairLoanRecordShape_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanRecordSupport_at_StairSideA` -/
section Merge_StairLoanRecordSupport_at_StairSideA

/-!
# Support of the record-shaped loaned field (`ControlLoan1589` old support)

The record proves every single-wire freeness fact of its hosted field from
`wires entryField ⊆ wires ControlLoan1589.entryField` (`entryField_old_support`).
This module proves the same inclusion for the loaned field
`StairLoanRecordShape.entryFieldShape bestLoans`, from the official half
support (`Half760LoanHypothesis.support`), and then transfers the record's
host, control, logical-omission and work-site facts.

The small record helpers used on the way are private in `QTop.lean`; they
are copied verbatim below.  `wires` and `run` are locally irreducible as in
the record section, so no concrete program is ever unfolded.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordSupport

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoanRecordShape

attribute [local irreducible] wires run

/-! ## Copies of private record helpers -/

private theorem append_sub (P Q P0 Q0 : Program)
    (hp : wires P ⊆ wires P0) (hq : wires Q ⊆ wires Q0) :
    wires (P ++ Q) ⊆ wires (P0 ++ Q0) := by
  rw [wires_append, wires_append]
  exact Finset.union_subset_union hp hq

private theorem rename_sub (f : Wire → Wire) (P Q : Program)
    (sub : wires P ⊆ wires Q) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) := by
  rw [renameProgram_support, renameProgram_support]
  exact Finset.image_mono f sub

private theorem append_extra (P Q P0 Q0 : Program) (extra : Wire)
    (hp : wires P ⊆ wires P0 ∪ {extra}) (hq : wires Q ⊆ wires Q0 ∪ {extra}) :
    wires (P ++ Q) ⊆ wires (P0 ++ Q0) ∪ {extra} := by
  simp only [wires_append] at hp hq ⊢
  intro q used
  rcases Finset.mem_union.mp used with used | used
  · rcases Finset.mem_union.mp (hp used) with old | fresh
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ old)
    · exact Finset.mem_union_right _ fresh
  · rcases Finset.mem_union.mp (hq used) with old | fresh
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ old)
    · exact Finset.mem_union_right _ fresh

private theorem rename_extra (f : Wire → Wire) (P Q : Program) (extra : Wire)
    (fixed : f extra = extra) (sub : wires P ⊆ wires Q ∪ {extra}) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) ∪ {extra} := by
  rw [renameProgram_support, renameProgram_support]
  intro q used
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp used
  rcases Finset.mem_union.mp (sub ha) with old | fresh
  · exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨a, old, rfl⟩)
  · have eq := Finset.mem_singleton.mp fresh
    subst a
    exact Finset.mem_union_right _ (Finset.mem_singleton.mpr fixed)

private theorem rebind_support (a b : Wire) (P : Program) (off : b ∉ wires P) :
    wires (renameProgram (Equiv.swap a b) P) ⊆ wires P ∪ {b} := by
  rw [renameProgram_support]
  intro q used
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp used
  by_cases left : i = a
  · subst i
    exact Finset.mem_union_right _ (by simp)
  have right : i ≠ b := fun eq => off (eq ▸ hi)
  rw [Equiv.swap_apply_of_ne_of_ne left right]
  exact Finset.mem_union_left _ hi

private theorem old_cell_parts (divide : Bool) (j active : Nat) (W : Finset Wire)
    (sub : wires (ControlLoan1589.cell divide j (Rolling1588.g j active)
      (Rolling1588.s j active)) ⊆ W) :
    wires (ControlLoan1589.halfWindow divide j (Rolling1588.g j active)) ⊆ W ∧
      wires (SW.selW (Rolling1588.s j active) (base 2409)
        FrontierSW1591.swapBody) ⊆ W := by
  cases divide <;> simp only [ControlLoan1589.cell, Bool.false_eq_true,
    if_false, if_true, wires_append, Finset.union_subset_iff] at sub ⊢
  · exact sub.symm
  · exact sub

private theorem history_controls (j k : Nat) (hk : k < 5) :
    Rolling1588.g j k ∈ wires (NewHistory5.encode base (5 * j)) ∧
      Rolling1588.s j k ∈ wires (NewHistory5.encode base (5 * j)) := by
  simpa only [Rolling1588.g, Rolling1588.s, NewHistory5.encode_support_eq]
    using Replay5.history_controls (5 * j) k hk

private theorem rawReplay_member (divide : Bool) (j : Nat)
    (letters : List MixedTranscriptLetter) (l : MixedTranscriptLetter)
    (member : l ∈ letters) :
    wires (ControlLoan1589.cell divide j l.1.1 l.1.2) ⊆
      wires (ControlLoan1589.rawReplay divide j letters) := by
  induction letters with
  | nil => simp at member
  | cons head rest ih =>
    cases divide <;> simp only [ControlLoan1589.rawReplay, Bool.false_eq_true,
      if_false, if_true, wires_append]
    all_goals rcases List.mem_cons.mp member with rfl | member
    · exact Finset.subset_union_right
    · exact (ih member).trans Finset.subset_union_left
    · exact Finset.subset_union_left
    · exact (ih member).trans Finset.subset_union_right

private theorem rawReplay_cell_at (divide : Bool) (j active : Nat)
    (hj : j < 102) (ha : active < 5) (letters : List MixedTranscriptLetter)
    (member : tapeLetter (5 * j + active) ∈ letters) :
    wires (ControlLoan1589.cell divide j (Rolling1588.g j active)
      (Rolling1588.s j active)) ⊆
      wires (ControlLoan1589.rawReplay divide j letters) := by
  have sub := rawReplay_member divide j letters _ member
  have tape := mixedTape_base_getD (5 * j + active) (by omega)
  simpa only [tapeLetter, tape, Rolling1588.g, Rolling1588.s,
    Nat.add_assoc] using sub

private theorem onPacket_support_into (j : Nat) (P : Program)
    (support : wires P ⊆ Finset.range 10) (W : Finset Wire)
    (history : wires (NewHistory5.encode base (5 * j)) ⊆ W) :
    wires (Rolling1588.onPacket j P) ⊆ W := by
  rw [Rolling1588.onPacket, renameProgram_support]
  intro q used
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp used
  have bound := Finset.mem_range.mp (support hi)
  simpa only [MeasuredCodec5.label, dif_pos bound] using
    history (NewHistory5.history_site_mem base (5 * j) ⟨i, bound⟩)

private theorem raw_free_extra (P Q : Program)
    (sub : wires P ⊆ wires Q ∪ {base 2409})
    (q : Wire) (away : q ≠ base 2409) (off : q ∉ wires Q) : q ∉ wires P := by
  intro used
  rcases Finset.mem_union.mp (sub used) with old | extra
  · exact off old
  · exact away (Finset.mem_singleton.mp extra)

private theorem hosted_sub (P Q : Program) (sub : wires P ⊆ wires Q) :
    wires (FrontierEntry1591Field.hosted P) ⊆
      wires (FrontierEntry1591Field.hosted Q) :=
  append_sub _ _ _ _ (Finset.Subset.refl _)
    (append_sub _ _ _ _ (rename_sub _ _ _ sub) (Finset.Subset.refl _))

private theorem parity_sub (P Q : Program) (sub : wires P ⊆ wires Q) :
    wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host P) ⊆
    wires (ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host Q) := by
  unfold ParityField1591.program ParityHostTransport5.program
  exact append_sub _ _ _ _ (append_sub _ _ _ _ (Finset.Subset.refl _)
    (rename_sub _ _ _ sub)) (Finset.Subset.refl _)

/-! ## Loaned cells inside the old cells -/

theorem loanHalfWindow_extra (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) (hh : hole < 5) :
    wires (StairGroups.halfWindow divide d j active hole) ⊆
      wires (ControlLoan1589.halfWindow divide j (Rolling1588.g j active)) ∪
        {Rolling1588.s j hole} := by
  let P := Q6EndpointCell.half divide base (base 2409)
  let F := StairLoanAdapter.concreteHalf760Loan divide d
  have sub : wires F ⊆ wires P := fun q used =>
    (Finset.mem_sdiff.mp (half.support divide d hd used)).1
  have off : Rolling1588.s j hole ∉ wires F := fun used =>
    Rolling1588.half_history_free divide _ (Or.inr ⟨by omega, by omega⟩)
      (sub used)
  have fixed : Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j active)
      (Rolling1588.s j hole) = Rolling1588.s j hole :=
    Equiv.swap_apply_of_ne_of_ne (HostOB5.host_ne _ _ (by omega))
      (HostOB5.host_ne _ _ (by omega))
  have mid := rename_extra
    (Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j active))
    (renameProgram (Equiv.swap (base 719) (Rolling1588.s j hole)) F) P
    (Rolling1588.s j hole) fixed
    ((rebind_support (base 719) (Rolling1588.s j hole) F off).trans
      (Finset.union_subset_union sub (Finset.Subset.refl _)))
  have first := append_extra
    [.CX (Rolling1588.g j active) (base 2409),
      .CX (base 2409) (Rolling1588.g j active)] _
    [.CX (Rolling1588.g j active) (base 2409),
      .CX (base 2409) (Rolling1588.g j active)] _ (Rolling1588.s j hole)
    Finset.subset_union_left mid
  have all := append_extra _ [.CX (base 2409) (Rolling1588.g j active),
      .measureX (base 2409) [] [.Z (Rolling1588.g j active)]]
    _ [.CX (base 2409) (Rolling1588.g j active),
      .measureX (base 2409) [] [.Z (Rolling1588.g j active)]]
    (Rolling1588.s j hole) first Finset.subset_union_left
  simpa only [StairGroups.halfWindow, ControlLoan1589.halfWindow,
    ControlLoan1589.loanWindow, ControlLoan1589.packetCarry,
    Rolling1588.packetCarry, P, F] using all

theorem loanCell_support_into (half : HalfReplayHypothesis)
    (divide : Bool) (d j active hole : Nat) (hd : d ≤ 68)
    (hj : j < 102) (ha : active < 5) (hh : hole < 5) (W : Finset Wire)
    (old : wires (ControlLoan1589.cell divide j (Rolling1588.g j active)
      (Rolling1588.s j active)) ⊆ W)
    (history : wires (NewHistory5.encode base (5 * j)) ⊆ W) :
    wires (StairGroups.cell divide d j active hole) ⊆ W := by
  have parts := old_cell_parts divide j active W old
  have halfIn : wires (StairGroups.halfWindow divide d j active hole) ⊆ W := by
    intro q used
    rcases Finset.mem_union.mp
        (loanHalfWindow_extra half divide d j active hole hd hj ha hh used)
      with old | fresh
    · exact parts.1 old
    · have eq := Finset.mem_singleton.mp fresh
      subst q
      exact history (history_controls j hole hh).2
  cases divide <;> simp only [StairGroups.cell, Bool.false_eq_true, if_false,
    if_true, wires_append, Finset.union_subset_iff]
  · exact ⟨parts.2, halfIn⟩
  · exact ⟨halfIn, parts.2⟩

theorem loanBasePacket_old_support (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (hj : j < 102) :
    wires (StairGroups.basePacket divide d j) ⊆
      wires (ControlLoan1589.basePacket divide j) := by
  let W := wires (ControlLoan1589.basePacket divide j)
  have history : wires (NewHistory5.encode base (5 * j)) ⊆ W := by
    simp only [W, ControlLoan1589.basePacket, wires_append]
    exact Finset.subset_union_right
  have old (active : Nat) (ha : active < 5) :
      wires (ControlLoan1589.cell divide j (Rolling1588.g j active)
        (Rolling1588.s j active)) ⊆ W := by
    have member : tapeLetter (5 * j + active) ∈ Replay5.letters j :=
      List.mem_map.mpr ⟨active, List.mem_range.mpr ha, rfl⟩
    have sub := rawReplay_cell_at divide j active hj ha _ member
    exact sub.trans (by
      simp only [W, ControlLoan1589.basePacket, wires_append]
      exact Finset.subset_union_right.trans Finset.subset_union_left)
  have cellAt (active : Nat) (ha : active < 5) :=
    loanCell_support_into half divide d j active 2 hd hj ha (by decide) W
      (old active ha) history
  have opening := onPacket_support_into j Rolling1588.stageOpen
    Rolling1588.stageOpen_support W history
  have closing := onPacket_support_into j Rolling1588.stageClose
    Rolling1588.stageClose_support W history
  have transfer (dir : Bool) (k : Nat) (hk : k < 2) :=
    onPacket_support_into j (Rolling1588.stageTransition dir k)
      (Rolling1588.stageTransition_support dir k hk) W history
  cases divide <;> simp only [StairGroups.basePacket, Bool.false_eq_true,
    if_false, if_true, wires_append, Finset.union_subset_iff]
  all_goals repeat' apply And.intro
  all_goals first
    | exact opening
    | exact closing
    | exact transfer false 0 (by decide)
    | exact transfer false 1 (by decide)
    | exact transfer true 0 (by decide)
    | exact transfer true 1 (by decide)
    | exact cellAt 3 (by decide)
    | exact cellAt 4 (by decide)

theorem loanPacket_old_support (half : HalfReplayHypothesis)
    (divide : Bool) (d j : Nat) (hd : d ≤ 68) (hj : j < 102) :
    wires (StairGroups.packet divide d j) ⊆
      wires (ControlLoan1589.packet divide j) :=
  rename_sub _ _ _ (loanBasePacket_old_support half divide d j hd hj)

theorem loanGroups_old_support (half : HalfReplayHypothesis)
    (divide : Bool) (d : Nat) (hd : d ≤ 68) :
    ∀ (j n : Nat), j + n ≤ 102 →
      wires (StairGroups.groups divide d j n) ⊆
        wires (ControlLoan1589.groups divide j n)
  | _, 0, _ => by
      simp [StairGroups.groups, ControlLoan1589.groups, PacketSequence.program,
        wires]
  | j, n + 1, bound => by
      have head := loanPacket_old_support half divide d j hd (by omega)
      have rest := loanGroups_old_support half divide d hd (j + 1) n (by omega)
      cases divide <;> simp only [StairGroups.groups, ControlLoan1589.groups,
        PacketSequence.program, Bool.false_eq_true, if_false, if_true,
        wires_append, Finset.union_subset_iff] at rest ⊢
      · exact ⟨rest.trans Finset.subset_union_left,
          head.trans Finset.subset_union_right⟩
      · exact ⟨head.trans Finset.subset_union_left,
          rest.trans Finset.subset_union_right⟩

theorem loanSlices_old_support (half : HalfReplayHypothesis) :
    ∀ (L : List (Nat × Nat × Nat)) (c : Nat), ForwardChain c L →
      wires (slices StairConcrete.bestLoans true L) ⊆
        wires (ControlLoan1589.groups true c (sliceCount L))
  | [], _, _ => by
      simp [slices, sliceCount, ControlLoan1589.groups, PacketSequence.program,
        wires]
  | (d, j, n) :: rest, c, chain => by
      obtain ⟨hj, hd, _, bound, hr⟩ := chain
      subst hj
      have head := loanGroups_old_support half true d hd j n bound
      have tail := loanSlices_old_support half rest (j + n) hr
      have split : ControlLoan1589.groups true j (n + sliceCount rest) =
          ControlLoan1589.groups true j n ++
            ControlLoan1589.groups true (j + n) (sliceCount rest) := by
        simp only [ControlLoan1589.groups]
        exact program_true_add _ n (sliceCount rest) j
      simp only [slices, sliceCount, split, wires_append,
        Finset.union_subset_iff]
      exact ⟨head.trans Finset.subset_union_left,
        tail.trans Finset.subset_union_right⟩

theorem entrySlices_old_support (half : HalfReplayHypothesis) :
    wires (slices StairConcrete.bestLoans true entrySliceList) ⊆
      wires (ControlLoan1589.groups true 1 101) := by
  have h := loanSlices_old_support half entrySliceList 1 entrySliceList_chain
  rw [entrySliceList_count] at h
  exact h

/-! ## The loaned division field inside `ControlLoan1589.entryField` -/

/-- Structural union bound, with variable programs. -/
theorem field_shape_union (Pf Cl U A A' E E' C D D' : Program)
    (endSub : wires E' ⊆ wires E) (canonSub : wires D' ⊆ wires D) :
    wires (Pf ++ Cl ++ renameProgram Prefix1590.borrow
        (renameProgram (OB5.sig 511) (A' ++ E') ++ C ++ D') ++ U) ⊆
      wires (Pf ++ Cl ++ renameProgram Prefix1590.borrow
        (renameProgram (OB5.sig 511) (A ++ E) ++ C ++ D) ++ U) ∪
        wires (renameProgram Prefix1590.borrow
          (renameProgram (OB5.sig 511) A')) := by
  have hD : (wires D').image Prefix1590.borrow ⊆
      (wires D).image Prefix1590.borrow :=
    Finset.image_subset_image canonSub
  have hE : ((wires E').image (OB5.sig 511)).image Prefix1590.borrow ⊆
      ((wires E).image (OB5.sig 511)).image Prefix1590.borrow :=
    Finset.image_subset_image (Finset.image_subset_image endSub)
  simp only [wires_append, renameProgram_support, Finset.image_union]
  intro q used
  have hD' := fun h => hD (a := q) h
  have hE' := fun h => hE (a := q) h
  simp only [Finset.mem_union] at used ⊢
  tauto

/-- Structural inclusion of the placed groups in an old-style field, with
variable programs. -/
theorem old_field_groups (Pf Pp Up G E C D : Program) :
    wires (renameProgram Prefix1590.borrow (renameProgram (OB5.sig 511) G)) ⊆
      wires (Pf ++ (Pp ++ (renameProgram Prefix1590.borrow
        (renameProgram (OB5.sig 511) (G ++ E) ++ (C ++ D)) ++ Up))) := by
  simp only [renameProgram, List.map_append, wires_append]
  intro q used
  simp only [Finset.mem_union] at used ⊢
  tauto

theorem entryFieldShape_old_support (half : HalfReplayHypothesis) :
    wires (entryFieldShape StairConcrete.bestLoans) ⊆
      wires ControlLoan1589.entryField := by
  have shapeB : entryFieldShape StairConcrete.bestLoans =
      Rolling1588.placedFirstPacket true ++ FourScratchWindow.clearProgram ++
        renameProgram Prefix1590.borrow
          (renameProgram (OB5.sig 511)
              (slices StairConcrete.bestLoans true entrySliceList ++
                StairConcrete.bestLoans.divEndpoint) ++
            HalfFieldOB5.copyN ++ StairConcrete.bestLoans.canon) ++
        FourScratchWindow.unprefix := by
    unfold entryFieldShape entryTailShape
    rfl
  have shapeR : Rolling1588.entryField =
      Rolling1588.placedFirstPacket true ++ FourScratchWindow.clearProgram ++
        renameProgram Prefix1590.borrow
          (renameProgram (OB5.sig 511)
              (slices StairSchedule.recordLoans true entrySliceList ++
                StairSchedule.recordLoans.divEndpoint) ++
            HalfFieldOB5.copyN ++ R2SqEp760.canon760) ++
        FourScratchWindow.unprefix := by
    rw [← entryFieldShape_record]
    rfl
  have union := field_shape_union (Rolling1588.placedFirstPacket true)
    FourScratchWindow.clearProgram FourScratchWindow.unprefix
    (slices StairSchedule.recordLoans true entrySliceList)
    (slices StairConcrete.bestLoans true entrySliceList)
    StairSchedule.recordLoans.divEndpoint StairConcrete.bestLoans.divEndpoint
    HalfFieldOB5.copyN R2SqEp760.canon760 StairConcrete.bestLoans.canon
    CompareDecoder.BoundaryLoan.Inclusion.endPacket760DivLoan_sub
    StairLoanConverterSupport.canon760Loan_sub
  rw [← shapeB, ← shapeR] at union
  have placed : wires (renameProgram Prefix1590.borrow
      (renameProgram (OB5.sig 511)
        (slices StairConcrete.bestLoans true entrySliceList))) ⊆
      wires ControlLoan1589.entryField :=
    (rename_sub _ _ _ (rename_sub _ _ _ (entrySlices_old_support half))).trans
      (old_field_groups (ControlLoan1589.placedFirstPacket true)
        Prefix1590.prefixProgram Prefix1590.unprefix
        (ControlLoan1589.groups true 1 101) (FrontierSW1591.endPacketS true)
        HalfFieldOB5.copyN ControlLoan1589.canon)
  intro q used
  rcases Finset.mem_union.mp (union used) with old | fresh
  · exact Rolling1588.entryField_old_support old
  · exact placed fresh

/-! ## The loaned hosted field and its single-wire facts -/



theorem entryFieldHostedShape_old_support (half : HalfReplayHypothesis) :
    wires (entryFieldHostedShape StairConcrete.bestLoans) ⊆
      wires ControlLoan1589.entryFieldHosted :=
  parity_sub _ _ (hosted_sub _ _ (entryFieldShape_old_support half))

theorem entryFieldShape_hosts_free (half : HalfReplayHypothesis) :
    base 511 ∉ wires (entryFieldShape StairConcrete.bestLoans) ∧
      base 1542 ∉ wires (entryFieldShape StairConcrete.bestLoans) := by
  have sub := (entryFieldShape_old_support half).trans
    ControlLoan1589.entryField_support
  exact ⟨raw_free_extra _ _ sub _ (by decide)
      (fun used => FrontierEntry1591Field.entryField_host_free.1
        (Prefix1590.entryField_subset used)),
    raw_free_extra _ _ sub _ (by decide)
      (fun used => FrontierEntry1591Field.entryField_host_free.2
        (Prefix1590.entryField_subset used))⟩

theorem entryHostedShape_avoids_host (half : HalfReplayHypothesis) :
    FrontierEntry1591Field.host ∉ wires (FrontierEntry1591Field.hosted
      (entryFieldShape StairConcrete.bestLoans)) := by
  intro used
  have sub := (hosted_sub _ _ (entryFieldShape_old_support half)).trans
    ControlLoan1589.entryHosted_support
  exact FrontierEntry1591Field.entryHosted_avoids_host
    (Prefix1590.entryHosted_subset (sub used))

theorem entryHostedShape_control_free (half : HalfReplayHypothesis) :
    base 2400 ∉ wires (entryFieldHostedShape StairConcrete.bestLoans) := by
  intro used
  exact FrontierEntry1591Field.entry_control_away
    (Prefix1590.entry_subset (ControlLoan1589.entryFieldHosted_support
      (entryFieldHostedShape_old_support half used)))

theorem entryHostedShape_free (half : HalfReplayHypothesis) (i : Nat)
    (hi : i ∈ FrontierEntry1591Callers.logicalOmissions) :
    base i ∉ wires (entryFieldHostedShape StairConcrete.bestLoans) :=
  fun used => ControlLoan1589.entryFieldHosted_free i hi
    (entryFieldHostedShape_old_support half used)

theorem entryHostedShape_work_free (half : HalfReplayHypothesis) :
    ∀ q ∈ FrontierEntry1591Native.workSites,
      q ∉ wires (entryFieldHostedShape StairConcrete.bestLoans) := by
  intro q member
  simp only [FrontierEntry1591Native.workSites, List.mem_toFinset,
    List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl
  all_goals exact entryHostedShape_free half _ (by simp [FrontierEntry1591Callers.logicalOmissions])

