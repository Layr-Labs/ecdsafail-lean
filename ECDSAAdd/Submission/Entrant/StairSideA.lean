set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairRestSupport

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

/-- The raw label domain of `wireFn2`, stated on `Nat` so that `omega` sees it. -/
def InDomN (n : Nat) : Prop := (16 ≤ n ∧ n < 2330) ∨ (2416 ≤ n ∧ n < 2428)

def InDom (q : Wire) : Prop := InDomN q

instance instDecidableInDomN (n : Nat) : Decidable (InDomN n) :=
  inferInstanceAs (Decidable ((16 ≤ n ∧ n < 2330) ∨ (2416 ≤ n ∧ n < 2428)))

instance instDecidableInDom (q : Wire) : Decidable (InDom q) :=
  inferInstanceAs (Decidable (InDomN q))

/-- Every wire of the program lies in the label domain. -/
def Good (P : Program) : Prop := ∀ q ∈ wires P, InDom q










theorem good_of_list {P : Program} (l : List Wire) (h : wires P ⊆ l.toFinset)
    (hl : ∀ q ∈ l, InDom q) : Good P :=
  fun q hq => hl q (List.mem_toFinset.mp (h hq))

