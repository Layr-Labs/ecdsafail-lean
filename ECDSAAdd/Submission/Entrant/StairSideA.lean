/-- Support list + one check over the list. -/
theorem ok39_of_cover {f : Wire → Wire} {P : Program} (S : List Wire)
    (hS : ∀ x ∈ wires P, x ∈ S) (hc : ∀ x ∈ S, Good39 (f x)) :
    PieceOK StairCertificate.holes39 f P :=
