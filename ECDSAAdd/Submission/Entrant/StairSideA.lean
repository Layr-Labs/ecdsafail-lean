  have e := StairLoanFieldSupport.placedEnd68_sub
  unfold StairSchedule.placedEndPacket at e
  unfold headShape
  rw [rename_append', rename_append']
  exact StairLoanGroupSupport.append_sub _ _ _ _
    (StairLoanGroupSupport.append_sub _ _ _ _ StairLoanConverterSupport.bestCenter_sub
      (Finset.Subset.refl _))
    (StairLoanGroupSupport.append_sub _ _ _ _ e (slices_false_sub L c low chain))

theorem shape_sub_gen (A B C D F : Program) (f : Wire → Wire) :
    wires (A ++ B ++ renameProgram f (C ++ D)) ⊆
      wires (A ++ B ++ renameProgram f (C ++ (D ++ F))) := by
  intro q hq
  simp only [rename_append', wires_append, Finset.mem_union] at hq ⊢
  tauto

theorem headShape_record_eq (L : List (Nat × Nat × Nat)) :
    headShape StairSchedule.recordLoans L =
      R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
        renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false ++
          slices StairSchedule.recordLoans false L) := by
