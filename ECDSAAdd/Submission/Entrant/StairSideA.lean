/-! ## Carry-loan boundary

This is the exact interface promised by LT4 for the still-unpublished
`half760Loan`: the same `PairFrame` and clean-work precondition as the record
half, exact `4*d` resource deltas, omission of the retired logical roles, and
physicality. -/

structure Half760LoanHypothesis
    (half760Loan : Bool → Nat → Program) : Prop where
  run_eq : ∀ divide d, d ≤ 68 → ∀ origin,
    Q6EndpointCell.Clean base origin → ∀ X Y s fresh old,
    PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis →
    run (half760Loan divide d) fresh s =
      run (Q6EndpointCell.half divide base (base 2409)) old s
  counts : ∀ divide d, d ≤ 68 →
    toffoliCount (half760Loan divide d) =
        toffoliCount (Q6EndpointCell.half divide base (base 2409)) + 4 * d ∧
      measurementCount (half760Loan divide d) =
        measurementCount (Q6EndpointCell.half divide base (base 2409)) + 4 * d
  support : ∀ divide d, d ≤ 68 →
    wires (half760Loan divide d) ⊆
      wires (Q6EndpointCell.half divide base (base 2409)) \
        (StairLoan.retiredRoles.take d).toFinset
  physical : ∀ divide d, d ≤ 68 → GatePhysical (half760Loan divide d)


