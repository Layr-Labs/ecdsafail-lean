  exact k1_ztAll_append_true lo width false _ _ _ hr' (k3_ztAll_drop _ _ _ _ _ _ hDown)
    (ztAll_true_of_not_mem lo width _ _ hr' (fun w hw =>
      k3_downs_sub w _ _ mid (hDowns w (List.mem_of_mem_drop hw))))

