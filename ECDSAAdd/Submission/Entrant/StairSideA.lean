  rw [if_neg c1, if_neg c2]

/-- Body wires checked directly (moved by a swap, or `normFlag`). -/
def bodySpecial : List Nat := [4113, 4761, 4832, 4833, 4834, 4875, 4880, 4881, 4882, 4883, 4884, 4885]

theorem bodySpecial_ok : ∀ x ∈ bodySpecial, LT48K.bodyGoodF x = true := by
