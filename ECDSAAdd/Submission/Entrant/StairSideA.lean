  · simp only [if_true]
    exact wires_sub_of_parts _ _ (wires_sub_of_parts _ _ (wires_sub_of_parts _ _
      (wires_sub_of_parts _ _ (wires_sub_of_parts _ _ (wires_sub_of_parts _ _
        (cl 3 (by omega)) (cl 4 (by omega))) o3) (cl 4 (by omega))) (cl 3 (by omega)))
      o5) (cl 4 (by omega))

theorem pi_fix (j : Nat) (hj : j ≤ 101) (i : Nat) (hi : 2314 ≤ i) : Placement5.pi j i = i := by
  unfold Placement5.pi
  simp only [Equiv.trans_apply]
  have w1 : i ≠ Placement5.W (2 * j) := by unfold Placement5.W; omega
  have w2 : i ≠ Placement5.W (2 * j + 1) := by unfold Placement5.W; omega
  have h1 : i ≠ Placement5.H (2 * j) := by unfold Placement5.H; omega
  have h2 : i ≠ Placement5.H (2 * j + 1) := by unfold Placement5.H; omega
  have h3 : i ≠ Placement5.H 202 := by unfold Placement5.H; omega
  have h4 : i ≠ Placement5.H 203 := by unfold Placement5.H; omega
  rw [Equiv.swap_apply_of_ne_of_ne w1 h1, Equiv.swap_apply_of_ne_of_ne w2 h2,
    Equiv.swap_apply_of_ne_of_ne h1 h3, Equiv.swap_apply_of_ne_of_ne h2 h4]
  apply Placement5.pi0_outside
  unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
  omega

theorem pi_lt (j : Nat) (hj : j ≤ 101) (i : Nat) (hi : i < 2314) : Placement5.pi j i < 2314 := by
  by_contra hc
  have big : 2314 ≤ Placement5.pi j i := by omega
  have fix := pi_fix j hj _ big
  have same : Placement5.pi j i = Placement5.pi j (Placement5.pi j i) := fix.symm
  have eq := (Placement5.pi j).injective same
  omega

theorem preserves_shifted_pi (j : Nat) (hj : j ≤ 101) :
    PreservesCaller (shifted (Placement5.pi j)) := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := caller_index q hq
  rw [shifted_base]
  rcases hi with h | h | h | h | h
  · exact base_mem_caller _ (Or.inl (pi_lt j hj i h))
  · subst h
    rw [pi_fix j hj 2400 (by norm_num)]
    exact base_mem_caller 2400 (by decide)
  · subst h
    rw [pi_fix j hj 2409 (by norm_num)]
    exact base_mem_caller 2409 (by decide)
  · subst h
    rw [pi_fix j hj 2410 (by norm_num)]
    exact base_mem_caller 2410 (by decide)
  · subst h
    rw [pi_fix j hj 2411 (by norm_num)]
    exact base_mem_caller 2411 (by decide)

theorem packet_caller (divide : Bool) (d j : Nat)
    (hHalf : wires (StairLoan.half760Loan d divide) ⊆ callerDomain) (hj : j ≤ 101) :
    wires (StairGroups.packet divide d j) ⊆ callerDomain := by
  unfold StairGroups.packet
