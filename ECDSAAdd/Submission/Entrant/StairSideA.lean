  Q6EndpointCell.ports base (base 2409)

theorem join_records (P Q : Program) (s : State)
    (m n : List Bool) :
    ∃ records, run (P ++ Q) records s = run Q n (run P m s) := by
  let headRecords :=
    (m ++ List.replicate (measurementCount P) false).take
      (measurementCount P)
  have headLength : headRecords.length = measurementCount P := by
    simp only [headRecords, List.length_take, List.length_append,
      List.length_replicate]
    omega
  have headRun : run P headRecords s = run P m s := by
    change run P
      ((m ++ List.replicate (measurementCount P) false).take
        (measurementCount P)) s = _
    rw [run_take, run_pad_false]
  have take :
      (headRecords ++ n).take (measurementCount P) = headRecords := by
    rw [List.take_append, headLength, Nat.sub_self, List.take_zero,
      List.append_nil, ← headLength, List.take_length]
  have drop : (headRecords ++ n).drop (measurementCount P) = n := by
    rw [List.drop_append, headLength, Nat.sub_self, List.drop_zero,
      ← headLength, List.drop_length, List.nil_append]
  refine ⟨headRecords ++ n, ?_⟩
  rw [run_append, take, drop, headRun]

theorem replace_middle_exists (A P Q R : Program) (s : State)
    (m : List Bool)
    (middle : ∀ x y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s)) :
    ∃ n, run (A ++ P ++ R) m s = run (A ++ Q ++ R) n s := by
  let u := run A (m.take (measurementCount A)) s
  let pm := (m.drop (measurementCount A)).take (measurementCount P)
  let rm := m.drop (measurementCount A + measurementCount P)
  have loan : run (A ++ P ++ R) m s = run R rm (run P pm u) := by
    simp only [List.append_assoc, run_append, run_take, u, pm, rm]
    rw [List.drop_drop, Nat.add_comm]
  obtain ⟨nAQ, hAQ⟩ :=
    join_records A Q s (m.take (measurementCount A)) []
  obtain ⟨nAll, hAll⟩ := join_records (A ++ Q) R s nAQ rm
  refine ⟨nAll, ?_⟩
  rw [loan, middle pm [], ← hAQ, ← hAll]

theorem normalizeLoan_run_eq (d : Nat) (hd : d ≤ 68)
    (s : State) (fresh old : List Bool)
    (one : s.basis L760.one = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false)
    (high : s.basis L760.rmsb = false) :
    run (StairLoan.normalizeLoan d L760) fresh s =
      run (Q6LifetimeResearch.normalize (base 760) L760) old s := by
  let e := Equiv.swap (base 760) L760.rmsb
  let t := pullState e s
  -- K4-D (replay budget): every finite fact about `L760` in ONE kernel evaluation
  have K4N : (L760.one ≠ base 760 ∧ L760.one ≠ L760.rmsb) ∧ L760.rmsb ∉ L760.carry ∧
      ECDSAAdd.Entrant.StairLoan.nodupMask (L760.one :: L760.lower :: (L760.low ++ L760.carry.take 254)) 0 = true ∧
      (L760.carry.take 254).length + 1 = L760.low.length ∧
      BalancedCleanup.negativeLiteral < 2 ^ L760.low.length ∧ L760.carry.length = 256 := by
    decide +kernel
  have oneAway : L760.one ≠ base 760 ∧ L760.one ≠ L760.rmsb := K4N.1
  have oneT : t.basis L760.one = false := by
    change s.basis (e L760.one) = false
    rw [show e L760.one = L760.one from
      Equiv.swap_apply_of_ne_of_ne oneAway.1 oneAway.2]
    exact one
  have highAway : L760.rmsb ∉ L760.carry := K4N.2.1
  have cleanT : ∀ q ∈ L760.carry.take 254, t.basis q = false := by
    intro q hq
    change s.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = L760.rmsb from
        Equiv.swap_apply_left _ _]
      exact high
    · have qh : q ≠ L760.rmsb := fun eq => highAway
        (eq ▸ List.mem_of_mem_take hq)
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qh]
      exact clean q (List.mem_of_mem_take hq)
  have nd : (L760.one :: L760.lower ::
      (L760.low ++ L760.carry.take 254)).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4N.2.2.1
  have carryLength :
      (L760.carry.take 254).length + 1 = L760.low.length := K4N.2.2.2.1
  have literalBound :
      BalancedCleanup.negativeLiteral < 2 ^ L760.low.length := K4N.2.2.2.2.1
  have depth : d + 1 ≤ (L760.carry.take 254).length := by
    have width : L760.carry.length = 256 := K4N.2.2.2.2.2
    simp only [List.length_take]
    omega
  have roleTail := StairLoan.retiredRoles_tail254 d hd
  apply StairLoan.renameProgram_run_eq_of e
  simpa only [StairLoan.normalizeLoan, Q6LifetimeResearch.normalize,
    Q6LifetimeResearch.move, BalancedCleanup.normalize] using
    (StairLoan.literalConstAddLoan_run_eq d StairLoan.retiredRoles
      L760.low (L760.carry.take 254) L760.lower L760.one
      BalancedCleanup.negativeLiteral t fresh old nd carryLength
      literalBound depth oneT cleanT roleTail)

theorem unfoldLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (fresh : List Bool)
    (lower : s.basis L760.lower = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false) :
    ∃ old, run (StairLoan.unfoldLoan d L760) fresh s =
      run (Q6LifetimeResearch.unfoldStep (base 760) L760) old s := by
  let A : Program :=
    [.CX L760.parity L760.lower, .CX L760.rmsb L760.lower,
      .CCX L760.parity L760.lower L760.one,
      .CX L760.lower L760.rmsb, .CX L760.parity L760.rmsb]
  let P := Q6LifetimeResearch.move (base 760) L760.rmsb
    (StairLoan.mappedSubLoan d StairLoan.retiredRoles
      (ShortBiasedFold.lowBits L760) L760.low
      (L760.carry.take 254) L760.one)
  let Q := Q6LifetimeResearch.move (base 760) L760.rmsb
    (mappedSub (ShortBiasedFold.lowBits L760) L760.low
      (L760.carry.take 254) L760.one)
  let R : Program :=
    [.CX L760.parity L760.rmsb, .CX L760.lower L760.rmsb,
      .CX L760.parity L760.rmsb, .CX L760.rmsb L760.lower,
      .measureX L760.one [] [.CZ L760.parity L760.rmsb]]
  let u := run A (fresh.take (measurementCount A)) s
  let e := Equiv.swap (base 760) L760.rmsb
  -- K4-D (replay budget): every finite fact about `L760` in ONE kernel evaluation
  have K4U : L760.one ∉ L760.carry ∧ L760.rmsb ∉ L760.carry ∧ L760.lower ∉ L760.carry ∧
      L760.parity ∉ L760.carry ∧ L760.lower ≠ L760.rmsb ∧ L760.parity ≠ L760.lower ∧
      L760.parity ≠ L760.rmsb ∧ L760.one ≠ L760.lower ∧ L760.one ≠ L760.rmsb ∧ L760.one ≠ L760.parity ∧
      ECDSAAdd.Entrant.StairLoan.nodupMask (L760.one :: (L760.low ++ L760.carry.take 254)) 0 = true ∧
      (ShortBiasedFold.lowBits L760).length = L760.low.length ∧
      (L760.carry.take 254).length + 1 = L760.low.length ∧ L760.carry.length = 256 := by
    decide +kernel
  have oneAway : L760.one ∉ L760.carry := K4U.1
  have highAway : L760.rmsb ∉ L760.carry := K4U.2.1
  have uHigh : u.basis L760.rmsb = false := by
    simp [u, A, run, writeBit, lower,
      (K4U.2.2.2.2.1 : L760.lower ≠ L760.rmsb),
      (Ne.symm K4U.2.2.2.2.1 : L760.rmsb ≠ L760.lower),
      (K4U.2.2.2.2.2.1 : L760.parity ≠ L760.lower),
      (Ne.symm K4U.2.2.2.2.2.1 : L760.lower ≠ L760.parity),
      (K4U.2.2.2.2.2.2.1 : L760.parity ≠ L760.rmsb),
      (Ne.symm K4U.2.2.2.2.2.2.1 : L760.rmsb ≠ L760.parity),
      (K4U.2.2.2.2.2.2.2.1 : L760.one ≠ L760.lower),
      (Ne.symm K4U.2.2.2.2.2.2.2.1 : L760.lower ≠ L760.one),
      (K4U.2.2.2.2.2.2.2.2.1 : L760.one ≠ L760.rmsb),
      (Ne.symm K4U.2.2.2.2.2.2.2.2.1 : L760.rmsb ≠ L760.one),
      (K4U.2.2.2.2.2.2.2.2.2.1 : L760.one ≠ L760.parity),
      (Ne.symm K4U.2.2.2.2.2.2.2.2.2.1 : L760.parity ≠ L760.one)]
    cases s.basis L760.parity <;> cases s.basis L760.rmsb <;> rfl
  have uClean : ∀ q ∈ L760.carry, u.basis q = false := by
    intro q hq
    have qo : q ≠ L760.one := fun eq => oneAway (eq ▸ hq)
    have qh : q ≠ L760.rmsb := fun eq => highAway (eq ▸ hq)
    have ql : q ≠ L760.lower := by
      intro eq
      subst q
      have : L760.lower ∉ L760.carry := K4U.2.2.1
      exact this hq
    have qp : q ≠ L760.parity := by
      intro eq
      subst q
      have : L760.parity ∉ L760.carry := K4U.2.2.2.1
      exact this hq
    simp only [u, A, measurementCount, List.take_zero, run, writeBit,
      Function.update_of_ne qo, Function.update_of_ne qh,
      Function.update_of_ne ql, Function.update_of_ne qp]
    exact clean q hq
  have pulledClean : ∀ q ∈ L760.carry.take 254,
      (pullState e u).basis q = false := by
    intro q hq
    change u.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = L760.rmsb from
        Equiv.swap_apply_left _ _]
      exact uHigh
    · have qh : q ≠ L760.rmsb := fun eq => highAway
        (eq ▸ List.mem_of_mem_take hq)
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qh]
      exact uClean q (List.mem_of_mem_take hq)
  have nd : (L760.one :: (L760.low ++ L760.carry.take 254)).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ K4U.2.2.2.2.2.2.2.2.2.2.1
  have sourceAway : ∀ q ∈ mappedWires (ShortBiasedFold.lowBits L760),
      q ∉ L760.one :: (L760.low ++ L760.carry.take 254) := by
    intro q hq
    rw [OneReuse.lowBits_source L760 q hq]
    decide +kernel
  have bitsLength :
      (ShortBiasedFold.lowBits L760).length = L760.low.length := K4U.2.2.2.2.2.2.2.2.2.2.2.1
  have carryLength :
      (L760.carry.take 254).length + 1 = L760.low.length := K4U.2.2.2.2.2.2.2.2.2.2.2.2.1
  have depth : d + 1 ≤ (L760.carry.take 254).length := by
    have width : L760.carry.length = 256 := K4U.2.2.2.2.2.2.2.2.2.2.2.2.2
    simp only [List.length_take]
    omega
  have roleTail := StairLoan.retiredRoles_tail254 d hd
  have middle : ∀ x y, run P x u = run Q y u := by
    intro x y
    apply StairLoan.renameProgram_run_eq_of e
    exact StairLoan.mappedSubLoan_run_eq d StairLoan.retiredRoles
      (ShortBiasedFold.lowBits L760) L760.low (L760.carry.take 254)
      L760.one (pullState e u) x y nd sourceAway bitsLength
      carryLength depth pulledClean roleTail
  have replaced := replace_middle_exists A P Q R s fresh middle
  simpa only [StairLoan.unfoldLoan, Q6LifetimeResearch.unfoldStep,
    A, P, Q, R, List.append_assoc] using replaced

