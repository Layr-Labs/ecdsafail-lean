/-- K4-B (replay budget): the three facts of `rest_hosts_fit` as one linear Boolean pass
(bit-mask duplicate scan, bit-mask membership, length). -/
def kbRestCheck (B : Nat) : Bool :=
  StairLoan.nodupMask (restSites B ++ hosts B) 0 &&
    (restSites B ++ hosts B).all (fun q => (StairLoan.maskOf (futurePayload B)).testBit q) &&
    (B != 87 || (restSites B ++ hosts B).length == (futurePayload B).length)

theorem kbRestCheck_ok : ∀ B ∈ budgets, kbRestCheck B = true := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

/-- Rest storage and hosts are disjoint and exhaust the future payload exactly
at the first row, and fit inside it at every row. -/
theorem rest_hosts_fit : ∀ B ∈ budgets,
    (restSites B ++ hosts B).Nodup ∧
      (∀ q ∈ restSites B ++ hosts B, q ∈ futurePayload B) ∧
      (B = 87 → (restSites B ++ hosts B).length = (futurePayload B).length) := by
  intro B hB
  have h := kbRestCheck_ok B hB
  unfold kbRestCheck at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.or_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨StairLoan.nodup_of_mask _ h1,
    fun q hq => StairLoan.mem_of_maskOf (List.all_eq_true.mp h2 q hq), fun e => ?_⟩
  subst e
  rcases h3 with h3 | h3
  · exact absurd h3 (by decide)
  · exact beq_iff_eq.mp h3




theorem kbMove_counts (a b : Wire) :
    toffoliCount (moveWire a b) = 0 ∧ measurementCount (moveWire a b) = 0 := ⟨rfl, rfl⟩

theorem kbCounts_flatMap {α : Type} (l : List α) (f : α → Program)
    (h : ∀ x, toffoliCount (f x) = 0 ∧ measurementCount (f x) = 0) :
    toffoliCount (l.flatMap f) = 0 ∧ measurementCount (l.flatMap f) = 0 := by
  induction l with
  | nil => exact ⟨rfl, rfl⟩
  | cons a l ih =>
    rw [List.flatMap_cons, toffoliCount_append, measurementCount_append, (h a).1, (h a).2,
      ih.1, ih.2]
    exact ⟨rfl, rfl⟩

/-- K4-B (replay budget): structural (`relocate` is CX-only), no evaluation. -/
theorem relocate_counts : ∀ B ∈ budgets,
    toffoliCount (relocate B) = 0 ∧ measurementCount (relocate B) = 0 ∧
      toffoliCount (unrelocate B) = 0 ∧ measurementCount (unrelocate B) = 0 := by
  intro B _
  have m1 := kbCounts_flatMap (List.range (B - 2))
    (fun i => moveWire ((physicalLayout B).D i) ((physicalLayout B).S i)) (fun _ => kbMove_counts _ _)
  have m2 := kbCounts_flatMap (List.range (B - 2))
    (fun i => moveWire ((physicalLayout B).S i) ((physicalLayout B).D i)) (fun _ => kbMove_counts _ _)
  have m3 := kbMove_counts ((physicalLayout B).D (B - 1)) ((physicalLayout B).S (B - 2))
  have m4 := kbMove_counts ((physicalLayout B).S (B - 2)) ((physicalLayout B).D (B - 1))
  unfold relocate unrelocate
  rw [toffoliCount_append, measurementCount_append, toffoliCount_append, measurementCount_append,
    m1.1, m1.2, m2.1, m2.2, m3.1, m3.2, m4.1, m4.2]
  exact ⟨rfl, rfl, rfl, rfl⟩

/-! ## Physicality -/

































/-! ## Phase context of the first budget

`pack 87` runs inside `Rolling1588Lifetime.phaseHost` (`stackForward6`) and
`unpack 87` inside `lastXN`.  There the record walk leaves the b-rail on the
x I/O word (`base 770 ..`).  The phase-side codec must be relabelled by
`phaseRelabel`, and the b-rail moved onto `bSite`, so that both contexts use
the same physical sites. -/


/- LT6 (benchmark replay budget): the unreferenced diagnostic `phase_codec_agree`
(`∀ q ∈ StairCodec.declaredSites (physicalLayout 87) 87, phasePlace (phaseRelabel q) = place q`,
one `decide +kernel`, ≈ 250 s of kernel time — LT27 profile b14) is omitted; restore it from
CANON_OUT/Entrant_1823 if a field proof needs it. -/

def phaseBMove : Program :=
