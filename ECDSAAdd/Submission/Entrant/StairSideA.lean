/-!
# Plan-independent gate-slot lemmas

The reusable part of the field-11 slot ledger (`StairSlots`), separated from
the eight-row schedule so that it survives re-plans of the checkpoint table:
loan and group slot bounds, the endpoint loan, wire-blind tick and moved-walk
slot equalities, and additivity of the record walks and packet groups.
Every statement is about generic programs or record programs; nothing here
refers to a checkpoint table, a host plan, or a concrete assembly.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSlotsLib

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines

attribute [local irreducible] Rolling1588Lifetime.endHalf Rolling1588Lifetime.rawEnd Rolling1588Lifetime.endPacket R2SqEp760.endPacket760






























/-! ## The four loaned tops in each balanced half -/









/-! ## Packet groups and the multiplication endpoint -/

















theorem addInPlace_slots_exact (x y carry : List Wire) (cin : Wire)
    (hxy : x.length = y.length) (hc : carry.length + 1 = y.length)
    (hn : 1 ≤ y.length) :
    gateSlots (addInPlace x y carry cin) = 12 * y.length - 10 := by
  induction y generalizing x carry cin with
  | nil => simp at hn
  | cons b bs ih =>
      cases x with
      | nil => simp at hxy
      | cons a as =>
          cases bs with
          | nil =>
              have ha : as = [] := List.eq_nil_of_length_eq_zero (by
                simp only [List.length_cons, List.length_nil] at hxy
                omega)
              subst as
              simp [addInPlace, gateSlots_cons, gateSlots_nil, instructionSlots]
          | cons b' bs =>
              cases as with
              | nil => simp at hxy
              | cons a' as =>
                  cases carry with
                  | nil => simp at hc
                  | cons c cs =>
                      have hxy' : (a' :: as).length = (b' :: bs).length := by
                        simp only [List.length_cons] at hxy ⊢
                        omega
                      have hc' : cs.length + 1 = (b' :: bs).length := by
                        simp only [List.length_cons] at hc ⊢
                        omega
                      have hn' : 1 ≤ (b' :: bs).length := by simp
                      have tail := ih (a' :: as) cs c hxy' hc' hn'
                      simp only [addInPlace, gateSlots_append, majority_gateSlots,
                        eraseCarry_gateSlots, gateSlots_cons, gateSlots_nil,
                        instructionSlots, List.length_cons] at tail ⊢
                      omega

theorem receiverAdd_slots_exact (x y carry : List Wire) (cin : Wire)
    (hxy : x.length = y.length) (hc : carry.length + 1 = y.length)
    (hn : 2 ≤ y.length) :
    gateSlots (W.ReverseCarry.receiverAdd x y carry cin) =
      12 * y.length - 17 := by
  induction y generalizing x carry cin with
  | nil => simp at hn
  | cons b bs ih =>
      cases x with
      | nil => simp at hxy
      | cons a as =>
          cases bs with
          | nil => simp at hn
          | cons b' bs =>
              cases as with
              | nil => simp at hxy
              | cons a' as =>
                  cases carry with
                  | nil => simp at hc
                  | cons c cs =>
                      by_cases top : as = [] ∧ bs = []
                      · rcases top with ⟨rfl, rfl⟩
                        simp [W.ReverseCarry.receiverAdd, gateSlots_append,
                          gateSlots_cons, gateSlots_nil, instructionSlots]
                      · have hbs : bs ≠ [] := by
                          intro hnil
                          subst bs
                          have has : as = [] := List.eq_nil_of_length_eq_zero (by
                            simp only [List.length_cons, List.length_nil] at hxy
                            omega)
                          exact top ⟨has, rfl⟩
                        have hxy' : (a' :: as).length = (b' :: bs).length := by
                          simp only [List.length_cons] at hxy ⊢
                          omega
                        have hc' : cs.length + 1 = (b' :: bs).length := by
                          simp only [List.length_cons] at hc ⊢
                          omega
                        have hn' : 2 ≤ (b' :: bs).length := by
                          cases bs <;> simp_all
                        have tail := ih (a' :: as) cs c hxy' hc' hn'
                        simp only [W.ReverseCarry.receiverAdd, top, if_false,
                          gateSlots_append, majority_gateSlots, eraseCarry_gateSlots,
                          gateSlots_cons, gateSlots_nil, instructionSlots,
                          List.length_cons, List.length_nil] at hc tail ⊢
                        omega

theorem narrowSignedRecord_slots_exact (L : NarrowSignedRecordLayout)
    (n : Nat) (hw : L.Widths n) (hn : 1 ≤ n) :
    gateSlots (narrowSignedRecord L n) = 13 * n + L.y.length - 4 := by
  have v := L.views n hw
  have hp : 1 ≤ L.yp.length := by rw [hw.y]; exact hn
  have ha := addInPlace_slots_exact L.xp L.yp L.carryLow L.q
    (hw.x.trans hw.y.symm) (hw.carry.trans hw.y.symm) hp
  simp only [narrowSignedRecord, signedRecord, signedAdd,
    v.1, v.2.1, v.2.2.1, v.2.2.2, gateSlots_append,
    signComplement_gateSlots, skywalkSignToggle, gateSlots_cons,
    gateSlots_nil, instructionSlots] at ha ⊢
  simp only [NarrowSignedRecordLayout.y, List.length_append] at *
  rw [hw.y] at ha
  rw [hw.x, hw.y]
  omega

theorem narrowReceiver_slots_exact (L : NarrowSignedRecordLayout)
    (n : Nat) (hw : L.Widths n) (hn : 2 ≤ n) :
    gateSlots (W.ReverseCarry.narrowReceiver L n) =
      15 * n + L.y.length - 11 := by
  have v := L.views n hw
  have hp : 2 ≤ L.yp.length := by rw [hw.y]; exact hn
  have ha := receiverAdd_slots_exact L.xp L.yp L.carryLow L.q
    (hw.x.trans hw.y.symm) (hw.carry.trans hw.y.symm) hp
  simp only [W.ReverseCarry.narrowReceiver,
    W.ReverseCarry.receiverUnrecord, W.ReverseCarry.receiverSub,
    v.1, v.2.1, v.2.2.1, v.2.2.2, gateSlots_append,
    signComplement_gateSlots, notRegister_gateSlots, skywalkSignToggle,
    gateSlots_cons, gateSlots_nil, instructionSlots] at ha ⊢
  simp only [NarrowSignedRecordLayout.y, List.length_append] at *
  rw [hw.y] at ha
  rw [hw.x, hw.y]
  omega

theorem repairedRoute_slots_formula (L : SkywalkIntegerLayout)
    (hv : L.Valid) :
    gateSlots (W.repairedRoute L) = 3 * L.aMid.length + 8 := by
  have hm := hv.mids
  simp only [W.repairedRoute, W.repairedSwap, gateSlots_append,
    swapRegisters_gateSlots, W.signRepair, gateSlots_cons, gateSlots_nil,
    instructionSlots, List.length_cons, List.length_nil]
  rw [Nat.min_eq_left hm.le]

theorem compactCleanup_slots_formula (w : Nat → Wire) (i : Nat)
    (hi : i < 512) :
    gateSlots (W.compactSkywalkTickCleanup w i) =
      2 * (W.compactSkywalkTickPreWidth i -
        W.compactSkywalkTickPostWidth i) := by
  have hb := W.compactSkywalkTick_width_bounds i hi
  simp only [W.compactSkywalkTickCleanup, W.compactSkywalkTickARelease,
    W.compactSkywalkTickBRelease, compactSkywalkSignRelease,
    compactSkywalkSignWord, gateSlots_append, signComplement_gateSlots,
    List.length_drop, W.compactSkywalkTick_half w i hi,
    W.compactSkywalkTick_b w i hi, wireBlock_length]
  omega


theorem receiverTick_slots_formula (w : Nat → Wire) (i : Nat)
    (h0 : 385 ≤ i) (h1 : i ≤ 509)
    (hn : (skywalkPoolWires w).Nodup) :
    gateSlots (W.ReverseCarry.compactReceiverTick w i) =
      6 * W.compactSkywalkTickPreWidth i +
        13 * W.compactSkywalkTickPostWidth i - 11 := by
  let L := W.compactSkywalkTickLayout w i
  let n := W.compactSkywalkTickPostWidth i
  have hi : i < 512 := by omega
  have hb := W.compactSkywalkTick_width_bounds i hi
  have hv : L.Valid := W.compactSkywalkTick_valid w i hi hn
  have hle : n ≤ L.half.length := by
    dsimp only [L, n]
    rw [W.compactSkywalkTick_half w i hi, wireBlock_length]
    omega
  have hw := narrowSkywalkRecord_widths L hv n (by omega) hle
  have hrec := narrowReceiver_slots_exact
    (narrowSkywalkRecordLayout L n) n hw (by omega)
  have hview := narrowSkywalkRecord_views L hv n (by omega) hle
  rw [hview.2.1] at hrec
  have hbLen : L.b.length = W.compactSkywalkTickPreWidth i := by
    dsimp only [L]
    rw [W.compactSkywalkTick_b w i hi, wireBlock_length]
  rw [hbLen] at hrec
  have hahLen : L.ah.length = W.compactSkywalkTickPreWidth i - 1 := by
    dsimp only [L]
    rw [W.compactSkywalkTick_ah w i hi, wireBlock_length]
  have hbhLen : L.bh.length = W.compactSkywalkTickPreWidth i - 1 := by
    have hh := L.high_lengths hv
    omega
  have hc := compactCleanup_slots_formula w i hi
  have hexpand : gateSlots (W.compactSkywalkReverseExpand w i) =
      gateSlots (W.compactSkywalkTickCleanup w i) := by
    simp only [W.compactSkywalkReverseExpand, W.compactSkywalkTickCleanup,
      compactSkywalkSignExpand, compactSkywalkSignRelease,
      gateSlots_append, signComplement_gateSlots]
    omega
  have notLast : i ≠ 511 := by omega
  have notTrim : ¬W.trimTick i := by
    unfold W.trimTick
    omega
  simp only [W.ReverseCarry.compactReceiverTick, notLast, if_false,
    W.ReverseCarry.untick2, notTrim, W.ReverseCarry.receiverUntick,
    gateSlots_append, skywalkSignedHalf, gateSlots_cons, gateSlots_nil,
    instructionSlots, swapRegisters_gateSlots] at ⊢
  change gateSlots (W.compactSkywalkReverseExpand w i) +
      (1 + gateSlots (W.ReverseCarry.narrowReceiver
        (narrowSkywalkRecordLayout L n) n) + 1 + 1 +
        3 * min L.ah.length L.bh.length) = _
  rw [hexpand, hc, hrec, hahLen, hbhLen, min_self]
  omega


theorem receiverTick_slots_map (w v : Nat → Wire) (i : Nat)
    (h0 : 385 ≤ i) (h1 : i ≤ 509)
    (hw : (skywalkPoolWires w).Nodup)
    (hv : (skywalkPoolWires v).Nodup) :
    gateSlots (W.ReverseCarry.compactReceiverTick w i) =
      gateSlots (W.ReverseCarry.compactReceiverTick v i) := by
  rw [receiverTick_slots_formula w i h0 h1 hw,
    receiverTick_slots_formula v i h0 h1 hv]

theorem packFirst_slots_map (w v : Nat → Wire) (i : Nat) (hi : 5 < i) :
    gateSlots (Rolling1588.Integer.packFirst w true i) =
      gateSlots (Rolling1588.Integer.packFirst v true i) := by
  have h5 : i ≠ 5 := by omega
  simp only [Rolling1588.Integer.packFirst, h5, if_false,
    Rolling1588.Integer.packAfter]
  split
  · have hn : i - 5 ≠ 0 := by omega
    simp only [Rolling1588.Integer.encode, hn, if_false,
      Rolling1588.encodeAt, Rolling1588.codeEncodeAt, rename_gateSlots]
  · rfl

theorem unpackFirst_slots_map (w v : Nat → Wire) (i : Nat) (hi : 5 < i) :
    gateSlots (Rolling1588.Integer.unpackFirst w true i) =
      gateSlots (Rolling1588.Integer.unpackFirst v true i) := by
  have h5 : i ≠ 5 := by omega
  simp only [Rolling1588.Integer.unpackFirst, h5, if_false,
    Rolling1588.Integer.decodeBefore]
  split
  · have hn : i - 5 ≠ 0 := by omega
    simp only [Rolling1588.Integer.decode, hn, if_false,
      Rolling1588.decodeAt, Rolling1588.codeDecodeAt, rename_gateSlots]
  · rfl









end ECDSAAdd.Entrant.StairSlotsLib

end
