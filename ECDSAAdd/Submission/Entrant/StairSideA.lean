theorem layout_nat (i n x : Nat) (hn1 : n ≤ 514 - i) (hn2 : n ≤ 258) (hi : i < 512)
    (hx1 : 736 ≤ x) (hx2 : x < 781) :
    x ≠ (skywalkPoolPreviousId i) + 16 ∧ x ≠ 1028 + i + 16 ∧ x ≠ i + n + 16 ∧ x ≠ i + 16 ∧
    x ≠ 770 + 16 ∧ (∀ k, i + 1 ≤ k → k < i + 1 + (n - 2) → x ≠ k + 16) ∧
    x ≠ i + n - 1 + 16 ∧ (∀ k, 771 ≤ k → k < 771 + (n - 2) → x ≠ k + 16) ∧
    x ≠ 770 + n - 1 + 16 ∧ (∀ k, 1540 ≤ k → k < 1540 + (n - 1) → x ≠ k + 16) := by
  have hp : skywalkPoolPreviousId i < 512 ∨ skywalkPoolPreviousId i = 1797 := by
    unfold skywalkPoolPreviousId; split <;> omega
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> (try intro k hk1 hk2) <;> omega

theorem mem_wireBlock' {x : Wire} {st c : Nat} (h : x ∈ wireBlock base st c) :
    ∃ a, st ≤ a ∧ a < st + c ∧ x = a + 16 := by
