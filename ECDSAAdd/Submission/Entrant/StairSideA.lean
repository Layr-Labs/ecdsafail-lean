/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Packet_at_StairSideA` -/
section Merge_StairField2V3Packet_at_StairSideA

/-!
# LT21: the closing packet of a v3 forward segment

`forwardSegment p B B' ℓ e` writes the packet of letters `e-5 .. e-1` with
`renameProgram (OB5.sig e) (Rolling1588.Integer.packFirst base true e)`.  This
is the record's `OB5.sig 511`-placed `encodeGroup base true ((e-5)/5)`
(`closingPacket_eq`, per row by `decide`), and on any state whose ten packet
sites carry the transcript it writes exactly the record's A-encoded values
`recVal origin` (`packet_value`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Packet

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg

theorem closingPacket_eq : ∀ e ∈ ([450, 465, 480, 490, 500] : List Nat),
    renameProgram (OB5.sig e) (Rolling1588.Integer.packFirst base true e) =
      renameProgram (OB5.sig 511) (Rolling1588.encodeGroup base true ((e - 5) / 5)) := by
  decide +kernel



theorem allEncode_succ (n : Nat) : Rolling1588.allEncode base true (n + 1) =
    Rolling1588.allEncode base true n ++ Rolling1588.encodeGroup base true n := rfl

/-- Later packet groups do not touch packet `k`. -/
theorem allEncode_stable (k : Nat) (hk : 5 * k + 5 ≤ 512) (o : State) (q : Wire)
    (hq : q ∈ wires (Rolling1588.encodeGroup base true k)) :
    ∀ n, k + 1 ≤ n → 5 * n ≤ 512 →
      (run (Rolling1588.allEncode base true n) [] o).basis q =
        (run (Rolling1588.allEncode base true (k + 1)) [] o).basis q := by
  intro n hn hb
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hkn : k + 1 = n + 1
      · rw [hkn]
      · have ih' := ih (by omega) (by omega)
        rw [allEncode_succ, run_append]
        have hdis := Rolling1588.allEncode_disjoint base true base_pool_nodup (k + 1) n
          (by omega) (by omega) (by omega)
        have hnot : q ∉ wires (Rolling1588.encodeGroup base true n) := by
          intro h
          have hin : q ∈ wires (Rolling1588.allEncode base true (k + 1)) := by
            rw [allEncode_succ, wires_append]
            exact Finset.mem_union_right _ hq
          exact Finset.disjoint_left.mp hdis hin h
        rw [run_preserves_outside _ _ _ q hnot]
        have e1 : (List.take (measurementCount (Rolling1588.allEncode base true n)) ([] : List Bool)) = [] :=
          by simp
        rw [e1]
        exact ih'

/-- LT49 (replay budget): `recVal` unfolded at the function level.  The pointwise `rfl`
(`unfold recVal`) made the kernel evaluate the record's 102-group encoding (≈ 41 s);
the function-level equation is checked syntactically. -/
theorem recVal_fun : recVal = fun (origin : BasisState) (r : Wire) =>
    (run (Rolling1588.allEncode base true 102) [] ⟨false, origin⟩).basis (OB5.sig 511 r) := rfl

theorem recVal_unfold (origin : BasisState) (q : Wire) : recVal origin q =
    (run (Rolling1588.allEncode base true 102) [] ⟨false, origin⟩).basis (OB5.sig 511 q) :=
  congrFun (congrFun recVal_fun origin) q

/-- Generic in the group count (no concrete encoding in the kernel's view). -/
theorem allEncode_after (n k : Nat) (hk : 5 * k + 5 ≤ 512) (hn : k + 1 ≤ n) (hb : 5 * n ≤ 512)
    (o : State) (q : Wire) (hmem : q ∈ wires (Rolling1588.encodeGroup base true k)) :
    (run (Rolling1588.allEncode base true n) [] o).basis q =
      (run (Rolling1588.encodeGroup base true k) []
        (run (Rolling1588.allEncode base true k) [] o)).basis q := by
  rw [allEncode_stable k hk o q hmem n hn hb, allEncode_succ, run_append]
  simp

/-- The record value of a packet site: only packet `k`'s own group matters. -/
theorem recVal_packet (origin : BasisState) (k : Nat) (hk : 5 * k + 5 ≤ 510) (r : Fin 10) :
    recVal origin (packetSite k r) =
      (run (Rolling1588.encodeGroup base true k) []
        (run (Rolling1588.allEncode base true k) [] ⟨false, origin⟩)).basis
        (History5.historyMap base (5 * k) r) := by
  have hmem : History5.historyMap base (5 * k) r ∈ wires (Rolling1588.encodeGroup base true k) := by
    rw [Rolling1588.encodeGroup_support_eq]
    exact NewHistory5.history_site_mem base (5 * k) r
  rw [recVal_unfold, packetSite, OB5.sig_invol 511 (by decide)]
  exact allEncode_after 102 k (by omega) (by omega) (by decide) _ _ hmem

/-- **The closing packet writes the record's encoded transcript.** -/
theorem packet_value (k : Nat) (hk : 5 * k + 5 ≤ 510) (origin : BasisState) (y : State)
    (hin : ∀ r : Fin 10, y.basis (packetSite k r) = origin (History5.historyMap base (5 * k) r))
    (m : List Bool) :
    ∀ r : Fin 10,
      (run (renameProgram (OB5.sig 511) (Rolling1588.encodeGroup base true k)) m y).basis
        (packetSite k r) = recVal origin (packetSite k r) := by
  intro r
  rw [sig_conj, recVal_packet origin k hk r]
  set P := Rolling1588.encodeGroup base true k
  set o : State := ⟨false, origin⟩
  have hsite : ∀ q ∈ wires P, ∃ i : Fin 10, q = History5.historyMap base (5 * k) i := by
    intro q hq
    rw [Rolling1588.encodeGroup_support_eq] at hq
    exact NewHistory5.history_gate_mem base (5 * k) _ (Or.inl rfl) q hq
  have hmem : History5.historyMap base (5 * k) r ∈ wires P := by
    rw [Rolling1588.encodeGroup_support_eq]
    exact NewHistory5.history_site_mem base (5 * k) r
  change (run P m (pullState (OB5.sig 511) y)).basis
      (OB5.sig 511 (OB5.sig 511 (History5.historyMap base (5 * k) r))) = _
  rw [OB5.sig_invol 511 (by decide)]
  -- both inputs agree on the group's wires
  have hdis := Rolling1588.allEncode_disjoint base true base_pool_nodup k k (by omega) (le_refl _)
    (by omega)
  have agree : ∀ q ∈ wires P, (pullState (OB5.sig 511) y).basis q =
      (run (Rolling1588.allEncode base true k) [] o).basis q := by
    intro q hq
    obtain ⟨i, rfl⟩ := hsite q hq
    rw [run_preserves_outside _ _ _ _ (fun h => Finset.disjoint_left.mp hdis h hq)]
    exact hin i
  have loc := (ECDSAAdd.Arithmetic.run_local_increment P _ _ m agree).2 _ hmem
  rw [loc]
  exact congrFun (ECDSAAdd.Arithmetic.run_basis_records P _ _ m [] rfl) _

end ECDSAAdd.Entrant.StairField2V3Packet

end
