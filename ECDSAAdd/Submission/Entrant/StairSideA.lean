theorem sub (op : Stage) : wires (program op) ⊆ Finset.range 121 := by
  cases op with
  | enter0 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.enter0_scope _ h) (by decide))
  | switch0 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.switch0_scope _ h) (by decide))
