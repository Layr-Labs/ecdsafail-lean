theorem glue_own :
    wires StairSchedule.hostedX ⊆ callerDomain ∧
      wires StairSchedule.paritySetup ⊆ callerDomain ∧
      wires FourScratchWindow.clearProgram ⊆ callerDomain ∧
      wires FourScratchWindow.unprefix ⊆ callerDomain :=
