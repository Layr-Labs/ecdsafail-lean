  have hbr : b ∉ r := sep.1.2.2.1
  have hbw : b ∉ work := sep.1.2.2.2
  have hfx : f ∉ xs := sep.2.1.1
  have hfr : f ∉ r := sep.2.1.2.1
  have hfw : f ∉ work := sep.2.1.2.2
  let u : State := ⟨s.phase, writeBit s.basis b (!(s.basis b ^^ parity xs s.basis))⟩
