section Merge_StairV3Primitives_at_StairSideA

/-!
# CANON v3 primitive provider and host plan (LT6 integrator)

Coordinator decision 15:40: the k = 44 re-plan (rows 425/450/465/480/490/500,
budgets 87/62/47/32/22/12, deficits 0/14/23/31/37/42, terminal 44) on LT13's
physical layout, with LT14's junction repairs.

* codec, ticks, moved segments: LT13 `StairPhysicalPrimitives` on
  `physicalLayout` / `segmentMap` (pack includes `relocate`, unpack
  `unrelocate`); reverse middle segments on LT1's
  `StairPhysicalPrimitivesFix505.middleReverseFix` (s505 on its real wire);
* orientation: LT14's `orientFull` (defect G), i.e. the full `B + 1`-bit
  rails `S ++ [base 512]` and `D ++ [bSite B]` of LT13's layout
  (`physicalLayout_aWord`, `physicalLayout_bWord`);
* first row (phase context): LT13's `phasePackTail` / `phaseUnpackHead`
  (b-rail relocation `phaseBMove` / `phaseBReturn`, defect C) with the
  repaired orientation;
* terminal blocks: LT1's `StairTerminalV3` (defects D/E/F: the record blocks
  relabelled by `terminalPerm`, with the terminal clear as the last piece of
  `SegLast` and the first piece of `RSegLast`; δT = δM = 0).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairV3Primitives

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairPhysicalPhase

/-- LT14's `StairSegmentBoundary.orientFull` (same body): orientation of both
full rails, controlled by the raw letter. -/
def orientFull (letter : Wire) (L : StairCodec.Layout) (B : Nat)
    (sumExt diffExt : Wire) : Program :=
  swapRegisters letter (StairCodec.reg L.S B ++ [sumExt])
    (StairCodec.reg L.D B ++ [diffExt])

/-- Repaired orientation at checkpoint letter `i` (budget `512 - i`). -/
def orient (i : Nat) : Program :=
  orientFull (letterSite (i - 1)) (physicalLayout (512 - i)) (512 - i)
    (base 512) (bSite (512 - i))

/-! ### Row-425 repair (LT43f): orientation on the unmoved b rail

At tick 424 the record keeps its b rail on the x I/O word `base (770 + k)`, and
`bSite 83` / `cSite 83` still hold the raw letters `s 422` / `s 424` of the
not-yet-encoded packet 84 (they are that packet's two hole ports).  The b rail
may therefore only be moved onto `bSite` after the packet codec has run, while
the orientation (controlled by the raw letter 424 of the same packet) must run
before it.  The orientation is run on the unmoved b rail: `xRelabel` is
`phaseRelabel` followed by the exchange `bSite k ↔ base (770 + k)`. -/


theorem xSwap_pairs : ∀ k ∈ List.range 88,
    xSwap (base (770 + k)) = bSite k ∧ xSwap (bSite k) = base (770 + k) := by
  decide +kernel

theorem xSwap_cases (q : Wire) :
    (∃ k ∈ List.range 88, q = base (770 + k) ∧ xSwap q = bSite k) ∨
      (∃ k ∈ List.range 88, q = bSite k ∧ xSwap q = base (770 + k)) ∨ xSwap q = q := by
  cases h1 : (List.range 88).find? (fun k => decide (base (770 + k) = q)) with
  | some k =>
    have mem := List.mem_of_find?_eq_some h1
    have hk0 := List.find?_some h1
    have hk : base (770 + k) = q := of_decide_eq_true hk0
    exact Or.inl ⟨k, mem, hk.symm, hk ▸ (xSwap_pairs k mem).1⟩
  | none =>
    cases h2 : (List.range 88).find? (fun k => decide (bSite k = q)) with
    | some k =>
      have mem := List.mem_of_find?_eq_some h2
      have hk0 := List.find?_some h2
      have hk : bSite k = q := of_decide_eq_true hk0
      exact Or.inr (Or.inl ⟨k, mem, hk.symm, hk ▸ (xSwap_pairs k mem).2⟩)
    | none =>
      refine Or.inr (Or.inr ?_)
      unfold xSwap
      rw [h1, h2]

theorem xSwap_invol (q : Wire) : xSwap (xSwap q) = q := by
  rcases xSwap_cases q with ⟨k, mem, rfl, e⟩ | ⟨k, mem, rfl, e⟩ | e
  · rw [e, (xSwap_pairs k mem).2]
  · rw [e, (xSwap_pairs k mem).1]
  · rw [e, e]


theorem phaseBMove_ends : ∀ k ∈ List.range 88,
    base (770 + k) ∈ wires phaseBMove ∧ bSite k ∈ wires phaseBMove := by
  decide +kernel

/-- The x-word orientation uses only wires of the b-rail move and of the
`phaseRelabel` orientation. -/
theorem orientX_wires (P : Program) :
    wires (renameProgram xRelabel P) ⊆
      wires phaseBMove ∪ wires (renameProgram phaseRelabel P) := by
  intro q hq
  rw [renameProgram_support] at hq
  obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hq
  rw [Finset.mem_union]
  rcases xSwap_cases (phaseRelabel r) with ⟨k, mem, -, e⟩ | ⟨k, mem, -, e⟩ | e
  · exact Or.inl (by rw [xRelabel, e]; exact (phaseBMove_ends k mem).2)
  · exact Or.inl (by rw [xRelabel, e]; exact (phaseBMove_ends k mem).1)
  · refine Or.inr ?_
    rw [renameProgram_support, xRelabel, e]
    exact Finset.mem_image_of_mem _ hr

/-- First-row pack in the phase context (LT13 `phasePackTail` with the
repaired orientation; LT43f order: orientation on the unmoved b rail, the
record packet 84, then the b-rail move, then the codec). -/
def firstPack : Program :=
  renameProgram xRelabel (orient 425) ++
    renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425) ++
    phaseBMove ++ renameProgram phaseRelabel (StairPhysicalPrimitives.pack 87)

/-- First-row unpack in the phase context: the exact mirror of `firstPack`. -/
def firstUnpack : Program :=
  renameProgram phaseRelabel (StairPhysicalPrimitives.unpack 87) ++ phaseBReturn ++
    renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425) ++
    renameProgram xRelabel (orient 425)


/-- The row (budget) whose stored checkpoint is live while groups run at
deficit `d` (groups after a segment use the deficit of the row it packed). -/
def budgetOfDeficit (d : Nat) : Nat :=
  if d = 0 then 87 else if d = 14 then 62 else if d = 23 then 47
  else if d = 31 then 32 else if d = 37 then 22 else 12

/-- v3 hosts: groups at deficit `d < 44` rebind the `44 - d` not-yet-loaned
exclusive roles onto LT13's `hosts` of the live row (future payload letters);
at the terminal deficit 44 nothing is hosted.  The other host lists are
v3 also hosts both first packets on `hosts 87` (LT13 round 7, item 5); the
other lists are unused. -/
def hostPlan : StairHostsSchedule.HostPlan where
  group := fun _ d _ _ => if d = 44 then [] else hosts (budgetOfDeficit d)
  endpoint := fun _ _ => []
  copy := fun _ => []
  canon := []
  center := []
  firstPacket := fun _ => hosts 87
  x1 := fun _ => []






end ECDSAAdd.Entrant.StairV3Primitives

end
end Merge_StairV3Primitives_at_StairSideA

