/-! ### merged from `ECDSAAdd.Submission.Entrant.StairWireCheck_at_StairSideA` -/
section Merge_StairWireCheck_at_StairSideA

/-!
# List-level wire checks (LT20)

`wires P` is a `Finset` union, which is expensive to evaluate in the kernel.
This module gives a list-level description of the wires of an instruction and
two Boolean checks over a concrete program, each with a soundness theorem, so
static touch/avoid facts about concrete programs can be closed by
`decide +kernel` on a `Bool` equation.
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairWireCheck

open ECDSAAdd

/-- Wires of a correction list, as a list. -/
def corrWs : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: corrWs cs
  | .CZ a b :: cs => a :: b :: corrWs cs

/-- Wires of an instruction, as a list. -/
def instrWs : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c0 c1 => t :: (corrWs c0 ++ corrWs c1)

theorem mem_corrWs (q : Wire) (cs : List Correction) :
    q ∈ corrWs cs ↔ q ∈ correctionWires cs := by
  induction cs with
  | nil => simp [corrWs, correctionWires]
  | cons c cs ih =>
      cases c <;> simp [corrWs, correctionWires, ih]

theorem mem_instrWs (q : Wire) (i : Instr) : q ∈ instrWs i ↔ q ∈ i.wires := by
  cases i <;> simp [instrWs, Instr.wires, mem_corrWs]

theorem mem_wires (q : Wire) (P : Program) :
    q ∈ wires P ↔ ∃ i ∈ P, q ∈ instrWs i := by
  induction P with
  | nil => simp [wires]
  | cons i P ih =>
      simp only [wires, Finset.mem_union, ih, List.mem_cons, mem_instrWs]
      constructor
      · rintro (h | ⟨j, hj, hq⟩)
        · exact ⟨i, Or.inl rfl, h⟩
        · exact ⟨j, Or.inr hj, hq⟩
      · rintro ⟨j, hj | hj, hq⟩
        · exact Or.inl (hj ▸ hq)
        · exact Or.inr ⟨j, hj, hq⟩





/-! ## Good physical sites (fast list form) -/

/-- Inside the record arena, not an old omission, not one of the 44 new
omissions. -/
def goodNat (q : Wire) : Bool :=
  decide (q ∈ StairPhysicalLayout.arenaNat) &&
    decide (q ∉ StairPhysicalLayout.oldHolesNat) &&
    decide (q ∉ StairPhysicalLayout.newHolesNat)

theorem goodNat_spec {q : Wire} (h : goodNat q = true) :
    q ∈ StairHoleSupport.recordArena ∧ q ∉ StairHoleSupport.oldHoles ∧
      q ∉ StairPhysicalInventory.physicalHoles := by
  rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq,
    StairPhysicalLayout.physicalHoles_eq_nat]
  simp only [goodNat, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1.1, h.1.2, h.2⟩



/-- The field level before `Prefix1590.borrow` (LT1's `lowPlace`): the map
under which the two first packets of `StairHostsSchedule.entryLowPrefix` /
`exitLowSuffix` land in the final program. -/
def lowPlace (q : Wire) : Wire :=
  StairOuterPlacement.kernelPlace
    ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
      (HostOB5.hostSwap q))

/-! ## Literal role and host lists of the first packets -/

/-- `StairSchedule.exclusiveRoles` (labels `base 720 .. base 764` without
`base 760`) as literal wires. -/
def exclusiveNat : List Wire := List.range' 736 40 ++ List.range' 777 4

theorem exclusiveRoles_eq_nat : StairSchedule.exclusiveRoles = exclusiveNat := by
  decide +kernel


/-- `StairPhysicalLayout.hosts 87` (the v3 first-packet hosts) as literal
wires. -/
def hosts87Nat : List Wire :=
  [1633, 1631, 1629, 1628, 1626, 1624, 1623, 1621, 1619, 1618, 1616, 1614,
   1613, 1611, 1609, 1608, 1606, 1604, 1603, 1601, 1599, 1598, 1596, 1594,
   1593, 1591, 1589, 1588, 1586, 1584, 1583, 1581, 1579, 1578, 1576, 1574,
   1573, 1571, 1569, 1568, 1566, 1564, 1563, 1561]

theorem hosts87_eq_nat : StairPhysicalLayout.hosts 87 = hosts87Nat := by
  decide +kernel

/-! ## A generic single-pass site check and the support of `rebindMany` -/

/-- Every wire of every instruction of `P` satisfies `c`. -/
def allSites (c : Wire → Bool) (P : Program) : Bool :=
  P.all (fun i => (instrWs i).all c)

theorem allSites_sound (c : Wire → Bool) (P : Program)
    (h : allSites c P = true) : ∀ x ∈ wires P, c x = true := by
  intro x hx
  obtain ⟨i, hi, hw⟩ := (mem_wires x P).mp hx
  exact List.all_eq_true.mp (List.all_eq_true.mp h i hi) x hw

/-- A wire of a rebound program is a host, a role, or a wire of the original
program. -/
theorem rebindMany_support (roles hosts : List Wire) (P : Program) :
    ∀ x ∈ wires (StairLoan.rebindMany roles hosts P),
      x ∈ hosts ∨ x ∈ roles ∨ x ∈ wires P := by
  induction roles generalizing hosts with
  | nil =>
      intro x hx
      exact Or.inr (Or.inr (by simpa only [StairLoan.rebindMany] using hx))
  | cons r rs ih =>
      cases hosts with
      | nil =>
          intro x hx
          exact Or.inr (Or.inr (by simpa only [StairLoan.rebindMany] using hx))
      | cons h hs =>
          intro x hx
          rw [StairLoan.rebindMany, renameProgram_support] at hx
          obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
          by_cases hyr : y = r
          · subst hyr
            left
            rw [Equiv.swap_apply_left]
            simp
          by_cases hyh : y = h
          · subst hyh
            right; left
            rw [Equiv.swap_apply_right]
            simp
          rw [Equiv.swap_apply_of_ne_of_ne hyr hyh]
          rcases ih hs y hy with h1 | h1 | h1
          · exact Or.inl (List.mem_cons_of_mem _ h1)
          · exact Or.inr (Or.inl (List.mem_cons_of_mem _ h1))
          · exact Or.inr (Or.inr h1)

/-- The per-wire predicate of the first-packet pass: not a host, and either an
exclusive role or a good physical site under `lowPlace`. -/
def firstCheck (w : Wire) : Bool :=
  !decide (w ∈ hosts87Nat) && (decide (w ∈ exclusiveNat) || goodNat (lowPlace w))

theorem hostsGood : hosts87Nat.all (fun h => goodNat (lowPlace h)) = true := by
  -- K6 (replay budget): numeric kernel placement `kernelPlaceB` and interval test `goodB`
  have hB : hosts87Nat.all (fun h => StairPhysicalLayout.goodB (StairPlaceFast.kernelPlaceB
      ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
        (HostOB5.hostSwap h)))) = true := by
    decide +kernel
  rw [List.all_eq_true] at hB ⊢
  intro w hw
  have g' := StairPhysicalLayout.good_of_goodB _ (hB w hw)
  rw [lowPlace, StairPlaceFast.kernelPlace_eqB]
  simp only [goodNat, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨⟨g'.1, g'.2.1⟩, g'.2.2⟩

/-- An explicit superset of the support of both record first packets
(field-tail labels).  Its periodic parts are the packet-0 history letters. -/
def fpSup (w : Wire) : Bool := decide (w < 2426) && (
  (decide (16 ≤ w) && decide (w ≤ 20)) || (decide (528 ≤ w) && decide (w ≤ 530)) ||
  decide (w = 733) || (decide (736 ≤ w) && decide (w ≤ 775)) ||
  (decide (777 ≤ w) && decide (w ≤ 780)) || (decide (786 ≤ w) && decide (w ≤ 1041)) ||
  (decide (1043 ≤ w) && decide (w ≤ 1048)) ||
  (decide (1051 ≤ w) && decide (w ≤ 1298) &&
    (decide ((w - 1051) % 5 = 0) || decide ((w - 1051) % 5 = 2))) ||
  decide (w = 1556) ||
  (decide (1560 ≤ w) && decide (w ≤ 1810) &&
    (decide ((w - 1560) % 5 = 0) || decide ((w - 1560) % 5 = 2))) ||
  (decide (1812 ≤ w) && decide (w ≤ 1813)) || (decide (2072 ≤ w) && decide (w ≤ 2327)) ||
  decide (w = 2425))

theorem fpSup_lt (w : Wire) (h : fpSup w = true) : w < 2426 := by
  unfold fpSup at h
  simp only [Bool.and_eq_true] at h
  exact of_decide_eq_true h.1

end ECDSAAdd.Entrant.StairWireCheck

end
end Merge_StairWireCheck_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairFirstPacketKernelF_at_StairSideA` -/
section Merge_StairFirstPacketKernelF_at_StairSideA

/-!
# Kernel checks for the record first packet `Rolling1588.placedFirstPacket false`
(LT20).  Iterative Boolean checkers from `StairWireCheck`, closed by
`decide +kernel`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

namespace ECDSAAdd.Entrant.StairFirstPacketKernel

open ECDSAAdd StairWireCheck

/-! ## LT48 (replay budget): structural support instead of one kernel pass over the packet

The kernel pass over the 52k-gate packet cost ≈ 300 s per packet (all of it in generating the
body: three lifetime halves `R2Life760.half760`, the joint kernel, the codec triples).  Here every
piece is bounded by the record's own support lemmas (`tripleMap` has a 6-wire range,
`ControlLoan1589.loanWindow_support`, `R2Life760.half760_support`, `Q6EndpointCell.half_support`
with the six `half_avoid` omissions, `paddedD/GD_support` with `_free`), and `fpSup` is checked on
those envelopes (≈ 3,000 wires).  The touch check reads one bit mask of the shortest prefix. -/
namespace LT48F
open Arithmetic.MappedCompressed Rolling1588
attribute [local irreducible] ECDSAAdd.wires

/-- Every wire of `P` passes `c`. -/
def Ok (c : Wire → Bool) (P : Program) : Prop := ∀ x ∈ wires P, c x = true

theorem ok_of_all {c : Wire → Bool} {P : Program} (h : allSites c P = true) : Ok c P :=
  allSites_sound c P h

theorem allSites_of_ok {c : Wire → Bool} {P : Program} (h : Ok c P) : allSites c P = true := by
  unfold allSites
  rw [List.all_eq_true]
  intro i hi
  rw [List.all_eq_true]
  intro x hx
  exact h x ((StairWireCheck.mem_wires x P).mpr ⟨i, hi, hx⟩)

theorem ok_append {c : Wire → Bool} {A B : Program} (ha : Ok c A) (hb : Ok c B) : Ok c (A ++ B) := by
  intro x hx
  rw [wires_append, Finset.mem_union] at hx
  exact hx.elim (ha x) (hb x)


theorem ok_rename {c : Wire → Bool} (f : Wire → Wire) (P : Program)
    (h : Ok (fun x => c (f x)) P) : Ok c (renameProgram f P) := by
  intro x hx
  rw [ECDSAAdd.renameProgram_support] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  exact h y hy

theorem ok_selW {c : Wire → Bool} (src flag : Wire) (P : Program) (h1 : c src = true)
    (h2 : c flag = true) (hP : Ok c P) : Ok c (SW.selW src flag P) := by
  intro x hx
  rw [SW.selW, wires_append, wires_append, Finset.mem_union, Finset.mem_union] at hx
  rcases hx with (hx | hx) | hx
  · obtain ⟨i, hi, hw⟩ := (StairWireCheck.mem_wires x _).mp hx
    simp only [List.mem_singleton] at hi
    subst hi
    simp only [instrWs, List.mem_cons, List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl <;> assumption
  · exact hP x hx
  · obtain ⟨i, hi, hw⟩ := (StairWireCheck.mem_wires x _).mp hx
    simp only [List.mem_singleton] at hi
    subst hi
    simp only [instrWs, corrWs, List.mem_cons, List.nil_append, List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl <;> assumption

theorem ok_loanWindow {c : Wire → Bool} (g0 flag cc : Wire) (P : Program) (hg : c g0 = true)
    (hf : c flag = true) (hP : Ok (fun x => c (Equiv.swap cc g0 x)) P) :
    Ok c (ControlLoan1589.loanWindow g0 flag cc P) := by
  intro x hx
  have h := ControlLoan1589.loanWindow_support g0 flag cc P hx
  rcases Finset.mem_union.mp h with h | h
  · rcases Finset.mem_insert.mp h with rfl | h
    · exact hg
    · rw [Finset.mem_singleton.mp h]
      exact hf
  · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp h
    exact hP y hy

theorem tripleMap_mem (a b cc : Nat) (y : Wire) :
    tripleMap a b cc y ∈ [g 0 a, s 0 a, g 0 b, s 0 b, g 0 cc, s 0 cc] := by
  simp only [tripleMap]
  split_ifs <;> simp

theorem ok_triple {c : Wire → Bool} (a b cc : Nat) (P : Program)
    (h : [g 0 a, s 0 a, g 0 b, s 0 b, g 0 cc, s 0 cc].all c = true) : Ok c (triple a b cc P) := by
  apply ok_rename
  intro y _
  exact List.all_eq_true.mp h _ (tripleMap_mem a b cc y)

/-- Envelope of the lifetime half (`Q6EndpointCell.half_support`) and its seven omissions. -/
def env : List Wire := base 2409 :: Q6EndpointCell.ids.map base
def bad : List Wire := [base 760, base 765, base 766, base 767, base 1026, base 1541, base 2312]

theorem half_env (d : Bool) (z : Wire) (hz : z ∈ wires (R2Life760.half760 d)) : z ∈ env ∧ z ∉ bad := by
  obtain ⟨n760, hq⟩ := Finset.mem_erase.mp (R2Life760.half760_support d hz)
