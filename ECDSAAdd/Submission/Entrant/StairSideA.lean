  split
  · exact hk.1
  · exact hk.2

theorem label_pre' (start : Nat) (hs : start < 600) (w : Wire) (hw : InWin w) :
    ∀ q, MeasuredCodec5.label (History5.historyMap base start) q = w ↔ q = w := by
  intro q
  unfold MeasuredCodec5.label
  split
