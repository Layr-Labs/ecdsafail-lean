/-! ## Rest storage, hosts, and relocation -/





/-- K4-B (replay budget): the three facts of `rest_hosts_fit` as one linear Boolean pass
(bit-mask duplicate scan, bit-mask membership, length). -/
def kbRestCheck (B : Nat) : Bool :=
  StairLoan.nodupMask (restSites B ++ hosts B) 0 &&
    (restSites B ++ hosts B).all (fun q => (StairLoan.maskOf (futurePayload B)).testBit q) &&
    (B != 87 || (restSites B ++ hosts B).length == (futurePayload B).length)

theorem kbRestCheck_ok : ∀ B ∈ budgets, kbRestCheck B = true := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

/-- Rest storage and hosts are disjoint and exhaust the future payload exactly
at the first row, and fit inside it at every row. -/
theorem rest_hosts_fit : ∀ B ∈ budgets,
    (restSites B ++ hosts B).Nodup ∧
      (∀ q ∈ restSites B ++ hosts B, q ∈ futurePayload B) ∧
      (B = 87 → (restSites B ++ hosts B).length = (futurePayload B).length) := by
  intro B hB
  have h := kbRestCheck_ok B hB
  unfold kbRestCheck at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.or_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨StairLoan.nodup_of_mask _ h1,
    fun q hq => StairLoan.mem_of_maskOf (List.all_eq_true.mp h2 q hq), fun e => ?_⟩
  subst e
  rcases h3 with h3 | h3
  · exact absurd h3 (by decide)
  · exact beq_iff_eq.mp h3




