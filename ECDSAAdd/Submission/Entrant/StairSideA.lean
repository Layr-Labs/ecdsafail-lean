/-! ## Zero labels of a record `CutFrame` -/

def zrB (L : Nat) : Bool :=
  decide (16 ≤ L) &&
    (decide (Placement5.workRegion (L - 16)) || decide (Placement5.holeRegion (L - 16)))

def ryL : List Wire :=
  (balancedSharedPorts base (base 2409)).r ++ (balancedSharedPorts base (base 2409)).y

def histL : List Wire := wireBlock base 0 512 ++ wireBlock base 1028 512

def cleanL : List Wire :=
  (skywalkSharedField base).work ++ skywalkSharedUnused base ++ [base 1026]

/-- Labels that are zero on every record `CutFrame`. -/
abbrev ZeroClass (L : Wire) : Prop :=
  zrB L = true ∨ (L ∉ ryL ∧ L ∉ histL ∧ (L ∈ cleanL ∨ L = base 2409))

theorem frame_zero (c : Nat) (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (st : State) (frame : Rolling1588.CutFrame c origin X Y st) (L : Wire)
    (hz : ZeroClass L) : st.basis L = false := by
  rcases hz with hzr | ⟨hry, hh, hcl⟩
  · unfold zrB at hzr
    simp only [Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq] at hzr
    obtain ⟨h16, hreg⟩ := hzr
    have e : L = base (L - 16) := (Nat.sub_add_cancel h16).symm
    rw [e]
    exact Rolling1588.cutFrame_zero_region c origin ctx X Y st frame (L - 16) hreg
  · obtain ⟨raw, -, pair, enc⟩ := frame
    have away : L ∉ wires (Rolling1588.allEncodeCut base c 102) := by
      intro used
      rw [Rolling1588.allEncodeCut_support_eq] at used
      exact hh (List.mem_toFinset.mp
        (NewHistory5.allEncode_history_support base 102 (by decide) used))
    rw [enc, run_preserves_outside _ _ _ _ away,
      pair.2.2 L (fun h => hry (List.mem_append_left _ h)) (fun h => hry (List.mem_append_right _ h))]
    obtain ⟨hwork, hun, h1026⟩ := ctx.env
    rcases hcl with hc | rfl
    · unfold cleanL at hc
      rcases List.mem_append.mp hc with hc | hc
      · rcases List.mem_append.mp hc with hc | hc
        · exact (regValue_zero _ _).mp hwork L hc
        · exact (regValue_zero _ _).mp hun L hc
      · rw [List.mem_singleton.mp hc]
        exact h1026
    · exact ctx.hg0

