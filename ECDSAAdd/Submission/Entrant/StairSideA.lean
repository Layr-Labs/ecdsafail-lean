/-! ## abstract two-block rename -/

theorem two_block_run_eq (ps : List (Wire × Wire)) (A Q1 Mid Q1c E : Program) (s : State) (m : List Bool)
    (aFree : ∀ ab∈ps, ab.1∉wires A ∧ ab.2∉wires A)
    (zero0 : ∀ ab∈ps, s.basis ab.1=false ∧ s.basis ab.2=false)
    (q1Out : ∀ r1 r2 : List Bool, ∀ ab∈ps, (run Q1 r2 (run A r1 s)).basis ab.1=false)
    (q1Host : ∀ ab∈ps, ab.2∉wires Q1)
    (midFree : ∀ ab∈ps, ab.1∉wires Mid)
    (q1cHost : ∀ ab∈ps, ab.2∉wires Q1c)
    (eFree : ∀ ab∈ps, ab.1∉wires E ∧ ab.2∉wires E)
    (fin : ∀ ab∈ps, (run (A++Q1++Mid++Q1c++E) m s).basis ab.1=false ∧
      (run (A++Q1++Mid++Q1c++E) m s).basis ab.2=false) :
    run (A++hostRename ps Q1++Mid++hostRename ps Q1c++E) m s=run (A++Q1++Mid++Q1c++E) m s := by
  have e1 : A++hostRename ps Q1++Mid++hostRename ps Q1c++E=
      A++hostRename ps Q1++(Mid++hostRename ps Q1c++E) := by simp only [List.append_assoc]
  have e2 : A++Q1++(Mid++hostRename ps Q1c++E)=A++Q1++Mid++hostRename ps Q1c++E := by
    simp only [List.append_assoc]
  have step1 := hostRename_mid_run_eq ps A Q1 (Mid++hostRename ps Q1c++E) s m
    (fun ab h => (run_preserves_outside _ _ _ _ (aFree ab h).1).trans (zero0 ab h).1)
    (fun ab h => (run_preserves_outside _ _ _ _ (aFree ab h).2).trans (zero0 ab h).2)
    (fun ab h => q1Out _ _ ab h) q1Host
  have split : A++Q1++Mid++Q1c++E=(A++Q1++Mid)++(Q1c++E) := by simp only [List.append_assoc]
  have step2 := hostRename_mid_run_eq ps (A++Q1++Mid) Q1c E s m
    (fun ab h => by
      rw [run_append (A++Q1) Mid,run_preserves_outside _ _ _ _ (midFree ab h),run_append A Q1]
      exact q1Out _ _ ab h)
    (fun ab h => by
      have f := (fin ab h).2
      have off : ab.2∉wires (Q1c++E) := by
        rw [wires_append]
        exact fun u => (Finset.mem_union.mp u).elim (q1cHost ab h) (eFree ab h).2
      rw [split,run_append (A++Q1++Mid) (Q1c++E),run_preserves_outside _ _ _ _ off] at f
      exact f)
    (fun ab h => by
      have f := (fin ab h).1
      rw [split,run_append (A++Q1++Mid) (Q1c++E),run_append Q1c E,
        run_preserves_outside _ _ _ _ (eFree ab h).1] at f
      exact f)
    q1cHost
  rw [e1,step1,e2,step2]

theorem two_block_counts (ps : List (Wire × Wire)) (A Q1 Mid Q1c E : Program) :
    toffoliCount (A++hostRename ps Q1++Mid++hostRename ps Q1c++E)=toffoliCount (A++Q1++Mid++Q1c++E) ∧
    measurementCount (A++hostRename ps Q1++Mid++hostRename ps Q1c++E)=measurementCount (A++Q1++Mid++Q1c++E) ∧
    Challenge.gateSlots (A++hostRename ps Q1++Mid++hostRename ps Q1c++E)=
      Challenge.gateSlots (A++Q1++Mid++Q1c++E) := by
  have c1 := hostRename_counts ps Q1
  have c2 := hostRename_counts ps Q1c
  refine ⟨?_,?_,?_⟩
  · simp only [toffoliCount_append,c1.1,c2.1]
  · simp only [measurementCount_append,c1.2,c2.2]
  · simp only [Challenge.gateSlots_append,hostRename_slots]

theorem two_block_physical (ps : List (Wire × Wire)) (A Q1 Mid Q1c E : Program)
    (h : GatePhysical (A++Q1++Mid++Q1c++E)) :
    GatePhysical (A++hostRename ps Q1++Mid++hostRename ps Q1c++E) := by
  simp only [gatePhysical_append] at h ⊢
  exact ⟨⟨⟨⟨h.1.1.1.1,hostRename_physical ps Q1 h.1.1.1.2⟩,h.1.1.2⟩,hostRename_physical ps Q1c h.1.2⟩,h.2⟩

theorem two_block_wires (ps : List (Wire × Wire)) (A Q1 Mid Q1c E : Program)
    (hnd : (holesOf ps++hostsOf ps).Nodup)
    (q1Host : ∀ ab∈ps, ab.2∉wires Q1) (q1cHost : ∀ ab∈ps, ab.2∉wires Q1c) :
    wires (A++hostRename ps Q1++Mid++hostRename ps Q1c++E)⊆
      wires (A++Q1++Mid++Q1c++E)∪(hostsOf ps).toFinset := by
  have s1 := hostRename_support ps Q1 hnd q1Host
  have s2 := hostRename_support ps Q1c hnd q1cHost
  intro q hq
  simp only [wires_append,Finset.mem_union] at hq ⊢
  rcases hq with (((h|h)|h)|h)|h
  · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl h))))
  · rcases Finset.mem_union.mp (s1 h) with h'|h'
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (Finset.mem_sdiff.mp h').1))))
    · exact Or.inr h'
  · exact Or.inl (Or.inl (Or.inl (Or.inr h)))
  · rcases Finset.mem_union.mp (s2 h) with h'|h'
    · exact Or.inl (Or.inl (Or.inr (Finset.mem_sdiff.mp h').1))
    · exact Or.inr h'
  · exact Or.inl (Or.inr h)

theorem two_block_avoids (ps : List (Wire × Wire)) (A Q1 Mid Q1c E : Program)
    (hnd : (holesOf ps++hostsOf ps).Nodup)
    (q1Host : ∀ ab∈ps, ab.2∉wires Q1) (q1cHost : ∀ ab∈ps, ab.2∉wires Q1c)
    (aFree : ∀ q∈holesOf ps, q∉wires A) (midFree : ∀ q∈holesOf ps, q∉wires Mid)
    (eFree : ∀ q∈holesOf ps, q∉wires E) :
    ∀ q∈holesOf ps, q∉wires (A++hostRename ps Q1++Mid++hostRename ps Q1c++E) := by
  intro q hq u
  have a1 := hostRename_avoids ps Q1 hnd q1Host q hq
  have a2 := hostRename_avoids ps Q1c hnd q1cHost q hq
  simp only [wires_append,Finset.mem_union] at u
  rcases u with (((h|h)|h)|h)|h
  · exact aFree q hq h
  · exact a1 h
  · exact midFree q hq h
  · exact a2 h
  · exact eFree q hq h

