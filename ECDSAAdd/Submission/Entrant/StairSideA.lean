  (List.range B).all (fun i => (StairLoan.maskOf (rowSites B)).testBit ((physicalLayout B).D i) &&
    !(StairLoan.maskOf (futurePayload B)).testBit ((physicalLayout B).D i)) &&
  ((StairLoan.maskOf (rowSites B)).testBit ((physicalLayout B).S (B - 1)) &&
    (!(StairLoan.maskOf (futurePayload B)).testBit ((physicalLayout B).S (B - 1)) &&
    !(StairLoan.maskOf (moveSites (unrelocPairs B))).testBit ((physicalLayout B).S (B - 1)))) &&
  StairLoan.nodupMask (aReg B) 0 &&
