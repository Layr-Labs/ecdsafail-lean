section Merge_StairBoundaryLoanDecoder_at_StairSideA

/-!
# Boundary carry loan: the division endpoint decoder (program and static facts)

`CompareDecoder.cellDecoderNext` touches the 44 exclusive retired sites only in
its literal comparison ladder (`cmpFront` / `cmpBack`, ladder positions
208–252 without 248); the block between them (`lowBlock`) touches exactly the
six ladder carries 5–10, and nothing after `cmpBack` touches the ladder.

`cellDecoderLoan` therefore:
* factors the `X` conjugation of the comparison input out of `borrowPath`
  (`borrowPath` = `notRegister xs ++` mapped literal-borrow layers `++ notRegister xs`);
* keeps the carry inversions only on the six carries `lowBlock` reads
  (the other inversions cancel across `lowBlock`);
* keeps the 11 lowest ladder layers unchanged and runs the remaining 244 layers
  as `StairLoan.emitLoan 44`, hosting the 44 retired roles on ladder carries
  11–54 (freed by measurement and recomputed afterwards).

Proved here (kernel-checked on the concrete program): exact counts
(+44 Toffoli, +44 measurements), avoidance of all 44 sites, physicality.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed











/-! ## Static facts -/


/-! ## K5 (replay budget): counts, slots and physicality in one pass

The relocation `rebindMany` inside `emitLoan` (most of the evaluation cost) changes no
count, slot or physicality fact, and the endpoint wrappers are the record's.  One kernel
pass over `k5Flat` (= `cellDecoderLoan` without the rebinding) replaces the former passes
over `cellDecoderLoan` and the two endpoints (counts, physicality, slots). -/

/-- `cellDecoderLoan` up to the relocated upper sweep. -/
def k5Pre : Program :=
  frontFast fixedLayout ++ upper fixedLayout ++ DirectDecoder.highBlock fixedLayout ++
    DirectDecoder.middle fixedLayout ++ [.X cin] ++ notRegister xs ++ StairLoan.emitUps headL ++
    (StairLoan.emitUps (tailL.take 45) ++ StairLoan.emitErases (tailL.take 44))

/-- The relocated upper sweep, before the rebinding. -/
def k5Mid : Program := StairLoan.emitSweep (tailL.drop 45) top760

/-- `cellDecoderLoan` after the relocated upper sweep. -/
def k5Suf : Program :=
  (StairLoan.emitUps (tailL.take 44) ++ StairLoan.emitDowns (tailL.take 45)) ++
    StairLoan.emitDowns headL ++ notRegister xs ++
    [.X fixedLayout.sigma, .X cin] ++ restoreSource fixedLayout ++ copySource fixedLayout

def k5Flat : Program := k5Pre ++ k5Mid ++ k5Suf

theorem cellDecoderLoan_k5 : cellDecoderLoan = k5Pre ++
    StairLoan.rebindMany (StairBoundaryLoan.exclusiveHoles.take 44)
      (StairLoan.layerHosts (tailL.take 44)) k5Mid ++ k5Suf := by
  simp only [cellDecoderLoan, window760, StairLoan.emitLoan, k5Pre, k5Mid, k5Suf,
    List.append_assoc]

theorem k5Flat_facts :
    toffoliCount k5Flat = 301 ∧ measurementCount k5Flat = 558 ∧ gateSlots k5Flat = 6237 ∧
      k5Flat.all CodecBitSliceVerify.physicalCheck = true := by
  decide +kernel

theorem k5_rebind_slots (roles hosts : List Wire) (P : Program) :
    gateSlots (StairLoan.rebindMany roles hosts P) = gateSlots P := by
  induction roles generalizing hosts with
  | nil => rfl
  | cons r roles ih =>
      cases hosts with
      | nil => rfl
      | cons h hosts =>
          simp only [StairLoan.rebindMany, Baselines.rename_gateSlots, ih]

theorem cellDecoderLoan_facts :
    toffoliCount cellDecoderLoan = 301 ∧ measurementCount cellDecoderLoan = 558 ∧
      gateSlots cellDecoderLoan = 6237 ∧ GatePhysical cellDecoderLoan := by
  obtain ⟨t, m, g, p⟩ := k5Flat_facts
  have rc := StairLoan.rebindMany_counts (StairBoundaryLoan.exclusiveHoles.take 44)
    (StairLoan.layerHosts (tailL.take 44)) k5Mid
  have rs := k5_rebind_slots (StairBoundaryLoan.exclusiveHoles.take 44)
    (StairLoan.layerHosts (tailL.take 44)) k5Mid
  have pp := CodecBitSliceVerify.physical_of_check _ p
  unfold k5Flat at t m g pp
  simp only [toffoliCount_append, measurementCount_append, gateSlots_append] at t m g
  simp only [gatePhysical_append] at pp
  rw [cellDecoderLoan_k5]
  simp only [toffoliCount_append, measurementCount_append, gateSlots_append,
    gatePhysical_append, rc.1, rc.2, rs]
  refine ⟨by omega, by omega, by omega, ?_⟩
  exact ⟨⟨pp.1.1, StairLoan.rebindMany_physical _ _ _ pp.1.2⟩, pp.2⟩

/-- The endpoint wrappers shared by `endPacket760DivLoan` and `R2SqEp760.endPacket760 true`. -/
def k5Wrap (P : Program) : Program :=
  renameProgram (Equiv.swap (base 760) (base 717))
    (renameProgram (shifted Placement5.pi0)
      (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
        (P ++ List.replicate 507 (Instr.measureX (base 512) [] []))))

theorem endPacket760DivLoan_k5 : endPacket760DivLoan = k5Wrap cellDecoderLoan := rfl

theorem endPacket760_true_k5 : R2SqEp760.endPacket760 true = k5Wrap cellDecoderNext := rfl

theorem k5_rename_tc (f : Wire → Wire) (P : Program) :
    toffoliCount (renameProgram f P) = toffoliCount P := (renameProgram_counts f P).1

theorem k5_rename_mc (f : Wire → Wire) (P : Program) :
    measurementCount (renameProgram f P) = measurementCount P := (renameProgram_counts f P).2

theorem k5Wrap_counts (P Q : Program) (k : Nat)
    (ht : toffoliCount P = toffoliCount Q + k) (hm : measurementCount P = measurementCount Q + k) :
    toffoliCount (k5Wrap P) = toffoliCount (k5Wrap Q) + k ∧
      measurementCount (k5Wrap P) = measurementCount (k5Wrap Q) + k := by
  simp only [k5Wrap, ControlLoan1589.loanWindow, k5_rename_tc, k5_rename_mc,
    toffoliCount_append, measurementCount_append, ht, hm]
  constructor <;> omega

theorem k5Wrap_slots (P Q : Program) (k : Nat) (h : gateSlots P ≤ gateSlots Q + k) :
    gateSlots (k5Wrap P) ≤ gateSlots (k5Wrap Q) + k := by
  simp only [k5Wrap, ControlLoan1589.loanWindow, Baselines.rename_gateSlots, gateSlots_append]
  omega

theorem k5Wrap_physical (P : Program) (hp : GatePhysical P) : GatePhysical (k5Wrap P) := by
  have pad := (InverseEndpointWires.pad_facts 507 (base 512)).2.2.2.2
  exact gatePhysical_rename _ (Equiv.swap (base 760) (base 717)).injective _
    (gatePhysical_rename _ (shifted Placement5.pi0).injective _
      (ControlLoan1589.loanWindow_physical _ _ _ _ (by decide +kernel)
        ((gatePhysical_append _ _).mpr ⟨hp, pad⟩)))

theorem cellDecoderLoan_counts :
    toffoliCount cellDecoderLoan = toffoliCount cellDecoderNext + 44 ∧
      measurementCount cellDecoderLoan = measurementCount cellDecoderNext + 44 := by
  obtain ⟨t, m, -, -⟩ := cellDecoderLoan_facts
  obtain ⟨t0, m0⟩ := CompareDecoder.counts
  exact ⟨by omega, by omega⟩

theorem endPacket760DivLoan_counts :
    toffoliCount endPacket760DivLoan = toffoliCount (R2SqEp760.endPacket760 true) + 44 ∧
      measurementCount endPacket760DivLoan =
        measurementCount (R2SqEp760.endPacket760 true) + 44 := by
  rw [endPacket760DivLoan_k5, endPacket760_true_k5]
  exact k5Wrap_counts _ _ 44 cellDecoderLoan_counts.1 cellDecoderLoan_counts.2

/-- The loaned division endpoint costs at most 10,000 slots more than the record endpoint. -/
theorem k5_divLoan_slots_le :
    gateSlots endPacket760DivLoan ≤ gateSlots (R2SqEp760.endPacket760 true) + 10000 := by
  rw [endPacket760DivLoan_k5, endPacket760_true_k5]
  obtain ⟨-, -, g, -⟩ := cellDecoderLoan_facts
  exact k5Wrap_slots _ _ _ (by omega)

theorem not_mem_wires_of_all (P : Program) (q : Wire)
    (h : P.all (fun i => decide (q ∉ Instr.wires i)) = true) : q ∉ wires P := by
  induction P with
  | nil => simp [wires]
  | cons i P ih =>
      simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq] at h
      have tail := ih h.2
      intro used
      rw [wires, Finset.mem_union] at used
      rcases used with here | there
      · exact h.1 here
      · exact tail there





theorem cellDecoderLoan_physical : GatePhysical cellDecoderLoan :=
  cellDecoderLoan_facts.2.2.2

theorem endPacket760DivLoan_physical : GatePhysical endPacket760DivLoan := by
  rw [endPacket760DivLoan_k5]
  exact k5Wrap_physical _ cellDecoderLoan_physical

end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan
end Merge_StairBoundaryLoanDecoder_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBoundaryLoanFrames_at_StairSideA` -/
section Merge_StairBoundaryLoanFrames_at_StairSideA

/-!
# Boundary carry loans: the converter ladders are clean on reachable states

The record runs `canon760` on `Rolling1588Frame.EncodedFieldFrame isA origin X 0`
and `center760` on `Rolling1588Frame.EncodedCanonicalFrame isA origin X 0`.  Both
frames are the `OB5.sig 511` pull of the unencoded-plus-`allEncode` frames
`EncodedFieldFrame5` / `EncodedCanonicalFrame5`.  Every ladder wire of
`converterLayout760`, pulled by `OB5.sig 511`, lies in one of five classes
(`ladder_classified`, checked by the kernel):

* `Placement5.workRegion` / `Placement5.holeRegion` — zero in encoded frames
  (`Rolling1588.encoded_zero_region`, resp. the record's canonical-frame
  argument via `encodedCanonical_pool_basis5` + `allEncode_holes_zero`);
* endpoint work wires outside the encoder support and outside both field
  registers — zero on the unencoded state by the record's `base 760` argument;
* the selector `base 2409` — zero by `ctx.hg0`;
* `base 771`, `base 772` — bits of the zero second field register.

Hence the clean-ladder premise of `canon760Loan_run_eq_of_clean` /
`center760Loan_run_eq_of_clean` holds on every reachable input, giving the
unconditional `canon760Loan_run_eq` / `center760Loan_run_eq`.
-/

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairBoundaryLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField




section Far
attribute [local irreducible] wires Rolling1588.allEncode


end Far




/-- Field frame (second register `0`): every classified wire is clean. -/
theorem field_pulled_zero {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X : Fp) (t : State)
    (frame : Rolling1588.EncodedFieldFrame5 base (base 2409) isA origin X 0 t)
    (v : Wire) (hv : PulledClass v) : t.basis v = false := by
  have zr := Rolling1588.encoded_zero_region base (base 2409) isA ctx.hn
    (ctx.hp (base 2409) (by simp)) origin ctx.env ctx.legal X 0 t frame
  obtain ⟨h16, cls⟩ := hv
  rw [base_sub v h16]
  obtain ⟨raw, _, pair, encoded⟩ := frame
  rcases cls with work | hole | ⟨wk, lo, far, notY, notR⟩ | sel | y1 | y2
  · exact zr _ (Or.inl work)
  · exact zr _ (Or.inr hole)
  · rw [encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA _ lo far)]
    exact (pair.2.2 _
      (by rw [balancedSharedPorts_r]; exact OwnPlusHost.not_block _ 2056 256 (by omega))
      (by rw [balancedSharedPorts_y]; exact OwnPlusHost.not_block _ 770 256 (by omega))).trans
      (origin_work_clean origin ctx _ wk)
  · rw [sel, encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA 2409 (by omega) (by omega))]
    exact (pair.2.2 _
      (by rw [balancedSharedPorts_r]; exact OwnPlusHost.not_block 2409 2056 256 (by omega))
      (by rw [balancedSharedPorts_y]; exact OwnPlusHost.not_block 2409 770 256 (by omega))).trans
      ctx.hg0
  · rw [y1, encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA 771 (by omega) (by omega))]
    apply (regValue_zero _ _).mp (pair.2.1.trans NewHalfField5.centerWord_zero)
    rw [balancedSharedPorts_y]
    exact List.mem_map.mpr ⟨771, by simp [List.mem_range'_1], rfl⟩
  · rw [y2, encoded, run_preserves_outside _ [] raw _ (allEncode_far' isA 772 (by omega) (by omega))]
    apply (regValue_zero _ _).mp (pair.2.1.trans NewHalfField5.centerWord_zero)
    rw [balancedSharedPorts_y]
    exact List.mem_map.mpr ⟨772, by simp [List.mem_range'_1], rfl⟩



/-- The `canon760` ladder is clean on the record's canon input frame. -/
theorem canon_ladder_clean {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X : Fp) (s : State)
    (input : Rolling1588Frame.EncodedFieldFrame isA origin X 0 s) :
    ∀ q ∈ converterLayout760.carry.take 254, s.basis q = false := by
  intro q hq
  have h := field_pulled_zero origin ctx X (pullState (OB5.sig 511) s) input
    (OB5.sig 511 q) (ladder_classified q hq)
  change s.basis (OB5.sig 511 (OB5.sig 511 q)) = false at h
  rwa [sig511_invol] at h


/-! ## Unconditional run equalities on reachable states -/

/-- Same frame as `R2SqEp760.canon760_run_eq`; independent records. -/
theorem canon760Loan_run_eq {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X : Fp) (s : State) (m n : List Bool)
    (input : Rolling1588Frame.EncodedFieldFrame isA origin X 0 s) :
    run canon760Loan m s = run R2SqEp760.canon760 n s :=
  canon760Loan_run_eq_of_clean s (canon_ladder_clean origin ctx X s input) m n




end ECDSAAdd.Entrant.StairBoundaryLoan
end Merge_StairBoundaryLoanFrames_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanRearrange_at_StairSideA` -/
section Merge_StairDivLoanRearrange_at_StairSideA

/-!
# Division-endpoint decoder loan, part 1: program rearrangement

`CompareDecoder.cellDecoderNext` runs its literal comparison through
`borrowPath`, which wraps every majority (resp. erase) gate in `X x_i … X x_i`,
and inverts all 255 ladder carries around `lowBlock`.  Here we prove, for all
records and all states, that it is run-equivalent to the unloaned form
`cellDecoderUnloan` (= `cellDecoderLoan` with `window760 0`), in which
* the `X` conjugation is factored out (`notRegister xs ++ emitUps ladder ++ notRegister xs`,
  likewise for the erase pass), and
* the carry inversions survive only on the six carries `lowLive` read by `lowBlock`.

Main result: `cellDecoderNext_REq : LREq cellDecoderNext cellDecoderUnloan`.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed

/-! ## Record-wise run equivalence -/

/-- Same measurement count and the same run on every record and state. -/
def LREq (P Q : Program) : Prop :=
  measurementCount P = measurementCount Q ∧ ∀ (m : List Bool) (s : State), run P m s = run Q m s

theorem LREq.refl (P : Program) : LREq P P := ⟨rfl, fun _ _ => rfl⟩

theorem LREq.symm {P Q : Program} (h : LREq P Q) : LREq Q P :=
  ⟨h.1.symm, fun m s => (h.2 m s).symm⟩

theorem LREq.trans {P Q R : Program} (h : LREq P Q) (g : LREq Q R) : LREq P R :=
  ⟨h.1.trans g.1, fun m s => (h.2 m s).trans (g.2 m s)⟩

theorem LREq.append {P P' Q Q' : Program} (h : LREq P P') (g : LREq Q Q') :
    LREq (P ++ Q) (P' ++ Q') := by
  refine ⟨by rw [measurementCount_append, measurementCount_append, h.1, g.1], ?_⟩
  intro m s
  rw [run_append, run_append, h.1, h.2, g.2]

theorem LREq.ctx (A B : Program) {Q Q' : Program} (h : LREq Q Q') :
    LREq (A ++ Q ++ B) (A ++ Q' ++ B) :=
  ((LREq.refl A).append h).append (LREq.refl B)

theorem run_zero_rec (p : Program) (hp : measurementCount p = 0) (m : List Bool) (s : State) :
    run p m s = run p [] s := by
  rw [← run_take p m s, hp, List.take_zero]

theorem LREq.comm (p q : Program) (hp : measurementCount p = 0)
    (hd : Disjoint (wires p) (wires q)) : LREq (p ++ q) (q ++ p) := by
  refine ⟨by rw [measurementCount_append, measurementCount_append, Nat.add_comm], ?_⟩
  intro m s
  have e1 : run (p ++ q) m s = run q m (run p [] s) := by
    rw [run_append, hp, List.take_zero, List.drop_zero]
  have e2 : run (q ++ p) m s = run p [] (run q m s) := by
    rw [run_append, run_take, run_zero_rec p hp]
  rw [e1, e2]
  exact (run_disjoint_commute p q hd [] m s).symm

/-! ## `X` registers -/

/-- Parity of the occurrences of `q` in `l`. -/
def flipPar (l : List Wire) (q : Wire) : Bool := l.foldr (fun a acc => decide (a = q) ^^ acc) false

theorem flipPar_nil (q : Wire) : flipPar [] q = false := rfl

theorem flipPar_cons (a : Wire) (l : List Wire) (q : Wire) :
    flipPar (a :: l) q = (decide (a = q) ^^ flipPar l q) := rfl

theorem flipPar_append (l l' : List Wire) (q : Wire) :
    flipPar (l ++ l') q = (flipPar l q ^^ flipPar l' q) := by
  induction l with
  | nil => rw [List.nil_append, flipPar_nil, Bool.false_xor]
  | cons a l ih => rw [List.cons_append, flipPar_cons, flipPar_cons, ih, Bool.xor_assoc]

theorem run_notRegister (l : List Wire) (m : List Bool) (s : State) :
    run (notRegister l) m s = ⟨s.phase, fun q => s.basis q ^^ flipPar l q⟩ := by
  induction l generalizing s with
  | nil =>
    show s = ⟨s.phase, fun q => s.basis q ^^ false⟩
    cases s
    simp
  | cons a l ih =>
    show run (notRegister l) m ⟨s.phase, writeBit s.basis a (!s.basis a)⟩ = _
    rw [ih]
    show (⟨s.phase, fun q => writeBit s.basis a (!s.basis a) q ^^ flipPar l q⟩ : State) =
      ⟨s.phase, fun q => s.basis q ^^ flipPar (a :: l) q⟩
    congr 1
    funext q
    rw [flipPar_cons]
    by_cases h : a = q
    · rw [decide_eq_true h]
      show (Function.update s.basis a (!s.basis a) q ^^ flipPar l q) =
        (s.basis q ^^ (true ^^ flipPar l q))
      rw [← h, Function.update_self]
      cases s.basis a <;> cases flipPar l a <;> rfl
    · rw [decide_eq_false h, Bool.false_xor]
      show (Function.update s.basis a (!s.basis a) q ^^ flipPar l q) = (s.basis q ^^ flipPar l q)
      rw [Function.update_of_ne (Ne.symm h)]

theorem notRegister_append (l l' : List Wire) :
    notRegister (l ++ l') = notRegister l ++ notRegister l' := by
  simp [notRegister]

theorem LREq.notRegister_par (l l' : List Wire) (h : ∀ q, flipPar l q = flipPar l' q) :
    LREq (notRegister l) (notRegister l') := by
  refine ⟨by rw [(notRegister_counts l).2, (notRegister_counts l').2], ?_⟩
  intro m s
  rw [run_notRegister, run_notRegister]
  congr 1
  funext q
  rw [h q]

theorem LREq.notRegister_twice (l : List Wire) : LREq (notRegister l ++ notRegister l) [] := by
  rw [← notRegister_append]
  exact LREq.notRegister_par (l ++ l) [] (fun q => by
    rw [flipPar_append, flipPar_nil]
    cases flipPar l q <;> rfl)

theorem mem_wires_notRegister (l : List Wire) (q : Wire) :
    q ∈ wires (notRegister l) ↔ q ∈ l := by
  rw [notRegister_wires, List.mem_toFinset]

theorem mem_wires_X (x q : Wire) : q ∈ wires [Instr.X x] ↔ q = x := by
  simp [wires, Instr.wires]

theorem disjoint_of (p q : Program) (h : ∀ a ∈ wires p, a ∉ wires q) :
    Disjoint (wires p) (wires q) := by
  rw [Finset.disjoint_left]
  intro a ha hb
  exact h a ha hb

theorem LREq.notRegister_comm (l : List Wire) (P : Program) (h : ∀ q ∈ l, q ∉ wires P) :
    LREq (notRegister l ++ P) (P ++ notRegister l) :=
  LREq.comm _ _ (notRegister_counts l).2
    (disjoint_of _ _ (fun a ha => h a ((mem_wires_notRegister l a).mp ha)))

theorem LREq.X_comm (x : Wire) (P : Program) (h : x ∉ wires P) :
    LREq ([Instr.X x] ++ P) (P ++ [Instr.X x]) :=
  LREq.comm _ _ rfl (disjoint_of _ _ (fun a ha => by rw [(mem_wires_X x a).mp ha]; exact h))

/-! ## Bare literal-borrow ladders -/

def ups : List Wire → List Wire → Wire → Nat → Program
  | x::xs, c::cs, cin, k =>
      mappedMajority { wire := none, flip := decide (k % 2 = 1) } x cin c ++ ups xs cs c (k / 2)
  | _, _, _, _ => []

def downs : List Wire → List Wire → Wire → Nat → Program
  | x::xs, c::cs, cin, k =>
      downs xs cs c (k / 2) ++ mappedEraseCarry { wire := none, flip := decide (k % 2 = 1) } x cin c
  | _, _, _, _ => []

theorem mm_wires (b : Bool) (x cin c q : Wire)
    (hq : q ∈ wires (mappedMajority { wire := none, flip := b } x cin c)) :
    q = x ∨ q = cin ∨ q = c := by
  cases b <;> simp [mappedMajority, wires, Instr.wires] at hq <;> tauto

theorem me_wires (b : Bool) (x cin c q : Wire)
    (hq : q ∈ wires (mappedEraseCarry { wire := none, flip := b } x cin c)) :
    q = x ∨ q = cin ∨ q = c := by
  cases b <;> simp [mappedEraseCarry, wires, Instr.wires, correctionWires] at hq <;> tauto

theorem ups_wires (xs cs : List Wire) (cin : Wire) (k : Nat) (q : Wire)
    (hq : q ∈ wires (ups xs cs cin k)) : q ∈ xs ∨ q ∈ cs ∨ q = cin := by
  induction xs generalizing cs cin k with
  | nil =>
    have e : ups [] cs cin k = [] := by cases cs <;> rfl
    rw [e] at hq
    simp [wires] at hq
  | cons x xs ih =>
    cases cs with
    | nil =>
      have e : ups (x :: xs) [] cin k = [] := rfl
      rw [e] at hq
      simp [wires] at hq
    | cons c cs =>
      simp only [ups, wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · rcases mm_wires _ x cin c q h with e | e | e
        · exact Or.inl (by simp [e])
        · exact Or.inr (Or.inr e)
        · exact Or.inr (Or.inl (by simp [e]))
      · rcases ih cs c (k / 2) h with e | e | e
        · exact Or.inl (by simp [e])
        · exact Or.inr (Or.inl (by simp [e]))
        · exact Or.inr (Or.inl (by simp [e]))

theorem downs_wires (xs cs : List Wire) (cin : Wire) (k : Nat) (q : Wire)
    (hq : q ∈ wires (downs xs cs cin k)) : q ∈ xs ∨ q ∈ cs ∨ q = cin := by
  induction xs generalizing cs cin k with
  | nil =>
    have e : downs [] cs cin k = [] := by cases cs <;> rfl
    rw [e] at hq
    simp [wires] at hq
  | cons x xs ih =>
    cases cs with
    | nil =>
      have e : downs (x :: xs) [] cin k = [] := rfl
      rw [e] at hq
      simp [wires] at hq
    | cons c cs =>
      simp only [downs, wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · rcases ih cs c (k / 2) h with e | e | e
        · exact Or.inl (by simp [e])
        · exact Or.inr (Or.inl (by simp [e]))
        · exact Or.inr (Or.inl (by simp [e]))
      · rcases me_wires _ x cin c q h with e | e | e
        · exact Or.inl (by simp [e])
        · exact Or.inr (Or.inr e)
        · exact Or.inr (Or.inl (by simp [e]))

/-- The compute pass: `X` conjugation factors out of the borrow chain. -/
theorem borrowPath_false_REq (xs cs : List Wire) (cin : Wire) (k : Nat) :
    xs.length = cs.length → xs.Nodup → cs.Nodup → (∀ q ∈ xs, q ∉ cs) →
    cin ∉ xs → cin ∉ cs →
    LREq (borrowPath false xs cs cin k)
      (notRegister xs ++ ups xs cs cin k ++ notRegister xs) := by
  induction xs generalizing cs cin k with
  | nil =>
    intro hlen hx hc hxc hix hic
    cases cs with
    | nil => exact LREq.refl []
    | cons c cs => simp at hlen
  | cons x xs ih =>
    intro hlen hx hc hxc hix hic
    cases cs with
    | nil => simp at hlen
    | cons c cs =>
      have hx' := List.nodup_cons.mp hx
      have hc' := List.nodup_cons.mp hc
      have xc : x ∉ c :: cs := hxc x (by simp)
      have x_c : x ≠ c := fun e => xc (by simp [e])
      have x_cs : x ∉ cs := fun e => xc (by simp [e])
      have c_xs : c ∉ xs := fun e => hxc c (by simp [e]) (by simp)
      have xs_cs : ∀ q ∈ xs, q ∉ cs := fun q hq e => hxc q (by simp [hq]) (by simp [e])
      have cin_xs : cin ∉ xs := fun e => hix (by simp [e])
      have IH := ih cs c (k / 2) (by simpa using hlen) hx'.2 hc'.2 xs_cs c_xs hc'.1
      let M := mappedMajority { wire := none, flip := decide (k % 2 = 1) } x cin c
      let N := notRegister xs
      let U := ups xs cs c (k / 2)
      have eL : borrowPath false (x :: xs) (c :: cs) cin k =
          [Instr.X x] ++ M ++ [Instr.X x] ++ borrowPath false xs cs c (k / 2) := rfl
      have eR : notRegister (x :: xs) ++ ups (x :: xs) (c :: cs) cin k ++ notRegister (x :: xs) =
          [Instr.X x] ++ N ++ (M ++ U) ++ ([Instr.X x] ++ N) := rfl
      have xN : x ∉ wires N := by
        rw [mem_wires_notRegister]; exact hx'.1
      have NM : ∀ q ∈ xs, q ∉ wires M := by
        intro q hq hm
        rcases mm_wires _ x cin c q hm with e | e | e
        · exact hx'.1 (e ▸ hq)
        · exact cin_xs (e ▸ hq)
        · exact c_xs (e ▸ hq)
      have xU : x ∉ wires U := by
        intro hm
        rcases ups_wires xs cs c (k / 2) x hm with e | e | e
        · exact hx'.1 e
        · exact x_cs e
        · exact x_c e
      have s1 : LREq ([Instr.X x] ++ M ++ [Instr.X x] ++ borrowPath false xs cs c (k / 2))
          ([Instr.X x] ++ M ++ [Instr.X x] ++ (N ++ U ++ N)) := (LREq.refl _).append IH
      have c1 : LREq ([Instr.X x] ++ N) (N ++ [Instr.X x]) := LREq.X_comm x N xN
      have c2 : LREq (M ++ N) (N ++ M) := (LREq.notRegister_comm xs M NM).symm
      have c3 : LREq ([Instr.X x] ++ U) (U ++ [Instr.X x]) := LREq.X_comm x U xU
      have t1 := LREq.ctx ([Instr.X x] ++ M) (U ++ N) c1
      have t2 := LREq.ctx [Instr.X x] ([Instr.X x] ++ (U ++ N)) c2
      have t3 := LREq.ctx ([Instr.X x] ++ N ++ M) N c3
      rw [eL, eR]
      simp only [List.append_assoc, List.append_nil, List.nil_append] at s1 t1 t2 t3 ⊢
      exact s1.trans (t1.trans (t2.trans t3))

/-- The erase pass: `X` conjugation factors out of the borrow-erase chain. -/
theorem borrowPath_true_REq (xs cs : List Wire) (cin : Wire) (k : Nat) :
    xs.length = cs.length → xs.Nodup → cs.Nodup → (∀ q ∈ xs, q ∉ cs) →
    cin ∉ xs → cin ∉ cs →
    LREq (borrowPath true xs cs cin k)
      (notRegister xs ++ downs xs cs cin k ++ notRegister xs) := by
  induction xs generalizing cs cin k with
  | nil =>
    intro hlen hx hc hxc hix hic
    cases cs with
    | nil => exact LREq.refl []
    | cons c cs => simp at hlen
  | cons x xs ih =>
    intro hlen hx hc hxc hix hic
    cases cs with
    | nil => simp at hlen
    | cons c cs =>
      have hx' := List.nodup_cons.mp hx
      have hc' := List.nodup_cons.mp hc
      have xc : x ∉ c :: cs := hxc x (by simp)
      have x_c : x ≠ c := fun e => xc (by simp [e])
      have x_cs : x ∉ cs := fun e => xc (by simp [e])
      have c_xs : c ∉ xs := fun e => hxc c (by simp [e]) (by simp)
      have xs_cs : ∀ q ∈ xs, q ∉ cs := fun q hq e => hxc q (by simp [hq]) (by simp [e])
      have cin_xs : cin ∉ xs := fun e => hix (by simp [e])
      have IH := ih cs c (k / 2) (by simpa using hlen) hx'.2 hc'.2 xs_cs c_xs hc'.1
      let E := mappedEraseCarry { wire := none, flip := decide (k % 2 = 1) } x cin c
      let N := notRegister xs
      let D := downs xs cs c (k / 2)
      have eL : borrowPath true (x :: xs) (c :: cs) cin k =
          borrowPath true xs cs c (k / 2) ++ ([Instr.X x] ++ E ++ [Instr.X x]) := rfl
      have eR : notRegister (x :: xs) ++ downs (x :: xs) (c :: cs) cin k ++ notRegister (x :: xs) =
          [Instr.X x] ++ N ++ (D ++ E) ++ ([Instr.X x] ++ N) := rfl
      have xN : x ∉ wires N := by
        rw [mem_wires_notRegister]; exact hx'.1
      have NE : ∀ q ∈ xs, q ∉ wires E := by
        intro q hq hm
        rcases me_wires _ x cin c q hm with e | e | e
        · exact hx'.1 (e ▸ hq)
        · exact cin_xs (e ▸ hq)
        · exact c_xs (e ▸ hq)
      have xD : x ∉ wires D := by
        intro hm
        rcases downs_wires xs cs c (k / 2) x hm with e | e | e
        · exact hx'.1 e
        · exact x_cs e
        · exact x_c e
      have s1 : LREq (borrowPath true xs cs c (k / 2) ++ ([Instr.X x] ++ E ++ [Instr.X x]))
          (N ++ D ++ N ++ ([Instr.X x] ++ E ++ [Instr.X x])) := IH.append (LREq.refl _)
      have c1 : LREq (N ++ [Instr.X x]) ([Instr.X x] ++ N) := (LREq.X_comm x N xN).symm
      have c2 : LREq (N ++ E) (E ++ N) := LREq.notRegister_comm xs E NE
      have c4 : LREq (D ++ [Instr.X x]) ([Instr.X x] ++ D) := (LREq.X_comm x D xD).symm
      have t1 := LREq.ctx (N ++ D) (E ++ [Instr.X x]) c1
      have t2 := LREq.ctx (N ++ D ++ [Instr.X x]) [Instr.X x] c2
      have t3 := LREq.ctx (N ++ D ++ [Instr.X x] ++ E) [] c1
      have t4 := LREq.ctx N (E ++ ([Instr.X x] ++ N)) c4
      have t5 := LREq.ctx [] (D ++ (E ++ ([Instr.X x] ++ N))) c1
      rw [eL, eR]
      simp only [List.append_assoc, List.append_nil, List.nil_append] at s1 t1 t2 t3 t4 t5 ⊢
      exact s1.trans (t1.trans (t2.trans (t3.trans (t4.trans t5))))

/-! ## Concrete instance -/

/-- K5 (replay budget): one bit-mask nodup pass instead of quadratic `List.Nodup` decisions. -/
theorem k5_ladder_nodup : (cin :: (xs ++ cs)).Nodup :=
  StairLoan.nodup_of_mask _ (by decide +kernel)

theorem ladder_inputs :
    xs.length = cs.length ∧ xs.Nodup ∧ cs.Nodup ∧ (∀ q ∈ xs, q ∉ cs) ∧ cin ∉ xs ∧ cin ∉ cs := by
  have nd := List.nodup_cons.mp k5_ladder_nodup
  have nd2 := List.nodup_append.mp nd.2
  exact ⟨by decide +kernel, nd2.1, nd2.2.1, fun q hq hc => nd2.2.2 q hq q hc rfl,
    fun h => nd.1 (List.mem_append_left _ h), fun h => nd.1 (List.mem_append_right _ h)⟩

theorem ups_eq : ups xs cs cin K = StairLoan.emitUps ladder := by decide +kernel

theorem downs_eq : downs xs cs cin K = StairLoan.emitDowns ladder := by decide +kernel

theorem emitUps_ladder :
    StairLoan.emitUps ladder = StairLoan.emitUps headL ++ StairLoan.emitUps tailL := by
  rw [← StairLoan.emitUps_append, headL, tailL, List.take_append_drop]

theorem emitDowns_ladder :
    StairLoan.emitDowns ladder = StairLoan.emitDowns tailL ++ StairLoan.emitDowns headL := by
  rw [← StairLoan.emitDowns_append, headL, tailL, List.take_append_drop]

theorem borrowFront_REq : LREq (borrowPath false xs cs cin K)
    (notRegister xs ++ (StairLoan.emitUps headL ++ StairLoan.emitUps tailL) ++ notRegister xs) := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := ladder_inputs
  have h := borrowPath_false_REq xs cs cin K h1 h2 h3 h4 h5 h6
  rwa [ups_eq, emitUps_ladder] at h

theorem borrowBack_REq : LREq (borrowPath true xs cs cin K)
    (notRegister xs ++ (StairLoan.emitDowns tailL ++ StairLoan.emitDowns headL) ++ notRegister xs) := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := ladder_inputs
  have h := borrowPath_true_REq xs cs cin K h1 h2 h3 h4 h5 h6
  rwa [downs_eq, emitDowns_ladder] at h

/-- Ladder carries other than `lowLive`. -/
def restCarries : List Wire := cs.take 5 ++ cs.drop 11

theorem cs_split : cs = cs.take 5 ++ lowLive ++ cs.drop 11 := by decide +kernel

/-- K5 (replay budget): avoidance of a wire list from ONE operand mask of the program
(`StairDivLoanTop.k1progMask`) against the bit mask of the list. -/
theorem k5_mask_avoid (P : Program) (S : List Wire)
    (h : (StairDivLoanTop.k1progMask P &&& StairLoan.maskOf S) = 0) :
    S.all (fun q => P.all (fun i => decide (q ∉ Instr.wires i))) = true := by
  rw [List.all_eq_true]
  intro q hq
  apply StairDivLoanTop.k1_all_not_mem_of_mask
  have h2 : (StairLoan.maskOf S).testBit q = true := by
    rw [StairLoan.testBit_maskOf]
    exact decide_eq_true hq
  have h' := congrArg (fun n => Nat.testBit n q) h
  simp only [Nat.testBit_and, Nat.zero_testBit, h2, Bool.and_true] at h'
  exact h'

theorem rest_avoid_low_check :
    restCarries.all (fun q => (lowBlock fixedLayout).all (fun i => decide (q ∉ Instr.wires i))) = true :=
  -- K5 (replay budget): one operand mask of `lowBlock` (was one pass per carry, 4 s).
  k5_mask_avoid _ _ (by decide +kernel)

theorem rest_avoid_low : ∀ q ∈ restCarries, q ∉ wires (lowBlock fixedLayout) := by
  intro q hq
  exact not_mem_wires_of_all _ q (List.all_eq_true.mp rest_avoid_low_check q hq)

/-- Carry-flip cancellation across `lowBlock` outside carries 5–10. -/
theorem mid_REq : LREq (invertCarry fixedLayout ++ lowBlock fixedLayout ++ invertCarry fixedLayout)
    (lowLive.map (fun q => Instr.X q) ++ lowBlock fixedLayout ++ lowLive.map (fun q => Instr.X q)) := by
  show LREq (notRegister cs ++ lowBlock fixedLayout ++ notRegister cs)
    (notRegister lowLive ++ lowBlock fixedLayout ++ notRegister lowLive)
  have p1 : LREq (notRegister cs) (notRegister lowLive ++ notRegister restCarries) := by
    rw [← notRegister_append]
    apply LREq.notRegister_par
    intro q
    rw [cs_split]
    simp only [restCarries, flipPar_append]
    cases flipPar (cs.take 5) q <;> cases flipPar lowLive q <;> cases flipPar (cs.drop 11) q <;> rfl
  have p2 : LREq (notRegister cs) (notRegister restCarries ++ notRegister lowLive) := by
    rw [← notRegister_append]
    apply LREq.notRegister_par
    intro q
    rw [cs_split]
    simp only [restCarries, flipPar_append]
    cases flipPar (cs.take 5) q <;> cases flipPar lowLive q <;> cases flipPar (cs.drop 11) q <;> rfl
  have c : LREq (notRegister restCarries ++ lowBlock fixedLayout)
      (lowBlock fixedLayout ++ notRegister restCarries) :=
    LREq.notRegister_comm _ _ rest_avoid_low
  have tw := LREq.notRegister_twice restCarries
  have s1 := (p1.append (LREq.refl (lowBlock fixedLayout))).append p2
  have t1 := LREq.ctx (notRegister lowLive) (notRegister restCarries ++ notRegister lowLive) c
  have t2 := LREq.ctx (notRegister lowLive ++ lowBlock fixedLayout) (notRegister lowLive) tw
  simp only [List.append_assoc, List.append_nil, List.nil_append] at s1 t1 t2 ⊢
  exact s1.trans (t1.trans t2)

/-- The unloaned form: `cellDecoderLoan` with `window760 0` (no host is borrowed). -/
def cellDecoderUnloan : Program :=
  frontFast fixedLayout ++ upper fixedLayout ++ DirectDecoder.highBlock fixedLayout ++
    DirectDecoder.middle fixedLayout ++ [.X cin] ++ window760 0 ++
    [.X fixedLayout.sigma, .X cin] ++ restoreSource fixedLayout ++ copySource fixedLayout

/-- Part 1: the record's decoder and its rearranged unloaned form agree on every record. -/
theorem cellDecoderNext_REq : LREq cellDecoderNext cellDecoderUnloan := by
  have h := ((((((((LREq.refl (frontFast fixedLayout ++ upper fixedLayout ++
      DirectDecoder.highBlock fixedLayout ++ DirectDecoder.middle fixedLayout)).append
      (LREq.refl [Instr.X cin])).append borrowFront_REq).append
      (LREq.refl [Instr.X cin])).append mid_REq).append
      (LREq.refl [Instr.X cin, Instr.X fixedLayout.sigma, Instr.CX fixedLayout.sigma fixedLayout.h,
        Instr.measureX fixedLayout.h []
          [Correction.CZ fixedLayout.sigma (fixedLayout.carry.getLastD cin)]])).append
      borrowBack_REq).append (LREq.refl [Instr.X fixedLayout.sigma, Instr.X cin])).append
      (LREq.refl (restoreSource fixedLayout ++ copySource fixedLayout))
  simp only [List.append_assoc] at h
  simp only [cellDecoderNext, cellDecoderUnloan, cmpFront, cmpBack, window760, top760,
    StairLoan.emitLoan_zero, StairLoan.emitSweep, List.append_assoc]
  exact h

theorem cellDecoderUnloan_run (m : List Bool) (s : State) :
    run cellDecoderUnloan m s = run cellDecoderNext m s :=
  (cellDecoderNext_REq.2 m s).symm

end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan
end Merge_StairDivLoanRearrange_at_StairSideA

