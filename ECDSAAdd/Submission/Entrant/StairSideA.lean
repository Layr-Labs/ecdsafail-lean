/-- Record-frame replay of the loaned multiplication endpoint (the head's deficit-68 slot). -/
def EndpointReplay (loans : StairSchedule.StairLoans) : Prop :=
  ∀ origin : BasisState, FrontierReplay1591.Context origin → origin (base 2400) = true →
    ∀ X Y : Fp, X = Y → ∀ (s : State) (fresh old : List Bool),
      Rolling1588.EncodedFieldFrame5 base (base 2409) false origin X Y s →
      run (loans.endPacket false 68) fresh s = run (R2SqEp760.endPacket760 false) old s


/-- After the LT19 endpoint lands (`loans.endPacket false 68 = endPacket760Loan44 false`,
then `rfl`): no hypothesis at all (LT19's `endPacket760Loan44_run_eq`). -/
theorem endpointReplay_loan44 (loans : StairSchedule.StairLoans)
    (h : loans.endPacket false 68 = StairEndpointLoan44.endPacket760Loan44 false) :
    EndpointReplay loans := by
  intro origin ctx enabled X Y hXY s fresh old input
  rw [h]
  exact StairEndpointLoan44.endPacket760Loan44_run_eq false origin ctx enabled X Y hXY s
    fresh old input

/-- LT10's `exitLogicalHead_run_eq` with the endpoint replay as an input. -/
theorem exitLogicalHead_run_eq_of (half : StairLoanRecordShape.HalfReplayHypothesis)
    (hEnd : EndpointReplay StairConcrete.bestLoans)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400) = true) (X Y : Fp) (hXY : X = Y)
    (s : State)
    (input : Rolling1588.EncodedFieldFrame5 base (base 2409) false origin X Y s)
    (fresh old : List Bool) :
    run (StairConcrete.bestLoans.endPacket false 68 ++
        StairLoanRecordShape.slices StairConcrete.bestLoans false
          StairLoanExitHeadReplay.headSlices) fresh s =
      run (R2SqEp760.endPacket760 false ++
        StairLoanRecordShape.slices StairSchedule.recordLoans false
          StairLoanExitHeadReplay.headSlices) old s := by
  rw [run_append, run_append]
  rw [hEnd origin ctx enabled X Y hXY s _
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input]
  have ending := R2SqEp760.endPacket760_frame false false origin ctx enabled X Y
    (fun bad => absurd bad (by decide)) (fun _ => hXY) s
    (old.take (measurementCount (R2SqEp760.endPacket760 false))) input
  have cut := (Rolling1588.cutFrame_end origin _ _ _).mpr ending.2
  exact StairLoanRecordShape.backward_slices_run_eq half StairLoanExitHeadReplay.headSlices
    102 100 StairLoanExitHeadReplay.headSlices_chain origin ctx enabled _ _ _ cut _ _

/-- LT10's `headPrefix_run_eq` with the endpoint replay as an input. -/
theorem headPrefix_run_eq_of (half : StairLoanRecordShape.HalfReplayHypothesis)
    (hEnd : EndpointReplay StairConcrete.bestLoans)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (fresh old : List Bool) :
    run (StairLoanExitHeadReplay.headPrefixShape StairConcrete.bestLoans) fresh state =
      run (StairLoanExitHeadReplay.headPrefixShape StairSchedule.recordLoans) old state := by
  have centerAt (b : List Bool) :=
    R2SqEp760.center760_frame origin ctx ha Y state b input
  have headEq : ∀ a b,
      run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN) a state =
        run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state := by
    intro a b
    apply StairLoanRecordShape.head_replace _ _ _ state
    · intro a b
      exact StairBoundaryLoan.center760Loan_run_eq origin ctx ha Y state a b input
    · intro b a c
      have v := (centerAt b).2
      exact StairLoanRecordShape.run_eq_of_phase _ _ a c
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ a v).1
        (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ c v).1
  have wAll : ∀ b, Rolling1588Frame.EncodedFieldFrame false origin (Y / 2)
      (Y / 2) (run (R2SqEp760.center760 ++ HalfFieldOB5.copyN) b state) := by
    intro b
    rw [run_append]
    exact (Rolling1588HalfFieldOB5.copy_fill ctx.hn origin _ _ _ (centerAt _).2).2
  show run (StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (StairConcrete.bestLoans.endPacket false 68 ++
        StairLoanRecordShape.slices StairConcrete.bestLoans false
          StairLoanExitHeadReplay.headSlices)) fresh state =
    run (R2SqEp760.center760 ++ HalfFieldOB5.copyN ++
      renameProgram (OB5.sig 511) (R2SqEp760.endPacket760 false ++
        StairLoanRecordShape.slices StairSchedule.recordLoans false
          StairLoanExitHeadReplay.headSlices)) old state
  apply StairLoanRecordShape.both_replace _ _ _ _ state headEq
  intro b a c
  have w := wAll b
  rw [StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    StairRename.rename_run_conjugate (OB5.sig 511)
      (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
    exitLogicalHead_run_eq_of half hEnd origin ctx enabled (Y / 2) (Y / 2) rfl _ w a c]

