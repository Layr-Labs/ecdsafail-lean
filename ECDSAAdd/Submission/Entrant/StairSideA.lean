def FactsTrip (B B' : Nat) : Prop :=
  B ≠ 12 ∧ 5 < startFor B' ∧ startFor B' % 5 = 0 ∧ startFor B' ≤ 511 ∧
  startFor B' ∈ StairField2V3ExitRowTrips.rowLetters ∧ startFor B' ≠ 5 ∧
