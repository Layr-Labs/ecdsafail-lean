section Merge_StairLoanInverseRawHead_at_StairSideA

/-!
# Raw-subtraction head replay for the inverse carry-loan half

The expensive dependent-top instantiation is isolated here so its heartbeat
budget and linter work do not force recompilation of the core and block layers.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairLoanInverse

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField
open StairLoan

def rawSubHeadLoan (d : Nat) : Program :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  let a := L.ylow.getD 0 0
  let b := L.r0
  let c := carries.getD 0 0
  majority a b L.sign c ++ [.X b, .CX L.parity b] ++
    Q6LifetimeResearch.move (base 760) b
      (StairLoan.addTopLoan d StairLoan.retiredRoles
        (L.ylow.drop 1 ++ [L.ymsb, L.ymsb])
        (L.rtail ++ [L.rmsb, L.one]) (carries.drop 1) c) ++
    [.CX L.parity b, .X b] ++ eraseCarry a b L.sign c ++
    [.CX a b, .CX L.sign b]

def rawSubHeadOld : Program :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  let a := L.ylow.getD 0 0
  let b := L.r0
  let c := carries.getD 0 0
  majority a b L.sign c ++ [.X b, .CX L.parity b] ++
    Q6LifetimeResearch.move (base 760) b
      (Q6LifetimeResearch.addTop (L.ylow.drop 1 ++ [L.ymsb, L.ymsb])
        (L.rtail ++ [L.rmsb, L.one]) (carries.drop 1) c) ++
    [.CX L.parity b, .X b] ++ eraseCarry a b L.sign c ++
    [.CX a b, .CX L.sign b]

theorem rawHead_add_shape (x y carry : List Wire)
    (a b cin first topSource topTarget topCopy unused : Wire) :
    y.length = x.length →
    addInPlace ((a :: x) ++ [topSource, topSource])
        ((b :: y) ++ [topTarget, topCopy])
        ((first :: carry) ++ [unused]) cin =
      majority a b cin first ++
        addInPlace (x ++ [topSource, topSource])
          (y ++ [topTarget, topCopy]) (carry ++ [unused]) first ++
        eraseCarry a b cin first ++ [.CX a b, .CX cin b] := by
  intro hy
  cases x <;> cases y
  · rfl
  · simp at hy
  · simp at hy
  · rfl

def rawSubUpperOld : Program :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  addInPlace ((L.ylow.drop 1) ++ [L.ymsb, L.ymsb])
    (L.rtail ++ [L.rmsb, L.one])
    (carries.drop 1 ++ [L.carry.getD 255 0]) (carries.getD 0 0)

def rawSubUpperInput (s : State) : State :=
  let L := L760
  let carries := (Q6Structural.q6Carry L).take 255
  run (majority (L.ylow.getD 0 0) L.r0 L.sign (carries.getD 0 0)) [] s

/-- LT44 (replay budget): the two definitions as explicit equations, so that hypotheses about
`(run rawSubUpperOld [] (rawSubUpperInput s)).basis _` are transported by rewriting.  Passing
them through a definitional cast made the kernel unfold the projection `State.basis` and
evaluate `run` on the concrete adder (≈ 31 s per use). -/
theorem rawSubUpperOld_eq : rawSubUpperOld =
    addInPlace (L760.ylow.drop 1 ++ [L760.ymsb, L760.ymsb])
      (L760.rtail ++ [L760.rmsb, L760.one])
      (((Q6Structural.q6Carry L760).take 255).drop 1 ++ [L760.carry.getD 255 0])
      (((Q6Structural.q6Carry L760).take 255).getD 0 0) := rfl

theorem rawSubUpperInput_eq (s : State) : rawSubUpperInput s =
    run (majority (L760.ylow.getD 0 0) L760.r0 L760.sign
      (((Q6Structural.q6Carry L760).take 255).getD 0 0)) [] s := rfl

/-- Port facts of the ordinary upper adder (public copy of the record's
    private `prefix_ports`). -/
theorem upper_ports (x y carry : List Wire) (a t z last cin : Wire)
    (nd : (x++[a]++y++[t,z]++carry++[last,cin]).Nodup) :
    (cin::((y++[t,z])++(carry++[last]))).Nodup ∧
      List.Disjoint (x++[a,a]) (cin::((y++[t,z])++(carry++[last]))) := by
  constructor
  · apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp nd q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  · have split:((x++[a])++(y++[t,z]++carry++[last,cin])).Nodup := by
      simpa only [List.append_assoc] using nd
    have dis:=(List.nodup_append'.mp split).2.2
    apply List.disjoint_left.mpr
    intro q hq bad
    apply List.disjoint_left.mp dis
    · simpa only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_self] using hq
    · simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at bad ⊢
      tauto

/-! ## Generic raw-subtraction head replay

The concrete theorem below is a cheap instantiation of `rawHeadLoan_generic`,
whose proof never inspects a concrete wire list (all disjointness facts come
from one `Nodup` hypothesis, as in the record's `raw_sub_head_loan_eq`). -/

theorem inv_head_split (xs : List Wire) (h : xs≠[]) :
    xs=xs.getD 0 0::xs.drop 1 := by
  cases xs with
  | nil => exact False.elim (h rfl)
  | cons a xs => rfl

set_option maxHeartbeats 4000000 in
/-- Loaned version of the record's `raw_sub_head_loan_eq` (any wires). -/
theorem rawHeadLoan_generic (d : Nat) (roles x y carry : List Wire)
    (a b cin first parity topSource topTarget topCopy unused retired : Wire)
    (hy : y.length=x.length) (hc : carry.length=x.length) (hd : d+1≤carry.length)
    (nd : ([a,b,cin,first,parity]++x++[topSource]++y++[topTarget,topCopy]++
      carry++[unused]).Nodup) (member : retired∈carry)
    (roleTail : ∀q∈roles.take d,q∈carry.drop (d+1))
    (s : State) (fresh : List Bool)
    (low : s.basis b= !s.basis parity)
    (clean : ∀q∈first::(carry++[unused]),s.basis q=false)
    (post : (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) [] (run (majority a b cin first) [] s)).basis topCopy=
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) [] (run (majority a b cin first) [] s)).basis topTarget) :
    ∃ old, run (majority a b cin first++[.X b,.CX parity b]++
        Q6LifetimeResearch.move retired b
          (StairLoan.addTopLoan d roles (x++[topSource,topSource])
            (y++[topTarget,topCopy]) carry first)++
        [.CX parity b,.X b]++eraseCarry a b cin first++[.CX a b,.CX cin b]) fresh s=
      run (majority a b cin first++[.X b,.CX parity b]++
        Q6LifetimeResearch.move retired b
          (Q6LifetimeResearch.addTop (x++[topSource,topSource])
            (y++[topTarget,topCopy]) carry first)++
        [.CX parity b,.X b]++eraseCarry a b cin first++[.CX a b,.CX cin b]) old s := by
  let clear:Program:=[.X b,.CX parity b]
  let A:=majority a b cin first++clear
  let P:=Q6LifetimeResearch.move retired b
    (StairLoan.addTopLoan d roles (x++[topSource,topSource]) (y++[topTarget,topCopy]) carry first)
  let Q:=Q6LifetimeResearch.move retired b
    (Q6LifetimeResearch.addTop (x++[topSource,topSource]) (y++[topTarget,topCopy]) carry first)
  let R:Program:=[.CX parity b,.X b]++eraseCarry a b cin first++[.CX a b,.CX cin b]
  let u:=run (majority a b cin first) [] s
  let t:=run clear [] u
  have counts:=List.nodup_iff_count.mp nd
  have four:[a,b,cin,first].Nodup := by
    apply List.nodup_iff_count.mpr;intro q
    have h:=counts q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have split:([a,b,cin,parity]++(x++[topSource]++y++[topTarget,topCopy]++
      carry++[unused,first])).Nodup := by
    apply List.nodup_iff_count.mpr;intro q
    have h:=counts q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have upperND:(x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]).Nodup :=
    (List.nodup_append'.mp split).2.1
  have dis:List.Disjoint [a,b,cin,parity]
      (x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]) :=
    (List.nodup_append'.mp split).2.2
  have ports:=upper_ports x y carry topSource topTarget topCopy unused first upperND
  have parityNe:parity≠b := by
    have small:([a,b,cin,parity]:List Wire).Nodup := (List.nodup_append'.mp split).1
    simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at small
    tauto
  have oldSupport:wires (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
      (carry++[unused]) first)⊆
      (x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]).toFinset := by
    rw [addInPlace_wires _ _ _ _ (by simp [hy]) (by simp [hy,hc])]
    intro q used
    simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at used ⊢
    tauto
  have apart:Disjoint (wires clear) (wires (addInPlace (x++[topSource,topSource])
      (y++[topTarget,topCopy]) (carry++[unused]) first)) := by
    apply Finset.disjoint_left.mpr
    intro q left right
    have ls:q∈[a,b,cin,parity] := by
      simp [clear,wires,Instr.wires] at left
      simp only [List.mem_cons,List.not_mem_nil,or_false]
      tauto
    exact List.disjoint_left.mp dis ls (List.mem_toFinset.mp (oldSupport right))
  have clearKeeps(v:State)(q:Wire)(hq:q≠b)(ms:List Bool):
      (run clear ms v).basis q=v.basis q := by
    simp [clear,run,writeBit,hq]
  have bAway(q:Wire)(hq:q∈x++[topSource]++y++[topTarget,topCopy]++carry++[unused,first]):q≠b :=
    fun eq=>List.disjoint_left.mp dis (by simp) (eq ▸ hq)
  have firstEq:u=⟨s.phase,writeBit s.basis first
      (carryBit (s.basis a) (s.basis b) (s.basis cin))⟩ := by
    rw [show u=run (majority a b cin first) [] s from rfl,
      majority_correct a b cin first four]
    simp only [clean first (by simp),Bool.false_xor]
  have beforeFirst(q:Wire)(hq:q∈[a,b,cin,parity]++x++[topSource]++y++
      [topTarget,topCopy]++carry++[unused]):q≠first := by
    intro eq
    have h:=counts first
    have pos:=List.count_pos_iff.mpr (eq ▸ hq)
    simp only [List.count_append,List.count_cons,List.count_nil,beq_self_eq_true,if_true] at h pos
    omega
  have keep(q:Wire)(hq:q∈[a,b,cin,parity]++x++[topSource]++y++
      [topTarget,topCopy]++carry++[unused]):u.basis q=s.basis q := by
    rw [firstEq]
    simp only [writeBit,Function.update_of_ne (beforeFirst q hq)]
  have cleanU:∀q∈carry++[unused],u.basis q=false := by
    intro q hq
    exact (keep q (by simp only [List.mem_append,List.mem_cons,List.not_mem_nil,
      or_false] at hq ⊢;tauto)).trans (clean q (List.mem_cons_of_mem first hq))
  have ready:t.basis b=false ∧ (∀q∈carry++[unused],t.basis q=false) := by
    constructor
    · have rel:u.basis b= !u.basis parity := by
        simpa only [keep b (by simp),keep parity (by simp)] using low
      simp only [t,clear,run,writeBit,Function.update_self,Function.update_of_ne parityNe]
      rw [rel]
      cases u.basis parity <;> rfl
    · intro q hq
      rw [clearKeeps u q (bAway q (by simp only [List.mem_append,List.mem_cons,
        List.not_mem_nil,or_false] at hq ⊢;tauto)) []]
      exact cleanU q hq
  have postU(n:List Bool):
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n u).basis topCopy=
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n u).basis topTarget := by
    rw [CoherentTail.readonly_record_independent (x++[topSource,topSource])
      (y++[topTarget,topCopy]) (carry++[unused]) first ports.1 ports.2
      (by simp [hy]) (by simp [hy,hc]) u n [] cleanU]
    exact post
  have postT(n:List Bool):
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n t).basis topCopy=
      (run (addInPlace (x++[topSource,topSource]) (y++[topTarget,topCopy])
        (carry++[unused]) first) n t).basis topTarget := by
    rw [show t=run clear [] u from rfl,
      ←run_disjoint_commute clear _ apart [] n u,
      clearKeeps _ topCopy (bAway _ (by simp)) [],
      clearKeeps _ topTarget (bAway _ (by simp)) []]
    exact postU n
  have pullEq:pullState (Equiv.swap retired b) t=t :=
    FieldFrameOB5.pull_swap_zero retired b t (ready.2 retired (by simp [member])) ready.1
  have middle:∀m n,run P m t=run Q n t := by
    intro m n
    apply StairLoan.renameProgram_run_eq_of (Equiv.swap retired b)
    rw [pullEq]
    exact addTopLoan_run_eq d roles x y carry topSource topTarget topCopy unused first
      t m n hy hc hd upperND ready.2 roleTail (postT n)
  have aZero:measurementCount A=0 := rfl
  have executeA:run A (fresh.take (measurementCount A)) s=t := by
    rw [aZero,List.take_zero]
    show run (majority a b cin first++clear) [] s=t
    rw [run_append]
    simpa only [List.take_nil,List.drop_nil] using (show run clear [] u=t from rfl)
  obtain ⟨old,h⟩:=replace_middle_exists A P Q R s fresh (by
    intro m n
    rw [executeA]
    exact middle m n)
  exact ⟨old,by simpa only [A,P,Q,R,clear,List.append_assoc] using h⟩

section HeadLayout
open Arithmetic BalancedCircuit Arithmetic.BalancedField

set_option maxHeartbeats 2000000 in
/-- Layout facts of the raw-subtraction head (copied from the set-up of the
record's `Q6LifetimeProof.raw_sub_tail_eq`). -/
theorem inv_head_layout (L : BalancedCircuit.Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    let carries:=(Q6Structural.q6Carry L).take 255
    carries=carries.getD 0 0::carries.drop 1 ∧
    (carries.drop 1).length=254 ∧
    L.rtail.length=(L.ylow.drop 1).length ∧
    (carries.drop 1).length=(L.ylow.drop 1).length ∧
    ([L.ylow.getD 0 0,L.r0,L.sign,carries.getD 0 0,L.parity]++L.ylow.drop 1++[L.ymsb]++
      L.rtail++[L.rmsb,L.one]++carries.drop 1++[L.carry.getD 255 0]).Nodup ∧
    (∀ r ∈ (L.carry.take 254).drop 1, r ∈ carries.drop 1) := by
  let carries:=(Q6Structural.q6Carry L).take 255
  let a:=L.ylow.getD 0 0
  let b:=L.r0
  let c:=carries.getD 0 0
  let x:=L.ylow.drop 1
  let y:=L.rtail
  let cs:=carries.drop 1
  let unused:=L.carry.getD 255 0
  let C:=carries++[unused]
  have cshape:carries=L.carry.take 254++[L.lower]:=by
    simp [carries,Q6Structural.q6Carry,List.take_append,List.take_take,List.length_take,hw.2.2]
  have clen:carries.length=255:=by rw [cshape];simp [List.length_take,hw.2.2]
  have yne:L.ylow≠[]:=by intro e;have h:=hw.2.1;rw [e] at h;cases h
  have cne:carries≠[]:=by intro e;rw [e] at clen;cases clen
  have ysplit:L.ylow=a::x:=inv_head_split L.ylow yne
  have csplit:carries=c::cs:=inv_head_split carries cne
  have unusedIn:unused∈L.carry:=by
    have h:255<L.carry.length:=by rw [hw.2.2];omega
    dsimp only [unused]
    rw [List.getD_eq_getElem _ _ h]
    exact List.getElem_mem _
  have rawND:(L.ylow++[L.ymsb]++L.low++[L.rmsb,L.one]++carries++
      [unused,L.sign,L.parity]).Nodup:=by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    rw [CarryBorrow.carry_split L hw] at h
    have take:List.count q (L.carry.take 254)≤List.count q (L.carry.take 255):=by
      simpa only [List.take_take,show min 254 255=254 from rfl] using
        (List.take_sublist 254 (L.carry.take 255)).count_le q
    rw [cshape]
    dsimp only [unused]
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have headND:([a,b,L.sign,c,L.parity]++x++[L.ymsb]++y++[L.rmsb,L.one]++cs++[unused]).Nodup:=by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp rawND q
    rw [ysplit,csplit] at h
    dsimp only [b,y]
    simp only [BalancedCleanup.Layout.low,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have memberTail:∀ r ∈ (L.carry.take 254).drop 1, r ∈ cs := by
    intro r member
    change r∈carries.drop 1
    rw [cshape,List.drop_append]
    have len:(L.carry.take 254).length=254:=by simp [List.length_take,hw.2.2]
    simp only [len,show 1-254=0 from rfl,List.drop_zero,List.mem_append,List.mem_singleton]
    exact Or.inl member
  have csLen:cs.length=254:=by simp [cs,clen]
  have hyx:y.length=x.length:=by simp [x,y,hw.1,hw.2.1]
  have hcx:cs.length=x.length:=by simp [x,cs,clen,hw.2.1]
  exact ⟨csplit,csLen,hyx,hcx,headND,memberTail⟩

end HeadLayout

set_option maxHeartbeats 2000000 in
/-- Concrete loaned raw-subtraction head of the 760 inverse half
(statement unchanged; consumed by the LT11 helper as `HeadReplayB`). -/
theorem rawSubHeadLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (fresh : List Bool)
    (low : s.basis L760.r0 = !s.basis L760.parity)
    (clean : ∀ q ∈
      (Q6Structural.q6Carry L760).take 255 ++
        [L760.carry.getD 255 0], s.basis q = false)
    (post : (run rawSubUpperOld [] (rawSubUpperInput s)).basis L760.one =
      (run rawSubUpperOld [] (rawSubUpperInput s)).basis L760.rmsb) :
    ∃ old, run (rawSubHeadLoan d) fresh s = run rawSubHeadOld old s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  have F := inv_head_layout L760 hw hn
  have csplit : (Q6Structural.q6Carry L760).take 255 =
      ((Q6Structural.q6Carry L760).take 255).getD 0 0 ::
        ((Q6Structural.q6Carry L760).take 255).drop 1 := F.1
  have depth : d + 1 ≤ (((Q6Structural.q6Carry L760).take 255).drop 1).length := by
    rw [F.2.1]
    omega
  have clean' : ∀ q ∈ ((Q6Structural.q6Carry L760).take 255).getD 0 0 ::
      (((Q6Structural.q6Carry L760).take 255).drop 1 ++ [L760.carry.getD 255 0]),
      s.basis q = false := by
    intro q hq
    apply clean q
    rw [csplit]
    exact hq
  rw [rawSubUpperOld_eq, rawSubUpperInput_eq] at post
  exact rawHeadLoan_generic d StairLoan.retiredRoles (L760.ylow.drop 1) L760.rtail
    (((Q6Structural.q6Carry L760).take 255).drop 1) (L760.ylow.getD 0 0) L760.r0
    L760.sign (((Q6Structural.q6Carry L760).take 255).getD 0 0) L760.parity
    L760.ymsb L760.rmsb L760.one (L760.carry.getD 255 0) (base 760)
    F.2.2.1 F.2.2.2.1 depth F.2.2.2.2.1 (F.2.2.2.2.2 _ R2Life760.member760)
    (StairLoan.retiredRoles_q6Tail d hd) s fresh low clean' post

end ECDSAAdd.Entrant.StairLoanInverse
