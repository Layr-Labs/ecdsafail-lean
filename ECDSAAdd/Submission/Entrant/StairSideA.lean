  all_goals decide +kernel

/-- The moved first tick sees the unpacked difference rail as its `b` word,
with the sign-extension target `bSite B` on top. -/
theorem physicalLayout_bWord : ∀ B ∈ budgets,
    (W.compactSkywalkTickLayout (segmentMap B) (startFor B)).b =
      StairCodec.reg (physicalLayout B).D B ++ [bSite B] := by
  intro B hB
