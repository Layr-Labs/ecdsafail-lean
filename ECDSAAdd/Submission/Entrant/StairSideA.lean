/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBoundaryLoanConvert_at_StairSideA` -/
section Merge_StairBoundaryLoanConvert_at_StairSideA

/-!
# Boundary carry loans: the two field converters (generic layer)

`canon760` and `center760` are renamed copies of `HalfConvert.canonical` /
`HalfConvert.center`, each one mapped subtraction/addition over a 254-carry
ladder.  The 44 retired roles sit on high carries of that ladder.  This
module replaces the ladder by the existing carry loan
`StairLoan.mappedAddLoan` / `StairLoan.mappedSubLoan` for an arbitrary
`BalancedConvert.Layout` and role list (symbolic wires), and proves:

* `centerLoan_zero` / `canonicalLoan_zero` — depth 0 is the record program;
* `centerLoan_counts` / `canonicalLoan_counts` — exactly `+d` Toffoli and
  `+d` measurements;
* `centerLoan_run_eq` / `canonicalLoan_run_eq` — independent-tape run equality
  with the record converter whenever the ladder is clean on entry;
* `centerLoan_support` / `canonicalLoan_support` — the loaned program uses no
  loaned role (only the `d` lowest carries are added, as hosts);
* `centerLoan_physical` / `canonicalLoan_physical`.

All layout premises are static list facts, discharged once by `decide` at the
concrete 760 layouts.
-/

set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairBoundaryLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-! ## Definitions -/





/-! ## Counts -/



theorem centerLoan_counts (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (hw : L.Widths) (hd : d ≤ 254) :
    toffoliCount (centerLoan d roles L) = toffoliCount (HalfConvert.center L) + d ∧
      measurementCount (centerLoan d roles L) =
        measurementCount (HalfConvert.center L) + d := by
  have len := ladder_lengths L hw
  have loan := StairLoan.mappedAddLoan_counts d roles (HalfConvert.lowCorrection L)
    L.low (L.carry.take 254) L.cin len.1 len.2.1 (by omega)
  simp only [centerLoan, HalfConvert.center, toffoliCount_append,
    measurementCount_append, loan.1, loan.2]
  omega

theorem canonicalLoan_counts (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (hw : L.Widths) (hd : d ≤ 254) :
    toffoliCount (canonicalLoan d roles L) =
        toffoliCount (HalfConvert.canonical L) + d ∧
      measurementCount (canonicalLoan d roles L) =
        measurementCount (HalfConvert.canonical L) + d := by
  have len := ladder_lengths L hw
  have loan := StairLoan.mappedSubLoan_counts d roles (HalfConvert.lowCorrection L)
    L.low (L.carry.take 254) L.cin len.1 len.2.1 (by omega)
  simp only [canonicalLoan, HalfConvert.canonical, toffoliCount_append,
    measurementCount_append, loan.1, loan.2]
  omega

/-! ## Run equality -/



theorem canonicalLoan_run_eq (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (F : LadderFacts L) (hd : d + 1 ≤ 254)
    (roleTail : ∀ q ∈ roles.take d, q ∈ (L.carry.take 254).drop (d + 1))
    (s : State) (clean : ∀ q ∈ L.carry.take 254, s.basis q = false)
    (m n : List Bool) :
    run (canonicalLoan d roles L) m s = run (HalfConvert.canonical L) n s := by
  have len := ladder_lengths L F.widths
  let A : Program := [.CX L.msb L.flag, .CX L.flag L.msb]
  let P := StairLoan.mappedSubLoan d roles (HalfConvert.lowCorrection L) L.low
    (L.carry.take 254) L.cin
  let Q := mappedSub (HalfConvert.lowCorrection L) L.low (L.carry.take 254) L.cin
  let R : Program := rotateLeft L.word ++
    [.CX L.flag (HalfConvert.lowBit L), .CX (HalfConvert.lowBit L) L.flag]
  have aZero : measurementCount A = 0 := rfl
  have rZero : measurementCount R = 0 := by
    simp only [R, measurementCount_append, (rotate_counts L.word).2.2.2]
    rfl
  have cleanA : ∀ q ∈ L.carry.take 254, (run A [] s).basis q = false := by
    intro q hq
    have away := F.carryAway q hq
    have keep : (run A [] s).basis q = s.basis q := by
      simp [A, run, writeBit, Function.update, away.2.1, away.2.2.2]
    rw [keep]
    exact clean q hq
  have middle : ∀ x y, run P x (run A [] s) = run Q y (run A [] s) := fun x y =>
    StairLoan.mappedSubLoan_run_eq d roles (HalfConvert.lowCorrection L) L.low
      (L.carry.take 254) L.cin (run A [] s) x y F.nodup F.bitsAway len.1 len.2.1
      (by omega) cleanA roleTail
  have tail : ∀ x y, run R x (run P [] (run A [] s)) = run R y (run P [] (run A [] s)) :=
    fun x y => FifthCarry.no_records R rZero _ x y
  have loanShape : canonicalLoan d roles L = A ++ P ++ R := by
    simp only [canonicalLoan, A, P, R, List.append_assoc]
  have oldShape : HalfConvert.canonical L = A ++ Q ++ R := by
    simp only [HalfConvert.canonical, A, Q, R, List.append_assoc]
  rw [loanShape, oldShape]
  exact StairLoan.run_sandwich_independent A P Q R s m n aZero middle tail

/-! ## Support and physicality -/



/-- A loaned role is never used, provided it is not one of the hosts. -/
theorem roles_free_of_support (P Old : Program) (roles hosts : List Wire) (d : Nat)
    (support : wires P ⊆ (wires Old \ (roles.take d).toFinset) ∪ hosts.toFinset)
    (r : Wire) (hr : r ∈ roles.take d) (notHost : r ∉ hosts) : r ∉ wires P := by
  intro used
  have h := support used
  simp only [Finset.mem_union, Finset.mem_sdiff, List.mem_toFinset] at h
  rcases h with ⟨_, notRole⟩ | host
  · exact notRole hr
  · exact notHost host

theorem centerLoan_physical (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (h : GatePhysical (HalfConvert.center L)) : GatePhysical (centerLoan d roles L) := by
  simp only [HalfConvert.center, gatePhysical_append] at h
  simp only [centerLoan, gatePhysical_append]
  have add := StairLoanSupport.mappedAddLoan_physical_of_zero d roles
    (HalfConvert.lowCorrection L) L.low (L.carry.take 254) L.cin
    (by rw [StairLoan.mappedAddLoan_zero]; exact h.1.2)
  exact ⟨⟨h.1.1, add⟩, h.2⟩

theorem canonicalLoan_physical (d : Nat) (roles : List Wire) (L : BalancedConvert.Layout)
    (h : GatePhysical (HalfConvert.canonical L)) :
    GatePhysical (canonicalLoan d roles L) := by
  simp only [HalfConvert.canonical, gatePhysical_append] at h
  simp only [canonicalLoan, gatePhysical_append]
  have sub := StairLoanSupport.mappedSubLoan_physical_of_zero d roles
    (HalfConvert.lowCorrection L) L.low (L.carry.take 254) L.cin
    (by rw [StairLoan.mappedSubLoan_zero]; exact h.1.1.2)
  exact ⟨⟨⟨h.1.1.1, sub⟩, h.1.2⟩, h.2⟩

end ECDSAAdd.Entrant.StairBoundaryLoan
end Merge_StairBoundaryLoanConvert_at_StairSideA

