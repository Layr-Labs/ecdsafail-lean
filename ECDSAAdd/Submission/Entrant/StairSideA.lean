theorem phaseBReturn_counts :
    toffoliCount phaseBReturn = 0 ∧ measurementCount phaseBReturn = 0 := by
  decide +kernel

theorem kbHSw_id {a b q : Nat} (h1 : q ≠ a) (h2 : q ≠ b) : StairPlaceFast.swB a b q = q := by
  simp only [StairPlaceFast.swB, cond_eq_ite, Nat.beq_eq, if_neg h1, if_neg h2]

/-- K4-B: the phase host map is an involution (three disjoint exchanges). -/
theorem kbPH_invol (x : Nat) : StairPlaceFast.phaseHostB (StairPlaceFast.phaseHostB x) = x := by
  by_cases hs : x = 736 ∨ x = 737 ∨ x = 738 ∨ x = 1042 ∨ x = 1557 ∨ x = 1558
  · rcases hs with rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  · have hfix : StairPlaceFast.phaseHostB x = x := by
      unfold StairPlaceFast.phaseHostB
      rw [kbHSw_id (show x ≠ 1042 by omega) (show x ≠ 737 by omega),
        kbHSw_id (show x ≠ 1557 by omega) (show x ≠ 738 by omega),
        kbHSw_id (show x ≠ 1558 by omega) (show x ≠ 736 by omega)]
    rw [hfix, hfix]








theorem pack_inside : ∀ B ∈ budgets, ∀ r ∈ wires (StairPhysicalPrimitives.pack B), r ∈ rowSites B := by
  intro B hB r hr
  simp only [StairPhysicalPrimitives.pack, wires_append, Finset.mem_union] at hr
  rcases hr with (sign | codec) | moved
  · exact signExt_rowSites B hB r sign
  · exact declared_rowSites B r (List.mem_toFinset.mp
      (StairCodec.pack_support _ B (budget_three B hB) codec))
  · exact (relocate_rowSites B hB).1 r moved

theorem unpack_inside : ∀ B ∈ budgets, ∀ r ∈ wires (StairPhysicalPrimitives.unpack B), r ∈ rowSites B := by
  intro B hB r hr
  simp only [StairPhysicalPrimitives.unpack, wires_append, Finset.mem_union] at hr
  rcases hr with (moved | codec) | sign
  · exact (relocate_rowSites B hB).2 r moved
  · exact declared_rowSites B r (List.mem_toFinset.mp
      (StairCodec.unpack_support _ B (budget_three B hB) codec))
  · exact signExt_rowSites B hB r sign

attribute [local irreducible] StairPhysicalPrimitives.pack in
theorem pack87_inside : ∀ r ∈ wires phasePack, r ∈ letterSite 424 :: rowSites 87 := by
  intro r hr
  have h : r ∈ wires (StairPhysicalPrimitives.pack 87) := hr
  exact List.mem_cons_of_mem _ (pack_inside 87 budget87_mem r h)

attribute [local irreducible] StairPhysicalPrimitives.unpack in
theorem unpack87_inside : ∀ r ∈ wires phaseUnpack, r ∈ letterSite 424 :: rowSites 87 := by
  intro r hr
  have h : r ∈ wires (StairPhysicalPrimitives.unpack 87) := hr
  exact List.mem_cons_of_mem _ (unpack_inside 87 budget87_mem r h)


/-- K4-B: `callerB` with kernel-primitive tests. -/
def kbHCallerF (v : Nat) : Bool :=
  (Nat.ble 16 v && Nat.blt v 2330) || Nat.beq v 2416 || Nat.beq v 2425 || Nat.beq v 2426 ||
    Nat.beq v 2427

theorem kbHCallerF_callerB (v : Nat) (h : kbHCallerF v = true) : callerB v = true := by
  unfold kbHCallerF at h
  unfold callerB
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, Nat.ble_eq, Nat.blt_eq,
    decide_eq_true_eq, beq_iff_eq] at h ⊢
  exact h

/-- LT41 (replay budget): the two caller-domain checks as Boolean passes with the interval test
`callerB` (94.5 s of kernel time before).  K4-B: the row part is `rowSitesL_callerB` (the phase
host undoes the phase relabelling), the b-rail part runs on the closed forms. -/
theorem phaseKernel_callerB :
    ((letterSite 424 :: rowSites 87).all
        (fun q => callerB (Rolling1588Lifetime.phaseHost (phaseRelabel q)))) = true ∧
    ((List.range 88).all (fun k => callerB (Rolling1588Lifetime.phaseHost (base (770 + k))) &&
        callerB (Rolling1588Lifetime.phaseHost (bSite k)))) = true := by
  constructor
  · rw [List.all_eq_true]
    intro q hq
    have e : Rolling1588Lifetime.phaseHost (phaseRelabel q) = fieldPlace q := by
      unfold phaseRelabel
      rw [StairPlaceFast.phaseHost_eqB, StairPlaceFast.phaseHost_eqB, kbPH_invol]
    rw [e]
    exact List.all_eq_true.mp (StairPhysicalPrimitives.rowSitesL_callerB 87 (by decide)) q hq
  · have hB : (List.range 88).all (fun k =>
        kbHCallerF (StairPlaceFast.phaseHostB (base (770 + k))) &&
          kbHCallerF (StairPlaceFast.phaseHostB (bSite k))) = true := by
      decide +kernel
    rw [List.all_eq_true]
    intro k hk
    have h := List.all_eq_true.mp hB k hk
    rw [Bool.and_eq_true] at h
    rw [StairPlaceFast.phaseHost_eqB, StairPlaceFast.phaseHost_eqB,
      kbHCallerF_callerB _ h.1, kbHCallerF_callerB _ h.2]
    rfl

/-- Field 8 / LT11 contract in the phase context: the kernel label
(`phaseHost` of the phase label) of every relabelled first-row site, and of both
b-rail move endpoints, is in the caller domain. -/
theorem phaseKernel_caller :
    (∀ q ∈ letterSite 424 :: rowSites 87,
      Rolling1588Lifetime.phaseHost (phaseRelabel q) ∈ callerList) ∧
    (∀ k, k < 88 → Rolling1588Lifetime.phaseHost (base (770 + k)) ∈ callerList ∧
      Rolling1588Lifetime.phaseHost (bSite k) ∈ callerList) := by
  refine ⟨fun q hq => mem_callerList_of _ (List.all_eq_true.mp phaseKernel_callerB.1 q hq),
    fun k hk => ?_⟩
  have h := List.all_eq_true.mp phaseKernel_callerB.2 k (List.mem_range.mpr hk)
  simp only [Bool.and_eq_true] at h
  exact ⟨mem_callerList_of _ h.1, mem_callerList_of _ h.2⟩

