  have enc := tb_enc_t8 (fun q=>pre g s uv.1 uv.2 (perm q)) (List.range 40) supp
  apply State.extensionality
  · rfl
  · change (fun q=>pre g s uv.1 uv.2 (perm q))=tbN_t8 (preDense g s uv)
