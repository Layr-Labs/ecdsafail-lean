/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Groups_at_StairSideA` -/
section Merge_StairField2V3Groups_at_StairSideA

/-!
# LT21: record packet groups avoid the future payload of every v3 row

The difference set of the field-2 chain at a v3 row of budget `B` is the
future packet payload `StairPhysicalLayout.futurePayload B` (letters
`startFor B .. 510`, payload `s` letters of packets `≥ startFor B / 5`, and
`g 510`), which holds the compact checkpoint in the staircase and the
encoded future packets in the record.  This module proves that every record
packet group of a packet `< startFor B / 5` avoids it
(`groups_avoid_payload`), from the record's own support chain
`Rolling1588.packet ⊆ ControlLoan1589.packet ⊆ FrontierSW1591.packetS =
OneFlagSW.packetS ⊆ OneFlagReplay.packet ⊆ Q6EndpointReplay.packet` and the
placement `Placement5.pi j` (body work goes to holes or the two spares,
never to payload sites).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Groups

open ECDSAAdd Arithmetic Challenge
open MappedCompressed
open StairPhysicalLayout



/-! ## Placement of a packet's own sites -/

def cellIds : List Nat := 2409 :: 2400 :: 2410 :: 717 :: 718 :: Q6EndpointCell.ids

theorem cells_not_hole : ∀ i ∈ Q6EndpointCell.ids, ¬ Placement5.holeRegion i := by
  decide +kernel

theorem fixed_not_hole : ¬ Placement5.holeRegion 2409 ∧ ¬ Placement5.holeRegion 2400 ∧
    ¬ Placement5.holeRegion 2410 := by
  decide +kernel

theorem pi_cases (k i : Nat) (hk : k < 102) (hi : ¬ Placement5.holeRegion i) :
    Placement5.pi k i = i ∨ Placement5.holeRegion (Placement5.pi k i) ∨
      Placement5.pi k i = 717 ∨ Placement5.pi k i = 718 := by
  by_cases work : Placement5.workRegion i
  · have hk' : i - 515 < 204 := by unfold Placement5.workRegion at work; omega
    have eq : i = Placement5.W (i - 515) := by
      unfold Placement5.W
      unfold Placement5.workRegion at work
      omega
    rw [eq]
    by_cases e : i - 515 = 2 * k
    · rw [e, Placement5.pi_selected_even k hk]
      right; right; left; rfl
    · by_cases o : i - 515 = 2 * k + 1
      · rw [o, Placement5.pi_selected_odd k hk]
        right; right; right; rfl
      · rw [Placement5.pi_other k _ hk hk' e o]
        right; left
        exact Placement5.H_region _ hk'
  · left
    exact Placement5.pi_outside k i hk (fun h => h.elim work hi)

/-! ## Decidable facts per row -/

/-- LT49 (replay budget): membership in `futurePayload B` as a `testBit` of its bit mask. -/
theorem mem_fp_mask (B q : Nat) :
    q ∈ futurePayload B ↔ (StairLoan.maskOf (futurePayload B)).testBit q = true := by
  rw [StairLoan.testBit_maskOf, decide_eq_true_iff]

theorem cells_avoid : ∀ B ∈ budgets, ∀ m ∈ cellIds,
    OB5.sig 511 (base m) ∉ futurePayload B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp only [mem_fp_mask]; decide +kernel

theorem holes_avoid : ∀ B ∈ budgets, ∀ h, h < 204 →
    OB5.sig 511 (base (Placement5.H h)) ∉ futurePayload B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp only [mem_fp_mask]; decide +kernel

theorem history_avoid : ∀ B ∈ budgets, ∀ k, k < startFor B / 5 → ∀ r : Fin 10,
    OB5.sig 511 (base (Placement5.pi k (History5.historyId (5 * k) r))) ∉ futurePayload B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp only [mem_fp_mask]; decide +kernel

theorem start_bound : ∀ B ∈ budgets, startFor B / 5 ≤ 100 := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

/-! ## One placed packet -/

theorem placed_cell_avoid (B : Nat) (hB : B ∈ budgets) (k : Nat) (hk : k < 102) (i : Nat)
    (hi : ¬ Placement5.holeRegion i) (hc : i ∈ cellIds) :
    OB5.sig 511 (base (Placement5.pi k i)) ∉ futurePayload B := by
  rcases pi_cases k i hk hi with h | h | h | h
  · rw [h]; exact cells_avoid B hB i hc
  · have hrec := Placement5.hole_recover _ h
    rw [← hrec.2]
    exact holes_avoid B hB _ hrec.1
  · rw [h]; exact cells_avoid B hB 717 (by simp [cellIds])
  · rw [h]; exact cells_avoid B hB 718 (by simp [cellIds])

set_option linter.constructorNameAsVariable false in
theorem packet_avoid_payload (divide : Bool) (B : Nat) (hB : B ∈ budgets) (k : Nat)
    (hk : k < startFor B / 5) :
    ∀ r ∈ futurePayload B, r ∉ wires (renameProgram (OB5.sig 511) (Rolling1588.packet divide k)) := by
  intro r hr hw
  have k102 : k < 102 := by have := start_bound B hB; omega
  rw [renameProgram_support] at hw
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hw
  have h1 := Rolling1588.packet_old_support divide k k102 hq
  have h2 := ControlLoan1589.packet_support divide k k102 h1
  rw [FrontierSW1591.packet_support_eq] at h2
  have h3 := (OneFlagSW.selPacket_sel divide k k102).sub.wires_sub h2
  have h4 := OneFlagReplay.packet_subset_old divide k h3
  unfold Q6EndpointReplay.packet at h4
  rw [renameProgram_support] at h4
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp h4
  have hist : ∀ i : Fin 10, x = History5.historyMap base (5 * k) i → False := by
    intro i hxi
    subst hxi
    apply history_avoid B hB k hk i
    simpa only [History5.historyMap, shifted_base] using hr
  have cell : ∀ i, x = base i → ¬ Placement5.holeRegion i → i ∈ cellIds → False := by
    intro i hxi hi hc
    subst hxi
    apply placed_cell_avoid B hB k k102 i hi hc
    simpa only [shifted_base] using hr
  simp only [Q6EndpointReplay.basePacket, wires_append, Finset.mem_union] at hx
  rcases hx with (hdec | hbody) | henc
  · obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * k) _ (Or.inr rfl) x hdec
    exact hist i hi
  · have hs := Q6EndpointReplay.body_support divide k k102 hbody
    simp only [Q6EndpointReplay.readSites, Q6EndpointReplay.fieldSites, Finset.mem_union,
      List.mem_toFinset, List.mem_cons, List.mem_map, Finset.mem_insert,
      Finset.mem_singleton] at hs
    rcases hs with ((h2409 | ⟨i, hi, hxi⟩) | (h2400 | h2410)) | henc
    · exact cell 2409 h2409 fixed_not_hole.1 (by simp [cellIds])
    · exact cell i hxi.symm (cells_not_hole i hi) (by simp [cellIds, hi])
    · exact cell 2400 h2400 fixed_not_hole.2.1 (by simp [cellIds])
    · exact cell 2410 h2410 fixed_not_hole.2.2 (by simp [cellIds])
    · obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * k) _ (Or.inl rfl) x henc
      exact hist i hi
  · obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * k) _ (Or.inl rfl) x henc
    exact hist i hi

/-! ## Packet groups -/

theorem rename_append' (f : Wire → Wire) (a b : Program) :
    renameProgram f (a ++ b) = renameProgram f a ++ renameProgram f b := by
  simp only [renameProgram, List.map_append]

set_option linter.constructorNameAsVariable false in
theorem groups_avoid_payload (divide : Bool) (B : Nat) (hB : B ∈ budgets) :
    ∀ n j, j + n ≤ startFor B / 5 →
      ∀ r ∈ futurePayload B,
        r ∉ wires (renameProgram (OB5.sig 511) (Rolling1588.groups divide j n)) := by
  intro n
  induction n with
  | zero =>
      intro j _ r _ hw
      simp [Rolling1588.groups, PacketSequence.program, renameProgram, wires] at hw
  | succ n ih =>
      intro j hj r hr hw
      have head := packet_avoid_payload divide B hB j (by omega) r hr
      have rest := ih (j + 1) (by omega) r hr
      unfold Rolling1588.groups at hw rest
      cases divide
      · simp only [PacketSequence.program, Bool.false_eq_true, if_false, rename_append',
          wires_append, Finset.mem_union] at hw
        rcases hw with h | h
        · exact rest h
        · exact head h
      · simp only [PacketSequence.program, if_true, rename_append',
          wires_append, Finset.mem_union] at hw
        rcases hw with h | h
        · exact head h
        · exact rest h

end ECDSAAdd.Entrant.StairField2V3Groups

