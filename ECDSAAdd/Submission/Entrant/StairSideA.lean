def pCorrectionLoan68 (L : BalancedCircuit.Layout) : Program :=
  signComplement L.ymsb L.r ++
    mappedSubLoan 68 retiredRoles (mappedConstant (some L.parity) 256 p)
      L.r (L.carry.take 255) L.one ++
    signComplement L.ymsb L.r








































/-! ## Structural replay identities

These identities expose the low prefix of a mapped carry sweep without
evaluating a concrete 255-bit program.  They are the bridge from the local
`PrefixReady` lemmas above to the four complete half sweeps. -/



















theorem mappedLiteral_run_eq (xs cs : List Wire) (cin one : Wire) (k : Nat)
    (s : State) (m n : List Bool)
    (hn : (one::cin::(xs++cs)).Nodup) (hc : cs.length+1=xs.length)
    (hk : k<2^xs.length) (oneZero : s.basis one=false)
    (clean : ∀q∈cs,s.basis q=false) :
    run (mappedAdd (mappedConstant none xs.length k) xs cs cin) m s=
      run (literalConstAdd xs cs cin one k) n s := by
  have nd : (cin::(xs++cs)).Nodup := (List.nodup_cons.mp hn).2
  have bits : (mappedConstant none xs.length k).length=xs.length :=
    mappedConstant_length none xs.length k
  have away : ∀q∈mappedWires (mappedConstant none xs.length k),
      q∉cin::(xs++cs) := by
    intro q hq
    have impossible := mappedConstant_wires none xs.length k q hq
    simp at impossible
  have left := mappedAdd_correct (mappedConstant none xs.length k) xs cs cin
    nd away bits hc s m clean
  have right := literalConstAdd_correct xs cs cin one k hn hc s n oneZero clean
  apply State.extensionality
  · exact left.1.trans right.1.symm
  · funext q
    by_cases hq : q∈xs
    · apply (regValue_eq_iff xs _ _).mp (by
        rw [left.2.2,right.2.2,mappedConstant_value none xs.length k s.basis hk]
        simp [mappedEnabled,Nat.add_comm,Nat.add_left_comm]) q hq
    · exact (left.2.1 q hq).trans (right.2.1 q hq).symm

theorem literalConstAdd_records (xs cs : List Wire) (cin one : Wire) (k : Nat)
    (s : State) (m n : List Bool)
    (hn : (one::cin::(xs++cs)).Nodup) (hc : cs.length+1=xs.length)
    (oneZero : s.basis one=false) (clean : ∀q∈cs,s.basis q=false) :
    run (literalConstAdd xs cs cin one k) m s=
      run (literalConstAdd xs cs cin one k) n s := by
  have left := literalConstAdd_correct xs cs cin one k hn hc s m oneZero clean
  have right := literalConstAdd_correct xs cs cin one k hn hc s n oneZero clean
  apply State.extensionality
  · exact left.1.trans right.1.symm
  · funext q
    by_cases hq : q∈xs
    · exact (regValue_eq_iff xs _ _).mp (left.2.2.trans right.2.2.symm) q hq
    · exact (left.2.1 q hq).trans (right.2.1 q hq).symm

theorem literalConstAddLoan_run_eq (d : Nat) (roles xs cs : List Wire)
    (cin one : Wire) (k : Nat) (s : State) (m n : List Bool)
    (hn : (one::cin::(xs++cs)).Nodup) (hc : cs.length+1=xs.length)
    (hk : k<2^xs.length) (hd : d+1≤cs.length)
    (oneZero : s.basis one=false) (clean : ∀q∈cs,s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1)) :
    run (literalConstAddLoan d roles xs cs cin one k) m s=
      run (literalConstAdd xs cs cin one k) n s := by
  cases d with
  | zero =>
      simp only [literalConstAddLoan,if_pos rfl]
      exact literalConstAdd_records xs cs cin one k s m n hn hc oneZero clean
  | succ d =>
      have nd : (cin::(xs++cs)).Nodup := (List.nodup_cons.mp hn).2
      have bits : (mappedConstant none xs.length k).length=xs.length :=
        mappedConstant_length none xs.length k
      have away : ∀q∈mappedWires (mappedConstant none xs.length k),
          q∉cin::(xs++cs) := by
        intro q hq
        have impossible := mappedConstant_wires none xs.length k q hq
        simp at impossible
      simp only [literalConstAddLoan,Nat.succ_ne_zero,if_false]
      exact (mappedAddLoan_run_eq (d+1) roles
        (mappedConstant none xs.length k) xs cs cin s m n nd away bits hc hd clean
        roleTail).trans (mappedLiteral_run_eq xs cs cin one k s n n hn hc hk
          oneZero clean)

/-! Concrete high-carry geometry shared by all seven half components. -/

/-- LT44 (replay budget): the depth-68 case (one kernel evaluation, 68 memberships) implies
every depth; the old proof evaluated all 69 depths (37 s + 39 s of kernel time). -/
private theorem retiredRoles_tail254_all :
    ∀q∈retiredRoles,
      q∈((Q6EndpointCell.ports base (base 2409)).carry.take 254).drop 69 := by
  decide +kernel

theorem retiredRoles_tail254 (d : Nat) (hd : d≤68) :
    ∀q∈retiredRoles.take d,
      q∈((Q6EndpointCell.ports base (base 2409)).carry.take 254).drop (d+1) := by
  intro q hq
  have h := retiredRoles_tail254_all q (List.mem_of_mem_take hq)
  have e : (69 : Nat) = (d+1)+(68-d) := by omega
  rw [e, ← List.drop_drop] at h
  exact List.mem_of_mem_drop h












/-! Semantic lifts for the three nonuniform recursive tops.  These are kept
    below the structural identities so their proofs can use exactly the same
    split as `emitLoan_mapped_prefix_run_eq`. -/

theorem addPrefixLoan_run_eq (d : Nat) (roles xs ys cs : List Wire)
    (a t z last cin : Wire) (s : State) (m n : List Bool)
    (hy : ys.length=xs.length) (hc : cs.length=xs.length)
    (hd : d+1≤cs.length)
    (hn : (xs++[a]++ys++[t,z]++cs++[last,cin]).Nodup)
    (top : s.basis z=s.basis t)
    (clean : ∀q∈cs++[last],s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1)) :
    run (addPrefixLoan d roles xs ys cs a t z cin) m s=
      run (CoherentTail.addPrefix xs ys cs a t z cin) n s := by
  let bits := mappedRead xs false
  let layers := prefixLayers xs ys cs a t z cin
  let topProgram := prefixTop xs ys cs a t z cin
  let P := emitUps (layers.take (d+1))
  let U := emitSweep (layers.drop (d+1)) topProgram
  let u := run P [] s
  let v := run U [] u
  let out := run (emitSweep layers topProgram) [] s
  have bitsLength : bits.length=ys.length := by
    simp only [bits,mappedRead_length,hy]
  have mappedND : (cin::(ys++cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have sourceAway : ∀q∈mappedWires bits,q∉cin::(ys++cs) := by
    intro q hq bad
    simp only [bits,mappedRead_wires] at hq
    have h := List.nodup_iff_count.mp hn q
    have hx := List.count_pos_iff.mpr hq
    simp only [List.mem_cons,List.mem_append] at bad
    rcases bad with rfl|bad|bad
    · simp only [List.count_append,List.count_cons,List.count_nil,
        beq_self_eq_true,if_true] at h hx
      omega
    · have hyq := List.count_pos_iff.mpr bad
      simp only [List.count_append,List.count_cons,List.count_nil] at h hx hyq
      omega
    · have hcq := List.count_pos_iff.mpr bad
      simp only [List.count_append,List.count_cons,List.count_nil] at h hx hcq
      omega
  have prefixShapes := prefix_prefix_shapes (d+1) xs ys cs a t z cin hy hc hd
  have borrowShapes := prefix_prefix_shapes d xs ys cs a t z cin hy hc (by omega)
  have prefixShape : P=carryPrefix (d+1) bits ys cs cin := by
    exact prefixShapes.1
  have eraseShape : emitErases (layers.take d)=erasePrefix d bits ys cs cin := by
    exact borrowShapes.2.1
  have borrowShape : emitUps (layers.take d)=carryPrefix d bits ys cs cin := by
    exact borrowShapes.1
  have hostShape : layerHosts (layers.take d)=cs.take d := borrowShapes.2.2
  have prefixZero : measurementCount P=0 := by
    rw [prefixShape]
    exact (carryPrefix_counts (d+1) bits ys cs cin (by omega) (by omega) hd).2
  have prefixRun : ∀rec,run P rec s=u := by
    intro rec
    exact FifthCarry.no_records P prefixZero s rec []
  have prefixFrame := carryPrefix_frame (d+1) bits ys cs cin s [] mappedND
    sourceAway (by omega) (by omega) hd (fun q hq=>clean q (by
      simp only [List.mem_append]
      exact Or.inl (List.mem_of_mem_take hq)))
  rw [←prefixShape] at prefixFrame
  change u.phase=s.phase ∧ PrefixReady (d+1) bits ys cs cin u.basis ∧
    ∀q,q∉cs.take (d+1) → u.basis q=s.basis q at prefixFrame
  have upperShape : U=CoherentTail.addPrefix (xs.drop (d+1)) (ys.drop (d+1))
      (cs.drop (d+1)) a t z (carryAfter (d+1) cs cin) := by
    exact prefix_upper_sweep (d+1) xs ys cs a t z cin hy hc hd
  have csND : cs.Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have ysND : ys.Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have tailND : ((xs.drop (d+1))++[a]++(ys.drop (d+1))++[t,z]++
      (cs.drop (d+1))++[last,carryAfter (d+1) cs cin]).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    have hx := (List.drop_sublist (d+1) xs).count_le q
    have hyq := (List.drop_sublist (d+1) ys).count_le q
    have hcq := (List.drop_sublist (d+1) cs).count_le q
    by_cases eq : q=carryAfter (d+1) cs cin
    · subst q
      have memberLow := carryAfter_succ_take_mem d cs cin hd
      have awayDrop : carryAfter (d+1) cs cin∉cs.drop (d+1) := by
        exact fun tail=>List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) memberLow tail
      have awayX : carryAfter (d+1) cs cin∉xs := by
        intro source
        have hp := List.count_pos_iff.mpr source
        have hcp := List.count_pos_iff.mpr (carryAfter_succ_mem d cs cin hd)
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcp
        omega
      have awayY : carryAfter (d+1) cs cin∉ys := by
        intro target
        have hp := List.count_pos_iff.mpr target
        have hcp := List.count_pos_iff.mpr (carryAfter_succ_mem d cs cin hd)
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcp
        omega
      have awayScalars : carryAfter (d+1) cs cin∉[a,t,z,last,cin] := by
        intro scalar
        have hp := List.count_pos_iff.mpr scalar
        have hcp := List.count_pos_iff.mpr (carryAfter_succ_mem d cs cin hd)
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcp
        omega
      have dropX : List.count (carryAfter (d+1) cs cin) (xs.drop (d+1))=0 :=
        List.count_eq_zero.mpr (fun mem=>awayX (List.mem_of_mem_drop mem))
      have dropY : List.count (carryAfter (d+1) cs cin) (ys.drop (d+1))=0 :=
        List.count_eq_zero.mpr (fun mem=>awayY (List.mem_of_mem_drop mem))
      have dropC : List.count (carryAfter (d+1) cs cin) (cs.drop (d+1))=0 :=
        List.count_eq_zero.mpr awayDrop
      simp only [List.count_append,List.count_cons,List.count_nil,dropX,dropY,dropC,
        beq_self_eq_true,if_true] at ⊢
      simp only [List.mem_cons,List.not_mem_nil,or_false,not_or] at awayScalars
      rcases awayScalars with ⟨ha,ht,hz,hl,hcin⟩
      have ha' : a≠carryAfter (d+1) cs cin := Ne.symm ha
      have ht' : t≠carryAfter (d+1) cs cin := Ne.symm ht
      have hz' : z≠carryAfter (d+1) cs cin := Ne.symm hz
      have hl' : last≠carryAfter (d+1) cs cin := Ne.symm hl
      have hcin' : cin≠carryAfter (d+1) cs cin := Ne.symm hcin
      simp [ha',ht',hz',hl',hcin']
    · have eq' : carryAfter (d+1) cs cin≠q := Ne.symm eq
      simp only [List.count_append,List.count_cons,List.count_nil] at h hx hyq hcq ⊢
      simp at h
      simp [eq'] at ⊢
      omega
  have scalarAway (q : Wire) (hq : q∈[a,t,z,last,cin]) : q∉cs := by
    intro hcs
    have h := List.nodup_iff_count.mp hn q
    have hp := List.count_pos_iff.mpr hq
    have hcp := List.count_pos_iff.mpr hcs
    simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcp
    omega
  have topU : u.basis z=u.basis t := by
    rw [prefixFrame.2.2 z (by
      intro hz
      exact scalarAway z (by simp) (List.mem_of_mem_take hz)),
      prefixFrame.2.2 t (by
        intro ht
        exact scalarAway t (by simp) (List.mem_of_mem_take ht)),top]
  have cleanU : ∀q∈cs.drop (d+1)++[last],u.basis q=false := by
    intro q hq
    simp only [List.mem_append,List.mem_singleton] at hq
    rcases hq with hq|eq
    · rw [prefixFrame.2.2 q (by
        intro low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) low hq)]
      exact clean q (by simp [List.mem_of_mem_drop hq])
    · have qeq : q=last := eq
      rw [qeq,prefixFrame.2.2 last (by
        intro low
        exact scalarAway last (by simp) (List.mem_of_mem_take low))]
      exact clean last (by simp)
  have upperFrame := Q6LifetimeProof.coherent_prefix_frame
    (xs.drop (d+1)) (ys.drop (d+1)) (cs.drop (d+1)) a t z last
    (carryAfter (d+1) cs cin) (by simp [hy]) (by simp [hc]) tailND u [] topU cleanU
  rw [←upperShape] at upperFrame
  change v.phase=u.phase ∧
    ∀q,q∉ys.drop (d+1)++[t,z] → v.basis q=u.basis q at upperFrame
  have coherentRecords (x y c : List Wire) (input : Wire) (r : State)
      (records records' : List Bool) (hxy : y.length=x.length)
      (hcx : c.length=x.length)
      (hnd : (x++[a]++y++[t,z]++c++[last,input]).Nodup)
      (htop : r.basis z=r.basis t)
      (hclean : ∀q∈c++[last],r.basis q=false) :
      run (CoherentTail.addPrefix x y c a t z input) records r=
        run (CoherentTail.addPrefix x y c a t z input) records' r := by
    have left := CoherentTail.same_records x y c a t z last input hxy hcx hnd
      r records htop hclean
    have right := CoherentTail.same_records x y c a t z last input hxy hcx hnd
      r records' htop hclean
    have ports : (input::((y++[t,z])++(c++[last]))).Nodup := by
      apply List.nodup_iff_count.mpr
      intro q
      have h := List.nodup_iff_count.mp hnd q
      simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
      omega
    have apart : List.Disjoint (x++[a,a])
        (input::((y++[t,z])++(c++[last]))) := by
      apply List.disjoint_left.mpr
      intro q hsource htarget
      have h := List.nodup_iff_count.mp hnd q
      have hs : q∈x++[a] := by
        simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_self] at hsource ⊢
        exact hsource
      have hsp := List.count_pos_iff.mpr hs
      have ht : q∈y++[t,z]++c++[last,input] := by
        simp only [List.mem_cons,List.mem_append,List.mem_singleton] at htarget ⊢
        tauto
      have htp := List.count_pos_iff.mpr ht
      simp only [List.count_append,List.count_cons,List.count_nil] at h hsp htp
      omega
    have independent := CoherentTail.readonly_record_independent
      (x++[a,a]) (y++[t,z]) (c++[last]) input ports apart
      (by simp [hxy]) (by simp [hxy,hcx]) r records records' hclean
    exact left.symm.trans (independent.trans right)
  have upperRun : ∀rec,run U rec u=v := by
    intro rec
    change run U rec u=run U [] u
    rw [upperShape]
    exact coherentRecords (xs.drop (d+1)) (ys.drop (d+1)) (cs.drop (d+1))
      (carryAfter (d+1) cs cin) u rec [] (by simp [hy]) (by simp [hc])
      tailND topU cleanU
  have lowAwayUpper : ∀q∈wires U,q∉cs.take d := by
    intro q hq low
    rw [upperShape] at hq
    have used := CoherentTail.addPrefix_support (xs.drop (d+1)) (ys.drop (d+1))
      (cs.drop (d+1)) a t z (carryAfter (d+1) cs cin) q hq
    simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at used
    have lowFull : q∈cs := List.mem_of_mem_take low
    have h := List.nodup_iff_count.mp hn q
    rcases used with ((source|target)|carry)|scalar
    · have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop source)
      have hcpos := List.count_pos_iff.mpr lowFull
      simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcpos
      omega
    · have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop target)
      have hcpos := List.count_pos_iff.mpr lowFull
      simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcpos
      omega
    · exact List.disjoint_left.mp
        (List.disjoint_take_drop csND (by omega)) low carry
    · rcases scalar with qa|qt|qz|qcarry
      · exact scalarAway q (by simp [qa]) lowFull
      · exact scalarAway q (by simp [qt]) lowFull
      · exact scalarAway q (by simp [qz]) lowFull
      · exact carryAfter_succ_away d cs cin csND hd (qcarry ▸ low)
  have upperSame : ∀q∈mappedWires (bits.take d)++ys.take d++cs.take d++[cin],
      v.basis q=u.basis q := by
    intro q hq
    apply upperFrame.2 q
    intro target
    simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hq target
    rcases hq with ((source|lowY)|lowC)|qcin
    · have sourceFull : q∈xs := by
        simp only [mappedWires,List.mem_flatMap] at source
        obtain ⟨bit,hbit,hq⟩ := source
        have sourceAll : q∈mappedWires bits := by
          apply List.mem_flatMap.mpr
          exact ⟨bit,List.mem_of_mem_take hbit,hq⟩
        simpa only [bits,mappedRead_wires] using sourceAll
      rcases target with tailY|qt|qz
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr sourceFull
        have htp := List.count_pos_iff.mpr (List.mem_of_mem_drop tailY)
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp htp
        omega
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr sourceFull
        have ht : q∈[t] := by simp [qt]
        have htp := List.count_pos_iff.mpr ht
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp htp
        omega
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr sourceFull
        have hz : q∈[z] := by simp [qz]
        have hzp := List.count_pos_iff.mpr hz
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp hzp
        omega
    · rcases target with tailY|qt|qz
      · exact List.disjoint_left.mp (List.disjoint_take_drop ysND (by omega))
          lowY tailY
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_take lowY)
        have ht : q∈[t] := by simp [qt]
        have htp := List.count_pos_iff.mpr ht
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp htp
        omega
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_take lowY)
        have hz : q∈[z] := by simp [qz]
        have hzp := List.count_pos_iff.mpr hz
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp hzp
        omega
    · rcases target with tailY|qt|qz
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_take lowC)
        have htp := List.count_pos_iff.mpr (List.mem_of_mem_drop tailY)
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp htp
        omega
      · exact scalarAway q (by simp [qt]) (List.mem_of_mem_take lowC)
      · exact scalarAway q (by simp [qz]) (List.mem_of_mem_take lowC)
    · rcases target with tailY|qt|qz
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop tailY)
        have hcin : q∈[cin] := by simp [qcin]
        have hcp := List.count_pos_iff.mpr hcin
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp hcp
        omega
      · have h := List.nodup_iff_count.mp hn q
        have hcin : q∈[cin] := by simp [qcin]
        have ht : q∈[t] := by simp [qt]
        have hcp := List.count_pos_iff.mpr hcin
        have htp := List.count_pos_iff.mpr ht
        simp only [List.count_append,List.count_cons,List.count_nil] at h hcp htp
        omega
      · have h := List.nodup_iff_count.mp hn q
        have hcin : q∈[cin] := by simp [qcin]
        have hz : q∈[z] := by simp [qz]
        have hcp := List.count_pos_iff.mpr hcin
        have hzp := List.count_pos_iff.mpr hz
        simp only [List.count_append,List.count_cons,List.count_nil] at h hcp hzp
        omega
  have upperRoleZero : ∀q∈roles.take d,v.basis q=false := by
    intro q hq
    have tail := roleTail q hq
    rw [upperFrame.2 q (by
      intro target
      simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at target
      rcases target with target|qt|qz
      · have h := List.nodup_iff_count.mp hn q
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop tail)
        have ht := List.count_pos_iff.mpr (List.mem_of_mem_drop target)
        simp only [List.count_append,List.count_cons,List.count_nil] at h hp ht
        omega
      · exact scalarAway q (by simp [qt]) (List.mem_of_mem_drop tail)
      · exact scalarAway q (by simp [qz]) (List.mem_of_mem_drop tail)),
      prefixFrame.2.2 q (by
        intro low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) low tail)]
    exact clean q (by simp [List.mem_of_mem_drop tail])
  have wholeRun : ∀rec,run (emitSweep layers topProgram) rec s=out := by
    intro rec
    change run (emitSweep layers topProgram) rec s=
      run (emitSweep layers topProgram) [] s
    rw [←addPrefix_as_sweep xs ys cs a t z cin]
    exact coherentRecords xs ys cs cin s rec [] hy hc hn top clean
  have cleanCs : ∀q∈cs,s.basis q=false := by
    intro q hq
    exact clean q (by simp [hq])
  have replay := emitLoan_mapped_prefix_run_eq d roles layers topProgram bits ys cs cin
    s u v out m n mappedND sourceAway prefixShape eraseShape borrowShape hostShape
    prefixZero prefixRun prefixFrame.2.1 prefixFrame.2.2 cleanCs roleTail upperRun
    lowAwayUpper upperSame upperRoleZero wholeRun
  rw [←addPrefix_as_sweep xs ys cs a t z cin] at replay
  exact replay



end ECDSAAdd.Entrant.StairLoan
