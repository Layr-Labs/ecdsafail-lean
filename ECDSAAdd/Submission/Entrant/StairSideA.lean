  unfold placeL
  rw [swF_id 4881 5645 z h1 h2, swF_id 4880 5646 z h3 h4, swF_id 4882 5647 z h5 h6, swF_id 4885 5651 z h7 h8,
    swF_id 5400 5652 z h9 h10, swF_id 5401 5653 z h11 h12, swF_id 4884 5654 z h13 h14,
