/-- Three programs in sequence, with abstract stage predicates (keeps the
concrete programs out of every unification). -/
theorem three_stage (A B C : Program) (s : State) (q : Wire) (P1 P2 : State → Prop)
    (h1 : ∀ m1, P1 (run A m1 s)) (h2 : ∀ t m2, P1 t → P2 (run B m2 t))
