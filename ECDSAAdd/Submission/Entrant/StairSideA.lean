theorem half760Loan_slots_le (d : Nat) (divide : Bool) (hd : d <= 68) :
    gateSlots (StairLoan.half760Loan d divide) <=
      gateSlots (R2Life760.half760 divide) + 56 * d := by
  let L := Q6EndpointCell.ports base (base 2409)
  have hw := Q6EndpointCell.ports_widths base (base 2409)
  cases divide
  · have no := normalizeLoan_slots_le d L hw hd
    have cm := compareBlockLoan_slots_le d false L hw hd
    have uf := unfoldLoan_slots_le d L hw hd
    have rs := rawSubTailLoan_slots_le d L hw hd
    dsimp only [L] at no cm uf rs
    simp only [StairLoan.half760Loan, R2Life760.half760,
      Q6LifetimeResearch.half, StairLoan.inverseLoan,
      Q6LifetimeResearch.inverse, Bool.false_eq_true, if_false,
      gateSlots_append, slots_reverse] at no cm uf rs ⊢
    omega
  · have ra := rawAddLoan_slots_le d L hw hd
    have fo := foldLoan_slots_le d L hw hd
    have cm := compareBlockLoan_slots_le d true L hw hd
    have un := unnormalizeLoan_slots_le d L hw hd
    dsimp only [L] at ra fo cm un
    simp only [StairLoan.half760Loan, R2Life760.half760,
      Q6LifetimeResearch.half, StairLoan.forwardLoan,
      Q6LifetimeResearch.forward, if_true, List.append_nil,
      gateSlots_append, slots_reverse] at ra fo cm un ⊢
    omega

