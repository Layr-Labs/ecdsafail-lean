  intro i hi
  rw [decide_eq_true_iff]
  intro hm
  exact absurd (k5_loan_far _ ((ECDSAAdd.Entrant.SW.mem_wires_iff _ _).mpr ⟨i, hi, hm⟩))
    (by decide)

theorem next_free_check :
    CompareDecoder.cellDecoderNext.all (fun i => decide (base 510 ∉ Instr.wires i)) = true := by
  -- K1 (replay budget): from the record's support envelope `CompareDecoder.support`
  -- (no pass over the decoder).
  rw [List.all_eq_true]
  intro i hi
  rw [decide_eq_true_iff]
  intro hm
  have hw : base 510 ∈ wires CompareDecoder.cellDecoderNext :=
    (ECDSAAdd.Entrant.SW.mem_wires_iff _ _).mpr ⟨i, hi, hm⟩
  have hl := List.mem_toFinset.mp (CompareDecoder.support hw)
  exact absurd hl (by decide +kernel)

theorem pad_free_check :
    (List.replicate 507 (Instr.measureX (base 512) [] [])).all
      (fun i => decide (base 510 ∉ Instr.wires i)) = true := by decide +kernel

theorem endHalfLoan_free_check :
    endHalfLoan.all (fun i => decide (base 510 ∉ Instr.wires i)) = true := by
  simp only [endHalfLoan, List.all_append, loan_free_check, pad_free_check, Bool.and_self]

theorem endHalfTrue_free_check :
    (endHalf true).all (fun i => decide (base 510 ∉ Instr.wires i)) = true := by
  simp only [endHalf_true, List.all_append, next_free_check, pad_free_check, Bool.and_self]

theorem endHalfLoan_free : base 510 ∉ wires endHalfLoan :=
  CompareDecoder.BoundaryLoan.not_mem_wires_of_all _ _ endHalfLoan_free_check

theorem endHalfTrue_free : base 510 ∉ wires (endHalf true) :=
  CompareDecoder.BoundaryLoan.not_mem_wires_of_all _ _ endHalfTrue_free_check


theorem forall_wires_of_all (P : Program) (f : Wire → Bool)
    (h : P.all (fun i => decide (∀ q ∈ Instr.wires i, f q = true)) = true) :
    ∀ q ∈ wires P, f q = true := by
  induction P with
  | nil => intro q hq; simp [wires] at hq
  | cons i P ih =>
    intro q hq
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq] at h
    rw [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · exact h.1 q hq
    · exact ih h.2 q hq

theorem loan_far_check :
    CompareDecoder.BoundaryLoan.cellDecoderLoan.all
      (fun i => decide (∀ q ∈ Instr.wires i, farB q = true)) = true := by
  rw [List.all_eq_true]
  intro i hi
  apply decide_eq_true
  intro q hq
  exact k5_loan_far q ((ECDSAAdd.Entrant.SW.mem_wires_iff _ _).mpr ⟨i, hi, hq⟩)

theorem pad_far_check :
    (List.replicate 507 (Instr.measureX (base 512) [] [])).all
      (fun i => decide (∀ q ∈ Instr.wires i, farB q = true)) = true := by
  decide +kernel

theorem endHalfLoan_far_check :
    endHalfLoan.all (fun i => decide (∀ q ∈ Instr.wires i, farB q = true)) = true := by
  simp only [endHalfLoan, List.all_append, loan_far_check, pad_far_check, Bool.and_self]

theorem endHalfLoan_far (q : Wire) (hq : q ∈ wires endHalfLoan) :
    528 ≤ q ∧ (q < 1044 ∨ 1556 ≤ q) := by
  have h := forall_wires_of_all endHalfLoan farB endHalfLoan_far_check q hq
  simp only [farB, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq] at h
  exact h

