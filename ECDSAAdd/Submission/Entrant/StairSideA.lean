/-! ## Layer 2: the loan window -/

theorem rawEndLoan_run_eq (X Y : Fp) (s : State) (m : List Bool)
    (clean : Q6EndpointCell.Clean base s.basis) (flagIn : s.basis (base 2409)=false)
    (rValue : regValue (balancedSharedPorts base (base 2409)).r s.basis=centerWord X)
    (yValue : regValue (balancedSharedPorts base (base 2409)).y s.basis=centerWord Y)
    (hend : (X+(if s.basis (base 510) then Y else -Y))/2=Y) :
    run rawEndLoan m s=run (rawEnd true) m s := by
  let copied := run [.CX (base 510) (base 2409)] [] s
  have flagAway : base 2409∉(balancedSharedPorts base (base 2409)).r ∧
      base 2409∉(balancedSharedPorts base (base 2409)).y := by
    rw [balancedSharedPorts_r,balancedSharedPorts_y]
    exact ⟨OwnPlusHost.not_block 2409 2056 256 (by omega),
      OwnPlusHost.not_block 2409 770 256 (by omega)⟩
  have copiedSame (q : Wire) (away : q≠base 2409) : copied.basis q=s.basis q := by
    simp only [copied,run,writeBit,Function.update_of_ne away]
  have copiedClean : Q6EndpointCell.Clean base copied.basis := by
    intro q hq
    obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hq
    rw [copiedSame _ (HostOB5.host_ne i 2409 (by have b:=Q6EndpointCell.work_bound i hi;omega))]
    exact clean _ (List.mem_map.mpr ⟨i,hi,rfl⟩)
  have self : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y copied.basis
      (centerWord X) (centerWord Y) copied.basis := by
    refine ⟨?_,?_,fun _ _ _ => rfl⟩
    · rw [Q6EndpointCell.ports_r]
      exact (regValue_congr _ _ _ (fun q hq => copiedSame q
        (fun eq => flagAway.1 (eq ▸ hq)))).trans rValue
    · rw [Q6EndpointCell.ports_y]
      exact (regValue_congr _ _ _ (fun q hq => copiedSame q
        (fun eq => flagAway.2 (eq ▸ hq)))).trans yValue
  have hn := Q6EndpointCell.ports_nodup_injective base (base 2409) base_injective (by
    intro member
    obtain ⟨i,hi,eq⟩ := List.mem_map.mp member
    have same := base_injective eq
    have bound := Q6EndpointCell.ids_bound i hi
    omega)
  have selected : copied.basis (base 2409)=s.basis (base 510) := by
    simp only [copied,run,writeBit,Function.update_self,flagIn,Bool.false_xor]
  have half := Q6EndpointCell.halfE_frame true base (base 2409) hn copied.basis
    copiedClean X Y (by rw [selected];exact fun _ => hend) copied m self
  have carryMember : base 719∈Q6EndpointCell.workIds.map base :=
    List.mem_map.mpr ⟨719,by simp [Q6EndpointCell.workIds,List.mem_range'_1],rfl⟩
  have carryAway := work_away' _ carryMember
  have keep : (run (Q6EndpointCell.halfE true base (base 2409)) m copied).basis (base 2409)=
      copied.basis (base 2409) := by
    exact half.2.2.2 _ (by simpa only [Q6EndpointCell.ports_r] using flagAway.1)
      (by simpa only [Q6EndpointCell.ports_y] using flagAway.2)
  have carryOut : (run (Q6EndpointCell.halfE true base (base 2409)) m copied).basis
      (base 719)=false := by
    exact (half.2.2.2 _ (by simpa only [Q6EndpointCell.ports_r] using carryAway.1)
      (by simpa only [Q6EndpointCell.ports_y] using carryAway.2)).trans
      (copiedClean _ carryMember)
  have same (r : List Bool) : run (endHalf true) r (run [.CX (base 510) (base 2409)] [] s)=
      run (Q6EndpointCell.halfE true base (base 2409)) r (run [.CX (base 510) (base 2409)] [] s) :=
    endHalf_run_eq true X Y copied r copiedClean self (by rw [selected];exact fun _ => hend)
      (fun h => by cases h)
  have keep' : (run (endHalf true) m copied).basis (base 2409)=copied.basis (base 2409) :=
    (congrArg (fun st : State => st.basis (base 2409)) (same m)).trans keep
  have carryOut' : (run (endHalf true) m copied).basis (base 719)=false :=
    (congrArg (fun st : State => st.basis (base 719)) (same m)).trans carryOut
  have sameL (r : List Bool) : run endHalfLoan r (run [.CX (base 510) (base 2409)] [] s)=
      run (endHalf true) r (run [.CX (base 510) (base 2409)] [] s) :=
    endHalfLoan_run_eq X Y copied r copiedClean self (by rw [selected];exact hend)
  have keepL : (run endHalfLoan m copied).basis (base 2409)=copied.basis (base 2409) :=
    (congrArg (fun st : State => st.basis (base 2409)) (sameL m)).trans keep'
  have carryOutL : (run endHalfLoan m copied).basis (base 719)=false :=
    (congrArg (fun st : State => st.basis (base 719)) (sameL m)).trans carryOut'
  have loanR := ControlLoan1589.loanWindow_eq _ _ _ _ s m
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    endHalfTrue_free flagIn (clean _ carryMember) keep' carryOut'
  have loanL := ControlLoan1589.loanWindow_eq _ _ _ _ s m
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    endHalfLoan_free flagIn (clean _ carryMember) keepL carryOutL
  have ne : base 2409 ≠ base 510 := by decide +kernel
  have agree : (run (endHalf true) m copied).basis (base 2409) =
      (run (endHalf true) m copied).basis (base 510) := by
    rw [keep', selected, run_preserves_outside _ _ _ _ endHalfTrue_free,
      copiedSame _ (Ne.symm ne)]
  rw [rawEndLoan, loanL, rawEnd, loanR, selW_run, selW_run, sameL m,
    meas_sel _ _ ne _ agree, meas_sel _ _ ne _ agree]

end ECDSAAdd.Entrant.Rolling1588Lifetime
