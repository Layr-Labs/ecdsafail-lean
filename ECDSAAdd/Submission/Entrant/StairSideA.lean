    ∀ y ∈ wires (R2SqEp760.endPacket760 false), y ∈ multEndL := by
  intro y hrec
  rw [endPacket760_false_shape, renameProgram_support] at hrec
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hrec
  rw [renameProgram_support] at ha
  obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp ha
  apply List.mem_map.mpr
  refine ⟨z, ?_, rfl⟩
  rcases Finset.mem_union.mp (ControlLoan1589.loanWindow_support _ _ _ _ hz) with h | h
  · rw [Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl
    · exact List.mem_cons_self ..
    · exact List.mem_cons_of_mem _ (List.mem_cons_self ..)
  · obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp h
    refine List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_map.mpr ⟨w, ?_, rfl⟩))
    rw [wires_append, Finset.mem_union] at hw
    rcases hw with hw | hw
    · exact List.mem_cons_of_mem _ (List.mem_toFinset.mp
        (InverseTailC.half_tight endLayout (Q6EndpointCell.ports_widths base (base 2409))
          endLayout_nodup hw))
    · have hc := (InverseEndpointWires.pad_facts 256 (base 512)).2.2.2.1 hw
      rw [Finset.mem_singleton] at hc
      rw [hc]
      exact List.mem_cons_self ..

