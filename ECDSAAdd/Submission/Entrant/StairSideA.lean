theorem p_facts : 0 < ECDSAAdd.p ∧ ECDSAAdd.p % 2 = 1 ∧ ECDSAAdd.p < 2 ^ 256 := by
  refine ⟨?_, ?_, ?_⟩ <;> norm_num [ECDSAAdd.p]

theorem coprime_of_lt (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) : x.Coprime ECDSAAdd.p :=
  Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd ECDSAAdd.Secp256k1.p_prime).mpr
    (Nat.not_dvd_of_pos_of_lt hx0 hx))

theorem budget_mem_checkpoints (B : Nat) (hB : B ∈ budgets) :
