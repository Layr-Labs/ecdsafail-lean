section

namespace ECDSAAdd.Entrant.IntegerPacket
open Arithmetic

def cell (p : Shape) (j : Nat) (s : BasisState) : Bool × Bool :=
  (s (ports p j).a0,s (ports p j).history)

def readCells (p : Shape) (j : Nat) : Nat → BasisState → List (Bool × Bool)
  | 0,_ => []
  | n+1,s => cell p j s :: readCells p (j+1) n s

private theorem older {p : Shape} {d i : Nat} (hd : d < i) (hi : i < p.length) :
    (ports p d).history∉(ports p i).wires ∧
      ((ports p d).a0=(ports p i).previous ∨ (ports p d).a0∉(ports p i).wires) := by
  have a:=p.extent
  have b:=p.rangeEnd
  have c:=p.midBound
  simp only [ports,SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,
    SkywalkIntegerLayout.bh,List.mem_append,List.mem_cons,List.mem_range'_1,List.not_mem_nil,or_false]
  constructor
  · intro bad
    repeat' first | cases_type And | cases_type Or
    all_goals try simp only [Wire] at *
    all_goals omega
  · by_cases last : d+1=i
    · left
      subst i
      change p.start+d+16=p.start+(d+1)+16-1
      omega
    · right; intro bad
      repeat' first | cases_type And | cases_type Or
      all_goals try simp only [Wire] at *
      all_goals omega

attribute [local irreducible] run skywalkIntegerTick skywalkIntegerUntick signedRegValue regValue

private theorem single_record (p : Shape) {i : Nat} (hi : i < p.length) (z : SkywalkRails.State)
    (odd : (z.a+z.b)%2=1) (s : State) (m : List Bool) (h : ready p i z s.basis) :
    cell p i (run (skywalkIntegerTick (ports p i)) m s).basis=SkywalkTrace.code z ∧
    ∀ d < i, cell p d (run (skywalkIntegerTick (ports p i)) m s).basis=cell p d s.basis := by
  obtain ⟨ha,hb,hg,hc,clean⟩:=h
  obtain ⟨he,hh⟩:=clean i (Nat.le_refl _) hi
  obtain ⟨_,_,_,g,sw,prev,_⟩:=executed p ⟨i,hi⟩ _ _ _ odd s m ⟨ha,hb,hg,he,hh,hc⟩
  constructor
  · exact Prod.ext g sw
  · intro d hd
    obtain ⟨away,either⟩:=older hd hi
    have sup:=(skywalkIntegerTick_wires_subset (ports p i) (ok p ⟨i,hi⟩)).1
    apply Prod.ext
    · rcases either with eq|ne
      · change (run _ _ _).basis _=s.basis _
        rw [eq,prev,hg]
      · exact run_preserves_outside _ m s _ (fun h=>ne (List.mem_toFinset.mp (sup h)))
    · exact run_preserves_outside _ m s _ (fun h=>away (List.mem_toFinset.mp (sup h)))

theorem records (p : Shape) (i n : Nat) (bound : i+n≤p.length) (z : SkywalkRails.State)
    (odd : (z.a+z.b)%2=1) (s : State) (m : List Bool) (h : ready p i z s.basis) :
    readCells p i n (run (seq p i n) m s).basis=SkywalkTrace.trace n z ∧
      ∀ d < i,cell p d (run (seq p i n) m s).basis=cell p d s.basis := by
  induction n generalizing i z s m with
  | zero => simp [seq,readCells,run,SkywalkTrace.trace]
  | succ n ih =>
    let L:=ports p i
    let preTape:=m.take (measurementCount (skywalkIntegerTick L))
    let t:=run (skywalkIntegerTick L) preTape s
    have hi:i < p.length:=by omega
    have pre:ready p (i+1) (SkywalkTrace.next z) t.basis:=(one p hi z odd s preTape h).2
    have next:=ih (i+1) (by omega) (SkywalkTrace.next z) (nextOdd z odd) t
      (m.drop (measurementCount (skywalkIntegerTick L))) pre
    obtain ⟨now,old⟩:=single_record p hi z odd s preTape h
    simp only [seq,run_append,readCells,SkywalkTrace.trace]
    exact ⟨congr (congrArg List.cons ((next.2 i (by omega)).trans now)) next.1,
      fun d hd=>(next.2 d (by omega)).trans (old d hd)⟩


end ECDSAAdd.Entrant.IntegerPacket

end

