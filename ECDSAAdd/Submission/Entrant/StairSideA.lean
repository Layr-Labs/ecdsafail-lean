/-!
# LT43h: the payload parity of a record `CutFrame`

On every record cut frame (packets `≥ c` A-encoded, packets `< c` B-encoded) of
the transcript of `x`, the XOR of the 816 payload controls is the history letter
`s 510` of the walk of `x` (`cut_parity`): every packet codec keeps the XOR of its
five raw sign letters (`Rolling1588.encodeGroup_packet_parity`, either code), and
the 510 raw sign letters XOR to `s 510` (`TraceParity5.rawS510_relation`).

This is a statement about the FRAME state `s` (kernel view through `OB5.sig 511`).
The genuine record state between `firstPkt`/`headE` and the final `unprefix`
differs from the frame state on packet 0 (`Prefix1590.payload0`, the scratch
window), see `StairField2V3LastRecXWin`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3LastRecXPar

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3Seg StairField2V3RecScratch StairField2V3LastSpec
open StairPhysicalLayout StairOuterPlacement

attribute [local irreducible] wires run

theorem history_sign (w : Nat → Wire) (start i : Nat) (hi : i < 5) :
    History5.historyMap w start ⟨2 * i + 1, by omega⟩ = w (1028 + start + i) := by
  change w (if (2 * i + 1) % 2 = 0 then start + (2 * i + 1) / 2
    else 1028 + start + (2 * i + 1) / 2) = _
  rw [if_neg (show ¬(2 * i + 1) % 2 = 0 from by omega)]
  congr 1
  omega

/-- The sites of packet `j` are outside the encoders of the other packets. -/
theorem other_away (w : Nat → Wire) (cut j : Nat) (hn : (skywalkPoolWires w).Nodup)
    (n : Nat) (bound : 5 * n ≤ 512) (hj : j < n) (port : Fin 10) :
    History5.historyMap w (5 * j) port ∉ wires (Rolling1588.otherEncodeCut w cut j n) := by
  intro used
  rw [Rolling1588.otherEncodeCut_support_eq] at used
  obtain ⟨k, hk, hne, mem⟩ := NewHistory5.otherEncode_member w n j _ used
  have own := NewHistory5.history_site_mem w (5 * j) port
  rcases Nat.lt_or_gt_of_ne hne with lt | gt
  · exact Finset.disjoint_left.mp (NewHistory5.windows_disjoint w hn (5 * k) (5 * j)
      (by omega) (by omega) (by omega)) mem own
  · exact Finset.disjoint_left.mp (NewHistory5.windows_disjoint w hn (5 * j) (5 * k)
      (by omega) (by omega) (by omega)) own mem

/-- Packet `j` of a cut encoding keeps the XOR of its five raw sign letters. -/
theorem cut_packet_parity (w : Nat → Wire) (cut : Nat) (hn : (skywalkPoolWires w).Nodup)
    (n j : Nat) (bound : 5 * n ≤ 512) (hj : j < n) (raw : State)
    (legal : NewHistory5.RawLegal w n raw.basis) :
    TraceParity5.xorRange 8 (fun i => (run (Rolling1588.allEncodeCut w cut n) [] raw).basis
      (NewHistory5.payloadWire w (8 * j + i))) =
      TraceParity5.xorRange 5 (fun i => raw.basis (w (1028 + 5 * j + i))) := by
  rw [Rolling1588.allEncodeCut_factor w cut hn n j bound hj raw]
  have result := Rolling1588.encodeGroup_packet_parity w (decide (cut ≤ j)) hn j (by omega)
    raw [] (legal j hj)
  rw [← result]
  apply TraceParity5.xorRange_congr
  intro i hi
  rw [NewHistory5.payloadWire_packet w j i hi]
  simp only [Nat.mod_eq_of_lt hi, NewHistory5.historyMap]
  exact run_preserves_outside _ _ _ _ (other_away w cut j hn n bound hj _)

theorem controls_parity (b : BasisState) :
    TraceParity5.parity (FrontierEntry1591Field.controls.map b) =
      TraceParity5.xorRange 816 (fun i => b (OB5.sig 511 (NewHistory5.payloadWire base i))) := by
  simpa only [FrontierEntry1591Field.controls, ParityHost5.payloadControls,
    List.map_map, Function.comp_def] using TraceParity5.parity_range 816
      (fun i => b (OB5.sig 511 (NewHistory5.payloadWire base i)))

theorem rawS_origin (x : Nat) (origin : BasisState) (hx : TraceOK x origin) (i : Nat)
    (hi : i < 512) : origin (base (1028 + i)) = TraceParity5.rawS x i := by
  rw [(StairField2V3Trace.origin_letters x origin hx i hi).2]
  simp only [TraceParity5.rawS, SkywalkTrace.trace_getD_code 512 _ i hi]

theorem s510_rawS (x : Nat) : s510 x = TraceParity5.rawS x 510 := by
  simp only [s510, TraceParity5.rawS, SkywalkTrace.trace_getD_code 512 _ 510 (by decide)]

/-- XOR of the payload of packet `j` on a record cut frame (kernel view). -/
theorem cut_packet (c : Nat) (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (X Y : Fp) (s : State)
    (frame : Rolling1588.CutFrame c origin X Y (pullState (OB5.sig 511) s))
    (x : Nat) (tr : TraceOK x origin) (j : Nat) (hj : j < 102) :
    TraceParity5.xorRange 8
        (fun i => s.basis (OB5.sig 511 (NewHistory5.payloadWire base (8 * j + i)))) =
      TraceParity5.xorRange 5 (fun i => TraceParity5.rawS x (5 * j + i)) := by
  obtain ⟨raw, -, pair, enc⟩ := frame
  have rawLegal := NewHistory5.frame_history_legal base (base 2409) ctx.hn
    (ctx.hp _ (by simp)) 102 (by decide) origin raw.basis _ _ tr.2.2.2 pair
  have h := cut_packet_parity base c base_pool_nodup 102 j (by decide) hj raw rawLegal
  rw [← enc] at h
  refine Eq.trans h ?_
  apply TraceParity5.xorRange_congr
  intro i hi
  have away := History5.history_words_away base (base 2409) ctx.hn (ctx.hp _ (by simp))
    (5 * j) (by omega) ⟨2 * i + 1, by omega⟩
  rw [history_sign base (5 * j) i hi] at away
  rw [pair.2.2 _ away.1 away.2, show 1028 + 5 * j + i = 1028 + (5 * j + i) from by omega,
    rawS_origin x origin tr (5 * j + i) (by omega)]


end ECDSAAdd.Entrant.StairField2V3LastRecXPar

end
end Merge_StairField2V3LastRecXPar_at_QTop

