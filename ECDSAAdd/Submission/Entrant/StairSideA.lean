/-! ### merged from `ECDSAAdd.Submission.Entrant.StairOddHeadChk_at_StairSideA` -/
section Merge_StairOddHeadChk_at_StairSideA

/-!
# Kernel checks for the odd-word head

Static facts about the odd-word cells used by the head and the tail (`P1Life.half`,
`P1Life.dstart`, `P1Life.dend`, `P1Life.mstart`, `P1Life.mend`, all at the record placement
`base 760`):

* the zero tracker of `StairField13V3ZT` on the 44 exclusive roles.  Only the resetting
  suffix of each cell is evaluated (its last ripple pass; for the ordinary half the last two,
  because the short constant adder does not use the two highest roles);
* the record half `R2Life760.half760 true` mentions every wire of the cell footprint.  Only
  five top-level pieces of the record half are scanned, into one bit mask.

No program run is evaluated.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairOddHead

open ECDSAAdd Arithmetic Challenge MappedCompressed
open StairField13V3Clean


/-! ## Zero tracker -/

/-! ## KX3 (replay budget): ripple passes as fused sweeps

The kernel builds a ripple generator (`majority ++ rec ++ erase`) with left-nested appends,
which costs quadratic time in the width (≈ 28 s for one 255-bit pass, before any tracker
runs).  A ripple pass is a `StairLoan.emitSweep`; the tracker of its down-pass is evaluated
through a recursion fused along the layer list, so no gate list of a pass is built. -/


theorem kx3_ztM_downs (lo width : Nat) : ∀ (ls : List StairLoan.CarryLayer) (m : Nat),
    ztM lo width m (StairLoan.emitDowns ls) = kx3ztDowns lo width m ls
  | [], _ => rfl
  | l :: ls, m => by
    show ztM lo width m (StairLoan.emitDowns ls ++ (l.erase ++ l.finish)) = _
    rw [k1_ztM_append, kx3_ztM_downs lo width ls m]
    rfl

/-- The down-pass of a sweep alone resets the listed wires. -/
theorem kx3_sweep_reset (lo width : Nat) (b : Bool) (ws : List Wire)
    (ls : List StairLoan.CarryLayer) (top : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (h : ws.all (fun w => (kx3ztDowns lo width 0 ls).testBit (w - lo)) = true) :
    ztAll lo width b ws (StairLoan.emitSweep ls top) = true := by
  rw [StairLoan.emitSweep]
  refine ztAll_of_suffix lo width b ws _ _ hr ?_
  show ws.all (fun w => (ztM lo width 0 (StairLoan.emitDowns ls)).testBit (w - lo)) = true
  rw [kx3_ztM_downs]
  exact h

/-- A whole sweep keeps the listed wires reset. -/
theorem kx3_sweep_keep (lo width : Nat) (ws : List Wire)
    (ls : List StairLoan.CarryLayer) (top : Program)
    (h : ws.all (fun w => (kx3ztDowns lo width
      (ztM lo width (ztM lo width (2 ^ width - 1) (StairLoan.emitUps ls)) top) ls).testBit
        (w - lo)) = true) :
    ztAll lo width true ws (StairLoan.emitSweep ls top) = true := by
  rw [StairLoan.emitSweep]
  show ws.all (fun w => (ztM lo width (2 ^ width - 1)
    (StairLoan.emitUps ls ++ top ++ StairLoan.emitDowns ls)).testBit (w - lo)) = true
  rw [k1_ztM_append, k1_ztM_append, kx3_ztM_downs]
  exact h

/-- Moving the retired carry onto a host outside the roles fixes every role. -/
theorem kx3_move_fixed (host : Wire)
    (h : rolesL.all (fun w => w != base 760 && w != host) = true) :
    ∀ w ∈ rolesL, (Equiv.swap (base 760) host) w = w := by
  intro w hw
  have t := List.all_eq_true.mp h w hw
  simp only [Bool.and_eq_true, bne_iff_ne, ne_eq] at t
  exact Equiv.swap_apply_of_ne_of_ne t.1 t.2

/-- The ordinary odd-word division half up to its comparison pass. -/
def oddHalfPrefix : Program :=
  [.X (base 2409)] ++ (P1Life.p1Seed cellL ++ P1Life.rawAdd (base 760) cellL ++
    OneReuse.newPrepare cellL ++ rotateRight (BalancedCircuit.rawTarget cellL) ++
    P1Life.fold (base 760) cellL ++ BalancedCleanup.prepareSign cellL.toLayout ++
    BiasedCircuit.flipBias cellL ++ P1Life.prepareCompare cellL ++
    P1Life.exposure cellL)

/-- The comparison pass and the short constant adder of the ordinary odd-word division half. -/
def oddHalfTail : Program :=
  P1Life.compare (base 760) true cellL ++ ((P1Life.exposure cellL).reverse ++
    ((P1Life.prepareCompare cellL).reverse ++
      (Q6LifetimeResearch.move (base 760) cellL.rmsb
          (P1Life.shortConstAdd cellL BalancedField.h.toNat) ++
        ((BalancedCleanup.prepareSign cellL.toLayout).reverse ++ [.X (base 2409)]))))

theorem oddHalf_shape :
    P1Life.half (base 760) true base (base 2409) = oddHalfPrefix ++ oddHalfTail := by
  simp only [oddHalfPrefix, oddHalfTail, P1Life.half, P1Life.forward, ↓reduceIte,
    List.append_assoc, cellL]

set_option maxHeartbeats 0 in
theorem chk_tail_oddHalf : ztAll 736 45 false rolesL oddHalfTail = true := by
  -- KX3 (replay budget): fused sweeps (was `decide +kernel` on the built gate list)
  unfold oddHalfTail P1Life.compare P1Life.shortConstAdd
  simp only [Q6LifetimeResearch.move, StairLoan.compareChain_as_sweep,
    StairLoan.literalConstAdd_as_sweep, List.append_assoc]
  refine ztAll_of_suffix 736 45 false rolesL _ _ rolesL_window ?_
  refine ztAll_of_suffix 736 45 false rolesL _ _ rolesL_window ?_
  refine ztAll_of_suffix 736 45 false rolesL _ _ rolesL_window ?_
  refine k1_ztAll_append_true 736 45 false rolesL _ _ rolesL_window
    (k1_ztAll_rename_fixed 736 45 false rolesL _ (Equiv.swap _ _).injective _ rolesL_window
      (kx3_move_fixed _ (by decide +kernel))
      (kx3_sweep_reset 736 45 false rolesL _ _ rolesL_window (by decide +kernel))) ?_
  refine k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window (by decide +kernel) ?_
  refine k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window (by decide +kernel) ?_
  refine k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window (by decide +kernel) ?_
  refine k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window (by decide +kernel) ?_
  refine k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window (by decide +kernel) ?_
  refine k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window ?_ (by decide +kernel)
  refine k1_ztAll_rename_fixed 736 45 true rolesL _ (Equiv.swap _ _).injective _ rolesL_window
    (kx3_move_fixed _ (by decide +kernel)) ?_
  exact k1_ztAll_append_true 736 45 true rolesL _ _ rolesL_window
    (kx3_sweep_keep 736 45 rolesL _ _ (by decide +kernel)) (by decide +kernel)

theorem chk_keep_oddHalf : ztAll 736 45 true rolesL
    (P1Life.half (base 760) true base (base 2409)) = true := by
  rw [oddHalf_shape]
  exact ztAll_of_suffix 736 45 true rolesL oddHalfPrefix oddHalfTail rolesL_window
    chk_tail_oddHalf

def dstartPrefix : Program :=
  [.X (base 2409)] ++ P1Life.junctionStdHead (base 760) cellL ++ P1Life.emitOdd (base 760) cellL

/-- The recoder that ends `dstart` (its last ripple pass). -/
def dstartTail : Program :=
  P1Life.recode (base 760) true cellL cellL.y ++ [.X (base 2409)]

theorem dstart_shape :
    P1Life.dstart (base 760) base (base 2409) = dstartPrefix ++ dstartTail := by
  simp only [dstartPrefix, dstartTail, P1Life.dstart, List.append_assoc, cellL]

set_option maxHeartbeats 0 in
theorem chk_tail_dstart : ztAll 736 45 false rolesL dstartTail = true := by
  -- KX3 (replay budget): fused sweeps (was `decide +kernel` on the built gate list)
  unfold dstartTail P1Life.recode
  simp only [↓reduceIte, StairLoan.mappedAdd_as_sweep, List.append_assoc]
  exact k1_ztAll_append_true 736 45 false rolesL _ _ rolesL_window
    (kx3_sweep_reset 736 45 false rolesL _ _ rolesL_window (by decide +kernel)) (by decide +kernel)

theorem chk_keep_dstart : ztAll 736 45 true rolesL
    (P1Life.dstart (base 760) base (base 2409)) = true := by
  rw [dstart_shape]
  exact ztAll_of_suffix 736 45 true rolesL dstartPrefix dstartTail rolesL_window chk_tail_dstart

def dendPrefix : Program :=
  [.X (base 2409)] ++ P1Life.junctionOddHead (base 760) cellL ++
    P1Life.emitStandard (base 760) cellL

/-- The recoder that ends `dend` (its last ripple pass). -/
def dendTail : Program :=
  P1Life.recode (base 760) false cellL cellL.y ++ [.X (base 2409)]

theorem dend_shape :
    P1Life.dend (base 760) base (base 2409) = dendPrefix ++ dendTail := by
  simp only [dendPrefix, dendTail, P1Life.dend, List.append_assoc, cellL]

set_option maxHeartbeats 0 in
theorem chk_tail_dend : ztAll 736 45 false rolesL dendTail = true := by
  -- KX3 (replay budget): fused sweeps (was `decide +kernel` on the built gate list)
  unfold dendTail P1Life.recode
  simp only [Bool.false_eq_true, ↓reduceIte, mappedSub, StairLoan.mappedAdd_as_sweep,
    List.append_assoc]
  refine ztAll_of_suffix 736 45 false rolesL _ _ rolesL_window ?_
  refine ztAll_of_suffix 736 45 false rolesL _ _ rolesL_window ?_
  exact k1_ztAll_append_true 736 45 false rolesL _ _ rolesL_window
    (kx3_sweep_reset 736 45 false rolesL _ _ rolesL_window (by decide +kernel)) (by decide +kernel)

theorem chk_keep_dend : ztAll 736 45 true rolesL
    (P1Life.dend (base 760) base (base 2409)) = true := by
  rw [dend_shape]
  exact ztAll_of_suffix 736 45 true rolesL dendPrefix dendTail rolesL_window chk_tail_dend

/-! ### Multiplication cells (`P1Life.half … false`, `P1Life.mstart`, `P1Life.mend`) -/

/-- The odd-word multiplication half up to its raw subtraction. -/
def oddHalfFPrefix : Program :=
  [.X (base 2409)] ++ (BalancedCleanup.prepareSign cellL.toLayout ++
    Q6LifetimeResearch.move (base 760) cellL.rmsb
      (P1Life.shortConstAdd cellL (BalancedField.encodeWord 255 (-BalancedField.h))) ++
    P1Life.prepareCompare cellL ++ P1Life.exposure cellL ++
    P1Life.compare (base 760) false cellL ++ (P1Life.exposure cellL).reverse ++
    (P1Life.prepareCompare cellL).reverse ++ BiasedInverse.unbiasView cellL ++
