theorem state_eq_of_values {L : ControlledPointLayout} {X Y : Fp} {G : Bool}
    {base : BasisState} {s a b : State}
    (ha : a.phase = s.phase ∧ PointDialogValues L X Y G base a.basis)
    (hb : b.phase = s.phase ∧ PointDialogValues L X Y G base b.basis) : a = b := by
  apply State.extensionality
  · exact ha.1.trans hb.1.symm
  · funext q
    by_cases hx : q ∈ L.point.x
