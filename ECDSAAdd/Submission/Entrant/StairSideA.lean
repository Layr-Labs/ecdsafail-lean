namespace ECDSAAdd.Entrant.HighBankUnit
open Arithmetic

def zeros (width : Nat) : List MappedBit := List.replicate width ⟨none,false⟩

private theorem zeroFacts (n : Nat) (b : BasisState) :
    mappedWires (zeros n)=[] ∧ mappedValue (zeros n) b=0 := by
  induction n with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    simpa [zeros,List.replicate_succ,mappedWires,mappedValue,MappedBit.value] using ih

def add (ys carry : List Wire) (cin : Wire) := mappedAdd (zeros ys.length) ys carry cin
def sub (ys carry : List Wire) (cin : Wire) := mappedSub (zeros ys.length) ys carry cin

theorem add_correct (ys carry : List Wire) (cin : Wire) (hn : (cin::(ys++carry)).Nodup)
    (hc : carry.length+1=ys.length) (s : State) (m : List Bool) (clean : ∀q∈carry,s.basis q=false) :
    (run (add ys carry cin) m s).phase=s.phase ∧
    (∀q,q∉ys → (run (add ys carry cin) m s).basis q=s.basis q) ∧
    regValue ys (run (add ys carry cin) m s).basis=
      (regValue ys s.basis+(s.basis cin).toNat)%2^ys.length := by
  obtain ⟨hw,hv⟩ := zeroFacts ys.length s.basis
  simpa only [add,hv,Nat.zero_add] using mappedAdd_correct (zeros ys.length) ys carry cin hn
    (by simp [hw]) (by simp [zeros]) hc s m clean

theorem complement_unit (b : Bool) (Y N : Nat) (h : Y<N) :
    N-1-((N-1-Y+b.toNat)%N)=(Y+N-b.toNat)%N := by
  cases b
  · simp only [Bool.toNat_false,Nat.add_zero,Nat.sub_zero,Nat.add_mod_right]
    rw [Nat.mod_eq_of_lt h, Nat.mod_eq_of_lt (show N-1-Y<N by omega)]
    omega
  · simp only [Bool.toNat_true]
    by_cases hz : Y=0
    · subst Y
      rw [show N-1-0+1=N by omega,Nat.mod_self,Nat.mod_eq_of_lt (show 0+N-1<N by omega)]
      omega
    · rw [Nat.mod_eq_of_lt (show N-1-Y+1<N by omega),
        show Y+N-1=(Y-1)+N by omega,Nat.add_mod_right,Nat.mod_eq_of_lt (show Y-1<N by omega)]
      omega

theorem sub_correct (ys carry : List Wire) (cin : Wire) (hn : (cin::(ys++carry)).Nodup)
    (hc : carry.length+1=ys.length) (s : State) (m : List Bool) (clean : ∀q∈carry,s.basis q=false) :
    (run (sub ys carry cin) m s).phase=s.phase ∧
    (∀q,q∉ys → (run (sub ys carry cin) m s).basis q=s.basis q) ∧
    regValue ys (run (sub ys carry cin) m s).basis=
      (regValue ys s.basis+2^ys.length-(s.basis cin).toNat)%2^ys.length := by
  have nd := (List.nodup_append'.mp (List.nodup_cons.mp hn).2).1
  have away (q : Wire) (hq : q∈cin::carry) : q∉ys := by
    intro bad
    have count := List.nodup_iff_count.mp hn q
    have a := List.count_pos_iff.mpr hq
    have b := List.count_pos_iff.mpr bad
    simp only [List.count_cons,List.count_append] at count a
    omega
  let s1 : State := ⟨s.phase,fun q => if q∈ys then !s.basis q else s.basis q⟩
  have first (r : List Bool) : run (notRegister ys) r s=s1 := notRegister_correct ys nd s r
  have keep (q : Wire) (hq : q∉ys) : s1.basis q=s.basis q := by simp [s1,hq]
  have ci := keep cin (away cin (by simp))
  have inverted : regValue ys s1.basis=2^ys.length-1-regValue ys s.basis := by
    rw [regValue_congr ys s1.basis (fun q => !s.basis q) (by intro q hq; simp [s1,hq]),regValue_complement]
  obtain ⟨phase,same,value⟩ := add_correct ys carry cin hn hc s1 m
    (fun q hq => (keep q (away q (by simp [hq]))).trans (clean q hq))
  let t := run (mappedAdd (zeros ys.length) ys carry cin) m s1
  have flipValue : regValue ys (fun q => if q∈ys then !t.basis q else t.basis q)=
      2^ys.length-1-regValue ys t.basis := by
    rw [regValue_congr ys _ (fun q => !t.basis q) (by intro q hq; simp [hq]),regValue_complement]
  simp only [sub,mappedSub,List.append_assoc,run_append,run_take,(notRegister_counts ys).2,
    List.take_zero,List.drop_zero]
  rw [first]
  change (run (notRegister ys) _ t).phase=s.phase ∧ _
  rw [notRegister_correct ys nd]
  refine ⟨phase,fun q hq => ?_,?_⟩
  · simp only [hq,if_false]
    exact (same q hq).trans (keep q hq)
  · rw [flipValue,show regValue ys t.basis=_ from value,inverted,ci]
    exact complement_unit _ _ _ (regValue_lt ys s.basis)

theorem counts (ys carry : List Wire) (cin : Wire) (hc : carry.length+1=ys.length) :
    (toffoliCount (add ys carry cin)=ys.length-1 ∧ measurementCount (add ys carry cin)=ys.length-1) ∧
    (toffoliCount (sub ys carry cin)=ys.length-1 ∧ measurementCount (sub ys carry cin)=ys.length-1) :=
  ⟨mappedAdd_counts _ _ _ _ (by simp [zeros]) hc,mappedSub_counts _ _ _ _ (by simp [zeros]) hc⟩

end ECDSAAdd.Entrant.HighBankUnit

end

