        10 * d := by
  have h := mappedAddLoan_some_slots_le d roles q n k ys cs cin hb hc hd
  simp only [StairLoan.mappedSubLoan, mappedSub, gateSlots_append] at h ⊢
  omega

/-- The mapped encoding selected by a positive literal loan is no more
expensive than the record's specialized literal cells. -/
theorem mappedConstant_add_slots_le (xs carry : List Wire)
    (cin one : Wire) (k : Nat) :
    gateSlots (mappedAdd (mappedConstant none xs.length k) xs carry cin) <=
      gateSlots (literalConstAdd xs carry cin one k) := by
  induction xs generalizing carry cin k with
  | nil => simp [mappedConstant, mappedAdd, literalConstAdd, gateSlots]
  | cons x xs ih =>
      cases xs with
      | nil =>
          by_cases bit : k % 2 = 1 <;>
            simp [mappedConstant, mappedConstantBit, mappedAdd, literalConstAdd,
              mappedSum, literalConstSum, gateSlots, instructionSlots, bit]
      | cons x' xs =>
          cases carry with
          | nil => simp [mappedConstant, mappedAdd, literalConstAdd, gateSlots]
          | cons c cs =>
              have rest := ih cs c (k / 2)
              by_cases bit : k % 2 = 1
              · simp [mappedConstant, mappedConstantBit, mappedAdd,
                  literalConstAdd, mappedMajority, mappedEraseCarry,
                  mappedSum, literalConstStep, literalConstSum,
                  literalConstCarry, literalConstErase, bit,
                  gateSlots_append, gateSlots, instructionSlots] at rest ⊢
                omega
              · simp [mappedConstant, mappedConstantBit, mappedAdd,
                  literalConstAdd, mappedMajority, mappedEraseCarry,
                  mappedSum, literalConstStep, literalConstSum,
                  literalConstCarry, literalConstErase, bit,
                  gateSlots_append, gateSlots, instructionSlots] at rest ⊢
                omega

theorem literalConstAddLoan_slots_le (d : Nat) (roles xs carry : List Wire)
    (cin one : Wire) (k : Nat) (hc : carry.length + 1 = xs.length)
    (hd : d <= carry.length) :
    gateSlots (StairLoan.literalConstAddLoan d roles xs carry cin one k) <=
      gateSlots (literalConstAdd xs carry cin one k) + 14 * d := by
  cases d with
  | zero => simp [StairLoan.literalConstAddLoan]
  | succ d =>
      have bits : (mappedConstant none xs.length k).length = xs.length :=
        mappedConstant_length none xs.length k
      have loan := mappedAddLoan_slots_le (d + 1) roles
        (mappedConstant none xs.length k) xs carry cin bits hc hd
      have mapped := mappedConstant_add_slots_le xs carry cin one k
      simp only [StairLoan.literalConstAddLoan, Nat.succ_ne_zero, if_false]
      omega

theorem addPrefixLoan_slots_le (d : Nat) (roles xs ys carry : List Wire)
    (a t z cin : Wire) (hy : ys.length = xs.length)
    (hc : carry.length = xs.length) (hd : d <= carry.length) :
    gateSlots (StairLoan.addPrefixLoan d roles xs ys carry a t z cin) <=
      gateSlots (CoherentTail.addPrefix xs ys carry a t z cin) + 14 * d := by
  have len := StairLoan.prefixLayers_length xs ys carry a t z cin hy hc
  have bound := emitLoan_slots_le d roles
    (StairLoan.prefixLayers xs ys carry a t z cin)
    (StairLoan.prefixTop xs ys carry a t z cin) (by omega)
    (prefixLayers_slotUnit xs ys carry a t z cin)
  rw [← StairLoan.addPrefix_as_sweep] at bound
  simpa only [StairLoan.addPrefixLoan] using bound

