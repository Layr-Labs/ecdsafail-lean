      (gatePhysical_rename _ Rolling1588Lifetime.endpointBorrow.injective _ old.1),
    R2SqEp760.swap_physical _ _ _
      (gatePhysical_rename _ Rolling1588Lifetime.endpointBorrow.injective _ old.2.1)⟩

theorem canon760Loan_physical : GatePhysical canon760Loan := by
  have h : GatePhysical (HalfConvert.canonical converterLayout760) := by
    rw [← canon760_eq]
    exact record_converters_physical.2
  exact canonicalLoan_physical 44 exclusiveHoles converterLayout760 h

