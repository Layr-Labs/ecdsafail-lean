  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> simp [StairSchedule.checkpoints]

theorem domain_row (B : Nat) (hB : B ∈ budgets) (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) :
    StairCodec.CodecDomain B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
