theorem mapped_code_physical (isA : Bool) (f : Fin 10 → Wire)
    (hf : Function.Injective f) :
    GatePhysical
      (renameProgram (MeasuredCodec5.label f) (Rolling1588.codeEncode isA)) ∧
    GatePhysical
      (renameProgram (MeasuredCodec5.label f) (Rolling1588.codeDecode isA)) := by
  have enc : wires (Rolling1588.codeEncode isA) ⊆ Finset.range 10 := by
    simpa only [(Rolling1588.code_support isA).1] using
      (Finset.Subset.refl (Finset.range 10))
  have dec : wires (Rolling1588.codeDecode isA) ⊆ Finset.range 10 := by
    simpa only [(Rolling1588.code_support isA).2] using
      (Finset.Subset.refl (Finset.range 10))
  exact
    ⟨gatePhysical_rename_support _ _
      (fun a ha b hb e =>
        FirstNonzeroCodec.label_inj' f hf a (enc ha) b (enc hb) e)
      (Rolling1588.code_physical isA).1,
    gatePhysical_rename_support _ _
      (fun a ha b hb e =>
        FirstNonzeroCodec.label_inj' f hf a (dec ha) b (dec hb) e)
      (Rolling1588.code_physical isA).2⟩

