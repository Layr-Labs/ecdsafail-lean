/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanInverseComposeA_at_StairSideA` -/
section Merge_StairLoanInverseComposeA_at_StairSideA

/-!
# Positive-depth inverse carry-loan kernel: composition (field 4)

`inverseLoan_exists` replaces, from left to right, the four loaned blocks of
`StairLoan.inverseLoan d` (normalize, comparison, unfold, raw-subtraction tail)
by the corresponding blocks of the record lifetime inverse
`Q6LifetimeResearch.inverse (base 760)`; each replacement happens on the
state reached by the record prefix (`inverse_step_*`), and the program
decompositions are `inverseLoan_shape0..4`.
-/

set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairLoanInverse

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-- Work-site cleanliness, split (stated for a symbolic layout). -/
theorem inv_work_clean (L : BalancedCircuit.Layout) (s : State)
    (clean : ∀ q ∈ BalancedCircuit.work L, s.basis q = false) :
    s.basis L.lower = false ∧ s.basis L.one = false ∧ s.basis L.parity = false ∧
      ∀ q ∈ L.carry, s.basis q = false :=
  ⟨clean _ (by simp [BalancedCircuit.work]), clean _ (by simp [BalancedCircuit.work]),
    clean _ (by simp [BalancedCircuit.work]),
    fun q hq => clean q (by simp [BalancedCircuit.work, hq])⟩

/-- Every record of the loaned inverse kernel is matched by a record of the
record lifetime inverse kernel, on the clean centered input frame. -/
theorem inverseLoan_exists (d : Nat) (hd : d ≤ 68)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L760.sign = B)
    (hR : signedRegValue L760.r s.basis = R)
    (hY : signedRegValue L760.y s.basis = Y)
    (clean : ∀ q ∈ BalancedCircuit.work L760, s.basis q = false) :
    ∃ n, run (StairLoan.inverseLoan d L760) m s =
      run (Q6LifetimeResearch.inverse (base 760) L760) n s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have widths := BalancedCleanup.widths L760.toLayout hw
  have hR' : regValue L760.r s.basis = encodeWord 256 R :=
    BalancedCircuit.word_encoding L760.r 256 widths.2.1 s.basis R hR
  obtain ⟨hl, ho, hp, hc⟩ := inv_work_clean L760 s clean
  obtain ⟨n1, e1⟩ := inverse_step_normalize d hd R hr s m hR' hl ho hc _ _
    (inverseLoan_shape0 d)
  obtain ⟨n2, e2⟩ := inverse_step_compare d hd R hr s n1 hR' hl ho hc hp _ _
    (inverseLoan_shape1 d)
  obtain ⟨n3, e3⟩ := inverse_step_unfold d hd B R Y hr hy s n2 hs hR hY clean _ _
    (inverseLoan_shape2 d)
  obtain ⟨n4, e4⟩ := inverse_step_tail d hd B R Y hr hy s n3 hs hR hY clean _ _
    (inverseLoan_shape3 d)
  refine ⟨n4, ?_⟩
  rw [e1, e2, e3, e4, inverseLoan_shape4]

end ECDSAAdd.Entrant.StairLoanInverse
end Merge_StairLoanInverseComposeA_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanInverseCompose_at_StairSideA` -/
section Merge_StairLoanInverseCompose_at_StairSideA

/-!
# Positive-depth inverse carry-loan half: composition (field 4)

`inverseLoan_exists` replaces, from left to right, the four loaned blocks of
`StairLoan.inverseLoan d` (normalize, comparison, unfold, raw-subtraction tail)
by the corresponding blocks of the record lifetime inverse
`Q6LifetimeResearch.inverse (base 760)`.  Each replacement happens on the
state reached by the *record* prefix, whose block-entry facts are the
`inv_*_ready` theorems.  The half statement then follows from the record's
`R2Life760.half760_run_eq`.
-/

set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairLoanInverse

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField Baselines

section HalfInput
open BalancedCircuit
attribute [local irreducible] run

/-- The record's half-entry facts (verbatim from `Q6LifetimeProof.half_old_eq`):
after the leading sign flip the centered pair frame gives the kernel premises. -/
theorem inv_half_input (w : Nat → Wire) (sign : Wire)
    (hn : (Q6EndpointCell.ports w sign).wires.Nodup)
    (origin : BasisState) (clean : Q6EndpointCell.Clean w origin) (X Y : Fp)
    (s : State)
    (input : PairFrame (Q6EndpointCell.ports w sign).r (Q6EndpointCell.ports w sign).y
      origin (centerWord X) (centerWord Y) s.basis) :
    (run [.X (Q6EndpointCell.ports w sign).sign] [] s).basis
        (Q6EndpointCell.ports w sign).sign = !origin (Q6EndpointCell.ports w sign).sign ∧
    signedRegValue (Q6EndpointCell.ports w sign).r
        (run [.X (Q6EndpointCell.ports w sign).sign] [] s).basis = centerFp X ∧
    signedRegValue (Q6EndpointCell.ports w sign).y
        (run [.X (Q6EndpointCell.ports w sign).sign] [] s).basis = centerFp Y ∧
    ∀ q ∈ BalancedCircuit.work (Q6EndpointCell.ports w sign),
      (run [.X (Q6EndpointCell.ports w sign).sign] [] s).basis q = false := by
  let L:=Q6EndpointCell.ports w sign
  let u:=run [.X L.sign] [] s
  have hw:=Q6EndpointCell.ports_widths w sign
  have cl:=Q6EndpointCell.clean_work w sign origin clean
  have away:=BalancedCircuit.flagAway L hn L.sign (by simp)
  have sa:L.sign∉L.r ∧ L.sign∉L.y:=
    ⟨fun h=>away (by simp [h]),fun h=>away (by simp [h])⟩
  have us:=BalancedCleanupOffset.x_run L.sign s []
  have uf(q:Wire)(hq:q≠L.sign):u.basis q=s.basis q:=by
    change (run [.X L.sign] [] s).basis q=s.basis q
    rw [us]
    simp only [writeBit,Function.update_of_ne hq]
  have ug:u.basis L.sign= !origin L.sign:=by
    change (run [.X L.sign] [] s).basis L.sign= !origin L.sign
    rw [us]
    simp only [writeBit,Function.update_self,input.2.2 L.sign sa.1 sa.2]
  have uv(r:List Wire)(free:L.sign∉r):regValue r u.basis=regValue r s.basis:=
    regValue_congr _ _ _ (fun q hq=>uf q (fun eq=>free (eq ▸ hq)))
  have ur:signedRegValue L.r u.basis=centerFp X:=by
    rw [signedRegValue,uv L.r sa.1,input.1,(BalancedCleanup.widths L.toLayout hw).2.1,
      centerWord_decode]
  have uy:signedRegValue L.y u.basis=centerFp Y:=by
    rw [signedRegValue,uv L.y sa.2,input.2.1,(BalancedCleanup.widths L.toLayout hw).2.2.1,
      centerWord_decode]
  have uc:∀q∈BalancedCircuit.work L,u.basis q=false:=by
    intro q hq
    have a:=OwnQ6Core5.work_away L hn q hq
    exact (uf q (fun eq=>OwnQ6Core5.sign_work L hn (eq ▸ hq))).trans
      ((input.2.2 q a.1 a.2).trans (cl q hq))
  exact ⟨ug,ur,uy,uc⟩

end HalfInput

/-- The loaned inverse half against the record's delivered 760 half. -/
theorem half760Loan_false_exists (d : Nat) (hd : d ≤ 68) (origin : BasisState)
    (clean : Q6EndpointCell.Clean base origin) (X Y : Fp) (s : State)
    (fresh : List Bool)
    (input : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis) :
    ∃ n, run (StairLoan.half760Loan d false) fresh s =
      run (R2Life760.half760 false) n s := by
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  have F := inv_half_input base (base 2409) hn origin clean X Y s input
  have loanShape : StairLoan.half760Loan d false =
      [Instr.X (base 2409)] ++ (StairLoan.inverseLoan d L760 ++
        ([Instr.X (base 2409)] ++ [Instr.measureX (base 1027) [] []])) := by
    simp only [StairLoan.half760Loan, Bool.false_eq_true, if_false, List.append_assoc]
  have oldShape : R2Life760.half760 false =
      [Instr.X (base 2409)] ++ (Q6LifetimeResearch.inverse (base 760) L760 ++
        ([Instr.X (base 2409)] ++ [Instr.measureX (base 1027) [] []])) := by
    rw [R2Life760.half760_false]
    simp only [Q6LifetimeResearch.half, Bool.false_eq_true, if_false, List.append_assoc]
  rw [loanShape, oldShape]
  refine replace_block_exists _ _ _ _ s fresh ?_
  intro x
  have tape : fresh.take (measurementCount [Instr.X (base 2409)]) = [] := rfl
  rw [tape]
  exact inverseLoan_exists d hd (!origin L760.sign) (centerFp X) (centerFp Y)
    (centerFp_bounds X) (centerFp_bounds Y) _ x F.1 F.2.1 F.2.2.1 F.2.2.2

/-- Field 4 in exact form, for one depth: the positive-depth inverse loaned
half replays the old generic inverse half for every pair of record lists. -/
theorem half760Loan_false_run_eq (d : Nat) (hp : 0 < d) (hd : d ≤ 68)
    (origin : BasisState) (clean : Q6EndpointCell.Clean base origin)
    (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis) :
    run (StairLoan.half760Loan d false) fresh s =
      run (Q6EndpointCell.half false base (base 2409)) old s := by
  obtain ⟨n, h⟩ := half760Loan_false_exists d hd origin clean X Y s fresh input
  rw [h]
  exact R2Life760.half760_run_eq false Rolling1588Lifetime.half_ports_nodup760
    origin clean X Y s n old input

/-- `StairCertificate.PositiveHalfRunSpec false`, unfolded verbatim. -/
theorem positiveHalfRunSpec_false :
    ∀ d, 0 < d → d ≤ 68 → ∀ origin,
      Q6EndpointCell.Clean base origin → ∀ X Y s fresh old,
      PairFrame (Q6EndpointCell.ports base (base 2409)).r
        (Q6EndpointCell.ports base (base 2409)).y origin
        (centerWord X) (centerWord Y) s.basis →
      run (StairLoan.half760Loan d false) fresh s =
        run (Q6EndpointCell.half false base (base 2409)) old s :=
  fun d hp hd origin clean X Y s fresh old input =>
    half760Loan_false_run_eq d hp hd origin clean X Y s fresh old input

end ECDSAAdd.Entrant.StairLoanInverse
end Merge_StairLoanInverseCompose_at_StairSideA

