def packOut (B' : Nat) : List Wire :=
  bSite B' :: cleanList B' ++ (List.range B').map (physicalLayout B').D ++ [(physicalLayout B').S (B' - 1)]
def tickLayout (B : Nat) : List Wire := (W.compactSkywalkTickLayout (segmentMap B) (startFor B)).wires

def midN (B : Nat) : Nat := endFor B - startFor B - 1

/-- Every label the segment's moved walk can touch. -/
def walkSites (B : Nat) : List Wire :=
  tickLayout B ++
    (List.range' (startFor B + 1) (midN B)).flatMap
      (fun j => (W.compactSkywalkTickLayout (wmB B) j).wires) ++
    (List.range' (startFor B + 1) (midN B)).flatMap
      (fun j => if History5.packDue j then (List.finRange 10).map (History5.historyMap (wmB B) (j - 5))
        else [])












/-! ## LT49 (replay budget): the walk label sets as bit-mask literals

`walkSites B` (≈ 5,800 labels: the moved walk's tick layouts) was re-evaluated by the
kernel in every fact (`FactsWork`, `FactsRest`, `FactsScratch`, `FactsFrame`; ≈ 13 s per
evaluation, ≈ 260 s in total).  Its bit mask is now checked once per budget
(`walkMask_eq`) and membership is a `Nat.testBit` on a literal (`mem_walk`); the same for
`futurePayload` (`mem_fp`), and `scratchT` / `ZEnd` are rewritten to their filter
characterisation (`forall_scratchT`, `mem_scratchT`) or literal masks (`mem_ze`,
`StairField2V3Decode.mem_zl`) before `decide`
(`ZEnd 87 62` alone took ≈ 11 s per evaluation). -/




/-- `StairLoan.maskOf (futurePayload B)`, as literals for the six row budgets. -/
def fpMask (B : Nat) : Nat :=
  if B = 87 then
    
  else if B = 62 then
    
  else if B = 47 then
    
  else if B = 32 then
    
  else if B = 22 then
    
  else if B = 12 then
    
  else StairLoan.maskOf (futurePayload B)

theorem fpMask_eq (B : Nat) : StairLoan.maskOf (futurePayload B) = fpMask B := by
  unfold fpMask
  split_ifs with h87 h62 h47 h32 h22 h12
  · subst h87; decide +kernel
  · subst h62; decide +kernel
  · subst h47; decide +kernel
  · subst h32; decide +kernel
  · subst h22; decide +kernel
  · subst h12; decide +kernel
  · rfl

theorem mem_fp (B q : Nat) : q ∈ futurePayload B ↔ (fpMask B).testBit q = true := by
  rw [← fpMask_eq, StairLoan.testBit_maskOf, decide_eq_true_iff]

theorem mem_scratchT (B B' q : Nat) :
    q ∈ scratchT B B' ↔ q ∈ rowSites B ++ rowSites B' ++ allBC ∧ q ∉ futurePayload B := by
  unfold scratchT
  simp only [List.mem_filter, decide_eq_true_eq]


/-- `∀ r ∈ scratchT B B'` over the unfiltered site list, `futurePayload B` on its literal mask
(the kernel never evaluates the quadratic `scratchT` filter). -/
theorem forall_scratchT (B B' : Nat) (P : Nat → Prop) :
    (∀ r ∈ scratchT B B', P r) ↔
      ∀ r ∈ rowSites B ++ rowSites B' ++ allBC, (fpMask B).testBit r = false → P r := by
  constructor
  · intro h r hr hn
    refine h r ((mem_scratchT B B' r).2 ⟨hr, fun m => ?_⟩)
    rw [mem_fp, hn] at m
    exact absurd m (by decide)
  · intro h r hr
    obtain ⟨h1, h2⟩ := (mem_scratchT B B' r).1 hr
    rw [mem_fp] at h2
    exact h r h1 (by simpa using h2)









theorem pairs_cases (B B' : Nat) (h : (B, B') ∈ rowPairs) :
    (B = 87 ∧ B' = 62) ∨ (B = 62 ∧ B' = 47) ∨ (B = 47 ∧ B' = 32) ∨ (B = 32 ∧ B' = 22) ∨
      (B = 22 ∧ B' = 12) := by
  simpa [rowPairs] using h










