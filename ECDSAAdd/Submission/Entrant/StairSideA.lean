/-! ### Kernel-fast forms (`cond` / `Nat.beq` / `Nat.ble` only) -/








theorem kernelPlace_eqB (q : Wire) : kernelPlace q = kernelPlaceB q := by
  rw [kernelPlace_eqN]; unfold kernelPlaceB kernelPlaceN
  simp only [swB_eq, pwB_eq]






theorem hostSwap_eqB (q : Wire) : HostOB5.hostSwap q = swB 2426 1558 (swB 2425 527 q) := by
  simp only [swB_eq]
  unfold HostOB5.hostSwap sw
  show (if q = 2425 then 527 else if q = 527 then 2425 else if q = 2426 then 1558
    else if q = 1558 then 2426 else q : Nat) = _
  split_ifs <;> omega

theorem wireFn2_eqB (q : Wire) : wireFn2 layout q = pwB (swB 785 1813 q - 16) := by
  rw [wireFn2_eqN]; simp only [swB_eq, pwB_eq]

/-- The finite-stage map `Wrapper5.U`, kernel-fast. -/
def uB (q : Nat) : Nat := swB 4799 4832 q

theorem U_eqB (q : Wire) : Wrapper5.U layout q = uB q := by
  rw [U_eqN]; unfold uB; rw [swB_eq]

def rhoB (q : Nat) : Nat :=
  swB 9815 5655 (swB 4112 4799 (swB 4113 9814 (swB 4799 4832 (swB 1 5515 q))))

theorem rho_eqB (q : Wire) : rho layout q = rhoB q := by
  rw [rho_eqN]; unfold rhoB; simp only [swB_eq]

/-- The generic-block map (`U ∘ swap doubleSelect control ∘ rho`), kernel-fast. -/
def ugB (q : Nat) : Nat := swB 4799 4832 (swB 9815 0 (rhoB q))

theorem ug_eqB (q : Wire) :
    Wrapper5.U layout ((Equiv.swap layout.doubleSelect layout.control) (rho layout q)) = ugB q := by
  rw [U_eqN, swap_eq_sw, rho_eqB]; unfold ugB; simp only [swB_eq]; rfl


