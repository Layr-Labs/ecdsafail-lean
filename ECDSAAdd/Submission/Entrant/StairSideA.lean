/-!
# LT21: record packet groups avoid the future payload of every v3 row

The difference set of the field-2 chain at a v3 row of budget `B` is the
future packet payload `StairPhysicalLayout.futurePayload B` (letters
`startFor B .. 510`, payload `s` letters of packets `≥ startFor B / 5`, and
`g 510`), which holds the compact checkpoint in the staircase and the
encoded future packets in the record.  This module proves that every record
packet group of a packet `< startFor B / 5` avoids it
(`groups_avoid_payload`), from the record's own support chain
`Rolling1588.packet ⊆ ControlLoan1589.packet ⊆ FrontierSW1591.packetS =
OneFlagSW.packetS ⊆ OneFlagReplay.packet ⊆ Q6EndpointReplay.packet` and the
placement `Placement5.pi j` (body work goes to holes or the two spares,
never to payload sites).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Groups

open ECDSAAdd Arithmetic Challenge
open MappedCompressed
open StairPhysicalLayout



/-! ## Placement of a packet's own sites -/

def cellIds : List Nat := 2409 :: 2400 :: 2410 :: 717 :: 718 :: Q6EndpointCell.ids

theorem cells_not_hole : ∀ i ∈ Q6EndpointCell.ids, ¬ Placement5.holeRegion i := by
  decide +kernel

theorem fixed_not_hole : ¬ Placement5.holeRegion 2409 ∧ ¬ Placement5.holeRegion 2400 ∧
    ¬ Placement5.holeRegion 2410 := by
  decide +kernel

theorem pi_cases (k i : Nat) (hk : k < 102) (hi : ¬ Placement5.holeRegion i) :
    Placement5.pi k i = i ∨ Placement5.holeRegion (Placement5.pi k i) ∨
      Placement5.pi k i = 717 ∨ Placement5.pi k i = 718 := by
  by_cases work : Placement5.workRegion i
  · have hk' : i - 515 < 204 := by unfold Placement5.workRegion at work; omega
    have eq : i = Placement5.W (i - 515) := by
      unfold Placement5.W
      unfold Placement5.workRegion at work
      omega
    rw [eq]
    by_cases e : i - 515 = 2 * k
    · rw [e, Placement5.pi_selected_even k hk]
      right; right; left; rfl
    · by_cases o : i - 515 = 2 * k + 1
      · rw [o, Placement5.pi_selected_odd k hk]
        right; right; right; rfl
      · rw [Placement5.pi_other k _ hk hk' e o]
        right; left
        exact Placement5.H_region _ hk'
  · left
    exact Placement5.pi_outside k i hk (fun h => h.elim work hi)

/-! ## Decidable facts per row -/


/-- K4 (replay budget): `StairLoan.maskOf (futurePayload B)` as literals for the six row budgets
(the same literals as `StairField2V3SegFacts.fpMask`, which sits downstream of this module); the
row checks below test bits of a literal instead of re-evaluating the mask. -/
def fpMaskG (B : Nat) : Nat :=
  if B = 87 then
    
  else if B = 62 then
    
  else if B = 47 then
    
  else if B = 32 then
    
  else if B = 22 then
    
  else if B = 12 then
    
  else StairLoan.maskOf (futurePayload B)

theorem fpMaskG_eq (B : Nat) : StairLoan.maskOf (futurePayload B) = fpMaskG B := by
  unfold fpMaskG
  split_ifs with h87 h62 h47 h32 h22 h12
  · subst h87; decide +kernel
  · subst h62; decide +kernel
  · subst h47; decide +kernel
  · subst h32; decide +kernel
  · subst h22; decide +kernel
  · subst h12; decide +kernel
  · rfl

theorem mem_fpG (B q : Nat) : q ∈ futurePayload B ↔ (fpMaskG B).testBit q = true := by
  rw [← fpMaskG_eq, StairLoan.testBit_maskOf, decide_eq_true_iff]

/-- K4: `OB5.sig 511` with `Nat.ble` tests only. -/
def sigG (q : Nat) : Nat :=
  if (Nat.ble 1301 q && Nat.ble q 1555) || (Nat.ble 1558 q && Nat.ble q 1812) then 3113 - q else q

theorem sigG_eq (q : Nat) : sigG q = OB5.sig 511 q := by
  unfold sigG OB5.sig
  by_cases h : 1301 ≤ q ∧ q ≤ 1044 + 511 ∨ 2069 ≤ q + 511 ∧ q ≤ 1812
  · rw [if_pos h, if_pos]
    simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]; omega
  · rw [if_neg h, if_neg]
    simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]; omega

/-- K4: `Placement5.pi0` with `Nat.ble` / `Nat.beq` tests only. -/
def pi0K (q : Nat) : Nat :=
  bif Nat.ble 515 q && Nat.ble q 718 then Placement5.H (q - 515)
  else bif Nat.ble 1030 q && Nat.ble q 1537 &&
      (Nat.beq ((q - 1030) % 5) 0 || Nat.beq ((q - 1030) % 5) 2) then
    Placement5.W (Placement5.holeIndex q)
  else q

theorem pi0K_eq (q : Nat) : Placement5.pi0 q = pi0K q := by
  unfold pi0K
  by_cases hw : Placement5.workRegion q
  · have hk : q - 515 < 204 := by unfold Placement5.workRegion at hw; omega
    have e : q = Placement5.W (q - 515) := by
      unfold Placement5.W; unfold Placement5.workRegion at hw; omega
    rw [show (Nat.ble 515 q && Nat.ble q 718) = true by
      unfold Placement5.workRegion at hw
      simp only [Bool.and_eq_true, Nat.ble_eq]; omega, cond_true]
    calc Placement5.pi0 q = Placement5.pi0 (Placement5.W (q - 515)) := by rw [← e]
      _ = Placement5.H (q - 515) := Placement5.pi0_W _ hk
  · rw [show (Nat.ble 515 q && Nat.ble q 718) = false by
      unfold Placement5.workRegion at hw
      rw [Bool.eq_false_iff]
      simp only [ne_eq, Bool.and_eq_true, Nat.ble_eq]; omega, cond_false]
    by_cases hh : Placement5.holeRegion q
    · have hr := Placement5.hole_recover q hh
      rw [show (Nat.ble 1030 q && Nat.ble q 1537 &&
          (Nat.beq ((q - 1030) % 5) 0 || Nat.beq ((q - 1030) % 5) 2)) = true by
        unfold Placement5.holeRegion at hh
        simp only [Bool.and_eq_true, Bool.or_eq_true, Nat.ble_eq, Nat.beq_eq]; omega, cond_true]
      calc Placement5.pi0 q = Placement5.pi0 (Placement5.H (Placement5.holeIndex q)) := by
            rw [hr.2]
        _ = Placement5.W (Placement5.holeIndex q) := Placement5.pi0_H _ hr.1
    · rw [show (Nat.ble 1030 q && Nat.ble q 1537 &&
          (Nat.beq ((q - 1030) % 5) 0 || Nat.beq ((q - 1030) % 5) 2)) = false by
        unfold Placement5.holeRegion at hh
        rw [Bool.eq_false_iff]
        simp only [ne_eq, Bool.and_eq_true, Bool.or_eq_true, Nat.ble_eq, Nat.beq_eq]; omega, cond_false]
      exact Placement5.pi0_outside q (fun h => h.elim hw hh)

/-- K4: `Placement5.pi j` as plain `if`s (no `Equiv` coercions). -/
def swK (a b x : Nat) : Nat := bif Nat.beq x a then b else bif Nat.beq x b then a else x

theorem swK_eq (a b x : Nat) : Equiv.swap a b x = swK a b x := by
  rw [Equiv.swap_apply_def]
  unfold swK
  cases h1 : Nat.beq x a with
  | true => rw [if_pos (Nat.eq_of_beq_eq_true h1)]; rfl
  | false =>
    rw [if_neg (Nat.ne_of_beq_eq_false h1)]
    cases h2 : Nat.beq x b with
    | true => rw [if_pos (Nat.eq_of_beq_eq_true h2)]; rfl
    | false => rw [if_neg (Nat.ne_of_beq_eq_false h2)]; rfl

def piK (j q : Nat) : Nat :=
  pi0K (swK (Placement5.H (2 * j + 1)) (Placement5.H 203)
    (swK (Placement5.H (2 * j)) (Placement5.H 202)
      (swK (Placement5.W (2 * j + 1)) (Placement5.H (2 * j + 1))
        (swK (Placement5.W (2 * j)) (Placement5.H (2 * j)) q))))

theorem piK_eq (j q : Nat) : Placement5.pi j q = piK j q := by
  unfold piK
  rw [← pi0K_eq]
  simp only [Placement5.pi, Equiv.trans_apply, swK_eq]

/-- K4: all bits `a .. a + n - 1` of `M` are clear. -/
theorem k4_bits_zero (M a n : Nat) (h : (M >>> a) % 2 ^ n = 0) :
    ∀ q, a ≤ q → q < a + n → M.testBit q = false := by
  intro q h1 h2
  have t := congrArg (fun x => x.testBit (q - a)) h
  simp only [Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, Nat.zero_testBit] at t
  rw [show a + (q - a) = q by omega] at t
  simpa [show q - a < n by omega] using t

/-- K4: the history check of one budget.  The even history ids `5 k + r / 2` lie below 512, where the
placement and `OB5.sig 511` are the identity, so they form one bit range `16 .. 16 + startFor B - 1`
(one shift-and-mod test); only the odd ids `1028 + 5 k + r / 2` are checked one by one. -/
def histK (B : Nat) : Bool :=
  Nat.beq ((fpMaskG B >>> 16) % 2 ^ (5 * (startFor B / 5))) 0 &&
    (List.range (startFor B / 5)).all (fun k => (List.range 5).all (fun j =>
      !(fpMaskG B).testBit (sigG (base (piK k (1028 + 5 * k + j))))))

theorem hist_of (B : Nat) (h : histK B = true) : ∀ k, k < startFor B / 5 → ∀ r : Fin 10,
    OB5.sig 511 (base (Placement5.pi k (History5.historyId (5 * k) r))) ∉ futurePayload B := by
  intro k hk r hm
  unfold histK at h
  simp only [Bool.and_eq_true, Nat.beq_eq] at h
  obtain ⟨hlow, hhigh⟩ := h
  have k102 : k < 102 := by unfold startFor at hk; omega
  have hr := r.isLt
  rw [mem_fpG] at hm
  by_cases ev : r.val % 2 = 0
  · have e1 : History5.historyId (5 * k) r = 5 * k + r.val / 2 := by
      unfold History5.historyId; rw [if_pos ev]
    have e2 : Placement5.pi k (5 * k + r.val / 2) = 5 * k + r.val / 2 :=
      Placement5.pi_outside k _ k102 (by
        unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega)
    have e3 : OB5.sig 511 (base (5 * k + r.val / 2)) = 5 * k + r.val / 2 + 16 := by
      rw [← sigG_eq]
      unfold sigG
      rw [if_neg (by simp only [base, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]; omega)]
      rfl
    rw [e1, e2, e3] at hm
    rw [k4_bits_zero _ _ _ hlow (5 * k + r.val / 2 + 16) (by omega) (by omega)] at hm
    exact absurd hm (by decide)
  · have e1 : History5.historyId (5 * k) r = 1028 + 5 * k + r.val / 2 := by
      unfold History5.historyId; rw [if_neg ev]
    have h1 := List.all_eq_true.mp hhigh k (List.mem_range.mpr hk)
    have h2 := List.all_eq_true.mp h1 (r.val / 2) (List.mem_range.mpr (by omega))
    rw [e1, ← sigG_eq, piK_eq] at hm
    rw [hm] at h2
    exact absurd h2 (by decide)

/-- K4: the cell ids outside the three long runs. -/
def cellSingles : List Nat :=
  [2409, 2400, 2410, 717, 718, 765, 768, 767, 766, 2312, 1797, 1027, 2311, 1025, 2056, 1540, 1541, 1026]

theorem cellIds_cover : ∀ m ∈ cellIds, m ∈ cellSingles ∨ (2057 ≤ m ∧ m < 2311) ∨
    (770 ≤ m ∧ m < 1025) ∨ (512 ≤ m ∧ m < 765) := by
  intro m hm
  simp only [cellIds, Q6EndpointCell.ids, List.mem_cons, List.mem_append, List.mem_range'_1,
    List.not_mem_nil, or_false] at hm
  simp only [cellSingles, List.mem_cons, List.not_mem_nil, or_false]
  omega

/-- K4: the cell check of one budget: three bit-range tests and 18 single ids. -/
def cellsK (B : Nat) : Bool :=
  Nat.beq ((fpMaskG B >>> 2073) % 2 ^ 254) 0 && Nat.beq ((fpMaskG B >>> 786) % 2 ^ 255) 0 &&
    Nat.beq ((fpMaskG B >>> 528) % 2 ^ 253) 0 &&
    cellSingles.all (fun m => !(fpMaskG B).testBit (sigG (base m)))

theorem cells_of (B : Nat) (h : cellsK B = true) : ∀ m ∈ cellIds,
    OB5.sig 511 (base m) ∉ futurePayload B := by
  intro m hmem hm
  unfold cellsK at h
  simp only [Bool.and_eq_true, Nat.beq_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  rw [mem_fpG, ← sigG_eq] at hm
  rcases cellIds_cover m hmem with hs | hr | hr | hr
  · have h5 := List.all_eq_true.mp h4 m hs
    rw [hm] at h5
    exact absurd h5 (by decide)
  all_goals
    have e : sigG (base m) = m + 16 := by
      unfold sigG
      rw [if_neg (by simp only [base, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]; omega)]
      rfl
    rw [e] at hm
  · rw [k4_bits_zero _ _ _ h1 (m + 16) (by omega) (by omega)] at hm; exact absurd hm (by decide)
  · rw [k4_bits_zero _ _ _ h2 (m + 16) (by omega) (by omega)] at hm; exact absurd hm (by decide)
  · rw [k4_bits_zero _ _ _ h3 (m + 16) (by omega) (by omega)] at hm; exact absurd hm (by decide)

/-- K4: the hole check of one budget. -/
def holesK (B : Nat) : Bool :=
  (List.range 204).all (fun h => !(fpMaskG B).testBit (sigG (base (Placement5.H h))))

theorem holes_of (B : Nat) (h : holesK B = true) : ∀ h, h < 204 →
    OB5.sig 511 (base (Placement5.H h)) ∉ futurePayload B := by
  intro x hx hm
  have h1 := List.all_eq_true.mp h x (List.mem_range.mpr hx)
  rw [mem_fpG, ← sigG_eq] at hm
  rw [hm] at h1
  exact absurd h1 (by decide)

theorem cells_avoid : ∀ B ∈ budgets, ∀ m ∈ cellIds,
    OB5.sig 511 (base m) ∉ futurePayload B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact cells_of _ (by decide +kernel)

theorem holes_avoid : ∀ B ∈ budgets, ∀ h, h < 204 →
    OB5.sig 511 (base (Placement5.H h)) ∉ futurePayload B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact holes_of _ (by decide +kernel)

theorem history_avoid : ∀ B ∈ budgets, ∀ k, k < startFor B / 5 → ∀ r : Fin 10,
    OB5.sig 511 (base (Placement5.pi k (History5.historyId (5 * k) r))) ∉ futurePayload B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals exact hist_of _ (by decide +kernel)

theorem start_bound : ∀ B ∈ budgets, startFor B / 5 ≤ 100 := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

/-! ## One placed packet -/

theorem placed_cell_avoid (B : Nat) (hB : B ∈ budgets) (k : Nat) (hk : k < 102) (i : Nat)
    (hi : ¬ Placement5.holeRegion i) (hc : i ∈ cellIds) :
    OB5.sig 511 (base (Placement5.pi k i)) ∉ futurePayload B := by
  rcases pi_cases k i hk hi with h | h | h | h
  · rw [h]; exact cells_avoid B hB i hc
  · have hrec := Placement5.hole_recover _ h
    rw [← hrec.2]
    exact holes_avoid B hB _ hrec.1
  · rw [h]; exact cells_avoid B hB 717 (by simp [cellIds])
  · rw [h]; exact cells_avoid B hB 718 (by simp [cellIds])

set_option linter.constructorNameAsVariable false in
theorem packet_avoid_payload (divide : Bool) (B : Nat) (hB : B ∈ budgets) (k : Nat)
    (hk : k < startFor B / 5) :
    ∀ r ∈ futurePayload B, r ∉ wires (renameProgram (OB5.sig 511) (Rolling1588.packet divide k)) := by
  intro r hr hw
  have k102 : k < 102 := by have := start_bound B hB; omega
  rw [renameProgram_support] at hw
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hw
  have h1 := Rolling1588.packet_old_support divide k k102 hq
  have h2 := ControlLoan1589.packet_support divide k k102 h1
  rw [FrontierSW1591.packet_support_eq] at h2
  have h3 := (OneFlagSW.selPacket_sel divide k k102).sub.wires_sub h2
  have h4 := OneFlagReplay.packet_subset_old divide k h3
  unfold Q6EndpointReplay.packet at h4
  rw [renameProgram_support] at h4
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp h4
  have hist : ∀ i : Fin 10, x = History5.historyMap base (5 * k) i → False := by
    intro i hxi
    subst hxi
    apply history_avoid B hB k hk i
    simpa only [History5.historyMap, shifted_base] using hr
  have cell : ∀ i, x = base i → ¬ Placement5.holeRegion i → i ∈ cellIds → False := by
    intro i hxi hi hc
    subst hxi
    apply placed_cell_avoid B hB k k102 i hi hc
    simpa only [shifted_base] using hr
  simp only [Q6EndpointReplay.basePacket, wires_append, Finset.mem_union] at hx
  rcases hx with (hdec | hbody) | henc
  · obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * k) _ (Or.inr rfl) x hdec
    exact hist i hi
  · have hs := Q6EndpointReplay.body_support divide k k102 hbody
    simp only [Q6EndpointReplay.readSites, Q6EndpointReplay.fieldSites, Finset.mem_union,
      List.mem_toFinset, List.mem_cons, List.mem_map, Finset.mem_insert,
      Finset.mem_singleton] at hs
    rcases hs with ((h2409 | ⟨i, hi, hxi⟩) | (h2400 | h2410)) | henc
    · exact cell 2409 h2409 fixed_not_hole.1 (by simp [cellIds])
    · exact cell i hxi.symm (cells_not_hole i hi) (by simp [cellIds, hi])
    · exact cell 2400 h2400 fixed_not_hole.2.1 (by simp [cellIds])
    · exact cell 2410 h2410 fixed_not_hole.2.2 (by simp [cellIds])
    · obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * k) _ (Or.inl rfl) x henc
      exact hist i hi
  · obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * k) _ (Or.inl rfl) x henc
    exact hist i hi

/-! ## Packet groups -/

theorem rename_append' (f : Wire → Wire) (a b : Program) :
    renameProgram f (a ++ b) = renameProgram f a ++ renameProgram f b := by
  simp only [renameProgram, List.map_append]

/-- K4-B (build time): one step of a packet sequence, for an arbitrary packet family `p`
(no concrete program is ever compared or unfolded). -/
theorem kbSeq_step (f : Wire → Wire) (p : Nat → Program) (fw : Bool) (j n : Nat) (r : Wire)
    (h : r ∈ wires (renameProgram f (PacketSequence.program fw p j (n + 1)))) :
    r ∈ wires (renameProgram f (p j)) ∨
      r ∈ wires (renameProgram f (PacketSequence.program fw p (j + 1) n)) := by
  cases fw
  · simp only [PacketSequence.program, Bool.false_eq_true, if_false, rename_append',
      wires_append, Finset.mem_union] at h
    exact h.symm
  · simp only [PacketSequence.program, if_true, rename_append', wires_append,
      Finset.mem_union] at h
    exact h

set_option linter.constructorNameAsVariable false in
theorem groups_avoid_payload (divide : Bool) (B : Nat) (hB : B ∈ budgets) :
    ∀ n j, j + n ≤ startFor B / 5 →
      ∀ r ∈ futurePayload B,
        r ∉ wires (renameProgram (OB5.sig 511) (Rolling1588.groups divide j n)) := by
  intro n
  induction n with
  | zero =>
      intro j _ r _ hw
      simp [Rolling1588.groups, PacketSequence.program, renameProgram, wires] at hw
  | succ n ih =>
      intro j hj r hr hw
      have head := packet_avoid_payload divide B hB j (by omega) r hr
      have rest := ih (j + 1) (by omega) r hr
      -- K4-B (build time): split through the generic `kbSeq_step`
      rcases kbSeq_step (OB5.sig 511) (Rolling1588.packet divide) divide j n r hw with h | h
      · exact head h
      · exact rest h

end ECDSAAdd.Entrant.StairField2V3Groups

end
end Merge_StairField2V3Groups_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairPhysicalPrimitives_at_StairSideA` -/
section Merge_StairPhysicalPrimitives_at_StairSideA

/-!
# Physical primitive provider for the omittable-44 staircase

The checkpoint codec, its sign extension and rest relocation, the first
moved tick, and the moved middle segments, all placed by
`StairPhysicalLayout`.  `physicalPrimitives_good` proves that every wire of
every primitive of every row is a good site: its final placement is in the
record arena and is neither one of the 15 old omissions nor one of the 44 new
omissions.  This is the moved-segment/codec part of the final `insideArena`,
`oldFree`, and `newFree` obligations.

The packet writes inside a moved segment are bounded exactly by their ten
history wires (`MeasuredCodec5.support_exact`), not by the whole Skywalk pool.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairPhysicalPrimitives

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairOuterPlacement StairPhysicalInventory StairPhysicalLayout

/-! ## Exact packet support -/





/-! ## Fine support of moved segments -/





/-! ## Middle-segment map

The first moved tick reads its previous letter from a zero wire (`segmentMap`).
The middle ticks never touch that id, but the record stage invariant used by
the middle replay (`Rolling1588.Integer.Stage`) locates the last record packet
through it, so the middle map sends `start - 1` to the real letter
`base (start - 1)` (LT14 audit item H). -/









/- LT6 (benchmark replay budget): the unreferenced `midSegmentMap_previous`
(`∀ B ∈ budgets, midSegmentMap B (startFor B - 1) = base (startFor B - 1)`, six
`decide +kernel`, ≈ 150 s — LT27 profile b14) is omitted; restore it from
