      gateSlots (PacketSequence.program divide P first n) +
        gateSlots (PacketSequence.program divide P (first + n) m) := by
  induction n generalizing first with
  | zero => simp [PacketSequence.program, gateSlots]
  | succ n ih =>
      cases divide <;>
        simp only [Nat.succ_add, Nat.add_one, PacketSequence.program,
          Bool.false_eq_true, if_false, if_true, gateSlots_append, ih] <;>
        rw [show (first + n).succ = first + n.succ by omega] <;>
        omega

theorem groups_slots_add (divide : Bool) (first n m : Nat) :
    gateSlots (Rolling1588.groups divide first (n + m)) =
      gateSlots (Rolling1588.groups divide first n) +
        gateSlots (Rolling1588.groups divide (first + n) m) := by
  simpa only [Rolling1588.groups] using
    packetSequence_slots_add divide (Rolling1588.packet divide) first n m

