/-! ## Keeping and resetting -/

/-- `P` keeps `w` zero. -/
def Keeps (w : Wire) (P : Program) : Prop := zt w true P = true



theorem keeps_append {w : Wire} {A B : Program} (ha : Keeps w A) (hb : Keeps w B) :
    Keeps w (A ++ B) := by
  unfold Keeps at *
  rw [zt_append, ha, hb]



theorem keeps_nil (w : Wire) : Keeps w [] := rfl

theorem keeps_of_not_mem {w : Wire} {P : Program} (h : w ∉ wires P) : Keeps w P :=
  zt_of_not_mem w P true h

/-- Renaming by a map whose only preimage of `w` is `w`. -/
theorem zt_rename_pre (f : Wire → Wire) (w : Wire) (hf : ∀ q, f q = w ↔ q = w) :
    ∀ (P : Program) (b : Bool), zt w b (renameProgram f P) = zt w b P := by
  intro P
  induction P with
  | nil => intro b; rfl
  | cons i p ih =>
    intro b
    simp only [renameProgram, List.map_cons] at ih ⊢
    simp only [zt, tgt_rename, isMeas_rename, hf]
    split <;> exact ih _

theorem pre_of_inj (f : Wire → Wire) (hf : Function.Injective f) (w : Wire) (hw : f w = w) :
    ∀ q, f q = w ↔ q = w := by
  intro q
  constructor
  · intro e; exact hf (e.trans hw.symm)
  · intro e; rw [e, hw]


theorem keeps_rename (f : Wire → Wire) {w : Wire} (hf : ∀ q, f q = w ↔ q = w) {P : Program}
    (h : Keeps w P) : Keeps w (renameProgram f P) := by
  unfold Keeps at *; rw [zt_rename_pre f w hf]; exact h



