namespace ECDSAAdd.Entrant.HighBankShift
open Arithmetic

/-- Emitted CX a b, CCX c b a, CX a b moves a to b on the enabled branch. -/
def program (c : Wire) (w : Nat → Wire) (d : Nat) : Nat → Program
  | 0 => []
  | n+1 => cswap c (w (n+d)) (w n) ++ program c w d n

theorem counts (c : Wire) (w : Nat → Wire) (d n : Nat) :
    toffoliCount (program c w d n) = n ∧ measurementCount (program c w d n) = 0 := by
  induction n with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    simp only [program,toffoliCount_append,measurementCount_append]
    change 1+_=_ ∧ 0+_=_
    omega

private theorem step (c : Wire) (w : Nat → Wire) (d n : Nat) (m : List Bool) (s : State) :
    run (program c w d (n+1)) m s =
    run (program c w d n) m (run (cswap c (w (n+d)) (w n)) m s) := by
  rw [program,run_append,run_take]
  rfl

structure Layout (c : Wire) (w : Nat → Wire) (len : Nat) : Prop where
  injective : ∀ i < len, ∀ j < len, w i = w j → i = j
  separate : ∀ i < len, c ≠ w i

private theorem Layout.prefix {c w a b} (L : Layout c w b) (h : a ≤ b) : Layout c w a :=
  ⟨fun i hi j hj => L.injective i (by omega) j (by omega), fun i hi => L.separate i (by omega)⟩

private theorem distinct {c w n d} (L : Layout c w (n+1+d)) (hd : 0<d) :
    [c,w (n+d),w n].Nodup := by
  have h : w (n+d) ≠ w n := fun eq => by
    have := L.injective (n+d) (by omega) n (by omega) eq
    omega
  simp [L.separate (n+d) (by omega), L.separate n (by omega),h]

theorem physical {c w d n} (L : Layout c w (n+d)) (hd : 0<d) :
    GatePhysical (program c w d n) := by
  induction n with
  | zero => simp [program,GatePhysical]
  | succ n ih =>
    exact (gatePhysical_append _ _).mpr ⟨cswap_physical _ _ _ (distinct L hd), ih (L.prefix (by omega))⟩

theorem frame {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (m : List Bool) :
    (run (program c w d n) m s).phase=s.phase ∧
    ∀ q, (∀ i<n+d, q≠w i) → (run (program c w d n) m s).basis q=s.basis q := by
  induction n generalizing s with
  | zero => exact ⟨rfl,fun _ _ => rfl⟩
  | succ n ih =>
    rw [step]
    obtain ⟨hp,he,_,_⟩ := cswap_correct _ _ _ (distinct L hd) s m
    obtain ⟨ip,ie⟩ := ih (L.prefix (by omega)) (run (cswap c (w (n+d)) (w n)) m s)
    exact ⟨ip.trans hp,fun q hout => (ie q (fun i hi => hout i (by omega))).trans
      (he q (hout (n+d) (by omega)) (hout n (by omega)))⟩

theorem disabled {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (m : List Bool)
    (hc : s.basis c = false) : run (program c w d n) m s = s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [step]
    obtain ⟨hp,he,ha,hb⟩ := cswap_correct _ _ _ (distinct L hd) s m
    have same : run (cswap c (w (n+d)) (w n)) m s = s := by
      apply congrArg₂ State.mk hp
      funext q
      by_cases hq : q=w (n+d)
      · subst q; simpa only [hc,Bool.false_eq_true,if_false] using ha
      by_cases hj : q=w n
      · subst q; simpa only [hc,Bool.false_eq_true,if_false] using hb
      exact he q hq hj
    rw [same]
    exact ih (L.prefix (by omega))

theorem enabled {c w d n} (L : Layout c w (n+d)) (hd : 0<d) (s : State) (m : List Bool)
    (hc : s.basis c = true) (clean : ∀ i : Nat, n ≤ i → i < n + d → s.basis (w i)=false) :
    ∀ j<n+d, (run (program c w d n) m s).basis (w j) =
      if j<d then false else s.basis (w (j-d)) := by
  induction n generalizing s with
  | zero =>
    intro j hj
    rw [if_pos (show j<d by omega)]
    exact clean j (by omega) hj
  | succ n ih =>
    let t := run (cswap c (w (n+d)) (w n)) m s
    obtain ⟨_,he,ha,hb⟩ := cswap_correct _ _ _ (distinct L hd) s m
    have far : t.basis (w (n+d))=s.basis (w n) := by simpa only [hc,if_true] using ha
    have cleared : t.basis (w n)=false := by
      simpa only [hc,if_true,clean (n+d) (by omega) (by omega)] using hb
    have keep (i : Nat) (hi : i<n+1+d) (h₁ : i≠n+d) (h₂ : i≠n) : t.basis (w i)=s.basis (w i) :=
      he (w i) (fun eq => h₁ (L.injective _ hi _ (by omega) eq))
        (fun eq => h₂ (L.injective _ hi _ (by omega) eq))
    have tc := (he c (L.separate _ (by omega)) (L.separate _ (by omega))).trans hc
    have smaller := L.prefix (show n+d≤n+1+d by omega)
    have lower := ih smaller t tc (by
      intro i lo hi
      by_cases h : i=n
      · simpa [h] using cleared
      exact (keep i (by omega) (by omega) h).trans (clean _ (by omega) (by omega)))
    intro j hj
    rw [step]
    change (run (program c w d n) m t).basis (w j) = _
    by_cases h : j<n+d
    · rw [lower j h]
      split_ifs with small
      · rfl
      exact keep (j-d) (by omega) (by omega) (by omega)
    have top : j=n+d := by omega
    subst j
    have untouched := (frame smaller hd t m).2 (w (n+d)) (fun i hi eq => by
      have := L.injective (n+d) (by omega) i (by omega) eq
      omega)
    simpa only [if_neg (show ¬ n+d<d by omega), Nat.add_sub_cancel] using untouched.trans far

end ECDSAAdd.Entrant.HighBankShift

