/-!
# Field 13 on v3: every logical packet group keeps the 44 roles zero (LT29)

For a role `w` (exclusive site, raw window `[736, 781)`) and every group used
by the two logical kernels, `zt w true (group) = true`: roles below the
deficit are outside the loaned half (field 5, `wholeHalfSupport`), the others
are reset by the half's own measurements (kernel checks `chk_half_*`); every
other packet component keeps them (`chk_keep_*`), and all renamings fix them.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed
open StairField13V3

/-! ## Keeping and resetting -/


/-- `P` resets `w` to zero. -/
def Resets (w : Wire) (P : Program) : Prop := zt w false P = true

theorem Resets.keeps {w : Wire} {P : Program} (h : Resets w P) : Keeps w P :=
  zt_mono w P true h








theorem pre_swap (a b w : Wire) (ha : a ≠ w) (hb : b ≠ w) :
    ∀ q, Equiv.swap a b q = w ↔ q = w :=
  pre_of_inj _ (Equiv.injective _) w (Equiv.swap_apply_of_ne_of_ne (Ne.symm ha) (Ne.symm hb))


theorem resets_rename (f : Wire → Wire) {w : Wire} (hf : ∀ q, f q = w ↔ q = w) {P : Program}
    (h : Resets w P) : Resets w (renameProgram f P) := by
  unfold Resets at *; rw [zt_rename_pre f w hf]; exact h

/-- A program none of whose instructions writes `w` keeps it. -/
theorem keeps_of_tgt {w : Wire} : ∀ {P : Program}, (∀ i ∈ P, tgt i ≠ w) → Keeps w P := by
  intro P
  induction P with
  | nil => intro _; rfl
  | cons i p ih =>
    intro h
    unfold Keeps at ih ⊢
    simp only [zt, if_neg (h i (by simp))]
    exact ih (fun x hx => h x (by simp [hx]))

/-! ## Roles -/





theorem resets_of_ztAll {ws : List Wire} {P : Program}
    (h : ztAll 736 45 false ws P = true) (hr : ∀ w ∈ ws, w ∈ StairSchedule.exclusiveRoles) :
    ∀ w ∈ ws, Resets w P :=
  zt_of_ztAll 736 45 false ws P (fun w hw => roles_window w (hr w hw)) h

theorem historySite_out (j : Nat) (hj : j < 102) (k : Fin 10) :
    History5.historyId (5 * j) k + 16 < 736 ∨ 781 ≤ History5.historyId (5 * j) k + 16 := by
  have key : ∀ (jj kk : Nat), jj < 102 → kk < 10 →
      (5 * jj + kk / 2 + 16 < 736 ∨ 781 ≤ 5 * jj + kk / 2 + 16) ∧
      (1028 + 5 * jj + kk / 2 + 16 < 736 ∨ 781 ≤ 1028 + 5 * jj + kk / 2 + 16) := by
    intro jj kk h1 h2
    omega
  have hk := key j k.val hj k.isLt
  unfold History5.historyId
  split
  · exact hk.1
  · exact hk.2

theorem label_pre (j : Nat) (hj : j < 102) (w : Wire) (hw : InWin w) :
    ∀ q, MeasuredCodec5.label (History5.historyMap base (5 * j)) q = w ↔ q = w := by
  intro q
  unfold MeasuredCodec5.label
  split
  · rename_i hq
    have ne : History5.historyMap base (5 * j) ⟨q, hq⟩ ≠ w :=
      wne (historySite_out j hj ⟨q, hq⟩) hw
    have small : ∀ x : Nat, x < 10 → x < 736 ∨ 781 ≤ x := by intro x hx; omega
    have ne2 : q ≠ w := wne (small q hq) hw
    exact ⟨fun e => absurd e ne, fun e => absurd e ne2⟩
  · exact Iff.rfl

theorem keeps_onPacket (j : Nat) (hj : j < 102) {w : Wire} (hw : InWin w) {P : Program}
    (h : Keeps w P) : Keeps w (Rolling1588.onPacket j P) :=
  keeps_rename _ (label_pre j hj w hw) h

/-! ## Halves, cells, packets -/

theorem half_keeps (divide : Bool) (d : Nat) (hd : d ≤ 44)
    (hres : ∀ w ∈ StairSchedule.exclusiveRoles.drop d, Resets w (StairLoan.half760Loan d divide)) :
    ∀ w ∈ StairSchedule.exclusiveRoles, Keeps w (StairLoan.half760Loan d divide) := by
  intro w hw
  have split := List.take_append_drop d StairSchedule.exclusiveRoles
  rw [← split] at hw
  rcases List.mem_append.mp hw with ht | hdr
  · apply keeps_of_not_mem
    intro hm
    have sup := StairLoanSupport.wholeHalfSupport divide d (by omega) hm
    have hn := (Finset.mem_sdiff.mp sup).2
    have e : StairSchedule.exclusiveRoles.take d = StairLoan.retiredRoles.take d := by
      rw [← chk_retired_take, List.take_take]
      congr 1
      omega
    apply hn
    rw [List.mem_toFinset, ← e]
    exact ht
  · exact (hres w hdr).keeps

theorem halfWindow_keeps (divide : Bool) (d j a h : Nat) (hj : j < 102) (ha : a < 5) (hh : h < 5)
    {w : Wire} (hw : InWin w) (half : Keeps w (StairLoan.half760Loan d divide)) :
    Keeps w (StairGroups.halfWindow divide d j a h) := by
  have ng : Rolling1588.g j a ≠ w :=
    wne (by left; simp only [Rolling1588.g, base]; omega) hw
  have nf : (base 2409 : Wire) ≠ w := wne (by right; simp only [base]; omega) hw
  have nc : Rolling1588.packetCarry j ≠ w :=
    wne (by left; simp only [Rolling1588.packetCarry, base]; omega) hw
  have n719 : (base 719 : Wire) ≠ w := wne (by left; simp only [base]; omega) hw
  have ns : Rolling1588.s j h ≠ w :=
    wne (by right; simp only [Rolling1588.s, base]; omega) hw
  have inner : Keeps w (renameProgram (Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j a))
      (renameProgram (Equiv.swap (base 719) (Rolling1588.s j h))
        (StairLoanAdapter.concreteHalf760Loan divide d))) :=
    keeps_rename _ (pre_swap _ _ w nc ng) (keeps_rename _ (pre_swap _ _ w n719 ns) half)
  have pre : Keeps w [Instr.CX (Rolling1588.g j a) (base 2409), Instr.CX (base 2409) (Rolling1588.g j a)] :=
    keeps_of_tgt (by
      intro i hi
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl
      · exact nf
      · exact ng)
  have post : Keeps w [Instr.CX (base 2409) (Rolling1588.g j a),
      Instr.measureX (base 2409) [] [Correction.Z (Rolling1588.g j a)]] :=
    keeps_of_tgt (by
      intro i hi
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl
      · exact ng
      · exact nf)
  exact keeps_append (keeps_append pre inner) post

theorem selW_keeps {w : Wire} (j a : Nat) (hw : InWin w)
    (body : Keeps w FrontierSW1591.swapBody) :
    Keeps w (SW.selW (Rolling1588.s j a) (base 2409) FrontierSW1591.swapBody) := by
  have nf : (base 2409 : Wire) ≠ w := wne (by right; simp only [base]; omega) hw
  have pre : Keeps w [Instr.CX (Rolling1588.s j a) (base 2409)] :=
    keeps_of_tgt (by
      intro i hi
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      subst hi
      exact nf)
  have post : Keeps w [Instr.measureX (base 2409) [] [Correction.Z (Rolling1588.s j a)]] :=
    keeps_of_tgt (by
      intro i hi
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      subst hi
      exact nf)
  exact keeps_append (keeps_append pre body) post

theorem cell_keeps (divide : Bool) (d j a h : Nat) (hj : j < 102) (ha : a < 5) (hh : h < 5)
    {w : Wire} (hw : w ∈ StairSchedule.exclusiveRoles)
    (half : Keeps w (StairLoan.half760Loan d divide)) :
    Keeps w (StairGroups.cell divide d j a h) := by
  have win := inWin_of_role hw
  have sw := selW_keeps j a win (keeps_of_ztAll chk_keep_swapBody (fun _ x => x) w hw)
  have hwn := halfWindow_keeps divide d j a h hj ha hh win half
  cases divide
  · simp only [StairGroups.cell, Bool.false_eq_true, if_false]
    exact keeps_append sw hwn
  · simp only [StairGroups.cell, if_true]
    exact keeps_append hwn sw

theorem basePacket_keeps (divide : Bool) (d j : Nat) (hj : j < 102)
    {w : Wire} (hw : w ∈ StairSchedule.exclusiveRoles)
    (half : Keeps w (StairLoan.half760Loan d divide)) :
    Keeps w (StairGroups.basePacket divide d j) := by
  have win := inWin_of_role hw
  have k (P : Program) (h : ztAll 736 45 true StairSchedule.exclusiveRoles P = true) :
      Keeps w (Rolling1588.onPacket j P) :=
    keeps_onPacket j hj win (keeps_of_ztAll h (fun _ x => x) w hw)
  have op := k _ chk_keep_stageOpen
  have cl := k _ chk_keep_stageClose
  have b5 := k _ chk_keep_bridge5
  have b7 := k _ chk_keep_bridge7
  have b7i := k _ chk_keep_bridge7inv
  have c3 := cell_keeps divide d j 3 2 hj (by decide) (by decide) hw half
  have c4 := cell_keeps divide d j 4 2 hj (by decide) (by decide) hw half
  cases divide
  · simp only [StairGroups.basePacket, Bool.false_eq_true, if_false]
    exact keeps_append (keeps_append op (keeps_append (keeps_append (keeps_append (keeps_append
      (keeps_append (keeps_append c4 b5) c3) c4) b7i) c4) c3)) cl
  · simp only [StairGroups.basePacket, if_true]
    exact keeps_append (keeps_append op (keeps_append (keeps_append (keeps_append (keeps_append
      (keeps_append (keeps_append c3 c4) b7) c4) c3) b5) c4)) cl

theorem packet_keeps (divide : Bool) (d j : Nat) (hj : j < 102)
    {w : Wire} (hw : w ∈ StairSchedule.exclusiveRoles)
    (half : Keeps w (StairLoan.half760Loan d divide)) :
    Keeps w (StairGroups.packet divide d j) :=
  keeps_rename _ (pre_of_inj _ (Equiv.injective _) w (chk_shifted_fix j hj w hw))
    (basePacket_keeps divide d j hj hw half)

theorem packetSequence_keeps (w : Wire) (fwd : Bool) (p : Nat → Program) :
    ∀ (n j : Nat), (∀ i, j ≤ i → i < j + n → Keeps w (p i)) →
      Keeps w (PacketSequence.program fwd p j n) := by
  intro n
  induction n with
  | zero => intro j _; exact keeps_nil w
  | succ n ih =>
    intro j h
    have hj := h j (le_refl j) (by omega)
    have rest := ih (j + 1) (fun i h1 h2 => h i (by omega) (by omega))
    cases fwd
    · simp only [PacketSequence.program, Bool.false_eq_true, if_false]
      exact keeps_append rest hj
    · simp only [PacketSequence.program, if_true]
      exact keeps_append hj rest

/-- Every logical group keeps every role zero. -/
theorem groups_keeps (divide : Bool) (d first count : Nat) (hr : first + count ≤ 102)
    {w : Wire} (hw : w ∈ StairSchedule.exclusiveRoles)
    (half : Keeps w (StairLoan.half760Loan d divide)) :
    Keeps w (StairSchedule.placedGroups StairConcrete.bestLoans divide d first count) := by
  show Keeps w (renameProgram (OB5.sig 511) (StairGroups.groups divide d first count))
  apply keeps_rename (OB5.sig 511) (pre_of_inj _ (OB5.sig_injective 511 (by decide)) w (chk_sig_fix w hw))
  exact packetSequence_keeps w divide _ count first
    (fun i _ h2 => packet_keeps divide d i (by omega) hw half)

/-- The group slot's logical piece keeps every role zero. -/
theorem groupSlot_keeps (h : StairHostsSchedule.HostPlan) (divide : Bool) (d first count : Nat)
    (hr : first + count ≤ 102) {w : Wire} (hw : w ∈ StairSchedule.exclusiveRoles)
    (half : Keeps w (StairLoan.half760Loan d divide)) :
    Keeps w (groupSlot h divide d first count).L := by
  show Keeps w (StairSchedule.fieldRename (renameProgram Prefix1590.borrow
      (StairSchedule.placedGroups StairConcrete.bestLoans divide d first count)))
  rw [lowRename_eq]
  exact keeps_rename _ (pre_of_inj _ lowMap_injective w (chk_lowMap_fix w hw))
    (groups_keeps divide d first count hr hw half)

theorem half_reset_of (divide : Bool) (dd : Nat)
    (h : ztAll 736 45 false (StairSchedule.exclusiveRoles.drop dd)
      (StairLoan.half760Loan dd divide) = true) :
    ∀ w ∈ StairSchedule.exclusiveRoles.drop dd, Resets w (StairLoan.half760Loan dd divide) :=
  resets_of_ztAll h (fun _ hw => List.mem_of_mem_drop hw)

theorem half_keeps_44 (divide : Bool) :
    ∀ w ∈ StairSchedule.exclusiveRoles, Keeps w (StairLoan.half760Loan 44 divide) :=
  half_keeps divide 44 (le_refl _) (by
    intro w hw
    rw [List.drop_eq_nil_of_le (by rw [StairSchedule.exclusiveRoles_length])] at hw
    simp at hw)

/-- Half keeping facts at the deficits of both kernels. -/
theorem half_keeps_at (divide : Bool) (d : Nat) (hd : d ∈ [0, 14, 23, 31, 37, 42, 44]) :
    ∀ w ∈ StairSchedule.exclusiveRoles, Keeps w (StairLoan.half760Loan d divide) := by
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hd
  cases divide
  · rcases hd with rfl | rfl | rfl | rfl | rfl | rfl | rfl
