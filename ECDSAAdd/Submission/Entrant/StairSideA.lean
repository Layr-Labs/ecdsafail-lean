  obtain ⟨hx1, hx2⟩ := hw
  intro hm
  unfold W.compactSkywalkTickLayout SkywalkIntegerLayout.wires SkywalkIntegerLayout.ah
    SkywalkIntegerLayout.bh at hm
  simp only [List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at hm
  generalize W.compactSkywalkTickPreWidth i = n at hb hm
  have H := layout_nat i n w hb.2.2.2.2.1 hb.2.2.2.1 hi hx1 hx2
  rcases hm with h | h | h | h | h | ((h | h) | (h | h)) | h
  · exact H.1 h
  · exact H.2.1 h
  · exact H.2.2.1 h
  · exact H.2.2.2.1 h
  · exact H.2.2.2.2.1 h
  · obtain ⟨k, k1, k2, e⟩ := mem_wireBlock' h
    exact H.2.2.2.2.2.1 k k1 k2 e
  · exact H.2.2.2.2.2.2.1 h
  · obtain ⟨k, k1, k2, e⟩ := mem_wireBlock' h
    exact H.2.2.2.2.2.2.2.1 k k1 k2 e
  · exact H.2.2.2.2.2.2.2.2.1 h
  · obtain ⟨k, k1, k2, e⟩ := mem_wireBlock' h
    exact H.2.2.2.2.2.2.2.2.2 k k1 k2 e


theorem historySite_out' (start : Nat) (hs : start < 600) (k : Fin 10) :
    History5.historyId start k + 16 < 736 ∨ 781 ≤ History5.historyId start k + 16 := by
  have key : ∀ (st kk : Nat), st < 600 → kk < 10 →
      (st + kk / 2 + 16 < 736 ∨ 781 ≤ st + kk / 2 + 16) ∧
      (1028 + st + kk / 2 + 16 < 736 ∨ 781 ≤ 1028 + st + kk / 2 + 16) := by
    intro st kk h1 h2
    omega
  have hk := key start k.val hs k.isLt
