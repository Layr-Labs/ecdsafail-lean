/-- Replace the loaned normalize block, on the state after `prepareSign`. -/
theorem inverse_step_normalize (d : Nat) (hd : d ≤ 68) (R : Int) (hr : Centered R)
    (s : State) (m : List Bool)
    (hR : regValue L760.r s.basis = encodeWord 256 R)
    (hl : s.basis L760.lower = false) (ho : s.basis L760.one = false)
    (hc : ∀ q ∈ L760.carry, s.basis q = false) (Rest G : Program)
    (hG : G = BalancedCleanup.prepareSign L760.toLayout ++ (StairLoan.normalizeLoan d L760 ++ Rest)) :
    ∃ n, run G m s =
      run (BalancedCleanup.prepareSign L760.toLayout ++ (Q6LifetimeResearch.normalize (base 760) L760 ++ Rest)) n s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  subst hG
  refine replace_block_exists _ _ _ Rest s m ?_
  intro x
  have ready := inv_prepared_ready L760.toLayout hw
    (List.nodup_append'.mp hn).2.1 R hr s
    (m.take (measurementCount (BalancedCleanup.prepareSign L760.toLayout))) hR hl ho hc
  exact ⟨x, normalizeLoan_run_eq d hd _ x x ready.1 ready.2.1 ready.2.2⟩

/-- Replace the loaned comparison block, on the state after `recoverBefore`
and the lower exposure. -/
theorem inverse_step_compare (d : Nat) (hd : d ≤ 68) (R : Int) (hr : Centered R)
    (s : State) (m : List Bool)
    (hR : regValue L760.r s.basis = encodeWord 256 R)
    (hl : s.basis L760.lower = false) (ho : s.basis L760.one = false)
    (hc : ∀ q ∈ L760.carry, s.basis q = false) (hp : s.basis L760.parity = false)
    (Rest G : Program)
    (hG : G = (Q6LifetimeProof.recoverBefore (base 760) L760 ++ Q6StructuralCell.exposure L760) ++ (StairLoan.compareBlockLoan d false L760 ++ Rest)) :
    ∃ n, run G m s =
      run ((Q6LifetimeProof.recoverBefore (base 760) L760 ++ Q6StructuralCell.exposure L760) ++ (Q6LifetimeResearch.compare (base 760) false L760 ++ Rest)) n s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  subst hG
  refine replace_block_exists _ _ _ Rest s m ?_
  intro x
  have memberCarry : base 760 ∈ L760.carry :=
    List.mem_of_mem_take (List.mem_of_mem_drop R2Life760.member760)
  have e0 : measurementCount (Q6StructuralCell.exposure L760) = 0 :=
    (Q6LowerExposure.expose_counts _ _ _).2
  have stateEq := inv_zero_tail_run (Q6LifetimeProof.recoverBefore (base 760) L760)
    (Q6StructuralCell.exposure L760) s (m.take (measurementCount (Q6LifetimeProof.recoverBefore (base 760) L760 ++ Q6StructuralCell.exposure L760))) e0
  rw [stateEq]
  have ready := inv_compare_block_ready (base 760) L760 hw hn memberCarry R hr s
    (m.take (measurementCount (Q6LifetimeProof.recoverBefore (base 760) L760 ++ Q6StructuralCell.exposure L760))) hR hl ho hc hp
  exact compareBlockLoan_exists d hd _ x ready.1 ready.2.1 ready.2.2

