/-- Placed codec programs and their run-level interface.  `Expanded` and
`Compact` are the placed versions of LT1's codec predicates. -/
structure CodecSpec where
  pack : Nat → Program
  unpack : Nat → Program
  orient : Nat → Program
  walkMap : Nat → Wire
  Domain : Nat → Nat → Nat → Bool → Prop
  LayoutValid : Nat → Prop
  Expanded : Nat → Nat → Nat → Bool → BasisState → Prop
  Compact : Nat → Nat → Nat → Bool → BasisState → Prop
  pack_spec : ∀ B u v sign, Domain B u v sign → LayoutValid B →
    ∀ s m, Expanded B u v sign s.basis →
      (run (pack B) m s).phase = s.phase ∧
        Compact B u v sign (run (pack B) m s).basis
  unpack_spec : ∀ B u v sign, Domain B u v sign → LayoutValid B →
    ∀ s m, Compact B u v sign s.basis →
      (run (unpack B) m s).phase = s.phase ∧
        Expanded B u v sign (run (unpack B) m s).basis
  OrientInput : Nat → State → Prop
  OrientOutput : Nat → State → Prop
  orient_spec : ∀ i s m, OrientInput i s →
    (run (orient i) m s).phase = s.phase ∧ OrientOutput i (run (orient i) m s)







