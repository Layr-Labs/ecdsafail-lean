    (h : ∀q∈wires P,fit (f (c q))=true) : PieceOK StairPhysicalInventory.physicalHoles f (renameProgram c P) := by
  apply fits
  intro x hx
  rw [renameProgram_support] at hx
  obtain ⟨q,hq,rfl⟩ := Finset.mem_image.mp hx
  exact h q hq

