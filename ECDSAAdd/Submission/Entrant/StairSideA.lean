theorem selW_caller (source flag : Wire) (body : Program) (hs : source ∈ callerDomain)
    (hf : flag ∈ callerDomain) (hb : wires body ⊆ callerDomain) :
    wires (SW.selW source flag body) ⊆ callerDomain := by
  have ns := callerNat_complete _ hs
  have nf := callerNat_complete _ hf
  have a : wires [Instr.CX source flag] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, ns, nf])
  have b : wires [Instr.measureX flag [] [.Z source]] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, corrCaller, ns, nf])
  unfold SW.selW
  exact wires_sub_of_parts _ _ (wires_sub_of_parts _ _ a hb) b

theorem loanWindow_caller (g flag c : Wire) (P : Program) (hg : g ∈ callerDomain)
    (hf : flag ∈ callerDomain) (hc : c ∈ callerDomain) (hP : wires P ⊆ callerDomain) :
    wires (ControlLoan1589.loanWindow g flag c P) ⊆ callerDomain := by
  have ng := callerNat_complete _ hg
