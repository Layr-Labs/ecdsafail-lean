    exact base_mem_caller _ (Or.inl (lt_of_lt_of_le
      (History5.historyId_bound (5 * j) (by omega) ⟨q, h⟩) (by norm_num)))
  · rename_i h
    rcases hq with h' | h'
    · exact absurd h' h
    · exact h'

theorem onPacket_caller (j : Nat) (hj : j ≤ 101) (P : Program)
    (hP : allIn localNat P = true) : wires (Rolling1588.onPacket j P) ⊆ callerDomain := by
