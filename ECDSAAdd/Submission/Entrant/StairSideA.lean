/-! ## Loaned packets -/

theorem q6_sites_indom :
    ∀ q ∈ base 2409 :: Q6EndpointCell.ids.map base, InDom q := by
  decide +kernel

theorem good_half (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (divide : Bool) (d : Nat) (hd : d ≤ 68) :
    Good (StairLoan.half760Loan d divide) := by
  have sub := (H.support divide d hd).trans Finset.sdiff_subset
  have q6 := Q6EndpointCell.half_support divide base (base 2409)
    ((base 2409 :: Q6EndpointCell.ids.map base).toFinset) (Finset.Subset.refl _)
  exact good_of_list _ (sub.trans q6) q6_sites_indom

theorem good_pair (a b : Wire) (ha : InDom a) (hb : InDom b) (P : Program)
    (hP : ∀ q ∈ wires P, q = a ∨ q = b) : Good P := by
  intro q hq
  rcases hP q hq with rfl | rfl
  · exact ha
  · exact hb

theorem good_loanWindow (g flag c : Wire) (hg : InDom g) (hf : InDom flag)
    (hc : InDom c) {P : Program} (hP : Good P) :
    Good (ControlLoan1589.loanWindow g flag c P) := by
  unfold ControlLoan1589.loanWindow
  refine good_append.mpr ⟨good_append.mpr ⟨?_, good_swap c g hc hg hP⟩, ?_⟩
  · apply good_pair g flag hg hf
    intro q hq
    simp [wires, Instr.wires] at hq
    tauto
  · apply good_pair g flag hg hf
    intro q hq
    simp [wires, Instr.wires, correctionWires] at hq
    tauto

theorem good_halfWindow (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (divide : Bool) (d j a h : Nat) (hd : d ≤ 68) (hj : j ≤ 101)
    (ha : a < 5) (hh : h < 5) :
    Good (StairGroups.halfWindow divide d j a h) := by
  unfold StairGroups.halfWindow
  apply good_loanWindow
  · simp only [Rolling1588.g]
    exact indom_base _ (by omega)
  · decide
  · simp only [Rolling1588.packetCarry]
    exact indom_base _ (by omega)
  · apply good_swap (base 719) (Rolling1588.s j h) (by decide)
      (by simp only [Rolling1588.s]; exact indom_base _ (by omega))
    exact good_half H divide d hd

theorem good_cell_true (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (d j a h : Nat) (hd : d ≤ 68) (hj : j ≤ 101) (ha : a < 5) (hh : h < 5)
    (R : Good (Rolling1588.cell true j a h)) :
    Good (StairGroups.cell true d j a h) := by
  have sel := good_right R
  exact good_append.mpr ⟨good_halfWindow H true d j a h hd hj ha hh, sel⟩

theorem good_cell_false (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (d j a h : Nat) (hd : d ≤ 68) (hj : j ≤ 101) (ha : a < 5) (hh : h < 5)
    (R : Good (Rolling1588.cell false j a h)) :
    Good (StairGroups.cell false d j a h) := by
  have sel := good_left R
  exact good_append.mpr ⟨sel, good_halfWindow H false d j a h hd hj ha hh⟩



