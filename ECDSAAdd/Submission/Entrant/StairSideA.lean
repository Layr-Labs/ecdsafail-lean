/-!
# LT43: the multiplication plan with reachability and a pinned input

`ExitPlanV3` relates the two exit runs by `Rel (Δrow i) (C i)` only.  Every exit
step, however, needs a fact about the *reference* (multiplication record) state
that a `Δ`-local side condition cannot express: the reverse segments need the
record transcript on the whole `futurePayload B` (LT24's `ExitRowRel`), the exit
junction needs the last-step predicate of the record state, and the close needs
the record state at row 425 (for `close_record_trip`).

`ExitPlanR p k x` therefore carries, like the division plan, the reachability of the
reference state (`ReachE k x Y t`: reached from a multiplication middle state of
input `x` by the reference prefix `Y`), and pins the input `x` in the side
condition (`CvX x B`), so that the selected partner of a reference state is unique.

`field2_of_entryD_R` is field 2 from LT21's `EntryPlanV3d` and this plan.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3ExitPlanR

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairField2V3Delta StairField2V3Seg
open StairPhysicalLayout StairOuterPlacement

/-! ## Multiplication middle states with a pinned input -/





/-! ## Side condition with the input pinned -/


theorem cvX_cv (x B : Nat) (a b : BasisState) (h : CvX x B a b) : Cv B a b := by
  obtain ⟨origin, ho, hv⟩ := h
  exact ⟨x, origin, ho, hv⟩


theorem not_mem_Δv (B : Nat) (r : Wire) (hr : r ∉ futurePayload B) : fieldPlace r ∉ Δv B := by
  intro h
  simp only [Δv, List.mem_toFinset, List.mem_map] at h
  obtain ⟨f, hf, he⟩ := h
  have := StairField2V3Delta.fieldPlace_injective he
  subst this
  exact hr hf

theorem mem_Δv_iff (B : Nat) (q : Wire) (hq : q ∈ Δv B) : ∃ r ∈ futurePayload B, q = fieldPlace r := by
  simp only [Δv, List.mem_toFinset, List.mem_map] at hq
  obtain ⟨r, hr, he⟩ := hq
  exact ⟨r, hr, he.symm⟩




/-- **Uniqueness**: the selected partner of a reference state is unique. -/
theorem relX_unique (x B : Nat) (s1 s2 t : State) (h1 : RelX x B s1 t) (h2 : RelX x B s2 t) :
    s1 = s2 := by
  obtain ⟨⟨p1, o1⟩, _, _, v1⟩ := h1
  obtain ⟨⟨p2, o2⟩, _, _, v2⟩ := h2
  apply State.extensionality
  · rw [p1, p2]
  · funext q
    by_cases hq : q ∈ Δv B
    · obtain ⟨r, hr, rfl⟩ := mem_Δv_iff B q hq
      rw [(v1 r hr).2, (v2 r hr).2]
    · rw [o1 q hq, o2 q hq]

/-- The canonical selected partner: the reference state with the compact checkpoint
of row `B` written on the future payload. -/
def partner (x B : Nat) (t : State) : State :=
  ⟨t.phase, fun q => if q ∈ Δv B then cmpBits B x (fieldPlaceInv q) else t.basis q⟩

theorem partner_rel (x B : Nat) (t : State) (origin : BasisState) (ho : TraceOK x origin)
    (hv : ∀ r ∈ futurePayload B, t.basis (fieldPlace r) = recVal origin r) :
    RelX x B (partner x B t) t := by
  refine ⟨⟨rfl, ?_⟩, origin, ho, ?_⟩
  · intro q hq
    show (if q ∈ Δv B then _ else t.basis q) = _
    rw [if_neg hq]
  · intro r hr
    refine ⟨hv r hr, ?_⟩
    show (if fieldPlace r ∈ Δv B then cmpBits B x (fieldPlaceInv (fieldPlace r)) else _) = _
    rw [if_pos (mem_Δv B r hr), inv_fieldPlace]

