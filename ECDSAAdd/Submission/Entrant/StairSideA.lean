section Merge_StairField2V3JuncRefWalk_at_QTop

/-!
# LT43b: the record walk in closed form at tick 424 and at its end

For a stage-1 state `s1` of the input `x` (no other assumption on `s1`):

* `walk424`: the record ticks `1..424` give
  `pullState (sig 424) (allEncode 84 (raw425 s1))`, `raw425 s1` = the raw compact walk
  after 424 ticks (a `CompactSkywalkStage 425`);
* the complete record walk gives `pullState (sig 511) (allEncode 102 (raw512 s1))`
  (record `stackForward_boundary`), `raw512 s1 = ` 87 more raw ticks;
* per-id values of `raw425`, `raw512` and of the cleared raw end `rawEnd s1`
  (`origin` of the junction) on the 1798 pool ids, and the frame off the pool;
* the encoders: `allEncode 102` versus `allEncode 84` off the packets `84..101`,
  holes, and the link to `recVal`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3JuncRefWalk

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1
open StairField2V3Seg StairField2V3SegSpec

/-- The rails of the walk of `x`. -/
abbrev rails (x : Nat) : SkywalkRails.State :=
  SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)

/-- Transcript letter pair of tick `j`. -/
abbrev cw (x j : Nat) : Bool × Bool :=
  SkywalkTrace.code (SkywalkTrace.next^[j] (rails x))

/-! The five states are *notations* (explicit `run` terms), not definitions: a
definition would have to be unfolded under `State.basis _ q`, and such a
conversion makes Lean evaluate the concrete walk (70 GB). -/

/- The raw compact walk after ticks `1..424`. -/
/- The raw compact walk after ticks `1..511`. -/
/- The cleared raw walk end: its basis is the `origin` of the junction. -/
/- The encoded walk state at tick 424 (before the `sig 424` placement). -/
/- The encoded walk end (before the `sig 511` placement). -/

theorem pull_basis (f : Wire → Wire) (s : State) (q : Wire) :
    (pullState f s).basis q = s.basis (f q) := rfl

theorem pull_phase (f : Wire → Wire) (s : State) : (pullState f s).phase = s.phase := rfl

theorem mk_basis (b : Bool) (v : BasisState) (q : Wire) : (⟨b, v⟩ : State).basis q = v q := rfl

/-! ## Small tools -/

theorem sig_base (i : Nat) (hi : i ≤ 511) (j : Nat) :
    OB5.sig i (base j) =
      if (1285 ≤ j ∧ j ≤ 1028 + i) ∨ (2053 ≤ j + i ∧ j ≤ 1796) then base (3081 - j)
      else base j := by
  have h : OB5.sigNat i (j + 16) =
      if (1285 ≤ j ∧ j ≤ 1028 + i) ∨ (2053 ≤ j + i ∧ j ≤ 1796) then (3081 - j) + 16
      else j + 16 := by
    unfold OB5.sigNat
    split_ifs <;> omega
  exact h

theorem sig_fix (i : Nat) (hi : i ≤ 511) (j : Nat)
    (h : ¬ ((1285 ≤ j ∧ j ≤ 1028 + i) ∨ (2053 ≤ j + i ∧ j ≤ 1796))) :
    OB5.sig i (base j) = base j := by
  rw [sig_base i hi, if_neg h]

theorem sig_move (i : Nat) (hi : i ≤ 511) (j : Nat)
    (h : (1285 ≤ j ∧ j ≤ 1028 + i) ∨ (2053 ≤ j + i ∧ j ≤ 1796)) :
    OB5.sig i (base j) = base (3081 - j) := by
  rw [sig_base i hi, if_pos h]

theorem pool_mem (j : Nat) (hj : j < 1798) : base j ∈ skywalkPoolWires base := by
  unfold skywalkPoolWires wireBlock
  exact List.mem_map.mpr ⟨j, List.mem_range'_1.mpr ⟨Nat.zero_le _, by omega⟩, rfl⟩

theorem pool_id (q : Wire) (h : q ∈ skywalkPoolWires base) : ∃ j, j < 1798 ∧ q = base j := by
  unfold skywalkPoolWires at h
  obtain ⟨id, -, h2, rfl⟩ := mem_wireBlock h
  exact ⟨id, by omega, rfl⟩

theorem sig_off_pool (i : Nat) (hi : i ≤ 511) (q : Nat)
    (h : (q : Wire) ∉ skywalkPoolWires base) :
    OB5.sig i q = q := by
  have hq : ¬ (16 ≤ q ∧ q - 16 < 1798) := by
    intro hc
    apply h
    have e : q = base (q - 16) := (show q = (q - 16) + 16 by omega)
    rw [e]
    exact pool_mem _ hc.2
  have key : OB5.sigNat i q = q := by
    unfold OB5.sigNat
    split_ifs <;> omega
  exact key

theorem block_mem (s n j : Nat) (h1 : s ≤ j) (h2 : j < s + n) : base j ∈ wireBlock base s n := by
  unfold wireBlock
  exact List.mem_map.mpr ⟨j, List.mem_range'_1.mpr ⟨h1, h2⟩, rfl⟩

/-! ## Generic program shapes (before the concrete programs are sealed) -/

theorem allEnc_succ (w : Nat → Wire) (n : Nat) :
    Rolling1588.allEncode w true (n + 1) =
      Rolling1588.allEncode w true n ++ Rolling1588.encodeGroup w true n := rfl

theorem norm_gen (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (n : Nat) (hi : 1 + n ≤ 512)
    (s : State) :
    run (Rolling1588.Integer.compactForward w true 1 n) [] s =
      run (Rolling1588.Integer.encodePrefix w true (1 + n)) []
        (run (W.compactSkywalkForward w 1 n) [] s) := by
  have h := Rolling1588.Integer.compactForward_normalize w true hn 1 n hi s
  have e0 : Rolling1588.Integer.encodePrefix w true 1 = [] := by
    simp [Rolling1588.Integer.encodePrefix, Rolling1588.Integer.packAfter, History5.packDue]
  rw [e0] at h
  simpa only [run] using h


attribute [local irreducible] run wires W.compactSkywalkForward Rolling1588.stackForward Rolling1588.allEncode Rolling1588.encodeGroup Rolling1588.Integer.regularForward Rolling1588.Integer.compactForward Rolling1588.Integer.encodePrefix skywalkArithmeticClear

theorem gap : ECDSAAdd.p + 2 ^ 32 ≤ 2 ^ 256 := by norm_num [ECDSAAdd.p]

/-! ## Closed forms -/

theorem stage425 (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) :
    ((run (W.compactSkywalkForward base 1 424) [] s1)).phase = s1.phase ∧ W.CompactSkywalkStage base (rails x) 425 ((run (W.compactSkywalkForward base 1 424) [] s1)).basis := by
  obtain ⟨hp0, hpo, hp, cop⟩ := StackOB5.prime_facts x hx0 hx
  exact W.compactSkywalkForward_spec base base_pool_nodup x ECDSAAdd.p 1 424 hp0 hx0 hpo hp gap hx
    cop (by norm_num) s1 [] first

theorem stage512 (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) :
    ((run (W.compactSkywalkForward base 1 511) [] s1)).phase = s1.phase ∧ W.CompactSkywalkStage base (rails x) 512 ((run (W.compactSkywalkForward base 1 511) [] s1)).basis := by
  obtain ⟨hp0, hpo, hp, cop⟩ := StackOB5.prime_facts x hx0 hx
  exact W.compactSkywalkForward_spec base base_pool_nodup x ECDSAAdd.p 1 511 hp0 hx0 hpo hp gap hx
    cop (by norm_num) s1 [] first



/-! ## Frames off the pool -/

theorem raw425_off (s1 : State) (q : Wire) (h : q ∉ skywalkPoolWires base) :
    ((run (W.compactSkywalkForward base 1 424) [] s1)).basis q = s1.basis q :=
  W.compactSkywalkForward_frame base base_pool_nodup 1 424 (by norm_num) s1 [] q h

theorem raw512_off (s1 : State) (q : Wire) (h : q ∉ skywalkPoolWires base) :
    ((run (W.compactSkywalkForward base 1 511) [] s1)).basis q = s1.basis q :=
  W.compactSkywalkForward_frame base base_pool_nodup 1 511 (by norm_num) s1 [] q h

/-! ## Encoder supports -/

/-- A wire of `allEncode a` is a history site of a packet `< a`. -/
theorem enc_mem (a : Nat) (q : Wire) (hq : q ∈ wires (Rolling1588.allEncode base true a)) :
    ∃ j, j < a ∧ ∃ i : Fin 10, q = base (History5.historyId (5 * j) i) := by
  rw [Rolling1588.allEncode_support_eq, NewHistory5.allEncode_support_eq] at hq
  obtain ⟨j, hj, hmem⟩ := History5.allEncode_member base a _ hq
  obtain ⟨i, hi⟩ := History5.history_gate_mem base (5 * j) _ (Or.inl rfl) _ hmem
  exact ⟨j, hj, i, hi⟩

theorem hist_range (j : Nat) (i : Fin 10) :
    (5 * j ≤ History5.historyId (5 * j) i ∧ History5.historyId (5 * j) i < 5 * j + 5) ∨
      (1028 + 5 * j ≤ History5.historyId (5 * j) i ∧
        History5.historyId (5 * j) i < 1028 + 5 * j + 5) := by
  have hi := i.isLt
  unfold History5.historyId
  split_ifs <;> omega

theorem enc_id (a : Nat) (id : Nat) (hq : base id ∈ wires (Rolling1588.allEncode base true a)) :
    id < 5 * a ∨ (1028 ≤ id ∧ id < 1028 + 5 * a) := by
  obtain ⟨j, hj, i, hi⟩ := enc_mem a _ hq
  have e := base_injective hi
  have r := hist_range j i
  omega

theorem group_mem (k : Nat) (q : Wire) (hq : q ∈ wires (Rolling1588.encodeGroup base true k)) :
    ∃ i : Fin 10, q = base (History5.historyId (5 * k) i) := by
  rw [Rolling1588.encodeGroup_support_eq] at hq
  obtain ⟨i, hi⟩ := NewHistory5.history_gate_mem base (5 * k) _ (Or.inl rfl) _ hq
  exact ⟨i, hi⟩

/-- Off the sites of the packets `84 ..`, `allEncode n` acts as `allEncode 84`. -/
theorem enc_stable (s : State) (id : Nat)
    (h : id < 420 ∨ (510 ≤ id ∧ id < 1448) ∨ 1538 ≤ id) : ∀ n, 84 ≤ n → n ≤ 102 →
      (run (Rolling1588.allEncode base true n) [] s).basis (base id) =
        (run (Rolling1588.allEncode base true 84) [] s).basis (base id) := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => intro _; exact rfl
  | succ n hn ih =>
    intro hb
    rw [allEnc_succ base n, run_append]
    simp only [List.take_nil, List.drop_nil]
    rw [run_preserves_outside _ _ _ _ ?_]
    · exact ih (by omega)
    · intro hw
      obtain ⟨i, hi⟩ := group_mem n _ hw
      have e := base_injective hi
      have r := hist_range n i
      omega

theorem enc102_non (s : State) (id : Nat) (h : (510 ≤ id ∧ id < 1028) ∨ 1538 ≤ id) :
    (run (Rolling1588.allEncode base true 102) [] s).basis (base id) = s.basis (base id) := by
  apply run_preserves_outside
  intro hw
  have := enc_id 102 id hw
  omega

theorem enc84_non (s : State) (id : Nat) (h : (420 ≤ id ∧ id < 1028) ∨ 1448 ≤ id) :
    (run (Rolling1588.allEncode base true 84) [] s).basis (base id) = s.basis (base id) := by
  apply run_preserves_outside
  intro hw
  have := enc_id 84 id hw
  omega

/-! ## Values of the raw walk states on the pool -/

theorem relA : (W.compactSkywalkSignPoolA base 425).released = wireBlock base 513 170 := by
  decide +kernel

theorem relB : (W.compactSkywalkSignPoolB base 425).released = wireBlock base 858 170 := by
  decide +kernel

theorem raw425_past (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (j : Nat) (hj : j < 425) :
    ((run (W.compactSkywalkForward base 1 424) [] s1)).basis (base j) = (cw x j).1 ∧ ((run (W.compactSkywalkForward base 1 424) [] s1)).basis (base (1028 + j)) = (cw x j).2 := by
  obtain ⟨-, -, -, fpast, -, -, -, -, -⟩ :=
    (W.compactSkywalkStage_fields_iff base (rails x) 425 (by norm_num) base_pool_nodup _).mp
      (stage425 x hx0 hx s1 first).2
  exact fpast j hj

/-- Pool ids that are clean after tick 424: the released a-pool and the future
extension `513..769`, the released b-pool `858..1027`, the future s-letters
`1453..1539`, the carry `1540..1796` and `1797`. -/
theorem raw425_zero (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (j : Nat)
    (h : (513 ≤ j ∧ j < 770) ∨ (858 ≤ j ∧ j < 1028) ∨ (1453 ≤ j ∧ j < 1798)) :
    ((run (W.compactSkywalkForward base 1 424) [] s1)).basis (base j) = false := by
  obtain ⟨-, -, -, -, ffut, fcarry, f1797, fclA, fclB⟩ :=
    (W.compactSkywalkStage_fields_iff base (rails x) 425 (by norm_num) base_pool_nodup _).mp
      (stage425 x hx0 hx s1 first).2
  rcases h with h | h | h
  · by_cases h2 : j < 683
    · exact fclA _ (by rw [relA]; exact block_mem 513 170 j h.1 (by omega))
    · have t := (ffut (j - 258) (by omega) (by omega)).1
      rwa [show j - 258 + 258 = j by omega] at t
  · exact fclB _ (by rw [relB]; exact block_mem 858 170 j h.1 (by omega))
  · by_cases h2 : j < 1540
    · have t := (ffut (j - 1028) (by omega) (by omega)).2
      rwa [show 1028 + (j - 1028) = j by omega] at t
    · by_cases h3 : j < 1797
      · exact (regValue_zero _ _).mp fcarry _ (block_mem 1540 257 j (by omega) (by omega))
      · have e : j = 1797 := by omega
        subst e
        exact f1797

theorem raw512_past (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (j : Nat) (hj : j < 512) :
    ((run (W.compactSkywalkForward base 1 511) [] s1)).basis (base j) = (cw x j).1 ∧ ((run (W.compactSkywalkForward base 1 511) [] s1)).basis (base (1028 + j)) = (cw x j).2 := by
  obtain ⟨-, -, -, fpast, -, -, -, -, -⟩ :=
    (W.compactSkywalkStage_fields_iff base (rails x) 512 (by norm_num) base_pool_nodup _).mp
      (stage512 x hx0 hx s1 first).2
  exact fpast j hj

theorem raw512_carry (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (j : Nat)
    (h : 1540 ≤ j ∧ j < 1798) : ((run (W.compactSkywalkForward base 1 511) [] s1)).basis (base j) = false := by
  obtain ⟨-, -, -, -, -, fcarry, f1797, -, -⟩ :=
    (W.compactSkywalkStage_fields_iff base (rails x) 512 (by norm_num) base_pool_nodup _).mp
      (stage512 x hx0 hx s1 first).2
  by_cases h3 : j < 1797
  · exact (regValue_zero _ _).mp fcarry _ (block_mem 1540 257 j (by omega) (by omega))
  · have e : j = 1797 := by omega
    subst e
    exact f1797

theorem cw511 (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) : cw x 511 = (true, false) := by
  have h := SkywalkTrace.trace512_last x hx0 hx (false, false)
  rwa [SkywalkTrace.trace_getD_code 512 _ 511 (by decide)] at h

/-! ## The cleared raw end -/

theorem integer512 (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) :
    SkywalkIntegerStage base (rails x) 512 ((run (W.compactSkywalkForward base 1 511) [] s1)).basis := by
  obtain ⟨hp0, hpo, hp, cop⟩ := StackOB5.prime_facts x hx0 hx
  have a512 := (W.compactSkywalkStage_eq base _ 512 W.narrowSkywalkRouteWidth_endpoints.2.2.1 _).mp
    (stage512 x hx0 hx s1 first).2
  exact (Arithmetic.compactSkywalkStage_terminal base base_pool_nodup x ECDSAAdd.p hp0 hx0 hpo hp hx
    cop _ a512).2





/-! ## The encoded states -/


/-- LT48 (replay budget): `recVal` unfolded through a function-level `rfl` (one kernel delta step).
`unfold recVal` realizes `recVal.eq_1`, whose kernel check costs ≈ 40 s per module. -/
theorem recVal_funJW : recVal = fun (origin : BasisState) (r : Wire) =>
    (ECDSAAdd.run (Rolling1588.allEncode ECDSAAdd.Arithmetic.MappedCompressed.base true 102) []
      ⟨false, origin⟩).basis (OB5.sig 511 r) := rfl

theorem recVal_defJW (origin : BasisState) (r : Wire) :
    recVal origin r = (ECDSAAdd.run (Rolling1588.allEncode ECDSAAdd.Arithmetic.MappedCompressed.base true 102) []
      ⟨false, origin⟩).basis (OB5.sig 511 r) :=
  congrFun (congrFun recVal_funJW origin) r


/-- Off the packets `84..101`, the final encoding and the tick-424 encoding agree
wherever the raw states agree. -/
theorem enc_agree (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (id : Nat)
    (h : id < 420 ∨ (510 ≤ id ∧ id < 1448) ∨ 1538 ≤ id)
    (hraw : ((run (W.compactSkywalkForward base 1 511) [] s1)).basis (base id) = ((run (W.compactSkywalkForward base 1 424) [] s1)).basis (base id)) :
    ((run (Rolling1588.allEncode base true 102) [] (run (W.compactSkywalkForward base 1 511) [] s1))).basis (base id) = ((run (Rolling1588.allEncode base true 84) [] (run (W.compactSkywalkForward base 1 424) [] s1))).basis (base id) := by
  rw [enc_stable ((run (W.compactSkywalkForward base 1 511) [] s1)) id h 102 (by norm_num) le_rfl]
  have agree : ∀ q ∈ wires (Rolling1588.allEncode base true 84),
      ((run (W.compactSkywalkForward base 1 511) [] s1)).basis q = ((run (W.compactSkywalkForward base 1 424) [] s1)).basis q := by
    intro q hq
    obtain ⟨j, hj, i, rfl⟩ := enc_mem 84 q hq
    have r := hist_range j i
    rcases r with r | r
    · rw [(raw512_past x hx0 hx s1 first _ (by omega)).1,
        (raw425_past x hx0 hx s1 first _ (by omega)).1]
    · have e : History5.historyId (5 * j) i = 1028 + (History5.historyId (5 * j) i - 1028) := by
        omega
      rw [e, (raw512_past x hx0 hx s1 first _ (by omega)).2,
        (raw425_past x hx0 hx s1 first _ (by omega)).2]
  by_cases hw : base id ∈ wires (Rolling1588.allEncode base true 84)
  · exact (ECDSAAdd.Arithmetic.run_local_increment _ _ _ [] agree).2 _ hw
  · rw [run_preserves_outside _ _ _ _ hw, run_preserves_outside _ _ _ _ hw]
    exact hraw

/-- Holes of the packets of the final encoding are zero. -/
theorem enc102_hole (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (t : Nat) (ht : t < 510)
    (hole : t % 5 = 2 ∨ t % 5 = 4) : ((run (Rolling1588.allEncode base true 102) [] (run (W.compactSkywalkForward base 1 511) [] s1))).basis (base (1028 + t)) = false := by
  obtain ⟨hp0, hpo, -, -⟩ := StackOB5.prime_facts x hx0 hx
  have legal : NewHistory5.RawLegal base 102 ((run (W.compactSkywalkForward base 1 511) [] s1)).basis := by
    intro j hj
    exact W.stage_group_legal base base_pool_nodup x ECDSAAdd.p 512 (5 * j) hp0 hpo (by omega)
      (by decide) _ (stage512 x hx0 hx s1 first).2
  rcases hole with h | h
  · have e : base (1028 + t) = History5.historyMap base (5 * (t / 5)) ⟨5, by norm_num⟩ := by
      show base (1028 + t) = base (History5.historyId (5 * (t / 5)) ⟨5, by norm_num⟩)
      congr 1
      unfold History5.historyId
      simp only [show (5 : Nat) % 2 ≠ 0 by norm_num, if_false]
      omega
    rw [e]
    exact Rolling1588.allEncode_hole base true base_pool_nodup 102 (t / 5) (by decide) (by omega)
      ((run (W.compactSkywalkForward base 1 511) [] s1)) [] legal _ (Or.inl rfl)
  · have e : base (1028 + t) = History5.historyMap base (5 * (t / 5)) ⟨9, by norm_num⟩ := by
      show base (1028 + t) = base (History5.historyId (5 * (t / 5)) ⟨9, by norm_num⟩)
      congr 1
      unfold History5.historyId
      simp only [show (9 : Nat) % 2 ≠ 0 by norm_num, if_false]
      omega
    rw [e]
    exact Rolling1588.allEncode_hole base true base_pool_nodup 102 (t / 5) (by decide) (by omega)
      ((run (W.compactSkywalkForward base 1 511) [] s1)) [] legal _ (Or.inr rfl)

/-! ## Zero classes of the encoded states -/

theorem enc_off (a : Nat) (ha : a ≤ 102) (s : State) (q : Wire)
    (h : q ∉ skywalkPoolWires base) :
    (run (Rolling1588.allEncode base true a) [] s).basis q = s.basis q := by
  apply run_preserves_outside
  intro hw
  obtain ⟨j, hj, i, rfl⟩ := enc_mem a q hw
  have r := hist_range j i
  exact h (pool_mem _ (by omega))

/-- Sites that are zero in the tick-424 encoded state (ids as in `raw425_zero`). -/
theorem enc84_zero (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (s1 : State)
    (first : W.CompactSkywalkStage base (rails x) 1 s1.basis) (j : Nat)
    (h : (513 ≤ j ∧ j < 770) ∨ (858 ≤ j ∧ j < 1028) ∨ (1453 ≤ j ∧ j < 1798)) :
    ((run (Rolling1588.allEncode base true 84) [] (run (W.compactSkywalkForward base 1 424) [] s1))).basis (base j) = false := by
  rw [enc84_non _ j (by omega)]
  exact raw425_zero x hx0 hx s1 first j h


theorem enc_phase (s1 : State) :
