gates plus the six-gate majority. -/
theorem mappedMajority_slots_le (b : MappedBit) (y cin target : Wire) :
    gateSlots (mappedMajority b y cin target) ≤ 8 := by
  cases b with
  | mk wire flip =>
      cases wire <;> cases flip <;>
