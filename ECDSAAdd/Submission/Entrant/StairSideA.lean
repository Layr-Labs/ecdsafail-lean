theorem basePacket_counts (divide : Bool) (d j : Nat) (hd : d ≤ 68) :
    toffoliCount (basePacket divide d j) =
        toffoliCount (Rolling1588.basePacket divide j) + 20 * d ∧
      measurementCount (basePacket divide d j) =
        measurementCount (Rolling1588.basePacket divide j) + 20 * d := by
  have h32 := cell_counts divide d j 3 2 hd
