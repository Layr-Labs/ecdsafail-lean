/-- Replace the loaned unfold block, on the state after the recovered
comparison and the unbiased view. -/
theorem inverse_step_unfold (d : Nat) (hd : d ≤ 68)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L760.sign = B)
    (hR : signedRegValue L760.r s.basis = R)
    (hY : signedRegValue L760.y s.basis = Y)
    (clean : ∀ q ∈ BalancedCircuit.work L760, s.basis q = false)
    (Rest G : Program)
    (hG : G = (invRecoverProgram (base 760) L760 ++ BiasedInverse.unbiasView L760) ++ (StairLoan.unfoldLoan d L760 ++ Rest)) :
    ∃ n, run G m s =
      run ((invRecoverProgram (base 760) L760 ++ BiasedInverse.unbiasView L760) ++ (Q6LifetimeResearch.unfoldStep (base 760) L760 ++ Rest)) n s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  subst hG
  refine replace_block_exists _ _ _ Rest s m ?_
  intro x
  have ready := inv_unfold_block_ready (base 760) L760 hw hn R2Life760.member760
    B R Y hr hy s (m.take (measurementCount (invRecoverProgram (base 760) L760 ++ BiasedInverse.unbiasView L760))) hs hR hY clean
  exact unfoldLoan_exists d hd _ x ready.1 ready.2

/-- Replace the loaned raw-subtraction tail, on the state after the record
inverse prefix. -/
theorem inverse_step_tail (d : Nat) (hd : d ≤ 68)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L760.sign = B)
    (hR : signedRegValue L760.r s.basis = R)
    (hY : signedRegValue L760.y s.basis = Y)
    (clean : ∀ q ∈ BalancedCircuit.work L760, s.basis q = false)
    (Rest G : Program)
    (hG : G = invPrefixProgram (base 760) L760 ++ (StairLoan.rawSubTailLoan d L760 ++ Rest)) :
    ∃ n, run G m s =
      run (invPrefixProgram (base 760) L760 ++ (Q6LifetimeResearch.rawSubTail (base 760) L760 ++ Rest)) n s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  subst hG
  refine replace_block_exists _ _ _ Rest s m ?_
  intro x
  have ready := inv_tail_ready (base 760) L760 hw hn R2Life760.member760
    B R Y hr hy s (m.take (measurementCount (invPrefixProgram (base 760) L760))) hs hR hY clean
  exact rawSubTailLoan_of_ready d hd _ x ready.1 ready.2.1 ready.2.2.1
