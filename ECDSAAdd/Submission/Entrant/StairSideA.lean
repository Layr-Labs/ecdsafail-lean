theorem headPrefix_record_sub :
    wires (StairLoanExitHeadReplay.headPrefixShape StairSchedule.recordLoans) ⊆
      wires Rolling1588.exitHead := by
  have hg : Rolling1588.groups false 1 101 =
      Rolling1588.groups false 100 2 ++ Rolling1588.groups false 1 99 := by
    unfold Rolling1588.groups
    have h := StairLoanRecordShape.program_false_add (Rolling1588.packet false) 99 2 1
    rw [show (99 : Nat) + 2 = 101 from rfl, show (1 : Nat) + 99 = 100 from rfl] at h
