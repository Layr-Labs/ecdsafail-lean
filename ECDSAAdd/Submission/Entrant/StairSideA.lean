/-! ## Shape lemmas (variable programs only) -/

theorem rename_append' (f : Wire → Wire) (a b : Program) :
    renameProgram f (a ++ b) = renameProgram f a ++ renameProgram f b := by
  simp only [renameProgram, List.map_append]


theorem program_true_add (p : Nat → Program) :
    ∀ (a b j : Nat),
      PacketSequence.program true p j (a + b) =
        PacketSequence.program true p j a ++
          PacketSequence.program true p (j + a) b
  | 0, b, j => by simp [PacketSequence.program]
  | a + 1, b, j => by
      have h : a + 1 + b = (a + b) + 1 := by omega
      rw [h]
      simp only [PacketSequence.program, if_true, List.append_assoc]
      rw [program_true_add p a b (j + 1)]
      have hj : j + 1 + a = j + (a + 1) := by omega
      rw [hj]

theorem groups_true_add (a b j : Nat) :
    Rolling1588.groups true j (a + b) =
      Rolling1588.groups true j a ++ Rolling1588.groups true (j + a) b := by
  unfold Rolling1588.groups
  exact program_true_add _ a b j

theorem groups_101 : Rolling1588.groups true 1 101 =
    Rolling1588.groups true 1 84 ++ (Rolling1588.groups true 85 5 ++
      (Rolling1588.groups true 90 3 ++ (Rolling1588.groups true 93 3 ++
        (Rolling1588.groups true 96 2 ++ (Rolling1588.groups true 98 2 ++
          Rolling1588.groups true 100 2))))) := by
  rw [show (101 : Nat) = 84 + 17 from rfl, groups_true_add,
    show (17 : Nat) = 5 + 12 from rfl, groups_true_add,
    show (12 : Nat) = 3 + 9 from rfl, groups_true_add,
    show (9 : Nat) = 3 + 6 from rfl, groups_true_add,
    show (6 : Nat) = 2 + 4 from rfl, groups_true_add,
