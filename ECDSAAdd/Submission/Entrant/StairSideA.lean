theorem PieceOK.rename {holes : List Wire} {f g : Wire → Wire} {P : Program}
    (h : PieceOK holes (fun x => f (g x)) P) : PieceOK holes f (renameProgram g P) := by
  refine ⟨?_, ?_⟩ <;> intro x hx <;> rw [renameProgram_support, Finset.mem_image] at hx <;>
    obtain ⟨y, hy, rfl⟩ := hx
  · exact h.1 y hy
  · exact h.2 y hy

theorem pieceOK_nil (holes : List Wire) (f : Wire → Wire) : PieceOK holes f [] := by
  refine ⟨?_, ?_⟩ <;> intro x hx <;> simp [wires] at hx

/-- A good site (LT13's `Good`, at the physical level) is fine for every sublist
of the 44 holes. -/
theorem pieceOK_of_good {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    {f : Wire → Wire} {P : Program}
    (h : ∀ x ∈ wires P, f x ∈ StairHoleSupport.recordArena ∧
      f x ∉ StairHoleSupport.oldHoles ∧ f x ∉ StairPhysicalInventory.physicalHoles) :
    PieceOK holes f P := by
  refine ⟨fun x hx => ⟨(h x hx).1, (h x hx).2.1⟩, fun x hx hh => ?_⟩
  exact (h x hx).2.2 (hsub _ hh)

theorem holePlacement_of_ok {holes : List Wire} {P : Program}
    (h : PieceOK holes (fun x => x) P) : StairCertificate.HolePlacement holes P := by
  refine ⟨?_, ?_, ?_⟩
  · apply Finset.union_subset FiniteHostStack.io_support_original
    intro q hq
    exact List.mem_toFinset.mpr (h.1 q hq).1
  · intro q hq hw
    exact (h.1 q hw).2 hq
  · intro q hq hw
    exact h.2 q hw hq

