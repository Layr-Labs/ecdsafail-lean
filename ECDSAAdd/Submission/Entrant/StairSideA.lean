        exact ht
      · rw [hlerase]
        simp [hq]
      · rw [hlFrame q]
        · rw [hherase]
          simp [hq]
        · intro hl
          exact sep_low_high L B hn hl hq rfl

def generatedPackA (L : Layout) (B : Nat) : Program :=
  let ld := lowDecoder L B
  let hd := highDecoder L B
  cxInto (L.D (B - 1)) (reg L.D (B - 1)) ++
  xOnA (reg L.S B) ++ generatedPackAdderA L B ++ xOnA (reg L.S B) ++
  [.X (L.S 0)] ++ [.X L.z] ++
  decoderInit ld (lowBits L B) ++ decoderInit hd (highBits L B) ++
  packStep L B (B - 2) ++
  ((List.range (B - 2)).reverse.flatMap (packStep L B)) ++
  [.measureX L.z [] [.CZ (outAt hd 0 L.z) (outAt ld 0 L.z)]] ++
  eraseDecoderA hd ++ eraseDecoderA ld

theorem pack_eq_generatedPackA (L : Layout) (B : Nat) :
    pack L B = generatedPackA L B := by
  rfl

theorem pack_eq_core_finalizeA (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    pack L B = packSweepCoreA L B ++ packFinalizeA L B := by
  rw [pack_eq_generatedPackA]
  unfold packSweepCoreA
  rw [packSweepProgramA_eq_generated L B hB]
  simp [generatedPackA, packInitA, packArithmeticA, packFinalizeA,
    List.append_assoc]

set_option maxHeartbeats 1200000 in
theorem pack_spec (L : Layout) (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (s : State) (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    (run (pack L B) m s).phase = s.phase ∧
      CompactCode L B u v sigma (run (pack L B) m s).basis := by
  let pc := packSweepCoreA L B
  let pf := packFinalizeA L B
  let mc := m.take (measurementCount pc)
  let mf := m.drop (measurementCount pc)
  let mid := run pc mc s
  let out := run pf mf mid
  have hcore := packSweepCore_correctA L B u v sigma hdomain hn s mc hc
  change mid.phase = s.phase ∧ ∃ fin,
    PackSweepInvariant B u v sigma 0 fin ∧
    RealizesUnpackSweep L B fin mid.basis ∧
    mid.basis (L.D (B - 1)) = sigma ∧
    mid.basis (L.S 0) = false ∧
    mid.basis (L.S (B - 1)) = false ∧
    (∀ q ∈ reg L.C (B - 2), mid.basis q = false) at hcore
  rcases hcore.2 with ⟨fin, hinv, hreal, hsig, hs0, hstop, hcarry⟩
  have hfinal := packFinalize_correctA L B u v sigma hdomain hn fin mid mf
    hinv hreal hsig hs0 hstop hcarry
  change out.phase = mid.phase ∧ CompactCode L B u v sigma out.basis at hfinal
  have hrun : run (pack L B) m s = out := by
    rw [pack_eq_core_finalizeA L B hdomain.1]
    simp only [run_append, pc, pf, mc, mf, mid, out]
  rw [hrun]
  exact ⟨hfinal.1.trans hcore.1, hfinal.2⟩

theorem pack_handoff (L : Layout) (B : Nat) :
    ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
      ∀ s m, CodecInput L B u v sigma s.basis →
        (run (pack L B) m s).phase = s.phase ∧
        CompactCode L B u v sigma (run (pack L B) m s).basis := by
  intro u v sigma hdomain hn s m hc
  exact pack_spec L B u v sigma hdomain hn s m hc

theorem functionalSpecA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : FunctionalSpec L B := by
  exact functionalSpec_of_pack L B hB hn (pack_handoff L B)

end ECDSAAdd.Entrant.StairCodec.PackA
