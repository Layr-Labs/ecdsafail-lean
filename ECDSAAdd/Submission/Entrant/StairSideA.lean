  · exact clear q (by simp only [BoundaryClean.zeros, List.mem_append, List.mem_range'_1]; (first | omega | (unfold Wire; omega)))
  · rw [leave_keeps j h0 h1 q (by unfold leaveBox2; (first | omega | (unfold Wire; omega))) m v]
