def firstJointBack : Program :=
  cell false 0 4 2 ++
  triple 3 1 2 d3short ++ triple 4 1 2 e3short ++ cell false 0 3 2 ++
  triple 4 1 2 d3 ++ triple 1 3 4 e3 ++ cellWith false (P1Life.mend (base 760) base (base 2409)) 0 2 4 ++
