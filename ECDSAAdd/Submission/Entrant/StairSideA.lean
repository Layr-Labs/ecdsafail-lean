/-! ### merged from `ECDSAAdd.Submission.Entrant.StairRestSupportCheck_at_StairSideA` -/
section Merge_StairRestSupportCheck_at_StairSideA

/-!
# Support of the hosted rests: a kernel-checkable domain test

`goodCheck P` tests, instruction by instruction, that every operand of `P`
(including measurement-correction targets) lies in `InDom`.  It is a plain
`List`/`Bool` computation, so `decide +kernel` can evaluate it on a concrete
program without building `Finset`s; `good_of_check` turns a successful check
into `Good P`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000

namespace ECDSAAdd.Entrant.StairRestSupport

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed

/-- Operands of a correction list, as a list. -/
def corrList : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: corrList cs
  | .CZ a b :: cs => a :: b :: corrList cs

/-- Operands of one instruction, as a list. -/
def instrList : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (corrList c₀ ++ corrList c₁)

theorem mem_corrList (q : Wire) :
    ∀ cs : List Correction, q ∈ correctionWires cs → q ∈ corrList cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [corrList, List.mem_cons]
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (mem_corrList q cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      simp only [corrList, List.mem_cons]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (mem_corrList q cs h))

theorem mem_instrList (q : Wire) (i : Instr) (h : q ∈ Instr.wires i) :
    q ∈ instrList i := by
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at h
      simp only [instrList, List.mem_singleton]
      exact h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [instrList, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [instrList, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | measureX t c₀ c₁ =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [instrList, List.mem_cons, List.mem_append]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl (mem_corrList q c₀ h))
      · exact Or.inr (Or.inr (mem_corrList q c₁ h))

/-- Kernel-evaluable domain test. -/
def goodCheck (P : Program) : Bool :=
  P.all (fun i => (instrList i).all (fun q => decide (InDom q)))

theorem good_of_check (P : Program) (h : goodCheck P = true) : Good P := by
  induction P with
  | nil => exact good_nil
  | cons i P ih =>
      have hc : (instrList i).all (fun q => decide (InDom q)) = true ∧
          goodCheck P = true := by
        simpa only [goodCheck, List.all_cons, Bool.and_eq_true] using h
      intro q hq
      rw [wires, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact of_decide_eq_true (List.all_eq_true.mp hc.1 q (mem_instrList q i hq))
      · exact ih hc.2 q hq


end ECDSAAdd.Entrant.StairRestSupport

end
end Merge_StairRestSupportCheck_at_StairSideA

