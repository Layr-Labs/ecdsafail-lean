  have b : wires [Instr.CX flag g, Instr.measureX flag [] [.Z g]] ⊆ callerDomain :=
    allCaller_sound _ (by simp [allCaller, instrCaller, corrCaller, ng, nf])
  unfold ControlLoan1589.loanWindow
  exact wires_sub_of_parts _ _
    (wires_sub_of_parts _ _ a (rename_caller _ (preserves_swap c g hc hg) _ hP)) b

