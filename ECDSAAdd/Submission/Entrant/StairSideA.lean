/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField13V3CleanPhase_at_StairSideA` -/
section Merge_StairField13V3CleanPhase_at_StairSideA

/-!
# Field 13 on v3: the 44 roles after the logical first phase (LT29)

`phaseRoles_clean : CutClean EntryPre (cut eps 1) (exclusiveRoles.map fieldMap)`.

Through `phaseHost` the roles are, in phase coordinates, the wires
`base 1542, 1026, 1541` (for roles 720, 721, 722) and `base 723 .. 764`
(the others).  After the native seed the state is the record's compact walk
stage 1 (`caller_first_stageW`); the record ticks 1..424 of
`Rolling1588TickGap.forward` reach the encoded stage 425
(`forward_gen`, `regularForward_spec`).  At that stage the extension bits
`base (j + 258)`, `j ≥ 425`, the carry block and the released part of the
`b` pool are zero, and the history encoder never touches these wires
(`prefix_disjoint_layout`, tick-508 layout).  The stair `firstPack` keeps
them (kernel check `chk_keep_firstPack`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed Secp256k1 BalancedField
open StairField13V3

theorem regValue_congr' : ∀ (r : List Wire) (a b : BasisState), (∀ q ∈ r, a q = b q) →
    regValue r a = regValue r b := by
  intro r
  induction r with
  | nil => intro a b _; rfl
  | cons w r ih =>
    intro a b h
    simp only [regValue, List.foldr] at ih ⊢
    rw [h w (by simp), ih a b (fun q hq => h q (by simp [hq]))]


theorem block_disjoint (q : Wire) (hq : q ∈ wireBlock base 770 256) : q ∉ wireBlock base 2056 256 := by
  intro hn
  simp only [wireBlock, List.mem_map, List.mem_range'_1] at hq hn
  obtain ⟨i, hi, rfl⟩ := hq
  obtain ⟨j, hj, e⟩ := hn
  have := base_injective e
  omega

/-- The division kernel input is a skywalk arithmetic input (numerator
`centerWord (Y/2)`). -/
theorem entryInput {t : State} (F : StairConcreteAssembly.EntryFrame t) :
    SkywalkArithmeticInput base F.x (centerWord (F.Y / 2)) t.basis := by
  obtain ⟨hdiv, -, hzero⟩ := F.input
  refine ⟨?_, F.numerator, ?_⟩
  · rw [← hdiv]
    exact regValue_congr' _ _ _ (fun q hq => F.outsideNumerator q (block_disjoint q hq))
  · intro q hq h1 h2
    rw [F.outsideNumerator q h2]
    exact hzero q hq h1 h2

/-- Phase-site zeros of the input. -/
theorem entry_zero {t : State} (F : StairConcreteAssembly.EntryFrame t) (l : Nat)
    (hl : l < 2314) (h1 : ¬(770 ≤ l ∧ l < 1026)) (h2 : ¬(2056 ≤ l ∧ l < 2312)) :
    t.basis (base l) = false := by
  have hin := entryInput F
  apply hin.2.2
  · simp only [skywalkSharedWires, wireBlock, List.mem_map, List.mem_range'_1]
    exact ⟨l, ⟨by omega, by omega⟩, rfl⟩
  · simp only [skywalkArithmeticDivisor, wireBlock, List.mem_map, List.mem_range'_1]
    rintro ⟨i, hi, e⟩
    have := base_injective e
    omega
  · simp only [skywalkArithmeticNumerator, wireBlock, List.mem_map, List.mem_range'_1]
    rintro ⟨i, hi, e⟩
    have := base_injective e
    omega

