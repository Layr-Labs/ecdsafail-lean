  refine ztAll_of_suffix lo width _ _ _ _ hr' ?_
  refine k1_ztAll_rebind lo width false _ hr' _ _ _ (fun w hw => ⟨hRoles w hw, fun hh => ?_⟩) ?_
  · rw [StairLoan.layerHosts, List.mem_map] at hh
    obtain ⟨l, hl, rfl⟩ := hh
    refine hHosts _ (List.mem_of_mem_drop hw) ?_
    rw [StairLoan.layerHosts, List.mem_map]
    exact ⟨l, k3_take_sub ls d (D + 1) (by omega) l hl, rfl⟩
  rw [StairLoan.emitSweep]
  refine ztAll_of_suffix lo width _ _ _ _ hr' ?_
  have split : ls.drop (d + 1) = (ls.drop (d + 1)).take (D - d) ++ ls.drop (D + 1) := by
    conv_lhs => rw [← List.take_append_drop (D - d) (ls.drop (d + 1))]
    rw [List.drop_drop]
    congr 2
    omega
