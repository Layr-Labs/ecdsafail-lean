section Merge_StairSquareContract_at_QTop

/-! # LT40: shared shapes for the square-hosting units (LT36–LT40)

The concrete square layout, the body contracts (exactly the hypotheses the record's generic square
theorems ask of a body), the record's branch wrappers with the body as a parameter, and the state
facts that hold at every branch boundary of the record core. -/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairSquareContract

open ECDSAAdd Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout ControlledPointLayout

abbrev L0 : ControlledPointLayout := Baselines.layout
abbrev K0 : CuccaroStreamedSquareWideLayout := L0.dialogStreamedSquareWide
abbrev E0 : List Wire := OwnDiagAll12Square.kext L0
abbrev G0 : Wire := L0.core.generic
abbrev D0 : Wire := L0.core.poolWire 1540



/-- B body: the shapes of `B95SelectorResearch.selected_support` / `selected_frame`. -/
structure BodyBOK (B : Program) : Prop where
  support : wires B ⊆ (G0 :: K0.wires).toFinset
  frame : ∀ (base : BasisState) (M : Nat), M < 2^128 → regValue K0.core.product base = M^2 →
    K0.PairClean base → base K0.core.sumCarry = false → ∀ O, O < SquareReduction.p →
    (base G0 = false → M = 0) → (M = if base G0 then regValue K0.core.high base else 0) →
    Triple (SquareFrame K0.core.out base O) B
      (SquareFrame K0.core.out base (ControlLoan1589BFFold.bO4 (M^2) (base G0) O))


/-- State facts true at every branch boundary of the record core. -/
structure BranchPre (t : State) : Prop where
  outLt : regValue K0.core.out t.basis < SquareReduction.p
  prod0 : regValue K0.core.product t.basis = 0
  clean : K0.PairClean t.basis
  sum0 : t.basis K0.core.sumCarry = false
  ext0 : regValue E0 t.basis = 0
  d0 : t.basis D0 = false

end ECDSAAdd.Entrant.StairSquareContract

end
