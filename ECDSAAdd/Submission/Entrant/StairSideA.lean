    packetSequence_slots_le divide (StairGroups.packet divide d)
      (Rolling1588.packet divide) (280 * d) first count
      (fun j => groupPacket_slots_le divide d j hd)


























theorem reverse_slots_add (i n m : Nat) :
    gateSlots (Rolling1588.reverse true i (n + m)) =
      gateSlots (Rolling1588.reverse true i n) +
        gateSlots (Rolling1588.reverse true (i + n) m) := by
  induction n generalizing i with
  | zero => simp [Rolling1588.reverse, gateSlots]
  | succ n ih =>
      simp only [Nat.succ_add, Nat.add_one, Rolling1588.reverse,
        gateSlots_append, ih]
      rw [show (i + n).succ = i + n.succ by omega]
      omega



