/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanAssembly_at_StairSideA` -/
section Merge_StairDivLoanAssembly_at_StairSideA

/-!
# Division-endpoint decoder loan: assembly of `cellDecoderLoan_run_eq`

Part 1 (`StairDivLoanRearrange`): `cellDecoderNext` ≡ `cellDecoderUnloan` on every record.
Part 2 (`StairDivLoanPrefix`): the prefix half of the loan lemma on `tailL`.
Part 3 (LT15, `StairDivLoanTop`): the upper-sweep window facts and record independence.

Hypotheses of `cellDecoderLoan_run_eq` are exactly those of `CompareDecoder.cellDecoderNext_correct`.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed BalancedField

theorem cellDecoderSweep_eq_unloan : cellDecoderSweep = cellDecoderUnloan := rfl

theorem loanPre_eq_windowPre760 : loanPre = windowPre760 := rfl

theorem cellDecoderLoan_run_eq (Y : Fp) (sigma : Bool) (s : State) (m n : List Bool)
    (ys : regValue fixedLayout.y s.basis = centerWord Y)
    (rs : regValue fixedLayout.r s.basis = centerWord ((if sigma then 1 else 3) * Y))
    (sig : s.basis fixedLayout.sigma = sigma)
    (hc : s.basis fixedLayout.h = false) (bc : s.basis fixedLayout.bias = false)
    (cc : ∀ q ∈ fixedLayout.carry, s.basis q = false) :
    run cellDecoderLoan m s = run cellDecoderNext n s := by
  have nextFree := cellDecoderNext_tapeFree Y sigma s ys rs sig hc bc cc
  -- K4-D (replay budget): the program names are rewritten to the lemmas' syntactic forms first, so no kernel
  -- conversion has to compare `run P` with `run P'` for `P = P'` only by unfolding
  have sweepFree := sweepFree_of_part1 Y sigma s ys rs sig hc bc cc
    (fun a b => by rw [cellDecoderSweep_eq_unloan]; exact (cellDecoderUnloan_run a s).trans (nextFree a b))
  refine cellDecoderLoan_run_eq_of s m n nextFree (fun a => ⟨loanPre_clean s cc a, ?_, ?_, ?_, ?_⟩)
  · have h := upper_tapeFree s a sweepFree
    rw [← loanPre_eq_windowPre760] at h
    intro rec
    unfold upperState prefixState loanUpper
    exact h rec
  · unfold upperState prefixState loanUpper tailYs tailCs tailCin
    exact upper_same_all _ []
  · unfold upperState prefixState loanUpper
    exact upper_roles_zero_all _ []
  · have h := window_tapeFree s a sweepFree
    rw [← loanPre_eq_windowPre760] at h
    exact h

end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan
end Merge_StairDivLoanAssembly_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanEp1_at_StairSideA` -/
section Merge_StairDivLoanEp1_at_StairSideA

/-!
# Division-endpoint loan: lift of `cellDecoderLoan_run_eq` through the endpoint wrappers

`endPacket760DivLoan` and `R2SqEp760.endPacket760 true` differ only in the decoder inside
`renameProgram (swap 760 717) ∘ renameProgram (shifted pi0) ∘ ControlLoan1589.loanWindow 510 2409 719`.
The lift follows the record's route (`endHalf_run_eq`, `rawEnd_run_eq`, `rawEnd_frame`,
`endPacket_frame`, `endPacket760_run_eq`) with same-record equalities at every layer, and uses
record independence of `endPacket760 true` (phase from `endPacket760_frame`) at the end.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
  Secp256k1 BalancedField Challenge Baselines

/-- `cellDecoderLoan_run_eq` under the hypotheses of `CompareDecoder.cellDecoderNext_frame`. -/
theorem cellDecoderLoan_run_eq_frame (origin : BasisState)
    (clean : ∀q∈work fixedLayout,origin q=false) (X Y : Fp)
    (hend : (X+(if origin fixedLayout.sigma then Y else -Y))/2=Y) (s : State)
    (input : PairFrame fixedLayout.r fixedLayout.y origin (centerWord X) (centerWord Y) s.basis)
    (m n : List Bool) :
    run cellDecoderLoan m s = run cellDecoderNext n s := by
  have cleanS (q : Wire) (hq:q∈work fixedLayout) : s.basis q=false :=
    (input.2.2 q (work_away fixedLayout fixed_nodup q hq).1
      (work_away fixedLayout fixed_nodup q hq).2).trans (clean q hq)
  have sig : s.basis fixedLayout.sigma=origin fixedLayout.sigma := input.2.2 fixedLayout.sigma
    (source_r_away fixedLayout fixed_nodup _ (by tauto))
    (flag_y_away fixedLayout fixed_nodup _ (by simp))
  have rel := terminal_relation X Y (origin fixedLayout.sigma) hend
  have rword : regValue fixedLayout.r s.basis=
      centerWord ((if origin fixedLayout.sigma then 1 else 3)*Y) := by
    rw [input.1,rel]
  exact cellDecoderLoan_run_eq Y (origin fixedLayout.sigma) s m n input.2.1 rword sig
    (cleanS fixedLayout.h (by simp [work])) (cleanS fixedLayout.bias (by simp [work]))
    (fun q hq=>cleanS q (by simp [work,hq]))

end ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan

namespace ECDSAAdd.Entrant.Rolling1588Lifetime

open Arithmetic MappedCompressed DirectSkywalk Secp256k1 BalancedField OffsetBorrowedCanonical

/-! ## Loaned endpoint pieces -/

def endHalfLoan : Program :=
  CompareDecoder.BoundaryLoan.cellDecoderLoan ++ List.replicate 507 (Instr.measureX (base 512) [] [])

def rawEndLoan : Program :=
  ControlLoan1589.loanWindow (base 510) (base 2409) (base 719) endHalfLoan

theorem endPacket760DivLoan_shape : CompareDecoder.BoundaryLoan.endPacket760DivLoan =
    renameProgram (Equiv.swap (base 760) (base 717))
      (renameProgram (shifted Placement5.pi0) rawEndLoan) := rfl

