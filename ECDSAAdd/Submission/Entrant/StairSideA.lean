theorem packetSequence_caller (forward : Bool) (p : Nat → Program) (n : Nat) :
    ∀ j, (∀ k, j ≤ k → k < j + n → wires (p k) ⊆ callerDomain) →
      wires (PacketSequence.program forward p j n) ⊆ callerDomain := by
  induction n with
  | zero =>
    intro j _
    simp [PacketSequence.program, wires]
  | succ n ih =>
    intro j h
    have here := h j le_rfl (by omega)
    have rest := ih (j + 1) (fun k h1 h2 => h k (by omega) (by omega))
    cases forward
    · simp only [PacketSequence.program, Bool.false_eq_true, if_false]
      exact wires_sub_of_parts _ _ rest here
    · simp only [PacketSequence.program, if_true]
      exact wires_sub_of_parts _ _ here rest

