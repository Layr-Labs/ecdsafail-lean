section Merge_StairW720Touch_at_QTop

/-!
# S1 (copy of LT28): a complete Boolean "touches" test for program supports

`hits q P = false ↔ q ∉ wires P` (measurement corrections included), so
`decide +kernel` facts about `hits` are exact support facts.
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairW720

open ECDSAAdd

def corrHits (q : Wire) : List Correction → Bool
  | [] => false
  | .Z t :: cs => t == q || corrHits q cs
  | .CZ a b :: cs => a == q || b == q || corrHits q cs

def instrHits (q : Wire) : Instr → Bool
  | .X t => t == q
  | .CX c t => c == q || t == q
  | .CCX a b t => a == q || b == q || t == q
  | .measureX t c0 c1 => t == q || corrHits q c0 || corrHits q c1

def hits (q : Wire) : Program → Bool
  | [] => false
  | i :: P => instrHits q i || hits q P

theorem corrHits_false {q : Wire} :
    ∀ cs : List Correction, corrHits q cs = false → q ∉ correctionWires cs
  | [], _ => by simp [correctionWires]
  | .Z t :: cs, h => by
      simp only [corrHits, Bool.or_eq_false_iff, beq_eq_false_iff_ne] at h
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton, not_or]
      exact ⟨fun e => h.1 e.symm, corrHits_false cs h.2⟩
  | .CZ a b :: cs, h => by
      simp only [corrHits, Bool.or_eq_false_iff, beq_eq_false_iff_ne] at h
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton, not_or]
      exact ⟨⟨fun e => h.1.1 e.symm, fun e => h.1.2 e.symm⟩, corrHits_false cs h.2⟩

theorem instrHits_false {q : Wire} (i : Instr) (h : instrHits q i = false) :
    q ∉ i.wires := by
  cases i with
  | X t =>
      simp only [instrHits, beq_eq_false_iff_ne] at h
      simp only [Instr.wires, Finset.mem_singleton]
      exact fun e => h e.symm
  | CX c t =>
      simp only [instrHits, Bool.or_eq_false_iff, beq_eq_false_iff_ne] at h
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun e => h.1 e.symm, fun e => h.2 e.symm⟩
  | CCX a b t =>
      simp only [instrHits, Bool.or_eq_false_iff, beq_eq_false_iff_ne] at h
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun e => h.1.1 e.symm, fun e => h.1.2 e.symm, fun e => h.2 e.symm⟩
  | measureX t c0 c1 =>
      simp only [instrHits, Bool.or_eq_false_iff, beq_eq_false_iff_ne] at h
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton, not_or]
      exact ⟨⟨fun e => h.1.1 e.symm, corrHits_false c0 h.1.2⟩, corrHits_false c1 h.2⟩

theorem hits_false {q : Wire} : ∀ P : Program, hits q P = false → q ∉ wires P
  | [], _ => by simp [wires]
  | i :: P, h => by
      simp only [hits, Bool.or_eq_false_iff] at h
      simp only [wires, Finset.mem_union, not_or]
      exact ⟨instrHits_false i h.1, hits_false P h.2⟩


end ECDSAAdd.Entrant.StairW720

end
end Merge_StairW720Touch_at_QTop

