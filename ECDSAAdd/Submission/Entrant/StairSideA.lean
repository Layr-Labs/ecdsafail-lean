/-- Two states with the same phase and the same complete `PointDialogValues`
description are equal. -/
theorem state_eq_of_values {L : ControlledPointLayout} {X Y : Fp} {G : Bool}
    {base : BasisState} {s a b : State}
    (ha : a.phase = s.phase ∧ PointDialogValues L X Y G base a.basis)
    (hb : b.phase = s.phase ∧ PointDialogValues L X Y G base b.basis) : a = b := by
  apply State.extensionality
  · exact ha.1.trans hb.1.symm
  · funext q
    by_cases hx : q ∈ L.point.x
    · exact (regValue_eq_iff _ _ _).mp (ha.2.x.trans hb.2.x.symm) q hx
    by_cases hy : q ∈ L.point.y
    · exact (regValue_eq_iff _ _ _).mp (ha.2.y.trans hb.2.y.symm) q hy
    have hq : q ∉ L.point.x ++ L.point.y := by
      simp [hx, hy]
    exact (ha.2.rest q hq).trans (hb.2.rest q hq).symm

