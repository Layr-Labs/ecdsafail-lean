section Merge_StairField2V3ExitTrips_at_StairSideA

/-!
# Primitive round trips for the exit rows (LT24)

Every staircase reverse row is the mirror of the corresponding forward row;
the row round trip `Wᵢ ∘ Fᵢ = id` splits into primitive trips.  This module
proves the placement-only ones and the codec ones (from field 1's
`FunctionalSpec` only):

* `codec_pack_unpack` / `codec_unpack_pack` — `StairCodec.unpack ∘ pack = id`
  on `CodecInput` states and `pack ∘ unpack = id` on `CompactCode` states;
* `run_flatten_reverse` — pairwise wire-disjoint blocks run in any order
  (here: reversed);
* `relocate_trip`, `unrelocate_trip`, `phaseB_trip` — unconditional (CX moves);
* `orient_trip` — the codec orientation is an involution (unconditional);
* `pack_trip`, `unpack_trip` — the physical row codec
  (`signExt · pack · relocate`, `unrelocate · unpack · signExt`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3ExitTrips

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open StairField2V3ExitGates

/-! ## Codec trips from the functional specification -/

private theorem declared_cases (L : StairCodec.Layout) (B : Nat) (q : Wire)
    (hq : q ∈ StairCodec.declaredSites L B) :
    q ∈ StairCodec.reg L.S B ∨ q ∈ StairCodec.reg L.D B ∨
      q ∈ StairCodec.workSites L B := by
  unfold StairCodec.declaredSites at hq
  simp only [List.mem_append] at hq
  tauto

theorem codecInput_declared_eq (L : StairCodec.Layout) (B u v : Nat)
    (sigma : Bool) (a b : BasisState)
    (ha : StairCodec.CodecInput L B u v sigma a)
    (hb : StairCodec.CodecInput L B u v sigma b) :
    ∀ q ∈ StairCodec.declaredSites L B, a q = b q := by
  intro q hq
  rcases declared_cases L B q hq with hS | hD | hW
  · exact (regValue_eq_iff _ a b).mp (ha.1.trans hb.1.symm) q hS
  · exact (regValue_eq_iff _ a b).mp (ha.2.1.trans hb.2.1.symm) q hD
  · rw [ha.2.2 q hW, hb.2.2 q hW]

theorem codec_pack_unpack (L : StairCodec.Layout) (B u v : Nat) (sigma : Bool)
    (spec : StairCodec.FunctionalSpec L B)
    (domain : StairCodec.CodecDomain B u v sigma) (nodup : L.Nodup B)
    (s : State) (m n : List Bool)
    (input : StairCodec.CodecInput L B u v sigma s.basis) :
    run (StairCodec.unpack L B) n (run (StairCodec.pack L B) m s) = s := by
  have hspec := spec.2.2 u v sigma domain nodup
  have packed := hspec.1 s m input
  have unpacked := hspec.2 (run (StairCodec.pack L B) m s) n packed.2
  have lower : 3 ≤ B := domain.1
  apply State.extensionality
  · exact unpacked.1.trans packed.1
  · funext q
    by_cases hq : q ∈ StairCodec.declaredSites L B
    · exact codecInput_declared_eq L B u v sigma _ _ unpacked.2 input q hq
    · have hp : q ∉ wires (StairCodec.pack L B) := fun used =>
        hq (List.mem_toFinset.mp (StairCodec.pack_support L B lower used))
      have hu : q ∉ wires (StairCodec.unpack L B) := fun used =>
        hq (List.mem_toFinset.mp (StairCodec.unpack_support L B lower used))
      rw [run_preserves_outside _ _ _ q hu, run_preserves_outside _ _ _ q hp]

private theorem mem_reg (f : Nat → Wire) (n : Nat) (q : Wire) (hq : q ∈ StairCodec.reg f n) :
    ∃ i, i < n ∧ q = f i := by
  simp only [StairCodec.reg, List.mem_map, List.mem_range] at hq
  obtain ⟨i, hi, rfl⟩ := hq
  exact ⟨i, hi, rfl⟩

private theorem mem_reg_of (f : Nat → Wire) (n i : Nat) (hi : i < n) :
    f i ∈ StairCodec.reg f n := by
  simp only [StairCodec.reg, List.mem_map, List.mem_range]
  exact ⟨i, hi, rfl⟩

theorem compactCode_declared_eq (L : StairCodec.Layout) (B u v : Nat) (hB : 3 ≤ B)
    (sigma : Bool) (a b : BasisState)
    (ha : StairCodec.CompactCode L B u v sigma a)
    (hb : StairCodec.CompactCode L B u v sigma b) :
    ∀ q ∈ StairCodec.declaredSites L B, a q = b q := by
  obtain ⟨ha1, ha2, ha3, ha4, ha5, ha6⟩ := ha
  obtain ⟨hb1, hb2, hb3, hb4, hb5, hb6⟩ := hb
  intro q hq
  rcases declared_cases L B q hq with hS | hD | hW
  · exact (regValue_eq_iff _ a b).mp (ha5.trans hb5.symm) q hS
  · obtain ⟨i, hi, rfl⟩ := mem_reg L.D B q hD
    by_cases h1 : i < B - 2
    · exact (regValue_eq_iff _ a b).mp (ha2.trans hb2.symm) _ (mem_reg_of L.D (B - 2) i h1)
    · by_cases h2 : i = B - 2
      · subst h2; rw [ha3, hb3]
      · have h3 : i = B - 1 := by omega
        subst h3; rw [ha4, hb4]
  · unfold StairCodec.workSites at hW
    simp only [List.mem_append] at hW
    rcases hW with (((hA | hC) | hzt) | hl) | hh
    · exact (regValue_eq_iff _ a b).mp (ha1.trans hb1.symm) q hA
    · have m : q ∈ StairCodec.reg L.C (B - 2) ++ [L.z, L.t] ++ (StairCodec.lowDecoder L B).sites ++
          (StairCodec.highDecoder L B).sites := by simp only [List.mem_append]; tauto
      rw [ha6 q m, hb6 q m]
    · have m : q ∈ StairCodec.reg L.C (B - 2) ++ [L.z, L.t] ++ (StairCodec.lowDecoder L B).sites ++
          (StairCodec.highDecoder L B).sites := by simp only [List.mem_append]; tauto
      rw [ha6 q m, hb6 q m]
    · have m : q ∈ StairCodec.reg L.C (B - 2) ++ [L.z, L.t] ++ (StairCodec.lowDecoder L B).sites ++
          (StairCodec.highDecoder L B).sites := by simp only [List.mem_append]; tauto
      rw [ha6 q m, hb6 q m]
    · have m : q ∈ StairCodec.reg L.C (B - 2) ++ [L.z, L.t] ++ (StairCodec.lowDecoder L B).sites ++
          (StairCodec.highDecoder L B).sites := by simp only [List.mem_append]; tauto
      rw [ha6 q m, hb6 q m]

theorem codec_unpack_pack (L : StairCodec.Layout) (B u v : Nat) (sigma : Bool)
    (spec : StairCodec.FunctionalSpec L B)
    (domain : StairCodec.CodecDomain B u v sigma) (nodup : L.Nodup B)
    (s : State) (m n : List Bool)
    (code : StairCodec.CompactCode L B u v sigma s.basis) :
    run (StairCodec.pack L B) n (run (StairCodec.unpack L B) m s) = s := by
  have hspec := spec.2.2 u v sigma domain nodup
  have unpacked := hspec.2 s m code
  have packed := hspec.1 (run (StairCodec.unpack L B) m s) n unpacked.2
  have lower : 3 ≤ B := domain.1
  apply State.extensionality
  · exact packed.1.trans unpacked.1
  · funext q
    by_cases hq : q ∈ StairCodec.declaredSites L B
    · exact compactCode_declared_eq L B u v lower sigma _ _ packed.2 code q hq
    · have hp : q ∉ wires (StairCodec.pack L B) := fun used =>
        hq (List.mem_toFinset.mp (StairCodec.pack_support L B lower used))
      have hu : q ∉ wires (StairCodec.unpack L B) := fun used =>
        hq (List.mem_toFinset.mp (StairCodec.unpack_support L B lower used))
      rw [run_preserves_outside _ _ _ q hp, run_preserves_outside _ _ _ q hu]

/-! ## Reordering wire-disjoint blocks -/

theorem wires_flatten_mem (L : List Program) (q : Wire) (hq : q ∈ wires L.flatten) :
    ∃ P ∈ L, q ∈ wires P := by
  induction L with
  | nil => simp [wires] at hq
  | cons P L ih =>
      simp only [List.flatten_cons, wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · exact ⟨P, by simp, h⟩
      · obtain ⟨Q, hQ, hq⟩ := ih h
        exact ⟨Q, by simp [hQ], hq⟩

theorem run_flatten_reverse (L : List Program)
    (hd : L.Pairwise (fun P Q => Disjoint (wires P) (wires Q))) (s : State) :
    run L.reverse.flatten [] s = run L.flatten [] s := by
  induction L generalizing s with
  | nil => rfl
  | cons P L ih =>
      rw [List.pairwise_cons] at hd
      have dis : Disjoint (wires P) (wires L.flatten) := by
        rw [Finset.disjoint_right]
        intro q hq hP
        obtain ⟨Q, hQ, hq'⟩ := wires_flatten_mem L q hq
        exact Finset.disjoint_left.mp (hd.1 Q hQ) hP hq'
      rw [List.reverse_cons, List.flatten_append, run_append]
      simp only [List.take_nil, List.drop_nil, List.flatten_cons, List.flatten_nil,
        List.append_nil]
      rw [ih hd.2, run_append P]
      simp only [List.take_nil, List.drop_nil]
      exact run_disjoint_commute P L.flatten dis [] [] s

/-- Swap-free "move" blocks `[CX a b, CX b a]` are good gates. -/
theorem moveWire_good (a b : Wire) (h : a ≠ b) :
    ∀ g ∈ StairPhysicalLayout.moveWire a b, Good g := by
  intro g hg
  simp only [StairPhysicalLayout.moveWire, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl
  · exact ⟨trivial, by simp [tgt, ctrlWires]; exact Ne.symm h⟩
  · exact ⟨trivial, by simp [tgt, ctrlWires]; exact h⟩

theorem moveWire_reverse (a b : Wire) :
    (StairPhysicalLayout.moveWire a b).reverse = StairPhysicalLayout.moveWire b a := rfl


theorem rev_flatMap (L : List Nat) (f : Nat → Program) :
    (L.flatMap f).reverse = (L.reverse.map (fun i => (f i).reverse)).flatten := by
  induction L with
  | nil => rfl
  | cons a L ih =>
      simp only [List.flatMap_cons, List.reverse_append, ih, List.reverse_cons, List.map_append,
        List.map_cons, List.map_nil, List.flatten_append, List.flatten_cons, List.flatten_nil,
        List.append_nil]

theorem flatMap_eq_flatten (L : List Nat) (f : Nat → Program) :
    L.flatMap f = (L.map f).flatten := by
  induction L with
  | nil => rfl
  | cons a L ih => simp only [List.flatMap_cons, ih, List.map_cons, List.flatten_cons]

theorem wires_moveWire (x y q : Wire) (hq : q ∈ wires (StairPhysicalLayout.moveWire x y)) :
    q = x ∨ q = y := by
  simp [StairPhysicalLayout.moveWire, wires, Instr.wires] at hq
  tauto

/-- A family of disjoint CX moves is undone by the opposite moves. -/
theorem moves_trip (n : Nat) (a b : Nat → Wire)
    (hab : ∀ i < n, ∀ j < n, a i ≠ b j)
    (ha : ∀ i < n, ∀ j < n, a i = a j → i = j)
    (hb : ∀ i < n, ∀ j < n, b i = b j → i = j) (s : State) :
    run ((List.range n).flatMap (fun i => StairPhysicalLayout.moveWire (b i) (a i))) []
        (run ((List.range n).flatMap (fun i => StairPhysicalLayout.moveWire (a i) (b i))) [] s) = s := by
  have good : ∀ g ∈ (List.range n).flatMap (fun i => StairPhysicalLayout.moveWire (a i) (b i)),
      Good g := by
    intro g hg
    simp only [List.mem_flatMap, List.mem_range] at hg
    obtain ⟨i, hi, hg⟩ := hg
    exact moveWire_good (a i) (b i) (hab i hi i hi) g hg
  have pw : ((List.range n).map (fun i => StairPhysicalLayout.moveWire (b i) (a i))).Pairwise
      (fun P Q => Disjoint (wires P) (wires Q)) := by
    rw [List.pairwise_map]
    apply List.Pairwise.imp_of_mem _ (List.pairwise_lt_range (n := n))
    intro i j hi hj hij
    rw [List.mem_range] at hi hj
    rw [Finset.disjoint_left]
    intro q hq hq'
    rcases wires_moveWire _ _ q hq with h1 | h1 <;> rcases wires_moveWire _ _ q hq' with h2 | h2
    · exact absurd (hb i hi j hj (h1.symm.trans h2)) (by omega)
    · exact hab j hj i hi (h2.symm.trans h1)
    · exact hab i hi j hj (h1.symm.trans h2)
    · exact absurd (ha i hi j hj (h1.symm.trans h2)) (by omega)
  have rev := run_reverse_cancel _ good s
  rw [rev_flatMap] at rev
  simp only [moveWire_reverse] at rev
  rw [List.map_reverse, run_flatten_reverse _ pw, ← flatMap_eq_flatten] at rev
  exact rev


theorem flatMap_congr_range (m : Nat) (f g : Nat → Program) (h : ∀ i < m, f i = g i) :
    (List.range m).flatMap f = (List.range m).flatMap g := by
  rw [flatMap_eq_flatten, flatMap_eq_flatten]
  congr 1
  apply List.map_congr_left
  intro i hi
  exact h i (List.mem_range.mp hi)

theorem wires_moves (m : Nat) (a b : Nat → Wire) (q : Wire)
    (hq : q ∈ wires ((List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (a i) (b i)))) :
    ∃ i < m, q = a i ∨ q = b i := by
  rw [flatMap_eq_flatten] at hq
  obtain ⟨P, hP, hq⟩ := wires_flatten_mem _ q hq
  simp only [List.mem_map, List.mem_range] at hP
  obtain ⟨i, hi, rfl⟩ := hP
  exact ⟨i, hi, wires_moveWire _ _ q hq⟩

/-- The relocation shape `moves(D→S, i<m) · move(dl→sl)` is undone by
`move(sl→dl) · moves(S→D, i<m)`. -/
theorem relocate_like_trip (m : Nat) (D S : Nat → Wire) (dl sl : Wire)
    (hab : ∀ i < m + 1, ∀ j < m + 1, (if i < m then D i else dl) ≠ (if j < m then S j else sl))
    (ha : ∀ i < m + 1, ∀ j < m + 1,
      (if i < m then D i else dl) = (if j < m then D j else dl) → i = j)
    (hb : ∀ i < m + 1, ∀ j < m + 1,
      (if i < m then S i else sl) = (if j < m then S j else sl) → i = j) (s : State) :
    run (StairPhysicalLayout.moveWire sl dl ++
        (List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (S i) (D i))) []
      (run ((List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (D i) (S i)) ++
        StairPhysicalLayout.moveWire dl sl) [] s) = s := by
  let a : Nat → Wire := fun i => if i < m then D i else dl
  let b : Nat → Wire := fun i => if i < m then S i else sl
  have fwd : (List.range (m + 1)).flatMap (fun i => StairPhysicalLayout.moveWire (a i) (b i)) =
      (List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (D i) (S i)) ++
        StairPhysicalLayout.moveWire dl sl := by
    rw [List.range_succ, List.flatMap_append]
    congr 1
    · apply flatMap_congr_range
      intro i hi
      simp only [a, b, if_pos hi]
    · simp [a, b]
  have bwd : (List.range (m + 1)).flatMap (fun i => StairPhysicalLayout.moveWire (b i) (a i)) =
      (List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (S i) (D i)) ++
        StairPhysicalLayout.moveWire sl dl := by
    rw [List.range_succ, List.flatMap_append]
    congr 1
    · apply flatMap_congr_range
      intro i hi
      simp only [a, b, if_pos hi]
    · simp [a, b]
  have trip := moves_trip (m + 1) a b hab ha hb s
  rw [fwd, bwd] at trip
  have dis : Disjoint (wires (StairPhysicalLayout.moveWire sl dl))
      (wires ((List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (S i) (D i)))) := by
    rw [Finset.disjoint_left]
    intro q hq hq'
    obtain ⟨i, hi, hi'⟩ := wires_moves m S D q hq'
    rcases wires_moveWire _ _ q hq with h | h <;> rcases hi' with h' | h'
    · have := hb m (by omega) i (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h.symm.trans h')
      omega
    · exact hab i (by omega) m (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h'.symm.trans h)
    · exact hab m (by omega) i (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h.symm.trans h')
    · have := ha m (by omega) i (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h.symm.trans h')
      omega
  rw [run_append (StairPhysicalLayout.moveWire sl dl)]
  simp only [List.take_nil, List.drop_nil]
  rw [run_disjoint_commute _ _ dis.symm [] []]
  rw [run_append_nil ((List.range m).flatMap (fun i => StairPhysicalLayout.moveWire (S i) (D i)))
    (StairPhysicalLayout.moveWire sl dl)] at trip
  exact trip

end ECDSAAdd.Entrant.StairField2V3ExitTrips

end
end Merge_StairField2V3ExitTrips_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitRowTrips_at_StairSideA` -/
section Merge_StairField2V3ExitRowTrips_at_StairSideA

/-!
# Concrete primitive round trips of the v3 rows (LT24)

For every budget `B ∈ {87, 62, 47, 32, 22, 12}` of the v3 table:

* `relocate_trip`, `unrelocate_trip` — `unrelocate B ∘ relocate B = id`,
  `relocate B ∘ unrelocate B = id` (unconditional);
* `phaseB_trip`, `phaseB_trip'` — `phaseBReturn ∘ phaseBMove = id` and back;
* `orient_trip` — `StairV3Primitives.orient i` is an involution for the six
  row letters `i ∈ {425, 450, 465, 480, 490, 500}` (unconditional);
* `pack_trip` / `unpack_trip` — the physical row codec
  (`StairPhysicalPrimitives.pack/unpack`) round trips from field 1's
  `FunctionalSpec`, on `CodecInput` / `CompactCode` states.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3ExitRowTrips

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairField2V3ExitGates StairField2V3ExitTrips StairPhysicalLayout

/-! ## Reverse-direction relocation shape -/

theorem relocate_like_trip' (m : Nat) (D S : Nat → Wire) (dl sl : Wire)
    (hab : ∀ i < m + 1, ∀ j < m + 1, (if i < m then D i else dl) ≠ (if j < m then S j else sl))
    (ha : ∀ i < m + 1, ∀ j < m + 1,
      (if i < m then D i else dl) = (if j < m then D j else dl) → i = j)
    (hb : ∀ i < m + 1, ∀ j < m + 1,
      (if i < m then S i else sl) = (if j < m then S j else sl) → i = j) (s : State) :
    run ((List.range m).flatMap (fun i => moveWire (D i) (S i)) ++ moveWire dl sl) []
      (run (moveWire sl dl ++ (List.range m).flatMap (fun i => moveWire (S i) (D i))) [] s) = s := by
  let a : Nat → Wire := fun i => if i < m then D i else dl
  let b : Nat → Wire := fun i => if i < m then S i else sl
  have fwd : (List.range (m + 1)).flatMap (fun i => moveWire (a i) (b i)) =
      (List.range m).flatMap (fun i => moveWire (D i) (S i)) ++ moveWire dl sl := by
    rw [List.range_succ, List.flatMap_append]
    congr 1
    · apply flatMap_congr_range
      intro i hi
      simp only [a, b, if_pos hi]
    · simp [a, b]
  have bwd : (List.range (m + 1)).flatMap (fun i => moveWire (b i) (a i)) =
      (List.range m).flatMap (fun i => moveWire (S i) (D i)) ++ moveWire sl dl := by
    rw [List.range_succ, List.flatMap_append]
    congr 1
    · apply flatMap_congr_range
      intro i hi
      simp only [a, b, if_pos hi]
    · simp [a, b]
  have trip := moves_trip (m + 1) b a (fun i hi j hj e => hab j hj i hi e.symm) hb ha s
  rw [fwd, bwd] at trip
  have dis : Disjoint (wires (moveWire sl dl))
      (wires ((List.range m).flatMap (fun i => moveWire (S i) (D i)))) := by
    rw [Finset.disjoint_left]
    intro q hq hq'
    obtain ⟨i, hi, hi'⟩ := wires_moves m S D q hq'
    rcases wires_moveWire _ _ q hq with h | h <;> rcases hi' with h' | h'
    · have := hb m (by omega) i (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h.symm.trans h')
      omega
    · exact hab i (by omega) m (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h'.symm.trans h)
    · exact hab m (by omega) i (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h.symm.trans h')
    · have := ha m (by omega) i (by omega)
        (by simp only [lt_irrefl, if_false, if_pos hi]; exact h.symm.trans h')
      omega
  have e : run (moveWire sl dl ++ (List.range m).flatMap (fun i => moveWire (S i) (D i))) [] s =
      run ((List.range m).flatMap (fun i => moveWire (S i) (D i)) ++ moveWire sl dl) [] s := by
    rw [run_append_nil, run_append_nil]
    exact run_disjoint_commute _ _ dis.symm [] [] s
  rw [e]
  exact trip

/-! ## Static facts of the six rows (decided) -/

def Dl (B : Nat) : Wire := (physicalLayout B).D (B - 1)
def Sl (B : Nat) : Wire := (physicalLayout B).S (B - 2)

def RelocFacts (B : Nat) : Prop :=
  (∀ i < B - 1, ∀ j < B - 1,
      (if i < B - 2 then (physicalLayout B).D i else Dl B) ≠
        (if j < B - 2 then (physicalLayout B).S j else Sl B)) ∧
    (∀ i < B - 1, ∀ j < B - 1,
      (if i < B - 2 then (physicalLayout B).D i else Dl B) =
        (if j < B - 2 then (physicalLayout B).D j else Dl B) → i = j) ∧
    (∀ i < B - 1, ∀ j < B - 1,
      (if i < B - 2 then (physicalLayout B).S i else Sl B) =
        (if j < B - 2 then (physicalLayout B).S j else Sl B) → i = j)

theorem relocFacts : ∀ B ∈ budgets, RelocFacts B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals unfold RelocFacts Dl Sl
  all_goals decide +kernel

theorem budget_ge (B : Nat) (hB : B ∈ budgets) : 3 ≤ B := by
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  omega

theorem relocate_trip (B : Nat) (hB : B ∈ budgets) (s : State) :
    run (unrelocate B) [] (run (relocate B) [] s) = s := by
  obtain ⟨f1, f2, f3⟩ := relocFacts B hB
  have h3 := budget_ge B hB
  have e : B - 2 + 1 = B - 1 := by omega
  exact relocate_like_trip (B - 2) (physicalLayout B).D (physicalLayout B).S (Dl B) (Sl B)
    (by rw [e]; exact f1) (by rw [e]; exact f2) (by rw [e]; exact f3) s

theorem unrelocate_trip (B : Nat) (hB : B ∈ budgets) (s : State) :
    run (relocate B) [] (run (unrelocate B) [] s) = s := by
  obtain ⟨f1, f2, f3⟩ := relocFacts B hB
  have h3 := budget_ge B hB
  have e : B - 2 + 1 = B - 1 := by omega
  exact relocate_like_trip' (B - 2) (physicalLayout B).D (physicalLayout B).S (Dl B) (Sl B)
    (by rw [e]; exact f1) (by rw [e]; exact f2) (by rw [e]; exact f3) s

theorem phaseB_facts :
    (∀ i < 88, ∀ j < 88, base (770 + i) ≠ bSite j) ∧
      (∀ i < 88, ∀ j < 88, base (770 + i) = base (770 + j) → i = j) ∧
      (∀ i < 88, ∀ j < 88, bSite i = bSite j → i = j) := by
  decide +kernel

theorem phaseB_trip (s : State) :
    run StairPhysicalPhase.phaseBReturn [] (run phaseBMove [] s) = s := by
  obtain ⟨f1, f2, f3⟩ := phaseB_facts
  exact moves_trip 88 (fun k => base (770 + k)) bSite f1 f2 f3 s


/-! ## Orientation -/

def OrientFacts (i : Nat) : Prop :=
  let L := physicalLayout (512 - i)
  let a := StairCodec.reg L.S (512 - i) ++ [base 512]
  let b := StairCodec.reg L.D (512 - i) ++ [bSite (512 - i)]
  (∀ x ∈ a, ∀ y ∈ b, x ≠ y) ∧ letterSite (i - 1) ∉ b ∧ a.Nodup ∧ b.Nodup

def rowLetters : List Nat := [425, 450, 465, 480, 490, 500]

theorem orientFacts : ∀ i ∈ rowLetters, OrientFacts i := by
  intro i hi
  simp only [rowLetters, List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals unfold OrientFacts
  all_goals decide +kernel

theorem orient_trip (i : Nat) (hi : i ∈ rowLetters) (s : State) (m n : List Bool) :
    run (StairV3Primitives.orient i) m (run (StairV3Primitives.orient i) n s) = s := by
  obtain ⟨f1, f2, f3, f4⟩ := orientFacts i hi
  exact swapRegisters_involution _ _ _ f1 f2 f3 f4 s m n

/-! ## Physical row codec -/

theorem signExt_good (B : Nat) (h : (physicalLayout B).D (B - 1) ≠ bSite B) :
    Good (Instr.CX ((physicalLayout B).D (B - 1)) (bSite B)) :=
  ⟨trivial, by simp [tgt, ctrlWires]; exact Ne.symm h⟩

theorem signExt_ne : ∀ B ∈ budgets, (physicalLayout B).D (B - 1) ≠ bSite B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem signExt_trip (B : Nat) (hB : B ∈ budgets) (s : State) :
    run (StairPhysicalPrimitives.signExt B) [] (run (StairPhysicalPrimitives.signExt B) [] s) = s :=
  single_involution _ (signExt_good B (signExt_ne B hB)) s


theorem signExt_meas (B : Nat) : measurementCount (StairPhysicalPrimitives.signExt B) = 0 := rfl

theorem relocate_meas (B : Nat) (hB : B ∈ budgets) : measurementCount (relocate B) = 0 :=
  (relocate_counts B hB).2.1

theorem unrelocate_meas (B : Nat) (hB : B ∈ budgets) : measurementCount (unrelocate B) = 0 :=
  (relocate_counts B hB).2.2.2

theorem run_three (A Bp C : Program) (hA : measurementCount A = 0)
    (hC : measurementCount C = 0) (m : List Bool) (s : State) :
    run (A ++ Bp ++ C) m s = run C [] (run Bp m (run A [] s)) := by
  rw [run_append, run_noMeas_any C hC, run_append, hA]
  simp only [List.take_zero, List.drop_zero]
  rw [measurementCount_append, hA, Nat.zero_add, run_take]

theorem pack_run (B : Nat) (hB : B ∈ budgets) (m : List Bool) (s : State) :
    run (StairPhysicalPrimitives.pack B) m s =
      run (relocate B) [] (run (StairCodec.pack (physicalLayout B) B) m
        (run (StairPhysicalPrimitives.signExt B) [] s)) :=
  run_three _ _ _ (signExt_meas B) (relocate_meas B hB) m s

theorem unpack_run (B : Nat) (hB : B ∈ budgets) (m : List Bool) (s : State) :
    run (StairPhysicalPrimitives.unpack B) m s =
      run (StairPhysicalPrimitives.signExt B) [] (run (StairCodec.unpack (physicalLayout B) B) m
        (run (unrelocate B) [] s)) :=
  run_three _ _ _ (unrelocate_meas B hB) (signExt_meas B) m s

/-- `unpack B ∘ pack B = id` on states whose sign-extended rails are a
codec input. -/
theorem pack_trip (B : Nat) (hB : B ∈ budgets) (u v : Nat) (sigma : Bool)
    (spec : StairCodec.FunctionalSpec (physicalLayout B) B)
    (domain : StairCodec.CodecDomain B u v sigma) (s : State) (m n : List Bool)
    (input : StairCodec.CodecInput (physicalLayout B) B u v sigma
      (run (StairPhysicalPrimitives.signExt B) [] s).basis) :
    run (StairPhysicalPrimitives.unpack B) n (run (StairPhysicalPrimitives.pack B) m s) = s := by
  rw [pack_run B hB, unpack_run B hB, relocate_trip B hB,
    codec_pack_unpack _ B u v sigma spec domain (physicalLayout_nodup B hB) _ m n input,
    signExt_trip B hB]

/-- `pack B ∘ unpack B = id` on states whose un-relocated code is a compact
code. -/
theorem unpack_trip (B : Nat) (hB : B ∈ budgets) (u v : Nat) (sigma : Bool)
    (spec : StairCodec.FunctionalSpec (physicalLayout B) B)
    (domain : StairCodec.CodecDomain B u v sigma) (s : State) (m n : List Bool)
    (code : StairCodec.CompactCode (physicalLayout B) B u v sigma
      (run (unrelocate B) [] s).basis) :
    run (StairPhysicalPrimitives.pack B) n (run (StairPhysicalPrimitives.unpack B) m s) = s := by
  rw [unpack_run B hB, pack_run B hB, signExt_trip B hB,
    codec_unpack_pack _ B u v sigma spec domain (physicalLayout_nodup B hB) _ m n code,
    unrelocate_trip B hB]

end ECDSAAdd.Entrant.StairField2V3ExitRowTrips

