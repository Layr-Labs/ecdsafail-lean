theorem ok39_of_allB {f : Wire → Wire} {P : Program} (g : Nat → Nat) (hg : ∀ x, f x = g x)
    (h : allSites (fun x => good39B (g x)) P = true) :
    PieceOK StairCertificate.holes39 f P :=
  ok39_of_good (fun x hx => by rw [hg]; exact good39_of_B (allSites_sound h x hx))

