      measurementCount (groups divide d first count) =
        measurementCount (Rolling1588.groups divide first count) + 20 * d * count := by
  simpa only [groups, Rolling1588.groups] using
    program_counts_delta divide (packet divide d) (Rolling1588.packet divide)
      (20 * d) first count (fun j => packet_counts divide d j hd)


