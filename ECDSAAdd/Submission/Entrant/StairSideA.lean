/-! ### merged from `ECDSAAdd.Submission.Entrant.StairConcrete_at_QTop` -/
section Merge_StairConcrete_at_QTop

/-!
# Concrete loan provider for the best staircase schedule

Regular packet groups use their requested deficit.  The only nonzero endpoint
deficit in the schedule is the multiplication endpoint call `endPacket false 68`
(the slot; the number 68 is only the call tag).  Its value is LT19's 44-site
loan `StairEndpointLoan44.endPacket760Loan44 false` (three 44-deep loans,
+132 T / +132 M against the record endpoint).  The division endpoint is the
separate `divEndpoint` slot; zero-deficit calls retain the record endpoint.
-/

set_option autoImplicit false
set_option maxRecDepth 10000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairConcrete

open Arithmetic

def endPacket (divide : Bool) (deficit : Nat) : Program :=
  if divide then R2SqEp760.endPacket760 true
  else if deficit=68 then StairEndpointLoan44.endPacket760Loan44 false
  else R2SqEp760.endPacket760 false

/-- The head slot of either walk: packets `1 .. 84` at deficit zero (the direction is
carried along only for uniform call sites). -/
def HeadSlot (_divide : Bool) (deficit first count : Nat) : Prop :=
  deficit = 0 ∧ first = 1 ∧ count = 84

/-- Packet groups of the best schedule.  The head slot runs in the odd-word code
(`RouteA.Rolling1588.oddBlock`: the division head `oddHead` or the multiplication tail
`oddTail`, junction halves at both ends); every other slot is the loan-aware group
`StairGroups.groups`. -/
def groups (divide : Bool) (deficit first count : Nat) : Program :=
  if deficit = 0 ∧ first = 1 ∧ count = 84 then RouteA.Rolling1588.oddBlock divide
  else StairGroups.groups divide deficit first count

theorem groups_head (divide : Bool) :
    groups divide 0 1 84 = RouteA.Rolling1588.oddBlock divide :=
  if_pos ⟨rfl, rfl, rfl⟩

theorem groups_regular {divide : Bool} {deficit first count : Nat}
    (h : ¬HeadSlot divide deficit first count) :
    groups divide deficit first count = StairGroups.groups divide deficit first count :=
  if_neg h

def bestLoans : StairSchedule.StairLoans where
  groups := groups
  endPacket := endPacket
  canon := StairBoundaryLoan.canon760Loan
  center := StairBoundaryLoan.center760Loan
  divEndpoint := CompareDecoder.BoundaryLoan.endPacket760DivLoan










theorem bestLoans_groups_regular {divide : Bool} {deficit first count : Nat}
    (h : ¬HeadSlot divide deficit first count) :
    bestLoans.groups divide deficit first count =
      StairGroups.groups divide deficit first count :=
  groups_regular h

theorem bestLoans_groups_head (divide : Bool) :
    bestLoans.groups divide 0 1 84 = RouteA.Rolling1588.oddBlock divide := groups_head divide

















end ECDSAAdd.Entrant.StairConcrete
end Merge_StairConcrete_at_QTop

