    (hq : q ∈ RailPair.sites (scanPairs j)) : q < 1556 := by
  obtain ⟨p, hp, hq'⟩ := List.mem_flatMap.mp hq
  simp only [scanPairs, List.mem_map, List.mem_range] at hp
  obtain ⟨i, hi, rfl⟩ := hp
