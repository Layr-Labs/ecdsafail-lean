attribute [local irreducible] gateSlots

/-! ## Walk facts of the CANON v3 primitive provider -/

theorem codecPair_physical : ∀ B, B ∈ v3Plan.rows.map Prod.snd →
    gateSlots (StairPhysicalPrimitives.pack B) +
      gateSlots (StairPhysicalPrimitives.unpack B) = v3CodecPair B := by
  intro B hB
  simp only [v3Plan, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  · exact codecPair87.trans (by decide)
  · exact codecPair62.trans (by decide)
  · exact codecPair47.trans (by decide)
  · exact codecPair32.trans (by decide)
  · exact codecPair22.trans (by decide)
  · exact codecPair12.trans (by decide)

/-- LT14's repaired orientation over the full `B + 1`-bit rails. -/
theorem orientFull_slots (letter : Wire) (L : StairCodec.Layout) (B : Nat)
    (x y : Wire) :
    gateSlots (StairV3Primitives.orientFull letter L B x y) = 3 * (B + 1) := by
