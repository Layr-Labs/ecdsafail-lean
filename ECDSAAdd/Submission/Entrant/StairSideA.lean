      simp only [Bool.true_and,decide_eq_true_eq] at head tail ⊢
      simp only [groups,ECDSAAdd.Entrant.Rolling1588.groups,PacketSequence.program,
        if_true,toffoliCount_append,measurementCount_append] at tail ⊢
