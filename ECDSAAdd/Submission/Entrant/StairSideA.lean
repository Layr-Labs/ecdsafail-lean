/-! ## Boundary programs -/

theorem mappedAddLoan_units10_slots_le (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d <= cs.length) (hu : ∀ b ∈ bits, StairSlotsLib.MappedUnit10 b) :
    gateSlots (StairLoan.mappedAddLoan d roles bits ys cs cin) <=
      gateSlots (mappedAdd bits ys cs cin) + 10 * d := by
  have len := StairLoan.mappedLayers_length bits ys cs cin hb hc
  have bound := StairSlotsLib.emitLoan_slots_le10 d roles
    (StairLoan.mappedLayers bits ys cs cin)
    (StairLoan.mappedTop bits ys cs cin)
    (by omega)
    (StairSlotsLib.mappedLayers_slotUnit10 bits ys cs cin hu)
  rw [← StairLoan.mappedAdd_as_sweep] at bound
  simpa only [StairLoan.mappedAddLoan] using bound

theorem mappedSubLoan_units10_slots_le (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d <= cs.length) (hu : ∀ b ∈ bits, StairSlotsLib.MappedUnit10 b) :
    gateSlots (StairLoan.mappedSubLoan d roles bits ys cs cin) <=
      gateSlots (mappedSub bits ys cs cin) + 10 * d := by
  have h := mappedAddLoan_units10_slots_le d roles bits ys cs cin hb hc hd hu
  simp only [StairLoan.mappedSubLoan, mappedSub, gateSlots_append] at h ⊢
  omega

theorem lowCorrection_units10 (L : BalancedConvert.Layout) :
    ∀ b ∈ HalfConvert.lowCorrection L, StairSlotsLib.MappedUnit10 b := by
  intro b hb
  simp only [HalfConvert.lowCorrection, List.mem_map, List.mem_range] at hb
  obtain ⟨i, _, rfl⟩ := hb
  split
  · exact StairSlotsLib.mappedConstantBit_some_unit10 L.flag true
  · exact StairSlotsLib.mappedConstantBit_some_unit10 L.flag false

theorem lowCorrection_ladder (L : BalancedConvert.Layout) (hw : L.Widths) :
    (HalfConvert.lowCorrection L).length = L.low.length ∧
      (L.carry.take 254).length + 1 = L.low.length ∧
      (L.carry.take 254).length = 254 := by
  have l : (HalfConvert.lowCorrection L).length = 255 := by
    simp [HalfConvert.lowCorrection]
  have w : L.low.length = 255 ∧ L.carry.length = 255 := hw
  refine ⟨?_, ?_, ?_⟩
  · rw [l, w.1]
  · simp only [List.length_take, w.1, w.2]
    omega
  · simp only [List.length_take, w.2]
    omega

/-- LT8's loaned canonicalisation: at most `10 d` slots over the record. -/
theorem canonicalLoan_slots_le (d : Nat) (roles : List Wire)
    (L : BalancedConvert.Layout) (hw : L.Widths) (hd : d ≤ 254) :
    gateSlots (StairBoundaryLoan.canonicalLoan d roles L) ≤
      gateSlots (HalfConvert.canonical L) + 10 * d := by
  obtain ⟨l1, l2, l3⟩ := lowCorrection_ladder L hw
  have sub := mappedSubLoan_units10_slots_le d roles _ _ _ L.cin l1 l2
    (by omega) (lowCorrection_units10 L)
  rw [StairBoundaryLoan.canonicalLoan, HalfConvert.canonical]
  simp only [gateSlots_append]
  omega

/-- LT8's loaned centering: at most `10 d` slots over the record. -/
theorem centerLoan_slots_le (d : Nat) (roles : List Wire)
    (L : BalancedConvert.Layout) (hw : L.Widths) (hd : d ≤ 254) :
    gateSlots (StairBoundaryLoan.centerLoan d roles L) ≤
      gateSlots (HalfConvert.center L) + 10 * d := by
  obtain ⟨l1, l2, l3⟩ := lowCorrection_ladder L hw
  have add := mappedAddLoan_units10_slots_le d roles _ _ _ L.cin l1 l2
    (by omega) (lowCorrection_units10 L)
  rw [StairBoundaryLoan.centerLoan, HalfConvert.center]
  simp only [gateSlots_append]
  omega

theorem canon760Loan_slots_le :
    gateSlots StairBoundaryLoan.canon760Loan ≤ gateSlots R2SqEp760.canon760 + 440 := by
  -- LT44 (replay budget): `10 * 44` is rewritten to `440` by an equation.  Through the old
  -- definitional cast (`exact` up to `10 * 44 = 440`) the kernel's `Nat.add` reduction
  -- evaluated `gateSlots` of the whole concrete converter (≈ 10-15 s).
  have h := canonicalLoan_slots_le 44 StairBoundaryLoan.exclusiveHoles
    StairBoundaryLoan.converterLayout760
    StairBoundaryLoan.converterLayout760_facts.widths (by omega)
  rw [show (10 : Nat) * 44 = 440 from rfl] at h
  rw [StairBoundaryLoan.canon760Loan, StairBoundaryLoan.canon760_eq]
  exact h

theorem center760Loan_slots_le :
    gateSlots StairBoundaryLoan.center760Loan ≤ gateSlots R2SqEp760.center760 + 440 := by
  -- LT44 (replay budget): `10 * 44` is rewritten to `440` by an equation.  Through the old
  -- definitional cast (`exact` up to `10 * 44 = 440`) the kernel's `Nat.add` reduction
  -- evaluated `gateSlots` of the whole concrete converter (≈ 10-15 s).
  have h := centerLoan_slots_le 44 StairBoundaryLoan.exclusiveHoles
    StairBoundaryLoan.converterLayout760
    StairBoundaryLoan.converterLayout760_facts.widths (by omega)
  rw [show (10 : Nat) * 44 = 440 from rfl] at h
  rw [StairBoundaryLoan.center760Loan, StairBoundaryLoan.center760_eq]
  exact h

theorem v3BoundaryFacts (h : StairHostsSchedule.HostPlan) :
    BoundaryFacts h v3Boundary1806 where
  -- LT41 + LT44 (replay budget): every field is brought to the lemma's statement by rewriting
  -- with equations.  Through a definitional cast (`+ v3Boundary1806.divEnd` against `+ 10000`,
  -- `show` + `omega`) the kernel's `Nat.add` reduction evaluated `gateSlots` of the concrete
  -- record programs (115 s of kernel time in this one declaration).
  divEnd := by
    rw [show v3Boundary1806.divEnd = 10000 from rfl, StairConcrete.bestLoans_divEndpoint]
    exact divLoan_slots_le
  multEnd := by
    have e0 : StairHostsSchedule.hostedEndpoint h false 68 =
        renameProgram (OB5.sig 511) (StairEndpointLoan44.endPacket760Loan44 false) := by
      simp only [StairHostsSchedule.hostedEndpoint, StairSchedule.placedEndPacket,
        StairConcrete.bestLoans, StairConcrete.endPacket, Bool.false_eq_true, if_false, if_true,
        ite_true, ite_false, reduceIte]
    rw [show v3Boundary1806.multEnd = 30000 from rfl, e0, rename_gateSlots]
    exact mult44_slots_le
  canon := by
    rw [show v3Boundary1806.canon = 440 from rfl,
      show StairConcrete.bestLoans.canon = StairBoundaryLoan.canon760Loan from rfl]
    exact canon760Loan_slots_le
  center := by
    rw [show v3Boundary1806.center = 440 from rfl,
      show StairConcrete.bestLoans.center = StairBoundaryLoan.center760Loan from rfl]
    exact center760Loan_slots_le

