/-! ## Tape algebra (generic) -/


def padTape (k : Nat) (m : List Bool) : List Bool :=
  m.take k ++ List.replicate (k - (m.take k).length) false

theorem padTape_length (k : Nat) (m : List Bool) :
    (padTape k m).length = k := by
  unfold padTape
  simp only [List.length_append, List.length_replicate, List.length_take]
  omega

theorem run_append_false (P : Program) (m : List Bool) (k : Nat) (s : State) :
    run P (m ++ List.replicate k false) s = run P m s := by
  induction P generalizing m k s with
  | nil => rfl
  | cons i P ih =>
      cases i with
      | X t =>
          simp only [run]
          exact ih m k _
      | CX c t =>
          simp only [run]
          exact ih m k _
      | CCX a b t =>
          simp only [run]
          exact ih m k _
      | measureX t c0 c1 =>
          cases m with
          | nil =>
              cases k with
              | zero => rfl
              | succ k =>
                  have h := ih [] k (measureAndCorrect t c0 c1 false s)
                  simpa [run, List.replicate_succ] using h
          | cons b m =>
              have h := ih m k (measureAndCorrect t c0 c1 b s)
              simpa [run] using h

theorem run_padTape (P : Program) (m : List Bool) (s : State) :
    run P (padTape (measurementCount P) m) s = run P m s := by
  unfold padTape
  rw [run_append_false, run_take]

theorem nested_run_eq_append (P Q : Program) (m n : List Bool) (s : State) :
    run Q n (run P m s) =
      run (P ++ Q) (padTape (measurementCount P) m ++ n) s := by
  rw [run_append]
  have hlen := padTape_length (measurementCount P) m
  have htake : (padTape (measurementCount P) m ++ n).take
      (measurementCount P) = padTape (measurementCount P) m := by
    rw [List.take_append_of_le_length (by omega)]
    exact List.take_of_length_le (by omega)
  have hdrop : (padTape (measurementCount P) m ++ n).drop
      (measurementCount P) = n := by
    rw [List.drop_append_of_le_length (by omega),
      List.drop_of_length_le (by omega), List.nil_append]
  rw [htake, hdrop, run_padTape]

theorem nested_tapeFree (P Q : Program) (s : State)
    (free : TapeFree (P ++ Q) s) (m n m' n' : List Bool) :
    run Q n (run P m s) = run Q n' (run P m' s) := by
  rw [nested_run_eq_append, nested_run_eq_append]
  exact free _ _

