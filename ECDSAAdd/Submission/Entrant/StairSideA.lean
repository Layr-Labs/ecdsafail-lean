/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanRecordExitKernel_at_StairSideA` -/
section Merge_StairLoanRecordExitKernel_at_StairSideA

/-!
# The loaned record-shaped multiplication kernel equals the record kernel

Level 3: `exitFieldHostedShape bestLoans` equals `Rolling1588.exitFieldHosted`
on the record's `exit_frame` input (record hosting lemmas on both sides,
Level 2 equality in the middle, forced control bit removed by
`Stack5.local_replace`).

Level 4: on `ExitPre k`, the record-shaped kernel
`renameProgram phaseHost (Rolling1588TickGap.firstPhase false) ++
 (exitFieldHostedShape bestLoans ++ renameProgram phaseHost
   (ParityXExitInverse23Kernel.lastXN k))`
equals `ParityXExitInverse23Kernel.kernelXN k`: both reduce through the
record's parametric `hostedN` to `put` of the `lastX` kernel, whose output
the record's parametric `hostedX` pins completely.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordExitKernel

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoanRecordShape StairLoanRecordSupport StairLoanExitSupport
  StairLoanRecordExit

attribute [local irreducible] wires run

/-! ## Copies of private record helpers -/

private theorem field_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.field_special_at origin X Y state 2409 (by simp)
    input
  have b := Rolling1588Frame.field_special_at origin X Y state 2410 (by simp)
    input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

private theorem canonical_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.canonical_special_at origin X Y state 2409
    (by simp) input
  have b := Rolling1588Frame.canonical_special_at origin X Y state 2410
    (by simp) input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

private theorem trace_last (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (origin : BasisState)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int))) :
    origin (base 511) = true := by
  have tr : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511
      (false, false) = (true, false) := by
    rw [trace]
    exact SkywalkTrace.trace512_last x hx0 hx _
  have e : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511
      (false, false) = (origin (base 511), origin (base (1028 + 511))) := by
    simp [skywalkTapeControls, skywalkSharedTape]
  rw [e] at tr
  exact (Prod.mk.inj tr).1


/-! ## Level 3: the hosted multiplication field -/

theorem exitFieldHosted_core_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (enabled : origin (base 2400) = true) (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (in511 : state.basis (base 511) = true)
    (in1542 : state.basis (base 1542) = false)
    (workIn : state.basis FrontierEntry1591Field.work = false)
    (parity : state.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map state.basis))
    (fresh old : List Bool) :
    run (exitFieldHostedShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.exitFieldHosted old state := by
  have fieldEq (a b : List Bool) :=
    exitField_run_eq half endpoint origin ctx ha x hx0 hx trace enabled Y state
      input a b
  have result (r : List Bool) :=
    Rolling1588.exitField_frame origin ctx ha x hx0 hx trace enabled Y state r
      input
  have before := canonical_flags origin ctx Y 0 state input
  have after (r : List Bool) := field_flags origin ctx _ _ _ (result r).2
  have workSame (r : List Bool) :
      (run Rolling1588.exitField r state).basis FrontierEntry1591Field.work =
        state.basis FrontierEntry1591Field.work := by
    have a := Rolling1588Frame.canonical_special_at origin Y 0 state 1797
      (by simp) input
    have b := Rolling1588Frame.field_special_at origin _ _ _ 1797 (by simp)
      (result r).2
    have fixed : OB5.sig 511 (base 1797) = FrontierEntry1591Field.work := by
      decide
    simpa only [fixed] using b.trans a.symm
  have payload (r : List Bool) :=
    Rolling1588.exit_payload_xor false true origin ctx.hn (ctx.hp _ (by simp))
      ctx.legal Y 0 _ _ state _ input (result r).2
  have hostedR (r : List Bool) :
      run (FrontierEntry1591Field.hosted Rolling1588.exitField) r state =
        run Rolling1588.exitField r state :=
    HostOB5.hosted_run Rolling1588.exitField state r
      Rolling1588.exitField_hosts_free.1 Rolling1588.exitField_hosts_free.2
      before.1 in511 before.2 in1542 (after r).1 (after r).2
  have wrappedR (r : List Bool) :
      run Rolling1588.exitFieldHosted r state =
        run (FrontierEntry1591Field.hosted Rolling1588.exitField) r state :=
    ParityField1591.run_eq_xor FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host _ state r
      (by decide) FrontierEntry1591Field.host_not_controls
      Rolling1588.exitHosted_avoids_host parity workIn
      (by rw [hostedR r]; exact (workSame r).trans workIn)
      (by rw [hostedR r]; exact payload r)
  have sameOut (r : List Bool) :
      run (exitFieldShape StairConcrete.bestLoans) r state =
        run Rolling1588.exitField r state := fieldEq r r
  have hostsFree := exitFieldShape_hosts_free half
  have hostedB (r : List Bool) :
      run (FrontierEntry1591Field.hosted
          (exitFieldShape StairConcrete.bestLoans)) r state =
        run (exitFieldShape StairConcrete.bestLoans) r state :=
    HostOB5.hosted_run _ state r hostsFree.1 hostsFree.2 before.1 in511
      before.2 in1542 (by rw [sameOut r]; exact (after r).1)
      (by rw [sameOut r]; exact (after r).2)
  have wrappedB (r : List Bool) :
      run (exitFieldHostedShape StairConcrete.bestLoans) r state =
        run (FrontierEntry1591Field.hosted
          (exitFieldShape StairConcrete.bestLoans)) r state :=
    ParityField1591.run_eq_xor FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host _ state r
      (by decide) FrontierEntry1591Field.host_not_controls
      (exitHostedShape_avoids_host half) parity workIn
      (by rw [hostedB r, sameOut r]; exact (workSame r).trans workIn)
      (by rw [hostedB r, sameOut r]; exact payload r)
  rw [wrappedB, hostedB, wrappedR, hostedR]
  exact fieldEq fresh old

theorem exitFieldHosted_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame false origin Y 0 state)
    (in511 : state.basis (base 511) = true)
    (in1542 : state.basis (base 1542) = false)
    (workIn : state.basis FrontierEntry1591Field.work = false)
    (parity : state.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map state.basis))
    (fresh old : List Bool) :
    run (exitFieldHostedShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.exitFieldHosted old state := by
  let origin' := writeBit origin (base 2400) true
  let forced : State := ⟨state.phase, writeBit state.basis (base 2400) true⟩
  have ctx' := FrontierEntry1591.context_control_set origin ctx true
  have ha' := FrontierEntry1591.source_zero_control_set origin true ha
  have trace' : skywalkTapeControls origin' (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact trace
  have input' := Rolling1588.canonical_control_set origin Y 0 state true input
  have parity' := FrontierEntry1591.parity_host_control_set
    FrontierEntry1591Field.controls FrontierEntry1591Field.host (by decide)
    FrontierEntry1591Field.controls_away_control state true parity
  have core := exitFieldHosted_core_run_eq half endpoint origin' ctx' ha' x hx0
    hx trace' (by simp only [origin', writeBit, Function.update_self]) Y
    forced input'
    (by simpa only [forced, writeBit, Function.update_of_ne (show base 511 ≠ base 2400 from by decide)] using in511)
    (by simpa only [forced, writeBit, Function.update_of_ne (show base 1542 ≠ base 2400 from by decide)] using in1542)
    (by simpa only [forced, writeBit, Function.update_of_ne (show FrontierEntry1591Field.work ≠ base 2400 from by decide)] using workIn)
    parity' fresh old
  apply Stack5.local_replace (exitFieldHostedShape StairConcrete.bestLoans)
    Rolling1588.exitFieldHosted
    (wires (exitFieldHostedShape StairConcrete.bestLoans) ∪
      wires Rolling1588.exitFieldHosted)
    Finset.subset_union_left Finset.subset_union_right state forced fresh old
    _ core
  intro q hq
  have ne : q ≠ base 2400 := by
    rintro rfl
    rcases Finset.mem_union.mp hq with h | h
    · exact exitHostedShape_control_free half h
    · exact Rolling1588.exit_control_free h
  change state.basis q = writeBit state.basis (base 2400) true q
  simp only [writeBit, Function.update_of_ne ne]

/-! ## Level 4: the record-shaped multiplication kernel -/

/-- The loaned analogue of the record's `exit_boundary` (concrete first-phase
runs abstracted first, as in the record). -/
theorem shape_exit_boundary (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (hn : (skywalkSharedWires base).Nodup)
    (hlo : History5.HistoryAbove base)
    (ho : ∀ q ∈ [base 2400, base 2409, base 2410], q ∉ skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410)
      (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s : State)
    (mp mf : List Bool)
    (input : SkywalkArithmeticInput base x Y.val s.basis)
    (hg : s.basis (base 2409) = false) (hs : s.basis (base 2410) = false) :
    let beforeA := run (Rolling1588.firstPhase false) mp s
    let beforeB := run (Rolling1588.firstPhase true) mp s
    let after := run (exitFieldHostedShape StairConcrete.bestLoans) mf beforeA
    after.phase = beforeB.phase ∧
      regValue (wireBlock base 2056 256) after.basis =
        centerWord (Y * (x : Fp) / 2) ∧
      ∀ q, q ∉ wireBlock base 2056 256 → after.basis q = beforeB.basis q := by
  have record := Rolling1588.exit_boundary hn hlo ho hf x Y hx0 hx s mp mf input
    hg hs
  obtain ⟨beforeA, beforeAEq⟩ : ∃ beforeA : State,
      run (Rolling1588.firstPhase false) mp s = beforeA := ⟨_, rfl⟩
  obtain ⟨beforeB, beforeBEq⟩ : ∃ beforeB : State,
      run (Rolling1588.firstPhase true) mp s = beforeB := ⟨_, rfl⟩
  obtain ⟨origin, facts, legal, frames⟩ := Rolling1588Lifetime.first_prepared
    hn hlo ho x Y hx0 hx s mp input
  have ctx := Rolling1588Lifetime.prepared_context hn ho hf x Y s origin facts
    legal hg hs
  have frameA := frames false
  rw [beforeAEq] at frameA
  have bits := Rolling1588Lifetime.first_clean false hn hlo x Y.val hx0 hx s mp
    input
  have work := Rolling1588Lifetime.first_work_zero false hn x Y.val s mp input
  have parity := Rolling1588Lifetime.first_parity false hn hlo x Y.val hx0 hx s
    mp input
  rw [beforeAEq] at bits work parity
  have code := Rolling1588Frame.canonical_special_at origin.basis Y 0 beforeA 511
    (by simp) frameA
  have fixed : OB5.sig 511 (base 511) = base 511 := by decide +kernel
  rw [fixed] at code
  have eq := exitFieldHosted_run_eq half endpoint origin.basis ctx
    facts.sourceZero x hx0 hx facts.trace Y beforeA frameA
    (code.trans (trace_last x hx0 hx origin.basis facts.trace))
    (bits _ (by simp [FrontierEntry1591Native.workSites])) work parity mf mf
  rw [beforeAEq, beforeBEq] at record
  rw [beforeAEq, beforeBEq]
  dsimp only at record ⊢
  obtain ⟨after, afterEq⟩ : ∃ after : State,
      run Rolling1588.exitFieldHosted mf beforeA = after := ⟨_, rfl⟩
  rw [afterEq] at record eq
  rw [eq]
  exact record


/-- Two outputs pinned by `hostedX` are equal. -/
theorem exit_output_unique (s a b : State) (value value' : Nat)
    (ha : a.phase = s.phase ∧ regValue (wireBlock base 2056 256) a.basis = value ∧
      regValue (wireBlock base 770 258) a.basis = value' ∧
      ∀ q, q ∉ wireBlock base 2056 256 → q ∉ wireBlock base 770 258 →
        a.basis q = s.basis q)
    (hb : b.phase = s.phase ∧ regValue (wireBlock base 2056 256) b.basis = value ∧
      regValue (wireBlock base 770 258) b.basis = value' ∧
      ∀ q, q ∉ wireBlock base 2056 256 → q ∉ wireBlock base 770 258 →
        b.basis q = s.basis q) :
    a = b := by
  have block1 := (regValue_eq_iff (wireBlock base 2056 256) a.basis b.basis).mp
    (ha.2.1.trans hb.2.1.symm)
  have block2 := (regValue_eq_iff (wireBlock base 770 258) a.basis b.basis).mp
    (ha.2.2.1.trans hb.2.2.1.symm)
  apply State.extensionality _ _ (ha.1.trans hb.1.symm)
  funext q
  by_cases h1 : q ∈ wireBlock base 2056 256
  · exact block1 q h1
  · by_cases h2 : q ∈ wireBlock base 770 258
    · exact block2 q h2
    · exact (ha.2.2.2 q h1 h2).trans (hb.2.2.2 q h1 h2).symm


end ECDSAAdd.Entrant.StairLoanRecordExitKernel

end
end Merge_StairLoanRecordExitKernel_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanRecordKernel_at_StairSideA` -/
section Merge_StairLoanRecordKernel_at_StairSideA

/-!
# The loaned record-shaped division kernel equals the record kernel

Level 3: the hosted loaned field `entryFieldHostedShape bestLoans` equals the
record's `Rolling1588.entryFieldHosted` on the record's own `entry_frame`
input.  Both sides are unwrapped with the record's parametric hosting lemmas
(`HostOB5.hosted_run`, `ParityField1591.run_eq_xor`); the loaned side's
output facts are transferred from the record through the Level 2 equality,
and the forced control bit is removed by `Stack5.local_replace` (neither
program touches `base 2400`).

Level 4: `EntryCorrect` for the loaned record-shaped kernel
`InverseFiveEntry23.kernel15 true false (entryFieldHostedShape bestLoans)`,
by the record's parametric `kernel_result15` / `kernel_first_eq15`, and then
run equality with `InverseFiveEntry23.entryKernel15` on `EntryPre`: both
outputs have the same phase, the same numerator block (`regValue_eq_iff`)
and are unchanged elsewhere.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordKernel

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoanRecordShape StairLoanRecordSupport

attribute [local irreducible] wires run

/-! ## Copies of private record helpers -/

private theorem field_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.field_special_at origin X Y state 2409 (by simp)
    input
  have b := Rolling1588Frame.field_special_at origin X Y state 2410 (by simp)
    input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

private theorem canonical_flags {isA : Bool} (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin) (X Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedCanonicalFrame isA origin X Y state) :
    state.basis (base 2409) = false ∧ state.basis (base 2410) = false := by
  have a := Rolling1588Frame.canonical_special_at origin X Y state 2409
    (by simp) input
  have b := Rolling1588Frame.canonical_special_at origin X Y state 2410
    (by simp) input
  have fa : OB5.sig 511 (base 2409) = base 2409 := by decide
  have fb : OB5.sig 511 (base 2410) = base 2410 := by decide
  exact ⟨(fa ▸ a).trans ctx.hg0, (fb ▸ b).trans ctx.hs0⟩

private theorem trace_last (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (origin : BasisState)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int))) :
    origin (base 511) = true := by
  have tr : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511
      (false, false) = (true, false) := by
    rw [trace]
    exact SkywalkTrace.trace512_last x hx0 hx _
  have e : (skywalkTapeControls origin (skywalkSharedTape base)).getD 511
      (false, false) = (origin (base 511), origin (base (1028 + 511))) := by
    simp [skywalkTapeControls, skywalkSharedTape]
  rw [e] at tr
  exact (Prod.mk.inj tr).1

/-! ## Level 3: the hosted division field -/

/-- On a state whose control bit is already set (`entry_core_frame` form). -/
theorem entryFieldHosted_core_run_eq (half : HalfReplayHypothesis)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (enabled : origin (base 2400) = true) (Z : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame true origin Z 0 state)
    (in511 : state.basis (base 511) = true)
    (in1542 : state.basis (base 1542) = false)
    (workIn : state.basis FrontierEntry1591Field.work = false)
    (parity : state.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map state.basis))
    (fresh old : List Bool) :
    run (entryFieldHostedShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.entryFieldHosted old state := by
  have fieldEq (a b : List Bool) :=
    entryField_run_eq half origin ctx ha enabled x hx0 hx trace Z state input a b
  have result (r : List Bool) :=
    Rolling1588.entryField_frame origin ctx ha enabled x hx0 hx trace Z state r
      input
  have before := field_flags origin ctx Z 0 state input
  have after (r : List Bool) := canonical_flags origin ctx _ _ _ (result r).2
  have workSame (r : List Bool) :
      (run Rolling1588.entryField r state).basis FrontierEntry1591Field.work =
        state.basis FrontierEntry1591Field.work := by
    have a := Rolling1588Frame.field_special_at origin Z 0 state 1797 (by simp)
      input
    have b := Rolling1588Frame.canonical_special_at origin _ _ _ 1797 (by simp)
      (result r).2
    have fixed : OB5.sig 511 (base 1797) = FrontierEntry1591Field.work := by
      decide
    simpa only [fixed] using b.trans a.symm
  have payload (r : List Bool) :=
    Rolling1588.entry_payload_xor true false origin ctx.hn (ctx.hp _ (by simp))
      ctx.legal Z 0 _ _ state _ input (result r).2
  have hostedR (r : List Bool) :
      run (FrontierEntry1591Field.hosted Rolling1588.entryField) r state =
        run Rolling1588.entryField r state :=
    HostOB5.hosted_run Rolling1588.entryField state r
      Rolling1588.entryField_hosts_free.1 Rolling1588.entryField_hosts_free.2
      before.1 in511 before.2 in1542 (after r).1 (after r).2
  have wrappedR (r : List Bool) :
      run Rolling1588.entryFieldHosted r state =
        run (FrontierEntry1591Field.hosted Rolling1588.entryField) r state :=
    ParityField1591.run_eq_xor FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host _ state r
      (by decide) FrontierEntry1591Field.host_not_controls
      Rolling1588.entryHosted_avoids_host parity workIn
      (by rw [hostedR r]; exact (workSame r).trans workIn)
      (by rw [hostedR r]; exact payload r)
  have sameOut (r : List Bool) :
      run (entryFieldShape StairConcrete.bestLoans) r state =
        run Rolling1588.entryField r state := fieldEq r r
  have hostsFree := entryFieldShape_hosts_free half
  have hostedB (r : List Bool) :
      run (FrontierEntry1591Field.hosted
          (entryFieldShape StairConcrete.bestLoans)) r state =
        run (entryFieldShape StairConcrete.bestLoans) r state :=
    HostOB5.hosted_run _ state r hostsFree.1 hostsFree.2 before.1 in511
      before.2 in1542 (by rw [sameOut r]; exact (after r).1)
      (by rw [sameOut r]; exact (after r).2)
  have wrappedB (r : List Bool) :
      run (entryFieldHostedShape StairConcrete.bestLoans) r state =
        run (FrontierEntry1591Field.hosted
          (entryFieldShape StairConcrete.bestLoans)) r state :=
    ParityField1591.run_eq_xor FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host _ state r
      (by decide) FrontierEntry1591Field.host_not_controls
      (entryHostedShape_avoids_host half) parity workIn
      (by rw [hostedB r, sameOut r]; exact (workSame r).trans workIn)
      (by rw [hostedB r, sameOut r]; exact payload r)
  rw [wrappedB, hostedB, wrappedR, hostedR]
  exact fieldEq fresh old

/-- On the record's `entry_frame` input (control bit unconstrained). -/
theorem entryFieldHosted_run_eq (half : HalfReplayHypothesis)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (ha : regValue (skywalkSharedField base).a origin = 0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)))
    (Y : Fp) (state : State)
    (input : Rolling1588Frame.EncodedFieldFrame true origin (Y / 2) 0 state)
    (in511 : state.basis (base 511) = true)
    (in1542 : state.basis (base 1542) = false)
    (workIn : state.basis FrontierEntry1591Field.work = false)
    (parity : state.basis FrontierEntry1591Field.host =
      TraceParity5.parity (FrontierEntry1591Field.controls.map state.basis))
    (fresh old : List Bool) :
    run (entryFieldHostedShape StairConcrete.bestLoans) fresh state =
      run Rolling1588.entryFieldHosted old state := by
  let origin' := writeBit origin (base 2400) true
  let forced : State := ⟨state.phase, writeBit state.basis (base 2400) true⟩
  have ctx' := FrontierEntry1591.context_control_set origin ctx true
  have ha' := FrontierEntry1591.source_zero_control_set origin true ha
  have trace' : skywalkTapeControls origin' (skywalkSharedTape base) =
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x : Int)
        (p : Int)) := by
    rw [FrontierEntry1591.trace_control_set]
    exact trace
  have input' := Rolling1588.frame_control_set origin (Y / 2) 0 state true input
  have parity' := FrontierEntry1591.parity_host_control_set
    FrontierEntry1591Field.controls FrontierEntry1591Field.host (by decide)
    FrontierEntry1591Field.controls_away_control state true parity
  have core := entryFieldHosted_core_run_eq half origin' ctx' ha' x hx0 hx
    trace' (by simp only [origin', writeBit, Function.update_self]) (Y / 2)
    forced input'
    (by simpa only [forced, writeBit, Function.update_of_ne (show base 511 ≠ base 2400 from by decide)] using in511)
    (by simpa only [forced, writeBit, Function.update_of_ne (show base 1542 ≠ base 2400 from by decide)] using in1542)
    (by simpa only [forced, writeBit, Function.update_of_ne (show FrontierEntry1591Field.work ≠ base 2400 from by decide)] using workIn)
    parity' fresh old
  apply Stack5.local_replace (entryFieldHostedShape StairConcrete.bestLoans)
    Rolling1588.entryFieldHosted
    (wires (entryFieldHostedShape StairConcrete.bestLoans) ∪
      wires Rolling1588.entryFieldHosted)
    Finset.subset_union_left Finset.subset_union_right state forced fresh old
    _ core
  intro q hq
  have ne : q ≠ base 2400 := by
    rintro rfl
    rcases Finset.mem_union.mp hq with h | h
    · exact entryHostedShape_control_free half h
    · exact Rolling1588.entry_control_free h
  change state.basis q = writeBit state.basis (base 2400) true q
  simp only [writeBit, Function.update_of_ne ne]

/-! ## Level 4: the record-shaped division kernel -/

/-- The loaned analogue of the record's `entry_boundary`.  As in the record,
the concrete first-phase runs are abstracted into named states first. -/
theorem shape_entry_boundary (half : HalfReplayHypothesis)
    (hn : (skywalkSharedWires base).Nodup)
    (hlo : History5.HistoryAbove base)
    (ho : ∀ q ∈ [base 2400, base 2409, base 2410], q ∉ skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410)
      (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s t : State)
    (mp mf : List Bool)
    (input : SkywalkArithmeticInput base x Y.val s.basis)
    (hg : s.basis (base 2409) = false) (hs : s.basis (base 2410) = false)
    (phase : t.phase = s.phase)
    (same : ∀ q, q ∉ wireBlock base 2056 256 → t.basis q = s.basis q)
    (halfValue : regValue (wireBlock base 2056 256) t.basis = centerWord (Y / 2)) :
    let beforeA := run (Rolling1588.firstPhase true) mp t
    let beforeB := run (Rolling1588.firstPhase false) mp t
    let after := run (entryFieldHostedShape StairConcrete.bestLoans) mf beforeA
    after.phase = beforeB.phase ∧
      regValue (wireBlock base 2056 256) after.basis = (Y / (x : Fp)).val ∧
      ∀ q, q ∉ wireBlock base 2056 256 → after.basis q = beforeB.basis q := by
  have record := Rolling1588.entry_boundary hn hlo ho hf x Y hx0 hx s t mp mf
    input hg hs phase same halfValue
  obtain ⟨beforeA, beforeAEq⟩ : ∃ beforeA : State,
      run (Rolling1588.firstPhase true) mp t = beforeA := ⟨_, rfl⟩
  obtain ⟨beforeB, beforeBEq⟩ : ∃ beforeB : State,
      run (Rolling1588.firstPhase false) mp t = beforeB := ⟨_, rfl⟩
  obtain ⟨origin, facts, legal, frames⟩ := Rolling1588Lifetime.entry_first_prepared
    hn hlo ho x Y hx0 hx s t mp input phase same halfValue
  have ctx := Rolling1588Lifetime.prepared_context hn ho hf x Y s origin facts
    legal hg hs
  have frameA := frames true
  rw [beforeAEq] at frameA
  have actualInput := FrontierEntry1591Kernel.paired_input x Y.val s t input same
  have bits := Rolling1588Lifetime.first_clean true hn hlo x _ hx0 hx t mp
    actualInput
  have work := Rolling1588Lifetime.first_work_zero true hn x _ t mp actualInput
  have parity := Rolling1588Lifetime.first_parity true hn hlo x _ hx0 hx t mp
    actualInput
  rw [beforeAEq] at bits work parity
  have code := Rolling1588Frame.field_special_at origin.basis (Y / 2) 0 beforeA
    511 (by simp) frameA
  have fixed : OB5.sig 511 (base 511) = base 511 := by decide +kernel
  rw [fixed] at code
  have eq := entryFieldHosted_run_eq half origin.basis ctx facts.sourceZero x hx0
    hx facts.trace Y beforeA frameA
    (code.trans (trace_last x hx0 hx origin.basis facts.trace))
    (bits _ (by simp [FrontierEntry1591Native.workSites])) work parity mf mf
  rw [beforeAEq, beforeBEq] at record
  rw [beforeAEq, beforeBEq]
  dsimp only at record ⊢
  obtain ⟨after, afterEq⟩ : ∃ after : State,
      run Rolling1588.entryFieldHosted mf beforeA = after := ⟨_, rfl⟩
  rw [afterEq] at record eq
  rw [eq]
  exact record



/-- Two outputs with the same `EntryCorrect` characterization are equal. -/
theorem entry_output_unique (s a b : State) (value : Nat)
    (ha : a.phase = s.phase ∧ regValue (wireBlock base 2056 256) a.basis = value ∧
      ∀ q, q ∉ wireBlock base 2056 256 → a.basis q = s.basis q)
    (hb : b.phase = s.phase ∧ regValue (wireBlock base 2056 256) b.basis = value ∧
      ∀ q, q ∉ wireBlock base 2056 256 → b.basis q = s.basis q) :
    a = b := by
  have block := (regValue_eq_iff (wireBlock base 2056 256) a.basis b.basis).mp
    (ha.2.1.trans hb.2.1.symm)
  apply State.extensionality _ _ (ha.1.trans hb.1.symm)
  funext q
  by_cases hq : q ∈ wireBlock base 2056 256
  · exact block q hq
  · exact (ha.2.2 q hq).trans (hb.2.2 q hq).symm


end ECDSAAdd.Entrant.StairLoanRecordKernel

end
