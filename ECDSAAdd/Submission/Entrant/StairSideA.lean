private theorem program_counts_delta (divide : Bool) (P Q : Nat → Program)
    (extra first count : Nat)
    (step : ∀ j,
      toffoliCount (P j) = toffoliCount (Q j) + extra ∧
      measurementCount (P j) = measurementCount (Q j) + extra) :
    toffoliCount (PacketSequence.program divide P first count) =
        toffoliCount (PacketSequence.program divide Q first count) + extra * count ∧
      measurementCount (PacketSequence.program divide P first count) =
        measurementCount (PacketSequence.program divide Q first count) + extra * count := by
  induction count generalizing first with
  | zero => simp [PacketSequence.program, toffoliCount, measurementCount]
  | succ count ih =>
      have head := step first
      have rest := ih (first + 1)
      cases divide <;>
        simp only [PacketSequence.program, Bool.false_eq_true, if_false, if_true,
          toffoliCount_append, measurementCount_append, Nat.mul_succ] at head rest ⊢ <;>
        omega

