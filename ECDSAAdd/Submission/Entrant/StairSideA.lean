theorem result (j : Fin 26) (h0 : 3 ≤ j.val) (h1 : j.val ≤ 23) (x p : Nat) (good : Bounds x p) (raw s : State) (m : List Bool) (g sg : Bool)
    (domain : Domain (start j) x p raw)
