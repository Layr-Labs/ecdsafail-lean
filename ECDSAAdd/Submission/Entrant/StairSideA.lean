/-! ## LT45 (replay budget): the multiplication endpoint without a kernel pass

`endPacket760Loan44 false` only touches wires of the record endpoint
(`endPacket760Loan44_support`) and none of the 44 roles
(`endPacket760Loan44_avoids_roles`).  The record endpoint is three renames and a
`loanWindow` around `InverseEndpointC.half` plus padding, and the record's
`InverseTailC.half_tight` lists the labels of that half.  One table over these 770
labels (instead of 11,624 instructions, 88 s) gives `TPI` off the roles. -/

/-- The record endpoint layout. -/
abbrev endLayout : BalancedCircuit.Layout := Q6EndpointCell.ports base (base 2409)

theorem endLayout_nodup : endLayout.wires.Nodup :=
  Q6EndpointCell.ports_nodup_injective base (base 2409) base_injective (by
    intro member
    obtain ⟨i, hi, eq⟩ := List.mem_map.mp member
    have same := base_injective eq
    have bound := Q6EndpointCell.ids_bound i hi
    omega)

/-- A superset of the labels of `R2SqEp760.endPacket760 false`. -/
def multEndL : List Wire :=
  (base 510 :: base 2409 :: ((base 512 :: (endLayout.sign :: endLayout.parity ::
      endLayout.one :: endLayout.lower ::
        (endLayout.y ++ endLayout.r ++ endLayout.carry.take 254))).map
    (Equiv.swap (base 719) (base 510)))).map
      (fun z => Equiv.swap (base 760) (base 717) (shifted Placement5.pi0 z))

theorem multEnd_tab : multEndL.all (fun y =>
    decide (RoleI y) || decide (TPI (OB5.sig 511 y))) = true := by
  decide +kernel

theorem endPacket760_false_shape :
    R2SqEp760.endPacket760 false =
      renameProgram (Equiv.swap (base 760) (base 717))
        (renameProgram (shifted Placement5.pi0)
          (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
            (InverseEndpointC.half endLayout ++
              List.replicate 256 (Instr.measureX (base 512) [] [])))) := by
  unfold R2SqEp760.endPacket760 Rolling1588Lifetime.endPacket
    Rolling1588Lifetime.rawEnd Rolling1588Lifetime.endHalf
  rfl

attribute [local irreducible] ECDSAAdd.wires in
theorem endPacket760_false_mem :
    ∀ y ∈ wires (R2SqEp760.endPacket760 false), y ∈ multEndL := by
  intro y hrec
  rw [endPacket760_false_shape, renameProgram_support] at hrec
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hrec
  rw [renameProgram_support] at ha
  obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp ha
  apply List.mem_map.mpr
  refine ⟨z, ?_, rfl⟩
  rcases Finset.mem_union.mp (ControlLoan1589.loanWindow_support _ _ _ _ hz) with h | h
  · rw [Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl
    · exact List.mem_cons_self ..
    · exact List.mem_cons_of_mem _ (List.mem_cons_self ..)
  · obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp h
    refine List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_map.mpr ⟨w, ?_, rfl⟩))
    rw [wires_append, Finset.mem_union] at hw
    rcases hw with hw | hw
    · exact List.mem_cons_of_mem _ (List.mem_toFinset.mp
        (InverseTailC.half_tight endLayout (Q6EndpointCell.ports_widths base (base 2409))
          endLayout_nodup hw))
    · have hc := (InverseEndpointWires.pad_facts 256 (base 512)).2.2.2.1 hw
      rw [Finset.mem_singleton] at hc
      rw [hc]
      exact List.mem_cons_self ..

attribute [local irreducible] ECDSAAdd.wires in
theorem endpointMult39 : PieceOK StairCertificate.holes39 TP
    (StairHostsSchedule.hostedEndpoint hp false 68) := by
  apply ok39_of_tpi
  intro x hx
  have e : StairConcrete.bestLoans.endPacket false 68 =
      StairEndpointLoan44.endPacket760Loan44 false := by
    simp only [StairConcrete.bestLoans, StairConcrete.endPacket, Bool.false_eq_true,
      if_false, if_true]
  rw [StairHostsSchedule.hostedEndpoint, StairSchedule.placedEndPacket, e,
    renameProgram_support] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  have notRole : ¬ RoleI y := fun m =>
    StairEndpointLoan44.endPacket760Loan44_avoids y (roleI_mem m) hy
  have t := List.all_eq_true.mp multEnd_tab y
    (endPacket760_false_mem y (StairEndpointLoan44.endPacket760Loan44_support hy))
  simp only [Bool.or_eq_true, decide_eq_true_eq] at t
  exact t.resolve_left notRole

