theorem scratchWire_band {q : Nat}
    (h : q ∈ (1556 :: 1557 :: 1558 :: fullC : List Nat)) : 1556 ≤ q ∧ q ≤ 1575 := by
  simp only [List.mem_cons, fullC, List.mem_map, List.mem_range] at h
