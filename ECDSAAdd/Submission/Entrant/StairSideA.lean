namespace ECDSAAdd.Entrant.HighBankJoin
open Arithmetic RecordedQuantum

/-- Each output column retains either the shadow site (before take) or the
tube site (at and after take). The other site is available as a clean ancilla. -/
def pair (low : Bool) (active shadow tube : Wire) : Program :=
  if low then [.CX tube shadow,.CCX active shadow tube]
  else [.CX shadow tube,.CX tube shadow,.CCX active tube shadow]

theorem pair_run (low : Bool) (a s w : Wire) (distinct : [a,s,w].Nodup)
    (input : State) (m : List Bool)
    (clean : if input.basis a then input.basis s=false else input.basis w=false) :
    let out := run (pair low a s w) m input
    out.phase=input.phase ∧
    out.basis (if low then s else w)=(input.basis s ^^ input.basis w) ∧
    out.basis (if low then w else s)=false ∧
    ∀ q, q≠s → q≠w → out.basis q=input.basis q := by
  obtain ⟨has,haw,hsw⟩ : a≠s ∧ a≠w ∧ s≠w := by simpa [and_assoc] using distinct
  dsimp only
  cases low <;> cases ha : input.basis a <;> cases hs : input.basis s <;> cases hw : input.basis w <;>
    simp_all [pair,run,writeBit,Function.update,Ne.symm hsw]

theorem pair_counts (low : Bool) (a s w : Wire) :
    toffoliCount (pair low a s w)=1 ∧ measurementCount (pair low a s w)=0 := by
  cases low <;> exact ⟨rfl,rfl⟩

theorem pair_physical (low : Bool) (a s w : Wire) (distinct : [a,s,w].Nodup) :
    GatePhysical (pair low a s w) := by
  obtain ⟨has,haw,hsw⟩ : a≠s ∧ a≠w ∧ s≠w := by simpa [and_assoc] using distinct
  cases low <;> simp_all [pair,GatePhysical,PhysicalInstr,ProperGate,ne_comm]

/-- The two literal CCX operations in each one-hot digit-clear row. -/
def clearDigit (hot cross d1 lo hi : Wire) : Program := [.CCX hot cross lo,.CCX hot d1 hi]

theorem clear_run (h c d a b : Wire) (distinct : [h,c,d,a,b].Nodup) (s : State) (m : List Bool) :
    let out := run (clearDigit h c d a b) m s
    out.phase=s.phase ∧
    out.basis a=(s.basis a ^^ (s.basis h && s.basis c)) ∧
    out.basis b=(s.basis b ^^ (s.basis h && s.basis d)) ∧
    ∀ q, q≠a → q≠b → out.basis q=s.basis q := by
  have dif : h≠a ∧ d≠a ∧ a≠b := by simp_all [List.nodup_cons]
  obtain ⟨ha,da,ab⟩ := dif
  simp [clearDigit,run,writeBit,Function.update,ha,da,ab,Ne.symm ab]
  intro q qa qb; simp [qa,qb]

/-- Clearing the two indicated digit positions produces exactly the low
remainder, including columns outside the stored two-bit digit. -/
theorem cleared_bits (X t j : Nat) (cross d1 : Bool)
    (digit : X/2^t = cross.toNat + 2*d1.toNat) :
    ((X.testBit j ^^ (decide (j=t) && cross)) ^^ (decide (j=t+1) && d1)) =
      (X%2^t).testBit j := by
  let r := X%2^t
  have hr : r<2^t := Nat.mod_lt _ (Nat.two_pow_pos _)
  have bits := Nat.testBit_two_pow_mul_add (X/2^t) hr j
  rw [show 2^t*(X/2^t)+r=X from Nat.div_add_mod _ _] at bits
  rw [bits]
  by_cases lt : j<t
  · simp [lt,show j≠t by omega,show j≠t+1 by omega,r]
  have zero := Nat.testBit_lt_two_pow (lt_of_lt_of_le hr (Nat.pow_le_pow_right (by decide) (show t≤j by omega)))
  change r.testBit j=false at zero
  change _=r.testBit j
  rw [zero,if_neg lt,digit]
  by_cases e : j=t
  · subst j; cases cross <;> cases d1 <;> simp
  by_cases e1 : j=t+1
  · subst j; cases cross <;> cases d1 <;> simp <;> decide
  have high : 2≤j-t := by omega
  have small : cross.toNat+2*d1.toNat<4 := by cases cross <;> cases d1 <;> decide
  have powBound : 2^2 ≤ 2^(j-t) := Nat.pow_le_pow_right (by decide) high
  have zero' := Nat.testBit_lt_two_pow (lt_of_lt_of_le small powBound)
  simp [e,e1,zero']

/-- At each column the shifted tube and the cleared shadow have disjoint
support. Their XOR is the matching bit of the reassembled positive word. -/
theorem merged_bits (X bank t j : Nat) :
    let a := (X%2^t).testBit j
    let b := (2^t*bank).testBit j
    (if t≤j then a=false else b=false) ∧
    (a ^^ b)=(2^t*bank+X%2^t).testBit j := by
  have hr := Nat.mod_lt X (Nat.two_pow_pos t)
  dsimp only
  rw [Nat.testBit_two_pow_mul_add bank hr j,Nat.testBit_two_pow_mul]
  by_cases h : t≤j
  · have z := Nat.testBit_lt_two_pow (lt_of_lt_of_le hr (Nat.pow_le_pow_right (by decide) h))
    simp [h,Nat.not_lt.mpr h,z]
  · simp [h,Nat.lt_of_not_ge h]

end ECDSAAdd.Entrant.HighBankJoin

