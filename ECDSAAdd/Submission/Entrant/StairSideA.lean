  (from `physicalPrimitives_caller`, kernel labels, via `own_of_fieldPlace`);
* `hosts_caller` — LT13's group hosts `StairPhysicalLayout.hosts B`;
* the phase-context first-row pieces (`phaseBMove`, `phaseBReturn`, the
  `phaseRelabel` relabelled codec; LT13's `phasePackTail` / `phaseUnpackHead`)
  from `StairPhysicalPhase.phaseKernel_caller`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed



/-! ## Re-planned primitives -/









/-! ## Re-planned hosts -/

theorem hosts_caller : ∀ B ∈ StairPhysicalLayout.budgets, ∀ h ∈ StairPhysicalLayout.hosts B,
    h ∈ callerDomain := by
  have k : ∀ B ∈ StairPhysicalLayout.budgets, ∀ h ∈ StairPhysicalLayout.hosts B,
      callerNat h = true := by
    decide +kernel
  intro B hB h hh
  exact callerNat_sound h (k B hB h hh)

/-! ## Phase-context first row -/

theorem caller_of_phaseHost (q : Wire) (h : Rolling1588Lifetime.phaseHost q ∈ callerDomain) :
    q ∈ callerDomain := by
  have back := preserves_phaseHost_symm _ h
  simpa only [Equiv.symm_apply_apply] using back

theorem phaseRelabel_own (P : Program)
    (hP : ∀ r ∈ wires P, r ∈ StairPhysicalLayout.letterSite 424 :: StairPhysicalLayout.rowSites 87) :
    wires (renameProgram StairPhysicalLayout.phaseRelabel P) ⊆ callerDomain := by
  rw [renameProgram_support]
  intro q hq
  obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hq
  exact caller_of_phaseHost _
    ((callerList_iff _).mp (StairPhysicalPhase.phaseKernel_caller.1 r (hP r hr)))

theorem phaseBMove_own : wires StairPhysicalLayout.phaseBMove ⊆ callerDomain :=
  allCaller_sound _ (by decide +kernel)

theorem phaseBReturn_own : wires StairPhysicalPhase.phaseBReturn ⊆ callerDomain :=
  allCaller_sound _ (by decide +kernel)

theorem phasePack_relabel_own :
    wires (renameProgram StairPhysicalLayout.phaseRelabel StairPhysicalPhase.phasePack) ⊆
