namespace ECDSAAdd.Entrant.StairHostsSchedule

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-- Host choices at every syntactic lifetime boundary.  Lists may be reused
across fields because the corresponding components are sequential. -/
structure HostPlan where
  group : Bool → Nat → Nat → Nat → List Wire
  endpoint : Bool → Nat → List Wire
  copy : Bool → List Wire
  canon : List Wire
  center : List Wire
  firstPacket : Bool → List Wire
  x1 : Nat → List Wire

/-- v3 group hosting: the exclusive roles not yet loaned at deficit `d`
(`exclusiveRoles.drop d`, `44 - d` of them) are rebound onto the plan's
hosts.  The exclusive roles are their own physical sites, so no retirement
swap is applied. -/
def hostedGroup (h : HostPlan) (divide : Bool)
    (deficit first count : Nat) : Program :=
  StairLoan.rebindMany (StairSchedule.exclusiveRoles.drop deficit)
    (h.group divide deficit first count)
    (StairSchedule.placedGroups StairConcrete.bestLoans divide deficit first count)

/-- v3: the boundary endpoint is the loan provider's endpoint (no hosting).
OPEN (LT13 finding B): the boundary components need carry loans or physical
hosts for the 44 exclusive roles. -/
def hostedEndpoint (_h : HostPlan) (divide : Bool) (deficit : Nat) : Program :=
  StairSchedule.placedEndPacket StairConcrete.bestLoans divide deficit


/-- v3: copy/canon (record programs; OPEN: loans or hosts, LT13 finding B). -/
def entryTailSuffix (h : HostPlan) : Program :=
  hostedGroup h true 44 100 2 ++
    renameProgram (OB5.sig 511) StairConcrete.bestLoans.divEndpoint ++
    HalfFieldOB5.copyN ++ StairConcrete.bestLoans.canon

def exitHeadPrefix (h : HostPlan) : Program :=
  StairConcrete.bestLoans.center ++ HalfFieldOB5.copyN ++
    hostedEndpoint h false 68 ++ hostedGroup h false 44 100 2



/-- LT47 (defect 2): complete scratch windows on both sides of the moved setup/X. -/
def entryLowSuffix (h : HostPlan) : Program :=
  FourScratchWindow.clearProgram ++
    renameProgram Prefix1590.borrow (entryTailSuffix h) ++
    FourScratchWindow.unprefix

def exitLowPrefix (h : HostPlan) : Program :=
