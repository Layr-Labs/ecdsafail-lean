open StairField2V3SegSpec StairField2V3LastStage StairField2V3LastTraj StairField2V3LastRec

/-- Stage ids of the moved carries and released rail-`b` bits (clean at tick 505). -/
def zcand : List Nat := List.range' 779 79 ++ List.range' 1540 87

abbrev FsClass (r : Wire) : Prop :=
  (r ∈ pk 100 ++ pk 101 ∧ StairTerminalV3.terminalPerm r = r) ∨
    (r = base 510 ∧ StairTerminalV3.terminalPerm r = base 510) ∨
    (r = base 2409 ∧ StairTerminalV3.terminalPerm r = base 511) ∨
    (r = base 1797 ∧ StairTerminalV3.terminalPerm r = base 1543) ∨
    (StairTerminalV3.terminalPerm r ∈ (List.range' 512 516).map base ∧ r ∉ futurePayload 12)

theorem fs_chk : ∀ r ∈ StairTerminalV3.forwardSites,
    StairTerminalV3.terminalPerm (StairTerminalV3.terminalPerm r) = r ∧
      Chk (StairTerminalV3.terminalPerm r) := by
  decide +kernel

theorem fs_class : ∀ r ∈ StairTerminalV3.forwardSites, FsClass r := by
  decide +kernel

theorem fp_class : ∀ r ∈ futurePayload 12, r ∈ StairTerminalV3.forwardSites ∧
    r ≠ base 2409 ∧ r ≠ base 1797 := by
  decide +kernel

theorem pk_class : ∀ r ∈ pk 100 ++ pk 101, r ∈ futurePayload 12 ∨ r ∈ holes 100 ++ holes 101 := by
  decide +kernel

theorem zcand_ok : ∀ id ∈ zcand, 500 ≤ id ∧ ¬ (1028 ≤ id ∧ id < 1528) ∧ id ≠ 1797 ∧
    ((500 ≤ id ∧ id < 1028) ∨ 1528 ≤ id) ∧ ZeroI id := by
  decide +kernel

theorem rest12 : ∀ r ∈ unpackSites 12 ++ walkSites 12,
    (r ∈ CT ∨ r ∈ futurePayload 12) ∧
      (r ∈ StairTerminalV3.forwardSites ∨ r = zeroWire ∨ (r ∈ ZList 12 ∧ r ∉ walkSites 12) ∨
        r ∈ zcand.map wm) := by
  decide +kernel

theorem fs_CT : ∀ r ∈ StairTerminalV3.forwardSites, r ∈ CT := fun _ hr =>
  List.mem_append_left _ (List.mem_append_left _ (List.mem_append_right _ hr))

theorem recVal_510 (origin : BasisState) :
    recVal origin (base 510) = origin (base 510) := by
  rw [recVal_defLR]
  rw [sig_low 510 (by omega)]
  exact run_preserves_outside _ _ _ _
    (allEncode_avoid base base_injective 102 510 (by omega))

theorem bool3 (a b c : Bool) (h : (a ^^ b) = (c ^^ c)) : a = b := by
  cases a <;> cases b <;> cases c <;> simp at h ⊢





