/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSlotsV3Codec_at_QTop` -/
section Merge_StairSlotsV3Codec_at_QTop

/-!
# Exact codec and phase-move slot costs on LT13's `physicalLayout`

`StairPhysicalPrimitives.pack B` is sign extension, the generated codec
`StairCodec.pack (physicalLayout B) B` and the rest relocation
(`2 (B - 1)` CX); `unpack B` mirrors it.  The six pair totals are checked by
kernel evaluation.  They equal the PK2 generated-codec totals
`5412, 3656, 2725, 1757, 1173, 582` plus `2 + 4 (B - 1)`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000

namespace ECDSAAdd.Entrant.StairSlotsPlan

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Baselines
open StairPhysicalLayout StairPhysicalPhase

/-! ## K5 (replay budget): codec slots with each decoder delta evaluated once

`StairCodec.pack` / `unpack` evaluate `decoderDelta` (a run of the one-hot decoder) twice per
step, `2 (B - 1)` times per codec.  The step slot counts are linear in the delta lengths
(`k5_packStep_slots`, `k5_unpackStep_slots`, for every layout); the delta lengths are then read
from one lazily evaluated table per decoder (`k5_dl`, `k5_dh`), so each of the at most
`2 ^ ⌈w/2⌉ + 2 ^ ⌊w/2⌋` distinct deltas is evaluated once per pair (pack and unpack share). -/

theorem k5_cxInto_slots (t : Wire) (l : List Wire) : gateSlots (StairCodec.cxInto t l) = l.length := by
  induction l with
  | nil => rfl
  | cons q l ih =>
      simp only [StairCodec.cxInto, List.map_cons, gateSlots, List.sum_cons, instructionSlots,
        List.length_cons] at ih ⊢
      omega

theorem k5_flatMap_slots {α : Type} (l : List α) (f : α → Program) :
    gateSlots (l.flatMap f) = (l.map (fun x => gateSlots (f x))).sum := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [List.flatMap_cons, gateSlots_append, ih, List.map_cons, List.sum_cons]

theorem k5_packStep_slots (L : StairCodec.Layout) (B j : Nat) :
    gateSlots (StairCodec.packStep L B j) =
      5 + ((List.range (StairCodec.bitWidth B)).filter (fun b => (j + 1).testBit b)).length +
        (StairCodec.decoderDelta (StairCodec.lowDecoder L B) (StairCodec.lowBits L B)
          ((j + 1) % 2 ^ (StairCodec.bitWidth B / 2))).length +
        (StairCodec.decoderDelta (StairCodec.highDecoder L B) (StairCodec.highBits L B)
          ((j + 1) / 2 ^ (StairCodec.bitWidth B / 2))).length +
        (if j < B - 2 then 3 else 0) := by
  simp only [StairCodec.packStep]
  split_ifs <;> simp only [gateSlots_append, k5_cxInto_slots, List.length_map] <;>
    simp [gateSlots, instructionSlots] <;> omega

theorem k5_packFirstStep_slots (L : StairCodec.Layout) (B : Nat) :
    gateSlots (StairCodec.packFirstStep L B) =
      gateSlots (StairCodec.packStep L B (B - 2)) := by
  rfl

theorem k5_unpackStep_slots (L : StairCodec.Layout) (B j : Nat) :
    gateSlots (StairCodec.unpackStep L B j) =
      5 + ((List.range (StairCodec.bitWidth B)).filter (fun b => (j + 1).testBit b)).length +
        (StairCodec.decoderDelta (StairCodec.lowDecoder L B) (StairCodec.lowBits L B)
          ((j + 1) % 2 ^ (StairCodec.bitWidth B / 2))).length +
        (StairCodec.decoderDelta (StairCodec.highDecoder L B) (StairCodec.highBits L B)
          ((j + 1) / 2 ^ (StairCodec.bitWidth B / 2))).length +
        (if j < B - 2 then 2 else 0) := by
  simp only [StairCodec.unpackStep]
  split_ifs <;> simp only [gateSlots_append, k5_cxInto_slots, List.length_map] <;>
    simp [gateSlots, instructionSlots] <;> omega

/-- Delta length of the low decoder (kept folded so that `simp` does not loop). -/
def k5dl (L : StairCodec.Layout) (B x : Nat) : Nat :=
  (StairCodec.decoderDelta (StairCodec.lowDecoder L B) (StairCodec.lowBits L B) x).length

def k5dh (L : StairCodec.Layout) (B x : Nat) : Nat :=
  (StairCodec.decoderDelta (StairCodec.highDecoder L B) (StairCodec.highBits L B) x).length

/-- One table per decoder; entries are evaluated lazily, each at most once. -/
def k5tabL (L : StairCodec.Layout) (B : Nat) : List Nat := (List.range B).map (k5dl L B)

def k5tabH (L : StairCodec.Layout) (B : Nat) : List Nat := (List.range B).map (k5dh L B)

theorem k5_getD_tab (f : Nat → Nat) (B x : Nat) :
    ((List.range B).map f).getD x (f x) = f x := by
  rw [List.getD_eq_getElem?_getD]
  by_cases h : x < B
  · simp [h]
  · simp [h]

theorem k5_dl (L : StairCodec.Layout) (B x : Nat) :
    (StairCodec.decoderDelta (StairCodec.lowDecoder L B) (StairCodec.lowBits L B) x).length =
      (k5tabL L B).getD x (k5dl L B x) :=
  (k5_getD_tab (k5dl L B) B x).symm

theorem k5_dh (L : StairCodec.Layout) (B x : Nat) :
    (StairCodec.decoderDelta (StairCodec.highDecoder L B) (StairCodec.highBits L B) x).length =
      (k5tabH L B).getD x (k5dh L B x) :=
  (k5_getD_tab (k5dh L B) B x).symm

