    (roleTail : ∀ q ∈ roles.take d, q ∈ cs.drop (d + 1))
    (post : forward = true →
      (run (Arithmetic.compareChain none as bs (cs ++ [last]) cin target)
        n s).basis target = false) :
    run (compareLoan d roles forward as bs cs cin target) m s =
      run (Q6LifetimeResearch.compareChain forward as bs cs cin target) n s := by
  let bits := mappedRead as false
  let layers := compareLayers forward as bs cs cin target
  let topProgram := compareTop forward as bs cs cin target
  let P := emitUps (layers.take (d + 1))
  let U := emitSweep (layers.drop (d + 1)) topProgram
  let u := run P [] s
  let reference := Arithmetic.compareChain none (as.drop (d + 1))
    (bs.drop (d + 1)) (cs.drop (d + 1) ++ [last])
    (carryAfter (d + 1) cs cin) target
  let v := run reference [] u
  let out := run (Arithmetic.compareChain none as bs (cs ++ [last]) cin target) n s
  have mappedND : (cin :: (bs ++ cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp nd q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    omega
  have sourceAway : ∀ q ∈ mappedWires bits, q ∉ cin :: (bs ++ cs) := by
    intro q hq bad
    simp only [bits, mappedRead_wires] at hq
    have h := List.nodup_iff_count.mp nd q
    have ha := List.count_pos_iff.mpr hq
    simp only [List.mem_cons, List.mem_append] at bad
    rcases bad with rfl | targetMem | carryMem
    · simp only [List.count_cons, List.count_append, List.count_nil,
        beq_self_eq_true, if_true] at h ha
      omega
    · have hb := List.count_pos_iff.mpr targetMem
      simp only [List.count_cons, List.count_append, List.count_nil] at h ha hb
      omega
    · have hcq := List.count_pos_iff.mpr carryMem
      simp only [List.count_cons, List.count_append, List.count_nil] at h ha hcq
      omega
  have prefixShapes := compare_prefix_shapes (d + 1) forward as bs cs cin target
    hab hc hd
  have borrowShapes := compare_prefix_shapes d forward as bs cs cin target
    hab hc (by omega)
  have prefixShape : P = carryPrefix (d + 1) bits bs cs cin := prefixShapes.1
  have eraseShape : emitErases (layers.take d) = erasePrefix d bits bs cs cin :=
    borrowShapes.2.1
  have borrowShape : emitUps (layers.take d) = carryPrefix d bits bs cs cin :=
    borrowShapes.1
  have hostShape : layerHosts (layers.take d) = cs.take d := borrowShapes.2.2
  have prefixZero : measurementCount P = 0 := by
    rw [prefixShape]
    exact (carryPrefix_counts (d + 1) bits bs cs cin (by
      simp only [bits, mappedRead_length]
      omega) (by omega) hd).2
  have prefixRun : ∀ rec, run P rec s = u := by
    intro rec
    exact FifthCarry.no_records P prefixZero s rec []
  have prefixFrame := carryPrefix_frame (d + 1) bits bs cs cin s [] mappedND
    sourceAway (by simp only [bits, mappedRead_length]; omega) (by omega) hd
    (fun q hq => clean q (by simp [List.mem_of_mem_take hq]))
  rw [← prefixShape] at prefixFrame
  change u.phase = s.phase ∧ PrefixReady (d + 1) bits bs cs cin u.basis ∧
    ∀ q, q ∉ cs.take (d + 1) → u.basis q = s.basis q at prefixFrame
  have csND : cs.Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp nd q
    simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
    omega
  have tailND : (target :: carryAfter (d + 1) cs cin ::
      (as.drop (d + 1) ++ bs.drop (d + 1) ++
        (cs.drop (d + 1) ++ [last]))).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp nd q
    have ha := (List.drop_sublist (d + 1) as).count_le q
    have hb := (List.drop_sublist (d + 1) bs).count_le q
    have hcs := (List.drop_sublist (d + 1) cs).count_le q
    by_cases eq : q = carryAfter (d + 1) cs cin
    · subst q
      have memberLow := carryAfter_succ_take_mem d cs cin hd
      have memberFull := carryAfter_succ_mem d cs cin hd
      have awayDrop : carryAfter (d + 1) cs cin ∉ cs.drop (d + 1) := fun tail =>
        List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d + 1))) memberLow tail
      have awayAs : carryAfter (d + 1) cs cin ∉ as := by
        intro mem
        have hp := List.count_pos_iff.mpr mem
        have hcp := List.count_pos_iff.mpr memberFull
        simp only [List.count_cons, List.count_append, List.count_nil] at h hp hcp
        omega
      have awayBs : carryAfter (d + 1) cs cin ∉ bs := by
        intro mem
        have hp := List.count_pos_iff.mpr mem
        have hcp := List.count_pos_iff.mpr memberFull
        simp only [List.count_cons, List.count_append, List.count_nil] at h hp hcp
        omega
      have awayScalars : carryAfter (d + 1) cs cin ∉ [target, cin, last] := by
        intro mem
        have hp := List.count_pos_iff.mpr mem
        have hcp := List.count_pos_iff.mpr memberFull
        simp only [List.count_cons, List.count_append, List.count_nil] at h hp hcp
        omega
      have da : List.count (carryAfter (d + 1) cs cin)
          (as.drop (d + 1)) = 0 :=
        List.count_eq_zero.mpr (fun mem => awayAs (List.mem_of_mem_drop mem))
      have db : List.count (carryAfter (d + 1) cs cin)
          (bs.drop (d + 1)) = 0 :=
        List.count_eq_zero.mpr (fun mem => awayBs (List.mem_of_mem_drop mem))
      have dc : List.count (carryAfter (d + 1) cs cin)
          (cs.drop (d + 1)) = 0 := List.count_eq_zero.mpr awayDrop
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at awayScalars
      rcases awayScalars with ⟨htarget, hcin, hlast⟩
      have htarget' := Ne.symm htarget
      have hlast' := Ne.symm hlast
      simp [da, db, dc, htarget', hlast']
    · have eq' : carryAfter (d + 1) cs cin ≠ q := Ne.symm eq
      simp only [List.count_cons, List.count_append, List.count_nil] at h ha hb hcs ⊢
      simp at h
      simp [eq'] at ⊢
      omega
  have cleanU : ∀ q ∈ cs.drop (d + 1) ++ [last], u.basis q = false := by
    intro q hq
    simp only [List.mem_append, List.mem_singleton] at hq
    rcases hq with carry | qlast
    · rw [prefixFrame.2.2 q (by
        intro low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d + 1))) low carry)]
      exact clean q (by simp [List.mem_of_mem_drop carry])
    · have eq : q = last := qlast
      rw [eq, prefixFrame.2.2 last (by
        intro low
        have h := List.nodup_iff_count.mp nd last
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_take low)
        simp only [List.count_cons, List.count_append, List.count_nil,
          beq_self_eq_true, if_true] at h hp
        omega)]
      exact clean last (by simp)
  have upperShape : U = Q6LifetimeResearch.compareChain forward
      (as.drop (d + 1)) (bs.drop (d + 1)) (cs.drop (d + 1))
      (carryAfter (d + 1) cs cin) target :=
    compare_upper_sweep (d + 1) forward as bs cs cin target hab hc hd
  have tailLengths : (as.drop (d + 1)).length = (bs.drop (d + 1)).length := by
    simp [hab]
  have tailCarryLength : (cs.drop (d + 1)).length + 1 =
      (bs.drop (d + 1)).length := by
    simp only [List.length_drop]
    omega
  have referenceCarryLength : (cs.drop (d + 1) ++ [last]).length =
      (bs.drop (d + 1)).length := by
    simp only [List.length_append, List.length_singleton]
    omega
  have tailNonempty : bs.drop (d + 1) ≠ [] := by
    intro empty
    have len := congrArg List.length empty
    simp only [List.length_drop, List.length_nil] at len
    omega
  have ignoreLast := lift_compareChain_ignores_last forward (as.drop (d + 1))
    (bs.drop (d + 1)) (cs.drop (d + 1)) (carryAfter (d + 1) cs cin)
    last target tailLengths tailCarryLength tailNonempty
  have upperPost : forward = true → (run reference [] u).basis target = false := by
    intro hf
    change (run (Arithmetic.compareChain none (as.drop (d + 1))
      (bs.drop (d + 1)) (cs.drop (d + 1) ++ [last])
      (carryAfter (d + 1) cs cin) target) [] (run P [] s)).basis target = false
    rw [prefixShape]
    exact lift_compareChain_tail_post (d + 1) as bs cs cin last target s n hab
      (by omega) hd nd clean (post hf)
  have upperRun : ∀ rec, run U rec u = v := by
    intro rec
    change run U rec u = run reference [] u
    rw [upperShape, ← ignoreLast]
    exact Q6LifetimeProof.compare_chain_eq_old forward (as.drop (d + 1))
      (bs.drop (d + 1)) (cs.drop (d + 1) ++ [last])
      (carryAfter (d + 1) cs cin) target tailND tailLengths
      referenceCarryLength tailNonempty u rec [] cleanU upperPost
  have control : ∀ c ∈ (none : Option Wire),
      c ∉ target :: carryAfter (d + 1) cs cin ::
        (as.drop (d + 1) ++ bs.drop (d + 1) ++
          (cs.drop (d + 1) ++ [last])) := by simp
  have referenceFrame := compareChain_correct none (as.drop (d + 1))
    (bs.drop (d + 1)) (cs.drop (d + 1) ++ [last])
    (carryAfter (d + 1) cs cin) target tailND control tailLengths
    referenceCarryLength u [] cleanU
  change v.phase = u.phase ∧ (∀ q, q ≠ target → v.basis q = u.basis q) ∧ _
    at referenceFrame
  have upperAway : ∀ q ∈ wires U, q ∉ cs.take d := by
    intro q hq low
    rw [upperShape] at hq
    have used := compareChain_support forward (as.drop (d + 1))
      (bs.drop (d + 1)) (cs.drop (d + 1))
      (carryAfter (d + 1) cs cin) target hq
    simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
      List.not_mem_nil, or_false] at used
    have lowFull := List.mem_of_mem_take low
    have h := List.nodup_iff_count.mp nd q
    have flat : q ∈ as.drop (d + 1) ∨ q ∈ bs.drop (d + 1) ∨
        q ∈ cs.drop (d + 1) ∨ q = carryAfter (d + 1) cs cin ∨
          q = target := by tauto
    rcases flat with source | output | carry | input | result
    · have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop source)
      have hl := List.count_pos_iff.mpr lowFull
      simp only [List.count_cons, List.count_append, List.count_nil] at h hp hl
      omega
    · have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop output)
      have hl := List.count_pos_iff.mpr lowFull
      simp only [List.count_cons, List.count_append, List.count_nil] at h hp hl
      omega
    · exact List.disjoint_left.mp
        (List.disjoint_take_drop csND (by omega)) low carry
    · exact carryAfter_succ_away d cs cin csND hd (input ▸ low)
    · have hp : q ∈ [target] := by simp [result]
      have hpp := List.count_pos_iff.mpr hp
      have hl := List.count_pos_iff.mpr lowFull
      simp only [List.count_cons, List.count_append, List.count_nil] at h hpp hl
      omega
  have targetAwayTracked :
      ∀ q ∈ mappedWires (bits.take d) ++ bs.take d ++ cs.take d ++ [cin],
        q ≠ target := by
    intro q hq eq
    have h := (List.nodup_cons.mp nd).1
    apply h
    subst q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hq
    have flat : target ∈ mappedWires (bits.take d) ∨ target ∈ bs.take d ∨
        target ∈ cs.take d ∨ target = cin := by tauto
    rcases flat with source | output | carry | input
    · have sourceFull : target ∈ as := by
        have all := mappedWires_take_mem d bits target source
        simpa only [bits, mappedRead_wires] using all
      simp [sourceFull]
    · simp [List.mem_of_mem_take output]
    · simp [List.mem_of_mem_take carry]
    · simp [input]
  have upperSame :
      ∀ q ∈ mappedWires (bits.take d) ++ bs.take d ++ cs.take d ++ [cin],
        v.basis q = u.basis q := fun q hq =>
    referenceFrame.2.1 q (targetAwayTracked q hq)
  have upperRoleZero : ∀ q ∈ roles.take d, v.basis q = false := by
    intro q hq
    have tail := roleTail q hq
    rw [referenceFrame.2.1 q (by
      intro eq
      have h := (List.nodup_cons.mp nd).1
      apply h
      subst q
      simp [List.mem_of_mem_drop tail]), prefixFrame.2.2 q (by
      intro low
      exact List.disjoint_left.mp
        (List.disjoint_take_drop csND (Nat.le_refl (d + 1))) low tail)]
    exact clean q (by simp [List.mem_of_mem_drop tail])
  have fullNonempty : bs ≠ [] := by
    intro empty
    have len := congrArg List.length empty
    simp only [List.length_nil] at len
    omega
  have fullIgnore := lift_compareChain_ignores_last forward as bs cs cin last target
    hab hc fullNonempty
  have fullCarryLength : (cs ++ [last]).length = bs.length := by
    simp only [List.length_append, List.length_singleton]
    omega
  have wholeRun : ∀ rec, run (emitSweep layers topProgram) rec s = out := by
    intro rec
    change run (emitSweep layers topProgram) rec s =
      run (Arithmetic.compareChain none as bs (cs ++ [last]) cin target) n s
    rw [← compareChain_as_sweep forward as bs cs cin target, ← fullIgnore]
    exact Q6LifetimeProof.compare_chain_eq_old forward as bs (cs ++ [last])
      cin target nd hab fullCarryLength fullNonempty s rec n clean post
  have cleanCs : ∀ q ∈ cs, s.basis q = false := fun q hq => clean q (by simp [hq])
  have replay := emitLoan_mapped_prefix_run_eq d roles layers topProgram bits bs
    cs cin s u v out m n mappedND sourceAway prefixShape eraseShape borrowShape
    hostShape prefixZero prefixRun prefixFrame.2.1 prefixFrame.2.2 cleanCs
    roleTail upperRun upperAway upperSame upperRoleZero wholeRun
  rw [← compareChain_as_sweep forward as bs cs cin target] at replay
  exact replay

private theorem join_records (P Q : Program) (s : State)
    (m n : List Bool) :
    ∃ records, run (P ++ Q) records s = run Q n (run P m s) := by
  let headRecords :=
    (m ++ List.replicate (measurementCount P) false).take
      (measurementCount P)
  have headLength : headRecords.length = measurementCount P := by
    simp only [headRecords, List.length_take, List.length_append,
      List.length_replicate]
    omega
  have headRun : run P headRecords s = run P m s := by
    change run P
      ((m ++ List.replicate (measurementCount P) false).take
        (measurementCount P)) s = _
    rw [run_take, run_pad_false]
  have take : (headRecords ++ n).take (measurementCount P) = headRecords := by
    rw [List.take_append, headLength, Nat.sub_self, List.take_zero,
      List.append_nil, ← headLength, List.take_length]
  have drop : (headRecords ++ n).drop (measurementCount P) = n := by
    rw [List.drop_append, headLength, Nat.sub_self, List.drop_zero,
      ← headLength, List.drop_length, List.nil_append]
  refine ⟨headRecords ++ n, ?_⟩
  rw [run_append, take, drop, headRun]

private theorem replace_middle_exists (A P Q R : Program) (s : State)
    (m : List Bool)
    (middle : ∀ x y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s)) :
    ∃ n, run (A ++ P ++ R) m s = run (A ++ Q ++ R) n s := by
  let u := run A (m.take (measurementCount A)) s
  let pm := (m.drop (measurementCount A)).take (measurementCount P)
  let rm := m.drop (measurementCount A + measurementCount P)
  have loan : run (A ++ P ++ R) m s = run R rm (run P pm u) := by
    simp only [List.append_assoc, run_append, run_take, u, pm, rm]
    rw [List.drop_drop, Nat.add_comm]
  obtain ⟨nAQ, hAQ⟩ := join_records A Q s (m.take (measurementCount A)) []
  obtain ⟨nAll, hAll⟩ := join_records (A ++ Q) R s nAQ rm
  refine ⟨nAll, ?_⟩
  rw [loan, middle pm [], ← hAQ, ← hAll]

private theorem replace_middle_exists_one (A P Q R : Program) (s : State)
    (m : List Bool)
    (middle : ∀ x, ∃ y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s)) :
    ∃ n, run (A ++ P ++ R) m s = run (A ++ Q ++ R) n s := by
  let u := run A (m.take (measurementCount A)) s
  let pm := (m.drop (measurementCount A)).take (measurementCount P)
  let rm := m.drop (measurementCount A + measurementCount P)
  have loan : run (A ++ P ++ R) m s = run R rm (run P pm u) := by
    simp only [List.append_assoc, run_append, run_take, u, pm, rm]
    rw [List.drop_drop, Nat.add_comm]
  obtain ⟨qm, hqm⟩ := middle pm
  obtain ⟨nAQ, hAQ⟩ := join_records A Q s (m.take (measurementCount A)) qm
  obtain ⟨nAll, hAll⟩ := join_records (A ++ Q) R s nAQ rm
  refine ⟨nAll, ?_⟩
  rw [loan, hqm, ← hAQ, ← hAll]

private theorem foldLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (m : List Bool)
    (high : s.basis L760.rmsb = s.basis L760.lower)
    (clean : ∀ q ∈ L760.carry, s.basis q = false) :
    ∃ n, run (StairLoan.foldLoan d L760) m s =
      run (Q6LifetimeResearch.fold (base 760) L760) n s := by
  let A : Program :=
    [.CCX L760.parity L760.lower L760.one, .CX L760.lower L760.rmsb]
  let P := Q6LifetimeResearch.move (base 760) L760.rmsb
    (StairLoan.mappedAddLoan d StairLoan.retiredRoles
      (ShortBiasedFold.lowBits L760) L760.low
      (L760.carry.take 254) L760.one)
  let Q := Q6LifetimeResearch.move (base 760) L760.rmsb
    (mappedAdd (ShortBiasedFold.lowBits L760) L760.low
      (L760.carry.take 254) L760.one)
  let R : Program :=
    [.CX L760.lower L760.rmsb, .CX L760.parity L760.rmsb,
      .CX L760.parity L760.lower, .CX L760.rmsb L760.lower,
      .measureX L760.one [] [.Z L760.parity, .CZ L760.parity L760.rmsb]]
  let u := run A (m.take (measurementCount A)) s
  let e := Equiv.swap (base 760) L760.rmsb
  have oneAway : L760.one ∉ L760.carry := by decide +kernel
  have highAway : L760.rmsb ∉ L760.carry := by decide +kernel
  have retiredHigh : base 760 ≠ L760.rmsb := by decide +kernel
  have uHigh : u.basis L760.rmsb = false := by
    simp only [u, A, run, writeBit, Function.update_self]
    rw [Function.update_of_ne (show L760.rmsb ≠ L760.one by decide +kernel),
      Function.update_of_ne (show L760.lower ≠ L760.one by decide +kernel)]
    rw [high]
    cases s.basis L760.lower <;> rfl
  have uClean : ∀ q ∈ L760.carry, u.basis q = false := by
    intro q hq
    have qo : q ≠ L760.one := fun eq => oneAway (eq ▸ hq)
    have qh : q ≠ L760.rmsb := fun eq => highAway (eq ▸ hq)
    simp only [u, A, run, writeBit, Function.update_of_ne qo,
      Function.update_of_ne qh]
    exact clean q hq
  have pulledClean : ∀ q ∈ L760.carry.take 254,
      (pullState e u).basis q = false := by
    intro q hq
    change u.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = L760.rmsb from Equiv.swap_apply_left _ _]
      exact uHigh
    · have qh : q ≠ L760.rmsb := fun eq => highAway
        (eq ▸ List.mem_of_mem_take hq)
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qh]
      exact uClean q (List.mem_of_mem_take hq)
  have nd : (L760.one :: (L760.low ++ L760.carry.take 254)).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ (by decide +kernel)
  have sourceAway : ∀ q ∈ mappedWires (ShortBiasedFold.lowBits L760),
      q ∉ L760.one :: (L760.low ++ L760.carry.take 254) := by
    intro q hq
    rw [OneReuse.lowBits_source L760 q hq]
    decide +kernel
  have bitsLength : (ShortBiasedFold.lowBits L760).length = L760.low.length := by
    decide +kernel
  have carryLength : (L760.carry.take 254).length + 1 = L760.low.length := by
    decide +kernel
  have depth : d + 1 ≤ (L760.carry.take 254).length := by
    simp only [List.length_take]
    have width : L760.carry.length = 256 := by decide +kernel
    omega
  have roleTail := StairLoan.retiredRoles_tail254 d hd
  have middle : ∀ x y, run P x u = run Q y u := by
    intro x y
    apply StairLoan.renameProgram_run_eq_of e
    exact StairLoan.mappedAddLoan_run_eq d StairLoan.retiredRoles
      (ShortBiasedFold.lowBits L760) L760.low (L760.carry.take 254)
      L760.one (pullState e u) x y nd sourceAway bitsLength carryLength
      depth pulledClean roleTail
  have replaced := replace_middle_exists A P Q R s m middle
  simpa only [StairLoan.foldLoan, Q6LifetimeResearch.fold, A, P, Q, R,
    List.append_assoc] using replaced

private theorem unnormalizeLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (m : List Bool)
    (one : s.basis L760.one = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false)
    (high : s.basis L760.rmsb = false) :
    ∃ n, run (StairLoan.unnormalizeLoan d L760) m s =
      run (Q6LifetimeResearch.unnormalize (base 760) false L760) n s := by
  let e := Equiv.swap (base 760) L760.rmsb
  let t := pullState e s
  let A : Program := [.X L760.lower]
  let P := StairLoan.literalConstAddLoan d StairLoan.retiredRoles
    L760.low (L760.carry.take 254) L760.lower L760.one
    BalancedCleanup.positiveLiteral
  let Q := literalConstAdd L760.low (L760.carry.take 254)
    L760.lower L760.one BalancedCleanup.positiveLiteral
  let R : Program := [.X L760.lower]
  have oneAway : L760.one ≠ base 760 ∧ L760.one ≠ L760.rmsb := by
    decide +kernel
  have oneT : t.basis L760.one = false := by
    change s.basis (e L760.one) = false
    rw [show e L760.one = L760.one from
      Equiv.swap_apply_of_ne_of_ne oneAway.1 oneAway.2]
    exact one
  have highAway : L760.rmsb ∉ L760.carry := by decide +kernel
  have cleanT : ∀ q ∈ L760.carry.take 254, t.basis q = false := by
    intro q hq
    change s.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = L760.rmsb from Equiv.swap_apply_left _ _]
      exact high
    · have qh : q ≠ L760.rmsb := fun eq => highAway
        (eq ▸ List.mem_of_mem_take hq)
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qh]
      exact clean q (List.mem_of_mem_take hq)
  have nd : (L760.one :: L760.lower ::
      (L760.low ++ L760.carry.take 254)).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ (by decide +kernel)
  have carryLength : (L760.carry.take 254).length + 1 = L760.low.length := by
    decide +kernel
  have literalBound : BalancedCleanup.positiveLiteral < 2 ^ L760.low.length := by
    decide +kernel
  have depth : d + 1 ≤ (L760.carry.take 254).length := by
    have width : L760.carry.length = 256 := by decide +kernel
    simp only [List.length_take]
    omega
  have roleTail := StairLoan.retiredRoles_tail254 d hd
  have middle : ∀ x y,
      run P x (run A (m.take (measurementCount A)) t) =
        run Q y (run A (m.take (measurementCount A)) t) := by
    intro x y
    have oneU : (run A (m.take (measurementCount A)) t).basis L760.one =
        false := by
      simpa [A, run, writeBit, oneAway.2] using oneT
    have cleanU : ∀ q ∈ L760.carry.take 254,
        (run A (m.take (measurementCount A)) t).basis q = false := by
      intro q hq
      have away : q ≠ L760.lower := by
        intro eq
        subst q
        have : L760.lower ∉ L760.carry := by decide +kernel
        exact this (List.mem_of_mem_take hq)
      simpa [A, run, writeBit, away] using cleanT q hq
    exact StairLoan.literalConstAddLoan_run_eq d StairLoan.retiredRoles
      L760.low (L760.carry.take 254) L760.lower L760.one
      BalancedCleanup.positiveLiteral
      (run A (m.take (measurementCount A)) t) x y nd carryLength
      literalBound depth oneU cleanU roleTail
  obtain ⟨n, hn⟩ := replace_middle_exists A P Q R t m middle
  refine ⟨n, ?_⟩
  apply StairLoan.renameProgram_run_eq_of e
  simpa only [StairLoan.unnormalizeLoan, Q6LifetimeResearch.unnormalize,
    Bool.false_eq_true, if_false, BalancedCleanup.unnormalize,
    Q6LifetimeResearch.move, A, P, Q, R, List.append_assoc] using hn

private theorem majorityClear_ready (a b sign c parity topTarget topCopy : Wire)
    (tail : List Wire) (v : State)
    (four : [a, b, sign, c].Nodup)
    (cAway : c ∉ tail) (bAway : b ∉ tail)
    (parityC : parity ≠ c) (bC : b ≠ c) (aC : a ≠ c)
    (signC : sign ≠ c)
    (clearNe : parity ≠ b ∧ a ≠ b ∧ sign ≠ b)
    (topNe : topCopy ≠ c ∧ topTarget ≠ c ∧
      topCopy ≠ b ∧ topTarget ≠ b)
    (parityValue : v.basis parity =
      (v.basis b ^^ v.basis a ^^ v.basis sign))
    (top : v.basis topCopy = v.basis topTarget)
    (clean : ∀ q ∈ c :: tail, v.basis q = false) :
    let clear : Program := [.CX parity b, .CX a b, .CX sign b]
    let w := run (majority a b sign c) [] v
    let u := run clear [] w
    u.basis b = false ∧ u.basis topCopy = u.basis topTarget ∧
      (∀ q ∈ tail, u.basis q = false) := by
  let clear : Program := [.CX parity b, .CX a b, .CX sign b]
  let w := run (majority a b sign c) [] v
  let u := run clear [] w
  have firstEq : w = ⟨v.phase, writeBit v.basis c
      (carryBit (v.basis a) (v.basis b) (v.basis sign))⟩ := by
    rw [show w = run (majority a b sign c) [] v from rfl,
      majority_correct a b sign c four]
    simp only [clean c (by simp), Bool.false_xor]
  have keepW (q : Wire) (hq : q ≠ c) : w.basis q = v.basis q := by
    rw [firstEq]
    simp only [writeBit, Function.update_of_ne hq]
  have clearKeeps (q : Wire) (hq : q ≠ b) : u.basis q = w.basis q := by
    simp [u, clear, run, writeBit, hq]
  refine ⟨?_, ?_, ?_⟩
  · have rel : w.basis parity =
        (w.basis b ^^ w.basis a ^^ w.basis sign) := by
      simpa only [keepW parity parityC, keepW b bC,
        keepW a aC, keepW sign signC] using parityValue
    simp only [run, writeBit, Function.update_self,
      Function.update_of_ne clearNe.2.1,
      Function.update_of_ne clearNe.2.2]
    rw [rel]
    cases w.basis a <;> cases w.basis b <;> cases w.basis sign <;> rfl
  · rw [clearKeeps topCopy topNe.2.2.1,
      clearKeeps topTarget topNe.2.2.2,
      keepW topCopy topNe.1, keepW topTarget topNe.2.1, top]
  · intro q hq
    rw [clearKeeps q (fun eq => bAway (eq ▸ hq)),
      keepW q (fun eq => cAway (eq ▸ hq))]
    exact clean q (List.mem_cons_of_mem c hq)

private theorem rawSign_ready (s : State)
    (parityValue : s.basis L760.parity =
      (s.basis L760.r0 ^^ s.basis (L760.ylow.getD 0 0)))
    (top : s.basis L760.one = s.basis L760.rmsb)
    (lower : s.basis L760.lower = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false) :
    let carries := (Q6Structural.q6Carry L760).take 255
    let a := L760.ylow.getD 0 0
    let b := L760.r0
    let unused := L760.carry.getD 255 0
    let v := run (signComplement L760.sign L760.y) [] s
    v.basis L760.parity =
        (v.basis b ^^ v.basis a ^^ v.basis L760.sign) ∧
      v.basis L760.one = v.basis L760.rmsb ∧
      (∀ q ∈ carries ++ [unused], v.basis q = false) := by
  let carries := (Q6Structural.q6Carry L760).take 255
  let a := L760.ylow.getD 0 0
  let b := L760.r0
  let unused := L760.carry.getD 255 0
  let v := run (signComplement L760.sign L760.y) [] s
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  have hw := Q6EndpointCell.ports_widths base (base 2409)
  have cshape : carries = L760.carry.take 254 ++ [L760.lower] := by
    simp [carries, Q6Structural.q6Carry, List.take_append,
      List.length_take, hw.2.2]
  have yND : L760.y.Nodup := by
    have cleanupND : L760.toLayout.wires.Nodup :=
      (List.nodup_append'.mp hn).2.1
    exact (List.nodup_append'.mp
      (List.nodup_append'.mp (L760.toLayout.dataND cleanupND)).2.1).1
  have signAway : L760.sign ∉ L760.y := by
    exact fun used => BalancedCircuit.flagAway L760 hn L760.sign
      (by simp) (by simp [used])
  have view (q : Wire) : v.basis q =
      if q ∈ L760.y then s.basis q ^^ s.basis L760.sign else s.basis q :=
    GuardCompression.complement_bit L760.sign L760.y yND signAway s [] q
  have notY (q : Wire)
      (hq : q ∈ [L760.sign, L760.parity, L760.lower, L760.one] ++
        L760.r ++ L760.carry) : q ∉ L760.y := by
    have othersND : (([L760.sign, L760.parity, L760.lower, L760.one] ++
        L760.r ++ L760.carry) ++ L760.y).Nodup := by
      apply List.nodup_iff_count.mpr
      intro z
      have h := List.nodup_iff_count.mp (BalancedCircuit.allND L760 hn) z
      simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
      omega
    exact fun used => List.disjoint_left.mp
      (List.nodup_append'.mp othersND).2.2 hq used
  have keep (q : Wire)
      (hq : q ∈ [L760.sign, L760.parity, L760.lower, L760.one] ++
        L760.r ++ L760.carry) : v.basis q = s.basis q := by
    rw [view, if_neg (notY q hq)]
  have aIn : a ∈ L760.y := by
    decide +kernel
  have pv : v.basis L760.parity =
      (v.basis b ^^ v.basis a ^^ v.basis L760.sign) := by
    rw [keep L760.parity (by simp),
      keep b (by simp [b, BalancedCleanup.Layout.r,
        BalancedCleanup.Layout.low]),
      keep L760.sign (by simp), view a, if_pos aIn, parityValue]
    cases s.basis L760.r0 <;> cases s.basis a <;>
      cases s.basis L760.sign <;> rfl
  have topV : v.basis L760.one = v.basis L760.rmsb := by
    rw [keep L760.one (by simp),
      keep L760.rmsb (by simp [BalancedCleanup.Layout.r]), top]
  have unusedIn : unused ∈ L760.carry := by decide +kernel
  have carryView : ∀ q ∈ carries ++ [unused], v.basis q = false := by
    intro q hq
    have choice : q ∈ L760.carry ∨ q = L760.lower := by
      rw [cshape] at hq
      simp only [List.mem_append, List.mem_singleton] at hq
      rcases hq with (front | low) | last
      · exact Or.inl (List.mem_of_mem_take front)
      · exact Or.inr low
      · exact Or.inl (last ▸ unusedIn)
    rcases choice with used | eq
    · exact (keep q (by simp [used])).trans (clean q used)
    · subst q
      exact (keep L760.lower (by simp)).trans lower
  exact ⟨pv, topV, carryView⟩

private theorem rawMajority_geometry :
    let carries := (Q6Structural.q6Carry L760).take 255
    let a := L760.ylow.getD 0 0
    let b := L760.r0
    let c := carries.getD 0 0
    let cs := carries.drop 1
    let unused := L760.carry.getD 255 0
    [a, b, L760.sign, c].Nodup ∧ c ∉ cs ++ [unused] ∧
      b ∉ cs ++ [unused] ∧ L760.parity ≠ c ∧ b ≠ c ∧ a ≠ c ∧
      L760.sign ≠ c ∧
      (L760.parity ≠ b ∧ a ≠ b ∧ L760.sign ≠ b) ∧
      (L760.one ≠ c ∧ L760.rmsb ≠ c ∧
        L760.one ≠ b ∧ L760.rmsb ≠ b) ∧
      carries = c :: cs := by
  decide +kernel

private theorem rawMajority_ready (v : State)
    (pv : v.basis L760.parity =
      (v.basis L760.r0 ^^ v.basis (L760.ylow.getD 0 0) ^^
        v.basis L760.sign))
    (topV : v.basis L760.one = v.basis L760.rmsb)
    (carryView : ∀ q ∈ (Q6Structural.q6Carry L760).take 255 ++
      [L760.carry.getD 255 0], v.basis q = false) :
    let carries := (Q6Structural.q6Carry L760).take 255
    let a := L760.ylow.getD 0 0
    let b := L760.r0
    let c := carries.getD 0 0
    let cs := carries.drop 1
    let unused := L760.carry.getD 255 0
    let clear : Program :=
      [.CX L760.parity b, .CX a b, .CX L760.sign b]
    let w := run (majority a b L760.sign c) [] v
    let u := run clear [] w
    u.basis b = false ∧ u.basis L760.one = u.basis L760.rmsb ∧
      (∀ q ∈ cs ++ [unused], u.basis q = false) := by
  let carries := (Q6Structural.q6Carry L760).take 255
  let a := L760.ylow.getD 0 0
  let b := L760.r0
  let c := carries.getD 0 0
  let cs := carries.drop 1
  let unused := L760.carry.getD 255 0
  let clear : Program :=
    [.CX L760.parity b, .CX a b, .CX L760.sign b]
  let w := run (majority a b L760.sign c) [] v
  let u := run clear [] w
  rcases rawMajority_geometry with
    ⟨four, cAway, bAway, parityC, bC, aC, signC, clearNe, topNe,
      csplit⟩
  change carries = c :: cs at csplit
  have cleanHead : ∀ q ∈ c :: (cs ++ [unused]), v.basis q = false := by
    intro q hq
    apply carryView q
    change q ∈ carries ++ [unused]
    rw [csplit]
    simpa only [List.cons_append] using hq
  exact majorityClear_ready a b L760.sign c L760.parity L760.rmsb
    L760.one (cs ++ [unused]) v four cAway bAway parityC bC aC signC
    clearNe topNe pv topV cleanHead

private theorem rawTail_geometry :
    let carries := (Q6Structural.q6Carry L760).take 255
    let b := L760.r0
    let c := carries.getD 0 0
    let xs := L760.ylow.drop 1
    let ys := L760.rtail
    let cs := carries.drop 1
    let unused := L760.carry.getD 255 0
    xs.length = 254 ∧ ys.length = 254 ∧ cs.length = 254 ∧
      L760.one ≠ base 760 ∧ L760.one ≠ b ∧
      L760.rmsb ≠ base 760 ∧ L760.rmsb ≠ b ∧
      b ∉ cs ++ [unused] ∧
      (xs ++ [L760.ymsb] ++ ys ++ [L760.rmsb, L760.one] ++
        cs ++ [unused, c]).Nodup := by
  -- LT44 (replay budget): the big `Nodup` by a linear bit-mask scan (was 42 s by `decide`)
  intro carries b c xs ys cs unused
  have nd : (L760.ylow.drop 1 ++ [L760.ymsb] ++ L760.rtail ++ [L760.rmsb, L760.one] ++
      ((Q6Structural.q6Carry L760).take 255).drop 1 ++
      [L760.carry.getD 255 0, ((Q6Structural.q6Carry L760).take 255).getD 0 0]).Nodup :=
    ECDSAAdd.Entrant.StairLoan.nodup_of_mask _ (by decide +kernel)
  have rest : (L760.ylow.drop 1).length = 254 ∧ L760.rtail.length = 254 ∧
      (((Q6Structural.q6Carry L760).take 255).drop 1).length = 254 ∧
      L760.one ≠ base 760 ∧ L760.one ≠ L760.r0 ∧
      L760.rmsb ≠ base 760 ∧ L760.rmsb ≠ L760.r0 ∧
      L760.r0 ∉ ((Q6Structural.q6Carry L760).take 255).drop 1 ++ [L760.carry.getD 255 0] := by
    decide +kernel
  exact ⟨rest.1, rest.2.1, rest.2.2.1, rest.2.2.2.1, rest.2.2.2.2.1, rest.2.2.2.2.2.1,
    rest.2.2.2.2.2.2.1, rest.2.2.2.2.2.2.2, nd⟩

private theorem rawPulled_ready (u : State)
    (ready :
      let carries := (Q6Structural.q6Carry L760).take 255
      let b := L760.r0
      let cs := carries.drop 1
      let unused := L760.carry.getD 255 0
      u.basis b = false ∧ u.basis L760.one = u.basis L760.rmsb ∧
        (∀ q ∈ cs ++ [unused], u.basis q = false)) :
    let carries := (Q6Structural.q6Carry L760).take 255
    let b := L760.r0
    let cs := carries.drop 1
    let unused := L760.carry.getD 255 0
    let e := Equiv.swap (base 760) b
    (pullState e u).basis L760.one = (pullState e u).basis L760.rmsb ∧
      (∀ q ∈ cs ++ [unused], (pullState e u).basis q = false) := by
  let carries := (Q6Structural.q6Carry L760).take 255
  let b := L760.r0
  let cs := carries.drop 1
  let unused := L760.carry.getD 255 0
  let e := Equiv.swap (base 760) b
  rcases rawTail_geometry with
    ⟨_, _, _, oneBase, oneB, highBase, highB, bAwayTail, _⟩
  change b ∉ cs ++ [unused] at bAwayTail
  constructor
  · change u.basis (e L760.one) = u.basis (e L760.rmsb)
    rw [show e L760.one = L760.one from Equiv.swap_apply_of_ne_of_ne
      oneBase oneB,
      show e L760.rmsb = L760.rmsb from Equiv.swap_apply_of_ne_of_ne
      highBase highB]
    exact ready.2.1
  · intro q hq
    change u.basis (e q) = false
    by_cases qr : q = base 760
    · subst q
      rw [show e (base 760) = b from Equiv.swap_apply_left _ _]
      exact ready.1
    · have qb : q ≠ b := fun eq => bAwayTail (eq ▸ hq)
      rw [show e q = q from Equiv.swap_apply_of_ne_of_ne qr qb]
      exact ready.2.2 q hq

private theorem rawTail_middle (d : Nat) (hd : d ≤ 68)
    (s : State) (m : List Bool)
    (ready :
      let carries := (Q6Structural.q6Carry L760).take 255
      let a := L760.ylow.getD 0 0
      let b := L760.r0
      let c := carries.getD 0 0
      let cs := carries.drop 1
      let unused := L760.carry.getD 255 0
      let S := signComplement L760.sign L760.y
      let clear : Program :=
        [.CX L760.parity b, .CX a b, .CX L760.sign b]
      let v := run S [] s
      let w := run (majority a b L760.sign c) [] v
      let u := run clear [] w
      u.basis b = false ∧ u.basis L760.one = u.basis L760.rmsb ∧
        (∀ q ∈ cs ++ [unused], u.basis q = false)) :
    let carries := (Q6Structural.q6Carry L760).take 255
    let a := L760.ylow.getD 0 0
    let b := L760.r0
    let c := carries.getD 0 0
    let xs := L760.ylow.drop 1
    let ys := L760.rtail
    let cs := carries.drop 1
    let S := signComplement L760.sign L760.y
    let clear : Program :=
      [.CX L760.parity b, .CX a b, .CX L760.sign b]
    let A := S ++ majority a b L760.sign c ++ clear
    let P := Q6LifetimeResearch.move (base 760) b
      (StairLoan.addPrefixLoan d StairLoan.retiredRoles xs ys cs
        L760.ymsb L760.rmsb L760.one c)
    let Q := Q6LifetimeResearch.move (base 760) b
      (CoherentTail.addPrefix xs ys cs L760.ymsb L760.rmsb L760.one c)
    ∀ x y, run P x (run A (m.take (measurementCount A)) s) =
      run Q y (run A (m.take (measurementCount A)) s) := by
  let carries := (Q6Structural.q6Carry L760).take 255
  let a := L760.ylow.getD 0 0
  let b := L760.r0
  let c := carries.getD 0 0
  let xs := L760.ylow.drop 1
  let ys := L760.rtail
  let cs := carries.drop 1
  let unused := L760.carry.getD 255 0
  let S := signComplement L760.sign L760.y
  let clear : Program :=
    [.CX L760.parity b, .CX a b, .CX L760.sign b]
  let A := S ++ majority a b L760.sign c ++ clear
  let P := Q6LifetimeResearch.move (base 760) b
    (StairLoan.addPrefixLoan d StairLoan.retiredRoles xs ys cs
      L760.ymsb L760.rmsb L760.one c)
  let Q := Q6LifetimeResearch.move (base 760) b
    (CoherentTail.addPrefix xs ys cs L760.ymsb L760.rmsb L760.one c)
  let v := run S [] s
  let w := run (majority a b L760.sign c) [] v
  let u := run clear [] w
  let e := Equiv.swap (base 760) b
  rcases rawTail_geometry with
    ⟨xsLength, ysLength, csLength, _, _, _, _, _, nd⟩
  change xs.length = 254 at xsLength
  change ys.length = 254 at ysLength
  change cs.length = 254 at csLength
  change (xs ++ [L760.ymsb] ++ ys ++ [L760.rmsb, L760.one] ++
    cs ++ [unused, c]).Nodup at nd
  have executeA : run A (m.take (measurementCount A)) s = u := by
    simp only [A, List.append_assoc, run_append, run_take]
    have sZero : measurementCount S = 0 := (signComplement_counts _ _).2
    have majZero : measurementCount (majority a b L760.sign c) = 0 := rfl
    have clearZero : measurementCount clear = 0 := rfl
    simp only [sZero, majZero, List.drop_zero]
    rw [FifthCarry.no_records S sZero s _ [],
      FifthCarry.no_records (majority a b L760.sign c) majZero v _ [],
      FifthCarry.no_records clear clearZero w _ []]
  have pulled := rawPulled_ready u ready
  have hy : ys.length = xs.length := ysLength.trans xsLength.symm
  have hc : cs.length = xs.length := csLength.trans xsLength.symm
  have depth : d + 1 ≤ cs.length := by omega
  have roleTail := StairLoan.retiredRoles_q6Tail d hd
  change ∀ x y, run P x (run A (m.take (measurementCount A)) s) =
    run Q y (run A (m.take (measurementCount A)) s)
  intro x y
  rw [executeA]
  apply StairLoan.renameProgram_run_eq_of e
  exact StairLoan.addPrefixLoan_run_eq d StairLoan.retiredRoles xs ys cs
    L760.ymsb L760.rmsb L760.one unused c (pullState e u) x y
    hy hc depth nd pulled.1 pulled.2 roleTail

private theorem rawAddLoan_exists (d : Nat) (hd : d ≤ 68)
    (s : State) (m : List Bool)
    (parityValue : s.basis L760.parity =
      (s.basis L760.r0 ^^ s.basis (L760.ylow.getD 0 0)))
    (top : s.basis L760.one = s.basis L760.rmsb)
    (lower : s.basis L760.lower = false)
    (clean : ∀ q ∈ L760.carry, s.basis q = false) :
    ∃ n, run (StairLoan.rawAddLoan d L760) m s =
      run (Q6LifetimeResearch.rawAdd (base 760) L760) n s := by
  let carries := (Q6Structural.q6Carry L760).take 255
  let a := L760.ylow.getD 0 0
  let b := L760.r0
  let c := carries.getD 0 0
  let xs := L760.ylow.drop 1
  let ys := L760.rtail
  let cs := carries.drop 1
  let unused := L760.carry.getD 255 0
  let S := signComplement L760.sign L760.y
  let clear : Program :=
    [.CX L760.parity b, .CX a b, .CX L760.sign b]
  let A := S ++ majority a b L760.sign c ++ clear
  let P := Q6LifetimeResearch.move (base 760) b
    (StairLoan.addPrefixLoan d StairLoan.retiredRoles xs ys cs
      L760.ymsb L760.rmsb L760.one c)
  let Q := Q6LifetimeResearch.move (base 760) b
    (CoherentTail.addPrefix xs ys cs L760.ymsb L760.rmsb L760.one c)
  let R := clear.reverse ++ eraseCarry a b L760.sign c ++
    [.CX a b, .CX L760.sign b] ++ S
  let v := run S [] s
  let w := run (majority a b L760.sign c) [] v
  let u := run clear [] w
  have signReady := rawSign_ready s parityValue top lower clean
  have ready : u.basis b = false ∧
      u.basis L760.one = u.basis L760.rmsb ∧
      (∀ q ∈ cs ++ [unused], u.basis q = false) :=
    rawMajority_ready v signReady.1 signReady.2.1 signReady.2.2
  have middle : ∀ x y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s) :=
    rawTail_middle d hd s m ready
  have replaced := replace_middle_exists A P Q R s m middle
  simpa only [StairLoan.rawAddLoan, Q6LifetimeResearch.rawAdd,
    Q6LifetimeResearch.move, A, P, Q, R, S, clear, carries, a, b, c,
    xs, ys, cs, List.append_assoc] using replaced

/-! ## Comparison block with a positive-depth loan, generic in the layout.

The proof follows the record's `Q6LifetimeResearch.compare_eq_plain` window proof
(`borrowed_tail_eq`, `head_window_eq`, `comparator_window_eq`), with the only
semantic change at the borrowed tail: the loaned comparison chain is first
replayed to the plain chain by `lift_compareLoan_run_eq`. -/

private theorem cmp_append_run (P Q : Program) (m : List Bool) (s : State) :
    run (P++Q) m s=run Q (m.drop (measurementCount P)) (run P m s) := by
  rw [run_append,run_take]

private theorem cmp_triple_run (P Q R : Program) (m : List Bool) (s : State) :
    run (P++Q++R) m s=run R (m.drop (measurementCount P+measurementCount Q))
      (run Q (m.drop (measurementCount P)) (run P m s)) := by
  rw [cmp_append_run,cmp_append_run,measurementCount_append]

private theorem cmp_zero_tapes (P : Program) (zero : measurementCount P=0)
    (s : State) (m n : List Bool) : run P m s=run P n s := by
  have a : run P m s=run P [] s := by
    simpa only [zero,List.take_zero] using (run_take P m s).symm
  have b : run P [] s=run P n s := by
    simpa only [zero,List.take_zero] using run_take P n s
  exact a.trans b

private theorem cmp_x_run (q : Wire) (m : List Bool) (s : State) :
    run [.X q] m s=run [.X q] [] s := by simp only [run]

private theorem cmp_x_basis (q w : Wire) (ne : w≠q) (s : State) :
    (run [.X q] [] s).basis w=s.basis w := by
  simp [run,writeBit,Function.update_of_ne ne]

private theorem cmp_x_sandwich (q : Wire) (P : Program) (m : List Bool) (s : State) :
    run ([.X q]++P++[.X q]) m s=
      run [.X q] [] (run P m (run [.X q] [] s)) := by
  rw [cmp_triple_run]
  simp only [show measurementCount [.X q]=0 from rfl,Nat.zero_add,List.drop_zero,cmp_x_run]

private theorem cmp_pure_wrap (pre P Q : Program) (zero : measurementCount pre=0)
    (s : State) (m n : List Bool)
    (middle : run P m (run pre [] s)=run Q n (run pre [] s)) :
    run (pre++P++pre) m s=run (pre++Q++pre) n s := by
  rw [cmp_triple_run,cmp_triple_run]
  simp only [zero,Nat.zero_add,List.drop_zero]
  rw [cmp_zero_tapes pre zero s m [],cmp_zero_tapes pre zero s n [],middle]
  exact cmp_zero_tapes pre zero _ _ _

private theorem cmp_chain_ignores_last (forward : Bool) (x y cs : List Wire)
    (cin target last : Wire) (hx : x.length=y.length) (hc : cs.length+1=y.length)
    (nonempty : y≠[]) :
    Q6LifetimeResearch.compareChain forward x y (cs++[last]) cin target=
      Q6LifetimeResearch.compareChain forward x y cs cin target := by
  induction y generalizing x cs cin with
  | nil => exact (nonempty rfl).elim
  | cons b ys ih =>
    cases x with
    | nil => simp at hx
    | cons a xs =>
      have hx' : xs.length=ys.length := Nat.succ.inj hx
      cases ys with
      | nil =>
        have xe : xs=[] := List.eq_nil_of_length_eq_zero hx'
        subst xs
        simp only [Q6LifetimeResearch.compareChain]
      | cons b' ys =>
        cases xs with
        | nil => simp at hx'
        | cons a' xs =>
          cases cs with
          | nil => simp at hc
          | cons c cs =>
            have hc' : cs.length+1=(b'::ys).length := Nat.succ.inj hc
            have child := ih (a'::xs) cs c hx' hc' (by simp)
            simp only [Q6LifetimeResearch.compareChain,List.cons_append,child]

/-- Loan version of the record's `borrowed_tail_eq`. -/
private theorem loan_borrowed_tail_eq (d : Nat) (roles : List Wire) (forward : Bool)
    (retired host cin target last : Wire)
    (x y cs : List Wire) (nd : (host::target::cin::(x++y++(cs++[last]))).Nodup)
    (hx : x.length=y.length) (hc : (cs++[last]).length=y.length) (nonempty : y≠[])
    (hd : d+1≤cs.length) (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1))
    (member : retired∈cs) (s : State) (m n : List Bool) (hostOne : s.basis host=true)
    (clean : ∀q∈cs++[last],s.basis q=false)
    (post : forward=true →
      (run (Arithmetic.compareChain none x y (cs++[last]) cin target) n s).basis target=false) :
    run ([.X host]++Q6LifetimeResearch.move retired host
        (compareLoan d roles forward x y cs cin target)++[.X host]) m s=
      run (Arithmetic.compareChain none x y (cs++[last]) cin target) n s := by
  let Q := Arithmetic.compareChain none x y (cs++[last]) cin target
  let P := compareLoan d roles forward x y cs cin target
  let v := run [.X host] [] s
  have hostAway := (List.nodup_cons.mp nd).1
  have tailND := (List.nodup_cons.mp nd).2
  have targetAway := (List.nodup_cons.mp tailND).1
  have ht : host≠target := fun e => hostAway (by simp [e])
  have rt : retired≠target := fun e => targetAway (by
    have mem : target∈cs := e ▸ member
    simp only [List.mem_cons,List.mem_append]
    tauto)
  have memberFull : retired∈cs++[last] := List.mem_append_left _ member
  have carryAway (q : Wire) (hq : q∈cs++[last]) : q≠host := by
    intro e
    apply hostAway
    simp only [List.mem_cons,List.mem_append] at hq ⊢
    rw [←e]
    tauto
  have vHost : v.basis host=false := by simp [v,run,writeBit,hostOne]
  have vClean (q : Wire) (hq : q∈cs++[last]) : v.basis q=false :=
    (cmp_x_basis host q (carryAway q hq) s).trans (clean q hq)
  have free : host∉wires Q := by
    rw [show Q=Arithmetic.compareChain none x y (cs++[last]) cin target from rfl,
      compareChain_wires none x y (cs++[last]) cin target hx hc]
    simpa only [Option.toList_none,List.nil_append,List.mem_toFinset] using hostAway
  have commute : run Q n v=run [.X host] [] (run Q n s) :=
    CarryBorrow.x_commute_free host Q free s n
  have vPost (h : forward=true) : (run Q n v).basis target=false :=
    ((congrArg (fun t : State => t.basis target) commute).trans
      (cmp_x_basis host target (Ne.symm ht) (run Q n s))).trans (post h)
  have facts := compareChain_correct none x y (cs++[last]) cin target tailND (by simp)
    hx hc v n vClean
  have hc1 : cs.length+1=y.length := by
    simpa only [List.length_append,List.length_singleton] using hc
  have loan : run P m v=
      run (Q6LifetimeResearch.compareChain forward x y cs cin target) n v :=
    lift_compareLoan_run_eq d roles forward x y cs cin last target v m n
      hx hc1 hd tailND vClean roleTail vPost
  have same : run P m v=run Q n v := by
    rw [loan,←cmp_chain_ignores_last forward x y cs cin target last hx hc1 nonempty]
    exact Q6LifetimeProof.compare_chain_eq_old forward x y (cs++[last]) cin target
      tailND hx hc nonempty v n n vClean vPost
  have retiredOut : (run P m v).basis retired=false := by
    rw [same]
    exact (facts.2.1 retired rt).trans (vClean retired memberFull)
  have hostOut : (run P m v).basis host=false := by
    rw [same]
    exact (facts.2.1 host ht).trans vHost
  have rebound := FieldFrameOB5.rebind_swap_run retired host P v m
    (vClean retired memberFull) vHost retiredOut hostOut
  rw [cmp_x_sandwich]
  change run [.X host] [] (run (renameProgram (Equiv.swap retired host) P) m v)=run Q n s
  rw [rebound,same,commute]
  exact properGate_involution (.X host) (by trivial) (run Q n s) [] []

/-- Loan version of the record's `head_window_eq`. -/
private theorem loan_head_window_eq (d : Nat) (roles : List Wire) (forward : Bool)
    (retired a b c host target last : Wire)
    (x y cs : List Wire)
    (nd : (target::host::((a::x)++(b::y)++(c::(cs++[last])))).Nodup)
    (hx : x.length=y.length) (hc : (cs++[last]).length=y.length) (nonempty : y≠[])
    (hd : d+1≤cs.length) (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1))
    (member : retired∈cs) (s : State) (m n : List Bool) (hostOne : s.basis host=true)
    (clean : ∀q∈c::(cs++[last]),s.basis q=false)
    (post : forward=true →
      (run (Arithmetic.compareChain none (a::x) (b::y) (c::(cs++[last])) host target)
        n s).basis target=false) :
    run (majority a b host c++
      ([.X host]++Q6LifetimeResearch.move retired host
        (compareLoan d roles forward x y cs c target)++[.X host])++
      eraseCarry a b host c) m s=
      run (Arithmetic.compareChain none (a::x) (b::y) (c::(cs++[last])) host target) n s := by
  have counts := List.nodup_iff_count.mp nd
  have four : [a,b,host,c].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := counts q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have tailND : (host::target::c::(x++y++(cs++[last]))).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := counts q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have carryND : (c::(cs++[last])).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := counts q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have cAway := (List.nodup_cons.mp carryND).1
  have fourNe := four
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at fourNe
  have ac : a≠c := by tauto
  have bc : b≠c := by tauto
  have hcNe : host≠c := by tauto
  have targetAway := (List.nodup_cons.mp nd).1
  have aTarget : a≠target := fun e => targetAway (by simp [e])
  have bt : b≠target := fun e => targetAway (by simp [e])
  have ht : host≠target := fun e => targetAway (by simp [e])
  have ct : c≠target := fun e => targetAway (by simp [e])
  let u : State := ⟨s.phase,writeBit s.basis c
    (carryBit (s.basis a) (s.basis b) (s.basis host))⟩
  have head (records : List Bool) : run (majority a b host c) records s=u := by
    rw [majority_correct a b host c four]
    simp only [clean c (by simp),Bool.false_xor]
    rfl
  have keep (q : Wire) (ne : q≠c) : u.basis q=s.basis q := by
    simp [u,writeBit,Function.update_of_ne ne]
  have tailClean (q : Wire) (hq : q∈cs++[last]) : u.basis q=false :=
    (keep q (fun e => cAway (e ▸ hq))).trans (clean q (List.mem_cons_of_mem _ hq))
  let t := run (Arithmetic.compareChain none x y (cs++[last]) c target) n u
  have old := compareChain_correct none x y (cs++[last]) c target
    (List.nodup_cons.mp tailND).2 (by simp) hx hc u n tailClean
  have erase (records : List Bool) : run (eraseCarry a b host c) records t=
      ⟨t.phase,writeBit t.basis c false⟩ := by
    apply eraseCarry_correct a b host c ac bc hcNe t
    rw [old.2.1 a aTarget,old.2.1 b bt,old.2.1 host ht,old.2.1 c ct,
      keep a ac,keep b bc,keep host hcNe]
    simp [u,writeBit]
  have oldRun : run (Arithmetic.compareChain none (a::x) (b::y) (c::(cs++[last])) host target)
      n s=⟨t.phase,writeBit t.basis c false⟩ := by
    rw [Arithmetic.compareChain,cmp_triple_run]
    simp only [show measurementCount (majority a b host c)=0 from rfl,
      Nat.zero_add,List.drop_zero,head]
    exact erase _
  have tailPost (h : forward=true) : t.basis target=false := by
    have zero := post h
    rw [oldRun] at zero
    simpa only [writeBit,Function.update_of_ne (Ne.symm ct)] using zero
  have window := loan_borrowed_tail_eq d roles forward retired host c target last x y cs
    tailND hx hc nonempty hd roleTail member u m n ((keep host hcNe).trans hostOne)
    tailClean tailPost
  rw [cmp_triple_run]
  simp only [show measurementCount (majority a b host c)=0 from rfl,
    Nat.zero_add,List.drop_zero,head]
  rw [window,oldRun]
  exact erase _

/-- Loan version of the record's `comparator_window_eq`. -/
private theorem loan_comparator_window_eq (d : Nat) (roles : List Wire) (forward : Bool)
    (retired a b c host target last : Wire)
    (x y cs : List Wire)
    (nd : (target::host::((a::x)++(b::y)++(c::(cs++[last])))).Nodup)
    (hx : x.length=y.length) (hc : (cs++[last]).length=y.length) (nonempty : y≠[])
    (hd : d+1≤cs.length) (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1))
    (member : retired∈cs) (s : State) (m n : List Bool) (hostZero : s.basis host=false)
    (clean : ∀q∈c::(cs++[last]),s.basis q=false)
    (flag : forward=true →
      s.basis target=decide (regValue (a::x) s.basis<regValue (b::y) s.basis)) :
    run (notRegister (host::b::y)++majority a b host c++[.X host]++
      Q6LifetimeResearch.move retired host
        (compareLoan d roles forward x y cs c target)++[.X host]++
      eraseCarry a b host c++notRegister (host::b::y)) m s=
      run (compareLt none (a::x) (b::y) (c::(cs++[last])) host target) n s := by
  let pre := notRegister (host::b::y)
  let Q := Arithmetic.compareChain none (a::x) (b::y) (c::(cs++[last])) host target
  let P := majority a b host c++
    ([.X host]++Q6LifetimeResearch.move retired host
      (compareLoan d roles forward x y cs c target)++[.X host])++
    eraseCarry a b host c
  let v := run pre [] s
  have counts := List.nodup_iff_count.mp nd
  have preCarryND : ((host::b::y)++(c::(cs++[last]))).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := counts q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have preND := (List.nodup_append'.mp preCarryND).1
  have apart := (List.nodup_append'.mp preCarryND).2.2
  have invert := notRegister_correct (host::b::y) preND s []
  have hostOne : v.basis host=true := by
    change (run (notRegister (host::b::y)) [] s).basis host=true
    rw [invert]
    change (if host∈host::b::y then !s.basis host else s.basis host)=true
    rw [if_pos (by simp),hostZero]
    rfl
  have vClean (q : Wire) (hq : q∈c::(cs++[last])) : v.basis q=false := by
    have away : q∉host::b::y := fun h => List.disjoint_left.mp apart h hq
    change (run (notRegister (host::b::y)) [] s).basis q=false
    rw [invert]
    change (if q∈host::b::y then !s.basis q else s.basis q)=false
    rw [if_neg away]
    exact clean q hq
  have preZero : measurementCount pre=0 := (notRegister_counts _).2
  have targetAway := (List.nodup_cons.mp nd).1
  have free : target∉wires pre := by
    rw [show pre=notRegister (host::b::y) from rfl,notRegister_wires]
    intro used
    have mem := List.mem_toFinset.mp used
    apply targetAway
    simp only [List.mem_cons,List.mem_append] at mem ⊢
    tauto
  have oldRun : run (compareLt none (a::x) (b::y) (c::(cs++[last])) host target) n s=
      run pre [] (run Q n v) := by
    rw [compareLt,cmp_triple_run]
    change run pre (n.drop (measurementCount pre+measurementCount Q))
      (run Q (n.drop (measurementCount pre)) (run pre n s))=run pre [] (run Q n v)
    rw [preZero,List.drop_zero,cmp_zero_tapes pre preZero s n []]
    exact cmp_zero_tapes pre preZero _ _ []
  have facts := compareLt_correct none (a::x) (b::y) (c::(cs++[last])) host target
    nd (by simp) (by simp only [List.length_cons,hx])
    (by simp only [List.length_cons,hc]) s n hostZero clean
  have post (h : forward=true) : (run Q n v).basis target=false := by
    have zero : (run (compareLt none (a::x) (b::y) (c::(cs++[last])) host target) n s).basis
        target=false := by
      rw [facts.2.2,flag h]
      simp only [controlValue,Bool.true_and,Bool.xor_self]
    rw [oldRun] at zero
    exact (run_preserves_outside pre [] (run Q n v) target free).symm.trans zero
  have middle : run P m v=run Q n v :=
    loan_head_window_eq d roles forward retired a b c host target last x y cs nd hx hc
      nonempty hd roleTail member v m n hostOne vClean post
  have result := cmp_pure_wrap pre P Q preZero s m n middle
  simpa only [pre,P,Q,compareLt,List.append_assoc] using result

private theorem cmp_q6_comparator_nodup (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    (L.parity::L.one::(L.y++L.r++Q6Structural.q6Carry L)).Nodup := by
  have sub : List.Sublist (L.carry.take 254++L.carry.drop 255) L.carry := by
    have h := (List.Sublist.refl (L.carry.take 254)).append
      (List.drop_sublist_drop_left L.carry (show 254≤255 from by omega))
    simpa only [List.take_append_drop] using h
  apply List.nodup_iff_count.mpr
  intro q
  have whole := List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
  have bound := sub.count_le q
  simp only [Q6Structural.q6Carry,List.count_cons,List.count_append,List.count_nil] at whole bound ⊢
  omega

private theorem cmp_q6_clean (L : BalancedCircuit.Layout) (s : State)
    (hc : ∀q∈L.carry,s.basis q=false) (lower0 : s.basis L.lower=false) :
    ∀q∈Q6Structural.q6Carry L,s.basis q=false := by
  intro q h
  simp only [Q6Structural.q6Carry,List.mem_append,List.mem_singleton] at h
  rcases h with (h|rfl)|h
  · exact hc q (List.mem_of_mem_take h)
  · exact lower0
  · exact hc q (List.mem_of_mem_drop h)

private theorem cmp_head_drop (xs : List Wire) (ne : xs≠[]) :
    xs=xs.getD 0 0::xs.drop 1 := by
  cases xs with
  | nil => exact (ne rfl).elim
  | cons a xs => rfl

private theorem cmp_q6_spine_front (L : BalancedCircuit.Layout) (hw : L.Widths) :
    (Q6Structural.q6Carry L).take 255=L.carry.take 254++[L.lower] := by
  have front : (L.carry.take 254).length=254 := by
    simp only [List.length_take,hw.2.2]
    omega
  have prefixLen : (L.carry.take 254++[L.lower]).length=255 := by
    simp only [List.length_append,List.length_singleton,front]
  unfold Q6Structural.q6Carry
  rw [List.take_append_of_le_length (by omega),List.take_of_length_le (by omega)]

private theorem cmp_q6_spine_member (retired : Wire) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (member : retired∈(L.carry.take 254).drop 1) :
    retired∈((Q6Structural.q6Carry L).take 255).drop 1 := by
  have front : (L.carry.take 254).length=254 := by
    simp only [List.length_take,hw.2.2]
    omega
  rw [cmp_q6_spine_front L hw,List.drop_append,front]
  change retired∈(L.carry.take 254).drop 1++[L.lower]
  exact List.mem_append_left _ member

private theorem cmp_q6_geometry (L : BalancedCircuit.Layout) (hw : L.Widths) :
    (Q6Structural.q6Carry L).length=256 ∧
    ((Q6Structural.q6Carry L).take 255).length=255 ∧
    Q6Structural.q6Carry L=(Q6Structural.q6Carry L).take 255++
      [(Q6Structural.q6Carry L).getD 255 0] := by
  have widths := Q6StructuralCell.carry_widths L hw
  have full : (Q6Structural.q6Carry L).length=256 := widths.2.2
  have spine : ((Q6Structural.q6Carry L).take 255).length=255 := by
    simp only [List.length_take,full]
    omega
  exact ⟨full,spine,CarryBorrow.carry_split (Q6Structural.carryLayout L) widths⟩

/-- Loan version of the record's `Q6LifetimeResearch.compare_eq_plain`: the
    positive-depth loaned comparison block equals the plain comparator, for either
    direction, on the record's comparator preconditions. -/
theorem compareBlockLoan_eq_plain (d : Nat) (forward : Bool) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup)
    (member : base 760∈(L.carry.take 254).drop 1) (hd : d+1≤254)
    (roleTail : ∀q∈retiredRoles.take d,
      q∈(((Q6Structural.q6Carry L).take 255).drop 1).drop (d+1))
    (s : State) (m n : List Bool)
    (ho : s.basis L.one=false) (hc : ∀q∈L.carry,s.basis q=false)
    (lower0 : s.basis L.lower=false)
    (flag : forward=true →
      s.basis L.parity=decide (regValue L.y s.basis<regValue L.r s.basis)) :
    run (compareBlockLoan d forward L) m s=
      run (compareLt none L.y L.r (Q6Structural.q6Carry L) L.one L.parity) n s := by
  let spine := (Q6Structural.q6Carry L).take 255
  let last := (Q6Structural.q6Carry L).getD 255 0
  let a := L.y.getD 0 0
  let b := L.r.getD 0 0
  let c := spine.getD 0 0
  let x := L.y.drop 1
  let y := L.r.drop 1
  let cs := spine.drop 1
  have widths := BalancedCleanup.widths L.toLayout hw
  have yn : L.y.length=256 := widths.2.2.1
  have rn : L.r.length=256 := widths.2.1
  have geom := cmp_q6_geometry L hw
  have spineLen : spine.length=255 := geom.2.1
  have yne : L.y≠[] := by intro e; rw [e] at yn; contradiction
  have rne : L.r≠[] := by intro e; rw [e] at rn; contradiction
  have cne : spine≠[] := by intro e; rw [e] at spineLen; contradiction
  have yshape : L.y=a::x := cmp_head_drop L.y yne
  have rshape : L.r=b::y := cmp_head_drop L.r rne
  have cshape : spine=c::cs := cmp_head_drop spine cne
  have fullshape : Q6Structural.q6Carry L=c::(cs++[last]) := by
    calc
      Q6Structural.q6Carry L=spine++[last] := geom.2.2
      _=c::(cs++[last]) := by rw [cshape]; rfl
  have nd : (L.parity::L.one::((a::x)++(b::y)++(c::(cs++[last])))).Nodup := by
    rw [←yshape,←rshape,←fullshape]
    exact cmp_q6_comparator_nodup L hn
  have hx : x.length=y.length := by
    simp only [x,y,List.length_drop,yn,rn]
  have hcs : (cs++[last]).length=y.length := by
    simp only [cs,y,List.length_append,List.length_singleton,List.length_drop,spineLen,rn]
  have csLen : cs.length=254 := by
    simp only [cs,List.length_drop,spineLen]
  have tailNonempty : y≠[] := by
    intro e
    have len : y.length=255 := by simp only [y,List.length_drop,rn]
    rw [e] at len
    contradiction
  have tailMember : base 760∈cs := cmp_q6_spine_member (base 760) L hw member
  have clean : ∀q∈c::(cs++[last]),s.basis q=false := by
    rw [←fullshape]
    exact cmp_q6_clean L s hc lower0
  have flag' (h : forward=true) : s.basis L.parity=
      decide (regValue (a::x) s.basis<regValue (b::y) s.basis) := by
    rw [←yshape,←rshape]
    exact flag h
  have result := loan_comparator_window_eq d retiredRoles forward (base 760) a b c L.one
    L.parity last x y cs nd hx hcs tailNonempty (by omega) roleTail tailMember s m n ho
    clean flag'
  have sourceShape : compareBlockLoan d forward L=
      notRegister (L.one::b::y)++majority a b L.one c++[.X L.one]++
      Q6LifetimeResearch.move (base 760) L.one
        (compareLoan d retiredRoles forward x y cs c L.parity)++[.X L.one]++
      eraseCarry a b L.one c++notRegister (L.one::b::y) := by
    unfold compareBlockLoan
    change notRegister (L.one::L.r)++majority a b L.one c++[.X L.one]++
      Q6LifetimeResearch.move (base 760) L.one
        (compareLoan d retiredRoles forward x y cs c L.parity)++[.X L.one]++
      eraseCarry a b L.one c++notRegister (L.one::L.r)=_
    rw [rshape]
  rw [sourceShape]
  have targetShape : compareLt none L.y L.r (Q6Structural.q6Carry L) L.one L.parity=
      compareLt none (a::x) (b::y) (c::(cs++[last])) L.one L.parity := by
    rw [yshape,rshape,fullshape]
  rw [targetShape]
  exact result

/-- The loaned comparison block at the concrete 760 endpoint replays the record
    comparison block, in either direction (`forward := true`: field 3;
    `forward := false`: the inverse half of field 4). -/
theorem compareBlockLoan760_run_eq (d : Nat) (hd : d≤68) (forward : Bool) (s : State)
    (m n : List Bool)
    (oneZero : s.basis (Q6EndpointCell.ports base (base 2409)).one=false)
    (carryZero : ∀q∈(Q6EndpointCell.ports base (base 2409)).carry,s.basis q=false)
    (lowerZero : s.basis (Q6EndpointCell.ports base (base 2409)).lower=false)
    (flag : forward=true → s.basis (Q6EndpointCell.ports base (base 2409)).parity=
      decide (regValue (Q6EndpointCell.ports base (base 2409)).y s.basis<
        regValue (Q6EndpointCell.ports base (base 2409)).r s.basis)) :
    run (compareBlockLoan d forward (Q6EndpointCell.ports base (base 2409))) m s=
      run (Q6LifetimeResearch.compare (base 760) forward
        (Q6EndpointCell.ports base (base 2409))) n s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  have loan := compareBlockLoan_eq_plain d forward L760 hw hn R2Life760.member760
    (by omega) (retiredRoles_q6Tail d hd) s m n oneZero carryZero lowerZero flag
  have old := Q6LifetimeResearch.compare_eq_plain (base 760) forward L760 hw hn
    R2Life760.member760 s n n oneZero carryZero lowerZero flag
  exact loan.trans old.symm

/-- The forward comparison block at the concrete 760 endpoint. -/
private theorem compareBlockLoan760_true_run_eq (d : Nat) (hd : d≤68) (s : State)
    (m n : List Bool) (oneZero : s.basis L760.one=false)
    (carryZero : ∀q∈L760.carry,s.basis q=false)
    (lowerZero : s.basis L760.lower=false)
    (flag : s.basis L760.parity=
      decide (regValue L760.y s.basis<regValue L760.r s.basis)) :
    run (compareBlockLoan d true L760) m s=
      run (Q6LifetimeResearch.compare (base 760) true L760) n s :=
  compareBlockLoan760_run_eq d hd true s m n oneZero carryZero lowerZero (fun _ => flag)

/-! ## Reachable-state facts of the record forward half, generic in the layout.

Each lemma restates, at an explicitly named intermediate state, a fact the
record's own `Q6LifetimeProof` forward proof establishes internally; the proofs
follow the record proofs (`seed_raw_add_eq`, `seeded_raw_fifth_eq`,
`forward_prefix_eq`, `forward_eq`, `compare_window_eq`, `forward_before_eq`). -/

/-- Input of the raw-add block: the state after the guard seed. -/
private theorem fwd_seed_ready (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (s : State) (records : List Bool)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) (u : State)
    (hu : u=run (GuardCompression.seed L) records s) :
    u.basis L.parity=(u.basis L.r0 ^^ u.basis (L.ylow.getD 0 0)) ∧
      u.basis L.one=u.basis L.rmsb ∧ u.basis L.lower=false ∧
      ∀q∈L.carry,u.basis q=false := by
  have norm : run (GuardCompression.seed L) records s=
      run (GuardCompression.seed L) [] s :=
    FifthCarry.no_records _ (by rfl) _ _ _
  rw [norm] at hu
  subst hu
  have ready:=FifthCarry.seed_ready L hn s [] clean
  have seedND:=BalancedCircuit.seedND L hw hn
  have scalarND:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at seedND scalarND
  have parityOne:L.parity≠L.one:=by
    have h:=BalancedCircuit.scalarND L hn
    simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at h
    tauto
  have away(q:Wire)(hq:q∈[L.r0,L.ylow.getD 0 0,L.lower]):
      q≠L.parity∧q≠L.one:=by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
    rcases hq with rfl|rfl|rfl <;> constructor <;> tauto
  have pv:(run (GuardCompression.seed L) [] s).basis L.parity=
      ((run (GuardCompression.seed L) [] s).basis L.r0 ^^
        (run (GuardCompression.seed L) [] s).basis (L.ylow.getD 0 0)):=by
    simp only [GuardCompression.seed,run,writeBit,Function.update_self,
      Function.update_of_ne parityOne,
      Function.update_of_ne (away L.r0 (by simp)).1,
      Function.update_of_ne (away L.r0 (by simp)).2,
      Function.update_of_ne (away (L.ylow.getD 0 0) (by simp)).1,
      Function.update_of_ne (away (L.ylow.getD 0 0) (by simp)).2,
      clean L.parity (by simp [BalancedCircuit.work]),Bool.false_xor]
    cases s.basis L.r0 <;> cases s.basis (L.ylow.getD 0 0) <;> rfl
  have low:(run (GuardCompression.seed L) [] s).basis L.lower=false:=by
    simp [GuardCompression.seed,run,writeBit,(away L.lower (by simp)).1,
      (away L.lower (by simp)).2,clean L.lower (by simp [BalancedCircuit.work])]
  exact ⟨pv,ready.1,low,ready.2⟩

/-- The record's private `seeded_raw_fifth_eq`, re-proved verbatim. -/
private theorem fwd_seeded_raw_fifth_eq (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup)
    (member : base 760∈(L.carry.take 254).drop 1)
    (s : State) (m : List Bool) (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (GuardCompression.seed L++Q6LifetimeResearch.rawAdd (base 760) L) m s=
      run (GuardCompression.seed L++FifthCarry.rawAdd L) m s := by
  rw [Q6LifetimeProof.seed_raw_add_eq (base 760) L hw hn member s m clean]
  let u:=run (GuardCompression.seed L) [] s
  have ready:=FifthCarry.seed_ready L hn s [] clean
  have scalar:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have lowerParity:L.lower≠L.parity:=by tauto
  have lowerOne:L.lower≠L.one:=by tauto
  have low:u.basis L.lower=false:=by
    simp [u,GuardCompression.seed,run,writeBit,lowerParity,lowerOne,
      clean L.lower (by simp [BalancedCircuit.work])]
  have index:254<L.carry.length:=by rw [hw.2.2];omega
  have oldMember:L.carry.getD 254 0∈L.carry:=by
    rw [List.getD_eq_getElem _ _ index]
    exact List.getElem_mem _
  rw [TopCarry.run_zero_head _ _ m s rfl,TopCarry.run_zero_head _ _ m s rfl,
    ←Q6Structural.rawAdd_eq L hw hn]
  exact Q6RawBorrow.rawAdd_borrow L hw hn _ oldMember u m ready.1 ready.2 low

/-- Input of the fold block: the state after the record raw add, `newPrepare`
    and the raw-target rotation. -/
private theorem fwd_fold_ready (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : base 760∈(L.carry.take 254).drop 1)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (records : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=X) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) (u : State)
    (hu : u=run (OneReuse.newPrepare L++rotateRight (BalancedCircuit.rawTarget L)) []
      (run (GuardCompression.seed L++Q6LifetimeResearch.rawAdd (base 760) L) records s)) :
    u.basis L.rmsb=u.basis L.lower ∧ ∀q∈L.carry,u.basis q=false := by
  rw [fwd_seeded_raw_fifth_eq L hw hn member s records clean] at hu
  subst hu
  let v:=run (GuardCompression.seed L++FifthCarry.rawAdd L) records s
  let seedState:=run (GuardCompression.seed L) [] s
  have seedReady:=FifthCarry.seed_ready L hn s [] clean
  have guardEq:v=run (OneReuse.rawPrefix L) records s:=by
    change run (GuardCompression.seed L++FifthCarry.rawAdd L) records s=
      run (GuardCompression.seed L++GuardCompression.rawAdd L) records s
    rw [TopCarry.run_zero_head _ _ records s rfl,TopCarry.run_zero_head _ _ records s rfl]
    exact FifthCarry.rawAdd_eq L hw hn seedState records seedReady.1 seedReady.2
  have ready:v.basis L.lower=false∧v.basis L.minus=false∧v.basis L.r0=v.basis L.parity:=by
    rw [guardEq]
    exact OneReuse.rawPrefix_ready L hw hn B X Y hx hy s records hs hR hY clean
  have prepared:=OneReusePrefix.prepare_rotate_ready L hw hn v [] [] ready.1 ready.2.1
    ready.2.2
  have executeA:run (OneReuse.newPrepare L++rotateRight (BalancedCircuit.rawTarget L)) [] v=
      run (rotateRight (BalancedCircuit.rawTarget L)) []
        (run (OneReusePrefix.prepare L) [] v):=by
    rw [run_append]
    simp only [List.take_nil,List.drop_nil]
    rfl
  have high:(run (OneReuse.newPrepare L++rotateRight (BalancedCircuit.rawTarget L)) [] v).basis
      L.rmsb=(run (OneReuse.newPrepare L++rotateRight (BalancedCircuit.rawTarget L)) [] v).basis
        L.lower:=by
    rw [executeA]
    exact prepared.2.2.1
  have rawFrame:=GuardCompression.rawAdd_correct L hw hn seedState records
    ((regValue_zero _ _).mpr seedReady.2)
  have rawExecute:v=run (GuardCompression.rawAdd L) records seedState:=by
    rw [guardEq]
    exact TopCarry.run_zero_head _ _ records s rfl
  have carryV:∀q∈L.carry,v.basis q=false:=by
    intro q hq
    rw [rawExecute]
    exact (rawFrame.2.1 q (Q6RawBorrow.rawTarget_away L hn q (by simp [hq]))).trans
      (seedReady.2 q hq)
  have carryU:∀q∈L.carry,
      (run (OneReuse.newPrepare L++rotateRight (BalancedCircuit.rawTarget L)) [] v).basis q=
        false:=by
    intro q hq
    have targetAway:=Q6RawBorrow.rawTarget_away L hn q (by simp [hq])
    have low:q≠L.lower:=fun e=>BalancedCircuit.flagAway L hn L.lower (by simp)
      (by simp [←e,hq])
    have first:q≠L.r0:=fun e=>targetAway (by simp [BalancedCircuit.rawTarget,
      BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,e])
    have keep:(run (OneReusePrefix.prepare L) [] v).basis q=v.basis q:=by
      simp [OneReusePrefix.prepare,run,writeBit,low,first]
    rw [executeA]
    exact ((rotate_frame (BalancedCircuit.rawTarget L)
      (run (OneReusePrefix.prepare L) [] v) []).2.1 q targetAway).trans
      (keep.trans (carryV q hq))
  exact ⟨high,carryU⟩

/-- Facts at the end of the record forward prefix (as in the record `forward_eq`). -/
private theorem fwd_prefix_facts (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : base 760∈(L.carry.take 254).drop 1)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (records : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=X) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) (p : State)
    (hp : p=run (Q6LifetimeProof.forwardPrefix (base 760) L) records s) :
    p.basis L.one=false ∧ (∀q∈L.carry,p.basis q=false) ∧
      regValue L.r p.basis<2^255 ∧
      (run (CarryBorrow.cleanup L) [] p).basis L.parity=false := by
  rw [Q6LifetimeProof.forward_prefix_eq (base 760) L hw hn member B X Y hx hy s records
    hs hR hY clean] at hp
  subst hp
  have preClean:=FifthCarry.forward_prefix_clean L hw hn B X Y hx hy s (false::records)
    hs hR hY clean
  rw [←FifthCarry2.forwardPrefix_shifted L hw hn s records clean] at preClean
  have bound:=Q6CompareReady.forwardPrefix_bound L hw hn B X Y hx hy s records hs hR hY clean
  obtain ⟨wholeRecords,wholeRun⟩ := join_records (FifthCarry2.forwardPrefix L)
    (CarryBorrow.cleanup L) s records []
  have old:=FifthCarry.forward_correct L hw hn B X Y hx hy s wholeRecords hs hR hY clean
  have oldShape:FifthCarry.forward L=FifthCarry2.forwardPrefix L++CarryBorrow.cleanup L:=by
    simp only [FifthCarry.forward,FifthCarry2.forwardPrefix,List.append_assoc]
  have cleared:(run (CarryBorrow.cleanup L) []
      (run (FifthCarry2.forwardPrefix L) records s)).basis L.parity=false:=by
    rw [←wholeRun,←oldShape]
    exact old.2.2.1 L.parity (by simp [BalancedCircuit.work])
  exact ⟨preClean.1,preClean.2,bound,cleared⟩

/-- Three scalar-wire disequalities, from the record's scalar `Nodup` (no `tauto`). -/
private theorem fwd_lower_ne (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.sign≠L.lower ∧ L.one≠L.lower ∧ L.parity≠L.lower := by
  have h:=BalancedCircuit.scalarND L hn
  refine ⟨fun e => ?_,fun e => ?_,fun e => ?_⟩
  · rw [e] at h
    simp at h
  · rw [e] at h
    simp at h
  · rw [e] at h
    simp at h

/-- Input of the comparison block: after the record prefix, `prepareCompare`
    and the lower exposure (as in the record `compare_window_eq`). -/
private theorem fwd_compare_ready (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : base 760∈(L.carry.take 254).drop 1)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (records : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=X) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) (u : State)
    (hu : u=run (Q6StructuralCell.exposure L) []
      (run (BalancedCleanup.prepareCompare L.toLayout) []
        (run (Q6LifetimeProof.forwardPrefix (base 760) L) records s))) :
    u.basis L.one=false ∧ (∀q∈L.carry,u.basis q=false) ∧ u.basis L.lower=false ∧
      u.basis L.parity=decide (regValue L.y u.basis<regValue L.r u.basis) := by
  let p:=run (Q6LifetimeProof.forwardPrefix (base 760) L) records s
  have facts:=fwd_prefix_facts L hw hn member B X Y hx hy s records hs hR hY clean p rfl
  have ready:=Q6LifetimeProof.forward_compare_ready L hw hn p [] facts.1 facts.2.1
    facts.2.2.1 facts.2.2.2
  let v:=run (BalancedCleanup.prepareCompare L.toLayout) [] p
  change u=run (Q6StructuralCell.exposure L) [] v at hu
  subst hu
  have lowerNe:=fwd_lower_ne L hn
  have sl:L.sign≠L.lower:=lowerNe.1
  have ol:L.one≠L.lower:=lowerNe.2.1
  have pl:L.parity≠L.lower:=lowerNe.2.2
  have lowerR:L.lower∉L.r:=fun used=>BalancedCircuit.flagAway L hn L.lower
    (by simp) (by simp [used])
  have lowerY:L.lower∉L.y:=fun used=>BalancedCircuit.flagAway L hn L.lower
    (by simp) (by simp [used])
  have rl:L.r0≠L.lower:=fun eq=>lowerR (by
    simp [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,←eq])
  have expose:=Q6LowerExposure.expose_correct L.sign L.lower L.r0 sl rl v [] ready.2.2.1
  have one:(run (Q6StructuralCell.exposure L) [] v).basis L.one=false:=
    (expose.2.2 _ ol).trans ready.1
  have carry:∀q∈L.carry,(run (Q6StructuralCell.exposure L) [] v).basis q=false:=by
    intro q hq
    have ql:q≠L.lower:=fun eq=>BalancedCircuit.flagAway L hn L.lower
      (by simp) (by simp [←eq,hq])
    exact (expose.2.2 q ql).trans (ready.2.1 q hq)
  have values:regValue L.y (run (Q6StructuralCell.exposure L) [] v).basis=
        regValue L.y v.basis ∧
      regValue L.r (run (Q6StructuralCell.exposure L) [] v).basis=
        regValue L.r v.basis:=by
    constructor
    · apply regValue_congr
      intro q hq
      exact expose.2.2 q (fun eq=>lowerY (eq ▸ hq))
    · apply regValue_congr
      intro q hq
      exact expose.2.2 q (fun eq=>lowerR (eq ▸ hq))
  have flag:(run (Q6StructuralCell.exposure L) [] v).basis L.parity=
      decide (regValue L.y (run (Q6StructuralCell.exposure L) [] v).basis<
        regValue L.r (run (Q6StructuralCell.exposure L) [] v).basis):=by
    rw [values.1,values.2]
    exact (expose.2.2 _ pl).trans ready.2.2.2
  exact ⟨one,carry,expose.2.1,flag⟩

/-- Two scalar-wire disequalities, from the record's scalar `Nodup`. -/
private theorem fwd_parity_ne (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.one≠L.parity ∧ L.rmsb≠L.parity := by
  have h:=BalancedCircuit.scalarND L hn
  refine ⟨fun e => ?_,fun e => ?_⟩
  · rw [e] at h
    simp at h
  · rw [e] at h
    simp at h

/-- Input of the unnormalize block: after the record prefix and the record
    comparison window `forwardBefore` (as in the record `forward_cleanup_eq`). -/
private theorem fwd_unnormalize_ready (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : base 760∈(L.carry.take 254).drop 1)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (records : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=X) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) (t : State)
    (ht : t=run (Q6LifetimeProof.forwardPrefix (base 760) L++
      Q6LifetimeProof.forwardBefore (base 760) L) records s) :
    t.basis L.one=false ∧ (∀q∈L.carry,t.basis q=false) ∧ t.basis L.rmsb=false := by
  let pre:=Q6LifetimeProof.forwardPrefix (base 760) L
  let p:=run pre (records.take (measurementCount pre)) s
  have facts:=fwd_prefix_facts L hw hn member B X Y hx hy s
    (records.take (measurementCount pre)) hs hR hY clean p rfl
  have beforeEq:=Q6LifetimeProof.forward_before_eq (base 760) L hw hn member p
    (records.drop (measurementCount pre)) [] facts.1 facts.2.1 facts.2.2.1 facts.2.2.2
  have execute:t=run (Q6LifetimeProof.forwardBefore (base 760) L)
      (records.drop (measurementCount pre)) p:=by
    rw [ht]
    exact run_append _ _ _ _
  have highP:p.basis L.rmsb=false:=by
    have high:=regValue_highBit L.low L.rmsb p.basis
    rw [(BalancedCleanup.widths L.toLayout hw).1] at high
    change p.basis L.rmsb=true ↔ 2^255≤regValue L.r p.basis at high
    cases bit:p.basis L.rmsb
    · rfl
    · exact absurd (high.mp bit) (Nat.not_le.mpr facts.2.2.1)
  have keep (q : Wire) (ne : q≠L.parity) : t.basis q=p.basis q:=by
    rw [execute,beforeEq]
    change (writeBit p.basis L.parity false) q=p.basis q
    simp only [writeBit,Function.update_of_ne ne]
  have parityNe:=fwd_parity_ne L hn
  have oneNe:L.one≠L.parity:=parityNe.1
  have highNe:L.rmsb≠L.parity:=parityNe.2
  refine ⟨(keep L.one oneNe).trans facts.1,?_,(keep L.rmsb highNe).trans highP⟩
  intro q hq
  have ne:q≠L.parity:=by
    intro eq
    exact BalancedCircuit.flagAway L hn L.parity (by simp) (by simp [←eq,hq])
  exact (keep q ne).trans (facts.2.1 q hq)

/-! ## Four-block composition, generic in the layout. -/

private theorem replace_mid (A P Q R : Program) (s : State) (m : List Bool)
    (middle : ∀ x, ∃ y,
      run P x (run A (m.take (measurementCount A)) s) =
        run Q y (run A (m.take (measurementCount A)) s)) :
    ∃ n, run (A ++ (P ++ R)) m s = run (A ++ (Q ++ R)) n s := by
  have h := replace_middle_exists_one A P Q R s m middle
  simpa only [List.append_assoc] using h

/-- The forward loan half equals the record forward half once each of the four
    loaned blocks is known to replay its record block on that block's own input
    frame.  The four block hypotheses are discharged at the 760 endpoint below. -/
private theorem forwardLoan_run_eq_of (d : Nat) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) (member : base 760∈(L.carry.take 254).drop 1)
    (rawStep : ∀ (u : State) (x : List Bool),
      u.basis L.parity=(u.basis L.r0 ^^ u.basis (L.ylow.getD 0 0)) →
      u.basis L.one=u.basis L.rmsb → u.basis L.lower=false →
      (∀q∈L.carry,u.basis q=false) →
      ∃ y, run (StairLoan.rawAddLoan d L) x u=
        run (Q6LifetimeResearch.rawAdd (base 760) L) y u)
    (foldStep : ∀ (u : State) (x : List Bool),
      u.basis L.rmsb=u.basis L.lower → (∀q∈L.carry,u.basis q=false) →
      ∃ y, run (StairLoan.foldLoan d L) x u=
        run (Q6LifetimeResearch.fold (base 760) L) y u)
    (compareStep : ∀ (u : State) (x y : List Bool),
      u.basis L.one=false → (∀q∈L.carry,u.basis q=false) → u.basis L.lower=false →
      u.basis L.parity=decide (regValue L.y u.basis<regValue L.r u.basis) →
      run (StairLoan.compareBlockLoan d true L) x u=
        run (Q6LifetimeResearch.compare (base 760) true L) y u)
    (unnormalizeStep : ∀ (u : State) (x : List Bool),
      u.basis L.one=false → (∀q∈L.carry,u.basis q=false) → u.basis L.rmsb=false →
      ∃ y, run (StairLoan.unnormalizeLoan d L) x u=
        run (Q6LifetimeResearch.unnormalize (base 760) false L) y u)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (fresh old : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=X) (hY : signedRegValue L.y s.basis=Y)
    (clean : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (StairLoan.forwardLoan d L) fresh s=
      run (Q6LifetimeResearch.forward (base 760) false L) old s := by
  let Seed := GuardCompression.seed L
  let RawP := StairLoan.rawAddLoan d L
  let RawQ := Q6LifetimeResearch.rawAdd (base 760) L
  let MidFold := OneReuse.newPrepare L++rotateRight (BalancedCircuit.rawTarget L)
  let FoldP := StairLoan.foldLoan d L
  let FoldQ := Q6LifetimeResearch.fold (base 760) L
  let Bias := BalancedCleanup.prepareSign L.toLayout++BiasedCircuit.flipBias L
  let Prep := BalancedCleanup.prepareCompare L.toLayout++Q6StructuralCell.exposure L
  let CmpP := StairLoan.compareBlockLoan d true L
  let CmpQ := Q6LifetimeResearch.compare (base 760) true L
  let After := (Q6StructuralCell.exposure L).reverse++
    (BalancedCleanup.prepareCompare L.toLayout).reverse
  let UnP := StairLoan.unnormalizeLoan d L
  let UnQ := Q6LifetimeResearch.unnormalize (base 760) false L
  let Tail := (BalancedCleanup.prepareSign L.toLayout).reverse++[.measureX L.one [] []]
  have loanShape : StairLoan.forwardLoan d L=
      Seed++(RawP++(MidFold++(FoldP++(Bias++(Prep++(CmpP++(After++(UnP++Tail)))))))) := by
    simp only [StairLoan.forwardLoan,Seed,RawP,MidFold,FoldP,Bias,Prep,CmpP,After,UnP,Tail,
      List.append_assoc]
  have oldShape : Q6LifetimeResearch.forward (base 760) false L=
      Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpQ++(After++(UnQ++Tail)))))))) := by
    simp only [Q6LifetimeResearch.forward,Seed,RawQ,MidFold,FoldQ,Bias,Prep,CmpQ,After,UnQ,
      Tail,List.append_assoc]
  -- (1) raw add
  have step1 : ∃ n1,
      run (Seed++(RawP++(MidFold++(FoldP++(Bias++(Prep++(CmpP++(After++(UnP++Tail))))))))) fresh s=
      run (Seed++(RawQ++(MidFold++(FoldP++(Bias++(Prep++(CmpP++(After++(UnP++Tail))))))))) n1 s := by
    apply replace_mid Seed RawP RawQ _ s fresh
    intro x
    have ready := fwd_seed_ready L hw hn s (fresh.take (measurementCount Seed)) clean
      (run Seed (fresh.take (measurementCount Seed)) s) rfl
    exact rawStep _ x ready.1 ready.2.1 ready.2.2.1 ready.2.2.2
  obtain ⟨n1,h1⟩ := step1
  -- (2) fold
  have midZero : measurementCount MidFold=0 := by
    simp only [MidFold,measurementCount_append,
      (rotate_counts (BalancedCircuit.rawTarget L)).2.1]
    rfl
  have step2 : ∃ n2,
      run (Seed++(RawQ++(MidFold++(FoldP++(Bias++(Prep++(CmpP++(After++(UnP++Tail))))))))) n1 s=
      run (Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpP++(After++(UnP++Tail))))))))) n2 s := by
    have reassoc (Z : Program) : Seed++(RawQ++(MidFold++Z))=(Seed++RawQ++MidFold)++Z := by
      simp only [List.append_assoc]
    rw [reassoc,reassoc]
    apply replace_mid (Seed++RawQ++MidFold) FoldP FoldQ _ s n1
    intro x
    let recs := n1.take (measurementCount (Seed++RawQ++MidFold))
    have stateEq : run (Seed++RawQ++MidFold) recs s=
        run MidFold [] (run (Seed++RawQ) recs s) := by
      rw [run_append,run_take]
      exact FifthCarry.no_records MidFold midZero _ _ []
    have ready := fwd_fold_ready L hw hn member B X Y hx hy s recs hs hR hY clean
      (run (Seed++RawQ++MidFold) recs s) stateEq
    exact foldStep _ x ready.1 ready.2
  obtain ⟨n2,h2⟩ := step2
  -- (3) compare
  have prepZero : measurementCount Prep=0 := by
    have e0 : measurementCount (Q6StructuralCell.exposure L)=0 :=
      (Q6LowerExposure.expose_counts _ _ _).2
    simp only [Prep,measurementCount_append,Q6CleanupBorrow.prepare_M,e0,Nat.add_zero]
  have step3 : ∃ n3,
      run (Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpP++(After++(UnP++Tail))))))))) n2 s=
      run (Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpQ++(After++(UnP++Tail))))))))) n3 s := by
    have reassoc (Z : Program) : Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++Z)))))=
        (Q6LifetimeProof.forwardPrefix (base 760) L++Prep)++Z := by
      simp only [Q6LifetimeProof.forwardPrefix,Seed,RawQ,MidFold,FoldQ,Bias,
        List.append_assoc]
    rw [reassoc,reassoc]
    apply replace_mid (Q6LifetimeProof.forwardPrefix (base 760) L++Prep) CmpP CmpQ _ s n2
    intro x
    let recs := n2.take (measurementCount (Q6LifetimeProof.forwardPrefix (base 760) L++Prep))
    have stateEq : run (Q6LifetimeProof.forwardPrefix (base 760) L++Prep) recs s=
        run (Q6StructuralCell.exposure L) []
          (run (BalancedCleanup.prepareCompare L.toLayout) []
            (run (Q6LifetimeProof.forwardPrefix (base 760) L) recs s)) := by
      rw [run_append,run_take,FifthCarry.no_records Prep prepZero _ _ []]
      simp only [Prep,run_append,List.take_nil,List.drop_nil]
    have ready := fwd_compare_ready L hw hn member B X Y hx hy s recs hs hR hY clean
      (run (Q6LifetimeProof.forwardPrefix (base 760) L++Prep) recs s) stateEq
    exact ⟨[],compareStep _ x [] ready.1 ready.2.1 ready.2.2.1 ready.2.2.2⟩
  obtain ⟨n3,h3⟩ := step3
  -- (4) unnormalize
  have step4 : ∃ n4,
      run (Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpQ++(After++(UnP++Tail))))))))) n3 s=
      run (Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpQ++(After++(UnQ++Tail))))))))) n4 s := by
    have reassoc (Z : Program) :
        Seed++(RawQ++(MidFold++(FoldQ++(Bias++(Prep++(CmpQ++(After++Z)))))))=
        (Q6LifetimeProof.forwardPrefix (base 760) L++
          Q6LifetimeProof.forwardBefore (base 760) L)++Z := by
      simp only [Q6LifetimeProof.forwardPrefix,Q6LifetimeProof.forwardBefore,Seed,RawQ,
        MidFold,FoldQ,Bias,Prep,CmpQ,After,List.append_assoc]
    rw [reassoc,reassoc]
    apply replace_mid _ UnP UnQ _ s n3
    intro x
    have ready := fwd_unnormalize_ready L hw hn member B X Y hx hy s
      (n3.take (measurementCount (Q6LifetimeProof.forwardPrefix (base 760) L++
        Q6LifetimeProof.forwardBefore (base 760) L))) hs hR hY clean _ rfl
    exact unnormalizeStep _ x ready.1 ready.2.1 ready.2.2
  obtain ⟨n4,h4⟩ := step4
  rw [loanShape,oldShape]
  have generated := Q6LifetimeProof.forward_eq (base 760) L hw hn member B X Y hx hy s
    n4 old hs hR hY clean
  have target := Q6LifetimeProof.forward_eq (base 760) L hw hn member B X Y hx hy s
    old old hs hR hY clean
  rw [oldShape] at generated target
  exact h1.trans (h2.trans (h3.trans (h4.trans (generated.trans target.symm))))

/-- Forward (`divide = true`) positive-depth loan replay at the 760 endpoint. -/
private theorem forwardLoan_run_eq (d : Nat) (hd : d ≤ 68)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (fresh old : List Bool)
    (hs : s.basis L760.sign = B)
    (hR : signedRegValue L760.r s.basis = X)
    (hY : signedRegValue L760.y s.basis = Y)
    (clean : ∀ q ∈ BalancedCircuit.work L760, s.basis q = false) :
    run (StairLoan.forwardLoan d L760) fresh s =
      run (Q6LifetimeResearch.forward (base 760) false L760) old s := by
  have hw : L760.Widths := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L760.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  exact forwardLoan_run_eq_of d L760 hw hn R2Life760.member760
    (fun u x h1 h2 h3 h4 => rawAddLoan_exists d hd u x h1 h2 h3 h4)
    (fun u x h1 h2 => foldLoan_exists d hd u x h1 h2)
    (fun u x y h1 h2 h3 h4 => compareBlockLoan760_true_run_eq d hd u x y h1 h2 h3 h4)
    (fun u x h1 h2 h3 => unnormalizeLoan_exists d hd u x h1 h2 h3)
    B X Y hx hy s fresh old hs hR hY clean

/-- Forward (`divide = true`) positive-depth half replay on the exact record
    `PairFrame` and clean-work precondition. -/
theorem half760Loan_forward_run_eq (d : Nat) (_hd0 : 0 < d) (hd : d ≤ 68)
    (origin : BasisState) (clean : Q6EndpointCell.Clean base origin)
    (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis) :
    run (StairLoan.half760Loan d true) fresh s =
      run (Q6EndpointCell.half true base (base 2409)) old s := by
  let L := Q6EndpointCell.ports base (base 2409)
  let u := run [.X L.sign] [] s
  have hw := Q6EndpointCell.ports_widths base (base 2409)
  have hn : L.wires.Nodup := Rolling1588Lifetime.half_ports_nodup760
  have cl := Q6EndpointCell.clean_work base (base 2409) origin clean
  have away := BalancedCircuit.flagAway L hn L.sign (by simp)
  have sa : L.sign ∉ L.r ∧ L.sign ∉ L.y :=
    ⟨fun h => away (by simp [h]), fun h => away (by simp [h])⟩
  have us := BalancedCleanupOffset.x_run L.sign s []
  have uf (q : Wire) (hq : q ≠ L.sign) : u.basis q = s.basis q := by
    change (run [.X L.sign] [] s).basis q = s.basis q
    rw [us]
    simp only [writeBit, Function.update_of_ne hq]
  have ug : u.basis L.sign = !origin L.sign := by
    change (run [.X L.sign] [] s).basis L.sign = !origin L.sign
    rw [us]
    simp only [writeBit, Function.update_self, input.2.2 L.sign sa.1 sa.2]
  have uv (r : List Wire) (free : L.sign ∉ r) :
      regValue r u.basis = regValue r s.basis :=
    regValue_congr _ _ _ (fun q hq => uf q (fun eq => free (eq ▸ hq)))
  have ur : signedRegValue L.r u.basis = centerFp X := by
    rw [signedRegValue, uv L.r sa.1, input.1,
      (BalancedCleanup.widths L.toLayout hw).2.1, centerWord_decode]
  have uy : signedRegValue L.y u.basis = centerFp Y := by
    rw [signedRegValue, uv L.y sa.2, input.2.1,
      (BalancedCleanup.widths L.toLayout hw).2.2.1, centerWord_decode]
  have uc : ∀ q ∈ BalancedCircuit.work L, u.basis q = false := by
    intro q hq
    have a := OwnQ6Core5.work_away L hn q hq
    exact (uf q (fun eq => OwnQ6Core5.sign_work L hn (eq ▸ hq))).trans
      ((input.2.2 q a.1 a.2).trans (cl q hq))
  have body := forwardLoan_run_eq d hd (!origin L.sign)
    (centerFp X) (centerFp Y) (centerFp_bounds X) (centerFp_bounds Y)
    u fresh old ug ur uy uc
  have execute (P : Program) (records : List Bool) :
      run ([.X L.sign] ++ P ++ [.X L.sign]) records s =
        run [.X L.sign] [] (run P records u) := by
    rw [List.append_assoc, run_append]
    simp only [measurementCount, List.take_zero, List.drop_zero]
    rw [run_append, run_take]
    exact FifthCarry.no_records [.X L.sign] (by rfl) _ _ []
  have loanShape : StairLoan.half760Loan d true =
      [.X L.sign] ++ StairLoan.forwardLoan d L ++ [.X L.sign] := by
    simp [StairLoan.half760Loan, L]
    rfl
  have oldShape : R2Life760.half760 true =
      [.X L.sign] ++ Q6LifetimeResearch.forward (base 760) false L ++
        [.X L.sign] := by
    rw [R2Life760.half760_true]
    rfl
  calc
    run (StairLoan.half760Loan d true) fresh s =
        run (R2Life760.half760 true) old s := by
      rw [loanShape, oldShape, execute, execute, body]
    _ = run (Q6EndpointCell.half true base (base 2409)) old s :=
      R2Life760.half760_run_eq true hn origin clean X Y s old old input

/-- Field 3 (`StairCertificate.StairOpen.loan_forward`) in the exact unfolded form of
    `StairCertificate.PositiveHalfRunSpec true`. -/
theorem half760Loan_forward_spec : ∀ d, 0 < d → d ≤ 68 → ∀ origin,
    Q6EndpointCell.Clean base origin → ∀ X Y s fresh old,
    PairFrame (Q6EndpointCell.ports base (base 2409)).r
      (Q6EndpointCell.ports base (base 2409)).y origin
      (centerWord X) (centerWord Y) s.basis →
    run (StairLoan.half760Loan d true) fresh s =
      run (Q6EndpointCell.half true base (base 2409)) old s :=
  fun d hp hd origin clean X Y s fresh old input =>
    half760Loan_forward_run_eq d hp hd origin clean X Y s fresh old input

end ECDSAAdd.Entrant.StairLoanForwardB
end Merge_StairLoanForwardB_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanInverseCore_at_StairSideA` -/
section Merge_StairLoanInverseCore_at_StairSideA

/-!
# Positive-depth inverse carry-loan replay

This module supplies the inverse (`divide = false`) half of the staircase
carry-loan semantic equality.  It is separate from `StairLoan` so the shared
loan construction and the forward proof can evolve independently.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 12000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false
set_option linter.unnecessarySimpa false

namespace ECDSAAdd.Entrant.StairLoanInverse

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField
open StairLoan

/-- The inverse comparison chain touches only its two inputs, its recursive
    carries, the incoming carry, and the output flag. -/
theorem compareChain_false_support (as bs cs : List Wire) (cin target : Wire) :
    wires (Q6LifetimeResearch.compareChain false as bs cs cin target) ⊆
      (as++bs++cs++[cin,target]).toFinset := by
  induction as generalizing bs cs cin with
  | nil =>
      intro q hq
      simpa [Q6LifetimeResearch.compareChain,wires] using hq
  | cons a as ih =>
      cases as with
      | nil =>
          cases bs with
          | nil =>
              intro q hq
              simpa [Q6LifetimeResearch.compareChain,wires] using hq
          | cons b bs =>
              cases bs with
              | nil =>
                  intro q hq
                  simp only [Q6LifetimeResearch.compareChain,
                    Q6LifetimeResearch.compareLeaf,Bool.false_eq_true,if_false,
                    wires_append,Finset.mem_union] at hq
                  simp only [List.mem_toFinset,List.mem_append,List.mem_cons,
                    List.not_mem_nil,or_false]
                  rcases hq with head|tail
                  · simp [majority,wires,Instr.wires] at head
                    tauto
                  · simp [wires,Instr.wires] at tail
                    tauto
              | cons b' bs =>
                  intro q hq
                  simpa [Q6LifetimeResearch.compareChain,wires] using hq
      | cons a' as =>
          cases bs with
          | nil =>
              intro q hq
              simpa [Q6LifetimeResearch.compareChain,wires] using hq
          | cons b bs =>
              cases bs with
              | nil =>
                  intro q hq
                  simpa [Q6LifetimeResearch.compareChain,wires] using hq
              | cons b' bs =>
                  cases cs with
                  | nil =>
                      intro q hq
                      simpa [Q6LifetimeResearch.compareChain,wires] using hq
                  | cons c cs =>
                      have tail := ih (b'::bs) cs c
                      intro q hq
                      simp only [Q6LifetimeResearch.compareChain,wires_append,
                        Finset.mem_union] at hq
                      simp only [List.mem_toFinset,List.mem_append,List.mem_cons,
                        List.not_mem_nil,or_false]
                      rcases hq with (head|tailUsed)|finish
                      · simp [majority,wires,Instr.wires] at head
                        tauto
                      · have h := List.mem_toFinset.mp (tail tailUsed)
                        simp only [List.mem_append,List.mem_cons,
                          List.not_mem_nil,or_false] at h
                        tauto
                      · rw [eraseCarry_wires] at finish
                        simp only [Finset.mem_insert,Finset.mem_singleton] at finish
                        tauto

theorem compareChain_append_last (as bs cs : List Wire) (cin target last : Wire)
    (hab : as.length=bs.length) (hc : cs.length+1=bs.length)
    (nonempty : bs≠[]) :
    Q6LifetimeResearch.compareChain false as bs (cs++[last]) cin target=
      Q6LifetimeResearch.compareChain false as bs cs cin target := by
  induction bs generalizing as cs cin with
  | nil => exact (nonempty rfl).elim
  | cons b bs ih =>
      cases as with
      | nil => simp at hab
      | cons a as =>
          have hab' : as.length=bs.length := Nat.succ.inj hab
          cases bs with
          | nil =>
              have ae : as=[] := List.eq_nil_of_length_eq_zero hab'
              subst as
              simp only [Q6LifetimeResearch.compareChain]
          | cons b' bs =>
              cases as with
              | nil => simp at hab'
              | cons a' as =>
                  cases cs with
                  | nil => simp at hc
                  | cons c cs =>
                      have hc' : cs.length+1=(b'::bs).length := Nat.succ.inj hc
                      have tail := ih (a'::as) cs c hab' hc' (by simp)
                      simp only [Q6LifetimeResearch.compareChain,List.cons_append,tail]

/-- Full-State replay for the inverse comparison recursion.  The extra
    `last` carry is the clean old comparator top used to obtain the standard
    correctness frame; the lifetime comparison itself intentionally omits it. -/
theorem compareLoan_false_run_eq (d : Nat) (roles as bs cs : List Wire)
    (last cin target : Wire) (s : State) (m n : List Bool)
    (hab : as.length=bs.length) (hc : cs.length+1=bs.length)
    (hd : d+1≤cs.length)
    (hn : (target::cin::(as++bs++cs++[last])).Nodup)
    (clean : ∀q∈cs++[last],s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1)) :
    run (compareLoan d roles false as bs cs cin target) m s=
      run (Q6LifetimeResearch.compareChain false as bs cs cin target) n s := by
  let bits := mappedRead as false
  let layers := compareLayers false as bs cs cin target
  let topProgram := compareTop false as bs cs cin target
  let P := emitUps (layers.take (d+1))
  let U := emitSweep (layers.drop (d+1)) topProgram
  let u := run P [] s
  let v := run U [] u
  let out := run (emitSweep layers topProgram) [] s
  have bitsLength : bits.length=bs.length := by
    simp only [bits,mappedRead_length]
    exact hab
  have mappedND : (cin::(bs++cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have sourceAway : ∀q∈mappedWires bits,q∉cin::(bs++cs) := by
    intro q hq bad
    simp only [bits,mappedRead_wires] at hq
    have h := List.nodup_iff_count.mp hn q
    have hp := List.count_pos_iff.mpr hq
    simp only [List.mem_cons,List.mem_append] at bad
    rcases bad with rfl|bad|bad
    · simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at h hp
      omega
    · have hbad := List.count_pos_iff.mpr bad
      simp only [List.count_cons,List.count_append,List.count_nil] at h hp hbad
      omega
    · have hbad := List.count_pos_iff.mpr bad
      simp only [List.count_cons,List.count_append,List.count_nil] at h hp hbad
      omega
  have prefixShapes := compare_prefix_shapes (d+1) false as bs cs cin target
    hab (by omega) hd
  have borrowShapes := compare_prefix_shapes d false as bs cs cin target
    hab (by omega) (by omega)
  have prefixShape : P=carryPrefix (d+1) bits bs cs cin := prefixShapes.1
  have eraseShape : emitErases (layers.take d)=erasePrefix d bits bs cs cin :=
    borrowShapes.2.1
  have borrowShape : emitUps (layers.take d)=carryPrefix d bits bs cs cin :=
    borrowShapes.1
  have hostShape : layerHosts (layers.take d)=cs.take d := borrowShapes.2.2
  have prefixZero : measurementCount P=0 := by
    rw [prefixShape]
    exact (carryPrefix_counts (d+1) bits bs cs cin (by omega)
      (by omega) hd).2
  have prefixRun : ∀rec,run P rec s=u := by
    intro rec
    exact FifthCarry.no_records P prefixZero s rec []
  have prefixFrame := carryPrefix_frame (d+1) bits bs cs cin s [] mappedND
    sourceAway (by omega) (by omega) hd
    (fun q hq=>clean q (by
      simp only [List.mem_append]
      exact Or.inl (List.mem_of_mem_take hq)))
  rw [←prefixShape] at prefixFrame
  change u.phase=s.phase ∧ PrefixReady (d+1) bits bs cs cin u.basis ∧
    ∀q,q∉cs.take (d+1) → u.basis q=s.basis q at prefixFrame
  have upperShape : U=Q6LifetimeResearch.compareChain false
      (as.drop (d+1)) (bs.drop (d+1)) (cs.drop (d+1))
      (carryAfter (d+1) cs cin) target := by
    exact compare_upper_sweep (d+1) false as bs cs cin target hab (by omega) hd
  have tailHab : (as.drop (d+1)).length=(bs.drop (d+1)).length := by
    simp only [List.length_drop]
    omega
  have tailHc : ((cs.drop (d+1))++[last]).length=(bs.drop (d+1)).length := by
    simp only [List.length_append,List.length_singleton,List.length_drop]
    omega
  have tailNonempty : bs.drop (d+1)≠[] := by
    intro e
    have len := congrArg List.length e
    simp only [List.length_drop,List.length_nil] at len
    omega
  have csND : cs.Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have carryFull : carryAfter (d+1) cs cin∈cs :=
    carryAfter_succ_mem d cs cin hd
  have carryMem : carryAfter (d+1) cs cin∈cin::cs :=
    List.mem_cons_of_mem cin carryFull
  have tailND : (target::carryAfter (d+1) cs cin::
      ((as.drop (d+1))++(bs.drop (d+1))++((cs.drop (d+1))++[last]))).Nodup := by
    have restND : (as++bs++cs++[last]).Nodup :=
      (List.nodup_cons.mp (List.nodup_cons.mp hn).2).2
    have restTailND : ((as.drop (d+1))++(bs.drop (d+1))++
        ((cs.drop (d+1))++[last])).Nodup := by
      apply List.nodup_iff_count.mpr
      intro q
      have h := List.nodup_iff_count.mp restND q
      have ha := (List.drop_sublist (d+1) as).count_le q
      have hb := (List.drop_sublist (d+1) bs).count_le q
      have hcs := (List.drop_sublist (d+1) cs).count_le q
      simp only [List.count_append,List.count_cons,List.count_nil] at h ha hb hcs ⊢
      omega
    have targetAway : target∉(carryAfter (d+1) cs cin)::
        ((as.drop (d+1))++(bs.drop (d+1))++((cs.drop (d+1))++[last])) := by
      intro used
      have away := (List.nodup_cons.mp hn).1
      apply away
      have sourceLift (h : target∈as.drop (d+1)) : target∈as :=
        List.mem_of_mem_drop h
      have targetLift (h : target∈bs.drop (d+1)) : target∈bs :=
        List.mem_of_mem_drop h
      have carryLift (h : target∈cs.drop (d+1)) : target∈cs :=
        List.mem_of_mem_drop h
      have carryEqLift (h : target=carryAfter (d+1) cs cin) : target∈cs :=
        h ▸ carryFull
      simp only [List.mem_cons,List.mem_append,List.mem_singleton,
        List.not_mem_nil,or_false] at used ⊢
      tauto
    have carryLow : carryAfter (d+1) cs cin∈cs.take (d+1) :=
      carryAfter_succ_take_mem d cs cin hd
    have carryAway : carryAfter (d+1) cs cin∉
        (as.drop (d+1))++(bs.drop (d+1))++((cs.drop (d+1))++[last]) := by
      intro used
      have awayAs : carryAfter (d+1) cs cin∉as.drop (d+1) := by
        intro source
        have h := List.nodup_iff_count.mp hn (carryAfter (d+1) cs cin)
        have hp := List.count_pos_iff.mpr carryFull
        have hq := List.count_pos_iff.mpr (List.mem_of_mem_drop source)
        simp only [List.count_cons,List.count_append,List.count_nil] at h hp hq
        omega
      have awayBs : carryAfter (d+1) cs cin∉bs.drop (d+1) := by
        intro targetBit
        have h := List.nodup_iff_count.mp hn (carryAfter (d+1) cs cin)
        have hp := List.count_pos_iff.mpr carryFull
        have hq := List.count_pos_iff.mpr (List.mem_of_mem_drop targetBit)
        simp only [List.count_cons,List.count_append,List.count_nil] at h hp hq
        omega
      have awayCs : carryAfter (d+1) cs cin∉cs.drop (d+1) := by
        exact fun carry=>List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) carryLow carry
      have awayLast : carryAfter (d+1) cs cin≠last := by
        intro eq
        have h := List.nodup_iff_count.mp hn (carryAfter (d+1) cs cin)
        have hp := List.count_pos_iff.mpr carryFull
        subst last
        simp only [List.count_cons,List.count_append,List.count_nil,
          beq_self_eq_true,if_true] at h hp
        omega
      simp only [List.mem_append,List.mem_singleton] at used
      tauto
    exact List.nodup_cons.mpr ⟨targetAway,
      List.nodup_cons.mpr ⟨carryAway,restTailND⟩⟩
  have cleanU : ∀q∈(cs.drop (d+1))++[last],u.basis q=false := by
    intro q hq
    simp only [List.mem_append,List.mem_singleton] at hq
    rcases hq with hq|eq
    · rw [prefixFrame.2.2 q (by
        intro low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) low hq)]
      exact clean q (by simp [List.mem_of_mem_drop hq])
    · have qeq : q=last := eq
      rw [qeq,prefixFrame.2.2 last (by
        intro low
        have h := List.nodup_iff_count.mp hn last
        have hp := List.count_pos_iff.mpr (List.mem_of_mem_take low)
        simp only [List.count_cons,List.count_append,List.count_nil,
          beq_self_eq_true,if_true] at h hp
        omega)]
      exact clean last (by simp)
  have upperOld (rec : List Bool) :
      run (Q6LifetimeResearch.compareChain false (as.drop (d+1))
        (bs.drop (d+1)) ((cs.drop (d+1))++[last])
        (carryAfter (d+1) cs cin) target) rec u=
      run (Arithmetic.compareChain none (as.drop (d+1)) (bs.drop (d+1))
        ((cs.drop (d+1))++[last]) (carryAfter (d+1) cs cin) target) [] u := by
    exact Q6LifetimeProof.compare_chain_eq_old false (as.drop (d+1))
      (bs.drop (d+1)) ((cs.drop (d+1))++[last])
      (carryAfter (d+1) cs cin) target tailND tailHab tailHc tailNonempty
      u rec [] cleanU (by simp)
  have upperRun : ∀rec,run U rec u=v := by
    intro rec
    change run U rec u=run U [] u
    rw [upperShape,←compareChain_append_last (as.drop (d+1))
      (bs.drop (d+1)) (cs.drop (d+1)) (carryAfter (d+1) cs cin)
      target last tailHab (by simpa using tailHc) tailNonempty,
      upperOld rec,upperOld []]
  have upperFacts := compareChain_correct none (as.drop (d+1))
    (bs.drop (d+1)) ((cs.drop (d+1))++[last])
    (carryAfter (d+1) cs cin) target tailND (by simp) tailHab tailHc
    u [] cleanU
  have lowAwayUpper : ∀q∈wires U,q∉cs.take d := by
    intro q hq low
    rw [upperShape] at hq
    have used := List.mem_toFinset.mp (compareChain_false_support
      (as.drop (d+1)) (bs.drop (d+1)) (cs.drop (d+1))
      (carryAfter (d+1) cs cin) target hq)
    have lowFull : q∈cs := List.mem_of_mem_take low
    have awayAs : q∉as.drop (d+1) := by
      intro source
      have h := List.nodup_iff_count.mp hn q
      have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop source)
      have hl := List.count_pos_iff.mpr lowFull
      simp only [List.count_cons,List.count_append,List.count_nil] at h hp hl
      omega
    have awayBs : q∉bs.drop (d+1) := by
      intro targetBit
      have h := List.nodup_iff_count.mp hn q
      have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop targetBit)
      have hl := List.count_pos_iff.mpr lowFull
      simp only [List.count_cons,List.count_append,List.count_nil] at h hp hl
      omega
    have awayCs : q∉cs.drop (d+1) := by
      exact fun carry=>List.disjoint_left.mp
        (List.disjoint_take_drop csND (by omega)) low carry
    have awayBoundary : q≠carryAfter (d+1) cs cin := by
      intro eq
      subst q
      exact carryAfter_succ_away d cs cin csND hd low
    have awayFlag : q≠target := by
      intro eq
      subst q
      have ht := List.nodup_iff_count.mp hn target
      have hl := List.count_pos_iff.mpr lowFull
      simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at ht hl
      omega
    simp only [List.mem_append,List.mem_cons,List.mem_singleton,
      List.not_mem_nil,or_false] at used
    tauto
  have upperSame : ∀q∈mappedWires (bits.take d)++bs.take d++cs.take d++[cin],
      v.basis q=u.basis q := by
    intro q hq
    rw [show v=run U [] u from rfl,upperShape,
      ←compareChain_append_last (as.drop (d+1)) (bs.drop (d+1))
        (cs.drop (d+1)) (carryAfter (d+1) cs cin) target last
        tailHab (by simpa using tailHc) tailNonempty,upperOld []]
    apply upperFacts.2.1 q
    intro eq
    subst q
    have h := List.nodup_iff_count.mp hn target
    simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hq
    rcases hq with ((source|lowB)|lowC)|input
    · have hp := List.count_pos_iff.mpr (by
        have z := mappedWires_take_mem d bits target source
        simpa only [bits,mappedRead_wires] using z)
      simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at h hp
      omega
    · have hp := List.count_pos_iff.mpr (List.mem_of_mem_take lowB)
      simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at h hp
      omega
    · have hp := List.count_pos_iff.mpr (List.mem_of_mem_take lowC)
      simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at h hp
      omega
    · have e : target=cin := by simpa using input
      subst target
      simp at hn
  have upperRoleZero : ∀q∈roles.take d,v.basis q=false := by
    intro q hq
    have tail := roleTail q hq
    rw [show v=run U [] u from rfl,upperShape,
      ←compareChain_append_last (as.drop (d+1)) (bs.drop (d+1))
        (cs.drop (d+1)) (carryAfter (d+1) cs cin) target last
        tailHab (by simpa using tailHc) tailNonempty,upperOld []]
    rw [upperFacts.2.1 q (by
      intro eq
      subst q
      have h := List.nodup_iff_count.mp hn target
      have hp := List.count_pos_iff.mpr (List.mem_of_mem_drop tail)
      simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at h hp
      omega),prefixFrame.2.2 q (by
        intro low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) low tail)]
    exact clean q (by simp [List.mem_of_mem_drop tail])
  have wholeRecords (rec : List Bool) :
      run (Q6LifetimeResearch.compareChain false as bs cs cin target) rec s=
        run (Q6LifetimeResearch.compareChain false as bs cs cin target) [] s := by
    have hn' : (target::cin::(as++bs++(cs++[last]))).Nodup := by
      simpa only [List.append_assoc] using hn
    rw [←compareChain_append_last as bs cs cin target last hab hc (by
        intro e
        rw [e] at hc
        simp at hc),
      Q6LifetimeProof.compare_chain_eq_old false as bs (cs++[last]) cin target
        hn' hab (by simpa using hc) (by
          intro e
          rw [e] at hc
          simp at hc) s rec [] clean (by simp),
      Q6LifetimeProof.compare_chain_eq_old false as bs (cs++[last]) cin target
        hn' hab (by simpa using hc) (by
          intro e
          rw [e] at hc
          simp at hc) s [] [] clean (by simp)]
  have wholeRun : ∀rec,run (emitSweep layers topProgram) rec s=out := by
    intro rec
    change run (emitSweep layers topProgram) rec s=
      run (emitSweep layers topProgram) [] s
    rw [←compareChain_as_sweep false as bs cs cin target]
    exact wholeRecords rec
  have replay := emitLoan_mapped_prefix_run_eq d roles layers topProgram bits bs cs cin
    s u v out m n mappedND sourceAway prefixShape eraseShape borrowShape hostShape
    prefixZero prefixRun prefixFrame.2.1 prefixFrame.2.2
    (fun q hq=>clean q (by simp [hq])) roleTail upperRun lowAwayUpper upperSame
    upperRoleZero wholeRun
  rw [←compareChain_as_sweep false as bs cs cin target] at replay
  exact replay

/-! ## Dependent-top raw subtraction -/

/-- The ordinary two-bit top retained by the reference full adder. -/
def addTopOldTop : List Wire → List Wire → List Wire → Wire → Wire → Program
  | [a,a'], [b,z], _, cin, last => addInPlace [a,a'] [b,z] [last] cin
  | _::a'::as, _::b'::bs, c::cs, _, last =>
      addTopOldTop (a'::as) (b'::bs) cs c last
  | _, _, _, _, _ => []

theorem addInPlace_as_addTop_sweep (as bs cs : List Wire) (cin last : Wire)
    (hab : as.length=bs.length) (hc : cs.length+2=as.length) :
    addInPlace as bs (cs++[last]) cin=
      emitSweep (addTopLayers as bs cs cin) (addTopOldTop as bs cs cin last) := by
  induction as generalizing bs cs cin with
  | nil => simp at hc
  | cons a as ih =>
      cases as with
      | nil => simp at hc
      | cons a' as =>
          cases bs with
          | nil => simp at hab
          | cons b bs =>
              cases bs with
              | nil => simp at hab
              | cons b' bs =>
                  cases as with
                  | nil =>
                      have be : bs=[] := List.eq_nil_of_length_eq_zero
                        (by simpa using hab.symm)
                      subst bs
                      have ce : cs=[] := List.eq_nil_of_length_eq_zero (by
                        simp only [List.length_cons,List.length_nil] at hc
                        omega)
                      subst cs
                      rfl
                  | cons a'' as =>
                      cases bs with
                      | nil => simp at hab
                      | cons b'' bs =>
                          cases cs with
                          | nil => simp at hc
                          | cons c cs =>
                              simp only [List.cons_append]
                              simp only [addInPlace,addTopLayers,addTopOldTop,emitSweep,
                                emitUps,emitDowns,CarryLayer.down]
                              rw [ih (b'::b''::bs) cs c (by simpa using hab)
                                (by simpa using hc)]
                              simp [emitSweep,List.append_assoc]

theorem addTopOld_upper_sweep (n : Nat) (as bs cs : List Wire)
    (cin last : Wire) (hab : as.length=bs.length)
    (hc : cs.length+2=as.length) (hn : n≤cs.length) :
    emitSweep ((addTopLayers as bs cs cin).drop n)
        (addTopOldTop as bs cs cin last)=
      addInPlace (as.drop n) (bs.drop n) ((cs.drop n)++[last])
        (carryAfter n cs cin) := by
  induction n generalizing as bs cs cin with
  | zero => exact (addInPlace_as_addTop_sweep as bs cs cin last hab hc).symm
  | succ n ih =>
      cases cs with
      | nil => simp at hn
      | cons c cs =>
          cases as with
          | nil => simp at hc
          | cons a as =>
              cases as with
              | nil => simp at hc
              | cons a' as =>
                  cases as with
                  | nil => simp at hc
                  | cons a'' as =>
                      cases bs with
                      | nil => simp at hab
                      | cons b bs =>
                          cases bs with
                          | nil => simp at hab
                          | cons b' bs =>
                              cases bs with
                              | nil => simp at hab
                              | cons b'' bs =>
                                  simp only [addTopLayers,addTopOldTop,
                                    List.drop_succ_cons,carryAfter]
                                  exact ih (a'::a''::as) (b'::b''::bs) cs c
                                    (by simpa using hab) (by simpa using hc)
                                    (by simpa using hn)

/-- Down-passes below a split touch only the low source, target, and carry
    prefixes (plus the original carry input). -/
theorem addTop_downs_take_support (d : Nat) (as bs cs : List Wire) (cin : Wire)
    (hab : as.length=bs.length) (hc : cs.length+2=as.length) (hd : d≤cs.length) :
    wires (emitDowns ((addTopLayers as bs cs cin).take d)) ⊆
      (as.take d++bs.take d++cs.take d++[cin]).toFinset := by
  induction d generalizing as bs cs cin with
  | zero =>
      intro q hq
      simpa [emitDowns,wires] using hq
  | succ d ih =>
      cases cs with
      | nil => simp at hd
      | cons c cs =>
          cases as with
          | nil => simp at hc
          | cons a as =>
              cases as with
              | nil => simp at hc
              | cons a' as =>
                  cases bs with
                  | nil => simp at hab
                  | cons b bs =>
                      cases bs with
                      | nil => simp at hab
                      | cons b' bs =>
                          cases as with
                          | nil => simp at hc
                          | cons a'' as =>
                              have tail := ih (a'::a''::as) (b'::bs) cs c
                                (by simpa using hab) (by simpa using hc)
                                (by simpa using hd)
                              intro q hq
                              simp only [addTopLayers,List.take_succ_cons,emitDowns,
                                CarryLayer.down,wires_append,Finset.mem_union] at hq
                              simp only [List.take_succ_cons,List.mem_toFinset,
                                List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
                              rcases hq with tailUsed|erase|finish
                              · have h := List.mem_toFinset.mp (tail tailUsed)
                                simp only [List.mem_append,List.mem_cons,
                                  List.not_mem_nil,or_false] at h
                                tauto
                              · rw [eraseCarry_wires] at erase
                                simp only [Finset.mem_insert,Finset.mem_singleton] at erase
                                tauto
                              · simp [wires,Instr.wires] at finish
                                tauto

/-- One nonterminal dependent-top layer. -/
theorem addTop_step (a a' b b' c cin : Wire) (as bs cs : List Wire)
    (notLast : ¬(as=[] ∧ bs=[])) :
    Q6LifetimeResearch.addTop (a::a'::as) (b::b'::bs) (c::cs) cin=
      majority a b cin c++Q6LifetimeResearch.addTop (a'::as) (b'::bs) cs c++
        eraseCarry a b cin c++[.CX a b,.CX cin b] := by
  cases as <;> cases bs <;> first | rfl | exact (notLast ⟨rfl,rfl⟩).elim

/-- Public support form of the dependent-top recursion. -/
theorem addTop_support (as bs cs : List Wire) (cin : Wire) :
    wires (Q6LifetimeResearch.addTop as bs cs cin) ⊆
      (cin::(as++bs++cs)).toFinset := by
  induction as generalizing bs cs cin with
  | nil => simp [Q6LifetimeResearch.addTop,wires]
  | cons a as ih =>
      cases as with
      | nil => cases bs <;> simp [Q6LifetimeResearch.addTop,wires]
      | cons a' as =>
          cases bs with
          | nil => simp [Q6LifetimeResearch.addTop,wires]
          | cons b bs =>
              cases bs with
              | nil => simp [Q6LifetimeResearch.addTop,wires]
              | cons b' bs =>
                  by_cases last : as=[] ∧ bs=[]
                  · rcases last with ⟨rfl,rfl⟩
                    intro q used
                    simp [Q6LifetimeResearch.addTop,Q6LifetimeResearch.dependentTop,
                      wires,Instr.wires,correctionWires] at used ⊢
                    tauto
                  · cases cs with
                    | nil =>
                        cases as <;> cases bs <;>
                          simp_all [Q6LifetimeResearch.addTop,wires]
                    | cons c cs =>
                        have child := ih (b'::bs) cs c
                        rw [addTop_step a a' b b' c cin as bs cs last]
                        intro q used
                        simp only [wires_append,Finset.mem_union] at used
                        simp only [List.mem_toFinset,List.mem_cons,List.mem_append]
                        rcases used with ((head|tail)|finish)|sum
                        · simp [majority,wires,Instr.wires] at head
                          tauto
                        · have h := List.mem_toFinset.mp (child tail)
                          simp only [List.mem_cons,List.mem_append] at h
                          tauto
                        · rw [eraseCarry_wires] at finish
                          simp only [Finset.mem_insert,Finset.mem_singleton] at finish
                          tauto
                        · simp [wires,Instr.wires] at sum
                          tauto

/-- Full-State replay for the dependent-top adder.  Its only arithmetic
    premise is the top-copy relation already established for the ordinary
    complete adder. -/
theorem addTopLoan_run_eq (d : Nat) (roles x y cs : List Wire)
    (a t z last cin : Wire) (s : State) (m n : List Bool)
    (hy : y.length=x.length) (hc : cs.length=x.length)
    (hd : d+1≤cs.length)
    (hn : (x++[a]++y++[t,z]++cs++[last,cin]).Nodup)
    (clean : ∀q∈cs++[last],s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1))
    (post : (run (addInPlace (x++[a,a]) (y++[t,z]) (cs++[last]) cin) n s).basis z=
      (run (addInPlace (x++[a,a]) (y++[t,z]) (cs++[last]) cin) n s).basis t) :
    run (addTopLoan d roles (x++[a,a]) (y++[t,z]) cs cin) m s=
      run (Q6LifetimeResearch.addTop (x++[a,a]) (y++[t,z]) cs cin) n s := by
  let as := x++[a,a]
  let bs := y++[t,z]
  let bits := mappedRead as false
  let layers := addTopLayers as bs cs cin
  let topProgram := addTopTop as bs cs cin
  let oldTop := addTopOldTop as bs cs cin last
  let P := emitUps (layers.take (d+1))
  let U := emitSweep (layers.drop (d+1)) topProgram
  let Uold := emitSweep (layers.drop (d+1)) oldTop
  let S := emitDowns (layers.take (d+1))
  let u := run P [] s
  let v := run U [] u
  let out := run (emitSweep layers topProgram) [] s
  have hab : as.length=bs.length := by simp only [as,bs,List.length_append,
    List.length_cons,List.length_nil,hy]
  have hca : cs.length+2=as.length := by simp only [as,List.length_append,
    List.length_cons,List.length_nil,hc]
  have bitsLength : bits.length=bs.length := by simp only [bits,mappedRead_length,hab]
  have mappedND : (cin::(bs++cs)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [as,bs,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have sourceAway : ∀q∈mappedWires bits,q∉cin::(bs++cs) := by
    intro q hq bad
    have source : q∈x++[a] := by
      simp only [bits,as,mappedRead_wires,List.mem_append,List.mem_cons,
        List.not_mem_nil,or_false,or_self] at hq ⊢
      exact hq
    have h := List.nodup_iff_count.mp hn q
    have hs := List.count_pos_iff.mpr source
    simp only [bs,List.mem_cons,List.mem_append] at bad
    rcases bad with rfl|bad|bad
    · simp only [List.count_cons,List.count_append,List.count_nil,
        beq_self_eq_true,if_true] at h hs
      omega
    · have hp := List.count_pos_iff.mpr (show q∈y++[t,z] by simpa using bad)
      simp only [List.count_cons,List.count_append,List.count_nil] at h hs hp
      omega
    · have hp := List.count_pos_iff.mpr bad
      simp only [List.count_cons,List.count_append,List.count_nil] at h hs hp
      omega
  have prefixShapes := addTop_prefix_shapes (d+1) as bs cs cin hab hca hd
  have borrowShapes := addTop_prefix_shapes d as bs cs cin hab hca (by omega)
  have prefixShape : P=carryPrefix (d+1) bits bs cs cin := prefixShapes.1
  have eraseShape : emitErases (layers.take d)=erasePrefix d bits bs cs cin :=
    borrowShapes.2.1
  have borrowShape : emitUps (layers.take d)=carryPrefix d bits bs cs cin :=
