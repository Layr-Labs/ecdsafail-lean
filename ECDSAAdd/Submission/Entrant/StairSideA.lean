def firstRestZFront : Program :=
  triple 2 3 4 d3short ++ triple 1 3 4 e3short ++ cellWith true (P1Life.dstart (base 760) base (base 2409)) 0 2 4 ++
  triple 1 3 4 d3 ++ triple 4 1 2 e3 ++ cell true 0 3 2 ++
