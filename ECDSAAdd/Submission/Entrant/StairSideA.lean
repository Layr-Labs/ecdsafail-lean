section Merge_StairRestSupportBase_at_StairSideA

/-!
# Support of the hosted rests, part 1: the label domain and its maps

`InDom q` says that `q` is one of the 2,326 raw labels on which the record
placement `wireFn2` is injective (`StairPlacedDomain.placedDomain`).  Every
rename that occurs inside the hosted rests maps this domain into itself, so
support is propagated compositionally; raw pieces are checked once.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairRestSupport

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField






theorem indom_base (i : Nat) (h : i < 2314) : InDom (base i) := by
  simp only [InDom, InDomN, MappedCompressed.base]
  omega

theorem placed_of_indom {q : Wire} (h : InDom q) :
    q ∈ StairPlacedDomain.placedDomain := by
  show q ∈ (MappedCompressed.pointIndexSites.map base).toFinset
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨q - 16, ?_, ?_⟩
  · simp only [MappedCompressed.pointIndexSites, List.mem_append, List.mem_range'_1]
    simp only [InDom, InDomN] at h
    omega
  · have key : ∀ n : Nat, InDomN n → n - 16 + 16 = n := by
      intro n hn
      unfold InDomN at hn
      omega
    exact key q h

theorem placed_of_good {P : Program} (h : Good P) :
    wires P ⊆ StairPlacedDomain.placedDomain :=
  fun q hq => placed_of_indom (h q hq)

theorem good_append {P Q : Program} : Good (P ++ Q) ↔ Good P ∧ Good Q := by
  simp only [Good, wires_append, Finset.mem_union]
  constructor
  · intro h
    exact ⟨fun q hq => h q (Or.inl hq), fun q hq => h q (Or.inr hq)⟩
  · rintro ⟨h1, h2⟩ q (hq | hq)
    · exact h1 q hq
    · exact h2 q hq

theorem good_nil : Good ([] : Program) := by
  intro q hq
  simp [wires] at hq

theorem good_rename (f : Wire → Wire) (hf : ∀ q, InDom q → InDom (f q))
    {P : Program} (hP : Good P) : Good (renameProgram f P) := by
  intro q hq
  rw [renameProgram_support] at hq
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hq
  exact hf a (hP a ha)

theorem good_unrename (f : Wire → Wire) (hf : ∀ q, InDom (f q) → InDom q)
    {P : Program} (h : Good (renameProgram f P)) : Good P := by
  intro q hq
  apply hf
  apply h
  rw [renameProgram_support]
  exact Finset.mem_image.mpr ⟨q, hq, rfl⟩

theorem good_of_logical {P : Program} (h : wires P ⊆ OB5Support.logicalSites) :
    Good P := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp (h hq))
  simp only [OB5Support.logicalIndices, List.mem_append, List.mem_range'_1,
    List.mem_cons, List.not_mem_nil, or_false] at hi
  simp only [InDom, InDomN, MappedCompressed.base]
  omega

theorem good_of_subset {P Q : Program} (h : wires P ⊆ wires Q) (hQ : Good Q) :
    Good P :=
  fun q hq => hQ q (h hq)


/-! ## Domain-preserving maps -/

theorem indom_swap (a b : Wire) (ha : InDom a) (hb : InDom b) :
    ∀ q, InDom q → InDom (Equiv.swap a b q) := by
  intro q hq
  rw [Equiv.swap_apply_def]
  split_ifs
  · exact hb
  · exact ha
  · exact hq

theorem indom_swap_inv (a b : Wire) (ha : InDom a) (hb : InDom b) :
    ∀ q, InDom (Equiv.swap a b q) → InDom q := by
  intro q hq
  have h := indom_swap a b ha hb _ hq
  rwa [Equiv.swap_apply_self] at h

theorem good_swap (a b : Wire) (ha : InDom a) (hb : InDom b) {P : Program}
    (hP : Good P) : Good (renameProgram (Equiv.swap a b) P) :=
  good_rename _ (indom_swap a b ha hb) hP


theorem indom_phaseHost : ∀ q, InDom q → InDom (Rolling1588Lifetime.phaseHost q) := by
  intro q hq
  simp only [Rolling1588Lifetime.phaseHost, Equiv.trans_apply]
  exact indom_swap (base 1542) (base 720) (by decide) (by decide) _
    (indom_swap (base 1541) (base 722) (by decide) (by decide) _
      (indom_swap (base 1026) (base 721) (by decide) (by decide) q hq))

theorem indom_phaseHost_inv : ∀ q, InDom (Rolling1588Lifetime.phaseHost q) → InDom q := by
  intro q hq
  simp only [Rolling1588Lifetime.phaseHost, Equiv.trans_apply] at hq
  exact indom_swap_inv (base 1026) (base 721) (by decide) (by decide) q
    (indom_swap_inv (base 1541) (base 722) (by decide) (by decide) _
      (indom_swap_inv (base 1542) (base 720) (by decide) (by decide) _ hq))

theorem indom_borrow : ∀ q, InDom q → InDom (Prefix1590.borrow q) := by
  intro q hq
  exact indom_swap (base 768) (base 0) (by decide) (by decide) q hq

theorem indom_borrow_inv : ∀ q, InDom (Prefix1590.borrow q) → InDom q := by
  intro q hq
  exact indom_swap_inv (base 768) (base 0) (by decide) (by decide) q hq

theorem indom_hostSwap : ∀ q, InDom q → InDom (HostOB5.hostSwap q) := by
  intro q hq
  unfold HostOB5.hostSwap
  split_ifs
  all_goals first | exact hq | decide

theorem indom_hostSwap_inv : ∀ q, InDom (HostOB5.hostSwap q) → InDom q := by
  intro q hq
  have h := indom_hostSwap _ hq
  rwa [HostOB5.hostSwap_invol] at h

theorem indom_parity : ∀ q, InDom q →
    InDom (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host q) :=
  indom_swap FrontierEntry1591Field.work FrontierEntry1591Field.host
    (by decide) (by decide)

theorem indom_parity_inv : ∀ q,
    InDom (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host q) →
      InDom q :=
  indom_swap_inv FrontierEntry1591Field.work FrontierEntry1591Field.host
    (by decide) (by decide)

theorem good_fieldRename {P : Program} (hP : Good P) :
    Good (StairSchedule.fieldRename P) :=
  good_rename _ indom_parity (good_rename _ indom_hostSwap hP)


private theorem sigN (i n : Nat) (hi : i ≤ 1000) (hn : InDomN n) :
    InDomN (if (1301 ≤ n ∧ n ≤ 1044 + i) ∨ (2069 ≤ n + i ∧ n ≤ 1812)
      then 3113 - n else n) := by
  unfold InDomN at hn ⊢
  split_ifs <;> omega

private theorem sigN_inv (i n : Nat) (hi : i ≤ 1000)
    (hn : InDomN (if (1301 ≤ n ∧ n ≤ 1044 + i) ∨ (2069 ≤ n + i ∧ n ≤ 1812)
      then 3113 - n else n)) : InDomN n := by
  unfold InDomN at hn ⊢
  split_ifs at hn <;> omega

theorem indom_sig (i : Nat) (hi : i ≤ 1000) : ∀ q, InDom q → InDom (OB5.sig i q) :=
  fun q hq => sigN i q hi hq

theorem indom_sig_inv (i : Nat) (hi : i ≤ 1000) : ∀ q, InDom (OB5.sig i q) → InDom q :=
  fun q hq => sigN_inv i q hi hq

private theorem swap_low (a b : Nat) (ha : a < 2314) (hb : b < 2314) (x : Nat) :
    (x < 2314 → Equiv.swap a b x < 2314) ∧ (2314 ≤ x → Equiv.swap a b x = x) := by
  rw [Equiv.swap_apply_def]
  constructor
  · intro hx
    split_ifs <;> omega
  · intro hx
    split_ifs <;> omega

private theorem pi0_low (x : Nat) :
    (x < 2314 → Placement5.pi0 x < 2314) ∧ (2314 ≤ x → Placement5.pi0 x = x) := by
  by_cases hz : Placement5.zeroRegion x
  · rcases hz with hw | hh
    · have hk : x - 515 < 204 := by unfold Placement5.workRegion at hw; omega
      have hx : x = Placement5.W (x - 515) := by
        unfold Placement5.workRegion at hw; unfold Placement5.W; omega
      have hb := Placement5.H_bound (x - 515) hk
      have hwx : x ≤ 718 := by unfold Placement5.workRegion at hw; omega
      constructor
      · intro _
        rw [hx, Placement5.pi0_W _ hk]
        omega
      · intro h2
        omega
    · have hrec := Placement5.hole_recover x hh
      have hb := Placement5.W_bound _ hrec.1
      have hx1 : x ≤ 1537 := by unfold Placement5.holeRegion at hh; omega
      constructor
      · intro _
        rw [← hrec.2, Placement5.pi0_H _ hrec.1]
        omega
      · intro h2
        omega
  · have e := Placement5.pi0_outside x hz
    rw [e]
    exact ⟨id, fun _ => rfl⟩

theorem pi_low (j : Nat) (hj : j < 102) (x : Nat) :
    (x < 2314 → Placement5.pi j x < 2314) ∧
      (2314 ≤ x → Placement5.pi j x = x) := by
  have w0 : Placement5.W (2 * j) < 2314 := by unfold Placement5.W; omega
  have w1 : Placement5.W (2 * j + 1) < 2314 := by unfold Placement5.W; omega
  have h0 : Placement5.H (2 * j) < 2314 := by unfold Placement5.H; omega
  have h1 : Placement5.H (2 * j + 1) < 2314 := by unfold Placement5.H; omega
  have h2 : Placement5.H 202 < 2314 := by unfold Placement5.H; omega
  have h3 : Placement5.H 203 < 2314 := by unfold Placement5.H; omega
  simp only [Placement5.pi, Equiv.trans_apply]
  have s1 := swap_low _ _ w0 h0 x
  have s2 := swap_low _ _ w1 h1 (Equiv.swap (Placement5.W (2 * j)) (Placement5.H (2 * j)) x)
  have s3 := swap_low _ _ h0 h2
    (Equiv.swap (Placement5.W (2 * j + 1)) (Placement5.H (2 * j + 1))
      (Equiv.swap (Placement5.W (2 * j)) (Placement5.H (2 * j)) x))
  have s4 := swap_low _ _ h1 h3
    (Equiv.swap (Placement5.H (2 * j)) (Placement5.H 202)
      (Equiv.swap (Placement5.W (2 * j + 1)) (Placement5.H (2 * j + 1))
        (Equiv.swap (Placement5.W (2 * j)) (Placement5.H (2 * j)) x)))
  have s5 := pi0_low
    (Equiv.swap (Placement5.H (2 * j + 1)) (Placement5.H 203)
      (Equiv.swap (Placement5.H (2 * j)) (Placement5.H 202)
        (Equiv.swap (Placement5.W (2 * j + 1)) (Placement5.H (2 * j + 1))
          (Equiv.swap (Placement5.W (2 * j)) (Placement5.H (2 * j)) x))))
  constructor
  · intro hx
    exact s5.1 (s4.1 (s3.1 (s2.1 (s1.1 hx))))
  · intro hx
    rw [(swap_low _ _ w0 h0 x).2 hx, (swap_low _ _ w1 h1 x).2 hx,
      (swap_low _ _ h0 h2 x).2 hx, (swap_low _ _ h1 h3 x).2 hx]
    exact (pi0_low x).2 hx

private theorem shifted_low (e : Equiv.Perm Nat)
    (he : ∀ x, (x < 2314 → e x < 2314) ∧ (2314 ≤ x → e x = x)) :
    ∀ q, InDom q → InDom (shifted e q) := by
  intro q hq
  show InDom (shiftedFn e q)
  unfold shiftedFn
  simp only [InDom, InDomN] at hq ⊢
  have h := he (q - 16)
  split_ifs with hs
  · omega
  · rcases hq with hq | hq
    · have := h.1 (by omega)
      omega
    · have := h.2 (by omega)
      omega

private theorem shifted_low_inv (e : Equiv.Perm Nat)
    (he : ∀ x, (x < 2314 → e x < 2314) ∧ (2314 ≤ x → e x = x)) :
    ∀ q, InDom (shifted e q) → InDom q := by
  intro q hq
  change InDom (shiftedFn e q) at hq
  unfold shiftedFn at hq
  simp only [InDom, InDomN] at hq ⊢
  have h := he (q - 16)
  split_ifs at hq with hs
  · omega
  · by_cases big : 2314 ≤ q - 16
    · have := h.2 big
      omega
    · omega

theorem indom_shifted_pi (j : Nat) (hj : j < 102) :
    ∀ q, InDom q → InDom (shifted (Placement5.pi j) q) :=
  shifted_low _ (pi_low j hj)

theorem indom_shifted_pi_inv (j : Nat) (hj : j < 102) :
    ∀ q, InDom (shifted (Placement5.pi j) q) → InDom q :=
  shifted_low_inv _ (pi_low j hj)




theorem good_rebindMany (roles : List Wire) :
    ∀ (hosts : List Wire) (P : Program), (∀ r ∈ roles, InDom r) →
      (∀ h ∈ hosts, InDom h) → Good P → Good (StairLoan.rebindMany roles hosts P) := by
  induction roles with
  | nil =>
    intro hosts P _ _ hP
    cases hosts <;> exact hP
  | cons r rs ih =>
    intro hosts P hr hh hP
    cases hosts with
    | nil => exact hP
    | cons h hs =>
      exact good_swap r h (hr r (by simp)) (hh h (by simp))
        (ih hs P (fun x hx => hr x (by simp [hx])) (fun x hx => hh x (by simp [hx])) hP)





/-! ## Moved first-tick map -/







/-- History-letter labels of the packet coded at tick `i`. -/
theorem history_indom (w : Nat → Wire) (start : Nat)
    (hw : ∀ x, (x ≤ 513 ∨ (1028 ≤ x ∧ x < 1540)) → InDom (w x))
    (hs : start + 5 ≤ 512) (p : Program)
    (hp : p = History5.encode w start ∨ p = History5.decode w start) : Good p := by
  intro q hq
  obtain ⟨j, rfl⟩ := History5.history_gate_mem w start p hp q hq
  have hj := j.isLt
  apply hw
  unfold History5.historyId
  split_ifs <;> omega

theorem good_packFirst (w : Nat → Wire) (i : Nat) (h5 : 5 < i) (hi : i < 512)
    (hw : ∀ x, (x ≤ 513 ∨ (1028 ≤ x ∧ x < 1540)) → InDom (w x)) :
    Good (Rolling1588.Integer.packFirst w true i) := by
  have hne : i ≠ 5 := by omega
  intro q hq
  simp only [Rolling1588.Integer.packFirst, if_neg hne] at hq
  rw [Rolling1588.Integer.pack_support_eq] at hq
  unfold History5.packAfter at hq
  split_ifs at hq with due
  · exact history_indom w (i - 5) hw (by omega) _ (Or.inl rfl) q hq
  · simp [wires] at hq

theorem good_unpackFirst (w : Nat → Wire) (i : Nat) (h5 : 5 < i) (hi : i < 512)
    (hw : ∀ x, (x ≤ 513 ∨ (1028 ≤ x ∧ x < 1540)) → InDom (w x)) :
    Good (Rolling1588.Integer.unpackFirst w true i) := by
  have hne : i ≠ 5 := by omega
  intro q hq
  simp only [Rolling1588.Integer.unpackFirst, if_neg hne] at hq
  rw [Rolling1588.Integer.decodeBefore_support_eq] at hq
  unfold History5.decodeBefore at hq
  split_ifs at hq with due
  · exact history_indom w (i - 5) hw (by omega) _ (Or.inr rfl) q hq
  · simp [wires] at hq


theorem base_history_indom :
    ∀ x, (x ≤ 513 ∨ (1028 ≤ x ∧ x < 1540)) → InDom (base x) := by
  intro x hx
  exact indom_base x (by omega)



/-! ## Extraction from record walks and packet sequences -/


theorem reverse_append (isA : Bool) (n : Nat) :
    ∀ i m, Rolling1588.reverse isA i (n + m) =
      Rolling1588.reverse isA (i + n) m ++ Rolling1588.reverse isA i n := by
  induction n with
  | zero =>
    intro i m
    simp [Rolling1588.reverse]
  | succ n ih =>
    intro i m
    rw [show n + 1 + m = (n + m) + 1 by omega]
    simp only [Rolling1588.reverse, ih (i + 1) m, List.append_assoc]
    all_goals rw [show i + 1 + n = i + (n + 1) by omega]

theorem good_program_parts (fw : Bool) (p : Nat → Program) (n : Nat) :
    ∀ j, Good (PacketSequence.program fw p j n) →
      ∀ i, j ≤ i → i < j + n → Good (p i) := by
  induction n with
  | zero =>
    intro j _ i h1 h2
    omega
  | succ n ih =>
    intro j h i h1 h2
    have e : PacketSequence.program fw p j (n + 1) =
        if fw then p j ++ PacketSequence.program fw p (j + 1) n
        else PacketSequence.program fw p (j + 1) n ++ p j := rfl
    rw [e] at h
    have hh : Good (p j) ∧ Good (PacketSequence.program fw p (j + 1) n) := by
      cases fw
      · simp only [Bool.false_eq_true, if_false, good_append] at h
        exact ⟨h.2, h.1⟩
      · simp only [if_true, good_append] at h
        exact h
    by_cases hij : i = j
    · subst hij
      exact hh.1
    · exact ih (j + 1) hh.2 i (by omega) (by omega)

theorem good_program_of_parts (fw : Bool) (p : Nat → Program) (n : Nat) :
    ∀ j, (∀ i, j ≤ i → i < j + n → Good (p i)) →
      Good (PacketSequence.program fw p j n) := by
  induction n with
  | zero =>
    intro j _
    exact good_nil
  | succ n ih =>
    intro j h
    have e : PacketSequence.program fw p j (n + 1) =
        if fw then p j ++ PacketSequence.program fw p (j + 1) n
        else PacketSequence.program fw p (j + 1) n ++ p j := rfl
    rw [e]
    have a := h j (by omega) (by omega)
    have b := ih (j + 1) (fun i h1 h2 => h i (by omega) (by omega))
    cases fw
    · simp only [Bool.false_eq_true, if_false, good_append]
      exact ⟨b, a⟩
    · simp only [if_true, good_append]
      exact ⟨a, b⟩

end ECDSAAdd.Entrant.StairRestSupport

end
