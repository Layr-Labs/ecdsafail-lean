    rw [← hs1] at B
    exact window_agree _ s1 _ B clean codes.2.2 z768 q hE hP
  · rw [StairRename.rename_run_conjugate (OB5.sig 511)
        (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
      StairRename.rename_run_conjugate (OB5.sig 511)
        (OB5.sig_injective 511 (by omega)) (OB5.sig_invol 511 (by omega)),
      StairLoanRecordShape.forward_slices_run_eq half L 1 hL origin' ctx' enabled' _ _ _ cut
        a b]
















