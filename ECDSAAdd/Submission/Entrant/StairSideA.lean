section Merge_StairField13V3_at_StairSideA

/-!
# Field 13 (host replay) on CANON v3 (LT25)

On the v3 program the hosted kernels `StairHostsSchedule.entryKernel/exitKernel
checkpointPrimitives hostPlan` differ from the logical kernels
`StairSchedule.entryKernel/exitKernel checkpointPrimitives bestLoans` in exactly
eight slots per kernel: the seven packet groups (deficits 0/14/23/31/37/42/44),
each `rebindMany (exclusiveRoles.drop d) (hostPlan.group …)` of the logical
group, and the first packet, `rebindMany exclusiveRoles (hosts 87)` of the
logical first packet.  Every other piece (phases, segments, terminals, parity
setup / hosted X, endpoints, copy, canon, center, scratch window, `x1N`) is
literally the same program.

A `rebindMany` slot is a wire permutation of the logical piece which moves only
the listed roles and hosts, so it computes the logical piece exactly when those
wires are zero before and after the piece.  This module

* proves that generically (`rebindMany_run_eq_of_clean`, `rename_rebindMany`,
  `slot_local`);
* gives a same-tape chain over an explicit piece list (`Piece`, `Cuts`,
  `run_eq_of_cuts`) whose only obligations are zero bits of the LOGICAL kernel
  at the cut before and after each hosted slot (`CutClean`);
* fixes the exact 25-piece lists of both kernels (`entryPieces`,
  `exitPieces`) and proves they concatenate to the kernels for every primitive
  provider and host plan (`entryPieces_hosted`, `entryPieces_logical`, …);
* concludes field 13 (`StairCertificate.HostReplaySpec concreteAssembly`)
  from the slot cleanliness facts plus field 7 (`LoanReplaySpec`, which
  supplies tape freedom of the logical kernel): `hostReplaySpec_of_slots`.

No hypothesis states a run equality of a hosted kernel.  The x-flag is NOT an
issue on v3: `x1N` is not hosted (`StairHostsSchedule.lastXN` =
`StairSchedule.lastXN`), so the exact `HostReplaySpec` is the right field-13
statement (LT9's `FlagHostReplaySpec A pkP`); a later re-host of `x1N` / the
phases composes with LT9's `kernel_rehost(X)_run_eq`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField13V3

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

attribute [local irreducible] run

/-! ## Swaps and `rebindMany` on clean wires -/

theorem pullState_swap_clean (a b : Wire) (s : State)
    (ha : s.basis a = false) (hb : s.basis b = false) :
    pullState (Equiv.swap a b) s = s := by
  refine State.extensionality _ _ rfl (funext fun q => ?_)
  show s.basis (Equiv.swap a b q) = s.basis q
  rcases eq_or_ne q a with rfl | h1
  · rw [Equiv.swap_apply_left, ha, hb]
  · rcases eq_or_ne q b with rfl | h2
    · rw [Equiv.swap_apply_right, ha, hb]
    · rw [Equiv.swap_apply_of_ne_of_ne h1 h2]

theorem pullState_swap_swap (a b : Wire) (s : State) :
    pullState (Equiv.swap a b) (pullState (Equiv.swap a b) s) = s := by
  refine State.extensionality _ _ rfl (funext fun q => ?_)
  show s.basis (Equiv.swap a b (Equiv.swap a b q)) = s.basis q
  rw [Equiv.swap_apply_self]

/-- One swap of two wires that are zero before and after the piece is
invisible. -/
theorem run_swap_eq_of_clean (a b : Wire) (P : Program) (m : List Bool)
    (s : State) (h0a : s.basis a = false) (h0b : s.basis b = false)
    (h1a : (run P m s).basis a = false) (h1b : (run P m s).basis b = false) :
    run (renameProgram (Equiv.swap a b) P) m s = run P m s := by
  have r := run_rename (Equiv.swap a b) (Equiv.swap a b).injective P m s
  rw [pullState_swap_clean a b s h0a h0b] at r
  have e := congrArg (pullState (Equiv.swap a b)) r
  rw [pullState_swap_swap] at e
  rw [e, pullState_swap_clean a b _ h1a h1b]

theorem mem_cons_append_left {r h q : Wire} {rs hs : List Wire}
    (hq : q ∈ rs ++ hs) : q ∈ (r :: rs) ++ (h :: hs) := by
  simp only [List.mem_append, List.mem_cons] at hq ⊢
  tauto

/-- `rebindMany` is invisible when every rebound role and host is zero before
and after the logical piece. -/
theorem rebindMany_run_eq_of_clean :
    ∀ (rs hs : List Wire) (P : Program) (m : List Bool) (s : State),
      (∀ q ∈ rs ++ hs, s.basis q = false) →
      (∀ q ∈ rs ++ hs, (run P m s).basis q = false) →
      run (StairLoan.rebindMany rs hs P) m s = run P m s
  | [], hs, P, m, s, _, _ => by cases hs <;> rfl
  | _ :: _, [], P, m, s, _, _ => rfl
  | r :: rs, h :: hs, P, m, s, c0, c1 => by
    have ih := rebindMany_run_eq_of_clean rs hs P m s
      (fun q hq => c0 q (mem_cons_append_left hq))
      (fun q hq => c1 q (mem_cons_append_left hq))
    show run (renameProgram (Equiv.swap r h) (StairLoan.rebindMany rs hs P)) m s =
      run P m s
    have mr : r ∈ (r :: rs) ++ (h :: hs) := by simp
    have mh : h ∈ (r :: rs) ++ (h :: hs) := by simp
    rw [run_swap_eq_of_clean r h _ m s (c0 r mr) (c0 h mh)
      (by rw [ih]; exact c1 r mr) (by rw [ih]; exact c1 h mh), ih]

theorem comp_swap (F : Wire → Wire) (hF : Function.Injective F) (a b : Wire) :
    F ∘ (Equiv.swap a b : Wire → Wire) =
      (Equiv.swap (F a) (F b) : Wire → Wire) ∘ F := by
  funext x
  simp only [Function.comp_apply]
  rcases eq_or_ne x a with rfl | h1
  · rw [Equiv.swap_apply_left, Equiv.swap_apply_left]
  · rcases eq_or_ne x b with rfl | h2
    · rw [Equiv.swap_apply_right, Equiv.swap_apply_right]
    · rw [Equiv.swap_apply_of_ne_of_ne h1 h2,
        Equiv.swap_apply_of_ne_of_ne (hF.ne h1) (hF.ne h2)]

/-- An injective outer rename transports a `rebindMany`. -/
theorem rename_rebindMany (F : Wire → Wire) (hF : Function.Injective F) :
    ∀ (rs hs : List Wire) (P : Program),
      renameProgram F (StairLoan.rebindMany rs hs P) =
        StairLoan.rebindMany (rs.map F) (hs.map F) (renameProgram F P)
  | [], hs, P => by cases hs <;> rfl
  | _ :: _, [], P => rfl
  | r :: rs, h :: hs, P => by
    show renameProgram F (renameProgram (Equiv.swap r h)
        (StairLoan.rebindMany rs hs P)) =
      renameProgram (Equiv.swap (F r) (F h))
        (StairLoan.rebindMany (rs.map F) (hs.map F) (renameProgram F P))
    rw [renameProgram_comp, comp_swap F hF, ← renameProgram_comp,
      rename_rebindMany F hF rs hs P]

theorem rename_append (f : Wire → Wire) (a b : Program) :
    renameProgram f (a ++ b) = renameProgram f a ++ renameProgram f b := by
  unfold renameProgram
  exact List.map_append

/-! ## Kernel coordinates of the field and of the borrowed low field -/

/-- The field rename `StairSchedule.fieldRename` as one wire map. -/
def fieldMap (q : Wire) : Wire :=
  (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
    (HostOB5.hostSwap q)

theorem fieldMap_injective : Function.Injective fieldMap :=
  (Equiv.injective _).comp HostOB5.hostSwap_injective

theorem fieldRename_eq (P : Program) :
    StairSchedule.fieldRename P = renameProgram fieldMap P := by
  unfold StairSchedule.fieldRename StairSchedule.parityRename
  rw [renameProgram_comp]
  rfl

theorem fieldRename_append (a b : Program) :
    StairSchedule.fieldRename (a ++ b) =
      StairSchedule.fieldRename a ++ StairSchedule.fieldRename b := by
  rw [fieldRename_eq, fieldRename_eq, fieldRename_eq, rename_append]

/-- Kernel coordinates of the borrowed low field (groups, segments,
endpoints, copy, canon, center): `StairSchedule.fieldRename ∘ Prefix1590.borrow`. -/
def lowMap (q : Wire) : Wire := fieldMap (Prefix1590.borrow q)

theorem lowMap_injective : Function.Injective lowMap :=
  fieldMap_injective.comp (Equiv.injective _)

theorem lowRename_eq (P : Program) :
    StairSchedule.fieldRename (renameProgram Prefix1590.borrow P) =
      renameProgram lowMap P := by
  rw [fieldRename_eq, renameProgram_comp]
  rfl

/-! ## Same-tape chain over a piece list -/

/-- One position of a kernel: hosted piece `H`, logical piece `L`, and the
wires `moved` that the hosting relabels (empty for a common piece). -/
structure Piece where
  H : Program
  L : Program
  moved : List Wire

/-- `H` computes `L` (same tape) whenever the moved wires are zero before and
after `L`; same measurement count. -/
structure Piece.Local (pc : Piece) : Prop where
  counts : measurementCount pc.H = measurementCount pc.L
  run_eq : ∀ (m : List Bool) (s : State), (∀ q ∈ pc.moved, s.basis q = false) →
      (∀ q ∈ pc.moved, (run pc.L m s).basis q = false) →
      run pc.H m s = run pc.L m s

/-- A piece that is the same program in both kernels. -/
def common (P : Program) : Piece := ⟨P, P, []⟩

theorem common_local (P : Program) : (common P).Local :=
  ⟨rfl, fun _ _ _ _ => rfl⟩

/-- A hosted slot in coordinates `F`: the kernel contains
`renameProgram F (rebindMany rs hs P)` where the logical kernel contains
`renameProgram F P`. -/
def slot (F : Wire → Wire) (rs hs : List Wire) (P : Program) : Piece :=
  ⟨renameProgram F (StairLoan.rebindMany rs hs P), renameProgram F P,
    (rs ++ hs).map F⟩

theorem slot_local (F : Wire → Wire) (hF : Function.Injective F)
    (rs hs : List Wire) (P : Program) : (slot F rs hs P).Local := by
  refine ⟨?_, fun m s c0 c1 => ?_⟩
  · show measurementCount (renameProgram F (StairLoan.rebindMany rs hs P)) =
      measurementCount (renameProgram F P)
    rw [rename_rebindMany F hF]
    exact (StairLoan.rebindMany_counts _ _ _).2
  · show run (renameProgram F (StairLoan.rebindMany rs hs P)) m s =
      run (renameProgram F P) m s
    rw [rename_rebindMany F hF]
    refine rebindMany_run_eq_of_clean _ _ _ m s (fun q hq => ?_) (fun q hq => ?_)
    · exact c0 q (by rw [← List.map_append] at hq; exact hq)
    · exact c1 q (by rw [← List.map_append] at hq; exact hq)


theorem cutClean_nil (pre : State → Prop) (X : Program) : CutClean pre X [] := by
  intro _ _ _ q hq
  simp at hq

/-- Cut obligations along a piece list after the logical prefix `X`. -/
def Cuts (pre : State → Prop) : Program → List Piece → Prop
  | _, [] => True
  | X, pc :: ps => CutClean pre X pc.moved ∧ CutClean pre (X ++ pc.L) pc.moved ∧
      Cuts pre (X ++ pc.L) ps

theorem run_eq_of_cuts (pre : State → Prop) :
    ∀ (ps : List Piece) (X : Program), (∀ pc ∈ ps, pc.Local) → Cuts pre X ps →
      ∀ s, pre s → ∀ m : List Bool,
        run (X ++ (ps.map Piece.H).flatten) m s =
          run (X ++ (ps.map Piece.L).flatten) m s
  | [], _, _, _, _, _, _ => rfl
  | pc :: ps, X, loc, cs, s, hs, m => by
    have cs' : CutClean pre X pc.moved ∧ CutClean pre (X ++ pc.L) pc.moved ∧
        Cuts pre (X ++ pc.L) ps := cs
    obtain ⟨c0, c1, c⟩ := cs'
    simp only [List.map_cons, List.flatten_cons]
    rw [← List.append_assoc, ← List.append_assoc,
      ← run_eq_of_cuts pre ps (X ++ pc.L) (fun q hq => loc q (by simp [hq]))
        c s hs m]
    have l := loc pc (by simp)
    have cnt : measurementCount (X ++ pc.H) = measurementCount (X ++ pc.L) := by
      rw [measurementCount_append, measurementCount_append, l.counts]
    have key : ∀ m' : List Bool, run (X ++ pc.H) m' s = run (X ++ pc.L) m' s := by
      intro m'
      rw [run_append X pc.H, run_append X pc.L]
      refine l.run_eq _ _ (c0 s hs _) ?_
      have a := c1 s hs m'
      rw [run_append] at a
      exact a
    rw [run_append (X ++ pc.H), run_append (X ++ pc.L), cnt, key]

/-- Index form of the cut obligations: at every slot `j`, the moved wires are
zero at the logical cut before it and at the logical cut after it. -/
theorem cuts_of_index (pre : State → Prop) :
    ∀ (ps : List Piece) (X : Program),
      (∀ j (hj : j < ps.length),
        CutClean pre (X ++ ((ps.take j).map Piece.L).flatten) (ps[j]).moved ∧
          CutClean pre (X ++ ((ps.take (j + 1)).map Piece.L).flatten)
            (ps[j]).moved) →
      Cuts pre X ps
  | [], _, _ => trivial
  | pc :: ps, X, h => by
    show CutClean pre X pc.moved ∧ CutClean pre (X ++ pc.L) pc.moved ∧
      Cuts pre (X ++ pc.L) ps
    refine ⟨?_, ?_, cuts_of_index pre ps (X ++ pc.L) (fun j hj => ?_)⟩
    · have a := (h 0 (by simp)).1
      simpa using a
    · have a := (h 0 (by simp)).2
      simpa using a
    · have a := h (j + 1) (by simp only [List.length_cons]; omega)
      simpa [List.take_succ_cons, List.append_assoc] using a

theorem run_eq_of_index (pre : State → Prop) (ps : List Piece)
    (loc : ∀ pc ∈ ps, pc.Local)
    (cuts : ∀ j (hj : j < ps.length),
      CutClean pre (((ps.take j).map Piece.L).flatten) (ps[j]).moved ∧
        CutClean pre (((ps.take (j + 1)).map Piece.L).flatten) (ps[j]).moved) :
    ∀ s, pre s → ∀ m : List Bool,
      run ((ps.map Piece.H).flatten) m s = run ((ps.map Piece.L).flatten) m s := by
  intro s hs m
  have c : Cuts pre [] ps := cuts_of_index pre ps [] (fun j hj => by
    simpa only [List.nil_append] using cuts j hj)
  have e := run_eq_of_cuts pre ps [] loc c s hs m
  simpa only [List.nil_append] using e

/-! ## The exact piece lists of the two v3 kernels -/

/-- A hosted packet group in the borrowed low field. -/
def groupSlot (h : StairHostsSchedule.HostPlan) (divide : Bool)
    (d first count : Nat) : Piece :=
  ⟨StairSchedule.fieldRename (renameProgram Prefix1590.borrow
      (StairHostsSchedule.hostedGroup h divide d first count)),
    StairSchedule.fieldRename (renameProgram Prefix1590.borrow
      (StairSchedule.placedGroups StairConcrete.bestLoans divide d first count)),
    (StairSchedule.exclusiveRoles.drop d ++ h.group divide d first count).map lowMap⟩

/-- A hosted first packet in the field. -/
def firstSlot (h : StairHostsSchedule.HostPlan) (divide : Bool) : Piece :=
  ⟨StairSchedule.fieldRename (StairLoan.rebindMany StairSchedule.exclusiveRoles (h.firstPacket divide)
      (Rolling1588.placedFirstPacket divide)),
    StairSchedule.fieldRename (Rolling1588.placedFirstPacket divide),
