section Merge_StairBridgeSign_at_StairSideA

/-!
# Signed codec-to-walk rail extension

The compact codec stores two `B`-bit rails.  A compact Skywalk tick consumes
signed `(B+1)`-bit rails.  The sum rail has a clean zero extension; the signed
difference rail needs one physical CX from its retained sign bit.  The same CX
clears that extension before packing in the opposite direction.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairBridgeSign

open ECDSAAdd Arithmetic RecordedQuantum


theorem signExtend_counts (sign extension : Wire) :
    toffoliCount (signExtend sign extension) = 0 ∧
      measurementCount (signExtend sign extension) = 0 := by
  exact ⟨rfl, rfl⟩







end ECDSAAdd.Entrant.StairBridgeSign
end Merge_StairBridgeSign_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecPackA_at_StairSideA` -/
section Merge_StairCodecPackA_at_StairSideA

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec.PackA

open ECDSAAdd Arithmetic
open Arithmetic.RecordedRailCarry Arithmetic.RecordedRailRipple

/-! Run-level correctness of the forward checkpoint codec.  The first part
exposes the private known-top ripple ladder through a public, structurally
identical program and proves its exact frame. -/







def packUpA (source target prev carry : Wire) : Program :=
  [.CX prev target, .CX prev source, .CCX target source carry, .CX prev carry]

def packDownA (source target prev carry : Wire) : Program :=
  [.CX prev carry, .measureX carry [] [.CZ target source],
   .CX prev source, .CX source target]

def packTopA (source target prev top : Wire) : Program :=
  [.CX prev target, .CX prev source,
   .X top, .measureX top [] [.Z prev, .CZ target source], .X top,
   .CX prev source, .CX source target]

def knownTopAdderA : List Wire → List Wire → Wire → List Wire → Wire → Program
  | [source], [target], prev, [], top => packTopA source target prev top
  | source :: source' :: sources, target :: target' :: targets,
      prev, carry :: carries, top =>
      packUpA source target prev carry ++
      knownTopAdderA (source' :: sources) (target' :: targets)
        carry carries top ++
      packDownA source target prev carry
  | _, _, _, _, _ => []


theorem packTopA_wide_frame (source target prev top : Wire)
    (hn : [prev, source, target, top].Nodup) (s : State) (m : List Bool)
    (hlow : 2 ^ ([target] : List Wire).length ≤
      regValue [target, top] s.basis + regValue [source] s.basis +
        (s.basis prev).toNat)
    (hhigh : regValue [target, top] s.basis + regValue [source] s.basis +
        (s.basis prev).toNat < 2 ^ (([target] : List Wire).length + 1)) :
    let out := run (packTopA source target prev top) m s
    out.phase = s.phase ∧
    regValue [target, top] out.basis =
      regValue [target, top] s.basis + regValue [source] s.basis +
        (s.basis prev).toNat ∧
    (∀ q, q ∉ ([target, top] : List Wire) → out.basis q = s.basis q) := by
  dsimp only
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil,
    List.nodup_nil, not_or, not_false_eq_true, and_true] at hn
  rcases hn with ⟨⟨hps, hpt, hpo⟩, ⟨hst, hso⟩, hto⟩
  have hsp := Ne.symm hps
  have htp := Ne.symm hpt
  have hop := Ne.symm hpo
  have hts := Ne.symm hst
  have hos := Ne.symm hso
  have hot := Ne.symm hto
  cases hs : s.basis source <;> cases ht : s.basis target <;>
    cases hp : s.basis prev <;> cases ho : s.basis top <;>
    cases hm : m.headD false <;>
    simp_all [packTopA, run, measureAndCorrect, ECDSAAdd.correct,
      regValue, writeBit, Function.update]
  all_goals intro q hq
  all_goals
    have hqt : q ≠ target := by intro h; exact hq (by simp [h])
    by_cases hqo : q = top <;> by_cases hqs : q = source <;>
      by_cases hqp : q = prev <;>
      simp_all [packTopA, run, measureAndCorrect, ECDSAAdd.correct,
        regValue, writeBit, Function.update]

theorem packUpA_run_eq (source target prev carry : Wire)
    (hn : [source, target, prev, carry].Nodup) (s : State) (m : List Bool) :
    run (packUpA source target prev carry) m s =
      run (carryStep source target (some prev) carry) m s := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  rcases hn with ⟨⟨hst, hsp, hsc⟩, ⟨htp, htc⟩, hpc⟩
  have hts := Ne.symm hst
  have hps := Ne.symm hsp
  have hcs := Ne.symm hsc
  have hpt := Ne.symm htp
  have hct := Ne.symm htc
  have hcp := Ne.symm hpc
  apply State.extensionality
  · rfl
  · funext q
    by_cases hqs : q = source <;> by_cases hqt : q = target <;>
      by_cases hqp : q = prev <;> by_cases hqc : q = carry <;>
      simp_all [packUpA, carryStep, run, writeBit, Function.update,
        Bool.and_comm]

theorem packDownA_run_eq (source target prev carry : Wire)
    (hn : [source, target, prev, carry].Nodup) (s : State) (m : List Bool) :
    run (packDownA source target prev carry) m s =
      run (unwindStep source target (some prev) carry) m s := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  rcases hn with ⟨⟨hst, hsp, hsc⟩, ⟨htp, htc⟩, hpc⟩
  have hts := Ne.symm hst
  have hps := Ne.symm hsp
  have hcs := Ne.symm hsc
  have hpt := Ne.symm htp
  have hct := Ne.symm htc
  have hcp := Ne.symm hpc
  apply State.extensionality
  · cases hs : s.basis source <;> cases ht : s.basis target <;>
      cases hp : s.basis prev <;> cases hc : s.basis carry <;>
      cases hm : m.headD false <;> cases hphase : s.phase <;>
      simp_all [packDownA, unwindStep, run, measureAndCorrect,
        ECDSAAdd.correct, writeBit, Function.update]
  · funext q
    by_cases hqs : q = source <;> by_cases hqt : q = target <;>
      by_cases hqp : q = prev <;> by_cases hqc : q = carry <;>
      cases hm : m.headD false <;>
      simp_all [packDownA, unwindStep, run, measureAndCorrect,
        ECDSAAdd.correct, writeBit, Function.update]


theorem knownTopAdderA_wide_frame (source target work : List Wire)
    (shape : Arithmetic.RecordedRailVented.Shape source target work)
    (prev top : Wire) (s : State) (m : List Bool)
    (hn : ([prev] ++ source ++ target ++ work ++ [top]).Nodup)
    (hclean : ∀ q ∈ work, s.basis q = false)
    (hlow : 2 ^ target.length ≤
      regValue (target ++ [top]) s.basis + regValue source s.basis +
        (s.basis prev).toNat)
    (hhigh : regValue (target ++ [top]) s.basis + regValue source s.basis +
        (s.basis prev).toNat < 2 ^ (target.length + 1)) :
    let out := run (knownTopAdderA source target prev work top) m s
    out.phase = s.phase ∧
    regValue (target ++ [top]) out.basis =
      regValue (target ++ [top]) s.basis + regValue source s.basis +
        (s.basis prev).toNat ∧
    (∀ q, q ∉ target ++ [top] → out.basis q = s.basis q) := by
  induction shape generalizing prev s m with
  | one source target =>
      have hn' : [prev, source, target, top].Nodup := by
        simpa only [List.append_assoc, List.append_nil, List.cons_append,
          List.nil_append] using hn
      simpa only [knownTopAdderA, List.cons_append, List.nil_append] using
        packTopA_wide_frame source target prev top hn' s m hlow hhigh
  | step source0 source1 target0 target1 carry sources targets carries shape ih =>
      let sourceTail := source1 :: sources
      let targetTail := target1 :: targets
      let carryValue := carryFn (s.basis source0) (s.basis target0) (s.basis prev)
      let computed := computedBits source0 target0 carry (some prev) s.basis
      obtain ⟨hnHead, hnTail, hsourceTarget, htargetTarget, hcarryTarget,
          haway, hprev⟩ :=
        Arithmetic.RecordedRailVented.step_layout source0 target0 carry top
          sourceTail targetTail carries (some prev) (by
            simpa only [Option.toList_some, List.singleton_append] using hn)
      have hcomputed := computed_head source0 target0 carry (some prev) s.basis hnHead
      have hsame : ∀ q ∈ sourceTail ++ targetTail ++ carries ++ [top],
          computed q = s.basis q := by
        intro q hq
        obtain ⟨hqs, hqt, hqc⟩ := haway q hq
        simp [computed, computedBits, writeBit, hqs, hqt, hqc]
      have hsource : ∀ q ∈ sourceTail, computed q = s.basis q :=
        fun q hq => hsame q (by simp [hq])
      have htargetWide : ∀ q ∈ targetTail ++ [top],
          computed q = s.basis q := fun q hq => hsame q (by
            simp only [List.mem_append, List.mem_cons, List.not_mem_nil,
              or_false] at hq ⊢
            tauto)
      have hcleanTail : ∀ q ∈ carries, computed q = false := by
        intro q hq
        rw [hsame q (by simp [hq])]
        exact hclean q (by simp [hq])
      have hcarryZero : s.basis carry = false := hclean carry (by simp)
      have hcarryValue : computed carry = carryValue := hcomputed.2.2.1
      have hsourceReg := regValue_congr sourceTail computed s.basis hsource
      have htargetWideReg := regValue_congr (targetTail ++ [top])
        computed s.basis htargetWide
      have hfullEq :
          regValue (target0 :: (targetTail ++ [top])) s.basis +
              regValue (source0 :: sourceTail) s.basis + (s.basis prev).toNat =
            (s.basis target0 ^^ s.basis source0 ^^ s.basis prev).toNat +
              2 * (regValue (targetTail ++ [top]) s.basis +
                regValue sourceTail s.basis +
                (carryFn (s.basis source0) (s.basis target0)
                  (s.basis prev)).toNat) := by
        rw [Arithmetic.RecordedRailVented.reg_cons target0
            (targetTail ++ [top]),
          Arithmetic.RecordedRailVented.reg_cons source0 sourceTail]
        have hw := Arithmetic.RecordedRailVented.wide_step
          (s.basis source0) (s.basis target0) (s.basis prev)
          (regValue sourceTail s.basis)
          (regValue (targetTail ++ [top]) s.basis)
        omega
      have hpow : 2 ^ (target0 :: targetTail).length =
          2 * 2 ^ targetTail.length := by simp [pow_succ, Nat.mul_comm]
      have htailLow : 2 ^ targetTail.length ≤
          regValue (targetTail ++ [top]) computed +
            regValue sourceTail computed + (computed carry).toNat := by
        rw [htargetWideReg, hsourceReg, hcarryValue]
        dsimp only [carryValue]
        have hbit :
            (s.basis target0 ^^ s.basis source0 ^^ s.basis prev).toNat ≤ 1 := by
          cases (s.basis target0 ^^ s.basis source0 ^^ s.basis prev) <;> decide
        have hlow' : 2 * 2 ^ targetTail.length ≤
            regValue (target0 :: (targetTail ++ [top])) s.basis +
              regValue (source0 :: sourceTail) s.basis +
                (s.basis prev).toNat := by
          rw [← hpow]
          simpa only [sourceTail, targetTail, List.cons_append] using hlow
        rw [hfullEq] at hlow'
        omega
      have htailHigh :
          regValue (targetTail ++ [top]) computed +
              regValue sourceTail computed + (computed carry).toNat <
            2 ^ (targetTail.length + 1) := by
        rw [htargetWideReg, hsourceReg, hcarryValue]
        dsimp only [carryValue]
        have hpowHigh : 2 ^ ((target0 :: targetTail).length + 1) =
            2 * 2 ^ (targetTail.length + 1) := by
          simp [pow_succ, Nat.mul_comm, Nat.add_assoc]
        have hhigh' :
            regValue (target0 :: (targetTail ++ [top])) s.basis +
                regValue (source0 :: sourceTail) s.basis +
                  (s.basis prev).toNat <
              2 * 2 ^ (targetTail.length + 1) := by
          rw [← hpowHigh]
          simpa only [sourceTail, targetTail, List.cons_append] using hhigh
        rw [hfullEq] at hhigh'
        omega
      let tail := run
        (knownTopAdderA sourceTail targetTail carry carries top)
        (m.take (measurementCount
          (knownTopAdderA sourceTail targetTail carry carries top)))
        ⟨s.phase, computed⟩
      have htail := ih carry ⟨s.phase, computed⟩
        (m.take (measurementCount
          (knownTopAdderA sourceTail targetTail carry carries top)))
        hnTail hcleanTail htailLow htailHigh
      change tail.phase = s.phase ∧
        regValue (targetTail ++ [top]) tail.basis =
          regValue (targetTail ++ [top]) computed +
            regValue sourceTail computed + (computed carry).toNat ∧
        (∀ q, q ∉ targetTail ++ [top] → tail.basis q = computed q) at htail
      obtain ⟨htPhase, htSum, htOutside⟩ := htail
      have htSumOriginal : regValue (targetTail ++ [top]) tail.basis =
          regValue (targetTail ++ [top]) s.basis +
            regValue sourceTail s.basis +
              (carryFn (s.basis source0) (s.basis target0)
                (s.basis prev)).toNat := by
        rw [htSum, htargetWideReg, hsourceReg, hcarryValue]
      have htSource : tail.basis source0 =
          (s.basis source0 ^^ s.basis prev) :=
        (htOutside source0 hsourceTarget).trans hcomputed.1
      have htTarget : tail.basis target0 =
          (s.basis target0 ^^ s.basis prev) :=
        (htOutside target0 htargetTarget).trans hcomputed.2.1
      have htCarry : tail.basis carry = carryValue :=
        (htOutside carry hcarryTarget).trans hcarryValue
      have htPrev : tail.basis prev = s.basis prev :=
        (htOutside prev (hprev prev (by simp))).trans hcomputed.2.2.2
      have hcarry : tail.basis carry =
          ((tail.basis source0 && tail.basis target0) ^^ tail.basis prev) := by
        rw [htCarry, htSource, htTarget, htPrev]
        rfl
      have hnActual : [source0, target0, prev, carry].Nodup := by
        have hnLinear : [prev, source0, target0, carry].Nodup := by
          simpa only [Option.toList_some, List.singleton_append] using hnHead
        apply List.nodup_iff_count.mpr
        intro q
        have h := List.nodup_iff_count.mp hnLinear q
        simp only [List.count_cons, List.count_nil] at h ⊢
        omega
      have hcompute : run (packUpA source0 target0 prev carry) [] s =
          ⟨s.phase, computed⟩ := by
        rw [packUpA_run_eq source0 target0 prev carry hnActual]
        exact carryStep_state source0 target0 carry (some prev) hnHead
          s.basis s.phase [] hcarryZero
      let outBits := writeBit (writeBit (writeBit tail.basis carry false)
        source0 (tail.basis source0 ^^ tail.basis prev))
        target0 (tail.basis target0 ^^
          (tail.basis source0 ^^ tail.basis prev))
      have hdown : run (packDownA source0 target0 prev carry)
          (m.drop (measurementCount
            (knownTopAdderA sourceTail targetTail carry carries top))) tail =
          ⟨s.phase, outBits⟩ := by
        rw [packDownA_run_eq source0 target0 prev carry hnActual]
        rw [unwind_state source0 target0 carry (some prev) hnHead
          tail.basis tail.phase _ hcarry, htPhase]
        simp only [incomingValue]
        rfl
      have hrun : run
          (knownTopAdderA (source0 :: sourceTail) (target0 :: targetTail)
            prev (carry :: carries) top) m s = ⟨s.phase, outBits⟩ := by
        rw [show knownTopAdderA (source0 :: sourceTail)
            (target0 :: targetTail) prev (carry :: carries) top =
          packUpA source0 target0 prev carry ++
            (knownTopAdderA sourceTail targetTail carry carries top ++
              packDownA source0 target0 prev carry) by rfl]
        simp only [run_append]
        have hupCount : measurementCount
            (packUpA source0 target0 prev carry) = 0 := by
          simp [packUpA, measurementCount]
        rw [hupCount, List.take_zero, List.drop_zero, hcompute]
        change run (packDownA source0 target0 prev carry)
          (m.drop (measurementCount
            (knownTopAdderA sourceTail targetTail carry carries top))) tail = _
        exact hdown
      dsimp only
      rw [hrun]
      have hout := unwound_head source0 target0 carry (some prev)
        s.basis tail.basis hnHead htSource htTarget htPrev
      change outBits source0 = s.basis source0 ∧
        outBits target0 = ((s.basis target0 ^^ s.basis source0) ^^
          s.basis prev) ∧ outBits carry = false at hout
      have htailOut : ∀ q ∈ sourceTail ++ targetTail ++ carries ++ [top],
          outBits q = tail.basis q := by
        intro q hq
        obtain ⟨hqs, hqt, hqc⟩ := haway q hq
        simp [outBits, writeBit, hqs, hqt, hqc]
      refine ⟨rfl, ?_, ?_⟩
      · have htailTarget := regValue_congr (targetTail ++ [top])
          outBits tail.basis (by
            intro q hq
            apply htailOut
            simp only [List.mem_append, List.mem_cons, List.not_mem_nil,
              or_false] at hq ⊢
            tauto)
        change regValue (target0 :: (targetTail ++ [top])) outBits =
          regValue (target0 :: (targetTail ++ [top])) s.basis +
            regValue (source0 :: sourceTail) s.basis +
              (s.basis prev).toNat
        rw [Arithmetic.RecordedRailVented.reg_cons target0
            (targetTail ++ [top]), hout.2.1, htailTarget, htSumOriginal,
          Arithmetic.RecordedRailVented.reg_cons source0 sourceTail,
          Arithmetic.RecordedRailVented.reg_cons target0
            (targetTail ++ [top])]
        have hw := Arithmetic.RecordedRailVented.wide_step
          (s.basis source0) (s.basis target0) (s.basis prev)
          (regValue sourceTail s.basis)
          (regValue (targetTail ++ [top]) s.basis)
        omega
      · intro q hq
        have hqTarget : q ≠ target0 := by intro h; exact hq (by simp [h])
        have hqTail : q ∉ targetTail ++ [top] := by
          intro h
          exact hq (by simpa only [targetTail] using List.mem_cons_of_mem target0 h)
        by_cases hqSource : q = source0
        · subst q; exact hout.1
        by_cases hqCarry : q = carry
        · subst q; exact hout.2.2.trans hcarryZero.symm
        simp [outBits, writeBit, hqSource, hqTarget, hqCarry,
          htOutside q hqTail, computed, computedBits]

def packAdderA : List Wire → List Wire → List Wire → Wire → Wire → Program
  | [source], [target], [], prev, top => packTopA source target prev top
  | source :: source' :: sources, target :: target' :: targets,
      carry :: carries, prev, top =>
      packUpA source target prev carry ++
      packAdderA (source' :: sources) (target' :: targets) carries carry top ++
      packDownA source target prev carry
  | _, _, _, _, _ => []

theorem packAdderA_eq_knownTopAdderA (source target work : List Wire)
    (shape : Arithmetic.RecordedRailVented.Shape source target work)
    (prev top : Wire) :
    packAdderA source target work prev top =
      knownTopAdderA source target prev work top := by
  induction shape generalizing prev with
  | one source target => rfl
  | step source0 source1 target0 target1 carry sources targets carries shape ih =>
      change packUpA source0 target0 prev carry ++
          packAdderA (source1 :: sources) (target1 :: targets) carries carry top ++
          packDownA source0 target0 prev carry =
        packUpA source0 target0 prev carry ++
          knownTopAdderA (source1 :: sources) (target1 :: targets)
            carry carries top ++
          packDownA source0 target0 prev carry
      rw [ih carry]

def packAdderLadderA (L : Layout) : Nat → Nat → Wire → Program
  | 0, j, prev => packTopA (L.D j) (L.S j) prev (L.S (j + 1))
  | n + 1, j, prev =>
      packUpA (L.D j) (L.S j) prev (L.C j) ++
      packAdderLadderA L n (j + 1) (L.C j) ++
      packDownA (L.D j) (L.S j) prev (L.C j)

theorem packAdderLadderA_expand (L : Layout) (j n : Nat) (prev : Wire) :
    packAdderLadderA L (n + 1) j prev =
      packUpA (L.D j) (L.S j) prev (L.C j) ++
      (List.range' (j + 1) n).flatMap (adderMiddle L) ++
      packTopA (L.D (j + n + 1)) (L.S (j + n + 1))
        (L.C (j + n)) (L.S (j + n + 2)) ++
      (List.range' (j + 1) n).reverse.flatMap (adderDown L) ++
      packDownA (L.D j) (L.S j) prev (L.C j) := by
  induction n generalizing j prev with
  | zero => simp [packAdderLadderA]
  | succ n ih =>
      rw [packAdderLadderA]
      rw [ih (j := j + 1) (prev := L.C j)]
      simp only [List.range'_succ, List.flatMap_cons, List.reverse_cons,
        List.flatMap_append, List.flatMap_singleton]
      simp [packUpA, packDownA, adderMiddle, adderDown,
        List.append_assoc]
      congr 2 <;> omega

def generatedPackAdderA (L : Layout) (B : Nat) : Program :=
  let sig := L.D (B - 1)
  let first :=
    [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
     .CX sig (L.C 0)]
  let middle := (List.range (B - 3)).flatMap (fun r => adderMiddle L (r + 1))
  let j := B - 2
  let top :=
    [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
     .X (L.S (B - 1)),
     .measureX (L.S (B - 1)) []
       [.Z (L.C (j - 1)), .CZ (L.S j) (L.D j)],
     .X (L.S (B - 1))]
  let down := adderTopDown L B ++
    ((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)
  first ++ middle ++ top ++ down ++
    [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
     .CX sig (L.D 0), .CX (L.D 0) (L.S 0)]

theorem generatedPackAdderA_eq_ladder (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    generatedPackAdderA L B =
      packAdderLadderA L (B - 2) 0 (L.D (B - 1)) := by
  have hfuel : B - 2 = (B - 3) + 1 := by omega
  rw [hfuel, packAdderLadderA_expand]
  have hrange : List.range' 1 (B - 3) =
      (List.range (B - 3)).map (fun r => r + 1) := by
    rw [List.range'_eq_map_range]
    apply List.map_congr_left
    intro r hr
    omega
  rw [hrange]
  have hcarry : B - 3 = B - 2 - 1 := by omega
  have hterm : B - 2 - 1 + 1 = B - 2 := by omega
  have hplus : B - 2 + 1 = B - 1 := by omega
  have htop2 : B - 2 - 1 + 2 = B - 1 := by omega
  simp [generatedPackAdderA, packUpA, packDownA, packTopA,
    adderTopDown, hcarry, hterm, List.append_assoc]
  rw [List.flatMap_map]
  simp [hplus, htop2]

theorem packAdderLadderA_eq_packAdderA (L : Layout) (n j : Nat) (prev : Wire) :
    packAdderLadderA L n j prev =
      packAdderA (railSegment L.D j (n + 1))
        (railSegment L.S j (n + 1)) (railSegment L.C j n)
        prev (L.S (j + n + 1)) := by
  induction n generalizing j prev with
  | zero => simp [packAdderLadderA, packAdderA, railSegment]
  | succ n ih =>
      simp [packAdderLadderA, packAdderA, ih, List.append_assoc]
      congr 2
      all_goals omega

theorem generatedPackAdderA_eq_public (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    generatedPackAdderA L B =
      packAdderA (reg L.D (B - 1)) (reg L.S (B - 1))
        (reg L.C (B - 2)) (L.D (B - 1)) (L.S (B - 1)) := by
  rw [generatedPackAdderA_eq_ladder L B hB,
    packAdderLadderA_eq_packAdderA]
  have htop : B - 2 + 1 = B - 1 := by omega
  simp [railSegment, reg, List.range_eq_range', htop]

theorem reg_snocA (f : Nat → Wire) (n : Nat) :
    reg f (n + 1) = reg f n ++ [f n] := by
  simp [reg, List.range_succ]

theorem codecAdder_shapeA (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    Arithmetic.RecordedRailVented.Shape
      (reg L.D (B - 1)) (reg L.S (B - 1)) (reg L.C (B - 2)) := by
  apply Arithmetic.RecordedRailVented.aligned_shape
  simp [Arithmetic.RecordedRailVented.Aligned, reg]
  omega

theorem codecAdder_nodupA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) :
    ([L.D (B - 1)] ++ reg L.D (B - 1) ++ reg L.S (B - 1) ++
      reg L.C (B - 2) ++ [L.S (B - 1)]).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have hall := List.nodup_iff_count.mp hn q
  have hBs : B - 1 + 1 = B := by omega
  have hD := reg_snocA L.D (B - 1)
  have hS := reg_snocA L.S (B - 1)
  rw [hBs] at hD hS
  simp only [Layout.Nodup, declaredSites, workSites, List.count_append,
    List.count_cons, List.count_nil] at hall ⊢
  rw [hD, hS] at hall
  simp only [List.count_append, List.count_cons, List.count_nil] at hall
  omega


theorem codecPackAdder_wide_frameA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) (s : State) (m : List Bool)
    (hclean : ∀ q ∈ reg L.C (B - 2), s.basis q = false)
    (hlow : 2 ^ (B - 1) ≤
      regValue (reg L.S B) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat)
    (hhigh : regValue (reg L.S B) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat < 2 ^ B) :
    let out := run (generatedPackAdderA L B) m s
    out.phase = s.phase ∧
    regValue (reg L.S B) out.basis =
      regValue (reg L.S B) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat ∧
    (∀ q, q ∉ reg L.S B → out.basis q = s.basis q) := by
  rw [generatedPackAdderA_eq_public L B hB,
    packAdderA_eq_knownTopAdderA _ _ _ (codecAdder_shapeA L B hB)]
  have hf := knownTopAdderA_wide_frame (reg L.D (B - 1))
    (reg L.S (B - 1)) (reg L.C (B - 2))
    (codecAdder_shapeA L B hB) (L.D (B - 1)) (L.S (B - 1)) s m
    (codecAdder_nodupA L B hB hn) hclean
  have hlen : (reg L.S (B - 1)).length = B - 1 := by simp [reg]
  have hBs : B - 1 + 1 = B := by omega
  have hreg := reg_snocA L.S (B - 1)
  rw [hBs] at hreg
  rw [hreg] at hlow hhigh ⊢
  have hlow' : 2 ^ (reg L.S (B - 1)).length ≤
      regValue (reg L.S (B - 1) ++ [L.S (B - 1)]) s.basis +
        regValue (reg L.D (B - 1)) s.basis +
        (s.basis (L.D (B - 1))).toNat := by simpa only [hlen] using hlow
  have hhigh' : regValue (reg L.S (B - 1) ++ [L.S (B - 1)]) s.basis +
      regValue (reg L.D (B - 1)) s.basis +
      (s.basis (L.D (B - 1))).toNat <
      2 ^ ((reg L.S (B - 1)).length + 1) := by
    simpa only [hlen, hBs] using hhigh
  exact hf hlow' hhigh'


@[simp] theorem xOnA_measurementCount (targets : List Wire) :
    measurementCount (xOnA targets) = 0 := by
  induction targets with
  | nil => simp [xOnA, measurementCount]
  | cons q qs ih => simpa [xOnA, measurementCount] using ih


theorem Dlow_nodupA (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.D (B - 1)).Nodup :=
  (D_nodup L B hn).sublist (by
    simpa only [reg] using
      (List.range_sublist.mpr (Nat.sub_le B 1)).map L.D)

theorem Dtop_not_DlowA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.D (B - 1) ∉ reg L.D (B - 1) := by
  intro hm
  simp only [reg, List.mem_map, List.mem_range] at hm
  rcases hm with ⟨i, hi, heq⟩
  exact reg_ne L.D B (B - 1) i (D_nodup L B hn) (by omega) (by omega)
    (by omega) heq.symm

theorem signedWord_splitA (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    (if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
      else u - sigma.toNat) + 2 ^ (B - 1) * sigma.toNat =
      signedWord B u sigma := by
  have hB : 3 ≤ B := hd.1
  have hsum : u < 2 ^ B := lt_of_le_of_lt (Nat.le_add_right u v) hd.2.2.2.1
  cases sigma with
  | false =>
      simp [signedWord, Nat.mod_eq_of_lt hsum]
  | true =>
      have hadd := domain_sub_sigma_add B u v true hd
      have hw := domain_w_lt_top B u v true hd
      simp only [Bool.toNat_true] at hadd hw
      have hu0 : 0 < u := by
        by_contra hu
        have hu' : u = 0 := by omega
        have hb := (hd.2.2.2.2.2 hu').2
        contradiction
      have hpow : 2 ^ B = 2 ^ (B - 1) * 2 := by
        conv_lhs => rw [show B = (B - 1) + 1 by omega, pow_succ]
      have hdiff : 2 ^ B - u < 2 ^ B := by omega
      have huTop : u ≤ 2 ^ (B - 1) := by omega
      have hsub : 2 ^ (B - 1) - 1 - (u - 1) = 2 ^ (B - 1) - u := by omega
      simp only [Bool.true_eq, if_true, Bool.toNat_true, signedWord]
      rw [Nat.mod_eq_of_lt hdiff, hpow, hsub]
      omega

theorem codecInput_signComplementA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (cxInto (L.D (B - 1)) (reg L.D (B - 1))) m s
    out.phase = s.phase ∧
      regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
      out.basis (L.D (B - 1)) = sigma ∧
      regValue (reg L.S B) out.basis = u + v ∧
      cleanOn (workSites L B) out.basis := by
  have hB : 3 ≤ B := hd.1
  let dlow := reg L.D (B - 1)
  let sig := L.D (B - 1)
  let out := run (cxInto sig dlow) m s
  rcases hc with ⟨hS, hD, hwork⟩
  have hsign := cxInto_run sig dlow (Dlow_nodupA L B hn)
    (Dtop_not_DlowA L B hB hn) s m
  change out = ⟨s.phase, fun q =>
    if s.basis sig && decide (q ∈ dlow) then !s.basis q else s.basis q⟩ at hsign
  have hframe : ∀ q, q ∉ dlow → out.basis q = s.basis q := by
    intro q hq
    rw [hsign]
    simp [hq]
  have hphase : out.phase = s.phase := by rw [hsign]
  have hregD : reg L.D B = dlow ++ [sig] := by
    simp only [dlow, sig]
    conv_lhs => rw [show B = (B - 1) + 1 by omega, reg_snocA]
  have hsingle : regValue [sig] s.basis = (s.basis sig).toNat := by
    cases hs : s.basis sig <;> simp [regValue, hs]
  have hdecomp : regValue dlow s.basis + 2 ^ (B - 1) * (s.basis sig).toNat =
      (if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
       else u - sigma.toNat) + 2 ^ (B - 1) * sigma.toNat := by
    have hw := signedWord_splitA B u v sigma hd
    rw [hregD, regValue_append, hsingle] at hD
    simpa [dlow, reg] using hD.trans hw.symm
  have hdBound : regValue dlow s.basis < 2 ^ (B - 1) := by
    simpa [dlow, reg] using regValue_lt dlow s.basis
  have hwBound := domain_w_lt_top B u v sigma hd
  have hexpectedBound :
      (if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
       else u - sigma.toNat) < 2 ^ (B - 1) := by
    cases sigma with
    | false => simpa using hwBound
    | true =>
        simp only [Bool.true_eq, if_true, Bool.toNat_true]
        have hp : 0 < 2 ^ (B - 1) := by positivity
        omega
  have hsig : s.basis sig = sigma := by
    cases sigma with
    | false =>
        cases hs : s.basis sig with
        | false => rfl
        | true =>
            simp only [hs, Bool.toNat_true, Bool.toNat_false, if_false,
              Nat.mul_zero, Nat.add_zero, Nat.mul_one] at hdecomp hexpectedBound
            omega
    | true =>
        cases hs : s.basis sig with
        | false =>
            simp only [hs, Bool.toNat_false, Bool.toNat_true, if_true,
              Nat.mul_zero, Nat.add_zero, Nat.mul_one] at hdecomp hexpectedBound
            omega
        | true => rfl
  have hdlow : regValue dlow s.basis =
      if sigma then 2 ^ (B - 1) - 1 - (u - sigma.toNat)
      else u - sigma.toNat := by
    rw [hsig] at hdecomp
    omega
  refine ⟨hphase, ?_, ?_, ?_, ?_⟩
  · change regValue dlow out.basis = _
    rw [hsign]
    change regValue dlow (fun q =>
      if s.basis sig && decide (q ∈ dlow) then !s.basis q else s.basis q) = _
    cases sigma with
    | false =>
        simp [hsig, hdlow]
    | true =>
        rw [regValue_congr dlow _ (fun q => !s.basis q) (by
          intro q hq
          simp [hsig, hq]), regValue_complement, hdlow]
        simp only [Bool.toNat_true, Bool.true_eq, if_true]
        have hwLe : u - 1 ≤ 2 ^ (B - 1) - 1 := by
          simpa only [Bool.toNat_true] using Nat.le_pred_of_lt hwBound
        simpa [dlow, reg] using Nat.sub_sub_self hwLe
  · rw [hframe sig (Dtop_not_DlowA L B hB hn), hsig]
  · rw [regValue_congr (reg L.S B) out.basis s.basis]
    · exact hS
    · intro q hq
      apply hframe q
      intro hdq
      have hqD : q ∈ reg L.D B :=
        reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hdq
      exact sep_S_rest L B hn hq (by simp [hqD]) rfl
  · intro q hq
    rw [hframe q]
    · exact hwork q hq
    · intro hdq
      have hqD : q ∈ reg L.D B :=
        reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hdq
      exact sep_D_work L B hn hqD hq rfl

theorem odd_prev_testBitA (v i : Nat) (hodd : v % 2 = 1) (hi : 0 < i) :
    (v - 1).testBit i = v.testBit i := by
  obtain ⟨r, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : i ≠ 0)
  rw [Nat.testBit_succ]
  have hdiv := Nat.mod_add_div v 2
  have hhalf : (v - 1) / 2 = v / 2 := by omega
  rw [hhalf, Nat.testBit_succ]

def packArithmeticA (L : Layout) (B : Nat) : Program :=
  cxInto (L.D (B - 1)) (reg L.D (B - 1)) ++
  xOnA (reg L.S B) ++ generatedPackAdderA L B ++ xOnA (reg L.S B) ++
  [.X (L.S 0)]

set_option maxHeartbeats 800000 in
theorem packArithmetic_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packArithmeticA L B) m s
    out.phase = s.phase ∧
      regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
      out.basis (L.D (B - 1)) = sigma ∧
      out.basis (L.S 0) = false ∧
      (∀ i, 0 < i → i < B → out.basis (L.S i) = (v - 1).testBit i) ∧
      cleanOn (workSites L B) out.basis := by
  have hB : 3 ≤ B := hd.1
  let dlow := reg L.D (B - 1)
  let slow := reg L.S (B - 1)
  let carry := reg L.C (B - 2)
  let sig := L.D (B - 1)
  let stop := L.S (B - 1)
  let sfull := reg L.S B
  let p0 := cxInto sig dlow
  let p1 := xOnA sfull
  let p2 := generatedPackAdderA L B
  let p3 := xOnA sfull
  let p4 : Program := [.X (L.S 0)]
  let s0 := run p0 m s
  let s1 := run p1 m s0
  let s2 := run p2 (m.take (measurementCount p2)) s1
  let rest := m.drop (measurementCount p2)
  let s3 := run p3 rest s2
  let out := run p4 rest s3
  have h0 := codecInput_signComplementA L B u v sigma hd hn s m hc
  change s0.phase = s.phase ∧ regValue dlow s0.basis = u - sigma.toNat ∧
    s0.basis sig = sigma ∧ regValue sfull s0.basis = u + v ∧
    cleanOn (workSites L B) s0.basis at h0
  have h1 := xOn_frameA sfull (S_nodup L B hn) s0 m
  change s1.phase = s0.phase ∧
    regValue sfull s1.basis = 2 ^ sfull.length - 1 - regValue sfull s0.basis ∧
    (∀ q, q ∉ sfull → s1.basis q = s0.basis q) at h1
  have hslen : sfull.length = B := by simp [sfull, reg]
  have hS1 : regValue sfull s1.basis = 2 ^ B - 1 - (u + v) := by
    rw [h1.2.1, hslen, h0.2.2.2.1]
  have hD1 : regValue dlow s1.basis = u - sigma.toNat := by
    rw [regValue_congr dlow s1.basis s0.basis]
    · exact h0.2.1
    · intro q hq
      apply h1.2.2 q
      intro hs
      exact sep_S_rest L B hn hs (by
        have hqD : q ∈ reg L.D B :=
          reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
        simp [hqD]) rfl
  have hsig1 : s1.basis sig = sigma := by
    rw [h1.2.2 sig]
    · exact h0.2.2.1
    · intro hs
      exact sep_S_rest L B hn hs (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)]) rfl
  have hwork1 : cleanOn (workSites L B) s1.basis := by
    intro q hq
    rw [h1.2.2 q]
    · exact h0.2.2.2.2 q hq
    · intro hs
      exact sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq) rfl
  have hregS : slow ++ [stop] = sfull := by
    simp only [slow, stop, sfull]
    symm
    exact (by
      have h := reg_snocA L.S (B - 1)
      rw [show B - 1 + 1 = B by omega] at h
      exact h)
  have htotal : regValue sfull s1.basis + regValue dlow s1.basis +
      (s1.basis sig).toNat = 2 ^ B - 1 - v := by
    rw [hS1, hD1, hsig1]
    have hadd := domain_sub_sigma_add B u v sigma hd
    have hsum := hd.2.2.2.1
    omega
  have hvTop := domain_v_lt_top B u v sigma hd
  have hpow : 2 ^ B = 2 * 2 ^ (B - 1) := by
    calc
      2 ^ B = 2 ^ ((B - 1) + 1) := by
        congr 1
        omega
      _ = 2 ^ (B - 1) * 2 := by exact pow_succ 2 (B - 1)
      _ = 2 * 2 ^ (B - 1) := Nat.mul_comm _ _
  have hlow : 2 ^ (B - 1) ≤
      regValue sfull s1.basis + regValue dlow s1.basis +
        (s1.basis sig).toNat := by
    rw [htotal]
    omega
  have hhigh : regValue sfull s1.basis + regValue dlow s1.basis +
      (s1.basis sig).toNat < 2 ^ B := by
    rw [htotal]
    have hvB : v < 2 ^ B := lt_of_lt_of_le hvTop (by rw [hpow]; omega)
    omega
  have hadd := codecPackAdder_wide_frameA L B hB hn s1
    (m.take (measurementCount p2)) (fun q hq => hwork1 q (by
      unfold workSites
      simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
      have hq' : q ∈ reg L.C (B - 2) := by simpa only [carry] using hq
      tauto)) hlow hhigh
  change s2.phase = s1.phase ∧
    regValue sfull s2.basis =
      regValue sfull s1.basis + regValue dlow s1.basis +
        (s1.basis sig).toNat ∧
    (∀ q, q ∉ sfull → s2.basis q = s1.basis q) at hadd
  have hS2 : regValue sfull s2.basis = 2 ^ B - 1 - v :=
    hadd.2.1.trans htotal
  have hD2 : regValue dlow s2.basis = u - sigma.toNat := by
    rw [regValue_congr dlow s2.basis s1.basis]
    · exact hD1
    · intro q hq
      apply hadd.2.2 q
      intro hs
      exact sep_S_rest L B hn hs (by
        have hqD : q ∈ reg L.D B :=
          reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
        simp [hqD]) rfl
  have hsig2 : s2.basis sig = sigma := by
    rw [hadd.2.2 sig]
    · exact hsig1
    · intro hs
      exact sep_S_rest L B hn hs (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)]) rfl
  have hwork2 : cleanOn (workSites L B) s2.basis := by
    intro q hq
    rw [hadd.2.2 q]
    · exact hwork1 q hq
    · intro hs
      exact sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq) rfl
  have h3 := xOn_frameA sfull (S_nodup L B hn) s2 rest
  change s3.phase = s2.phase ∧
    regValue sfull s3.basis = 2 ^ sfull.length - 1 - regValue sfull s2.basis ∧
    (∀ q, q ∉ sfull → s3.basis q = s2.basis q) at h3
  have hS3 : regValue sfull s3.basis = v := by
    rw [h3.2.1, hslen, hS2]
    have hvB : v < 2 ^ B := lt_of_lt_of_le hvTop (by rw [hpow]; omega)
    exact Nat.sub_sub_self (by omega : v ≤ 2 ^ B - 1)
  have hS30 : s3.basis (L.S 0) = true := by
    have hi : 0 < sfull.length := by rw [hslen]; omega
    have hb := regValue_getD_testBit sfull 0 0 s3.basis hi
    have hw : sfull.getD 0 0 = L.S 0 := by
      rw [List.getD_eq_getElem _ _ hi]
      simp [sfull, reg]
    rw [hw, hS3] at hb
    exact hb.trans (Nat.mod_two_eq_one_iff_testBit_zero.mp hd.2.2.1)
  have hS3bits : ∀ i, 0 < i → i < B →
      s3.basis (L.S i) = (v - 1).testBit i := by
    intro i hi0 hiB
    have hi : i < sfull.length := by simpa [hslen] using hiB
    have hb := regValue_getD_testBit sfull i 0 s3.basis hi
    have hw : sfull.getD i 0 = L.S i := by
      rw [List.getD_eq_getElem _ _ hi]
      simp [sfull, reg]
    rw [hw, hS3] at hb
    exact hb.trans (odd_prev_testBitA v i hd.2.2.1 hi0).symm
  have hD3 : regValue dlow s3.basis = u - sigma.toNat := by
    rw [regValue_congr dlow s3.basis s2.basis]
    · exact hD2
    · intro q hq
      apply h3.2.2 q
      intro hs
      exact sep_S_rest L B hn hs (by
        have hqD : q ∈ reg L.D B :=
          reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
        simp [hqD]) rfl
  have hsig3 : s3.basis sig = sigma := by
    rw [h3.2.2 sig]
    · exact hsig2
    · intro hs
      exact sep_S_rest L B hn hs (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)]) rfl
  have hwork3 : cleanOn (workSites L B) s3.basis := by
    intro q hq
    rw [h3.2.2 q]
    · exact hwork2 q hq
    · intro hs
      exact sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq) rfl
  have hrun : run (packArithmeticA L B) m s = out := by
    have hshape : packArithmeticA L B =
        p0 ++ (p1 ++ (p2 ++ (p3 ++ p4))) := by
      dsimp only [p0, p1, p2, p3, p4]
      simp only [packArithmeticA, List.append_assoc, sig, dlow, sfull]
    rw [hshape]
    rw [run_append_zero_left_spec p0 _ (cxInto_measurementCount sig dlow)]
    rw [run_append_zero_left_spec p1 _ (by simp [p1])]
    rw [run_append]
    change run (p3 ++ p4) rest s2 = out
    rw [run_append_zero_left_spec p3 p4 (by simp [p3])]
  rw [hrun]
  refine ⟨rfl.trans (h3.1.trans (hadd.1.trans (h1.1.trans h0.1))),
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [regValue_congr dlow out.basis s3.basis]
    · exact hD3
    · intro q hq
      have hqD : q ∈ reg L.D B :=
        reg_mem_mono L.D (B - 1) B (Nat.sub_le B 1) hq
      have hne : q ≠ L.S 0 := (sep_S_rest L B hn
        (reg_mem L.S B 0 (by omega)) (by simp [hqD])).symm
      simp [out, p4, run, writeBit, hne]
  · have hne : sig ≠ L.S 0 := (sep_S_rest L B hn
      (reg_mem L.S B 0 (by omega)) (by
        simp [sig, reg_mem L.D B (B - 1) (by omega)])).symm
    have hneD : L.D (B - 1) ≠ L.S 0 := by simpa only [sig] using hne
    change Function.update s3.basis (L.S 0) (!s3.basis (L.S 0))
      (L.D (B - 1)) = sigma
    simp [Function.update, hneD]
    simpa only [sig] using hsig3
  · simp [out, p4, run, writeBit, hS30]
  · intro i hi0 hiB
    have hne : L.S i ≠ L.S 0 :=
      reg_ne L.S B i 0 (S_nodup L B hn) hiB (by omega) (by omega)
    simp [out, p4, run, writeBit, hne, hS3bits i hi0 hiB]
  · intro q hq
    have hne : q ≠ L.S 0 := by
      intro heq
      subst q
      exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (List.mem_append_right (reg L.D B) hq) rfl
    simp [out, p4, run, writeBit, hne, hwork3 q hq]

theorem initialSweepState_invariantA (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) :
    PackSweepInvariant B u v sigma (B - 1)
      (initialSweepState B (u - sigma.toNat) v) := by
  let w := u - sigma.toNat
  have hlen : natBitLength w ≤ B - 1 := by
    simpa [w] using domain_w_bitLength_le B u v sigma hdomain
  have hw : w < 2 ^ (B - 1) := by
    simpa [w] using domain_w_lt_top B u v sigma hdomain
  change B - 1 ≤ B - 1 ∧ true = decide (w < 2 ^ (B - 1)) ∧
    0 = (if B - 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 → w.testBit i =
      if i < B - 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      (if B - 2 - i = 0 then false else (v - 1).testBit (B - 2 - i)) =
        if i < B - 1 then halfBit B v i else false)
  refine ⟨le_rfl, by simp [hw], ?_, ?_, ?_⟩
  · rw [if_neg (by omega : ¬B - 1 < natBitLength w)]
  · intro i hi
    simp [hi]
  · intro i hi
    have hindex : B - 2 - i = (B - 3 - i) + 1 := by omega
    rw [if_pos (by omega : i < B - 1), if_neg (by omega : ¬B - 2 - i = 0)]
    simp only [halfBit, hindex, Nat.testBit_succ]

def packInitA (L : Layout) (B : Nat) : Program :=
  packArithmeticA L B ++ [.X L.z] ++
    decoderInit (lowDecoder L B) (lowBits L B) ++
    decoderInit (highDecoder L B) (highBits L B)

set_option maxHeartbeats 800000 in
theorem packInit_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packInitA L B) m s
    out.phase = s.phase ∧
      PackSweepInvariant B u v sigma (B - 1)
        (initialSweepState B (u - sigma.toNat) v) ∧
      RealizesUnpackSweep L B
        (initialSweepState B (u - sigma.toNat) v) out.basis := by
  have hB : 3 ≤ B := hd.1
  let p0 := packArithmeticA L B
  let pz : Program := [.X L.z]
  let pl := decoderInit (lowDecoder L B) (lowBits L B)
  let ph := decoderInit (highDecoder L B) (highBits L B)
  let s0 := run p0 (m.take (measurementCount p0)) s
  let rest := m.drop (measurementCount p0)
  let s1 := run pz rest s0
  let s2 := run pl rest s1
  let out := run ph rest s2
  have h0 := packArithmetic_correctA L B u v sigma hd hn s
    (m.take (measurementCount p0)) hc
  change s0.phase = s.phase ∧
    regValue (reg L.D (B - 1)) s0.basis = u - sigma.toNat ∧
    s0.basis (L.D (B - 1)) = sigma ∧ s0.basis (L.S 0) = false ∧
    (∀ i, 0 < i → i < B → s0.basis (L.S i) = (v - 1).testBit i) ∧
    cleanOn (workSites L B) s0.basis at h0
  have hz0 : s0.basis L.z = false := h0.2.2.2.2.2 L.z (by simp [workSites])
  have hz1 : s1.basis L.z = true := by
    simp [s1, pz, run, writeBit, hz0]
  have hzFrame : ∀ q, q ≠ L.z → s1.basis q = s0.basis q := by
    intro q hq
    simp [s1, pz, run, writeBit, hq]
  have hLowClean : ∀ q ∈ (lowDecoder L B).sites, s1.basis q = false := by
    intro q hq
    rw [hzFrame q]
    · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
  have hLow := decoderInit_run (lowDecoder L B) (lowBits L B)
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 s1 rest hLowClean
  change s2.phase = s1.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, s2.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B) 0 q) ∧
    (∀ q ∉ (lowDecoder L B).sites, s2.basis q = s1.basis q) at hLow
  have hHighClean : ∀ q ∈ (highDecoder L B).sites, s2.basis q = false := by
    intro q hq
    rw [hLow.2.2 q]
    · rw [hzFrame q]
      · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_right (lowDecoder L B).sites hq))
    · intro hl
      exact sep_low_high L B hn hl hq rfl
  have hHigh := decoderInit_run (highDecoder L B) (highBits L B)
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 s2 rest hHighClean
  change out.phase = s2.phase ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B) 0 q) ∧
    (∀ q ∉ (highDecoder L B).sites, out.basis q = s2.basis q) at hHigh
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hql : q ∉ (lowDecoder L B).sites)
      (hqh : q ∉ (highDecoder L B).sites) : out.basis q = s0.basis q := by
    rw [hHigh.2.2 q hqh, hLow.2.2 q hql, hzFrame q hqz]
  have hrun : run (packInitA L B) m s = out := by
    rw [show packInitA L B = p0 ++ (pz ++ (pl ++ ph)) by
      simp [packInitA, p0, pz, pl, ph, List.append_assoc]]
    rw [run_append]
    change run (pz ++ (pl ++ ph)) rest s0 = out
    rw [run_append_zero_left_spec pz _ (by simp [pz, measurementCount])]
    rw [run_append_zero_left_spec pl _
      (decoderInit_counts (lowDecoder L B) (lowBits L B)).2]
  rw [hrun]
  refine ⟨hHigh.1.trans (hLow.1.trans h0.1),
    initialSweepState_invariantA B u v sigma hd, ?_⟩
  change RealizesUnpackSweep L B
    (initialSweepState B (u - sigma.toNat) v) out.basis
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have hAfalse : ∀ q ∈ reg L.A (bitWidth B), out.basis q = false := by
      intro q hq
      rw [hframe q]
      · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
      · exact sep_A_rest L B hn hq (by simp)
      · intro hs
        exact sep_A_rest L B hn hq (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_A_rest L B hn hq (by simp [workSites, hs]) rfl
    exact (regValue_zero (reg L.A (bitWidth B)) out.basis).mpr hAfalse
  · rw [hHigh.2.2 L.z, hLow.2.2 L.z]
    · exact hz1
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hs) rfl
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hs) rfl
  · rw [hframe L.t]
    · exact h0.2.2.2.2.2 L.t (by simp [workSites])
    · exact Ne.symm (sep_z_t L B hn)
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hs) rfl
    · intro hs
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hs) rfl
  · intro i hi
    have hDi : L.D i ∈ reg L.D B := reg_mem L.D B i (by omega)
    rw [hframe (L.D i)]
    · have hlen : i < (reg L.D (B - 1)).length := by simpa [reg] using hi
      have hb := regValue_getD_testBit (reg L.D (B - 1)) i 0 s0.basis hlen
      have hw : (reg L.D (B - 1)).getD i 0 = L.D i := by
        rw [List.getD_eq_getElem _ _ hlen]
        simp [reg]
      rw [hw, h0.2.1] at hb
      exact hb
    · exact sep_D_work L B hn hDi (by simp [workSites])
    · intro hs
      exact sep_D_work L B hn hDi (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_D_work L B hn hDi (by simp [workSites, hs]) rfl
  · intro i hi
    have hindex0 : 0 < B - 2 - i := by omega
    have hindexB : B - 2 - i < B := by omega
    rw [hframe (L.S (B - 2 - i))]
    · simpa [initialSweepState, ne_of_gt hindex0] using
        h0.2.2.2.2.1 (B - 2 - i) hindex0 hindexB
    · exact sep_S_rest L B hn (reg_mem L.S B _ hindexB) (by simp [workSites])
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B _ hindexB)
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B _ hindexB)
        (by simp [workSites, hs]) rfl
  · intro q hq
    rw [hHigh.2.2 q]
    · simpa using hLow.2.1 q hq
    · intro hh
      exact sep_low_high L B hn hq hh rfl
  · intro q hq
    simpa [initialSweepState] using hHigh.2.1 q hq

/-! Circuit-independent descending-sweep induction. -/

















def packSweepProgramA (L : Layout) (B : Nat) : Nat → Nat → Program
  | _, 0 => []
  | r, n + 1 =>
      packStep L B (r - 1) ++ packSweepProgramA L B (r - 1) n

theorem packSweepProgramA_correct (L : Layout) (B u v r n : Nat)
    (sigma : Bool) (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (hnr : n ≤ r) (hrB : r ≤ B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma r st)
    (hreal : RealizesUnpackSweep L B st s.basis) :
    let out := run (packSweepProgramA L B r n) m s
    out.phase = s.phase ∧
      ∃ fin, PackSweepInvariant B u v sigma (r - n) fin ∧
        RealizesUnpackSweep L B fin out.basis := by
  induction n generalizing r st s m with
  | zero =>
      refine ⟨rfl, st, ?_, hreal⟩
      simpa using hinv
  | succ n ih =>
      have hr : 0 < r := by omega
      have hn' : n ≤ r - 1 := by omega
      let firstProgram := packStep L B (r - 1)
      let firstTape := m.take (measurementCount firstProgram)
      let restTape := m.drop (measurementCount firstProgram)
      let first := run firstProgram firstTape s
      let next := packSweepStep B r st
      have hfirst := packStep_correctA L B u v r sigma hdomain hn hr hrB
        st s firstTape hinv hreal
      change first.phase = s.phase ∧
        PackSweepInvariant B u v sigma (r - 1) next ∧
        RealizesUnpackSweep L B next first.basis at hfirst
      have hrest := ih (r := r - 1) (st := next) (s := first)
        (m := restTape) hn' (by omega) hfirst.2.1 hfirst.2.2
      let out := run (packSweepProgramA L B (r - 1) n) restTape first
      change out.phase = first.phase ∧
        ∃ fin, PackSweepInvariant B u v sigma (r - 1 - n) fin ∧
          RealizesUnpackSweep L B fin out.basis at hrest
      rw [packSweepProgramA, run_append]
      change out.phase = s.phase ∧
        ∃ fin, PackSweepInvariant B u v sigma (r - (n + 1)) fin ∧
          RealizesUnpackSweep L B fin out.basis
      refine ⟨hrest.1.trans hfirst.1, ?_⟩
      simpa [Nat.sub_sub, Nat.add_comm] using hrest.2

theorem packSweepProgramA_eq_generated (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    packSweepProgramA L B (B - 1) (B - 1) =
      packStep L B (B - 2) ++
        (List.range (B - 2)).reverse.flatMap (packStep L B) := by
  rw [show B - 1 = (B - 2) + 1 by omega, packSweepProgramA]
  rw [show B - 2 + 1 - 1 = B - 2 by omega]
  congr 1
  induction B - 2 with
  | zero => rfl
  | succ n ih =>
      rw [packSweepProgramA]
      rw [List.range_succ, List.reverse_append, List.flatMap_append]
      simp only [List.reverse_singleton, List.flatMap_singleton,
        List.singleton_append]
      rw [show n + 1 - 1 = n by omega, ih]

theorem packStep_wires_eq_unpackStepA (L : Layout) (B j : Nat) :
    wires (packStep L B j) = wires (unpackStep L B j) := by
  ext q
  simp only [packStep, unpackStep]
  split_ifs <;>
    simp only [wires_append, wires, Instr.wires, correctionWires,
      Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
      Finset.notMem_empty, or_false] <;>
    aesop

theorem packStep_support_activeA (L : Layout) (B j : Nat) (hj : j < B - 1) :
    wires (packStep L B j) ⊆ (unpackSweepSites L B).toFinset := by
  rw [packStep_wires_eq_unpackStepA]
  exact unpackStep_support_active L B j hj

theorem packSweepProgramA_support (L : Layout) (B r n : Nat)
    (hnr : n ≤ r) (hrB : r ≤ B - 1) :
    wires (packSweepProgramA L B r n) ⊆ (unpackSweepSites L B).toFinset := by
  induction n generalizing r with
  | zero => simp [packSweepProgramA, wires]
  | succ n ih =>
      rw [packSweepProgramA, wires_append]
      apply Finset.union_subset
      · apply packStep_support_activeA
        omega
      · apply ih (r - 1)
        · omega
        · omega

theorem packSweepProgramA_frame (L : Layout) (B r n : Nat)
    (hnr : n ≤ r) (hrB : r ≤ B - 1) (s : State) (m : List Bool)
    {q : Wire} (hq : q ∉ unpackSweepSites L B) :
    (run (packSweepProgramA L B r n) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro hw
  exact hq (List.mem_toFinset.mp (packSweepProgramA_support L B r n hnr hrB hw))

theorem packInit_staticA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packInitA L B) m s
    out.basis (L.D (B - 1)) = sigma ∧
      out.basis (L.S 0) = false ∧
      out.basis (L.S (B - 1)) = false ∧
      (∀ q ∈ reg L.C (B - 2), out.basis q = false) := by
  have hB := hd.1
  let p0 := packArithmeticA L B
  let pz : Program := [.X L.z]
  let pl := decoderInit (lowDecoder L B) (lowBits L B)
  let ph := decoderInit (highDecoder L B) (highBits L B)
  let s0 := run p0 (m.take (measurementCount p0)) s
  let rest := m.drop (measurementCount p0)
  let s1 := run pz rest s0
  let s2 := run pl rest s1
  let out := run ph rest s2
  have h0 := packArithmetic_correctA L B u v sigma hd hn s
    (m.take (measurementCount p0)) hc
  change s0.phase = s.phase ∧
    regValue (reg L.D (B - 1)) s0.basis = u - sigma.toNat ∧
    s0.basis (L.D (B - 1)) = sigma ∧ s0.basis (L.S 0) = false ∧
    (∀ i, 0 < i → i < B → s0.basis (L.S i) = (v - 1).testBit i) ∧
    cleanOn (workSites L B) s0.basis at h0
  have hzFrame : ∀ q, q ≠ L.z → s1.basis q = s0.basis q := by
    intro q hq
    simp [s1, pz, run, writeBit, hq]
  have hLowClean : ∀ q ∈ (lowDecoder L B).sites, s1.basis q = false := by
    intro q hq
    rw [hzFrame q]
    · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
  have hLow := decoderInit_run (lowDecoder L B) (lowBits L B)
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 s1 rest hLowClean
  change s2.phase = s1.phase ∧ _ ∧
    (∀ q ∉ (lowDecoder L B).sites, s2.basis q = s1.basis q) at hLow
  have hHighClean : ∀ q ∈ (highDecoder L B).sites, s2.basis q = false := by
    intro q hq
    rw [hLow.2.2 q]
    · rw [hzFrame q]
      · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_right (lowDecoder L B).sites hq))
    · intro hl
      exact sep_low_high L B hn hl hq rfl
  have hHigh := decoderInit_run (highDecoder L B) (highBits L B)
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 s2 rest hHighClean
  change out.phase = s2.phase ∧ _ ∧
    (∀ q ∉ (highDecoder L B).sites, out.basis q = s2.basis q) at hHigh
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hql : q ∉ (lowDecoder L B).sites)
      (hqh : q ∉ (highDecoder L B).sites) : out.basis q = s0.basis q := by
    rw [hHigh.2.2 q hqh, hLow.2.2 q hql, hzFrame q hqz]
  have hrun : run (packInitA L B) m s = out := by
    rw [show packInitA L B = p0 ++ (pz ++ (pl ++ ph)) by
      simp [packInitA, p0, pz, pl, ph, List.append_assoc]]
    rw [run_append]
    change run (pz ++ (pl ++ ph)) rest s0 = out
    rw [run_append_zero_left_spec pz _ (by simp [pz, measurementCount])]
    rw [run_append_zero_left_spec pl _
      (decoderInit_counts (lowDecoder L B) (lowBits L B)).2]
  rw [hrun]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hframe (L.D (B - 1))]
    · exact h0.2.2.1
    · exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites])
    · intro hs
      exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
  · rw [hframe (L.S 0)]
    · exact h0.2.2.2.1
    · exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites])
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hs]) rfl
  · rw [hframe (L.S (B - 1))]
    · rw [h0.2.2.2.2.1 (B - 1) (by omega) (by omega)]
      apply Nat.testBit_lt_two_pow
      have hv := domain_v_lt_top B u v sigma hd
      omega
    · exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites])
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
    · intro hs
      exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hs]) rfl
  · intro q hq
    rw [hframe q]
    · exact h0.2.2.2.2.2 q (by simp [workSites, hq])
    · exact sep_C_rest L B hn hq (by simp)
    · intro hs
      exact sep_C_rest L B hn hq (by simp [hs]) rfl
    · intro hs
      exact sep_C_rest L B hn hq (by simp [hs]) rfl

def packSweepCoreA (L : Layout) (B : Nat) : Program :=
  packInitA L B ++ packSweepProgramA L B (B - 1) (B - 1)

set_option maxHeartbeats 800000 in
theorem packSweepCore_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    let out := run (packSweepCoreA L B) m s
    out.phase = s.phase ∧
      ∃ fin,
        PackSweepInvariant B u v sigma 0 fin ∧
        RealizesUnpackSweep L B fin out.basis ∧
        out.basis (L.D (B - 1)) = sigma ∧
        out.basis (L.S 0) = false ∧
        out.basis (L.S (B - 1)) = false ∧
        (∀ q ∈ reg L.C (B - 2), out.basis q = false) := by
  let pi := packInitA L B
  let ps := packSweepProgramA L B (B - 1) (B - 1)
  let mid := run pi (m.take (measurementCount pi)) s
  let rest := m.drop (measurementCount pi)
  let out := run ps rest mid
  have hi := packInit_correctA L B u v sigma hd hn s
    (m.take (measurementCount pi)) hc
  change mid.phase = s.phase ∧
    PackSweepInvariant B u v sigma (B - 1)
      (initialSweepState B (u - sigma.toNat) v) ∧
    RealizesUnpackSweep L B
      (initialSweepState B (u - sigma.toNat) v) mid.basis at hi
  have histatic := packInit_staticA L B u v sigma hd hn s
    (m.take (measurementCount pi)) hc
  change mid.basis (L.D (B - 1)) = sigma ∧
    mid.basis (L.S 0) = false ∧
    mid.basis (L.S (B - 1)) = false ∧
    (∀ q ∈ reg L.C (B - 2), mid.basis q = false) at histatic
  have hs := packSweepProgramA_correct L B u v (B - 1) (B - 1) sigma hd hn
    (by omega) (by omega) (initialSweepState B (u - sigma.toNat) v)
    mid rest hi.2.1 hi.2.2
  have hs' : out.phase = mid.phase ∧ ∃ fin,
      PackSweepInvariant B u v sigma 0 fin ∧
      RealizesUnpackSweep L B fin out.basis := by
    simpa only [Nat.sub_self] using hs
  have hrun : run (packSweepCoreA L B) m s = out := by
    simp only [packSweepCoreA, run_append, pi, ps, mid, rest, out]
  rw [hrun]
  refine ⟨hs'.1.trans hi.1, ?_⟩
  rcases hs'.2 with ⟨fin, hfin, hreal⟩
  refine ⟨fin, hfin, hreal, ?_, ?_, ?_, ?_⟩
  · rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (sign_not_unpackSweepSites L B hd.1 hn)]
    exact histatic.1
  · rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (sZero_not_unpackSweepSites L B hd.1 hn)]
    exact histatic.2.1
  · rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (sTop_not_unpackSweepSites L B hd.1 hn)]
    exact histatic.2.2.1
  · intro q hq
    rw [packSweepProgramA_frame L B (B - 1) (B - 1)
      (by omega) (by omega) mid rest (carry_not_unpackSweepSites L B hn hq)]
    exact histatic.2.2.2 q hq





theorem terminalSweepValuesA (B u v : Nat) (sigma : Bool) (fin : SweepState)
    (hinv : PackSweepInvariant B u v sigma 0 fin) :
    let w := u - sigma.toNat
    fin.a = natBitLength w ∧
      fin.z = decide (0 = fin.a) ∧
      (∀ i, i < B - 1 → fin.d i = payloadBit B w v i) ∧
      (∀ i, i < B - 2 → fin.s (B - 2 - i) = false) := by
  let w := u - sigma.toNat
  change 0 ≤ B - 1 ∧ fin.z = decide (w < 2 ^ 0) ∧
    fin.a = (if 0 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 → fin.d i =
      if i < 0 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 → fin.s (B - 2 - i) =
      if i < 0 then halfBit B v i else false) at hinv
  rcases hinv with ⟨_, hz, ha, hd, hs⟩
  have ha' : fin.a = natBitLength w := by
    by_cases hw : w = 0
    · simp [hw, natBitLength] at ha ⊢
      exact ha
    · have hp : 0 < natBitLength w := by simp [natBitLength, hw]
      simpa [hp] using ha
  refine ⟨ha', ?_, ?_, ?_⟩
  · rw [hz, ha']
    by_cases hw : w = 0
    · simp [hw, natBitLength]
    · have hwpos : 0 < w := Nat.pos_of_ne_zero hw
      have hp : 0 < natBitLength w := by simp [natBitLength, hw]
      simp [hw, hwpos, hp, Nat.ne_of_gt hp, Ne.symm (Nat.ne_of_gt hp)]
  · intro i hi
    simpa using hd i hi
  · intro i hi
    simpa using hs i hi

def packFinalizeA (L : Layout) (B : Nat) : Program :=
  [.measureX L.z []
      [.CZ (outAt (highDecoder L B) 0 L.z) (outAt (lowDecoder L B) 0 L.z)]] ++
    eraseDecoderA (highDecoder L B) ++ eraseDecoderA (lowDecoder L B)

theorem eraseHighA_run (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hsites : ∀ q ∈ (highDecoder L B).sites, s.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) :
    run (eraseDecoderA (highDecoder L B)) m s =
      ⟨s.phase, fun q => if q ∈ (highDecoder L B).sites then false
        else s.basis q⟩ := by
  have hx : value / 2 ^ (bitWidth B / 2) < 2 ^ (highBits L B).length := by
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simp only [highBits, reg, List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul hp, ← pow_add]
    have hlo : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hlo, Nat.mul_comm] using hbound
  have hbits : ∀ i, i < (highBits L B).length →
      s.basis ((highBits L B).getD i 0) =
        (value / 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact highBits_read L B value i s.basis hvalue hi
  simpa only [highDecoder] using eraseDecoderA_run
    (highBits L B) L.highWork (highDecoder_nodup L B hn) s m
    (value / 2 ^ (bitWidth B / 2)) hx hbits (by
      simpa only [highDecoder] using hsites)

theorem eraseLowA_run (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hsites : ∀ q ∈ (lowDecoder L B).sites, s.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) :
    run (eraseDecoderA (lowDecoder L B)) m s =
      ⟨s.phase, fun q => if q ∈ (lowDecoder L B).sites then false
        else s.basis q⟩ := by
  have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
  have hx : value % 2 ^ (bitWidth B / 2) < 2 ^ (lowBits L B).length := by
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using
      Nat.mod_lt value hp
  have hbits : ∀ i, i < (lowBits L B).length →
      s.basis ((lowBits L B).getD i 0) =
        (value % 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact lowBits_read L B value i s.basis hvalue hi
  simpa only [lowDecoder] using eraseDecoderA_run
    (lowBits L B) L.lowWork (lowDecoder_nodup L B hn) s m
    (value % 2 ^ (bitWidth B / 2)) hx hbits (by
      simpa only [lowDecoder] using hsites)

set_option maxHeartbeats 1200000 in
theorem packFinalize_correctA (L : Layout) (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (fin : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma 0 fin)
    (hreal : RealizesUnpackSweep L B fin s.basis)
    (hsig : s.basis (L.D (B - 1)) = sigma)
    (hs0 : s.basis (L.S 0) = false)
    (hstop : s.basis (L.S (B - 1)) = false)
    (hcarry : ∀ q ∈ reg L.C (B - 2), s.basis q = false) :
    let out := run (packFinalizeA L B) m s
    out.phase = s.phase ∧ CompactCode L B u v sigma out.basis := by
  have hB := hdomain.1
  let pz : Program := [.measureX L.z []
    [.CZ (outAt (highDecoder L B) 0 L.z) (outAt (lowDecoder L B) 0 L.z)]]
  let ph := eraseDecoderA (highDecoder L B)
  let pl := eraseDecoderA (lowDecoder L B)
  let mz := m.take (measurementCount pz)
  let rest := m.drop (measurementCount pz)
  let mh := rest.take (measurementCount ph)
  let ml := rest.drop (measurementCount ph)
  let zOut := run pz mz s
  let highOut := run ph mh zOut
  let out := run pl ml highOut
  have hterm := terminalSweepValuesA B u v sigma fin hinv
  change fin.a = natBitLength (u - sigma.toNat) ∧
    fin.z = decide (0 = fin.a) ∧
    (∀ i, i < B - 1 → fin.d i = payloadBit B (u - sigma.toNat) v i) ∧
    (∀ i, i < B - 2 → fin.s (B - 2 - i) = false) at hterm
  rcases hreal with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have haBound : fin.a < 2 ^ bitWidth B := by
    rw [← ha]
    simpa [reg] using regValue_lt (reg L.A (bitWidth B)) s.basis
  have hzeroBound : 0 < 2 ^ bitWidth B := by positivity
  have hsel := pairDecoder_selected_of_sites L B fin.a 0 hn s.basis ha
    haBound hzeroBound hlow hhigh
  have houtBounds := decoderOutputBoundsA L B 0 (by omega) hB
  have hleft : outAt (highDecoder L B) 0 L.z ≠ L.z :=
    high_output_ne_z L B 0 hn (by simpa using houtBounds.2)
  have hright : outAt (lowDecoder L B) 0 L.z ≠ L.z :=
    low_output_ne_z L B 0 hn (by simpa using houtBounds.1)
  have hzvalue : s.basis L.z =
      (s.basis (outAt (highDecoder L B) 0 L.z) &&
        s.basis (outAt (lowDecoder L B) 0 L.z)) := by
    rw [hz, hterm.2.1]
    simpa using hsel.symm
  have hzrun := measureCZ_resetA L.z
    (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) s mz hleft hright hzvalue
  change zOut = ⟨s.phase, writeBit s.basis L.z false⟩ at hzrun
  have hzFrame : ∀ q, q ≠ L.z → zOut.basis q = s.basis q := by
    intro q hq
    rw [hzrun]
    simp [writeBit, Function.update, hq]
  have hzA : regValue (reg L.A (bitWidth B)) zOut.basis = fin.a := by
    refine (regValue_congr _ _ _ ?_).trans ha
    intro q hq
    apply hzFrame q
    exact sep_A_rest L B hn hq (by simp)
  have hzHigh : ∀ q ∈ (highDecoder L B).sites, zOut.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (fin.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hzFrame q]
    · exact hhigh q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
  have hherase := eraseHighA_run L B fin.a hn zOut mh hzA haBound hzHigh
  change highOut = ⟨zOut.phase, fun q =>
    if q ∈ (highDecoder L B).sites then false else zOut.basis q⟩ at hherase
  have hhFrame : ∀ q, q ∉ (highDecoder L B).sites →
      highOut.basis q = zOut.basis q := by
    intro q hq
    rw [hherase]
    simp [hq]
  have hhA : regValue (reg L.A (bitWidth B)) highOut.basis = fin.a := by
    refine (regValue_congr _ _ _ ?_).trans hzA
    intro q hq
    apply hhFrame q
    intro hs
    exact sep_A_rest L B hn hq (by simp [hs]) rfl
  have hhLow : ∀ q ∈ (lowDecoder L B).sites, highOut.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (fin.a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hhFrame q]
    · rw [hzFrame q]
      · exact hlow q hq
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_left (highDecoder L B).sites hq))
    · intro hh
      exact sep_low_high L B hn hq hh rfl
  have hlerase := eraseLowA_run L B fin.a hn highOut ml hhA hhLow
  change out = ⟨highOut.phase, fun q =>
    if q ∈ (lowDecoder L B).sites then false else highOut.basis q⟩ at hlerase
  have hlFrame : ∀ q, q ∉ (lowDecoder L B).sites →
      out.basis q = highOut.basis q := by
    intro q hq
    rw [hlerase]
    simp [hq]
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hql : q ∉ (lowDecoder L B).sites)
      (hqh : q ∉ (highDecoder L B).sites) : out.basis q = s.basis q := by
    rw [hlFrame q hql, hhFrame q hqh, hzFrame q hqz]
  have hrun : run (packFinalizeA L B) m s = out := by
    have hshape : packFinalizeA L B = pz ++ (ph ++ pl) := by
      rfl
    rw [hshape, run_append]
    change run (ph ++ pl) rest zOut = out
    rw [run_append]
  rw [hrun]
  refine ⟨?_, ?_⟩
  · rw [hlerase, hherase, hzrun]
  · change CompactCode L B u v sigma out.basis
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hAout : regValue (reg L.A (bitWidth B)) out.basis = fin.a := by
        refine (regValue_congr _ _ _ ?_).trans ha
        intro q hq
        apply hframe q
        · exact sep_A_rest L B hn hq (by simp)
        · intro hs
          exact sep_A_rest L B hn hq (by simp [hs]) rfl
        · intro hs
          exact sep_A_rest L B hn hq (by simp [hs]) rfl
      exact hAout.trans hterm.1
    · apply regValue_eq_of_bits
      · simpa [reg] using compactF_bound B (u - sigma.toNat) v
      · intro i hi
        have hi' : i < B - 2 := by simpa [reg] using hi
        have hget : (reg L.D (B - 2)).getD i 0 = L.D i := by
          rw [List.getD_eq_getElem _ _ hi]
          simp [reg]
        rw [hget, hframe (L.D i)]
        · rw [hdrail i (by omega), hterm.2.2.1 i (by omega)]
          exact (compactF_testBit B (u - sigma.toNat) v i hi').symm
        · exact sep_D_work L B hn (reg_mem L.D B i (by omega))
            (by simp [workSites])
        · intro hs
          exact sep_D_work L B hn (reg_mem L.D B i (by omega))
            (by simp [workSites, hs]) rfl
        · intro hs
          exact sep_D_work L B hn (reg_mem L.D B i (by omega))
            (by simp [workSites, hs]) rfl
    · rw [hframe (L.D (B - 2))]
      · rw [hdrail (B - 2) (by omega), hterm.2.2.1 (B - 2) (by omega)]
        exact payloadBit_top_false B u v sigma hdomain
      · exact sep_D_work L B hn (reg_mem L.D B (B - 2) (by omega))
          (by simp [workSites])
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 2) (by omega))
          (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 2) (by omega))
          (by simp [workSites, hs]) rfl
    · rw [hframe (L.D (B - 1))]
      · exact hsig
      · exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
          (by simp [workSites])
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
          (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
          (by simp [workSites, hs]) rfl
    · apply (regValue_zero (reg L.S B) out.basis).mpr
      intro q hq
      simp only [reg, List.mem_map, List.mem_range] at hq
      rcases hq with ⟨i, hi, rfl⟩
      rw [hframe (L.S i)]
      · by_cases hi0 : i = 0
        · simpa [hi0] using hs0
        by_cases hitop : i = B - 1
        · simpa [hitop] using hstop
        · have hj : B - 2 - i < B - 2 := by omega
          have heq : B - 2 - (B - 2 - i) = i := by omega
          rw [← heq, hsrail (B - 2 - i) hj,
            hterm.2.2.2 (B - 2 - i) hj]
      · exact sep_S_rest L B hn (reg_mem L.S B i hi) (by simp [workSites])
      · intro hs
        exact sep_S_rest L B hn (reg_mem L.S B i hi)
          (by simp [workSites, hs]) rfl
      · intro hs
        exact sep_S_rest L B hn (reg_mem L.S B i hi)
          (by simp [workSites, hs]) rfl
    · intro q hq
      have hcases : q ∈ reg L.C (B - 2) ∨ q = L.z ∨ q = L.t ∨
          q ∈ (lowDecoder L B).sites ∨ q ∈ (highDecoder L B).sites := by
        simp only [List.mem_append, List.mem_cons, List.not_mem_nil,
          or_false] at hq
        tauto
      rcases hcases with hq | hq | hq | hq | hq
      · rw [hframe q]
        · exact hcarry q hq
        · exact sep_C_rest L B hn hq (by simp)
        · intro hs
          exact sep_C_rest L B hn hq (by simp [hs]) rfl
        · intro hs
          exact sep_C_rest L B hn hq (by simp [hs]) rfl
      · subst q
        have hzLow : L.z ∉ (lowDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_left (highDecoder L B).sites hs) rfl
        have hzHigh : L.z ∉ (highDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right (lowDecoder L B).sites hs) rfl
        rw [hlFrame L.z hzLow, hhFrame L.z hzHigh, hzrun]
        simp [writeBit, Function.update]
      · subst q
        have htLow : L.t ∉ (lowDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_left (highDecoder L B).sites hs) rfl
        have htHigh : L.t ∉ (highDecoder L B).sites := by
          intro hs
          exact sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right (lowDecoder L B).sites hs) rfl
        rw [hframe L.t (Ne.symm (sep_z_t L B hn)) htLow htHigh]
        exact ht
      · rw [hlerase]
        simp [hq]
      · rw [hlFrame q]
        · rw [hherase]
          simp [hq]
        · intro hl
          exact sep_low_high L B hn hl hq rfl

def generatedPackA (L : Layout) (B : Nat) : Program :=
  let ld := lowDecoder L B
  let hd := highDecoder L B
  cxInto (L.D (B - 1)) (reg L.D (B - 1)) ++
  xOnA (reg L.S B) ++ generatedPackAdderA L B ++ xOnA (reg L.S B) ++
  [.X (L.S 0)] ++ [.X L.z] ++
  decoderInit ld (lowBits L B) ++ decoderInit hd (highBits L B) ++
  packStep L B (B - 2) ++
  ((List.range (B - 2)).reverse.flatMap (packStep L B)) ++
  [.measureX L.z [] [.CZ (outAt hd 0 L.z) (outAt ld 0 L.z)]] ++
  eraseDecoderA hd ++ eraseDecoderA ld

theorem pack_eq_generatedPackA (L : Layout) (B : Nat) :
    pack L B = generatedPackA L B := by
  rfl

theorem pack_eq_core_finalizeA (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    pack L B = packSweepCoreA L B ++ packFinalizeA L B := by
  rw [pack_eq_generatedPackA]
  unfold packSweepCoreA
  rw [packSweepProgramA_eq_generated L B hB]
  simp [generatedPackA, packInitA, packArithmeticA, packFinalizeA,
    List.append_assoc]

set_option maxHeartbeats 1200000 in
theorem pack_spec (L : Layout) (B u v : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (s : State) (m : List Bool) (hc : CodecInput L B u v sigma s.basis) :
    (run (pack L B) m s).phase = s.phase ∧
      CompactCode L B u v sigma (run (pack L B) m s).basis := by
  let pc := packSweepCoreA L B
  let pf := packFinalizeA L B
  let mc := m.take (measurementCount pc)
  let mf := m.drop (measurementCount pc)
  let mid := run pc mc s
  let out := run pf mf mid
  have hcore := packSweepCore_correctA L B u v sigma hdomain hn s mc hc
  change mid.phase = s.phase ∧ ∃ fin,
    PackSweepInvariant B u v sigma 0 fin ∧
    RealizesUnpackSweep L B fin mid.basis ∧
    mid.basis (L.D (B - 1)) = sigma ∧
    mid.basis (L.S 0) = false ∧
    mid.basis (L.S (B - 1)) = false ∧
    (∀ q ∈ reg L.C (B - 2), mid.basis q = false) at hcore
  rcases hcore.2 with ⟨fin, hinv, hreal, hsig, hs0, hstop, hcarry⟩
  have hfinal := packFinalize_correctA L B u v sigma hdomain hn fin mid mf
    hinv hreal hsig hs0 hstop hcarry
  change out.phase = mid.phase ∧ CompactCode L B u v sigma out.basis at hfinal
  have hrun : run (pack L B) m s = out := by
    rw [pack_eq_core_finalizeA L B hdomain.1]
    simp only [run_append, pc, pf, mc, mf, mid, out]
  rw [hrun]
  exact ⟨hfinal.1.trans hcore.1, hfinal.2⟩

theorem pack_handoff (L : Layout) (B : Nat) :
    ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
      ∀ s m, CodecInput L B u v sigma s.basis →
        (run (pack L B) m s).phase = s.phase ∧
        CompactCode L B u v sigma (run (pack L B) m s).basis := by
  intro u v sigma hdomain hn s m hc
  exact pack_spec L B u v sigma hdomain hn s m hc

theorem functionalSpecA (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : FunctionalSpec L B := by
  exact functionalSpec_of_pack L B hB hn (pack_handoff L B)

end ECDSAAdd.Entrant.StairCodec.PackA
end Merge_StairCodecPackA_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairDivLoanTopGeneric_at_StairSideA` -/
section Merge_StairDivLoanTopGeneric_at_StairSideA

/-!
# Generic run facts for the division-endpoint loan window (LT15)

* `run_basis_xOnly`: a wire targeted only by `X` gates ends flipped by the
  parity of those gates (any state, any record).
* `run_basis_untouched`, `run_basis_endsCleared`: untouched wires keep their
  value; a wire whose last write is a measurement ends at `false`.
* `run_basis_records`: the basis part of a run never depends on the record.
* `run_shift`: a global phase flip commutes with `run`.
* `tapeFree_middle`: if `A ++ (B ++ C)` is record-independent from `s`, then
  `B` is record-independent from every state `run A a s`.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairDivLoanTop

open ECDSAAdd

/-- Target wire of an instruction. -/
def target : Instr → Wire
  | .X t => t
  | .CX _ t => t
  | .CCX _ _ t => t
  | .measureX t _ _ => t

def isXOn (q : Wire) : Instr → Bool
  | .X t => t == q
  | _ => false

def hitsNonX (q : Wire) : Instr → Bool
  | .X _ => false
  | .CX _ t => t == q
  | .CCX _ _ t => t == q
  | .measureX t _ _ => t == q

def isMeasureOn (q : Wire) : Instr → Bool
  | .measureX t _ _ => t == q
  | _ => false

def xParity (q : Wire) : Program → Bool
  | [] => false
  | i :: P => isXOn q i ^^ xParity q P

def untouched (q : Wire) (P : Program) : Bool := P.all (fun i => !(target i == q))

def endsCleared (q : Wire) : Program → Bool
  | [] => false
  | i :: P => endsCleared q P || (isMeasureOn q i && untouched q P)

theorem xor_rc (a b c : Bool) : ((a ^^ b) ^^ c) = ((a ^^ c) ^^ b) := by
  cases a <;> cases b <;> cases c <;> rfl

theorem run_basis_xOnly (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    P.all (fun i => !hitsNonX q i) = true →
      (run P m s).basis q = (s.basis q ^^ xParity q P) := by
  intro P
  induction P with
  | nil =>
      intro m s _
      simp [run, xParity]
  | cons i P ih =>
      intro m s h
      simp only [List.all_cons, Bool.and_eq_true] at h
      obtain ⟨hi, hP⟩ := h
      cases i with
      | X t =>
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          by_cases e : t = q
          · rw [e]
            simp only [writeBit, Function.update_self, beq_self_eq_true]
            cases s.basis q <;> cases xParity q P <;> rfl
          · have hb : (t == q) = false := by simp [e]
            simp only [writeBit, Function.update_of_ne (Ne.symm e), hb]
            cases s.basis q <;> cases xParity q P <;> rfl
      | CX c t =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl
      | CCX a1 a2 t =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl
      | measureX t c0 c1 =>
          have e : t ≠ q := by simpa [hitsNonX] using hi
          simp only [run, xParity, isXOn]
          rw [ih _ _ hP]
          simp only [measureAndCorrect, correct_basis, writeBit,
            Function.update_of_ne (Ne.symm e)]
          cases s.basis q <;> cases xParity q P <;> rfl

theorem run_basis_untouched (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    untouched q P = true → (run P m s).basis q = s.basis q := by
  intro P
  induction P with
  | nil => intro m s _; rfl
  | cons i P ih =>
      intro m s h
      simp only [untouched, List.all_cons, Bool.and_eq_true] at h
      obtain ⟨hi, hP⟩ := h
      have hP' : untouched q P = true := hP
      cases i with
      | X t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | CX c t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | CCX a1 a2 t =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [writeBit, Function.update_of_ne (Ne.symm e)]
      | measureX t c0 c1 =>
          have e : t ≠ q := by simpa [target] using hi
          simp only [run]
          rw [ih _ _ hP']
          simp only [measureAndCorrect, correct_basis, writeBit,
            Function.update_of_ne (Ne.symm e)]

theorem run_basis_endsCleared (q : Wire) : ∀ (P : Program) (m : List Bool) (s : State),
    endsCleared q P = true → (run P m s).basis q = false := by
  intro P
  induction P with
  | nil => intro m s h; simp [endsCleared] at h
  | cons i P ih =>
      intro m s h
      simp only [endsCleared, Bool.or_eq_true, Bool.and_eq_true] at h
      rcases h with h | ⟨hm, hu⟩
      · cases i <;> simp only [run] <;> exact ih _ _ h
      · cases i with
        | X t => simp [isMeasureOn] at hm
        | CX c t => simp [isMeasureOn] at hm
        | CCX a1 a2 t => simp [isMeasureOn] at hm
        | measureX t c0 c1 =>
            have e : t = q := by simpa [isMeasureOn] using hm
            subst e
            simp only [run]
            rw [run_basis_untouched _ P _ _ hu]
            simp [measureAndCorrect, writeBit]


theorem correct_shift (cs : List Correction) : ∀ (p b : Bool) (x : BasisState),
    correct cs ⟨p ^^ b, x⟩ = ⟨(correct cs ⟨p, x⟩).phase ^^ b, (correct cs ⟨p, x⟩).basis⟩ := by
  induction cs with
  | nil => intro p b x; rfl
  | cons c cs ih =>
      intro p b x
      cases c with
      | Z t =>
          show correct cs ⟨(p ^^ b) ^^ x t, x⟩ =
            ⟨(correct cs ⟨p ^^ x t, x⟩).phase ^^ b, (correct cs ⟨p ^^ x t, x⟩).basis⟩
          rw [xor_rc p b (x t)]
          exact ih (p ^^ x t) b x
      | CZ a1 a2 =>
          show correct cs ⟨(p ^^ b) ^^ (x a1 && x a2), x⟩ =
            ⟨(correct cs ⟨p ^^ (x a1 && x a2), x⟩).phase ^^ b,
              (correct cs ⟨p ^^ (x a1 && x a2), x⟩).basis⟩
          rw [xor_rc p b (x a1 && x a2)]
          exact ih (p ^^ (x a1 && x a2)) b x

theorem mac_shift (t : Wire) (c0 c1 : List Correction) (r p b : Bool) (x : BasisState) :
    measureAndCorrect t c0 c1 r ⟨p ^^ b, x⟩ =
      ⟨(measureAndCorrect t c0 c1 r ⟨p, x⟩).phase ^^ b,
        (measureAndCorrect t c0 c1 r ⟨p, x⟩).basis⟩ := by
  show correct (if r then c1 else c0) ⟨(p ^^ b) ^^ (r && x t), writeBit x t false⟩ =
    ⟨(correct (if r then c1 else c0) ⟨p ^^ (r && x t), writeBit x t false⟩).phase ^^ b,
      (correct (if r then c1 else c0) ⟨p ^^ (r && x t), writeBit x t false⟩).basis⟩
  rw [xor_rc p b (r && x t)]
  exact correct_shift _ _ b _

theorem run_shift (P : Program) : ∀ (m : List Bool) (p b : Bool) (x : BasisState),
    run P m ⟨p ^^ b, x⟩ = ⟨(run P m ⟨p, x⟩).phase ^^ b, (run P m ⟨p, x⟩).basis⟩ := by
  induction P with
  | nil => intro m p b x; rfl
  | cons i P ih =>
      intro m p b x
      cases i with
      | X t => simp only [run]; exact ih m p b (writeBit x t (!x t))
      | CX c t => simp only [run]; exact ih m p b (writeBit x t (x t ^^ x c))
      | CCX a1 a2 t => simp only [run]; exact ih m p b (writeBit x t (x t ^^ (x a1 && x a2)))
      | measureX t c0 c1 =>
          simp only [run]
          rw [mac_shift]
          exact ih _ _ b _

theorem run_pad (P : Program) : ∀ (a : List Bool) (n : Nat) (s : State),
    run P (a ++ List.replicate n false) s = run P a s := by
  induction P with
  | nil => intro a n s; rfl
  | cons i P ih =>
      intro a n s
      cases i with
      | X t => simp only [run]; exact ih a n _
      | CX c t => simp only [run]; exact ih a n _
      | CCX a1 a2 t => simp only [run]; exact ih a n _
      | measureX t c0 c1 =>
          cases a with
          | nil =>
              cases n with
              | zero => rfl
              | succ n =>
                  simp only [run]
                  exact ih [] n _
          | cons x a =>
              simp only [run]
              exact ih a n _

/-- A record of exactly `k` entries that runs like `l`. -/
def fixLen (l : List Bool) (k : Nat) : List Bool := (l ++ List.replicate k false).take k

theorem fixLen_length (l : List Bool) (k : Nat) : (fixLen l k).length = k := by
  simp only [fixLen, List.length_take, List.length_append, List.length_replicate]
  omega

theorem run_fixLen (P : Program) (l : List Bool) (s : State) :
    run P (fixLen l (measurementCount P)) s = run P l s := by
  unfold fixLen
  rw [run_take, run_pad]

/-- Record independence of a middle block, from record independence of the whole. -/
theorem tapeFree_middle (A B C : Program) (s : State)
    (whole : ∀ m n, run (A ++ (B ++ C)) m s = run (A ++ (B ++ C)) n s)
    (a r r' : List Bool) :
    run B r (run A a s) = run B r' (run A a s) := by
  have key : ∀ r : List Bool,
      run (A ++ (B ++ C))
        (fixLen a (measurementCount A) ++ (fixLen r (measurementCount B) ++ [])) s =
        run C [] (run B r (run A a s)) := by
    intro r
    rw [run_append, List.take_left' (fixLen_length _ _), List.drop_left' (fixLen_length _ _),
      run_fixLen, run_append, List.take_left' (fixLen_length _ _),
      List.drop_left' (fixLen_length _ _), run_fixLen]
  have hb := run_basis_records B r r' (run A a s) (run A a s) rfl
  have hc := whole (fixLen a (measurementCount A) ++ (fixLen r (measurementCount B) ++ []))
    (fixLen a (measurementCount A) ++ (fixLen r' (measurementCount B) ++ []))
  rw [key r, key r'] at hc
  apply State.extensionality _ _ _ hb
  generalize run B r (run A a s) = Y at hc hb ⊢
  generalize run B r' (run A a s) = Y' at hc hb ⊢
  obtain ⟨p, x⟩ := Y
  obtain ⟨p', x'⟩ := Y'
  simp only at hb ⊢
  rw [← hb] at hc
  cases p <;> cases p'
  · rfl
  · exfalso
    have sh : run C [] ⟨true, x⟩ =
        ⟨(run C [] ⟨false, x⟩).phase ^^ true, (run C [] ⟨false, x⟩).basis⟩ :=
      run_shift C [] false true x
    have ph := congrArg State.phase (hc.trans sh)
    revert ph
    cases (run C [] ⟨false, x⟩).phase <;> simp
  · exfalso
    have sh : run C [] ⟨true, x⟩ =
        ⟨(run C [] ⟨false, x⟩).phase ^^ true, (run C [] ⟨false, x⟩).basis⟩ :=
      run_shift C [] false true x
    have ph := congrArg State.phase (hc.symm.trans sh)
    revert ph
    cases (run C [] ⟨false, x⟩).phase <;> simp
  · rfl

/-- Record independence of the whole from `run_basis_records` plus a fixed phase. -/
theorem tapeFree_of_phase (P : Program) (s : State)
    (phase : ∀ m, (run P m s).phase = s.phase) (m n : List Bool) :
    run P m s = run P n s :=
  State.extensionality _ _ ((phase m).trans (phase n).symm)
    (run_basis_records P m n s s rfl)

/-! ## K1 (replay budget): operand lists and bit masks for static program checks

`decide (q ∉ Instr.wires i)` builds a `Finset` per instruction (and per wire `q`); the checks
below test list operands once per instruction and wire sets as one bit mask per program. -/

/-- Operands of a correction list, as a list. -/
def k1corrList : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: k1corrList cs
  | .CZ a b :: cs => a :: b :: k1corrList cs

/-- Operands of one instruction, as a list. -/
def k1wl : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (k1corrList c₀ ++ k1corrList c₁)

theorem k1_mem_corrList (q : Wire) :
    ∀ cs : List Correction, q ∈ correctionWires cs → q ∈ k1corrList cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k1corrList, List.mem_cons]
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (k1_mem_corrList q cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      simp only [k1corrList, List.mem_cons]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (k1_mem_corrList q cs h))

theorem k1_mem_wl (q : Wire) (i : Instr) (h : q ∈ Instr.wires i) : q ∈ k1wl i := by
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_singleton]
      exact h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | measureX t c₀ c₁ =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k1wl, List.mem_cons, List.mem_append]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl (k1_mem_corrList q c₀ h))
      · exact Or.inr (Or.inr (k1_mem_corrList q c₁ h))

def k1listMask : List Wire → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| k1listMask xs

theorem k1_testBit_listMask : ∀ (l : List Wire) (q : Wire),
    (k1listMask l).testBit q = decide (q ∈ l)
  | [], q => by simp [k1listMask]
  | x :: xs, q => by
    simp only [k1listMask, Nat.testBit_or, k1_testBit_listMask xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm

/-- All operands of a program, as one bit mask. -/
def k1progMask : Program → Nat
  | [] => 0
  | i :: P => k1listMask (k1wl i) ||| k1progMask P

theorem k1_all_not_mem_of_mask (P : Program) (q : Wire) (h : (k1progMask P).testBit q = false) :
    P.all (fun i => decide (q ∉ Instr.wires i)) = true := by
  induction P with
  | nil => rfl
  | cons i P ih =>
    simp only [k1progMask, Nat.testBit_or, Bool.or_eq_false_iff] at h
    have h1 := h.1
    rw [k1_testBit_listMask] at h1
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨fun hm => by simp [k1_mem_wl q i hm] at h1, ih h.2⟩


/-- Non-`X` targets of a program, as one bit mask. -/
def k1hitBit : Instr → Nat
  | .X _ => 0
  | .CX _ t => 2 ^ t
  | .CCX _ _ t => 2 ^ t
  | .measureX t _ _ => 2 ^ t

def k1hitMask : Program → Nat
  | [] => 0
  | i :: P => k1hitBit i ||| k1hitMask P

/-- `X` targets of a program, XOR-ed into one bit mask. -/
def k1xBit : Instr → Nat
  | .X t => 2 ^ t
  | _ => 0

def k1xMask : Program → Nat
  | [] => 0
  | i :: P => k1xBit i ^^^ k1xMask P

theorem k1_testBit_hitBit (q : Wire) (i : Instr) : (k1hitBit i).testBit q = hitsNonX q i := by
  cases i <;> simp only [k1hitBit, hitsNonX, Nat.testBit_two_pow, Nat.zero_testBit] <;>
    exact Bool.eq_iff_iff.mpr (by simp)

theorem k1_testBit_xBit (q : Wire) (i : Instr) : (k1xBit i).testBit q = isXOn q i := by
  cases i with
  | X t =>
    simp only [k1xBit, isXOn, Nat.testBit_two_pow]
    exact Bool.eq_iff_iff.mpr (by simp)
  | CX c t => simp only [k1xBit, isXOn, Nat.zero_testBit]
  | CCX a c t => simp only [k1xBit, isXOn, Nat.zero_testBit]
  | measureX t c₀ c₁ => simp only [k1xBit, isXOn, Nat.zero_testBit]

theorem k1_all_hits (q : Wire) : ∀ P : Program,
    P.all (fun i => !hitsNonX q i) = !(k1hitMask P).testBit q
  | [] => by simp [k1hitMask]
  | i :: P => by
    simp only [List.all_cons, k1hitMask, Nat.testBit_or, k1_testBit_hitBit, k1_all_hits q P,
      Bool.not_or]

theorem k1_xParity (q : Wire) : ∀ P : Program, xParity q P = (k1xMask P).testBit q
  | [] => by simp [xParity, k1xMask]
  | i :: P => by
    simp only [xParity, k1xMask, Nat.testBit_xor, k1_testBit_xBit, k1_xParity q P]

end ECDSAAdd.Entrant.StairDivLoanTop
