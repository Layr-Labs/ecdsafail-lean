/-! ## Cut facts for single wires -/

/-- `w` is zero at the end of `X` on every `pre` input and tape. -/
def ZeroAt (pre : State → Prop) (X : Program) (w : Wire) : Prop :=
  ∀ s, pre s → ∀ m : List Bool, (run X m s).basis w = false

theorem zeroAt_append (pre : State → Prop) (X P : Program) (w : Wire) (b : Bool)
    (prev : b = true → ZeroAt pre X w) (h : zt w b P = true) :
    ZeroAt pre (X ++ P) w := by
  intro s hs m
  rw [run_append]
  exact zt_sound w P b _ _ h (fun hb => prev hb s hs _)





theorem cutClean_append_lists (pre : State → Prop) (X : Program) (S T : List Wire)
    (hS : CutClean pre X S) (hT : CutClean pre X T) : CutClean pre X (S ++ T) := by
  intro s hs m q hq
  rcases List.mem_append.mp hq with h | h
  · exact hS s hs m q h
  · exact hT s hs m q h

/-- One piece step along a piece list. -/
theorem zeroAt_cut_step (pre : State → Prop) (ps : List Piece) (j : Nat) (hj : j < ps.length)
    (w : Wire) (b : Bool) (prev : b = true → ZeroAt pre (cut ps j) w)
    (h : zt w b (ps[j]).L = true) : ZeroAt pre (cut ps (j + 1)) w := by
  rw [cut_succ ps j hj]
  exact zeroAt_append pre _ _ w b prev h




set_option maxHeartbeats 0 in
theorem chk_lowMap_fix : ∀ w ∈ StairSchedule.exclusiveRoles, StairField13V3.lowMap w = w := by
  decide +kernel

set_option maxHeartbeats 0 in
theorem chk_fieldMap_fix : ∀ w ∈ StairSchedule.exclusiveRoles, StairField13V3.fieldMap w = w := by
  decide +kernel

theorem chk_retired_take : StairLoan.retiredRoles.take 44 = StairSchedule.exclusiveRoles := by
  decide +kernel

