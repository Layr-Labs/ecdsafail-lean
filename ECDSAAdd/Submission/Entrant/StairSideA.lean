/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareBEFold_at_QTop` -/
section Merge_StairSquareBEFold_at_QTop

/-! # LT36 (U3b): hole-free e-fold for the B body

The record's e-fold `eFoldTq L c = eFlip ++ (fillInK ++ qprog4Tq L.measuredCore p ++ fillOutKnown) ++ eFlip`
reads the 163-bit accumulator `accReg L = work.take 163` as the full 256-bit `work` register, so
its carries live on `foldCarry` (all of pad, overflowPad, productHigh, workHigh), which contains
the 39 hole sites (carries 204..238, 240..243).  `eFoldB` keeps the fill/unfill pieces and
replaces the middle by the mapped-source adder `qprogM` reading `accReg` + 93 constant zeros;
the hole carries move onto `work[163..201]`, which are zero at the middle's entry. -/

set_option autoImplicit false
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareBEFold
open ECDSAAdd ECDSAAdd.Entrant Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout RecordedQuantum
open StairSquareBMapped ControlLoan1589BFFold

/-- Carry bank of the new middle: `foldCarry` with positions 199..238 and 240..243 replaced by
`work[163..202]` and `work[203..206]`.  (U4 pilot: was 204..238 / 240..243 on `work[163..201]`.) -/
def carryB (L : CuccaroStreamedSquareWideLayout) : List Wire :=
  L.foldPad.take 199++((L.core.work.drop 163).take 40++((L.foldPad.drop 239).take 1++
    (((L.core.work.drop 163).drop 40).take 4++(L.foldPad.drop 244++[L.core.productHigh,L.core.workHigh]))))

/-- The adder layout (its `src` field is a dummy; `qprogM` does not use it). -/
def coreB (L : CuccaroStreamedSquareWideLayout) : MeasuredCanonicalModLayout :=
  {src:=L.core.product.take 256,out:=L.core.out,carry:=carryB L,
    high:=L.core.outHigh,cin:=L.core.cin,flag:=L.core.modFlag}

def bitsB (L : CuccaroStreamedSquareWideLayout) : List MappedBit :=
  mappedRead (ECDSAAdd.Entrant.accReg L) false++List.replicate 93 zbit

def midB (L : CuccaroStreamedSquareWideLayout) : Program := qprogM (coreB L) (bitsB L) SquareReduction.p

def accFoldB (L : CuccaroStreamedSquareWideLayout) (a : AccItem) : Program :=
  OwnDiagAll12Square.fillInK L a++midB L++SourceFourPrefix130Develop.fillOutKnown L a

def eFoldB (L : CuccaroStreamedSquareWideLayout) (c : Wire) : Program :=
  eFlip L c++(accFoldB L (eItem L)++eFlip L c)

theorem carryB_mem (L : CuccaroStreamedSquareWideLayout) (q : Wire) (hq : q∈carryB L) :
    q∈L.foldPad ∨ q∈L.core.work.drop 163 ∨ q=L.core.productHigh ∨ q=L.core.workHigh := by
  simp only [carryB,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hq
  rcases hq with h|h|h|h|h|h|h
  · exact Or.inl (List.mem_of_mem_take h)
  · exact Or.inr (Or.inl (List.mem_of_mem_take h))
  · exact Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h))
  · exact Or.inr (Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h)))
  · exact Or.inl (List.mem_of_mem_drop h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr h))

theorem carryB_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (carryB L).length=256 := by
  have fp : L.foldPad.length=254 := by simp [foldPad,hw.core.pad,hw.overflowPad]
  simp [carryB,fp,hw.core.work]

theorem coreB_widths (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (coreB L).Widths 256 :=
  ⟨by simp [coreB,hw.core.product],hw.core.out,carryB_length L hw⟩

theorem mappedValue_replicate_zbit (k : Nat) (s : BasisState) :
    mappedValue (List.replicate k zbit) s=0 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [List.replicate_succ,mappedValue,ih]
    simp [zbit,MappedBit.value]

theorem mappedWires_replicate_zbit (k : Nat) : mappedWires (List.replicate k zbit)=[] := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [List.replicate_succ]
    simp only [mappedWires,List.flatMap_cons] at ih ⊢
    rw [ih]
    simp [zbit]

theorem bitsB_value (L : CuccaroStreamedSquareWideLayout) (s : BasisState) :
    mappedValue (bitsB L) s=regValue (ECDSAAdd.Entrant.accReg L) s := by
  rw [bitsB,mappedValue_append,mappedRead_value,mappedValue_replicate_zbit]
  simp

theorem bitsB_wires (L : CuccaroStreamedSquareWideLayout) :
    mappedWires (bitsB L)=ECDSAAdd.Entrant.accReg L := by
  have h : mappedWires (bitsB L)=mappedWires (mappedRead (ECDSAAdd.Entrant.accReg L) false)++
      mappedWires (List.replicate 93 zbit) := by
    simp [bitsB,mappedWires,List.flatMap_append]
  rw [h,mappedRead_wires,mappedWires_replicate_zbit,List.append_nil]

theorem bitsB_length (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) : (bitsB L).length=256 := by
  simp [bitsB,mappedRead,ECDSAAdd.Entrant.accReg,hw.core.work]

/-- The new accumulator fold: same triple as `accFoldQ_frameKTq`, under two layout facts
(`hnB`, `hbB`) that are decided for the concrete layout. -/
theorem accFoldB_frame (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (hnB : (coreB L).wires.Nodup) (hbB : BitsOK (coreB L) 256 (bitsB L))
    (base : BasisState) (a : AccItem)
    (hv : AccView L base a) (hc : L.PairClean base) (O : Nat) (hO : O<SquareReduction.p) :
    Triple (SquareFrame L.core.out base O) (accFoldB L a)
      (SquareFrame L.core.out base ((Acc.accVal base 0 a.spec+(SquareReduction.p-1-O))%SquareReduction.p)) := by
  intro s m hf
  have lens := acc_lengths L hw
  have clean := L.squareFrame_clean hn base s.basis O hf hc
  let b0 := s.basis
  have prodOut := L.product_out_disjoint hn
  have auxAway (q : Wire) (hq : q∈L.foldPad++L.core.work++[L.core.productHigh,L.core.outHigh,
      L.core.workHigh,L.core.cin,L.core.normFlag,L.core.modFlag]) : q∉L.core.out :=
    (L.pairAuxAway hn q hq).2
  have workZero : ∀q∈L.core.work,b0 q=false := (regValue_zero _ _).mp clean.work
  have padZero : ∀q∈L.foldPad,b0 q=false := (regValue_zero _ _).mp clean.pad
  have hz : ∀q∈accZ L,b0 q=false := by
    intro q hq
    rcases accZ_mem L q hq with h|h
    · exact padZero q h
    · exact workZero q (List.mem_of_mem_drop h)
  have hb : ∀q∈accBank L,b0 q=false := fun q hq => padZero q (List.mem_of_mem_take hq)
  have hW0 : ∀q∈wTemp L,b0 q=false := fun q hq => workZero q (wTemp_work L q hq)
  have prodNotOut (q : Wire) (hq : q∈L.core.product) : q∉L.core.out :=
    fun ho => List.disjoint_left.mp prodOut hq ho
  have agree0 : ∀q∈L.core.product,b0 q=base q := fun q hq => hf.2 q (prodNotOut q hq)
  let A := Acc.accVal base 0 a.spec
  have hA : A<2^163 := Acc.accVal_lt base 163 a.spec 0 (by norm_num) hv.specValid
  have accZero : regValue (ECDSAAdd.Entrant.accReg L) b0=0 :=
    (regValue_zero _ _).mpr (fun q hq => workZero q (accReg_work L q hq))
  have hbuild := OwnDiagAll12Square.fillInK_triple L hw hn base a hv b0 agree0 hz hb clean.cin hW0
  rw [accFoldB,List.append_assoc,run_append,run_append]
  let mb := measurementCount (OwnDiagAll12Square.fillInK L a)
  let mk := measurementCount (midB L)
  let u := run (OwnDiagAll12Square.fillInK L a) (m.take mb) s
  have eu := hbuild s (m.take mb) ⟨accZero,fun _ _ => rfl⟩
  change u.phase=s.phase ∧ SquareFrame (ECDSAAdd.Entrant.accReg L) b0 A u.basis at eu
  have keepU (q : Wire) (hq : q∈L.foldPad++[L.core.productHigh,L.core.outHigh,L.core.workHigh,L.core.cin,
      L.core.normFlag,L.core.modFlag]++L.core.out++L.core.product++L.core.work.drop 163) : u.basis q=b0 q :=
    eu.2.2 q (accReg_away L hn q hq)
  have accU : mappedValue (bitsB L) u.basis=A := by
    rw [bitsB_value]
    exact eu.2.1
  have outU : regValue L.core.out u.basis=O :=
    (regValue_congr _ _ _ (fun q hq => keepU q (by simp [hq]))).trans hf.1
  have hp : SquareReduction.p+SquareReduction.c=2^256 := by
    norm_num [SquareReduction.p,SquareReduction.B,SquareReduction.c]
  have hAp : A<SquareReduction.p := lt_of_lt_of_le hA (by norm_num [SquareReduction.p,SquareReduction.B,SquareReduction.c])
  have carryU : ∀q∈(coreB L).carry,u.basis q=false := by
    intro q hq
    rcases carryB_mem L q hq with h|h|h|h
    · exact (keepU q (by simp [h])).trans (padZero q h)
    · exact (keepU q (by simp [h])).trans (workZero q (List.mem_of_mem_drop h))
    · subst h; exact (keepU _ (by simp)).trans clean.productHigh
    · subst h; exact (keepU _ (by simp)).trans clean.workHigh
  have ek := qprogM_correct (coreB L) 256 SquareReduction.c SquareReduction.p (coreB_widths L hw)
    hnB (bitsB L) hbB (by decide) hp (by norm_num [SquareReduction.c]) A O hAp hO u ((m.drop mb).take mk)
    accU outU ((keepU _ (by simp [coreB])).trans clean.outHigh)
    ((keepU _ (by simp [coreB])).trans clean.modFlag)
    carryU ((keepU _ (by simp [coreB])).trans clean.cin)
  let v := run (midB L) ((m.drop mb).take mk) u
  change v.phase=u.phase ∧ regValue L.core.out v.basis=(A+(SquareReduction.p-1-O))%SquareReduction.p ∧
    ∀q,q∉L.core.out → v.basis q=u.basis q at ek
  let base2 : BasisState := fun q => if q∈L.core.out then v.basis q else b0 q
  have b2off (q : Wire) (hq : q∉L.core.out) : base2 q=b0 q := by simp [base2,hq]
  have accOut (q : Wire) (hq : q∈ECDSAAdd.Entrant.accReg L) : q∉L.core.out :=
    auxAway q (by simp [accReg_work L q hq])
  have frame2 : SquareFrame (ECDSAAdd.Entrant.accReg L) base2 A v.basis := by
    refine ⟨?_,?_⟩
    · exact (regValue_congr _ _ _ (fun q hq => ek.2.2 q (accOut q hq))).trans eu.2.1
    · intro q hq
      by_cases ho : q∈L.core.out
      · simp [base2,ho]
      · rw [b2off q ho,ek.2.2 q ho]; exact eu.2.2 q hq
  have hz2 : ∀q∈accZ L,base2 q=false := by
    intro q hq
    have ho : q∉L.core.out := by
      simp only [accZ,List.mem_append] at hq
      rcases hq with hq|hq
      · exact auxAway q (by simp [List.mem_of_mem_drop hq])
      · exact auxAway q (by simp [List.mem_of_mem_drop hq])
    rw [b2off q ho]; exact hz q hq
  have hb2 : ∀q∈accBank L,base2 q=false := by
    intro q hq
    have ho : q∉L.core.out := auxAway q (by simp [List.mem_of_mem_take hq])
    rw [b2off q ho]; exact hb q hq
  have hi2 : base2 L.core.cin=false := by
    rw [b2off _ (auxAway _ (by simp))]; exact clean.cin
  have hW2 : ∀q∈wTemp L,base2 q=false := by
    intro q hq
    have ho : q∉L.core.out := auxAway q (by simp [wTemp_work L q hq])
    rw [b2off q ho]; exact hW0 q hq
  have agree2 : ∀q∈L.core.product,base2 q=base q :=
    fun q hq => (b2off q (prodNotOut q hq)).trans (agree0 q hq)
  have hun := SourceFourPrefix130Develop.fillOutKnown_triple L hw hn base a hv base2 agree2 hz2 hb2 hi2 hW2
  have eo := hun v ((m.drop mb).drop mk) frame2
  refine ⟨eo.1.trans (ek.1.trans eu.1),?_,?_⟩
  · have e : regValue L.core.out (run (SourceFourPrefix130Develop.fillOutKnown L a) ((m.drop mb).drop mk) v).basis=
        regValue L.core.out v.basis := by
      apply regValue_congr; intro q hq
      have na : q∉ECDSAAdd.Entrant.accReg L := fun h => accOut q h hq
      rw [eo.2.2 q na]; simp [base2,hq]
    rw [e,ek.2.1]
  · intro q hq
    by_cases ha : q∈ECDSAAdd.Entrant.accReg L
    · have z := (regValue_zero _ _).mp eo.2.1 q ha
      rw [z]
      exact ((regValue_zero _ _).mp hc.work q (accReg_work L q ha)).symm
    · rw [eo.2.2 q ha,b2off q hq]; exact hf.2 q hq

/-- Same statement as the record's `eCore_stepTq`, for the new accumulator fold. -/
theorem eCore_stepB (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (hnB : (coreB L).wires.Nodup) (hbB : BitsOK (coreB L) 256 (bitsB L))
    (base : BasisState) (hc : L.PairClean base) (O E : Nat) (hO : O<SquareReduction.p) :
    Triple (BState L base O E 0) (accFoldB L (eItem L))
      (BState L base ((4294968272*E+(SquareReduction.p-1-O))%SquareReduction.p) E 0) := by
  apply lift_out L hn base O E 0 _ (accFoldB L (eItem L))
  intro s m h
  have tr := accFoldB_frame L hw hn hnB hbB s.basis (eItem L) (eItem_view L hw s.basis)
    (bstate_clean L hn base hc O E s.basis h) O hO s m ⟨h.1,fun _ _ => rfl⟩
  have e : Acc.accVal s.basis 0 (eItem L).spec=4294968272*E := by
    rw [show (eItem L).spec=earlyHTerms (eReg L) from rfl,accVal_earlyH,h.2.1]
  rw [e] at tr
  exact ⟨tr.1,tr.2.1,tr.2.2⟩

/-- The new e-fold, in the form used by the B body proof (`tf` of `LocalSevenBody.frame`). -/
theorem eFoldB_step (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (hnB : (coreB L).wires.Nodup) (hbB : BitsOK (coreB L) 256 (bitsB L))
    (c : Wire) (hcw : c∉L.wires) (base : BasisState) (hc : L.PairClean base) (O E : Nat)
    (hO : O<SquareReduction.p) :
    Triple (BState L base O E 0) (eFoldB L c)
      (BState L base ((4294968272*flipE (base c) E+(SquareReduction.p-1-O))%SquareReduction.p) E 0) := by
  have f1 := eFlip_step L hw hn base c hcw O E 0
  have f2 := eCore_stepB L hw hn hnB hbB base hc O (flipE (base c) E) hO
  have f3 := eFlip_step L hw hn base c hcw ((4294968272*flipE (base c) E+(SquareReduction.p-1-O))%SquareReduction.p)
    (flipE (base c) E) 0
  rw [flipE_flipE] at f3
  exact f1.seq (f2.seq f3)

end ECDSAAdd.Entrant.StairSquareBEFold
end Merge_StairSquareBEFold_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareBBody_at_QTop` -/
section Merge_StairSquareBBody_at_QTop

/-! # LT36 (U3b): generic B body frame

`bodyG L fold1 fold2 loop efold rebuild` is the record's `LocalSevenBody.bodyForBoth` with the two
folds and the e-fold as parameters.  `frameG` is `LocalSevenBody.frame` with the fold triples and
the e-fold triple as hypotheses (the proof is the record's, with those three steps replaced). -/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareBBody
open ECDSAAdd Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout
open InverseCarryDevelop ThirdSavedCarryDevelop ControlLoan1589BFFold
open ManyACarryDevelop FullBTemp ZeroReadDevelop FourthASavedCarryDevelop LowAccCarryDevelop
open CarryWindowCache SecondCarryLoan ThirdCarryLoanDevelop FourthCarryLoanDevelop
open LowBitCarryDevelop ParkCarry7Develop ParkCarry10Develop
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 100000000
attribute [local irreducible] ECDSAAdd.wires ECDSAAdd.run


/-! K4-D (replay budget): the bit/bound facts of `frameG` as small standalone lemmas (an `omega` inside
`frameG` works over every hypothesis of the large context, with 2^128-sized constants). -/
namespace K4DB
theorem lt128 (H l : Nat) (h1 : H < 2^96) (h2 : l < 2^32) : 2^32*H + l < 2^128 := by omega
theorem lt129 (H l K : Nat) (h0 : H < 2^96) (h1 : l < 2^32) (h2 : K ≤ 1) : 2^32*H + l + 2^128*K < 2^129 := by
  omega
theorem low0 (H z K : Nat) : (2^32*H + z % 2^32 + 2^128*K) % 2 = z % 2 := by omega
theorem low1 (H z K : Nat) : (2^32*H + z % 2^32 + 2^128*K) / 2 % 2 = z / 2 % 2 := by omega
theorem wrap (X Y : Nat) (hX : X < 2^130) (hY : Y < 2^130) : ((X + 2^130 - Y) % 2^130 + Y) % 2^130 = X := by
  omega
theorem wlt (b : Nat) (h : b < 2^128) : 4294968272*b < 2^163 := by omega
theorem hlt (b : Nat) (h : b < 2^128) : b / 2^32 < 2^96 := by omega
theorem kle (b u : Nat) (hu : u < 2^32) : (b % 2^32 + u) / 2^32 ≤ 1 := by omega
theorem kif (b u : Nat) (hu : u < 2^32) :
    (if (b % 2^32 + u) % 2^32 < u then 1 else 0) = (b % 2^32 + u) / 2^32 := by
  by_cases hc : (b % 2^32 + u) % 2^32 < u
  · rw [if_pos hc]; omega
  · rw [if_neg hc]; omega
end K4DB





end ECDSAAdd.Entrant.StairSquareBBody
end Merge_StairSquareBBody_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSquareBChecks_at_QTop` -/
section Merge_StairSquareBChecks_at_QTop

/-! # LT36 (U3b): concrete kernel checks for the B body pieces (layout `LowAccCarryDevelop.L`)

Hole sites `holesB` = pool 725..759, 761..764 (same term as `StairSqLoopA.holes`).  Every check is a
single `decide +kernel` on a Boolean scan of a concrete program or list. -/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareBChecks
open ECDSAAdd ECDSAAdd.Entrant Arithmetic ControlLoan1589BFFold StairSquareBMapped StairSquareBEFold


def holesB : List Wire := (List.range' 720 40++List.range' 761 4).map Baselines.layout.core.poolWire



/-! ## K4-D (replay budget): the holes and the layout `LB` in closed form

`holesB` walked `List.range' 4115 5699` (`Baselines.layout.core.poolWire`) for every hole; `LB` is
`Baselines.layout.dialogStreamedSquareWide`, whose lists are `take`/`drop` slices of the 5,699-wire pool.
`K4DQ.LB_eq` rewrites `LB` into the same layout with `List.range'` fields (proved symbolically), so the
kernel checks below evaluate short intervals instead of pool slices. -/
namespace K4DQ

theorem pw_lt (i : Nat) (h : i < 5699) : Baselines.layout.core.poolWire i = 4115 + i := by
  show (List.range' 4115 5699).getD i 0 = 4115 + i
  simp [List.getD_eq_getElem?_getD, h]

theorem blk (a n : Nat) (h : a + n ≤ 5699) :
    (List.range' a n).map Baselines.layout.core.poolWire = List.range' (4115 + a) n := by
  rw [← List.map_add_range']
  apply List.map_congr_left
  intro x hx
  rw [List.mem_range'_1] at hx
  exact pw_lt x (by omega)

theorem mr (a n : Nat) : (List.range n).map (· + a) = List.range' a n := by
  rw [List.range'_eq_map_range]
  exact List.map_congr_left (fun x _ => Nat.add_comm x a)

theorem holesB_eq : holesB = List.range' 4835 40 ++ List.range' 4876 4 := by
  have b1 : (List.range' 720 40).map Baselines.layout.core.poolWire = List.range' 4835 40 :=
    blk 720 40 (by decide)
  have b2 : (List.range' 761 4).map Baselines.layout.core.poolWire = List.range' 4876 4 :=
    blk 761 4 (by decide)
  unfold holesB
  rw [List.map_append, b1, b2]

