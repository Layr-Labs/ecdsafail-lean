theorem firstPacket_avoid_payload (divide : Bool) (B : Nat) (hB : B ∈ budgets) :
    ∀ r ∈ futurePayload B, r ∉ wires (Rolling1588.placedFirstPacket divide) := by
  intro r hr hw
  have h1 := Rolling1588.placedFirstPacket_old_support divide hw
  have h2 := ControlLoan1589.placedFirstPacket_support divide h1
  have h3 := Prefix1590.placedFirstPacket_support divide h2
  rw [renameProgram_support] at h3
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp h3
  rw [FrontierSW1591.first_support_eq] at hq
  have h4 := (OneFlagSW.selFirstPacket_sel divide).sub.wires_sub hq
  have h5 := OneFlagReplay.firstPacket_subset_old divide h4
  unfold Q6EndpointReplay.firstPacket at h5
  rw [renameProgram_support] at h5
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp h5
  have k0 : (0 : Nat) < startFor B / 5 := by
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> decide
  have hist : ∀ i : Fin 10, x = History5.historyMap base (5 * 0) i → False := by
    intro i hxi
    subst hxi
    apply history_avoid B hB 0 k0 i
    simpa only [History5.historyMap, shifted_base] using hr
  have cell : ∀ i, x = base i → ¬ Placement5.holeRegion i → i ∈ cellIds → False := by
    intro i hxi hi hc
    subst hxi
    apply placed_cell_avoid B hB 0 (by decide) i hi hc
    simpa only [shifted_base] using hr
  simp only [Q6EndpointReplay.baseFirstPacket, wires_append, Finset.mem_union] at hx
  rcases hx with (hdec | hbody) | henc
  · obtain ⟨i, hi⟩ := History5.history_gate_mem base 0 _ (Or.inr rfl) x hdec
    exact hist i hi
  · have hs := Q6EndpointReplay.firstBody_support divide hbody
    simp only [Q6EndpointReplay.readSites, Q6EndpointReplay.fieldSites, Finset.mem_union,
