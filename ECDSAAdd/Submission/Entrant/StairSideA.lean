  rw [renameProgram_support] at h5
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp h5
  have k0 : (0 : Nat) < startFor B / 5 := by
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    rcases hB with rfl | rfl | rfl | rfl | rfl | rfl <;> decide
  have hist : ∀ i : Fin 10, x = History5.historyMap base (5 * 0) i → False := by
