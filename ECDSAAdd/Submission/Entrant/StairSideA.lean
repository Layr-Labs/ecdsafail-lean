open ECDSAAdd Arithmetic

/-! Run-level integration of the generated codec with the public arithmetic
invariants.  This file is kept separate so the generator and its resource
proofs remain protected-import-only. -/

def packedBits (f : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n + 1 => packedBits f n + if f n then 2 ^ n else 0

theorem fold_range_bits_eq_packedBits (f : Nat → Bool) (n : Nat) :
    (List.range n).foldl
      (fun acc i => if f i then acc + 2 ^ i else acc) 0 = packedBits f n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [List.range_succ, List.foldl_append, ih]
      cases h : f n <;> simp [packedBits, h]

theorem packedBits_bound (f : Nat → Bool) (n : Nat) : packedBits f n < 2 ^ n := by
  induction n with
  | zero => simp [packedBits]
  | succ n ih =>
      cases h : f n <;> simp [packedBits, h, pow_succ] <;> omega

theorem packedBits_testBit (f : Nat → Bool) (n i : Nat) (hi : i < n) :
    (packedBits f n).testBit i = f i := by
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hin : i = n
      · subst i
        cases h : f n
        · simp [packedBits, h, Nat.testBit_lt_two_pow (packedBits_bound f n)]
        · simp only [packedBits, h, Bool.true_eq, if_true]
          rw [Nat.add_comm, Nat.testBit_two_pow_add_eq,
            Nat.testBit_lt_two_pow (packedBits_bound f n)]
          rfl
      · have hi' : i < n := by omega
        cases h : f n
        · simp [packedBits, h, ih hi']
        · simp only [packedBits, h, Bool.true_eq, if_true]
          rw [Nat.add_comm, Nat.testBit_two_pow_add_gt hi']
          exact ih hi'

theorem packedBits_congr (f g : Nat → Bool) (n : Nat)
    (h : ∀ i, i < n → f i = g i) : packedBits f n = packedBits g n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [packedBits, h n (by omega), ih (fun i hi => h i (by omega))]

theorem compactF_eq_packedBits (B w v : Nat) :
    compactF B w v = packedBits (payloadBit B w v) (B - 2) := by
  unfold compactF
  rw [fold_range_bits_eq_packedBits]
  apply packedBits_congr
  intro i hi
  simp [payloadBit, trimmedBit, halfBit, hi]

theorem compactF_testBit (B w v i : Nat) (hi : i < B - 2) :
    (compactF B w v).testBit i = payloadBit B w v i := by
  rw [compactF_eq_packedBits]
  exact packedBits_testBit _ _ _ hi

theorem compactF_bound (B w v : Nat) : compactF B w v < 2 ^ (B - 2) := by
  rw [compactF_eq_packedBits]
  exact packedBits_bound _ _


theorem payloadBit_top_false (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    payloadBit B (u - sigma.toNat) v (B - 2) = false := by
  let w := u - sigma.toNat
  change payloadBit B w v (B - 2) = false
  have hB : 3 ≤ B := hd.1
  have hlen := domain_w_bitLength_le B u v sigma hd
  change natBitLength w ≤ B - 1 at hlen
  simp only [payloadBit, show ¬ B - 2 < B - 2 by omega, if_false, Bool.xor_false]
  unfold trimmedBit
  have hindex : B - 2 + 1 = B - 1 := by omega
  rw [hindex]
  by_cases heq : B - 1 = natBitLength w
  · rw [if_pos heq]
  · rw [if_neg heq]
    apply Nat.testBit_lt_two_pow
    by_cases hw : w = 0
    · rw [hw]
      positivity
    · have hshort : natBitLength w ≤ B - 2 := by omega
      have hpow := nat_lt_pow_natBitLength_spec w (Nat.pos_of_ne_zero hw)
      have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hshort
      exact lt_of_lt_of_le hpow hp


def RealizesUnpackLive (L : Layout) (B : Nat) (st : SweepState)
    (marker : Bool) (basis : BasisState) : Prop :=
  regValue (reg L.A (bitWidth B)) basis = st.a ∧
  basis L.z = st.z ∧ basis L.t = marker ∧
  (∀ i, i < B - 1 → basis (L.D i) = st.d i) ∧
  (∀ i, i < B - 2 → basis (L.S (B - 2 - i)) = st.s (B - 2 - i)) ∧
  (∀ q ∈ (lowDecoder L B).sites, basis q =
    decoderBasis (lowDecoder L B) (lowBits L B)
      (st.a % 2 ^ (bitWidth B / 2)) q) ∧
  (∀ q ∈ (highDecoder L B).sites, basis q =
    decoderBasis (highDecoder L B) (highBits L B)
      (st.a / 2 ^ (bitWidth B / 2)) q)



theorem run_append_zero_left_spec (p q : Program)
    (hz : measurementCount p = 0) (m : List Bool) (s : State) :
    run (p ++ q) m s = run q m (run p m s) := by
  rw [run_append, hz, List.take_zero, List.drop_zero]
  have ht := run_take p m s
  simpa only [hz, List.take_zero] using congrArg (run q m) ht





/-- A controlled decoder delta is an exact conditional transition from the
selected word back to the zero word, with a full outside-sites frame. -/
theorem decoderDelta_run_reverse_bool (d : Decoder) (bits : List Wire) (x : Nat)
    (control : Wire) (hsites : d.sites.Nodup) (hc : control ∉ d.sites)
    (s : State) (m : List Bool)
    (hcurrent : ∀ q ∈ d.sites, s.basis q = decoderBasis d bits x q) :
    (run (cxInto control (decoderDelta d bits x)) m s).phase = s.phase ∧
    (∀ q ∈ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        if s.basis control then decoderBasis d bits 0 q
        else decoderBasis d bits x q) ∧
    (∀ q ∉ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q = s.basis q) := by
  have hdelta : (decoderDelta d bits x).Nodup := hsites.filter _
  have hc' : control ∉ decoderDelta d bits x := by
    intro hm
    exact hc (List.mem_of_mem_filter hm)
  rw [cxInto_run control _ hdelta hc']
  constructor
  · rfl
  constructor
  · intro q hq
    have hcur := hcurrent q hq
    cases hctrl : s.basis control <;>
      cases h0 : decoderBasis d bits 0 q <;>
      cases hxq : decoderBasis d bits x q <;>
      simp_all [decoderDelta, hq]
  · intro q hq
    have hnot : q ∉ decoderDelta d bits x := by
      intro hm
      exact hq (List.mem_of_mem_filter hm)
    cases hctrl : s.basis control <;> simp [hctrl, hnot]

theorem decoderDelta_run_selected (d : Decoder) (bits : List Wire)
    (current x : Nat) (control : Wire) (hsites : d.sites.Nodup)
    (hc : control ∉ d.sites) (s : State) (m : List Bool)
    (hcurrent : ∀ q ∈ d.sites, s.basis q = decoderBasis d bits current q)
    (hselected : s.basis control = true → current = x) :
    (run (cxInto control (decoderDelta d bits x)) m s).phase = s.phase ∧
    (∀ q ∈ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        decoderBasis d bits (if s.basis control then 0 else current) q) ∧
    (∀ q ∉ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q = s.basis q) := by
  cases hctrl : s.basis control
  · have hdelta : (decoderDelta d bits x).Nodup := hsites.filter _
    have hc' : control ∉ decoderDelta d bits x := by
      intro hm
      exact hc (List.mem_of_mem_filter hm)
    rw [cxInto_run control _ hdelta hc']
    constructor
    · rfl
    constructor
    · intro q hq
      simpa [hctrl] using hcurrent q hq
    · intro q hq
      simp [hctrl]
  · have heq := hselected hctrl
    subst current
    simpa [hctrl] using decoderDelta_run_reverse_bool d bits x control hsites hc
      s m hcurrent






theorem lowDecoder_sites (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hclean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false) :
    ∀ q ∈ (lowDecoder L B).sites,
      (run (lowDecoder L B).program m s).basis q =
        decoderBasis (lowDecoder L B) (lowBits L B)
          (value % 2 ^ (bitWidth B / 2)) q := by
  have hbits : ∀ i, i < (lowBits L B).length →
      s.basis ((lowBits L B).getD i 0) =
        (value % 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact lowBits_read L B value i s.basis hvalue hi
  simpa [lowDecoder] using oneHot_run_sites (lowBits L B) L.lowWork
    (lowDecoder_nodup L B hn) s m (value % 2 ^ (bitWidth B / 2)) hbits hclean

theorem highDecoder_sites (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hclean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false) :
    ∀ q ∈ (highDecoder L B).sites,
      (run (highDecoder L B).program m s).basis q =
        decoderBasis (highDecoder L B) (highBits L B)
          (value / 2 ^ (bitWidth B / 2)) q := by
  have hbits : ∀ i, i < (highBits L B).length →
      s.basis ((highBits L B).getD i 0) =
        (value / 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact highBits_read L B value i s.basis hvalue hi
  simpa [highDecoder] using oneHot_run_sites (highBits L B) L.highWork
    (highDecoder_nodup L B hn) s m (value / 2 ^ (bitWidth B / 2)) hbits hclean

/-- The two decoder programs establish their complete generated-site states,
not only the externally selected outputs.  This is the state form consumed by
the controlled decoder deltas in every inverse-sweep step. -/
theorem decoderPair_sites (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false)
    (hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false) :
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      out.basis q = s.basis q) := by
  let lowState := run (lowDecoder L B).program m s
  have hlo := lowDecoder_output L B value hn s m hvalue hbound hlClean
  have hloSites := lowDecoder_sites L B value hn s m hvalue hlClean
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), lowState.basis q = s.basis q := by
    intro q hq
    apply hlo.2.1 q
    intro hsite
    exact sep_A_rest L B hn hq (by simp [hsite]) rfl
  have hAValue : regValue (reg L.A (bitWidth B)) lowState.basis = value :=
    (regValue_congr _ _ _ hAFrame).trans hvalue
  have hhClean' : ∀ q ∈ (highDecoder L B).sites, lowState.basis q = false := by
    intro q hq
    rw [hlo.2.1 q]
    · exact hhClean q hq
    · intro hlq
      exact sep_low_high L B hn hlq hq rfl
  have hhi := highDecoder_output L B value hn lowState m hAValue hbound hhClean'
  have hhiSites := highDecoder_sites L B value hn lowState m hAValue hhClean'
  let out := run (highDecoder L B).program m lowState
  refine ⟨hhi.1.trans hlo.1, ?_, hhiSites, ?_⟩
  · intro q hq
    rw [hhi.2.1 q]
    · exact hloSites q hq
    · intro hhq
      exact sep_low_high L B hn hq hhq rfl
  · intro q hlq hhq
    exact (hhi.2.1 q hhq).trans (hlo.2.1 q hlq)






def aTargets (L : Layout) (B k : Nat) : List Wire :=
  ((List.range (bitWidth B)).filter (fun b => k.testBit b)).map L.A

theorem aTargets_nodup (L : Layout) (B k : Nat) (hn : L.Nodup B) :
    (aTargets L B k).Nodup := by
  have hs : List.Sublist
      ((List.range (bitWidth B)).filter (fun b => k.testBit b))
      (List.range (bitWidth B)) := List.filter_sublist
  have hm := hs.map L.A
  exact (A_nodup L B hn).sublist (by simpa [aTargets, reg] using hm)

theorem aTargets_mem_iff (L : Layout) (B k i : Nat) (hn : L.Nodup B)
    (hi : i < bitWidth B) : L.A i ∈ aTargets L B k ↔ k.testBit i = true := by
  constructor
  · intro hm
    simp only [aTargets, List.mem_map] at hm
    rcases hm with ⟨r, hr, heq⟩
    have hrr := (List.mem_filter.mp hr).1
    have hrb := (List.mem_filter.mp hr).2
    have hre : r = i := by
      apply List.inj_on_of_nodup_map (by simpa only [reg] using A_nodup L B hn)
      · exact hrr
      · exact List.mem_range.mpr hi
      · exact heq
    simpa [hre] using hrb
  · intro hb
    apply List.mem_map.mpr
    refine ⟨i, ?_, rfl⟩
    exact List.mem_filter.mpr ⟨List.mem_range.mpr hi, hb⟩

theorem aTargets_run_value (L : Layout) (B current k : Nat)
    (hn : L.Nodup B) (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = current)
    (hselected : s.basis L.t = true → current = k) :
    let out := run (cxInto L.t (aTargets L B k)) m s
    out.phase = s.phase ∧
    regValue (reg L.A (bitWidth B)) out.basis =
      (if s.basis L.t then 0 else current) ∧
    (∀ q ∉ reg L.A (bitWidth B), out.basis q = s.basis q) := by
  have ht : L.t ∉ aTargets L B k := by
    intro hm
    simp only [aTargets, List.mem_map] at hm
    rcases hm with ⟨i, hi, heq⟩
    have hir := (List.mem_filter.mp hi).1
    have hA : L.A i ∈ reg L.A (bitWidth B) := reg_mem L.A _ i
      (List.mem_range.mp hir)
    exact sep_A_rest L B hn hA (by simp) heq
  rw [cxInto_run L.t _ (aTargets_nodup L B k hn) ht]
  constructor
  · rfl
  constructor
  · cases hctrl : s.basis L.t
    · simpa [hctrl] using hvalue
    · have heq : current = k := hselected hctrl
      apply (regValue_zero (reg L.A (bitWidth B)) _).mpr
      intro q hq
      obtain ⟨i, hi, hqi⟩ := List.mem_iff_getElem.mp hq
      have hwire : (reg L.A (bitWidth B))[i] = L.A i := by simp [reg]
      rw [hwire] at hqi
      have hreg : i < (reg L.A (bitWidth B)).length := hi
      have hget : (reg L.A (bitWidth B)).getD i 0 = L.A i := by
        rw [List.getD_eq_getElem _ _ hreg, hwire]
      have hbit := regValue_getD_testBit (reg L.A (bitWidth B)) i 0 s.basis hreg
      rw [hget, hvalue, heq] at hbit
      rw [← hqi]
      have hi' : i < bitWidth B := by simpa [reg] using hi
      cases hb : k.testBit i
      · have hnot : L.A i ∉ aTargets L B k := by
          rw [aTargets_mem_iff L B k i hn hi']
          simp [hb]
        simp [hctrl, hnot, hbit, hb]
      · have hmem : L.A i ∈ aTargets L B k :=
          (aTargets_mem_iff L B k i hn hi').2 hb
        simp [hctrl, hmem, hbit, hb]
  · intro q hq
    have hnot : q ∉ aTargets L B k := by
      intro hm
      apply hq
      simp only [aTargets, List.mem_map] at hm
      rcases hm with ⟨i, hi, rfl⟩
      exact reg_mem L.A _ i (List.mem_range.mp (List.mem_filter.mp hi).1)
    cases hctrl : s.basis L.t <;> simp [hctrl, hnot]

theorem unpackStep_front (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let out := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    out.phase = s.phase ∧
    out.basis L.t = decide (st.a = k) ∧
    out.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → out.basis q = s.basis q) := by
  let k := j + 1
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have haBound : st.a < 2 ^ bitWidth B := by
    rw [← ha]
    simpa [reg] using regValue_lt (reg L.A (bitWidth B)) s.basis
  have hkB : k < B := by omega
  have hk : k < 2 ^ bitWidth B :=
    lt_of_lt_of_le hkB (bitWidth_bound B (by omega))
  have hsel := pairDecoder_selected_of_sites L B st.a k hn s.basis ha
    haBound hk hlow hhigh
  have hsel' :
      (s.basis (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z) &&
        s.basis (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z)) =
          decide (st.a = k) := by
    rw [hsel]
    simp [eq_comm]
  have hselJ :
      (s.basis (outAt (highDecoder L B) ((j + 1) / 2 ^ (bitWidth B / 2)) L.z) &&
        s.basis (outAt (lowDecoder L B) ((j + 1) % 2 ^ (bitWidth B / 2)) L.z)) =
          decide (st.a = j + 1) := by
    simpa only [k] using hsel'
  have hzt := sep_z_t L B hn
  refine ⟨rfl, ?_, ?_, ?_⟩
  · simp [run, writeBit, Function.update, ht, hselJ, hzt, Ne.symm hzt]
  · simp [run, writeBit, Function.update, ht, hselJ, hz, hzt, Ne.symm hzt]
  · intro q hqt hqz
    simp [run, writeBit, Function.update, hqt, hqz]

theorem unpackStep_rails (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let out := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    out.phase = s.phase ∧
    out.basis L.t = decide (st.a = k) ∧
    out.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    out.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 →
      out.basis (L.S (B - 2 - j)) =
        (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → out.basis q = s.basis q) := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let out := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  have hf := unpackStep_front L B j hn hj st s m hr
  change front.phase = s.phase ∧
    front.basis L.t = decide (st.a = k) ∧
    front.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → front.basis q = s.basis q) at hf
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hDmem : L.D j ∈ reg L.D B := reg_mem L.D B j (by omega)
  have hDt : L.D j ≠ L.t := sep_D_work L B hn hDmem (by simp [workSites])
  have hDz : L.D j ≠ L.z := sep_D_work L B hn hDmem (by simp [workSites])
  have hfD : front.basis (L.D j) = st.d j :=
    (hf.2.2.2 (L.D j) hDt hDz).trans (hdrail j hj)
  have hzt := sep_z_t L B hn
  change out.phase = s.phase ∧
    out.basis L.t = decide (st.a = k) ∧
    out.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    out.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 → out.basis (L.S (B - 2 - j)) =
      (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → out.basis q = s.basis q)
  by_cases hnormal : j < B - 2
  · have hSmem : L.S (B - 2 - j) ∈ reg L.S B :=
      reg_mem L.S B (B - 2 - j) (by omega)
    have hSt : L.S (B - 2 - j) ≠ L.t :=
      sep_S_rest L B hn hSmem (by simp [workSites])
    have hSz : L.S (B - 2 - j) ≠ L.z :=
      sep_S_rest L B hn hSmem (by simp [workSites])
    have hSD : L.S (B - 2 - j) ≠ L.D j :=
      sep_S_rest L B hn hSmem (by simp [workSites, hDmem])
    have hfS : front.basis (L.S (B - 2 - j)) = st.s (B - 2 - j) :=
      (hf.2.2.2 (L.S (B - 2 - j)) hSt hSz).trans (hsrail j hnormal)
    have hout : out = run ([.CCX (L.D j) L.z (L.S (B - 2 - j)),
        .CX (L.S (B - 2 - j)) (L.D j), .CX L.t (L.D j)] : Program) m front := by
      dsimp only [out]
      rw [if_pos hnormal]
      rfl
    refine ⟨by rw [hout]; simpa [run] using hf.1,
      ?_, ?_, ?_, ?_, ?_⟩
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.1, hDt, hSt,
        hSD, Ne.symm hDt, Ne.symm hSt, Ne.symm hSD]
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.2.1, hDz, hSz,
        hSD, Ne.symm hDz, Ne.symm hSz, Ne.symm hSD]
    · rw [hout]
      simp [run, unpackSweepStep, writeBit, Function.update,
        hf.2.1, hf.2.2.1, hfD, hfS, hDt, hDz, hSt, hSz, hSD,
        Ne.symm hDt, Ne.symm hDz, Ne.symm hSt, Ne.symm hSz, Ne.symm hSD,
        hnormal, k]
    · intro _
      rw [hout]
      simp [run, unpackSweepStep, writeBit, Function.update,
        hf.2.1, hf.2.2.1, hfD, hfS, hDt, hDz, hSt, hSz, hSD,
        Ne.symm hDt, Ne.symm hDz, Ne.symm hSt, Ne.symm hSz, Ne.symm hSD,
        hnormal, k]
    · intro q hqt hqz hqD hqS
      rw [hout]
      simp [run, writeBit, Function.update, hqt, hqz, hqD, hqS,
        hf.2.2.2 q hqt hqz]
  · have hout : out = run ([.CX L.t (L.D j)] : Program) m front := by
      dsimp only [out]
      rw [if_neg hnormal]
      rfl
    refine ⟨by rw [hout]; simpa [run] using hf.1,
      ?_, ?_, ?_, ?_, ?_⟩
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.1, hDt, Ne.symm hDt]
    · rw [hout]
      simp [run, writeBit, Function.update, hf.2.2.1, hDz, Ne.symm hDz]
    · rw [hout]
      simp [run, unpackSweepStep, writeBit, Function.update,
        hf.2.1, hf.2.2.1, hfD, hDt, hDz, Ne.symm hDt, Ne.symm hDz,
        hnormal, k]
    · intro h
      contradiction
    · intro q hqt hqz hqD hqS
      rw [hout]
      simp [run, writeBit, Function.update, hqt, hqD,
        hf.2.2.2 q hqt hqz]

theorem unpackStep_decoders (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let rail := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
      (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
    let out := run (cxInto L.t (decoderDelta (highDecoder L B)
      (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        ((unpackSweepStep B j st).a % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        ((unpackSweepStep B j st).a / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      out.basis q = rail.basis q) := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let rail := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
  let out := run (cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
  have hrails := unpackStep_rails L B j hn hj st s m hr
  change rail.phase = s.phase ∧
    rail.basis L.t = decide (st.a = k) ∧
    rail.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    rail.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 → rail.basis (L.S (B - 2 - j)) =
      (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → rail.basis q = s.basis q) at hrails
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hLowRail : ∀ q ∈ (lowDecoder L B).sites, rail.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (st.a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hrails.2.2.2.2.2 q]
    · exact hlow q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
    · have hD : L.D j ≠ q := sep_D_work L B hn (reg_mem L.D B j (by omega))
        (by simp [workSites, hq])
      exact Ne.symm hD
    · have hS : L.S (B - 2 - j) ≠ q := sep_S_rest L B hn
        (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hq])
      exact Ne.symm hS
  have htLow : L.t ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have hselectLow : rail.basis L.t = true →
      st.a % 2 ^ (bitWidth B / 2) = k % 2 ^ (bitWidth B / 2) := by
    intro htrue
    rw [hrails.2.1] at htrue
    have heq : st.a = k := by simpa using htrue
    rw [heq]
  have hlo := decoderDelta_run_selected (lowDecoder L B) (lowBits L B)
    (st.a % 2 ^ (bitWidth B / 2)) (k % 2 ^ (bitWidth B / 2)) L.t
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 htLow rail m
    hLowRail hselectLow
  have hHighRail : ∀ q ∈ (highDecoder L B).sites, rail.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (st.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hrails.2.2.2.2.2 q]
    · exact hhigh q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
    · have hD : L.D j ≠ q := sep_D_work L B hn (reg_mem L.D B j (by omega))
        (by simp [workSites, hq])
      exact Ne.symm hD
    · have hS : L.S (B - 2 - j) ≠ q := sep_S_rest L B hn
        (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hq])
      exact Ne.symm hS
  have htHigh : L.t ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have hlowT : lowState.basis L.t = rail.basis L.t := hlo.2.2 L.t htLow
  have hHighLowState : ∀ q ∈ (highDecoder L B).sites, lowState.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (st.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hlo.2.2 q]
    · exact hHighRail q hq
    · intro hlq
      exact sep_low_high L B hn hlq hq rfl
  have hselectHigh : lowState.basis L.t = true →
      st.a / 2 ^ (bitWidth B / 2) = k / 2 ^ (bitWidth B / 2) := by
    intro htrue
    rw [hlowT, hrails.2.1] at htrue
    have heq : st.a = k := by simpa using htrue
    rw [heq]
  have hhi := decoderDelta_run_selected (highDecoder L B) (highBits L B)
    (st.a / 2 ^ (bitWidth B / 2)) (k / 2 ^ (bitWidth B / 2)) L.t
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 htHigh lowState m
    hHighLowState hselectHigh
  have hnextA : (unpackSweepStep B j st).a =
      (if rail.basis L.t then 0 else st.a) := by
    rw [hrails.2.1]
    rfl
  change out.phase = s.phase ∧ _
  refine ⟨hhi.1.trans (hlo.1.trans hrails.1), ?_, ?_, ?_⟩
  · intro q hq
    rw [hhi.2.2 q]
    · rw [hlo.2.1 q hq, hnextA]
      cases rail.basis L.t <;> simp
    · intro hhq
      exact sep_low_high L B hn hq hhq rfl
  · intro q hq
    rw [hhi.2.1 q hq, hlowT, hnextA]
    cases rail.basis L.t <;> simp
  · intro q hlq hhq
    exact (hhi.2.2 q hhq).trans (hlo.2.2 q hlq)

theorem unpackStep_live (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj : j < B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let rail := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
      (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
    let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
      (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
    let out := run (cxInto L.t (aTargets L B k)) m decoderState
    out.phase = s.phase ∧
      RealizesUnpackLive L B (unpackSweepStep B j st)
        (decide (st.a = k)) out.basis := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let rail := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
  let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
  let out := run (cxInto L.t (aTargets L B k)) m decoderState
  have hrails := unpackStep_rails L B j hn hj st s m hr
  change rail.phase = s.phase ∧
    rail.basis L.t = decide (st.a = k) ∧
    rail.basis L.z = (st.z ^^ decide (st.a = k)) ∧
    rail.basis (L.D j) = (unpackSweepStep B j st).d j ∧
    (j < B - 2 → rail.basis (L.S (B - 2 - j)) =
      (unpackSweepStep B j st).s (B - 2 - j)) ∧
    (∀ q, q ≠ L.t → q ≠ L.z → q ≠ L.D j →
      q ≠ L.S (B - 2 - j) → rail.basis q = s.basis q) at hrails
  have hdec := unpackStep_decoders L B j hn hj st s m hr
  change decoderState.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, decoderState.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        ((unpackSweepStep B j st).a % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, decoderState.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        ((unpackSweepStep B j st).a / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      decoderState.basis q = rail.basis q) at hdec
  rcases hr with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hArail : ∀ q ∈ reg L.A (bitWidth B), rail.basis q = s.basis q := by
    intro q hq
    apply hrails.2.2.2.2.2 q
    · exact sep_A_rest L B hn hq (by simp)
    · exact sep_A_rest L B hn hq (by simp)
    · exact Ne.symm (sep_D_work L B hn (reg_mem L.D B j (by omega))
        (by simp [workSites, hq]))
    · exact Ne.symm (sep_S_rest L B hn
        (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hq]))
  have hAdecoder : ∀ q ∈ reg L.A (bitWidth B),
      decoderState.basis q = s.basis q := by
    intro q hq
    rw [hdec.2.2.2 q]
    · exact hArail q hq
    · intro hlq
      exact sep_A_rest L B hn hq (by simp [hlq]) rfl
    · intro hhq
      exact sep_A_rest L B hn hq (by simp [hhq]) rfl
  have hAvalue : regValue (reg L.A (bitWidth B)) decoderState.basis = st.a :=
    (regValue_congr _ _ _ hAdecoder).trans ha
  have htLow : L.t ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have htHigh : L.t ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have htDecoder : decoderState.basis L.t = rail.basis L.t :=
    hdec.2.2.2 L.t htLow htHigh
  have hselected : decoderState.basis L.t = true → st.a = k := by
    intro htrue
    rw [htDecoder, hrails.2.1] at htrue
    simpa using htrue
  have hAout := aTargets_run_value L B st.a k hn decoderState m hAvalue hselected
  change out.phase = decoderState.phase ∧
    regValue (reg L.A (bitWidth B)) out.basis =
      (if decoderState.basis L.t then 0 else st.a) ∧
    (∀ q ∉ reg L.A (bitWidth B), out.basis q = decoderState.basis q) at hAout
  have hnextA : (unpackSweepStep B j st).a =
      (if decoderState.basis L.t then 0 else st.a) := by
    rw [htDecoder, hrails.2.1]
    rfl
  have hnotA_D (i : Nat) (hi : i < B) : L.D i ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_D_work L B hn (reg_mem L.D B i hi) (by simp [workSites, hq]) rfl
  have hnotA_S (i : Nat) (hi : i < B) : L.S i ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_S_rest L B hn (reg_mem L.S B i hi) (by simp [workSites, hq]) rfl
  have hnotA_z : L.z ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_A_rest L B hn hq (by simp) rfl
  have hnotA_t : L.t ∉ reg L.A (bitWidth B) := by
    intro hq
    exact sep_A_rest L B hn hq (by simp) rfl
  have hpost (q : Wire) (hAq : q ∉ reg L.A (bitWidth B))
      (hlq : q ∉ (lowDecoder L B).sites)
      (hhq : q ∉ (highDecoder L B).sites) : out.basis q = rail.basis q :=
    (hAout.2.2 q hAq).trans (hdec.2.2.2 q hlq hhq)
  have hzPost : out.basis L.z = (unpackSweepStep B j st).z := by
    rw [hpost L.z hnotA_z]
    · exact hrails.2.2.1
    · intro hq
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq) rfl
    · intro hq
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have htPost : out.basis L.t = decide (st.a = k) := by
    rw [hpost L.t hnotA_t htLow htHigh, hrails.2.1]
  have hDPost : ∀ i, i < B - 1 →
      out.basis (L.D i) = (unpackSweepStep B j st).d i := by
    intro i hi
    have hDi : L.D i ∈ reg L.D B := reg_mem L.D B i (by omega)
    have hlD : L.D i ∉ (lowDecoder L B).sites := by
      intro hq
      exact sep_D_work L B hn hDi (by simp [workSites, hq]) rfl
    have hhD : L.D i ∉ (highDecoder L B).sites := by
      intro hq
      exact sep_D_work L B hn hDi (by simp [workSites, hq]) rfl
    rw [hpost (L.D i) (hnotA_D i (by omega)) hlD hhD]
    by_cases hij : i = j
    · subst i
      exact hrails.2.2.2.1
    · rw [hrails.2.2.2.2.2 (L.D i)]
      · rw [hdrail i hi]
        simp [unpackSweepStep, hij]
      · exact sep_D_work L B hn hDi (by simp [workSites])
      · exact sep_D_work L B hn hDi (by simp [workSites])
      · exact reg_ne L.D B i j (D_nodup L B hn) (by omega) (by omega) hij
      · exact Ne.symm (sep_S_rest L B hn
          (reg_mem L.S B (B - 2 - j) (by omega)) (by simp [workSites, hDi]))
  have hSPost : ∀ i, i < B - 2 →
      out.basis (L.S (B - 2 - i)) =
        (unpackSweepStep B j st).s (B - 2 - i) := by
    intro i hi
    have hindex : B - 2 - i < B := by omega
    have hSi : L.S (B - 2 - i) ∈ reg L.S B :=
      reg_mem L.S B (B - 2 - i) hindex
    have hlS : L.S (B - 2 - i) ∉ (lowDecoder L B).sites := by
      intro hq
      exact sep_S_rest L B hn hSi (by simp [workSites, hq]) rfl
    have hhS : L.S (B - 2 - i) ∉ (highDecoder L B).sites := by
      intro hq
      exact sep_S_rest L B hn hSi (by simp [workSites, hq]) rfl
    rw [hpost _ (hnotA_S _ hindex) hlS hhS]
    by_cases hij : i = j
    · subst i
      exact hrails.2.2.2.2.1 hi
    · have hmirror : B - 2 - i ≠ B - 2 - j := by
        intro heq
        apply hij
        exact (tsub_right_inj (by omega) (by omega)).mp heq
      rw [hrails.2.2.2.2.2 (L.S (B - 2 - i))]
      · rw [hsrail i hi]
        simp [unpackSweepStep, hij, hmirror]
      · exact sep_S_rest L B hn hSi (by simp [workSites])
      · exact sep_S_rest L B hn hSi (by simp [workSites])
      · exact sep_S_rest L B hn hSi
          (by exact List.mem_append_left (workSites L B) (reg_mem L.D B j (by omega)))
      · exact reg_ne L.S B (B - 2 - i) (B - 2 - j) (S_nodup L B hn)
          hindex (by omega) hmirror
  have hLowPost : ∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        ((unpackSweepStep B j st).a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hAout.2.2 q]
    · exact hdec.2.1 q hq
    · intro hAq
      exact sep_A_rest L B hn hAq (by simp [hq]) rfl
  have hHighPost : ∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        ((unpackSweepStep B j st).a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hAout.2.2 q]
    · exact hdec.2.2.1 q hq
    · intro hAq
      exact sep_A_rest L B hn hAq (by simp [hq]) rfl
  refine ⟨hAout.1.trans hdec.1, ?_⟩
  exact ⟨hAout.2.1.trans hnextA.symm, hzPost, htPost, hDPost, hSPost,
    hLowPost, hHighPost⟩

theorem unpackStep_staged_correct (L : Layout) (B u v j : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (hj : j < B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : UnpackSweepInvariant B u v sigma j st)
    (hr : RealizesUnpackSweep L B st s.basis) :
    let k := j + 1
    let front := run ([.CCX
      (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
      (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
      .CX L.t L.z] : Program) m s
    let rail := run ((if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
      [.CX L.t (L.D j)]) m front
    let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
      (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
    let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
      (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
    let live := run (cxInto L.t (aTargets L B k)) m decoderState
    let out := run ([.measureX L.t [] [.CZ (L.D j) L.z]] : Program) m live
    out.phase = s.phase ∧
      RealizesUnpackSweep L B (unpackSweepStep B j st) out.basis := by
  let k := j + 1
  let front := run ([.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z] : Program) m s
  let rail := run ((if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++
    [.CX L.t (L.D j)]) m front
  let lowState := run (cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))) m rail
  let decoderState := run (cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))) m lowState
  let live := run (cxInto L.t (aTargets L B k)) m decoderState
  let out := run ([.measureX L.t [] [.CZ (L.D j) L.z]] : Program) m live
  have hlive := unpackStep_live L B j hn hj st s m hr
  change live.phase = s.phase ∧
    RealizesUnpackLive L B (unpackSweepStep B j st)
      (decide (st.a = k)) live.basis at hlive
  rcases hlive.2 with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  let w := u - sigma.toNat
  have hinv' := hinv
  change j ≤ B - 1 ∧ st.z = decide (w < 2 ^ j) ∧
    st.a = (if j < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      st.d i = if i < j then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      st.s (B - 2 - i) = if i < j then halfBit B v i else false) at hinv'
  have hnextInv := unpackSweepStep_invariant B u v sigma j hd hj st hinv
  change j + 1 ≤ B - 1 ∧
    (unpackSweepStep B j st).z = decide (w < 2 ^ (j + 1)) ∧
    (unpackSweepStep B j st).a =
      (if j + 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      (unpackSweepStep B j st).d i =
        if i < j + 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 →
      (unpackSweepStep B j st).s (B - 2 - i) =
        if i < j + 1 then halfBit B v i else false) at hnextInv
  have hmarker : decide (st.a = k) = unpackMarker w j := by
    rw [hinv'.2.2.1]
    simpa [k] using unpack_marker_from_a w j
  have hnextD : (unpackSweepStep B j st).d j = w.testBit j := by
    simpa using hnextInv.2.2.2.1 j hj
  have htValue : live.basis L.t =
      (live.basis (L.D j) && live.basis L.z) := by
    rw [ht, hdrail j hj, hz, hmarker, hnextD, hnextInv.2.1]
    exact (unsweep_t_fix w j).symm
  have hDt : L.D j ≠ L.t := sep_D_work L B hn
    (reg_mem L.D B j (by omega)) (by simp [workSites])
  have hout := erase_and_correct L.t (L.D j) L.z hDt
    (sep_z_t L B hn) live htValue m
  change out = ⟨live.phase, writeBit live.basis L.t false⟩ at hout
  have hframe (q : Wire) (hqt : q ≠ L.t) : out.basis q = live.basis q := by
    rw [hout]
    simp [writeBit, hqt]
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), out.basis q = live.basis q := by
    intro q hq
    apply hframe q
    exact sep_A_rest L B hn hq (by simp)
  change out.phase = s.phase ∧
    RealizesUnpackSweep L B (unpackSweepStep B j st) out.basis
  refine ⟨by rw [hout]; exact hlive.1, ?_⟩
  refine ⟨(regValue_congr _ _ _ hAFrame).trans ha, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hframe L.z (sep_z_t L B hn)]
    exact hz
  · rw [hout]
    simp [writeBit]
  · intro i hi
    rw [hframe (L.D i)]
    · exact hdrail i hi
    · exact sep_D_work L B hn (reg_mem L.D B i (by omega)) (by simp [workSites])
  · intro i hi
    rw [hframe (L.S (B - 2 - i))]
    · exact hsrail i hi
    · exact sep_S_rest L B hn (reg_mem L.S B (B - 2 - i) (by omega))
        (by simp [workSites])
  · intro q hq
    rw [hframe q]
    · exact hlow q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
  · intro q hq
    rw [hframe q]
    · exact hhigh q hq
    · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))

/-- Exact generated-program form of one ascending inverse-sweep position. -/
theorem unpackStep_correct (L : Layout) (B u v j : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (hj : j < B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : UnpackSweepInvariant B u v sigma j st)
    (hr : RealizesUnpackSweep L B st s.basis) :
    (run (unpackStep L B j) m s).phase = s.phase ∧
      RealizesUnpackSweep L B (unpackSweepStep B j st)
        (run (unpackStep L B j) m s).basis := by
  let k := j + 1
  let p0 : Program := [.CCX
    (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z)
    (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z) L.t,
    .CX L.t L.z]
  let p12 : Program := (if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)] else []) ++ [.CX L.t (L.D j)]
  let pLow := cxInto L.t (decoderDelta (lowDecoder L B)
    (lowBits L B) (k % 2 ^ (bitWidth B / 2)))
  let pHigh := cxInto L.t (decoderDelta (highDecoder L B)
    (highBits L B) (k / 2 ^ (bitWidth B / 2)))
  let pA := cxInto L.t (aTargets L B k)
  let pM : Program := [.measureX L.t [] [.CZ (L.D j) L.z]]
  let front := run p0 m s
  let rail := run p12 m front
  let lowState := run pLow m rail
  let decoderState := run pHigh m lowState
  let live := run pA m decoderState
  let out := run pM m live
  have hs := unpackStep_staged_correct L B u v j sigma hd hn hj st s m hinv hr
  change out.phase = s.phase ∧
    RealizesUnpackSweep L B (unpackSweepStep B j st) out.basis at hs
  have hshape : unpackStep L B j =
      p0 ++ (p12 ++ (pLow ++ (pHigh ++ (pA ++ pM)))) := by
    simp [unpackStep, k, p0, p12, pLow, pHigh, pA, pM, aTargets,
      List.append_assoc]
  have hz0 : measurementCount p0 = 0 := by simp [p0, measurementCount]
  have hz12 : measurementCount p12 = 0 := by
    by_cases hnormal : j < B - 2 <;> simp [p12, hnormal, measurementCount]
  have hzLow : measurementCount pLow = 0 := by
    exact cxInto_measurementCount _ _
  have hzHigh : measurementCount pHigh = 0 := by
    exact cxInto_measurementCount _ _
  have hzA : measurementCount pA = 0 := by
    exact cxInto_measurementCount _ _
  have hrun : run (unpackStep L B j) m s = out := by
    rw [hshape]
    rw [run_append_zero_left_spec p0 _ hz0]
    rw [run_append_zero_left_spec p12 _ hz12]
    rw [run_append_zero_left_spec pLow _ hzLow]
    rw [run_append_zero_left_spec pHigh _ hzHigh]
    rw [run_append_zero_left_spec pA _ hzA]
  rw [hrun]
  exact hs

def unpackSweepProgram (L : Layout) (B : Nat) : Nat → Nat → Program
  | _, 0 => []
  | j, n + 1 => unpackStep L B j ++ unpackSweepProgram L B (j + 1) n

theorem unpackSweepProgram_eq_range (L : Layout) (B j n : Nat) :
    unpackSweepProgram L B j n =
      (List.range' j n).flatMap (unpackStep L B) := by
  induction n generalizing j with
  | zero => rfl
  | succ n ih =>
      simp [unpackSweepProgram, List.range'_succ, ih]

theorem unpackSweepProgram_correct (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (j n : Nat)
    (hjn : j + n ≤ B - 1) (st : SweepState) (s : State) (m : List Bool)
    (hinv : UnpackSweepInvariant B u v sigma j st)
    (hr : RealizesUnpackSweep L B st s.basis) :
    (run (unpackSweepProgram L B j n) m s).phase = s.phase ∧
    RealizesUnpackSweep L B (unpackSweepRun B j n st)
      (run (unpackSweepProgram L B j n) m s).basis := by
  induction n generalizing j st s m with
  | zero =>
      constructor
      · rfl
      · exact hr
  | succ n ih =>
      have hj : j < B - 1 := by omega
      have hnext : j + 1 + n ≤ B - 1 := by omega
      let first := run (unpackStep L B j)
        (m.take (measurementCount (unpackStep L B j))) s
      have hfirst := unpackStep_correct L B u v j sigma hd hn hj st s
        (m.take (measurementCount (unpackStep L B j))) hinv hr
      change first.phase = s.phase ∧
        RealizesUnpackSweep L B (unpackSweepStep B j st) first.basis at hfirst
      have hinvNext := unpackSweepStep_invariant B u v sigma j hd hj st hinv
      have hrest := ih (j + 1) hnext (unpackSweepStep B j st) first
        (m.drop (measurementCount (unpackStep L B j))) hinvNext hfirst.2
      rw [unpackSweepProgram, run_append]
      change (run (unpackSweepProgram L B (j + 1) n)
        (m.drop (measurementCount (unpackStep L B j))) first).phase = s.phase ∧ _
      refine ⟨hrest.1.trans hfirst.1, ?_⟩
      simpa [unpackSweepRun] using hrest.2

theorem unpackSweepProgram_zero_eq (L : Layout) (B : Nat) (hmin : 3 ≤ B) :
    unpackSweepProgram L B 0 (B - 1) =
      (List.range (B - 2)).flatMap (unpackStep L B) ++
        unpackStep L B (B - 2) := by
  rw [unpackSweepProgram_eq_range]
  have hB : B - 1 = (B - 2) + 1 := by omega
  rw [hB, List.range'_concat, List.flatMap_append]
  rw [← List.range_eq_range']
  simp


theorem compact_decoderPair_output (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let value := natBitLength (u - sigma.toNat)
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧ PairDecoderOneHotAt L B value out.basis ∧
      (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
        out.basis q = s.basis q) := by
  let value := natBitLength (u - sigma.toNat)
  change regValue (reg L.A (bitWidth B)) s.basis = value ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc
  have hbound : value < 2 ^ bitWidth B := by
    have hlen := domain_w_bitLength_le B u v sigma hd
    have hB : 3 ≤ B := hd.1
    calc
      value ≤ B - 1 := hlen
      _ < B := by omega
      _ ≤ 2 ^ bitWidth B := bitWidth_bound B (by omega)
  have hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inl (Or.inr hq)
  have hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inr hq
  exact decoderPair_output L B value hn s m hc.1 hbound hlClean hhClean

theorem compact_decoderPair_sites (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let value := natBitLength (u - sigma.toNat)
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
      out.basis q = s.basis q) := by
  let value := natBitLength (u - sigma.toNat)
  change regValue (reg L.A (bitWidth B)) s.basis = value ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc
  have hbound : value < 2 ^ bitWidth B := by
    have hlen := domain_w_bitLength_le B u v sigma hd
    have hB : 3 ≤ B := hd.1
    calc
      value ≤ B - 1 := hlen
      _ < B := by omega
      _ ≤ 2 ^ bitWidth B := bitWidth_bound B (by omega)
  have hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inl (Or.inr hq)
  have hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false := by
    intro q hq
    apply hc.2.2.2.2.2 q
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    exact Or.inr hq
  exact decoderPair_sites L B value hn s m hc.1 hbound hlClean hhClean

/-- The concrete decoder controls immediately after the two unpack decoder
programs select zero exactly for the terminal magnitude. -/
theorem compact_initial_decoder_marker (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧
    (out.basis (outAt (highDecoder L B) 0 L.z) &&
      out.basis (outAt (lowDecoder L B) 0 L.z)) =
        decide (u - sigma.toNat < 1) := by
  let lowState := run (lowDecoder L B).program m s
  let out := run (highDecoder L B).program m lowState
  have hp := compact_decoderPair_output L B u v sigma hd hn s m hc
  refine ⟨hp.1, ?_⟩
  have hm := initial_split_decoder_selected (bitWidth B / 2)
    (u - sigma.toNat)
    (decoderValue (lowDecoder L B) out.basis)
    (decoderValue (highDecoder L B) out.basis) hp.2.1
  have hlo : 0 < (lowDecoder L B).outputs.length := by
    rw [lowDecoder, oneHot_outputs_length]
    positivity
  have hhi : 0 < (highDecoder L B).outputs.length := by
    rw [highDecoder, oneHot_outputs_length]
    positivity
  have hloFallback : outAt (lowDecoder L B) 0 L.z =
      outAt (lowDecoder L B) 0 0 := by
    simp only [outAt]
    rw [List.getD_eq_getElem _ _ hlo, List.getD_eq_getElem _ _ hlo]
  have hhiFallback : outAt (highDecoder L B) 0 L.z =
      outAt (highDecoder L B) 0 0 := by
    simp only [outAt]
    rw [List.getD_eq_getElem _ _ hhi, List.getD_eq_getElem _ _ hhi]
  simpa [out, lowState, decoderValue, hlo, hhi, hloFallback, hhiFallback] using hm

theorem ccx_clean_target (a b target : Wire) (s : State) (m : List Bool)
    (hclean : s.basis target = false) :
    let out := run ([.CCX a b target] : Program) m s
    out.phase = s.phase ∧
    out.basis target = (s.basis a && s.basis b) ∧
    (∀ q, q ≠ target → out.basis q = s.basis q) := by
  simp [run, writeBit, hclean]
  intro q hq
  simp [Function.update, hq]

/-- The initial CCX of `unpack` turns the decoder-zero product into the
thermometer bit and leaves the split decoder invariant intact. -/
theorem compact_initial_z (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let lowState := run (lowDecoder L B).program m s
    let decoderState := run (highDecoder L B).program m lowState
    let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
    out.phase = s.phase ∧
    out.basis L.z = decide (u - sigma.toNat < 1) ∧
    PairDecoderOneHotAt L B (natBitLength (u - sigma.toNat)) out.basis := by
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  have hp := compact_decoderPair_output L B u v sigma hd hn s m hc
  have hm := compact_initial_decoder_marker L B u v sigma hd hn s m hc
  have hc' := hc
  change regValue (reg L.A (bitWidth B)) s.basis = natBitLength (u - sigma.toNat) ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc'
  have hzInput : s.basis L.z = false := by
    apply hc'.2.2.2.2.2 L.z
    simp
  have hzLow : L.z ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have hzHigh : L.z ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have hzDecoder : decoderState.basis L.z = false := by
    exact (hp.2.2 L.z hzLow hzHigh).trans hzInput
  have hgate := ccx_clean_target (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z decoderState m hzDecoder
  have hpair : PairDecoderOneHotAt L B (natBitLength (u - sigma.toNat)) out.basis := by
    rcases hp.2.1 with ⟨hlow, hhigh⟩
    constructor
    · intro i
      rw [← hlow i]
      unfold decoderValue
      split
      next hi =>
        rw [hgate.2.2]
        have heq : outAt (lowDecoder L B) i 0 =
            outAt (lowDecoder L B) i L.z := by
          simp only [outAt]
          rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hi]
        rw [heq]
        exact low_output_ne_z L B i hn hi
      next => rfl
    · intro i
      rw [← hhigh i]
      unfold decoderValue
      split
      next hi =>
        rw [hgate.2.2]
        have heq : outAt (highDecoder L B) i 0 =
            outAt (highDecoder L B) i L.z := by
          simp only [outAt]
          rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hi]
        rw [heq]
        exact high_output_ne_z L B i hn hi
      next => rfl
  refine ⟨hgate.1.trans hp.1, ?_, hpair⟩
  rw [hgate.2.1]
  exact hm.2

/-- Complete generated-site state after the initial inverse-sweep marker CCX.
The marker target is disjoint from both decoder work areas, so their exact
internal basis states survive unchanged. -/
theorem compact_initial_z_sites (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let value := natBitLength (u - sigma.toNat)
    let lowState := run (lowDecoder L B).program m s
    let decoderState := run (highDecoder L B).program m lowState
    let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
    out.phase = s.phase ∧
    (∀ q ∈ (lowDecoder L B).sites, out.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q) ∧
    (∀ q ∈ (highDecoder L B).sites, out.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) := by
  let value := natBitLength (u - sigma.toNat)
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  have hp := compact_decoderPair_sites L B u v sigma hd hn s m hc
  have hinit := compact_initial_z L B u v sigma hd hn s m hc
  refine ⟨hinit.1, ?_, ?_⟩
  · intro q hq
    have hqz : q ≠ L.z := by
      exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq))
    change (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q = _
    rw [show (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q =
        decoderState.basis q by simp [run, writeBit, hqz]]
    exact hp.2.1 q hq
  · intro q hq
    have hqz : q ≠ L.z := by
      exact Ne.symm (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq))
    change (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q = _
    rw [show (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q =
        decoderState.basis q by simp [run, writeBit, hqz]]
    exact hp.2.2.1 q hq

/-- The concrete prefix of `unpack` realizes LT8's scalar inverse-sweep
initial state, including all rail bits and complete decoder work states. -/
theorem compact_initial_realizes (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let lowState := run (lowDecoder L B).program m s
    let decoderState := run (highDecoder L B).program m lowState
    let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
    out.phase = s.phase ∧
      RealizesUnpackSweep L B
        (initialUnpackSweepState B (u - sigma.toNat) v) out.basis := by
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let out := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  have hp := compact_decoderPair_sites L B u v sigma hd hn s m hc
  have hz := compact_initial_z L B u v sigma hd hn s m hc
  have hsites := compact_initial_z_sites L B u v sigma hd hn s m hc
  have hframe (q : Wire) (hqz : q ≠ L.z)
      (hl : q ∉ (lowDecoder L B).sites)
      (hh : q ∉ (highDecoder L B).sites) : out.basis q = s.basis q := by
    change (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q = _
    rw [show (run ([.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState).basis q =
        decoderState.basis q by simp [run, writeBit, hqz]]
    exact hp.2.2.2 q hl hh
  have hc' := hc
  change regValue (reg L.A (bitWidth B)) s.basis = natBitLength (u - sigma.toNat) ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc'
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), out.basis q = s.basis q := by
    intro q hq
    apply hframe q
    · exact sep_A_rest L B hn hq (by simp) 
    · intro hsite
      exact sep_A_rest L B hn hq (by simp [hsite]) rfl
    · intro hsite
      exact sep_A_rest L B hn hq (by simp [hsite]) rfl
  have htInput : s.basis L.t = false := by
    apply hc'.2.2.2.2.2 L.t
    simp
  have htOut : out.basis L.t = false := by
    rw [hframe L.t (Ne.symm (sep_z_t L B hn))]
    · exact htInput
    · intro hsite
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hsite) rfl
    · intro hsite
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hsite) rfl
  have hSZero : ∀ q ∈ reg L.S B, s.basis q = false :=
    (regValue_zero (reg L.S B) s.basis).mp hc'.2.2.2.2.1
  refine ⟨hz.1, ?_⟩
  change RealizesUnpackSweep L B
    (initialUnpackSweepState B (u - sigma.toNat) v) out.basis
  refine ⟨(regValue_congr _ _ _ hAFrame).trans hc'.1, hz.2.1, htOut, ?_, ?_,
    hsites.2.1, hsites.2.2⟩
  · intro i hi
    change out.basis (L.D i) = payloadBit B (u - sigma.toNat) v i
    have hDi : L.D i ∈ reg L.D B := reg_mem L.D B i (by omega)
    have hDFrame : out.basis (L.D i) = s.basis (L.D i) := by
      apply hframe (L.D i)
      · exact sep_D_work L B hn hDi (by simp [workSites])
      · intro hsite
        exact sep_D_work L B hn hDi (by simp [workSites, hsite]) rfl
      · intro hsite
        exact sep_D_work L B hn hDi (by simp [workSites, hsite]) rfl
    by_cases hilow : i < B - 2
    · have hreg : i < (reg L.D (B - 2)).length := by simpa [reg] using hilow
      have hwire : (reg L.D (B - 2)).getD i 0 = L.D i := by
        rw [List.getD_eq_getElem _ _ hreg]
        simp [reg]
      have hbit := regValue_getD_testBit (reg L.D (B - 2)) i 0 s.basis hreg
      rw [hwire] at hbit
      rw [hc'.2.1] at hbit
      rw [hDFrame]
      exact hbit.trans (compactF_testBit B (u - sigma.toNat) v i hilow)
    · have hitop : i = B - 2 := by omega
      subst i
      rw [hDFrame, hc'.2.2.1]
      exact (payloadBit_top_false B u v sigma hd).symm
  · intro i hi
    have hindex : B - 2 - i < B := by omega
    have hSi : L.S (B - 2 - i) ∈ reg L.S B :=
      reg_mem L.S B (B - 2 - i) hindex
    have hSFrame : out.basis (L.S (B - 2 - i)) = s.basis (L.S (B - 2 - i)) := by
      apply hframe (L.S (B - 2 - i))
      · exact sep_S_rest L B hn hSi (by simp [workSites])
      · intro hsite
        exact sep_S_rest L B hn hSi (by simp [workSites, hsite]) rfl
      · intro hsite
        exact sep_S_rest L B hn hSi (by simp [workSites, hsite]) rfl
    rw [hSFrame, hSZero _ hSi]
    rfl

theorem compact_unpack_sweep (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let init : Program := (lowDecoder L B).program ++ (highDecoder L B).program ++
      [.CCX (outAt (highDecoder L B) 0 L.z)
        (outAt (lowDecoder L B) 0 L.z) L.z]
    let sweepPrefix := init ++ unpackSweepProgram L B 0 (B - 1)
    let out := run sweepPrefix m s
    out.phase = s.phase ∧
    RealizesUnpackSweep L B
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) out.basis := by
  let init : Program := (lowDecoder L B).program ++ (highDecoder L B).program ++
    [.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z]
  let sweepPrefix := init ++ unpackSweepProgram L B 0 (B - 1)
  let lowState := run (lowDecoder L B).program m s
  let decoderState := run (highDecoder L B).program m lowState
  let initial := run ([.CCX (outAt (highDecoder L B) 0 L.z)
    (outAt (lowDecoder L B) 0 L.z) L.z] : Program) m decoderState
  let out := run sweepPrefix m s
  have hi := compact_initial_realizes L B u v sigma hd hn s m hc
  change initial.phase = s.phase ∧
    RealizesUnpackSweep L B
      (initialUnpackSweepState B (u - sigma.toNat) v) initial.basis at hi
  have hzLow : measurementCount (lowDecoder L B).program = 0 := by
    exact oneHot_program_measurements _ _
  have hzHigh : measurementCount (highDecoder L B).program = 0 := by
    exact oneHot_program_measurements _ _
  have hzInit : measurementCount init = 0 := by
    simp [init, measurementCount, hzLow, hzHigh]
  have hinitRun : run init m s = initial := by
    have hshape : init = (lowDecoder L B).program ++
        ((highDecoder L B).program ++
          [.CCX (outAt (highDecoder L B) 0 L.z)
            (outAt (lowDecoder L B) 0 L.z) L.z]) := by
      simp [init, List.append_assoc]
    rw [hshape]
    rw [run_append_zero_left_spec (lowDecoder L B).program _ hzLow]
    rw [run_append_zero_left_spec (highDecoder L B).program _ hzHigh]
  have hsweep := unpackSweepProgram_correct L B u v sigma hd hn 0 (B - 1)
    (by omega) (initialUnpackSweepState B (u - sigma.toNat) v) initial m
    (initialUnpackSweepState_invariant B u v sigma hd) hi.2
  have hout : out = run (unpackSweepProgram L B 0 (B - 1)) m initial := by
    dsimp only [out, sweepPrefix]
    rw [run_append_zero_left_spec init _ hzInit, hinitRun]
  change out.phase = s.phase ∧
    RealizesUnpackSweep L B
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) out.basis
  rw [hout]
  exact ⟨hsweep.1.trans hi.1, hsweep.2⟩

/-! The shortened unpack adder is most convenient to expose recursively.  A
`fuel` of `n` allocates carries at positions `j, ..., j+n-1`; the terminal
position `j+n` writes its outgoing carry directly into the following S bit. -/

def unpackAdderUp (L : Layout) (j : Nat) (prev carry : Wire) : Program :=
  [.CX prev (L.S j), .CX prev (L.D j),
   .CCX (L.S j) (L.D j) carry, .CX prev carry]

def unpackAdderDown (L : Layout) (j : Nat) (prev carry : Wire) : Program :=
  [.CX prev carry, .measureX carry [] [.CZ (L.S j) (L.D j)],
   .CX prev (L.D j), .CX (L.D j) (L.S j)]

def unpackAdderTerminal (L : Layout) (j : Nat) (prev : Wire) : Program :=
  [.CX prev (L.S j), .CX prev (L.D j),
   .CX prev (L.S (j + 1)), .CCX (L.S j) (L.D j) (L.S (j + 1)),
   .CX prev (L.D j), .CX (L.D j) (L.S j)]

def unpackAdderLadder (L : Layout) : Nat → Nat → Wire → Program
  | 0, j, prev => unpackAdderTerminal L j prev
  | n + 1, j, prev =>
      unpackAdderUp L j prev (L.C j) ++
      unpackAdderLadder L n (j + 1) (L.C j) ++
      unpackAdderDown L j prev (L.C j)

theorem unpackAdderLadder_expand (L : Layout) (j n : Nat) (prev : Wire) :
    unpackAdderLadder L (n + 1) j prev =
      unpackAdderUp L j prev (L.C j) ++
      (List.range' (j + 1) n).flatMap (adderMiddle L) ++
      unpackAdderTerminal L (j + n + 1) (L.C (j + n)) ++
      (List.range' (j + 1) n).reverse.flatMap (adderDown L) ++
      unpackAdderDown L j prev (L.C j) := by
  induction n generalizing j prev with
  | zero => simp [unpackAdderLadder]
  | succ n ih =>
      rw [unpackAdderLadder]
      rw [ih (j := j + 1) (prev := L.C j)]
      simp only [List.range'_succ, List.flatMap_cons, List.reverse_cons,
        List.flatMap_append, List.flatMap_singleton]
      simp [unpackAdderUp, unpackAdderDown, adderMiddle, adderDown,
        List.append_assoc]
      congr 2 <;> omega

theorem unpackAdder_eq_ladder (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    unpackAdder L B =
      unpackAdderLadder L (B - 2) 0 (L.D (B - 1)) := by
  have hfuel : B - 2 = (B - 3) + 1 := by omega
  rw [hfuel, unpackAdderLadder_expand]
  have hrange : List.range' 1 (B - 3) =
      (List.range (B - 3)).map (fun r => r + 1) := by
    rw [List.range'_eq_map_range]
    apply List.map_congr_left
    intro r hr
    omega
  rw [hrange]
  have hcarry : B - 3 = B - 2 - 1 := by omega
  have hterm : B - 2 - 1 + 1 = B - 2 := by omega
  have hplus : B - 2 + 1 = B - 1 := by omega
  simp [unpackAdder, unpackAdderUp, unpackAdderDown, unpackAdderTerminal,
    adderTopDown, hcarry, hterm, List.append_assoc]
  rw [List.flatMap_map]
  simp [hplus]

def railSegment (f : Nat → Wire) (j n : Nat) : List Wire :=
  (List.range' j n).map f

@[simp] theorem railSegment_zero (f : Nat → Wire) (j : Nat) :
    railSegment f j 0 = [] := rfl

@[simp] theorem railSegment_succ (f : Nat → Wire) (j n : Nat) :
    railSegment f j (n + 1) = f j :: railSegment f (j + 1) n := by
  simp [railSegment, List.range'_succ]

theorem unpackAdderUp_correct (sWire dWire prev carry : Wire)
    (hn : [sWire, dWire, prev, carry].Nodup) (s : State) (m : List Bool)
    (hclean : s.basis carry = false) :
    let p : Program :=
      [.CX prev sWire, .CX prev dWire, .CCX sWire dWire carry, .CX prev carry]
    let out := run p m s
    out.phase = s.phase ∧
    out.basis sWire = (s.basis sWire ^^ s.basis prev) ∧
    out.basis dWire = (s.basis dWire ^^ s.basis prev) ∧
    out.basis carry = carryBit (s.basis dWire) (s.basis sWire) (s.basis prev) ∧
    (∀ q, q ∉ [sWire, dWire, carry] → out.basis q = s.basis q) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  obtain ⟨⟨hsd, hsp, hsc⟩, ⟨hdp, hdc⟩, hpc⟩ := hn
  dsimp
  refine ⟨rfl, ?_, ?_, ?_, ?_⟩
  · simp [run, writeBit, Function.update, hsd, hsp, hsc, hdp, hdc, hpc,
      Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp, Ne.symm hdc,
      Ne.symm hpc]
  · simp [run, writeBit, Function.update, hsd, hsp, hsc, hdp, hdc, hpc,
      Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp, Ne.symm hdc,
      Ne.symm hpc]
  · cases hs : s.basis sWire <;> cases hd : s.basis dWire <;>
      cases hp : s.basis prev <;>
      simp [run, writeBit, Function.update, hsd, hsp, hsc, hdp, hdc, hpc,
        Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp, Ne.symm hdc,
        Ne.symm hpc, hclean, carryBit, hs, hd, hp]
  · intro q hq
    simp only [List.mem_cons, List.mem_singleton, not_or] at hq
    simp [run, writeBit, Function.update, hq.1, hq.2.1, hq.2.2]

theorem unpackAdderDown_correct (sWire dWire prev carry : Wire)
    (hn : [sWire, dWire, prev, carry].Nodup) (s : State) (m : List Bool)
    (S D P : Bool)
    (hs : s.basis sWire = (S ^^ P)) (hd : s.basis dWire = (D ^^ P))
    (hp : s.basis prev = P)
    (hc : s.basis carry = carryBit D S P) :
    let p : Program :=
      [.CX prev carry, .measureX carry [] [.CZ sWire dWire],
       .CX prev dWire, .CX dWire sWire]
    let out := run p m s
    out.phase = s.phase ∧ out.basis sWire = sumBit D S P ∧
    out.basis dWire = D ∧ out.basis carry = false ∧
    (∀ q, q ∉ [sWire, dWire, carry] → out.basis q = s.basis q) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  obtain ⟨⟨hsd, hsp, hsc⟩, ⟨hdp, hdc⟩, hpc⟩ := hn
  dsimp
  cases S <;> cases D <;> cases P <;> cases hm : m.headD false <;>
    simp_all [run, measureAndCorrect, ECDSAAdd.correct, writeBit, Function.update,
      carryBit, sumBit, Ne.symm hsd, Ne.symm hsp, Ne.symm hsc, Ne.symm hdp,
      Ne.symm hdc, Ne.symm hpc]

theorem unpackAdderTerminal_correct (sWire dWire top prev : Wire)
    (hn : [sWire, dWire, top, prev].Nodup) (s : State) (m : List Bool)
    (htop : s.basis top = false) :
    let p : Program :=
      [.CX prev sWire, .CX prev dWire, .CX prev top,
       .CCX sWire dWire top, .CX prev dWire, .CX dWire sWire]
    let out := run p m s
    out.phase = s.phase ∧
    regValue [sWire, top] out.basis =
      regValue [dWire] s.basis + regValue [sWire] s.basis +
        (s.basis prev).toNat ∧
    (∀ q, q ∉ [sWire, top] → out.basis q = s.basis q) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hn
  obtain ⟨⟨hsd, hst, hsp⟩, ⟨hdt, hdp⟩, htp⟩ := hn
  dsimp
  refine ⟨rfl, ?_, ?_⟩
  · cases hs : s.basis sWire <;> cases hd : s.basis dWire <;>
      cases hp : s.basis prev <;>
      simp [run, regValue, writeBit, Function.update, hsd, hst, hsp, hdt, hdp,
        htp, Ne.symm hsd, Ne.symm hst, Ne.symm hsp, Ne.symm hdt, Ne.symm hdp,
        Ne.symm htp, htop, hs, hd, hp]
  · intro q hq
    simp only [List.mem_cons, List.mem_singleton, not_or] at hq
    by_cases hqd : q = dWire
    · subst q
      simp [run, writeBit, Function.update, hsd, hst, hsp, hdt, hdp, htp,
        Ne.symm hsd, Ne.symm hst, Ne.symm hsp, Ne.symm hdt, Ne.symm hdp,
        Ne.symm htp]
    · by_cases hqp : q = prev
      · subst q
        simp [run, writeBit, Function.update, hsd, hst, hsp, hdt, hdp, htp,
          Ne.symm hsd, Ne.symm hst, Ne.symm hsp, Ne.symm hdt, Ne.symm hdp,
          Ne.symm htp]
      · simp [run, writeBit, Function.update, hq.1, hq.2, hqd, hqp]

theorem nodup_of_subcount {α : Type} [BEq α] [LawfulBEq α]
    (xs ys : List α) (hn : xs.Nodup)
    (hsub : ∀ q, ys.count q ≤ xs.count q) : ys.Nodup := by
  apply List.nodup_iff_count_le_one.mpr
  intro q
  exact (hsub q).trans (List.nodup_iff_count_le_one.mp hn q)

theorem regValue_cons_spec (q : Wire) (qs : List Wire) (b : BasisState) :
    regValue (q :: qs) b = (b q).toNat + 2 * regValue qs b := by
  cases hq : b q <;> simp [regValue, hq]

/-- Exact semantic contract of the recursively exposed shortened adder.  It
adds an `(n+1)`-bit D segment and carry-in into an `(n+2)`-bit S segment whose
top bit is initially clean, restores every non-S wire, and restores phase for
every measurement tape. -/
theorem unpackAdderLadder_correct (L : Layout) (n j : Nat) (prev : Wire)
    (s : State) (m : List Bool)
    (hn : (prev :: railSegment L.D j (n + 1) ++
      railSegment L.S j (n + 2) ++ railSegment L.C j n).Nodup)
    (hclean : ∀ q ∈ railSegment L.C j n, s.basis q = false)
    (htop : s.basis (L.S (j + n + 1)) = false) :
    let out := run (unpackAdderLadder L n j prev) m s
    out.phase = s.phase ∧
    regValue (railSegment L.S j (n + 2)) out.basis =
      regValue (railSegment L.D j (n + 1)) s.basis +
      regValue (railSegment L.S j (n + 1)) s.basis +
      (s.basis prev).toNat ∧
    (∀ q, q ∉ railSegment L.S j (n + 2) → out.basis q = s.basis q) := by
  induction n generalizing j prev s m with
  | zero =>
      have hD0 : railSegment L.D j 1 = [L.D j] := by
        simp only [railSegment_succ, railSegment_zero]
      have hS0 : railSegment L.S j 2 = [L.S j, L.S (j + 1)] := by
        rw [show 2 = 1 + 1 by omega, railSegment_succ, railSegment_succ]
        rfl
      have hn0 : (prev :: [L.D j] ++ [L.S j, L.S (j + 1)]).Nodup := by
        simpa [hD0, hS0] using hn
      have hterm : [L.S j, L.D j, L.S (j + 1), prev].Nodup := by
        apply nodup_of_subcount (prev :: [L.D j] ++ [L.S j, L.S (j + 1)]) _ hn0
        intro q
        simp only [List.count_cons, List.count_append, List.count_nil]
        omega
      have h := unpackAdderTerminal_correct (L.S j) (L.D j) (L.S (j + 1))
        prev hterm s m htop
      simpa [unpackAdderLadder, hD0, hS0] using h
  | succ n ih =>
      let up := unpackAdderUp L j prev (L.C j)
      let tail := unpackAdderLadder L n (j + 1) (L.C j)
      let down := unpackAdderDown L j prev (L.C j)
      let u := run up m s
      let v := run tail m u
      let out := run down (m.drop (measurementCount tail)) v
      have hDall : railSegment L.D j (n + 2) =
          L.D j :: railSegment L.D (j + 1) (n + 1) := by
        simpa only using railSegment_succ L.D j (n + 1)
      have hSall : railSegment L.S j (n + 3) =
          L.S j :: railSegment L.S (j + 1) (n + 2) := by
        rw [show n + 3 = (n + 2) + 1 by omega, railSegment_succ]
      have hSlow : railSegment L.S j (n + 2) =
          L.S j :: railSegment L.S (j + 1) (n + 1) := by
        simpa only using railSegment_succ L.S j (n + 1)
      have hCall : railSegment L.C j (n + 1) =
          L.C j :: railSegment L.C (j + 1) n := by
        exact railSegment_succ L.C j n
      have hnNorm : (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
          (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
          (L.C j :: railSegment L.C (j + 1) n)).Nodup := by
        simpa [hDall, hSall, hCall] using hn
      have hupN : [L.S j, L.D j, prev, L.C j].Nodup := by
        apply nodup_of_subcount
          (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
            (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
            (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
        intro q
        simp only [List.count_cons, List.count_append, List.count_nil]
        omega
      have hcj : s.basis (L.C j) = false := hclean (L.C j) (by rw [hCall]; simp)
      have hup := unpackAdderUp_correct (L.S j) (L.D j) prev (L.C j)
        hupN s m hcj
      change u.phase = s.phase ∧
        u.basis (L.S j) = (s.basis (L.S j) ^^ s.basis prev) ∧
        u.basis (L.D j) = (s.basis (L.D j) ^^ s.basis prev) ∧
        u.basis (L.C j) = carryBit (s.basis (L.D j)) (s.basis (L.S j))
          (s.basis prev) ∧
        (∀ q, q ∉ [L.S j, L.D j, L.C j] → u.basis q = s.basis q) at hup
      have htailN : (L.C j :: railSegment L.D (j + 1) (n + 1) ++
          railSegment L.S (j + 1) (n + 2) ++ railSegment L.C (j + 1) n).Nodup := by
        apply nodup_of_subcount
          (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
            (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
            (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
        intro q
        simp only [List.count_cons, List.count_append]
        omega
      have hcurrentAway : ∀ q ∈ railSegment L.C (j + 1) n,
          q ∉ [L.S j, L.D j, L.C j] := by
        intro q hq
        have hsep : ([L.S j, L.D j, L.C j] ++
            railSegment L.C (j + 1) n).Nodup := by
          apply nodup_of_subcount
            (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
              (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
              (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
          intro r
          simp only [List.count_cons, List.count_append, List.count_nil]
          omega
        have hd := (List.nodup_append'.mp hsep).2.2
        intro hm
        exact List.disjoint_left.mp hd hm hq
      have htailClean : ∀ q ∈ railSegment L.C (j + 1) n,
          u.basis q = false := by
        intro q hq
        rw [hup.2.2.2.2 q (hcurrentAway q hq)]
        exact hclean q (by simp [hq])
      have hheadS : ([L.S j, L.D j, prev, L.C j] ++
          railSegment L.S (j + 1) (n + 2)).Nodup := by
        apply nodup_of_subcount
          (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
            (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
            (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
        intro r
        simp only [List.count_cons, List.count_append, List.count_nil]
        omega
      have htopMem : L.S (j + 1 + n + 1) ∈
          railSegment L.S (j + 1) (n + 2) := by
        apply List.mem_map.mpr
        refine ⟨j + 1 + n + 1, ?_, rfl⟩
        rw [List.mem_range'_1]
        omega
      have htopAway : L.S (j + 1 + n + 1) ∉ [L.S j, L.D j, L.C j] := by
        have hsep : ([L.S j, L.D j, L.C j] ++
            railSegment L.S (j + 1) (n + 2)).Nodup := by
          apply nodup_of_subcount
            (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
              (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
              (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
          intro r
          simp only [List.count_cons, List.count_append, List.count_nil]
          omega
        exact fun hm => List.disjoint_left.mp (List.nodup_append'.mp hsep).2.2 hm htopMem
      have htopU : u.basis (L.S (j + 1 + n + 1)) = false := by
        rw [hup.2.2.2.2 _ htopAway]
        have hidx : j + 1 + n + 1 = j + (n + 1) + 1 := by omega
        rw [hidx]
        exact htop
      have htail := ih (j + 1) (L.C j) u m htailN htailClean htopU
      change v.phase = u.phase ∧
        regValue (railSegment L.S (j + 1) (n + 2)) v.basis =
          regValue (railSegment L.D (j + 1) (n + 1)) u.basis +
          regValue (railSegment L.S (j + 1) (n + 1)) u.basis +
          (u.basis (L.C j)).toNat ∧
        (∀ q, q ∉ railSegment L.S (j + 1) (n + 2) →
          v.basis q = u.basis q) at htail
      have hheadAway : ∀ q ∈ [L.S j, L.D j, prev, L.C j],
          q ∉ railSegment L.S (j + 1) (n + 2) := by
        intro q hq hm
        exact List.disjoint_left.mp (List.nodup_append'.mp hheadS).2.2 hq hm
      have hvS : v.basis (L.S j) = (s.basis (L.S j) ^^ s.basis prev) := by
        rw [htail.2.2 (L.S j) (hheadAway _ (by simp))]
        exact hup.2.1
      have hvD : v.basis (L.D j) = (s.basis (L.D j) ^^ s.basis prev) := by
        rw [htail.2.2 (L.D j) (hheadAway _ (by simp))]
        exact hup.2.2.1
      have hvP : v.basis prev = s.basis prev := by
        rw [htail.2.2 prev (hheadAway _ (by simp))]
        have hprevList : (prev :: [L.S j, L.D j, L.C j]).Nodup := by
          apply nodup_of_subcount [L.S j, L.D j, prev, L.C j] _ hupN
          intro r
          simp only [List.count_cons, List.count_nil]
          omega
        exact hup.2.2.2.2 prev (List.nodup_cons.mp hprevList).1
      have hvC : v.basis (L.C j) = carryBit (s.basis (L.D j))
          (s.basis (L.S j)) (s.basis prev) := by
        rw [htail.2.2 (L.C j) (hheadAway _ (by simp))]
        exact hup.2.2.2.1
      have hdown := unpackAdderDown_correct (L.S j) (L.D j) prev (L.C j)
        hupN v (m.drop (measurementCount tail)) (s.basis (L.S j))
        (s.basis (L.D j)) (s.basis prev) hvS hvD hvP hvC
      change out.phase = v.phase ∧
        out.basis (L.S j) = sumBit (s.basis (L.D j)) (s.basis (L.S j))
          (s.basis prev) ∧
        out.basis (L.D j) = s.basis (L.D j) ∧
        out.basis (L.C j) = false ∧
        (∀ q, q ∉ [L.S j, L.D j, L.C j] → out.basis q = v.basis q) at hdown
      have hupCount : measurementCount up = 0 := by
        simp [up, unpackAdderUp, measurementCount]
      have hrun : run (unpackAdderLadder L (n + 1) j prev) m s = out := by
        simp only [unpackAdderLadder]
        rw [run_append, measurementCount_append, hupCount, Nat.zero_add]
        rw [run_append, hupCount, List.take_zero, List.drop_zero]
        rw [run_take]
        rfl
      rw [hrun]
      refine ⟨hdown.1.trans (htail.1.trans hup.1), ?_, ?_⟩
      · have htailD : regValue (railSegment L.D (j + 1) (n + 1)) u.basis =
            regValue (railSegment L.D (j + 1) (n + 1)) s.basis := by
          apply regValue_congr
          intro q hq
          apply hup.2.2.2.2 q
          have hsep : ([L.S j, L.D j, L.C j] ++
              railSegment L.D (j + 1) (n + 1)).Nodup := by
            apply nodup_of_subcount
              (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
                (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
                (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
            intro r
            simp only [List.count_cons, List.count_append, List.count_nil]
            omega
          intro hm
          exact List.disjoint_left.mp (List.nodup_append'.mp hsep).2.2 hm hq
        have htailS : regValue (railSegment L.S (j + 1) (n + 1)) u.basis =
            regValue (railSegment L.S (j + 1) (n + 1)) s.basis := by
          apply regValue_congr
          intro q hq
          apply hup.2.2.2.2 q
          have hqFull : q ∈ railSegment L.S (j + 1) (n + 2) := by
            rcases List.mem_map.mp hq with ⟨i, hi, rfl⟩
            apply List.mem_map.mpr
            refine ⟨i, ?_, rfl⟩
            simp only [List.mem_range'_1] at hi ⊢
            omega
          intro hm
          exact List.disjoint_left.mp (List.nodup_append'.mp hheadS).2.2
            (by
              simp only [List.mem_cons] at hm ⊢
              tauto) hqFull
        have houtTail : regValue (railSegment L.S (j + 1) (n + 2)) out.basis =
            regValue (railSegment L.S (j + 1) (n + 2)) v.basis := by
          apply regValue_congr
          intro q hq
          apply hdown.2.2.2.2 q
          have hsep : ([L.S j, L.D j, L.C j] ++
              railSegment L.S (j + 1) (n + 2)).Nodup := by
            apply nodup_of_subcount
              (prev :: (L.D j :: railSegment L.D (j + 1) (n + 1)) ++
                (L.S j :: railSegment L.S (j + 1) (n + 2)) ++
                (L.C j :: railSegment L.C (j + 1) n)) _ hnNorm
            intro r
            simp only [List.count_cons, List.count_append, List.count_nil]
            omega
          intro hm
          exact List.disjoint_left.mp (List.nodup_append'.mp hsep).2.2 hm hq
        rw [hSall, hDall, hSlow]
        rw [regValue_cons_spec, regValue_cons_spec, regValue_cons_spec]
        rw [hdown.2.1, houtTail, htail.2.1, htailD, htailS, hup.2.2.2.1]
        have hbit := fullAdder_bit_value (s.basis (L.D j))
          (s.basis (L.S j)) (s.basis prev)
        omega
      · intro q hq
        rw [hSall] at hq
        simp only [List.mem_cons, not_or] at hq
        by_cases hqD : q = L.D j
        · subst q
          exact hdown.2.2.1
        by_cases hqC : q = L.C j
        · subst q
          rw [hdown.2.2.2.1]
          exact hcj.symm
        rw [hdown.2.2.2.2 q (by simp [hq.1, hqD, hqC])]
        rw [htail.2.2 q hq.2]
        apply hup.2.2.2.2 q
        simp [hq.1, hqD, hqC]

theorem railSegment_zero_eq_reg (f : Nat → Wire) (n : Nat) :
    railSegment f 0 n = reg f n := by
  simp only [railSegment, reg, List.range_eq_range']

theorem reg_succ_spec (f : Nat → Wire) (n : Nat) :
    reg f (n + 1) = reg f n ++ [f n] := by
  simp [reg, List.range_succ, List.map_append]

theorem regValue_snoc_spec (xs : List Wire) (q : Wire) (b : BasisState) :
    regValue (xs ++ [q]) b =
      regValue xs b + 2 ^ xs.length * (b q).toNat := by
  induction xs with
  | nil => cases h : b q <;> simp [regValue, h]
  | cons x xs ih =>
      rw [List.cons_append, regValue_cons_spec, regValue_cons_spec, ih]
      rw [List.length_cons, Nat.pow_succ]
      ring

theorem regValue_reg_succ (f : Nat → Wire) (n : Nat) (b : BasisState) :
    regValue (reg f (n + 1)) b =
      regValue (reg f n) b + 2 ^ n * (b (f n)).toNat := by
  rw [reg_succ_spec, regValue_snoc_spec]
  simp [reg]

theorem reg_mem_mono (f : Nat → Wire) (n m : Nat) {q : Wire}
    (hnm : n ≤ m) (hq : q ∈ reg f n) : q ∈ reg f m := by
  simp only [reg, List.mem_map, List.mem_range] at hq ⊢
  rcases hq with ⟨i, hi, rfl⟩
  exact ⟨i, by omega, rfl⟩

theorem regValue_bound_spec (qs : List Wire) (b : BasisState) :
    regValue qs b < 2 ^ qs.length := by
  induction qs with
  | nil => simp [regValue]
  | cons q qs ih =>
      rw [regValue_cons_spec, List.length_cons, Nat.pow_succ]
      cases hq : b q <;> simp <;> omega

theorem regValue_eq_of_bits (qs : List Wire) (b : BasisState) (x : Nat)
    (hx : x < 2 ^ qs.length)
    (hbits : ∀ i, i < qs.length → b (qs.getD i 0) = x.testBit i) :
    regValue qs b = x := by
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < qs.length
  · rw [← regValue_getD_testBit qs i 0 b hi]
    exact hbits i hi
  · have hpow : 2 ^ qs.length ≤ 2 ^ i :=
      Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (by omega)
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (regValue_bound_spec qs b) hpow),
      Nat.testBit_lt_two_pow (lt_of_lt_of_le hx hpow)]

theorem odd_half_testBit_spec (v i : Nat) (hv : v % 2 = 1) (hi : 0 < i) :
    ((v - 1) / 2).testBit (i - 1) = v.testBit i := by
  have hhalf : (v - 1) / 2 = v / 2 := by omega
  rw [hhalf, show i = (i - 1) + 1 by omega, Nat.testBit_succ]
  rfl

theorem unpackSweepSites_cases (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ unpackSweepSites L B) :
    q ∈ reg L.A (bitWidth B) ∨
      (∃ i, i < B - 1 ∧ q = L.D i) ∨
      (∃ i, i < B - 2 ∧ q = L.S (i + 1)) ∨
      q ∈ [L.z, L.t] ++ (lowDecoder L B).sites ++ (highDecoder L B).sites := by
  simp only [unpackSweepSites] at hq
  rcases List.mem_append.mp hq with hq | hhigh
  · rcases List.mem_append.mp hq with hq | hlow
    · rcases List.mem_append.mp hq with hq | hzt
      · rcases List.mem_append.mp hq with hq | hs
        · rcases List.mem_append.mp hq with hA | hD
          · exact Or.inl hA
          · simp only [reg, List.mem_map, List.mem_range] at hD
            rcases hD with ⟨i, hi, heq⟩
            exact Or.inr (Or.inl ⟨i, hi, heq.symm⟩)
        · simp only [List.mem_map, List.mem_range] at hs
          rcases hs with ⟨i, hi, heq⟩
          exact Or.inr (Or.inr (Or.inl ⟨i, hi, heq.symm⟩))
      · exact Or.inr (Or.inr (Or.inr (by
          simp only [List.mem_append]
          exact Or.inl (Or.inl hzt))))
    · exact Or.inr (Or.inr (Or.inr (by
        simp only [List.mem_append]
        exact Or.inl (Or.inr hlow))))
  · exact Or.inr (Or.inr (Or.inr (by
      simp only [List.mem_append]
      exact Or.inr hhigh)))

theorem unpackSweep_rest_mem_work (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ [L.z, L.t] ++ (lowDecoder L B).sites ++
      (highDecoder L B).sites) : q ∈ workSites L B := by
  simp only [workSites, List.mem_append] at hq ⊢
  tauto

theorem carry_not_unpackSweepSites (L : Layout) (B : Nat) (hn : L.Nodup B)
    {q : Wire} (hq : q ∈ reg L.C (B - 2)) :
    q ∉ unpackSweepSites L B := by
  intro ha
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_A_rest L B hn hA (by simp [hq])) rfl
  · rcases hD with ⟨i, hi, rfl⟩
    exact (sep_D_work L B hn (reg_mem L.D B i (by omega))
      (by simp [workSites, hq])) rfl
  · rcases hS with ⟨i, hi, rfl⟩
    exact (sep_S_rest L B hn (reg_mem L.S B (i + 1) (by omega))
      (by simp [workSites, hq])) rfl
  · exact (sep_C_rest L B hn hq hrest) rfl

theorem sign_not_unpackSweepSites (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.D (B - 1) ∉ unpackSweepSites L B := by
  intro ha
  have htop : L.D (B - 1) ∈ reg L.D B := reg_mem L.D B (B - 1) (by omega)
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_D_work L B hn htop (by simp [workSites, hA])) rfl
  · rcases hD with ⟨i, hi, heq⟩
    exact (reg_ne L.D B (B - 1) i (D_nodup L B hn) (by omega) (by omega)
      (by omega)) heq
  · rcases hS with ⟨i, hi, heq⟩
    exact (sep_S_rest L B hn (reg_mem L.S B (i + 1) (by omega))
      (by simp [htop])) heq.symm
  · exact (sep_D_work L B hn htop (unpackSweep_rest_mem_work L B hrest)) rfl

theorem sZero_not_unpackSweepSites (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.S 0 ∉ unpackSweepSites L B := by
  intro ha
  have hs0 : L.S 0 ∈ reg L.S B := reg_mem L.S B 0 (by omega)
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_S_rest L B hn hs0 (by simp [workSites, hA])) rfl
  · rcases hD with ⟨i, hi, heq⟩
    exact (sep_S_rest L B hn hs0
      (by simp [reg_mem L.D B i (by omega)])) heq
  · rcases hS with ⟨i, hi, heq⟩
    exact (reg_ne L.S B 0 (i + 1) (S_nodup L B hn) (by omega) (by omega)
      (by omega)) heq
  · exact (sep_S_rest L B hn hs0 (by
      exact List.mem_append_right (reg L.D B)
        (unpackSweep_rest_mem_work L B hrest))) rfl

theorem sTop_not_unpackSweepSites (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : L.S (B - 1) ∉ unpackSweepSites L B := by
  intro ha
  have hst : L.S (B - 1) ∈ reg L.S B := reg_mem L.S B (B - 1) (by omega)
  rcases unpackSweepSites_cases L B ha with hA | hD | hS | hrest
  · exact (sep_S_rest L B hn hst (by simp [workSites, hA])) rfl
  · rcases hD with ⟨i, hi, heq⟩
    exact (sep_S_rest L B hn hst
      (by simp [reg_mem L.D B i (by omega)])) heq
  · rcases hS with ⟨i, hi, heq⟩
    exact (reg_ne L.S B (B - 1) (i + 1) (S_nodup L B hn) (by omega) (by omega)
      (by omega)) heq
  · exact (sep_S_rest L B hn hst (by
      exact List.mem_append_right (reg L.D B)
        (unpackSweep_rest_mem_work L B hrest))) rfl

theorem unpackSweepPrefix_frame (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (s : State) (m : List Bool) {q : Wire} (hq : q ∉ unpackSweepSites L B) :
    (run (unpackSweepPrefix L B) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro hw
  exact hq (List.mem_toFinset.mp (unpackSweepPrefix_support_active L B hB hw))

theorem unpackSweepPrefix_eq_spec (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    unpackSweepPrefix L B =
      ((lowDecoder L B).program ++ (highDecoder L B).program ++
        [.CCX (outAt (highDecoder L B) 0 L.z)
          (outAt (lowDecoder L B) 0 L.z) L.z]) ++
        unpackSweepProgram L B 0 (B - 1) := by
  rw [unpackSweepProgram_zero_eq L B hB]
  simp only [unpackSweepPrefix, List.append_assoc]

theorem compact_unpack_sweep_literal (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    let out := run (unpackSweepPrefix L B) m s
    out.phase = s.phase ∧
    RealizesUnpackSweep L B
      (unpackSweepRun B 0 (B - 1)
        (initialUnpackSweepState B (u - sigma.toNat) v)) out.basis := by
  rw [unpackSweepPrefix_eq_spec L B hd.1]
  exact compact_unpack_sweep L B u v sigma hd hn s m hc


def unpackCleanup (L : Layout) (B : Nat) : Program :=
  [.X L.z] ++ decoderInit (lowDecoder L B) (lowBits L B) ++
    decoderInit (highDecoder L B) (highBits L B) ++ [.X (L.S 0)]

theorem unpackCleanup_run (L : Layout) (B : Nat) (s : State) (m : List Bool) :
    run (unpackCleanup L B) m s =
      run [.X (L.S 0)] m
        (run (decoderInit (highDecoder L B) (highBits L B)) m
          (run (decoderInit (lowDecoder L B) (lowBits L B)) m
            (run [.X L.z] m s))) := by
  have hlo := (decoderInit_counts (lowDecoder L B) (lowBits L B)).2
  have hhi := (decoderInit_counts (highDecoder L B) (highBits L B)).2
  have hz0 : measurementCount ([.X L.z] : Program) = 0 := rfl
  have hz01 : measurementCount
      (([.X L.z] : Program) ++ decoderInit (lowDecoder L B) (lowBits L B)) = 0 := by
    rw [measurementCount_append, hz0, hlo]
  have hz012 : measurementCount
      (([.X L.z] : Program) ++ decoderInit (lowDecoder L B) (lowBits L B) ++
        decoderInit (highDecoder L B) (highBits L B)) = 0 := by
    rw [measurementCount_append, hz01, hhi]
  simp only [unpackCleanup]
  rw [run_append_zero_left_spec _ _ hz012,
    run_append_zero_left_spec _ _ hz01,
    run_append_zero_left_spec _ _ hz0]

theorem unpackCleanup_adder_input (L : Layout) (B w v : Nat) (sigma : Bool)
    (hB : 3 ≤ B) (hn : L.Nodup B) (st : SweepState) (s : State) (m : List Bool)
    (hr : RealizesUnpackSweep L B st s.basis)
    (hfull : st.a = 0 ∧ st.z = true ∧
      (∀ i, i < B - 1 → st.d i = w.testBit i) ∧
      (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i))
    (hw : w < 2 ^ (B - 1)) (hv : v % 2 = 1) (hvtop : v < 2 ^ (B - 1))
    (hC : ∀ q ∈ reg L.C (B - 2), s.basis q = false)
    (hSig : s.basis (L.D (B - 1)) = sigma)
    (hS0 : s.basis (L.S 0) = false)
    (hStop : s.basis (L.S (B - 1)) = false) :
    let out := run (unpackCleanup L B) m s
    out.phase = s.phase ∧
    regValue (reg L.D (B - 1)) out.basis = w ∧
    regValue (reg L.S B) out.basis = v ∧
    out.basis (L.S (B - 1)) = false ∧
    out.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), out.basis q = false) ∧
    cleanOn (workSites L B) out.basis := by
  let zed := run [.X L.z] m s
  let lowOut := run (decoderInit (lowDecoder L B) (lowBits L B)) m zed
  let highOut := run (decoderInit (highDecoder L B) (highBits L B)) m lowOut
  let out := run [.X (L.S 0)] m highOut
  have hzPhase : zed.phase = s.phase := by simp [zed, run]
  have hzFrame : ∀ q, q ≠ L.z → zed.basis q = s.basis q := by
    intro q hq
    simp [zed, run, writeBit, Function.update, hq]
  have hzValue : zed.basis L.z = false := by
    simp [zed, run, writeBit, Function.update, hr.2.1, hfull.2.1]
  have hlowCurrent : ∀ q ∈ (lowDecoder L B).sites,
      zed.basis q = decoderBasis (lowDecoder L B) (lowBits L B) 0 q := by
    intro q hq
    have hqz : q ≠ L.z := by
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left _ hq)).symm
    rw [hzFrame q hqz, hr.2.2.2.2.2.1 q hq, hfull.1]
    simp
  have hlowN : (lowDecoder L B).sites.Nodup :=
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1
  have hlo := decoderInit_clear_full (lowDecoder L B) (lowBits L B) hlowN
    zed m hlowCurrent
  change lowOut.phase = zed.phase ∧
      (∀ q ∈ (lowDecoder L B).sites, lowOut.basis q = false) ∧
      (∀ q ∉ (lowDecoder L B).sites, lowOut.basis q = zed.basis q) at hlo
  have hhighCurrent : ∀ q ∈ (highDecoder L B).sites,
      lowOut.basis q = decoderBasis (highDecoder L B) (highBits L B) 0 q := by
    intro q hq
    have hqz : q ≠ L.z := by
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq)).symm
    have hqlow : q ∉ (lowDecoder L B).sites := by
      intro hm
      exact (sep_low_high L B hn hm hq) rfl
    rw [hlo.2.2 q hqlow, hzFrame q hqz, hr.2.2.2.2.2.2 q hq, hfull.1]
    simp
  have hhighN : (highDecoder L B).sites.Nodup :=
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1
  have hhi := decoderInit_clear_full (highDecoder L B) (highBits L B) hhighN
    lowOut m hhighCurrent
  change highOut.phase = lowOut.phase ∧
      (∀ q ∈ (highDecoder L B).sites, highOut.basis q = false) ∧
      (∀ q ∉ (highDecoder L B).sites, highOut.basis q = lowOut.basis q) at hhi
  have houtPhase : out.phase = s.phase := by
    simp [out, run, hhi.1, hlo.1, hzPhase]
  have houtFrame : ∀ q, q ≠ L.z → q ∉ (lowDecoder L B).sites →
      q ∉ (highDecoder L B).sites → q ≠ L.S 0 → out.basis q = s.basis q := by
    intro q hqz hql hqh hqs
    have hlast : out.basis q = highOut.basis q := by
      simp [out, run, writeBit, Function.update, hqs]
    exact hlast.trans ((hhi.2.2 q hqh).trans ((hlo.2.2 q hql).trans
      (hzFrame q hqz)))
  have houtD : regValue (reg L.D (B - 1)) out.basis = w := by
    apply regValue_eq_of_bits _ _ w
    · simpa [reg] using hw
    · intro i hi
      have hi' : i < B - 1 := by simpa [reg] using hi
      have hwire : (reg L.D (B - 1)).getD i 0 = L.D i := by
        rw [List.getD_eq_getElem _ _ hi]
        simp [reg]
      rw [hwire, houtFrame]
      · exact (hr.2.2.2.1 i hi').trans (hfull.2.2.1 i hi')
      · exact sep_D_work L B hn (reg_mem L.D B i (by omega)) (by simp [workSites])
      · intro hq
        exact (sep_D_work L B hn (reg_mem L.D B i (by omega))
          (by simp [workSites, hq])) rfl
      · intro hq
        exact (sep_D_work L B hn (reg_mem L.D B i (by omega))
          (by simp [workSites, hq])) rfl
      · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
          (by simp [reg_mem L.D B i (by omega)])).symm
  have hpreS0 : highOut.basis (L.S 0) = false := by
    have hsLow : L.S 0 ∉ (lowDecoder L B).sites := by
      intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])) rfl
    have hsHigh : L.S 0 ∉ (highDecoder L B).sites := by
      intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])) rfl
    have hsz : L.S 0 ≠ L.z :=
      sep_S_rest L B hn (reg_mem L.S B 0 (by omega)) (by simp [workSites])
    exact (hhi.2.2 (L.S 0) hsHigh).trans
      ((hlo.2.2 (L.S 0) hsLow).trans ((hzFrame (L.S 0) hsz).trans hS0))
  have houtS : regValue (reg L.S B) out.basis = v := by
    apply regValue_eq_of_bits _ _ v
    · have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat))
          (show B - 1 ≤ B by omega)
      simpa [reg] using lt_of_lt_of_le hvtop hp
    · intro i hi
      have hi' : i < B := by simpa [reg] using hi
      have hwire : (reg L.S B).getD i 0 = L.S i := by
        rw [List.getD_eq_getElem _ _ hi]
        simp [reg]
      rw [hwire]
      by_cases hi0 : i = 0
      · subst i
        have hvbit : v.testBit 0 = true := by simp [Nat.testBit_zero, hv]
        simp [out, run, writeBit, Function.update, hpreS0, hvbit]
      · by_cases hitop : i = B - 1
        · subst i
          rw [houtFrame]
          · exact hStop.trans (Nat.testBit_lt_two_pow hvtop).symm
          · exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
              (by simp [workSites])
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
              (by simp [workSites, hq])) rfl
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
              (by simp [workSites, hq])) rfl
          · exact reg_ne L.S B (B - 1) 0 (S_nodup L B hn) (by omega)
              (by omega) (by omega)
        · have himid : 0 < i ∧ i < B - 1 := by omega
          rw [houtFrame]
          · have hk : B - 2 - i < B - 2 := by omega
            have hs := hr.2.2.2.2.1 (B - 2 - i) hk
            have hindex : B - 2 - (B - 2 - i) = i := by omega
            rw [hindex] at hs
            have hst := hfull.2.2.2 (B - 2 - i) hk
            rw [hindex] at hst
            rw [hs, hst, halfBit]
            have hbitIndex : B - 3 - (B - 2 - i) = i - 1 := by omega
            rw [hbitIndex]
            exact odd_half_testBit_spec v i hv himid.1
          · exact sep_S_rest L B hn (reg_mem L.S B i hi') (by simp [workSites])
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B i hi')
              (by simp [workSites, hq])) rfl
          · intro hq
            exact (sep_S_rest L B hn (reg_mem L.S B i hi')
              (by simp [workSites, hq])) rfl
          · exact reg_ne L.S B i 0 (S_nodup L B hn) hi' (by omega) hi0
  have houtStop : out.basis (L.S (B - 1)) = false := by
    rw [houtFrame]
    · exact hStop
    · exact sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites])
    · intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · intro hq
      exact (sep_S_rest L B hn (reg_mem L.S B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · exact reg_ne L.S B (B - 1) 0 (S_nodup L B hn) (by omega) (by omega)
        (by omega)
  have houtSig : out.basis (L.D (B - 1)) = sigma := by
    rw [houtFrame]
    · exact hSig
    · exact sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites])
    · intro hq
      exact (sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · intro hq
      exact (sep_D_work L B hn (reg_mem L.D B (B - 1) (by omega))
        (by simp [workSites, hq])) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [reg_mem L.D B (B - 1) (by omega)])).symm
  have houtC : ∀ q ∈ reg L.C (B - 2), out.basis q = false := by
    intro q hq
    rw [houtFrame]
    · exact hC q hq
    · exact sep_C_rest L B hn hq (by simp)
    · intro hm
      exact (sep_C_rest L B hn hq (by
        exact List.mem_append_right [L.z, L.t]
          (List.mem_append_left _ hm))) rfl
    · intro hm
      exact (sep_C_rest L B hn hq (by
        exact List.mem_append_right [L.z, L.t]
          (List.mem_append_right _ hm))) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
  have houtA : ∀ q ∈ reg L.A (bitWidth B), out.basis q = false := by
    have hzero := (regValue_zero (reg L.A (bitWidth B)) s.basis).mp
      (hr.1.trans hfull.1)
    intro q hq
    rw [houtFrame]
    · exact hzero q hq
    · exact sep_A_rest L B hn hq (by simp)
    · intro hm
      exact (sep_A_rest L B hn hq (by
        simp only [List.mem_append]
        exact Or.inl (Or.inr hm))) rfl
    · intro hm
      exact (sep_A_rest L B hn hq (by
        simp only [List.mem_append]
        exact Or.inr hm)) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
  have houtZ : out.basis L.z = false := by
    have hzS : L.z ≠ L.S 0 := by
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites])).symm
    have hzLow : L.z ∉ (lowDecoder L B).sites := by
      intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left _ hm)) rfl
    have hzHigh : L.z ∉ (highDecoder L B).sites := by
      intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right _ hm)) rfl
    have hlast : out.basis L.z = highOut.basis L.z := by
      simp [out, run, writeBit, Function.update, hzS]
    exact hlast.trans ((hhi.2.2 L.z hzHigh).trans
      ((hlo.2.2 L.z hzLow).trans hzValue))
  have houtT : out.basis L.t = false := by
    rw [houtFrame]
    · exact hr.2.2.1
    · exact (sep_z_t L B hn).symm
    · intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left _ hm)) rfl
    · intro hm
      exact (sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right _ hm)) rfl
    · exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites])).symm
  have houtLow : ∀ q ∈ (lowDecoder L B).sites, out.basis q = false := by
    intro q hq
    have hqHigh : q ∉ (highDecoder L B).sites := by
      intro hm
      exact (sep_low_high L B hn hq hm) rfl
    have hqS : q ≠ L.S 0 := by
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
    have hlast : out.basis q = highOut.basis q := by
      simp [out, run, writeBit, Function.update, hqS]
    exact hlast.trans ((hhi.2.2 q hqHigh).trans (hlo.2.1 q hq))
  have houtHigh : ∀ q ∈ (highDecoder L B).sites, out.basis q = false := by
    intro q hq
    have hqS : q ≠ L.S 0 := by
      exact (sep_S_rest L B hn (reg_mem L.S B 0 (by omega))
        (by simp [workSites, hq])).symm
    have hlast : out.basis q = highOut.basis q := by
      simp [out, run, writeBit, Function.update, hqS]
    exact hlast.trans (hhi.2.1 q hq)
  have houtWork : cleanOn (workSites L B) out.basis := by
    intro q hq
    simp only [workSites] at hq
    rcases List.mem_append.mp hq with hq | hhigh
    · rcases List.mem_append.mp hq with hq | hlow
      · rcases List.mem_append.mp hq with hq | hzt
        · rcases List.mem_append.mp hq with hA | hCq
          · exact houtA q hA
          · exact houtC q hCq
        · simp only [List.mem_cons, List.not_mem_nil, or_false] at hzt
          rcases hzt with rfl | rfl
          · exact houtZ
          · exact houtT
      · exact houtLow q hlow
    · exact houtHigh q hhigh
  rw [unpackCleanup_run]
  exact ⟨houtPhase, houtD, houtS, houtStop, houtSig, houtC, houtWork⟩

theorem compact_unpack_cleanup (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (mp mc : List Bool) (hc : CompactCode L B u v sigma s.basis) :
    let prefixOut := run (unpackSweepPrefix L B) mp s
    let out := run (unpackCleanup L B) mc prefixOut
    out.phase = s.phase ∧
    regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
    regValue (reg L.S B) out.basis = v ∧
    out.basis (L.S (B - 1)) = false ∧
    out.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), out.basis q = false) ∧
    cleanOn (workSites L B) out.basis := by
  let st := unpackSweepRun B 0 (B - 1)
    (initialUnpackSweepState B (u - sigma.toNat) v)
  let prefixOut := run (unpackSweepPrefix L B) mp s
  let out := run (unpackCleanup L B) mc prefixOut
  have hp := compact_unpack_sweep_literal L B u v sigma hd hn s mp hc
  change prefixOut.phase = s.phase ∧ RealizesUnpackSweep L B st prefixOut.basis at hp
  have hvals := unpackSweep_full_values B u v sigma hd
  change st.a = 0 ∧ st.z = true ∧
    (∀ i, i < B - 1 → st.d i = (u - sigma.toNat).testBit i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) = halfBit B v i) at hvals
  have hc' := hc
  change regValue (reg L.A (bitWidth B)) s.basis = natBitLength (u - sigma.toNat) ∧
    regValue (reg L.D (B - 2)) s.basis = compactF B (u - sigma.toNat) v ∧
    s.basis (L.D (B - 2)) = false ∧ s.basis (L.D (B - 1)) = sigma ∧
    regValue (reg L.S B) s.basis = 0 ∧
    cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) s.basis at hc'
  have hSZero : ∀ q ∈ reg L.S B, s.basis q = false :=
    (regValue_zero (reg L.S B) s.basis).mp hc'.2.2.2.2.1
  have hpC : ∀ q ∈ reg L.C (B - 2), prefixOut.basis q = false := by
    intro q hq
    rw [unpackSweepPrefix_frame L B hd.1 s mp (carry_not_unpackSweepSites L B hn hq)]
    exact hc'.2.2.2.2.2 q (by simp [hq])
  have hpSig : prefixOut.basis (L.D (B - 1)) = sigma := by
    rw [unpackSweepPrefix_frame L B hd.1 s mp
      (sign_not_unpackSweepSites L B hd.1 hn)]
    exact hc'.2.2.2.1
  have hpS0 : prefixOut.basis (L.S 0) = false := by
    rw [unpackSweepPrefix_frame L B hd.1 s mp
      (sZero_not_unpackSweepSites L B hd.1 hn)]
    exact hSZero _ (reg_mem L.S B 0 (by have := hd.1; omega))
  have hpStop : prefixOut.basis (L.S (B - 1)) = false := by
    rw [unpackSweepPrefix_frame L B hd.1 s mp
      (sTop_not_unpackSweepSites L B hd.1 hn)]
    exact hSZero _ (reg_mem L.S B (B - 1) (by have := hd.1; omega))
  have hclean := unpackCleanup_adder_input L B (u - sigma.toNat) v sigma hd.1 hn
    st prefixOut mc hp.2 hvals (domain_w_lt_top B u v sigma hd) hd.2.2.1
    (domain_v_lt_top B u v sigma hd) hpC hpSig hpS0 hpStop
  change out.phase = prefixOut.phase ∧
    regValue (reg L.D (B - 1)) out.basis = u - sigma.toNat ∧
    regValue (reg L.S B) out.basis = v ∧
    out.basis (L.S (B - 1)) = false ∧
    out.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), out.basis q = false) ∧
    cleanOn (workSites L B) out.basis at hclean
  exact ⟨hclean.1.trans hp.1, hclean.2⟩

/-- Concrete semantic interface of the literal shortened unpack adder.  The
low D word and the incoming S word are added without overflow into S; all
other wires, including D and the carry bank, are restored exactly. -/
theorem unpackAdder_correct (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) (s : State) (m : List Bool) (w v : Nat) (sigma : Bool)
    (hD : regValue (reg L.D (B - 1)) s.basis = w)
    (hS : regValue (reg L.S B) s.basis = v)
    (hStop : s.basis (L.S (B - 1)) = false)
    (hSig : s.basis (L.D (B - 1)) = sigma)
    (hclean : ∀ q ∈ reg L.C (B - 2), s.basis q = false) :
    let out := run (unpackAdder L B) m s
    out.phase = s.phase ∧
    regValue (reg L.S B) out.basis = w + v + sigma.toNat ∧
    (∀ q, q ∉ reg L.S B → out.basis q = s.basis q) := by
  have hBm1 : B = (B - 1) + 1 := by omega
  have hBm2 : B - 1 = (B - 2) + 1 := by omega
  have hDfull : reg L.D B = reg L.D (B - 1) ++ [L.D (B - 1)] := by
    conv_lhs => rw [hBm1, reg_succ_spec]
  have hcontractN : (L.D (B - 1) :: reg L.D (B - 1) ++
      reg L.S B ++ reg L.C (B - 2)).Nodup := by
    apply nodup_of_subcount (declaredSites L B)
    · exact hn
    · intro q
      simp only [declaredSites, hDfull, workSites, List.count_cons,
        List.count_append, List.count_nil]
      omega
  have hcontractN' : (L.D (B - 1) :: railSegment L.D 0 (B - 2 + 1) ++
      railSegment L.S 0 (B - 2 + 2) ++ railSegment L.C 0 (B - 2)).Nodup := by
    have hlen1 : B - 2 + 1 = B - 1 := by omega
    have hlen2 : B - 2 + 2 = B := by omega
    simpa [railSegment_zero_eq_reg, hlen1, hlen2] using hcontractN
  have htopIndex : 0 + (B - 2) + 1 = B - 1 := by omega
  have hl := unpackAdderLadder_correct L (B - 2) 0 (L.D (B - 1)) s m
    hcontractN'
    (by simpa [railSegment_zero_eq_reg] using hclean)
    (by rw [htopIndex]; exact hStop)
  have heq := unpackAdder_eq_ladder L B hB
  rw [heq]
  change (run (unpackAdderLadder L (B - 2) 0 (L.D (B - 1))) m s).phase =
      s.phase ∧
    regValue (reg L.S B)
      (run (unpackAdderLadder L (B - 2) 0 (L.D (B - 1))) m s).basis =
      w + v + sigma.toNat ∧
    (∀ q, q ∉ reg L.S B →
      (run (unpackAdderLadder L (B - 2) 0 (L.D (B - 1))) m s).basis q =
        s.basis q)
  have hSlow : regValue (reg L.S (B - 1)) s.basis = v := by
    rw [hBm1, regValue_reg_succ, hStop, Bool.toNat_false, Nat.mul_zero,
      Nat.add_zero] at hS
    exact hS
  have hlength1 : B - 2 + 1 = B - 1 := by omega
  have hlength2 : B - 2 + 2 = B := by omega
  simpa [railSegment_zero_eq_reg, hlength1, hlength2, hD, hSlow, hSig] using hl

theorem compact_unpack_finish_staged (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State)
    (mp mc ma mx : List Bool) (hc : CompactCode L B u v sigma s.basis) :
    let prefixOut := run (unpackSweepPrefix L B) mp s
    let clean := run (unpackCleanup L B) mc prefixOut
    let added := run (unpackAdder L B) ma clean
    let out := run (cxInto (L.D (B - 1)) (reg L.D (B - 1))) mx added
    out.phase = s.phase ∧ CodecInput L B u v sigma out.basis := by
  let prefixOut := run (unpackSweepPrefix L B) mp s
  let clean := run (unpackCleanup L B) mc prefixOut
  let added := run (unpackAdder L B) ma clean
  let out := run (cxInto (L.D (B - 1)) (reg L.D (B - 1))) mx added
  change out.phase = s.phase ∧ CodecInput L B u v sigma out.basis
  have hcl := compact_unpack_cleanup L B u v sigma hd hn s mp mc hc
  change clean.phase = s.phase ∧
    regValue (reg L.D (B - 1)) clean.basis = u - sigma.toNat ∧
    regValue (reg L.S B) clean.basis = v ∧
    clean.basis (L.S (B - 1)) = false ∧
    clean.basis (L.D (B - 1)) = sigma ∧
    (∀ q ∈ reg L.C (B - 2), clean.basis q = false) ∧
    cleanOn (workSites L B) clean.basis at hcl
  have hadd := unpackAdder_correct L B hd.1 hn clean ma (u - sigma.toNat) v sigma
    hcl.2.1 hcl.2.2.1 hcl.2.2.2.1 hcl.2.2.2.2.1 hcl.2.2.2.2.2.1
  change added.phase = clean.phase ∧
    regValue (reg L.S B) added.basis =
      u - sigma.toNat + v + sigma.toNat ∧
    (∀ q, q ∉ reg L.S B → added.basis q = clean.basis q) at hadd
  have hsum : regValue (reg L.S B) added.basis = u + v := by
    rw [hadd.2.1]
    have hu := domain_sub_sigma_add B u v sigma hd
    omega
  have hDlowAdded : regValue (reg L.D (B - 1)) added.basis = u - sigma.toNat := by
    refine (regValue_congr _ _ _ ?_).trans hcl.2.1
    intro q hq
    apply hadd.2.2 q
    intro hs
    exact (sep_S_rest L B hn hs (by
      exact List.mem_append_left (workSites L B)
        (reg_mem_mono L.D (B - 1) B (by omega) hq))) rfl
  have hSigAdded : added.basis (L.D (B - 1)) = sigma := by
    rw [hadd.2.2]
    · exact hcl.2.2.2.2.1
    · intro hs
      exact (sep_S_rest L B hn hs (by
        exact List.mem_append_left (workSites L B)
          (reg_mem L.D B (B - 1) (by have := hd.1; omega)))) rfl
  have hWorkAdded : cleanOn (workSites L B) added.basis := by
    intro q hq
    rw [hadd.2.2]
    · exact hcl.2.2.2.2.2.2 q hq
    · intro hs
      exact (sep_S_rest L B hn hs (List.mem_append_right (reg L.D B) hq)) rfl
  have hDlowN : (reg L.D (B - 1)).Nodup := by
    have hshape : reg L.D B = reg L.D (B - 1) ++ [L.D (B - 1)] := by
      conv_lhs => rw [show B = (B - 1) + 1 by have := hd.1; omega,
        reg_succ_spec]
    have hfull := D_nodup L B hn
    rw [hshape] at hfull
    exact (List.nodup_append.mp hfull).1
  have hSigNotLow : L.D (B - 1) ∉ reg L.D (B - 1) := by
    intro hq
    simp only [reg, List.mem_map, List.mem_range] at hq
    rcases hq with ⟨i, hi, heq⟩
    exact (reg_ne L.D B (B - 1) i (D_nodup L B hn)
      (by have := hd.1; omega) (by omega) (by omega)) heq.symm
  have hcx := cxInto_run (L.D (B - 1)) (reg L.D (B - 1)) hDlowN hSigNotLow
    added mx
  change out = ⟨added.phase, fun q =>
    if added.basis (L.D (B - 1)) && decide (q ∈ reg L.D (B - 1))
    then !added.basis q else added.basis q⟩ at hcx
  have hcxPhase : out.phase = added.phase := by rw [hcx]
  have hcxFrame : ∀ q, q ∉ reg L.D (B - 1) → out.basis q = added.basis q := by
    intro q hq
    rw [hcx]
    simp [hq]
  have hSOut : regValue (reg L.S B) out.basis = u + v := by
    refine (regValue_congr _ _ _ ?_).trans hsum
    intro q hq
    apply hcxFrame q
    intro hdq
    exact (sep_S_rest L B hn hq (by
      exact List.mem_append_left (workSites L B)
        (reg_mem_mono L.D (B - 1) B (by omega) hdq))) rfl
  have hWorkOut : cleanOn (workSites L B) out.basis := by
    intro q hq
    rw [hcxFrame]
    · exact hWorkAdded q hq
    · intro hdq
      have hdFull : q ∈ reg L.D B := by
        simp only [reg, List.mem_map, List.mem_range] at hdq ⊢
        rcases hdq with ⟨i, hi, rfl⟩
        exact ⟨i, by omega, rfl⟩
      exact (sep_D_work L B hn hdFull hq) rfl
  have hDOut : regValue (reg L.D B) out.basis = signedWord B u sigma := by
    have hBshape : B = (B - 1) + 1 := by have := hd.1; omega
    have hpow : 2 ^ B = 2 * 2 ^ (B - 1) := by
      calc
        2 ^ B = 2 ^ ((B - 1) + 1) := congrArg (fun n => 2 ^ n) hBshape
        _ = 2 * 2 ^ (B - 1) := by rw [Nat.pow_succ]; ring
    cases sigma with
    | false =>
        have hlow : regValue (reg L.D (B - 1)) out.basis = u := by
          refine (regValue_congr (reg L.D (B - 1)) out.basis added.basis ?_).trans ?_
          · intro q hq
            rw [hcx]
            simp [hSigAdded]
          · simpa using hDlowAdded
        have htop : out.basis (L.D (B - 1)) = false := by
          rw [hcxFrame _ hSigNotLow, hSigAdded]
        have huB : u < 2 ^ B := lt_of_le_of_lt (Nat.le_add_right u v) hd.2.2.2.1
        calc
          regValue (reg L.D B) out.basis =
              regValue (reg L.D (B - 1)) out.basis +
                2 ^ (B - 1) * (out.basis (L.D (B - 1))).toNat := by
            conv_lhs => rw [hBshape, regValue_reg_succ]
          _ = u := by rw [hlow, htop]; simp
          _ = signedWord B u false := by
            simp [signedWord, Nat.mod_eq_of_lt huB]
    | true =>
        have hlow : regValue (reg L.D (B - 1)) out.basis =
            2 ^ (B - 1) - 1 - (u - 1) := by
          rw [regValue_congr (reg L.D (B - 1)) out.basis
            (fun q => !added.basis q) (by
              intro q hq
              rw [hcx]
              simp [hSigAdded, hq]), regValue_complement, hDlowAdded]
          simp [reg]
        have htop : out.basis (L.D (B - 1)) = true := by
          rw [hcxFrame _ hSigNotLow, hSigAdded]
        have hu0 : 0 < u := by
          by_contra hz
          have hz' : u = 0 := by omega
          have hs := (hd.2.2.2.2.2 hz').2
          contradiction
        have huB : u < 2 ^ B := lt_of_le_of_lt (Nat.le_add_right u v) hd.2.2.2.1
        have hsub : 2 ^ B - u < 2 ^ B := by omega
        have hw := domain_w_lt_top B u v true hd
        simp only [Bool.toNat_true] at hw
        calc
          regValue (reg L.D B) out.basis =
              regValue (reg L.D (B - 1)) out.basis +
                2 ^ (B - 1) * (out.basis (L.D (B - 1))).toNat := by
            conv_lhs => rw [hBshape, regValue_reg_succ]
          _ = (2 ^ (B - 1) - 1 - (u - 1)) + 2 ^ (B - 1) := by
            rw [hlow, htop]
            simp
          _ = 2 ^ B - u := by
            rw [hpow]
            have hcut : 2 ^ (B - 1) - 1 - (u - 1) = 2 ^ (B - 1) - u := by
              omega
            have hule : u ≤ 2 ^ (B - 1) := by omega
            rw [hcut]
            omega
          _ = signedWord B u true := by
            simp [signedWord, Nat.mod_eq_of_lt hsub]
  exact ⟨hcxPhase.trans (hadd.1.trans hcl.1), hSOut, hDOut, hWorkOut⟩

theorem unpack_eq_stages (L : Layout) (B : Nat) :
    unpack L B = unpackSweepPrefix L B ++
      (unpackCleanup L B ++
        (unpackAdder L B ++ cxInto (L.D (B - 1)) (reg L.D (B - 1)))) := by
  simp [unpack, unpackSweepPrefix, unpackCleanup, List.append_assoc]

/-- Exact semantic direction of the literal generated inverse codec, for every
measurement tape. -/
theorem unpack_spec (L : Layout) (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) (hn : L.Nodup B) (s : State) (m : List Bool)
    (hc : CompactCode L B u v sigma s.basis) :
    (run (unpack L B) m s).phase = s.phase ∧
    CodecInput L B u v sigma (run (unpack L B) m s).basis := by
  let P := unpackSweepPrefix L B
  let C := unpackCleanup L B
  let A := unpackAdder L B
  let X := cxInto (L.D (B - 1)) (reg L.D (B - 1))
  let mp := m.take (measurementCount P)
  let m1 := m.drop (measurementCount P)
  let mc := m1.take (measurementCount C)
  let m2 := m1.drop (measurementCount C)
  let ma := m2.take (measurementCount A)
  let mx := m2.drop (measurementCount A)
  have hs := compact_unpack_finish_staged L B u v sigma hd hn s mp mc ma mx hc
  rw [unpack_eq_stages]
  change (run (P ++ (C ++ (A ++ X))) m s).phase = s.phase ∧
    CodecInput L B u v sigma (run (P ++ (C ++ (A ++ X))) m s).basis
  simp only [run_append]
  simpa only [P, C, A, X, mp, m1, mc, m2, ma, mx] using hs


/-- Exact handoff to the forward-codec proof: a pack theorem of the shape
proved by the companion module, together with the completed inverse theorem,
closes the public `FunctionalSpec`. -/
theorem functionalSpec_of_pack (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B)
    (hpack : ∀ u v sigma, CodecDomain B u v sigma → L.Nodup B →
      ∀ s m, CodecInput L B u v sigma s.basis →
        (run (pack L B) m s).phase = s.phase ∧
        CompactCode L B u v sigma (run (pack L B) m s).basis) :
    FunctionalSpec L B := by
  refine ⟨pack_physical L B hB hn, unpack_physical L B hB hn, ?_⟩
  intro u v sigma hd hn'
  exact ⟨hpack u v sigma hd hn', unpack_spec L B u v sigma hd hn'⟩

end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecSpec_at_StairSideA

