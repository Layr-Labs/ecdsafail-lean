section Merge_StairField13V3K1Loan_at_StairSideA

/-!
# Field 13 on v3: structural `ztAll` lemmas for the loaned halves (K1, replay budget)

The kernel builds `StairLoan.emitDowns` (and `literalConstAdd`) with left-nested appends, which
costs quadratic time in the number of carry layers.  The loaned-half checks
(`StairField13V3ChkHalf*`) descend structurally into `emitLoan` (append splits, renamings and
`rebindMany` relabellings that fix the checked roles) and evaluate the tracker of the upper
sweep's down-pass through a fused recursion; no gate list of a sweep is built.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed

/-- The tracker of `StairLoan.emitDowns`, fused along the layer list. -/
def k1ztDowns (lo width : Nat) : Nat → List StairLoan.CarryLayer → Nat
  | m, [] => m
  | m, l :: ls => ztM lo width (k1ztDowns lo width m ls) (l.erase ++ l.finish)

theorem k1_ztM_downs (lo width : Nat) : ∀ (ls : List StairLoan.CarryLayer) (m : Nat),
    ztM lo width m (StairLoan.emitDowns ls) = k1ztDowns lo width m ls
  | [], _ => rfl
  | l :: ls, m => by
    show ztM lo width m (StairLoan.emitDowns ls ++ (l.erase ++ l.finish)) = _
    rw [k1_ztM_append, k1_ztM_downs lo width ls m]
    rfl



/-- `rebindMany` swaps only its roles and hosts, so it keeps the check on other wires. -/
theorem k1_ztAll_rebind (lo width : Nat) (b : Bool) (ws : List Wire)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width) :
    ∀ (rs hs : List Wire) (P : Program), (∀ w ∈ ws, w ∉ rs ∧ w ∉ hs) →
      ztAll lo width b ws P = true → ztAll lo width b ws (StairLoan.rebindMany rs hs P) = true
  | [], _, _, _, hP => hP
  | _ :: _, [], _, _, hP => hP
  | r :: rs, h :: hs, P, hw, hP => by
    show ztAll lo width b ws (renameProgram (Equiv.swap r h) (StairLoan.rebindMany rs hs P)) = true
    refine k1_ztAll_rename_fixed lo width b ws _ (Equiv.swap r h).injective _ hr
      (fun w hw' => Equiv.swap_apply_of_ne_of_ne
        (fun e => (hw w hw').1 (by rw [e]; exact List.mem_cons_self ..))
        (fun e => (hw w hw').2 (by rw [e]; exact List.mem_cons_self ..)))
      (k1_ztAll_rebind lo width b ws hr rs hs P
        (fun w hw' => ⟨fun m => (hw w hw').1 (List.mem_cons_of_mem _ m),
          fun m => (hw w hw').2 (List.mem_cons_of_mem _ m)⟩) hP)

/-! ## K3 (replay budget, round 2): one d-generic proof per loaned-half family

All kernel evaluation of the loaned-half checks happens once, in closed checks inside the
d-generic theorems `k3_half_false` / `k3_half_true`: the pieces outside the loan on all 44 roles,
the upper down-pass at the deepest loan (`ls.drop 43`), one operand mask of the 43 lowest layers
(the lower down-passes and the borrowed up-passes never touch a role), and the rebind
disjointness (`rolesL` is a nodup list, its first `d` entries are the loaned roles). -/

/-- Operands of a correction list, as a list. -/
def k3cl : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: k3cl cs
  | .CZ a b :: cs => a :: b :: k3cl cs

/-- Operands of an instruction, as a list (no `Finset`). -/
def k3wl : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c₀ c₁ => t :: (k3cl c₀ ++ k3cl c₁)

theorem k3_mem_cl (q : Wire) : ∀ cs : List Correction, q ∈ correctionWires cs → q ∈ k3cl cs
  | [], h => by simp [correctionWires] at h
  | .Z t :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k3cl, List.mem_cons]
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (k3_mem_cl q cs h)
  | .CZ a b :: cs, h => by
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at h
      simp only [k3cl, List.mem_cons]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (k3_mem_cl q cs h))

theorem k3_mem_wl (q : Wire) (i : Instr) (h : q ∈ Instr.wires i) : q ∈ k3wl i := by
  cases i with
  | X t =>
      simp only [Instr.wires, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_singleton]
      exact h
  | CX c t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | CCX a b t =>
      simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_cons, List.not_mem_nil, or_false]
      exact h
  | measureX t c₀ c₁ =>
      simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
      simp only [k3wl, List.mem_cons, List.mem_append]
      rcases h with (h | h) | h
      · exact Or.inl h
      · exact Or.inr (Or.inl (k3_mem_cl q c₀ h))
      · exact Or.inr (Or.inr (k3_mem_cl q c₁ h))

/-- All operands of a program, as one bit mask. -/
def k3progMask : Program → Nat
  | [] => 0
  | i :: P => StairLoan.maskOf (k3wl i) ||| k3progMask P

theorem k3_not_mem_of_mask : ∀ (P : Program) (q : Wire), (k3progMask P).testBit q = false →
    q ∉ wires P
  | [], _, _ => by simp [wires]
  | i :: P, q, h => by
    simp only [k3progMask, Nat.testBit_or, Bool.or_eq_false_iff] at h
    intro hq
    rw [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · have t := h.1
      rw [StairLoan.testBit_maskOf] at t
      exact absurd (k3_mem_wl q i hq) (of_decide_eq_false t)
    · exact k3_not_mem_of_mask P q h.2 hq

theorem k3_avoid (P : Program) (ws : List Wire)
    (h : ws.all (fun w => !(k3progMask P).testBit w) = true) : ∀ w ∈ ws, w ∉ wires P := by
  intro w hw
  apply k3_not_mem_of_mask
  have t := List.all_eq_true.mp h w hw
  simpa using t

theorem k3_avoid_list (l ws : List Wire)
    (h : ws.all (fun w => !(StairLoan.maskOf l).testBit w) = true) : ∀ w ∈ ws, w ∉ l := by
  intro w hw hm
  have t := List.all_eq_true.mp h w hw
  rw [StairLoan.testBit_maskOf] at t
  simp [hm] at t

/-- A down-pass is checked on its upper part when its `n` lowest layers are role-free. -/
theorem k3_downs_split (lo width : Nat) (ws : List Wire) (ls : List StairLoan.CarryLayer) (n : Nat)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (hUp : ztAll lo width false ws (StairLoan.emitDowns (ls.drop n)) = true)
    (hLow : ∀ w ∈ ws, w ∉ wires (StairLoan.emitDowns (ls.take n))) :
    ztAll lo width false ws (StairLoan.emitDowns ls) = true := by
  rw [← List.take_append_drop n ls, StairLoan.emitDowns_append]
  exact k1_ztAll_append_true lo width false _ _ _ hr hUp (ztAll_true_of_not_mem lo width _ _ hr hLow)

theorem k3_ztAll_drop (lo width : Nat) (b : Bool) (ws : List Wire) (d : Nat) (P : Program)
    (h : ztAll lo width b ws P = true) : ztAll lo width b (ws.drop d) P = true := by
  unfold ztAll at h ⊢
  rw [List.all_eq_true] at h ⊢
  exact fun w hw => h w (List.mem_of_mem_drop hw)

theorem k3_forall_drop {p : Wire → Prop} {ws : List Wire} (d : Nat) (h : ∀ w ∈ ws, p w) :
    ∀ w ∈ ws.drop d, p w :=
  fun w hw => h w (List.mem_of_mem_drop hw)

theorem k3_mem_downs (q : Wire) : ∀ (ls : List StairLoan.CarryLayer),
    q ∈ wires (StairLoan.emitDowns ls) → ∃ l ∈ ls, q ∈ wires (l.erase ++ l.finish)
  | [], h => by simp [StairLoan.emitDowns, wires] at h
  | l :: ls, h => by
    change q ∈ wires (StairLoan.emitDowns ls ++ (l.erase ++ l.finish)) at h
    rw [wires_append, Finset.mem_union] at h
    rcases h with h | h
    · obtain ⟨l', hl', hq⟩ := k3_mem_downs q ls h
      exact ⟨l', List.mem_cons_of_mem _ hl', hq⟩
    · exact ⟨l, List.mem_cons_self .., h⟩

theorem k3_downs_mem (q : Wire) : ∀ (ls : List StairLoan.CarryLayer) (l : StairLoan.CarryLayer),
    l ∈ ls → q ∈ wires (l.erase ++ l.finish) → q ∈ wires (StairLoan.emitDowns ls)
  | [], _, hl, _ => absurd hl List.not_mem_nil
  | l' :: ls, l, hl, hq => by
    change q ∈ wires (StairLoan.emitDowns ls ++ (l'.erase ++ l'.finish))
    rw [wires_append, Finset.mem_union]
    rcases List.mem_cons.mp hl with rfl | hl
    · exact Or.inr hq
    · exact Or.inl (k3_downs_mem q ls l hl hq)

theorem k3_mem_ups (q : Wire) : ∀ (ls : List StairLoan.CarryLayer),
    q ∈ wires (StairLoan.emitUps ls) → ∃ l ∈ ls, q ∈ wires l.up
  | [], h => by simp [StairLoan.emitUps, wires] at h
  | l :: ls, h => by
    change q ∈ wires (l.up ++ StairLoan.emitUps ls) at h
    rw [wires_append, Finset.mem_union] at h
    rcases h with h | h
    · exact ⟨l, List.mem_cons_self .., h⟩
    · obtain ⟨l', hl', hq⟩ := k3_mem_ups q ls h
      exact ⟨l', List.mem_cons_of_mem _ hl', hq⟩

theorem k3_ups_mem (q : Wire) : ∀ (ls : List StairLoan.CarryLayer) (l : StairLoan.CarryLayer),
    l ∈ ls → q ∈ wires l.up → q ∈ wires (StairLoan.emitUps ls)
  | [], _, hl, _ => absurd hl List.not_mem_nil
  | l' :: ls, l, hl, hq => by
    change q ∈ wires (l'.up ++ StairLoan.emitUps ls)
    rw [wires_append, Finset.mem_union]
    rcases List.mem_cons.mp hl with rfl | hl
    · exact Or.inl hq
    · exact Or.inr (k3_ups_mem q ls l hl hq)

theorem k3_downs_sub (q : Wire) (small big : List StairLoan.CarryLayer)
    (hsub : ∀ l ∈ small, l ∈ big) (h : q ∉ wires (StairLoan.emitDowns big)) :
    q ∉ wires (StairLoan.emitDowns small) := fun hq => by
  obtain ⟨l, hl, hq'⟩ := k3_mem_downs q small hq
  exact h (k3_downs_mem q big l (hsub l hl) hq')

theorem k3_ups_sub (q : Wire) (small big : List StairLoan.CarryLayer)
    (hsub : ∀ l ∈ small, l ∈ big) (h : q ∉ wires (StairLoan.emitUps big)) :
    q ∉ wires (StairLoan.emitUps small) := fun hq => by
  obtain ⟨l, hl, hq'⟩ := k3_mem_ups q small hq
  exact h (k3_ups_mem q big l (hsub l hl) hq')

theorem k3_take_sub {α : Type} (ls : List α) (n D : Nat) (hn : n ≤ D) :
    ∀ l ∈ ls.take n, l ∈ ls.take D := by
  intro l hl
  have e : (ls.take D).take n = ls.take n := by
    rw [List.take_take, Nat.min_eq_left hn]
  rw [← e] at hl
  exact List.mem_of_mem_take hl

/-- The loan of depth `d ≤ D` keeps the check of the unloaned roles, given closed facts at the
deepest loan `D`: the upper down-pass check, role-freeness of the `D + 1` lowest layers (up- and
down-passes and hosts), and that the unloaned roles are not loaned. -/
theorem k3_loan_ok (lo width : Nat) (ws roles : List Wire) (ls : List StairLoan.CarryLayer)
    (top : Program) (d D : Nat) (hdD : d ≤ D)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (hDown : ztAll lo width false ws (StairLoan.emitDowns (ls.drop (D + 1))) = true)
    (hUps : ∀ w ∈ ws, w ∉ wires (StairLoan.emitUps (ls.take (D + 1))))
    (hDowns : ∀ w ∈ ws, w ∉ wires (StairLoan.emitDowns (ls.take (D + 1))))
    (hHosts : ∀ w ∈ ws, w ∉ StairLoan.layerHosts (ls.take (D + 1)))
    (hRoles : ∀ w ∈ ws.drop d, w ∉ roles.take d) :
    ztAll lo width false (ws.drop d) (StairLoan.emitLoan d roles ls top) = true := by
  have hr' : ∀ w ∈ ws.drop d, lo ≤ w ∧ w < lo + width := k3_forall_drop d hr
  simp only [StairLoan.emitLoan]
  refine k1_ztAll_append_true lo width false _ _ _ hr' ?_
    (ztAll_true_of_not_mem lo width _ _ hr' (fun w hw => k3_downs_sub w _ _
      (k3_take_sub ls (d + 1) (D + 1) (by omega)) (hDowns w (List.mem_of_mem_drop hw))))
