/-! ## LT48 (replay budget): bit-mask list checks, exact slot formulas

`decide` on list membership / `Nodup` walks the unevaluated layout lists once per query; a `Nat` bit
mask is built once (`maskL`, `nodupMaskL`, as `StairLoan.maskOf` / `nodupMask`).  Gate slots do not
depend on wires: `addS`, `eltS`, `skS`, `esS`, `elS` compute the slots of `mappedAdd`,
`eraseLtChainM`, `Skip4.addSkip`, `Skip4.eraseSkip`, `eraseLtChain` by a shallow recursion, so the
kernel never walks the deep `++` nest of the 14,196 gates of `mid_slots_le`. -/
namespace LT48B
open Challenge

def forbidNat : List Nat := List.range' 4835 40 ++ List.range' 4876 4 ++ [4761]


def maskL : List Nat → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| maskL xs

theorem testBit_maskL : ∀ (l : List Nat) (q : Nat), (maskL l).testBit q = decide (q ∈ l)
  | [], q => by simp [maskL]
  | x :: xs, q => by
    simp only [maskL, Nat.testBit_or, testBit_maskL xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm


theorem disj_of_maskL (A B : List Nat) (h : A.all (fun q => !(maskL B).testBit q) = true) :
    ∀ q ∈ A, q ∉ B := by
  intro q hq
  have t := List.all_eq_true.mp h q hq
  rw [testBit_maskL, Bool.not_eq_true', decide_eq_false_iff_not] at t
  exact t

def nodupMaskL : List Nat → Nat → Bool
  | [], _ => true
  | x :: xs, m => !(m.testBit x) && nodupMaskL xs (m ||| 2 ^ x)

theorem nodupMaskL_sound : ∀ (l : List Nat) (m : Nat), nodupMaskL l m = true →
    l.Nodup ∧ ∀ x ∈ l, m.testBit x = false
  | [], _, _ => ⟨List.nodup_nil, fun _ h => absurd h List.not_mem_nil⟩
  | x :: xs, m, h => by
    simp only [nodupMaskL, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨hx, hr⟩ := h
    obtain ⟨nd, av⟩ := nodupMaskL_sound xs _ hr
    have key : ∀ y ∈ xs, y ≠ x ∧ m.testBit y = false := by
      intro y hy
      have t := av y hy
      rw [Nat.testBit_or, Bool.or_eq_false_iff] at t
      refine ⟨?_, t.1⟩
      rintro rfl
      rw [Nat.testBit_two_pow_self] at t
      exact absurd t.2 (by decide)
    refine ⟨List.nodup_cons.mpr ⟨fun hmem => (key x hmem).1 rfl, nd⟩, ?_⟩
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · exact hx
    · exact (key y hy).2

/-! ### Slots of the adder pieces (wire-independent) -/

def majS (b : MappedBit) : Nat := gateSlots (mappedMajority b 0 0 0)
def ecS (b : MappedBit) : Nat := gateSlots (mappedEraseCarry b 0 0 0)
def sumS (b : MappedBit) : Nat := gateSlots (mappedSum b 0 0)
def bmS (b : MappedBit) : Nat := gateSlots (borrowM 0 b 0 0)
def emS (b : MappedBit) : Nat := gateSlots (eraseM 0 b 0 0)
def bmajS : Nat := gateSlots (borrowMajority 0 0 0 0)
def ebS : Nat := gateSlots (eraseBorrow 0 0 0 0)

theorem maj_eq (b : MappedBit) (y c t : Wire) : gateSlots (mappedMajority b y c t) = majS b := by
  rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem ec_eq (b : MappedBit) (y c t : Wire) : gateSlots (mappedEraseCarry b y c t) = ecS b := by
  rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem sum_eq (b : MappedBit) (y c : Wire) : gateSlots (mappedSum b y c) = sumS b := by
  rcases b with ⟨_ | a, _ | _⟩ <;> rfl
theorem bm_eq (a : Wire) (b : MappedBit) (c t : Wire) : gateSlots (borrowM a b c t) = bmS b := by
  rcases b with ⟨_ | w, _ | _⟩ <;> rfl
theorem em_eq (a : Wire) (b : MappedBit) (c t : Wire) : gateSlots (eraseM a b c t) = emS b := by
  rcases b with ⟨_ | w, _ | _⟩ <;> rfl
theorem bmaj_eq (a b c t : Wire) : gateSlots (borrowMajority a b c t) = bmajS := rfl
theorem eb_eq (a b c t : Wire) : gateSlots (eraseBorrow a b c t) = ebS := rfl

def addS : List MappedBit → List Wire → List Wire → Nat
  | b::b'::bits, _::y'::ys, _::cs => majS b + addS (b'::bits) (y'::ys) cs + ecS b + sumS b
  | [b], [_], _ => sumS b
  | _, _, _ => 0

theorem addS_eq : ∀ (bs : List MappedBit) (ys cs : List Wire) (c : Wire),
    gateSlots (mappedAdd bs ys cs c) = addS bs ys cs
  | b::b'::bits, y::y'::ys, d::ds, c => by
    simp only [mappedAdd, addS, gateSlots_append, addS_eq (b'::bits) (y'::ys) ds d, maj_eq, ec_eq, sum_eq]
  | [b], [y], cs, c => by simp only [mappedAdd, addS, sum_eq]
  | [], _, _, _ => rfl
  | [_], [], _, _ => rfl
  | [_], _::_::_, _, _ => rfl
  | _::_::_, [], _, _ => rfl
  | _::_::_, [_], _, _ => rfl
  | _::_::_, _::_::_, [], _ => rfl

def eltS : List Wire → List MappedBit → List Wire → Nat
  | _::a'::as, b::b'::bs, _::cs => bmS b + eltS (a'::as) (b'::bs) cs + emS b
  | [_], [b], _ => emS b
  | _, _, _ => 0

theorem eltS_eq : ∀ (as : List Wire) (bs : List MappedBit) (cs : List Wire) (cin t : Wire),
    gateSlots (eraseLtChainM as bs cs cin t) = eltS as bs cs
  | a::a'::as, b::b'::bs, c::cs, cin, t => by
    simp only [eraseLtChainM, eltS, gateSlots_append, eltS_eq (a'::as) (b'::bs) cs c t, bm_eq, em_eq]
  | [a], [b], cs, cin, t => by simp only [eraseLtChainM, eltS, em_eq]
  | [], _, _, _, _ => rfl
  | [_], [], _, _, _ => rfl
  | [_], _::_::_, _, _, _ => rfl
  | _::_::_, [], _, _, _ => rfl
  | _::_::_, [_], _, _, _ => rfl
  | _::_::_, _::_::_, [], _, _ => rfl

def elS : List Wire → List Wire → List Wire → Nat
  | _::a'::as, _::b'::bs, _::cs => bmajS + elS (a'::as) (b'::bs) cs + ebS
  | [_], [_], _ => ebS
  | _, _, _ => 0

theorem elS_eq : ∀ (as bs cs : List Wire) (cin t : Wire),
    gateSlots (eraseLtChain as bs cs cin t) = elS as bs cs
  | a::a'::as, b::b'::bs, c::cs, cin, t => by
    simp only [eraseLtChain, elS, gateSlots_append, elS_eq (a'::as) (b'::bs) cs c t, bmaj_eq, eb_eq]
  | [a], [b], cs, cin, t => by simp only [eraseLtChain, elS, eb_eq]
  | [], _, _, _, _ => rfl
  | [_], [], _, _, _ => rfl
  | [_], _::_::_, _, _, _ => rfl
  | _::_::_, [], _, _, _ => rfl
  | _::_::_, [_], _, _, _ => rfl
  | _::_::_, _::_::_, [], _, _ => rfl

def skS : Nat → List MappedBit → List Wire → List Wire → Nat
  | 0, bits, ys, cs => addS bits ys cs
  | k+1, b::b'::bits, _::y'::ys, _::cs => skS k (b'::bits) (y'::ys) cs + ecS b + sumS b
  | _+1, bits, ys, cs => addS bits ys cs

theorem skS_eq : ∀ (k : Nat) (bits : List MappedBit) (ys cs : List Wire) (cin : Wire),
    gateSlots (Skip4.addSkip k bits ys cs cin) = skS k bits ys cs
  | 0, bits, ys, cs, cin => addS_eq bits ys cs cin
  | k+1, b::b'::bits, y::y'::ys, c::cs, cin => by
    simp only [Skip4.addSkip, skS, gateSlots_append, skS_eq k (b'::bits) (y'::ys) cs c, ec_eq, sum_eq]
  | _+1, [], ys, cs, cin => addS_eq [] ys cs cin
  | _+1, [b], ys, cs, cin => addS_eq [b] ys cs cin
  | _+1, b::b'::bits, [], cs, cin => addS_eq (b::b'::bits) [] cs cin
  | _+1, b::b'::bits, [y], cs, cin => addS_eq (b::b'::bits) [y] cs cin
  | _+1, b::b'::bits, y::y'::ys, [], cin => addS_eq (b::b'::bits) (y::y'::ys) [] cin

def esS : Nat → List Wire → List Wire → List Wire → Nat
  | 0, xs, ys, cs => elS xs ys cs
  | k+1, _::a'::as, _::b'::bs, _::cs => esS k (a'::as) (b'::bs) cs + ebS
  | _+1, xs, ys, cs => elS xs ys cs

theorem esS_eq : ∀ (k : Nat) (xs ys cs : List Wire) (cin t : Wire),
    gateSlots (Skip4.eraseSkip k xs ys cs cin t) = esS k xs ys cs
  | 0, xs, ys, cs, cin, t => elS_eq xs ys cs cin t
  | k+1, a::a'::as, b::b'::bs, c::cs, cin, t => by
    simp only [Skip4.eraseSkip, esS, gateSlots_append, esS_eq k (a'::as) (b'::bs) cs c t, eb_eq]
  | _+1, [], ys, cs, cin, t => elS_eq [] ys cs cin t
  | _+1, [a], ys, cs, cin, t => elS_eq [a] ys cs cin t
  | _+1, a::a'::as, [], cs, cin, t => elS_eq (a::a'::as) [] cs cin t
  | _+1, a::a'::as, [b], cs, cin, t => elS_eq (a::a'::as) [b] cs cin t
  | _+1, a::a'::as, b::b'::bs, [], cin, t => elS_eq (a::a'::as) (b::b'::bs) [] cin t

end LT48B





section K2HitSec
set_option maxRecDepth 100000

namespace K2Hit
def corrHit (m : Nat) : Correction → Bool
  | .Z a => m.testBit a
  | .CZ a b => m.testBit a || m.testBit b

def instrHit (m : Nat) : Instr → Bool
  | .X a => m.testBit a
  | .CX a b => m.testBit a || m.testBit b
  | .CCX a b d => m.testBit a || m.testBit b || m.testBit d
  | .measureX a cs ds => m.testBit a || cs.any (corrHit m) || ds.any (corrHit m)




end K2Hit

