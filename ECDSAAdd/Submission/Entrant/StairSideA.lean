      ⟨trivial, by simp [StairField2V3ExitGates.tgt, StairField2V3ExitGates.ctrlWires]⟩ t
  have comm : ∀ t, run StairSchedule.hostedX [] (run StairSchedule.paritySetup [] t) =
      run StairSchedule.paritySetup [] (run StairSchedule.hostedX [] t) := by
    intro t
    have e := XS_eq_SX t
    simp only [XS, SX, run_append, List.take_nil, List.drop_nil] at e
    exact e.symm
  simp only [SX, run_append, List.take_nil, List.drop_nil]
  rw [← comm, setup_invol, x2]

