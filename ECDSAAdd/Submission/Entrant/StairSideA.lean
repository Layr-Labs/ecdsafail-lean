/-!
# Direct caller-domain checks of the CANON v3 pieces (LT11)

`decide +kernel` checks (`allCaller`) of the v3 pieces not covered by the
structural lemmas: LT14's full-rail orientation `StairV3Primitives.orient` at
the five field checkpoints and (phase-relabelled) at 425, and LT8's loaned
converters `StairBoundaryLoan.canon760Loan` / `center760Loan`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

set_option maxHeartbeats 4000000 in
theorem orientV3_checks :
    ∀ f ∈ [450, 465, 480, 490, 500], allCaller (StairV3Primitives.orient f) = true := by
  decide +kernel

theorem orientV3_own (f : Nat) (hf : f ∈ [450, 465, 480, 490, 500]) :
    wires (StairV3Primitives.orient f) ⊆ callerDomain :=
