theorem fieldPlace_injective : Function.Injective StairOuterPlacement.fieldPlace := by
  intro a b h
  unfold StairOuterPlacement.fieldPlace at h
  exact Prefix1590.borrow.injective (HostOB5.hostSwap_injective
    ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host).injective h))

theorem liftF_wires (P : Program) (q : Wire) (hq : q ∈ wires (liftF P)) :
    ∃ r ∈ wires P, q = StairOuterPlacement.fieldPlace r := by
  unfold liftF StairSchedule.fieldRename StairSchedule.parityRename at hq
  rw [renameProgram_support, renameProgram_support, renameProgram_support] at hq
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hq
  obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ha
  obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hb
  exact ⟨c, hc, rfl⟩

theorem lift_away (B : Nat) (P : Program)
    (h : ∀ r ∈ futurePayload B, r ∉ wires P) :
    ∀ q ∈ Δv B, q ∉ wires (liftF P) := by
  intro q hq hw
  obtain ⟨r, hr, rfl⟩ := liftF_wires P q hw
  simp only [Δv, List.mem_toFinset, List.mem_map] at hq
  obtain ⟨f, hf, he⟩ := hq
  rw [fieldPlace_injective he] at hf
  exact h r hf hr

theorem grp_away (B : Nat) (hB : B ∈ budgets) (j n : Nat) (h : j + n ≤ startFor B / 5) :
    ∀ q ∈ Δv B, q ∉ wires (grp j n) :=
  lift_away B _ (StairField2V3Groups.groups_avoid_payload true B hB n j h)

theorem grpF_away (B : Nat) (hB : B ∈ budgets) (j n : Nat) (h : j + n ≤ startFor B / 5) :
    ∀ q ∈ Δv B, q ∉ wires (grpF j n) :=
  lift_away B _ (StairField2V3Groups.groups_avoid_payload false B hB n j h)

