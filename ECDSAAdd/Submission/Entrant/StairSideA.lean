/-!
# Exit core: the walk obligation (LT24)

`walk_of_core` reduces the `Walk k` obligation of `exitCore_of_parts` to
`WalkCore k`: on the state reached after the record prefix and the parity
setup / hosted X, the staircase walk `WT · W500 · W490 · W480 · W465 · W450 · FU`
gives the same state as the record reverse terminal + unticks `505 .. 425`
(`RefWalk`), for independent tapes.  Proved here: the setup / X commutation
(`base 511` is neither a payload control nor the parity host) and the tape
bookkeeping (via `refTailFree`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3ExitAlgebra



theorem setup_wires (cs : List Wire) (h q : Wire)
    (hq : q ∈ wires (ParityHost5.setup cs h)) : q ∈ cs ∨ q = h := by
  induction cs with
  | nil => simp [ParityHost5.setup, wires] at hq
  | cons c cs ih =>
      simp only [ParityHost5.setup, List.map_cons, wires, Finset.mem_union] at hq
      rcases hq with hq | hq
      · simp [Instr.wires] at hq
        rcases hq with rfl | rfl
        · exact Or.inl List.mem_cons_self
        · exact Or.inr rfl
      · rcases ih (by simpa [ParityHost5.setup] using hq) with h1 | h1
        · exact Or.inl (List.mem_cons_of_mem _ h1)
        · exact Or.inr h1



theorem XS_measurements : measurementCount XS = 0 := by
  simp only [XS, StairSchedule.paritySetup, StairSchedule.hostedX, measurementCount_append,
    setup_measurements]
  rfl


theorem controls_avoid_511 : base 511 ∉ FrontierEntry1591Field.controls := by
  decide +kernel

theorem host_ne_511 : FrontierEntry1591Field.host ≠ base 511 := by
  decide +kernel

theorem XS_eq_SX (s : State) : run XS [] s = run SX [] s := by
  have hd : Disjoint (wires StairSchedule.hostedX) (wires StairSchedule.paritySetup) := by
    rw [Finset.disjoint_left]
    intro q hq hq'
    simp [StairSchedule.hostedX, wires, Instr.wires] at hq
    subst hq
    rcases setup_wires _ _ _ hq' with h | h
    · exact controls_avoid_511 h
    · exact host_ne_511 h.symm
  simp only [XS, SX, run_append]
  simp only [List.take_nil, List.drop_nil]
  exact (run_disjoint_commute _ _ hd [] [] s).symm

/- LT47: removed (dead LT24 exit-core route; its walk began with the unwindowed `SX`,
which is not the fixed program). -/

