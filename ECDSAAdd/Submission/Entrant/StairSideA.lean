    renameProgram (Equiv.swap (base 760) (base 717))
      (renameProgram (shifted Placement5.pi0) (rawEnd true)) := rfl

/-! ## Generic helpers -/


theorem selW_run (g f : Wire) (P : Program) (m : List Bool) (s : State) :
    run (SW.selW g f P) m s =
      run [.measureX f [] [.Z g]] (m.drop (measurementCount P)) (run P m (run [.CX g f] [] s)) := by
  have h0 : measurementCount [Instr.CX g f] = 0 := rfl
  rw [SW.selW, run_append, measurementCount_append, run_append, h0, Nat.zero_add, List.drop_zero,
    List.take_zero, run_take]

/-- The selector measurement is record-independent when flag and source agree. -/
theorem meas_sel (f g : Wire) (hfg : f ≠ g) (Z : State) (h : Z.basis f = Z.basis g)
    (r : List Bool) :
    run [.measureX f [] [.Z g]] r Z = ⟨Z.phase, writeBit Z.basis f false⟩ := by
  show measureAndCorrect f [] [Correction.Z g] (r.headD false) Z = _
  unfold measureAndCorrect
  cases r.headD false
  · show (⟨Z.phase ^^ (false && Z.basis f), writeBit Z.basis f false⟩ : State) = _
    congr 1
    cases Z.phase <;> rfl
  · have hw : writeBit Z.basis f false g = Z.basis g := Function.update_of_ne (Ne.symm hfg) _ _
    show (⟨(Z.phase ^^ (true && Z.basis f)) ^^ writeBit Z.basis f false g,
      writeBit Z.basis f false⟩ : State) = _
    rw [hw, h]
    congr 1
    cases Z.phase <;> cases Z.basis g <;> rfl

