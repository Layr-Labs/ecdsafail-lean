    wires (renameProgram StairPhysicalLayout.phaseRelabel (StairV3Primitives.orient 425)) ⊆
      callerDomain :=
  allCaller_sound _ (by decide +kernel)

/-- LT44 (replay budget): the 44 borrowed converter hosts are caller wires (one small kernel
evaluation; the loaned programs themselves are no longer evaluated: 24 s + 18 s). -/
theorem converterHosts_caller :
    StairBoundaryLoan.converterHosts.all callerNat = true := by
  decide +kernel

private theorem own_of_envelope {P Q : Program}
    (env : wires P ⊆ wires Q ∪ StairBoundaryLoan.converterHosts.toFinset)
    (hQ : wires Q ⊆ callerDomain) : wires P ⊆ callerDomain := by
  intro q hq
  rcases Finset.mem_union.mp (env hq) with h | h
  · exact hQ h
  · exact callerNat_sound q
      (List.all_eq_true.mp converterHosts_caller q (List.mem_toFinset.mp h))

theorem canon760Loan_own : wires StairBoundaryLoan.canon760Loan ⊆ callerDomain :=
  own_of_envelope StairBoundaryLoan.canon760Loan_envelope canon760_own

