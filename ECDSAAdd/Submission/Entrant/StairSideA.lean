  rw [Rolling1588.exitFieldHosted, ParityField1591.program, ParityHostTransport5.program, FrontierEntry1591Field.hosted, Rolling1588.exitField, Rolling1588.exitHead, StairSchedule.paritySetup, StairSchedule.hostedX]
  refine ⟨?_, ?_⟩
  · simp only [toffoliCount_append, renameProgram_counts, Nat.add_assoc]
  · simp only [measurementCount_append, renameProgram_counts, Nat.add_assoc]

end ECDSAAdd.Entrant.StairCountsHosted
end Merge_StairCountsHostedShapeXR_at_StairSideA

