/-! ## The four loaned tops in each balanced half -/

theorem rawAddLoan_slots_le (d : Nat) (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hd : d <= 68) :
    gateSlots (StairLoan.rawAddLoan d L) <=
      gateSlots (Q6LifetimeResearch.rawAdd (base 760) L) + 14 * d := by
  have w := BalancedCleanup.widths L.toLayout hw
  have ql : (Q6Structural.q6Carry L).length = 256 :=
    (Q6StructuralCell.carry_widths L hw).2.2
  have yl : L.ylow.length = 255 := hw.2.1
  have rl : L.low.length = 255 := w.1
  have cl : ((Q6Structural.q6Carry L).take 255).length = 255 := by
    simp [List.length_take, ql]
  have add := addPrefixLoan_slots_le d StairLoan.retiredRoles
    (L.ylow.drop 1) (L.low.drop 1)
    (((Q6Structural.q6Carry L).take 255).drop 1)
    L.ymsb L.rmsb L.one (((Q6Structural.q6Carry L).take 255).getD 0 0)
    (by simp [yl, rl]) (by simp [yl, cl]) (by simp [cl]; omega)
  simp only [StairLoan.rawAddLoan, Q6LifetimeResearch.rawAdd,
    Q6LifetimeResearch.move, gateSlots_append, slots_reverse,
    rename_gateSlots] at add ⊢
  omega

theorem foldLoan_slots_le (d : Nat) (L : BalancedCircuit.Layout)
