theorem holes_nat : holes=List.range' 4835 40++List.range' 4876 4 := by
  -- K4-D (replay budget): symbolic (was a pool walk per hole)
  have b1 : (List.range' 720 40).map Baselines.layout.core.poolWire = List.range' 4835 40 :=
    K4DE.blk 720 40 (by decide)
  have b2 : (List.range' 761 4).map Baselines.layout.core.poolWire = List.range' 4876 4 :=
    K4DE.blk 761 4 (by decide)
  show (List.range' 720 40 ++ List.range' 761 4).map Baselines.layout.core.poolWire =
    List.range' 4835 40 ++ List.range' 4876 4
  rw [List.map_append, b1, b2]


end K2



