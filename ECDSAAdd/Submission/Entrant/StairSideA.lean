theorem stage_physical :
    GatePhysical Rolling1588.stageOpen ∧
    GatePhysical Rolling1588.stageClose ∧
    ∀ divide k, k < 2 →
      GatePhysical (Rolling1588.stageTransition divide k) := by
  refine ⟨?_, ?_, ?_⟩
  · apply physicalGateCheck_correct
    decide +kernel
  · apply physicalGateCheck_correct
    decide +kernel
  · intro divide k hk
    apply physicalGateCheck_correct
    cases divide <;> interval_cases k <;> decide +kernel

theorem loanBasePacket_physical (divide : Bool)
    (d j : Nat) (hj : j < 102) :
    GatePhysical (StairGroups.basePacket divide d j) := by
  have opening := onPacket_physical j hj
    Rolling1588.stageOpen Rolling1588.stageOpen_support stage_physical.1
  have closing := onPacket_physical j hj
    Rolling1588.stageClose Rolling1588.stageClose_support stage_physical.2.1
  have transfer (b : Bool) (k : Nat) (hk : k < 2) :=
    onPacket_physical j hj (Rolling1588.stageTransition b k)
      (Rolling1588.stageTransition_support b k hk)
      (stage_physical.2.2 b k hk)
  have cellAt (k : Nat) (hk : k < 5) :=
    loanCell_physical divide d j k 2 hj hk
  cases divide <;>
    simp only [StairGroups.basePacket, Rolling1588.stageOpen,
      Rolling1588.stageClose, Bool.false_eq_true, if_false, if_true,
      gatePhysical_append]
  all_goals repeat' apply And.intro
  all_goals first
    | exact opening
    | exact closing
    | exact transfer false 0 (by decide)
    | exact transfer false 1 (by decide)
    | exact transfer true 0 (by decide)
    | exact transfer true 1 (by decide)
    | exact cellAt 3 (by decide)
    | exact cellAt 4 (by decide)

