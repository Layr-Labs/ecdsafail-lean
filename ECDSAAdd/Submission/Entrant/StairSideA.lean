/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSiteEasyCore_at_QTop` -/
section Merge_StairSiteEasyCore_at_QTop

/-!
# Field 12 on CANON 1945, easy pieces: a fast checker for the 39-hole list (LT35)

`Good39 q` is an interval test (no list walks except the 15 old omissions):
`q` is in the record arena, is not an old omission and is not one of the
39 holes `poolWire 725 .. 759, 761 .. 764 = 4840 .. 4874, 4876 .. 4879`.
`good39_spec` turns it into the three facts that `PieceOK holes39` needs.

Two ways to close a piece `PieceOK holes39 f P`:
* `ok39_of_cover`: a support lemma `∀ x ∈ wires P, x ∈ S` for a small
  (duplicate-free) list `S`, plus one `decide +kernel` of `∀ x ∈ S, Good39 (f x)`;
* `ok39_of_all`: an iterative per-instruction check (small programs only).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance StairPhysicalLayout

/-- The record arena (`arenaNat`) as intervals. -/
def Arena39 (q : Nat) : Prop :=
  q ≤ 513 ∨ q = 4112 ∨ (4115 ≤ q ∧ q < 4630) ∨ (4833 ≤ q ∧ q < 5144) ∨
    (5399 ≤ q ∧ q < 5656) ∨ q = 5915 ∨ q = 9814 ∨ q = 9815

/-- The 39 holes (`holes39`) as intervals. -/
def Hole39 (q : Nat) : Prop := (4840 ≤ q ∧ q < 4875) ∨ (4876 ≤ q ∧ q < 4880)

/-- A good physical site for the 39-hole certificate. -/
def Good39 (q : Nat) : Prop := Arena39 q ∧ q ∉ oldHolesNat ∧ ¬ Hole39 q




theorem holes39_eq : StairCertificate.holes39 = List.range' 4840 35 ++ List.range' 4876 4 := by
  -- K4-B (replay budget): pool wires in closed form (`poolWire_eq`) instead of list lookups
  have e : StairCertificate.holes39 = StairCertificate.holeIndices39.map (fun i => 4115 + i) := by
    unfold StairCertificate.holes39
    apply List.map_congr_left
    intro i hi
    apply StairHoleSupport.poolWire_eq
    simp only [StairCertificate.holeIndices39, List.mem_append, List.mem_range'_1] at hi
    omega
  rw [e]
  decide +kernel

theorem arena39_mem {q : Nat} (h : Arena39 q) : q ∈ arenaNat := by
  unfold Arena39 at h
  simp only [arenaNat, List.mem_append, List.mem_cons, List.mem_range'_1, List.not_mem_nil,
    or_false]
  omega

theorem hole39_of_mem {q : Nat} (h : q ∈ StairCertificate.holes39) : Hole39 q := by
  rw [holes39_eq] at h
  simp only [List.mem_append, List.mem_range'_1] at h
  unfold Hole39
  omega

theorem good39_spec {q : Wire} (h : Good39 q) :
    q ∈ StairHoleSupport.recordArena ∧ q ∉ StairHoleSupport.oldHoles ∧
      q ∉ StairCertificate.holes39 := by
  rw [recordArena_eq, oldHoles_eq]
  exact ⟨arena39_mem h.1, h.2.1, fun m => h.2.2 (hole39_of_mem m)⟩

/-- The basic closing lemma. -/
theorem ok39_of_good {f : Wire → Wire} {P : Program}
    (h : ∀ x ∈ wires P, Good39 (f x)) : PieceOK StairCertificate.holes39 f P :=
  ⟨fun x hx => ⟨(good39_spec (h x hx)).1, (good39_spec (h x hx)).2.1⟩,
    fun x hx => (good39_spec (h x hx)).2.2⟩





/-! ## LT46: kernel-fast checks on the closed-form placements -/

/-- LT46 (replay budget): `Good39` as one Boolean interval test on a literal
(`Nat.ble` / `Nat.beq` only; no instance unfolding, no list walk). -/
def good39B (q : Nat) : Bool :=
  (Nat.ble q 513 || Nat.beq q 4112 || (Nat.ble 4115 q && Nat.blt q 4630) ||
      (Nat.ble 4835 q && Nat.blt q 5144) || (Nat.ble 5399 q && Nat.blt q 5656) ||
      Nat.beq q 9814) &&
    !(Nat.beq q 5515 || Nat.beq q 5655 || Nat.beq q 5400 || Nat.beq q 5401 ||
      (Nat.ble 4840 q && Nat.blt q 4886))

theorem good39_of_B {q : Nat} (h : good39B q = true) : Good39 q := by
  simp only [good39B, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', Bool.eq_false_iff,
    ne_eq, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq] at h
  refine ⟨?_, ?_, ?_⟩
  · unfold Arena39; omega
  · simp only [oldHolesNat, List.mem_cons, List.not_mem_nil, or_false]; omega
  · unfold Hole39; omega









/-! ## K4-B (replay budget): `ppList_good` / `tpList_good` by intervals

On every interval below the closed-form placement is affine (all literal exchanges are the
identity, `pwB` is one interval shift), so goodness is proved symbolically; only the ~20
exceptional labels are evaluated. -/

theorem kbSw_id {a b q : Nat} (h1 : q ≠ a) (h2 : q ≠ b) : StairPlaceFast.swB a b q = q := by
  simp only [StairPlaceFast.swB, cond_eq_ite, Nat.beq_eq, if_neg h1, if_neg h2]

theorem kbKT {w : Nat} (h : (2 ≤ w ∧ w < 4112) ∨ (4114 ≤ w ∧ w < 4799) ∨ (4833 ≤ w ∧ w < 5515) ∨
    (5516 ≤ w ∧ w < 5655) ∨ (5656 ≤ w ∧ w < 9814)) :
    StairPlaceFast.swB 4799 4832 (StairPlaceFast.swB 9815 0 (StairPlaceFast.swB 9815 5655
      (StairPlaceFast.swB 4112 4799 (StairPlaceFast.swB 4113 9814 (StairPlaceFast.swB 4799 4832
        (StairPlaceFast.swB 1 5515 w)))))) = w := by
  have h0 : w ≠ 0 := by omega
  have h1 : w ≠ 1 := by omega
  have h2 : w ≠ 4112 := by omega
  have h3 : w ≠ 4113 := by omega
  have h4 : w ≠ 4799 := by omega
  have h5 : w ≠ 4832 := by omega
  have h6 : w ≠ 5515 := by omega
  have h7 : w ≠ 5655 := by omega
  have h8 : w ≠ 9814 := by omega
  have h9 : w ≠ 9815 := by omega
  rw [kbSw_id h1 h6, kbSw_id h4 h5, kbSw_id h3 h8, kbSw_id h2 h4, kbSw_id h9 h7, kbSw_id h9 h0,
    kbSw_id h4 h5]

theorem kbPH {x : Nat} (h : x < 736 ∨ (739 ≤ x ∧ x < 1042) ∨ (1043 ≤ x ∧ x < 1557) ∨ 1559 ≤ x) :
    StairPlaceFast.phaseHostB x = x := by
  unfold StairPlaceFast.phaseHostB
  rw [kbSw_id (show x ≠ 1042 by omega) (show x ≠ 737 by omega),
    kbSw_id (show x ≠ 1557 by omega) (show x ≠ 738 by omega),
    kbSw_id (show x ≠ 1558 by omega) (show x ≠ 736 by omega)]


theorem kbPw_lo {i : Nat} (h : i < 770) : StairPlaceFast.pwB i = 4115 + i := by
  unfold StairPlaceFast.pwB
  simp only [cond_eq_ite, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq]
  split_ifs <;> omega

theorem kbPw_x {i : Nat} (h1 : 770 ≤ i) (h2 : i < 1026) : StairPlaceFast.pwB i = i - 768 := by
  unfold StairPlaceFast.pwB
  simp only [cond_eq_ite, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq]
  split_ifs <;> omega

theorem kbPw_mid {i : Nat} (h1 : 1026 ≤ i) (h2 : i < 2056) :
    StairPlaceFast.pwB i = 4115 + (i - 256) := by
  unfold StairPlaceFast.pwB
  simp only [cond_eq_ite, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq]
  split_ifs <;> omega

theorem kbPw_y {i : Nat} (h1 : 2056 ≤ i) (h2 : i < 2312) : StairPlaceFast.pwB i = i - 1798 := by
  unfold StairPlaceFast.pwB
  simp only [cond_eq_ite, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq]
  split_ifs <;> omega

theorem kbPw_meta {i : Nat} (h1 : 2314 ≤ i) (h2 : i ≤ 2400) : StairPlaceFast.pwB i = 4113 := by
  unfold StairPlaceFast.pwB
  rw [show Nat.blt i 2314 = false from Bool.eq_false_iff.mpr (fun h => by
    rw [Nat.blt_eq] at h; omega), cond_false, show i - 2400 = 0 by omega]
  rfl

theorem kbG_lo {w : Nat} (h : w ≤ 513) : good39B w = true := by
  simp only [good39B, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', Bool.eq_false_iff,
    ne_eq, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq]
  omega

theorem kbG_in {w a b : Nat} (hab : (4115 ≤ a ∧ b ≤ 4630) ∨ (4835 ≤ a ∧ b ≤ 4840) ∨
    (4886 ≤ a ∧ b ≤ 5144) ∨ (5402 ≤ a ∧ b ≤ 5515) ∨ (5516 ≤ a ∧ b ≤ 5655))
