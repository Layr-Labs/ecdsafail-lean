    decide (RoleI y) || decide (TPI (OB5.sig 511 y))) = true := by
  decide +kernel

theorem endPacket760_false_shape :
    R2SqEp760.endPacket760 false =
      renameProgram (Equiv.swap (base 760) (base 717))
        (renameProgram (shifted Placement5.pi0)
          (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
            (InverseEndpointC.half endLayout ++
              List.replicate 256 (Instr.measureX (base 512) [] [])))) := by
  unfold R2SqEp760.endPacket760 Rolling1588Lifetime.endPacket
    Rolling1588Lifetime.rawEnd Rolling1588Lifetime.endHalf
  rfl

attribute [local irreducible] ECDSAAdd.wires in
