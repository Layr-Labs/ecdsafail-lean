/-- The history letter `s 510` of the walk of `x`. -/
def s510 (x : Nat) : Bool :=
  (SkywalkTrace.code (SkywalkTrace.next^[510]
    (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).2


/-- **Record-side predicate of the last step (LT47, fixed program)**: clean scratch, the
window wires hold the window image of a clean canonical `s1`, and the payload parity
read between the windows (packet 0 from `s1`) is `s 510`. -/
def lastΦx (x : Nat) (b : BasisState) : Prop :=
  CleanT b ∧ ∃ s1 : State, StairField2V3Win.WinImg b s1 ∧
    TraceParity5.parity (FrontierEntry1591Field.controls.map (StairField2V3Win.mix b s1)) =
      s510 x






