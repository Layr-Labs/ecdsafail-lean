/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanField7R_at_QTop` -/
section Merge_StairLoanField7R_at_QTop

/-!
# LT43e: field 7 from the multiplication plan with reachability (`ExitPlanR`)

`StairLoanField7Values.loan_composition_final` needs LT21's generic `ExitPlan`, which
cannot be instantiated (its relations carry no reachability).  LT43's `ExitPlanR p k x`
carries `ReachBy (ExitMiddleX k x) Y t` for the RECORD reference prefixes `YA..YF`.
In the loaned chain the reference prefixes are the LOANED ones (`YAL..YFL bestLoans`), so
every step of the plan needs the exit reach transport

  `ReachBy (ExitMiddleX k x) (Y?L bestLoans) t → ReachBy (ExitMiddleX k x) Y? t`.

All six cuts (and the head) have the same shape

  `PRE ++ liftF (center ++ copyN ++ rename (sig 511) (endpoint 68 ++ slices L))`

with `L` a prefix of the multiplication slice list (a `BackwardChain 102 low L`), so one
run equality (`exitShape_run`, LT32's `exitHead_run` for an arbitrary backward chain `L`)
gives all of them; `lowTail` is a shared tail (`reach_tail`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairLoanField7R

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairField2V3ExitPlanR StairLoanField7Transport StairLoanField7Values
open StairLoanRecordShape

attribute [local irreducible] wires run

/-! ## The common shape of the loaned reference prefixes -/

/-- Setup, hosted X and scratch clear (shared by both loan providers). -/
def PRE : Program :=
  StairSchedule.paritySetup ++ StairSchedule.hostedX ++
    StairSchedule.fieldRename FourScratchWindow.clearProgram

/-- Head + the multiplication slices `L` (logical coordinates). -/
def headShape (loans : StairSchedule.StairLoans) (L : List (Nat × Nat × Nat)) : Program :=
  loans.center ++ HalfFieldOB5.copyN ++
    renameProgram (OB5.sig 511) (loans.endPacket false 68 ++ slices loans false L)

def SlH : List (Nat × Nat × Nat) := [(43, 100, 2)]
def SlA : List (Nat × Nat × Nat) := [(43, 100, 2), (41, 98, 2)]
def SlB : List (Nat × Nat × Nat) := [(43, 100, 2), (41, 98, 2), (36, 96, 2)]
def SlC : List (Nat × Nat × Nat) := [(43, 100, 2), (41, 98, 2), (36, 96, 2), (30, 93, 3)]
def SlD : List (Nat × Nat × Nat) :=
  [(43, 100, 2), (41, 98, 2), (36, 96, 2), (30, 93, 3), (22, 90, 3)]
def SlE : List (Nat × Nat × Nat) :=
  [(43, 100, 2), (41, 98, 2), (36, 96, 2), (30, 93, 3), (22, 90, 3), (13, 85, 5)]
def SlF : List (Nat × Nat × Nat) :=
  [(43, 100, 2), (41, 98, 2), (36, 96, 2), (30, 93, 3), (22, 90, 3), (13, 85, 5), (0, 1, 84)]

theorem SlH_chain : BackwardChain 102 100 SlH := by simp [BackwardChain, SlH]
theorem SlA_chain : BackwardChain 102 98 SlA := by simp [BackwardChain, SlA]
theorem SlB_chain : BackwardChain 102 96 SlB := by simp [BackwardChain, SlB]
theorem SlC_chain : BackwardChain 102 93 SlC := by simp [BackwardChain, SlC]
theorem SlD_chain : BackwardChain 102 90 SlD := by simp [BackwardChain, SlD]
theorem SlE_chain : BackwardChain 102 85 SlE := by simp [BackwardChain, SlE]
theorem SlF_chain : BackwardChain 102 1 SlF := by simp [BackwardChain, SlF]

/-! ## Loaned reference prefixes (left-nested, as produced by `crel_track`) -/

def YAL (loans : StairSchedule.StairLoans) : Program := headEL loans ++ grpFL loans 41 98 2
def YBL (loans : StairSchedule.StairLoans) : Program := YAL loans ++ grpFL loans 36 96 2
