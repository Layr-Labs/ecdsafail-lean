/-!
# Field 12 on CANON 1945: the 14 hosted packet groups (LT35)

`hostedGroup hp divide d first count = rebindMany (exclusiveRoles.drop d) hosts P`
with `P = renameProgram (OB5.sig 511) (StairGroups.groups divide d first count)`.

* `rebind_mem`: a label of a rebound program is a host, or a label of `P`
  that is not a rebound role (hosts fresh: LT25's `hostPlan_group_fresh`).
* A label of `P` is `Mj j z = OB5.sig 511 (shifted (Placement5.pi j) z)` for a
  packet `j ∈ [first, first + count)` and a label `z` of `basePacket divide d j`.
* `basePacket_tgt`: for `1 ≤ j < 102` and `d ≤ 44`, every such label avoids the
  loaned roles `exclusiveRoles.take d` and is a role or `TPI`.  The packet's
  fixed parts (`onPacket` blocks, `selW`, the loan-window gates) are checked by
  small tables; the five loaned halves use LT9's `half760Loan_support760`
  (a loaned half uses only record half760 labels and avoids
  `StairLoan.retiredRoles.take d = exclusiveRoles.take d`) and a table of the
  record half labels (each placed half label is a fixed role or a non-role `TPI`
  label).  The packet map `Mj j` equals the fixed map `M0` except on six labels
  (`pi_eq_pi0`), so the big tables do not depend on `j`.
* Hence every label of the hosted group is a host or a non-role label of `P`,
  i.e. `TPI`, and `tpList_good` finishes.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance

/-! ## Rebinding -/

theorem rebind_mem : ∀ (rs hs : List Wire) (P : Program),
    (∀ h ∈ hs, h ∉ wires P) → (∀ r ∈ rs, r ∉ hs) → rs.Nodup → hs.Nodup →
    rs.length ≤ hs.length →
    ∀ x ∈ wires (StairLoan.rebindMany rs hs P), x ∈ hs ∨ (x ∈ wires P ∧ x ∉ rs)
  | [], hs, P, _, _, _, _, _, x, hx => by
      right
      simp only [StairLoan.rebindMany] at hx
      exact ⟨hx, by simp⟩
  | _ :: _, [], _, _, _, _, _, hlen, _, _ => by simp at hlen
  | r :: rs, h :: hs, P, fresh, disj, nr, nh, hlen, x, hx => by
      simp only [StairLoan.rebindMany] at hx
      rw [renameProgram_support] at hx
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      have nr' := List.nodup_cons.mp nr
      have nh' := List.nodup_cons.mp nh
      have dr := disj r (List.mem_cons_self ..)
      have rh : r ≠ h := fun e => dr (e ▸ List.mem_cons_self ..)
      have rhs : r ∉ hs := fun m => dr (List.mem_cons_of_mem _ m)
      have ih := rebind_mem rs hs P (fun q hq => fresh q (List.mem_cons_of_mem _ hq))
        (fun q hq m => disj q (List.mem_cons_of_mem _ hq) (List.mem_cons_of_mem _ m))
        nr'.2 nh'.2 (by simp at hlen; omega) y hy
      rcases ih with hyh | ⟨hyP, hyr⟩
      · left
        have y1 : y ≠ r := fun e => rhs (e ▸ hyh)
        have y2 : y ≠ h := fun e => nh'.1 (e ▸ hyh)
        rw [Equiv.swap_apply_of_ne_of_ne y1 y2]
        exact List.mem_cons_of_mem _ hyh
      · by_cases e1 : y = r
        · left
          rw [e1, Equiv.swap_apply_left]
          exact List.mem_cons_self ..
        · by_cases e2 : y = h
          · exact absurd (e2 ▸ hyP) (fresh h (List.mem_cons_self ..))
          · right
            rw [Equiv.swap_apply_of_ne_of_ne e1 e2]
            refine ⟨hyP, ?_⟩
            intro m
            rcases List.mem_cons.mp m with m | m
            · exact e1 m
            · exact hyr m

/-! ## Packet sequences -/

theorem seq_mem (fw : Bool) (p : Nat → Program) : ∀ (n j : Nat) (x : Wire),
    x ∈ wires (PacketSequence.program fw p j n) → ∃ i, j ≤ i ∧ i < j + n ∧ x ∈ wires (p i)
  | 0, j, x, h => by simp [PacketSequence.program, wires] at h
  | n + 1, j, x, h => by
      have ih := seq_mem fw p n (j + 1) x
      cases fw <;>
        simp only [PacketSequence.program, Bool.false_eq_true, if_false, if_true, wires_append,
          Finset.mem_union] at h
      · rcases h with h | h
        · obtain ⟨i, h1, h2, h3⟩ := ih h
          exact ⟨i, by omega, by omega, h3⟩
        · exact ⟨j, le_refl _, by omega, h⟩
      · rcases h with h | h
        · exact ⟨j, le_refl _, by omega, h⟩
        · obtain ⟨i, h1, h2, h3⟩ := ih h
          exact ⟨i, by omega, by omega, h3⟩

/-! ## Per-packet label conditions -/

/-- Placement of a base-packet label of packet `j` inside the placed group. -/
def Mj (j : Nat) (z : Wire) : Wire := OB5.sig 511 (shifted (Placement5.pi j) z)

/-- A good non-role group label. -/
def GC (y : Wire) : Prop := y ∉ StairSchedule.exclusiveRoles ∧ TPI y

instance instDecGC (y : Wire) : Decidable (GC y) := by
  unfold GC; infer_instance

/-- The target property of a piece of packet `j` at deficit `d`. -/
def Tgt (d j : Nat) (P : Program) : Prop :=
  ∀ z ∈ wires P, Mj j z ∉ StairSchedule.exclusiveRoles.take d ∧
    (Mj j z ∈ StairSchedule.exclusiveRoles ∨ TPI (Mj j z))

theorem tgt_append {d j : Nat} {P Q : Program} : Tgt d j (P ++ Q) ↔ Tgt d j P ∧ Tgt d j Q := by
  unfold Tgt
  constructor
  · intro h
    exact ⟨fun z hz => h z (by rw [wires_append]; exact Finset.mem_union_left _ hz),
      fun z hz => h z (by rw [wires_append]; exact Finset.mem_union_right _ hz)⟩
  · intro h z hz
    rw [wires_append, Finset.mem_union] at hz
    rcases hz with hz | hz
    · exact h.1 z hz
    · exact h.2 z hz


/-! ## Dedup'd label sets of the packet-independent pieces (probed, each checked once) -/

/-- Fixed per-packet labels: the two history-letter selectors, the two window letters,
the shared selector `base 2409` and the packet carry. -/
def fixedL (j : Nat) : List Wire :=
  [Rolling1588.s j 3, Rolling1588.s j 4, Rolling1588.g j 3, Rolling1588.g j 4, base 2409]

/-- Labels of `FrontierSW1591.swapBody`. -/
def SwI (z : Nat) : Prop := (786 ≤ z ∧ z < 1042) ∨ (2072 ≤ z ∧ z < 2328) ∨ z = 2425

instance instDecSwI (z : Nat) : Decidable (SwI z) := by unfold SwI; infer_instance

def swList : List Wire := List.range' 786 256 ++ List.range' 2072 256 ++ [2425]

theorem swI_mem {z : Nat} (h : SwI z) : z ∈ swList := by
  unfold SwI at h
  simp only [swList, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
    or_false]
  omega

theorem swapBody_in : ∀ z ∈ wires FrontierSW1591.swapBody, SwI z := by
  have h : allSites (fun z => decide (SwI z)) FrontierSW1591.swapBody = true := by
    decide +kernel
  exact fun z hz => of_decide_eq_true (allSites_sound h z hz)

/-- Labels of the record half `R2Life760.half760` (both directions). -/
def HalfI (h : Nat) : Prop :=
  (528 ≤ h ∧ h < 776) ∨ (777 ≤ h ∧ h < 781) ∨ h = 784 ∨ (786 ≤ h ∧ h < 1042) ∨ h = 1043 ∨
    h = 1556 ∨ h = 1813 ∨ (2072 ≤ h ∧ h < 2328) ∨ h = 2425

instance instDecHalfI (h : Nat) : Decidable (HalfI h) := by unfold HalfI; infer_instance

def half760L : List Wire :=
  List.range' 528 248 ++ List.range' 777 4 ++ [784] ++ List.range' 786 256 ++
    [1043, 1556, 1813] ++ List.range' 2072 256 ++ [2425]

theorem halfI_mem {h : Nat} (hh : HalfI h) : h ∈ half760L := by
  unfold HalfI at hh
  simp only [half760L, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
    or_false]
  omega

attribute [local irreducible] ECDSAAdd.wires OwnQ6Core5.kernel in
/-- LT45 (replay budget): structural instead of two kernel passes over the record half
(210 s): the record's layout support `R2Life760.half760_support` /
`OwnQ6Core5.support` minus the record's omission lemmas
`Q6EndpointOmissions.kernel_free` (labels `765, 766, 767, 1026, 1541, 2312`) and the
retired label `760`. -/
theorem half760_in (divide : Bool) : ∀ h ∈ wires (R2Life760.half760 divide), HalfI h := by
  intro h hh
  obtain ⟨h760, hold⟩ := Finset.mem_erase.mp (R2Life760.half760_support divide hh)
  have hw := Q6EndpointCell.ports_widths base (base 2409)
  have split : h = base 2409 ∨
      h ∈ wires (OwnQ6Core5.kernel divide (Q6EndpointCell.ports base (base 2409))) := by
    rw [Q6EndpointCell.half, OwnQ6Core5.half, wires_append, wires_append, Finset.mem_union,
      Finset.mem_union] at hold
    have one : ∀ s : Wire, h ∈ wires [Instr.X s] → h = s := by
      intro s hs
      simpa [wires, Instr.wires] using hs
    rcases hold with (hx | hk) | hx
    · exact Or.inl (one _ hx)
    · exact Or.inr hk
    · exact Or.inl (one _ hx)
  have sgn : HalfI (base 2409) := by decide
  rcases split with rfl | hk
  · exact sgn
  · have hp := (Q6EndpointCell.mem_ports_wires base (base 2409) h).mp
      (List.mem_toFinset.mp (OwnQ6Core5.support divide _ hw hk))
    rcases List.mem_cons.mp hp with rfl | hm
    · exact sgn
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hm
      have fr : ∀ k ∈ [1541, 1026, 2312, 766, 765, 767], i ≠ k := fun k hk' e =>
        Q6EndpointOmissions.kernel_free divide k hk' (e ▸ hk)
      have n1 := fr 1541 (by decide)
      have n2 := fr 1026 (by decide)
      have n3 := fr 2312 (by decide)
      have n4 := fr 766 (by decide)
      have n5 := fr 765 (by decide)
      have n6 := fr 767 (by decide)
      have n7 : i ≠ 760 := fun e => h760 (e ▸ rfl)
      simp only [Q6EndpointCell.ids, List.mem_append, List.mem_cons, List.mem_range'_1,
        List.not_mem_nil, or_false] at hi
      have hb : base i = i + 16 := rfl
      rw [hb]
      unfold HalfI
      omega

theorem small_code (X : Program) (hX : allSites (fun z => decide (z < 10)) X = true) :
    ∀ z ∈ wires X, z ∈ List.range 10 :=
  fun z hz => List.mem_range.mpr (of_decide_eq_true (allSites_sound hX z hz))

/-- Placed half label `h` of the window `(j, a)`. -/
def halfPlace (j a : Nat) (h : Wire) : Wire :=
  Mj j (Equiv.swap (Rolling1588.packetCarry j) (Rolling1588.g j a)
    (Equiv.swap (base 719) (Rolling1588.s j 2) h))

/-- The half-label condition. -/
def HC (j a : Nat) (h : Wire) : Prop :=
  (h ∈ StairSchedule.exclusiveRoles ∧ halfPlace j a h = h) ∨ GC (halfPlace j a h)

instance instDecHC (j a : Nat) (h : Wire) : Decidable (HC j a h) := by
  unfold HC; infer_instance

/-! ## The packet map off six special labels -/

/-- The packet-independent part of the packet placement. -/
def M0 (z : Wire) : Wire := OB5.sig 511 (shifted Placement5.pi0 z)

/-- The six labels on which `Placement5.pi j` differs from `pi0`. -/
def piSpec (j : Nat) : List Wire :=
  [base (Placement5.W (2 * j)), base (Placement5.H (2 * j)), base (Placement5.W (2 * j + 1)),
    base (Placement5.H (2 * j + 1)), base (Placement5.H 202), base (Placement5.H 203)]

theorem pi_eq_pi0 (j x : Nat) (h1 : x ≠ Placement5.W (2 * j)) (h2 : x ≠ Placement5.H (2 * j))
    (h3 : x ≠ Placement5.W (2 * j + 1)) (h4 : x ≠ Placement5.H (2 * j + 1))
    (h5 : x ≠ Placement5.H 202) (h6 : x ≠ Placement5.H 203) :
    Placement5.pi j x = Placement5.pi0 x := by
  unfold Placement5.pi
  simp only [Equiv.trans_apply, Equiv.swap_apply_of_ne_of_ne h1 h2,
    Equiv.swap_apply_of_ne_of_ne h3 h4, Equiv.swap_apply_of_ne_of_ne h2 h5,
    Equiv.swap_apply_of_ne_of_ne h4 h6]

theorem Mj_eq (j z : Nat) (hz : z ∉ piSpec j) : Mj j z = M0 z := by
  simp only [piSpec, List.mem_cons, List.not_mem_nil, or_false, not_or] at hz
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hz
  unfold Mj M0
  congr 1
  show shiftedFn (Placement5.pi j) z = shiftedFn Placement5.pi0 z
  unfold shiftedFn
  split_ifs with hlt
  · rfl
  · have ne (x : Nat) (h : z ≠ base x) : z - 16 ≠ x := by
      intro e; apply h; unfold base; omega
    rw [pi_eq_pi0 j (z - 16) (ne _ h1) (ne _ h2) (ne _ h3) (ne _ h4) (ne _ h5) (ne _ h6)]

/-- Special labels of the window `(j, a)`: the two half swaps and `piSpec j`. -/
def specW (j a : Nat) : List Wire :=
  Rolling1588.packetCarry j :: Rolling1588.g j a :: base 719 :: Rolling1588.s j 2 :: piSpec j

/-- Fixed-map version of the half condition. -/
def HC0 (h : Wire) : Prop :=
  (h ∈ StairSchedule.exclusiveRoles ∧ M0 h = h) ∨ GC (M0 h)

instance instDecHC0 (h : Wire) : Decidable (HC0 h) := by
  unfold HC0; infer_instance

theorem halfPlace_eq (j a h : Nat) (hs : h ∉ specW j a) : halfPlace j a h = M0 h := by
  have hs' := hs
  simp only [specW, List.mem_cons, not_or] at hs'
  obtain ⟨n1, n2, n3, n4, hp⟩ := hs'
  unfold halfPlace
  rw [Equiv.swap_apply_of_ne_of_ne n3 n4, Equiv.swap_apply_of_ne_of_ne n1 n2]
  exact Mj_eq j h hp

end ECDSAAdd.Entrant.StairSiteEasy

end
end Merge_StairSiteEasyGroupsBase_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSiteEasyGroupsTab_at_StairSideA` -/
section Merge_StairSiteEasyGroupsTab_at_StairSideA

/-! Kernel tables for the hosted groups (LT35); about 5,500 label checks in total. -/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance

/-! ### K6 (replay budget): kernel-fast forms (`cond` / `Nat.ble` / `Nat.beq`) of the label maps and
predicates of the tables, each with a small bridge lemma; the tables are decided on the fast forms. -/

theorem k6_exclusiveRoles_eq : StairSchedule.exclusiveRoles = List.range' 736 40 ++ List.range' 777 4 := by
  decide +kernel

def k6exB (y : Nat) : Bool := Nat.ble 736 y && Nat.blt y 776 || Nat.ble 777 y && Nat.blt y 781

theorem k6_ex_eq (y : Nat) : decide (y ∈ StairSchedule.exclusiveRoles) = k6exB y := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff, k6_exclusiveRoles_eq]
  simp only [k6exB, List.mem_append, List.mem_range'_1, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq,
    Nat.blt_eq]

def k6TPIB (x : Nat) : Bool :=
  Nat.blt x 16 || Nat.ble 17 x && Nat.blt x 527 || Nat.ble 528 x && Nat.blt x 531 || Nat.beq x 733 ||
    Nat.ble 736 x && Nat.blt x 741 || Nat.beq x 784 || Nat.ble 786 x && Nat.blt x 1042 ||
    Nat.ble 1043 x && Nat.blt x 1301 || Nat.beq x 1556 || Nat.ble 1560 x && Nat.blt x 1814 ||
    Nat.ble 2072 x && Nat.blt x 2328 || Nat.ble 2330 x && Nat.blt x 2417 || Nat.beq x 2425

theorem k6_TPI_eq (x : Nat) : decide (TPI x) = k6TPIB x := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  unfold TPI k6TPIB
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq, or_assoc]

def k6GCB (y : Nat) : Bool := !k6exB y && k6TPIB y

theorem k6_GC_eq (y : Nat) : decide (GC y) = k6GCB y := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  unfold GC k6GCB
  simp only [Bool.and_eq_true, Bool.not_eq_true', ← k6_ex_eq, ← k6_TPI_eq, decide_eq_true_eq,
    decide_eq_false_iff_not]

def k6SwIB (z : Nat) : Bool := Nat.ble 786 z && Nat.blt z 1042 || Nat.ble 2072 z && Nat.blt z 2328 || Nat.beq z 2425

theorem k6_SwI_eq (z : Nat) : decide (SwI z) = k6SwIB z := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  unfold SwI k6SwIB
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq, or_assoc]

def k6HalfIB (h : Nat) : Bool :=
  Nat.ble 528 h && Nat.blt h 776 || Nat.ble 777 h && Nat.blt h 781 || Nat.beq h 784 ||
    Nat.ble 786 h && Nat.blt h 1042 || Nat.beq h 1043 || Nat.beq h 1556 || Nat.beq h 1813 ||
    Nat.ble 2072 h && Nat.blt h 2328 || Nat.beq h 2425

theorem k6_HalfI_eq (h : Nat) : decide (HalfI h) = k6HalfIB h := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  unfold HalfI k6HalfIB
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq, or_assoc]

def k6sigB (q : Nat) : Nat :=
  cond ((Nat.ble 1301 q && Nat.ble q 1555) || (Nat.ble 2069 (q + 511) && Nat.ble q 1812)) (3113 - q) q

theorem k6_sig_eq (q : Nat) : OB5.sig 511 q = k6sigB q := by
  unfold OB5.sig k6sigB
  simp only [cond_eq_ite, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]

def k6pi0B (y : Nat) : Nat :=
  cond (Nat.ble 515 y && Nat.ble y 718) (1030 + 5 * ((y - 515) / 2) + 2 * ((y - 515) % 2))
    (cond (Nat.ble 1030 y && (Nat.ble y 1537 &&
        (Nat.beq ((y - 1030) % 5) 0 || Nat.beq ((y - 1030) % 5) 2)))
      (515 + (2 * ((y - 1030) / 5) + (y - 1030) % 5 / 2)) y)

theorem k6_pi0_eq (y : Nat) : Placement5.pi0 y = k6pi0B y := by
  unfold k6pi0B
  simp only [cond_eq_ite, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq]
  by_cases hw : 515 ≤ y ∧ y ≤ 718
  · rw [if_pos hw]
    have hk : y - 515 < 204 := by omega
    have e : Placement5.W (y - 515) = y := by unfold Placement5.W; omega
    have t := Placement5.pi0_W (y - 515) hk
    rw [e] at t
    rw [t]; rfl
  · rw [if_neg hw]
    by_cases hh : 1030 ≤ y ∧ y ≤ 1537 ∧ ((y - 1030) % 5 = 0 ∨ (y - 1030) % 5 = 2)
    · rw [if_pos hh]
      obtain ⟨h1, h2⟩ := Placement5.hole_recover y hh
      have t := Placement5.pi0_H _ h1
      rw [h2] at t
      rw [t]; rfl
    · rw [if_neg hh]
      exact Placement5.pi0_outside y (fun h => h.elim hw hh)

/-- `Placement5.pi j`, kernel-fast. -/
def k6piB (j y : Nat) : Nat :=
  k6pi0B (StairPlaceFast.swB (Placement5.H (2 * j + 1)) (Placement5.H 203)
    (StairPlaceFast.swB (Placement5.H (2 * j)) (Placement5.H 202)
      (StairPlaceFast.swB (Placement5.W (2 * j + 1)) (Placement5.H (2 * j + 1))
        (StairPlaceFast.swB (Placement5.W (2 * j)) (Placement5.H (2 * j)) y))))

theorem k6_pi_eq (j y : Nat) : Placement5.pi j y = k6piB j y := by
  unfold k6piB
  simp only [Placement5.pi, Equiv.trans_apply, StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq,
    ← k6_pi0_eq]

/-- `Mj`, kernel-fast. -/
def k6MjB (j z : Nat) : Nat := k6sigB (cond (Nat.blt z 16) z (k6piB j (z - 16) + 16))

theorem k6_Mj_eq (j z : Nat) : Mj j z = k6MjB j z := by
  unfold Mj k6MjB
  rw [← k6_sig_eq]
  congr 1
  show shiftedFn _ z = _
  unfold shiftedFn
  rw [cond_eq_ite, ← k6_pi_eq]
  simp only [Nat.blt_eq]

/-- `M0`, kernel-fast. -/
def k6M0B (z : Nat) : Nat := k6sigB (cond (Nat.blt z 16) z (k6pi0B (z - 16) + 16))

theorem k6_M0_eq (z : Nat) : M0 z = k6M0B z := by
  unfold M0 k6M0B
  rw [← k6_sig_eq]
  congr 1
  show shiftedFn _ z = _
  unfold shiftedFn
  rw [cond_eq_ite, ← k6_pi0_eq]
  simp only [Nat.blt_eq]

def k6HC0B (h : Nat) : Bool := k6exB h && Nat.beq (k6M0B h) h || k6GCB (k6M0B h)

theorem k6_HC0_eq (h : Nat) : decide (HC0 h) = k6HC0B h := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  unfold HC0 k6HC0B
  rw [← k6_M0_eq]
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, ← k6_ex_eq, ← k6_GC_eq, decide_eq_true_eq]

def k6hpB (j a h : Nat) : Nat :=
  k6MjB j (StairPlaceFast.swB (Rolling1588.packetCarry j) (Rolling1588.g j a)
    (StairPlaceFast.swB (base 719) (Rolling1588.s j 2) h))

theorem k6_halfPlace_eq (j a h : Nat) : halfPlace j a h = k6hpB j a h := by
  unfold halfPlace k6hpB
  rw [StairPlaceFast.swap_eq_sw, StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq,
    ← StairPlaceFast.swB_eq, k6_Mj_eq]

def k6HCB (j a h : Nat) : Bool := k6exB h && Nat.beq (k6hpB j a h) h || k6GCB (k6hpB j a h)

theorem k6_HC_eq (j a h : Nat) : decide (HC j a h) = k6HCB j a h := by
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  unfold HC k6HCB
  rw [← k6_halfPlace_eq]
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, ← k6_ex_eq, ← k6_GC_eq, decide_eq_true_eq]

def k6codeB (j z : Nat) : Nat := cond (Nat.beq (z % 2) 0) (5 * j + z / 2 + 16) (1028 + 5 * j + z / 2 + 16)

theorem k6_code_eq (j z : Nat) (hz : z < 10) :
    MeasuredCodec5.label (History5.historyMap base (5 * j)) z = k6codeB j z := by
  unfold MeasuredCodec5.label k6codeB
  rw [dif_pos hz]
  show base (History5.historyId (5 * j) ⟨z, hz⟩) = _
  unfold History5.historyId base
  simp only [cond_eq_ite, Nat.beq_eq]
  split_ifs <;> rfl

theorem k6_imp {p q : Prop} [Decidable p] [Decidable q] (h : (!decide p || decide q) = true) (hp : p) :
    q := by
  simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, decide_eq_true_eq] at h
  exact h.resolve_left (not_not.mpr hp)

theorem fixedTable : ∀ j ∈ List.range' 1 101, ∀ z ∈ fixedL j, GC (Mj j z) := by
  have hB : (List.range' 1 101).all (fun j => (fixedL j).all (fun z => k6GCB (k6MjB j z))) = true := by
    decide +kernel
  intro j hj z hz
  have t := List.all_eq_true.mp (List.all_eq_true.mp hB j hj) z hz
  rw [← k6_Mj_eq, ← k6_GC_eq] at t
  exact of_decide_eq_true t

theorem swTable : ∀ z ∈ swList, GC (M0 z) := by
  have hB : swList.all (fun z => k6GCB (k6M0B z)) = true := by
    decide +kernel
  intro z hz
  have t := List.all_eq_true.mp hB z hz
  rw [← k6_M0_eq, ← k6_GC_eq] at t
  exact of_decide_eq_true t

theorem swSpecTable : ∀ j ∈ List.range' 1 101, ∀ z ∈ piSpec j, SwI z → GC (Mj j z) := by
  have hB : (List.range' 1 101).all (fun j => (piSpec j).all (fun z =>
      !k6SwIB z || k6GCB (k6MjB j z))) = true := by
    decide +kernel
  intro j hj z hz hs
  have t := List.all_eq_true.mp (List.all_eq_true.mp hB j hj) z hz
  rw [← k6_Mj_eq, ← k6_GC_eq, ← k6_SwI_eq] at t
  exact k6_imp t hs

theorem codeTable : ∀ j ∈ List.range' 1 101, ∀ z ∈ List.range 10,
    GC (Mj j (MeasuredCodec5.label (History5.historyMap base (5 * j)) z)) := by
  have hB : (List.range' 1 101).all (fun j => (List.range 10).all (fun z =>
      k6GCB (k6MjB j (k6codeB j z)))) = true := by
    decide +kernel
  intro j hj z hz
  have t := List.all_eq_true.mp (List.all_eq_true.mp hB j hj) z hz
  rw [← k6_code_eq j z (List.mem_range.mp hz), ← k6_Mj_eq, ← k6_GC_eq] at t
  exact of_decide_eq_true t

theorem halfTable0 : ∀ h ∈ half760L, h ≠ base 719 → HC0 h := by
  have hB : half760L.all (fun h => Nat.beq h 735 || k6HC0B h) = true := by
    decide +kernel
  intro h hh hne
  have t := List.all_eq_true.mp hB h hh
  have e : Nat.beq h 735 = decide (h = base 719) := by
    rw [Bool.eq_iff_iff, Nat.beq_eq, decide_eq_true_iff]; rfl
  rw [← k6_HC0_eq, e] at t
  simp only [Bool.or_eq_true, decide_eq_true_eq] at t
  exact t.resolve_left hne

theorem halfSpecTable : ∀ j ∈ List.range' 1 101, ∀ a ∈ [3, 4], ∀ h ∈ specW j a,
    HalfI h → HC j a h := by
  have hB : (List.range' 1 101).all (fun j => [3, 4].all (fun a => (specW j a).all (fun h =>
      !k6HalfIB h || k6HCB j a h))) = true := by
    decide +kernel
  intro j hj a ha h hh hI
  have t := List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp hB j hj) a ha) h hh
  rw [← k6_HC_eq, ← k6_HalfI_eq] at t
  exact k6_imp t hI

end ECDSAAdd.Entrant.StairSiteEasy

