      refine List.mem_map.mpr ⟨(Shadow7.b0P (start j) - 1 + (t - 1559), 1559 + (t - 1559)), List.mem_append_right _
        (List.mem_map.mpr ⟨t - 1559, List.mem_range.mpr (by omega), rfl⟩), ?_⟩
      show 1559 + (t - 1559) = t
