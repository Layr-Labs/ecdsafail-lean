    have c59 := coldAt 1559 (Or.inr ⟨Nat.le_refl _, by omega⟩)
    have c60 := coldAt 1560 (Or.inr ⟨by omega, by omega⟩)
    have c61 := coldAt 1561 (Or.inr ⟨by omega, by omega⟩)
    have c62 := coldAt 1562 (Or.inr ⟨by omega, Nat.le_refl _⟩)
