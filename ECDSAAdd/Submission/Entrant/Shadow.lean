    unfold InputAt;rw [gg];exact input
  have h := native.1
  have ph := native.2.1
  refine ⟨?_, LeaveJ7.ArchiveCut.result j (by omega) (by omega) (run (nextWindow j d) m s) n (unsigned (start j) x p) G S h⟩
