  have hs := IntegerPacket.metrics (Shadow7.shape j) a n bound
  have mid : (Shadow7.shape j).mid+1=Shadow7.smallBits j+18 := rfl
  rw [mid] at hs
  rw [f,r,(renameProgram_counts _ _).1,(renameProgram_counts _ _).2,(renameProgram_counts _ _).1,
