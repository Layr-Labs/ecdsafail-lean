/-- Everything the first block at 90 (block 1) gives, from the stock stage at 90. -/
theorem first_core (d:Bool) (x p:Nat) (good:Bounds x p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d x p 90 raw.basis) :
    ∃ G S:Bool,
