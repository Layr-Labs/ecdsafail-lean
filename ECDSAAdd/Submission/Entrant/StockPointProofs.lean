      (safe (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val && ((9259550955857215359:Nat).testBit (bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val)) && safe (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse (((:Nat) >>> (10*bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val))%1024))=true ∧
      bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse (((:Nat) >>> (10*bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val))%1024)=out x.val (gen2 b1 a2 yb x.val) := by decide +kernel
  intro b1 a2 s2 yb x h1 h2
  obtain ⟨hy,hs,hb⟩:=res b1 a2 s2 yb x h1 h2
  have t:=k7_core_tab ⟨_,hy⟩
  have e0:decode2 b1 a2 s2 yb=((lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) ++ decodeCore) ++ (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse:=rfl
  have e1:safe (decode2 b1 a2 s2 yb) x.val=(safe (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val && safe decodeCore (bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val) &&
      safe (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse (bitRun decodeCore (bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val))):=by
    rw [e0,Rolling1588.Replay.safe_append ((lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) ++ decodeCore) (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse,Rolling1588.Replay.safe_append (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) decodeCore,
      Rolling1588.Replay.bitRun_append (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) decodeCore]
  have e2:bitRun (decode2 b1 a2 s2 yb) x.val=bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse (bitRun decodeCore (bitRun (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) x.val)):=by
    rw [e0,Rolling1588.Replay.bitRun_append ((lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) ++ decodeCore) (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb).reverse,Rolling1588.Replay.bitRun_append (lit 1 b1 ++ lit 2 s2 ++ (if a2 == s2 then [Instr.CX 1 2] else []) ++ [Instr.CX 2 1] ++ lit 3 yb ++ [Instr.X 5]) decodeCore]
  rw [e1,e2,t.1,t.2]
