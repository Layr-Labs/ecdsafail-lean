 (hl : xs.length = ys.length) (hy : 66 ≤ ys.length) (ht : 131 < T.length)
 (xv : regValue xs st = B) (yv : regValue ys st = A)
 (tv : regValue T st = (A+B)^2) (hv : A+B < 3*2^64)
