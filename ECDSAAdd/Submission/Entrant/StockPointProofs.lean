theorem capture_support (R : KRegs) (w : R.W) (rh : R.h=64) (rb : R.bank.length=129) :
 wires (SumSavedClear.capture R)⊆R.all.toFinset := by
 have qt := allT R _ (R.tq_mem w)
 have qs := allS R _ (saved_mem R w rh rb)
 intro q hq
