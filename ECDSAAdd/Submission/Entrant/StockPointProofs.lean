theorem wrapper_wire530 {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) :
    (4629:Wire) ∈ wires (wrapper2 layout (.some hc) cx cy) := by
  unfold wrapper2
  rw [renameProgram_support]
  apply Finset.mem_image.mpr
