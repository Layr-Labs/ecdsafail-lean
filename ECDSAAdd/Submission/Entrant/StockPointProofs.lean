theorem comparePrefixCached_physical (g a b c cin flag h:Wire) (as bs cs:List Wire) (v:Nat) (ch:c≠h)
    (old:GatePhysical (comparePrefixOld g (a::as) (b::bs) (c::cs) cin flag v)) :
