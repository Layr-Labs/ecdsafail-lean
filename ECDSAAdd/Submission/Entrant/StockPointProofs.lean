    rw [e0,Rolling1588.Replay.safe_append ((lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb ++ [Instr.X 5]) ++ decodeCore) (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb).reverse,Rolling1588.Replay.safe_append (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb ++ [Instr.X 5]) decodeCore,
      Rolling1588.Replay.bitRun_append (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb ++ [Instr.X 5]) decodeCore]
  have e2:bitRun (decode1 a1 a2 b2 yb) x.val=bitRun (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb).reverse (bitRun decodeCore (bitRun (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb ++ [Instr.X 5]) x.val)):=by
    rw [e0,Rolling1588.Replay.bitRun_append ((lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb ++ [Instr.X 5]) ++ decodeCore) (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb).reverse,Rolling1588.Replay.bitRun_append (lit 1 a1 ++ lit 2 b2 ++ (if a2 == b2 then [Instr.CX 1 2] else []) ++ lit 3 yb ++ [Instr.X 5]) decodeCore]
  rw [e1,e2,t.1,t.2]
