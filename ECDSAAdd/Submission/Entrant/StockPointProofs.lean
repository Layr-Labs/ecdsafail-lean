    wires (ECDSAAdd.Entrant.clrF L) ∪ L.point.y.toFinset :=
  (CodexYParityGadget.clearProgram_support (xs L) (b L) L.point.finite (rest L) (work L) literal).trans
    (clrF_support_old L hw)

