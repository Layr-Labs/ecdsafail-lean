    (L.recoveryConstant_widths hw L.point.y hw.inputY)
    (L.recoveryConstant_nodup hw hn L.point.y (Or.inr rfl)) hy hk s m hY sz
    (aux _ (by simp [K])) (aux _ (by simp [K])) (aux _ (by simp [K]))
