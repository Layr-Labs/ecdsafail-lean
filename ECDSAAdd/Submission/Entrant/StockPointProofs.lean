theorem program_subset(K:ControlledPointLayout)(A C:Program):
 wires (B95SquareResearch.program K A C)⊆wires (C163Low4Square.program K A C):=by
 have h:=B95PortResearch.branch_old_subset K.dialogStreamedSquareWide (OwnDiagAll12Square.kext K) K.core.generic
