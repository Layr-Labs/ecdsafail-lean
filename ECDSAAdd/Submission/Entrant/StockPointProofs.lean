theorem eval_append (mask : Nat) (P Q : Program) (cs : Cols) :
 eval mask (P++Q) cs =
 let a:=eval mask P cs
 let b:=eval mask Q a.2
 (a.1 && b.1,b.2) := by
 induction P generalizing cs with
 | nil => rfl
 | cons i P ih =>
  simp only [List.cons_append,eval,_root_.ECDSAAdd.Entrant.CodecBitSliceVerify.eval,ih]
  simp only [Bool.and_assoc]

def lastCols (cs : Cols) : List Cols → Cols
 | [] => cs
 | t::ts => lastCols t ts

def checkTrace (mask : Nat) : List Program → List Cols → Bool
 | [],[_] => true
 | P::Ps,b::c::cs => decide (eval mask P b=(true,c)) && checkTrace mask Ps (c::cs)
 | _,_ => false

theorem trace_sound (mask : Nat) (Ps : List Program) (cs : Cols) (rs : List Cols)
 (h : checkTrace mask Ps (cs::rs)=true) :
 eval mask Ps.flatten cs=(true,lastCols cs rs) := by
 induction Ps generalizing cs rs with
 | nil =>
  cases rs with
  | nil => rfl
  | cons c ts => simp [checkTrace] at h
 | cons P Ps ih =>
  cases rs with
  | nil => simp [checkTrace] at h
  | cons c ts =>
   have hh : eval mask P cs=(true,c) ∧ checkTrace mask Ps (c::ts)=true := by
    simpa only [checkTrace,Bool.and_eq_true,decide_eq_true_eq] using h
   rw [List.flatten_cons,eval_append,hh.1]
   simpa only [Bool.true_and,lastCols] using ih c ts hh.2


end ECDSAAdd.Entrant.TerminalBitSlice104

