theorem reg_bit_xor (b c : Bool) (v : Nat) :
 (b ^^ c).toNat+2*v=(b.toNat+2*v) ^^^ (if c then 1 else 0) := by
 cases b <;> cases c
 · simp
 · simp only [Bool.false_xor,Bool.toNat_true,Bool.toNat_false,ite_true,Nat.zero_add]
   rw [Nat.xor_one_of_even (show Even (2*v) from ⟨v,by omega⟩)]
   omega
 · simp
 · simp only [Bool.true_xor,Bool.not_true,Bool.toNat_false,Bool.toNat_true,ite_true,Nat.zero_add]
   rw [Nat.xor_one_of_odd (show Odd (1+2*v) from ⟨v,by omega⟩)]
   omega

theorem fan_reg (xs : List Wire) (head : Wire) (tail : List Wire)
 (hh : head∉xs) (ht : head∉tail) (s : State) (m : List Bool) :
 regValue (head::tail) (run (fan xs head) m s).basis =
 regValue (head::tail) s.basis ^^^ (if parity xs s.basis then 1 else 0) := by
 rw [fan_correct xs head hh]
 rw [CodexKnownOnesTail.Helpers.regValue_cons',CodexKnownOnesTail.Helpers.regValue_cons']
 have eq : regValue tail (writeBit s.basis head (s.basis head ^^ parity xs s.basis))=regValue tail s.basis := by
  apply regValue_congr
  intro q hq
  simp [writeBit,show q≠head from fun h=>ht (h ▸ hq)]
 rw [eq]
 simp only [writeBit,Function.update_self]
 exact reg_bit_xor _ _ _


theorem read_bit (S : List Wire) (s : BasisState) (i : Nat) (hi : i<S.length) :
    (regValue S s).testBit i=s (S.getD i 0) := by
  induction S generalizing i with
  | nil => simp at hi
  | cons a as ih =>
    cases i with
    | zero =>
      cases h : s a <;> simp [regValue,h,Nat.testBit_eq_decide_div_mod_eq,Nat.add_mod]
    | succ i =>
      have bit : (s a).toNat<2 := by cases s a <;> decide
      have dv : regValue (a::as) s/2=regValue as s := by
        simp only [regValue,List.foldr_cons]
        cases s a <;> simp only [Bool.true_eq,Bool.false_eq_true,if_true,if_false] <;> omega
      rw [Nat.testBit_succ,dv,ih i (by simpa using hi)]
      rfl

open Baselines
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 10000000
def positions : List Nat := [215, 216, 217, 224, 225, 227, 232, 235, 238, 239, 240, 241, 244, 245, 246, 247, 250, 251]
def numericParity (x : Nat) : Bool := positions.foldl (fun b i => b ^^ x.testBit i) false

def xHead : Wire := layout.point.x.getD 215 0
def xTail : List Wire := positions.tail.map (fun i=>layout.point.x.getD i 0)
def yPrefix : List Wire := (layout.point.y.drop 10).take 22++(layout.point.y.drop 33).take 223
def markerPrefix : List Wire := xHead::yPrefix

theorem head_off_tail : xHead∉xTail := by decide +kernel
theorem head_off_y : xHead∉yPrefix := by decide +kernel

theorem parity_read (s : BasisState) : (s xHead ^^ parity xTail s)=numericParity (regValue layout.point.x s) := by
  have rd (i : Nat) (hi : i<256) : (regValue layout.point.x s).testBit i=s (layout.point.x.getD i 0) :=
    read_bit layout.point.x s i (by change i<256;exact hi)
  simp only [numericParity,positions,List.foldl_cons,List.foldl_nil,Bool.false_xor]
  rw [rd 215 (by omega),rd 216 (by omega),rd 217 (by omega),rd 224 (by omega),
    rd 225 (by omega),rd 227 (by omega),rd 232 (by omega),rd 235 (by omega),
    rd 238 (by omega),rd 239 (by omega),rd 240 (by omega),rd 241 (by omega),
    rd 244 (by omega),rd 245 (by omega),rd 246 (by omega),rd 247 (by omega),
    rd 250 (by omega),rd 251 (by omega)]
  simp only [xHead,xTail,positions,List.tail_cons,List.map_cons,List.map_nil,EntryRetained5.Affine.parity,Bool.xor_false]
  simp only [Bool.xor_assoc]

#print axioms parity_read


def high (y : Nat) : Nat := y/1024%4194304+4194304*(y/8589934592%13479973333575319897333507543509815336818572211270286240551805124608)
def project (X Y : Nat) : Nat := (numericParity X).toNat+2*high Y

theorem y_read (s : BasisState) : regValue yPrefix s=high (regValue layout.point.y s) := by
  rw [yPrefix,regValue_append,
    CuccaroStreamedSquareWideLayout.regValue_take_mod (layout.point.y.drop 10) 22 (by decide +kernel),
    CuccaroStreamedSquareWideLayout.regValue_take_mod (layout.point.y.drop 33) 223 (by decide +kernel),
    CuccaroStreamedSquareWideLayout.regValue_drop_div layout.point.y 10 (by decide +kernel),
    CuccaroStreamedSquareWideLayout.regValue_drop_div layout.point.y 33 (by decide +kernel)]
  have len : ((layout.point.y.drop 10).take 22).length=22 := by decide +kernel
  rw [len]
  rfl

def linear : Program := fan xTail xHead
def linearMask (s : BasisState) : Nat := if parity xTail s then 1 else 0

theorem linear_correct (s : State) (m : List Bool) :
 (run linear m s).phase=s.phase ∧
 (∀q,q∉markerPrefix→(run linear m s).basis q=s.basis q) ∧
 regValue markerPrefix (run linear m s).basis=regValue markerPrefix s.basis ^^^ linearMask s.basis := by
  have eq := fan_correct xTail xHead head_off_tail s m
  refine ⟨by rw [linear,eq],?_,?_⟩
  · intro q hq
    have ne : q≠xHead := by intro h;subst q;exact hq (by simp [markerPrefix])
    rw [linear,eq]
    simp [writeBit,ne]
  · exact fan_reg xTail xHead yPrefix head_off_tail head_off_y s m

theorem project_read (s : BasisState) :
 regValue markerPrefix s ^^^ linearMask s=project (regValue layout.point.x s) (regValue layout.point.y s) := by
  rw [markerPrefix,CodexKnownOnesTail.Helpers.regValue_cons',y_read]
  unfold linearMask
  rw [←reg_bit_xor]
  rw [parity_read]
  rfl

def prep : Program := linear++xorConstant markerPrefix 113078212145816597093331040047546785012958969400039613319782796882727665662

theorem linear_M : measurementCount linear=0 := (fan_counts xTail xHead).2

theorem prefix_nd : markerPrefix.Nodup := by decide +kernel

theorem prep_correct (s : State) (m : List Bool) :
 (run prep m s).phase=s.phase ∧
 (∀q,q∉markerPrefix→(run prep m s).basis q=s.basis q) ∧
 regValue markerPrefix (run prep m s).basis=(regValue markerPrefix s.basis ^^^ linearMask s.basis) ^^^ 113078212145816597093331040047546785012958969400039613319782796882727665662 := by
  let a:=run linear [] s
  have l:=linear_correct s []
  have x:=xorConstant_correct markerPrefix prefix_nd 113078212145816597093331040047546785012958969400039613319782796882727665662
    (by decide +kernel) a m
  rw [prep,run_append]
  simp only [linear_M,List.take_zero,List.drop_zero]
  change (run (xorConstant markerPrefix 113078212145816597093331040047546785012958969400039613319782796882727665662) m a).phase=s.phase ∧ _ ∧ _
  exact ⟨x.1.trans l.1,fun q hq=>(x.2.1 q hq).trans (l.2.1 q hq),by rw [x.2.2,l.2.2]⟩

theorem prep_project (s : State) (m : List Bool) :
 regValue markerPrefix (run prep m s).basis=project (regValue layout.point.x s.basis) (regValue layout.point.y s.basis) ^^^ 113078212145816597093331040047546785012958969400039613319782796882727665662 := by
 rw [(prep_correct s m).2.2,project_read]

