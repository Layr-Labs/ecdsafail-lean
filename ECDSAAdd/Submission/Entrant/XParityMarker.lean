import ECDSAAdd.Submission.Entrant.QTop
open ECDSAAdd ECDSAAdd.Secp256k1
namespace ECDSAAdd.Entrant.XParityMarker
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
def positions : List Nat := [215, 216, 217, 224, 225, 227, 232, 235, 238, 239, 240, 241, 244, 245, 246, 247, 250, 251]
def parity (x : Nat) : Bool := positions.foldl (fun b i => b ^^ x.testBit i) false
theorem curve_cube {x y : Fp} (hc : curve.toAffine.Nonsingular x y) : x^3=y^2-7 := by
  have he:=hc.1
  rw [curve.toAffine.equation_iff] at he
  simp [curve,curveA,curveB] at he
  linear_combination -he

theorem criterion {x y : Fp} (hc : curve.toAffine.Nonsingular x y) : (y^2-7)^(p/3)=1 := by
  have hx:=curve_cube hc
  haveI : Fact (Nat.Prime p) := ⟨p_prime⟩
  have ferm : x^(p-1)=1 := ZMod.pow_card_sub_one_eq_one (ECDSAAdd.Entrant.x_ne_zero hc)
  have hp : 3*(p/3)=p-1 := by norm_num [p]
  rw [←hx,←pow_mul,hp,ferm]

