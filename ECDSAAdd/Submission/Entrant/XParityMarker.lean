def marker (X Y : Nat) : Bool := decide (high Y=56539106072908298546665520023773392506479484700019806659891398441363832831) && !parity X

theorem free (x y : Fp) (hc : curve.toAffine.Nonsingular x y) : marker x.val y.val=false := by
  unfold marker
  by_cases h : high y.val=56539106072908298546665520023773392506479484700019806659891398441363832831
  · have hy : y.val<115792089237316195423570985008687907853269984665640564039457584007908834671663 := ZMod.val_lt y
    have lo := high_low y.val hy h
    let j : Fin 47 := ⟨y.val-115792089237316195423570985008687907853269984665640564039457584007908834671616,by omega⟩
    have ey : ((115792089237316195423570985008687907853269984665640564039457584007908834671616+j.val:Nat):Fp)=y := by
      have e : 115792089237316195423570985008687907853269984665640564039457584007908834671616+j.val=y.val := by dsimp [j];omega
      rw [e];exact ZMod.natCast_zmod_val y
    have hb := bucket j x (ey ▸ hc)
    simp only [h,decide_true,Bool.true_and,hb,Bool.not_true]
  · simp only [h,decide_false,Bool.false_and]

