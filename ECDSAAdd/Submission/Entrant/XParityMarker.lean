def high (y : Nat) : Nat := y/1024%4194304+4194304*(y/8589934592%13479973333575319897333507543509815336818572211270286240551805124608)
theorem high_low (y : Nat) (hy : y<115792089237316195423570985008687907853269984665640564039457584007908834671663) (h : high y=56539106072908298546665520023773392506479484700019806659891398441363832831) : 115792089237316195423570985008687907853269984665640564039457584007908834671616≤y := by
