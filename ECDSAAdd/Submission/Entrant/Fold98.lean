theorem take8 {α : Type} (b0 b1 b2 b3 b4 b5 b6 b7 r : List α) (h0 : b0.length = 128) (h1 : b1.length = 128)
    (h2 : b2.length = 128) (h3 : b3.length = 128) (h4 : b4.length = 128) (h5 : b5.length = 128)
    (h6 : b6.length = 128) (h7 : b7.length = 128) :
    List.take 1024 (b0 ++ (b1 ++ (b2 ++ (b3 ++ (b4 ++ (b5 ++ (b6 ++ (b7 ++ r)))))))) =
      b0 ++ (b1 ++ (b2 ++ (b3 ++ (b4 ++ (b5 ++ (b6 ++ b7)))))) := by
  simp [List.take_append, List.take_of_length_le, h0, h1, h2, h3, h4, h5, h6, h7]

theorem drop8 {α : Type} (b0 b1 b2 b3 b4 b5 b6 b7 r : List α) (h0 : b0.length = 128) (h1 : b1.length = 128)
    (h2 : b2.length = 128) (h3 : b3.length = 128) (h4 : b4.length = 128) (h5 : b5.length = 128)
    (h6 : b6.length = 128) (h7 : b7.length = 128) :
    List.drop 1024 (b0 ++ (b1 ++ (b2 ++ (b3 ++ (b4 ++ (b5 ++ (b6 ++ (b7 ++ r)))))))) = r := by
  simp [List.drop_append, List.drop_eq_nil_of_le, h0, h1, h2, h3, h4, h5, h6, h7]

theorem step' (Q : List Wire) (n : Nat) (p X R o1 o2 : Program) (hlen : ¬ p.length ≤ 1024)
    (hX : p.take 1024 = X) (hR : p.drop 1024 = R)
    (h1 : (ZeroSetDevelop.compileFuelS Q (1024+1) X).map (fun cm => cm.out) = some o1)
    (h2 : (ZeroSetDevelop.chunkFuelS Q n R).map (fun cm => cm.out) = some o2) :
    (ZeroSetDevelop.chunkFuelS Q (n+1) p).map (fun cm => cm.out) = some (o1 ++ o2) := by
  subst hX hR
  exact PeakChunkS.step Q n p o1 o2 hlen h1 h2

