private def mask : List Wire → Nat
  | [] => 0
  | w :: ws => 2 ^ w ||| mask ws

private theorem memMask (ws : List Wire) (u : Wire) : (mask ws).testBit u = true ↔ u ∈ ws := by
  induction ws with
  | nil => simp [mask]
  | cons w ws ih =>
    simp only [mask, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq,
      ih, List.mem_cons]
    exact or_congr eq_comm Iff.rfl

private theorem covered {a b : List Wire} (h : mask a &&& mask b = mask a) (u : Wire)
    (hu : u ∈ a) : u ∈ b := by
  have hai := (memMask a u).mpr hu
  have both := congrArg (fun v : Nat => v.testBit u) h
  change (mask a &&& mask b).testBit u = (mask a).testBit u at both
  rw [Nat.testBit_and, hai, Bool.true_and] at both
  exact (memMask b u).mp both

theorem known_sites_checked : ((sites knownRanges).all (fun u => known.contains u)) = true := by
  have check : mask (sites knownRanges) &&& mask known = mask (sites knownRanges) := by decide +kernel
  exact List.all_eq_true.mpr (fun u hu => List.contains_iff_mem.mpr (covered check u hu))

