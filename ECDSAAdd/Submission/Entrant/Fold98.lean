  have hH : H<2^130 := by have h:=regValue_lt src base;rw [hsrc] at h;exact h
  have old:=Acc.op_prefix_triple acc Z bank cin 163 141 f hacc (by decide) hf
    (by simp [f,Acc.earlyTerm,hsrc]) base hz hb hi false (976*H)
