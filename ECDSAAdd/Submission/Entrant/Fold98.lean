section
namespace ECDSAAdd.Entrant.C163Low4Middle
open Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout
set_option autoImplicit false

set_option maxRecDepth 100000
set_option maxHeartbeats 100000000
attribute [local irreducible] specialChecked

theorem special_free : q∉wires specialChecked.out ∧ r∉wires specialChecked.out := by
 have off:=(special_cert.support [q,r] middle specialChecked.out).2
 exact ⟨off q (by simp),off r (by simp)⟩

theorem special_run (s:State) (m:List Bool) (hq:s.basis q=false) (hr:s.basis r=false) :
 run specialChecked.out m s=run middle m s := by
 apply special_cert.run_eq
 intro u hu
 simp only [List.mem_cons,List.not_mem_nil,or_false] at hu
 rcases hu with rfl|rfl
 · exact hq
 · exact hr

/-- replay relief (odd-word): both ZeroSet compiles on `owCompile`. -/
theorem bank_fast : (ZeroSetDevelop.owCompile (ZeroSetDevelop.owMask [q,r]) literal).elim false
    (fun o => (ZeroSetDevelop.owCompile (ZeroSetDevelop.owMask hs) o).elim false
      (fun o2 => ParkAProgramBool.programEq ECDSAAdd.Entrant.KnownCMidStaged.literal o2)) = true := by
 decide +kernel

theorem bank_match : (ZeroSetDevelop.compileS? hs specialChecked.out).elim false
    (fun c => ParkAProgramBool.programEq ECDSAAdd.Entrant.KnownCMidStaged.literal c.out) = true := by
 have h := bank_fast
 rw [specialChecked_fast, Option.elim_some] at h
 -- syntactic match for the kernel (a `simpa` here made it evaluate the compile: +48 s)
 exact ZeroSetDevelop.owElim_of_fast hs specialChecked.out
  (fun o2 => ParkAProgramBool.programEq ECDSAAdd.Entrant.KnownCMidStaged.literal o2) h

theorem compiled_bank : (ZeroSetDevelop.compileS? hs specialChecked.out).isSome=true :=
 ECDSAAdd.Entrant.D1Opt.isSome_of_elim bank_match

def bankChecked : ZeroSetDevelop.CheckedS hs specialChecked.out :=
 (ZeroSetDevelop.compileS? hs specialChecked.out).get compiled_bank
attribute [local irreducible] bankChecked

theorem bank_cert : ZeroSetDevelop.SRewrites hs specialChecked.out bankChecked.out := bankChecked.proof

end ECDSAAdd.Entrant.C163Low4Middle

