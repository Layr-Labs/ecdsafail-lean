theorem ty_take (L : CuccaroStreamedSquareWideLayout) (src : List Wire) (neg : Bool) (w n : Nat) (hn : 4≤n) :
 Acc.ty ((ghostAcc L).take w) (Acc.earlyTerm src neg n)=Acc.ty ((accReg L).take w) (Acc.earlyTerm src neg n) := by
