/-- replay relief (odd-word): `touched` by one wire bit-mask pass, the whole ambient list in one decide. -/
theorem owTouchedMask (P : Program) (q : Wire) : touched P q = (FourthASavedCarryDevelop.owWireMask P).testBit q := by
  rw [← FourthASavedCarryDevelop.owHasWire]
  apply Bool.eq_iff_iff.mpr
  rw [touched_spec, FourthASavedCarryDevelop.hasWire_iff]

def owCoverFast (m sd : Nat) (u : Wire) : Bool := u==d || sd.testBit u || m.testBit u

theorem owCoverEq : cover = owCoverFast (FourthASavedCarryDevelop.owWireMask witnessProgram)
    (ZeroSetDevelop.owMask (FullPadSupport.supportDomain L)) := by
  funext u
  simp only [cover, owCoverFast, owTouchedMask, ZeroSetDevelop.owMask_testBit]
  simp

