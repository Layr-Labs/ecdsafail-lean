 rw [h.2.2]
 cases s.basis g
 · simp
 · simp only [if_true]
   rw [Nat.xor_comm]
   exact C163Low4Math.mask_xor_multiple _ (by simpa only [hlen] using regValue_lt r s.basis) hz
#print axioms flip_run
end ECDSAAdd.Entrant.C163Low4Facts
