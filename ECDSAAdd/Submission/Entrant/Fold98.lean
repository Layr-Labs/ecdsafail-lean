theorem compiled_specials:(ZeroSetDevelop.compileS? [q,r] literal).isSome=true:=by
 have h := compiled_specials_fast
 rw [ZeroSetDevelop.owCompile_eq [q,r] _ (ZeroSetDevelop.owMask_testBit _)] at h
