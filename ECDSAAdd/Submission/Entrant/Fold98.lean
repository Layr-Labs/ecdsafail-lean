    dsimp only [v1,v,u1,u,m3,m2,m1,mc,mb,mk]
    simp only [(maskedConstant_counts _ _ _).2,List.take_zero,List.drop_zero,Nat.add_zero,List.take_take,Nat.min_self,List.drop_take,Nat.sub_self]
