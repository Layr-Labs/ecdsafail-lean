theorem hiReg_product (L:CuccaroStreamedSquareWideLayout) (q:Wire) (hq:q∈hiReg L) : q∈L.core.product :=
 src_in L q hq
theorem accReg_work (L:CuccaroStreamedSquareWideLayout) (q:Wire) (hq:q∈accReg L) : q∈L.core.work :=
