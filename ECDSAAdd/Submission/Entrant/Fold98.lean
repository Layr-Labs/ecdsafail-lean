  | nil=>exact old
  | cons a xs=>
   cases xs with
   | nil=>exact old
   | cons a' xs=>
    cases ys with
    | nil=>exact old
    | cons b ys=>
     cases ys with
     | nil=>exact old
     | cons b' ys=>
      cases cs with
      | nil=>exact old
      | cons c cs=>
       simp only [addInPlace,gatePhysical_append] at old
       have sub:∀q∈witnesses ps,q∈witnesses (p::ps):=by
        intro q hq
        cases p with
        | none=>exact hq
        | some qs=>exact List.mem_append_right qs hq
       have hp:GatePhysical (head p a b cin c):=by
        cases p with
        | none=>exact old.1.1.1
