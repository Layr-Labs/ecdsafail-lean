    (owCoverFast (FourthASavedCarryDevelop.owWireMask witnessProgram)
      (ZeroSetDevelop.owMask (FullPadSupport.supportDomain L))) = true := by
  decide +kernel

theorem owAll : (A161GenericFold.ambient L g hs96).all cover = true := by
  rw [owCoverEq]
  exact owAllFast

