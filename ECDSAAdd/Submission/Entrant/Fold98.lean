   have same : b 4371=b 4372 := by
    cases hU:b 4371 <;> cases hV:b 4372 <;> simp [hU,hV] at both ⊢
   unfold LocalEFoldOptimize.Top
   rw [same]
   cases hv0:b 4372 <;> simp [c]

