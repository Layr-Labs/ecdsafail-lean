  have check : mask (sites copyRanges) &&& mask (src ++ dst) = mask (sites copyRanges) := by decide +kernel
  have len : src.length = dst.length := by decide +kernel
  have used : src.isEmpty = false := by decide +kernel
  refine List.all_eq_true.mpr (fun u hu => (C163Touch.touched_spec _ _).mpr ?_)
  change u ∈ wires (copyRegister none src dst)
  rw [copyRegister_wires _ _ _ len, used]
  exact List.mem_toFinset.mpr (covered check u hu)

