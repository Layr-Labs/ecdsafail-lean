theorem prefix_avoids (isA : Bool) : ∀ n, n ≤ 505 → ∀ q ∈ sites, q ∉ wires (encodePrefix base isA n) := by
  intro n hn q hq hw
  rw [prefix_support_eq] at hw
  induction n with
