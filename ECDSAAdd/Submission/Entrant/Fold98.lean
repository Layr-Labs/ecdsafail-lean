 List.mem_of_mem_take hq

def build (L:CuccaroStreamedSquareWideLayout) : Program :=
 C163NarrowAcc.build8 (acc L) (pad L) (bank L) L.core.cin (src L)
def clear (L:CuccaroStreamedSquareWideLayout) : Program :=
