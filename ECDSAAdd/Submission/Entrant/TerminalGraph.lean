  have h := Affine.add_counts ((sources L).drop 4) (L.r.drop 4) ((L.carry.take 255).drop 4) (cAt L 3)
    (by simp [sources_length,len.2.1]) (by simp [List.length_take,hw.2.2,len.2.1])
