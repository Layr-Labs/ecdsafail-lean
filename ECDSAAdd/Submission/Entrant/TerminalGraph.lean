theorem h_ne_a (L : DecoderLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (i : Nat) (hi : i<255) : L.h≠L.A i := by
  intro e
  exact carry_source_away L hn L.h (Or.inr (Or.inr (Or.inl rfl))) (e ▸ a_mem L hw i hi)

                                                                                 
                                                                        
                                                                               
                                                                                       
                                                               
                                                                                
                                                                  
                
                                                                                                   
                                                                                            
                                                                                    
                       
                                          
                                                                                                     
                                                        
                                                                                         
                                                 
                                                                 
           
                                                                        
                                                                                  
                                                                       
                                                                                     
                                                                        
     

