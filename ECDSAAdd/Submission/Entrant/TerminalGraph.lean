theorem r_ne_a (L : DecoderLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (j i : Nat) (hj : j<256) (hi : i<255) : L.R j≠L.A i := by
  intro e
  exact source_r_away L hn (L.A i) (Or.inr (Or.inl (a_mem L hw i hi)))
