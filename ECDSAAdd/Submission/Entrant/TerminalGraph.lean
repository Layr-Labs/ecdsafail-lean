    rw [←run_disjoint_commute clear oldUpper (apartFor oldUpper oldSupport) ms n u,
      clearKeeps _ topCopy (bAway _ (by simp)) ms,
      clearKeeps _ topTarget (bAway _ (by simp)) ms]
    exact postU
