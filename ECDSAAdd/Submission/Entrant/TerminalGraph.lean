theorem jointH_counts (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (J G : Wire) (hJ : J∉L.wires) (hG : G∉L.wires) :
    toffoliCount (jointH L J G)=518 ∧ measurementCount (jointH L J G)=773 := by
