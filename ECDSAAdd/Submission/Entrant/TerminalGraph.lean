theorem programH_counts (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (J B : Wire) (hJ : J∉L.wires) (hB : B∉L.wires) :
    toffoliCount (programH L J B)=518 ∧ measurementCount (programH L J B)=773 := by
