def recsUpTo : Nat → List (List Bool)
  | 0 => [[]]
  | n+1 => [] :: ((recsUpTo n).map (false :: ·) ++ (recsUpTo n).map (true :: ·))

theorem take_recsUpTo (n : Nat) (m : List Bool) : m.take n ∈ recsUpTo n := by
  induction n generalizing m with
  | zero => simp [recsUpTo]
  | succ n ih =>
    rcases m with _ | ⟨b, m⟩
    · simp [recsUpTo]
    · have h := ih m
