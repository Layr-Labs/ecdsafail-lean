    measurementCount (W.repairedTick base 509)+measurementCount (W.repairedTick base 510) := by
  obtain ⟨_,c2,_,c4,_,_,_,_⟩ := tickM_counts
  rw [tick509ExF_explicit,tick510ExF_explicit,←measurementCount_append,c2,c4]







