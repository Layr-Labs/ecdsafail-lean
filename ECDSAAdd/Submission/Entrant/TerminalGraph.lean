private theorem pad_counts : toffoliCount [Instr.measureX (base 1027) [] []]=0 ∧
    measurementCount [Instr.measureX (base 1027) [] []]=1 ∧
    gateSlots [Instr.measureX (base 1027) [] []]=1 := ⟨rfl,rfl,rfl⟩

