theorem sites509_sub : ∀ q ∈ [1553], q ∈ wires (W.compactSkywalkTick base 509) := by
  decide +kernel
theorem sites510_sub : ∀ q ∈ [1554], q ∈ wires (W.compactSkywalkTick base 510) := by
