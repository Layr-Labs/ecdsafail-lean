theorem regValue_map2 {α : Type} (f g : α → Wire) (s t : BasisState) :
    ∀ L : List α, (∀ k ∈ L, s (f k) = t (g k)) →
      regValue (L.map f) s = regValue (L.map g) t
  | [], _ => rfl
  | k :: L, h => by
      have ih := regValue_map2 f g s t L (fun k' hk' => h k' (List.mem_cons_of_mem _ hk'))
      have h0 := h k (List.mem_cons.mpr (Or.inl rfl))
      show (if s (f k) then 1 else 0) + 2 * regValue (L.map f) s =
        (if t (g k) then 1 else 0) + 2 * regValue (L.map g) t
      rw [ih, h0]

theorem signedRegValue_map2 {α : Type} (f g : α → Wire) (s t : BasisState) (L : List α)
    (h : ∀ k ∈ L, s (f k) = t (g k)) :
    signedRegValue (L.map f) s = signedRegValue (L.map g) t := by
  unfold signedRegValue
  rw [regValue_map2 f g s t L h, List.length_map, List.length_map]

theorem signedRegValue_mapW (g : Wire → Wire) (s t : BasisState) (L : List Wire)
    (h : ∀ q ∈ L, s q = t (g q)) :
    signedRegValue L s = signedRegValue (L.map g) t := by
  have e := signedRegValue_map2 (fun q : Wire => q) g s t L h
  rwa [List.map_id'] at e

/-- Every raw letter pair of the walk of `x` is a legal trit. -/
theorem code_legal (x j : Nat) :
    ((SkywalkTrace.code (SkywalkTrace.next^[j]
        (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).1 &&
      (SkywalkTrace.code (SkywalkTrace.next^[j]
        (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).2) = false := by
  obtain ⟨hp0, hodd, -⟩ := p_facts
  obtain ⟨G, S, henc⟩ := SkywalkTrace.iter_encoded j false false (SkywalkNat.init x ECDSAAdd.p)
    hp0 hodd
  have valid := SkywalkNat.iter_valid j (SkywalkNat.init x ECDSAAdd.p) hp0 hodd
  have henc' : SkywalkTrace.next^[j]
      (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)) =
      SkywalkRails.encode G S ((SkywalkNat.step^[j] (SkywalkNat.init x ECDSAAdd.p)).u : Int)
        ((SkywalkNat.step^[j] (SkywalkNat.init x ECDSAAdd.p)).v : Int) := henc
  rw [henc']
  exact SkywalkRails.ternary_history G S _ _ (by omega) (by omega)
    (by exact_mod_cast valid.2.1)

/-- The raw record stage holds the transcript letters on every completed packet. -/
theorem raw_packet_base (x : Nat) (origin : BasisState) (hx : TraceOK x origin)
    (raw : BasisState) (e : Nat)
    (fpast : ∀ j, j < e → raw (base j) =
        (SkywalkTrace.code (SkywalkTrace.next^[j]
          (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).1 ∧
      raw (base (1028 + j)) =
        (SkywalkTrace.code (SkywalkTrace.next^[j]
          (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)))).2)
    (k : Nat) (hk : 5 * k + 5 ≤ e) (he : e ≤ 512) (r : Fin 10) :
    raw (History5.historyMap base (5 * k) r) = origin (History5.historyMap base (5 * k) r) := by
  have hr := r.isLt
  unfold History5.historyMap History5.historyId
  by_cases hc : r.val % 2 = 0
  · simp only [hc, ↓reduceIte]
    obtain ⟨o1, -⟩ := StairField2V3Trace.origin_letters x origin hx (5 * k + r.val / 2) (by omega)
    rw [(fpast (5 * k + r.val / 2) (by omega)).1, o1]
  · simp only [hc, ↓reduceIte]
    obtain ⟨-, o2⟩ := StairField2V3Trace.origin_letters x origin hx (5 * k + r.val / 2) (by omega)
    rw [show 1028 + 5 * k + r.val / 2 = 1028 + (5 * k + r.val / 2) by omega,
      (fpast (5 * k + r.val / 2) (by omega)).2, o2]

