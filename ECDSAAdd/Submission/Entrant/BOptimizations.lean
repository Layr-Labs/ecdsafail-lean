def dmOK (j i : Nat) : Bool :=
  i == j || Baselines.layout.skywalkDirectMap i != Baselines.layout.skywalkDirectMap j

/-- KX2: `pwN` (the closed form of `pointIndexWire`) is injective on the shared labels. -/
theorem pwN_inj (i j : Nat) (hi : i < 2314) (hj : j < 2314)
    (h : StairPlaceFast.pwN i = StairPlaceFast.pwN j) : i = j := by
  unfold StairPlaceFast.pwN at h
  rw [if_pos hi, if_pos hj] at h
  split_ifs at h <;> omega

theorem sdm_eq (i : Nat) (hi : i < 2314) :
    Baselines.layout.skywalkDirectMap i = StairPlaceFast.pwN i := by
  rw [← StairPlaceFast.pointIndexWire_eqN, pointIndexWire_shared _ _ hi]

/-- KX2: every slice of the direct-map check, without evaluating the layout. -/
theorem dmOK_all (j : Nat) (hj : j < 2314) (a n : Nat) (h : a + n ≤ 2314) :
    (List.range' a n).all (dmOK j) = true := by
  rw [List.all_eq_true]
  intro i hm
  have hi := List.mem_range'_1.mp hm
  unfold dmOK
  simp only [Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq]
  by_cases e : i = j
  · exact Or.inl e
  · refine Or.inr fun h' => e (pwN_inj i j (by omega) hj ?_)
    rw [← sdm_eq i (by omega), ← sdm_eq j hj]
    exact h'

theorem dm717_0 : (List.range' 0 400).all (dmOK 717) = true :=
  dmOK_all 717 (by omega) 0 400 (by omega)
theorem dm717_1 : (List.range' 400 400).all (dmOK 717) = true :=
  dmOK_all 717 (by omega) 400 400 (by omega)
theorem dm717_2 : (List.range' 800 400).all (dmOK 717) = true :=
  dmOK_all 717 (by omega) 800 400 (by omega)
theorem dm717_3 : (List.range' 1200 400).all (dmOK 717) = true :=
  dmOK_all 717 (by omega) 1200 400 (by omega)
theorem dm717_4 : (List.range' 1600 400).all (dmOK 717) = true :=
  dmOK_all 717 (by omega) 1600 400 (by omega)
theorem dm717_5 : (List.range' 2000 314).all (dmOK 717) = true :=
  dmOK_all 717 (by omega) 2000 314 (by omega)
theorem dm720_0 : (List.range' 0 400).all (dmOK 720) = true :=
  dmOK_all 720 (by omega) 0 400 (by omega)
theorem dm720_1 : (List.range' 400 400).all (dmOK 720) = true :=
