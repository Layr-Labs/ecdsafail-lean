theorem segReplay_inner {R : State → Prop} {τ₀ τ₁ : Equiv.Perm Wire} {Q P : Program} (a h : Wire)
    (k : SegReplay R τ₀ τ₁ Q P)
    (za : ∀ s, R s → (pullState τ₀.symm s).basis a = false)
    (zh : ∀ s, R s → (pullState τ₀.symm s).basis h = false)
    (free : h ∉ wires Q) (ra : Resets a Q) :
