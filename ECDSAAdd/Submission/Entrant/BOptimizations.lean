theorem dm_of (j : Nat)
    (h0 : (List.range' 0 400).all (dmOK j) = true) (h1 : (List.range' 400 400).all (dmOK j) = true)
    (h2 : (List.range' 800 400).all (dmOK j) = true) (h3 : (List.range' 1200 400).all (dmOK j) = true)
    (h4 : (List.range' 1600 400).all (dmOK j) = true) (h5 : (List.range' 2000 314).all (dmOK j) = true) :
    ∀ i < 2314, Baselines.layout.skywalkDirectMap i = Baselines.layout.skywalkDirectMap j → i = j := by
  intro i hi e
  have ok : dmOK j i = true := by
    have mem : ∀ (a n : Nat), (List.range' a n).all (dmOK j) = true → a ≤ i → i < a + n →
        dmOK j i = true := fun a n h ha hb =>
      List.all_eq_true.mp h i (List.mem_range'_1.mpr ⟨ha, hb⟩)
    by_cases c0 : i < 400
    · exact mem 0 400 h0 (by omega) (by omega)
    by_cases c1 : i < 800
    · exact mem 400 400 h1 (by omega) (by omega)
    by_cases c2 : i < 1200
    · exact mem 800 400 h2 (by omega) (by omega)
    by_cases c3 : i < 1600
    · exact mem 1200 400 h3 (by omega) (by omega)
    by_cases c4 : i < 2000
    · exact mem 1600 400 h4 (by omega) (by omega)
    · exact mem 2000 314 h5 (by omega) (by omega)
  simp only [dmOK, Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at ok
  rcases ok with h | h
  · exact h
  · exact absurd e h

