/-- A hole is not a wire of a placed piece. -/
theorem not_mem_of_pieceOK {holes : List Wire} {f : Wire → Wire} {P : Program}
    (h : PieceOK holes f P) {q : Wire} (hq : q ∈ holes) : q ∉ wires (renameProgram f P) := by
  intro hw
