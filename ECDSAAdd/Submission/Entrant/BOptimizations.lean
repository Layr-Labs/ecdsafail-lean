    (5402 ≤ a ∧ b ≤ 5515) ∨ (5516 ≤ a ∧ b ≤ 5655))
    (h1 : a ≤ w) (h2 : w < b) : good44B w = true := by
  simp only [good44B, good39B, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true',
    Bool.eq_false_iff, ne_eq, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq]
  omega

