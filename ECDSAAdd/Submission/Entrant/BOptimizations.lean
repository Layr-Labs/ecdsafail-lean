/-- The hosts of the scheduled groups avoid the labels `736 .. 740`. -/
theorem hosts44 : ∀ g ∈ schedule, ∀ h ∈ hp.group true g.1 g.2.1 g.2.2,
    ¬ (736 ≤ h ∧ h < 741) := by
  have hc : schedule.all (fun g => (hp.group true g.1 g.2.1 g.2.2).all
      (fun h => !tpFiveB h)) = true := by
    decide +kernel
  intro g hg h hh
  have t := List.all_eq_true.mp (List.all_eq_true.mp hc g hg) h hh
  rw [Bool.not_eq_true'] at t
  exact not_tpFive t

theorem role_of_five {x : Nat} (h : 736 ≤ x ∧ x < 741) : x ∈ StairSchedule.exclusiveRoles := by
  rw [k6_exclusiveRoles_eq]
  simp only [List.mem_append, List.mem_range'_1]
  omega

theorem hostedGroup44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    (divide : Bool) (d f c : Nat) (hg : (d, f, c) ∈ schedule) :
    PieceOK holes TP (StairHostsSchedule.hostedGroup hp divide d f c) := by
  obtain ⟨hd, hf, hc⟩ := schedule_bounds _ hg
  obtain ⟨disj, nr, nh, hlen, htpi⟩ := hostFacts _ hg
  have h5 := hosts44 _ hg
  simp only at hd hf hc disj nr nh hlen htpi h5
  rw [← group_dir divide] at disj nh hlen htpi h5
  apply ok44_of_tp hsub
  intro x hx
  unfold StairHostsSchedule.hostedGroup at hx
  rcases rebind_mem _ _ _ (hostsFresh divide d f c hg) disj nr nh hlen x hx with hh | ⟨hP, hnr⟩
  · exact ⟨htpi x hh, h5 x hh⟩
  · replace hP := StairConcrete.placedGroups_wires_sub divide d f c hP
    rw [renameProgram_support] at hP
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hP
    obtain ⟨j, hj1, hj2, hjw⟩ := seq_mem divide (StairGroups.packet divide d) c f w hw
    unfold StairGroups.packet at hjw
    rw [renameProgram_support] at hjw
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hjw
    have hjr : j ∈ List.range' 1 101 := List.mem_range'_1.mpr ⟨by omega, by omega⟩
    obtain ⟨nt, hr⟩ := basePacket_tgt divide d j hjr hd z hz
    have notRole : Mj j z ∉ StairSchedule.exclusiveRoles := by
      intro hr'
      rw [← List.take_append_drop d StairSchedule.exclusiveRoles, List.mem_append] at hr'
      rcases hr' with hr' | hr'
      · exact nt hr'
      · exact hnr hr'
    rcases hr with hr | hr
    · exact absurd hr notRole
    · exact ⟨hr, fun h => notRole (role_of_five h)⟩

theorem groups44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) :
    ∀ g ∈ entryGroups,
      PieceOK holes TP (StairHostsSchedule.hostedGroup hp true g.1 g.2.1 g.2.2) := by
  intro g hg
  exact hostedGroup44 hsub true g.1 g.2.1 g.2.2 (by
    simp only [entryGroups, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)

