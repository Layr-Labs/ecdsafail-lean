/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCallerHosted_at_StairSideA` -/
section Merge_StairCallerHosted_at_StairSideA

/-!
# Caller-domain support of the hosted / loaned pieces (LT11)

Every hosted piece of the schedule is `StairHostsRetirement.retiredProgram d
hosts P`, i.e. the role-to-host rebinding (`StairLoan.rebindMany`, a nest of
swaps) followed by `retirementSwap`.  Both preserve the caller domain as soon
as roles and hosts are caller labels (`retiredProgram_caller`).

The inner programs are
* record field pieces (`R2SqEp760.endPacket760`, `HalfFieldOB5.copyN`,
  `R2SqEp760.canon760`, `R2SqEp760.center760`, `Rolling1588.placedFirstPacket`,
  record packet groups), whose own labels are caller labels by the record
  theorems `Rolling1588.entryFieldHosted_support` /
  `exitFieldHosted_support` and the invertibility of the field wrappers;
* the loaned packet groups `StairGroups.groups divide d first count`, proved
  structurally from the support of the loaned half
  (`StairLoan.half760Loan d divide`, field 5: `StairHalfSupportField.half_support`),
  through `loanWindow`, `selW`, `onPacket`, `shifted (Placement5.pi j)` and
  `PacketSequence.program`.  The half-support input is a parameter, so the
  k = 44 re-plan only needs the re-planned field-5 theorem.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## Generic local-label checker -/

def corrIn (p : Nat → Bool) : List Correction → Bool
  | [] => true
  | .Z t :: cs => p t && corrIn p cs
  | .CZ a b :: cs => p a && p b && corrIn p cs

def instrIn (p : Nat → Bool) : Instr → Bool
  | .X t => p t
  | .CX c t => p c && p t
  | .CCX a b t => p a && p b && p t
  | .measureX t c₀ c₁ => p t && corrIn p c₀ && corrIn p c₁

def allIn (p : Nat → Bool) : Program → Bool
  | [] => true
  | i :: P => instrIn p i && allIn p P

theorem corrIn_sound (p : Nat → Bool) (cs : List Correction) (h : corrIn p cs = true) :
    ∀ q ∈ correctionWires cs, p q = true := by
  induction cs with
  | nil => simp [correctionWires]
  | cons c cs ih =>
    cases c with
    | Z t =>
      simp only [corrIn, Bool.and_eq_true] at h
      intro q hq
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at hq
      rcases hq with rfl | hq
      · exact h.1
      · exact ih h.2 q hq
    | CZ a b =>
      simp only [corrIn, Bool.and_eq_true] at h
      intro q hq
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at hq
      rcases hq with (rfl | rfl) | hq
      · exact h.1.1
      · exact h.1.2
      · exact ih h.2 q hq

theorem instrIn_sound (p : Nat → Bool) (i : Instr) (h : instrIn p i = true) :
    ∀ q ∈ i.wires, p q = true := by
  intro q hq
  cases i with
  | X t =>
    simp only [Instr.wires, Finset.mem_singleton] at hq
    subst hq
    exact h
  | CX c t =>
    simp only [instrIn, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact h.1
    · exact h.2
  | CCX a b t =>
    simp only [instrIn, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl | rfl
    · exact h.1.1
    · exact h.1.2
    · exact h.2
  | measureX t c₀ c₁ =>
    simp only [instrIn, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with (rfl | h0) | h1
    · exact h.1.1
    · exact corrIn_sound p c₀ h.1.2 q h0
    · exact corrIn_sound p c₁ h.2 q h1

theorem allIn_sound (p : Nat → Bool) (P : Program) (h : allIn p P = true) :
    ∀ q ∈ wires P, p q = true := by
  induction P with
  | nil => simp [wires]
  | cons i P ih =>
    simp only [allIn, Bool.and_eq_true] at h
    intro q hq
    simp only [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · exact instrIn_sound p i h.1 q hq
    · exact ih h.2 q hq

/-- Packet-local labels `0..9`, or caller labels. -/
def localNat (q : Nat) : Bool := decide (q < 10) || callerNat q

theorem localNat_sound (q : Wire) (h : localNat q = true) : q < 10 ∨ q ∈ callerDomain := by
  simp only [localNat, Bool.or_eq_true, decide_eq_true_eq] at h
  rcases h with h | h
  · exact Or.inl h
  · exact Or.inr (callerNat_sound q h)

