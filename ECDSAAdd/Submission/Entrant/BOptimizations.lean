/-! # S2: the square tail `entryR` frees pool 724 as well (0 T)

`E1ReflectedPlacement.entryR L0 k` uses pool 724 (= `pmapR L0 (base 722)`) only as the carry
`w 722` of the merged first tick, whose last write is the `measureX (w 722)` before the final
`copyRegister … loadT … measureX (w 721)` tail (`E1Reflected.s2_merged_zt722`).  The new tail
`entryRH4 k := hostRename (entryPairs ++ [(pool 724, pool 717)]) (entryR L0 k)` hosts it on pool 717
(physical 4112 = `layout.core.equalNegY` after `UG`), which `entryR` never touches.  Both are pool
wires, so the square's `TailOK` frame (`dialogPool` clean at the tail input) gives them zero at
entry; the hole is zero at exit by the static zero tracker.  `entryRH4_tailOK` is the drop-in for
`StairSquareAssembly.entryRH_tailOK`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.E1Reflected
open ECDSAAdd ECDSAAdd.Arithmetic NativeFirstDirect RecordedQuantum MappedCompressed



set_option exponentiation.threshold 400 in
/-- The part of `merged` after its `measureX (w 722)` never touches `w 722`. -/
theorem s2_tail722 (k : Nat) :
    base 722 ∉ wires (copyRegister none (wireBlock base 770 257) (hpR base) ++ hAddT base ++
      [.CX (base 1028) (base 0), .X (base 0)] ++ loadT base (base 2400) k ++
      eraseLtChain (hp8 base) (tR base) (hC3 base) (base 1797) (base 514) ++ loadT base (base 2400) k ++
      [.measureX (base 721) [] [.CZ (base 2400) (base 1028)]]) := by
  have hLT : base 722 ∉ wires (loadT base (base 2400) k) := by
    simp only [loadT, wires_append, Finset.mem_union, not_or]
    constructor
    · intro h
      have m := List.mem_toFinset.mp (maskedConstant_wires_subset _ _ _ h)
      rcases List.mem_cons.mp m with e | e
      · exact s2_ne 2400 (by omega) e
      · exact s2_blk_ne 1029 256 (by omega) e
    · intro h
      have m := List.mem_toFinset.mp (maskedConstant_wires_subset _ _ _ h)
      rcases List.mem_cons.mp m with e | e
      · exact s2_ne 721 (by omega) e
      · exact s2_blk_ne 1029 256 (by omega) e
  simp only [wires_append, Finset.mem_union, not_or, and_assoc]
  refine ⟨?_, ?_, ?_, hLT, ?_, hLT, ?_⟩
  · intro h
    have m := List.mem_toFinset.mp (copyRegister_wires_subset _ _ _ h)
    simp only [Option.toList_none, List.nil_append, List.mem_append, hpR] at m
    rcases m with e | e
    · exact s2_blk_ne 770 257 (by omega) e
    · exact s2_blk_ne 1 257 (by omega) e
  · intro h
    have m := List.mem_toFinset.mp (mappedAdd_wires_subset _ _ _ _ (hAddT_wires base h))
    rcases List.mem_append.mp m with m | e
    · rcases List.mem_append.mp m with m | e
      · rcases List.mem_append.mp m with e | e
        · exact s2_ne 1028 (by omega) (dBits_wire base _ e)
        · exact s2_blk_ne 1 257 (by omega) e
      · exact s2_blk_ne 1540 256 (by omega) e
    · exact s2_ne 1797 (by omega) (List.mem_singleton.mp e)
  · decide
  · intro h
    have m := List.mem_toFinset.mp (eraseLtChain_wires_subset _ _ _ _ _ h)
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, hp8, tR, hC3] at m
    rcases m with ((e | e) | e) | e | e
    · exact s2_blk_ne 1 256 (by omega) e
    · exact s2_blk_ne 1029 256 (by omega) e
    · exact s2_blk_ne 1540 255 (by omega) e
    · exact s2_ne 1797 (by omega) e
    · exact s2_ne 514 (by omega) e
  · decide

/-- The merged reflected first tick resets `w 722` (static zero tracker). -/
theorem s2_merged_zt722 (k : Nat) :
    StairField13V3Clean.zt (base 722) false (merged base (base 2400) k) = true := by
  have e : merged base (base 2400) k =
      (comparePart base (base 2400) k ++ (parGates base (base 2400) k ++ rotateRight (kR base) ++
        notRegister (kR base)) ++ prodPart base (base 2400) ++ loadK base (base 2400) k ++
        E1WholeKAdd52Research.flagKAdd52 base ++ loadK base (base 2400) k) ++
      (Instr.measureX (base 722) [] [.CZ (base 514) (base 1028)] ::
        (copyRegister none (wireBlock base 770 257) (hpR base) ++ hAddT base ++
          [.CX (base 1028) (base 0), .X (base 0)] ++ loadT base (base 2400) k ++
          eraseLtChain (hp8 base) (tR base) (hC3 base) (base 1797) (base 514) ++
          loadT base (base 2400) k ++ [.measureX (base 721) [] [.CZ (base 2400) (base 1028)]])) := by
    simp only [merged, List.append_assoc, List.cons_append, List.nil_append]
  rw [e]
  exact StairS2.zt_meas_mid _ _ _ _ _ _ (s2_tail722 k)

