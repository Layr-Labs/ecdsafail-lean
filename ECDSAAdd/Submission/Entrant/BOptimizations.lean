/-! ## K4-D (replay budget): closed-form bit masks and interval checks

The per-wire site tests are replaced by bits of closed-form masks (`K4D.YM`, `K4D.ZM`), tied to the original
predicates by symbolic soundness lemmas; the kernel then checks each wire range with one comparison
`(m >>> a) % 2 ^ n = 2 ^ n - 1` instead of evaluating the placement maps wire by wire. -/
namespace K4D

/-- Mask of the interval `[a, a + n)`. -/
def rM (a n : Nat) : Nat := (2 ^ n - 1) <<< a

theorem testBit_rM (a n v : Nat) : (rM a n).testBit v = (decide (a ≤ v) && decide (v < a + n)) := by
  unfold rM
  rw [Nat.testBit_shiftLeft, Nat.testBit_two_pow_sub_one]
  by_cases h1 : a ≤ v
  · simp only [ge_iff_le, h1, decide_true, Bool.true_and]
    exact decide_eq_decide.mpr (by omega)
  · simp only [ge_iff_le, h1, decide_false, Bool.false_and]

/-- `a` without the bits of `b`. -/
def andNot (a b : Nat) : Nat := a ^^^ (a &&& b)

theorem testBit_andNot (a b i : Nat) : (andNot a b).testBit i = (a.testBit i && !b.testBit i) := by
  unfold andNot
  rw [Nat.testBit_xor, Nat.testBit_and]
  cases a.testBit i <;> cases b.testBit i <;> rfl

theorem maskOf_append (l1 l2 : List Nat) :
    StairLoan.maskOf (l1 ++ l2) = StairLoan.maskOf l1 ||| StairLoan.maskOf l2 := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_or, StairLoan.testBit_maskOf, List.mem_append, Bool.decide_or]

theorem maskOf_range' (a n : Nat) : StairLoan.maskOf (List.range' a n) = rM a n := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [StairLoan.testBit_maskOf, testBit_rM, List.mem_range'_1, Bool.decide_and]

/-- A whole interval of `f`-good wires from one mask comparison. -/
theorem all_range (f : Nat → Bool) (m : Nat) (hm : ∀ y, m.testBit y = true → f y = true)
    (a n : Nat) (h : (m >>> a) % 2 ^ n = 2 ^ n - 1) : (List.range' a n).all f = true := by
  rw [List.all_eq_true]
  intro y hy
  rw [List.mem_range'_1] at hy
  apply hm
  have hlt : y - a < n := by omega
  have hy' : a + (y - a) = y := by omega
  have e := congrArg (fun t => Nat.testBit t (y - a)) h
  simp only [Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, Nat.testBit_two_pow_sub_one, hlt,
    decide_true, Bool.true_and, hy'] at e
  exact e

/-- The arena as a closed-form mask (same pieces as `StairPhysicalLayout.arenaNat`). -/
def AM : Nat := StairLoan.maskOf [1] ||| rM 2 256 ||| rM 258 256 ||| StairLoan.maskOf [0, 9815, 9814, 4112] |||
  rM 4115 515 ||| rM 4833 311 ||| rM 5399 257 ||| StairLoan.maskOf [5915]

theorem AM_eq : StairLoan.maskOf StairPhysicalLayout.arenaNat = AM := by
  simp only [StairPhysicalLayout.arenaNat, maskOf_append, maskOf_range', AM]

def HM : Nat := StairLoan.maskOf StairPhysicalLayout.oldHolesNat

/-- Good physical sites: arena minus the old omissions. -/
def GM : Nat := andNot AM HM

theorem GM_spec (v : Nat) :
    GM.testBit v = (StairPhysicalLayout.arenaB v && decide (v ∉ StairPhysicalLayout.oldHolesNat)) := by
  have hA : AM.testBit v = StairPhysicalLayout.arenaB v := by
    rw [← AM_eq, StairLoan.testBit_maskOf, LT48K.arena_dec]
  unfold GM HM
  rw [testBit_andNot, hA, StairLoan.testBit_maskOf]
  simp only [decide_not]

theorem swF_id (a b x : Nat) (ha : x ≠ a) (hb : x ≠ b) : LT48K.swF a b x = x := by
  unfold LT48K.swF
  rw [if_neg ha, if_neg hb]

/-- The ten wires moved by `UGF`. -/
def ugMoved : List Nat := [4799, 4832, 9815, 0, 5655, 4112, 4113, 9814, 1, 5515]

def UM : Nat := StairLoan.maskOf ugMoved

theorem UGF_id (y : Nat) (h : UM.testBit y = false) : LT48K.UGF y = y := by
  have hy := StairLoan.not_mem_of_maskOf h
  simp only [ugMoved, List.mem_cons, List.not_mem_nil, or_false, not_or] at hy
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := hy
  have e1 : LT48K.pwF 684 = 4799 := by decide
  have e2 : LT48K.pwF 717 = 4832 := by decide
  have e3 : LT48K.pwF 1540 = 5655 := by decide
  have e4 : LT48K.pwF 1400 = 5515 := by decide
  unfold LT48K.UGF
  rw [e1, e2, e3, e4, swF_id 1 5515 y h9 h10, swF_id 4799 4832 y h1 h2, swF_id 4113 9814 y h7 h8,
    swF_id 4112 4799 y h6 h1, swF_id 9815 5655 y h3 h5, swF_id 9815 0 y h3 h4, swF_id 4799 4832 y h1 h2]

theorem mr (a n : Nat) : (List.range n).map (· + a) = List.range' a n := by
  rw [List.range'_eq_map_range]
  exact List.map_congr_left (fun x _ => Nat.add_comm x a)

theorem blk (a n : Nat) (h : a + n ≤ 5699) : wireBlock LT48K.pwF a n = List.range' (4115 + a) n := by
  unfold wireBlock
  rw [← List.map_add_range']
  apply List.map_congr_left
  intro x hx
  rw [List.mem_range'_1] at hx
  unfold LT48K.pwF
  rw [if_pos (by omega)]

/-! ### `bridge_all` -/

def BM : Nat := StairLoan.maskOf (bad12.map LT48K.pwF)

/-- The sites moved by `UGF` (checked directly). -/
def bridgeSpecial : List Nat := [4113, 4832, 5515, 5655]

/-- `bridgeF`-good wires: (`bad12` or good) and not moved by `UGF`, or one of the checked moved sites. -/
def YM : Nat := andNot (BM ||| GM) UM ||| StairLoan.maskOf bridgeSpecial

theorem bridgeSpecial_ok : ∀ y ∈ bridgeSpecial, LT48K.bridgeF y = true := by
  decide +kernel

theorem YM_sound (y : Nat) (h : YM.testBit y = true) : LT48K.bridgeF y = true := by
  unfold YM at h
  rw [Nat.testBit_or, Bool.or_eq_true] at h
  rcases h with h | h
  · rw [testBit_andNot, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨hq, hu⟩ := h
    unfold LT48K.bridgeF
    rw [UGF_id y hu]
    rw [Nat.testBit_or, GM_spec] at hq
    unfold BM at hq
    rw [StairLoan.testBit_maskOf] at hq
    exact hq
  · exact bridgeSpecial_ok y (StairLoan.mem_of_maskOf h)

