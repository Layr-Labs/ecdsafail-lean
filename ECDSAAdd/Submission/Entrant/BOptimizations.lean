  · have hf : StairPhysicalLayout.arenaB v = false := by simpa using h
    rw [hf]
    apply decide_eq_false
    intro hm
    simp only [StairPhysicalLayout.arenaB, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq,
      beq_iff_eq] at h
    simp only [StairPhysicalLayout.arenaNat, List.mem_append, List.mem_cons, List.mem_range'_1,
      List.not_mem_nil, or_false] at hm
