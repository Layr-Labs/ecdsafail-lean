  run (fastConstAdd L L.point.x k++E1QubitPlacement.tickF L) (m2.drop n2) r := by
  simp only [run_append,ct1.2,ct2.2]
  rw [A161Const.compose L hw hn k D Z.val G Z.isLt r _ _ prior.2.generic prior.2.x prior.2.clean]
