/-! ## The caller domain -/




theorem caller_index (q : Wire) (hq : q ∈ callerDomain) :
    ∃ i, (i < 2314 ∨ i = 2400 ∨ i = 2409 ∨ i = 2410 ∨ i = 2411) ∧ q = base i := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  refine ⟨i, ?_, rfl⟩
