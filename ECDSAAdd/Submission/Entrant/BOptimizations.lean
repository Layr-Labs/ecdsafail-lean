/-!
# Slot facts and walk arithmetic, generic in the primitive provider

`WalkFacts p c` lists the slot facts a `StairSchedule.StairPrimitives`
provider must satisfy for the ledger `c`; the walk theorems themselves are in
`StairSlotsWalk`.  Every numeric index relation is passed as an explicit
hypothesis (no definitional arithmetic in statements), and `gateSlots` is
locally irreducible.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSlotsPlan

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed DirectSkywalk Secp256k1 BalancedField Baselines

attribute [local irreducible] gateSlots


/-! ## Record-walk arithmetic -/


theorem reverse_succ (s n t m : Nat) (ht : t = s + 1) (hm : m = n + 1) :
    gateSlots (Rolling1588.reverse true s m) =
      gateSlots (Rolling1588.reverse true t n) +
        gateSlots (Rolling1588.unpackAtTick true s) +
        gateSlots (W.ReverseCarry.compactReceiverTick base s) := by
  subst ht
  subst hm
  simp only [Rolling1588.reverse, gateSlots_append, rename_gateSlots]
  omega


theorem reverse_add (i n m j k : Nat) (hj : j = i + n) (hk : k = n + m) :
    gateSlots (Rolling1588.reverse true i k) =
      gateSlots (Rolling1588.reverse true i n) +
        gateSlots (Rolling1588.reverse true j m) := by
  subst hj
  subst hk
  exact StairSlotsLib.reverse_slots_add i n m

theorem groups_add (divide : Bool) (i n m j k : Nat) (hj : j = i + n) (hk : k = n + m) :
    gateSlots (Rolling1588.groups divide i k) =
      gateSlots (Rolling1588.groups divide i n) +
        gateSlots (Rolling1588.groups divide j m) := by
  subst hj
  subst hk
  exact StairSlotsLib.groups_slots_add divide i n m

/-- The record packet groups `1 .. 101` split along the v3 group runs. -/
theorem recordGroups_v3 (divide : Bool) :
    gateSlots (Rolling1588.groups divide 1 101) =
      gateSlots (Rolling1588.groups divide 1 84) +
      gateSlots (Rolling1588.groups divide 85 5) +
      gateSlots (Rolling1588.groups divide 90 3) +
      gateSlots (Rolling1588.groups divide 93 3) +
      gateSlots (Rolling1588.groups divide 96 2) +
      gateSlots (Rolling1588.groups divide 98 2) +
      gateSlots (Rolling1588.groups divide 100 2) := by
  have g1 := groups_add divide 1 84 17 85 101 (by norm_num) (by norm_num)
  have g2 := groups_add divide 85 5 12 90 17 (by norm_num) (by norm_num)
  have g3 := groups_add divide 90 3 9 93 12 (by norm_num) (by norm_num)
  have g4 := groups_add divide 93 3 6 96 9 (by norm_num) (by norm_num)
  have g5 := groups_add divide 96 2 4 98 6 (by norm_num) (by norm_num)
  have g6 := groups_add divide 98 2 2 100 4 (by norm_num) (by norm_num)
  omega

/-! ## Segment shapes -/



