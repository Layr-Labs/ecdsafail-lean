/-!
# Pieces that are good for all 44 physical holes: the checker (S4)

`StairSiteEasy.Good39` deliberately allows the five sites `4835 .. 4839` (pool `720 .. 724`),
which are physical holes but not among the 39.  `Good44 q` adds the missing interval, so a
piece whose placed labels are all `Good44` is fine for EVERY hole list inside the 44
(`ok44_of_good`).

* `good44B`: the Boolean form (`good39B` and one more interval test), `good44_of_listB` for
  cover lists;
* `k44PP*` / `k44TP*`: the affine interval lemmas of `StairSiteEasyCore` redone for `good44B`
  (none of the affine images meets `4835 .. 4839`);
* `tp44`: a `TPI` label other than `736 .. 740` is `Good44` under `TP`;
* `pp44`: a `PPI` label other than `739, 740, 1042, 1557, 1558` is `Good44` under `PP`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairHoles44

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance StairPhysicalLayout StairSiteEasy

/-- good for all 44 physical holes -/
def Good44 (q : Nat) : Prop := StairSiteEasy.Good39 q ∧ ¬ (4835 ≤ q ∧ q < 4840)

theorem good44_not_new {q : Nat} (h : Good44 q) : q ∉ newHolesNat := by
  intro m
  simp only [newHolesNat, List.mem_append, List.mem_range'_1] at m
  have h39 : ¬ Hole39 q := h.1.2.2
  have h5 := h.2
  unfold Hole39 at h39
  omega

theorem good44_spec {q : Wire} (h : Good44 q) :
    q ∈ StairHoleSupport.recordArena ∧ q ∉ StairHoleSupport.oldHoles ∧
      q ∉ StairPhysicalInventory.physicalHoles := by
  have g := good39_spec h.1
  refine ⟨g.1, g.2.1, ?_⟩
  rw [physicalHoles_eq_nat]
  exact good44_not_new h

/-- The basic closing lemma, for every hole list inside the 44. -/
theorem ok44_of_good {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    {f : Wire → Wire} {P : Program} (h : ∀ x ∈ wires P, Good44 (f x)) :
    StairSiteAvoidance.PieceOK holes f P :=
  pieceOK_of_good hsub (fun x hx => good44_spec (h x hx))

/-- Support list + one check over the list. -/
theorem ok44_of_cover {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    {f : Wire → Wire} {P : Program} (S : List Wire)
    (hS : ∀ x ∈ wires P, x ∈ S) (hc : ∀ x ∈ S, Good44 (f x)) : PieceOK holes f P :=
  ok44_of_good hsub (fun x hx => hc x (hS x hx))


/-! ## Boolean form -/

/-- `Good44` as one Boolean interval test on a literal. -/
def good44B (q : Nat) : Bool := good39B q && !(Nat.ble 4835 q && Nat.blt q 4840)

theorem good44_of_B {q : Nat} (h : good44B q = true) : Good44 q := by
  unfold good44B at h
  rw [Bool.and_eq_true] at h
  refine ⟨good39_of_B h.1, fun hq => ?_⟩
  have e : (Nat.ble 4835 q && Nat.blt q 4840) = true := by
    simp only [Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq]
    exact hq
  have h2 := h.2
  rw [e] at h2
  exact absurd h2 (by decide)

/-- Support list + one check over the list, on a kernel-fast form `g` of `f`. -/
theorem good44_of_listB {f : Wire → Wire} (g : Nat → Nat) (hg : ∀ x, f x = g x) {S : List Wire}
    (h : S.all (fun x => good44B (g x)) = true) : ∀ x ∈ S, Good44 (f x) :=
  fun x hx => by rw [hg]; exact good44_of_B (List.all_eq_true.mp h x hx)

theorem g44_lo {w : Nat} (h : w ≤ 513) : good44B w = true := by
  simp only [good44B, good39B, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true',
    Bool.eq_false_iff, ne_eq, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq]
  omega

