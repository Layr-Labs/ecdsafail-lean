/-! ## The hosted groups -/

/-- The scheduled groups (both directions use the same seven triples). -/
def schedule : List (Nat × Nat × Nat) :=
  [(0, 1, 84), (14, 85, 5), (23, 90, 3), (31, 93, 3), (37, 96, 2), (42, 98, 2), (44, 100, 2)]

theorem schedule_bounds : ∀ g ∈ schedule, g.1 ≤ 44 ∧ 1 ≤ g.2.1 ∧ g.2.1 + g.2.2 ≤ 102 := by
  decide

/-- K4-B (replay budget): `TPI` with kernel-primitive tests only. -/
def kbTpiB (x : Nat) : Bool :=
  Nat.blt x 16 || (Nat.ble 17 x && Nat.blt x 527) || (Nat.ble 528 x && Nat.blt x 531) ||
    Nat.beq x 733 || (Nat.ble 736 x && Nat.blt x 741) || Nat.beq x 784 ||
    (Nat.ble 786 x && Nat.blt x 1042) || (Nat.ble 1043 x && Nat.blt x 1301) || Nat.beq x 1556 ||
    (Nat.ble 1560 x && Nat.blt x 1814) || (Nat.ble 2072 x && Nat.blt x 2328) ||
    (Nat.ble 2330 x && Nat.blt x 2417) || Nat.beq x 2425

theorem kbTpiB_tpi {x : Nat} (h : kbTpiB x = true) : TPI x := by
  unfold kbTpiB at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq, Nat.beq_eq] at h
  unfold TPI
  simp only [or_assoc] at h
  exact h

/-- K4-B (replay budget): the host facts of one scheduled group as one linear Boolean pass
(bit masks instead of quadratic membership / `Nodup` decisions). -/
def kbHostCheck (g : Nat × Nat × Nat) : Bool :=
  (StairSchedule.exclusiveRoles.drop g.1).all
      (fun r => !(StairLoan.maskOf (hp.group true g.1 g.2.1 g.2.2)).testBit r) &&
    StairLoan.nodupMask (StairSchedule.exclusiveRoles.drop g.1) 0 &&
    StairLoan.nodupMask (hp.group true g.1 g.2.1 g.2.2) 0 &&
    Nat.ble (StairSchedule.exclusiveRoles.drop g.1).length (hp.group true g.1 g.2.1 g.2.2).length &&
    (hp.group true g.1 g.2.1 g.2.2).all kbTpiB

/-- Host facts for the scheduled deficits (`hp.group` is direction-independent). -/
theorem hostFacts : ∀ g ∈ schedule,
    (∀ r ∈ StairSchedule.exclusiveRoles.drop g.1, r ∉ hp.group true g.1 g.2.1 g.2.2) ∧
    (StairSchedule.exclusiveRoles.drop g.1).Nodup ∧ (hp.group true g.1 g.2.1 g.2.2).Nodup ∧
    (StairSchedule.exclusiveRoles.drop g.1).length ≤ (hp.group true g.1 g.2.1 g.2.2).length ∧
    ∀ h ∈ hp.group true g.1 g.2.1 g.2.2, TPI h := by
  have hc : schedule.all kbHostCheck = true := by
    decide +kernel
  intro g hg
  have h := List.all_eq_true.mp hc g hg
  unfold kbHostCheck at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Nat.ble_eq] at h
  obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := h
  refine ⟨fun r hr hm => ?_, StairLoan.nodup_of_mask _ h2, StairLoan.nodup_of_mask _ h3, h4,
    fun x hx => kbTpiB_tpi (List.all_eq_true.mp h5 x hx)⟩
  have hb := List.all_eq_true.mp h1 r hr
  rw [Bool.not_eq_true'] at hb
  exact StairLoan.not_mem_of_maskOf hb hm

theorem group_dir (divide : Bool) (d f c : Nat) :
    hp.group divide d f c = hp.group true d f c := rfl

theorem hostsFresh (divide : Bool) (d f c : Nat) (hg : (d, f, c) ∈ schedule) :
    ∀ q ∈ hp.group divide d f c,
      q ∉ wires (StairSchedule.placedGroups StairConcrete.bestLoans divide d f c) := by
  by_cases h44 : d = 44
  · subst h44
    intro q hq
    simp [hp, StairConcreteAssembly.hostPlan, StairV3Primitives.hostPlan] at hq
  · -- K4-B (replay budget): case split on the schedule instead of one large `omega`
    apply StairField13V3Fresh.hostPlan_group_fresh divide d f c
    simp only [schedule, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hg
    rcases hg with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ |
      ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    all_goals first | decide | exact absurd rfl h44

theorem hostedGroup39 (divide : Bool) (d f c : Nat) (hg : (d, f, c) ∈ schedule) :
    PieceOK StairCertificate.holes39 TP (StairHostsSchedule.hostedGroup hp divide d f c) := by
  obtain ⟨hd, hf, hc⟩ := schedule_bounds _ hg
  obtain ⟨disj, nr, nh, hlen, htpi⟩ := hostFacts _ hg
  simp only at hd hf hc disj nr nh hlen htpi
  rw [← group_dir divide] at disj nh hlen htpi
  apply ok39_of_tpi
  intro x hx
  unfold StairHostsSchedule.hostedGroup at hx
  rcases rebind_mem _ _ _ (hostsFresh divide d f c hg) disj nr nh hlen x hx with hh | ⟨hP, hnr⟩
  · exact htpi x hh
  · replace hP := StairConcrete.placedGroups_wires_sub divide d f c hP
    rw [renameProgram_support] at hP
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hP
    obtain ⟨j, hj1, hj2, hjw⟩ := seq_mem divide (StairGroups.packet divide d) c f w hw
    unfold StairGroups.packet at hjw
    rw [renameProgram_support] at hjw
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hjw
    have hjr : j ∈ List.range' 1 101 := List.mem_range'_1.mpr ⟨by omega, by omega⟩
    obtain ⟨nt, hr⟩ := basePacket_tgt divide d j hjr hd z hz
    rcases hr with hr | hr
    · exfalso
      rw [← List.take_append_drop d StairSchedule.exclusiveRoles, List.mem_append] at hr
      rcases hr with hr | hr
      · exact nt hr
      · exact hnr hr
    · exact hr

theorem groups39 : ∀ g ∈ entryGroups,
    PieceOK StairCertificate.holes39 TP (StairHostsSchedule.hostedGroup hp true g.1 g.2.1 g.2.2) := by
  intro g hg
  exact hostedGroup39 true g.1 g.2.1 g.2.2 (by
    simp only [entryGroups, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)

theorem groupsExit39 : ∀ g ∈ exitGroups,
    PieceOK StairCertificate.holes39 TP (StairHostsSchedule.hostedGroup hp false g.1 g.2.1 g.2.2) := by
  intro g hg
  exact hostedGroup39 false g.1 g.2.1 g.2.2 (by
    simp only [exitGroups, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)

end ECDSAAdd.Entrant.StairSiteEasy

