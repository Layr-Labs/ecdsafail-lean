/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitRoundtrip_at_StairSideA` -/
section Merge_StairField2V3ExitRoundtrip_at_StairSideA

/-!
# Exit core: the walk core as forward equality + segment round trips (LT24)

The staircase reverse walk is the row-by-row inverse of the staircase forward
walk (the division side's segments):

* `StairFwd = FP · F450 · F465 · F480 · F490 · F500 · FT` (first pack, forward
  segments, `SegLast`), in the same placements as the exit pieces;
* `stairWalk = WT · W500 · W490 · W480 · W465 · W450 · FU`.

`walkCore_of` proves `WalkCore k` from
* `FwdEq k` — after the record reverse `RefWalk`, the staircase FORWARD walk
  rebuilds the walk state (the walk content of the division core; shared with
  the entry side), and
* `RowTrips k` — seven local round trips `Wᵢ ∘ Fᵢ = id` on the states of the
  staircase forward trajectory (`FU∘FP`, `W450∘F450`, …, `WT∘FT`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open StairField2V3ExitAlgebra



def fwdOf : List (Program × Program) → Program
  | [] => []
  | (f, _) :: r => f ++ fwdOf r

def invOf : List (Program × Program) → Program
  | [] => []
  | (_, g) :: r => invOf r ++ g



/-- Generic nested round trip along a forward trajectory. -/
def TripChain : List (Program × Program) → State → Prop
  | [], _ => True
  | (f, g) :: r, σ => (∀ c a, run g a (run f c σ) = σ) ∧ ∀ c, TripChain r (run f c σ)

theorem tripChain_run :
    ∀ (L : List (Program × Program)) (σ : State), TripChain L σ →
      ∀ c a, run (invOf L) a (run (fwdOf L) c σ) = σ
  | [], σ, _, c, a => rfl
  | (f, g) :: r, σ, h, c, a => by
      obtain ⟨trip, next⟩ := h
      simp only [invOf, fwdOf]
      rw [run_append f (fwdOf r), run_append (invOf r) g,
        tripChain_run r _ (next _) _ _, trip]





end ECDSAAdd.Entrant.StairExitLT24

end
end Merge_StairField2V3ExitRoundtrip_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitRowChain_at_StairSideA` -/
section Merge_StairField2V3ExitRowChain_at_StairSideA

/-!
# Row round trips from primitive round trips (LT24)

* `rename_trip` — round trips transport through any invertible relabelling
  (field placement `wrap`, history placement `OB5.sig f`, `phaseHost`);
* `segTrip` — the lifted reverse segment `W B B' s f` undoes the lifted forward
  segment `F B B' s f` on `σ` as soon as the six primitive pairs
  `(unpack B, pack B)`, `(tick s)`, `(middle)`, `(orient f)`, `(packet f)`,
  `(pack B', unpack B')` form a `TripChain` on the field-pulled state;
* the primitive trips: codec (`pack_trip`/`unpack_trip`, field 1),
  orientation (unconditional), moved middle (`movedMiddle_roundtrip`, from a
  `Stage`), packet (`encode_decode_roundtrip`, from legality).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3ExitAlgebra StairField2V3ExitRowTrips StairPhysicalLayout

/-! ## Relabelling -/

theorem run_rename_inv (f g : Wire → Wire) (hf : ∀ q, f (g q) = q) (hg : ∀ q, g (f q) = q)
    (Q : Program) (m : List Bool) (t : State) :
    run (renameProgram f Q) m t = pullState g (run Q m (pullState f t)) := by
  have finj : Function.Injective f := fun a b h => by rw [← hg a, ← hg b, h]
  rw [← ECDSAAdd.run_rename f finj Q m t]
  apply State.extensionality
  · rfl
  · funext q
    show _ = (run (renameProgram f Q) m t).basis (f (g q))
    rw [hf]

theorem pull_pull (f g : Wire → Wire) (h : ∀ q, g (f q) = q) (t : State) :
    pullState f (pullState g t) = t := by
  apply State.extensionality
  · rfl
  · funext q
    show t.basis (g (f q)) = t.basis q
    rw [h]

theorem rename_trip (f g : Wire → Wire) (hf : ∀ q, f (g q) = q) (hg : ∀ q, g (f q) = q)
    (Fw Gw : Program) (σ : State)
    (h : ∀ c a, run Gw a (run Fw c (pullState f σ)) = pullState f σ) :
    ∀ c a, run (renameProgram f Gw) a (run (renameProgram f Fw) c σ) = σ := by
  intro c a
  rw [run_rename_inv f g hf hg Fw, run_rename_inv f g hf hg Gw, pull_pull f g hg, h c a,
    pull_pull g f hf]

theorem renameInstr_comp (f g : Wire → Wire) (i : Instr) :
    renameInstr f (renameInstr g i) = renameInstr (fun q => f (g q)) i := by
  have hc : ∀ cs : List Correction, (cs.map (renameCorrection g)).map (renameCorrection f) =
      cs.map (renameCorrection (fun q => f (g q))) := by
    intro cs
    rw [List.map_map]
    apply List.map_congr_left
    intro c _
    cases c <;> rfl
  cases i with
  | X t => rfl
  | CX a t => rfl
  | CCX a b t => rfl
  | measureX t c0 c1 => simp only [renameInstr, hc]

theorem rename_rename (f g : Wire → Wire) (Q : Program) :
    renameProgram f (renameProgram g Q) = renameProgram (fun q => f (g q)) Q := by
  simp only [renameProgram, List.map_map]
  apply List.map_congr_left
  intro i _
  exact renameInstr_comp f g i

/-- The field placement of `wrap` and its inverse. -/
def fPlace (q : Wire) : Wire :=
  (Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
    (HostOB5.hostSwap (Prefix1590.borrow q))

def fPlaceInv (q : Wire) : Wire :=
  Prefix1590.borrow (HostOB5.hostSwap
    ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) q))

theorem borrow_invol (q : Wire) : Prefix1590.borrow (Prefix1590.borrow q) = q := by
  simp [Prefix1590.borrow]

theorem fPlace_inv (q : Wire) : fPlace (fPlaceInv q) = q := by
  simp [fPlace, fPlaceInv, borrow_invol, HostOB5.hostSwap_invol]

theorem fPlaceInv_fPlace (q : Wire) : fPlaceInv (fPlace q) = q := by
  simp [fPlace, fPlaceInv, borrow_invol, HostOB5.hostSwap_invol]

theorem wrap_eq (Q : Program) : wrap Q = renameProgram fPlace Q := by
  simp only [wrap, StairSchedule.fieldRename, StairSchedule.parityRename, rename_rename]
  rfl

/-! ## The six primitive pairs of a nonterminal row -/





/-! ## Primitive trips -/

theorem p_facts : 0 < p ∧ p % 2 = 1 ∧ p < 2 ^ 256 ∧ p + 2 ^ 32 ≤ 2 ^ 256 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> norm_num [p]


/-- Packet trip at a row end `f` (a multiple of 5) from legality of the five
letters before `f`, in the `OB5.sig f` placement. -/
theorem packet_trip (f : Nat) (hf5 : 5 < f) (hfm : f % 5 = 0) (hf : f ≤ 511)
    (hn : (skywalkPoolWires base).Nodup) (t : State)
    (legal : MeasuredCodec5.legalAt (History5.historyMap base (f - 5))
      (pullState (OB5.sig f) t).basis) (c a : List Bool) :
    run (renameProgram (OB5.sig f) (Rolling1588.unpackAtTick true f)) a
      (run (renameProgram (OB5.sig f) (Rolling1588.Integer.packFirst base true f)) c t) = t := by
  have due : History5.packDue f = true := by
    simp only [History5.packDue, decide_eq_true_eq]; exact ⟨by omega, hfm⟩
  have h5 : f ≠ 5 := by omega
  apply rename_trip (OB5.sig f) (OB5.sig f) (fun q => OB5.sig_invol f hf q)
    (fun q => OB5.sig_invol f hf q) _ _ t _ c a
  intro c' a'
  rw [← Rolling1588.Integer.unpackFirst_base]
  simp only [Rolling1588.Integer.packFirst, Rolling1588.Integer.unpackFirst, if_neg h5,
    Rolling1588.Integer.packAfter, Rolling1588.Integer.decodeBefore, due, if_true]
  exact Rolling1588.Integer.encode_decode_roundtrip base true hn (f - 5) (by omega) _ c' a' legal

end ECDSAAdd.Entrant.StairExitLT24

