/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSiteEasyPhase_at_StairSideA` -/
section Merge_StairSiteEasyPhase_at_StairSideA

/-!
# Field 12 on CANON 1945: phase pieces (LT35)

Pieces under the phase placement `PP = kernelPlace ∘ phaseHost`:

* the record walks `Rolling1588TickGap.forward true 1 424` (entry ticks) and
  `Rolling1588.reverse true 1 424` (exit ticks): the record support chain
  `forward_support` → `forward_support_eq` → `NewStackOB5.forward_support_eq` →
  `StackOB5.support_gen` puts every label in `integerSites`
  (`base l`, `l < 515 ∨ 770 ≤ l < 1285 ∨ 1540 ≤ l < 1797`), all `PPI`;
* `InverseFive23.lastPhase15 false` (entry last) and
  `Rolling1588TickGap.tailPhase false` (exit tail): their long walks the same
  way, the native inverse by `FrontierEntry1591Native.support`, the short
  blocks by an `allSites` interval check;
* the v3 first row `firstPack` / `firstUnpack`: `allSites` interval check.

No concrete walk is evaluated; the decided programs are a few thousand gates.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance

/-! K4-B (replay budget): `PPI` as one Boolean test with the kernel-primitive `Nat.blt` /
`Nat.ble` / `Nat.beq` only (the `Decidable (PPI x)` instance costs several ms per wire), and the
phase relabelling on its closed forms. -/




theorem kbRelabel_eqB (q : Wire) : StairPhysicalLayout.phaseRelabel q =
    StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB q) := by
  unfold StairPhysicalLayout.phaseRelabel
  rw [StairPlaceFast.fieldPlace_eqB, StairPlaceFast.phaseHost_eqB]



theorem reverse_ppi (isA : Bool) (n : Nat) (hn : n ≤ 511) :
    ∀ x ∈ wires (Rolling1588.reverse isA 1 n), PPI x := by
  intro x hx
  rw [Rolling1588.reverse_support_eq, NewStackOB5.reverse_support_eq] at hx
  exact ppi_of_int ((StackOB5.support_gen 1 n (by omega) (by omega)).2 x hx)

section
/- K4C (build budget): without these the elaborator unfolds the native inverse programs (and
their `wires`) while instantiating `wires_sub` / `support` (≈ 24 s + ≈ 4 s linting). -/
attribute [local irreducible] wires run FrontierEntry1591NativeH.inverse FrontierEntry1591Native.inverse

set_option exponentiation.threshold 600 in
/-- The record native inverse (end of `lastPhase15`).  (Unifying the record's
pool-nodup premise evaluates a 258-bit power; the threshold is raised locally.) -/
theorem nativeInverse_ppi :
    ∀ x ∈ wires (FrontierEntry1591NativeH.inverse base), PPI x := by
  have pre : ∀ x ∈ NativeFirstDirect.prefixSites base, x ≠ base 1797 → PPI x := by
    have hB : (NativeFirstDirect.prefixSites base).all
        (fun x => Nat.beq x (base 1797) || kbPpiB x) = true := by
      decide +kernel
    intro x hx hne
    have h := List.all_eq_true.mp hB x hx
    rw [Bool.or_eq_true, Nat.beq_eq] at h
    rcases h with h | h
    · exact absurd h hne
    · exact kbPpiB_ppi h
  intro x hx
  have h := (FrontierEntry1591Native.support base base_pool_nodup).2
    (FrontierEntry1591NativeH.wires_sub base base_pool_nodup hx)
  have h2 : x ≠ base 1797 ∧ x ∈ insert (base 511) (NativeFirstDirect.prefixSites base).toFinset :=
    Finset.mem_erase.mp h
  rcases Finset.mem_insert.mp h2.2 with h3 | h3
  · rw [h3]
    show PPI (511 + 16)
    unfold PPI
    omega
  · exact pre x (List.mem_toFinset.mp h3) h2.1

end

/-! K4-B (replay budget): the two large record blocks `Six505.cand6` / `candidate15` are not
evaluated: their exact supports (`StairTerminalV3.cand6_support` / `candidate15_support`, 30 and 35
labels) are checked once. -/



/-! ## The six phase pieces -/


theorem exitTicks39 :
    PieceOK StairCertificate.holes39 PP (Rolling1588.reverse true 1 424) :=
  ok39_of_ppi (reverse_ppi true 424 (by omega))



/-! ### The v3 first row (LT46, replay budget)

`pack 87` / `unpack 87` are not evaluated: their wires lie in `rowSitesL 87`
(`StairPhysicalPrimitives.pack_rows` / `unpack_rows`), and the row sites are checked once
under `phaseRelabel`.  The three small components (x-word orientation, record packet 84,
b-rail move) are checked per instruction.  The proof is one lemma per component, combined
by `PieceOK.append`. -/

theorem rows87_ppi : ∀ q ∈ StairPhysicalPrimitives.rowSitesL 87,
    PPI (StairPhysicalLayout.phaseRelabel q) := by
  -- K4-B (replay budget): closed-form relabelling and the primitive interval test
  have hB : (StairPhysicalPrimitives.rowSitesL 87).all
      (fun q => kbPpiB (StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB q))) = true := by
    decide +kernel
  intro q hq
  rw [kbRelabel_eqB]
  exact kbPpiB_ppi (List.all_eq_true.mp hB q hq)

theorem phaseRows39 {P : Program}
    (h : ∀ q ∈ wires P, q ∈ StairPhysicalPrimitives.rowSitesL 87) :
    PieceOK StairCertificate.holes39 PP (renameProgram StairPhysicalLayout.phaseRelabel P) := by
  apply ok39_of_ppi
  intro x hx
  rw [renameProgram_support] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  exact rows87_ppi y (h y hy)

/-- K4-B: the support of the first-row orientation (letter, rails and their extensions). -/
def kbOrientSites : List Wire :=
  StairPhysicalLayout.letterSite 424 ::
    ((StairCodec.reg (StairPhysicalLayout.physicalLayout 87).S 87 ++ [base 512]) ++
      (StairCodec.reg (StairPhysicalLayout.physicalLayout 87).D 87 ++ [StairPhysicalLayout.bSite 87]))

theorem kbOrientSites_ppi : kbOrientSites.all
    (fun q => kbPpiB (StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB q))) = true := by
  decide +kernel

theorem kbBSite_ppi : (List.range 88).all (fun k => kbPpiB (StairPhysicalLayout.bSite k)) = true := by
  decide +kernel

/-- K4-B (replay budget): structural (`swapRegisters_wires`, `xSwap_cases`) instead of evaluating
the relabelled orientation program; one check over its 176 support sites. -/
theorem firstOrient39 : PieceOK StairCertificate.holes39 PP
    (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) := by
  apply ok39_of_ppi
  intro x hx
  rw [renameProgram_support] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  have hsup : wires (StairV3Primitives.orient 425) ⊆ (StairPhysicalLayout.letterSite 424 ::
      ((StairCodec.reg (StairPhysicalLayout.physicalLayout 87).S 87 ++ [base 512]) ++
        (StairCodec.reg (StairPhysicalLayout.physicalLayout 87).D 87 ++
          [StairPhysicalLayout.bSite 87]))).toFinset :=
    swapRegisters_wires _ _ _ (by simp [StairCodec.reg])
  have hyL : y ∈ kbOrientSites := List.mem_toFinset.mp (hsup hy)
  show PPI (StairV3Primitives.xSwap (StairPhysicalLayout.phaseRelabel y))
  rcases StairV3Primitives.xSwap_cases (StairPhysicalLayout.phaseRelabel y) with
    ⟨k, hk, -, e⟩ | ⟨k, hk, -, e⟩ | e
  · rw [e]
    exact kbPpiB_ppi (List.all_eq_true.mp kbBSite_ppi k hk)
  · rw [e]
    have hk' := List.mem_range.mp hk
    unfold PPI
    simp only [MappedCompressed.base]
    omega
  · rw [e, kbRelabel_eqB]
    exact kbPpiB_ppi (List.all_eq_true.mp kbOrientSites_ppi y hyL)

theorem firstPacket39 : PieceOK StairCertificate.holes39 PP
    (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) :=
  kbOk39_of_ppiAllB (by decide +kernel)

theorem firstUnpacket39 : PieceOK StairCertificate.holes39 PP
    (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)) :=
  kbOk39_of_ppiAllB (by decide +kernel)

theorem phaseBMove39 : PieceOK StairCertificate.holes39 PP StairPhysicalLayout.phaseBMove :=
  kbOk39_of_ppiAllB (by decide +kernel)

theorem phaseBReturn39 : PieceOK StairCertificate.holes39 PP StairPhysicalPhase.phaseBReturn :=
  kbOk39_of_ppiAllB (by decide +kernel)



