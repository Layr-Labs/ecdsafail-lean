    · exact kbTP9 x (by omega) (by omega)
    · exact kbTPm x (by omega) (by omega)
    · rw [hJ]
      decide
  intro x hx
  have h := good39_of_B (key x hx)
  rwa [← StairPlaceFast.outerPlace_eqB] at h

