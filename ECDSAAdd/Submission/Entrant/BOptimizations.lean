theorem fwdN (x : Nat) (hx0 : 0 < x) (hx : x < p) (s1 : State)
    (first : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis)
    (n : Nat) (hn : n ≤ 511) (m : List Bool) :
    run (Rolling1588TickGap.forward true 1 n) m s1 =
