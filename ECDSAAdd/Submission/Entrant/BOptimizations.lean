theorem kx_zt_eraseCarry (a b cin q : Wire) :
    StairField13V3Clean.zt q false (eraseCarry a b cin q) = true := by
  simp [eraseCarry, StairField13V3Clean.zt, StairField13V3Clean.tgt, StairField13V3Clean.isMeas]

theorem kx_zt_chain (q target : Wire) (ctl : Option Wire) : ∀ (n : Nat) (as bs cs : List Wire)
    (cin : Wire), n < as.length → n < bs.length → n < cs.length → cs.getD n 0 = q → q ≠ cin →
    q ∉ as.take n → q ∉ bs.take n → q ∉ cs.take n →
    StairField13V3Clean.zt q false (compareChain ctl as bs cs cin target) = true := by
  intro n
  induction n with
  | zero =>
    intro as bs cs cin ha hb hc hq _ _ _ _
    rcases as with _ | ⟨a, as⟩; · simp at ha
    rcases bs with _ | ⟨b, bs⟩; · simp at hb
    rcases cs with _ | ⟨c, cs⟩; · simp at hc
    simp only [List.getD_cons_zero] at hq
    subst hq
    simp only [compareChain]
    exact zt_tail' _ _ _ (kx_zt_eraseCarry a b cin c)
  | succ k ih =>
    intro as bs cs cin ha hb hc hq hcin has hbs hcs
    rcases as with _ | ⟨a, as⟩; · simp at ha
    rcases bs with _ | ⟨b, bs⟩; · simp at hb
    rcases cs with _ | ⟨c, cs⟩; · simp at hc
    simp only [List.getD_cons_succ] at hq
    simp only [List.take_succ_cons, List.mem_cons, not_or] at has hbs hcs
    simp only [List.length_cons] at ha hb hc
    simp only [compareChain]
    apply zt_keep
    · apply zt_tail'
      exact ih as bs cs c (by omega) (by omega) (by omega) hq hcs.1 has.2 hbs.2 hcs.2
    · rw [eraseCarry_wires]
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨has.1, hbs.1, hcin, hcs.1⟩








