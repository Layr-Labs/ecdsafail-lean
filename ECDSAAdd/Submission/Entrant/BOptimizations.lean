/-! ## Shapes -/

theorem YF_XS : YF ++ StairExitLT24.XS = Rolling1588.exitFieldHosted := by
  simp only [YF, YE, YD, YC, YB, YA, StairExitLT24.XS, Rolling1588.exitFieldHosted,
    ParityField1591.program, ParityHostTransport5.program, FrontierEntry1591Field.hosted,
    Rolling1588.exitField, Rolling1588.exitHead, groups_false_101,
    StairSchedule.paritySetup, StairSchedule.hostedX,
    StairSchedule.fieldRename, StairSchedule.parityRename,
    headE, grpF, lowTail, liftF, rename_append', parity_X, List.append_assoc]


/-! ## A register can be given any value -/

theorem exists_reg : ∀ (r : List Wire), r.Nodup → ∀ (s : BasisState) (v : Nat),
    v < 2 ^ r.length → ∃ b : BasisState, regValue r b = v ∧ ∀ q, q ∉ r → b q = s q
  | [], _, s, v, hv => by
      refine ⟨s, ?_, fun _ _ => rfl⟩
      have : v = 0 := by simpa using hv
      rw [this]
      rfl
  | w :: ws, hn, s, v, hv => by
      have hw : w ∉ ws := (List.nodup_cons.mp hn).1
      have hv' : v / 2 < 2 ^ ws.length := by
        rw [List.length_cons, pow_succ] at hv
        omega
      obtain ⟨b0, hb0, off0⟩ := exists_reg ws (List.nodup_cons.mp hn).2 s (v / 2) hv'
      refine ⟨Function.update b0 w (decide (v % 2 = 1)), ?_, ?_⟩
      · have tail : regValue ws (Function.update b0 w (decide (v % 2 = 1))) = v / 2 := by
          rw [← hb0]
          apply regValue_congr
          intro q hq
          exact Function.update_of_ne (fun h => hw (by rw [← h]; exact hq)) _ _
        show (if Function.update b0 w (decide (v % 2 = 1)) w then 1 else 0) +
          2 * regValue ws (Function.update b0 w (decide (v % 2 = 1))) = v
        rw [tail, Function.update_self]
        by_cases h1 : v % 2 = 1
        · rw [decide_eq_true h1, if_pos rfl]
          omega
        · rw [decide_eq_false h1, if_neg (by decide)]
          omega
      · intro q hq
        have hq' : q ≠ w := fun h => hq (by rw [h]; exact List.mem_cons_self)
        rw [Function.update_of_ne hq']
        exact off0 q (fun h => hq (List.mem_cons_of_mem _ h))

theorem numerator_nodup : (wireBlock base 2056 256).Nodup := by
  unfold wireBlock
  exact (List.nodup_range' (step := 1)).map base_injective

