namespace ECDSAAdd.Entrant.StairS2Tail2

open ECDSAAdd Arithmetic Challenge Secp256k1 ControlledPointLayout MappedCompressed
  E1QubitPlacement E1ReflectedPlacement StairSquareHolesCore StairSquareEntryR StairS2Tail
open StairSiteAvoidance StairSiteEasy

attribute [local irreducible] ECDSAAdd.run ECDSAAdd.wires

/-- The two parts of `entryR L0 k` (level `UG`). -/
def cpR (k : Fp) : Program := renameProgram (pmapR L0) (E1Reflected.comparePart base (base 2400) k.val)
def tlR (k : Fp) : Program := renameProgram (pmapR L0) (E1Reflected.s2RTail base (base 2400) k.val)

theorem entryR_split (k : Fp) : entryR L0 k = cpR k ++ tlR k := by
  simp only [entryR, cpR, tlR, E1Reflected.s2_merged_split, renameProgram, List.map_append]

/-- The host of pool 724 inside the tail: the compare carry `base 300`. -/
def h300 : Wire := pmapR L0 (base 300)

theorem h300_eq : h300 = 4415 := by unfold h300; rw [pmapR_eqS]; decide +kernel
theorem base300_S : base 300 ∈ S :=
  List.mem_toFinset.mpr (E1Merge.in_mSites base (base 2400) 300 (by omega))


theorem frozen_entryRH_split (k : Fp) :
    entryRH k = hostRename entryPairs (cpR k) ++ hostRename entryPairs (tlR k) := by
  simp only [entryRH, entryR_split, hostRename_entryPairs_eq, renameProgram, List.map_append]

/-- **The new square tail (syntactic windows).** -/
def entryRHs (k : Fp) : Program :=
  hostRename entryPairs (cpR k) ++
    renameProgram (Equiv.swap hole724 h300) (hostRename entryPairs (tlR k))


theorem h300_ne : h300 ≠ hole725 ∧ h300 ≠ host512 ∧ h300 ≠ hole724 := by
  rw [h300_eq, hole724_eq, show hole725 = 4840 from StairHoleSupport.poolWire_eq 725 (by omega),
    show host512 = 4627 from StairHoleSupport.poolWire_eq 512 (by omega)]
  decide


theorem inj_on (P : Program) (hP : wires P ⊆ S) (i : Nat) (hi : base i ∈ S) :
    ∀ q ∈ wires P, pmapR L0 q = pmapR L0 (base i) → q = base i :=
  fun q hq e => pmap_inj L0 Baselines.layout_widths Baselines.layout_nodup q (hP hq) (base i) hi e

theorem cp_S (k : Fp) : wires (E1Reflected.comparePart base (base 2400) k.val) ⊆ S := by
  have h := mergedR_S k.val
  rw [E1Reflected.s2_merged_split, wires_append] at h
  exact Finset.union_subset_left h

theorem tl_S (k : Fp) : wires (E1Reflected.s2RTail base (base 2400) k.val) ⊆ S := by
  have h := mergedR_S k.val
  rw [E1Reflected.s2_merged_split, wires_append] at h
  exact Finset.union_subset_right h

/-! ## Window facts -/

/-- Window start: the comparison part resets the host. -/
theorem cpR_zt300 (k : Fp) (b : Bool) :
    StairField13V3Clean.zt h300 b (hostRename entryPairs (cpR k)) = true := by
  rw [hostRename_entryPairs_eq, StairField13V3Clean.zt_rename_fixed _ (Equiv.swap _ _).injective _
    (swap725_fix _ h300_ne.1 h300_ne.2.1)]
  unfold cpR h300
  rw [StairS2.zt_rename_on _ _ _ _ (inj_on _ (cp_S k) 300 base300_S)]
  exact E1Reflected.s2_comparePart_zt300 _ _

/-- The comparison part never touches pool 724. -/
theorem cpR_free724 (k : Fp) : hole724 ∉ wires (hostRename entryPairs (cpR k)) := by
  rw [hostRename_entryPairs_eq, renameProgram_support]
  intro h
  obtain ⟨y, hy, e⟩ := Finset.mem_image.mp h
  have hy' : y = hole724 := by
    by_cases h1 : y = hole725
    · subst h1; rw [Equiv.swap_apply_left] at e
      exact absurd e.symm (by rw [hole724_eq, show host512 = 4627 from StairHoleSupport.poolWire_eq 512 (by omega)]; decide)
    · by_cases h2 : y = host512
      · subst h2; rw [Equiv.swap_apply_right] at e
        exact absurd e.symm hole724_ne.1
      · rwa [Equiv.swap_apply_of_ne_of_ne h1 h2] at e
  subst hy'
  unfold cpR at hy
  rw [renameProgram_support] at hy
  obtain ⟨z, hz, ez⟩ := Finset.mem_image.mp hy
  rw [← pmapR_722] at ez
  have := inj_on _ (cp_S k) 722 base722_S z hz ez
  subst this
  exact E1Reflected.s2_comparePart_free 722 (by omega) (by omega) (by omega) (by omega) (by omega) _ hz

/-- Window end: the tail resets pool 724. -/
theorem tlR_zt724 (k : Fp) (b : Bool) :
    StairField13V3Clean.zt hole724 b (hostRename entryPairs (tlR k)) = true := by
  rw [hostRename_entryPairs_eq, StairField13V3Clean.zt_rename_fixed _ (Equiv.swap _ _).injective _
    (swap725_fix _ hole724_ne.1 hole724_ne.2)]
  unfold tlR
  rw [← pmapR_722, StairS2.zt_rename_on _ _ _ _ (inj_on _ (tl_S k) 722 base722_S)]
  exact E1Reflected.s2RTail_zt722 _ _


/-- The host is not touched by the (frozen, 725-hosted) tail. -/
theorem tl_free300 (k : Fp) : h300 ∉ wires (hostRename entryPairs (tlR k)) := by
  rw [hostRename_entryPairs_eq, renameProgram_support]
  intro h
  obtain ⟨y, hy, e⟩ := Finset.mem_image.mp h
  have hy' : y = h300 := by
    by_cases h1 : y = hole725
    · subst h1; rw [Equiv.swap_apply_left] at e; exact absurd e.symm h300_ne.2.1
    · by_cases h2 : y = host512
      · subst h2; rw [Equiv.swap_apply_right] at e; exact absurd e.symm h300_ne.1
      · rwa [Equiv.swap_apply_of_ne_of_ne h1 h2] at e
  subst hy'
  unfold tlR at hy
  rw [renameProgram_support] at hy
  obtain ⟨z, hz, ez⟩ := Finset.mem_image.mp hy
  have := inj_on _ (tl_S k) 300 base300_S z hz ez
  subst this
  exact base300_notin_tSites (List.mem_toFinset.mp (E1Reflected.s2RTail_tight _ _ _ hz))

/-! ## The square-tail interface (TailOK), for the semantic square route -/

theorem entryRHs_run_eq (k : Fp) (s : State) (m : List Bool)
    (hc : regValue L0.dialogPool s.basis = 0) :
    run (entryRHs k) m s = run (entryRH k) m s := by
  rw [frozen_entryRH_split]
  unfold entryRHs
  rw [run_append, run_append]
  apply StairS2.swap_run_eq _ _ _ _ _ (tl_free300 k)
  · rw [run_preserves_outside _ _ _ _ (cpR_free724 k)]
    exact (regValue_zero _ _).mp hc _ hole724_pool
  · exact StairS2.zero_of_zt _ _ (by
      have := cpR_zt300 k false; exact this) _ _
