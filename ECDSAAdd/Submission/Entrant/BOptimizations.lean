  · -- base 723 .. 764: never written, zero in the input
    have hr : q ∈ rolesL := List.mem_of_mem_drop hd
    refine zt_sound q _ true m s (exitPhase_keeps hr) (fun _ => ?_)
    have win := inWin_of_role hr
