/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitFirst_at_StairSideA` -/
section Merge_StairField2V3ExitFirst_at_StairSideA

/-!
# First-row round trip `FU ∘ FP = id` (LT24)

`FP = phaseHost (xRelabel orient 425 · sig 425 packFirst 425 · phaseBMove ·
phaseRelabel pack 87)` (LT43f order) and `FU` is its exact mirror.  `firstTrip` reduces the
first-row round trip to four primitive trips on the `phaseHost`-pulled state;
three are discharged here (b-rail moves and orientation unconditionally, the
packet from legality) and the codec one from `CodecInput` (field 1).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3ExitAlgebra StairField2V3ExitRowTrips StairPhysicalLayout

def relabelInv (q : Wire) : Wire := fPlaceInv (Rolling1588Lifetime.phaseHost.symm q)

theorem relabel_inv (q : Wire) : phaseRelabel (relabelInv q) = q := by
  show Rolling1588Lifetime.phaseHost (fPlace (fPlaceInv (Rolling1588Lifetime.phaseHost.symm q))) = q
  rw [fPlace_inv, Equiv.apply_symm_apply]

theorem relabelInv_relabel (q : Wire) : relabelInv (phaseRelabel q) = q := by
  show fPlaceInv (Rolling1588Lifetime.phaseHost.symm (Rolling1588Lifetime.phaseHost (fPlace q))) = q
  rw [Equiv.symm_apply_apply, fPlaceInv_fPlace]

/-- LT43f: inverse of the x-word relabelling of the repaired first-row orientation. -/
def xRelabelInv (q : Wire) : Wire := relabelInv (StairV3Primitives.xSwap q)

theorem xRelabel_inv (q : Wire) : StairV3Primitives.xRelabel (xRelabelInv q) = q := by
  show StairV3Primitives.xSwap (phaseRelabel (relabelInv (StairV3Primitives.xSwap q))) = q
  rw [relabel_inv, StairV3Primitives.xSwap_invol]

theorem xRelabelInv_relabel (q : Wire) : xRelabelInv (StairV3Primitives.xRelabel q) = q := by
  show relabelInv (StairV3Primitives.xSwap (StairV3Primitives.xSwap (phaseRelabel q))) = q
  rw [StairV3Primitives.xSwap_invol, relabelInv_relabel]

def firstPieces : List (Program × Program) :=
  [(renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425),
      renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)),
    (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425),
      renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)),
    (phaseBMove, StairPhysicalPhase.phaseBReturn),
    (renameProgram phaseRelabel (StairPhysicalPrimitives.pack 87),
      renameProgram phaseRelabel (StairPhysicalPrimitives.unpack 87))]




/-! ## The primitive trips of the first row -/

theorem phaseB_trip_any (t : State) (c a : List Bool) :
    run StairPhysicalPhase.phaseBReturn a (run phaseBMove c t) = t := by
  rw [run_noMeas_any _ phaseBMove_counts.2, run_noMeas_any _ StairPhysicalPhase.phaseBReturn_counts.2]
  exact phaseB_trip t

theorem orient425_trip (t : State) (c a : List Bool) :
    run (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) a
      (run (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) c t) = t :=
  rename_trip StairV3Primitives.xRelabel xRelabelInv xRelabel_inv xRelabelInv_relabel _ _ t
    (fun c' a' => orient_trip 425 (by simp [rowLetters]) _ a' c') c a

theorem pack87_trip (u v : Nat) (sigma : Bool)
    (spec : StairCodec.FunctionalSpec (physicalLayout 87) 87)
    (domain : StairCodec.CodecDomain 87 u v sigma) (t : State)
    (input : StairCodec.CodecInput (physicalLayout 87) 87 u v sigma
      (run (StairPhysicalPrimitives.signExt 87) [] (pullState phaseRelabel t)).basis)
    (c a : List Bool) :
    run (renameProgram phaseRelabel (StairPhysicalPrimitives.unpack 87)) a
      (run (renameProgram phaseRelabel (StairPhysicalPrimitives.pack 87)) c t) = t :=
  rename_trip phaseRelabel relabelInv relabel_inv relabelInv_relabel _ _ t
    (fun c' a' => pack_trip 87 (by simp [budgets]) u v sigma spec domain _ c' a' input) c a

theorem packet425_trip (hn : (skywalkPoolWires base).Nodup) (t : State)
    (legal : MeasuredCodec5.legalAt (History5.historyMap base 420)
      (pullState (OB5.sig 425) t).basis) (c a : List Bool) :
    run (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)) a
      (run (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) c t) = t :=
  packet_trip 425 (by omega) (by omega) (by omega) hn t legal c a

/-- The first-row trip chain from its two semantic preconditions (LT43f order:
orientation on the x word, packet 84, b-rail move, codec). -/
theorem firstPieces_chain (hn : (skywalkPoolWires base).Nodup) (x0 : State)
    (legal : ∀ c1, MeasuredCodec5.legalAt (History5.historyMap base 420)
      (pullState (OB5.sig 425)
        (run (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) c1
          x0)).basis)
    (code : ∀ c1 c2 c3, ∃ u v sigma, StairCodec.CodecDomain 87 u v sigma ∧
      StairCodec.CodecInput (physicalLayout 87) 87 u v sigma
        (run (StairPhysicalPrimitives.signExt 87) [] (pullState phaseRelabel
          (run phaseBMove c3
            (run (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) c2
              (run (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) c1
                x0))))).basis)
    (spec : StairCodec.FunctionalSpec (physicalLayout 87) 87) :
    TripChain firstPieces x0 := by
  refine ⟨orient425_trip x0, fun c1 => ⟨packet425_trip hn _ (legal c1), fun c2 =>
    ⟨phaseB_trip_any _, fun c3 => ⟨?_, fun _ => trivial⟩⟩⟩⟩
  intro c a
  obtain ⟨u, v, sigma, dom, inp⟩ := code c1 c2 c3
  exact pack87_trip u v sigma spec dom _ inp c a




/-! ## Local (virtual-state) form of the trips

The moved maps send old letters to shadow labels that no moved program touches;
a genuine `Stage` therefore only holds on a *virtual* state that agrees with the
physical one on the programs' wires.  `trip_of_local` transfers a round trip
from such a virtual state. -/

theorem trip_of_local (Fp Gp : Program) (t t' : State)
    (hph : t.phase = t'.phase)
    (hagree : ∀ q, q ∈ wires Fp ∨ q ∈ wires Gp → t.basis q = t'.basis q)
    (htrip : ∀ c a, run Gp a (run Fp c t') = t') :
    ∀ c a, run Gp a (run Fp c t) = t := by
  intro c a
  have incF := run_local_increment Fp t t' c (fun q hq => hagree q (Or.inl hq))
  have agreeG : ∀ q ∈ wires Gp, (run Fp c t).basis q = (run Fp c t').basis q := by
    intro q hq
    by_cases hF : q ∈ wires Fp
    · exact incF.2 q hF
    · rw [run_preserves_outside Fp c t q hF, run_preserves_outside Fp c t' q hF]
      exact hagree q (Or.inr hq)
  have incG := run_local_increment Gp (run Fp c t) (run Fp c t') a agreeG
  have tr := htrip c a
  apply State.extensionality
  · have h1 := incF.1
    have h2 := incG.1
    rw [tr] at h2
    rw [hph] at h1 ⊢
    revert h1 h2
    cases (run Fp c t).phase <;> cases (run Fp c t').phase <;> cases t'.phase <;>
      cases (run Gp a (run Fp c t)).phase <;> simp
  · funext q
    by_cases hG : q ∈ wires Gp
    · rw [incG.2 q hG, tr]
      exact (hagree q (Or.inr hG)).symm
    · rw [run_preserves_outside Gp a _ q hG]
      by_cases hF : q ∈ wires Fp
      · rw [incF.2 q hF, ← run_preserves_outside Gp a (run Fp c t') q hG, tr]
        exact (hagree q (Or.inl hF)).symm
      · exact run_preserves_outside Fp c t q hF


end ECDSAAdd.Entrant.StairExitLT24

