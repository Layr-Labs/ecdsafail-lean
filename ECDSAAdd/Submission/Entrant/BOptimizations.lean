/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCallerCheck_at_StairSideA` -/
section Merge_StairCallerCheck_at_StairSideA

/-!
# A Boolean support checker for the caller domain (LT11, fields 8 and 9)

`allCaller P = true` says that every wire of every instruction of `P`
(including both correction lists of every measurement) is a caller-domain
label: `base i` with `i < 2314`, or one of the four scalar labels
`base 2400, 2409, 2410, 2411`.  It is a plain structural recursion with
`Nat` comparisons, so `decide +kernel` evaluates it on a concrete program.

`allCaller_sound` turns it into `wires P ⊆ callerDomain`, the support premise
`EntrySupportD` / `ExitSupportD` of field 8 (and, by `placed_of_caller`, the
placed-domain premise of field 9).

The structural rules (`allCaller_append`, `allCaller_rename`) and the
`PreservesCaller` facts for the wrapper renamings (`phaseHost`,
`Prefix1590.borrow`, `HostOB5.hostSwap`, the parity swap, `OB5.sig i`) let a
kernel be checked component by component.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## Numeric membership -/

/-- Numeric form of caller-domain membership (`base i = i + 16`). -/
abbrev CallerNatP (q : Nat) : Prop :=
  (16 ≤ q ∧ q < 2330) ∨ q = 2416 ∨ q = 2425 ∨ q = 2426 ∨ q = 2427

def callerNat (q : Nat) : Bool := decide (CallerNatP q)

theorem callerNat_iff (q : Nat) : callerNat q = true ↔ CallerNatP q := by
  unfold callerNat
  exact decide_eq_true_iff

private theorem nat_low_helper (q : Nat) (h1 : 16 ≤ q) (h2 : q < 2330) :
    q - 16 + 16 = q ∧ q - 16 < 2314 := ⟨by omega, by omega⟩

theorem callerNat_sound (q : Wire) (h : callerNat q = true) : q ∈ callerDomain := by
  have hq : CallerNatP q := (callerNat_iff q).mp h
  rcases hq with ⟨h1, h2⟩ | h3 | h3 | h3 | h3
  · have ar := nat_low_helper q h1 h2
    have e : base (q - 16) = q := ar.1
    rw [← e]
    exact base_mem_caller (q - 16) (Or.inl ar.2)
  · subst h3
    exact base_mem_caller 2400 (by decide)
  · subst h3
    exact base_mem_caller 2409 (by decide)
  · subst h3
    exact base_mem_caller 2410 (by decide)
  · subst h3
    exact base_mem_caller 2411 (by decide)

theorem callerNat_complete (q : Wire) (h : q ∈ callerDomain) : callerNat q = true := by
  obtain ⟨i, hi, rfl⟩ := caller_index q h
  rw [callerNat_iff]
  show (16 ≤ i + 16 ∧ i + 16 < 2330) ∨ i + 16 = 2416 ∨ i + 16 = 2425 ∨
    i + 16 = 2426 ∨ i + 16 = 2427
  rcases hi with h1 | h1 | h1 | h1 | h1
  · have a : 16 ≤ i + 16 := by omega
    have b : i + 16 < 2330 := by omega
    exact Or.inl ⟨a, b⟩
  · subst h1
    exact Or.inr (Or.inl rfl)
  · subst h1
    exact Or.inr (Or.inr (Or.inl rfl))
  · subst h1
    exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · subst h1
    exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))

/-! ## The checker -/

def corrCaller : List Correction → Bool
  | [] => true
  | .Z t :: cs => callerNat t && corrCaller cs
  | .CZ a b :: cs => callerNat a && callerNat b && corrCaller cs

def instrCaller : Instr → Bool
  | .X t => callerNat t
  | .CX c t => callerNat c && callerNat t
  | .CCX a b t => callerNat a && callerNat b && callerNat t
  | .measureX t c₀ c₁ => callerNat t && corrCaller c₀ && corrCaller c₁

def allCaller : Program → Bool
  | [] => true
  | i :: p => instrCaller i && allCaller p

theorem corrCaller_sound (cs : List Correction) (h : corrCaller cs = true) :
    correctionWires cs ⊆ callerDomain := by
  induction cs with
  | nil => simp [correctionWires]
  | cons c cs ih =>
    cases c with
    | Z t =>
      simp only [corrCaller, Bool.and_eq_true] at h
      intro q hq
      simp only [correctionWires, Finset.mem_union, Finset.mem_singleton] at hq
      rcases hq with rfl | hq
      · exact callerNat_sound _ h.1
      · exact ih h.2 hq
    | CZ a b =>
      simp only [corrCaller, Bool.and_eq_true] at h
      intro q hq
      simp only [correctionWires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at hq
      rcases hq with (rfl | rfl) | hq
      · exact callerNat_sound _ h.1.1
      · exact callerNat_sound _ h.1.2
      · exact ih h.2 hq

theorem instrCaller_sound (i : Instr) (h : instrCaller i = true) :
    i.wires ⊆ callerDomain := by
  intro q hq
  cases i with
  | X t =>
    simp only [Instr.wires, Finset.mem_singleton] at hq
    subst hq
    exact callerNat_sound _ h
  | CX c t =>
    simp only [instrCaller, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact callerNat_sound _ h.1
    · exact callerNat_sound _ h.2
  | CCX a b t =>
    simp only [instrCaller, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl | rfl
    · exact callerNat_sound _ h.1.1
    · exact callerNat_sound _ h.1.2
    · exact callerNat_sound _ h.2
  | measureX t c₀ c₁ =>
    simp only [instrCaller, Bool.and_eq_true] at h
    simp only [Instr.wires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with (rfl | h0) | h1
    · exact callerNat_sound _ h.1.1
    · exact corrCaller_sound c₀ h.1.2 h0
    · exact corrCaller_sound c₁ h.2 h1

/-- Soundness: a checked program is supported in the caller domain. -/
theorem allCaller_sound (P : Program) (h : allCaller P = true) : wires P ⊆ callerDomain := by
  induction P with
  | nil => simp [wires]
  | cons i p ih =>
    simp only [allCaller, Bool.and_eq_true] at h
    intro q hq
    simp only [wires, Finset.mem_union] at hq
    rcases hq with hq | hq
    · exact instrCaller_sound i h.1 hq
    · exact ih h.2 hq

/-! ## Structural rules -/


theorem wires_sub_of_parts (P Q : Program) (hP : wires P ⊆ callerDomain)
    (hQ : wires Q ⊆ callerDomain) : wires (P ++ Q) ⊆ callerDomain := by
  rw [wires_append]
  exact Finset.union_subset hP hQ


theorem rename_caller (f : Wire → Wire) (hf : PreservesCaller f) (P : Program)
    (hP : wires P ⊆ callerDomain) : wires (renameProgram f P) ⊆ callerDomain := by
  rw [renameProgram_support]
  intro q hq
  obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hq
  exact hf r (hP hr)



theorem preserves_perm_trans (e₁ e₂ : Equiv.Perm Wire) (h₁ : PreservesCaller e₁)
    (h₂ : PreservesCaller e₂) : PreservesCaller (e₁.trans e₂) :=
  fun q hq => h₂ _ (h₁ q hq)

/-! ## The wrapper renamings preserve the caller domain -/

theorem preserves_phaseHost : PreservesCaller Rolling1588Lifetime.phaseHost := by
  unfold Rolling1588Lifetime.phaseHost
  exact preserves_perm_trans _ _
    (preserves_swap _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega)))
    (preserves_perm_trans _ _
      (preserves_swap _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega)))
      (preserves_swap _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega))))




theorem sig_values (i : Nat) (hi : i ≤ 511) (q : Nat) (h1 : 16 ≤ q) (h2 : q < 2330) :
    16 ≤ OB5.sig i q ∧ OB5.sig i q < 2330 := by
  unfold OB5.sig
  by_cases hc : (1301 ≤ q ∧ q ≤ 1044+i) ∨ (2069 ≤ q+i ∧ q ≤ 1812)
  · rw [if_pos hc]
    rcases hc with ⟨c1, c2⟩ | ⟨c1, c2⟩
    · have a : 16 ≤ 3113 - q := by omega
      have b : 3113 - q < 2330 := by omega
      exact ⟨a, b⟩
    · have a : 16 ≤ 3113 - q := by omega
      have b : 3113 - q < 2330 := by omega
      exact ⟨a, b⟩
  · rw [if_neg hc]
    exact ⟨h1, h2⟩

theorem sig_fixed (i : Nat) (hi : i ≤ 511) (q : Nat) (h : 2330 ≤ q) : OB5.sig i q = q := by
  unfold OB5.sig
  have hc : ¬((1301 ≤ q ∧ q ≤ 1044+i) ∨ (2069 ≤ q+i ∧ q ≤ 1812)) := by
    intro hc
    rcases hc with ⟨c1, c2⟩ | ⟨c1, c2⟩ <;> omega
  rw [if_neg hc]

theorem preserves_sig (i : Nat) (hi : i ≤ 511) : PreservesCaller (OB5.sig i) := by
  intro q hq
  have h : CallerNatP q := (callerNat_iff q).mp (callerNat_complete q hq)
  apply callerNat_sound
  rw [callerNat_iff]
  rcases h with ⟨h1, h2⟩ | h3 | h3 | h3 | h3
  · exact Or.inl (sig_values i hi q h1 h2)
  · subst h3
    rw [sig_fixed i hi 2416 (by decide)]
    exact Or.inr (Or.inl rfl)
  · subst h3
    rw [sig_fixed i hi 2425 (by decide)]
    exact Or.inr (Or.inr (Or.inl rfl))
  · subst h3
    rw [sig_fixed i hi 2426 (by decide)]
    exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · subst h3
    rw [sig_fixed i hi 2427 (by decide)]
    exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))

/-- The composite field-tail placement is caller-preserving. -/
theorem fieldRename_caller (P : Program) (hP : wires P ⊆ callerDomain) :
    wires (StairSchedule.fieldRename P) ⊆ callerDomain := by
  unfold StairSchedule.fieldRename StairSchedule.parityRename
  exact rename_caller _ preserves_paritySwap _ (rename_caller _ preserves_hostSwap _ hP)

theorem borrow_caller (P : Program) (hP : wires P ⊆ callerDomain) :
    wires (renameProgram Prefix1590.borrow P) ⊆ callerDomain :=
  rename_caller _ preserves_borrow P hP

theorem phaseHost_caller (P : Program) (hP : wires P ⊆ callerDomain) :
    wires (renameProgram Rolling1588Lifetime.phaseHost P) ⊆ callerDomain :=
  rename_caller _ preserves_phaseHost P hP

end ECDSAAdd.Entrant.StairSemanticFinal

end
end Merge_StairCallerCheck_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCallerParts_at_StairSideA` -/
section Merge_StairCallerParts_at_StairSideA

/-!
# Caller-domain support of the record pieces of the hosted kernels (LT11)

Every hosted kernel of the staircase (current CANON and the k = 44 re-plan)
is assembled from (i) the placed checkpoint primitives (LT13:
`StairPhysicalPrimitives.physicalPrimitives_caller`), (ii) hosted/loaned
groups and boundary components, and (iii) unchanged record pieces: tick
ranges of the record walk, the six-tick bridge, the terminal reverse bridge,
packet writes/reads at checkpoint ticks, the native first tick, the clears and
the scalar glue.  This module proves (iii).

Method.  The record kernels `InverseFiveEntry23.entryKernel15` and
`ParityXExitInverse23Kernel.kernelXN k` have support in
`OB5Support.logicalSites ⊆ callerDomain` (record theorems `entry_support530`,
`kernelXN_support`).  Their phases contain the record pieces as literal
append factors (after the tick-range split lemmas below).  Since
`phaseHost` is a permutation whose inverse preserves the caller domain, the
pieces' own labels are caller labels (`own_of_renamed`); every new wrapper
(`phaseHost`, `Prefix1590.borrow`, `fieldRename`, `OB5.sig i`) preserves the
caller domain (`StairCallerCheck`), so the pieces stay inside it wherever the
re-planned schedule places them.  Small field pieces are checked by
`decide +kernel` on `allCaller`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSemanticFinal

open ECDSAAdd Arithmetic Challenge
open MappedCompressed

/-! ## Generic support tools -/

theorem sub_left (P Q : Program) : wires P ⊆ wires (P ++ Q) := by
  rw [wires_append]
  exact Finset.subset_union_left

theorem sub_right (P Q : Program) : wires Q ⊆ wires (P ++ Q) := by
  rw [wires_append]
  exact Finset.subset_union_right


theorem preserves_swap_symm (a b : Wire) (ha : a ∈ callerDomain) (hb : b ∈ callerDomain) :
    PreservesCaller (Equiv.swap a b).symm := by
  rw [Equiv.symm_swap]
  exact preserves_swap a b ha hb

theorem preserves_symm_trans (e₁ e₂ : Equiv.Perm Wire) (h₁ : PreservesCaller e₁.symm)
    (h₂ : PreservesCaller e₂.symm) : PreservesCaller (e₁.trans e₂).symm := by
  intro q hq
  rw [Equiv.symm_trans_apply]
  exact h₁ _ (h₂ q hq)

theorem preserves_phaseHost_symm : PreservesCaller Rolling1588Lifetime.phaseHost.symm := by
  unfold Rolling1588Lifetime.phaseHost
  exact preserves_symm_trans _ _
    (preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega)))
    (preserves_symm_trans _ _
      (preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega)))
      (preserves_swap_symm _ _ (base_mem_caller _ (by omega)) (base_mem_caller _ (by omega))))

/-- Own labels from renamed labels, for a permutation whose inverse preserves the
caller domain. -/
theorem own_of_renamed (e : Equiv.Perm Wire) (he : PreservesCaller e.symm) (P : Program)
    (h : wires (renameProgram e P) ⊆ callerDomain) : wires P ⊆ callerDomain := by
  intro q hq
  have img : e q ∈ wires (renameProgram e P) := by
    rw [renameProgram_support]
    exact Finset.mem_image_of_mem _ hq
  have back := he _ (h img)
  simpa only [Equiv.symm_apply_apply] using back

theorem own_of_phaseHost (P : Program)
    (h : wires (renameProgram Rolling1588Lifetime.phaseHost P) ⊆ callerDomain) :
    wires P ⊆ callerDomain :=
  own_of_renamed _ preserves_phaseHost_symm P h

/-! ## Tick-range split lemmas -/


theorem reverse_split (isA : Bool) (m : Nat) : ∀ i n : Nat,
    Rolling1588.reverse isA i (m + n) =
      Rolling1588.reverse isA (i + m) n ++ Rolling1588.reverse isA i m := by
  induction m with
  | zero =>
    intro i n
    simp [Rolling1588.reverse]
  | succ m ih =>
    intro i n
    rw [Nat.succ_add]
    simp only [Rolling1588.reverse]
    rw [ih (i + 1) n, List.append_assoc, show i + 1 + m = i + (m + 1) by omega]

/-! ## The record phases are caller-supported in their own coordinates -/








