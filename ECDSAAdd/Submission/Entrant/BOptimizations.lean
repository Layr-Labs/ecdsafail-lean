/-! ## First packets -/

theorem hist_not_firstCodec (t : Nat) (ht : t < 510) (hne : t / 5 ≠ 0)
    (f : Fin 10 → Wire) (hf : f = History5.historyMap base 0)
    (P : Program) (support : wires P ⊆ Finset.univ.image f) :
    base (1028 + t) ∉ wires P := by
  intro used
  obtain ⟨q, _, hq⟩ := Finset.mem_image.mp (support used)
  subst hf
  have bound := q.isLt
  have hq' : base (History5.historyId 0 q) = base (1028 + t) := hq
  have hv := base_injective hq'
  unfold History5.historyId at hv
  split at hv <;> omega

/-- The placed first packet touches no non-hole history letter of packets
`1 .. 101`. -/
theorem firstPacket_sLetter_free (divide : Bool) (t : Nat) (ht : t < 510)
    (hne : t / 5 ≠ 0) (h2 : t % 5 ≠ 2) (h4 : t % 5 ≠ 4) :
    StairPhysicalLayout.sLetter t ∉ wires (Rolling1588.placedFirstPacket divide) := by
  intro used
  change OB5.sig 511 (base (1028 + t)) ∈ wires (renameProgram (OB5.sig 511)
    (Rolling1588.firstPacket divide)) at used
  rw [renameProgram_support] at used
  obtain ⟨x, hx, eq⟩ := Finset.mem_image.mp used
  have sx : x = base (1028 + t) := OB5.sig_injective 511 (by omega) eq
  subst sx
  change base (1028 + t) ∈ wires (renameProgram (shifted (Placement5.pi 0))
    (Rolling1588.firstCore divide)) at hx
  rw [renameProgram_support] at hx
  obtain ⟨y, hy, eq2⟩ := Finset.mem_image.mp hx
  have fixedPi : shifted (Placement5.pi 0) (base (1028 + t)) = base (1028 + t) := by
    rw [shifted_base, Placement5.pi_outside 0 (1028 + t) (by decide) (by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega)]
  have sy : y = base (1028 + t) :=
    (shifted (Placement5.pi 0)).injective (eq2.trans fixedPi.symm)
  subst sy
  have model := Rolling1588First.first_wires_of_mem _ _
    (Rolling1588First.firstCore_mem divide) hy
  rw [Rolling1588.firstCoreModel, wires_append, wires_append, Finset.mem_union,
    Finset.mem_union] at model
  rcases model with (dec | body) | enc
  · apply hist_not_firstCodec t ht hne _ rfl Prefix1590.firstDecode _ dec
    rw [show Prefix1590.firstDecode =
        ParityCodec5New.decodeAtFirst (History5.historyMap base 0) from rfl,
      (ParityCodec5New.first_mapped_support _).2]
    exact (ParityCodec5New.supportAt _).2
  · exact hist_not_groupRead t 0 ht (by decide) hne
      (Rolling1588.firstBorrowedBody_read_support divide body)
  · apply hist_not_firstCodec t ht hne _ rfl Prefix1590.firstEncode _ enc
    rw [show Prefix1590.firstEncode =
        ParityCodec5New.encodeAtFirst (History5.historyMap base 0) from rfl,
      (ParityCodec5New.first_mapped_support _).1]
    exact (ParityCodec5New.supportAt _).1

/-- The concrete first-packet hosts (`hosts 87`) are fresh for both placed
first packets. -/
theorem hostPlan_firstPacket_fresh (divide : Bool) :
    ∀ q ∈ StairConcreteAssembly.hostPlan.firstPacket divide,
      q ∉ wires (Rolling1588.placedFirstPacket divide) := by
  intro q hq
  obtain ⟨hl, hle⟩ := budgets_start 87 (by decide)
  obtain ⟨t, rfl, ht, h2, h4, hs⟩ := hosts_ticks 87 hl hle q hq
  have s85 : StairPhysicalLayout.startFor 87 / 5 = 85 := by decide
  exact firstPacket_sLetter_free divide t ht (by omega) h2 h4

