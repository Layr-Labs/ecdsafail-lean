/-! ## Padding the measurement record and the converse of `after_append` -/

theorem run_pad : ∀ (P : Program) (m : List Bool) (k : Nat) (s : State),
    run P (m ++ List.replicate k false) s = run P m s := by
  intro P
  induction P with
  | nil => intro m k s; simp only [run]
  | cons i p ih =>
    intro m k s
    cases i with
    | X t => simp only [run]; exact ih m k _
    | CX c t => simp only [run]; exact ih m k _
    | CCX a b t => simp only [run]; exact ih m k _
    | measureX t c0 c1 =>
      cases m with
      | nil =>
        cases k with
        | zero => rfl
        | succ k =>
          simp only [run, List.nil_append, List.replicate_succ, List.headD_cons, List.tail_cons,
            List.headD_nil]
          have := ih [] k (measureAndCorrect t c0 c1 false s)
          simpa using this
      | cons x m =>
        simp only [run, List.cons_append, List.headD_cons, List.tail_cons]
        exact ih m k _

theorem after_of_after {R : State → Prop} {P Q : Program} {t : State}
    (h : After (After R P) Q t) : After R (P ++ Q) t := by
  obtain ⟨s, n, ⟨u, m, hu, rfl⟩, rfl⟩ := h
  refine ⟨u, (m ++ List.replicate (measurementCount P) false).take (measurementCount P) ++ n, hu, ?_⟩
  have hl : ((m ++ List.replicate (measurementCount P) false).take (measurementCount P)).length =
      measurementCount P := by
    rw [List.length_take, List.length_append, List.length_replicate]; omega
  rw [run_append, List.take_left' hl, List.drop_left' hl, run_take, run_pad]

