  have q1c : wires (LowZero18Diagonal.clearC (LowZero18LowK.iregs L ext src dst))⊆
      (LowZero18LowK.iregs L ext src dst).all.toFinset := by
    simp only [LowZero18Diagonal.clearC,RawClearSquare.clearC,wires_append]
