 let mg:=d2.take (measurementCount (borrowGeneric cx cy))
 let ml:=d3.take (measurementCount loadB)
 have h:=middle_sequence hc b R s me ma mg ml d4 hx hy hb hf hg he hd hz hpk
 dsimp only at h
