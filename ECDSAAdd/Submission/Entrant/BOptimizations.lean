private theorem tailProgramLoan44_slots_le (L : BalancedCircuit.Layout) (hw : L.Widths) :
    gateSlots (tailProgramLoan44 L) ≤ gateSlots (InverseTailC.program L) + 1672 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have len := ctlLayers_length L.ylow L.low (L.carry.take 255) L.one
    (hw.2.1.trans w.1.symm) (by simp [List.length_take, hw.2.2, w.1])
  have ctl := StairSlotsLib.emitLoan_slots_le 44 roles44
    (ctlLayers L.ylow L.low (L.carry.take 255) L.one)
    (ctlTop (some L.sign) L.parity L.ylow L.low (L.carry.take 255) L.one)
    (by rw [len]; simp [List.length_take, hw.2.2])
    (ctlLayers_slotUnit _ _ _ _)
  rw [← compareChain_as_ctlSweep] at ctl
  have add := StairSlotsLib.mappedAddLoan_slots_le 44 roles44 (mappedRead L.y false) L.r
    (L.carry.take 255) L.sign (by simp [mappedRead_length, w.2.2.1, w.2.1])
    (by simp [List.length_take, hw.2.2, w.2.1]) (by simp [List.length_take, hw.2.2])
  have sub := StairSlotsLib.mappedSubLoan_some_slots_le 44 roles44 L.parity 256 p L.r
    (L.carry.take 255) L.one (by simp [mappedConstant_length, w.2.1])
    (by simp [List.length_take, hw.2.2, w.2.1]) (by simp [List.length_take, hw.2.2])
  simp only [tailProgramLoan44, decisionLoan44, compareLtLoan44, rawLoan44, signedAddLoan44,
    correctionLoan44, ctlLoan, InverseTailC.program, InverseTailC.decision, InverseTailC.raw,
    InverseTailC.correction, compareLt, signedAdd, addInPlace_eq_mapped,
