theorem loopA_eU_free(hl:List Wire)(hsub:hl.Sublist holes):ControlLoan1589BFFold.eU ReorderedAFixed.L∉wires (loopA hl):=
 fun h=>KnownProgramActual.a_body_eU_free (loopA_support hl hsub h)

