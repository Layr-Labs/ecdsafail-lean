  refine ⟨by rw [(renameProgram_counts _ _).2]; exact k.1, fun s hs m => ?_⟩
  rw [StairS2.swap_run_eq a h Q m _ free (za s hs) (zh s hs) (ra _ _)]
  exact k.2 s hs m


