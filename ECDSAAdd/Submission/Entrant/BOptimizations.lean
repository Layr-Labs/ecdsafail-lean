/-- A swap window of `a ↔ h` inside a segment whose tracking permutations fix `a` and `h`. -/
theorem segReplay_window_on {R : State → Prop} {τ₀ τ₁ : Equiv.Perm Wire} {P' P : Program}
    (k : SegReplay R τ₀ τ₁ P' P) (a h : Wire)
    (f0a : τ₀ a = a) (f0h : τ₀ h = h) (f1a : τ₁ a = a) (f1h : τ₁ h = h)
    (za : ZeroOn R a) (zh : ZeroOn R h)
    (za' : ZeroOn (After R P) a) (zh' : ZeroOn (After R P) h) :
    SegReplay R τ₀ τ₁ (renameProgram (Equiv.swap a h) P') P := by
  refine ⟨by rw [(renameProgram_counts _ _).2]; exact k.1, fun s hs m => ?_⟩
  have s0a : (pullState τ₀.symm s).basis a = false := by
    show s.basis (τ₀.symm a) = false
    rw [show τ₀.symm a = a from by rw [Equiv.symm_apply_eq]; exact f0a.symm]
    exact za s hs
  have s0h : (pullState τ₀.symm s).basis h = false := by
    show s.basis (τ₀.symm h) = false
    rw [show τ₀.symm h = h from by rw [Equiv.symm_apply_eq]; exact f0h.symm]
    exact zh s hs
  have e1 := k.2 s hs m
  have t1a : (pullState τ₁.symm (run P m s)).basis a = false := by
    show (run P m s).basis (τ₁.symm a) = false
    rw [show τ₁.symm a = a from by rw [Equiv.symm_apply_eq]; exact f1a.symm]
    exact za' _ (After.intro hs m)
  have t1h : (pullState τ₁.symm (run P m s)).basis h = false := by
    show (run P m s).basis (τ₁.symm h) = false
    rw [show τ₁.symm h = h from by rw [Equiv.symm_apply_eq]; exact f1h.symm]
    exact zh' _ (After.intro hs m)
  rw [StairField13V3.run_swap_eq_of_clean a h P' m _ s0a s0h (by rw [e1]; exact t1a)
    (by rw [e1]; exact t1h), e1]

end ECDSAAdd.Entrant.StairHoles

