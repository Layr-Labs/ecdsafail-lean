/-- The record forward ticks `1 .. 504` are tape independent. -/
theorem fwd504 (x : Nat) (hx0 : 0 < x) (hx : x < p) (s1 : State)
    (first : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis)
    (m : List Bool) :
