theorem cache_out : LowZero18Square.cacheWire L dst∈outside L ext control src dst := by
  have hp : 0<dst.length := by omega
  rw [LowZero18Square.cacheWire_fixed L hw (List.nodup_cons.mp hn).2 dst hd hp]
