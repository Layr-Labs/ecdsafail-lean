/-!
# LT43c: the moved stage of row 500 against the record stage at tick 505

The moved walk of the terminal row ends (virtually) in a record integer stage on
the moved map `midSegmentMap 12` at tick 505.  The record walk
`Rolling1588TickGap.forward true 1 504` ends in the same stage on `base`
(placed by `OB5.sig 504`).  Both are determined by the input `x` on every stage
id that the terminal blocks read:

* `stage_agree`: id-wise agreement of the two stages (past letters, retained
  rail words, released pools, future letters, carries);
* `stage1_exists`: a record stage-1 state exists for every `0 < x < p`;
* `rec505`: the record state after ticks `1 .. 504` as a placed stage.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3LastStage

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout


/-- Record label ↦ moved label. -/
def tr (q : Wire) : Wire := wm (q - 16)

theorem tr_base (id : Nat) : tr (base id) = wm id := by
  have e : base id - 16 = id := by
    show id + 16 - 16 = id
    omega
  unfold tr
  rw [e]

theorem reg_map (f : Wire → Wire) (R : List Wire) (s : BasisState) :
    regValue (R.map f) s = regValue R (fun q => s (f q)) := by
  induction R with
  | nil => rfl
  | cons a R ih =>
      show (if s (f a) then 1 else 0) + 2 * regValue (R.map f) s =
        (if s (f a) then 1 else 0) + 2 * regValue R (fun q => s (f q))
      rw [ih]

theorem sreg_map (f : Wire → Wire) (R : List Wire) (s : BasisState) :
    signedRegValue (R.map f) s = signedRegValue R (fun q => s (f q)) := by
  unfold signedRegValue
  rw [reg_map, List.length_map]

/-- The sign-word views of the two maps at tick 505 correspond through `tr`. -/
theorem poolFacts :
    (W.compactSkywalkSignPoolA wm 505).retained =
        (W.compactSkywalkSignPoolA base 505).retained.map tr ∧
      (W.compactSkywalkSignPoolB wm 505).retained =
        (W.compactSkywalkSignPoolB base 505).retained.map tr ∧
      (W.compactSkywalkSignPoolA wm 505).released =
        (W.compactSkywalkSignPoolA base 505).released.map tr ∧
      (W.compactSkywalkSignPoolB wm 505).released =
        (W.compactSkywalkSignPoolB base 505).released.map tr := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide +kernel



theorem raw_agree (x : Nat) (rz rr : BasisState)
    (hz : W.CompactSkywalkStage wm
      (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)) 505 rz)
    (hr : W.CompactSkywalkStage base
      (SkywalkRails.encode false false (x : Int) (ECDSAAdd.p : Int)) 505 rr) :
    (∀ id, ValI id → rz (wm id) = rr (base id)) ∧
      (∀ id, ZeroI id → rz (wm id) = false ∧ rr (base id) = false) := by
  obtain ⟨pRA, pRB, pZA, pZB⟩ := poolFacts
  obtain ⟨za, zb, -, zpast, zfut, zcarry, z1797, zclA, zclB⟩ :=
    (W.compactSkywalkStage_fields_iff wm _ 505 (by omega)
      (StairPhysicalPrimitives.midSegmentMap_pool_nodup 12 (by decide)) rz).mp hz
  obtain ⟨ra, rb, -, rpast, rfut, rcarry, r1797, rclA, rclB⟩ :=
    (W.compactSkywalkStage_fields_iff base _ 505 (by omega) base_pool_nodup rr).mp hr
  rw [pRA, sreg_map] at za
  rw [pRB, sreg_map] at zb
  refine ⟨?_, ?_⟩
  · rintro id (h | h | h | h)
    · exact (zpast id (by omega)).1.trans (rpast id (by omega)).1.symm
    · have e : id = 1028 + (id - 1028) := by omega
      rw [e]
      exact (zpast (id - 1028) (by omega)).2.trans (rpast (id - 1028) (by omega)).2.symm
    · have hb := (signedRegValue_eq_iff _ _ _).mp (za.trans ra.symm) (base id) h
      simpa only [tr_base] using hb
    · have hb := (signedRegValue_eq_iff _ _ _).mp (zb.trans rb.symm) (base id) h
      simpa only [tr_base] using hb
  · rintro id (h | h | h | h | h)
    · refine ⟨?_, rclA _ h⟩
      have hm : tr (base id) ∈ (W.compactSkywalkSignPoolA wm 505).released := by
        rw [pZA]
        exact List.mem_map.mpr ⟨_, h, rfl⟩
      rw [← tr_base]
      exact zclA _ hm
    · refine ⟨?_, rclB _ h⟩
      have hm : tr (base id) ∈ (W.compactSkywalkSignPoolB wm 505).released := by
        rw [pZB]
        exact List.mem_map.mpr ⟨_, h, rfl⟩
      rw [← tr_base]
      exact zclB _ hm
    · have e : id = id - 258 + 258 := by omega
      rw [e]
      exact ⟨(zfut (id - 258) (by omega) (by omega)).1, (rfut (id - 258) (by omega) (by omega)).1⟩
    · by_cases hc : id < 1540
      · have e : id = 1028 + (id - 1028) := by omega
        rw [e]
        exact ⟨(zfut (id - 1028) (by omega) (by omega)).2,
          (rfut (id - 1028) (by omega) (by omega)).2⟩
      · exact ⟨(regValue_zero _ _).mp zcarry _
            (List.mem_map.mpr ⟨id, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩),
          (regValue_zero _ _).mp rcarry _
            (List.mem_map.mpr ⟨id, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩)⟩
    · rw [h]
      exact ⟨z1797, r1797⟩

/-- **The moved and the record stage at tick 505 agree id-wise.** -/
theorem stage_agree (x : Nat) (zb ρ : BasisState)
    (hz : Rolling1588.Integer.Stage wm true x ECDSAAdd.p 505 zb)
    (hρ : Rolling1588.Integer.Stage base true x ECDSAAdd.p 505 ρ) :
    (∀ id, (500 ≤ id ∧ id < 1028) ∨ 1528 ≤ id → ValI id → zb (wm id) = ρ (base id)) ∧
      (∀ id, (500 ≤ id ∧ id < 1028) ∨ 1528 ≤ id → ZeroI id →
        zb (wm id) = false ∧ ρ (base id) = false) := by
  obtain ⟨rawz, cz, hzb⟩ := hz
  obtain ⟨rawr, cr, hρb⟩ := hρ
  have pz := StairField2V3Trace.encodePrefix_boundary wm 100
  have pr := StairField2V3Trace.encodePrefix_boundary base 100
  rw [show 5 * 100 + 5 = 505 from rfl] at pz pr
  rw [pz] at hzb
  rw [pr] at hρb
  have kz : ∀ id, (500 ≤ id ∧ id < 1028) ∨ 1528 ≤ id → zb (wm id) = rawz.basis (wm id) := by
    intro id h
    rw [hzb]
    exact run_preserves_outside _ _ _ _ (StairField2V3SegSpec.allEncode_avoid wm
      (StairFirstTickV3.midSegmentMap_injective 12 (by decide)) 100 id (by omega))
  have kr : ∀ id, (500 ≤ id ∧ id < 1028) ∨ 1528 ≤ id → ρ (base id) = rawr.basis (base id) := by
    intro id h
    rw [hρb]
    exact run_preserves_outside _ _ _ _ (StairField2V3SegSpec.allEncode_avoid base
      base_injective 100 id (by omega))
  obtain ⟨v, z⟩ := raw_agree x rawz.basis rawr.basis cz cr
  refine ⟨fun id h hv => ?_, fun id h hz0 => ?_⟩
  · rw [kz id h, kr id h]
    exact v id hv
  · rw [kz id h, kr id h]
    exact z id hz0

