/-! ### merged from `ECDSAAdd.Submission.Entrant.StairFirstPacketSup_at_StairSideA` -/
section Merge_StairFirstPacketSup_at_StairSideA

/-!
# Every wire of the first-packet support superset passes `firstCheck` (LT20)
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

namespace ECDSAAdd.Entrant.StairFirstPacketKernel

open ECDSAAdd StairWireCheck

/-- LT44 (replay budget): `firstCheck` with the interval test `goodB` instead of the list
memberships of `goodNat` (the arena list walk was most of `supGood`'s kernel time). -/
private def firstCheckB (w : Wire) : Bool :=
  !decide (w ∈ hosts87Nat) &&
    (decide (w ∈ exclusiveNat) || StairPhysicalLayout.goodB (lowPlace w))

private theorem firstCheck_of_B {w : Wire} (h : firstCheckB w = true) : firstCheck w = true := by
  simp only [firstCheckB, Bool.and_eq_true, Bool.or_eq_true] at h
  simp only [firstCheck, Bool.and_eq_true, Bool.or_eq_true]
  refine ⟨h.1, h.2.imp id (fun g => ?_)⟩
  have g' := StairPhysicalLayout.good_of_goodB _ g
  simp only [goodNat, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨⟨g'.1, g'.2.1⟩, g'.2.2⟩

/-- K1 (replay budget): `firstCheckB` with the numeric kernel placement `kernelPlaceB`
(`StairPlaceFast.kernelPlace_eqB`) instead of the layout-record placement. -/
private def k1maskOf : List Nat → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| k1maskOf xs

private theorem k1_testBit_maskOf : ∀ (l : List Nat) (q : Nat), (k1maskOf l).testBit q = decide (q ∈ l)
  | [], q => by simp [k1maskOf]
  | x :: xs, q => by
    simp only [k1maskOf, Nat.testBit_or, k1_testBit_maskOf xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm

private theorem k1_mem_excl (w : Nat) :
    decide (w ∈ exclusiveNat) = (decide (736 ≤ w ∧ w < 776) || decide (777 ≤ w ∧ w < 781)) := by
  simp only [exclusiveNat, List.mem_append, List.mem_range'_1, Bool.decide_or]

/-- K1 (replay budget): `firstCheckB` with the host list as a bit mask (one closed term), the
roles as intervals, and the numeric kernel placement `kernelPlaceB`
(`StairPlaceFast.kernelPlace_eqB`) instead of the layout-record placement. -/
private def k1firstCheckF (w : Wire) : Bool :=
  !(k1maskOf hosts87Nat).testBit w &&
    ((decide (736 ≤ w ∧ w < 776) || decide (777 ≤ w ∧ w < 781)) ||
      StairPhysicalLayout.goodB (StairPlaceFast.kernelPlaceB
        ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host) (HostOB5.hostSwap w))))

private theorem k1_firstCheckB_eq (w : Wire) : firstCheckB w = k1firstCheckF w := by
  simp only [firstCheckB, k1firstCheckF, lowPlace, StairPlaceFast.kernelPlace_eqB, k1_testBit_maskOf,
    k1_mem_excl]

/-! K6 (replay budget): `fpSup` and the placement chain in `cond` / `Nat.ble` / `Nat.beq` form. -/
private theorem k6_bleD (a b : Nat) : Nat.ble a b = decide (a ≤ b) := by
  rw [Bool.eq_iff_iff, Nat.ble_eq, decide_eq_true_iff]
private theorem k6_bltD (a b : Nat) : Nat.blt a b = decide (a < b) := by
  rw [Bool.eq_iff_iff, Nat.blt_eq, decide_eq_true_iff]
private theorem k6_beqD (a b : Nat) : Nat.beq a b = decide (a = b) := by
  rw [Bool.eq_iff_iff, Nat.beq_eq, decide_eq_true_iff]

private def k6fpSupB (w : Wire) : Bool := Nat.blt w 2426 && (
  (Nat.ble 16 w && Nat.ble w 20) || (Nat.ble 528 w && Nat.ble w 530) ||
  Nat.beq w 733 || (Nat.ble 736 w && Nat.ble w 775) ||
  (Nat.ble 777 w && Nat.ble w 780) || (Nat.ble 786 w && Nat.ble w 1041) ||
  (Nat.ble 1043 w && Nat.ble w 1048) ||
  (Nat.ble 1051 w && Nat.ble w 1298 &&
    (Nat.beq ((w - 1051) % 5) 0 || Nat.beq ((w - 1051) % 5) 2)) ||
  Nat.beq w 1556 ||
  (Nat.ble 1560 w && Nat.ble w 1810 &&
    (Nat.beq ((w - 1560) % 5) 0 || Nat.beq ((w - 1560) % 5) 2)) ||
  (Nat.ble 1812 w && Nat.ble w 1813) || (Nat.ble 2072 w && Nat.ble w 2327) ||
  Nat.beq w 2425)

private theorem k6_fpSup_eqB (w : Wire) : fpSup w = k6fpSupB w := by
  simp only [k6fpSupB, k6_bleD, k6_bltD, k6_beqD]; rfl

private def k6oldB (v : Nat) : Bool :=
  Nat.ble 4833 v && (Nat.beq v 5515 || Nat.beq v 5915 || Nat.beq v 4881 || Nat.beq v 4880 ||
    Nat.beq v 4882 || Nat.beq v 5655 || Nat.beq v 4885 || Nat.beq v 5400 || Nat.beq v 5401 ||
    Nat.beq v 4884 || Nat.beq v 4883 || Nat.beq v 4833 || Nat.beq v 4834 || Nat.beq v 4875 ||
    Nat.beq v 9815)

private theorem k6_old_eqB (v : Nat) : StairPhysicalLayout.oldHolesNat.contains v = k6oldB v := by
  rw [Bool.eq_iff_iff]
  simp only [StairPhysicalLayout.oldHolesNat, k6oldB, List.contains_cons, List.contains_nil,
    Bool.or_false, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq, Nat.beq_eq, or_assoc]
  constructor
  · intro h
    refine ⟨?_, h⟩
    rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;> (subst h; decide)
  · intro h
    exact h.2

private def k6goodB (v : Nat) : Bool :=
  StairPhysicalLayout.arenaB v && !(k6oldB v) && !(StairPhysicalLayout.newB v)

private theorem k6_goodB_eq (v : Nat) : StairPhysicalLayout.goodB v = k6goodB v := by
  unfold StairPhysicalLayout.goodB k6goodB
  rw [k6_old_eqB]

private def k6firstCheckF (w : Wire) : Bool :=
  !(k1maskOf hosts87Nat).testBit w &&
    ((Nat.ble 736 w && Nat.blt w 776 || Nat.ble 777 w && Nat.blt w 781) ||
      k6goodB (StairPlaceFast.kernelPlaceB (StairPlaceFast.swB 1813 1559
        (StairPlaceFast.swB 2426 1558 (StairPlaceFast.swB 2425 527 w)))))

private theorem k6_firstCheckF_eq (w : Wire) : k1firstCheckF w = k6firstCheckF w := by
  unfold k1firstCheckF k6firstCheckF
  rw [StairPlaceFast.hostSwap_eqB, StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq]
  simp only [Bool.decide_and, k6_bleD, k6_bltD, k6_goodB_eq]
  rfl

private theorem supGoodB :
    (List.range 2426).all (fun w => !fpSup w || firstCheckB w) = true := by
  simp only [k1_firstCheckB_eq, k6_firstCheckF_eq, k6_fpSup_eqB]
  decide +kernel

theorem supGood :
    (List.range 2426).all (fun w => !fpSup w || firstCheck w) = true := by
  have h := supGoodB
  rw [List.all_eq_true] at h ⊢
  intro w hw
  have hw' := h w hw
  simp only [Bool.or_eq_true] at hw' ⊢
  exact hw'.imp id firstCheck_of_B

theorem firstCheck_of_sup (x : Wire) (h : fpSup x = true) : firstCheck x = true := by
  have hx := List.all_eq_true.mp supGood x (List.mem_range.mpr (fpSup_lt x h))
  simpa only [h, Bool.not_true, Bool.false_or] using hx

end ECDSAAdd.Entrant.StairFirstPacketKernel

end
end Merge_StairFirstPacketSup_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairFirstPacketHosted_at_StairSideA` -/
section Merge_StairFirstPacketHosted_at_StairSideA

/-!
# The two first packets hosted on `hosts 87` (LT20, field-12 prep, CANON 1719)

The v3 program (`StairHostsSchedule.entryLowPrefix` / `exitLowSuffix` with
`StairV3Primitives.hostPlan`) runs
`StairLoan.rebindMany StairSchedule.exclusiveRoles (hostPlan.firstPacket d)
(Rolling1588.placedFirstPacket d)`; `hostPlan.firstPacket d = hosts 87`.
This module proves its facts about exactly that program (`hostedFirstPacket`).

* Static touch map (kernel-checked): BOTH record first packets touch ALL 44
  exclusive roles `base 720 .. base 764 \ base 760`
  (`placedFirstPacket_touches`) and NO host (`placedFirstPacket_hostsFree`).
* The hosted packet avoids all 44 roles (`hostedFirstPacket_avoids`); under
  `lowPlace` (its physical map in the final program) every one of its wires is
  a record-arena site that is neither an old omission nor one of the 44 new
  omissions (`hostedFirstPacket_placed`), hence `hostedFirstPacket_pieceOK`
  for every hole list `holes ⊆ physicalHoles` (in particular `holes40`).
* T-free (`hostedFirstPacket_counts`), gate-physical
  (`hostedFirstPacket_physical`), and it runs exactly like the record packet
  when roles and hosts are zero on entry and the record packet returns the
  roles to zero (`hostedFirstPacket_run_eq`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairFirstPacketHosted

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairWireCheck StairFirstPacketKernel

attribute [local irreducible] ECDSAAdd.wires ECDSAAdd.run

/-- LT6's v3 hosted first packet, verbatim. -/
def hostedFirstPacket (divide : Bool) : Program :=
  StairLoan.rebindMany StairSchedule.exclusiveRoles
    (StairV3Primitives.hostPlan.firstPacket divide)
    (Rolling1588.placedFirstPacket divide)



theorem hostPlan_firstPacket (divide : Bool) :
    StairV3Primitives.hostPlan.firstPacket divide = hosts87Nat := by
  show StairPhysicalLayout.hosts 87 = hosts87Nat
  exact hosts87_eq_nat


/-! ## Static touch map of the record first packets -/


/-- The kernel passes, as a statement about wires: every wire of a record first
packet is not a host, and is an exclusive role or a good site under `lowPlace`. -/
theorem placedFirstPacket_pass (divide : Bool) :
    ∀ x ∈ wires (Rolling1588.placedFirstPacket divide), firstCheck x = true := by
  intro x hx
  apply firstCheck_of_sup
  cases divide
  · exact allSites_sound _ _ passSup_false x hx
  · exact allSites_sound _ _ passSup_true x hx

/-- Neither record first packet touches a host. -/
theorem placedFirstPacket_hostsFree (divide : Bool) :
    ∀ q ∈ StairV3Primitives.hostPlan.firstPacket divide,
      q ∉ wires (Rolling1588.placedFirstPacket divide) := by
  rw [hostPlan_firstPacket]
  intro q hq used
  have h := placedFirstPacket_pass divide q used
  simp only [firstCheck, Bool.and_eq_true, Bool.not_eq_true',
    decide_eq_false_iff_not] at h
  exact h.1 hq

theorem roles_hosts_length (divide : Bool) :
    StairSchedule.exclusiveRoles.length =
      (StairV3Primitives.hostPlan.firstPacket divide).length := by
  rw [hostPlan_firstPacket, exclusiveRoles_eq_nat]
  decide

theorem roles_hosts_nodup (divide : Bool) :
    (StairSchedule.exclusiveRoles ++
      StairV3Primitives.hostPlan.firstPacket divide).Nodup := by
  rw [hostPlan_firstPacket, exclusiveRoles_eq_nat]
  decide +kernel

/-! ## The hosted first packet -/

/-- The hosted packet touches none of the 44 exclusive roles. -/
theorem hostedFirstPacket_avoids (divide : Bool) :
    ∀ q ∈ StairSchedule.exclusiveRoles, q ∉ wires (hostedFirstPacket divide) :=
  StairLoan.rebindMany_roles_free _ _ _ (roles_hosts_length divide)
    (roles_hosts_nodup divide) (placedFirstPacket_hostsFree divide)

/-- Physical sites of the hosted packet (map `lowPlace`). -/
theorem hostedFirstPacket_placed (divide : Bool) :
    ∀ x ∈ wires (hostedFirstPacket divide),
      lowPlace x ∈ StairHoleSupport.recordArena ∧
        lowPlace x ∉ StairHoleSupport.oldHoles ∧
        lowPlace x ∉ StairPhysicalInventory.physicalHoles := by
  intro x hx
  have avoid := hostedFirstPacket_avoids divide
  have hx' := hx
  rw [hostedFirstPacket] at hx'
  rcases rebindMany_support _ _ _ x hx' with hh | hr | hp
  · rw [hostPlan_firstPacket] at hh
    exact goodNat_spec (List.all_eq_true.mp hostsGood x hh)
  · exact absurd hx (avoid x hr)
  · have h := placedFirstPacket_pass divide x hp
    simp only [firstCheck, Bool.and_eq_true, Bool.or_eq_true,
      decide_eq_true_eq] at h
    rcases h.2 with hr | hg
    · rw [← exclusiveRoles_eq_nat] at hr
      exact absurd hx (avoid x hr)
    · exact goodNat_spec hg

/-- LT1's `PieceOK holes lowPlace` shape, for every hole list inside the 44
new omissions (in particular `StairCertificateV3.holes40`). -/
theorem hostedFirstPacket_pieceOK (holes : List Wire)
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    (divide : Bool) :
    (∀ x ∈ wires (hostedFirstPacket divide),
        lowPlace x ∈ StairHoleSupport.recordArena ∧
          lowPlace x ∉ StairHoleSupport.oldHoles) ∧
      (∀ x ∈ wires (hostedFirstPacket divide), lowPlace x ∉ holes) := by
  refine ⟨fun x hx => ?_, fun x hx hh => ?_⟩
  · have h := hostedFirstPacket_placed divide x hx
    exact ⟨h.1, h.2.1⟩
  · exact (hostedFirstPacket_placed divide x hx).2.2 (hsub _ hh)



/-! ## Physicality (record proof, re-stated publicly) -/








end ECDSAAdd.Entrant.StairFirstPacketHosted

end
