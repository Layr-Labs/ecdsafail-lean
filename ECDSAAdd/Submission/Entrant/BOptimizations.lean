    · intro q _ hd _
      exact rb_out _ _ _ hd
  exact ⟨_, FrontierEntry1591Native.caller_first_stageW base Six505.shared_nodup x 0 hx0 hx
    ⟨false, StairCodec.registerBasis (skywalkArithmeticDivisor base) x⟩ [] input⟩

