   have hXv:X.val=formatX (.some hc) b false R:=ZMod.val_natCast_of_lt (format_bounds (.some hc) b false R).1
   have hYv:Y.val=formatY (.some hc) b false R:=ZMod.val_natCast_of_lt (format_bounds (.some hc) b false R).2
