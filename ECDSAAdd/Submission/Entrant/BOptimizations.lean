/-! ## Tapes: nested reachability is reachability of the concatenation -/


/-- States after running the programs of a list in order. -/
def reachL : (State → Prop) → List Program → State → Prop
  | R, [] => R
  | R, P :: L => reachL (After R P) L


theorem reachL_append : ∀ (L M : List Program) (R : State → Prop),
    reachL R (L ++ M) = reachL (reachL R L) M
  | [], _, _ => rfl
  | P :: L, M, R => reachL_append L M (After R P)

theorem reachL_of_flat : ∀ (L : List Program) (R : State → Prop) (t : State),
    After R L.flatten t → reachL R L t
  | [], R, t, h => after_nil h
  | P :: L, R, t, h => by
      rw [List.flatten_cons] at h
      exact reachL_of_flat L (After R P) t (after_append h)

theorem reachL_zero : ∀ (L : List Program) (R : State → Prop) (q : Wire),
    ZeroOn R q → (∀ P ∈ L, Keeps q P) → ZeroOn (reachL R L) q
  | [], _, _, z, _ => z
  | P :: L, R, q, z, k =>
      reachL_zero L (After R P) q (z.after (k P (by simp)))
        (fun Q hQ => k Q (by simp [hQ]))

theorem not_mem_flatten {q : Wire} : ∀ (L : List Program), (∀ P ∈ L, q ∉ wires P) →
    q ∉ wires L.flatten
  | [], _ => by simp [wires]
  | P :: L, h => by
      rw [List.flatten_cons, wires_append, Finset.mem_union, not_or]
      exact ⟨h P (by simp), not_mem_flatten L (fun Q hQ => h Q (by simp [hQ]))⟩

/-- A wire that is zero at the end and untouched by the remaining programs is zero now. -/
theorem reachL_zero_back (L M : List Program) (R : State → Prop) (q : Wire)
    (zfin : ZeroOn (reachL R (L ++ M)) q) (hM : ∀ P ∈ M, q ∉ wires P) :
    ZeroOn (reachL R L) q := by
  intro t ht
  have fin : reachL R (L ++ M) (run M.flatten [] t) := by
    rw [reachL_append]
    exact reachL_of_flat M _ _ (After.intro ht [])
  have z := zfin _ fin
  rwa [run_preserves_outside M.flatten [] t q (not_mem_flatten M hM)] at z

