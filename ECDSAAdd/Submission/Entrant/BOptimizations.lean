/-! ### merged from `ECDSAAdd.Submission.Entrant.StairHoles44Loans_at_StairSideA` -/
section Merge_StairHoles44Loans_at_StairSideA

/-!
# The four boundary loans are good for all 44 physical holes (S4)

Under `TP` the five sites `4835 .. 4839` are the labels `736 .. 740`, which are exclusive roles
(`RoleI`).  The two converter loans avoid every role, so the tables of `StairSiteEasyLoans`
suffice.  The two endpoints are placed by `OB5.sig 511` after their role-freedom, so their two
label tables are decided once more with the sharper test `tp44B = TPI and not 736 .. 740`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairHoles44

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance StairSiteEasy

theorem roleI_of_five {x : Nat} (h : 736 ≤ x ∧ x < 741) : RoleI x := by
  unfold RoleI
  omega

/-! ## The two converter loans -/

theorem converter44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) {P Q : Program}
    (env : wires P ⊆ wires Q ∪ StairBoundaryLoan.converterHosts.toFinset)
    (hrec : wires Q ⊆ StairBoundaryLoan.converterLayout760.wires.toFinset)
    (avoid : ∀ q ∈ StairBoundaryLoan.exclusiveHoles, q ∉ wires P) :
    PieceOK holes TP P := by
  apply ok44_of_tp hsub
  intro x hx
  have mem : x ∈ StairBoundaryLoan.converterLayout760.wires ++
      StairBoundaryLoan.converterHosts := by
    rcases Finset.mem_union.mp (env hx) with h | h
    · exact List.mem_append_left _ (List.mem_toFinset.mp (hrec h))
    · exact List.mem_append_right _ (List.mem_toFinset.mp h)
  have t := List.all_eq_true.mp converter_tab x mem
  simp only [Bool.or_eq_true, decide_eq_true_eq] at t
  have nr : ¬ RoleI x := fun m => avoid x (roleI_mem m) hx
  exact ⟨t.resolve_left nr, fun h => nr (roleI_of_five h)⟩

theorem canon44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) :
    PieceOK holes TP StairConcrete.bestLoans.canon :=
  converter44 hsub StairBoundaryLoan.canon760Loan_envelope
    (by
      rw [StairBoundaryLoan.canon760_eq]
      exact (HalfConvert.support _ StairBoundaryLoan.converterLayout760_facts.widths).2)
    StairBoundaryLoan.canon760Loan_avoids

theorem center44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) :
    PieceOK holes TP StairConcrete.bestLoans.center :=
  converter44 hsub StairBoundaryLoan.center760Loan_envelope
    (by
      rw [StairBoundaryLoan.center760_eq]
      exact (HalfConvert.support _ StairBoundaryLoan.converterLayout760_facts.widths).1)
    StairBoundaryLoan.center760Loan_avoids

/-! ## The two endpoints -/

/-- `TPI` without the labels `736 .. 740`, as one Boolean test. -/
def tp44B (x : Nat) : Bool := k5tpiB x && !tpFiveB x

theorem tp44B_spec {x : Nat} (h : tp44B x = true) : TPI x ∧ ¬ (736 ≤ x ∧ x < 741) := by
  unfold tp44B at h
  rw [Bool.and_eq_true, Bool.not_eq_true'] at h
  exact ⟨k5_tpiB x h.1, not_tpFive h.2⟩

/-- The division-endpoint table: the record decoder's 770 layout labels under the wrappers. -/
theorem divEnd_tab44 : DecoderBiasReuse.fixedLayout.wires.all (fun w =>
    k5roleB w || tp44B (OB5.sig 511 (Equiv.swap (base 760) (base 717)
      (shifted Placement5.pi0 (Equiv.swap (base 719) (base 510) w))))) = true := by
  decide +kernel

theorem divEnd_g44 : tp44B (OB5.sig 511 (Equiv.swap (base 760) (base 717)
    (shifted Placement5.pi0 (base 510)))) = true := by
  decide +kernel

theorem divEnd_flag44 : tp44B (OB5.sig 511 (Equiv.swap (base 760) (base 717)
    (shifted Placement5.pi0 (base 2409)))) = true := by
  decide +kernel

theorem divEnd_pad44 : tp44B (OB5.sig 511 (Equiv.swap (base 760) (base 717)
    (shifted Placement5.pi0 (Equiv.swap (base 719) (base 510) (base 512))))) = true := by
  decide +kernel

attribute [local irreducible] ECDSAAdd.wires in
theorem divEnd_tp44 (y : Wire)
    (hy : y ∈ wires CompareDecoder.BoundaryLoan.endPacket760DivLoan) :
    TPI (OB5.sig 511 y) ∧ ¬ (736 ≤ OB5.sig 511 y ∧ OB5.sig 511 y < 741) := by
  unfold CompareDecoder.BoundaryLoan.endPacket760DivLoan at hy
  rw [renameProgram_support] at hy
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
  rw [renameProgram_support] at ha
  obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ha
  rcases Finset.mem_union.mp (ControlLoan1589.loanWindow_support _ _ _ _ hb) with h | h
  · rw [Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl
    · exact tp44B_spec divEnd_g44
    · exact tp44B_spec divEnd_flag44
  · obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp h
    rw [wires_append, Finset.mem_union] at hz
    rcases hz with hz | hz
    · have hl := List.mem_toFinset.mp
        (CompareDecoder.support (CompareDecoder.BoundaryLoan.Inclusion.cellDecoderLoan_sub hz))
      have t := List.all_eq_true.mp divEnd_tab44 z hl
      simp only [Bool.or_eq_true] at t
      rcases t with t | t
      · exact absurd hz (k5_loan_avoids z (roleI_mem (k5_roleB z t)))
      · exact tp44B_spec t
    · have hc := (InverseEndpointWires.pad_facts 507 (base 512)).2.2.2.1 hz
      rw [Finset.mem_singleton] at hc
      rw [hc]
      exact tp44B_spec divEnd_pad44

attribute [local irreducible] ECDSAAdd.wires in
theorem endpointDiv44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) :
    PieceOK holes TP (renameProgram (OB5.sig 511) StairConcrete.bestLoans.divEndpoint) := by
  apply ok44_of_tp hsub
  intro x hx
  rw [renameProgram_support, StairConcrete.bestLoans_divEndpoint] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  exact divEnd_tp44 y hy

/-- The multiplication-endpoint table over the record endpoint's label superset. -/
theorem multEnd_tab44 : multEndL.all (fun y => k5roleB y || tp44B (OB5.sig 511 y)) = true := by
  decide +kernel

attribute [local irreducible] ECDSAAdd.wires in
theorem endpointMult44 {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) :
    PieceOK holes TP (StairHostsSchedule.hostedEndpoint hp false 68) := by
  apply ok44_of_tp hsub
  intro x hx
  have e : StairConcrete.bestLoans.endPacket false 68 =
      StairEndpointLoan44.endPacket760Loan44 false := by
    simp only [StairConcrete.bestLoans, StairConcrete.endPacket, Bool.false_eq_true,
      if_false, if_true]
  rw [StairHostsSchedule.hostedEndpoint, StairSchedule.placedEndPacket, e,
    renameProgram_support] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  have notRole : ¬ RoleI y := fun m =>
    StairEndpointLoan44.endPacket760Loan44_avoids y (roleI_mem m) hy
  have t := List.all_eq_true.mp multEnd_tab44 y
    (endPacket760_false_mem y (StairEndpointLoan44.endPacket760Loan44_support hy))
  simp only [Bool.or_eq_true] at t
  rcases t with t | t
  · exact absurd (k5_roleB y t) notRole
  · exact tp44B_spec t

end ECDSAAdd.Entrant.StairHoles44

end
