theorem getD_mem' (l : List Wire) (j : Nat) (c : Wire) : l.getD j c ∈ c :: l := by
  induction l generalizing j with
  | nil => simp
  | cons x l ih =>
      cases j with
      | zero => simp
      | succ j =>
          have := ih j
          simp only [List.getD_cons_succ, List.mem_cons] at this ⊢
          tauto

/-- `wireFn2 layout` is injective at the shared index `j` (given the direct-map and
metadata checks for `j`, and that `j` is not one of the two `swap2` indices). -/
theorem wireFn2_at (j : Nat) (hj : j < 2314) (hj0 : 0 < j) (n769 : j ≠ 769) (n1797 : j ≠ 1797)
    (hdm : ∀ i < 2314, Baselines.layout.skywalkDirectMap i = Baselines.layout.skywalkDirectMap j →
      i = j)
    (hmeta : ∀ x ∈ Baselines.layout.control :: pointMeta Baselines.layout,
      x ≠ Baselines.layout.skywalkDirectMap j)
    (q : Wire) (h : wireFn2 Baselines.layout q = wireFn2 Baselines.layout (base j)) :
    q = base j := by
