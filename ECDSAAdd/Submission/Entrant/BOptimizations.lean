      f x ∉ StairHoleSupport.oldHoles ∧ f x ∉ StairPhysicalInventory.physicalHoles) :
    PieceOK holes f P := by
  refine ⟨fun x hx => ⟨(h x hx).1, (h x hx).2.1⟩, fun x hx hh => ?_⟩
  exact (h x hx).2.2 (hsub _ hh)

