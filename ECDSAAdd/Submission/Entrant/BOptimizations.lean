/-! ## The two interval predicates, sharpened -/

/-- The five phase labels that `PP` sends to the sites `4835 .. 4839`. -/
def PPFive (x : Nat) : Prop := x = 739 ∨ x = 740 ∨ x = 1042 ∨ x = 1557 ∨ x = 1558

theorem pp44_goodB (x : Nat) (h : PPI x) (hn : ¬ PPFive x) :
    good44B (StairPlaceFast.phasePlaceB x) = true := by
  have low : ∀ x, x < 16 → good44B (StairPlaceFast.phasePlaceB x) = true := by
    decide +kernel
  unfold PPI at h
  unfold PPFive at hn
  rcases h with h | h | h | h | h | h | h
  · rcases Nat.lt_or_ge x 16 with h1 | h1
    · exact low x h1
    · exact k44PP1 x h1 h
  · subst h
    decide
  · exfalso
    omega
  · rcases Nat.lt_or_ge x 1042 with h1 | h1
    · exact k44PP3 x h.1 h1
    · exact k44PP4 x (by omega) h.2
  · rcases Nat.lt_or_ge x 1559 with h1 | h1
    · obtain rfl : x = 1556 := by omega
      decide
    · rcases Nat.lt_or_ge x 1672 with h2 | h2
      · exact k44PP6 x h1 h2
      · rcases Nat.lt_or_ge x 1673 with h3 | h3
        · obtain rfl : x = 1672 := by omega
          decide
        · rcases Nat.lt_or_ge x 1812 with h4 | h4
          · exact k44PP7 x h3 h4
          · obtain rfl : x = 1812 := by omega
            decide
  · exact k44PP8 x h.1 h.2
  · exact k44PPm x h.1 h.2

/-- A `PPI` label other than the five is good for all 44 holes under `PP`. -/
theorem pp44 {x : Nat} (h : PPI x) (hn : ¬ PPFive x) : Good44 (PP x) := by
  have g := good44_of_B (pp44_goodB x h hn)
  rw [← StairPlaceFast.phasePlace_eqB] at g
  exact g

theorem ok44_of_pp {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) {P : Program}
    (h : ∀ x ∈ wires P, PPI x ∧ ¬ PPFive x) : PieceOK holes PP P :=
  ok44_of_good hsub (fun x hx => pp44 (h x hx).1 (h x hx).2)

theorem tp44_goodB (x : Nat) (h : TPI x) (hn : ¬ (736 ≤ x ∧ x < 741)) :
    good44B (StairPlaceFast.outerPlaceB x) = true := by
  have low : ∀ x, x < 16 → good44B (StairPlaceFast.outerPlaceB x) = true := by
    decide +kernel
  unfold TPI at h
  rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact low x h
  · exact k44TP1 x h.1 h.2
  · have c : x = 528 ∨ x = 529 ∨ x = 530 := by omega
    rcases c with rfl | rfl | rfl <;> decide
  · subst h
    decide
  · exact absurd h hn
  · subst h
    decide
  · exact k44TP4 x h.1 h.2
  · exact k44TP5 x h.1 h.2
  · subst h
    decide
  · rcases Nat.lt_or_ge x 1672 with h1 | h1
    · exact k44TP7 x h.1 h1
    · rcases Nat.lt_or_ge x 1673 with h2 | h2
      · obtain rfl : x = 1672 := by omega
        decide
      · rcases Nat.lt_or_ge x 1812 with h3 | h3
        · exact k44TP8 x h2 h3
        · have c : x = 1812 ∨ x = 1813 := by omega
          rcases c with rfl | rfl <;> decide
  · exact k44TP9 x h.1 h.2
  · exact k44TPm x h.1 h.2
  · subst h
    decide

/-- A `TPI` label other than `736 .. 740` is good for all 44 holes under `TP`. -/
theorem tp44 {x : Nat} (h : TPI x) (hn : ¬ (736 ≤ x ∧ x < 741)) : Good44 (TP x) := by
  have g := good44_of_B (tp44_goodB x h hn)
  rw [← StairPlaceFast.outerPlace_eqB] at g
  exact g

theorem ok44_of_tp {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles) {P : Program}
    (h : ∀ x ∈ wires P, TPI x ∧ ¬ (736 ≤ x ∧ x < 741)) : PieceOK holes TP P :=
  ok44_of_good hsub (fun x hx => tp44 (h x hx).1 (h x hx).2)

/-! ## Boolean forms of the two exclusions -/

/-- `736 ≤ x < 741` (the five field-tail labels of the sites `4835 .. 4839`). -/
def tpFiveB (x : Nat) : Bool := Nat.ble 736 x && Nat.blt x 741

theorem not_tpFive {x : Nat} (h : tpFiveB x = false) : ¬ (736 ≤ x ∧ x < 741) := by
  intro hx
  have e : tpFiveB x = true := by
    simp only [tpFiveB, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq]
    exact hx
  rw [e] at h
  exact absurd h (by decide)

def ppFiveB (x : Nat) : Bool :=
  Nat.beq x 739 || Nat.beq x 740 || Nat.beq x 1042 || Nat.beq x 1557 || Nat.beq x 1558

theorem not_ppFive {x : Nat} (h : ppFiveB x = false) : ¬ PPFive x := by
  intro hx
  have e : ppFiveB x = true := by
    simp only [ppFiveB, Bool.or_eq_true, Nat.beq_eq]
    unfold PPFive at hx
    omega
  rw [e] at h
  exact absurd h (by decide)

