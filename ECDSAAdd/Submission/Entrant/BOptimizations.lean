/-!
# Field 12 on CANON 1945: the exit x-tail `x1N k` for every `k` (LT35)

`ParityXExitInverse23Kernel.x1N k = renameProgram pi (ParityXExit.programN base (base 2400) k)`.
The record bounds its labels by `mSites`, which contains `base 511` (and
`pi (base 511) = base 725`, a hole label), so the record support is too
coarse.  Here the merged exit `ExitMerge.program base (base 2400) k` is
unfolded once: its only `k`-dependent parts are masked / xor constant loads
(`maskedConstant c r v`, `xorConstant r v`), whose wires lie in `c :: r`
(`maskedConstant_wires_subset`, `xorConstant_wires_subset`), and the two
parity-dependent `CX` pairs of `parBack`.  Every other leaf is a fixed
program, checked once by `allSites`.  `ParityXExit.prefix_sub` and
`programAll_wires` carry the bound to `programN`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance






section Tight
open E1Merge E1WholeKAdd52Research ExitMerge

set_option linter.unusedSimpArgs false in
/-- LT46 (replay budget): the record's `ExitMerge.program_support`, tightened from `mSites`
to the tail labels `tSites` (same proof; no index in `258 .. 513` other than `514` is used). -/
theorem exitMerge_tight (w : Nat → Wire) (g : Wire) (k : Nat) :
    wires (ExitMerge.program w g k) ⊆ (tSites w g).toFinset := by
  have B := blk_tSites w g
  have I := in_tSites w g
  have G := g_tSites w g
  have mskH (c : Wire) (hc : c∈tSites w g) (v : Nat) : wires (maskedConstant c (hR w) v)⊆(tSites w g).toFinset :=
    (maskedConstant_wires_subset c (hR w) v).trans (tl_sub w g _ (fun q hq => by
      rcases List.mem_cons.mp hq with rfl|hq
      · exact hc
      · exact B 0 258 (by omega) q hq))
  have mskT (c : Wire) (hc : c∈tSites w g) (v : Nat) : wires (maskedConstant c (tR w) v)⊆(tSites w g).toFinset :=
    (maskedConstant_wires_subset c (tR w) v).trans (tl_sub w g _ (fun q hq => by
      rcases List.mem_cons.mp hq with rfl|hq
      · exact hc
      · exact B 1029 256 (by omega) q hq))
  have notT : wires (notRegister (tR w))⊆(tSites w g).toFinset := by
    rw [notRegister_wires]; exact tl_sub w g _ (B 1029 256 (by omega))
  have cx (a b : Nat) (ha : a < 258 ∨ (770 ≤ a ∧ a < 1285) ∨ (1540 ≤ a ∧ a < 1798) ∨ a = 514 ∨ a = 721 ∨ a = 722)
      (hb : b < 258 ∨ (770 ≤ b ∧ b < 1285) ∨ (1540 ≤ b ∧ b < 1798) ∨ b = 514 ∨ b = 721 ∨ b = 722) :
      wires [.CX (w a) (w b)]⊆(tSites w g).toFinset := tgate_sub w g _ (by
    intro q hq; simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl|rfl
    · exact I a ha
    · exact I b hb)
  have cxg (b : Nat) (hb : b < 258 ∨ (770 ≤ b ∧ b < 1285) ∨ (1540 ≤ b ∧ b < 1798) ∨ b = 514 ∨ b = 721 ∨ b = 722) :
      wires [.CX g (w b)]⊆(tSites w g).toFinset := tgate_sub w g _ (by
    intro q hq; simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl|rfl
    · exact G
    · exact I b hb)
  have ccx1 : wires [.CCX g (w 1028) (w 721)]⊆(tSites w g).toFinset := by
    apply tgate_sub; intro q hq
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl|rfl|rfl
    · exact G
    · exact I _ (by omega)
    · exact I _ (by omega)
  have ccx2 : wires [.CCX (w 514) (w 1028) (w 722)]⊆(tSites w g).toFinset := by
    apply tgate_sub; intro q hq
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl|rfl|rfl <;> exact I _ (by omega)
  have hT : wires (loadTX w g k)⊆(tSites w g).toFinset := by
    simp only [loadTX,wires_append,Finset.union_subset_iff]
    exact ⟨mskT g G _,mskT _ (I 721 (by omega)) _⟩
  have cmp : wires (compareLt none (hp8 w) (tR w) (hC2 w) (w 1797) (w 514))⊆(tSites w g).toFinset := by
    rw [(compareLt_wires none (hp8 w) (tR w) (hC2 w) (w 1797) (w 514) (by simp [hp8,tR,wireBlock_length])
      (by simp [hC2,tR,wireBlock_length])).1]
    apply tl_sub; intro q hq
    simp only [Option.toList_none,List.nil_append,List.mem_cons,List.mem_append] at hq
    rcases hq with rfl|rfl|(hq|hq)|hq
    · exact I 514 (by omega)
    · exact I 1797 (by omega)
    · exact B 1 256 (by omega) q hq
    · exact B 1029 256 (by omega) q hq
    · exact B 1540 256 (by omega) q hq
  have hF : wires (fPart w g k)⊆(tSites w g).toFinset := by
    simp only [fPart,wires_append,Finset.union_subset_iff]
    exact ⟨⟨⟨⟨⟨ccx1,hT⟩,cmp⟩,cxg 514 (by omega)⟩,hT⟩,ccx2⟩
  have hW : wires [.CX (w 1028) (w 0),.X (w 0)]⊆(tSites w g).toFinset := by
    rw [show ([.CX (w 1028) (w 0),.X (w 0)] : Program)=[.CX (w 1028) (w 0)]++[.X (w 0)] from rfl,
      wires_append,Finset.union_subset_iff]
    refine ⟨cx 1028 0 (by omega) (by omega),tgate_sub w g _ ?_⟩
    intro q hq; simp only [Instr.wires,Finset.mem_singleton] at hq; rw [hq]; exact I 0 (by omega)
  have hKn : wires (knownH w)⊆(tSites w g).toFinset := by
    apply (KnownOutputAdder.program_support _ _ _ _ _).trans
    apply tl_sub; intro q hq
    simp only [List.mem_append,List.mem_singleton] at hq
    rcases hq with (((hq|hq)|hq)|hq)|rfl
    · rw [dBitsX_wire w q hq]; exact I 1028 (by omega)
    · rw [desiredX,mappedRead_wires] at hq; exact B 770 257 (by omega) q hq
    · exact B 1 257 (by omega) q hq
    · exact B 1540 256 (by omega) q hq
    · exact I 1797 (by omega)
  have hCp : wires (copyRegister none (wireBlock w 770 257) (hpR w))⊆(tSites w g).toFinset := by
    rw [copyRegister_wires none _ _ (by simp [hpR,wireBlock_length])]
    split
    · exact Finset.empty_subset _
    · apply tl_sub; intro q hq
      simp only [Option.toList_none,List.nil_append,List.mem_append] at hq
      rcases hq with hq|hq
      · exact B 770 257 (by omega) q hq
      · exact B 1 257 (by omega) q hq
  have hE : wires (eraseH w)⊆(tSites w g).toFinset := by
    simp only [eraseH,wires_append,Finset.union_subset_iff]
    exact ⟨⟨hW,hKn⟩,hCp⟩
  have hNeg : wires (FastConst.maskedNot g (kR w))⊆(tSites w g).toFinset :=
    (maskedConstant_wires_subset g (kR w) _).trans (tl_sub w g _ (fun q hq => by
      rcases List.mem_cons.mp hq with rfl|hq
      · exact G
      · exact B 770 258 (by omega) q hq))
  have hL : wires (loadKX w g k)⊆(tSites w g).toFinset := by
    simp only [loadKX,wires_append,Finset.union_subset_iff]
    refine ⟨⟨⟨⟨⟨?_,mskH g G _⟩,mskH _ (I 514 (by omega)) _⟩,mskH _ (I 1028 (by omega)) _⟩,
      mskH _ (I 721 (by omega)) _⟩,mskH _ (I 722 (by omega)) _⟩
    exact (xorConstant_wires_subset (hR w) _).trans (tl_sub w g _ (B 0 258 (by omega)))
  have hKOld : wires (kAddM w)⊆(tSites w g).toFinset := by
    apply (mappedAdd_wires_subset _ _ _ _).trans
    apply tl_sub; intro q hq
    simp only [mappedRead_wires,List.mem_append,List.mem_singleton] at hq
    rcases hq with ((hq|hq)|hq)|rfl
    · exact B 0 258 (by omega) q hq
    · exact B 770 258 (by omega) q hq
    · exact B 1540 257 (by omega) q hq
    · exact I 1797 (by omega)
  have hK : wires (Verifier.Leaf4.zero4KAdd w)⊆(tSites w g).toFinset := by
    apply (Verifier.Leaf4.zero4_support w).trans
    simpa only [←kAdd_literal] using hKOld
  have hM : wires ([.measureX (w 722) [] [.CZ (w 514) (w 1028)],.measureX (w 721) [] [.CZ g (w 1028)]] : Program)⊆
      (tSites w g).toFinset := by
    rw [show ([.measureX (w 722) [] [.CZ (w 514) (w 1028)],.measureX (w 721) [] [.CZ g (w 1028)]] : Program)=
      [.measureX (w 722) [] [.CZ (w 514) (w 1028)]]++[.measureX (w 721) [] [.CZ g (w 1028)]] from rfl,
      wires_append,Finset.union_subset_iff]
    constructor <;> apply tgate_sub <;> intro q hq <;>
      simp only [Instr.wires,correctionWires,Finset.mem_union,Finset.mem_singleton,Finset.mem_insert,
        Finset.notMem_empty,Finset.union_empty,Finset.empty_union] at hq <;>
      rcases hq with rfl|rfl|rfl <;> first | exact G | exact I _ (by omega)
  have hA : wires (addPart w g k)⊆(tSites w g).toFinset := by
    simp only [addPart,wires_append,Finset.union_subset_iff]
    exact ⟨⟨⟨⟨hNeg,hL⟩,hK⟩,hL⟩,hM⟩
  have hRot : wires (rotateLeft (kR w))⊆(tSites w g).toFinset := by
