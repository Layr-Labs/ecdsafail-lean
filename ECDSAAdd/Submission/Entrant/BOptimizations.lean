    · exact I a ha
    · exact I b hb)
  have cxg (b : Nat) (hb : (b < 512 ∨ b = 513 ∨ b = 514) ∨ (770 ≤ b ∧ b < 1285) ∨ (1540 ≤ b ∧ b < 1798) ∨ b = 721 ∨ b = 722) :
