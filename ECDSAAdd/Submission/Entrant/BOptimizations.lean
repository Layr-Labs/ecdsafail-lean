/-!
# Field 13 on v3: kernel check for the stair `firstPack` (LT29)

The roles in phase coordinates (`phaseHost`: roles 720/721/722 sit on
`base 1542/1026/1541`, the others on themselves) are kept zero by the stair
`firstPack` (decided by the static zero tracker; no run is evaluated).
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairField13V3Clean

open ECDSAAdd Arithmetic Challenge MappedCompressed


theorem phaseTargets_window : ∀ q ∈ phaseTargets, 739 ≤ q ∧ q < 739 + 820 := by
  decide +kernel

/-- LT50 (replay budget): two pieces that keep status `true` compose. -/
theorem ztAll_true_append (lo width : Nat) (ws : List Wire) (X Y : Program)
    (hr : ∀ w ∈ ws, lo ≤ w ∧ w < lo + width)
    (hX : ztAll lo width true ws X = true) (hY : ztAll lo width true ws Y = true) :
    ztAll lo width true ws (X ++ Y) = true :=
  ztAll_of_zt lo width true ws _ hr (fun w hw => by
    rw [zt_append, zt_of_ztAll lo width true ws X hr hX w hw]
    exact zt_of_ztAll lo width true ws Y hr hY w hw)

/-- LT50: the codec `pack 87` stays on its row sites. -/
theorem pack87_rows : ∀ r ∈ wires (StairPhysicalPrimitives.pack 87), r ∈ StairPhysicalLayout.rowSites 87 :=
  StairPhysicalPhase.pack_inside 87 StairPhysicalPhase.budget87_mem

/-- LT50 (replay budget): the relabelled codec `pack 87` (≈ 11 s to evaluate) touches no phase
target: its wires are row sites (`pack87_rows`), checked on the closed-form relabelling. -/
theorem keep_pack87 : ztAll 739 820 true phaseTargets
    (renameProgram StairPhysicalLayout.phaseRelabel (StairPhysicalPrimitives.pack 87)) = true := by
  have avoid : (StairPhysicalLayout.rowSites 87).all (fun r =>
      !(StairLoan.maskOf phaseTargets).testBit
        (StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB r))) = true := by
    decide +kernel
  apply ztAll_true_of_not_mem 739 820 _ _ phaseTargets_window
  intro w hw hm
  rw [renameProgram_support, Finset.mem_image] at hm
  obtain ⟨r, hr, rfl⟩ := hm
  have hrow := pack87_rows r hr
  have t := List.all_eq_true.mp avoid r hrow
  have e : StairPhysicalLayout.phaseRelabel r =
      StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB r) := by
    rw [StairPhysicalLayout.phaseRelabel, StairPlaceFast.phaseHost_eqB, StairPlaceFast.fieldPlace_eqB]
  rw [e] at hw
  rw [StairLoan.testBit_maskOf] at t
  simp [hw] at t

/-! K4C (replay budget): the x-word orientation was decided through `xRelabel`, i.e. one
`xSwap` (two 88-entry `find?` scans) per gate (≈ 2.8 s).  `xSwap` fixes every phase target
(`k4p_xSwap_fix`, one bit-mask disjointness check), so the tracker of the `xRelabel` program
equals that of the `phaseRelabel` program (`k4p_zt_x`), which is decided on the closed-form
relabelling. -/

theorem k4p_disj : StairLoan.maskOf phaseTargets &&& StairLoan.maskOf
    ((List.range 88).map (fun k => base (770 + k)) ++ (List.range 88).map StairPhysicalLayout.bSite) =
      0 := by
  decide +kernel

theorem k4p_xSwap_fix (w : Wire) (hw : w ∈ phaseTargets) : StairV3Primitives.xSwap w = w := by
  have away : ∀ q ∈ (List.range 88).map (fun k => base (770 + k)) ++
      (List.range 88).map StairPhysicalLayout.bSite, q ≠ w := by
    intro q hq e
    subst e
    have h3 : (StairLoan.maskOf phaseTargets &&& StairLoan.maskOf
        ((List.range 88).map (fun k => base (770 + k)) ++
          (List.range 88).map StairPhysicalLayout.bSite)).testBit q = false := by
      rw [k4p_disj]
      exact Nat.zero_testBit q
    rw [Nat.testBit_and, StairLoan.testBit_maskOf, StairLoan.testBit_maskOf, decide_eq_true hw,
      decide_eq_true hq] at h3
    exact absurd h3 (by decide)
  rcases StairV3Primitives.xSwap_cases w with ⟨k, mem, e, -⟩ | ⟨k, mem, e, -⟩ | e
  · exact absurd e.symm (away _ (List.mem_append_left _ (List.mem_map.mpr ⟨k, mem, rfl⟩)))
  · exact absurd e.symm (away _ (List.mem_append_right _ (List.mem_map.mpr ⟨k, mem, rfl⟩)))
  · exact e

theorem k4p_zt_x (w : Wire) (hw : StairV3Primitives.xSwap w = w) : ∀ (P : Program) (b : Bool),
    zt w b (renameProgram StairV3Primitives.xRelabel P) =
      zt w b (renameProgram StairPhysicalLayout.phaseRelabel P)
  | [], _ => rfl
  | i :: P, b => by
    simp only [renameProgram, List.map_cons, zt, tgt_rename, isMeas_rename]
    have key : StairV3Primitives.xRelabel (tgt i) = w ↔
        StairPhysicalLayout.phaseRelabel (tgt i) = w := by
      unfold StairV3Primitives.xRelabel
      constructor
      · intro h
        rw [← StairV3Primitives.xSwap_invol (StairPhysicalLayout.phaseRelabel (tgt i)), h, hw]
      · intro h
        rw [h, hw]
    by_cases h : StairPhysicalLayout.phaseRelabel (tgt i) = w
    · rw [if_pos (key.2 h), if_pos h]
      exact k4p_zt_x w hw P _
    · rw [if_neg (fun h' => h (key.1 h')), if_neg h]
      exact k4p_zt_x w hw P b

theorem k4p_orient : ztAll 739 820 true phaseTargets
    (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) = true := by
  have fast : ztAll 739 820 true phaseTargets (renameProgram
      (fun q => StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB q))
      (StairV3Primitives.orient 425)) = true := by
    decide +kernel
  have e : renameProgram StairPhysicalLayout.phaseRelabel (StairV3Primitives.orient 425) =
      renameProgram (fun q => StairPlaceFast.phaseHostB (StairPlaceFast.fieldPlaceB q))
        (StairV3Primitives.orient 425) := by
    congr 1
    funext q
    rw [StairPhysicalLayout.phaseRelabel, StairPlaceFast.phaseHost_eqB,
      StairPlaceFast.fieldPlace_eqB]
  rw [← e] at fast
  apply ztAll_of_zt 739 820 true phaseTargets _ phaseTargets_window
  intro w hw
  rw [k4p_zt_x w (k4p_xSwap_fix w hw)]
  exact zt_of_ztAll 739 820 true phaseTargets _ phaseTargets_window fast w hw


