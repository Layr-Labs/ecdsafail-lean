section

set_option autoImplicit false
set_option maxRecDepth 30000

namespace ECDSAAdd.Entrant.StairHoles

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly

/-! ## Equal cost -/

/-- Same Toffoli count, measurement count and gate slots. -/
def SameCost (P Q : Program) : Prop :=
  toffoliCount P = toffoliCount Q ∧ measurementCount P = measurementCount Q ∧
    gateSlots P = gateSlots Q

theorem SameCost.refl (P : Program) : SameCost P P := ⟨rfl, rfl, rfl⟩

theorem SameCost.symm {P Q : Program} (h : SameCost P Q) : SameCost Q P :=
  ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩

theorem SameCost.trans {P Q R : Program} (h : SameCost P Q) (k : SameCost Q R) : SameCost P R :=
  ⟨h.1.trans k.1, h.2.1.trans k.2.1, h.2.2.trans k.2.2⟩

theorem SameCost.append {P P' Q Q' : Program} (h : SameCost P P') (k : SameCost Q Q') :
    SameCost (P ++ Q) (P' ++ Q') := by
  refine ⟨?_, ?_, ?_⟩
  · rw [toffoliCount_append, toffoliCount_append, h.1, k.1]
  · rw [measurementCount_append, measurementCount_append, h.2.1, k.2.1]
  · rw [gateSlots_append, gateSlots_append, h.2.2, k.2.2]

/-- A renamed program costs what the program costs. -/
theorem sameCost_rename (f : Wire → Wire) (P : Program) : SameCost (renameProgram f P) P :=
  ⟨(renameProgram_counts f P).1, (renameProgram_counts f P).2, Baselines.rename_gateSlots f P⟩

theorem SameCost.rename (f g : Wire → Wire) {P Q : Program} (h : SameCost P Q) :
    SameCost (renameProgram f P) (renameProgram g Q) :=
  ((sameCost_rename f P).trans h).trans (sameCost_rename g Q).symm



variable {π : Pieces}






/-! ## Physicality -/

/-- Physicality facts of the nine pieces of `π`. -/
structure NinePhysical (π : Pieces) : Prop where
  stage : ∀ {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy),
    GatePhysical (π.stage (.some hc))
  borrowOut : ∀ {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy),
    GatePhysical (π.borrowOut (.some hc))
  entryX : ∀ c : Fp, GatePhysical (π.entryX c)
  square : ∀ k : Fp, GatePhysical (π.square k)
  entryTicks : StairPhysicalV3.Sound π.entryTicks
  entryLast : StairPhysicalV3.Sound π.entryLast
  exitTail : StairPhysicalV3.Sound π.exitTail
  exitTicks : StairPhysicalV3.Sound π.exitTicks
  x1N : ∀ k : Nat, StairPhysicalV3.Sound (π.x1N k)






