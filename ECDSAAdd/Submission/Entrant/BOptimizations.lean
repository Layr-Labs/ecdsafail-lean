        have tf := hkf a n512 n770
        have t0' := hk0 a
        rw [ea] at tf t0'
        rw [tf, t0']
        by_cases hp : a ∈ skywalkPoolWires base
        · obtain ⟨j, hj, rfl⟩ := pool_id a hp
          have cls : Unch j ∨ (420 ≤ j ∧ j ≤ 424) ∨ (425 ≤ j ∧ j ≤ 510) ∨ j = 511 ∨ j = 512 ∨
              (770 ≤ j ∧ j ≤ 857) ∨ j = 1543 ∨
              (1544 ≤ j ∧ j ≤ 1628 ∧
