/-! ## Inversion through the record field wrappers -/

theorem own_of_involution (f : Wire → Wire) (hinv : ∀ q, f (f q) = q)
    (hf : PreservesCaller f) (P : Program)
    (h : wires (renameProgram f P) ⊆ callerDomain) : wires P ⊆ callerDomain := by
  intro q hq
  have img : f q ∈ wires (renameProgram f P) := by
    rw [renameProgram_support]
    exact Finset.mem_image_of_mem _ hq
  have back := hf _ (h img)
  rwa [hinv] at back

theorem sig511_invol (q : Nat) : OB5.sig 511 (OB5.sig 511 q) = q := by
  by_cases hc : (1301 ≤ q ∧ q ≤ 1044+511) ∨ (2069 ≤ q+511 ∧ q ≤ 1812)
  · have e1 : OB5.sig 511 q = 3113 - q := by
      unfold OB5.sig
      exact if_pos hc
    have hc2 : (1301 ≤ 3113 - q ∧ 3113 - q ≤ 1044+511) ∨
        (2069 ≤ (3113 - q)+511 ∧ 3113 - q ≤ 1812) := by
      rcases hc with ⟨a, b⟩ | ⟨a, b⟩
      · right
        have x : 2069 ≤ (3113 - q) + 511 := by omega
        have y : 3113 - q ≤ 1812 := by omega
        exact ⟨x, y⟩
      · left
        have x : 1301 ≤ 3113 - q := by omega
        have y : 3113 - q ≤ 1044 + 511 := by omega
        exact ⟨x, y⟩
    have e2 : OB5.sig 511 (3113 - q) = 3113 - (3113 - q) := by
      unfold OB5.sig
      exact if_pos hc2
    rw [e1, e2]
    have le : q ≤ 3113 := by rcases hc with ⟨a, b⟩ | ⟨a, b⟩ <;> omega
    exact Nat.sub_sub_self le
  · have e1 : OB5.sig 511 q = q := by
      unfold OB5.sig
      exact if_neg hc
    rw [e1, e1]

theorem own_of_sig511 (P : Program)
    (h : wires (renameProgram (OB5.sig 511) P) ⊆ callerDomain) : wires P ⊆ callerDomain :=
  own_of_involution _ sig511_invol (preserves_sig 511 (by omega)) P h

