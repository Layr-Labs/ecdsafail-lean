/-! ### merged from `ECDSAAdd.Submission.Entrant.StairWireCheck_at_StairSideA` -/
section Merge_StairWireCheck_at_StairSideA

/-!
# List-level wire checks (LT20)

`wires P` is a `Finset` union, which is expensive to evaluate in the kernel.
This module gives a list-level description of the wires of an instruction and
two Boolean checks over a concrete program, each with a soundness theorem, so
static touch/avoid facts about concrete programs can be closed by
`decide +kernel` on a `Bool` equation.
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairWireCheck

open ECDSAAdd

/-- Wires of a correction list, as a list. -/
def corrWs : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: corrWs cs
  | .CZ a b :: cs => a :: b :: corrWs cs

/-- Wires of an instruction, as a list. -/
def instrWs : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c0 c1 => t :: (corrWs c0 ++ corrWs c1)

theorem mem_corrWs (q : Wire) (cs : List Correction) :
    q ∈ corrWs cs ↔ q ∈ correctionWires cs := by
  induction cs with
  | nil => simp [corrWs, correctionWires]
  | cons c cs ih =>
      cases c <;> simp [corrWs, correctionWires, ih]

theorem mem_instrWs (q : Wire) (i : Instr) : q ∈ instrWs i ↔ q ∈ i.wires := by
  cases i <;> simp [instrWs, Instr.wires, mem_corrWs]

theorem mem_wires (q : Wire) (P : Program) :
    q ∈ wires P ↔ ∃ i ∈ P, q ∈ instrWs i := by
  induction P with
  | nil => simp [wires]
  | cons i P ih =>
      simp only [wires, Finset.mem_union, ih, List.mem_cons, mem_instrWs]
      constructor
      · rintro (h | ⟨j, hj, hq⟩)
        · exact ⟨i, Or.inl rfl, h⟩
        · exact ⟨j, Or.inr hj, hq⟩
      · rintro ⟨j, hj | hj, hq⟩
        · exact Or.inl (hj ▸ hq)
        · exact Or.inr ⟨j, hj, hq⟩





/-! ## Good physical sites (fast list form) -/

/-- Inside the record arena, not an old omission, not one of the 44 new
omissions. -/
def goodNat (q : Wire) : Bool :=
  decide (q ∈ StairPhysicalLayout.arenaNat) &&
    decide (q ∉ StairPhysicalLayout.oldHolesNat) &&
    decide (q ∉ StairPhysicalLayout.newHolesNat)

theorem goodNat_spec {q : Wire} (h : goodNat q = true) :
    q ∈ StairHoleSupport.recordArena ∧ q ∉ StairHoleSupport.oldHoles ∧
      q ∉ StairPhysicalInventory.physicalHoles := by
  rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq,
    StairPhysicalLayout.physicalHoles_eq_nat]
  simp only [goodNat, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1.1, h.1.2, h.2⟩



/-- The field level before `Prefix1590.borrow` (LT1's `lowPlace`): the map
under which the two first packets of `StairHostsSchedule.entryLowPrefix` /
`exitLowSuffix` land in the final program. -/
def lowPlace (q : Wire) : Wire :=
  StairOuterPlacement.kernelPlace
    ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
      (HostOB5.hostSwap q))

/-! ## Literal role and host lists of the first packets -/

/-- `StairSchedule.exclusiveRoles` (labels `base 720 .. base 764` without
`base 760`) as literal wires. -/
def exclusiveNat : List Wire := List.range' 736 40 ++ List.range' 777 4

theorem exclusiveRoles_eq_nat : StairSchedule.exclusiveRoles = exclusiveNat := by
  decide +kernel


/-- `StairPhysicalLayout.hosts 87` (the v3 first-packet hosts) as literal
wires. -/
def hosts87Nat : List Wire :=
  [1633, 1631, 1629, 1628, 1626, 1624, 1623, 1621, 1619, 1618, 1616, 1614,
   1613, 1611, 1609, 1608, 1606, 1604, 1603, 1601, 1599, 1598, 1596, 1594,
   1593, 1591, 1589, 1588, 1586, 1584, 1583, 1581, 1579, 1578, 1576, 1574,
   1573, 1571, 1569, 1568, 1566, 1564, 1563, 1561]

theorem hosts87_eq_nat : StairPhysicalLayout.hosts 87 = hosts87Nat := by
  decide +kernel

/-! ## A generic single-pass site check and the support of `rebindMany` -/

/-- Every wire of every instruction of `P` satisfies `c`. -/
def allSites (c : Wire → Bool) (P : Program) : Bool :=
  P.all (fun i => (instrWs i).all c)

theorem allSites_sound (c : Wire → Bool) (P : Program)
    (h : allSites c P = true) : ∀ x ∈ wires P, c x = true := by
  intro x hx
  obtain ⟨i, hi, hw⟩ := (mem_wires x P).mp hx
  exact List.all_eq_true.mp (List.all_eq_true.mp h i hi) x hw

/-- A wire of a rebound program is a host, a role, or a wire of the original
program. -/
theorem rebindMany_support (roles hosts : List Wire) (P : Program) :
    ∀ x ∈ wires (StairLoan.rebindMany roles hosts P),
      x ∈ hosts ∨ x ∈ roles ∨ x ∈ wires P := by
  induction roles generalizing hosts with
  | nil =>
      intro x hx
      exact Or.inr (Or.inr (by simpa only [StairLoan.rebindMany] using hx))
  | cons r rs ih =>
      cases hosts with
      | nil =>
          intro x hx
          exact Or.inr (Or.inr (by simpa only [StairLoan.rebindMany] using hx))
      | cons h hs =>
          intro x hx
          rw [StairLoan.rebindMany, renameProgram_support] at hx
          obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
          by_cases hyr : y = r
          · subst hyr
            left
            rw [Equiv.swap_apply_left]
            simp
          by_cases hyh : y = h
          · subst hyh
            right; left
            rw [Equiv.swap_apply_right]
            simp
          rw [Equiv.swap_apply_of_ne_of_ne hyr hyh]
          rcases ih hs y hy with h1 | h1 | h1
          · exact Or.inl (List.mem_cons_of_mem _ h1)
          · exact Or.inr (Or.inl (List.mem_cons_of_mem _ h1))
          · exact Or.inr (Or.inr h1)

/-- The per-wire predicate of the first-packet pass: not a host, and either an
exclusive role or a good physical site under `lowPlace`. -/
def firstCheck (w : Wire) : Bool :=
  !decide (w ∈ hosts87Nat) && (decide (w ∈ exclusiveNat) || goodNat (lowPlace w))

theorem hostsGood : hosts87Nat.all (fun h => goodNat (lowPlace h)) = true := by
  -- K6 (replay budget): numeric kernel placement `kernelPlaceB` and interval test `goodB`
  have hB : hosts87Nat.all (fun h => StairPhysicalLayout.goodB (StairPlaceFast.kernelPlaceB
      ((Equiv.swap FrontierEntry1591Field.work FrontierEntry1591Field.host)
        (HostOB5.hostSwap h)))) = true := by
    decide +kernel
  rw [List.all_eq_true] at hB ⊢
  intro w hw
  have g' := StairPhysicalLayout.good_of_goodB _ (hB w hw)
  rw [lowPlace, StairPlaceFast.kernelPlace_eqB]
  simp only [goodNat, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨⟨g'.1, g'.2.1⟩, g'.2.2⟩

/-- An explicit superset of the support of both record first packets
(field-tail labels).  Its periodic parts are the packet-0 history letters. -/
def fpSup (w : Wire) : Bool := decide (w < 2426) && (
  (decide (16 ≤ w) && decide (w ≤ 20)) || (decide (528 ≤ w) && decide (w ≤ 530)) ||
  decide (w = 733) || (decide (736 ≤ w) && decide (w ≤ 775)) ||
  (decide (777 ≤ w) && decide (w ≤ 780)) || (decide (786 ≤ w) && decide (w ≤ 1041)) ||
  (decide (1043 ≤ w) && decide (w ≤ 1048)) ||
  (decide (1051 ≤ w) && decide (w ≤ 1298) &&
    (decide ((w - 1051) % 5 = 0) || decide ((w - 1051) % 5 = 2))) ||
  decide (w = 1556) ||
  (decide (1560 ≤ w) && decide (w ≤ 1810) &&
    (decide ((w - 1560) % 5 = 0) || decide ((w - 1560) % 5 = 2))) ||
  (decide (1812 ≤ w) && decide (w ≤ 1813)) || (decide (2072 ≤ w) && decide (w ≤ 2327)) ||
  decide (w = 2425))

theorem fpSup_lt (w : Wire) (h : fpSup w = true) : w < 2426 := by
  unfold fpSup at h
  simp only [Bool.and_eq_true] at h
  exact of_decide_eq_true h.1

end ECDSAAdd.Entrant.StairWireCheck

end
end Merge_StairWireCheck_at_StairSideA

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairFirstPacketKernelF_at_StairSideA` -/
section Merge_StairFirstPacketKernelF_at_StairSideA

/-!
# Kernel checks for the record first packet `Rolling1588.placedFirstPacket false`
(LT20).  Iterative Boolean checkers from `StairWireCheck`, closed by
`decide +kernel`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

namespace ECDSAAdd.Entrant.StairFirstPacketKernel

open ECDSAAdd StairWireCheck

/-! ## LT48 (replay budget): structural support instead of one kernel pass over the packet

The kernel pass over the 52k-gate packet cost ≈ 300 s per packet (all of it in generating the
body: three lifetime halves `R2Life760.half760`, the joint kernel, the codec triples).  Here every
piece is bounded by the record's own support lemmas (`tripleMap` has a 6-wire range,
`ControlLoan1589.loanWindow_support`, `R2Life760.half760_support`, `Q6EndpointCell.half_support`
with the six `half_avoid` omissions, `paddedD/GD_support` with `_free`), and `fpSup` is checked on
those envelopes (≈ 3,000 wires).  The touch check reads one bit mask of the shortest prefix. -/
namespace LT48F
open Arithmetic.MappedCompressed Rolling1588
attribute [local irreducible] ECDSAAdd.wires

/-- Every wire of `P` passes `c`. -/
def Ok (c : Wire → Bool) (P : Program) : Prop := ∀ x ∈ wires P, c x = true

theorem ok_of_all {c : Wire → Bool} {P : Program} (h : allSites c P = true) : Ok c P :=
  allSites_sound c P h

theorem allSites_of_ok {c : Wire → Bool} {P : Program} (h : Ok c P) : allSites c P = true := by
  unfold allSites
  rw [List.all_eq_true]
  intro i hi
  rw [List.all_eq_true]
  intro x hx
  exact h x ((StairWireCheck.mem_wires x P).mpr ⟨i, hi, hx⟩)

theorem ok_append {c : Wire → Bool} {A B : Program} (ha : Ok c A) (hb : Ok c B) : Ok c (A ++ B) := by
  intro x hx
  rw [wires_append, Finset.mem_union] at hx
  exact hx.elim (ha x) (hb x)


theorem ok_rename {c : Wire → Bool} (f : Wire → Wire) (P : Program)
    (h : Ok (fun x => c (f x)) P) : Ok c (renameProgram f P) := by
  intro x hx
  rw [ECDSAAdd.renameProgram_support] at hx
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
  exact h y hy

theorem ok_selW {c : Wire → Bool} (src flag : Wire) (P : Program) (h1 : c src = true)
    (h2 : c flag = true) (hP : Ok c P) : Ok c (SW.selW src flag P) := by
  intro x hx
  rw [SW.selW, wires_append, wires_append, Finset.mem_union, Finset.mem_union] at hx
  rcases hx with (hx | hx) | hx
  · obtain ⟨i, hi, hw⟩ := (StairWireCheck.mem_wires x _).mp hx
    simp only [List.mem_singleton] at hi
    subst hi
    simp only [instrWs, List.mem_cons, List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl <;> assumption
  · exact hP x hx
  · obtain ⟨i, hi, hw⟩ := (StairWireCheck.mem_wires x _).mp hx
    simp only [List.mem_singleton] at hi
    subst hi
    simp only [instrWs, corrWs, List.mem_cons, List.nil_append, List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl <;> assumption

theorem ok_loanWindow {c : Wire → Bool} (g0 flag cc : Wire) (P : Program) (hg : c g0 = true)
    (hf : c flag = true) (hP : Ok (fun x => c (Equiv.swap cc g0 x)) P) :
    Ok c (ControlLoan1589.loanWindow g0 flag cc P) := by
  intro x hx
  have h := ControlLoan1589.loanWindow_support g0 flag cc P hx
  rcases Finset.mem_union.mp h with h | h
  · rcases Finset.mem_insert.mp h with rfl | h
    · exact hg
    · rw [Finset.mem_singleton.mp h]
      exact hf
  · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp h
    exact hP y hy

theorem tripleMap_mem (a b cc : Nat) (y : Wire) :
    tripleMap a b cc y ∈ [g 0 a, s 0 a, g 0 b, s 0 b, g 0 cc, s 0 cc] := by
  simp only [tripleMap]
  split_ifs <;> simp

theorem ok_triple {c : Wire → Bool} (a b cc : Nat) (P : Program)
    (h : [g 0 a, s 0 a, g 0 b, s 0 b, g 0 cc, s 0 cc].all c = true) : Ok c (triple a b cc P) := by
  apply ok_rename
  intro y _
  exact List.all_eq_true.mp h _ (tripleMap_mem a b cc y)

/-- Envelope of the lifetime half (`Q6EndpointCell.half_support`) and its seven omissions. -/
def env : List Wire := base 2409 :: Q6EndpointCell.ids.map base
def bad : List Wire := [base 760, base 765, base 766, base 767, base 1026, base 1541, base 2312]

theorem half_env (d : Bool) (z : Wire) (hz : z ∈ wires (R2Life760.half760 d)) : z ∈ env ∧ z ∉ bad := by
  obtain ⟨n760, hq⟩ := Finset.mem_erase.mp (R2Life760.half760_support d hz)
  have W := Q6EndpointCell.half_support d base (base 2409) env.toFinset (Finset.Subset.refl _) hq
  refine ⟨List.mem_toFinset.mp W, ?_⟩
  have a1541 := Q6EndpointRetired.half_avoid (fun d => Q6EndpointOmissions.kernel_free d 1541 (by decide)) d
  have a1026 := Q6EndpointFree1026.half_avoid (fun d => Q6EndpointOmissions.kernel_free d 1026 (by decide)) d
  have a2312 := Q6EndpointFree2312.half_avoid (fun d => Q6EndpointOmissions.kernel_free d 2312 (by decide)) d
  have a766 := Q6EndpointFree766.half_avoid (fun d => Q6EndpointOmissions.kernel_free d 766 (by decide)) d
  have a765 := Q6EndpointFree765.half_avoid (fun d => Q6EndpointOmissions.kernel_free d 765 (by decide)) d
  have a767 := Q6EndpointFree767.half_avoid (fun d => Q6EndpointOmissions.kernel_free d 767 (by decide)) d
  intro hb
  simp only [bad, List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact n760 rfl
  · exact a765 hq
  · exact a766 hq
  · exact a767 hq
  · exact a1026 hq
  · exact a1541 hq
  · exact a2312 hq

theorem ok_halfWindow {c : Wire → Bool} (d : Bool) (a h : Nat) (hg : c (g 0 a) = true)
    (hf : c (base 2409) = true)
    (hh : env.all (fun z => decide (z ∈ bad) ||
      c (Equiv.swap (packetCarry 0) (g 0 a) (Equiv.swap (base 719) (s 0 h) z))) = true) :
    Ok c (halfWindow d 0 a h) := by
  show Ok c (ControlLoan1589.loanWindow (g 0 a) (base 2409) (packetCarry 0)
    (renameProgram (Equiv.swap (base 719) (s 0 h)) (R2Life760.half760 d)))
  apply ok_loanWindow _ _ _ _ hg hf
  apply ok_rename
  intro z hz
  obtain ⟨he, hb⟩ := half_env d z hz
  have t := List.all_eq_true.mp hh z he
  simp only [Bool.or_eq_true, decide_eq_true_eq] at t
  exact t.resolve_left hb

/-- `JointInverse1588.kernelSites` as a list. -/
def kList : List Wire :=
  JointInverse1588.portsJ.r++JointInverse1588.portsJ.y++JointInverse1588.portsJ.carry.take 254++
    [JointInverse1588.portsJ.parity,JointInverse1588.portsJ.lower,JointInverse1588.portsJ.one,
      JointInverse1588.portsJ.sign,base 1028,base 1,base 1032]
def badP : List Wire := [base 0, base 516, base 719, base 1541, base 760]

def maskL : List Nat → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| maskL xs

theorem testBit_maskL : ∀ (l : List Nat) (q : Nat), (maskL l).testBit q = decide (q ∈ l)
  | [], q => by simp [maskL]
  | x :: xs, q => by
    simp only [maskL, Nat.testBit_or, testBit_maskL xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm




def Q (x : Wire) : Bool := fpSup (OB5.sig 511 (shifted (Placement5.pi 0) x))
/-- `Q` inside the G0 carry loan `G0CarryLoan5.program (base 1028) (base 0) (base 768)`. -/
def QF (x : Wire) : Bool := Q (Equiv.swap (base 768) (base 0) x)

/-! ### K6 (replay budget): kernel-fast forms of `QF` (`cond` / `Nat.ble` / `Nat.beq` only) -/

theorem bleD (a b : Nat) : Nat.ble a b = decide (a ≤ b) := by
  rw [Bool.eq_iff_iff, Nat.ble_eq, decide_eq_true_iff]
theorem bltD (a b : Nat) : Nat.blt a b = decide (a < b) := by
  rw [Bool.eq_iff_iff, Nat.blt_eq, decide_eq_true_iff]
theorem beqD (a b : Nat) : Nat.beq a b = decide (a = b) := by
  rw [Bool.eq_iff_iff, Nat.beq_eq, decide_eq_true_iff]

/-- `fpSup`, kernel-fast. -/
def fpSupB (w : Wire) : Bool := Nat.blt w 2426 && (
  (Nat.ble 16 w && Nat.ble w 20) || (Nat.ble 528 w && Nat.ble w 530) ||
  Nat.beq w 733 || (Nat.ble 736 w && Nat.ble w 775) ||
  (Nat.ble 777 w && Nat.ble w 780) || (Nat.ble 786 w && Nat.ble w 1041) ||
  (Nat.ble 1043 w && Nat.ble w 1048) ||
  (Nat.ble 1051 w && Nat.ble w 1298 &&
    (Nat.beq ((w - 1051) % 5) 0 || Nat.beq ((w - 1051) % 5) 2)) ||
  Nat.beq w 1556 ||
  (Nat.ble 1560 w && Nat.ble w 1810 &&
    (Nat.beq ((w - 1560) % 5) 0 || Nat.beq ((w - 1560) % 5) 2)) ||
  (Nat.ble 1812 w && Nat.ble w 1813) || (Nat.ble 2072 w && Nat.ble w 2327) ||
  Nat.beq w 2425)

theorem fpSup_eqB (w : Wire) : fpSup w = fpSupB w := by
  simp only [fpSupB, bleD, bltD, beqD]; rfl

def sigB (q : Nat) : Nat :=
  cond ((Nat.ble 1301 q && Nat.ble q 1555) || (Nat.ble 2069 (q + 511) && Nat.ble q 1812)) (3113 - q) q

theorem sig_eqB (q : Nat) : OB5.sig 511 q = sigB q := by
  unfold OB5.sig sigB
  simp only [cond_eq_ite, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq]

def pi0B (y : Nat) : Nat :=
  cond (Nat.ble 515 y && Nat.ble y 718) (1030 + 5 * ((y - 515) / 2) + 2 * ((y - 515) % 2))
    (cond (Nat.ble 1030 y && (Nat.ble y 1537 &&
        (Nat.beq ((y - 1030) % 5) 0 || Nat.beq ((y - 1030) % 5) 2)))
      (515 + (2 * ((y - 1030) / 5) + (y - 1030) % 5 / 2)) y)

theorem pi0_eqB (y : Nat) : Placement5.pi0 y = pi0B y := by
  unfold pi0B
  simp only [cond_eq_ite, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq]
  by_cases hw : 515 ≤ y ∧ y ≤ 718
  · rw [if_pos hw]
    have hk : y - 515 < 204 := by omega
    have e : Placement5.W (y - 515) = y := by unfold Placement5.W; omega
    have t := Placement5.pi0_W (y - 515) hk
    rw [e] at t
    rw [t]; rfl
  · rw [if_neg hw]
    by_cases hh : 1030 ≤ y ∧ y ≤ 1537 ∧ ((y - 1030) % 5 = 0 ∨ (y - 1030) % 5 = 2)
    · rw [if_pos hh]
      obtain ⟨h1, h2⟩ := Placement5.hole_recover y hh
      have t := Placement5.pi0_H _ h1
      rw [h2] at t
      rw [t]; rfl
    · rw [if_neg hh]
      exact Placement5.pi0_outside y (fun h => h.elim hw hh)

def piB (y : Nat) : Nat :=
  pi0B (StairPlaceFast.swB 1032 1537 (StairPlaceFast.swB 1030 1535
    (StairPlaceFast.swB 516 1032 (StairPlaceFast.swB 515 1030 y))))

theorem pi_eqB (y : Nat) : Placement5.pi 0 y = piB y := by
  unfold piB
  simp only [Placement5.pi, Equiv.trans_apply, StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq,
    ← pi0_eqB]
  rfl

def shB (q : Nat) : Nat := cond (Nat.blt q 16) q (piB (q - 16) + 16)

theorem shifted_eqB (q : Nat) : shifted (Placement5.pi 0) q = shB q := by
  show shiftedFn _ q = _
  unfold shiftedFn shB
  rw [cond_eq_ite, ← pi_eqB]
  simp only [Nat.blt_eq]

/-- `QF`, kernel-fast. -/
def QFB (x : Wire) : Bool := fpSupB (sigB (shB (StairPlaceFast.swB 784 16 x)))

theorem QF_eqB : QF = QFB := by
  funext x
  unfold QF Q QFB
  rw [StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq, shifted_eqB, sig_eqB, fpSup_eqB]
  rfl

/-- `decide (· ∈ bad)`, kernel-fast. -/
def badB (z : Wire) : Bool :=
  Nat.beq z (base 760) || Nat.beq z (base 765) || Nat.beq z (base 766) || Nat.beq z (base 767) ||
    Nat.beq z (base 1026) || Nat.beq z (base 1541) || Nat.beq z (base 2312)

theorem badB_eq (z : Wire) : decide (z ∈ bad) = badB z := by
  simp only [bad, badB, List.mem_cons, List.not_mem_nil, or_false, Bool.decide_or, beqD, Bool.or_assoc]

/-- `decide (· ∈ badP)`, kernel-fast. -/
def badPB (z : Wire) : Bool :=
  Nat.beq z (base 0) || Nat.beq z (base 516) || Nat.beq z (base 719) || Nat.beq z (base 1541) ||
    Nat.beq z (base 760)

theorem badPB_eq (z : Wire) : decide (z ∈ badP) = badPB z := by
  simp only [badP, badPB, List.mem_cons, List.not_mem_nil, or_false, Bool.decide_or, beqD, Bool.or_assoc]

theorem env_hyp_eqB (c : Wire → Bool) (a h : Nat) :
    env.all (fun z => decide (z ∈ bad) ||
      c (Equiv.swap (packetCarry 0) (g 0 a) (Equiv.swap (base 719) (s 0 h) z))) =
    env.all (fun z => badB z ||
      c (StairPlaceFast.swB (packetCarry 0) (g 0 a) (StairPlaceFast.swB (base 719) (s 0 h) z))) := by
  congr 1
  funext z
  rw [badB_eq, StairPlaceFast.swap_eq_sw, StairPlaceFast.swap_eq_sw, ← StairPlaceFast.swB_eq,
    ← StairPlaceFast.swB_eq]

/-! K6: one envelope pass shared by the three cells; the cell swaps only move the seven
special labels `k6S`, which are checked per cell. -/

def k6S : List Wire := [packetCarry 0, base 719, g 0 2, g 0 3, g 0 4, s 0 2, s 0 4]

def k6specB (z : Wire) : Bool :=
  Nat.beq z (packetCarry 0) || (Nat.beq z (base 719) || (Nat.beq z (g 0 2) || (Nat.beq z (g 0 3) ||
    (Nat.beq z (g 0 4) || (Nat.beq z (s 0 2) || Nat.beq z (s 0 4))))))

theorem k6_ne_of_beq {a b : Nat} (h : Nat.beq a b = false) : a ≠ b := by
  intro e
  subst e
  simp [Nat.beq_refl] at h

theorem k6_swsw (p q r t z : Nat) (h1 : z ≠ p) (h2 : z ≠ q) (h3 : z ≠ r) (h4 : z ≠ t) :
    StairPlaceFast.swB p q (StairPlaceFast.swB r t z) = z := by
  rw [StairPlaceFast.swB_eq, StairPlaceFast.swB_eq]
  unfold StairPlaceFast.sw
  simp [h1, h2, h3, h4]

theorem k6_cell (a h : Nat) (ha : g 0 a ∈ k6S) (hh : s 0 h ∈ k6S)
    (hG : env.all (fun z => badB z || k6specB z || QFB z) = true)
    (hC : k6S.all (fun z => !(maskL env).testBit z || badB z ||
      QFB (StairPlaceFast.swB (packetCarry 0) (g 0 a) (StairPlaceFast.swB (base 719) (s 0 h) z)))
      = true) :
    env.all (fun z => badB z ||
      QFB (StairPlaceFast.swB (packetCarry 0) (g 0 a) (StairPlaceFast.swB (base 719) (s 0 h) z)))
      = true := by
  rw [List.all_eq_true] at hG ⊢
  intro z hz
  cases hsp : k6specB z
  · have t := hG z hz
    rw [hsp, Bool.or_false] at t
    simp only [k6specB, Bool.or_eq_false_iff] at hsp
    obtain ⟨n1, n2, n3, n4, n5, n6, n7⟩ := hsp
    have hnot : z ∉ k6S := by
      intro hm
      simp only [k6S, List.mem_cons, List.not_mem_nil, or_false] at hm
      rcases hm with e | e | e | e | e | e | e
      exacts [k6_ne_of_beq n1 e, k6_ne_of_beq n2 e, k6_ne_of_beq n3 e, k6_ne_of_beq n4 e,
        k6_ne_of_beq n5 e, k6_ne_of_beq n6 e, k6_ne_of_beq n7 e]
    rw [k6_swsw _ _ _ _ z (k6_ne_of_beq n1) (fun e => hnot (e ▸ ha)) (k6_ne_of_beq n2)
      (fun e => hnot (e ▸ hh))]
    exact t
  · have hm : z ∈ k6S := by
      simp only [k6specB, Bool.or_eq_true, Nat.beq_eq] at hsp
      simp only [k6S, List.mem_cons, List.not_mem_nil, or_false]
      exact hsp
    have t := List.all_eq_true.mp hC z hm
    rw [testBit_maskL, decide_eq_true hz, Bool.not_true, Bool.false_or] at t
    exact t

theorem kList_hyp_eqB (c : Wire → Bool) :
    kList.all (fun z => decide (z ∈ badP) || c z) = kList.all (fun z => badPB z || c z) := by
  congr 1
  funext z
  rw [badPB_eq]

theorem ok_paddedD {c : Wire → Bool} (h : kList.all (fun z => decide (z ∈ badP) || c z) = true) :
    Ok c JointInverse1588.paddedD := by
  intro z hz
  have m : z ∈ kList := List.mem_toFinset.mp (JointInverse1588.paddedD_support hz)
  have hb : z ∉ badP := by
    intro hb
    simp only [badP, List.mem_cons, List.not_mem_nil, or_false] at hb
    rcases hb with rfl | rfl | rfl | rfl | rfl
    · exact JointInverse1588.paddedD_free 0 (Or.inl rfl) hz
    · exact JointInverse1588.paddedD_free 516 (Or.inr (Or.inl rfl)) hz
    · exact JointInverse1588.paddedD_free 719 (Or.inr (Or.inr (Or.inl rfl))) hz
    · exact JointInverse1588.paddedD_free 1541 (Or.inr (Or.inr (Or.inr rfl))) hz
    · exact JointInverse1588.paddedD_760_free hz
  have t := List.all_eq_true.mp h z m
  simp only [Bool.or_eq_true, decide_eq_true_eq] at t
  exact t.resolve_left hb

theorem ok_cell {c : Wire → Bool} (a h : Nat) (hsw : Ok c FrontierSW1591.swapBody)
    (hs : c (s 0 a) = true) (hb : c (base 2409) = true) (hg : c (g 0 a) = true)
    (hh : env.all (fun z => decide (z ∈ bad) ||
      c (Equiv.swap (packetCarry 0) (g 0 a) (Equiv.swap (base 719) (s 0 h) z))) = true) :
    Ok c (cell false 0 a h) :=
  ok_append (ok_selW _ _ _ hs hb hsw) (ok_halfWindow false a h hg hb hh)

theorem body_ok : Ok QF (firstBodyShort false) := by
  rw [QF_eqB]
  have hG : env.all (fun z => badB z || k6specB z || QFB z) = true := by decide +kernel
  have hsw : Ok QFB FrontierSW1591.swapBody := ok_of_all (by decide +kernel)
  have t0 : Ok QFB (triple 3 1 2 e3short) := ok_triple _ _ _ _ (by decide +kernel)
  have c1 : Ok QFB (cell false 0 4 2) :=
    ok_cell 4 2 hsw (by decide +kernel) (by decide +kernel) (by decide +kernel)
      (by rw [env_hyp_eqB]; exact k6_cell _ _ (by decide) (by decide) hG (by decide +kernel))
  have t2 : Ok QFB (triple 3 1 2 d3short) := ok_triple _ _ _ _ (by decide +kernel)
  have t3 : Ok QFB (triple 4 1 2 e3short) := ok_triple _ _ _ _ (by decide +kernel)
  have c4 : Ok QFB (cell false 0 3 2) :=
    ok_cell 3 2 hsw (by decide +kernel) (by decide +kernel) (by decide +kernel)
      (by rw [env_hyp_eqB]; exact k6_cell _ _ (by decide) (by decide) hG (by decide +kernel))
  have t5 : Ok QFB (triple 4 1 2 d3) := ok_triple _ _ _ _ (by decide +kernel)
  have t6 : Ok QFB (triple 1 3 4 e3) := ok_triple _ _ _ _ (by decide +kernel)
  have c7 : Ok QFB (cell false 0 2 4) :=
    ok_cell 2 4 hsw (by decide +kernel) (by decide +kernel) (by decide +kernel)
      (by rw [env_hyp_eqB]; exact k6_cell _ _ (by decide) (by decide) hG (by decide +kernel))
  have t8 : Ok QFB (triple 1 3 4 d3short) := ok_triple _ _ _ _ (by decide +kernel)
  have t9 : Ok QFB (triple 2 3 4 e3short) := ok_triple _ _ _ _ (by decide +kernel)
  have s10 : Ok QFB (SW.selW (s 0 1) (base 2409) FrontierSW1591.swapBody) :=
    ok_selW _ _ _ (by decide +kernel) (by decide +kernel) hsw
  have p11 : Ok QFB JointInverse1588.paddedD := ok_paddedD (by rw [kList_hyp_eqB]; decide +kernel)
  have t12 : Ok QFB (triple 2 3 4 d3) := ok_triple _ _ _ _ (by decide +kernel)
  exact ok_append t0 (ok_append (ok_append (ok_append (ok_append (ok_append (ok_append (ok_append
    (ok_append (ok_append (ok_append (ok_append c1 t2) t3) c4) t5) t6) c7) t8) t9) s10) p11) t12)

theorem core_ok : Ok Q (firstCore false) := by
  show Ok Q (firstDecodeShort ++ G0CarryLoan5.program (base 1028) (base 0) (base 768) (firstBodyShort false) ++ Prefix1590.firstEncode)
  refine ok_append (ok_append (ok_of_all (by decide +kernel)) ?_) (ok_of_all (by decide +kernel))
  show Ok Q (G0CarryLoan5.expose (base 1028) (base 0) ++
    renameProgram (Equiv.swap (base 768) (base 0)) (firstBodyShort false) ++ G0CarryLoan5.restore (base 1028) (base 0))
  exact ok_append (ok_append (ok_of_all (by decide +kernel)) (ok_rename _ _ body_ok)) (ok_of_all (by decide +kernel))

theorem passSup : allSites fpSup (Rolling1588.placedFirstPacket false) = true :=
  allSites_of_ok (ok_rename _ _ (ok_rename _ _ core_ok))

