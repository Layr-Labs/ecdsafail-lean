  obtain ⟨i,hi,e⟩:=List.mem_iff_getElem.mp hq
  simp only [List.length_take] at hi
  rw [List.getElem_take] at e
  exact List.mem_iff_getElem.mpr ⟨i,by simp;omega,by simpa using e⟩

