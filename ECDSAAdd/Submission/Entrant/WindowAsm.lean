  triple 1 3 4 d3 ++ triple 4 1 2 e3 ++ cell true 0 3 2 ++
  triple 4 1 2 d3short ++ triple 3 1 2 e3short ++ cell true 0 4 2 ++
  triple 3 1 2 d3


def firstHead : Program :=
