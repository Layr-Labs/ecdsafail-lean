theorem junction_coherent_physical (xs ys cs : List Wire) (a t z cin : Wire)
    (hy : ys.length=xs.length) (hc : cs.length=xs.length)
    (nd : (a::t::z::cin::(xs++ys++cs)).Nodup) :
