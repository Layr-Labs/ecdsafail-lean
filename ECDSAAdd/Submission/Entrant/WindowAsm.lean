  rcases input with ⟨low,top,ys,⟨parity,lower,one⟩,clean,frame⟩
  have keep (q : Wire) (hq : q≠L.lower) : (run [.X L.lower] m s).basis q=s.basis q := by
    simp [run,writeBit,hq]
