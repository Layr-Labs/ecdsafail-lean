    SlotShift P Q 0 n := by unfold SlotShift;omega


theorem SlotShift.shrink (P Q : Program) (n : Nat) (h : gateSlots P+n=gateSlots Q) :
    SlotShift P Q n 0 := by unfold SlotShift;omega


