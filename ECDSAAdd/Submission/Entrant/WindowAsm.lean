  rcases hs with ⟨value,ys,flags,clean,frame⟩
  rcases flags with ⟨parity,lower,one⟩
  have input : regValue (rawTarget L) s.basis=encodeWord 257 T/2 := by
    rw [rawTarget,regValue_append,value]
    simp [regValue,one]
