      omega
    rw [carry _ bounds.1 bounds.2]
    apply clear
    simp only [Leave225BoundaryClean.zeros,List.mem_append,List.mem_range'_1]
    simp [Enter240.pending,Wire] at pending
    simp only [Wire] at *
    omega
