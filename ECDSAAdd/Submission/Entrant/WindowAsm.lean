-- ===== RouteASlotShape =====
section
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
namespace ECDSAAdd.Entrant.RouteA
open Arithmetic


def mappedShapeSlots : List (Bool×Bool) → Nat
  | [] => 0
