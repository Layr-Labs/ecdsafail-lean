theorem junction_emit_resources (retired : Wire) (L : Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : retired∈L.carry.take 254) :
    JunctionSafe ((junctionFootprint L).erase retired) (emitOdd retired L) ∧
