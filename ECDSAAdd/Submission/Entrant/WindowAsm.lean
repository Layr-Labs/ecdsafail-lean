/-- One ripple column converts the numeric threshold to its high tail. -/
theorem compare_threshold (A B C : Bool) (X Y n : Nat) :
    decide (2^(n+1)≤(A.toNat+2*X)+(B.toNat+2*Y)+C.toNat)=
