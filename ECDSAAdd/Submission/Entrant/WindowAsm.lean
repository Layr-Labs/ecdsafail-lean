    ((if B then 2^n-1-X else X)+Y+B.toNat)%2^n=signedWordValue n B X Y := by
  cases B
  · simp [signedWordValue,Nat.add_comm]
  · simp only [signedWordValue,if_true,Bool.toNat_true]
    congr 1
