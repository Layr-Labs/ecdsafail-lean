theorem accept_odd_boundary (retired : Wire) (L : Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : retired∈(L.carry.take 254).drop 1)
    (origin : BasisState) (R Y : Int) (hr : OddDomain R) :
