    intro bad
    have h := List.nodup_iff_count.mp nd q
    have a := List.count_pos_iff.mpr hq
    have b := List.count_pos_iff.mpr bad
    simp only [List.count_cons,List.count_append,List.count_nil] at h a b
    omega
