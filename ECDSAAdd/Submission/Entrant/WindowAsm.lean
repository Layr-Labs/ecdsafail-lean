    (hy : ys.length=xs.length) (hc : cs.length=xs.length) :
    wires (CoherentTail.addPrefix xs ys cs a t z cin)⊆(a::t::z::cin::(xs++ys++cs)).toFinset := by
  induction xs generalizing ys cs cin with
