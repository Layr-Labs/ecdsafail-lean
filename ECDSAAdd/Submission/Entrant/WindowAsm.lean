def oddNormalized (F : Int) : Int := magnitude F-h


def oddComparisonLeft (F : Int) : Int :=
  2*oddNormalized F+(if F<0 then 0 else 1)


def oddComparisonY (s : Bool) (F Y : Int) : Int :=
