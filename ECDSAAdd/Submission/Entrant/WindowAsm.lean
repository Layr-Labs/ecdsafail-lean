    (run window m s).basis t=foldTop_mode oddMode sub (s.basis p) S ∧
    (run window m s).basis l=false ∧ (run window m s).basis o=false ∧
    ∀q,q∉ys → q≠t → q≠l → q≠o → (run window m s).basis q=s.basis q := by
