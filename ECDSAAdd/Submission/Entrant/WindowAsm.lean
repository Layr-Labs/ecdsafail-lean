    ⟨uc _ (by simp [work]),uc _ (by simp [work]),uc _ (by simp [work])⟩
  have carry : CleanExcept (L.carry.take 254) retired u.basis := by
    intro q hq qr
    exact uc q (by simp [work,List.mem_of_mem_take hq])
