          itauto
        · have h := junction_erase_support x y cin c h
          simp only [Finset.mem_insert,Finset.mem_singleton] at h
          itauto
        · have h : q=cin ∨ q=y ∨ q=x := by
            simpa [wires,Instr.wires,or_assoc,or_left_comm,or_comm] using h
          itauto

