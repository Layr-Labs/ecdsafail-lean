    out.phase=s.phase ∧ regValue smallM out.basis=(mag/2^145)%2^10 ∧
    out.basis 1556=decide (2^144≤mag) ∧ (∀i<112,out.basis (live i)=(Leave225TrueMiddle.F z).testBit i) := by
  let a:=run entry m s
  let n:=m.drop (measurementCount entry)
