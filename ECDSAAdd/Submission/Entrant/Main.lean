  let hi := (List.range H).map fun i => bankW15E s (L + i)
  let seq := fun i => if i = 0 then top else bankW15E s (L + i - 1)
  [.x top] ++ xsG hi ++ chainG (storeW15E s) seq [.cx (storeW15E s (H + 1)) 1557, .x 1557] 0 (H + 1) ++
  xsG hi.reverse ++ [.x top]

