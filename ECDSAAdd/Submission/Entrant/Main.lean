theorem hostedExitN_pwD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hX : ExitSupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (k : Nat) (hk : k < p) (X Y : Nat) (hX' : X < p) (hX0 : 0 < X) (hY : Y < p)
    (s : State) (m : List Bool)
    (hx : regValue L.point.x s.basis=X) (hy : regValue L.point.y s.basis=Y)
    (hc : regValue L.dialogPool s.basis=0) :
    run (FrontierEntry1591Callers.exit (StairHostsSchedule.exitKernel
        StairConcreteAssembly.checkpointPrimitives StairConcreteAssembly.hostPlan k) L) m s =
      put (run (FrontierEntry1591Callers.exit (kernelX k) L) m s) (wireFn2 L pkP)
        (s.basis L.core.generic && decide (k<X)) := by
  have yValue : (Y:Fp).val=Y := ZMod.val_natCast_of_lt hY
  rcases placement2 L hw hn with ⟨_,divisorMap,numeratorMap,
    controlMap,_,selectorG,selectorS,_⟩
  have pkD : pkP∈callerDomain := by
    have := E1QubitPlacement.sw_logical 724 (by unfold E1QubitPlacement.Rng; omega)
    exact logical_sub_caller (by simpa [E1QubitPlacement.sw,pkP] using this)
  have config := MappedCompressed.LaneA.laneLogical_config
  have above : History5.HistoryAbove base := by intro j hj; simp [base]
  have result := wordTransferN L (wireFn2 L) k callerDomain
    (wireFn2_injOn_caller L hw hn)
    divisorMap numeratorMap controlMap (sharedWork_caller L hw)
    selectorG selectorS divisor_caller numerator_caller generic_caller pkD X (Y:Fp) s m hx
    (hy.trans yValue.symm) hc
    (StairHostsSchedule.exitKernel StairConcreteAssembly.checkpointPrimitives
      StairConcreteAssembly.hostPlan k) (kernelX k) (hX k)
    ((kernelX_support k).trans logical_sub_caller)
    (fun t records input hg hs => StairCallerReplay.hostedExit_pw H k hk
      config.1 above config.2.1 config.2.2 X (Y:Fp) hX0 hX' t records input hg hs)
  simpa only [FrontierEntry1591Callers.exit] using result

end ExitKernel

