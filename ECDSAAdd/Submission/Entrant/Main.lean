    simp only [StairWireCheck.allSites,List.all_append,Bool.and_eq_true] at a b ⊢
    exact ⟨a,b⟩
  have bk:∀ j∈[10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 71, 74, 77, 80, 83],StairWireCheck.allSites (fun q=>decide (16 ≤ q ∧ q < 2330))
