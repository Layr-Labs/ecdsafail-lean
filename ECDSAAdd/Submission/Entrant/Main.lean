/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCertificate_at_Main` -/
section Merge_StairCertificate_at_Main

/-!
# Final staircase certificate boundary

This module keeps the final outer program as data because the record wrapper
has not yet selected the new kernels.  Every circuit-local fact has its own
named field, while the outer wrapper composition remains a separate premise.
The certificate proof itself uses the checked staircase ledgers, omission
inventory, and normalizer theorems.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCertificate

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines

/-- Data selected by the final integrator.  `program` is the unnormalized
outer entry, `place` maps the local omission inventory into the final arena,
and `primitives` is the repaired concrete checkpoint implementation. -/
structure Assembly where
  program : Point → Program
  place : Wire → Wire
  layout : Nat → StairCodec.Layout
  primitives : StairSchedule.StairPrimitives
  /-- The host plan of the hosted kernels that occur in `program` (v3). -/
  hostPlan : StairHostsSchedule.HostPlan
  entryPre : State → Prop
  exitPre : Nat → State → Prop

def stairEntry (A : Assembly) : Challenge.Entry :=
  fun C => normalizeProgram (A.program C)



/-- The LT1 functional theorem at every budget used by the best schedule. -/
def CodecFunctionalSpec (A : Assembly) : Prop :=
  ∀ B, B ∈ StairSchedule.checkpoints.map Prod.snd →
    StairCodec.FunctionalSpec (A.layout B) B

/-- Repaired codec/segment replay, including sign extension, local first-tick
semantics, reverse segments, and the concrete schedule placement.  This avoids
the over-strong relation stored by the earlier rich wrapper. -/
def CheckpointReplaySpec (A : Assembly) : Prop :=
  ∀ k, StairReplayPlan.PrimitiveReplay A.primitives k
    A.entryPre (A.exitPre k)

/-- Aggregate loan replay after the two half directions and multiplication
endpoint have been lifted through all packet and schedule wrappers. -/
def LoanReplaySpec (A : Assembly) : Prop :=
  ∀ k, StairReplayPlan.LoanReplay A.primitives StairConcrete.bestLoans k
    A.entryPre (A.exitPre k)



/-- Field 13: the hosted kernels that occur in the final program replay the
logical staircase kernels on the exact kernel preconditions, with independent
measurement tapes.  The host plan is the assembly's own `A.hostPlan` (v3:
`StairV3Primitives.hostPlan`), i.e. the plan of the kernels in `A.program`. -/
def HostReplaySpec (A : Assembly) : Prop :=
  (∀ s, A.entryPre s → ∀ hosted logical,
    run (StairHostsSchedule.entryKernel A.primitives
        A.hostPlan) hosted s =
      run (StairSchedule.entryKernel A.primitives
        StairConcrete.bestLoans) logical s) ∧
  (∀ k s, A.exitPre k s → ∀ hosted logical,
    run (StairHostsSchedule.exitKernel A.primitives
        A.hostPlan k) hosted s =
      run (StairSchedule.exitKernel A.primitives
        StairConcrete.bestLoans k) logical s)

/-! ## Qubit bound, parametric in the proved hole list

`HoleList holes` are static facts about a concrete list of omitted arena
sites (decidable); `HolePlacement holes P` says the program avoids the 15
record omissions and every listed hole.  The bound is
`qubits P ≤ 1601 − 15 − holes.length`, so a partial field 12 (fewer holes
proved free) still yields a valid, smaller improvement; the full v3 placement
is `holes = StairPhysicalInventory.physicalHoles` (44 holes, Q = 1,542, see
`StairCertificateV3`). -/




/-- Every theorem not yet available at the final integration boundary.

The two directional half fields and `half_support` are combined below with
the already checked zero-depth, count, and physicality theorems.  The outer
composition field therefore consumes the exact compiled half interface rather
than a stronger program-level assumption. -/
structure StairOpen (A : Assembly) (holes : List Wire) : Prop where
  codec_functional : CodecFunctionalSpec A
  checkpoint_composition : CodecFunctionalSpec A → CheckpointReplaySpec A
  loan_forward : PositiveHalfRunSpec true
  loan_inverse : PositiveHalfRunSpec false
  half_support : WholeHalfSupport
  endpoint_run : StairEndpointLoan44.MultiplicationRunSpec44
  loan_composition :
    StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide) →
    StairEndpointLoan44.MultiplicationRunSpec44 →
    LoanReplaySpec A
  semantic_composition :
    (∀ k, StairSchedule.ReplayInterface A.primitives StairConcrete.bestLoans k
      A.entryPre (A.exitPre k)) →
    ∀ C b R, Triple (encodes b R) (A.program C)
      (encodes b (if b then R + C else R))
  physical_composition :
    StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide) →
    ∀ C, GatePhysical (A.program C)
  count_composition : ∀ C,
    toffoliCount (A.program C) ≤ 2170000 ∧ measurementCount (A.program C) ≤ 1521500
  slot_composition : ∀ C,
    gateSlots (A.program C) ≤
      gateSlots (AboveFieldPointDevelop.programQ C) + StairInventory.bestSlotDelta
  site_avoidance : ∀ C, HolePlacement holes (A.program C)
  host_replay : HostReplaySpec A

/-- Assemble the complete half interface from the three remaining peer facts
and the count/physicality theorems already present in the staircase bundle. -/
theorem half760_interface {A : Assembly} {holes : List Wire} (h : StairOpen A holes) :
    StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide) where
  run_eq divide d hd origin clean X Y s fresh old input := by
    by_cases hz : d = 0
    · subst d
      exact StairLoan.half760Loan_zero_run_eq divide
        Rolling1588Lifetime.half_ports_nodup origin clean X Y s fresh old input
    · have hp : 0 < d := Nat.pos_of_ne_zero hz
      cases divide with
      | false => exact h.loan_inverse d hp hd origin clean X Y s fresh old input
      | true => exact h.loan_forward d hp hd origin clean X Y s fresh old input
  counts divide d hd := by
    have loan := StairLoan.half760Loan_counts d divide hd
    have record := R2Life760.half760_counts divide
    constructor <;> omega
  support divide d hd := h.half_support divide d hd
  physical divide d _ := StairLoanSupport.half760Loan_physical d divide

/-- Compose the repaired primitive replay and the loan replay through the
checked schedule transitivity theorem. -/
theorem replay_interfaces {A : Assembly} {holes : List Wire} (h : StairOpen A holes) :
    ∀ k, StairSchedule.ReplayInterface A.primitives StairConcrete.bestLoans k
      A.entryPre (A.exitPre k) := by
  intro k
  exact StairReplayPlan.replayInterface_of_parts A.primitives
    StairConcrete.bestLoans k A.entryPre (A.exitPre k)
    (h.loan_composition (half760_interface h) h.endpoint_run k)
    (h.checkpoint_composition h.codec_functional k)

theorem raw_correct {A : Assembly} {holes : List Wire} (h : StairOpen A holes) (C : Point)
    (b : Bool) (R : Point) :
    Triple (encodes b R) (A.program C)
      (encodes b (if b then R + C else R)) :=
  h.semantic_composition (replay_interfaces h) C b R

theorem raw_toffoli_le {A : Assembly} {holes : List Wire} (h : StairOpen A holes)
    (C : Point) : toffoliCount (A.program C) ≤ 2170000 :=
  (h.count_composition C).1

theorem raw_measurements_le {A : Assembly} {holes : List Wire} (h : StairOpen A holes)
    (C : Point) : measurementCount (A.program C) ≤ 1521500 :=
  (h.count_composition C).2

theorem raw_qubits_le {A : Assembly} {holes : List Wire} (h : StairOpen A holes)
    (hl : HoleList holes) (C : Point) :
    qubits (A.program C) ≤ 1586 - holes.length :=
  qubits_le_holes holes hl (A.program C) (h.site_avoidance C)

theorem raw_slots_le {A : Assembly} {holes : List Wire} (h : StairOpen A holes)
    (C : Point) : gateSlots (A.program C) ≤ 51155937 := by
  exact StairInventory.best_program_slots
    (AboveFieldPointDevelop.programQ C) (A.program C)
    (AboveFieldPointDevelop.program_slots_Q C) (h.slot_composition C)

/-- v3 certificate, parametric in the list of holes proved free: the qubit
bound is `1601 − 15 − holes.length` (1,542 for the 44 `physicalHoles`). -/
theorem certificate_of {A : Assembly} {holes : List Wire} (h : StairOpen A holes)
    (hl : HoleList holes) :
    Challenge.Certificate (stairEntry A)
      (v3Bounds (1586 - holes.length)) where
  correct C b R := (normalize_triple _ _ _).mpr (raw_correct h C b R)
  physical C := Baselines.normalize_physical _ (by
    simpa only [GatePhysical] using
      h.physical_composition (half760_interface h) C)
  toffoli_le C := by
    change toffoliCount (normalizeProgram (A.program C)) ≤ 2170000
    exact (normalize_toffoli _).trans (raw_toffoli_le h C)
  measurements_le C := by
    change measurementCount (normalizeProgram (A.program C)) ≤ 1521500
    rw [normalize_measurements]
    exact raw_measurements_le h C
  qubits_le C := by
    change qubits (normalizeProgram (A.program C)) ≤ 1586 - holes.length
    rw [normalize_qubits]
    exact raw_qubits_le h hl C
  gateSlots_le C := by
    change gateSlots (normalizeProgram (A.program C)) ≤ 51155937
    rw [Baselines.normalize_slots]
    exact raw_slots_le h C

end ECDSAAdd.Entrant.StairCertificate

end
end Merge_StairCertificate_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Replay_at_Main` -/
section Merge_StairField2V3Replay_at_Main

/-!
# LT21: generic replay composition for field 2 (CANON v3)

The generic part of `StairCheckpointReplay` (from `RunEqOn` to
`checkpoint_composition`, verbatim) — that module's old eight-row section no
longer builds on v3 (`row_budget_mem` names the old budgets) — together with
LT14's placement-independent tape algebra (`StairChainAlgebra`) and
relational steps (`StairChainSteps`), in one namespace.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3Replay

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField






/-- The division computation up to (but excluding) the unchanged inverse
integer close.  This is a fixed, named record program rather than a caller-
supplied list component. -/
def entrySelectedArithmetic (A : StairCertificate.Assembly) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
      (StairSchedule.firstPhase A.primitives) ++
    StairSchedule.entryFieldHosted A.primitives StairSchedule.recordLoans


def entrySelectedClosing (_A : StairCertificate.Assembly) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
    (InverseFive23.lastPhase15 false)

def entryReferenceClosing : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
    (InverseFive23.lastPhase15 false)

/-- The multiplication opening is unchanged; the named remainder contains
the reverse staircase and its concrete `k`-dependent close. -/
def exitSelectedOpening (_A : StairCertificate.Assembly) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
    (Rolling1588TickGap.firstPhase false)


def exitSelectedRemainder (A : StairCertificate.Assembly) (k : Nat) : Program :=
  StairSchedule.exitFieldHosted A.primitives StairSchedule.recordLoans ++
    renameProgram Rolling1588Lifetime.phaseHost
      (StairSchedule.lastXN A.primitives k)

def exitReferenceRemainder (k : Nat) : Program :=
  Rolling1588.exitFieldHosted ++
    renameProgram Rolling1588Lifetime.phaseHost
      (ParityXExitInverse23Kernel.lastXN k)

theorem entrySelected_shape (A : StairCertificate.Assembly) :
    entrySelectedArithmetic A ++ entrySelectedClosing A =
      StairSchedule.entryKernel A.primitives StairSchedule.recordLoans := by
  simp only [entrySelectedArithmetic, entrySelectedClosing,
    StairSchedule.entryKernel, List.append_assoc]

theorem entryReference_shape :
    entryReferenceArithmetic ++ entryReferenceClosing =
      InverseFiveEntry23.entryKernel15 := by
  simp only [entryReferenceArithmetic, entryReferenceClosing,
    InverseFiveEntry23.entryKernel15, InverseFiveEntry23.kernel15,
    List.append_assoc]

theorem exitSelected_shape (A : StairCertificate.Assembly) (k : Nat) :
    exitSelectedOpening A ++ exitSelectedRemainder A k =
      StairSchedule.exitKernel A.primitives StairSchedule.recordLoans k := by
  simp only [exitSelectedOpening, exitSelectedRemainder,
    StairSchedule.exitKernel, List.append_assoc]

theorem exitReference_shape (k : Nat) :
    exitReferenceOpening ++ exitReferenceRemainder k =
      ParityXExitInverse23Kernel.kernelXN k := by
  simp only [exitReferenceOpening, exitReferenceRemainder,
    ParityXExitInverse23Kernel.kernelXN, List.append_assoc]

/-- Replay obligations over the four named, real program boundaries above.
Unlike the former length-10 wrapper, no program list or shape equality is
provided by the caller, so a whole kernel cannot be hidden in one slot with
the remaining slots empty. -/
structure ConcreteComposition (A : StairCertificate.Assembly) where
  entryMiddle : State → Prop
  entryArithmetic : StairCertificate.CodecFunctionalSpec A →
    ReplayStep A.entryPre entryMiddle
      (entrySelectedArithmetic A) entryReferenceArithmetic
  entryClosing : ReplayStep entryMiddle (fun _ => True)
    (entrySelectedClosing A) entryReferenceClosing
  exitMiddle : Nat → State → Prop
  exitOpening : ∀ k, ReplayStep (A.exitPre k) (exitMiddle k)
    (exitSelectedOpening A) exitReferenceOpening
  exitRemainder : StairCertificate.CodecFunctionalSpec A → ∀ k,
    ReplayStep (exitMiddle k) (fun _ => True)
      (exitSelectedRemainder A k) (exitReferenceRemainder k)

/-- Exact `StairOpen.checkpoint_composition` result, derived only by composing
smaller replay steps and the explicit concrete program decompositions. -/
theorem checkpoint_composition {A : StairCertificate.Assembly}
    (concrete : ConcreteComposition A) :
    StairCertificate.CodecFunctionalSpec A →
      StairCertificate.CheckpointReplaySpec A := by
  intro functional k
  constructor
  · intro s hs fresh old
    rw [← entrySelected_shape A, ← entryReference_shape]
    let chain : ReplayChain A.entryPre (fun _ => True)
        [entrySelectedArithmetic A, entrySelectedClosing A]
        [entryReferenceArithmetic, entryReferenceClosing] :=
      .cons (concrete.entryArithmetic functional)
        (.cons concrete.entryClosing (.nil _))
    simpa only [concatPrograms, List.append_nil] using
      replayChain_run_eq chain s hs fresh old
  · intro s hs fresh old
    rw [← exitSelected_shape A k, ← exitReference_shape k]
    let chain : ReplayChain (A.exitPre k) (fun _ => True)
        [exitSelectedOpening A, exitSelectedRemainder A k]
        [exitReferenceOpening, exitReferenceRemainder k] :=
      .cons (concrete.exitOpening k)
        (.cons (concrete.exitRemainder functional k) (.nil _))
    simpa only [concatPrograms, List.append_nil] using
      replayChain_run_eq chain s hs fresh old


/-! ## Measurement tapes -/
















end ECDSAAdd.Entrant.StairField2V3Replay

