namespace ECDSAAdd.Entrant.StairPacket.StockWalkWindow
open Arithmetic MappedCompressed Secp256k1 WideReference StockArchiveBanks StockWalkPrefix
set_option maxRecDepth 9500
set_option maxHeartbeats 3000000
attribute [local irreducible] run Rolling1588TickGap.forward Rolling1588.Integer.regularForward measurementCount Shadow20.MixedWindow425.forward425Cut
def NewNormalized (d:Bool) (x:Nat):Prop:=∀(raw:State)(m:List Bool),Rolling1588.Integer.Stage base d x p 45 raw.basis →
    Same (run (Shadow20.MixedWindow425.forward425Cut d) m (pullState (OB5.sig 44) raw)) (StockArchiveReference.common d raw)

theorem steady (d:Bool) (x:Nat) (good:Bounds x p) (i n:Nat) (lo:0 < i) (hi:i+n≤512) (s:State) (u v:List Bool) (stage:Rolling1588.Integer.Stage base d x p i s.basis):
    run (Rolling1588TickGap.forward d i n) u (pullState (OB5.sig (i-1)) s)=run (Rolling1588TickGap.forward d i n) v (pullState (OB5.sig (i-1)) s):=
  (StockDelayed.window d x good.nonzero good.small i n lo hi s u stage).trans
    (StockDelayed.window d x good.nonzero good.small i n lo hi s v stage).symm

theorem suffix_independent_false (n x:Nat) (good:Bounds x p) (bound:426+n≤512) (s:State)
    (stage:Rolling1588.Integer.Stage base false x p 45 s.basis) (u v y z:List Bool):
    let t:=pullState (OB5.sig 44) s
    let old:=Rolling1588TickGap.forward false 45 381
    let tail:=Rolling1588TickGap.forward false 426 n
    run tail u (run old v t)=run tail y (run old z t):=by
  let t:=pullState (OB5.sig 44) s
  let A:=Rolling1588TickGap.forward false 45 381
  let B:=Rolling1588TickGap.forward false 426 n
  let mix (v u:List Bool):=FlagEntry.pfx (measurementCount A) v++u
  have eq:=steady false x good 45 (381+n) (by decide) (by omega) s (mix v u) (mix z y) stage
  rw [StairRestSupport.forward_append false 381 45 n] at eq
  exact (Stair44PointSecond.joinRecords A B v u t).symm.trans (eq.trans (Stair44PointSecond.joinRecords A B z y t))

theorem windowFalse (n x:Nat) (good:Bounds x p) (bound:426+n≤512) (raw:State)
    (stage:Rolling1588.Integer.Stage base false x p 45 raw.basis) (m stockTape:List Bool) (norm:NewNormalized false x):
    let s:=pullState (OB5.sig 44) raw
    Paired false x (run (forwardEnd false n) m s) (run (Rolling1588TickGap.forward false 45 (381+n)) stockTape s) (StockRowVector.rows x p):=by
  let s:=pullState (OB5.sig 44) raw
  have result:=StockStrongChain.result false x good raw m stage
  have old:=StockBaseline.comparison false x good raw _ m stage result.2.1
  have new:=norm raw m stage
  have eq:Same _ _:=⟨new.1.trans old.1.symm,fun q off=>(new.2 q off).trans (old.2 q off).symm⟩
  have h:=StockRowVector.binding false x good raw _ m stage result.2.1 eq
  have onward:=h.through (Rolling1588TickGap.forward false 426 n) (fun q hq=>(StockArchiveBanks.safe false 426 n (by decide) bound q hq).1) (m.drop (measurementCount (Shadow20.MixedWindow425.forward425Cut false)))
  simp only [forwardEnd,StairRestSupport.forward_append false 381 45 n,run_append,run_take]
  rw [←suffix_independent_false n x good bound raw stage (m.drop (measurementCount (Shadow20.MixedWindow425.forward425Cut false))) m (stockTape.drop (measurementCount (Rolling1588TickGap.forward false 45 381))) stockTape]
  exact onward

theorem windowTrue (x:Nat) (good:Bounds x p) (raw:State)
    (stage:Rolling1588.Integer.Stage base true x p 45 raw.basis) (m stockTape:List Bool) (norm:NewNormalized true x):
    let s:=pullState (OB5.sig 44) raw
    Paired true x (run (forwardEnd true 0) m s)
      (run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead) stockTape s)
      (StockRowVector.rows x p):=by
  let s:=pullState (OB5.sig 44) raw
  have result:=StockStrongChain.result true x good raw m stage
  have old:=StockBaseline.comparison true x good raw _ stockTape stage result.2.1
  have new:=norm raw m stage
  have eq:Same _ _:=⟨new.1.trans old.1.symm,fun q off=>(new.2 q off).trans (old.2 q off).symm⟩
  have h:=StockRowVector.binding true x good raw _ stockTape stage result.2.1 eq
  have e0 : forwardEnd true 0 = Shadow20.MixedWindow425.forward425Cut true := by simp [forwardEnd, Rolling1588TickGap.forward]
  have href : Shadow20.MixedOrd425.stockRef425 true = Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead := rfl
  rw [e0]; rw [href] at h; exact h
end ECDSAAdd.Entrant.StairPacket.StockWalkWindow

