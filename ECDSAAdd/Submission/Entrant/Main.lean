theorem junctionEL {loans : StairSchedule.StairLoans} {k x : Nat}
    (h : CRel (JEXL loans k x) (RelX x 12)
      (firstSel StairConcreteAssembly.checkpointPrimitives) []) :
    CRel (JEXL loans k x) (RowRelE k x 12 (headEL loans))
      (firstSel StairConcreteAssembly.checkpointPrimitives) [] := by
  have g := junction_track_gen (ExitMiddleX k x) (headEL loans) h
