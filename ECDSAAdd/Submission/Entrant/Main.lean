theorem fold_boundary_math (oddMode : Bool) (E : HalfEncoding)
    (retired : Wire) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (member : retired∈L.carry.take 254) (origin : BasisState) (T F Y bias : Int)
