  let Post := [.CX L760.parity b, .X b] ++ orErase a b c ++ [.CX a b, .X b] ++
    notRegister ys ++ signComplement L760.sign L760.y ++
    [.CX b L760.parity, .CX (L760.ylow.getD 0 0) L760.parity, .CX L760.sign L760.parity,
