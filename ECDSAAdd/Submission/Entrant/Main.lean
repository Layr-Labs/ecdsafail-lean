private theorem regValue_pull_put_eq_R (f : Wire → Wire) (hfix : ∀ q ∈ fieldR, f q = q)
    (rk : State) (p : Wire) (hp : p ∉ fieldR) (b : Bool) :
    regValue fieldR (pullState f (ParityEven.put rk p b)).basis = regValue fieldR rk.basis := by
