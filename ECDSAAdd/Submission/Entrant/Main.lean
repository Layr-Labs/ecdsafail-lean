      have := MixedGeo425.plain_lt hi; simp only [StockWindowGeo.gstart]; omega) (run (span 45 380) [] s)
    simp only [common425, common425Base, ↓reduceIte, EndOrient425.zero_phase, pullState_phase425, eraseSites_phase425, ordinary425, hbt, hsp 380 (by decide)]

