    (fun k (V : Fp × Fp) => RouteA.Rolling1588.CutFrame P1Life.oddWord P1Life.oddWord k origin V.1 V.2) 102
    (fun k hk kb V => packet_oddLoan_cut_frame d divide hd h42 k hk kb origin ctx enabled V.1 V.2)
