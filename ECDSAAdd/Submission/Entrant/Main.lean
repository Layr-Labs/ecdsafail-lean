theorem kernel_frame (retired : Wire) (divide : Bool) (L : Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : retired∈(L.carry.take 254).drop 1)
    (R Y : Int) (hr : OddDomain R) (hy : OddDomain Y) (s : State) (m : List Bool)
