theorem bitRun_append (P Q : Program) (x : Nat) :
    bitRun (P++Q) x=bitRun Q (bitRun P x) := by
  induction P generalizing x with
  | nil => rfl
  | cons i P ih => exact ih (MeasuredCodec5.bitStep i x)

theorem safe_append (P Q : Program) (x : Nat) :
    safe (P++Q) x=(safe P x && safe Q (bitRun P x)) := by
  induction P generalizing x with
  | nil => rfl
  | cons i P ih =>
    simp only [List.cons_append,MeasuredCodec5.safe,MeasuredCodec5.bitRun]
    rw [ih,Bool.and_assoc]

theorem safe_append_of (P Q : Program) (x : Nat)
    (hp : safe P x=true) (hq : safe Q (bitRun P x)=true) : safe (P++Q) x=true := by
  rw [safe_append,hp,hq]
  rfl

theorem safe_of_no_measurements (P : Program) (h : measurementCount P=0) (x : Nat) :
    safe P x=true := by
  induction P generalizing x with
  | nil => rfl
  | cons i P ih =>
    cases i with
    | X t => exact ih h _
    | CX c t => exact ih h _
    | CCX a b t => exact ih h _
    | measureX t c0 c1 =>
      have impossible : 1+measurementCount P=0 := h
      omega

