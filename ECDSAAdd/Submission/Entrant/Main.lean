    wires (finiteProgramN L C cy (renameProgram (Wrapper5.U L) Gen)) ⊆ (sites L).toFinset := by
  have stage : wires (mergeFlagsN L ++ renameProgram (sigP L) (outTail L C)) ⊆ (sites L).toFinset := by
