theorem ofEndpointTrue425 (x:Nat) (nz:0 < x) (lt:x<p) (ref:State)
    (h:Endpoint425True x ref):Native true x ref:=by
  obtain ⟨s,enc,stage,eq⟩:=h
  let a:=pullState Stair44WalkMap.first.symm s
  have input:pullState Stair44WalkMap.first a=s:=Stair44PlacedHead.unpull Stair44WalkMap.first.symm s
  have pair:=StockWalkEndpoints.openedTrue x nz lt s a [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424))) stage input
  have hfirst_run : run (Stair44WalkRun.forward true 409 ++ WindowWalkCosts.firstPackHead)
      (WindowFieldJourney.joinTapes (StockWalkPrefix.first true) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424)))) a =
      run WindowWalkCosts.firstPackHead
        ((WindowFieldJourney.joinTapes (StockWalkPrefix.first true) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424)))).drop
          (measurementCount (Stair44WalkRun.forward true 409)))
        (run (Stair44WalkRun.forward true 409)
          (WindowFieldJourney.joinTapes (StockWalkPrefix.first true) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424)))) a) := by
    rw [run_append, run_take]
  have same409:=Stair44WalkCuts.forward_done true 409 x (by decide) nz lt s a
    (WindowFieldJourney.joinTapes (StockWalkPrefix.first true) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424)))) stage input
  refine ⟨pair.labels,?_⟩
  intro b j
  have loc:siteAt b j∈pool:=archives_pool _ (StockArchiveBanks.mem b j)
  have hrec : (run (Rolling1588TickGap.forward true 1 424 ++ WindowWalkCosts.firstPackHead) enc s).basis (siteAt b j) =
      (run (Stair44WalkRun.forward true 409 ++ WindowWalkCosts.firstPackHead)
        (WindowFieldJourney.joinTapes (StockWalkPrefix.first true) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424)))) a).basis (siteAt b j) := by
    rw [hfirst_run, same409, show (15:Nat)+409=424 from rfl, run_append]
    have hst := StockWalkWindow.steady true x (StockWalkEndpoints.bounds x nz lt) 1 424 (by decide) (by decide) s
      (enc.take (measurementCount (Rolling1588TickGap.forward true 1 424)))
      (WindowFieldJourney.joinTapes (StockWalkPrefix.first true) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424)))) stage
    have init:pullState (OB5.sig 0) s=s:=by apply State.extensionality _ s; rfl; funext q; exact congrArg s.basis (OB5.sig_zero q)
    rw [show 1-1=0 from rfl, init] at hst
    rw [hst]
    exact congrFun (Arithmetic.run_basis_records _ _ _ _ _ rfl) (siteAt b j)
  exact (eq _ loc).trans (hrec.trans (pair.stock b j))

