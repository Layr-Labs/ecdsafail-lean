  addInPlace subInPlace mappedAdd mappedSub swapRegisters transcriptSelectWindow

theorem bf_r_map (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    (mapCircuit f L).r=L.r.map f := r_map f L.toLayout
theorem bf_y_map (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    (mapCircuit f L).y=L.y.map f := y_map f L.toLayout
theorem bf_low_map (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    (mapCircuit f L).low=L.low.map f := low_map f L.toLayout

theorem bf_biasBits_map (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    (BiasedCircuit.biasBits L).map (mapBit f)=BiasedCircuit.biasBits (mapCircuit f L) := by
  simp only [BiasedCircuit.biasBits,List.map_append,List.map_map,List.map_cons,List.map_nil]
  rfl

theorem bf_flip_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    renameProgram f (BiasedCircuit.flipBias L)=BiasedCircuit.flipBias (mapCircuit f L) := by
  have h : 253<L.rtail.length := by rw [hw.1]; omega
  simp [BiasedCircuit.flipBias,renameProgram,renameInstr,mapCircuit,mapCleanup,
    List.getD_eq_getElem?_getD,List.getElem?_eq_getElem h]

theorem bf_prefix_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) (hw : L.Widths)
    (hy : L.ylow≠[]) :
    renameProgram f (BiasedCircuit.biasedPrefix L)=BiasedCircuit.biasedPrefix (mapCircuit f L) := by
  have pf : renameProgram f (BiasedCircuit.prepareFold L)=
      BiasedCircuit.prepareFold (mapCircuit f L) := by
    simp only [BiasedCircuit.prepareFold,mapCircuit,mapCleanup,renameProgram,
      List.map_cons,List.map_nil,renameInstr]
  have sv : renameProgram f (BiasedCircuit.signView L)=BiasedCircuit.signView (mapCircuit f L) := by
    simp only [BiasedCircuit.signView,mapCircuit,mapCleanup,renameProgram,
      List.map_cons,List.map_nil,renameInstr]
  have rs : renameProgram f (BiasedCircuit.releaseSelectors L)=
      BiasedCircuit.releaseSelectors (mapCircuit f L) := by
    simp only [BiasedCircuit.releaseSelectors,mapCircuit,mapCleanup,renameProgram,
      List.map_cons,List.map_nil,renameInstr,renameCorrection]
  have fd : renameProgram f (BiasedCircuit.fold L)=BiasedCircuit.fold (mapCircuit f L) := by
    simp only [BiasedCircuit.fold,mappedAdd_natural,bf_biasBits_map,List.map_take,bf_r_map]
    rfl
  simp only [BiasedCircuit.biasedPrefix,rename_append,seedViews_natural f L hy,rawAdd_natural,
    pf,rotateRight_natural,rawTarget_map,sv,fd,rs,prepareSign_natural,bf_flip_natural f L hw]
  rfl

theorem bf_suffix_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (BiasedCircuit.cleanupSuffix L)=BiasedCircuit.cleanupSuffix (mapCircuit f L) := by
  simp only [BiasedCircuit.cleanupSuffix,BalancedCleanup.unnormalize,BalancedCleanup.prepareCompare,
    rename_append,rename_reverse,prepareSign_natural,literalConstAdd_natural,rotateLeft_natural,
    signComplement_natural,compareLt_natural,bf_low_map,bf_r_map,bf_y_map,List.map_take]
  rfl

theorem biasedCircuit_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    renameProgram f (BiasedCircuit.program L)=BiasedCircuit.program (mapCircuit f L) := by
  have hy : L.ylow≠[] := by
    intro e
    have h := hw.2.1
    rw [e] at h
    simp at h
  simp only [BiasedCircuit.program,rename_append,bf_prefix_natural f L hw hy,bf_suffix_natural]

theorem biasedTranscriptCell_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) (hw : L.Widths)
    (b g swap effS : Wire) (ig is : Bool) :
    renameProgram f (biasedTranscriptCell L b g swap effS ig is)=
      biasedTranscriptCell (mapCircuit f L) (f b) (f g) (f swap) (f effS) ig is := by
  simp only [biasedTranscriptCell,biasedTranscriptBody,selectWindow_natural,rename_append,
    biasedCircuit_natural f L hw,swapRegisters_natural,bf_r_map,bf_y_map]
  rfl

end Natural

/-! ## Gate slots -/

theorem biasedCircuit_gateSlots_le (L : BalancedCircuit.Layout) (hw : L.Widths) :
    gateSlots (BiasedCircuit.program L) ≤ 24000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have kw := BalancedCircuit.widths L hw
  have hb : (BiasedCircuit.biasBits L).length=256 := by simp [BiasedCircuit.biasBits]
  have a := addInPlace_gateSlots_le (BalancedCircuit.rawSource L) (BalancedCircuit.rawTarget L)
    L.carry L.sign
  have r := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).1
  have l := (rotate_gateSlots_le L.r).2
  have m := mappedAdd_gateSlots_le (BiasedCircuit.biasBits L) L.r (L.carry.take 255) L.minus
  have u := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.positiveLiteral
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  rw [kw.1] at a
  rw [kw.2.1] at r
  rw [w.2.1] at l
  rw [hb] at m
  rw [w.1] at u
  rw [w.2.1,w.2.2.1] at c
  simp only [BiasedCircuit.program,BiasedCircuit.biasedPrefix,BiasedCircuit.cleanupSuffix,
    BiasedCircuit.prepareFold,BiasedCircuit.signView,BiasedCircuit.fold,
    BiasedCircuit.releaseSelectors,BiasedCircuit.flipBias,BalancedCircuit.seedViews,
    BalancedCircuit.rawAdd,BalancedCleanup.prepareSign,BalancedCleanup.prepareCompare,
    BalancedCleanup.unnormalize,gateSlots_append,reverse_gateSlots,signComplement_gateSlots,
    gateSlots_cons,gateSlots_nil,instructionSlots,kw.1,w.2.1,w.2.2.1,List.length_cons,List.length_nil]
  omega

end ECDSAAdd.Entrant

end

section
-- ===== OBBiasInv =====
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant
open Arithmetic Secp256k1 BalancedField Challenge Baselines
attribute [local irreducible] centerWord

/-- A fresh measured inverse: undo the recorded swap before the inverse field kernel. -/
def biasedInverseTranscriptBody (L : BalancedCircuit.Layout) (swap : Wire) : Program :=
  swapRegisters swap L.r L.y ++ [.X L.sign] ++ BiasedInverse.program L ++ [.X L.sign]

def biasedInverseTranscriptCell (L : BalancedCircuit.Layout) (b g swap effS : Wire)
    (inactiveG inactiveS : Bool) : Program :=
  transcriptSelectWindow b g L.sign inactiveG
    (transcriptSelectWindow b swap effS inactiveS (biasedInverseTranscriptBody L effS))

theorem bi_inverse_result_word (B : Bool) (X Y : Fp) :
    encodeWord 256 (BalancedInverse.result B (centerFp X) (centerFp Y)) =
      centerWord (2*X-(if B then -Y else Y)) := by
  unfold BalancedInverse.result BalancedField.signedY
  unfold centerWord
  congr 2
  cases B <;>
    simp [Int.cast_sub,Int.cast_mul,Int.cast_neg,centerFp_cast]

theorem bi_inverse_sign_away (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.sign∉L.r ∧ L.sign∉L.y := by
  have h := BalancedCircuit.flagAway L hn L.sign (by simp)
  exact ⟨fun hm => h (by simp [hm]),fun hm => h (by simp [hm])⟩

theorem bi_inverse_work_away (L : BalancedCircuit.Layout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈BalancedCircuit.work L) : q∉L.r ∧ q∉L.y := by
  have nd := BalancedCircuit.allND L hn
  have h := List.nodup_iff_count.mp nd q
  have hw := List.count_pos_iff.mpr hq
  constructor <;> intro hd <;> have hc := List.count_pos_iff.mpr hd
  all_goals
    simp only [BalancedCircuit.work,List.count_append,List.count_cons,List.count_nil] at h hw
    omega

theorem bi_inverse_sign_work (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.sign∉BalancedCircuit.work L := by
  have nd : (L.sign::BalancedCircuit.work L).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
      BalancedCircuit.work,List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  exact (List.nodup_cons.mp nd).1

theorem bi_inverse_toggle_view (sign : Wire) (s : State) (m : List Bool) :
    let t := run [.X sign] m s
    t.phase=s.phase ∧ t.basis sign= !s.basis sign ∧
      ∀q,q≠sign → t.basis q=s.basis q := by
  simp only [run]
  refine ⟨True.intro,?_,?_⟩
  · simp only [writeBit,Function.update_self]
  · intro q hq
    simp only [writeBit,Function.update_of_ne hq]

/-- The sign-complement wrapper preserves the selected transcript exactly. -/
theorem biasedTranscriptDouble_frame (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) (base : BasisState)
    (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      ([.X L.sign]++BiasedInverse.program L++[.X L.sign])
      (PairFrame L.r L.y base (centerWord (2*X+(if base L.sign then -Y else Y)))
        (centerWord Y)) := by
  intro s m h
  generalize eu : run [.X L.sign] m s=u
  have first := bi_inverse_toggle_view L.sign s m
  rw [eu] at first
  have sa := bi_inverse_sign_away L hn
  have uv (r : List Wire) (ha : L.sign∉r) : regValue r u.basis=regValue r s.basis :=
    regValue_congr r u.basis s.basis (fun q hq =>
      first.2.2 q (fun e => ha (e ▸ hq)))
  have us : u.basis L.sign= !base L.sign := by
    rw [first.2.1,h.2.2 L.sign sa.1 sa.2]
  have ur : signedRegValue L.r u.basis=centerFp X := by
    rw [signedRegValue,uv L.r sa.1,h.1,(BalancedCleanup.widths L.toLayout hw).2.1,centerWord_decode]
  have uy : signedRegValue L.y u.basis=centerFp Y := by
    rw [signedRegValue,uv L.y sa.2,h.2.1,(BalancedCleanup.widths L.toLayout hw).2.2.1,centerWord_decode]
  have uc : ∀q∈BalancedCircuit.work L,u.basis q=false := by
    intro q hq
    have away := bi_inverse_work_away L hn q hq
    have ns : q≠L.sign := fun e => bi_inverse_sign_work L hn (e ▸ hq)
    exact (first.2.2 q ns).trans ((h.2.2 q away.1 away.2).trans (hc q hq))
  generalize ev : run (BiasedInverse.program L) m u=v
  have hv := BiasedInverse.program_correct L hw hn (!base L.sign) (centerFp X) (centerFp Y)
    (centerFp_bounds X) (centerFp_bounds Y) u m us ur uy uc
  rw [ev] at hv
  have vv : regValue L.r v.basis=centerWord (2*X+(if base L.sign then -Y else Y)) := by
    rw [hv.2.1,bi_inverse_result_word]
    cases base L.sign <;> simp only [Bool.not_false,Bool.not_true,if_true,if_false,Bool.false_eq_true,sub_eq_add_neg,neg_neg]
  let tail := m.drop (measurementCount (BiasedInverse.program L))
  generalize et : run [.X L.sign] tail v=t
  have last := bi_inverse_toggle_view L.sign v tail
  rw [et] at last
  have actual : run ([.X L.sign]++BiasedInverse.program L++[.X L.sign]) m s=t := by
    simp only [List.append_assoc,run_append,run_take]
    simp only [show measurementCount [.X L.sign]=0 from rfl,List.drop_zero,Nat.zero_add,
      measurementCount_append]
    rw [eu,ev]
    exact et
  rw [actual]
  refine ⟨last.1.trans (hv.1.trans first.1),?_,?_,?_⟩
  · exact (regValue_congr _ _ _ (fun q hq =>
      last.2.2 q (fun e => sa.1 (e ▸ hq)))).trans vv
  · exact (regValue_congr _ _ _ (fun q hq => by
      have qr : q∉L.r := by
        have d := (List.nodup_append'.mp (List.nodup_append'.mp (BalancedCircuit.allND L hn)).2.1).1
        exact fun hr => List.disjoint_left.mp (List.nodup_append'.mp d).2.2 hr hq
      exact (last.2.2 q (fun e => sa.2 (e ▸ hq))).trans (hv.2.2.2 q qr))).trans
      ((uv L.y sa.2).trans h.2.1)
  · intro q qr qy
    by_cases qs : q=L.sign
    · subst q
      rw [last.2.1,hv.2.2.2 L.sign sa.1,us,Bool.not_not]
    · exact (last.2.2 q qs).trans ((hv.2.2.2 q qr).trans
        ((first.2.2 q qs).trans (h.2.2 q qr qy)))

theorem bi_inverseSwap_frame (r y : List Wire) (c : Wire)
    (hlen : r.length=y.length) (hn : (c::r++y).Nodup)
    (base : BasisState) (A B : Nat) :
    Triple (PairFrame r y base A B) (swapRegisters c r y)
      (PairFrame r y base (if base c then B else A) (if base c then A else B)) := by
  intro s m h
  have v := swapRegisters_correct c r y hlen hn s m
  have hc : c∉r ∧ c∉y := by
    have d := (List.nodup_cons.mp hn).1
    exact ⟨fun hm => d (List.mem_append_left _ hm),fun hm => d (List.mem_append_right _ hm)⟩
  have same := h.2.2 c hc.1 hc.2
  refine ⟨v.1,?_,?_,fun q qr qy => (v.2.1 q qr qy).trans (h.2.2 q qr qy)⟩
  · rw [v.2.2.1,same,h.1,h.2.1]
  · rw [v.2.2.2,same,h.1,h.2.1]

theorem biasedInverseTranscriptBody_frame (L : BalancedCircuit.Layout) (effS : Wire)
    (hw : L.Widths) (hn : L.wires.Nodup) (hs : (effS::L.r++L.y).Nodup)
    (base : BasisState) (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      (biasedInverseTranscriptBody L effS)
      (PairFrame L.r L.y base
        (centerWord (skywalkPayloadUncell (base L.sign) (base effS) (X,Y)).1)
        (centerWord (skywalkPayloadUncell (base L.sign) (base effS) (X,Y)).2)) := by
  have len := BalancedCleanup.widths L.toLayout hw
  have sw := bi_inverseSwap_frame L.r L.y effS (len.2.1.trans len.2.2.1.symm) hs
    base (centerWord X) (centerWord Y)
  let A := if base effS then Y else X
  let B := if base effS then X else Y
  have view : PairFrame L.r L.y base (centerWord A) (centerWord B) =
      PairFrame L.r L.y base (if base effS then centerWord Y else centerWord X)
        (if base effS then centerWord X else centerWord Y) := by
    cases e : base effS <;> simp only [A,B,e,Bool.false_eq_true,if_true,if_false]
  rw [←view] at sw
  have dbl := biasedTranscriptDouble_frame L hw hn base hc A B
  have out : PairFrame L.r L.y base
      (centerWord (skywalkPayloadUncell (base L.sign) (base effS) (X,Y)).1)
      (centerWord (skywalkPayloadUncell (base L.sign) (base effS) (X,Y)).2) =
      PairFrame L.r L.y base (centerWord (2*A+(if base L.sign then -B else B)))
        (centerWord B) := by
    cases e : base effS <;> simp only [skywalkPayloadUncell,A,B,e,Bool.false_eq_true,if_true,if_false]
  rw [out]
  simpa only [biasedInverseTranscriptBody,List.append_assoc] using sw.seq dbl

theorem bi_selected_other (base : BasisState) (b source flag q : Wire) (v : Bool)
    (hne : q≠flag) : mixedTranscriptBase base b source flag v q=base q := by
  simp [mixedTranscriptBase,writeBit,Function.update,hne]

/-- Exact mixed selection around the physically emitted centered kernel. -/
theorem biasedInverseTranscriptCell_frame (L : BalancedCircuit.Layout)
    (b g swap effS : Wire) (inactiveG inactiveS : Bool)
    (hl : BalancedTranscriptLayout L b g swap effS) (base : BasisState)
    (hg0 : base L.sign=false) (hs0 : base effS=false)
    (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      (biasedInverseTranscriptCell L b g swap effS inactiveG inactiveS)
      (PairFrame L.r L.y base
        (centerWord (skywalkPayloadUncell (mixedTranscriptBit base b g inactiveG)
          (mixedTranscriptBit base b swap inactiveS) (X,Y)).1)
        (centerWord (skywalkPayloadUncell (mixedTranscriptBit base b g inactiveG)
          (mixedTranscriptBit base b swap inactiveS) (X,Y)).2)) := by
  let bg := mixedTranscriptBase base b g L.sign inactiveG
  let bs := mixedTranscriptBase bg b swap effS inactiveS
  have sg : [b,g,L.sign].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hl.controls q
    simp only [List.count_cons,List.count_nil] at h ⊢
    omega
  have ss : [b,swap,effS].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hl.controls q
    simp only [List.count_cons,List.count_nil] at h ⊢
    omega
  have d0 := List.nodup_cons.mp hl.controls
  have d1 := List.nodup_cons.mp d0.2
  have d2 := List.nodup_cons.mp d1.2
  have d3 := List.nodup_cons.mp d2.2
  have ne : effS≠L.sign := Ne.symm (by simpa using d3.1)
  have bn : b≠L.sign := by
    have h := (List.nodup_cons.mp sg).1
    intro e; exact h (by simp [e])
  have sn : swap≠L.sign := by
    intro e
    exact d2.1 (by simp [e])
  have bgS : bg effS=false := (bi_selected_other _ _ _ _ _ _ ne).trans hs0
  have bgB : bg b=base b := bi_selected_other _ _ _ _ _ _ bn
  have bgSwap : bg swap=base swap := bi_selected_other _ _ _ _ _ _ sn
  have bsG : bs L.sign=mixedTranscriptBit base b g inactiveG := by
    rw [show bs L.sign=bg L.sign from bi_selected_other _ _ _ _ _ _ (Ne.symm ne)]
    simp [bg,mixedTranscriptBase,writeBit]
  have bsS : bs effS=mixedTranscriptBit base b swap inactiveS := by
    simp [bs,mixedTranscriptBase,mixedTranscriptBit,writeBit,bgB,bgSwap]
  have clean : ∀q∈BalancedCircuit.work L,bs q=false := by
    intro q hq
    have qg : q≠L.sign := fun e => hl.scratch.1 (e ▸ hq)
    have qs : q≠effS := fun e => hl.scratch.2 (e ▸ hq)
    exact (bi_selected_other _ _ _ _ _ _ qs).trans
      ((bi_selected_other _ _ _ _ _ _ qg).trans (hc q hq))
  have body := biasedInverseTranscriptBody_frame L effS hl.widths hl.kernel hl.swapND bs clean X Y
  rw [bsG,bsS] at body
  have inner := transcriptSelectWindow_pairFrame b swap effS inactiveS L.r L.y ss
    (hl.outside b (by simp)) (hl.outside swap (by simp))
    (hl.outside effS (by simp)) bg bgS (centerWord X) (centerWord Y) _ _ _ body
  exact transcriptSelectWindow_pairFrame b g L.sign inactiveG L.r L.y sg
    (hl.outside b (by simp)) (hl.outside g (by simp))
    (hl.outside L.sign (by simp)) base hg0 _ _ _ _ _ inner

def biasedInverseTranscriptReplay (L : BalancedCircuit.Layout) (b effS : Wire) :
    List MixedTranscriptLetter → Program
  | [] => []
  | l::ls => biasedInverseTranscriptReplay L b effS ls ++
    biasedInverseTranscriptCell L b l.1.1 l.1.2 effS l.2.1 l.2.2

/-- Every round has a full pair frame, including all quantum transcript controls. -/
theorem biasedInverseTranscriptReplay_frame (L : BalancedCircuit.Layout) (b effS : Wire)
    (ls : List MixedTranscriptLetter) (hl : BalancedTranscriptReplayLayout L b effS ls)
    (base : BasisState) (hg0 : base L.sign=false) (hs0 : base effS=false)
    (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      (biasedInverseTranscriptReplay L b effS ls)
      (PairFrame L.r L.y base
        (centerWord (skywalkPayloadReplayInverse (mixedTranscriptControls base b ls) (X,Y)).1)
        (centerWord (skywalkPayloadReplayInverse (mixedTranscriptControls base b ls) (X,Y)).2)) := by
  induction ls generalizing X Y with
  | nil => intro s m h; exact ⟨rfl,h⟩
  | cons l ls ih =>
    let Q := skywalkPayloadReplayInverse (mixedTranscriptControls base b ls) (X,Y)
    have h1 := ih (fun q hq => hl q (by simp [hq])) X Y
    have h2 := biasedInverseTranscriptCell_frame L b l.1.1 l.1.2 effS l.2.1 l.2.2
      (hl l (by simp)) base hg0 hs0 hc Q.1 Q.2
    simpa only [biasedInverseTranscriptReplay,mixedTranscriptControls,List.map_cons,
      skywalkPayloadReplayInverse,Q] using h1.seq h2

theorem biasedInverseTranscriptCell_counts (L : BalancedCircuit.Layout)
    (b g swap effS : Wire) (ig is : Bool) (hw : L.Widths)
    (hs : (effS::L.r++L.y).Nodup) :
    toffoliCount (biasedInverseTranscriptCell L b g swap effS ig is)=1280 ∧
    measurementCount (biasedInverseTranscriptCell L b g swap effS ig is)=1024 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have sw := swapRegisters_resources effS L.r L.y (w.2.1.trans w.2.2.1.symm) hs
  have k := BiasedInverse.counts L hw
  have si := transcriptSelectWindow_counts b swap effS is (biasedInverseTranscriptBody L effS)
  have so := transcriptSelectWindow_counts b g L.sign ig
    (transcriptSelectWindow b swap effS is (biasedInverseTranscriptBody L effS))
  simp only [biasedInverseTranscriptCell,so.1,so.2,si.1,si.2]
  simp only [biasedInverseTranscriptBody,toffoliCount_append,measurementCount_append,
    k.1,k.2,sw.1,sw.2.1,w.2.1]
  norm_num [toffoliCount,measurementCount]


theorem bi_inverse_select_support (b source flag : Wire) (v : Bool) (p : Program) :
    wires (transcriptSelectWindow b source flag v p)⊆
      [b,source,flag].toFinset ∪ wires p := by
  intro q hq
  cases v <;>
    simp only [transcriptSelectWindow,transcriptSelectCompute,transcriptSelectExpose,
      transcriptSelectErase,Bool.false_eq_true,if_false,if_true,List.nil_append,
      wires_append,Finset.mem_union,wires,Instr.wires,correctionWires,
      Finset.mem_insert,Finset.mem_singleton,Finset.notMem_empty,List.mem_toFinset,
      List.mem_cons,List.not_mem_nil] at hq ⊢ <;> tauto

theorem biasedInverseTranscriptBody_support (L : BalancedCircuit.Layout) (effS : Wire)
    (hw : L.Widths) : wires (biasedInverseTranscriptBody L effS)⊆(effS::L.wires).toFinset := by
  have k := BiasedInverse.support L hw
  have sw := swapRegisters_wires effS L.r L.y
    ((BalancedCleanup.widths L.toLayout hw).2.1.trans
      (BalancedCleanup.widths L.toLayout hw).2.2.1.symm)
  intro q hq
  simp only [biasedInverseTranscriptBody,wires_append,Finset.mem_union,or_assoc] at hq
  rcases hq with hq|hq|hq|hq
  · have h := sw hq
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append,BalancedCircuit.Layout.wires,
      BalancedCleanup.Layout.wires,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.not_mem_nil,or_false] at h ⊢
    tauto
  · simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_singleton,Finset.notMem_empty,or_false] at hq
    simp [hq,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires]
  · simpa only [List.mem_toFinset,List.mem_cons] using Or.inr (List.mem_toFinset.mp (k hq))
  · simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_singleton,Finset.notMem_empty,or_false] at hq
    simp [hq,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires]

theorem biasedInverseTranscriptCell_support (L : BalancedCircuit.Layout)
    (b g swap effS : Wire) (ig is : Bool) (hw : L.Widths) :
    wires (biasedInverseTranscriptCell L b g swap effS ig is)⊆
      ([b,g,swap,effS]++L.wires).toFinset := by
  have outer := bi_inverse_select_support b g L.sign ig
    (transcriptSelectWindow b swap effS is (biasedInverseTranscriptBody L effS))
  have inner := bi_inverse_select_support b swap effS is (biasedInverseTranscriptBody L effS)
  have body := biasedInverseTranscriptBody_support L effS hw
  intro q hq
  have h := outer hq
  simp only [Finset.mem_union] at h
  rcases h with h|h
  · simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at h
    simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
    rcases h with h|h|h
    · simp [h]
    · simp [h]
    · right; simp [BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,h]
  · have h := inner h
    simp only [Finset.mem_union] at h
    rcases h with h|h
    · simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at h ⊢
      simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
      tauto
    · have hb := body h
      simp only [List.mem_toFinset,List.mem_cons] at hb
      rcases hb with e|member
      · subst q
        simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil]
        exact Or.inl (Or.inr (Or.inr (Or.inr (Or.inl True.intro))))
      · simp only [List.mem_toFinset,List.mem_append]
        exact Or.inr member


theorem biasedInverse_gateSlots_le (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (BiasedInverse.program L) ≤ 25000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have rw := BalancedCircuit.widths L hw
  have a := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.negativeLiteral
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  have b := mappedSub_gateSlots_le (BiasedInverse.biasBits L) L.r (L.carry.take 255) L.minus
  have s := subInPlace_gateSlots_le (BalancedCircuit.rawSource L) (BalancedCircuit.rawTarget L) L.carry L.sign
  have r := (rotate_gateSlots_le L.r).2
  have rt := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).2
  rw [w.1] at a
  rw [w.2.2.1,w.2.1] at c
  have bl : (BiasedInverse.biasBits L).length=256 := by
    simp only [BiasedInverse.biasBits,List.length_append,List.length_map,List.length_range,
      List.length_singleton]
  rw [bl,w.2.1] at b
  rw [rw.1,rw.2.1] at s
  rw [w.2.1] at r
  rw [rw.2.1] at rt
  simp only [BiasedInverse.program,BiasedInverse.recoverPrefix,BiasedInverse.unbiasView,
    BiasedInverse.restoreRaw,BiasedInverse.selectors,BiasedInverse.unfoldBias,BiasedInverse.release,
    BalancedInverse.rawSubtract,BalancedCleanup.prepareSign,BalancedCleanup.normalize,
    BalancedCleanup.prepareCompare,BalancedCircuit.seedViews,gateSlots_append,reverse_gateSlots,
    signComplement_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,
    w.2.1,w.2.2.1,rw.1,List.length_cons,List.length_nil]
  omega

section Naturality
open FieldRename
attribute [local irreducible] literalConstAdd compareLt rotateLeft rotateRight signComplement
  addInPlace subInPlace mappedAdd mappedSub

theorem bi_biasBits_map (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    (BiasedInverse.biasBits L).map (mapBit f)=BiasedInverse.biasBits (mapCircuit f L) := by
  simp only [BiasedInverse.biasBits,List.map_append,List.map_map,List.map_cons,List.map_nil]
  rfl

theorem bi_recoverPrefix_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (BiasedInverse.recoverPrefix L)=BiasedInverse.recoverPrefix (mapCircuit f L) := by
  simp only [BiasedInverse.recoverPrefix,BalancedCleanup.normalize,BalancedCleanup.prepareCompare,
    rename_append,rename_reverse,prepareSign_natural,literalConstAdd_natural,
    rotateLeft_natural,signComplement_natural,compareLt_natural,mapCircuit,low_map,r_map,y_map,List.map_take]
  rfl

theorem bi_r_getD_map (f : Wire → Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    (mapCircuit f L).r.getD 254 0=f (L.r.getD 254 0) := by
  have w := (BalancedCleanup.widths L.toLayout hw).2.1
  have h : 254<L.r.length := by omega
  change (mapCleanup f L.toLayout).r.getD 254 0=f (L.r.getD 254 0)
  rw [r_map,List.getD_eq_getElem _ _ (by simpa only [List.length_map] using h),
    List.getD_eq_getElem _ _ h,List.getElem_map]

theorem bi_unbiasView_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) (hw : L.Widths) :
    renameProgram f (BiasedInverse.unbiasView L)=BiasedInverse.unbiasView (mapCircuit f L) := by
  simp only [BiasedInverse.unbiasView,rename_append,rename_reverse,prepareSign_natural,
    bi_r_getD_map f L hw]
  rfl

theorem bi_selectors_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (BiasedInverse.selectors L)=BiasedInverse.selectors (mapCircuit f L) := rfl

theorem bi_release_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (BiasedInverse.release L)=BiasedInverse.release (mapCircuit f L) := rfl

theorem bi_restoreRaw_natural (f : Wire → Wire) (L : BalancedCircuit.Layout) :
    renameProgram f (BiasedInverse.restoreRaw L)=BiasedInverse.restoreRaw (mapCircuit f L) := by
  have rm : (mapCircuit f L).r=L.r.map f := r_map f L.toLayout
  simp only [BiasedInverse.restoreRaw,BiasedInverse.unfoldBias,rename_append,
    bi_selectors_natural,mappedSub_natural,bi_biasBits_map,bi_release_natural,
    rotateLeft_natural,rawTarget_map,rm,List.map_take]
  rfl

/-- Relabeling uses the valid result width so the selected high bit is present. -/
theorem biasedInverse_natural (f : Wire → Wire) (L : BalancedCircuit.Layout)
    (hy : L.ylow ≠ []) (hw : L.Widths) :
    renameProgram f (BiasedInverse.program L)=BiasedInverse.program (mapCircuit f L) := by
  simp only [BiasedInverse.program,rename_append,rename_reverse,
    bi_recoverPrefix_natural,bi_unbiasView_natural f L hw,bi_restoreRaw_natural,
    rawSubtract_natural,seedViews_natural f L hy]
  rfl

end Naturality
end ECDSAAdd.Entrant

end



section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit
abbrev Layout := BalancedCircuit.Layout

def source (L : Layout) : List Wire:=L.y++[L.ymsb]
def rawAdd (L : Layout) : Program:=
  signComplement L.sign L.y++addInPlace (source L) (rawTarget L) L.carry L.sign++signComplement L.sign L.y
def rawSub (L : Layout) : Program:=
  signComplement L.sign L.y++subInPlace (source L) (rawTarget L) L.carry L.sign++signComplement L.sign L.y

def seed (L : Layout) : Program:=
  [.CX L.rmsb L.one,.CX (L.ylow.getD 0 0) L.parity,.CX L.r0 L.parity]

def cleanup (L : Layout) : Program:=
  BalancedCleanup.prepareCompare L.toLayout++
    (compareLt none L.y L.r L.carry L.one L.parity++
      ((BalancedCleanup.prepareCompare L.toLayout).reverse++
        (BalancedCleanup.unnormalize L.toLayout++(BalancedCleanup.prepareSign L.toLayout).reverse)))

def forward (L : Layout) : Program:=seed L++(rawAdd L++(ShortBiasedFold.remainder L++cleanup L))
def inverse (L : Layout) : Program:=
  BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L++ShortBiasedInverse.restoreRaw L++rawSub L++(seed L).reverse

theorem forward_ignores_guard (L : Layout) (w : Wire) :
    forward {L with sourceGuard:=w}=forward L := by rfl
theorem inverse_ignores_guard (L : Layout) (w : Wire) :
    inverse {L with sourceGuard:=w}=inverse L := by rfl
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic Instr
theorem addInPlace_readonly_correct (x y carry : List Wire) (cin : Wire)
    (hnd : (cin :: (y ++ carry)).Nodup)
    (hdis : List.Disjoint x (cin :: (y ++ carry))) (hx : x.length = y.length)
    (hc : carry.length + 1 = y.length) (s : State) (m : List Bool)
    (hclean : ∀ w ∈ carry, s.basis w = false) :
    (run (addInPlace x y carry cin) m s).phase = s.phase ∧
    (∀ w, w ∉ y → (run (addInPlace x y carry cin) m s).basis w = s.basis w) ∧
    regValue y (run (addInPlace x y carry cin) m s).basis =
      (regValue x s.basis + regValue y s.basis + (s.basis cin).toNat) % 2^y.length := by
  induction y generalizing x carry cin s m with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hx
    | cons a as =>
    have hcin : cin ∉ a :: as ++ b :: bs ++ carry := by
      simp only [List.mem_append,not_or]
      exact ⟨⟨fun h => List.disjoint_left.mp hdis h (by simp),
        fun h => (List.nodup_cons.mp hnd).1 (List.mem_append_left _ h)⟩,
        fun h => (List.nodup_cons.mp hnd).1 (List.mem_append_right _ h)⟩
    have hbk : ((b :: bs) ++ carry).Nodup := (List.nodup_cons.mp hnd).2
    have hdisA : List.Disjoint (a :: as) ((b :: bs) ++ carry) := by
      apply List.disjoint_left.mpr
      intro w hw hh
      exact List.disjoint_left.mp hdis hw (List.mem_cons_of_mem _ hh)
    obtain ⟨hbs, hk, hdisB⟩ := List.nodup_append'.mp hbk
    have hca : cin ≠ a := fun h => hcin (by simp [h])
    have hcb : cin ≠ b := fun h => hcin (by simp [h])
    have hcbs : cin ∉ bs := fun h => hcin (by simp [h])
    have hab : a ≠ b := fun h => List.disjoint_left.mp hdisA List.mem_cons_self (by simp [h])
    have habs : a ∉ bs := fun h => List.disjoint_left.mp hdisA List.mem_cons_self (by simp [h])
    have hbbs : b ∉ bs := (List.nodup_cons.mp hbs).1
    let A := s.basis a
    let B := s.basis b
    let C := s.basis cin
    cases bs with
    | nil =>
      have hx0 : as = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
      have hc0 : carry = [] := List.eq_nil_of_length_eq_zero (by simpa using hc)
      subst hx0 hc0
      simp only [addInPlace, run]
      refine ⟨trivial, ?_, ?_⟩
      · intro w hw
        have hwb : w ≠ b := by simpa using hw
        simp [writeBit, hwb]
      · simp only [regValue, List.foldr_cons, List.foldr_nil, List.length_cons, List.length_nil,
          writeBit, Function.update_self, Function.update_of_ne hcb]
        cases s.basis a <;> cases s.basis b <;> cases s.basis cin <;> simp
    | cons b' bs' =>
      cases as with
      | nil => simp at hx
      | cons a' as' =>
      cases carry with
      | nil => simp at hc
      | cons c cs =>
      have hx' : (a' :: as').length = (b' :: bs').length := by simpa using hx
      have hc' : cs.length + 1 = (b' :: bs').length := by simpa using hc
      have hbc : b ≠ c := fun h => List.disjoint_left.mp hdisB List.mem_cons_self (by simp [h])
      have hcbs' : c ∉ b' :: bs' := fun h =>
        List.disjoint_left.mp hdisB (List.mem_cons_of_mem _ h) List.mem_cons_self
      have hccs : c ∉ cs := (List.nodup_cons.mp hk).1
      have hac : a ≠ c := fun h => List.disjoint_left.mp hdisA List.mem_cons_self (by simp [h])
      have hcas : c ∉ a' :: as' := fun h =>
        List.disjoint_left.mp hdisA (List.mem_cons_of_mem _ h) (by simp)
      have hcc : cin ≠ c := fun h => hcin (by simp [h])
      have h4 : [a, b, cin, c].Nodup := by
        simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
          not_or, not_false_eq_true, and_true]
        exact ⟨⟨hab, Ne.symm hca, hac⟩, ⟨Ne.symm hcb, hbc⟩, hcc⟩
      have hnd' : (c :: ((b' :: bs') ++ cs)).Nodup := by
        apply List.nodup_cons.mpr
        refine ⟨?_,List.nodup_append'.mpr ⟨(List.nodup_cons.mp hbs).2,(List.nodup_cons.mp hk).2,?_⟩⟩
        · simp only [List.mem_append,not_or]; exact ⟨hcbs',hccs⟩
        · exact List.disjoint_left.mpr (fun w hw hh =>
            List.disjoint_left.mp hdisB (List.mem_cons_of_mem _ hw) (List.mem_cons_of_mem _ hh))
      have hdis' : List.Disjoint (a' :: as') (c :: ((b' :: bs') ++ cs)) := by
        apply List.disjoint_left.mpr
        intro w hw hh
        rcases List.mem_cons.mp hh with rfl|hh
        · exact hcas hw
        · rcases List.mem_append.mp hh with hh|hh
          · exact List.disjoint_left.mp hdisA (List.mem_cons_of_mem _ hw)
              (List.mem_append_left _ (List.mem_cons_of_mem _ hh))
          · exact List.disjoint_left.mp hdisA (List.mem_cons_of_mem _ hw)
              (List.mem_append_right _ (List.mem_cons_of_mem _ hh))
      have hzero : s.basis c = false := hclean c (by simp)
      -- 第一步：进位写入 c
      let s1 : State := ⟨s.phase, writeBit s.basis c (carryBit A B C)⟩
      have hfirst (record : List Bool) : run (majority a b cin c) record s = s1 := by
        rw [majority_correct _ _ _ _ h4]
        simp [s1, hzero, A, B, C]
      have hs1 (w : Wire) (hw : w ≠ c) : s1.basis w = s.basis w := by simp [s1, writeBit, hw]
      have hclean' : ∀ d ∈ cs, s1.basis d = false := by
        intro d hd
        rw [hs1 d (fun h => hccs (h ▸ hd))]
        exact hclean d (by simp [hd])
      -- 第二步：高位递归
      obtain ⟨hphase, hsame, hsum⟩ := ih (a' :: as') cs c hnd' hdis' hx' hc' s1 m hclean'
      set t := run (addInPlace (a' :: as') (b' :: bs') cs c) m s1 with ht
      have heq (w : Wire) (hw : w ∉ b' :: bs') : t.basis w = s1.basis w := hsame w hw
      have htA : t.basis a = A := by rw [heq a habs, hs1 a hac]
      have htB : t.basis b = B := by rw [heq b hbbs, hs1 b hbc]
      have htC : t.basis cin = C := by rw [heq cin hcbs, hs1 cin hcc]
      have htK : t.basis c = carryBit A B C := by rw [heq c hcbs']; simp [s1, writeBit]
      -- 第三步：擦除本位进位（x、y、cin 仍是原值）
      have herase (record : List Bool) : run (eraseCarry a b cin c) record t =
          ⟨t.phase, writeBit t.basis c false⟩ :=
        eraseCarry_correct _ _ _ _ hac hbc hcc t (by rw [htA, htB, htC, htK]) record
      -- 第四步：写和位
      have hlast (record : List Bool) :
          run [CX a b, CX cin b] record ⟨t.phase, writeBit t.basis c false⟩ =
            ⟨t.phase, writeBit (writeBit t.basis c false) b (sumBit A B C)⟩ := by
        simp only [run]
        apply congrArg (State.mk t.phase)
        funext w
        by_cases hwb : w = b
        · subst hwb
          simp only [writeBit, Function.update_self, Function.update_of_ne hcb,
            Function.update_of_ne hac, Function.update_of_ne hbc, Function.update_of_ne hcc,
            htA, htB, htC, sumBit]
          cases A <;> cases B <;> cases C <;> rfl
        · simp [writeBit, Function.update, hwb]
      -- 组合：按右结合展开，各段记录由 run_take 收回
      have hm0 : measurementCount (majority a b cin c) = 0 := rfl
      simp only [addInPlace, List.append_assoc, run_append, run_take, hm0, List.take_zero,
        List.drop_zero]
      rw [hfirst, ← ht, herase, hlast]
      refine ⟨hphase, ?_, ?_⟩
      · intro w hw
        have hw' : w ≠ b ∧ w ∉ b' :: bs' := by simpa only [List.mem_cons, not_or] using hw
        change (writeBit (writeBit t.basis c false) b (sumBit A B C)) w = s.basis w
        rw [writeBit, Function.update_of_ne hw'.1]
        by_cases hwc : w = c
        · subst hwc; simp [writeBit, hzero]
        · rw [writeBit, Function.update_of_ne hwc, heq w hw'.2, hs1 w hwc]
      · have hbs_t : regValue (b' :: bs') (writeBit (writeBit t.basis c false) b (sumBit A B C)) =
            regValue (b' :: bs') t.basis := by
          apply regValue_congr
          intro w hw
          have hwb : w ≠ b := fun h => hbbs (h ▸ hw)
          have hwc : w ≠ c := fun h => hcbs' (h ▸ hw)
          simp [writeBit, hwb, hwc]
        have hx1 : regValue (a' :: as') s1.basis = regValue (a' :: as') s.basis :=
          regValue_congr _ _ _ (fun w hw => hs1 w (fun h => hcas (h ▸ hw)))
        have hy1 : regValue (b' :: bs') s1.basis = regValue (b' :: bs') s.basis :=
          regValue_congr _ _ _ (fun w hw => hs1 w (fun h => hcbs' (h ▸ hw)))
        have hc1 : s1.basis c = carryBit A B C := by simp [s1, writeBit]
        change (if (writeBit (writeBit t.basis c false) b (sumBit A B C)) b then 1 else 0) +
            2 * regValue (b' :: bs') (writeBit (writeBit t.basis c false) b (sumBit A B C)) = _
        rw [hbs_t, hsum, hx1, hy1, hc1]
        simp only [writeBit, Function.update_self, List.length_cons]
        have hnum := sum_value_step A B C (regValue (a' :: as') s.basis)
          (regValue (b' :: bs') s.basis) (b' :: bs').length
        simp only [List.length_cons] at hnum
        simpa only [regValue, List.foldr_cons, Bool.toNat, Bool.cond_eq_ite, A, B, C] using hnum



theorem subInPlace_readonly_correct (xs ys carry : List Wire) (cin : Wire)
    (hn : (cin::(ys++carry)).Nodup)
    (hdis : List.Disjoint xs (cin::(ys++carry))) (hl : xs.length=ys.length)
    (hc : carry.length+1=ys.length) (s : State) (m : List Bool)
    (hclean : ∀q∈carry,s.basis q=false) :
    (run (subInPlace xs ys carry cin) m s).phase=s.phase ∧
    (∀q,q∉ys → (run (subInPlace xs ys carry cin) m s).basis q=s.basis q) ∧
    regValue ys (run (subInPlace xs ys carry cin) m s).basis=
      (regValue ys s.basis+2^ys.length-regValue xs s.basis-(s.basis cin).toNat)%2^ys.length := by
  have words := List.nodup_cons.mp hn
  have split : List.Disjoint xs (ys++carry) := by
    apply List.disjoint_left.mpr
    intro q hq hh
    exact List.disjoint_left.mp hdis hq (List.mem_cons_of_mem _ hh)
  have nd := List.nodup_append'.mp words.2
  let u : State := ⟨s.phase,fun q => if q∈ys then !s.basis q else s.basis q⟩
  have ci : cin∉ys := fun h => words.1 (by simp [h])
  have clean : ∀q∈carry,u.basis q=false := by
    intro q hq; have away : q∉ys := fun h => List.disjoint_left.mp nd.2.2 h hq
    simp only [show u.basis q=s.basis q from by simp [u,away],hclean q hq]
  have source : regValue xs u.basis=regValue xs s.basis :=
    regValue_congr _ _ _ (fun q hq => by simp [u,show q∉ys from fun h => List.disjoint_left.mp split hq (by simp [h])])
  have input : regValue ys u.basis=2^ys.length-1-regValue ys s.basis := by
    rw [regValue_congr ys _ (fun q => !s.basis q) (by intro q hq; simp [u,hq]),regValue_complement]
  have add := addInPlace_readonly_correct xs ys carry cin hn hdis hl hc u m clean
  apply BalancedInverse.complement_sandwich ys nd.1 (addInPlace xs ys carry cin)
    (regValue xs s.basis) (s.basis cin).toNat s m
    (by simpa only [hl] using regValue_lt xs s.basis) (by cases s.basis cin <;> decide)
  simpa only [source,input,show u.basis cin=s.basis cin from by simp [u,ci]] using add


end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic Instr

theorem complement_run (q : Wire) (x : List Wire) (hq : q∉x)
    (s : State) (m : List Bool) :
    run (signComplement q x) m s = if s.basis q then run (notRegister x) m s else s := by
  induction x generalizing s with
  | nil => cases s.basis q <;> rfl
  | cons a x ih =>
    have hqa : q≠a := fun h => hq (by simp [h])
    have hqt : q∉x := fun h => hq (List.mem_cons_of_mem _ h)
    simp only [signComplement,List.map_cons,run]
    change run (signComplement q x) m
      ⟨s.phase,writeBit s.basis a (s.basis a ^^ s.basis q)⟩ = _
    rw [ih hqt]
    cases hs : s.basis q <;> simp [hs,writeBit,hqa,notRegister,run]

theorem complement_bit (q : Wire) (x : List Wire) (hn : x.Nodup) (hq : q∉x)
    (s : State) (m : List Bool) (a : Wire) :
    (run (signComplement q x) m s).basis a=
      if a∈x then s.basis a ^^ s.basis q else s.basis a := by
  rw [complement_run q x hq]
  cases hs:s.basis q
  · simp [hs]
  · simp only [hs,if_true,notRegister_correct x hn]
    by_cases ha:a∈x <;> simp [ha]

theorem complement_read (q : Wire) (data source : List Wire)
    (hn : data.Nodup) (hq : q∉data) (sub : ∀a∈source,a∈data)
    (s : State) (m : List Bool) :
    regValue source (run (signComplement q data) m s).basis=
      if s.basis q then 2^source.length-1-regValue source s.basis else regValue source s.basis := by
  cases hs:s.basis q
  · apply regValue_congr
    intro a ha
    simp [complement_bit q data hn hq s m a,sub a ha,hs]
  · rw [regValue_congr source _ (fun a=>!s.basis a) (by
      intro a ha
      simp [complement_bit q data hn hq s m a,sub a ha,hs]),regValue_complement]
    simp [hs]

def signedReadAdd (q : Wire) (data source target carry : List Wire) : Program :=
  signComplement q data++addInPlace source target carry q++signComplement q data

theorem signedReadAdd_correct (q : Wire) (data source target carry : List Wire)
    (nd : data.Nodup) (sep : List.Disjoint data (q::target++carry))
    (hn : (q::target++carry).Nodup) (sub : ∀a∈source,a∈data)
    (hl : source.length=target.length) (hc : carry.length+1=target.length)
    (s : State) (m : List Bool) (clean : ∀a∈carry,s.basis a=false) :
    (run (signedReadAdd q data source target carry) m s).phase=s.phase ∧
    (∀a,a∉target → (run (signedReadAdd q data source target carry) m s).basis a=s.basis a) ∧
    regValue target (run (signedReadAdd q data source target carry) m s).basis=
      signedWordValue target.length (s.basis q) (regValue source s.basis) (regValue target s.basis) := by
  have away : q∉data:=fun h=>List.disjoint_left.mp sep h (by simp)
  have sourceSep : List.Disjoint source (q::target++carry):=
    List.disjoint_left.mpr (fun a ha hh=>List.disjoint_left.mp sep (sub a ha) hh)
  have notData (a : Wire) (ha : a∈q::target++carry) : a∉data:=
    fun h=>List.disjoint_left.mp sep h ha
  let u:=run (signComplement q data) m s
  have first:=signComplement_correct q data nd away s m
  have ctrl : u.basis q=s.basis q:=first.2.1 q away
  have targetValue : regValue target u.basis=regValue target s.basis:=
    regValue_congr _ _ _ (fun a ha=>first.2.1 a (notData a (by simp [ha])))
  have cl : ∀a∈carry,u.basis a=false:=fun a ha=>
    (first.2.1 a (notData a (by simp [ha]))).trans (clean a ha)
  have sourceValue := complement_read q data source nd away sub s m
  have ad:=addInPlace_readonly_correct source target carry q hn sourceSep hl hc u m cl
  let v:=run (addInPlace source target carry q) m u
  have ctrl2 : v.basis q=s.basis q:=(ad.2.1 q
    (fun h=>(List.nodup_cons.mp hn).1 (by simp [h]))).trans ctrl
  have untouched (a : Wire) (ha : a∈data) : v.basis a=u.basis a:=
    ad.2.1 a (fun h=>List.disjoint_left.mp sep ha (by simp [h]))
  let z:=run (signComplement q data) (m.drop (measurementCount (addInPlace source target carry q))) v
  have last:=signComplement_correct q data nd away v
    (m.drop (measurementCount (addInPlace source target carry q)))
  have eq : run (signedReadAdd q data source target carry) m s=z := by
    simp only [signedReadAdd,List.append_assoc,run_append,run_take,
      (signComplement_counts q data).2,List.drop_zero]
    rw [show run (signComplement q data) (m.take 0) s=run (signComplement q data) m s by
      simpa only [(signComplement_counts q data).2] using run_take (signComplement q data) m s]
  rw [eq]
  refine ⟨last.1.trans (ad.1.trans first.1),?_,?_⟩
  · intro a ha
    by_cases hd:a∈data
    · change (run (signComplement q data) _ v).basis a=s.basis a
      rw [complement_bit q data nd away,if_pos hd,untouched a hd,ctrl2]
      change ((run (signComplement q data) m s).basis a ^^ s.basis q)=s.basis a
      rw [complement_bit q data nd away,if_pos hd]
      cases s.basis a <;> cases s.basis q <;> rfl
    · exact (last.2.1 a hd).trans ((ad.2.1 a ha).trans (first.2.1 a hd))
  · have target2 : regValue target z.basis=regValue target v.basis:=
      regValue_congr _ _ _ (fun a ha=>last.2.1 a (notData a (by simp [ha])))
    rw [target2,ad.2.2,targetValue,sourceValue,ctrl]
    cases hs:s.basis q
    · simp [hs,signedWordValue,Nat.add_comm]
    · have bound:=regValue_lt source s.basis
      simp only [hs,if_true,Bool.toNat_true,signedWordValue]
      congr 1
      simp only [hl] at bound ⊢
      omega
def signedReadSub (q : Wire) (data source target carry : List Wire) : Program :=
  signComplement q data++subInPlace source target carry q++signComplement q data

theorem signedReadSub_correct (q : Wire) (data source target carry : List Wire)
    (nd : data.Nodup) (sep : List.Disjoint data (q::target++carry))
    (hn : (q::target++carry).Nodup) (sub : ∀a∈source,a∈data)
    (hl : source.length=target.length) (hc : carry.length+1=target.length)
    (s : State) (m : List Bool) (clean : ∀a∈carry,s.basis a=false) :
    (run (signedReadSub q data source target carry) m s).phase=s.phase ∧
    (∀a,a∉target → (run (signedReadSub q data source target carry) m s).basis a=s.basis a) ∧
    regValue target (run (signedReadSub q data source target carry) m s).basis=
      signedWordValue target.length (!s.basis q) (regValue source s.basis) (regValue target s.basis) := by
  have away : q∉data:=fun h=>List.disjoint_left.mp sep h (by simp)
  have sourceSep : List.Disjoint source (q::target++carry):=
    List.disjoint_left.mpr (fun a ha hh=>List.disjoint_left.mp sep (sub a ha) hh)
  have notData (a : Wire) (ha : a∈q::target++carry) : a∉data:=
    fun h=>List.disjoint_left.mp sep h ha
  let u:=run (signComplement q data) m s
  have first:=signComplement_correct q data nd away s m
  have ctrl : u.basis q=s.basis q:=first.2.1 q away
  have targetValue : regValue target u.basis=regValue target s.basis:=
    regValue_congr _ _ _ (fun a ha=>first.2.1 a (notData a (by simp [ha])))
  have cl : ∀a∈carry,u.basis a=false:=fun a ha=>
    (first.2.1 a (notData a (by simp [ha]))).trans (clean a ha)
  have sourceValue := complement_read q data source nd away sub s m
  have ad:=subInPlace_readonly_correct source target carry q hn sourceSep hl hc u m cl
  let v:=run (subInPlace source target carry q) m u
  have ctrl2 : v.basis q=s.basis q:=(ad.2.1 q
    (fun h=>(List.nodup_cons.mp hn).1 (by simp [h]))).trans ctrl
  have untouched (a : Wire) (ha : a∈data) : v.basis a=u.basis a:=
    ad.2.1 a (fun h=>List.disjoint_left.mp sep ha (by simp [h]))
  let z:=run (signComplement q data) (m.drop (measurementCount (subInPlace source target carry q))) v
  have last:=signComplement_correct q data nd away v
    (m.drop (measurementCount (subInPlace source target carry q)))
  have eq : run (signedReadSub q data source target carry) m s=z := by
    simp only [signedReadSub,List.append_assoc,run_append,run_take,
      (signComplement_counts q data).2,List.drop_zero]
    rw [show run (signComplement q data) (m.take 0) s=run (signComplement q data) m s by
      simpa only [(signComplement_counts q data).2] using run_take (signComplement q data) m s]
  rw [eq]
  refine ⟨last.1.trans (ad.1.trans first.1),?_,?_⟩
  · intro a ha
    by_cases hd:a∈data
    · change (run (signComplement q data) _ v).basis a=s.basis a
      rw [complement_bit q data nd away,if_pos hd,untouched a hd,ctrl2]
      change ((run (signComplement q data) m s).basis a ^^ s.basis q)=s.basis a
      rw [complement_bit q data nd away,if_pos hd]
      cases s.basis a <;> cases s.basis q <;> rfl
    · exact (last.2.1 a hd).trans ((ad.2.1 a ha).trans (first.2.1 a hd))
  · have target2 : regValue target z.basis=regValue target v.basis:=
      regValue_congr _ _ _ (fun a ha=>last.2.1 a (notData a (by simp [ha])))
    rw [target2,ad.2.2,targetValue,sourceValue,ctrl]
    cases hs:s.basis q
    · simp [hs,signedWordValue]
    · have bound:=regValue_lt source s.basis
      simp only [hs,if_true,Bool.not_true,Bool.toNat_true,signedWordValue,Bool.false_eq_true,if_false]
      congr 1
      simp only [hl] at bound ⊢
      omega
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
theorem rawFacts (L : Layout) (hn : L.wires.Nodup) :
    L.y.Nodup ∧ List.Disjoint L.y (L.sign::rawTarget L++L.carry) ∧
    (L.sign::rawTarget L++L.carry).Nodup := by
  have all : (L.sign::(L.y++rawTarget L++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (rawLayoutND L hn) q
    simp only [rawSource,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have split:=List.nodup_append'.mp (show (L.y++(rawTarget L++L.carry)).Nodup from by
    simpa only [List.append_assoc] using (List.nodup_cons.mp all).2)
  refine ⟨split.1,?_,?_⟩
  · apply List.disjoint_left.mpr
    intro q hq hh
    rcases List.mem_cons.mp hh with rfl|hh
    · exact (List.nodup_cons.mp all).1 (by simp [hq])
    · exact List.disjoint_left.mp split.2.2 hq hh
  · apply List.nodup_cons.mpr
    exact ⟨fun h=>(List.nodup_cons.mp all).1 (by
      simpa only [List.append_assoc] using List.mem_append_right L.y h),split.2.1⟩

theorem source_sub (L : Layout) (a : Wire) (ha : a∈source L) : a∈L.y := by
  simp only [source,List.mem_append,List.mem_singleton] at ha
  rcases ha with h|rfl
  · exact h
  · simp [BalancedCleanup.Layout.y]

theorem source_len (L : Layout) : (source L).length=(rawSource L).length := by
  simp [source,rawSource]

theorem rawAdd_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0) :
    (run (rawAdd L) m s).phase=s.phase ∧
    (∀a,a∉rawTarget L → (run (rawAdd L) m s).basis a=s.basis a) ∧
    regValue (rawTarget L) (run (rawAdd L) m s).basis=
      signedWordValue 257 (s.basis L.sign) (regValue (source L) s.basis) (regValue (rawTarget L) s.basis) := by
  have facts:=rawFacts L hn
  have w:=widths L hw
  simpa only [rawAdd,signedReadAdd,w.2.1] using signedReadAdd_correct L.sign L.y (source L) (rawTarget L) L.carry
    facts.1 facts.2.1 facts.2.2 (source_sub L) (by rw [source_len];omega) (by omega) s m
    ((regValue_zero _ _).mp clean)

theorem rawSub_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0) :
    (run (rawSub L) m s).phase=s.phase ∧
    (∀a,a∉rawTarget L → (run (rawSub L) m s).basis a=s.basis a) ∧
    regValue (rawTarget L) (run (rawSub L) m s).basis=
      signedWordValue 257 (!s.basis L.sign) (regValue (source L) s.basis) (regValue (rawTarget L) s.basis) := by
  have facts:=rawFacts L hn
  have w:=widths L hw
  simpa only [rawSub,signedReadSub,w.2.1] using signedReadSub_correct L.sign L.y (source L) (rawTarget L) L.carry
    facts.1 facts.2.1 facts.2.2 (source_sub L) (by rw [source_len];omega) (by omega) s m
    ((regValue_zero _ _).mp clean)

theorem source_value (L : Layout) (s : BasisState) (copy : s L.sourceGuard=s L.ymsb) :
    regValue (source L) s=regValue (rawSource L) s := by
  rw [source,rawSource,regValue_append,regValue_append]
  simp [regValue,copy]
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField

theorem oldAdd_modular (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0) :
    (run (BalancedCircuit.rawAdd L) m s).phase=s.phase ∧
    regValue (rawTarget L) (run (BalancedCircuit.rawAdd L) m s).basis=
      signedWordValue 257 (s.basis L.sign) (regValue (rawSource L) s.basis) (regValue (rawTarget L) s.basis) := by
  have w:=widths L hw
  have old:=signedAdd_spec L.sign (rawSource L) (rawTarget L) L.carry (rawLayoutND L hn)
    (by omega) (by omega) (s.basis L.sign) (regValue (rawSource L) s.basis)
    (regValue (rawTarget L) s.basis) s m ⟨⟨⟨rfl,rfl⟩,rfl⟩,clean⟩
  refine ⟨?_,?_⟩
  · simpa only [BalancedCircuit.rawAdd,signedAdd] using old.1
  · simpa only [BalancedCircuit.rawAdd,signedAdd,w.2.1] using old.2.1.2

theorem rawAdd_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0)
    (copy : s.basis L.sourceGuard=s.basis L.ymsb) :
    run (rawAdd L) m s=run (BalancedCircuit.rawAdd L) m s := by
  have fresh:=rawAdd_correct L hw hn s m clean
  have old:=oldAdd_modular L hw hn s m clean
  have value : regValue (rawTarget L) (run (rawAdd L) m s).basis=
      regValue (rawTarget L) (run (BalancedCircuit.rawAdd L) m s).basis := by
    rw [fresh.2.2,old.2,source_value L s.basis copy]
  apply State.extensionality
  · exact fresh.1.trans old.1.symm
  · funext q
    by_cases hq:q∈rawTarget L
    · exact (regValue_eq_iff _ _ _).mp value q hq
    · exact (fresh.2.1 q hq).trans (BalancedCircuit.rawAdd_frame L hw hn s m clean q hq).symm

theorem rawSub_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (clean : regValue L.carry s.basis=0)
    (copy : s.basis L.sourceGuard=s.basis L.ymsb) :
    run (rawSub L) m s=run (BalancedInverse.rawSubtract L) m s := by
  have fresh:=rawSub_correct L hw hn s m clean
  have old:=BalancedInverse.rawSubtract_modular L hw hn s m clean
  have value : regValue (rawTarget L) (run (rawSub L) m s).basis=
      regValue (rawTarget L) (run (BalancedInverse.rawSubtract L) m s).basis := by
    rw [fresh.2.2,old.2.2,source_value L s.basis copy]
  apply State.extensionality
  · exact fresh.1.trans old.1.symm
  · funext q
    by_cases hq:q∈rawTarget L
    · exact (regValue_eq_iff _ _ _).mp value q hq
    · exact (fresh.2.1 q hq).trans (old.2.1 q hq).symm
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic
attribute [local irreducible] wires run

theorem copy_sandwich_cancel (a b : Wire) (P : Program)
    (free : b∉wires P) (s : State) (m : List Bool)
    (stable : (run P m (run [.CX a b] [] s)).basis a=s.basis a) :
    run ([.CX a b]++P++[.CX a b]) m s=run P m s := by
  let c:=run [.CX a b] [] s
  let u:=run P m c
  let t:=run P m s
  have read (q : Wire) (hq : q∈wires P) : c.basis q=s.basis q := by
    have qb:q≠b:=fun e=>free (e ▸ hq)
    simp [c,run,writeBit,qb]
  have increment:=run_local_increment P c s m read
  have phase:u.phase=t.phase := by
    have h:=increment.1
    rw [show c.phase=s.phase by simp [c,run]] at h
    change (u.phase ^^ s.phase)=(t.phase ^^ s.phase) at h
    cases hu:u.phase <;> cases ht:t.phase <;> cases hs:s.phase <;> simp_all
  have outside (q : Wire) (qb : q≠b) : u.basis q=t.basis q := by
    by_cases hp:q∈wires P
    · exact increment.2 q hp
    · exact (run_preserves_outside P m c q hp).trans
        ((by simp [c,run,writeBit,qb] : c.basis q=s.basis q).trans
          (run_preserves_outside P m s q hp).symm)
  have ub:u.basis b=(s.basis b ^^ s.basis a) := by
    have cb:c.basis b=(s.basis b ^^ s.basis a):=by simp [c,run,writeBit]
    exact (run_preserves_outside P m c b free).trans cb
  have tb:t.basis b=s.basis b:=run_preserves_outside P m s b free
  have ua:u.basis a=s.basis a:=stable
  have actual : run ([.CX a b]++P++[.CX a b]) m s=
      run [.CX a b] (m.drop (measurementCount P)) u := by
    simp only [List.append_assoc,run_append,show measurementCount [Instr.CX a b]=0 from rfl,
      List.take_zero,List.drop_zero,run_take]
    rfl
  rw [actual]
  apply State.extensionality
  · simpa only [run] using phase
  · funext q
    by_cases qb:q=b
    · subst q
      simp only [run,writeBit,Function.update_self]
      change (u.basis b ^^ u.basis a)=t.basis b
      rw [ub,ua,tb]
      cases s.basis b <;> cases s.basis a <;> rfl
    · simp only [run]
      change writeBit u.basis b (u.basis b ^^ u.basis a) q=t.basis q
      rw [writeBit,Function.update_of_ne qb]
      exact outside q qb

theorem copy_sandwich_source (a b : Wire) (ne : a≠b) (P : Program)
    (s : State) (m : List Bool) :
    (run ([.CX a b]++P++[.CX a b]) m s).basis a=
      (run P m (run [.CX a b] [] s)).basis a := by
  simp only [List.append_assoc,run_append,show measurementCount [Instr.CX a b]=0 from rfl,
    List.take_zero,List.drop_zero,run_take]
  simp only [run,writeBit,Function.update_of_ne ne]

end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run wires

theorem seeded_raw_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (rawAdd L) m (run (seedViews L) m s)=
      run (BalancedCircuit.rawAdd L) m (run (seedViews L) m s) := by
  have seed:=compose_seed_frame L hw hn s m hc
  have scalar:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have ys : (run (seedViews L) m s).basis L.ymsb=s.basis L.ymsb:=
    seed.2.2 _ (by tauto) (by tauto) (by tauto)
  apply rawAdd_eq L hw hn
  · apply (regValue_zero _ _).mpr
    intro q hq
    have cv:=compose_clean_views L hn q (by simp [hq])
    have qo:q≠L.one:=fun e=>cv.1 (e ▸ (by simp [rawTarget]))
    exact (seed.2.2 q cv.2.1 qo cv.2.2.1).trans (hc q cv.2.2.2)
  · exact seed.2.1.trans ys.symm

theorem old_forward_sandwich (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawAdd L)=measurementCount (BalancedCircuit.rawAdd L))
    (s : State) (m : List Bool) (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (ShortBiasedFold.program L) m s=
      run ([.CX L.ymsb L.sourceGuard]++forward L++[.CX L.ymsb L.sourceGuard]) m s := by
  let tail:=ShortBiasedFold.remainder L++cleanup L++[.CX L.ymsb L.sourceGuard]
  have eq : run (seedViews L++(BalancedCircuit.rawAdd L++tail)) m s=
      run (seedViews L++(rawAdd L++tail)) m s := by
    simp only [run_append,run_take,show measurementCount (seedViews L)=0 from rfl,List.drop_zero]
    rw [show run (seedViews L) (m.take 0) s=run (seedViews L) m s by
      simpa only [show measurementCount (seedViews L)=0 from rfl] using run_take (seedViews L) m s]
    rw [seeded_raw_eq L hw hn s m hc,sameM]
  simpa only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,BiasedCircuit.cleanupSuffix,
    forward,cleanup,tail,seedViews,seed,List.append_assoc] using eq

theorem forward_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawAdd L)=measurementCount (BalancedCircuit.rawAdd L))
    (free : L.sourceGuard∉wires (forward L))
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    run (forward L) m s=run (ShortBiasedFold.program L) m s := by
  have old:=ShortBiasedFold.program_correct L hw hn B X Y hx hy s m hs hr hyr hc
  have same:=old_forward_sandwich L hw hn sameM s m hc
  have scalar:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have ne:L.ymsb≠L.sourceGuard:=by tauto
  have notR:L.ymsb∉L.r:=by
    intro h
    have split:=List.nodup_append'.mp (show (BalancedCircuit.rawSource L++(rawTarget L++L.carry)).Nodup from by
      simpa only [List.append_assoc] using (List.nodup_cons.mp (rawLayoutND L hn)).2)
    have hy:L.ymsb∈BalancedCircuit.rawSource L:=by simp [BalancedCircuit.rawSource,BalancedCleanup.Layout.y]
    have ht:L.ymsb∈rawTarget L++L.carry:=by simp [rawTarget,h]
    exact List.disjoint_left.mp split.2.2 hy ht
  have out : (run ([.CX L.ymsb L.sourceGuard]++forward L++[.CX L.ymsb L.sourceGuard]) m s).basis L.ymsb=
      s.basis L.ymsb := by rw [←same]; exact old.2.2.2 _ notR
  have stable : (run (forward L) m (run [.CX L.ymsb L.sourceGuard] [] s)).basis L.ymsb=s.basis L.ymsb := by
    rw [←copy_sandwich_source L.ymsb L.sourceGuard ne]
    exact out
  exact (copy_sandwich_cancel L.ymsb L.sourceGuard (forward L) free s m stable).symm.trans same.symm
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField BiasedInverse ShortBiasedInverse
attribute [local irreducible] run measurementCount

def inversePrefix (L : Layout) : Program:=
  recoverPrefix L++unbiasView L++ShortBiasedInverse.restoreRaw L

theorem inverse_prefix_ready (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    let t:=run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)
    regValue L.carry t.basis=0 ∧ t.basis L.sourceGuard=t.basis L.ymsb := by
  let X := BalancedInverse.result B R Y
  let T := rawSum B X Y
  let P := originalParity T
  let u0 := run [.CX L.ymsb L.sourceGuard] m s
  let u1 := run (recoverPrefix L) m u0
  let m1 := m.drop (measurementCount (recoverPrefix L))
  let u2 := run (unbiasView L) m1 u1
  let m2 := m1.drop (measurementCount (unbiasView L))
  let u3 := run (ShortBiasedInverse.restoreRaw L) m2 u2
  have hx : Centered X := BalancedInverse.result_bounds B R Y
  have ht : -(2*q)≤T ∧ T≤2*q := rawSum_bounds B X Y hx hy
  have half : halfResult T=R := BalancedInverse.result_half B R Y hr hy
  have par : decide (q < |2*R-signedY B Y|)=P := BalancedInverse.result_parity B R Y hr hy
  have w := BalancedCleanup.widths L.toLayout hw
  have rwid := BalancedCircuit.widths L hw
  have cnd : L.toLayout.wires.Nodup := (List.nodup_append'.mp hn).2.1
  have nd := scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  rcases nd with ⟨⟨h0_1,h0_2,h0_3,h0_4,h0_5,h0_6,h0_7,h0_8,h0_9,h0_10⟩,⟨h1_2,h1_3,h1_4,h1_5,h1_6,h1_7,h1_8,h1_9,h1_10⟩,⟨h2_3,h2_4,h2_5,h2_6,h2_7,h2_8,h2_9,h2_10⟩,⟨h3_4,h3_5,h3_6,h3_7,h3_8,h3_9,h3_10⟩,⟨h4_5,h4_6,h4_7,h4_8,h4_9,h4_10⟩,⟨h5_6,h5_7,h5_8,h5_9,h5_10⟩,⟨h6_7,h6_8,h6_9,h6_10⟩,⟨h7_8,h7_9,h7_10⟩,⟨h8_9,h8_10⟩,h9_10⟩
  have h0_1r := Ne.symm h0_1
  have h0_2r := Ne.symm h0_2
  have h0_3r := Ne.symm h0_3
  have h0_4r := Ne.symm h0_4
  have h0_5r := Ne.symm h0_5
  have h0_6r := Ne.symm h0_6
  have h0_7r := Ne.symm h0_7
  have h0_8r := Ne.symm h0_8
  have h0_9r := Ne.symm h0_9
  have h0_10r := Ne.symm h0_10
  have h1_2r := Ne.symm h1_2
  have h1_3r := Ne.symm h1_3
  have h1_4r := Ne.symm h1_4
  have h1_5r := Ne.symm h1_5
  have h1_6r := Ne.symm h1_6
  have h1_7r := Ne.symm h1_7
  have h1_8r := Ne.symm h1_8
  have h1_9r := Ne.symm h1_9
  have h1_10r := Ne.symm h1_10
  have h2_3r := Ne.symm h2_3
  have h2_4r := Ne.symm h2_4
  have h2_5r := Ne.symm h2_5
  have h2_6r := Ne.symm h2_6
  have h2_7r := Ne.symm h2_7
  have h2_8r := Ne.symm h2_8
  have h2_9r := Ne.symm h2_9
  have h2_10r := Ne.symm h2_10
  have h3_4r := Ne.symm h3_4
  have h3_5r := Ne.symm h3_5
  have h3_6r := Ne.symm h3_6
  have h3_7r := Ne.symm h3_7
  have h3_8r := Ne.symm h3_8
  have h3_9r := Ne.symm h3_9
  have h3_10r := Ne.symm h3_10
  have h4_5r := Ne.symm h4_5
  have h4_6r := Ne.symm h4_6
  have h4_7r := Ne.symm h4_7
  have h4_8r := Ne.symm h4_8
  have h4_9r := Ne.symm h4_9
  have h4_10r := Ne.symm h4_10
  have h5_6r := Ne.symm h5_6
  have h5_7r := Ne.symm h5_7
  have h5_8r := Ne.symm h5_8
  have h5_9r := Ne.symm h5_9
  have h5_10r := Ne.symm h5_10
  have h6_7r := Ne.symm h6_7
  have h6_8r := Ne.symm h6_8
  have h6_9r := Ne.symm h6_9
  have h6_10r := Ne.symm h6_10
  have h7_8r := Ne.symm h7_8
  have h7_9r := Ne.symm h7_9
  have h7_10r := Ne.symm h7_10
  have h8_9r := Ne.symm h8_9
  have h8_10r := Ne.symm h8_10
  have h9_10r := Ne.symm h9_10
  have flagR (f : Wire) (hf : f∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one]) :
      f∉L.r := fun h => flagAway L hn f hf (by simp [h])
  have away (a : Wire)
      (ha : a∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower]++L.y++L.carry) :
      a∉rawTarget L := compose_raw_away L hn a ha
  have neq (a : Wire) (ha : a∈L.y++L.carry)
      (f : Wire) (hf : f∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one]) : a≠f :=
    by
      intro e
      apply flagAway L hn f hf
      subst a
      simp only [List.mem_append] at ha ⊢
      tauto
  have nr (a : Wire) (ha : a∈L.y++L.carry) : a∉L.r := by
    have d := (List.nodup_append'.mp (allND L hn)).2.1
    have dn : (L.r++(L.y++L.carry)).Nodup := by
      simpa only [List.append_assoc] using d
    exact fun h => List.disjoint_left.mp (List.nodup_append'.mp dn).2.2 h ha
  have f0 (a : Wire) (ha : a≠L.sourceGuard) : u0.basis a=s.basis a := by
    simp [u0,run,writeBit,ha]
  have g0 : u0.basis L.sourceGuard=s.basis L.ymsb := by
    simp [u0,run,writeBit,hc L.sourceGuard (by simp [work])]
  have r0 : regValue L.r u0.basis=encodeWord 256 R := by
    apply Eq.trans _ (word_encoding L.r 256 w.2.1 s.basis R hR)
    exact regValue_congr _ _ _ (fun a ha => f0 a
      (fun e => flagR L.sourceGuard (by simp) (e ▸ ha)))
  have y0 : regValue L.y u0.basis=encodeWord 256 Y := by
    apply Eq.trans _ (word_encoding L.y 256 w.2.2.1 s.basis Y hY)
    exact regValue_congr _ _ _ (fun a ha => f0 a (neq a (by simp [ha]) _ (by simp)))
  have z0 (a : Wire) (ha : a∈work L) (hg : a≠L.sourceGuard) : u0.basis a=false :=
    (f0 a hg).trans (hc a ha)
  have pre := recoverPrefix_correct L hw cnd R Y B hr hy u0 m r0 y0
    ((f0 _ (by assumption)).trans hs) (z0 _ (by simp [work]) (by assumption))
    (z0 _ (by simp [work]) (by assumption))
    (fun a ha => z0 a (by simp [work,ha]) (neq a (by simp [ha]) _ (by simp)))
  have p1 : u1.basis L.parity=P := by
    rw [pre.2.2.2.1,z0 _ (by simp [work]) (by assumption),par]
    exact Bool.false_xor P
  have view := unbiasView_correct L hw cnd R hr u1 m1 pre.2.1 pre.2.2.1
  have f2 (a : Wire) (ar : a∉L.r) (al : a≠L.lower) (ap : a≠L.parity) : u2.basis a=u0.basis a :=
    (view.2.2.2 a ar al).trans (pre.2.2.2.2 a ar al ap)
  have p2 : u2.basis L.parity=P :=
    (view.2.2.2 _ (flagR _ (by simp)) (by assumption)).trans p1
  have r2 : regValue L.r u2.basis=encodeWord 256 (biased (halfResult T)) := by
    rw [half]; exact view.2.1
  have restore := ShortBiasedInverse.restoreRaw_correct L hw hn T ht u2 m2 p2 r2 view.2.2.1
    ((f2 _ (flagR _ (by simp)) (by assumption) (by assumption)).trans (z0 _ (by simp [work]) (by assumption)))
    ((f2 _ (flagR _ (by simp)) (by assumption) (by assumption)).trans (z0 _ (by simp [work]) (by assumption)))
    (fun a ha => (f2 a (nr a (by simp [ha])) (neq a (by simp [ha]) _ (by simp))
      (neq a (by simp [ha]) _ (by simp))).trans
      (z0 a (by simp [work,ha]) (neq a (by simp [ha]) _ (by simp))))
  have f3 (a : Wire) (ar : a∉rawTarget L) (al : a≠L.lower) (am : a≠L.minus)
      (ap : a≠L.parity) : u3.basis a=u0.basis a :=
    (restore.2.2.2.2 a ar al am).trans
      (f2 a (fun h => ar (by simp [rawTarget,h])) al ap)
  have g3 : u3.basis L.sourceGuard=u3.basis L.ymsb := by
    have g := (f3 _ (away _ (by simp)) (by assumption) (by assumption) (by assumption)).trans g0
    have y := (f3 L.ymsb (away _ (by simp [BalancedCleanup.Layout.y]))
      (by assumption) (by assumption) (by assumption)).trans (f0 _ (by assumption))
    exact g.trans y.symm
  have carry3 : regValue L.carry u3.basis=0 := by
    apply (regValue_zero _ _).mpr
    intro a ha
    exact (f3 a (away a (by simp [ha])) (neq a (by simp [ha]) _ (by simp))
      (neq a (by simp [ha]) _ (by simp)) (neq a (by simp [ha]) _ (by simp))).trans
      (z0 a (by simp [work,ha]) (neq a (by simp [ha]) _ (by simp)))
  have actual : run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)=u3 := by
    simp only [inversePrefix,List.append_assoc,run_append,run_take]
    change run (ShortBiasedInverse.restoreRaw L) m2 (run (unbiasView L) m1
      (run (recoverPrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s)))=u3
    have ce : run [.CX L.ymsb L.sourceGuard] [] s=u0:=by simp only [u0,run]
    rw [ce]
  rw [actual]
  exact ⟨carry3,g3⟩
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run wires

private theorem replace_middle (lead old fresh tail : Program)
    (count : measurementCount old=measurementCount fresh) (s : State) (m : List Bool)
    (eq : run old (m.drop (measurementCount lead)) (run lead m s)=
      run fresh (m.drop (measurementCount lead)) (run lead m s)) :
    run (lead++old++tail) m s=run (lead++fresh++tail) m s := by
  simp only [List.append_assoc,run_append,run_take]
  rw [eq,count]

theorem old_inverse_sandwich (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawSub L)=measurementCount (BalancedInverse.rawSubtract L))
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (ShortBiasedInverse.program L) m s=
      run ([.CX L.ymsb L.sourceGuard]++inverse L++[.CX L.ymsb L.sourceGuard]) m s := by
  let lead:Program:=[.CX L.ymsb L.sourceGuard]++inversePrefix L
  let tail:Program:=(seed L).reverse++[.CX L.ymsb L.sourceGuard]
  have ready:=inverse_prefix_ready L hw hn B R Y hr hy s m hs hR hY hc
  have prefixState : run lead m s=run (inversePrefix L) m (run [.CX L.ymsb L.sourceGuard] [] s) := by
    simp only [lead,run_append,show measurementCount [Instr.CX L.ymsb L.sourceGuard]=0 from rfl,
      List.take_zero,List.drop_zero]
  have eq : run (lead++BalancedInverse.rawSubtract L++tail) m s=
      run (lead++rawSub L++tail) m s := by
    apply replace_middle _ _ _ _ sameM.symm
    rw [prefixState]
    exact (rawSub_eq L hw hn _ _ ready.1 ready.2).symm
  have oldSeed : seedViews L=[.CX L.ymsb L.sourceGuard]++seed L:=by rfl
  simpa only [ShortBiasedInverse.program,inverse,inversePrefix,lead,tail,oldSeed,
    List.reverse_append,List.reverse_cons,List.reverse_nil,List.nil_append,List.append_assoc] using eq

theorem inverse_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (sameM : measurementCount (rawSub L)=measurementCount (BalancedInverse.rawSubtract L))
    (free : L.sourceGuard∉wires (inverse L))
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (inverse L) m s=run (ShortBiasedInverse.program L) m s := by
  have old:=ShortBiasedInverse.program_correct L hw hn B R Y hr hy s m hs hR hY hc
  have same:=old_inverse_sandwich L hw hn sameM B R Y hr hy s m hs hR hY hc
  have scalar:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at scalar
  have ne:L.ymsb≠L.sourceGuard:=by tauto
  have notR:L.ymsb∉L.r:=by
    intro h
    have split:=List.nodup_append'.mp (show (BalancedCircuit.rawSource L++(rawTarget L++L.carry)).Nodup from by
      simpa only [List.append_assoc] using (List.nodup_cons.mp (rawLayoutND L hn)).2)
    have hy:L.ymsb∈BalancedCircuit.rawSource L:=by simp [BalancedCircuit.rawSource,BalancedCleanup.Layout.y]
    have ht:L.ymsb∈rawTarget L++L.carry:=by simp [rawTarget,h]
    exact List.disjoint_left.mp split.2.2 hy ht
  have out : (run ([.CX L.ymsb L.sourceGuard]++inverse L++[.CX L.ymsb L.sourceGuard]) m s).basis L.ymsb=
      s.basis L.ymsb := by rw [←same]; exact old.2.2.2 _ notR
  have stable : (run (inverse L) m (run [.CX L.ymsb L.sourceGuard] [] s)).basis L.ymsb=s.basis L.ymsb := by
    rw [←copy_sandwich_source L.ymsb L.sourceGuard ne]
    exact out
  exact (copy_sandwich_cancel L.ymsb L.sourceGuard (inverse L) free s m stable).symm.trans same.symm
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit

theorem raw_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (rawAdd L)=256 ∧ measurementCount (rawAdd L)=256 ∧
    toffoliCount (rawSub L)=256 ∧ measurementCount (rawSub L)=256 := by
  have w:=BalancedCircuit.widths L hw
  have len : (source L).length=(rawSource L).length := by simp [source,rawSource]
  have a:=addInPlace_counts (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have b:=subInPlace_counts (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have s:=signComplement_counts L.sign L.y
  simp only [rawAdd,rawSub,toffoliCount_append,measurementCount_append,a.1,a.2,b.1,b.2,s.1,s.2,w.2.1]
  norm_num

theorem old_raw_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (BalancedCircuit.rawAdd L)=256 ∧ measurementCount (BalancedCircuit.rawAdd L)=256 ∧
    toffoliCount (BalancedInverse.rawSubtract L)=256 ∧ measurementCount (BalancedInverse.rawSubtract L)=256 := by
  have w:=BalancedCircuit.widths L hw
  have a:=addInPlace_counts (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have b:=subInPlace_counts (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have s:=signComplement_counts L.sign (rawSource L)
  simp only [BalancedCircuit.rawAdd,BalancedInverse.rawSubtract,toffoliCount_append,measurementCount_append,
    a.1,a.2,b.1,b.2,s.1,s.2,w.2.1]
  norm_num

theorem raw_measurement_eq (L : Layout) (hw : L.Widths) :
    measurementCount (rawAdd L)=measurementCount (BalancedCircuit.rawAdd L) ∧
    measurementCount (rawSub L)=measurementCount (BalancedInverse.rawSubtract L) := by
  have a:=raw_counts L hw
  have b:=old_raw_counts L hw
  omega
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic ECDSAAdd.RecordedQuantum BalancedCircuit
theorem addInPlace_readonly_physical (x y carry : List Wire) (cin : Wire)
    (hn : (cin :: y ++ carry).Nodup)
    (hd : List.Disjoint x (cin :: y ++ carry)) : GatePhysical (addInPlace x y carry cin) := by
  induction x generalizing y carry cin with
  | nil => simp [addInPlace,GatePhysical]
  | cons a xs ih =>
    cases xs with
    | nil =>
      cases y with
      | nil => simp [addInPlace,GatePhysical]
      | cons b ys =>
        cases ys with
        | cons b' ys => simp [addInPlace,GatePhysical]
        | nil =>
          have hab : a ≠ b := by
            intro e
            exact List.disjoint_left.mp hd List.mem_cons_self (by simp [e])
          have hcb : cin ≠ b := by
            intro e; subst cin
            have h := List.nodup_iff_count.mp hn b
            simp only [List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
            omega
          simp [addInPlace,GatePhysical,PhysicalInstr,ProperGate,hab,hcb]
    | cons a' xs =>
      cases y with
      | nil => simp [addInPlace,GatePhysical]
      | cons b ys =>
        cases ys with
        | nil => simp [addInPlace,GatePhysical]
        | cons b' ys =>
          cases carry with
          | nil => simp [addInPlace,GatePhysical]
          | cons k ks =>
            have hs : [a,b,cin,k].Nodup := by
              have hk : [b,cin,k].Nodup := by
                apply List.nodup_iff_count.mpr; intro q
                have h := List.nodup_iff_count.mp hn q
                simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
              have away : a∉[b,cin,k] := by
                intro mem
                apply List.disjoint_left.mp hd List.mem_cons_self
                simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at mem ⊢
                tauto
              exact List.nodup_cons.mpr ⟨away,hk⟩
            have ht : (k :: (b'::ys) ++ ks).Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := List.nodup_iff_count.mp hn q
              simp only [List.count_cons,List.count_append] at h ⊢; omega
            have hdis : List.Disjoint (a'::xs) (k :: (b'::ys) ++ ks) := by
              apply List.disjoint_left.mpr
              intro w hw hh
              apply List.disjoint_left.mp hd (List.mem_cons_of_mem _ hw)
              simp only [List.mem_cons,List.mem_append] at hh ⊢
              tauto
            have htail := ih (b'::ys) ks k ht hdis
            rw [addInPlace]
            simp only [gatePhysical_append]
            refine ⟨⟨⟨majority_physical _ _ _ _ hs,htail⟩,eraseCarry_physical _ _ _ _⟩,?_⟩
            simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
              not_or,not_false_eq_true,and_true] at hs
            have hcb : cin ≠ b := Ne.symm hs.2.1.1
            simp [GatePhysical,PhysicalInstr,ProperGate,hs.1.1,hcb]

private theorem physical_facts (L : Layout) (hn : L.wires.Nodup) :
    L.y.Nodup ∧ List.Disjoint L.y (L.sign::rawTarget L++L.carry) ∧
    (L.sign::rawTarget L++L.carry).Nodup := by
  have all : (L.sign::(L.y++rawTarget L++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (rawLayoutND L hn) q
    simp only [rawSource,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have split:=List.nodup_append'.mp (show (L.y++(rawTarget L++L.carry)).Nodup from by
    simpa only [List.append_assoc] using (List.nodup_cons.mp all).2)
  refine ⟨split.1,?_,?_⟩
  · apply List.disjoint_left.mpr
    intro q hq hh
    rcases List.mem_cons.mp hh with rfl|hh
    · exact (List.nodup_cons.mp all).1 (by simp [hq])
    · exact List.disjoint_left.mp split.2.2 hq hh
  · apply List.nodup_cons.mpr
    exact ⟨fun h=>(List.nodup_cons.mp all).1 (by
      simpa only [List.append_assoc] using List.mem_append_right L.y h),split.2.1⟩

private theorem physical_source_sub (L : Layout) (a : Wire) (ha : a∈source L) : a∈L.y := by
  simp only [source,List.mem_append,List.mem_singleton] at ha
  rcases ha with h|rfl
  · exact h
  · simp [BalancedCleanup.Layout.y]


theorem subInPlace_readonly_physical (x y carry : List Wire) (cin : Wire)
    (hn : (cin :: y ++ carry).Nodup) (hd : List.Disjoint x (cin :: y ++ carry)) :
    GatePhysical (subInPlace x y carry cin) := by
  simp only [subInPlace,gatePhysical_append]
  exact ⟨⟨notRegister_physical _,addInPlace_readonly_physical _ _ _ _ hn hd⟩,notRegister_physical _⟩

theorem raw_physical (L : Layout) (hn : L.wires.Nodup) :
    GatePhysical (rawAdd L) ∧ GatePhysical (rawSub L) := by
  have facts:=physical_facts L hn
  have dis : List.Disjoint (source L) (L.sign::rawTarget L++L.carry) := by
    apply List.disjoint_left.mpr
    intro q hq hm
    exact List.disjoint_left.mp facts.2.1 (physical_source_sub L q hq) hm
  have sc : GatePhysical (signComplement L.sign L.y) := by
    simp only [signComplement,GatePhysical,List.mem_map]
    intro i hi
    obtain ⟨q,hq,rfl⟩:=hi
    have ne : L.sign≠q := fun e=>List.disjoint_left.mp facts.2.1 hq (by simp [e])
    simpa [PhysicalInstr,ProperGate] using ne
  have a:=addInPlace_readonly_physical (source L) (rawTarget L) L.carry L.sign facts.2.2 dis
  have b:=subInPlace_readonly_physical (source L) (rawTarget L) L.carry L.sign facts.2.2 dis
  simpa only [rawAdd,rawSub,gatePhysical_append] using And.intro (And.intro (And.intro sc a) sc) (And.intro (And.intro sc b) sc)
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit
attribute [local irreducible] wires GatePhysical

theorem old_seed_eq (L : Layout) : seedViews L=[.CX L.ymsb L.sourceGuard]++seed L := by rfl

theorem old_cleanup_eq (L : Layout) :
    BiasedCircuit.cleanupSuffix L=cleanup L++[.CX L.ymsb L.sourceGuard] := by
  simp only [BiasedCircuit.cleanupSuffix,cleanup,List.append_assoc]

theorem counts (L : Layout) (hw : L.Widths) :
    toffoliCount (forward L)=1021 ∧ measurementCount (forward L)=1021 ∧
    toffoliCount (inverse L)=1021 ∧ measurementCount (inverse L)=1021 := by
  have f:=ShortBiasedFold.counts L hw
  have i:=ShortBiasedInverse.counts L hw
  have a:=raw_counts L hw
  have b:=old_raw_counts L hw
  simp only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,old_seed_eq,old_cleanup_eq,
    ShortBiasedInverse.program,toffoliCount_append,measurementCount_append,
    toffoliCount_reverse,measurementCount_reverse,b.1,b.2.1,b.2.2.1,b.2.2.2] at f i
  simp only [forward,inverse,toffoliCount_append,measurementCount_append,
    toffoliCount_reverse,measurementCount_reverse,a.1,a.2.1,a.2.2.1,a.2.2.2]
  norm_num [toffoliCount,measurementCount] at f i
  omega

theorem raw_support_subset (L : Layout) (hw : L.Widths) :
    wires (rawAdd L)⊆wires (BalancedCircuit.rawAdd L) ∧
    wires (rawSub L)⊆wires (BalancedInverse.rawSubtract L) := by
  have w:=BalancedCircuit.widths L hw
  have len : (source L).length=(rawSource L).length := by simp [source,rawSource]
  have newadd:=addInPlace_wires (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have newsub:=subInPlace_wires (source L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have oldadd:=addInPlace_wires (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have oldsub:=subInPlace_wires (rawSource L) (rawTarget L) L.carry L.sign (by omega) (by omega)
  have inclusion : (L.sign::source L++rawTarget L++L.carry).toFinset⊆
      (L.sign::rawSource L++rawTarget L++L.carry).toFinset := by
    intro q hq
    simp only [source,rawSource,List.mem_toFinset,List.mem_cons,List.mem_append,List.mem_singleton,List.not_mem_nil,or_false,or_assoc] at hq ⊢
    have ymsb : L.ymsb∈L.y := by simp [BalancedCleanup.Layout.y]
    have ym : q=L.ymsb → q∈L.y := by intro e; rw [e]; exact ymsb
    tauto
  have sign : wires (signComplement L.sign L.y)⊆(L.sign::source L++rawTarget L++L.carry).toFinset := by
    apply (signComplement_wires_subset L.sign L.y).trans
    intro q hq
    simp only [source,List.mem_toFinset,List.mem_cons,List.mem_append,List.mem_singleton,
      List.not_mem_nil,or_false,or_assoc] at hq ⊢
    tauto
  have nadd : wires (rawAdd L)⊆(L.sign::source L++rawTarget L++L.carry).toFinset := by
    simp only [rawAdd,wires_append,Finset.union_subset_iff,newadd]
    exact ⟨⟨sign,Finset.Subset.refl _⟩,sign⟩
  have nsub : wires (rawSub L)⊆(L.sign::source L++rawTarget L++L.carry).toFinset := by
    simp only [rawSub,wires_append,Finset.union_subset_iff,newsub]
    exact ⟨⟨sign,Finset.Subset.refl _⟩,sign⟩
  have oadd : (L.sign::rawSource L++rawTarget L++L.carry).toFinset⊆wires (BalancedCircuit.rawAdd L) := by
    rw [BalancedCircuit.rawAdd,wires_append,wires_append,oldadd]
    exact Finset.subset_union_right.trans (Finset.subset_union_left)
  have osub : (L.sign::rawSource L++rawTarget L++L.carry).toFinset⊆wires (BalancedInverse.rawSubtract L) := by
    rw [BalancedInverse.rawSubtract,wires_append,wires_append,oldsub]
    exact Finset.subset_union_right.trans (Finset.subset_union_left)
  exact ⟨nadd.trans (inclusion.trans oadd),nsub.trans (inclusion.trans osub)⟩

theorem forward_support (L : Layout) (hw : L.Widths) : wires (forward L)⊆L.wires.toFinset := by
  have old:=ShortBiasedProperties.forward_support L hw
  have raw:=(raw_support_subset L hw).1
  simp only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,old_seed_eq,old_cleanup_eq,
    wires_append,Finset.union_subset_iff] at old
  simp only [forward,wires_append,Finset.union_subset_iff]
  have rr : wires (rawAdd L)⊆L.wires.toFinset := raw.trans (by tauto)
  tauto

theorem inverse_support (L : Layout) (hw : L.Widths) : wires (inverse L)⊆L.wires.toFinset := by
  have old:=ShortBiasedProperties.inverse_support L hw
  have raw:=(raw_support_subset L hw).2
  simp only [ShortBiasedInverse.program,old_seed_eq,List.reverse_append,wires_append,wires_reverse,
    Finset.union_subset_iff] at old
  simp only [inverse,wires_append,wires_reverse,Finset.union_subset_iff]
  have rr : wires (rawSub L)⊆L.wires.toFinset := raw.trans (by tauto)
  tauto

theorem forward_physical (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) : GatePhysical (forward L) := by
  have old:=ShortBiasedPhysical.forward_physical L hw hn
  have raw:=(raw_physical L hn).1
  simp only [ShortBiasedFold.program,ShortBiasedFold.biasedPrefix,old_seed_eq,old_cleanup_eq,
    gatePhysical_append] at old
  simp only [forward,gatePhysical_append]
  tauto

theorem inverse_physical (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) : GatePhysical (inverse L) := by
  have old:=ShortBiasedPhysical.inverse_physical L hw hn
  have raw:=(raw_physical L hn).2
  simp only [ShortBiasedInverse.program,old_seed_eq,List.reverse_append,gatePhysical_append] at old
  simp only [inverse,gatePhysical_append]
  tauto
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit

def resetUnused (L : Layout) : Layout := {L with sourceGuard:=L.one,cout:=L.one,plus:=L.one}

theorem forward_ignores_unused (L : Layout) : forward (resetUnused L)=forward L := by rfl
theorem inverse_ignores_unused (L : Layout) : inverse (resetUnused L)=inverse L := by rfl

theorem reset_unused_away (L : Layout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus]) : q∉(resetUnused L).wires := by
  have nd : ([L.sourceGuard,L.cout,L.plus]++([L.minus]++L.toLayout.wires)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro w
    have h:=List.nodup_iff_count.mp hn w
    simp only [Layout.wires,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have away:=List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 hq
  intro h
  apply away
  change q∈[L.one,L.one,L.minus,L.one]++L.toLayout.wires at h
  simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_assoc] at h ⊢
  have qo : q=L.one → q∈L.toLayout.wires := by
    intro e
    rw [e]
    simp [BalancedCleanup.Layout.wires]
  tauto

theorem unused_free (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus]) :
    q∉wires (forward L) ∧ q∉wires (inverse L) := by
  have hw' : (resetUnused L).Widths := hw
  have f:=forward_support (resetUnused L) hw'
  have i:=inverse_support (resetUnused L) hw'
  rw [forward_ignores_unused] at f
  rw [inverse_ignores_unused] at i
  exact ⟨fun h=>reset_unused_away L hn q hq (List.mem_toFinset.mp (f h)),
    fun h=>reset_unused_away L hn q hq (List.mem_toFinset.mp (i h))⟩

theorem guard_free (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.sourceGuard∉wires (forward L) ∧ L.sourceGuard∉wires (inverse L) :=
  unused_free L hw hn _ (by simp)
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic FieldRename ShortKernelDependencies
attribute [local irreducible] signComplement addInPlace subInPlace

theorem source_map (f : Wire → Wire) (L : Layout) :
    (source L).map f=source (mapCircuit f L) := by
  simp only [source,List.map_append,List.map_cons,List.map_nil,bf_y_map]
  rfl

theorem rawAdd_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (rawAdd L)=rawAdd (mapCircuit f L) := by
  simp only [rawAdd,rename_append,signComplement_natural,addInPlace_natural,
    ← source_map,← rawTarget_map,← bf_y_map]
  rfl

theorem rawSub_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (rawSub L)=rawSub (mapCircuit f L) := by
  simp only [rawSub,rename_append,signComplement_natural,subInPlace_natural,
    ← source_map,← rawTarget_map,← bf_y_map]
  rfl

theorem seed_natural (f : Wire → Wire) (L : Layout) (hy : L.ylow≠[]) :
    renameProgram f (seed L)=seed (mapCircuit f L) := by
  have h:=FieldRename.seedViews_natural f L hy
  simp only [old_seed_eq,rename_append] at h
  change [.CX (f L.ymsb) (f L.sourceGuard)]++renameProgram f (seed L)=
    [.CX (f L.ymsb) (f L.sourceGuard)]++seed (mapCircuit f L) at h
  exact List.append_cancel_left h

theorem cleanup_natural (f : Wire → Wire) (L : Layout) :
    renameProgram f (cleanup L)=cleanup (mapCircuit f L) := by
  have h:=bf_suffix_natural f L
  simp only [old_cleanup_eq,rename_append] at h
  change renameProgram f (cleanup L)++[.CX (f L.ymsb) (f L.sourceGuard)]=
    cleanup (mapCircuit f L)++[.CX (f L.ymsb) (f L.sourceGuard)] at h
  exact List.append_cancel_right h

theorem remainder_natural (f : Wire → Wire) (L : Layout) (hw : L.Widths) (hy : L.ylow≠[]) :
    renameProgram f (ShortBiasedFold.remainder L)=ShortBiasedFold.remainder (mapCircuit f L) := by
  have h:=ShortBiasedNatural.forward_prefix_natural f L hw hy
  simp only [ShortBiasedFold.biasedPrefix,rename_append,FieldRename.seedViews_natural f L hy,
    FieldRename.rawAdd_natural] at h
  exact List.append_cancel_left (List.append_cancel_left h)

theorem forward_natural (f : Wire → Wire) (L : Layout) (hw : L.Widths) :
    renameProgram f (forward L)=forward (mapCircuit f L) := by
  have hy : L.ylow≠[] := by intro e; have h:=hw.2.1; rw [e] at h; simp at h
  simp only [forward,rename_append,seed_natural f L hy,rawAdd_natural,remainder_natural f L hw hy,
    cleanup_natural]

theorem inverse_natural (f : Wire → Wire) (L : Layout) (hy : L.ylow≠[]) (hw : L.Widths) :
    renameProgram f (inverse L)=inverse (mapCircuit f L) := by
  simp only [inverse,rename_append,rename_reverse,bi_recoverPrefix_natural,
    bi_unbiasView_natural f L hw,ShortBiasedNatural.restoreRaw_natural,rawSub_natural,seed_natural f L hy]
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic ECDSAAdd.Challenge ECDSAAdd.Baselines
theorem forward_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    gateSlots (forward L) ≤ 24000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have kw := BalancedCircuit.widths L hw
  have hb : (ShortBiasedFold.lowBits L).length=255 := by exact ShortBiasedFold.lowBits_length L
  have a := addInPlace_gateSlots_le (source L) (BalancedCircuit.rawTarget L)
    L.carry L.sign
  have r := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).1
  have l := (rotate_gateSlots_le L.r).2
  have m := mappedAdd_gateSlots_le (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus
  have u := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.positiveLiteral
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  have sl : (source L).length=257 := by simpa [source,BalancedCircuit.rawSource] using kw.1
  rw [sl] at a
  rw [kw.2.1] at r
  rw [w.2.1] at l
  rw [hb] at m
  rw [w.1] at u
  rw [w.2.1,w.2.2.1] at c
  simp only [forward,seed,ShortBiasedFold.remainder,cleanup,
    BiasedCircuit.prepareFold,BiasedCircuit.signView,ShortBiasedFold.shortFold,
    BiasedCircuit.releaseSelectors,BiasedCircuit.flipBias,seed,
    rawAdd,BalancedCleanup.prepareSign,BalancedCleanup.prepareCompare,
    BalancedCleanup.unnormalize,gateSlots_append,reverse_gateSlots,signComplement_gateSlots,
    gateSlots_cons,gateSlots_nil,instructionSlots,kw.1,w.2.1,w.2.2.1,List.length_cons,List.length_nil]
  omega

theorem inverse_slots (L : BalancedCircuit.Layout) (hw : L.Widths) :
    Challenge.gateSlots (inverse L) ≤ 25000 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have rw := BalancedCircuit.widths L hw
  have a := literalAdd_gateSlots_le L.low (L.carry.take 254) L.lower L.one
    BalancedCleanup.negativeLiteral
  have c := compareLt_gateSlots_le none L.y L.r L.carry L.one L.parity
  have b := mappedSub_gateSlots_le (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus
  have s := subInPlace_gateSlots_le (source L) (BalancedCircuit.rawTarget L) L.carry L.sign
  have r := (rotate_gateSlots_le L.r).2
  have rt := (rotate_gateSlots_le (BalancedCircuit.rawTarget L)).2
  rw [w.1] at a
  rw [w.2.2.1,w.2.1] at c
  have bl : (ShortBiasedFold.lowBits L).length=255 := ShortBiasedFold.lowBits_length L
  rw [bl,w.1] at b
  have sl : (source L).length=257 := by simpa [source,BalancedCircuit.rawSource] using rw.1
  rw [sl,rw.2.1] at s
  rw [w.2.1] at r
  rw [rw.2.1] at rt
  simp only [inverse,BiasedInverse.recoverPrefix,BiasedInverse.unbiasView,
    ShortBiasedInverse.restoreRaw,BiasedInverse.selectors,ShortBiasedInverse.unfoldBias,ShortBiasedFold.shortUnfold,BiasedInverse.release,
    rawSub,BalancedCleanup.prepareSign,BalancedCleanup.normalize,
    BalancedCleanup.prepareCompare,seed,gateSlots_append,reverse_gateSlots,
    signComplement_gateSlots,gateSlots_cons,gateSlots_nil,instructionSlots,
    w.2.1,w.2.2.1,rw.1,List.length_cons,List.length_nil]
  omega
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.GuardCompression
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run

theorem forward_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈BalancedCircuit.work L,s.basis q=false) :
    let t:=run (forward L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (halfResult (rawSum B X Y)) ∧
    (∀q∈BalancedCircuit.work L,t.basis q=false) ∧ (∀q,q∉L.r → t.basis q=s.basis q) := by
  rw [forward_eq L hw hn (raw_measurement_eq L hw).1 (guard_free L hw hn).1 B X Y hx hy s m hs hr hyr hc]
  exact ShortBiasedFold.program_correct L hw hn B X Y hx hy s m hs hr hyr hc

theorem inverse_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    let t:=run (inverse L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (BalancedInverse.result B R Y) ∧
    (∀a∈work L,t.basis a=false) ∧ (∀a,a∉L.r → t.basis a=s.basis a) := by
  rw [inverse_eq L hw hn (raw_measurement_eq L hw).2 (guard_free L hw hn).2 B R Y hr hy s m hs hR hY hc]
  exact ShortBiasedInverse.program_correct L hw hn B R Y hr hy s m hs hR hY hc
end ECDSAAdd.Entrant.GuardCompression

end

section
set_option maxHeartbeats 2500000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic
attribute [local irreducible] run wires

def Apart (b : Wire) (s t : State) : Prop:=s.phase=t.phase ∧ ∀q,q≠b→s.basis q=t.basis q
def erase (b : Wire) (P : Program) : Program:=P.filter (fun i=>decide (b∉i.wires))
def OnlyTargets (b : Wire) (P : Program) : Prop:=∀i∈P,b∈i.wires→∃a,i=Instr.CX a b

theorem away_congr (b : Wire) (P : Program) (free : b∉wires P)
    (s t : State) (m : List Bool) (agree : Apart b s t) : Apart b (run P m s) (run P m t) := by
  have read (q : Wire) (hq : q∈wires P) : s.basis q=t.basis q:=
    agree.2 q (fun e=>free (e ▸ hq))
  have inc:=run_local_increment P s t m read
  refine ⟨?_,?_⟩
  · have h:=inc.1
    rw [agree.1] at h
    cases ht:t.phase <;> simpa [ht] using h
  · intro q qb
    by_cases hp:q∈wires P
    · exact inc.2 q hp
    · exact (run_preserves_outside P m s q hp).trans
        ((agree.2 q qb).trans (run_preserves_outside P m t q hp).symm)

private theorem instructions_mem (P : Program) (q : Wire) : q∈wires P↔∃i∈P,q∈i.wires := by
  induction P with
  | nil=>simp [wires]
  | cons i p ih=>
    simp only [wires,Finset.mem_union,ih,List.mem_cons]
    constructor
    · rintro (h|⟨j,hj,hq⟩)
      · exact ⟨i,Or.inl rfl,h⟩
      · exact ⟨j,Or.inr hj,hq⟩
    · rintro ⟨j,(rfl|hj),hq⟩
      · exact Or.inl hq
      · exact Or.inr ⟨j,hj,hq⟩

theorem erase_free (b : Wire) (P : Program) : b∉wires (erase b P) := by
  intro h
  obtain ⟨i,hi,hb⟩:=(instructions_mem _ _).mp h
  have keep: b∉i.wires:=of_decide_eq_true (List.mem_filter.mp hi).2
  exact keep hb

theorem erase_apart (b : Wire) (P : Program) :
    ∀(s t : State)(m : List Bool), OnlyTargets b P→Apart b s t→
      Apart b (run (erase b P) m s) (run P m t) := by
  induction P with
  | nil=>
    intro s t m legal agree
    simpa only [erase,List.filter_nil,run] using agree
  | cons i p ih=>
    intro s t m legal agree
    have tail:OnlyTargets b p:=fun j hj hq=>legal j (List.mem_cons_of_mem _ hj) hq
    by_cases free:b∉i.wires
    · have strip:erase b (i::p)=i::erase b p:=by simp [erase,free]
      have one:b∉wires [i]:=by simpa [wires] using free
      rw [strip,show i::erase b p=[i]++erase b p by rfl,show i::p=[i]++p by rfl,
        run_append,run_append,run_take,run_take]
      exact ih _ _ _ tail (away_congr b [i] one s t m agree)
    · obtain ⟨a,rfl⟩:=legal i (by simp) (by simpa using free)
      have strip:erase b (Instr.CX a b::p)=erase b p:=by simp [erase,Instr.wires]
      rw [strip,show Instr.CX a b::p=[Instr.CX a b]++p by rfl,run_append]
      simp only [show measurementCount [Instr.CX a b]=0 from rfl,List.take_zero,List.drop_zero]
      apply ih _ _ _ tail
      refine ⟨?_,?_⟩
      · simpa only [run] using agree.1
      · intro q qb
        simpa only [run,writeBit,Function.update_of_ne qb] using agree.2 q qb

theorem erase_correct (b : Wire) (P : Program) (legal : OnlyTargets b P)
    (s : State) (m : List Bool) (restored : (run P m s).basis b=s.basis b) :
    run (erase b P) m s=run P m s := by
  have rel:=erase_apart b P s s m legal ⟨rfl,fun _ _=>rfl⟩
  apply State.extensionality
  · exact rel.1
  · funext q
    by_cases qb:q=b
    · subst q
      exact (run_preserves_outside _ _ _ _ (erase_free b P)).trans restored.symm
    · exact rel.2 q qb
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic
attribute [local irreducible] run wires

def window (a n h b c : Wire) (Q : Program) : Program :=
  [.CX a b,.CX n b]++Q++[.CX a h,.CX a n,.CX h n,.CX h b,
    .measureX c [] [.Z a,.CZ a h]]

theorem window_restored (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (same : s.basis h=s.basis n) :
    (run (window a n h b c Q) m s).basis b=false := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  let t := run [.CX a b,.CX n b] m s
  let u := run Q m t
  have ta : t.basis a=s.basis a := by simp_all [t,run,writeBit,Function.update,ne_comm]
  have th : t.basis h=s.basis n := by simp_all [t,run,writeBit,Function.update,ne_comm]
  have tb : t.basis b= (s.basis a ^^ s.basis n) := by simp_all [t,run,writeBit,Function.update,ne_comm]
  have ua : u.basis a=s.basis a := (run_preserves_outside Q m t a fa).trans ta
  have uh : u.basis h=s.basis n := (run_preserves_outside Q m t h fh).trans th
  have ub : u.basis b= (s.basis a ^^ s.basis n) := (run_preserves_outside Q m t b fb).trans tb
  have pre (v : List Bool) : run [.CX a b,.CX n b] v s=t := by simp [t,run]
  have split : run (window a n h b c Q) m s=
      run [.CX a h,.CX a n,.CX h n,.CX h b,.measureX c [] [.Z a,.CZ a h]]
        (m.drop (measurementCount Q)) u := by
    simp only [window,run_append,measurementCount_append]
    simp only [measurementCount,List.drop_zero,Nat.zero_add,run_take]
    rw [pre]
  rw [split]
  have an : a≠n := by tauto
  have ab : a≠b := by tauto
  have hb : h≠b := by tauto
  have nb : n≠b := by tauto
  have cb : c≠b := by tauto
  have ah : a≠h := by tauto
  have nh : n≠h := by tauto
  cases ha:s.basis a <;> cases hn:s.basis n
  all_goals simp only [ha,hn,Bool.false_xor,Bool.true_xor] at ua uh ub
  all_goals simp [run,writeBit,Function.update,measureAndCorrect,correct,ua,uh,ub,an,ab,hb,nb,cb,ah,nh,Ne.symm an,Ne.symm ab,Ne.symm hb,Ne.symm nb,Ne.symm cb,Ne.symm ah,Ne.symm nh]

private theorem instruction_wire (P : Program) (i : Instr) (q : Wire)
    (hi : i∈P) (hq : q∈i.wires) : q∈wires P := by
  induction P with
  | nil => simp at hi
  | cons j ps ih =>
    rcases List.mem_cons.mp hi with rfl|hi
    · simp only [wires,Finset.mem_union]; exact Or.inl hq
    · simp only [wires,Finset.mem_union]; exact Or.inr (ih hi)

theorem window_legal (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fb : b∉wires Q) :
    OnlyTargets b (window a n h b c Q) := by
  intro i hi hb
  simp only [window,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hi
  rcases hi with ((rfl|rfl)|hi)|(rfl|rfl|rfl|rfl|rfl)
  · exact ⟨a,rfl⟩
  · exact ⟨n,rfl⟩
  · exact False.elim (fb (instruction_wire Q i b hi hb))
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · exact ⟨h,rfl⟩
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires,correctionWires] at hb
    rcases hb with hb|hb|hb <;> subst b <;> simp_all


theorem window_reset (a n h b c : Wire) (Q : Program) (s : State) (m : List Bool) :
    (run (window a n h b c Q) m s).basis c=false := by
  have eq : window a n h b c Q=
      ([.CX a b,.CX n b]++Q++[.CX a h,.CX a n,.CX h n,.CX h b])++
        [.measureX c [] [.Z a,.CZ a h]] := by simp [window,List.append_assoc]
  rw [eq,run_append]
  simp [run,measureAndCorrect,writeBit]

def recycledWindow (a n h b c : Wire) (Q : Program) : Program :=
  renameProgram (Equiv.swap b c) (erase b (window a n h b c Q))

theorem recycledWindow_eq (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (carry : s.basis c=false) (same : s.basis h=s.basis n) :
    run (recycledWindow a n h b c Q) m s=run (window a n h b c Q) m s := by
  have eq := erase_correct b (window a n h b c Q) (window_legal a n h b c Q nd fb) s m
    ((window_restored a n h b c Q nd fa fb fh s m zero same).trans zero.symm)
  have rb : (run (erase b (window a n h b c Q)) m s).basis b=false := by
    rw [eq]; exact window_restored a n h b c Q nd fa fb fh s m zero same
  have rc : (run (erase b (window a n h b c Q)) m s).basis c=false := by
    rw [eq]; exact window_reset a n h b c Q s m
  exact (FieldFrameOB5.rebind_swap_run b c _ s m zero carry rb rc).trans eq

def carryWindow (a n h b c : Wire) (Q : Program) : Program :=
  [.CCX a n c]++window a n h b c Q

theorem carryWindow_legal (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fb : b∉wires Q) :
    OnlyTargets b (carryWindow a n h b c Q) := by
  intro i hi hb
  simp only [carryWindow,List.mem_append,List.mem_singleton] at hi
  rcases hi with rfl|hi
  · have small := nd
    simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at small
    simp [Instr.wires] at hb
    rcases hb with hb|hb|hb <;> subst b <;> simp_all
  · exact window_legal a n h b c Q nd fb i hi hb

theorem carryWindow_restored (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (same : s.basis h=s.basis n) :
    (run (carryWindow a n h b c Q) m s).basis b=false := by
  have small := nd
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at small
  rw [carryWindow,run_append]
  simp only [measurementCount,List.drop_zero]
  apply window_restored a n h b c Q nd fa fb fh
  · simp_all [run,writeBit,Function.update,ne_comm]
  · simp_all [run,writeBit,Function.update,ne_comm]

def recycledCarryWindow (a n h b c : Wire) (Q : Program) : Program :=
  renameProgram (Equiv.swap b c) (erase b (carryWindow a n h b c Q))

theorem recycledCarryWindow_eq (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (carry : s.basis c=false) (same : s.basis h=s.basis n) :
    run (recycledCarryWindow a n h b c Q) m s=run (carryWindow a n h b c Q) m s := by
  have eq := erase_correct b (carryWindow a n h b c Q) (carryWindow_legal a n h b c Q nd fb) s m
    ((carryWindow_restored a n h b c Q nd fa fb fh s m zero same).trans zero.symm)
  have rb : (run (erase b (carryWindow a n h b c Q)) m s).basis b=false := by
    rw [eq]; exact carryWindow_restored a n h b c Q nd fa fb fh s m zero same
  have rc : (run (erase b (carryWindow a n h b c Q)) m s).basis c=false := by
    rw [eq,carryWindow,run_append]
    exact window_reset a n h b c Q _ _
  exact (FieldFrameOB5.rebind_swap_run b c _ s m zero carry rb rc).trans eq
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 500000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic
abbrev Layout := BalancedCircuit.Layout

theorem lowBits_source (L : Layout) (q : Wire)
    (hq : q∈mappedWires (ShortBiasedFold.lowBits L)) : q=L.lower := by
  have eq : ShortBiasedFold.lowBits L =
      (List.range 255).map (fun i => ({wire:=some L.lower,flip:=BiasedCircuit.jh.testBit i} : MappedBit)) := by
    simp [ShortBiasedFold.lowBits,BiasedCircuit.biasBits]
  rw [eq] at hq
  obtain ⟨b,hb,hq⟩:=List.mem_flatMap.mp hq
  obtain ⟨i,hi,rfl⟩:=List.mem_map.mp hb
  simpa using hq

theorem low_add_free (L : Layout) (q : Wire) (ql : q≠L.lower)
    (qt : q∉L.low) (qc : q∉L.carry) (qm : q≠L.minus) :
    q∉wires (mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus) := by
  intro bad
  have h:=mappedAdd_wires_subset _ _ _ _ bad
  simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at h
  rcases h with ((h|h)|h)|h
  · exact ql (lowBits_source L q h)
  · exact qt h
  · exact qc (List.mem_of_mem_take h)
  · exact qm h

theorem low_sub_free (L : Layout) (q : Wire) (ql : q≠L.lower)
    (qt : q∉L.low) (qc : q∉L.carry) (qm : q≠L.minus) :
    q∉wires (mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus) := by
  intro bad
  have h:=mappedSub_wires_subset _ _ _ _ bad
  simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at h
  rcases h with ((h|h)|h)|h
  · exact ql (lowBits_source L q h)
  · exact qt h
  · exact qc (List.mem_of_mem_take h)
  · exact qm h

theorem actual_low_free (L : Layout) (hn : L.wires.Nodup) (q : Wire)
    (hq : q∈[L.one,L.parity,L.rmsb]) :
    q∉wires (mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus) ∧
    q∉wires (mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus) := by
  have nd : ([L.one,L.parity,L.rmsb,L.lower,L.minus]++(L.low++L.carry)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro w
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) w
    simp only [BalancedCleanup.Layout.r,List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  have small := (List.nodup_append'.mp nd).1
  have mem : q∈[L.one,L.parity,L.rmsb,L.lower,L.minus] := by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hq ⊢
    tauto
  have data : q∉L.low++L.carry :=
    fun h => List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 mem h
  have qt : q∉L.low := fun h => data (List.mem_append_left _ h)
  have qc : q∉L.carry := fun h => data (List.mem_append_right _ h)
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at small
  have ql : q≠L.lower := by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
    rcases hq with rfl|rfl|rfl <;> tauto
  have qm : q≠L.minus := by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
    rcases hq with rfl|rfl|rfl <;> tauto
  exact ⟨low_add_free L q ql qt qc qm,low_sub_free L q ql qt qc qm⟩
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic
attribute [local irreducible] run wires

theorem ccx_commute_free (a b c : Wire) (P : Program)
    (fa : a∉wires P) (fb : b∉wires P) (fc : c∉wires P)
    (s : State) (m : List Bool) :
    run P m (run [.CCX a b c] [] s)=run [.CCX a b c] [] (run P m s) := by
  let t:=run [.CCX a b c] [] s
  have agree : Apart c s t := by
    refine ⟨by simp [t,run],?_⟩
    intro q hq
    simp [t,run,writeBit,Function.update,hq]
  have rel:=away_congr c P fc s t m agree
  have pa:=run_preserves_outside P m s a fa
  have pb:=run_preserves_outside P m s b fb
  have sc:=run_preserves_outside P m s c fc
  have pc:=run_preserves_outside P m t c fc
  apply State.extensionality
  · simpa only [t,run] using rel.1.symm
  · funext q
    by_cases hq:q=c
    · subst q
      simpa [t,run,writeBit,pa,pb,sc] using pc
    · have eq:=rel.2 q hq
      simpa [t,run,writeBit,Function.update,hq] using eq.symm
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic
attribute [local irreducible] run wires

def inverseWindow (a n h b c : Wire) (Q : Program) : Program :=
  [.CX a n,.CX h n,.CX h b,.CCX a n c]++Q++
    [.CX a h,.CX h n,.CX a b,.CX h b,.measureX c [] [.CZ a h]]

theorem inverseWindow_restored (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool) (zero : s.basis b=false) :
    (run (inverseWindow a n h b c Q) m s).basis b=false := by
  have small := nd
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at small
  have an : a≠n := by tauto
  have ab : a≠b := by tauto
  have hb : h≠b := by tauto
  have nb : n≠b := by tauto
  have cb : c≠b := by tauto
  have ah : a≠h := by tauto
  have nh : n≠h := by tauto
  have ca : c≠a := by tauto
  have ch : c≠h := by tauto
  have cn : c≠n := by tauto
  let pre : Program := [.CX a n,.CX h n,.CX h b,.CCX a n c]
  let t := run pre m s
  let u := run Q m t
  have ta : t.basis a=s.basis a := by simp [t,pre,run,writeBit,Function.update,zero,an,ab,hb,nb,cb,ah,nh,ca,ch,cn,Ne.symm an,Ne.symm ab,Ne.symm hb,Ne.symm nb,Ne.symm cb,Ne.symm ah,Ne.symm nh,Ne.symm ca,Ne.symm ch,Ne.symm cn]
  have th : t.basis h=s.basis h := by simp [t,pre,run,writeBit,Function.update,zero,an,ab,hb,nb,cb,ah,nh,ca,ch,cn,Ne.symm an,Ne.symm ab,Ne.symm hb,Ne.symm nb,Ne.symm cb,Ne.symm ah,Ne.symm nh,Ne.symm ca,Ne.symm ch,Ne.symm cn]
  have tb : t.basis b=s.basis h := by simp [t,pre,run,writeBit,Function.update,zero,an,ab,hb,nb,cb,ah,nh,ca,ch,cn,Ne.symm an,Ne.symm ab,Ne.symm hb,Ne.symm nb,Ne.symm cb,Ne.symm ah,Ne.symm nh,Ne.symm ca,Ne.symm ch,Ne.symm cn]
  have ua : u.basis a=s.basis a := (run_preserves_outside Q m t a fa).trans ta
  have uh : u.basis h=s.basis h := (run_preserves_outside Q m t h fh).trans th
  have ub : u.basis b=s.basis h := (run_preserves_outside Q m t b fb).trans tb
  have preEq (v : List Bool) : run pre v s=t := by simp [t,pre,run]
  have split : run (inverseWindow a n h b c Q) m s=
      run [.CX a h,.CX h n,.CX a b,.CX h b,.measureX c [] [.CZ a h]]
        (m.drop (measurementCount Q)) u := by
    simp only [inverseWindow,run_append,measurementCount_append]
    simp only [measurementCount,List.drop_zero,Nat.zero_add,run_take]
    rw [show run [.CX a n,.CX h n,.CX h b,.CCX a n c]
      (List.take 0 (List.take (measurementCount Q) m)) s=t from preEq _]
  rw [split]
  cases ha:s.basis a <;> cases hh:s.basis h
  all_goals simp only [ha,hh] at ua uh ub
  all_goals simp [run,writeBit,Function.update,measureAndCorrect,correct,ua,uh,ub,
    an,ab,hb,nb,cb,ah,nh,ca,ch,Ne.symm an,Ne.symm ab,Ne.symm hb,Ne.symm nb,
    Ne.symm cb,Ne.symm ah,Ne.symm nh,Ne.symm ca,Ne.symm ch]

private theorem inverse_instruction_wire (P : Program) (i : Instr) (q : Wire)
    (hi : i∈P) (hq : q∈i.wires) : q∈wires P := by
  induction P with
  | nil => simp at hi
  | cons j ps ih =>
    rcases List.mem_cons.mp hi with rfl|hi
    · simp only [wires,Finset.mem_union]; exact Or.inl hq
    · simp only [wires,Finset.mem_union]; exact Or.inr (ih hi)

theorem inverseWindow_legal (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fb : b∉wires Q) :
    OnlyTargets b (inverseWindow a n h b c Q) := by
  intro i hi hb
  simp only [inverseWindow,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hi
  rcases hi with ((rfl|rfl|rfl|rfl)|hi)|(rfl|rfl|rfl|rfl|rfl)
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · exact ⟨h,rfl⟩
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires] at hb
    rcases hb with hb|hb|hb <;> subst b <;> simp_all
  · exact False.elim (fb (inverse_instruction_wire Q i b hi hb))
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires] at hb
    rcases hb with hb|hb <;> subst b <;> simp_all
  · exact ⟨a,rfl⟩
  · exact ⟨h,rfl⟩
  · simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
      not_or,not_false_eq_true,and_true] at nd
    simp [Instr.wires,correctionWires] at hb
    rcases hb with hb|hb|hb <;> subst b <;> simp_all

theorem inverseWindow_reset (a n h b c : Wire) (Q : Program) (s : State) (m : List Bool) :
    (run (inverseWindow a n h b c Q) m s).basis c=false := by
  have eq : inverseWindow a n h b c Q=
      ([.CX a n,.CX h n,.CX h b,.CCX a n c]++Q++[.CX a h,.CX h n,.CX a b,.CX h b])++
        [.measureX c [] [.CZ a h]] := by simp [inverseWindow,List.append_assoc]
  rw [eq,run_append]
  simp [run,measureAndCorrect,writeBit]

def recycledInverseWindow (a n h b c : Wire) (Q : Program) : Program :=
  renameProgram (Equiv.swap b c) (erase b (inverseWindow a n h b c Q))

theorem recycledInverseWindow_eq (a n h b c : Wire) (Q : Program)
    (nd : [a,n,h,b,c].Nodup) (fa : a∉wires Q) (fb : b∉wires Q)
    (fh : h∉wires Q) (s : State) (m : List Bool)
    (zero : s.basis b=false) (carry : s.basis c=false) :
    run (recycledInverseWindow a n h b c Q) m s=run (inverseWindow a n h b c Q) m s := by
  have eq := erase_correct b (inverseWindow a n h b c Q) (inverseWindow_legal a n h b c Q nd fb) s m
    ((inverseWindow_restored a n h b c Q nd fa fb fh s m zero).trans zero.symm)
  have rb : (run (erase b (inverseWindow a n h b c Q)) m s).basis b=false := by
    rw [eq]; exact inverseWindow_restored a n h b c Q nd fa fb fh s m zero
  have rc : (run (erase b (inverseWindow a n h b c Q)) m s).basis c=false := by
    rw [eq]; exact inverseWindow_reset a n h b c Q s m
  exact (FieldFrameOB5.rebind_swap_run b c _ s m zero carry rb rc).trans eq
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic ECDSAAdd.Arithmetic.FieldRename
attribute [local irreducible] mappedAdd mappedSub

def addBody (L : Layout) : Program :=
  mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus
def subBody (L : Layout) : Program :=
  mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus

def foldWindow (L : Layout) : Program :=
  [.CCX L.parity L.lower L.one]++
    mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one++
    [.CX L.parity L.rmsb,.CX L.parity L.lower,.CX L.rmsb L.lower,
      .measureX L.one [] [.Z L.parity,.CZ L.parity L.rmsb]]

def unfoldWindow (L : Layout) : Program :=
  [.CX L.parity L.lower,.CX L.rmsb L.lower,.CCX L.parity L.lower L.one]++
    mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one++
    [.CX L.parity L.rmsb,.CX L.rmsb L.lower,
      .measureX L.one [] [.CZ L.parity L.rmsb]]

private theorem map_fixed (f : Wire → Wire) (xs : List Wire)
    (h : ∀q∈xs,f q=q) : xs.map f=xs := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.map_cons]
    rw [h x (by simp),ih (fun q hq=>h q (by simp [hq]))]

theorem carry_rename (L : Layout) (hn : L.wires.Nodup) :
    renameProgram (Equiv.swap L.one L.minus) (addBody L)=
      mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one ∧
    renameProgram (Equiv.swap L.one L.minus) (subBody L)=
      mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one := by
  let f := Equiv.swap L.one L.minus
  have data (q : Wire) (hq : q∈L.low++L.carry) : f q=q := by
    apply Equiv.swap_apply_of_ne_of_ne
    · intro eq
      subst q
      exact BalancedCircuit.flagAway L hn L.one (by simp)
        (by simp only [BalancedCleanup.Layout.r,List.mem_append] at hq ⊢; tauto)
    · intro eq
      subst q
      exact BalancedCircuit.flagAway L hn L.minus (by simp)
        (by simp only [BalancedCleanup.Layout.r,List.mem_append] at hq ⊢; tauto)
  have lo : L.low.map f=L.low := map_fixed f L.low (fun q hq=>data q (by simp [hq]))
  have cy : (L.carry.take 254).map f=L.carry.take 254 :=
    map_fixed f _ (fun q hq=>data q (by simp [List.mem_of_mem_take hq]))
  have nd:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have lower : f L.lower=L.lower := Equiv.swap_apply_of_ne_of_ne (by tauto) (by tauto)
  have bits : (ShortBiasedFold.lowBits L).map (mapBit f)=ShortBiasedFold.lowBits L := by
    have eq : ShortBiasedFold.lowBits L =
        (List.range 255).map (fun i => ({wire:=some L.lower,flip:=BiasedCircuit.jh.testBit i} : MappedBit)) := by
      simp [ShortBiasedFold.lowBits,BiasedCircuit.biasBits]
    simp [eq,List.map_map,mapBit,lower]
  constructor
  · change renameProgram f (mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus)=_
    rw [mappedAdd_natural,bits,lo,cy]
    simp [f]
  · change renameProgram f (mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.minus)=_
    rw [mappedSub_natural,bits,lo,cy]
    simp [f]

private theorem erase_eq_of_free (b : Wire) (P : Program) (free : b∉wires P) : erase b P=P := by
  induction P with
  | nil => rfl
  | cons i p ih =>
    have head : b∉i.wires := fun h=>free (by simp [wires,h])
    have tail : b∉wires p := fun h=>free (by simp [wires,h])
    simp only [erase,List.filter_cons,decide_eq_true_eq]
    rw [if_pos head]
    congr 1
    exact ih tail

theorem foldWindow_shape (L : Layout) (hn : L.wires.Nodup) :
    recycledCarryWindow L.parity L.lower L.rmsb L.one L.minus (addBody L)=foldWindow L := by
  have nd:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have free:= (actual_low_free L hn L.one (by simp)).1
  have same : erase L.one (addBody L)=addBody L := erase_eq_of_free _ _ free
  have e : erase L.one (carryWindow L.parity L.lower L.rmsb L.one L.minus (addBody L))=
      [.CCX L.parity L.lower L.minus]++addBody L++
        [.CX L.parity L.rmsb,.CX L.parity L.lower,.CX L.rmsb L.lower,
          .measureX L.minus [] [.Z L.parity,.CZ L.parity L.rmsb]] := by
    have sq : (addBody L).filter (fun i=>decide (L.one∉i.wires))=addBody L := same
    simp only [carryWindow,window,erase,List.filter_append]
    rw [sq]
    simp [Instr.wires,correctionWires,nd,ne_comm]
  have topfix : Equiv.swap L.one L.minus L.rmsb=L.rmsb :=
    Equiv.swap_apply_of_ne_of_ne (Ne.symm (show L.one≠L.rmsb by tauto))
      (Ne.symm (show L.minus≠L.rmsb by tauto))
  simp only [recycledCarryWindow,e,rename_append]
  rw [(carry_rename L hn).1]
  simp [foldWindow,topfix,renameProgram,renameInstr,renameCorrection,Equiv.swap_apply_of_ne_of_ne,nd,ne_comm]

theorem unfoldWindow_shape (L : Layout) (hn : L.wires.Nodup) :
    recycledInverseWindow L.parity L.lower L.rmsb L.one L.minus (subBody L)=unfoldWindow L := by
  have nd:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have free:= (actual_low_free L hn L.one (by simp)).2
  have same : erase L.one (subBody L)=subBody L := erase_eq_of_free _ _ free
  have e : erase L.one (inverseWindow L.parity L.lower L.rmsb L.one L.minus (subBody L))=
      [.CX L.parity L.lower,.CX L.rmsb L.lower,.CCX L.parity L.lower L.minus]++subBody L++
        [.CX L.parity L.rmsb,.CX L.rmsb L.lower,.measureX L.minus [] [.CZ L.parity L.rmsb]] := by
    have sq : (subBody L).filter (fun i=>decide (L.one∉i.wires))=subBody L := same
    simp only [inverseWindow,erase,List.filter_append]
    rw [sq]
    simp [Instr.wires,correctionWires,nd,ne_comm]
  have topfix : Equiv.swap L.one L.minus L.rmsb=L.rmsb :=
    Equiv.swap_apply_of_ne_of_ne (Ne.symm (show L.one≠L.rmsb by tauto))
      (Ne.symm (show L.minus≠L.rmsb by tauto))
  simp only [recycledInverseWindow,e,rename_append]
  rw [(carry_rename L hn).2]
  simp [unfoldWindow,topfix,renameProgram,renameInstr,renameCorrection,Equiv.swap_apply_of_ne_of_ne,nd,ne_comm]

theorem fiveND (L : Layout) (hn : L.wires.Nodup) :
    [L.parity,L.lower,L.rmsb,L.one,L.minus].Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have h:=List.nodup_iff_count.mp (BalancedCircuit.scalarND L hn) q
  simp only [List.count_cons,List.count_nil] at h ⊢
  omega

theorem foldWindow_eq (L : Layout) (hn : L.wires.Nodup) (s : State) (m : List Bool)
    (ho : s.basis L.one=false) (hm : s.basis L.minus=false)
    (hs : s.basis L.rmsb=s.basis L.lower) :
    run (foldWindow L) m s=
      run ([.CCX L.parity L.lower L.minus]++BiasedCircuit.signView L++
        ShortBiasedFold.shortFold L++BiasedCircuit.releaseSelectors L) m s := by
  rw [←foldWindow_shape L hn]
  have eq := recycledCarryWindow_eq L.parity L.lower L.rmsb L.one L.minus (addBody L)
    (fiveND L hn) (actual_low_free L hn L.parity (by simp)).1
    (actual_low_free L hn L.one (by simp)).1
    (actual_low_free L hn L.rmsb (by simp)).1 s m ho hm hs
  simpa only [carryWindow,window,addBody,BiasedCircuit.signView,
    ShortBiasedFold.shortFold,BiasedCircuit.releaseSelectors,List.append_assoc,List.cons_append,
    List.nil_append] using eq

theorem unfoldWindow_eq (L : Layout) (hn : L.wires.Nodup) (s : State) (m : List Bool)
    (ho : s.basis L.one=false) (hm : s.basis L.minus=false) :
    run (unfoldWindow L) m s=
      run (BiasedInverse.selectors L++ShortBiasedFold.shortUnfold L++BiasedInverse.release L) m s := by
  rw [←unfoldWindow_shape L hn]
  have eq := recycledInverseWindow_eq L.parity L.lower L.rmsb L.one L.minus (subBody L)
    (fiveND L hn) (actual_low_free L hn L.parity (by simp)).2
    (actual_low_free L hn L.one (by simp)).2
    (actual_low_free L hn L.rmsb (by simp)).2 s m ho hm
  simpa only [inverseWindow,subBody,BiasedInverse.selectors,
    ShortBiasedFold.shortUnfold,BiasedInverse.release,List.append_assoc,List.cons_append,
    List.nil_append] using eq
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic

def newPrepare (L : Layout) : Program := [.CX L.one L.lower,.CX L.parity L.r0]
def remainder (L : Layout) : Program :=
  newPrepare L++rotateRight (BalancedCircuit.rawTarget L)++foldWindow L++
    BalancedCleanup.prepareSign L.toLayout++BiasedCircuit.flipBias L

def restoreRaw (L : Layout) : Program :=
  unfoldWindow L++rotateLeft (BalancedCircuit.rawTarget L)++[.CX L.parity L.r0]

def forward (L : Layout) : Program :=
  GuardCompression.seed L++GuardCompression.rawAdd L++remainder L++GuardCompression.cleanup L

def inverse (L : Layout) : Program :=
  BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L++restoreRaw L++
    GuardCompression.rawSub L++(GuardCompression.seed L).reverse
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run wires

def rawPrefix (L : Layout) : Program := GuardCompression.seed L++GuardCompression.rawAdd L

theorem rawPrefix_apart (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hc : ∀q∈work L,s.basis q=false) :
    Apart L.sourceGuard (run (rawPrefix L) m s) (run (seedViews L++BalancedCircuit.rawAdd L) m s) := by
  let t:=run [.CX L.ymsb L.sourceGuard] [] s
  have agree : Apart L.sourceGuard s t := by
    refine ⟨by simp [t,run],?_⟩
    intro q hq
    simp [t,run,writeBit,Function.update,hq]
  have free : L.sourceGuard∉wires (rawPrefix L) := by
    intro bad
    apply (GuardCompression.guard_free L hw hn).1
    have sub : wires (rawPrefix L)⊆wires (GuardCompression.forward L) := by
      simp only [rawPrefix,GuardCompression.forward,wires_append]
      intro q hq
      rcases Finset.mem_union.mp hq with hq|hq
      · exact Finset.mem_union_left _ hq
      · exact Finset.mem_union_right _ (Finset.mem_union_left _ hq)
    exact sub bad
  have a : run (seedViews L++BalancedCircuit.rawAdd L) m s=
      run (seedViews L++GuardCompression.rawAdd L) m s := by
    simp only [run_append,run_take,show measurementCount (seedViews L)=0 from rfl,List.drop_zero]
    rw [show run (seedViews L) (m.take 0) s=run (seedViews L) m s by simp [seedViews,run]]
    exact (GuardCompression.seeded_raw_eq L hw hn s m hc).symm
  have shape : seedViews L++GuardCompression.rawAdd L=
      [.CX L.ymsb L.sourceGuard]++rawPrefix L := by rfl
  have old : run (seedViews L++BalancedCircuit.rawAdd L) m s=run (rawPrefix L) m t := by
    rw [a,shape,run_append]
    simp only [show measurementCount [.CX L.ymsb L.sourceGuard]=0 from rfl,List.drop_zero]
    rfl
  rw [old]
  exact away_congr L.sourceGuard (rawPrefix L) free s t m agree

theorem rawPrefix_ready (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    let v:=run (rawPrefix L) m s
    v.basis L.lower=false ∧ v.basis L.minus=false ∧ v.basis L.r0=v.basis L.parity := by
  let u:=run (seedViews L) m s
  let v:=run (seedViews L++BalancedCircuit.rawAdd L) m s
  have apart:=rawPrefix_apart L hw hn s m hc
  have nd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have eq (q : Wire) (hq : q≠L.sourceGuard) : (run (rawPrefix L) m s).basis q=v.basis q := apart.2 q hq
  have sv:=seed_raw_signed L hw hn B X Y hx hy s m hs hr hyr hc
  have seed:=compose_seed_frame L hw hn s m hc
  have cu:=(seed_signed L hw hn X Y s m hr hyr hc).2.2
  have actual : v=run (BalancedCircuit.rawAdd L) m u := by
    simp only [v,run_append,run_take,show measurementCount (seedViews L)=0 from rfl,List.drop_zero]
    rw [show run (seedViews L) (m.take 0) s=run (seedViews L) m s by simp [seedViews,run]]
  have rf (q : Wire) (hq : q∉rawTarget L) : v.basis q=u.basis q := by
    rw [actual]
    exact rawAdd_frame L hw hn u m cu q hq
  have away (q : Wire)
      (hq : q∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower]++L.y++L.carry) :
      q∉rawTarget L := compose_raw_away L hn q hq
  have vp : v.basis L.parity=originalParity (rawSum B X Y) :=
    (rf _ (away _ (by simp))).trans (seed_parity L hw hn B X Y s m hr hyr hc)
  have vr : v.basis L.r0=originalParity (rawSum B X Y) := by
    apply word_parity L.r0 (L.rtail++[L.rmsb,L.one]) v.basis (rawSum B X Y)
    simpa [rawTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,List.append_assoc] using sv.2.1
  have vz (q : Wire) (hq : q∈[L.cout,L.minus,L.plus,L.lower]++L.carry) : v.basis q=false := by
    have cv:=compose_clean_views L hn q hq
    have qo : q≠L.one := fun e=>cv.1 (e ▸ (by simp [rawTarget]))
    exact (rf q cv.1).trans ((seed.2.2 q cv.2.1 qo cv.2.2.1).trans (hc q cv.2.2.2))
  exact ⟨(eq _ (by tauto)).trans (vz _ (by simp)),
    (eq _ (by tauto)).trans (vz _ (by simp)),
    (eq _ (by tauto)).trans (vr.trans (vp.symm.trans (eq _ (by tauto)).symm))⟩
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.OneReuseCommute
open Arithmetic

theorem ccx_cx_shared (a b c d : Wire) (hn : [a,b,c,d].Nodup) (s : State) (m : List Bool) :
    run [.CCX a b c,.CX a d] m s=run [.CX a d,.CCX a b c] m s := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at hn
  apply State.extensionality
  · rfl
  · funext q
    by_cases hc : q=c
    · subst q
      simp [run,writeBit,hn,ne_comm]
    · by_cases hd : q=d
      · subst q
        simp [run,writeBit,hn,ne_comm]
      · simp [run,writeBit,hc,hd]
end ECDSAAdd.Entrant.OneReuseCommute

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
namespace ECDSAAdd.Entrant.OneReusePrefix
open ECDSAAdd.Arithmetic BalancedCircuit
abbrev Layout := BalancedCircuit.Layout

def prepare (L : Layout) : Program := [.CX L.one L.lower,.CX L.parity L.r0]

theorem prepare_rotate_ready (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (v : State) (m n : List Bool) (hl : v.basis L.lower=false) (hm : v.basis L.minus=false)
    (hp : v.basis L.r0=v.basis L.parity) :
    let a:=run (rotateRight (rawTarget L)) n (run (prepare L) m v)
    a.basis L.one=false ∧ a.basis L.minus=false ∧ a.basis L.rmsb=a.basis L.lower ∧
    a.basis L.lower=v.basis L.one ∧ a.basis L.parity=v.basis L.parity := by
  have nd : [L.one,L.lower,L.parity,L.r0,L.minus,L.rmsb].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    simp only [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,List.count_append,
      List.count_cons,List.count_nil] at h ⊢
    omega
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  let w:=run (prepare L) m v
  let a:=run (rotateRight (rawTarget L)) n w
  have wz : w.basis L.r0=false := by simp_all [w,prepare,run,writeBit,Function.update,ne_comm]
  have wl : w.basis L.lower=v.basis L.one := by simp_all [w,prepare,run,writeBit,Function.update,ne_comm]
  have wm : w.basis L.minus=false := by simp_all [w,prepare,run,writeBit,Function.update,ne_comm]
  have wp : w.basis L.parity=v.basis L.parity := by simp_all [w,prepare,run,writeBit,Function.update,ne_comm]
  have wf (q : Wire) (ql : q≠L.lower) (q0 : q≠L.r0) : w.basis q=v.basis q := by
    simp [w,prepare,run,writeBit,ql,q0]
  have shape : rawTarget L=L.r0::foldTarget L := by
    simp [rawTarget,foldTarget,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,List.append_assoc]
  have away (f : Wire) (hf : f∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower]) :
      f∉rawTarget L := BalancedCircuit.compose_not_raw L hn f hf
  have wr : regValue (rawTarget L) w.basis=2*regValue (foldTarget L) v.basis := by
    rw [shape]
    change (if w.basis L.r0 then 1 else 0)+2*regValue (foldTarget L) w.basis=_
    rw [wz]
    simp only [Bool.false_eq_true,if_false,zero_add]
    congr 1
    apply regValue_congr
    intro q hq
    have qr : q∈rawTarget L := by rw [shape];simp [hq]
    exact wf q (fun e=>away L.lower (by simp) (e ▸ qr))
      (fun e=>BalancedCircuit.compose_not_fold_r0 L hn (e ▸ hq))
  have size := BalancedCircuit.widths L hw
  have fsize : (foldTarget L).length=256 := by
    have h:=size.2.2.1
    simp only [List.length_append,List.length_singleton] at h
    omega
  have bound:=regValue_lt (foldTarget L) v.basis
  rw [fsize] at bound
  have rot:=rotateRight_spec (rawTarget L) (rawTargetND L hn)
    (2*regValue (foldTarget L) v.basis) (by omega) w n wr
  have av : regValue (rawTarget L) a.basis=regValue (foldTarget L) v.basis := by
    have h:=rot.2
    change regValue (rawTarget L) a.basis=2*regValue (foldTarget L) v.basis/2 at h
    omega
  have af (q : Wire) (hq : q∉rawTarget L) : a.basis q=w.basis q :=
    (rotate_frame (rawTarget L) w n).2.1 q hq
  have ao : a.basis L.one=false := by
    have bit:=regValue_highBit L.r L.one a.basis
    rw [(BalancedCleanup.widths L.toLayout hw).2.1] at bit
    change a.basis L.one=true ↔ 2^256≤regValue (rawTarget L) a.basis at bit
    rw [av] at bit
    cases ba:a.basis L.one <;> simp_all <;> omega
  have ar : regValue L.r a.basis=regValue (foldTarget L) v.basis := by
    rw [rawTarget,regValue_append] at av
    simpa [regValue,ao] using av
  have highNew:=regValue_highBit L.low L.rmsb a.basis
  have highOld:=regValue_highBit (L.rtail++[L.rmsb]) L.one v.basis
  have lowlen : L.low.length=255 := (BalancedCleanup.widths L.toLayout hw).1
  have oldlen : (L.rtail++[L.rmsb]).length=255 := by simp [hw.1]
  rw [lowlen] at highNew
  rw [oldlen] at highOld
  change a.basis L.rmsb=true ↔ 2^255≤regValue L.r a.basis at highNew
  have fold_shape : L.rtail++[L.rmsb]++[L.one]=foldTarget L := by
    simp [foldTarget,List.append_assoc]
  rw [fold_shape] at highOld
  rw [ar] at highNew
  have msb : a.basis L.rmsb=v.basis L.one := by
    cases x:a.basis L.rmsb <;> cases y:v.basis L.one <;> simp_all <;> omega
  have al : a.basis L.lower=v.basis L.one := (af _ (away _ (by simp))).trans wl
  change a.basis L.one=false ∧ a.basis L.minus=false ∧ a.basis L.rmsb=a.basis L.lower ∧
    a.basis L.lower=v.basis L.one ∧ a.basis L.parity=v.basis L.parity
  exact ⟨ao,(af _ (away _ (by simp))).trans wm,msb.trans al.symm,al,
    (af _ (away _ (by simp))).trans wp⟩
end ECDSAAdd.Entrant.OneReusePrefix

end

section
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit
attribute [local irreducible] run wires rotateRight

theorem prepare_order (L : Layout) (hn : L.wires.Nodup) (s : State) (m : List Bool) :
    run (BiasedCircuit.prepareFold L) m s=
      run [.CCX L.parity L.lower L.minus] [] (run (newPrepare L) m s) := by
  have nd : [L.parity,L.lower,L.minus,L.r0].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h:=List.nodup_iff_count.mp (scalarND L hn) q
    simp only [List.count_cons,List.count_nil] at h ⊢
    omega
  have eq:=OneReuseCommute.ccx_cx_shared L.parity L.lower L.minus L.r0 nd
    (run [.CX L.one L.lower] [] s) []
  simpa only [BiasedCircuit.prepareFold,newPrepare,run] using eq

theorem prepare_rotate_order (L : Layout) (hn : L.wires.Nodup)
    (s : State) (m n : List Bool) :
    run (rotateRight (rawTarget L)) n (run (BiasedCircuit.prepareFold L) m s)=
      run [.CCX L.parity L.lower L.minus] []
        (run (rotateRight (rawTarget L)) n (run (newPrepare L) m s)) := by
  rw [prepare_order L hn s m]
  have free (q : Wire) (hq : q∈[L.parity,L.lower,L.minus]) : q∉wires (rotateRight (rawTarget L)) := by
    rw [(rotate_wires (rawTarget L)).1]
    split
    · simp
    · simp only [List.mem_toFinset]
      apply compose_not_raw L hn q
      simp only [List.mem_cons,List.not_mem_nil,or_false] at hq ⊢
      tauto
  exact ccx_commute_free L.parity L.lower L.minus (rotateRight (rawTarget L))
    (free _ (by simp)) (free _ (by simp)) (free _ (by simp)) _ n
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit

theorem window_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (foldWindow L)=255 ∧ measurementCount (foldWindow L)=255 ∧
    toffoliCount (unfoldWindow L)=255 ∧ measurementCount (unfoldWindow L)=255 := by
  have w:=BalancedCleanup.widths L.toLayout hw
  have sl:=ShortBiasedFold.lowBits_length L
  have a:=mappedAdd_counts (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one
    (by omega) (by simp [List.length_take,hw.2.2,w.1])
  have b:=mappedSub_counts (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one
    (by omega) (by simp [List.length_take,hw.2.2,w.1])
  simp only [foldWindow,unfoldWindow,toffoliCount_append,measurementCount_append,a.1,a.2,b.1,b.2,w.1]
  norm_num [toffoliCount,measurementCount]

theorem piece_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (remainder L)=255 ∧ measurementCount (remainder L)=255 ∧
    toffoliCount (restoreRaw L)=255 ∧ measurementCount (restoreRaw L)=255 := by
  have w:=window_counts L hw
  have s:=signComplement_counts L.lower L.r
  have r:=rotate_counts (rawTarget L)
  simp only [remainder,restoreRaw,newPrepare,BalancedCleanup.prepareSign,BiasedCircuit.flipBias,
    toffoliCount_append,measurementCount_append,w.1,w.2.1,w.2.2.1,w.2.2.2,s.1,s.2,
    r.1,r.2.1,r.2.2.1,r.2.2.2]
  norm_num [toffoliCount,measurementCount]

theorem old_piece_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (ShortBiasedFold.remainder L)=255 ∧ measurementCount (ShortBiasedFold.remainder L)=255 ∧
    toffoliCount (ShortBiasedInverse.restoreRaw L)=255 ∧ measurementCount (ShortBiasedInverse.restoreRaw L)=255 := by
  have w:=ShortBiasedFold.short_counts L hw
  have s:=signComplement_counts L.lower L.r
  have r:=rotate_counts (rawTarget L)
  simp only [ShortBiasedFold.remainder,ShortBiasedInverse.restoreRaw,ShortBiasedInverse.unfoldBias,
    BiasedCircuit.prepareFold,BiasedCircuit.signView,BiasedCircuit.releaseSelectors,
    BalancedCleanup.prepareSign,BiasedCircuit.flipBias,BiasedInverse.selectors,BiasedInverse.release,
    toffoliCount_append,measurementCount_append,w.1,w.2.1,w.2.2.1,w.2.2.2,s.1,s.2,
    r.1,r.2.1,r.2.2.1,r.2.2.2]
  norm_num [toffoliCount,measurementCount]

theorem kernel_counts (L : Layout) (hw : L.Widths) :
    toffoliCount (forward L)=1021 ∧ measurementCount (forward L)=1021 ∧
    toffoliCount (inverse L)=1021 ∧ measurementCount (inverse L)=1021 := by
  have old:=GuardCompression.counts L hw
  have a:=piece_counts L hw
  have b:=old_piece_counts L hw
  simp only [GuardCompression.forward,GuardCompression.inverse,toffoliCount_append,measurementCount_append,
    b.1,b.2.1,b.2.2.1,b.2.2.2] at old
  simp only [forward,inverse,toffoliCount_append,measurementCount_append,a.1,a.2.1,a.2.2.1,a.2.2.2]
  omega
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit
attribute [local irreducible] run wires rotateRight

theorem remainder_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (hl : s.basis L.lower=false) (hm : s.basis L.minus=false)
    (hp : s.basis L.r0=s.basis L.parity) :
    run (remainder L) m s=run (ShortBiasedFold.remainder L) m s := by
  let np:=newPrepare L++rotateRight (rawTarget L)
  let op:=BiasedCircuit.prepareFold L++rotateRight (rawTarget L)
  let mid:=BiasedCircuit.signView L++ShortBiasedFold.shortFold L++BiasedCircuit.releaseSelectors L
  let tail:=BalancedCleanup.prepareSign L.toLayout++BiasedCircuit.flipBias L
  let a:=run np m s
  have pn : measurementCount (newPrepare L)=0 := rfl
  have po : measurementCount (BiasedCircuit.prepareFold L)=0 := rfl
  have rot:=(rotate_counts (rawTarget L)).2.1
  have nc : measurementCount np=0 := by simp only [np,measurementCount_append,pn,rot,Nat.zero_add]
  have oc : measurementCount op=0 := by simp only [op,measurementCount_append,po,rot,Nat.zero_add]
  have ready : a.basis L.one=false ∧ a.basis L.minus=false ∧ a.basis L.rmsb=a.basis L.lower := by
    have h:=OneReusePrefix.prepare_rotate_ready L hw hn s m m hl hm hp
    have actual : a=run (rotateRight (rawTarget L)) m (run (newPrepare L) m s) := by
      dsimp only [a,np]
      rw [run_append,run_take,pn,List.drop_zero]
    rw [actual]
    exact ⟨h.1,h.2.1,h.2.2.1⟩
  have old : run op m s=run [.CCX L.parity L.lower L.minus] [] a := by
    dsimp only [op,a,np]
    rw [run_append,run_take,po,List.drop_zero,run_append,run_take,pn,List.drop_zero]
    exact prepare_rotate_order L hn s m m
  have combine : run ([.CCX L.parity L.lower L.minus]++mid) m a=
      run mid m (run [.CCX L.parity L.lower L.minus] [] a) := by
    rw [run_append]
    simp only [show measurementCount [.CCX L.parity L.lower L.minus]=0 from rfl,List.drop_zero]
    rfl
  have me : run (foldWindow L) m a=run mid m (run [.CCX L.parity L.lower L.minus] [] a) := by
    have eq:=foldWindow_eq L hn a m ready.1 ready.2.1 ready.2.2
    change run (foldWindow L) m a=run ([.CCX L.parity L.lower L.minus]++mid) m a at eq
    exact eq.trans combine
  have mc : measurementCount (foldWindow L)=measurementCount mid := by
    have n:=(window_counts L hw).2.1
    have o:=(ShortBiasedFold.short_counts L hw).2.1
    simp only [mid,measurementCount_append,n,o]
    norm_num [BiasedCircuit.signView,BiasedCircuit.releaseSelectors,measurementCount]
  have ns : remainder L=np++(foldWindow L++tail) := by simp [remainder,np,tail,List.append_assoc]
  have os : ShortBiasedFold.remainder L=op++(mid++tail) := by
    simp [ShortBiasedFold.remainder,op,mid,tail,List.append_assoc]
  rw [ns,os]
  conv_lhs => rw [run_append,run_take,nc,List.drop_zero]
  conv_rhs => rw [run_append,run_take,oc,List.drop_zero]
  rw [old]
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  rw [mc,me]

theorem forward_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : BalancedField.Centered X) (hy : BalancedField.Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    run (forward L) m s=run (GuardCompression.forward L) m s := by
  have clean:=rawPrefix_ready L hw hn B X Y hx hy s m hs hr hyr hc
  have ns : forward L=rawPrefix L++(remainder L++GuardCompression.cleanup L) := by
    simp [forward,rawPrefix,List.append_assoc]
  have os : GuardCompression.forward L=rawPrefix L++(ShortBiasedFold.remainder L++GuardCompression.cleanup L) := by
    simp [GuardCompression.forward,rawPrefix,List.append_assoc]
  rw [ns,os]
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  have eq:=remainder_eq L hw hn (run (rawPrefix L) m s) (m.drop (measurementCount (rawPrefix L)))
    clean.1 clean.2.1 clean.2.2
  have mc : measurementCount (remainder L)=measurementCount (ShortBiasedFold.remainder L) :=
    (piece_counts L hw).2.1.trans (old_piece_counts L hw).2.1.symm
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  rw [mc,eq]
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run mappedSub

theorem unfold_measurements (L : Layout) (hw : L.Widths) :
    measurementCount (unfoldWindow L)=255 := by
  have w:=BalancedCleanup.widths L.toLayout hw
  have sub:=mappedSub_counts (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one
    (by rw [ShortBiasedFold.lowBits_length,w.1])
    (by simp [List.length_take,hw.2.2,w.1])
  simp only [unfoldWindow,measurementCount_append,sub.2,w.1]
  norm_num [measurementCount]

theorem restore_measurements (L : Layout) (hw : L.Widths) :
    measurementCount (restoreRaw L)=measurementCount (ShortBiasedInverse.restoreRaw L) := by
  have new:=unfold_measurements L hw
  have old:=(ShortBiasedFold.short_counts L hw).2.2.2
  simp only [restoreRaw,ShortBiasedInverse.restoreRaw,ShortBiasedInverse.unfoldBias,
    measurementCount_append,new,old]
  norm_num [BiasedInverse.selectors,BiasedInverse.release,measurementCount]

theorem restoreRaw_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (s : State) (m : List Bool) (ho : s.basis L.one=false) (hm : s.basis L.minus=false) :
    run (restoreRaw L) m s=run (ShortBiasedInverse.restoreRaw L) m s := by
  have mid:=unfoldWindow_eq L hn s m ho hm
  have counts : measurementCount (unfoldWindow L)=
      measurementCount (BiasedInverse.selectors L++ShortBiasedFold.shortUnfold L++BiasedInverse.release L) := by
    have old:=(ShortBiasedFold.short_counts L hw).2.2.2
    simp only [measurementCount_append,old,unfold_measurements L hw]
    norm_num [BiasedInverse.selectors,BiasedInverse.release,measurementCount]
  have same : restoreRaw L=unfoldWindow L++
      (rotateLeft (rawTarget L)++[.CX L.parity L.r0]) := by simp [restoreRaw,List.append_assoc]
  have old : ShortBiasedInverse.restoreRaw L=
      (BiasedInverse.selectors L++ShortBiasedFold.shortUnfold L++BiasedInverse.release L)++
      (rotateLeft (rawTarget L)++[.CX L.parity L.r0]) := by
    simp [ShortBiasedInverse.restoreRaw,ShortBiasedInverse.unfoldBias,List.append_assoc]
  rw [same,old]
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  rw [counts,mid]

theorem inverse_view_clean (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    let t:=run (BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L) m s
    t.basis L.one=false ∧ t.basis L.minus=false := by
  let u:=run (BiasedInverse.recoverPrefix L) m s
  let m1:=m.drop (measurementCount (BiasedInverse.recoverPrefix L))
  let v:=run (BiasedInverse.unbiasView L) m1 u
  have cnd : L.toLayout.wires.Nodup := (List.nodup_append'.mp hn).2.1
  have w:=BalancedCleanup.widths L.toLayout hw
  have pre:=BiasedInverse.recoverPrefix_correct L hw cnd R Y B hr hy s m
    (word_encoding L.r 256 w.2.1 s.basis R hR)
    (word_encoding L.y 256 w.2.2.1 s.basis Y hY) hs
    (hc _ (by simp [work])) (hc _ (by simp [work]))
    (fun q hq=>hc q (by simp [work,hq]))
  have view:=BiasedInverse.unbiasView_correct L hw cnd R hr u m1 pre.2.1 pre.2.2.1
  have nd:=scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have out (q : Wire) (hq : q∈[L.one,L.minus]) : v.basis q=s.basis q := by
    have flag : q∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one] := by
      simp only [List.mem_cons,List.not_mem_nil,or_false] at hq ⊢; tauto
    have qr : q∉L.r := fun h=>flagAway L hn q flag (by simp [h])
    have ql : q≠L.lower := by simp only [List.mem_cons,List.not_mem_nil,or_false] at hq; rcases hq with rfl|rfl <;> tauto
    have qp : q≠L.parity := by simp only [List.mem_cons,List.not_mem_nil,or_false] at hq; rcases hq with rfl|rfl <;> tauto
    exact (view.2.2.2 q qr ql).trans (pre.2.2.2.2 q qr ql qp)
  have actual : run (BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L) m s=v := by
    simp only [run_append,run_take]; rfl
  rw [actual]
  exact ⟨(out _ (by simp)).trans (hc _ (by simp [work])),
    (out _ (by simp)).trans (hc _ (by simp [work]))⟩

theorem inverse_eq (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀a∈work L,s.basis a=false) :
    run (inverse L) m s=run (GuardCompression.inverse L) m s := by
  let head:=BiasedInverse.recoverPrefix L++BiasedInverse.unbiasView L
  let tail:=GuardCompression.rawSub L++(GuardCompression.seed L).reverse
  have a : inverse L=head++(restoreRaw L++tail) := by simp [inverse,head,tail,List.append_assoc]
  have b : GuardCompression.inverse L=head++(ShortBiasedInverse.restoreRaw L++tail) := by
    simp [GuardCompression.inverse,head,tail,List.append_assoc]
  have clean:=inverse_view_clean L hw hn B R Y hr hy s m hs hR hY hc
  rw [a,b]
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  have eq:=restoreRaw_eq L hw hn (run head m s) (m.drop (measurementCount head)) clean.1 clean.2
  conv_lhs => rw [run_append,run_take]
  conv_rhs => rw [run_append,run_take]
  rw [restore_measurements L hw,eq]
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit BalancedField
attribute [local irreducible] run

theorem forward_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (X Y : Int) (hx : Centered X) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hr : signedRegValue L.r s.basis=X) (hyr : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    let t:=run (forward L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (halfResult (rawSum B X Y)) ∧
    (∀q∈work L,t.basis q=false) ∧ (∀q,q∉L.r → t.basis q=s.basis q) := by
  rw [forward_eq L hw hn B X Y hx hy s m hs hr hyr hc]
  exact GuardCompression.forward_correct L hw hn B X Y hx hy s m hs hr hyr hc

theorem inverse_correct (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (B : Bool) (R Y : Int) (hr : Centered R) (hy : Centered Y)
    (s : State) (m : List Bool) (hs : s.basis L.sign=B)
    (hR : signedRegValue L.r s.basis=R) (hY : signedRegValue L.y s.basis=Y)
    (hc : ∀q∈work L,s.basis q=false) :
    let t:=run (inverse L) m s
    t.phase=s.phase ∧ regValue L.r t.basis=encodeWord 256 (BalancedInverse.result B R Y) ∧
    (∀q∈work L,t.basis q=false) ∧ (∀q,q∉L.r → t.basis q=s.basis q) := by
  rw [inverse_eq L hw hn B R Y hr hy s m hs hR hY hc]
  exact GuardCompression.inverse_correct L hw hn B R Y hr hy s m hs hR hY hc
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic ECDSAAdd.RecordedQuantum BalancedCircuit
 theorem window_physical (L : Layout) (hn : L.wires.Nodup) :
    GatePhysical (foldWindow L) ∧ GatePhysical (unfoldWindow L) := by
  have nd := BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have smallND : (L.one::(L.low++L.carry.take 254)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have count := List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
    have take := (List.take_sublist 254 L.carry).count_le q
    simp only [BalancedCleanup.Layout.r,List.count_append,List.count_cons,List.count_nil] at count ⊢
    omega
  have smallSrc : ∀q∈mappedWires (ShortBiasedFold.lowBits L),q∉L.one::(L.low++L.carry.take 254) := by
    intro q hq hmem
    have src : q=L.lower := by
      have eq : ShortBiasedFold.lowBits L =
          (List.range 255).map (fun i => ({wire:=some L.lower,flip:=BiasedCircuit.jh.testBit i} : MappedBit)) := by
        simp [ShortBiasedFold.lowBits,BiasedCircuit.biasBits]
      rw [eq] at hq
      obtain ⟨b,hb,hq⟩:=List.mem_flatMap.mp hq
      obtain ⟨i,hi,rfl⟩:=List.mem_map.mp hb
      simpa using hq
    have flag : q∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one] := by
      simp [src]
    have ne : q≠L.one := by rcases src with rfl; tauto
    simp only [List.mem_cons,List.mem_append] at hmem
    rcases hmem with he|he|he
    · exact ne he
    · exact BalancedCircuit.flagAway L hn q flag (by simp [BalancedCleanup.Layout.r,he])
    · exact BalancedCircuit.flagAway L hn q flag (by simp [List.mem_of_mem_take he])
  have topAway : L.rmsb∉L.low := by
    intro bad
    have data := List.nodup_iff_count.mp (BalancedCircuit.allND L hn) L.rmsb
    have cnt := List.count_pos_iff.mpr bad
    simp only [BalancedCleanup.Layout.r,List.count_append,List.count_cons,List.count_nil] at data
    simp at data
    omega
  have parityAway : L.parity∉L.low := by
    intro bad
    exact BalancedCircuit.flagAway L hn L.parity (by simp) (by simp [BalancedCleanup.Layout.r,bad])
  have ma : GatePhysical (mappedAdd (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one) := by
    apply mappedAdd_physical _ _ _ _ smallND
    intro bit hb q hq
    apply smallSrc q
    exact List.mem_flatMap.mpr ⟨bit,hb,by simpa using hq⟩
  have ms : GatePhysical (mappedSub (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one) := by
    have nt := notRegister_physical L.low
    simpa only [mappedSub,gatePhysical_append] using And.intro (And.intro nt ma) nt
  simp only [foldWindow,unfoldWindow,gatePhysical_append]
  constructor <;> simp_all [GatePhysical,PhysicalInstr,ProperGate,ne_comm]

 theorem forward_physical (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (forward L) := by
  have old:=GuardCompression.forward_physical L hw hn
  have nw:=(window_physical L hn).1
  have nd:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have np : GatePhysical (newPrepare L) := by simp_all [newPrepare,GatePhysical,PhysicalInstr,ProperGate,ne_comm]
  simp only [GuardCompression.forward,ShortBiasedFold.remainder,gatePhysical_append] at old
  simp only [forward,remainder,gatePhysical_append]
  tauto
 theorem inverse_physical (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (inverse L) := by
  have old:=GuardCompression.inverse_physical L hw hn
  have nw:=(window_physical L hn).2
  have nd:=BalancedCircuit.scalarND L hn
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  have np : GatePhysical [.CX L.parity L.r0] := by
    have r0 : L.parity ≠ L.r0 := by
      intro eq; exact BalancedCircuit.flagAway L hn L.parity (by simp) (by simp [BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,eq])
    simp_all [GatePhysical,PhysicalInstr,ProperGate,ne_comm]
  simp only [GuardCompression.inverse,ShortBiasedInverse.restoreRaw,gatePhysical_append] at old
  simp only [inverse,restoreRaw,gatePhysical_append]
  tauto
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit
attribute [local irreducible] wires GatePhysical
private theorem mapped_support (L : Layout) (P : Program)
    (bound : wires P ⊆ (mappedWires (ShortBiasedFold.lowBits L)++L.low++L.carry.take 254++[L.one]).toFinset) :
    wires P ⊆ L.wires.toFinset := by
  have member (a : Wire) : a∈L.wires.toFinset ↔
      a∈[L.sourceGuard,L.cout,L.minus,L.plus,L.parity,L.sign,L.lower,L.one,L.rmsb,L.ymsb,L.r0] ∨
      a∈L.rtail ∨ a∈L.ylow ∨ a∈L.carry := by
    simp [BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,or_assoc]
  intro a ha
  have h := bound ha
  simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_assoc] at h
  rcases h with src|lo|cy|last
  · have full : a∈mappedWires (BiasedCircuit.biasBits L) := by
      rw [ShortBiasedFold.biasBits_split]
      simp only [mappedWires,List.flatMap_append,List.mem_append]
      exact Or.inl src
    rcases BiasedCircuit.biasBits_sources L a full with rfl|rfl <;> simp [member]
  · simp only [BalancedCleanup.Layout.low,List.mem_cons] at lo
    simp only [member,List.mem_cons,List.not_mem_nil,or_false]
    tauto
  · exact (member a).mpr (Or.inr (Or.inr (Or.inr (List.mem_of_mem_take cy))))
  · simp [member,last]


 theorem window_support (L : Layout) :
    wires (foldWindow L) ⊆ L.wires.toFinset ∧ wires (unfoldWindow L) ⊆ L.wires.toFinset := by
  have a:=mapped_support L _ (mappedAdd_wires_subset (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one)
  have b:=mapped_support L _ (mappedSub_wires_subset (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one)
  have c : wires [.CCX L.parity L.lower L.one]⊆L.wires.toFinset := by
    intro q h; simp [wires,Instr.wires] at h
    rcases h with rfl|rfl|rfl <;> simp [Layout.wires,BalancedCleanup.Layout.wires]
  have d : wires [.CX L.parity L.rmsb,.CX L.parity L.lower,.CX L.rmsb L.lower,
      .measureX L.one [] [.Z L.parity,.CZ L.parity L.rmsb]]⊆L.wires.toFinset := by
    intro q h; simp [wires,Instr.wires,correctionWires] at h
    rcases h with rfl|rfl|rfl|rfl <;> simp [Layout.wires,BalancedCleanup.Layout.wires]
  have e : wires [.CX L.parity L.lower,.CX L.rmsb L.lower,.CCX L.parity L.lower L.one]⊆L.wires.toFinset := by
    intro q h; simp [wires,Instr.wires] at h
    rcases h with rfl|rfl|rfl|rfl <;> simp [Layout.wires,BalancedCleanup.Layout.wires]
  have f : wires [.CX L.parity L.rmsb,.CX L.rmsb L.lower,.measureX L.one [] [.CZ L.parity L.rmsb]]⊆L.wires.toFinset := by
    intro q h; simp [wires,Instr.wires,correctionWires] at h
    rcases h with rfl|rfl|rfl|rfl <;> simp [Layout.wires,BalancedCleanup.Layout.wires]
  simp only [foldWindow,unfoldWindow,wires_append,Finset.union_subset_iff]
  exact ⟨⟨⟨c,a⟩,d⟩,⟨⟨e,b⟩,f⟩⟩
 theorem forward_support (L : Layout) (hw : L.Widths) : wires (forward L)⊆L.wires.toFinset := by
  have old:=GuardCompression.forward_support L hw
  have w:=(window_support L).1
  have p : wires (newPrepare L)⊆L.wires.toFinset := by
    intro q h; simp [newPrepare,wires,Instr.wires] at h
    rcases h with rfl|rfl|rfl|rfl <;> simp [Layout.wires,BalancedCleanup.Layout.wires,BalancedCleanup.Layout.low]
  simp only [GuardCompression.forward,ShortBiasedFold.remainder,wires_append,Finset.union_subset_iff] at old
  simp only [forward,remainder,wires_append,Finset.union_subset_iff]
  tauto
 theorem inverse_support (L : Layout) (hw : L.Widths) : wires (inverse L)⊆L.wires.toFinset := by
  have old:=GuardCompression.inverse_support L hw
  have w:=(window_support L).2
  have p : wires [.CX L.parity L.r0]⊆L.wires.toFinset := by
    intro q h; simp [wires,Instr.wires] at h
    rcases h with rfl|rfl <;> simp [Layout.wires,BalancedCleanup.Layout.wires,BalancedCleanup.Layout.low]
  simp only [GuardCompression.inverse,ShortBiasedInverse.restoreRaw,wires_append,Finset.union_subset_iff] at old
  simp only [inverse,restoreRaw,wires_append,Finset.union_subset_iff]
  tauto
end ECDSAAdd.Entrant.OneReuse

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
namespace ECDSAAdd.Entrant.OneReuse
open ECDSAAdd.Arithmetic BalancedCircuit

def resetUnused (L : Layout) : Layout := {L with sourceGuard:=L.one,cout:=L.one,minus:=L.one,plus:=L.one}

theorem forward_ignores_unused (L : Layout) : forward (resetUnused L)=forward L := by rfl
theorem inverse_ignores_unused (L : Layout) : inverse (resetUnused L)=inverse L := by rfl

theorem reset_unused_away (L : Layout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus,L.minus]) : q∉(resetUnused L).wires := by
  have nd : ([L.sourceGuard,L.cout,L.plus,L.minus]++L.toLayout.wires).Nodup := by
    apply List.nodup_iff_count.mpr
    intro w
    have h:=List.nodup_iff_count.mp hn w
    simp only [Layout.wires,List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have away:=List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 hq
  intro h
  apply away
  change q∈[L.one,L.one,L.one,L.one]++L.toLayout.wires at h
  simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_assoc] at h ⊢
  have qo : q=L.one → q∈L.toLayout.wires := by
    intro e
    rw [e]
    simp [BalancedCleanup.Layout.wires]
  tauto

theorem unused_free (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈[L.sourceGuard,L.cout,L.plus,L.minus]) :
    q∉wires (forward L) ∧ q∉wires (inverse L) := by
  have hw' : (resetUnused L).Widths := hw
  have f:=forward_support (resetUnused L) hw'
  have i:=inverse_support (resetUnused L) hw'
  rw [forward_ignores_unused] at f
  rw [inverse_ignores_unused] at i
  exact ⟨fun h=>reset_unused_away L hn q hq (List.mem_toFinset.mp (f h)),
    fun h=>reset_unused_away L hn q hq (List.mem_toFinset.mp (i h))⟩

theorem guard_free (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup) :
    L.sourceGuard∉wires (forward L) ∧ L.sourceGuard∉wires (inverse L) :=
  unused_free L hw hn _ (by simp)
end ECDSAAdd.Entrant.OneReuse

end

