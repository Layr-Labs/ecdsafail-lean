theorem history_clear_away (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (j : Nat) (hj : j < 102) (u : Fin 10) :
    historyMap w (5*j) u∉wires (skywalkArithmeticClear w) := by
  let idx := historyId (5*j) u
  have range : idx < 510 ∨ (1028 ≤ idx ∧ idx < 1538) := by
    have hu := u.isLt
    unfold idx historyId
    split <;> omega
  intro used
  rw [skywalkArithmeticClear,skywalkTerminalClear_wires] at used
  simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at used
  rcases used with eq|eq|eq
  all_goals
    have same := skywalkPool_index_inj w hn idx _ (by omega) (by omega) eq
    omega

theorem encoder_clear_disjoint (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    Disjoint (wires (History5.allEncode w 102)) (wires (skywalkArithmeticClear w)) := by
  apply Finset.disjoint_left.mpr
  intro q encoded clear
  obtain ⟨j,hj,member⟩ := History5.allEncode_member w 102 q encoded
  obtain ⟨u,rfl⟩ := History5.history_gate_mem w (5*j) _ (Or.inl rfl) q member
  exact history_clear_away w hn j hj u clear

theorem clear_raw_legal5 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (before after : State) (m : List Bool) (clear : run (skywalkArithmeticClear w) m before=after)
    (legal : History5.RawLegal w 102 before.basis) : History5.RawLegal w 102 after.basis := by
  have keep (j : Nat) (hj : j < 102) (u : Fin 10) :
      after.basis (historyMap w (5*j) u)=before.basis (historyMap w (5*j) u) := by
    rw [←clear]
    exact run_preserves_outside _ m before _ (history_clear_away w hn j hj u)
  intro j hj
  apply (Codec5.legalAt_iff _ _).mpr
  intro u
  rw [keep j hj ⟨2*u.val,by omega⟩,keep j hj ⟨2*u.val+1,by omega⟩]
  exact (Codec5.legalAt_iff _ _).mp (legal j hj) u

/-- Raw preparation facts are reused after the direct five-trit integer prefix. -/
theorem preparation_facts5 (hn : (skywalkSharedWires base).Nodup)
    (hlo : HistoryAbove base)
    (ho : ∀q∈[base 2400,base 2409,base 2410],q∉skywalkSharedWires base)
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s : State)
    (m1 m2 m3 : List Bool) (hin : SkywalkArithmeticInput base x Y.val s.basis)
    (s1 s2 s3 : State)
    (hs1 : run (NativeFirstDirect.forward base) m1 s=s1)
    (hs2 : run (compactForward5 base 1 511) m2 s1=s2)
    (hs3 : run (skywalkArithmeticClear base) m3 s2=s3)
    (first : CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis) :
    ∃origin:State,PreparationFacts x Y s origin ∧ History5.RawLegal base 102 origin.basis ∧
      origin.phase=s3.phase ∧ s3=run (History5.allEncode base 102) [] origin ∧
      EncodedCanonicalFrame5 origin.basis Y 0 s3 := by
  have hp0 : 0 < p := by norm_num [p]
  have hpo : p%2=1 := by norm_num [p]
  have hp : p < 2^256 := by norm_num [p]
  have cop := arith_coprime x hx0 hx
  have pool := skywalkShared_integer_nodup base hn
  have ready := caller_ready base hn x Y.val s.basis hin
  let oldSeed := run (literalSkywalkSeed (literalSkywalkPoolSeed base) p) [] s
  have seedEq : run (literalSkywalkSeed (literalSkywalkPoolSeed base) p) [] s=oldSeed := rfl
  have reference := forward_reference_eq base pool x hx s m1 [] ready.1 ready.2
  have referenceEq : run (NativeFirstDirect.reference base) [] s=
      run (compactSkywalkTick base 0) [] oldSeed := by
    rw [NativeFirstDirect.reference,run_append]
    simp only [List.take_nil,List.drop_nil]
    rfl
  have firstEq : s1=run (compactSkywalkTick base 0) [] oldSeed :=
    hs1.symm.trans (reference.trans referenceEq)
  let rawFinal := run (compactSkywalkForward base 0 512) [] oldSeed
  have rawJoin : rawFinal=run (compactSkywalkForward base 1 511) [] s1 := by
    dsimp only [rawFinal]
    rw [compactSkywalkForward,run_append]
    simp only [List.take_nil,List.drop_nil]
    rw [←firstEq]
  have rawStep := compactSkywalkForward_spec base pool x p 1 511 hp0 hx0 hpo hp hx cop
    (by omega) s1 [] first
  have measuredStep := compactSkywalkForward_spec base pool x p 1 511 hp0 hx0 hpo hp hx cop
    (by omega) s1 m2 first
  have rawRecords : run (compactSkywalkForward base 1 511) m2 s1=rawFinal := by
    rw [rawJoin]
    apply State.extensionality
    · exact measuredStep.1.trans rawStep.1.symm
    · exact run_basis_records _ s1 s1 m2 [] rfl
  have s2Encoded : s2=run (History5.allEncode base 102) [] rawFinal := by
    rw [←hs2,compactForward5_first_normalize base pool hlo s1 m2,rawRecords]
  let origin := run (skywalkArithmeticClear base) m3 rawFinal
  have facts := rawPreparation_facts hn ho x Y hx0 hx s [] [] m3 hin oldSeed rawFinal origin seedEq rfl rfl
  have encoded : s3=run (History5.allEncode base 102) [] origin := by
    rw [←hs3,s2Encoded]
    exact (run_disjoint_commute _ _ (encoder_clear_disjoint base pool) [] m3 rawFinal).symm
  have phase : origin.phase=s3.phase := by
    rw [encoded]
    exact (History5.allEncode_phase base pool 102 (by decide) origin []).symm
  have legalBefore : History5.RawLegal base 102 rawFinal.basis := by
    rw [rawJoin]
    exact rawLegal_of_compactStage base pool x p 512 102 hp0 hpo (by omega) (by omega)
      _ rawStep.2
  have legal := clear_raw_legal5 base pool rawFinal origin m3 rfl legalBefore
  refine ⟨origin,facts,legal,phase,encoded,origin,phase,?_,encoded⟩
  exact ⟨facts.targetValue,by simpa only [ZMod.val_zero] using facts.sourceZero,fun _ _ _ => rfl⟩

theorem kernel5_states_from_first (divide : Bool)
    (hn : (skywalkSharedWires base).Nodup) (hlo : HistoryAbove base)
    (ho : ∀ q ∈ [base 2400,base 2409,base 2410],q ∉ skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s : State)
    (m1 m2 m3 m4 m5 m6 m7 : List Bool)
    (hin : SkywalkArithmeticInput base x Y.val s.basis)
    (hg0 : s.basis (base 2409) = false) (hs0 : s.basis (base 2410) = false)
    (s1 s2 s3 s4 s5 s6 s7 : State)
    (hs1 : run (forward base) m1 s = s1)
    (hs2 : run (compactForward5 base 1 511) m2 s1 = s2)
    (hs3 : run (skywalkArithmeticClear base) m3 s2 = s3)
    (hs4 : run (HalfField5.segment5 divide) m4 s3 = s4)
    (hs5 : run (skywalkArithmeticClear base) m5 s4 = s5)
    (hs6 : run (compactReverse5 base 1 511) m6 s5 = s6)
    (hs7 : run (NativeFirstKnown.inverse base) m7 s6 = s7)
    (first : CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis) :
    DirectSkywalkArithmeticStrong divide base (base 2400) x Y s s7 := by
  letI : NeZero p := ⟨p_prime.ne_zero⟩
  let L := skywalkSharedSeed base
  let F := skywalkSharedField base
  let Z := (directSkywalkResult divide (s.basis (base 2400)) x Y).val
  have hp0 : 0<p := by norm_num [p]
  have hpo : p%2=1 := by norm_num [p]
  have hp : p<2^256 := by norm_num [p]
  have cop := arith_coprime x hx0 hx
  have pool := skywalkShared_integer_nodup base hn
  have ready := caller_ready base hn x Y.val s.basis hin
  have terminal := compactForward5_spec base pool hlo x p 1 511 hp0 hx0 hpo hp hx cop
    (by omega) s1 m2 (compactStage5_first base x p s1 first)
  rw [hs2] at terminal
  obtain ⟨origin,facts,legal,_,encoded,entry⟩ := preparation_facts5 hn hlo ho x Y hx0 hx s
    m1 m2 m3 hin s1 s2 s3 hs1 hs2 hs3 first
  have selectorPool : ∀ q ∈ [base 2400,base 2409,base 2410],q ∉ skywalkPoolWires base := by
    intro q hq bad
    exact ho q hq (arith_block_subset_shared base 0 1798 (by omega) bad)
  have hg : origin.basis (base 2409)=false := (facts.controls _ (by simp)).trans hg0
  have hs : origin.basis (base 2410)=false := (facts.controls _ (by simp)).trans hs0
  have h4 := HalfField5.segment5_spec divide hn ho selectorPool hf origin.basis hg hs
    facts.env legal facts.workZero facts.unusedZero facts.targetHigh facts.sourceHigh
    x hx0 hx facts.trace Y s3 m4 entry
  rw [hs4] at h4
  have actual4 := HalfField5.encodedCanonical_caller_frame5 hn origin.basis facts.sourceZero _ s4 h4.2
  have result : fieldResult divide origin.basis x Y = directSkywalkResult divide (s.basis (base 2400)) x Y := by
    simp only [fieldResult,directSkywalkResult,skywalkArithmeticResult,
      facts.controls (base 2400) (by simp)]
  have value4 : regValue F.z s4.basis=Z := by
    rw [result] at actual4
    exact actual4.1
  have keeps := HalfField5.segment5_pool_frame divide hn ho selectorPool hf origin.basis hg hs
    facts.env legal facts.workZero facts.unusedZero facts.targetHigh facts.sourceHigh
    facts.sourceZero x hx0 hx facts.trace Y s3 m4 entry
  rw [hs4] at keeps
  have recovered := clear_after_pool_update hn s2 s4 m3 m5
    (by rw [hs3]; exact keeps.1) (by intro q hq; rw [hs3]; exact keeps.2 q hq)
  rw [hs5] at recovered
  have restored := tail_restore_pool5 base pool hlo x p hp0 hx0 hpo hp hx cop
    s1 s2 m6 first terminal.2
  have agrees := pool_run_agrees (compactReverse5 base 1 511) (skywalkPoolWires base).toFinset
    ((compactReverse5_support base pool 1 511 (by omega)).trans (integerSites5_pool base)) m6 s5 s2 recovered.1
    (fun q hq => recovered.2 q (List.mem_toFinset.mp hq))
  rw [hs6] at agrees
  have phase6 : s6.phase=s1.phase :=
    agrees.1.trans (restored.1.trans terminal.1)
  have pool6 : ∀q∈skywalkPoolWires base,s6.basis q=s1.basis q := by
    intro q hq
    exact (agrees.2 q (List.mem_toFinset.mpr hq)).trans (restored.2.1 q hq)
  have h7 := NativeFirstKnown.inverse_restore_after_outside base pool x s s6 m1 m7 ready.1
    (by rw [hs1]; exact phase6)
    (by intro q hq; rw [hs1]; exact pool6 q hq)
  rw [hs7] at h7
  have reverseAway (q : Wire) (hq : q∉skywalkPoolWires base) : s6.basis q=s5.basis q := by
    have a := compactReverse5_frame base pool 1 511 (by omega) s5 m6 q hq
    rw [hs6] at a
    exact a
  have frame7Z (q : Wire) (hz : q∉F.z) : s7.basis q=s.basis q := by
    by_cases hpool : q∈skywalkPoolWires base
    · exact h7.2.1 q hpool
    · have k5 := arith_clear_outside base hn s4 m5 q hpool
      have k3 := arith_clear_outside base hn s2 m3 q hpool
      have k2 := compactForward5_frame base pool 1 511 (by omega) s1 m2 q hpool
      have kEncode : s3.basis q=origin.basis q := by
        rw [encoded]
        exact run_preserves_outside _ [] origin q
          (fun used => hpool (List.mem_toFinset.mp (HalfField5.encoder_pool_support used)))
      have k1 : s1.basis q=s.basis q := by
        have a := run_preserves_outside (forward base) m1 s q (fun used => hpool
          (prefix_pool_subset base (List.mem_toFinset.mp ((NativeFirstDirect.prefix_support base).1 used))))
        rw [hs1] at a
        exact a
      rw [hs5] at k5
      rw [hs3] at k3
      rw [hs2] at k2
      exact (h7.2.2 q hpool).trans ((reverseAway q hpool).trans (k5.trans
        ((actual4.2 q hz hpool).trans (kEncode.symm.trans (k3.trans (k2.trans k1))))))
  have hz7 : regValue F.z s7.basis=Z := by
    apply Eq.trans (regValue_congr _ _ _ ?_) value4
    intro q hq
    have away : q∉skywalkPoolWires base := fun h => arith_pool_away_z base hn q h hq
    have k5 := arith_clear_outside base hn s4 m5 q away
    rw [hs5] at k5
    exact (h7.2.2 q away).trans ((reverseAway q away).trans k5)
  have hZ : Z<2^256 := (ZMod.val_lt (directSkywalkResult divide (s.basis (base 2400)) x Y)).trans hp
  have high := skywalkShared_numerator_high_zero base s7.basis Z hz7 hZ
  have low7 : regValue (skywalkArithmeticNumerator base) s7.basis=Z := by
    change regValue (wireBlock base 2056 256++[base 2312]) s7.basis=Z at hz7
    rw [regValue_append] at hz7
    simpa [regValue,high,skywalkArithmeticNumerator] using hz7
  refine ⟨h7.1,low7,?_⟩
  intro q hq
  by_cases hz : q∈F.z
  · change q∈wireBlock base 2056 256++[base 2312] at hz
    rcases List.mem_append.mp hz with hlow|hpad
    · exact False.elim (hq hlow)
    · have eq : q=base 2312 := by simpa using hpad
      subst q
      exact high.trans (arith_input_bit base hn x Y.val s.basis hin 2312 (by omega) (by omega) (by omega)).symm
  · exact frame7Z q hz















































theorem actualKernel5_counts (divide : Bool) :
    toffoliCount (actualKernel5 divide)=(if divide then 1053104 else 1053614) ∧
    measurementCount (actualKernel5 divide)=721138 := by
  have config := MappedCompressed.LaneA.laneLogical_config
  have freshF := compactForward5_counts base base_pool_nodup 1 511 (by omega)
  have freshR := compactReverse5_counts base base_pool_nodup 1 511 (by omega)
  have priorF := compressedCompactForward_counts base base_pool_nodup 1 511 (by omega)
  have priorR := compressedCompactReverse_counts base base_pool_nodup 1 511 (by omega)
  have oldPack : compressedPackCount 1 511=170 := by decide
  simp only [packCount_511,oldPack] at freshF freshR priorF priorR
  have freshField := HalfField5.segment5_counts divide config.1 config.2.2 config.2.1
  have priorField := LaneI.segmentI_counts divide
  have prior := MappedCompressed.LaneA.laneKernel_counts divide
  simp only [MappedCompressed.LaneA.laneKernel,toffoliCount_append,measurementCount_append] at prior
  simp only [actualKernel5,toffoliCount_append,measurementCount_append]
  cases divide <;> simp only [Bool.false_eq_true,if_false,if_true] at freshField priorField prior ⊢ <;>
    constructor <;> omega





















end ECDSAAdd.Entrant.Kernel5

