/-! ## LT48 (replay budget): closed forms of the placement maps.
`Baselines.layout.core.poolWire i` is `List.getD` on `List.range' 4115 5699`, which the kernel walks on every
call; every map below is rewritten once (by proof) into Nat arithmetic, and the arena list test into the
interval test `StairPhysicalLayout.arenaB`, so the per-wire kernel checks are arithmetic. -/
namespace LT48K












theorem UG_eq (q : Wire) : StairSiteAvoidance.UG q = UGF q := by
  simp only [StairSiteAvoidance.UG, FlagTop.rho, swapD, swapE, tauM, swapF, spareD, spareWire, finSpare,
    Wrapper5.U, swap_eq, pw_eq, UGF]
  rfl




end LT48K



def bridgeB (y : Wire) : Bool :=
  decide (y ∈ bad12.map layout.core.poolWire) ||
    (decide (StairSiteAvoidance.UG y ∈ StairPhysicalLayout.arenaNat) &&
      decide (StairSiteAvoidance.UG y ∉ StairPhysicalLayout.oldHolesNat))


theorem LT48K.bridgeB_eq (y : Wire) : bridgeB y = LT48K.bridgeF y := by
  simp only [bridgeB, LT48K.bridgeF, LT48K.pw_fun, LT48K.UG_eq, LT48K.arena_dec]

/-! ## K4-D (replay budget): closed-form bit masks and interval checks

The per-wire site tests are replaced by bits of closed-form masks (`K4D.YM`, `K4D.ZM`), tied to the original
predicates by symbolic soundness lemmas; the kernel then checks each wire range with one comparison
`(m >>> a) % 2 ^ n = 2 ^ n - 1` instead of evaluating the placement maps wire by wire. -/
namespace K4D



















/-! ### `bridge_all` -/







end K4D

theorem bridge_all : (OB5Support.sites layout).all bridgeB = true := by
  rw [show bridgeB = LT48K.bridgeF from funext LT48K.bridgeB_eq, K4D.sites_eq]
  have hR : (K4D.YM >>> 2) % 2 ^ 256 = 2 ^ 256 - 1 ∧ (K4D.YM >>> 258) % 2 ^ 256 = 2 ^ 256 - 1 ∧
      (K4D.YM >>> 4115) % 2 ^ 515 = 2 ^ 515 - 1 ∧ (K4D.YM >>> 4832) % 2 ^ 312 = 2 ^ 312 - 1 ∧
      (K4D.YM >>> 5399) % 2 ^ 257 = 2 ^ 257 - 1 := by
    decide +kernel
  have r := K4D.all_range LT48K.bridgeF K4D.YM K4D.YM_sound
  have r1 := r 2 256 hR.1
  have r2 := r 258 256 hR.2.1
  have r3 := r 4115 515 hR.2.2.1
  have r4 := r 4832 312 hR.2.2.2.1
  have r5 := r 5399 257 hR.2.2.2.2
  have s1 : LT48K.bridgeF 4113 = true := K4D.bridgeSpecial_ok 4113 (by decide)
  have s2 : LT48K.bridgeF 5915 = true := by decide +kernel
  simp only [List.all_cons, List.all_append, List.all_nil, s1, s2, r1, r2, r3, r4, r5, Bool.and_self]

/-- Body-domain wires other than normFlag are good physical sites after bodySwap, foldPerm, place, UG. -/
def bodyGoodB (x : Wire) : Bool :=
  decide (x = K0.core.normFlag) ||
    (decide (StairSiteAvoidance.UG (placeFn (LowZero18Square.foldPerm K0 E0 (R2SqEp760.sqSwap K0 E0 x))) ∈
        StairPhysicalLayout.arenaNat) &&
      decide (StairSiteAvoidance.UG (placeFn (LowZero18Square.foldPerm K0 E0 (R2SqEp760.sqSwap K0 E0 x))) ∉
        StairPhysicalLayout.oldHolesNat))


theorem LT48K.bodyGoodB_eq (x : Wire) : bodyGoodB x = LT48K.bodyGoodF x := by
  have hn : K0.core.normFlag = LT48K.pwF 646 := LT48K.pw_eq 646
  simp only [bodyGoodB, LT48K.bodyGoodF, hn, LT48K.sqSwap_eq, LT48K.foldPerm_eq, LT48K.placeFn_eq,
    LT48K.UG_eq, LT48K.arena_dec]

/-! ### K4-D: `bodyGood_all` -/
namespace K4D
















end K4D

theorem bodyGood_all : (G0 :: K0.wires).all bodyGoodB = true := by
  rw [show bodyGoodB = LT48K.bodyGoodF from funext LT48K.bodyGoodB_eq, K4D.K0W_eq]
  have hR : (K4D.ZM >>> 258) % 2 ^ 256 = 2 ^ 256 - 1 ∧ (K4D.ZM >>> 2) % 2 ^ 256 = 2 ^ 256 - 1 ∧
      (K4D.ZM >>> 4115) % 2 ^ 258 = 2 ^ 258 - 1 ∧ (K4D.ZM >>> 4373) % 2 ^ 128 = 2 ^ 128 - 1 ∧
      (K4D.ZM >>> 4501) % 2 ^ 256 = 2 ^ 256 - 1 ∧ (K4D.ZM >>> 4757) % 2 ^ 7 = 2 ^ 7 - 1 ∧
      (K4D.ZM >>> 4764) % 2 ^ 126 = 2 ^ 126 - 1 := by
    decide +kernel
  have r := K4D.all_range LT48K.bodyGoodF K4D.ZM K4D.ZM_sound
  have r1 := r 258 256 hR.1
  have r2 := r 2 256 hR.2.1
  have r3 := r 4115 258 hR.2.2.1
  have r4 := r 4373 128 hR.2.2.2.1
  have r5 := r 4501 256 hR.2.2.2.2.1
  have r6 := r 4757 7 hR.2.2.2.2.2.1
  have r7 := r 4764 126 hR.2.2.2.2.2.2
  have s0 : LT48K.bodyGoodF G0 = true := K4D.bodySpecial_ok G0 (by decide)
  simp only [List.all_cons, List.all_append, s0, r1, r2, r3, r4, r5, r6, r7, Bool.and_self]

/-- Kernel hosts (pool 654..679) are good physical sites after place and UG. -/
def hostGoodB (n : Nat) : Bool :=
  decide (StairSiteAvoidance.UG (placeFn (L0.core.poolWire n)) ∈ StairPhysicalLayout.arenaNat) &&
    decide (StairSiteAvoidance.UG (placeFn (L0.core.poolWire n)) ∉ StairPhysicalLayout.oldHolesNat)


theorem hosts_all : (List.range' 654 31).all hostGoodB = true := by
  rw [show hostGoodB = LT48K.hostGoodF from funext fun n => by
    simp only [hostGoodB, LT48K.hostGoodF, LT48K.pw_eq, LT48K.placeFn_eq, LT48K.UG_eq, LT48K.arena_dec]]
  decide +kernel

