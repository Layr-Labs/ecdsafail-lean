/-- Moved middle trip from a genuine integer stage on the moved map. -/
theorem middle_trip (B i n : Nat) (hB : B ∈ budgets) (hseg : StairPhysicalPrimitives.segmentOf i = B)
    (hi : 385 ≤ i) (bound : i + n ≤ 512) (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (hcop : x.Coprime p) (t : State)
    (stage : Rolling1588.Integer.Stage (StairPhysicalPrimitives.midSegmentMap B) true x p i t.basis)
    (hfix : B ≠ 12) (c a : List Bool) :
    run (P.middleReverse i n) a (run (P.middleForward i n) c t) = t := by
  obtain ⟨hp0, hodd, hp, hgap⟩ := p_facts
  have eR : P.middleReverse i n = StairPhysicalPrimitives.middleReverse i n := by
    show StairPhysicalPrimitivesFix505.middleReverseFix i n = _
    exact StairPhysicalPrimitivesFix505.middleReverseFix_eq i n (by rw [hseg]; exact hfix)
  rw [eR]
  show run (StairReplay.movedReverse (StairPhysicalPrimitives.midSegmentMap
      (StairPhysicalPrimitives.segmentOf i)) i n) a
    (run (StairReplay.movedForward (StairPhysicalPrimitives.midSegmentMap
      (StairPhysicalPrimitives.segmentOf i)) i n) c t) = t
  rw [hseg]
  exact StairField2V3ExitMiddle.movedMiddle_roundtrip _
    (StairPhysicalPrimitives.midSegmentMap_pool_nodup B hB)
    (StairPhysicalPrimitives.midSegmentMap_historyAbove B hB)
    x i n hp0 hx0 hodd hp hgap hx hcop hi bound t c a stage


