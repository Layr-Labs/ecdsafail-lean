        hsame.2 _ (WideReference.outside_between (hbd q hq).1 (hbd q hq).2)
      exact hdom_eq.trans (hcd q hq))
  let m1 := m.drop (measurementCount ParkEndpoint425.parkP425)
  let m2 := m1.drop (measurementCount (Shadow7.portalInvP 425))
  have hrel := ParkEndpoint425.parked_release (unsigned 425 x p) hsm425 raw s m m1 g sg hinp425 pre.cut hempty
  let st := ParkEndpoint425.stash s (pullState (OB5.sig 424) raw)
  have hst_ph : st.phase = s.phase := by
    have hp := pre.cut.phase
    have hpe : (eraseSites ParkEndpoint425.src s).phase = s.phase := by simp [eraseSites]
    exact hp.symm.trans hpe
  have htr : NativePack425.Transition425 (NativePack425.stepRev425 d) st (run (NativePack425.stepFwd425 d) m2 st) := by
    cases d
    · exact NativePack425.observe_tick false x good.nonzero good.small raw ref s
