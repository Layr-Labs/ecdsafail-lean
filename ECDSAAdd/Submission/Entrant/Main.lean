def zeros15E (j : Fin 4) : List Nat :=
  let s := start15E j
  List.range' 1556 (e015E (s + 15) + 3 - 1556) ++
  List.range' (e015E (s + 15) + 9) (2055 - s - (e015E (s + 15) + 9)) ++
  List.range' (bTopP (s + 15) + 1) (bTopP s - bTopP (s + 15))

private theorem src15E_zeros_class : ∀ j : Fin 4, ∀ q ∈ zeros15E j,
    let s := start15E j
    let p : Nat := LeaveRelocation.source (moves15E s) q
    p = e015E s + 4 ∨ p = 1556 ∨ (1559 ≤ p ∧ p ≤ 1597) ∨ (1613 ≤ p ∧ p < e015E s + 3) ∨
    (e015E s + 8 ≤ p ∧ p < 2055 - s) ∨
    (b015E s + lows15E s - 1 ≤ p ∧ p < b015E s + 14 + lows15E s) ∨
    (1598 ≤ p ∧ p < 1613) := by
