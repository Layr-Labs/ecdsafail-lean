/-! ## Moved ticks and walks cost the record ticks and walks -/


theorem v3_tickForward_counts (i : Nat) (hB : 512 - i ∈ StairPhysicalLayout.budgets)
    (h1 : i ≤ 509) :
    toffoliCount (checkpointPrimitives.tickForward i) =
        toffoliCount (ECDSAAdd.Entrant.TickRanges.tick base i) ∧
      measurementCount (checkpointPrimitives.tickForward i) =
        measurementCount (ECDSAAdd.Entrant.TickRanges.tick base i) := by
  have h0 : 385 ≤ i := by
    simp only [StairPhysicalLayout.budgets, List.mem_cons, List.not_mem_nil,
      or_false] at hB
    omega
  change toffoliCount (ECDSAAdd.Entrant.TickRanges.tick
      (StairPhysicalLayout.segmentMap (512 - i)) i) = _ ∧
    measurementCount (ECDSAAdd.Entrant.TickRanges.tick
      (StairPhysicalLayout.segmentMap (512 - i)) i) = _
  exact StairCountLedger.forwardTick_counts_eq _ base
    (StairPhysicalLayout.segmentMap_pool_nodup _ hB) base_pool_nodup i h0 h1

theorem v3_tickReverse_counts (i : Nat) (hB : 512 - i ∈ StairPhysicalLayout.budgets)
    (h1 : i ≤ 509) :
    toffoliCount (checkpointPrimitives.tickReverse i) =
        toffoliCount (W.ReverseCarry.compactReceiverTick base i) ∧
      measurementCount (checkpointPrimitives.tickReverse i) =
