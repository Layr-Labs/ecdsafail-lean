  obtain ⟨ref, hstage, hsame⟩ := WideReference.leaves_reference 425 x p (by decide) false raw pre.domain
  have hempty : ∀ q ∈ ParkEndpoint425.dst, s.basis q = false :=
    ParkEndpoint425.empty_from_cut425 raw s _ _ _ pre.cut (by
      have hcd := ParkEndpoint425.clear_dest false x p ref hstage
