    simp only [kg,LowZero18LowK.kg,h,ite_false,kgS,LowZero18LowK.kgS,LowZero18KG.make,LowZero18KG.clear,
      toffoliCount_append,measurementCount_append]
    exact ⟨by omega,by omega,by omega,by omega⟩

