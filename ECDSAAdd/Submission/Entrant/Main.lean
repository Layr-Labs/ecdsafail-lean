  have coarse : (c::(xs++ys++cs.drop 1)).toFinset⊆(L.y++c::(ys++cs.drop 1)).toFinset := by
    intro q hq
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append,or_assoc] at hq ⊢
    have sr := src q
    tauto
