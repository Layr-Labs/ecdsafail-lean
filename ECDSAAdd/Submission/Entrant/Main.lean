theorem firstPacket_metrics (divide : Bool) :
    toffoliCount (placedFirstPacket divide)+3=
      toffoliCount (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) ∧
    measurementCount (placedFirstPacket divide)=
      measurementCount (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) ∧
    gateSlots (placedFirstPacket divide)=
      gateSlots (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide))+8 := by
  have body:=firstBody_counts divide
  have bodySlots:=firstBody_slots divide
  have codec:=ParityCodec5New.first_countsAt (History5.historyMap base 0)
  have codecSlots:=ParityCodec5New.first_slotsAt (History5.historyMap base 0)
  have enc:=NewHistory5.encode_counts base 0
  have dec:=NewHistory5.decode_counts base 0
  have encSlots : gateSlots (NewHistory5.encode base 0)=144 := (ParityCodec5New.slotsAt _).1
  have decSlots : gateSlots (NewHistory5.decode base 0)=142 := (ParityCodec5New.slotsAt _).2
  simp only [placedFirstPacket,firstPacket,baseFirstPacket,firstDecode,firstEncode,
    FrontierSW1591.firstPacketS,FrontierSW1591.baseFirstPacketS,
    toffoliCount_append,measurementCount_append,gateSlots_append,renameProgram_counts,rename_gateSlots]
  exact ⟨by omega,by omega,by omega⟩

theorem entryField_metrics :
    toffoliCount entryField=toffoliCount FrontierEntry1591Field.entryField+281 ∧
    measurementCount entryField=measurementCount FrontierEntry1591Field.entryField ∧
    gateSlots entryField=gateSlots FrontierEntry1591Field.entryField+358 := by
  have first:=firstPacket_metrics true
  simp only [renameProgram_counts,rename_gateSlots] at first
  have pc:=Prefix1590Codec.perm_counts base
  have ic:=Prefix1590Codec.invPerm_counts base
  have ps:=Prefix1590Codec.perm_slots base
  have is:=Prefix1590Codec.invPerm_slots base
  simp only [old_entryField_shape,entryField,prefixProgram,unprefix,toffoliCount_append,measurementCount_append,
    gateSlots_append,renameProgram_counts,rename_gateSlots]
  exact ⟨by omega,by omega,by omega⟩

theorem exitField_metrics :
    toffoliCount exitField=toffoliCount FrontierEntry1591Field.exitField+281 ∧
    measurementCount exitField=measurementCount FrontierEntry1591Field.exitField ∧
    gateSlots exitField=gateSlots FrontierEntry1591Field.exitField+358 := by
  have first:=firstPacket_metrics false
  simp only [renameProgram_counts,rename_gateSlots] at first
  have pc:=Prefix1590Codec.perm_counts base
  have ic:=Prefix1590Codec.invPerm_counts base
  have ps:=Prefix1590Codec.perm_slots base
  have is:=Prefix1590Codec.invPerm_slots base
  simp only [old_exitField_shape,exitField,prefixProgram,unprefix,toffoliCount_append,measurementCount_append,
    gateSlots_append,renameProgram_counts,rename_gateSlots]
