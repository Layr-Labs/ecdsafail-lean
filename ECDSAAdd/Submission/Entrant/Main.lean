/-! ### Section 1: Canonical 22-Bank Keys & Bank Cell Ranges -/

private theorem trace_drop_k (k n : Nat) (z : SkywalkRails.State) :
    (SkywalkTrace.trace (k + n) z).drop k = SkywalkTrace.trace n (SkywalkTrace.next^[k] z) := by
  induction k generalizing z with
  | zero => simp
  | succ k ih =>
    rw [show k + 1 + n = (k + n) + 1 by omega, SkywalkTrace.trace, List.drop_succ_cons,
      Function.iterate_succ_apply]
    exact ih (SkywalkTrace.next z)

private theorem trace_drop10 (z : SkywalkRails.State) :
    (SkywalkTrace.trace 20 z).drop 10 = (SkywalkTrace.trace 15 (SkywalkTrace.next^[5] z)).drop 5 := by
  have h1 := trace_drop_k 10 10 z
  have h2 := trace_drop_k 5 10 (SkywalkTrace.next^[5] z)
  rw [show (10 : Nat) + 10 = 20 from rfl] at h1
  rw [show (5 : Nat) + 10 = 15 from rfl, ← Function.iterate_add_apply, show (5 : Nat) + 5 = 10 from rfl] at h2
  exact h1.trans h2.symm

theorem cells_rangeG425 (t : Nat) (ht : t ≤ 425) (q : Nat) (h : q ∈ cellsRestoreP t) :
    (t + 6 ≤ q ∧ q ≤ t + 15) ∨ (t + 1034 ≤ q ∧ q ≤ t + 1042 ∧ q ≤ 1300) ∨ (2071 ≤ q + t ∧ q + t ≤ 2079 ∧ q ≤ 1812) := by
  have bcell (c : Nat) (hc : c ≤ 8) :
      (OB5.sig t (t + 1034 + c) = t + 1034 + c ∧ t + 1034 + c ≤ 1300) ∨
      (OB5.sig t (t + 1034 + c) = 3113 - (t + 1034 + c) ∧ 1301 ≤ t + 1034 + c) := by
    by_cases h1 : 1301 ≤ t + 1034 + c
    · exact Or.inr ⟨NativeJ7.sig_moved _ _ (Or.inl ⟨h1, by omega⟩), h1⟩
    · exact Or.inl ⟨NativeJ7.sig_kept _ _ (by omega) (by omega), by omega⟩
  have b0 := bcell 0 (by omega); simp only [Nat.add_zero] at b0
  have b1 := bcell 1 (by omega); have b3 := bcell 3 (by omega)
  have b5 := bcell 5 (by omega); have b6 := bcell 6 (by omega); have b8 := bcell 8 (by omega)
  simp only [cellsRestoreP, List.mem_cons, List.not_mem_nil, or_false] at h
  rcases h with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
  first
  | omega
  | (rcases b0 with ⟨e, l⟩ | ⟨e, l⟩ <;> rw [e] <;> omega)
  | (rcases b1 with ⟨e, l⟩ | ⟨e, l⟩ <;> (rw [show t+1035 = t+1034+1 by omega]; rw [e]) <;> omega)
  | (rcases b3 with ⟨e, l⟩ | ⟨e, l⟩ <;> (rw [show t+1037 = t+1034+3 by omega]; rw [e]) <;> omega)
  | (rcases b5 with ⟨e, l⟩ | ⟨e, l⟩ <;> (rw [show t+1039 = t+1034+5 by omega]; rw [e]) <;> omega)
  | (rcases b6 with ⟨e, l⟩ | ⟨e, l⟩ <;> (rw [show t+1040 = t+1034+6 by omega]; rw [e]) <;> omega)
  | (rcases b8 with ⟨e, l⟩ | ⟨e, l⟩ <;> (rw [show t+1042 = t+1034+8 by omega]; rw [e]) <;> omega)

private theorem frame_key20 (j : Fin 10) (ps : Ports) (chron : ∀ i : Fin 20, ps ⟨i, by omega⟩ = nativeRawPort20 j i)
    (r : Nat) (z : SkywalkNat.State) (g sg cross : Bool) (before out : State)
    (prior : PastFacts20 j ps z g sg cross before)
    (kept : ∀ i : Fin 23, out.basis (ps ⟨i, by omega⟩) = before.basis (ps ⟨i, by omega⟩))
    (frame : Frame ps ArchivePortAction.raw r out) :
    let xs := SkywalkTrace.trace 20 (encode g sg z.u z.v)
    let f := decide (Shadow.far (sbP20 (start20 j)) 20 z)
    let u := f && StairArchiveTrace.afterFlags (decide (z.v < z.u)) (xs.take 10)
    Encodes (StairArchiveRaw.rawBit (StairArchiveRaw.read (xs.drop 10)) f u (f && cross)) r := by
  intro xs f u q
  have same : (StairArchiveRaw.rawCol q).testBit r = before.basis (ps ⟨q, by omega⟩) :=
    ((congrArg (fun n : Nat => n.testBit r) (io true true ⟨q, by omega⟩).1).trans (frame ⟨q, by omega⟩).symm).trans (kept q)
  by_cases h : q.val < 20
  · have eq := row_truth20 j ps chron r z g sg before out prior.records kept frame ⟨q, h⟩
    simpa only [StairArchiveRaw.rawBit, if_pos h] using eq
  · rcases q with ⟨q, bound⟩; change ¬ q < 20 at h
    have cases : q = 20 ∨ q = 21 ∨ q = 22 := by omega
    rcases cases with rfl | rfl | rfl
    · exact same.trans prior.far
    · have h' := same.trans prior.suffix; rw [prior.records] at h'; exact h'
    · exact same.trans prior.crossed

noncomputable def value20 (x p : Nat) (j : Fin 10) : Nat → Bool :=
  let s := start20 j
  let b := sbP20 s
  let z := unsigned s x p
  let xs := SkywalkTrace.trace 20 (WideReference.canonical s x p)
  let f := decide (Shadow.far b 20 z)
  let u := f && StairArchiveTrace.afterFlags (decide (z.v < z.u)) (xs.take 10)
  let c := f && HighBankSum.crossBit (TrueMiddle20.d j z)
  StairArchiveRaw.rawBit (StairArchiveRaw.read (xs.drop 10)) f u c

theorem value20_chronology (x p : Nat) (j : Fin 10) (r : Nat) (h : Encodes (value20 x p j) r) :
    ArchiveStockRows.Chronology (start20 j + 5) x p r := by
  intro q
  have hq := h ⟨q.val, by omega⟩
  dsimp only [value20] at hq
  rw [StairArchiveRaw.rawBit, if_pos q.isLt] at hq
  rw [hq, trace_drop10]
  have hcan : SkywalkTrace.next^[5] (WideReference.canonical (start20 j) x p) =
      WideReference.canonical (start20 j + 5) x p := by
    unfold WideReference.canonical
    rw [Nat.add_comm, Function.iterate_add_apply]
  rw [hcan]

noncomputable def value15E (x p : Nat) (j : Fin 4) : Nat → Bool :=
  value x p (start15E j) (sb15E (start15E j)) (fun z => HighBankSum.crossBit (TrueMiddle15E.d j z))

/-- Canonical archive key for each of the 22 mixed-window banks (`[45, 425)`). -/
noncomputable def mixedKey425 (x p : Nat) (b : MixedGeo425.Bank) : Nat → Bool :=
  if h1 : b.val < 7 then
    value x p (start ⟨b.val, by omega⟩) (Shadow7.sbP (start ⟨b.val, by omega⟩))
      (StockRowVectorW.crossW ⟨b.val, by omega⟩)
  else if h2 : b.val = 7 then
    value x p 150 (Shadow7.sbP 150) (StockRowVectorW.crossW MixedWindow.j7)
  else if h3 : b.val < 18 then
    value20 x p ⟨b.val - 8, by omega⟩
  else
    value15E x p ⟨b.val - 18, by have := b.isLt; omega⟩

noncomputable def mixedRow425 (x p : Nat) (b : MixedGeo425.Bank) : Nat :=
  select (mixedKey425 x p b)

def mixedFinal425 (exitPorts : Ports) (d : Bool) (x p : Nat) (s : State) : Prop :=
  ∀ b : MixedGeo425.Bank, SavedKey (mixedKey425 x p b) (MixedGeo425.bankPorts exitPorts b) d s

def BankKey425 (d : Bool) (x p : Nat) (b : MixedGeo425.Bank) (s : State) : Prop :=
  SavedKey (mixedKey425 x p b) (MixedGeo425.bankPorts ArchiveBoundary425.codePorts b) d s

def SavedBefore425 (d : Bool) (x p n : Nat) (s : State) : Prop :=
  ∀ b : MixedGeo425.Bank, b.val < n → BankKey425 d x p b s

private theorem bank_tick_match425 : ∀ b : MixedGeo425.Bank,
    (∀ h : b.val < 7, MixedGeo425.bankTick b = start ⟨b.val, by omega⟩) ∧
    (b.val = 7 → MixedGeo425.bankTick b = 150) ∧
    (∀ h1 : 8 ≤ b.val, ∀ h2 : b.val < 18, MixedGeo425.bankTick b = start20 ⟨b.val - 8, by omega⟩ + 5) ∧
    (∀ h1 : 18 ≤ b.val, MixedGeo425.bankTick b = start15E ⟨b.val - 18, by have := b.isLt; omega⟩) ∧
    60 ≤ MixedGeo425.endTick b ∧ MixedGeo425.endTick b ≤ 425 := by
  decide +kernel

theorem mixedKey425_chronology (x p : Nat) (b : MixedGeo425.Bank) (r : Nat)
    (h : Encodes (mixedKey425 x p b) r) :
    ArchiveStockRows.Chronology (MixedGeo425.bankTick b) x p r := by
  have tm := bank_tick_match425 b
  unfold mixedKey425 at h
  split_ifs at h with h1 h2 h3
  · rw [tm.1 h1]; exact StockRowVector.historical _ _ x p _ _ h
  · rw [tm.2.1 h2]; exact StockRowVector.historical _ _ x p _ _ h
  · rw [tm.2.2.1 (by omega) h3]; exact value20_chronology x p ⟨b.val - 8, by omega⟩ r h
  · rw [tm.2.2.2.1 (by omega)]; exact StockRowVector.historical _ _ x p _ _ h

theorem mixedFinal425_trace {exitPorts d x p s} (h : mixedFinal425 exitPorts d x p s) (b : MixedGeo425.Bank) :
    ArchiveStockRows.Chronology (MixedGeo425.bankTick b) x p (mixedRow425 x p b) :=
  mixedKey425_chronology x p b _ (h b).2.1

private theorem bank_cells_mem425 (b : MixedGeo425.Bank) (q : Wire)
    (hq : q ∈ ArchiveWindowPreserve.bank (MixedGeo425.bankPorts ArchiveBoundary425.codePorts b)) :
    q ∈ cellsRestoreP (MixedGeo425.endTick b) := by
  simp only [ArchiveWindowPreserve.bank, List.mem_map, List.mem_finRange, true_and] at hq
  obtain ⟨i, rfl⟩ := hq
  have eq := MixedGeo425.site_eq ArchiveBoundary425.codePorts MixedGeo425.exitCells425 b i
  change MixedGeo425.siteAt ArchiveBoundary425.codePorts b i ∈ cellsRestoreP (MixedGeo425.endTick b)
  rw [eq, MixedGeo425.bankSite, List.getD_eq_getElem?_getD,
    List.getElem?_eq_getElem (by simp [cellsRestoreP]), Option.getD_some]
  exact List.getElem_mem _

private theorem bank_range425 (b : MixedGeo425.Bank) (q : Wire)
    (hq : q ∈ ArchiveWindowPreserve.bank (MixedGeo425.bankPorts ArchiveBoundary425.codePorts b)) :
    let t := MixedGeo425.endTick b
    (t + 6 ≤ (q : Nat) ∧ (q : Nat) ≤ t + 15) ∨
    (t + 1034 ≤ (q : Nat) ∧ (q : Nat) ≤ t + 1042 ∧ (q : Nat) ≤ 1300) ∨
    (2071 ≤ (q : Nat) + t ∧ (q : Nat) + t ≤ 2079 ∧ (q : Nat) ≤ 1812) :=
  cells_rangeG425 (MixedGeo425.endTick b) (by have := (bank_tick_match425 b).2.2.2.2.2; omega) q
    (bank_cells_mem425 b q hq)

private theorem keep_savedKey425 {k : Nat → Bool} {ps : Ports} {d : Bool} {s t : State}
    (h : SavedKey k ps d s) (eq : ∀ q ∈ ArchiveWindowPreserve.bank ps, t.basis q = s.basis q) :
    SavedKey k ps d t :=
  ⟨h.1, h.2.1, ArchiveWindowPreserve.keep h.2.2 eq⟩

/-! ### Section 2: Hand-Off Predicates (`At20`, `Ready20`, `At15E`, `Ready15E`, `AtExit425`, `ReadyExit425`) -/

def prevTick20 (j : Fin 10) : Nat := if j.val = 0 then 150 else start20 (prev20 j)

def prevCross20 (j : Fin 10) (x p : Nat) : Bool :=
  if j.val = 0 then
    HighBankSum.crossBit (LeaveJ7.TrueMiddle.d MixedWindow.j7 (unsigned 150 x p))
  else
    HighBankSum.crossBit (TrueMiddle20.d (prev20 j) (unsigned (start20 (prev20 j)) x p))

structure At20 (j : Fin 10) (d : Bool) (x p : Nat) (raw s : State) (g sg pg ps : Bool) : Prop where
  domain : Domain (start20 j) x p raw
  input : InputAt (start20 j) (signedAt (start20 j) x p g sg) raw
  cut : PackedCut (EnterJ20.lowerPairs j) (EnterJ20.upperPairs j) (EnterJ20.gate j) (EnterJ20.flagN j)
    (EnterJ20.flagF j) (EnterJ20.flagU j) (PortalValues.negative sg (unsigned (start20 j) x p).u)
    (decide (Shadow.far (sbP20 (start20 j)) 20 (unsigned (start20 j) x p)))
    (decide (Shadow.far (sbP20 (start20 j)) 20 (unsigned (start20 j) x p) ∧
      2 ^ sbP20 (start20 j) ≤ (unsigned (start20 j) x p).u))
    (pullState (EnterJ20.pull j) raw) (eraseSites (EnterJ20.pending j) s)
  facts : PrevPast20 j (unsigned (prevTick20 j) x p) pg ps (prevCross20 j x p) s
  pastCanonical : signedAt (prevTick20 j) x p pg ps = WideReference.canonical (prevTick20 j) x p

def Ready20 (j : Fin 10) (d : Bool) (x p : Nat) (s : State) : Prop :=
  ∃ raw g sg pg ps, At20 j d x p raw s g sg pg ps

def prevTick15E (j : Fin 4) : Nat :=
  if j.val = 0 then 345 else start15E ⟨j.val - 1, by have := j.isLt; omega⟩

def prevCross15E (j : Fin 4) (x p : Nat) : Bool :=
  if j.val = 0 then
    HighBankSum.crossBit (TrueMiddle20.d MixedWindow425.k9 (unsigned 345 x p))
  else
    HighBankSum.crossBit (TrueMiddle15E.d ⟨j.val - 1, by have := j.isLt; omega⟩
      (unsigned (start15E ⟨j.val - 1, by have := j.isLt; omega⟩) x p))

structure At15E (j : Fin 4) (d : Bool) (x p : Nat) (raw s : State) (g sg pg ps : Bool) : Prop where
  domain : Domain (start15E j) x p raw
  input : InputAt (start15E j) (signedAt (start15E j) x p g sg) raw
  cut : PackedCut (EnterJ15E.lowerPairs j) (EnterJ15E.upperPairs j) (EnterJ15E.gate j) (EnterJ15E.flagN j)
    (EnterJ15E.flagF j) (EnterJ15E.flagU j) (PortalValues.negative sg (unsigned (start15E j) x p).u)
    (decide (Shadow.far (sb15E (start15E j)) 15 (unsigned (start15E j) x p)))
    (decide (Shadow.far (sb15E (start15E j)) 15 (unsigned (start15E j) x p) ∧
      2 ^ sb15E (start15E j) ≤ (unsigned (start15E j) x p).u))
    (pullState (EnterJ15E.pull j) raw) (eraseSites (EnterJ15E.pending j) s)
  facts : PrevPast15E j (unsigned (prevTick15E j) x p) pg ps (prevCross15E j x p) s
  pastCanonical : signedAt (prevTick15E j) x p pg ps = WideReference.canonical (prevTick15E j) x p

def Ready15E (j : Fin 4) (d : Bool) (x p : Nat) (s : State) : Prop :=
  ∃ raw g sg pg ps, At15E j d x p raw s g sg pg ps

structure AtExit425 (d : Bool) (x p : Nat) (raw s : State) (g sg pg ps : Bool) : Prop where
  domain : Domain 425 x p raw
  input : InputAt 425 (signedAt 425 x p g sg) raw
  cut : PackedCut Portal425Flag.loPairs Portal425Flag.hiPairs 440 1615 1613 1614
    (PortalValues.negative sg (unsigned 425 x p).u)
    (decide (2 * 2 ^ 51 ≤ (unsigned 425 x p).u + (unsigned 425 x p).v))
    (decide (2 * 2 ^ 51 ≤ (unsigned 425 x p).u + (unsigned 425 x p).v ∧ 2 ^ 36 ≤ (unsigned 425 x p).u))
    (pullState (OB5.sig 424) raw) (eraseSites ParkEndpoint425.src s)
  hrec : physicalCells15E MixedWindow425.e3 s = SkywalkTrace.trace 15 (signedAt 410 x p pg ps)
  f1616 : s.basis 1616 = decide (Shadow.far 43 15 (unsigned 410 x p))
  f1617 : s.basis 1617 = (decide (Shadow.far 43 15 (unsigned 410 x p)) &&
    StairArchiveTrace.afterFlags (decide ((unsigned 410 x p).v < (unsigned 410 x p).u))
      ((physicalCells15E MixedWindow425.e3 s).take 5))
  f1618 : s.basis 1618 = (decide (Shadow.far 43 15 (unsigned 410 x p)) &&
    HighBankSum.crossBit (TrueMiddle15E.d MixedWindow425.e3 (unsigned 410 x p)))
  pastCanonical : signedAt 410 x p pg ps = WideReference.canonical 410 x p

def ReadyExit425 (d : Bool) (x p : Nat) (s : State) : Prop :=
  ∃ raw g sg pg ps, AtExit425 d x p raw s g sg pg ps

/-! ### Section 3: Receipts (`selected_receipt20`, `selected_receipt15E`) -/

private theorem prev20_chron425 :
    (∀ i : Fin 20, Archive150.rawPorts ⟨i, by omega⟩ = nativeRawPort MixedWindow.j7 i) ∧
    (∀ j : Fin 10, 1 ≤ j.val → ∀ i : Fin 20, ArchiveJ20.rawPorts (prev20 j) ⟨i, by omega⟩ = nativeRawPort20 (prev20 j) i) ∧
    (∀ j : Fin 10, ∀ i : Fin 16, oldRange (start20 j + 1) (windowNet20 j (prevCodePorts20 j ⟨i.val, by omega⟩))) := by
  decide +kernel

attribute [local irreducible] SkywalkNat.step Shadow.far nextWindow20 window20 withArchive20 body20 in
theorem selected_receipt20 (j : Fin 10) (d : Bool) (x p : Nat) (good : Bounds x p)
    (raw s : State) (g sg pg ps : Bool) (m : List Bool)
    (pre : At20 j d x p raw s g sg pg ps) :
    SavedKey (mixedKey425 x p ⟨7 + j.val, by have := j.isLt; omega⟩)
      (prevCodePorts20 j) d (run (nextWindow20 j d) m s) := by
  have hj := j.isLt
  have nums := actualNumbers20 j x p good
  have hist := WideReference20.pulled_history20 j pre.domain
  have inp := readInput (start20 j) x p raw g sg pre.input
  let preS := run (enterP20 j) m s
  let tape := m.drop (measurementCount (enterP20 j))
  let T := Shadow.reduced (sbP20 (start20 j)) 20 (unsigned (start20 j) x p)
  let Z := encode g sg T.u T.v
  have to' : T.v % 2 = 1 := shadow_odd20 (sbP20 (start20 j)) (unsigned (start20 j) x p) nums.small.1 nums.odd
  have parity : (Z.a + Z.b) % 2 = 1 := encode_odd_sum g sg _ _ (by omega)
  have ready := EnterJ20.ready_pending_at j raw s (unsigned (start20 j) x p) g sg m nums.small.1 pre.cut inp hist
  have scr := scratch_raw_clean20 j d raw s m x p good pre.domain _ _ _ Z parity ready.2.1 pre.cut
  have hold := bank_kept20 j d s m tape (tape.drop (measurementCount (routed20 j 0 1))) Z parity ready.2.1
  have prevOdd : (unsigned (prevTick20 j) x p).v % 2 = 1 := by
    unfold prevTick20; split_ifs with h0
    · exact (LeaveJ7.Admission.actualNumbers MixedWindow.j7 (by decide) (by decide) x p good).odd
    · exact (actualNumbers20 (prev20 j) x p good).odd
  have prevSm : PrevSmall20 j (unsigned (prevTick20 j) x p) := by
    unfold PrevSmall20 prevTick20; split_ifs with h0
    · exact (LeaveJ7.Admission.actualNumbers MixedWindow.j7 (by decide) (by decide) x p good).farSmall
    · exact (actualNumbers20 (prev20 j) x p good).small.1
  obtain ⟨_, row, limit, _, frame⟩ := admits20 j d s m tape (tape.drop (measurementCount (routed20 j 0 1)))
    Z parity ready.2.1 scr (unsigned (prevTick20 j) x p) pg ps (prevCross20 j x p) prevOdd prevSm pre.facts
  have hEnc : Encodes (mixedKey425 x p ⟨7 + j.val, by omega⟩) row := by
    by_cases h0 : j.val = 0
    · have hj0 : j = ⟨0, by decide⟩ := Fin.ext h0; subst hj0
      have all := StockCanonicalRow.frame_key MixedWindow.j7 Archive150.rawPorts prev20_chron425.1 row
        (Shadow7.sbP 150) (unsigned 150 x p) pg ps _ s _ pre.facts hold frame
      have hcanon := pre.pastCanonical; simp only [prevTick20, ↓reduceIte, signedAt] at hcanon
      dsimp only [mixedKey425, prevCross20] at all ⊢; rw [hcanon] at all; exact all
    · have all := frame_key20 (prev20 j) (ArchiveJ20.rawPorts (prev20 j)) (prev20_chron425.2.1 j (by omega)) row
        (unsigned (start20 (prev20 j)) x p) pg ps _ s _
        (by simpa only [PrevPast20, prevTick20, prevCross20, if_neg h0] using pre.facts)
        (by simpa only [prevRawPorts20, if_neg h0] using hold)
        (by simpa only [prevRawPorts20, if_neg h0] using frame)
      have hcanon := pre.pastCanonical; simp only [prevTick20, if_neg h0, signedAt] at hcanon
      dsimp only at all; rw [hcanon] at all
      have hmk : mixedKey425 x p ⟨7 + j.val, by omega⟩ = value20 x p (prev20 j) := by
        unfold mixedKey425
        rw [dif_neg (by dsimp; omega), dif_neg (by dsimp; omega), dif_pos (by dsimp; omega)]
        congr 1; apply Fin.ext; simp [prev20]; omega
      rw [hmk]; exact all
  have spec := select_spec ⟨row, limit, hEnc⟩
  have rf := reframe limit hEnc (prevRawPorts20 j) _ frame
  have final := archive_result20 j d _ spec.1 _ _ rf
  have runEq : run (nextWindow20 j d) m s = run (body20 j (withArchive20 j d)) tape preS := by
    simp only [nextWindow20, window20, run_append, run_take, preS, tape]
  rw [runEq]
  exact ⟨spec.1, spec.2, body20_keeps j (withArchive20 j d) (prevCodePorts20 j) d _ preS tape
    (fun i => old_clear20 (by decide) (prev20_chron425.2.2 j i)) final⟩

attribute [local irreducible] SkywalkNat.step Shadow.far nextWindow15E window15E withArchive15E body15E in
theorem selected_receipt15E (j : Fin 4) (d : Bool) (x p : Nat) (good : Bounds x p)
    (raw s : State) (g sg pg ps : Bool) (m : List Bool)
    (pre : At15E j d x p raw s g sg pg ps) :
    SavedKey (mixedKey425 x p ⟨17 + j.val, by have := j.isLt; omega⟩)
      (prevCodePorts15E j) d (run (nextWindow15E j d) m s) := by
  have hj := j.isLt
  have nums := actualNumbers15E j x p good
  have hist := pulled_history15E j pre.domain
  have inp := readInput (start15E j) x p raw g sg pre.input
  let preS := run (enterP15E j) m s
  let tape := m.drop (measurementCount (enterP15E j))
  let T := Shadow.reduced (sb15E (start15E j)) 15 (unsigned (start15E j) x p)
  let Z := encode g sg T.u T.v
  have to' : T.v % 2 = 1 := shadow_odd_shadow7 (sb15E (start15E j)) (unsigned (start15E j) x p) nums.farSmall nums.odd
  have parity : (Z.a + Z.b) % 2 = 1 := encode_odd_sum g sg _ _ (by omega)
  have ready := EnterJ15E.ready_pending_at j raw s (unsigned (start15E j) x p) g sg m nums.farSmall pre.cut inp hist
  have scr := scratch_raw_clean15E j d raw s m x p good pre.domain _ _ _ Z parity ready.2.1 pre.cut
  have hold := bank_kept15E j d s m tape (tape.drop (measurementCount (routed15E j 0 1))) Z parity ready.2.1
  have prevOdd : (unsigned (prevTick15E j) x p).v % 2 = 1 := by
    unfold prevTick15E; split_ifs with h0
    · exact (actualNumbers20 MixedWindow425.k9 x p good).odd
    · exact (actualNumbers15E ⟨j.val - 1, by omega⟩ x p good).odd
  have prevSm : PrevSmall15E j (unsigned (prevTick15E j) x p) := by
    unfold PrevSmall15E prevTick15E; split_ifs with h0
    · exact (actualNumbers20 MixedWindow425.k9 x p good).small.1
    · exact (actualNumbers15E ⟨j.val - 1, by omega⟩ x p good).farSmall
  obtain ⟨ok, row, limit, frame⟩ := admits15E j d s m tape (tape.drop (measurementCount (routed15E j 0 1)))
    Z parity ready.2.1 scr (unsigned (prevTick15E j) x p) pg ps (prevCross15E j x p) prevOdd prevSm pre.facts
  have hEnc : Encodes (mixedKey425 x p ⟨17 + j.val, by omega⟩) row := by
    by_cases h0 : j.val = 0
    · have hj0 : j = ⟨0, by decide⟩ := Fin.ext h0; subst hj0
      have all := frame_key20 MixedWindow425.k9 (ArchiveJ20.rawPorts MixedWindow425.k9) prev_chron15E.1 row
