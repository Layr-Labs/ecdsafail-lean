theorem walkFalse (c : Cost) (tail f r n : Nat) (hn : 410 + tail = n)
    (hf : c.measure (Shadow20.MixedWindow425.forward425Cut false) ≤ f)
    (hr : c.measure (Shadow20.MixedWindow425.reverse425Cut false) ≤ r) :
    c.measure (WindowWalkCosts.forward false tail) ≤ c.measure (Stair44WalkRun.forward false n) + f ∧
    c.measure (WindowWalkCosts.backward false tail) ≤ c.measure (Stair44WalkRun.backward false n) + r := by
  subst n
  have a := StairRestSupport.forward_append false 29 16 (381 + tail)
  have b := StairRestSupport.forward_append false 381 45 tail
  have x := StairRestSupport.reverse_append false 29 16 (381 + tail)
  have y := StairRestSupport.reverse_append false 381 45 tail
  change Rolling1588TickGap.forward false 16 (29 + (381 + tail)) =
    Rolling1588TickGap.forward false 16 29 ++ Rolling1588TickGap.forward false 45 (381 + tail) at a
  change Rolling1588.reverse false 16 (29 + (381 + tail)) =
    Rolling1588.reverse false 45 (381 + tail) ++ Rolling1588.reverse false 16 29 at x
  rw [b] at a; rw [y] at x
  have num : 410 + tail = 29 + (381 + tail) := by omega
  simp only [Stair44WalkRun.forward, Stair44WalkRun.backward, WindowWalkCosts.forward, WindowWalkCosts.backward, num, a, x,
    c.append, c.rename]
  norm_num only []
  constructor <;> omega

theorem walkTrue (c : Cost) (f r : Nat)
    (hf : c.measure (Shadow20.MixedWindow425.forward425Cut true) ≤ f)
    (hr : c.measure (Shadow20.MixedWindow425.reverse425Cut true) ≤ r) :
    c.measure (WindowWalkCosts.forward true 0) ≤ c.measure (Stair44WalkRun.forward true 409) + f ∧
    c.measure (WindowWalkCosts.backward true 0) ≤ c.measure (Stair44WalkRun.backward true 409) + r := by
  have a := StairRestSupport.forward_append true 29 16 380
  have x := StairRestSupport.reverse_append true 29 16 380
  rw [show (16 : Nat) + 29 = 45 from rfl] at a x
  have num : (409 : Nat) = 29 + 380 := by omega
  have hnil : c.measure [] = 0 := by
    have h0 := c.append [] []; rw [List.nil_append] at h0; omega
  have h1 : c.measure (WindowWalkCosts.forward true 0) = c.measure (Rolling1588TickGap.forward true 1 15) +
      (c.measure (Rolling1588TickGap.forward true 16 29) + c.measure (Shadow20.MixedWindow425.forward425Cut true) + 0) := by
    rw [WindowWalkCosts.forward, c.append, c.rename, c.rename, c.append, c.append, WindowWalkCosts.fwd_zero, hnil]
  have h2 : c.measure (WindowWalkCosts.backward true 0) = (0 + c.measure (Shadow20.MixedWindow425.reverse425Cut true) +
      c.measure (Rolling1588.reverse true 16 29)) + c.measure (Rolling1588.reverse true 1 15) := by
    rw [WindowWalkCosts.backward, c.append, c.rename, c.rename, c.append, c.append, WindowWalkCosts.rev_zero, hnil]
  have h3 : c.measure (Stair44WalkRun.forward true 409) =
      c.measure (Rolling1588TickGap.forward true 1 15) +
      (c.measure (Rolling1588TickGap.forward true 16 29) + c.measure (Rolling1588TickGap.forward true 45 380)) := by
    rw [Stair44WalkRun.forward, num, a, c.append, c.rename, c.rename, c.append]
  have h4 : c.measure (Stair44WalkRun.backward true 409) =
      (c.measure (Rolling1588.reverse true 45 380) + c.measure (Rolling1588.reverse true 16 29)) +
      c.measure (Rolling1588.reverse true 1 15) := by
    rw [Stair44WalkRun.backward, num, x, c.append, c.rename, c.rename, c.append]
  constructor <;> omega

private theorem kernels (gainF gainR fieldExtra : Nat)
    (dF : slots.measure (WindowWalkCosts.forward true 0) ≤ slots.measure (Stair44WalkRun.forward true 409) + gainF)
    (dR : slots.measure (WindowWalkCosts.backward false 80) ≤ slots.measure (Stair44WalkRun.backward false 490) + gainR)
    (g : slots.measure (WindowFieldCosts.group84 true) = slots.measure (WindowFieldCosts.group true 1 84) + fieldExtra) :
    slots.measure WindowCallerCosts.divide ≤ slots.measure Stair44Outer.divide + gainF + gainR + fieldExtra + 7900 := by
  have h := WindowCallerCosts.field_delta_slots true _ g
  have hc := WindowCallerCosts.field_cut slots
