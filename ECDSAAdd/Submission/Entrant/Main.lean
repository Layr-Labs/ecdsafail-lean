theorem releasedActual15E (j : Fin 4) (x p : Nat) (good : Bounds x p) (raw v : State)
    (dom : Domain (start15E j) x p raw) (m : List Bool)
    (pre : ∀ q : Wire, (q = start15E j + 31 + railP (start15E j + 15)) ∨ (1301 ≤ q ∧ q ≤ 1058 + start15E j) → v.basis q = false)
    (clear : ∀ q ∈ zeros15E j, (run (leaveP15E j) m v).basis q = false) :
    ∀ q : Wire, releasedSite15E j q →
      (run (leaveP15E j) m v).basis q = (Shadow20.WideReference20.origin (start15E j) (prevLen15E j) 15 raw v).basis q := by
  have hg := geom15E_facts j; dsimp only at hg
  have tg := tail15E_geom j; dsimp only at tg
  have ha0 : a015E (start15E j) = start15E j + sb15E (start15E j) + 32 := rfl
  have hb0 : b015E (start15E j) = 787 + sb15E (start15E j) := rfl
  have hrelA : a015E (start15E j) + 22 < start15E j + 31 + railP (start15E j + 15) ∧
      start15E j + 31 + railP (start15E j + 15) < b015E (start15E j) - 1 ∧
      railP (start15E j + 15) < railP (start15E j) := by
    have : ∀ r : Fin 4, a015E (start15E r) + 22 < start15E r + 31 + railP (start15E r + 15) ∧
        start15E r + 31 + railP (start15E r + 15) < b015E (start15E r) - 1 ∧
        railP (start15E r + 15) < railP (start15E r) := by decide +kernel
    exact this j
  intro q site
  rw [releasedOrigin15E j x p good raw v dom q site]
  rcases site with hq | ⟨lo, hi⟩ | ⟨lo, hi⟩
  · rw [leave15E_keeps j q (by unfold leaveBox15E; unfold Wire at *; omega) m v]; exact pre q (Or.inl hq)
  · exact clear q (by simp only [zeros15E, List.mem_append, List.mem_range'_1, bTopP]; right; unfold Wire at *; omega)
  · rw [leave15E_keeps j q (by unfold leaveBox15E; unfold Wire at *; omega) m v]; exact pre q (Or.inr ⟨lo, hi⟩)

private theorem cells15E_eq_local (j : Fin 4) (b : BasisState) :
    readCells (shape15E j) 0 15 (mappedBasis15E j b) =
      (List.range 15).map (fun k => (b (start15E j + 16 + k), b (swaps15E j k))) := by
  have hgeom : ∀ k : Fin 15,
      windowNet15E j (IntegerPacket.ports (shape15E j) k.val).a0 = start15E j + 16 + k.val ∧
      windowNet15E j (IntegerPacket.ports (shape15E j) k.val).history = swaps15E j k.val := by
    revert j; decide +kernel
  have aux : ∀ i n, i + n ≤ 15 → readCells (shape15E j) i n (mappedBasis15E j b) =
      (List.range' i n).map (fun k => (b (start15E j + 16 + k), b (swaps15E j k))) := by
    intro i n; induction n generalizing i with
    | zero => intro _; rfl
    | succ n ih =>
      intro hn; simp only [readCells, List.range'_succ, List.map_cons]
      have h0 := hgeom ⟨i, by omega⟩
      congr 1
      · change (b (windowNet15E j (IntegerPacket.ports (shape15E j) i).a0),
            b (windowNet15E j (IntegerPacket.ports (shape15E j) i).history)) = _
        rw [h0.1, h0.2]
      · exact ih (i + 1) (by omega)
  simpa [List.range_eq_range'] using aux 0 15 (by decide)

