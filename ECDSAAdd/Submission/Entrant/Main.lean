    (past:SkywalkNat.State) (pg ps cross:Bool) (odd:past.v%2=1) (pm:Shadow7.SmallIfFar 46 15 past)
    (records:Shadow7.physicalCells sourceIdx s=SkywalkTrace.trace 15 (encode pg ps past.u past.v))
