section support
attribute [local irreducible] ECDSAAdd.wires

theorem rawI_support:wires B95Research.rawI⊆B95Research.domain.toFinset:=by
 have ysSub:B95Research.ys.toFinset⊆B95Research.domain.toFinset:=by
  intro w hw
  apply List.mem_toFinset.mpr
  have hy:w∈B95Research.ys:=List.mem_toFinset.mp hw
  simp only [B95Research.domain,List.mem_cons,List.mem_append]
  tauto
 simp only [B95Research.rawI,ReorderedConsumedSub.plain,wires_append,notRegister_wires]
 change (B95Research.ys.toFinset∪wires B95Research.rawF)∪B95Research.ys.toFinset⊆B95Research.domain.toFinset
 rw [B95Research.raw_wires]
 exact Finset.union_subset (Finset.union_subset ysSub (Finset.Subset.refl _)) ysSub

theorem loopNC_support:wires loopNC⊆B95Research.S:=by
 have hh:=KnownBHeadResearch.support.trans B95Research.endpoint_support.1
 have dom:B95Research.domain.toFinset⊆B95Research.S:=Finset.subset_union_left.trans B95Research.raw_domain_in
 have rf:wires B95Research.rawF⊆B95Research.S:=by
  rw [B95Research.raw_wires]
