/-! ### Section 1: Tape Independence & `barrel15E_roundtrip` -/

private theorem run_basis_any15E (p : Program) : ∀ (m n : List Bool) (s s' : State), s.basis = s'.basis →
    (run p m s).basis = (run p n s').basis := by
  induction p with
  | nil => intro _ _ _ _ h; exact h
  | cons i p ih =>
    intro m n s s' h
    cases i <;> simp only [run, measureAndCorrect] <;> apply ih <;> simp [correct_basis, h]

private theorem state_eq_of_pb15E {a b : State} (hp : a.phase = b.phase) (hb : a.basis = b.basis) : a = b := by
  cases a; cases b; simp only at hp hb; subst hp hb; rfl

private theorem phase_step_any15E (P Q : Program) (s : State)
    (hP : ∀ t, (run P t s).phase = s.phase)
    (hPQ : ∀ t, (run (P ++ Q) t s).phase = s.phase) :
    ∀ m n, (run Q n (run P m s)).phase = (run P m s).phase := by
  intro m n
  have h1 : run P (m.take (measurementCount P) ++ List.replicate (measurementCount P - m.length) false) s = run P m s :=
    state_eq_of_pb15E ((hP _).trans (hP m).symm) (run_basis_any15E P _ m s s rfl)
  let t0 := m.take (measurementCount P) ++ List.replicate (measurementCount P - m.length) false
  have hlen : t0.length = measurementCount P := by simp only [t0, List.length_append, List.length_take, List.length_replicate]; omega
  have hrun := hPQ (t0 ++ n)
  rw [run_append, ← hlen, List.take_left, List.drop_left, h1] at hrun
  exact hrun.trans (hP m).symm

attribute [local irreducible] run barrel15E in
theorem barrel15E_roundtrip (j : Fin 4) (slot : Fin 17) (v : Nat) (u : State) (m n : List Bool)
    (small : v < 2 ^ (liveW15E (start15E j) - (slot.val - 1)))
    (input : HighBankBarrel.holds (bankW15E (start15E j)) (liveW15E (start15E j))
      (v <<< CRTBarrel.entryShift false slot.val) u)
    (tag : ∀ k < 16, u.basis (tagsP.getD k 0) = decide (slot.val = k + 1))
    (scratch : ∀ k < 10, u.basis (poolW15E (start15E j) (17 + k)) = false) :
    run (barrel15E (start15E j) true) n (run (barrel15E (start15E j) false) m u) = u := by
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, hwp1, hwp2, hl1, hl2, hnw1, hnw2, hlw1, hlw2, hlw3, hpool⟩ := geom15E_facts j
  obtain ⟨tg1, tg2, tg3, tg4, tg5, tg6, tg7, tg8, tg9, tg10, tg11⟩ := tail15E_geom j
  have ha0 : a015E (start15E j) = start15E j + sb15E (start15E j) + 32 := rfl
  have hb0 : b015E (start15E j) = 787 + sb15E (start15E j) := rfl
  have he0 : e015E (start15E j) = 1574 + sb15E (start15E j) := rfl
  have htags : ∀ k < 16, 1560 ≤ (tagsP.getD k 0 : Nat) ∧ (tagsP.getD k 0 : Nat) ≤ 1576 := by
    intro k hk; have : ∀ r : Fin 16, 1560 ≤ (tagsP.getD r.val 0 : Nat) ∧ (tagsP.getD r.val 0 : Nat) ≤ 1576 := by decide
    exact this ⟨k, hk⟩
  have htags_def : ∀ k : Fin 16, tagsP.getD k.val 1560 = tagsP.getD k.val 0 := by decide
  have hf := barrel15E_result j false slot v u m small input
    (fun k => by rw [htags_def k]; exact tag k.val k.isLt) scratch
  have htag_out : ∀ k < 16, HighBankBarrel.outside (bankW15E (start15E j)) (liveW15E (start15E j)) (tagsP.getD k 0) := by
    intro k hk i hi e; have tr := htags k hk
    have hlo : 1560 ≤ (tagsP.getD k 0 : Nat) := tr.1; have hhi : (tagsP.getD k 0 : Nat) ≤ 1576 := tr.2
    rcases bank15E_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, _, blo, bhi⟩ | ⟨_, _, blo, bhi⟩
    · rw [eb] at e; (try unfold Wire at *); omega
    · (try unfold Wire at *); omega
    · (try unfold Wire at *); omega
  have hscr_out : ∀ k < 10, HighBankBarrel.outside (bankW15E (start15E j)) (liveW15E (start15E j)) (poolW15E (start15E j) (17 + k)) := by
    intro k hk i hi e; have hpc := pool15E_cases j (17 + k)
    rcases bank15E_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, _, blo, bhi⟩ | ⟨_, _, blo, bhi⟩ <;>
      rcases hpc with ⟨_, ep⟩ | ⟨_, _, ep⟩ | ⟨_, _, ep⟩ <;> ((try rw [eb] at e); rw [ep] at e; (try unfold Wire at *); omega)
