        have h1 := (sel15E_controls j k).2.2.1
        have h12 := (LeaveJ7.SelRen.cert10_control k); simp only [reads, controls, List.cons.injEq] at h12
        have h96 := hs 1596 (by decide)
        rw [show ren15E j 1596 = 1596 by unfold ren15E; simp] at h96
        rw [h12.2.2.1] at h96
        have hsr : LeaveJ7.SelRen.rE (ren15E j) (LeaveSelector.signExpr (LeaveJ7.ports 12) k) =
            LeaveSelector.signExpr (ports15E j) k := h96.symm.trans h1
        rw [hsr]; simp only [LeaveJ7.SelRen.rE, (hrc j).1]
      · rw [if_neg (fun h => c2 (i2.mp h)), if_neg c2]; exact hs q hq
  have hrest : LeaveJ7.SelRen.Rel LeaveJ7.SelRen.D (ren15E j)
      (restored (ports15E j) false k) (restored (LeaveJ7.ports 12) false k) := by
    intro q hq; have i1 := hcn q hq
    simp only [restored, Bool.not_false, Bool.true_and, decide_eq_true_eq]
    by_cases c1 : q = (LeaveJ7.ports 12).crossing ∨ q = (LeaveJ7.ports 12).near
    · rw [if_pos (i1.mpr c1), if_pos c1]; rfl
    · rw [if_neg (fun h => c1 (i1.mp h)), if_neg c1]; exact sel15E_start_rel j k q hq
  obtain ⟨hv, her, hgd⟩ := LeaveJ7.SelRen.exits_rel hσ (LeaveJ7.retire 12) LeaveJ7.SelRen.retire10_in _ _
    (LeaveJ7.SelRen.post_good k) hpost
  have haff : (affected (LeaveJ7.ports 12)).map (ren15E j) = affected (ports15E j) := by
    have : ∀ r : Fin 4, (affected (LeaveJ7.ports 12)).map (ren15E r) = affected (ports15E r) := by decide +kernel
    exact this j
  have h10 := LeaveJ7.SelRen.cert10_clean k
  simp only [targetCert] at h10 ⊢
  rw [show retire15E j = (LeaveJ7.retire 12).map (LeaveJ7.SelRen.rOp (ren15E j)) from rfl, hv, ← haff, List.all_map]
  refine Eq.trans ?_ h10
  refine congrArg (and _) ?_
