private theorem pair_delta2 {a b x y g h i j t1 t2 f1 f2 r : Nat}
    (l : a+g+h+t1=x+f1) (rr : b+i+j+t2=y+f2) (v : g+h+t1+i+j+t2=r+f1+f2) : a+b+r=x+y := by omega
attribute [local irreducible] Stair44Outer.divide Stair44Outer.multiply divide multiply
  finite Stair44Outer.finite WindowWalkCosts.forward WindowWalkCosts.backward
  WindowFieldCosts.group84 WindowFieldCosts.group Stair44WalkRun.forward Stair44WalkRun.backward
  toffoliCount measurementCount

theorem tc_div : tc.measure divide + 39393 + 39292 + 1021 = tc.measure Stair44Outer.divide + 1050 := by
  have k := kernels tc 39393 39292 956 1050 WindowWalkCosts.exactWalksTrue.1
    (WindowWalkCosts.exactWalksFalse 80).2.1 (field_delta_tc_div 1050 fieldTcDiv)
  have e : tc.measure Rolling1588.ep + tc.measure Rolling1588.dp = 13 := by
    show toffoliCount Rolling1588.ep + toffoliCount Rolling1588.dp = 13
    rw [PackCutCounts.tc_ep, PackCutCounts.tc_dp]
  omega

theorem tc_mul (k : Nat) : tc.measure (multiply k) + 39393 + 39314 + 1026 = tc.measure (Stair44Outer.multiply k) + 962 :=
  kernelsM tc k 39393 39314 1026 962 (WindowWalkCosts.exactWalksFalse 79).1
    WindowWalkCosts.exactWalksTrue.2.1 (field_delta_tc_mul 962 fieldTcMul)

theorem mc_div : mc.measure divide + 17750 + 17727 + 1746 = mc.measure Stair44Outer.divide + 652 := by
  have k := kernels mc 17750 17727 1721 652 WindowWalkCosts.exactWalksTrue.2.2.1
    (WindowWalkCosts.exactWalksFalse 80).2.2.2 (field_delta_mc_div 652 fieldMcDiv)
  have e : mc.measure Rolling1588.ep + mc.measure Rolling1588.dp = 5 := by
    show measurementCount Rolling1588.ep + measurementCount Rolling1588.dp = 5
    exact PackCutCounts.mc_epdp
  omega

theorem mc_mul (k : Nat) : mc.measure (multiply k) + 17728 + 17749 + 1750 = mc.measure (Stair44Outer.multiply k) + 542 :=
  kernelsM mc k 17728 17749 1750 542 (WindowWalkCosts.exactWalksFalse 79).2.2.1
    WindowWalkCosts.exactWalksTrue.2.2.2 (field_delta_mc_mul 542 fieldMcMul)

theorem deltas (C : Point) (cx cy : Fp) :
    toffoliCount (finite C cx cy) + 157427 = toffoliCount (Stair44Outer.finite C cx cy) ∧
    measurementCount (finite C cx cy) + 73256 = measurementCount (Stair44Outer.finite C cx cy) :=
  ⟨finite_delta tc C cx cy 157427
      (OddOuterBridge.entryYAllOdd_tc_eq layout layout_widths (-cy))
      (OddOuterBridge.exitYAllOdd_tc_eq layout layout_widths cy)
      (pair_delta2 tc_div (tc_mul _) rfl),
