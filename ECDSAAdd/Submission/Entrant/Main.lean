            · obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hr; rw [List.mem_range] at ht
              rcases bank15E_cases j (i := t) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
