    omega
  change toffoliCount (W.ReverseCarry.compactReceiverTick
      (StairPhysicalLayout.segmentMap (512 - i)) i) = _ ∧
    measurementCount (W.ReverseCarry.compactReceiverTick
      (StairPhysicalLayout.segmentMap (512 - i)) i) = _
  exact StairCountLedger.reverseTick_counts_eq _ base
    (StairPhysicalLayout.segmentMap_pool_nodup _ hB) base_pool_nodup i h0 h1

theorem v3_middleForward_counts (i n : Nat) (h0 : 385 ≤ i) (h1 : i + n ≤ 510) :
    toffoliCount (checkpointPrimitives.middleForward i n) =
        toffoliCount (Rolling1588TickGap.forward true i n) ∧
      measurementCount (checkpointPrimitives.middleForward i n) =
        measurementCount (Rolling1588TickGap.forward true i n) := by
  change toffoliCount (StairReplay.movedForward (StairPhysicalPrimitives.midSegmentMap
      (StairPhysicalPrimitives.segmentOf i)) i n) = _ ∧
    measurementCount (StairReplay.movedForward (StairPhysicalPrimitives.midSegmentMap
      (StairPhysicalPrimitives.segmentOf i)) i n) = _
  exact StairCountLedger.movedForward_counts _
    (StairPhysicalPrimitives.midSegmentMap_pool_nodup _ (v3_segmentOf_mem i)) n i h0 h1

theorem v3_middleReverse_counts (i n : Nat) (h0 : 385 ≤ i) (h1 : i + n ≤ 510) :
    toffoliCount (checkpointPrimitives.middleReverse i n) =
        toffoliCount (Rolling1588.reverse true i n) ∧
      measurementCount (checkpointPrimitives.middleReverse i n) =
        measurementCount (Rolling1588.reverse true i n) := by
  -- LT27 (v3.1): middleReverse = StairPhysicalPrimitivesFix505.middleReverseFix (revSegmentMap)
  change toffoliCount (StairReplay.movedReverse (StairPhysicalPrimitivesFix505.revSegmentMap
      (StairPhysicalPrimitives.segmentOf i)) i n) = _ ∧
    measurementCount (StairReplay.movedReverse (StairPhysicalPrimitivesFix505.revSegmentMap
      (StairPhysicalPrimitives.segmentOf i)) i n) = _
  exact StairCountLedger.movedReverse_counts _
    (StairPhysicalPrimitivesFix505.revSegmentMap_pool_nodup _ (v3_segmentOf_mem i)) n i h0 h1

/-! ## Generic segments (any rows of the table) -/

theorem v3_forwardSegment_counts (B B' s f n : Nat) (hf : f = s + n) (hn : 0 < n)
    (hB : 512 - s ∈ StairPhysicalLayout.budgets) (hfle : f ≤ 510) :
    toffoliCount (StairSchedule.forwardSegment checkpointPrimitives B B' s f) +
        toffoliCount (Rolling1588.Integer.packFirst base true s) =
      toffoliCount (checkpointPrimitives.unpack B) +
        toffoliCount (checkpointPrimitives.orient f) +
        toffoliCount (checkpointPrimitives.pack B') +
        toffoliCount (Rolling1588TickGap.forward true s n) +
        toffoliCount (Rolling1588.Integer.packFirst base true f) ∧
    measurementCount (StairSchedule.forwardSegment checkpointPrimitives B B' s f) +
        measurementCount (Rolling1588.Integer.packFirst base true s) =
      measurementCount (checkpointPrimitives.unpack B) +
        measurementCount (checkpointPrimitives.orient f) +
        measurementCount (checkpointPrimitives.pack B') +
        measurementCount (Rolling1588TickGap.forward true s n) +
        measurementCount (Rolling1588.Integer.packFirst base true f) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  subst hf
  have h0 : 385 ≤ s := by
    simp only [StairPhysicalLayout.budgets, List.mem_cons, List.not_mem_nil,
      or_false] at hB
    omega
  obtain ⟨t1, t2⟩ := v3_tickForward_counts s hB (by omega)
  obtain ⟨m1, m2⟩ := v3_middleForward_counts (s + 1) k (by omega) (by omega)
  have e : s + (k + 1) - s - 1 = k := by omega
  rw [StairSchedule.forwardSegment, e]
  simp only [Rolling1588TickGap.forward, toffoliCount_append, measurementCount_append,
    renameProgram_counts]
  constructor <;> omega

theorem v3_reverseSegment_counts (B B' s f n : Nat) (hf : f = s + n) (hn : 0 < n)
    (hB : 512 - s ∈ StairPhysicalLayout.budgets) (hfle : f ≤ 510) :
    toffoliCount (StairSchedule.reverseSegment checkpointPrimitives B B' s f) +
        toffoliCount (Rolling1588.unpackAtTick true s) =
      toffoliCount (checkpointPrimitives.unpack B') +
        toffoliCount (checkpointPrimitives.orient f) +
        toffoliCount (checkpointPrimitives.pack B) +
        toffoliCount (Rolling1588.reverse true s n) +
        toffoliCount (Rolling1588.unpackAtTick true f) ∧
    measurementCount (StairSchedule.reverseSegment checkpointPrimitives B B' s f) +
        measurementCount (Rolling1588.unpackAtTick true s) =
      measurementCount (checkpointPrimitives.unpack B') +
        measurementCount (checkpointPrimitives.orient f) +
        measurementCount (checkpointPrimitives.pack B) +
        measurementCount (Rolling1588.reverse true s n) +
        measurementCount (Rolling1588.unpackAtTick true f) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  subst hf
  have h0 : 385 ≤ s := by
    simp only [StairPhysicalLayout.budgets, List.mem_cons, List.not_mem_nil,
      or_false] at hB
    omega
  obtain ⟨t1, t2⟩ := v3_tickReverse_counts s hB (by omega)
  obtain ⟨m1, m2⟩ := v3_middleReverse_counts (s + 1) k (by omega) (by omega)
  have e : s + (k + 1) - s - 1 = k := by omega
  rw [StairSchedule.reverseSegment, e]
  simp only [Rolling1588.reverse, toffoliCount_append, measurementCount_append,
    renameProgram_counts]
  constructor <;> omega

/-! ## First row (phase context) -/

theorem v3_firstPack_counts :
    toffoliCount checkpointPrimitives.firstPack =
        toffoliCount (checkpointPrimitives.orient 425) +
          toffoliCount (Rolling1588.Integer.packFirst base true 425) +
          toffoliCount (checkpointPrimitives.pack 87) ∧
      measurementCount checkpointPrimitives.firstPack =
        measurementCount (checkpointPrimitives.orient 425) +
          measurementCount (Rolling1588.Integer.packFirst base true 425) +
          measurementCount (checkpointPrimitives.pack 87) := by
  obtain ⟨b1, b2⟩ := StairPhysicalLayout.phaseBMove_counts
  -- LT50 (replay budget): syntactic rewrites instead of `change` (the definitional cast under `+`
  -- made the kernel evaluate both Toffoli/measurement counts of the concrete programs: 11 s)
  rw [show StairConcreteAssembly.checkpointPrimitives = StairV3Primitives.primitives from rfl,
    StairV3Primitives.primitives_firstPack, StairV3Primitives.primitives_orient,
    StairV3Primitives.primitives_pack, StairV3Primitives.firstPack]
  simp only [toffoliCount_append, measurementCount_append, renameProgram_counts]
  constructor <;> omega

theorem v3_firstUnpack_counts :
    toffoliCount checkpointPrimitives.firstUnpack =
        toffoliCount (checkpointPrimitives.unpack 87) +
          toffoliCount (Rolling1588.unpackAtTick true 425) +
          toffoliCount (checkpointPrimitives.orient 425) ∧
      measurementCount checkpointPrimitives.firstUnpack =
        measurementCount (checkpointPrimitives.unpack 87) +
          measurementCount (Rolling1588.unpackAtTick true 425) +
          measurementCount (checkpointPrimitives.orient 425) := by
  obtain ⟨b1, b2⟩ := StairPhysicalPhase.phaseBReturn_counts
  -- LT50 (replay budget): syntactic rewrites instead of `change` (see `v3_firstPack_counts`)
  rw [show StairConcreteAssembly.checkpointPrimitives = StairV3Primitives.primitives from rfl,
    StairV3Primitives.primitives_firstUnpack, StairV3Primitives.primitives_orient,
    StairV3Primitives.primitives_unpack, StairV3Primitives.firstUnpack]
  simp only [toffoliCount_append, measurementCount_append, renameProgram_counts]
  constructor <;> omega

end ECDSAAdd.Entrant.StairCountsHosted
