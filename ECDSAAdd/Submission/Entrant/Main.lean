namespace TrueMiddle15E
abbrev r (j : Fin 4) (z : SkywalkNat.State) := Shadow.reduced (sb15E (start15E j)) 15 z
def key (j : Fin 4) (z : SkywalkNat.State) : Fin 16 :=
  ⟨if 2 ^ sb15E (start15E j) ≤ z.u then 0 else wait 15 z.u, by have := wait_le 15 z.u; split <;> omega⟩
def X (j : Fin 4) (z : SkywalkNat.State) : Nat := total (step^[15] (r j z)) / 2 ^ sb15E (start15E j)
def F (j : Fin 4) (z : SkywalkNat.State) : Nat := total (step^[15] z) / 2 ^ sb15E (start15E j)
def d (j : Fin 4) (z : SkywalkNat.State) : Nat := X j z / 2 ^ (key j z).val
def neg (j : Fin 4) (z : SkywalkNat.State) : Bool :=
