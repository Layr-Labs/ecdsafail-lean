structure PastFacts15E (j : Fin 4) (ps : Ports) (z : SkywalkNat.State) (g sign cross : Bool) (s : State) : Prop where
  records : physicalCells15E j s = SkywalkTrace.trace 15 (encode g sign z.u z.v)
