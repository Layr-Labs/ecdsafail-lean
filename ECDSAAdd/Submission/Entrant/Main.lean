    rcases fs_class _ hfs with ⟨-, h2⟩ | ⟨-, h2⟩ | ⟨-, h2⟩ | ⟨-, h2⟩ | ⟨h2, -⟩
    all_goals first
      | (rw [h2]; exact g1543)
      | exact absurd h2 (by decide +kernel)
  · intro r hC hf n1 n2
    by_cases hfs : r ∈ StairTerminalV3.forwardSites
    · rw [tv r hfs]
      rcases fs_class r hfs with ⟨h1, h2⟩ | ⟨h1, -⟩ | ⟨h1, -⟩ | ⟨h1, -⟩ | ⟨h2, -⟩
      · rw [h2, onPk r h1 h2]
        rcases pk_class r h1 with h | h
        · exact absurd h hf
        · exact holeZero r h
      · exact absurd (by rw [h1]; decide +kernel) hf
      · exact absurd h1 n1
      · exact absurd h1 n2
      · obtain ⟨id, hid, he⟩ := List.mem_map.mp h2
        have hb := List.mem_range'_1.mp hid
        rw [← he]
        exact gz id hb.1 (by omega)
    · rw [tfr r hfs]
      by_cases hw : r ∈ unpackSites 12 ++ walkSites 12
      · exact restZero r hw hfs
      · rw [fr r (fun h => hw (List.mem_append_left _ h)) (fun h => hw (List.mem_append_right _ h))]
        exact preC r hC hf
  · intro r hC hf
    have hfs : r ∉ StairTerminalV3.forwardSites := fun h => hC (fs_CT r h)
    have hw : r ∉ unpackSites 12 ++ walkSites 12 := by
      intro h
      rcases (rest12 r h).1 with h' | h'
      · exact hC h'
      · exact hf h'
    rw [tfr r hfs, fr r (fun h => hw (List.mem_append_left _ h))
      (fun h => hw (List.mem_append_right _ h))]

/-- **`forwardLast`, arbitrary shadow labels.** -/
theorem lastTail (x : Nat) (origin : BasisState) (hx : TraceOK x origin) (u : State)
    (pre1 : ∀ r ∈ futurePayload 12, u.basis r = cmpBits 12 x r)
    (preC : ∀ r ∈ CT, r ∉ futurePayload 12 → u.basis r = false) (m : List Bool) :
    (run (StairSchedule.forwardLast StairExitLT24.P) m u).phase = u.phase ∧
    (∀ r ∈ futurePayload 12,
      (run (StairSchedule.forwardLast StairExitLT24.P) m u).basis r = recVal origin r) ∧
    (run (StairSchedule.forwardLast StairExitLT24.P) m u).basis (base 2409) = true ∧
    (run (StairSchedule.forwardLast StairExitLT24.P) m u).basis (base 1797) = origin (base 1538) ∧
    (∀ r ∈ CT, r ∉ futurePayload 12 → r ≠ base 2409 → r ≠ base 1797 →
      (run (StairSchedule.forwardLast StairExitLT24.P) m u).basis r = false) ∧
    (∀ r, r ∉ CT → r ∉ futurePayload 12 →
      (run (StairSchedule.forwardLast StairExitLT24.P) m u).basis r = u.basis r) := by
  obtain ⟨-, lF, -, lC, lP⟩ := low12
  have zh : ∀ q, q < base 4000 → (zeroHigh u).basis q = u.basis q := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = u.basis q
    rw [if_neg (Nat.not_le.mpr hq)]
  have pre1' : ∀ r ∈ futurePayload 12, (zeroHigh u).basis r = cmpBits 12 x r :=
    fun r hr => (zh r (lP r hr)).trans (pre1 r hr)
  have preC' : ∀ r ∈ CT, r ∉ futurePayload 12 → (zeroHigh u).basis r = false :=
    fun r hr hf => (zh r (lC r hr)).trans (preC r hr hf)
  have hsh : ∀ q, base 4000 ≤ q → (zeroHigh u).basis q = false := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = false
    rw [if_pos hq]
  obtain ⟨c1, c2, c3, c4, c5, c6⟩ := lastTail_clean x origin hx (zeroHigh u) pre1' preC' hsh m
  obtain ⟨lph, lagree, lhigh⟩ := low_reduce (StairSchedule.forwardLast StairExitLT24.P) fwd_low m u
  have l2409 : base 2409 < base 4000 := lF _ (by decide +kernel)
  have l1797 : base 1797 < base 4000 := lF _ (by decide +kernel)
  refine ⟨lph c1, fun r hr => (lagree r (lP r hr)).trans (c2 r hr), (lagree _ l2409).trans c3,
    (lagree _ l1797).trans c4, fun r hC hf n1 n2 => (lagree r (lC r hC)).trans (c5 r hC hf n1 n2),
    ?_⟩
  intro r hC hf
  by_cases hr : base 4000 ≤ r
  · exact lhigh r hr
  · exact (lagree r (Nat.not_le.mp hr)).trans ((c6 r hC hf).trans (zh r (Nat.not_le.mp hr)))

end ECDSAAdd.Entrant.StairField2V3LastTail

