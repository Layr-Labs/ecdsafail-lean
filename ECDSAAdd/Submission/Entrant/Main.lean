attribute [local irreducible] run wires wireBlock

private theorem canonical_history_same (origin current : BasisState) (X Y : Nat)
    (frame : PairFrame (skywalkSharedField MappedCompressed.base).z (skywalkSharedField MappedCompressed.base).a origin X Y current) :
    ∀q : Fin 10,current (History5.historyMap MappedCompressed.base 0 q)=origin (History5.historyMap MappedCompressed.base 0 q) := by
  intro q
  have hq := q.isLt
  have region : History5.historyId 0 q<5 ∨
      (1028≤History5.historyId 0 q ∧ History5.historyId 0 q<1033) := by
    unfold History5.historyId
    split_ifs <;> omega
  have awayR : History5.historyMap MappedCompressed.base 0 q∉(skywalkSharedField MappedCompressed.base).z := by
    change MappedCompressed.base (History5.historyId 0 q)∉wireBlock MappedCompressed.base 2056 256++[MappedCompressed.base 2312]
    simp only [List.mem_append,List.mem_singleton,not_or]
    exact ⟨OwnPlusHost.not_block (History5.historyId 0 q) 2056 256 (by omega),
      HostOB5.host_ne (History5.historyId 0 q) 2312 (by omega)⟩
  have awayA : History5.historyMap MappedCompressed.base 0 q∉(skywalkSharedField MappedCompressed.base).a := by
    change MappedCompressed.base (History5.historyId 0 q)∉wireBlock MappedCompressed.base 770 257
    exact OwnPlusHost.not_block (History5.historyId 0 q) 770 257 (by omega)
  exact frame.2.2 _ awayR awayA

private theorem canonical_prefix_codes_of_boundary
    (All : Program) (shape : All=NewHistory5.allEncode MappedCompressed.base 102)
    (hn : (skywalkPoolWires MappedCompressed.base).Nodup)
    (origin : BasisState) (raw s : State) (X Y : Nat)
    (frame : PairFrame (skywalkSharedField MappedCompressed.base).z
      (skywalkSharedField MappedCompressed.base).a origin X Y raw.basis)
    (encoded : s=run All [] raw) (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape MappedCompressed.base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    s.basis (History5.historyMap MappedCompressed.base 0 5)=false ∧
      s.basis (History5.historyMap MappedCompressed.base 0 9)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap MappedCompressed.base 0) s.basis∈
        Prefix1590Codec.canonicalCodes := by
  have actualEncoded : s=run (NewHistory5.allEncode MappedCompressed.base 102) [] raw :=
    encoded.trans (congrArg (fun program : Program => run program [] raw) shape)
  exact encoded_prefix_codes MappedCompressed.base hn origin raw s
    (canonical_history_same origin raw.basis X Y frame) actualEncoded x hx0 hx trace

/-- The same domain holds at the canonical exit input. -/
theorem encoded_canonical_prefix_codes (hn : (skywalkPoolWires MappedCompressed.base).Nodup)
    (origin : BasisState) (X Y : Fp) (s : State)
    (input : NewHistory5.EncodedCanonicalFrame5 origin X Y s)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape MappedCompressed.base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    s.basis (History5.historyMap MappedCompressed.base 0 5)=false ∧
      s.basis (History5.historyMap MappedCompressed.base 0 9)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap MappedCompressed.base 0) s.basis∈Prefix1590Codec.canonicalCodes := by
  obtain ⟨raw,_,frame,encoded⟩ := input
  exact canonical_prefix_codes_of_boundary (NewHistory5.allEncode MappedCompressed.base 102) rfl
    hn origin raw s X.val Y.val frame encoded x hx0 hx trace

end

private theorem prefix_zero (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (s : State) (m n : List Bool)
    (codes : s.basis (History5.historyMap w 0 5)=false ∧
      s.basis (History5.historyMap w 0 9)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap w 0) s.basis∈Prefix1590Codec.canonicalCodes) :
    (run (Prefix1590Codec.perm w) m s).phase=s.phase ∧
      (run (Prefix1590Codec.perm w) m s).basis (History5.historyMap w 0 0)=false ∧
      (run (Prefix1590Codec.perm w) m s).basis (History5.historyMap w 0 5)=false ∧
      (run (Prefix1590Codec.perm w) m s).basis (History5.historyMap w 0 9)=false ∧
      run (Prefix1590Codec.invPerm w) n (run (Prefix1590Codec.perm w) m s)=s := by
  have holes := Prefix1590Codec.VAt_holes (History5.historyMap w 0)
    (History5.historyMap_injective w hn 0 (by decide)) s m codes.1 codes.2.1
  exact ⟨Prefix1590Codec.perm_phase w hn s m,
    Prefix1590Codec.perm_zero w hn s m codes.1 codes.2.1 codes.2.2,
    holes.1,holes.2,Prefix1590Codec.perm_roundtrip w hn s m n⟩

/-- V clears G0 and restores both holes on the actual encoded field frame. -/
theorem encoded_frame_prefix_zero (w : Nat → Wire) (sign : Wire)
    (hn : (skywalkSharedWires w).Nodup) (ho : sign∉skywalkPoolWires w)
    (origin : BasisState) (X Y : Fp) (s : State)
    (input : NewHistory5.EncodedFieldFrame5 w sign origin X Y s)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape w)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) (m n : List Bool) :
    (run (Prefix1590Codec.perm w) m s).phase=s.phase ∧
