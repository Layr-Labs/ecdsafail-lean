theorem row_truth15E (j : Fin 4) (ps : Ports) (chron : ∀ i : Fin 20, ps ⟨i, by omega⟩ = nativeRawPort15E j i)
    (r : Nat) (z : SkywalkNat.State) (g sign : Bool) (before out : State)
    (records : physicalCells15E j before = SkywalkTrace.trace 15 (encode g sign z.u z.v))
    (kept : ∀ i : Fin 23, out.basis (ps ⟨i, by omega⟩) = before.basis (ps ⟨i, by omega⟩))
    (frame : Frame ps ArchivePortAction.raw r out) : RowTruth15E z g sign r := by
  intro q
  have bit : (rawCol q).testBit r = out.basis (ps ⟨q, by omega⟩) :=
    (congrArg (fun n : Nat => n.testBit r) (io true true ⟨q, by omega⟩).1).trans (frame ⟨q, by omega⟩).symm
  rw [bit, kept ⟨q, by omega⟩, chron q, native_raw_read15E j before ⟨q, by omega⟩ q.isLt, records]

