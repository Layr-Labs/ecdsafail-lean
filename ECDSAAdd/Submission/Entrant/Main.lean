  have hne : q ≠ p := fun e => hp (e ▸ hq)
  simp only [ParityEven.put, writeBit, Function.update_of_ne hne]

/-! ## Section 5: Multiplication stock lockstep (`stockOddMulPrefix21`, `stockOddMulHead`) -/

