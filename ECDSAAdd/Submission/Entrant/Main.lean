    omega
  have finishAway (q : Wire) (hq : q∈L.r++L.y++L.carry++[L.lower]) : q≠L.parity ∧ q≠L.one := by
    have h := List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
