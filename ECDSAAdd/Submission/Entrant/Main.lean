namespace ECDSAAdd.Entrant.StairPacket.StockWalkEndpoints
open Arithmetic MappedCompressed Secp256k1 WideReference StockArchiveBanks StockPlacedWindow StockInverseReplay StockWalkPrefix
set_option maxRecDepth 14000
set_option maxHeartbeats 2500000
attribute [local irreducible] run measurementCount Rolling1588TickGap.forward Rolling1588.reverse Rolling1588.Integer.regularForward

theorem bounds (x:Nat) (nz:0 < x) (lt:x<p):Bounds x p:=by
  obtain ⟨h,odd,cap,cop⟩:=StackOB5.prime_facts x nz lt
  exact ⟨h,nz,odd,cap,by norm_num [p],lt,cop⟩

theorem openedFalse (n x:Nat) (nz:0 < x) (lt:x<p) (bound:426+n≤512) (s a:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 1 s.basis) (input:pullState Stair44WalkMap.first a=s):
    Paired false x (run (WindowWalkCosts.forward false n) m a) (run (Stair44WalkRun.forward false (410+n)) m a) (StockRowVector.rows x p):=
  StockPlacedWindow.forwardFalse n x (bounds x nz lt) bound s a m stage input (StockNativeCompare.normalized false x (bounds x nz lt))

theorem openedTrue (x:Nat) (nz:0 < x) (lt:x<p) (s a:State) (m stockTape:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 1 s.basis) (input:pullState Stair44WalkMap.first a=s):
    Paired true x (run (WindowWalkCosts.forward true 0) m a)
      (run (Stair44WalkRun.forward true 409 ++ WindowWalkCosts.firstPackHead) (WindowFieldJourney.joinTapes (first true) m stockTape) a)
      (StockRowVector.rows x p):=
  StockPlacedWindow.forwardTrue x (bounds x nz lt) s a m stockTape stage input (StockNativeCompare.normalized true x (bounds x nz lt))

theorem rest_pool (q:Wire) (h:q∈pool):Stair44WalkMap.rest q∈pool:=by
  simp only [Stair44WalkMap.rest,Stair44WalkMap.shared,Equiv.trans_apply,Equiv.swap_apply_def]
  split_ifs <;> first | exact h | exact List.mem_toFinset.mpr (OB5.base_pool _ (by decide))

theorem fixed_old (d:Bool) (mN x:Nat) (good:Bounds x p) (atCut:16+mN∈[425,505,506]) (s:State)
    (stage:Rolling1588.Integer.Stage base d x p 1 s.basis) (m:List Bool):
    let v:=run (Rolling1588TickGap.forward d 1 (15+mN)) m s
    pullState Stair44WalkMap.rest v=v:=by
  let a:=pullState Stair44WalkMap.first.symm s
  have input:pullState Stair44WalkMap.first a=s:=Stair44PlacedHead.unpull Stair44WalkMap.first.symm s
  have cut:1+(15+mN)∈[425,505,506]:=by simpa only [show 1+(15+mN)=16+mN by omega] using atCut
  have one:=Stair44WalkRun.forward_run d mN x good.nonzero good.small s a m stage input
  have two:=Stair44WalkCuts.forward_done d mN x cut good.nonzero good.small s a m stage input
  rw [two] at one; exact one

theorem decompose_false (x n:Nat) (good:Bounds x p) (s:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 1 s.basis) (bound:426+n≤512):
    let raw:=regular false s []
    run (Rolling1588TickGap.forward false 1 (425+n)) m s=
      run (Rolling1588TickGap.forward false 45 (381+n)) [] (pullState (OB5.sig 44) raw):=by
  have init:pullState (OB5.sig 0) s=s:=by
    apply State.extensionality _ s; rfl; funext q; exact congrArg s.basis (OB5.sig_zero q)
  have same:=StockWalkWindow.steady false x good 1 (425+n) (by decide) (by omega) s m [] stage
  rw [show 1-1=0 from rfl,init] at same
  have cut:=Rolling1588TickGap.forward_gen false x good.nonzero good.small 44 1 (by decide) (by decide) s [] stage
  rw [show 1-1=0 from rfl,init] at cut
  have shape:425+n=44+(381+n):=by omega
  rw [same,shape,StairRestSupport.forward_append false 44 1 (381+n),run_append,run_take,List.drop_nil,cut]; rfl

theorem decompose_true (x:Nat) (good:Bounds x p) (s:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 1 s.basis):
    let raw:=regular true s []
    run (Rolling1588TickGap.forward true 1 424) m s=
      run (Rolling1588TickGap.forward true 45 380) [] (pullState (OB5.sig 44) raw):=by
  have init:pullState (OB5.sig 0) s=s:=by
    apply State.extensionality _ s; rfl; funext q; exact congrArg s.basis (OB5.sig_zero q)
  have same:=StockWalkWindow.steady true x good 1 424 (by decide) (by decide) s m [] stage
  rw [show 1-1=0 from rfl,init] at same
  have cut:=Rolling1588TickGap.forward_gen true x good.nonzero good.small 44 1 (by decide) (by decide) s [] stage
  rw [show 1-1=0 from rfl,init] at cut
  have shape:(424:Nat)=44+380:=rfl
  rw [same,shape,StairRestSupport.forward_append true 44 1 380,run_append,run_take,List.drop_nil,cut]; rfl

theorem move {f:Wire→Wire} (a b c:State) (mem:∀q∈pool,f q∈pool) (eq:poolEq a b)
    (fixed:pullState f b=b) (next:b=c):poolEq (pullState f a) c:=by
  intro q hq
  exact (eq _ (mem q hq)).trans ((congrArg (fun s:State=>s.basis q) fixed).trans (congrArg (fun s:State=>s.basis q) next))

theorem endpoint_stage (d:Bool) (x:Nat) (good:Bounds x p) (s:State) (stage:Rolling1588.Integer.Stage base d x p 1 s.basis):
    Rolling1588.Integer.Stage base d x p 45 (regular d s []).basis:=StockBackWindow.stageAt d x good 1 44 (by decide) s [] stage

theorem closedFalse (n x:Nat) (nz:0 < x) (lt:x<p) (atCut:426+n∈[505,506]) (one a ref:State) (m enc:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 1 one.basis)
    (pair:Paired false x a ref (StockRowVector.rows x p))
    (agree:poolEq ref (run (Rolling1588TickGap.forward false 1 (425+n)) enc one)):
    ∃old,run (WindowWalkCosts.backward false n) m a=run (Stair44WalkRun.backward false (410+n)) old ref:=by
  have good:=bounds x nz lt
  have bound:426+n≤512:=by simp only [List.mem_cons,List.not_mem_nil,or_false] at atCut; omega
  have atCut':16+(410+n)∈[425,505,506]:=by simp only [List.mem_cons,List.not_mem_nil,or_false] at atCut ⊢; omega
  have ep:=move _ _ _ rest_pool agree
    (by simpa only [show 15+(410+n)=425+n by omega] using fixed_old false (410+n) x good atCut' one stage enc)
    (decompose_false x n good one enc stage bound)
  exact StockPlacedBack.backwardFalse n x good bound (regular false one []) a ref m
    (endpoint_stage false x good one stage) (StockNativeCompare.normalized false x good) pair ep

theorem closedTrue (x:Nat) (nz:0 < x) (lt:x<p) (one a ref:State) (m enc:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 1 one.basis)
    (pair:Paired true x a ref (StockRowVector.rows x p))
    (agree:poolEq ref (run (Rolling1588TickGap.forward true 1 424 ++ WindowWalkCosts.firstPackHead) enc one)):
    ∃old,run (WindowWalkCosts.backward true 0) m a=
      run (WindowWalkCosts.firstUnpackTail ++ Stair44WalkRun.backward true 409) old ref:=by
  have good:=bounds x nz lt
  have hfix424 := fixed_old true 409 x good (by decide) one stage (enc.take (measurementCount (Rolling1588TickGap.forward true 1 424)))
  have hfixH : pullState Stair44WalkMap.rest (run (Rolling1588TickGap.forward true 1 424 ++ WindowWalkCosts.firstPackHead) enc one) =
      run (Rolling1588TickGap.forward true 1 424 ++ WindowWalkCosts.firstPackHead) enc one := by
    rw [run_append, ← StockPlacedWindow.rename_rest_firstPackHead, run_rename _ Stair44WalkMap.rest.injective,
      StockPlacedWindow.rename_rest_firstPackHead, hfix424]
  have hdec : run (Rolling1588TickGap.forward true 1 424 ++ WindowWalkCosts.firstPackHead) enc one =
      run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead)
        (WindowFieldJourney.joinTapes (Rolling1588TickGap.forward true 45 380) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424))))
        (pullState (OB5.sig 44) (regular true one [])) := by
    rw [run_append, WindowFieldJourney.joined, decompose_true x good one _ stage]
  have hbasis_eq : poolEq
      (run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead)
        (WindowFieldJourney.joinTapes (Rolling1588TickGap.forward true 45 380) [] (enc.drop (measurementCount (Rolling1588TickGap.forward true 1 424))))
        (pullState (OB5.sig 44) (regular true one [])))
      (run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead) [] (pullState (OB5.sig 44) (regular true one []))) := by
    intro q _
    exact congrFun (Arithmetic.run_basis_records _ _ _ _ _ rfl) q
  have ep : poolEq (pullState Stair44WalkMap.rest ref)
      (run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead) [] (pullState (OB5.sig 44) (regular true one []))) :=
    fun q hq => (move _ _ _ rest_pool agree hfixH hdec q hq).trans (hbasis_eq q hq)
  exact StockPlacedBack.backwardTrue x good (regular true one []) a ref m
    (endpoint_stage true x good one stage) (StockNativeCompare.normalized true x good) pair ep
end ECDSAAdd.Entrant.StairPacket.StockWalkEndpoints

