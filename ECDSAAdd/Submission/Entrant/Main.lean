theorem seg_low (B B' : Nat) (hpair : (B, B') ∈ rowPairs) :
    ∀ q ∈ wires (segP B B'), q < base 4000 := by
  obtain ⟨hB, hB', -⟩ := pair_mem B B' hpair
  have fLow := FactsLow_ok B B' hpair
  have fLow2 := FactsLow2_ok B B' hpair
  obtain ⟨fEnd, fE⟩ := FactsEnd_ok B B' hpair
  obtain ⟨-, h87', -⟩ := endFacts B' hB'
  intro q hq
  rw [segP_eq, closing_eq B' fE] at hq
  simp only [wires_append, Finset.mem_union] at hq
  rcases hq with ((((hU | hT) | hM) | hO) | hK) | hP
  · have h := StairPhysicalPrimitives.unpack_rows B hB q hU
    exact fLow q (by simp only [List.mem_append, h, true_or])
  · have h := StairPhysicalPrimitives.tickForward_rows B hB q hT
    exact fLow q (by simp only [List.mem_append, h, true_or])
  · rw [← fEnd] at hM
    have h := StairPhysicalPrimitives.middleForward_rows B hB q hM
    exact fLow q (by simp only [List.mem_append, h, true_or])
  · rw [orient_eq B' h87'] at hO
    unfold StairField2V3Boundary.orientFull at hO
    have hs := swapRegisters_wires _ _ _ (by simp [StairCodec.reg]) hO
    have h : q ∈ orientSites B' := List.mem_toFinset.mp hs
    exact fLow q (by simp only [List.mem_append, h, true_or, or_true])
  · have h := closing_wires (kk B') q hK
    exact fLow q (by simp only [List.mem_append, h, true_or, or_true])
  · have h := StairPhysicalPrimitives.pack_rows B' hB' q hP
    exact fLow2 q (by simp only [List.mem_append, h, true_or])

/-- **`SegSpecT` for every middle row pair (concrete CANON v3 provider).** -/
theorem segSpec (B B' : Nat) (hpair : (B, B') ∈ rowPairs) :
    SegSpecT StairV3Primitives.primitives B B' (startFor B) (startFor B') := by
  intro x origin hx u pre1 pre2 m
  have fLow2 := FactsLow2_ok B B' hpair
  have lowFP : ∀ r ∈ futurePayload B, r < base 4000 :=
    fun r hr => fLow2 r (by simp only [List.mem_append, hr, true_or, or_true])
  have lowFP' : ∀ r ∈ futurePayload B', r < base 4000 :=
    fun r hr => fLow2 r (by simp only [List.mem_append, hr, true_or, or_true])
  have lowS : ∀ r ∈ scratchT B B', r < base 4000 :=
    fun r hr => fLow2 r (by simp only [List.mem_append, hr, or_true])
  obtain ⟨lph, lagree, lhigh⟩ := low_reduce (segP B B') (seg_low B B' hpair) m u
  have zh : ∀ q, q < base 4000 → (zeroHigh u).basis q = u.basis q := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = u.basis q
    rw [if_neg (Nat.not_le.mpr hq)]
  have pre1' : ∀ r ∈ futurePayload B, (zeroHigh u).basis r = cmpBits B x r :=
    fun r hr => (zh r (lowFP r hr)).trans (pre1 r hr)
  have pre2' : ∀ r ∈ scratchT B B', (zeroHigh u).basis r = false :=
    fun r hr => (zh r (lowS r hr)).trans (pre2 r hr)
  have hsh : ∀ q, base 4000 ≤ q → (zeroHigh u).basis q = false := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = false
    rw [if_pos hq]
  obtain ⟨c1, c2, c3, c4, c5⟩ := core B B' hpair x origin hx (zeroHigh u) pre1' pre2' hsh m
  refine ⟨lph c1, ?_, ?_, ?_, ?_⟩
  · intro r h1 h2
    by_cases hr : base 4000 ≤ r
    · exact lhigh r hr
    · exact (lagree r (Nat.not_le.mp hr)).trans ((c2 r h1 h2).trans (zh r (Nat.not_le.mp hr)))
  · intro r hr
    exact (lagree r (lowS r hr)).trans (c3 r hr)
  · intro r hr
    exact (lagree r (lowFP' r hr)).trans (c4 r hr)
  · intro r hr hr'
    exact (lagree r (lowFP r hr)).trans (c5 r hr hr')

