/-! ## The virtual record state at the terminal link -/




theorem chk_sound (x : Nat) (hx0 : 0 < x) (hxp : x < ECDSAAdd.p) (u : State)
    (pre1 : ∀ r ∈ futurePayload 12, u.basis r = cmpBits 12 x r)
    (preC : ∀ r ∈ CT, r ∉ futurePayload 12 → u.basis r = false)
    (hsh : ∀ q, base 4000 ≤ q → u.basis q = false) (m1 m2 m3 : List Bool)
    (ρ : BasisState) (hρ : Rolling1588.Integer.Stage base true x ECDSAAdd.p 505 ρ)
