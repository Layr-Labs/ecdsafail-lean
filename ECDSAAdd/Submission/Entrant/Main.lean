private theorem pool_swap_fix (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (a b n : Nat) (ha : a<2613) (hb : b<2613) (hnn : n<2613) (hna : n≠a) (hnb : n≠b) :
