    have side : decide (2^144≤z.u)=false := by rw [orientation] at rightSide;simpa using rightSide
    have keyWait : key (actualMode 144 z)=wait 15 z.u := by
      rw [keyEq,place,if_neg (of_decide_eq_false side)]
