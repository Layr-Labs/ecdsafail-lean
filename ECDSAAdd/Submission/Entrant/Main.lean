    (∀ r ∈ futurePayload B, (run (StairPhysicalPrimitives.pack B) m u).basis r = cmpBits B x r) ∧
    (run (StairPhysicalPrimitives.pack B) m u).basis (bSite B) = false ∧
    (∀ q ∈ cleanList B, (run (StairPhysicalPrimitives.pack B) m u).basis q = false) ∧
    (∀ i, i < B → (run (StairPhysicalPrimitives.pack B) m u).basis ((physicalLayout B).D i) = false) ∧
    (run (StairPhysicalPrimitives.pack B) m u).basis ((physicalLayout B).S (B - 1)) = false ∧
    (∀ q, q ∉ StairCodec.declaredSites (physicalLayout B) B → q ∉ moveSites (relocPairs B) →
