    (bank : regValue (ys15E j) s.basis = if far (sb15E (start15E j)) 15 z then high (sb15E (start15E j)) 15 z else 0)
    (zero : ∀ q ∈ watched15E j, s.basis q = false)
    (par : oddRead15E j s.basis = oddBits (letters 15 (TrueMiddle15E.r j z)))
    (farBit : s.basis (e015E (start15E j) + 3) = decide (far (sb15E (start15E j)) 15 z))
    (sideBit : s.basis (e015E (start15E j) + 4) =
      (decide (far (sb15E (start15E j)) 15 z) && decide (2 ^ sb15E (start15E j) ≤ z.u)))
    (events : LeaveSelector.right (actualMode (sb15E (start15E j)) z) = true →
      ∀ i < 15, i ≤ key (actualMode (sb15E (start15E j)) z) →
        s.basis (swaps15E j i) = decide (i = key (actualMode (sb15E (start15E j)) z)))
    (flag : (s.basis (e015E (start15E j) + 4) ^^ (s.basis (e015E (start15E j) + 3) && s.basis (swaps15E j 0))) =
      decide (Shadow.far (sb15E (start15E j)) 15 z ∧ LeaveShadowRails.farKey (sb15E (start15E j)) z = 0)) :
    let en := run (GateMirror.forward (entryLeave15E (start15E j))) m s
