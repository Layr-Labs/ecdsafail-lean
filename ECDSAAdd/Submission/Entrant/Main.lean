theorem prevRaw_scratch_eq15E (j : Fin 4) (k : Fin 157) (hk : 23 ≤ k.val) :
    prevRawPorts15E j k = prevCodePorts15E j ⟨k.val - 7, by omega⟩ := by
  unfold prevRawPorts15E prevCodePorts15E
