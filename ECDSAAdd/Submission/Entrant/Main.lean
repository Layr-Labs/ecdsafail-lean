/-- End-to-end Option-1 `[45, 425)` mixed strong chain: phase preservation, all 22 saved archive
keys, and exact roundtrip under `MixedWindow425.reverse425 d`. -/
theorem strong425 (d : Bool) (x : Nat) (good : Bounds x p) (raw : State) (m : List Bool)
    (stage : Rolling1588.Integer.Stage base d x p 45 raw.basis) :
    let start0 := pullState (OB5.sig 44) raw
    let out := run (MixedWindow425.forward425 d) m start0
    out.phase = raw.phase ∧
    mixedFinal425 ArchiveBoundary425.codePorts d x p out ∧
    ∀ n, run (MixedWindow425.reverse425 d) n out = start0 := by
  have all := composition (chunk1_checked d x good)
    (composition (chunk2_checked d x good)
    (composition (chunk3_checked d x good)
    (composition (chunk4_checked d x good)
    (composition (chunk56_checked d x good)
      (chunk7_checked d x good)))))
  have hf : MixedWindow425.forward425 d =
      ([Shadow7.portalP 45, Shadow7.enterP MixedWindow.j0, Shadow7.routed MixedWindow.j0 0 1,
        MixedWindow.packW d 45 45, Shadow7.routed MixedWindow.j0 1 14, CRTBarrel.leave MixedWindow.j0]).flatten ++
      ((MixedWindow.prefixPairs.flatMap fun p => MixedWindow.block15F d p.1 p.2).flatten ++
      (([Shadow7.enterP MixedWindow.j7, Shadow7.routed MixedWindow.j7 0 1, MixedWindow.packW d 150 140,
        Shadow7.archiveLoadP MixedWindow.j6 d, Shadow7.routed MixedWindow.j7 1 14, leave150To20Red]).flatten ++
      (((List.finRange 10).flatMap (MixedWindow425.block20FRed d)).flatten ++
      ((([enterP15E MixedWindow425.e0, routed15E MixedWindow425.e0 0 1, MixedWindow.packW d 365 350,
         MixedWindow.packW d 365 355, archiveLoadP20 MixedWindow425.k9 d, routed15E MixedWindow425.e0 1 14,
         leaveP15E MixedWindow425.e0]).flatten ++
        (MixedWindow425.suffix15EPairs.flatMap fun p => MixedWindow425.block15EF d p.1 p.2).flatten) ++
      ([ParkEndpoint425.parkP425, Shadow7.portalInvP 425, NativePack425.stepFwd425 d,
        MixedWindow.packW d 425 415, Shadow7.exitLoadP 425 d]).flatten)))) := by
    simp only [MixedWindow425.forward425, MixedWindow425.forwardL425, List.flatten_append, List.append_assoc]
  have hr : MixedWindow425.reverse425 d =
      ((((([Shadow7.exitRestoreP 425 d, MixedWindow.unpackW d 425 415, NativePack425.stepRev425 d,
        Shadow7.portalP 425, ParkEndpoint425.parkInvP425]).flatten ++
      ((MixedWindow425.suffix15EPairs.reverse.flatMap fun p => MixedWindow425.block15ER d p.1 p.2).flatten ++
       ([leaveInvP15E MixedWindow425.e0, TickCut15E.unrouted15EHigh MixedWindow425.e0 1 14, archiveRestoreP20 MixedWindow425.k9 d,
         MixedWindow.unpackW d 365 355, MixedWindow.unpackW d 365 350, unrouted15E MixedWindow425.e0 0 1,
         enterInvP15E MixedWindow425.e0]).flatten)) ++
      ((List.finRange 10).reverse.flatMap (MixedWindow425.block20RRed d)).flatten) ++
      ([leaveInv150To20Red, TickCut.Hosted.unroutedHigh MixedWindow.j7 1 14, Shadow7.archiveRestoreP MixedWindow.j6 d,
        MixedWindow.unpackW d 150 140, Shadow7.unrouted MixedWindow.j7 0 1, Shadow7.enterInvP MixedWindow.j7]).flatten) ++
      (MixedWindow.prefixPairs.reverse.flatMap fun p => MixedWindow.block15R d p.1 p.2).flatten) ++
      ([CRTBarrel.unleave MixedWindow.j0, TickCut.Hosted.unroutedHigh MixedWindow.j0 1 14,
        MixedWindow.unpackW d 45 45, Shadow7.unrouted MixedWindow.j0 0 1,
        Shadow7.enterInvP MixedWindow.j0, Shadow7.portalInvP 45]).flatten := by
    simp only [MixedWindow425.reverse425, MixedWindow425.reverseL425, List.flatten_append, List.append_assoc]
  rw [hf, hr]
  exact all (pullState (OB5.sig 44) raw) m ⟨raw, stage, rfl⟩

theorem strongCut425 (d : Bool) (x : Nat) (good : Bounds x p) (raw : State) (m : List Bool)
    (stage : Rolling1588.Integer.Stage base d x p 45 raw.basis) :
    let start0 := pullState (OB5.sig 44) raw
    let out := run (MixedWindow425.forward425Cut d) m start0
    out.phase = raw.phase ∧
    mixedFinal425 ArchiveBoundary425.codePorts d x p out ∧
    ∀ n, run (MixedWindow425.reverse425Cut d) n out = start0 := by
  have h := strong425 d x good raw m stage
  rw [← (MixedWindow425.mixedCut425_run_eq d).1, ← (MixedWindow425.mixedCut425_run_eq d).2] at h
  exact h

