/-- **Packing at a row start stores `cmpBits`.** -/
theorem stored_after_pack (B : Nat) (hB : B ∈ budgets) (x : Nat)
    (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (u : State)
    (hin : StairCodec.CodecInput (physicalLayout B) B
