def entryTailPrefix (p : StairSchedule.StairPrimitives)
    (h : HostPlan) : Program :=
  hostedGroup h true 0 1 84 ++
    StairSchedule.forwardSegment p 87 62 425 450 ++
    hostedGroup h true 14 85 5 ++
    StairSchedule.forwardSegment p 62 47 450 465 ++
    hostedGroup h true 23 90 3 ++
    StairSchedule.forwardSegment p 47 32 465 480 ++
    hostedGroup h true 31 93 3 ++
    StairSchedule.forwardSegment p 32 22 480 490 ++
    hostedGroup h true 37 96 2 ++
    StairSchedule.forwardSegment p 22 12 490 500 ++
    hostedGroup h true 42 98 2 ++ StairSchedule.forwardLast p



def exitHeadSuffix (p : StairSchedule.StairPrimitives)
    (h : HostPlan) : Program :=
  StairSchedule.reverseLast p ++
    hostedGroup h false 42 98 2 ++
    StairSchedule.reverseSegment p 22 12 490 500 ++
    hostedGroup h false 37 96 2 ++
    StairSchedule.reverseSegment p 32 22 480 490 ++
    hostedGroup h false 31 93 3 ++
    StairSchedule.reverseSegment p 47 32 465 480 ++
    hostedGroup h false 23 90 3 ++
    StairSchedule.reverseSegment p 62 47 450 465 ++
    hostedGroup h false 14 85 5 ++
    StairSchedule.reverseSegment p 87 62 425 450 ++
    hostedGroup h false 0 1 84

def entryLowPrefix (p : StairSchedule.StairPrimitives)
    (h : HostPlan) : Program :=
  StairLoan.rebindMany StairSchedule.exclusiveRoles (h.firstPacket true)
      (Rolling1588.placedFirstPacket true) ++
    FourScratchWindow.clearProgram ++
    renameProgram Prefix1590.borrow (entryTailPrefix p h) ++
    FourScratchWindow.unprefix



def exitLowSuffix (p : StairSchedule.StairPrimitives)
    (h : HostPlan) : Program :=
  FourScratchWindow.clearProgram ++
    renameProgram Prefix1590.borrow (exitHeadSuffix p h) ++
    FourScratchWindow.unprefix ++
    StairLoan.rebindMany StairSchedule.exclusiveRoles (h.firstPacket false)
      (Rolling1588.placedFirstPacket false)

def entryFieldHosted (p : StairSchedule.StairPrimitives)
    (h : HostPlan) : Program :=
  StairSchedule.fieldRename (entryLowPrefix p h) ++
    StairSchedule.paritySetup ++ StairSchedule.hostedX ++
    StairSchedule.fieldRename (entryLowSuffix h) ++
    StairSchedule.hostedX ++ StairSchedule.paritySetup

def exitFieldHosted (p : StairSchedule.StairPrimitives)
    (h : HostPlan) : Program :=
  StairSchedule.paritySetup ++ StairSchedule.hostedX ++
    StairSchedule.fieldRename (exitLowPrefix h) ++
    StairSchedule.paritySetup ++ StairSchedule.hostedX ++
    StairSchedule.fieldRename (exitLowSuffix p h)

def lastXN (p : StairSchedule.StairPrimitives)
    (_h : HostPlan) (k : Nat) : Program :=
  StairSchedule.stackReverse15 p ++ ParityXExitInverse23Kernel.x1N k

/-- Division kernel with every assigned site-sensitive component replaced by
its role-aware hosted version. -/
def entryKernel (p : StairSchedule.StairPrimitives) (h : HostPlan) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost (StairSchedule.firstPhase p) ++
    entryFieldHosted p h ++
    renameProgram Rolling1588Lifetime.phaseHost
      (InverseFive23.lastPhase15 false)

