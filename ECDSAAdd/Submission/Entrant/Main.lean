theorem firstPackHead_counts :
    toffoliCount firstPackHead = 97 ∧ measurementCount firstPackHead = 4 ∧
    toffoliCount firstUnpackTail = 99 ∧ measurementCount firstUnpackTail = 2 := by
  have ho := EndOrient425.counts
  have hc := Rolling1588.code_counts true
  have hp : toffoliCount (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) = 9 ∧
      measurementCount (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) = 4 := by
    simp only [Rolling1588.Integer.packFirst, Rolling1588.Integer.packAfter, Rolling1588.Integer.encode,
      Rolling1588.encodeAt, Rolling1588.codeEncodeAt, show (425 : Nat) ≠ 5 by decide,
      show (425 : Nat) - 5 ≠ 0 by decide, show History5.packDue 425 = true by decide,
      if_false, if_true, (renameProgram_counts _ _).1, (renameProgram_counts _ _).2, hc.1, hc.2.1]
    exact ⟨trivial, trivial⟩
  have hu : toffoliCount (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)) = 11 ∧
      measurementCount (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)) = 2 := by
    simp only [Rolling1588.unpackAtTick, show (425 : Nat) ≠ 5 by decide,
      show History5.packDue 425 = true by decide, if_false, if_true,
      (renameProgram_counts _ _).1, (renameProgram_counts _ _).2, hc.2.2.1, hc.2.2.2]
    exact ⟨trivial, trivial⟩
  have heq : renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425) = EndOrient425.physP := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [firstPackHead, toffoliCount_append, heq, ho.1, hp.1]
  · rw [firstPackHead, measurementCount_append, heq, ho.2.1, hp.2]
  · rw [firstUnpackTail, toffoliCount_append, heq, hu.1, ho.1]
  · rw [firstUnpackTail, measurementCount_append, heq, hu.2, ho.2.1]

/-- The replacement occupies [45, 425); suffix ticks start at 426. -/
def forward (d : Bool) (tail : Nat) : Program :=
  renameProgram Stair44WalkMap.first (Rolling1588TickGap.forward d 1 15) ++
  renameProgram Stair44WalkMap.rest (Rolling1588TickGap.forward d 16 29 ++
    Shadow20.MixedWindow425.forward425Cut d ++ Rolling1588TickGap.forward d 426 tail)

def backward (d : Bool) (tail : Nat) : Program :=
  renameProgram Stair44WalkMap.rest (Rolling1588.reverse d 426 tail ++
    Shadow20.MixedWindow425.reverse425Cut d ++ Rolling1588.reverse d 16 29) ++
  renameProgram Stair44WalkMap.first (Rolling1588.reverse d 1 15)

theorem fwd_zero (d : Bool) (i : Nat) : Rolling1588TickGap.forward d i 0 = [] := rfl
theorem rev_zero (d : Bool) (i : Nat) : Rolling1588.reverse d i 0 = [] := rfl

attribute [local irreducible] Shadow20.MixedWindow425.forward425Cut Shadow20.MixedWindow425.reverse425Cut Rolling1588TickGap.forward Rolling1588.reverse
  Stair44WalkRun.forward Stair44WalkRun.backward toffoliCount measurementCount firstPackHead firstUnpackTail

private theorem walkFalse (c : Cost) (tail f r : Nat)
    (hf : c.measure (Shadow20.MixedWindow425.forward425Cut false) + f = c.measure (Rolling1588TickGap.forward false 45 381))
    (hr : c.measure (Shadow20.MixedWindow425.reverse425Cut false) + r = c.measure (Rolling1588.reverse false 45 381)) :
    c.measure (forward false tail) + f = c.measure (Stair44WalkRun.forward false (410 + tail)) ∧
    c.measure (backward false tail) + r = c.measure (Stair44WalkRun.backward false (410 + tail)) := by
  have a := StairRestSupport.forward_append false 29 16 (381 + tail)
  have b := StairRestSupport.forward_append false 381 45 tail
  have x := StairRestSupport.reverse_append false 29 16 (381 + tail)
  have y := StairRestSupport.reverse_append false 381 45 tail
  rw [show (16 : Nat) + 29 = 45 from rfl] at a x
  rw [show (45 : Nat) + 381 = 426 from rfl] at b y
  rw [b] at a; rw [y] at x
  have num : 410 + tail = 29 + (381 + tail) := by omega
  simp only [Stair44WalkRun.forward, Stair44WalkRun.backward, forward, backward, num, a, x, c.append, c.rename]
  constructor <;> omega

private theorem walkTrue (c : Cost) (f r : Nat)
    (hf : c.measure (Shadow20.MixedWindow425.forward425Cut true) + f = c.measure (Rolling1588TickGap.forward true 45 380) + c.measure firstPackHead)
    (hr : c.measure (Shadow20.MixedWindow425.reverse425Cut true) + r = c.measure firstUnpackTail + c.measure (Rolling1588.reverse true 45 380)) :
    c.measure (forward true 0) + f = c.measure (Stair44WalkRun.forward true 409) + c.measure firstPackHead ∧
    c.measure (backward true 0) + r = c.measure firstUnpackTail + c.measure (Stair44WalkRun.backward true 409) := by
  have a := StairRestSupport.forward_append true 29 16 380
  have x := StairRestSupport.reverse_append true 29 16 380
  rw [show (16 : Nat) + 29 = 45 from rfl] at a x
  have num : (409 : Nat) = 29 + 380 := by omega
  have hnil : c.measure [] = 0 := by
    have h0 := c.append [] []; rw [List.nil_append] at h0; omega
  have h1 : c.measure (forward true 0) = c.measure (Rolling1588TickGap.forward true 1 15) +
      (c.measure (Rolling1588TickGap.forward true 16 29) + c.measure (Shadow20.MixedWindow425.forward425Cut true) + 0) := by
    rw [forward, c.append, c.rename, c.rename, c.append, c.append, fwd_zero, hnil]
  have h2 : c.measure (backward true 0) = (0 + c.measure (Shadow20.MixedWindow425.reverse425Cut true) +
      c.measure (Rolling1588.reverse true 16 29)) + c.measure (Rolling1588.reverse true 1 15) := by
    rw [backward, c.append, c.rename, c.rename, c.append, c.append, rev_zero, hnil]
  have h3 : c.measure (Stair44WalkRun.forward true 409) =
      c.measure (Rolling1588TickGap.forward true 1 15) +
      (c.measure (Rolling1588TickGap.forward true 16 29) + c.measure (Rolling1588TickGap.forward true 45 380)) := by
    rw [Stair44WalkRun.forward, num, a, c.append, c.rename, c.rename, c.append]
  have h4 : c.measure (Stair44WalkRun.backward true 409) =
      (c.measure (Rolling1588.reverse true 45 380) + c.measure (Rolling1588.reverse true 16 29)) +
      c.measure (Rolling1588.reverse true 1 15) := by
    rw [Stair44WalkRun.backward, num, x, c.append, c.rename, c.rename, c.append]
  constructor <;> omega

attribute [local irreducible] forward backward

private theorem subEq {a b : Nat} (d : Nat) (ha : a = x) (hb : b = y) (h : x + d = y) : a + d = b := by omega
private theorem subEq2 {a b c x y z : Nat} (d : Nat) (ha : a = x) (hb : b = y) (hc : c = z) (h : x + d = y + z) : a + d = b + c := by omega

theorem exactWalksFalse (tail : Nat) :
    tc.measure (forward false tail) + 39393 = tc.measure (Stair44WalkRun.forward false (410 + tail)) ∧
    tc.measure (backward false tail) + 39292 = tc.measure (Stair44WalkRun.backward false (410 + tail)) ∧
    mc.measure (forward false tail) + 17728 = mc.measure (Stair44WalkRun.forward false (410 + tail)) ∧
    mc.measure (backward false tail) + 17727 = mc.measure (Stair44WalkRun.backward false (410 + tail)) := by
  have mcw := Shadow20.MixedWindow425.mixedCut425_counts false
  have sf := StockWindowCosts420.stock425from45 false
  simp only [Bool.false_eq_true, ↓reduceIte] at mcw
  have t := walkFalse tc tail 39393 39292
    (subEq 39393 mcw.1 sf.1 (by omega)) (subEq 39292 mcw.2.1 sf.2.2.1 (by omega))
  have mv := walkFalse mc tail 17728 17727
    (subEq 17728 mcw.2.2.1 sf.2.1 (by omega)) (subEq 17727 mcw.2.2.2 sf.2.2.2 (by omega))
  exact ⟨t.1, t.2, mv.1, mv.2⟩

theorem exactWalksTrue :
    tc.measure (forward true 0) + 39393 = tc.measure (Stair44WalkRun.forward true 409) + tc.measure firstPackHead ∧
    tc.measure (backward true 0) + 39314 = tc.measure firstUnpackTail + tc.measure (Stair44WalkRun.backward true 409) ∧
    mc.measure (forward true 0) + 17750 = mc.measure (Stair44WalkRun.forward true 409) + mc.measure firstPackHead ∧
    mc.measure (backward true 0) + 17749 = mc.measure firstUnpackTail + mc.measure (Stair44WalkRun.backward true 409) := by
  have mcw := Shadow20.MixedWindow425.mixedCut425_counts true
  have sf := StockWindowCosts420.stock424from45 true
  have hp := firstPackHead_counts
  simp only [↓reduceIte] at mcw
  have t := walkTrue tc 39393 39314
    (subEq2 39393 mcw.1 sf.1 hp.1 (by omega))
    (subEq2 39314 mcw.2.1 hp.2.2.1 sf.2.2.1 (by omega))
  have mv := walkTrue mc 17750 17749
    (subEq2 17750 mcw.2.2.1 sf.2.1 hp.2.1 (by omega))
    (subEq2 17749 mcw.2.2.2 hp.2.2.2 sf.2.2.2 (by omega))
  exact ⟨t.1, t.2, mv.1, mv.2⟩

