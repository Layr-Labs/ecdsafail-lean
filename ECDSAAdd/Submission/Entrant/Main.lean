theorem selected_last (d:Bool) (x:Nat) (hx0:0<x) (hx:x<p) (raw original s:State) (m:List Bool)
    (read:EndTick4207.Reads raw original) (stage:Rolling1588.Integer.Stage base d x p 420 original.basis)
