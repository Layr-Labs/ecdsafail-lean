private theorem stage_physical : GatePhysical stageOpen ∧ GatePhysical stageClose ∧
    ∀divide k,k<2→GatePhysical (stageTransition divide k) := by
  refine ⟨?_,?_,?_⟩
  · apply physicalGateCheck_correct
    decide +kernel
  · apply physicalGateCheck_correct
