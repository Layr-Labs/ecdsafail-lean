/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitRSeg_at_Main` -/
section Merge_StairField2V3ExitRSeg_at_Main

/-!
# Exit reverse segments from the entry segment spec + the row round trip (LT24)

LT21 reduces each division segment to the pure staircase spec
`SegSpecT p B B' ℓ e` (`StairField2V3Seg`).  The multiplication segment is its
mirror:

* `RSegSpecT p B B' ℓ e` — from the compact checkpoint of row `B'`, the
  segment's encoded packets (`recVal`) and clean scratch, the reverse segment
  gives the compact checkpoint of row `B` with clean scratch, nothing else changed;
* `rspec_of_spec : SegSpecT → RowTripT → RSegSpecT` — the forward spec + the
  row round trip `W ∘ F = id` give the reverse spec, because every admissible
  reverse input is the forward image of an admissible forward input (state surgery
  on `futurePayload B`);
* `rseg_of_rspec` — the coupled step for the exit chain (mirror of `seg_of_spec`).
  The source relation `ExitRowRel` carries what the reference state must satisfy
  at the exit: the record transcript on `futurePayload B` and clean segment scratch.
  Plain `Cv B'` is not enough here: it fixes the reference only on `futurePayload B'`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24RSeg

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3Delta StairField2V3Seg
open StairPhysicalLayout StairOuterPlacement

/-- Row round trip in tail coordinates, on admissible forward inputs. -/
def RowTripT (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat) : Prop :=
  ∀ x origin, TraceOK x origin → ∀ (u : State),
    (∀ r ∈ futurePayload B, u.basis r = cmpBits B x r) →
    (∀ r ∈ scratchT B B', u.basis r = false) → ∀ c a,
      run (StairSchedule.reverseSegment p B B' ℓ e) a
        (run (StairSchedule.forwardSegment p B B' ℓ e) c u) = u

/-- Pure tail-level staircase spec of `reverseSegment p B B' ℓ e`. -/
def RSegSpecT (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat) : Prop :=
  ∀ x origin, TraceOK x origin → ∀ (v : State),
    (∀ r ∈ futurePayload B', v.basis r = cmpBits B' x r) →
    (∀ r ∈ futurePayload B, r ∉ futurePayload B' → v.basis r = recVal origin r) →
    (∀ r ∈ scratchT B B', v.basis r = false) → ∀ m,
      (run (StairSchedule.reverseSegment p B B' ℓ e) m v).phase = v.phase ∧
      (∀ r, r ∉ futurePayload B → r ∉ scratchT B B' →
        (run (StairSchedule.reverseSegment p B B' ℓ e) m v).basis r = v.basis r) ∧
      (∀ r ∈ scratchT B B', (run (StairSchedule.reverseSegment p B B' ℓ e) m v).basis r = false) ∧
      (∀ r ∈ futurePayload B, (run (StairSchedule.reverseSegment p B B' ℓ e) m v).basis r = cmpBits B x r)


/-- **Mirror.** The reverse spec from the forward spec and the row round trip. -/
theorem rspec_of_spec (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat)
    (spec : SegSpecT p B B' ℓ e) (trip : RowTripT p B B' ℓ e) : RSegSpecT p B B' ℓ e := by
  intro x origin hx v h1 h2 h3 m
  let u : State := ⟨v.phase, fun r => if r ∈ futurePayload B then cmpBits B x r else v.basis r⟩
  have uIn : ∀ r ∈ futurePayload B, u.basis r = cmpBits B x r := by
    intro r hr
    show (if r ∈ futurePayload B then cmpBits B x r else v.basis r) = _
    rw [if_pos hr]
  have uOut : ∀ r, r ∉ futurePayload B → u.basis r = v.basis r := by
    intro r hr
    show (if r ∈ futurePayload B then cmpBits B x r else v.basis r) = _
    rw [if_neg hr]
  have uScr : ∀ r ∈ scratchT B B', u.basis r = false := by
    intro r hr
    rw [uOut r (scratch_not_fut B B' r hr)]
    exact h3 r hr
  obtain ⟨sph, sout, sscr, scmp, srec⟩ := spec x origin hx u uIn uScr []
  have hF : run (StairSchedule.forwardSegment p B B' ℓ e) [] u = v := by
    apply State.extensionality
    · exact sph
    · funext r
      by_cases hB' : r ∈ futurePayload B'
      · rw [scmp r hB']
        exact (h1 r hB').symm
      · by_cases hB : r ∈ futurePayload B
        · rw [srec r hB hB']
          exact (h2 r hB hB').symm
        · by_cases hs : r ∈ scratchT B B'
          · rw [sscr r hs]
            exact (h3 r hs).symm
          · rw [sout r hB hs]
            exact uOut r hB
  have back : run (StairSchedule.reverseSegment p B B' ℓ e) m v = u := by
    rw [← hF]
    exact trip x origin hx u uIn uScr [] m
  rw [back]
  exact ⟨rfl, fun r hr _ => uOut r hr, uScr, uIn⟩





end ECDSAAdd.Entrant.StairExitLT24RSeg

end
end Merge_StairField2V3ExitRSeg_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitStepsR_at_Main` -/
section Merge_StairField2V3ExitStepsR_at_Main

/-!
# LT43: the steps of `ExitPlanR` from pure staircase facts and record facts

* `rsegR` — reverse segment `B' → B` from LT24's pure mirror spec `RSegSpecT`
