private theorem pieceOK_sub {holes : List Wire} {f : Wire → Wire} {P Q : Program}
    (h : ∀ q ∈ wires P, q ∈ wires Q) (hq : PieceOK holes f Q) : PieceOK holes f P :=
  ⟨fun x hx => hq.1 x (h x hx), fun x hx => hq.2 x (h x hx)⟩
private theorem entryFieldCut : PieceOK reserved KP WindowCallerCosts.entryFieldHostedCut :=
  pieceOK_sub (PackCutSub.wires_sub WindowCallerCosts.field_sublist) entryField
end

theorem phase {P : Program} (v : PieceOK reserved PP P) :
    PieceOK reserved UG (Stair44Outer.phasePlace P) := ok_kernel (ok_phase v)

private theorem firstPackTail_ok : PieceOK StairPhysicalInventory.physicalHoles PP WindowWalkCosts.firstPackTail := by
  have h : PieceOK StairPhysicalInventory.physicalHoles PP checkpointPrimitives.firstPack := Stair44FirstRow.pack
  rw [WindowWalkCosts.firstPack_split] at h
  exact (app.mp h).2

private theorem firstUnpackHead_ok : PieceOK StairPhysicalInventory.physicalHoles PP WindowWalkCosts.firstUnpackHead := by
  have h : PieceOK StairPhysicalInventory.physicalHoles PP checkpointPrimitives.firstUnpack := Stair44FirstRow.unpack
  rw [WindowWalkCosts.firstUnpack_split] at h
  exact (app.mp h).1

theorem division (f : GoodWindow (Shadow20.MixedWindow425.forward425Cut true))
    (r : GoodWindow (Shadow20.MixedWindow425.reverse425Cut false)) :
    PieceOK reserved UG WindowCallerCosts.divide :=
  (((((phase (walkFTrue f)).append (weaken (ok_kernel (ok_phase firstPackTail_ok)))).append
    (ok_kernel entryFieldCut)).append (weaken (ok_kernel (ok_phase Stair44PhaseSites.reverseTail)))).append
    (phase (walkRFalse 80 (by decide) r))).append (weaken (ok_kernel (ok_phase Stair44PhaseSites.native)))

theorem multiplication (k : Nat) (f : GoodWindow (Shadow20.MixedWindow425.forward425Cut false))
    (r : GoodWindow (Shadow20.MixedWindow425.reverse425Cut true)) :
    PieceOK reserved UG (WindowCallerCosts.multiply k) :=
  (((((phase (walkFFalse 79 (by decide) f)).append (weaken (ok_kernel (ok_phase Stair44PhaseSites.forwardTail)))).append
    (ok_kernel exitField)).append (weaken (ok_kernel (ok_phase firstUnpackHead_ok)))).append
    (phase (walkRTrue r))).append (weaken (Stair44PhaseSites.exitX k))

theorem program_width (C : Point) (f : ∀ d, GoodWindow (Shadow20.MixedWindow425.forward425Cut d))
    (r : ∀ d, GoodWindow (Shadow20.MixedWindow425.reverse425Cut d)) :
    Challenge.qubits (WindowCallerCosts.program C) ≤ 1543 := by
  apply width
  cases C with
  | zero => exact pieceOK_nil _ _
  | @some cx cy hc =>
    apply ok_wrapper
    exact ((weaken (Stair44OuterSites.initial hc)).append (ok_generic
      ((((((weaken (Stair44OuterSites.entryY (-cy))).append (weaken (Stair44OuterSites.entryX (-cx)))).append
        (division (f _) (r _))).append (weaken (Stair44Release.squareSites (ReflectionE1.correction cx)))).append
          (multiplication cx.val (f _) (r _))).append (weaken (Stair44OuterSites.exitY cy))))).append
      (weaken (Stair44OuterSites.finalPart hc))
end ECDSAAdd.Entrant.StairPacket.WindowSites

