    have no : q ∉ EnterJ20.pending k0 := by rw [hk0.2.2.2.1]; simp only [List.mem_cons, List.not_mem_nil, or_false]; rcases hq with rfl | rfl | rfl <;> decide
    simp [eraseSites, no]
  refine ⟨phase, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [flagOff _ (Or.inl hk0.1)]; exact sign
