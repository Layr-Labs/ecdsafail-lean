  have n := fun X => cutClean_nil pre X
  interval_cases j
  · exact ⟨n _, n _⟩
  · exact ⟨n _, n _⟩
  · exact ⟨n _, n _⟩
  · exact ⟨n _, n _⟩
  · exact ⟨n _, n _⟩
