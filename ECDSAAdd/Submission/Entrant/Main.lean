namespace ECDSAAdd.Entrant.StairPacket.StockBackWindow
open Arithmetic MappedCompressed Secp256k1 WideReference StockArchiveBanks StockWalkWindow StockInverseReplay
set_option maxRecDepth 12000
set_option maxHeartbeats 3000000
attribute [local irreducible] run measurementCount Rolling1588TickGap.forward Rolling1588.reverse
  Rolling1588.Integer.regularForward Shadow20.MixedWindow425.forward425Cut Shadow20.MixedWindow425.reverse425Cut

def real (d:Bool) (raw:State):State:=run (Shadow20.MixedWindow425.forward425Cut d) [] (pullState (OB5.sig 44) raw)
def stock (d:Bool) (raw:State):State:=run (Shadow20.MixedOrd425.stockRef425 d) [] (pullState (OB5.sig 44) raw)

theorem shadow (d:Bool) (x:Nat) (good:Bounds x p) (raw:State)
    (stage:Rolling1588.Integer.Stage base d x p 45 raw.basis) (norm:NewNormalized d x):
    Paired d x (real d raw) (stock d raw) (StockRowVector.rows x p):=by
  have res:=StockStrongChain.result d x good raw [] stage
  have e:=norm raw [] stage
  have cmp:=StockBaseline.comparison d x good raw _ [] stage res.2.1
  exact StockRowVector.binding d x good raw _ [] stage res.2.1
    ⟨e.1.trans cmp.1.symm,fun q off=>(e.2 q off).trans (cmp.2 q off).symm⟩

theorem candidate_undo (d:Bool) (x:Nat) (good:Bounds x p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d x p 45 raw.basis):
    run (Shadow20.MixedWindow425.reverse425Cut d) m (real d raw)=pullState (OB5.sig 44) raw:=
  (StockStrongChain.result d x good raw [] stage).2.2 m

theorem stock_undo_false (x:Nat) (good:Bounds x p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 45 raw.basis):
    run (Rolling1588.reverse false 45 381) m (stock false raw)=pullState (OB5.sig 44) raw:=
  reverse_forward false x good 45 381 (by decide) (by decide) raw [] m stage

theorem stageAt (d:Bool) (x:Nat) (good:Bounds x p) (i n:Nat) (hi:i+n≤512) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d x p i raw.basis):
    Rolling1588.Integer.Stage base d x p (i+n) (run (Rolling1588.Integer.regularForward base d i n) m raw).basis:=by
  obtain ⟨hp0,odd,cap,cop⟩:=StackOB5.prime_facts x good.nonzero good.small
  exact (Rolling1588.Integer.regularForward_spec base d base_pool_nodup StackOB5.historyAbove x p i n hp0 good.nonzero odd cap (by norm_num [p]) good.small cop hi raw m stage).2

private theorem pool_firstUnpackTail : wires WindowWalkCosts.firstUnpackTail ⊆ pool := by
  rw [WindowWalkCosts.firstUnpackTail, wires_append, Finset.union_subset_iff]
  refine ⟨?_, ?_⟩
  · intro q hq
    have hdom : PartialSites.domain q = true := by
      have hall : ∀ w ∈ wires (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)), PartialSites.domain w = true := by decide +kernel
      exact hall q hq
    have hb := PartialSites.inside q hdom
    exact List.mem_toFinset.mpr (PartialSites.range_pool q hb.1 hb.2)
  · intro q hq
    have hcov := EndOrient425.cov q hq
    have hdom : PartialSites.domain q = true := by rw [PartialSites.domain_eq]; exact hcov
    have hb := PartialSites.inside q hdom
    exact List.mem_toFinset.mpr (PartialSites.range_pool q hb.1 hb.2)

private theorem pullState_basis_sb (f : Wire → Wire) (s : State) (q : Wire) : (pullState f s).basis q = s.basis (f q) := rfl

private theorem canonical_not_both_one_sb (x : Nat) (good : Bounds x p) (r : Nat) :
    ((SkywalkTrace.code (WideReference.canonical r x p)).1 &&
     (SkywalkTrace.code (WideReference.canonical r x p)).2) = false := by
  have hleg := StairArchiveTrace.legal_signed (r + 1) (SkywalkNat.init x p) false false good.positive good.odd
  have hmem : ∀ (n k : Nat) (s : SkywalkRails.State), k < n →
      SkywalkTrace.code (SkywalkTrace.next^[k] s) ∈ SkywalkTrace.trace n s := by
    intro n; induction n with
    | zero => intro _ _ h; omega
    | succ n ih =>
      intro k s hk; cases k with
      | zero => simp [SkywalkTrace.trace]
      | succ k => exact List.mem_cons_of_mem _ (by simpa only [Function.iterate_succ_apply] using ih k (SkywalkTrace.next s) (by omega))
  have hne := hleg _ (hmem (r + 1) r (SkywalkRails.encode false false (x : Int) (p : Int)) (Nat.lt_succ_self r))
  cases h1 : (SkywalkTrace.code (WideReference.canonical r x p)).1 <;>
    cases h2 : (SkywalkTrace.code (WideReference.canonical r x p)).2
  · rfl
  · rfl
  · rfl
  · exact absurd (Prod.ext h1 h2) hne

private theorem packs_add_sb (d : Bool) (n m : Nat) :
    ∀ s, StockDelayed.packs d s (n + m) = StockDelayed.packs d s n ++ StockDelayed.packs d (s + n) m := by
  induction n with
  | zero => intro s; simp [StockDelayed.packs]
  | succ n ih =>
    intro s; rw [Nat.succ_add]
    simp only [StockDelayed.packs, ih (s + 1), List.append_assoc, Nat.add_right_comm s 1 n, Nat.add_assoc]

private theorem hunpack_eq_sb : WindowWalkCosts.firstUnpackTail =
    renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425) ++ EndOrient425.physP := rfl

attribute [local irreducible] span StockGroupsW.batch EndOrient425.physP in
theorem stock_undo_true (x:Nat) (good:Bounds x p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 45 raw.basis):
    run (WindowWalkCosts.firstUnpackTail ++ Rolling1588.reverse true 45 380) m (stock true raw)=
      pullState (OB5.sig 44) raw:=by
  have hst := StockDelayed.window true x good.nonzero good.small 45 380 (by decide) (by decide) raw [] stage
  rw [show (45 - 1 : Nat) = 44 from rfl, show (45 + 380 - 1 : Nat) = 424 from rfl] at hst
  have hdom425 : Domain 425 x p (run (span 45 380) [] raw) := by
    obtain ⟨ref, coh, valid⟩ := WideReference.initial 45 x p (by decide) true raw stage
    refine ⟨run (span 45 380) [] ref, WideReference.coherent_span 45 380 (by decide) raw ref coh [],
      WideReference.full_span 45 380 x p (by decide) good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime ref [] valid⟩
  have hpks : StockDelayed.packs true 45 380 = StockGroupsW.batch 45 true (StockGroupsW.all 25) := by
    rw [show (380 : Nat) = 376 + 4 from rfl, packs_add_sb]
    have hnil : StockDelayed.packs true (45 + 376) 4 = [] := by
      simp only [StockDelayed.packs, Rolling1588.Integer.packAfter,
        show 45 + 376 = 421 from rfl, show (421 : Nat) + 1 = 422 from rfl,
        show (422 : Nat) + 1 = 423 from rfl, show (423 : Nat) + 1 = 424 from rfl,
        show History5.packDue 421 = false by decide, show History5.packDue 422 = false by decide,
        show History5.packDue 423 = false by decide, show History5.packDue 424 = false by decide,
        Bool.false_eq_true, ↓reduceIte, List.append_nil]
    rw [hnil, List.append_nil, StockGroupsW.packs_bridge, StockGroupsW.stockEq true 45 25 (by decide) (by decide)]
  have hno76 : ∀ j : Fin 10, ∀ i ∈ StockGroupsW.all 25, History5.historyMap base 420 j ∉ StockGroupsW.ports 45 i := by
    intro j i hi hit; obtain ⟨k, _, eq⟩ := Finset.mem_image.mp hit
    have := List.mem_range.mp hi; have := j.isLt; have := k.isLt
    unfold StockWindowGeo.slot History5.historyMap History5.historyId StockWindowGeo.gstart base at eq
    split_ifs at eq <;> simp only [Wire] at eq <;> omega
  have hpull : pullState (OB5.sig 424) (run (StockGroupsW.batch 45 true (StockGroupsW.all 25)) [] (run (span 45 380) [] raw)) =
      pullState (OB5.sig 425) (run (StockGroupsW.batch 45 true (StockGroupsW.all 25)) [] (run (span 45 380) [] raw)) := by
    apply OB5.pull_step 425 (by decide)
    · rw [StockGroupsW.outside 45 true (StockGroupsW.all 25) _ _ (fun i hi => by
        intro hit; obtain ⟨j, _, eq⟩ := Finset.mem_image.mp hit
        have := List.mem_range.mp hi; have := j.isLt
        unfold StockWindowGeo.slot History5.historyMap History5.historyId StockWindowGeo.gstart base at eq
        split_ifs at eq <;> simp only [Wire] at eq <;> omega)]
      exact WideReference.future_history (le_refl 425) (by decide) hdom425
    · intro _
      rw [StockGroupsW.outside 45 true (StockGroupsW.all 25) _ _ (fun i hi => by
        intro hit; obtain ⟨j, _, eq⟩ := Finset.mem_image.mp hit
        have := List.mem_range.mp hi; have := j.isLt
        unfold StockWindowGeo.slot History5.historyMap History5.historyId StockWindowGeo.gstart base at eq
        split_ifs at eq <;> simp only [Wire] at eq <;> omega)]
      exact WideReference.domain_carry (by decide) hdom425 _ (by decide) (by decide)
  have hleg : MeasuredCodec5.legalAt (History5.historyMap base 420)
      (pullState (OB5.sig 425) (run EndOrient425.physP []
        (run (Rolling1588TickGap.forward true 45 380) [] (pullState (OB5.sig 44) raw)))).basis := by
    rw [hst, hpks, hpull]
    have hro : ∀ i : Fin 10, EndOrient425.readOnly (OB5.sig 425 (History5.historyMap base 420 i)) := by
      unfold EndOrient425.readOnly; decide +kernel
    apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
    rw [pullState_basis_sb, pullState_basis_sb,
      EndOrient425.observes _ (hro ⟨2 * i.val, by omega⟩), EndOrient425.observes _ (hro ⟨2 * i.val + 1, by omega⟩),
      pullState_basis_sb, pullState_basis_sb,
      OB5.sig_invol 425 (by decide), OB5.sig_invol 425 (by decide),
      StockGroupsW.outside 45 true (StockGroupsW.all 25) _ _ (hno76 ⟨2 * i.val, by omega⟩),
      StockGroupsW.outside 45 true (StockGroupsW.all 25) _ _ (hno76 ⟨2 * i.val + 1, by omega⟩)]
    have htr := WideReference.trace_sites 45 380 x p (by decide) good raw [] (WideReference.initial 45 x p (by decide) true raw stage)
      (420 + i.val) (by omega) (by have := i.isLt; omega)
    dsimp only at htr
    simp only [History5.historyMap, History5.historyId, Nat.mul_div_cancel_left _ (by decide : 0 < 2),
      show (2 * i.val) % 2 = 0 by omega, show (2 * i.val + 1) % 2 ≠ 0 by omega,
      show (2 * i.val + 1) / 2 = i.val by omega, ↓reduceIte, Nat.add_assoc, htr.1, htr.2]
    exact canonical_not_both_one_sb x good (420 + i.val)
  have htrip := StairExitLT24.packet425_trip base_pool_nodup _ hleg [] (m.take (measurementCount (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425))))
  have hstock_eq : stock true raw =
      run (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) []
        (run EndOrient425.physP []
          (run (Rolling1588TickGap.forward true 45 380) [] (pullState (OB5.sig 44) raw))) := by
    simp only [stock, Shadow20.MixedOrd425.stockRef425, Shadow20.MixedOrd425.firstPackHead,
      Shadow20.MixedOrd425.pack425, ↓reduceIte, run_append, run_take, List.drop_nil]
  have htail_undo : run WindowWalkCosts.firstUnpackTail (m.take (measurementCount WindowWalkCosts.firstUnpackTail)) (stock true raw) =
      run (Rolling1588TickGap.forward true 45 380) [] (pullState (OB5.sig 44) raw) := by
    rw [hstock_eq, hunpack_eq_sb, run_append]
    have htk : (m.take (measurementCount (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425) ++ EndOrient425.physP))).take
        (measurementCount (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425))) =
        m.take (measurementCount (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425))) := by
      rw [List.take_take, Nat.min_eq_left (by rw [measurementCount_append]; omega)]
    rw [htk, htrip, EndOrient425.self_inverse]
  rw [run_append, htail_undo]
  exact reverse_forward true x good 45 380 (by decide) (by decide) raw [] _ stage

attribute [local irreducible] real stock poolEq

theorem innerFalse (x:Nat) (good:Bounds x p) (raw a ref:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 45 raw.basis) (norm:NewNormalized false x)
    (pair:Paired false x a ref (StockRowVector.rows x p))
    (agree:poolEq ref (stock false raw)):
    run (Shadow20.MixedWindow425.reverse425Cut false) m a=run (Rolling1588.reverse false 45 381) m ref:=by
  have ghost:=shadow false x good raw stage norm
  exact replay _ _ m a ref (real false raw) (stock false raw) _ (PartialSites.pool_partial false) (PartialSites.pool_old false 45 381 (by decide) (by decide))
    (fun q off=>pair.equality.2 q (fun h=>off (archives_pool q h))) pair.equality.1 ghost.equality.1
    (paired_pool pair ghost agree) agree (candidate_undo false x good raw m stage) (stock_undo_false x good raw m stage)

theorem innerTrue (x:Nat) (good:Bounds x p) (raw a ref:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 45 raw.basis) (norm:NewNormalized true x)
    (pair:Paired true x a ref (StockRowVector.rows x p))
    (agree:poolEq ref (stock true raw)):
    run (Shadow20.MixedWindow425.reverse425Cut true) m a=run (WindowWalkCosts.firstUnpackTail ++ Rolling1588.reverse true 45 380) m ref:=by
  have ghost:=shadow true x good raw stage norm
  have hpool_old : wires (WindowWalkCosts.firstUnpackTail ++ Rolling1588.reverse true 45 380) ⊆ pool := by
    rw [wires_append, Finset.union_subset_iff]
    exact ⟨pool_firstUnpackTail, PartialSites.pool_old true 45 380 (by decide) (by decide)⟩
  exact replay _ _ m a ref (real true raw) (stock true raw) _ (PartialSites.pool_partial true) hpool_old
    (fun q off=>pair.equality.2 q (fun h=>off (archives_pool q h))) pair.equality.1 ghost.equality.1
    (paired_pool pair ghost agree) agree (candidate_undo true x good raw m stage) (stock_undo_true x good raw m stage)

theorem pool_run {C:Program} (cover:wires C⊆pool) {a b} (h:poolEq a b) (m:List Bool):poolEq (run C m a) (run C m b):=by
  unfold poolEq at h ⊢
  have use:=run_local_increment C a b m (fun q hq=>h q (cover hq))
  intro q hq
  by_cases hit:q∈wires C
  · exact use.2 q hit
  · rw [run_preserves_outside C m a q hit,run_preserves_outside C m b q hit]; exact h q hq

private theorem transport (F R:Program) (m:List Bool) (a b:State) (eq:a=b) (inv:run R m (run F [] b)=b):
    run R m (run F [] a)=a:=eq ▸ inv

theorem tail_cancel (d:Bool) (x i h n:Nat) (good:Bounds x p) (lo:1 ≤ i) (bound:i+h+n≤512) (raw:State)
    (stage:Rolling1588.Integer.Stage base d x p i raw.basis) (m:List Bool):
    let s:=pullState (OB5.sig (i-1)) raw
    let old:=run (Rolling1588TickGap.forward d i h) [] s
    run (Rolling1588.reverse d (i+h) n) m (run (Rolling1588TickGap.forward d (i+h) n) [] old)=old:=by
  let t:=run (Rolling1588.Integer.regularForward base d i h) [] raw
  have cut:i+h≤512:=by omega
  have st:=stageAt d x good i h cut raw [] stage
  have eq:=Rolling1588TickGap.forward_gen d x good.nonzero good.small h i lo cut raw [] stage
  exact transport _ _ _ _ _ eq (reverse_forward d x good (i+h) n (by omega) bound t [] m st)

def backwards (d:Bool) (n:Nat):Program:=Rolling1588.reverse d 426 n++Shadow20.MixedWindow425.reverse425Cut d

theorem resultFalse (n x:Nat) (good:Bounds x p) (bound:426+n≤512) (raw a ref:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 45 raw.basis) (norm:NewNormalized false x)
    (pair:Paired false x a ref (StockRowVector.rows x p))
    (agree:poolEq ref (run (Rolling1588TickGap.forward false 45 (381+n)) [] (pullState (OB5.sig 44) raw))):
    run (backwards false n) m a=run (Rolling1588.reverse false 45 (381+n)) m ref:=by
  have h:=pair.through (Rolling1588.reverse false 426 n) (fun q hq=>(StockArchiveBanks.safe false 426 n (by decide) bound q hq).2) m
  have pools:=pool_run (PartialSites.pool_old false 426 n (by decide) bound) agree m
  simp only [StairRestSupport.forward_append false 381 45 n,run_append,run_take,List.drop_nil] at pools
  rw [tail_cancel false x 45 381 n good (by decide) bound raw stage m] at pools
  simp only [backwards,StairRestSupport.reverse_append false 381 45 n,run_append,run_take]
  apply innerFalse x good raw _ _ _ stage norm h
  unfold stock Shadow20.MixedOrd425.stockRef425; exact pools

theorem resultTrue (x:Nat) (good:Bounds x p) (raw a ref:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 45 raw.basis) (norm:NewNormalized true x)
    (pair:Paired true x a ref (StockRowVector.rows x p))
    (agree:poolEq ref (run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead) [] (pullState (OB5.sig 44) raw))):
    run (backwards true 0) m a=run (WindowWalkCosts.firstUnpackTail ++ Rolling1588.reverse true 45 380) m ref:=by
  have e0 : backwards true 0 = Shadow20.MixedWindow425.reverse425Cut true := by
    unfold backwards
    rw [WindowWalkCosts.rev_zero, List.nil_append]
  rw [e0]
  apply innerTrue x good raw a ref m stage norm pair
  unfold stock Shadow20.MixedOrd425.stockRef425; exact agree
end ECDSAAdd.Entrant.StairPacket.StockBackWindow

