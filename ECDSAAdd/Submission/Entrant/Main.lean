private theorem readCells_drop15E (sh : IntegerPacket.Shape) (a n d : Nat) (b : BasisState) (h : d ≤ n) :
    (readCells sh a n b).drop d = readCells sh (a + d) (n - d) b := by
  induction d generalizing a n with
  | zero => simp
  | succ d ih =>
    cases n with
    | zero => omega
    | succ n =>
      simp only [readCells, List.drop_succ_cons, Nat.succ_sub_succ_eq_sub]
      rw [ih (a + 1) n (by omega), Nat.add_assoc, Nat.add_comm 1 d]

private theorem readCells_getD15E (sh : IntegerPacket.Shape) (a n k : Nat) (b : BasisState) (h : k < n) :
    (readCells sh a n b)[k]?.getD (false, false) = cell sh (a + k) b := by
  induction k generalizing a n with
  | zero =>
    cases n with
    | zero => omega
    | succ n => simp [readCells]
  | succ k ih =>
    cases n with
    | zero => omega
    | succ n =>
      simp only [readCells, List.getElem?_cons_succ]
      rw [ih (a + 1) n (by omega), Nat.add_assoc, Nat.add_comm 1 k]

theorem native_raw_read15E (j : Fin 4) (s : State) (i : Fin 157) (hi : i.val < 20) :
    s.basis (nativeRawPort15E j ⟨i, hi⟩) =
