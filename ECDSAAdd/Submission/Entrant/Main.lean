  have away (q : Wire) (hq : q∈[L.parity]++L.y++L.carry) :
      q∉L.low ∧ q≠L.rmsb ∧ q≠L.lower ∧ q≠L.one := by
    have h := List.nodup_iff_count.mp (BalancedCircuit.allND L hn) q
