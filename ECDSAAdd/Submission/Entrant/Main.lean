theorem raw_to_fold (retired : Wire) (L : Layout) (hw : L.Widths)
    (hn : L.wires.Nodup) (member : retired∈L.carry.take 254)
    (origin : BasisState) (T Y : Int) (ht : -(2*q)≤T ∧ T≤2*q) :
