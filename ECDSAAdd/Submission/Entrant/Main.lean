  have a := mappedAdd_counts (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one bits carry
  have b := mappedSub_counts (ShortBiasedFold.lowBits L) L.low (L.carry.take 254) L.one bits carry
  rw [lowlen] at a b
