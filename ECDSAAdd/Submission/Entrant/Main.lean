def releasedSite15E (j : Fin 4) (q : Nat) : Prop :=
  (q = start15E j + 31 + railP (start15E j + 15)) ∨
  (785 + railP (start15E j + 15) < q ∧ q ≤ 785 + railP (start15E j)) ∨
  (1301 ≤ q ∧ q ≤ 1058 + start15E j)

def leftovers15E (j : Fin 4) (q : Wire) : Prop :=
  (start15E j + 15 ≤ q ∧ q < start15E j + 31) ∨
  (1044 + start15E j ≤ q ∧ q < 1059 + start15E j) ∨
  releasedSite15E j q ∨
  (2055 ≤ q + start15E j ∧ q + start15E j ≤ 2069 ∧ q ≤ 1812)

private theorem pool_origin15E {s prevLen x p : Nat} (hprev : prevLen ≤ s)
    (limit : s + 15 ≤ 512) (good : Bounds x p) (raw history : State) (dom : Domain s x p raw)
    (q : Nat) (hq1 : s + 15 + 16 ≤ q) (hq2 : q < 1044)
    (rel : q ∈ (W.compactSkywalkSignPoolA base (s + 15)).released ∨
           q ∈ (W.compactSkywalkSignPoolB base (s + 15)).released) :
    (Shadow20.WideReference20.origin s prevLen 15 raw history).basis q = false := by
  have ident : OB5.sig (s + 14) q = q := by unfold OB5.sig; rw [if_neg (by unfold Wire; omega)]
  have clear : q ∉ Shadow20.WideReference20.sites s prevLen 15 := by
    intro hit; have old := (Shadow20.WideReference20.mem_sites (by omega) q).mp hit
    rw [show s + 15 - 1 = s + 14 by omega, ident] at old
    obtain ⟨r, _, lt, h | h⟩ := Shadow20.WideReference20.old_cell old <;> omega
  rw [Shadow20.WideReference20.outside s prevLen 15 raw history q clear, show s + 15 - 1 = s + 14 by omega, ident]
  obtain ⟨ref, coh, valid⟩ := dom
  have stepCoh := coherent_span s 15 limit raw ref coh []
  have stepVal := full_span s 15 x p limit good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime ref [] valid
  have notE : ¬ Earlier (s + 15) q := by rintro ⟨r, hr, h | h⟩ <;> simp only [base, Wire] at * <;> omega
  rw [stepCoh.2 q notE]; rcases rel with rA | rB; exact stepVal.2.1 q rA; exact stepVal.2.2 q rB

private theorem band_origin15E {s prevLen x p : Nat} (hprev : prevLen ≤ s)
    (limit : s + 15 ≤ 512) (good : Bounds x p) (raw history : State) (dom : Domain s x p raw)
    (q : Nat) (low : 1301 ≤ q) (high : q ≤ 1044 + (s + 14)) :
    (Shadow20.WideReference20.origin s prevLen 15 raw history).basis q = false := by
  have map : OB5.sig (s + 14) q = (3113 - q : Nat) := by unfold OB5.sig; rw [if_pos (by unfold Wire; omega)]
  have clear : q ∉ Shadow20.WideReference20.sites s prevLen 15 := by
    intro hit; have old := (Shadow20.WideReference20.mem_sites (by omega) q).mp hit
    rw [show s + 15 - 1 = s + 14 by omega, map] at old
    obtain ⟨r, _, lt, h | h⟩ := Shadow20.WideReference20.old_cell old <;> omega
  rw [Shadow20.WideReference20.outside s prevLen 15 raw history q clear, show s + 15 - 1 = s + 14 by omega, map]
  exact full_carry s 15 x p limit good raw dom [] _ (by omega) (by omega)

theorem releasedOrigin15E (j : Fin 4) (x p : Nat) (good : Bounds x p) (raw history : State)
    (dom : Domain (start15E j) x p raw) (q : Nat) (site : releasedSite15E j q) :
    (Shadow20.WideReference20.origin (start15E j) (prevLen15E j) 15 raw history).basis q = false := by
  have hg := geom15E_facts j; dsimp only at hg
  have hw := width15E j; unfold W.compactSkywalkTickPreWidth at hw
  have hR : railP (start15E j + 15) < railP (start15E j) ∧ railP (start15E j) ≤ 258 := by
    have : ∀ r : Fin 4, railP (start15E r + 15) < railP (start15E r) ∧ railP (start15E r) ≤ 258 := by decide +kernel
    exact this j
  have hprev : prevLen15E j ≤ start15E j := by unfold prevLen15E; split_ifs <;> omega
  unfold releasedSite15E at site
  rcases site with rfl | ⟨lo, hi⟩ | ⟨lo, hi⟩
  · exact pool_origin15E hprev (by omega) good raw history dom _ (by omega) (by omega)
      (Or.inl (poolA_released _ _ (by omega) (by omega) (by omega)))
  · exact pool_origin15E hprev (by omega) good raw history dom _ (by omega) (by omega)
      (Or.inr (poolB_released _ _ (by omega) (by omega) (by omega)))
  · exact band_origin15E hprev (by omega) good raw history dom q lo (by omega)

