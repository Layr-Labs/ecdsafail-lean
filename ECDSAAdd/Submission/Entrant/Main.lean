  have rawX_x1N : ∀ q ∈ wires (renameProgram Stair44Kernel.rawX (ParityXExitInverse23Kernel.x1N k)), q ∉ fieldR := by
    have pi_fix : ∀ q ∈ fieldR, ParityXExitInverse23Kernel.pi q = q := fun q hq =>
