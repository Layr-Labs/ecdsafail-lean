private theorem k9_code_scratch_all : (List.finRange 134).all (fun k =>
    decide (ArchiveJ20.codePorts k9 ⟨16 + k.val, by omega⟩ = (ArchiveJ20.scratch k9).getD k.val 0)) = true := by
  decide +kernel

private theorem prev15E_nextTick_eq : ∀ r : Fin 4, r.val ≠ 0 →
    ArchiveJ15E.nextTick (prev15E r) = start15E r := by
  decide +kernel

private theorem prevScratch_code15E (r : Fin 4) {w : Wire} (hw : w ∈ prevScratch15E r) :
    ∃ k : Fin 134, prevCodePorts15E r ⟨16 + k.val, by omega⟩ = w := by
  unfold prevScratch15E at hw
  unfold prevCodePorts15E
  split_ifs at hw ⊢ with h0
  · obtain ⟨idx, hidx, rfl⟩ := List.mem_iff_getElem.mp hw
    have hlen : (ArchiveJ20.scratch k9).length = 134 := by simp [ArchiveJ20.scratch]
    refine ⟨⟨idx, hlen ▸ hidx⟩, ?_⟩
    have eq := of_decide_eq_true (List.all_eq_true.mp k9_code_scratch_all ⟨idx, hlen ▸ hidx⟩ (List.mem_finRange _))
    simpa only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hidx, Option.getD_some] using eq
  · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hw
    rw [List.mem_range] at hk
    refine ⟨⟨k, hk⟩, ?_⟩
    have hs := ArchiveJ15E.code_scratch (prev15E r) hk
    have hnt := prev15E_nextTick_eq r h0
    simpa only [ArchiveJ15E.codePorts, hnt] using hs

private theorem prevScratch_geom15E : ∀ r : Fin 4, (prevScratch15E r).all (fun w =>
    decide ((1556 ≤ (w : Nat) ∧ (w : Nat) ≤ 1812) ∨
