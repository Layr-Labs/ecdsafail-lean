      exact ⟨rr,c,ArchiveWindowPreserve.keep kept (fun q hq=>leaves22.keepOlder i k i' hk (by omega) (by omega)
        (by have h:k.val ≤ 24:=(WindowParams7.mem_rest22 hm).2; exact h) d q hq s n)⟩)
    lastC
