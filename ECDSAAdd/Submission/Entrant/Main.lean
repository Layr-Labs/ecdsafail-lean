/-! ## Field 13 on v3 -/

/-- Logical prefix of the division kernel before position `j`. -/
def entryCut (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan) (j : Nat) :
    Program :=
  (((entryPieces p h).take j).map Piece.L).flatten

/-- Logical prefix of the multiplication kernel before position `j`. -/
def exitCut (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan) (k j : Nat) :
    Program :=
  (((exitPieces p h k).take j).map Piece.L).flatten

/-- The only facts field 13 needs on v3 (all about the LOGICAL kernels): at
every position, the wires moved by the hosting there are zero at the logical
cut before and after it.  Only the 8 hosted slots have non-empty `moved`;
`entrySlotsClean_of` / `exitSlotsClean_of` reduce this to the named per-slot
facts `EntrySlots` / `ExitSlots`. -/
def EntrySlotsClean (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (pre : State → Prop) : Prop :=
  ∀ j (hj : j < (entryPieces p h).length),
    CutClean pre (entryCut p h j) ((entryPieces p h)[j]).moved ∧
      CutClean pre (entryCut p h (j + 1)) ((entryPieces p h)[j]).moved

def ExitSlotsClean (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (k : Nat) (pre : State → Prop) : Prop :=
  ∀ j (hj : j < (exitPieces p h k).length),
    CutClean pre (exitCut p h k j) ((exitPieces p h k)[j]).moved ∧
      CutClean pre (exitCut p h k (j + 1)) ((exitPieces p h k)[j]).moved

theorem entry_sameTape (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (pre : State → Prop) (c : EntrySlotsClean p h pre) :
    ∀ s, pre s → ∀ m : List Bool,
      run (StairHostsSchedule.entryKernel p h) m s =
        run (StairSchedule.entryKernel p StairConcrete.bestLoans) m s := by
  intro s hs m
  rw [← entryPieces_hosted p h, ← entryPieces_logical p h]
  exact run_eq_of_index pre _ (entryPieces_local p h) c s hs m

theorem exit_sameTape (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (k : Nat) (pre : State → Prop) (c : ExitSlotsClean p h k pre) :
    ∀ s, pre s → ∀ m : List Bool,
      run (StairHostsSchedule.exitKernel p h k) m s =
        run (StairSchedule.exitKernel p StairConcrete.bestLoans k) m s := by
  intro s hs m
  rw [← exitPieces_hosted p h k, ← exitPieces_logical p h k]
  exact run_eq_of_index pre _ (exitPieces_local p h k) c s hs m

open StairConcreteAssembly in
/-- **Field 13 on CANON v3** from the slot cleanliness facts of the logical
kernels and field 7 (tape freedom of the logical kernel). -/
theorem hostReplaySpec_of_slots
    (entry : EntrySlotsClean checkpointPrimitives hostPlan EntryPre)
    (exit : ∀ k, ExitSlotsClean checkpointPrimitives hostPlan k (ExitPre k))
    (loan : StairCertificate.LoanReplaySpec concreteAssembly) :
    StairCertificate.HostReplaySpec concreteAssembly := by
  unfold StairCertificate.HostReplaySpec
  refine ⟨fun s hs fresh old => ?_, fun k s hs fresh old => ?_⟩
  · have hs' : EntryPre s := hs
    show run (StairHostsSchedule.entryKernel checkpointPrimitives hostPlan) fresh s =
      run (StairSchedule.entryKernel checkpointPrimitives StairConcrete.bestLoans) old s
    rw [entry_sameTape checkpointPrimitives hostPlan EntryPre entry s hs' fresh]
    exact ((loan 0).entry s hs fresh []).trans ((loan 0).entry s hs old []).symm
  · have hs' : ExitPre k s := hs
    show run (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) fresh s =
      run (StairSchedule.exitKernel checkpointPrimitives StairConcrete.bestLoans k) old s
    rw [exit_sameTape checkpointPrimitives hostPlan k (ExitPre k) (exit k) s hs' fresh]
    exact ((loan k).exit s hs fresh []).trans ((loan k).exit s hs old []).symm

/-! ## Named per-slot obligations (the hypotheses published for field 2 owners)

Position numbers refer to `entryPieces` / `exitPieces`; `entryCut p h j` is the
logical division kernel up to (excluding) position `j`.  For the concrete plan
the deficit-44 slots move nothing (`hostPlan_group44_moved`). -/

/-- Division kernel: the first packet (position 1) and the six hosted groups
at deficits 0, 14, 23, 31, 37, 42 (positions 3, 5, 7, 9, 11, 13); the moved
wires are zero at the logical cut before and after each. -/
structure EntrySlots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (pre : State → Prop) : Prop where
  first : CutClean pre (entryCut p h 1) (firstSlot h true).moved ∧
    CutClean pre (entryCut p h 2) (firstSlot h true).moved
  g0 : CutClean pre (entryCut p h 3) (groupSlot h true 0 1 84).moved ∧
    CutClean pre (entryCut p h 4) (groupSlot h true 0 1 84).moved
  g14 : CutClean pre (entryCut p h 5) (groupSlot h true 14 85 5).moved ∧
    CutClean pre (entryCut p h 6) (groupSlot h true 14 85 5).moved
  g23 : CutClean pre (entryCut p h 7) (groupSlot h true 23 90 3).moved ∧
    CutClean pre (entryCut p h 8) (groupSlot h true 23 90 3).moved
  g31 : CutClean pre (entryCut p h 9) (groupSlot h true 31 93 3).moved ∧
    CutClean pre (entryCut p h 10) (groupSlot h true 31 93 3).moved
  g37 : CutClean pre (entryCut p h 11) (groupSlot h true 37 96 2).moved ∧
    CutClean pre (entryCut p h 12) (groupSlot h true 37 96 2).moved
  g42 : CutClean pre (entryCut p h 13) (groupSlot h true 42 98 2).moved ∧
    CutClean pre (entryCut p h 14) (groupSlot h true 42 98 2).moved
  g44 : CutClean pre (entryCut p h 17) (groupSlot h true 44 100 2).moved ∧
    CutClean pre (entryCut p h 18) (groupSlot h true 44 100 2).moved

/-- Multiplication kernel: groups at deficits 44, 42, 37, 31, 23, 14, 0
(positions 7, 11, 13, 15, 17, 19, 21) and the first packet (position 23). -/
structure ExitSlots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (k : Nat) (pre : State → Prop) : Prop where
  g44 : CutClean pre (exitCut p h k 7) (groupSlot h false 44 100 2).moved ∧
    CutClean pre (exitCut p h k 8) (groupSlot h false 44 100 2).moved
  g42 : CutClean pre (exitCut p h k 11) (groupSlot h false 42 98 2).moved ∧
    CutClean pre (exitCut p h k 12) (groupSlot h false 42 98 2).moved
  g37 : CutClean pre (exitCut p h k 13) (groupSlot h false 37 96 2).moved ∧
    CutClean pre (exitCut p h k 14) (groupSlot h false 37 96 2).moved
  g31 : CutClean pre (exitCut p h k 15) (groupSlot h false 31 93 3).moved ∧
    CutClean pre (exitCut p h k 16) (groupSlot h false 31 93 3).moved
  g23 : CutClean pre (exitCut p h k 17) (groupSlot h false 23 90 3).moved ∧
    CutClean pre (exitCut p h k 18) (groupSlot h false 23 90 3).moved
  g14 : CutClean pre (exitCut p h k 19) (groupSlot h false 14 85 5).moved ∧
    CutClean pre (exitCut p h k 20) (groupSlot h false 14 85 5).moved
  g0 : CutClean pre (exitCut p h k 21) (groupSlot h false 0 1 84).moved ∧
    CutClean pre (exitCut p h k 22) (groupSlot h false 0 1 84).moved
  first : CutClean pre (exitCut p h k 23) (firstSlot h false).moved ∧
    CutClean pre (exitCut p h k 24) (firstSlot h false).moved

theorem entryPieces_length (p : StairSchedule.StairPrimitives)
