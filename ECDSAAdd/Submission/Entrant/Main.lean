    m.tail.tail (run [.measureX a [] [.Z p,.CZ p h,.Z d]] m.tail s₁)=_
  rw [second]
  change run [.measureX u [] [.CZ j b],.CCX j p u]
    m.tail.tail.tail (run [.measureX d [] [.CZ p u]] m.tail.tail s₂)=_
