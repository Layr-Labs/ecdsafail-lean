      TickCut.Tail.selected14_eq, TickCut.Tail.sel01, List.flatten_cons, List.flatten_nil, List.append_nil,
      List.append_assoc]
  rw [hfe, hre]
  intro s m ⟨hr, hs⟩
  obtain ⟨ph, post, undo⟩ := step s m hr
  refine ⟨ph, ⟨post, fun b hb => ?_⟩, undo⟩
  by_cases he : b.val = n
  · have hbeq : b = bNew := Fin.ext (he.trans hbn.symm)
