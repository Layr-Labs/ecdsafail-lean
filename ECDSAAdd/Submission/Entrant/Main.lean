structure Numeric15E (j : Fin 4) (z : SkywalkNat.State) : Prop where
  odd : z.v % 2 = 1
  farSmall : Shadow7.SmallIfFar (sb15E (start15E j)) 15 z
  endSmall : Shadow7.EndSmall (sb15E (start15E j)) z
  nextFarSmall : Shadow7.SmallIfFar (sb15E (start15E j + 15)) 15 (step^[15] z)
  room : Shadow.high (sb15E (start15E j)) 15 z + 1 < 2 ^ wp15E (start15E j)
  adjTight : Shadow.high (sb15E (start15E j)) 15 z + 1 < 2 ^ adjW15E (start15E j)
  fit : TrueMiddle15E.F j z < 2 ^ liveW15E (start15E j)

theorem actualNumbers15E (j : Fin 4) (x p : Nat) (good : Bounds x p) :
    Numeric15E j (unsigned (start15E j) x p) := by
  have hg := geom15E_facts j
  have hx : x < 2 ^ 256 := lt_trans good.small good.cap
  have hgeo : wp15E (start15E j) + (sb15E (start15E j) + 15) = 513 - start15E j ∧
      2 ≤ wp15E (start15E j) ∧
      liveW15E (start15E j) + sb15E (start15E j) = 512 - (start15E j + 15) ∧
      257 ≤ start15E j ∧ start15E j ≤ 510 ∧ sb15E (start15E j) + 15 < 511 - start15E j ∧
      adjW15E (start15E j) + (sb15E (start15E j) + 15) = 512 - start15E j := by
    have : ∀ r : Fin 4, wp15E (start15E r) + (sb15E (start15E r) + 15) = 513 - start15E r ∧
        2 ≤ wp15E (start15E r) ∧
        liveW15E (start15E r) + sb15E (start15E r) = 512 - (start15E r + 15) ∧
        257 ≤ start15E r ∧ start15E r ≤ 510 ∧ sb15E (start15E r) + 15 < 511 - start15E r ∧
        adjW15E (start15E r) + (sb15E (start15E r) + 15) = 512 - start15E r := by decide +kernel
