namespace ECDSAAdd.Entrant.Stair44MultiplyCut
open Arithmetic MappedCompressed Secp256k1
open StairConcreteAssembly StairField13V3 StairField13V3Clean
open StairField2V3Replay StairField2V3Delta StairField2V3Couple StairField2V3Entry
open StairField2V3ExitPlan StairField2V3ExitPlanR StairField2V3Final
open StairLoanField7Transport StairLoanField7R StairLoanExitReachX
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
attribute [local irreducible] run wires renameProgram

def lastRows := (XS21 ++ grpFL StairConcrete.bestLoans 0 1 84) ++ lowTail

private theorem reached (k x : Nat) :
    ∃ Q, CRel (XPreX k x) (RowRelL k x 87 (YFL StairConcrete.bestLoans)) lastRows Q := by
  obtain ⟨Q,h⟩ := rch21 k x (StairOpenWiring.exitPlans k x) StairOpenWiring.half760
  have next := sharedL k x 87 (grpFL StairConcrete.bestLoans 0 1 84) ZE
    (away_of_sub _ _ _ exitGroupSub_best.2.2.2.2.2 (grpF_away 87 (by decide) 1 84 (by decide)))
  exact ⟨_,crel_append (crel_append h next)
    (sharedL k x 87 lowTail (ZE ++ grpFL StairConcrete.bestLoans 0 1 84) low_away)⟩

theorem recover (k x : Nat) (u : State) (hp : ExitMiddleX k x u) (rows unpack : List Bool) :
    let a := run (closeSel cp) unpack (run lastRows rows u)
    ∃ (s1 : State) (enc : List Bool),
      W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis ∧
      pullState Rolling1588Lifetime.phaseHost a = run (Rolling1588TickGap.forward true 1 424) enc s1 := by
  obtain ⟨Q,h⟩ := reached k x
  obtain ⟨old,rel,ref⟩ := h u u ⟨hp,rfl⟩ rows
  have ordinary := (exitReachTransportR_best StairOpenWiring.half760 k x).f _ ref
  obtain ⟨t0,c,adm,eq⟩ := StairField2V3ExitRecClose.closeRec_of
    StairField2V3JuncSel2.ExtraSel StairField2V3JuncSel2.extraSel_genuine k x _ ordinary
  rw [eq] at rel
  have before := relX_unique x 87 _ _ _ rel (StairField2V3JuncSel2.junc x t0 adm [] c)
  have back := StairField2V3JuncSel2.firstTrip_sel x t0 adm [] unpack
  dsimp only
  rw [before,back]
  exact adm.2.2.2

def beforeClose (h : StairHostsSchedule.HostPlan) :=
  exitReferenceOpening ++ StairHostsSchedule.exitFieldHosted cp h

theorem selected (k : Nat) (h : StairHostsSchedule.HostPlan) :
    (((exitPieces cp h k).take 24).map Piece.H).flatten = beforeClose h := by
  simp only [exitPieces,List.take_succ_cons,List.take_zero,groupSlot,firstSlot,lowCommon,common,
    List.map_cons,List.map_nil,List.flatten_cons,List.flatten_nil,List.append_nil,beforeClose,
    exitReferenceOpening,StairHostsSchedule.exitFieldHosted,StairHostsSchedule.exitLowPrefix,
    StairHostsSchedule.exitHeadPrefix,StairHostsSchedule.exitLowSuffix,StairHostsSchedule.exitHeadSuffix,
    StairHostsSchedule.hostedEndpoint,fieldRename_append,rename_append,List.append_assoc]

theorem logical (k : Nat) :
    (((exitPieces cp hostPlan k).take 24).map Piece.L).flatten = exitReferenceOpening ++ lastRows := by
  change cut (xps k) 24=_
  rw [cut_succ (xps k) 23 (xL k 23 (by decide)),xcut23]
  change (exitReferenceOpening ++ XS23) ++ StairSchedule.fieldRename (Rolling1588.placedFirstPacket false)=_
  simp only [XS23,lastRows,lowTail,fieldRename_append,List.append_assoc]

theorem pool (k : Nat) {t : State} (F : ExitFrame k t) (m tail : List Bool) :
    let a := run (closeSel cp) tail (run (beforeClose hostPlan) m t)
    ∃ (s1 : State) (enc : List Bool),
      W.CompactSkywalkStage base (SkywalkRails.encode false false (F.x:Int) (p:Int)) 1 s1.basis ∧
      pullState Rolling1588Lifetime.phaseHost a = run (Rolling1588TickGap.forward true 1 424) enc s1 := by
  have bridge := Stair44HostedCut.exit k 24 t ⟨F⟩ m
  change run (((exitPieces cp hostPlan k).take 24).map Piece.H).flatten m t =
    run (((exitPieces cp hostPlan k).take 24).map Piece.L).flatten m t at bridge
  rw [selected,logical,run_append exitReferenceOpening lastRows] at bridge
  dsimp only
  rw [bridge]
  exact recover k F.x _ ⟨t,F,rfl,_,rfl⟩ _ tail

private theorem firstTrip_head_sel (x : Nat) : ∀ t0, Adm StairField2V3JuncSel2.ExtraSel x t0 → ∀ c a,
    ∃ c12, pullState Rolling1588Lifetime.phaseHost
      (run (renameProgram Rolling1588Lifetime.phaseHost StairPacket.WindowWalkCosts.firstUnpackHead) a
        (run (selJ0 cp) c t0)) =
      run StairPacket.WindowWalkCosts.firstPackHead c12 (pullState Rolling1588Lifetime.phaseHost t0) := by
  rintro t0 ⟨hx0, hx, hE, s1, m, first, ht⟩ c a
  have spec := StairCodecFunctionalV3.codecFunctionalSpec 87 (StairField2V3Unpack.budget_mem_checkpoints 87
    StairPhysicalPhase.budget87_mem)
  have chain := StairExitLT24.firstPieces_chain base_pool_nodup
    (pullState Rolling1588Lifetime.phaseHost t0)
    (fun c1 => (StairField2V3JuncSel2.traj x hx0 hx s1 first m t0 ht hE c1 [] [] []).2.2.2.2.1)
    (fun c1 c2 c3 => (StairField2V3JuncSel2.traj x hx0 hx s1 first m t0 ht hE c1 c2 c3 []).2.2.2.2.2) spec
  have hsel : selJ0 cp = renameProgram Rolling1588Lifetime.phaseHost cp.firstPack := rfl
  rw [hsel, run_rename _ Rolling1588Lifetime.phaseHost.injective, run_rename _ Rolling1588Lifetime.phaseHost.injective,
    StairPacket.WindowWalkCosts.firstPack_split]
  let x0 := pullState Rolling1588Lifetime.phaseHost t0
  let c12 := c.take (measurementCount StairPacket.WindowWalkCosts.firstPackHead)
  let c34 := c.drop (measurementCount StairPacket.WindowWalkCosts.firstPackHead)
  let c1 := c12.take (measurementCount (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)))
  let c2 := c12.drop (measurementCount (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)))
  let c3 := c34.take (measurementCount StairPhysicalLayout.phaseBMove)
  let c4 := c34.drop (measurementCount StairPhysicalLayout.phaseBMove)
  let a1 := a.take (measurementCount (renameProgram StairPhysicalLayout.phaseRelabel (StairPhysicalPrimitives.unpack 87)))
  let a2 := a.drop (measurementCount (renameProgram StairPhysicalLayout.phaseRelabel (StairPhysicalPrimitives.unpack 87)))
  have hchain2 := (chain.2 c1).2 c2
  have hpack87 := (hchain2.2 c3).1 c4 a1
  have hphaseB := hchain2.1 c3 a2
  refine ⟨c12, ?_⟩
  simp only [StairPacket.WindowWalkCosts.firstPackHead, StairPacket.WindowWalkCosts.firstPackTail,
    StairPacket.WindowWalkCosts.firstUnpackHead, run_append] at hpack87 hphaseB ⊢
  change run StairPhysicalPhase.phaseBReturn a2
    (run (renameProgram StairPhysicalLayout.phaseRelabel (StairPhysicalPrimitives.unpack 87)) a1
      (run (renameProgram StairPhysicalLayout.phaseRelabel (StairPhysicalPrimitives.pack 87)) c4
        (run StairPhysicalLayout.phaseBMove c3
          (run (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) c2
            (run (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) c1 x0))))) =
    run (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) c2
      (run (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) c1 x0)
  rw [hpack87, hphaseB]

theorem recoverHead (k x : Nat) (u : State) (hp : ExitMiddleX k x u) (rows unpack : List Bool) :
    let a := run (renameProgram Rolling1588Lifetime.phaseHost StairPacket.WindowWalkCosts.firstUnpackHead) unpack (run lastRows rows u)
    ∃ (s1 : State) (enc : List Bool),
      W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis ∧
      pullState Rolling1588Lifetime.phaseHost a =
        run (Rolling1588TickGap.forward true 1 424 ++ StairPacket.WindowWalkCosts.firstPackHead) enc s1 := by
  obtain ⟨Q, h⟩ := reached k x
  obtain ⟨old, rel, ref⟩ := h u u ⟨hp, rfl⟩ rows
  have ordinary := (exitReachTransportR_best StairOpenWiring.half760 k x).f _ ref
  obtain ⟨t0, c, adm, eq⟩ := StairField2V3ExitRecClose.closeRec_of
    StairField2V3JuncSel2.ExtraSel StairField2V3JuncSel2.extraSel_genuine k x _ ordinary
  rw [eq] at rel
  have before := relX_unique x 87 _ _ _ rel (StairField2V3JuncSel2.junc x t0 adm [] c)
  obtain ⟨c12, back⟩ := firstTrip_head_sel x t0 adm [] unpack
  obtain ⟨s1, enc0, st, h0⟩ := adm.2.2.2
  refine ⟨s1, StairPacket.WindowFieldJourney.joinTapes (Rolling1588TickGap.forward true 1 424) enc0 c12, st, ?_⟩
  dsimp only
  rw [before, back, h0, StairPacket.WindowFieldJourney.joined]

theorem poolHead (k : Nat) {t : State} (F : StairConcreteAssembly.ExitFrame k t) (m tail : List Bool) :
    let a := run (renameProgram Rolling1588Lifetime.phaseHost StairPacket.WindowWalkCosts.firstUnpackHead) tail
      (run (beforeClose hostPlan) m t)
    ∃ (s1 : State) (enc : List Bool),
      W.CompactSkywalkStage base (SkywalkRails.encode false false (F.x:Int) (p:Int)) 1 s1.basis ∧
      pullState Rolling1588Lifetime.phaseHost a =
        run (Rolling1588TickGap.forward true 1 424 ++ StairPacket.WindowWalkCosts.firstPackHead) enc s1 := by
  have bridge := Stair44HostedCut.exit k 24 t ⟨F⟩ m
  change run (((exitPieces cp hostPlan k).take 24).map Piece.H).flatten m t =
    run (((exitPieces cp hostPlan k).take 24).map Piece.L).flatten m t at bridge
  rw [selected, logical, run_append exitReferenceOpening lastRows] at bridge
  dsimp only
  rw [bridge]
  exact recoverHead k F.x _ ⟨t, F, rfl, _, rfl⟩ _ tail

end ECDSAAdd.Entrant.Stair44MultiplyCut

