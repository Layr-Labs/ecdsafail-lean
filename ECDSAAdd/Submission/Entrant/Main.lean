import ECDSAAdd.Submission.Entrant.MainPre
-- ===== ECDSAAdd.Submission.Entrant.FlagMerge =====
section

/-! Flag merge on top of `FlagG`.

* While the generic-branch block runs, its control bit is held in
  `genericSelect`: `genFlagN` folds `(b ∧ finite) ⊕ D ⊕ H` into the
  inverse-point flag (the classes are exclusive, so the result is the generic
  bit), and the block runs with `core.generic` and `genericSelect` exchanged.
  The exception flag is cleared during this block. Its wire replaces pool site684.
  One shared Toffoli then restores the inverse flag and computes infinity.
* The infinity flag of the output stage (`FlagG` keeps it on `core.generic`)
  lives on pool site 514 instead: that stage is relabelled with
  `core.generic ↔ poolWire 514`.  The stage uses only the first 256 pool sites.

Neither `core.generic` nor `infinitySelect` is used. The shared pool also
excludes site 1800, which the short arithmetic copies do not use. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant
open Arithmetic MappedCompressed Secp256k1 ControlledPointLayout CompressedPointDialog

/-- Exchange of `core.generic` and `genericSelect`. -/
def tauM (L : ControlledPointLayout) (q : Wire) : Wire :=
  if q = L.core.generic then L.genericSelect else if q = L.genericSelect then L.core.generic else q

/-- The pool site that carries the output-stage infinity flag. -/
def parkWire (L : ControlledPointLayout) : Wire := L.core.poolWire 514

/-- Exchange of `core.generic` and the park site. -/
def sigP (L : ControlledPointLayout) (q : Wire) : Wire :=
  if q = L.core.generic then parkWire L else if q = parkWire L then L.core.generic else q

/-- A pool site used only by the generic block; it is relabelled onto
`equalNegY`, which is cleared while the block runs. -/
def spareWire (L : ControlledPointLayout) : Wire := L.core.poolWire 684

/-- Exchange of `equalNegY` and the spare site. -/
def swapE (L : ControlledPointLayout) (q : Wire) : Wire :=
  if q = L.core.equalNegY then spareWire L else if q = spareWire L then L.core.equalNegY else q

/-- `control ^= H`, `double ^= H`, then `H ^= ¬control ∧ double` clears `H`
(the exception class implies `b` and excludes the doubling class). -/
def foldH (L : ControlledPointLayout) : Program :=
  [.CX L.core.equalNegY L.control, .CX L.core.equalNegY L.doubleSelect, .X L.control,
   .CCX L.control L.doubleSelect L.core.equalNegY, .X L.control]

def unfoldH (L : ControlledPointLayout) : Program :=
  [.X L.control, .CCX L.control L.doubleSelect L.core.equalNegY, .X L.control,
   .CX L.core.equalNegY L.doubleSelect, .CX L.core.equalNegY L.control]

/-- `genericSelect ^= (b ∧ finite) ⊕ D ⊕ H`. -/
def genFlagN (L : ControlledPointLayout) : Program :=
  [.CCX L.control L.point.finite L.genericSelect, .CX L.doubleSelect L.genericSelect,
   .CX L.core.equalNegY L.genericSelect]

/-- Restore the inverse flag and compute infinity with one shared Toffoli. -/
def mergeFlagsN (L : ControlledPointLayout) : Program :=
  [.CX L.genericSelect (parkWire L), .CCX L.control L.point.finite L.genericSelect,
   .CX L.genericSelect (parkWire L), .CX L.control (parkWire L),
   .CX L.doubleSelect L.genericSelect, .CX L.core.equalNegY L.genericSelect]

/-- The output stage after the infinity flag has been computed. -/
def outTail (L : ControlledPointLayout) (C : Point) : Program :=
  corners2 L C ++ pairEqual L L.core.generic L.core.equalNegY true (exceptionBit C) C (-C)

/-- The output stage of `finiteProgramFG` that holds the infinity flag. -/
def outStage (L : ControlledPointLayout) (C : Point) : Program :=
  zeroFlag L.point.finite L.control L.core.generic ++ corners2 L C ++
  pairEqual L L.core.generic L.core.equalNegY true (exceptionBit C) C (-C)

namespace DHClass

/-- A bit index where two naturals below `2^256` differ (0 if equal). -/
def sepBit (a b : Nat) : Nat := ((List.range 256).find? (fun i => a.testBit i != b.testBit i)).getD 0

theorem sepBit_ne (a b : Nat) (ha : a < 2^256) (hb : b < 2^256) (h : a ≠ b) :
    a.testBit (sepBit a b) ≠ b.testBit (sepBit a b) := by
  have ex : ∃ i, i < 256 ∧ a.testBit i ≠ b.testBit i := by
    by_contra hn
    push_neg at hn
    apply h
    apply Nat.eq_of_testBit_eq
    intro i
    by_cases hi : i < 256
    · exact hn i hi
    · have h2 : 2^256 ≤ 2^i := Nat.pow_le_pow_right (by norm_num) (by omega)
      rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le ha h2), Nat.testBit_lt_two_pow (lt_of_lt_of_le hb h2)]
  obtain ⟨i, hi, hne⟩ := ex
  unfold sepBit
  cases hf : (List.range 256).find? (fun i => a.testBit i != b.testBit i) with
  | none =>
    exfalso
    have := List.find?_eq_none.mp hf i (List.mem_range.mpr hi)
    simp [hne] at this
  | some j =>
    have := List.find?_some hf
    simpa using this

theorem pointX_neg (R : Point) : pointX (-R) = pointX R := by
  cases R with
  | zero => rfl
  | some h => rw [WeierstrassCurve.Affine.Point.neg_some]; rfl

theorem sepBit_lt (a b : Nat) : sepBit a b < 256 := by
  unfold sepBit
  cases hf : (List.range 256).find? (fun i => a.testBit i != b.testBit i) with
  | none => simp
  | some j => simpa using List.mem_range.mp (List.mem_of_find?_eq_some hf)

theorem pointX_lt (R : Point) : pointX R < 2^256 :=
  (point_coordinates_lt R).1.trans (by norm_num [p])

/-- Classical constants of the class discriminator for the addend `C`. -/
def kx (C : Point) : Nat := sepBit (pointX C) (pointX (dialogExceptionPoint C))
def cxk (C : Point) : Bool := (pointX C).testBit (kx C)
def xb (R C : Point) : Bool := (pointX R).testBit (kx C)

theorem kx_lt (C : Point) : kx C < 256 := sepBit_lt _ _

open Classical in
theorem classify {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (b : Bool) (R : Point) :
    let C : Point := .some hc
    dialogDouble b R C = (decide (C ≠ -C) && b && pointFinite R && !dialogOrdinary b R C &&
      ((pointX R).testBit (kx C) == cxk C) && (yBit R == yBit C)) ∧
    dialogException b R C = (decide (dialogExceptionEnabled C) && b && pointFinite R &&
      !dialogOrdinary b R C && ((pointX R).testBit (kx C) != cxk C)) := by
  intro C
  have hC : C ≠ 0 := WeierstrassCurve.Affine.Point.some_ne_zero hc
  have finC : pointFinite C = true := rfl
  cases b with
  | false =>
    simp [dialogDouble, dialogException, dialogOrdinary, dialogInfinity, dialogInversePoint]
  | true =>
    by_cases h0 : R = 0
    · subst R
      have hG : dialogOrdinary true 0 C = false := by
        cases h : dialogOrdinary true 0 C
        · rfl
        · exact absurd ((dialogOrdinary_true true 0 C hC).mp h).2.1 (by simp)
      have hd : dialogDouble true 0 C = false := by
        unfold dialogDouble; rw [decide_eq_false (Ne.symm hC)]; simp
      have f0 : pointFinite 0 = false := rfl
      simp only [hd, hG, f0, dialogException_zero]
      simp
    by_cases h1 : R = C
    · subst R
      have hH : dialogException true C C = false := dialogException_self true C
      by_cases hk : C = -C
      · have hkd : decide (C ≠ -C) = false := decide_eq_false (fun h => h hk)
        have hd : dialogDouble true C C = false := by unfold dialogDouble; rw [hkd]; simp
        have hxx : (pointX C).testBit (kx C) = cxk C := rfl
        simp only [hH, hd, hkd, hxx]
        simp
      · have hkd : decide (C ≠ -C) = true := decide_eq_true hk
        have hd : dialogDouble true C C = true := by unfold dialogDouble; rw [hkd]; simp
        have hG : dialogOrdinary true C C = false := by
          cases h : dialogOrdinary true C C
          · rfl
          · exact absurd rfl ((dialogOrdinary_true true C C hC).mp h).2.2.1
        have hxx : (pointX C).testBit (kx C) = cxk C := rfl
        simp only [hd, hkd, hG, finC, hxx, hH]
        simp
    by_cases h2 : R = -C
    · subst R
      have hH : dialogException true (-C) C = false := dialogException_neg true C
      have hd : dialogDouble true (-C) C = false := by simp [dialogDouble, h1]
      have hy : yBit (-C) = !yBit C := yBit_neg hc
      have hxx : (pointX (-C)).testBit (kx C) = cxk C := by unfold cxk; rw [pointX_neg]
      simp [hH, hd, hy, hxx]
    by_cases h3 : R = dialogExceptionPoint C
    · have hen : dialogExceptionEnabled C := by
        unfold dialogExceptionEnabled; rw [← h3]; exact ⟨h0, h1, h2⟩
      have hH : dialogException true R C = true := by
        simp [dialogException, hen.1, hen.2.1, hen.2.2, h3]
      have hd : dialogDouble true R C = false := by simp [dialogDouble, h1]
      have hG : dialogOrdinary true R C = false := by
        cases h : dialogOrdinary true R C
        · rfl
        · exact absurd h3 ((dialogOrdinary_true true R C hC).mp h).2.2.2.2
      have finR : pointFinite R = true := by
        cases R with
        | zero => exact absurd rfl h0
        | some _ => rfl
      have xne : pointX R ≠ pointX C := by
        intro hx
        cases R with
        | zero => exact h0 rfl
        | some hr =>
          have := (sameX_iff_eq_or_neg hr hc).mp (by
            have hv : _ := hx
            simp only [pointX, coordinates, Option.getD_some] at hv
            exact ZMod.val_injective _ hv)
          rcases this with e|e
          · exact h1 e
          · exact h2 e
      have sep := sepBit_ne (pointX C) (pointX (dialogExceptionPoint C)) (pointX_lt _) (pointX_lt _)
        (by rw [← h3]; exact fun e => xne e.symm)
      have hx : (pointX R).testBit (kx C) ≠ cxk C := by
        unfold cxk kx; rw [h3]; exact fun e => sep e.symm
      have hx' : ((pointX R).testBit (kx C) != cxk C) = true := by simpa using hx
      have hen' : decide (dialogExceptionEnabled C) = true := decide_eq_true hen
      simp [hH, hd, hG, finR, hx', hen', hx]
    · have hG : dialogOrdinary true R C = true :=
        (dialogOrdinary_true true R C hC).mpr ⟨rfl, h0, h1, h2, h3⟩
      have hd : dialogDouble true R C = false := by simp [dialogDouble, h1]
      have hH : dialogException true R C = false := by simp [dialogException, h3]
      simp [hG, hd, hH]

end DHClass

namespace DHGadget

def flipIf (v : Bool) (w : Wire) : Program := if v then [.X w] else []

/-- `d ^= enD ∧ c ∧ f ∧ ¬g ∧ [xk = cx] ∧ [y0 = cy]` and `h ^= enH ∧ c ∧ f ∧ ¬g ∧ [xk ≠ cx]`,
with clean ancillas `a1 a2 a3` (restored). Self-inverse, measurement-free. -/
def gadget (c f g d h xk y0 a1 a2 a3 : Wire) (enD enH cx cy : Bool) : Program :=
  [.CCX c f a1, .X g, .CCX a1 g a2, .X g] ++
  ((if enD then
     flipIf (!cx) xk ++ [.CCX a2 xk a3] ++ flipIf (!cx) xk ++
     flipIf (!cy) y0 ++ [.CCX a3 y0 d] ++ flipIf (!cy) y0 ++
     flipIf (!cx) xk ++ [.CCX a2 xk a3] ++ flipIf (!cx) xk
   else []) ++
  ((if enH then flipIf cx xk ++ [.CCX a2 xk h] ++ flipIf cx xk else []) ++
  [.X g, .CCX a1 g a2, .X g, .CCX c f a1]))

set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
set_option linter.unnecessarySeqFocus false in
set_option linter.unusedSimpArgs false in
set_option maxHeartbeats 4000000 in
theorem gadget_run (c f g d h xk y0 a1 a2 a3 : Wire) (enD enH cx cy : Bool)
    (hn : [f,xk,y0,c,d,g,h,a1,a2,a3].Nodup) (s : State) (m : List Bool)
    (z1 : s.basis a1 = false) (z2 : s.basis a2 = false) (z3 : s.basis a3 = false) :
    run (gadget c f g d h xk y0 a1 a2 a3 enD enH cx cy) m s = ⟨s.phase, fun q =>
      if q = d then s.basis d ^^ (enD && s.basis c && s.basis f && !s.basis g &&
        (s.basis xk == cx) && (s.basis y0 == cy))
      else if q = h then s.basis h ^^ (enH && s.basis c && s.basis f && !s.basis g && (s.basis xk != cx))
      else s.basis q⟩ := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or] at hn
  obtain ⟨⟨n1,n2,n3,n4,n5,n6,n7,n8,n9⟩,⟨m1,m2,m3,m4,m5,m6,m7,m8⟩,⟨k1,k2,k3,k4,k5,k6,k7⟩,
    ⟨l1,l2,l3,l4,l5,l6⟩,⟨p1,p2,p3,p4,p5⟩,⟨q1,q2,q3,q4⟩,⟨r1,r2,r3⟩,⟨t1,t2⟩,t3,-⟩ := hn
  have n1' := Ne.symm n1
  have n2' := Ne.symm n2
  have n3' := Ne.symm n3
  have n4' := Ne.symm n4
  have n5' := Ne.symm n5
  have n6' := Ne.symm n6
  have n7' := Ne.symm n7
  have n8' := Ne.symm n8
  have n9' := Ne.symm n9
  have m1' := Ne.symm m1
  have m2' := Ne.symm m2
  have m3' := Ne.symm m3
  have m4' := Ne.symm m4
  have m5' := Ne.symm m5
  have m6' := Ne.symm m6
  have m7' := Ne.symm m7
  have m8' := Ne.symm m8
  have k1' := Ne.symm k1
  have k2' := Ne.symm k2
  have k3' := Ne.symm k3
  have k4' := Ne.symm k4
  have k5' := Ne.symm k5
  have k6' := Ne.symm k6
  have k7' := Ne.symm k7
  have l1' := Ne.symm l1
  have l2' := Ne.symm l2
  have l3' := Ne.symm l3
  have l4' := Ne.symm l4
  have l5' := Ne.symm l5
  have l6' := Ne.symm l6
  have p1' := Ne.symm p1
  have p2' := Ne.symm p2
  have p3' := Ne.symm p3
  have p4' := Ne.symm p4
  have p5' := Ne.symm p5
  have q1' := Ne.symm q1
  have q2' := Ne.symm q2
  have q3' := Ne.symm q3
  have q4' := Ne.symm q4
  have r1' := Ne.symm r1
  have r2' := Ne.symm r2
  have r3' := Ne.symm r3
  have t1' := Ne.symm t1
  have t2' := Ne.symm t2
  have t3' := Ne.symm t3
  obtain ⟨ph, bs⟩ := s
  simp only at z1 z2 z3 ⊢
  cases enD <;> cases enH <;> cases cx <;> cases cy <;>
  · simp only [gadget, flipIf, if_true, if_false, Bool.not_true, Bool.not_false,
      Bool.false_eq_true, List.nil_append, List.append_nil, List.cons_append, List.singleton_append, run, writeBit]
    congr 1
    funext q
    by_cases e1 : q = d
    · rw [e1]; simp [Function.update_apply, *] <;> cases bs c <;> cases bs f <;> cases bs g <;>
        cases bs xk <;> cases bs y0 <;> simp_all
    by_cases e2 : q = h
    · rw [e2]; simp [Function.update_apply, *] <;> cases bs c <;> cases bs f <;> cases bs g <;>
        cases bs xk <;> simp_all
    simp [Function.update_apply, *] <;> (try split_ifs) <;> simp_all <;> cases bs c <;> cases bs f <;>
      cases bs g <;> cases bs xk <;> cases bs y0 <;> simp_all

theorem gadget_wires (c f g d h xk y0 a1 a2 a3 : Wire) (enD enH cx cy : Bool) (q : Wire)
    (hq : q ∈ wires (gadget c f g d h xk y0 a1 a2 a3 enD enH cx cy)) :
    q = c ∨ q = f ∨ q = g ∨ q = d ∨ q = h ∨ q = xk ∨ q = y0 ∨ q = a1 ∨ q = a2 ∨ q = a3 := by
  cases enD <;> cases enH <;> cases cx <;> cases cy <;>
    simp [gadget, flipIf, wires, Instr.wires] at hq <;> tauto

theorem gadget_counts (c f g d h xk y0 a1 a2 a3 : Wire) (enD enH cx cy : Bool) :
    toffoliCount (gadget c f g d h xk y0 a1 a2 a3 enD enH cx cy) ≤ 8 ∧
    measurementCount (gadget c f g d h xk y0 a1 a2 a3 enD enH cx cy) = 0 := by
  cases enD <;> cases enH <;> cases cx <;> cases cy <;>
    simp [gadget, flipIf, toffoliCount, measurementCount]

theorem gadget_gateSlots (c f g d h xk y0 a1 a2 a3 : Wire) (enD enH cx cy : Bool) :
    Challenge.gateSlots (gadget c f g d h xk y0 a1 a2 a3 enD enH cx cy) ≤ 30 := by
  cases enD <;> cases enH <;> cases cx <;> cases cy <;>
    simp [gadget, flipIf, Challenge.gateSlots, Challenge.instructionSlots]

theorem gadget_physical (c f g d h xk y0 a1 a2 a3 : Wire) (enD enH cx cy : Bool)
    (hn : [f,xk,y0,c,d,g,h,a1,a2,a3].Nodup) :
    GatePhysical (gadget c f g d h xk y0 a1 a2 a3 enD enH cx cy) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or] at hn
  intro i hi
  cases enD <;> cases enH <;> cases cx <;> cases cy <;>
    simp [gadget, flipIf] at hi <;> rcases hi with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
    simp_all [RecordedQuantum.PhysicalInstr, ProperGate, eq_comm]

end DHGadget

/-- Clears (and, applied again, restores) the doubling and exception flags from the point:
on the non-generic finite class the point is `C`, `-C` or `-(C+C)`; one abscissa bit and the
parity of `y` tell them apart. -/
def clrDH (L : ControlledPointLayout) (C : Point) (cy : Fp) : Program :=
  DHGadget.gadget L.control L.point.finite L.genericSelect L.doubleSelect L.core.equalNegY
    (L.point.x.getD (DHClass.kx C) 0) (yLow L) (L.core.poolWire 0) (L.core.poolWire 1) (L.core.poolWire 2)
    (decide (cy≠-cy)) (exceptionBit C) (DHClass.cxk C) (yBit C)

/-- A pool site used only by the generic block; it is relabelled onto `doubleSelect`,
which is cleared while the block runs. -/
def spareD (L : ControlledPointLayout) : Wire := L.core.poolWire 1540

/-- Exchange of `doubleSelect` and the second spare site. -/
def swapD (L : ControlledPointLayout) (q : Wire) : Wire :=
  if q = L.doubleSelect then spareD L else if q = spareD L then L.doubleSelect else q


def finiteProgramN (L : ControlledPointLayout) (C : Point) (cy : Fp) (Gen : Program) : Program :=
  inputClass L C cy ++
  genFlagN L ++ clrDH L C cy ++
  renameProgram (swapD L) (renameProgram (swapE L) (renameProgram (tauM L) Gen)) ++
  clrDH L C cy ++ mergeFlagsN L ++
  renameProgram (sigP L) (outTail L C) ++
  gatedShort L (decide (cy≠-cy)) L.doubleSelect (C+C) ++
  chainErase L.control L.point.finite L.genericSelect

def flagsN (L : ControlledPointLayout) : List Wire :=
  [L.doubleSelect, L.genericSelect, L.core.equalNegY]

def sitesN (L : ControlledPointLayout) : List Wire :=
  PointAddLayout.pointWires L.point ++ [L.control] ++ flagsN L ++ sharedPoolF L

def flagsG (L : ControlledPointLayout) : List Wire :=
  [L.doubleSelect, L.core.generic, L.core.equalNegY]

/-- Sites of the generic block: it never touches `genericSelect`. -/
def sitesG (L : ControlledPointLayout) : List Wire :=
  PointAddLayout.pointWires L.point ++ [L.control] ++ flagsG L ++ sharedPoolF L





section Tau
variable (L : ControlledPointLayout) (hn : L.wires.Nodup)
include hn

theorem generic_ne_select : L.core.generic ≠ L.genericSelect := by
  have sep := dialogFlag_separation L hn
  simp only [inPlaceFlags, List.nodup_cons, List.mem_cons, not_or] at sep
  tauto

theorem tauM_invol (q : Wire) : tauM L (tauM L q) = q := by
  have ne := generic_ne_select L hn
  unfold tauM
  by_cases h1 : q = L.core.generic
  · subst h1; simp [ne, ne.symm]
  · by_cases h2 : q = L.genericSelect
    · subst h2; simp [ne, ne.symm]
    · simp [h1, h2]

theorem tauM_injective : Function.Injective (tauM L) := by
  intro a b h
  have := congrArg (tauM L) h
  rwa [tauM_invol L hn, tauM_invol L hn] at this

omit hn in
theorem tauM_fix (q : Wire) (hq : q ∉ L.inPlaceFlags) : tauM L q = q := by
  have h1 : q ≠ L.core.generic := fun h => hq (by simp [h, inPlaceFlags])
  have h2 : q ≠ L.genericSelect := fun h => hq (by simp [h, inPlaceFlags])
  simp [tauM, h1, h2]

omit hn in
theorem tauM_flag (q : Wire) (hq : q ∈ L.inPlaceFlags) : tauM L q ∈ L.inPlaceFlags := by
  unfold tauM
  split_ifs
  · simp [inPlaceFlags]
  · simp [inPlaceFlags]
  · exact hq

theorem boundary_tau {R : Point} {b : Bool} {f s : BasisState} (v : PointDialogBoundary L R b f s) :
    PointDialogBoundary L R b (fun q => f (tauM L q)) (fun q => s (tauM L q)) :=
  v.withFlags hn (fun q hq => v.flags _ (tauM_flag L q hq)) (fun q hq => by rw [tauM_fix L q hq])

/-- The relabelled generic block, controlled by `genericSelect`. -/
theorem genericM_ok {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (Gen : Program)
    (hGen : GenericOK L hc Gen) (R : Point) (b : Bool) (f : BasisState)
    (hg : f L.genericSelect = true → R≠0 ∧ R≠(.some hc : Point) ∧ R≠-(.some hc : Point) ∧
      R≠dialogExceptionPoint (.some hc)) :
    Triple (PointDialogBoundary L R b f) (renameProgram (tauM L) Gen)
      (PointDialogBoundary L (if f L.genericSelect then R+.some hc else R) b f) := by
  intro s m v
  have tg : tauM L L.core.generic = L.genericSelect := by simp [tauM]
  have h := hGen R b (fun q => f (tauM L q)) (by intro e; apply hg; simpa only [tg] using e)
    (pullState (tauM L) s) m (boundary_tau L hn v)
  rw [← run_rename (tauM L) (tauM_injective L hn)] at h
  simp only [tg] at h
  refine ⟨h.1, ?_⟩
  have back := boundary_tau L hn h.2
  simp only [pullState, tauM_invol L hn] at back
  exact back

end Tau

section Park
variable (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
include hw hn

omit hn in
theorem park_pool : parkWire L ∈ L.dialogPool := by
  have h : parkWire L ∈ L.dialogPool.take 515 := by
    rw [pool_block L hw 515 (by omega)]
    simp [parkWire, wireBlock, List.mem_map, List.mem_range'_1]
    exact ⟨514, by omega, rfl⟩
  exact List.mem_of_mem_take h

theorem park_away : parkWire L ∉ PointAddLayout.pointWires L.point ∧ parkWire L ≠ L.control ∧
    parkWire L ∉ L.inPlaceFlags := by
  have used := List.nodup_iff_count.mp (L.dialogUsed_nodup hn) (parkWire L)
  have hp := List.count_pos_iff.mpr (park_pool L hw)
  simp only [dialogUsedWires, List.count_append] at used
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · have := List.count_pos_iff.mpr h; omega
  · have : 0 < List.count (parkWire L) [L.control] := List.count_pos_iff.mpr (by simp [h])
    omega
  · have := List.count_pos_iff.mpr h; omega

theorem park_ne_generic : parkWire L ≠ L.core.generic :=
  fun h => (park_away L hw hn).2.2 (by simp [h, inPlaceFlags])

theorem sigP_invol (q : Wire) : sigP L (sigP L q) = q := by
  have ne := park_ne_generic L hw hn
  unfold sigP
  by_cases h1 : q = L.core.generic
  · subst h1; simp [ne, ne.symm]
  · by_cases h2 : q = parkWire L
    · subst h2; simp [ne, ne.symm]
    · simp [h1, h2]

theorem sigP_injective : Function.Injective (sigP L) := by
  intro a b h
  have := congrArg (sigP L) h
  rwa [sigP_invol L hw hn, sigP_invol L hw hn] at this

/-- Relabelling the park site keeps the boundary when the generic flag is clear. -/
theorem boundary_sig {R : Point} {b : Bool} {f s : BasisState} (v : PointDialogBoundary L R b f s)
    (hf : f L.core.generic = false) :
    PointDialogBoundary L R b f (fun q => s (sigP L q)) := by
  have aw := park_away L hw hn
  have ng := park_ne_generic L hw hn
  have fix (q : Wire) (h1 : q ≠ L.core.generic) (h2 : q ≠ parkWire L) : sigP L q = q := by
    simp [sigP, h1, h2]
  have gpt : L.core.generic ∉ PointAddLayout.pointWires L.point := by
    intro h
    have used := List.nodup_iff_count.mp (L.dialogUsed_nodup hn) L.core.generic
    have a := List.count_pos_iff.mpr h
    have c : 0 < List.count L.core.generic L.inPlaceFlags := List.count_pos_iff.mpr (by simp [inPlaceFlags])
    simp only [dialogUsedWires, List.count_append] at used
    omega
  have hpt (q : Wire) (hq : q ∈ PointAddLayout.pointWires L.point) : sigP L q = q :=
    fix q (fun e => gpt (e ▸ hq)) (fun e => aw.1 (e ▸ hq))
  have hp := (point_holds _ _ _).mp v.point
  refine ⟨(point_holds _ _ _).mpr ⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · rw [hpt _ (by simp [PointAddLayout.pointWires])]; exact hp.1
  · rw [regValue_congr L.point.x _ s (fun q hq => by
      rw [hpt q (by simp [PointAddLayout.pointWires, hq])])]; exact hp.2.1
  · rw [regValue_congr L.point.y _ s (fun q hq => by
      rw [hpt q (by simp [PointAddLayout.pointWires, hq])])]; exact hp.2.2
  · have sep := dialogFlag_separation L hn
    have cg : L.control ≠ L.core.generic := by
      simp only [inPlaceFlags, List.nodup_cons, List.mem_cons, not_or] at sep; tauto
    show s (sigP L L.control) = b
    rw [fix _ cg (fun e => aw.2.1 e.symm)]; exact v.control
  · intro q hq
    show s (sigP L q) = f q
    by_cases hg : q = L.core.generic
    · subst hg
      simp only [sigP, if_true]
      rw [hf]
      exact (regValue_zero _ _).mp v.clean _ (park_pool L hw)
    · rw [fix q hg (fun e => aw.2.2 (e ▸ hq))]; exact v.flags q hq
  · apply (regValue_zero _ _).mpr
    intro q hq
    show s (sigP L q) = false
    by_cases hk : q = parkWire L
    · subst hk
      simp only [sigP, if_neg (park_ne_generic L hw hn), if_true]
      rw [v.flags _ (by simp [inPlaceFlags]), hf]
    · have hg : q ≠ L.core.generic := by
        intro e; subst e
        have used := List.nodup_iff_count.mp (L.dialogUsed_nodup hn) L.core.generic
        have a := List.count_pos_iff.mpr hq
        have c : 0 < List.count L.core.generic L.inPlaceFlags := List.count_pos_iff.mpr (by simp [inPlaceFlags])
        simp only [dialogUsedWires, List.count_append] at used
        omega
      rw [fix q hg hk]
      exact (regValue_zero _ _).mp v.clean q hq

theorem park_triple (X : Program) (R R' : Point) (b : Bool) (f f' : BasisState)
    (hf : f L.core.generic = false) (hf' : f' L.core.generic = false)
    (hX : Triple (PointDialogBoundary L R b f) X (PointDialogBoundary L R' b f')) :
    Triple (PointDialogBoundary L R b f) (renameProgram (sigP L) X) (PointDialogBoundary L R' b f') := by
  intro s m v
  have h := hX (pullState (sigP L) s) m (boundary_sig L hw hn v hf)
  rw [← run_rename (sigP L) (sigP_injective L hw hn)] at h
  refine ⟨h.1, ?_⟩
  have back := boundary_sig L hw hn h.2 hf'
  simp only [pullState, sigP_invol L hw hn] at back
  exact back

end Park

