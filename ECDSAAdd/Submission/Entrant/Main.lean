namespace ECDSAAdd.Entrant.StairPacket.WindowFieldCosts
open Arithmetic MappedCompressed Stair44Resources StairConcreteAssembly StairArchiveInactive
open StairArchiveRelease StairArchiveNativeCut StairArchiveTen StairArchiveGates
set_option maxRecDepth 14000
set_option maxHeartbeats 1600000
set_option linter.unusedSimpArgs false
attribute [local irreducible] toffoliCount measurementCount StairGroups.packet
  StairArchiveInactive.packet StairArchiveInactive.packetL fieldHook

def distributed (d : Bool) (j n : Nat) :=
  PacketSequence.program d (StairArchiveInactive.packet d) j n
private theorem ren (f : Wire → Wire) (a b : Program) : renameProgram f (a++b)=renameProgram f a++renameProgram f b := List.map_append
theorem distribute (d : Bool) (j n : Nat) :
    StairHostsSchedule.hostedGroup hostPlan d 0 j n = distributed d j n := by
  change StairLoan.rebindMany StairSchedule.exclusiveRoles (StairPhysicalLayout.hosts 87)
    (renameProgram (OB5.sig 511) (PacketSequence.program d (StairGroups.packet d 0) j n)) = _
  simp only [hosts_eq,distributed,renameProgram_comp]
  induction n generalizing j with
  | zero => rfl
  | succ n ih =>
    cases d <;> simp only [PacketSequence.program,if_true,if_false,Bool.false_eq_true,
      ren,ih,StairArchiveInactive.packet,hosts_eq,renameProgram_comp]

private theorem split (c : Cost) (d : Bool) (j n k : Nat) :
    c.measure (distributed d j (n+k)) =
    c.measure (distributed d j n) + c.measure (distributed d (j+n) k) := by
  unfold distributed
  induction n generalizing j with
  | zero =>
    simp only [Nat.zero_add,Nat.add_zero,PacketSequence.program]
    have z := c.append [] []
    simp only [List.nil_append] at z
    omega
  | succ n ih =>
    have rest := ih (j+1)
    have align : j+1+n=j+(n+1) := by omega
    rw [align] at rest
    cases d <;> simp only [Nat.succ_add,PacketSequence.program,Bool.false_eq_true,if_false,
      if_true,c.append] <;> omega

def group (d : Bool) (j n : Nat) := StairHostsSchedule.hostedGroup hostPlan d 0 j n

def ordered (d : Bool) (a b : Program) := if d then a++b else b++a

/-- packets 1..45 of the division kernel run our odd cell `slice45` (spariev's cell, ours
on dadon's window tree), hosted like the record packets; the multiplication kernel keeps the record group. -/
def cellGroup (d : Bool) : Program :=
  if d then StairLoan.rebindMany StairSchedule.exclusiveRoles (StairPhysicalLayout.hosts 87)
    (renameProgram (OB5.sig 511) ECDSAAdd.Entrant.RouteA.Rolling1588.slice45)
  else StairLoan.rebindMany StairSchedule.exclusiveRoles (StairPhysicalLayout.hosts 87)
    (renameProgram (OB5.sig 511) ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45)

/-- The three suffixes of the integer windows 225, 240, 255 start at field ticks 230, 245, 260. -/
def group84 (d : Bool) : Program :=
  ordered d (cellGroup d) (ordered d (ten 46 (!d)) (ordered d (group d 48 1)
    (ordered d (ten 49 (!d)) (ordered d (group d 51 1)
      (ordered d (ten 52 (!d)) (group d 54 31))))))

/-- the record first group (dadon's `group84`, record packets 1..45 on both kernels). It stays
the reference program of the window journey; only the actual program runs the cell. -/
def group84rec (d : Bool) : Program :=
  ordered d (group d 1 45) (ordered d (ten 46 (!d)) (ordered d (group d 48 1)
    (ordered d (ten 49 (!d)) (ordered d (group d 51 1)
      (ordered d (ten 52 (!d)) (group d 54 31))))))

/-- the part of the field group after packets 1..45 (common to `group84` and `group84rec`). -/
def c45_tail84 (d : Bool) : Program :=
  ordered d (ten 46 (!d)) (ordered d (group d 48 1)
    (ordered d (ten 49 (!d)) (ordered d (group d 51 1)
      (ordered d (ten 52 (!d)) (group d 54 31)))))

theorem c45_group84_split (d : Bool) : group84 d = ordered d (cellGroup d) (c45_tail84 d) := rfl
theorem c45_group84rec_split (d : Bool) : group84rec d = ordered d (group d 1 45) (c45_tail84 d) := rfl

/-- the tape on which the record packets 1..45 stand in for the cell: the cell's measurements
are skipped and the record packets read a zero padding (their run from a stock cut does not read it). -/
def cellTape (d : Bool) (m : List Bool) : List Bool :=
  if d then List.replicate (measurementCount (group true 1 45)) false ++ m.drop (measurementCount (cellGroup true))
  else m

theorem c45_cellTape_true (m : List Bool) : cellTape true m =
    List.replicate (measurementCount (group true 1 45)) false ++ m.drop (measurementCount (cellGroup true)) := by
  simp only [cellTape,if_true]
theorem c45_cellTape_false (m : List Bool) : cellTape false m = m := by
  simp only [cellTape,Bool.false_eq_true,if_false]

theorem c45_group_eq (d : Bool) (j n : Nat) : group d j n = StairLoan.rebindMany StairSchedule.exclusiveRoles
    (StairPhysicalLayout.hosts 87) (renameProgram (OB5.sig 511) (PacketSequence.program d (StairGroups.packet d 0) j n)) :=
  rfl

/-- the hosted cell only uses wires of the hosted record packets 1..45. -/
theorem c45_cell_sub : wires (cellGroup true) ⊆ wires (group true 1 45) := by
  have g := StairGroups.groups_zero true 1 45
  unfold StairGroups.groups at g
  rw [c45_group_eq,g]
  simp only [cellGroup,if_true,StairArchiveInactive.hosts_eq]
  exact StairLoanGroupSupport.rename_sub _ _ _
    (StairLoanGroupSupport.rename_sub _ _ _ StairLoanGroupSupport.c45_slice45_sub)

/-- the hosted multiplication cell only uses wires of the hosted record packets 45..1. -/
theorem c45_cell_subF : wires (cellGroup false) ⊆ wires (group false 1 45) := by
  have g := StairGroups.groups_zero false 1 45
  unfold StairGroups.groups at g
  rw [c45_group_eq,g]
  simp only [cellGroup,Bool.false_eq_true,if_false,StairArchiveInactive.hosts_eq]
  exact StairLoanGroupSupport.rename_sub _ _ _
    (StairLoanGroupSupport.rename_sub _ _ _ ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45_sub)

private theorem ord (c : Cost) (d : Bool) (a b : Program) :
    c.measure (ordered d a b)=c.measure a+c.measure b := by
  cases d <;> simp [ordered,c.append,Nat.add_comm]

/-- one window: the three hooks (195 Toffolis for d = true, 193 for d = false; 277 measurements) and its two packets at loan
depth 1 (20 Toffolis and 20 measurements each). -/
theorem overhead (j : Nat) (d : Bool) :
    toffoliCount (ten j (!d)) = toffoliCount (group d j 2)+(if d then 235 else 233) ∧
    measurementCount (ten j (!d)) = measurementCount (group d j 2)+317 := by
  have a := packetL_counts d j
  have b := packetL_counts d (j+1)
  rw [group,distribute]
  cases d <;>
    simp only [distributed,PacketSequence.program,Bool.not_true,Bool.not_false,ten,firstL,secondL,
      enter,shift,leave,fieldHook,program,if_true,if_false,Bool.false_eq_true,List.nil_append,
      List.append_nil,toffoliCount_append,measurementCount_append,(renameProgram_counts _ _).1,
      (renameProgram_counts _ _).2,enter0_toffoliCount,switch0_toffoliCount,leave0_toffoliCount,
      enter1_toffoliCount,switch1_toffoliCount,leave1_toffoliCount,enter0_measurementCount,
      switch0_measurementCount,leave0_measurementCount,enter1_measurementCount,
      switch1_measurementCount,leave1_measurementCount] <;> constructor <;> omega

private theorem partition (c : Cost) (d : Bool) :
    c.measure (group d 1 84) = c.measure (group d 1 45)+c.measure (group d 46 2)+
      c.measure (group d 48 1)+c.measure (group d 49 2)+c.measure (group d 51 1)+
      c.measure (group d 52 2)+c.measure (group d 54 31) := by
  simp only [group,distribute]
  have a := split c d 1 45 39
  have b := split c d 46 2 37
  have e := split c d 48 1 36
  have f := split c d 49 2 34
  have g := split c d 51 1 33
  have h := split c d 52 2 31
  norm_num only [] at a b e f g h
  omega

/-- every cost measure of the hosted cell is that of `slice45`. -/
theorem cell_measure (c : Cost) :
    c.measure (cellGroup true) = c.measure ECDSAAdd.Entrant.RouteA.Rolling1588.slice45 := by
  simp only [cellGroup, if_true, StairArchiveInactive.hosts_eq, c.rename]

/-- every cost measure of a hosted record group is that of the record group. -/
theorem group_measure (c : Cost) (d : Bool) (j n : Nat) :
    c.measure (group d j n) = c.measure (ECDSAAdd.Entrant.Rolling1588.groups d j n) := by
  rw [group, distribute]
  unfold distributed ECDSAAdd.Entrant.Rolling1588.groups
  induction n generalizing j with
  | zero => rfl
  | succ n ih =>
    cases d <;> simp only [PacketSequence.program, if_true, if_false, Bool.false_eq_true, c.append, ih,
      StairArchiveInactive.packet, StairArchiveInactive.hosts_eq, c.rename, StairGroups.packet_zero]

private theorem gm_cell (c : Cost) (s : Nat) (f : Program → Nat) (hf : c.measure = f)
    (h : f ECDSAAdd.Entrant.RouteA.Rolling1588.slice45 + s = f (ECDSAAdd.Entrant.Rolling1588.groups true 1 45)) :
    c.measure (cellGroup true) + s = c.measure (group true 1 45) := by
  rw [cell_measure, group_measure, hf]; exact h

/-- the division field group with the odd cell on packets 1..45. -/
private theorem solveCell (c : Cost) (d : Bool) (delta s : Nat)
    (h : ∀j,c.measure (ten j (!d))=c.measure (group d j 2)+delta)
    (hc : c.measure (cellGroup d) + s = c.measure (group d 1 45)) :
    c.measure (group84 d) + s = c.measure (group d 1 84)+3*delta := by
  simp only [group84,ord,h,partition]
  omega

theorem group_cost_div :
    toffoliCount (group84 true) = toffoliCount (group true 1 84)+541 ∧
    measurementCount (group84 true) = measurementCount (group true 1 84)+562 := by
  have t := solveCell tc true 235 164 (fun j => (overhead j true).1)
    (gm_cell tc 164 toffoliCount rfl ECDSAAdd.Entrant.RouteA.Rolling1588.slice45_counts.1)
  have m := solveCell mc true 317 389 (fun j => (overhead j true).2)
    (gm_cell mc 389 measurementCount rfl ECDSAAdd.Entrant.RouteA.Rolling1588.slice45_counts.2)
  rw [show tc.measure = toffoliCount from rfl] at t
  rw [show mc.measure = measurementCount from rfl] at m
  exact ⟨by omega, by omega⟩

/-- every cost measure of the hosted multiplication cell is that of `mslice45`. -/
theorem cell_measureF (c : Cost) :
    c.measure (cellGroup false) = c.measure ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45 := by
  simp only [cellGroup, Bool.false_eq_true, if_false, StairArchiveInactive.hosts_eq, c.rename]

private theorem gm_cellF (c : Cost) (s : Nat) (f : Program → Nat) (hf : c.measure = f)
    (h : f ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45 + s = f (ECDSAAdd.Entrant.Rolling1588.groups false 1 45)) :
    c.measure (cellGroup false) + s = c.measure (group false 1 45) := by
  rw [cell_measureF, group_measure, hf]; exact h

/-- The multiplication field group with the odd cell on packets 45..1. -/
theorem group_cost_mul :
    toffoliCount (group84 false) = toffoliCount (group false 1 84)+535 ∧
    measurementCount (group84 false) = measurementCount (group false 1 84)+562 := by
  have t := solveCell tc false 233 164 (fun j => (overhead j false).1)
    (gm_cellF tc 164 toffoliCount rfl ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45_counts.1)
  have m := solveCell mc false 317 389 (fun j => (overhead j false).2)
    (gm_cellF mc 389 measurementCount rfl ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45_counts.2)
  rw [show tc.measure = toffoliCount from rfl] at t
  rw [show mc.measure = measurementCount from rfl] at m
  exact ⟨by omega, by omega⟩
private theorem cellSlotsF :
    slots.measure (cellGroup false) = slots.measure (group false 1 45)+911 := by
  rw [cell_measureF,group_measure,show slots.measure=Challenge.gateSlots from rfl]
  exact ECDSAAdd.Entrant.RouteA.Rolling1588.mslice45_slots
private theorem cellSlotsT :
    slots.measure (cellGroup true) + 435 = slots.measure (group true 1 45) :=
  gm_cell slots 435 Challenge.gateSlots rfl ECDSAAdd.Entrant.RouteA.Rolling1588.slice45_slots
/-- Static syntax counts include both correction lists of every measurement. The two packets of
a window run at loan depth 1: at most 280 more slots each. -/
theorem group_slots (d : Bool) :
    slots.measure (group84 d) + (if d then 435 else 0) ≤
      slots.measure (group d 1 84)+3*(if d then 6042 else 6053)+(if d then 0 else 911)+1680 := by
  have hc : slots.measure (cellGroup d) + (if d then 435 else 0) =
      slots.measure (group d 1 45)+(if d then 0 else 911) := by
    cases d
    · have e := cellSlotsF
      rw [if_neg (by decide),if_neg (by decide)]
      omega
    · have e := cellSlotsT
      rw [if_pos rfl,if_pos rfl]
      omega
  have h (j : Nat) : slots.measure (ten j (!d)) ≤
      slots.measure (group d j 2)+(if d then 6042 else 6053)+560 := by
    have a := packetL_slots d j
    have b := packetL_slots d (j+1)
    rw [show slots.measure=Challenge.gateSlots from rfl,group,distribute]
    cases d <;>
      simp only [distributed,PacketSequence.program,Bool.not_true,Bool.not_false,ten,firstL,secondL,
        enter,shift,leave,fieldHook,program,if_true,if_false,Bool.false_eq_true,List.nil_append,
        List.append_nil,Challenge.gateSlots_append,Baselines.rename_gateSlots,enter0_gateSlots,
        switch0_gateSlots,leave0_gateSlots,enter1_gateSlots,switch1_gateSlots,leave1_gateSlots] <;> omega
  have h46 := h 46
  have h49 := h 49
  have h52 := h 52
  simp only [group84,ord,partition]
  omega
end ECDSAAdd.Entrant.StairPacket.WindowFieldCosts

