    toffoliCount mslice45+164=toffoliCount (ECDSAAdd.Entrant.Rolling1588.groups false 1 45) ∧
    measurementCount mslice45+389=
      measurementCount (ECDSAAdd.Entrant.Rolling1588.groups false 1 45) := by
  have first := tailFirstPacket_count_delta 45
  have middle := groups_count_delta false 2 43 (by decide)
  have last := tailLastPacket_count_delta 1
