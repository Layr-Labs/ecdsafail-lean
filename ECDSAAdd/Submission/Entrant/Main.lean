/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSiteEasyFrameZ_at_Main` -/
section Merge_StairSiteEasyFrameZ_at_Main

/-!
# Field 12: the finite-stage pieces at the point at infinity (LT35)

The program is empty at the point at infinity, but the piece facts are stated for
every point.  `encode` / `decode` at `Point.zero` are small fixed programs checked by the
per-instruction test.
LT50 (replay budget): the test runs on the closed-form `U` (`StairPlaceFast.uB`): 51 → 44 s;
the rest is the evaluation of the zero-point programs themselves.
K4 (replay budget, 44 s → < 1 s): `stageNew` and `borrowOut` at `Point.zero` are no longer
evaluated.  The record's support lemmas (`ControlStageSupportDevelop.stage_support`,
`OutSpareDevelop.output_support`) assume a valid comparison triple, which fails at the zero
point (its two compared words coincide), but their proofs only use the pivot bounds
`r1, r2 < 256` and `idx ⊆ range 256`, which hold for every triple.  The `z0_` copies below
are those proofs with the validity hypothesis replaced by these unconditional bounds; the
zero-point pieces then reuse the port-list checks of `StairSiteEasyFrameU`.
-/

section
set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.InputSentinel
open Arithmetic RecordedQuantum MeasuredCodec5 Baselines Challenge


theorem z0_firstDiff_lt (a b : Nat) : firstDiff a b < 256 :=
  z0_getD_lt _ (fun i hi => by
    have hm := List.mem_of_find?_eq_some hi
    simpa using hm)

/-- K4: the pivot bounds of `Tri.pivots`, for every triple. -/
theorem z0_pv (tr : Tri) : tr.r1 < 256 ∧ tr.r2 < 256 ∧ tr.r1 < 256 := by
  have h1 : tr.r1 < 256 := z0_firstDiff_lt _ _
  have h2 : tr.r2 < 256 := by
    unfold Tri.r2
    split
    · exact z0_firstDiff_lt _ _
    · exact z0_firstDiff_lt _ _
  exact ⟨h1, h2, h1⟩

theorem z0_idx_lt (tr : Tri) : ∀ i ∈ tr.idx, i < 256 := fun i hi => by
  simp only [Tri.idx, List.mem_filter, List.mem_reverse, List.mem_range] at hi
  exact hi.1

/-- K4: the bound of `Tri.idx_facts` (last component), for every triple. -/
theorem z0_ix (tr : Tri) :
    (∀ i ∈ tr.idx, i < 256) ∧ True ∧ True ∧ True ∧ (∀ i ∈ tr.idx, i < 256) :=
  ⟨z0_idx_lt tr, trivial, trivial, trivial, z0_idx_lt tr⟩

theorem z0_idx_ne (tr : Tri) : tr.idx ≠ [] := by
  have key : ∀ i, i < 256 → i ≠ tr.r1 → i ≠ tr.r2 → tr.idx ≠ [] := fun i hi h1 h2 h => by
    have hm : i ∈ tr.idx := by simp [Tri.idx, hi, h1, h2]
    rw [h] at hm
    simp at hm
  by_cases a1 : 0 = tr.r1
  · by_cases b2 : 1 = tr.r2
    · exact key 2 (by omega) (by omega) (by omega)
    · exact key 1 (by omega) (by omega) b2
  · by_cases a2 : 0 = tr.r2
    · by_cases b1 : 1 = tr.r1
      · exact key 2 (by omega) (by omega) (by omega)
      · exact key 1 (by omega) b1 (by omega)
    · exact key 0 (by omega) a1 a2

/-- K4: the head split of `idx_split`, for every triple. -/
theorem z0_idx_split (tr : Tri) : ∃ i0 it, tr.idx = i0 :: it ∧ True := by
  cases h : tr.idx with
  | nil => exact absurd h (z0_idx_ne tr)
  | cons a l => exact ⟨a, l, rfl, trivial⟩

theorem z0_classifier_support (tr : Tri) (yb : Bool) (xs work : List Wire)
    (y0 c f g g1 wB t : Wire) (hxl : xs.length = 256) (_hwl : work.length = 253) :
    wires (classifier tr yb xs work y0 c f g g1 wB t) ⊆
      xs.toFinset ∪ work.toFinset ∪ {y0, c, f, g, g1, wB, t} := by
  have pv := z0_pv tr
  have ix := z0_ix tr
  obtain ⟨i0, it, hidx, hitl⟩ := z0_idx_split tr
  let U : Finset Wire := xs.toFinset ∪ work.toFinset ∪ {y0, c, f, g, g1, wB, t}
  have xsU : ∀ i, i < 256 → xs.getD i 0 ∈ U := by
    intro i hi
    have hm : xs.getD i 0 ∈ xs := by rw [List.getD_eq_getElem _ _ (by omega)]; exact List.getElem_mem _
    simp only [U, Finset.mem_union, List.mem_toFinset]
    exact Or.inl (Or.inl hm)
  have workU : ∀ q ∈ work, q ∈ U := fun q hq => by simp [U, hq]
  have r1U := xsU _ pv.1
  have r2U := xsU _ pv.2.1
  have idxU : ∀ i ∈ tr.idx, xs.getD i 0 ∈ U := fun i hi => xsU i (ix.2.2.2.2 i hi)
  have PU : ∀ q ∈ tr.idx.map (fun i => xs.getD i 0), q ∈ U := by
    intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; exact idxU i hi
  have h0U : (tr.idx.map (fun i => xs.getD i 0)).headD 0 ∈ U := by
    rw [hidx]; exact idxU i0 (by rw [hidx]; simp)
  have portsU : ∀ b ∈ zeroPorts (tr.idx.map (fun i => xs.getD i 0)).tail work,
      b.input ∈ U ∧ b.work ∈ U := by
    intro b hb
    have hm := zeroPorts_mem _ _ b hb
    exact ⟨PU _ (List.mem_of_mem_tail hm.1), workU _ hm.2⟩
  have extU : ∀ q ∈ ({y0, c, f, g, g1, wB, t} : Finset Wire), q ∈ U := by
    intro q hq; simp only [U, Finset.mem_union]; exact Or.inr hq
  have tailU : ∀ h ∈ U,
      wires (tail tr yb (xs.getD tr.r1 0) (xs.getD tr.r2 0) y0 c f g g1 wB t h) ⊆ U := by
    intro h hh
    refine (tail_support tr yb _ _ y0 c f g g1 wB t h).trans ?_
    simp only [Finset.insert_subset_iff, Finset.singleton_subset_iff]
    exact ⟨hh, r1U, r2U, extU y0 (by simp), extU c (by simp), extU f (by simp), extU g (by simp),
      extU g1 (by simp), extU wB (by simp), extU t (by simp)⟩
  have remapU := remapList_sub tr (xs.getD tr.r1 0) (xs.getD tr.r2 0) (fun i => xs.getD i 0) tr.idx U
    r1U r2U idxU
  have zU := zeroWith_sub _ U tailU _ _ h0U portsU
  have xU : wires [Instr.X ((tr.idx.map (fun i => xs.getD i 0)).headD 0)] ⊆ U := by
    generalize (tr.idx.map (fun i => xs.getD i 0)).headD 0 = h0 at h0U ⊢
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_singleton] at hq
    rcases hq with rfl | hq
    · exact h0U
    · simp at hq
  intro q hq
  simp only [classifier, wires_append, Finset.mem_union] at hq
  rcases hq with h | h | h | h | h
  · exact remapU h
  · exact xU h
  · exact zU h
  · exact xU h
  · exact remapU h

end ECDSAAdd.Entrant.InputSentinel

