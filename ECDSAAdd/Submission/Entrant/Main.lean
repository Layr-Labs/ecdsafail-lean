/-- The record packets `45 .. 1` split at the two junction packets. -/
theorem record_mgroups45_shape : ECDSAAdd.Entrant.Rolling1588.groups false 1 45=
    ECDSAAdd.Entrant.Rolling1588.packet false 45++
      (ECDSAAdd.Entrant.Rolling1588.groups false 2 43++
        ECDSAAdd.Entrant.Rolling1588.packet false 1) := by
  show PacketSequence.program false (ECDSAAdd.Entrant.Rolling1588.packet false) 1 (44+1)=
    ECDSAAdd.Entrant.Rolling1588.packet false 45++
      (PacketSequence.program false (ECDSAAdd.Entrant.Rolling1588.packet false) 2 43++
        ECDSAAdd.Entrant.Rolling1588.packet false 1)
  rw [PacketSequence.program,if_neg Bool.false_ne_true]
  show PacketSequence.program false (ECDSAAdd.Entrant.Rolling1588.packet false) 2 (43+1)++
      ECDSAAdd.Entrant.Rolling1588.packet false 1=_
  rw [tail_program_snoc (ECDSAAdd.Entrant.Rolling1588.packet false) 2 43]
  exact List.append_assoc _ _ _

/-- The odd multiplication slice `45 .. 1` has 164 fewer Toffolis and 389 fewer measurements
than the record packets. -/
