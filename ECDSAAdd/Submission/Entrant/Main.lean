        hstage (WideReference.future_history (le_refl 425) (by decide) pre.domain)
        (WideReference.domain_carry (by decide) pre.domain _ (by decide) (by decide))
        (fun k hk => WideReference.incoming_free_B 425 x p (by decide) raw pre.domain (790 + k.val)
          (by omega) (by have := k.isLt; omega)
          (of_decide_eq_true (List.all_eq_true.mp relB_425_hosts k (List.mem_finRange k)) hk)) m2
    · exact NativePack425.observe_orient raw s m2 (scratch_clean425 x p raw s pre.domain)
  have hpc := ParkEndpoint425.past_cells425 raw s _ _ _ pre.cut
  have htag := ParkEndpoint425.tag_address s (pullState (OB5.sig 424) raw)
  have hr20 : ArchiveBoundary425.rawPorts 20 = 874 := rfl
  have hr21 : ArchiveBoundary425.rawPorts 21 = 875 := rfl
  have hr22 : ArchiveBoundary425.rawPorts 22 = 876 := rfl
  have hms := NativePack425.matched_slice425 d st _ m2 (NativePack425.stepRev425 d) (NativePack425.stepFwd425 d) rfl
    htr (unsigned 410 x p) pg ps (HighBankSum.crossBit (TrueMiddle15E.d MixedWindow425.e3 (unsigned 410 x p)))
    hnums410.odd hnums410.farSmall (hpc.trans pre.hrec)
    (by rw [hr20]; exact htag.1.trans pre.f1616)
    (by rw [hr21, hpc]; exact htag.2.1.trans pre.f1617)
    (by rw [hr22]; exact htag.2.2.trans pre.f1618)
  have hrun : run (NativePack425.lastWindow425 d) m s = run (NativePack425.endSlice425 d) m2 st := by
    simp only [NativePack425.lastWindow425, run_append, run_take, m1, m2, hrel.1, st]
  dsimp only; rw [hrun]
  refine ⟨hms.1.trans hst_ph, ?_, ?_, hms.2.2.2⟩
  · unfold BankKey425 MixedGeo425.bankPorts mixedKey425 value15E
    simp only [show ¬ ((21 : Nat) < 7) by decide, show ¬ ((21 : Nat) = 7) by decide,
      show ¬ ((21 : Nat) < 18) by decide, show ¬ ((21 : Nat) < 21) by decide, ↓reduceDIte]
