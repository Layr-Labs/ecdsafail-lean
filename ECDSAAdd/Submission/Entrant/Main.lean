theorem untick_pool (w : Nat → Wire) (isA : Bool) (hn : (skywalkPoolWires w).Nodup)
    (i : Nat) (hi : i<512) :
    wires (decodeBefore w isA i ++ W.ReverseCarry.compactReceiverTick w i)⊆
      (skywalkPoolWires w).toFinset := by
