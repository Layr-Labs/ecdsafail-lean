theorem loopNC_counts:toffoliCount loopNC=toffoliCount B95Research.loop+98 ∧
 measurementCount loopNC=measurementCount B95Research.loop:=by
 have nc:=ReorderedGenericCache.count_balance 95 B95Research.xs B95Research.ys B95Research.cs
  B95Research.hosts ReorderedBPrefixResearch.cin
  (by rw [B95Research.raw_lengths.1];decide) (by rw [B95Research.raw_lengths.2.1];decide)
