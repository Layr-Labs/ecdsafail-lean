      run (GateMirror.forward (leaveAdjustCore15E (start15E j))) [] uPre) ∧
    (∀ n, run (inverse (leaveAdjustCore15EShort (start15E j))) n
      (run (GateMirror.forward (leaveAdjustCore15E (start15E j))) [] uPre) = uPre) := by
  intro uPre
  obtain ⟨hs1, hs2, hsb1, hsb2, he1, he2, hwp1, hwp2, hl1, hl2, hnw1, hnw2, hlw1, hlw2, hlw3, hpool⟩ := geom15E_facts j
  obtain ⟨tg1, tg2, tg3, tg4, tg5, tg6, tg7, tg8, tg9, tg10, tg11⟩ := tail15E_geom j
  have ha0 : a015E (start15E j) = start15E j + sb15E (start15E j) + 32 := rfl
