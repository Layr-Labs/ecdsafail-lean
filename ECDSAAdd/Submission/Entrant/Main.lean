/-! ### Section 1: `Inputs15E`, Trace Helpers & Entry Mask/Parity Lemmas -/

structure Inputs15E (j : Fin 4) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool) : Prop where
  odd : z.v % 2 = 1
  farSmall : Shadow7.SmallIfFar (sb15E (start15E j)) 15 z
  endSmall : Shadow7.EndSmall (sb15E (start15E j)) z
  nextFarSmall : Shadow7.SmallIfFar (sb15E (start15E j + 15)) 15 (step^[15] z)
  room : Shadow.high (sb15E (start15E j)) 15 z + 1 < 2 ^ wp15E (start15E j)
  adjTight : Shadow.high (sb15E (start15E j)) 15 z + 1 < 2 ^ adjW15E (start15E j)
  fit : TrueMiddle15E.F j z < 2 ^ liveW15E (start15E j)
  ready : onRails15E j 15 (SkywalkRails.encode (LeaveJ7.Admission.flags z g0 s0).1 (LeaveJ7.Admission.flags z g0 s0).2
    (step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).u
    (step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).v) s.basis
  record : physicalCells15E j s = SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)
  fresh : s.basis (e015E (start15E j) + 5) = false
  scratch : ∀ q ∈ 1556 :: 1557 :: 1558 :: LeaveJ7.fullC, s.basis q = false
  temp : ∀ p ∈ longPairs15E j, s.basis p.2 = false
  clean : ∀ q ∈ carries15E j, s.basis q = false
  cPool : ∀ q : Nat, 1613 ≤ q → q < e015E (start15E j) → s.basis q = false
  crtScratch : ∀ k < 10, s.basis (poolW15E (start15E j) (17 + k)) = false
  padding : ∀ i : Nat, wp15E (start15E j) ≤ i → i < wp15E (start15E j) + 15 → s.basis (bankW15E (start15E j) i) = false
  parked : s.basis (b015E (start15E j) + 16) = false
  bank : regValue (ys15E j) s.basis = if Shadow.far (sb15E (start15E j)) 15 z then Shadow.high (sb15E (start15E j)) 15 z else 0
  zero : ∀ q ∈ watched15E j, s.basis q = false
  far : s.basis (e015E (start15E j) + 3) = decide (Shadow.far (sb15E (start15E j)) 15 z)
  side : s.basis (e015E (start15E j) + 4) =
    (decide (Shadow.far (sb15E (start15E j)) 15 z) && decide (2 ^ sb15E (start15E j) ≤ z.u))
  top : ∀ q : Nat, 1556 ≤ q → q < e015E (start15E j) → s.basis q = false

private theorem cells_eq15E_map : ∀ (j : Fin 4) (i : Fin 15),
    windowNet15E j (IntegerPacket.ports (shape15E j) i.val).a0 = start15E j + 16 + i.val ∧
    windowNet15E j (IntegerPacket.ports (shape15E j) i.val).history = swaps15E j i.val := by
  decide +kernel

private theorem cells_eq15E (j : Fin 4) (v : BasisState) :
    ∀ (a n : Nat), a + n ≤ 15 → readCells (shape15E j) a n (mappedBasis15E j v) =
      (List.range' a n).map (fun i => (v (start15E j + 16 + i), v (swaps15E j i)))
  | _, 0, _ => rfl
  | a, n + 1, h => by
    rw [readCells, cells_eq15E j v (a + 1) n (by omega), List.range'_succ, List.map_cons]
    congr 1
    have hm := cells_eq15E_map j ⟨a, by omega⟩
    simp only [cell, mappedBasis15E, hm.1, hm.2]

theorem recordedParity15E (j : Fin 4) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (small : LeaveJ7.Small7 (sb15E (start15E j)) z) (odd : z.v % 2 = 1)
    (hrec : physicalCells15E j s = SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)) :
    oddRead15E j s.basis = oddBits (letters 15 (TrueMiddle15E.r j z)) := by
  have hports : oddRead15E j s.basis = (physicalCells15E j s).map (fun pair => !pair.1) := by
    unfold physicalCells15E
    rw [cells_eq15E j s.basis 0 15 (by omega), List.map_map]
    simp only [oddRead15E, ports15E, List.range_eq_range', Function.comp_def]
  rw [hports, hrec, ← true_records_shadow7 (sb15E (start15E j)) z small.1 odd g0 s0]
  exact LeaveTraceLetters.parity _ _ _ _ (shadow_odd_shadow7 _ _ small.1 odd)

theorem recordedEvents15E (j : Fin 4) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (small : LeaveJ7.Small7 (sb15E (start15E j)) z) (odd : z.v % 2 = 1)
    (hrec : physicalCells15E j s = SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)) :
    (∀ i < 15, s.basis (swaps15E j i) = ((SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)).getD i (false, false)).2) ∧
    (LeaveSelector.right (actualMode (sb15E (start15E j)) z) = true → ∀ i < 15, i ≤ key (actualMode (sb15E (start15E j)) z) →
      s.basis (swaps15E j i) = decide (i = key (actualMode (sb15E (start15E j)) z))) := by
  let xs := SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)
  have hcells := cells_eq15E j s.basis 0 15 (by omega)
  have htape : (List.range 15).map (fun i => s.basis (swaps15E j i)) = xs.map Prod.snd := by
    change _ = (SkywalkTrace.trace 15 _).map _
    rw [← hrec]; unfold physicalCells15E; rw [hcells, List.map_map, List.range_eq_range']; rfl
  constructor
  · intro i hi
    have hlen : i < xs.length := by simpa only [xs, SkywalkTrace.trace_length] using hi
    have phys := congrArg (fun a : List Bool => a[i]?) htape
    simpa [xs, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen, hi] using phys
  · intro hrt i hi early
    have hfar : Shadow.far (sb15E (start15E j)) 15 z := by
      by_contra h; simp [actualMode, farMode, ofFlags, LeaveSelector.right, h] at hrt
    obtain ⟨keyEq, orientation, _⟩ := modeKey (sb15E (start15E j)) z hfar
    have side : decide (2 ^ sb15E (start15E j) ≤ z.u) = false := by rw [orientation] at hrt; simpa using hrt
    have keyWait : key (actualMode (sb15E (start15E j)) z) = wait 15 z.u := by
      rw [keyEq, place, if_neg (of_decide_eq_false side)]
    have hlen : i < xs.length := by simpa only [xs, SkywalkTrace.trace_length] using hi
    have phys := congrArg (fun a : List Bool => a[i]?) htape
    have before := LeaveJ7.Far.firstSwap (sb15E (start15E j)) z g0 s0 small odd hfar side i hlen (keyWait ▸ early)
    rw [keyWait]
    exact Eq.trans (by simpa [List.getElem?_eq_getElem hlen, hi] using phys) before

theorem recordedFlag15E (j : Fin 4) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (small : LeaveJ7.Small7 (sb15E (start15E j)) z) (odd : z.v % 2 = 1)
    (hrec : physicalCells15E j s = SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v))
    (far : s.basis (e015E (start15E j) + 3) = decide (Shadow.far (sb15E (start15E j)) 15 z))
    (side : s.basis (e015E (start15E j) + 4) =
      (decide (Shadow.far (sb15E (start15E j)) 15 z) && decide (2 ^ sb15E (start15E j) ≤ z.u))) :
    (s.basis (e015E (start15E j) + 4) ^^ (s.basis (e015E (start15E j) + 3) && s.basis (swaps15E j 0))) =
      decide (Shadow.far (sb15E (start15E j)) 15 z ∧ LeaveShadowRails.farKey (sb15E (start15E j)) z = 0) := by
  have rec0 := (recordedEvents15E j s z g0 s0 small odd hrec).1 0 (by decide)
  rw [side, far, rec0]
  by_cases f : Shadow.far (sb15E (start15E j)) 15 z
  · have k := LeaveShadowRails.key0Flag (sb15E (start15E j)) z g0 s0 (small.1 f) odd f
    simp only [List.getD_eq_getElem?_getD, decide_eq_true f, Bool.true_and, f, true_and] at k ⊢
    exact k
  · simp [f]

private theorem entry15E_parity_off : ∀ (j : Fin 4) (i : Fin 15),
    (start15E j + 16 + i.val : Wire) ∉ (GateMirror.forward (Shadow7.fix0P (start15E j) (sb15E (start15E j)))).map destination ∧
    (start15E j + 16 + i.val : Wire) ∉ (GateMirror.forward (Shadow7.fix2P (start15E j) (sb15E (start15E j)))).map destination := by
  decide +kernel

private theorem leaveFix1_eq_notReg_b1 : ∀ j : Fin 4,
    GateMirror.forward (leaveFix1 (start15E j) (sb15E (start15E j))) = notRegister (history15E j) := by
  decide +kernel

theorem entry15E_parity (j : Fin 4) (s : State) (m : List Bool) :
    parityBits15E (ports15E j) (run (GateMirror.forward (entryLeave15E (start15E j))) m s).basis = oddRead15E j s.basis := by
  have hfl := leaveFix1_eq_notReg_b1 j
  have hnd : (history15E j).Nodup := List.Nodup.map (fun _ _ e => Nat.add_left_cancel e) List.nodup_range
  apply List.ext_getElem (by simp [parityBits15E, oddRead15E])
  intro i h1 _
  have hi : i < 15 := by simp [parityBits15E] at h1; exact h1
  simp only [parityBits15E, oddRead15E, ports15E, List.getElem_map, List.getElem_range]
  simp only [entryLeave15E, forward_app, run_append, run_take]
  rw [LeaveReadoutFrame.preserved _ _ _ _ (entry15E_parity_off j ⟨i, hi⟩).2, hfl, notRegister_correct _ hnd]
  have hmem : (start15E j + 16 + i : Wire) ∈ history15E j := List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩
  dsimp only; rw [if_pos hmem, LeaveReadoutFrame.preserved _ _ _ _ (entry15E_parity_off j ⟨i, hi⟩).1]

private theorem fix2_15E_split_bm1 : ∀ j : Fin 4,
    let ops := Shadow7.fix2P (start15E j) (sb15E (start15E j))
    let w : Wire := b015E (start15E j) - 1
    ops.take 1 = [.x w] ∧
    w ∉ (GateMirror.forward ((ops.drop 1).take 62)).map destination ∧
    (ops.drop 63).take 1 = [.x w] ∧
    w ∉ (GateMirror.forward (ops.drop 64)).map destination := by
  decide +kernel

private theorem fix2_15E_keeps_bm1 (j : Fin 4) (s : State) (m : List Bool) :
    (run (GateMirror.forward (Shadow7.fix2P (start15E j) (sb15E (start15E j)))) m s).basis
      (b015E (start15E j) - 1) = s.basis (b015E (start15E j) - 1) := by
  have hsp := fix2_15E_split_bm1 j
  set ops := Shadow7.fix2P (start15E j) (sb15E (start15E j))
  set w : Wire := b015E (start15E j) - 1
  have hlist : ops = ops.take 1 ++ ((ops.drop 1).take 62 ++ ((ops.drop 63).take 1 ++ ops.drop 64)) := by
    have h1 : ops.take 1 ++ ops.drop 1 = ops := List.take_append_drop 1 ops
    have h2 : (ops.drop 1).take 62 ++ (ops.drop 1).drop 62 = ops.drop 1 := List.take_append_drop 62 _
    have h3 : (ops.drop 63).take 1 ++ (ops.drop 63).drop 1 = ops.drop 63 := List.take_append_drop 1 _
    simp only [List.drop_drop, Nat.reduceAdd] at h2 h3
    rw [← h3] at h2; rw [← h2] at h1; exact h1.symm
  have hX (u : State) (t : List Bool) : (run (GateMirror.forward [.x w]) t u).basis w = !u.basis w := by
    simp [GateMirror.forward, GateMirror.front, run, writeBit]
  rw [hlist, forward_app, forward_app, forward_app, run_append, run_append, run_append]
  rw [LeaveReadoutFrame.preserved _ _ _ _ hsp.2.2.2]
  rw [hsp.2.2.1, hX]
  rw [LeaveReadoutFrame.preserved _ _ _ _ hsp.2.1]
  rw [hsp.1, hX, Bool.not_not]

attribute [local irreducible] run SkywalkNat.step Shadow7.fix0P leaveFix1 Shadow7.fix2P in
theorem entry15E_bm1 (j : Fin 4) (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (ready : onRails15E j 15 (SkywalkRails.encode G sg
      (step^[15] (TrueMiddle15E.r j z)).u (step^[15] (TrueMiddle15E.r j z)).v) s.basis)
    (fresh : s.basis (e015E (start15E j) + 5) = false) :
    let a := step^[15] (TrueMiddle15E.r j z)
    let e := PortalValues.negative sg a.u
    (run (GateMirror.forward (entryLeave15E (start15E j))) m s).basis (b015E (start15E j) - 1) =
      ((a.u - e.toNat) / 2 ^ sb15E (start15E j)).testBit 0 := by
  have hg := geom15E_facts j
  let a := step^[15] (TrueMiddle15E.r j z)
  let e := PortalValues.negative sg a.u
  have scanActual := inputScan15E_result j s m a.u a.v G sg ready fresh
  have hfl := leaveFix1_eq_notReg_b1 j
  dsimp only [entryLeave15E]
  simp only [forward_app, run_append, run_take]
  rw [fix2_15E_keeps_bm1 j]
  rw [LeaveReadoutFrame.preserved _ _ _ _ (by
    rw [hfl]; simp only [history15E, notRegister, List.map_map, List.mem_map, List.mem_range, not_exists, not_and]
    intro i hi eq; simp only [Function.comp, destination] at eq; unfold b015E Wire at *; omega)]
  simpa only [Nat.add_zero] using (scanActual.2.2.1 0 (by decide)).2

/-! ### Section 2: `kept8_15E_run`, `schedule15E_ok`, `core15E_result` -/

private theorem run_sign8_15E (a b c d t : Nat) (m : List Bool) (s : State)
    (at' : a ≠ t) (bt : b ≠ t) (ct : c ≠ t) (dt : d ≠ t) (ba : b ≠ a) :
    let u := run [.CX a t, .CX c t, .CX d t, .CX b a] m s
    u.phase = s.phase ∧
    u.basis t = (((s.basis t ^^ s.basis a) ^^ s.basis c) ^^ s.basis d) ∧
    u.basis a = (s.basis a ^^ s.basis b) ∧
    ∀ q : Nat, q ≠ t → q ≠ a → u.basis q = s.basis q := by
  have hat : t ≠ a := at'.symm
  refine ⟨rfl, ?_, ?_, ?_⟩
  · simp [run, writeBit, Function.update, at', ct, dt, hat]
  · simp [run, writeBit, Function.update, at', bt, ct, dt, hat, ba]
  · intro q hqt hqa; simp [run, writeBit, Function.update, hqt, hqa]

private theorem run_sign10_15E (a b c d t : Nat) (m : List Bool) (s : State)
    (at' : a ≠ t) (bt : b ≠ t) (ct : c ≠ t) (dt : d ≠ t) :
    let u := run [.CX a t, .CX b t, .CX c t, .CX d t] m s
    u.phase = s.phase ∧
    u.basis t = ((((s.basis t ^^ s.basis a) ^^ s.basis b) ^^ s.basis c) ^^ s.basis d) ∧
    ∀ q : Nat, q ≠ t → u.basis q = s.basis q := by
  refine ⟨rfl, ?_, ?_⟩
  · simp [run, writeBit, Function.update, at', bt, ct, dt]
  · intro q hqt; simp [run, writeBit, Function.update, hqt]

private theorem kept8_15E_run (j : Fin 4) (s : State) (m : List Bool) (X : Nat) (k : Mode)
    (h1613 : s.basis 1613 = if enabled k then ((X / 2 ^ key k) / 2 % 2 == 1) else false)
    (htags : ∀ (i : Nat), i < 8 → s.basis (tagsP.getD i 0) = (enabled k && decide (i = key k)))
    (hX : ∀ (i : Nat), i < 17 → s.basis (a015E (start15E j) - 1 + i) =
      if enabled k && decide (i = key k) then false else X.testBit i)
    (hbound : enabled k = true → X / 2 ^ key k ≤ 2)
    (hdead : enabled k = true → 8 ≤ key k → (X / 2 ^ key k) / 2 % 2 = 0) :
    let out := run (GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 0 8)) m s
    out.phase = s.phase ∧
    (∀ (i : Nat), i < 17 → out.basis (a015E (start15E j) - 1 + i) = if enabled k then (X % 2 ^ key k).testBit i else X.testBit i) ∧
    (∀ q : Wire, (∀ (i : Nat), i < 8 → q ≠ a015E (start15E j) - 1 + (i + 1)) → out.basis q = s.basis q) := by
  have hg := geom15E_facts j
  have htr : ∀ (i : Nat), i < 8 → 1560 ≤ (tagsP.getD i 0 : Nat) ∧ (tagsP.getD i 0 : Nat) ≤ 1576 := by
    intro i hi; have : ∀ r : Fin 8, 1560 ≤ (tagsP.getD r.val 0 : Nat) ∧ (tagsP.getD r.val 0 : Nat) ≤ 1576 := by decide
    exact this ⟨i, hi⟩
  have hstep : ∀ (p n : Nat) (st : State) (tp : List Bool), p + n ≤ 8 →
      (∀ (i : Nat), p ≤ i → i < p + n → st.basis (tagsP.getD i 0) = s.basis (tagsP.getD i 0)) →
      st.basis 1613 = s.basis 1613 →
      (run (GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 p n)) tp st).phase = st.phase ∧
      (∀ (i : Nat), p ≤ i → i < p + n →
        (run (GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 p n)) tp st).basis
          (a015E (start15E j) - 1 + (i + 1)) =
        (st.basis (a015E (start15E j) - 1 + (i + 1)) ^^ (s.basis (tagsP.getD i 0) && s.basis 1613))) ∧
      (∀ q : Wire, (∀ (i : Nat), p ≤ i → i < p + n → q ≠ a015E (start15E j) - 1 + (i + 1)) →
        (run (GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 p n)) tp st).basis q = st.basis q) := by
    intro p n; induction n generalizing p with
    | zero => intro st tp _ _ _; exact ⟨rfl, fun _ h1 h2 => by omega, fun _ _ => rfl⟩
    | succ n ih =>
      intro st tp hpn htg h13
      have hsplit : GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 p (n + 1)) =
          [Instr.CCX (tagsP.getD p 0) 1613 (a015E (start15E j) - 1 + (p + 1))] ++
            GateMirror.forward (keptG (tagsP.getD · 0) (fun i => a015E (start15E j) - 1 + i) 1613 (p + 1) n) := rfl
      rw [hsplit, run_append, run_take]
      have hdrop : tp.drop (measurementCount [Instr.CCX (tagsP.getD p 0) 1613 (a015E (start15E j) - 1 + (p + 1))]) = tp := rfl
      rw [hdrop]
      let st1 := run [Instr.CCX (tagsP.getD p 0) 1613 (a015E (start15E j) - 1 + (p + 1))] tp st
      have hst1 : st1 = ⟨st.phase, writeBit st.basis (a015E (start15E j) - 1 + (p + 1))
          (st.basis (a015E (start15E j) - 1 + (p + 1)) ^^ (st.basis (tagsP.getD p 0) && st.basis 1613))⟩ := rfl
      have hneT : ∀ (i : Nat), i < 8 → tagsP.getD i 0 ≠ a015E (start15E j) - 1 + (p + 1) := fun i hi => by
        have := htr i hi; unfold a015E Wire at *; omega
      have hrec := ih (p + 1) st1 tp (by omega)
        (fun i h1 h2 => by rw [hst1]; simp only [writeBit, Function.update_of_ne (hneT i (by omega)), htg i (by omega) (by omega)])
        (by rw [hst1]; simp only [writeBit, Function.update_of_ne (show (1613 : Wire) ≠ a015E (start15E j) - 1 + (p + 1) by unfold a015E Wire; omega), h13])
      refine ⟨hrec.1.trans (by rw [hst1]), fun i h1 h2 => ?_, fun q hq => ?_⟩
      · by_cases eq : i = p
        · subst eq; rw [hrec.2.2 _ (fun i' h1' _ => by unfold Wire; omega), hst1]
          simp only [writeBit, Function.update_self, htg i (by omega) (by omega), h13]
        · rw [hrec.2.1 i (by omega) (by omega), hst1]
          simp only [writeBit, Function.update_of_ne (show (a015E (start15E j) - 1 + (i + 1) : Nat) ≠ a015E (start15E j) - 1 + (p + 1) by omega)]
      · rw [hrec.2.2 q (fun i h1 h2 => hq i (by omega) (by omega)), hst1]
        simp only [writeBit, Function.update_of_ne (hq p (le_refl _) (by omega))]
  have hs0 := hstep 0 8 s m (by decide) (fun _ _ _ => rfl) rfl
  refine ⟨hs0.1, fun i hi => ?_, fun q hq => hs0.2.2 q (fun r _ hr => hq r hr)⟩
  cases hen : enabled k
  · have hzero : ∀ (r : Nat), r < 8 → s.basis (tagsP.getD r 0) = false := fun r hr => by rw [htags r hr, hen]; rfl
    by_cases h1 : 1 ≤ i ∧ i ≤ 8
    · rw [show i = (i - 1) + 1 by omega, hs0.2.1 (i - 1) (by omega) (by omega), hzero (i - 1) (by omega),
        Bool.false_and, Bool.xor_false, show (i - 1) + 1 = i by omega, hX i hi, hen]; rfl
    · rw [hs0.2.2 _ (fun r _ hr => by unfold Wire; omega), hX i hi, hen]; rfl
  · rw [if_pos rfl, Nat.testBit_mod_two_pow]
    by_cases hlt : i < key k
    · rw [decide_eq_true hlt, Bool.true_and]
      by_cases h1 : 1 ≤ i ∧ i ≤ 8
      · rw [show i = (i - 1) + 1 by omega, hs0.2.1 (i - 1) (by omega) (by omega), htags (i - 1) (by omega), hen,
          Bool.true_and, decide_eq_false (by omega), Bool.false_and, Bool.xor_false, show (i - 1) + 1 = i by omega,
          hX i hi, hen, Bool.true_and, decide_eq_false (by omega)]; rfl
