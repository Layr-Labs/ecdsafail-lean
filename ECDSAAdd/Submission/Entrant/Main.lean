    · simp_all [DirectPass.foldHead_mode,GatePhysical,RecordedQuantum.PhysicalInstr,ProperGate,ne_comm]
    · simp_all [DirectPass.foldTail_mode,GatePhysical,RecordedQuantum.PhysicalInstr,ProperGate,ne_comm]
