  · exact (keep _ (by simp)).trans parity
  · exact (keep _ (by simp)).trans lower
  · intro q hq qr
    exact (keep q (by simp [List.mem_of_mem_take hq])).trans (clean q hq qr)
  · intro q hq hp hl ho
    have qa : q∉rawTarget L := by simp [rawTarget,hq,ho]
