private theorem recorded_equal15E (j : Fin 4) (x p : Nat) (good : Bounds x p) (raw history : State)
    (dom : Domain (start15E j) x p raw) (g sg : Bool)
    (input : InputAt (start15E j) (SkywalkRails.encode g sg (unsigned (start15E j) x p).u (unsigned (start15E j) x p).v) raw)
    (record : physicalCells15E j history = SkywalkTrace.trace 15 (SkywalkRails.encode g sg (unsigned (start15E j) x p).u (unsigned (start15E j) x p).v))
    (k : Fin 15) :
    (history.basis (start15E j + 16 + k.val), history.basis (swaps15E j k.val)) =
      ((Shadow20.WideReference20.origin (start15E j) (prevLen15E j) 15 raw history).basis (start15E j + 16 + k.val),
       (Shadow20.WideReference20.origin (start15E j) (prevLen15E j) 15 raw history).basis (swaps15E j k.val)) := by
  have hg := geom15E_facts j; dsimp only at hg
  have eqCan := unique_input input (fixed_input _ _ _ (by omega) good raw dom)
  rw [eqCan] at record
  have hcell : (history.basis (start15E j + 16 + k.val), history.basis (swaps15E j k.val)) =
      SkywalkTrace.code (WideReference.canonical (start15E j + k.val) x p) := by
    have hc := congrArg (fun l : List (Bool × Bool) => StairArchiveRaw.read l k.val) record
    have hread : StairArchiveRaw.read (physicalCells15E j history) k.val =
        (history.basis (start15E j + 16 + k.val), history.basis (swaps15E j k.val)) := by
      unfold physicalCells15E StairArchiveRaw.read; rw [cells15E_eq_local j history.basis]
      have hlt : k.val < ((List.range 15).map (fun r => (history.basis (start15E j + 16 + r), history.basis (swaps15E j r)))).length := by simp [k.isLt]
