    (hq : q ∈ L.dialogPool.take m) : q ≠ L.core.poolWire k := by
  rw [pool_block L hw m (by omega)] at hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
  simp only [List.mem_range'_1] at hi
  intro e
  have := pool_inj L hw hn i k (by omega) (by omega) e
  omega

