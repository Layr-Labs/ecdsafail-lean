theorem live_rows (B:Nat) (h:B∈budgets):∀q∈rowSites B,free q=true:=by
  have ok:budgets.all (fun b=>(rowSites b).all free)=true:=by decide +kernel
  exact List.all_eq_true.mp (List.all_eq_true.mp ok B h)
theorem of_rows {B:Nat} (h:B∈budgets) {P:Program} (sub:∀q∈wires P,q∈rowSites B):Clear P:=by
  intro q hit used
  obtain ⟨b,i,rfl⟩:=StockArchiveBanks.bank_rep q hit
  have pass:=live_rows B h _ (sub _ used)
  rw [occupied] at pass
  contradiction
theorem packFree (B:Nat) (h:B∈budgets):Clear (checkpointPrimitives.pack B):=of_rows h (by
  intro q hq
  change q ∈ wires (pack B) at hq
  simp only [pack, wires_append, Finset.mem_union] at hq
  rcases hq with (sign | codec) | moved
  · exact signExt_rowSites B h q sign
  · exact declared_rowSites B q (List.mem_toFinset.mp (StairCodec.pack_support _ B (budget_three B h) codec))
  · exact (relocate_rowSites B h).1 q moved)
theorem unpackFree (B:Nat) (h:B∈budgets):Clear (checkpointPrimitives.unpack B):=of_rows h (by
  intro q hq
  change q ∈ wires (unpack B) at hq
  simp only [unpack, wires_append, Finset.mem_union] at hq
  rcases hq with (moved | codec) | sign
  · exact (relocate_rowSites B h).2 q moved
  · exact declared_rowSites B q (List.mem_toFinset.mp (StairCodec.unpack_support _ B (budget_three B h) codec))
  · exact signExt_rowSites B h q sign)
theorem tfFree (B:Nat) (h:B∈budgets):Clear (checkpointPrimitives.tickForward (startFor B)):=of_rows h (by
  intro q hq
  obtain ⟨s1, -, -, s4, -, s6⟩ := budget_shape B h
  change q ∈ wires (tickForward (startFor B)) at hq
  unfold tickForward at hq; rw [s1] at hq
  exact tick_rowSites B h (startFor B) s6 le_rfl q (tick_layout _ _ (by omega) (segmentMap_pool_nodup B h) q hq))
theorem trFree (B:Nat) (h:B∈budgets):Clear (checkpointPrimitives.tickReverse (startFor B)):=of_rows h (by
  intro q hq
  obtain ⟨s1, -, -, s4, -, s6⟩ := budget_shape B h
  change q ∈ wires (tickReverse (startFor B)) at hq
  unfold tickReverse at hq; rw [s1] at hq
  exact tick_rowSites B h (startFor B) s6 le_rfl q (receiver_layout _ _ (by omega) (segmentMap_pool_nodup B h) q hq))
theorem mfFree (B:Nat) (h:B∈budgets):Clear (checkpointPrimitives.middleForward (startFor B+1) (endFor B-startFor B-1)):=of_rows h (by
  intro q hq
  obtain ⟨-, s2, s3, s4, s5, s6⟩ := budget_shape B h
  change q ∈ wires (middleForward (startFor B+1) (endFor B-startFor B-1)) at hq
  unfold middleForward at hq; rw [s2] at hq
  exact movedForward_sub (midSegmentMap B) (rowSites B) (midSegmentMap_pool_nodup B h)
    _ _ (by omega) s5
    (fun j h1 h2 => midTick_rowSites B h j (by omega) (by omega))
    (fun j h1 h2 due => midPacket_rowSites B h j (by omega) (by omega) due) q hq)
theorem mrFree (B:Nat) (h:B∈budgets):Clear (checkpointPrimitives.middleReverse (startFor B+1) (StairPhysicalPrimitivesFix505.reverseEnd B-startFor B-1)):=of_rows h (by
  intro q hq
  obtain ⟨s2, s3, s4, s5⟩ := StairPhysicalPrimitivesFix505.budget_shape_rev B h
  change q ∈ wires (StairPhysicalPrimitivesFix505.middleReverseFix (startFor B+1) (StairPhysicalPrimitivesFix505.reverseEnd B-startFor B-1)) at hq
  unfold StairPhysicalPrimitivesFix505.middleReverseFix at hq; rw [s2] at hq
  exact movedReverse_sub (StairPhysicalPrimitivesFix505.revSegmentMap B) (rowSites B) (StairPhysicalPrimitivesFix505.revSegmentMap_pool_nodup B h)
    _ _ (by omega) s5
    (fun j h1 h2 => StairPhysicalPrimitivesFix505.revTick_rowSites B h j (by omega) (by omega))
    (fun j h1 h2 due => StairPhysicalPrimitivesFix505.revPacket_rowSites B h j (by omega) (by omega) due) q hq)
