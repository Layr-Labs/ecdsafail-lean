private structure Affine where
  slope : Int
  constant : Int
  deriving DecidableEq

private def eval (f : Affine) (k : Int) : Int := f.slope*k+f.constant
private def affAdd (f g : Affine) : Affine := ⟨f.slope+g.slope,f.constant+g.constant⟩
private def affSub (f g : Affine) : Affine := ⟨f.slope-g.slope,f.constant-g.constant⟩
private def affHalf (f : Affine) : Affine := ⟨f.slope/2,f.constant/2⟩

private theorem eval_nonneg (f : Affine) (lo hi k : Int)
    (hl : lo≤k) (hh : k≤hi) (hlo : 0≤eval f lo) (hhi : 0≤eval f hi) :
    0≤eval f k := by
  by_cases hs : 0≤f.slope
  · have hm := mul_le_mul_of_nonneg_left hl hs
    dsimp only [eval] at hlo hhi ⊢
    linarith
  · have hs' : f.slope≤0 := by omega
    have hm := mul_le_mul_of_nonpos_left hh hs'
    dsimp only [eval] at hlo hhi ⊢
    linarith

private theorem eval_negative (f : Affine) (lo hi k : Int)
    (hl : lo≤k) (hh : k≤hi) (hlo : eval f lo<0) (hhi : eval f hi<0) :
    eval f k<0 := by
  by_cases hs : 0≤f.slope
  · have hm := mul_le_mul_of_nonneg_left hh hs
    dsimp only [eval] at hlo hhi ⊢
    linarith
  · have hs' : f.slope≤0 := by omega
    have hm := mul_le_mul_of_nonpos_left hl hs'
    dsimp only [eval] at hlo hhi ⊢
    linarith

private def signSafe (lo hi : Int) (f : Affine) : Prop :=
  SkywalkRails.neg (eval f lo)=SkywalkRails.neg (eval f hi)

/-- An affine sign certificate applies to every integer in its interval. -/
private theorem sign_sound (f : Affine) (lo hi k : Int)
    (hl : lo≤k) (hh : k≤hi) (safe : signSafe lo hi f) :
    SkywalkRails.neg (eval f k)=SkywalkRails.neg (eval f lo) := by
  change SkywalkRails.neg (eval f lo)=SkywalkRails.neg (eval f hi) at safe
  cases h0 : SkywalkRails.neg (eval f lo) with
  | false =>
    have hlo : ¬eval f lo<0 := by simpa only [SkywalkRails.neg,decide_eq_false_iff_not] using h0
    have hhi : ¬eval f hi<0 := by
      simpa only [SkywalkRails.neg,decide_eq_false_iff_not] using safe.symm.trans h0
    have hk := eval_nonneg f lo hi k hl hh (by omega) (by omega)
    simp only [h0,SkywalkRails.neg,decide_eq_false_iff_not]
    omega
  | true =>
    have hlo : eval f lo<0 := by simpa only [SkywalkRails.neg,decide_eq_true_eq] using h0
    have hhi : eval f hi<0 := by
      simpa only [SkywalkRails.neg,decide_eq_true_eq] using safe.symm.trans h0
    have hk := eval_negative f lo hi k hl hh hlo hhi
    simp only [h0,SkywalkRails.neg,decide_eq_true_eq]
    exact hk

private theorem eval_mod_two (f : Affine) (k : Int) (hs : f.slope%2=0) :
    eval f k%2=f.constant%2 := by
  simp [eval,Int.add_emod,Int.mul_emod,hs]

private theorem eval_half (f : Affine) (k : Int)
    (hs : f.slope%2=0) (hc : f.constant%2=0) : eval (affHalf f) k=eval f k/2 := by
  have h1 : 2*(f.slope/2)=f.slope := by omega
  have h2 : 2*(f.constant/2)=f.constant := by omega
  have equal : eval f k=2*eval (affHalf f) k := by
    dsimp only [eval,affHalf]
    calc
      f.slope*k+f.constant=(2*(f.slope/2))*k+2*(f.constant/2) := by rw [h1,h2]
      _=2*((f.slope/2)*k+f.constant/2) := by ring
  omega

private structure AffineState where
  a : Affine
  b : Affine
  g : Bool
  deriving DecidableEq

private def evalState (z : AffineState) (k : Int) : SkywalkRails.State :=
  ⟨eval z.a k,eval z.b k,z.g⟩
private def oddAff (z : AffineState) : Bool := decide (z.a.constant%2≠0)
private def evenAff (z : AffineState) : Affine := if oddAff z then z.b else z.a
private def otherAff (z : AffineState) : Affine := if oddAff z then z.a else z.b
private def halfAff (z : AffineState) : Affine := affHalf (evenAff z)
private def afterAff (lo : Int) (z : AffineState) : Affine :=
  if SkywalkRails.neg (eval (evenAff z) lo)=SkywalkRails.neg (eval (otherAff z) lo)
  then affSub (otherAff z) (halfAff z) else affAdd (otherAff z) (halfAff z)
private def nextAff (lo : Int) (z : AffineState) : AffineState :=
  ⟨halfAff z,afterAff lo z,z.g ^^ oddAff z⟩
private def codeAff (lo : Int) (z : AffineState) : Bool×Bool :=
  (z.g ^^ oddAff z,SkywalkRails.neg (eval (otherAff z) lo) ^^
    SkywalkRails.neg (eval (afterAff lo z) lo))

private def tickOK (lo hi : Int) (z : AffineState) : Prop :=
  z.a.slope%2=0 ∧ (evenAff z).slope%2=0 ∧ (evenAff z).constant%2=0 ∧
    signSafe lo hi (evenAff z) ∧ signSafe lo hi (otherAff z) ∧ signSafe lo hi (afterAff lo z)

private theorem step_sound (lo hi k : Int) (hl : lo≤k) (hh : k≤hi)
    (z : AffineState) (checked : tickOK lo hi z) :
    SkywalkRails.step (evalState z k)=
      ⟨eval (nextAff lo z).a k,eval (nextAff lo z).b k,
        (nextAff lo z).g,(codeAff lo z).2⟩ := by
  rcases checked with ⟨ha,hec,hed,hes,hos,hks⟩
  have odd_eq : SkywalkRails.odd (eval z.a k)=oddAff z := by
    simp only [SkywalkRails.odd,oddAff,eval_mod_two z.a k ha]
  have route_eq : SkywalkRails.route (eval z.a k) (eval z.b k)=
      (eval (evenAff z) k,eval (otherAff z) k) := by
    simp only [SkywalkRails.route,odd_eq]
    cases h : oddAff z <;> simp only [evenAff,otherAff,h,Bool.false_eq_true,if_false,if_true]
  have half_eq : eval (halfAff z) k=eval (evenAff z) k/2 :=
    eval_half (evenAff z) k hec hed
  have even_sign := sign_sound (evenAff z) lo hi k hl hh hes
  have other_sign := sign_sound (otherAff z) lo hi k hl hh hos
  have after_sign := sign_sound (afterAff lo z) lo hi k hl hh hks
  have after_eq : eval (afterAff lo z) k=
      if SkywalkRails.sameSign (eval (evenAff z) k) (eval (otherAff z) k)
      then eval (otherAff z) k-eval (halfAff z) k
      else eval (otherAff z) k+eval (halfAff z) k := by
    simp only [SkywalkRails.sameSign,even_sign,other_sign,decide_eq_true_eq]
    unfold afterAff
    split_ifs <;> dsimp only [eval,affSub,affAdd] <;> ring
  change SkywalkRails.step ⟨eval z.a k,eval z.b k,z.g⟩=_
  dsimp only [SkywalkRails.step]
  rw [route_eq]
  dsimp only [Prod.fst,Prod.snd]
  rw [←half_eq]
  rw [←after_eq,odd_eq,other_sign,after_sign]
  rfl

private def affineTrace (lo : Int) : Nat → AffineState → List (Bool×Bool)
  | 0, _ => []
  | n+1, z => codeAff lo z::affineTrace lo n (nextAff lo z)
private def traceOK (lo hi : Int) : Nat → AffineState → Prop
  | 0, _ => True
  | n+1, z => tickOK lo hi z ∧ traceOK lo hi n (nextAff lo z)

private instance traceOK_decidable (lo hi : Int) (n : Nat) (z : AffineState) :
    Decidable (traceOK lo hi n z) := by
  induction n generalizing z with
  | zero => exact isTrue trivial
  | succ n ih =>
    change Decidable (tickOK lo hi z ∧ traceOK lo hi n (nextAff lo z))
    haveI := ih (nextAff lo z)
    letI : Decidable (tickOK lo hi z) := by
      unfold tickOK signSafe
      infer_instance
    infer_instance

private theorem trace_sound (lo hi k : Int) (hl : lo≤k) (hh : k≤hi)
    (n : Nat) (z : AffineState) (checked : traceOK lo hi n z) :
    SkywalkTrace.trace n (evalState z k)=affineTrace lo n z := by
  induction n generalizing z with
  | zero => rfl
  | succ n ih =>
    have tick := step_sound lo hi k hl hh z checked.1
    have code_eq : SkywalkTrace.code (evalState z k)=codeAff lo z := by
      simp only [SkywalkTrace.code,tick]
      rfl
    have next_eq : SkywalkTrace.next (evalState z k)=evalState (nextAff lo z) k := by
      change SkywalkRails.railsOf (SkywalkRails.step (evalState z k))=_
      rw [tick]
      rfl
    simp only [SkywalkTrace.trace,affineTrace,code_eq,next_eq]
    exact congrArg (List.cons (codeAff lo z)) (ih _ checked.2)

/-- The ten interleaved raw history bits, in codec bit order. -/
def traceWord (cs : List (Bool×Bool)) : Nat :=
  MeasuredCodec5.pack10 (cs.getD 0 (false,false)).1 (cs.getD 0 (false,false)).2
    (cs.getD 1 (false,false)).1 (cs.getD 1 (false,false)).2
    (cs.getD 2 (false,false)).1 (cs.getD 2 (false,false)).2
    (cs.getD 3 (false,false)).1 (cs.getD 3 (false,false)).2
    (cs.getD 4 (false,false)).1 (cs.getD 4 (false,false)).2

private def initial (r : Nat) : AffineState :=
  ⟨⟨32,(r:Int)+(p:Int)⟩,⟨32,r⟩,false⟩

