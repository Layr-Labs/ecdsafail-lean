    (StairSquareBodyC.bodyC_avoids hl hsub)
  have avB := StairSquareKernel26C.kB_avoids hl (mem39 hl hsub) _ (StairSqBodyB.bodyB_ok hl hsub)
    (StairSqBodyB.bodyB_avoids hl hsub)
  have avA := StairSquareKernel26C.kA_avoids hl (mem39 hl hsub) _ (StairSquareBodyOK.bodyA_ok hl hsub)
    (StairSquareBodyA.bodyA_avoids hl hsub)
  have hostsGood : ∀ h ∈ StairSquareKernel26C.hostsK,
      StairSiteAvoidance.UG (placeFn h) ∈ StairHoleSupport.recordArena ∧
        StairSiteAvoidance.UG (placeFn h) ∉ StairHoleSupport.oldHoles := by
    intro h hh
