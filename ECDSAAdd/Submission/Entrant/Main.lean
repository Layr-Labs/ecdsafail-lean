theorem junction_footprint_shape (L : Layout) (hw : L.Widths) :
    junctionFootprint L=(L.sign::L.parity::L.one::
      (L.y++L.r++(Q6Structural.q6Carry L).take 255)).toFinset := by
  rw [DirectPass.active_carry_shape L hw]
  ext q
