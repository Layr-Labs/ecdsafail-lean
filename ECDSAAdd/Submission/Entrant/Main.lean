  obtain ⟨⟨h3, h87, hnod, hrest', hrestN, haN, hbS, hbD, hbA, hbC, hbM, hDb, hD2, hS1⟩,
    ⟨haF, hcM, hfp⟩⟩ := packFacts B hB
