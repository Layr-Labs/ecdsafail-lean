theorem exitCut21_pin_loan (k : Nat) {s : State} (F : ExitFrame k s) (m : List Bool) :
    (∃ record, FrameAt F.x 85 record ∧ AgreeOutside (Δv 87) (run (cut (xps k) 21) m s) record) ∧
