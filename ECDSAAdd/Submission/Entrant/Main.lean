theorem matched_slice425 (d : Bool) (s mid : State) (m : List Bool)
    (invStep : Program) (step : Program) (hstep : mid = run step m s)
    (tr : Transition425 invStep s mid)
    (past : SkywalkNat.State) (g sign cross : Bool) (odd : past.v % 2 = 1)
    (small : Shadow7.SmallIfFar 43 15 past)
    (hrec : physicalCells15E sourceIdx425 s = SkywalkTrace.trace 15 (encode g sign past.u past.v))
    (h20 : s.basis (rawPorts 20) = decide (Shadow.far 43 15 past))
    (h21 : s.basis (rawPorts 21) = (decide (Shadow.far 43 15 past) && afterFlags (decide (past.v < past.u)) ((physicalCells15E sourceIdx425 s).take 5)))
    (h22 : s.basis (rawPorts 22) = (decide (Shadow.far 43 15 past) && cross)) :
    let out := run (step ++ (program d ++ Shadow7.exitLoadP 425 d)) m s
    let key := StairArchiveRaw.rawBit
      (StairArchiveRaw.read ((SkywalkTrace.trace 15 (encode g sign past.u past.v)).drop 5))
      (decide (Shadow.far 43 15 past))
      (decide (Shadow.far 43 15 past) && afterFlags (decide (past.v < past.u)) ((SkywalkTrace.trace 15 (encode g sign past.u past.v)).take 5))
      (decide (Shadow.far 43 15 past) && cross)
    out.phase = s.phase ∧ SavedKey key codePorts d out ∧
    (∀ n, run (Shadow7.exitRestoreP 425 d ++ (reverse d ++ invStep)) n out = s) ∧
    (∀ k : Fin 157, 16 ≤ k.val → out.basis (codePorts k) = false) := by
  have hleg : StairArchiveRaw.legal (physicalCells15E sourceIdx425 s) := by
    rw [hrec]; exact legal_signed 15 past g sign (by omega) odd
  have okFive : MeasuredCodec5.legalAt history mid.basis := by
    apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
    rw [tr.keptFive, tr.keptFive, (exit425_hist_geom.1 i).1, (exit425_hist_geom.1 i).2]
    apply not_both; simpa only [Nat.zero_add, cell, mappedBasis15E] using
      hleg _ (member_cell (shape15E sourceIdx425) 15 0 i.val (mappedBasis15E sourceIdx425 s.basis) (by omega))
  let m1 := m.drop (measurementCount step)
  let packed := run (program d) m1 mid
  let m2 := m1.drop (measurementCount (program d))
  have plaw := source_law d mid m1 okFive
  have hkeep (k : Fin 157) : packed.basis (rawPorts k) = mid.basis (rawPorts k) :=
    outside d (rawPorts k) (fun v => exit425_hist_geom.2.2 k v) m1 mid
  let f := decide (Shadow.far 43 15 past)
  let u := f && afterFlags (decide (past.v < past.u)) ((physicalCells15E sourceIdx425 s).take 5)
  let c := f && cross
  let data := rawBit (StairArchiveRaw.read ((physicalCells15E sourceIdx425 s).drop 5)) f u c
  have hraw : ∀ i : Fin 157, i.val < 23 → packed.basis (rawPorts i) = data i := by
    intro i hi
    rw [hkeep i, tr.keptBank ⟨i, hi⟩]
    by_cases y : i.val < 20
    · rw [chron425 ⟨i, y⟩]; exact (native_raw_read15E sourceIdx425 s i y).trans (by simp [data, rawBit, y])
    · have hcases : i = 20 ∨ i = 21 ∨ i = 22 := by omega
      rcases hcases with rfl | rfl | rfl
      · exact h20
      · exact h21
      · exact h22
  have hscr : ∀ i : Fin 157, 23 ≤ i.val → packed.basis (rawPorts i) = false := fun i hi =>
    (hkeep i).trans (tr.scratch i hi)
  obtain ⟨row, lim, matchRow⟩ := interrupted_row_shadow7 43 past small odd g sign cross _
    (hrec.trans (true_records_shadow7 43 past small odd g sign).symm)
  have frame0 : Frame rawPorts ArchivePortAction.raw row packed :=
    starting_frame rawPorts _ row data matchRow hraw hscr
  have hEnc : Encodes (StairArchiveRaw.rawBit
      (StairArchiveRaw.read ((SkywalkTrace.trace 15 (encode g sign past.u past.v)).drop 5))
      (decide (Shadow.far 43 15 past))
      (decide (Shadow.far 43 15 past) && afterFlags (decide (past.v < past.u)) ((SkywalkTrace.trace 15 (encode g sign past.u past.v)).take 5))
      (decide (Shadow.far 43 15 past) && cross)) row := by
    intro q
    have eq : (rawCol q).testBit row = packed.basis (rawPorts ⟨q, by omega⟩) :=
      (congrArg (fun n : Nat => n.testBit row) (io true true ⟨q, by omega⟩).1).trans (frame0 ⟨q, by omega⟩).symm
    rw [eq, hraw ⟨q, by omega⟩ q.isLt]; simp only [data, f, u, c, hrec]
  have spec := select_spec ⟨row, lim, hEnc⟩
  have rf := reframe lim hEnc rawPorts _ frame0
  have lr := load_run d _ spec.1 packed m2 rf
  dsimp only; simp only [run_append, run_take, ← hstep]
  refine ⟨lr.1.trans (plaw.1.trans tr.phase), ⟨spec.1, spec.2, fun j => lr.2.1 ⟨j.val, by omega⟩⟩, ?_, ?_⟩
  · intro n
    change run invStep _ (run (reverse d) _ (run (Shadow7.exitRestoreP 425 d) n (run (Shadow7.exitLoadP 425 d) m2 packed))) = s
    rw [ArchiveBoundary425.roundtrip d _ spec.1 packed m2 n rf, plaw.2, tr.undo]
  · intro k hk
    have hfr := lr.2.1 k
    simp only [endCols, ↓reduceIte] at hfr
    rw [hfr, archive_blank _ _ hk, Nat.zero_testBit]

