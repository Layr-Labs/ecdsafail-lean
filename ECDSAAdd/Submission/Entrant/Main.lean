/-- dadon's `Leave{s}BeforeStore.result`. -/
theorem result (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (s : State) (m : List Bool) (z : SkywalkNat.State)
    (G sg : Bool) (small : LeaveJ7.Small7 (Shadow7.sbP (start j)) z)
