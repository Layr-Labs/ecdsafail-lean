private theorem clrAll15E_basis_at (ctrl q : Wire) :
    ∀ (rs : List MoveChain.Row) (st : State),
      (∀ r ∈ rs, r.1 ≠ ctrl ∧ r.2 ≠ ctrl ∧ ∀ r' ∈ rs, r.1 ≠ r'.2) →
      (rs.map Prod.snd).Nodup →
      (MoveChain.clrAll ctrl rs st).basis q =
        match rs.find? (fun r => decide (r.2 = q)) with
        | none => st.basis q
        | some r => st.basis q ^^ (st.basis r.1 && st.basis ctrl) := by
  intro rs; induction rs with
  | nil => intro st _ _; rfl
  | cons r rs ih =>
    intro st hsep hnd
    have hnd' := List.nodup_cons.mp hnd
    have hsep_t : ∀ x ∈ rs, x.1 ≠ ctrl ∧ x.2 ≠ ctrl ∧ ∀ x' ∈ rs, x.1 ≠ x'.2 :=
      fun x hx => ⟨(hsep x (List.mem_cons_of_mem _ hx)).1, (hsep x (List.mem_cons_of_mem _ hx)).2.1,
        fun x' hx' => (hsep x (List.mem_cons_of_mem _ hx)).2.2 x' (List.mem_cons_of_mem _ hx')⟩
    show (MoveChain.clrAll _ rs (MoveChain.clr _ r st)).basis _ = _
    rw [ih _ hsep_t hnd'.2]
    by_cases e : r.2 = q
    · have hnone : rs.find? (fun x => decide (x.2 = q)) = none := by
        rw [List.find?_eq_none]; intro x hx; simp only [decide_eq_true_eq]
        intro ex; exact hnd'.1 (List.mem_map.mpr ⟨x, hx, ex.trans e.symm⟩)
      rw [hnone]; simp only [List.find?_cons, e, decide_true, MoveChain.clr, MoveChain.wb_same]
    · simp only [List.find?_cons, decide_eq_false e]
      cases hf : rs.find? (fun x => decide (x.2 = q)) with
      | none => exact MoveChain.wb_other _ _ _ _ (Ne.symm e)
      | some r' =>
        have hr' := List.mem_of_find?_eq_some hf
        simp only [MoveChain.clr, MoveChain.wb_other _ _ _ _ (Ne.symm e),
          MoveChain.wb_other _ _ _ _ ((hsep r' (List.mem_cons_of_mem _ hr')).2.2 r List.mem_cons_self),
          MoveChain.wb_other _ _ _ _ (Ne.symm (hsep r List.mem_cons_self).2.1)]

