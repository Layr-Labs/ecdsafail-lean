  simp only [FrontierEntry1591Native.workSites,List.mem_toFinset,List.mem_cons,
    List.not_mem_nil,or_false] at hq
  rcases hq with rfl|rfl|rfl
  · exact phase_free_preimage _ _ (base 721) (by decide +kernel) (free _ (by simp [phaseHostSites]))
  · exact phase_free_preimage _ _ (base 719) (by decide +kernel) (free _ (by simp [phaseHostSites]))
  · exact phase_free_preimage _ _ (base 720) (by decide +kernel) (free _ (by simp [phaseHostSites]))

theorem phase_first_work_free : ∀q∈FrontierEntry1591Native.workSites,
    q∉wires (renameProgram phaseHost FrontierEntry1591Kernel.firstPhase) :=
  phase_work_free _ first_hosts_free

theorem phase_last_work_free : ∀q∈FrontierEntry1591Native.workSites,
    q∉wires (renameProgram phaseHost FrontierEntry1591Kernel.lastPhase) :=
  phase_work_free _ last_hosts_free

private theorem away_phase_sites (q : Wire) (hq : q∈phaseWorkSites∪phaseHostSites) :
    q∉wireBlock base 2056 256 := by
  simp only [phaseWorkSites,phaseHostSites,FrontierEntry1591Native.workSites,Finset.mem_union,
    List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hq
  rcases hq with (rfl|rfl|rfl)|(rfl|rfl|rfl) <;>
    exact OwnPlusHost.not_block _ 2056 256 (by omega)

theorem caller_phase_clean (x y : Nat) (s : State)
    (input : SkywalkArithmeticInput base x y s.basis) :
    ∀q∈phaseWorkSites∪phaseHostSites,s.basis q=false := by
  intro q hq
  rcases Finset.mem_union.mp hq with work|host
  · exact FrontierEntry1591Native.caller_clean_sites x y s input q (Finset.mem_union_left _ work)
  · simp only [phaseHostSites,List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at host
    rcases host with rfl|rfl|rfl
    · apply input.2.2
      · exact arith_block_subset_shared base 0 1798 (by omega)
          (DirectSkywalk.arith_mem base 0 1798 721 (by omega) (by omega))
      · exact OwnPlusHost.not_block 721 770 256 (by omega)
      · exact OwnPlusHost.not_block 721 2056 256 (by omega)
    · exact FrontierEntry1591Native.caller_clean_sites x y s input _
        (by simp [FrontierEntry1591Native.workSites,FrontierEntry1591Native.hostSites])
    · exact FrontierEntry1591Native.caller_clean_sites x y s input _
        (by simp [FrontierEntry1591Native.workSites,FrontierEntry1591Native.hostSites])

theorem pull_phase_clean (s : State)
    (clean : ∀q∈phaseWorkSites∪phaseHostSites,s.basis q=false) : pullState phaseHost s=s := by
  have a := FrontierEntry1591Native.Transport.pull_swap_clean (base 1026) (base 721) s
    (clean _ (by simp [phaseWorkSites,phaseHostSites,FrontierEntry1591Native.workSites]))
    (clean _ (by simp [phaseWorkSites,phaseHostSites]))
  have b := Q6IntegerHost.pull_clean s
    (clean _ (by simp [phaseWorkSites,phaseHostSites,FrontierEntry1591Native.workSites]))
    (clean _ (by simp [phaseWorkSites,phaseHostSites]))
  have c := Q7IntegerHost.pull_clean s
    (clean _ (by simp [phaseWorkSites,phaseHostSites,FrontierEntry1591Native.workSites]))
    (clean _ (by simp [phaseWorkSites,phaseHostSites]))
  change pullState (Equiv.swap (base 1026) (base 721))
    (pullState Q6IntegerHost.swap (pullState Q7IntegerHost.swap s))=s
  rw [c,b,a]

theorem phase_run_eq_of_clean (P : Program) (s : State) (m : List Bool)
    (before : ∀q∈phaseWorkSites∪phaseHostSites,s.basis q=false)
    (after : ∀q∈phaseWorkSites∪phaseHostSites,(run P m s).basis q=false) :
    run (renameProgram phaseHost P) m s=run P m s := by
  apply pullState_perm_injective phaseHost
  rw [run_rename phaseHost phaseHost.injective,pull_phase_clean s before,pull_phase_clean _ after]

theorem phase_first_run_eq (hn : (skywalkSharedWires base).Nodup)
    (x y : Nat) (hx0 : 0<x) (hx : x<p) (s : State) (m : List Bool)
    (input : SkywalkArithmeticInput base x y s.basis) :
    run (renameProgram phaseHost FrontierEntry1591Kernel.firstPhase) m s=
      run FrontierEntry1591Kernel.firstPhase m s := by
  have clean := caller_phase_clean x y s input
  apply phase_run_eq_of_clean _ s m clean
  intro q hq
  rcases Finset.mem_union.mp hq with work|host
  · exact FrontierEntry1591Kernel.first_clean hn x y hx0 hx s m input q work
  · exact (run_preserves_outside _ m s q (first_hosts_free q host)).trans
      (clean q (Finset.mem_union_right _ host))

private theorem compose_phases_run_eq (f : Wire→Wire) (First F Last : Program)
    (s : State) (m : List Bool)
    (first : run (renameProgram f First) (m.take (measurementCount First)) s=
      run First (m.take (measurementCount First)) s)
    (last : run (renameProgram f Last)
        ((m.drop (measurementCount First)).drop (measurementCount F))
        (run F ((m.drop (measurementCount First)).take (measurementCount F))
          (run First (m.take (measurementCount First)) s))=
      run Last ((m.drop (measurementCount First)).drop (measurementCount F))
        (run F ((m.drop (measurementCount First)).take (measurementCount F))
          (run First (m.take (measurementCount First)) s))) :
    run (renameProgram f First++(F++renameProgram f Last)) m s=
      run (First++(F++Last)) m s := by
  simp only [run_append,(renameProgram_counts f First).2]
  rw [first]
  exact last

private theorem phase_kernel_run_eq_of_clean (First F Last : Program) (s : State) (m : List Bool)
    (input : ∀q∈phaseWorkSites∪phaseHostSites,s.basis q=false)
    (firstFree : ∀q∈phaseHostSites,q∉wires First)
    (firstClean : ∀r,∀q∈phaseWorkSites,(run First r s).basis q=false)
    (fieldFree : ∀q∈FrontierEntry1591Native.workSites,q∉wires F)
    (lastFree : ∀q∈phaseHostSites,q∉wires Last)
    (output : ∀q∈phaseWorkSites∪phaseHostSites,
      (run (FrontierEntry1591Native.kernel First F Last) m s).basis q=false) :
    run (renameProgram phaseHost First++(F++renameProgram phaseHost Last)) m s=
      run (FrontierEntry1591Native.kernel First F Last) m s := by
  let mp := m.take (measurementCount First)
  let rest := m.drop (measurementCount First)
  let mf := rest.take (measurementCount F)
  let mr := rest.drop (measurementCount F)
  let before := run First mp s
  let after := run F mf before
  have firstWork := firstClean mp
  have finalClean : ∀q∈phaseWorkSites∪phaseHostSites,(run Last mr after).basis q=false := by
    simpa only [FrontierEntry1591Native.kernel,run_append] using output
  have lastInput : ∀q∈phaseWorkSites∪phaseHostSites,after.basis q=false := by
    intro q hq
    rcases Finset.mem_union.mp hq with work|host
    · exact (run_preserves_outside F mf before q (fieldFree q work)).trans (firstWork q work)
    · exact (run_preserves_outside Last mr after q (lastFree q host)).symm.trans
        (finalClean q (Finset.mem_union_right _ host))
  have last := phase_run_eq_of_clean Last after mr lastInput finalClean
  have first : run (renameProgram phaseHost First) mp s=run First mp s := by
    apply phase_run_eq_of_clean First s mp input
    intro q hq
    rcases Finset.mem_union.mp hq with work|host
    · exact firstWork q work
    · exact (run_preserves_outside First mp s q (firstFree q host)).trans
        (input q (Finset.mem_union_right _ host))
  simpa only [FrontierEntry1591Native.kernel] using
    compose_phases_run_eq phaseHost First F Last s m first last

theorem kernel_run_eq (F : Program) (hn : (skywalkSharedWires base).Nodup)
    (x y : Nat) (hx0 : 0<x) (hx : x<p) (s : State) (m : List Bool)
    (input : SkywalkArithmeticInput base x y s.basis)
    (free : ∀q∈FrontierEntry1591Native.workSites,q∉wires F)
    (output : ∀q∈phaseWorkSites∪phaseHostSites,
      (run (FrontierEntry1591Native.kernel FrontierEntry1591Kernel.firstPhase F
        FrontierEntry1591Kernel.lastPhase) m s).basis q=false) :
    run (kernel F) m s=run (FrontierEntry1591Native.kernel
      FrontierEntry1591Kernel.firstPhase F FrontierEntry1591Kernel.lastPhase) m s := by
  simpa only [kernel] using phase_kernel_run_eq_of_clean
    FrontierEntry1591Kernel.firstPhase F FrontierEntry1591Kernel.lastPhase s m
    (caller_phase_clean x y s input) first_hosts_free
    (fun records => FrontierEntry1591Kernel.first_clean hn x y hx0 hx s records input)
    free last_hosts_free output

theorem kernel_entry_correct (F : Program)
    (raw : FrontierEntry1591Callers.EntryCorrect (FrontierEntry1591Native.kernel
      FrontierEntry1591Kernel.firstPhase F FrontierEntry1591Kernel.lastPhase))
    (free : ∀q∈FrontierEntry1591Native.workSites,q∉wires F) :
    FrontierEntry1591Callers.EntryCorrect (kernel F) := by
  intro hn hlo ho hf x Y hx0 hx s t m input hg hs phase same half
  have result := raw hn hlo ho hf x Y hx0 hx s t m input hg hs phase same half
  have actual := FrontierEntry1591Kernel.paired_input x Y.val s t input same
  have output : ∀q∈phaseWorkSites∪phaseHostSites,
      (run (FrontierEntry1591Native.kernel FrontierEntry1591Kernel.firstPhase F
        FrontierEntry1591Kernel.lastPhase) m t).basis q=false := by
    intro q hq
    exact (result.2.2 q (away_phase_sites q hq)).trans (caller_phase_clean x Y.val s input q hq)
  rw [kernel_run_eq F hn x _ hx0 hx t m actual free output]
  exact result

theorem kernel_exit_correct (F : Program)
    (raw : FrontierEntry1591Callers.ExitCorrect (FrontierEntry1591Native.kernel
      FrontierEntry1591Kernel.firstPhase F FrontierEntry1591Kernel.lastPhase))
    (free : ∀q∈FrontierEntry1591Native.workSites,q∉wires F) :
    FrontierEntry1591Callers.ExitCorrect (kernel F) := by
  intro hn hlo ho hf x Y hx0 hx s m input hg hs
  have result := raw hn hlo ho hf x Y hx0 hx s m input hg hs
  have output : ∀q∈phaseWorkSites∪phaseHostSites,
      (run (FrontierEntry1591Native.kernel FrontierEntry1591Kernel.firstPhase F
        FrontierEntry1591Kernel.lastPhase) m s).basis q=false := by
    intro q hq
    exact (result.2.2 q (away_phase_sites q hq)).trans (caller_phase_clean x Y.val s input q hq)
  rw [kernel_run_eq F hn x Y.val hx0 hx s m input free output]
  exact result

end ECDSAAdd.Entrant.ControlLoan1589
end -- original module boundary

