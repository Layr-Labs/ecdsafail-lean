  have prevOdd : (unsigned 395 x p).v % 2 = 1 := (actualNumbers15E MixedWindow425.e2 x p good).odd
  have prevSm : PrevSmall15E MixedWindow425.e3 (unsigned 395 x p) := (actualNumbers15E MixedWindow425.e2 x p good).farSmall
  have ep := endpoint15E_exit425 d x p good raw s m (m.drop (measurementCount (nextWindow15E MixedWindow425.e3 d)))
    pre.domain g sg pre.cut inp scr (unsigned 395 x p) pg ps (prevCross15E MixedWindow425.e3 x p) prevOdd prevSm pre.facts
  have carried := WideReference20.stepInput15 410 15 (sb15E 410) x p (by decide) (by decide)
    good raw (run (nextWindow15E MixedWindow425.e3 d) m s) g sg pre.domain pre.input nums.farSmall
  have canon := unique_input pre.input (fixed_input 410 x p (by decide) good raw pre.domain)
  have hph : (run (nextWindow15E MixedWindow425.e3 d ++ leaveP15E MixedWindow425.e3) m s).phase = s.phase := by
    rw [run_append, run_take]
    have cph := ep.1.phase; rw [eraseSites_phase, pullState_phase] at cph
    have hcp := pre.cut.phase; rw [eraseSites_phase, pullState_phase] at hcp
    have eph := endRaw_phase_gen 410 15 15 x p (by decide) good raw (run (nextWindow15E MixedWindow425.e3 d) m s) pre.domain
    exact cph.trans (eph.trans hcp.symm)
  refine ⟨hph, ⟨?_, ?_⟩, ?_⟩
  · rw [run_append, run_take]
    exact ⟨WideReference20.endRaw 410 15 15 raw (run (nextWindow15E MixedWindow425.e3 d) m s),
      (LeaveJ7.Admission.flags (unsigned 410 x p) g sg).1,
      (LeaveJ7.Admission.flags (unsigned 410 x p) g sg).2, g, sg,
      ⟨carried.1, by rw [flags15_eq]; exact carried.2, ep.1, ep.2.1, ep.2.2.1, ep.2.2.2.1, ep.2.2.2.2.1, canon⟩⟩
  · intro b hb; rw [run_append, run_take]
    by_cases h20 : b.val = 20
    · have hbeq : b = ⟨20, by decide⟩ := Fin.ext h20; subst hbeq
      have hrec := selected_receipt15E MixedWindow425.e3 d x p good raw s g sg pg ps m pre
      have hbk : BankKey425 d x p ⟨20, by decide⟩ (run (nextWindow15E MixedWindow425.e3 d) m s) := hrec
      exact keep_savedKey425 hbk (fun q hq => keep_leave15E MixedWindow425.e3 410 (by decide) (by decide) q (bank_cells_mem425 ⟨20, by decide⟩ q hq) _ _)
    · have hlt : b.val < 20 := by omega
      have hend : MixedGeo425.endTick b + 15 ≤ 410 := by
        have h : ∀ k' : MixedGeo425.Bank, k'.val < 20 → MixedGeo425.endTick k' + 15 ≤ 410 := by decide +kernel
        exact h b hlt
      exact keep_savedKey425 (hs b hlt) (fun q hq => by
        have hk' := keep_cells_15E MixedWindow425.e3 d (MixedGeo425.endTick b) (bank_tick_match425 b).2.2.2.2.1 hend q (bank_cells_mem425 b q hq) s m
        rw [run_append, run_take] at hk'; exact hk')
  · intro t
    rw [run_append, run_take, run_append, run_take]
    exact (congrArg (run (nextUnwind15E MixedWindow425.e3 d) _) (ep.2.2.2.2.2.1 t)).trans (ep.2.2.2.2.2.2 _)

private theorem chunk56_checked (d : Bool) (x : Nat) (good : Bounds x p) :
