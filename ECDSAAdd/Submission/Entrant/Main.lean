theorem prevScratch_clean15E (j : Fin 4) (d : Bool) (s : State) (a b : List Bool) (row : Nat)
    (frame : Frame (prevCodePorts15E j) (code d) row
      (run (withArchive15E j d) (b.drop (measurementCount (routed15E j 0 1)))
        (run (routed15E j 0 1) b (run (enterP15E j) a s)))) :
    ∀ q ∈ prevScratch15E j, (q : Nat) < 1044 → (run (window15E j d) b (run (enterP15E j) a s)).basis q = false := by
  intro q hq hlt
  obtain ⟨k, eq⟩ := prevScratch_code15E j hq
  rcases of_decide_eq_true (List.all_eq_true.mp (prevScratch_geom15E j) q hq) with ⟨lo, _⟩ | ⟨_, _, hnt⟩
  · unfold Wire at *; omega
  · exact after_encoded15E j (withArchive15E j d) (prevCodePorts15E j) d row (run (enterP15E j) a s) b
      frame ⟨16 + k.val, by omega⟩ (by dsimp; omega) q eq hnt

theorem codesOld15E : ∀ j : Fin 4,
    (∀ i : Fin 16, oldRange (start15E j + 1) (windowNet15E j (prevCodePorts15E j ⟨i.val, by omega⟩))) ∧
    (∀ k : Fin 3, prevCodePorts15E j ⟨154 + k.val, by omega⟩ = e015E (start15E j) + 6 + k.val ∧
      ¬ MayTouch15E j (windowNet15E j (e015E (start15E j) + 6 + k.val))) ∧
    (∀ i : Fin 4, prevCodePorts15E j ⟨150 + i.val, by omega⟩ = (fourHoles15E j).getD i.val 0 ∧
      ¬ MayTouch15E j (windowNet15E j ((fourHoles15E j).getD i.val 0))) ∧
    (e015E (start15E j) - 1 ∈ prevScratch15E j ∧ ¬ MayTouch15E j (windowNet15E j (e015E (start15E j) - 1))) ∧
    (¬ MayTouch15E j (windowNet15E j (EnterJ15E.parked j)) ∧
      EnterJ15E.parked j ∉ support15E j ++ prevRawPortsList15E j ∧
      EnterJ15E.parked j ∉ EnterJ15E.pending j) ∧
    (∀ q ∈ prevRawHead15E j ++ support15E j,
      (q < e015E (start15E j) + 9 ∨ 2055 ≤ q + start15E j) ∧
      q ≠ e015E (start15E j) - 1 ∧ q ≠ EnterJ15E.parked j ∧
      (q < a015E (start15E j) + 16 ∨ 1043 < q)) := by
  decide +kernel

theorem tail_clean15E (j : Fin 4) (d : Bool) (x p : Nat) (raw s : State)
    (domain : Domain (start15E j) x p raw) (a b : List Bool) (neg far long : Bool)
    (cut : PackedCut (EnterJ15E.lowerPairs j) (EnterJ15E.upperPairs j) (EnterJ15E.gate j) (EnterJ15E.flagN j)
      (EnterJ15E.flagF j) (EnterJ15E.flagU j) neg far long
      (pullState (EnterJ15E.pull j) raw) (eraseSites (EnterJ15E.pending j) s))
    (row : Nat) (frame : Frame (prevCodePorts15E j) (code d) row
      (run (withArchive15E j d) (b.drop (measurementCount (routed15E j 0 1)))
        (run (routed15E j 0 1) b (run (enterP15E j) a s)))) :
    ∀ q ∈ tailTemps15E j, (run (window15E j d) b (run (enterP15E j) a s)).basis q = false := by
  have hg := geom15E_facts j
  have hchk : ∀ r : Fin 4, ∀ w ∈ tailTemps15E r,
      windowNet15E r w = w ∧ EnterJ15E.pull r w = w ∧ ¬ MayTouch15E r w ∧
      w ∉ EnterJ15E.ports r ∧ w ∉ EnterJ15E.pending r ∧ w ≠ EnterJ15E.flagN r ∧
      w ≠ EnterJ15E.flagF r ∧ w ≠ EnterJ15E.flagU r ∧ w ∉ RailPair.sites (EnterJ15E.upperPairs r) ∧
      1556 ≤ (w : Nat) ∧ (w : Nat) ≤ 1812 := by
    decide +kernel
  intro q hq
  obtain ⟨wn, pl, nt, np, npend, hN, hF, hU, hHi, lo, hi⟩ := hchk j q hq
  by_cases sc : q ∈ prevScratch15E j
  · obtain ⟨k, eq⟩ := prevScratch_code15E j sc
    exact after_encoded15E j (withArchive15E j d) (prevCodePorts15E j) d row (run (enterP15E j) a s) b
      frame ⟨16 + k.val, by omega⟩ (by dsimp; omega) q eq (by rw [wn]; exact nt)
  · have notAdmin : q ∉ support15E j ++ prevRawPortsList15E j := by
      rw [prevRaw_split15E, List.mem_append, List.mem_append]
      rintro (h | h | h)
      · have := ((codesOld15E j).2.2.2.2.2 q (List.mem_append_right _ h)).1
        simp only [tailTemps15E, List.mem_range'_1, Wire] at hq this; omega
      · have := ((codesOld15E j).2.2.2.2.2 q (List.mem_append_left _ h)).1
        simp only [tailTemps15E, List.mem_range'_1, Wire] at hq this; omega
      · exact sc h
    have stay := ext_head15E (enterP15E j) j (withArchive15E j d) _ s a b q (by rw [wn]; exact nt)
      (EnterJ15E.notWire j np) notAdmin (admin_cover15E j d)
    have read := cut.unchanged q hN hF hU hHi
    have canon : s.basis q = raw.basis q := by simpa only [pullState, pl, eraseSites, if_neg npend] using read
    exact stay.trans (canon.trans (domain_carry (by unfold start15E; omega) domain q lo hi))

theorem top_clean15E (j : Fin 4) (d : Bool) (s : State) (a b : List Bool) (row : Nat)
    (frame : Frame (prevCodePorts15E j) (code d) row
      (run (withArchive15E j d) (b.drop (measurementCount (routed15E j 0 1)))
        (run (routed15E j 0 1) b (run (enterP15E j) a s)))) :
    (run (window15E j d) b (run (enterP15E j) a s)).basis (e015E (start15E j) - 1) = false := by
  have hsc : ∀ r : Fin 4, ∃ k : Fin 134, prevCodePorts15E r ⟨16 + k.val, by omega⟩ = e015E (start15E r) - 1 := by
    decide +kernel
  obtain ⟨k, eq⟩ := hsc j
  exact after_encoded15E j (withArchive15E j d) (prevCodePorts15E j) d row (run (enterP15E j) a s) b
    frame ⟨16 + k.val, by omega⟩ (by dsimp; omega) _ eq (codesOld15E j).2.2.2.1.2

theorem top2_clean15E (j : Fin 4) (d : Bool) (s : State) (a b : List Bool) (row : Nat)
    (frame : Frame (prevCodePorts15E j) (code d) row
      (run (withArchive15E j d) (b.drop (measurementCount (routed15E j 0 1)))
        (run (routed15E j 0 1) b (run (enterP15E j) a s)))) :
    (run (window15E j d) b (run (enterP15E j) a s)).basis (e015E (start15E j) - 2) = false := by
  have hsc : ∀ r : Fin 4, ∃ k : Fin 134, prevCodePorts15E r ⟨16 + k.val, by omega⟩ = e015E (start15E r) - 2 ∧
      ¬ MayTouch15E r (windowNet15E r (e015E (start15E r) - 2)) := by
    decide +kernel
  obtain ⟨k, eq, nmt⟩ := hsc j
