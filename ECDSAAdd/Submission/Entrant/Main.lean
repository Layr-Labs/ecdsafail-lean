-- ===== mslice45: the odd multiplication slice on packets 45..1 =====
section
set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.RouteA.Rolling1588
open Arithmetic MappedCompressed DirectSkywalk Secp256k1 BalancedField OffsetBorrowedCanonical CompressedFieldSupport
open ECDSAAdd.Entrant.Rolling1588
attribute [local irreducible] run wires

/-- Packets `45 .. 1` of the multiplication walk in the odd-word code: `mstart` in packet 45,
ordinary odd packets 44..2, `mend` in packet 1. -/
def mslice45 : Program :=
  tailFirstPacket 45 ++ (groups false 2 43 ++ tailLastPacket 1)

theorem mslice45_cut_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord 46 origin X Y) mslice45
      (fun state => let V := Replay5.groupsPayload false origin 1 45 (X,Y)
        CutFrame centerWord centerWord 1 origin V.1 V.2 state) := by
  let step := fun k (V : Fp×Fp) =>
    directionalPayload true (mixedTranscriptControls origin (base 2400) (Replay5.letters k)) V
  have head := tailFirstPacket_cut_frame 45 (by decide) (by decide) origin ctx enabled X Y
  have middle := groups_cut_frame false 2 43 (by decide) (by decide) origin ctx enabled
    (step 45 (X,Y)).1 (step 45 (X,Y)).2
  have last := tailLastPacket_cut_frame 1 (by decide) (by decide) origin ctx enabled
    (Replay5.groupsPayload false origin 2 43 (step 45 (X,Y))).1
    (Replay5.groupsPayload false origin 2 43 (step 45 (X,Y))).2
  have whole := head.seq (middle.seq last)
  have unfoldPayload : Replay5.groupsPayload false origin 1 45 (X,Y)=
      step 1 (Replay5.groupsPayload false origin 2 43 (step 45 (X,Y))) := by
    show PacketSequence.payload false step 1 (44+1) (X,Y)=
      step 1 (PacketSequence.payload false step 2 43 (step 45 (X,Y)))
    rw [PacketSequence.payload,if_neg Bool.false_ne_true]
    show step 1 (PacketSequence.payload false step 2 (43+1) (X,Y))=_
    rw [tail_payload_snoc step 2 43 (X,Y)]
  intro state records input
  have result := whole state records input
  refine ⟨result.1,?_⟩
  simpa only [mslice45,Bool.false_eq_true,if_false,unfoldPayload,Prod.mk.eta,step,
    show (2:Nat)+43=45 from rfl,show (45:Nat)+1=46 from rfl,show (1:Nat)+1=2 from rfl] using result.2

/-- On the record cut frame at cut 46, the odd multiplication slice and the record packets
`45 .. 1` end in the same state (independent measurement tapes). -/
theorem mslice45_run_eq (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : ECDSAAdd.Entrant.Rolling1588.CutFrame 46 origin X Y s) :
    run mslice45 fresh s = run (ECDSAAdd.Entrant.Rolling1588.groups false 1 45) old s := by
  have odd := mslice45_cut_frame origin ctx enabled X Y s fresh input
  have record := ECDSAAdd.Entrant.Rolling1588.groups_cut_frame false 1 45 (by decide) (by decide)
    origin ctx enabled X Y s old input
  exact cutFrame_unique_route 1 origin _ _ _ _ odd.2 record.2 (odd.1.trans record.1.symm)

end ECDSAAdd.Entrant.RouteA.Rolling1588
end

