/-- K3 program: the record C branch with the kernel holes hosted. -/
def branchC2 (ps : List (Wire × Wire)) (L : CuccaroStreamedSquareWideLayout) (ext : List Wire) (control : Wire)
    (B : Program) : Program :=
  OwnDiagAll12Square.gPrep L++
    withLowK2S2 ps L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B)++
    OwnDiagAll12Square.gClear L


