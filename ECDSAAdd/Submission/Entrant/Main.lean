 have zIn:=(zero_regs L LowAccCarryDevelop.layout_nodup base clean O E 0 s.basis hs).2.2.2.1
 have zOut:=(zero_regs L LowAccCarryDevelop.layout_nodup base clean O' E 0 (run loopNC m s).basis f.2).2.2.2.1
