/-- Hosted `entryRef_step` on the caller domain. -/
theorem hostedEntryRef_stepD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hE : EntrySupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (X Y kx ky : Fp) (G : Bool) (origin : BasisState)
    (hx : X+(if G then kx else 0)≠0) :
    Triple (PointDialogValues L X Y G origin)
      (fusedY L ky ++ E1QubitPlacement.entryM L kx ++
        StairConcreteAssembly.hostedEntryRest L)
      (PointDialogValues L (X+(if G then kx else 0))
        ((Y+(if G then ky else 0))/(X+(if G then kx else 0))) G origin) := by
  have config := MappedCompressed.LaneA.laneLogical_config
  have above : History5.HistoryAbove base := by intro j hj; simp [base]
  have add := fastStep_addX L hw hn X Y G origin kx
  have divide := division_stepD
    (StairHostsSchedule.entryKernel StairConcreteAssembly.checkpointPrimitives
      StairConcreteAssembly.hostPlan) hE
    (StairCallerReplay.hostedEntry_correct H) L hw hn config.1 above config.2.1 config.2.2
    (X+(if G then kx else 0)) Y ky G origin hx
