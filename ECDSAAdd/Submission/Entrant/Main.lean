    (domain:WideReference.Domain 420 x p raw) (z:SkywalkNat.State) (small:Shadow7.SmallIfFar 39 15 z) (G S:Bool)
    (input:SkywalkIntegerInput EndTick4207.L (encode G S z.u z.v).a (encode G S z.u z.v).b G raw.basis)
