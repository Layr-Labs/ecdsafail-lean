theorem after_encoded15E (j : Fin 4) (P : Program) (outPorts : Ports) (d : Bool) (row : Nat)
    (src : State) (m : List Bool)
    (final : Frame outPorts (code d) row (run P (m.drop (measurementCount (routed15E j 0 1)))
      (run (routed15E j 0 1) m src)))
    (i : Fin 157) (hi : 16 ≤ i.val) (q : Wire) (slot : outPorts i = q)
    (free : ¬ MayTouch15E j (windowNet15E j q)) : (run (body15E j P) m src).basis q = false := by
