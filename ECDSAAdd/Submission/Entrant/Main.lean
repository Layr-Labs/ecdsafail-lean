theorem trueControls15E (j : Fin 4) (z : SkywalkNat.State) (small : LeaveJ7.Small7 (sb15E (start15E j)) z)
    (odd : z.v % 2 = 1) (room : high (sb15E (start15E j)) 15 z + 1 < 2 ^ wp15E (start15E j))
    (v : BasisState)
    (bits : ∀ i < 16, v (a015E (start15E j) - 1 + i) = (TrueMiddle15E.X j z).testBit i)
    (par : parityBits15E (ports15E j) v = oddBits (letters 15 (TrueMiddle15E.r j z))) :
    let k := LeaveSelector.actualMode (sb15E (start15E j)) z
    (crossing (ports15E j) k).read v = (if far (sb15E (start15E j)) 15 z then !cross17 (TrueMiddle15E.d j z) else false) ∧
    (far (sb15E (start15E j)) 15 z → (signExpr (ports15E j) k).read v =
      (!(decide (2 ^ sb15E (start15E j) ≤ z.u)) && IntegerHigh.negative (oddBits (letters 15 (TrueMiddle15E.r j z))))) := by
  let k := LeaveSelector.actualMode (sb15E (start15E j)) z
  have hmp : enabled k = decide (far (sb15E (start15E j)) 15 z) ∧
      (far (sb15E (start15E j)) 15 z → key k = (TrueMiddle15E.key j z).val) ∧
      (far (sb15E (start15E j)) 15 z → LeaveSelector.right k = !decide (2 ^ sb15E (start15E j) ≤ z.u)) := by
    by_cases hf : far (sb15E (start15E j)) 15 z
    · have hmk := LeaveSelector.modeKey (sb15E (start15E j)) z hf
      refine ⟨hmk.2.2.trans (decide_eq_true hf).symm, fun _ => hmk.1, fun _ => hmk.2.1⟩
    · refine ⟨?_, fun h => absurd h hf, fun h => absurd h hf⟩
      simp [k, actualMode, farMode, ofFlags, enabled, decide_eq_false hf]
  constructor
  · unfold crossing; by_cases hf : far (sb15E (start15E j)) 15 z
    · rw [if_pos (hmp.1.trans (decide_eq_true hf)), if_pos hf, Expr.read, ports15E, hmp.2.1 hf,
        bits _ (TrueMiddle15E.key j z).isLt, Nat.testBit_eq_decide_div_mod_eq]
      have hfar := LeaveJ7.Far.far_result (sb15E (start15E j)) (wp15E (start15E j)) z small hf odd room
      change decide (TrueMiddle15E.d j z % 2 = 1) = !cross17 (TrueMiddle15E.d j z)
      have h1 : TrueMiddle15E.d j z + 1 =
          (cross17 (TrueMiddle15E.d j z)).toNat +
            2 * (!(cross17 (TrueMiddle15E.d j z) &&
              (!decide (2 ^ sb15E (start15E j) ≤ z.u) && IntegerHigh.negative (oddBits (letters 15 (TrueMiddle15E.r j z)))))).toNat :=
        hfar.1
      cases hc : cross17 (TrueMiddle15E.d j z) <;>
        cases hn : (!decide (2 ^ sb15E (start15E j) ≤ z.u) && IntegerHigh.negative (oddBits (letters 15 (TrueMiddle15E.r j z)))) <;>
        rw [hc, hn] at h1
      · simp only [Bool.false_and, Bool.not_false, Bool.toNat_false, Bool.toNat_true] at h1
        rw [show TrueMiddle15E.d j z = 1 by omega]; rfl
      · simp only [Bool.false_and, Bool.not_false, Bool.toNat_false, Bool.toNat_true] at h1
        rw [show TrueMiddle15E.d j z = 1 by omega]; rfl
      · simp only [Bool.true_and, Bool.not_false, Bool.toNat_true] at h1
        rw [show TrueMiddle15E.d j z = 2 by omega]; rfl
      · simp only [Bool.true_and, Bool.not_true, Bool.toNat_true, Bool.toNat_false] at h1
        rw [show TrueMiddle15E.d j z = 0 by omega]; rfl
    · rw [if_neg (by rw [hmp.1, decide_eq_false hf]; decide), if_neg hf]; rfl
  · intro hf
    by_cases hu : 2 ^ sb15E (start15E j) ≤ z.u
    · rw [signExpr, hmp.2.2 hf, decide_eq_true hu]; rfl
    · have hrt : LeaveSelector.right k = true := (hmp.2.2 hf).trans (by rw [decide_eq_false hu]; rfl)
      have hrails := (LeaveShadowRails.rail (sb15E (start15E j)) z (small.1 hf) hf).2 (Nat.lt_of_not_ge hu)
      have heq : TrueMiddle15E.r j z = ⟨z.u, (TrueMiddle15E.r j z).v⟩ := SkywalkNat.State.ext hrails.1 rfl
      have hlead : IntegerHigh.lead (oddBits (letters 15 (TrueMiddle15E.r j z))) = key k := by
        have hg' := hrails.2.2; rw [hrails.1] at hg'
        rw [heq, lead_wait 15 _ _ hg', hmp.2.1 hf]; simp [TrueMiddle15E.key, hu]
      rw [decide_eq_false hu, Bool.not_false, Bool.true_and, signExpr, hrt, Bool.true_and,
        IntegerHigh.negative, hlead]
      by_cases hz : 0 < key k
      · have hz' : 0 < key (actualMode (sb15E (start15E j)) z) := hz
        simp only [decide_eq_true hz', decide_eq_true hz, if_true, suffixExpr, Bool.true_and]
        rw [fold_suffix15E, Expr.read, Bool.true_and, ← par, parityBits15E, ← List.map_drop, List.all_map]
        rfl
      · have hz' : ¬ 0 < key (actualMode (sb15E (start15E j)) z) := hz
        simp only [decide_eq_false hz', decide_eq_false hz, Bool.false_eq_true, if_false, Expr.read, Bool.false_and]

private theorem move15E_geom : ∀ j : Fin 4,
