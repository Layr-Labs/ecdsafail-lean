    (head_append_sub _ _ _ _ (Finset.Subset.refl _)
      (head_append_sub _ _ _ _ (head_append_sub _ _ _ _ (head_append_sub _ _ _ _
        (head_append_sub _ _ _ _ (head_append_sub _ _ _ _ (head_append_sub _ _ _ _ h1 h2) h3)
