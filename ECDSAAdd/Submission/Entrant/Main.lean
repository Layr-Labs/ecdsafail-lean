  omega


theorem slot_mstart (retired : Wire) (w : Nat→Wire) (sign : Wire)
    (hn : (Q6EndpointCell.ports w sign).wires.Nodup)
    (member : retired∈(Q6EndpointCell.ports w sign).carry.take 254) :
