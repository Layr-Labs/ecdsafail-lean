    exact ⟨run_no_measurement_phase _ zero s m,h.1,
      h.2.1.trans (decide_eq_decide.mpr bound.2.2),h.2.2⟩
  · intro s m value
    have top := regValue_highBit L.low L.rmsb s.basis
