  obtain ⟨originalPrefix, originalCore⟩ := v.parts
  have original := CRTBarrel.LeaveSplice.moved_valid (j := j) (by decide) hi h
  change CRTBarrel.LeaveSplice.Valid s (DeadJoin.referenceOps (start j)) at original
