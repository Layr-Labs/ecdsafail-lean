  (yBit ((WeierstrassCurve.Affine.Point.zero : Point)+(WeierstrassCurve.Affine.Point.zero : Point))) (exceptionBit (WeierstrassCurve.Affine.Point.zero : Point)) layout.point.x
  (layout.dialogPool.take 253) (yLow layout) layout.control layout.point.finite
