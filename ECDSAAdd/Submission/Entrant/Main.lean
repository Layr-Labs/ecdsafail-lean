  let seq := fun i => if i = 0 then top else Shadow7.bankW 150 (L + i - 1)
  [.x top] ++ xsG hi ++
  chainG (Shadow7.storeW 150) seq [.cx (Shadow7.storeW 150 (H + 1)) 1557, .x 1557] 0 (H + 1) ++
  xsG hi.reverse ++ [.x top]

