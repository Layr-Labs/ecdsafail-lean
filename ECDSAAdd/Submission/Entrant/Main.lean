 theorem normalize_free_wire {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) (q : Wire)
 (hxy:q∉layout.point.x++layout.point.y) (hw:∀i:Fin 9,q≠w i.val) : q∉wires (ControlPointEncodingDevelop.normalize (.some hc)) := by
