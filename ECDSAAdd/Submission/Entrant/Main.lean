  obtain ⟨a2,r3,e3⟩ := kseq (copyRegister (some control) src (L.inputBank.take src.length)++(LowZero48Square.make L (LowZero48LowK.kg L ext src dst))) (eraseMask control src (L.inputBank.take src.length)) a3 s
