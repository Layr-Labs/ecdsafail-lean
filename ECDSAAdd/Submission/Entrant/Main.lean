  unfold physicalCells15E StairArchiveRaw.read
  rw [readCells_drop15E _ 0 15 5 _ (by decide), ← List.getD_eq_getElem?_getD,
    List.getD_eq_getElem?_getD, readCells_getD15E _ (0 + 5) (15 - 5) (i.val / 2) _ (by omega)]
  simp only [Nat.zero_add, nativeRawPort15E, letterBit, cell, mappedBasis15E]
  split_ifs <;> rfl

