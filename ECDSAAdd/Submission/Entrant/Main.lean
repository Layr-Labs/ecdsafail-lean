theorem halfWindowWith_read_support (P : Program) (support : HalfSupport P) (j active hole : Nat)
    (hj : j<102) (ha : active<5) (hh : hole<5) :
    wires (halfWindowWith P j active hole)⊆FrontierReplay1591.readSites (5*j) := by
