namespace ECDSAAdd.Entrant.StairPacket.StockPlacedBack
open Arithmetic MappedCompressed Secp256k1 WideReference StockArchiveBanks StockWalkWindow StockInverseReplay FlagEntry
set_option maxRecDepth 12000
set_option maxHeartbeats 3000000
attribute [local irreducible] run measurementCount Rolling1588TickGap.forward Rolling1588.reverse Shadow20.MixedWindow425.reverse425Cut
theorem pull {d x a s rows} (h:Paired d x a s rows):
    Paired d x (pullState Stair44WalkMap.rest a) (pullState Stair44WalkMap.rest s) rows:=by
  refine ⟨⟨h.equality.1,?_⟩,h.labels,?_,?_⟩
  · intro q off; apply h.equality.2; intro hit; obtain ⟨b,j,atSite⟩:=StockArchiveBanks.bank_rep _ hit
    have eq:siteAt b j=q:=Stair44WalkMap.rest.injective ((StockPlacedWindow.fixed b j).trans atSite)
    exact off (eq ▸ (StockArchiveBanks.mem b j))
  · intro b j; change a.basis (Stair44WalkMap.rest (siteAt b j))=_; rw [StockPlacedWindow.fixed]; exact h.custom b j
  · intro b j; change s.basis (Stair44WalkMap.rest (siteAt b j))=_; rw [StockPlacedWindow.fixed]; exact h.stock b j
def R (P:Program):Program:=renameProgram Stair44WalkMap.rest P
def remaining (d:Bool):Program:=R (Rolling1588.reverse d 16 29)++renameProgram Stair44WalkMap.first (Rolling1588.reverse d 1 15)
theorem split (d:Bool) (n:Nat):WindowWalkCosts.backward d n=R (StockBackWindow.backwards d n)++remaining d:=by
  simp only [WindowWalkCosts.backward,StockBackWindow.backwards,R,remaining,renameProgram,List.map_append,List.append_assoc]
theorem old_split_false (n:Nat):Stair44WalkRun.backward false (410+n)=R (Rolling1588.reverse false 45 (381+n))++remaining false:=by
  have e:=StairRestSupport.reverse_append false 29 16 (381+n)
  change Rolling1588.reverse false 16 (29+(381+n))=Rolling1588.reverse false 45 (381+n)++Rolling1588.reverse false 16 29 at e
  rw [show 410+n=29+(381+n) by omega]
  simp only [remaining,Stair44WalkRun.backward,e,R,renameProgram,List.map_append,List.append_assoc]

theorem rename_rest_firstUnpackTail :
    R WindowWalkCosts.firstUnpackTail = WindowWalkCosts.firstUnpackTail := by
  have h1 : renameProgram Stair44WalkMap.rest (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) =
      renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425) := EndOrient425.rename_rest
  have h2 : renameProgram Stair44WalkMap.rest (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)) =
      renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425) := by
    have hfix : ∀ q ∈ wires (renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)),
        Stair44WalkMap.rest q = q := by decide +kernel
    exact (renameProgram_congr_support Stair44WalkMap.rest id _ hfix).trans (StairField2V3Win.renameProgram_id' _)
  rw [R, WindowWalkCosts.firstUnpackTail, Six505.rename_append, h1, h2]

theorem old_split_true :
    WindowWalkCosts.firstUnpackTail ++ Stair44WalkRun.backward true 409 =
      R (WindowWalkCosts.firstUnpackTail ++ Rolling1588.reverse true 45 380) ++ remaining true := by
  have e := StairRestSupport.reverse_append true 29 16 380
  change Rolling1588.reverse true 16 (29+380) =
    Rolling1588.reverse true 45 380 ++ Rolling1588.reverse true 16 29 at e
  rw [show (409:Nat) = 29 + 380 from rfl]
  simp only [remaining, Stair44WalkRun.backward, e, R, Six505.rename_append,
    show renameProgram Stair44WalkMap.rest WindowWalkCosts.firstUnpackTail = WindowWalkCosts.firstUnpackTail from rename_rest_firstUnpackTail,
    List.append_assoc]

theorem backwardFalse (n x:Nat) (good:Bounds x p) (bound:426+n≤512) (raw a ref:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 45 raw.basis) (norm:NewNormalized false x)
    (pair:Paired false x a ref (StockRowVector.rows x p))
    (agree:poolEq (pullState Stair44WalkMap.rest ref) (run (Rolling1588TickGap.forward false 45 (381+n)) [] (pullState (OB5.sig 44) raw))):
    ∃old,run (WindowWalkCosts.backward false n) m a=run (Stair44WalkRun.backward false (410+n)) old ref:=by
  let A:=R (StockBackWindow.backwards false n)
  let B:=R (Rolling1588.reverse false 45 (381+n))
  let tail:=m.drop (measurementCount A)
  have eq:run A m a=run B m ref:=by
    apply MappedCompressed.pullState_perm_injective Stair44WalkMap.rest
    simp only [A,B,R,run_rename _ Stair44WalkMap.rest.injective]
    exact StockBackWindow.resultFalse n x good bound raw _ _ m stage norm (pull pair) agree
  refine ⟨pfx (measurementCount B) m++tail,?_⟩
  rw [split,old_split_false,Stair44PointSecond.joinRecords,run_append,run_take]
  exact congrArg (run (remaining false) tail) eq

theorem backwardTrue (x:Nat) (good:Bounds x p) (raw a ref:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 45 raw.basis) (norm:NewNormalized true x)
    (pair:Paired true x a ref (StockRowVector.rows x p))
    (agree:poolEq (pullState Stair44WalkMap.rest ref)
      (run (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead) [] (pullState (OB5.sig 44) raw))):
    ∃old,run (WindowWalkCosts.backward true 0) m a=
      run (WindowWalkCosts.firstUnpackTail ++ Stair44WalkRun.backward true 409) old ref:=by
  let A:=R (StockBackWindow.backwards true 0)
  let B:=R (WindowWalkCosts.firstUnpackTail ++ Rolling1588.reverse true 45 380)
  let tail:=m.drop (measurementCount A)
  have eq:run A m a=run B m ref:=by
    apply MappedCompressed.pullState_perm_injective Stair44WalkMap.rest
    simp only [A,B,R,run_rename _ Stair44WalkMap.rest.injective]
    exact StockBackWindow.resultTrue x good raw _ _ m stage norm (pull pair) agree
  refine ⟨pfx (measurementCount B) m++tail,?_⟩
  rw [split,old_split_true,Stair44PointSecond.joinRecords,run_append,run_take]
  exact congrArg (run (remaining true) tail) eq
end ECDSAAdd.Entrant.StairPacket.StockPlacedBack

