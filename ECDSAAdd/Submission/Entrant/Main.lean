    Challenge.gateSlots (endPacket divide)=Challenge.gateSlots (FrontierSW1591.endPacketS divide)+2 := by
  simpa only [endPacket,FrontierSW1591.endPacketS,Baselines.rename_gateSlots] using rawEnd_slots divide

