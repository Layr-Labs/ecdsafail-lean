  have bounds : 515≤k ∧ k<2613 := by
    simp only [Q1591Resources.genericOmissions,List.mem_cons,List.not_mem_nil,or_false] at hk
    omega
  exact Offset.generic_free layout layout_widths layout_nodup D S P k bounds
