theorem rawPorts_parked_eq (raw s : State) (n f u : Bool)
    (cut : PackedCut loPairs hiPairs 440 1615 1613 1614 n f u (pullState (OB5.sig 424) raw) (eraseSites src s)) :
    ∀ i : Fin 23,
      (ParkEndpoint425.stash s (pullState (OB5.sig 424) raw)).basis (rawPorts ⟨i, by omega⟩) =
        s.basis (if i.val < 20 then rawPorts ⟨i, by omega⟩ else src.getD (i.val - 20) 0) := by
  intro i
  by_cases h20 : i.val < 20
  · simp only [h20, ↓reduceIte]
    have hp := head_parked425 i; simp only [h20, ↓reduceIte] at hp
    have eq := cut.unchanged _ hp.2.2.1 hp.2.2.2.1 hp.2.2.2.2.1 hp.2.2.2.2.2
    simpa [ParkEndpoint425.stash, eraseSites, hp.1, hp.2.1] using eq.symm
  · simp only [h20, ↓reduceIte]
    have hcases : i.val = 20 ∨ i.val = 21 ∨ i.val = 22 := by have := i.isLt; omega
    rcases hcases with h | h | h
    · have hi : rawPorts ⟨i.val, by omega⟩ = 874 := by
