  have hg := geom15E_facts j; have hw := width15E j
  have r : railP (start15E j + 15) ≤ 258 := by unfold railP; split_ifs <;> omega
  have hi' : i < W.compactSkywalkTickPreWidth (start15E j + 15) := by omega
  rw [L15E, W.compactSkywalkTick_a base (start15E j + 15) (by omega),
    W.compactSkywalkTick_b base (start15E j + 15) (by omega),
    W.wireBlock_getD base (start15E j + 15) _ i hi', W.wireBlock_getD base 770 _ i hi']
  unfold OB5.sig base
  constructor <;> (rw [if_neg (by (try unfold Wire); omega)]; (try unfold Wire); omega)

theorem shortMapping15E (j : Fin 4) (i : Nat) (hi : i < sb15E (start15E j)) :
    windowNet15E j ((shortL15E j).a.getD i 0) = start15E j + 31 + i ∧
    windowNet15E j ((shortL15E j).b.getD i 0) = 786 + i := by
  have hg := geom15E_facts j
  have ga : (shortL15E j).a.getD i 0 = start15E j + 31 + i := by
    show ((start15E j + 15 + 16) :: (List.range' (start15E j + 15 + 16 + 1) (smallBits15E j + 15) ++
      [start15E j + 15 + 16 + (smallBits15E j + 15 + 1)])).getD i 0 = _
    rcases i with _ | i
    · rfl
    · have hlen : i < (List.range' (start15E j + 15 + 16 + 1) (smallBits15E j + 15)).length := by
        rw [List.length_range']; unfold smallBits15E; omega
      rw [List.getD_cons_succ, List.getD_append _ _ _ _ hlen, List.getD_eq_getElem?_getD,
        List.getElem?_range' (by unfold smallBits15E; omega), Option.getD_some]; omega
  have gb : (shortL15E j).b.getD i 0 = 786 + i := by
    show (786 :: (List.range' 787 (smallBits15E j + 15) ++ [786 + (smallBits15E j + 15 + 1)])).getD i 0 = _
    rcases i with _ | i
    · rfl
    · have hlen : i < (List.range' 787 (smallBits15E j + 15)).length := by
        rw [List.length_range']; unfold smallBits15E; omega
      rw [List.getD_cons_succ, List.getD_append _ _ _ _ hlen, List.getD_eq_getElem?_getD,
        List.getElem?_range' (by unfold smallBits15E; omega), Option.getD_some]; omega
  rw [ga, gb]; unfold windowNet15E OB5.sig
  constructor <;> rw [if_neg (by (try unfold Wire); omega)]

theorem wide15E (j : Fin 4) (a : SkywalkNat.State) (G sg : Bool) (raw : State)
    (input : SkywalkIntegerInput (L15E j) (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis)
    (i : Fin (railP (start15E j + 15))) :
    let o := pullState (OB5.sig (start15E j + 14)) raw
    let e := PortalValues.negative sg a.u
    let pos := (a.u + a.v).testBit i.val
    let neg := (a.u - e.toNat).testBit i.val ^^ e
    o.basis (start15E j + 31 + i.val) = (if G then neg else pos) ∧ o.basis (786 + i.val) = (if G then pos else neg) := by
  have hg := geom15E_facts j; have hw := width15E j
  have maxA : railP (start15E j + 15) ≤ (L15E j).a.length := by
    rw [L15E, W.compactSkywalkTick_a base (start15E j + 15) (by omega), wireBlock_length]; omega
  have maxB : railP (start15E j + 15) ≤ (L15E j).b.length := by
    rw [L15E, W.compactSkywalkTick_b base (start15E j + 15) (by omega), wireBlock_length]; omega
  have h := LeaveSignedCoordinates.pair (L15E j) G sg a.u a.v i.val raw.basis input.1 input.2.1 input.2.2.1
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  rw [(wideMapping15E j i.val i.isLt).1, (wideMapping15E j i.val i.isLt).2] at h; exact h

theorem short15E (j : Fin 4) (a : SkywalkNat.State) (G sg : Bool) (s : State)
    (ready : onRails15E j 15 (SkywalkRails.encode G sg a.u a.v) s.basis) (i : Fin (sb15E (start15E j))) :
    let e := PortalValues.negative sg a.u
    let pos := (a.u + a.v).testBit i.val
    let neg := (a.u - e.toNat).testBit i.val ^^ e
    s.basis (start15E j + 31 + i.val) = (if G then neg else pos) ∧ s.basis (786 + i.val) = (if G then pos else neg) := by
  have hg := geom15E_facts j
  have maxA : sb15E (start15E j) ≤ (shortL15E j).a.length := by
    show sb15E (start15E j) ≤ ((start15E j + 15 + 16) :: (List.range' (start15E j + 15 + 16 + 1) (smallBits15E j + 15) ++
      [start15E j + 15 + 16 + (smallBits15E j + 15 + 1)])).length
    simp only [List.length_cons, List.length_append, List.length_range', List.length_singleton]; unfold smallBits15E; omega
  have maxB : sb15E (start15E j) ≤ (shortL15E j).b.length := by
    show sb15E (start15E j) ≤ (786 :: (List.range' 787 (smallBits15E j + 15) ++ [786 + (smallBits15E j + 15 + 1)])).length
    simp only [List.length_cons, List.length_append, List.length_range', List.length_singleton]; unfold smallBits15E; omega
  have prev : mappedBasis15E j s.basis (shortL15E j).previous = G := by cases G <;> exact ready.2.2.1
  have h := LeaveSignedCoordinates.pair (shortL15E j) G sg a.u a.v i.val (mappedBasis15E j s.basis) ready.1 ready.2.1 prev
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  unfold mappedBasis15E at h; dsimp only at h
  rw [(shortMapping15E j i.val i.isLt).1, (shortMapping15E j i.val i.isLt).2] at h; exact h

attribute [local irreducible] run SkywalkNat.step barrel15E core15EProg fullProg15E beforeStore15E storeMapped15E leaveP15E leaveUnred15E in
theorem highZero15E (j : Fin 4) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs15E j s z g0 s0)
    (top : ∀ q : Nat, a015E (start15E j) + 16 ≤ q → q ≤ start15E j + 30 + railP (start15E j + 15) → s.basis q = false) :
    ∀ i : Fin (nextWp15E (start15E j) - 2),
      (run (leaveP15E j) m s).basis (a015E (start15E j) + lows15E (start15E j) - 1 + i.val) = false := by
  have hg := geom15E_facts j
  have tg := tail15E_geom j; dsimp only at tg
  have ha0 : a015E (start15E j) = start15E j + sb15E (start15E j) + 32 := rfl
  have hb0 : b015E (start15E j) = 787 + sb15E (start15E j) := rfl
  let u := LeaveJ7.Admission.flags z g0 s0
  let xs := SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)
  have par := recordedParity15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record
  have ev := recordedEvents15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record
  have w := whole15E_result j s m z u.1 u.2 ⟨h.farSmall, h.endSmall⟩ h.odd h.room h.fit h.nextFarSmall
    h.ready h.fresh h.scratch h.temp h.clean h.cPool h.crtScratch h.padding h.bank h.zero par h.far h.side ev.2
    (recordedFlag15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record h.far h.side)
    xs (SkywalkTrace.trace_length _ _) (LeaveJ7.Far.certifiedChain _ _ _ _ ⟨h.farSmall, h.endSmall⟩ h.odd)
    (LeaveJ7.Far.firstSwap _ _ _ _ ⟨h.farSmall, h.endSmall⟩ h.odd) (fun i hi => ev.1 i (by omega))
  have hflag := recordedFlag15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record h.far h.side
  have hc := core15E_result j s m z u.1 u.2 ⟨h.farSmall, h.endSmall⟩ h.odd h.room h.fit h.ready
    h.fresh h.scratch h.temp h.clean (h.cPool 1613 (by decide) (by omega)) (h.cPool 1614 (by decide) (by omega))
    h.crtScratch h.padding h.bank h.zero par h.far h.side ev.2 hflag
  have hbs := beforeStore15E_result j s m z u.1 u.2 ⟨h.farSmall, h.endSmall⟩ h.odd h.room h.fit h.nextFarSmall
    h.ready h.fresh h.scratch h.temp h.clean h.cPool h.crtScratch h.padding h.bank h.zero par h.far h.side ev.2 hflag
  have hprev : s.basis (start15E j + 30) = u.1 := by
    have hr := h.ready.2.2.1
    have hp : start15E j + 30 = windowNet15E j (IntegerPacket.ports (shape15E j) 15).previous := by
      have : ∀ k : Fin 4, start15E k + 30 = windowNet15E k (IntegerPacket.ports (shape15E k) 15).previous := by decide +kernel
      exact this j
    rw [hp]; cases hu : (LeaveJ7.Admission.flags z g0 s0).1 <;> simpa only [u, hu, mappedBasis15E, SkywalkRails.encode] using hr
  have hlc := lowClose15E_result j s (run (beforeStore15E j) m s) (m.drop (measurementCount (beforeStore15E j)))
    u.1 (PortalValues.negative u.2 (step^[15] z).u) ((step^[15] z).u + (step^[15] z).v)
    ((step^[15] z).u - (PortalValues.negative u.2 (step^[15] z).u).toNat)
    hprev hbs.2.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.2.2.1
  rw [(leaveP15E_pair j s z g0 s0 h).1 m]
  intro i
  have hi := i.isLt
  have hwb := w.2.2.2.2.2.2.2.2.2.2 (a015E (start15E j) + lows15E (start15E j) - 1 + i.val)
  rw [((moves15E_targets j).2.2.2.2.2.2.1 i).2, writeBit, Function.update_of_ne (by (try unfold Wire); omega)] at hwb
  rw [hwb, show run (storeMapped15E j) m s =
      run (GateMirror.forward (leaveLowClose15E (start15E j))) (m.drop (measurementCount (beforeStore15E j)))
        (run (beforeStore15E j) m s) by simp only [storeMapped15E, run_append, run_take]]
  have hnotLow : (a015E (start15E j) + lows15E (start15E j) - 1 + i.val : Wire) ∉ RailPair.sites (low15E j) := by
    intro hm; obtain ⟨p, hp, hq⟩ := List.mem_flatMap.mp hm; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp
    rw [List.mem_range] at hk; simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with e | e <;> (unfold Wire at *; omega)
  have hnotHist : (a015E (start15E j) + lows15E (start15E j) - 1 + i.val : Wire) ∉ history15E j := by
    intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
  have hnotSM : (a015E (start15E j) + lows15E (start15E j) - 1 + i.val : Wire) ∉ smallM15E j := by
    intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
  rw [hlc.2.2.2 _ hnotLow hnotHist,
    hbs.2.2.2.2.2.2.2.2.2.1 _ (by (try unfold Wire); omega) (by (try unfold Wire); omega) (by (try unfold Wire); omega),
    hbs.2.2.2.2.2.2.2.2.2.2 _ (by (try unfold Wire); omega) (by (try unfold Wire); omega) hnotSM]
  by_cases h17 : lows15E (start15E j) + i.val < 17
  · have hfr : ((columns15E (start15E j))[lows15E (start15E j) + i.val]'(by simp [columns15E]; exact h17)).free =
        a015E (start15E j) + lows15E (start15E j) - 1 + i.val := by
      simp only [columns15E, List.getElem_map, List.getElem_range, HighBankJoin.Column.free, decide_eq_true_eq]
      rw [if_neg (by omega)]; (try unfold Wire); omega
    have hcf := hc.2.2.1 ⟨lows15E (start15E j) + i.val, h17⟩; dsimp only at hcf; rwa [hfr] at hcf
  · have haway : HighBankBarrel.outside (bankW15E (start15E j)) (wp15E (start15E j) + 15) (a015E (start15E j) + lows15E (start15E j) - 1 + i.val) ∧
        (∀ col ∈ columns15E (start15E j), (a015E (start15E j) + lows15E (start15E j) - 1 + i.val : Wire) ≠ col.shadow ∧
          (a015E (start15E j) + lows15E (start15E j) - 1 + i.val : Wire) ≠ col.tube) := by
      refine ⟨fun t ht e => ?_, fun col hcol => ?_⟩
      · rcases bank15E_cases j ht with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;> (rw [eb] at e; unfold Wire at *; omega)
      · obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hcol; rw [List.mem_range] at ht
        rcases bank15E_cases j (i := t) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
          (dsimp only; rw [eb]; unfold Wire at *; omega)
    rw [hc.2.2.2.2.2.2.2.2.2.2.2.2.2.2 _ (by omega) (by omega) (by omega) (by omega) haway.1 haway.2,
      entry15E_keep j _ (by omega) s m]
    exact top _ (by omega) (by omega)

attribute [local irreducible] run SkywalkNat.step leaveP15E leaveUnred15E in
theorem boundaryRails15E (j : Fin 4) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs15E j s z g0 s0)
    (top : ∀ q : Nat, a015E (start15E j) + 16 ≤ q → q ≤ start15E j + 30 + railP (start15E j + 15) → s.basis q = false)
    (raw : State)
    (input : let a := step^[15] z; let u := LeaveJ7.Admission.flags z g0 s0
      SkywalkIntegerInput (L15E j) (SkywalkRails.encode u.1 u.2 a.u a.v).a
        (SkywalkRails.encode u.1 u.2 a.u a.v).b u.1 raw.basis) :
    let o := pullState (OB5.sig (start15E j + 14)) raw
    let out := run (leaveP15E j) m s
    (∀ i : Fin (sb15E (start15E j) + lows15E (start15E j)),
      out.basis (start15E j + 31 + i.val) = o.basis (start15E j + 31 + i.val) ∧
      out.basis (786 + i.val) = o.basis (786 + i.val)) ∧
    ∀ i : Fin (nextWp15E (start15E j) - 2),
      out.basis (a015E (start15E j) + lows15E (start15E j) - 1 + i.val) = false ∧
      out.basis (b015E (start15E j) + lows15E (start15E j) - 1 + i.val) =
        (if o.basis (start15E j + 30) then o.basis (b015E (start15E j) + lows15E (start15E j) - 1 + i.val)
         else o.basis (a015E (start15E j) + lows15E (start15E j) - 1 + i.val)) := by
  have hg := geom15E_facts j
  have tg := tail15E_geom j; dsimp only at tg
  have ha0 : a015E (start15E j) = start15E j + sb15E (start15E j) + 32 := rfl
  have hb0 : b015E (start15E j) = 787 + sb15E (start15E j) := rfl
  let a := step^[15] z
  let r15 := step^[15] (TrueMiddle15E.r j z)
  let u := LeaveJ7.Admission.flags z g0 s0
  let xs := SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)
  let o := pullState (OB5.sig (start15E j + 14)) raw
  have par := recordedParity15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record
  have ev := recordedEvents15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record
  have w := whole15E_result j s m z u.1 u.2 ⟨h.farSmall, h.endSmall⟩ h.odd h.room h.fit h.nextFarSmall
    h.ready h.fresh h.scratch h.temp h.clean h.cPool h.crtScratch h.padding h.bank h.zero par h.far h.side ev.2
    (recordedFlag15E j s z g0 s0 ⟨h.farSmall, h.endSmall⟩ h.odd h.record h.far h.side)
    xs (SkywalkTrace.trace_length _ _) (LeaveJ7.Far.certifiedChain _ _ _ _ ⟨h.farSmall, h.endSmall⟩ h.odd)
    (LeaveJ7.Far.firstSwap _ _ _ _ ⟨h.farSmall, h.endSmall⟩ h.odd) (fun i hi => ev.1 i (by omega))
  have hz := highZero15E j s m z g0 s0 h top
  have hred := (leaveP15E_pair j s z g0 s0 h).1 m
  have orient : o.basis (start15E j + 30) = u.1 := by
    have geo : (L15E j).previous = OB5.sig (start15E j + 14) (start15E j + 30) := by
      show base (skywalkPoolPreviousId (start15E j + 15)) = _
      unfold skywalkPoolPreviousId base OB5.sig
      rw [if_neg (by omega), if_neg (by unfold Wire; omega)]; (try unfold Wire); omega
    change raw.basis (OB5.sig (start15E j + 14) (start15E j + 30)) = u.1; rw [← geo]; exact input.2.2.1
  have law := LeaveRestoreTruth.truth_shadow7 (sb15E (start15E j)) z h.farSmall u.2
  dsimp only
  constructor
  · intro i
    have fit : i.val < railP (start15E j + 15) := by have := i.isLt; omega
    have ref := wide15E j a u.1 u.2 raw input ⟨i.val, fit⟩
    by_cases low : i.val < sb15E (start15E j)
    · have hw := short15E j r15 u.1 u.2 s h.ready ⟨i.val, low⟩
      have u1 : (run (leaveP15E j) m s).basis (start15E j + 31 + i.val) = s.basis (start15E j + 31 + i.val) :=
        leave15E_keeps j _ (by unfold leaveBox15E; (try unfold Wire); omega) m s
      have u2 : (run (leaveP15E j) m s).basis (786 + i.val) = s.basis (786 + i.val) :=
        leave15E_keeps j _ (by unfold leaveBox15E; (try unfold Wire); omega) m s
      have spos := LeaveJ7.BoundaryRails.sharedDigitLow _ _ (sb15E (start15E j)) i.val law.2.2.2 low
      have smag := LeaveJ7.BoundaryRails.sharedDigitLow _ _ (sb15E (start15E j)) i.val law.2.2.1 low
      dsimp only at ref hw; rw [law.1, spos, smag] at ref
      exact ⟨u1.trans (hw.1.trans ref.1.symm), u2.trans (hw.2.trans ref.2.symm)⟩
    · have hk : i.val - sb15E (start15E j) < lows15E (start15E j) := by have := i.isLt; omega
      have vals := w.2.2.2.2.2.2.2.2.1 ⟨i.val - sb15E (start15E j), hk⟩
      dsimp only at ref vals
      rw [show sb15E (start15E j) + (i.val - sb15E (start15E j)) = i.val by omega,
        show a015E (start15E j) - 1 + (i.val - sb15E (start15E j)) = start15E j + 31 + i.val by omega,
        show b015E (start15E j) - 1 + (i.val - sb15E (start15E j)) = 786 + i.val by omega] at vals
      rw [hred]; exact ⟨vals.1.trans ref.1.symm, vals.2.trans ref.2.symm⟩
  · intro i
    have hi := i.isLt
    have ref := wide15E j a u.1 u.2 raw input ⟨sb15E (start15E j) + lows15E (start15E j) + i.val, by omega⟩
    dsimp only at ref
    rw [show start15E j + 31 + (sb15E (start15E j) + lows15E (start15E j) + i.val) =
          a015E (start15E j) + lows15E (start15E j) - 1 + i.val by omega,
      show 786 + (sb15E (start15E j) + lows15E (start15E j) + i.val) =
          b015E (start15E j) + lows15E (start15E j) - 1 + i.val by omega] at ref
    refine ⟨hz i, ?_⟩
    rw [orient, hred, w.2.2.2.2.2.2.2.2.2.1 i]
    cases hu : u.1 <;> rw [hu] at ref <;>
      simpa only [Bool.false_eq_true, ite_false, ite_true] using (by first | exact ref.1.symm | exact ref.2.symm)

