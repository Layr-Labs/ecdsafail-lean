private theorem ids {j : Nat} (h : Active j) : j∈bankIds := by
  rcases h with h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h <;> simp [h,bankIds]
