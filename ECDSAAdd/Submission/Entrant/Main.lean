theorem SlotBound.program_eq {P Q P0 Q0 : Program} {a b : Nat}
    (x : SlotBound P0 Q0 a b) (hp : P=P0) (hq : Q=Q0) : SlotBound P Q a b := by cases hp;cases hq;exact x


