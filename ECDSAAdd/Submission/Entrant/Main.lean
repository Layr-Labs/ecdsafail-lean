        omega
    have low : regValue L.low s.basis=(magnitude (oddBiased R)).toNat := by
      have v := value
      change regValue (L.low++[L.rmsb]) s.basis=_ at v
      rw [regValue_append] at v
      simpa [regValue,top0] using v
