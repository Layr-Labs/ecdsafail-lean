theorem termVirtual (x : Nat) (hx0 : 0 < x) (hxp : x < ECDSAAdd.p) (u : State)
    (pre1 : ∀ r ∈ futurePayload 12, u.basis r = cmpBits 12 x r)
    (preC : ∀ r ∈ CT, r ∉ futurePayload 12 → u.basis r = false)
    (hsh : ∀ q, base 4000 ≤ q → u.basis q = false) (m1 m2 m3 : List Bool) :
    StairExitLT24.TermVirtual x (u3 m1 m2 m3 u) := by
  obtain ⟨s1, first⟩ := stage1_exists x hx0 hxp
  obtain ⟨ρ, hρ, hrec⟩ := rec505 x hx0 hxp s1 first []
  refine ⟨s1, [], first, ?_, ?_⟩
  · intro q hq
    rw [hrec q]
    apply chk_sound x hx0 hxp u pre1 preC hsh m1 m2 m3 ρ hρ q
    rcases hq with h | h | h
    · exact chk_forward q h
    · have h' : q ∈ wires (StairTerminalV3.reverseRecord ++ StairExitLT24Term.step505) := h
      rw [wires_append, Finset.mem_union] at h'
      rcases h' with h' | h'
