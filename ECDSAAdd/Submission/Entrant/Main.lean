theorem resultW420 (d:Bool) (x:Nat) (good:Bounds x p) (raw s:State) (g sg:Bool) (m:List Bool)
    (domain:Domain 420 x p raw) (input:InputAt 420 (signedAt 420 x p g sg) raw)
