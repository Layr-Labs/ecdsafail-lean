private theorem rename_away (f : Wire→Wire) (hf : Function.Injective f)
    (a b : Wire) (P : Program) (fix : f a=b) (free : a∉wires P) :
    b∉wires (renameProgram f P) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨old,used,eq⟩:=Finset.mem_image.mp used
  exact free (hf (eq.trans fix.symm) ▸ used)

