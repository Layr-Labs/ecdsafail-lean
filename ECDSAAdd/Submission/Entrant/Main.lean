        · exact Or.inr (by simp only [Wire] at *; omega)
      rw [EndOrient425.observes _ hro _ [], StockArchiveBanksW.readback 425 (by decide) _ _ _ hsite]
      have hnot76 : MixedGeo425.slot (MixedGeo425.groupOf b j) (MixedGeo425.index j) ∉ StockGroupsW.ports 45 76 := by
        intro hit; apply hp; obtain ⟨k, _, eq⟩ := Finset.mem_image.mp hit
