    gateSlots mslice45=gateSlots (ECDSAAdd.Entrant.Rolling1588.groups false 1 45)+911 := by
  have first := tailFirstPacket_slot_delta 45
  have middle := groups_slot_delta false 2 43 (by decide)
  have last := tailLastPacket_slot_delta 1
  simp only [Bool.false_and,Bool.false_eq_true,if_false,halfSlotSaving] at middle
  rw [record_mgroups45_shape]
  simp only [mslice45,gateSlots_append]
