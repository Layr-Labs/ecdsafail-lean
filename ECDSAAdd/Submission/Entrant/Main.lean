/-- LT43's multiplication chain with the loan pieces of `loans`. -/
theorem chainXLR_of_planR (loans : StairSchedule.StairLoans) (k x : Nat)
    (plan : ExitPlanR StairConcreteAssembly.checkpointPrimitives k x)
    (V : ExitReachTransportR loans k x) (sub : ExitGroupSub loans) :
    CRel (fun s t => ExitMiddleX k x s ∧ s = t) Eq
      (headEL loans ++ (firstSel StairConcreteAssembly.checkpointPrimitives ++ (grpFL loans 42 98 2 ++ (rseg StairConcreteAssembly.checkpointPrimitives 22 12 490 500 ++ (grpFL loans 37 96 2 ++ (rseg StairConcreteAssembly.checkpointPrimitives 32 22 480 490 ++ (grpFL loans 31 93 3 ++ (rseg StairConcreteAssembly.checkpointPrimitives 47 32 465 480 ++ (grpFL loans 23 90 3 ++ (rseg StairConcreteAssembly.checkpointPrimitives 62 47 450 465 ++ (grpFL loans 14 85 5 ++ (rseg StairConcreteAssembly.checkpointPrimitives 87 62 425 450 ++ (grpFL loans 0 1 84 ++ (lowTail ++ (closeSel StairConcreteAssembly.checkpointPrimitives ++ closeTail k)))))))))))))))
      (headEL loans ++ (grpFL loans 42 98 2 ++ (grpFL loans 37 96 2 ++ (grpFL loans 31 93 3 ++ (grpFL loans 23 90 3 ++ (grpFL loans 14 85 5 ++ (grpFL loans 0 1 84 ++ (lowTail ++ (closeRef ++ closeTail k))))))))) := by
  have junction : CRel (JEXL loans k x) (RelX x 12)
      (firstSel StairConcreteAssembly.checkpointPrimitives) [] :=
    crel_mono (fun s _ hst => ⟨hst.1, V.head s hst.2⟩) (fun _ _ y => y) plan.junction
  have r4 : CRel (RowRelE k x 12 (headEL loans ++ grpFL loans 42 98 2))
      (RowRelE k x 22 (headEL loans ++ grpFL loans 42 98 2))
      (rseg StairConcreteAssembly.checkpointPrimitives 22 12 490 500) [] :=
    stepL V.a plan.rseg4
  have r3 : CRel (RowRelE k x 22 (YAL loans ++ grpFL loans 37 96 2))
      (RowRelE k x 32 (YAL loans ++ grpFL loans 37 96 2))
      (rseg StairConcreteAssembly.checkpointPrimitives 32 22 480 490) [] :=
    stepL V.b plan.rseg3
  have r2 : CRel (RowRelE k x 32 (YBL loans ++ grpFL loans 31 93 3))
      (RowRelE k x 47 (YBL loans ++ grpFL loans 31 93 3))
      (rseg StairConcreteAssembly.checkpointPrimitives 47 32 465 480) [] :=
    stepL V.c plan.rseg2
  have r1 : CRel (RowRelE k x 47 (YCL loans ++ grpFL loans 23 90 3))
      (RowRelE k x 62 (YCL loans ++ grpFL loans 23 90 3))
      (rseg StairConcreteAssembly.checkpointPrimitives 62 47 450 465) [] :=
    stepL V.d plan.rseg1
  have r0 : CRel (RowRelE k x 62 (YDL loans ++ grpFL loans 14 85 5))
      (RowRelE k x 87 (YDL loans ++ grpFL loans 14 85 5))
      (rseg StairConcreteAssembly.checkpointPrimitives 87 62 425 450) [] :=
    stepL V.e plan.rseg0
  have cl : CRel (RowRelE k x 87 ((YEL loans ++ grpFL loans 0 1 84) ++ lowTail)) Eq
      (closeSel StairConcreteAssembly.checkpointPrimitives) closeRef :=
    crel_mono (fun _ t hst => ⟨hst.1, V.f t hst.2⟩) (fun _ _ y => y) plan.close
  refine crel_append (crel_headXL loans k x) (crel_sel_cons (junctionEL junction)
    (crel_append (sharedE k x 12 _ (headEL loans) (away_of_sub _ _ _ sub.1
      (StairField2V3Delta.grpF_away 12 (by decide) 98 2 (by decide))))
    (crel_sel_cons r4
    (crel_append (sharedE k x 22 _ (YAL loans) (away_of_sub _ _ _ sub.2.1
      (StairField2V3Delta.grpF_away 22 (by decide) 96 2 (by decide))))
    (crel_sel_cons r3
    (crel_append (sharedE k x 32 _ (YBL loans) (away_of_sub _ _ _ sub.2.2.1
      (StairField2V3Delta.grpF_away 32 (by decide) 93 3 (by decide))))
    (crel_sel_cons r2
    (crel_append (sharedE k x 47 _ (YCL loans) (away_of_sub _ _ _ sub.2.2.2.1
      (StairField2V3Delta.grpF_away 47 (by decide) 90 3 (by decide))))
    (crel_sel_cons r1
    (crel_append (sharedE k x 62 _ (YDL loans) (away_of_sub _ _ _ sub.2.2.2.2.1
      (StairField2V3Delta.grpF_away 62 (by decide) 85 5 (by decide))))
    (crel_sel_cons r0
    (crel_append (sharedE k x 87 _ (YEL loans) (away_of_sub _ _ _ sub.2.2.2.2.2
      (StairField2V3Delta.grpF_away 87 (by decide) 1 84 (by decide))))
    (crel_append (sharedE k x 87 _ (YEL loans ++ grpFL loans 0 1 84) low_away)
    (crel_append cl (crel_eq_shared (closeTail k))))))))))))))))

/-- **Multiplication core for `bestLoans`** from LT43's record plans with reachability. -/
theorem exitCoreR_best (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (plan : ∀ k x, ExitPlanR StairConcreteAssembly.checkpointPrimitives k x) :
    ∀ k t, StairLoanField7Cores.ExitMiddle k t → ∀ fresh old,
      run (StairLoanField7Cores.exitSelectedRemainderFor StairConcrete.bestLoans k) fresh t =
        run (StairLoanField7Cores.exitReferenceRemainderFor StairConcrete.bestLoans k) old t := by
  intro k t ht fresh old
  obtain ⟨x, hx⟩ := exitMiddle_x k t ht
  have h : ∀ s, ExitMiddleX k x s → ∀ fresh old,
      run (StairLoanField7Cores.exitSelectedRemainderFor StairConcrete.bestLoans k) fresh s =
        run (StairLoanField7Cores.exitReferenceRemainderFor StairConcrete.bestLoans k) old s := by
    rw [selRemL_shape, refRemL_shape]
    apply runEqOn_of_coupled (chainXLR_of_planR _ k x (plan k x)
      (exitReachTransportR_best half k x) exitGroupSub_best)
    intro s hs
    have h := refRem_best_tapeFree half endpoint k s (exitMiddle_of_x k x s hs)
    rw [refRemL_shape] at h
    exact h
  exact h t hx fresh old

