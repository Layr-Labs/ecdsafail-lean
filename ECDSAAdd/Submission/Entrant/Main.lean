/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSemanticComposition_at_Main` -/
section Merge_StairSemanticComposition_at_Main

/-!
# Hosted semantic-composition boundary

The certificate's `semantic_composition` field is parameterized by the
logical, un-hosted `StairSchedule.ReplayInterface`, while the selected
`concreteProgram` contains `StairHostsSchedule.entryKernel` and
`StairHostsSchedule.exitKernel`.  This module keeps the two missing lifts
separate:

* `HostReplay` is the field-13-style equality from the hosted kernels to the
  logical staircase kernels on the exact entry and exit preconditions;
* `CallerReplay` is the outer caller-chain lift from the hosted kernels to the
  selected point program.

Neither contract assumes the desired encoded output.  `CallerReplay` asks for
state equality with the already certified record point program, which is
strictly stronger and lets the final theorem reuse `program_correct_Q`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSemanticComposition

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1

open StairConcreteAssembly

/-- Replay interface for the kernels that actually occur in the hosted
assembly.  This is deliberately distinct from `StairSchedule.ReplayInterface`,
whose programs are the un-hosted logical kernels. -/
structure HostedReplayInterface (k : Nat) : Prop where
  entry : ∀ s, EntryPre s → ∀ fresh old,
    run (StairHostsSchedule.entryKernel checkpointPrimitives hostPlan) fresh s =
      run InverseFiveEntry23.entryKernel15 old s
  exit : ∀ s, ExitPre k s → ∀ fresh old,
    run (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) fresh s =
      run (ParityXExitInverse23Kernel.kernelXN k) old s

/-- The missing hosted-to-logical replay.  These are exactly the clean-host
obligations identified by RV3; in particular they are not consequences of a
mere static rename. -/
structure HostReplay : Prop where
  entry : ∀ s, EntryPre s → ∀ fresh old,
    run (StairHostsSchedule.entryKernel checkpointPrimitives hostPlan) fresh s =
      run (StairSchedule.entryKernel checkpointPrimitives
        StairConcrete.bestLoans) old s
  exit : ∀ k s, ExitPre k s → ∀ fresh old,
    run (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) fresh s =
      run (StairSchedule.exitKernel checkpointPrimitives
        StairConcrete.bestLoans k) old s

/-- Host replay and the logical replay interface compose without sharing a
measurement tape. -/
theorem hostedReplayInterface_of (host : HostReplay)
    (iface : ∀ k, StairSchedule.ReplayInterface
      concreteAssembly.primitives StairConcrete.bestLoans k
      concreteAssembly.entryPre (concreteAssembly.exitPre k)) :
    ∀ k, HostedReplayInterface k := by
  intro k
  constructor
  · intro s hs fresh old
    calc
      run (StairHostsSchedule.entryKernel checkpointPrimitives hostPlan) fresh s =
          run (StairSchedule.entryKernel checkpointPrimitives
            StairConcrete.bestLoans) [] s := host.entry s hs fresh []
      _ = run InverseFiveEntry23.entryKernel15 old s := by
        exact (iface k).entry s hs [] old
  · intro s hs fresh old
    calc
      run (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) fresh s =
          run (StairSchedule.exitKernel checkpointPrimitives
            StairConcrete.bestLoans k) [] s := host.exit k s hs fresh []
      _ = run (ParityXExitInverse23Kernel.kernelXN k) old s := by
        exact (iface k).exit s hs [] old

/-- The remaining caller-chain obligation for field 8.  It is stated as a
run equality with the validated record program, rather than assuming the
certificate postcondition itself.  The old tape is existential because all
replay interfaces deliberately permit independent measurement records. -/
structure CallerReplay : Prop where
  program :
    (∀ k, HostedReplayInterface k) →
    ∀ C b R s fresh, encodes b R s.basis →
      ∃ old, run (concreteProgram C) fresh s =
        run (AboveFieldPointDevelop.programQ C) old s

/-- The only nontrivial branch of `CallerReplay`.  Isolating the finite-point
branch prevents the zero constructor (where both programs are empty) from
being carried as a peer proof obligation. -/
structure FiniteCallerReplay : Prop where
  program :
    (∀ k, HostedReplayInterface k) →
    ∀ cx cy (hc : curve.toAffine.Nonsingular cx cy) b R s fresh,
      encodes b R s.basis →
      ∃ old, run (hostedWrapper (.some hc) cx cy) fresh s =
        run (AboveFieldPointDevelop.wrapperBorrow (.some hc) cx cy) old s

/-- The point-at-infinity branch is definitional; all caller work is confined
to `FiniteCallerReplay`. -/
theorem callerReplay_of_finite (finite : FiniteCallerReplay) : CallerReplay where
  program hosted C b R s fresh hs := by
    cases C with
    | zero =>
        refine ⟨[], ?_⟩
        rfl
    | @some cx cy hc =>
        exact finite.program hosted cx cy hc b R s fresh hs






/-- Exact `StairOpen.semantic_composition` field for the concrete hosted
assembly, conditional only on the two explicitly named hosted lifts. -/
theorem semantic_composition (host : HostReplay) (caller : CallerReplay) :
    (∀ k, StairSchedule.ReplayInterface
      concreteAssembly.primitives StairConcrete.bestLoans k
      concreteAssembly.entryPre (concreteAssembly.exitPre k)) →
    ∀ C b R, Triple (encodes b R) (concreteAssembly.program C)
      (encodes b (if b then R + C else R)) := by
  intro iface C b R s fresh hs
  have hosted : ∀ k, HostedReplayInterface k :=
    hostedReplayInterface_of host iface
  obtain ⟨old, eq⟩ := caller.program hosted C b R s fresh hs
  rw [concreteAssembly_program, eq]
  exact AboveFieldPointDevelop.program_correct_Q C b R s old hs



end ECDSAAdd.Entrant.StairSemanticComposition

end
end Merge_StairSemanticComposition_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCallerReplay_at_Main` -/
section Merge_StairCallerReplay_at_Main

/-!
# Caller-chain replay for the hosted staircase kernels (LT6, field 8)

The record's caller chain consumes its arithmetic kernels only through the
kernel-generic theorems `FrontierEntry1591Callers.division_step` /
`entry_eq` (division kernel: `EntryCorrect K` and `wires K ⊆ logicalSites`)
and `ParityXExitInverse23Kernel.exitN_pw`-style transfers (multiplication
kernel: a point-write relation with `kernelX k` and `wires ⊆ logicalSites`).

This module derives the kernel-level facts for the hosted staircase kernels
from the hosted replay interface (`HostReplay` composed with the logical
`ReplayInterface`), and then replays the record caller chain with the hosted
rests.  The only placement inputs are the two support facts
`wires hostedEntryKernel ⊆ OB5Support.logicalSites` and
`∀ k, wires (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) ⊆ OB5Support.logicalSites`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCallerReplay

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly

attribute [local irreducible] run wires

/-! ## Kernel-level specifications from the hosted replay interface -/

/-- The record's division-kernel specification holds for the hosted kernel. -/
theorem hostedEntry_correct
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k) :
    FrontierEntry1591Callers.EntryCorrect
      (StairHostsSchedule.entryKernel checkpointPrimitives hostPlan) := by
  intro hn hlo ho hf x Y hx0 hx s t m hin hg0 hs0 phase same value
  have frame : EntryFrame t :=
    { sharedNodup := hn, historyAbove := hlo, selectorsAway := ho,
      transcript := hf, x := x, Y := Y, x_pos := hx0, x_lt := hx,
      source := s, input := hin, selectorG_zero := hg0,
      selectorS_zero := hs0, phase := phase, outsideNumerator := same,
      numerator := value }
  have eq := (H 0).entry t ⟨frame⟩ m m
  have h := InverseFiveEntry23.entry_correct15 hn hlo ho hf x Y hx0 hx s t m
    hin hg0 hs0 phase same value
  dsimp only at h ⊢
  rw [eq]
  exact h

/-- The record's multiplication-kernel point-write relation holds for the
hosted kernel. -/
theorem hostedExit_pw
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (k : Nat) (hk : k < p) (hn : (skywalkSharedWires base).Nodup)
    (hlo : History5.HistoryAbove base)
    (ho : ∀ q ∈ [base 2400, base 2409, base 2410], q ∉ skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410)
      (mixedTranscriptTape base))
    (x : Nat) (Y : Fp) (hx0 : 0 < x) (hx : x < p) (s : State) (m : List Bool)
    (input : SkywalkArithmeticInput base x Y.val s.basis)
    (hg : s.basis (base 2409) = false) (hs : s.basis (base 2410) = false) :
    run (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) m s =
      ParityEven.put (run (ParityXExitInverse23Kernel.kernelX k) m s)
        ParityXExitInverse23Kernel.pkP (s.basis (base 2400) && decide (k < x)) := by
  have frame : ExitFrame k s :=
    { k_lt := hk, sharedNodup := hn, historyAbove := hlo, selectorsAway := ho,
      transcript := hf, x := x, Y := Y, x_pos := hx0, x_lt := hx,
      input := input, selectorG_zero := hg, selectorS_zero := hs }
  rw [(H k).exit s ⟨frame⟩ m m]
  exact ParityXExitInverse23Kernel.kernelXN_pw k hk hn hlo ho hf x Y hx0 hx s m
    input hg hs

/-! ## The hosted rests are the kernels after the caller's fused first tick -/

theorem hosted_entry_split (L : ControlledPointLayout) :
    FrontierEntry1591Callers.entry (StairHostsSchedule.entryKernel checkpointPrimitives hostPlan) L =
      E1QubitPlacement.tickF L ++ hostedEntryRest L := by
  have tick := E1QubitPlacement.tick_eq L
  change renameProgram (wireFn2 L)
      (renameProgram Rolling1588Lifetime.phaseHost
        (FrontierEntry1591Native.forward base)) = E1QubitPlacement.tickF L at tick
  simp only [FrontierEntry1591Callers.entry,
    StairHostsSchedule.entryKernel, StairSchedule.firstPhase, hostedEntryRest,
    renameProgram, List.map_append, List.append_assoc] at tick ⊢
  rw [tick]

theorem hosted_exit_split (L : ControlledPointLayout) (k : Nat) :
    FrontierEntry1591Callers.exit (StairHostsSchedule.exitKernel checkpointPrimitives hostPlan k) L =
      E1QubitPlacement.tickF L ++ hostedExitRest L k := by
  have tick := E1QubitPlacement.tick_eq L
  change renameProgram (wireFn2 L)
      (renameProgram Rolling1588Lifetime.phaseHost
        (FrontierEntry1591Native.forward base)) = E1QubitPlacement.tickF L at tick
  simp only [FrontierEntry1591Callers.exit,
    StairHostsSchedule.exitKernel, Rolling1588TickGap.firstPhase, hostedExitRest,
    renameProgram, List.map_append, List.append_assoc] at tick ⊢
  rw [tick]

end ECDSAAdd.Entrant.StairCallerReplay

end
