/-- Multiplication kernel: the hosts before every hosted group and before the
first packet (cut 23). -/
structure ExitHostsClean (k : Nat) : Prop where
  hosts : ∀ jdfc ∈ [(11, 42, 98, 2), (13, 37, 96, 2), (15, 31, 93, 3), (17, 23, 90, 3),
      (19, 14, 85, 5), (21, 0, 1, 84)],
