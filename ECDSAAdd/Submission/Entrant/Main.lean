theorem inverse_boundary (retired : Wire) (L : Layout) (hw : L.Widths) (hn : L.wires.Nodup)
    (member : retired∈(L.carry.take 254).drop 1) (origin : BasisState)
    (F Y : Int) (hf : OddDomain F) (hy : OddDomain Y) :
