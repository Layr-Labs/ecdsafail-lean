/-! ## Walk facts of the CANON v3 primitive provider -/








theorem v3WalkFacts : WalkFacts StairConcreteAssembly.checkpointPrimitives v3Costs where
  tickForward := by
    intro i hi
    have e : StairConcreteAssembly.checkpointPrimitives.tickForward i =
        StairPhysicalPrimitives.tickForward i := rfl
    rw [e]
    simp only [v3Plan, List.map_cons, List.map_nil, List.mem_cons,
      List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;>
      refine tickForward_slots _ ?_ ?_ ?_ <;> decide
  tickReverse := by
    intro i hi
    have e : StairConcreteAssembly.checkpointPrimitives.tickReverse i =
        StairPhysicalPrimitives.tickReverse i := rfl
    rw [e]
    simp only [v3Plan, List.map_cons, List.map_nil, List.mem_cons,
      List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;>
      refine tickReverse_slots _ ?_ ?_ ?_ <;> decide
  middleForward := by
    intro i n hs
    simp only [List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at hs
    rcases hs with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
        ⟨rfl, rfl⟩ <;>
      refine middleForward_slots _ _ ?_ ?_ ?_ <;> decide
  middleReverse := by
    intro i n hs
    simp only [List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at hs
    rcases hs with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
        ⟨rfl, rfl⟩ <;>
      refine middleReverse_slots _ _ ?_ ?_ ?_ <;> decide
  codec := by
    intro B hB
    rw [StairV3Primitives.primitives_pack, StairV3Primitives.primitives_unpack]
    exact codecPair_physical B hB
  orient := by
    intro i B hr
    simp only [v3Plan, List.mem_cons, Prod.mk.injEq, List.not_mem_nil,
      or_false] at hr
    rw [StairV3Primitives.primitives_orient]
    rcases hr with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
        ⟨rfl, rfl⟩ <;>
      exact orient_slots _ _ (by norm_num)
  firstPack := by
    -- LT50 (replay budget): first the abbreviation itself, so every later rewrite is syntactic
    -- (rewriting `primitives.orient` into `checkpointPrimitives.orient …` under `+` cost 11 s)
    rw [show StairConcreteAssembly.checkpointPrimitives = StairV3Primitives.primitives from rfl,
      StairV3Primitives.primitives_firstPack, StairV3Primitives.primitives_orient,
      StairV3Primitives.primitives_pack, StairV3Primitives.firstPack]
    have m := phaseBMove_slots
    -- LT44 (replay budget): the cost constant by an equation, not by unfolding `v3Costs`
    -- (a definitional cast under `+` makes the kernel evaluate the concrete `gateSlots`)
    rw [show v3Costs.firstMove = 176 from rfl]
    simp only [gateSlots_append, rename_gateSlots]
    omega
  firstUnpack := by
    -- LT50 (replay budget): first the abbreviation itself, so every later rewrite is syntactic
    -- (rewriting `primitives.orient` into `checkpointPrimitives.orient …` under `+` cost 11 s)
    rw [show StairConcreteAssembly.checkpointPrimitives = StairV3Primitives.primitives from rfl,
      StairV3Primitives.primitives_firstUnpack, StairV3Primitives.primitives_orient,
      StairV3Primitives.primitives_unpack, StairV3Primitives.firstUnpack]
    have m := phaseBReturn_slots
    rw [show v3Costs.firstReturn = 176 from rfl]
    simp only [gateSlots_append, rename_gateSlots]
    omega
  forwardTerminal := by
    -- LT44 (replay budget): equations instead of `show … + 0` (the definitional cast made the
    -- kernel's `Nat.add` reduction evaluate `gateSlots` of the concrete terminal programs)
    rw [show v3Costs.forwardTerminal = 0 from rfl, Nat.add_zero,
      show StairConcreteAssembly.checkpointPrimitives.forwardTerminal =
        StairTerminalV3.forwardTerminalV3 from rfl]
    rw [StairTerminalV3.forwardTerminalV3_slots, StairTerminalV3.forwardRecord]
    simp only [gateSlots_append]
  reverseTerminal := by
    rw [show v3Costs.reverseTerminal = 0 from rfl, Nat.add_zero,
      show StairConcreteAssembly.checkpointPrimitives.reverseTerminal =
        StairTerminalV3.reverseTerminalV3 from rfl]
    rw [StairTerminalV3.reverseTerminalV3_slots, StairTerminalV3.reverseRecord]
    simp only [gateSlots_append, rename_gateSlots, Nat.add_assoc]

/-! ## Groups: hosting is a rebinding of the placed loaned groups -/




/-! ## Boundary programs -/










/-! ## Field 11 on CANON v3 -/

/-- Exact slot overhead of the CANON v3 program over the record program. -/
theorem slot_totals : ∀ C,
    gateSlots (StairConcreteAssembly.concreteAssembly.program C) ≤
      gateSlots (AboveFieldPointDevelop.programQ C) + 344736 := by
  intro C
  have hc := slot_composition_of_rests StairConcreteAssembly.checkpointPrimitives
    StairConcreteAssembly.hostPlan v3Costs v3Boundary1806 v3WalkFacts
    (v3GroupFacts _) (v3BoundaryFacts _) C
  rw [v3_slotDelta_1806] at hc
  rw [StairConcreteAssembly.concreteAssembly_program, concreteProgram_eq_outer]
  exact hc


/-- **Field 11**: the exact `StairOpen.slot_composition` field for the CANON v3
`concreteAssembly`, against the certificate constant
`StairInventory.bestSlotDelta` (`640,194`, unchanged). -/
theorem slot_composition : ∀ C,
    gateSlots (StairConcreteAssembly.concreteAssembly.program C) ≤
      gateSlots (AboveFieldPointDevelop.programQ C) + StairInventory.bestSlotDelta := by
  intro C
  have hc := slot_totals C
  rw [StairInventory.bestSlotDelta_eq]
  omega


