  rfl

theorem reverseLast_eq : StairSchedule.reverseLast P = invOf termPieces := by
  have hm : P.middleReverse 501 5 = StairReplay.movedReverse wRev 501 5 := by
    show StairPhysicalPrimitivesFix505.middleReverseFix 501 5 = _
    simp only [StairPhysicalPrimitivesFix505.middleReverseFix, segmentOf_501]
  have hp : StairReplay.movedReverse wRev 501 5 =
      StairReplay.movedReverse wRev 505 1 ++ StairReplay.movedReverse wRev 501 4 :=
    movedReverse_top wRev 4 501
  simp only [StairSchedule.reverseLast, invOf, termPieces, List.nil_append, List.append_assoc]
  rw [hm, hp]
  simp only [List.append_assoc]
  rfl



/-- Terminal middle trip (unticks `504 .. 501`) from a virtual stage. -/
theorem terminal_middle_trip (x : Nat) (hx0 : 0 < x) (hx : x < p) (hcop : x.Coprime p)
    (t : State)
    (virtual : ∃ t' : State, t.phase = t'.phase ∧
      (∀ q, q ∈ wires (P.middleForward 501 4) ∨ q ∈ wires (StairReplay.movedReverse wRev 501 4) →
        t.basis q = t'.basis q) ∧
      Rolling1588.Integer.Stage (StairPhysicalPrimitives.midSegmentMap 12) true x p 501 t'.basis)
    (c a : List Bool) :
    run (StairReplay.movedReverse wRev 501 4) a (run (P.middleForward 501 4) c t) = t := by
  obtain ⟨hp0, hodd, hp, hgap⟩ := p_facts
  obtain ⟨t', hph, hag, st⟩ := virtual
  refine trip_of_local _ _ t t' hph hag (fun c' a' => ?_) c a
  rw [terminal_middle_maps]
  show run (StairReplay.movedReverse (StairPhysicalPrimitives.midSegmentMap 12) 501 4) a'
    (run (StairReplay.movedForward (StairPhysicalPrimitives.midSegmentMap
      (StairPhysicalPrimitives.segmentOf 501)) 501 4) c' t') = t'
  rw [segmentOf_501]
  exact StairField2V3ExitMiddle.movedMiddle_roundtrip _
    (StairPhysicalPrimitives.midSegmentMap_pool_nodup 12 (by simp [budgets]))
    (StairPhysicalPrimitives.midSegmentMap_historyAbove 12 (by simp [budgets]))
