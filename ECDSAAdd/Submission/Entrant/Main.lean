    have pos:h pair.1=sum.testBit (144+i.val):=by simpa only [h,pair,if_neg (sites i).2.1] using (words i).1
    have neg:h pair.2=mag.testBit (144+i.val):=by simpa only [h,pair,if_neg (sites i).2.2] using (words i).2
