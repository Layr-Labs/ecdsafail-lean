  by_cases h : src.length=128
  · have wj := LowZero18LowK.jregsH_W L hw ext src dst h hd he
    have je : (LowZero18LowK.jregsH L ext src dst).bank.length=2*(LowZero18LowK.jregsH L ext src dst).h := by
