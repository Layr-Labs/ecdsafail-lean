    intro q nb nl nm
    rw [origEq q, runEq]
    unfold LeaveJ7.AssembleCut.leftovers LeaveJ7.ReleasedOrigin.releasedSite at nl
    rw [show start j20 = 345 from rfl] at nl; simp only [not_or, not_and] at nl
