theorem endPacket_718_free (divide : Bool) : base 718∉wires (FrontierSW1591.endPacketS divide) := by
  have noIds : base 1537∉(base 2409::Q6EndpointCell.ids.map base).toFinset := by
    intro used
    rcases List.mem_cons.mp (List.mem_toFinset.mp used) with same|used
    · have eq:=base_injective same
      omega
    · obtain ⟨i,hi,eq⟩:=List.mem_map.mp used
      have same:=base_injective eq
      simp only [Q6EndpointCell.ids,List.mem_append,List.mem_cons,List.mem_range'_1,
        List.not_mem_nil,or_false] at hi
      omega
  have body : base 1537∉wires (Q6EndpointCell.halfE divide base (base 2409)) := by
    intro used
    exact noIds ((Q6EndpointCell.half_support divide base (base 2409) _
      (Finset.Subset.refl _)) (Q6EndpointCell.halfE_wires divide base (base 2409) used))
  have raw : base 1537∉wires (FrontierSW1591.rawEndS divide) := by
    simpa only [FrontierSW1591.rawEndS,SW.selW,wires_append,wires,Instr.wires,
      correctionWires,Finset.union_empty,Finset.mem_union,Finset.mem_insert,Finset.mem_singleton,
      Finset.notMem_empty,or_false,not_or,base_injective.eq_iff] using
      And.intro (And.intro (by decide : 1537≠510 ∧ 1537≠2409) body)
        (by decide : 1537≠2409 ∧ 1537≠510)
  rw [FrontierSW1591.endPacketS,renameProgram_support]
  intro used
  obtain ⟨old,oldUsed,eq⟩:=Finset.mem_image.mp used
  have fix : shifted Placement5.pi0 (base 1537)=base 718 := by decide +kernel
  have same:=(shifted Placement5.pi0).injective (eq.trans fix.symm)
  exact raw (same ▸ oldUsed)

