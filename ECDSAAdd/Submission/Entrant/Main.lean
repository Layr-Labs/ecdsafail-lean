private theorem watch15E_a (j : Fin 4) (q : Wire)
    (hq : q ∈ (IntegerPacket.ports (shape15E j) 1).a) :
    windowNet15E j q ∈ watch15E j := by
  unfold watch15E; dsimp only
  apply List.mem_map.mpr; refine ⟨q, ?_, rfl⟩
  simp only [List.mem_append]; tauto

private theorem watch15E_congrPlus (j : Fin 4) (s t : State)
    (agree : ∀ q ∈ watch15E j, t.basis q = s.basis q)
    (z : SkywalkRails.State) (active : TickCut15E.onRails15EPlus j 1 z s.basis) :
    TickCut15E.onRails15EPlus j 1 z t.basis := by
  have old := (watch15E_congr j s t agree z active.1).1
  refine ⟨old, ?_⟩
  intro positive
  have hm : 1 ≤ (shape15E j).mid := by simp [shape15E]
  have hp : TickCut.Receiver.highP (shape15E j) 1 ∈ (IntegerPacket.ports (shape15E j) 1).a := by
    simp only [SkywalkIntegerLayout.a, TickCut.Receiver.ah_shape _ _ hm, List.mem_cons, List.mem_append]; simp
  have hq : TickCut.Receiver.highQ (shape15E j) 1 ∈ (IntegerPacket.ports (shape15E j) 1).a := by
    simp only [SkywalkIntegerLayout.a, TickCut.Receiver.ah_shape _ _ hm, List.mem_cons, List.mem_append]; simp
  change t.basis (windowNet15E j (TickCut.Receiver.highP (shape15E j) 1)) =
    t.basis (windowNet15E j (TickCut.Receiver.highQ (shape15E j) 1))
  rw [agree _ (watch15E_a j _ hp), agree _ (watch15E_a j _ hq)]
  exact active.2 positive

attribute [local irreducible] run unrouted15E TickCut15E.unrouted15EHigh in
theorem body15E_run (j : Fin 4) (admin reverse : Program) (s : State) (m : List Bool)
    (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1) (active : onRails15E j 0 z s.basis)
    (mid : let src := run (routed15E j 0 1) m s
      AdminResult15E j reverse src (run admin (m.drop (measurementCount (routed15E j 0 1))) src)) :
    let out := run (body15E j admin) m s
    out.phase = s.phase ∧ onRails15E j 15 (SkywalkTrace.next^[15] z) out.basis ∧
      readCells (shape15E j) 0 15 (mappedBasis15E j out.basis) = SkywalkTrace.trace 15 z ∧
      ∀ n, run (unbody15E j reverse) n out = s := by
  let src := run (routed15E j 0 1) m s
  let t := m.drop (measurementCount (routed15E j 0 1))
  let pre := run admin t src
  let n := t.drop (measurementCount admin)
  have strong0 : TickCut15E.onRails15EPlus j 0 z s.basis := ⟨active, by intro bad; omega⟩
  have head := TickCut15E.route15EFramePlus j 0 1 (by decide) z odd s m strong0
  have valid : TickCut15E.onRails15EPlus j 1 (SkywalkTrace.next z) src.basis := head.2
  have passPlus := watch15E_congrPlus j src pre mid.unchanged _ valid
  have pass := watch15E_congr j src pre mid.unchanged _ valid.1
  have span := split_run15E j z odd s m n active pre pass.1 pass.2
  have last := route15E_frame j 1 14 (by decide) (SkywalkTrace.next z) (nextOdd z odd) pre n pass.1
  dsimp only [body15E, unbody15E]
  simp only [run_append, run_take]
  refine ⟨last.1.trans (mid.phase.trans head.1), span.1, span.2, ?_⟩
  intro r
  have endBack := TickCut15E.route15EUndoHigh j 1 14 (by decide) (SkywalkTrace.next z) (nextOdd z odd) pre n r passPlus
  change run (unrouted15E j 0 1) _ (run reverse _ (run (TickCut15E.unrouted15EHigh j 1 14) r (run (routed15E j 1 14) n pre))) = s
  rw [endBack, mid.undo]
  exact route15E_undo j 0 1 (by decide) z odd s m _ active

theorem ready_after_head15E (j : Fin 4) (P : Program) (s : State) (a b : List Bool) (z : SkywalkRails.State)
    (odd : (z.a + z.b) % 2 = 1) (active : onRails15E j 0 z s.basis)
    (preserve : ∀ t : State, ∀ q ∈ watch15E j, (run P b t).basis q = t.basis q) :
    onRails15E j 1 (SkywalkTrace.next z) (run P b (run (routed15E j 0 1) a s)).basis :=
  (watch15E_congr j _ _ (preserve _) _ (route15E_frame j 0 1 (by decide) z odd s a active).2).1

def tickSites15E (j : Fin 4) (a : Nat) : List Wire :=
  (IntegerPacket.ports (shape15E j) a).wires.map (windowNet15E j)

def spanSites15E (j : Fin 4) (a n : Nat) : List Wire :=
  (List.range' a n).flatMap (tickSites15E j)

theorem route15E_sites (j : Fin 4) (a n : Nat) (lim : a + n ≤ 15) (q : Wire)
    (inP : q ∈ wires (routed15E j a n)) : q ∈ spanSites15E j a n := by
  induction n generalizing a with
  | zero => simp [routed15E, wires] at inP
  | succ n ih =>
    rw [routed15E, wires_append, Finset.mem_union] at inP
    rw [spanSites15E, List.range'_succ, List.flatMap_cons, List.mem_append]
    rcases inP with h | h
    · rw [renameProgram_support, Finset.mem_image] at h
      obtain ⟨t, used, eq⟩ := h
      have ht : a < 15 := by omega
      have inside := List.mem_toFinset.mp ((skywalkIntegerTick_wires_subset _ (IntegerPacket.ok (shape15E j) ⟨a, ht⟩)).1 used)
      exact Or.inl (List.mem_map.mpr ⟨t, inside, (stable15E ht inside).symm.trans eq⟩)
    · exact Or.inr (ih (a + 1) (by omega) h)

theorem route15E_outside (j : Fin 4) (a n : Nat) (lim : a + n ≤ 15) (q : Wire)
    (free : q ∉ spanSites15E j a n) (s : State) (m : List Bool) :
    (run (routed15E j a n) m s).basis q = s.basis q :=
  run_preserves_outside _ _ _ _ (fun used => free (route15E_sites j a n lim q used))

theorem old_clear15E {j : Fin 4} {a n q : Nat} (lim : a + n ≤ 15)
    (old : oldRange (start15E j + a) (windowNet15E j q)) : q ∉ spanSites15E j a n := by
  intro mem
  obtain ⟨r, hr, inside⟩ := List.mem_flatMap.mp mem
  rw [List.mem_range'_1] at hr
  obtain ⟨w, hw, eq⟩ := List.mem_map.mp inside
  rw [← eq, net15E_invol j w] at old
  have hj := j.isLt
  simp only [IntegerPacket.ports, shape15E, smallBits15E, sb15E, start15E, SkywalkIntegerLayout.wires,
    SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh, List.mem_cons, List.mem_append,
    List.mem_range'_1, List.not_mem_nil, or_false] at hw
  simp only [oldRange, start15E] at old
  repeat' first | cases_type Or | cases_type And
  all_goals try simp only [Wire] at *
  all_goals omega

def MayTouch15E (j : Fin 4) (w : Wire) : Prop :=
  (start15E j + 15 ≤ w ∧ w ≤ start15E j + 14 + 16 + (shape15E j).mid + 2) ∨
  (786 ≤ w ∧ w ≤ 787 + (shape15E j).mid) ∨
  (1556 ≤ w ∧ w ≤ 1556 + (shape15E j).mid) ∨
  (1044 + start15E j ≤ w ∧ w < 1044 + start15E j + 15)

instance (j : Fin 4) (w : Wire) : Decidable (MayTouch15E j w) := by unfold MayTouch15E; infer_instance

theorem named_range15E (j : Fin 4) (a n q : Nat) (lim : a + n ≤ 15)
    (outside : ¬ MayTouch15E j (windowNet15E j q)) : q ∉ spanSites15E j a n := by
  intro mem
  obtain ⟨r, hr, inside⟩ := List.mem_flatMap.mp mem
  rw [List.mem_range'_1] at hr
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp inside
  rw [net15E_invol j w] at outside
  apply outside
  simp only [IntegerPacket.ports, SkywalkIntegerLayout.wires, SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh,
    List.mem_cons, List.mem_append, List.mem_range'_1, List.not_mem_nil, or_false,
    shape15E, smallBits15E, start15E] at hw
  simp only [MayTouch15E, shape15E, smallBits15E, start15E]
  repeat' first | cases_type Or | cases_type And
  all_goals try simp only [Wire] at *
  all_goals omega

theorem through_body15E (j : Fin 4) (P : Program) (s : State) (m : List Bool) (q : Nat)
    (free : ¬ MayTouch15E j (windowNet15E j q))
    (admin : let a := run (routed15E j 0 1) m s
      (run P (m.drop (measurementCount (routed15E j 0 1))) a).basis q = a.basis q) :
    (run (body15E j P) m s).basis q = s.basis q := by
  simp only [body15E, run_append, run_take]
  exact (route15E_outside j 1 14 (by decide) q (named_range15E j 1 14 q (by decide) free) _ _).trans
    (admin.trans (route15E_outside j 0 1 (by decide) q (named_range15E j 0 1 q (by decide) free) s m))

theorem body15E_cover (j : Fin 4) (P : Program) (controls effects : List Wire)
    (clean : ∀ q ∈ controls, ¬ MayTouch15E j (windowNet15E j q))
    (apart : ∀ q ∈ controls, q ∉ effects) (cover : wires P ⊆ effects.toFinset)
    (s : State) (m : List Bool) (q : Wire) (hit : q ∈ controls) :
    (run (body15E j P) m s).basis q = s.basis q :=
  through_body15E j P s m q (clean q hit) (run_preserves_outside P _ _ q
    (fun used => apart q hit (List.mem_toFinset.mp (cover used))))

theorem ext_head15E (P : Program) (j : Fin 4) (Q : Program) (effects : List Wire)
    (s : State) (m n : List Bool) (q : Wire) (native : ¬ MayTouch15E j (windowNet15E j q))
    (enter : q ∉ wires P) (admin : q ∉ effects) (cover : wires Q ⊆ effects.toFinset) :
    (run (body15E j Q) n (run P m s)).basis q = s.basis q :=
  (through_body15E j Q _ n q native (run_preserves_outside Q _ _ q
    (fun used => admin (List.mem_toFinset.mp (cover used))))).trans (run_preserves_outside P _ _ q enter)

def firstUnchanged15E (j : Fin 4) (q : Wire) : Prop :=
  let r := windowNet15E j q
  r = (IntegerPacket.ports (shape15E j) 0).previous ∨ r ∉ (IntegerPacket.ports (shape15E j) 0).wires

instance (j : Fin 4) (q : Wire) : Decidable (firstUnchanged15E j q) := by unfold firstUnchanged15E; infer_instance

attribute [local irreducible] run routed15E skywalkIntegerTick in
theorem first_preserves15E (j : Fin 4) (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1)
    (s : State) (m : List Bool) (ready : onRails15E j 0 z s.basis)
    (q : Wire) (free : firstUnchanged15E j q) : (run (routed15E j 0 1) m s).basis q = s.basis q := by
  let p := shape15E j; let L := IntegerPacket.ports p 0
  let virt := pullState (windowNet15E j) s; let v := windowNet15E j q
  have first : 0 < p.length := by change 0 < 15; decide
  have inv : windowNet15E j v = q := net15E_invol j q
  have step := pull_routed15E j 0 1 (by decide) m s
  simp only [IntegerPacket.seq, List.append_nil] at step
  have at_q := congrArg (fun x : State => x.basis v) step
  change (run (routed15E j 0 1) m s).basis (windowNet15E j v) =
    (run (skywalkIntegerTick L) m virt).basis v at at_q
  rw [inv] at at_q
  refine at_q.trans (Eq.trans ?_ (show virt.basis v = s.basis q from congrArg s.basis inv))
  rcases free with e | e
  · change v = L.previous at e; rw [e]
    obtain ⟨ha, hb, hg, hc, hnew⟩ := ready
    obtain ⟨he, hh⟩ := hnew 0 (by decide) first
    obtain ⟨_, _, _, _, _, prev, _⟩ :=
      IntegerPacket.executed p ⟨0, first⟩ _ _ _ odd virt m ⟨ha, hb, hg, he, hh, hc⟩
    exact prev.trans hg.symm
  · apply run_preserves_outside
    exact fun used => e (List.mem_toFinset.mp ((skywalkIntegerTick_wires_subset _ (IntegerPacket.ok p ⟨0, first⟩)).1 used))

def FirstFree15E (j : Fin 4) (r : Wire) : Prop :=
  r = start15E j + 15 ∨
  ¬ (r = start15E j + 1044 ∨ (start15E j + 16 ≤ r ∧ r ≤ start15E j + sb15E (start15E j) + 34) ∨
     (786 ≤ r ∧ r ≤ sb15E (start15E j) + 803) ∨ (1556 ≤ r ∧ r ≤ sb15E (start15E j) + 1571))

instance (j : Fin 4) (r : Wire) : Decidable (FirstFree15E j r) := by unfold FirstFree15E; infer_instance

theorem firstFree15E (j : Fin 4) {q : Wire} (h : FirstFree15E j (windowNet15E j q)) : firstUnchanged15E j q := by
  unfold firstUnchanged15E
  by_cases hp : (windowNet15E j q : Nat) = start15E j + 15
  · left; rw [hp]; show start15E j + 15 = start15E j + 0 + 16 - 1; omega
  · right; intro mem
    rcases h with h | h
    · exact hp h
    · apply h
      simp only [IntegerPacket.ports, shape15E, smallBits15E, sb15E, SkywalkIntegerLayout.wires,
        SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh, List.mem_cons, List.mem_append,
        List.mem_range'_1, List.not_mem_nil, or_false] at mem
      simp only [sb15E, Wire] at *; omega

attribute [local irreducible] run routed15E in
theorem body15E_keeps (j : Fin 4) (P : Program) (ps : Ports) (d : Bool) (row : Nat)
    (s : State) (m : List Bool) (off : ∀ i : Fin 16, ps ⟨i.val, by omega⟩ ∉ spanSites15E j 1 14)
    (hold : Frame ps (code d) row (run P (m.drop (measurementCount (routed15E j 0 1)))
      (run (routed15E j 0 1) m s))) : Kept ps d row (run (body15E j P) m s) := by
