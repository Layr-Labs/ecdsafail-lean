section

/-! One-bank layout and validation proofs use accepted submission
12159df8-70b5-4718-9aef-847528abd574, commit
b2d461e7c85fef3e9360d1c5bfbb237687ee2578. The narrow fold uses LaneI. -/
set_option maxRecDepth 8192
