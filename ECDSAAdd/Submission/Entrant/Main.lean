section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OwnMinusHost
open Arithmetic MappedCompressed
attribute [local irreducible] wires OneBankCell5.cell OneBankCell5.endpoint

theorem codec_avoid (start : Nat) (hs : start+5≤512) (P : Program)
    (hp : P=History5.encode base start ∨ P=History5.decode base start) : base 767∉wires P := by
  intro used
  obtain ⟨r,eq⟩:=History5.history_gate_mem base start P hp (base 767) used
  have bounds:=History5.historyId_region start hs r
  change base 767=base (History5.historyId start r) at eq
  have same:=base_injective eq
  omega

theorem raw_avoid (divide : Bool) (ls : List MixedTranscriptLetter)
    (controls : ∀l∈ls,base 767≠l.1.1 ∧ base 767≠l.1.2) :
    base 767∉wires (OneBankReplay5.rawReplay divide ls) := by
  induction ls with
  | nil => simp [OneBankReplay5.rawReplay,wires]
  | cons l ls ih =>
    have c:=cell_avoid divide l.1.1 l.1.2 l.2.1 l.2.2 (controls l (by simp)).1 (controls l (by simp)).2
    have rest:=ih (fun k hk=>controls k (List.mem_cons_of_mem _ hk))
    cases divide <;> simp only [OneBankReplay5.rawReplay,Bool.false_eq_true,if_false,if_true,
      wires_append,Finset.mem_union,not_or] at c rest ⊢
    · exact ⟨rest,c⟩
    · exact ⟨c,rest⟩

theorem body_replay_avoid (divide : Bool) (j : Nat) (hj : j<102) :
    base 767∉wires (OneBankReplay5.body divide j) := by
  apply raw_avoid
  intro l hl
  have c:=Replay5.letters_controls j hj l hl
  have no:=codec_avoid (5*j) (by omega) _ (Or.inl rfl)
  exact ⟨fun e=>no (e ▸ c.1),fun e=>no (e ▸ c.2)⟩

theorem firstSwap_avoid : base 767∉wires Replay5.firstSwap := by
  apply select_avoid _ _ _ _ _ (by decide) (by decide) (by decide)
  exact swap_avoid

theorem firstBody_avoid (divide : Bool) : base 767∉wires (OneBankReplay5.firstBody divide) := by
  have ctrl : ∀l∈Replay5.restLetters,base 767≠l.1.1 ∧ base 767≠l.1.2 := by
    intro l hl
    have mem:l∈Replay5.letters 0:=by rw [Replay5.letters_zero];simp [hl]
    have c:=Replay5.letters_controls 0 (by omega) l mem
    have no:=codec_avoid 0 (by omega) _ (Or.inl rfl)
    exact ⟨fun e=>no (e ▸ c.1),fun e=>no (e ▸ c.2)⟩
  cases divide <;> simp only [OneBankReplay5.firstBody,Bool.false_eq_true,if_false,if_true,
    wires_append,Finset.mem_union,not_or]
  · exact ⟨raw_avoid false _ ctrl,firstSwap_avoid⟩
  · exact ⟨firstSwap_avoid,raw_avoid true _ ctrl⟩

theorem pi_fix (j : Nat) (hj : j<102) : shifted (Placement5.pi j) (base 767)=base 767 := by
  rw [shifted_base,Placement5.pi_outside j 767 hj]
  unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
  omega

theorem packet_avoid (divide : Bool) (j : Nat) (hj : j<102) :
    base 767∉wires (OneBankReplay5.packet divide j) := by
  apply rename_avoid _ _ _ (pi_fix j hj)
  simp only [OneBankReplay5.basePacket,wires_append,Finset.mem_union,not_or]
  exact ⟨⟨codec_avoid _ (by omega) _ (Or.inr rfl),body_replay_avoid divide j hj⟩,
    codec_avoid _ (by omega) _ (Or.inl rfl)⟩

theorem firstPacket_avoid (divide : Bool) : base 767∉wires (OneBankReplay5.firstPacket divide) := by
  apply rename_avoid _ _ _ (pi_fix 0 (by omega))
  simp only [OneBankReplay5.baseFirstPacket,wires_append,Finset.mem_union,not_or]
  exact ⟨⟨codec_avoid _ (by omega) _ (Or.inr rfl),firstBody_avoid divide⟩,
    codec_avoid _ (by omega) _ (Or.inl rfl)⟩

theorem endPacket_avoid (divide : Bool) : base 767∉wires (OneBankReplay5.endPacket divide) := by
  have fix:shifted Placement5.pi0 (base 767)=base 767:=by
    rw [shifted_base,Placement5.pi0_outside 767]
    unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
    omega
  apply rename_avoid _ _ _ fix
  apply endpoint_avoid
  decide

theorem groups_avoid (divide : Bool) (j n : Nat) (hb : j+n≤102) :
    base 767∉wires (OneBankReplay5.groups divide j n) := by
  induction n generalizing j with
  | zero => simp [OneBankReplay5.groups,PacketSequence.program,wires]
  | succ n ih =>
    have head:=packet_avoid divide j (by omega)
    have tail:=ih (j+1) (by omega)
    cases divide <;> simp only [OneBankReplay5.groups,PacketSequence.program,Bool.false_eq_true,
      if_false,if_true,wires_append,Finset.mem_union,not_or] at head tail ⊢
    · exact ⟨tail,head⟩
    · exact ⟨head,tail⟩

theorem replay_avoid (divide : Bool) : base 767∉wires (OneBankReplay5.replay divide) := by
  let e:Equiv.Perm Wire:=⟨OB5.sig 511,OB5.sig 511,OB5.sig_invol 511 (by omega),OB5.sig_invol 511 (by omega)⟩
  have fix:e (base 767)=base 767:=by decide +kernel
  apply rename_avoid e _ _ fix
  cases divide <;> simp only [OneBankReplay5.logicalReplay,Bool.false_eq_true,if_false,if_true,
    wires_append,Finset.mem_union,not_or]
  · exact ⟨⟨endPacket_avoid false,groups_avoid false 1 101 (by omega)⟩,firstPacket_avoid false⟩
  · exact ⟨⟨firstPacket_avoid true,groups_avoid true 1 101 (by omega)⟩,endPacket_avoid true⟩
theorem copy_avoid : base 767∉wires HalfFieldOB5.copyN := by
  intro used
  have mem:=copyRegister_wires_subset none
    (balancedSharedPorts base (base 2409)).r (balancedSharedPorts base (base 2409)).y used
  simp only [Option.toList_none,List.nil_append,List.mem_toFinset,List.mem_append,
    balancedSharedPorts_r,balancedSharedPorts_y] at mem
  rcases mem with r|y
  · exact not_block 767 2056 256 (by omega) r
  · exact not_block 767 770 256 (by omega) y

end ECDSAAdd.Entrant.OwnMinusHost

end

section
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OwnQ4Endpoint
open Arithmetic MappedCompressed Secp256k1 BalancedField OffsetBorrowedCanonical
open OwnPlusHost
attribute [local irreducible] run wires

theorem encoder_free (q : Nat) (hq : q=767 ∨ q=1026) :
    base q∉wires (History5.allEncode base 102) := by
  intro used
  have mem:=History5.allEncode_history_support base 102 (by omega) used
  simp only [List.mem_toFinset,List.mem_append] at mem
  rcases mem with lo|hi
  · exact not_block q 0 512 (by omega) lo
  · exact not_block q 1028 512 (by omega) hi

theorem canonical_at (origin : BasisState) (env : Env base origin) (X : Fp) (s : State) (q : Nat)
    (hq : q=767 ∨ q=1026) (input : FieldFrameOB5.EncodedCanonicalFrame origin X 0 s) :
    s.basis (base q)=origin (base q) := by
  rcases hq with rfl|rfl
  · exact OwnGuardEndpoint.canonical_at origin X 0 s 767 (Or.inr rfl) input
  · obtain ⟨raw,_,pair,encoded⟩:=input
    have member : base 1026∈(skywalkSharedField base).a := by
      simp only [skywalkSharedField,wireBlock,List.mem_map,List.mem_range'_1]
      exact ⟨1026,by omega,rfl⟩
    have value : regValue (skywalkSharedField base).a raw.basis=0 := by simpa using pair.2.1
    have rawzero : raw.basis (base 1026)=false := (regValue_zero _ _).mp value _ member
    have encodedzero : (pullState (OB5.sig 511) s).basis (base 1026)=false := by
      rw [encoded]
      exact (run_preserves_outside _ [] raw _ (encoder_free 1026 (Or.inr rfl))).trans rawzero
    have fix : OB5.sig 511 (base 1026)=base 1026 := by decide +kernel
    have zero : s.basis (base 1026)=false := by simpa only [pullState,fix] using encodedzero
    exact zero.trans env.2.2.symm

theorem field_at (origin : BasisState) (X Y : Fp) (s : State) (q : Nat)
    (hq : q=767 ∨ q=1026) (input : FieldFrameOB5.EncodedFieldFrame origin X Y s) :
    s.basis (base q)=origin (base q) := by
  obtain ⟨raw,_,pair,encoded⟩:=input
  have r:base q∉(balancedSharedPorts base (base 2409)).r:=by
    rw [balancedSharedPorts_r]
    exact not_block q 2056 256 (by omega)
  have y:base q∉(balancedSharedPorts base (base 2409)).y:=by
    rw [balancedSharedPorts_y]
    exact not_block q 770 256 (by omega)
  have eq:(pullState (OB5.sig 511) s).basis (base q)=origin (base q):=by
    rw [encoded]
    exact (run_preserves_outside _ [] raw _ (encoder_free q hq)).trans (pair.2.2 _ r y)
  have fix:OB5.sig 511 (base q)=base q:=by rcases hq with rfl|rfl <;> decide +kernel
  simpa only [pullState,fix] using eq

theorem env_zero (origin : BasisState) (env : Env base origin)
    (hr : origin (base 2312)=false) (q : Nat) (hq : q=767 ∨ q=1026) : origin (base q)=false := by
  rcases hq with rfl|rfl
  · exact OwnGuardEndpoint.env_zero origin env hr 767 (Or.inr rfl)
  · exact env.2.2

def swap : Equiv.Perm Wire:=Equiv.swap (base 767) (base 1026)
def centerT : Program:=renameProgram swap OwnGuardEndpoint.centerT
def canonT : Program:=renameProgram swap OwnGuardEndpoint.canonT

theorem center_frame (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2409∉skywalkPoolWires base) (origin : BasisState)
    (env : Env base origin) (legal : History5.RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedCanonicalFrame origin X 0 s) :
    (run centerT m s).phase=s.phase ∧
    FieldFrameOB5.EncodedFieldFrame origin (X/2) 0 (run centerT m s) := by
  have old:=OwnGuardEndpoint.center_frame hn ho origin env legal hr ha X s m input
  have before (q : Nat) (hq : q=767 ∨ q=1026) : s.basis (base q)=false :=
    (canonical_at origin env X s q hq input).trans (env_zero origin env hr q hq)
  have after (q : Nat) (hq : q=767 ∨ q=1026) : (run OwnGuardEndpoint.centerT m s).basis (base q)=false :=
    (field_at origin (X/2) 0 _ q hq old.2).trans (env_zero origin env hr q hq)
  have eq:=FieldFrameOB5.rebind_swap_run (base 767) (base 1026) OwnGuardEndpoint.centerT s m
    (before 767 (Or.inl rfl)) (before 1026 (Or.inr rfl))
    (after 767 (Or.inl rfl)) (after 1026 (Or.inr rfl))
  simpa only [centerT,swap,eq] using old

theorem canon_frame (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2409∉skywalkPoolWires base) (origin : BasisState)
    (env : Env base origin) (legal : History5.RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedFieldFrame origin X 0 s) :
    (run canonT m s).phase=s.phase ∧
    FieldFrameOB5.EncodedCanonicalFrame origin (2*X) 0 (run canonT m s) := by
  have old:=OwnGuardEndpoint.canon_frame hn ho origin env legal hr ha X s m input
  have before (q : Nat) (hq : q=767 ∨ q=1026) : s.basis (base q)=false :=
    (field_at origin X 0 s q hq input).trans (env_zero origin env hr q hq)
  have after (q : Nat) (hq : q=767 ∨ q=1026) : (run OwnGuardEndpoint.canonT m s).basis (base q)=false :=
    (canonical_at origin env (2*X) _ q hq old.2).trans (env_zero origin env hr q hq)
  have eq:=FieldFrameOB5.rebind_swap_run (base 767) (base 1026) OwnGuardEndpoint.canonT s m
    (before 767 (Or.inl rfl)) (before 1026 (Or.inr rfl))
    (after 767 (Or.inl rfl)) (after 1026 (Or.inr rfl))
  simpa only [canonT,swap,eq] using old
theorem endpoint_counts : toffoliCount centerT=254 ∧ measurementCount centerT=254 ∧
    toffoliCount canonT=254 ∧ measurementCount canonT=254 := by
  simpa only [centerT,canonT,(renameProgram_counts _ _).1,(renameProgram_counts _ _).2]
    using OwnGuardEndpoint.endpoint_counts

theorem endpoint_physical (hn : (skywalkSharedWires base).Nodup) :
    GatePhysical centerT ∧ GatePhysical canonT ∧ GatePhysical HalfFieldOB5.copyN := by
  have old:=OwnGuardEndpoint.endpoint_physical hn
  exact ⟨gatePhysical_rename swap swap.injective _ old.1,
    gatePhysical_rename swap swap.injective _ old.2.1,old.2.2⟩

theorem endpoint_gateSlots_le : Challenge.gateSlots centerT≤6000 ∧ Challenge.gateSlots canonT≤6000 ∧
    Challenge.gateSlots HalfFieldOB5.copyN≤256 := by
  simpa only [centerT,canonT,Baselines.rename_gateSlots] using OwnGuardEndpoint.endpoint_gateSlots_le

theorem old_unused (q : Nat) (hq : q=1026 ∨ q=2312) :
    base q∉wires OwnGuardEndpoint.centerT ∧ base q∉wires OwnGuardEndpoint.canonT := by
  have no : base q∉(HalfField.ids.map base).toFinset := by
    intro h
    obtain ⟨i,hi,e⟩:=List.mem_map.mp (List.mem_toFinset.mp h)
    have eq:=base_injective e
    simp only [HalfField.ids,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at hi
    omega
  have a:base q∉wires HalfField5.centerT:=fun h=>no (@HalfField.centerT_sites (base q) h)
  have b:base q∉wires HalfField5.canonT:=fun h=>no (@HalfField.canonT_sites (base q) h)
  have fix : HalfFieldOB5.endpointMap (base q)=base q:=by rcases hq with rfl|rfl <;> decide +kernel
  have first : base q∉wires HalfFieldOB5.centerT ∧ base q∉wires HalfFieldOB5.canonT :=
    ⟨OwnPlusHost.rename_avoid _ _ _ fix a,OwnPlusHost.rename_avoid _ _ _ fix b⟩
  have fixPlus : OwnPlusEndpoint.swap (base q)=base q := by
    rcases hq with rfl|rfl <;> decide +kernel
  have second : base q∉wires OwnPlusEndpoint.centerT ∧ base q∉wires OwnPlusEndpoint.canonT :=
    ⟨OwnPlusHost.rename_avoid _ _ _ fixPlus first.1,OwnPlusHost.rename_avoid _ _ _ fixPlus first.2⟩
  have fixGuard : OwnGuardEndpoint.swap (base q)=base q := by
    rcases hq with rfl|rfl <;> decide +kernel
  exact ⟨OwnPlusHost.rename_avoid _ _ _ fixGuard second.1,OwnPlusHost.rename_avoid _ _ _ fixGuard second.2⟩

theorem plus_free : base 767∉wires centerT ∧ base 767∉wires canonT := by
  have avoid (P : Program) (hp : base 1026∉wires P) : base 767∉wires (renameProgram swap P) := by
    rw [renameProgram_support]
    intro used
    obtain ⟨old,used,e⟩:=Finset.mem_image.mp used
    have back:swap (base 1026)=base 767:=Equiv.swap_apply_right _ _
    have same:old=base 1026:=swap.injective (e.trans back.symm)
    exact hp (same ▸ used)
  exact ⟨avoid _ (old_unused 1026 (Or.inl rfl)).1,avoid _ (old_unused 1026 (Or.inl rfl)).2⟩

theorem parity_free : base 2312∉wires centerT ∧ base 2312∉wires canonT := by
  have fix:swap (base 2312)=base 2312:=by decide +kernel
  exact ⟨OwnPlusHost.rename_avoid _ _ _ fix (old_unused 2312 (Or.inr rfl)).1,
    OwnPlusHost.rename_avoid _ _ _ fix (old_unused 2312 (Or.inr rfl)).2⟩

end ECDSAAdd.Entrant.OwnQ4Endpoint

end
-- ===== ECDSAAdd.Submission.Entrant.SegmentOB5 =====
section

set_option maxRecDepth 8192
set_option maxHeartbeats 1500000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.SegmentOB5
open Arithmetic Secp256k1 BalancedField MappedCompressed OffsetBorrowedCanonical History5 HalfFieldOB5
attribute [local irreducible] run wires HalfFieldOB5.centerT HalfFieldOB5.canonT OneBankReplay5.replay

def program (divide : Bool) : Program :=
  if divide then OwnQ4Endpoint.centerT++(OneBankReplay5.replay true++(copyN++OwnQ4Endpoint.canonT))
  else OwnQ4Endpoint.centerT++(copyN++(OneBankReplay5.replay false++OwnQ4Endpoint.canonT))

private theorem run_four_states (a b c d : Program) (P : State → State → Prop)
    (h : ∀ (s s1 s2 s3 s4 : State) (m1 m2 m3 m4 : List Bool),
      run a m1 s=s1 → run b m2 s1=s2 → run c m3 s2=s3 → run d m4 s3=s4 → P s s4)
    (s : State) (m : List Bool) : P s (run (a++(b++(c++d))) m s) := by
  simp only [run_append]
  exact h _ _ _ _ _ _ _ _ _ rfl rfl rfl rfl

private theorem double_half (Y W : Fp) : 2*(Y/2*W)=Y*W := by
  have two : (2:Fp) ≠ 0 := by decide
  field_simp

private theorem double_half_div (Y W : Fp) : 2*(Y/2/W)=Y/W := by
  have two : (2:Fp) ≠ 0 := by decide
  rw [div_div,mul_comm (2:Fp) W,←div_div,mul_div_cancel₀ _ two]

private theorem double_half_one (Y : Fp) : 2*(Y/2)=Y := by
  have two : (2:Fp) ≠ 0 := by decide
  exact mul_div_cancel₀ Y two

/-- Same hypotheses and conclusion as the protected selected field segment. -/
theorem program_spec (divide : Bool)
    (hn : (skywalkSharedWires base).Nodup) (ho : ∀ q ∈ [base 2400,base 2409,base 2410],q ∉ skywalkSharedWires base)
    (hp : ∀ q ∈ [base 2400,base 2409,base 2410],q ∉ skywalkPoolWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) (mixedTranscriptTape base))
    (origin : BasisState) (hg0 : origin (base 2409)=false) (hs0 : origin (base 2410)=false)
    (env : Env base origin) (legal : History5.RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))
    (Y : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedCanonicalFrame origin Y 0 s) :
    let out := run (program divide) m s
    out.phase=s.phase ∧ FieldFrameOB5.EncodedCanonicalFrame origin (fieldResult divide origin x Y) 0 out := by
  let ctx : OneBankReplay5.Context origin := ⟨hn,ho,hp,hf,hg0,hs0,env,legal,hr⟩
  cases divide
  · let P : State → State → Prop := fun initial out => FieldFrameOB5.EncodedCanonicalFrame origin Y 0 initial →
      out.phase=initial.phase ∧ FieldFrameOB5.EncodedCanonicalFrame origin (fieldResult false origin x Y) 0 out
    have all := run_four_states OwnQ4Endpoint.centerT copyN (OneBankReplay5.replay false) OwnQ4Endpoint.canonT P (by
      intro initial s1 s2 s3 s4 m1 m2 m3 m4 h1 h2 h3 h4 hin
      have c1 := OwnQ4Endpoint.center_frame hn (hp _ (by simp)) origin env legal hr ha Y initial m1 hin
      rw [h1] at c1
      have c2 := copy_fill hn origin (Y/2) s1 m2 c1.2
      rw [h2] at c2
      have c3 := OneBankReplay5.inverse_frame origin ctx
        x hx0 hx trace (Y/2) s2 m3 c2.2
      rw [h3] at c3
      have c4 := OwnQ4Endpoint.canon_frame hn (hp _ (by simp)) origin env legal hr ha _ s3 m4 c3.2
      rw [h4] at c4
      refine ⟨c4.1.trans (c3.1.trans (c2.1.trans c1.1)),?_⟩
      have eq : 2*(if origin (base 2400) then Y/2*(x:Fp) else Y/2)=fieldResult false origin x Y := by
        unfold fieldResult
        split
        · simp only [Bool.false_eq_true,if_false]; exact double_half Y _
        · exact double_half_one Y
      rw [←eq]
      exact c4.2) s m
    simpa only [program,Bool.false_eq_true,if_false] using all input
  · let P : State → State → Prop := fun initial out => FieldFrameOB5.EncodedCanonicalFrame origin Y 0 initial →
      out.phase=initial.phase ∧ FieldFrameOB5.EncodedCanonicalFrame origin (fieldResult true origin x Y) 0 out
    have all := run_four_states OwnQ4Endpoint.centerT (OneBankReplay5.replay true) copyN OwnQ4Endpoint.canonT P (by
      intro initial s1 s2 s3 s4 m1 m2 m3 m4 h1 h2 h3 h4 hin
      have c1 := OwnQ4Endpoint.center_frame hn (hp _ (by simp)) origin env legal hr ha Y initial m1 hin
      rw [h1] at c1
      have c2 := OneBankReplay5.forward_frame origin ctx x hx0 hx trace
        (Y/2) s1 m2 c1.2
      rw [h2] at c2
      have c3 := copy_clear hn origin _ s2 m3 c2.2
      rw [h3] at c3
      have c4 := OwnQ4Endpoint.canon_frame hn (hp _ (by simp)) origin env legal hr ha _ s3 m4 c3.2
      rw [h4] at c4
      refine ⟨c4.1.trans (c3.1.trans (c2.1.trans c1.1)),?_⟩
      have eq : 2*(if origin (base 2400) then Y/2/(x:Fp) else Y/2)=fieldResult true origin x Y := by
        unfold fieldResult
        split
        · simp only [if_true]; exact double_half_div Y _
        · exact double_half_one Y
      rw [←eq]
      exact c4.2) s m
    simpa only [program,if_true] using all input

attribute [local irreducible] toffoliCount measurementCount

theorem program_counts (divide : Bool) (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2410∉skywalkSharedWires base) :
    toffoliCount (program divide)=654328 ∧ measurementCount (program divide)=522850 := by
  have ce := OwnQ4Endpoint.endpoint_counts
  have r := OneBankReplay5.replay_counts divide hn ho
  have len : (balancedSharedPorts base (base 2409)).r.length=
      (balancedSharedPorts base (base 2409)).y.length := by
    rw [balancedSharedPorts_r,balancedSharedPorts_y]; simp [wireBlock_length]
  have k := copyRegister_counts none (balancedSharedPorts base (base 2409)).r
    (balancedSharedPorts base (base 2409)).y len
  have cp : toffoliCount copyN=0 ∧ measurementCount copyN=0 := by
    simpa only [copyN,HalfField5.copyN,HalfField.copyN,HalfField.ports,
      Option.isSome_none,Bool.false_eq_true,if_false] using k
  cases divide <;> simp only [program,Bool.false_eq_true,if_false,if_true,toffoliCount_append,
    measurementCount_append,ce.1,ce.2.1,ce.2.2.1,ce.2.2.2,cp.1,cp.2] at r ⊢
  all_goals constructor <;> omega

theorem program_physical (divide : Bool) (hn : (skywalkSharedWires base).Nodup)
    (ho : ∀q∈[base 2400,base 2409,base 2410],q∉skywalkSharedWires base)
    (hf : MixedTranscriptReplayLayout base (base 2400) (base 2409) (base 2410) (mixedTranscriptTape base)) :
    GatePhysical (program divide) := by
  have c := OwnQ4Endpoint.endpoint_physical hn
  have r := OneBankReplay5.replay_physical divide hn ho hf
  cases divide <;> simp only [program,Bool.false_eq_true,if_false,if_true,gatePhysical_append]
  · exact ⟨c.1,c.2.2,r,c.2.1⟩
  · exact ⟨c.1,r,c.2.2,c.2.1⟩

theorem program_gateSlots_le (divide : Bool) : Challenge.gateSlots (program divide)≤14100000 := by
  have c := OwnQ4Endpoint.endpoint_gateSlots_le
  have r := OneBankReplay5.replay_gateSlots_le divide
  cases divide <;> simp only [program,Bool.false_eq_true,if_false,if_true,Challenge.gateSlots_append] <;> omega

end ECDSAAdd.Entrant.SegmentOB5

end


-- ===== ECDSAAdd.Submission.Entrant.OBInteger5 =====
section

/-! Late-sign placement, adapted from accepted submission12159df8-70b5-4718-9aef-847528abd574,
commit b2d461e7c85fef3e9360d1c5bfbb237687ee2578 (OBSigma/OBInteger).
The integer programs use the local five-trit codec. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1500000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OB5
open Arithmetic MappedCompressed Secp256k1 History5
attribute [local irreducible] run W.compactSkywalkTick W.compactSkywalkReverseTick
  History5.encode History5.decode

theorem historyAbove : HistoryAbove base := by
  intro j _
  change 10≤j+16
  omega


















theorem encodePrefix_mem (n : Nat) (hn : n ≤ 512) (q : Wire)
    (hq : q ∈ wires (encodePrefix base n)) :
    ∃ j, q = base j ∧ (j+2 ≤ n ∨ (1028 ≤ j ∧ j+2 ≤ 1028+n)) := by
  induction n with
  | zero => simp [encodePrefix, wires] at hq
  | succ n ih =>
    rw [encodePrefix, wires_append, Finset.mem_union] at hq
    rcases hq with hq | hq
    · obtain ⟨j, rfl, hj⟩ := ih (by omega) hq
      exact ⟨j, rfl, by omega⟩
    · cases hd : packDue n
      · simp [packAfter, hd, wires] at hq
      · have h3 := packDue_true n hd
        rw [packAfter, if_pos hd] at hq
        obtain ⟨u, rfl⟩ := history_gate_mem base (n-5) _ (Or.inl rfl) q hq
        refine ⟨_, rfl, ?_⟩
        have hu := u.isLt
        unfold historyId
        split <;> omega

/-- The encode prefix before tick `i` never touches labels at or above `1027+i`. -/
theorem prefix_keep (i : Nat) (hi : i ≤ 512) (raw : State) (l : Nat) (hl : 1027+i ≤ l) :
    (run (encodePrefix base i) [] raw).basis (base l) = raw.basis (base l) := by
  apply run_preserves_outside
  intro hm
  obtain ⟨j, hj, hr⟩ := encodePrefix_mem i hi _ hm
  have := base_injective hj
  omega

theorem stage_zero (x i : Nat) (hi : i < 512) (b : BasisState)
    (h : W.CompressedCompactStage5 base x p i b) :
    b (base (1028+i)) = false ∧ (257 ≤ i → b (base (2053-i)) = false) := by
  obtain ⟨raw, hraw, rfl⟩ := h
  have virt : ∀ l, 1028 ≤ l → W.compactSkywalkStageVirtual base i raw.basis (base l) =
      raw.basis (base l) := by
    intro l hl
    have ex := W.compactSkywalkStage_expanded base i (by omega)
    apply W.compactSkywalkStage_virtual_outside
    · intro hm
      have hm' : base l ∈ (W.compactSkywalkSignPoolA base i).expanded :=
        List.mem_append_right _ hm
      rw [ex.1] at hm'
      obtain ⟨j, hj, he⟩ := List.mem_map.mp hm'
      have := base_injective he
      simp only [List.mem_range'_1] at hj
      omega
    · intro hm
      have hm' : base l ∈ (W.compactSkywalkSignPoolB base i).expanded :=
        List.mem_append_right _ hm
      rw [ex.2] at hm'
      obtain ⟨j, hj, he⟩ := List.mem_map.mp hm'
      have := base_injective he
      simp only [List.mem_range'_1] at hj
      omega
  have stage := hraw.1
  have fut := (stage.2.2.2.2.1 i (Nat.le_refl i) hi).2
  have carry := (regValue_zero _ _).mp stage.2.2.2.2.2.1
  constructor
  · rw [prefix_keep i (by omega) raw (1028+i) (by omega), ← virt (1028+i) (by omega)]
    exact fut
  · intro big
    rw [prefix_keep i (by omega) raw (2053-i) (by omega), ← virt (2053-i) (by omega)]
    apply carry
    exact List.mem_map.mpr ⟨2053-i, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩

theorem stage_one (x : Nat) (s : State)
    (hs : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    W.CompressedCompactStage5 base x p 1 s.basis :=
  W.compactStage5_first base x p s hs

theorem prime_facts (x : Nat) (hx0 : 0 < x) (hx : x < p) :
    0 < p ∧ p%2 = 1 ∧ p < 2^256 ∧ x.Coprime p := by
  refine ⟨by norm_num [p], by norm_num [p], by norm_num [p], ?_⟩
  apply Nat.Coprime.symm
  apply p_prime.coprime_iff_not_dvd.mpr
  intro hd
  exact (Nat.not_le_of_lt hx) (Nat.le_of_dvd hx0 hd)

/-! ## Forward pass -/

theorem forward_gen (x : Nat) (hx0 : 0 < x) (hx : x < p) (n : Nat) :
    ∀ i, 1 ≤ i → i+n ≤ 512 → ∀ (t : State) (m : List Bool),
    W.CompressedCompactStage5 base x p i t.basis →
    run (forward i n) m (pullState (sig (i-1)) t) =
      pullState (sig (i+n-1)) (run (W.compactForward5 base i n) m t) := by
  obtain ⟨hp0, hpo, hp, cop⟩ := prime_facts x hx0 hx
  have hpGap : p+2^32 ≤ 2^256 := by norm_num [p]
  induction n with
  | zero =>
    intro i _ _ t m _
    simp only [forward, W.compactForward5, run, Nat.add_zero]
  | succ n ih =>
    intro i h1 hb t m ht
    have hi : i ≤ 511 := by omega
    have z := stage_zero x i (by omega) t.basis ht
    rw [pull_step i hi t z.1 z.2]
    have e1 : forward i (n+1) = renameProgram (sig i)
        (W.compactSkywalkTick base i ++ packAfter base i) ++ forward (i+1) n := by
      rw [forward]
    have e2 : W.compactForward5 base i (n+1) =
        (W.compactSkywalkTick base i ++ packAfter base i) ++
          W.compactForward5 base (i+1) n := by
      rw [W.compactForward5]
    have cnt := (renameProgram_counts (sig i)
      (W.compactSkywalkTick base i ++ packAfter base i)).2
    rw [e1, e2, run_append, run_append, cnt, run_rename i hi]
    have ht' := (W.compactStage5_step base base_pool_nodup historyAbove x p i hp0 hx0 hpo hp hpGap hx
      cop (by omega) t (m.take (measurementCount
        (W.compactSkywalkTick base i ++ packAfter base i))) ht).2
    have step := ih (i+1) (by omega) (by omega) _ (m.drop (measurementCount
        (W.compactSkywalkTick base i ++ packAfter base i))) ht'
    rw [show i+1-1 = i by omega] at step
    rw [step, show i+1+n-1 = i+(n+1)-1 by omega]

theorem forward_run (x : Nat) (hx0 : 0 < x) (hx : x < p) (s : State) (m : List Bool)
    (hs : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    run (forward 1 511) m s = pullState (sig 511) (run (W.compactForward5 base 1 511) m s) := by
  have h := forward_gen x hx0 hx 511 1 (Nat.le_refl 1) (by omega) s m (stage_one x s hs)
  have e : pullState (sig (1-1)) s = s := by
    apply State.extensionality
    · rfl
    · funext q
      show s.basis (sig 0 q) = s.basis q
      rw [sig_zero]
  rw [e, show 1+511-1 = 511 from rfl] at h
  exact h

/-! ## Counts -/

theorem counts_gen (i n : Nat) :
    toffoliCount (forward i n) = toffoliCount (W.compactForward5 base i n) ∧
    measurementCount (forward i n) = measurementCount (W.compactForward5 base i n) ∧
    Challenge.gateSlots (forward i n) = Challenge.gateSlots (W.compactForward5 base i n) ∧
    toffoliCount (reverse i n) = toffoliCount (W.compactReverse5 base i n) ∧
    measurementCount (reverse i n) = measurementCount (W.compactReverse5 base i n) ∧
    Challenge.gateSlots (reverse i n) = Challenge.gateSlots (W.compactReverse5 base i n) := by
  induction n generalizing i with
  | zero => simp [forward, reverse, W.compactForward5, W.compactReverse5]
  | succ n ih =>
    have r := ih (i+1)
    have f := renameProgram_counts (sig i) (W.compactSkywalkTick base i ++ packAfter base i)
    have b := renameProgram_counts (sig i)
      (decodeBefore base i ++ W.compactSkywalkReverseTick base i)
    have fs := Baselines.rename_gateSlots (sig i)
      (W.compactSkywalkTick base i ++ packAfter base i)
    have bs := Baselines.rename_gateSlots (sig i)
      (decodeBefore base i ++ W.compactSkywalkReverseTick base i)
    rw [forward, reverse, W.compactForward5, W.compactReverse5]
    simp only [toffoliCount_append, measurementCount_append, Challenge.gateSlots_append] at f b fs bs ⊢
    omega

theorem forward_counts :
    toffoliCount (forward 1 511) = toffoliCount (W.compactForward5 base 1 511) ∧
    measurementCount (forward 1 511) = measurementCount (W.compactForward5 base 1 511) ∧
    Challenge.gateSlots (forward 1 511) = Challenge.gateSlots (W.compactForward5 base 1 511) :=
  let h := counts_gen 1 511
  ⟨h.1, h.2.1, h.2.2.1⟩

theorem reverse_counts :
    toffoliCount (reverse 1 511) = toffoliCount (W.compactReverse5 base 1 511) ∧
    measurementCount (reverse 1 511) = measurementCount (W.compactReverse5 base 1 511) ∧
    Challenge.gateSlots (reverse 1 511) = Challenge.gateSlots (W.compactReverse5 base 1 511) :=
  let h := counts_gen 1 511
  ⟨h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2⟩

/-! ## Reverse pass -/

/-- One compressed tick followed by its decode and inverse tick is the identity
on every compressed stage state. -/
theorem oneStep_roundtrip (x : Nat) (hx0 : 0 < x) (hx : x < p) (i : Nat) (hi : i < 512)
    (t : State) (ht : W.CompressedCompactStage5 base x p i t.basis) (m1 m2 : List Bool) :
    run (decodeBefore base i ++ W.compactSkywalkReverseTick base i) m2
      (run (W.compactSkywalkTick base i ++ packAfter base i) m1 t) = t := by
  obtain ⟨hp0,hpo,hp,cop⟩ := prime_facts x hx0 hx
  have hq : p+2^32≤2^256 := by norm_num [p]
  exact W.compactStep5_roundtrip base base_pool_nodup historyAbove x p i hp0 hx0 hpo hp hq hx cop hi t m1 m2 ht

theorem pool_agree (P : Program) (hP : wires P ⊆ (skywalkPoolWires base).toFinset)
    (m : List Bool) (s t : State)
    (h : ∀ q ∈ skywalkPoolWires base, s.basis q = t.basis q) :
    ∀ q ∈ skywalkPoolWires base, (run P m s).basis q = (run P m t).basis q := by
  have e : (run P m s).basis = (run P m (⟨t.phase, s.basis⟩ : State)).basis :=
    run_basis_records P s _ m m rfl
  have a := pool_run_agrees P _ hP m ⟨t.phase, s.basis⟩ t rfl
    (fun q hq => h q (List.mem_toFinset.mp hq))
  intro q hq
  rw [e]
  exact a.2 q (List.mem_toFinset.mpr hq)

theorem untick_pool (i : Nat) (hi : i < 512) :
    wires (decodeBefore base i ++ W.compactSkywalkReverseTick base i) ⊆
      (skywalkPoolWires base).toFinset := by
  have pack := (pack_support5 base i hi).2.trans (integerSites5_pool base)
  have tick := (W.compactTick_support5 base base_pool_nodup i hi).2.trans (integerSites5_pool base)
  simpa only [wires_append,Finset.union_subset_iff] using And.intro pack tick

theorem base_pool (l : Nat) (hl : l < 1798) : base l ∈ skywalkPoolWires base :=
  List.mem_map.mpr ⟨l, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩

theorem reverse_gen (x : Nat) (hx0 : 0 < x) (hx : x < p) (n : Nat) :
    ∀ i, 1 ≤ i → i+n ≤ 512 → ∀ (t : State) (m2 : List Bool) (v : State) (m : List Bool),
    W.CompressedCompactStage5 base x p i t.basis →
    (∀ q ∈ skywalkPoolWires base,
      v.basis q = (run (W.compactForward5 base i n) m2 t).basis q) →
    run (reverse i n) m (pullState (sig (i+n-1)) v) =
      pullState (sig (i-1)) (run (W.compactReverse5 base i n) m v) ∧
    ∀ q ∈ skywalkPoolWires base, (run (W.compactReverse5 base i n) m v).basis q = t.basis q := by
  obtain ⟨hp0, hpo, hp, cop⟩ := prime_facts x hx0 hx
  have hpGap : p+2^32 ≤ 2^256 := by norm_num [p]
  induction n with
  | zero =>
    intro i _ _ t m2 v m _ hv
    refine ⟨?_, ?_⟩
    · simp only [reverse, W.compactReverse5, run, Nat.add_zero]
    · intro q hq
      have h := hv q hq
      simpa only [W.compactReverse5, W.compactForward5, run] using h
  | succ n ih =>
    intro i h1 hb t m2 v m ht hv
    have hi : i ≤ 511 := by omega
    have e1 : reverse i (n+1) = reverse (i+1) n ++ renameProgram (sig i)
        (decodeBefore base i ++ W.compactSkywalkReverseTick base i) := by
      rw [reverse]
    have e2 : W.compactReverse5 base i (n+1) = W.compactReverse5 base (i+1) n ++
        (decodeBefore base i ++ W.compactSkywalkReverseTick base i) := by
      rw [W.compactReverse5, List.append_assoc]
    have e3 : W.compactForward5 base i (n+1) =
        (W.compactSkywalkTick base i ++ packAfter base i) ++
          W.compactForward5 base (i+1) n := by
      rw [W.compactForward5]
    rw [e3, run_append] at hv
    have ht' := (W.compactStage5_step base base_pool_nodup historyAbove x p i hp0 hx0 hpo hp hpGap hx
      cop (by omega) t (m2.take (measurementCount
        (W.compactSkywalkTick base i ++ packAfter base i))) ht).2
    have cntR := (counts_gen (i+1) n).2.2.2.2.1
    obtain ⟨r1, r2⟩ := ih (i+1) (by omega) (by omega) _ _ v
      (m.take (measurementCount (W.compactReverse5 base (i+1) n))) ht' hv
    rw [show i+1-1 = i by omega, show i+1+n-1 = i+(n+1)-1 by omega] at r1
    have rt := oneStep_roundtrip x hx0 hx i (by omega) t ht
      (m2.take (measurementCount (W.compactSkywalkTick base i ++ packAfter base i)))
      (m.drop (measurementCount (W.compactReverse5 base (i+1) n)))
    have agree := pool_agree _ (untick_pool i (by omega))
      (m.drop (measurementCount (W.compactReverse5 base (i+1) n))) _ _ r2
    rw [rt] at agree
    have z := stage_zero x i (by omega) t.basis ht
    have hz1 : (run (decodeBefore base i ++ W.compactSkywalkReverseTick base i)
        (m.drop (measurementCount (W.compactReverse5 base (i+1) n)))
        (run (W.compactReverse5 base (i+1) n)
          (m.take (measurementCount (W.compactReverse5 base (i+1) n))) v)).basis
        (base (1028+i)) = false :=
      (agree _ (base_pool (1028+i) (by omega))).trans z.1
    have hz2 : 257 ≤ i → (run (decodeBefore base i ++ W.compactSkywalkReverseTick base i)
        (m.drop (measurementCount (W.compactReverse5 base (i+1) n)))
        (run (W.compactReverse5 base (i+1) n)
          (m.take (measurementCount (W.compactReverse5 base (i+1) n))) v)).basis
        (base (2053-i)) = false := fun big =>
      (agree _ (base_pool (2053-i) (by omega))).trans (z.2 big)
    rw [e1, e2, run_append, run_append, cntR, r1, run_rename i hi,
      ← pull_step i hi _ hz1 hz2]
    exact ⟨rfl, agree⟩

theorem reverse_run (x : Nat) (hx0 : 0 < x) (hx : x < p) (s : State) (m2 : List Bool)
    (hs : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis)
    (v : State)
    (hv : ∀ q ∈ skywalkPoolWires base,
      v.basis q = (run (W.compactForward5 base 1 511) m2 s).basis q)
    (m : List Bool) :
    run (reverse 1 511) m (pullState (sig 511) v) = run (W.compactReverse5 base 1 511) m v := by
  have h := (reverse_gen x hx0 hx 511 1 (Nat.le_refl 1) (by omega) s m2 v m
    (stage_one x s hs) hv).1
  have e : ∀ u : State, pullState (sig (1-1)) u = u := by
    intro u
    apply State.extensionality
    · rfl
    · funext q
      show u.basis (sig 0 q) = u.basis q
      rw [sig_zero]
  rw [e, show 1+511-1 = 511 from rfl] at h
  exact h

/-! ## Support -/

def integerSites : Finset Wire :=
  (wireBlock base 0 515++wireBlock base 770 515++wireBlock base 1540 257).toFinset

abbrev Good (q : Wire) : Prop := q∈integerSites

theorem integerSites_mem (q : Wire) : q∈integerSites ↔
    ∃l,q=base l ∧ (l<515 ∨ (770≤l ∧ l<1285) ∨ (1540≤l ∧ l<1797)) := by
  simp only [integerSites,List.mem_toFinset,List.mem_append,wireBlock,List.mem_map,
    List.mem_range'_1]
  constructor
  · rintro ((⟨l,hl,rfl⟩|⟨l,hl,rfl⟩)|⟨l,hl,rfl⟩)
    all_goals exact ⟨l,rfl,by omega⟩
  · rintro ⟨l,rfl,(h|h|h)⟩
    · exact Or.inl (Or.inl ⟨l,by omega,rfl⟩)
    · exact Or.inl (Or.inr ⟨l,by omega,rfl⟩)
    · exact Or.inr ⟨l,by omega,rfl⟩

theorem good_label (l : Nat)
    (h : l<515 ∨ (770≤l ∧ l<1285) ∨ (1540≤l ∧ l<1797)) : Good (base l) :=
  (integerSites_mem _).mpr ⟨l,rfl,h⟩

theorem good_placed (k l : Nat) (hk : k ≤ 511)
    (hl : l < 515 ∨ (770 ≤ l ∧ l ≤ 1028+k) ∨ (1540 ≤ l ∧ l < 1797 ∧ l+k < 2053)) :
    Good (sig k (base l)) := by
  rw [sig_base k l hk]
  apply good_label
  split_ifs <;> omega

theorem tick_labels (i : Nat) (hi : i < 512) (h1 : 1 ≤ i) (q : Wire)
    (hq : q ∈ (W.compactSkywalkTickLayout base i).wires.toFinset) :
    ∃ l, q = base l ∧
      (l < 515 ∨ (770 ≤ l ∧ l ≤ 1028+i) ∨ (1540 ≤ l ∧ l < 1797 ∧ l+i < 2053)) := by
  have width := W.compactSkywalkTick_width_bounds i hi
  have view : (W.compactSkywalkTickLayout base i).wires =
      ([skywalkPoolPreviousId i,1028+i,i+W.compactSkywalkTickPreWidth i,i,770]++
      List.range' (i+1) (W.compactSkywalkTickPreWidth i-1)++
      List.range' 771 (W.compactSkywalkTickPreWidth i-1)++
      List.range' 1540 (W.compactSkywalkTickPreWidth i-1)).map base := by
    change base (skywalkPoolPreviousId i)::base (1028+i)::
      base (i+W.compactSkywalkTickPreWidth i)::base i::base 770::
      ((W.compactSkywalkTickLayout base i).ah++(W.compactSkywalkTickLayout base i).bh++
      wireBlock base 1540 (W.compactSkywalkTickPreWidth i-1)) = _
    rw [W.compactSkywalkTick_ah base i hi,W.compactSkywalkTick_bh base i hi]
    simp [wireBlock,List.map_append,List.append_assoc]
  rw [List.mem_toFinset, view] at hq
  obtain ⟨old, h, rfl⟩ := List.mem_map.mp hq
  refine ⟨old, rfl, ?_⟩
  simp only [List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at h
  have hz : i ≠ 0 := by omega
  simp only [skywalkPoolPreviousId,if_neg hz] at h
  omega

theorem codec_labels (i : Nat) (hi : i < 512) (q : Wire)
    (hq : q ∈ wires (packAfter base i) ∨ q ∈ wires (decodeBefore base i)) :
    ∃ l, q = base l ∧ (l < 515 ∨ (770 ≤ l ∧ l ≤ 1028+i)) := by
  cases hd : packDue i
  · simp [packAfter, decodeBefore, hd, wires] at hq
  · have h3 := packDue_true i hd
    rw [packAfter, decodeBefore, if_pos hd, if_pos hd] at hq
    have mem : ∃ u : Fin 10, q = base (historyId (i-5) u) := by
      rcases hq with hq | hq
      · exact history_gate_mem base (i-5) _ (Or.inl rfl) q hq
      · exact history_gate_mem base (i-5) _ (Or.inr rfl) q hq
    obtain ⟨u, rfl⟩ := mem
    refine ⟨_, rfl, ?_⟩
    have hu := u.isLt
    unfold historyId
    split <;> omega

theorem blocks_good (i : Nat) (hi : i < 512) (h1 : 1 ≤ i) :
    (∀ q ∈ wires (renameProgram (sig i)
      (W.compactSkywalkTick base i ++ packAfter base i)), Good q) ∧
    (∀ q ∈ wires (renameProgram (sig i)
      (decodeBefore base i ++ W.compactSkywalkReverseTick base i)), Good q) := by
  have tick : ∀ q ∈ (W.compactSkywalkTickLayout base i).wires.toFinset, Good (sig i q) := by
    intro q hq
    obtain ⟨l, rfl, hl⟩ := tick_labels i hi h1 q hq
    exact good_placed i l (by omega) hl
  have codec : ∀ q, (q ∈ wires (packAfter base i) ∨
      q ∈ wires (decodeBefore base i)) → Good (sig i q) := by
    intro q hq
    obtain ⟨l, rfl, hl⟩ := codec_labels i hi q hq
    exact good_placed i l (by omega) (by omega)
  constructor
  · intro q hq
    rw [renameProgram_support] at hq
    obtain ⟨old, hraw, rfl⟩ := Finset.mem_image.mp hq
    rw [wires_append, Finset.mem_union] at hraw
    rcases hraw with h | h
    · exact tick old (W.compactSkywalkTick_support base i hi base_pool_nodup h)
    · exact codec old (Or.inl h)
  · intro q hq
    rw [renameProgram_support] at hq
    obtain ⟨old, hraw, rfl⟩ := Finset.mem_image.mp hq
    rw [wires_append, Finset.mem_union] at hraw
    rcases hraw with h | h
    · exact codec old (Or.inr h)
    · exact tick old (W.compactSkywalkReverseTick_support base i hi base_pool_nodup h)

theorem support_gen (i n : Nat) (h1 : 1 ≤ i) (hb : i+n ≤ 512) :
    (∀ q ∈ wires (forward i n), Good q) ∧ (∀ q ∈ wires (reverse i n), Good q) := by
  induction n generalizing i with
  | zero => simp [forward, reverse, wires]
  | succ n ih =>
    have rest := ih (i+1) (by omega) (by omega)
    have blocks := blocks_good i (by omega) h1
    rw [forward, reverse]
    constructor
    · intro q hq
      rw [wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · exact blocks.1 q h
      · exact rest.1 q h
    · intro q hq
      rw [wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · exact rest.2 q h
      · exact blocks.2 q h

theorem forward_support : wires (forward 1 511)⊆integerSites :=
  (support_gen 1 511 (Nat.le_refl 1) (by omega)).1

theorem reverse_support : wires (reverse 1 511)⊆integerSites :=
  (support_gen 1 511 (Nat.le_refl 1) (by omega)).2

/-! ## Physical gates -/

theorem physical_gen (i n : Nat) (hb : i+n ≤ 512) :
    GatePhysical (forward i n) ∧ GatePhysical (reverse i n) := by
  induction n generalizing i with
  | zero => simp [forward, reverse, GatePhysical]
  | succ n ih =>
    have rest := ih (i+1) (by omega)
    have tick := W.compactTicks_physical base i (by omega) base_pool_nodup
    have codec := pack_physical5 base base_pool_nodup i (by omega)
    have pack := codec.1
    have unpack := codec.2
    have inj := sig_injective i (by omega)
    have f := gatePhysical_rename _ inj _
      ((gatePhysical_append (W.compactSkywalkTick base i) (packAfter base i)).mpr
        ⟨tick.1, pack⟩)
    have b := gatePhysical_rename _ inj _
      ((gatePhysical_append (decodeBefore base i) (W.compactSkywalkReverseTick base i)).mpr
        ⟨unpack, tick.2⟩)
    rw [forward, reverse, gatePhysical_append, gatePhysical_append]
    exact ⟨⟨f, rest.1⟩, ⟨rest.2, b⟩⟩

theorem forward_physical : GatePhysical (forward 1 511) :=
  (physical_gen 1 511 (by omega)).1

theorem reverse_physical : GatePhysical (reverse 1 511) :=
  (physical_gen 1 511 (by omega)).2


end ECDSAAdd.Entrant.OB5

end


-- ===== StackedIntegerPlacement =====
section

/-! Late-sign placement, adapted from accepted submission12159df8-70b5-4718-9aef-847528abd574,
commit b2d461e7c85fef3e9360d1c5bfbb237687ee2578 (OBSigma/OBInteger).
The integer programs use the local five-trit codec. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1500000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.StackOB5
open Arithmetic MappedCompressed Secp256k1 History5 OB5
def forward (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => renameProgram (sig i) (W.repairedTick base i++packAfter base i)++forward (i+1) n

def reverse (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => reverse (i+1) n++renameProgram (sig i)
      (decodeBefore base i++W.ReverseCarry.compactReceiverTick base i)

attribute [local irreducible] run W.repairedTick W.ReverseCarry.compactReceiverTick
  History5.encode History5.decode

theorem historyAbove : HistoryAbove base := by
  intro j _
  change 10≤j+16
  omega


















theorem encodePrefix_mem (n : Nat) (hn : n ≤ 512) (q : Wire)
    (hq : q ∈ wires (encodePrefix base n)) :
    ∃ j, q = base j ∧ (j+2 ≤ n ∨ (1028 ≤ j ∧ j+2 ≤ 1028+n)) := by
  induction n with
  | zero => simp [encodePrefix, wires] at hq
  | succ n ih =>
    rw [encodePrefix, wires_append, Finset.mem_union] at hq
    rcases hq with hq | hq
    · obtain ⟨j, rfl, hj⟩ := ih (by omega) hq
      exact ⟨j, rfl, by omega⟩
    · cases hd : packDue n
      · simp [packAfter, hd, wires] at hq
      · have h3 := packDue_true n hd
        rw [packAfter, if_pos hd] at hq
        obtain ⟨u, rfl⟩ := history_gate_mem base (n-5) _ (Or.inl rfl) q hq
        refine ⟨_, rfl, ?_⟩
        have hu := u.isLt
        unfold historyId
        split <;> omega

/-- The encode prefix before tick `i` never touches labels at or above `1027+i`. -/
theorem prefix_keep (i : Nat) (hi : i ≤ 512) (raw : State) (l : Nat) (hl : 1027+i ≤ l) :
    (run (encodePrefix base i) [] raw).basis (base l) = raw.basis (base l) := by
  apply run_preserves_outside
  intro hm
  obtain ⟨j, hj, hr⟩ := encodePrefix_mem i hi _ hm
  have := base_injective hj
  omega

theorem stage_zero (x i : Nat) (hi : i < 512) (b : BasisState)
    (h : W.CompressedCompactStage5 base x p i b) :
    b (base (1028+i)) = false ∧ (257 ≤ i → b (base (2053-i)) = false) := by
  obtain ⟨raw, hraw, rfl⟩ := h
  have virt : ∀ l, 1028 ≤ l → W.compactSkywalkStageVirtual base i raw.basis (base l) =
      raw.basis (base l) := by
    intro l hl
    have ex := W.compactSkywalkStage_expanded base i (by omega)
    apply W.compactSkywalkStage_virtual_outside
    · intro hm
      have hm' : base l ∈ (W.compactSkywalkSignPoolA base i).expanded :=
        List.mem_append_right _ hm
      rw [ex.1] at hm'
      obtain ⟨j, hj, he⟩ := List.mem_map.mp hm'
      have := base_injective he
      simp only [List.mem_range'_1] at hj
      omega
    · intro hm
      have hm' : base l ∈ (W.compactSkywalkSignPoolB base i).expanded :=
        List.mem_append_right _ hm
      rw [ex.2] at hm'
      obtain ⟨j, hj, he⟩ := List.mem_map.mp hm'
      have := base_injective he
      simp only [List.mem_range'_1] at hj
      omega
  have stage := hraw.1
  have fut := (stage.2.2.2.2.1 i (Nat.le_refl i) hi).2
  have carry := (regValue_zero _ _).mp stage.2.2.2.2.2.1
  constructor
  · rw [prefix_keep i (by omega) raw (1028+i) (by omega), ← virt (1028+i) (by omega)]
    exact fut
  · intro big
    rw [prefix_keep i (by omega) raw (2053-i) (by omega), ← virt (2053-i) (by omega)]
    apply carry
    exact List.mem_map.mpr ⟨2053-i, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩

theorem stage_one (x : Nat) (s : State)
    (hs : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    W.CompressedCompactStage5 base x p 1 s.basis :=
  W.compactStage5_first base x p s hs

theorem prime_facts (x : Nat) (hx0 : 0 < x) (hx : x < p) :
    0 < p ∧ p%2 = 1 ∧ p < 2^256 ∧ x.Coprime p := by
  refine ⟨by norm_num [p], by norm_num [p], by norm_num [p], ?_⟩
  apply Nat.Coprime.symm
  apply p_prime.coprime_iff_not_dvd.mpr
  intro hd
  exact (Nat.not_le_of_lt hx) (Nat.le_of_dvd hx0 hd)

/-! ## Forward pass -/

theorem forward_gen (x : Nat) (hx0 : 0 < x) (hx : x < p) (n : Nat) :
    ∀ i, 1 ≤ i → i+n ≤ 512 → ∀ (t : State) (m : List Bool),
    W.CompressedCompactStage5 base x p i t.basis →
    run (forward i n) m (pullState (sig (i-1)) t) =
      pullState (sig (i+n-1)) (run (Stack5.forward5 base i n) m t) := by
  obtain ⟨hp0, hpo, hp, cop⟩ := prime_facts x hx0 hx
  have hpGap : p+2^32 ≤ 2^256 := by norm_num [p]
  induction n with
  | zero =>
    intro i _ _ t m _
    simp only [forward, Stack5.forward5, run, Nat.add_zero]
  | succ n ih =>
    intro i h1 hb t m ht
    have hi : i ≤ 511 := by omega
    have z := stage_zero x i (by omega) t.basis ht
    rw [pull_step i hi t z.1 z.2]
    have e1 : forward i (n+1) = renameProgram (sig i)
        (W.repairedTick base i ++ packAfter base i) ++ forward (i+1) n := by
      rw [forward]
    have e2 : Stack5.forward5 base i (n+1) =
        (W.repairedTick base i ++ packAfter base i) ++
          Stack5.forward5 base (i+1) n := by
      rw [Stack5.forward5]
    have cnt := (renameProgram_counts (sig i)
      (W.repairedTick base i ++ packAfter base i)).2
    rw [e1, e2, run_append, run_append, cnt, OB5.run_rename i hi]
    have ht' := (Stack5.step_spec base base_pool_nodup historyAbove x p i hp0 hx0 hpo hp hpGap hx
      cop (by omega) t (m.take (measurementCount
        (W.repairedTick base i ++ packAfter base i))) ht).2
    have step := ih (i+1) (by omega) (by omega) _ (m.drop (measurementCount
        (W.repairedTick base i ++ packAfter base i))) ht'
    rw [show i+1-1 = i by omega] at step
    rw [step, show i+1+n-1 = i+(n+1)-1 by omega]

theorem forward_run (x : Nat) (hx0 : 0 < x) (hx : x < p) (s : State) (m : List Bool)
    (hs : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    run (forward 1 511) m s = pullState (sig 511) (run (Stack5.forward5 base 1 511) m s) := by
  have h := forward_gen x hx0 hx 511 1 (Nat.le_refl 1) (by omega) s m (stage_one x s hs)
  have e : pullState (sig (1-1)) s = s := by
    apply State.extensionality
    · rfl
    · funext q
      show s.basis (sig 0 q) = s.basis q
      rw [sig_zero]
  rw [e, show 1+511-1 = 511 from rfl] at h
  exact h

/-! ## Counts -/

theorem counts_gen (i n : Nat) :
    toffoliCount (forward i n) = toffoliCount (Stack5.forward5 base i n) ∧
    measurementCount (forward i n) = measurementCount (Stack5.forward5 base i n) ∧
    Challenge.gateSlots (forward i n) = Challenge.gateSlots (Stack5.forward5 base i n) ∧
    toffoliCount (reverse i n) = toffoliCount (Stack5.reverse5 base i n) ∧
    measurementCount (reverse i n) = measurementCount (Stack5.reverse5 base i n) ∧
    Challenge.gateSlots (reverse i n) = Challenge.gateSlots (Stack5.reverse5 base i n) := by
  induction n generalizing i with
  | zero => simp [forward, reverse, Stack5.forward5, Stack5.reverse5]
  | succ n ih =>
    have r := ih (i+1)
    have f := renameProgram_counts (sig i) (W.repairedTick base i ++ packAfter base i)
    have b := renameProgram_counts (sig i)
      (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i)
    have fs := Baselines.rename_gateSlots (sig i)
      (W.repairedTick base i ++ packAfter base i)
    have bs := Baselines.rename_gateSlots (sig i)
      (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i)
    rw [forward, reverse, Stack5.forward5, Stack5.reverse5]
    simp only [toffoliCount_append, measurementCount_append, Challenge.gateSlots_append] at f b fs bs ⊢
    omega

theorem forward_counts :
    toffoliCount (forward 1 511) = toffoliCount (Stack5.forward5 base 1 511) ∧
    measurementCount (forward 1 511) = measurementCount (Stack5.forward5 base 1 511) ∧
    Challenge.gateSlots (forward 1 511) = Challenge.gateSlots (Stack5.forward5 base 1 511) :=
  let h := counts_gen 1 511
  ⟨h.1, h.2.1, h.2.2.1⟩

theorem reverse_counts :
    toffoliCount (reverse 1 511) = toffoliCount (Stack5.reverse5 base 1 511) ∧
    measurementCount (reverse 1 511) = measurementCount (Stack5.reverse5 base 1 511) ∧
    Challenge.gateSlots (reverse 1 511) = Challenge.gateSlots (Stack5.reverse5 base 1 511) :=
  let h := counts_gen 1 511
  ⟨h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2⟩

/-! ## Reverse pass -/

/-- One compressed tick followed by its decode and inverse tick is the identity
on every compressed stage state. -/
theorem oneStep_roundtrip (x : Nat) (hx0 : 0 < x) (hx : x < p) (i : Nat) (hi : i < 512)
    (t : State) (ht : W.CompressedCompactStage5 base x p i t.basis) (m1 m2 : List Bool) :
    run (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i) m2
      (run (W.repairedTick base i ++ packAfter base i) m1 t) = t := by
  obtain ⟨hp0,hpo,hp,cop⟩ := prime_facts x hx0 hx
  have hpGap : p+2^32 ≤ 2^256 := by norm_num [p]
  exact Stack5.oneStep_roundtrip base base_pool_nodup x p i hp0 hx0 hpo hp hpGap hx cop hi t ht m1 m2


theorem pool_agree (P : Program) (hP : wires P ⊆ (skywalkPoolWires base).toFinset)
    (m : List Bool) (s t : State)
    (h : ∀ q ∈ skywalkPoolWires base, s.basis q = t.basis q) :
    ∀ q ∈ skywalkPoolWires base, (run P m s).basis q = (run P m t).basis q := by
  have e : (run P m s).basis = (run P m (⟨t.phase, s.basis⟩ : State)).basis :=
    run_basis_records P s _ m m rfl
  have a := pool_run_agrees P _ hP m ⟨t.phase, s.basis⟩ t rfl
    (fun q hq => h q (List.mem_toFinset.mp hq))
  intro q hq
  rw [e]
  exact a.2 q (List.mem_toFinset.mpr hq)

theorem untick_pool (i : Nat) (hi : i < 512) :
    wires (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i) ⊆
      (skywalkPoolWires base).toFinset := by
  have pack := (pack_support5 base i hi).2.trans (integerSites5_pool base)
  have tick := ((W.ReverseCarry.compactReceiverTick_support base i hi base_pool_nodup).trans
    (Stack5.layout_support5 base base_pool_nodup i hi)).trans (integerSites5_pool base)
  simpa only [wires_append,Finset.union_subset_iff] using And.intro pack tick

theorem base_pool (l : Nat) (hl : l < 1798) : base l ∈ skywalkPoolWires base :=
  List.mem_map.mpr ⟨l, List.mem_range'_1.mpr ⟨by omega, by omega⟩, rfl⟩

theorem reverse_gen (x : Nat) (hx0 : 0 < x) (hx : x < p) (n : Nat) :
    ∀ i, 1 ≤ i → i+n ≤ 512 → ∀ (t : State) (m2 : List Bool) (v : State) (m : List Bool),
    W.CompressedCompactStage5 base x p i t.basis →
    (∀ q ∈ skywalkPoolWires base,
      v.basis q = (run (Stack5.forward5 base i n) m2 t).basis q) →
    run (reverse i n) m (pullState (sig (i+n-1)) v) =
      pullState (sig (i-1)) (run (Stack5.reverse5 base i n) m v) ∧
    ∀ q ∈ skywalkPoolWires base, (run (Stack5.reverse5 base i n) m v).basis q = t.basis q := by
  obtain ⟨hp0, hpo, hp, cop⟩ := prime_facts x hx0 hx
  have hpGap : p+2^32 ≤ 2^256 := by norm_num [p]
  induction n with
  | zero =>
    intro i _ _ t m2 v m _ hv
    refine ⟨?_, ?_⟩
    · simp only [reverse, Stack5.reverse5, run, Nat.add_zero]
    · intro q hq
      have h := hv q hq
      simpa only [Stack5.reverse5, Stack5.forward5, run] using h
  | succ n ih =>
    intro i h1 hb t m2 v m ht hv
    have hi : i ≤ 511 := by omega
    have e1 : reverse i (n+1) = reverse (i+1) n ++ renameProgram (sig i)
        (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i) := by
      rw [reverse]
    have e2 : Stack5.reverse5 base i (n+1) = Stack5.reverse5 base (i+1) n ++
        (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i) := by
      rw [Stack5.reverse5, List.append_assoc]
    have e3 : Stack5.forward5 base i (n+1) =
        (W.repairedTick base i ++ packAfter base i) ++
          Stack5.forward5 base (i+1) n := by
      rw [Stack5.forward5]
    rw [e3, run_append] at hv
    have ht' := (Stack5.step_spec base base_pool_nodup historyAbove x p i hp0 hx0 hpo hp hpGap hx
      cop (by omega) t (m2.take (measurementCount
        (W.repairedTick base i ++ packAfter base i))) ht).2
    have cntR := (counts_gen (i+1) n).2.2.2.2.1
    obtain ⟨r1, r2⟩ := ih (i+1) (by omega) (by omega) _ _ v
      (m.take (measurementCount (Stack5.reverse5 base (i+1) n))) ht' hv
    rw [show i+1-1 = i by omega, show i+1+n-1 = i+(n+1)-1 by omega] at r1
    have rt := oneStep_roundtrip x hx0 hx i (by omega) t ht
      (m2.take (measurementCount (W.repairedTick base i ++ packAfter base i)))
      (m.drop (measurementCount (Stack5.reverse5 base (i+1) n)))
    have agree := pool_agree _ (untick_pool i (by omega))
      (m.drop (measurementCount (Stack5.reverse5 base (i+1) n))) _ _ r2
    rw [rt] at agree
    have z := stage_zero x i (by omega) t.basis ht
    have hz1 : (run (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i)
        (m.drop (measurementCount (Stack5.reverse5 base (i+1) n)))
        (run (Stack5.reverse5 base (i+1) n)
          (m.take (measurementCount (Stack5.reverse5 base (i+1) n))) v)).basis
        (base (1028+i)) = false :=
      (agree _ (base_pool (1028+i) (by omega))).trans z.1
    have hz2 : 257 ≤ i → (run (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i)
        (m.drop (measurementCount (Stack5.reverse5 base (i+1) n)))
        (run (Stack5.reverse5 base (i+1) n)
          (m.take (measurementCount (Stack5.reverse5 base (i+1) n))) v)).basis
        (base (2053-i)) = false := fun big =>
      (agree _ (base_pool (2053-i) (by omega))).trans (z.2 big)
    rw [e1, e2, run_append, run_append, cntR, r1, OB5.run_rename i hi,
      ← pull_step i hi _ hz1 hz2]
    exact ⟨rfl, agree⟩

theorem reverse_run (x : Nat) (hx0 : 0 < x) (hx : x < p) (s : State) (m2 : List Bool)
    (hs : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis)
    (v : State)
    (hv : ∀ q ∈ skywalkPoolWires base,
      v.basis q = (run (Stack5.forward5 base 1 511) m2 s).basis q)
    (m : List Bool) :
    run (reverse 1 511) m (pullState (sig 511) v) = run (Stack5.reverse5 base 1 511) m v := by
  have h := (reverse_gen x hx0 hx 511 1 (Nat.le_refl 1) (by omega) s m2 v m
    (stage_one x s hs) hv).1
  have e : ∀ u : State, pullState (sig (1-1)) u = u := by
    intro u
    apply State.extensionality
    · rfl
    · funext q
      show u.basis (sig 0 q) = u.basis q
      rw [sig_zero]
  rw [e, show 1+511-1 = 511 from rfl] at h
  exact h

/-! ## Support -/

def integerSites : Finset Wire :=
  (wireBlock base 0 515++wireBlock base 770 515++wireBlock base 1540 257).toFinset

abbrev Good (q : Wire) : Prop := q∈integerSites

theorem integerSites_mem (q : Wire) : q∈integerSites ↔
    ∃l,q=base l ∧ (l<515 ∨ (770≤l ∧ l<1285) ∨ (1540≤l ∧ l<1797)) := by
  simp only [integerSites,List.mem_toFinset,List.mem_append,wireBlock,List.mem_map,
    List.mem_range'_1]
  constructor
  · rintro ((⟨l,hl,rfl⟩|⟨l,hl,rfl⟩)|⟨l,hl,rfl⟩)
    all_goals exact ⟨l,rfl,by omega⟩
  · rintro ⟨l,rfl,(h|h|h)⟩
    · exact Or.inl (Or.inl ⟨l,by omega,rfl⟩)
    · exact Or.inl (Or.inr ⟨l,by omega,rfl⟩)
    · exact Or.inr ⟨l,by omega,rfl⟩

theorem good_label (l : Nat)
    (h : l<515 ∨ (770≤l ∧ l<1285) ∨ (1540≤l ∧ l<1797)) : Good (base l) :=
  (integerSites_mem _).mpr ⟨l,rfl,h⟩

theorem good_placed (k l : Nat) (hk : k ≤ 511)
    (hl : l < 515 ∨ (770 ≤ l ∧ l ≤ 1028+k) ∨ (1540 ≤ l ∧ l < 1797 ∧ l+k < 2053)) :
    Good (sig k (base l)) := by
  rw [sig_base k l hk]
  apply good_label
  split_ifs <;> omega

theorem tick_labels (i : Nat) (hi : i < 512) (h1 : 1 ≤ i) (q : Wire)
    (hq : q ∈ (W.compactSkywalkTickLayout base i).wires.toFinset) :
    ∃ l, q = base l ∧
      (l < 515 ∨ (770 ≤ l ∧ l ≤ 1028+i) ∨ (1540 ≤ l ∧ l < 1797 ∧ l+i < 2053)) := by
  have width := W.compactSkywalkTick_width_bounds i hi
  have view : (W.compactSkywalkTickLayout base i).wires =
      ([skywalkPoolPreviousId i,1028+i,i+W.compactSkywalkTickPreWidth i,i,770]++
      List.range' (i+1) (W.compactSkywalkTickPreWidth i-1)++
      List.range' 771 (W.compactSkywalkTickPreWidth i-1)++
      List.range' 1540 (W.compactSkywalkTickPreWidth i-1)).map base := by
    change base (skywalkPoolPreviousId i)::base (1028+i)::
      base (i+W.compactSkywalkTickPreWidth i)::base i::base 770::
      ((W.compactSkywalkTickLayout base i).ah++(W.compactSkywalkTickLayout base i).bh++
      wireBlock base 1540 (W.compactSkywalkTickPreWidth i-1)) = _
    rw [W.compactSkywalkTick_ah base i hi,W.compactSkywalkTick_bh base i hi]
    simp [wireBlock,List.map_append,List.append_assoc]
  rw [List.mem_toFinset, view] at hq
  obtain ⟨old, h, rfl⟩ := List.mem_map.mp hq
  refine ⟨old, rfl, ?_⟩
  simp only [List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at h
  have hz : i ≠ 0 := by omega
  simp only [skywalkPoolPreviousId,if_neg hz] at h
  omega

theorem codec_labels (i : Nat) (hi : i < 512) (q : Wire)
    (hq : q ∈ wires (packAfter base i) ∨ q ∈ wires (decodeBefore base i)) :
    ∃ l, q = base l ∧ (l < 515 ∨ (770 ≤ l ∧ l ≤ 1028+i)) := by
  cases hd : packDue i
  · simp [packAfter, decodeBefore, hd, wires] at hq
  · have h3 := packDue_true i hd
    rw [packAfter, decodeBefore, if_pos hd, if_pos hd] at hq
    have mem : ∃ u : Fin 10, q = base (historyId (i-5) u) := by
      rcases hq with hq | hq
      · exact history_gate_mem base (i-5) _ (Or.inl rfl) q hq
      · exact history_gate_mem base (i-5) _ (Or.inr rfl) q hq
    obtain ⟨u, rfl⟩ := mem
    refine ⟨_, rfl, ?_⟩
    have hu := u.isLt
    unfold historyId
    split <;> omega

theorem blocks_good (i : Nat) (hi : i < 512) (h1 : 1 ≤ i) :
    (∀ q ∈ wires (renameProgram (sig i)
      (W.repairedTick base i ++ packAfter base i)), Good q) ∧
    (∀ q ∈ wires (renameProgram (sig i)
      (decodeBefore base i ++ W.ReverseCarry.compactReceiverTick base i)), Good q) := by
  have tick : ∀ q ∈ (W.compactSkywalkTickLayout base i).wires.toFinset, Good (sig i q) := by
    intro q hq
    obtain ⟨l, rfl, hl⟩ := tick_labels i hi h1 q hq
    exact good_placed i l (by omega) hl
  have codec : ∀ q, (q ∈ wires (packAfter base i) ∨
      q ∈ wires (decodeBefore base i)) → Good (sig i q) := by
    intro q hq
    obtain ⟨l, rfl, hl⟩ := codec_labels i hi q hq
    exact good_placed i l (by omega) (by omega)
  constructor
  · intro q hq
    rw [renameProgram_support] at hq
    obtain ⟨old, hraw, rfl⟩ := Finset.mem_image.mp hq
    rw [wires_append, Finset.mem_union] at hraw
    rcases hraw with h | h
    · exact tick old (W.repairedTick_support base i hi base_pool_nodup h)
    · exact codec old (Or.inl h)
  · intro q hq
    rw [renameProgram_support] at hq
    obtain ⟨old, hraw, rfl⟩ := Finset.mem_image.mp hq
    rw [wires_append, Finset.mem_union] at hraw
    rcases hraw with h | h
    · exact codec old (Or.inr h)
    · exact tick old (W.ReverseCarry.compactReceiverTick_support base i hi base_pool_nodup h)

theorem support_gen (i n : Nat) (h1 : 1 ≤ i) (hb : i+n ≤ 512) :
    (∀ q ∈ wires (forward i n), Good q) ∧ (∀ q ∈ wires (reverse i n), Good q) := by
  induction n generalizing i with
  | zero => simp [forward, reverse, wires]
  | succ n ih =>
    have rest := ih (i+1) (by omega) (by omega)
    have blocks := blocks_good i (by omega) h1
    rw [forward, reverse]
    constructor
    · intro q hq
      rw [wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · exact blocks.1 q h
      · exact rest.1 q h
    · intro q hq
      rw [wires_append, Finset.mem_union] at hq
      rcases hq with h | h
      · exact rest.2 q h
      · exact blocks.2 q h

theorem forward_support : wires (forward 1 511)⊆integerSites :=
  (support_gen 1 511 (Nat.le_refl 1) (by omega)).1

theorem reverse_support : wires (reverse 1 511)⊆integerSites :=
  (support_gen 1 511 (Nat.le_refl 1) (by omega)).2

/-! ## Physical gates -/

theorem physical_gen (i n : Nat) (hb : i+n ≤ 512) :
    GatePhysical (forward i n) ∧ GatePhysical (reverse i n) := by
  induction n generalizing i with
  | zero => simp [forward, reverse, GatePhysical]
  | succ n ih =>
    have rest := ih (i+1) (by omega)
    have tick := And.intro (W.repairedTick_physical base i (by omega) base_pool_nodup)
      (W.ReverseCarry.compactReceiverTick_physical base i (by omega) base_pool_nodup)
    have codec := pack_physical5 base base_pool_nodup i (by omega)
    have pack := codec.1
    have unpack := codec.2
    have inj := sig_injective i (by omega)
    have f := gatePhysical_rename _ inj _
      ((gatePhysical_append (W.repairedTick base i) (packAfter base i)).mpr
        ⟨tick.1, pack⟩)
    have b := gatePhysical_rename _ inj _
      ((gatePhysical_append (decodeBefore base i) (W.ReverseCarry.compactReceiverTick base i)).mpr
        ⟨unpack, tick.2⟩)
    rw [forward, reverse, gatePhysical_append, gatePhysical_append]
    exact ⟨⟨f, rest.1⟩, ⟨rest.2, b⟩⟩

theorem forward_physical : GatePhysical (forward 1 511) :=
  (physical_gen 1 511 (by omega)).1

theorem reverse_physical : GatePhysical (reverse 1 511) :=
  (physical_gen 1 511 (by omega)).2


end ECDSAAdd.Entrant.StackOB5

end



-- ===== ECDSAAdd.Submission.Entrant.OB5IntegerSupport =====
section

/-! The emitted retired-sign integer programs fit the one-bank inventory. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.OB5Support
open Arithmetic MappedCompressed

theorem integer_sub_logical : OB5.integerSites ⊆ logicalSites := by
  intro q hq
  obtain ⟨i,rfl,hi⟩ := (OB5.integerSites_mem q).mp hq
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨i,?_,rfl⟩
  simp only [logicalIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false]
  omega

theorem forward_support_logical : wires (OB5.forward 1 511) ⊆ logicalSites :=
  OB5.forward_support.trans integer_sub_logical

theorem reverse_support_logical : wires (OB5.reverse 1 511) ⊆ logicalSites :=
  OB5.reverse_support.trans integer_sub_logical

end ECDSAAdd.Entrant.OB5Support

end


-- ===== ECDSAAdd.Submission.Entrant.HalfFieldOB5Support =====
section

/-! Actual endpoint support follows from the finite input-site image. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.HalfFieldOB5Support
open Arithmetic MappedCompressed
attribute [local irreducible] wires HalfField.centerT HalfField.canonT HalfField.copyN

private def preFrame (i : Nat) : Prop :=
  (i < 1542 ∧ i ≠ 769 ∧ i ≠ 511 ∧ i ≠ 1539) ∨ i=1796 ∨ i=1797 ∨ (2056 ≤ i ∧ i < 2312)

private theorem bank_index (i : Nat) : HalfFieldOB5.bank i =
    if 512 ≤ i ∧ i < 767 then i+1028 else if 1540 ≤ i ∧ i < 1795 then i-1028 else i := rfl

private theorem endpoint_apply (q : Wire) : HalfFieldOB5.endpointMap q =
    OB5.sig 511 (Equiv.swap (base 1796) (base 1285)
      (shifted (Placement5.pi 51) (shifted HalfFieldOB5.bank q))) := rfl

attribute [local irreducible] HalfFieldOB5.bank HalfFieldOB5.endpointMap HalfFieldOB5.relocate
  Placement5.pi OB5.sig shifted

private theorem banked (i : Nat) (hi : i∈HalfField.ids) :
    preFrame (HalfFieldOB5.bank i) ∧ HalfFieldOB5.bank i ≠ 1285 ∧
      ¬Placement5.holeRegion (HalfFieldOB5.bank i) := by
  simp only [HalfField.ids,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at hi
  rw [bank_index]
  unfold preFrame Placement5.holeRegion
  split_ifs <;> omega

private theorem perm_frame (e : Equiv.Perm Nat)
    (fix : ∀i,¬Placement5.zeroRegion i → e i=i) (i : Nat) (hi : preFrame i) : preFrame (e i) := by
  have bounded (i : Nat) (hi : i<1542) : e i<1542 := by
    by_contra hn
    have outside : ¬Placement5.zeroRegion (e i) := by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega
    have same := e.injective (fix (e i) outside)
    omega
  have no769 (i : Nat) (hi : i≠769) : e i≠769 := by
    intro eq
    have same := e.injective (eq.trans (fix 769 (by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega)).symm)
    exact hi same
  rcases hi with h|h|h|h
  · have noC (c : Nat) (hc : ¬Placement5.zeroRegion c) (k : Nat) (hk : k≠c) : e k≠c := by
      intro eq
      exact hk (e.injective (eq.trans (fix c hc).symm))
    exact Or.inl ⟨bounded i h.1,no769 i h.2.1,
      noC 511 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.1,
      noC 1539 (by unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion; omega) i h.2.2.2⟩
  all_goals
    have outside : ¬Placement5.zeroRegion i := by
      unfold Placement5.zeroRegion Placement5.workRegion Placement5.holeRegion
      omega
    rw [fix i outside]
    unfold preFrame
    omega

private theorem sigma_mem (i : Nat) (hi : preFrame i) (safe : ¬Placement5.omitted i)
    (noFlag : i≠1796) : OB5.sig 511 (base i)∈OB5Support.segSites := by
  rw [OB5.sig_base 511 i (by decide)]
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨_,?_,rfl⟩
  simp only [OB5Support.segIndices,List.mem_append,List.mem_range'_1,List.mem_cons,
    List.not_mem_nil,or_false]
  unfold preFrame Placement5.omitted at *
  split_ifs <;> omega

/-- The bank, codec placement, flag swap, and final sign map use retained sites. -/
theorem endpoint_image (i : Nat) (hi : i∈HalfField.ids) :
    HalfFieldOB5.endpointMap (base i)∈OB5Support.segSites := by
  have before := banked i hi
  let u := Placement5.pi 51 (HalfFieldOB5.bank i)
  have frame : preFrame u := perm_frame (Placement5.pi 51)
    (fun q hq => Placement5.pi_outside 51 q (by decide) hq) _ before.1
  have safe : ¬Placement5.omitted u := Placement5.nonhole_pi_safe 51 _ (by decide) before.2.2
  have fix : Placement5.pi 51 1285=1285 := by
    simpa only [show Placement5.H (2*51)=1285 by decide] using Placement5.pi_current_even 51 (by decide)
  have noHole : u≠1285 := by
    intro eq
    exact before.2.1 ((Placement5.pi 51).injective (eq.trans fix.symm))
  rw [endpoint_apply,shifted_base,shifted_base]
  change OB5.sig 511 (Equiv.swap (base 1796) (base 1285) (base u))∈OB5Support.segSites
  by_cases flag : u=1796
  · rw [flag,Equiv.swap_apply_left,OB5.sig_base 511 1285 (by decide)]
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨1796,?_,by decide⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false]
    omega
  · rw [Equiv.swap_apply_of_ne_of_ne (fun eq => flag (base_injective eq))
      (fun eq => noHole (base_injective eq))]
    exact sigma_mem u frame safe flag

private theorem relocated_support (P : Program)
    (hP : wires P⊆(HalfField.ids.map base).toFinset) :
    wires (renameProgram HalfFieldOB5.endpointMap P)⊆OB5Support.segSites := by
  rw [renameProgram_support]
  intro q hq
  obtain ⟨old,used,rfl⟩ := Finset.mem_image.mp hq
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp (hP used))
  exact endpoint_image i hi

theorem center_support : wires HalfFieldOB5.centerT⊆OB5Support.segSites :=
  relocated_support HalfField.centerT HalfField.centerT_sites

theorem canon_support : wires HalfFieldOB5.canonT⊆OB5Support.segSites :=
  relocated_support HalfField.canonT HalfField.canonT_sites

theorem copy_support : wires HalfFieldOB5.copyN⊆OB5Support.segSites := by
  intro q hq
  have h := copyRegister_wires_subset none HalfField.ports.r HalfField.ports.y (by
    simpa only [HalfFieldOB5.copyN, HalfField5.copyN, HalfField.copyN] using hq)
  have pr : HalfField.ports.r = wireBlock base 2056 256 := balancedSharedPorts_r base (base 2409)
  have py : HalfField.ports.y = wireBlock base 770 256 := balancedSharedPorts_y base (base 2409)
  rw [pr,py] at h
  simp only [Option.toList_none,List.nil_append,List.mem_toFinset,List.mem_append,
    wireBlock,List.mem_map,List.mem_range'_1] at h
  rcases h with ⟨i,hi,rfl⟩|⟨i,hi,rfl⟩
  all_goals
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨i,?_,rfl⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_cons,List.not_mem_nil,
      List.mem_range'_1,or_false]
    omega

end ECDSAAdd.Entrant.HalfFieldOB5Support


section
namespace ECDSAAdd.Entrant.OwnPlusEndpoint
open Arithmetic MappedCompressed
theorem support : wires centerT⊆OB5Support.segSites ∧ wires canonT⊆OB5Support.segSites := by
  have mem (q : Nat) (hq : q=766 ∨ q=768) : base q∈OB5Support.segSites := by
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨q,?_,rfl⟩
    simp only [OB5Support.segIndices,List.mem_append,List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false]
    omega
  have rename (P : Program) (hp : wires P⊆OB5Support.segSites) :
      wires (renameProgram swap P)⊆OB5Support.segSites := by
    rw [renameProgram_support]
    intro q hq
    obtain ⟨old,used,rfl⟩:=Finset.mem_image.mp hq
    by_cases a:old=base 766
    · subst old; simpa only [swap,Equiv.swap_apply_left] using mem 768 (Or.inr rfl)
    · by_cases b:old=base 768
      · subst old; simpa only [swap,Equiv.swap_apply_right] using mem 766 (Or.inl rfl)
      · simpa only [swap,Equiv.swap_apply_of_ne_of_ne a b] using hp used
  exact ⟨rename _ HalfFieldOB5Support.center_support,rename _ HalfFieldOB5Support.canon_support⟩
end ECDSAAdd.Entrant.OwnPlusEndpoint

end


