  have vCore : Valid uPre (leaveAdjustCore15E (start15E j)) := (before15E_split_core (start15E j) ▸ vBef).parts.2
  have hadj : adjW15E (start15E j) = wp15E (start15E j) - 1 := rfl
  have hw2 : 2 ≤ wp15E (start15E j) := by omega
  let ys' := (List.range (adjW15E (start15E j))).map (bankW15E (start15E j))
  let cs' := (List.range (adjW15E (start15E j) - 1)).map (poolW15E (start15E j))
  let ytop := bankW15E (start15E j) (adjW15E (start15E j))
  let ctop := poolW15E (start15E j) (adjW15E (start15E j) - 1)
  have hys_eq : ys15E j = ys' ++ [ytop] := by
