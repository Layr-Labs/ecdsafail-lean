  cases divide <;> simp only [cell,selectSwap,halfWindow,Bool.false_eq_true,if_true,if_false,
    toffoliCount_append,measurementCount_append] <;>
    rw [h.1,h.2,s.1,s.2.1,len.2.1,e.1,e.2,k.1,k.2] <;> omega

