section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588CodecCounts

/-! Bit and safety locality for compact checked circuit components. -/
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitsOf bitRun bitStep safe safeStep sim corrSim)

theorem sim_basis (P : Program) (m : List Bool) (ph : Bool) (x : Nat) :
    (sim P m ph x).2=bitRun P x := by
  induction P generalizing m ph x with
  | nil => rfl
  | cons i P ih =>
    cases i <;> simp only [sim,bitRun,bitStep] <;> apply ih

theorem bitRun_congr (P : Program) (S : Finset Wire) (support : wires P⊆S)
    (x y : Nat) (agree : ∀q∈S,x.testBit q=y.testBit q) :
    ∀q∈S,(bitRun P x).testBit q=(bitRun P y).testBit q := by
  have same := pool_run_agrees P S support [] ⟨false,bitsOf x⟩ ⟨false,bitsOf y⟩ rfl agree
  intro q hq
  simpa only [MeasuredCodec5.run_sim,sim_basis,bitsOf] using same.2 q hq

theorem bitRun_outside (P : Program) (x q : Nat) (off : q∉wires P) :
    (bitRun P x).testBit q=x.testBit q := by
  have same := run_preserves_outside P [] ⟨false,bitsOf x⟩ q off
  simpa only [MeasuredCodec5.run_sim,sim_basis,bitsOf] using same

private theorem corrSim_congr (cs : List Correction) (S : Finset Wire) (x y : Nat)
    (agree : ∀q∈S,x.testBit q=y.testBit q) :
    ∀ph,correctionWires cs⊆S → corrSim cs ph x=corrSim cs ph y := by
  induction cs with
  | nil => intro ph support; rfl
  | cons c cs ih =>
    intro ph support
    cases c with
    | Z t =>
      have ht := support (Finset.mem_union_left _ (Finset.mem_singleton_self t))
      have tail : correctionWires cs⊆S := fun _ h => support (Finset.mem_union_right _ h)
      simp only [corrSim]
      rw [agree t ht]
      exact ih _ tail
    | CZ a b =>
      have ha := support (Finset.mem_union_left _ (by simp : a∈({a,b} : Finset Wire)))
      have hb := support (Finset.mem_union_left _ (by simp : b∈({a,b} : Finset Wire)))
      have tail : correctionWires cs⊆S := fun _ h => support (Finset.mem_union_right _ h)
      simp only [corrSim]
      rw [agree a ha,agree b hb]
      exact ih _ tail

private theorem safeStep_congr (i : Instr) (S : Finset Wire) (support : i.wires⊆S)
    (x y : Nat) (agree : ∀q∈S,x.testBit q=y.testBit q) : safeStep i x=safeStep i y := by
  cases i with
  | X t => rfl
  | CX c t => rfl
  | CCX a b t => rfl
  | measureX t c0 c1 =>
    have ht : t∈S := support (Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_singleton_self t)))
    have h0 : correctionWires c0⊆S := fun _ h => support
      (Finset.mem_union_left _ (Finset.mem_union_right _ h))
    have h1 : correctionWires c1⊆S := fun _ h => support (Finset.mem_union_right _ h)
    have singleton : wires [Instr.measureX t c0 c1]⊆S := by
      simpa only [wires,Finset.union_empty] using support
    have cleared := bitRun_congr [Instr.measureX t c0 c1] S singleton x y agree
    simp only [bitRun,bitStep] at cleared
    simp only [safeStep]
    rw [corrSim_congr c0 S _ _ cleared false h0,corrSim_congr c1 S _ _ cleared false h1,
      agree t ht]

theorem safe_congr (P : Program) (S : Finset Wire) (x y : Nat) :
    wires P⊆S → (∀q∈S,x.testBit q=y.testBit q) → safe P x=safe P y := by
  induction P generalizing x y with
  | nil => intro support agree; rfl
  | cons i P ih =>
    intro support agree
    have head : i.wires⊆S := fun _ h => support (Finset.mem_union_left _ h)
    have tail : wires P⊆S := fun _ h => support (Finset.mem_union_right _ h)
    have singleton : wires [i]⊆S := by simpa only [wires,Finset.union_empty] using head
    have next := bitRun_congr [i] S singleton x y agree
    simp only [bitRun] at next
    simp only [safe]
    rw [safeStep_congr i S head x y agree,ih _ _ tail next]

theorem bitRun_lt (P : Program) (n : Nat) (support : wires P⊆Finset.range n)
    (x : Nat) (hx : x<2^n) : bitRun P x<2^n := by
  have modEq : (bitRun P x)%2^n=bitRun P x := by
    apply Nat.eq_of_testBit_eq
    intro q
    by_cases low : q<n
    · simp only [Nat.testBit_mod_two_pow,low,decide_true,Bool.true_and]
    · have off : q∉wires P := fun used => low (Finset.mem_range.mp (support used))
      have zero : x.testBit q=false := Nat.testBit_lt_two_pow
        (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by decide) (Nat.le_of_not_gt low)))
      simp only [Nat.testBit_mod_two_pow,low,decide_false,Bool.false_and,
        bitRun_outside P x q off,zero]
  rw [←modEq]
  exact Nat.mod_lt _ (pow_pos (by decide) _)

theorem bitRun_commute (P Q : Program) (apart : Disjoint (wires P) (wires Q)) (x : Nat) :
    bitRun Q (bitRun P x)=bitRun P (bitRun Q x) := by
  have pInput : ∀q∈wires P,(bitRun Q x).testBit q=x.testBit q := by
    intro q hq
    exact bitRun_outside Q x q (fun used => Finset.disjoint_left.mp apart hq used)
  have qInput : ∀q∈wires Q,(bitRun P x).testBit q=x.testBit q := by
    intro q hq
    exact bitRun_outside P x q (fun used => Finset.disjoint_left.mp apart used hq)
  have pSame := bitRun_congr P (wires P) (Finset.Subset.refl _) _ _ pInput
  have qSame := bitRun_congr Q (wires Q) (Finset.Subset.refl _) _ _ qInput
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases hp : q∈wires P
  · rw [bitRun_outside Q _ q (fun hq => Finset.disjoint_left.mp apart hp hq)]
    exact (pSame q hp).symm
  · rw [bitRun_outside P _ q hp]
    by_cases hq : q∈wires Q
    · exact qSame q hq
    · rw [bitRun_outside Q _ q hq,bitRun_outside Q _ q hq,bitRun_outside P _ q hp]

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

