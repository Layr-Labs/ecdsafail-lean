    hnd_add haway_add (by decide +kernel) (by decide +kernel) v0 [] hclean_u
  rw [hadd_eq _ _ _ _ (by decide +kernel) (by decide +kernel)]
  have hrv : regValue (L760.low.drop 1 ++ [L760.rmsb, L760.one])
