/-!
# Kernel checks for the odd-word head

Static facts about the odd-word cells used by the head and the tail (`P1Life.half`,
`P1Life.dstart`, `P1Life.dend`, `P1Life.mstart`, `P1Life.mend`, all at the record placement
`base 760`):

* the zero tracker of `StairField13V3ZT` on the 44 exclusive roles.  Only the resetting
  suffix of each cell is evaluated (its last ripple pass; for the ordinary half the last two,
  because the short constant adder does not use the two highest roles);
* the record half `R2Life760.half760 true` mentions every wire of the cell footprint.  Only
  five top-level pieces of the record half are scanned, into one bit mask.

No program run is evaluated.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000

namespace ECDSAAdd.Entrant.StairOddHead

open ECDSAAdd Arithmetic Challenge MappedCompressed
open StairField13V3Clean

/-- The field cell layout at the record placement. -/
abbrev cellL : BalancedCircuit.Layout := Q6EndpointCell.ports base (base 2409)

/-! ## Zero tracker -/

/-! ## KX3 (replay budget): ripple passes as fused sweeps

The kernel builds a ripple generator (`majority ++ rec ++ erase`) with left-nested appends,
which costs quadratic time in the width (≈ 28 s for one 255-bit pass, before any tracker
runs).  A ripple pass is a `StairLoan.emitSweep`; the tracker of its down-pass is evaluated
through a recursion fused along the layer list, so no gate list of a pass is built. -/

/-- The tracker of `StairLoan.emitDowns`, fused along the layer list. -/
def kx3ztDowns (lo width : Nat) : Nat → List StairLoan.CarryLayer → Nat
  | m, [] => m
  | m, l :: ls => ztM lo width (kx3ztDowns lo width m ls) (l.erase ++ l.finish)




















/-! ### Multiplication cells (`P1Life.half … false`, `P1Life.mstart`, `P1Life.mend`) -/














/-! ## Wires mentioned by a program, as one bit mask -/

/-- Wires of a correction list, as a list. -/
def corrWs : List Correction → List Wire
  | [] => []
  | .Z t :: cs => t :: corrWs cs
  | .CZ a b :: cs => a :: b :: corrWs cs

/-- Wires of an instruction, as a list. -/
def instrWs : Instr → List Wire
  | .X t => [t]
  | .CX c t => [c, t]
  | .CCX a b t => [a, b, t]
  | .measureX t c0 c1 => t :: (corrWs c0 ++ corrWs c1)

theorem mem_corrWs (q : Wire) (cs : List Correction) :
    q ∈ corrWs cs ↔ q ∈ correctionWires cs := by
  induction cs with
  | nil => simp [corrWs, correctionWires]
  | cons c cs ih =>
      cases c <;> simp [corrWs, correctionWires, ih]

theorem mem_instrWs (q : Wire) (i : Instr) : q ∈ instrWs i ↔ q ∈ i.wires := by
  cases i <;> simp [instrWs, Instr.wires, mem_corrWs]

/-- Bit mask of the wires mentioned by a program, added to `m`.  Tail recursive, with the
mask forced at every instruction, so kernel evaluation stays shallow. -/
def progMask : Nat → Program → Nat
  | m, [] => m
  | m, i :: P =>
      cond (Nat.beq (m ||| StairLoan.maskOf (instrWs i)) (m ||| StairLoan.maskOf (instrWs i)))
        (progMask (m ||| StairLoan.maskOf (instrWs i)) P)
        (progMask (m ||| StairLoan.maskOf (instrWs i)) P)

theorem mem_wires_of_mask : ∀ (P : Program) (m : Nat) (q : Wire),
    (progMask m P).testBit q = true → m.testBit q = true ∨ q ∈ wires P
  | [], _, _, h => Or.inl h
  | i :: P, m, q, h => by
    simp only [progMask, Bool.cond_self] at h
    rcases mem_wires_of_mask P _ q h with h1 | h2
    · simp only [Nat.testBit_or, Bool.or_eq_true] at h1
      rcases h1 with h1 | h1
      · exact Or.inl h1
      · refine Or.inr ?_
        rw [wires, Finset.mem_union]
        exact Or.inl ((mem_instrWs q i).mp (StairLoan.mem_of_maskOf h1))
    · refine Or.inr ?_
      rw [wires, Finset.mem_union]
      exact Or.inr h2

theorem touches_of_mask (qs : List Wire) (P : Program)
    (h : qs.all (fun q => (progMask 0 P).testBit q) = true) : ∀ q ∈ qs, q ∈ wires P := by
  intro q hq
  rcases mem_wires_of_mask P 0 q (List.all_eq_true.mp h q hq) with h0 | h1
  · simp at h0
  · exact h1

/-! ### KX3 (replay budget): the mask of left-nested generators, fused

`rotateLeft` and the down-pass of a ripple are built with left-nested appends (quadratic for
the kernel); their masks are evaluated through fused recursions instead. -/

theorem kx3_pm_append : ∀ (A B : Program) (m : Nat),
    progMask m (A ++ B) = progMask (progMask m A) B
  | [], _, _ => rfl
  | i :: A, B, m => by
    simp only [List.cons_append, progMask, Bool.cond_self]
    exact kx3_pm_append A B _

theorem kx3_rename_append (f : Wire → Wire) (A B : Program) :
    renameProgram f (A ++ B) = renameProgram f A ++ renameProgram f B := by
  simp only [renameProgram, List.map_append]

/-- The mask of a renamed `StairLoan.emitDowns`, fused along the layer list. -/
def kx3pmDownsR (f : Wire → Wire) : Nat → List StairLoan.CarryLayer → Nat
  | m, [] => m
  | m, l :: ls => progMask (kx3pmDownsR f m ls) (renameProgram f (l.erase ++ l.finish))

theorem kx3_pm_downsR (f : Wire → Wire) : ∀ (ls : List StairLoan.CarryLayer) (m : Nat),
    progMask m (renameProgram f (StairLoan.emitDowns ls)) = kx3pmDownsR f m ls
  | [], _ => rfl
  | l :: ls, m => by
    show progMask m (renameProgram f (StairLoan.emitDowns ls ++ (l.erase ++ l.finish))) = _
    rw [kx3_rename_append, kx3_pm_append, kx3_pm_downsR f ls m]
    rfl

/-- The mask of `rotateLeft`, fused along its recursion. -/
def kx3pmRotL : Nat → List Wire → Nat
  | m, a :: b :: bs => progMask (kx3pmRotL m (b :: bs)) (swapBits a b)
  | m, _ => m

theorem kx3_pm_rotL : ∀ (r : List Wire) (m : Nat), progMask m (rotateLeft r) = kx3pmRotL m r
  | [], _ => rfl
  | [_], _ => rfl
  | a :: b :: bs, m => by
    show progMask m (rotateLeft (b :: bs) ++ swapBits a b) = _
    rw [kx3_pm_append, kx3_pm_rotL (b :: bs) m]
    rfl

-- From here on `wires` of a concrete program must never be unfolded by the elaborator.
attribute [local irreducible] wires

/-- The footprint of the field cell at the record placement, without the retired carry. -/
def footprintList : List Wire :=
  ((cellL.sign :: cellL.parity :: cellL.lower :: cellL.one ::
    (cellL.r ++ cellL.y ++ cellL.carry.take 254))).filter (fun q => q != base 760)

/-- Five top-level pieces of the record division half that mention the whole footprint. -/
def recordPieces : Program :=
  GuardCompression.seed cellL ++ (BalancedCleanup.prepareSign cellL.toLayout ++
    (BalancedCleanup.prepareCompare cellL.toLayout ++
      (Q6LifetimeResearch.unnormalize (base 760) false cellL ++ [.measureX cellL.one [] []])))

set_option maxHeartbeats 0 in
theorem chk_footprint_mask :
    footprintList.all (fun q => (progMask 0 recordPieces).testBit q) = true := by
  -- KX3 (replay budget): fused masks of the ripple down-pass and of `rotateLeft`
  simp only [recordPieces, Q6LifetimeResearch.unnormalize, Q6LifetimeResearch.move,
    BalancedCleanup.unnormalize, BalancedCleanup.prepareCompare, Bool.false_eq_true, ↓reduceIte,
    StairLoan.literalConstAdd_as_sweep, StairLoan.emitSweep, kx3_rename_append, kx3_pm_append,
    kx3_pm_downsR, kx3_pm_rotL]
  decide +kernel

/-- The parts of the record division half between the five pieces. -/
def recordGap1 : Program :=
  Q6LifetimeResearch.rawAdd (base 760) cellL ++ (OneReuse.newPrepare cellL ++
    (rotateRight (BalancedCircuit.rawTarget cellL) ++ Q6LifetimeResearch.fold (base 760) cellL))

def recordGap3 : Program :=
  Q6StructuralCell.exposure cellL ++ (Q6LifetimeResearch.compare (base 760) true cellL ++
    ((Q6StructuralCell.exposure cellL).reverse ++
      (BalancedCleanup.prepareCompare cellL.toLayout).reverse))

theorem recordHalf_shape : Q6LifetimeResearch.half (base 760) true base (base 2409) =
    [.X (base 2409)] ++ (GuardCompression.seed cellL ++ (recordGap1 ++
      (BalancedCleanup.prepareSign cellL.toLayout ++ (BiasedCircuit.flipBias cellL ++
        (BalancedCleanup.prepareCompare cellL.toLayout ++ (recordGap3 ++
          (Q6LifetimeResearch.unnormalize (base 760) false cellL ++
            ((BalancedCleanup.prepareSign cellL.toLayout).reverse ++
              ([.measureX cellL.one [] []] ++ [.X (base 2409)]))))))))) := by
  simp only [recordGap1, recordGap3, Q6LifetimeResearch.half, Q6LifetimeResearch.forward,
    ↓reduceIte, List.append_assoc, cellL]

/-- Five pieces of a program mention only wires of the program (variable programs). -/
theorem five_pieces_sub (x0 p1 g1 p2 g2 p3 g3 p4 g4 p5 x5 : Program) :
    wires (p1 ++ (p2 ++ (p3 ++ (p4 ++ p5)))) ⊆
      wires (x0 ++ (p1 ++ (g1 ++ (p2 ++ (g2 ++ (p3 ++ (g3 ++ (p4 ++ (g4 ++ (p5 ++ x5)))))))))) := by
  intro q hq
  simp only [wires_append, Finset.mem_union] at hq ⊢
  rcases hq with h | h | h | h | h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
      (Or.inl h)))))))))

theorem recordPieces_sub : wires recordPieces ⊆ wires (R2Life760.half760 true) := by
  rw [R2Life760.half760_true, recordHalf_shape]
  unfold recordPieces
  exact five_pieces_sub [.X (base 2409)] (GuardCompression.seed cellL) recordGap1
    (BalancedCleanup.prepareSign cellL.toLayout) (BiasedCircuit.flipBias cellL)
    (BalancedCleanup.prepareCompare cellL.toLayout) recordGap3
    (Q6LifetimeResearch.unnormalize (base 760) false cellL)
    (BalancedCleanup.prepareSign cellL.toLayout).reverse
    [.measureX cellL.one [] []] [.X (base 2409)]

/-- The record half mentions every wire of the cell footprint except the retired carry. -/
theorem footprint_touch : ∀ q ∈ footprintList, q ∈ wires (R2Life760.half760 true) :=
  fun q hq => recordPieces_sub (touches_of_mask footprintList recordPieces chk_footprint_mask q hq)

/-! ### The record multiplication half -/

/-- Five top-level pieces of the record multiplication half that mention the whole footprint. -/
def recordPiecesF : Program :=
  BalancedCleanup.prepareSign cellL.toLayout ++ (Q6LifetimeResearch.normalize (base 760) cellL ++
    (BalancedCleanup.prepareCompare cellL.toLayout ++
      ([.CX cellL.parity cellL.r0] ++ [.measureX (base 1027) [] []])))

set_option maxHeartbeats 0 in
theorem chk_footprint_maskF :
    footprintList.all (fun q => (progMask 0 recordPiecesF).testBit q) = true := by
  -- KX3 (replay budget): fused masks of the ripple down-pass and of `rotateLeft`
  simp only [recordPiecesF, Q6LifetimeResearch.normalize, Q6LifetimeResearch.move,
    BalancedCleanup.normalize, BalancedCleanup.prepareCompare,
    StairLoan.literalConstAdd_as_sweep, StairLoan.emitSweep, kx3_rename_append, kx3_pm_append,
    kx3_pm_downsR, kx3_pm_rotL]
  decide +kernel

def recordGapF3 : Program :=
  Q6StructuralCell.exposure cellL ++ (Q6LifetimeResearch.compare (base 760) false cellL ++
    ((Q6StructuralCell.exposure cellL).reverse ++
      ((BalancedCleanup.prepareCompare cellL.toLayout).reverse ++
        (BiasedInverse.unbiasView cellL ++ (Q6LifetimeResearch.unfoldStep (base 760) cellL ++
          rotateLeft (BalancedCircuit.rawTarget cellL))))))

def recordGapF4 : Program :=
  Q6LifetimeResearch.rawSubTail (base 760) cellL ++ [.X (base 2409)]

theorem recordHalfF_shape :
    Q6LifetimeResearch.half (base 760) false base (base 2409) ++ [.measureX (base 1027) [] []] =
    [.X (base 2409)] ++ (BalancedCleanup.prepareSign cellL.toLayout ++
      (Q6LifetimeResearch.normalize (base 760) cellL ++
        (BalancedCleanup.prepareCompare cellL.toLayout ++ (recordGapF3 ++
          ([.CX cellL.parity cellL.r0] ++ (recordGapF4 ++ [.measureX (base 1027) [] []])))))) := by
  simp only [recordGapF3, recordGapF4, Q6LifetimeResearch.half, Q6LifetimeResearch.inverse,
    Bool.false_eq_true, ↓reduceIte, List.append_assoc, cellL]

theorem five_pieces_subF (x0 p1 p2 p3 g3 p4 g4 p5 : Program) :
    wires (p1 ++ (p2 ++ (p3 ++ (p4 ++ p5)))) ⊆
      wires (x0 ++ (p1 ++ (p2 ++ (p3 ++ (g3 ++ (p4 ++ (g4 ++ p5))))))) := by
  intro q hq
  simp only [wires_append, Finset.mem_union] at hq ⊢
  rcases hq with h | h | h | h | h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))))

theorem recordPiecesF_sub : wires recordPiecesF ⊆ wires (R2Life760.half760 false) := by
  rw [R2Life760.half760_false, recordHalfF_shape]
  unfold recordPiecesF
  exact five_pieces_subF [.X (base 2409)] (BalancedCleanup.prepareSign cellL.toLayout)
    (Q6LifetimeResearch.normalize (base 760) cellL)
    (BalancedCleanup.prepareCompare cellL.toLayout) recordGapF3
    [.CX cellL.parity cellL.r0] recordGapF4 [.measureX (base 1027) [] []]

/-- The record multiplication half mentions every wire of the cell footprint except the
retired carry. -/
theorem footprint_touchF : ∀ q ∈ footprintList, q ∈ wires (R2Life760.half760 false) :=
  fun q hq =>
    recordPiecesF_sub (touches_of_mask footprintList recordPiecesF chk_footprint_maskF q hq)

end ECDSAAdd.Entrant.StairOddHead

end

section
set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
