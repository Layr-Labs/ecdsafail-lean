theorem run_three_records (A P B : Program) (s : State) (m : List Bool) :
    run (A++(P++B)) m s=
      run B ((m.drop (measurementCount A)).drop (measurementCount P))
        (run P (m.drop (measurementCount A)) (run A (m.take (measurementCount A)) s)) := by
  rw [run_append,run_append,run_take]

theorem first_trit_of_trace (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (x : Nat) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape base)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    (origin (base 0)).toNat+2*(origin (base 1028)).toNat<3 ∧
      (origin (base 0)=true ∨ origin (base 1028)=true) := by
  have legal := (ctx.legal 0 (by decide)) 0 (by decide)
  change (origin (base 0)).toNat+2*(origin (base 1028)).toNat<3 at legal
  have read : (skywalkTapeControls origin (skywalkSharedTape base)).getD 0 (false,false)=
      (origin (base 0),origin (base 1028)) := by
    simp [skywalkTapeControls,skywalkSharedTape]
  have head : (origin (base 0),origin (base 1028))=
      SkywalkTrace.code (SkywalkRails.encode false false (x:Int) (p:Int)) := by
    rw [←read,trace]
    rfl
  have nonzero:=FirstNonzero.initial_code_nonzero x p (by norm_num [p]) (by norm_num [p]) hx
  have equal:=congrArg (fun pair : Bool×Bool => pair.1 || pair.2) head
  exact ⟨legal,by simpa only [Bool.or_eq_true] using equal.trans nonzero⟩

private theorem old_firstBody_sel (divide : Bool) :
    SW.Sel (base 2400) 9 (FrontierSW1591.firstBodyS divide) (FrontierReplay1591.firstBody divide) := by
