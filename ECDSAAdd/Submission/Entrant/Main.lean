      have h' := of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp leaveAfter150_box2.1 g hg) w hw)
      unfold Shadow7.leaveBox2; rw [show 150 + 14 = 164 from rfl, hr14, hr0, ha0, hb0, hwp]
      rw [ha0, hb0, hbt] at h'
