/-! ## Helpers -/






/-! ## Exact counts (δT = 0, δM = 0 against the record terminal blocks) -/











/-- δT = δM = 0 for the multiplication terminal. -/
theorem reverseTerminalV3_counts_eq :
    toffoliCount reverseTerminalV3 =
