  if d then Rolling1588TickGap.forward true 45 380 ++ firstPackHead
  else Rolling1588TickGap.forward false 45 381

def bankMask425 (n : Nat) : List Wire :=
  ((List.finRange 22).take n).flatMap fun b => MixedGeo425.cells10 (MixedGeo425.endTick b - 10)

def bankHoles425 (n : Nat) : List Wire :=
  ((List.finRange 22).take n).flatMap fun b =>
    [base (1028 + (MixedGeo425.endTick b - 8)), base (1028 + (MixedGeo425.endTick b - 6)),
     base (1028 + (MixedGeo425.endTick b - 3)), base (1028 + (MixedGeo425.endTick b - 1))]

def groupProg425 (d : Bool) (gs : List Nat) : Program :=
  StockGroupsW.batch 45 d gs

private theorem groupProg425_append (d : Bool) (a b : List Nat) :
    groupProg425 d (a ++ b) = groupProg425 d a ++ groupProg425 d b :=
  OrdinaryChainG.batch_append 45 d a b

private theorem groupProg425_singleton (d : Bool) (i : Nat) :
    groupProg425 d [i] = Rolling1588.encodeAt base d (40 + 5 * i) := by
  simp only [groupProg425, StockGroupsW.batch, List.flatMap_cons, List.flatMap_nil, List.append_nil,
    StockGroupsW.one, StockWindowGeo.gstart]

private theorem bankMask425_succ (b : MixedGeo425.Bank) :
    bankMask425 (b.val + 1) = bankMask425 b.val ++ MixedGeo425.cells10 (MixedGeo425.endTick b - 10) := by
  have hb := b.isLt
  have ht : (List.finRange 22).take (b.val + 1) = (List.finRange 22).take b.val ++ [b] := by
    rw [List.take_add_one, List.getElem?_eq_getElem (by simp [hb]), Option.toList_some, List.getElem_finRange]
    simp only [Fin.cast_mk, Fin.eta, Fin.cast_eq_self]
  simp only [bankMask425, ht, List.flatMap_append, List.flatMap_cons, List.flatMap_nil, List.append_nil]

private theorem bankHoles425_succ (b : MixedGeo425.Bank) :
    bankHoles425 (b.val + 1) = bankHoles425 b.val ++
      [base (1028 + (MixedGeo425.endTick b - 8)), base (1028 + (MixedGeo425.endTick b - 6)),
       base (1028 + (MixedGeo425.endTick b - 3)), base (1028 + (MixedGeo425.endTick b - 1))] := by
  have hb := b.isLt
  have ht : (List.finRange 22).take (b.val + 1) = (List.finRange 22).take b.val ++ [b] := by
    rw [List.take_add_one, List.getElem?_eq_getElem (by simp [hb]), Option.toList_some, List.getElem_finRange]
    simp only [Fin.cast_mk, Fin.eta, Fin.cast_eq_self]
  simp only [bankHoles425, ht, List.flatMap_append, List.flatMap_cons, List.flatMap_nil, List.append_nil]

private theorem bankMask425_cells (n : Nat) (bound : Nat)
    (hb : ∀ b : MixedGeo425.Bank, b.val < n → MixedGeo425.endTick b ≤ bound) :
    ∀ q ∈ bankMask425 n, ∃ r, r < bound ∧ (q = base r ∨ q = base (1028 + r)) := by
  intro q hq; simp only [bankMask425, List.mem_flatMap] at hq
  obtain ⟨b, hbt, hcq⟩ := hq
  have hblt : b.val < n := by
    obtain ⟨i, hi, eq⟩ := List.mem_iff_getElem.mp hbt
    have hlen : ((List.finRange 22).take n).length = min n 22 := by simp
    have hin : i < n := by rw [hlen] at hi; omega
    rw [List.getElem_take, List.getElem_finRange] at eq; rw [← eq]; exact hin
  have hbe := hb b hblt
  simp only [MixedGeo425.cells10, List.mem_flatMap, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false] at hcq
  obtain ⟨r, ⟨r1, r2⟩, e⟩ := hcq
  have hge : 10 ≤ MixedGeo425.endTick b := by
    have : ∀ k : MixedGeo425.Bank, 60 ≤ MixedGeo425.endTick k := by decide +kernel
    have := this b; omega
  exact ⟨r, by omega, e⟩

private theorem bankHoles425_cells (n : Nat) (bound : Nat)
    (hb : ∀ b : MixedGeo425.Bank, b.val < n → MixedGeo425.endTick b ≤ bound) :
    ∀ q ∈ bankHoles425 n, ∃ r, 50 ≤ r ∧ r < bound ∧ q = base (1028 + r) := by
  intro q hq; simp only [bankHoles425, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hq
  obtain ⟨b, hbt, e⟩ := hq
  have hblt : b.val < n := by
    obtain ⟨i, hi, eq⟩ := List.mem_iff_getElem.mp hbt
    have hlen : ((List.finRange 22).take n).length = min n 22 := by simp
    have hin : i < n := by rw [hlen] at hi; omega
    rw [List.getElem_take, List.getElem_finRange] at eq; rw [← eq]; exact hin
  have hbe := hb b hblt
  have hge : 60 ≤ MixedGeo425.endTick b := by
    have : ∀ k : MixedGeo425.Bank, 60 ≤ MixedGeo425.endTick k := by decide +kernel
    exact this b
  rcases e with rfl | rfl | rfl | rfl
  · exact ⟨MixedGeo425.endTick b - 8, by omega, by omega, rfl⟩
  · exact ⟨MixedGeo425.endTick b - 6, by omega, by omega, rfl⟩
  · exact ⟨MixedGeo425.endTick b - 3, by omega, by omega, rfl⟩
  · exact ⟨MixedGeo425.endTick b - 1, by omega, by omega, rfl⟩

private theorem groupProg425_cells (d : Bool) (gs : List Nat) (bound : Nat)
    (hg : ∀ i ∈ gs, 40 + 5 * i + 5 ≤ bound) :
    ∀ q ∈ wires (groupProg425 d gs), ∃ r, r < bound ∧ (q = base r ∨ q = base (1028 + r)) := by
  induction gs with
  | nil => intro q h; simp [groupProg425, StockGroupsW.batch, wires] at h
  | cons i gs ih =>
    intro q h; change q ∈ wires (Rolling1588.encodeAt base d (40 + 5 * i) ++ groupProg425 d gs) at h
    rw [wires_append, Finset.mem_union] at h; rcases h with h | h
    · obtain ⟨r, r1, r2, e⟩ := OrdinaryChainW.encode_cells d (40 + 5 * i) q h
      have hi := hg i List.mem_cons_self; exact ⟨r, by omega, e⟩
    · exact ih (fun j hj => hg j (List.mem_cons_of_mem _ hj)) q h

private theorem extend_step425 (d : Bool) (t len : Nat) (h45 : 45 ≤ t) (hlim : t + len ≤ 512)
    (mask addedMask : List Wire) (oldGs newGs : List Nat) (raw initial out : State)
    (old : Except mask raw (run (groupProg425 d oldGs) [] (run (span 45 (t - 45)) [] initial)))
    (step : Except addedMask out (run (groupProg425 d newGs) [] (run (span t len) [] raw)))
    (hmask : ∀ q ∈ mask, ∃ r, r + 2 ≤ t ∧ (q = base r ∨ q = base (1028 + r)))
    (hprog : ∀ q ∈ wires (groupProg425 d oldGs), ∃ r, r + 2 ≤ t ∧ (q = base r ∨ q = base (1028 + r)))
    (havoid : ∀ q ∈ mask, q ∉ wires (groupProg425 d newGs)) :
    Except (mask ++ addedMask) out
      (run (groupProg425 d (oldGs ++ newGs)) [] (run (span 45 (t + len - 45)) [] initial)) := by
  have h := extend t len hlim mask addedMask (groupProg425 d oldGs) (groupProg425 d newGs)
