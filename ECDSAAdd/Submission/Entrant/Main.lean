-- ===== ECDSAAdd.Submission.Entrant.Square5Placement =====
section

/-! The square uses the same gates with a larger pool permutation. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Square5Placement
open Arithmetic MappedCompressed ControlledPointLayout Secp256k1

/-- Each factor is a global wire permutation, including outside the pool. -/
def blockPerm (L : ControlledPointLayout) : Nat → Equiv.Perm Wire
  | 0 => Equiv.refl _
  | n+1 => (blockPerm L n).trans
      (Equiv.swap (L.core.poolWire (515+n)) (L.core.poolWire (776+n)))

def blockIndex (n i : Nat) : Nat :=
  if 515 ≤ i ∧ i < 515+n then i+261
  else if 776 ≤ i ∧ i < 776+n then i-261 else i

theorem pool_member (L : ControlledPointLayout) (hw : L.Widths) (i : Nat) (hi : i < 2613) :
    L.core.poolWire i ∈ L.dialogPool := by
  apply List.mem_of_mem_take (i := 2613)
  rw [pool_block L hw 2613 (le_refl _)]
  exact List.mem_map.mpr ⟨i, by simp [List.mem_range'_1, hi], rfl⟩

theorem block_apply (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (n : Nat) (hn' : n ≤ 202) (i : Nat) (hi : i < 2613) :
    blockPerm L n (L.core.poolWire i) = L.core.poolWire (blockIndex n i) := by
  induction n generalizing i with
  | zero =>
    have h0 : ¬(515 ≤ i ∧ i < 515) := by omega
    have h1 : ¬(776 ≤ i ∧ i < 776) := by omega
    simp [blockPerm, blockIndex, h0, h1]
  | succ n ih =>
    rw [blockPerm, Equiv.trans_apply, ih (by omega) i hi]
    by_cases left : i = 515+n
    · subst i
      have old : blockIndex n (515+n) = 515+n := by unfold blockIndex; split_ifs <;> omega
      have new : blockIndex (n+1) (515+n) = 776+n := by unfold blockIndex; split_ifs <;> omega
      rw [old, Equiv.swap_apply_left, new]
    · by_cases right : i = 776+n
      · subst i
        have old : blockIndex n (776+n) = 776+n := by unfold blockIndex; split_ifs <;> omega
        have new : blockIndex (n+1) (776+n) = 515+n := by unfold blockIndex; split_ifs <;> omega
        rw [old, Equiv.swap_apply_right, new]
      · have bound : blockIndex n i < 2613 := by unfold blockIndex; split_ifs <;> omega
        have ne0 : L.core.poolWire (blockIndex n i) ≠ L.core.poolWire (515+n) := by
          intro eq
          have same := pool_inj L hw hn _ _ bound (by omega) eq
          unfold blockIndex at same
          split_ifs at same <;> omega
        have ne1 : L.core.poolWire (blockIndex n i) ≠ L.core.poolWire (776+n) := by
          intro eq
          have same := pool_inj L hw hn _ _ bound (by omega) eq
          unfold blockIndex at same
          split_ifs at same <;> omega
        have same : blockIndex n i = blockIndex (n+1) i := by
          unfold blockIndex
          split_ifs <;> omega
        rw [Equiv.swap_apply_of_ne_of_ne ne0 ne1, same]

theorem block_pool (L : ControlledPointLayout) (hw : L.Widths) (n : Nat) (hn : n ≤ 202)
    (q : Wire) (hq : q ∈ L.dialogPool) : blockPerm L n q ∈ L.dialogPool := by
  induction n with
  | zero => exact hq
  | succ n ih =>
    have a := pool_member L hw (515+n) (by omega)
    have b := pool_member L hw (776+n) (by omega)
    change Equiv.swap _ _ (blockPerm L n q) ∈ L.dialogPool
    by_cases ha : blockPerm L n q = L.core.poolWire (515+n)
    · rw [ha, Equiv.swap_apply_left]; exact b
    · by_cases hb : blockPerm L n q = L.core.poolWire (776+n)
      · rw [hb, Equiv.swap_apply_right]; exact a
      · rw [Equiv.swap_apply_of_ne_of_ne ha hb]; exact ih (by omega)

theorem block_outside (L : ControlledPointLayout) (hw : L.Widths) (n : Nat) (hn : n ≤ 202)
    (q : Wire) (hq : q ∉ L.dialogPool) : blockPerm L n q = q := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have a : q ≠ L.core.poolWire (515+n) := fun eq => hq (eq ▸ pool_member L hw _ (by omega))
    have b : q ≠ L.core.poolWire (776+n) := fun eq => hq (eq ▸ pool_member L hw _ (by omega))
    change Equiv.swap _ _ (blockPerm L n q) = q
    rw [ih (by omega), Equiv.swap_apply_of_ne_of_ne a b]

/-- A clean pool makes any pool-only relabelling the identity on a State. -/
theorem pull_clean (L : ControlledPointLayout) (e : Equiv.Perm Wire)
    (hp : ∀ q ∈ L.dialogPool, e q ∈ L.dialogPool)
    (hf : ∀ q, q ∉ L.dialogPool → e q = q)
    (s : State) (clean : regValue L.dialogPool s.basis = 0) : pullState e s = s := by
  apply State.extensionality
  · rfl
  · funext q
    by_cases hq : q ∈ L.dialogPool
    · exact ((regValue_zero _ _).mp clean _ (hp q hq)).trans ((regValue_zero _ _).mp clean q hq).symm
    · change s.basis (e q) = s.basis q
      rw [hf q hq]

/-- Closed clean-pool programs keep their complete output State under relabelling. -/
theorem pool_relabel_state_eq (L : ControlledPointLayout) (e : Equiv.Perm Wire)
    (hp : ∀ q ∈ L.dialogPool, e q ∈ L.dialogPool)
    (hf : ∀ q, q ∉ L.dialogPool → e q = q)
    (P : Program) (s : State) (m : List Bool)
    (hin : regValue L.dialogPool s.basis = 0)
    (hout : regValue L.dialogPool (run P m s).basis = 0) :
    run (renameProgram e P) m s = run P m s := by
  apply pullState_perm_injective e
  rw [run_rename e e.injective, pull_clean L e hp hf s hin,
    pull_clean L e hp hf (run P m s) hout]

def square5 (L : ControlledPointLayout) : Program :=
  renameProgram (blockPerm L 202) (fastCandidate L)

private theorem resident_away (L : ControlledPointLayout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q ∈ CompressedPointSquare.residents L) : q ∉ L.dialogPool := by
  exact List.disjoint_left.mp (List.nodup_append'.mp (L.dialogUsed_nodup hn)).2.2 hq

theorem square5_state_eq (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (X Y : Nat) (B : Bool) (hX : X < p) (s : State) (m : List Bool)
    (hb : s.basis L.core.generic = B) (hx : regValue L.point.x s.basis = X)
    (hy : regValue L.point.y s.basis = Y) (hc : regValue L.dialogPool s.basis = 0) :
    run (square5 L) m s = run (fastCandidate L) m s := by
  have old := fastCandidate_correct L hw hn X Y B hX s m hb hx hy hc
  have out : regValue L.dialogPool (run (fastCandidate L) m s).basis = 0 := by
    apply (regValue_zero _ _).mpr
    intro q hq
    have away : q ∉ L.point.x := by
      intro hx
      exact resident_away L hn q (by simp [CompressedPointSquare.residents, PointAddLayout.pointWires, hx]) hq
    exact (old.2.2 q away).trans ((regValue_zero _ _).mp hc q hq)
  exact pool_relabel_state_eq L (blockPerm L 202)
    (block_pool L hw 202 (le_refl _)) (block_outside L hw 202 (le_refl _)) _ s m hc out











theorem square5_counts (L : ControlledPointLayout) (hw : L.Widths) :
    toffoliCount (square5 L) = 57590 ∧ measurementCount (square5 L) = 57598 := by
  have r := renameProgram_counts (blockPerm L 202) (fastCandidate L)
  have c := fastCandidate_counts L hw
  exact ⟨r.1.trans c.1, r.2.trans c.2⟩































theorem square5_physical (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    GatePhysical (square5 L) :=
  gatePhysical_rename (blockPerm L 202) (blockPerm L 202).injective _ (fastCandidate_physical L hw hn)

theorem square5_gateSlots_le (L : ControlledPointLayout) (hw : L.Widths) :
    Challenge.gateSlots (square5 L) ≤ 5000000 := by
  simpa only [square5, Baselines.rename_gateSlots, fastCandidate] using
    accPrefixK_gateSlots_le L.dialogStreamedSquareWide (L.dialogStreamedSquareWide_widths hw) (kext L)
      L.core.generic (by simp [kext,wireBlock_length])

end ECDSAAdd.Entrant.Square5Placement

end


-- ===== ECDSAAdd.Submission.Entrant.SquareOB5 =====
section

/-! The current square already avoids the retired physical sign region. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.SquareOB5
open Arithmetic MappedCompressed ControlledPointLayout Secp256k1

def program (L : ControlledPointLayout) : Program := Square5Placement.square5 L

private theorem resident_away (L : ControlledPointLayout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q ∈ CompressedPointSquare.residents L) : q ∉ L.dialogPool := by
  exact List.disjoint_left.mp (List.nodup_append'.mp (L.dialogUsed_nodup hn)).2.2 hq










theorem counts (L : ControlledPointLayout) (hw : L.Widths) :
    toffoliCount (program L)=57590 ∧ measurementCount (program L)=57598 :=
  Square5Placement.square5_counts L hw

theorem support (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) :
    wires (program L) ⊆ (OB5Support.sites L).toFinset := by
  rw [program,Square5Placement.square5,renameProgram_support]
  intro q hq
  obtain ⟨old, used, rfl⟩ := Finset.mem_image.mp hq
  have support := fastCandidate_support L hw hn used
  simp only [List.mem_toFinset, List.mem_cons, List.mem_append, or_assoc] at support
  apply List.mem_toFinset.mpr
  rcases support with h | h | h | h | h
  · subst old
    rw [Square5Placement.block_outside L hw 202 (le_refl _) _
      (resident_away L hn _ (by simp [CompressedPointSquare.residents, inPlaceFlags]))]
    simp [OB5Support.sites]
  · have away := resident_away L hn old (by simp [CompressedPointSquare.residents, PointAddLayout.pointWires, h])
    rw [Square5Placement.block_outside L hw 202 (le_refl _) _ away]
    simp only [OB5Support.sites, List.mem_cons, List.mem_append]
    exact Or.inl (Or.inr h)
  · have away := resident_away L hn old (by simp [CompressedPointSquare.residents, PointAddLayout.pointWires, h])
    rw [Square5Placement.block_outside L hw 202 (le_refl _) _ away]
    simp only [OB5Support.sites, List.mem_cons, List.mem_append]
    exact Or.inl (Or.inl (Or.inr h))
  · rw [pool_block L hw 776 (by omega)] at h
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp h
    have bound : i < 776 := by simp only [List.mem_range'_1] at hi; omega
    rw [Square5Placement.block_apply L hw hn 202 (le_refl _) i (by omega)]
    apply OB5Support.pool_in_sites
    apply OB5Support.pool_mem
    unfold Square5Placement.blockIndex
    split_ifs <;> omega
  · obtain ⟨i, h1, h2, h3, rfl⟩ := kext_index L _ h
    rw [Square5Placement.block_apply L hw hn 202 (le_refl _) i (by omega)]
    apply OB5Support.pool_in_sites
    apply OB5Support.pool_mem
    unfold Square5Placement.blockIndex
    split_ifs <;> omega

theorem physical (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) : GatePhysical (program L) :=
  Square5Placement.square5_physical L hw hn

theorem gateSlots_le (L : ControlledPointLayout) (hw : L.Widths) : Challenge.gateSlots (program L) ≤ 5000000 :=
  Square5Placement.square5_gateSlots_le L hw

end ECDSAAdd.Entrant.SquareOB5

