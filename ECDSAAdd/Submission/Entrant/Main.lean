private theorem wordGM_swap2 (u : State)
    (v : CRTBarrel.LeaveSplice.Valid u (wordGM 1614 (Shadow7.columnsP 150))) :
    CRTBarrel.LeaveSplice.Valid u (wordGM 1614 columnsP150) ∧
