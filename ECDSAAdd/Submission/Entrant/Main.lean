def pack425 : Program :=
  renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)

def unpack425 : Program :=
  renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425)

def firstPackHead : Program := EndOrient425.physP ++ pack425
def firstUnpackTail : Program := unpack425 ++ EndOrient425.physP

def ordinary425 (d : Bool) : Program :=
  StockGroupsW.batch 45 d MixedGeo425.plain

def common425Base (d : Bool) (raw : State) : State :=
  pullState (OB5.sig 425)
    (eraseSites MixedGeo425.holes (run (ordinary425 d) [] (run (span 45 (if d then 380 else 381)) [] raw)))

def common425 (d : Bool) (raw : State) : State :=
  if d then run EndOrient425.physP [] (common425Base true raw) else common425Base false raw

