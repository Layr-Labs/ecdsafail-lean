    JointOdd1588.OddHalfLaw (StairPacket.WindowCallerCosts.oddFirstHalf divide) divide :=
  fun origin clean X Y =>
    P1Life.half_frame (base 760) divide base (base 2409) hn760 mem760 origin clean X Y

