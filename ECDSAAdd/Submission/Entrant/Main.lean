    · exact ⟨fun e => h.1 (e ▸ hq), fun e => h.2.2.2.2.2.2.1 (e ▸ hq)⟩
    · exact ⟨fun e => h.2.1 (e ▸ hq), fun e => h.2.2.2.2.2.2.2.1 (e ▸ hq)⟩
    · exact ⟨h.2.2.1.symm, h.2.2.2.2.2.2.2.2.1.symm⟩
