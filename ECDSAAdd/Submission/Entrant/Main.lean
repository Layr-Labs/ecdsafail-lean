  intro q hq
  obtain ⟨old,used,rfl⟩ := Finset.mem_image.mp hq
  have h := finite_inner_support L hw hn C cy Gen hG used
  rw [U_sites L hw hn old (List.mem_toFinset.mp h)]
  exact h

