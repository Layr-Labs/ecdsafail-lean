namespace ECDSAAdd.Entrant.StairPacket.WindowWalkCosts
open Arithmetic MappedCompressed Stair44Resources Partial PartialCosts
set_option maxHeartbeats 1250000
set_option maxRecDepth 16000

/-- The replacement occupies [45,406); the initial fifteen ticks use a distinct placement. -/
def forward (d : Bool) (tail : Nat) : Program :=
  renameProgram Stair44WalkMap.first (Rolling1588TickGap.forward d 1 15) ++
  renameProgram Stair44WalkMap.rest (Rolling1588TickGap.forward d 16 29 ++
    CRTWindow.forward45plus1 d ++ Rolling1588TickGap.forward d 421 tail)

def backward (d : Bool) (tail : Nat) : Program :=
  renameProgram Stair44WalkMap.rest (Rolling1588.reverse d 421 tail ++
    CRTWindow.reverse45plus1 d ++ Rolling1588.reverse d 16 29) ++
  renameProgram Stair44WalkMap.first (Rolling1588.reverse d 1 15)

private theorem walk (c : Cost) (d : Bool) (tail f r : Nat)
    (hf : c.measure (CRTWindow.forward45plus1 d)+f=c.measure (Rolling1588TickGap.forward d 45 376))
    (hr : c.measure (CRTWindow.reverse45plus1 d)+r=c.measure (Rolling1588.reverse d 45 376)) :
    c.measure (forward d tail)+f=c.measure (Stair44WalkRun.forward d (405+tail)) ∧
    c.measure (backward d tail)+r=c.measure (Stair44WalkRun.backward d (405+tail)) := by
  have a := StairRestSupport.forward_append d 29 16 (376+tail)
  have b := StairRestSupport.forward_append d 376 45 tail
  have x := StairRestSupport.reverse_append d 29 16 (376+tail)
  have y := StairRestSupport.reverse_append d 376 45 tail
  change Rolling1588TickGap.forward d 16 (29+(376+tail)) =
    Rolling1588TickGap.forward d 16 29 ++ Rolling1588TickGap.forward d 45 (376+tail) at a
  change Rolling1588.reverse d 16 (29+(376+tail)) =
    Rolling1588.reverse d 45 (376+tail) ++ Rolling1588.reverse d 16 29 at x
  rw [b] at a
  rw [y] at x
  have num : 405+tail=29+(376+tail) := by omega
  simp only [Stair44WalkRun.forward, Stair44WalkRun.backward,forward,backward,num,a,x,
    c.append,c.rename]
  norm_num only []
  constructor <;> omega

attribute [local irreducible] CRTWindow.forward45plus1 CRTWindow.reverse45plus1 Rolling1588TickGap.forward Rolling1588.reverse
  Stair44WalkRun.forward Stair44WalkRun.backward toffoliCount measurementCount forward backward

private theorem subEq {x y a b : Nat} (n : Nat) (hx : x=a) (hy : y=b) (h : a+n=b) : x+n=y := by omega

theorem exactWalks (d : Bool) (tail : Nat) :
    toffoliCount (forward d tail)+(if d then 37914 else 37914)=
      toffoliCount (Stair44WalkRun.forward d (405+tail)) ∧
    toffoliCount (backward d tail)+(if d then 37520 else 37520)=
      toffoliCount (Stair44WalkRun.backward d (405+tail)) ∧
    measurementCount (forward d tail)+14715=measurementCount (Stair44WalkRun.forward d (405+tail)) ∧
    measurementCount (backward d tail)+15239=measurementCount (Stair44WalkRun.backward d (405+tail)) := by
  cases d
  · have sf := StockWindowCosts420.stock420from45 false
    have a : toffoliCount (CRTWindow.forward45plus1 false) = 128186 := by rw [CRTWindow.assembly]; exact CRTWindow.ship_toffoliF_false
    have b : toffoliCount (CRTWindow.reverse45plus1 false) = 128553 := by rw [CRTWindow.unwind_assembly]; exact CRTWindow.ship_toffoliR_false
    have c : measurementCount (CRTWindow.forward45plus1 false) = 68496 := by rw [CRTWindow.assembly]; exact CRTWindow.ship_measureF.2
    have e : measurementCount (CRTWindow.reverse45plus1 false) = 67653 := by rw [CRTWindow.unwind_assembly]; exact CRTWindow.ship_measureR.2
    have t := walk tc false tail 37914 37520
      (subEq 37914 a sf.1 (by omega)) (subEq 37520 b sf.2.2.1 (by omega))
    have m := walk mc false tail 14715 15239
      (subEq 14715 c sf.2.1 (by omega)) (subEq 15239 e sf.2.2.2 (by omega))
    exact ⟨t.1,t.2,m⟩
  · have sf := StockWindowCosts420.stock420from45 true
    have a : toffoliCount (CRTWindow.forward45plus1 true) = 128186 := by rw [CRTWindow.assembly]; exact CRTWindow.ship_toffoliF_true
    have b : toffoliCount (CRTWindow.reverse45plus1 true) = 128553 := by rw [CRTWindow.unwind_assembly]; exact CRTWindow.ship_toffoliR_true
    have c : measurementCount (CRTWindow.forward45plus1 true) = 68496 := by rw [CRTWindow.assembly]; exact CRTWindow.ship_measureF.1
    have e : measurementCount (CRTWindow.reverse45plus1 true) = 67653 := by rw [CRTWindow.unwind_assembly]; exact CRTWindow.ship_measureR.1
    have t := walk tc true tail 37914 37520
      (subEq 37914 a sf.1 (by omega)) (subEq 37520 b sf.2.2.1 (by omega))
    have m := walk mc true tail 14715 15239
      (subEq 14715 c sf.2.1 (by omega)) (subEq 15239 e sf.2.2.2 (by omega))
    exact ⟨t.1,t.2,m⟩


/-- Rewrite small arithmetic arguments before instantiating either physical walk. -/
theorem inst (d : Bool) (tail n f r : Nat) (hn : 405+tail=n)
    (hf : (if d then 37914 else 37914)=f) (hr : (if d then 37520 else 37520)=r) :
    tc.measure (forward d tail)+f=tc.measure (Stair44WalkRun.forward d n) ∧
    tc.measure (backward d tail)+r=tc.measure (Stair44WalkRun.backward d n) ∧
    mc.measure (forward d tail)+14715=mc.measure (Stair44WalkRun.forward d n) ∧
    mc.measure (backward d tail)+15239=mc.measure (Stair44WalkRun.backward d n) := by
  subst n; subst f; subst r
  exact exactWalks d tail
end ECDSAAdd.Entrant.StairPacket.WindowWalkCosts

