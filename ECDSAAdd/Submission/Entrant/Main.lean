theorem sel15E_cleanCert (j : Fin 4) (k : Mode) :
    targetCert (ports15E j) (prepare15E j) (retire15E j) false k = true := by
  have hg := geom15E_facts j; dsimp only at hg
  have hσ := ren15E_inj j
  have hrc : ∀ r : Fin 4, ren15E r (LeaveJ7.ports 12).crossing = (ports15E r).crossing ∧
      ren15E r (LeaveJ7.ports 12).near = (ports15E r).near := by decide +kernel
  have hcn (q : Nat) (hq : LeaveJ7.SelRen.D q) :
      (ren15E j q = (ports15E j).crossing ∨ ren15E j q = (ports15E j).near) ↔
        (q = (LeaveJ7.ports 12).crossing ∨ q = (LeaveJ7.ports 12).near) := by
    have rc := (hrc j).1
    have rn := (hrc j).2
    rw [← rc, ← rn]
    exact ⟨fun h => h.elim (fun e => Or.inl (hσ _ _ hq (by decide) e)) (fun e => Or.inr (hσ _ _ hq (by decide) e)),
      fun h => h.elim (fun e => Or.inl (congrArg _ e)) (fun e => Or.inr (congrArg _ e))⟩
  have hpost : LeaveJ7.SelRen.Rel LeaveJ7.SelRen.D (ren15E j)
      (post (ports15E j) (prepare15E j) false k) (post (LeaveJ7.ports 12) (LeaveJ7.prepare 12) false k) := by
