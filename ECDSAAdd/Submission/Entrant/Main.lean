  change run [.CCX j p u] m.tail.tail.tail.tail
    (run [.measureX u [] [.CZ j b]] m.tail.tail.tail s₃)=_
  rw [fourth]
  change run [.CCX j p u] m.tail.tail.tail.tail s₄=_
