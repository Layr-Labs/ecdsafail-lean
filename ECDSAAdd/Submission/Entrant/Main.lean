/-!
# Field 12: the still-open pieces (LT6 integrator)

`StairSiteAvoidance.OpenPiecesRest holes` (LT1) lists one `PieceOK holes f P`
fact per program piece.  `PiecesOpen holes` is that list minus the pieces that
are closed by a peer theorem, and `piecesRest_of` fills the closed ones:

* `firstPacketEntry` / `firstPacketExit` — LT20's
  `StairFirstPacketHosted.hostedFirstPacket_pieceOK` (the two first packets hosted
  on `hosts 87`; every hole list inside the 44 physical holes);
* `canon`, `center`, `endpointDiv`, `endpointMult`, `entryTicks`, `exitTicks`,
  `entryLast`, `exitTail`, `entryFirstPack`, `exitFirstUnpack`, `eraseB`, `loadB`,
  `x1N`, `groups`, `groupsExit` — LT35's `StairSiteEasy.*39` facts for `holes39`, transported to every
  sub-list of `holes39` (`PieceOK` is antitone in the hole list);
* `square` — LT40's `StairSquareFinal.squareEntryHL_pieceOK` (the hole-free square, LT36–LT40).

ALL pieces are now closed (stage/encode/decode/borrowOut/entryY/entryX/exitY: LT35's
`StairSiteEasyFrame*`), so `piecesRest_of` has no open-piece argument any more.
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairSiteOpenPieces

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance


/-- LT1's `OpenPiecesRest` from the still-open pieces and the peer theorems
(for any hole list inside the 44 physical holes and inside `holes39`). -/
theorem piecesRest_of {holes : List Wire}
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    (h39 : ∀ q ∈ holes, q ∈ StairCertificate.holes39)
    : OpenPiecesRest holes where
  stage := fun C => pieceOK_mono h39 (StairSiteEasy.stage39 C)
  encode := fun C => pieceOK_mono h39 (StairSiteEasy.encode39 C)
  eraseB := pieceOK_mono h39 StairSiteEasy.eraseB39
  loadB := pieceOK_mono h39 StairSiteEasy.loadB39
  decode := fun C => pieceOK_mono h39 (StairSiteEasy.decode39 C)
  borrowOut := fun C => pieceOK_mono h39 (StairSiteEasy.borrowOut39 C)
  entryY := fun c => pieceOK_mono h39 (StairSiteEasy.entryY39 c)
  entryX := fun c => pieceOK_mono h39 (StairSiteEasy.entryX39 c)
  square := StairSquareFinal.squareEntryHL_pieceOK holes h39
  exitY := fun c => pieceOK_mono h39 (StairSiteEasy.exitY39 c)
  entryTicks := pieceOK_mono h39 StairSiteEasy.entryTicks39
  entryFirstPack := pieceOK_mono h39 StairSiteEasy.entryFirstPack39
  exitFirstUnpack := pieceOK_mono h39 StairSiteEasy.exitFirstUnpack39
  entryLast := pieceOK_mono h39 StairSiteEasy.entryLast39
  exitTail := pieceOK_mono h39 StairSiteEasy.exitTail39
  exitTicks := pieceOK_mono h39 StairSiteEasy.exitTicks39
  x1N := fun k => pieceOK_mono h39 (StairSiteEasy.x1N39 k)
  firstPacketEntry := StairFirstPacketHosted.hostedFirstPacket_pieceOK holes hsub true
  firstPacketExit := StairFirstPacketHosted.hostedFirstPacket_pieceOK holes hsub false
  groups := fun g hg => pieceOK_mono h39 (StairSiteEasy.groups39 g hg)
  groupsExit := fun g hg => pieceOK_mono h39 (StairSiteEasy.groupsExit39 g hg)
  endpointDiv := pieceOK_mono h39 StairSiteEasy.endpointDiv39
  endpointMult := pieceOK_mono h39 StairSiteEasy.endpointMult39
