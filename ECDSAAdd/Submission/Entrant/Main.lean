/-!
# The two hosted kernel rests of CANON v3, generic in primitives and hosts

`entryRestOf p h` / `exitRestOf p h` are the bodies of
`StairConcreteAssembly.hostedEntryRest` / `hostedExitRest` (CANON 1719, v3.1:
the terminal clear lives in the terminal blocks) with the primitive
provider `p` and the host plan `h` as parameters.  Given `WalkFacts p c`,
`GroupFacts h c` and `BoundaryFacts h b`, their slot counts exceed the record
rests by at most `v3Plan.entryDelta c b` / `v3Plan.exitDelta c b`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSlotsPlan

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed DirectSkywalk Secp256k1 BalancedField Baselines

attribute [local irreducible] gateSlots

/-! ## Slot facts of groups and boundary programs -/



/-! ## The rests with parameters -/

def entryRestOf (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (L : ControlledPointLayout) : Program :=
  renameProgram (wireFn2 L)
    (renameProgram Rolling1588Lifetime.phaseHost
        (StairSchedule.stackForward6 p) ++
      StairHostsSchedule.entryFieldHosted p h ++
      renameProgram Rolling1588Lifetime.phaseHost
        (InverseFive23.lastPhase15 false))

def exitRestOf (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (L : ControlledPointLayout) (k : Nat) : Program :=
  renameProgram (wireFn2 L)
    (renameProgram Rolling1588Lifetime.phaseHost
        (Rolling1588TickGap.tailPhase false) ++
      StairHostsSchedule.exitFieldHosted p h ++
      renameProgram Rolling1588Lifetime.phaseHost
        (StairHostsSchedule.lastXN p h k))

/-! ## Shapes (each one rewrite, then the append/rename laws) -/

theorem restEntry_slots (L : ControlledPointLayout) :
    gateSlots (ParityStageBothInverse23.restEntry L) =
      gateSlots (Six505.stackForward6 true) + gateSlots (skywalkArithmeticClear base) +
        gateSlots Rolling1588.entryFieldHosted +
        gateSlots (InverseFive23.lastPhase15 false) := by
  rw [ParityStageBothInverse23.restEntry, Rolling1588TickGap.tailPhase,
    Rolling1588TickGap.stackForward]
  simp only [gateSlots_append, rename_gateSlots]
  omega

theorem restXXN_slots (L : ControlledPointLayout) (k : Nat) :
    gateSlots (ParityXExitInverse23Kernel.restXXN L k) =
      gateSlots (Rolling1588TickGap.tailPhase false) +
        gateSlots Rolling1588.exitFieldHosted +
        gateSlots (skywalkArithmeticClear base) +
        gateSlots (InverseFive23.stackReverse15 true) +
        gateSlots (ParityXExitInverse23Kernel.x1N k) := by
  rw [ParityXExitInverse23Kernel.restXXN, ParityXExitInverse23Kernel.lastXN]
  simp only [gateSlots_append, rename_gateSlots]
  omega

theorem entryRestOf_slots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (L : ControlledPointLayout) :
    gateSlots (entryRestOf p h L) =
      gateSlots (StairSchedule.stackForward6 p) +
        gateSlots (StairHostsSchedule.entryFieldHosted p h) +
        gateSlots (InverseFive23.lastPhase15 false) := by
  rw [entryRestOf]
  simp only [gateSlots_append, rename_gateSlots]

theorem exitRestOf_slots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (L : ControlledPointLayout) (k : Nat) :
    gateSlots (exitRestOf p h L k) =
      gateSlots (Rolling1588TickGap.tailPhase false) +
        gateSlots (StairHostsSchedule.exitFieldHosted p h) +
        gateSlots (StairSchedule.stackReverse15 p) +
        gateSlots (ParityXExitInverse23Kernel.x1N k) := by
  rw [exitRestOf, StairHostsSchedule.lastXN]
  simp only [gateSlots_append, rename_gateSlots]
  omega



theorem entryFieldHosted_slots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) :
    gateSlots (StairHostsSchedule.entryFieldHosted p h) =
      gateSlots (Rolling1588.placedFirstPacket true) +
        gateSlots FourScratchWindow.clearProgram +
        gateSlots (StairHostsSchedule.entryTailPrefix p h) +
        gateSlots FourScratchWindow.unprefix +
        gateSlots StairSchedule.paritySetup + gateSlots StairSchedule.hostedX +
        gateSlots FourScratchWindow.clearProgram +
        gateSlots (StairHostsSchedule.entryTailSuffix h) +
        gateSlots FourScratchWindow.unprefix +
        gateSlots StairSchedule.hostedX + gateSlots StairSchedule.paritySetup := by
  rw [StairHostsSchedule.entryFieldHosted, StairHostsSchedule.entryLowPrefix,
    StairHostsSchedule.entryLowSuffix]
  simp only [StairSchedule.fieldRename, StairSchedule.parityRename, gateSlots_append,
    StairSlotsLib.rebindMany_slots, rename_gateSlots]
  omega

theorem exitFieldHosted_slots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) :
    gateSlots (StairHostsSchedule.exitFieldHosted p h) =
      gateSlots StairSchedule.paritySetup + gateSlots StairSchedule.hostedX +
        gateSlots FourScratchWindow.clearProgram +
        gateSlots (StairHostsSchedule.exitHeadPrefix h) +
        gateSlots FourScratchWindow.unprefix +
        gateSlots StairSchedule.paritySetup + gateSlots StairSchedule.hostedX +
        gateSlots FourScratchWindow.clearProgram +
        gateSlots (StairHostsSchedule.exitHeadSuffix p h) +
        gateSlots FourScratchWindow.unprefix +
        gateSlots (Rolling1588.placedFirstPacket false) := by
  rw [StairHostsSchedule.exitFieldHosted, StairHostsSchedule.exitLowPrefix,
    StairHostsSchedule.exitLowSuffix]
  simp only [StairSchedule.fieldRename, StairSchedule.parityRename, gateSlots_append,
    StairSlotsLib.rebindMany_slots, rename_gateSlots]
  omega

theorem entryTailPrefix_slots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) :
    gateSlots (StairHostsSchedule.entryTailPrefix p h) =
      gateSlots (StairHostsSchedule.hostedGroup h true 0 1 84) +
        gateSlots (StairSchedule.forwardSegment p 87 62 425 450) +
        gateSlots (StairHostsSchedule.hostedGroup h true 14 85 5) +
        gateSlots (StairSchedule.forwardSegment p 62 47 450 465) +
        gateSlots (StairHostsSchedule.hostedGroup h true 23 90 3) +
        gateSlots (StairSchedule.forwardSegment p 47 32 465 480) +
        gateSlots (StairHostsSchedule.hostedGroup h true 31 93 3) +
        gateSlots (StairSchedule.forwardSegment p 32 22 480 490) +
        gateSlots (StairHostsSchedule.hostedGroup h true 37 96 2) +
        gateSlots (StairSchedule.forwardSegment p 22 12 490 500) +
        gateSlots (StairHostsSchedule.hostedGroup h true 42 98 2) +
        gateSlots (StairSchedule.forwardLast p) := by
  rw [StairHostsSchedule.entryTailPrefix]
  simp only [gateSlots_append]



theorem exitHeadSuffix_slots (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) :
    gateSlots (StairHostsSchedule.exitHeadSuffix p h) =
      gateSlots (StairSchedule.reverseLast p) +
        gateSlots (StairHostsSchedule.hostedGroup h false 42 98 2) +
        gateSlots (StairSchedule.reverseSegment p 22 12 490 500) +
        gateSlots (StairHostsSchedule.hostedGroup h false 37 96 2) +
        gateSlots (StairSchedule.reverseSegment p 32 22 480 490) +
        gateSlots (StairHostsSchedule.hostedGroup h false 31 93 3) +
        gateSlots (StairSchedule.reverseSegment p 47 32 465 480) +
        gateSlots (StairHostsSchedule.hostedGroup h false 23 90 3) +
        gateSlots (StairSchedule.reverseSegment p 62 47 450 465) +
        gateSlots (StairHostsSchedule.hostedGroup h false 14 85 5) +
        gateSlots (StairSchedule.reverseSegment p 87 62 425 450) +
        gateSlots (StairHostsSchedule.hostedGroup h false 0 1 84) := by
  rw [StairHostsSchedule.exitHeadSuffix]
  simp only [gateSlots_append]

/-! ## The two rest bounds -/


theorem entryRestOf_slots_le (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (c : Costs) (b : Boundary)
    (hw : WalkFacts p c) (hg : GroupFacts h c) (hb : BoundaryFacts h b)
    (L : ControlledPointLayout) :
    gateSlots (entryRestOf p h L) ≤
      gateSlots (ParityStageBothInverse23.restEntry L) + v3Plan.entryDelta c b := by
  have e1 := entryRestOf_slots p h L
  have e2 := restEntry_slots L
  have e3 := entryFieldHosted_slots p h
  have e4 := entryFieldRecord_slots
  have e5 := entryTailPrefix_slots p h
  have e6 := entryTailSuffix_slots h
  have w := forwardWalk_slots p c hw
  have rg := recordGroups_v3 true
  have g1 := hg.group true 0 1 84 (by decide)
  have g2 := hg.group true 14 85 5 (by decide)
  have g3 := hg.group true 23 90 3 (by decide)
  have g4 := hg.group true 31 93 3 (by decide)
  have g5 := hg.group true 37 96 2 (by decide)
  have g6 := hg.group true 42 98 2 (by decide)
  have g7 := hg.group true 44 100 2 (by decide)
  have d1 := hb.divEnd
  have d2 := hb.canon
  have ws := window_slots
  have de : v3Plan.entryDelta c b = v3Plan.checkpointSlots c + c.firstMove +
      c.forwardTerminal + c.groupRole * 478 + b.divEnd + b.canon + v3Plan.window := by
    rw [Plan.entryDelta, v3Plan_loanUnits]
  have vw : v3Plan.window = 767 := rfl
  rw [de]
  omega

theorem exitRestOf_slots_le (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (c : Costs) (b : Boundary)
    (hw : WalkFacts p c) (hg : GroupFacts h c) (hb : BoundaryFacts h b)
    (L : ControlledPointLayout) (k : Nat) :
    gateSlots (exitRestOf p h L k) ≤
      gateSlots (ParityXExitInverse23Kernel.restXXN L k) + v3Plan.exitDelta c b := by
  have e1 := exitRestOf_slots p h L k
  have e2 := restXXN_slots L k
  have e3 := exitFieldHosted_slots p h
  have e4 := exitFieldRecord_slots
  have e5 := exitHeadPrefix_slots h
  have e6 := exitHeadSuffix_slots p h
  have w := reverseWalk_slots p c hw
  have rg := recordGroups_v3 false
  have g1 := hg.group false 0 1 84 (by decide)
  have g2 := hg.group false 14 85 5 (by decide)
  have g3 := hg.group false 23 90 3 (by decide)
  have g4 := hg.group false 31 93 3 (by decide)
  have g5 := hg.group false 37 96 2 (by decide)
  have g6 := hg.group false 42 98 2 (by decide)
  have g7 := hg.group false 44 100 2 (by decide)
  have d1 := hb.multEnd
  have d2 := hb.center
  have ws := window_slots
  have de : v3Plan.exitDelta c b = v3Plan.checkpointSlots c + c.firstReturn +
      c.reverseTerminal + c.groupRole * 478 + b.multEnd + b.center + v3Plan.window := by
    rw [Plan.exitDelta, v3Plan_loanUnits]
  have vw : v3Plan.window = 767 := rfl
  rw [de]
  omega

end ECDSAAdd.Entrant.StairSlotsPlan

end
