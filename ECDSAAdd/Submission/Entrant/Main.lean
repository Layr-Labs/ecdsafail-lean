attribute [local irreducible] run SkywalkNat.step barrel15E core15EProg fullProg15E beforeStore15E storeMapped15E leaveUnred15E entryLeave15E leaveStoreMapped15E in
/-- Master forward semantics of the entire unreduced trailing 15-tick leave `leaveUnred15E j`. -/
theorem whole15E_result (j : Fin 4) (s : State) (m : List Bool) (z : SkywalkNat.State)
    (G sg : Bool) (small : LeaveJ7.Small7 (sb15E (start15E j)) z) (odd : z.v % 2 = 1)
    (room : high (sb15E (start15E j)) 15 z + 1 < 2 ^ wp15E (start15E j))
    (fit : TrueMiddle15E.F j z < 2 ^ liveW15E (start15E j))
    (nextSmall : Shadow7.SmallIfFar (sb15E (start15E j + 15)) 15 (step^[15] z))
    (ready : onRails15E j 15 (SkywalkRails.encode G sg
      (step^[15] (TrueMiddle15E.r j z)).u (step^[15] (TrueMiddle15E.r j z)).v) s.basis)
    (fresh : s.basis (e015E (start15E j) + 5) = false)
    (scratch : ∀ q ∈ 1556 :: 1557 :: 1558 :: LeaveJ7.fullC, s.basis q = false)
    (temp : ∀ p ∈ longPairs15E j, s.basis p.2 = false)
    (clean : ∀ q ∈ carries15E j, s.basis q = false)
