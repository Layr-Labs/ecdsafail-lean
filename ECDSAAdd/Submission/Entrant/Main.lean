    let a := step^[15] z
    let sign := PortalValues.negative sg a.u
    let mag := a.u - sign.toNat
    let nf := decide (far (sb15E (start15E j + 15)) 15 a)
    let active := decide (far (sb15E (start15E j)) 15 z)
