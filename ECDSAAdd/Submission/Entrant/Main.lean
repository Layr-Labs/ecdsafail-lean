    out.basis (e015E (start15E j + 15) + 6) = active ∧
    out.basis (e015E (start15E j + 15) + 7) = (active && StairArchiveTrace.afterFlags u (xs.take 5)) ∧
    out.basis (e015E (start15E j + 15) + 8) = (active && HighBankSum.crossBit (TrueMiddle15E.d j z)) ∧
