private theorem hist20_geom : ∀ j : Fin 9, ∀ t : Nat,
    ((j.val = 0 ∧ t = 150) ∨ (1 ≤ j.val ∧ (t = start20 j - 20 ∨ t = start20 j - 15))) →
    ∀ i : Fin 10,
