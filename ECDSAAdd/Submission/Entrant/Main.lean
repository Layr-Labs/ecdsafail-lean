          1556 ≤ windowNet20 j (hist20 (start20 j) t i) ∧
            windowNet20 j (hist20 (start20 j) t i) ≤ sbP20 (start20 j) + 1576)) := by
  intro j t ht i
  have hj := j.isLt
  have hcheck : ∀ (r : Fin 9) (k : Fin 10),
      let ts : List Nat := if r.val = 0 then [150] else [start20 r - 20, start20 r - 15]
