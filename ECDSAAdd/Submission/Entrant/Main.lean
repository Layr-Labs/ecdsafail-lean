    let t := run (GateMirror.forward (Shadow7.fix0P (start15E j) (sb15E (start15E j)))) tape s
    let e := PortalValues.negative sg u
    t.phase = s.phase ∧ t.basis (e015E (start15E j) + 5) = e ∧
      (∀ i < 17, t.basis (a015E (start15E j) - 1 + i) = ((u + v) / 2 ^ sb15E (start15E j)).testBit i ∧
        t.basis (b015E (start15E j) - 1 + i) = ((u - e.toNat) / 2 ^ sb15E (start15E j)).testBit i) ∧
      ∀ q, q ≠ e015E (start15E j) + 5 → q ∉ RailPair.sites (scanPairs15E j) → t.basis q = s.basis q := by
  obtain ⟨pl, pr, pa, pb, pg, la, lb⟩ := scan15E_ports j
  rw [scan15E_emitted j]
  let L := IntegerPacket.ports (shape15E j) 15
  let e := PortalValues.negative sg u
  have gh : mappedBasis15E j s.basis L.previous = G := by
    have eq := ready.2.2.1; cases G <;> exact eq
  have math := signedWords L G sg u v (mappedBasis15E j s.basis) ready.1 ready.2.1 gh
  have gg : s.basis (start15E j + 30) = G := pg ▸ gh
  have ss : (s.basis (a015E (start15E j) + 15) ^^ s.basis (b015E (start15E j) + 15)) = e := by
    rw [pa, pb]; exact math.2.1
  have act := RailPair.scan_run _ _ _ _ _ (scan15E_layout j) s tape fresh
  have vals := scan_values _ _ _ _ _ (scan15E_layout j) s tape fresh
  dsimp only at vals act ⊢
  set st := run (RailPair.scan (a015E (start15E j) + 15) (b015E (start15E j) + 15) (start15E j + 30)
    (e015E (start15E j) + 5) (scanPairs15E j)) tape s
  have hout : st.basis (e015E (start15E j) + 5) = e ∧
      regValue ((scanPairs15E j).map Prod.fst) st.basis = (u + v) / 2 ^ sb15E (start15E j) ∧
      regValue ((scanPairs15E j).map Prod.snd) st.basis = (u - e.toNat) / 2 ^ sb15E (start15E j) := by
    refine ⟨act.2.1.trans ss, ?_⟩
    rw [gg, ss] at vals; rw [pl, pr] at vals ⊢
    simp only [unroute, shiftedValue, la, lb] at vals ⊢
    obtain ⟨pos, mag⟩ := math.2.2
    cases G <;> simp only [wordPos, wordSigned, ite_true, Bool.false_eq_true, ite_false] at pos mag vals
    all_goals exact ⟨vals.1.trans (congrArg (· / 2 ^ sb15E (start15E j)) pos),
      vals.2.trans (congrArg (· / 2 ^ sb15E (start15E j)) mag)⟩
  refine ⟨act.1, hout.1, ?_, act.2.2.1⟩
  intro i hi
  have g1 : ((scanPairs15E j).map Prod.fst).getD i 0 = a015E (start15E j) - 1 + i := by
    simp [scanPairs15E, List.getD_eq_getElem?_getD, hi]
  have g2 : ((scanPairs15E j).map Prod.snd).getD i 0 = b015E (start15E j) - 1 + i := by
    simp [scanPairs15E, List.getD_eq_getElem?_getD, hi]
  have hb1 := HighBankAdjust.bit_read ((scanPairs15E j).map Prod.fst) i st.basis (by simp [scanPairs15E, hi])
  have hb2 := HighBankAdjust.bit_read ((scanPairs15E j).map Prod.snd) i st.basis (by simp [scanPairs15E, hi])
  rw [g1, hout.2.1] at hb1; rw [g2, hout.2.2] at hb2
  exact ⟨hb1, hb2⟩

private theorem leaveFix1_eq_notReg : ∀ j : Fin 4,
    GateMirror.forward (leaveFix1 (start15E j) (sb15E (start15E j))) = notRegister (history15E j) := by
  decide +kernel

private theorem glue15E_layout : ∀ j : Fin 4,
    (1556 :: (b015E (start15E j) - 1) :: PortalAnd.sites (longPairs15E_15 j)).Nodup ∧
    e015E (start15E j) + 4 ∉ 1556 :: (b015E (start15E j) - 1) :: PortalAnd.sites (longPairs15E_15 j) ∧
    e015E (start15E j) + 3 ∉ 1556 :: (b015E (start15E j) - 1) :: PortalAnd.sites (longPairs15E_15 j) ∧
    OB5.sig (start15E j + 14) (start15E j + 1044) ∉ 1556 :: (b015E (start15E j) - 1) :: PortalAnd.sites (longPairs15E_15 j) ∧
    (1571 : Wire) ∉ 1556 :: (b015E (start15E j) - 1) :: PortalAnd.sites (longPairs15E_15 j) ∧
    e015E (start15E j) + 4 ≠ 1571 ∧ e015E (start15E j) + 3 ≠ 1571 ∧
    OB5.sig (start15E j + 14) (start15E j + 1044) ≠ 1571 := by
  decide +kernel

theorem latchG2_15E_run (j : Fin 4) (s : State) (m : List Bool)
    (clean : ∀ p ∈ longPairs15E_15 j, s.basis p.2 = false) (c71 : s.basis 1571 = false) :
    run (latchG2_15E j) m s = ⟨s.phase, writeBit s.basis 1556 (s.basis 1556 ^^
      (PortalAnd.digits (b015E (start15E j) - 1) (longPairs15E_15 j)).any s.basis ^^
      (!(PortalAnd.digits (b015E (start15E j) - 1) (longPairs15E_15 j)).any s.basis &&
        (s.basis (e015E (start15E j) + 4) ^^ (s.basis (e015E (start15E j) + 3) &&
          s.basis (OB5.sig (start15E j + 14) (start15E j + 1044))))))⟩ := by
  obtain ⟨gn, gs, gf, gr, gt, gsT, gfT, grT⟩ := glue15E_layout j
  exact PortalAnd.run_latchMid true 1556 (b015E (start15E j) - 1) _ _ _ 1571 (longPairs15E_15 j)
    gn gs gf gr gt gsT gfT grT s m clean c71

private theorem glue15E_entry_frame : ∀ j : Fin 4,
    ((e015E (start15E j) + 3 < start15E j + 16 ∨ start15E j + 30 < e015E (start15E j) + 3) ∧
      e015E (start15E j) + 3 ≠ e015E (start15E j) + 5 ∧ e015E (start15E j) + 3 ∉ RailPair.sites (scanPairs15E j)) ∧
    ((e015E (start15E j) + 4 < start15E j + 16 ∨ start15E j + 30 < e015E (start15E j) + 4) ∧
      e015E (start15E j) + 4 ≠ e015E (start15E j) + 5 ∧ e015E (start15E j) + 4 ∉ RailPair.sites (scanPairs15E j)) ∧
    ((OB5.sig (start15E j + 14) (start15E j + 1044) < start15E j + 16 ∨ start15E j + 30 < OB5.sig (start15E j + 14) (start15E j + 1044)) ∧
      OB5.sig (start15E j + 14) (start15E j + 1044) ≠ e015E (start15E j) + 5 ∧
      OB5.sig (start15E j + 14) (start15E j + 1044) ∉ RailPair.sites (scanPairs15E j)) := by
  decide +kernel

theorem glueBound15E (j : Fin 4) (z : SkywalkNat.State) (sg : Bool) (small : LeaveJ7.Small7 (sb15E (start15E j)) z) :
    (far (sb15E (start15E j)) 15 z ∧ LeaveShadowRails.farKey (sb15E (start15E j)) z = 0) →
      ¬ 2 ^ sb15E (start15E j) ≤ (step^[15] (reduced (sb15E (start15E j)) 15 z)).u -
        (PortalValues.negative sg (step^[15] (reduced (sb15E (start15E j)) 15 z)).u).toNat →
      (step^[15] (reduced (sb15E (start15E j)) 15 z)).u + (step^[15] (reduced (sb15E (start15E j)) 15 z)).v <
        2 * 2 ^ sb15E (start15E j) := by
  intro K low
  exact LeaveShadowRails.key0EraseBound _ z (small.1 K.1) K.1 K.2 _
    (by cases PortalValues.negative sg (step^[15] (reduced (sb15E (start15E j)) 15 z)).u <;> decide) low

attribute [local irreducible] run SkywalkNat.step Shadow7.fix0P leaveFix1 Shadow7.fix2P latchG2_15E Companion.eraseM in
theorem entry15E_core (j : Fin 4) (s : State) (m : List Bool) (z : SkywalkNat.State)
    (G sg : Bool) (small : LeaveJ7.Small7 (sb15E (start15E j)) z)
    (ready : onRails15E j 15 (SkywalkRails.encode G sg
      (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).u
      (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).v) s.basis)
    (fresh : s.basis (e015E (start15E j) + 5) = false)
    (scratch : ∀ q ∈ 1556 :: 1557 :: 1558 :: LeaveJ7.fullC, s.basis q = false)
    (temp : ∀ p ∈ longPairs15E j, s.basis p.2 = false)
    (K : Prop) [Decidable K]
    (hK : K → ¬ 2 ^ sb15E (start15E j) ≤ (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).u -
      (PortalValues.negative sg (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).u).toNat →
      (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).u +
      (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).v < 2 * 2 ^ sb15E (start15E j))
    (flag : (s.basis (e015E (start15E j) + 4) ^^ (s.basis (e015E (start15E j) + 3) &&
      s.basis (OB5.sig (start15E j + 14) (start15E j + 1044)))) = decide K) :
    let a := SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)
    let e := PortalValues.negative sg a.u
    let out := run (GateMirror.forward (entryLeave15E (start15E j))) m s
    out.phase = s.phase ∧ regValue (fullM15E j) out.basis = 0 ∧ out.basis (e015E (start15E j) + 5) = e ∧
      out.basis 1556 = decide (2 ^ sb15E (start15E j) ≤ a.u - e.toNat ∨ K) ∧
      (out.basis 1557 = false ∧ out.basis 1558 = false) ∧
      (∀ i < 17, out.basis (a015E (start15E j) - 1 + i) = ((a.u + a.v) / 2 ^ sb15E (start15E j)).testBit i) ∧
      ∀ q, q ∉ 1556 :: 1557 :: 1558 :: fullM15E j → (q < start15E j + 16 ∨ start15E j + 30 < q) →
        q ≠ e015E (start15E j) + 5 → q ∉ RailPair.sites (scanPairs15E j) → out.basis q = s.basis q := by
  have hg := geom15E_facts j; dsimp only at hg
  intro a e out
  have scanActual := inputScan15E_result j s m a.u a.v G sg ready fresh
  generalize hu : run (GateMirror.forward (Shadow7.fix0P (start15E j) (sb15E (start15E j)))) m s = u at scanActual
  generalize ht : m.drop (measurementCount (GateMirror.forward (Shadow7.fix0P (start15E j) (sb15E (start15E j))))) = t
  generalize hv : run (GateMirror.forward (leaveFix1 (start15E j) (sb15E (start15E j)))) t u = v
  have hfl : GateMirror.forward (leaveFix1 (start15E j) (sb15E (start15E j))) = notRegister (history15E j) :=
    leaveFix1_eq_notReg j
  have hnd : (history15E j).Nodup := List.Nodup.map (fun _ _ eq => Nat.add_left_cancel eq) List.nodup_range
  have hist (q : Wire) (hq : q < start15E j + 16 ∨ start15E j + 30 < q) : v.basis q = u.basis q := by
    rw [← hv]; apply LeaveReadoutFrame.preserved; rw [hfl]
    simp only [history15E, notRegister, List.map_map, List.mem_map, List.mem_range, not_exists, not_and]
    intro i hi eq; simp only [Function.comp, destination] at eq; unfold Wire at *; omega
  have vphase : v.phase = u.phase := by rw [← hv, hfl, notRegister_correct _ hnd]
  have outputBits (i : Nat) (hi : i < 17) :
      v.basis (a015E (start15E j) - 1 + i) = ((a.u + a.v) / 2 ^ sb15E (start15E j)).testBit i ∧
      v.basis (b015E (start15E j) - 1 + i) = ((a.u - e.toNat) / 2 ^ sb15E (start15E j)).testBit i := by
    rw [hist _ (Or.inr (by unfold a015E Wire; omega)), hist _ (Or.inr (by unfold b015E Wire; omega))]
    exact scanActual.2.2.1 i hi
  have same (q : Wire) (h1q : q < start15E j + 16 ∨ start15E j + 30 < q) (h2q : q ≠ e015E (start15E j) + 5)
      (h3q : q ∉ RailPair.sites (scanPairs15E j)) : v.basis q = s.basis q :=
    (hist _ h1q).trans (scanActual.2.2.2 _ h2q h3q)
  have scanLt : ∀ q ∈ RailPair.sites (scanPairs15E j), (q : Nat) < 1556 := by
    intro q hq
    obtain ⟨p, hp, hq'⟩ := List.mem_flatMap.mp hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq'
    rcases hq' with rfl | rfl <;> (unfold a015E b015E Wire at *; omega)
  have away (q : Nat) (hq : 1556 ≤ q ∧ q ≤ 1575) :
      (q < start15E j + 16 ∨ start15E j + 30 < q) ∧ q ≠ e015E (start15E j) + 5 ∧
        q ∉ RailPair.sites (scanPairs15E j) :=
    ⟨Or.inr (by omega), by omega, fun hm => by have hlt := scanLt q hm; unfold Wire at *; omega⟩
  have capSmall : min a.u a.v < 2 ^ sb15E (start15E j) := by
    by_cases f : Shadow.far (sb15E (start15E j)) 15 z
    · exact (LeaveShadowRails.inputFit (sb15E (start15E j)) z (small.1 f)).1
    · have e' : Shadow.reduced (sb15E (start15E j)) 15 z = z := by simp only [Shadow.reduced, if_neg f]
      show min (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced (sb15E (start15E j)) 15 z)).v < _
      rw [e']; exact small.2
  have htight := LeaveShadowRails.inputTight16 (sb15E (start15E j)) z small.1
  have hrow14 := LeaveShadowRails.inputRow14 (sb15E (start15E j)) z small.1
  have htightU : a.u / 2 ^ sb15E (start15E j) < 2 ^ 15 := (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr hrow14.1
  have htightL : 2 ^ sb15E (start15E j) ≤ a.u - e.toNat → (a.u + a.v) / 2 ^ sb15E (start15E j) < 2 ^ 15 :=
    fun hl => (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr (hrow14.2 capSmall (le_trans hl (Nat.sub_le _ _)))
  have hse : e.toNat ≤ 1 := by cases e <;> decide
  have hsu : e.toNat ≤ a.u := by
    by_cases h : 0 < a.u
    · cases e <;> [exact Nat.zero_le _; exact Nat.succ_le_of_lt h]
    · simp [e, PortalValues.negative, h]
  have hb_top15 : (a.u - e.toNat) / 2 ^ sb15E (start15E j) < 2 ^ 15 :=
    lt_of_le_of_lt (Nat.div_le_div_right (Nat.sub_le _ _)) htightU
  have htemps14 : ∀ p ∈ longPairs15E_15 j, v.basis p.2 = false := fun p hp => by
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hi
    have hm : (b015E (start15E j) + i, 1557 + i) ∈ longPairs15E j :=
      List.mem_map.mpr ⟨i, List.mem_range.mpr (by omega), rfl⟩
    rw [same _ (away _ (by omega)).1 (away _ (by omega)).2.1 (away _ (by omega)).2.2]
    exact temp _ hm
  have hc71 : v.basis 1571 = false := by
    rw [same _ (away 1571 (by omega)).1 (away 1571 (by omega)).2.1 (away 1571 (by omega)).2.2]
    exact temp (b015E (start15E j) + 14, 1571) (List.mem_map.mpr ⟨14, List.mem_range.mpr (by decide), rfl⟩)
  obtain ⟨g3, g4, gr⟩ := glue15E_entry_frame j
  have flagV : (v.basis (e015E (start15E j) + 4) ^^ (v.basis (e015E (start15E j) + 3) &&
      v.basis (OB5.sig (start15E j + 14) (start15E j + 1044)))) = decide K := by
    rw [same _ g4.1 g4.2.1 g4.2.2, same _ g3.1 g3.2.1 g3.2.2, same _ gr.1 gr.2.1 gr.2.2]; exact flag
  have hd_any : (PortalAnd.digits (b015E (start15E j) - 1) (longPairs15E_15 j)).any v.basis =
      decide (2 ^ sb15E (start15E j) ≤ a.u - e.toNat) := by
    have hge_iff : 2 ^ sb15E (start15E j) ≤ a.u - e.toNat ↔ (a.u - e.toNat) / 2 ^ sb15E (start15E j) ≠ 0 := by
      constructor
      · intro hle h0; have := (Nat.div_eq_zero_iff_lt (Nat.two_pow_pos _)).mp h0; omega
      · intro h0; by_contra hlt; exact h0 (Nat.div_eq_of_lt (Nat.lt_of_not_ge hlt))
    rw [decide_eq_decide.mpr hge_iff]
    cases hne : decide ((a.u - e.toNat) / 2 ^ sb15E (start15E j) ≠ 0)
    · simp only [decide_eq_false_iff_not, not_not] at hne
      apply Bool.eq_false_iff.mpr; intro htrue
      obtain ⟨w, hw, hvw⟩ := List.any_eq_true.mp htrue
      simp only [PortalAnd.digits, List.mem_cons, longPairs15E_15, List.mem_map, List.mem_range] at hw
      rcases hw with rfl | ⟨_, ⟨i, hi, rfl⟩, rfl⟩
      · have hb := (outputBits 0 (by decide)).2; rw [Nat.add_zero, hne, Nat.zero_testBit] at hb; rw [hb] at hvw; exact Bool.noConfusion hvw
      · have hb := (outputBits (i + 1) (by omega)).2
        rw [show b015E (start15E j) - 1 + (i + 1) = b015E (start15E j) + i by unfold b015E; omega, hne, Nat.zero_testBit] at hb
        rw [hb] at hvw; exact Bool.noConfusion hvw
    · simp only [decide_eq_true_eq] at hne
      obtain ⟨i, hi, hbit⟩ : ∃ i < 15, ((a.u - e.toNat) / 2 ^ sb15E (start15E j)).testBit i = true := by
        by_contra hall; push_neg at hall
        have heq0 : (a.u - e.toNat) / 2 ^ sb15E (start15E j) = 0 := Nat.eq_of_testBit_eq fun k => by
          rw [Nat.zero_testBit]
          by_cases hk : k < 15
          · exact Bool.eq_false_iff.mpr (hall k hk)
          · exact Nat.testBit_lt_two_pow (lt_of_lt_of_le hb_top15 (Nat.pow_le_pow_right (by decide) (by omega)))
        exact hne heq0
      apply List.any_eq_true.mpr
      cases i with
      | zero => exact ⟨b015E (start15E j) - 1, by simp [PortalAnd.digits], by simpa [Nat.add_zero] using (outputBits 0 (by decide)).2.trans hbit⟩
      | succ k =>
        refine ⟨b015E (start15E j) + k, ?_, ?_⟩
        · simp only [PortalAnd.digits, List.mem_cons, longPairs15E_15, List.mem_map, List.mem_range]
          right; exact ⟨_, ⟨k, by omega, rfl⟩, rfl⟩
        · have hb := (outputBits (k + 1) (by omega)).2
          rw [show b015E (start15E j) - 1 + (k + 1) = b015E (start15E j) + k by unfold b015E; omega] at hb
          exact hb.trans hbit
  -- Now run fix2P = latchG2_15E ++ (maskP15E ++ (Companion.eraseM ++ releaseMaskP15E))
  let t2 := t.drop (measurementCount (GateMirror.forward (leaveFix1 (start15E j) (sb15E (start15E j)))))
  have vclean : ∀ q ∈ (1556 :: 1557 :: 1558 :: LeaveJ7.fullC : List Wire), v.basis q = false := fun q hq => by
    have hr : 1556 ≤ (q : Nat) ∧ (q : Nat) ≤ 1575 := by
      simp only [List.mem_cons, LeaveJ7.fullC, List.mem_map, List.mem_range] at hq
      rcases hq with rfl | rfl | rfl | ⟨i, hi, rfl⟩ <;> (unfold Wire; omega)
    exact (same q (away q hr).1 (away q hr).2.1 (away q hr).2.2).trans (scratch q hq)
  have orK : ∀ P : Prop, ∀ [Decidable P], (false ^^ decide P ^^ (!decide P && decide K)) = decide (P ∨ K) := by
    intro P _; by_cases hP : P <;> by_cases hK' : K <;> simp [hP, hK']
  generalize hl : run (latchG2_15E j) t2 v = l
  generalize hs1 : t2.drop (measurementCount (latchG2_15E j)) = s1
  have hl_eq : l = ⟨v.phase, writeBit v.basis 1556 (decide (2 ^ sb15E (start15E j) ≤ a.u - e.toNat ∨ K))⟩ := by
    rw [← hl, latchG2_15E_run j v t2 htemps14 hc71, hd_any, vclean 1556 (by simp), flagV, orK]
  have lbase (q : Wire) (hq : q ≠ 1556) : l.basis q = v.basis q := by rw [hl_eq]; simp [writeBit, hq]
  have ndM : [a015E (start15E j) - 1, b015E (start15E j) - 1, (1557 : Wire), 1558].Nodup := by
    simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, List.nodup_nil, and_true, not_or, not_false_eq_true]
    unfold a015E b015E Wire; omega
  have mo := LeaveCompanion.mask_open (a015E (start15E j) - 1) (b015E (start15E j) - 1) 1557 1558 l s1 ndM
    ((lbase 1557 (by decide)).trans (vclean 1557 (by simp))) ((lbase 1558 (by decide)).trans (vclean 1558 (by simp)))
  generalize hw : (⟨l.phase, writeBit (writeBit l.basis 1557 (!l.basis (a015E (start15E j) - 1))) 1558
    (l.basis (b015E (start15E j) - 1) && !l.basis (a015E (start15E j) - 1))⟩ : State) = w
  have wphase : w.phase = v.phase := by rw [← hw, hl_eq]
  have wkept (q : Wire) (hq : q ∉ ([1556, 1557, 1558] : List Wire)) : w.basis q = v.basis q := by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hq
    rw [← hw]; simp only [writeBit, Function.update_of_ne hq.2.2, Function.update_of_ne hq.2.1]; exact lbase q hq.1
  have wisLong : w.basis 1556 = decide (2 ^ sb15E (start15E j) ≤ a.u - e.toNat ∨ K) := by rw [← hw, hl_eq]; simp [writeBit]
  have wborrow : (w.basis 1558).toNat = upperBorrow (2 ^ sb15E (start15E j)) a.u a.v e.toNat := by
    rw [← hw]; simp only [writeBit, Function.update_self]
    rw [lbase _ (by unfold b015E Wire; omega), lbase _ (by unfold a015E Wire; omega)]
    have b0 := outputBits 0 (by decide); simp only [Nat.add_zero] at b0
    rw [b0.1, b0.2]; exact LeaveCompanion.borrowBit (2 ^ sb15E (start15E j)) a.u a.v e.toNat (Nat.two_pow_pos _)
  have half2 (x : Nat) : x / 2 ^ (sb15E (start15E j) + 1) = (x / 2 ^ sb15E (start15E j)) / 2 ^ 1 := by
    rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  have wregA : regValue (fullA15E j) w.basis = ((a.u + a.v) / 2 ^ (sb15E (start15E j) + 1)) % 2 ^ 16 := by
    have hv' := EnterProof.value_of_bits (fullA15E j) w.basis ((a.u + a.v) / 2 ^ (sb15E (start15E j) + 1)) (fun i hi => by
      have hi16 : i < 16 := by simpa [fullA15E] using hi
      have hget : (fullA15E j).getD i 0 = a015E (start15E j) - 1 + (i + 1) := by
        simp [fullA15E, List.getD_eq_getElem?_getD, hi16]; unfold a015E Wire; omega
      rw [hget, wkept _ (by simp [a015E, Wire]; omega), half2, Nat.testBit_div_two_pow, Nat.add_comm i 1]
      exact (outputBits (1 + i) (by omega)).1)
    simpa [fullA15E] using hv'
  have wregM : regValue (fullM15E j) w.basis = ((a.u - e.toNat) / 2 ^ (sb15E (start15E j) + 1)) % 2 ^ 16 := by
    have hv' := EnterProof.value_of_bits (fullM15E j) w.basis ((a.u - e.toNat) / 2 ^ (sb15E (start15E j) + 1)) (fun i hi => by
      have hi16 : i < 16 := by simpa [fullM15E] using hi
      have hget : (fullM15E j).getD i 0 = b015E (start15E j) - 1 + (i + 1) := by
        simp [fullM15E, List.getD_eq_getElem?_getD, hi16]; unfold b015E Wire; omega
      rw [hget, wkept _ (by simp [b015E, Wire]; omega), half2, Nat.testBit_div_two_pow, Nat.add_comm i 1]
      exact (outputBits (1 + i) (by omega)).2)
    simpa [fullM15E] using hv'
  have cond16 : (regValue (fullM15E j) w.basis + (w.basis 1558).toNat) % 2 ^ 16 =
      copyValue (some 1556) w.basis (regValue (fullA15E j) w.basis) := by
    rw [wregM, wregA, wborrow]
    have twice : 2 * 2 ^ sb15E (start15E j) = 2 ^ (sb15E (start15E j) + 1) := by rw [Nat.pow_succ]; omega
    have cv := LeaveShadowRails.upper_clear_or (2 ^ sb15E (start15E j)) a.u a.v e.toNat (2 ^ 16) (Nat.two_pow_pos _) hse hsu capSmall K hK
    rw [twice] at cv
    simpa only [copyValue, wisLong, decide_eq_true_eq] using cv
  have htightE : (2 ^ sb15E (start15E j) ≤ a.u - e.toNat ∨ K) → (a.u + a.v) / 2 ^ sb15E (start15E j) < 2 ^ 15 := by
    intro hl'
    by_cases hlong : 2 ^ sb15E (start15E j) ≤ a.u - e.toNat
    · exact htightL hlong
    · have lt := hK (hl'.resolve_left hlong) hlong
      have two : (a.u + a.v) / 2 ^ sb15E (start15E j) < 2 := (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr (by omega)
      omega
  have wA15 : w.basis (a015E (start15E j) + 15) = false := by
    rw [wkept _ (by simp [a015E, Wire]; omega)]
