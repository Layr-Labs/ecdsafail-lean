    intro q hq
    obtain ⟨w,hw,rfl⟩:=Finset.mem_image.mp hq
    have lt:=Finset.mem_range.mp hw
    simp only [MeasuredCodec5.label,dif_pos lt,List.mem_toFinset]
    exact history_mem j ⟨w,lt⟩
  exact ⟨img,img⟩

