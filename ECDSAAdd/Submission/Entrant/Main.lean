    simp [CRTBarrel.exitShift, CRTBarrel.entryShift]
  have hshift0 : CRTBarrel.exitShift true slot.val = CRTBarrel.entryShift false slot.val := by
    simp [CRTBarrel.exitShift, CRTBarrel.entryShift]
  have hb := barrel15E_result j true slot v (run (barrel15E (start15E j) false) m u) n small
    (hshift ▸ hf.bits)
    (fun k => by rw [htags_def k]; exact (hf.frame _ (htag_out k.val k.isLt)).trans (tag k.val k.isLt))
    (fun k hk => (hf.frame _ (hscr_out k hk)).trans (scratch k hk))
  apply state_eq_of_pb15E (hb.phase.trans hf.phase)
  funext q
  by_cases hmem : ∃ i < liveW15E (start15E j), bankW15E (start15E j) i = q
  · obtain ⟨i, hi, rfl⟩ := hmem; rw [hb.bits i hi, hshift0, input i hi]
  · have hout : HighBankBarrel.outside (bankW15E (start15E j)) (liveW15E (start15E j)) q := fun i hi e => hmem ⟨i, hi, e.symm⟩
    exact (hb.frame q hout).trans (hf.frame q hout)

/-! ### Section 2: `bitCheck` Certificates & Unreduced `before15E` / `afterPart15E` Validity -/

private def maskSub15E (a b : Nat) : Bool := (a ||| b) == b

private theorem masked_sub15E {s : State} {a b : Nat} (hsub : maskSub15E a b = true)
    (hb : Masked s b) : Masked s a := by
  intro q hq
  have heq : a ||| b = b := of_decide_eq_true hsub
  have htb : (a ||| b).testBit q = b.testBit q := congrArg (fun n : Nat => n.testBit q) heq
  rw [Nat.testBit_or, hq, Bool.true_or] at htb
  exact hb q htb.symm

private theorem tb_shl15E (a q : Nat) : (1 <<< a).testBit q = decide (a = q) := by
  rw [Nat.testBit_shiftLeft]
  by_cases h : a ≤ q
  · by_cases he : a = q
    · subst he; simp
    · have hdiv : 1 / 2 ^ (q - a) = 0 := Nat.div_eq_of_lt (Nat.one_lt_two_pow (by omega))
      rw [decide_eq_true h, Bool.true_and, decide_eq_false he, Nat.testBit, Nat.shiftRight_eq_div_pow, hdiv]; rfl
  · rw [decide_eq_false h, Bool.false_and]
    exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq, Bool.false_eq_true, false_iff]; omega)

private theorem tb_int15E (lo w q : Nat) :
    (GateMirror.interval lo w).testBit q = decide (lo ≤ q ∧ q < lo + w) := by
  unfold GateMirror.interval; rw [Nat.testBit_shiftLeft]
  by_cases h1 : lo ≤ q
  · simp only [decide_eq_true h1, Bool.true_and, Nat.testBit_two_pow_sub_one, ge_iff_le]
    exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; omega)
  · simp only [decide_eq_false h1, Bool.false_and]
    exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq, Bool.false_eq_true, false_iff, not_and]; omega)

private def chkMask15E (gs : List Gate) (post allow : Nat) : Bool :=
  match bitCheck gs post with
  | some pre => maskSub15E pre allow
  | none => false

private theorem ready_chk15E (gs : List Gate) (s : State) (post allow : Nat)
    (hc : chkMask15E gs post allow = true) (hallow : Masked s allow) :
    Ready s gs ∧ Masked (run (GateMirror.forward gs) [] s) post := by
  unfold chkMask15E at hc
  cases hx : bitCheck gs post with
  | none => simp [hx] at hc
  | some pre =>
    simp only [hx] at hc
    have hs := bit_sound gs s pre post hx (masked_sub15E hc hallow)
    exact ⟨hs.2.1, hs.2.2⟩

