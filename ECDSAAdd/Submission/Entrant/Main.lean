  cases hx : bitCheck gs post with
  | none => simp [hx] at hc
  | some pre =>
    simp only [hx] at hc
    have hs := bit_sound gs s pre post hx (masked_of_subset150 hc hallow)
    exact ⟨hs.2.1, hs.2.2⟩

private def storePart1Mid150 : List Gate :=
