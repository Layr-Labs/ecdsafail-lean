/-! ## branch level: tail wires `ktmp[k]`, `99 ≤ k < 123`, `k ≠ 108` -/


section Branch
variable (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (ext : List Wire) (control : Wire)
  (hn : (control::L.wires).Nodup) (he : ECDSAAdd.Entrant.ExtOK L control ext)
  (ps : List (Wire × Wire)) (hps : List.Sublist ps (pairs L))




include hw hn he hps in
theorem branchC_tail (k : Nat) (hk1 : 99≤k) (hk2 : k<123) (hk3 : k≠108) (B : Program)
    (hB : (LowZero18LowK.ktmp L).getD k 0∉wires B) :
    (LowZero18LowK.ktmp L).getD k 0∉wires (branchC2 ps L ext control B) := by
  have hsl := L.core.sum_length hw.core
  have len := LowZero18LowK.ktmp_length L hw
  have mid := withLowK2S2_quiet L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
    (by simp [hsl]) (by simp [hsl]) (by simp [hw.core.product,hsl]) he.nodup he.away he.len ps hps hsl
    _ _
    (quiet_of_tail L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
      he.nodup he.away k hk1 hk2)
    (tail_bodySwap_free L hw ext control hn he k hk2 hk3 B hB)
  have g := ktmp_off_g L hw control hn _ (DiagSq.getD_in _ k (by omega))
  intro u
  simp only [branchC2,wires_append,Finset.mem_union] at u
  rcases u with (u|u)|u
  · exact g.1 u
  · exact mid u
  · exact g.2 u

