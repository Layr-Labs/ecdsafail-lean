theorem finalKey420 : ∀ (d:Bool) (x:Nat) (good:Bounds x p) (s:State) (m:List Bool), ReadyW d x p 420 s →
    SavedKey (value x p 405 (Shadow7.sbP 405) (StockRowVectorW.crossW ⟨24,by decide⟩)) ExitPorts420 d
