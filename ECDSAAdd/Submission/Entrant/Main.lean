      (baseFirstPacket_768_free divide))

private theorem codec_placed_mem (divide : Bool) (i : Fin 10) :
    History5.historyMap base 0 i∈
      wires (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) := by
  have raw:=old_codec_sub divide (codec_mem i)
  have placed : shifted (Placement5.pi 0) (History5.historyMap base 0 i)∈
      wires (FrontierSW1591.firstPacketS divide) := by
    rw [FrontierSW1591.firstPacketS,renameProgram_support]
    exact Finset.mem_image.mpr ⟨_,raw,rfl⟩
  rw [firstPlacement_history] at placed
  rw [renameProgram_support]
  exact Finset.mem_image.mpr ⟨_,placed,firstSig_history i⟩

private theorem prefix_sub (divide : Bool) : wires prefixProgram⊆
    wires (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) := by
  rw [prefixProgram,Prefix1590Codec.perm_support]
  intro q used
  obtain ⟨i,rfl⟩:=NewHistory5.history_gate_mem base 0 _ (Or.inl rfl) q used
  exact codec_placed_mem divide i

private theorem unprefix_sub (divide : Bool) : wires unprefix⊆
    wires (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS divide)) := by
  rw [unprefix,Prefix1590Codec.invPerm_support]
  intro q used
  obtain ⟨i,rfl⟩:=NewHistory5.history_gate_mem base 0 _ (Or.inl rfl) q used
  exact codec_placed_mem divide i

private theorem borrow_support (P Q : Program) (sub : wires P⊆wires Q)
    (g0 : base 0∈wires Q) (free : base 0∉wires P) :
    wires (renameProgram borrow P)⊆wires Q := by
  rw [renameProgram_support]
  intro q used
  obtain ⟨old,oldUsed,eq⟩:=Finset.mem_image.mp used
  subst q
  by_cases parity : old=base 768
  · subst old
    simpa only [borrow,Equiv.swap_apply_left] using g0
  have zero : old≠base 0 := fun eq=>free (eq ▸ oldUsed)
  simpa only [borrow,Equiv.swap_apply_of_ne_of_ne parity zero] using sub oldUsed

theorem entryField_subset : wires entryField⊆wires FrontierEntry1591Field.entryField := by
  have first : wires (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS true))⊆
      wires FrontierEntry1591Field.entryField := by
    rw [old_entryField_shape,wires_append]
    exact Finset.subset_union_left
  have pref:=(prefix_sub true).trans first
  have unpref:=(unprefix_sub true).trans first
  have tail:=borrow_support entryTail _ entryTail_support
    (first (codec_placed_mem true 0)) entryTail_g0_free
  intro q used
  simp only [entryField,wires_append,Finset.mem_union] at used
  rcases used with used|used|used|used
  · exact first (placedFirstPacket_support true used)
  · exact pref used
  · exact tail used
  · exact unpref used

theorem exitField_subset : wires exitField⊆wires FrontierEntry1591Field.exitField := by
  have first : wires (renameProgram (OB5.sig 511) (FrontierSW1591.firstPacketS false))⊆
      wires FrontierEntry1591Field.exitField := by
    rw [old_exitField_shape,wires_append]
    exact Finset.subset_union_right
  have pref:=(prefix_sub false).trans first
  have unpref:=(unprefix_sub false).trans first
  have head:=borrow_support exitHead _ exitHead_support
    (first (codec_placed_mem false 0)) exitHead_g0_free
  intro q used
  simp only [exitField,wires_append,Finset.mem_union] at used
  rcases used with used|used|used|used
  · exact pref used
  · exact head used
  · exact unpref used
  · exact first (placedFirstPacket_support false used)

theorem entryField_768_free : base 768∉wires entryField := by
  have pref:=codec_not768 prefixProgram (by rw [prefixProgram,Prefix1590Codec.perm_support])
  have unpref:=codec_not768 unprefix (by rw [unprefix,Prefix1590Codec.invPerm_support])
  have tail:=rename_away borrow borrow.injective (base 0) (base 768) entryTail
    (by simp [borrow]) entryTail_g0_free
  simpa only [entryField,wires_append,Finset.mem_union,not_or] using
    And.intro (placedFirstPacket_768_free true) (And.intro pref (And.intro tail unpref))

theorem exitField_768_free : base 768∉wires exitField := by
  have pref:=codec_not768 prefixProgram (by rw [prefixProgram,Prefix1590Codec.perm_support])
  have unpref:=codec_not768 unprefix (by rw [unprefix,Prefix1590Codec.invPerm_support])
  have head:=rename_away borrow borrow.injective (base 0) (base 768) exitHead
    (by simp [borrow]) exitHead_g0_free
  simpa only [exitField,wires_append,Finset.mem_union,not_or] using
    And.intro pref (And.intro head (And.intro unpref (placedFirstPacket_768_free false)))

