set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairSquareEntryR

open ECDSAAdd Arithmetic Secp256k1 ControlledPointLayout MappedCompressed CompressedPointDialog
  CompressedAllocation CompressedFieldSupport DirectSkywalk E1QubitPlacement
  E1ReflectedPlacement StairSquareHolesCore

attribute [local irreducible] ECDSAAdd.run ECDSAAdd.wires

/-! ## Field-12 piece fact -/



/-- A good generic-level site for the 39 holes. -/
def goodSq (q : Wire) : Bool :=
  decide (StairSiteAvoidance.UG q ∈ StairPhysicalLayout.arenaNat) &&
    decide (StairSiteAvoidance.UG q ∉ StairPhysicalLayout.oldHolesNat) &&
    decide (StairSiteAvoidance.UG q ∉ holes39Nat)

/-- LT46 (replay budget): `E1QubitPlacement.sig ∘ rho` as literal exchanges. -/
private def e1B (q : Nat) : Nat :=
  StairPlaceFast.swB 1558 736 (StairPlaceFast.swB 1557 738 (StairPlaceFast.swB 1042 737
    (StairPlaceFast.swB 1813 527 (StairPlaceFast.swB 738 740 (StairPlaceFast.swB 737 739
      (StairPlaceFast.swB 527 741 q))))))

private theorem e1_eq (q : Wire) : E1QubitPlacement.sig (E1QubitPlacement.rho q) = e1B q := by
  unfold E1QubitPlacement.sig E1QubitPlacement.phaseHost E1QubitPlacement.nativeSwap
    E1QubitPlacement.rho e1B
  simp only [Equiv.trans_apply, StairPlaceFast.swap_eq_sw, StairPlaceFast.swB_eq]
  rfl

/-- `pmapR L0` in closed form (`StairPlaceFast.wireFn2_eqB`). -/
private def pmB (q : Nat) : Nat :=
  StairPlaceFast.pwB (StairPlaceFast.swB 785 1813 (e1B q) - 16)

private theorem pmapR_fast (q : Wire) : pmapR L0 q = pmB q := by
  show wireFn2 Baselines.layout (E1QubitPlacement.sig (E1QubitPlacement.rho q)) = _
  rw [StairPlaceFast.wireFn2_eqB, e1_eq]
  rfl

/-- `goodSq` as one Boolean interval test on the closed-form `UG`
(`Nat.ble` / `Nat.beq` only; no pool walk, no list membership). -/
private def goodSqB (y : Nat) : Bool :=
  (fun q => (Nat.ble q 513 || Nat.beq q 4112 || (Nat.ble 4115 q && Nat.blt q 4630) ||
      (Nat.ble 4835 q && Nat.blt q 5144) || (Nat.ble 5399 q && Nat.blt q 5656) ||
      Nat.beq q 9814) &&
    !(Nat.beq q 5515 || Nat.beq q 5655 || Nat.beq q 5400 || Nat.beq q 5401 ||
      (Nat.ble 4840 q && Nat.blt q 4886))) (StairPlaceFast.ugB y)

private theorem goodSq_of_B {y : Wire} (h : goodSqB y = true) : goodSq y = true := by
  have hu : StairSiteAvoidance.UG y = StairPlaceFast.ugB y := StairPlaceFast.ug_eqB y
  unfold goodSq
  rw [hu]
  unfold goodSqB at h
  generalize StairPlaceFast.ugB y = q at h ⊢
  simp only [Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', Bool.eq_false_iff,
    ne_eq, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq, not_or] at h
  obtain ⟨ha, h1, h2, h3, h4, h5⟩ : (q ≤ 513 ∨ q = 4112 ∨ (4115 ≤ q ∧ q < 4630) ∨
      (4835 ≤ q ∧ q < 5144) ∨ (5399 ≤ q ∧ q < 5656) ∨ q = 9814) ∧
      q ≠ 5515 ∧ q ≠ 5655 ∧ q ≠ 5400 ∧ q ≠ 5401 ∧ ¬(4840 ≤ q ∧ q < 4886) := by omega
  simp only [Bool.and_eq_true, decide_eq_true_eq]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · show q ∈ ([1] ++ List.range' 2 256 ++ List.range' 258 256 ++ [0, 9815, 9814, 4112] ++
      List.range' 4115 515 ++ List.range' 4833 311 ++ List.range' 5399 257 ++ [5915] : List Nat)
    simp only [List.mem_append, List.mem_cons, List.mem_range'_1, List.not_mem_nil, or_false]
    omega
  · show q ∉ ([5515, 5915, 4881, 4880, 4882, 5655, 4885, 5400, 5401, 4884, 4883, 4833, 4834,
      4875, 9815] : List Nat)
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    omega
  · show q ∉ (List.range' 4840 35 ++ List.range' 4876 4 : List Nat)
    simp only [List.mem_append, List.mem_range'_1]
    omega

/-- LT46 (replay budget): one pass over the entry sites on the closed forms of `pmapR` and `UG`
(LT40 190 s, LT44 57.8 s → ≈ 2 s). -/
private theorem entryR_sites_goodB :
    (E1Reflected.mS5 base (base 2400)).all
      (fun q => Nat.beq (pmB q) 4840 || goodSqB (pmB q)) = true := by
  decide +kernel

theorem entryR_sites_good :
    ((E1Reflected.mS5 base (base 2400)).map (pmapR L0)).all
      (fun y => y == hole725 || goodSq y) = true := by
  rw [List.all_eq_true]
  intro y hy
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hy
  have h := List.all_eq_true.mp entryR_sites_goodB q hq
  rw [Bool.or_eq_true] at h ⊢
  rw [pmapR_fast]
  rcases h with e | e
  · left
    have h725 : hole725 = 4840 := StairHoleSupport.poolWire_eq 725 (by omega)
    rw [h725, Nat.eq_of_beq_eq_true e]
    rfl
  · exact Or.inr (goodSq_of_B e)

theorem host_good : goodSq host512 = true := by decide +kernel

theorem entryRH_good (k : Fp) : ∀ x ∈ wires (entryRH k), goodSq x = true := by
  have sup : wires (entryRH k) ⊆ (wires (entryR L0 k) \ (holesOf entryPairs).toFinset) ∪
      (hostsOf entryPairs).toFinset :=
    hostRename_support entryPairs (entryR L0 k) entryPairs_nodup (entryPairs_hostFree k)
  intro x hx
  rcases Finset.mem_union.mp (sup hx) with h | h
  · obtain ⟨h1, h2⟩ := Finset.mem_sdiff.mp h
    have hm := entryR_support k h1
    have t := List.all_eq_true.mp entryR_sites_good x (List.mem_toFinset.mp hm)
    have hne : x ≠ hole725 := by
      intro e
      apply h2
      rw [e]
      exact List.mem_toFinset.mpr (List.mem_singleton_self _)
    rw [beq_false_of_ne hne, Bool.false_or] at t
    exact t
  · have hm : x ∈ hostsOf entryPairs := List.mem_toFinset.mp h
    simp only [hostsOf, entryPairs, List.map_cons, List.map_nil, List.mem_singleton] at hm
    subst hm
    exact host_good

/-- Field 12, piece `square` tail: `entryRH` is inside the arena, avoids the old omissions and every
hole of any sublist of the 39. -/
theorem entryRH_pieceOK (holes : List Wire) (hsub : ∀ q ∈ holes, q ∈ StairCertificate.holes39)
    (k : Fp) : StairSiteAvoidance.PieceOK holes StairSiteAvoidance.UG (entryRH k) := by
  refine ⟨fun x hx => ?_, fun x hx hh => ?_⟩
  · have g := entryRH_good k x hx
    simp only [goodSq, Bool.and_eq_true, decide_eq_true_eq] at g
    rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq]
    exact ⟨g.1.1, g.1.2⟩
  · have g := entryRH_good k x hx
    simp only [goodSq, Bool.and_eq_true, decide_eq_true_eq] at g
    have := hsub _ hh
    rw [holes39_eq] at this
    exact g.2 this

theorem UG_fixes_holes39 : ∀ q ∈ holes39Nat, StairSiteAvoidance.UG q = q := by
  decide +kernel


end ECDSAAdd.Entrant.StairSquareEntryR

end
