  have notHist (q : Wire) (hq : q < start15E j + 16 ∨ start15E j + 30 < q) : q ∉ history15E j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi; unfold Wire at *; omega
  have notSM (q : Wire) (hq : q < b015E (start15E j) ∨ b015E (start15E j) + (lows15E (start15E j) - 1) ≤ q) : q ∉ smallM15E j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi; unfold Wire at *; omega
  have hv_bs (q : Wire) (hl : (q < a015E (start15E j) - 1 ∨ a015E (start15E j) + lows15E (start15E j) - 1 ≤ q) ∧
      (q < b015E (start15E j) - 1 ∨ b015E (start15E j) + lows15E (start15E j) - 1 ≤ q))
