private theorem of_rowSitesL {B : Nat} (hB : B ∈ budgets) {P : Program}
    (sub : ∀ q ∈ wires P, q ∈ StairPhysicalPrimitives.rowSitesL B) :
    ∀ q ∈ wires P, q ∉ ryWires :=
