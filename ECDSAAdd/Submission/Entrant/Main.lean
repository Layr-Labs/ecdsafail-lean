  have sc := K.R.scl1591_slots
  simp only [make,clear,KRegs.smk,KRegs.scl,KRegs.make,KRegs.clear,Challenge.gateSlots_append] at sc ⊢
  omega

end ECDSAAdd.Entrant.FrontierSumCleanup1591KG

