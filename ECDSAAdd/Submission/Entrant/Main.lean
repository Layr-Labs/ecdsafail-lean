  rw [(StairCallerEntry.head_pad_rest L hw hn cx cy X Y _ s hv.x hv.y hv.clean hg).run_eq d,
    (head_pad L hw hn cx cy X Y s hv.x hv.y hv.clean hg).run_eq d']
