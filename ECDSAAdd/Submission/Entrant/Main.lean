  · rcases Finset.mem_union.mp (hp used) with old|fresh
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ old)
    · exact Finset.mem_union_right _ fresh
  · rcases Finset.mem_union.mp (hq used) with old|fresh
