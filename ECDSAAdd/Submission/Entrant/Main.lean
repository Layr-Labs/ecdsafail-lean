  (q=1556 ∨ (q≠1556 ∧ q≠1557 ∧ q≠1558 ∧
   ((q∈Leave255CoreCheckpoint.targets ∧ q∉smallM) ∨ (∃i:Fin 14,q=live (113+i.val))))))
