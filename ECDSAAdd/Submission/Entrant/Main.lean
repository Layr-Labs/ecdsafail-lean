/-! ### Section 1: Tail Definitions & Structural Decomposition -/

def smallA15E (j : Fin 4) : List Wire := (List.range (lows15E (start15E j) - 1)).map (a015E (start15E j) + ·)
def smallM15E (j : Fin 4) : List Wire := (List.range (lows15E (start15E j) - 1)).map (b015E (start15E j) + ·)
def smallC15E (j : Fin 4) : List Wire := (List.range (lows15E (start15E j) - 2)).map (1559 + ·)
def borrowG4_15E (j : Fin 4) : Program :=
  [.CX (a015E (start15E j) - 1) 1557, .X 1557, .CCX (b015E (start15E j) - 1) 1557 1558]

def pendingPairs15E (j : Fin 4) : List (Wire × Wire) :=
  let s := start15E j; let L := lows15E s; let H := liveW15E s - L
  (List.range (H + 1)).map fun k =>
    (if k = 0 then a015E s + L - 2 else bankW15E s (L + k - 1), storeW15E s (k + 1))

def clearFlagPairs15E (j : Fin 4) : List (Wire × Wire) :=
  (List.range (lows15E (start15E j))).map fun k => (b015E (start15E j) - 1 + k, 1559 + k)

def low15E (j : Fin 4) : List (Wire × Wire) :=
  (List.range (lows15E (start15E j))).map fun i => (a015E (start15E j) - 1 + i, b015E (start15E j) - 1 + i)

def fullProg15E (j : Fin 4) : Program :=
  core15EProg j ++ (borrowG4_15E j ++ Companion.restore (smallA15E j) (smallM15E j) (smallC15E j) 1556 1558)

def beforeStore15E (j : Fin 4) : Program :=
  fullProg15E j ++ (releaseMaskP15E j ++ GateMirror.forward (leaveStoreMapped15E (start15E j)))

def storeMapped15E (j : Fin 4) : Program :=
  beforeStore15E j ++ GateMirror.forward (leaveLowClose15E (start15E j))

theorem lowStore15E_parts (j : Fin 4) :
    GateMirror.forward (leaveLowStore15E (start15E j)) =
      GateMirror.forward (lowSign15E (start15E j)) ++
      (borrowG4_15E j ++ (Companion.restore (smallA15E j) (smallM15E j) (smallC15E j) 1556 1558 ++ releaseMaskP15E j)) := by
  have hc : GateMirror.forward ((List.range (lows15E (start15E j) - 1)).map
      fun i => Gate.make 1556 (a015E (start15E j) + i) (b015E (start15E j) + i)) =
      copyRegister (some 1556) (smallA15E j) (smallM15E j) := by
    rw [smallA15E, smallM15E, LeaveJ7.copy_map]; simp only [GateMirror.forward, List.map_map]; rfl
  simp only [leaveLowStore15E, lowSign15E, borrowG4_15E, releaseMaskP15E, forward_app, forward_addG, LeaveJ7.forward_xsG', hc,
    Companion.restore, HighBankUnit.sub, mappedSub, smallM15E, smallC15E, List.append_assoc]
  rfl

private theorem forward_chainG15E (c seq : Nat → Wire) (out : Wire) : ∀ (i n : Nat),
    GateMirror.forward (chainG c seq [.cx (c (i + n)) out, .x out] i n) =
      PortalAnd.chain true none out (c i) ((List.range n).map fun k => (seq (i + k), c (i + k + 1)))
  | i, 0 => by simp [chainG, PortalAnd.chain, PortalAnd.target, GateMirror.forward, front]
  | i, n + 1 => by
    have ih := forward_chainG15E c seq out (i + 1) n
    rw [show i + 1 + n = i + (n + 1) by omega] at ih
    have el : (List.range (n + 1)).map (fun k => (seq (i + k), c (i + k + 1))) =
        (seq i, c (i + 1)) :: (List.range n).map (fun k => (seq (i + 1 + k), c (i + 1 + k + 1))) := by
      rw [List.range_succ_eq_map, List.map_cons, List.map_map]
      refine congrArg₂ List.cons rfl (List.map_congr_left fun k _ => ?_)
      show (seq (i + (k + 1)), c (i + (k + 1) + 1)) = (seq (i + 1 + k), c (i + 1 + k + 1))
      rw [show i + (k + 1) = i + 1 + k by omega]
    show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) ::
      (chainG c seq [.cx (c (i + (n + 1))) out, .x out] (i + 1) n ++ [.pop (c i) (seq i) (c (i + 1))])) = _
    rw [show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) :: _) =
      front (.make (c i) (seq i) (c (i + 1))) :: GateMirror.forward _ from rfl,
      forward_app, ih, el]; rfl

theorem storeMapped15E_parts (j : Fin 4) :
    GateMirror.forward (leaveStoreMapped15E (start15E j)) =
      latch true none 1557 1558 (pendingPairs15E j) ++
        ([.CCX 1556 1557 1558] ++ latch true none 1556 1558 (clearFlagPairs15E j)) := by
  have hsw0 : storeW15E (start15E j) 0 = 1558 := by revert j; decide +kernel
  have ch1 := forward_chainG15E (storeW15E (start15E j))
    (fun i => if i = 0 then a015E (start15E j) + lows15E (start15E j) - 2 else bankW15E (start15E j) (lows15E (start15E j) + i - 1))
    1557 0 (liveW15E (start15E j) - lows15E (start15E j) + 1)
  simp only [Nat.zero_add, hsw0] at ch1
  change _ = PortalAnd.chain true none 1557 1558 (pendingPairs15E j) at ch1
  have ch2 := forward_chainG15E (fun i => (1558 + i : Wire)) (fun i => b015E (start15E j) - 1 + i)
    1556 0 (lows15E (start15E j))
  simp only [Nat.zero_add, Nat.add_zero] at ch2
  have e2 : (List.range (lows15E (start15E j))).map (fun k => (b015E (start15E j) - 1 + k, (1558 + (k + 1) : Wire))) =
      clearFlagPairs15E j := by
    simp only [clearFlagPairs15E]; apply List.map_congr_left; intro k _; simp only [Prod.mk.injEq, true_and]; (try unfold Wire); omega
  rw [e2] at ch2
  have pf : (pendingPairs15E j).map Prod.fst =
      (a015E (start15E j) + lows15E (start15E j) - 2) ::
        (List.range (liveW15E (start15E j) - lows15E (start15E j))).map (fun i => bankW15E (start15E j) (lows15E (start15E j) + i)) := by
    simp only [pendingPairs15E, List.map_map, Function.comp]
    rw [List.range_succ_eq_map, List.map_cons, List.map_map]
    simp only [Function.comp, if_pos, Nat.succ_ne_zero, if_false]; congr 1
  have cf : (clearFlagPairs15E j).map Prod.fst = (List.range (lows15E (start15E j))).map (b015E (start15E j) - 1 + ·) := by
    simp only [clearFlagPairs15E, List.map_map]; rfl
  have fc (g : Gate) (gs : List Gate) : GateMirror.forward (g :: gs) = front g :: GateMirror.forward gs := rfl
  have fn : GateMirror.forward [] = [] := rfl
  simp only [leaveStoreMapped15E, forward_app, LeaveJ7.forward_xsG', ch1, ch2, PortalAnd.latch, PortalAnd.digits,
    pf, cf, fc, fn, front, GateMirror.erase, notRegister, List.map_cons, List.map_nil,
    List.map_append, List.reverse_cons, List.append_assoc, List.cons_append, List.singleton_append, List.nil_append,
    if_true, ↓reduceIte]

theorem lowClose15E_parts (j : Fin 4) :
    GateMirror.forward (leaveLowClose15E (start15E j)) =
      notRegister (history15E j) ++ RailPair.store (start15E j + 30) (e015E (start15E j) + 5) (low15E j) [] := by
  have e1 : GateMirror.forward ((List.range (lows15E (start15E j))).map
      fun i => Gate.cx (e015E (start15E j) + 5) (b015E (start15E j) - 1 + i)) =
      signComplement (e015E (start15E j) + 5) ((low15E j).map Prod.snd) := by
    simp only [GateMirror.forward, signComplement, low15E, List.map_map]; rfl
  have e2 : GateMirror.forward ((List.range (lows15E (start15E j))).flatMap
      fun i => cswapG (start15E j + 30) (b015E (start15E j) - 1 + i) (a015E (start15E j) - 1 + i)) =
      exchange (start15E j + 30) (low15E j) := by
    simp only [GateMirror.forward, exchange, low15E, List.map_flatMap, List.flatMap_map]; rfl
  simp only [leaveLowClose15E, forward_app, LeaveJ7.forward_xsG', e1, e2, RailPair.store, RailPair.transfer,
    List.flatMap_nil, List.nil_append, List.append_assoc]
  rfl

theorem close15E_parts (j : Fin 4) :
    GateMirror.forward (leaveClose15E (start15E j)) =
      GateMirror.forward (closeFlag15E (start15E j)) ++ LeaveRelocation.program (moves15E (start15E j)) := by
  have hsw : ∀ ps : List (Wire × Wire), GateMirror.forward (swapsG ps) = LeaveRelocation.program ps := by
    intro ps; induction ps with
    | nil => rfl
    | cons p ps ih =>
      show GateMirror.forward ([.cx p.1 p.2, .cx p.2 p.1, .cx p.1 p.2] ++ swapsG ps) =
        [.CX p.1 p.2, .CX p.2 p.1, .CX p.1 p.2] ++ LeaveRelocation.program ps
      rw [forward_app, ih]; rfl
  unfold leaveClose15E; rw [forward_app, hsw]

theorem leaveUnred15E_split (j : Fin 4) :
    leaveUnred15E j = storeMapped15E j ++ GateMirror.forward (leaveClose15E (start15E j)) := by
  unfold leaveUnred15E storeMapped15E beforeStore15E fullProg15E core15EProg afterPart15E
  simp only [forward_app, lowStore15E_parts j, List.append_assoc]

/-! ### Section 2: Geometry, Next-Block Flag Arithmetic & Low Close -/

theorem pending15E_geo : ∀ j : Fin 4,
    (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs15E j)).Nodup ∧
    (1556 :: (1558 : Wire) :: PortalAnd.sites (clearFlagPairs15E j)).Nodup ∧
    Companion.Geometry (smallA15E j) (smallM15E j) (smallC15E j) 1556 1558 ∧
    RailPair.StoreGeometry (start15E j + 30) (e015E (start15E j) + 5) (low15E j) [] ∧
    (∀ p ∈ pendingPairs15E j, (1559 ≤ (p.2 : Nat) ∧ (p.2 : Nat) ≤ 1597) ∨
      (p.2 ∈ carries15E j ∧ 1613 ≤ (p.2 : Nat) ∧ ((p.2 : Nat) < e015E (start15E j) ∨ e015E (start15E j) + 10 ≤ (p.2 : Nat)))) ∧
    (∀ p ∈ clearFlagPairs15E j, 1559 ≤ (p.2 : Nat) ∧ (p.2 : Nat) ≤ 1597) ∧
    (∀ r : Fin 5, (closeRecs15E (start15E j)).getD r.val 0 = swaps15E j r.val) ∧
    (1556 : Wire) ∉ closeRecs15E (start15E j) ∧ (e015E (start15E j) + 4 : Wire) ∉ closeRecs15E (start15E j) ∧
    (∀ p ∈ moves15E (start15E j), p.1 ≠ p.2) := by
  intro j
  refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    revert j <;> decide +kernel

theorem tail15E_geom : ∀ j : Fin 4,
    let s := start15E j
    sb15E s + lows15E s = sb15E (s + 15) + 17 ∧
    (sb15E s = sb15E (s + 15) + 7 ∨ sb15E s = sb15E (s + 15) + 8) ∧
    lows15E s + (nextWp15E s - 2) = railP (s + 15) - sb15E s ∧
    b015E s + lows15E s - 1 = bTopP (s + 15) + 3 - nextWp15E s ∧
    railP (s + 15) - (sb15E s + lows15E s) = nextWp15E s - 2 ∧
    lows15E s + (nextWp15E s - 2) ≤ wp15E s + 15 ∧
    1610 ≤ e015E (s + 15) ∧ e015E (s + 15) + 7 ≤ e015E s ∧
    bTopP s ≤ 1043 ∧ bTopP (s + 15) ≤ bTopP s ∧
    bTopP s + 1 - wp15E s = b015E s + 14 := by
  decide +kernel

theorem moves15E_targets : ∀ j : Fin 4,
    LeaveRelocation.source (moves15E (start15E j)) (e015E (start15E j + 15) + 3) = 1557 ∧
    LeaveRelocation.source (moves15E (start15E j)) (e015E (start15E j + 15) + 4) = 1558 ∧
    LeaveRelocation.source (moves15E (start15E j)) (e015E (start15E j + 15) + 5) = e015E (start15E j) + 5 ∧
    LeaveRelocation.source (moves15E (start15E j)) (e015E (start15E j + 15) + 6) = e015E (start15E j) + 3 ∧
    LeaveRelocation.source (moves15E (start15E j)) (e015E (start15E j + 15) + 7) = e015E (start15E j) + 7 ∧
    LeaveRelocation.source (moves15E (start15E j)) (e015E (start15E j + 15) + 8) = e015E (start15E j) + 6 ∧
    (∀ i : Fin (nextWp15E (start15E j) - 2),
      LeaveRelocation.source (moves15E (start15E j)) (b015E (start15E j) + lows15E (start15E j) - 1 + i.val) =
        bankW15E (start15E j) (lows15E (start15E j) + i.val) ∧
      LeaveRelocation.source (moves15E (start15E j)) (a015E (start15E j) + lows15E (start15E j) - 1 + i.val) =
        a015E (start15E j) + lows15E (start15E j) - 1 + i.val) ∧
    (∀ i : Fin (lows15E (start15E j)),
      LeaveRelocation.source (moves15E (start15E j)) (a015E (start15E j) - 1 + i.val) = a015E (start15E j) - 1 + i.val ∧
      LeaveRelocation.source (moves15E (start15E j)) (b015E (start15E j) - 1 + i.val) = b015E (start15E j) - 1 + i.val) ∧
    (∀ i : Fin 15, LeaveRelocation.source (moves15E (start15E j)) (start15E j + 16 + i.val) = start15E j + 16 + i.val) := by
  decide +kernel

private theorem nextFlag15E_orientation (j : Fin 4) (a : SkywalkNat.State) (sign : Nat) (bit : sign ≤ 1)
    (small : Shadow7.SmallIfFar (sb15E (start15E j + 15)) 15 a)
    (hfar : far (sb15E (start15E j + 15)) 15 a) :
    (2 ^ sb15E (start15E j) ≤ a.u - sign) ↔ (2 ^ sb15E (start15E j + 15) ≤ a.u) := by
  have hsm := small hfar
  have tg := tail15E_geom j; dsimp only at tg
  have lower := (Nat.le_div_iff_mul_le (by unfold limb; positivity : 0 < limb (sb15E (start15E j + 15)) 15)).mp hfar
  unfold limb at lower
  have hpow : 2 ^ (sb15E (start15E j + 15) + 15) = 32768 * 2 ^ sb15E (start15E j + 15) := by
    rw [Nat.pow_add, Nat.mul_comm]
  rw [hpow] at lower
  rcases tg.2.1 with h7 | h8
  · have p1 : 2 ^ sb15E (start15E j) = 128 * 2 ^ sb15E (start15E j + 15) := by rw [h7, Nat.pow_add, Nat.mul_comm]
    rw [p1]; generalize 2 ^ sb15E (start15E j + 15) = P at *; constructor <;> intro h <;> omega
  · have p1 : 2 ^ sb15E (start15E j) = 256 * 2 ^ sb15E (start15E j + 15) := by rw [h8, Nat.pow_add, Nat.mul_comm]
    rw [p1]; generalize 2 ^ sb15E (start15E j + 15) = P at *; constructor <;> intro h <;> omega

private theorem nextFlag15E_boundNear (j : Fin 4) (a : SkywalkNat.State) (sign : Nat)
    (near : ¬ far (sb15E (start15E j + 15)) 15 a) :
    a.u - sign < (2 * 2 ^ sb15E (start15E j)) * 2 ^ (smallM15E j).length := by
  have tg := tail15E_geom j; dsimp only at tg
  apply LeaveJ7.near_bound17 a.u a.v sign (limb (sb15E (start15E j + 15)) 15) _ (by unfold limb; positivity) _ near
  have hg := geom15E_facts j
  rw [show (smallM15E j).length = lows15E (start15E j) - 1 by simp [smallM15E]]; unfold limb
  have e : 2 * 2 ^ sb15E (start15E j) * 2 ^ (lows15E (start15E j) - 1) = 2 ^ (sb15E (start15E j + 15) + 15) * 2 ^ 2 := by
    rw [← Nat.pow_succ', ← Nat.pow_add, ← Nat.pow_add]; congr 1; omega
  rw [e]; omega

private theorem clearFlag15E_digits (j : Fin 4) :
    PortalAnd.digits 1558 (clearFlagPairs15E j) = 1558 :: (b015E (start15E j) - 1) :: smallM15E j := by
  have hg := geom15E_facts j
  have hl : lows15E (start15E j) = (lows15E (start15E j) - 1) + 1 := by omega
  simp only [PortalAnd.digits, clearFlagPairs15E, smallM15E, List.map_map, Function.comp]
  conv_lhs => rw [hl, List.range_succ_eq_map]
  rw [List.map_cons, List.map_map]
  simp only [Function.comp, Nat.add_zero]; congr 2
  apply List.map_congr_left; intro i _
  show b015E (start15E j) - 1 + (i + 1) = b015E (start15E j) + i; unfold b015E; omega

private theorem pending15E_eval (j : Fin 4) (v : BasisState) (F : Nat) (hF : F < 2 ^ liveW15E (start15E j))
    (hbits : ∀ i < liveW15E (start15E j), v (live15E j i) = F.testBit i) (h58 : v 1558 = false) :
    (PortalAnd.digits 1558 (pendingPairs15E j)).any v = decide (1 ≤ F / 2 ^ (lows15E (start15E j) - 1)) := by
  have hg := geom15E_facts j
  simp only [PortalAnd.digits, List.any_cons, h58, Bool.false_or]
  have hval := EnterProof.value_of_bits ((pendingPairs15E j).map Prod.fst) v (F / 2 ^ (lows15E (start15E j) - 1)) (by
    intro i hi
    have hlen : ((pendingPairs15E j).map Prod.fst).length = liveW15E (start15E j) - lows15E (start15E j) + 1 := by simp [pendingPairs15E]
    rw [hlen] at hi
    have hget : ((pendingPairs15E j).map Prod.fst).getD i 0 = live15E j (lows15E (start15E j) - 1 + i) := by
      simp only [pendingPairs15E, List.map_map, Function.comp, List.getD_eq_getElem?_getD, List.getElem?_map,
        List.getElem?_range hi, Option.map_some, Option.getD_some]
      have hl : 9 ≤ lows15E (start15E j) := hg.2.2.2.2.2.2.2.2.1
      by_cases iz : i = 0
      · subst iz; simp only [if_true, Nat.add_zero, live15E, if_pos (by omega : lows15E (start15E j) - 1 < lows15E (start15E j))]
        unfold a015E Wire; omega
      · simp only [iz, if_false, live15E, if_neg (by omega : ¬ (lows15E (start15E j) - 1 + i < lows15E (start15E j)))]
        congr 1; omega
    rw [hget, hbits _ (by omega), Nat.testBit_div_two_pow, Nat.add_comm])
  have hlt : F / 2 ^ (lows15E (start15E j) - 1) < 2 ^ ((pendingPairs15E j).map Prod.fst).length := by
    rw [show ((pendingPairs15E j).map Prod.fst).length = liveW15E (start15E j) - lows15E (start15E j) + 1 by simp [pendingPairs15E]]
    apply (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr
    rw [← Nat.pow_add, show liveW15E (start15E j) - lows15E (start15E j) + 1 + (lows15E (start15E j) - 1) = liveW15E (start15E j) by omega]
    exact hF
  rw [Nat.mod_eq_of_lt hlt] at hval; rw [LeaveCompanion.any_positive, hval]
  exact Bool.eq_iff_iff.mpr (by simp only [decide_eq_true_eq]; omega)

private theorem pending15E_far (j : Fin 4) (z : SkywalkNat.State) :
    (1 ≤ TrueMiddle15E.F j z / 2 ^ (lows15E (start15E j) - 1)) ↔
      far (sb15E (start15E j + 15)) 15 (step^[15] z) := by
  have hg := geom15E_facts j
  have tg := tail15E_geom j; dsimp only at tg
  unfold TrueMiddle15E.F HighBankSum.total far Shadow.high limb
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]
  have e : 2 ^ (sb15E (start15E j) + (lows15E (start15E j) - 1)) =
      2 * 2 ^ (sb15E (start15E j + 15) + 15) := by
    rw [show sb15E (start15E j) + (lows15E (start15E j) - 1) = (sb15E (start15E j + 15) + 15) + 1 by omega,
      Nat.pow_succ, Nat.mul_comm]
