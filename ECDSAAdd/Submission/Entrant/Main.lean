theorem selPrefix15E_run (j : Fin 4) (s : State) (m : List Bool) (v : BasisState)
    (small : Nat) (k : Mode)
    (mode : k = farMode (s.basis (e015E (start15E j) + 3)) (s.basis (e015E (start15E j) + 4)) small)
    (a : s.basis 1559 = false) (b : s.basis 1560 = false)
    (input : ∀ q, q ≠ 1559 → q ≠ 1560 → s.basis q = (before (ports15E j) false k q).read v)
    (exchange : LeaveSelector.right k = true → ∀ i < 15, i ≤ key k → s.basis (swaps15E j i) = decide (i = key k)) :
    run (GateMirror.forward (leaveFix3 (start15E j) (sb15E (start15E j)) ++
      leaveFix4 (start15E j) (sb15E (start15E j)) ++ leaveFix5Move15E (start15E j))) m s =
      MoveChain.clrAll (e015E (start15E j) + 6) (moveRows15E (start15E j))
        ⟨s.phase, fun q => (sim (prepare15E j) (LeaveSelector.start (ports15E j) false k) q).read v⟩ := by
  have hmg := move15E_geom j
  have hsp := selPrefix15E_split j
  have hsp0 := selPrefix15E_fullSplit j
  have hnot := selPrefix15E_notTargets j
  let preG := leaveFix3 (start15E j) (sb15E (start15E j)) ++ leaveFix4 (start15E j) (sb15E (start15E j)) ++
    (Shadow7.fix5P (start15E j) (sb15E (start15E j))).take 27
  let postG := (Shadow7.fix5P (start15E j) (sb15E (start15E j))).drop 43
  let stPre := run (GateMirror.forward preG) m s
  have hfull := sel15E_prepared j s m v small k mode a b input exchange
  have hq : stPre.basis (e015E (start15E j) + 6) = false := by
    have hq0 : s.basis (e015E (start15E j) + 6) = false := by
      have hg := geom15E_facts j
      have hbf : ∀ (r : Fin 4) (m' : Mode), before (ports15E r) false m' (e015E (start15E r) + 6) = .bit false := by
        decide +kernel
      rw [input _ (by unfold Wire; omega) (by unfold Wire; omega), hbf j k]; rfl
    exact (Shadow20.CRTUtil.FlagCut.keeps_of_targets _ _ (fun g hg =>
      of_decide_eq_true (List.all_eq_true.mp hnot.1 g hg)) _ s).trans hq0
  have hsel : ∀ r ∈ moveRows15E (start15E j), stPre.basis r.1 = true → r.2 = a015E (start15E j) - 1 + key k := by
    intro r hr hhot
    have hr' : r ∈ (List.range 16).map (fun i => (tagsP.getD i 0, a015E (start15E j) - 1 + i)) := by
      simpa only [moveRows15E] using hr
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hr'; rw [List.mem_range] at hi
    have htg : tagsP.getD i 0 ∈ tagsP := by
      have : ∀ idx : Fin 16, tagsP.getD idx.val 0 ∈ tagsP := by decide
      exact this ⟨i, hi⟩
    have hstay := Shadow20.CRTUtil.FlagCut.keeps_of_targets _ (tagsP.getD i 0)
      (fun g hg => of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp hnot.2 g hg) _ htg))
    have hfull_tag : (run (GateMirror.forward (fullPrefix15E j)) m s).basis (tagsP.getD i 0) =
        (enabled k && decide (i = key k)) := by
      rw [hfull]; exact congrArg (Expr.read v) (sel15E_tagCert j k ⟨i, hi⟩)
    rw [hsp0, List.append_assoc, forward_app, run_append, run_take, hstay, hhot] at hfull_tag
    have hkeq : i = key k := of_decide_eq_true (Bool.and_eq_true_iff.mp hfull_tag.symm).2
    rw [hkeq]
  have hrow_fwd := rowGates_fwd15E (e015E (start15E j) + 6) (moveRows15E (start15E j))
  have hmc_rows := MoveChain.rows_count (e015E (start15E j) + 6) (moveRows15E (start15E j))
  have hm1 : measurementCount (MoveChain.mux (e015E (start15E j) + 6) (moveRows15E (start15E j))) = 0 :=
    MoveChain.mux_count _ _
  have hm2 : measurementCount (GateMirror.forward postG) = 0 := hmg.2.2.2.2.2
  rw [hsp, forward_app, forward_app, run_append, run_take, run_append, run_take, hrow_fwd]
  rw [MoveChain.moved _ _ _ _ (a015E (start15E j) - 1 + key k) hmg.1 hmg.2.1 hq hsel,
    MoveChain.commAll _ _ _ hmg.2.2.1]
  congr 1
  rw [← hfull, hsp0]
  conv_rhs => rw [forward_app, run_append, run_take, forward_app, run_append, run_take, hmg.2.2.2.1]
  simp only [measurementCount_append, hmc_rows, hm1, Nat.add_zero]
  rfl

