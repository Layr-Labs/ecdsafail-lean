    (r : LeaveSelector.right k = (v (e015E (start15E j) + 3) && !v (e015E (start15E j) + 4)))
    (exchange : LeaveSelector.right k = true → ∀ i < 15, i ≤ key k → v (swaps15E j i) = decide (i = key k)) :
    run (GateMirror.forward (leaveFix11 (start15E j) (sb15E (start15E j)) ++ leaveFix12 (start15E j) (sb15E (start15E j)) ++
      lowSign15E (start15E j))) m s =
      ⟨s.phase, clearKey (fun q => (restored (ports15E j) false k q).read v)⟩ := by
  have hs := sel15E_shapes j; have hg := geom15E_facts j
  rw [hs.2.1]
