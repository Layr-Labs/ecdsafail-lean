theorem lowClose15E_result (j : Fin 4) (s v : State) (m : List Bool) (G sign : Bool)
    (sum mag : Nat) (previous : s.basis (start15E j + 30) = G)
    (hist : ∀ q ∈ history15E j, v.basis q = !s.basis q)
    (signed : v.basis (e015E (start15E j) + 5) = sign)
    (words : ∀ i : Fin (lows15E (start15E j)),
      v.basis (a015E (start15E j) - 1 + i.val) = sum.testBit (sb15E (start15E j) + i.val) ∧
      v.basis (b015E (start15E j) - 1 + i.val) = mag.testBit (sb15E (start15E j) + i.val)) :
    let out := run (GateMirror.forward (leaveLowClose15E (start15E j))) m v
    out.phase = v.phase ∧ (∀ q ∈ history15E j, out.basis q = s.basis q) ∧
    (∀ i : Fin (lows15E (start15E j)),
      let pos := sum.testBit (sb15E (start15E j) + i.val)
      let neg := mag.testBit (sb15E (start15E j) + i.val) ^^ sign
      out.basis (a015E (start15E j) - 1 + i.val) = (if G then neg else pos) ∧
      out.basis (b015E (start15E j) - 1 + i.val) = (if G then pos else neg)) ∧
    ∀ q, q ∉ RailPair.sites (low15E j) → q ∉ history15E j → out.basis q = v.basis q := by
  have hg := geom15E_facts j
  have hnd : (history15E j).Nodup := List.Nodup.map (fun _ _ e => Nat.add_left_cancel e) List.nodup_range
  have act := RailPair.store_run (start15E j + 30) (e015E (start15E j) + 5) (low15E j) [] (pending15E_geo j).2.2.2.1
    ⟨v.phase, fun q => if q ∈ history15E j then !v.basis q else v.basis q⟩
    (m.drop (measurementCount (notRegister (history15E j)))) (by simp)
  have inHist : (start15E j + 30 : Wire) ∈ history15E j := List.mem_map.mpr ⟨14, List.mem_range.mpr (by decide), rfl⟩
  have notHist (q : Nat) (hq : q < start15E j + 16 ∨ start15E j + 30 < q) : (q : Wire) ∉ history15E j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi; unfold Wire at *; omega
  have sep : ∀ a ∈ history15E j, a ∉ RailPair.sites (low15E j) := by
    intro a ha hm; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp ha; rw [List.mem_range] at hi
    obtain ⟨p, hp, hq⟩ := List.mem_flatMap.mp hm; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with e | e <;> (unfold a015E b015E at *; (try unfold Wire at *); omega)
  dsimp only
  rw [lowClose15E_parts j, run_append, run_take, notRegister_correct _ hnd]
  refine ⟨act.1, ?_, ?_, fun q lo hn => (act.2.1 q lo (by simp [RailPair.sites])).trans (if_neg hn)⟩
  · intro q hq; rw [act.2.1 q (sep q hq) (by simp [RailPair.sites])]; dsimp only; rw [if_pos hq, hist q hq, Bool.not_not]
  · intro i
    have mem : (a015E (start15E j) - 1 + i.val, b015E (start15E j) - 1 + i.val) ∈ low15E j :=
      List.mem_map.mpr ⟨i.val, List.mem_range.mpr i.isLt, rfl⟩
    have l := act.2.2.2 _ mem
    simp only [if_pos inHist, hist _ inHist, Bool.not_not, previous,
      if_neg (notHist (e015E (start15E j) + 5) (by omega)), signed,
      if_neg (notHist (a015E (start15E j) - 1 + i.val) (by unfold a015E; omega)),
      if_neg (notHist (b015E (start15E j) - 1 + i.val) (by unfold b015E; omega)),
      (words i).1, (words i).2] at l
    exact l

