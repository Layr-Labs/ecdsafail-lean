theorem archives_not_fieldR : ∀ (b : StockArchiveBanks.Bank) (i : Fin 16),
    StockArchiveBanks.siteAt b i ∉ fieldR := by
  have h : ∀ (b : StockArchiveBanks.Bank) (i : Fin 16),
      notFieldR (StockArchiveBanks.siteAt b i) = true := by decide +kernel
