private theorem pack15E_geom : ∀ j : Fin 4,
    (j.val = 0 →
      (∀ a b : Fin 10, hist15E 365 345 a = hist15E 365 345 b → a = b) ∧
      (∀ a b : Fin 10, hist15E 365 350 a = hist15E 365 350 b → a = b) ∧
      (∀ i : Fin 10, hist15E 365 345 i ∈ support15E j ∧ hist15E 365 350 i ∈ support15E j) ∧
      (∀ a b : Fin 10, hist15E 365 345 a ≠ hist15E 365 350 b) ∧
      (∀ r : Fin 5,
        hist15E 365 345 ⟨2 * r.val, by omega⟩ = windowNet20 k9 (IntegerPacket.ports (shape20 k9) r.val).a0 ∧
        hist15E 365 345 ⟨2 * r.val + 1, by omega⟩ = windowNet20 k9 (IntegerPacket.ports (shape20 k9) r.val).history ∧
        hist15E 365 350 ⟨2 * r.val, by omega⟩ = windowNet20 k9 (IntegerPacket.ports (shape20 k9) (5 + r.val)).a0 ∧
        hist15E 365 350 ⟨2 * r.val + 1, by omega⟩ = windowNet20 k9 (IntegerPacket.ports (shape20 k9) (5 + r.val)).history) ∧
      (∀ i : Fin 10, FirstFree15E j (windowNet15E j (hist15E 365 345 i)) ∧ hist15E 365 345 i ∉ EnterJ15E.ports j ∧
        FirstFree15E j (windowNet15E j (hist15E 365 350 i)) ∧ hist15E 365 350 i ∉ EnterJ15E.ports j)) ∧
    (j.val ≠ 0 →
      (∀ a b : Fin 10, hist15E (start15E j) (start15E j - 15) a = hist15E (start15E j) (start15E j - 15) b → a = b) ∧
      (∀ i : Fin 10, hist15E (start15E j) (start15E j - 15) i ∈ support15E j ∧
        FirstFree15E j (windowNet15E j (hist15E (start15E j) (start15E j - 15) i)) ∧ hist15E (start15E j) (start15E j - 15) i ∉ EnterJ15E.ports j) ∧
      (∀ r : Fin 5,
        hist15E (start15E j) (start15E j - 15) ⟨2 * r.val, by omega⟩ =
          windowNet15E ⟨j.val - 1, Nat.lt_of_le_of_lt (Nat.sub_le _ _) j.isLt⟩
            (IntegerPacket.ports (shape15E ⟨j.val - 1, Nat.lt_of_le_of_lt (Nat.sub_le _ _) j.isLt⟩) r.val).a0 ∧
        hist15E (start15E j) (start15E j - 15) ⟨2 * r.val + 1, by omega⟩ =
          windowNet15E ⟨j.val - 1, Nat.lt_of_le_of_lt (Nat.sub_le _ _) j.isLt⟩
            (IntegerPacket.ports (shape15E ⟨j.val - 1, Nat.lt_of_le_of_lt (Nat.sub_le _ _) j.isLt⟩) r.val).history)) ∧
    (∀ q ∈ prevRawHead15E j, FirstFree15E j (windowNet15E j q) ∧
      (q ∉ EnterJ15E.ports j ∨ q = EnterJ15E.gate j) ∧ q ∉ support15E j) ∧
    (watch15E j).all (fun q => decide (q ∉ support15E j ∧ q ∉ prevRawHead15E j)) = true := by
  intro j
  refine ⟨?_, ?_, ?_, ?_⟩
  · fin_cases j <;> (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · fin_cases j <;> (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  · have h3 : (List.finRange 4).all (fun k => (prevRawHead15E k).all (fun q =>
        decide (FirstFree15E k (windowNet15E k q) ∧ (q ∉ EnterJ15E.ports k ∨ q = EnterJ15E.gate k) ∧ q ∉ support15E k))) = true := by
      clear j
      (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    intro q hq
    exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp h3 j (List.mem_finRange j)) q hq)
  · fin_cases j <;> (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem pack_eq15E (s t : Nat) (ht5 : t ≠ 5) (hd : History5.packDue t = true) (d : Bool) :
    packW d s t = Rolling1588.codeEncodeAt d (hist15E s (t - 5)) ∧
    unpackW d s t = Rolling1588.codeDecodeAt d (hist15E s (t - 5)) := by
  have labEq : ∀ q ∈ Finset.range 10,
      (OB5.sig s ∘ MeasuredCodec5.label (History5.historyMap base (t - 5))) q =
        MeasuredCodec5.label (hist15E s (t - 5)) q := by
    intro q hq; have lt := Finset.mem_range.mp hq
    simp only [Function.comp, MeasuredCodec5.label, dif_pos lt, hist15E]
  refine ⟨?_, ?_⟩
  · unfold packW Rolling1588.packAtTick Rolling1588.codeEncodeAt
    rw [if_neg ht5]; simp only [hd, ↓reduceIte, renameProgram_comp]
    exact renameProgram_congr_support _ _ _ (fun q hq => labEq q ((Rolling1588.code_support d).1 ▸ hq))
  · unfold unpackW Rolling1588.unpackAtTick Rolling1588.codeDecodeAt
    rw [if_neg ht5]; simp only [hd, ↓reduceIte, renameProgram_comp]
    exact renameProgram_congr_support _ _ _ (fun q hq => labEq q ((Rolling1588.code_support d).2 ▸ hq))

theorem pack_codes15E (j : Fin 4) (d : Bool) :
    wires (packProg15E j d) ⊆ (support15E j).toFinset ∧
    wires (packRev15E j d) ⊆ (support15E j).toFinset := by
  have cover (h : Fin 10 → Wire) (hs : ∀ i, h i ∈ support15E j) :
      wires (Rolling1588.codeEncodeAt d h) ⊆ (support15E j).toFinset ∧
      wires (Rolling1588.codeDecodeAt d h) ⊆ (support15E j).toFinset := by
    rw [Rolling1588.codeEncodeAt, Rolling1588.codeDecodeAt, renameProgram_support, renameProgram_support,
      (Rolling1588.code_support d).1, (Rolling1588.code_support d).2]
    have img : Finset.image (MeasuredCodec5.label h) (Finset.range 10) ⊆ (support15E j).toFinset := by
      intro q hq; obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      have lt := Finset.mem_range.mp hw
      simp only [MeasuredCodec5.label, dif_pos lt, List.mem_toFinset]; exact hs ⟨w, lt⟩
    exact ⟨img, img⟩
  have pg := pack15E_geom j
  unfold packProg15E packRev15E
  split_ifs with h0
  · have e1 := pack_eq15E 365 350 (by decide) (by decide) d
    have e2 := pack_eq15E 365 355 (by decide) (by decide) d
    have c1 := cover (hist15E 365 345) (fun i => ((pg.1 h0).2.2.1 i).1)
    have c2 := cover (hist15E 365 350) (fun i => ((pg.1 h0).2.2.1 i).2)
    rw [wires_append, wires_append, e1.1, e1.2, e2.1, e2.2]
    exact ⟨Finset.union_subset c1.1 c2.1, Finset.union_subset c2.2 c1.2⟩
  · have h5 : start15E j - 10 ≠ 5 := by unfold start15E; omega
    have hd : History5.packDue (start15E j - 10) = true := by
      simp only [History5.packDue, start15E, decide_eq_true_eq]; omega
    have e := pack_eq15E (start15E j) (start15E j - 10) h5 hd d
    rw [show start15E j - 10 - 5 = start15E j - 15 by unfold start15E; omega] at e
    have c := cover (hist15E (start15E j) (start15E j - 15)) (fun i => ((pg.2.1 h0).2.1 i).1)
    rw [e.1, e.2]; exact c

theorem pack_retains15E (j : Fin 4) (d : Bool) (s : State) (m : List Bool) :
    ∀ q ∈ watch15E j, (run (packProg15E j d) m s).basis q = s.basis q := fun q hq =>
  run_preserves_outside _ m s q fun hit =>
    (of_decide_eq_true (List.all_eq_true.mp (pack15E_geom j).2.2.2 q hq)).1
      (List.mem_toFinset.mp ((pack_codes15E j d).1 hit))

theorem pack_source_law15E (j : Fin 4) (d : Bool) (s : State) (m : List Bool)
    (ok : if j.val = 0 then MeasuredCodec5.legalAt (hist15E 365 345) s.basis ∧ MeasuredCodec5.legalAt (hist15E 365 350) s.basis
          else MeasuredCodec5.legalAt (hist15E (start15E j) (start15E j - 15)) s.basis) :
    (run (packProg15E j d) m s).phase = s.phase ∧
    ∀ t, run (packRev15E j d) t (run (packProg15E j d) m s) = s := by
  have pg := pack15E_geom j
  unfold packProg15E packRev15E
  split_ifs with h0
  · rw [if_pos h0] at ok
    have e1 := pack_eq15E 365 350 (by decide) (by decide) d
    have e2 := pack_eq15E 365 355 (by decide) (by decide) d
    let mid := run (packW d 365 350) m s
    have hBpres : ∀ i : Fin 10, mid.basis (hist15E 365 350 i) = s.basis (hist15E 365 350 i) := by
      intro i; apply run_preserves_outside; intro used
      rw [e1.1, Rolling1588.codeEncodeAt, renameProgram_support, (Rolling1588.code_support d).1] at used
      obtain ⟨w, hw, eq⟩ := Finset.mem_image.mp used
      have lt := Finset.mem_range.mp hw
      simp only [MeasuredCodec5.label, dif_pos lt] at eq
      exact (pg.1 h0).2.2.2.1 ⟨w, lt⟩ i eq
    have okB' : MeasuredCodec5.legalAt (hist15E 365 350) mid.basis := by
      rw [MeasuredCodec5.legalAt_iff] at ok ⊢; intro i; rw [hBpres, hBpres]; exact (MeasuredCodec5.legalAt_iff _ _).mp ok.2 i
    have hA := Rolling1588.codeEncodeAt_correct d _ (pg.1 h0).1 s m ok.1
    have hB := Rolling1588.codeEncodeAt_correct d _ (pg.1 h0).2.1 mid (m.drop (measurementCount (packW d 365 350))) okB'
    rw [run_append, run_take]
    refine ⟨by rw [e2.1]; exact hB.1.trans (by simpa [mid, e1.1] using hA.1), fun t => ?_⟩
    rw [run_append, run_take]
    have r2 := Rolling1588.codeRoundtripAt d _ (pg.1 h0).2.1 mid (m.drop (measurementCount (packW d 365 350))) t okB'
    rw [← e2.1, ← e2.2] at r2
    have r1 := Rolling1588.codeRoundtripAt d _ (pg.1 h0).1 s m (t.drop (measurementCount (unpackW d 365 355))) ok.1
    rw [← e1.1, ← e1.2] at r1
    change run (unpackW d 365 350) _ (run (unpackW d 365 355) t (run (packW d 365 355) _ mid)) = s
    rw [r2, r1]
  · rw [if_neg h0] at ok
    have h5 : start15E j - 10 ≠ 5 := by unfold start15E; omega
    have hd : History5.packDue (start15E j - 10) = true := by
      simp only [History5.packDue, start15E, decide_eq_true_eq]; omega
    have e := pack_eq15E (start15E j) (start15E j - 10) h5 hd d
    rw [show start15E j - 10 - 5 = start15E j - 15 by unfold start15E; omega] at e
    rw [e.1, e.2]
    exact ⟨(Rolling1588.codeEncodeAt_correct d _ (pg.2.1 h0).1 s m ok).1,
      fun t => Rolling1588.codeRoundtripAt d _ (pg.2.1 h0).1 s m t ok⟩

private theorem enterTargets15E (j : Fin 4) : ∀ g ∈ enterP15E j,
    CodecBitSliceVerify.target g ≠ EnterJ15E.gate j ∧
    CodecBitSliceVerify.target g ∈ EnterJ15E.ports j := by
  have fwd : ∀ g ∈ EnterProof17.forward, CodecBitSliceVerify.target g ≠ 4 ∧
      CodecBitSliceVerify.target g < EnterProof17.width := by decide +kernel
  intro g hg
  rw [enterP15E, renameProgram, List.mem_map] at hg
  obtain ⟨g0, h0, rfl⟩ := hg
  have t : CodecBitSliceVerify.target (renameInstr (EnterJ15E.map j) g0) =
      EnterJ15E.map j (CodecBitSliceVerify.target g0) := by cases g0 <;> rfl
  obtain ⟨n4, lt⟩ := fwd g0 h0
  rw [t]
  refine ⟨fun e => n4 ?_, ?_⟩
  · exact congrArg Fin.val (EnterJ15E.inc j ⟨_, lt⟩ ⟨4, by decide⟩ (e.trans (rfl : EnterJ15E.gate j = EnterJ15E.map j 4)))
  · rw [EnterJ15E.map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [EnterJ15E.ports_length]; exact lt),
      Option.getD_some]
    exact List.getElem_mem _

private theorem enter_readonly15E (j : Fin 4) {q : Wire} (h : q ∉ EnterJ15E.ports j ∨ q = EnterJ15E.gate j) :
    ∀ g ∈ enterP15E j, CodecBitSliceVerify.target g ≠ q := by
  intro g hg eq
  obtain ⟨ng, mp⟩ := enterTargets15E j g hg
  rcases h with h | h
  · exact h (eq ▸ mp)
  · exact ng (eq.trans h)

theorem bank_kept15E (j : Fin 4) (d : Bool) (s : State) (e t p : List Bool)
    (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1)
    (active : onRails15E j 0 z (run (enterP15E j) e s).basis) :
    let now := run (packProg15E j d) p (run (routed15E j 0 1) t (run (enterP15E j) e s))
    ∀ i : Fin 23, now.basis (prevRawPorts15E j ⟨i, by omega⟩) = s.basis (prevRawPorts15E j ⟨i, by omega⟩) := by
  dsimp only; intro i
  obtain ⟨f, no, sup⟩ := (pack15E_geom j).2.2.1 _ (prevRaw_head_mem15E j i)
  exact (run_preserves_outside _ _ _ _ (fun h => sup (List.mem_toFinset.mp ((pack_codes15E j d).1 h)))).trans
    ((first_preserves15E j _ odd _ t active _ (firstFree15E j f)).trans
      (preserve_readonly _ _ (enter_readonly15E j no) s e))

theorem prev_chron15E :
    (∀ i : Fin 20, ArchiveJ20.rawPorts k9 ⟨i, by omega⟩ = nativeRawPort20 k9 i) ∧
    (∀ j : Fin 4, j.val ≠ 0 → ∀ i : Fin 20,
      ArchiveJ15E.rawPorts (prev15E j) ⟨i, by omega⟩ = nativeRawPort15E ⟨j.val - 1, by omega⟩ i) := by
  decide +kernel

theorem admits15E (j : Fin 4) (d : Bool) (before : State) (et first pack : List Bool)
    (nowZ : SkywalkRails.State) (parity : (nowZ.a + nowZ.b) % 2 = 1)
    (ready : onRails15E j 0 nowZ (run (enterP15E j) et before).basis)
    (scratch : ∀ k : Fin 157, 23 ≤ k.val →
      (run (packProg15E j d) pack (run (routed15E j 0 1) first (run (enterP15E j) et before))).basis
        (prevRawPorts15E j k) = false)
    (past : SkywalkNat.State) (g sign cross : Bool) (odd : past.v % 2 = 1)
    (small : PrevSmall15E j past) (prior : PrevPast15E j past g sign cross before) :
    let src := run (routed15E j 0 1) first (run (enterP15E j) et before)
    let out := run (packProg15E j d) pack src
    (if j.val = 0 then MeasuredCodec5.legalAt (hist15E 365 345) src.basis ∧ MeasuredCodec5.legalAt (hist15E 365 350) src.basis
     else MeasuredCodec5.legalAt (hist15E (start15E j) (start15E j - 15)) src.basis) ∧
    ∃ row < 63145, ArchivePortAction.Frame (prevRawPorts15E j) ArchivePortAction.raw row out := by
  dsimp only
  have pg := pack15E_geom j
  have bk := bank_kept15E j d before et first pack nowZ parity ready
  by_cases h0 : j.val = 0
  · simp only [PrevPast15E, PrevSmall15E, prevRawPorts15E, h0, ↓reduceIte] at small prior scratch bk ⊢
    have hleg : StairArchiveRaw.legal (physicalCells20 k9 before) := by
      rw [prior.records]; exact legal_signed 20 past g sign (by omega) odd
    have hkeptA (i : Fin 10) : (run (routed15E j 0 1) first (run (enterP15E j) et before)).basis (hist15E 365 345 i) =
        before.basis (hist15E 365 345 i) :=
      (first_preserves15E j _ parity _ first ready _ (firstFree15E j ((pg.1 h0).2.2.2.2.2 i).1)).trans
        (run_preserves_outside _ _ _ _ (EnterJ15E.notWire j ((pg.1 h0).2.2.2.2.2 i).2.1))
    have hkeptB (i : Fin 10) : (run (routed15E j 0 1) first (run (enterP15E j) et before)).basis (hist15E 365 350 i) =
        before.basis (hist15E 365 350 i) :=
      (first_preserves15E j _ parity _ first ready _ (firstFree15E j ((pg.1 h0).2.2.2.2.2 i).2.2.1)).trans
        (run_preserves_outside _ _ _ _ (EnterJ15E.notWire j ((pg.1 h0).2.2.2.2.2 i).2.2.2))
    have okA : MeasuredCodec5.legalAt (hist15E 365 345) (run (routed15E j 0 1) first (run (enterP15E j) et before)).basis := by
      apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
      rw [hkeptA, hkeptA, ((pg.1 h0).2.2.2.2.1 i).1, ((pg.1 h0).2.2.2.2.1 i).2.1]
      apply not_both; simpa only [Nat.zero_add, cell, mappedBasis20] using
        hleg _ (member_cell (shape20 k9) 20 0 i.val (mappedBasis20 k9 before.basis) (by omega))
    have okB : MeasuredCodec5.legalAt (hist15E 365 350) (run (routed15E j 0 1) first (run (enterP15E j) et before)).basis := by
      apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
      rw [hkeptB, hkeptB, ((pg.1 h0).2.2.2.2.1 i).2.2.1, ((pg.1 h0).2.2.2.2.1 i).2.2.2]
      apply not_both; simpa only [Nat.zero_add, cell, mappedBasis20] using
        hleg _ (member_cell (shape20 k9) 20 0 (5 + i.val) (mappedBasis20 k9 before.basis) (by omega))
    refine ⟨⟨okA, okB⟩, ?_⟩
    let cells := physicalCells20 k9 before
    let f := decide (Shadow.far (sbP20 345) 20 past)
    let u := f && afterFlags (decide (past.v < past.u)) (cells.take 10)
    let c := f && cross
    let data := rawBit (StairArchiveRaw.read (cells.drop 10)) f u c
    have hrec : ∀ i : Fin 157, i.val < 23 →
        (run (packProg15E j d) pack (run (routed15E j 0 1) first (run (enterP15E j) et before))).basis
          (ArchiveJ20.rawPorts k9 i) = data i := by
      intro k hk
      by_cases y : k.val < 20
      · refine (bk ⟨k, hk⟩).trans ?_; rw [prev_chron15E.1 ⟨k, y⟩]
        exact (native_raw_read20 k9 before k y).trans (by simp [data, cells, rawBit, y])
      · have eq : k = 20 ∨ k = 21 ∨ k = 22 := by omega
        rcases eq with rfl | rfl | rfl
        · exact (bk 20).trans prior.far
        · exact (bk 21).trans prior.suffix
        · exact (bk 22).trans prior.crossed
    obtain ⟨row, lim, matchRow⟩ := interrupted_row20 (sbP20 345) past small odd g sign cross _
      (prior.records.trans (true_records20 _ _ small odd _ _).symm)
    exact ⟨row, lim, starting_frame (ArchiveJ20.rawPorts k9) _ row data matchRow hrec scratch⟩
  · simp only [PrevPast15E, PrevSmall15E, prevRawPorts15E, h0, ↓reduceIte] at small prior scratch bk ⊢
    let pj : Fin 4 := ⟨j.val - 1, by have := j.isLt; omega⟩
    have hleg : StairArchiveRaw.legal (physicalCells15E pj before) := by
      rw [prior.records]; exact legal_signed 15 past g sign (by omega) odd
    have hkept (i : Fin 10) : (run (routed15E j 0 1) first (run (enterP15E j) et before)).basis
        (hist15E (start15E j) (start15E j - 15) i) = before.basis (hist15E (start15E j) (start15E j - 15) i) :=
      (first_preserves15E j _ parity _ first ready _ (firstFree15E j ((pg.2.1 h0).2.1 i).2.1)).trans
        (run_preserves_outside _ _ _ _ (EnterJ15E.notWire j ((pg.2.1 h0).2.1 i).2.2))
    have okA : MeasuredCodec5.legalAt (hist15E (start15E j) (start15E j - 15)) (run (routed15E j 0 1) first (run (enterP15E j) et before)).basis := by
      apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
      rw [hkept, hkept, ((pg.2.1 h0).2.2 i).1, ((pg.2.1 h0).2.2 i).2]
      apply not_both; simpa only [Nat.zero_add, cell, mappedBasis15E] using
        hleg _ (member_cell (shape15E pj) 15 0 i.val (mappedBasis15E pj before.basis) (by omega))
    refine ⟨okA, ?_⟩
    let cells := physicalCells15E pj before
    let f := decide (Shadow.far (sb15E (start15E pj)) 15 past)
    let u := f && afterFlags (decide (past.v < past.u)) (cells.take 5)
    let c := f && cross
    let data := rawBit (StairArchiveRaw.read (cells.drop 5)) f u c
    have hrec : ∀ i : Fin 157, i.val < 23 →
        (run (packProg15E j d) pack (run (routed15E j 0 1) first (run (enterP15E j) et before))).basis
          (ArchiveJ15E.rawPorts (prev15E j) i) = data i := by
      intro k hk
      by_cases y : k.val < 20
      · refine (bk ⟨k, hk⟩).trans ?_; rw [prev_chron15E.2 j h0 ⟨k, y⟩]
        exact (native_raw_read15E pj before k y).trans (by simp [data, cells, rawBit, y])
      · have eq : k = 20 ∨ k = 21 ∨ k = 22 := by omega
        rcases eq with rfl | rfl | rfl
        · exact (bk 20).trans prior.far
        · exact (bk 21).trans prior.suffix
        · exact (bk 22).trans prior.crossed
    obtain ⟨row, lim, matchRow⟩ := interrupted_row_shadow7 (sb15E (start15E pj)) past small odd g sign cross _
      (prior.records.trans (true_records_shadow7 _ _ small odd _ _).symm)
    exact ⟨row, lim, starting_frame (ArchiveJ15E.rawPorts (prev15E j)) _ row data matchRow hrec scratch⟩

theorem archive_run15E (j : Fin 4) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (raw : Frame (prevRawPorts15E j) ArchivePortAction.raw row s) :
    let t := run (archLoad15E j d) m s
    t.phase = s.phase ∧ Frame (prevCodePorts15E j) (code d) row t ∧
    (∀ q, (∀ i, prevRawPorts15E j i ≠ q) → t.basis q = s.basis q) ∧
    (∀ n, run (archRestore15E j d) n t = s) := by
  unfold prevRawPorts15E at raw
  unfold archLoad15E archRestore15E prevRawPorts15E prevCodePorts15E
  split_ifs with h0
  · rw [if_pos h0] at raw
    have f := ArchiveJ20.load_run k9 d row hr s m raw
    exact ⟨f.1, f.2.1, f.2.2, fun n => ArchiveJ20.roundtrip k9 d row hr s m n raw⟩
  · rw [if_neg h0] at raw
    have f := ArchiveJ15E.load_run (prev15E j) d row hr s m raw
    exact ⟨f.1, f.2.1, f.2.2, fun n => ArchiveJ15E.roundtrip (prev15E j) d row hr s m n raw⟩

theorem admin15E (j : Fin 4) (d : Bool) (s : State) (m : List Bool)
    (ok : if j.val = 0 then MeasuredCodec5.legalAt (hist15E 365 345) s.basis ∧ MeasuredCodec5.legalAt (hist15E 365 350) s.basis
          else MeasuredCodec5.legalAt (hist15E (start15E j) (start15E j - 15)) s.basis)
    (row : Nat) (limit : row < 63145)
    (raw : Frame (prevRawPorts15E j) ArchivePortAction.raw row (run (packProg15E j d) m s))
    (clean : ∀ k : Fin 157, 23 ≤ k.val → prevRawPorts15E j k ∈ watch15E j →
      (run (packProg15E j d) m s).basis (prevRawPorts15E j k) = false) :
    let out := run (withArchive15E j d) m s
    AdminResult15E j (fromArchive15E j d) s out ∧ Frame (prevCodePorts15E j) (code d) row out := by
  let p := run (packProg15E j d) m s
  let tape := m.drop (measurementCount (packProg15E j d))
  let a := run (archLoad15E j d) tape p
  have old := pack_source_law15E j d s m ok
  have stay := pack_retains15E j d s m
  have arr := archive_run15E j d row limit p tape raw
  have untouched : ∀ q ∈ watch15E j, a.basis q = p.basis q := by
    intro q hq
    by_cases mem : ∃ k, prevRawPorts15E j k = q
    · obtain ⟨k, rfl⟩ := mem
      have hk : 23 ≤ k.val := by
        by_contra! bad
        exact (of_decide_eq_true (List.all_eq_true.mp (pack15E_geom j).2.2.2 _ hq)).2
          (prevRaw_head_mem15E j ⟨k.val, bad⟩)
      rw [clean k hk hq, prevRaw_scratch_eq15E j k hk, arr.2.1, archive_blank _ _ (by dsimp; omega), Nat.zero_testBit]
    · exact arr.2.2.1 _ (fun k eq => mem ⟨k, eq⟩)
  dsimp only [withArchive15E, fromArchive15E]
  simp only [run_append, run_take]
  refine ⟨⟨arr.1.trans old.1, fun q h => (untouched _ h).trans (stay _ h), ?_⟩, arr.2.1⟩
  intro n
  rw [run_append, run_take]
  change run (packRev15E j d) _ (run (archRestore15E j d) _ a) = s
  rw [arr.2.2.2 n]; exact old.2 _

theorem prevArch_load_cover15E (j : Fin 4) (d : Bool) :
    wires (archLoad15E j d) ⊆ (prevRawPortsList15E j).toFinset := by
  have moves_w (ps : List (Wire × Wire)) : ∀ q ∈ wires (moves ps), ∃ p ∈ ps, q = p.1 ∨ q = p.2 := by
    induction ps with
    | nil => intro q h; simp [moves, wires] at h
    | cons p ps ih =>
      intro q h; obtain ⟨a, b⟩ := p
      simp only [moves, List.flatMap_cons, wires_append, Finset.mem_union] at h
      rcases h with h | h
      · exact ⟨(a, b), List.mem_cons_self, by simp [swapBits, wires, Instr.wires] at h ⊢; tauto⟩
      · obtain ⟨p', hp', e⟩ := ih q (by simpa [moves] using h); exact ⟨p', List.mem_cons_of_mem _ hp', e⟩
  unfold archLoad15E prevRawPortsList15E
  split_ifs with h0
  · rw [ArchiveJ20.load_program, wires_append, Finset.union_subset_iff]
    constructor
    · rw [StairArchiveIntegerHook.placed, renameProgram_support]
      intro q hq; obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      have small : w < 155 := by cases d; exact Partial.load1_ports w hw; exact Partial.load0_ports w hw
      rw [ArchiveJ20.load_map k9 ⟨w, small⟩, List.mem_toFinset, ArchiveJ20.rawPorts,
        List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [ArchiveJ20.rawLength]; omega), Option.getD_some]
      exact List.getElem_mem _
    · intro q hq; obtain ⟨p, hp, e⟩ := moves_w _ q hq
      have hm : ∀ r ∈ ArchiveJ20.loadMoves k9, r.1 ∈ ArchiveJ20.rawHead k9 ∧ r.2 ∈ ArchiveJ20.rawHead k9 := by decide +kernel
      obtain ⟨h1, h2⟩ := hm p hp
      rw [List.mem_toFinset, ArchiveJ20.raw_split]
      rcases e with rfl | rfl <;> exact List.mem_append_left _ (by assumption)
  · rw [ArchiveJ15E.load_program, wires_append, Finset.union_subset_iff]
    constructor
    · rw [StairArchiveIntegerHook.placed, renameProgram_support]
      intro q hq; obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      have small : w < 155 := by cases d; exact Partial.load1_ports w hw; exact Partial.load0_ports w hw
      rw [ArchiveJ15E.load_map (prev15E j) ⟨w, small⟩, List.mem_toFinset, ArchiveJ15E.rawPorts,
        List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [ArchiveJ15E.rawLength]; omega), Option.getD_some]
      exact List.getElem_mem _
    · intro q hq; obtain ⟨p, hp, e⟩ := moves_w _ q hq
      have hm : ∀ (k : Fin 3), ∀ r ∈ ArchiveJ15E.loadMoves k, r.1 ∈ ArchiveJ15E.rawPortsList k ∧ r.2 ∈ ArchiveJ15E.rawPortsList k := by
        decide +kernel
      obtain ⟨h1, h2⟩ := hm (prev15E j) p hp
      rw [List.mem_toFinset]
      rcases e with rfl | rfl <;> assumption

theorem admin_cover15E (j : Fin 4) (d : Bool) :
    wires (withArchive15E j d) ⊆ (support15E j ++ prevRawPortsList15E j).toFinset := by
  rw [withArchive15E, wires_append, List.toFinset_append]
  exact Finset.union_subset_union (pack_codes15E j d).1 (prevArch_load_cover15E j d)

attribute [local irreducible] run onRails15E unrouted15E in
theorem next_window15E (j : Fin 4) (d : Bool) (raw s : State) (m : List Bool)
    (z : SkywalkNat.State) (G S : Bool) (odd : z.v % 2 = 1) (small : Shadow7.SmallIfFar (sb15E (start15E j)) 15 z)
    (cut : PackedCut (EnterJ15E.lowerPairs j) (EnterJ15E.upperPairs j) (EnterJ15E.gate j) (EnterJ15E.flagN j)
      (EnterJ15E.flagF j) (EnterJ15E.flagU j) (PortalValues.negative S z.u)
      (decide (Shadow.far (sb15E (start15E j)) 15 z))
      (decide (Shadow.far (sb15E (start15E j)) 15 z ∧ 2 ^ sb15E (start15E j) ≤ z.u))
      (pullState (EnterJ15E.pull j) raw) (eraseSites (EnterJ15E.pending j) s))
    (input : SkywalkIntegerInput (EnterJ15E.lay j) (encode G S z.u z.v).a (encode G S z.u z.v).b G raw.basis)
    (hist : ∀ r : Fin 15, raw.basis (EnterJ15E.pull j (windowNet15E j (IntegerPacket.ports (shape15E j) r).history)) = false)
    (scratch : ∀ k : Fin 157, 23 ≤ k.val →
      let pre := run (enterP15E j) m s
      let tape := m.drop (measurementCount (enterP15E j))
      (run (packProg15E j d) (tape.drop (measurementCount (routed15E j 0 1)))
        (run (routed15E j 0 1) tape pre)).basis (prevRawPorts15E j k) = false)
    (past : SkywalkNat.State) (pg ps cross : Bool) (po : past.v % 2 = 1)
    (pm : PrevSmall15E j past) (prior : PrevPast15E j past pg ps cross s) :
    let out := run (nextWindow15E j d) m s
    let T := Shadow.reduced (sb15E (start15E j)) 15 z
    out.phase = s.phase ∧ onRails15E j 15 (SkywalkTrace.next^[15] (encode G S T.u T.v)) out.basis ∧
      physicalCells15E j out = SkywalkTrace.trace 15 (encode G S z.u z.v) ∧
      ∀ t, run (nextUnwind15E j d) t out = s := by
  let pre := run (enterP15E j) m s
  let tape := m.drop (measurementCount (enterP15E j))
  let T := Shadow.reduced (sb15E (start15E j)) 15 z
  let Z := encode G S T.u T.v
  have to' : T.v % 2 = 1 := shadow_odd_shadow7 (sb15E (start15E j)) z small odd
  have parity : (Z.a + Z.b) % 2 = 1 := encode_odd_sum G S _ _ (by omega)
  have ready := EnterJ15E.ready_pending_at j raw s z G S m small cut input hist
  obtain ⟨ok, row, limit, frame⟩ := admits15E j d s m tape (tape.drop (measurementCount (routed15E j 0 1)))
    Z parity ready.2.1 scratch past pg ps cross po pm prior
  have adm := (admin15E j d _ _ ok row limit frame (fun k hk _ => scratch k hk)).1
  have all := body15E_run j (withArchive15E j d) (fromArchive15E j d) pre tape Z parity ready.2.1 adm
  dsimp only [nextWindow15E, nextUnwind15E, window15E, unwind15E]
  simp only [run_append, run_take]
  refine ⟨all.1.trans ready.1, all.2.1, all.2.2.1.trans (true_records_shadow7 (sb15E (start15E j)) z small odd G S), ?_⟩
  intro n
  rw [all.2.2.2 n]
  exact EnterJ15E.return_pending j raw s z G S m _ small cut input

def protectedSites15E (j : Fin 4) : List Wire :=
  EnterJ15E.flagN j :: EnterJ15E.flagF j :: EnterJ15E.flagU j :: EnterJ15E.saved j

private theorem protected_ok15E : ∀ j : Fin 4,
    (protectedSites15E j).all (fun w =>
      decide (¬ MayTouch15E j (windowNet15E j w) ∧ w ∉ support15E j ++ prevRawPortsList15E j ∧
        w ∉ EnterJ15E.pending j)) = true := by
  decide +kernel

attribute [local irreducible] run SkywalkNat.step body15E routed15E enterP15E withArchive15E in
theorem saved_with_pending15E (j : Fin 4) (d : Bool) (raw cut : State) (z : SkywalkNat.State) (G S : Bool)
    (head ticks : List Bool) (small : Shadow7.SmallIfFar (sb15E (start15E j)) 15 z)
    (packed : PackedCut (EnterJ15E.lowerPairs j) (EnterJ15E.upperPairs j) (EnterJ15E.gate j) (EnterJ15E.flagN j)
      (EnterJ15E.flagF j) (EnterJ15E.flagU j) (PortalValues.negative S z.u)
      (decide (Shadow.far (sb15E (start15E j)) 15 z))
      (decide (Shadow.far (sb15E (start15E j)) 15 z ∧ 2 ^ sb15E (start15E j) ≤ z.u))
      (pullState (EnterJ15E.pull j) raw) (eraseSites (EnterJ15E.pending j) cut))
    (input : SkywalkIntegerInput (EnterJ15E.lay j) (encode G S z.u z.v).a (encode G S z.u z.v).b G raw.basis) :
    let out := run (window15E j d) ticks (run (enterP15E j) head cut)
    regValue (EnterJ15E.saved j) out.basis = (if Shadow.far (sb15E (start15E j)) 15 z then Shadow.high (sb15E (start15E j)) 15 z else 0) ∧
      out.basis (EnterJ15E.flagN j) = false ∧
      out.basis (EnterJ15E.flagF j) = decide (Shadow.far (sb15E (start15E j)) 15 z) ∧
      out.basis (EnterJ15E.flagU j) = decide (Shadow.far (sb15E (start15E j)) 15 z ∧ 2 ^ sb15E (start15E j) ≤ z.u) := by
  have pok := protected_ok15E j
  have keeps (st : State) : ∀ q ∈ protectedSites15E j, (run (window15E j d) ticks st).basis q = st.basis q :=
    fun q hq => body15E_cover j (withArchive15E j d) (protectedSites15E j) (support15E j ++ prevRawPortsList15E j)
      (fun w hw => (of_decide_eq_true (List.all_eq_true.mp pok w hw)).1)
      (fun w hw => (of_decide_eq_true (List.all_eq_true.mp pok w hw)).2.1) (admin_cover15E j d) st ticks q hq
  have eq := masked_body (enterP15E j) (window15E j d) (protectedSites15E j) (EnterJ15E.pending j) cut head ticks
    (EnterJ15E.avoid_enter j) (fun w hw => (of_decide_eq_true (List.all_eq_true.mp pok w hw)).2.2) keeps
  have high := EnterJ15E.high_from_cut j raw (eraseSites (EnterJ15E.pending j) cut) z G S head small packed input
  have body0 := EnterJ15E.from_full j raw (eraseSites (EnterJ15E.pending j) cut) z G S head small packed input
  have tags := (EnterProof17.actual_tags (EnterJ15E.ports j) _ (sb15E (start15E j)) 15 z G S body0.2.1).2
  have obs := keep_values (EnterJ15E.flagN j) (EnterJ15E.flagF j) (EnterJ15E.flagU j) (EnterJ15E.saved j)
    (run (enterP15E j) head (eraseSites (EnterJ15E.pending j) cut)) _ _ _ _ (keeps _)
    high tags.1 tags.2.1 tags.2.2
  exact keep_values (EnterJ15E.flagN j) (EnterJ15E.flagF j) (EnterJ15E.flagU j) (EnterJ15E.saved j) _ _ _ _ _ eq
    obs.1 obs.2.1 obs.2.2.1 obs.2.2.2

