        exact ⟨k, List.mem_finRange k, congrArg (OB5.sig 425) eq⟩
      have heq77 : (run (StockGroupsW.batch 45 true (StockGroupsW.all 25)) [] (run (span 45 380) [] s)).basis
            (MixedGeo425.slot (MixedGeo425.groupOf b j) (MixedGeo425.index j)) =
          (run (StockGroupsW.batch 45 true all77) [] (run (span 45 380) [] s)).basis
            (MixedGeo425.slot (MixedGeo425.groupOf b j) (MixedGeo425.index j)) := by
        rw [all77_eq, OrdinaryChainG.batch_append, run_append, run_take, List.drop_nil]
