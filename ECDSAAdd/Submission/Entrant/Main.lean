        (run (liftF (renameProgram (OB5.sig 511) (StairGroups.groups true 43 100 2))) m' (run (cut eps 17) u tStd)).basis q = false :=
      cleanCut_after (groupsRolesAfter_eps 17 43 100 2 (by simp))
