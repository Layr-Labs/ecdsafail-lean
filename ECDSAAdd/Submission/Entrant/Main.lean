section
set_option autoImplicit false

set_option maxHeartbeats 4000000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.BucketPointDevelop
open Arithmetic

def shift (b g : Wire) (ys : List Wire) (K : Nat) : Program :=
  [.CX g b]++maskedConstant b ys K++[.CX g b]

theorem shift_correct (b g : Wire) (ys : List Wire) (K : Nat) (hbg : b≠g)
    (nd : ys.Nodup) (hb : b∉ys) (hg : g∉ys) (hk : K<2^ys.length) (s : State) (m : List Bool) :
    (run (shift b g ys K) m s).phase=s.phase ∧
    regValue ys (run (shift b g ys K) m s).basis=
      regValue ys s.basis ^^^ (if s.basis b ^^ s.basis g then K else 0) ∧
    ∀q,q∉ys → (run (shift b g ys K) m s).basis q=s.basis q := by
  let a : State:=⟨s.phase,writeBit s.basis b (s.basis b ^^ s.basis g)⟩
  have keep (q : Wire) (h : q≠b) : a.basis q=s.basis q := by simp [a,writeBit,Function.update_apply,h]
  have ag : a.basis g=s.basis g := keep g (Ne.symm hbg)
  have ab : a.basis b=(s.basis b ^^ s.basis g) := by simp [a,writeBit,Function.update_apply]
  have ay : regValue ys a.basis=regValue ys s.basis :=
    regValue_congr _ _ _ (fun q hq=>keep q (fun e=>hb (e ▸ hq)))
  let t:=run (maskedConstant b ys K) [] a
  have k:=maskedConstant_correct b ys K nd hb hk a []
  have tg : t.basis g=s.basis g := (k.2.1 g hg).trans ag
  have tb : t.basis b=(s.basis b ^^ s.basis g) := (k.2.1 b hb).trans ab
  let z : State:=⟨t.phase,writeBit t.basis b (t.basis b ^^ t.basis g)⟩
  have out (q : Wire) (h : q≠b) : z.basis q=t.basis q := by simp [z,writeBit,Function.update_apply,h]
  have zy : regValue ys z.basis=regValue ys t.basis :=
    regValue_congr _ _ _ (fun q hq=>out q (fun e=>hb (e ▸ hq)))
  have bz : z.basis b=s.basis b := by simp [z,writeBit,Function.update_apply,tb,tg,Bool.xor_assoc]
  have value : regValue ys z.basis=regValue ys s.basis ^^^ (if s.basis b ^^ s.basis g then K else 0) := by
    rw [zy,k.2.2,ay,ab]
  have counts:=maskedConstant_counts b ys K
  unfold shift
  rw [run_append,run_append]
  simp only [measurementCount_append,counts.2,measurementCount,List.drop_zero,List.take_zero,Nat.zero_add]
  change z.phase=s.phase ∧ regValue ys z.basis=_ ∧ _
  refine ⟨k.1,value,?_⟩
  intro q hq
  by_cases eq:q=b
  · subst q;exact bz
  · exact (out q eq).trans ((k.2.1 q hq).trans (keep q eq))


end ECDSAAdd.Entrant.BucketPointDevelop
end

