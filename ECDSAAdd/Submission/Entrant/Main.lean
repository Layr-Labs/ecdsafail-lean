theorem head_parked425 : ∀ i : Fin 23,
    (if i.val < 20 then rawPorts ⟨i, by omega⟩ ∉ dst ∧ rawPorts ⟨i, by omega⟩ ∉ src ∧
       rawPorts ⟨i, by omega⟩ ≠ 1615 ∧ rawPorts ⟨i, by omega⟩ ≠ 1613 ∧ rawPorts ⟨i, by omega⟩ ≠ 1614 ∧
       rawPorts ⟨i, by omega⟩ ∉ RailPair.sites hiPairs
