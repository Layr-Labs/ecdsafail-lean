      hBar_keep _ (Or.inr (Or.inr (Or.inr (by omega)))), hu6]
    by_cases hf : far (sb15E (start15E j)) 15 z <;> simp [hf, HighBankSum.crossBit]
  · rw [hfin_basis _, if_neg (by omega), hu10_eq]; simp only [writeBit, Function.update_of_ne (show (e015E (start15E j) + 7 : Nat) ≠ 1613 by omega)]
    rw [hJoin_out _ (haway_col _ (Or.inr (Or.inr (by omega)))), huG3_keep _ (by unfold b015E; omega), hu8_keep _ (by omega) (by omega),
      hBar_keep _ (Or.inr (Or.inr (Or.inr (by omega)))), hu7]
  · rw [regValue_zero]; intro q hq; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    rw [hout_frame _ (by omega) (by omega) (by omega) (by unfold b015E; omega) (hbank_out_easy _ (by omega)).1 (hbank_out_easy _ (by omega)).2]
    exact (regValue_zero _ _).mp front.2.1 _ (List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩)

end ECDSAAdd.Entrant.StairPacket.Shadow15End.LeaveCut15E

