  · exact k9_scratch_eq k hk
  · have h1 := ArchiveJ15E.raw_scratch (prev15E j) (k := k.val - 23) (by have := k.isLt; omega)
    have h2 := ArchiveJ15E.code_scratch (prev15E j) (k := k.val - 23) (by have := k.isLt; omega)
    rw [show 23 + (k.val - 23) = k.val by omega] at h1
    rw [show 16 + (k.val - 23) = k.val - 7 by omega] at h2
