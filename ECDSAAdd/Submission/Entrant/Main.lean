    gateSlots (rotateRight xs)=3*(xs.length-1) ∧
    gateSlots (rotateLeft xs)=3*(xs.length-1) := by
  induction xs with
  | nil => exact ⟨rfl,rfl⟩
  | cons x xs ih =>
    cases xs with
    | nil => exact ⟨rfl,rfl⟩
    | cons y ys =>
