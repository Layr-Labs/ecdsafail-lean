        have hcf := hc.2.2.1 ⟨p - e015E (start15E j), hk⟩; dsimp only at hcf; rwa [hfr] at hcf
    · have hout : HighBankBarrel.outside (bankW15E (start15E j)) (wp15E (start15E j) + 15) p ∧
