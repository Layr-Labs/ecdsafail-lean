    simp only [odd24, stockOddDivPreCut, hraw, hbet, List.append_assoc]
  have hchain (s3 : State) (m3 m4 m6 m8 m10 m12 m14 m15 m16 m17 m1820 m2123 : List Bool)
      (h3 : ∃ b3, DivCut 3 s3 b3) :
