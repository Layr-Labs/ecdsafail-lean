namespace ECDSAAdd.Entrant.StairPacket.StockPlacedWindow
open Arithmetic MappedCompressed Secp256k1 WideReference StockArchiveBanks StockWalkPrefix StockWalkWindow
set_option maxRecDepth 12000
set_option maxHeartbeats 2500000
attribute [local irreducible] run Rolling1588TickGap.forward Rolling1588.Integer.regularForward measurementCount Shadow20.MixedWindow425.forward425Cut
theorem fixed:∀(b:Bank)(j:Fin 16),Stair44WalkMap.rest (siteAt b j)=siteAt b j:=by
  intro b j; rw [site_eq]; exact Shadow20.MixedGeo425.fixed_rest b j
theorem unplace {d x a s rows} (pair:Paired d x (pullState Stair44WalkMap.rest a) (pullState Stair44WalkMap.rest s) rows):Paired d x a s rows:=by
  refine ⟨⟨pair.equality.1,?_⟩,pair.labels,?_,?_⟩
  · intro q off
    have safe:Stair44WalkMap.rest.symm q∉archives:=by
      intro hit; obtain ⟨b,j,e⟩:=bank_rep _ hit; apply off
      have same:=congrArg Stair44WalkMap.rest e; rw [fixed,Equiv.apply_symm_apply] at same
      exact same ▸ (StockArchiveBanks.mem b j)
    simpa only [pullState,Equiv.apply_symm_apply] using pair.equality.2 _ safe
  · intro b j; change a.basis (siteAt b j)=_; rw [←fixed b j]; exact pair.custom b j
  · intro b j; rw [←fixed b j]; exact pair.stock b j

theorem old_split_false (n:Nat):Stair44WalkRun.forward false (410+n)=
    first false++renameProgram Stair44WalkMap.rest (Rolling1588TickGap.forward false 45 (381+n)):=by
  have e:=StairRestSupport.forward_append false 29 16 (381+n)
  change Rolling1588TickGap.forward false 16 (29+(381+n))=Rolling1588TickGap.forward false 16 29++Rolling1588TickGap.forward false 45 (381+n) at e
  rw [show 410+n=29+(381+n) by omega]
  simp only [Stair44WalkRun.forward,first,e,renameProgram,List.map_append,List.append_assoc]

theorem rename_rest_firstPackHead :
    renameProgram Stair44WalkMap.rest WindowWalkCosts.firstPackHead = WindowWalkCosts.firstPackHead := by
  have h1 : renameProgram Stair44WalkMap.rest (renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425)) =
      renameProgram StairV3Primitives.xRelabel (StairV3Primitives.orient 425) := EndOrient425.rename_rest
  have h2 : renameProgram Stair44WalkMap.rest (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)) =
      renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425) := by
    have hfix : ∀ q ∈ wires (renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425)),
        Stair44WalkMap.rest q = q := by decide +kernel
    exact (renameProgram_congr_support Stair44WalkMap.rest id _ hfix).trans (StairField2V3Win.renameProgram_id' _)
  rw [WindowWalkCosts.firstPackHead, Six505.rename_append, h1, h2]

theorem old_split_true :
    Stair44WalkRun.forward true 409 ++ WindowWalkCosts.firstPackHead =
      first true ++ renameProgram Stair44WalkMap.rest (Rolling1588TickGap.forward true 45 380 ++ WindowWalkCosts.firstPackHead) := by
  have e := StairRestSupport.forward_append true 29 16 380
  change Rolling1588TickGap.forward true 16 (29+380) =
    Rolling1588TickGap.forward true 16 29 ++ Rolling1588TickGap.forward true 45 380 at e
  rw [show (409:Nat) = 29 + 380 from rfl]
  simp only [Stair44WalkRun.forward, first, e, Six505.rename_append, rename_rest_firstPackHead, List.append_assoc]

theorem forwardFalse (n x:Nat) (good:Bounds x p) (bound:426+n≤512) (s a:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base false x p 1 s.basis) (input:pullState Stair44WalkMap.first a=s) (norm:NewNormalized false x):
    Paired false x (run (WindowWalkCosts.forward false n) m a) (run (Stair44WalkRun.forward false (410+n)) m a) (StockRowVector.rows x p):=by
  let t:=m.drop (measurementCount (first false))
  have rel:=windowFalse n x good bound (regular false s m) (cut120 false x good s a m stage input).1 t t norm
  apply unplace
  rw [placed false n x good s a m stage input,old_split_false,run_append,run_take,run_rename _ Stair44WalkMap.rest.injective,(cut120 false x good s a m stage input).2]
  exact rel

theorem forwardTrue (x:Nat) (good:Bounds x p) (s a:State) (m stockTape:List Bool)
    (stage:Rolling1588.Integer.Stage base true x p 1 s.basis) (input:pullState Stair44WalkMap.first a=s) (norm:NewNormalized true x):
    Paired true x (run (WindowWalkCosts.forward true 0) m a)
      (run (Stair44WalkRun.forward true 409 ++ WindowWalkCosts.firstPackHead) (WindowFieldJourney.joinTapes (first true) m stockTape) a)
      (StockRowVector.rows x p):=by
  let t:=m.drop (measurementCount (first true))
  have rel:=windowTrue x good (regular true s m) (cut120 true x good s a m stage input).1 t stockTape norm
  apply unplace
  rw [placed true 0 x good s a m stage input, old_split_true, WindowFieldJourney.joined,
    run_rename _ Stair44WalkMap.rest.injective, (cut120 true x good s a m stage input).2]
  exact rel
end ECDSAAdd.Entrant.StairPacket.StockPlacedWindow

