attribute [local irreducible] gateSlots

theorem raw_gateSlots_le (divide : Bool) (ls : List MixedTranscriptLetter) :
    gateSlots (rawReplay divide ls)≤ls.length*26000 := by
  induction ls with
  | nil => simp [rawReplay]
