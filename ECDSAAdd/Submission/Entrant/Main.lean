/-! ### Section 1: 15-Tick Trailing Window Body (`body15E`, `watch15E`, `MayTouch15E`) -/

def body15E (j : Fin 4) (admin : Program) : Program :=
  routed15E j 0 1 ++ (admin ++ routed15E j 1 14)

def unbody15E (j : Fin 4) (reverse : Program) : Program :=
  TickCut15E.unrouted15EHigh j 1 14 ++ (reverse ++ unrouted15E j 0 1)

def watch15E (j : Fin 4) : List Wire :=
  let p := shape15E j
  let L := IntegerPacket.ports p 1
  (L.a ++ L.b ++ [L.previous] ++ L.carry ++
    ((List.range' 1 14).flatMap fun r => [(IntegerPacket.ports p r).ext, (IntegerPacket.ports p r).history]) ++
    [(IntegerPacket.ports p 0).a0, (IntegerPacket.ports p 0).history]).map (windowNet15E j)

theorem pulled_history15E (j : Fin 4) {x p : Nat} {raw : State} (dom : Domain (start15E j) x p raw) :
    ∀ r : Fin 15, raw.basis (EnterJ15E.pull j (windowNet15E j (IntegerPacket.ports (shape15E j) r).history)) = false := by
  intro r
  have hj := j.isLt; have hr := r.isLt
  have w : EnterJ15E.pull j (windowNet15E j (IntegerPacket.ports (shape15E j) r).history) =
      (2069 - (start15E j + r.val) : Nat) := by
    change OB5.sigNat (start15E j - 1) (OB5.sigNat (start15E j + 14) (start15E j + r.val + 16 + 1028)) = _
    unfold OB5.sigNat start15E
    split_ifs <;> omega
  rw [w]
  exact domain_carry (by unfold start15E; omega) dom _ (by unfold start15E; omega) (by unfold start15E; omega)

private theorem split_run15E (j : Fin 4) (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1) (s : State) (m n : List Bool)
    (ready : onRails15E j 0 z s.basis) (v : State)
    (active : onRails15E j 1 (SkywalkTrace.next z) v.basis)
    (first : cell (shape15E j) 0 (mappedBasis15E j v.basis) =
      cell (shape15E j) 0 (mappedBasis15E j (run (routed15E j 0 1) m s).basis)) :
    let out := run (routed15E j 1 14) n v
    onRails15E j 15 (SkywalkTrace.next^[15] z) out.basis ∧
    readCells (shape15E j) 0 15 (mappedBasis15E j out.basis) = SkywalkTrace.trace 15 z := by
  have post := route15E_frame j 1 14 (by decide) (SkywalkTrace.next z) (nextOdd z odd) v n active
  have back := route15E_records j 1 14 (by decide) (SkywalkTrace.next z) (nextOdd z odd) v n active
  have front := (route15E_records j 0 1 (by decide) z odd s m ready).1
  have firstValue := congrArg List.head? front
  simp only [readCells, SkywalkTrace.trace, List.head?_cons, Option.some.injEq] at firstValue
  exact ⟨post.2, congr (congrArg List.cons ((back.2 0 (by decide)).trans (first.trans firstValue))) back.1⟩

theorem watch15E_congr (j : Fin 4) (s t : State) (agree : ∀ q ∈ watch15E j, t.basis q = s.basis q)
    (z : SkywalkRails.State) (active : onRails15E j 1 z s.basis) :
    onRails15E j 1 z t.basis ∧
      cell (shape15E j) 0 (mappedBasis15E j t.basis) = cell (shape15E j) 0 (mappedBasis15E j s.basis) := by
  let p := shape15E j; let L := IntegerPacket.ports p 1
  let S := mappedBasis15E j s.basis; let T := mappedBasis15E j t.basis
  have locality (q : Wire) (mem : q ∈ L.a ++ L.b ++ [L.previous] ++ L.carry ++
      ((List.range' 1 14).flatMap fun r => [(IntegerPacket.ports p r).ext, (IntegerPacket.ports p r).history]) ++
      [(IntegerPacket.ports p 0).a0, (IntegerPacket.ports p 0).history]) :
      T q = S q := agree _ (List.mem_map.mpr ⟨q, mem, rfl⟩)
  have add (xs : List Wire) (incl : ∀ q ∈ xs, T q = S q) : signedRegValue xs T = signedRegValue xs S := by
    unfold signedRegValue; rw [regValue_congr _ _ _ incl]
  obtain ⟨a, b, prev, carry, free⟩ := active
  refine ⟨⟨(add _ (fun q h => locality _ (by simp [L, p, h]))).trans a,
    (add _ (fun q h => locality _ (by simp [L, p, h]))).trans b,
    (locality _ (by simp [L, p])).trans prev,
    (regValue_congr _ _ _ (fun q h => locality _ (by simp [L, p, h]))).trans carry, ?_⟩, ?_⟩
  · intro r hr last
    have inRange : r ∈ List.range' 1 14 := by rw [List.mem_range'_1]; exact ⟨hr, last⟩
    obtain ⟨e, h⟩ := free r hr last
    exact ⟨(locality _ (by simp only [List.mem_append]; left; right; apply List.mem_flatMap.mpr; exact ⟨r, inRange, by simp [p]⟩)).trans e,
      (locality _ (by simp only [List.mem_append]; left; right; apply List.mem_flatMap.mpr; exact ⟨r, inRange, by simp [p]⟩)).trans h⟩
  · exact Prod.ext (locality _ (by simp [L, p])) (locality _ (by simp [L, p]))

structure AdminResult15E (j : Fin 4) (reverse : Program) (src out : State) : Prop where
  phase : out.phase = src.phase
