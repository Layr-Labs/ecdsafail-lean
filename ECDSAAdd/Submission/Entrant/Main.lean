private theorem keep_cells_15 (i k : Fin 26) (hk : k.val = i.val + 1) (h1 : 1 ≤ k.val) (h24 : k.val ≤ 24)
    (d : Bool) (t : Nat) (ht0 : 60 ≤ t) (ht1 : t + 15 ≤ start k) (q : Wire) (hq : q ∈ cellsRestoreP t)
    (s : State) (m : List Bool) :
