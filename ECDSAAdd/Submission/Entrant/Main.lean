  have hu_keep : ∀ q ∈ [L760.one, L760.rmsb, L760.lower] ++ L760.carry.drop 1, u.basis q = s.basis q := by
    have hchk : ([L760.one, L760.rmsb, L760.lower] ++ L760.carry.drop 1).all
