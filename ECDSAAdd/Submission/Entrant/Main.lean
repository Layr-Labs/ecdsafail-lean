namespace ECDSAAdd.Entrant.StairPacket.WindowStartStates
open Arithmetic MappedCompressed Secp256k1 WideReference Stair44Kernel Rolling1588Lifetime StairConcreteAssembly
open WindowKernelPrograms StockArchiveBanks
set_option maxRecDepth 12000
set_option maxHeartbeats 2000000
attribute [local irreducible] run measurementCount FrontierEntry1591Native.forward

def opening (d:Bool) (n:Nat):Program:=renameProgram phaseHost (openWalk d n)
def originalFalse (n:Nat):Program:=renameProgram phaseHost (openR false (410+n))
def originalTrue425:Program:=renameProgram phaseHost (openR true 409 ++ WindowWalkCosts.firstPackHead)

private theorem fixed (x y:Nat) (s:State) (h:SkywalkArithmeticInput base x y s.basis):
    pullState Stair44WalkMap.first s=s:=by
  let idx:List Nat:=[1026,514,1541,501,1542,500]
  have all:∀j∈idx,base j∈skywalkSharedWires base ∧ base j∉skywalkArithmeticDivisor base ∧ base j∉skywalkArithmeticNumerator base:=by decide +kernel
  have zero (j:Nat) (hj:j∈idx):s.basis (base j)=false:=h.2.2 _ (all j hj).1 (all j hj).2.1 (all j hj).2.2
  have a:=cleanWireRebind id s s _ _ rfl (zero 1026 (by decide)) (zero 514 (by decide))
  have b:=cleanWireRebind _ s s _ _ a (zero 1541 (by decide)) (zero 501 (by decide))
  exact cleanWireRebind _ s s _ _ b (zero 1542 (by decide)) (zero 500 (by decide))

theorem open_raw_false (n x y:Nat) (nz:0 < x) (lt:x<p) (bound:426+n≤512)
    (hn:(skywalkSharedWires base).Nodup) (s:State) (input:SkywalkArithmeticInput base x y s.basis) (m:List Bool):
    Paired false x (run (openWalk false n) m s) (run (openR false (410+n)) m s) (StockRowVector.rows x p):=by
  let N:=FrontierEntry1591Native.forward base
  let t:=m.take (measurementCount firstR)
  have stage:=Rolling1588.Integer.stage_one base false x p _ (FrontierEntry1591Native.caller_first_stageW base hn x y nz lt s t input)
  have eq:=run_rename Stair44WalkMap.first Stair44WalkMap.first.injective N t s
  rw [fixed x y s input] at eq
  simp only [openWalk,openR,run_append]
  exact StockWalkEndpoints.openedFalse n x nz lt bound _ _ _ stage eq

theorem open_raw_true (x y:Nat) (nz:0 < x) (lt:x<p)
    (hn:(skywalkSharedWires base).Nodup) (s:State) (input:SkywalkArithmeticInput base x y s.basis) (m:List Bool):
    ∃ n, Paired true x (run (openWalk true 0) m s) (run (openR true 409 ++ WindowWalkCosts.firstPackHead) n s) (StockRowVector.rows x p):=by
  let N:=FrontierEntry1591Native.forward base
  let t:=m.take (measurementCount firstR)
  let mW:=m.drop (measurementCount firstR)
  have stage:=Rolling1588.Integer.stage_one base true x p _ (FrontierEntry1591Native.caller_first_stageW base hn x y nz lt s t input)
  have eq:=run_rename Stair44WalkMap.first Stair44WalkMap.first.injective N t s
  rw [fixed x y s input] at eq
  let nW:=WindowFieldJourney.joinTapes (StockWalkPrefix.first true) mW []
  refine ⟨WindowFieldJourney.joinTapes firstR t nW, ?_⟩
  rw [openWalk, openR, List.append_assoc, WindowFieldJourney.joined, run_append]
  exact StockWalkEndpoints.openedTrue x nz lt _ _ mW [] stage eq

theorem division {s:State} (F:EntryFrame s) (m:List Bool):
    ∃ n, Paired true F.x (pullState phaseHost (run (opening true 0) m s))
      (pullState phaseHost (run originalTrue425 n s)) (StockRowVector.rows F.x p):=by
  obtain ⟨n, h⟩ := open_raw_true F.x _ F.x_pos F.x_lt F.sharedNodup s (StairField13V3Clean.entryInput F) m
  refine ⟨n, ?_⟩
  rw [opening, originalTrue425, run_rename _ phaseHost.injective, run_rename _ phaseHost.injective, StairField13V3Clean.pull_phaseHost_entry F]
  exact h

theorem multiplication (k:Nat) {s:State} (F:ExitFrame k s) (m:List Bool):
    Paired false F.x (pullState phaseHost (run (opening false 79) m s))
      (pullState phaseHost (run (originalFalse 79) m s)) (StockRowVector.rows F.x p):=by
  rw [opening, originalFalse, run_rename _ phaseHost.injective, run_rename _ phaseHost.injective, StairField13V3Clean.pull_phaseHost_exit F]
  exact open_raw_false 79 F.x _ F.x_pos F.x_lt (by decide) F.sharedNodup s F.input m
end ECDSAAdd.Entrant.StairPacket.WindowStartStates

