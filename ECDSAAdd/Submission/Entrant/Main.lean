    simp only [post, Bool.not_false, Bool.true_and, decide_eq_true_eq]
    by_cases c1 : q = (LeaveJ7.ports 12).crossing ∨ q = (LeaveJ7.ports 12).near
    · rw [if_pos (i1.mpr c1), if_pos c1]; rfl
    · rw [if_neg (fun h => c1 (i1.mp h)), if_neg c1]
