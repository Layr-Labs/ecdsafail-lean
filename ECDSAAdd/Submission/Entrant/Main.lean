  StairSquareFinal.squareEntryHL StairSqLoopA.holes L k ++
    hostedExitRest L cx.val ++ ParityUniform.exitYAll L cy

def hostedGeneric (L : ControlledPointLayout) (cx cy : Fp) : Program :=
  ((ParityUniform.entryYAll L (-cy) ++
      FlagEntry.entryXNew L (FlagEntry.pkW L) (-cx)) ++
    hostedEntryRest L) ++
    hostedSecondStage L (ReflectionE1.correction cx) cy cx

def hostedGenericBlock (cx cy : Fp) : Program :=
  renameProgram (FlagTop.rho Baselines.layout)
    (hostedGeneric Baselines.layout cx cy)

def hostedBorrowGeneric (cx cy : Fp) : Program :=
  renameProgram
    (Equiv.swap Baselines.layout.doubleSelect Baselines.layout.control)
    (hostedGenericBlock cx cy)

/-- The record's `AboveFieldPointDevelop.middle` with only `borrowGeneric`
replaced.  Its encoder/decoder are the record's own
`AboveFieldPointDevelop.encode`/`decode` (= `AboveFieldTagDevelop`), not the
legacy `ControlPointEncodingDevelop` pair (LT6 round 11 correction). -/
def hostedMiddle (C : Point) (cx cy : Fp) : Program :=
  AboveFieldPointDevelop.encode C ++ AboveFieldPointDevelop.eraseB ++
    hostedBorrowGeneric cx cy ++ AboveFieldPointDevelop.loadB ++
    AboveFieldPointDevelop.decode C

def hostedFinite (C : Point) (cx cy : Fp) : Program :=
  FlagTop.stageNew Baselines.layout C
      (FlagEntry.pkW Baselines.layout) ++
    hostedMiddle C cx cy ++ ControlPointEncodingDevelop.borrowOut C

def hostedWrapper (C : Point) (cx cy : Fp) : Program :=
  renameProgram (Wrapper5.U Baselines.layout) (hostedFinite C cx cy)

def concreteProgram (C : Point) : Program :=
  match C with
  | .zero => []
  | @WeierstrassCurve.Affine.Point.some _ _ _ cx cy hc =>
      hostedWrapper (.some hc) cx cy

/-! ## Exact record arithmetic preconditions -/





/-- The one concrete assembly selected for subsequent integration work. -/
def concreteAssembly : StairCertificate.Assembly where
  program := concreteProgram
  place := StairPhysicalInventory.place
  layout := codecLayout
  primitives := checkpointPrimitives
  hostPlan := hostPlan
  entryPre := EntryPre
  exitPre := ExitPre

theorem concreteAssembly_program : concreteAssembly.program = concreteProgram := rfl





end ECDSAAdd.Entrant.StairConcreteAssembly

end
