theorem z0_output_support :
 wires (outNew layout (WeierstrassCurve.Affine.Point.zero : Point))⊆ports := by
 let tr:=triOf (WeierstrassCurve.Affine.Point.zero : Point)
 have pv:=z0_pv tr
