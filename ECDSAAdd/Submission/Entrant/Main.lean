    run ((A++B)++C) (pfx (measurementCount A) []++(pfx (measurementCount B) r++y)) s=
    run C y (run B r (run A [] s)) := by
  rw [List.append_assoc,run_pre A,joinRecords B]

theorem runNil (A B : Program) (s : State) : run (A++B) [] s=run B [] (run A [] s) := by
