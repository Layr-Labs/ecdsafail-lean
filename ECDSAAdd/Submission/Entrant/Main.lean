theorem frame_key15E (j : Fin 4) (ps : Ports) (chron : ∀ i : Fin 20, ps ⟨i, by omega⟩ = nativeRawPort15E j i)
    (r : Nat) (z : SkywalkNat.State) (g sg cross : Bool) (before out : State)
    (prior : PastFacts15E j ps z g sg cross before)
    (kept : ∀ i : Fin 23, out.basis (ps ⟨i, by omega⟩) = before.basis (ps ⟨i, by omega⟩))
    (frame : Frame ps ArchivePortAction.raw r out) :
    let xs := SkywalkTrace.trace 15 (encode g sg z.u z.v)
    let f := decide (Shadow.far (sb15E (start15E j)) 15 z)
    let u := f && StairArchiveTrace.afterFlags (decide (z.v < z.u)) (xs.take 5)
    Encodes (StairArchiveRaw.rawBit (StairArchiveRaw.read (xs.drop 5)) f u (f && cross)) r := by
  intro xs f u q
  have same : (rawCol q).testBit r = before.basis (ps ⟨q, by omega⟩) :=
    ((congrArg (fun n : Nat => n.testBit r) (io true true ⟨q, by omega⟩).1).trans (frame ⟨q, by omega⟩).symm).trans (kept q)
