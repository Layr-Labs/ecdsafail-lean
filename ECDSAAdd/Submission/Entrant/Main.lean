/-! ### Section 2: 15-Tick Selector Transport (`LeaveJ7.SelRen` from Block 12 to `j : Fin 4`) -/

def ren15E (j : Fin 4) (q : Nat) : Nat :=
  if 241 ≤ q ∧ q ≤ 255 then q - 225 + start15E j
  else if 392 ≤ q ∧ q ≤ 407 then q - 392 + (a015E (start15E j) - 1)
  else if q = 1716 then e015E (start15E j) + 6
  else if q = 1717 then e015E (start15E j) + 7
  else q

def prepare15E (j : Fin 4) : List LeaveSelector.Op :=
  (LeaveJ7.prepare 12).map (LeaveJ7.SelRen.rOp (ren15E j))

def retire15E (j : Fin 4) : List LeaveSelector.Op :=
  (LeaveJ7.retire 12).map (LeaveJ7.SelRen.rOp (ren15E j))

def fullPrefix15E (j : Fin 4) : List Gate :=
  let s := start15E j; let h := sb15E s
  leaveFix3 s h ++ leaveFix4 s h ++ Shadow7.fix5P s h

theorem ren15E_inj (j : Fin 4) : LeaveJ7.SelRen.InjOn LeaveJ7.SelRen.D (ren15E j) := by
  have hg := geom15E_facts j; dsimp only at hg
  intro a b ha hb h
  unfold ren15E at h; unfold LeaveJ7.SelRen.D at ha hb
  unfold a015E at h; split_ifs at h <;> omega

private theorem sel15E_shapes : ∀ j : Fin 4,
    GateMirror.forward (fullPrefix15E j) =
      (flagOps (e015E (start15E j) + 3) (e015E (start15E j) + 4) false).map Op.enter ++
      (HighBankFirstHit.putAll 1560 (swaps15E j) LeaveSelector.tags 0 15 ++
        (prepare15E j).map Op.enter) ∧
    GateMirror.forward (leaveFix11 (start15E j) (sb15E (start15E j)) ++ leaveFix12 (start15E j) (sb15E (start15E j)) ++
      lowSign15E (start15E j)) =
      (retire15E j).map Op.exit ++
        (HighBankFirstHit.dropAll 1560 (swaps15E j) LeaveSelector.tags 0 15 ++
          (flagOps (e015E (start15E j) + 3) (e015E (start15E j) + 4) true).reverse.map Op.exit) ∧
    HighBankFirstHit.Layout 1560 (swaps15E j) LeaveSelector.tags 0 15 ∧
    (∀ i : Fin 15, swaps15E j i.val ≠ 1559 ∧ swaps15E j i.val ≠ 1560 ∧
      ∀ k : Fin 15, swaps15E j i.val ≠ LeaveSelector.tags k.val) ∧
    (prepare15E j ++ retire15E j).all (fun o => decide (o.dst ∈ LeaveSelector.affected (ports15E j))) = true ∧
    (Shadow7.fix5P (start15E j) (sb15E (start15E j))).take 27 ++
      ((Shadow7.fix5P (start15E j) (sb15E (start15E j))).drop 27).take 16 ++
      (Shadow7.fix5P (start15E j) (sb15E (start15E j))).drop 43 = Shadow7.fix5P (start15E j) (sb15E (start15E j)) := by
  have hrow : ∀ (r : Fin 4) (i : Fin 15), [1560, swaps15E r i.val, LeaveSelector.tags i.val].Nodup := by decide +kernel
  have hhit : ∀ (r : Fin 4) (i k : Fin 15), i.val < k.val →
      LeaveSelector.tags k.val ≠ LeaveSelector.tags i.val ∧ swaps15E r k.val ≠ LeaveSelector.tags i.val := by decide +kernel
  intro j
  refine ⟨?_, ?_, ⟨fun i _ hi => hrow j ⟨i, by omega⟩, fun i _ hi k hik hk => hhit j ⟨i, by omega⟩ ⟨k, by omega⟩ hik⟩, ?_, ?_, ?_⟩ <;>
    revert j <;> decide +kernel

private theorem sel15E_start_rel (j : Fin 4) (k : Mode) :
    LeaveJ7.SelRen.Rel LeaveJ7.SelRen.D (ren15E j)
      (LeaveSelector.start (ports15E j) false k) (LeaveSelector.start (LeaveJ7.ports 12) false k) := by
  have hg := geom15E_facts j; dsimp only at hg
  have hp12 : LeaveJ7.ports 12 = { g := 241, u := 392, crossing := 1716, near := 1717 } := rfl
  rw [hp12]
  intro q hq
  unfold LeaveJ7.SelRen.D at hq
  rcases hq with hc | hg' | hu | rfl | rfl
  · have rc : ren15E j q = q := by unfold ren15E; split_ifs <;> omega
    rw [rc]; simp only [LeaveSelector.start, ports15E, Bool.false_eq_true, ↓reduceIte]
    split_ifs <;> first | (exfalso; (try unfold a015E at *); (try unfold Wire at *); omega) | rfl
  · have rg : ren15E j q = q - 225 + start15E j := by unfold ren15E; rw [if_pos hg']
    rw [rg]; simp only [LeaveSelector.start, ports15E, Bool.false_eq_true, ↓reduceIte]
    split_ifs <;> first | (exfalso; (try unfold a015E at *); (try unfold Wire at *); omega) | (simp only [LeaveJ7.SelRen.rE, rg])
  · have ru : ren15E j q = q - 392 + (a015E (start15E j) - 1) := by unfold ren15E; rw [if_neg (by omega), if_pos hu]
    rw [ru]; simp only [LeaveSelector.start, ports15E, Bool.false_eq_true, ↓reduceIte]
    split_ifs <;> first | (exfalso; (try unfold a015E at *); (try unfold Wire at *); omega) | (simp only [LeaveJ7.SelRen.rE, ru])
  · have rc : ren15E j 1716 = e015E (start15E j) + 6 := by unfold ren15E; simp
    rw [rc]; simp only [LeaveSelector.start, ports15E, Bool.false_eq_true, ↓reduceIte]
    split_ifs <;> first | (exfalso; (try unfold a015E at *); (try unfold Wire at *); omega) | rfl
  · have rn : ren15E j 1717 = e015E (start15E j) + 7 := by unfold ren15E; simp
    rw [rn]; simp only [LeaveSelector.start, ports15E, Bool.false_eq_true, ↓reduceIte]
    split_ifs <;> first | (exfalso; (try unfold a015E at *); (try unfold Wire at *); omega) | rfl

theorem sel15E_tagCert (j : Fin 4) (k : Mode) (i : Fin 16) :
    sim (prepare15E j) (LeaveSelector.start (ports15E j) false k) (tagsP.getD i 0) =
      .bit (enabled k && decide (i.val = key k)) := by
  have hs := (LeaveJ7.SelRen.sim_rel (ren15E_inj j) (LeaveJ7.prepare 12) LeaveJ7.SelRen.prep10_in _ _
    (LeaveJ7.SelRen.start_good k) (sel15E_start_rel j k)).1
  have hr := LeaveJ7.SelRen.tags_range i.val i.isLt
  have hfix : ren15E j (tagsP.getD i 0) = tagsP.getD i 0 := by
    have : ∀ (r : Fin 4) (idx : Fin 16), ren15E r (tagsP.getD idx.val 0) = tagsP.getD idx.val 0 := by decide +kernel
    exact this j i
  have h1 := hs (tagsP.getD i 0) (Or.inl hr)
  rw [hfix, LeaveJ7.SelRen.cert10_tag k i] at h1
  exact h1

theorem sel15E_controls (j : Fin 4) (k : Mode) :
    sim (prepare15E j) (LeaveSelector.start (ports15E j) false k) (e015E (start15E j) + 6) =
      LeaveSelector.crossing (ports15E j) k ∧
    sim (prepare15E j) (LeaveSelector.start (ports15E j) false k) (e015E (start15E j) + 7) =
      .bit (nearby k) ∧
    sim (prepare15E j) (LeaveSelector.start (ports15E j) false k) 1596 =
      LeaveSelector.signExpr (ports15E j) k ∧
    sim (prepare15E j) (LeaveSelector.start (ports15E j) false k) 1597 =
      conj (LeaveSelector.crossing (ports15E j) k) (LeaveSelector.signExpr (ports15E j) k) := by
  have hs := (LeaveJ7.SelRen.sim_rel (ren15E_inj j) (LeaveJ7.prepare 12) LeaveJ7.SelRen.prep10_in _ _
    (LeaveJ7.SelRen.start_good k) (sel15E_start_rel j k)).1
  have c10 := LeaveJ7.SelRen.cert10_control k
  simp only [reads, controls, List.cons.injEq] at c10
  have hg := geom15E_facts j; dsimp only at hg
  have ha12 : Shadow7.a0P 225 - 1 = 392 := by decide
  have hs12 : start 12 = 225 := by decide
  have he12 : Shadow7.e0P (start 12) = 1710 := by decide
  have hcross : LeaveJ7.SelRen.rE (ren15E j) (LeaveSelector.crossing (LeaveJ7.ports 12) k) =
      LeaveSelector.crossing (ports15E j) k := by
    unfold LeaveSelector.crossing; by_cases h : enabled k = true
    · simp only [h, ↓reduceIte, LeaveJ7.SelRen.rE, LeaveJ7.ports, ports15E, hs12, ha12]
      have hk := LeaveJ7.SelRen.key_le k
      have : ren15E j (392 + key k) = a015E (start15E j) - 1 + key k := by
        unfold ren15E; rw [if_neg (by omega), if_pos (by omega)]; omega
      rw [this]
    · simp only [h, Bool.false_eq_true, ↓reduceIte]; rfl
  have hsuf : ∀ (l : List Nat) (acc : LeaveSelector.Expr), (∀ x ∈ l, x < 15) →
      LeaveJ7.SelRen.rE (ren15E j) (l.foldl (fun rest x => conj rest (.wire (225 + 16 + x))) acc) =
        l.foldl (fun rest x => conj rest (.wire (start15E j + 16 + x))) (LeaveJ7.SelRen.rE (ren15E j) acc) := by
    intro l; induction l with
    | nil => intro _ _; rfl
    | cons x xs ih =>
      intro acc hx; simp only [List.foldl_cons]
      have h1 := hx x List.mem_cons_self
      have hw : LeaveJ7.SelRen.rE (ren15E j) (.wire (225 + 16 + x)) = .wire (start15E j + 16 + x) := by
        show Expr.wire (ren15E j (225 + 16 + x)) = Expr.wire (start15E j + 16 + x)
        have : ren15E j (225 + 16 + x) = start15E j + 16 + x := by unfold ren15E; rw [if_pos (by omega)]; omega
        rw [this]
      rw [ih _ (fun y hy => hx y (List.mem_cons_of_mem _ hy)), LeaveJ7.SelRen.rE_conj, hw]
  have hsign : LeaveJ7.SelRen.rE (ren15E j) (LeaveSelector.signExpr (LeaveJ7.ports 12) k) =
      LeaveSelector.signExpr (ports15E j) k := by
    unfold LeaveSelector.signExpr LeaveSelector.suffixExpr
    by_cases h : (LeaveSelector.right k && decide (0 < key k)) = true
    · simp only [h, ↓reduceIte, LeaveJ7.ports, ports15E, hs12]
      exact hsuf _ (.bit true) (fun x hx => List.mem_range.mp (List.mem_of_mem_drop hx))
    · simp only [h, Bool.false_eq_true, ↓reduceIte]; rfl
  have hc := hs 1716 (by decide); have hn := hs 1717 (by decide)
  have h96 := hs 1596 (by decide); have h97 := hs 1597 (by decide)
  simp only [ren15E, show ¬ (241 ≤ 1716 ∧ 1716 ≤ 255) by decide, show ¬ (392 ≤ 1716 ∧ 1716 ≤ 407) by decide,
    show ¬ (241 ≤ 1717 ∧ 1717 ≤ 255) by decide, show ¬ (392 ≤ 1717 ∧ 1717 ≤ 407) by decide,
    show ¬ (241 ≤ 1596 ∧ 1596 ≤ 255) by decide, show ¬ (392 ≤ 1596 ∧ 1596 ≤ 407) by decide,
    show ¬ (241 ≤ 1597 ∧ 1597 ≤ 255) by decide, show ¬ (392 ≤ 1597 ∧ 1597 ≤ 407) by decide,
    show (1717 : Nat) ≠ 1716 by decide, show (1596 : Nat) ≠ 1716 by decide, show (1596 : Nat) ≠ 1717 by decide,
    show (1597 : Nat) ≠ 1716 by decide, show (1597 : Nat) ≠ 1717 by decide, ↓reduceIte] at hc hn h96 h97
  change sim (prepare15E j) _ _ = _ at hc hn h96 h97
  obtain ⟨c1, c2, c3, c4, -⟩ := c10
  have c1' : sim (LeaveJ7.prepare 12) (LeaveSelector.start (LeaveJ7.ports 12) false k) 1717 = .bit (nearby k) := by
    simpa only [LeaveJ7.ports, he12] using c1
  have c2' : sim (LeaveJ7.prepare 12) (LeaveSelector.start (LeaveJ7.ports 12) false k) 1716 = LeaveSelector.crossing (LeaveJ7.ports 12) k := by
    simpa only [LeaveJ7.ports, he12] using c2
  rw [c2', hcross] at hc; rw [c1'] at hn; rw [c3, hsign] at h96
  rw [c4, LeaveJ7.SelRen.rE_conj, hcross, hsign] at h97
