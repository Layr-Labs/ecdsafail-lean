    (u3 m1 m2 m3 u).basis (StairTerminalV3.terminalPerm q) = ρ (OB5.sig 504 q) := by
  obtain ⟨-, ⟨z, zst, nvz⟩, kz, fr, -⟩ := traj504 x hx0 hxp u pre1 preC hsh m1 m2 m3
  obtain ⟨va, ze⟩ := stage_agree x z.basis ρ zst hρ
  obtain ⟨h16, hr, hc⟩ := hq
  have e : OB5.sig 504 q = base (OB5.sig 504 q - 16) := (Nat.sub_add_cancel h16).symm
  refine Eq.trans ?_ (congrArg ρ e).symm
  rcases hc with ⟨hm, hv, hval | hzero⟩ | ⟨hzero, hk⟩
  · rw [hm, nvz _ (by unfold StairFirstTickV3.Virt; omega)]
    exact va _ hr hval
  · rw [hm, nvz _ (by unfold StairFirstTickV3.Virt; omega)]
    exact ((ze _ hr hzero).1).trans ((ze _ hr hzero).2).symm
  · refine Eq.trans ?_ ((ze _ hr hzero).2).symm
    rcases hk with ⟨h1, h2⟩ | ⟨h1, h2, h3, h4⟩
    · exact kz _ h1 h2
    · exact (fr _ h3 h4).trans (preC _ h1 h2)

/-! ## K4C (replay budget): `Chk` on literal bit masks, one pass per program

`Chk` tested membership in `ZList 12`, `walkSites 12`, `CT`, `futurePayload 12`,
`unpackSites 12` and the sign pools by list scans, re-evaluated per wire, and the support of
each block was a `Finset` union.  Every list is now a literal mask (checked once below), and
each block is checked by one linear pass over its instructions (`k4cAll`). -/

























theorem chk_reverse : ∀ q ∈ wires StairTerminalV3.reverseRecord, Chk q := by
  have cl : ∀ q ∈ wires (skywalkArithmeticClear base), Chk q := k4c_chk_all (by decide +kernel)
  have tk : ∀ q ∈ wires (renameProgram (OB5.sig 511) tickR), Chk q :=
    k4c_chk_all (by decide +kernel)
  have up : ∀ y ∈ wires (Rolling1588.unpackAtTick true 510), Chk (OB5.sig 510 y) :=
    k4c_chk_all' (by decide +kernel)
  have k15 : ∀ y ∈ StairTerminalV3.cand15Sites, Chk (OB5.sig 510 y) :=
    k4c_chk_list (by decide +kernel)
  intro q hq
  simp only [StairTerminalV3.reverseRecord, wires_append, Finset.mem_union] at hq
  rcases hq with hc | ht | hu
  · exact cl q hc
  · exact tk q ht
  · rw [renameProgram_support, Finset.mem_image] at hu
    obtain ⟨y, hy, rfl⟩ := hu
    rw [wires_append, Finset.mem_union] at hy
    rcases hy with hy | hy
    · exact up y hy
    · exact k15 y (List.mem_toFinset.mp (StairTerminalV3.candidate15_support hy))




