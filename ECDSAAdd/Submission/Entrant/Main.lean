theorem sel15E_prepared (j : Fin 4) (s : State) (m : List Bool) (v : BasisState)
    (small : Nat) (k : Mode)
    (mode : k = farMode (s.basis (e015E (start15E j) + 3)) (s.basis (e015E (start15E j) + 4)) small)
    (a : s.basis 1559 = false) (b : s.basis 1560 = false)
