    simp only [clear,List.append_assoc]
  have ap {P Q : Program} (h1 : GatePhysical P) (h2 : GatePhysical Q) : GatePhysical (P++Q) :=
    (gatePhysical_append P Q).mpr ⟨h1,h2⟩
  have pz : GatePhysical (K.R.m6++K.R.m7z++K.R.m8z) := by
    have h := p.2.2.1
