section WWidths
/-! Tighter integer-pass width schedule.

The Skywalk integer passes size tick `i` by `min 258 (514-i)` (route) and
`min 258 (513-i)` (adder), derived from the product cap `u+v ≤ 2^(512-i)`.
Iterating the exponent budget of `SkywalkTerminationBudget` gives the strict
witnesses `u < 2^a`, `v < 2^b` with `a+b = 512-i`, hence `u+v ≤ 2^(511-i)`:
one bit tighter.  Moreover, for a modulus `p ≤ 2^256-2^32`, the sum is below
`2^256` from round 224 on: an odd step halves `u+v < 2^257`, and before the
first odd step `v = p` and `u = x/2^i < 2^32`.  The route of ticks 225–510
and the adder of ticks 224–509 are one bit narrower; the widths at stages 0,
1 and 512 are unchanged. -/
set_option maxRecDepth 4096
set_option maxHeartbeats 400000
set_option exponentiation.threshold 512

namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Stage/route width: `min 258 (514-i)` lowered by one on ticks 225–510. -/
@[irreducible] def narrowSkywalkRouteWidth (i : Nat) : Nat :=
  min (min 258 (514-i) - (min 1 (511-i) - min 1 (256-i))) (257 + min 1 (225-i))

/-- Adder width of tick `i`, equal to the next stage width. -/
@[irreducible] def narrowSkywalkWidth (i : Nat) : Nat :=
  min (min 258 (513-i) - (min 1 (510-i) - min 1 (255-i))) (257 + min 1 (224-i))

theorem narrowSkywalkRouteWidth_bounds (i : Nat) (hi : i<512) :
    3≤narrowSkywalkRouteWidth i ∧ narrowSkywalkRouteWidth i≤258 ∧
    narrowSkywalkRouteWidth i≤min 258 (514-i) := by
  unfold narrowSkywalkRouteWidth
  omega

theorem narrowSkywalkWidth_bounds (i : Nat) (hi : i<512) :
    2≤narrowSkywalkWidth i ∧ narrowSkywalkWidth i≤258 ∧
    narrowSkywalkWidth i≤min 258 (513-i) := by
  unfold narrowSkywalkWidth
  omega

theorem narrowSkywalkRouteWidth_zero : narrowSkywalkRouteWidth 0=258 := by
  unfold narrowSkywalkRouteWidth; rfl

theorem narrowSkywalkRouteWidth_one : narrowSkywalkRouteWidth 1=258 := by
  unfold narrowSkywalkRouteWidth; rfl

theorem narrowSkywalkRouteWidth_512 : narrowSkywalkRouteWidth 512=2 := by
  unfold narrowSkywalkRouteWidth; rfl

theorem narrowSkywalkWidth_zero : narrowSkywalkWidth 0=258 := by
  unfold narrowSkywalkWidth; rfl

/-- The schedule agrees with the original one at the shared endpoints. -/
theorem narrowSkywalkRouteWidth_endpoints :
    narrowSkywalkRouteWidth 0=Arithmetic.narrowSkywalkRouteWidth 0 ∧
    narrowSkywalkRouteWidth 1=Arithmetic.narrowSkywalkRouteWidth 1 ∧
    narrowSkywalkRouteWidth 512=Arithmetic.narrowSkywalkRouteWidth 512 ∧
    narrowSkywalkWidth 0=Arithmetic.narrowSkywalkWidth 0 := by
  rw [narrowSkywalkRouteWidth_zero,narrowSkywalkRouteWidth_one,narrowSkywalkRouteWidth_512,
    narrowSkywalkWidth_zero]
  exact ⟨rfl,rfl,rfl,rfl⟩

private theorem pow_pair (a b : Nat) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    2^a+2^b ≤ 2^(a+b-1)+2 := by
  obtain ⟨c,rfl⟩ : ∃ c, a=c+1 := ⟨a-1,by omega⟩
  obtain ⟨d,rfl⟩ : ∃ d, b=d+1 := ⟨b-1,by omega⟩
  have e : c+1+(d+1)-1=(c+d)+1 := by omega
  rw [e,pow_succ,pow_succ,pow_succ,pow_add]
  have hc : 1 ≤ 2^c := Nat.one_le_two_pow
  have hd : 1 ≤ 2^d := Nat.one_le_two_pow
  nlinarith

/-- Exponent-budget sum cap: after `i` rounds from strict widths `a,b` the
sum is at most `2^(a+b-1-i)`. -/
theorem iter_sum_budget : ∀ (i a b : Nat) (z : SkywalkNat.State),
    0<z.v → z.v%2=1 → z.u.Coprime z.v → z.u<2^a → z.v<2^b → i+1 ≤ a+b →
      (SkywalkNat.step^[i] z).u+(SkywalkNat.step^[i] z).v ≤ 2^(a+b-1-i) := by
  intro i
  induction i with
  | zero =>
    intro a b z hv0 _ hc hu hv _
    simp only [Function.iterate_zero,id_eq,Nat.sub_zero]
    by_cases hz : z.u=0
    · have h1 : z.v=1 := by
        have g : z.u.gcd z.v=1 := hc
        rwa [hz,Nat.gcd_zero_left] at g
      rw [hz,h1]
      exact Nat.one_le_two_pow
    · have ha : 1 ≤ a := by
        by_contra h
        have : a=0 := by omega
        rw [this,pow_zero] at hu
        omega
      have hb : 1 ≤ b := by
        by_contra h
        have : b=0 := by omega
        rw [this,pow_zero] at hv
        omega
      have := pow_pair a b ha hb
      omega
  | succ i ih =>
    intro a b z hv0 hvo hc hu hv hab
    by_cases hz : z.u=0
    · rw [SkywalkNat.iter_fixed_of_u_zero z (i+1) hz]
      have h1 : z.v=1 := by
        have g : z.u.gcd z.v=1 := hc
        rwa [hz,Nat.gcd_zero_left] at g
      rw [hz,h1]
      exact Nat.one_le_two_pow
    · obtain ⟨a',b',he,hu',hv'⟩ :=
        SkywalkNat.step_exponent_budget z a b (Nat.pos_of_ne_zero hz) hv0 hu hv
      have valid := SkywalkNat.step_v_odd_pos z hv0 hvo
      have cop := SkywalkNat.step_coprime z hvo hc
      have rest := ih a' b' (SkywalkNat.step z) valid.1 valid.2 cop hu' hv' (by omega)
      rw [Function.iterate_succ_apply]
      have e : a'+b'-1-i=a+b-1-(i+1) := by omega
      rw [e] at rest
      exact rest

/-- Complete-trajectory form for 256-bit inputs. -/
theorem iter_sum_width (x p i : Nat) (hp0 : 0<p) (hx0 : 0<x)
    (hpo : p%2=1) (hp : p<2^256) (hx : x<p) (hc : x.Coprime p) (hi : i ≤ 511) :
    let z := SkywalkNat.step^[i] (SkywalkNat.init x p)
    z.u+z.v ≤ 2^(511-i) := by
  have _ := hx0
  have h := iter_sum_budget i 256 256 (SkywalkNat.init x p) hp0 hpo hc (hx.trans hp) hp (by omega)
  have e : 256+256-1-i=511-i := by omega
  rw [e] at h
  exact h

private theorem step_sum_odd (z : SkywalkNat.State) (hu : z.u%2=1) (hv : z.v%2=1) :
    (SkywalkNat.step z).u+(SkywalkNat.step z).v=(z.u+z.v)/2 := by
  have hz : z.u ≠ 0 := by omega
  have he : ¬ z.u%2=0 := by omega
  unfold SkywalkNat.step
  rw [if_neg hz,if_neg he]
  split_ifs with hle
  · dsimp only; omega
  · dsimp only; omega

private theorem step_sum_le (z : SkywalkNat.State) :
    (SkywalkNat.step z).u+(SkywalkNat.step z).v ≤ z.u+z.v := by
  unfold SkywalkNat.step
  split_ifs <;> (try dsimp only) <;> omega

/-- Either an odd step has already happened (and the sum is below `2^256`),
or the trajectory is still `(x/2^i, p)`. -/
private theorem iter_sum_or_even (x p : Nat) (hx0 : 0<x) (hpo : p%2=1) (hp : p<2^256)
    (hx : x<p) (i : Nat) :
    (SkywalkNat.step^[i] (SkywalkNat.init x p)).u+(SkywalkNat.step^[i] (SkywalkNat.init x p)).v<2^256 ∨
      ((SkywalkNat.step^[i] (SkywalkNat.init x p)).u*2^i=x ∧
        (SkywalkNat.step^[i] (SkywalkNat.init x p)).v=p) := by
  induction i with
  | zero => right; simp [SkywalkNat.init]
  | succ i ih =>
    rw [Function.iterate_succ_apply']
    generalize SkywalkNat.step^[i] (SkywalkNat.init x p)=z at ih ⊢
    rcases ih with h|⟨hu,hv⟩
    · exact Or.inl (lt_of_le_of_lt (step_sum_le z) h)
    · by_cases he : z.u%2=0
      · right
        have hz0 : z.u ≠ 0 := by
          intro h0
          rw [h0,Nat.zero_mul] at hu
          omega
        have hs : SkywalkNat.step z=⟨z.u/2,z.v⟩ := by
          unfold SkywalkNat.step
          rw [if_neg hz0,if_pos he]
        rw [hs]
        refine ⟨?_,hv⟩
        have h2 : z.u=2*(z.u/2) := by omega
        calc z.u/2*2^(i+1)=(2*(z.u/2))*2^i := by rw [pow_succ]; ring
          _=z.u*2^i := by rw [←h2]
          _=x := hu
      · left
        have hvo : z.v%2=1 := by rw [hv]; exact hpo
        rw [step_sum_odd z (by omega) hvo,hv]
        have hle : z.u ≤ x := by
          calc z.u=z.u*1 := (Nat.mul_one _).symm
            _ ≤ z.u*2^i := Nat.mul_le_mul_left _ Nat.one_le_two_pow
            _=x := hu
        have h2 : (2:Nat)^257=2*2^256 := by norm_num
        have hlt : z.u+p<2^257 := by omega
        omega

/-- From round 224 on the sum is below `2^256` when `p ≤ 2^256-2^32`. -/
theorem iter_sum_late (x p i : Nat) (hx0 : 0<x) (hpo : p%2=1) (hp : p<2^256)
    (hq : p+2^32 ≤ 2^256) (hx : x<p) (hi : 224 ≤ i) :
    (SkywalkNat.step^[i] (SkywalkNat.init x p)).u+(SkywalkNat.step^[i] (SkywalkNat.init x p)).v<2^256 := by
  rcases iter_sum_or_even x p hx0 hpo hp hx i with h|⟨hu,hv⟩
  · exact h
  · rw [hv]
    generalize (SkywalkNat.step^[i] (SkywalkNat.init x p)).u=u at hu ⊢
    have h1 : u*2^224 ≤ u*2^i := Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by norm_num) hi)
    have h2 : (2:Nat)^256=2^32*2^224 := by norm_num
    have hu32 : u<2^32 := by
      by_contra hc
      have h3 := Nat.mul_le_mul_right (2^224) (Nat.le_of_not_gt hc)
      omega
    omega

/-- Universal input fit for the route at the tighter stage width. -/
theorem narrowSkywalkRoute_iter_fit (x p i : Nat) (hp0 : 0<p) (hx0 : 0<x)
    (hpo : p%2=1) (hp : p<2^256) (hq : p+2^32 ≤ 2^256) (hx : x<p) (hc : x.Coprime p) (hi : i<512) :
    let r := SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))
    let n := narrowSkywalkRouteWidth i;
    -((2^(n-1):Nat):Int)≤r.a ∧ r.a<((2^(n-1):Nat):Int) ∧
    -((2^(n-1):Nat):Int)≤r.b ∧ r.b<((2^(n-1):Nat):Int) := by
  dsimp only
  let z := SkywalkNat.step^[i] (SkywalkNat.init x p)
  obtain ⟨G,S,he⟩ := SkywalkTrace.iter_encoded i false false (SkywalkNat.init x p) hp0 hpo
  simp only [SkywalkNat.init] at he
  rw [he]
  have hb := SkywalkRails.encode_abs_sum_bound G S z.u z.v (z.u+z.v) (Nat.le_refl _)
  have hsum : z.u+z.v<2^(narrowSkywalkRouteWidth i-1) := by
    by_cases hi1 : i≤224
    · have hn : narrowSkywalkRouteWidth i=258 := by unfold narrowSkywalkRouteWidth; omega
      rw [hn]
      exact SkywalkNat.iter_sum_initial_width p x 256 i hp hx
    by_cases hi0 : i≤255
    · have hn : narrowSkywalkRouteWidth i=257 := by unfold narrowSkywalkRouteWidth; omega
      rw [hn]
      exact iter_sum_late x p i hx0 hpo hp hq hx (by omega)
    · have hw := iter_sum_width x p i hp0 hx0 hpo hp hx hc (by omega)
      change z.u+z.v≤2^(511-i) at hw
      have hn : narrowSkywalkRouteWidth i-1=(511-i)+1 ∨ (i=511 ∧ narrowSkywalkRouteWidth i-1=2) := by
        unfold narrowSkywalkRouteWidth; omega
      rcases hn with hn|⟨h511,hn⟩
      · rw [hn,pow_succ]
        have hpos : 0<2^(511-i) := by positivity
        omega
      · rw [hn]
        subst h511
        norm_num at hw
        omega
  have hsum' : ((z.u+z.v:Nat):Int)<((2^(narrowSkywalkRouteWidth i-1):Nat):Int) := by
    exact_mod_cast hsum
  have ha := abs_le.mp hb.1
  have hb' := abs_le.mp hb.2
  change -((2^(narrowSkywalkRouteWidth i-1):Nat):Int)≤(SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a ∧
    (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a<((2^(narrowSkywalkRouteWidth i-1):Nat):Int) ∧
    -((2^(narrowSkywalkRouteWidth i-1):Nat):Int)≤(SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b ∧
    (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b<((2^(narrowSkywalkRouteWidth i-1):Nat):Int)
  exact ⟨by omega,by omega,by omega,by omega⟩

/-- Universal input fit for the narrowed adder of tick `i`. -/
theorem narrowSkywalk_iter_fit (x p i : Nat) (hp0 : 0<p) (hx0 : 0<x)
    (hpo : p%2=1) (hp : p<2^256) (hq : p+2^32 ≤ 2^256) (hx : x<p) (hc : x.Coprime p) (hi : i<512) :
    let r := SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))
    let n := narrowSkywalkWidth i
    (r.a+r.b)%2=1 ∧
    -((2^(n-1):Nat):Int) ≤ (SkywalkRails.route r.a r.b).1/2 ∧
    (SkywalkRails.route r.a r.b).1/2 < ((2^(n-1):Nat):Int) ∧
    -((2^(n-1):Nat):Int) ≤ (SkywalkRails.route r.a r.b).2 ∧
    (SkywalkRails.route r.a r.b).2 < ((2^(n-1):Nat):Int) := by
  dsimp only
  let z := SkywalkNat.step^[i] (SkywalkNat.init x p)
  let k := narrowSkywalkWidth i-1
  have hk : 0<k := by dsimp only [k]; unfold narrowSkywalkWidth; omega
  have hn : narrowSkywalkWidth i-1=k := rfl
  have hsum : z.u+z.v≤2^k := by
    by_cases he1 : i≤223
    · have hk' : k=257 := by dsimp only [k]; unfold narrowSkywalkWidth; omega
      rw [hk']
      exact Nat.le_of_lt (SkywalkNat.iter_sum_initial_width p x 256 i hp hx)
    by_cases he : i≤254
    · have hk' : k=256 := by dsimp only [k]; unfold narrowSkywalkWidth; omega
      rw [hk']
      exact Nat.le_of_lt (iter_sum_late x p i hx0 hpo hp hq hx (by omega))
    · have hw := iter_sum_width x p i hp0 hx0 hpo hp hx hc (by omega)
      change z.u+z.v≤2^(511-i) at hw
      have hle : 511-i≤k := by dsimp only [k]; unfold narrowSkywalkWidth; omega
      exact hw.trans (Nat.pow_le_pow_right (by norm_num) hle)
  obtain ⟨G,S,he⟩ := SkywalkTrace.iter_encoded i false false (SkywalkNat.init x p) hp0 hpo
  simp only [SkywalkNat.init] at he
  rw [he]
  have hvalid := SkywalkNat.iter_valid i (SkywalkNat.init x p) hp0 hpo
  have hpar := SkywalkRails.encode_odd_sum G S (z.u:Int) (z.v:Int) (by
    have hodd := hvalid.2.1
    exact_mod_cast hodd)
  have hb := SkywalkRails.encode_abs_sum_bound G S z.u z.v (2^k) hsum
  have hr := SkywalkRails.route_half_width _ _ k hk hpar hb.1 hb.2
  have hpw : (2^k:Nat)=2^(k-1)*2 := by
    calc
      2^k=2^((k-1)+1) := by congr 1; omega
      _=2^(k-1)*2 := pow_succ 2 (k-1)
  have hpw' : ((2^k:Nat):Int)=((2^(k-1):Nat):Int)*2 := by
    exact_mod_cast hpw
  have hpositive : 0<((2^(k-1):Nat):Int) := by positivity
  have hH := abs_le.mp hr.2
  have hO := abs_lt.mp hr.1
  rw [hn]
  change ((SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a+
    (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b)%2=1 ∧
    -((2^k:Nat):Int)≤(SkywalkRails.route (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a
      (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b).1/2 ∧
    (SkywalkRails.route (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a
      (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b).1/2<((2^k:Nat):Int) ∧
    -((2^k:Nat):Int)≤(SkywalkRails.route (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a
      (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b).2 ∧
    (SkywalkRails.route (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).a
      (SkywalkRails.encode G S (z.u:Int) (z.v:Int)).b).2<((2^k:Nat):Int)
  exact ⟨hpar,by omega,by omega,by omega,hO.2⟩

end ECDSAAdd.Entrant.W
end WWidths

section WCompactSkywalkTickLayout
/-! Copy of `Arithmetic/CompactSkywalkTickLayout` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

def compactSkywalkTickPreWidth (i : Nat) : Nat := narrowSkywalkRouteWidth i
def compactSkywalkTickPostWidth (i : Nat) : Nat := narrowSkywalkWidth i

/-- All arithmetic ports are the current physical prefix, with a fresh clean
extension. No omitted 258-bit sign copies are reconstructed for this tick. -/
def compactSkywalkTickLayout (w : Nat → Wire) (i : Nat) : SkywalkIntegerLayout :=
  let n := compactSkywalkTickPreWidth i
  { a0:=w i,b0:=w 770,ext:=w (i+n),history:=w (1028+i),
    previous:=w (skywalkPoolPreviousId i),aSign:=w (i+n-1),bSign:=w (770+n-1),
    aMid:=wireBlock w (i+1) (n-2),bMid:=wireBlock w 771 (n-2),
    carry:=wireBlock w 1540 (n-1) }

theorem compactSkywalkTick_width_bounds (i : Nat) (hi : i < 512) :
    3 ≤ compactSkywalkTickPreWidth i ∧ 2 ≤ compactSkywalkTickPostWidth i ∧
    compactSkywalkTickPostWidth i ≤ compactSkywalkTickPreWidth i ∧
    compactSkywalkTickPreWidth i ≤ 258 ∧
    compactSkywalkTickPreWidth i ≤ 514-i ∧
    compactSkywalkTickPostWidth i = compactSkywalkTickPreWidth (i+1) := by
  have a := narrowSkywalkRouteWidth_bounds i hi
  have b := narrowSkywalkWidth_bounds i hi
  unfold compactSkywalkTickPreWidth compactSkywalkTickPostWidth
    narrowSkywalkRouteWidth narrowSkywalkWidth at *
  omega

private theorem blockLast (w : Nat → Wire) (start count : Nat) (hc : 0 < count) :
    wireBlock w start (count-1)++[w (start+count-1)] = wireBlock w start count := by
  have h := wireBlock_append w start (count-1) 1
  have one : wireBlock w (start+(count-1)) 1 = [w (start+(count-1))] := by
    simp [wireBlock,List.range']
  rw [one] at h
  simpa only [show start+(count-1) = start+count-1 by omega,
    show count-1+1 = count by omega] using h

theorem compactSkywalkTick_ah (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).ah = wireBlock w (i+1) (compactSkywalkTickPreWidth i-1) := by
  have hb := compactSkywalkTick_width_bounds i hi
  have h := blockLast w (i+1) (compactSkywalkTickPreWidth i-1) (by omega)
  change wireBlock w (i+1) (compactSkywalkTickPreWidth i-2)++
    [w (i+compactSkywalkTickPreWidth i-1)] = _
  simpa only [show (compactSkywalkTickPreWidth i-1)-1 = compactSkywalkTickPreWidth i-2 by omega,
    show (i+1)+(compactSkywalkTickPreWidth i-1)-1 = i+compactSkywalkTickPreWidth i-1 by omega] using h

theorem compactSkywalkTick_bh (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).bh = wireBlock w 771 (compactSkywalkTickPreWidth i-1) := by
  have hb := compactSkywalkTick_width_bounds i hi
  have h := blockLast w 771 (compactSkywalkTickPreWidth i-1) (by omega)
  change wireBlock w 771 (compactSkywalkTickPreWidth i-2)++
    [w (770+compactSkywalkTickPreWidth i-1)] = _
  simpa only [show (compactSkywalkTickPreWidth i-1)-1 = compactSkywalkTickPreWidth i-2 by omega,
    show 771+(compactSkywalkTickPreWidth i-1)-1 = 770+compactSkywalkTickPreWidth i-1 by omega] using h

private theorem blockFirst (w : Nat → Wire) (start count : Nat) (hc : 0 < count) :
    w start::wireBlock w (start+1) (count-1) = wireBlock w start count := by
  have h := wireBlock_append w start 1 (count-1)
  have one : wireBlock w start 1 = [w start] := by simp [wireBlock,List.range']
  rw [one] at h
  simpa only [show 1+(count-1) = count by omega,List.singleton_append] using h

theorem compactSkywalkTick_a (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).a = wireBlock w i (compactSkywalkTickPreWidth i) := by
  have hb := compactSkywalkTick_width_bounds i hi
  rw [SkywalkIntegerLayout.a,compactSkywalkTick_ah w i hi]
  exact blockFirst w i _ (by omega)

theorem compactSkywalkTick_b (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).b = wireBlock w 770 (compactSkywalkTickPreWidth i) := by
  have hb := compactSkywalkTick_width_bounds i hi
  rw [SkywalkIntegerLayout.b,compactSkywalkTick_bh w i hi]
  exact blockFirst w 770 _ (by omega)

theorem compactSkywalkTick_half (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).half = wireBlock w (i+1) (compactSkywalkTickPreWidth i) := by
  have hb := compactSkywalkTick_width_bounds i hi
  rw [SkywalkIntegerLayout.half,compactSkywalkTick_ah w i hi]
  change wireBlock w (i+1) (compactSkywalkTickPreWidth i-1)++
    [w (i+compactSkywalkTickPreWidth i)] = _
  have h := blockLast w (i+1) (compactSkywalkTickPreWidth i) (by omega)
  simpa only [show (i+1)+compactSkywalkTickPreWidth i-1 = i+compactSkywalkTickPreWidth i by omega] using h

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickLayout

section WCompactSkywalkTickValidation
/-! Copy of `Arithmetic/CompactSkywalkTickValidation` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private def compactTickControls (i : Nat) : List Nat :=
  [skywalkPoolPreviousId i,1028+i,i+compactSkywalkTickPreWidth i,i,770]
private def compactTickBlocks (i : Nat) : List Nat :=
  List.range' (i+1) (compactSkywalkTickPreWidth i-1)++
    List.range' 771 (compactSkywalkTickPreWidth i-1)++
    List.range' 1540 (compactSkywalkTickPreWidth i-1)
private def compactTickIds (i : Nat) : List Nat := compactTickControls i++compactTickBlocks i

private theorem compactTickIdsND (i : Nat) (hi : i < 512) : (compactTickIds i).Nodup := by
  have hn := compactSkywalkTick_width_bounds i hi
  have a : (List.range' (i+1) (compactSkywalkTickPreWidth i-1)++
      List.range' 771 (compactSkywalkTickPreWidth i-1)).Nodup := by
    apply List.nodup_append'.mpr
    refine ⟨List.nodup_range',List.nodup_range',?_⟩
    apply List.disjoint_left.mpr
    intro j hj hk
    simp only [List.mem_range'_1] at hj hk
    omega
  have b : (compactTickBlocks i).Nodup := by
    apply List.nodup_append'.mpr
    refine ⟨a,List.nodup_range',?_⟩
    apply List.disjoint_left.mpr
    intro j hj hk
    simp only [List.mem_append,List.mem_range'_1] at hj hk
    omega
  have c : (compactTickControls i).Nodup := by
    by_cases hz : i = 0
    · subst i
      norm_num [compactTickControls,skywalkPoolPreviousId,compactSkywalkTickPreWidth,
        narrowSkywalkRouteWidth]
    · simp [compactTickControls,skywalkPoolPreviousId,hz]
      omega
  apply List.nodup_append'.mpr
  refine ⟨c,b,?_⟩
  apply List.disjoint_left.mpr
  intro j hj hk
  simp only [compactTickControls,List.mem_cons,List.not_mem_nil,or_false] at hj
  simp only [compactTickBlocks,List.mem_append,List.mem_range'_1] at hk
  by_cases hz : i = 0
  · simp only [skywalkPoolPreviousId,if_pos hz] at hj
    omega
  · simp only [skywalkPoolPreviousId,if_neg hz] at hj
    omega

private theorem compactTickIdsBound (i j : Nat) (hi : i < 512)
    (hj : j ∈ compactTickIds i) : j < 1798 := by
  have hn := compactSkywalkTick_width_bounds i hi
  simp only [compactTickIds,compactTickControls,compactTickBlocks,List.mem_append,
    List.mem_cons,List.not_mem_nil,List.mem_range'_1,or_false] at hj
  by_cases hz : i = 0
  · simp only [skywalkPoolPreviousId,if_pos hz] at hj
    omega
  · simp only [skywalkPoolPreviousId,if_neg hz] at hj
    omega

private theorem compactTickWires (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).wires = (compactTickIds i).map w := by
  change w (skywalkPoolPreviousId i)::w (1028+i)::w (i+compactSkywalkTickPreWidth i)::
    w i::w 770::((compactSkywalkTickLayout w i).ah++(compactSkywalkTickLayout w i).bh++
      wireBlock w 1540 (compactSkywalkTickPreWidth i-1)) = _
  rw [compactSkywalkTick_ah w i hi,compactSkywalkTick_bh w i hi]
  simp [compactTickIds,compactTickControls,compactTickBlocks,wireBlock,List.map_append]

/-- The actual variable-width local tick has no aliases under pool injectivity. -/
theorem compactSkywalkTick_valid (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) : (compactSkywalkTickLayout w i).Valid := by
  constructor
  · simp [compactSkywalkTickLayout,wireBlock]
  · rw [compactSkywalkTick_ah w i hi]
    simp [compactSkywalkTickLayout,wireBlock]
  · rw [compactTickWires w i hi]
    apply List.Nodup.map_on
    · intro a ha b hb he
      exact skywalkPool_index_inj w hn a b (compactTickIdsBound i a hi ha)
        (compactTickIdsBound i b hi hb) he
    · exact compactTickIdsND i hi

theorem compactSkywalkTick_local_support (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickLayout w i).wires ⊆ skywalkPoolWires w := by
  rw [compactTickWires w i hi]
  intro q hq
  obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
  simp only [skywalkPoolWires,wireBlock,List.mem_map,List.mem_range'_1]
  exact ⟨j,by have h := compactTickIdsBound i j hi hj; omega,rfl⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickValidation

section WCompactSkywalkTickProgram
/-! Copy of `Arithmetic/CompactSkywalkTickProgram` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

def compactSkywalkTickARelease (w : Nat → Wire) (i : Nat) : CompactSkywalkSignReleaseLayout :=
  compactSkywalkSignWord (compactSkywalkTickLayout w i).half (compactSkywalkTickPostWidth i)
def compactSkywalkTickBRelease (w : Nat → Wire) (i : Nat) : CompactSkywalkSignReleaseLayout :=
  compactSkywalkSignWord (compactSkywalkTickLayout w i).b (compactSkywalkTickPostWidth i)
def compactSkywalkTickCleanup (w : Nat → Wire) (i : Nat) : Program :=
  compactSkywalkSignRelease (compactSkywalkTickARelease w i)++
    compactSkywalkSignRelease (compactSkywalkTickBRelease w i)

/-- Actual compact route/record on local prefixes, followed only by CX release
of the post-boundary sign tails. No full258 reconstruction is emitted. -/
def compactSkywalkTick (w : Nat → Wire) (i : Nat) : Program :=
  narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)++
    compactSkywalkTickCleanup w i

attribute [local irreducible] narrowSkywalkTick compactSkywalkSignRelease

private theorem recordWordsND (L : SkywalkIntegerLayout) (hv : L.Valid) :
    L.half.Nodup ∧ L.b.Nodup ∧ L.half.Disjoint L.b := by
  have h := (List.nodup_cons.mp (L.record_nodup hv)).2
  exact List.nodup_append'.mp (List.nodup_append'.mp h).1

theorem compactSkywalkTick_release_valid (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    (compactSkywalkTickARelease w i).Valid ∧ (compactSkywalkTickBRelease w i).Valid := by
  have h := compactSkywalkTick_width_bounds i hi
  have nd := recordWordsND _ (compactSkywalkTick_valid w i hi hn)
  refine ⟨compactSkywalkSignWord_valid _ _ (by omega) ?_ nd.1,
    compactSkywalkSignWord_valid _ _ (by omega) ?_ nd.2.1⟩
  · rw [compactSkywalkTick_half w i hi,wireBlock_length]
    exact h.2.2.1
  · rw [compactSkywalkTick_b w i hi,wireBlock_length]
    exact h.2.2.1

theorem compactSkywalkTick_words_disjoint (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    (compactSkywalkTickLayout w i).half.Disjoint (compactSkywalkTickLayout w i).b :=
  (recordWordsND _ (compactSkywalkTick_valid w i hi hn)).2.2

theorem compactSkywalkTick_cleanup_counts (w : Nat → Wire) (i : Nat) :
    toffoliCount (compactSkywalkTickCleanup w i) = 0 ∧
    measurementCount (compactSkywalkTickCleanup w i) = 0 := by
  have a := compactSkywalkSignRelease_counts (compactSkywalkTickARelease w i)
  have b := compactSkywalkSignRelease_counts (compactSkywalkTickBRelease w i)
  rw [compactSkywalkTickCleanup,toffoliCount_append,measurementCount_append,a.1,a.2.1,b.1,b.2.1]
  exact ⟨rfl,rfl⟩

theorem compactSkywalkTick_counts (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (compactSkywalkTick w i) =
      (compactSkywalkTickPreWidth i-1)+(compactSkywalkTickPostWidth i-1) ∧
    measurementCount (compactSkywalkTick w i) = compactSkywalkTickPostWidth i-1 := by
  have h := compactSkywalkTick_width_bounds i hi
  have len : (compactSkywalkTickLayout w i).half.length = compactSkywalkTickPreWidth i := by
    rw [compactSkywalkTick_half w i hi,wireBlock_length]
  have c := narrowSkywalkTick_counts _ (compactSkywalkTick_valid w i hi hn)
    (compactSkywalkTickPostWidth i) (by omega) (by rw [len]; exact h.2.2.1)
  have z := compactSkywalkTick_cleanup_counts w i
  rw [compactSkywalkTick,toffoliCount_append,measurementCount_append,c.1,c.2.1,z.1,z.2]
  rw [compactSkywalkTick_ah w i hi,wireBlock_length]
  exact ⟨by omega,by omega⟩

theorem compactSkywalkTick_cleanup_support (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    wires (compactSkywalkTickCleanup w i) ⊆ (compactSkywalkTickLayout w i).wires.toFinset := by
  have h := compactSkywalkTick_width_bounds i hi
  have a := (compactSkywalkSignWord_support (compactSkywalkTickLayout w i).half
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1)).1
  have b := (compactSkywalkSignWord_support (compactSkywalkTickLayout w i).b
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_b w i hi,wireBlock_length]; exact h.2.2.1)).1
  intro q hq
  simp only [compactSkywalkTickCleanup,wires_append,Finset.mem_union] at hq
  rcases hq with hq|hq
  · have ha := List.mem_toFinset.mp (a hq)
    simp only [SkywalkIntegerLayout.half,SkywalkIntegerLayout.wires,List.mem_toFinset,
      List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at ha ⊢
    tauto
  · have hb := List.mem_toFinset.mp (b hq)
    simp only [SkywalkIntegerLayout.b,SkywalkIntegerLayout.wires,List.mem_toFinset,
      List.mem_append,List.mem_cons] at hb ⊢
    tauto

theorem compactSkywalkTick_support (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    wires (compactSkywalkTick w i) ⊆ (compactSkywalkTickLayout w i).wires.toFinset := by
  have h := compactSkywalkTick_width_bounds i hi
  have n := (narrowSkywalkTick_wires_subset _ (compactSkywalkTick_valid w i hi hn)
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1)).1
  have c := compactSkywalkTick_cleanup_support w i hi
  rw [compactSkywalkTick,wires_append,Finset.union_subset_iff]
  exact ⟨n,c⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickProgram

section WCompactSkywalkTickProof
/-! Copy of `Arithmetic/CompactSkywalkTickProof` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem record_fit (H A B : Int) (ha0 : -H ≤ A) (ha1 : A < H)
    (hb0 : -H ≤ B) (hb1 : B < H) :
    -H ≤ signedRecordValue A B ∧ signedRecordValue A B < H := by
  by_cases ha : A < 0 <;> by_cases hb : B < 0 <;>
    simp [signedRecordValue,signedRecordControl,signedIntegerValue,SkywalkRails.neg,ha,hb] <;> omega

/-- Cancellation keeps both post-tick rails inside the strict record interval. -/
theorem compactSkywalkTick_step_fit (A B : Int) (G : Bool) (H : Int)
    (hp : (A+B)%2 = 1)
    (ha0 : -H ≤ (SkywalkRails.route A B).1/2) (ha1 : (SkywalkRails.route A B).1/2 < H)
    (hb0 : -H ≤ (SkywalkRails.route A B).2) (hb1 : (SkywalkRails.route A B).2 < H) :
    -H ≤ (SkywalkRails.step ⟨A,B,G⟩).h ∧ (SkywalkRails.step ⟨A,B,G⟩).h < H ∧
    -H ≤ (SkywalkRails.step ⟨A,B,G⟩).k ∧ (SkywalkRails.step ⟨A,B,G⟩).k < H := by
  have he := SkywalkRails.route_even A B hp
  have hs : SkywalkRails.sameSign ((SkywalkRails.route A B).1/2) (SkywalkRails.route A B).2 =
      SkywalkRails.sameSign (SkywalkRails.route A B).1 (SkywalkRails.route A B).2 := by
    unfold SkywalkRails.sameSign
    rw [SkywalkRails.neg_half _ he]
  have hk := record_fit H ((SkywalkRails.route A B).1/2) (SkywalkRails.route A B).2 ha0 ha1 hb0 hb1
  rw [signedRecordValue_rails,hs] at hk
  exact ⟨ha0,ha1,hk.1,hk.2⟩

/-- The native tick already uses only the actual local prefixes. Every input
fit obligation is the same universally proved post-route envelope. -/
theorem compactSkywalkTick_native_spec (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (A B : Int) (G : Bool) (hp : (A+B)%2 = 1)
    (ha0 : -((2^(compactSkywalkTickPostWidth i-1):Nat):Int) ≤ (SkywalkRails.route A B).1/2)
    (ha1 : (SkywalkRails.route A B).1/2 < ((2^(compactSkywalkTickPostWidth i-1):Nat):Int))
    (hb0 : -((2^(compactSkywalkTickPostWidth i-1):Nat):Int) ≤ (SkywalkRails.route A B).2)
    (hb1 : (SkywalkRails.route A B).2 < ((2^(compactSkywalkTickPostWidth i-1):Nat):Int)) :
    Triple (SkywalkIntegerInput (compactSkywalkTickLayout w i) A B G)
      (narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i))
      (SkywalkIntegerOutput (compactSkywalkTickLayout w i) A B G) := by
  have h := compactSkywalkTick_width_bounds i hi
  exact narrowSkywalkTick_spec _ (compactSkywalkTick_valid w i hi hn) _ (by omega)
    (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1)
    A B G hp ha0 ha1 hb0 hb1

/-- The actual locally emitted native result supplies both sign-release
premises; no post-tick sign-copy oracle is assumed. -/
theorem compactSkywalkTick_native_copies (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (A B : Int) (G : Bool) (hp : (A+B)%2 = 1)
    (ha0 : -((2^(compactSkywalkTickPostWidth i-1):Nat):Int) ≤ (SkywalkRails.route A B).1/2)
    (ha1 : (SkywalkRails.route A B).1/2 < ((2^(compactSkywalkTickPostWidth i-1):Nat):Int))
    (hb0 : -((2^(compactSkywalkTickPostWidth i-1):Nat):Int) ≤ (SkywalkRails.route A B).2)
    (hb1 : (SkywalkRails.route A B).2 < ((2^(compactSkywalkTickPostWidth i-1):Nat):Int))
    (s : State) (m : List Bool)
    (hin : SkywalkIntegerInput (compactSkywalkTickLayout w i) A B G s.basis) :
    let t := run (narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)) m s
    (compactSkywalkTickARelease w i).Copies t.basis ∧
    (compactSkywalkTickBRelease w i).Copies t.basis := by
  dsimp only
  have h := compactSkywalkTick_width_bounds i hi
  have fit := compactSkywalkTick_step_fit A B G _ hp ha0 ha1 hb0 hb1
  have out := (compactSkywalkTick_native_spec w i hi hn A B G hp ha0 ha1 hb0 hb1 s m hin).2
  exact ⟨compactSkywalkSignWord_copies _ _ (by omega)
    (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1) _ _
      out.1 fit.1 fit.2.1,
    compactSkywalkSignWord_copies _ _ (by omega)
    (by rw [compactSkywalkTick_b w i hi,wireBlock_length]; exact h.2.2.1) _ _
      out.2.1 fit.2.2.1 fit.2.2.2⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickProof

section WCompactSkywalkSignReleasePool
/-! Copy of `Arithmetic/CompactSkywalkSignReleasePool` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

def compactSkywalkSignPoolA (w : Nat → Wire) (i : Nat) : CompactSkywalkSignReleaseLayout :=
  compactSkywalkSignWord (skywalkPoolA w i) (narrowSkywalkRouteWidth i)
def compactSkywalkSignPoolB (w : Nat → Wire) (i : Nat) : CompactSkywalkSignReleaseLayout :=
  compactSkywalkSignWord (skywalkPoolB w) (narrowSkywalkRouteWidth i)

def compactSkywalkSignPoolRelease (w : Nat → Wire) (i : Nat) : Program :=
  compactSkywalkSignRelease (compactSkywalkSignPoolA w i)++
    compactSkywalkSignRelease (compactSkywalkSignPoolB w i)
def compactSkywalkSignPoolExpand (w : Nat → Wire) (i : Nat) : Program :=
  compactSkywalkSignExpand (compactSkywalkSignPoolB w i)++
    compactSkywalkSignExpand (compactSkywalkSignPoolA w i)

private theorem blockND (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (start count : Nat) (hb : start+count ≤ 1798) : (wireBlock w start count).Nodup := by
  apply List.Nodup.map_on
  · intro i hi j hj he
    simp only [List.mem_range'_1] at hi hj
    exact skywalkPool_index_inj w hn i j (by omega) (by omega) he
  · exact List.nodup_range'

theorem compactSkywalkSignPool_wordsND (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    (skywalkPoolA w i).Nodup ∧ (skywalkPoolB w).Nodup :=
  ⟨blockND w hn i 258 (by omega),blockND w hn 770 258 (by decide)⟩

theorem compactSkywalkSignPool_valid (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    (compactSkywalkSignPoolA w i).Valid ∧ (compactSkywalkSignPoolB w i).Valid := by
  have hw := narrowSkywalkRouteWidth_bounds i hi
  have nd := compactSkywalkSignPool_wordsND w i hi hn
  exact ⟨compactSkywalkSignWord_valid _ _ (by omega)
    (by simpa [skywalkPoolA,wireBlock] using hw.2.1) nd.1,
    compactSkywalkSignWord_valid _ _ (by omega)
    (by simpa [skywalkPoolB,wireBlock] using hw.2.1) nd.2⟩

theorem compactSkywalkSignPool_wordsDisjoint (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) : (skywalkPoolA w i).Disjoint (skywalkPoolB w) := by
  apply List.disjoint_left.mpr
  intro q ha hb
  simp only [skywalkPoolA,skywalkPoolB,wireBlock,List.mem_map,List.mem_range'_1] at ha hb
  obtain ⟨a,ha,hea⟩ := ha
  obtain ⟨b,hb,heb⟩ := hb
  have he := skywalkPool_index_inj w hn a b (by omega) (by omega) (hea.trans heb.symm)
  omega

/-- The exact universal route bound supplies both physical sign-copy banks
for every complete valid nonzero coprime input and every one of the512 stages. -/
theorem compactSkywalkSignPool_stage_copies (w : Nat → Wire) (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1) (hp : p < 2^256) (hq : p+2^32 ≤ 2^256)
    (hx : x < p) (hc : x.Coprime p) (hi : i < 512) (s : BasisState)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    (compactSkywalkSignPoolA w i).Copies s ∧ (compactSkywalkSignPoolB w i).Copies s := by
  have fit := narrowSkywalkRoute_iter_fit x p i hp0 hx0 hpo hp hq hx hc hi
  have hw := narrowSkywalkRouteWidth_bounds i hi
  exact ⟨compactSkywalkSignWord_copies _ _ (by omega)
    (by simpa [skywalkPoolA,wireBlock] using hw.2.1) s _ hin.1 fit.1 fit.2.1,
    compactSkywalkSignWord_copies _ _ (by omega)
    (by simpa [skywalkPoolB,wireBlock] using hw.2.1) s _ hin.2.1 fit.2.2.1 fit.2.2.2⟩

theorem compactSkywalkSignPool_released_lengths (w : Nat → Wire) (i : Nat) :
    (compactSkywalkSignPoolA w i).released.length = 258-narrowSkywalkRouteWidth i ∧
    (compactSkywalkSignPoolB w i).released.length = 258-narrowSkywalkRouteWidth i := by
  simp [compactSkywalkSignPoolA,compactSkywalkSignPoolB,compactSkywalkSignWord,
    skywalkPoolA,skywalkPoolB,wireBlock]

theorem compactSkywalkSignPool_counts (w : Nat → Wire) (i : Nat) :
    toffoliCount (compactSkywalkSignPoolRelease w i) = 0 ∧
    measurementCount (compactSkywalkSignPoolRelease w i) = 0 ∧
    toffoliCount (compactSkywalkSignPoolExpand w i) = 0 ∧
    measurementCount (compactSkywalkSignPoolExpand w i) = 0 := by
  have a := compactSkywalkSignRelease_counts (compactSkywalkSignPoolA w i)
  have b := compactSkywalkSignRelease_counts (compactSkywalkSignPoolB w i)
  simp only [compactSkywalkSignPoolRelease,compactSkywalkSignPoolExpand,toffoliCount_append,
    measurementCount_append,a.1,a.2.1,a.2.2.1,a.2.2.2,b.1,b.2.1,b.2.2.1,b.2.2.2,Nat.zero_add]
  trivial

/-- All measurement streams are immaterial to these Clifford prefixes. -/

theorem compactSkywalkSign_no_measure_append (p q : Program) (hp : measurementCount p = 0)
    (s : State) (m : List Bool) : run (p++q) m s = run q m (run p m s) := by
  have h := run_take p m s
  rw [hp,List.take_zero] at h
  rw [run_append,hp,List.take_zero,List.drop_zero,h]

/-- Both physical two-bank compositions are exact State inverses. -/
theorem compactSkywalkSignPool_roundtrip (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m1 m2 : List Bool) :
    run (compactSkywalkSignPoolExpand w i) m2 (run (compactSkywalkSignPoolRelease w i) m1 s) = s ∧
    run (compactSkywalkSignPoolRelease w i) m2 (run (compactSkywalkSignPoolExpand w i) m1 s) = s := by
  let A := compactSkywalkSignPoolA w i
  let B := compactSkywalkSignPoolB w i
  have hv := compactSkywalkSignPool_valid w i hi hn
  have ca := compactSkywalkSignRelease_counts A
  have cb := compactSkywalkSignRelease_counts B
  constructor
  · change run (compactSkywalkSignExpand B++compactSkywalkSignExpand A) m2
      (run (compactSkywalkSignRelease A++compactSkywalkSignRelease B) m1 s) = s
    rw [compactSkywalkSign_no_measure_append _ _ ca.2.1,
      compactSkywalkSign_no_measure_append _ _ cb.2.2.2]
    rw [(compactSkywalkSignRelease_roundtrip B hv.2
      (run (compactSkywalkSignRelease A) m1 s) m1 m2).1]
    exact (compactSkywalkSignRelease_roundtrip A hv.1 s m1 m2).1
  · change run (compactSkywalkSignRelease A++compactSkywalkSignRelease B) m2
      (run (compactSkywalkSignExpand B++compactSkywalkSignExpand A) m1 s) = s
    rw [compactSkywalkSign_no_measure_append _ _ cb.2.2.2,
      compactSkywalkSign_no_measure_append _ _ ca.2.1]
    rw [(compactSkywalkSignRelease_roundtrip A hv.1
      (run (compactSkywalkSignExpand B) m1 s) m1 m2).2]
    exact (compactSkywalkSignRelease_roundtrip B hv.2 s m1 m2).2

end ECDSAAdd.Entrant.W
end WCompactSkywalkSignReleasePool

section WCompactSkywalkSignReleasePair
/-! Copy of `Arithmetic/CompactSkywalkSignReleasePair` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem word_subviews (r : List Wire) (n : Nat) (hn : 0 < n) (hle : n ≤ r.length) :
    (compactSkywalkSignWord r n).retained⊆r ∧
    (compactSkywalkSignWord r n).released⊆r ∧ (compactSkywalkSignWord r n).sign ∈ r := by
  have he := compactSkywalkSignWord_expanded r n hn hle
  refine ⟨?_,?_,?_⟩
  · intro q hq
    rw [←he]
    exact List.mem_append_left _ hq
  · intro q hq
    rw [←he]
    exact List.mem_append_right _ hq
  · have hs : (compactSkywalkSignWord r n).sign ∈ (compactSkywalkSignWord r n).retained := by
      simp [CompactSkywalkSignReleaseLayout.retained]
    have hx : (compactSkywalkSignWord r n).sign ∈ (compactSkywalkSignWord r n).expanded :=
      List.mem_append_left _ hs
    simpa only [he] using hx

private theorem same_signed (r : List Wire) (s t : BasisState)
    (he : ∀q ∈ r,t q = s q) : signedRegValue r t = signedRegValue r s := by
  unfold signedRegValue
  rw [regValue_congr r t s he]

/-- The emitted two-bank release really frees both physical tails, preserves
both exact signed prefix values and every outsider, and changes no phase. -/
theorem compactSkywalkSignPool_release_correct (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m : List Bool)
    (hcA : (compactSkywalkSignPoolA w i).Copies s.basis)
    (hcB : (compactSkywalkSignPoolB w i).Copies s.basis) :
    (run (compactSkywalkSignPoolRelease w i) m s).phase = s.phase ∧
    (compactSkywalkSignPoolA w i).Clean (run (compactSkywalkSignPoolRelease w i) m s).basis ∧
    (compactSkywalkSignPoolB w i).Clean (run (compactSkywalkSignPoolRelease w i) m s).basis ∧
    signedRegValue (compactSkywalkSignPoolA w i).retained
      (run (compactSkywalkSignPoolRelease w i) m s).basis = signedRegValue (skywalkPoolA w i) s.basis ∧
    signedRegValue (compactSkywalkSignPoolB w i).retained
      (run (compactSkywalkSignPoolRelease w i) m s).basis = signedRegValue (skywalkPoolB w) s.basis ∧
    (∀q,q ∉ skywalkPoolA w i → q ∉ skywalkPoolB w →
      (run (compactSkywalkSignPoolRelease w i) m s).basis q = s.basis q) := by
  let A := compactSkywalkSignPoolA w i
  let B := compactSkywalkSignPoolB w i
  let u := run (compactSkywalkSignRelease A) m s
  let v := run (compactSkywalkSignRelease B) m u
  have hv := compactSkywalkSignPool_valid w i hi hn
  have hw := narrowSkywalkRouteWidth_bounds i hi
  have la : narrowSkywalkRouteWidth i ≤ (skywalkPoolA w i).length := by
    simpa [skywalkPoolA,wireBlock] using hw.2.1
  have lb : narrowSkywalkRouteWidth i ≤ (skywalkPoolB w).length := by
    simpa [skywalkPoolB,wireBlock] using hw.2.1
  have av := word_subviews (skywalkPoolA w i) (narrowSkywalkRouteWidth i) (by omega) la
  have bv := word_subviews (skywalkPoolB w) (narrowSkywalkRouteWidth i) (by omega) lb
  have sa := (compactSkywalkSignWord_support (skywalkPoolA w i)
    (narrowSkywalkRouteWidth i) (by omega) la).1
  have sb := (compactSkywalkSignWord_support (skywalkPoolB w)
    (narrowSkywalkRouteWidth i) (by omega) lb).1
  have hd := compactSkywalkSignPool_wordsDisjoint w i hi hn
  have ub : ∀q ∈ skywalkPoolB w,u.basis q = s.basis q := by
    intro q hq
    exact run_preserves_outside _ m s q (fun hs =>
      List.disjoint_left.mp hd (List.mem_toFinset.mp (sa hs)) hq)
  have va : ∀q ∈ skywalkPoolA w i,v.basis q = u.basis q := by
    intro q hq
    exact run_preserves_outside _ m u q (fun hs =>
      List.disjoint_left.mp hd hq (List.mem_toFinset.mp (sb hs)))
  have uCopiesB : B.Copies u.basis := by
    intro q hq
    rw [ub q (bv.2.1 hq),ub B.sign bv.2.2]
    exact hcB q hq
  have uCleanA := compactSkywalkSignRelease_clean A hv.1 s m hcA
  have vCleanA : A.Clean v.basis := by
    intro q hq
    exact (va q (av.2.1 hq)).trans (uCleanA q hq)
  have vCleanB := compactSkywalkSignRelease_clean B hv.2 u m uCopiesB
  have aValue := (same_signed A.retained u.basis v.basis
    (fun q hq => va q (av.1 hq))).trans
      (compactSkywalkSignRelease_signed A hv.1 s m hcA)
  have bValue := (compactSkywalkSignRelease_signed B hv.2 u m uCopiesB).trans
    (same_signed B.expanded s.basis u.basis (by
      intro q hq
      have he := compactSkywalkSignWord_expanded (skywalkPoolB w)
        (narrowSkywalkRouteWidth i) (by omega) lb
      change q ∈ (compactSkywalkSignWord (skywalkPoolB w) (narrowSkywalkRouteWidth i)).expanded at hq
      rw [he] at hq
      exact ub q hq))
  have ar : A.expanded = skywalkPoolA w i := compactSkywalkSignWord_expanded _ _ (by omega) la
  have br : B.expanded = skywalkPoolB w := compactSkywalkSignWord_expanded _ _ (by omega) lb
  rw [ar] at aValue
  rw [br] at bValue
  have ca := compactSkywalkSignRelease_counts A
  have actual : run (compactSkywalkSignPoolRelease w i) m s = v :=
    compactSkywalkSign_no_measure_append _ _ ca.2.1 s m
  rw [actual]
  have pa := (compactSkywalkSignRelease_phase_frame A hv.1 s m).1
  have pb := (compactSkywalkSignRelease_phase_frame B hv.2 u m).1
  refine ⟨pb.trans pa,vCleanA,vCleanB,aValue,bValue,?_⟩
  intro q hqa hqb
  have ua := run_preserves_outside (compactSkywalkSignRelease A) m s q
    (fun h => hqa (List.mem_toFinset.mp (sa h)))
  exact (run_preserves_outside (compactSkywalkSignRelease B) m u q
    (fun h => hqb (List.mem_toFinset.mp (sb h)))).trans ua

/-- Every valid complete logical trajectory therefore has an actual clean
physical release boundary at the universally proved width N_i. -/
theorem compactSkywalkSignPool_stage_release (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1) (hp : p < 2^256) (hq : p+2^32 ≤ 2^256)
    (hx : x < p) (hc : x.Coprime p) (hi : i < 512) (s : State) (m : List Bool)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    (compactSkywalkSignPoolA w i).Clean (run (compactSkywalkSignPoolRelease w i) m s).basis ∧
    (compactSkywalkSignPoolB w i).Clean (run (compactSkywalkSignPoolRelease w i) m s).basis ∧
    signedRegValue (compactSkywalkSignPoolA w i).retained
      (run (compactSkywalkSignPoolRelease w i) m s).basis = 
        (SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))).a ∧
    signedRegValue (compactSkywalkSignPoolB w i).retained
      (run (compactSkywalkSignPoolRelease w i) m s).basis = 
        (SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))).b := by
  have copies := compactSkywalkSignPool_stage_copies w x p i hp0 hx0 hpo hp hq hx hc hi s.basis hin
  have h := compactSkywalkSignPool_release_correct w i hi hn s m copies.1 copies.2
  exact ⟨h.2.1,h.2.2.1,h.2.2.2.1.trans hin.1,h.2.2.2.2.1.trans hin.2.1⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkSignReleasePair

section WCompactSkywalkTickEntry
/-! Copy of `Arithmetic/CompactSkywalkTickEntry` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem block_prefix (w : Nat → Wire) (start len n : Nat) (hn : n ≤ len) :
    (wireBlock w start len).take n=wireBlock w start n := by
  have h := wireBlock_append w start n (len-n)
  have e : n+(len-n)=len := by omega
  rw [e] at h
  rw [←h]
  have take : (wireBlock w start n ++ wireBlock w (start+n) (len-n)).take
      (wireBlock w start n).length = wireBlock w start n := List.take_left
  simpa only [wireBlock_length] using take

private theorem entry_views (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkSignPoolA w i).retained=(compactSkywalkTickLayout w i).a ∧
    (compactSkywalkSignPoolB w i).retained=(compactSkywalkTickLayout w i).b := by
  have hw := compactSkywalkTick_width_bounds i hi
  have na : narrowSkywalkRouteWidth i ≤ (skywalkPoolA w i).length := by
    simpa only [skywalkPoolA,wireBlock_length] using hw.2.2.2.1
  have nb : narrowSkywalkRouteWidth i ≤ (skywalkPoolB w).length := by
    simpa only [skywalkPoolB,wireBlock_length] using hw.2.2.2.1
  have hpos : 0 < narrowSkywalkRouteWidth i := by
    change 0 < compactSkywalkTickPreWidth i
    omega
  have va := compactSkywalkSignWord_retained (skywalkPoolA w i) (narrowSkywalkRouteWidth i)
    hpos na
  have vb := compactSkywalkSignWord_retained (skywalkPoolB w) (narrowSkywalkRouteWidth i)
    hpos nb
  constructor
  · change (compactSkywalkSignWord (skywalkPoolA w i) (narrowSkywalkRouteWidth i)).retained=_
    rw [va,skywalkPoolA,compactSkywalkTick_a w i hi]
    exact block_prefix w i 258 _ hw.2.2.2.1
  · change (compactSkywalkSignWord (skywalkPoolB w) (narrowSkywalkRouteWidth i)).retained=_
    rw [vb,skywalkPoolB,compactSkywalkTick_b w i hi]
    exact block_prefix w 770 258 _ hw.2.2.2.1

private theorem index_away (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i j : Nat) (hi : i < 512) (hj : j < 1798)
    (ha : j < i ∨ i+258 ≤ j) (hb : j < 770 ∨ 1028 ≤ j) :
    w j∉skywalkPoolA w i ∧ w j∉skywalkPoolB w := by
  constructor <;> intro hq
  · obtain ⟨k,hk,he⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hk
    have e := skywalkPool_index_inj w hn k j (by omega) hj he
    omega
  · obtain ⟨k,hk,he⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hk
    have e := skywalkPool_index_inj w hn k j (by omega) hj he
    omega

private theorem extension_in_release (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hsmall : compactSkywalkTickPreWidth i < 258) :
    w (i+compactSkywalkTickPreWidth i)∈(compactSkywalkSignPoolA w i).released := by
  have hw := compactSkywalkTick_width_bounds i hi
  change w (i+compactSkywalkTickPreWidth i)∈
    (wireBlock w i 258).drop (compactSkywalkTickPreWidth i)
  have h := wireBlock_append w i (compactSkywalkTickPreWidth i)
    (258-compactSkywalkTickPreWidth i)
  rw [show compactSkywalkTickPreWidth i+(258-compactSkywalkTickPreWidth i)=258 by omega] at h
  rw [←h]
  have drop : (wireBlock w i (compactSkywalkTickPreWidth i) ++
      wireBlock w (i+compactSkywalkTickPreWidth i) (258-compactSkywalkTickPreWidth i)).drop
      (wireBlock w i (compactSkywalkTickPreWidth i)).length =
      wireBlock w (i+compactSkywalkTickPreWidth i) (258-compactSkywalkTickPreWidth i) := List.drop_left
  simp only [wireBlock_length] at drop
  rw [drop]
  apply List.mem_map.mpr
  exact ⟨i+compactSkywalkTickPreWidth i,by simp only [List.mem_range'_1]; omega,rfl⟩

/-- Every zero required by the local tick comes from actual release or
the old fresh-extension/work frame. There is no new clean-work oracle. -/
theorem compactSkywalkTickEntry_from_stage (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1) (hp : p < 2^256) (hq : p+2^32 ≤ 2^256)
    (hx : x < p) (hc : x.Coprime p) (hi : i < 512) (s : State) (m : List Bool)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    let r := SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))
    let t := run (compactSkywalkSignPoolRelease w i) m s
    t.phase=s.phase ∧ SkywalkIntegerInput (compactSkywalkTickLayout w i) r.a r.b r.g t.basis := by
  dsimp only
  generalize ht : run (compactSkywalkSignPoolRelease w i) m s=t
  have copies := compactSkywalkSignPool_stage_copies w x p i hp0 hx0 hpo hp hq hx hc hi s.basis hin
  have release := compactSkywalkSignPool_release_correct w i hi hn s m copies.1 copies.2
  rw [ht] at release
  obtain ⟨phase,cleanA,cleanB,valA,valB,frame⟩ := release
  have views := entry_views w i hi
  rw [views.1] at valA
  rw [views.2] at valB
  have keep (j : Nat) (hj : j < 1798) (ha : j < i ∨ i+258 ≤ j)
      (hb : j < 770 ∨ 1028 ≤ j) : t.basis (w j)=s.basis (w j) := by
    have away := index_away w hn i j hi hj ha hb
    exact frame _ away.1 away.2
  have prev := keep (skywalkPoolPreviousId i) (by
    unfold skywalkPoolPreviousId; split_ifs <;> omega) (by
    unfold skywalkPoolPreviousId; split_ifs <;> omega) (by
    unfold skywalkPoolPreviousId; split_ifs <;> omega)
  have fresh := hin.2.2.2.2.1 i (Nat.le_refl i) hi
  refine ⟨phase,valA.trans hin.1,valB.trans hin.2.1,?_,?_,?_,?_⟩
  · change t.basis (w (skywalkPoolPreviousId i))=_
    exact prev.trans hin.2.2.1
  · change t.basis (w (i+compactSkywalkTickPreWidth i))=false
    have width := (compactSkywalkTick_width_bounds i hi).2.2.2.1
    by_cases hfull : compactSkywalkTickPreWidth i=258
    · rw [hfull,keep (i+258) (by omega) (by omega) (by omega)]
      exact fresh.1
    · exact cleanA _ (extension_in_release w i hi (by omega))
  · change t.basis (w (1028+i))=false
    exact (keep (1028+i) (by omega) (by omega) (by omega)).trans fresh.2
  · apply (regValue_zero _ _).mpr
    intro q hq
    change q∈wireBlock w 1540 (compactSkywalkTickPreWidth i-1) at hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    have width := (compactSkywalkTick_width_bounds i hi).2.2.2.1
    have before := (regValue_zero _ _).mp hin.2.2.2.2.2.1 (w j) (by
      apply List.mem_map.mpr
      exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩)
    exact (keep j (by omega) (by omega) (by omega)).trans before

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickEntry

section WCompactSkywalkTickOutputCleanup
/-! Copy of `Arithmetic/CompactSkywalkTickOutputCleanup` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem subviews (r : List Wire) (n : Nat) (hn : 0 < n) (hle : n ≤ r.length) :
    (compactSkywalkSignWord r n).retained ⊆ r ∧
    (compactSkywalkSignWord r n).released ⊆ r ∧ (compactSkywalkSignWord r n).sign ∈ r := by
  have he := compactSkywalkSignWord_expanded r n hn hle
  refine ⟨?_,?_,?_⟩
  · intro q hq
    rw [←he]
    exact List.mem_append_left _ hq
  · intro q hq
    rw [←he]
    exact List.mem_append_right _ hq
  · have hs : (compactSkywalkSignWord r n).sign ∈ (compactSkywalkSignWord r n).retained := by
      simp [CompactSkywalkSignReleaseLayout.retained]
    have hx : (compactSkywalkSignWord r n).sign ∈ (compactSkywalkSignWord r n).expanded :=
      List.mem_append_left _ hs
    simpa only [he] using hx

private theorem same_signed2 (r : List Wire) (s t : BasisState)
    (he : ∀q ∈ r,t q = s q) : signedRegValue r t = signedRegValue r s := by
  unfold signedRegValue
  rw [regValue_congr r t s he]

/-- These are actual two-bank CX instructions, with both clean tails and
retained signed values proved from the native result's sign-copy predicates. -/
theorem compactSkywalkTickOutput_cleanup_correct (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m : List Bool)
    (hcA : (compactSkywalkTickARelease w i).Copies s.basis)
    (hcB : (compactSkywalkTickBRelease w i).Copies s.basis) :
    (run (compactSkywalkTickCleanup w i) m s).phase = s.phase ∧
    (compactSkywalkTickARelease w i).Clean (run (compactSkywalkTickCleanup w i) m s).basis ∧
    (compactSkywalkTickBRelease w i).Clean (run (compactSkywalkTickCleanup w i) m s).basis ∧
    signedRegValue (compactSkywalkTickARelease w i).retained
      (run (compactSkywalkTickCleanup w i) m s).basis =
        signedRegValue (compactSkywalkTickLayout w i).half s.basis ∧
    signedRegValue (compactSkywalkTickBRelease w i).retained
      (run (compactSkywalkTickCleanup w i) m s).basis =
        signedRegValue (compactSkywalkTickLayout w i).b s.basis ∧
    (∀q,q ∉ (compactSkywalkTickLayout w i).half → q ∉ (compactSkywalkTickLayout w i).b →
      (run (compactSkywalkTickCleanup w i) m s).basis q = s.basis q) := by
  let L := compactSkywalkTickLayout w i
  let A := compactSkywalkTickARelease w i
  let B := compactSkywalkTickBRelease w i
  let u := run (compactSkywalkSignRelease A) m s
  let v := run (compactSkywalkSignRelease B) m u
  have hv := compactSkywalkTick_release_valid w i hi hn
  have hw := compactSkywalkTick_width_bounds i hi
  have la : compactSkywalkTickPostWidth i ≤ L.half.length := by
    rw [compactSkywalkTick_half w i hi,wireBlock_length]
    exact hw.2.2.1
  have lb : compactSkywalkTickPostWidth i ≤ L.b.length := by
    rw [compactSkywalkTick_b w i hi,wireBlock_length]
    exact hw.2.2.1
  have av := subviews L.half (compactSkywalkTickPostWidth i) (by omega) la
  have bv := subviews L.b (compactSkywalkTickPostWidth i) (by omega) lb
  have sa := (compactSkywalkSignWord_support L.half (compactSkywalkTickPostWidth i) (by omega) la).1
  have sb := (compactSkywalkSignWord_support L.b (compactSkywalkTickPostWidth i) (by omega) lb).1
  have hd := compactSkywalkTick_words_disjoint w i hi hn
  have ub : ∀q ∈ L.b,u.basis q = s.basis q := by
    intro q hq
    exact run_preserves_outside _ m s q (fun h =>
      List.disjoint_left.mp hd (List.mem_toFinset.mp (sa h)) hq)
  have va : ∀q ∈ L.half,v.basis q = u.basis q := by
    intro q hq
    exact run_preserves_outside _ m u q (fun h =>
      List.disjoint_left.mp hd hq (List.mem_toFinset.mp (sb h)))
  have uCopiesB : B.Copies u.basis := by
    intro q hq
    have keepQ : u.basis q = s.basis q := ub q (bv.2.1 hq)
    have keepS : u.basis B.sign = s.basis B.sign := ub B.sign bv.2.2
    rw [keepQ,keepS]
    exact hcB q hq
  have uCleanA := compactSkywalkSignRelease_clean A hv.1 s m hcA
  have vCleanA : A.Clean v.basis := by
    intro q hq
    exact (va q (av.2.1 hq)).trans (uCleanA q hq)
  have vCleanB := compactSkywalkSignRelease_clean B hv.2 u m uCopiesB
  have aValue := (same_signed2 A.retained u.basis v.basis
    (fun q hq => va q (av.1 hq))).trans (compactSkywalkSignRelease_signed A hv.1 s m hcA)
  have bValue := (compactSkywalkSignRelease_signed B hv.2 u m uCopiesB).trans
    (same_signed2 B.expanded s.basis u.basis (by
      intro q hq
      have he : B.expanded = L.b := compactSkywalkSignWord_expanded _ _ (by omega) lb
      rw [he] at hq
      exact ub q hq))
  have ar : A.expanded = L.half := compactSkywalkSignWord_expanded _ _ (by omega) la
  have br : B.expanded = L.b := compactSkywalkSignWord_expanded _ _ (by omega) lb
  rw [ar] at aValue
  rw [br] at bValue
  have ca := compactSkywalkSignRelease_counts A
  have actual : run (compactSkywalkTickCleanup w i) m s = v :=
    compactSkywalkSign_no_measure_append _ _ ca.2.1 s m
  rw [actual]
  have pa := (compactSkywalkSignRelease_phase_frame A hv.1 s m).1
  have pb := (compactSkywalkSignRelease_phase_frame B hv.2 u m).1
  refine ⟨pb.trans pa,vCleanA,vCleanB,aValue,bValue,?_⟩
  intro q hqa hqb
  have ua := run_preserves_outside (compactSkywalkSignRelease A) m s q
    (fun h => hqa (List.mem_toFinset.mp (sa h)))
  exact (run_preserves_outside (compactSkywalkSignRelease B) m u q
    (fun h => hqb (List.mem_toFinset.mp (sb h)))).trans ua

/-- Orientation, sign-history, previous control and every local carry are
outside the two mutable words, by the physical local-layout distinctness. -/
theorem compactSkywalkTickOutput_metadataAway (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (q : Wire)
    (hq : q ∈ [(compactSkywalkTickLayout w i).a0,(compactSkywalkTickLayout w i).history,
      (compactSkywalkTickLayout w i).previous]++(compactSkywalkTickLayout w i).carry) :
    q ∉ (compactSkywalkTickLayout w i).half ∧ q ∉ (compactSkywalkTickLayout w i).b := by
  have h := List.nodup_iff_count.mp (compactSkywalkTick_valid w i hi hn).nodup q
  have hp := List.count_pos_iff.mpr hq
  constructor <;> intro hd <;> have hv := List.count_pos_iff.mpr hd
  all_goals
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.half,SkywalkIntegerLayout.b,
      List.count_append,List.count_cons,List.count_nil] at h hp hv
    omega

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickOutputCleanup

section WCompactSkywalkTickOutputSpec
/-! Copy of `Arithmetic/CompactSkywalkTickOutputSpec` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- The post-boundary integer words are physically retained prefixes.
History is still the actual emitted orientation/sign history, not recomputed data. -/
def CompactSkywalkTickOutput (w : Nat → Wire) (i : Nat) (A B : Int) (G : Bool)
    (s : BasisState) : Prop :=
  let L := compactSkywalkTickLayout w i
  let t := SkywalkRails.step ⟨A,B,G⟩
  signedRegValue (compactSkywalkTickARelease w i).retained s = t.h ∧
  signedRegValue (compactSkywalkTickBRelease w i).retained s = t.k ∧
  s L.a0 = t.g ∧ s L.history = t.s ∧ s L.previous = G ∧ regValue L.carry s = 0 ∧
  (compactSkywalkTickARelease w i).Clean s ∧ (compactSkywalkTickBRelease w i).Clean s

/-- The cleanup suffix has zero measurements, so its stream can be chosen
independently of the native tick's consumed prefix. -/
theorem compactSkywalkTickOutput_run (w : Nat → Wire) (i : Nat) (s : State) (m : List Bool) :
    run (compactSkywalkTick w i) m s =
      run (compactSkywalkTickCleanup w i) m
        (run (narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)) m s) := by
  rw [compactSkywalkTick,run_append,run_take]
  have hz := (compactSkywalkTick_cleanup_counts w i).2
  have h1 := run_take (compactSkywalkTickCleanup w i)
    (m.drop (measurementCount
      (narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i))))
    (run (narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)) m s)
  have h2 := run_take (compactSkywalkTickCleanup w i) m
    (run (narrowSkywalkTick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)) m s)
  rw [hz,List.take_zero] at h1 h2
  exact h1.symm.trans h2

/-- Full actual compact-tick semantics. Copies for both cleanup banks are
proved from the native result; no sign-copy premise is added to the input. -/
theorem compactSkywalkTickOutput_spec (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (A B : Int) (G : Bool) (hp : (A+B)%2 = 1)
    (ha0 : -((2^(compactSkywalkTickPostWidth i-1):Nat):Int) ≤ (SkywalkRails.route A B).1/2)
    (ha1 : (SkywalkRails.route A B).1/2 < ((2^(compactSkywalkTickPostWidth i-1):Nat):Int))
    (hb0 : -((2^(compactSkywalkTickPostWidth i-1):Nat):Int) ≤ (SkywalkRails.route A B).2)
    (hb1 : (SkywalkRails.route A B).2 < ((2^(compactSkywalkTickPostWidth i-1):Nat):Int)) :
    Triple (SkywalkIntegerInput (compactSkywalkTickLayout w i) A B G)
      (compactSkywalkTick w i) (CompactSkywalkTickOutput w i A B G) := by
  intro s m hin
  let L := compactSkywalkTickLayout w i
  let t := run (narrowSkywalkTick L (compactSkywalkTickPostWidth i)) m s
  let u := run (compactSkywalkTickCleanup w i) m t
  have native := compactSkywalkTick_native_spec w i hi hn A B G hp ha0 ha1 hb0 hb1 s m hin
  have copies := compactSkywalkTick_native_copies w i hi hn A B G hp ha0 ha1 hb0 hb1 s m hin
  have cleanup := compactSkywalkTickOutput_cleanup_correct w i hi hn t m copies.1 copies.2
  have keep : ∀q,q ∈ [L.a0,L.history,L.previous]++L.carry → u.basis q = t.basis q := by
    intro q hq
    have away := compactSkywalkTickOutput_metadataAway w i hi hn q hq
    exact cleanup.2.2.2.2.2 q away.1 away.2
  have carry : regValue L.carry u.basis = 0 := by
    apply Eq.trans (regValue_congr L.carry u.basis t.basis ?_) native.2.2.2.2.2.2
    intro q hq
    exact keep q (by simp [hq])
  have actual : run (compactSkywalkTick w i) m s = u := compactSkywalkTickOutput_run w i s m
  rw [actual]
  refine ⟨cleanup.1.trans native.1,cleanup.2.2.2.1.trans native.2.1,
    cleanup.2.2.2.2.1.trans native.2.2.1,
    (keep L.a0 (by simp)).trans native.2.2.2.1,
    (keep L.history (by simp)).trans native.2.2.2.2.1,
    (keep L.previous (by simp)).trans native.2.2.2.2.2.1,
    carry,cleanup.2.1,cleanup.2.2.1⟩

/-- Complete outsider frame for the actual compact program, independent of
input values and measurement outcomes. -/
theorem compactSkywalkTickOutput_frame (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m : List Bool) (q : Wire)
    (hq : q ∉ (compactSkywalkTickLayout w i).wires) :
    (run (compactSkywalkTick w i) m s).basis q = s.basis q :=
  run_preserves_outside _ m s q (fun h =>
    hq (List.mem_toFinset.mp (compactSkywalkTick_support w i hi hn h)))

end ECDSAAdd.Entrant.W
end WCompactSkywalkTickOutputSpec

section WCompactSkywalkStageViews
/-! Copy of `Arithmetic/CompactSkywalkStageViews` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Mathematical full-word interpretation. This is a basis function, not an
emitted sign-expansion program or an allocated high-copy register. -/
def compactSkywalkStageVirtual (w : Nat → Wire) (i : Nat) (s : BasisState) : BasisState :=
  let A := compactSkywalkSignPoolA w i
  let B := compactSkywalkSignPoolB w i
  fun q => if q ∈ A.released then s A.sign else if q ∈ B.released then s B.sign else s q

def CompactSkywalkStage (w : Nat → Wire) (r : SkywalkRails.State) (i : Nat)
    (s : BasisState) : Prop :=
  SkywalkIntegerStage w r i (compactSkywalkStageVirtual w i s) ∧
  (compactSkywalkSignPoolA w i).Clean s ∧ (compactSkywalkSignPoolB w i).Clean s

theorem compactSkywalkStage_width (i : Nat) (hi : i ≤ 512) :
    2 ≤ narrowSkywalkRouteWidth i ∧ narrowSkywalkRouteWidth i ≤ 258 := by
  unfold narrowSkywalkRouteWidth
  omega

private theorem blockND2 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (start count : Nat) (hb : start+count ≤ 1798) : (wireBlock w start count).Nodup := by
  apply List.Nodup.map_on
  · intro i hi j hj he
    simp only [List.mem_range'_1] at hi hj
    exact skywalkPool_index_inj w hn i j (by omega) (by omega) he
  · exact List.nodup_range'

theorem compactSkywalkStage_valid (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) :
    (compactSkywalkSignPoolA w i).Valid ∧ (compactSkywalkSignPoolB w i).Valid := by
  have h := compactSkywalkStage_width i hi
  exact ⟨compactSkywalkSignWord_valid _ _ (by omega)
    (by simpa only [skywalkPoolA,wireBlock_length] using h.2)
    (blockND2 w hn i 258 (by omega)),
    compactSkywalkSignWord_valid _ _ (by omega)
    (by simpa only [skywalkPoolB,wireBlock_length] using h.2)
    (blockND2 w hn 770 258 (by decide))⟩

theorem compactSkywalkStage_expanded (w : Nat → Wire) (i : Nat) (hi : i ≤ 512) :
    (compactSkywalkSignPoolA w i).expanded = skywalkPoolA w i ∧
    (compactSkywalkSignPoolB w i).expanded = skywalkPoolB w := by
  have h := compactSkywalkStage_width i hi
  exact ⟨compactSkywalkSignWord_expanded _ _ (by omega)
    (by simpa only [skywalkPoolA,wireBlock_length] using h.2),
    compactSkywalkSignWord_expanded _ _ (by omega)
    (by simpa only [skywalkPoolB,wireBlock_length] using h.2)⟩

theorem compactSkywalkStage_words_disjoint (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) : (skywalkPoolA w i).Disjoint (skywalkPoolB w) := by
  apply List.disjoint_left.mpr
  intro q ha hb
  simp only [skywalkPoolA,skywalkPoolB,wireBlock,List.mem_map,List.mem_range'_1] at ha hb
  obtain ⟨a,ha,hea⟩ := ha
  obtain ⟨b,hb,heb⟩ := hb
  have he := skywalkPool_index_inj w hn a b (by omega) (by omega) (hea.trans heb.symm)
  omega

/-- Outside the two physically released banks the virtual basis is unchanged. -/
theorem compactSkywalkStage_virtual_outside (w : Nat → Wire) (i : Nat) (s : BasisState)
    (q : Wire) (ha : q ∉ (compactSkywalkSignPoolA w i).released)
    (hb : q ∉ (compactSkywalkSignPoolB w i).released) :
    compactSkywalkStageVirtual w i s q = s q := by
  simp [compactSkywalkStageVirtual,ha,hb]

theorem compactSkywalkStage_zero_tails (w : Nat → Wire) :
    (compactSkywalkSignPoolA w 0).released = [] ∧
    (compactSkywalkSignPoolB w 0).released = [] := by
  constructor
  · change (wireBlock w 0 258).drop (narrowSkywalkRouteWidth 0) = []
    rw [narrowSkywalkRouteWidth_zero]
    have h : (wireBlock w 0 258).drop (wireBlock w 0 258).length = [] := List.drop_length
    simpa only [wireBlock_length] using h
  · change (wireBlock w 770 258).drop (narrowSkywalkRouteWidth 0) = []
    rw [narrowSkywalkRouteWidth_zero]
    have h : (wireBlock w 770 258).drop (wireBlock w 770 258).length = [] := List.drop_length
    simpa only [wireBlock_length] using h

theorem compactSkywalkStage_zero_virtual (w : Nat → Wire) (s : BasisState) :
    compactSkywalkStageVirtual w 0 s = s := by
  funext q
  simp [compactSkywalkStageVirtual,(compactSkywalkStage_zero_tails w).1,
    (compactSkywalkStage_zero_tails w).2]

/-- The existing seed-stage predicate is exactly the initial compact stage. -/
theorem compactSkywalkStage_zero_iff (w : Nat → Wire) (r : SkywalkRails.State) (s : BasisState) :
    CompactSkywalkStage w r 0 s ↔ SkywalkIntegerStage w r 0 s := by
  simp [CompactSkywalkStage,compactSkywalkStage_zero_virtual,
    CompactSkywalkSignReleaseLayout.Clean,(compactSkywalkStage_zero_tails w).1,
    (compactSkywalkStage_zero_tails w).2]

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageViews

section WCompactSkywalkStageVirtual
/-! Copy of `Arithmetic/CompactSkywalkStageVirtual` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem signed_congr (r : List Wire) (s t : BasisState)
    (he : ∀q∈r,s q=t q) : signedRegValue r s=signedRegValue r t := by
  unfold signedRegValue
  rw [regValue_congr r s t he]

private theorem parts (w : Nat → Wire) (i : Nat) (hi : i ≤ 512) :
    (compactSkywalkSignPoolA w i).released ⊆ skywalkPoolA w i ∧
    (compactSkywalkSignPoolB w i).released ⊆ skywalkPoolB w ∧
    (compactSkywalkSignPoolA w i).sign ∈ skywalkPoolA w i ∧
    (compactSkywalkSignPoolB w i).sign ∈ skywalkPoolB w := by
  have he := compactSkywalkStage_expanded w i hi
  refine ⟨?_,?_,?_,?_⟩
  · intro q hq; rw [←he.1]; exact List.mem_append_right _ hq
  · intro q hq; rw [←he.2]; exact List.mem_append_right _ hq
  · have hs : (compactSkywalkSignPoolA w i).sign ∈ (compactSkywalkSignPoolA w i).expanded :=
      List.mem_append_left _ (by simp [CompactSkywalkSignReleaseLayout.retained])
    simpa only [he.1] using hs
  · have hs : (compactSkywalkSignPoolB w i).sign ∈ (compactSkywalkSignPoolB w i).expanded :=
      List.mem_append_left _ (by simp [CompactSkywalkSignReleaseLayout.retained])
    simpa only [he.2] using hs

theorem compactSkywalkStage_virtual_signs (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) (s : BasisState) :
    compactSkywalkStageVirtual w i s (compactSkywalkSignPoolA w i).sign =
      s (compactSkywalkSignPoolA w i).sign ∧
    compactSkywalkStageVirtual w i s (compactSkywalkSignPoolB w i).sign =
      s (compactSkywalkSignPoolB w i).sign := by
  have hv := compactSkywalkStage_valid w i hi hn
  have hd := compactSkywalkStage_words_disjoint w i hi hn
  have hp := parts w i hi
  constructor
  · apply compactSkywalkStage_virtual_outside
    · exact (compactSkywalkSignPoolA w i).signAway hv.1
    · intro hq
      exact List.disjoint_left.mp hd hp.2.2.1 (hp.2.1 hq)
  · apply compactSkywalkStage_virtual_outside
    · intro hq
      exact List.disjoint_left.mp hd (hp.1 hq) hp.2.2.2
    · exact (compactSkywalkSignPoolB w i).signAway hv.2

theorem compactSkywalkStage_virtual_copies (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) (s : BasisState) :
    (compactSkywalkSignPoolA w i).Copies (compactSkywalkStageVirtual w i s) ∧
    (compactSkywalkSignPoolB w i).Copies (compactSkywalkStageVirtual w i s) := by
  have hs := compactSkywalkStage_virtual_signs w i hi hn s
  have hd := compactSkywalkStage_words_disjoint w i hi hn
  have hp := parts w i hi
  constructor
  · intro q hq
    rw [hs.1]
    simp [compactSkywalkStageVirtual,hq]
  · intro q hq
    have ha : q ∉ (compactSkywalkSignPoolA w i).released := by
      intro hm
      exact List.disjoint_left.mp hd (hp.1 hm) (hp.2.1 hq)
    rw [hs.2]
    simp [compactSkywalkStageVirtual,ha,hq]

/-- Virtual full reads are exactly the current physical retained signed reads. -/
theorem compactSkywalkStage_virtual_values (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) (s : BasisState) :
    signedRegValue (skywalkPoolA w i) (compactSkywalkStageVirtual w i s) =
      signedRegValue (compactSkywalkSignPoolA w i).retained s ∧
    signedRegValue (skywalkPoolB w) (compactSkywalkStageVirtual w i s) =
      signedRegValue (compactSkywalkSignPoolB w i).retained s := by
  have hv := compactSkywalkStage_valid w i hi hn
  have he := compactSkywalkStage_expanded w i hi
  have hd := compactSkywalkStage_words_disjoint w i hi hn
  have hp := parts w i hi
  constructor
  · rw [←he.1]
    apply Eq.trans (signed_congr _ _ _ ?_)
      (compactSkywalkSignRelease_virtual_signed _ hv.1 s)
    intro q hq
    have hb : q ∉ (compactSkywalkSignPoolB w i).released := by
      intro hm
      rw [he.1] at hq
      exact List.disjoint_left.mp hd hq (hp.2.1 hm)
    simp [compactSkywalkStageVirtual,CompactSkywalkSignReleaseLayout.reconstructed,hb]
  · rw [←he.2]
    apply Eq.trans (signed_congr _ _ _ ?_)
      (compactSkywalkSignRelease_virtual_signed _ hv.2 s)
    intro q hq
    have ha : q ∉ (compactSkywalkSignPoolA w i).released := by
      intro hm
      rw [he.2] at hq
      exact List.disjoint_left.mp hd (hp.1 hm) hq
    simp [compactSkywalkStageVirtual,CompactSkywalkSignReleaseLayout.reconstructed,ha]

/-- Mathematical reconstruction followed by ghost release is exactly the
physical state. This equivalence emits no expansion in the compact circuit. -/
theorem compactSkywalkStage_release_virtual (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m : List Bool)
    (hcA : (compactSkywalkSignPoolA w i).Clean s.basis)
    (hcB : (compactSkywalkSignPoolB w i).Clean s.basis) :
    run (compactSkywalkSignPoolRelease w i) m
      ⟨s.phase,compactSkywalkStageVirtual w i s.basis⟩ = s := by
  let v : State := ⟨s.phase,compactSkywalkStageVirtual w i s.basis⟩
  let A := compactSkywalkSignPoolA w i
  let B := compactSkywalkSignPoolB w i
  let u := run (compactSkywalkSignRelease A) m v
  let t := run (compactSkywalkSignRelease B) m u
  have hv := compactSkywalkSignPool_valid w i hi hn
  have copies := compactSkywalkStage_virtual_copies w i (by omega) hn s.basis
  have h := compactSkywalkSignPool_release_correct w i hi hn v m copies.1 copies.2
  have ca := compactSkywalkSignRelease_counts A
  have actual : run (compactSkywalkSignPoolRelease w i) m v = t :=
    compactSkywalkSign_no_measure_append _ _ ca.2.1 v m
  rw [actual] at h
  change run (compactSkywalkSignPoolRelease w i) m v = s
  rw [actual]
  apply congrArg₂ State.mk
  · exact h.1
  · funext q
    by_cases ha : q ∈ A.released
    · exact (h.2.1 q ha).trans (hcA q ha).symm
    by_cases hb : q ∈ B.released
    · exact (h.2.2.1 q hb).trans (hcB q hb).symm
    have a := (compactSkywalkSignRelease_phase_frame A hv.1 v m).2.1 q ha
    have b := (compactSkywalkSignRelease_phase_frame B hv.2 u m).2.1 q hb
    exact (b.trans a).trans (compactSkywalkStage_virtual_outside w i s.basis q ha hb)

/-- Every local tick input is obtained from the compact-stage predicate by
verified ghost release. No extra clean extension or work oracle is introduced. -/
theorem compactSkywalkStage_local_input (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1) (hp : p < 2^256) (hq : p+2^32 ≤ 2^256)
    (hx : x < p) (hc : x.Coprime p) (hi : i < 512) (s : State)
    (hin : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    let r := SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))
    SkywalkIntegerInput (compactSkywalkTickLayout w i) r.a r.b r.g s.basis := by
  have entry := compactSkywalkTickEntry_from_stage w hn x p i hp0 hx0 hpo hp hq hx hc hi
    ⟨s.phase,compactSkywalkStageVirtual w i s.basis⟩ [] hin.1
  have eq := compactSkywalkStage_release_virtual w i hi hn s [] hin.2.1 hin.2.2
  rw [eq] at entry
  exact entry.2

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageVirtual

section WCompactSkywalkStageFrame
/-! Copy of `Arithmetic/CompactSkywalkStageFrame` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem block_away (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (start len j : Nat) (hb : start+len ≤ 1798) (hj : j < 1798)
    (ha : j < start ∨ start+len ≤ j) : w j ∉ wireBlock w start len := by
  intro hm
  obtain ⟨k,hk,he⟩ := List.mem_map.mp hm
  simp only [List.mem_range'_1] at hk
  have e := skywalkPool_index_inj w hn k j (by omega) hj he
  omega

/-- Raw tape, future extension sites and the complete carry bank are not
changed by mathematical sign reconstruction. -/
theorem compactSkywalkStage_virtual_index (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) (s : BasisState) (j : Nat) (hj : j < 1798)
    (ha : j < i ∨ i+258 ≤ j) (hb : j < 770 ∨ 1028 ≤ j) :
    compactSkywalkStageVirtual w i s (w j) = s (w j) := by
  have ea := compactSkywalkStage_expanded w i hi
  apply compactSkywalkStage_virtual_outside
  · intro hm
    have hw : w j ∈ skywalkPoolA w i := by rw [←ea.1]; exact List.mem_append_right _ hm
    exact block_away w hn i 258 j (by omega) hj ha hw
  · intro hm
    have hw : w j ∈ skywalkPoolB w := by rw [←ea.2]; exact List.mem_append_right _ hm
    exact block_away w hn 770 258 j (by decide) hj hb hw

/-- An index interval exclusion checks the actual local native/cleanup support. -/
theorem compactSkywalkStage_tick_away (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat) (hj : j < 1798)
    (hp : j ≠ skywalkPoolPreviousId i) (hh : j ≠ 1028+i)
    (he : j ≠ i+compactSkywalkTickPreWidth i) (hi0 : j ≠ i) (hb0 : j ≠ 770)
    (ha : j < i+1 ∨ i+compactSkywalkTickPreWidth i ≤ j)
    (hb : j < 771 ∨ 770+compactSkywalkTickPreWidth i ≤ j)
    (hc : j < 1540 ∨ 1540+(compactSkywalkTickPreWidth i-1) ≤ j) :
    w j ∉ (compactSkywalkTickLayout w i).wires := by
  have width := compactSkywalkTick_width_bounds i hi
  have distinct (k : Nat) (hk : k < 1798) (hne : j ≠ k) : w j ≠ w k := by
    intro e
    exact hne (skywalkPool_index_inj w hn j k hj hk e)
  have pa := distinct _ (by unfold skywalkPoolPreviousId; split_ifs <;> omega) hp
  have ph := distinct _ (by omega) hh
  have pe := distinct _ (by omega) he
  have pi := distinct _ (by omega) hi0
  have pb := distinct _ (by decide) hb0
  have aa := block_away w hn (i+1) (compactSkywalkTickPreWidth i-1) j (by omega) hj (by omega)
  have ab := block_away w hn 771 (compactSkywalkTickPreWidth i-1) j (by omega) hj (by omega)
  have ac := block_away w hn 1540 (compactSkywalkTickPreWidth i-1) j (by omega) hj hc
  simp only [SkywalkIntegerLayout.wires,compactSkywalkTick_ah w i hi,
    compactSkywalkTick_bh w i hi,List.mem_cons,List.mem_append]
  simp only [compactSkywalkTickLayout]
  tauto

theorem compactSkywalkStage_tick_keep (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat) (hj : j < 1798)
    (hp : j ≠ skywalkPoolPreviousId i) (hh : j ≠ 1028+i)
    (he : j ≠ i+compactSkywalkTickPreWidth i) (hi0 : j ≠ i) (hb0 : j ≠ 770)
    (ha : j < i+1 ∨ i+compactSkywalkTickPreWidth i ≤ j)
    (hb : j < 771 ∨ 770+compactSkywalkTickPreWidth i ≤ j)
    (hc : j < 1540 ∨ 1540+(compactSkywalkTickPreWidth i-1) ≤ j)
    (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w j) = s.basis (w j) :=
  compactSkywalkTickOutput_frame w i hi hn s m _
    (compactSkywalkStage_tick_away w i hi hn j hj hp hh he hi0 hb0 ha hb hc)

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageFrame

section WCompactSkywalkStageFields
/-! Copy of `Arithmetic/CompactSkywalkStageFields` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Physical form of the compact invariant. Only the current signed reads
are shortened; all stored controls and fresh/work bits remain explicit. -/
def CompactSkywalkStageFields (w : Nat → Wire) (r : SkywalkRails.State) (i : Nat)
    (s : BasisState) : Prop :=
  let ri := SkywalkTrace.next^[i] r
  signedRegValue (compactSkywalkSignPoolA w i).retained s=ri.a ∧
  signedRegValue (compactSkywalkSignPoolB w i).retained s=ri.b ∧
  s (w (skywalkPoolPreviousId i))=ri.g ∧
  (∀j,j < i → s (w j)=(SkywalkTrace.code (SkywalkTrace.next^[j] r)).1 ∧
    s (w (1028+j))=(SkywalkTrace.code (SkywalkTrace.next^[j] r)).2) ∧
  (∀j,i ≤ j → j < 512 → s (w (j+258))=false ∧ s (w (1028+j))=false) ∧
  regValue (wireBlock w 1540 257) s=0 ∧ s (w 1797)=false ∧
  (compactSkywalkSignPoolA w i).Clean s ∧ (compactSkywalkSignPoolB w i).Clean s

private theorem metadata_reads (w : Nat → Wire) (r : SkywalkRails.State) (i : Nat)
    (hi : i ≤ 512) (hn : (skywalkPoolWires w).Nodup) (s : BasisState) :
    SkywalkIntegerStage w r i (compactSkywalkStageVirtual w i s) ↔
      signedRegValue (compactSkywalkSignPoolA w i).retained s=(SkywalkTrace.next^[i] r).a ∧
      signedRegValue (compactSkywalkSignPoolB w i).retained s=(SkywalkTrace.next^[i] r).b ∧
      s (w (skywalkPoolPreviousId i))=(SkywalkTrace.next^[i] r).g ∧
      (∀j,j < i → s (w j)=(SkywalkTrace.code (SkywalkTrace.next^[j] r)).1 ∧
        s (w (1028+j))=(SkywalkTrace.code (SkywalkTrace.next^[j] r)).2) ∧
      (∀j,i ≤ j → j < 512 → s (w (j+258))=false ∧ s (w (1028+j))=false) ∧
      regValue (wireBlock w 1540 257) s=0 ∧ s (w 1797)=false := by
  have values := compactSkywalkStage_virtual_values w i hi hn s
  have keep (j : Nat) (hj : j < 1798) (ha : j < i ∨ i+258 ≤ j)
      (hb : j < 770 ∨ 1028 ≤ j) := compactSkywalkStage_virtual_index w i hi hn s j hj ha hb
  have prev := keep (skywalkPoolPreviousId i) (by
    unfold skywalkPoolPreviousId; split_ifs <;> omega) (by
    unfold skywalkPoolPreviousId; split_ifs <;> omega) (by
    unfold skywalkPoolPreviousId; split_ifs <;> omega)
  have initial := keep 1797 (by omega) (by omega) (by omega)
  have carry : regValue (wireBlock w 1540 257) (compactSkywalkStageVirtual w i s)=
      regValue (wireBlock w 1540 257) s := by
    apply regValue_congr
    intro q hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    exact keep j (by omega) (by omega) (by omega)
  have oldG (j : Nat) (hj : j < i) := keep j (by omega) (by omega) (by omega)
  have oldS (j : Nat) (hj : j < i) := keep (1028+j) (by omega) (by omega) (by omega)
  have freshE (j : Nat) (hj : i ≤ j) (h512 : j < 512) :=
    keep (j+258) (by omega) (by omega) (by omega)
  have freshS (j : Nat) (hj : i ≤ j) (h512 : j < 512) :=
    keep (1028+j) (by omega) (by omega) (by omega)
  unfold SkywalkIntegerStage
  rw [values.1,values.2,prev,carry,initial]
  constructor
  · intro h
    refine ⟨h.1,h.2.1,h.2.2.1,?_,?_,h.2.2.2.2.2⟩
    · intro j hj
      have t := h.2.2.2.1 j hj
      simpa only [oldG j hj,oldS j hj] using t
    · intro j hj hk
      have t := h.2.2.2.2.1 j hj hk
      simpa only [freshE j hj hk,freshS j hj hk] using t
  · intro h
    refine ⟨h.1,h.2.1,h.2.2.1,?_,?_,h.2.2.2.2.2⟩
    · intro j hj
      rw [oldG j hj,oldS j hj]
      exact h.2.2.2.1 j hj
    · intro j hj hk
      rw [freshE j hj hk,freshS j hj hk]
      exact h.2.2.2.2.1 j hj hk

/-- Equivalence introduces no predicate about unseen high qubits. The
mathematical virtual view is exactly the physical prefix/clean-tail assertion. -/
theorem compactSkywalkStage_fields_iff (w : Nat → Wire) (r : SkywalkRails.State)
    (i : Nat) (hi : i ≤ 512) (hn : (skywalkPoolWires w).Nodup) (s : BasisState) :
    CompactSkywalkStage w r i s ↔ CompactSkywalkStageFields w r i s := by
  unfold CompactSkywalkStage CompactSkywalkStageFields
  rw [metadata_reads w r i hi hn s]
  constructor
  · rintro ⟨⟨ha,hb,hg,hpast,hfuture,hcarry,horient⟩,hcleanA,hcleanB⟩
    exact ⟨ha,hb,hg,hpast,hfuture,hcarry,horient,hcleanA,hcleanB⟩
  · rintro ⟨ha,hb,hg,hpast,hfuture,hcarry,horient,hcleanA,hcleanB⟩
    exact ⟨⟨ha,hb,hg,hpast,hfuture,hcarry,horient⟩,hcleanA,hcleanB⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageFields

section WCompactSkywalkStageMetadata
/-! Copy of `Arithmetic/CompactSkywalkStageMetadata` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Past G records strictly before the predecessor site lie outside the
actual native and cleanup instruction support. -/
theorem compactSkywalkStageMetadata_pastG (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat) (hj : j+1 < i)
    (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w j) = s.basis (w j) := by
  have width := compactSkywalkTick_width_bounds i hi
  have hp : j ≠ skywalkPoolPreviousId i := by
    unfold skywalkPoolPreviousId
    split_ifs <;> omega
  exact compactSkywalkStage_tick_keep w i hi hn j (by omega) hp
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) s m

theorem compactSkywalkStageMetadata_pastS (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat) (hj : j < i)
    (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w (1028+j)) = s.basis (w (1028+j)) := by
  have width := compactSkywalkTick_width_bounds i hi
  have hp : 1028+j ≠ skywalkPoolPreviousId i := by
    unfold skywalkPoolPreviousId
    split_ifs <;> omega
  exact compactSkywalkStage_tick_keep w i hi hn (1028+j) (by omega) hp
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) s m

/-- Future extensions of the original full-width words remain untouched;
the compact physical A prefix ends no later than site 514. -/
theorem compactSkywalkStageMetadata_futureExtension (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat) (hj0 : i+1 ≤ j) (hj : j < 512)
    (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w (j+258)) = s.basis (w (j+258)) := by
  have width := compactSkywalkTick_width_bounds i hi
  have hp : j+258 ≠ skywalkPoolPreviousId i := by
    unfold skywalkPoolPreviousId
    split_ifs <;> omega
  exact compactSkywalkStage_tick_keep w i hi hn (j+258) (by omega) hp
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) s m

theorem compactSkywalkStageMetadata_futureS (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat) (hj0 : i+1 ≤ j) (hj : j < 512)
    (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w (1028+j)) = s.basis (w (1028+j)) := by
  have width := compactSkywalkTick_width_bounds i hi
  have hp : 1028+j ≠ skywalkPoolPreviousId i := by
    unfold skywalkPoolPreviousId
    split_ifs <;> omega
  exact compactSkywalkStage_tick_keep w i hi hn (1028+j) (by omega) hp
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) s m

/-- The unused suffix of the original carry bank is a frame, with no
cleanliness premise on those untouched bits. -/
theorem compactSkywalkStageMetadata_carryTail (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (j : Nat)
    (hj0 : 1540+(compactSkywalkTickPreWidth i-1) ≤ j) (hj : j < 1797)
    (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w j) = s.basis (w j) := by
  have width := compactSkywalkTick_width_bounds i hi
  have hp : j ≠ skywalkPoolPreviousId i := by
    unfold skywalkPoolPreviousId
    split_ifs <;> omega
  exact compactSkywalkStage_tick_keep w i hi hn j (by omega) hp
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) s m

theorem compactSkywalkStageMetadata_orientation (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (hi0 : 0 < i) (s : State) (m : List Bool) :
    (run (compactSkywalkTick w i) m s).basis (w 1797) = s.basis (w 1797) := by
  have width := compactSkywalkTick_width_bounds i hi
  have hp : 1797 ≠ skywalkPoolPreviousId i := by
    unfold skywalkPoolPreviousId
    split_ifs <;> omega
  exact compactSkywalkStage_tick_keep w i hi hn 1797 (by decide) hp
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) s m

/-- The record at the current index is the proved physical output history. -/
theorem compactSkywalkStageMetadata_history (w : Nat → Wire) (i : Nat)
    (A B : Int) (G : Bool) (out : BasisState)
    (h : CompactSkywalkTickOutput w i A B G out) :
    out (w (1028+i)) = (SkywalkRails.step ⟨A,B,G⟩).s := h.2.2.2.1

/-- The predecessor is preserved by the native output contract, including
the special initial orientation site. -/
theorem compactSkywalkStageMetadata_previous (w : Nat → Wire) (i : Nat)
    (A B : Int) (G : Bool) (before out : BasisState)
    (hin : SkywalkIntegerInput (compactSkywalkTickLayout w i) A B G before)
    (hout : CompactSkywalkTickOutput w i A B G out) :
    out (w (skywalkPoolPreviousId i)) = before (w (skywalkPoolPreviousId i)) :=
  hout.2.2.2.2.1.trans hin.2.2.1.symm

theorem compactSkywalkStageMetadata_previousG (w : Nat → Wire) (i : Nat) (hi0 : 0 < i)
    (A B : Int) (G : Bool) (before out : BasisState)
    (hin : SkywalkIntegerInput (compactSkywalkTickLayout w i) A B G before)
    (hout : CompactSkywalkTickOutput w i A B G out) :
    out (w (i-1)) = before (w (i-1)) := by
  have h := compactSkywalkStageMetadata_previous w i A B G before out hin hout
  simpa only [skywalkPoolPreviousId,if_neg (by omega : i ≠ 0)] using h

theorem compactSkywalkStageMetadata_orientation_zero (w : Nat → Wire)
    (A B : Int) (G : Bool) (before out : BasisState)
    (hin : SkywalkIntegerInput (compactSkywalkTickLayout w 0) A B G before)
    (hout : CompactSkywalkTickOutput w 0 A B G out) :
    out (w 1797) = before (w 1797) := by
  simpa only [skywalkPoolPreviousId,if_pos rfl] using
    (compactSkywalkStageMetadata_previous w 0 A B G before out hin hout)

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageMetadata

section WCompactSkywalkStageStepGeometry
/-! Copy of `Arithmetic/CompactSkywalkStageStepGeometry` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

private theorem blockPrefix (w : Nat → Wire) (start len n : Nat) (hn : n ≤ len) :
    (wireBlock w start len).take n = wireBlock w start n := by
  have h := wireBlock_append w start n (len-n)
  rw [show n+(len-n) = len by omega] at h
  rw [←h]
  have ht : (wireBlock w start n++wireBlock w (start+n) (len-n)).take
    (wireBlock w start n).length = wireBlock w start n := List.take_left
  simpa only [wireBlock_length] using ht

private theorem blockDrop (w : Nat → Wire) (start len n : Nat) (hn : n ≤ len) :
    (wireBlock w start len).drop n = wireBlock w (start+n) (len-n) := by
  have h := wireBlock_append w start n (len-n)
  rw [show n+(len-n) = len by omega] at h
  rw [←h]
  have ht : (wireBlock w start n++wireBlock w (start+n) (len-n)).drop
    (wireBlock w start n).length = wireBlock w (start+n) (len-n) := List.drop_left
  simpa only [wireBlock_length] using ht

/-- Next retained words are precisely the physically computed output prefixes. -/
theorem compactSkywalkStageStep_retained (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkSignPoolA w (i+1)).retained = (compactSkywalkTickARelease w i).retained ∧
    (compactSkywalkSignPoolB w (i+1)).retained = (compactSkywalkTickBRelease w i).retained := by
  have h := compactSkywalkTick_width_bounds i hi
  have a := compactSkywalkStage_width (i+1) (by omega)
  have e : narrowSkywalkRouteWidth (i+1) = compactSkywalkTickPostWidth i := h.2.2.2.2.2.symm
  have pos : 0 < compactSkywalkTickPostWidth i := by omega
  have nextA := compactSkywalkSignWord_retained (skywalkPoolA w (i+1))
    (narrowSkywalkRouteWidth (i+1)) (by omega) (by simpa only [skywalkPoolA,wireBlock_length] using a.2)
  have nextB := compactSkywalkSignWord_retained (skywalkPoolB w)
    (narrowSkywalkRouteWidth (i+1)) (by omega) (by simpa only [skywalkPoolB,wireBlock_length] using a.2)
  have curA := compactSkywalkSignWord_retained (compactSkywalkTickLayout w i).half
    (compactSkywalkTickPostWidth i) pos (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1)
  have curB := compactSkywalkSignWord_retained (compactSkywalkTickLayout w i).b
    (compactSkywalkTickPostWidth i) pos (by
      rw [compactSkywalkTick_b w i hi,wireBlock_length]; exact h.2.2.1)
  constructor
  · change (compactSkywalkSignWord _ _).retained = (compactSkywalkSignWord _ _).retained
    rw [nextA,curA,e,compactSkywalkTick_half w i hi,skywalkPoolA]
    rw [blockPrefix w (i+1) 258 _ (by omega),blockPrefix w (i+1) _ _ h.2.2.1]
  · change (compactSkywalkSignWord _ _).retained = (compactSkywalkSignWord _ _).retained
    rw [nextB,curB,e,compactSkywalkTick_b w i hi,skywalkPoolB]
    rw [blockPrefix w 770 258 _ (by omega),blockPrefix w 770 _ _ h.2.2.1]

/-- Current cleanup tails and next full-word tails are concrete intervals. -/
theorem compactSkywalkStageStep_tail_views (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    (compactSkywalkTickARelease w i).released =
      wireBlock w (i+1+compactSkywalkTickPostWidth i)
        (compactSkywalkTickPreWidth i-compactSkywalkTickPostWidth i) ∧
    (compactSkywalkTickBRelease w i).released =
      wireBlock w (770+compactSkywalkTickPostWidth i)
        (compactSkywalkTickPreWidth i-compactSkywalkTickPostWidth i) ∧
    (compactSkywalkSignPoolA w (i+1)).released =
      wireBlock w (i+1+compactSkywalkTickPostWidth i) (258-compactSkywalkTickPostWidth i) ∧
    (compactSkywalkSignPoolB w (i+1)).released =
      wireBlock w (770+compactSkywalkTickPostWidth i) (258-compactSkywalkTickPostWidth i) ∧
    (compactSkywalkSignPoolA w i).released =
      wireBlock w (i+compactSkywalkTickPreWidth i) (258-compactSkywalkTickPreWidth i) ∧
    (compactSkywalkSignPoolB w i).released =
      wireBlock w (770+compactSkywalkTickPreWidth i) (258-compactSkywalkTickPreWidth i) := by
  have h := compactSkywalkTick_width_bounds i hi
  have e : narrowSkywalkRouteWidth (i+1) = compactSkywalkTickPostWidth i := h.2.2.2.2.2.symm
  simp only [compactSkywalkTickARelease,compactSkywalkTickBRelease,compactSkywalkSignPoolA,
    compactSkywalkSignPoolB,compactSkywalkSignWord,compactSkywalkTick_half w i hi,
    compactSkywalkTick_b w i hi,skywalkPoolA,skywalkPoolB,e]
  change (wireBlock w (i+1) (compactSkywalkTickPreWidth i)).drop (compactSkywalkTickPostWidth i) = _ ∧
    (wireBlock w 770 (compactSkywalkTickPreWidth i)).drop (compactSkywalkTickPostWidth i) = _ ∧
    (wireBlock w (i+1) 258).drop (compactSkywalkTickPostWidth i) = _ ∧
    (wireBlock w 770 258).drop (compactSkywalkTickPostWidth i) = _ ∧
    (wireBlock w i 258).drop (compactSkywalkTickPreWidth i) = _ ∧
    (wireBlock w 770 258).drop (compactSkywalkTickPreWidth i) = _
  exact ⟨blockDrop _ _ _ _ h.2.2.1,blockDrop _ _ _ _ h.2.2.1,
    blockDrop _ _ _ _ (by omega),blockDrop _ _ _ _ (by omega),
    blockDrop _ _ _ _ h.2.2.2.1,blockDrop _ _ _ _ h.2.2.2.1⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageStepGeometry

section WCompactSkywalkStageStepTails
/-! Copy of `Arithmetic/CompactSkywalkStageStepTails` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Both next full-word tails are clean: the native local tail is cleared by
actual CX, the previously omitted suffix is a frame, and A's new last site is fresh. -/
theorem compactSkywalkStageStep_clean_tails (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (r : SkywalkRails.State) (s : State) (m : List Bool)
    (hin : CompactSkywalkStageFields w r i s.basis) (A B : Int) (G : Bool)
    (hout : CompactSkywalkTickOutput w i A B G (run (compactSkywalkTick w i) m s).basis) :
    (compactSkywalkSignPoolA w (i+1)).Clean (run (compactSkywalkTick w i) m s).basis ∧
    (compactSkywalkSignPoolB w (i+1)).Clean (run (compactSkywalkTick w i) m s).basis := by
  rcases hin with ⟨ha,hb,hprev,hpast,hfuture,hcarry,horient,oldA,oldB⟩
  have width := compactSkywalkTick_width_bounds i hi
  have tv := compactSkywalkStageStep_tail_views w i hi
  have nowA := hout.2.2.2.2.2.2.1
  have nowB := hout.2.2.2.2.2.2.2
  have keepA (j : Nat) (hj0 : i+compactSkywalkTickPreWidth i+1 ≤ j) (hj1 : j ≤ i+258) :
      (run (compactSkywalkTick w i) m s).basis (w j) = s.basis (w j) := by
    have hp : j ≠ skywalkPoolPreviousId i := by
      unfold skywalkPoolPreviousId; split_ifs <;> omega
    exact compactSkywalkStage_tick_keep w i hi hn j (by omega) hp
      (by omega) (by omega) (by omega) (by omega)
      (by omega) (by omega) (by omega) s m
  have keepB (j : Nat) (hj0 : 770+compactSkywalkTickPreWidth i ≤ j) (hj1 : j < 1028) :
      (run (compactSkywalkTick w i) m s).basis (w j) = s.basis (w j) := by
    have hp : j ≠ skywalkPoolPreviousId i := by
      unfold skywalkPoolPreviousId; split_ifs <;> omega
    exact compactSkywalkStage_tick_keep w i hi hn j (by omega) hp
      (by omega) (by omega) (by omega) (by omega)
      (by omega) (by omega) (by omega) s m
  constructor
  · intro q hq
    rw [tv.2.2.1] at hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    by_cases current : j < i+1+compactSkywalkTickPreWidth i
    · apply nowA
      rw [tv.1]
      apply List.mem_map.mpr
      exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    · rw [keepA j (by omega) (by omega)]
      by_cases last : j = i+258
      · subst j
        exact (hfuture i (Nat.le_refl i) hi).1
      · apply oldA
        rw [tv.2.2.2.2.1]
        apply List.mem_map.mpr
        exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
  · intro q hq
    rw [tv.2.2.2.1] at hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    by_cases current : j < 770+compactSkywalkTickPreWidth i
    · apply nowB
      rw [tv.2.1]
      apply List.mem_map.mpr
      exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    · rw [keepB j (by omega) (by omega)]
      apply oldB
      rw [tv.2.2.2.2.2]
      apply List.mem_map.mpr
      exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageStepTails

section WCompactSkywalkStageStepProof
/-! Copy of `Arithmetic/CompactSkywalkStageStepProof` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Actual compact physical stage advancement. Every old tape/work/fresh
field is transported, while both next full-word tails are proved clean. -/
theorem compactSkywalkStageStep (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512) :
    Triple (CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i)
      (compactSkywalkTick w i)
      (CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) (i+1)) := by
  intro s m hin
  let r := SkywalkRails.encode false false (x:Int) (p:Int)
  let ri := SkywalkTrace.next^[i] r
  let t := SkywalkRails.step ri
  let out := run (compactSkywalkTick w i) m s
  have fields := (compactSkywalkStage_fields_iff w r i (by omega) hn s.basis).mp hin
  rcases fields with ⟨readA,readB,prev,past,future,carry,orient,cleanA,cleanB⟩
  have input := compactSkywalkStage_local_input w hn x p i hp0 hx0 hpo hp hq hx hc hi s hin
  have fit := narrowSkywalk_iter_fit x p i hp0 hx0 hpo hp hq hx hc hi
  have result := compactSkywalkTickOutput_spec w i hi hn ri.a ri.b ri.g
    fit.1 fit.2.1 fit.2.2.1 fit.2.2.2.1 fit.2.2.2.2 s m input
  have ho : CompactSkywalkTickOutput w i ri.a ri.b ri.g out.basis := result.2
  have tails := compactSkywalkStageStep_clean_tails w i hi hn r s m
    ⟨readA,readB,prev,past,future,carry,orient,cleanA,cleanB⟩ ri.a ri.b ri.g ho
  have views := compactSkywalkStageStep_retained w i hi
  have hnext : SkywalkTrace.next^[i+1] r = SkywalkRails.railsOf t := by
    rw [Function.iterate_succ_apply']
    rfl
  refine ⟨result.1,(compactSkywalkStage_fields_iff w r (i+1) (by omega) hn out.basis).mpr ?_⟩
  change CompactSkywalkStageFields w r (i+1) out.basis
  unfold CompactSkywalkStageFields
  rw [hnext]
  refine ⟨?_,?_,?_,?_,?_,?_,?_,tails.1,tails.2⟩
  · rw [views.1]
    exact ho.1
  · rw [views.2]
    exact ho.2.1
  · change out.basis (w (skywalkPoolPreviousId (i+1))) = t.g
    rw [skywalkPoolPreviousId,if_neg (by omega : i+1 ≠ 0)]
    simpa only [Nat.add_sub_cancel] using ho.2.2.1
  · intro j hj
    by_cases now : j = i
    · subst j
      exact ⟨ho.2.2.1,ho.2.2.2.1⟩
    · have old : j < i := by omega
      have history := past j old
      have keepG : out.basis (w j) = s.basis (w j) := by
        by_cases last : j+1 = i
        · have hkeep := compactSkywalkStageMetadata_previousG w i (by omega)
            ri.a ri.b ri.g s.basis out.basis input ho
          have he : i-1 = j := by omega
          simpa only [he] using hkeep
        · exact compactSkywalkStageMetadata_pastG w i hi hn j (by omega) s m
      have keepS := compactSkywalkStageMetadata_pastS w i hi hn j old s m
      exact ⟨keepG.trans history.1,keepS.trans history.2⟩
  · intro j hj hj512
    have before := future j (by omega) hj512
    exact ⟨(compactSkywalkStageMetadata_futureExtension w i hi hn j hj hj512 s m).trans before.1,
      (compactSkywalkStageMetadata_futureS w i hi hn j hj hj512 s m).trans before.2⟩
  · apply (regValue_zero _ _).mpr
    intro q hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    by_cases used : j < 1540+(compactSkywalkTickPreWidth i-1)
    · have carryClean := (regValue_zero _ _).mp ho.2.2.2.2.2.1
      apply carryClean
      change w j ∈ wireBlock w 1540 (compactSkywalkTickPreWidth i-1)
      exact List.mem_map.mpr ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    · have keep := compactSkywalkStageMetadata_carryTail w i hi hn j (by omega) (by omega) s m
      apply keep.trans
      exact (regValue_zero _ _).mp carry (w j)
        (List.mem_map.mpr ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩)
  · by_cases zero : i = 0
    · subst i
      exact (compactSkywalkStageMetadata_orientation_zero w ri.a ri.b ri.g
        s.basis out.basis input ho).trans orient
    · exact (compactSkywalkStageMetadata_orientation w i hi hn (by omega) s m).trans orient

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageStepProof

section WCompactSkywalkForward
/-! Copy of `Arithmetic/CompactSkywalkForward` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Actual forward compact ticks only; no high-word reconstruction or reverse
measurement instruction is inserted between physical compact boundaries. -/
def compactSkywalkForward (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => compactSkywalkTick w i++compactSkywalkForward w (i+1) n

attribute [local irreducible] compactSkywalkTick

/-- Exact stage induction includes phase, raw history, future zero sites,
full clean carry, initial orientation, and both omitted physical tails. -/
theorem compactSkywalkForward_spec (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i n : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hsteps : i+n ≤ 512) :
    Triple (CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i)
      (compactSkywalkForward w i n)
      (CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) (i+n)) := by
  induction n generalizing i with
  | zero =>
    intro s m hin
    exact ⟨rfl,hin⟩
  | succ n ih =>
    have first := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc (by omega)
    have rest := ih (i+1) (by omega)
    simpa only [compactSkywalkForward,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using first.seq rest

/-- The existing seed-stage input starts the full512 compact campaign directly. -/
theorem compactSkywalkForward_512 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) :
    Triple (SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0)
      (compactSkywalkForward w 0 512)
      (CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 512) := by
  intro s m hin
  exact compactSkywalkForward_spec w hn x p 0 512 hp0 hx0 hpo hp hq hx hc (by decide) s m
    ((compactSkywalkStage_zero_iff w _ s.basis).mpr hin)

/-- Pure arithmetic charge recurrences mirror actual per-tick resources. -/
def compactSkywalkForwardT (i : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => (compactSkywalkTickPreWidth i-1)+(compactSkywalkTickPostWidth i-1)+
      compactSkywalkForwardT (i+1) n

def compactSkywalkForwardM (i : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => (compactSkywalkTickPostWidth i-1)+compactSkywalkForwardM (i+1) n

theorem compactSkywalkForward_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) :
    toffoliCount (compactSkywalkForward w i n) = compactSkywalkForwardT i n ∧
    measurementCount (compactSkywalkForward w i n) = compactSkywalkForwardM i n := by
  induction n generalizing i with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    have first := compactSkywalkTick_counts w i (by omega) hn
    have rest := ih (i+1) (by omega)
    rw [compactSkywalkForward,toffoliCount_append,measurementCount_append,
      first.1,first.2,rest.1,rest.2]
    exact ⟨rfl,rfl⟩

private theorem fullCharges : compactSkywalkForwardT 0 512 = 197060 ∧
    compactSkywalkForwardM 0 512 = 98402 := by decide +kernel

/-- Full forward integer-leg cost, excluding seed, field replay and point glue. -/
theorem compactSkywalkForward_512_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (compactSkywalkForward w 0 512) = 197060 ∧
    measurementCount (compactSkywalkForward w 0 512) = 98402 := by
  have h := compactSkywalkForward_counts w hn 0 512 (by decide)
  rw [fullCharges.1,fullCharges.2] at h
  exact h

end ECDSAAdd.Entrant.W
end WCompactSkywalkForward

section WCompactSkywalkForwardFrame
/-! Copy of `Arithmetic/CompactSkywalkForwardFrame` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic
attribute [local irreducible] compactSkywalkTick

/-- Every actual forward tick remains inside the original integer pool.
This support ceiling is not a compact whole-point allocation certificate. -/
theorem compactSkywalkForward_support (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) :
    wires (compactSkywalkForward w i n) ⊆ (skywalkPoolWires w).toFinset := by
  induction n generalizing i with
  | zero => simp [compactSkywalkForward,wires]
  | succ n ih =>
    have hi : i < 512 := by omega
    have ht := compactSkywalkTick_support w i hi hn
    have hl := compactSkywalkTick_local_support w i hi
    have first : wires (compactSkywalkTick w i) ⊆ (skywalkPoolWires w).toFinset := by
      intro q hq
      exact List.mem_toFinset.mpr (hl (List.mem_toFinset.mp (ht hq)))
    rw [compactSkywalkForward,wires_append,Finset.union_subset_iff]
    exact ⟨first,ih (i+1) (by omega)⟩

/-- All caller wires outside the integer pool are preserved for arbitrary
input basis/phase and arbitrary complete measurement streams. -/
theorem compactSkywalkForward_frame (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) (s : State) (m : List Bool) (q : Wire)
    (hq : q ∉ skywalkPoolWires w) :
    (run (compactSkywalkForward w i n) m s).basis q = s.basis q :=
  run_preserves_outside _ m s q (fun h => hq
    (List.mem_toFinset.mp (compactSkywalkForward_support w hn i n hsteps h)))

end ECDSAAdd.Entrant.W
end WCompactSkywalkForwardFrame

section WCompressedCompactSupport
/-! Copy of `Arithmetic/CompressedCompactSupport` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic
attribute [local irreducible] compactSkywalkTick compressedHistoryEncode compressedEncodePrefix

/-- Exact local support of the actual compact native tick and sign-tail
cleanup excludes any group whose final orientation was already consumed. -/
theorem compressedHistory_disjoint_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (start i : Nat) (hs : start+3 ≤ 512) (hlate : start+4 ≤ i) (hi : i < 512) :
    Disjoint (wires (compressedHistoryEncode w start)) (wires (compactSkywalkTick w i)) := by
  apply Finset.disjoint_left.mpr
  intro q hq ht
  obtain ⟨j,rfl⟩ := compressedHistory_gate_mem w hn hlo start hs _ (Or.inl rfl) q hq
  have mem := List.mem_toFinset.mp (compactSkywalkTick_support w i hi hn ht)
  have width := compactSkywalkTick_width_bounds i hi
  have hpos : i ≠ 0 := by omega
  have away : w (compressedHistoryId start j) ∉ (compactSkywalkTickLayout w i).wires := by
    apply compactSkywalkStage_tick_away w i hi hn (compressedHistoryId start j)
      (compressedHistoryId_bound start hs j)
    all_goals
      have hj := j.isLt
      unfold compressedHistoryId
      split_ifs <;> (try simp only [skywalkPoolPreviousId,if_neg hpos]) <;> omega
  exact away mem

/-- Prefix packing remains disjoint from every later compact tick. The
existing delayed pack schedule is retained verbatim. -/
theorem compressedPrefix_disjoint_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (n i : Nat) (hni : n ≤ i) (hi : i < 512) :
    Disjoint (wires (compressedEncodePrefix w n)) (wires (compactSkywalkTick w i)) := by
  induction n with
  | zero => simp [compressedEncodePrefix,wires]
  | succ n ih =>
    have old := ih (by omega)
    have now : Disjoint (wires (compressedPackAfter w n)) (wires (compactSkywalkTick w i)) := by
      cases due : compressedPackDue n
      · simp [compressedPackAfter,due,wires]
      · have h3 := compressedPackDue_true n due
        have h := compressedHistory_disjoint_compactTick w hn hlo (n-3) i (by omega) (by omega) hi
        simpa only [compressedPackAfter,due,if_true] using h
    simp only [compressedEncodePrefix,wires_append,Finset.disjoint_union_left]
    exact ⟨old,now⟩

/-- The compact physical stage supplies the exact legal ternary tape to
all codec groups. No expanded-tail circuit is needed for this argument. -/
theorem compressedCompactHistory_legal (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i start : Nat)
    (hp0 : 0 < p) (hpo : p%2 = 1) (hs : start+3 ≤ i) (hi : i ≤ 512)
    (s : BasisState)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    (s (compressedHistoryMap w start 0) && s (compressedHistoryMap w start 1)) = false ∧
    (s (compressedHistoryMap w start 2) && s (compressedHistoryMap w start 3)) = false ∧
    (s (compressedHistoryMap w start 4) && s (compressedHistoryMap w start 5)) = false := by
  have fields := (compactSkywalkStage_fields_iff w _ i hi hn s).mp h
  have tape := fields.2.2.2.1
  have ternary (j : Nat) (hj : j < i) : (s (w j) && s (w (1028+j))) = false := by
    rw [(tape j hj).1,(tape j hj).2]
    exact skywalkRecordedSymbol_legal x p j hp0 hpo
  have a := ternary start (by omega)
  have b := ternary (start+1) (by omega)
  have c := ternary (start+2) (by omega)
  simpa [compressedHistoryMap,compressedHistoryId,Nat.add_assoc] using And.intro a (And.intro b c)

end ECDSAAdd.Entrant.W
end WCompressedCompactSupport

section WCompressedCompactStage
/-! Copy of `Arithmetic/CompressedCompactStage` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 4096
set_option maxHeartbeats 400000

namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- A ghost raw compact state supplies the exact integer invariant. Encoding is
an actual circuit program; the assertion equates the complete caller basis.
Incoming phase is unrestricted and is preserved separately by the Triple. -/
def CompressedCompactStage (w : Nat → Wire) (x p i : Nat) (bits : BasisState) : Prop :=
  ∃ raw : State,
    CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i raw.basis ∧
    bits = (run (compressedEncodePrefix w i) [] raw).basis

/-- Actual compact native ticks followed by the unchanged delayed codec packs. -/
def compressedCompactForward (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => compactSkywalkTick w i++compressedPackAfter w i++
      compressedCompactForward w (i+1) n

attribute [local irreducible] run compressedEncodePrefix compressedCompactForward
attribute [local irreducible] compactSkywalkTick compressedHistoryEncode

private theorem xor_neutral (a b : Bool) (h : (a ^^ b) = false) : a = b := by
  cases a <;> cases b <;> simp_all

theorem compressedCompactStage_zero (w : Nat → Wire) (x p : Nat) (s : State)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 s.basis) :
    CompressedCompactStage w x p 0 s.basis := by
  refine ⟨s,h,?_⟩
  simp only [compressedEncodePrefix,run]

theorem compressedCompactStage_step (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512) :
    Triple (CompressedCompactStage w x p i)
      (compactSkywalkTick w i ++ compressedPackAfter w i)
      (CompressedCompactStage w x p (i+1)) := by
  intro s m hs
  obtain ⟨raw,hraw,hbits⟩ := hs
  let tick := compactSkywalkTick w i
  let mt := m.take (measurementCount tick)
  let me := m.drop (measurementCount tick)
  let actual := run tick mt s
  let next := run tick [] raw
  have step := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc hi
  have hnxt := step raw [] hraw
  have hmt := step raw mt hraw
  have hd := compressedPrefix_disjoint_compactTick w hn hlo i i (Nat.le_refl i) hi
  have read : ∀ q ∈ wires tick,s.basis q = raw.basis q := by
    intro q hq
    rw [hbits]
    apply run_preserves_outside
    exact fun he => Finset.disjoint_left.mp hd he hq
  have hl := run_local_increment tick s raw mt read
  have hphase : actual.phase = s.phase := by
    apply xor_neutral
    have hh := hl.1
    rw [hmt.1] at hh
    simpa only [Bool.xor_self] using hh
  have hcomm := run_disjoint_commute (compressedEncodePrefix w i) tick hd [] [] raw
  have hb0 := run_basis_records tick s (run (compressedEncodePrefix w i) [] raw) mt [] hbits
  have hb : actual.basis = (run (compressedEncodePrefix w i) [] next).basis :=
    hb0.trans (congrArg State.basis hcomm.symm)
  have hpackphase : (run (compressedPackAfter w i) me actual).phase = actual.phase := by
    cases he : compressedPackDue i
    · simp only [compressedPackAfter,he,Bool.false_eq_true,if_false,run]
    · have h3 := compressedPackDue_true i he
      have same (j : Fin 6) : actual.basis (compressedHistoryMap w (i-3) j) = next.basis (compressedHistoryMap w (i-3) j) := by
        rw [hb]
        exact compressedPrefix_raw_next w hn hlo i hi he next [] j
      have legal := compressedCompactHistory_legal w hn x p (i+1) (i-3) hp0 hpo (by omega) (by omega) next.basis hnxt.2
      have actualLegal :
          (actual.basis (compressedHistoryMap w (i-3) 0) && actual.basis (compressedHistoryMap w (i-3) 1)) = false ∧
          (actual.basis (compressedHistoryMap w (i-3) 2) && actual.basis (compressedHistoryMap w (i-3) 3)) = false ∧
          (actual.basis (compressedHistoryMap w (i-3) 4) && actual.basis (compressedHistoryMap w (i-3) 5)) = false := by
        rw [same 0,same 1,same 2,same 3,same 4,same 5]
        exact legal
      have cp := TranscriptCodec3.placement_correct (compressedHistoryMap w (i-3))
        (compressedHistoryMap_injective w hn (i-3) (by omega))
        (compressedHistoryMap_above w (i-3) (by omega) hlo) actual me actualLegal
      simpa only [compressedPackAfter,he,if_true,compressedHistoryEncode] using cp.1
  have hpackbits := run_basis_records (compressedPackAfter w i) actual
    (run (compressedEncodePrefix w i) [] next) me [] hb
  have hbnext : (run (compressedPackAfter w i) me actual).basis = (run (compressedEncodePrefix w (i+1)) [] next).basis := by
    rw [compressedEncodePrefix,run_append]
    simp only [List.take_nil,List.drop_nil]
    exact hpackbits
  rw [run_append]
  exact ⟨hpackphase.trans hphase,⟨next,hnxt.2,hbnext⟩⟩

/-- Complete forward composition for arbitrary records, including phase.
This theorem retains the exact original divisor and all512 compact integer steps. -/
theorem CompressedCompactStage_spec (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p i n : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i+n ≤ 512) :
    Triple (CompressedCompactStage w x p i) (compressedCompactForward w i n)
      (CompressedCompactStage w x p (i+n)) := by
  induction n generalizing i with
  | zero =>
    rw [compressedCompactForward,Nat.add_zero]
    intro s m h
    simpa only [run] using And.intro (rfl : s.phase = s.phase) h
  | succ n ih =>
    have hstep := compressedCompactStage_step w hn hlo x p i hp0 hx0 hpo hp hq hx hc (by omega)
    have htail := ih (i+1) (by omega)
    have hall := hstep.seq htail
    have hindex : i+(n+1) = (i+1)+n := by omega
    rw [compressedCompactForward,hindex]
    simpa only [List.append_assoc] using hall

end ECDSAAdd.Entrant.W
end WCompressedCompactStage

section WCompressedCompactFrame
/-! Copy of `Arithmetic/CompressedCompactFrame` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic
attribute [local irreducible] run compactSkywalkTick compressedHistoryEncode compressedCompactForward

/-- The existing seed assertion starts the exact512 compact-plus-codec
campaign, with no changed divisor or shortened integer transcript. -/
theorem compressedCompactForward_512_spec (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) :
    Triple (SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0)
      (compressedCompactForward w 0 512) (CompressedCompactStage w x p 512) := by
  intro s m h
  have compact := (compactSkywalkStage_zero_iff w _ s.basis).mpr h
  exact CompressedCompactStage_spec w hn hlo x p 0 512 hp0 hx0 hpo hp hq hx hc (by decide)
    s m (compressedCompactStage_zero w x p s compact)

private theorem pack_support (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : CompressedHistoryAbove w) (i : Nat) (hi : i < 512) :
    wires (compressedPackAfter w i) ⊆ (skywalkPoolWires w).toFinset := by
  intro q hq
  cases due : compressedPackDue i
  · simp [compressedPackAfter,due,wires] at hq
  · have h3 := compressedPackDue_true i due
    have hq' : q ∈ wires (compressedHistoryEncode w (i-3)) := by
      simpa only [compressedPackAfter,due,if_true] using hq
    obtain ⟨j,rfl⟩ := compressedHistory_gate_mem w hn hlo (i-3) (by omega) _ (Or.inl rfl) q hq'
    have bound := compressedHistoryId_bound (i-3) (by omega) j
    apply List.mem_toFinset.mpr
    simp only [skywalkPoolWires,wireBlock,List.mem_map,List.mem_range'_1]
    exact ⟨compressedHistoryId (i-3) j,by omega,rfl⟩

/-- Actual instruction support includes compact sign release and all
measurement corrections of the history encoder. -/
theorem compressedCompactForward_support (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (i n : Nat) (hi : i+n ≤ 512) :
    wires (compressedCompactForward w i n) ⊆ (skywalkPoolWires w).toFinset := by
  induction n generalizing i with
  | zero => simp [compressedCompactForward,wires]
  | succ n ih =>
    have first : wires (compactSkywalkTick w i) ⊆ (skywalkPoolWires w).toFinset := by
      intro q hq
      exact List.mem_toFinset.mpr (compactSkywalkTick_local_support w i (by omega)
        (List.mem_toFinset.mp (compactSkywalkTick_support w i (by omega) hn hq)))
    have pack := pack_support w hn hlo i (by omega)
    simp only [compressedCompactForward,wires_append,Finset.union_subset_iff]
    exact ⟨⟨first,pack⟩,ih (i+1) (by omega)⟩

/-- Every caller bit outside the original integer pool restores, for all
input states and independent measurement records. -/
theorem compressedCompactForward_frame (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (i n : Nat) (hi : i+n ≤ 512) (s : State) (m : List Bool) (q : Wire)
    (hq : q ∉ skywalkPoolWires w) :
    (run (compressedCompactForward w i n) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro h
  exact hq (List.mem_toFinset.mp (compressedCompactForward_support w hn hlo i n hi h))

/-- Component resource recurrence for this actual emission. It is not a
whole-point qubit or stage resource claim. -/
theorem compressedCompactForward_counts (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    toffoliCount (compressedCompactForward w i n) = compactSkywalkForwardT i n+3*compressedPackCount i n ∧
    measurementCount (compressedCompactForward w i n) = compactSkywalkForwardM i n+compressedPackCount i n := by
  induction n generalizing i with
  | zero => simp [compressedCompactForward,compactSkywalkForwardT,compactSkywalkForwardM,
      compressedPackCount,toffoliCount,measurementCount]
  | succ n ih =>
    have tick := compactSkywalkTick_counts w i (by omega) hn
    have pack := compressedPackAfter_counts w i
    have tail := ih (i+1) (by omega)
    simp only [compressedCompactForward,toffoliCount_append,measurementCount_append,
      tick.1,tick.2,pack.1,pack.2.1,tail.1,tail.2,compactSkywalkForwardT,
      compactSkywalkForwardM,compressedPackCount]
    constructor <;> omega

end ECDSAAdd.Entrant.W
end WCompressedCompactFrame

section WCompactSkywalkReverseProgram
/-! Copy of `Arithmetic/CompactSkywalkReverseProgram` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Expand only the tails removed at the previous local tick. Their lengths
are preN-postN (zero or one), not258-postN. -/
def compactSkywalkReverseExpand (w : Nat → Wire) (i : Nat) : Program :=
  compactSkywalkSignExpand (compactSkywalkTickBRelease w i)++
    compactSkywalkSignExpand (compactSkywalkTickARelease w i)

/-- Fresh independently measured signed unrecord, then local half/route
reversal. No forward measurement instruction is reversed. -/
def compactSkywalkReverseTick (w : Nat → Wire) (i : Nat) : Program :=
  compactSkywalkReverseExpand w i++
    narrowSkywalkUntick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)

attribute [local irreducible] narrowSkywalkTick narrowSkywalkUntick
attribute [local irreducible] compactSkywalkSignRelease compactSkywalkSignExpand

theorem compactSkywalkReverseExpand_counts (w : Nat → Wire) (i : Nat) :
    toffoliCount (compactSkywalkReverseExpand w i) = 0 ∧
    measurementCount (compactSkywalkReverseExpand w i) = 0 := by
  have a := compactSkywalkSignRelease_counts (compactSkywalkTickARelease w i)
  have b := compactSkywalkSignRelease_counts (compactSkywalkTickBRelease w i)
  rw [compactSkywalkReverseExpand,toffoliCount_append,measurementCount_append,
    b.2.2.1,b.2.2.2,a.2.2.1,a.2.2.2]
  exact ⟨rfl,rfl⟩

/-- Local-tail expansion exactly cancels actual compact cleanup, with
independent record lists and arbitrary initial data in both local tails. -/
theorem compactSkywalkReverseExpand_cleanup (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m1 m2 : List Bool) :
    run (compactSkywalkReverseExpand w i) m2
      (run (compactSkywalkTickCleanup w i) m1 s) = s := by
  let A := compactSkywalkTickARelease w i
  let B := compactSkywalkTickBRelease w i
  have hv := compactSkywalkTick_release_valid w i hi hn
  have ca := compactSkywalkSignRelease_counts A
  have cb := compactSkywalkSignRelease_counts B
  change run (compactSkywalkSignExpand B++compactSkywalkSignExpand A) m2
    (run (compactSkywalkSignRelease A++compactSkywalkSignRelease B) m1 s) = s
  rw [compactSkywalkSign_no_measure_append _ _ ca.2.1,
    compactSkywalkSign_no_measure_append _ _ cb.2.2.2]
  rw [(compactSkywalkSignRelease_roundtrip B hv.2
    (run (compactSkywalkSignRelease A) m1 s) m1 m2).1]
  exact (compactSkywalkSignRelease_roundtrip A hv.1 s m1 m2).1

/-- Exact complete State inverse of the actual compact tick. Only its fresh
history and clean local carry are needed; measurement lists are independent. -/
theorem compactSkywalkReverseTick_roundtrip (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m1 m2 : List Bool)
    (hh : s.basis (compactSkywalkTickLayout w i).history = false)
    (hc : regValue (compactSkywalkTickLayout w i).carry s.basis = 0) :
    run (compactSkywalkReverseTick w i) m2 (run (compactSkywalkTick w i) m1 s) = s := by
  have hz := (compactSkywalkReverseExpand_counts w i).2
  have hr := compactSkywalkTickOutput_run w i s m1
  rw [hr,compactSkywalkReverseTick,compactSkywalkSign_no_measure_append _ _ hz]
  rw [compactSkywalkReverseExpand_cleanup w i hi hn _ m1 m2]
  have width := compactSkywalkTick_width_bounds i hi
  exact narrowSkywalkTick_roundtrip _ (compactSkywalkTick_valid w i hi hn)
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact width.2.2.1) s m1 m2 hh hc

theorem compactSkywalkReverseTick_counts (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (compactSkywalkReverseTick w i) =
      (compactSkywalkTickPreWidth i-1)+(compactSkywalkTickPostWidth i-1) ∧
    measurementCount (compactSkywalkReverseTick w i) = compactSkywalkTickPostWidth i-1 := by
  have width := compactSkywalkTick_width_bounds i hi
  have c := narrowSkywalkTick_counts _ (compactSkywalkTick_valid w i hi hn)
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact width.2.2.1)
  have z := compactSkywalkReverseExpand_counts w i
  rw [compactSkywalkReverseTick,toffoliCount_append,measurementCount_append,
    z.1,z.2,c.2.2.1,c.2.2.2,compactSkywalkTick_ah w i hi,wireBlock_length]
  exact ⟨by omega,by omega⟩

theorem compactSkywalkReverseExpand_support (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    wires (compactSkywalkReverseExpand w i) ⊆ (compactSkywalkTickLayout w i).wires.toFinset := by
  have h := compactSkywalkTick_width_bounds i hi
  have a := (compactSkywalkSignWord_support (compactSkywalkTickLayout w i).half
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1)).2
  have b := (compactSkywalkSignWord_support (compactSkywalkTickLayout w i).b
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_b w i hi,wireBlock_length]; exact h.2.2.1)).2
  intro q hq
  simp only [compactSkywalkReverseExpand,wires_append,Finset.mem_union] at hq
  rcases hq with hq|hq
  · have hb := List.mem_toFinset.mp (b hq)
    simp only [SkywalkIntegerLayout.b,SkywalkIntegerLayout.wires,List.mem_toFinset,
      List.mem_append,List.mem_cons] at hb ⊢
    tauto
  · have ha := List.mem_toFinset.mp (a hq)
    simp only [SkywalkIntegerLayout.half,SkywalkIntegerLayout.wires,List.mem_toFinset,
      List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at ha ⊢
    tauto

theorem compactSkywalkReverseTick_support (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    wires (compactSkywalkReverseTick w i) ⊆ (compactSkywalkTickLayout w i).wires.toFinset := by
  have h := compactSkywalkTick_width_bounds i hi
  have n := (narrowSkywalkTick_wires_subset _ (compactSkywalkTick_valid w i hi hn)
    (compactSkywalkTickPostWidth i) (by omega) (by
      rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact h.2.2.1)).2
  rw [compactSkywalkReverseTick,wires_append,Finset.union_subset_iff]
  exact ⟨compactSkywalkReverseExpand_support w i hi,n⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkReverseProgram

section WCompactSkywalkReverseLoop
/-! Copy of `Arithmetic/CompactSkywalkReverseLoop` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Walk back the actual compact ticks, with independent inverse measurements
and local sign expansion only at the immediately preceding width. -/
def compactSkywalkReverse (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => compactSkywalkReverse w (i+1) n++compactSkywalkReverseTick w i

attribute [local irreducible] compactSkywalkTick compactSkywalkReverseTick

/-- Complete physical State restoration on every valid compact forward path.
No arbitrary-poststate reachability premise or reused measurement stream is assumed. -/
theorem compactSkywalkReverse_roundtrip (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i n : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hsteps : i+n ≤ 512)
    (s : State) (m1 m2 : List Bool)
    (hin : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    run (compactSkywalkReverse w i n) m2 (run (compactSkywalkForward w i n) m1 s) = s := by
  induction n generalizing i s m1 m2 with
  | zero => rfl
  | succ n ih =>
    have hi : i < 512 := by omega
    let tick := compactSkywalkTick w i
    simp only [compactSkywalkForward,compactSkywalkReverse]
    rw [run_append,run_append]
    generalize htick : run tick (m1.take (measurementCount tick)) s = t
    have hs := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc hi
      s (m1.take (measurementCount tick)) hin
    rw [htick] at hs
    have htail := ih (i+1) (by omega) t (m1.drop (measurementCount tick))
      (m2.take (measurementCount (compactSkywalkReverse w (i+1) n))) hs.2
    have localInput := compactSkywalkStage_local_input w hn x p i hp0 hx0 hpo hp hq hx hc hi s hin
    have restore := compactSkywalkReverseTick_roundtrip w i hi hn s
      (m1.take (measurementCount tick))
      (m2.drop (measurementCount (compactSkywalkReverse w (i+1) n)))
      localInput.2.2.2.2.1 localInput.2.2.2.2.2
    rw [htick] at restore
    rw [htail]
    exact restore

/-- The old canonical seed-stage input gives a full512-tick measured roundtrip. -/
theorem compactSkywalkReverse_512_roundtrip (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (s : State) (m1 m2 : List Bool)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 s.basis) :
    run (compactSkywalkReverse w 0 512) m2 (run (compactSkywalkForward w 0 512) m1 s) = s :=
  compactSkywalkReverse_roundtrip w hn x p 0 512 hp0 hx0 hpo hp hq hx hc (by decide) s m1 m2
    ((compactSkywalkStage_zero_iff w _ s.basis).mpr hin)

theorem compactSkywalkReverse_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) :
    toffoliCount (compactSkywalkReverse w i n) = compactSkywalkForwardT i n ∧
    measurementCount (compactSkywalkReverse w i n) = compactSkywalkForwardM i n := by
  induction n generalizing i with
  | zero => exact ⟨rfl,rfl⟩
  | succ n ih =>
    have first := compactSkywalkReverseTick_counts w i (by omega) hn
    have rest := ih (i+1) (by omega)
    rw [compactSkywalkReverse,toffoliCount_append,measurementCount_append,
      first.1,first.2,rest.1,rest.2]
    change compactSkywalkForwardT (i+1) n+
      ((compactSkywalkTickPreWidth i-1)+(compactSkywalkTickPostWidth i-1)) =
        (compactSkywalkTickPreWidth i-1)+(compactSkywalkTickPostWidth i-1)+
          compactSkywalkForwardT (i+1) n ∧
      compactSkywalkForwardM (i+1) n+(compactSkywalkTickPostWidth i-1) =
        (compactSkywalkTickPostWidth i-1)+compactSkywalkForwardM (i+1) n
    exact ⟨Nat.add_comm _ _,Nat.add_comm _ _⟩

theorem compactSkywalkReverse_512_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (compactSkywalkReverse w 0 512) = 197060 ∧
    measurementCount (compactSkywalkReverse w 0 512) = 98402 := by
  have r := compactSkywalkReverse_counts w hn 0 512 (by decide)
  have f := compactSkywalkForward_counts w hn 0 512 (by decide)
  have exactCounts := compactSkywalkForward_512_counts w hn
  exact ⟨r.1.trans (f.1.symm.trans exactCounts.1),r.2.trans (f.2.symm.trans exactCounts.2)⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkReverseLoop

section WCompactSkywalkReverseFrame
/-! Copy of `Arithmetic/CompactSkywalkReverseFrame` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic
attribute [local irreducible] compactSkywalkReverseTick

/-- Independently emitted reverse instructions touch only the integer pool. -/
theorem compactSkywalkReverse_support (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) :
    wires (compactSkywalkReverse w i n) ⊆ (skywalkPoolWires w).toFinset := by
  induction n generalizing i with
  | zero => simp [compactSkywalkReverse,wires]
  | succ n ih =>
    have hi : i < 512 := by omega
    have hs := compactSkywalkReverseTick_support w i hi hn
    have hl := compactSkywalkTick_local_support w i hi
    have tick : wires (compactSkywalkReverseTick w i) ⊆ (skywalkPoolWires w).toFinset := by
      intro q hq
      exact List.mem_toFinset.mpr (hl (List.mem_toFinset.mp (hs hq)))
    rw [compactSkywalkReverse,wires_append,Finset.union_subset_iff]
    exact ⟨ih (i+1) (by omega),tick⟩

theorem compactSkywalkReverse_frame (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) (s : State) (m : List Bool) (q : Wire)
    (hq : q ∉ skywalkPoolWires w) :
    (run (compactSkywalkReverse w i n) m s).basis q = s.basis q :=
  run_preserves_outside _ m s q (fun h => hq
    (List.mem_toFinset.mp (compactSkywalkReverse_support w hn i n hsteps h)))

/-- A coexisting field operation may change every outsider while retaining
integer-pool bits and phase. Actual reverse then restores the original pool,
preserves the field's outsider values, and restores incoming phase. -/
theorem compactSkywalkReverse_restore_after_outside (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i n : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1) (hp : p < 2^256) (hq : p+2^32 ≤ 2^256)
    (hx : x < p) (hc : x.Coprime p) (hsteps : i+n ≤ 512)
    (s field : State) (mForward mReverse : List Bool)
    (hin : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis)
    (hphase : field.phase = (run (compactSkywalkForward w i n) mForward s).phase)
    (hpool : ∀q ∈ skywalkPoolWires w,
      field.basis q = (run (compactSkywalkForward w i n) mForward s).basis q) :
    (run (compactSkywalkReverse w i n) mReverse field).phase = s.phase ∧
    (∀q ∈ skywalkPoolWires w,
      (run (compactSkywalkReverse w i n) mReverse field).basis q = s.basis q) ∧
    (∀q,q ∉ skywalkPoolWires w →
      (run (compactSkywalkReverse w i n) mReverse field).basis q = field.basis q) := by
  have inverse := compactSkywalkReverse_roundtrip w hn x p i n hp0 hx0 hpo hp hq hx hc
    hsteps s mForward mReverse hin
  have agrees := pool_run_agrees (compactSkywalkReverse w i n) (skywalkPoolWires w).toFinset
    (compactSkywalkReverse_support w hn i n hsteps) mReverse field
    (run (compactSkywalkForward w i n) mForward s) hphase
    (fun q hq => hpool q (List.mem_toFinset.mp hq))
  rw [inverse] at agrees
  refine ⟨agrees.1,?_,?_⟩
  · intro q hq
    exact agrees.2 q (List.mem_toFinset.mpr hq)
  · intro q hq
    exact compactSkywalkReverse_frame w hn i n hsteps field mReverse q hq

end ECDSAAdd.Entrant.W
end WCompactSkywalkReverseFrame

section WCompressedCompactReverseProgram
/-! Copy of `Arithmetic/CompressedCompactReverseProgram` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Actual compact reverse ticks; only each tick's local pre/post tails
are expanded, and the unchanged delayed codec schedule is decoded. -/
def compressedCompactReverse (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => compressedCompactReverse w (i+1) n++compressedDecodeBefore w i++
      compactSkywalkReverseTick w i

attribute [local irreducible] run compactSkywalkReverseTick compactSkywalkReverse
attribute [local irreducible] compressedCompactReverse compressedHistoryDecode
attribute [local irreducible] compressedDecodeRange compressedDecodePrefix

theorem compressedHistory_disjoint_compactReverseTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (start i : Nat) (hs : start+3 ≤ 512) (hlate : start+4 ≤ i) (hi : i < 512) :
    Disjoint (wires (compressedHistoryDecode w start)) (wires (compactSkywalkReverseTick w i)) := by
  apply Finset.disjoint_left.mpr
  intro q hq ht
  obtain ⟨j,rfl⟩ := compressedHistory_gate_mem w hn hlo start hs _ (Or.inr rfl) q hq
  have mem := List.mem_toFinset.mp (compactSkywalkReverseTick_support w i hi hn ht)
  have width := compactSkywalkTick_width_bounds i hi
  have hpos : i ≠ 0 := by omega
  have away : w (compressedHistoryId start j) ∉ (compactSkywalkTickLayout w i).wires := by
    apply compactSkywalkStage_tick_away w i hi hn (compressedHistoryId start j)
      (compressedHistoryId_bound start hs j)
    all_goals
      have hj := j.isLt
      unfold compressedHistoryId
      split_ifs <;> (try simp only [skywalkPoolPreviousId,if_neg hpos]) <;> omega
  exact away mem

/-- Component charge equality also supplies exact record alignment when
zero-measurement decoders are moved before disjoint compact inverse ticks. -/
theorem compressedCompactReverse_counts_relative (w : Nat → Wire) (i n : Nat) :
    toffoliCount (compressedCompactReverse w i n) =
      toffoliCount (compactSkywalkReverse w i n)+4*compressedPackCount i n ∧
    measurementCount (compressedCompactReverse w i n) = measurementCount (compactSkywalkReverse w i n) := by
  induction n generalizing i with
  | zero => simp [compressedCompactReverse,compactSkywalkReverse,compressedPackCount,toffoliCount,measurementCount]
  | succ n ih =>
    have pack := compressedPackAfter_counts w i
    have tail := ih (i+1)
    simp only [compressedCompactReverse,compactSkywalkReverse,compressedPackCount,
      toffoliCount_append,measurementCount_append,pack.2.2.1,pack.2.2.2,tail.1,tail.2]
    constructor <;> omega

theorem compressedDecodeBefore_disjoint_compactReverse (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (i j n : Nat) (hgap : i < j) (hbound : j+n ≤ 512) :
    Disjoint (wires (compressedDecodeBefore w i)) (wires (compactSkywalkReverse w j n)) := by
  induction n generalizing j with
  | zero => simp [compactSkywalkReverse,wires]
  | succ n ih =>
    have ht := ih (j+1) (by omega) (by omega)
    have hh : Disjoint (wires (compressedDecodeBefore w i)) (wires (compactSkywalkReverseTick w j)) := by
      cases he : compressedPackDue i
      · simp [compressedDecodeBefore,he,wires]
      · have hi3 := compressedPackDue_true i he
        have hs := compressedHistory_disjoint_compactReverseTick w hn hlo (i-3) j (by omega) (by omega) (by omega)
        simpa only [compressedDecodeBefore,he,if_true] using hs
    simp only [compactSkywalkReverse,wires_append,Finset.disjoint_union_right]
    exact ⟨ht,hh⟩

/-- Exact normalization of the emitted reverse program. Decoders consume no
measurements, so moving them ahead of disjoint later ticks preserves the same
record list, not merely a suitably relabeled list. This holds for all states. -/
theorem compressedCompactReverse_normalize (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (i n : Nat) (hbound : i+n ≤ 512) (s : State) (m : List Bool) :
    run (compressedCompactReverse w i n) m s=
      run (compressedDecodeRange w i n ++ compactSkywalkReverse w i n) m s := by
  induction n generalizing i s m with
  | zero => simp [compressedCompactReverse,compressedDecodeRange,compactSkywalkReverse,run]
  | succ n ih =>
    have hm := (compressedCompactReverse_counts_relative w (i+1) n).2
    have hd := compressedDecodeBefore_disjoint_compactReverse w hn hlo i (i+1) n (by omega) (by omega)
    have hc := run_disjoint_commute (compressedDecodeBefore w i)
      (compactSkywalkReverse w (i+1) n) hd []
      (m.take (measurementCount (compactSkywalkReverse w (i+1) n)))
      (run (compressedDecodeRange w (i+1) n) [] s)
    rw [compressedCompactReverse,compressedDecodeRange,compactSkywalkReverse]
    simp only [run_append,measurementCount_append,hm,
      (compressedPackAfter_counts w i).2.2.2,compressedDecodeRange_measurements,
      Nat.add_zero,List.take_zero,List.drop_zero]
    rw [ih (i+1) (by omega)]
    have hzero : min 0 (measurementCount (compactSkywalkReverse w (i+1) n))=0 :=
      Nat.min_eq_left (Nat.zero_le _)
    simp only [run_append,compressedDecodeRange_measurements,List.take_zero,List.drop_zero,
      List.take_take,Nat.min_self,List.drop_take_self,hzero]
    rw [hc]

end ECDSAAdd.Entrant.W
end WCompressedCompactReverseProgram

section WCompressedCompactDecode
/-! Copy of `Arithmetic/CompressedCompactDecode` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic
attribute [local irreducible] run compressedDecodePrefix compressedEncodePrefix
attribute [local irreducible] compressedHistoryEncode compressedHistoryDecode

/-- Every compressed priorEncoded has a separately emitted coherent inverse.
The input domain comes from the actual exact integer-history assertion. -/
theorem compressedCompactDecodePrefix_inverse (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p n i : Nat) (hp0 : 0 < p) (hpo : p%2 = 1) (hni : n ≤ i) (hi : i ≤ 512)
    (s : State) (mE mD : List Bool)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    run (compressedDecodePrefix w n) mD (run (compressedEncodePrefix w n) mE s)=s := by
  induction n generalizing mE mD with
  | zero => simp [compressedEncodePrefix,compressedDecodePrefix,run]
  | succ n ih =>
    have hbound : n < 512 := by omega
    let priorEncoded := run (compressedEncodePrefix w n)
      (mE.take (measurementCount (compressedEncodePrefix w n))) s
    have clean : run (compressedDecodeBefore w n) []
        (run (compressedPackAfter w n) (mE.drop (measurementCount (compressedEncodePrefix w n))) priorEncoded)=priorEncoded := by
      cases he : compressedPackDue n
      · simp only [compressedDecodeBefore,compressedPackAfter,he,Bool.false_eq_true,if_false,run]
      · have hn3 := compressedPackDue_true n he
        have same (j : Fin 6) : priorEncoded.basis (compressedHistoryMap w (n-3) j)=
            s.basis (compressedHistoryMap w (n-3) j) := by
          exact compressedPrefix_raw_next w hn hlo n hbound he s _ j
        have rawLegal := compressedCompactHistory_legal w hn x p i (n-3) hp0 hpo (by omega) hi s.basis h
        have legal :
            (priorEncoded.basis (compressedHistoryMap w (n-3) 0) && priorEncoded.basis (compressedHistoryMap w (n-3) 1))=false ∧
            (priorEncoded.basis (compressedHistoryMap w (n-3) 2) && priorEncoded.basis (compressedHistoryMap w (n-3) 3))=false ∧
            (priorEncoded.basis (compressedHistoryMap w (n-3) 4) && priorEncoded.basis (compressedHistoryMap w (n-3) 5))=false := by
          rw [same 0,same 1,same 2,same 3,same 4,same 5]
          exact rawLegal
        have hc := TranscriptCodec3.decode_encode (compressedHistoryMap w (n-3))
          (compressedHistoryMap_injective w hn (n-3) (by omega))
          (compressedHistoryMap_above w (n-3) (by omega) hlo) priorEncoded
          (mE.drop (measurementCount (compressedEncodePrefix w n))) [] legal
        simpa only [compressedDecodeBefore,compressedPackAfter,he,if_true,
          compressedHistoryEncode,compressedHistoryDecode] using hc
    rw [compressedEncodePrefix,compressedDecodePrefix,run_append,run_append]
    have hd0 := (compressedPackAfter_counts w n).2.2.2
    rw [hd0]
    simp only [List.take_zero,List.drop_zero]
    rw [clean]
    exact ih (by omega) _ _

/-- The actual coherent decoder recovers the compact raw state, including
caller outsiders, and preserves the current input phase independently of records. -/
theorem compressedCompactStage_decoded (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p n : Nat) (hp0 : 0 < p) (hpo : p%2 = 1) (hn512 : n ≤ 512)
    (s : State) (h : CompressedCompactStage w x p n s.basis) :
    (run (compressedDecodePrefix w n) [] s).phase = s.phase ∧
    CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) n
      (run (compressedDecodePrefix w n) [] s).basis := by
  obtain ⟨raw,hraw,hbasis⟩ := h
  have inverse := compressedCompactDecodePrefix_inverse w hn hlo x p n n hp0 hpo
    (Nat.le_refl n) hn512 raw [] [] hraw
  have records := run_basis_records (compressedDecodePrefix w n) s
    (run (compressedEncodePrefix w n) [] raw) [] [] hbasis
  have bits : (run (compressedDecodePrefix w n) [] s).basis = raw.basis :=
    records.trans (congrArg State.basis inverse)
  refine ⟨run_no_measurement_phase _ (compressedDecodePrefix_measurements w n) s [],?_⟩
  rw [bits]
  exact hraw

end ECDSAAdd.Entrant.W
end WCompressedCompactDecode

section WCompactSkywalkStageTerminal
/-! Copy of `Arithmetic/CompactSkywalkStageTerminal` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic

/-- Clean physical tails and nonnegative retained rails make reconstruction
literally the original physical basis, for either terminal orientation. -/
theorem compactSkywalkStage_nonnegative_identity (w : Nat → Wire) (i : Nat) (hi : i ≤ 512)
    (hn : (skywalkPoolWires w).Nodup) (r : SkywalkRails.State) (s : BasisState)
    (hin : CompactSkywalkStage w r i s)
    (ha : 0 ≤ (SkywalkTrace.next^[i] r).a) (hb : 0 ≤ (SkywalkTrace.next^[i] r).b) :
    compactSkywalkStageVirtual w i s = s := by
  have values := compactSkywalkStage_virtual_values w i hi hn s
  have va := values.1.symm.trans hin.1.1
  have vb := values.2.symm.trans hin.1.2.1
  have sa := signedRegValue_sign (compactSkywalkSignPoolA w i).low
    (compactSkywalkSignPoolA w i).sign s
  have sb := signedRegValue_sign (compactSkywalkSignPoolB w i).low
    (compactSkywalkSignPoolB w i).sign s
  change s (compactSkywalkSignPoolA w i).sign =
    SkywalkRails.neg (signedRegValue (compactSkywalkSignPoolA w i).retained s) at sa
  change s (compactSkywalkSignPoolB w i).sign =
    SkywalkRails.neg (signedRegValue (compactSkywalkSignPoolB w i).retained s) at sb
  rw [va] at sa
  rw [vb] at sb
  have za : s (compactSkywalkSignPoolA w i).sign = false := by
    simpa only [SkywalkRails.neg,not_lt.mpr ha,decide_false] using sa
  have zb : s (compactSkywalkSignPoolB w i).sign = false := by
    simpa only [SkywalkRails.neg,not_lt.mpr hb,decide_false] using sb
  funext q
  by_cases qa : q ∈ (compactSkywalkSignPoolA w i).released
  · simp only [compactSkywalkStageVirtual,if_pos qa,za,hin.2.1 q qa]
  by_cases qb : q ∈ (compactSkywalkSignPoolB w i).released
  · simp only [compactSkywalkStageVirtual,if_neg qa,if_pos qb,zb,hin.2.2 q qb]
  · exact compactSkywalkStage_virtual_outside w i s q qa qb

/-- Exact termination has unsigned magnitudes (0,1); its orientation G is
arbitrary, hence the signed rails may be (1,0) or (0,1). Both are nonnegative. -/
theorem compactSkywalkStage_terminal_nonnegative (x p : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1) (hp : p < 2^256)
    (hx : x < p) (hc : x.Coprime p) :
    0 ≤ (SkywalkTrace.next^[512] (SkywalkRails.encode false false (x:Int) (p:Int))).a ∧
    0 ≤ (SkywalkTrace.next^[512] (SkywalkRails.encode false false (x:Int) (p:Int))).b := by
  have ht := SkywalkNat.terminates_2n p x 256 hp0 hx0 hpo hp (hx.trans hp) hc
  obtain ⟨G,S,he⟩ := SkywalkTrace.iter_encoded 512 false false (SkywalkNat.init x p) hp0 hpo
  norm_num only at ht
  simp only [SkywalkNat.init] at he ht
  rw [ht.1,ht.2] at he
  rw [he]
  cases G <;> cases S <;> norm_num [SkywalkRails.encode,SkywalkRails.signed]

/-- The unchanged old terminal caller may consume the physical compact state
at512 directly. No actual high-word expansion is needed. -/
theorem compactSkywalkStage_terminal (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1) (hp : p < 2^256)
    (hx : x < p) (hc : x.Coprime p) (s : BasisState)
    (hin : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 512 s) :
    compactSkywalkStageVirtual w 512 s = s ∧
    SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 512 s := by
  have pos := compactSkywalkStage_terminal_nonnegative x p hp0 hx0 hpo hp hx hc
  have he := compactSkywalkStage_nonnegative_identity w 512 (by decide) hn _ s hin pos.1 pos.2
  exact ⟨he,by simpa only [he] using hin.1⟩

end ECDSAAdd.Entrant.W
end WCompactSkywalkStageTerminal

section WCompressedCompactRestore
/-! Copy of `Arithmetic/CompressedCompactRestore` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic
attribute [local irreducible] run compactSkywalkForward compactSkywalkReverse compressedCompactReverse

private theorem decode_support (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : CompressedHistoryAbove w) (i : Nat) (hi : i < 512) :
    wires (compressedDecodeBefore w i) ⊆ (skywalkPoolWires w).toFinset := by
  intro q hq
  cases due : compressedPackDue i
  · simp [compressedDecodeBefore,due,wires] at hq
  · have h3 := compressedPackDue_true i due
    have hq' : q ∈ wires (compressedHistoryDecode w (i-3)) := by
      simpa only [compressedDecodeBefore,due,if_true] using hq
    obtain ⟨j,rfl⟩ := compressedHistory_gate_mem w hn hlo (i-3) (by omega) _ (Or.inr rfl) q hq'
    have bound := compressedHistoryId_bound (i-3) (by omega) j
    apply List.mem_toFinset.mpr
    simp only [skywalkPoolWires,wireBlock,List.mem_map,List.mem_range'_1]
    exact ⟨compressedHistoryId (i-3) j,by omega,rfl⟩

theorem compressedCompactReverse_support (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (i n : Nat) (hsteps : i+n ≤ 512) :
    wires (compressedCompactReverse w i n) ⊆ (skywalkPoolWires w).toFinset := by
  induction n generalizing i with
  | zero => simp [compressedCompactReverse,wires]
  | succ n ih =>
    have tick : wires (compactSkywalkReverseTick w i) ⊆ (skywalkPoolWires w).toFinset := by
      intro q hq
      exact List.mem_toFinset.mpr (compactSkywalkTick_local_support w i (by omega)
        (List.mem_toFinset.mp (compactSkywalkReverseTick_support w i (by omega) hn hq)))
    simp only [compressedCompactReverse,wires_append,Finset.union_subset_iff]
    exact ⟨⟨ih (i+1) (by omega),decode_support w hn hlo i (by omega)⟩,tick⟩

theorem compressedCompactReverse_frame (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (i n : Nat) (hsteps : i+n ≤ 512) (s : State) (m : List Bool) (q : Wire)
    (hq : q ∉ skywalkPoolWires w) :
    (run (compressedCompactReverse w i n) m s).basis q = s.basis q := by
  apply run_preserves_outside
  intro h
  exact hq (List.mem_toFinset.mp (compressedCompactReverse_support w hn hlo i n hsteps h))

/-- The terminal compact predicate determines the physical integer pool.
The reference emitter and its inverse here are both genuinely compact. -/
private theorem terminal_restore (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (initial s : State) (m : List Bool)
    (hinit : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 initial.basis)
    (hfinal : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 512 s.basis) :
    (run (compactSkywalkReverse w 0 512) m s).phase = s.phase ∧
    ∀ q ∈ skywalkPoolWires w,(run (compactSkywalkReverse w 0 512) m s).basis q = initial.basis q := by
  let start : State := ⟨s.phase,initial.basis⟩
  have forward := compactSkywalkForward_512 w hn x p hp0 hx0 hpo hp hq hx hc start [] hinit
  have own := (compactSkywalkStage_terminal w hn x p hp0 hx0 hpo hp hx hc s.basis hfinal).2
  have reference := (compactSkywalkStage_terminal w hn x p hp0 hx0 hpo hp hx hc _ forward.2).2
  have inverse := compactSkywalkReverse_512_roundtrip w hn x p hp0 hx0 hpo hp hq hx hc start [] m hinit
  have bits : ∀ q ∈ (skywalkPoolWires w).toFinset,
      s.basis q = (run (compactSkywalkForward w 0 512) [] start).basis q := by
    intro q hq
    exact skywalkIntegerStage_agrees w _ 512 (by decide) _ _ own reference q (List.mem_toFinset.mp hq)
  have agrees := pool_run_agrees (compactSkywalkReverse w 0 512) (skywalkPoolWires w).toFinset
    (compactSkywalkReverse_support w hn 0 512 (by decide)) m s
    (run (compactSkywalkForward w 0 512) [] start) forward.1.symm bits
  rw [inverse] at agrees
  refine ⟨agrees.1,?_⟩
  intro q hq
  exact agrees.2 q (List.mem_toFinset.mpr hq)

/-- Complete512 compact-plus-codec restoration from the encoded terminal
pool. Outsiders may already contain arbitrary coexisting field updates. -/
theorem compressedCompactReverse_restore_pool (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (initial s : State) (m : List Bool)
    (hinit : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 initial.basis)
    (hfinal : CompressedCompactStage w x p 512 s.basis) :
    (run (compressedCompactReverse w 0 512) m s).phase = s.phase ∧
    ∀ q ∈ skywalkPoolWires w,(run (compressedCompactReverse w 0 512) m s).basis q = initial.basis q := by
  have decoded := compressedCompactStage_decoded w hn hlo x p 512 hp0 hpo (by decide) s hfinal
  have restored := terminal_restore w hn x p hp0 hx0 hpo hp hq hx hc
    initial (run (compressedDecodePrefix w 512) [] s) m hinit decoded.2
  rw [compressedCompactReverse_normalize w hn hlo 0 512 (by decide),compressedDecodeRange_zero,
    run_append,compressedDecodePrefix_measurements]
  simp only [List.take_zero,List.drop_zero]
  exact ⟨restored.1.trans decoded.1,restored.2⟩

/-- Forward and inverse records are independent, and the full physical
caller State returns, including arbitrary incoming phase and every outsider. -/
theorem compressedCompactReverse_512_roundtrip (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (s : State) (mForward mReverse : List Bool)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 s.basis) :
    run (compressedCompactReverse w 0 512) mReverse
      (run (compressedCompactForward w 0 512) mForward s) = s := by
  have forward := compressedCompactForward_512_spec w hn hlo x p hp0 hx0 hpo hp hq hx hc s mForward hin
  have reverse := compressedCompactReverse_restore_pool w hn hlo x p hp0 hx0 hpo hp hq hx hc
    s (run (compressedCompactForward w 0 512) mForward s) mReverse hin forward.2
  apply State.extensionality
  · exact reverse.1.trans forward.1
  · funext q
    by_cases hq : q ∈ skywalkPoolWires w
    · exact reverse.2 q hq
    · exact (compressedCompactReverse_frame w hn hlo 0 512 (by decide) _ mReverse q hq).trans
        (compressedCompactForward_frame w hn hlo 0 512 (by decide) s mForward q hq)

/-- A field operation need only retain the actual encoded integer pool and
phase. The emitted compact reverse restores it and keeps all field outsiders. -/
theorem compressedCompactReverse_restore_after_outside (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (s field : State) (mForward mReverse : List Bool)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 s.basis)
    (hphase : field.phase = (run (compressedCompactForward w 0 512) mForward s).phase)
    (hpool : ∀ q ∈ skywalkPoolWires w,
      field.basis q = (run (compressedCompactForward w 0 512) mForward s).basis q) :
    (run (compressedCompactReverse w 0 512) mReverse field).phase = s.phase ∧
    (∀ q ∈ skywalkPoolWires w,(run (compressedCompactReverse w 0 512) mReverse field).basis q = s.basis q) ∧
    (∀ q,q ∉ skywalkPoolWires w → (run (compressedCompactReverse w 0 512) mReverse field).basis q = field.basis q) := by
  have inverse := compressedCompactReverse_512_roundtrip w hn hlo x p hp0 hx0 hpo hp hq hx hc s mForward mReverse hin
  have agrees := pool_run_agrees (compressedCompactReverse w 0 512) (skywalkPoolWires w).toFinset
    (compressedCompactReverse_support w hn hlo 0 512 (by decide)) mReverse field
    (run (compressedCompactForward w 0 512) mForward s) hphase
    (fun q hq => hpool q (List.mem_toFinset.mp hq))
  rw [inverse] at agrees
  refine ⟨agrees.1,?_,?_⟩
  · intro q hq; exact agrees.2 q (List.mem_toFinset.mpr hq)
  · intro q hq; exact compressedCompactReverse_frame w hn hlo 0 512 (by decide) field mReverse q hq

/-- Actual reverse component prices; no whole-point allocation claim. -/
theorem compressedCompactReverse_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hsteps : i+n ≤ 512) :
    toffoliCount (compressedCompactReverse w i n) = compactSkywalkForwardT i n+4*compressedPackCount i n ∧
    measurementCount (compressedCompactReverse w i n) = compactSkywalkForwardM i n := by
  have relative := compressedCompactReverse_counts_relative w i n
  have compact := compactSkywalkReverse_counts w hn i n hsteps
  rw [compact.1,compact.2] at relative
  exact relative

end ECDSAAdd.Entrant.W
end WCompressedCompactRestore

section WEndpoints
/-! The tighter schedule agrees with the original one at stages 0, 1 and 512.
Hence the first tick, the stage-1 and stage-512 invariants, and the complete
terminal State of the compressed forward pass are literally the original
ones; every block outside the integer passes is reused unchanged. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic CompressedFieldSupport
attribute [local irreducible] run wires Arithmetic.compactSkywalkForward compressedCompactForward
  Arithmetic.compressedCompactForward allGroupEncode SkywalkTrace.next Nat.iterate SkywalkIntegerStage

theorem compactSkywalkTick_zero_eq (w : Nat → Wire) :
    compactSkywalkTick w 0=Arithmetic.compactSkywalkTick w 0 := by
  have h1 : compactSkywalkTickPreWidth 0=Arithmetic.compactSkywalkTickPreWidth 0 :=
    narrowSkywalkRouteWidth_endpoints.1
  have h2 : compactSkywalkTickPostWidth 0=Arithmetic.compactSkywalkTickPostWidth 0 :=
    narrowSkywalkRouteWidth_endpoints.2.2.2
  unfold compactSkywalkTick Arithmetic.compactSkywalkTick compactSkywalkTickCleanup
    Arithmetic.compactSkywalkTickCleanup compactSkywalkTickARelease
    Arithmetic.compactSkywalkTickARelease compactSkywalkTickBRelease
    Arithmetic.compactSkywalkTickBRelease compactSkywalkTickLayout Arithmetic.compactSkywalkTickLayout
  rw [h1,h2]

theorem signPool_eq (w : Nat → Wire) (i : Nat)
    (h : narrowSkywalkRouteWidth i=Arithmetic.narrowSkywalkRouteWidth i) :
    compactSkywalkSignPoolA w i=Arithmetic.compactSkywalkSignPoolA w i ∧
    compactSkywalkSignPoolB w i=Arithmetic.compactSkywalkSignPoolB w i := by
  unfold compactSkywalkSignPoolA Arithmetic.compactSkywalkSignPoolA compactSkywalkSignPoolB
    Arithmetic.compactSkywalkSignPoolB
  rw [h]
  exact ⟨rfl,rfl⟩

theorem compactSkywalkStage_eq (w : Nat → Wire) (r : SkywalkRails.State) (i : Nat)
    (h : narrowSkywalkRouteWidth i=Arithmetic.narrowSkywalkRouteWidth i) (s : BasisState) :
    CompactSkywalkStage w r i s ↔ Arithmetic.CompactSkywalkStage w r i s := by
  have e := signPool_eq w i h
  unfold CompactSkywalkStage Arithmetic.CompactSkywalkStage compactSkywalkStageVirtual
    Arithmetic.compactSkywalkStageVirtual
  rw [e.1,e.2]

theorem compressedCompactStage_eq (w : Nat → Wire) (x p i : Nat)
    (h : narrowSkywalkRouteWidth i=Arithmetic.narrowSkywalkRouteWidth i) (bits : BasisState) :
    CompressedCompactStage w x p i bits ↔ Arithmetic.CompressedCompactStage w x p i bits := by
  unfold CompressedCompactStage Arithmetic.CompressedCompactStage
  simp only [compactSkywalkStage_eq w _ i h]

theorem compactSkywalkStage_one (w : Nat → Wire) (r : SkywalkRails.State) (s : BasisState) :
    CompactSkywalkStage w r 1 s ↔ Arithmetic.CompactSkywalkStage w r 1 s :=
  compactSkywalkStage_eq w r 1 narrowSkywalkRouteWidth_endpoints.2.1 s

theorem compressedCompactStage_512 (w : Nat → Wire) (x p : Nat) (bits : BasisState) :
    CompressedCompactStage w x p 512 bits ↔ Arithmetic.CompressedCompactStage w x p 512 bits :=
  compressedCompactStage_eq w x p 512 narrowSkywalkRouteWidth_endpoints.2.2.1 bits

/-- The narrowed compressed forward pass ends in exactly the original terminal
State, for the original seed domain and arbitrary independent record lists. -/
theorem compressedCompactForward_old_eq (w : Nat → Wire)
    (hn : (skywalkSharedWires w).Nodup) (hlo : CompressedHistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (s : State) (mNew mOld : List Bool)
    (hin : SkywalkIntegerStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 0 s.basis) :
    run (compressedCompactForward w 0 512) mNew s=
      run (Arithmetic.compressedCompactForward w 0 512) mOld s := by
  have pool := skywalkShared_integer_nodup w hn
  have old := Arithmetic.compressedCompactForward_caller_eq w hn hlo x p hp0 hx0 hpo hp hx hc
    s mOld [] hin
  rw [old]
  have compressed := compressedCompactForward_512_spec w pool hlo x p hp0 hx0 hpo hp hq hx hc s mNew hin
  have compact := Arithmetic.compactSkywalkForward_512 w pool x p hp0 hx0 hpo hp hx hc s [] hin
  generalize eCompressed : run (compressedCompactForward w 0 512) mNew s=compressedState at compressed ⊢
  generalize eCompact : run (Arithmetic.compactSkywalkForward w 0 512) [] s=compactState at compact ⊢
  obtain ⟨ghost,ghostStage,_,ghostPhase,encoded⟩ :=
    compressed_terminal_encoded_state w pool hlo x p hp0 hpo compressedState
      ((compressedCompactStage_512 w x p _).mp compressed.2)
  have ghostTerminal := (Arithmetic.compactSkywalkStage_terminal w pool x p hp0 hx0 hpo hp hx hc
    ghost.basis ghostStage).2
  have compactTerminal := (Arithmetic.compactSkywalkStage_terminal w pool x p hp0 hx0 hpo hp hx hc
    compactState.basis compact.2).2
  have phase : ghost.phase=compactState.phase :=
    ghostPhase.trans (compressed.1.trans compact.1.symm)
  have bits : ∀q∈(skywalkPoolWires w).toFinset,ghost.basis q=compactState.basis q := by
    intro q hq
    exact skywalkIntegerStage_agrees w (SkywalkRails.encode false false (x:Int) (p:Int))
      512 (by decide) ghost.basis compactState.basis ghostTerminal compactTerminal q
      (List.mem_toFinset.mp hq)
  have support := Arithmetic.allGroupEncode_pool_support w pool hlo
  have agreement := pool_run_agrees (allGroupEncode w 170) (skywalkPoolWires w).toFinset
    support [] ghost compactState phase bits
  generalize eEncoded : run (allGroupEncode w 170) [] compactState=encodedState at agreement ⊢
  apply State.extensionality compressedState encodedState
  · rw [encoded]
    exact agreement.1
  · funext q
    by_cases hq : q∈skywalkPoolWires w
    · rw [encoded]
      exact agreement.2 q (List.mem_toFinset.mpr hq)
    · have forwardFrame := compressedCompactForward_frame w pool hlo 0 512 (by decide) s mNew q hq
      have compactFrame := Arithmetic.compactSkywalkForward_frame w pool 0 512 (by decide) s [] q hq
      have encoderFrame := run_preserves_outside (allGroupEncode w 170) [] compactState q
        (fun h => hq (List.mem_toFinset.mp (support h)))
      rw [eCompressed] at forwardFrame
      rw [eCompact] at compactFrame
      rw [eEncoded] at encoderFrame
      exact forwardFrame.trans (encoderFrame.trans compactFrame).symm

end ECDSAAdd.Entrant.W
end WEndpoints

section WNativeFirstDirectCallerForward
/-! Copy of `Arithmetic/NativeFirstDirectCallerForward` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 4096
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.W.NativeFirstDirect
open ECDSAAdd.Arithmetic ECDSAAdd.Arithmetic.NativeFirstDirect
attribute [local irreducible] run forward reference literalSkywalkSeed compactSkywalkTick
  compressedCompactForward compressedPackAfter

private theorem first_tick_count (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    measurementCount (compactSkywalkTick w 0)=257 := by
  have h := (compactSkywalkTick_counts w 0 (by omega) hn).2
  have e : compactSkywalkTickPostWidth 0=258 := narrowSkywalkWidth_zero
  rw [e] at h
  exact h

private theorem first_forward_join (w : Nat → Wire) :
    compressedCompactForward w 0 512=
      compactSkywalkTick w 0++compressedCompactForward w 1 511 := by
  have zero : compressedPackAfter w 0=[] := by
    rw [compressedPackAfter,show compressedPackDue 0=false from rfl]
    rfl
  rw [compressedCompactForward,zero,List.append_nil]

/-- A first native tick takes only the fixed false prefix; the following
records remain an arbitrary independent stream, including an empty stream. -/
private theorem old_forward_eval (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (s : State) (tail : List Bool) :
    run (compressedCompactForward w 0 512) (List.replicate 257 false++tail) s=
      run (compressedCompactForward w 1 511) tail (run (compactSkywalkTick w 0) [] s) := by
  rw [first_forward_join,run_append,first_tick_count w hn]
  have take : (List.replicate 257 false++tail).take 257=List.replicate 257 false := by
    rw [List.take_append_of_le_length (by simp [List.length_replicate])]
    simpa only [List.length_replicate] using List.take_length (l := List.replicate 257 false)
  have drop : (List.replicate 257 false++tail).drop 257=tail := by
    have nil : (List.replicate 257 false).drop 257=[] := by
      simpa only [List.length_replicate] using List.drop_length (l := List.replicate 257 false)
    rw [List.drop_append,List.length_replicate,nil,Nat.sub_self,List.drop_zero,List.nil_append]
  rw [take,drop,run_replicate_false]

/-- Exact terminal State equality for the entire 512-step compressed forward
schedule. Prefix and tail measurements are independently arbitrary. -/
theorem forward_terminal_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x : Nat) (hx : x<p) (s : State) (first tail : List Bool)
    (hin : LiteralSkywalkSeedValues (literalSkywalkPoolSeed w) 0 x s.basis)
    (ext : s.basis (w 258)=false) :
    run (compressedCompactForward w 1 511) tail (run (forward w) first s)=
      run (compressedCompactForward w 0 512) (List.replicate 257 false++tail)
        (run (literalSkywalkSeed (literalSkywalkPoolSeed w) p) [] s) := by
  have hpfx := forward_reference_eq w hn x hx s first [] hin ext
  have ref : run (reference w) [] s=
      run (compactSkywalkTick w 0) []
        (run (literalSkywalkSeed (literalSkywalkPoolSeed w) p) [] s) := by
    rw [reference,run_append,compactSkywalkTick_zero_eq]
    simp only [List.take_nil,List.drop_nil]
  have firstEq := hpfx.trans ref
  exact (congrArg (fun u : State => run (compressedCompactForward w 1 511) tail u) firstEq).trans
    (old_forward_eval w hn _ tail).symm

/-- Concrete old hs1/hs2 witnesses needed by compressedPreparation_facts.
No relationship between first and tail outcome values is required. -/
theorem forward_terminal_states (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x : Nat) (hx : x<p) (s s1 s2 : State) (first tail : List Bool)
    (hin : LiteralSkywalkSeedValues (literalSkywalkPoolSeed w) 0 x s.basis)
    (ext : s.basis (w 258)=false)
    (h1 : run (forward w) first s=s1)
    (h2 : run (compressedCompactForward w 1 511) tail s1=s2) :
    ∃ oldSeed : State,
      run (literalSkywalkSeed (literalSkywalkPoolSeed w) p) [] s=oldSeed ∧
      run (compressedCompactForward w 0 512) (List.replicate 257 false++tail) oldSeed=s2 := by
  refine ⟨run (literalSkywalkSeed (literalSkywalkPoolSeed w) p) [] s,rfl,?_⟩
  have forward := forward_terminal_eq w hn x hx s first tail hin ext
  rw [h1,h2] at forward
  exact forward.symm

end ECDSAAdd.Entrant.W.NativeFirstDirect
end WNativeFirstDirectCallerForward

section WNativeFirstDirectTailRestore
/-! Copy of `Arithmetic/NativeFirstDirectTailRestore` over the tighter width schedule of `WWidths`. -/

set_option maxRecDepth 4096
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.W.NativeFirstDirect
open ECDSAAdd.Arithmetic
attribute [local irreducible] run compactSkywalkForward compactSkywalkReverse
  compressedCompactReverse compressedDecodeRange compressedDecodePrefix

/-- The unchanged 511-tick reverse restores the exact first-tick pool.
Field data outside that pool may already have changed. -/
private theorem raw_tail_restore (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x prime : Nat) (hp0 : 0<prime) (hx0 : 0<x) (hpo : prime%2=1)
    (hp : prime<2^256) (hq : prime+2^32 ≤ 2^256) (hx : x<prime) (hc : x.Coprime prime)
    (initial s : State) (m : List Bool)
    (hinit : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (prime:Int)) 1 initial.basis)
    (hfinal : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (prime:Int)) 512 s.basis) :
    (run (compactSkywalkReverse w 1 511) m s).phase=s.phase ∧
    ∀q∈skywalkPoolWires w,(run (compactSkywalkReverse w 1 511) m s).basis q=initial.basis q := by
  let start : State := ⟨s.phase,initial.basis⟩
  have f := compactSkywalkForward_spec w hn x prime 1 511 hp0 hx0 hpo hp hq hx hc
    (by omega) start [] hinit
  have own := (compactSkywalkStage_terminal w hn x prime hp0 hx0 hpo hp hx hc s.basis hfinal).2
  have reference := (compactSkywalkStage_terminal w hn x prime hp0 hx0 hpo hp hx hc _ f.2).2
  have inverse := compactSkywalkReverse_roundtrip w hn x prime 1 511 hp0 hx0 hpo hp hq hx hc
    (by omega) start [] m hinit
  have bits : ∀q∈(skywalkPoolWires w).toFinset,
      s.basis q=(run (compactSkywalkForward w 1 511) [] start).basis q := by
    intro q hq
    exact skywalkIntegerStage_agrees w _ 512 (by omega) _ _ own reference q (List.mem_toFinset.mp hq)
  have agrees := pool_run_agrees (compactSkywalkReverse w 1 511) (skywalkPoolWires w).toFinset
    (compactSkywalkReverse_support w hn 1 511 (by omega)) m s
    (run (compactSkywalkForward w 1 511) [] start) f.1.symm bits
  rw [inverse] at agrees
  refine ⟨agrees.1,?_⟩
  intro q hq
  exact agrees.2 q (List.mem_toFinset.mpr hq)

private theorem decode_zero_step (w : Nat → Wire) (n : Nat) :
    compressedDecodeRange w 0 (n+1)=compressedDecodeRange w 1 n ++ compressedDecodeBefore w 0 := by
  rw [compressedDecodeRange]

private theorem tail_decoder (w : Nat → Wire) :
    compressedDecodeRange w 1 511=compressedDecodePrefix w 512 := by
  have h := compressedDecodeRange_zero w 512
  have zero : compressedDecodeBefore w 0=[] := rfl
  rw [decode_zero_step w 511,zero,List.append_nil] at h
  exact h

theorem tail_restore_pool (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : CompressedHistoryAbove w) (x prime : Nat)
    (hp0 : 0<prime) (hx0 : 0<x) (hpo : prime%2=1)
    (hp : prime<2^256) (hq : prime+2^32 ≤ 2^256) (hx : x<prime) (hc : x.Coprime prime)
    (initial s : State) (m : List Bool)
    (hinit : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (prime:Int)) 1 initial.basis)
    (hfinal : CompressedCompactStage w x prime 512 s.basis) :
    (run (compressedCompactReverse w 1 511) m s).phase=s.phase ∧
    (∀q∈skywalkPoolWires w,(run (compressedCompactReverse w 1 511) m s).basis q=initial.basis q) ∧
    (∀q,q∉skywalkPoolWires w → (run (compressedCompactReverse w 1 511) m s).basis q=s.basis q) := by
  have decoded := compressedCompactStage_decoded w hn hlo x prime 512 hp0 hpo (by omega) s hfinal
  have restored := raw_tail_restore w hn x prime hp0 hx0 hpo hp hq hx hc
    initial (run (compressedDecodePrefix w 512) [] s) m hinit decoded.2
  have actual : run (compressedCompactReverse w 1 511) m s=
      run (compactSkywalkReverse w 1 511) m (run (compressedDecodePrefix w 512) [] s) := by
    rw [compressedCompactReverse_normalize w hn hlo 1 511 (by omega),tail_decoder,
      run_append,compressedDecodePrefix_measurements,List.take_zero,List.drop_zero]
  refine ⟨?_,?_,?_⟩
  · rw [actual]; exact restored.1.trans decoded.1
  · rw [actual]; exact restored.2
  · intro q hq
    exact compressedCompactReverse_frame w hn hlo 1 511 (by omega) s m q hq

end ECDSAAdd.Entrant.W.NativeFirstDirect
end WNativeFirstDirectTailRestore


section
-- ===== WIntegerRes =====
/-! Counts, physicality and gate-slot bounds of the narrowed integer passes
(the integer-pass parts of `WKernel` and `WKernelRes`). -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.W
open ECDSAAdd.Arithmetic MappedCompressed

section Counts
attribute [local irreducible] compressedHistoryEncode compressedHistoryDecode
attribute [local irreducible] compactSkywalkForward compressedCompactForward compressedCompactReverse
attribute [local irreducible] toffoliCount measurementCount

/-- The delayed codec still emits all 170 packets after tick zero; the ticks
are 510 Toffolis and 255 records cheaper per pass. -/
theorem integer_tail_counts :
    toffoliCount (compressedCompactForward base 1 511)=197056 ∧
    measurementCount (compressedCompactForward base 1 511)=98315 ∧
    toffoliCount (compressedCompactReverse base 1 511)=197226 ∧
    measurementCount (compressedCompactReverse base 1 511)=98145 := by
  have f := compressedCompactForward_counts base base_pool_nodup 1 511 (by omega)
  have r := compressedCompactReverse_counts base base_pool_nodup 1 511 (by omega)
  have t : compactSkywalkForwardT 1 511=196546 := by decide +kernel
  have m : compactSkywalkForwardM 1 511=98145 := by decide +kernel
  have packs : compressedPackCount 1 511=170 := by decide
  simpa only [t,m,packs,Nat.reduceAdd,Nat.reduceMul] using
    And.intro f.1 (And.intro f.2 r)

end Counts

section Physical

theorem compactTicks_physical (w : Nat → Wire) (i : Nat) (hi : i<512)
    (hn : (skywalkPoolWires w).Nodup) :
    GatePhysical (compactSkywalkTick w i) ∧ GatePhysical (compactSkywalkReverseTick w i) := by
  have bounds := compactSkywalkTick_width_bounds i hi
  have n := narrowTicks_physical (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)
    (compactSkywalkTick_valid w i hi hn) (by omega)
    (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; omega)
  have val := compactSkywalkTick_release_valid w i hi hn
  have a := compactSigns_physical (compactSkywalkTickARelease w i) val.1
  have b := compactSigns_physical (compactSkywalkTickBRelease w i) val.2
  simp only [compactSkywalkTick,compactSkywalkTickCleanup,compactSkywalkReverseTick,
    compactSkywalkReverseExpand,gatePhysical_append]
  exact ⟨⟨n.1,a.1,b.1⟩,⟨⟨b.2,a.2⟩,n.2⟩⟩

end Physical

section Slots
open Challenge Baselines
attribute [local irreducible] renameProgram compressedCompactForward compressedCompactReverse

theorem compactTick_gateSlots_le (w : Nat → Wire) (i : Nat) (hi : i < 512) :
    gateSlots (compactSkywalkTick w i) ≤ 6000 ∧
    gateSlots (compactSkywalkReverseTick w i) ≤ 6000 := by
  have h := narrowTick_gateSlots_le (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)
  have hb := compactSkywalkTick_width_bounds i hi
  rw [compactSkywalkTick_ah w i hi, compactSkywalkTick_half w i hi,
    compactSkywalkTick_b w i hi, wireBlock_length, wireBlock_length, wireBlock_length] at h
  have hc : gateSlots (compactSkywalkTickCleanup w i) ≤ 516 := by
    simp only [compactSkywalkTickCleanup,compactSkywalkTickARelease,compactSkywalkTickBRelease,
      compactSkywalkSignRelease,compactSkywalkSignWord,gateSlots_append,signComplement_gateSlots,
      List.length_drop,compactSkywalkTick_half w i hi,compactSkywalkTick_b w i hi,wireBlock_length]
    omega
  have he : gateSlots (compactSkywalkReverseExpand w i) = gateSlots (compactSkywalkTickCleanup w i) := by
    simp only [compactSkywalkReverseExpand,compactSkywalkTickCleanup,compactSkywalkSignExpand,
      compactSkywalkSignRelease,gateSlots_append,signComplement_gateSlots]; omega
  simp only [compactSkywalkTick,compactSkywalkReverseTick,gateSlots_append]
  omega

theorem compactLoops_gateSlots_le (w : Nat → Wire) (i n : Nat) (hn : i+n ≤ 512) :
    gateSlots (compressedCompactForward w i n) ≤ n*6200 ∧
    gateSlots (compressedCompactReverse w i n) ≤ n*6200 := by
  induction n generalizing i with
  | zero => simp only [compressedCompactForward,compressedCompactReverse,
      gateSlots_nil,Nat.zero_mul,Nat.le_refl,and_self]
  | succ n ih =>
    have h := compactTick_gateSlots_le w i (by omega)
    have hc := scheduledCodec_gateSlots_le w i
    have ht := ih (i+1) (by omega)
    simp only [compressedCompactForward,compressedCompactReverse,gateSlots_append,
      Nat.succ_mul]
    omega

end Slots

end ECDSAAdd.Entrant.W

end


section
-- ===== W5History =====

/-! Copy of the tick-dependent parts of `CompactHistory5` over the tighter width
schedule of `WWidths`.  The five-trit codec itself (`History5.encode`/`decode`,
their positions `historyId` and their supports) is tick-independent and reused:
the narrowed ticks touch a subset of the old tick sites, so every history-label
disjointness argument is unchanged. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.W
open Arithmetic Secp256k1 History5

theorem compactTick_middle_unused (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i : Nat) (hi : i < 512)
    (j : Nat) (hlo : 515 ≤ j) (hhi : j < 770) :
    w j∉(compactSkywalkTickLayout w i).wires := by
  have width := compactSkywalkTick_width_bounds i hi
  apply compactSkywalkStage_tick_away w i hi hn j (by omega)
  · unfold skywalkPoolPreviousId
    split_ifs <;> omega
  all_goals omega

theorem compactTick_support5 (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i : Nat) (hi : i < 512) :
    wires (compactSkywalkTick w i)⊆History5.integerSites5 w ∧
    wires (compactSkywalkReverseTick w i)⊆History5.integerSites5 w := by
  have lift (q : Wire) (hq : q∈(compactSkywalkTickLayout w i).wires) :
      q∈History5.integerSites5 w := by
    have pool := compactSkywalkTick_local_support w i hi hq
    simp only [skywalkPoolWires,wireBlock,List.mem_map,List.mem_range'_1] at pool
    obtain ⟨j,hj,rfl⟩ := pool
    apply (History5.integerSites5_mem w (w j)).mpr
    refine ⟨j,by omega,?_,rfl⟩
    by_cases small : j < 515
    · exact Or.inl small
    · exact Or.inr (by
        by_contra bad
        exact compactTick_middle_unused w hn i hi j (by omega) (by omega) hq)
  exact ⟨fun q hq => lift q (List.mem_toFinset.mp (compactSkywalkTick_support w i hi hn hq)),
    fun q hq => lift q (List.mem_toFinset.mp (compactSkywalkReverseTick_support w i hi hn hq))⟩

/-- A five-letter group is not used after the tick that consumes its last G. -/
theorem historyId_away_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (start i : Nat)
    (hs : start+5 ≤ 512) (hlate : start+6 ≤ i) (hi : i < 512) (j : Fin 10) :
    w (History5.historyId start j)∉(compactSkywalkTickLayout w i).wires := by
  have width := compactSkywalkTick_width_bounds i hi
  have hpos : i ≠ 0 := by omega
  apply compactSkywalkStage_tick_away w i hi hn (History5.historyId start j)
    (History5.historyId_bound start hs j)
  all_goals
    have hj := j.isLt
    unfold History5.historyId
    split_ifs <;> (try simp only [skywalkPoolPreviousId,if_neg hpos]) <;> omega

theorem history_disjoint_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (_hlo : History5.HistoryAbove w)
    (start i : Nat) (hs : start+5 ≤ 512) (hlate : start+6 ≤ i) (hi : i < 512) :
    Disjoint (wires (History5.encode w start)) (wires (compactSkywalkTick w i)) := by
  apply Finset.disjoint_left.mpr
  intro q hq ht
  obtain ⟨j,rfl⟩ := History5.history_gate_mem w start _ (Or.inl rfl) q hq
  exact historyId_away_compactTick w hn start i hs hlate hi j
    (List.mem_toFinset.mp (compactSkywalkTick_support w i hi hn ht))

theorem history_disjoint_compactReverseTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (_hlo : History5.HistoryAbove w)
    (start i : Nat) (hs : start+5 ≤ 512) (hlate : start+6 ≤ i) (hi : i < 512) :
    Disjoint (wires (History5.decode w start)) (wires (compactSkywalkReverseTick w i)) := by
  apply Finset.disjoint_left.mpr
  intro q hq ht
  obtain ⟨j,rfl⟩ := History5.history_gate_mem w start _ (Or.inr rfl) q hq
  exact historyId_away_compactTick w hn start i hs hlate hi j
    (List.mem_toFinset.mp (compactSkywalkReverseTick_support w i hi hn ht))

theorem prefix_disjoint_compactTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (n i : Nat) (hni : n ≤ i) (hi : i < 512) :
    Disjoint (wires (History5.encodePrefix w n)) (wires (compactSkywalkTick w i)) := by
  induction n with
  | zero => simp [History5.encodePrefix,wires]
  | succ n ih =>
    have prior := ih (by omega)
    have current : Disjoint (wires (History5.packAfter w n)) (wires (compactSkywalkTick w i)) := by
      cases due : History5.packDue n
      · simp [History5.packAfter,due,wires]
      · have bounds := History5.packDue_true n due
        have d := history_disjoint_compactTick w hn hlo (n-5) i (by omega) (by omega) hi
        simpa only [History5.packAfter,due,if_true] using d
    simp only [History5.encodePrefix,wires_append,Finset.disjoint_union_left]
    exact ⟨prior,current⟩

theorem prefix_disjoint_compactReverseTick (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (n i : Nat) (hni : n ≤ i) (hi : i < 512) :
    Disjoint (wires (History5.encodePrefix w n)) (wires (compactSkywalkReverseTick w i)) := by
  induction n with
  | zero => simp [History5.encodePrefix,wires]
  | succ n ih =>
    have prior := ih (by omega)
    have current : Disjoint (wires (History5.packAfter w n)) (wires (compactSkywalkReverseTick w i)) := by
      cases due : History5.packDue n
      · simp [History5.packAfter,due,wires]
      · have bounds := History5.packDue_true n due
        have d := history_disjoint_compactReverseTick w hn hlo (n-5) i (by omega) (by omega) hi
        have eq : wires (History5.encode w (n-5))=wires (History5.decode w (n-5)) := by
          simp only [History5.encode,History5.decode,(MeasuredCodec5.supportAt_exact _).1,(MeasuredCodec5.supportAt_exact _).2]
        simpa only [History5.packAfter,due,if_true,eq] using d
    simp only [History5.encodePrefix,wires_append,Finset.disjoint_union_left]
    exact ⟨prior,current⟩

end ECDSAAdd.Entrant.W

end

section
-- ===== W5Forward =====

/-! Copy of `CompactForward5` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.W
open Arithmetic Secp256k1 History5

def CompressedCompactStage5 (w : Nat → Wire) (x p i : Nat) (bits : BasisState) : Prop :=
  ∃ raw : State,
    CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i raw.basis ∧
    bits=(run (History5.encodePrefix w i) [] raw).basis

def compactForward5 (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => compactSkywalkTick w i++History5.packAfter w i++compactForward5 w (i+1) n

theorem compactStage_ternary5 (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i : Nat)
    (hp0 : 0 < p) (hpo : p%2=1) (hi : i ≤ 512) (s : BasisState)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    ∀j,j < i → (s (w j) && s (w (1028+j)))=false := by
  have fields := (compactSkywalkStage_fields_iff w _ i hi hn s).mp h
  have tape := fields.2.2.2.1
  intro j hj
  rw [(tape j hj).1,(tape j hj).2]
  exact skywalkRecordedSymbol_legal x p j hp0 hpo

theorem stage_group_legal (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (x p i start : Nat)
    (hp0 : 0 < p) (hpo : p%2=1) (hs : start+5 ≤ i) (hi : i ≤ 512) (s : BasisState)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s) :
    MeasuredCodec5.legalAt (historyMap w start) s := by
  apply (MeasuredCodec5.legalAt_iff _ _).mpr
  intro j
  have letter := compactStage_ternary5 w hn x p i hp0 hpo hi s h (start+j.val) (by omega)
  have even : historyId start ⟨2*j.val,by omega⟩=start+j.val := by
    change (if (2*j.val)%2=0 then start+(2*j.val)/2 else 1028+start+(2*j.val)/2)=start+j.val
    split_ifs <;> omega
  have odd : historyId start ⟨2*j.val+1,by omega⟩=1028+start+j.val := by
    change (if (2*j.val+1)%2=0 then start+(2*j.val+1)/2 else 1028+start+(2*j.val+1)/2)=
      1028+start+j.val
    split_ifs <;> omega
  simpa only [historyMap,even,odd,Nat.add_assoc] using letter

attribute [local irreducible] run History5.encodePrefix compactForward5 compactSkywalkTick
  History5.encode

theorem compactStage5_first (w : Nat → Wire) (x p : Nat) (s : State)
    (h : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    CompressedCompactStage5 w x p 1 s.basis := by
  refine ⟨s,h,?_⟩
  simp [History5.encodePrefix,History5.packAfter,History5.packDue,run]

/-- Packing is coherent and uses no records; all tick records stay aligned. -/
theorem compactStage5_step (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512) :
    Triple (CompressedCompactStage5 w x p i)
      (compactSkywalkTick w i++History5.packAfter w i) (CompressedCompactStage5 w x p (i+1)) := by
  intro s m hs
  obtain ⟨raw,hraw,hbits⟩ := hs
  let tick := compactSkywalkTick w i
  let mt := m.take (measurementCount tick)
  let me := m.drop (measurementCount tick)
  let actual := run tick mt s
  let next := run tick [] raw
  have step := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc hi
  have hnxt := step raw [] hraw
  have hmt := step raw mt hraw
  have hd := prefix_disjoint_compactTick w hn hlo i i (Nat.le_refl i) hi
  have read : ∀q∈wires tick,s.basis q=raw.basis q := by
    intro q hq
    rw [hbits]
    exact run_preserves_outside _ _ _ q (fun he => Finset.disjoint_left.mp hd he hq)
  have localStep := run_local_increment tick s raw mt read
  have phase : actual.phase=s.phase := by
    have hh := localStep.1
    rw [hmt.1] at hh
    have neutral : (actual.phase ^^ s.phase)=false := by
      simpa only [Bool.xor_self] using hh
    cases ha : actual.phase <;> cases hb : s.phase <;> simp_all
  have commute := run_disjoint_commute (History5.encodePrefix w i) tick hd [] [] raw
  have same := run_basis_records tick s (run (History5.encodePrefix w i) [] raw) mt [] hbits
  have bits : actual.basis=(run (History5.encodePrefix w i) [] next).basis :=
    same.trans (congrArg State.basis commute.symm)
  have packPhase : (run (History5.packAfter w i) me actual).phase=actual.phase := by
    cases due : History5.packDue i
    · simp only [History5.packAfter,due,Bool.false_eq_true,if_false,run]
    · have hd := History5.packDue_true i due
      have nextLegal := stage_group_legal w hn x p (i+1) (i-5) hp0 hpo (by omega) (by omega) next.basis hnxt.2
      have encLegal := History5.prefix_next_legal w hn i hi due next [] nextLegal
      have actualLegal : MeasuredCodec5.legalAt (History5.historyMap w (i-5)) actual.basis := by
        rw [bits]
        exact encLegal
      simpa only [History5.packAfter,due,if_true] using
        History5.encode_phase w hn (i-5) (by omega) actual me actualLegal
  have packBits := run_basis_records (History5.packAfter w i) actual
    (run (History5.encodePrefix w i) [] next) me [] bits
  have nextBits : (run (History5.packAfter w i) me actual).basis=
      (run (History5.encodePrefix w (i+1)) [] next).basis := by
    rw [History5.encodePrefix,run_append]
    simp only [List.take_nil,List.drop_nil]
    exact packBits
  rw [run_append]
  exact ⟨packPhase.trans phase,⟨next,hnxt.2,nextBits⟩⟩

theorem compactForward5_spec (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p i n : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i+n ≤ 512) :
    Triple (CompressedCompactStage5 w x p i) (compactForward5 w i n)
      (CompressedCompactStage5 w x p (i+n)) := by
  induction n generalizing i with
  | zero =>
    rw [compactForward5,Nat.add_zero]
    intro s m h
    simpa only [run] using And.intro (rfl : s.phase=s.phase) h
  | succ n ih =>
    have first := compactStage5_step w hn hlo x p i hp0 hx0 hpo hp hq hx hc (by omega)
    have tail := ih (i+1) (by omega)
    have index : i+(n+1)=(i+1)+n := by omega
    rw [compactForward5,index]
    simpa only [List.append_assoc] using first.seq tail

theorem compactForward5_counts (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    toffoliCount (compactForward5 w i n)=compactSkywalkForwardT i n+9*History5.packCount i n ∧
    measurementCount (compactForward5 w i n)=compactSkywalkForwardM i n+4*History5.packCount i n := by
  induction n generalizing i with
  | zero => simp [compactForward5,compactSkywalkForwardT,compactSkywalkForwardM,
      History5.packCount,toffoliCount,measurementCount]
  | succ n ih =>
    have tick := compactSkywalkTick_counts w i (by omega) hn
    have pack := History5.packAfter_counts w i
    have tail := ih (i+1) (by omega)
    simp only [compactForward5,toffoliCount_append,measurementCount_append,tick.1,tick.2,
      pack.1,pack.2.1,tail.1,tail.2,compactSkywalkForwardT,compactSkywalkForwardM,
      History5.packCount]
    constructor <;> omega

theorem compactForward5_support (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    wires (compactForward5 w i n)⊆History5.integerSites5 w := by
  induction n generalizing i with
  | zero => simp [compactForward5,wires]
  | succ n ih =>
    have tick := (compactTick_support5 w hn i (by omega)).1
    have pack := (History5.pack_support5 w i (by omega)).1
    simp only [compactForward5,wires_append,Finset.union_subset_iff]
    exact ⟨⟨tick,pack⟩,ih (i+1) (by omega)⟩

theorem compactForward5_frame (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512)
    (s : State) (m : List Bool) (q : Wire) (hq : q∉skywalkPoolWires w) :
    (run (compactForward5 w i n) m s).basis q=s.basis q := by
  apply run_preserves_outside
  intro h
  exact hq (List.mem_toFinset.mp (History5.integerSites5_pool w
    (compactForward5_support w hn i n hi h)))

/-- The direct emitted loop is the raw loop with its real history encoding. -/
theorem compactForward5_normalize (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (i n : Nat) (hi : i+n ≤ 512) (s : State) :
    run (compactForward5 w i n) [] (run (History5.encodePrefix w i) [] s)=
      run (History5.encodePrefix w (i+n)) [] (run (compactSkywalkForward w i n) [] s) := by
  induction n generalizing i s with
  | zero => simp only [compactForward5,compactSkywalkForward,Nat.add_zero,run]
  | succ n ih =>
    have dis := prefix_disjoint_compactTick w hn hlo i i (Nat.le_refl i) (by omega)
    have commute := run_disjoint_commute (History5.encodePrefix w i) (compactSkywalkTick w i) dis [] [] s
    have join (t : State) : run (History5.packAfter w i) [] (run (History5.encodePrefix w i) [] t)=
        run (History5.encodePrefix w (i+1)) [] t := by
      rw [History5.encodePrefix,run_append]
      simp only [List.take_nil,List.drop_nil]
    rw [compactForward5,compactSkywalkForward]
    simp only [run_append,List.take_nil,List.drop_nil]
    rw [←commute,join,ih (i+1) (by omega)]
    rw [show i+(n+1)=(i+1)+n by omega]

theorem compactForward5_first_normalize (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w) (s : State) (m : List Bool)
    (phase : (run (compactForward5 w 1 511) m s).phase=(run (compactSkywalkForward w 1 511) m s).phase) :
    run (compactForward5 w 1 511) m s=
      run (History5.allEncode w 102) [] (run (compactSkywalkForward w 1 511) m s) := by
  have h := compactForward5_normalize w hn hlo 1 511 (by omega) s
  have empty : History5.encodePrefix w 1=[] := by simp [History5.encodePrefix,History5.packAfter,History5.packDue]
  rw [empty,show (1:Nat)+511=512 from rfl,History5.encodePrefix_512] at h
  simp only [run] at h
  apply State.extensionality
  · exact phase.trans (History5.allEncode_zero_phase w hn 102 (by decide) _).symm
  · exact (run_basis_records (compactForward5 w 1 511) s s m [] rfl).trans
      ((congrArg State.basis h).trans (run_basis_records _ _ _ [] []
        (run_basis_records (compactSkywalkForward w 1 511) s s [] m rfl)))

end ECDSAAdd.Entrant.W

end

section
-- ===== W5Reverse =====

/-! Copy of `CompactReverse5` over the tighter width schedule of `WWidths`. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.W
open Arithmetic Secp256k1 History5

def compactReverse5 (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => compactReverse5 w (i+1) n++History5.decodeBefore w i++compactSkywalkReverseTick w i

attribute [local irreducible] run compactReverse5 compactSkywalkReverseTick compactSkywalkReverse
  History5.decodeRange History5.decodePrefix History5.encodePrefix

theorem compactReverse5_counts_relative (w : Nat → Wire) (i n : Nat) :
    toffoliCount (compactReverse5 w i n)=
      toffoliCount (compactSkywalkReverse w i n)+11*History5.packCount i n ∧
    measurementCount (compactReverse5 w i n)=measurementCount (compactSkywalkReverse w i n)+2*History5.packCount i n := by
  induction n generalizing i with
  | zero => simp [compactReverse5,compactSkywalkReverse,History5.packCount,toffoliCount,
      measurementCount]
  | succ n ih =>
    have pack := History5.packAfter_counts w i
    have tail := ih (i+1)
    simp only [compactReverse5,compactSkywalkReverse,History5.packCount,toffoliCount_append,
      measurementCount_append,pack.2.2.1,pack.2.2.2,tail.1,tail.2]
    constructor <;> omega

theorem decodeBefore_disjoint_compactReverse (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (i j n : Nat) (hgap : i < j) (hbound : j+n ≤ 512) :
    Disjoint (wires (History5.decodeBefore w i)) (wires (compactSkywalkReverse w j n)) := by
  induction n generalizing j with
  | zero => simp [compactSkywalkReverse,wires]
  | succ n ih =>
    have tail := ih (j+1) (by omega) (by omega)
    have head : Disjoint (wires (History5.decodeBefore w i))
        (wires (compactSkywalkReverseTick w j)) := by
      cases due : History5.packDue i
      · simp [History5.decodeBefore,due,wires]
      · have hd := History5.packDue_true i due
        have dis := history_disjoint_compactReverseTick w hn hlo (i-5) j
          (by omega) (by omega) (by omega)
        simpa only [History5.decodeBefore,due,if_true] using dis
    simp only [compactSkywalkReverse,wires_append,Finset.disjoint_union_right]
    exact ⟨tail,head⟩

/-- Zero-record decoders commute past later inverse ticks without a record map. -/
theorem compactReverse5_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (i n : Nat) (hi : i+n ≤ 512) :
    toffoliCount (compactReverse5 w i n)=compactSkywalkForwardT i n+11*History5.packCount i n ∧
    measurementCount (compactReverse5 w i n)=compactSkywalkForwardM i n+2*History5.packCount i n := by
  have relative := compactReverse5_counts_relative w i n
  have compact := compactSkywalkReverse_counts w hn i n hi
  rwa [compact.1,compact.2] at relative

theorem compactReverse5_support (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    wires (compactReverse5 w i n)⊆History5.integerSites5 w := by
  induction n generalizing i with
  | zero => simp [compactReverse5,wires]
  | succ n ih =>
    have tick := (compactTick_support5 w hn i (by omega)).2
    have pack := (History5.pack_support5 w i (by omega)).2
    simp only [compactReverse5,wires_append,Finset.union_subset_iff]
    exact ⟨⟨ih (i+1) (by omega),pack⟩,tick⟩

theorem compactReverse5_frame (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512)
    (s : State) (m : List Bool) (q : Wire) (hq : q∉skywalkPoolWires w) :
    (run (compactReverse5 w i n) m s).basis q=s.basis q := by
  apply run_preserves_outside
  intro h
  exact hq (List.mem_toFinset.mp (History5.integerSites5_pool w
    (compactReverse5_support w hn i n hi h)))

attribute [local irreducible] History5.allEncode History5.encode History5.decode

theorem compactStage5_witness (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hi : i≤512) (s : State) (hs : CompressedCompactStage5 w x p i s.basis) :
    ∃raw : State,CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i raw.basis ∧
      s=run (History5.encodePrefix w i) [] raw := by
  obtain ⟨raw,hraw,hbits⟩ := hs
  let t : State := ⟨s.phase,raw.basis⟩
  refine ⟨t,hraw,?_⟩
  apply State.extensionality
  · exact (History5.encodePrefix_zero_phase w hn i hi t).symm
  · exact hbits.trans (run_basis_records _ raw t [] [] rfl)

theorem compactStep5_roundtrip (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : History5.HistoryAbove w) (x p i : Nat) (hp0 : 0<p) (hx0 : 0<x) (hpo : p%2=1)
    (hp : p<2^256) (hq : p+2^32≤2^256) (hx : x<p) (cop : x.Coprime p) (hi : i<512)
    (s : State) (m1 m2 : List Bool) (hs : CompressedCompactStage5 w x p i s.basis) :
    run (History5.decodeBefore w i++compactSkywalkReverseTick w i) m2
      (run (compactSkywalkTick w i++History5.packAfter w i) m1 s)=s := by
  obtain ⟨raw,hraw,eq⟩ := compactStage5_witness w hn x p i (by omega) s hs
  rw [eq,run_append,run_append]
  let mf := m1.take (measurementCount (compactSkywalkTick w i))
  let me := m1.drop (measurementCount (compactSkywalkTick w i))
  let md := m2.take (measurementCount (History5.decodeBefore w i))
  let mr := m2.drop (measurementCount (History5.decodeBefore w i))
  let next := run (compactSkywalkTick w i) mf raw
  have nstage := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx cop hi raw mf hraw
  have disF := prefix_disjoint_compactTick w hn hlo i i (Nat.le_refl i) hi
  have disR := prefix_disjoint_compactReverseTick w hn hlo i i (Nat.le_refl i) hi
  have commute := run_disjoint_commute (History5.encodePrefix w i) (compactSkywalkTick w i) disF [] mf raw
  rw [←commute]
  have cancel : run (History5.decodeBefore w i) md
      (run (History5.packAfter w i) me (run (History5.encodePrefix w i) [] next))=
        run (History5.encodePrefix w i) [] next := by
    cases due : History5.packDue i
    · simp only [History5.decodeBefore,History5.packAfter,due,Bool.false_eq_true,if_false,run]
    · have hd := History5.packDue_true i due
      have rawLegal := stage_group_legal w hn x p (i+1) (i-5) hp0 hpo (by omega) (by omega) next.basis nstage.2
      have legal := History5.prefix_next_legal w hn i hi due next [] rawLegal
      simpa only [History5.decodeBefore,History5.packAfter,due,if_true,History5.decode,History5.encode] using
        MeasuredCodec5.roundtripAt _ (History5.historyMap_injective w hn (i-5) (by omega)) _ me md legal
  change run (compactSkywalkReverseTick w i) mr
    (run (History5.decodeBefore w i) md (run (History5.packAfter w i) me (run (History5.encodePrefix w i) [] next)))=_
  rw [cancel,←run_disjoint_commute (History5.encodePrefix w i) (compactSkywalkReverseTick w i) disR [] mr next]
  have loc := compactSkywalkStage_local_input w hn x p i hp0 hx0 hpo hp hq hx cop hi raw hraw
  rw [compactSkywalkReverseTick_roundtrip w i hi hn raw mf mr loc.2.2.2.2.1 loc.2.2.2.2.2]

theorem compactReverse5_roundtrip (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : History5.HistoryAbove w) (x p i n : Nat) (hp0 : 0<p) (hx0 : 0<x) (hpo : p%2=1)
    (hp : p<2^256) (hq : p+2^32≤2^256) (hx : x<p) (cop : x.Coprime p) (hb : i+n≤512)
    (s : State) (m1 m2 : List Bool) (hs : CompressedCompactStage5 w x p i s.basis) :
    run (compactReverse5 w i n) m2 (run (compactForward5 w i n) m1 s)=s := by
  induction n generalizing i s m1 m2 with
  | zero => simp only [compactReverse5,compactForward5,run]
  | succ n ih =>
    let head := compactSkywalkTick w i++History5.packAfter w i
    have fshape : compactForward5 w i (n+1)=head++compactForward5 w (i+1) n := rfl
    have rshape : compactReverse5 w i (n+1)=compactReverse5 w (i+1) n++
        (History5.decodeBefore w i++compactSkywalkReverseTick w i) := by
      simp only [compactReverse5,List.append_assoc]
    have stage := compactStage5_step w hn hlo x p i hp0 hx0 hpo hp hq hx cop (by omega)
      s (m1.take (measurementCount head)) hs
    rw [fshape,rshape,run_append head (compactForward5 w (i+1) n),
      run_append (compactReverse5 w (i+1) n)]
    rw [ih (i+1) (by omega) _ _ _ stage.2]
    exact compactStep5_roundtrip w hn hlo x p i hp0 hx0 hpo hp hq hx cop (by omega) s _ _ hs

theorem tail_restore_pool5 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : History5.HistoryAbove w) (x prime : Nat)
    (hp0 : 0 < prime) (hx0 : 0 < x) (hpo : prime%2=1)
    (hp : prime < 2^256) (hq : prime+2^32≤2^256) (hx : x < prime) (hc : x.Coprime prime)
    (initial s : State) (m : List Bool)
    (hinit : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (prime:Int)) 1 initial.basis)
    (hfinal : CompressedCompactStage5 w x prime 512 s.basis) :
    (run (compactReverse5 w 1 511) m s).phase=s.phase ∧
    (∀q∈skywalkPoolWires w,(run (compactReverse5 w 1 511) m s).basis q=initial.basis q) ∧
    (∀q,q∉skywalkPoolWires w → (run (compactReverse5 w 1 511) m s).basis q=s.basis q) := by
  let start : State := ⟨s.phase,initial.basis⟩
  have initStage := compactStage5_first w x prime start hinit
  have fs := compactForward5_spec w hn hlo x prime 1 511 hp0 hx0 hpo hp hq hx hc (by omega) start [] initStage
  have inv := compactReverse5_roundtrip w hn hlo x prime 1 511 hp0 hx0 hpo hp hq hx hc
    (by omega) start [] m initStage
  have rawRef := compactSkywalkForward_spec w hn x prime 1 511 hp0 hx0 hpo hp hq hx hc
    (by omega) start [] hinit
  obtain ⟨own,hown,ownBits⟩ := hfinal
  have ownTerminal := (Arithmetic.compactSkywalkStage_terminal w hn x prime hp0 hx0 hpo hp hx hc _
    ((compactSkywalkStage_eq w _ 512 narrowSkywalkRouteWidth_endpoints.2.2.1 _).mp hown)).2
  have refTerminal := (Arithmetic.compactSkywalkStage_terminal w hn x prime hp0 hx0 hpo hp hx hc _
    ((compactSkywalkStage_eq w _ 512 narrowSkywalkRouteWidth_endpoints.2.2.1 _).mp rawRef.2)).2
  have normal := compactForward5_first_normalize w hn hlo start [] (fs.1.trans rawRef.1.symm)
  have supp : wires (History5.allEncode w 102)⊆(skywalkPoolWires w).toFinset := by
    intro q hq
    obtain ⟨j,hj,mem⟩ := History5.allEncode_member w 102 q hq
    exact History5.integerSites5_pool w ((History5.history_support5 w (5*j) (by omega)).1 mem)
  have rawAgree : ∀q∈(skywalkPoolWires w).toFinset,
      own.basis q=(run (compactSkywalkForward w 1 511) [] start).basis q := by
    intro q hq
    exact skywalkIntegerStage_agrees w _ 512 (by omega) _ _ ownTerminal refTerminal q (List.mem_toFinset.mp hq)
  have encodedAgree := run_pool_basis_agreement (History5.allEncode w 102) _ supp own
    (run (compactSkywalkForward w 1 511) [] start) [] rawAgree
  have bits : ∀q∈(skywalkPoolWires w).toFinset,
      s.basis q=(run (compactForward5 w 1 511) [] start).basis q := by
    intro q hq
    rw [ownBits,History5.encodePrefix_512,normal]
    exact encodedAgree q hq
  have agrees := pool_run_agrees (compactReverse5 w 1 511) _
    ((compactReverse5_support w hn 1 511 (by omega)).trans (History5.integerSites5_pool w)) m s
    (run (compactForward5 w 1 511) [] start) fs.1.symm bits
  rw [inv] at agrees
  exact ⟨agrees.1,fun q hq => agrees.2 q (List.mem_toFinset.mpr hq),
    fun q hq => compactReverse5_frame w hn 1 511 (by omega) s m q hq⟩


theorem compactLoops5_gateSlots_le (w : Nat → Wire) (i n : Nat) (hi : i+n ≤ 512) :
    Challenge.gateSlots (compactForward5 w i n) ≤ n*6200 ∧
    Challenge.gateSlots (compactReverse5 w i n) ≤ n*6200 := by
  induction n generalizing i with
  | zero => simp [compactForward5,compactReverse5,Challenge.gateSlots]
  | succ n ih =>
    have tick := compactTick_gateSlots_le w i (by omega)
    have codec := History5.pack_gateSlots5 w i
    have tail := ih (i+1) (by omega)
    simp only [compactForward5,compactReverse5,Challenge.gateSlots_append,Nat.succ_mul]
    omega

end ECDSAAdd.Entrant.W

end

section
-- ===== W5OldEq =====

/-! The narrowed five-trit passes agree with the certified ones.  The narrowed
and the original width schedules coincide at stages 1 and 512, so the stage-1
input and the stage-512 invariant are literally the original ones; the forward
terminal State and the reverse result are therefore the original States, and
every block outside the integer passes is reused unchanged. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.W
open Arithmetic Secp256k1

theorem compressedCompactStage5_512 (w : Nat → Wire) (x p : Nat) (bits : BasisState) :
    CompressedCompactStage5 w x p 512 bits ↔ History5.CompressedCompactStage5 w x p 512 bits := by
  unfold CompressedCompactStage5 History5.CompressedCompactStage5
  simp only [compactSkywalkStage_eq w _ 512 narrowSkywalkRouteWidth_endpoints.2.2.1]

/-- The narrowed forward pass ends in exactly the original terminal State, for
arbitrary independent record lists. -/
theorem compactForward5_old_eq (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32≤2^256) (hx : x < p) (hc : x.Coprime p)
    (s : State) (mNew mOld : List Bool)
    (hs : Arithmetic.CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    run (compactForward5 w 1 511) mNew s=run (History5.compactForward5 w 1 511) mOld s := by
  have fw := compactSkywalkForward_spec w hn x p 1 511 hp0 hx0 hpo hp hq hx hc (by omega) s mNew
    ((compactSkywalkStage_one w _ s.basis).mpr hs)
  have fo := Arithmetic.compactSkywalkForward_spec w hn x p 1 511 hp0 hx0 hpo hp hx hc (by omega)
    s mOld hs
  have cw := compactForward5_spec w hn hlo x p 1 511 hp0 hx0 hpo hp hq hx hc (by omega) s mNew
    (compactStage5_first w x p s ((compactSkywalkStage_one w _ s.basis).mpr hs))
  have co := History5.compactForward5_spec w hn hlo x p 1 511 hp0 hx0 hpo hp hx hc (by omega)
    s mOld (History5.compactStage5_first w x p s hs)
  rw [compactForward5_first_normalize w hn hlo s mNew (cw.1.trans fw.1.symm),
    History5.compactForward5_first_normalize w hn hlo s mOld (co.1.trans fo.1.symm)]
  have tw := (Arithmetic.compactSkywalkStage_terminal w hn x p hp0 hx0 hpo hp hx hc _
    ((compactSkywalkStage_eq w _ 512 narrowSkywalkRouteWidth_endpoints.2.2.1 _).mp fw.2)).2
  have tO := (Arithmetic.compactSkywalkStage_terminal w hn x p hp0 hx0 hpo hp hx hc _ fo.2).2
  have e : run (compactSkywalkForward w 1 511) mNew s=
      run (Arithmetic.compactSkywalkForward w 1 511) mOld s := by
    apply State.extensionality
    · exact fw.1.trans fo.1.symm
    · funext q
      by_cases hq : q∈skywalkPoolWires w
      · exact skywalkIntegerStage_agrees w _ 512 (by omega) _ _ tw tO q hq
      · rw [compactSkywalkForward_frame w hn 1 511 (by omega) s mNew q hq,
          Arithmetic.compactSkywalkForward_frame w hn 1 511 (by omega) s mOld q hq]
  rw [e]

/-- From the certified terminal state, the narrowed reverse pass and the
certified reverse pass agree: both restore the stage-1 pool and keep every
other wire. -/
theorem compactReverse5_old_eq (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (n1 s2 s5 : State) (m6 : List Bool)
    (first : Arithmetic.CompactSkywalkStage w
      (SkywalkRails.encode false false (x:Int) (p:Int)) 1 n1.basis)
    (term : History5.CompressedCompactStage5 w x p 512 s2.basis)
    (hph : s5.phase=s2.phase)
    (hpool : ∀q∈skywalkPoolWires w,s5.basis q=s2.basis q) :
    run (compactReverse5 w 1 511) m6 s5=run (History5.compactReverse5 w 1 511) m6 s5 := by
  have wr := tail_restore_pool5 w hn hlo x p hp0 hx0 hpo hp hq hx hc n1 s2 m6
    ((compactSkywalkStage_one w _ n1.basis).mpr first)
    ((compressedCompactStage5_512 w x p _).mpr term)
  have orr := History5.tail_restore_pool5 w hn hlo x p hp0 hx0 hpo hp hx hc n1 s2 m6 first term
  have wa := pool_run_agrees (compactReverse5 w 1 511) (skywalkPoolWires w).toFinset
    ((compactReverse5_support w hn 1 511 (by omega)).trans (History5.integerSites5_pool w))
    m6 s5 s2 hph (fun q hq => hpool q (List.mem_toFinset.mp hq))
  have oa := pool_run_agrees (History5.compactReverse5 w 1 511) (skywalkPoolWires w).toFinset
    ((History5.compactReverse5_support w hn 1 511 (by omega)).trans (History5.integerSites5_pool w))
    m6 s5 s2 hph (fun q hq => hpool q (List.mem_toFinset.mp hq))
  apply State.extensionality
  · rw [wa.1,wr.1,oa.1,orr.1]
  · funext q
    by_cases hq : q∈skywalkPoolWires w
    · rw [wa.2 q (List.mem_toFinset.mpr hq),wr.2.1 q hq,oa.2 q (List.mem_toFinset.mpr hq),
        orr.2.1 q hq]
    · rw [compactReverse5_frame w hn 1 511 (by omega) s5 m6 q hq,
        History5.compactReverse5_frame w hn 1 511 (by omega) s5 m6 q hq]

/-- Each narrowed pass is 510 Toffolis and 255 records cheaper. -/
theorem compactSkywalkForward_old_counts :
    Arithmetic.compactSkywalkForwardT 1 511=compactSkywalkForwardT 1 511+572 ∧
    Arithmetic.compactSkywalkForwardM 1 511=compactSkywalkForwardM 1 511+286 := by
  constructor <;> decide +kernel

theorem compactPasses5_old_counts (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (compactForward5 w 1 511)+572=toffoliCount (History5.compactForward5 w 1 511) ∧
    measurementCount (compactForward5 w 1 511)+286=
      measurementCount (History5.compactForward5 w 1 511) ∧
    toffoliCount (compactReverse5 w 1 511)+572=toffoliCount (History5.compactReverse5 w 1 511) ∧
    measurementCount (compactReverse5 w 1 511)+286=
      measurementCount (History5.compactReverse5 w 1 511) := by
  have d := compactSkywalkForward_old_counts
  have f := compactForward5_counts w hn 1 511 (by omega)
  have r := compactReverse5_counts w hn 1 511 (by omega)
  have f' := History5.compactForward5_counts w hn 1 511 (by omega)
  have r' := History5.compactReverse5_counts w hn 1 511 (by omega)
  omega

end ECDSAAdd.Entrant.W

end


section
-- ===== ForwardSignRepair =====

set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.W
open Arithmetic

/-- Replace the final routed sign pair with an X measurement and correction. -/
def signRepair (a b g t : Wire) : Program :=
  [.CX a b, .measureX a [] [.CZ g b], .CX b a, .CX a b, .CX t b, .CX t a]

theorem signRepair_counts (a b g t : Wire) :
    toffoliCount (signRepair a b g t) = 0 ∧
    measurementCount (signRepair a b g t) = 1 := by
  simp [signRepair, toffoliCount, measurementCount]

/-- The two inputs encode at most one negative rail; the routed odd bit
provides the sign of the routed second rail. -/
theorem signRepair_eq (a b g c t : Wire)
    (hab : a ≠ b) (hag : a ≠ g) (hat : a ≠ t)
    (hbg : b ≠ g) (hbt : b ≠ t) (hct : c ≠ t)
    (hca : c ≠ a) (hcb : c ≠ b) (hgt : g ≠ t)
    (s : State) (m : List Bool) (neg : Bool)
    (ha : s.basis a = (s.basis g && neg))
    (hb : s.basis b = (!s.basis g && neg))
    (ht : s.basis t = if s.basis c then s.basis a else s.basis b) :
    run (signRepair a b g t) m s = run (swapRegisters c [a] [b]) [] s := by
  have hba := hab.symm
  have hga := hag.symm
  have hgb := hbg.symm
  have hta := hat.symm
  have htb := hbt.symm
  have htc := hct.symm
  have hac := hca.symm
  have hbc := hcb.symm
  have htg := hgt.symm
  apply State.extensionality
  · cases hg : s.basis g <;> cases hn : neg <;> cases hc : s.basis c <;>
      cases hm : m.headD false <;>
      simp_all [signRepair, swapRegisters, copyRegister, copyGate, run, measureAndCorrect,
        correct, writeBit]
  · funext q
    by_cases hqa : q = a
    · subst q
      cases hg : s.basis g <;> cases hn : neg <;> cases hc : s.basis c <;>
        cases hm : m.headD false <;>
        simp_all [signRepair, swapRegisters, copyRegister, copyGate, run, measureAndCorrect,
          correct, writeBit]
    · by_cases hqb : q = b
      · subst q
        cases hg : s.basis g <;> cases hn : neg <;> cases hc : s.basis c <;>
          cases hm : m.headD false <;>
          simp_all [signRepair, swapRegisters, copyRegister, copyGate, run, measureAndCorrect,
            correct, writeBit]
      · cases hm : m.headD false <;>
          simp_all [signRepair, swapRegisters, copyRegister, copyGate, run, measureAndCorrect,
            correct, writeBit]


/-- A register-wide controlled swap can be factored into the lower bank
and its independent final pair. -/
theorem swap_last_eq (c a b : Wire) (xs ys : List Wire)
    (hlen : xs.length = ys.length)
    (hnd : (c::a::b::(xs++ys)).Nodup) (s : State) :
    run (swapRegisters c (xs++[a]) (ys++[b])) [] s =
      run (swapRegisters c [a] [b]) [] (run (swapRegisters c xs ys) [] s) := by
  have hfull : (c::((xs++[a])++(ys++[b]))).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hnd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have hlow : (c::(xs++ys)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hnd q
    simp only [List.count_cons,List.count_append] at h ⊢
    omega
  have hpair : (c::([a]++[b])).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hnd q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have away (q : Wire) (hq : q = c ∨ q = a ∨ q = b) : q ∉ xs ∧ q ∉ ys := by
    constructor <;> intro hm
    all_goals
      have h := List.nodup_iff_count.mp hnd q
      have hp := List.count_pos_iff.mpr hm
      simp only [List.count_cons,List.count_append] at h
      rcases hq with rfl|rfl|rfl <;> simp only [beq_self_eq_true,if_true] at h <;> omega
  let t := run (swapRegisters c xs ys) [] s
  let u := run (swapRegisters c [a] [b]) [] t
  let v := run (swapRegisters c (xs++[a]) (ys++[b])) [] s
  have low := swapRegisters_correct c xs ys hlen hlow s []
  have pair := swapRegisters_correct c [a] [b] (by simp) hpair t []
  have full := swapRegisters_correct c (xs++[a]) (ys++[b]) (by simp [hlen]) hfull s []
  have tc : t.basis c = s.basis c := low.2.1 c (away c (by simp)).1 (away c (by simp)).2
  have ta : t.basis a = s.basis a := low.2.1 a (away a (by simp)).1 (away a (by simp)).2
  have tb : t.basis b = s.basis b := low.2.1 b (away b (by simp)).1 (away b (by simp)).2
  have lx : regValue xs t.basis = if s.basis c then regValue ys s.basis else regValue xs s.basis := low.2.2.1
  have ly : regValue ys t.basis = if s.basis c then regValue xs s.basis else regValue ys s.basis := low.2.2.2
  have ux : regValue xs u.basis = regValue xs t.basis := by
    apply regValue_congr
    intro q hq
    apply pair.2.1 q
    · intro he
      have e : q = a := by simpa using he
      exact (away a (by simp)).1 (e ▸ hq)
    · intro he
      have e : q = b := by simpa using he
      exact (away b (by simp)).1 (e ▸ hq)
  have uy : regValue ys u.basis = regValue ys t.basis := by
    apply regValue_congr
    intro q hq
    apply pair.2.1 q
    · intro he
      have e : q = a := by simpa using he
      exact (away a (by simp)).2 (e ▸ hq)
    · intro he
      have e : q = b := by simpa using he
      exact (away b (by simp)).2 (e ▸ hq)
  have ra : regValue [a] t.basis = regValue [a] s.basis := by
    apply regValue_congr
    intro q hq
    have e : q = a := by simpa using hq
    subst q
    exact ta
  have rb : regValue [b] t.basis = regValue [b] s.basis := by
    apply regValue_congr
    intro q hq
    have e : q = b := by simpa using hq
    subst q
    exact tb
  have ua : regValue [a] u.basis = if s.basis c then regValue [b] s.basis else regValue [a] s.basis := by
    have h : regValue [a] u.basis = if t.basis c then regValue [b] t.basis else regValue [a] t.basis := pair.2.2.1
    rw [tc,ra,rb] at h
    exact h
  have ub : regValue [b] u.basis = if s.basis c then regValue [a] s.basis else regValue [b] s.basis := by
    have h : regValue [b] u.basis = if t.basis c then regValue [a] t.basis else regValue [b] t.basis := pair.2.2.2
    rw [tc,ra,rb] at h
    exact h
  have vuA : regValue (xs++[a]) v.basis = regValue (xs++[a]) u.basis := by
    rw [full.2.2.1]
    simp only [regValue_append,ux,lx,ua]
    cases hc : s.basis c <;> simp [hc,regValue_append,hlen]
  have vuB : regValue (ys++[b]) v.basis = regValue (ys++[b]) u.basis := by
    rw [full.2.2.2]
    simp only [regValue_append,uy,ly,ub]
    cases hc : s.basis c <;> simp [hc,regValue_append,hlen]
  apply State.extensionality
  · exact full.1.trans (pair.1.trans low.1).symm
  · funext q
    by_cases hx : q ∈ xs++[a]
    · exact (regValue_eq_iff _ _ _).mp vuA q hx
    by_cases hy : q ∈ ys++[b]
    · exact (regValue_eq_iff _ _ _).mp vuB q hy
    have hxa : q∉xs := fun h => hx (List.mem_append_left _ h)
    have hya : q∉ys := fun h => hy (List.mem_append_left _ h)
    have hqa : q∉[a] := fun h => hx (List.mem_append_right _ h)
    have hqb : q∉[b] := fun h => hy (List.mem_append_right _ h)
    exact (full.2.1 q hx hy).trans ((pair.2.1 q hqa hqb).trans (low.2.1 q hxa hya)).symm


/-- The previous orientation locates the only possibly negative rail. -/
theorem encoded_signs (g z : Bool) (u v : Nat) :
    let r := SkywalkRails.encode g z (u:Int) (v:Int)
    let n := SkywalkRails.neg (SkywalkRails.signed z (u:Int))
    SkywalkRails.neg r.a = (g && n) ∧ SkywalkRails.neg r.b = (!g && n) := by
  have hp : SkywalkRails.neg ((u:Int)+(v:Int)) = false := by
    have h : 0 ≤ (u:Int)+(v:Int) := by positivity
    simp [SkywalkRails.neg,not_lt.mpr h]
  cases g <;> simp [SkywalkRails.encode,hp]

private theorem fwd_take_last (r : List Wire) (n : Nat) (hn : 0 < n) (hle : n ≤ r.length) :
    r.take (n-1)++[r.getD (n-1) 0]=r.take n := by
  have hidx : n-1<r.length := by omega
  have he : n=(n-1)+1 := by omega
  conv_rhs => rw [he]
  rw [List.getD_eq_getElem _ _ hidx,List.take_add_one,List.getElem?_eq_getElem hidx]
  rfl

/-- If a signed rail fits one fewer bit, its last two bits agree. -/
theorem fitted_sign (head sign : Wire) (mid : List Wire) (bits : BasisState) (A : Int)
    (hm : 0 < mid.length)
    (hval : signedRegValue ((head::mid)++[sign]) bits = A)
    (hmin : -((2^((head::mid).length-1):Nat):Int) ≤ A)
    (hmax : A < ((2^((head::mid).length-1):Nat):Int)) :
    bits sign = bits (mid.getD (mid.length-1) 0) := by
  have fit := narrow_signed_prefix (head::mid) [sign] bits A (by simp) hval hmin hmax
  have spl : mid.take (mid.length-1)++[mid.getD (mid.length-1) 0] = mid := by
    simpa using fwd_take_last mid mid.length hm (Nat.le_refl _)
  have eq : (head::mid.take (mid.length-1))++[mid.getD (mid.length-1) 0] = head::mid := by
    simp only [List.cons_append,spl]
  have sg := signedRegValue_sign (head::mid.take (mid.length-1))
    (mid.getD (mid.length-1) 0) bits
  rw [eq,fit.1] at sg
  exact (fit.2 sign (by simp)).trans sg.symm


/-- Read the last bit of the routed low bank. -/
theorem swapped_last (c : Wire) (xs ys : List Wire)
    (hlen : xs.length = ys.length) (hpos : 0 < xs.length)
    (hnd : (c::(xs++ys)).Nodup) (s : State) :
    (run (swapRegisters c xs ys) [] s).basis (ys.getD (ys.length-1) 0) =
      if s.basis c then s.basis (xs.getD (xs.length-1) 0)
      else s.basis (ys.getD (ys.length-1) 0) := by
  let t := run (swapRegisters c xs ys) [] s
  let j := xs.length-1
  have hi : j < xs.length := by dsimp [j]; omega
  have hj : j < ys.length := by omega
  have out := (swapRegisters_correct c xs ys hlen hnd s []).2.2.2
  have h1 := regValue_bit ys j 0 t.basis hj
  have h2 := regValue_bit xs j 0 s.basis hi
  have h3 := regValue_bit ys j 0 s.basis hj
  change regValue ys t.basis = _ at out
  rw [out] at h1
  dsimp only [j] at h1 h2 h3
  change t.basis (ys.getD (ys.length-1) 0) = _
  rw [← hlen]
  have inj (a b : Bool) : a.toNat = b.toNat → a = b := by
    cases a <;> cases b <;> simp [Bool.toNat]
  cases hc : s.basis c
  · simp only [hc,Bool.false_eq_true,if_false] at h1 ⊢
    exact inj _ _ (h1.trans h3.symm)
  · simp only [hc,if_true] at h1 ⊢
    exact inj _ _ (h1.trans h2.symm)


def repairedSwap (L : SkywalkIntegerLayout) : Program :=
  swapRegisters L.a0 L.aMid L.bMid ++
    signRepair L.aSign L.bSign L.previous (L.bMid.getD (L.bMid.length-1) 0)

def repairedRoute (L : SkywalkIntegerLayout) : Program :=
  repairedSwap L ++ [.CX L.a0 L.b0]

theorem repair_member_getD (r : List Wire) (i : Nat) (hi : i < r.length) : r.getD i 0 ∈ r := by
  induction r generalizing i with
  | nil => simp at hi
  | cons a r ih =>
    cases i with
    | zero => simp
    | succ i => simp only [List.getD_cons_succ]; exact List.mem_cons_of_mem _ (ih i (by simpa using hi))

/-- On a compact encoded rail, the routed lower sign supplies the final pair. -/
theorem repairedSwap_eq (L : SkywalkIntegerLayout) (hv : L.Valid)
    (hpos : 0 < L.aMid.length) (s : State) (m : List Bool) (neg : Bool)
    (ha : s.basis L.aSign = (s.basis L.previous && neg))
    (hb : s.basis L.bSign = (!s.basis L.previous && neg))
    (hf : (if s.basis L.a0 then s.basis (L.aMid.getD (L.aMid.length-1) 0)
      else s.basis (L.bMid.getD (L.bMid.length-1) 0)) =
      (if s.basis L.a0 then s.basis L.aSign else s.basis L.bSign)) :
    run (repairedSwap L) m s = run (swapRegisters L.a0 L.ah L.bh) [] s := by
  let t := L.bMid.getD (L.bMid.length-1) 0
  have ht : t ∈ L.bMid := repair_member_getD _ _ (by have h := hv.mids; omega)
  have hn : (L.previous::L.a0::L.aSign::L.bSign::(L.aMid++L.bMid)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hv.nodup q
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
      List.count_cons,List.count_append,List.count_nil] at h ⊢
    omega
  have h5 : [L.aSign,L.bSign,L.previous,L.a0,t].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
    by_cases eq : q = t
    · subst q
      have hp := List.count_pos_iff.mpr ht
      simp only [beq_self_eq_true,if_true] at h ⊢
      omega
    · simp only [beq_iff_eq] at h ⊢
      have hne : t ≠ q := Ne.symm eq
      simp only [hne,if_false]
      omega
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,not_or] at h5
  have ab : L.aSign ≠ L.bSign := by tauto
  have ag : L.aSign ≠ L.previous := by tauto
  have hat : L.aSign ≠ t := by tauto
  have bg : L.bSign ≠ L.previous := by tauto
  have bt : L.bSign ≠ t := by tauto
  have ct : L.a0 ≠ t := by tauto
  have ca : L.a0 ≠ L.aSign := by tauto
  have cb : L.a0 ≠ L.bSign := by tauto
  have gt : L.previous ≠ t := by tauto
  have hl : (L.a0::(L.aMid++L.bMid)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons,List.count_append] at h ⊢
    omega
  have hs : (L.a0::L.aSign::L.bSign::(L.aMid++L.bMid)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [List.count_cons,List.count_append] at h ⊢
    omega
  have away (q : Wire) (hq : q = L.a0 ∨ q = L.aSign ∨ q = L.bSign ∨ q = L.previous) :
      q ∉ L.aMid ∧ q ∉ L.bMid := by
    constructor <;> intro hm
    all_goals
      have h := List.nodup_iff_count.mp hn q
      have hp := List.count_pos_iff.mpr hm
      simp only [List.count_cons,List.count_append] at h
      rcases hq with rfl|rfl|rfl|rfl <;> simp only [beq_self_eq_true,if_true] at h <;> omega
  let v := run (swapRegisters L.a0 L.aMid L.bMid) [] s
  have low := swapRegisters_correct L.a0 L.aMid L.bMid hv.mids hl s []
  have keep (q : Wire) (hq : q = L.a0 ∨ q = L.aSign ∨ q = L.bSign ∨ q = L.previous) :
      v.basis q = s.basis q := by
    exact low.2.1 q (away q hq).1 (away q hq).2
  have bit := swapped_last L.a0 L.aMid L.bMid hv.mids hpos hl s
  have hbit : v.basis t = if v.basis L.a0 then v.basis L.aSign else v.basis L.bSign := by
    rw [keep L.a0 (by simp),keep L.aSign (by simp),keep L.bSign (by simp)]
    change (run (swapRegisters L.a0 L.aMid L.bMid) [] s).basis _ = _
    rw [bit]
    exact hf
  have pair := signRepair_eq L.aSign L.bSign L.previous L.a0 t ab ag hat bg bt ct ca cb gt v m neg
    (by rw [keep L.aSign (by simp),keep L.previous (by simp)]; exact ha)
    (by rw [keep L.bSign (by simp),keep L.previous (by simp)]; exact hb) hbit
  have split := swap_last_eq L.a0 L.aSign L.bSign L.aMid L.bMid hv.mids hs s
  have hm := (swapRegisters_resources L.a0 L.aMid L.bMid hv.mids hl).2.1
  rw [repairedSwap,run_append,hm,List.take_zero,List.drop_zero,pair]
  simpa only [SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh] using split.symm


theorem repair_mid_nodup (L : SkywalkIntegerLayout) (hv : L.Valid) :
    (L.a0::(L.aMid++L.bMid)).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have h := List.nodup_iff_count.mp hv.nodup q
  simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
    List.count_cons,List.count_append,List.count_nil] at h ⊢
  omega

theorem repairedRoute_counts (L : SkywalkIntegerLayout) (hv : L.Valid) :
    toffoliCount (repairedRoute L) = L.aMid.length ∧ measurementCount (repairedRoute L) = 1 := by
  have h := swapRegisters_resources L.a0 L.aMid L.bMid hv.mids (repair_mid_nodup L hv)
  have hrepair := signRepair_counts L.aSign L.bSign L.previous (L.bMid.getD (L.bMid.length-1) 0)
  simp only [repairedRoute,repairedSwap,toffoliCount_append,measurementCount_append,
    h.1,h.2.1,hrepair.1,hrepair.2,toffoliCount,measurementCount, Nat.add_zero, Nat.zero_add]
  exact ⟨trivial,trivial⟩

theorem repairedRoute_eq (L : SkywalkIntegerLayout) (hv : L.Valid)
    (hpos : 0 < L.aMid.length) (s : State) (m : List Bool) (neg : Bool)
    (ha : s.basis L.aSign = (s.basis L.previous && neg))
    (hb : s.basis L.bSign = (!s.basis L.previous && neg))
    (hf : (if s.basis L.a0 then s.basis (L.aMid.getD (L.aMid.length-1) 0)
      else s.basis (L.bMid.getD (L.bMid.length-1) 0)) =
      (if s.basis L.a0 then s.basis L.aSign else s.basis L.bSign)) :
    run (repairedRoute L) m s = run (skywalkRoute L.a0 L.b0 L.ah L.bh) [] s := by
  have low := swapRegisters_resources L.a0 L.aMid L.bMid hv.mids (repair_mid_nodup L hv)
  have orig := skywalkRoute_counts L.a0 L.b0 L.ah L.bh (L.high_lengths hv) (L.route_nodup hv)
  have full : measurementCount (swapRegisters L.a0 L.ah L.bh)=0 := by
    have nd : (L.a0::(L.ah++L.bh)).Nodup := by
      apply List.nodup_iff_count.mpr
      intro q
      have h := List.nodup_iff_count.mp (L.route_nodup hv) q
      simp only [List.count_cons] at h ⊢
      omega
    exact (swapRegisters_resources L.a0 L.ah L.bh (L.high_lengths hv) nd).2.1
  have mr : measurementCount (repairedSwap L) = 1 := by
    simp [repairedSwap,measurementCount_append,low.2.1,(signRepair_counts _ _ _ _).2]
  have eq := repairedSwap_eq L hv hpos s (m.take 1) neg ha hb hf
  rw [repairedRoute,skywalkRoute,run_append,run_append,mr,full,List.take_zero,List.drop_zero,eq]
  rfl

def repairedTick (w : Nat → Wire) (i : Nat) : Program :=
  if i=224 ∨ (256 ≤ i ∧ i ≤ 509) then
    let L := compactSkywalkTickLayout w i
    repairedRoute L ++ skywalkSignedHalf L.aSign L.ext ++
      narrowSignedRecord (narrowSkywalkRecordLayout L (compactSkywalkTickPostWidth i))
        (compactSkywalkTickPostWidth i) ++ [.CX L.previous L.a0] ++ compactSkywalkTickCleanup w i
  else compactSkywalkTick w i


/-- The compact trajectory supplies both the orientation encoding and the
one-bit sign extension required by the measured route. -/
theorem compact_late_preconditions (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i=224 ∨ (256 ≤ i ∧ i ≤ 509))
    (s : State)
    (hs : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    let L := compactSkywalkTickLayout w i
    0 < L.aMid.length ∧ ∃ neg : Bool,
      s.basis L.aSign = (s.basis L.previous && neg) ∧
      s.basis L.bSign = (!s.basis L.previous && neg) ∧
      (if s.basis L.a0 then s.basis (L.aMid.getD (L.aMid.length-1) 0)
       else s.basis (L.bMid.getD (L.bMid.length-1) 0)) =
      (if s.basis L.a0 then s.basis L.aSign else s.basis L.bSign) := by
  dsimp only
  let L := compactSkywalkTickLayout w i
  let ri := SkywalkTrace.next^[i] (SkywalkRails.encode false false (x:Int) (p:Int))
  let z := SkywalkNat.step^[i] (SkywalkNat.init x p)
  have input := compactSkywalkStage_local_input w hn x p i hp0 hx0 hpo hp hq hx hc (by omega) s hs
  change SkywalkIntegerInput L ri.a ri.b ri.g s.basis at input
  have hv := compactSkywalkTick_valid w i (by omega) hn
  have width := compactSkywalkTick_width_bounds i (by omega)
  have hpos : 0 < L.aMid.length := by
    change 0 < (wireBlock w (i+1) (compactSkywalkTickPreWidth i-2)).length
    rw [wireBlock_length]
    omega
  have hposB : 0 < L.bMid.length := by rw [←hv.mids]; exact hpos
  have lenA : (L.a0::L.aMid).length = compactSkywalkTickPostWidth i := by
    change (w i::wireBlock w (i+1) (compactSkywalkTickPreWidth i-2)).length = _
    rw [List.length_cons,wireBlock_length]
    unfold compactSkywalkTickPreWidth compactSkywalkTickPostWidth narrowSkywalkRouteWidth narrowSkywalkWidth
    omega
  have lenB : (L.b0::L.bMid).length = compactSkywalkTickPostWidth i := by
    simp only [List.length_cons] at lenA ⊢
    have h : L.aMid.length = L.bMid.length := hv.mids
    omega
  have sa : s.basis L.aSign = SkywalkRails.neg ri.a := by
    have v := signedRegValue_sign (L.a0::L.aMid) L.aSign s.basis
    change s.basis L.aSign = SkywalkRails.neg (signedRegValue L.a s.basis) at v
    rw [input.1] at v
    exact v
  have sb : s.basis L.bSign = SkywalkRails.neg ri.b := by
    have v := signedRegValue_sign (L.b0::L.bMid) L.bSign s.basis
    change s.basis L.bSign = SkywalkRails.neg (signedRegValue L.b s.basis) at v
    rw [input.2.1] at v
    exact v
  obtain ⟨G,S,henc⟩ := SkywalkTrace.iter_encoded i false false (SkywalkNat.init x p) hp0 hpo
  simp only [SkywalkNat.init] at henc
  change ri = SkywalkRails.encode G S (z.u:Int) (z.v:Int) at henc
  have enc := encoded_signs G S z.u z.v
  dsimp only at enc
  rw [←henc] at enc
  have prev : s.basis L.previous = G := by
    rw [input.2.2.1,henc]
    cases G <;> simp [SkywalkRails.encode]
  have firstSign : s.basis L.aSign = (s.basis L.previous && SkywalkRails.neg (SkywalkRails.signed S (z.u:Int))) := by
    rw [prev,sa]
    exact enc.1
  have secondSign : s.basis L.bSign = (!s.basis L.previous && SkywalkRails.neg (SkywalkRails.signed S (z.u:Int))) := by
    rw [prev,sb]
    exact enc.2
  have parity : s.basis L.a0 = SkywalkRails.odd ri.a := by
    have v := input.1
    change signedRegValue (L.a0::L.ah) s.basis = ri.a at v
    rw [signedRegValue_cons _ _ _ (by simp [SkywalkIntegerLayout.ah])] at v
    cases h : s.basis L.a0 with
    | false =>
      have e : ri.a%2=0 := by simp [h] at v; omega
      simp [SkywalkRails.odd,e,h]
    | true =>
      have e : ri.a%2≠0 := by simp [h] at v; omega
      simp [SkywalkRails.odd,e,h]
  have fit := narrowSkywalk_iter_fit x p i hp0 hx0 hpo hp hq hx hc (by omega)
  change (ri.a+ri.b)%2=1 ∧ _ at fit
  have lower := fit.2.2.2.1
  have upper := fit.2.2.2.2
  rw [SkywalkRails.route,←parity] at lower upper
  have selected : (if s.basis L.a0 then s.basis (L.aMid.getD (L.aMid.length-1) 0)
      else s.basis (L.bMid.getD (L.bMid.length-1) 0)) =
      (if s.basis L.a0 then s.basis L.aSign else s.basis L.bSign) := by
    cases h : s.basis L.a0 with
    | false =>
      simp only [h,Bool.false_eq_true,if_false] at lower upper ⊢
      have v : signedRegValue ((L.b0::L.bMid)++[L.bSign]) s.basis = ri.b := by
        exact input.2.1
      have ff := fitted_sign L.b0 L.bSign L.bMid s.basis ri.b hposB v
        (by simpa only [lenB] using lower) (by simpa only [lenB] using upper)
      exact ff.symm
    | true =>
      simp only [h,if_true] at lower upper ⊢
      have v : signedRegValue ((L.a0::L.aMid)++[L.aSign]) s.basis = ri.a := by
        exact input.1
      have ff := fitted_sign L.a0 L.aSign L.aMid s.basis ri.a hpos v
        (by simpa only [lenA] using lower) (by simpa only [lenA] using upper)
      exact ff.symm
  exact ⟨hpos,⟨SkywalkRails.neg (SkywalkRails.signed S (z.u:Int)),firstSign,secondSign,selected⟩⟩


/-- Exactly one extra record is consumed before the unchanged tick suffix. -/
theorem repairedTick_late_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i=224 ∨ (256 ≤ i ∧ i ≤ 509))
    (s : State) (m : List Bool)
    (hs : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    run (repairedTick w i) m s = run (compactSkywalkTick w i) (m.drop 1) s := by
  let L := compactSkywalkTickLayout w i
  have hv := compactSkywalkTick_valid w i (by omega) hn
  obtain ⟨hpos,neg,ha,hb,hf⟩ := compact_late_preconditions w hn x p i hp0 hx0 hpo hp hq hx hc hi s hs
  have em := (repairedRoute_counts L hv).2
  have om := (skywalkRoute_counts L.a0 L.b0 L.ah L.bh (L.high_lengths hv) (L.route_nodup hv)).2
  change measurementCount (repairedRoute (compactSkywalkTickLayout w i)) = 1 at em
  change measurementCount (skywalkRoute (compactSkywalkTickLayout w i).a0 (compactSkywalkTickLayout w i).b0
    (compactSkywalkTickLayout w i).ah (compactSkywalkTickLayout w i).bh) = 0 at om
  simp only [repairedTick,if_pos hi,compactSkywalkTick,narrowSkywalkTick,List.append_assoc]
  conv_lhs => rw [run_append]
  conv_rhs => rw [run_append]
  simp only [em,om,List.take_zero,List.drop_zero]
  rw [repairedRoute_eq L hv hpos s (m.take 1) neg ha hb hf]

/-- A compact tick has the reference output for any independent record stream. -/
theorem repairedTick_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2 = 1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512)
    (s : State) (m : List Bool)
    (hs : CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) i s.basis) :
    run (repairedTick w i) m s = run (compactSkywalkTick w i) [] s := by
  by_cases late : i=224 ∨ (256 ≤ i ∧ i ≤ 509)
  · rw [repairedTick_late_eq w hn x p i hp0 hx0 hpo hp hq hx hc late s m hs]
    have spec := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc hi
    have phase1 := (spec s (m.drop 1) hs).1
    have phase2 := (spec s [] hs).1
    apply State.extensionality
    · exact phase1.trans phase2.symm
    · exact run_basis_records _ s s _ _ rfl
  · simp only [repairedTick,if_neg late]
    have spec := compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc hi
    have phase1 := (spec s m hs).1
    have phase2 := (spec s [] hs).1
    apply State.extensionality
    · exact phase1.trans phase2.symm
    · exact run_basis_records _ s s _ _ rfl


/-- All replacement wires belong to the original local tick layout. -/
theorem repairedRoute_support (L : SkywalkIntegerLayout) (hv : L.Valid)
    (hpos : 0 < L.aMid.length) : wires (repairedRoute L) ⊆ L.wires.toFinset := by
  have tmem : L.bMid.getD (L.bMid.length-1) 0 ∈ L.bMid :=
    repair_member_getD _ _ (by have h := hv.mids; omega)
  have lo : wires (swapRegisters L.a0 L.aMid L.bMid) ⊆ L.wires.toFinset := by
    intro q hq
    have h := swapRegisters_wires L.a0 L.aMid L.bMid hv.mids hq
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
      List.mem_toFinset,List.mem_cons,List.mem_append] at h ⊢
    tauto
  have rep : wires (signRepair L.aSign L.bSign L.previous (L.bMid.getD (L.bMid.length-1) 0)) ⊆
      L.wires.toFinset := by
    intro q hq
    simp only [signRepair,wires,Instr.wires,correctionWires,Finset.mem_union,
      Finset.mem_insert,Finset.mem_singleton,Finset.notMem_empty,or_false] at hq
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
      List.mem_toFinset,List.mem_cons,List.mem_append,List.not_mem_nil,or_false]
    have tail : q = L.bMid.getD (L.bMid.length-1) 0 → q ∈ L.bMid := by
      intro e
      rw [e]
      exact tmem
    tauto
  have cx : wires [.CX L.a0 L.b0] ⊆ L.wires.toFinset := by
    intro q hq
    simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_insert,Finset.mem_singleton,
      Finset.notMem_empty,or_false] at hq
    simp only [SkywalkIntegerLayout.wires,List.mem_toFinset,List.mem_cons,List.mem_append]
    tauto
  simp only [repairedRoute,repairedSwap,wires_append,Finset.union_subset_iff]
  exact ⟨⟨lo,rep⟩,cx⟩

theorem repairedTick_support (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    wires (repairedTick w i) ⊆ (compactSkywalkTickLayout w i).wires.toFinset := by
  by_cases late : i=224 ∨ (256 ≤ i ∧ i ≤ 509)
  · let L := compactSkywalkTickLayout w i
    have hv := compactSkywalkTick_valid w i hi hn
    have width := compactSkywalkTick_width_bounds i hi
    have hpos : 0 < L.aMid.length := by
      change 0 < (wireBlock w (i+1) (compactSkywalkTickPreWidth i-2)).length
      rw [wireBlock_length]
      omega
    have tail := (narrowSkywalkTick_wires_subset L hv (compactSkywalkTickPostWidth i)
      (by omega) (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; omega)).1
    have cleanup := compactSkywalkTick_cleanup_support w i hi
    have route := repairedRoute_support L hv hpos
    simp only [narrowSkywalkTick,wires_append,Finset.union_subset_iff] at tail
    simp only [repairedTick,if_pos late,wires_append,Finset.union_subset_iff]
    tauto
  · simpa only [repairedTick,if_neg late] using compactSkywalkTick_support w i hi hn

end ECDSAAdd.Entrant.W
end

section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.W
open Arithmetic Secp256k1 MappedCompressed CompressedAllocation RecordedQuantum Challenge Baselines
def repairDue (i : Nat) : Nat := if i=224 ∨ (256 ≤ i ∧ i ≤ 509) then 1 else 0
def repairCount (i : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => repairDue i+repairCount (i+1) n
theorem repairedTick_counts (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (repairedTick w i) + repairDue i = toffoliCount (compactSkywalkTick w i) ∧
    measurementCount (repairedTick w i) = measurementCount (compactSkywalkTick w i) + repairDue i := by
  by_cases late : i=224 ∨ (256 ≤ i ∧ i ≤ 509)
  · let L := compactSkywalkTickLayout w i
    have hv := compactSkywalkTick_valid w i hi hn
    change L.Valid at hv
    have old := skywalkRoute_counts L.a0 L.b0 L.ah L.bh (L.high_lengths hv) (L.route_nodup hv)
    have fresh := repairedRoute_counts L hv
    dsimp only [L] at old fresh
    simp only [repairedTick,if_pos late,repairDue,if_pos late,compactSkywalkTick,narrowSkywalkTick,
      toffoliCount_append,measurementCount_append,fresh.1,fresh.2,old.1,old.2]
    simp only [SkywalkIntegerLayout.ah,List.length_append,List.length_singleton]
    constructor <;> omega
  · simp only [repairedTick,if_neg late,repairDue,if_neg late, Nat.add_zero, and_self]

theorem repairedTick_physical (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) : GatePhysical (repairedTick w i) := by
  by_cases late : i=224 ∨ (256 ≤ i ∧ i ≤ 509)
  · let L := compactSkywalkTickLayout w i
    let t := L.bMid.getD (L.bMid.length-1) 0
    have hv := compactSkywalkTick_valid w i hi hn
    change L.Valid at hv
    have width := compactSkywalkTick_width_bounds i hi
    have hpos : 0 < L.bMid.length := by
      change 0 < (wireBlock w 771 (compactSkywalkTickPreWidth i-2)).length
      rw [wireBlock_length]
      omega
    have tmem : t ∈ L.bMid := by
      apply repair_member_getD
      omega
    have ab : L.aSign ≠ L.bSign := by
      intro he
      have h := List.nodup_iff_count.mp hv.nodup L.aSign
      simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
        List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
      simp only [←he,beq_self_eq_true,if_true] at h
      omega
    have hat : L.aSign ≠ t := by
      intro he
      have pos := List.count_pos_iff.mpr (he.symm ▸ tmem)
      have h := List.nodup_iff_count.mp hv.nodup L.aSign
      simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
        List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
      omega
    have bt : L.bSign ≠ t := by
      intro he
      have pos := List.count_pos_iff.mpr (he.symm ▸ tmem)
      have h := List.nodup_iff_count.mp hv.nodup L.bSign
      simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,
        List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
      omega
    have rep : GatePhysical (signRepair L.aSign L.bSign L.previous t) := by
      simp [signRepair,GatePhysical,PhysicalInstr,ProperGate,ab,ab.symm,hat,hat.symm,bt,bt.symm]
    have low := swapRegisters_physical L.a0 L.aMid L.bMid (repair_mid_nodup L hv)
    have old := (compactTicks_physical w i hi hn).1
    simp only [compactSkywalkTick,narrowSkywalkTick,skywalkRoute,gatePhysical_append] at old
    simp only [repairedTick,if_pos late,repairedRoute,repairedSwap,gatePhysical_append]
    tauto
  · simpa only [repairedTick,if_neg late] using (compactTicks_physical w i hi hn).1

theorem repairedTick_slots (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) :
    gateSlots (repairedTick w i) ≤ gateSlots (compactSkywalkTick w i) + 4 := by
  by_cases late : i=224 ∨ (256 ≤ i ∧ i ≤ 509)
  · let L := compactSkywalkTickLayout w i
    have hv := compactSkywalkTick_valid w i hi hn
    change L.Valid at hv
    have rep : gateSlots (signRepair L.aSign L.bSign L.previous (L.bMid.getD (L.bMid.length-1) 0)) = 7 := rfl
    dsimp only [L] at rep
    simp only [repairedTick,if_pos late,compactSkywalkTick,narrowSkywalkTick,skywalkRoute,
      repairedRoute,repairedSwap,gateSlots_append,swapRegisters_gateSlots,rep]
    simp only [SkywalkIntegerLayout.ah,SkywalkIntegerLayout.bh,List.length_append,List.length_singleton,hv.mids,Nat.min_self]
    omega
  · simp only [repairedTick,if_neg late]
    omega


theorem repair_count_511 : repairCount 1 511=255 := by decide +kernel
end ECDSAAdd.Entrant.W
end
section
-- ===== BundleReverseCarry =====


set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000
set_option maxHeartbeats 10000000
namespace ECDSAAdd.Entrant.W.ReverseCarry
open ECDSAAdd ECDSAAdd.Arithmetic

def receiverAdd : List Wire → List Wire → List Wire → Wire → Program
  | a :: (x :: xs), b :: (y :: ys), c :: cs, cin =>
      if xs = [] ∧ ys = [] then
        eraseCarry a b cin y ++ [.CX x y, .CX a b, .CX cin b]
      else
        majority a b cin c ++ receiverAdd (x :: xs) (y :: ys) cs c ++
          eraseCarry a b cin c ++ [.CX a b, .CX cin b]
  | [a], [b], _, cin => [.CX a b, .CX cin b]
  | _, _, _, _ => []

def basis (v : List Bool) : BasisState := fun q => v.getD q false

def topOld : Program := majority 0 1 2 3 ++ [.CX 5 4, .CX 3 4] ++ eraseCarry 0 1 2 3

def topReceiver : Program := eraseCarry 0 1 2 4 ++ [.CX 5 4]

theorem topReceiver_finite : ∀ (a b c xs ph : Bool) (r : Option Bool),
  let s : State := ⟨ph, basis [a,b,c,false,carryBit a b c,xs]⟩
  (run topReceiver r.toList s).phase = ph ∧
  (run topOld r.toList s).phase = ph ∧
  ∀ q : Fin 6, (run topReceiver r.toList s).basis q = (run topOld r.toList s).basis q := by decide

theorem topReceiver_correct (a b c k y x : Wire) (s : State) (m : List Bool)
    (hnd : [a,b,c,k,y,x].Nodup) (hk : s.basis k = false)
    (hy : s.basis y = carryBit (s.basis a) (s.basis b) (s.basis c)) :
    run (eraseCarry a b c y ++ [.CX x y]) m s =
      run (majority a b c k ++ [.CX x y, .CX k y] ++ eraseCarry a b c k) m s := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hnd
  obtain ⟨⟨hab,hac,hak,hay,hax⟩,⟨hbc,hbk,hby,hbx⟩,
    ⟨hck,hcy,hcx⟩,⟨hky,hkx⟩,hyx⟩ := hnd
  have hba := Ne.symm hab
  have hca := Ne.symm hac
  have hka := Ne.symm hak
  have hya := Ne.symm hay
  have hxa := Ne.symm hax
  have hcb := Ne.symm hbc
  have hkb := Ne.symm hbk
  have hyb := Ne.symm hby
  have hxb := Ne.symm hbx
  have hkc := Ne.symm hck
  have hyc := Ne.symm hcy
  have hxc := Ne.symm hcx
  have hyk := Ne.symm hky
  have hxk := Ne.symm hkx
  have hxy := Ne.symm hyx
  cases hm : m.headD false <;>
    simp only [eraseCarry, majority, run_append, run_take, run, measurementCount, List.drop_zero,
      List.take_zero, measureAndCorrect, correct, writeBit, Function.update] <;>
    apply State.extensionality <;> simp_all [carryBit, Function.update, correct, measureAndCorrect, writeBit, run] <;>
    try (funext q; by_cases qa : q=a <;> by_cases qb : q=b <;>
      by_cases qc : q=c <;> by_cases qk : q=k <;> by_cases qy : q=y <;>
      by_cases qx : q=x <;> simp_all [carryBit, Function.update, correct, measureAndCorrect, writeBit, run]) <;>
    cases s.basis a <;> cases s.basis b <;> cases s.basis c <;>
    cases s.basis x <;> simp_all [carryBit, Function.update, correct, measureAndCorrect, writeBit, run]
  all_goals cases m <;> simp_all [List.take, measurementCount, correct, measureAndCorrect, Function.update]
  all_goals cases s.basis a <;> cases s.basis b <;> cases s.basis c <;> simp_all

theorem two_carry (a b c k y x : Wire) (s : State) (m : List Bool)
    (hnd : [a,b,c,k,y,x].Nodup) (hk : s.basis k = false)
    (hs : (run (addInPlace [a,x] [b,y] [k] c) m s).basis y = s.basis x) :
    s.basis y = carryBit (s.basis a) (s.basis b) (s.basis c) := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
    not_or, not_false_eq_true, and_true] at hnd
  obtain ⟨⟨hab,hac,hak,hay,hax⟩,⟨hbc,hbk,hby,hbx⟩,
    ⟨hck,hcy,hcx⟩,⟨hky,hkx⟩,hyx⟩ := hnd
  have hba := Ne.symm hab
  have hca := Ne.symm hac
  have hka := Ne.symm hak
  have hya := Ne.symm hay
  have hxa := Ne.symm hax
  have hcb := Ne.symm hbc
  have hkb := Ne.symm hbk
  have hyb := Ne.symm hby
  have hxb := Ne.symm hbx
  have hkc := Ne.symm hck
  have hyc := Ne.symm hcy
  have hxc := Ne.symm hcx
  have hyk := Ne.symm hky
  have hxk := Ne.symm hkx
  have hxy := Ne.symm hyx
  cases m <;> simp_all [addInPlace, majority, eraseCarry, run_append, run_take, run,
      measurementCount, measureAndCorrect, correct, writeBit, Function.update, carryBit]
  all_goals cases hA : s.basis a <;> cases hB : s.basis b <;> cases hC : s.basis c <;>
    cases hX : s.basis x <;> cases hY : s.basis y <;> simp_all

theorem two_receiver (a b c k y x : Wire) (s : State) (m : List Bool)
    (hnd : [a,b,c,k,y,x].Nodup) (hk : s.basis k = false)
    (hs : (run (addInPlace [a,x] [b,y] [k] c) m s).basis y = s.basis x) :
    run (receiverAdd [a,x] [b,y] [k] c) m s =
      run (addInPlace [a,x] [b,y] [k] c) m s := by
  have hy := two_carry a b c k y x s m hnd hk hs
  have h := topReceiver_correct a b c k y x s m hnd hk hy
  change run ((eraseCarry a b c y ++ [.CX x y]) ++ [.CX a b, .CX c b]) m s =
    run ((majority a b c k ++ [.CX x y, .CX k y] ++ eraseCarry a b c k) ++
      [.CX a b, .CX c b]) m s
  have hr : measurementCount (eraseCarry a b c y ++ [.CX x y]) = 1 := by
    simp [eraseCarry,measurementCount_append,measurementCount]
  have ho : measurementCount (majority a b c k ++ [.CX x y, .CX k y] ++ eraseCarry a b c k) = 1 := by
    simp [majority,eraseCarry,measurementCount_append,measurementCount]
  calc
    _ = run [.CX a b, .CX c b] (m.drop 1) (run (eraseCarry a b c y ++ [.CX x y]) m s) := by
      rw [run_append, run_take, hr]
    _ = run [.CX a b, .CX c b] (m.drop 1)
      (run (majority a b c k ++ [.CX x y, .CX k y] ++ eraseCarry a b c k) m s) := by rw [h]
    _ = _ := by
      symm
      rw [run_append, run_take, ho]

theorem receiverAdd_counts (x y carry : List Wire) (cin : Wire)
    (hx : x.length = y.length) (hc : carry.length + 1 = y.length) :
    toffoliCount (receiverAdd x y carry cin) = y.length - 2 ∧
    measurementCount (receiverAdd x y carry cin) = y.length - 1 := by
  induction y generalizing x carry cin with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hx
    | cons a as =>
      cases bs with
      | nil =>
        have ha : as = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
        have hk : carry = [] := List.eq_nil_of_length_eq_zero (by simpa using hc)
        subst as; subst carry
        simp [receiverAdd,toffoliCount,measurementCount]
      | cons y ys =>
        cases as with
        | nil => simp at hx
        | cons x xs =>
          cases carry with
          | nil => simp at hc
          | cons k ks =>
            cases ys with
            | nil =>
              have ha : xs = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
              have hk : ks = [] := List.eq_nil_of_length_eq_zero (by simpa using hc)
              subst xs; subst ks
              simp [receiverAdd,eraseCarry,toffoliCount,measurementCount]
            | cons z zs =>
              have hrec := ih (x::xs) ks k (by simpa using hx) (by simpa using hc)
              simp only [receiverAdd, List.cons_ne_nil, and_false, if_false,
                toffoliCount_append, measurementCount_append, hrec.1, hrec.2]
              simp [majority,eraseCarry,toffoliCount,measurementCount]; omega

theorem receiver_eq (xlo ylo carry : List Wire) (sx sy cin : Wire)
    (hnd : (cin :: ((xlo ++ [sx]) ++ (ylo ++ [sy]) ++ carry)).Nodup)
    (hx : xlo.length = ylo.length) (hc : carry.length = ylo.length)
    (s : State) (m : List Bool) (hclean : ∀ w ∈ carry, s.basis w = false)
    (hs : (run (addInPlace (xlo ++ [sx]) (ylo ++ [sy]) carry cin) m s).basis sy = s.basis sx) :
    run (receiverAdd (xlo ++ [sx]) (ylo ++ [sy]) carry cin) m s =
      run (addInPlace (xlo ++ [sx]) (ylo ++ [sy]) carry cin) m s := by
  induction ylo generalizing xlo carry cin s m with
  | nil =>
    have xz : xlo = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
    have cz : carry = [] := List.eq_nil_of_length_eq_zero (by simpa using hc)
    subst xlo; subst carry
    rfl
  | cons b bs ih =>
    cases xlo with
    | nil => simp at hx
    | cons a as =>
      cases carry with
      | nil => simp at hc
      | cons k ks =>
        have h6 : [a,b,cin,k,sx,sy].Nodup := by
          apply List.nodup_iff_count.mpr
          intro q
          have h := List.nodup_iff_count.mp hnd q
          simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
          omega
        have h4 : [a,b,cin,k].Nodup := by
          have h := h6
          simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
            not_or, not_false_eq_true, and_true] at h ⊢
          tauto
        have hk : s.basis k = false := hclean k (by simp)
        cases bs with
        | nil =>
          have az : as = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
          have kz : ks = [] := List.eq_nil_of_length_eq_zero (by simpa using hc)
          subst as; subst ks
          have h6' : [a,b,cin,k,sy,sx].Nodup := by
            have h := h6
            simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
              not_or, not_false_eq_true, and_true] at h ⊢
            tauto
          simpa using two_receiver a b cin k sy sx s m h6' hk hs
        | cons b' bs' =>
          cases as with
          | nil => simp at hx
          | cons a' as' =>
              have hnd' : (k :: (((a'::as') ++ [sx]) ++ ((b' :: bs') ++ [sy]) ++ ks)).Nodup := by
                apply List.nodup_iff_count.mpr
                intro q
                have h := List.nodup_iff_count.mp hnd q
                simp only [List.count_cons, List.count_append, List.count_nil] at h ⊢
                omega
              let t : State := ⟨s.phase, writeBit s.basis k
                (carryBit (s.basis a) (s.basis b) (s.basis cin))⟩
              have first (r : List Bool) : run (majority a b cin k) r s = t := by
                rw [majority_correct _ _ _ _ h4]
                simp [t,hk]
              have sxk : sx ≠ k := by
                simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
                  not_or, not_false_eq_true, and_true] at h6
                tauto
              have clean' : ∀ w ∈ ks, t.basis w = false := by
                intro w hw
                have wk : w ≠ k := by
                  intro he
                  subst w
                  have h := List.nodup_cons.mp hnd'
                  exact h.1 (by simp [hw])
                simpa [t,writeBit,wk] using hclean w (by simp [hw])
              have hsy : sy ∉ wires (eraseCarry a b cin k ++ [.CX a b, .CX cin b]) := by
                simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, List.nodup_nil,
                  not_or, not_false_eq_true, and_true] at h6
                simp [wires_append,eraseCarry,wires,Instr.wires,correctionWires]
                tauto
              have mt : measurementCount (majority a b cin k) = 0 := rfl
              have horig : run (addInPlace ((a::a'::as') ++ [sx]) ((b::b'::bs') ++ [sy]) (k::ks) cin) m s =
                  run (eraseCarry a b cin k ++ [.CX a b, .CX cin b])
                    (m.drop (measurementCount (addInPlace ((a'::as') ++ [sx]) ((b'::bs') ++ [sy]) ks k)))
                    (run (addInPlace ((a'::as') ++ [sx]) ((b'::bs') ++ [sy]) ks k) m t) := by
                simp only [List.cons_append,addInPlace,List.append_assoc,run_append,run_take,
                  mt,List.drop_zero,first]
              have innerSign : (run (addInPlace ((a'::as') ++ [sx]) ((b'::bs') ++ [sy]) ks k) m t).basis sy = t.basis sx := by
                rw [horig] at hs
                rw [run_preserves_outside _ _ _ sy hsy] at hs
                simpa [t,writeBit,sxk] using hs
              have eq := ih (a'::as') ks k hnd' (by simpa using hx) (by simpa using hc) t m clean' innerSign
              have cnt := receiverAdd_counts ((a'::as') ++ [sx]) ((b'::bs') ++ [sy]) ks k (by simpa using hx) (by simpa using hc)
              have oldcnt := addInPlace_counts ((a'::as') ++ [sx]) ((b'::bs') ++ [sy]) ks k (by simpa using hx) (by simpa using hc)
              simp only [List.cons_append] at cnt oldcnt eq
              rw [horig]
              simp only [List.cons_append,receiverAdd,List.append_eq_nil_iff, List.cons_ne_nil,
                and_false, false_and, if_false,List.append_assoc,run_append,run_take,
                mt,List.drop_zero,first]
              rw [cnt.2,oldcnt.2,eq]
theorem complement_run (q : Wire) (x : List Wire) (hq : q∉x)
    (s : State) (m : List Bool) :
    run (signComplement q x) m s = if s.basis q then run (notRegister x) m s else s := by
  induction x generalizing s with
  | nil => cases s.basis q <;> rfl
  | cons a x ih =>
    have hqa : q≠a := fun h => hq (by simp [h])
    have hqt : q∉x := fun h => hq (List.mem_cons_of_mem _ h)
    simp only [signComplement,List.map_cons,run]
    change run (signComplement q x) m
      ⟨s.phase,writeBit s.basis a (s.basis a ^^ s.basis q)⟩ = _
    rw [ih hqt]
    cases hs : s.basis q <;> simp [hs,writeBit,hqa,notRegister,run]

theorem complement_bit (q : Wire) (x : List Wire) (hn : x.Nodup) (hq : q∉x)
    (s : State) (m : List Bool) (w : Wire) (hw : w∈x) :
    (run (signComplement q x) m s).basis w = (s.basis w ^^ s.basis q) := by
  rw [complement_run q x hq]
  cases h : s.basis q <;> simp [h,notRegister_correct x hn,hw]

def receiverSub (q : Wire) (x y carry : List Wire) : Program :=
  notRegister y ++ signComplement q x ++ receiverAdd x y carry q ++
    signComplement q x ++ notRegister y

theorem receiverSub_eq (xlo ylo carry : List Wire) (sx sy q : Wire)
    (hn : (q::((xlo++[sx])++(ylo++[sy])++carry)).Nodup)
    (hx : xlo.length=ylo.length) (hc : carry.length=ylo.length)
    (s : State) (m : List Bool) (hclean : ∀ w∈carry,s.basis w=false)
    (hsign : (run (signedSub q (xlo++[sx]) (ylo++[sy]) carry) m s).basis sy =
      !(s.basis sx ^^ s.basis q)) :
    run (receiverSub q (xlo++[sx]) (ylo++[sy]) carry) m s =
      run (signedSub q (xlo++[sx]) (ylo++[sy]) carry) m s := by
  let x := xlo++[sx]
  let y := ylo++[sy]
  have hq := (List.nodup_cons.mp hn).1
  have hrest : ((x++y)++carry).Nodup := by
    simpa only [x,y,List.append_assoc] using (List.nodup_cons.mp hn).2
  obtain ⟨hxy,hcn,hxyc⟩ := List.nodup_append'.mp hrest
  obtain ⟨hxn,hyn,hxyd⟩ := List.nodup_append'.mp hxy
  change q∉x++y++carry at hq
  have qx : q∉x := fun h => hq (by simp [h])
  have qy : q∉y := fun h => hq (by simp [h])
  have sxin : sx∈x := by simp [x]
  have syin : sy∈y := by simp [y]
  have sxy : sx∉y := fun h => List.disjoint_left.mp hxyd sxin h
  have syx : sy∉x := fun h => List.disjoint_left.mp hxyd h syin
  let v := run (notRegister y) m s
  let t := run (signComplement q x) m v
  let u := run (addInPlace x y carry q) m t
  have tsx : t.basis sx = (s.basis sx ^^ s.basis q) := by
    rw [show t.basis sx = (v.basis sx ^^ v.basis q) from complement_bit q x hxn qx v m sx sxin]
    simp [v,notRegister_correct y hyn,sxy,qy]
  have clean : ∀ w∈carry,t.basis w=false := by
    intro w hw
    have wx : w∉x := fun h => List.disjoint_left.mp hxyc (List.mem_append_left y h) hw
    have wy : w∉y := fun h => List.disjoint_left.mp hxyc (List.mem_append_right x h) hw
    have hv := (signComplement_correct q x hxn qx v m).2.1 w wx
    rw [show t.basis w = _ from hv]
    simpa [v,notRegister_correct y hyn,wy] using hclean w hw
  have suffix (r : List Bool) : (run (signComplement q x ++ notRegister y) r u).basis sy = !u.basis sy := by
    have hc0 := (signComplement_counts q x).2
    rw [run_append,run_take,hc0,List.drop_zero,notRegister_correct y hyn]
    simp [syin,(signComplement_correct q x hxn qx u r).2.1 sy syx]
  have hc0 := (signComplement_counts q x).2
  have hn0 := (notRegister_counts y).2
  have v0 : run (notRegister y) [] s = v := by
    simpa [hn0,v] using (run_take (notRegister y) m s)
  have t0 : run (signComplement q x) [] v = t := by
    simpa [hc0,t] using (run_take (signComplement q x) m v)
  have original : run (signedSub q x y carry) m s =
      run (signComplement q x ++ notRegister y) (m.drop (measurementCount (addInPlace x y carry q))) u := by
    simp only [signedSub,signedAdd,List.append_assoc,run_append,run_take,
      measurementCount_append,hc0,hn0,Nat.zero_add,Nat.add_zero,List.drop_zero,
      List.take_zero,v0,t0,u]
  have high : u.basis sy = t.basis sx := by
    change (run (signedSub q x y carry) m s).basis sy = _ at hsign
    rw [original,suffix _] at hsign
    have hu : u.basis sy = (s.basis sx ^^ s.basis q) := by simpa using hsign
    exact hu.trans tsx.symm
  have eq := receiver_eq xlo ylo carry sx sy q hn hx hc t m clean (by simpa [x,y,u] using high)
  have oldcount := (addInPlace_counts x y carry q (by simpa [x,y] using hx)
    (by simpa [y] using hc)).2
  have newcount := (receiverAdd_counts x y carry q (by simpa [x,y] using hx)
    (by simpa [y] using hc)).2
  change run (receiverAdd x y carry q) m t = u at eq
  change run (receiverSub q x y carry) m s = run (signedSub q x y carry) m s
  rw [original]
  simp only [receiverSub,List.append_assoc,run_append,run_take,measurementCount_append,
    hc0,hn0,Nat.zero_add,Nat.add_zero,List.drop_zero,List.take_zero,v0,t0]
  rw [newcount, ← oldcount, eq]

def receiverUnrecord (sx sy q : Wire) (x y carry : List Wire) : Program :=
  skywalkSignToggle sx sy q ++ receiverSub q x y carry ++ skywalkSignToggle sx sy q

theorem receiverUnrecord_roundtrip (xlo ylo carry : List Wire) (sx sy q : Wire)
    (hn : (q::((xlo++[sx])++(ylo++[sy])++carry)).Nodup)
    (hx : xlo.length=ylo.length) (hc : carry.length=ylo.length)
    (s : State) (m1 m2 : List Bool) (hq : s.basis q=false)
    (hcarry : regValue carry s.basis=0) :
    run (receiverUnrecord sx sy q (xlo++[sx]) (ylo++[sy]) carry) m2
      (run (signedRecord sx sy q (xlo++[sx]) (ylo++[sy]) carry) m1 s) = s := by
  let x := xlo++[sx]
  let y := ylo++[sy]
  let f := run (signedRecord sx sy q x y carry) m1 s
  let t := run (skywalkSignToggle sx sy q) m2 f
  let z := run (signedSub q x y carry) m2 t
  have hqout := (List.nodup_cons.mp hn).1
  have sxq : sx≠q := by intro h; apply hqout; simp [←h]
  have syq : sy≠q := by intro h; apply hqout; simp [←h]
  have qc : ∀ w∈carry, w≠q := by
    intro w hw h; subst w; apply hqout; simp [hw]
  have record := signedRecord_spec xlo ylo sx sy q carry hn
    (by simpa using hx) (by simpa using hc)
    (signedRegValue x s.basis) (signedRegValue y s.basis) s m1
    ⟨hq,rfl,rfl,hcarry⟩
  have fc : regValue carry f.basis=0 := record.2.2.2.2
  have hist : f.basis q = (s.basis sy ^^ f.basis sy) :=
    signedRecord_history xlo ylo sx sy q carry hn (by simpa using hx)
      (by simpa using hc) s m1 hq hcarry
  have fsx : f.basis sx = s.basis sx :=
    signedRecord_source_restored xlo ylo sx sy q carry hn (by simpa using hx)
      (by simpa using hc) s m1 hq hcarry sx (by simp)
  have clean : ∀ w∈carry,t.basis w=false := by
    intro w hw
    rw [show t = ⟨f.phase,writeBit f.basis q ((!f.basis q) ^^ f.basis sx ^^ f.basis sy)⟩ from
      skywalkSignToggle_correct sx sy q sxq syq f m2]
    simpa [writeBit,qc w hw] using (regValue_zero _ _).mp fc w hw
  have tsx : t.basis sx=s.basis sx := by
    simp [t,skywalkSignToggle_correct sx sy q sxq syq,writeBit,sxq,fsx]
  have tq : t.basis q = !(s.basis sx ^^ s.basis sy) := by
    simp only [t,skywalkSignToggle_correct sx sy q sxq syq,writeBit,Function.update_self,fsx,hist]
    cases s.basis sx <;> cases s.basis sy <;> cases f.basis sy <;> rfl
  have toggle0 := (skywalkSignToggle_counts sx sy q).2
  have oldRound := signedRecord_roundtrip xlo ylo sx sy q carry hn
    (by simpa using hx) (by simpa using hc) s m1 m2 hq hcarry
  have zout : z.basis sy=s.basis sy := by
    have round : run (skywalkSignToggle sx sy q)
        (m2.drop (measurementCount (signedSub q x y carry))) z=s := by
      simpa only [signedUnrecord,List.append_assoc,run_append,run_take,
        measurementCount_append,toggle0,Nat.zero_add,List.drop_zero,f,t,z] using oldRound
    have h := congrArg (fun a : State => a.basis sy) round
    simpa [skywalkSignToggle_correct sx sy q sxq syq,writeBit,syq] using h
  have sign : z.basis sy = !(t.basis sx ^^ t.basis q) := by
    rw [zout,tsx,tq]
    cases s.basis sx <;> cases s.basis sy <;> rfl
  have eq := receiverSub_eq xlo ylo carry sx sy q hn hx hc t m2 clean (by simpa [x,y,z] using sign)
  have subcount := (signedWord_counts q x y carry (by simpa [x,y] using hx)
    (by simpa [y] using hc)).2.2.2
  have reccount : measurementCount (receiverSub q x y carry) = y.length-1 := by
    have addcount := (receiverAdd_counts x y carry q (by simpa [x,y] using hx)
      (by simpa [y] using hc)).2
    simp [receiverSub,measurementCount_append,(notRegister_counts y).2,
      (signComplement_counts q x).2,addcount]
  have t0 : run (skywalkSignToggle sx sy q) [] f=t := by
    simpa [toggle0,t] using (run_take (skywalkSignToggle sx sy q) m2 f)
  change run (receiverSub q x y carry) m2 t = run (signedSub q x y carry) m2 t at eq
  change run (receiverUnrecord sx sy q x y carry) m2 f = s
  calc
    _ = run (signedUnrecord sx sy q x y carry) m2 f := by
      simp only [receiverUnrecord,signedUnrecord,List.append_assoc,run_append,run_take,
        measurementCount_append,toggle0,Nat.zero_add,List.drop_zero,List.take_zero,t0]
      rw [reccount,subcount,eq]
    _ = s := oldRound

def narrowReceiver (L : NarrowSignedRecordLayout) (n : Nat) : Program :=
  signComplement L.q (L.y.drop n) ++
    receiverUnrecord L.sx L.sy L.q (L.x.take n) (L.y.take n) (L.carry.take (n-1))

theorem narrowReceiver_roundtrip (L : NarrowSignedRecordLayout) (n : Nat)
    (hw : L.Widths n) (hn : L.wires.Nodup) (s : State) (m1 m2 : List Bool)
    (hq : s.basis L.q=false) (hc : regValue L.carry s.basis=0) :
    run (narrowReceiver L n) m2 (run (narrowSignedRecord L n) m1 s)=s := by
  have hv := L.views n hw
  have hcarry : regValue L.carryLow s.basis=0 := by
    apply (regValue_zero _ _).mpr
    intro a ha
    exact (regValue_zero _ _).mp hc a (List.mem_append_left _ ha)
  have hm := signComplement_counts L.q L.yhigh
  simp only [narrowSignedRecord,narrowReceiver,hv.1,hv.2.1,hv.2.2.1,hv.2.2.2]
  rw [run_append,run_append,hm.2]
  simp only [List.take_zero,List.drop_zero]
  rw [narrow_fanout_twice L.q L.yhigh (L.high_nodup hn) (L.q_high hn)]
  apply receiverUnrecord_roundtrip L.xlo L.ylo L.carryLow L.sx L.sy L.q
    (L.short_nodup hn) _ _ s _ m2 hq hcarry
  · have h := hw.x.trans hw.y.symm
    simp [NarrowSignedRecordLayout.xp,NarrowSignedRecordLayout.yp] at h
    exact h
  · have h := hw.carry.trans hw.y.symm
    simp [NarrowSignedRecordLayout.yp] at h
    omega

theorem receiverAdd_support (x y carry : List Wire) (cin : Wire)
    (hx : x.length=y.length) (hc : carry.length+1=y.length) :
    wires (receiverAdd x y carry cin) ⊆ (cin::(x++y++carry)).toFinset := by
  induction y generalizing x carry cin with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hx
    | cons a as =>
      cases bs with
      | nil =>
        have ha : as=[] := List.eq_nil_of_length_eq_zero (by simpa using hx)
        have hk : carry=[] := List.eq_nil_of_length_eq_zero (by simpa using hc)
        subst as; subst carry
        simp [receiverAdd,wires,Instr.wires]
      | cons y ys =>
        cases as with
        | nil => simp at hx
        | cons x xs =>
          cases carry with
          | nil => simp at hc
          | cons k ks =>
            cases ys with
            | nil =>
              have ha : xs=[] := List.eq_nil_of_length_eq_zero (by simpa using hx)
              have hk : ks=[] := List.eq_nil_of_length_eq_zero (by simpa using hc)
              subst xs; subst ks
              intro w hw
              simp [receiverAdd,wires_append,eraseCarry_wires,wires,Instr.wires] at hw ⊢
              tauto
            | cons z zs =>
              have hrec := ih (x::xs) ks k (by simpa using hx) (by simpa using hc)
              have hm : wires (majority a b cin k) = {a,b,cin,k} := by
                ext w; simp [majority,wires,Instr.wires]; tauto
              intro w hw
              simp only [receiverAdd,List.cons_ne_nil,and_false,if_false,wires_append,
                hm,eraseCarry_wires,Finset.mem_union,Finset.mem_insert,Finset.mem_singleton,
                List.mem_toFinset,List.mem_cons,List.mem_append] at hw ⊢
              have hsub : w ∈ wires (receiverAdd (x::xs) (y::z::zs) ks k) →
                  w=k ∨ w∈x::xs ∨ w∈y::z::zs ∨ w∈ks := by
                intro h
                have h' := hrec h
                simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at h' ⊢
                tauto
              simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_insert,
                Finset.mem_singleton,Finset.notMem_empty,or_false] at hw
              simp only [List.mem_cons] at hsub
              tauto

end ECDSAAdd.Entrant.W.ReverseCarry

end
section
-- ===== BundleReverseCarryTick =====

set_option maxRecDepth 8192
set_option maxHeartbeats 10000000
namespace ECDSAAdd.Entrant.W.ReverseCarry
open ECDSAAdd ECDSAAdd.Arithmetic

def receiverUntick (L : SkywalkIntegerLayout) (n : Nat) : Program :=
  [.CX L.previous L.a0] ++ narrowReceiver (narrowSkywalkRecordLayout L n) n ++
    skywalkSignedHalf L.aSign L.ext ++ [.CX L.a0 L.b0] ++ swapRegisters L.a0 L.ah L.bh

private theorem prefix_no_measure (p q : Program) (hp : measurementCount p=0)
    (s : State) (m : List Bool) : run (p++q) m s=run q m (run p m s) := by
  have hr := run_take p m s
  rw [hp,List.take_zero] at hr
  rw [run_append,hp,List.take_zero,List.drop_zero,hr]

private theorem suffix_no_measure (p q : Program) (hq : measurementCount q=0)
    (s : State) (m : List Bool) : run (p++q) m s=run q m (run p m s) := by
  rw [run_append,run_take]
  have h1 := run_take q (m.drop (measurementCount p)) (run p m s)
  have h2 := run_take q m (run p m s)
  rw [hq,List.take_zero] at h1 h2
  exact h1.symm.trans h2

private theorem route_aux_frame (L : SkywalkIntegerLayout) (hv : L.Valid)
    (s : State) (m : List Bool) (q : Wire)
    (hq : q∈L.previous::L.history::L.ext::L.carry) :
    (run (skywalkRoute L.a0 L.b0 L.ah L.bh) m s).basis q=s.basis q := by
  have hn : ((L.previous::L.history::L.ext::L.carry)++
      (L.a0::L.b0::(L.ah++L.bh))).Nodup := by
    apply List.nodup_iff_count.mpr
    intro w
    have hh := List.nodup_iff_count.mp hv.nodup w
    simp only [SkywalkIntegerLayout.wires,List.count_cons,List.count_append] at hh ⊢
    omega
  have hd := (List.nodup_append'.mp hn).2.2
  apply run_preserves_outside
  intro hm
  have hh := skywalkRoute_wires_subset L.a0 L.b0 L.ah L.bh (L.high_lengths hv) hm
  exact List.disjoint_left.mp hd hq (List.mem_toFinset.mp hh)

private theorem half_aux_frame (L : SkywalkIntegerLayout) (hv : L.Valid)
    (s : State) (m : List Bool) (q : Wire)
    (hq : q∈L.previous::L.history::L.a0::(L.b++L.carry)) :
    (run (skywalkSignedHalf L.aSign L.ext) m s).basis q=s.basis q := by
  have hne : q≠L.ext := by
    intro he
    subst q
    have hh := List.nodup_iff_count.mp hv.nodup L.ext
    have hp := List.count_pos_iff.mpr hq
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.b,
      List.count_cons,List.count_append] at hh hp
    simp only [beq_self_eq_true,if_true] at hh
    omega
  exact (skywalkSignedHalf_frame L.aSign L.ext s m).2 q hne

private theorem ext_outside_high (L : SkywalkIntegerLayout) (hv : L.Valid) :
    L.ext∉L.ah := by
  intro hm
  have hh := List.nodup_iff_count.mp hv.nodup L.ext
  have hp := List.count_pos_iff.mpr hm
  simp only [SkywalkIntegerLayout.wires,List.count_cons,List.count_append] at hh
  simp only [beq_self_eq_true,if_true] at hh
  omega

private theorem ext_sign_ne (L : SkywalkIntegerLayout) (hv : L.Valid) : L.aSign≠L.ext := by
  intro he
  exact ext_outside_high L hv (by simp [SkywalkIntegerLayout.ah,←he])

private theorem previous_low_ne (L : SkywalkIntegerLayout) (hv : L.Valid) : L.previous≠L.a0 := by
  intro he
  have hh := List.nodup_iff_count.mp hv.nodup L.previous
  simp only [SkywalkIntegerLayout.wires,List.count_cons,List.count_append] at hh
  simp [he] at hh

private theorem tick_run (L : SkywalkIntegerLayout) (hv : L.Valid) (n : Nat) (s : State) (m : List Bool) :
    run (narrowSkywalkTick L n) m s=
      run [.CX L.previous L.a0] m
        (run (narrowSignedRecord (narrowSkywalkRecordLayout L n) n) m
          (run (skywalkSignedHalf L.aSign L.ext) m
            (run (skywalkRoute L.a0 L.b0 L.ah L.bh) m s))) := by
  have hr := (skywalkRoute_counts L.a0 L.b0 L.ah L.bh
    (L.high_lengths hv) (L.route_nodup hv)).2
  have hh := (skywalkSignedHalf_counts L.aSign L.ext).2
  simp only [narrowSkywalkTick,List.append_assoc]
  rw [prefix_no_measure _ _ hr,prefix_no_measure _ _ hh,
    suffix_no_measure _ _ (by rfl : measurementCount [.CX L.previous L.a0]=0)]


/-- Full-State equality of independently measured wide and retained-prefix
records. High target sign extension is an actual Clifford fanout. -/
private theorem swap_twice (c : Wire) (a b : List Wire) (hl : a.length=b.length)
    (hn : (c::(a++b)).Nodup) (s : State) (m₁ m₂ : List Bool) :
    run (swapRegisters c a b) m₂ (run (swapRegisters c a b) m₁ s)=s := by
  let t := run (swapRegisters c a b) m₁ s
  let v := run (swapRegisters c a b) m₂ t
  obtain ⟨p1,e1,a1,b1⟩ := swapRegisters_correct c a b hl hn s m₁
  obtain ⟨p2,e2,a2,b2⟩ := swapRegisters_correct c a b hl hn t m₂
  have hc : t.basis c=s.basis c := e1 c
    (fun h => (List.nodup_cons.mp hn).1 (by simp [h]))
    (fun h => (List.nodup_cons.mp hn).1 (by simp [h]))
  have ha : regValue a v.basis=regValue a s.basis := by
    rw [a2,hc,a1,b1]
    cases s.basis c <;> rfl
  have hb : regValue b v.basis=regValue b s.basis := by
    rw [b2,hc,a1,b1]
    cases s.basis c <;> rfl
  apply congrArg₂ State.mk
  · exact p2.trans p1
  · funext q
    by_cases hqa : q∈a
    · exact (regValue_eq_iff _ _ _).mp ha q hqa
    by_cases hqb : q∈b
    · exact (regValue_eq_iff _ _ _).mp hb q hqb
    exact (e2 q hqa hqb).trans (e1 q hqa hqb)

private theorem cx_twice (c t : Wire) (hct : c≠t) (s : State) (m₁ m₂ : List Bool) :
    run [.CX c t] m₂ (run [.CX c t] m₁ s)=s := by
  apply congrArg (State.mk s.phase)
  funext q
  by_cases hq : q=t
  · subst q
    cases hc : s.basis c <;> cases ht : s.basis t <;>
      simp [run,writeBit,hct,hc,ht]
  · simp [run,writeBit,hq]

private theorem route_roundtrip (L : SkywalkIntegerLayout) (hv : L.Valid)
    (s : State) (m₁ m₂ : List Bool) :
    run ([.CX L.a0 L.b0]++swapRegisters L.a0 L.ah L.bh) m₂
      (run (skywalkRoute L.a0 L.b0 L.ah L.bh) m₁ s)=s := by
  have hl := L.high_lengths hv
  have hn : (L.a0::(L.ah++L.bh)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have hh := List.nodup_iff_count.mp (L.route_nodup hv) q
    simp only [List.count_cons] at hh ⊢
    omega
  have hne : L.a0≠L.b0 := fun h => (List.nodup_cons.mp (L.route_nodup hv)).1 (by simp [h])
  have hm := (swapRegisters_resources L.a0 L.ah L.bh hl hn).2.1
  rw [skywalkRoute,prefix_no_measure _ _ hm,
    prefix_no_measure _ _ (by rfl : measurementCount [.CX L.a0 L.b0]=0)]
  rw [cx_twice L.a0 L.b0 hne]
  exact swap_twice L.a0 L.ah L.bh hl hn s m₁ m₂

private theorem untick_run (L : SkywalkIntegerLayout) (hv : L.Valid) (n : Nat) (s : State) (m : List Bool) :
    run (receiverUntick L n) m s=
      run ([.CX L.a0 L.b0]++swapRegisters L.a0 L.ah L.bh) m
        (run (skywalkSignedHalf L.aSign L.ext) m
          (run (narrowReceiver (narrowSkywalkRecordLayout L n) n) m
            (run [.CX L.previous L.a0] m s))) := by
  have hl := L.high_lengths hv
  have hn : (L.a0::(L.ah++L.bh)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have hh := List.nodup_iff_count.mp (L.route_nodup hv) q
    simp only [List.count_cons] at hh ⊢
    omega
  have hs := (swapRegisters_resources L.a0 L.ah L.bh hl hn).2.1
  have hh := (skywalkSignedHalf_counts L.aSign L.ext).2
  have ht : measurementCount (skywalkSignedHalf L.aSign L.ext++
      ([.CX L.a0 L.b0]++swapRegisters L.a0 L.ah L.bh))=0 := by
    simp [measurementCount_append,hh,hs,measurementCount]
  simp only [receiverUntick,List.append_assoc]
  rw [prefix_no_measure _ _ (by rfl : measurementCount [.CX L.previous L.a0]=0),
    suffix_no_measure _ _ ht,prefix_no_measure _ _ hh]

/-- The separately emitted inverse restores the entire physical State with
independent measurement streams. Only the history/carry clean premises are
needed for reversal; signed parity/extension premises are for interpretation. -/
theorem receiverTick_roundtrip (L : SkywalkIntegerLayout) (hv : L.Valid) (n : Nat)
    (hn : 0 < n) (hle : n ≤ L.half.length) (s : State) (m₁ m₂ : List Bool) (hq : s.basis L.history=false)
    (hk : regValue L.carry s.basis=0) :
    run (receiverUntick L n) m₂ (run (narrowSkywalkTick L n) m₁ s)=s := by
  let t := run (skywalkRoute L.a0 L.b0 L.ah L.bh) m₁ s
  let u := run (skywalkSignedHalf L.aSign L.ext) m₁ t
  have tq : t.basis L.history=false :=
    (route_aux_frame L hv s m₁ L.history (by simp)).trans hq
  have tk : regValue L.carry t.basis=0 := by
    apply Eq.trans (regValue_congr _ _ _ ?_) hk
    intro q hq
    exact route_aux_frame L hv s m₁ q (by simp [hq])
  have uq : u.basis L.history=false :=
    (half_aux_frame L hv t m₁ L.history (by simp)).trans tq
  have uk : regValue L.carry u.basis=0 := by
    apply Eq.trans (regValue_congr _ _ _ ?_) tk
    intro q hq
    exact half_aux_frame L hv t m₁ q (by simp [hq])
  have hvv := narrowSkywalkRecord_views L hv n hn hle
  have hr := narrowReceiver_roundtrip (narrowSkywalkRecordLayout L n) n
    (narrowSkywalkRecord_widths L hv n hn hle)
    (narrowSkywalkRecord_nodup L hv n hn hle) u m₁ m₂
    (by simpa only [narrowSkywalkRecordLayout] using uq)
    (by simpa only [hvv.2.2] using uk)
  have hh : run (skywalkSignedHalf L.aSign L.ext) m₂ u=t := by
    simpa only [skywalkSignedHalf,run] using
      skywalkSignedHalf_twice L.aSign L.ext (ext_sign_ne L hv) t m₁
  rw [tick_run L hv n s m₁,untick_run L hv n _ m₂,
    cx_twice L.previous L.a0 (previous_low_ne L hv)]
  change run ([.CX L.a0 L.b0]++swapRegisters L.a0 L.ah L.bh) m₂
    (run (skywalkSignedHalf L.aSign L.ext) m₂
      (run (narrowReceiver (narrowSkywalkRecordLayout L n) n) m₂
        (run (narrowSignedRecord (narrowSkywalkRecordLayout L n) n) m₁ u)))=s
  rw [hr,hh]
  exact route_roundtrip L hv s m₁ m₂



attribute [local irreducible] compactSkywalkTick compactSkywalkReverseTick

def compactReceiverTick (w : Nat → Wire) (i : Nat) : Program :=
  if i = 511 then compactSkywalkReverseTick w i else
    compactSkywalkReverseExpand w i ++
      receiverUntick (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)

theorem compactReceiverTick_roundtrip (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (s : State) (m1 m2 : List Bool)
    (hh : s.basis (compactSkywalkTickLayout w i).history = false)
    (hc : regValue (compactSkywalkTickLayout w i).carry s.basis = 0) :
    run (compactReceiverTick w i) m2 (run (compactSkywalkTick w i) m1 s) = s := by
  by_cases last : i=511
  · subst i
    simp only [compactReceiverTick,if_true]
    exact compactSkywalkReverseTick_roundtrip w 511 hi hn s m1 m2 hh hc
  · simp only [compactReceiverTick,last,if_false]
    have hz := (compactSkywalkReverseExpand_counts w i).2
    have hr := compactSkywalkTickOutput_run w i s m1
    rw [hr,compactSkywalkSign_no_measure_append _ _ hz]
    rw [compactSkywalkReverseExpand_cleanup w i hi hn _ m1 m2]
    have width := compactSkywalkTick_width_bounds i hi
    exact receiverTick_roundtrip _ (compactSkywalkTick_valid w i hi hn)
      (compactSkywalkTickPostWidth i) (by omega) (by
        rw [compactSkywalkTick_half w i hi,wireBlock_length]; exact width.2.2.1) s m1 m2 hh hc

end ECDSAAdd.Entrant.W.ReverseCarry

end
section
-- ===== BundleReverseCarryPhysical =====

set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
namespace ECDSAAdd.Entrant.W.ReverseCarry
open ECDSAAdd ECDSAAdd.Arithmetic RecordedQuantum

theorem receiverAdd_physical (x y carry : List Wire) (cin : Wire)
    (hn : (cin :: x ++ y ++ carry).Nodup) : GatePhysical (receiverAdd x y carry cin) := by
  induction x generalizing y carry cin with
  | nil => simp [receiverAdd,GatePhysical]
  | cons a xs ih =>
    cases xs with
    | nil =>
      cases y with
      | nil => simp [receiverAdd,GatePhysical]
      | cons b ys =>
        cases ys with
        | cons b' ys => simp [receiverAdd,GatePhysical]
        | nil =>
          have hab : a ≠ b := by
            intro e; subst b
            have h := List.nodup_iff_count.mp hn a
            simp only [List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
            omega
          have hcb : cin ≠ b := by
            intro e; subst cin
            have h := List.nodup_iff_count.mp hn b
            simp only [List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
            omega
          simp [receiverAdd,GatePhysical,PhysicalInstr,ProperGate,hab,hcb]
    | cons a' xs =>
      cases y with
      | nil => simp [receiverAdd,GatePhysical]
      | cons b ys =>
        cases ys with
        | nil => simp [receiverAdd,GatePhysical]
        | cons b' ys =>
          cases carry with
          | nil => simp [receiverAdd,GatePhysical]
          | cons k ks =>
            have hs : [a,b,cin,k].Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := List.nodup_iff_count.mp hn q
              simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢; omega
            have ht : (k :: (a'::xs) ++ (b'::ys) ++ ks).Nodup := by
              apply List.nodup_iff_count.mpr; intro q
              have h := List.nodup_iff_count.mp hn q
              simp only [List.count_cons,List.count_append] at h ⊢; omega
            have htail := ih (b'::ys) ks k ht
            by_cases h : xs=[] ∧ ys=[]
            · have hsix : [a,b,cin,k,a',b'].Nodup := by
                apply List.nodup_iff_count.mpr; intro q
                have h' := List.nodup_iff_count.mp hn q
                simp only [List.count_cons,List.count_append,List.count_nil] at h' ⊢
                omega
              simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
                not_or,not_false_eq_true,and_true] at hsix
              simp only [receiverAdd,h.1,h.2,true_and,if_true,gatePhysical_append]
              refine ⟨eraseCarry_physical _ _ _ _,?_⟩
              simp [GatePhysical,PhysicalInstr,ProperGate,hsix.1.1,
                Ne.symm hsix.2.1.1,hsix.2.2.2.2]
            · simp only [receiverAdd,h,if_false,gatePhysical_append]
              refine ⟨⟨⟨majority_physical _ _ _ _ hs,htail⟩,eraseCarry_physical _ _ _ _⟩,?_⟩
              simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
                not_or,not_false_eq_true,and_true] at hs
              have hcb : cin ≠ b := Ne.symm hs.2.1.1
              simp [GatePhysical,PhysicalInstr,ProperGate,hs.1.1,hcb]

theorem receiverSub_physical (q : Wire) (x y carry : List Wire)
    (hn : (q::x++y++carry).Nodup) : GatePhysical (receiverSub q x y carry) := by
  have away : q∉x := fun hx => (List.nodup_cons.mp hn).1 (by simp [hx])
  have fan := signComplement_physical q x away
  have add := receiverAdd_physical x y carry q hn
  have nots := notRegister_physical y
  simp only [receiverSub,gatePhysical_append]
  exact ⟨⟨⟨⟨nots,fan⟩,add⟩,fan⟩,nots⟩

theorem narrowReceiver_physical (L : NarrowSignedRecordLayout) (n : Nat)
    (hw : L.Widths n) (hn : L.wires.Nodup) : GatePhysical (narrowReceiver L n) := by
  have view := L.views n hw
  have nd := L.short_nodup hn
  have sx : L.sx≠L.q := by
    intro eq
    exact (List.nodup_cons.mp nd).1 (by simp [NarrowSignedRecordLayout.xp,←eq])
  have sy : L.sy≠L.q := by
    intro eq
    exact (List.nodup_cons.mp nd).1 (by simp [NarrowSignedRecordLayout.yp,←eq])
  have toggle : GatePhysical (skywalkSignToggle L.sx L.sy L.q) := by
    simp [skywalkSignToggle,GatePhysical,PhysicalInstr,ProperGate,sx,sy]
  have a := receiverSub_physical L.q L.xp L.yp L.carryLow nd
  have f := signComplement_physical L.q L.yhigh (L.q_high hn)
  simp only [narrowReceiver,receiverUnrecord,view.1,view.2.1,view.2.2.1,view.2.2.2,gatePhysical_append]
  exact ⟨f,⟨toggle,a⟩,toggle⟩

theorem receiverUntick_physical (L : SkywalkIntegerLayout) (n : Nat) (hv : L.Valid)
    (hn : 0<n) (hle : n≤L.half.length) : GatePhysical (receiverUntick L n) := by
  have route := L.route_nodup hv
  have swnd : (L.a0::L.ah++L.bh).Nodup := by
    apply List.nodup_iff_count.mpr; intro q
    have h := List.nodup_iff_count.mp route q
    simp only [List.count_cons,List.count_append] at h ⊢; omega
  have ab : L.a0≠L.b0 := by
    intro eq; exact (List.nodup_cons.mp route).1 (by simp [eq])
  have se : L.aSign≠L.ext := by
    intro eq
    have h := List.nodup_iff_count.mp hv.nodup L.ext
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah,eq,
      List.count_cons,List.count_append,List.count_nil,beq_self_eq_true,if_true] at h
    omega
  have pa : L.previous≠L.a0 := by
    intro eq
    exact (List.nodup_cons.mp hv.nodup).1 (by simp [eq])
  have sw := swapRegisters_physical L.a0 L.ah L.bh swnd
  have cx : GatePhysical [.CX L.a0 L.b0] := by simp [GatePhysical,PhysicalInstr,ProperGate,ab]
  have half : GatePhysical (skywalkSignedHalf L.aSign L.ext) := by
    simp [skywalkSignedHalf,GatePhysical,PhysicalInstr,ProperGate,se]
  have prev : GatePhysical [.CX L.previous L.a0] := by simp [GatePhysical,PhysicalInstr,ProperGate,pa]
  have recs := narrowReceiver_physical (narrowSkywalkRecordLayout L n) n
    (narrowSkywalkRecord_widths L hv n hn hle) (narrowSkywalkRecord_nodup L hv n hn hle)
  simp only [receiverUntick,gatePhysical_append]
  exact ⟨⟨⟨⟨prev,recs⟩,half⟩,cx⟩,sw⟩

theorem compactReceiverTick_physical (w : Nat → Wire) (i : Nat) (hi : i<512)
    (hn : (skywalkPoolWires w).Nodup) : GatePhysical (compactReceiverTick w i) := by
  by_cases last : i=511
  · simp only [compactReceiverTick,last,if_true]
    subst i
    exact (compactTicks_physical w 511 hi hn).2
  · have bounds := compactSkywalkTick_width_bounds i hi
    have n := receiverUntick_physical (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)
      (compactSkywalkTick_valid w i hi hn) (by omega)
      (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; omega)
    have val := compactSkywalkTick_release_valid w i hi hn
    have a := compactSigns_physical (compactSkywalkTickARelease w i) val.1
    have b := compactSigns_physical (compactSkywalkTickBRelease w i) val.2
    simp only [compactReceiverTick,last,if_false,compactSkywalkReverseExpand,gatePhysical_append]
    exact ⟨⟨b.2,a.2⟩,n⟩

end ECDSAAdd.Entrant.W.ReverseCarry

end
section
-- ===== BundleReverseCarryResources =====

set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
namespace ECDSAAdd.Entrant.W.ReverseCarry
open ECDSAAdd ECDSAAdd.Arithmetic

theorem receiverSub_counts (q : Wire) (x y carry : List Wire)
    (hx : x.length=y.length) (hc : carry.length+1=y.length) :
    toffoliCount (receiverSub q x y carry)=y.length-2 ∧
    measurementCount (receiverSub q x y carry)=y.length-1 := by
  have a := receiverAdd_counts x y carry q hx hc
  have f := signComplement_counts q x
  have n := notRegister_counts y
  simp [receiverSub,toffoliCount_append,measurementCount_append,a.1,a.2,f.1,f.2,n.1,n.2]

theorem narrowReceiver_counts (L : NarrowSignedRecordLayout) (n : Nat) (hw : L.Widths n) :
    toffoliCount (narrowReceiver L n)=n-2 ∧ measurementCount (narrowReceiver L n)=n-1 := by
  have v := L.views n hw
  have c := receiverSub_counts L.q L.xp L.yp L.carryLow
    (hw.x.trans hw.y.symm) (hw.carry.trans hw.y.symm)
  have f := signComplement_counts L.q L.yhigh
  have t := skywalkSignToggle_counts L.sx L.sy L.q
  simp [narrowReceiver,receiverUnrecord,v.1,v.2.1,v.2.2.1,v.2.2.2,
    toffoliCount_append,measurementCount_append,c.1,c.2,f.1,f.2,t.1,t.2,hw.y]

theorem receiverUnrecord_support (xlo ylo carry : List Wire) (sx sy q : Wire)
    (hx : (xlo++[sx]).length=(ylo++[sy]).length)
    (hc : carry.length+1=(ylo++[sy]).length) :
    wires (receiverUnrecord sx sy q (xlo++[sx]) (ylo++[sy]) carry) ⊆
      (q::((xlo++[sx])++(ylo++[sy])++carry)).toFinset := by
  let x := xlo++[sx]
  let y := ylo++[sy]
  have a := receiverAdd_support x y carry q hx hc
  have f := signComplement_wires_subset q x
  change wires (receiverUnrecord sx sy q x y carry) ⊆ (q::(x++y++carry)).toFinset
  intro w hw
  simp only [receiverUnrecord,receiverSub,wires_append,Finset.mem_union,
    skywalkSignToggle_wires,notRegister_wires] at hw
  have add (h : w ∈ wires (receiverAdd x y carry q)) := a h
  have fan (h : w ∈ wires (signComplement q x)) := f h
  simp only [List.mem_toFinset,List.mem_cons,List.mem_append] at hw ⊢ add fan
  simp only [x,y,List.mem_append,List.mem_singleton] at *
  tauto

theorem narrowReceiver_support (L : NarrowSignedRecordLayout) (n : Nat) (hw : L.Widths n) :
    wires (narrowReceiver L n)⊆L.wires.toFinset := by
  have v := L.views n hw
  have h := receiverUnrecord_support L.xlo L.ylo L.carryLow L.sx L.sy L.q
    (hw.x.trans hw.y.symm) (hw.carry.trans hw.y.symm)
  change wires (receiverUnrecord L.sx L.sy L.q L.xp L.yp L.carryLow) ⊆
    (L.q::(L.xp++L.yp++L.carryLow)).toFinset at h
  have hf := signComplement_wires_subset L.q L.yhigh
  have small : (L.q::(L.xp++L.yp++L.carryLow)).toFinset⊆L.wires.toFinset := by
    intro a ha
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append,NarrowSignedRecordLayout.wires,
      NarrowSignedRecordLayout.x,NarrowSignedRecordLayout.y,NarrowSignedRecordLayout.carry] at ha ⊢
    tauto
  have high : (L.q::L.yhigh).toFinset⊆L.wires.toFinset := by
    intro a ha
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append,NarrowSignedRecordLayout.wires,
      NarrowSignedRecordLayout.x,NarrowSignedRecordLayout.y,NarrowSignedRecordLayout.carry] at ha ⊢
    tauto
  simp only [narrowReceiver,v.1,v.2.1,v.2.2.1,v.2.2.2,wires_append,Finset.union_subset_iff]
  exact ⟨hf.trans high,h.trans small⟩

theorem receiverUntick_counts (L : SkywalkIntegerLayout) (n : Nat) (hv : L.Valid)
    (hn : 0<n) (hle : n≤L.half.length) :
    toffoliCount (receiverUntick L n)=L.ah.length+(n-2) ∧
    measurementCount (receiverUntick L n)=n-1 := by
  have hl := L.high_lengths hv
  have nd : (L.a0::(L.ah++L.bh)).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp (L.route_nodup hv) q
    simp only [List.count_cons] at h ⊢
    omega
  have sw := swapRegisters_resources L.a0 L.ah L.bh hl nd
  have half := skywalkSignedHalf_counts L.aSign L.ext
  have recs := narrowReceiver_counts (narrowSkywalkRecordLayout L n) n
    (narrowSkywalkRecord_widths L hv n hn hle)
  simp [receiverUntick,toffoliCount_append,measurementCount_append,
    toffoliCount,measurementCount,sw.1,sw.2.1,half.1,half.2,recs.1,recs.2]
  omega

theorem receiverUntick_support (L : SkywalkIntegerLayout) (n : Nat) (hv : L.Valid)
    (hn : 0<n) (hle : n≤L.half.length) : wires (receiverUntick L n) ⊆ L.wires.toFinset := by
  have hl := L.high_lengths hv
  have hswap : wires (swapRegisters L.a0 L.ah L.bh)⊆L.wires.toFinset := by
    intro q hq
    have h := swapRegisters_wires L.a0 L.ah L.bh hl hq
    simp only [SkywalkIntegerLayout.wires,List.mem_toFinset,List.mem_cons,List.mem_append] at h ⊢
    tauto
  have hhalf : wires (skywalkSignedHalf L.aSign L.ext)⊆L.wires.toFinset := by
    rw [skywalkSignedHalf_wires]
    intro q hq
    simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hq
    rcases hq with rfl|rfl
    · simp [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.ah]
    · simp [SkywalkIntegerLayout.wires]
  have hword := narrowReceiver_support (narrowSkywalkRecordLayout L n) n
    (narrowSkywalkRecord_widths L hv n hn hle)
  have vv := narrowSkywalkRecord_views L hv n hn hle
  have hsigned : wires (narrowReceiver (narrowSkywalkRecordLayout L n) n) ⊆
        (L.history::(L.half++L.b++L.carry)).toFinset := by
    simpa only [NarrowSignedRecordLayout.wires,vv.1,vv.2.1,vv.2.2] using hword
  have hown : (L.history::(L.half++L.b++L.carry)).toFinset⊆L.wires.toFinset := by
    intro q hq
    simp only [SkywalkIntegerLayout.wires,SkywalkIntegerLayout.half,SkywalkIntegerLayout.b,
      List.mem_toFinset,List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at hq ⊢
    tauto
  have hprevious : wires [.CX L.previous L.a0]⊆L.wires.toFinset := by
    simp [SkywalkIntegerLayout.wires,wires,Instr.wires]
  have hlow : wires [.CX L.a0 L.b0]⊆L.wires.toFinset := by
    intro q hq
    simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_insert,
      Finset.mem_singleton,Finset.notMem_empty,or_false] at hq
    simp only [SkywalkIntegerLayout.wires,List.mem_toFinset,List.mem_cons,List.mem_append]
    tauto
  simp only [receiverUntick,wires_append,Finset.union_subset_iff]
  exact ⟨⟨⟨⟨hprevious,hsigned.trans hown⟩,hhalf⟩,hlow⟩,hswap⟩

theorem compactReceiverTick_support (w : Nat → Wire) (i : Nat) (hi : i<512)
    (hn : (skywalkPoolWires w).Nodup) :
    wires (compactReceiverTick w i) ⊆ (compactSkywalkTickLayout w i).wires.toFinset := by
  by_cases last : i=511
  · subst i
    simp only [compactReceiverTick,if_true]
    exact compactSkywalkReverseTick_support w 511 hi hn
  · have bounds := compactSkywalkTick_width_bounds i hi
    have h := receiverUntick_support (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)
      (compactSkywalkTick_valid w i hi hn) (by omega)
      (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; omega)
    simp only [compactReceiverTick,last,if_false,wires_append,Finset.union_subset_iff]
    exact ⟨compactSkywalkReverseExpand_support w i hi,h⟩

theorem compactReceiverTick_counts (w : Nat → Wire) (i : Nat) (hi : i<511)
    (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (compactReceiverTick w i)+1=toffoliCount (compactSkywalkReverseTick w i) ∧
    measurementCount (compactReceiverTick w i)=measurementCount (compactSkywalkReverseTick w i) := by
  have width := compactSkywalkTick_width_bounds i (by omega)
  have r := receiverUntick_counts (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)
    (compactSkywalkTick_valid w i (by omega) hn) (by omega)
    (by rw [compactSkywalkTick_half w i (by omega),wireBlock_length]; omega)
  have old := compactSkywalkReverseTick_counts w i (by omega) hn
  have z := compactSkywalkReverseExpand_counts w i
  simp only [compactReceiverTick,show i≠511 by omega,if_false,toffoliCount_append,
    measurementCount_append,z.1,z.2,r.1,r.2,compactSkywalkTick_ah w i (by omega),wireBlock_length]
  rw [old.1,old.2]
  have nn : 2≤compactSkywalkTickPostWidth i := by
    unfold compactSkywalkTickPostWidth narrowSkywalkWidth
    omega
  omega

end ECDSAAdd.Entrant.W.ReverseCarry

end
section
-- ===== BundleReverseCarrySlots =====

set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
namespace ECDSAAdd.Entrant.W.ReverseCarry
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.Arithmetic.MappedCompressed ECDSAAdd.Challenge ECDSAAdd.Baselines

theorem receiverAdd_slots (x y carry : List Wire) (cin : Wire)
    (hx : x.length=y.length) (hc : carry.length+1=y.length) :
    gateSlots (receiverAdd x y carry cin) ≤ gateSlots (addInPlace x y carry cin) := by
  induction y generalizing x carry cin with
  | nil => simp at hc
  | cons b bs ih =>
    cases x with
    | nil => simp at hx
    | cons a as =>
      cases bs with
      | nil =>
        have ha : as=[] := List.eq_nil_of_length_eq_zero (by simpa using hx)
        have hk : carry=[] := List.eq_nil_of_length_eq_zero (by simpa using hc)
        subst as; subst carry
        simp [receiverAdd,addInPlace]
      | cons y ys =>
        cases as with
        | nil => simp at hx
        | cons x xs =>
          cases carry with
          | nil => simp at hc
          | cons k ks =>
            cases ys with
            | nil =>
              have ha : xs=[] := List.eq_nil_of_length_eq_zero (by simpa using hx)
              have hk : ks=[] := List.eq_nil_of_length_eq_zero (by simpa using hc)
              subst xs; subst ks
              simp [receiverAdd,addInPlace,gateSlots_append,gateSlots_cons,gateSlots_nil,
                instructionSlots,majority_gateSlots,eraseCarry_gateSlots]
            | cons z zs =>
              have hrec := ih (x::xs) ks k (by simpa using hx) (by simpa using hc)
              simp only [receiverAdd,List.cons_ne_nil,and_false,if_false,addInPlace,
                gateSlots_append,majority_gateSlots,eraseCarry_gateSlots,gateSlots_cons,
                gateSlots_nil,instructionSlots]
              omega

theorem receiverSub_slots (q : Wire) (x y carry : List Wire)
    (hx : x.length=y.length) (hc : carry.length+1=y.length) :
    gateSlots (receiverSub q x y carry) ≤ gateSlots (signedSub q x y carry) := by
  have h := receiverAdd_slots x y carry q hx hc
  simp only [receiverSub,signedSub,signedAdd,gateSlots_append]
  omega

theorem narrowReceiver_slots (L : NarrowSignedRecordLayout) (n : Nat) (hw : L.Widths n) :
    gateSlots (narrowReceiver L n) ≤ gateSlots (narrowSignedUnrecord L n) := by
  have v := L.views n hw
  have h := receiverSub_slots L.q L.xp L.yp L.carryLow
    (hw.x.trans hw.y.symm) (hw.carry.trans hw.y.symm)
  simp only [narrowReceiver,narrowSignedUnrecord,receiverUnrecord,signedUnrecord,
    v.1,v.2.1,v.2.2.1,v.2.2.2,gateSlots_append]
  omega

theorem receiverUntick_slots (L : SkywalkIntegerLayout) (n : Nat) (hv : L.Valid)
    (hn : 0<n) (hle : n≤L.half.length) :
    gateSlots (receiverUntick L n) ≤ gateSlots (narrowSkywalkUntick L n) := by
  have h := narrowReceiver_slots (narrowSkywalkRecordLayout L n) n
    (narrowSkywalkRecord_widths L hv n hn hle)
  simp only [receiverUntick,narrowSkywalkUntick,gateSlots_append]
  omega

theorem compactReceiverTick_slots (w : Nat → Wire) (i : Nat) (hi : i<512)
    (hn : (skywalkPoolWires w).Nodup) :
    gateSlots (compactReceiverTick w i) ≤ gateSlots (compactSkywalkReverseTick w i) := by
  by_cases last : i=511
  · subst i
    simp [compactReceiverTick]
  · have bounds := compactSkywalkTick_width_bounds i hi
    have h := receiverUntick_slots (compactSkywalkTickLayout w i) (compactSkywalkTickPostWidth i)
      (compactSkywalkTick_valid w i hi hn) (by omega)
      (by rw [compactSkywalkTick_half w i hi,wireBlock_length]; omega)
    simp only [compactReceiverTick,last,if_false,compactSkywalkReverseTick,gateSlots_append]
    omega


end ECDSAAdd.Entrant.W.ReverseCarry

end
section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Stack5
open Arithmetic Secp256k1 History5
attribute [local irreducible] run W.compactSkywalkTick W.compactSkywalkReverseTick W.repairedTick
  W.ReverseCarry.compactReceiverTick History5.encodePrefix

/-- Replacing a local program transfers from one witness state to every caller
that agrees on its actual support, including the complete phase increment. -/
theorem local_replace (P Q : Program) (sites : Finset Wire)
    (hP : wires P ⊆ sites) (hQ : wires Q ⊆ sites)
    (s raw : State) (m n : List Bool)
    (read : ∀ q∈sites,s.basis q=raw.basis q)
    (eq : run P m raw=run Q n raw) : run P m s=run Q n s := by
  have a := run_local_increment P s raw m (fun q hq => read q (hP hq))
  have b := run_local_increment Q s raw n (fun q hq => read q (hQ hq))
  apply State.extensionality
  · have phase := congrArg State.phase eq
    rw [phase] at a
    have e := a.1.trans b.1.symm
    exact Bool.xor_left_inj.mp e
  · funext q
    by_cases hp : q∈wires P
    · have ea := a.2 q hp
      by_cases hq : q∈wires Q
      · exact ea.trans ((congrArg (fun t : State => t.basis q) eq).trans (b.2 q hq).symm)
      · rw [run_preserves_outside Q n s q hq,ea]
        rw [congrArg (fun t : State => t.basis q) eq,run_preserves_outside Q n raw q hq]
        exact (read q (hP hp)).symm
    · rw [run_preserves_outside P m s q hp]
      by_cases hq : q∈wires Q
      · rw [b.2 q hq,←congrArg (fun t : State => t.basis q) eq,
          run_preserves_outside P m raw q hp]
        exact read q (hQ hq)
      · rw [run_preserves_outside Q n s q hq]

 theorem prefix_disjoint_layout (w : Nat → Wire)
    (hn : (skywalkPoolWires w).Nodup) (n i : Nat) (hni : n ≤ i) (hi : i < 512) :
    Disjoint (wires (History5.encodePrefix w n)) (W.compactSkywalkTickLayout w i).wires.toFinset := by
  induction n with
  | zero => simp [History5.encodePrefix,wires]
  | succ n ih =>
    have prior := ih (by omega)
    have current : Disjoint (wires (History5.packAfter w n))
        (W.compactSkywalkTickLayout w i).wires.toFinset := by
      cases due : History5.packDue n
      · simp [History5.packAfter,due,wires]
      · have bounds := History5.packDue_true n due
        apply Finset.disjoint_left.mpr
        intro q hq ht
        simp only [History5.packAfter,due,if_true] at hq
        obtain ⟨j,rfl⟩ := History5.history_gate_mem w (n-5) _ (Or.inl rfl) q hq
        exact W.historyId_away_compactTick w hn (n-5) i (by omega) (by omega) hi j
          (List.mem_toFinset.mp ht)
    simp only [History5.encodePrefix,wires_append,Finset.disjoint_union_left]
    exact ⟨prior,current⟩

theorem repaired_eq5 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512)
    (s : State) (m n : List Bool) (hs : W.CompressedCompactStage5 w x p i s.basis) :
    run (W.repairedTick w i) m s=run (W.compactSkywalkTick w i) n s := by
  obtain ⟨raw,hraw,hbits⟩ := hs
  have dis := prefix_disjoint_layout w hn i i (Nat.le_refl i) hi
  have read : ∀q∈(W.compactSkywalkTickLayout w i).wires.toFinset,s.basis q=raw.basis q := by
    intro q hq
    rw [hbits]
    exact run_preserves_outside _ _ _ q (fun he => Finset.disjoint_left.mp dis he hq)
  have old := W.compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx hc hi
  have recordEq : run (W.compactSkywalkTick w i) [] raw=run (W.compactSkywalkTick w i) n raw := by
    apply State.extensionality
    · exact (old raw [] hraw).1.trans (old raw n hraw).1.symm
    · exact run_basis_records _ raw raw [] n rfl
  exact local_replace _ _ _ (W.repairedTick_support w i hi hn)
    (W.compactSkywalkTick_support w i hi hn) s raw m n read
    ((W.repairedTick_eq w hn x p i hp0 hx0 hpo hp hq hx hc hi raw m hraw).trans recordEq)


/-- A circuit without measurements ignores every record list. -/
theorem records_zero (P : Program) (hz : measurementCount P=0) (s : State) (m n : List Bool) :
    run P m s=run P n s := by
  rw [←run_take P m,←run_take P n,hz,List.take_zero,List.take_zero]

def forward5 (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => W.repairedTick w i++History5.packAfter w i++forward5 w (i+1) n

def reverse5 (w : Nat → Wire) (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => reverse5 w (i+1) n++History5.decodeBefore w i++W.ReverseCarry.compactReceiverTick w i

attribute [local irreducible] forward5 reverse5 W.compactForward5 W.compactReverse5

theorem tick_pack_legal (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0<p) (hx0 : 0<x) (hpo : p%2=1)
    (hp : p<2^256) (hq : p+2^32≤2^256) (hx : x<p) (cop : x.Coprime p) (hi : i<512)
    (s : State) (m : List Bool) (hs : W.CompressedCompactStage5 w x p i s.basis)
    (due : History5.packDue i=true) :
    MeasuredCodec5.legalAt (History5.historyMap w (i-5)) (run (W.compactSkywalkTick w i) m s).basis := by
  obtain ⟨raw,hraw,hbits⟩ := hs
  let next := run (W.compactSkywalkTick w i) [] raw
  have ns := W.compactSkywalkStageStep w hn x p i hp0 hx0 hpo hp hq hx cop hi raw [] hraw
  have layoutDis := prefix_disjoint_layout w hn i i (Nat.le_refl i) hi
  have dis : Disjoint (wires (History5.encodePrefix w i)) (wires (W.compactSkywalkTick w i)) :=
    Finset.disjoint_left.mpr (fun _ he ht => Finset.disjoint_left.mp layoutDis he (W.compactSkywalkTick_support w i hi hn ht))
  have commute := run_disjoint_commute (History5.encodePrefix w i) (W.compactSkywalkTick w i) dis [] [] raw
  have same := run_basis_records (W.compactSkywalkTick w i) s (run (History5.encodePrefix w i) [] raw) m [] hbits
  have bits : (run (W.compactSkywalkTick w i) m s).basis=(run (History5.encodePrefix w i) [] next).basis :=
    same.trans (congrArg State.basis commute.symm)
  have hd := History5.packDue_true i due
  have legal := W.stage_group_legal w hn x p (i+1) (i-5) hp0 hpo (by omega) (by omega) next.basis ns.2
  rw [bits]
  exact History5.prefix_next_legal w hn i hi due next [] legal

theorem step_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512)
    (s : State) (m n : List Bool) (hs : W.CompressedCompactStage5 w x p i s.basis) :
    run (W.repairedTick w i++History5.packAfter w i) m s=
      run (W.compactSkywalkTick w i++History5.packAfter w i) n s := by
  rw [run_append,run_append]
  rw [repaired_eq5 w hn x p i hp0 hx0 hpo hp hq hx hc hi s
    (m.take (measurementCount (W.repairedTick w i)))
    (n.take (measurementCount (W.compactSkywalkTick w i))) hs]
  cases due : History5.packDue i
  · simp only [History5.packAfter,due,Bool.false_eq_true,if_false,run]
  · have hd := History5.packDue_true i due
    have legal := tick_pack_legal w hn x p i hp0 hx0 hpo hp hq hx hc hi s
      (n.take (measurementCount (W.compactSkywalkTick w i))) hs due
    simp only [History5.packAfter,due,if_true,History5.encode]
    exact MeasuredCodec5.encodeAt_independent _ (History5.historyMap_injective w hn (i-5) (by omega)) _
      (m.drop (measurementCount (W.repairedTick w i)))
      (n.drop (measurementCount (W.compactSkywalkTick w i))) legal

theorem forward_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : History5.HistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (n : Nat) : ∀i,i+n ≤ 512 → ∀(s : State)(m k : List Bool),
    W.CompressedCompactStage5 w x p i s.basis →
    run (forward5 w i n) m s=run (W.compactForward5 w i n) k s := by
  induction n with
  | zero => intro i hi s m k hs; simp only [forward5,W.compactForward5,run]
  | succ n ih =>
    intro i hi s m k hs
    have e := step_eq w hn x p i hp0 hx0 hpo hp hq hx hc (by omega) s
      (m.take (measurementCount (W.repairedTick w i++History5.packAfter w i)))
      (k.take (measurementCount (W.compactSkywalkTick w i++History5.packAfter w i))) hs
    have next := (W.compactStage5_step w hn hlo x p i hp0 hx0 hpo hp hq hx hc (by omega)
      s (k.take (measurementCount (W.compactSkywalkTick w i++History5.packAfter w i))) hs).2
    have e1 : forward5 w i (n+1)=(W.repairedTick w i++History5.packAfter w i)++forward5 w (i+1) n := by
      rw [forward5]
    have e2 : W.compactForward5 w i (n+1)=(W.compactSkywalkTick w i++History5.packAfter w i)++W.compactForward5 w (i+1) n := by
      rw [W.compactForward5]
    rw [e1,e2]
    conv_lhs => rw [run_append]
    conv_rhs => rw [run_append]
    rw [e]
    exact ih (i+1) (by omega) _ _ _ next

end ECDSAAdd.Entrant.Stack5
end

section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Stack5
open Arithmetic Secp256k1 History5
attribute [local irreducible] run W.repairedTick W.compactSkywalkTick W.compactSkywalkReverseTick
  W.ReverseCarry.compactReceiverTick History5.encodePrefix forward5 reverse5

theorem step_spec (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512) :
    Triple (W.CompressedCompactStage5 w x p i) (W.repairedTick w i++History5.packAfter w i)
      (W.CompressedCompactStage5 w x p (i+1)) := by
  intro s m hs
  rw [step_eq w hn x p i hp0 hx0 hpo hp hq hx hc hi s m [] hs]
  exact W.compactStage5_step w hn hlo x p i hp0 hx0 hpo hp hq hx hc hi s [] hs

theorem oneStep_roundtrip (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (x p i : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (hi : i < 512)
    (t : State) (ht : W.CompressedCompactStage5 w x p i t.basis) (m1 m2 : List Bool) :
    run (History5.decodeBefore w i++W.ReverseCarry.compactReceiverTick w i) m2
      (run (W.repairedTick w i++History5.packAfter w i) m1 t)=t := by
  rw [step_eq w hn x p i hp0 hx0 hpo hp hq hx hc hi t m1 [] ht]
  obtain ⟨raw,hraw,hbits⟩ := ht
  have dis := prefix_disjoint_layout w hn i i (Nat.le_refl i) hi
  have read : ∀q∈(W.compactSkywalkTickLayout w i).wires,t.basis q=raw.basis q := by
    intro q hmem
    rw [hbits]
    exact run_preserves_outside _ _ _ q
      (fun he => Finset.disjoint_left.mp dis he (List.mem_toFinset.mpr hmem))
  have loc := W.compactSkywalkStage_local_input w hn x p i hp0 hx0 hpo hp hq hx hc hi raw hraw
  have hv := W.compactSkywalkTick_valid w i hi hn
  have hh : t.basis (W.compactSkywalkTickLayout w i).history=false := by
    rw [read _ (by simp [SkywalkIntegerLayout.wires])]
    exact loc.2.2.2.2.1
  have clean : regValue (W.compactSkywalkTickLayout w i).carry t.basis=0 := by
    rw [regValue_congr _ t.basis raw.basis (by
      intro q hmem
      exact read q (by simp only [SkywalkIntegerLayout.wires,List.mem_append,List.mem_cons]; tauto))]
    exact loc.2.2.2.2.2
  have rt := W.ReverseCarry.compactReceiverTick_roundtrip w i hi hn t []
    (m2.drop (measurementCount (History5.decodeBefore w i))) hh clean
  have dp : run (History5.decodeBefore w i) (m2.take (measurementCount (History5.decodeBefore w i)))
      (run (History5.packAfter w i) [] (run (W.compactSkywalkTick w i) [] t))=
        run (W.compactSkywalkTick w i) [] t := by
    cases due : History5.packDue i
    · simp only [History5.packAfter,History5.decodeBefore,due,Bool.false_eq_true,if_false,run]
    · have hd := History5.packDue_true i due
      have legal := tick_pack_legal w hn x p i hp0 hx0 hpo hp hq hx hc hi t [] ⟨raw,hraw,hbits⟩ due
      simpa only [History5.packAfter,History5.decodeBefore,due,if_true,History5.encode,History5.decode] using
        MeasuredCodec5.roundtripAt (History5.historyMap w (i-5))
          (History5.historyMap_injective w hn (i-5) (by omega)) _ [] _ legal
  rw [run_append,run_append]
  simp only [List.take_nil,List.drop_nil]
  rw [dp]
  exact rt

end ECDSAAdd.Entrant.Stack5
end

section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Stack5
open Arithmetic Secp256k1 History5 Challenge Baselines
attribute [local irreducible] forward5 reverse5 W.compactForward5 W.compactReverse5
  W.repairedTick W.compactSkywalkTick W.compactSkywalkReverseTick

def reverseSave (i : Nat) : Nat := if i < 511 then 1 else 0
def reverseCount (i : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => reverseSave i+reverseCount (i+1) n

theorem reverseTick_counts (w : Nat → Wire) (i : Nat) (hi : i<512)
    (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (W.ReverseCarry.compactReceiverTick w i)+reverseSave i=
      toffoliCount (W.compactSkywalkReverseTick w i) ∧
    measurementCount (W.ReverseCarry.compactReceiverTick w i)=measurementCount (W.compactSkywalkReverseTick w i) := by
  by_cases last : i=511
  · subst i
    simp only [W.ReverseCarry.compactReceiverTick,if_true,reverseSave,lt_self_iff_false,if_false,Nat.add_zero,and_self]
  · have h := W.ReverseCarry.compactReceiverTick_counts w i (by omega) hn
    simpa only [reverseSave,if_pos (show i<511 by omega)] using h

theorem counts_relative (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    toffoliCount (forward5 w i n)+W.repairCount i n=toffoliCount (W.compactForward5 w i n) ∧
    measurementCount (forward5 w i n)=measurementCount (W.compactForward5 w i n)+W.repairCount i n ∧
    toffoliCount (reverse5 w i n)+reverseCount i n=toffoliCount (W.compactReverse5 w i n) ∧
    measurementCount (reverse5 w i n)=measurementCount (W.compactReverse5 w i n) := by
  induction n generalizing i with
  | zero => simp [forward5,reverse5,W.compactForward5,W.compactReverse5,W.repairCount,reverseCount]
  | succ n ih =>
    have f := W.repairedTick_counts w i (by omega) hn
    have r := reverseTick_counts w i (by omega) hn
    have tail := ih (i+1) (by omega)
    simp only [forward5,reverse5,W.compactForward5,W.compactReverse5,toffoliCount_append,
      measurementCount_append,W.repairCount,reverseCount]
    omega

theorem counts_511 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (forward5 w 1 511)+255=toffoliCount (W.compactForward5 w 1 511) ∧
    measurementCount (forward5 w 1 511)=measurementCount (W.compactForward5 w 1 511)+255 ∧
    toffoliCount (reverse5 w 1 511)+510=toffoliCount (W.compactReverse5 w 1 511) ∧
    measurementCount (reverse5 w 1 511)=measurementCount (W.compactReverse5 w 1 511) := by
  have r : reverseCount 1 511=510 := by decide +kernel
  simpa only [W.repair_count_511,r] using counts_relative w hn 1 511 (by omega)

theorem layout_support5 (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (i : Nat) (hi : i<512) :
    (W.compactSkywalkTickLayout w i).wires.toFinset ⊆ History5.integerSites5 w := by
  intro q hq
  have member := List.mem_toFinset.mp hq
  have pool := W.compactSkywalkTick_local_support w i hi member
  simp only [skywalkPoolWires,wireBlock,List.mem_map,List.mem_range'_1] at pool
  obtain ⟨j,hj,rfl⟩ := pool
  apply (History5.integerSites5_mem w (w j)).mpr
  refine ⟨j,by omega,?_,rfl⟩
  by_cases small : j<515
  · exact Or.inl small
  · exact Or.inr (by
      by_contra bad
      exact W.compactTick_middle_unused w hn i hi j (by omega) (by omega) member)

theorem support (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    wires (forward5 w i n) ⊆ History5.integerSites5 w ∧
    wires (reverse5 w i n) ⊆ History5.integerSites5 w := by
  induction n generalizing i with
  | zero => simp [forward5,reverse5,wires]
  | succ n ih =>
    have lay := layout_support5 w hn i (by omega)
    have f := (W.repairedTick_support w i (by omega) hn).trans lay
    have r := (W.ReverseCarry.compactReceiverTick_support w i (by omega) hn).trans lay
    have codec := History5.pack_support5 w i (by omega)
    have tail := ih (i+1) (by omega)
    simp only [forward5,reverse5,wires_append,Finset.union_subset_iff]
    exact ⟨⟨⟨f,codec.1⟩,tail.1⟩,⟨⟨tail.2,codec.2⟩,r⟩⟩

theorem slots_le (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (i n : Nat) (hi : i+n ≤ 512) :
    gateSlots (forward5 w i n) ≤ n*6204 ∧ gateSlots (reverse5 w i n) ≤ n*6204 := by
  induction n generalizing i with
  | zero => simp [forward5,reverse5,gateSlots]
  | succ n ih =>
    have f := W.repairedTick_slots w i (by omega) hn
    have r := W.ReverseCarry.compactReceiverTick_slots w i (by omega) hn
    have old := W.compactTick_gateSlots_le w i (by omega)
    have codec := History5.pack_gateSlots5 w i
    have tail := ih (i+1) (by omega)
    simp only [forward5,reverse5,gateSlots_append,Nat.succ_mul]
    omega

end ECDSAAdd.Entrant.Stack5
end

section
set_option maxRecDepth 8192
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Stack5
open Arithmetic Secp256k1 History5
attribute [local irreducible] run forward5 reverse5 W.compactForward5 W.compactReverse5

theorem roundtrip (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup) (hlo : History5.HistoryAbove w)
    (x p : Nat) (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1)
    (hp : p < 2^256) (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p) (n : Nat) :
    ∀i,i+n ≤ 512 → ∀(s : State)(mf mr : List Bool),
    W.CompressedCompactStage5 w x p i s.basis →
    run (reverse5 w i n) mr (run (forward5 w i n) mf s)=s := by
  induction n with
  | zero => intro i hi s mf mr hs; simp only [forward5,reverse5,run]
  | succ n ih =>
    intro i hi s mf mr hs
    have next := (step_spec w hn hlo x p i hp0 hx0 hpo hp hq hx hc (by omega) s
      (mf.take (measurementCount (W.repairedTick w i++History5.packAfter w i))) hs).2
    have e1 : forward5 w i (n+1)=(W.repairedTick w i++History5.packAfter w i)++forward5 w (i+1) n := by
      rw [forward5]
    have e2 : reverse5 w i (n+1)=reverse5 w (i+1) n++
        (History5.decodeBefore w i++W.ReverseCarry.compactReceiverTick w i) := by
      rw [reverse5,List.append_assoc]
    rw [e2,run_append]
    conv in (run (forward5 w i (n+1)) mf s) => rw [e1,run_append]
    rw [ih (i+1) (by omega) _ _ _ next]
    exact oneStep_roundtrip w hn x p i hp0 hx0 hpo hp hq hx hc (by omega) s hs _ _

theorem forward_old_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : History5.HistoryAbove w) (x p : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1) (hp : p < 2^256)
    (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (s : State) (mNew mOld : List Bool)
    (hs : Arithmetic.CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis) :
    run (forward5 w 1 511) mNew s=run (History5.compactForward5 w 1 511) mOld s := by
  have first := W.compactStage5_first w x p s ((W.compactSkywalkStage_one w _ s.basis).mpr hs)
  exact (forward_eq w hn hlo x p hp0 hx0 hpo hp hq hx hc 511 1 (by omega) s mNew mOld first).trans
    (W.compactForward5_old_eq w hn hlo x p hp0 hx0 hpo hp hq hx hc s mOld mOld hs)

theorem reverse_eq (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (hlo : History5.HistoryAbove w) (x p : Nat)
    (hp0 : 0 < p) (hx0 : 0 < x) (hpo : p%2=1) (hp : p < 2^256)
    (hq : p+2^32 ≤ 2^256) (hx : x < p) (hc : x.Coprime p)
    (s v : State) (mf mr : List Bool)
    (hs : W.CompactSkywalkStage w (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s.basis)
    (pool : ∀q∈skywalkPoolWires w,v.basis q=(run (forward5 w 1 511) mf s).basis q) :
    run (reverse5 w 1 511) mr v=run (W.compactReverse5 w 1 511) mr v := by
  have first := W.compactStage5_first w x p s hs
  have eq := forward_eq w hn hlo x p hp0 hx0 hpo hp hq hx hc 511 1 (by omega) s mf [] first
  have final := (W.compactForward5_spec w hn hlo x p 1 511 hp0 hx0 hpo hp hq hx hc (by omega) s [] first).2
  have old := W.tail_restore_pool5 w hn hlo x p hp0 hx0 hpo hp hq hx hc s
    (run (W.compactForward5 w 1 511) [] s) mr hs final
  have new := roundtrip w hn hlo x p hp0 hx0 hpo hp hq hx hc 511 1 (by omega) s mf mr first
  have oldEq : run (W.compactReverse5 w 1 511) mr (run (forward5 w 1 511) mf s)=s := by
    rw [eq]
    apply State.extensionality
    · exact old.1.trans (W.compactForward5_spec w hn hlo x p 1 511 hp0 hx0 hpo hp hq hx hc
        (by omega) s [] first).1
    · funext q
      by_cases hq : q∈skywalkPoolWires w
      · exact old.2.1 q hq
      · rw [old.2.2 q hq,W.compactForward5_frame w hn 1 511 (by omega) s [] q hq]
  exact local_replace _ _ (skywalkPoolWires w).toFinset
    ((support w hn 1 511 (by omega)).2.trans (History5.integerSites5_pool w))
    ((W.compactReverse5_support w hn 1 511 (by omega)).trans (History5.integerSites5_pool w))
    v (run (forward5 w 1 511) mf s) mr mr
    (fun q hq => pool q (List.mem_toFinset.mp hq)) (new.trans oldEq.symm)

end ECDSAAdd.Entrant.Stack5
end

-- ===== ECDSAAdd.Submission.Entrant.OBSigma5 =====
section

/-! Late-sign placement, adapted from accepted submission12159df8-70b5-4718-9aef-847528abd574,
commit b2d461e7c85fef3e9360d1c5bfbb237687ee2578 (OBSigma/OBInteger).
The integer programs use the local five-trit codec. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OB5
open Arithmetic MappedCompressed Secp256k1 History5

def sig (i : Nat) (q : Wire) : Wire :=
  if (1301 ≤ q ∧ q ≤ 1044+i) ∨ (2069 ≤ q+i ∧ q ≤ 1812) then 3113-q else q

/-- Forward integer ticks `i .. i+n-1`, tick `k` placed by `sig k`. -/
def forward (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => renameProgram (sig i) (W.compactSkywalkTick base i ++ packAfter base i) ++
      forward (i+1) n

/-- Reverse integer ticks, untick `k` placed by `sig k`. -/
def reverse (i : Nat) : Nat → Program
  | 0 => []
  | n+1 => reverse (i+1) n ++
      renameProgram (sig i) (decodeBefore base i ++ W.compactSkywalkReverseTick base i)




def sigNat (i q : Nat) : Nat :=
  if (1301 ≤ q ∧ q ≤ 1044+i) ∨ (2069 ≤ q+i ∧ q ≤ 1812) then 3113-q else q

theorem sig_nat (i : Nat) (q : Wire) : sig i q = sigNat i q := rfl

theorem sig_invol (i : Nat) (hi : i ≤ 511) (q : Wire) : sig i (sig i q) = q := by
  show sigNat i (sigNat i q) = (q : Nat)
  unfold sigNat
  split_ifs <;> omega

theorem sig_injective (i : Nat) (hi : i ≤ 511) : Function.Injective (sig i) := by
  intro a b h
  rw [← sig_invol i hi a, ← sig_invol i hi b, h]

theorem sig_zero (q : Wire) : sig 0 q = q := by
  show sigNat 0 q = (q : Nat)
  unfold sigNat
  split_ifs <;> omega

theorem sig_base (k l : Nat) (hk : k ≤ 511) : sig k (base l) =
    base (if (1285 ≤ l ∧ l ≤ 1028+k) ∨ (2053 ≤ l+k ∧ l ≤ 1796) then 3081-l else l) := by
  show sigNat k (l+16) =
    ((if (1285 ≤ l ∧ l ≤ 1028+k) ∨ (2053 ≤ l+k ∧ l ≤ 1796) then 3081-l else l) + 16 : Nat)
  unfold sigNat
  split_ifs <;> omega

/-- Consecutive placements differ only on the two exchanged sites of tick `i`. -/
theorem sigNat_step (i : Nat) (hi : i ≤ 511) (q : Nat) :
    sigNat (i-1) q = sigNat i q ∨
    (257 ≤ i ∧ (sigNat (i-1) q = 1044+i ∨ sigNat (i-1) q = 2069-i) ∧
      (sigNat i q = 1044+i ∨ sigNat i q = 2069-i)) := by
  unfold sigNat
  split_ifs <;> omega

theorem pull_invol (i : Nat) (hi : i ≤ 511) (s : State) :
    pullState (sig i) (pullState (sig i) s) = s := by
  apply State.extensionality
  · rfl
  · funext q
    show s.basis (sig i (sig i q)) = s.basis q
    rw [sig_invol i hi]

/-- A block renamed by `sig i` acts on the placed state as the block on the
logical state. -/
theorem run_rename (i : Nat) (hi : i ≤ 511) (P : Program) (m : List Bool) (t : State) :
    run (renameProgram (sig i) P) m (pullState (sig i) t) =
      pullState (sig i) (run P m t) := by
  have h := ECDSAAdd.run_rename (sig i) (sig_injective i hi) P m (pullState (sig i) t)
  rw [pull_invol i hi t] at h
  rw [← h, pull_invol i hi]

/-- The placement change before tick `i` is gate-free when its two sites are clean. -/
theorem pull_step (i : Nat) (hi : i ≤ 511) (t : State)
    (h1 : t.basis (base (1028+i)) = false) (h2 : 257 ≤ i → t.basis (base (2053-i)) = false) :
    pullState (sig (i-1)) t = pullState (sig i) t := by
  apply State.extensionality
  · rfl
  · funext q
    show t.basis (sig (i-1) q) = t.basis (sig i q)
    have b1 : base (1028+i) = 1044+i := by show 1028+i+16 = 1044+i; omega
    have b2 : base (2053-i) = 2069-i := by show 2053-i+16 = 2069-i; omega
    rw [b1] at h1
    rw [b2] at h2
    rw [sig_nat, sig_nat]
    rcases sigNat_step i hi q with e | ⟨big, e1, e2⟩
    · rw [e]
    · have z2 := h2 big
      rcases e1 with e1 | e1 <;> rcases e2 with e2 | e2 <;> rw [e1, e2] <;> simp only [h1, z2]


end ECDSAAdd.Entrant.OB5

end


-- ===== ECDSAAdd.Submission.Entrant.FieldFrameOB5 =====
section

/-! Five-trit field frames after the final late-sign placement.
The logical frame is pulled through sig511. Physical retired carries can
hold history; clean-site claims apply only to the moved zero region. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1500000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.FieldFrameOB5
open Arithmetic Secp256k1 BalancedField MappedCompressed CompressedFieldSupport
open OffsetBorrowedCanonical History5
attribute [local irreducible] run wires

def EncodedFieldFrame (origin : BasisState) (X Y : Fp) (s : State) : Prop :=
  EncodedFieldFrame5 base (base 2409) origin X Y (pullState (OB5.sig 511) s)

def EncodedCanonicalFrame (origin : BasisState) (X Y : Fp) (s : State) : Prop :=
  EncodedCanonicalFrame5 origin X Y (pullState (OB5.sig 511) s)

















/-- Transport the complete logical field contract through sig511. -/
theorem placed_step (P : Program) (origin : BasisState) (X Y A B : Fp)
    (correct : ∀s m, EncodedFieldFrame5 base (base 2409) origin X Y s →
      (run P m s).phase=s.phase ∧ EncodedFieldFrame5 base (base 2409) origin A B (run P m s))
    (s : State) (m : List Bool) (input : EncodedFieldFrame origin X Y s) :
    (run (renameProgram (OB5.sig 511) P) m s).phase=s.phase ∧
      EncodedFieldFrame origin A B (run (renameProgram (OB5.sig 511) P) m s) := by
  have result := correct (pullState (OB5.sig 511) s) m input
  have same := ECDSAAdd.run_rename (OB5.sig 511) (OB5.sig_injective 511 (by decide)) P m s
  rw [←same] at result
  exact result






















/-- The one-bank parity site is outside every history codec. -/
theorem otherEncode_parity_away (w : Nat → Wire)
    (hn : (skywalkSharedWires w).Nodup) (n j : Nat) (bound : 5*n≤512) :
    w 2312∉wires (otherEncode w j n) := by
  intro member
  obtain ⟨k,hk,_,used⟩ := otherEncode_member w n j (w 2312) member
  obtain ⟨r,eq⟩ := history_gate_mem w (5*k) _ (Or.inl rfl) (w 2312) used
  have b := historyId_bound (5*k) (by omega) r
  have same := skywalkShared_index_inj w hn 2312 (historyId (5*k) r) (by omega) (by omega) eq
  omega

theorem otherEncode_body_disjoint (w : Nat → Wire) (b sign eff : Wire)
    (hn : (skywalkSharedWires w).Nodup)
    (hb : b∉skywalkPoolWires w) (hs : sign∉skywalkPoolWires w) (he : eff∉skywalkPoolWires w)
    (n j : Nat) (bound : 5*n≤512) (hj : j<n) (body : Program)
    (support : wires body⊆History5.groupReadSites w b sign eff (5*j) ∪ {w 2312}) :
    Disjoint (wires (otherEncode w j n)) (wires body) := by
  have old := History5.otherEncode_body_disjoint w b sign eff hn hb hs he n j bound hj
  apply Finset.disjoint_left.mpr
  intro q hq used
  rcases Finset.mem_union.mp (support used) with h|h
  · have one : wires [.X q]⊆History5.groupReadSites w b sign eff (5*j) := by
      intro t ht
      have same : t=q := by simpa [wires,Instr.wires] using ht
      exact same ▸ h
    exact Finset.disjoint_left.mp (old [.X q] one) hq (by simp [wires,Instr.wires])
  · have same : q=w 2312 := Finset.mem_singleton.mp h
    exact otherEncode_parity_away w hn n j bound (same ▸ hq)

/-- Codec transport with the additional real parity site2312. -/
theorem encoded_window_step (w : Nat → Wire) (b sign eff : Wire)
    (hn : (skywalkSharedWires w).Nodup)
    (hp : ∀q∈[b,sign,eff],q∉skywalkPoolWires w)
    (j : Nat) (hj : j<102) (origin : BasisState) (X Y A B : Fp) (body : Program)
    (support : wires body⊆History5.groupReadSites w b sign eff (5*j) ∪ {w 2312})
    (correct : Triple (PairFrame (balancedSharedPorts w sign).r (balancedSharedPorts w sign).y
      origin (centerWord X) (centerWord Y)) body
      (PairFrame (balancedSharedPorts w sign).r (balancedSharedPorts w sign).y
        origin (centerWord A) (centerWord B)))
    (s : State) (m : List Bool) (input : EncodedFieldFrame5 w sign origin X Y s)
    (legal : RawLegal w 102 origin) :
    let out := run (decode w (5*j)++body++encode w (5*j)) m s
    out.phase=s.phase ∧ EncodedFieldFrame5 w sign origin A B out := by
  obtain ⟨raw,phase,frame,eq⟩ := input
  have pool := skywalkShared_integer_nodup w hn
  have leg := frame_history_legal w sign hn (hp sign (by simp)) 102 (by decide)
    origin raw.basis _ _ legal frame
  have factor := allEncode_factor w pool 102 j (by decide) hj raw
  have hE := otherEncode_disjoint w pool 102 j (by decide) hj
  have hB := otherEncode_body_disjoint w b sign eff hn
    (hp b (by simp)) (hp sign (by simp)) (hp eff (by simp)) 102 j (by decide) hj body support
  let mb := m.drop 2
  let rawOut := run body mb raw
  have result := correct raw mb frame
  have outLeg := frame_history_legal w sign hn (hp sign (by simp)) 102 (by decide)
    origin rawOut.basis _ _ legal result.2
  have transport := window_transport_other w (5*j) pool (by omega)
    (otherEncode w j 102) body hE hB raw [] [] (m.take 2) mb (mb.drop (measurementCount body)) (leg j hj)
  have records : run (encode w (5*j)) (mb.drop (measurementCount body)) rawOut=
      run (encode w (5*j)) [] rawOut :=
    MeasuredCodec5.encodeAt_independent _ (historyMap_injective w pool _ (by omega)) _ _ _ (outLeg j hj)
  rw [records] at transport
  have back := allEncode_factor w pool 102 j (by decide) hj rawOut
  rw [←back] at transport
  have actual : run (decode w (5*j)++body++encode w (5*j)) m s=run (allEncode w 102) [] rawOut := by
    rw [eq,factor]
    simp only [List.append_assoc]
    rw [run_append,(decode_counts w (5*j)).2,run_append,run_take]
    exact transport
  dsimp only
  rw [actual]
  have encPhase := allEncode_zero_phase w pool 102 (by decide) rawOut
  exact ⟨encPhase.trans (result.1.trans phase),rawOut,encPhase.symm,result.2,rfl⟩


theorem pull_swap_zero (a b : Wire) (s : State)
    (ha : s.basis a=false) (hb : s.basis b=false) : pullState (Equiv.swap a b) s=s := by
  apply State.extensionality
  · rfl
  · funext q
    change s.basis (Equiv.swap a b q)=s.basis q
    by_cases ea : q=a
    · subst q; simp only [Equiv.swap_apply_left,ha,hb]
    · by_cases eb : q=b
      · subst q; simp only [Equiv.swap_apply_right,ha,hb]
      · rw [Equiv.swap_apply_of_ne_of_ne ea eb]

/-- Rebind two clean sites without changing the complete State or phase. -/
theorem rebind_swap_run (a b : Wire) (P : Program) (s : State) (m : List Bool)
    (ha : s.basis a=false) (hb : s.basis b=false)
    (oa : (run P m s).basis a=false) (ob : (run P m s).basis b=false) :
    run (renameProgram (Equiv.swap a b) P) m s=run P m s := by
  apply pullState_perm_injective (Equiv.swap a b)
  rw [run_rename _ (Equiv.swap a b).injective,pull_swap_zero a b s ha hb,
    pull_swap_zero a b (run P m s) oa ob]

end ECDSAAdd.Entrant.FieldFrameOB5

end


-- ===== ECDSAAdd.Submission.Entrant.OB5Support =====
section

/-! Physical support images for the one-bank five-cell history placement. Every use of
`placed_support` requires support and exclusions for the emitted instructions. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1500000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.OB5Support
open Arithmetic MappedCompressed ControlledPointLayout

/-- The retired signs and old repair flag are absent. The parity site1800 is present. -/
def poolSites (L : ControlledPointLayout) : List Wire :=
  wireBlock L.core.poolWire 0 515 ++ wireBlock L.core.poolWire 717 312 ++ wireBlock L.core.poolWire 1284 257 ++
    [L.core.poolWire 1800]

/-- Raw arithmetic uses one control and the two coordinate words. -/
def sites (L : ControlledPointLayout) : List Wire :=
  L.core.generic :: L.point.x ++ L.point.y ++ poolSites L









theorem pool_mem (L : ControlledPointLayout) (i : Nat)
    (hi : i  <  515 ∨ (717  ≤  i ∧ i  <  1029) ∨ (1284  ≤  i ∧ i  <  1541) ∨ i=1800) :
    L.core.poolWire i ∈ poolSites L := by
  simp only [poolSites,List.mem_append,wireBlock,List.mem_map,List.mem_range'_1,List.mem_singleton]
  rcases hi with h | h | h | h
  · exact Or.inl (Or.inl (Or.inl ⟨i,by omega,rfl⟩))
  · exact Or.inl (Or.inl (Or.inr ⟨i,by omega,rfl⟩))
  · exact Or.inl (Or.inr ⟨i,by omega,rfl⟩)
  · exact Or.inr (h ▸ rfl)

theorem pool_in_sites (L : ControlledPointLayout) (q : Wire) (hq : q ∈ poolSites L) : q ∈ sites L := by
  simp [sites, hq]












/-- Exact image of an actually used logical wire. The repair-flag exclusion is separate from the older metadata exclusion theorem. -/
theorem wire_image (L : ControlledPointLayout) (hw : L.Widths) (old : Wire)
    (hslot : old ∈ Placement5.slots.toFinset) (hgood : goodW old)
    (hrepair : old ≠ base 2411) (hretired : old  <  base 1285 ∨ base 1540  ≤  old)
    (hsel : old ≠ base 2409 ∧ old ≠ base 2410) :
    pointWireFn L (swap2 old) ∈ (sites L).toFinset := by
  obtain ⟨i, hi, rfl⟩ :=  List.mem_map.mp (List.mem_toFinset.mp hslot)
  have bad : i ≠ 769 ∧ i ≠ 2313 ∧ ¬(2401  ≤  i ∧ i  ≤  2408) := by
    simpa only [goodW, base, Nat.add_right_cancel_iff, Nat.add_le_add_iff_right, not_or] using hgood
  have repair : i ≠ 2411 := by intro e; subst i; exact hrepair rfl
  have retired : i  <  1285 ∨ 1540  ≤  i := by simpa only [base,Nat.add_lt_add_iff_right,Nat.add_le_add_iff_right] using hretired
  apply List.mem_toFinset.mpr
  by_cases endBit : i = 1797
  · subst i
    rw [show swap2 (base 1797) = base 769 by simp [swap2, base], pointWireFn_base]
    change L.core.poolWire 769 ∈ sites L
    exact pool_in_sites L _ (pool_mem L 769 (Or.inr (Or.inl ⟨by omega, by omega⟩)))
  by_cases parity : i=2312
  · subst i
    rw [show swap2 (base 2312)=base 2312 by simp [swap2,base],pointWireFn_base]
    change L.core.poolWire 1800 ∈ sites L
    exact pool_in_sites L _ (pool_mem L 1800 (Or.inr (Or.inr (Or.inr rfl))))
  have fix : swap2 (base i) = base i :=  swap2_fix _
    (fun e  => bad.1 (base_injective e)) (fun e  => endBit (base_injective e))
  rw [fix, pointWireFn_base]
  simp only [Placement5.indices, List.mem_append, List.mem_range'_1] at hi
  by_cases shared : i  <  2314
  · have range : i  <  515 ∨ (717  ≤  i ∧ i  <  1285) ∨ (1540  ≤  i ∧ i  <  1797) ∨ (2056  ≤  i ∧ i  <  2312) := by omega
    rw [pointIndexWire_shared L i shared]
    change skywalkPointWire L.core.poolWire L.point.x L.point.y i ∈ sites L
    unfold skywalkPointWire
    by_cases hx : 770  ≤  i ∧ i  <  1026
    · rw [if_pos hx]
      have hx' : i-770  <  L.point.x.length := by rw [show L.point.x.length = 256 from hw.inputX]; omega
      have mem : L.point.x.getD (i-770) 0 ∈ L.point.x := by
        rw [List.getD_eq_getElem _ _ hx']
        exact List.getElem_mem hx'
      simp only [sites, List.mem_cons, List.mem_append]
      exact Or.inl (Or.inl (Or.inr mem))
    · rw [if_neg hx]
      by_cases hy : 2056  ≤  i ∧ i  <  2312
      · rw [if_pos hy]
        have hy' : i-2056  <  L.point.y.length := by rw [show L.point.y.length = 256 from hw.inputY]; omega
        have mem : L.point.y.getD (i-2056) 0 ∈ L.point.y := by
          rw [List.getD_eq_getElem _ _ hy']
          exact List.getElem_mem hy'
        simp only [sites, List.mem_cons, List.mem_append]
        exact Or.inl (Or.inr mem)
      · rw [if_neg hy]
        apply pool_in_sites
        apply pool_mem
        have noHigh : ¬2312  ≤  i := by omega
        rw [if_neg noHigh, Nat.sub_zero]
        by_cases afterX : 1026  ≤  i
        · rw [if_pos afterX]
          omega
        · rw [if_neg afterX, Nat.sub_zero]
          omega
  · have hmeta : i = 2400 ∨ i = 2409 ∨ i = 2410 := by omega
    rcases hmeta with rfl | rfl | rfl
    · change L.core.generic ∈ sites L
      simp [sites]
    · exact absurd rfl hsel.1
    · exact absurd rfl hsel.2

/-- This theorem applies to an emitted program, including its corrections;
it does not derive instruction support from the declared inventory. -/
theorem placed_support (L : ControlledPointLayout) (hw : L.Widths) (P : Program)
    (hslots : wires P ⊆ Placement5.slots.toFinset)
    (hgood : ∀q ∈ wires P, goodW q)
    (hrepair : base 2411∉wires P)
    (hretired : ∀q∈wires P,q  <  base 1285 ∨ base 1540  ≤  q)
    (hsel : ∀q∈wires P, q ≠ base 2409 ∧ q ≠ base 2410) :
    wires (renameProgram (wireFn2 L) P) ⊆ (sites L).toFinset := by
  rw [renameProgram_support]
  intro q hq
  obtain ⟨old, used, rfl⟩ :=  Finset.mem_image.mp hq
  exact wire_image L hw old (hslots used) (hgood old used)
    (fun e  => hrepair (e ▸ used)) (hretired old used) (hsel old used)

/-- Tight logical support: metadata-only declarations are not used. -/
def logicalIndices : List Nat :=
  List.range' 0 515 ++ List.range' 717 52 ++ List.range' 770 515 ++ List.range' 1540 258 ++
    List.range' 2056 257 ++ [2400]

def logicalSites : Finset Wire := (logicalIndices.map base).toFinset

/-- Field-segment sites before selector hosting: the selectors are present, and the
two host labels 511 and 1542 are absent. -/
def segIndices : List Nat :=
  List.range' 0 511 ++ List.range' 512 3 ++ List.range' 717 52 ++ List.range' 770 515 ++
    [1540, 1541] ++ List.range' 1543 255 ++ List.range' 2056 257 ++ [2400, 2409, 2410]

def segSites : Finset Wire := (segIndices.map base).toFinset

theorem seg_host_free : base 511 ∉ segSites ∧ base 1542 ∉ segSites := by
  constructor <;> intro h <;>
  · obtain ⟨i, hi, he⟩ := List.mem_map.mp (List.mem_toFinset.mp h)
    have := base_injective he
    subst this
    simp only [segIndices, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
      or_false] at hi
    omega

theorem logical_nosel (q : Wire) (hq : q ∈ logicalSites) : q ≠ base 2409 ∧ q ≠ base 2410 := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  simp only [logicalIndices, List.mem_append, List.mem_range'_1, List.mem_cons, List.not_mem_nil,
    or_false] at hi
  constructor <;> intro e <;> have := base_injective e <;> omega



theorem logical_sub_slots : logicalSites ⊆ Placement5.slots.toFinset := by
  intro q hq
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  apply List.mem_toFinset.mpr
  apply List.mem_map.mpr
  refine ⟨i, ?_, rfl⟩
  simp only [logicalIndices, Placement5.indices, List.mem_append, List.mem_range'_1,
    List.mem_cons, List.not_mem_nil, or_false] at hi ⊢
  omega

theorem logical_good (q : Wire) (hq : q ∈ logicalSites) : goodW q := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  simp only [logicalIndices, List.mem_append, List.mem_range'_1,
    List.mem_cons, List.not_mem_nil, or_false] at hi
  apply ECDSAAdd.Entrant.base_good
  unfold badIdx
  omega

theorem logical_norepair : base 2411 ∉ logicalSites := by
  intro hq
  obtain ⟨i, hi, eq⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  have same := base_injective eq
  simp only [logicalIndices, List.mem_append, List.mem_range'_1,
    List.mem_cons, List.not_mem_nil, or_false] at hi
  omega

theorem logical_retired (q : Wire) (hq : q ∈ logicalSites) : q  <  base 1285 ∨ base 1540  ≤  q := by
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hq)
  simp only [logicalIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false] at hi
  change i+16  <  1285+16 ∨ 1540+16  ≤  i+16
  omega

/-- One instruction-support premise discharges all placement exclusions. -/
theorem placed_support_logical (L : ControlledPointLayout) (hw : L.Widths) (P : Program)
    (hP : wires P ⊆ logicalSites) :
    wires (renameProgram (wireFn2 L) P) ⊆ (sites L).toFinset :=
  placed_support L hw P (hP.trans logical_sub_slots)
    (fun q hq => logical_good q (hP hq))
    (fun hq => logical_norepair (hP hq)) (fun q hq => logical_retired q (hP hq))
    (fun q hq => logical_nosel q (hP hq))

theorem prefixSites_sub_logical : (NativeFirstDirect.prefixSites base).toFinset ⊆ logicalSites := by
  intro q hq
  simp only [NativeFirstDirect.prefixSites,List.mem_toFinset,List.mem_append,List.mem_cons,
    List.not_mem_nil,or_false,wireBlock,List.mem_map,List.mem_range'_1] at hq
  rcases hq with ((h | h) | h) | (rfl | rfl)
  all_goals first
    | obtain ⟨i,hi,rfl⟩ := h
      apply List.mem_toFinset.mpr
      apply List.mem_map.mpr
      refine ⟨i, ?_, rfl⟩
      simp only [logicalIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false]
      omega
    | apply List.mem_toFinset.mpr
      apply List.mem_map.mpr
      refine ⟨_, ?_, rfl⟩
      simp only [logicalIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false]
      omega

theorem clear_support_logical : wires (skywalkArithmeticClear base) ⊆ logicalSites := by
  intro q hq
  rw [skywalkArithmeticClear,skywalkTerminalClear_wires] at hq
  simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hq
  rcases hq with rfl | rfl | rfl
  all_goals
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨_, ?_, rfl⟩
    simp only [logicalIndices,List.mem_append,List.mem_range'_1,List.mem_cons,List.not_mem_nil,or_false]
    omega


/-- Physical sites used by a full generic body, including finite-bit repair. -/
def genericSites (L : ControlledPointLayout) : List Wire :=
  PointAddLayout.pointWires L.point ++ [L.core.generic] ++ poolSites L





theorem raw_sub_generic (L : ControlledPointLayout) : (sites L).toFinset⊆(genericSites L).toFinset := by
  intro q hq
  simp only [sites,genericSites,PointAddLayout.pointWires,List.mem_toFinset,List.mem_append,
    List.mem_cons,List.not_mem_nil,or_false] at hq ⊢
  tauto

theorem pool_index (L : ControlledPointLayout) (q : Wire) (hq : q∈poolSites L) :
    ∃i,(i < 515 ∨ (717 ≤ i ∧ i < 1029) ∨ (1284 ≤ i ∧ i < 1541) ∨ i=1800) ∧ q=L.core.poolWire i := by
  simp only [poolSites,List.mem_append,wireBlock,List.mem_map,List.mem_range'_1,List.mem_singleton] at hq
  rcases hq with ((⟨i,hi,eq⟩ | ⟨i,hi,eq⟩) | ⟨i,hi,eq⟩) | eq
  · exact ⟨i,Or.inl (by omega),eq.symm⟩
  · exact ⟨i,Or.inr (Or.inl (by omega)),eq.symm⟩
  · exact ⟨i,Or.inr (Or.inr (Or.inl (by omega))),eq.symm⟩
  · exact ⟨1800,Or.inr (Or.inr (Or.inr rfl)),eq⟩

end ECDSAAdd.Entrant.OB5Support

end


-- ===== ECDSAAdd.Submission.Entrant.HalfFieldOB5 =====
section

/-! One-bank endpoints reuse the checked half-field programs. Clean-boundary
permutations move their carry bank and flag; no placement gates are emitted. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.HalfFieldOB5
open Arithmetic Secp256k1 BalancedField MappedCompressed OffsetBorrowedCanonical History5
attribute [local irreducible] run wires History5.allEncode

private def bankFn (i : Nat) : Nat :=
  if 512 ≤ i ∧ i < 767 then i+1028 else if 1540 ≤ i ∧ i < 1795 then i-1028 else i

private theorem bank_invol : Function.Involutive bankFn := by
  intro i
  unfold bankFn
  split_ifs  <;> omega

def bank : Equiv.Perm Nat := ⟨bankFn,bankFn,bank_invol,bank_invol⟩
def relocate : Equiv.Perm Wire :=
  (shifted bank).trans ((shifted (Placement5.pi 51)).trans (Equiv.swap (base 1796) (base 1285)))
def endpointMap : Equiv.Perm Wire := relocate.trans
  ⟨OB5.sig 511,OB5.sig 511,OB5.sig_invol 511 (by decide),OB5.sig_invol 511 (by decide)⟩

def centerT : Program := renameProgram endpointMap HalfField5.centerT
def canonT : Program := renameProgram endpointMap HalfField5.canonT
abbrev copyN := HalfField5.copyN

private def BankRegion (i : Nat) : Prop := (512 ≤ i ∧ i < 767) ∨ (1540 ≤ i ∧ i < 1795)

private theorem bank_fix (i : Nat) (h : ¬BankRegion i) : bank i=i := by
  change bankFn i=i
  simp only [BankRegion,not_or] at h
  simp [bankFn,h.1,h.2]

private theorem shifted_bank_zero (s : State) (hz : ∀i,BankRegion i → s.basis (base i)=false) :
    pullState (shifted bank) s=s := by
  apply State.extensionality
  · rfl
  · funext q
    change s.basis (shifted bank q)=s.basis q
    by_cases small : q < 16
    · change s.basis (shiftedFn bank q)=s.basis q
      simp only [shiftedFn,if_pos small]
    · have e : q=base (q-16) := by change q=q-16+16; exact (Nat.sub_add_cancel (Nat.le_of_not_gt small)).symm
      rw [e,shifted_base]
      by_cases inside : BankRegion (q-16)
      · have mapped : BankRegion (bank (q-16)) := by
          by_contra outside
          have eq := bank.injective (bank_fix _ outside)
          exact outside (eq.symm ▸ inside)
        exact (hz _ mapped).trans (hz _ inside).symm
      · rw [bank_fix _ inside]

private theorem env_bank (origin : BasisState) (env : Env base origin) (i : Nat)
    (hi : BankRegion i ∨ i=1796) : origin (base i)=false := by
  rcases hi with (h|h)|h
  · exact OffsetCleanupBorrowedCaller.maskBit_zero base origin env.1 i (by omega) (by omega)
  · have mem := DirectSkywalk.arith_mem base 1540 257 i (by omega) (by omega)
    exact (regValue_zero _ _).mp env.1 _ (by
      simp [skywalkSharedField,ModInPlaceLayout.work,ModAddCoreLayout.work,mem])
  · subst i
    have mem := DirectSkywalk.arith_mem base 1540 257 1796 (by omega) (by omega)
    exact (regValue_zero _ _).mp env.1 _ (by
      simp [skywalkSharedField,ModInPlaceLayout.work,ModAddCoreLayout.work,mem])

private theorem encoder_away (i : Nat) (hi : BankRegion i ∨ i=1796) :
    base i∉wires (History5.allEncode base 102) := by
  intro h
  have mem := List.mem_toFinset.mp (allEncode_history_support base 102 (by decide) h)
  simp only [List.mem_append,wireBlock,List.mem_map,List.mem_range'_1] at mem
  rcases mem with ⟨j,hj,eq⟩|⟨j,hj,eq⟩
  all_goals
    have same := base_injective eq
    unfold BankRegion at hi
    omega

private theorem frame_banks (origin : BasisState) (env : Env base origin) (s raw : State)
    (encoded : s=run (History5.allEncode base 102) [] raw)
    (keep : ∀i,BankRegion i ∨ i=1796 → raw.basis (base i)=origin (base i)) :
    (∀i,BankRegion i → s.basis (base i)=false) ∧ s.basis (base 1796)=false := by
  have z (i : Nat) (hi : BankRegion i ∨ i=1796) : s.basis (base i)=false := by
    rw [encoded]
    exact (run_preserves_outside _ [] raw _ (encoder_away i hi)).trans
      ((keep i hi).trans (env_bank origin env i hi))
  exact ⟨fun i hi => z i (Or.inl hi),z 1796 (Or.inr rfl)⟩

private theorem canonical_banks (origin : BasisState) (env : Env base origin)
    (X : Fp) (s : State) (frame : EncodedCanonicalFrame5 origin X 0 s) :
    (∀i,BankRegion i → s.basis (base i)=false) ∧ s.basis (base 1796)=false := by
  obtain ⟨raw,_,f,e⟩ := frame
  apply frame_banks origin env s raw e
  intro i hi
  apply f.2.2
  · intro mem
    rw [skywalkShared_field_z] at mem
    simp only [wireBlock,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,
      List.mem_map,List.mem_range'_1] at mem
    unfold BankRegion at hi
    obtain ⟨j,hj,eq⟩ := mem
    have same := base_injective eq
    omega
  · intro mem
    change base i∈wireBlock base 770 257 at mem
    obtain ⟨j,hj,eq⟩ := List.mem_map.mp mem
    simp only [List.mem_range'_1] at hj
    have same := base_injective eq
    unfold BankRegion at hi
    omega

private theorem field_banks (origin : BasisState) (env : Env base origin)
    (X Y : Fp) (s : State) (frame : EncodedFieldFrame5 base (base 2409) origin X Y s) :
    (∀i,BankRegion i → s.basis (base i)=false) ∧ s.basis (base 1796)=false := by
  obtain ⟨raw,_,f,e⟩ := frame
  apply frame_banks origin env s raw e
  intro i hi
  apply f.2.2
  all_goals
    intro mem
    simp only [balancedSharedPorts_r,balancedSharedPorts_y] at mem
    obtain ⟨j,hj,eq⟩ := List.mem_map.mp mem
    simp only [List.mem_range'_1] at hj
    have same := base_injective eq
    unfold BankRegion at hi
    omega

private theorem canonical_zero (hn : (skywalkSharedWires base).Nodup) (origin : BasisState)
    (env : Env base origin) (legal : RawLegal base 102 origin)
    (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (frame : EncodedCanonicalFrame5 origin X 0 s) :
    ∀q,Placement5.zeroRegion q → s.basis (base q)=false := by
  intro q hq
  have before := HalfField5.encodedCanonical_pool_basis5 hn origin ha X s frame
  have pool : base q∈skywalkPoolWires base := by
    apply List.mem_map.mpr
    refine ⟨q,?_,rfl⟩
    simp only [List.mem_range'_1]
    rcases hq with h|h
    · unfold Placement5.workRegion at h; omega
    · unfold Placement5.holeRegion at h; omega
  rw [before _ pool]
  rcases hq with work|hole
  · exact (run_preserves_outside _ [] ({phase:=false,basis:=origin}:State) _
      (encoder_away q (Or.inl (Or.inl (by unfold Placement5.workRegion at work; omega))))).trans
      (env_bank origin env q (Or.inl (Or.inl (by unfold Placement5.workRegion at work; omega))))
  · have recover := Placement5.hole_recover q hole
    rw [←recover.2]
    exact allEncode_holes_zero base base_pool_nodup ({phase:=false,basis:=origin}:State) [] legal
      (Placement5.holeIndex q) recover.1

private theorem relocation_eq (P : Program) (s : State) (m : List Bool)
    (b0 : ∀i,BankRegion i → s.basis (base i)=false)
    (b1 : ∀i,BankRegion i → (run P m s).basis (base i)=false)
    (z0 : ∀i,Placement5.zeroRegion i → s.basis (base i)=false)
    (z1 : ∀i,Placement5.zeroRegion i → (run P m s).basis (base i)=false)
    (f0 : s.basis (base 1796)=false) (f1 : (run P m s).basis (base 1796)=false) :
    run (renameProgram relocate P) m s=run P m s := by
  have bankRun : run (renameProgram (shifted bank) P) m s=run P m s := by
    apply pullState_perm_injective (shifted bank)
    rw [run_rename _ (shifted bank).injective,shifted_bank_zero s b0,shifted_bank_zero _ b1]
  have piRun : run (renameProgram (shifted (Placement5.pi 51))
      (renameProgram (shifted bank) P)) m s=run P m s := by
    apply pullState_perm_injective (shifted (Placement5.pi 51))
    rw [run_rename _ (shifted (Placement5.pi 51)).injective,
      Placement5.shifted_zero_boundary _ (Placement5.pi_outside 51 · (by decide)) s z0,
      bankRun,Placement5.shifted_zero_boundary _ (Placement5.pi_outside 51 · (by decide)) _ z1]
  have hole : Placement5.zeroRegion 1285 := by right; unfold Placement5.holeRegion; decide
  have swapRun := FieldFrameOB5.rebind_swap_run (base 1796) (base 1285)
    (renameProgram (shifted (Placement5.pi 51)) (renameProgram (shifted bank) P)) s m
    f0 (z0 _ hole) (by rw [piRun]; exact f1) (by rw [piRun]; exact z1 _ hole)
  simpa only [relocate,Equiv.trans_apply,renameProgram_comp] using swapRun.trans piRun

attribute [local irreducible] HalfField.centerT HalfField.canonT
set_option maxHeartbeats 30000

theorem logical_center_eq (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2409∉skywalkPoolWires base) (origin : BasisState)
    (env : Env base origin) (legal : RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (m : List Bool) (input : EncodedCanonicalFrame5 origin X 0 s) :
    run (renameProgram relocate HalfField5.centerT) m s=run HalfField5.centerT m s := by
  have c := HalfField5.center_frame hn origin env.1 env.2.1 hr env.2.2 X s m input
  have a := canonical_banks origin env X s input
  have b := field_banks origin env _ _ _ c.2
  exact relocation_eq HalfField5.centerT s m a.1 b.1 (canonical_zero hn origin env legal ha X s input)
    (History5.encoded_zero_region base (base 2409) hn ho origin env legal _ _ _ c.2) a.2 b.2

theorem logical_canon_eq (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2409∉skywalkPoolWires base) (origin : BasisState)
    (env : Env base origin) (legal : RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (m : List Bool)
    (input : EncodedFieldFrame5 base (base 2409) origin X 0 s) :
    run (renameProgram relocate HalfField5.canonT) m s=run HalfField5.canonT m s := by
  have c := HalfField5.canon_frame hn origin env.1 env.2.1 hr env.2.2 X s m input
  have a := field_banks origin env _ _ _ input
  have b := canonical_banks origin env _ _ c.2
  exact relocation_eq HalfField5.canonT s m a.1 b.1
    (History5.encoded_zero_region base (base 2409) hn ho origin env legal _ _ _ input)
    (canonical_zero hn origin env legal ha _ _ c.2) a.2 b.2

private theorem endpointMap_rename (P : Program) :
    renameProgram endpointMap P=renameProgram (OB5.sig 511) (renameProgram relocate P) := by
  change renameProgram ((OB5.sig 511) ∘ relocate) P=_
  exact (renameProgram_comp (OB5.sig 511) relocate P).symm

private theorem center_eq : centerT=renameProgram (OB5.sig 511)
    (renameProgram relocate HalfField5.centerT) := endpointMap_rename _

private theorem canon_eq : canonT=renameProgram (OB5.sig 511)
    (renameProgram relocate HalfField5.canonT) := endpointMap_rename _

private theorem placed_step (e : Wire → Wire) (he : Function.Injective e) (P : Program)
    (I O : State → Prop)
    (correct : ∀s m,I s → (run P m s).phase=s.phase ∧ O (run P m s))
    (s : State) (m : List Bool) (input : I (pullState e s)) :
    (run (renameProgram e P) m s).phase=s.phase ∧ O (pullState e (run (renameProgram e P) m s)) := by
  have c := correct (pullState e s) m input
  have same := ECDSAAdd.run_rename e he P m s
  rw [←same] at c
  exact c

attribute [local irreducible] relocate endpointMap

theorem center_frame (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2409∉skywalkPoolWires base) (origin : BasisState)
    (env : Env base origin) (legal : RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedCanonicalFrame origin X 0 s) :
    (run centerT m s).phase=s.phase ∧
    FieldFrameOB5.EncodedFieldFrame origin (X/2) 0 (run centerT m s) := by
  have correct : ∀t records,EncodedCanonicalFrame5 origin X 0 t →
      (run (renameProgram relocate HalfField5.centerT) records t).phase=t.phase ∧
      EncodedFieldFrame5 base (base 2409) origin (X/2) 0
        (run (renameProgram relocate HalfField5.centerT) records t) := by
    intro t records hin
    rw [logical_center_eq hn ho origin env legal hr ha X t records hin]
    exact HalfField5.center_frame hn origin env.1 env.2.1 hr env.2.2 X t records hin
  have c := placed_step (OB5.sig 511) (OB5.sig_injective 511 (by decide))
    (renameProgram relocate HalfField5.centerT) _ _ correct s m input
  rw [←center_eq] at c
  exact c

theorem canon_frame (hn : (skywalkSharedWires base).Nodup)
    (ho : base 2409∉skywalkPoolWires base) (origin : BasisState)
    (env : Env base origin) (legal : RawLegal base 102 origin)
    (hr : origin (base 2312)=false) (ha : regValue (skywalkSharedField base).a origin=0)
    (X : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedFieldFrame origin X 0 s) :
    (run canonT m s).phase=s.phase ∧
    FieldFrameOB5.EncodedCanonicalFrame origin (2*X) 0 (run canonT m s) := by
  have correct : ∀t records,EncodedFieldFrame5 base (base 2409) origin X 0 t →
      (run (renameProgram relocate HalfField5.canonT) records t).phase=t.phase ∧
      EncodedCanonicalFrame5 origin (2*X) 0
        (run (renameProgram relocate HalfField5.canonT) records t) := by
    intro t records hin
    rw [logical_canon_eq hn ho origin env legal hr ha X t records hin]
    exact HalfField5.canon_frame hn origin env.1 env.2.1 hr env.2.2 X t records hin
  have c := placed_step (OB5.sig 511) (OB5.sig_injective 511 (by decide))
    (renameProgram relocate HalfField5.canonT) _ _ correct s m input
  rw [←canon_eq] at c
  exact c

theorem copyN_rename : renameProgram (OB5.sig 511) copyN=copyN := by
  have fixed (start len : Nat) (h : (770 ≤ start ∧ start+len ≤ 1026) ∨ (2056 ≤ start ∧ start+len ≤ 2312)) :
      (wireBlock base start len).map (OB5.sig 511)=wireBlock base start len := by
    calc
      (wireBlock base start len).map (OB5.sig 511)=(wireBlock base start len).map id := by
        apply List.map_congr_left
        intro q hq
        obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hq
        simp only [List.mem_range'_1] at hi
        rw [OB5.sig_base 511 i (by decide)]
        have outside : ¬((1285 ≤ i ∧ i ≤ 1028+511) ∨ (2053 ≤ i+511 ∧ i ≤ 1796)) := by omega
        simp only [if_neg outside,id_eq]
      _=wireBlock base start len := List.map_id _

  simp only [copyN,HalfField5.copyN,HalfField.copyN,FieldRename.copyRegister_natural,
    Option.map_none,HalfField.ports,balancedSharedPorts_r,balancedSharedPorts_y,
    fixed 2056 256 (Or.inr ⟨by omega,by omega⟩),fixed 770 256 (Or.inl ⟨by omega,by omega⟩)]

theorem copy_fill (hn : (skywalkSharedWires base).Nodup) (origin : BasisState)
    (X : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedFieldFrame origin X 0 s) :
    (run copyN m s).phase=s.phase ∧ FieldFrameOB5.EncodedFieldFrame origin X X (run copyN m s) := by
  have c := FieldFrameOB5.placed_step copyN origin X 0 X X
    (fun t records h => HalfField5.copy_fill hn origin X t records h) s m input
  rw [copyN_rename] at c
  exact c

theorem copy_clear (hn : (skywalkSharedWires base).Nodup) (origin : BasisState)
    (X : Fp) (s : State) (m : List Bool) (input : FieldFrameOB5.EncodedFieldFrame origin X X s) :
    (run copyN m s).phase=s.phase ∧ FieldFrameOB5.EncodedFieldFrame origin X 0 (run copyN m s) := by
  have c := FieldFrameOB5.placed_step copyN origin X X X 0
    (fun t records h => HalfField5.copy_clear hn origin X t records h) s m input
  rw [copyN_rename] at c
  exact c

attribute [local irreducible] toffoliCount measurementCount

theorem endpoint_counts : toffoliCount centerT=254 ∧ measurementCount centerT=254 ∧
    toffoliCount canonT=254 ∧ measurementCount canonT=254 := by
  have old : toffoliCount HalfField5.centerT=254 ∧ measurementCount HalfField5.centerT=254 ∧
      toffoliCount HalfField5.canonT=254 ∧ measurementCount HalfField5.canonT=254 := by
    simpa only [HalfField5.centerT,HalfField5.canonT,HalfField.centerT,HalfField.canonT] using
      HalfConvert.counts HalfField.tgt (balancedSharedTargetConvert_widths base)
  have a := renameProgram_counts endpointMap HalfField5.centerT
  have b := renameProgram_counts endpointMap HalfField5.canonT
  exact ⟨a.1.trans old.1,a.2.trans old.2.1,b.1.trans old.2.2.1,b.2.trans old.2.2.2⟩

theorem endpoint_physical (hn : (skywalkSharedWires base).Nodup) :
    GatePhysical centerT ∧ GatePhysical canonT ∧ GatePhysical copyN := by
  have old := HalfConvert.physical HalfField.tgt (balancedSharedTargetConvert_widths base)
    (balancedSharedTargetConvert_nodup base hn)
  have oldCenter : GatePhysical HalfField5.centerT := by
    simpa only [HalfField5.centerT,HalfField.centerT] using old.1
  have oldCanon : GatePhysical HalfField5.canonT := by
    simpa only [HalfField5.canonT,HalfField.canonT] using old.2
  exact ⟨gatePhysical_rename endpointMap endpointMap.injective _ oldCenter,
    gatePhysical_rename endpointMap endpointMap.injective _ oldCanon,
    copyRegister_physical none _ _ (balancedSharedLayout_pairND base (base 2409) hn) (by simp)⟩

theorem endpoint_gateSlots_le : Challenge.gateSlots centerT ≤ 6000 ∧
    Challenge.gateSlots canonT ≤ 6000 ∧ Challenge.gateSlots copyN ≤ 256 := by
  have a : Challenge.gateSlots HalfField5.centerT ≤ 6000 ∧ Challenge.gateSlots HalfField5.canonT ≤ 6000 :=
    HalfLane.convert_gateSlots_le
  have cp : Challenge.gateSlots copyN ≤ 256 := by
    simp only [copyN,HalfField5.copyN,HalfField.copyN,HalfField.ports,
      Baselines.copyRegister_gateSlots,balancedSharedPorts_r,wireBlock_length]
    omega
  exact ⟨by simpa only [centerT,Baselines.rename_gateSlots] using a.1,
    by simpa only [canonT,Baselines.rename_gateSlots] using a.2,cp⟩

end ECDSAAdd.Entrant.HalfFieldOB5

end


section
-- ===== OBBiasFwd =====
/-! Forward transcript cells around the single-bank biased kernel `BiasedCircuit.program`.
The kernel has the statement of `BalancedCircuit.program_correct`, so the cell, replay,
support and count facts are the public ones with the kernel substituted. -/
set_option maxHeartbeats 1000000
set_option maxRecDepth 8192
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant
open Arithmetic Arithmetic.BalancedField Secp256k1 Challenge Baselines

def biasedTranscriptBody (L : BalancedCircuit.Layout) (swap : Wire) : Program :=
  [.X L.sign] ++ BiasedCircuit.program L ++ [.X L.sign] ++
    swapRegisters swap L.r L.y

def biasedTranscriptCell (L : BalancedCircuit.Layout) (b g swap effS : Wire)
    (inactiveG inactiveS : Bool) : Program :=
  transcriptSelectWindow b g L.sign inactiveG
    (transcriptSelectWindow b swap effS inactiveS (biasedTranscriptBody L effS))

def biasedTranscriptReplay (L : BalancedCircuit.Layout) (b effS : Wire) :
    List MixedTranscriptLetter → Program
  | [] => []
  | l::ls => biasedTranscriptCell L b l.1.1 l.1.2 effS l.2.1 l.2.2 ++
    biasedTranscriptReplay L b effS ls

section Frames
attribute [local irreducible] centerWord

theorem bf_sign_away (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.sign∉L.r ∧ L.sign∉L.y := by
  have h := BalancedCircuit.flagAway L hn L.sign (by simp)
  exact ⟨fun hm => h (by simp [hm]),fun hm => h (by simp [hm])⟩

theorem bf_work_away (L : BalancedCircuit.Layout) (hn : L.wires.Nodup)
    (q : Wire) (hq : q∈BalancedCircuit.work L) : q∉L.r ∧ q∉L.y := by
  have nd := BalancedCircuit.allND L hn
  have h := List.nodup_iff_count.mp nd q
  have hw := List.count_pos_iff.mpr hq
  constructor <;> intro hd <;> have hc := List.count_pos_iff.mpr hd
  all_goals
    simp only [BalancedCircuit.work,List.count_append,List.count_cons,List.count_nil] at h hw
    omega

theorem bf_sign_work (L : BalancedCircuit.Layout) (hn : L.wires.Nodup) :
    L.sign∉BalancedCircuit.work L := by
  have nd : (L.sign::BalancedCircuit.work L).Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hn q
    simp only [BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,
      BalancedCircuit.work,List.count_append,List.count_cons,List.count_nil] at h ⊢
    omega
  exact (List.nodup_cons.mp nd).1

theorem bf_toggle_view (sign : Wire) (s : State) (m : List Bool) :
    let t := run [.X sign] m s
    t.phase=s.phase ∧ t.basis sign= !s.basis sign ∧
      ∀q,q≠sign → t.basis q=s.basis q := by
  simp only [run]
  refine ⟨True.intro,?_,?_⟩
  · simp only [writeBit,Function.update_self]
  · intro q hq
    simp only [writeBit,Function.update_of_ne hq]

/-- The sign-complement wrapper preserves the selected transcript exactly. -/
theorem biasedTranscriptHalf_frame (L : BalancedCircuit.Layout)
    (hw : L.Widths) (hn : L.wires.Nodup) (base : BasisState)
    (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      ([.X L.sign]++BiasedCircuit.program L++[.X L.sign])
      (PairFrame L.r L.y base (centerWord ((X+(if base L.sign then Y else -Y))/2))
        (centerWord Y)) := by
  intro s m h
  generalize eu : run [.X L.sign] m s=u
  have first := bf_toggle_view L.sign s m
  rw [eu] at first
  have sa := bf_sign_away L hn
  have uv (r : List Wire) (ha : L.sign∉r) : regValue r u.basis=regValue r s.basis :=
    regValue_congr r u.basis s.basis (fun q hq =>
      first.2.2 q (fun e => ha (e ▸ hq)))
  have us : u.basis L.sign= !base L.sign := by
    rw [first.2.1,h.2.2 L.sign sa.1 sa.2]
  have ur : signedRegValue L.r u.basis=centerFp X := by
    rw [signedRegValue,uv L.r sa.1,h.1,(BalancedCleanup.widths L.toLayout hw).2.1,centerWord_decode]
  have uy : signedRegValue L.y u.basis=centerFp Y := by
    rw [signedRegValue,uv L.y sa.2,h.2.1,(BalancedCleanup.widths L.toLayout hw).2.2.1,centerWord_decode]
  have uc : ∀q∈BalancedCircuit.work L,u.basis q=false := by
    intro q hq
    have away := bf_work_away L hn q hq
    have ns : q≠L.sign := fun e => bf_sign_work L hn (e ▸ hq)
    exact (first.2.2 q ns).trans ((h.2.2 q away.1 away.2).trans (hc q hq))
  generalize ev : run (BiasedCircuit.program L) m u=v
  have hv := BiasedCircuit.program_correct L hw hn (!base L.sign) (centerFp X) (centerFp Y)
    (centerFp_bounds X) (centerFp_bounds Y) u m us ur uy uc
  rw [ev] at hv
  have vv : regValue L.r v.basis=centerWord ((X+(if base L.sign then Y else -Y))/2) := by
    rw [hv.2.1,centeredFp_signedHalf]
    cases base L.sign <;> simp only [centerWord,Bool.not_false,Bool.not_true,if_true,if_false,Bool.false_eq_true]
  let tail := m.drop (measurementCount (BiasedCircuit.program L))
  generalize et : run [.X L.sign] tail v=t
  have last := bf_toggle_view L.sign v tail
  rw [et] at last
  have actual : run ([.X L.sign]++BiasedCircuit.program L++[.X L.sign]) m s=t := by
    simp only [List.append_assoc,run_append,run_take]
    simp only [show measurementCount [.X L.sign]=0 from rfl,List.drop_zero,Nat.zero_add,
      measurementCount_append]
    rw [eu,ev]
    exact et
  rw [actual]
  refine ⟨last.1.trans (hv.1.trans first.1),?_,?_,?_⟩
  · exact (regValue_congr _ _ _ (fun q hq =>
      last.2.2 q (fun e => sa.1 (e ▸ hq)))).trans vv
  · exact (regValue_congr _ _ _ (fun q hq => by
      have qr : q∉L.r := by
        have d := (List.nodup_append'.mp (List.nodup_append'.mp (BalancedCircuit.allND L hn)).2.1).1
        exact fun hr => List.disjoint_left.mp (List.nodup_append'.mp d).2.2 hr hq
      exact (last.2.2 q (fun e => sa.2 (e ▸ hq))).trans (hv.2.2.2 q qr))).trans
      ((uv L.y sa.2).trans h.2.1)
  · intro q qr qy
    by_cases qs : q=L.sign
    · subst q
      rw [last.2.1,hv.2.2.2 L.sign sa.1,us,Bool.not_not]
    · exact (last.2.2 q qs).trans ((hv.2.2.2 q qr).trans
        ((first.2.2 q qs).trans (h.2.2 q qr qy)))

theorem bf_swap_frame (r y : List Wire) (c : Wire)
    (hlen : r.length=y.length) (hn : (c::r++y).Nodup)
    (base : BasisState) (A B : Nat) :
    Triple (PairFrame r y base A B) (swapRegisters c r y)
      (PairFrame r y base (if base c then B else A) (if base c then A else B)) := by
  intro s m h
  have v := swapRegisters_correct c r y hlen hn s m
  have hc : c∉r ∧ c∉y := by
    have d := (List.nodup_cons.mp hn).1
    exact ⟨fun hm => d (List.mem_append_left _ hm),fun hm => d (List.mem_append_right _ hm)⟩
  have same := h.2.2 c hc.1 hc.2
  refine ⟨v.1,?_,?_,fun q qr qy => (v.2.1 q qr qy).trans (h.2.2 q qr qy)⟩
  · rw [v.2.2.1,same,h.1,h.2.1]
  · rw [v.2.2.2,same,h.1,h.2.1]

theorem biasedTranscriptBody_frame (L : BalancedCircuit.Layout) (effS : Wire)
    (hw : L.Widths) (hn : L.wires.Nodup) (hs : (effS::L.r++L.y).Nodup)
    (base : BasisState) (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      (biasedTranscriptBody L effS)
      (PairFrame L.r L.y base
        (centerWord (skywalkPayloadCell (base L.sign) (base effS) (X,Y)).1)
        (centerWord (skywalkPayloadCell (base L.sign) (base effS) (X,Y)).2)) := by
  have hh := biasedTranscriptHalf_frame L hw hn base hc X Y
  have len := BalancedCleanup.widths L.toLayout hw
  let T := (X+(if base L.sign then Y else -Y))/2
  have sw := bf_swap_frame L.r L.y effS (len.2.1.trans len.2.2.1.symm) hs
    base (centerWord T) (centerWord Y)
  have view : PairFrame L.r L.y base
      (centerWord (skywalkPayloadCell (base L.sign) (base effS) (X,Y)).1)
      (centerWord (skywalkPayloadCell (base L.sign) (base effS) (X,Y)).2)=
      PairFrame L.r L.y base (if base effS then centerWord Y else centerWord T)
        (if base effS then centerWord T else centerWord Y) := by
    cases e : base effS <;>
      simp only [skywalkPayloadCell,e,Bool.false_eq_true,if_true,if_false,T]
  rw [←view] at sw
  simpa only [biasedTranscriptBody] using hh.seq sw

theorem bf_selected_other (base : BasisState) (b source flag q : Wire) (v : Bool)
    (hne : q≠flag) : mixedTranscriptBase base b source flag v q=base q := by
  simp [mixedTranscriptBase,writeBit,Function.update,hne]

/-- Exact mixed selection around the physically emitted biased kernel. -/
theorem biasedTranscriptCell_frame (L : BalancedCircuit.Layout)
    (b g swap effS : Wire) (inactiveG inactiveS : Bool)
    (hl : BalancedTranscriptLayout L b g swap effS) (base : BasisState)
    (hg0 : base L.sign=false) (hs0 : base effS=false)
    (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      (biasedTranscriptCell L b g swap effS inactiveG inactiveS)
      (PairFrame L.r L.y base
        (centerWord (skywalkPayloadCell (mixedTranscriptBit base b g inactiveG)
          (mixedTranscriptBit base b swap inactiveS) (X,Y)).1)
        (centerWord (skywalkPayloadCell (mixedTranscriptBit base b g inactiveG)
          (mixedTranscriptBit base b swap inactiveS) (X,Y)).2)) := by
  let bg := mixedTranscriptBase base b g L.sign inactiveG
  let bs := mixedTranscriptBase bg b swap effS inactiveS
  have sg : [b,g,L.sign].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hl.controls q
    simp only [List.count_cons,List.count_nil] at h ⊢
    omega
  have ss : [b,swap,effS].Nodup := by
    apply List.nodup_iff_count.mpr
    intro q
    have h := List.nodup_iff_count.mp hl.controls q
    simp only [List.count_cons,List.count_nil] at h ⊢
    omega
  have d0 := List.nodup_cons.mp hl.controls
  have d1 := List.nodup_cons.mp d0.2
  have d2 := List.nodup_cons.mp d1.2
  have d3 := List.nodup_cons.mp d2.2
  have ne : effS≠L.sign := Ne.symm (by simpa using d3.1)
  have bn : b≠L.sign := by
    have h := (List.nodup_cons.mp sg).1
    intro e; exact h (by simp [e])
  have sn : swap≠L.sign := by
    intro e
    exact d2.1 (by simp [e])
  have bgS : bg effS=false := (bf_selected_other _ _ _ _ _ _ ne).trans hs0
  have bgB : bg b=base b := bf_selected_other _ _ _ _ _ _ bn
  have bgSwap : bg swap=base swap := bf_selected_other _ _ _ _ _ _ sn
  have bsG : bs L.sign=mixedTranscriptBit base b g inactiveG := by
    rw [show bs L.sign=bg L.sign from bf_selected_other _ _ _ _ _ _ (Ne.symm ne)]
    simp [bg,mixedTranscriptBase,writeBit]
  have bsS : bs effS=mixedTranscriptBit base b swap inactiveS := by
    simp [bs,mixedTranscriptBase,mixedTranscriptBit,writeBit,bgB,bgSwap]
  have clean : ∀q∈BalancedCircuit.work L,bs q=false := by
    intro q hq
    have qg : q≠L.sign := fun e => hl.scratch.1 (e ▸ hq)
    have qs : q≠effS := fun e => hl.scratch.2 (e ▸ hq)
    exact (bf_selected_other _ _ _ _ _ _ qs).trans
      ((bf_selected_other _ _ _ _ _ _ qg).trans (hc q hq))
  have body := biasedTranscriptBody_frame L effS hl.widths hl.kernel hl.swapND bs clean X Y
  rw [bsG,bsS] at body
  have inner := transcriptSelectWindow_pairFrame b swap effS inactiveS L.r L.y ss
    (hl.outside b (by simp)) (hl.outside swap (by simp))
    (hl.outside effS (by simp)) bg bgS (centerWord X) (centerWord Y) _ _ _ body
  exact transcriptSelectWindow_pairFrame b g L.sign inactiveG L.r L.y sg
    (hl.outside b (by simp)) (hl.outside g (by simp))
    (hl.outside L.sign (by simp)) base hg0 _ _ _ _ _ inner

/-- Every round has a full pair frame, including all quantum transcript controls. -/
theorem biasedTranscriptReplay_frame (L : BalancedCircuit.Layout) (b effS : Wire)
    (ls : List MixedTranscriptLetter) (hl : BalancedTranscriptReplayLayout L b effS ls)
    (base : BasisState) (hg0 : base L.sign=false) (hs0 : base effS=false)
    (hc : ∀q∈BalancedCircuit.work L,base q=false) (X Y : Fp) :
    Triple (PairFrame L.r L.y base (centerWord X) (centerWord Y))
      (biasedTranscriptReplay L b effS ls)
      (PairFrame L.r L.y base
        (centerWord (skywalkPayloadReplay (mixedTranscriptControls base b ls) (X,Y)).1)
        (centerWord (skywalkPayloadReplay (mixedTranscriptControls base b ls) (X,Y)).2)) := by
  induction ls generalizing X Y with
  | nil => intro s m h; exact ⟨rfl,h⟩
  | cons l ls ih =>
    let Q := skywalkPayloadCell (mixedTranscriptBit base b l.1.1 l.2.1)
      (mixedTranscriptBit base b l.1.2 l.2.2) (X,Y)
    have h1 := biasedTranscriptCell_frame L b l.1.1 l.1.2 effS l.2.1 l.2.2
      (hl l (by simp)) base hg0 hs0 hc X Y
    have h2 := ih (fun q hq => hl q (by simp [hq])) Q.1 Q.2
    simpa only [biasedTranscriptReplay,mixedTranscriptControls,List.map_cons,
      skywalkPayloadReplay,Q] using h1.seq h2

end Frames

theorem biasedTranscriptCell_counts (L : BalancedCircuit.Layout)
    (b g swap effS : Wire) (ig is : Bool) (hw : L.Widths)
    (hs : (effS::L.r++L.y).Nodup) :
    toffoliCount (biasedTranscriptCell L b g swap effS ig is)=1280 ∧
    measurementCount (biasedTranscriptCell L b g swap effS ig is)=1024 := by
  have w := BalancedCleanup.widths L.toLayout hw
  have sw := swapRegisters_resources effS L.r L.y (w.2.1.trans w.2.2.1.symm) hs
  have k := BiasedCircuit.counts L hw
  have si := transcriptSelectWindow_counts b swap effS is (biasedTranscriptBody L effS)
  have so := transcriptSelectWindow_counts b g L.sign ig
    (transcriptSelectWindow b swap effS is (biasedTranscriptBody L effS))
  simp only [biasedTranscriptCell,so.1,so.2,si.1,si.2]
  simp only [biasedTranscriptBody,toffoliCount_append,measurementCount_append,
    k.1,k.2,sw.1,sw.2.1,w.2.1]
  norm_num [toffoliCount,measurementCount]

/-! ## Support -/

theorem bf_select_support (b source flag : Wire) (v : Bool) (p : Program) :
    wires (transcriptSelectWindow b source flag v p)⊆
      [b,source,flag].toFinset ∪ wires p := by
  intro q hq
  cases v <;>
    simp only [transcriptSelectWindow,transcriptSelectCompute,transcriptSelectExpose,
      transcriptSelectErase,Bool.false_eq_true,if_false,if_true,List.nil_append,
      wires_append,Finset.mem_union,wires,Instr.wires,correctionWires,
      Finset.mem_insert,Finset.mem_singleton,Finset.notMem_empty,List.mem_toFinset,
      List.mem_cons,List.not_mem_nil] at hq ⊢ <;> tauto

theorem biasedCircuit_support (L : BalancedCircuit.Layout) (hw : L.Widths) :
    wires (BiasedCircuit.program L)⊆L.wires.toFinset := by
  intro q hq
  have h := BiasedCircuit.support L hw hq
  simp only [BiasedCircuit.activeWires,BalancedCircuit.Layout.wires,List.mem_toFinset,
    List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at h ⊢
  tauto

theorem biasedTranscriptBody_support (L : BalancedCircuit.Layout) (effS : Wire)
    (hw : L.Widths) : wires (biasedTranscriptBody L effS)⊆(effS::L.wires).toFinset := by
  have k := biasedCircuit_support L hw
  have sw := swapRegisters_wires effS L.r L.y
    ((BalancedCleanup.widths L.toLayout hw).2.1.trans
      (BalancedCleanup.widths L.toLayout hw).2.2.1.symm)
  intro q hq
  simp only [biasedTranscriptBody,wires_append,Finset.mem_union,or_assoc] at hq
  rcases hq with hq|hq|hq|hq
  · simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_singleton,Finset.notMem_empty,or_false] at hq
    simp [hq,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires]
  · simpa only [List.mem_toFinset,List.mem_cons] using Or.inr (List.mem_toFinset.mp (k hq))
  · simp only [wires,Instr.wires,Finset.mem_union,Finset.mem_singleton,Finset.notMem_empty,or_false] at hq
    simp [hq,BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires]
  · have h := sw hq
    simp only [List.mem_toFinset,List.mem_cons,List.mem_append,BalancedCircuit.Layout.wires,
      BalancedCleanup.Layout.wires,BalancedCleanup.Layout.r,BalancedCleanup.Layout.low,
      BalancedCleanup.Layout.y,List.not_mem_nil,or_false] at h ⊢
    tauto

theorem biasedTranscriptCell_support (L : BalancedCircuit.Layout)
    (b g swap effS : Wire) (ig is : Bool) (hw : L.Widths) :
    wires (biasedTranscriptCell L b g swap effS ig is)⊆
      ([b,g,swap,effS]++L.wires).toFinset := by
  have outer := bf_select_support b g L.sign ig
    (transcriptSelectWindow b swap effS is (biasedTranscriptBody L effS))
  have inner := bf_select_support b swap effS is (biasedTranscriptBody L effS)
  have body := biasedTranscriptBody_support L effS hw
  intro q hq
  have h := outer hq
  simp only [Finset.mem_union] at h
  rcases h with h|h
  · simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at h
    simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
    rcases h with h|h|h
    · simp [h]
    · simp [h]
    · right; simp [BalancedCircuit.Layout.wires,BalancedCleanup.Layout.wires,h]
  · have h := inner h
    simp only [Finset.mem_union] at h
    rcases h with h|h
    · simp only [List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at h ⊢
      simp only [List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
      tauto
    · have hb := body h
      simp only [List.mem_toFinset,List.mem_cons] at hb
      rcases hb with e|member
      · subst q
        simp only [List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil]
        exact Or.inl (Or.inr (Or.inr (Or.inr (Or.inl True.intro))))
      · simp only [List.mem_toFinset,List.mem_append]
        exact Or.inr member

/-! ## Relabeling naturality -/

section Natural
open FieldRename
