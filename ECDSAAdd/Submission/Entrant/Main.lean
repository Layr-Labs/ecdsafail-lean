  intro q hq
  obtain ⟨old, used, rfl⟩ := Finset.mem_image.mp hq
  exact List.mem_toFinset.mpr (swapE_sitesN L old
    (List.mem_toFinset.mp (renamedG L hw hn Gen hG used)))

