def history (j : Fin 26) (q:Fin 10) := OB5.sig (start j) (History5.historyMap base (start j-5) q)

theorem due (j : Fin 26) (h : 0≤j.val) : ¬start j=5 ∧ History5.packDue (start j)=true := by
