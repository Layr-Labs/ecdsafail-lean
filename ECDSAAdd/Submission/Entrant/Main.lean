private def tiles (last : Int) : Int → List (Int×Int) → Prop
  | first, [] => first=last+1
  | first, (a,b)::rest => a=first ∧ a≤b ∧ tiles last (b+1) rest

private instance tiles_decidable (last first : Int) (cells : List (Int×Int)) :
    Decidable (tiles last first cells) := by
  induction cells generalizing first with
  | nil => change Decidable (first=last+1); infer_instance
  | cons cell rest ih =>
    rcases cell with ⟨a,b⟩
    change Decidable (a=first ∧ a≤b ∧ tiles last (b+1) rest)
    haveI := ih (b+1)
    infer_instance

private theorem tiles_cover (last first k : Int) (cells : List (Int×Int))
    (checked : tiles last first cells) (hl : first≤k) (hh : k≤last) :
    ∃ cell∈cells,cell.1≤k ∧ k≤cell.2 := by
  induction cells generalizing first with
  | nil => change first=last+1 at checked; omega
  | cons cell rest ih =>
    rcases cell with ⟨a,b⟩
    rcases checked with ⟨rfl,hab,tail⟩
    by_cases hk : k≤b
    · exact ⟨(a,b),by simp,hl,hk⟩
    · obtain ⟨cell,member,lower,upper⟩ := ih (b+1) tail (by omega)
      exact ⟨cell,List.mem_cons_of_mem _ member,lower,upper⟩

private def firstK (r : Nat) : Int := if r=0 then 1 else 0
private def lastK (r : Nat) : Int := ((p:Int)-1-(r:Int))/32

/-- Finite arithmetic certificates; each sign/parity check covers its full interval. -/
private theorem intervals_checked : ∀r : Fin 32,
    tiles (lastK r.val) (firstK r.val) (intervals r.val) ∧
      ∀cell∈intervals r.val,
        traceOK cell.1 cell.2 5 (initial r.val) ∧
          traceWord (affineTrace cell.1 5 (initial r.val))∈Prefix1590Codec.rawWords := by
  decide +kernel

section
attribute [local irreducible] SkywalkTrace.trace SkywalkTrace.next SkywalkRails.step

private theorem traceWord_congr (a b : List (Bool×Bool))
    (same : ∀i<5,a.getD i (false,false)=b.getD i (false,false)) : traceWord a=traceWord b := by
  simp only [traceWord,same 0 (by decide),same 1 (by decide),same 2 (by decide),
    same 3 (by decide),same 4 (by decide)]

private theorem traceWord_firstFive (n : Nat) (hn : 5≤n) (r : SkywalkRails.State) :
    traceWord (SkywalkTrace.trace n r)=traceWord (SkywalkTrace.trace 5 r) := by
  apply traceWord_congr
  intro i hi
  rw [SkywalkTrace.trace_getD_code n r i (by omega) (false,false),
    SkywalkTrace.trace_getD_code 5 r i hi (false,false)]

private theorem initial_state_eq (r : Nat) (k x : Int)
    (decomposition : x=32*k+(r:Int)) :
    evalState (initial r) k=SkywalkRails.encode false false x (p:Int) := by
  apply SkywalkRails.State.ext
  · exact show 32*k+((r:Int)+(p:Int))=x+(p:Int) by omega
  · exact show 32*k+(r:Int)=x by omega
  · rfl

private theorem trace_domain_transport (a b : SkywalkRails.State) (same : a=b)
    (cs : List (Bool×Bool)) (semantic : SkywalkTrace.trace 5 a=cs)
    (member : traceWord cs∈Prefix1590Codec.rawWords) :
    traceWord (SkywalkTrace.trace 512 b)∈Prefix1590Codec.rawWords := by
  cases same
  have wordEq := (traceWord_firstFive 512 (by decide) a).trans (congrArg traceWord semantic)
  exact Eq.mp (congrArg (fun n : Nat => n∈Prefix1590Codec.rawWords) wordEq.symm) member

/-- Every canonical nonzero input has one of the exact114 raw prefix words. -/
theorem trace_raw_domain (x : Nat) (hx0 : 0<x) (hx : x<p) :
    traceWord (SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int)))∈
      Prefix1590Codec.rawWords := by
  let r : Fin 32 := ⟨x%32,Nat.mod_lt _ (by decide)⟩
  let k : Int := (x/32:Nat)
  have decomposition : (x:Int)=32*k+(r.val:Int) := by dsimp only [k,r]; omega
  have lower : firstK r.val≤k := by
    unfold firstK
    split_ifs with hr
    · have xp : (0:Int)<x := by exact_mod_cast hx0
      omega
    · have kn : (0:Int)≤k := by dsimp only [k]; positivity
      exact kn
  have upper : k≤lastK r.val := by
    have xp : (x:Int)<(p:Int) := by exact_mod_cast hx
    unfold lastK
    omega
  have checked := intervals_checked r
  obtain ⟨cell,member,kl,kh⟩ := tiles_cover (lastK r.val) (firstK r.val) k
    (intervals r.val) checked.1 lower upper
  have semantic := trace_sound cell.1 cell.2 k kl kh 5 (initial r.val)
    (checked.2 cell member).1
  exact trace_domain_transport (evalState (initial r.val) k)
    (SkywalkRails.encode false false (x:Int) (p:Int))
    (initial_state_eq r.val k (x:Int) decomposition)
    (affineTrace cell.1 5 (initial r.val)) semantic (checked.2 cell member).2

end

/-- Read the same first packet from the physical raw history. -/
theorem origin_raw_domain (w : Nat → Wire) (origin : BasisState)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape w)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    Prefix1590Codec.rawCodeOf
      (fun q => origin (MeasuredCodec5.label (History5.historyMap w 0) q))∈Prefix1590Codec.rawWords := by
  have read : Prefix1590Codec.rawCodeOf
      (fun q => origin (MeasuredCodec5.label (History5.historyMap w 0) q))=
      traceWord (skywalkTapeControls origin (skywalkSharedTape w)) := rfl
  rw [read,trace]
  exact trace_raw_domain x hx0 hx

private theorem raw_congr (a b : BasisState) (h : ∀q<10,a q=b q) :
    Prefix1590Codec.rawCodeOf a=Prefix1590Codec.rawCodeOf b := by
  simp only [Prefix1590Codec.rawCodeOf,h 0 (by decide),h 1 (by decide),h 2 (by decide),
    h 3 (by decide),h 4 (by decide),h 5 (by decide),h 6 (by decide),h 7 (by decide),
    h 8 (by decide),h 9 (by decide)]

private theorem code_congr (a b : BasisState) (h : ∀q<10,a q=b q) :
    Prefix1590Codec.codeOf a=Prefix1590Codec.codeOf b := by
  simp only [Prefix1590Codec.codeOf,h 0 (by decide),h 1 (by decide),h 2 (by decide),
    h 3 (by decide),h 4 (by decide),h 6 (by decide),h 7 (by decide),h 8 (by decide)]

section
attribute [local irreducible] run wires

private theorem factor_packet_ports (All Rest Packet : Program) (f : Fin 10→Wire)
    (raw s : State) (encoded : s=run All [] raw)
    (factor : run All [] raw=run Rest [] (run Packet [] raw))
    (away : ∀q : Fin 10,f q∉wires Rest) :
    ∀q : Fin 10,s.basis (f q)=(run Packet [] raw).basis (f q) := by
  intro q
  rw [encoded,factor]
  exact run_preserves_outside Rest [] (run Packet [] raw) (f q) (away q)

private theorem mapped_packet_ports (P Q : Program) (f : Fin 10→Wire)
    (hf : Function.Injective f) (shape : Q=renameProgram (MeasuredCodec5.label f) P)
    (support : wires P⊆Finset.range 10) (raw localRaw : State)
    (phase : localRaw.phase=raw.phase)
    (bits : ∀q<10,localRaw.basis q=raw.basis (MeasuredCodec5.label f q)) :
    ∀q : Fin 10,(run Q [] raw).basis (f q)=(run P [] localRaw).basis q.val := by
  have placed := run_rename_pool (MeasuredCodec5.label f) (Finset.range 10)
    (FirstNonzeroCodec.label_inj' f hf) P support [] localRaw raw phase
    (fun q hq => bits q (Finset.mem_range.mp hq))
  intro q
  simpa only [shape,MeasuredCodec5.label,dif_pos q.isLt] using
    placed.2 q.val (Finset.mem_range.mpr q.isLt)

private theorem codes_of_ports (f : Fin 10→Wire) (localEncoded s : State)
    (ports : ∀q : Fin 10,s.basis (f q)=localEncoded.basis q.val)
    (codes : localEncoded.basis 5=false ∧ localEncoded.basis 9=false ∧
      Prefix1590Codec.codeOf localEncoded.basis∈Prefix1590Codec.canonicalCodes) :
    s.basis (f 5)=false ∧ s.basis (f 9)=false ∧
      Prefix1590Codec.codeAt f s.basis∈Prefix1590Codec.canonicalCodes := by
  refine ⟨(ports 5).trans codes.1,(ports 9).trans codes.2.1,?_⟩
  have codeSame : Prefix1590Codec.codeAt f s.basis=Prefix1590Codec.codeOf localEncoded.basis := by
    apply code_congr
    intro q hq
    simpa only [MeasuredCodec5.label,dif_pos hq] using ports ⟨q,hq⟩
  rw [codeSame]
  exact codes.2.2

private theorem encoded_prefix_codes (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (origin : BasisState) (raw s : State)
    (same : ∀q : Fin 10,raw.basis (History5.historyMap w 0 q)=origin (History5.historyMap w 0 q))
    (encoded : s=run (NewHistory5.allEncode w 102) [] raw)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape w)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    s.basis (History5.historyMap w 0 5)=false ∧
      s.basis (History5.historyMap w 0 9)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap w 0) s.basis∈Prefix1590Codec.canonicalCodes := by
  let f := History5.historyMap w 0
  let localRaw : State := ⟨raw.phase,fun q => raw.basis (MeasuredCodec5.label f q)⟩
  have hf := History5.historyMap_injective w hn 0 (by decide)
  have member : Prefix1590Codec.rawCodeOf localRaw.basis∈Prefix1590Codec.rawWords := by
    rw [raw_congr localRaw.basis (fun q => origin (MeasuredCodec5.label f q)) (by
      intro q hq
      simpa only [localRaw,MeasuredCodec5.label,dif_pos hq] using same ⟨q,hq⟩)]
    exact origin_raw_domain w origin x hx0 hx trace
  have localResult := Prefix1590Codec.raw_to_canonical_regular localRaw [] member
  have disjoint := NewHistory5.otherEncode_disjoint w hn 102 0 (by decide) (by decide)
  have kept := factor_packet_ports (NewHistory5.allEncode w 102) (NewHistory5.otherEncode w 0 102)
    (NewHistory5.encode w 0) f raw s encoded
    (NewHistory5.allEncode_factor w hn 102 0 (by decide) (by decide) raw) (by
      intro q used
      exact Finset.disjoint_left.mp disjoint used (NewHistory5.history_site_mem w 0 q))
  have placed := mapped_packet_ports ParityCodec5New.encode (NewHistory5.encode w 0) f hf
    (by unfold NewHistory5.encode ParityCodec5New.encodeAt; rfl)
    ParityCodec5New.support.1 raw localRaw rfl (fun _ _ => rfl)
  exact codes_of_ports f (run ParityCodec5New.encode [] localRaw) s
    (fun q => (kept q).trans (placed q)) localResult

end

/-- Every existing field frame supplies the canonical encoded prefix domain. -/
theorem encoded_frame_prefix_codes (w : Nat → Wire) (sign : Wire)
    (hn : (skywalkSharedWires w).Nodup) (ho : sign∉skywalkPoolWires w)
    (origin : BasisState) (X Y : Fp) (s : State)
    (input : NewHistory5.EncodedFieldFrame5 w sign origin X Y s)
    (x : Nat) (hx0 : 0<x) (hx : x<p)
    (trace : skywalkTapeControls origin (skywalkSharedTape w)=
      SkywalkTrace.trace 512 (SkywalkRails.encode false false (x:Int) (p:Int))) :
    s.basis (History5.historyMap w 0 5)=false ∧
      s.basis (History5.historyMap w 0 9)=false ∧
      Prefix1590Codec.codeAt (History5.historyMap w 0) s.basis∈Prefix1590Codec.canonicalCodes := by
  obtain ⟨raw,_,frame,encoded⟩ := input
  apply encoded_prefix_codes w (skywalkShared_integer_nodup w hn) origin raw s _ encoded x hx0 hx trace
  intro q
  have away := History5.history_words_away w sign hn ho 0 (by decide) q
  exact frame.2.2 _ away.1 away.2

