  simp only [stackReverse510,ECDSAAdd.Entrant.stackReverse510,toffoliCount_append,
    measurementCount_append,gateSlots_append,renameProgram_counts,rename_gateSlots]
  constructor
  · omega
  · constructor <;> omega

