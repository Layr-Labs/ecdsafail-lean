namespace ECDSAAdd.Entrant.StairPacket.WindowSites
open Arithmetic MappedCompressed StairSiteAvoidance StairSiteEasy StairConcreteAssembly
open StairRestSupport
set_option maxRecDepth 14000
set_option maxHeartbeats 1000000
attribute [local irreducible] wires renameProgram Shadow20.MixedWindow425.forward425Cut Shadow20.MixedWindow425.reverse425Cut
  Rolling1588TickGap.forward Rolling1588.reverse Stair44WalkMap.rest Stair44WalkMap.first

abbrev GoodWindow (p : Program) :=
  ∀ q∈wires p, Stair44PhaseSites.valid (Stair44WalkMap.rest q)=true

theorem native {p : Program} (h : GoodWindow p) :
    PieceOK reserved (fun x => PP (Stair44WalkMap.rest x)) p := by
  apply weaken
  apply Stair44OuterSites.fits
  intro x hx
  change Stair44OuterSites.fit (StairOuterPlacement.phasePlace (Stair44WalkMap.rest x))=true
  rw [StairPlaceFast.phasePlace_eqB]
  exact h x hx

theorem walkFFalse (tail : Nat) (bound : 16 + (410 + tail) ≤ 506)
    (new : GoodWindow (Shadow20.MixedWindow425.forward425Cut false)) :
    PieceOK reserved PP (WindowWalkCosts.forward false tail) := by
  have old := weaken (Stair44PhaseSites.forward false (410 + tail) bound)
  have a := StairRestSupport.forward_append false 29 16 (381 + tail)
  have b := StairRestSupport.forward_append false 381 45 tail
  change Rolling1588TickGap.forward false 16 (29 + (381 + tail)) =
    Rolling1588TickGap.forward false 16 29 ++ Rolling1588TickGap.forward false 45 (381 + tail) at a
  rw [b] at a
  have num : 410 + tail = 29 + (381 + tail) := by omega
  simp only [Stair44WalkRun.forward, num, a, app, ren] at old
  simp only [WindowWalkCosts.forward, app, ren]
  exact ⟨old.1, ⟨old.2.1, native new⟩, old.2.2.2⟩

theorem walkFTrue (new : GoodWindow (Shadow20.MixedWindow425.forward425Cut true)) :
    PieceOK reserved PP (WindowWalkCosts.forward true 0) := by
  have old := weaken (Stair44PhaseSites.forward true 409 (by decide))
  have a := StairRestSupport.forward_append true 29 16 380
  change Rolling1588TickGap.forward true 16 (29 + 380) =
    Rolling1588TickGap.forward true 16 29 ++ Rolling1588TickGap.forward true 45 380 at a
  have num : (409 : Nat) = 29 + 380 := rfl
  have e0 : Rolling1588TickGap.forward true 426 0 = [] := by unfold Rolling1588TickGap.forward; rfl
  simp only [Stair44WalkRun.forward, num, a, app, ren] at old
  simp only [WindowWalkCosts.forward, e0, List.append_nil, app, ren]
  exact ⟨old.1, old.2.1, native new⟩

theorem walkRFalse (tail : Nat) (bound : 16 + (410 + tail) ≤ 506)
    (new : GoodWindow (Shadow20.MixedWindow425.reverse425Cut false)) :
    PieceOK reserved PP (WindowWalkCosts.backward false tail) := by
  have old := weaken (Stair44PhaseSites.backward false (410 + tail) bound)
  have a := StairRestSupport.reverse_append false 29 16 (381 + tail)
  have b := StairRestSupport.reverse_append false 381 45 tail
  change Rolling1588.reverse false 16 (29 + (381 + tail)) =
    Rolling1588.reverse false 45 (381 + tail) ++ Rolling1588.reverse false 16 29 at a
  rw [b] at a
  have num : 410 + tail = 29 + (381 + tail) := by omega
  simp only [Stair44WalkRun.backward, num, a, app, ren] at old
  simp only [WindowWalkCosts.backward, app, ren]
  exact ⟨⟨⟨old.1.1.1, native new⟩, old.1.2⟩, old.2⟩

theorem walkRTrue (new : GoodWindow (Shadow20.MixedWindow425.reverse425Cut true)) :
    PieceOK reserved PP (WindowWalkCosts.backward true 0) := by
  have old := weaken (Stair44PhaseSites.backward true 409 (by decide))
  have a := StairRestSupport.reverse_append true 29 16 380
  rw [show (16 : Nat) + 29 = 45 from rfl] at a
  have num : (409 : Nat) = 29 + 380 := by omega
  rw [Stair44WalkRun.backward, num, a, app, ren, app, ren] at old
  rw [WindowWalkCosts.backward, app, ren, app, app, WindowWalkCosts.rev_zero, ren]
  exact ⟨⟨⟨pieceOK_nil _ _, native new⟩, old.1.2⟩, old.2⟩

end ECDSAAdd.Entrant.StairPacket.WindowSites

