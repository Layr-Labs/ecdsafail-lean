      · exact chk_step q h'
    · exact chk_carry q h
  · intro k hk
    obtain ⟨-, ⟨z, zst, nvz⟩, -, -, -⟩ := traj504 x hx0 hxp u pre1 preC hsh m1 m2 m3
    obtain ⟨-, ze⟩ := stage_agree x z.basis ρ zst hρ
    rw [csite_wm k hk, nvz _ (by unfold StairFirstTickV3.Virt; omega)]
    exact (ze (1540 + k) (Or.inr (by omega))
      (Or.inr (Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩))))).1

