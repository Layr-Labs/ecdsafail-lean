theorem finPool_not_xy (q : Wire) (hq : q ∈ L.dialogPool) : q ∉ L.point.x ++ L.point.y := by
  intro h
  have dis := (List.nodup_append'.mp (L.dialogUsed_nodup hn)).2.2
