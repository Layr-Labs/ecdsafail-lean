theorem ofEndpointFalse (n x:Nat) (nz:0 < x) (lt:x<p) (atCut:426+n∈[505,506]) (ref:State)
    (h:Endpoint false x (425+n) ref):Native false x ref:=by
  obtain ⟨s,enc,stage,eq⟩:=h
  let a:=pullState Stair44WalkMap.first.symm s
  have input:pullState Stair44WalkMap.first a=s:=Stair44PlacedHead.unpull Stair44WalkMap.first.symm s
  have bound:426+n≤512:=by simp only [List.mem_cons,List.not_mem_nil,or_false] at atCut; omega
  have pair:=StockWalkEndpoints.openedFalse n x nz lt bound s a enc stage input
  have cut:1+(15+(410+n))∈[425,505,506]:=by simp only [List.mem_cons,List.not_mem_nil,or_false] at atCut ⊢; omega
  have same:=Stair44WalkCuts.forward_done false (410+n) x cut nz lt s a enc stage input
  rw [show 15+(410+n)=425+n by omega] at same
  refine ⟨pair.labels,?_⟩
  intro b j
  have loc:siteAt b j∈pool:=archives_pool _ (StockArchiveBanks.mem b j)
