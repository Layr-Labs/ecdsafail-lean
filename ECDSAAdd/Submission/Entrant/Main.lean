    (run cell m s).phase=s.phase ∧ DirectPass.WordFrame L.r s.basis
      (encodeWord 256 (kernelResult divide (s.basis L.sign) R Y)) (run cell m s).basis := by
  have h : Triple (DirectPass.AfterHalf L retired s.basis R Y)
