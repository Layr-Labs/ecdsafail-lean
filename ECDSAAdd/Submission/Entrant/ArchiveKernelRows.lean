-- WSLIM: proof-only helpers (tree mirror of `eval`, one-pass block / target checks), all proven.
section
/- WSLIM (proof-only helpers): a balanced-tree mirror of `CodecBitSliceVerify.eval`.
`eval` keeps its columns in a list (every `get`/`set` walks up to 150 cells in the kernel); the mirror keeps them
in a balanced tree (7-8 levels) and is proven equal, so `eval … = (true, out)` facts are checked through it. -/
namespace ECDSAAdd.Entrant.WSlimTree
open ECDSAAdd

inductive CT where
  | nil
  | leaf (v : Nat)
  | node (h : Nat) (l r : CT)

def CT.toList : CT → List Nat
  | .nil => []
  | .leaf v => [v]
  | .node _ l r => l.toList ++ r.toList

def CT.WF : CT → Prop
  | .nil => True
  | .leaf _ => True
  | .node h l r => l.WF ∧ r.WF ∧ l.toList.length = h

/-- Lookup / update written with the recursor (no `brecOn`, no matcher) to keep kernel reduction short. -/
noncomputable def CT.get2 (t : CT) : Nat → Nat :=
  CT.rec (motive := fun _ => Nat → Nat) (fun _ => 0) (fun v q => cond (Nat.beq q 0) v 0)
    (fun h _ _ gl gr q => cond (Nat.blt q h) (gl q) (gr (q - h))) t

noncomputable def CT.set2 (t : CT) : Nat → Nat → CT :=
  CT.rec (motive := fun _ => Nat → Nat → CT) (fun _ _ => .nil)
    (fun a q v => cond (Nat.beq q 0) (.leaf v) (.leaf a))
    (fun h l r sl sr q v => cond (Nat.blt q h) (.node h (sl q v) r) (.node h l (sr (q - h) v))) t

noncomputable def CT.modify2 (t : CT) : Nat → (Nat → Nat) → CT :=
  CT.rec (motive := fun _ => Nat → (Nat → Nat) → CT) (fun _ _ => .nil)
    (fun a q f => cond (Nat.beq q 0) (.leaf (f a)) (.leaf a))
    (fun h l r sl sr q f => cond (Nat.blt q h) (.node h (sl q f) r) (.node h l (sr (q - h) f))) t

theorem get_nil (q : Nat) : CodecBitSliceVerify.get [] q = 0 := rfl

theorem get_append (L R : List Nat) (q : Nat) :
    CodecBitSliceVerify.get (L ++ R) q = if q < L.length then CodecBitSliceVerify.get L q else CodecBitSliceVerify.get R (q - L.length) := by
  unfold CodecBitSliceVerify.get
  by_cases hq : q < L.length
  · rw [if_pos hq, List.getElem?_append_left hq]
  · rw [if_neg hq, List.getElem?_append_right (Nat.le_of_not_lt hq)]

theorem get2_spec : ∀ t : CT, t.WF → ∀ q, t.get2 q = CodecBitSliceVerify.get t.toList q
  | .nil, _, q => rfl
  | .leaf v, _, q => by
    show cond (Nat.beq q 0) v 0 = CodecBitSliceVerify.get [v] q
    cases q with
    | zero => rfl
    | succ n => rfl
  | .node h l r, hw, q => by
    obtain ⟨wl, wr, hl⟩ := hw
    show cond (Nat.blt q h) (l.get2 q) (r.get2 (q - h)) = CodecBitSliceVerify.get (l.toList ++ r.toList) q
    rw [get_append, hl, get2_spec l wl, get2_spec r wr]
    by_cases hq : q < h
    · simp [hq, Nat.blt_eq.mpr hq]
    · have e : Nat.blt q h = false := by
        rw [Bool.eq_false_iff]; intro hc; exact hq (Nat.blt_eq.mp hc)
      simp [hq, e]

theorem set_append (L R : List Nat) (q v : Nat) :
    (L ++ R).set q v = if q < L.length then L.set q v ++ R else L ++ R.set (q - L.length) v := by
  by_cases hq : q < L.length
  · rw [if_pos hq]; exact List.set_append_left _ _ hq
  · rw [if_neg hq]; exact List.set_append_right _ _ (Nat.le_of_not_lt hq)

theorem modify2_spec : ∀ t : CT, t.WF → ∀ q f,
    (t.modify2 q f).WF ∧ (t.modify2 q f).toList = t.toList.set q (f (CodecBitSliceVerify.get t.toList q))
  | .nil, _, q, f => ⟨trivial, rfl⟩
  | .leaf a, _, q, f => by
    cases q with
    | zero => exact ⟨trivial, rfl⟩
    | succ n => exact ⟨trivial, rfl⟩
  | .node h l r, hw, q, f => by
    obtain ⟨wl, wr, hl⟩ := hw
    show (cond (Nat.blt q h) (CT.node h (l.modify2 q f) r) (CT.node h l (r.modify2 (q - h) f))).WF ∧
      (cond (Nat.blt q h) (CT.node h (l.modify2 q f) r) (CT.node h l (r.modify2 (q - h) f))).toList =
        (l.toList ++ r.toList).set q (f (CodecBitSliceVerify.get (l.toList ++ r.toList) q))
    rw [get_append, set_append, hl]
    by_cases hq : q < h
    · have e : Nat.blt q h = true := Nat.blt_eq.mpr hq
      obtain ⟨w1, t1⟩ := modify2_spec l wl q f
      simp only [e, cond_true, hq, if_true]
      refine ⟨⟨w1, wr, ?_⟩, ?_⟩
      · rw [t1, List.length_set, hl]
      · show (l.modify2 q f).toList ++ r.toList = _
        rw [t1]
    · have e : Nat.blt q h = false := by
        rw [Bool.eq_false_iff]; intro hc; exact hq (Nat.blt_eq.mp hc)
      obtain ⟨w1, t1⟩ := modify2_spec r wr (q - h) f
      simp only [e, cond_false, hq, if_false]
      exact ⟨⟨wl, w1, hl⟩, by show l.toList ++ (r.modify2 (q - h) f).toList = _; rw [t1]⟩

theorem set2_spec : ∀ t : CT, t.WF → ∀ q v, (t.set2 q v).WF ∧ (t.set2 q v).toList = t.toList.set q v
  | .nil, _, q, v => ⟨trivial, rfl⟩
  | .leaf a, _, q, v => by
    cases q with
    | zero => exact ⟨trivial, rfl⟩
    | succ n => exact ⟨trivial, rfl⟩
  | .node h l r, hw, q, v => by
    obtain ⟨wl, wr, hl⟩ := hw
    show (cond (Nat.blt q h) (CT.node h (l.set2 q v) r) (CT.node h l (r.set2 (q - h) v))).WF ∧
      (cond (Nat.blt q h) (CT.node h (l.set2 q v) r) (CT.node h l (r.set2 (q - h) v))).toList =
        (l.toList ++ r.toList).set q v
    rw [set_append, hl]
    by_cases hq : q < h
    · have e : Nat.blt q h = true := Nat.blt_eq.mpr hq
      obtain ⟨w1, t1⟩ := set2_spec l wl q v
      simp only [e, cond_true, hq, if_true]
      refine ⟨⟨w1, wr, ?_⟩, ?_⟩
      · rw [t1, List.length_set, hl]
      · show (l.set2 q v).toList ++ r.toList = _
        rw [t1]
    · have e : Nat.blt q h = false := by
        rw [Bool.eq_false_iff]; intro hc; exact hq (Nat.blt_eq.mp hc)
      obtain ⟨w1, t1⟩ := set2_spec r wr (q - h) v
      simp only [e, cond_false, hq, if_false]
      exact ⟨⟨wl, w1, hl⟩, by show l.toList ++ (r.set2 (q - h) v).toList = _; rw [t1]⟩

noncomputable def stepT (mask : Nat) (i : Instr) (s : CT) : CT :=
  Instr.casesOn (motive := fun _ => CT) i
    (fun t => s.modify2 t (fun x => x ^^^ mask))
    (fun c t => s.modify2 t (fun x => x ^^^ s.get2 c))
    (fun a b t => s.modify2 t (fun x => x ^^^ (s.get2 a &&& s.get2 b)))
    (fun t _ _ => s.set2 t 0)

noncomputable def corrT (cs : List Correction) (s : CT) : Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun c _ ih => Correction.casesOn (motive := fun _ => Nat) c
    (fun t => s.get2 t ^^^ ih) (fun a b => (s.get2 a &&& s.get2 b) ^^^ ih)) cs

noncomputable def safeStepT (i : Instr) (s : CT) : Bool :=
  Instr.casesOn (motive := fun _ => Bool) i (fun _ => true) (fun _ _ => true) (fun _ _ _ => true)
    (fun t c0 c1 => (corrT c0 (s.set2 t 0) == 0) && (corrT c1 (s.set2 t 0) == s.get2 t))

/-- Runs the program on the tree and compares the final columns with `out`. -/
noncomputable def checkT (mask : Nat) (P : Program) : CT → List Nat → Bool :=
  List.rec (motive := fun _ => CT → List Nat → Bool) (fun s out => s.toList == out)
    (fun i _ ih s out => safeStepT i s && ih (stepT mask i s) out) P

theorem stepT_spec (mask : Nat) (i : Instr) (s : CT) (hw : s.WF) :
    (stepT mask i s).WF ∧ (stepT mask i s).toList = CodecBitSliceVerify.step mask i s.toList := by
  cases i with
  | X t => exact modify2_spec s hw t _
  | CX c t =>
    have e := get2_spec s hw c
    obtain ⟨w, h⟩ := modify2_spec s hw t (fun x => x ^^^ s.get2 c)
    refine ⟨w, ?_⟩
    show (s.modify2 t (fun x => x ^^^ s.get2 c)).toList = _
    rw [h, e]; rfl
  | CCX a b t =>
    have ea := get2_spec s hw a
    have eb := get2_spec s hw b
    obtain ⟨w, h⟩ := modify2_spec s hw t (fun x => x ^^^ (s.get2 a &&& s.get2 b))
    refine ⟨w, ?_⟩
    show (s.modify2 t (fun x => x ^^^ (s.get2 a &&& s.get2 b))).toList = _
    rw [h, ea, eb]; rfl
  | measureX t c0 c1 => exact set2_spec s hw t 0

theorem corrT_spec (cs : List Correction) (s : CT) (hw : s.WF) : corrT cs s = CodecBitSliceVerify.corr cs s.toList := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    cases c with
    | Z t =>
      show s.get2 t ^^^ corrT cs s = CodecBitSliceVerify.get s.toList t ^^^ CodecBitSliceVerify.corr cs s.toList
      rw [get2_spec s hw, ih]
    | CZ a b =>
      show (s.get2 a &&& s.get2 b) ^^^ corrT cs s = (CodecBitSliceVerify.get s.toList a &&& CodecBitSliceVerify.get s.toList b) ^^^ CodecBitSliceVerify.corr cs s.toList
      rw [get2_spec s hw, get2_spec s hw, ih]

theorem safeStepT_spec (i : Instr) (s : CT) (hw : s.WF) : safeStepT i s = CodecBitSliceVerify.safeStep i s.toList := by
  cases i with
  | X t => rfl
  | CX c t => rfl
  | CCX a b t => rfl
  | measureX t c0 c1 =>
    obtain ⟨w, h⟩ := set2_spec s hw t 0
    show ((corrT c0 (s.set2 t 0) == 0) && (corrT c1 (s.set2 t 0) == s.get2 t)) =
      ((CodecBitSliceVerify.corr c0 (s.toList.set t 0) == 0) && (CodecBitSliceVerify.corr c1 (s.toList.set t 0) == CodecBitSliceVerify.get s.toList t))
    rw [corrT_spec _ _ w, corrT_spec _ _ w, h, get2_spec s hw]

theorem checkT_sound (mask : Nat) (P : Program) :
    ∀ (s : CT) (out : List Nat), s.WF → checkT mask P s out = true → CodecBitSliceVerify.eval mask P s.toList = (true, out) := by
  induction P with
  | nil =>
    intro s out _ h
    have h' : (s.toList == out) = true := h
    rw [beq_iff_eq] at h'
    show (true, s.toList) = (true, out)
    rw [h']
  | cons i P ih =>
    intro s out hw h
    have h' : (safeStepT i s && checkT mask P (stepT mask i s) out) = true := h
    rw [Bool.and_eq_true] at h'
    obtain ⟨w1, t1⟩ := stepT_spec mask i s hw
    have r := ih (stepT mask i s) out w1 h'.2
    rw [t1] at r
    show (CodecBitSliceVerify.safeStep i s.toList && (CodecBitSliceVerify.eval mask P (CodecBitSliceVerify.step mask i s.toList)).1, (CodecBitSliceVerify.eval mask P (CodecBitSliceVerify.step mask i s.toList)).2) = _
    rw [r, ← safeStepT_spec i s hw, h'.1]
    rfl

/-- Balanced tree from a list (fuel = length suffices). -/
def build : Nat → List Nat → CT
  | 0, _ => .nil
  | _ + 1, [] => .nil
  | _ + 1, [a] => .leaf a
  | f + 1, a :: b :: rest =>
    .node ((a :: b :: rest).length / 2) (build f ((a :: b :: rest).take ((a :: b :: rest).length / 2)))
      (build f ((a :: b :: rest).drop ((a :: b :: rest).length / 2)))

theorem half_le (n f : Nat) (h : n + 2 ≤ f + 1) : (n + 2) / 2 ≤ f := by omega
theorem rest_le (n f : Nat) (h : n + 2 ≤ f + 1) : n + 2 - (n + 2) / 2 ≤ f := by omega
theorem half_le_self (n : Nat) : (n + 2) / 2 ≤ n + 2 := Nat.div_le_self _ _

theorem build_spec : ∀ (f : Nat) (l : List Nat), l.length ≤ f → (build f l).WF ∧ (build f l).toList = l
  | 0, l, h => by
    have : l = [] := List.eq_nil_of_length_eq_zero (Nat.le_zero.mp h)
    subst this; exact ⟨trivial, rfl⟩
  | f + 1, [], _ => ⟨trivial, rfl⟩
  | f + 1, [a], _ => ⟨trivial, rfl⟩
  | f + 1, a :: b :: rest, h => by
    have hn : (a :: b :: rest).length = rest.length + 2 := rfl
    rw [hn] at h
    have h1 : ((a :: b :: rest).take ((a :: b :: rest).length / 2)).length ≤ f := by
      rw [List.length_take, hn]
      exact Nat.le_trans (Nat.min_le_left _ _) (half_le _ _ h)
    have h2 : ((a :: b :: rest).drop ((a :: b :: rest).length / 2)).length ≤ f := by
      rw [List.length_drop, hn]
      exact rest_le _ _ h
    obtain ⟨w1, t1⟩ := build_spec f _ h1
    obtain ⟨w2, t2⟩ := build_spec f _ h2
    refine ⟨⟨w1, w2, ?_⟩, ?_⟩
    · rw [t1, List.length_take, hn]
      exact Nat.min_eq_left (half_le_self _)
    · show (build f _).toList ++ (build f _).toList = _
      rw [t1, t2, List.take_append_drop]

/-- The fact `eval mask P inp = (true, out)` from one tree run. -/
theorem eval_of_checkT (mask : Nat) (P : Program) (inp out : List Nat)
    (h : checkT mask P (build inp.length inp) out = true) : CodecBitSliceVerify.eval mask P inp = (true, out) := by
  obtain ⟨w, t⟩ := build_spec inp.length inp (Nat.le_refl _)
  have r := checkT_sound mask P _ out w h
  rwa [t] at r

/-- CPS run: `checkK mask P s k` runs `P` on `s`, then hands the final tree to `k`. -/
noncomputable def checkK (mask : Nat) (P : Program) : CT → (CT → Bool) → Bool :=
  List.rec (motive := fun _ => CT → (CT → Bool) → Bool) (fun s k => k s)
    (fun i _ ih s k => safeStepT i s && ih (stepT mask i s) k) P

/-- Blocks run one after the other (no walk through a left-nested `++` chain). -/
noncomputable def checkSeq (mask : Nat) (out : List Nat) (Bs : List Program) : CT → Bool :=
  List.rec (motive := fun _ => CT → Bool) (fun s => s.toList == out)
    (fun B _ ih s => checkK mask B s ih) Bs

/-- `B0 ++ B1 ++ … ++ Bk` (left-nested, as written in the source) is `joinL B0 [B1, …, Bk]`. -/
def joinL (A : Program) (Bs : List Program) : Program := Bs.foldl (· ++ ·) A

theorem joinL_cons (A B : Program) (Bs : List Program) : joinL A (B :: Bs) = A ++ joinL B Bs := by
  unfold joinL
  induction Bs generalizing B with
  | nil => rfl
  | cons C Bs ih =>
    show List.foldl (· ++ ·) (A ++ B ++ C) Bs = A ++ List.foldl (· ++ ·) (B ++ C) Bs
    rw [List.append_assoc]
    exact ih (B ++ C)

theorem eval_append (mask : Nat) (p q : Program) (input mid output : List Nat)
    (hp : CodecBitSliceVerify.eval mask p input = (true, mid))
    (hq : CodecBitSliceVerify.eval mask q mid = (true, output)) :
    CodecBitSliceVerify.eval mask (p ++ q) input = (true, output) := by
  induction p generalizing input with
  | nil => cases hp; exact hq
  | cons i p ih =>
    have hp' : (CodecBitSliceVerify.safeStep i input && (CodecBitSliceVerify.eval mask p (CodecBitSliceVerify.step mask i input)).1,
      (CodecBitSliceVerify.eval mask p (CodecBitSliceVerify.step mask i input)).2) = (true, mid) := hp
    simp only [Prod.mk.injEq, Bool.and_eq_true] at hp'
    show (CodecBitSliceVerify.safeStep i input && (CodecBitSliceVerify.eval mask (p ++ q) (CodecBitSliceVerify.step mask i input)).1,
      (CodecBitSliceVerify.eval mask (p ++ q) (CodecBitSliceVerify.step mask i input)).2) = _
    rw [ih (CodecBitSliceVerify.step mask i input) (Prod.ext hp'.1.2 hp'.2), hp'.1.1]
    rfl

theorem checkK_sound (mask : Nat) (P : Program) : ∀ (s : CT) (k : CT → Bool), s.WF → checkK mask P s k = true →
    ∃ s' : CT, s'.WF ∧ CodecBitSliceVerify.eval mask P s.toList = (true, s'.toList) ∧ k s' = true := by
  induction P with
  | nil => intro s k hw h; exact ⟨s, hw, rfl, h⟩
  | cons i P ih =>
    intro s k hw h
    have h' : (safeStepT i s && checkK mask P (stepT mask i s) k) = true := h
    rw [Bool.and_eq_true] at h'
    obtain ⟨w1, t1⟩ := stepT_spec mask i s hw
    obtain ⟨s', w', e', k'⟩ := ih (stepT mask i s) k w1 h'.2
    rw [t1] at e'
    refine ⟨s', w', ?_, k'⟩
    show (CodecBitSliceVerify.safeStep i s.toList && (CodecBitSliceVerify.eval mask P (CodecBitSliceVerify.step mask i s.toList)).1,
      (CodecBitSliceVerify.eval mask P (CodecBitSliceVerify.step mask i s.toList)).2) = _
    rw [e', ← safeStepT_spec i s hw, h'.1]
    rfl

theorem checkSeq_sound (mask : Nat) (out : List Nat) : ∀ (Bs : List Program) (A : Program) (s : CT), s.WF →
    checkSeq mask out (A :: Bs) s = true → CodecBitSliceVerify.eval mask (joinL A Bs) s.toList = (true, out) := by
  intro Bs
  induction Bs with
  | nil =>
    intro A s hw h
    obtain ⟨s', _, e, k⟩ := checkK_sound mask A s _ hw h
    have k' : (s'.toList == out) = true := k
    rw [beq_iff_eq] at k'
    rw [← k']; exact e
  | cons B Bs ih =>
    intro A s hw h
    obtain ⟨s', w', e, k⟩ := checkK_sound mask A s _ hw h
    rw [joinL_cons]
    exact eval_append mask A (joinL B Bs) s.toList s'.toList out e (ih B s' w' k)

/-- The fact `eval mask (B0 ++ B1 ++ … ++ Bk) inp = (true, out)` from one tree run, block by block. -/
theorem eval_of_checkSeq (mask : Nat) (A : Program) (Bs : List Program) (inp out : List Nat)
    (h : checkSeq mask out (A :: Bs) (build inp.length inp) = true) :
    CodecBitSliceVerify.eval mask (joinL A Bs) inp = (true, out) := by
  obtain ⟨w, t⟩ := build_spec inp.length inp (Nat.le_refl _)
  have r := checkSeq_sound mask out Bs A _ w h
  rwa [t] at r

end ECDSAAdd.Entrant.WSlimTree

/- WSLIM (proof-only helpers): `GatePhysical p ∧ toffoliCount p = t ∧ measurementCount p = m ∧ gateSlots p = g`
from ONE recursor pass over `p` (the decide of the conjunction walks `p` four times through instance chains). -/
namespace ECDSAAdd.Entrant.WSlimBlock
open ECDSAAdd ECDSAAdd.Arithmetic ECDSAAdd.RecordedQuantum ECDSAAdd.Challenge

noncomputable def physB (i : Instr) : Bool :=
  Instr.casesOn (motive := fun _ => Bool) i (fun _ => true) (fun c t => !(Nat.beq c t))
    (fun a b t => !(Nat.beq a t) && !(Nat.beq b t)) (fun _ _ _ => true)
noncomputable def toffI (i : Instr) : Nat :=
  Instr.casesOn (motive := fun _ => Nat) i (fun _ => 0) (fun _ _ => 0) (fun _ _ _ => 1) (fun _ _ _ => 0)
noncomputable def measI (i : Instr) : Nat :=
  Instr.casesOn (motive := fun _ => Nat) i (fun _ => 0) (fun _ _ => 0) (fun _ _ _ => 0) (fun _ _ _ => 1)
noncomputable def slotI (i : Instr) : Nat :=
  Instr.casesOn (motive := fun _ => Nat) i (fun _ => 1) (fun _ _ => 1) (fun _ _ _ => 1)
    (fun _ c0 c1 => 1 + c0.length + c1.length)

/-- One pass: every instruction physical, and the three counters consumed exactly. -/
noncomputable def blockOkB (p : Program) : Nat → Nat → Nat → Bool :=
  List.rec (motive := fun _ => Nat → Nat → Nat → Bool)
    (fun t m g => Nat.beq t 0 && Nat.beq m 0 && Nat.beq g 0)
    (fun i _ ih t m g => physB i && Nat.ble (toffI i) t && Nat.ble (measI i) m && Nat.ble (slotI i) g &&
      ih (t - toffI i) (m - measI i) (g - slotI i)) p

theorem physB_sound (i : Instr) (h : physB i = true) : PhysicalInstr (.gate i) := by
  cases i with
  | X t => exact trivial
  | CX c t =>
    have h' : (!(Nat.beq c t)) = true := h
    simp only [Bool.not_eq_true'] at h'
    exact Nat.ne_of_beq_eq_false h'
  | CCX a b t =>
    have h' : (!(Nat.beq a t) && !(Nat.beq b t)) = true := h
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at h'
    exact ⟨Nat.ne_of_beq_eq_false h'.1, Nat.ne_of_beq_eq_false h'.2⟩
  | measureX t c0 c1 => exact trivial

theorem toff_cons (i : Instr) (p : Program) : toffoliCount (i :: p) = toffI i + toffoliCount p := by
  cases i <;> simp [toffoliCount, toffI, Nat.add_comm]
theorem meas_cons (i : Instr) (p : Program) : measurementCount (i :: p) = measI i + measurementCount p := by
  cases i <;> simp [measurementCount, measI, Nat.add_comm]
theorem slots_cons (i : Instr) (p : Program) : gateSlots (i :: p) = slotI i + gateSlots p := by
  cases i <;> simp [gateSlots, slotI, instructionSlots]

theorem blockOk_sound' (p : Program) : ∀ t m g, blockOkB p t m g = true →
    GatePhysical p ∧ toffoliCount p = t ∧ measurementCount p = m ∧ gateSlots p = g := by
  induction p with
  | nil =>
    intro t m g h
    have h' : (Nat.beq t 0 && Nat.beq m 0 && Nat.beq g 0) = true := h
    simp only [Bool.and_eq_true] at h'
    obtain ⟨⟨h1, h2⟩, h3⟩ := h'
    rw [Nat.eq_of_beq_eq_true h1, Nat.eq_of_beq_eq_true h2, Nat.eq_of_beq_eq_true h3]
    exact ⟨fun _ hi => absurd hi List.not_mem_nil, rfl, rfl, rfl⟩
  | cons i p ih =>
    intro t m g h
    have h' : (physB i && Nat.ble (toffI i) t && Nat.ble (measI i) m && Nat.ble (slotI i) g &&
      blockOkB p (t - toffI i) (m - measI i) (g - slotI i)) = true := h
    simp only [Bool.and_eq_true, Nat.ble_eq] at h'
    obtain ⟨⟨⟨⟨hp, ht⟩, hm⟩, hg⟩, hr⟩ := h'
    obtain ⟨r1, r2, r3, r4⟩ := ih _ _ _ hr
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro j hj
      rcases List.mem_cons.mp hj with e | e
      · subst e; exact physB_sound _ hp
      · exact r1 j e
    · rw [toff_cons, r2]; omega
    · rw [meas_cons, r3]; omega
    · rw [slots_cons, r4]; omega

theorem blockOk_sound (p : Program) (t m g : Nat) (h : blockOkB p t m g = true) :
    GatePhysical p ∧ toffoliCount p = t ∧ measurementCount p = m ∧ gateSlots p = g :=
  blockOk_sound' p t m g h

/-- `∀ i ∈ P, target i < n` (bit-slice column bound) from one recursor pass. -/
noncomputable def targetI (i : Instr) : Nat :=
  Instr.casesOn (motive := fun _ => Nat) i (fun t => t) (fun _ t => t) (fun _ _ t => t) (fun t _ _ => t)

noncomputable def targetsB (n : Nat) (P : Program) : Bool :=
  List.rec (motive := fun _ => Bool) true (fun i _ ih => Nat.blt (targetI i) n && ih) P

theorem targets_sound (n : Nat) (P : Program) (h : targetsB n P = true) :
    ∀ i ∈ P, ECDSAAdd.Entrant.CodecBitSliceVerify.target i < n := by
  induction P with
  | nil => intro i hi; exact absurd hi List.not_mem_nil
  | cons j P ih =>
    have h' : (Nat.blt (targetI j) n && targetsB n P) = true := h
    rw [Bool.and_eq_true] at h'
    intro i hi
    rcases List.mem_cons.mp hi with e | e
    · subst e
      have t : targetI i = ECDSAAdd.Entrant.CodecBitSliceVerify.target i := by cases i <;> rfl
      rw [← t]; exact Nat.blt_eq.mp h'.1
    · exact ih h'.2 i e

theorem forall_append {P : Instr → Prop} {A B : Program} (ha : ∀ i ∈ A, P i) (hb : ∀ i ∈ B, P i) :
    ∀ i ∈ A ++ B, P i :=
  fun i hi => (List.mem_append.mp hi).elim (ha i) (hb i)

/-- `toffoliCount p = t ∧ measurementCount p = m` from one recursor pass. -/
noncomputable def countsB (p : Program) : Nat → Nat → Bool :=
  List.rec (motive := fun _ => Nat → Nat → Bool) (fun t m => Nat.beq t 0 && Nat.beq m 0)
    (fun i _ ih t m => Nat.ble (toffI i) t && Nat.ble (measI i) m && ih (t - toffI i) (m - measI i)) p

theorem counts_sound (p : Program) : ∀ t m, countsB p t m = true →
    toffoliCount p = t ∧ measurementCount p = m := by
  induction p with
  | nil =>
    intro t m h
    have h' : (Nat.beq t 0 && Nat.beq m 0) = true := h
    rw [Bool.and_eq_true] at h'
    rw [Nat.eq_of_beq_eq_true h'.1, Nat.eq_of_beq_eq_true h'.2]
    exact ⟨rfl, rfl⟩
  | cons i p ih =>
    intro t m h
    have h' : (Nat.ble (toffI i) t && Nat.ble (measI i) m && countsB p (t - toffI i) (m - measI i)) = true := h
    simp only [Bool.and_eq_true, Nat.ble_eq] at h'
    obtain ⟨⟨ht, hm⟩, hr⟩ := h'
    obtain ⟨r1, r2⟩ := ih _ _ hr
    exact ⟨by rw [toff_cons, r1]; omega, by rw [meas_cons, r2]; omega⟩

/-- `gateSlots p ≤ g` from one recursor pass. -/
noncomputable def slotsLeB (p : Program) : Nat → Bool :=
  List.rec (motive := fun _ => Nat → Bool) (fun _ => true)
    (fun i _ ih g => Nat.ble (slotI i) g && ih (g - slotI i)) p

theorem slotsLe_sound (p : Program) : ∀ g, slotsLeB p g = true → gateSlots p ≤ g := by
  induction p with
  | nil => intro g _; exact Nat.zero_le g
  | cons i p ih =>
    intro g h
    have h' : (Nat.ble (slotI i) g && slotsLeB p (g - slotI i)) = true := h
    simp only [Bool.and_eq_true, Nat.ble_eq] at h'
    have r := ih _ h'.2
    rw [slots_cons]; omega

