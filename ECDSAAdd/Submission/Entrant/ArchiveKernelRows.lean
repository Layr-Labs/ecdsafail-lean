theorem combine (mask : Nat) (p q : Program) (input mid output : Cols)
    (hp : eval mask p input = (true, mid)) (hq : eval mask q mid = (true, output)) :
    eval mask (p ++ q) input = (true, output) := by
  induction p generalizing input with
  | nil => cases hp; exact hq
  | cons i p ih =>
    simp only [eval, Prod.mk.injEq, Bool.and_eq_true] at hp
    change (safeStep i input && (eval mask (p ++ q) (step mask i input)).1,
      (eval mask (p ++ q) (step mask i input)).2) = _
    rw [ih (step mask i input) (Prod.ext hp.1.2 hp.2), hp.1.1]
    rfl

/-- Row correctness on the whole physical state with arbitrary surroundings and tape. -/
theorem run_row (p : Program) (mask row x : Nat) (m : List Bool) (s : State)
    (input output : Cols) (hm : mask.testBit row = true)
    (bound : ∀ i ∈ p, CodecBitSliceVerify.target i < input.length)
    (hr : Rel input x row) (h : eval mask p input = (true, output))
    (hb : ∀ q ∈ wires p, s.basis q = x.testBit q) :
    (run p m s).phase = s.phase ∧
      (∀ q ∈ wires p, (run p m s).basis q = (get output q).testBit row) ∧
      (∀ q ∉ wires p, (run p m s).basis q = s.basis q) := by
  have maskCheck : (eval mask p input).1 = true := by rw [h]
  obtain ⟨safe, result⟩ := eval_sound mask row hm p input x bound hr maskCheck
  rw [h] at result
  have ref := MeasuredCodec5.run_sim p m s.phase x
  rw [sim_safe _ _ safe] at ref
  have localRun := run_local_increment p s ⟨s.phase, bitsOf x⟩ m hb
  rw [ref] at localRun
  refine ⟨?_, fun q hq => (localRun.2 q hq).trans (result q), ?_⟩
  · have sign := localRun.1
    change ((run p m s).phase ^^ s.phase) = (s.phase ^^ s.phase) at sign
    cases f : (run p m s).phase <;> cases g : s.phase <;> simp_all
  · exact fun q hq => run_preserves_outside p m s q hq

end ECDSAAdd.Entrant.StairArchiveRows

