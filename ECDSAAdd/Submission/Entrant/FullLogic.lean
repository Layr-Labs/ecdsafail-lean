  apply congrArg (State.mk s.phase)
  funext w
  by_cases hw : w=a
  · subst w; simp [writeBit,hca,hat]
  · by_cases ht : w=t
    · subst w; simp [writeBit,hca,Ne.symm hat]
    · simp [writeBit,hw,ht,hca]

