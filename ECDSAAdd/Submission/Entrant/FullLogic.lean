theorem copy_physical118 (c cache x y z : Wire)(src dst : List Wire)
 (ls : src.length=118)(ld : dst.length=118)(dn : dst.Nodup)
 (xn : x∉dst)(yn : y∉dst)(zn : z∉dst)
