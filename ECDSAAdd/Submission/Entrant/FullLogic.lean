 (cache1:Wire) (hR:cache1∉R) (hS:cache1∉S) (t:BasisState)
 (u V D:Nat) (hu:regValue U t=u) (s:State) (h:PS R S t V D s.basis) :
 s.basis (bit1 U)=(u/2%2==1) ∧ s.basis (bit1 R)=(V/2%2==1) ∧ s.basis cache1=t cache1 := by
