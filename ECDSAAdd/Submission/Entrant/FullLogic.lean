  rw[bu,br,b2,b1,hk1,hk2]
  simpa only[Nat.one_mul]using (sub_third u d 1 (by decide)).symm
 rw[sub33CCC_eq g cache cache1 cache2 h1R h1C h2R h2C s m (ps_cs g cl.c _ _ s h) ready]
