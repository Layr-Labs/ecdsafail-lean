    have h := CodexKnownOnesTail.accSub_prefix_triple acc Z bank cin 161 161 106 (Acc.earlyTerm src false 32) hacc
      (by norm_num [Acc.earlyTerm]) hf32 (by simp only [Acc.earlyTerm]; omega)
