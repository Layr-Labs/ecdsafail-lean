theorem mid_sumCarry_free (L:CuccaroStreamedSquareWideLayout) (hw:L.Widths) (hn:L.wires.Nodup)
 (c:Wire) (hc:c∉L.wires):L.core.sumCarry∉wires (wMidFullCCC L c):=by
