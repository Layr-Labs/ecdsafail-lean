theorem middle8_repad (acc Z Z' bank : List Wire) (cin:Wire) (src:List Wire) (middle:Program)
 (hs:src.length=128) (ha:acc.length=163)
 (hf:Acc.Fits acc Z bank cin 163 (Acc.earlyTerm src false 4))
 (hf':Acc.Fits acc Z' bank cin 163 (Acc.earlyTerm src false 4))
