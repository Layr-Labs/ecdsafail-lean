 (he : 300≤ext.length)(v : Nat)(st : BasisState)
 (inv : (LowZero18LowK.jregsH L ext src dst).invF v st) :
 st (ext.getD 198 0)=(v.testBit 0 ^^ v.testBit 32) ∧
 (st (ext.getD 199 0) ^^ st (ext.getD 233 0))=(v.testBit 1 ^^ v.testBit 33) := by
