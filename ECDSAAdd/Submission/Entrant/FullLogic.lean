theorem cached_three(xs ys cs:List Wire)(cin q r p:Wire):
 q∈wires (cachedSubTriple xs ys cs cin q r p) ∧
 r∈wires (cachedSubTriple xs ys cs cin q r p) ∧
 p∈wires (cachedSubTriple xs ys cs cin q r p):=by
