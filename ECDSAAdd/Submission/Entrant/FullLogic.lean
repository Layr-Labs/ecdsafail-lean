theorem isSome_of_elim {α : Type _} {o : Option α} {f : α → Bool}
    (h : o.elim false f = true) : o.isSome = true := by
  cases o with
  | none => simp at h
  | some a => rfl
theorem get_of_elim {α : Type _} {o : Option α} {f : α → Bool}
    (h : o.elim false f = true) (hs : o.isSome = true) : f (o.get hs) = true := by
  cases o with
  | none => simp at hs
  | some a => exact h
end ECDSAAdd.Entrant.D1Opt
end


