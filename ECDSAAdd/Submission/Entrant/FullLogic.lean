 (ha:acc.length=163) (hs:src.length=128)
 (hf:∀f∈earlyHTerms src,Acc.FitsLen Z bank 163 f)
 (hf':∀f∈earlyHTerms src,Acc.FitsLen Z' bank 163 f):
