    (Acc.ty (acc.take 139) (Acc.earlyTerm src true 6)) (Acc.tc bank 139 (Acc.earlyTerm src true 6)) cin q r p
    (by omega) (by omega) (by omega)
  intro w hw
  by_cases eq:w=p
