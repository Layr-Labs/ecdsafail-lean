 (hx:xs.length=ys.length) (hc:cs.length+1=ys.length) (hy:9≤ys.length)
 (off:t∉wires (cachedSubDual xs ys cs cin q r))
 (s:State) (m:List Bool) (ht:s.basis t=false):
