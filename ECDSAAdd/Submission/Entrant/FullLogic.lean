 finish4L c (bit1 L.core.high) (L.core.high.headD 0) ((mU L).headD 0) (bit1 (mU L)) (bit2 (mU L)) (bit3 (mU L)) ((mR L).headD 0) (bit1 (mR L)) (bit2 (mR L)) (bit3 (mR L)) ((eReg L).headD 0) (cacheWire L) (hostWire L) (host2Wire L))

