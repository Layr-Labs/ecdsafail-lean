theorem fold_fixes_eU (L : CuccaroStreamedSquareWideLayout) (hw:L.Widths)
    (hn:L.wires.Nodup) (ext : List Wire) (hlen:300≤ext.length)
    (away:∀q∈ext,q∉L.wires) :
