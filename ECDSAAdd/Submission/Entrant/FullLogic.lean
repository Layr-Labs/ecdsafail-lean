 [a2,b2,k0,k1,k2].Nodup := by
 apply List.nodup_iff_count_le_one.mpr
 intro q
 have h:=List.nodup_iff_count_le_one.mp nd q
 simp only[List.count_cons,List.count_append,List.count_nil]at h ⊢
 omega

