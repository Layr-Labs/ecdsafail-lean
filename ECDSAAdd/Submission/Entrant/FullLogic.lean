 · have hw:u∈L.core.work:=hwork u hu
   exact ⟨(L.pairAuxAway hn u (by simp [hw])).2,(regValue_zero _ _).mp hc.work u hw⟩
 · have e:u=d:=by simpa only [List.mem_singleton] using hu
