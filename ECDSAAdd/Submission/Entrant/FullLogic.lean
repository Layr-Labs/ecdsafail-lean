  have cr2 : cache2∉mR L := fun hr=>(m_away L hn cache2 (Or.inl hr)).2 cache2E
  have cS2 : cache2∉mS L := fun hs=>(m_away L hn cache2 (Or.inr hs)).2 cache2E
