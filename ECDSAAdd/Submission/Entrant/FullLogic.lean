      Ne.symm hab,Ne.symm hac,Ne.symm hbc,Ne.symm hbh,Ne.symm hch]
 by_cases hqc:q=c
 · subst q
   simp [prime2,majority,run,writeBit,Function.update_apply,hab,hac,hah,hbc,hbh,hch,
      Ne.symm hab,Ne.symm hac,Ne.symm hbc,Ne.symm hbh,Ne.symm hch]
