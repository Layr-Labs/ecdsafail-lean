theorem withLowK2_bodyCK (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (ext : List Wire)
    (control : Wire) (src dst : List Wire) :
    toffoliCount (withLowK2 L ext control src dst (CodexCKAccTail.bodyCTail L control))+31=
