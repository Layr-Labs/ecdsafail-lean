theorem triple_loop_counts_repad (acc Z Z' bank : List Wire) (cin:Wire) (src:List Wire) (q r p:Wire) (middle:Program)
 (hs:src.length=128) (ha:acc.length=163) (hz:31≤Z.length) (hz':31≤Z'.length)
