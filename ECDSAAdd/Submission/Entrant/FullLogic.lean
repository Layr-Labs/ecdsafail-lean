  (wMidFullCCC L c++(unbuildConsumed (accReg L) (accZ L) (accBank L) L.core.cin (hiReg L) L.core.sumCarry++
   (ParkCarryDevelop.program (eU L) L.core.sumCarry++eSubK L))))
