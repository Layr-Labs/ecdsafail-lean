theorem state_eq_of_frame (acc:List Wire) (base:BasisState) (V:Nat) (s t:State)
 (hp:s.phase=t.phase) (hs:SquareFrame acc base V s.basis) (ht:SquareFrame acc base V t.basis):s=t := by
 apply State.extensionality _ _ hp
 funext w
