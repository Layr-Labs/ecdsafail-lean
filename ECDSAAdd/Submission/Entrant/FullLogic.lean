 (offF:q∉wires (NarrowAcc.build8 acc Z bank cin src))
 (offI:q∉wires (SourceAddFourDevelop.unbuild acc Z bank cin src))
 (offFR:r∉wires (NarrowAcc.build8 acc Z bank cin src))
