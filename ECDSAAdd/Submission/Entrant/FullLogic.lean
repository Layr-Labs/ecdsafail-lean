theorem insertMany_frame (pre post:Program) (xs hs:List Wire) (s:State) (m:List Bool)
 (nd:hs.Nodup) (fresh:∀h∈hs,h∉xs)
 (offpre:∀h∈hs,h∉wires pre) (offpost:∀h∈hs,h∉wires post)
