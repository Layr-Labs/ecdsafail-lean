  (cs.getD 4 0) (cs.getD 5 0) q r)=0:=by
  simp[secondCopy,insertCopy,subPre,sixthMajority,seventhMajority,majority,measurementCount_append,
   (notRegister_counts ys).2,carryPrefix_measurements,measurementCount]
