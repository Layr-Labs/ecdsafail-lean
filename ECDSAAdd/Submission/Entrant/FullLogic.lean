  measurementCount _=measurementCount (aFoldTriple L g) ∧ Challenge.gateSlots _+3*k≤Challenge.gateSlots (aFoldTriple L g)
 refine ⟨?_,?_,?_⟩
 · rw [←r.1]
   exact h.1
 · exact h.2.1.trans r.2.1
 · rw [←r.2.2]
   exact h.2.2


                                                                                                                            
                                                        
                                                                                               
                            
                                         
                                                                                                                   
                                                                               
                                                                                                    
                                                                                     
                                                           
                                                             
           
                                             
                                               
                                                               
                                      
                                                              

                                                                                                     
                                            
                                                                                                                              
                                                                                                           
                                                                                                                        
                                                                
                                                                                                   
                                                                              
                                                   

                               
                             
