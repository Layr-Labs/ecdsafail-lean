theorem carryPrefix_measurements (n : Nat) (x y cs : List Wire) (cin : Wire) :
    measurementCount (carryPrefix n x y cs cin)=0 := by
  induction n generalizing x y cs cin with
  | zero => rfl
  | succ n ih =>
    cases x with
    | nil => rfl
    | cons a as =>
