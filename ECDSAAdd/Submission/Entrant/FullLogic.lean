  (b0::b1::b2::b3::b4::ys) (d::false::false::false::false::fs) (k0::k1::k2::k3::ks) cin) m s := by
 have hg := fourth_geometry a0 a1 a2 a3 a4 b0 b1 b2 b3 b4 k0 k1 k2 k3 cin xs ys ks nd
