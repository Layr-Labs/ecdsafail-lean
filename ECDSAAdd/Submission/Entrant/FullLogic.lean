 Triple (PS R S t (u+d) 0) (sub33CCC cache cache1 cache2 R Z cs U cin) (PS R S t d 0) := by
 intro s m h
 obtain ⟨bu,br,b2⟩:=ps_third g cache2 h2R h2S t u (u+d) 0 hu s h
 have b1:s.basis cache1=t cache1:=h.2.2 cache1 h1R h1S
