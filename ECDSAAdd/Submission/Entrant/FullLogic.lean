    wires (equalClear c t bs k) ⊆ wires (equalConstant c t bs k) := by
  simp only [equalClear,equalConstant,wires_append]
  exact Finset.union_subset_union (Finset.union_subset_union (Finset.Subset.refl _) (support _ _ _))
