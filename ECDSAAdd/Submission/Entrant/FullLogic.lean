 (y y' : Wire) (ys : List Wire) (flags : List Bool) (c : Wire) (carry : List Wire) (cin : Wire)
 (hn : [y,cin,c].Nodup) (ha : ∀q∈b.wire,q∉[y,cin,c])
 (s : State) (m : List Bool)
 (hk : s.basis cache=carryBit (b.value s.basis) (s.basis y) (s.basis cin)) :
