 SeedPadDevelop.Counts
  (buildCached (accReg L) (FullPadDevelop.pad L) (accBank L) L.core.cin (hiReg L) L.core.sumCarry)
  (buildCached (accReg L) (accZ L) (accBank L) L.core.cin (hiReg L) L.core.sumCarry) ∧
