    (base : BasisState) (hz : ∀q∈Z,base q=false) (hb : ∀q∈bank,base q=false)
    (hi : base cin=false) :
    Triple (SquareFrame acc base (4294968272*regValue src base)) (unbuild acc Z bank cin src)
      (SquareFrame acc base 0) := by
