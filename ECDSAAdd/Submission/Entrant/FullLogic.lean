 (ext src dst : List Wire)(he : 300≤ext.length)(hs : src.length=128)(base st : BasisState)
 (i2 : (LowZero18LowK.kg L ext src dst).I2
  (regValue (LowZero18LowK.oregs L ext src dst).hi base) st) :
