 Counts (unbuildTriple acc Z bank cin src q r p) (unbuildTriple acc Z' bank cin src q r p) := by
 rw [unbuildTriple_split,unbuildTriple_split,unbuildHead_repad acc Z Z' bank cin src q r p hs h5]
