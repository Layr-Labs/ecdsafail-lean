theorem split_four {α:Type} (xs:List α) (h:4≤xs.length):
 ∃a b c d rest,xs=a::b::c::d::rest := by
 obtain ⟨a,b,c,rest,rfl⟩:=split_three xs (by omega)
 obtain ⟨d,rest,rfl⟩:=split_one rest (by simpa using h)
 exact ⟨a,b,c,d,rest,rfl⟩

