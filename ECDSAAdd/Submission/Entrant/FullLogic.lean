  intro r
  rw[SecondCarryLoan.finish_run u0 u1 r0 r1 e0 cache host1 nd7 S0 r]
  · simp[S1,t,S0,writeBit,Function.update_apply,show u0≠host2 by itauto,
     show u1≠host2 by itauto,show e0≠host2 by itauto]
  · simpa[S0,writeBit,Function.update_apply,show cache≠host2 by itauto,
     show u0≠host2 by itauto,show r0≠host2 by itauto]using hk0
  · simpa[S0,writeBit,Function.update_apply,show host1≠host2 by itauto,
     show u1≠host2 by itauto,show r1≠host2 by itauto,show cache≠host2 by itauto]using hk1
