 have he:run new (m.drop (measurementCount pre)) (run pre m s)=run old (m.drop (measurementCount pre)) (run pre m s):=by
  apply h.run_eq
  intro q hq
  exact (run_preserves_outside pre m s q (off q hq)).trans (hz q hq)
 rw[he]


