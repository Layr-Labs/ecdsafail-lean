   · have z:=a.1 h;simp only[List.mem_toFinset,List.mem_cons,List.mem_singleton]at z ⊢;itauto
   · have z:=p.1 h;simp only[List.mem_toFinset,List.mem_cons,List.mem_singleton]at z ⊢;itauto
