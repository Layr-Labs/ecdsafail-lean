theorem carryPrefix_carry_mem (n : Nat) (xs ys cs : List Wire) (cin : Wire)
    (hx:n≤xs.length) (hy:n≤ys.length) (hc:n≤cs.length) (q : Wire) (hq:q∈cs.take n) :
