    rw [Nat.testBit_div_two_pow] at bit
    exact ⟨(raw 392 (by decide +kernel)).trans (a0.trans same.symm), (stored.2.2.2.2.2.2 _ (by decide) (by decide) (by decide)).trans (lowMag.trans bit.symm)⟩
  | succ j =>
