def lowerPairs : List (Wire×Wire) := Portal210Flag.loPairs
def upperPairs : List (Wire×Wire) := Portal210Flag.hiPairs
def layout : Aperture lowerPairs upperPairs 225 1730 1728 1729 ports210 (W.compactSkywalkTickLayout base 210) (OB5.sig 209) 166 where
