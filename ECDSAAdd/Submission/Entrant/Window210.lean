theorem from_full (raw v:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^151)
    (p:PackedCut lowerPairs upperPairs 225 1730 1728 1729 (PortalValues.negative S z.u) (decide (Shadow.far 151 15 z))
        (decide (Shadow.far 151 15 z ∧ 2^151≤z.u)) (pullState (OB5.sig 209) raw) v)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 210) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    let next:=run Partial.enter210 m v
    next.phase=v.phase ∧ (∀q∈wires EnterProof.forward,next.basis (map210 q)=(shadowRow 151 15 z G S).testBit q) ∧
      ∀q∉wires Partial.enter210,next.basis q=v.basis q := by
  have src:=read_packed layout raw v z G S p input
  apply actual_shadow map210 Partial.enter210 false 151 15 z G S small inc210 emitted210 v m
  intro q h
  have lim:wires EnterProof.forward ⊆ Finset.range 23 := by apply ArchiveFieldScratch.bounded;decide +kernel
  have sz:ports210.length=23:=rfl
  have hv:=bitAt ports210 v.basis q (sz ▸ Finset.mem_range.mp (lim h))
