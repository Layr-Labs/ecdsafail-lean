namespace ECDSAAdd.Entrant.StairPacket.Leave210AssembleCut
open Arithmetic WideReference RailPair
set_option maxRecDepth 35000
set_option maxHeartbeats 4000000

def leftovers (q : Wire) : Prop :=
  (225≤q ∧ q<241) ∨ (1254≤q ∧ q<1269) ∨ q=498 ∨ q=1043

private theorem indexOfRange (q start count:Nat) (a:start≤q) (b:q<start+count) :
    ∃i:Fin count, start+i.val=q :=
  ⟨⟨q-start,by omega⟩,by change start+(q-start)=q;omega⟩

theorem result (s o : State) (neg far long : Bool)
    (phase : s.phase=o.phase) (sign : s.basis 1723=neg) (mode : s.basis 1721=far) (side : s.basis 1722=long)
    (low : ∀i:Fin 163, s.basis (241+i.val)=o.basis (241+i.val) ∧ s.basis (786+i.val)=o.basis (786+i.val))
    (high : ∀i:Fin 94, s.basis (404+i.val)=false ∧
      s.basis (949+i.val)=(if o.basis 240 then o.basis (949+i.val) else o.basis (404+i.val)))
    (ext : ∀q,ExteriorB 210 498 1043 q → s.basis q=o.basis q)
    (left : ∀q,leftovers q → s.basis q=o.basis q)
    (clear : ∀q∈Leave210BoundaryClean.zeros,s.basis q=false)
    (carry : ∀q:Wire,1556≤q → q≤1812 → o.basis q=false) :
    PackedCut Enter225.lowerPairs Enter225.upperPairs 240 1723 1721 1722 neg far long o (eraseSites Enter225.pending s) := by
  have loShape : Enter225.lowerPairs=(List.finRange 3).map (fun j=>(241+(160+j.val),786+(160+j.val))) := by decide +kernel
  have hiShape : Enter225.upperPairs=(List.finRange 94).map (fun j=>(404+j.val,949+j.val)) := by decide +kernel
  have away (q:Wire) (small:q<1556) : (eraseSites Enter225.pending s).basis q=s.basis q := by
    have no:q∉Enter225.pending:=by simp [Enter225.pending,Wire] at *;omega
    simp [eraseSites,no]
  refine ⟨phase,?_,?_,?_,?_,?_,?_⟩
  · simpa [eraseSites,Enter225.pending] using sign
  · simpa [eraseSites,Enter225.pending] using mode
  · simpa [eraseSites,Enter225.pending] using side
  · intro pair mem
    rw [loShape] at mem
    obtain ⟨j,_,rfl⟩:=List.mem_map.mp mem
    dsimp only
    have hj:=j.isLt
    rw [away (241+(160+j.val)) (by change 241+(160+j.val)<1556;omega),away (786+(160+j.val)) (by change 786+(160+j.val)<1556;omega)]
    exact low ⟨160+j.val,by omega⟩
  · intro pair mem
    rw [hiShape] at mem
    obtain ⟨j,_,rfl⟩:=List.mem_map.mp mem
    dsimp only
    have hj:=j.isLt
    rw [away (404+j.val) (by change 404+j.val<1556;omega),away (949+j.val) (by change 949+j.val<1556;omega)]
    exact high j
  · intro q notN notF notU _ notHi
    by_cases pending:q∈Enter225.pending
    · have range : ∀q∈Enter225.pending,1556≤q ∧ q≤1812 := by decide +kernel
      obtain ⟨lo,hi⟩:=range q pending
      simp [eraseSites,pending,carry q lo hi]
    simp only [eraseSites,if_neg pending]
    by_cases external:ExteriorB 210 498 1043 q
    · exact ext q external
    by_cases residual:leftovers q
    · exact left q residual
    have hiA (i:Fin 94) : 404+i.val∈sites Enter225.upperPairs := by
      exact (by decide +kernel : ∀i:Fin 94,404+i.val∈sites Enter225.upperPairs) i
    have hiB (i:Fin 94) : 949+i.val∈sites Enter225.upperPairs := by
      exact (by decide +kernel : ∀i:Fin 94,949+i.val∈sites Enter225.upperPairs) i
    have outside (start count:Nat) (h:∀i:Fin count,start+i.val∈sites Enter225.upperPairs) : ¬(start≤q ∧ q<start+count) := by
      rintro ⟨a,b⟩
      obtain ⟨i,eq⟩:=indexOfRange q start count a b
      exact notHi (eq ▸ h i)
    have notA:=outside _ _ hiA
    have notB:=outside _ _ hiB
    by_cases a:241≤q ∧ q<404
    · obtain ⟨l,r⟩:=a
      obtain ⟨i,eq⟩:=indexOfRange q 241 163 l r
      exact eq ▸ (low i).1
    by_cases b:786≤q ∧ q<949
    · obtain ⟨l,r⟩:=b
      obtain ⟨i,eq⟩:=indexOfRange q 786 163 l r
      exact eq ▸ (low i).2
    have bounds : 1556≤q ∧ q≤1812 := by
      unfold ExteriorB at external;unfold leftovers at residual
      simp only [Wire] at *
      omega
