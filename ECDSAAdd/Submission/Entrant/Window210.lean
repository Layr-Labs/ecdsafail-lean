def nextWindow (d:Bool) := Partial.enter225 ++ window d
def nextUnwind (d:Bool) := unwind d ++ Partial.enter225Inv

theorem next_window (d:Bool) (raw s:State) (m:List Bool)
    (z:SkywalkNat.State) (G S:Bool) (odd:z.v%2=1) (small:min z.u z.v<2^144)
    (cut:PackedCut Enter225.lowerPairs Enter225.upperPairs 240 1723 1721 1722 (PortalValues.negative S z.u)
      (decide (Shadow.far 144 15 z)) (decide (Shadow.far 144 15 z ∧ 2^144≤z.u))
      (pullState (OB5.sig 224) raw) (eraseSites Enter225.pending s))
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 225) (encode G S z.u z.v).a (encode G S z.u z.v).b G raw.basis)
    (hist:∀r:Fin 15,raw.basis (base (1028+225+r))=false) 
    (past:SkywalkNat.State) (pg ps cross:Bool) (po:past.v%2=1) (pm:min past.u past.v<2^151)
    (prior:PastFacts sourceIdx rawPorts 151 past pg ps cross s) :
    let out:=run (nextWindow d) m s
    let T:=Shadow.reduced 144 15 z
    out.phase=s.phase ∧ onRails idx 15 (SkywalkTrace.next^[15] (encode G S T.u T.v)) out.basis ∧
      readCells (shape idx) 0 15 (mappedBasis idx out.basis)=SkywalkTrace.trace 15 (encode G S z.u z.v) ∧
      ∀t,run (nextUnwind d) t out=s := by
  let pre:=run Partial.enter225 m s
  let tape:=m.drop (measurementCount Partial.enter225)
  let T:=Shadow.reduced 144 15 z
  let Z:=encode G S T.u T.v
  have to':T.v%2=1:=shadow_odd 144 z small odd
  have parity:(Z.a+Z.b)%2=1:=encode_odd_sum G S _ _ (by omega)
  have ready:=Enter225.ready_pending raw s z G S m small cut input hist 
  obtain ⟨legal,row,limit,frame⟩:=admits d s m tape (tape.drop (measurementCount (routed idx 0 1))) Z parity ready.2.1 past pg ps cross po pm prior
  have all:=window_run d pre tape Z parity ready.2.1 legal row limit frame
  dsimp only [nextWindow,nextUnwind]
  simp only [run_append,run_take]
  refine ⟨all.1.trans ready.1,all.2.1,all.2.2.1.trans (true_records 144 z small odd G S),?_⟩
  intro n
  rw [all.2.2.2 n]
  have free:∀q∈Enter225.pending,q∉wires Partial.enter225Inv:=by decide +kernel
  apply unmask Partial.enter225 Partial.enter225Inv Enter225.pending Enter225.avoid_enter free
  exact return_packed Enter225.layout map225 _ _ inc225 (fun _=>rfl) rfl emitted225 emitted225Inv raw _ z G S small cut input _ _
end NativePack225
