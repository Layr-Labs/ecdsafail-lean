theorem mirror (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 270 x p raw) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter270.lowerPairs Enter270.upperPairs 285 1700 1698 1699 neg far long
