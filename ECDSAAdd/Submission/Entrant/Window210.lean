theorem decode (s : State) (u v sign : Nat) (magFit : (u-sign)/2^151<2^19)
    (bits : ∀i<19,s.basis (392+i)=((u+v)/2^151).testBit i ∧ s.basis (937+i)=((u-sign)/2^151).testBit i) :
    ((digits 937 longPairs).any s.basis = decide (2^151≤u-sign)) ∧
      (s.basis 937 && !s.basis 392).toNat=upperBorrow (2^151) u v sign ∧
      regValue fullA s.basis=((u+v)/2^152)%2^18 ∧
      regValue fullM s.basis=((u-sign)/2^152)%2^18 := by
  have mag := EnterProof.value_of_bits (digits 937 longPairs) s.basis ((u-sign)/2^151) (by
    intro i hi
    have geom : ∀j:Fin 19,(digits 937 longPairs).getD j 0=937+j.val := by decide +kernel
    rw [geom ⟨i,hi⟩]
    exact (bits i hi).2)
  rw [show (digits 937 longPairs).length=19 from rfl,Nat.mod_eq_of_lt magFit] at mag
  refine ⟨?_,?_,?_,?_⟩
  · rw [any_positive,mag]
    simp only [Nat.div_pos_iff,show 0<2^151 by decide,true_and]
  · have bs := bits 0 (by decide)
    simpa only [Nat.add_zero,bs.1,bs.2] using borrowBit (2^151) u v sign (by decide)
  · apply EnterProof.value_of_bits fullA
    intro i hi
    have geom : ∀j:Fin 18,fullA.getD j 0=392+(j.val+1) := by decide +kernel
    rw [geom ⟨i,hi⟩,show (u+v)/2^152=((u+v)/2^151)/2^1 by rw [Nat.div_div_eq_div_mul];rfl,Nat.testBit_div_two_pow]
    have jj : i+1<19 := Nat.succ_lt_succ (show i<18 from hi)
    exact (bits (i+1) jj).1
  · apply EnterProof.value_of_bits fullM
    intro i hi
    have geom : ∀j:Fin 18,fullM.getD j 0=937+(j.val+1) := by decide +kernel
    rw [geom ⟨i,hi⟩,show (u-sign)/2^152=((u-sign)/2^151)/2^1 by rw [Nat.div_div_eq_div_mul];rfl,Nat.testBit_div_two_pow]
    have jj : i+1<19 := Nat.succ_lt_succ (show i<18 from hi)
    exact (bits (i+1) jj).2

