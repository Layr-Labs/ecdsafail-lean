def bank (ps:Ports):List Wire:=(List.finRange 16).map (fun j=>ps ⟨j.val,by omega⟩)
def bank0:=bank ArchiveBoundary225.codePorts
def bank1:=bank ArchiveBoundary240.codePorts
def bank2:=bank ArchiveBoundary255.codePorts
def one2:=bank0++bank1
def both:=bank0++(bank1++bank2)
def bank3:=bank ArchiveBoundary270.codePorts
def all3:=both++bank3

theorem keep {d:Bool} {row:Nat} {s t:State} {ps:Ports} (h:Kept ps d row s)
    (stable:∀q∈bank ps,t.basis q=s.basis q) : Kept ps d row t := by
  intro i
  rw [stable _ (List.mem_map.mpr ⟨i,List.mem_finRange i,rfl⟩),h i]

private theorem zeroBank (q:Wire) (h:q∈bank0) : q∈ArchivePersistence.zero :=
  (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀q∈bank0,q∈ArchivePersistence.zero) q h

private theorem firstBank (q:Wire) (h:q∈one2) : q∈ArchivePersistence.older :=
  (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀q∈one2,q∈ArchivePersistence.older) q h

private theorem bothBanks (q:Wire) (h:q∈both) : q∈ArchivePersistence.two :=
  (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀q∈both,q∈ArchivePersistence.two) q h

private theorem allBanks (q:Wire) (h:q∈all3) : q∈ArchivePersistence.three :=
  (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀q∈all3,q∈ArchivePersistence.three) q h

theorem after225 (s:State) (m:List Bool) (q:Wire) (h:q∈bank0) : (run leave225 m s).basis q=s.basis q :=
  ArchivePersistence.leave225_keeps q (zeroBank q h) m s

theorem entering240 (d:Bool) (s:State) (m:List Bool) (q:Wire) (h:q∈bank0) :
    (run (NativePack240.nextWindow d) m s).basis q=s.basis q :=
  ArchivePersistence.next240_keeps d q (zeroBank q h) m s

theorem after240 (s:State) (m:List Bool) (q:Wire) (h:q∈one2) : (run leave240 m s).basis q=s.basis q :=
  ArchivePersistence.leave240_keeps q (firstBank q h) m s

theorem entering255 (d:Bool) (s:State) (m:List Bool) (q:Wire) (h:q∈one2) :
    (run (NativePack255.nextWindow d) m s).basis q=s.basis q :=
