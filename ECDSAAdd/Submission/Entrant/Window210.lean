  NativePack210.firstUnwind NativePack225.nextUnwind NativePack240.nextUnwind NativePack255.nextUnwind NativePack270.nextUnwind NativePack285.lastUnwind

theorem checked (d:Bool) (x:Nat) (good:Bounds x p) :
    Checked (forward75plus1 d) (reverse75plus1 d) (Before d x p) (ArchiveStockRows.Final d x p) := by
  rw [assembly,unwind_assembly]
  simpa only [List.append_assoc] using
    composition (step210 d x p good) (composition (step225 d x p good) (composition (step240 d x p good)
      (composition (step255 d x p good) (composition (step270 d x p good) (step285 d x good)))))

theorem result (d:Bool) (x:Nat) (good:Bounds x p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d x p 210 raw.basis) :
    let start:=pullState (OB5.sig 209) raw
    let out:=run (forward75plus1 d) m start
    out.phase=raw.phase ∧ ArchiveStockRows.Final d x p out ∧ ∀n,run (reverse75plus1 d) n out=start := by
  have law:=checked d x good
  unfold Checked at law
  exact law _ m ⟨raw,stage,rfl⟩
