  let h:=SkywalkNat.step^[15] (Shadow.reduced 151 15 z)
  let out:=run Leave210BeforeStore.program m s
  have src:=Leave210Front.result s m z G sg small ready fresh scratch temp
  have stored:=Leave210BeforeStore.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound
  have lowMag:=( Leave210MaskCut.result s m z G sg small ready fresh scratch temp).1
  have raw (q:Wire) (ok:q∉afterFront.map destination):out.basis q=(run entry m s).basis q := by
    change (run Leave210BeforeStore.program m s).basis q=_
    rw [shape,run_append,run_take];exact preserved _ _ _ _ ok
  have truth:=LeaveShadowRails.retainedLow 151 z small sg
  have hist (q:Wire) (hq:q∈history):out.basis q= !s.basis q := by
    let sc:=run Leave210InputScan.scanPart m s
    let tape:=m.drop (measurementCount Leave210InputScan.scanPart)
    let v:=run flipHistory tape sc
    have inv:v=⟨sc.phase,fun q=>if q∈history then !sc.basis q else sc.basis q⟩ := by
      change run flipHistory tape sc=_
      rw [Leave210EntryAction.flipped,notRegister_correct _ (by decide)]
    have bounds:∀q∈history,226≤q ∧ q≤240 := by decide +kernel
    have all : afterFlip.all (fun g=>decide (destination g<226 ∨ 240<destination g))=true := by decide +kernel
    have ok:∀q∈history,q∉afterFlip.map destination := by
      intro q member bad
      obtain ⟨g,hg,rfl⟩:=List.mem_map.mp bad
      have hit := of_decide_eq_true (List.all_eq_true.mp all g hg)
      obtain ⟨l,r⟩:=bounds _ member
      exact hit.elim (Nat.not_lt_of_ge l) (Nat.not_lt_of_ge r)
    change (run Leave210BeforeStore.program m s).basis q=_
    rw [flippedShape,run_append,run_take,run_append,run_take]
    change (run _ _ v).basis q=_
    rw [preserved _ _ _ _ (ok q hq),inv]
    change (if _ then !sc.basis q else sc.basis q)=_
    rw [if_pos hq,preserved _ _ _ _ ((Leave210EntryAction.historyGeom _ hq).1)]
  refine ⟨(raw 1730 (by decide +kernel)).trans (src.2.2.1.trans truth.1.symm),hist,?_⟩
  intro i
  cases ix:i.val with
  | zero =>
    simp only [Nat.add_zero]
    have same:=congrArg (fun n:Nat=>n.testBit 151) truth.2.1
    simp only [Nat.testBit_mod_two_pow,show decide (151<152)=true from rfl,Bool.true_and] at same
    have a0:=src.2.2.2.2.2 0 (by decide)
    rw [Nat.testBit_div_two_pow] at a0
