theorem result (z:SkywalkNat.State) (sg:Bool) (s:ECDSAAdd.State) (m:List Bool)
    (small:min z.u z.v<2^151) (clean:∀q∈smallC,s.basis q=false) (cleared:regValue smallM s.basis=0)
    (input:let r:=step^[15] (reduced 151 15 z)
