      rw [List.getD_eq_getElem _ _ (show i < bank3.length from hi)] at eq
      exact dis q hq (eq ▸ List.getElem_mem _)
    · rw [bit3]
      exact (by decide +kernel : ∀ key : Fin 16, (key.val % 8) + (if key.val.testBit 3 then 8 else 0) = key.val) key
  exact p4 m

