namespace ECDSAAdd.Entrant.StairPacket.Leave210FrameHistory
open Arithmetic IntegerPacket MappedCompressed WideReference SkywalkRails Partial LeaveSelector
set_option maxRecDepth 40000
set_option maxHeartbeats 3500000

theorem result (x p : Nat) (good:Bounds x p) (raw s:State) (m:List Bool) (g sg:Bool)
    (domain:Domain 210 x p raw)
    (input:InputAt 210 (encode g sg (unsigned 210 x p).u (unsigned 210 x p).v) raw)
    (record:physicalCells 9 s=SkywalkTrace.trace 15 (encode g sg (unsigned 210 x p).u (unsigned 210 x p).v))
    (kept:physicalCells 9 (run leave210 m s)=physicalCells 9 s)
    (extra:∀q:Wire,Leave210ReleasedOrigin.releasedSite q → (run leave210 m s).basis q=(origin 210 raw s).basis q) :
    ∀q,Leave210AssembleCut.leftovers q → (run leave210 m s).basis q=(origin 210 raw s).basis q := by
  let out:=run leave210 m s
  let o:=origin 210 raw s
  have geo : ∀i:Fin 15,windowNet 9 (ports (shape 9) i.val).a0=226+i.val ∧
      windowNet 9 (ports (shape 9) i.val).history=Leave210Hit.swaps i.val := by decide +kernel
  have agree (i:Fin 15) : out.basis (226+i.val)=o.basis (226+i.val) ∧
      out.basis (Leave210Hit.swaps i.val)=o.basis (Leave210Hit.swaps i.val) := by
    have old:=recorded_equal _ _ _ _ (by decide) places210 good raw s domain g sg input record i
    have now:=congrArg (fun a=>StairArchiveRaw.read a i.val) kept
    change StairArchiveRaw.read (readCells (shape 9) 0 15 (mappedBasis 9 out.basis)) i.val =
      StairArchiveRaw.read (readCells (shape 9) 0 15 (mappedBasis 9 s.basis)) i.val at now
    rw [read_cells _ _ _ _ _ i.isLt,read_cells _ _ _ _ _ i.isLt,Nat.zero_add] at now
    have eq:=now.trans old
    change (out.basis (windowNet 9 (ports (shape 9) i.val).a0),out.basis (windowNet 9 (ports (shape 9) i.val).history)) =
      (o.basis (windowNet 9 (ports (shape 9) i.val).a0),o.basis (windowNet 9 (ports (shape 9) i.val).history)) at eq
    rw [(geo i).1,(geo i).2] at eq
    exact ⟨congrArg Prod.fst eq,congrArg Prod.snd eq⟩
  have previous : out.basis 225=o.basis 225 := by
    rw [show o.basis 225=s.basis 225 from inside _ _ _ _ (by decide +kernel)]
    have stable : parityAt 225 leave210=some false := by decide +kernel
    simpa [out] using polarity _ _ _ stable s m
  let gs:=(List.finRange 15).map (fun i=>226+i.val)
  let ss:=(List.finRange 15).map (fun i=>Leave210Hit.swaps i.val)
  intro q residual
  by_cases prev:q=225
  · subst q;exact previous
  by_cases gg:q∈gs
  · obtain ⟨i,_,rfl⟩:=List.mem_map.mp gg;exact (agree i).1
  by_cases sw:q∈ss
  · obtain ⟨i,_,rfl⟩:=List.mem_map.mp sw;exact (agree i).2
  have census : ∀a:Fin 1813,Leave210AssembleCut.leftovers a.val → a.val≠225 → a.val∉gs → a.val∉ss →
      Leave210ReleasedOrigin.releasedSite a.val := by
    unfold Leave210AssembleCut.leftovers; dsimp only [gs,ss];set_option synthInstance.maxSize 4096 in decide +kernel
  have bound:q<1813:=by unfold Leave210AssembleCut.leftovers at residual;simp only [Wire] at *;omega
  exact extra q (census ⟨q,bound⟩ residual prev gg sw)
end ECDSAAdd.Entrant.StairPacket.Leave210FrameHistory

