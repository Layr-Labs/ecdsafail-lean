      InputAt 210 (encode g s z.u z.v) raw ∧ Leave210Admission.Inputs v z g s ∧
      PackedCut Enter225.lowerPairs Enter225.upperPairs 240 1723 1721 1722 (PortalValues.negative flags.2 a.u)
        (decide (Shadow.far 144 15 a)) (decide (Shadow.far 144 15 a ∧ 2^144≤a.u))
        (pullState (OB5.sig 224) (endRaw 210 raw v)) (eraseSites Enter225.pending out) ∧
      PastFacts 9 ArchiveBoundary225.rawPorts 151 z g s (HighBankSum.cross (Leave210TrueMiddle.d z)) out := by
  let z:=unsigned 210 x p
  let o:=pullState (OB5.sig 209) raw
  let w:=run portal210 m o
  let v:=run (firstWindow d) m o
  let n1:=m.drop (measurementCount portal210)
  let n2:=n1.drop (measurementCount enter210)
  obtain ⟨g,s,inp,h⟩:=admitted_with_input d x p good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime raw m stage
  have gg (g s:Bool) (u v:Int) : (encode g s u v).g=g:=by cases g <;> rfl
