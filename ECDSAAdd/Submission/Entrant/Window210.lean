theorem pinned270 (d:Bool) (x p:Nat) (good:Bounds x p) (raw s:State) (g sg pg ps:Bool) (m n:List Bool) (pre:At270 d x p raw s g sg pg ps) :
    let v:=run (NativePack270.nextWindow d) m s
