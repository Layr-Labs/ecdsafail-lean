      (ArchiveWindowPreserve.entering270 d s m q (List.mem_append.mpr (Or.inl hq)))
  have middle:Saved 240 x p ArchiveBoundary255.codePorts d (run leave270 n (run (NativePack270.nextWindow d) m s)):=by
