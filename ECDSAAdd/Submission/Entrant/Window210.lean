theorem carry210 (z:SkywalkRails.State) (s:State) (ready:onRails 9 15 z s.basis) :
    ∀q:Wire,1556≤q → q≤1724 → s.basis q=false:=by
  have portsEq:((ports (shape 9) 15).carry.map (windowNet 9))=List.range' 1556 169:=by decide +kernel
  intro q low high
