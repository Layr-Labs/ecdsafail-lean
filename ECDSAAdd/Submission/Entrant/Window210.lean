namespace ECDSAAdd.Entrant.StairPacket.Leave210FrontReady
open Arithmetic Partial PortalValues LeaveCompanion LeaveCompanion210 Leave210InputScan LeaveReadoutFrame
set_option maxRecDepth 50000
set_option maxHeartbeats 5000000

open Leave210Front LeaveSelector Leave210Selector

def watched : List Wire := [1731,1732]++List.range' 1559 39

theorem frame (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^151)
    (ready:onRails 9 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 151 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 151 15 z)).v) s.basis)
    (fresh:s.basis 1730=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false) :
    ∀q∈watched,(run entry m s).basis q=s.basis q := by
  let a:=SkywalkNat.step^[15] (Shadow.reduced 151 15 z)
  let e:=negative sg a.u
  let u:=run scanPart m s
  let t:=m.drop (measurementCount scanPart)
  let v:=run flipHistory t u
  let tape:=t.drop (measurementCount flipHistory)
  have scanActual:=Leave210InputScan.result s m a.u a.v G sg ready fresh
  have hist (q:Wire) (h:q∉flipHistory.map destination) : v.basis q=u.basis q := preserved _ _ _ _ h
  have phase : v.phase=u.phase := by rfl
  have outputBits (i:Nat) (hi:i<19) : v.basis (392+i)=((a.u+a.v)/2^151).testBit i ∧ v.basis (937+i)=((a.u-e.toNat)/2^151).testBit i := by
    have ok : ∀j:Fin 19,392+j.val∉flipHistory.map destination ∧ 937+j.val∉flipHistory.map destination := by decide +kernel
