namespace ECDSAAdd.Entrant.StairPacket.NativePack210
open Arithmetic MappedCompressed IntegerPacket SkywalkRails EnterProof
set_option maxRecDepth 30000
set_option maxHeartbeats 7000000
set_option exponentiation.threshold 1024
attribute [local irreducible] run onRails routed unrouted

def firstWindow (d:Bool) := Partial.portal210 ++ (Partial.enter210 ++ window d)
def firstUnwind (d:Bool) := unwind d ++ (Partial.enter210Inv ++ Partial.portal210Inv)

theorem first_window (d:Bool) (seed p:Nat) (hp0:0<p) (hx0:0<seed) (hpo:p%2=1) (hp:p<2^256)
    (hq:p+2^32≤2^256) (hx:seed<p) (hc:seed.Coprime p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d seed p 210 raw.basis) :
    let z:=SkywalkNat.step^[210] (SkywalkNat.init seed p)
    let origin:=pullState (OB5.sig 209) raw
    let out:=run (firstWindow d) m origin
    out.phase=raw.phase ∧ (∃G S:Bool,
      let T:=Shadow.reduced 151 15 z
      onRails idx 15 (SkywalkTrace.next^[15] (encode G S T.u T.v)) out.basis ∧
      readCells (shape idx) 0 15 (mappedBasis idx out.basis)=SkywalkTrace.trace 15 (encode G S z.u z.v)) ∧
      ∀n,run (firstUnwind d) n out=origin := by
  let z:=SkywalkNat.step^[210] (SkywalkNat.init seed p)
  let origin:=pullState (OB5.sig 209) raw
  let cut:=run Partial.portal210 m origin
  let n:=m.drop (measurementCount Partial.portal210)
  let pre:=run Partial.enter210 n cut
  let tape:=n.drop (measurementCount Partial.enter210)
  let T:=Shadow.reduced 151 15 z
  have small:min z.u z.v<2^151:=true_small seed p 210 (by omega) hp (by decide)
  obtain ⟨G,S,input⟩:=PortalValues.real_input d seed p 210 hp0 hx0 hpo hp hq hx hc (by decide) raw stage
  have pcut:=Portal210Flag.physical_frame_for d seed p hp0 hx0 hpo hp hq hx hc raw m stage G S input
  have same:Shadow.far 151 15 z=(3*2^167≤z.u+z.v):=by
    apply propext
    unfold Shadow.far Shadow.high Shadow.limb
    exact Nat.le_div_iff_mul_le (by positivity)
  have normalized:PackedCut Enter210.lowerPairs Enter210.upperPairs 225 1730 1728 1729 (PortalValues.negative S z.u)
      (decide (Shadow.far 151 15 z)) (decide (Shadow.far 151 15 z ∧ 2^151≤z.u)) origin cut:=by
    simpa only [same] using pcut
  have ready:=Enter210.ready_from_cut raw cut z G S n small normalized input
    (fun r=>by simpa only [Nat.add_assoc] using stock_history d seed p 210 raw stage (210+r) (by omega) (by have hr:=r.isLt;omega))
  have zo:z.v%2=1:=(SkywalkNat.iter_valid 210 (SkywalkNat.init seed p) hp0 hpo).2.1
  have to':T.v%2=1:=shadow_odd 151 z small zo
  have parity:((encode G S T.u T.v).a+(encode G S T.u T.v).b)%2=1:=encode_odd_sum G S _ _ (by omega)
  have initial:=original_legal d seed p hp0 hpo raw stage
  have legal:=legal_congr (history_from_stock raw cut pre pcut n tape rfl _ parity ready.2) initial
  have whole:=window_run d pre tape _ parity ready.2 legal
  dsimp only [firstWindow,firstUnwind]
  simp only [run_append,run_take]
  refine ⟨whole.1.trans (ready.1.trans pcut.phase),⟨G,S,whole.2.1,whole.2.2.1.trans (true_records 151 z small zo G S)⟩,?_⟩
  intro inv
  rw [whole.2.2.2 inv]
  have rollback:=return_packed Enter210.layout map210 _ _ inc210 (fun _=>rfl) rfl emitted210 emitted210Inv
    raw cut z G S small normalized input n
  rw [rollback]
  exact Portal210Flag.portal_return _ m _ (Portal210Flag.clean_for raw z G S input)
#print axioms first_window
end ECDSAAdd.Entrant.StairPacket.NativePack210

