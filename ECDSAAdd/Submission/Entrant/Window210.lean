    (shadow:∀i<18,s.basis (393+i)=(Leave210TrueMiddle.X z).testBit i)
    (bank:regValue ys s.basis=if Shadow.far 151 15 z then Shadow.high 151 15 z else 0)
    (zero:∀q∈[ports.crossing,ports.near]++List.range' 1559 39,s.basis q=false)
    (par:parityBits ports s.basis=oddBits (IntegerHigh.letters 15 (Shadow.reduced 151 15 z)))
    (mode:actualMode 151 z=farMode (s.basis 1728) (s.basis 1729) z.u)
    (events:right (actualMode 151 z)=true → ∀i<15,i≤LeaveSelector.key (actualMode 151 z) → s.basis (Leave210Hit.swaps i)=decide (i=LeaveSelector.key (actualMode 151 z))) :
    let out:=run body tape s
    let t:=run (fullPrefix false) tape s
    out.phase=s.phase ∧ (∀i<106,out.basis (live i)=(Leave210TrueMiddle.F z).testBit i) ∧
    (∀j:Fin 18,out.basis (row j).free=false) ∧ (∀j:Fin 39,out.basis (1559+j.val)=false) ∧
    (∀q,outside wire 106 q → (∀r∈columns,q≠r.shadow ∧ q≠r.tube) → out.basis q=cleared t.basis q) := by
  let k:=actualMode 151 z
  let t:=run (fullPrefix false) tape s
  have base : ∀q:Nat,1561≤q → q≤1597 → s.basis q=false := by
    intro q lo hi
    apply zero
    apply List.mem_append_right
    rw [List.mem_range']; exact ⟨q-1559,by omega,by omega⟩
  have prepared:t=⟨s.phase,fun q=>(prior k q).read s.basis⟩ := preparedState false s tape s.basis z.u k mode
    (zero _ (by decide)) (zero _ (by decide))
    (beforeFresh _ _ _ base (zero _ (by decide)) (zero _ (by decide))) events
  have sym (q:Wire):t.basis q=(prior k q).read s.basis := congrArg (fun st:State=>st.basis q) prepared
  have keep (q:Wire) (ok:untouched q) : t.basis q=s.basis q := preserved _ s tape q ok
  have cs : ∀q∈carries,untouched q := by decide +kernel
  have pad : ∀i:Fin 106,91 ≤ i.val → untouched (wire i) := by decide +kernel
  have sh : ∀i:Fin 18,untouched (393+i.val) := by decide +kernel
  have ysOK : ∀q∈ys,untouched q := by decide +kernel
  have pa : ∀q∈paritySites,untouched q := by decide +kernel
  have sw : ∀i:Fin 15,untouched (Leave210Hit.swaps i) := by decide +kernel
  have math:=Leave210Loaded.signed z s.basis small odd room (fun i hi=>shadow i (Nat.lt_trans hi (by decide : 16<18))) par
  have flags:=mode_flags (s.basis 1728) (s.basis 1729) (⟨IntegerHigh.wait 15 z.u, by have h:=IntegerHigh.wait_le 15 z.u;omega⟩:Fin 16)
  have leftOK:left k=(t.basis 1728 && t.basis 1729) := by rw [keep _ (by decide),keep _ (by decide),show k=_ from mode]; exact flags.1
  have rightOK:right k=(t.basis 1728 && !t.basis 1729) := by rw [keep _ (by decide),keep _ (by decide),show k=_ from mode]; exact flags.2.1
  have done:=Leave210Core.result z t (tape.drop (measurementCount (fullPrefix false))) k s.basis small odd room
    (fun q h=>(keep _ (cs q h)).trans (clean q h)) (fun i lo hi=>(keep _ (pad ⟨i,hi⟩ lo)).trans (padding i lo hi))
    (fun q h=>(sym q).trans (Leave210Loaded.tags z s.basis q h)) (fun i h=>(keep _ (sh ⟨i,h⟩)).trans (shadow i h))
    (((regValue_eq_iff _ _ _).mpr (fun q h=>keep _ (ysOK q h))).trans bank)
    ((sym _).trans math.1) (fun far=>(sym _).trans (math.2.2 far)) (fun j=>sym _)
    (fun q h=>(keep _ (pa q h)).symm) (by rw [sym 1597,sym 1731]; exact math.2.1) leftOK rightOK
    (fun on i hi h=>(keep _ (sw ⟨i,hi⟩)).trans (events on i hi h))
  dsimp only
  rw [shape,run_append,run_take]
  exact ⟨done.1.trans (by rw [prepared]),done.2⟩

end ECDSAAdd.Entrant.StairPacket.Leave210Routed

