theorem byDigits (key : Fin 16) (x : Nat) (s : State) (m : List Bool)
    (small : x < 2^91) (h : holds wire 106 x s) (clean : s.basis 1613=false)
    (bit0 : parity s.basis controls0 = key.val.testBit 0)
    (bit1 : parity s.basis controls1 = key.val.testBit 1)
    (bit2 : parity s.basis controls2 = key.val.testBit 2)
    (bit3 : parity s.basis controls3 = key.val.testBit 3) :
    Result wire 106 (x <<< key.val) s (run ((leave210.drop 787).take 1189) m s) := by
  rw [emitted]
  have beginPass : ∀ m, Result wire 106 (x <<< 0) s (run passes0 m s) := HighBankBarrel.start h
  have p1 : ∀ m, Result wire 106 (x <<< (key.val % 2)) s (run passes1 m s) := by
    apply next layout3 (by decide) (by decide) away0.1 _ clean (room small (by omega : 91+0 ≤ 91)) _ beginPass
    · have dis : ∀ q ∈ controls0, q ∉ bank3 := by decide +kernel
      intro q hq i hi eq
      change q = bank3.getD i 0 at eq
      rw [List.getD_eq_getElem _ _ (show i < bank3.length from hi)] at eq
      exact dis q hq (eq ▸ List.getElem_mem _)
    · rw [bit0]
      exact (by decide +kernel : ∀ key : Fin 16, 0 + (if key.val.testBit 0 then 1 else 0) = (key.val % 2)) key
  have p2 : ∀ m, Result wire 106 (x <<< (key.val % 4)) s (run passes2 m s) := by
    apply next layout3 (by decide) (by decide) away1.1 _ clean (room small (by omega : 91+(key.val % 2) ≤ 92)) _ p1
    · have dis : ∀ q ∈ controls1, q ∉ bank3 := by decide +kernel
      intro q hq i hi eq
      change q = bank3.getD i 0 at eq
      rw [List.getD_eq_getElem _ _ (show i < bank3.length from hi)] at eq
      exact dis q hq (eq ▸ List.getElem_mem _)
    · rw [bit1]
      exact (by decide +kernel : ∀ key : Fin 16, (key.val % 2) + (if key.val.testBit 1 then 2 else 0) = (key.val % 4)) key
  have p3 : ∀ m, Result wire 106 (x <<< (key.val % 8)) s (run passes3 m s) := by
    apply next layout3 (by decide) (by decide) away2.1 _ clean (room small (by omega : 91+(key.val % 4) ≤ 94)) _ p2
    · have dis : ∀ q ∈ controls2, q ∉ bank3 := by decide +kernel
      intro q hq i hi eq
      change q = bank3.getD i 0 at eq
      rw [List.getD_eq_getElem _ _ (show i < bank3.length from hi)] at eq
      exact dis q hq (eq ▸ List.getElem_mem _)
    · rw [bit2]
      exact (by decide +kernel : ∀ key : Fin 16, (key.val % 4) + (if key.val.testBit 2 then 4 else 0) = (key.val % 8)) key
  have p4 : ∀ m, Result wire 106 (x <<< key.val) s (run passes4 m s) := by
