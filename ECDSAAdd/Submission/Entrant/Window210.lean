namespace ECDSAAdd.Entrant.StairPacket.Leave210Admission
open Arithmetic Partial LeaveCompanion LeaveCompanion210 PortalValues Leave210Barrel Leave210High HighBankBarrel
open Leave210Front LeaveSelector Leave210Selector Leave210OutputPorts LeaveReadoutFrame IntegerHigh Leave210Close
open Leave210Relocated StairArchiveTrace
open IntegerPacket
open MappedCompressed IntegerPacket SkywalkRails
set_option maxRecDepth 20000
set_option exponentiation.threshold 1024
attribute [local irreducible] run SkywalkNat.step
structure Numeric (z:SkywalkNat.State):Prop where
  small:min z.u z.v<2^151
  odd:z.v%2=1
  room:Shadow.high 151 15 z+1<2^91
  nextSmall:min (SkywalkNat.step^[15] z).u (SkywalkNat.step^[15] z).v<2^144
  bound:Leave210TrueMiddle.F z<2^106

theorem actualNumbers (x p:Nat) (hp0:0<p) (odd:p%2=1) (hx:x<2^256) (hp:p<2^256):
    Numeric (SkywalkNat.step^[210] (SkywalkNat.init x p)):=by
  let z:=SkywalkNat.step^[210] (SkywalkNat.init x p)
  have env:z.u+z.v≤2^256+2^255:=LeaveBankEnvelope.after_first x p (2^256) hx.le hp.le 209
  have short:=true_small x p 225 hx hp (by decide)
  have it:SkywalkNat.step^[15] z=SkywalkNat.step^[225] (SkywalkNat.init x p):=by
    exact (Function.iterate_add_apply SkywalkNat.step 15 210 _).symm
  refine ⟨true_small x p 210 hx hp (by decide),(SkywalkNat.iter_valid 210 (SkywalkNat.init x p) hp0 odd).2.1,
    LeaveBankEnvelope.bounds210 z env,?_,LeaveBankEnvelope.outputs210 z (by omega) 15⟩
  rw [it];exact short

def flags (z:SkywalkNat.State) (g0 s0:Bool):Bool×Bool:=
  SharedSigned.flags g0 s0 (SkywalkTrace.trace 15 (encode g0 s0 z.u z.v))
structure Inputs (s:State) (z:SkywalkNat.State) (g0 s0:Bool):Prop extends Numeric z where
  ready:onRails 9 15 (encode (flags z g0 s0).1 (flags z g0 s0).2
    (SkywalkNat.step^[15] (Shadow.reduced 151 15 z)).u (SkywalkNat.step^[15] (Shadow.reduced 151 15 z)).v) s.basis
  fresh:s.basis 1730=false
  scratch:∀q∈1556::1557::1558::fullC,s.basis q=false
  temp:∀p∈longPairs,s.basis p.2=false
  clean:∀q∈carries,s.basis q=false
  padding:∀t:Nat,91≤t→t<106→s.basis (wire t)=false
  bank:regValue ys s.basis=if Shadow.far 151 15 z then Shadow.high 151 15 z else 0
  zero:∀q∈Leave210FrontReady.watched,s.basis q=false
  far:s.basis 1728=decide (Shadow.far 151 15 z)
  side:s.basis 1729=(decide (Shadow.far 151 15 z) && decide (2^151≤z.u))
  record:readCells (shape 9) 0 15 (mappedBasis 9 s.basis)=SkywalkTrace.trace 15 (encode g0 s0 z.u z.v)
def spare:List Wire:=[1731, 1732]
private def touch:= (1556::1557::1558::fullC) ++ longPairs.map Prod.snd ++ carries ++ ((List.range' 91 15).map wire) ++ Leave210FrontReady.watched
private theorem geometry:∀q∈touch,(1556≤q ∧ q≤1724) ∨ q∈spare:=by decide +kernel
theorem assemble (s:State) (z:SkywalkNat.State) (g0 s0:Bool) (numbers:Numeric z)
    (rails:onRails 9 15 (SkywalkTrace.next^[15] (encode g0 s0 (Shadow.reduced 151 15 z).u (Shadow.reduced 151 15 z).v)) s.basis)
    (record:readCells (shape 9) 0 15 (mappedBasis 9 s.basis)=SkywalkTrace.trace 15 (encode g0 s0 z.u z.v))
    (saved:regValue ys s.basis=(if Shadow.far 151 15 z then Shadow.high 151 15 z else 0) ∧
      s.basis 1730=false ∧ s.basis 1728=decide (Shadow.far 151 15 z) ∧ s.basis 1729=decide (Shadow.far 151 15 z ∧ 2^151≤z.u))
    (ex:∀q∈spare,s.basis q=false):Inputs s z g0 s0:=by
  have cl:=carry210 _ s rails
  have all (q:Wire) (hit:q∈touch):s.basis q=false:=by
    rcases geometry q hit with h|h
    · exact cl q h.1 h.2
    · exact ex q h
  refine ⟨numbers,?_,saved.2.1,?_,?_,?_,?_,saved.1,?_,saved.2.2.1,?_,record⟩
  · exact (SharedSigned.same _ z numbers.small numbers.odd g0 s0).1 ▸ rails
  · intro q h;apply all;simp only [touch,List.mem_append];exact Or.inl (Or.inl (Or.inl (Or.inl h)))
  · intro t h;apply all;have mem:=List.mem_map_of_mem (f:=Prod.snd) h;simp only [touch,List.mem_append];exact Or.inl (Or.inl (Or.inl (Or.inr mem)))
  · intro q h;apply all;simp only [touch,List.mem_append];exact Or.inl (Or.inl (Or.inr h))
  · intro t lo hi
    have hit:t∈List.range' 91 15:=List.mem_range'_1.mpr ⟨lo,hi⟩
    apply all
    have mem:=List.mem_map_of_mem (f:=wire) hit
    simp only [touch,List.mem_append];exact Or.inl (Or.inr mem)
  · intro q h;apply all;simp only [touch,List.mem_append];exact Or.inr h
  · rw [saved.2.2.2]
    by_cases f:Shadow.far 151 15 z <;> simp [f]
end ECDSAAdd.Entrant.StairPacket.Leave210Admission

