theorem result (s : State) (m : List Bool)
    (clean : ∀ q ∈ carries, s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀ i : Nat, 91 ≤ i → i < 106 → s.basis (wire i)=false)
    (off : ∀ q ∈ Leave210Join.tags, s.basis q=false) :
    let x := adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597)
    Result wire 106 x s (run ((leave210.drop 334).take 1642) m s) := by
  let p := adjust ys carries 1731 1597
  let t := run p m s
  let x := regValue ys t.basis
  have ht := HighBankAdjust.correct ys carries 1731 1597 (by decide +kernel) (by decide +kernel) (by decide) s m clean
  have coord : ∀ i : Fin 91, wire i = ys.getD i 0 := by decide +kernel
  have pad : ∀ i : Fin 106, 91 ≤ i.val → wire i ∉ ys := by decide +kernel
  have small : x < 2^91 := regValue_lt ys t.basis
  have data : holds wire 106 x t := by
    intro i hi
    by_cases lo : i < 91
    · rw [coord ⟨i,lo⟩]
      exact bit_read ys i t.basis lo
    · rw [Nat.testBit_lt_two_pow (small.trans_le (Nat.pow_le_pow_right (by decide) (by omega)))]
      exact (ht.2.1 _ (pad ⟨i,hi⟩ (show 91 ≤ i by omega))).trans (padding i (by omega) hi)
  have cold : t.basis 1613=false := (ht.2.1 _ (by decide +kernel)).trans selectZero
  have untouched : ∀ q ∈ Leave210Join.tags, q ∉ ys := by decide +kernel
  have keys : ∀ q ∈ Leave210Join.tags, t.basis q=false :=
    fun q h => (ht.2.1 _ (untouched _ h)).trans (off _ h)
  have quiet (xs : List Wire) (sub : ∀ q ∈ xs, q ∈ Leave210Join.tags) : parity t.basis xs = false := by
    induction xs with
    | nil => rfl
    | cons q qs ih =>
      simp only [parity,keys q (sub _ (by simp)),Bool.false_xor,ih (fun z h => sub _ (List.mem_cons_of_mem _ h))]
  have action := Leave210BarrelBits.byDigits 0 x t (m.drop (measurementCount p)) small data cold
    (quiet _ (by decide +kernel)) (quiet _ (by decide +kernel)) (quiet _ (by decide +kernel)) (quiet _ (by decide +kernel))
  have initial : x = adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597) := ht.2.2
  dsimp only
  rw [combined,run_append,run_take,←initial]
  refine ⟨(by simpa only [Fin.val_zero,Nat.shiftLeft_zero] using action.bits),action.phase.trans ht.1,fun q h => (action.frame q h).trans (ht.2.1 q ?_)⟩
  intro member
  obtain ⟨i,hi,he⟩ := List.getElem_of_mem member
