namespace ECDSAAdd.Entrant.StairPacket.StockWindowTicket
open Arithmetic IntegerPacket WideReference SkywalkRails Partial MappedCompressed
set_option maxRecDepth 30000
set_option maxHeartbeats 3200000
attribute [local irreducible] run body measurementCount leave210 leave210Inv NativePack210.firstWindow NativePack210.firstUnwind

private theorem physical210 (d:Bool) (x p:Nat) (good:Bounds x p) (s:State) (m n:List Bool)
    (pre:Before d x p s) :
    let v:=run (NativePack210.firstWindow d) m s
    let out:=run leave210 n v
    out.phase=s.phase ∧ Ready225 d x p out ∧ (∀k,run leave210Inv k out=v) ∧ (∀k,run (NativePack210.firstUnwind d) k v=s) := by
  obtain ⟨raw,stage,rfl⟩:=pre
  let s:=pullState (OB5.sig 209) raw
  let v:=run (NativePack210.firstWindow d) m s
  let out:=run leave210 n v
  let raw':=endRaw 210 raw v
  obtain ⟨g,sg,input,h,cut,facts⟩:=NativePack210.stock_endpoint d x p good raw m n stage
  let flags:=Leave210Admission.flags (unsigned 210 x p) g sg
  have dom:=initial 210 x p (by decide) d raw stage
  have carried:=stepInput 210 151 x p (by decide) (by decide) fixed210 good raw v g sg dom input h.small
  have base:out.phase=raw'.phase:=cutPhase cut
  have ph:=base.trans (endRaw_phase 210 x p (by decide) good raw v dom)
  have back:=NativePack210.first_window d x p good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime raw m stage
  exact ⟨ph,⟨raw',flags.1,flags.2,g,sg,carried.1,carried.2,cut,facts,unique_input input (fixed_input 210 x p (by decide) good raw dom)⟩,
    h.roundtrip n,back.2.2⟩

theorem step210 (d:Bool) (x p:Nat) (good:Bounds x p) :
    Checked (NativePack210.firstWindow d++leave210) (leave210Inv++NativePack210.firstUnwind d) (Before d x p) (Ready225 d x p) := by
  apply pair (F:=NativePack210.firstWindow d) (F':=leave210) (R:=NativePack210.firstUnwind d) (R':=leave210Inv)
  intro s m h
  exact physical210 d x p good s m _ h
end ECDSAAdd.Entrant.StairPacket.StockWindowTicket

