def ys : List Wire := [1725, 1726, 1727, 956, 957, 958, 959, 960, 961, 962, 963, 964, 965, 966, 967, 968, 969, 970, 971, 972, 973, 974, 975, 976, 977, 978, 979, 980, 981, 982, 983, 984, 985, 986, 987, 988, 989, 990, 991, 992, 993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1022, 1023, 1024, 1025, 1026, 1027, 1028, 1029, 1030, 1031, 1032, 1033, 1034, 1035, 1036, 1037, 1038, 1039, 1040, 1041, 1042, 1043]
def carries : List Wire := [1598, 1599, 1600, 1601, 1602, 1603, 1604, 1605, 1606, 1607, 1608, 1609, 1610, 1611, 1612, 1613, 1614, 1615, 1616, 1617, 1618, 1619, 1620, 1621, 1622, 1623, 1624, 1625, 1626, 1627, 1628, 1629, 1630, 1631, 1632, 1633, 1634, 1635, 1636, 1637, 1638, 1639, 1640, 1641, 1642, 1643, 1644, 1645, 1646, 1647, 1648, 1649, 1650, 1651, 1652, 1653, 1654, 1655, 1656, 1657, 1658, 1659, 1660, 1661, 1662, 1663, 1664, 1665, 1666, 1667, 1668, 1669, 1670, 1671, 1672, 1673, 1674, 1675, 1676, 1677, 1678, 1679, 1680, 1681, 1682, 1683, 1684, 1685, 1686, 1687]

theorem emitted : ((leave210.drop 334).take 453) = adjust ys carries 1731 1597 := by rfl
theorem combined : ((leave210.drop 334).take 1642) =
    adjust ys carries 1731 1597 ++ ((leave210.drop 787).take 1189) := by rfl

theorem result (key : Fin 16) (s : State) (m : List Bool)
    (clean : ∀ q ∈ carries, s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀ i : Nat, 91 ≤ i → i < 106 → s.basis (wire i)=false)
    (one : ∀ q ∈ Leave210Join.tags, s.basis q = decide (q = Leave210Join.tags.getD key 0)) :
    let x := adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597)
    Result wire 106 (x <<< key.val) s (run ((leave210.drop 334).take 1642) m s) := by
  let p := adjust ys carries 1731 1597
  let t := run p m s
  let x := regValue ys t.basis
  have ht := HighBankAdjust.correct ys carries 1731 1597 (by decide +kernel) (by decide +kernel) (by decide) s m clean
  have coord : ∀ i : Fin 91, wire i = ys.getD i 0 := by decide +kernel
  have pad : ∀ i : Fin 106, 91 ≤ i.val → wire i ∉ ys := by decide +kernel
  have small : x < 2^91 := regValue_lt ys t.basis
  have data : holds wire 106 x t := by
    intro i hi
    by_cases lo : i < 91
    · rw [coord ⟨i,lo⟩]
      exact bit_read ys i t.basis lo
    · rw [Nat.testBit_lt_two_pow (small.trans_le (Nat.pow_le_pow_right (by decide) (by omega)))]
      exact (ht.2.1 _ (pad ⟨i,hi⟩ (show 91 ≤ i by omega))).trans (padding i (by omega) hi)
  have cold : t.basis 1613=false := (ht.2.1 _ (by decide +kernel)).trans selectZero
  have untouched : ∀ q ∈ Leave210Join.tags, q ∉ ys := by decide +kernel
  have keys : ∀ q ∈ Leave210Join.tags, t.basis q = decide (q = Leave210Join.tags.getD key 0) :=
    fun q h => (ht.2.1 _ (untouched _ h)).trans (one _ h)
  have action := value key x t (m.drop (measurementCount p)) small data cold keys
  have initial : x = adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597) := ht.2.2
  dsimp only
  rw [combined,run_append,run_take,←initial]
  refine ⟨action.bits,action.phase.trans ht.1,fun q h => (action.frame q h).trans (ht.2.1 q ?_)⟩
  intro member
  obtain ⟨i,hi,he⟩ := List.getElem_of_mem member
  have inside := coord ⟨i,hi⟩
  rw [List.getD_eq_getElem _ _ hi] at inside
  exact h i (by change i < 91 at hi; omega) (he.symm.trans inside.symm)

end ECDSAAdd.Entrant.StairPacket.Leave210High

