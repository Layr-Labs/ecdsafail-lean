    intro q hq
    exact (ArchiveWindowPreserve.after270 v n q (List.mem_append.mpr (Or.inl (List.mem_append.mpr (Or.inr (List.mem_append.mpr (Or.inl hq))))))).trans
      (ArchiveWindowPreserve.entering270 d s m q (List.mem_append.mpr (Or.inr (List.mem_append.mpr (Or.inl hq)))))
  have middle:Saved 240 x p ArchiveBoundary255.codePorts d out:=by
