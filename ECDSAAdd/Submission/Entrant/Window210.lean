namespace ECDSAAdd.Entrant.StairPacket.Leave210Middle
open Arithmetic Partial Leave210Barrel Leave210High Leave210Word Leave210Join HighBankBarrel HighBankAdjust

set_option maxRecDepth 50000
set_option maxHeartbeats 4000000

abbrev first := ((leave210.drop 334).take 1642)
abbrev lastPart := ((leave210.drop 1978).take 107)
abbrev signBit : Program := [.X 1613,.CX 1597 1613]
abbrev middle := ((leave210.drop 334).take 1751)

theorem split : middle = first ++ (signBit ++ lastPart) := by rfl

/-- Keep the semantic composition independent of the concrete prefix and suffix programs. -/
private theorem abstractMiddle (early late combined : Program)
    (parts : combined = early ++ (signBit ++ late))
    (highLaw : ∀ (key : Fin 16) (s : State) (m : List Bool)
    (_clean : ∀ q ∈ carries, s.basis q=false) (_selectZero : s.basis 1613=false)
    (_padding : ∀ i : Nat, 91 ≤ i → i < 106 → s.basis (wire i)=false)
    (_one : ∀ q ∈ Leave210Join.tags, s.basis q = decide (q = Leave210Join.tags.getD key 0)),
    let x := adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597)
    Result wire 106 (x <<< key.val) s (run early m s))
    (wordLaw : ∀ (key : Fin 16) (X H : Nat) (s : State) (m : List Bool)
    (_tagsOn : ∀ q ∈ tags, s.basis q = hot key q)
    (_shadow : ∀ i < 18, s.basis (393+i)=X.testBit i)
    (_tube : ∀ i < 18, s.basis (wire i)=(2^key.val*H).testBit i)
    (_digit : X/2^key.val = (s.basis 1731).toNat + 2*(s.basis 1613).toNat)
    (_scratch : s.basis 1614=false),
    let out := run late m s
    out.phase=s.phase ∧
      (∀ i : Fin 18, out.basis (row i).keep = (2^key.val*H+X%2^key.val).testBit i ∧ out.basis (row i).free=false) ∧
      ∀ q, (∀ r ∈ columns, q≠r.shadow ∧ q≠r.tube) → out.basis q=s.basis q)
    (key : Fin 16) (X : Nat) (s : State) (m : List Bool)
    (clean : ∀ q ∈ carries, s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀ i : Nat, 91 ≤ i → i < 106 → s.basis (wire i)=false)
    (one : ∀ q ∈ tags, s.basis q = hot key q)
    (shadow : ∀ i < 18, s.basis (393+i)=X.testBit i)
    (digit : X/2^key.val = (s.basis 1731).toNat + 2*(!s.basis 1597).toNat)
    (scratch : s.basis 1614=false) :
    let H := adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597)
    let out := run combined m s
    out.phase=s.phase ∧
      (∀ i : Fin 18, out.basis (row i).keep=(2^key.val*H+X%2^key.val).testBit i ∧ out.basis (row i).free=false) ∧
      (∀ i : Fin 106, 18 ≤ i.val → out.basis (wire i.val)=(2^key.val*H).testBit i.val) ∧
      (∀ q, q≠1613 → outside wire 106 q → (∀ r ∈ columns, q≠r.shadow ∧ q≠r.tube) → out.basis q=s.basis q) := by
  let H := adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597)
  let v := run early m s
  let tape := m.drop (measurementCount early)
  let u := run signBit tape v
  have a := highLaw key s m clean selectZero padding one
  have bits (i : Fin 106) : v.basis (wire i.val)=(2^key.val*H).testBit i.val := by
    rw [Nat.mul_comm (2^key.val) H,← Nat.shiftLeft_eq]
    exact a.bits i.val i.isLt
  have unchanged (q : Wire) (ne : q≠1613) : u.basis q = v.basis q := by simp [u,run,writeBit,Function.update,ne]
  have old (q : Wire) (ne : q≠1613) (ext : ∀ i : Fin 106, q≠wire i.val) : u.basis q=s.basis q :=
    (unchanged q ne).trans (a.frame q (fun i h => ext ⟨i,h⟩))
  have tagsOutside : ∀ q ∈ tags, q≠1613 ∧ ∀ i : Fin 106, q≠wire i.val := by decide +kernel
  have shadows : ∀ j : Fin 18, 393+j.val≠1613 ∧ ∀ i : Fin 106, 393+j.val≠wire i.val := by decide +kernel
  have stable (i : Fin 106) : 1613 ≠ wire i.val := Leave210Shift.layout3.separate i.val i.isLt
  have readTags (q : Wire) (hq : q∈tags) : u.basis q=hot key q := (old q (tagsOutside q hq).1 (tagsOutside q hq).2).trans (one q hq)
  have readShadow (i : Nat) (hi : i<18) : u.basis (393+i)=X.testBit i := by
    let j : Fin 18 := ⟨i,hi⟩
    exact (old _ (shadows j).1 (shadows j).2).trans (shadow i hi)
  have readTube (i : Nat) (hi : i<18) : u.basis (wire i)=(2^key.val*H).testBit i := by
    let j : Fin 106 := ⟨i,by omega⟩
    exact (unchanged _ (stable j).symm).trans (bits j)
  have select : v.basis 1613=false := (a.frame _ Leave210Shift.layout3.separate).trans selectZero
  have neg : v.basis 1597=s.basis 1597 := a.frame _ (fun i h => (by decide +kernel : ∀ j : Fin 106, 1597≠wire j.val) ⟨i,h⟩)
  have d1 : u.basis 1613 = !s.basis 1597 := by
    simp [u,run,writeBit,Function.update,select,neg]
  have cross := old 1731 (by decide) (by decide +kernel)
  have zero := (old 1614 (by decide) (by decide +kernel)).trans scratch
  have exactDigit : X / 2^key.val = (u.basis 1731).toNat + 2*(u.basis 1613).toNat := by rw [cross,d1]; exact digit
  have word := wordLaw key X H u tape readTags readShadow readTube exactDigit zero
  dsimp only
  rw [parts,run_append,run_take,run_append,run_take,show measurementCount signBit=0 from rfl,List.drop_zero]
  refine ⟨word.1.trans a.phase,word.2.1,?_,?_⟩
  · intro i hi
    have outsideRows : ∀ i : Fin 106, 18 ≤ i.val → ∀ r ∈ columns, wire i.val≠r.shadow ∧ wire i.val≠r.tube := by decide +kernel
    exact (word.2.2 _ (outsideRows i hi)).trans ((unchanged _ (stable i).symm).trans (bits i))
  · intro q ne ext away
    exact (word.2.2 q away).trans ((unchanged q ne).trans (a.frame q ext))


theorem result (key : Fin 16) (X : Nat) (s : State) (m : List Bool)
    (clean : ∀ q ∈ carries, s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀ i : Nat, 91 ≤ i → i < 106 → s.basis (wire i)=false)
    (one : ∀ q ∈ tags, s.basis q = hot key q)
    (shadow : ∀ i < 18, s.basis (393+i)=X.testBit i)
    (digit : X/2^key.val = (s.basis 1731).toNat + 2*(!s.basis 1597).toNat)
    (scratch : s.basis 1614=false) :
    let H := adjusted (regValue ys s.basis) 91 (s.basis 1731) (s.basis 1597)
    let out := run middle m s
    out.phase=s.phase ∧
      (∀ i : Fin 18, out.basis (row i).keep=(2^key.val*H+X%2^key.val).testBit i ∧ out.basis (row i).free=false) ∧
      (∀ i : Fin 106, 18 ≤ i.val → out.basis (wire i.val)=(2^key.val*H).testBit i.val) ∧
      (∀ q, q≠1613 → outside wire 106 q → (∀ r ∈ columns, q≠r.shadow ∧ q≠r.tube) → out.basis q=s.basis q) :=
  abstractMiddle first lastPart middle split Leave210High.result Leave210Word.combine key X s m clean selectZero padding one shadow digit scratch
end ECDSAAdd.Entrant.StairPacket.Leave210Middle

