    intro q hq
    exact ArchiveWindowPreserve.after270 (run (NativePack270.nextWindow d) m s) n q (List.mem_append.mpr (Or.inr hq))
  have same:=unique_input pre.input (fixed_input _ _ _ (by decide) good raw pre.domain)
