namespace ECDSAAdd.Entrant.StairPacket.LeaveTerminalBound
open SkywalkNat HighBankSum

/-- Block 210: the stage at 225 is the narrower (257-wide) rail; the slot above it (live 105) contains zero. -/
theorem fit210 (x p : Nat) (xp:0<x) (pp:0<p) (odd:p%2=1) (bound:p<2^256)
    (small:x<p) (cop:x.Coprime p) :
    let z:=step^[210] (init x p)
    Leave210TrueMiddle.F z<2^105 := by
  have env:=LeaveBankEnvelope.after_first x p (2^256) (Nat.le_of_lt (Nat.lt_trans small bound)) (Nat.le_of_lt bound) 224
  dsimp only at env ⊢
  change total (step^[15] (step^[210] (init x p)))/2^152<2^105
  rw [←Function.iterate_add_apply]
  unfold total
  change ((step^[225] (init x p)).u+(step^[225] (init x p)).v)/2^152<2^105
  change (step^[225] (init x p)).u+(step^[225] (init x p)).v≤2^256+2^256/2 at env
  apply (Nat.div_lt_iff_lt_mul (by decide)).mpr
  norm_num1 at env ⊢
  omega
end ECDSAAdd.Entrant.StairPacket.LeaveTerminalBound

