theorem ready_from_cut (raw v:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^151)
    (p:PackedCut lowerPairs upperPairs 225 1730 1728 1729 (PortalValues.negative S z.u)
        (decide (Shadow.far 151 15 z)) (decide (Shadow.far 151 15 z ∧ 2^151≤z.u)) (pullState (OB5.sig 209) raw) v)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 210) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (hist:∀r:Fin 15,raw.basis (base (1028+210+r))=false)  :
    let t:=run Partial.enter210 m v
    let T:=Shadow.reduced 151 15 z
    t.phase=v.phase ∧ onRails idx 0 (SkywalkRails.encode G S T.u T.v) t.basis := by
  obtain ⟨ph,body,outer⟩:=from_full raw v z G S m small p input
  refine ⟨ph,complete live _ G S small raw v _ p input body outer ?_⟩
  intro r
  rw [hist_sources];exact hist r
  
  
  
theorem launch (d:Bool) (seed p:Nat) (hp0:0<p) (hx0:0<seed) (hpo:p%2=1) (hp:p<2^256)
    (hq:p+2^32≤2^256) (hx:seed<p) (hc:seed.Coprime p) (raw:State) (m:List Bool)
    (stage:Rolling1588.Integer.Stage base d seed p 210 raw.basis) :
    let z:=SkywalkNat.step^[210] (SkywalkNat.init seed p)
    let origin:=pullState (OB5.sig 209) raw
    let out:=run (Partial.portal210++Partial.enter210) m origin
    let T:=Shadow.reduced 151 15 z
    out.phase=raw.phase ∧ ∃G S:Bool,onRails idx 0 (SkywalkRails.encode G S T.u T.v) out.basis := by
  obtain ⟨G,S,input⟩:=PortalValues.real_input d seed p 210 hp0 hx0 hpo hp hq hx hc (by decide) raw stage
  have first:=Portal210Flag.physical_frame_for d seed p hp0 hx0 hpo hp hq hx hc raw m stage G S input
  have small:=true_small seed p 210 (by omega) hp (by decide)
  have farEq (z:SkywalkNat.State):Shadow.far 151 15 z ↔ 3*2^167≤z.u+z.v:=by
    unfold Shadow.far Shadow.high Shadow.limb;exact Nat.le_div_iff_mul_le (by positivity)
  let z:=SkywalkNat.step^[210] (SkywalkNat.init seed p)
  have same:Shadow.far 151 15 z=(3*2^167≤z.u+z.v):=propext (farEq _)
  change PackedCut lowerPairs upperPairs 225 1730 1728 1729 _ (decide (3*2^167≤z.u+z.v))
    (decide (3*2^167≤z.u+z.v ∧ 2^151≤z.u)) _ _ at first
  have normalized:PackedCut lowerPairs upperPairs 225 1730 1728 1729 (PortalValues.negative S z.u)
      (decide (Shadow.far 151 15 z)) (decide (Shadow.far 151 15 z ∧ 2^151≤z.u)) (pullState (OB5.sig 209) raw) (run Partial.portal210 m (pullState (OB5.sig 209) raw)):=by
    simpa only [same] using first
  have h:=ready_from_cut raw _ z G S (m.drop (measurementCount Partial.portal210)) small normalized input
    (fun r=>by simpa only [Nat.add_assoc] using stock_history d seed p 210 raw stage (210+r) (by omega) (by have hr:=r.isLt;omega))
  simp only [run_append,run_take]
  exact ⟨h.1.trans first.phase, G,S,h.2⟩
#print axioms launch
#print axioms ready_from_cut
end ECDSAAdd.Entrant.StairPacket.Enter210

