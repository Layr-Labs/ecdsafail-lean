namespace ECDSAAdd.Entrant.StairPacket.Leave210Core
open Arithmetic Partial Leave210SignClose Leave210Selector LeaveSelector Leave210Barrel Leave210High Leave210Word Leave210Join
open HighBankBarrel Leave210RetireActual Leave210OutputPorts
set_option maxRecDepth 50000
set_option maxHeartbeats 5000000

def work:=((leave210.drop 334).take 1823)
theorem shape : work=extended++fullPostfix false := by decide +kernel
def watched := (List.range' 1559 39)++paritySites++[1731,1728,1729]++(List.range 15).map Leave210Hit.swaps

theorem untouched : ∀q∈watched,q≠1613 ∧ (∀i:Fin 106,q≠wire i.val) ∧
    ∀a∈columns,q≠a.shadow ∧ q≠a.tube := by decide +kernel

attribute [local irreducible] run

private theorem finish (z:SkywalkNat.State) (s a t:State)
    (fix:t=⟨a.phase,writeBit a.basis 1613 false⟩) (clean:s.basis 1613=false)
    (ar:a.phase=s.phase ∧ (∀i<106,a.basis (live i)=(Leave210TrueMiddle.F z).testBit i) ∧
      (∀i:Fin 18,a.basis (row i).free=false) ∧
      ∀q,q≠1613 → outside wire 106 q → (∀r∈columns,q≠r.shadow ∧ q≠r.tube) → a.basis q=s.basis q) :
    t.phase=s.phase ∧ (∀i<106,(cleared t.basis) (live i)=(Leave210TrueMiddle.F z).testBit i) ∧
      (∀j:Fin 18,(cleared t.basis) (row j).free=false) ∧ (∀j:Fin 39,(cleared t.basis) (1559+j.val)=false) ∧
      (∀q,outside wire 106 q → (∀a∈columns,q≠a.shadow ∧ q≠a.tube) → (cleared t.basis) q=cleared s.basis q) := by
  have base (q:Wire) (diff:q≠1613) : t.basis q=a.basis q := by rw [fix];simp [writeBit,diff]
  have pass (q:Nat) (diff:q≠1613 ∧ ¬(1559≤q ∧ q≤1597)) : cleared t.basis q=a.basis q := by
    rw [cleared,if_neg diff.2];exact base _ diff.1
  refine ⟨(congrArg State.phase fix).trans ar.1,?_,?_,?_,?_⟩
  · intro i h
    have geom : ∀j:Fin 106,live j≠1613 ∧ ¬(1559≤live j ∧ live j≤1597) := by decide +kernel
    exact (pass _ (geom ⟨i,h⟩)).trans (ar.2.1 i h)
  · intro j
    have geom : ∀j:Fin 18,(row j).free≠1613 ∧ ¬(1559≤(row j).free ∧ (row j).free≤1597) := by decide +kernel
    exact (pass _ (geom j)).trans (ar.2.2.1 j)
  · intro j;have h:=j.isLt
    change (if 1559≤1559+j.val ∧ 1559+j.val≤1597 then _ else _)=_
    rw [if_pos (by omega)]
  · intro q out cols
    by_cases eq:q=1613
    · subst q
      change t.basis 1613=s.basis 1613
      rw [fix,clean]
      simp [writeBit]
    · unfold cleared
      split
      · rfl
      · exact (base _ eq).trans (ar.2.2.2 _ eq out cols)


theorem result (z:SkywalkNat.State) (s:State) (tape:List Bool) (k:Mode) (ref:BasisState)
    (small:min z.u z.v<2^151) (odd:z.v%2=1) (room:Shadow.high 151 15 z+1<2^91)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,91 ≤ i → i<106 → s.basis (wire i)=false)
    (tag:∀q∈Leave210Join.tags,s.basis q=if Shadow.far 151 15 z then Leave210Word.hot (Leave210TrueMiddle.key z) q else false)
    (shadow:∀i<18,s.basis (393+i)=(Leave210TrueMiddle.X z).testBit i)
    (bank:regValue ys s.basis=if Shadow.far 151 15 z then Shadow.high 151 15 z else 0)
    (cin:s.basis 1731=if Shadow.far 151 15 z then HighBankSum.cross (Leave210TrueMiddle.d z) else false)
    (sign:Shadow.far 151 15 z → s.basis 1597=Leave210TrueMiddle.neg z)
    (bits:∀j:Fin 38,s.basis (1559+j.val)=(prior k (1559+j.val)).read ref)
    (parity:∀q∈paritySites,ref q=s.basis q)
    (product:s.basis 1597=(s.basis 1731 && (signExpr ports k).read ref))
    (leftFlag:left k=(s.basis 1728 && s.basis 1729)) (rightFlag:right k=(s.basis 1728 && !s.basis 1729))
    (events:right k=true → ∀i<15,i≤LeaveSelector.key k → s.basis (Leave210Hit.swaps i)=decide (i=LeaveSelector.key k)) :
    let out:=run work tape s
    out.phase=s.phase ∧ (∀i<106,out.basis (live i)=(Leave210TrueMiddle.F z).testBit i) ∧
      (∀j:Fin 18,out.basis (row j).free=false) ∧ (∀j:Fin 39,out.basis (1559+j.val)=false) ∧
      (∀q,outside wire 106 q → (∀a∈columns,q≠a.shadow ∧ q≠a.tube) → out.basis q=cleared s.basis q) := by
  let a:=run Leave210Middle.middle tape s
  let t:=run extended tape s
  have ar:=Leave210TrueMiddle.actual z s tape small odd room clean (clean _ (by decide)) padding tag shadow bank cin sign (clean _ (by decide))
  have fix:=closed z s tape clean padding tag
  change t=⟨a.phase,writeBit a.basis 1613 false⟩ at fix
  have saved (q:Wire) (mem:q∈watched) : t.basis q=s.basis q := by
    obtain ⟨diff,out,cols⟩:=untouched _ mem
    rw [fix];simp only [writeBit,Function.update_of_ne diff]
    exact ar.2.2.2 q diff (fun i hi=>out ⟨i,hi⟩) cols
  have ctl : ∀j:Fin 39,1559+j.val∈watched := by decide +kernel
  have pa : ∀q∈paritySites,q∈watched := by decide +kernel
  have sw : ∀i:Fin 15,Leave210Hit.swaps i∈watched := by decide +kernel
  have retire:=Leave210RetireActual.result k ref t (tape.drop (measurementCount extended))
    (fun j=>(saved _ (ctl ⟨j.val,by have h:=j.isLt;omega⟩)).trans (bits j))
    (fun q h=>(parity q h).trans (saved _ (pa q h)).symm)
    (by rw [saved 1597 (by decide),saved 1731 (by decide)];exact product)
    (by rw [saved 1728 (by decide),saved 1729 (by decide)];exact leftFlag)
    (by rw [saved 1728 (by decide),saved 1729 (by decide)];exact rightFlag)
    (fun on i hi h=>(saved _ (sw ⟨i,hi⟩)).trans (events on i hi h))
  dsimp only
  rw [shape,run_append,run_take,retire]
  exact finish z s a t fix (clean _ (by decide)) ar

end ECDSAAdd.Entrant.StairPacket.Leave210Core

