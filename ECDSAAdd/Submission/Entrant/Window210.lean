theorem admin (d:Bool) (s:State) (m:List Bool) (z:SkywalkRails.State)
    (active:onRails idx 1 z s.basis) (ok:MeasuredCodec5.legalAt history s.basis)
    (row:Nat) (limit:row<63145)
