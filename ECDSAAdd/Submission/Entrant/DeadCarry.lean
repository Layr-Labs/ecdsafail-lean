open Arithmetic TerminalGraph DecoderCells5 DecoderBiasReuse Challenge RecordedQuantum
set_option maxRecDepth 30000
set_option maxHeartbeats 20000000
set_option linter.unusedSimpArgs false

                                                    
                                                                                             
             
          
                                                                        
              
        
                
          
                                       
                                            

                                                   
                                                                                            
                 
                                                 
              
                                
                                                                                
              
          
                          

theorem erase_physical (L : DecoderLayout) (j : Nat) : GatePhysical (erase L j) := by
 unfold erase
 split_ifs <;> simp [GatePhysical,PhysicalInstr]

theorem high_physical (L : DecoderLayout) (n : Nat) : GatePhysical (high L n) := by
 induction n with
 | zero=>simp [high,GatePhysical]
 | succ n ih=>exact (gatePhysical_append _ _).mpr ⟨erase_physical L (35+n),ih⟩

theorem pool_y_gen (L : DecoderLayout) (hw : L.Widths) (j : Nat) (h:j<256) : L.Y j∈L.wires.toFinset := by
 apply List.mem_toFinset.mpr
 simp [DecoderLayout.wires,y_mem L hw j h]
                                                                                  
                                        
theorem pool_r_gen (L : DecoderLayout) (hw : L.Widths) (j : Nat) (h:j<256) : L.R j∈L.wires.toFinset := by
 apply List.mem_toFinset.mpr
 simp [DecoderLayout.wires,r_mem L hw j h]
                                                                                  
                                        
theorem pool_a_gen (L : DecoderLayout) (hw : L.Widths) (j : Nat) (h:j<255) : L.A j∈L.wires.toFinset := by
 apply List.mem_toFinset.mpr
 simp [DecoderLayout.wires,a_mem L hw j h]
                                                                                  
                                        
theorem pool_sigma_gen (L : DecoderLayout) : L.sigma∈L.wires.toFinset := by
 apply List.mem_toFinset.mpr
 simp [DecoderLayout.wires]
                                                                                               

theorem erase_support (L : DecoderLayout) (hw : L.Widths) (j : Nat) (lo:35≤j) (hi:j≤255) :
 wires (erase L j) ⊆ L.wires.toFinset := by
 have hy3:=pool_y_gen L hw (j-3) (by omega)
 have hy2:=pool_y_gen L hw (j-2) (by omega)
 have hy1:=pool_y_gen L hw (j-1) (by omega)
 have hy0:=pool_y_gen L hw j (by omega)
 have hr1:=pool_r_gen L hw (j-1) (by omega)
 have hr0:=pool_r_gen L hw j (by omega)
 have hy33:=pool_y_gen L hw 33 (by decide)
 have hy34:=pool_y_gen L hw 34 (by decide)
 have hy35:=pool_y_gen L hw 35 (by decide)
 have ha33:=pool_a_gen L hw 33 (by decide)
 have hr33:=pool_r_gen L hw 33 (by decide)
 have hr35:=pool_r_gen L hw 35 (by decide)
 have hs:=pool_sigma_gen L
 unfold erase
 split_ifs
 · simp only [firstCorrections,wires,Instr.wires,correctionWires,Finset.union_subset_iff,
     Finset.insert_subset_iff,Finset.singleton_subset_iff,Finset.empty_subset]
   simp only [hy3,hy2,hy1,hy0,hr1,hr0,hy33,hy34,hy35,ha33,hr33,hr35,hs,and_self,true_and,and_true]
 · unfold polyCorrections
   split_ifs <;>
     simp only [List.append_assoc,List.nil_append,List.cons_append,List.append_nil,wires,
       Instr.wires,correctionWires,Finset.union_subset_iff,Finset.insert_subset_iff,
       Finset.singleton_subset_iff,Finset.empty_subset] <;> simp only [hy3,hy2,hy1,hy0,hr1,hr0,hy33,hy34,hy35,ha33,hr33,hr35,hs,and_self,true_and,and_true]

theorem high_support (n : Nat) (hi:n≤221) :
 wires (high fixedLayout n) ⊆ fixedLayout.wires.toFinset := by
 induction n with
 | zero=>simp [high,wires]
 | succ n ih=>
   simp only [high,wires_append,Finset.union_subset_iff]
   exact ⟨erase_support fixedLayout fixed_widths (35+n) (by omega) (by omega),ih (by omega)⟩

end ECDSAAdd.Entrant.DecoderMeasuredTail
end


