theorem fixed_rename_free (f : Wire→Wire) (hf : Function.Injective f) (P : Program) (q : Wire)
    (fix : f q=q) (free : q∉wires P) : q∉wires (renameProgram f P) := by
  rw [renameProgram_support]
  intro used
  obtain ⟨old,used,eq⟩ := Finset.mem_image.mp used
  exact free (hf (eq.trans fix.symm) ▸ used)

private theorem endpoint_selector_free (P : Program)
    (sub : wires P⊆(HalfField.ids.map base).toFinset) :
    base 2409∉wires (renameProgram OwnQ5Endpoint.swap
      (renameProgram OwnQ4Endpoint.swap (renameProgram OwnGuardEndpoint.swap
        (renameProgram OwnPlusEndpoint.swap (renameProgram HalfFieldOB5.endpointMap P))))) := by
  have raw : base 2409∉wires P := by
    intro used
    obtain ⟨i,hi,eq⟩ := List.mem_map.mp (List.mem_toFinset.mp (sub used))
    have same := base_injective eq
    subst i
    simp only [HalfField.ids,List.mem_append,List.mem_cons,List.not_mem_nil,
      List.mem_range'_1,or_false] at hi
    omega
  have h0 := fixed_rename_free HalfFieldOB5.endpointMap HalfFieldOB5.endpointMap.injective
    P (base 2409) (by decide +kernel) raw
  have h1 := fixed_rename_free OwnPlusEndpoint.swap OwnPlusEndpoint.swap.injective
    _ (base 2409) (by decide +kernel) h0
  have h2 := fixed_rename_free OwnGuardEndpoint.swap OwnGuardEndpoint.swap.injective
    _ (base 2409) (by decide +kernel) h1
