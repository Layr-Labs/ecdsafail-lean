private theorem fieldHosted_metrics (F F0 H H0 W W0 : Program)
    (hH : H=FrontierEntry1591Field.hosted F) (hH0 : H0=FrontierEntry1591Field.hosted F0)
    (hW : W=ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host H)
    (hW0 : W0=ParityField1591.program FrontierEntry1591Field.controls
      FrontierEntry1591Field.work FrontierEntry1591Field.host H0)
