theorem first_stage_old (w : Nat → Wire) (x p : Nat) (s : State)
    (hs : Stage w x p 5 s.basis) : W.CompressedCompactStage5 w x p 5 s.basis := by
  obtain ⟨raw,hraw,hbits⟩ := hs
