theorem compute_state_eq (a b c k t : Wire) (hn : [a,b,c,k,t].Nodup)
    (s : State) (m n : List Bool) (hk : s.basis k = false) :
    run (newCompute a b c t) m s = run (oldCompute a b c k t) n s := by
