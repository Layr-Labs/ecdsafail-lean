/-- An empty-correction erasure of a clean wire is the identity, for every record. -/
theorem pad_run (c : Wire) (m : List Bool) (t : State) (h : t.basis c=false) :
    run [Instr.measureX c [] []] m t=t := by
  obtain ⟨ph,bs⟩ := t
