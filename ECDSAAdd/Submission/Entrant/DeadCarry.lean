section
-- Terminal last-cell proof component DecoderMeasuredTailMath
set_option autoImplicit false
namespace ECDSAAdd.Entrant.DecoderMeasuredTail
open Arithmetic TerminalGraph DecoderCellCarryMath DecoderCells5
set_option maxRecDepth 30000
set_option maxHeartbeats 20000000
set_option linter.unusedSimpArgs false

def poly (p x y z sig r : Bool) : Bool :=
 x ^^ y ^^ z ^^ r ^^ (x && sig) ^^ (y && p) ^^ (y && sig) ^^ (y && r) ^^ (p && r)

theorem pair_identity (p x y z sig a c : Bool) (h : seedValid p sig a c) :
 let a1:=carryBit p (x ^^ sig) a
 let c1:=(p ^^ x ^^ sig ^^ a) && c
 let r1:=x ^^ y ^^ sig ^^ a1 ^^ c1
 let a2:=carryBit x (y ^^ sig) a1
 let c2:=(x ^^ y ^^ sig ^^ a1) && c1
 (y ^^ z ^^ sig ^^ a2 ^^ c2)=poly p x y z sig r1 := by
 cases p <;> cases x <;> cases y <;> cases z <;> cases sig <;> cases a <;> cases c <;>
   simp_all [seedValid,carryBit,poly]

theorem high_correction (L : DecoderLayout) (j : Nat) (hj : 33≤j) :
 correction L j=⟨none,false⟩ := by
 have lt : 2^32+977<2^j := lt_of_lt_of_le (by decide : 2^32+977<2^33)
   (Nat.pow_le_pow_right (by decide : 1≤2) hj)
 simp only [correction,show ¬j=1 by omega,if_false,Nat.testBit_eq_false_of_lt lt,Bool.false_eq_true,if_false]

def sourceAt (L : DecoderLayout) (b : BasisState) (j : Nat) : Bool :=
 if j<255 then b (L.Y j) else false

theorem ref_r (L : DecoderLayout) (b : BasisState) (j : Nat) (lo : 33≤j) (hi : j≤255) :
 b (L.R j)=(b (L.Y (j-1)) ^^ sourceAt L b j ^^ b L.sigma ^^ b (L.A (j-1)) ^^ bExpected L b j) := by
 have corr:=high_correction L j lo
 have parityeq : parity (bSources L j) b=
     (b (L.Y (j-1)) ^^ sourceAt L b j ^^ b L.sigma ^^ b (L.A (j-1))) := by
   by_cases h:j<255
   · simp [bSources,correctionSources,corr,rawSources,show ¬j=0 by omega,h,sourceAt,parity,Bool.xor_assoc]
   · have eq:j=255:=by omega
     subst j
     simp [bSources,correctionSources,corr,rawSources,sourceAt,parity,Bool.xor_assoc]
 unfold bExpected
 rw [parityeq]
 generalize b (L.R j)=v,b (L.Y (j-1))=p,sourceAt L b j=x,b L.sigma=sig,b (L.A (j-1))=a
 cases v <;> cases p <;> cases x <;> cases sig <;> cases a <;> rfl

theorem add_step (L : DecoderLayout) (b : BasisState)
 (adds : ∀j,j<255 → b (L.A j)=aExpected L b j)
 (k : Nat) (lo : 1≤k) (hi : k<255) :
 b (L.A k)=carryBit (b (L.Y (k-1))) (b (L.Y k) ^^ b L.sigma) (b (L.A (k-1))) := by
 obtain ⟨n,rfl⟩:∃n,k=n+1:=⟨k-1,by omega⟩
 rw [adds (n+1) hi]
 simp only [aExpected,Nat.add_sub_cancel]
 rw [←adds n (by omega)]

theorem reference_pair (L : DecoderLayout) (b : BasisState) (g : BGraph L b)
 (adds : ∀j,j<255 → b (L.A j)=aExpected L b j)
 (hh : (b L.sigma && b L.h)=false) (hb : (b L.sigma && b L.bias)=false)
 (k : Nat) (lo : 34≤k) (hi : k+2≤255) :
 b (L.R (k+2))=poly (b (L.Y (k-1))) (b (L.Y k)) (b (L.Y (k+1)))
   (sourceAt L b (k+2)) (b L.sigma) (b (L.R (k+1))) := by
 have seed:=seed_graph L b g adds hh hb (k-1) (by omega) (by omega)
   (by rw [high_correction L (k-1) (by omega)];rfl)
 rw [show k-1+1=k by omega] at seed
 have ca:=add_step L b adds k (by omega) (by omega)
 have cb:=add_step L b adds (k+1) (by omega) (by omega)
 have qa:=graph_zero_step L b g k (by omega) (by omega)
   (by rw [high_correction L k (by omega)];rfl)
 have qb:=graph_zero_step L b g (k+1) (by omega) (by omega)
   (by rw [high_correction L (k+1) (by omega)];rfl)
 have rr:=ref_r L b (k+1) (by omega) (by omega)
 have rz:=ref_r L b (k+2) (by omega) hi
 simp only [Nat.add_sub_cancel] at cb qb rr
 have e1:k+2-1=k+1:=by omega
 rw [e1] at rz
 have sx:sourceAt L b (k+1)=b (L.Y (k+1)):=by simp [sourceAt,show k+1<255 by omega]
 rw [sx] at rr
 rw [rz,rr,cb,qb,ca,qa]
 exact pair_identity _ _ _ _ _ _ _ seed










                                                                             
                                              
                                                                         
                                                             
                                        
                                                                  
                                                 
                                                      
                                                          
                                                 
                                              
                                                                                                  
              
                                      

end ECDSAAdd.Entrant.DecoderMeasuredTail
end


