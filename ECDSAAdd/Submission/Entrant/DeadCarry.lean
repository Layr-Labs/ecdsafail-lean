theorem selectMSwap_frame (w : Nat → Wire) (b sw flag : Wire) (constant : Bool)
    (ns : (flag::(Q6EndpointCell.ports w flag).r++(Q6EndpointCell.ports w flag).y).Nodup)
    (nd : [b,sw,flag].Nodup)
