  · obtain ⟨j,hj,hji⟩:=List.mem_map.mp h
    have e:=hinj hji; subst j
    simp only [List.mem_range'_1] at hj; omega
  · obtain ⟨j,hj,hji⟩:=List.mem_map.mp h
    have e:=hinj hji; subst j
    simp only [List.mem_range'_1] at hj; omega
  · obtain ⟨j,hj,hji⟩:=List.mem_map.mp h
    have e:=hinj hji; subst j
    simp only [List.mem_range'_1] at hj; omega

