theorem endpoint_eff_free : base 2410∉wires OwnQ5Endpoint.centerT ∧ base 2410∉wires OwnQ5Endpoint.canonT := by
  have avoid (P : Program) (hp : wires P⊆(HalfField.ids.map base).toFinset) : base 2410∉wires P := by
    intro h
