    · exact carry_index_ne L hw hn 254 i (by decide) (by omega) (by omega)
    · exact carry_index_ne L hw hn 248 i (by decide) (by omega) (by omega)
  have qsite (h : q∈Affine.sites (sources L)) : False := by
