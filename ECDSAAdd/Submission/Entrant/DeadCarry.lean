  obtain ⟨r1,r2,r3,r4,rt,c0,c1,c2,c3,ct,hr,hc,e0,e1,e2,e3,f0,f1,f2,f3⟩ := atoms L hw
  have nd := arithmeticND L hw hn
  have away := sources_away L hw hn
  rw [hr,hc] at nd
