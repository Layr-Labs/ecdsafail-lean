private def Metrics (P Q : Program) (extra : Nat) : Prop :=
  toffoliCount P=toffoliCount Q ∧ measurementCount P=measurementCount Q ∧
    gateSlots P=gateSlots Q+extra

private theorem metrics_refl (P : Program) : Metrics P P 0 := by
  simp only [Metrics,Nat.add_zero,and_self]

private theorem metrics_rename_left (f : Wire→Wire) (P Q : Program) (extra : Nat)
    (h : Metrics P Q extra) : Metrics (renameProgram f P) Q extra := by
  simpa only [Metrics,renameProgram_counts,rename_gateSlots] using h

private theorem metrics_G0 (P Q : Program) (extra : Nat) (h : Metrics P Q extra) :
    Metrics (G0CarryLoan5.program (base 1028) (base 0) (base 768) P)
      (G0CarryLoan5.program (base 1028) (base 0) (base 768) Q) extra := by
  have p:=G0CarryLoan5.counts (base 1028) (base 0) (base 768) P
  have q:=G0CarryLoan5.counts (base 1028) (base 0) (base 768) Q
  have ps:=G0CarryLoan5.slots (base 1028) (base 0) (base 768) P
  have qs:=G0CarryLoan5.slots (base 1028) (base 0) (base 768) Q
  simp only [Metrics] at h ⊢
  exact ⟨by omega,by omega,by omega⟩

private theorem halfWindow_metrics (divide : Bool) (j : Nat) (g : Wire) :
    Metrics (halfWindow divide j g)
      (SW.selW g (base 2409) (Q6EndpointCell.half divide base (base 2409))) 2 := by
  have count:=loanWindow_counts g (base 2409) (packetCarry j)
    (Q6EndpointCell.half divide base (base 2409))
  have slots:=loanWindow_slots g (base 2409) (packetCarry j)
    (Q6EndpointCell.half divide base (base 2409))
  simpa only [halfWindow,Metrics] using And.intro count.1 (And.intro count.2 slots)

private theorem cell_metrics (divide : Bool) (j : Nat) (g sw : Wire) :
    Metrics (cell divide j g sw) (FrontierSW1591.cellS divide g sw) 2 := by
  have h:=halfWindow_metrics divide j g
  simp only [Metrics] at h ⊢
  cases divide <;>
    simp only [cell,FrontierSW1591.cellS,Bool.false_eq_true,if_false,if_true,
      toffoliCount_append,measurementCount_append,gateSlots_append]
  all_goals exact ⟨by omega,by omega,by omega⟩

private theorem rawReplay_metrics (divide : Bool) (j : Nat) (letters : List MixedTranscriptLetter) :
    Metrics (rawReplay divide j letters) (FrontierSW1591.rawReplayS divide letters)
      (2*letters.length) := by
  induction letters with
  | nil =>
    simp only [rawReplay,FrontierSW1591.rawReplayS,List.length_nil,Nat.mul_zero]
    exact metrics_refl []
  | cons l ls ih =>
    have head:=cell_metrics divide j l.1.1 l.1.2
    simp only [Metrics] at head ih ⊢
    cases divide <;>
      simp only [rawReplay,FrontierSW1591.rawReplayS,Bool.false_eq_true,if_false,if_true,
        toffoliCount_append,measurementCount_append,gateSlots_append,List.length_cons]
    all_goals exact ⟨by omega,by omega,by omega⟩

private theorem basePacket_metrics (divide : Bool) (j : Nat) :
    Metrics (basePacket divide j) (FrontierSW1591.basePacketS divide j) 10 := by
  have raw:=rawReplay_metrics divide j (Replay5.letters j)
  have len : (Replay5.letters j).length=5 := by simp only [Replay5.letters,List.length_map,List.length_range]
  simp only [len] at raw
  simp only [Metrics] at raw ⊢
  simp only [basePacket,FrontierSW1591.basePacketS,toffoliCount_append,
    measurementCount_append,gateSlots_append]
  exact ⟨by omega,by omega,by omega⟩

private theorem packet_metrics (divide : Bool) (j : Nat) :
    Metrics (packet divide j) (FrontierSW1591.packetS divide j) 10 := by
  simpa only [packet,FrontierSW1591.packetS,Metrics,renameProgram_counts,rename_gateSlots] using
    basePacket_metrics divide j

private theorem groups_metrics (divide : Bool) (j n : Nat) :
    Metrics (groups divide j n) (FrontierSW1591.groupsS divide j n) (10*n) := by
  induction n generalizing j with
  | zero =>
    simp only [groups,FrontierSW1591.groupsS,PacketSequence.program,Nat.mul_zero]
    exact metrics_refl []
  | succ n ih =>
    have head:=packet_metrics divide j
    have rest:=ih (j+1)
    simp only [Metrics] at head rest ⊢
    simp only [groups,FrontierSW1591.groupsS] at rest
    cases divide <;>
      simp only [groups,FrontierSW1591.groupsS,PacketSequence.program,Bool.false_eq_true,
        if_false,if_true,toffoliCount_append,measurementCount_append,gateSlots_append]
    all_goals exact ⟨by omega,by omega,by omega⟩

