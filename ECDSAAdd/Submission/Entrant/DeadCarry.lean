        (clearParityH_free L hw hn J hJ L.sign (Or.inr (Or.inl rfl)))
        hd.2.2.2.2.2.1 (Ne.symm slo) (Ne.symm hd.2.2.2.2.1) q (Or.inr h)
    · rw [h] at flagNe
