 if j=35 then [.measureX (L.R 35) [] (firstCorrections (L.Y 33) (L.Y 34) (L.Y 35) (L.A 33) (L.R 33))]
 else [.measureX (L.R j) [] (polyCorrections (L.Y (j-3)) (L.Y (j-2)) (L.Y (j-1))
   (L.Y j) L.sigma (L.R (j-1)) (decide (j<255)))]

