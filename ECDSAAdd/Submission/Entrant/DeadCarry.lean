  cases divide <;> simp only [program,Bool.false_eq_true,if_false,if_true,wires_append,Finset.mem_union,not_or]
    at r ⊢
  · exact ⟨ep.1,cp,r,ep.2⟩
  · exact ⟨ep.1,r,cp,ep.2⟩

