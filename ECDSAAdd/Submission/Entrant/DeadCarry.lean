theorem y_not_carry (L : Layout) (hn : L.wires.Nodup) (q : Wire) (hq : q∈L.y) : q∉L.carry := by
  intro hc
  have nd := allND L hn
  have h := List.nodup_iff_count.mp nd q
  have a := List.count_pos_iff.mpr hc
  have b := List.count_pos_iff.mpr hq
