      [ECDSAAdd.Instr.measureX (w 722) [] [.CZ (w 514) (w 1028)]]++[ECDSAAdd.Instr.measureX (w 721) [] [.CZ g (w 1028)]] from rfl,
      wires_append,Finset.union_subset_iff]
    constructor <;> apply gate_sub <;> intro q hq <;>
