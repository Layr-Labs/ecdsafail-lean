def workIds : List Nat := [765,2312,767,766,768,1797,1027]++List.range' 512 253++[1540,1541,1026]

theorem ports_work (w : Nat → Wire) (sign : Wire) :
    BalancedCircuit.work (ports w sign)=workIds.map w := by
