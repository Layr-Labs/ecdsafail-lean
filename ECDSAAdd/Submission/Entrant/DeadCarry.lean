def polyCorrections (p x y z sig r : Wire) (zEnabled : Bool) : List Correction :=
 [.Z x,.Z y]++(if zEnabled then [.Z z] else [])++
 [.Z r,.CZ x sig,.CZ y p,.CZ y sig,.CZ y r,.CZ p r]

                                                             
                                                        
                            
                                                          
                                                                       
                                                                   
                                           
                           
                         
                                                                                                           
                                                                
                       
                                                                                                                                          
                                                                                                     
                                                                                    
              
                 
                                                                                                            
                                                                                                     
                                                  

