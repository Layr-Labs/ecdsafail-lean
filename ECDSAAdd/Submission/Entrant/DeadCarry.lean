theorem low_cells_good : cells.all DecoderCells5.goodCell=true := by decide +kernel

theorem graph_resources (cs : List Cell) (hc:cs.all DecoderCells5.goodCell=true) :
 GatePhysical (cellGraph fixedLayout cs) ∧ wires (cellGraph fixedLayout cs) ⊆ fixedLayout.wires.toFinset := by
 induction cs with
 | nil=>exact ⟨high_physical fixedLayout 221,high_support 221 (by decide)⟩
 | cons c cs ih=>
   have h:DecoderCells5.goodCell c=true ∧ cs.all DecoderCells5.goodCell=true:=by
     simpa only [List.all_cons,Bool.and_eq_true] using hc
   have cr:=DecoderCells5.cell_resources c h.1
   have rest:=ih h.2
   constructor
   · exact (gatePhysical_append _ _).mpr ⟨(gatePhysical_append _ _).mpr ⟨cr.1,rest.1⟩,cr.2.1⟩
   · simp only [cellGraph,List.foldr_cons,wires_append,Finset.union_subset_iff]
     exact ⟨⟨cr.2.2.1,rest.2⟩,cr.2.2.2⟩

theorem actual_graph_resources : GatePhysical actualCellGraph ∧ wires actualCellGraph ⊆ fixedLayout.wires.toFinset := by
 have f:=DecoderCells5.first_placed_resources fixedLayout fixed_widths fixed_nodup
 have b:=graph_resources cells low_cells_good
 constructor
 · exact (gatePhysical_append _ _).mpr ⟨(gatePhysical_append _ _).mpr ⟨f.1,b.1⟩,f.2.1⟩
 · simp only [actualCellGraph,wires_append,Finset.union_subset_iff]
   exact ⟨⟨f.2.2.1,b.2⟩,f.2.2.2⟩
end ECDSAAdd.Entrant.DecoderMeasuredTail
end


