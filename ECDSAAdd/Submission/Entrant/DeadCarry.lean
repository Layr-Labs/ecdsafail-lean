  obtain ⟨v,ev⟩ : ∃v,run (hAdd w false) mF u=v := ⟨_,rfl⟩
  rw [ev] at ha
  have hAway (i : Nat) (hi : i<1798) (h : ¬(4≤ i ∧ i<257)) : w i∉wireBlock w 4 253 :=
