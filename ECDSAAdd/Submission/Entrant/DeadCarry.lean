  obtain ⟨r,eq⟩ := History5.history_gate_mem base (5*j) _ (Or.inl rfl) (base q) mem
  have index := base_injective eq
  have port := r.isLt
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
