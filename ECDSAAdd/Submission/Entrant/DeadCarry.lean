theorem P4_avoid (w : Nat→Wire) (hinj : Function.Injective w) (i : Nat)
    (hi : i=1794 ∨ i=1795 ∨ i=1796 ∨ i=1025 ∨ i=1026 ∨ i=1027) : w i∉wires (P4 w) := by
  intro h
  exact low_avoid4 w hinj i hi (List.mem_toFinset.mp (prefix_support _ _ _ _ h))

