theorem controls_away_numerator (q : Wire) (hq : q∈controls) : q∉numerator := by
  obtain ⟨i,hi,eq⟩ := controls_member q hq
  rw [←eq]
  apply sig_outside_numerator
  rw [(payload_index_bound i hi).1]
  have bound := (payload_index_bound i hi).2
