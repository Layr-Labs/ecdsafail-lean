theorem encode_packet_parity (w : Nat → Wire) (hn : (skywalkPoolWires w).Nodup)
    (start : Nat) (hs : start+5≤512) (s : State) (m : List Bool)
    (legal : MeasuredCodec5.legalAt (historyMap w start) s.basis) :
