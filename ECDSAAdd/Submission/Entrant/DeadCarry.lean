    simp only [Replay5.restLetters,List.length_map,List.length_range']
  simp only [len] at raw
  simp only [Metrics] at raw ⊢
  cases divide <;>
    simp only [firstBody,FrontierSW1591.firstBodyS,Bool.false_eq_true,if_false,if_true,
      toffoliCount_append,measurementCount_append,gateSlots_append]
