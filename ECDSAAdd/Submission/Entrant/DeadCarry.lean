    exact lower a b c B hab (Ne.symm hbc) haB hbB hcB s U tape
  simp only [oldLeafAt,run_cat,first,second,third,fourth,U,K]

private def lead (copy : Bool) (a b c A B : Wire) : Program :=
  [.CX A B] ++ (if copy then [.CX a B,.CX b B,.CX c B] else [])

private theorem lead_run (copy : Bool) (a b c A B : Wire)
    (haB : a≠B) (hbB : b≠B) (hcB : c≠B) (s : State) (m : List Bool) :
    run (lead copy a b c A B) m s =
      ⟨s.phase,writeBit s.basis B ((s.basis B ^^ s.basis A) ^^
        (if copy then sumBit (s.basis a) (s.basis b) (s.basis c) else false))⟩ := by
  cases copy
  · simp [lead,run]
  · simp only [lead,if_true,run_cat,cx3 a b c B haB hbB hcB]
    simp only [run]
    apply congrArg (State.mk s.phase)
    funext q
    by_cases hq : q=B <;>
      simp_all [writeBit,Function.update,sumBit,Bool.xor_assoc]

private theorem new_run (copy : Bool) (a b c A B z : Wire)
    (nd : [a,b,c,A,B,z].Nodup) (s : State) (m : List Bool)
    (ready : ReadyAt copy a b c A B s.basis) :
    run (newLeafAt copy a b c A B) m s =
      post a b c B s (if copy then sumBit (s.basis a) (s.basis b) (s.basis c) else false) := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  obtain ⟨⟨hab,hac,haA,haB,haz⟩,⟨hbc,hbA,hbB,hbz⟩,
    ⟨hcA,hcB,hcz⟩,⟨hAB,hAz⟩,hBz⟩ := nd
  let K := carryBit (s.basis a) (s.basis b) (s.basis c)
  let S := sumBit (s.basis a) (s.basis b) (s.basis c)
  let T := if copy then S else false
  have hi : ((s.basis B ^^ s.basis A) ^^ K) = T := by
    unfold ReadyAt at ready
    rw [Bool.xor_comm (s.basis A) (s.basis B)] at ready
    exact ready
  have recover : ((s.basis B ^^ s.basis A) ^^ T) = K := by
    rw [← hi]
    simp only [← Bool.xor_assoc,Bool.xor_self,Bool.false_xor]
  let s1 : State := ⟨s.phase,writeBit s.basis B K⟩
  let s2 : State := ⟨s.phase,writeBit s.basis B false⟩
  let s3 : State := post a b c B s false
  have first (tape : List Bool) : run (lead copy a b c A B) tape s = s1 := by
    rw [lead_run copy a b c A B haB hbB hcB]
    change (⟨s.phase,writeBit s.basis B ((s.basis B ^^ s.basis A) ^^ T)⟩ : State) =
      ⟨s.phase,writeBit s.basis B K⟩
    rw [recover]
  have relation : s1.basis B = carryBit (s1.basis a) (s1.basis b) (s1.basis c) := by
    simp [s1,K,writeBit,Function.update,haB,hbB,hcB]
  have second (tape : List Bool) : run (eraseCarry a b c B) tape s1 = s2 := by
    rw [eraseCarry_correct a b c B haB hbB hcB s1 relation]
    simpa only [s1,s2] using congrArg (State.mk s.phase)
      (write_idem s.basis B K false)
  have third (tape : List Bool) : run [ECDSAAdd.Instr.CX a b,.CX c b] tape s2 = s3 := by
    exact lower a b c B hab (Ne.symm hbc) haB hbB hcB s false tape
  have fourth (tape : List Bool) : run (if copy then [ECDSAAdd.Instr.CX b B] else []) tape s3 = post a b c B s T := by
    cases hcopy : copy
    · simp [T,hcopy,s3,run]
    · simp only [hcopy,if_true,run]
      apply congrArg (State.mk s.phase)
      funext q
      by_cases hqB : q=B
      · subst q
        simp [s3,post,T,S,hcopy,writeBit,Function.update,Ne.symm hbB]
      · by_cases hqb : q=b <;>
          simp_all [s3,post,T,S,hcopy,writeBit,Function.update]
  change run (lead copy a b c A B ++ eraseCarry a b c B ++
    [ECDSAAdd.Instr.CX a b,.CX c b] ++ (if copy then [ECDSAAdd.Instr.CX b B] else [])) m s = _
  simp only [run_cat,first,second,third,fourth,T,S]

/-- Structural proof: majority_correct and eraseCarry_correct eliminate all
measurement records before the final Boolean XOR/frame comparison. -/
theorem full_state (copy : Bool) (a b c A B z : Wire)
    (nd : [a,b,c,A,B,z].Nodup) (s : State) (m n : List Bool)
    (clean : s.basis z = false) (ready : ReadyAt copy a b c A B s.basis) :
    run (oldLeafAt a b c A B z) m s = run (newLeafAt copy a b c A B) n s := by
  rw [old_run a b c A B z nd s m clean,new_run copy a b c A B z nd s n ready]
  apply congrArg (post a b c B s)
  unfold ReadyAt at ready
  rw [Bool.xor_comm (s.basis A) (s.basis B)] at ready
  exact ready























































theorem support (copy : Bool) (a b c A B z : Wire) :
    wires (oldLeafAt a b c A B z) = {a,b,c,A,B,z} ∧
    wires (newLeafAt copy a b c A B) = {a,b,c,A,B} := by
  constructor
  · ext q
    (simp [oldLeafAt,majority,eraseCarry,wires,Instr.wires,correctionWires]; tauto)
  · cases copy <;> ext q <;>
      simp [newLeafAt,eraseCarry,wires,Instr.wires,correctionWires] <;> tauto

theorem retired (copy : Bool) (a b c A B z : Wire)
    (nd : [a,b,c,A,B,z].Nodup) : z ∉ wires (newLeafAt copy a b c A B) := by
  rw [(support copy a b c A B z).2]
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  simp_all [ne_comm]

theorem counts (copy : Bool) (a b c A B z : Wire) :
    toffoliCount (oldLeafAt a b c A B z) = 1 ∧
    toffoliCount (newLeafAt copy a b c A B) = 0 ∧
    measurementCount (oldLeafAt a b c A B z) = 1 ∧
    measurementCount (newLeafAt copy a b c A B) = 1 := by
  cases copy <;> exact ⟨rfl,rfl,rfl,rfl⟩






theorem physical (copy : Bool) (a b c A B z : Wire)
    (nd : [a,b,c,A,B,z].Nodup) :
    GatePhysical (oldLeafAt a b c A B z) ∧ GatePhysical (newLeafAt copy a b c A B) := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  cases copy <;>
    simp_all [oldLeafAt,newLeafAt,majority,eraseCarry,GatePhysical,PhysicalInstr,ProperGate,
      ne_comm]







































end ECDSAAdd.Entrant.HighOutputTailStructuredResearch
end


-- Consolidated source module: HighOutputFlagDraft
section

/-! Private source-only extension of the actually checked zero-top leaf.
No caller range/placement theorem is assumed established, and no certificate exists here. -/

set_option maxHeartbeats 4000000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.HighOutputFlagResearch
open Arithmetic RecordedQuantum Challenge HighOutputTailStructuredResearch

/-- The existing zero-top leaf conjugated by a Clifford controlled by an
immutable outside flag. This is a fixed gate list, not a quantum branch. -/
def newFlagAt (flag a b c A B : Wire) : Program :=
  [.CX flag B] ++ newLeafAt false a b c A B ++ [.CX flag B]

private theorem cat (p q : Program) (m : List Bool) (s : State) :
    run (p++q) m s=run q (m.drop (measurementCount p)) (run p m s) := by
  rw [run_append,run_take]

private theorem commute_cat (p q C : Program)
    (hp : ∀ (s : State) (m : List Bool),run p m (run C [] s)=run C [] (run p m s))
    (hq : ∀ (s : State) (m : List Bool),run q m (run C [] s)=run C [] (run q m s))
    (s : State) (m : List Bool) :
    run (p++q) m (run C [] s)=run C [] (run (p++q) m s) := by
  calc
    run (p++q) m (run C [] s)=
        run q (m.drop (measurementCount p)) (run p m (run C [] s)) := cat _ _ _ _
    _ = run q (m.drop (measurementCount p)) (run C [] (run p m s)) :=
      congrArg (run q (m.drop (measurementCount p))) (hp s m)
    _ = run C [] (run q (m.drop (measurementCount p)) (run p m s)) := hq _ _
    _ = run C [] (run (p++q) m s) := congrArg (run C []) (cat p q m s).symm

private theorem same_target (u v flag B : Wire) (hu : u≠B) (hv : v≠B) (hf : flag≠B)
    (s : State) (m : List Bool) :
    run [.CX u B,.CX v B] m (run [.CX flag B] [] s)=
      run [.CX flag B] [] (run [.CX u B,.CX v B] m s) := by
  simp only [run]
  apply congrArg (State.mk s.phase)
  funext q
  by_cases hq : q=B <;>
    simp_all [writeBit,Function.update,Bool.xor_assoc,Bool.xor_comm,Bool.xor_left_comm]

/-- The external flag-CX commutes with the old measured leaf. The three
remaining blocks are disjoint; the two high-output CX gates share a target. -/
theorem old_flag_commute (flag a b c A B z : Wire)
    (nd : [flag,a,b,c,A,B,z].Nodup) (s : State) (m : List Bool) :
    run (oldLeafAt a b c A B z) m (run [.CX flag B] [] s)=
      run [.CX flag B] [] (run (oldLeafAt a b c A B z) m s) := by
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at nd
  let C : Program := [ECDSAAdd.Instr.CX flag B]
  have dP : Disjoint (wires (majority a b c z)) (wires C) := by
    simp_all [C,majority,wires,Instr.wires,ne_comm]
  have dR : Disjoint (wires (eraseCarry a b c z)) (wires C) := by
    simp_all [C,eraseCarry,wires,Instr.wires,correctionWires,ne_comm]
  have dL : Disjoint (wires [ECDSAAdd.Instr.CX a b,.CX c b]) (wires C) := by
    simp_all [C,wires,Instr.wires,ne_comm]
  have hp (s : State) (m : List Bool) :
      run (majority a b c z) m (run C [] s)=run C [] (run (majority a b c z) m s) :=
    run_disjoint_commute _ _ dP m [] s
  have hr (s : State) (m : List Bool) :
      run (eraseCarry a b c z) m (run C [] s)=run C [] (run (eraseCarry a b c z) m s) :=
    run_disjoint_commute _ _ dR m [] s
  have hl (s : State) (m : List Bool) :
      run [ECDSAAdd.Instr.CX a b,.CX c b] m (run C [] s)=run C [] (run [ECDSAAdd.Instr.CX a b,.CX c b] m s) :=
    run_disjoint_commute _ _ dL m [] s
  have hAB : A≠B := by tauto
  have hzB : z≠B := by tauto
  have hfB : flag≠B := by tauto
  have hq (s : State) (m : List Bool) :
      run [ECDSAAdd.Instr.CX A B,.CX z B] m (run C [] s)=run C [] (run [ECDSAAdd.Instr.CX A B,.CX z B] m s) :=
    same_target A z flag B hAB hzB hfB s m
  exact commute_cat _ _ C hp (commute_cat _ _ C hq (commute_cat _ _ C hr hl)) s m

private theorem cx_cancel (flag B : Wire) (hfB : flag≠B) (s : State) :
    run [.CX flag B] [] (run [.CX flag B] [] s)=s := by
  apply congrArg (State.mk s.phase)
  funext q
  by_cases hq : q=B <;> simp_all [run,writeBit,Function.update]

private theorem xor_flag_zero (a b k f : Bool) (h : ((a^^b)^^k)=f) :
    ((a^^(b^^f))^^k)=false := by
  cases a <;> cases b <;> cases k <;> cases f <;> simp_all

/-- Exact complete-State equality, inherited from the public zero-top theorem.
The flag must be an immutable seventh port; the premise is the actual OLD
leaf's final high-output bit, before any proposed replacement is executed. -/
theorem top_equals_flag (flag a b c A B z : Wire)
    (nd : [flag,a,b,c,A,B,z].Nodup) (s : State) (m n : List Bool)
    (clean : s.basis z=false)
    (same : ((s.basis A^^s.basis B)^^carryBit (s.basis a) (s.basis b) (s.basis c))=s.basis flag) :
    run (oldLeafAt a b c A B z) m s=run (newFlagAt flag a b c A B) n s := by
  have nd6 : [a,b,c,A,B,z].Nodup := (List.nodup_cons.mp nd).2
  have ndf := nd
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,List.nodup_nil,
    not_or,not_false_eq_true,and_true] at ndf
  have hfB : flag≠B := by tauto
  have hzB : z≠B := by tauto
  have haB : a≠B := by tauto
  have hbB : b≠B := by tauto
  have hcB : c≠B := by tauto
  have hAB : A≠B := by tauto
  let C : Program := [ECDSAAdd.Instr.CX flag B]
  have preparedClean : (run C [] s).basis z=false := by
    simp [C,run,writeBit,Function.update,hzB,clean]
  have preparedReady : ReadyAt false a b c A B (run C [] s).basis := by
    simpa [C,ReadyAt,run,writeBit,Function.update,haB,hbB,hcB,hAB] using
      xor_flag_zero (s.basis A) (s.basis B)
        (carryBit (s.basis a) (s.basis b) (s.basis c)) (s.basis flag) same
  have zero := HighOutputTailStructuredResearch.full_state false a b c A B z nd6
    (run C [] s) m n preparedClean preparedReady
  have comm := old_flag_commute flag a b c A B z nd s m
  calc
    run (oldLeafAt a b c A B z) m s=
        run C [] (run C [] (run (oldLeafAt a b c A B z) m s)) :=
      (cx_cancel flag B hfB _).symm
    _ = run C [] (run (oldLeafAt a b c A B z) m (run C [] s)) := by rw [comm]
    _ = run C [] (run (newLeafAt false a b c A B) n (run C [] s)) := by rw [zero]
    _ = run (newFlagAt flag a b c A B) n s := by
      symm
      rw [newFlagAt,cat,cat]
      rfl

theorem counts (flag a b c A B : Wire) :
    toffoliCount (newFlagAt flag a b c A B)=0 ∧
    measurementCount (newFlagAt flag a b c A B)=1 ∧
    gateSlots (newFlagAt flag a b c A B)=9 := by
  exact ⟨rfl,rfl,rfl⟩











































                                                                   
                                                      
                                    
                                                                
                                                   
                                        
                 













                                          
                                                               
                                   

                                          
                                                      
                                   

                                            
                                                        
                                   

end ECDSAAdd.Entrant.HighOutputFlagResearch
