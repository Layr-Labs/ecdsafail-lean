  (mixedTranscriptUnitTrace.getD 0 (false,false)).2

def firstBody (divide : Bool) : Program :=
  if divide then firstSwap++rawReplay true Replay5.restLetters
  else rawReplay false Replay5.restLetters++firstSwapM

