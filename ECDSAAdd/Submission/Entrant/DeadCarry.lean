 theorem terminal_host_bits (x : Nat) (hx0 : 0<x) (hx : x<p) (s : State)
    (hs : Stage base x p 512 s.basis) :
    s.basis (base 1026)=false ∧ s.basis (base 1541)=false ∧ s.basis (base 1539)=false := by
