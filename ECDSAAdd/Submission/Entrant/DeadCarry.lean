private def availableIds : List Nat :=
  List.range' 1540 257++List.range' 1798 256++[1797]++List.range' 512 257++
    [2313,769,1027,2054,2055]

private theorem work_split : ∀ j∈workIds, j=2312 ∨ j=1026 ∨ j∈availableIds := by
  intro j hj
