  have h0 := And.intro (avoid _ HalfField.centerT_sites) (avoid _ HalfField.canonT_sites)
  have h1 : base 2410∉wires HalfFieldOB5.centerT ∧ base 2410∉wires HalfFieldOB5.canonT := by
