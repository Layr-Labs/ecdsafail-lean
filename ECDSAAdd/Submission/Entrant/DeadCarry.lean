 (n : Nat) (bound : n ≤ 255) (s : State) (m : List Bool) (q : Wire)
 (away : q ∉ L.carry) :
 (run ((List.range n).flatMap (addCarry L)) m s).basis q=s.basis q := by
 induction n generalizing m with
