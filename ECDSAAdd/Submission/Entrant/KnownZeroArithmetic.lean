theorem word_low(H i:Nat)(hi:i<3):
 (4294968272*H).testBit (i+4)=((5*(H%8))%8).testBit i:=by
 rw [Nat.testBit_add]
 have div:(4294968272*H)/2^4=268435517*H:=by norm_num;omega
 rw [div]
