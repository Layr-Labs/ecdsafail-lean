  regValue_congr _ _ _ (fun q hq=>h q (List.mem_of_mem_drop hq))
 have ht:regValue (L.core.product.drop 256) b=regValue (L.core.product.drop 256) b':=
  regValue_congr _ _ _ (fun q hq=>h q (List.mem_of_mem_drop hq))
