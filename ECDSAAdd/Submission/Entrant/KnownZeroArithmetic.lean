 (hc:s.basis (f 9)=false ∧ s.basis (f 10)=false ∧ s.basis (f 11)=false)
 (hu:(regValue [f 0,f 1,f 2,f 3] s.basis+
      regValue [f 4,f 5,f 6,f 7] s.basis+(s.basis (f 8)).toNat)%16=0 ∨
