def thresholdPairs : List (Wire×Wire) := [(305, 1558), (306, 1559), (307, 1560), (308, 1561), (309, 1562), (310, 1563), (311, 1564), (312, 1565), (313, 1566), (314, 1567), (315, 1568), (316, 1569), (317, 1570), (318, 1571)]
