theorem squareEntryHL_pieceOK (holes : List Wire) (hsub : ∀ q ∈ holes, q ∈ StairCertificate.holes39)
    (k : Fp) : StairSiteAvoidance.PieceOK holes StairSiteAvoidance.UG
