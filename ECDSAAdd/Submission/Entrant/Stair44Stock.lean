/-! # LT38 / U3b (assembly): support, avoidance, counts, slots, physicality and `BodyBOK` of the new B body -/

-- wires, support, avoidance, counts, slots, physical
section
open ECDSAAdd ECDSAAdd.Entrant
namespace ECDSAAdd.Entrant.StairSqBodyB
open Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout
open InverseCarryDevelop ThirdSavedCarryDevelop ControlLoan1589BFFold
open ECDSAAdd.Entrant.StairSquareDirectFold
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 50000000
set_option linter.unusedSimpArgs false
attribute [local irreducible] ECDSAAdd.wires ECDSAAdd.run

/-- Every wire of the new body is a wire of the record body, of the new loop, or of the new e-fold. -/
theorem bodyBG_wires (hl : List Wire) (EF : Program) :
    wires (bodyBG hl EF) ⊆ wires B95PaddedResearch.body ∪ (wires (StairSqLoopB.loopB hl) ∪ wires EF) := by
  have hw : LB.Widths := LowAccCarryDevelop.layout_widths
  have s1 := directFoldQ_sub_measured LB hw (negP LB) (negP_length LB hw) rfl
  have s2 := directFoldQ_sub_measured LB hw (rot128F LB) (rot128F_length LB hw) rfl
  have cinIn : LB.core.cin∈wires (ReorderedRecordPadding.program 4 LB.core.cin) := padding_mem 3 LB.core.cin
  rw [record_shape]
  intro x hx
  have h1 : x∈wires (directFoldQTq LB (negP LB)) → x=LB.core.cin ∨ x∈wires (measuredFoldQTq LB (negP LB)) :=
    fun h => Finset.mem_insert.mp (s1 h)
  have h2 : x∈wires (directFoldQTq LB (rot128F LB)) → x=LB.core.cin ∨ x∈wires (measuredFoldQTq LB (rot128F LB)) :=
    fun h => Finset.mem_insert.mp (s2 h)
  have h3 : x=LB.core.cin → x∈wires (ReorderedRecordPadding.program 4 LB.core.cin) := by
    intro e; rw [e]; exact cinIn
  simp only [bodyBG,StairSquareBBody.bodyG,LowAccCarryDevelop.foldFor,dF1,dF2,wires_append,Finset.mem_union] at hx
  simp only [LocalSevenBody.bodyForBoth,LowAccCarryDevelop.foldFor,wires_append,Finset.mem_union]
  rcases hx with ((h|h|(h|h|h|h)|h|h)|h)
  · rcases h1 h with e|e
    · exact Or.inl (Or.inr (h3 e))
    · exact Or.inl (Or.inl (Or.inl e))
  · rcases h2 h with e|e
    · exact Or.inl (Or.inr (h3 e))
    · exact Or.inl (Or.inl (Or.inr (Or.inl e)))
  · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inl (Or.inl h)))))
  · exact Or.inr (Or.inl h)
  · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inl (Or.inr (Or.inr (Or.inl h)))))))
  · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inl (Or.inr (Or.inr (Or.inr h)))))))
  · exact Or.inr (Or.inr h)
  · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inr (Or.inr h)))))
  · exact Or.inl (Or.inr h)

/-- `BodyBOK.support` shape (= `B95SelectorResearch.selected_support`). -/
theorem bodyBG_support (hl : List Wire) (hsub : hl.Sublist holes) (EF : Program) (hEF : EFoldOK EF) :
    wires (bodyBG hl EF) ⊆ (cB::LB.wires).toFinset := by
  have park := ParkCarry10Develop.body_support LB LowAccCarryDevelop.layout_widths LowAccCarryDevelop.layout_nodup cB
  intro x hx
  rcases Finset.mem_union.mp (bodyBG_wires hl EF hx) with h|h
  · exact park (B95SelectorResearch.actual_subset h)
  · rcases Finset.mem_union.mp h with h|h
    · exact park (FullB99OptTemp.actual_subset (StairSqLoopB.loopB_support hl hsub h))
    · exact hEF.2.1 h


theorem bodyBG_support44 (hl : List Wire) (hsub : hl.Sublist StairSqLoopA.hostDomain) (EF : Program) (hEF : EFoldOK EF) :
    wires (bodyBG hl EF) ⊆ (cB::LB.wires).toFinset := by
  have park := ParkCarry10Develop.body_support LB LowAccCarryDevelop.layout_widths LowAccCarryDevelop.layout_nodup cB
  intro x hx
  rcases Finset.mem_union.mp (bodyBG_wires hl EF hx) with h|h
  · exact park (B95SelectorResearch.actual_subset h)
  · rcases Finset.mem_union.mp h with h|h
    · exact park (FullB99OptTemp.actual_subset (StairSqLoopB.loopB_support44 hl hsub h))
    · exact hEF.2.1 h

/-- Avoidance of the hole sublist `hl`. -/
theorem bodyBG_avoids (hl : List Wire) (hsub : hl.Sublist holes) (EF : Program) (hEF : EFoldOK EF) :
    ∀ q ∈ hl, q ∉ wires (bodyBG hl EF) := by
  have hn : LB.wires.Nodup := LowAccCarryDevelop.layout_nodup
