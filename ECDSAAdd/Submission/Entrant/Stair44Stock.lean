include hw hn hs hd hlen hx hdx he in
/-- The SumSaved clear prefix uses only `outside` and outer-S wires. -/
theorem sumSavedPrefix_support (hS : src.length=129) :
    wires (sumSavedPrefix (SumSavedSquare.K L ext src dst) (SumSavedSquare.inner L ext src dst))⊆
      outerSet L control ext src dst := by
  have hall := LowZero18LowK.kg_nodup L control hn ext src dst hs hd hx hdx
  have geo := SumInnerSparseSquare.geometry L hw ext src dst he hS hall
  have w := LowZero18LowK.oregs_W L hw ext src dst (by omega) (by omega) hlen he
  have kr : (SumSavedSquare.K L ext src dst).R=LowZero18LowK.oregs L ext src dst :=
    LowZero18LowK.kg_R L ext src dst
  have wK : (SumSavedSquare.K L ext src dst).R.W := by rw [kr]; exact w
  have rp := (LowZero18LowK.oregs L ext src dst).piece_support w
  have rK := sub_outerSet_of L control ext src dst _ (oregs_all_sub L control ext src dst)
  have wj := LowZero18LowK.jregsS_W L hw ext src dst hS hlen he
  have js := LowZero18Diagonal.steps_support (LowZero18LowK.jregsS L ext src dst) wj
  have jK := sub_outerSet_of L control ext src dst _ (jregsS_all_sub L control ext src dst)
  have innerSub : ((SumSavedSquare.inner L ext src dst).S++(SumSavedSquare.inner L ext src dst).T).toFinset⊆
      outerSet L control ext src dst := by
    intro q hq
    apply outerSet_of
    have h := List.mem_toFinset.mp hq
    apply jregsS_all_sub L control ext src dst q
    simp only [KRegs.all,List.mem_cons,List.mem_append]
    change q∈(LowZero18LowK.jregsS L ext src dst).S++(LowZero18LowK.jregsS L ext src dst).T at h
    rcases List.mem_append.mp h with h|h <;> tauto
  have cap := SumSavedSupport.capture_support _ wK geo.1 geo.2.1
  have reb := SumSavedSupport.rebuild_support _ (SumSavedSquare.inner L ext src dst) wK geo.1 geo.2.1
    geo.2.2.2.1 geo.2.2.2.2.1
  have rK' : (SumSavedSquare.K L ext src dst).R.all.toFinset⊆outerSet L control ext src dst := by rw [kr]; exact rK
  have pc := (SumSavedSquare.K L ext src dst).R.piece_support wK
  have cc := pc.2.2.2.1
  simp only [wires_append,Finset.union_subset_iff] at cc
  have c8 := ((SumSavedSquare.K L ext src dst).R.c8z_wires wK).trans cc.1.1
  have c7 := ((SumSavedSquare.K L ext src dst).R.c7t_wires).trans cc.1.2
  have c6 := ((SumSavedSquare.K L ext src dst).R.c6h_wires wK).trans cc.2
  have sc := (SumSavedSquare.K L ext src dst).R.scl1591_support wK
  have kS : SumSavedSquare.K L ext src dst=LowZero18Square.patchKG L (LowZero18LowK.kgS L ext src dst) := by
    simp only [SumSavedSquare.K,SumInnerSparseSquare.K,LowZero18LowK.kg,hS,show ¬(129:Nat)=128 by decide,if_false]
  have q5c : wires (SumSavedSquare.K L ext src dst).Q5c⊆outerSet L control ext src dst := by
    rw [kS]; exact js.2.trans jK
  have q2c : wires (SumSavedSquare.K L ext src dst).Q2c⊆outerSet L control ext src dst := by
    rw [kS]
    exact ((PlainKnownClear.program_wires_le (LowZero18LowK.oregs L ext src dst).hi
      (LowZero18LowK.oregs L ext src dst).dhi (LowZero18LowK.oregs L ext src dst).pad
      (LowZero18LowK.oregs L ext src dst).carry (LowZero18LowK.oregs L ext src dst).cin).trans
      rp.2.2.2.2.2.1).trans rK
  have all : wires (sumSavedPrefix (SumSavedSquare.K L ext src dst) (SumSavedSquare.inner L ext src dst))⊆
      outerSet L control ext src dst := by
    have reb' := reb.trans (Finset.union_subset rK' innerSub)
    have rest : wires (SumRestoreSupport.restore (SumSavedSquare.K L ext src dst).R)⊆outerSet L control ext src dst := by
      rw [SumRestoreSupport.restore,wires_append,wires_append]
      exact Finset.union_subset (Finset.union_subset (c8.trans rK') (c7.trans rK')) (c6.trans rK')
    have pre : wires (SumSavedClear.prefixNew (SumSavedSquare.K L ext src dst) (SumSavedSquare.inner L ext src dst))⊆
        outerSet L control ext src dst := by
      rw [SumSavedClear.prefixNew,wires_append,wires_append]
      exact Finset.union_subset (Finset.union_subset (cap.trans rK') rest) reb'
    rw [sumSavedPrefix,wires_append,wires_append,wires_append]
    exact Finset.union_subset (Finset.union_subset (Finset.union_subset pre q5c) (sc.trans rK')) q2c
  exact all

