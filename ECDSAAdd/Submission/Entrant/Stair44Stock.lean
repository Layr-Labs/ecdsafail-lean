    rw [List.find?_isSome]; exact ⟨j, hj, hjp⟩
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.mp hs
  have hkm := List.mem_of_find?_eq_some hk
  have hkp := List.find?_some hk
  have hfd : firstDiff a b = k := by simp [firstDiff, hk]
  rw [hfd]
