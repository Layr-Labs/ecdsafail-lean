/-- **Division core for `bestLoans`** from the pinned record plans. -/
theorem entryCoreR_best (half : StairLoanRecordShape.HalfReplayHypothesis)
    (plan : ∀ x, EntryPlanR P x) :
    ∀ s, StairConcreteAssembly.EntryPre s → ∀ fresh old,
      run (StairLoanField7Cores.entrySelectedArithmeticFor StairConcrete.bestLoans) fresh s =
        run (StairLoanField7Cores.entryReferenceArithmeticFor StairConcrete.bestLoans) old s := by
  intro s hs fresh old
  obtain ⟨x, hx⟩ := entryPre_x s hs
  have h : ∀ t, EntryPreX x t → ∀ fresh old,
      run (StairLoanField7Cores.entrySelectedArithmeticFor StairConcrete.bestLoans) fresh t =
        run (StairLoanField7Cores.entryReferenceArithmeticFor StairConcrete.bestLoans) old t := by
    rw [selArithL_shape, refArithL_shape]
    apply runEqOn_of_coupled (chainLR_of_planR _ x (plan x)
      (entryReachTransportR_best half x) entryGroupSub_best)
    intro t ht
    have h := refArith_best_tapeFree half t (entryPre_of_x x t ht)
    rw [refArithL_shape] at h
    exact h
  exact h s hx fresh old

