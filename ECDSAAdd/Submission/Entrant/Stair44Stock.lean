theorem shapeExitKernel_run_eq (half : HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44) (k : Nat) (s : State)
    (hs : StairConcreteAssembly.ExitPre k s) (fresh old : List Bool) :
    run (exitKernelShape k) fresh s =
      run (ParityXExitInverse23Kernel.kernelXN k) old s := by
  rcases hs with ⟨f⟩
  have records : measurementCount (renameProgram Rolling1588Lifetime.phaseHost
      (Rolling1588TickGap.firstPhase false)) =
      measurementCount (renameProgram Rolling1588Lifetime.phaseHost
        (Rolling1588.firstPhase false)) := by
    rw [(renameProgram_counts _ _).2, (renameProgram_counts _ _).2,
      (Rolling1588TickGap.first_metrics false).2.1]
  have firstEq (r : List Bool) :=
    Rolling1588TickGap.first_hosted_run_eq false f.sharedNodup f.x f.Y.val
      f.x_pos f.x_lt s r f.input
  have integerBoundary : ∀ mn mf,
      run (Rolling1588.stackForward false) mf
          (run (FrontierEntry1591Native.forward base) mn s) =
        pullState (OB5.sig 511) (run (Rolling1588.allEncode base false 102) []
          (run (W.compactSkywalkForward base 1 511) []
            (run (FrontierEntry1591Native.forward base) mn s))) :=
    fun mn mf => Rolling1588.stackForward_boundary false f.sharedNodup
      f.historyAbove f.x f.x_pos f.x_lt _ mf
      (FrontierEntry1591Native.caller_first_stageW base f.sharedNodup f.x f.Y.val
        f.x_pos f.x_lt s mn f.input)
  -- loaned side
  have eqNB := append_run_eqN _ _
    (exitFieldHostedShape StairConcrete.bestLoans ++
      renameProgram Rolling1588Lifetime.phaseHost
        (ParityXExitInverse23Kernel.lastXN k)) s fresh records firstEq
  have resB := ParityXExitInverse23Kernel.hostedN
    (exitFieldHostedShape StairConcrete.bestLoans) k f.k_lt f.sharedNodup
    f.historyAbove f.x f.Y.val f.x_pos f.x_lt s fresh
    (centerWord (f.Y * (f.x : Fp) / 2)) f.input integerBoundary
    (exitHostedShape_work_free half)
    (fun mp mf => shape_exit_boundary half endpoint f.sharedNodup f.historyAbove
      f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt s mp mf f.input
      f.selectorG_zero f.selectorS_zero)
  have pinB := ParityXExitInverse23Kernel.hostedX
    (exitFieldHostedShape StairConcrete.bestLoans) k f.k_lt f.sharedNodup
    f.historyAbove f.x f.Y.val f.x_pos f.x_lt s fresh
    (centerWord (f.Y * (f.x : Fp) / 2)) f.input integerBoundary
    (exitHostedShape_work_free half)
    (fun mp mf => shape_exit_boundary half endpoint f.sharedNodup f.historyAbove
      f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt s mp mf f.input
      f.selectorG_zero f.selectorS_zero)
  -- record side
  have eqNR := append_run_eqN _ _
    (Rolling1588.exitFieldHosted ++
      renameProgram Rolling1588Lifetime.phaseHost
        (ParityXExitInverse23Kernel.lastXN k)) s old records firstEq
  have resR := ParityXExitInverse23Kernel.hostedN Rolling1588.exitFieldHosted k
    f.k_lt f.sharedNodup f.historyAbove f.x f.Y.val f.x_pos f.x_lt s old
    (centerWord (f.Y * (f.x : Fp) / 2)) f.input integerBoundary
    Rolling1588.exitFieldHosted_work_free
    (fun mp mf => Rolling1588.exit_boundary f.sharedNodup f.historyAbove
      f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt s mp mf f.input
      f.selectorG_zero f.selectorS_zero)
  have pinR := ParityXExitInverse23Kernel.hostedX Rolling1588.exitFieldHosted k
    f.k_lt f.sharedNodup f.historyAbove f.x f.Y.val f.x_pos f.x_lt s old
    (centerWord (f.Y * (f.x : Fp) / 2)) f.input integerBoundary
    Rolling1588.exitFieldHosted_work_free
    (fun mp mf => Rolling1588.exit_boundary f.sharedNodup f.historyAbove
      f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt s mp mf f.input
      f.selectorG_zero f.selectorS_zero)
  have same := exit_output_unique s _ _ _ _ pinB pinR
  unfold exitKernelShape
  rw [eqNB, resB, same, ← resR, ← eqNR]
  rfl

end ECDSAAdd.Entrant.StairLoanRecordExitKernel

end
end Merge_StairLoanRecordExitKernel_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanRecordKernel_at_Main` -/
section Merge_StairLoanRecordKernel_at_Main

/-!
# The loaned record-shaped division kernel equals the record kernel

Level 3: the hosted loaned field `entryFieldHostedShape bestLoans` equals the
record's `Rolling1588.entryFieldHosted` on the record's own `entry_frame`
input.  Both sides are unwrapped with the record's parametric hosting lemmas
(`HostOB5.hosted_run`, `ParityField1591.run_eq_xor`); the loaned side's
output facts are transferred from the record through the Level 2 equality,
and the forced control bit is removed by `Stack5.local_replace` (neither
program touches `base 2400`).

Level 4: `EntryCorrect` for the loaned record-shaped kernel
`InverseFiveEntry23.kernel15 true false (entryFieldHostedShape bestLoans)`,
by the record's parametric `kernel_result15` / `kernel_first_eq15`, and then
run equality with `InverseFiveEntry23.entryKernel15` on `EntryPre`: both
outputs have the same phase, the same numerator block (`regValue_eq_iff`)
and are unchanged elsewhere.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanRecordKernel

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairLoanRecordShape StairLoanRecordSupport

attribute [local irreducible] wires run

/-! ## Copies of private record helpers -/




/-! ## Level 3: the hosted division field -/



/-! ## Level 4: the record-shaped division kernel -/


/-- `EntryCorrect` for the loaned record-shaped kernel (old first phase). -/
theorem shape_old_entry_correct15 (half : HalfReplayHypothesis) :
    FrontierEntry1591Callers.EntryCorrect
      (InverseFiveEntry23.oldKernel15 true false
        (entryFieldHostedShape StairConcrete.bestLoans)) := by
  intro hn hlo ho hf x Y hx0 hx s t m input hg hs phase same halfValue
  obtain ⟨out, outEq⟩ : ∃ out : State,
      run (InverseFiveEntry23.oldKernel15 true false
        (entryFieldHostedShape StairConcrete.bestLoans)) m t = out := ⟨_, rfl⟩
  have actualInput := FrontierEntry1591Kernel.paired_input x Y.val s t input same
  have result := InverseFiveEntry23.kernel_result15 true false
    (entryFieldHostedShape StairConcrete.bestLoans) hn hlo x _ hx0 hx t m
    (Y / (x : Fp)).val actualInput (entryHostedShape_work_free half)
    (fun mp mf => shape_entry_boundary half hn hlo ho hf x Y hx0 hx s t mp mf
      input hg hs phase same halfValue)
  change (run (InverseFiveEntry23.oldKernel15 true false
        (entryFieldHostedShape StairConcrete.bestLoans)) m t).phase = t.phase ∧
      regValue (wireBlock base 2056 256)
          (run (InverseFiveEntry23.oldKernel15 true false
            (entryFieldHostedShape StairConcrete.bestLoans)) m t).basis =
        (Y / (x : Fp)).val ∧
      ∀ q, q ∉ wireBlock base 2056 256 →
        (run (InverseFiveEntry23.oldKernel15 true false
          (entryFieldHostedShape StairConcrete.bestLoans)) m t).basis q =
          t.basis q at result
  rw [outEq] at result
  have conclusion : out.phase = s.phase ∧
      regValue (wireBlock base 2056 256) out.basis = (Y / (x : Fp)).val ∧
      ∀ q, q ∉ wireBlock base 2056 256 → out.basis q = s.basis q :=
    ⟨result.1.trans phase, result.2.1,
      fun q hq => (result.2.2 q hq).trans (same q hq)⟩
  dsimp only
  rw [outEq]
  simpa only [skywalkArithmeticResult, if_true] using conclusion

/-- `EntryCorrect` for the loaned record-shaped kernel. -/
theorem shape_entry_correct15 (half : HalfReplayHypothesis) :
    FrontierEntry1591Callers.EntryCorrect
      (InverseFiveEntry23.kernel15 true false
        (entryFieldHostedShape StairConcrete.bestLoans)) := by
  intro hn hlo ho hf x Y hx0 hx s t m input hg hs phase same halfValue
  have actual := FrontierEntry1591Kernel.paired_input x Y.val s t input same
  rw [InverseFiveEntry23.kernel_first_eq15 true false
    (entryFieldHostedShape StairConcrete.bestLoans) hn x _ hx0 hx t m actual]
  exact shape_old_entry_correct15 half hn hlo ho hf x Y hx0 hx s t m input hg hs
    phase same halfValue


/-- The loaned record-shaped division kernel equals the record division
kernel on every `EntryPre` state, for independent tapes. -/
theorem shapeEntryKernel_run_eq (half : HalfReplayHypothesis)
    (t : State) (ht : StairConcreteAssembly.EntryPre t) (fresh old : List Bool) :
    run (InverseFiveEntry23.kernel15 true false
        (entryFieldHostedShape StairConcrete.bestLoans)) fresh t =
      run InverseFiveEntry23.entryKernel15 old t := by
  rcases ht with ⟨f⟩
  have a := shape_entry_correct15 half f.sharedNodup f.historyAbove
    f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt f.source t fresh f.input
    f.selectorG_zero f.selectorS_zero f.phase f.outsideNumerator f.numerator
  have b := InverseFiveEntry23.entry_correct15 f.sharedNodup f.historyAbove
    f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt f.source t old f.input
    f.selectorG_zero f.selectorS_zero f.phase f.outsideNumerator f.numerator
  exact entry_output_unique f.source _ _ _ a b

end ECDSAAdd.Entrant.StairLoanRecordKernel

end
