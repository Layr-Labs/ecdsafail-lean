/-- **Unpacking a stored v3 checkpoint gives LT1's `CodecInput`.** -/
theorem codecInput_after_unpack (B : Nat) (hB : B ∈ budgets) (x : Nat)
    (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (u : State)
    (pre1 : ∀ r ∈ futurePayload B, u.basis r = cmpBits B x r)
    (pre2 : ∀ r ∈ rowSites B, r ∉ futurePayload B → u.basis r = false) (m : List Bool) :
    (run (unrelocate B ++ StairCodec.unpack (physicalLayout B) B) m u).phase = u.phase ∧
    StairCodec.CodecInput (physicalLayout B) B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B))
      (run (unrelocate B ++ StairCodec.unpack (physicalLayout B) B) m u).basis ∧
    ∀ q, q ∉ moveSites (unrelocPairs B) → q ∉ StairCodec.declaredSites (physicalLayout B) B →
      (run (unrelocate B ++ StairCodec.unpack (physicalLayout B) B) m u).basis q = u.basis q := by
  have hR := rowFacts B hB
  have hdom := domain_row B hB x hx0 hx
  have h3 : 3 ≤ B := hR.1
  obtain ⟨ph1, cc, out1⟩ := compactCode_after_unrelocate B hR x hdom u pre1 pre2
    (m.take (measurementCount (unrelocate B)))
  have functional := StairCodecFunctionalV3.codecFunctionalSpec B (budget_mem_checkpoints B hB)
  have spec := functional.2.2 _ _ _ hdom (physicalLayout_nodup B hB)
  obtain ⟨ph2, ci⟩ := spec.2 _ (m.drop (measurementCount (unrelocate B))) cc
  rw [run_append]
  refine ⟨ph2.trans ph1, ci, ?_⟩
  intro q hq hd
  rw [run_preserves_outside _ _ _ q (fun h => hd (List.mem_toFinset.mp
    (StairCodec.unpack_support _ _ h3 h))), out1 q hq]

