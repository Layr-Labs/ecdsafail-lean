/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSiteEasyX1N_at_Main` -/
section Merge_StairSiteEasyX1N_at_Main

/-!
# Field 12 on CANON 1945: the exit x-tail `x1N k` for every `k` (LT35)

`ParityXExitInverse23Kernel.x1N k = renameProgram pi (ParityXExit.programN base (base 2400) k)`.
The record bounds its labels by `mSites`, which contains `base 511` (and
`pi (base 511) = base 725`, a hole label), so the record support is too
coarse.  Here the merged exit `ExitMerge.program base (base 2400) k` is
unfolded once: its only `k`-dependent parts are masked / xor constant loads
(`maskedConstant c r v`, `xorConstant r v`), whose wires lie in `c :: r`
(`maskedConstant_wires_subset`, `xorConstant_wires_subset`), and the two
parity-dependent `CX` pairs of `parBack`.  Every other leaf is a fixed
program, checked once by `allSites`.  `ParityXExit.prefix_sub` and
`programAll_wires` carry the bound to `programN`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

namespace ECDSAAdd.Entrant.StairSiteEasy

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly StairSiteAvoidance

/-- Every label of `P`, placed by the x-tail map `pi`, is a good phase label. -/
def PiOK (P : Program) : Prop := ∀ b ∈ wires P, PPI (ParityXExitInverse23Kernel.pi b)


theorem piOK_of_all {P : Program}
    (h : allSites (fun b => decide (PPI (ParityXExitInverse23Kernel.pi b))) P = true) :
    PiOK P :=
  fun b hb => of_decide_eq_true (allSites_sound h b hb)



section Tight
open E1Merge E1WholeKAdd52Research ExitMerge


end Tight

/-- K4-B (replay budget): `pi` is the identity away from its four exchanged label pairs. -/
theorem kbPi_id {x : Nat} (h : x < 527 ∨ (528 ≤ x ∧ x < 737) ∨ (742 ≤ x ∧ x < 1813) ∨ 1814 ≤ x) :
    ParityXExitInverse23Kernel.pi x = x := by
  have e527 : x ≠ base 511 := by simp only [MappedCompressed.base]; omega
  have e741 : x ≠ base 725 := by simp only [MappedCompressed.base]; omega
  have e737 : x ≠ base 721 := by simp only [MappedCompressed.base]; omega
  have e739 : x ≠ base 723 := by simp only [MappedCompressed.base]; omega
  have e738 : x ≠ base 722 := by simp only [MappedCompressed.base]; omega
  have e740 : x ≠ base 724 := by simp only [MappedCompressed.base]; omega
  have e1813 : x ≠ base 1797 := by simp only [MappedCompressed.base]; omega
  change E1QubitPlacement.nativeSwap (E1QubitPlacement.rho x) = x
  unfold E1QubitPlacement.nativeSwap E1QubitPlacement.rho
  simp only [Equiv.trans_apply]
  rw [Equiv.swap_apply_of_ne_of_ne e527 e741, Equiv.swap_apply_of_ne_of_ne e737 e739,
    Equiv.swap_apply_of_ne_of_ne e738 e740, Equiv.swap_apply_of_ne_of_ne e1813 e527]

/-- The tail labels, placed by `pi`, are good phase labels (one cheap check, ≈ 1,000 labels).
K4-B (replay budget): symbolic on the three label blocks (`kbPi_id`), five labels evaluated. -/
theorem tSites_pi : ∀ q ∈ tSites base (base 2400), PPI (ParityXExitInverse23Kernel.pi q) := by
  intro q hq
  unfold tSites at hq
  rcases List.mem_append.mp hq with hq | hq
  · rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range'_1.mp hi
        rw [kbPi_id (x := base i) (Or.inl (by simp only [MappedCompressed.base]; omega))]
        unfold PPI
        simp only [MappedCompressed.base]
        omega
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range'_1.mp hi
        rw [kbPi_id (x := base i)
          (Or.inr (Or.inr (Or.inl ⟨by simp only [MappedCompressed.base]; omega,
            by simp only [MappedCompressed.base]; omega⟩)))]
        unfold PPI
        simp only [MappedCompressed.base]
        omega
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
      have hi' := List.mem_range'_1.mp hi
      rcases Nat.lt_or_ge i 1797 with h | h
      · rw [kbPi_id (x := base i)
          (Or.inr (Or.inr (Or.inl ⟨by simp only [MappedCompressed.base]; omega,
            by simp only [MappedCompressed.base]; omega⟩)))]
        unfold PPI
        simp only [MappedCompressed.base]
        omega
      · obtain rfl : i = 1797 := by omega
        decide
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl <;> decide

/-- LT46 (replay budget): structural (`exitMerge_tight` + `tSites_pi`); no program is
evaluated (was ≈ 85 s of kernel time for the fixed leaves). -/
theorem exitMerge_piOK (k : Nat) : PiOK (ExitMerge.program base (base 2400) k) :=
  fun b hb => tSites_pi b (List.mem_toFinset.mp (exitMerge_tight base (base 2400) k hb))

theorem x1N39 (k : Nat) :
    PieceOK StairCertificate.holes39 PP (ParityXExitInverse23Kernel.x1N k) := by
  apply ok39_of_ppi
  intro x hx
  unfold ParityXExitInverse23Kernel.x1N at hx
  rw [renameProgram_support] at hx
  obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hx
  unfold ParityXExit.programN at hb
  rw [wires_append, Finset.mem_union] at hb
  rcases hb with hb | hb
  · exact exitMerge_piOK k b
      (ParityXExit.programAll_wires _ _ k (ParityXExit.prefix_sub _ _ k hb))
  · have sw : PiOK (FlagEntry.swp (base 514) (base 722)) := piOK_of_all (by decide +kernel)
    exact sw b hb

end ECDSAAdd.Entrant.StairSiteEasy

end
