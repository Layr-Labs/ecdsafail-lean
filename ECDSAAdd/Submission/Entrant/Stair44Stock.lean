/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCertificate_at_Main` -/
section Merge_StairCertificate_at_Main

/-!
# Final staircase certificate boundary

This module keeps the final outer program as data because the record wrapper
has not yet selected the new kernels.  Every circuit-local fact has its own
named field, while the outer wrapper composition remains a separate premise.
The certificate proof itself uses the checked staircase ledgers, omission
inventory, and normalizer theorems.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCertificate

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines

/-- Data selected by the final integrator.  `program` is the unnormalized
outer entry, `place` maps the local omission inventory into the final arena,
and `primitives` is the repaired concrete checkpoint implementation. -/
structure Assembly where
  program : Point → Program
  place : Wire → Wire
  layout : Nat → StairCodec.Layout
  primitives : StairSchedule.StairPrimitives
  /-- The host plan of the hosted kernels that occur in `program` (v3). -/
  hostPlan : StairHostsSchedule.HostPlan
  entryPre : State → Prop
  exitPre : Nat → State → Prop

/-- The LT1 functional theorem at every budget used by the best schedule. -/
def CodecFunctionalSpec (A : Assembly) : Prop :=
  ∀ B, B ∈ StairSchedule.checkpoints.map Prod.snd →
    StairCodec.FunctionalSpec (A.layout B) B

/-- Repaired codec/segment replay, including sign extension, local first-tick
semantics, reverse segments, and the concrete schedule placement.  This avoids
the over-strong relation stored by the earlier rich wrapper. -/
def CheckpointReplaySpec (A : Assembly) : Prop :=
  ∀ k, StairReplayPlan.PrimitiveReplay A.primitives k
    A.entryPre (A.exitPre k)

/-- Aggregate loan replay after the two half directions and multiplication
endpoint have been lifted through all packet and schedule wrappers. -/
def LoanReplaySpec (A : Assembly) : Prop :=
  ∀ k, StairReplayPlan.LoanReplay A.primitives StairConcrete.bestLoans k
    A.entryPre (A.exitPre k)



/-- Field 13: the hosted kernels that occur in the final program replay the
logical staircase kernels on the exact kernel preconditions, with independent
measurement tapes.  The host plan is the assembly's own `A.hostPlan` (v3:
`StairV3Primitives.hostPlan`), i.e. the plan of the kernels in `A.program`. -/
def HostReplaySpec (A : Assembly) : Prop :=
  (∀ s, A.entryPre s → ∀ hosted logical,
    run (StairHostsSchedule.entryKernel A.primitives
        A.hostPlan) hosted s =
      run (StairSchedule.entryKernel A.primitives
        StairConcrete.bestLoans) logical s) ∧
  (∀ k s, A.exitPre k s → ∀ hosted logical,
    run (StairHostsSchedule.exitKernel A.primitives
        A.hostPlan k) hosted s =
      run (StairSchedule.exitKernel A.primitives
        StairConcrete.bestLoans k) logical s)

/-! ## Qubit bound, parametric in the proved hole list

`HoleList holes` are static facts about a concrete list of omitted arena
sites (decidable); `HolePlacement holes P` says the program avoids the 15
record omissions and every listed hole.  The bound is
`qubits P ≤ 1601 − 15 − holes.length`, so a partial field 12 (fewer holes
proved free) still yields a valid, smaller improvement; the full v3 placement
is `holes = StairPhysicalInventory.physicalHoles` (44 holes, Q = 1,542, see
`StairCertificateV3`). -/




/-- Every theorem not yet available at the final integration boundary.

The two directional half fields and `half_support` are combined below with
the already checked zero-depth, count, and physicality theorems.  The outer
composition field therefore consumes the exact compiled half interface rather
than a stronger program-level assumption. -/
structure StairOpen (A : Assembly) (holes : List Wire) : Prop where
  codec_functional : CodecFunctionalSpec A
  checkpoint_composition : CodecFunctionalSpec A → CheckpointReplaySpec A
  loan_forward : PositiveHalfRunSpec true
  loan_inverse : PositiveHalfRunSpec false
  half_support : WholeHalfSupport
  endpoint_run : StairEndpointLoan44.MultiplicationRunSpec44
  loan_composition :
    StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide) →
    StairEndpointLoan44.MultiplicationRunSpec44 →
    LoanReplaySpec A
  semantic_composition :
    (∀ k, StairSchedule.ReplayInterface A.primitives StairConcrete.bestLoans k
      A.entryPre (A.exitPre k)) →
    ∀ C b R, Triple (encodes b R) (A.program C)
      (encodes b (if b then R + C else R))
  physical_composition :
    StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide) →
    ∀ C, GatePhysical (A.program C)
  count_composition : ∀ C,
    toffoliCount (A.program C) ≤ 2170000 ∧ measurementCount (A.program C) ≤ 1521500
  slot_composition : ∀ C,
    gateSlots (A.program C) ≤
      gateSlots (AboveFieldPointDevelop.programQ C) + StairInventory.bestSlotDelta
  site_avoidance : ∀ C, HolePlacement holes (A.program C)
  host_replay : HostReplaySpec A

/-- Assemble the complete half interface from the three remaining peer facts
and the count/physicality theorems already present in the staircase bundle. -/
theorem half760_interface {A : Assembly} {holes : List Wire} (h : StairOpen A holes) :
    StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide) where
  run_eq divide d hd origin clean X Y s fresh old input := by
    by_cases hz : d = 0
    · subst d
      exact StairLoan.half760Loan_zero_run_eq divide
        Rolling1588Lifetime.half_ports_nodup origin clean X Y s fresh old input
    · have hp : 0 < d := Nat.pos_of_ne_zero hz
      cases divide with
      | false => exact h.loan_inverse d hp hd origin clean X Y s fresh old input
      | true => exact h.loan_forward d hp hd origin clean X Y s fresh old input
  counts divide d hd := by
    have loan := StairLoan.half760Loan_counts d divide hd
    have record := R2Life760.half760_counts divide
    constructor <;> omega
  support divide d hd := h.half_support divide d hd
  physical divide d _ := StairLoanSupport.half760Loan_physical d divide

/-- Compose the repaired primitive replay and the loan replay through the
checked schedule transitivity theorem. -/
theorem replay_interfaces {A : Assembly} {holes : List Wire} (h : StairOpen A holes) :
    ∀ k, StairSchedule.ReplayInterface A.primitives StairConcrete.bestLoans k
      A.entryPre (A.exitPre k) := by
  intro k
  exact StairReplayPlan.replayInterface_of_parts A.primitives
    StairConcrete.bestLoans k A.entryPre (A.exitPre k)
    (h.loan_composition (half760_interface h) h.endpoint_run k)
    (h.checkpoint_composition h.codec_functional k)

end ECDSAAdd.Entrant.StairCertificate

end
end Merge_StairCertificate_at_Main

