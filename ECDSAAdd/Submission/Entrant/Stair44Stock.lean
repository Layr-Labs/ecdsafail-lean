private theorem good_of_envelope {P Q : Program}
    (env : wires P ⊆ wires Q ∪ StairBoundaryLoan.converterHosts.toFinset)
    (hQ : Good Q) : Good P := by
  intro q hq
  rcases Finset.mem_union.mp (env hq) with h | h
  · exact hQ q h
  · exact of_decide_eq_true
      (List.all_eq_true.mp converterHosts_indom q (List.mem_toFinset.mp h))

theorem sound_canon760Loan : Sound StairBoundaryLoan.canon760Loan :=
  ⟨StairBoundaryLoan.canon760Loan_physical,
    good_of_envelope StairBoundaryLoan.canon760Loan_envelope rec_canon⟩

theorem sound_center760Loan : Sound StairBoundaryLoan.center760Loan :=
  ⟨StairBoundaryLoan.center760Loan_physical,
    good_of_envelope StairBoundaryLoan.center760Loan_envelope rec_center⟩

/-- LT45 (replay budget): the loaned division endpoint only touches wires of the record
endpoint (`Inclusion.endPacket760DivLoan_sub`), so the record endpoint's domain fact
transfers (no kernel evaluation of the endpoint: 30 s → < 1 s). -/
theorem sound_endPacket760DivLoan :
    Sound CompareDecoder.BoundaryLoan.endPacket760DivLoan :=
  ⟨CompareDecoder.BoundaryLoan.endPacket760DivLoan_physical,
    good_of_subset CompareDecoder.BoundaryLoan.Inclusion.endPacket760DivLoan_sub
      rec_endPacket_true⟩


/-- LT6 (LT19 endpoint in the slot): the 44-site multiplication endpoint is
physical, and its wires are among the record endpoint's (`_support`), so the
record endpoint's domain fact transfers. -/
theorem sound_multEndpoint_loan44 : Sound (StairEndpointLoan44.endPacket760Loan44 false) :=
  ⟨StairEndpointLoan44.endPacket760Loan44_false_physical,
    good_of_subset StairEndpointLoan44.endPacket760Loan44_support rec_endPacket_false⟩

/-- The boundary slot for `StairConcrete.bestLoans` as built in CANON v3 today. -/
theorem boundarySlots_current : BoundarySlots where
  divEndpoint := by
    rw [StairConcrete.bestLoans_divEndpoint]
    exact sound_endPacket760DivLoan
  multEndpoint := by
    rw [bestLoans_endPacket_false68]
    exact sound_multEndpoint_loan44
  canon := by
    rw [StairConcrete.bestLoans_canon]
    exact sound_canon760Loan
  center := by
    rw [StairConcrete.bestLoans_center]
    exact sound_center760Loan

