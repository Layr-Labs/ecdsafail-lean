 rcases hq with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
 all_goals simp
theorem old_S (R inner : KRegs) (w : R.W) (rh : R.h=64) (rb : R.bank.length=129)
 (q : Wire) (hq : q∈R.S) : q∈wires (SumInnerSparseRebuild.rebuild R inner) := by
