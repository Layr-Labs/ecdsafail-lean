    (StairSquareKernel26C.kC_support hl _) (StairSquareKernel26C.kB_support hl _)
    (StairSquareKernel26C.kA_support hl _) hostsGood
  exact squareN_pieceOK hl (memCert hl hsub) (brC hl) (brB hl) (brA hl) k
