    exact lastTrip_pinned x σ s hσ.1 (cvX_cv x 12 _ _ hσ.2) hΦ [] _
  refine ⟨[], ?_⟩
  show RelX x 12 (run (firstSel StairExitLT24.P) fresh s) s
  rw [eF, key]
  exact hσ

