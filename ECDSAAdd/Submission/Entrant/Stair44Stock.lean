    rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · rcases List.mem_append.mp hq with hq | hq
        · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
          have hi' := List.mem_range'_1.mp hi
          exact kbXI1 i (by omega) (by omega)
        · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
          have hi' := List.mem_range'_1.mp hi
          rcases Nat.lt_or_ge i 1026 with h | h
          · exact kbXI2 i (by omega) h
          · rcases Nat.lt_or_ge i 1027 with h' | h'
            · obtain rfl : i = 1026 := by omega
              decide
            · exact kbXI3 i h' (by omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range'_1.mp hi
        rcases Nat.lt_or_ge i 1543 with h | h
        · have : i = 1540 ∨ i = 1541 ∨ i = 1542 := by omega
          rcases this with rfl | rfl | rfl <;> decide
        · rcases Nat.lt_or_ge i 1656 with h' | h'
