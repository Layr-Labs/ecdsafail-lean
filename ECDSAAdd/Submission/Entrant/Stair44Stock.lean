/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Core_at_Main` -/
section Merge_StairField2V3Core_at_Main

/-!
# LT21: field 2 on CANON v3 — reduction to the two arithmetic cores

v3 port of LT14's `StairChainWitness.compositionOfCores` (which imported the
old-layout `StairChainPredicates`).  Everything except the two arithmetic run
equalities is proved here:

* `compositionOfCores entryCore exitCore : ConcreteComposition concreteAssembly`
* `field2_of_cores entryCore exitCore :
    CodecFunctionalSpec concreteAssembly → CheckpointReplaySpec concreteAssembly`
  (= the certificate's `checkpoint_composition` field type).

Each core is further split (`entryCore_of_split`, `exitCore_of_split`) into a
*basis* simulation with the empty tape and a *phase* statement.  The basis
evolution of `run` ignores the tape (`run_basis_records`), so the basis part is
a purely classical simulation; the record side is tape-free on the relevant
states, so only the staircase phase has to be matched.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3Core

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

abbrev Assembly := StairConcreteAssembly.concreteAssembly

def EntryMiddle (s : State) : Prop :=
  ∀ fresh old,
    run (StairField2V3Replay.entryReferenceClosing) fresh s =
      run (StairField2V3Replay.entryReferenceClosing) old s



theorem entryClosing_step :
    StairField2V3Replay.ReplayStep EntryMiddle (fun _ => True)
      (StairField2V3Replay.entrySelectedClosing Assembly)
      StairField2V3Replay.entryReferenceClosing := by
  have same : StairField2V3Replay.entrySelectedClosing Assembly =
      StairField2V3Replay.entryReferenceClosing := rfl
  constructor
  · intro s hs fresh old
    rw [same]
    exact hs fresh old
  · intro _ _ _
    trivial


theorem exitOpening_step (k : Nat) :
    StairField2V3Replay.ReplayStep
      (StairConcreteAssembly.ExitPre k) (ExitMiddle k)
      (StairField2V3Replay.exitSelectedOpening Assembly)
      StairField2V3Replay.exitReferenceOpening := by
  have same : StairField2V3Replay.exitSelectedOpening Assembly =
      StairField2V3Replay.exitReferenceOpening := rfl
  constructor
  · intro s hs fresh old
    rw [same]
    exact exitOpening_run_eq k s hs fresh old
  · intro s hs records
    exact ⟨s, hs, records, rfl⟩

theorem entryKernel15_tapeFree (s : State)
    (hs : StairConcreteAssembly.EntryPre s) :
    StairField2V3Replay.TapeFree InverseFiveEntry23.entryKernel15 s := by
  rcases hs with ⟨f⟩
  apply StairField2V3Replay.tapeFree_of_phase
  intro m
  have h := InverseFiveEntry23.entry_correct15 f.sharedNodup f.historyAbove
    f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt f.source s m f.input
    f.selectorG_zero f.selectorS_zero f.phase f.outsideNumerator f.numerator
  exact h.1.trans f.phase.symm

theorem entryReference_post (s : State)
    (hs : StairConcreteAssembly.EntryPre s) (records : List Bool) :
    EntryMiddle (run StairField2V3Replay.entryReferenceArithmetic records s) := by
  have free := entryKernel15_tapeFree s hs
  rw [← StairField2V3Replay.entryReference_shape] at free
  intro fresh old
  exact StairField2V3Replay.nested_tapeFree _ _ s free records fresh records old

/-- The record division arithmetic is tape-free on `EntryPre`. -/
theorem entryReferenceArithmetic_tapeFree (s : State)
    (hs : StairConcreteAssembly.EntryPre s) :
    StairField2V3Replay.TapeFree StairField2V3Replay.entryReferenceArithmetic s := by
  have free := entryKernel15_tapeFree s hs
  rw [← StairField2V3Replay.entryReference_shape] at free
  intro m n
  apply State.extensionality
  · have h := congrArg State.phase
      (StairField2V3Replay.nested_tapeFree _ _ s free m [] n [])
    -- the closing is tape-free on both intermediate states only as a pair;
    -- recover the phase of the arithmetic part from `run_local_increment`.
    have inc := ECDSAAdd.Arithmetic.run_local_increment
      StairField2V3Replay.entryReferenceClosing
      (run StairField2V3Replay.entryReferenceArithmetic m s)
      (run StairField2V3Replay.entryReferenceArithmetic n s) []
      (fun q _ => by rw [run_basis_records _ s s m n rfl])
    have hb : (run StairField2V3Replay.entryReferenceArithmetic m s).basis =
        (run StairField2V3Replay.entryReferenceArithmetic n s).basis :=
      run_basis_records _ s s m n rfl
    have e1 := inc.1
    revert h e1
    generalize (run StairField2V3Replay.entryReferenceClosing []
      (run StairField2V3Replay.entryReferenceArithmetic m s)).phase = a
    generalize (run StairField2V3Replay.entryReferenceClosing []
      (run StairField2V3Replay.entryReferenceArithmetic n s)).phase = b
    generalize (run StairField2V3Replay.entryReferenceArithmetic m s).phase = c
    generalize (run StairField2V3Replay.entryReferenceArithmetic n s).phase = d
    intro h e1
    subst h
    cases a <;> cases c <;> cases d <;> simp_all
  · exact run_basis_records _ s s m n rfl


/-- The record multiplication remainder is tape-free on `ExitMiddle k`. -/
theorem exitReferenceRemainder_tapeFree (k : Nat) (t : State)
    (ht : ExitMiddle k t) (hfree : ∀ s, StairConcreteAssembly.ExitPre k s →
      StairField2V3Replay.TapeFree (ParityXExitInverse23Kernel.kernelXN k) s) :
    StairField2V3Replay.TapeFree (StairField2V3Replay.exitReferenceRemainder k) t := by
  obtain ⟨s, hs, records, hts⟩ := ht
  exact tapeFree_tail _ _ _ (StairField2V3Replay.exitReference_shape k) s
    (hfree s hs) records t hts

/-- Field 2 reduced to its two genuine cores. -/
def compositionOfCores
    (entryCore : StairCertificate.CodecFunctionalSpec Assembly →
      StairField2V3Replay.RunEqOn StairConcreteAssembly.EntryPre
        (StairField2V3Replay.entrySelectedArithmetic Assembly)
        StairField2V3Replay.entryReferenceArithmetic)
    (exitCore : StairCertificate.CodecFunctionalSpec Assembly → ∀ k,
      StairField2V3Replay.RunEqOn (ExitMiddle k)
        (StairField2V3Replay.exitSelectedRemainder Assembly k)
        (StairField2V3Replay.exitReferenceRemainder k)) :
    StairField2V3Replay.ConcreteComposition Assembly where
  entryMiddle := EntryMiddle
  entryArithmetic := fun functional =>
    { run_eq := entryCore functional
      reference_post := entryReference_post }
  entryClosing := entryClosing_step
  exitMiddle := ExitMiddle
  exitOpening := exitOpening_step
  exitRemainder := fun functional k =>
    { run_eq := exitCore functional k
      reference_post := fun _ _ _ => trivial }

/-- **Field 2 from the two cores** (exact certificate field type). -/
theorem field2_of_cores
    (entryCore : StairCertificate.CodecFunctionalSpec Assembly →
      StairField2V3Replay.RunEqOn StairConcreteAssembly.EntryPre
        (StairField2V3Replay.entrySelectedArithmetic Assembly)
        StairField2V3Replay.entryReferenceArithmetic)
    (exitCore : StairCertificate.CodecFunctionalSpec Assembly → ∀ k,
      StairField2V3Replay.RunEqOn (ExitMiddle k)
        (StairField2V3Replay.exitSelectedRemainder Assembly k)
        (StairField2V3Replay.exitReferenceRemainder k)) :
    StairCertificate.CodecFunctionalSpec Assembly →
      StairCertificate.CheckpointReplaySpec Assembly :=
  StairField2V3Replay.checkpoint_composition (compositionOfCores entryCore exitCore)

/-! ## Basis / phase split of a core -/



