  set v3 := run (moveProgram (relocPairs B)) m3 v2 with hv3
  have hF := compactF_lt B
    ((StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u -
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)).toNat)
    (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
  have key : ∀ i (hi : i < B - 2), v2.basis ((physicalLayout B).D i) =
      (StairCodec.compactF B
        ((StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u -
