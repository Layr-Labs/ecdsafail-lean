/-!
# Field 10 (`count_composition`) for the hosted concrete assembly (CANON v3)

`concreteProgram C` is the record program `AboveFieldPointDevelop.programQ C`
with the two arithmetic rests of `FlagExit.genericN` replaced by the hosted
staircase rests.  Counts are wire-blind, so for the k = 44 plan

  T(concreteProgram C) = T(programQ C) + 2·(1585 + 9560) + δE_T + δX_T,
  M(concreteProgram C) = M(programQ C) + 2·(1317 + 9560) + δE_M + δX_M,

where δE / δX are the division / multiplication boundary deltas (endpoint +
converter).  The `_of` theorems are parametric in them; the plain theorems
instantiate the current boundary (δE = 44 division-endpoint loan + 44 canon
loan, δX = 44 center loan + 132 LT19 multiplication endpoint):

  T ≤ 2,147,057 + 22,554 (+ 151 for the PSQ square with status hosts) = **2,169,788**,  M ≤ 1,498,884 + 22,018 = **1,520,924**.
-/

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 400000

namespace ECDSAAdd.Entrant.StairCountsHosted

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairConcreteAssembly

attribute [local irreducible] toffoliCount measurementCount

/-- The staircase generic block against the record generic block,
    parametric in the two boundary deltas. -/
theorem hostedGeneric_counts_of (δET δEM δXT δXM : Nat)
    (hE : ∀ L, toffoliCount (hostedEntryRest L) =
        toffoliCount (ParityStageBothInverse23.restEntry L) + 10730 + δET ∧
      measurementCount (hostedEntryRest L) =
        measurementCount (ParityStageBothInverse23.restEntry L) + 10548 + δEM)
    (hX : ∀ L k, toffoliCount (hostedExitRest L k) =
        toffoliCount (ParityXExitInverse23Kernel.restXXN L k) + 10730 + δXT ∧
      measurementCount (hostedExitRest L k) =
        measurementCount (ParityXExitInverse23Kernel.restXXN L k) + 10548 + δXM)
    (L : ControlledPointLayout) (cx cy : Fp) :
    toffoliCount (hostedGeneric L cx cy) ≤
        toffoliCount (FlagExit.genericN L cx cy) + 21460 + 151 + δET + δXT ∧
      measurementCount (hostedGeneric L cx cy) =
        measurementCount (FlagExit.genericN L cx cy) + 21096 + δEM + δXM := by
  obtain ⟨e1, e2⟩ := hE L
  obtain ⟨x1, x2⟩ := hX L cx.val
  obtain ⟨q1, q2⟩ := StairSquareFinal.squareEntryHL_counts StairSqLoopA.holes L
    (ReflectionE1.correction cx)
  rw [hostedGeneric, hostedSecondStage, FlagExit.genericN, FlagExit.secondStageN]
  simp only [toffoliCount_append, measurementCount_append]
  constructor <;> omega

/-- The whole hosted program against the record program, for every point,
    parametric in the two boundary deltas. -/
theorem concreteProgram_counts_of (δET δEM δXT δXM : Nat)
    (hE : ∀ L, toffoliCount (hostedEntryRest L) =
        toffoliCount (ParityStageBothInverse23.restEntry L) + 10730 + δET ∧
      measurementCount (hostedEntryRest L) =
        measurementCount (ParityStageBothInverse23.restEntry L) + 10548 + δEM)
    (hX : ∀ L k, toffoliCount (hostedExitRest L k) =
        toffoliCount (ParityXExitInverse23Kernel.restXXN L k) + 10730 + δXT ∧
      measurementCount (hostedExitRest L k) =
        measurementCount (ParityXExitInverse23Kernel.restXXN L k) + 10548 + δXM)
    (C : Point) :
    toffoliCount (concreteProgram C) ≤
        toffoliCount (AboveFieldPointDevelop.programQ C) + 21460 + 151 + δET + δXT ∧
      measurementCount (concreteProgram C) ≤
        measurementCount (AboveFieldPointDevelop.programQ C) + 21096 + δEM + δXM := by
  cases C with
  | zero =>
    have z1 : toffoliCount (concreteProgram .zero) = 0 := by
      simp only [concreteProgram, toffoliCount]
    have z2 : measurementCount (concreteProgram .zero) = 0 := by
      simp only [concreteProgram, measurementCount]
    constructor <;> omega
  | @some cx cy hc =>
    obtain ⟨g1, g2⟩ := hostedGeneric_counts_of δET δEM δXT δXM hE hX Baselines.layout cx cy
    simp only [concreteProgram, AboveFieldPointDevelop.programQ, hostedWrapper, hostedFinite,
      hostedMiddle, hostedBorrowGeneric, hostedGenericBlock,
      AboveFieldPointDevelop.wrapperBorrow, AboveFieldPointDevelop.finiteBorrow,
      AboveFieldPointDevelop.middle, ControlPointEncodingDevelop.borrowGeneric,
      ControlPointEncodingDevelop.genericBlock, toffoliCount_append,
      measurementCount_append, renameProgram_counts]
    constructor <;> omega

/-- Exact v3 totals, parametric in the boundary deltas: the record bounds
    plus `22316 + δ` Toffoli and `21776 + δ` measurements. -/
theorem count_totals_of (δET δEM δXT δXM : Nat)
    (hE : ∀ L, toffoliCount (hostedEntryRest L) =
        toffoliCount (ParityStageBothInverse23.restEntry L) + 10730 + δET ∧
      measurementCount (hostedEntryRest L) =
        measurementCount (ParityStageBothInverse23.restEntry L) + 10548 + δEM)
    (hX : ∀ L k, toffoliCount (hostedExitRest L k) =
        toffoliCount (ParityXExitInverse23Kernel.restXXN L k) + 10730 + δXT ∧
      measurementCount (hostedExitRest L k) =
        measurementCount (ParityXExitInverse23Kernel.restXXN L k) + 10548 + δXM)
    (C : Point) :
    toffoliCount (concreteAssembly.program C) ≤ 2147057 + 21460 + 151 + δET + δXT ∧
      measurementCount (concreteAssembly.program C) ≤ 1498884 + 21096 + δEM + δXM := by
  obtain ⟨c1, c2⟩ := concreteProgram_counts_of δET δEM δXT δXM hE hX C
  have qT := AboveFieldPointDevelop.program_toffoli_Q C
  have qM := AboveFieldPointDevelop.program_measurements_Q C
  rw [concreteAssembly_program]
  constructor <;> omega

/-- Exact v3 totals for the current boundary (frozen program + LT19 endpoint: δE = 88, δX = 176;
    + the PSQ hole-free square, +151 T): **T ≤ 2,169,074, M ≤ 1,520,242**. -/
theorem count_totals : ∀ C,
    toffoliCount (concreteAssembly.program C) ≤ 2168925 ∧
      measurementCount (concreteAssembly.program C) ≤ 1520247 := by
  intro C
  have h := count_totals_of 82 92 175 175
    (fun L => by
      obtain ⟨a, b⟩ := hostedEntryRest_counts L
      constructor <;> omega)
    (fun L k => by
      obtain ⟨a, b⟩ := hostedExitRest_counts L k
      constructor <;> omega) C
  constructor <;> omega

end ECDSAAdd.Entrant.StairCountsHosted
