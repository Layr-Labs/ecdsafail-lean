  gatePhysical_rename terminalPerm terminalPerm.injective _ reverseRecord_physical

/-! ## Exact supports of the two large record blocks (block by block) -/




theorem candidate15_support : wires InverseFive23.candidate15 ⊆ cand15Sites.toFinset := by
  have blocks_ok : ∀ P ∈ TerminalInverse23.blocks, ∀ q ∈ wires P,
      TerminalFiveBridge.perm q ∈ cand15Sites := by
    intro P hP
    simp only [TerminalInverse23.blocks, List.mem_cons, List.not_mem_nil, or_false] at hP
    rcases hP with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    all_goals decide +kernel
  intro q hq
  rw [InverseFive23.candidate15, TerminalFiveBridge.physical, renameProgram_support,
    Finset.mem_image] at hq
  obtain ⟨x, hx, rfl⟩ := hq
  rw [TerminalInverse23.program] at hx
  obtain ⟨P, hP, hxP⟩ := mem_wires_flatten _ hx
  exact List.mem_toFinset.mpr (blocks_ok P hP x hxP)

/-! ## Support and avoidance -/






/-! ## LT50 (replay budget): kernel-fast form of `TermOK`

`decide` on `TermOK` walked the pool for every placement and scanned the 2,318-element caller list
and the 1,600-element arena (≈ 0.3 s per wire).  `termOKB` uses the closed-form placements of
`StairPlaceFast`, interval tests and literal exchanges; `termOK_of_B` is its soundness. -/














theorem reverseRecord_ok : ∀ x ∈ wires reverseRecord, TermOK reverseSites x := by
  -- LT50 (replay budget): decided on `termOKB` (closed-form placements), then `termOK_of_B`
  have clB : ∀ x ∈ wires (skywalkArithmeticClear base), termOKB reverseSites x = true := by
    decide +kernel
  have trB : ∀ x ∈ wires (renameProgram (OB5.sig 511) tickR), termOKB reverseSites x = true := by
    decide +kernel
  have upB : ∀ y ∈ wires (Rolling1588.unpackAtTick true 510),
      termOKB reverseSites (OB5.sig 510 y) = true := by
    decide +kernel
  have k15B : cand15Sites.all (fun y => termOKB reverseSites (OB5.sig 510 y)) = true := by
    decide +kernel
  have cl : ∀ x ∈ wires (skywalkArithmeticClear base), TermOK reverseSites x :=
    fun x hx => termOK_of_B (clB x hx)
  have tr : ∀ x ∈ wires (renameProgram (OB5.sig 511) tickR), TermOK reverseSites x :=
    fun x hx => termOK_of_B (trB x hx)
  have up : ∀ y ∈ wires (Rolling1588.unpackAtTick true 510),
      TermOK reverseSites (OB5.sig 510 y) := fun y hy => termOK_of_B (upB y hy)
  have k15 : ∀ y ∈ cand15Sites, TermOK reverseSites (OB5.sig 510 y) :=
    fun y hy => termOK_of_B (List.all_eq_true.mp k15B y hy)
  intro x hx
  simp only [reverseRecord, wires_append, Finset.mem_union] at hx
  rcases hx with hc | ht | hu
  · exact cl x hc
  · exact tr x ht
  · rw [renameProgram_support, Finset.mem_image] at hu
    obtain ⟨y, hy, rfl⟩ := hu
    rw [wires_append, Finset.mem_union] at hy
    rcases hy with hy | hy
    · exact up y hy
    · exact k15 y (List.mem_toFinset.mp (candidate15_support hy))


theorem reverseTerminalV3_wires : wires reverseTerminalV3 ⊆ reverseSites.toFinset := by
  intro q hq
  rw [reverseTerminalV3, renameProgram_support, Finset.mem_image] at hq
  obtain ⟨x, hx, rfl⟩ := hq
  exact List.mem_toFinset.mpr (reverseRecord_ok x hx).2.2



theorem reverseTerminalV3_support : ∀ q ∈ wires reverseTerminalV3,
    StairPhysicalInventory.place q ∈ StairHoleSupport.recordArena ∧
      StairPhysicalInventory.place q ∉ StairHoleSupport.oldHoles ∧
      StairPhysicalInventory.place q ∉ StairPhysicalInventory.physicalHoles ∧
      q ∉ StairPhysicalInventory.exclusiveSites ∧
      StairOuterPlacement.fieldPlace q ∉ StairPhysicalInventory.exclusiveSites ∧
      StairOuterPlacement.fieldPlace q ∈ callerList := by
  intro q hq
  rw [reverseTerminalV3, renameProgram_support, Finset.mem_image] at hq
  obtain ⟨x, hx, rfl⟩ := hq
  exact siteOK_spec (reverseRecord_ok x hx).2.1

