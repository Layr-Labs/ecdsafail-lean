/-!
# Field 9 for CANON v3, parametric in the slots

`Sound P` = `GatePhysical P` and every label of `P` in `InDom` (the 2,326
caller labels on which the record placement `wireFn2` is injective).  Every
rename inside the hosted rests preserves `InDom`, so soundness composes.

The v3 hosted rests are assembled from

* record pieces (proved here),
* the loaned packet groups (proved here from the field-9 antecedent),
* first packets rebound on a host list, exclusive roles (proved here, given
  the host list is in `InDom`),
* the **slots**: the primitive provider `p` (`PrimitiveSlots p`), the
  boundary programs of the loan provider `StairConcrete.bestLoans`
  (`BoundarySlots`: both endpoints, `canon`, `center`) and the host plan
  (`HostSlots h`).

`entryLocal_sound` / `exitLocal_sound` hold for ANY `p`, `h`; the concrete
field-9 statement `physical_composition_of_slots` then needs only the three
slot facts for `checkpointPrimitives`, `bestLoans` and `hostPlan`.  No proof
here unfolds `StairConcrete.bestLoans.endPacket/canon/center` or a field of
`p`, so replacing those programs only changes the slot proofs.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairPhysicalV3

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairRestSupport

/-! ## Soundness and its composition -/














/-! ## Record pieces -/









theorem sound_forward424 : Sound (Rolling1588TickGap.forward true 1 424) := by
  refine ⟨Rolling1588TickGap.forward_physical true 1 424 (by omega), ?_⟩
  have h := rec_forward504
  rw [show (504 : Nat) = 424 + 80 from rfl, forward_append] at h
  exact good_left h

theorem sound_reverse424 : Sound (Rolling1588.reverse true 1 424) := by
  refine ⟨recordReverse_physical true 1 424 (by omega), ?_⟩
  have h := rec_reverse505
  rw [show (505 : Nat) = 424 + 81 from rfl, reverse_append] at h
  exact good_right h


theorem sound_lastPhase15 : Sound (InverseFive23.lastPhase15 false) :=
  ⟨InverseFive23.last_physical15 false,
    good_unrename _ indom_phaseHost_inv rec_lastPhase⟩

theorem sound_tailPhase : Sound (Rolling1588TickGap.tailPhase false) := by
  refine ⟨?_, good_unrename _ indom_phaseHost_inv rec_tailPhase_false⟩
  have old := Rolling1588TickGap.first_physical false
  rw [Rolling1588TickGap.firstPhase] at old
  exact gp_right old

theorem sound_x1N (k : Nat) : Sound (ParityXExitInverse23Kernel.x1N k) :=
  ⟨ParityXExitInverse23Kernel.x1N_physical k, rec_x1N k⟩

theorem sound_copyN : Sound HalfFieldOB5.copyN :=
  ⟨(OwnQ5Endpoint.endpoint_physical
      MappedCompressed.LaneA.laneLogical_config.1).2.2, rec_copyN⟩

theorem sound_clearProgram : Sound FourScratchWindow.clearProgram :=
  ⟨FourScratchWindow.physical.2.1, rec_clearProgram⟩

theorem sound_unprefix : Sound FourScratchWindow.unprefix :=
  ⟨FourScratchWindow.physical.2.2, rec_unprefix⟩

theorem sound_paritySetup : Sound StairSchedule.paritySetup := by
  refine ⟨?_, rec_setup⟩
  intro gate mem
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp mem
  have away : q ≠ FrontierEntry1591Field.host := by
    exact fun e => FrontierEntry1591Field.host_not_controls (e ▸ hq)
  simpa only [PhysicalInstr, ProperGate] using away






theorem sound_firstPacket (divide : Bool) :
    Sound (Rolling1588.placedFirstPacket divide) := by
  cases divide
  · refine ⟨?_, rec_firstPacket_false⟩
    have h := recordExitField_physical
    rw [Rolling1588.exitField] at h
    exact gp_right h
  · refine ⟨?_, rec_firstPacket_true⟩
    have h := recordEntryField_physical
    rw [Rolling1588.entryField] at h
    exact gp_left (gp_left (gp_left h))

/-! ## Loaned packet groups (from the field-9 antecedent's support) -/









theorem sound_placedGroups (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (divide : Bool) (d f c : Nat) (hd : d ≤ 68) (hf : 1 ≤ f) (hfc : f + c ≤ 102) :
    Sound (StairSchedule.placedGroups StairConcrete.bestLoans divide d f c) :=
  ⟨gatePhysical_rename _ (OB5.sig_injective 511 (by decide)) _
      (loanGroups_physical divide d f c hfc),
    good_placedGroups H divide d f c hd hf hfc⟩


/-! ## The slots -/



/-- Primitive-provider slot: every primitive call of the v3 schedule is sound. -/
structure PrimitiveSlots (p : StairSchedule.StairPrimitives) : Prop where
  pack : ∀ B ∈ ([87, 62, 47, 32, 22, 12] : List Nat), Sound (p.pack B)
  unpack : ∀ B ∈ ([87, 62, 47, 32, 22, 12] : List Nat), Sound (p.unpack B)
  orient : ∀ f ∈ ([450, 465, 480, 490, 500] : List Nat), Sound (p.orient f)
  orientR : ∀ f ∈ ([450, 465, 480, 490, 500] : List Nat), Sound (p.orientR f)
  tickForward : ∀ s ∈ ([425, 450, 465, 480, 490, 500] : List Nat),
    Sound (p.tickForward s)
  tickReverse : ∀ s ∈ ([425, 450, 465, 480, 490, 500] : List Nat),
    Sound (p.tickReverse s)
  middleForward : ∀ s f, (s, f) ∈ v3Segments →
    Sound (p.middleForward (s + 1) (f - s - 1))
  middleReverse : ∀ s f, (s, f) ∈ v3Segments →
    Sound (p.middleReverse (s + 1) (f - s - 1))
  middleForwardLast : Sound (p.middleForward 501 4)
  middleReverseLast : Sound (p.middleReverse 501 5)
  firstPack : Sound p.firstPack
  firstUnpack : Sound p.firstUnpack
  forwardTerminal : Sound p.forwardTerminal
  reverseTerminal : Sound p.reverseTerminal



/-! ## Generic composition of the v3 schedule -/

section Generic

variable {p : StairSchedule.StairPrimitives} {h : StairHostsSchedule.HostPlan}

theorem sound_hostedGroup (H : LoanHyp) (hs : HostSlots h) (divide : Bool) (d f c : Nat)
    (mem : (d, f, c) ∈ v3Groups) (hd : d ≤ 68) (hf : 1 ≤ f) (hfc : f + c ≤ 102) :
    Sound (StairHostsSchedule.hostedGroup h divide d f c) := by
  unfold StairHostsSchedule.hostedGroup
  exact sound_rebindMany _ _ (exclusiveRoles_drop_indom d)
    (hs.group divide d f c mem) (sound_placedGroups H divide d f c hd hf hfc)

theorem sound_forwardSegment (P : PrimitiveSlots p) (B B' s f : Nat)
    (hB : B ∈ ([87, 62, 47, 32, 22, 12] : List Nat))
    (hB' : B' ∈ ([87, 62, 47, 32, 22, 12] : List Nat))
    (hs : s ∈ ([425, 450, 465, 480, 490, 500] : List Nat))
    (hf : f ∈ ([450, 465, 480, 490, 500] : List Nat))
    (hsf : (s, f) ∈ v3Segments) (h5 : 5 < f) (h512 : f < 512) :
    Sound (StairSchedule.forwardSegment p B B' s f) := by
  unfold StairSchedule.forwardSegment
  exact sound_append (sound_append (sound_append (sound_append (sound_append
    (P.unpack B hB) (P.tickForward s hs)) (P.middleForward s f hsf))
    (P.orient f hf)) (sound_packAt f h5 h512)) (P.pack B' hB')

theorem sound_reverseSegment (P : PrimitiveSlots p) (B B' s f : Nat)
    (hB : B ∈ ([87, 62, 47, 32, 22, 12] : List Nat))
    (hB' : B' ∈ ([87, 62, 47, 32, 22, 12] : List Nat))
    (hs : s ∈ ([425, 450, 465, 480, 490, 500] : List Nat))
    (hf : f ∈ ([450, 465, 480, 490, 500] : List Nat))
    (hsf : (s, f) ∈ v3Segments) (h5 : 5 < f) (h512 : f < 512) :
    Sound (StairSchedule.reverseSegment p B B' s f) := by
  unfold StairSchedule.reverseSegment
  exact sound_append (sound_append (sound_append (sound_append (sound_append
    (P.unpack B' hB') (sound_unpackAt f h5 h512)) (P.orientR f hf))
    (P.middleReverse s f hsf)) (P.tickReverse s hs)) (P.pack B hB)

theorem sound_forwardLast (P : PrimitiveSlots p) :
    Sound (StairSchedule.forwardLast p) := by
  unfold StairSchedule.forwardLast
  exact sound_append (sound_append (sound_append
    (P.unpack 12 (by decide)) (P.tickForward 500 (by decide)))
    P.middleForwardLast) P.forwardTerminal

theorem sound_reverseLast (P : PrimitiveSlots p) :
    Sound (StairSchedule.reverseLast p) := by
  unfold StairSchedule.reverseLast
  exact sound_append (sound_append (sound_append
    P.reverseTerminal P.middleReverseLast) (P.tickReverse 500 (by decide)))
    (P.pack 12 (by decide))

theorem sound_entryTailPrefix (H : LoanHyp) (P : PrimitiveSlots p) (hs : HostSlots h) :
    Sound (StairHostsSchedule.entryTailPrefix p h) := by
  have g0 := sound_hostedGroup H hs true 0 1 84 (by decide) (by omega) (by omega) (by omega)
  have g14 := sound_hostedGroup H hs true 13 85 5 (by decide) (by omega) (by omega) (by omega)
  have g23 := sound_hostedGroup H hs true 22 90 3 (by decide) (by omega) (by omega) (by omega)
  have g31 := sound_hostedGroup H hs true 30 93 3 (by decide) (by omega) (by omega) (by omega)
  have g37 := sound_hostedGroup H hs true 36 96 2 (by decide) (by omega) (by omega) (by omega)
  have g42 := sound_hostedGroup H hs true 41 98 2 (by decide) (by omega) (by omega) (by omega)
  have s1 := sound_forwardSegment P 87 62 425 450 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s2 := sound_forwardSegment P 62 47 450 465 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s3 := sound_forwardSegment P 47 32 465 480 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s4 := sound_forwardSegment P 32 22 480 490 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s5 := sound_forwardSegment P 22 12 490 500 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have sl := sound_forwardLast P
  unfold StairHostsSchedule.entryTailPrefix
  exact sound_append (sound_append (sound_append (sound_append (sound_append
    (sound_append (sound_append (sound_append (sound_append (sound_append
    (sound_append g0 s1) g14) s2) g23) s3) g31) s4) g37) s5) g42) sl

theorem sound_exitHeadSuffix (H : LoanHyp) (P : PrimitiveSlots p) (hs : HostSlots h) :
    Sound (StairHostsSchedule.exitHeadSuffix p h) := by
  have g0 := sound_hostedGroup H hs false 0 1 84 (by decide) (by omega) (by omega) (by omega)
  have g14 := sound_hostedGroup H hs false 13 85 5 (by decide) (by omega) (by omega) (by omega)
  have g23 := sound_hostedGroup H hs false 22 90 3 (by decide) (by omega) (by omega) (by omega)
  have g31 := sound_hostedGroup H hs false 30 93 3 (by decide) (by omega) (by omega) (by omega)
  have g37 := sound_hostedGroup H hs false 36 96 2 (by decide) (by omega) (by omega) (by omega)
  have g42 := sound_hostedGroup H hs false 41 98 2 (by decide) (by omega) (by omega) (by omega)
  have s5 := sound_reverseSegment P 22 12 490 500 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s4 := sound_reverseSegment P 32 22 480 490 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s3 := sound_reverseSegment P 47 32 465 480 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s2 := sound_reverseSegment P 62 47 450 465 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have s1 := sound_reverseSegment P 87 62 425 450 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by omega) (by omega)
  have rl := sound_reverseLast P
  unfold StairHostsSchedule.exitHeadSuffix
  exact sound_append (sound_append (sound_append (sound_append (sound_append
    (sound_append (sound_append (sound_append (sound_append (sound_append
    (sound_append rl g42) s5) g37) s4) g31) s3) g23) s2) g14) s1) g0

theorem sound_entryFieldHosted (H : LoanHyp) (P : PrimitiveSlots p) (B : BoundarySlots)
    (hs : HostSlots h) :
    Sound (StairHostsSchedule.entryFieldHosted p h) := by
  have first := sound_rebindMany _ _ exclusiveRoles_indom (hs.firstPacket true)
    (sound_firstPacket true)
  have pre : Sound (StairHostsSchedule.entryLowPrefix p h) := by
    unfold StairHostsSchedule.entryLowPrefix
    exact sound_append (sound_append (sound_append first sound_clearProgram)
      (sound_borrow (sound_entryTailPrefix H P hs))) sound_unprefix
  have tail : Sound (StairHostsSchedule.entryTailSuffix h) := by
    have g := sound_hostedGroup H hs true 43 100 2 (by decide) (by omega) (by omega)
      (by omega)
    unfold StairHostsSchedule.entryTailSuffix
    exact sound_append (sound_append (sound_append g
      (sound_sig 511 (by omega) B.divEndpoint)) sound_copyN) B.canon
  have suf : Sound (StairHostsSchedule.entryLowSuffix h) := by
    unfold StairHostsSchedule.entryLowSuffix
    exact sound_append (sound_append sound_clearProgram (sound_borrow tail)) sound_unprefix
  unfold StairHostsSchedule.entryFieldHosted
  exact sound_append (sound_append (sound_append (sound_append (sound_append
    (sound_fieldRename pre) sound_paritySetup) sound_hostedX)
    (sound_fieldRename suf)) sound_hostedX) sound_paritySetup

theorem sound_exitFieldHosted (H : LoanHyp) (P : PrimitiveSlots p) (B : BoundarySlots)
    (hs : HostSlots h) :
    Sound (StairHostsSchedule.exitFieldHosted p h) := by
  have head : Sound (StairHostsSchedule.exitHeadPrefix h) := by
    have g := sound_hostedGroup H hs false 43 100 2 (by decide) (by omega) (by omega)
      (by omega)
    unfold StairHostsSchedule.exitHeadPrefix StairHostsSchedule.hostedEndpoint
      StairSchedule.placedEndPacket
    exact sound_append (sound_append (sound_append B.center sound_copyN)
      (sound_sig 511 (by omega) B.multEndpoint)) g
  have pre : Sound (StairHostsSchedule.exitLowPrefix h) := by
    unfold StairHostsSchedule.exitLowPrefix
    exact sound_append (sound_append sound_clearProgram (sound_borrow head)) sound_unprefix
  have last := sound_rebindMany _ _ exclusiveRoles_indom (hs.firstPacket false)
    (sound_firstPacket false)
  have suf : Sound (StairHostsSchedule.exitLowSuffix p h) := by
    unfold StairHostsSchedule.exitLowSuffix
    exact sound_append (sound_append (sound_append sound_clearProgram
      (sound_borrow (sound_exitHeadSuffix H P hs))) sound_unprefix) last
  unfold StairHostsSchedule.exitFieldHosted
  exact sound_append (sound_append (sound_append (sound_append (sound_append
    sound_paritySetup sound_hostedX) (sound_fieldRename pre)) sound_paritySetup)
    sound_hostedX) (sound_fieldRename suf)

/-- The division local rest (argument of `wireFn2` in `hostedEntryRest`). -/
def entryLocal (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan) :
    Program :=
  renameProgram Rolling1588Lifetime.phaseHost (StairSchedule.stackForward6 p) ++
    StairHostsSchedule.entryFieldHosted p h ++
    renameProgram Rolling1588Lifetime.phaseHost (InverseFive23.lastPhase15 false)

/-- The multiplication local rest (argument of `wireFn2` in `hostedExitRest`). -/
def exitLocal (p : StairSchedule.StairPrimitives) (h : StairHostsSchedule.HostPlan)
    (k : Nat) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost (Rolling1588TickGap.tailPhase false) ++
    StairHostsSchedule.exitFieldHosted p h ++
    renameProgram Rolling1588Lifetime.phaseHost (StairHostsSchedule.lastXN p h k)

theorem entryLocal_sound (H : LoanHyp) (P : PrimitiveSlots p) (B : BoundarySlots) (hs : HostSlots h) :
    Sound (entryLocal p h) := by
  have stack : Sound (StairSchedule.stackForward6 p) := by
    unfold StairSchedule.stackForward6
    exact sound_append sound_forward424 P.firstPack
  unfold entryLocal
  exact sound_append (sound_append (sound_phaseHost stack)
    (sound_entryFieldHosted H P B hs)) (sound_phaseHost sound_lastPhase15)

theorem exitLocal_sound (H : LoanHyp) (P : PrimitiveSlots p) (B : BoundarySlots) (hs : HostSlots h)
    (k : Nat) : Sound (exitLocal p h k) := by
  have stack : Sound (StairSchedule.stackReverse15 p) := by
    unfold StairSchedule.stackReverse15
    exact sound_append P.firstUnpack sound_reverse424
  have last : Sound (StairHostsSchedule.lastXN p h k) := by
    unfold StairHostsSchedule.lastXN
    exact sound_append stack (sound_x1N k)
  unfold exitLocal
  exact sound_append (sound_append (sound_phaseHost sound_tailPhase)
    (sound_exitFieldHosted H P B hs)) (sound_phaseHost last)

end Generic

/-! ## The literal outer caller chain of the v3 `concreteProgram` -/

/-- The three slot facts for the concrete v3 assembly. -/
structure V3Slots : Prop where
  primitives : PrimitiveSlots StairConcreteAssembly.checkpointPrimitives
  boundary : BoundarySlots
  hosts : HostSlots StairConcreteAssembly.hostPlan


theorem hostedGeneric_physical (S : V3Slots)
    (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide)) (cx cy : Fp) :
    GatePhysical (StairConcreteAssembly.hostedGeneric Baselines.layout cx cy) := by
  have g := FlagTop2.genericN_physical cx cy
  have hE : GatePhysical (StairConcreteAssembly.hostedEntryRest Baselines.layout) :=
    rest_physical _ (entryLocal_sound H S.primitives S.boundary S.hosts)
  have hX : GatePhysical
      (StairConcreteAssembly.hostedExitRest Baselines.layout cx.val) :=
    rest_physical _ (exitLocal_sound H S.primitives S.boundary S.hosts cx.val)
  have hQ : GatePhysical (StairSquareFinal.squareEntryHL StairSqLoopA.holes Baselines.layout
      (ReflectionE1.correction cx)) := by
    rw [StairSquareFinal.squareEntryHL_layout]
    exact StairSquareFinal.square_physical _ _
  simp only [FlagExit.genericN, FlagExit.secondStageN, gatePhysical_append] at g
  simp only [StairConcreteAssembly.hostedGeneric,
    StairConcreteAssembly.hostedSecondStage, gatePhysical_append]
  exact ⟨⟨⟨g.1.1.1, g.1.1.2⟩, hE⟩, ⟨⟨hQ, hX⟩, g.2.2⟩⟩

theorem hostedMiddle_physical (hmid : StairMiddleShape.RecordMiddleEncoding)
    (S : V3Slots)
    (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (C : Point) (cx cy : Fp) :
    GatePhysical (StairConcreteAssembly.hostedMiddle C cx cy) := by
  have m := AboveFieldPointDevelop.middle_physical C cx cy
  have hg : GatePhysical (StairConcreteAssembly.hostedBorrowGeneric cx cy) :=
    gatePhysical_rename _ (Equiv.swap _ _).injective _
      (gatePhysical_rename _ FlagTop.rho_injective _
        (hostedGeneric_physical S H cx cy))
  simp only [AboveFieldPointDevelop.middle, gatePhysical_append] at m
  rw [hmid C cx cy]
  simp only [gatePhysical_append]
  exact ⟨⟨⟨⟨m.1.1.1.1, m.1.1.1.2⟩, hg⟩, m.1.2⟩, m.2⟩

/-- Exact `StairOpen.physical_composition` type for the v3
`StairConcreteAssembly.concreteAssembly`, from the structural middle shape and
the three slot facts (which may use the field-9 antecedent). -/
theorem physical_composition_of_slots
    (hmid : StairMiddleShape.RecordMiddleEncoding)
    (slots : StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) → V3Slots) :
    StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) →
      ∀ C, GatePhysical (StairConcreteAssembly.concreteAssembly.program C) := by
  intro H C
  have S := slots H
  rw [StairConcreteAssembly.concreteAssembly_program]
  cases C with
  | zero => simp [StairConcreteAssembly.concreteProgram, GatePhysical]
  | @some cx cy hc =>
    simp only [StairConcreteAssembly.concreteProgram]
    unfold StairConcreteAssembly.hostedWrapper
    apply gatePhysical_rename _ (Wrapper5.U Baselines.layout).injective
    simp only [StairConcreteAssembly.hostedFinite, gatePhysical_append]
    exact ⟨⟨FlagTop.stageNew_physical hc, hostedMiddle_physical hmid S H _ cx cy⟩,
      ControlPointEncodingDevelop.borrowOut_physical hc⟩

