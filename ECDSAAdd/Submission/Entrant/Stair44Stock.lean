/-! ## The literal outer caller chain of the v3 `concreteProgram` -/

/-- The three slot facts for the concrete v3 assembly. -/
structure V3Slots : Prop where
  primitives : PrimitiveSlots StairConcreteAssembly.checkpointPrimitives
  boundary : BoundarySlots
  hosts : HostSlots StairConcreteAssembly.hostPlan


theorem hostedGeneric_physical (S : V3Slots)
    (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide)) (cx cy : Fp) :
    GatePhysical (StairConcreteAssembly.hostedGeneric Baselines.layout cx cy) := by
  have g := FlagTop2.genericN_physical cx cy
  have hE : GatePhysical (StairConcreteAssembly.hostedEntryRest Baselines.layout) :=
    rest_physical _ (entryLocal_sound H S.primitives S.boundary S.hosts)
  have hX : GatePhysical
      (StairConcreteAssembly.hostedExitRest Baselines.layout cx.val) :=
    rest_physical _ (exitLocal_sound H S.primitives S.boundary S.hosts cx.val)
  have hQ : GatePhysical (StairSquareFinal.squareEntryHL StairSqLoopA.holes Baselines.layout
      (ReflectionE1.correction cx)) := by
    rw [StairSquareFinal.squareEntryHL_layout]
    exact StairSquareFinal.square_physical _ _
  simp only [FlagExit.genericN, FlagExit.secondStageN, gatePhysical_append] at g
  simp only [StairConcreteAssembly.hostedGeneric,
    StairConcreteAssembly.hostedSecondStage, gatePhysical_append]
  exact ⟨⟨⟨g.1.1.1, g.1.1.2⟩, hE⟩, ⟨⟨hQ, hX⟩, g.2.2⟩⟩

theorem hostedMiddle_physical (hmid : StairMiddleShape.RecordMiddleEncoding)
    (S : V3Slots)
    (H : StairReplay.Half760LoanHypothesis
      (fun divide d => StairLoan.half760Loan d divide))
    (C : Point) (cx cy : Fp) :
    GatePhysical (StairConcreteAssembly.hostedMiddle C cx cy) := by
  have m := AboveFieldPointDevelop.middle_physical C cx cy
  have hg : GatePhysical (StairConcreteAssembly.hostedBorrowGeneric cx cy) :=
    gatePhysical_rename _ (Equiv.swap _ _).injective _
      (gatePhysical_rename _ FlagTop.rho_injective _
        (hostedGeneric_physical S H cx cy))
  simp only [AboveFieldPointDevelop.middle, gatePhysical_append] at m
  rw [hmid C cx cy]
  simp only [gatePhysical_append]
  exact ⟨⟨⟨⟨m.1.1.1.1, m.1.1.1.2⟩, hg⟩, m.1.2⟩, m.2⟩

/-- Exact `StairOpen.physical_composition` type for the v3
`StairConcreteAssembly.concreteAssembly`, from the structural middle shape and
the three slot facts (which may use the field-9 antecedent). -/
theorem physical_composition_of_slots
    (hmid : StairMiddleShape.RecordMiddleEncoding)
    (slots : StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) → V3Slots) :
    StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) →
      ∀ C, GatePhysical (StairConcreteAssembly.concreteAssembly.program C) := by
  intro H C
  have S := slots H
  rw [StairConcreteAssembly.concreteAssembly_program]
  cases C with
  | zero => simp [StairConcreteAssembly.concreteProgram, GatePhysical]
  | @some cx cy hc =>
    simp only [StairConcreteAssembly.concreteProgram]
    unfold StairConcreteAssembly.hostedWrapper
    apply gatePhysical_rename _ (Wrapper5.U Baselines.layout).injective
    simp only [StairConcreteAssembly.hostedFinite, gatePhysical_append]
    exact ⟨⟨FlagTop.stageNew_physical hc, hostedMiddle_physical hmid S H _ cx cy⟩,
      ControlPointEncodingDevelop.borrowOut_physical hc⟩

