theorem record_branches_control :
    L0.control ∉ wires (recBrC C105SignResearch.body) ∧
      L0.control ∉ wires (recBrB B95PaddedResearch.body) ∧
      L0.control ∉ wires (recBrA A109SignResearch.body) := by
  have g := ControlSupportDevelop.genericN_control 0 0
  simp only [FlagExit.genericN, FlagExit.secondStageN, wires_append, Finset.mem_union, not_or] at g
  have sq := g.2.1.1
