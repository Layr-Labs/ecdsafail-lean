    (fun q => Equiv.apply_symm_apply _ q) (fun q => Equiv.symm_apply_apply _ q) _ _ σ
    (fun c a => tripChain_run _ _ h c a)

/-! ## The primitive trips of the first row -/









/-! ## Local (virtual-state) form of the trips

The moved maps send old letters to shadow labels that no moved program touches;
a genuine `Stage` therefore only holds on a *virtual* state that agrees with the
physical one on the programs' wires.  `trip_of_local` transfers a round trip
from such a virtual state. -/


/-- Moved middle trip from a stage on a virtual state that agrees with the
physical one on the two middle programs (and in phase). -/
theorem middle_trip_local (B i n : Nat) (hB : B ∈ budgets)
    (hseg : StairPhysicalPrimitives.segmentOf i = B)
    (hi : 385 ≤ i) (bound : i + n ≤ 512) (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (hcop : x.Coprime p) (hfix : B ≠ 12) (t : State)
    (virtual : ∃ t' : State, t.phase = t'.phase ∧
      (∀ q, q ∈ wires (P.middleForward i n) ∨ q ∈ wires (P.middleReverse i n) →
        t.basis q = t'.basis q) ∧
      Rolling1588.Integer.Stage (StairPhysicalPrimitives.midSegmentMap B) true x p i t'.basis)
    (c a : List Bool) :
    run (P.middleReverse i n) a (run (P.middleForward i n) c t) = t := by
  obtain ⟨t', hph, hag, st⟩ := virtual
  exact trip_of_local _ _ t t' hph hag
    (fun c' a' => middle_trip B i n hB hseg hi bound x hx0 hx hcop t' st hfix c' a') c a

