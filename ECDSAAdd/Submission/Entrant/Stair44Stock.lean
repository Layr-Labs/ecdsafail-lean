/-! # LT40 U5: field-12 piece fact for the new square tail `entryRH` -/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.constructorNameAsVariable false

namespace ECDSAAdd.Entrant.StairSquareEntryR

open ECDSAAdd Arithmetic Secp256k1 ControlledPointLayout MappedCompressed CompressedPointDialog
  CompressedAllocation CompressedFieldSupport DirectSkywalk E1QubitPlacement
  E1ReflectedPlacement StairSquareHolesCore

attribute [local irreducible] ECDSAAdd.run ECDSAAdd.wires

/-! ## Field-12 piece fact -/



/-- A good generic-level site for the 39 holes. -/
def goodSq (q : Wire) : Bool :=
  decide (StairSiteAvoidance.UG q ∈ StairPhysicalLayout.arenaNat) &&
    decide (StairSiteAvoidance.UG q ∉ StairPhysicalLayout.oldHolesNat) &&
    decide (StairSiteAvoidance.UG q ∉ holes39Nat)

/-- LT46 (replay budget): `E1QubitPlacement.sig ∘ rho` as literal exchanges. -/
private def e1B (q : Nat) : Nat :=
  StairPlaceFast.swB 1558 736 (StairPlaceFast.swB 1557 738 (StairPlaceFast.swB 1042 737
    (StairPlaceFast.swB 1813 527 (StairPlaceFast.swB 738 740 (StairPlaceFast.swB 737 739
      (StairPlaceFast.swB 527 741 q))))))

private theorem e1_eq (q : Wire) : E1QubitPlacement.sig (E1QubitPlacement.rho q) = e1B q := by
  unfold E1QubitPlacement.sig E1QubitPlacement.phaseHost E1QubitPlacement.nativeSwap
    E1QubitPlacement.rho e1B
  simp only [Equiv.trans_apply, StairPlaceFast.swap_eq_sw, StairPlaceFast.swB_eq]
  rfl

/-- `pmapR L0` in closed form (`StairPlaceFast.wireFn2_eqB`). -/
private def pmB (q : Nat) : Nat :=
  StairPlaceFast.pwB (StairPlaceFast.swB 785 1813 (e1B q) - 16)

private theorem pmapR_fast (q : Wire) : pmapR L0 q = pmB q := by
  show wireFn2 Baselines.layout (E1QubitPlacement.sig (E1QubitPlacement.rho q)) = _
  rw [StairPlaceFast.wireFn2_eqB, e1_eq]
  rfl

/-- `goodSq` as one Boolean interval test on the closed-form `UG`
(`Nat.ble` / `Nat.beq` only; no pool walk, no list membership). -/
private def goodSqB (y : Nat) : Bool :=
  (fun q => (Nat.ble q 513 || Nat.beq q 4112 || (Nat.ble 4115 q && Nat.blt q 4630) ||
      (Nat.ble 4835 q && Nat.blt q 5144) || (Nat.ble 5399 q && Nat.blt q 5656) ||
      Nat.beq q 9814) &&
    !(Nat.beq q 5515 || Nat.beq q 5655 || Nat.beq q 5400 || Nat.beq q 5401 ||
      (Nat.ble 4840 q && Nat.blt q 4886))) (StairPlaceFast.ugB y)

private theorem goodSq_of_B {y : Wire} (h : goodSqB y = true) : goodSq y = true := by
  have hu : StairSiteAvoidance.UG y = StairPlaceFast.ugB y := StairPlaceFast.ug_eqB y
  unfold goodSq
  rw [hu]
  unfold goodSqB at h
  generalize StairPlaceFast.ugB y = q at h ⊢
  simp only [Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', Bool.eq_false_iff,
    ne_eq, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq, not_or] at h
  obtain ⟨ha, h1, h2, h3, h4, h5⟩ : (q ≤ 513 ∨ q = 4112 ∨ (4115 ≤ q ∧ q < 4630) ∨
      (4835 ≤ q ∧ q < 5144) ∨ (5399 ≤ q ∧ q < 5656) ∨ q = 9814) ∧
      q ≠ 5515 ∧ q ≠ 5655 ∧ q ≠ 5400 ∧ q ≠ 5401 ∧ ¬(4840 ≤ q ∧ q < 4886) := by omega
  simp only [Bool.and_eq_true, decide_eq_true_eq]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · show q ∈ ([1] ++ List.range' 2 256 ++ List.range' 258 256 ++ [0, 9815, 9814, 4112] ++
