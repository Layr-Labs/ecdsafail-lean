      (SquareFrame LB.core.out base
        (((M^2/2^128)%2^128+2^128*(M^2%2^128)+(SquareReduction.p-1-O0))%SquareReduction.p)) := by
    intro O0 hO0
    have h := directFoldQ_frameTq LB hw hn base (rot128F LB) v2 rfl hc (rot128F_length LB hw) rfl O0 hO0
    rwa [pay2] at h
  have raw := StairSquareBBody.frameG LB hw hn cB LowAccCarryDevelop.control_outside (StairSqLoopB.loopB hl)
    (fun b clean hs O0 E0 O1 he mid => StairSqLoopB.loopB_frame44 hl hsub b clean hs O0 E0 O1 he mid)
    EF (fun b clean O0 E0 hO0 => hEF.1 b clean O0 E0 hO0)
    LocalRebuild.improved
    (fun b outB clean O0 E0 B0 hb old => LocalRebuildLift.transfer b outB clean O0 E0 B0 hb old)
    base M hM hP hc hsum O hO hg hSource dF1 dF2 f1 f2
  show Triple _ (StairSquareBBody.bodyG LB dF1 dF2 (StairSqLoopB.loopB hl) EF LocalRebuild.improved ++
    ReorderedRecordPadding.program 4 LB.core.cin) _
  apply raw.seq
  intro t r ht
  have hz : t.basis LB.core.cin=false :=
    (ht.2 LB.core.cin (LB.pairAuxAway hn _ (by simp)).2).trans hc.cin
