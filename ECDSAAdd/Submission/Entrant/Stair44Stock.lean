/-!
# Slot facts and walk arithmetic, generic in the primitive provider

`WalkFacts p c` lists the slot facts a `StairSchedule.StairPrimitives`
provider must satisfy for the ledger `c`; the walk theorems themselves are in
`StairSlotsWalk`.  Every numeric index relation is passed as an explicit
hypothesis (no definitional arithmetic in statements), and `gateSlots` is
locally irreducible.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSlotsPlan

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed DirectSkywalk Secp256k1 BalancedField Baselines

attribute [local irreducible] gateSlots

/-- Slot facts of a primitive provider: ticks, middle segments and terminal
blocks have the record walk's slot counts (plus the terminal deltas); codec
pairs and orientations cost what the ledger says. -/
structure WalkFacts (q : StairSchedule.StairPrimitives) (c : Costs) : Prop where
  tickForward : ∀ i, i ∈ v3Plan.rows.map Prod.fst →
    gateSlots (q.tickForward i) = gateSlots (TickRanges.tick base i)
  tickReverse : ∀ i, i ∈ v3Plan.rows.map Prod.fst →
    gateSlots (q.tickReverse i) =
      gateSlots (W.ReverseCarry.compactReceiverTick base i)
  middleForward : ∀ i n, (i, n) ∈ [(426, 24), (451, 14), (466, 14), (481, 9),
      (491, 9), (501, 4)] →
    gateSlots (q.middleForward i n) = gateSlots (Rolling1588TickGap.forward true i n)
  middleReverse : ∀ i n, (i, n) ∈ [(426, 24), (451, 14), (466, 14), (481, 9),
      (491, 9), (501, 5)] →
    gateSlots (q.middleReverse i n) = gateSlots (Rolling1588.reverse true i n)
  codec : ∀ B, B ∈ v3Plan.rows.map Prod.snd →
    gateSlots (q.pack B) + gateSlots (q.unpack B) = c.codecPair B
  orient : ∀ i B, (i, B) ∈ v3Plan.rows → gateSlots (q.orient i) = c.orient B
  orientR : ∀ i B, (i, B) ∈ v3Plan.rows → gateSlots (q.orientR i) = c.orient B
  firstPack : gateSlots q.firstPack =
    gateSlots (q.orient 425) +
      gateSlots (Rolling1588.Integer.packFirst base true 425) +
      gateSlots (q.pack 87) + c.firstMove
  firstUnpack : gateSlots q.firstUnpack =
    gateSlots (q.unpack 87) + gateSlots (Rolling1588.unpackAtTick true 425) +
      gateSlots (q.orient 425) + c.firstReturn
  /-- v3.1: the terminal clear runs inside the terminal blocks. -/
  forwardTerminal : gateSlots q.forwardTerminal =
    gateSlots Six505.merged6 + gateSlots (Six505.packP true) +
      gateSlots (ForwardSixPlacement.after true) +
      gateSlots (skywalkArithmeticClear base) + c.forwardTerminal
  reverseTerminal : gateSlots q.reverseTerminal =
    gateSlots (skywalkArithmeticClear base) +
      gateSlots ECDSAAdd.Entrant.tickR + gateSlots (Rolling1588.unpackAtTick true 510) +
      gateSlots InverseFive23.candidate15 + c.reverseTerminal

/-! ## Record-walk arithmetic -/







/-! ## Segment shapes -/

theorem forwardSegment_slots (q : StairSchedule.StairPrimitives) (B B' s f t k : Nat)
    (ht : s + 1 = t) (hk : f - s - 1 = k) :
    gateSlots (StairSchedule.forwardSegment q B B' s f) =
      gateSlots (q.unpack B) + gateSlots (q.tickForward s) +
        gateSlots (q.middleForward t k) + gateSlots (q.orient f) +
        gateSlots (Rolling1588.Integer.packFirst base true f) + gateSlots (q.pack B') := by
  rw [StairSchedule.forwardSegment, ht, hk]
  simp only [gateSlots_append, rename_gateSlots]

theorem reverseSegment_slots (q : StairSchedule.StairPrimitives) (B B' s f t k : Nat)
    (ht : s + 1 = t) (hk : f - s - 1 = k) :
    gateSlots (StairSchedule.reverseSegment q B B' s f) =
      gateSlots (q.unpack B') + gateSlots (Rolling1588.unpackAtTick true f) +
        gateSlots (q.orientR f) + gateSlots (q.middleReverse t k) +
        gateSlots (q.tickReverse s) + gateSlots (q.pack B) := by
  rw [StairSchedule.reverseSegment, ht, hk]
  simp only [gateSlots_append, rename_gateSlots]


end ECDSAAdd.Entrant.StairSlotsPlan

