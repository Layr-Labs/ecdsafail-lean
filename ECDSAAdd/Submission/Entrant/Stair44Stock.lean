    (⟨rfl, rfl, rfl, rfl⟩ : Counts [.x (aBot+1), .make (bBot+1) (aBot+1) 1556] 0 1 0 2)).app p5).app p6).app
    (⟨rfl, rfl, rfl, rfl⟩ : Counts [.pop (bBot+1) (aBot+1) 1556, .x (aBot+1)] 0 0 1 2)).app p7).app p8).app p9).congr
