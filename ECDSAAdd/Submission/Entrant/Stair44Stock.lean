/-- **The terminal forward step** for a pinned transcript: `FT` maps the selected
state to the record state with the letter `s 510` on the host and `base 511` set. -/
theorem ftSpecX (x : Nat) (origin : BasisState) (hx : TraceOK x origin) (s t : State)
    (ha : AgreeOutside (Δv 12) s t)
    (hv : ∀ r ∈ futurePayload 12, t.basis (fieldPlace r) = recVal origin r ∧
      s.basis (fieldPlace r) = cmpBits 12 x r)
    (hcl : CleanT t.basis) :
    ∀ fresh, run (liftF (StairSchedule.forwardLast StairExitLT24.P)) fresh s =
      StairField2V3Win.sxState (origin (base 1538)) t := by
  intro fresh
  obtain ⟨p511, phost, c2409, c1797, f2409, f1797⟩ := place_facts
  have pre1 : ∀ r ∈ futurePayload 12, (pullIn s).basis r = cmpBits 12 x r :=
    fun r hr => (hv r hr).2
  have preC : ∀ r ∈ CT, r ∉ futurePayload 12 → (pullIn s).basis r = false := by
    intro r hr hf
    show s.basis (fieldPlace r) = false
    rw [ha.2 _ (notΔ r hf)]
    exact hcl r hr hf
  rw [liftF_run]
  obtain ⟨tph, tfp, t2409, t1797, tcl, tfr⟩ := lastTail x origin hx (pullIn s) pre1 preC fresh
  generalize run (StairSchedule.forwardLast StairExitLT24.P) fresh (pullIn s) = u'
    at tph tfp t2409 t1797 tcl tfr ⊢
  have pull : ∀ r, (pullOut u').basis (fieldPlace r) = u'.basis r := by
    intro r
    show u'.basis (fieldPlaceInv (fieldPlace r)) = u'.basis r
    rw [inv_fieldPlace]
  have same : ∀ Q, Q ≠ FrontierEntry1591Field.host → Q ≠ base 511 →
      (pullOut u').basis Q = t.basis Q := by
    intro Q h1 h2
    rw [← fieldPlace_inv Q, pull]
    set r := fieldPlaceInv Q
    have hQ : fieldPlace r = Q := fieldPlace_inv Q
    by_cases hf : r ∈ futurePayload 12
    · rw [tfp r hf]
      exact ((hv r hf).1).symm
    · by_cases hC : r ∈ CT
      · have n1 : r ≠ base 2409 := fun h => h2 (by rw [← hQ, h, p511])
        have n2 : r ≠ base 1797 := fun h => h1 (by rw [← hQ, h, phost])
        rw [tcl r hC hf n1 n2]
        exact (hcl r hC hf).symm
      · rw [tfr r hC hf]
        exact ha.2 _ (notΔ r hf)
  have vhost : (pullOut u').basis FrontierEntry1591Field.host = origin (base 1538) := by
    rw [← phost, pull]
    exact t1797
  have v511 : (pullOut u').basis (base 511) = true := by
    rw [← p511, pull]
    exact t2409
  apply State.extensionality
  · show u'.phase = t.phase
    rw [tph]
    exact ha.1
  · funext Q
    show (pullOut u').basis Q = writeBit (writeBit t.basis FrontierEntry1591Field.host
      (origin (base 1538))) (base 511) true Q
    by_cases q1 : Q = base 511
    · subst q1
      simp only [writeBit, Function.update_self]
      exact v511
    · by_cases q2 : Q = FrontierEntry1591Field.host
      · subst q2
        simp only [writeBit, Function.update_of_ne q1, Function.update_self]
        exact vhost
      · simp only [writeBit, Function.update_of_ne q1, Function.update_of_ne q2]
        exact same Q q2 q1

theorem lastSeg_eq : lastSeg StairExitLT24.P =
    liftF (StairSchedule.forwardLast StairExitLT24.P) ++ StairField2V3Win.SXW := by
  simp only [lastSeg, StairField2V3Win.SXW, List.append_assoc]






theorem ftSpec_pinned (x : Nat) : ∀ s t, AgreeOutside (Δv 12) s t →
    StairField2V3ExitPlanR.CvX x 12 s.basis t.basis → lastΦx x t.basis →
    ∀ fresh, run (liftF (StairSchedule.forwardLast StairExitLT24.P)) fresh s =
      StairField2V3Win.sxState (s510 x) t := by
  intro s t ha ⟨origin, hx, hv⟩ h fresh
  rw [← origin_s510 x origin hx]
  exact ftSpecX x origin hx s t ha hv h.1 fresh

theorem lastSpec_pinned (x : Nat) : ∀ s t, AgreeOutside (Δv 12) s t →
    StairField2V3ExitPlanR.CvX x 12 s.basis t.basis → lastΦx x t.basis →
    ∀ fresh, run (lastSeg StairExitLT24.P) fresh s = t := by
  intro s t ha hc h fresh
  obtain ⟨hcl, s1, hw, hpar⟩ := h
  have z := phi_zero x _ ⟨hcl, s1, hw, hpar⟩
  rw [lastSeg_eq, run_append, ftSpec_pinned x s t ha hc ⟨hcl, s1, hw, hpar⟩]
  exact StairField2V3Win.sxw_fwd t s1 hw z.1 z.2 _ hpar _

theorem lastTrip_pinned (x : Nat) : StairField2V3ExitStepsR.LastTrip (lastΦx x) :=
  lastTrip_of_clean (lastΦx x) (fun _ h => h.1)

