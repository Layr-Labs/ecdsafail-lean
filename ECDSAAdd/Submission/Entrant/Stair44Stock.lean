theorem chk_reverse : ∀ q ∈ wires StairTerminalV3.reverseRecord, Chk q := by
  have cl : ∀ q ∈ wires (skywalkArithmeticClear base), Chk q := k4c_chk_all (by decide +kernel)
  have tk : ∀ q ∈ wires (renameProgram (OB5.sig 511) tickR), Chk q :=
