variable (A' B' C' brC brB brA : Program) (hA : BodyAOK A') (hB : BodyBOK B') (hC : BodyCOK C')
  (kC : ∀ (t : State) (m : List Bool), BranchPre t → run brC m t = run (recBrC C') m t)
  (kB : ∀ (t : State) (m : List Bool), BranchPre t → run brB m t = run (recBrB B') m t)
  (kA : ∀ (t : State) (m : List Bool), BranchPre t → run brA m t = run (recBrA A') m t)
include hA hB hC kC kB kA

/-- Drop-in for `A161Generic.squareEntry_base`. -/
theorem squareEntryH_base (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (k X Y : Fp) (G : Bool) (origin : BasisState) (s : State) (m1 m2 : List Bool)
    (v : PointDialogValues L X Y G origin s.basis) :
