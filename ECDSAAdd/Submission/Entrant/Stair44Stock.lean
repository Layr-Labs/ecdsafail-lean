  intro q
  have h:=List.nodup_iff_count.mp hn q
  have ht:=(List.take_sublist j K.carry).count_le q
  simp only [MeasuredCanonicalModLayout.wires,List.count_cons,List.count_append,List.count_nil] at h ⊢
