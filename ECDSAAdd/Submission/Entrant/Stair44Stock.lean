section Merge_StairField2V3ExitRecClose_at_Main

/-!
# LT43d: the multiplication reference state at row 425 (`YF`) in closed form

The reference state `t` after `YF` (all multiplication groups and `lowTail`) is the
state inside the record's hosted exit field just before the closing `X`/parity
wrapper: `YF ++ XS = Rolling1588.exitFieldHosted` (`YF_XS`).  By the record's
`Rolling1588.exit_boundary`, the state after the whole hosted exit field is the
division first phase `run (firstPhase true) mp s` of the same caller state `s`
except on the numerator word (`wireBlock base 2056 256`), which holds
`centerWord (Y * x / 2)`.  The first phase does not touch the numerator, so that
state is the division first phase of the division input `s'` (= `s` with the new
numerator): an `EntryFrame` state with the same `x`.  Since
`prefixW ++ refJ0 = ph (TickGap.firstPhase true) ++ SX` and `SX` is an involution
equal to `XS`,

  `t = run refJ0 c1 (run prefixW c0 s')`   (`close_form`),

i.e. `t` is the `refJ0` image of a `Reach prefixW` state, which is admissible
(`closeRec_true`, for `Extra := fun _ _ => True`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3ExitRecClose

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairField2V3Delta StairField2V3Seg StairField2V3ExitPlanR StairField2V3ExitStepsR
open StairField2V3RecScratch StairField2V3Final
open StairPhysicalLayout StairOuterPlacement

attribute [local irreducible] wires run

/-! ## Shapes -/



/-! ## A register can be given any value -/



/-! ## The closed form -/

/-- **Closed form of the reference state at `YF`**: the `refJ0` image of the
`prefixW` image of a division input state with the same `x`. -/
theorem close_form (k x : Nat) (t : State) (h : ReachE k x YF t) :
    ∃ (s' : State) (f' : StairConcreteAssembly.EntryFrame s') (c0 c1 : List Bool),
      f'.x = x ∧ t = run refJ0 c1 (run prefixW c0 s') := by
  obtain ⟨t00, m, ⟨s, f, rfl, records, rfl⟩, rfl⟩ := h
  have opening : run StairField2V3Replay.exitReferenceOpening records s =
      run (Rolling1588.firstPhase false) records s :=
    first_phase_hosted false f.sharedNodup f.historyAbove f.x f.Y.val f.x_pos f.x_lt s
      records f.input
  rw [opening]
  have hb := Rolling1588.exit_boundary f.sharedNodup f.historyAbove f.selectorsAway
    f.transcript f.x f.Y f.x_pos f.x_lt s records m f.input f.selectorG_zero f.selectorS_zero
  dsimp only at hb
  obtain ⟨v, hv⟩ : ∃ v : State, run (Rolling1588.firstPhase false) records s = v := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : State, run (Rolling1588.firstPhase true) records s = B := ⟨_, rfl⟩
  rw [hv, hB] at hb
  rw [hv]
  obtain ⟨u, hu⟩ : ∃ u : State, run Rolling1588.exitFieldHosted m v = u := ⟨_, rfl⟩
  rw [hu] at hb
  -- the reference state is `SX` of the state after the hosted exit field
  have e1 : u = run StairExitLT24.XS [] (run YF m v) := by
    rw [← hu, ← YF_XS, run_append YF StairExitLT24.XS, run_take,
      StairExitLT24.run_of_noMeasure StairExitLT24.XS StairExitLT24.XS_measurements]
  have e2 : run YF m v = run StairExitLT24.SX [] u := by
    rw [e1, StairExitLT24.XS_eq_SX, StairExitLT24.SX_invol]
  -- the division input
  let s' : State :=
    ⟨s.phase, fun q => if q ∈ wireBlock base 2056 256 then u.basis q else s.basis q⟩
  have same : ∀ q, q ∉ wireBlock base 2056 256 → s'.basis q = s.basis q := by
    intro q hq
    show (if q ∈ wireBlock base 2056 256 then u.basis q else s.basis q) = s.basis q
    rw [if_neg hq]
  have input' := FrontierEntry1591Kernel.paired_input f.x f.Y.val s s' f.input same
  have firstPool : wires (Rolling1588.firstPhase true) ⊆ (skywalkPoolWires base).toFinset := by
    have hs := Rolling1588Lifetime.first_support_eq true
    rw [lf_eq] at hs
    rw [hs]
    exact FrontierEntry1591Kernel.first_pool
  have key : run (Rolling1588.firstPhase true) records s' = u := by
    have agrees := pool_run_agrees (Rolling1588.firstPhase true) _ firstPool records s' s rfl
      (fun q hq => same q
        (FrontierEntry1591Kernel.pool_away_numerator q (List.mem_toFinset.mp hq)))
    rw [hB] at agrees
    apply State.extensionality
    · rw [agrees.1]
      exact hb.1.symm
    · funext q
      by_cases pool : q ∈ skywalkPoolWires base
      · rw [agrees.2 q (List.mem_toFinset.mpr pool)]
        exact (hb.2.2 q (FrontierEntry1591Kernel.pool_away_numerator q pool)).symm
      · have away : q ∉ wires (Rolling1588.firstPhase true) :=
          fun hq => pool (List.mem_toFinset.mp (firstPool hq))
        rw [run_preserves_outside _ _ _ q away]
        show (if q ∈ wireBlock base 2056 256 then u.basis q else s.basis q) = u.basis q
        by_cases hnum : q ∈ wireBlock base 2056 256
        · rw [if_pos hnum]
        · rw [if_neg hnum, hb.2.2 q hnum, ← hB, run_preserves_outside _ _ _ q away]
  have hosted : run (ph (Rolling1588TickGap.firstPhase true)) records s' =
      run (Rolling1588.firstPhase true) records s' :=
    first_phase_hosted true f.sharedNodup f.historyAbove f.x _ f.x_pos f.x_lt s' records input'
  have e3 : run (prefixW ++ refJ0) records s' =
      run StairExitLT24.SX [] (run (ph (Rolling1588TickGap.firstPhase true)) records s') := by
    rw [R0_eq, run_append (ph (Rolling1588TickGap.firstPhase true)) StairExitLT24.SX, run_take,
      StairExitLT24.run_of_noMeasure StairExitLT24.SX StairExitLT24.SX_measurements]
  -- the virtual source of the division frame
  have hval : (f.Y * (f.x : Fp)).val < 2 ^ (wireBlock base 2056 256).length := by
    have hlen : (wireBlock base 2056 256).length = 256 := by
      simp [wireBlock]
    rw [hlen]
    have hlt := ZMod.val_lt (f.Y * (f.x : Fp))
    have hp : ECDSAAdd.p < 2 ^ 256 := by norm_num [ECDSAAdd.p]
    exact lt_trans hlt hp
  obtain ⟨b, hbv, hboff⟩ := exists_reg (wireBlock base 2056 256) numerator_nodup s.basis
    (f.Y * (f.x : Fp)).val hval
  have srcIn := FrontierEntry1591Kernel.paired_input f.x f.Y.val s ⟨s.phase, b⟩ f.input hboff
  rw [hbv] at srcIn
  have n2409 : base 2409 ∉ wireBlock base 2056 256 := by decide +kernel
  have n2410 : base 2410 ∉ wireBlock base 2056 256 := by decide +kernel
  let f' : StairConcreteAssembly.EntryFrame s' :=
    { sharedNodup := f.sharedNodup
      historyAbove := f.historyAbove
      selectorsAway := f.selectorsAway
      transcript := f.transcript
      x := f.x
      Y := f.Y * (f.x : Fp)
      x_pos := f.x_pos
      x_lt := f.x_lt
      source := ⟨s.phase, b⟩
      input := srcIn
      selectorG_zero := (hboff _ n2409).trans f.selectorG_zero
      selectorS_zero := (hboff _ n2410).trans f.selectorS_zero
      phase := rfl
      outsideNumerator := fun q hq => (same q hq).trans (hboff q hq).symm
      numerator := by
        have e : regValue (wireBlock base 2056 256) s'.basis =
            regValue (wireBlock base 2056 256) u.basis := by
          apply regValue_congr
          intro q hq
          show (if q ∈ wireBlock base 2056 256 then u.basis q else s.basis q) = u.basis q
          rw [if_pos hq]
        rw [e]
        exact hb.2.1 }
  refine ⟨s', f', records.take (measurementCount prefixW),
    records.drop (measurementCount prefixW), rfl, ?_⟩
  rw [e2, ← key, ← hosted, ← e3]
  exact run_append prefixW refJ0 records s'

/-! ## Admissibility -/



/-- **`closeRec`** for any extra predicate that holds on the `prefixW` images of
division inputs. -/
theorem closeRec_of (Extra : Nat → State → Prop)
    (hE : ∀ (s' : State) (f' : StairConcreteAssembly.EntryFrame s') (c0 : List Bool),
      Extra f'.x (run prefixW c0 s')) :
    ∀ k x t, ReachE k x YF t → ∃ t0 c, Adm Extra x t0 ∧ t = run refJ0 c t0 := by
  intro k x t ht
  obtain ⟨s', f', c0, c1, hx, rfl⟩ := close_form k x t ht
  subst hx
  exact ⟨run prefixW c0 s', c1, adm_frame Extra hE s' f' c0, rfl⟩




end ECDSAAdd.Entrant.StairField2V3ExitRecClose

end
end Merge_StairField2V3ExitRecClose_at_Main

