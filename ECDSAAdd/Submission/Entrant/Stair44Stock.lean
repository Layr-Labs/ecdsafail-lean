open Rolling1588.Integer

attribute [local irreducible] run wires toffoliCount measurementCount Challenge.gateSlots Rolling1588.forward Rolling1588.reverse Rolling1588.Integer.forward

/-! ## Generic helpers -/




/-! ## Forward side -/






/-! ## Reverse side: program shapes and counts -/


/-- Record terminal reverse blocks without the clear. -/
abbrev revHead : Program :=
  renameProgram (sig 511) tickR ++
    renameProgram (sig 510) (Rolling1588.unpackAtTick true 510 ++ InverseFive23.candidate15)

abbrev P1 : Program :=
  renameProgram (sig 510) (Rolling1588.unpackAtTick true 510 ++ InverseFive23.candidate15)

theorem PE1 :
    renameProgram (sig 510) (Rolling1588.unpackAtTick true 510 ++ TerminalFivePlacement.old) =
      Q1 ++ Q2 := by
  rw [Six505.rename_append, TerminalFivePlacement.old_placed]
  simp only [Q1, Q2, Six505.rename_append, List.append_assoc]
  rfl





theorem cP : measurementCount P1 = measurementCount ((Y ++ Z2) ++ Q2) := by
  decide +kernel

/-! ## Reverse side: the `tickMR8` block (copied from the record's
`Rolling1588.Integer.stackReverse510_run`, head part `key`) -/


/-! ## Reverse side: the regular forward split at 505 / 506 / 507 -/

theorem split506 : Rolling1588.Integer.regularForward base true 1 510 =
    Rolling1588.Integer.regularForward base true 1 505 ++
      (TerminalFiveBridge.forward ++ Rolling1588.Integer.packAfter base true 510) := by
  rw [Rolling1588.Integer.regularForward_snoc base true 1 509,show (1:Nat)+509=510 by rfl,
    Rolling1588.Integer.regularForward_snoc base true 1 508,show (1:Nat)+508=509 by rfl,
    Rolling1588.Integer.regularForward_snoc base true 1 507,show (1:Nat)+507=508 by rfl,
    Rolling1588.Integer.regularForward_snoc base true 1 506,show (1:Nat)+506=507 by rfl,
    Rolling1588.Integer.regularForward_snoc base true 1 505,show (1:Nat)+505=506 by rfl,
    InverseFive23.pack506,MorningPlacement.pack507,Rolling1588.Integer.pack508,
    Rolling1588.Integer.pack509,
    MorningFour.explicit507,tick508ExF_explicit,tick509ExF_explicit,tick510ExF_explicit]
  simp only [TerminalFiveBridge.forward,tripF,List.append_assoc,List.append_nil]





/-! ## Reverse side: the head chain -/

theorem mid_chain (x : Nat) (hx0 : 0 < x) (hx : x < p) (s1 : State)
    (first : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis)
    (M : List Bool) (u : State)
    (hu : ∀ q ∈ skywalkPoolWires base,
      u.basis q = (run (Rolling1588.Integer.regularForward base true 1 510) M s1).basis q)
    (mD : List Bool) :
    run (P1 ++ step505) mD (pullState (sig 510) u) =
      run (Rolling1588.Integer.reverse true 505 6) mD (pullState (sig 510) u) := by
  have st6 := stage_after x hx0 hx s1 first 505 (by omega)
    (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 505)))
  have ag6 := agree_split u s1 M _ _ split506 hu
  have st7 := stage_after x hx0 hx s1 first 506 (by omega)
    (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 506)))
  have ag7 := agree_split u s1 M _ _ split507 hu
  have st8 := stage_after x hx0 hx s1 first 507 (by omega)
    (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 507)))
  have ag8 := agree_split u s1 M _ _ split508 hu
  have hb : ∀ r, run P1 r (pullState (sig 510) u) = run (Q1 ++ Q2) r (pullState (sig 510) u) := by
    intro r
    rw [← PE1]
    show run (renameProgram (sig 510) (Rolling1588.unpackAtTick true 510 ++ InverseFive23.candidate15)) r
      (pullState (sig 510) u) = _
    rw [InverseFour15.unpack51015, OB5.run_rename 510 (by omega), OB5.run_rename 510 (by omega),
      InverseFive23.decoded_replace_pool15 true x hx0 hx _ u st6 _ r ag6]
  have hc : ∀ r, run Q1 r (pullState (sig 510) u) = run (Z1 ++ Z2) r (pullState (sig 510) u) := by
    intro r
    rw [← PE2]
    exact InverseFour15.placed_block15 true x hx0 hx _ u st7 _ r ag7
  have hd : ∀ r, run Z1 r (pullState (sig 510) u) = run Y r (pullState (sig 510) u) :=
    key510 x hx0 hx _ u st8 _ ag8
  have hQ : ∀ r, run Q1 r (pullState (sig 510) u) = run (Y ++ Z2) r (pullState (sig 510) u) :=
    fun r => (hc r).trans (run_congr_append Z1 Y Z2 _ hd cZ r)
  have hP : ∀ r, run P1 r (pullState (sig 510) u) =
      run ((Y ++ Z2) ++ Q2) r (pullState (sig 510) u) :=
    fun r => (hb r).trans (run_congr_append Q1 (Y ++ Z2) Q2 _ hQ cQ r)
  rw [run_congr_append P1 _ step505 _ hP cP mD, PE3]

/-! ## Reverse side: assembly -/

theorem rev_terminal (x : Nat) (hx0 : 0 < x) (hx : x < p) (s1 : State)
    (first : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis)
    (M mD : List Bool) :
    run (revHead ++ step505) mD
        (pullState (sig 511) (run (Rolling1588.Integer.regularForward base true 1 511) M s1)) =
      pullState (sig 504) (run (Rolling1588.Integer.regularForward base true 1 504)
        (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 504))) s1) := by
  obtain ⟨hp0,hpo,hp,cop⟩ := StackOB5.prime_facts x hx0 hx
  have hgap : p+2^32 ≤ 2^256 := by norm_num [p]
  have aStage := stage_after x hx0 hx s1 first 510 (by omega)
    (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 510)))
  have whole : run (Rolling1588.Integer.regularForward base true 1 510)
      (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 510))) s1 =
        run (Rolling1588.Integer.regularForward base true 1 510) M s1 := run_take _ M s1
  have last : run (Rolling1588.Integer.regularForward base true 1 511) M s1 =
      run (W.repairedTick base 511)
        (M.drop (measurementCount (Rolling1588.Integer.regularForward base true 1 510)))
        (run (Rolling1588.Integer.regularForward base true 1 510)
          (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 510))) s1) := by
    rw [Rolling1588.Integer.regularForward_snoc base true 1 510,show (1:Nat)+510=511 by rfl,
      Rolling1588.Integer.regular_pack511,List.append_nil,run_append]
  -- split for the final roundtrip
  have hsplit : Rolling1588.Integer.regularForward base true 1 511 =
      Rolling1588.Integer.regularForward base true 1 504 ++
        Rolling1588.Integer.regularForward base true 505 7 :=
    regularForward_add base true 504 7 1
  have st5 := stage_after x hx0 hx s1 first 504 (by omega)
    (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 504)))
  generalize hT : run (Rolling1588.Integer.regularForward base true 1 511) M s1 = t5 at last ⊢
  generalize ha : run (Rolling1588.Integer.regularForward base true 1 510)
    (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 510))) s1 = a
    at aStage whole last
  obtain ⟨G,bits⟩ := Rolling1588.Integer.stage511_bits true x hx0 hx a aStage
  rw [repaired511_forced G a bits] at last
  have post : ∀q∈tickSites,t5.basis q=postBits G q := by
    intro q hq
    rw [last]
    exact tickF_post G a bits q hq
  have uAgree : ∀q∈skywalkPoolWires base,(run tickR [] t5).basis q=a.basis q := by
    intro q hq
    by_cases ht : q∈tickSites
    · rw [site_run tickR tickSites tickR_wires t5 ⟨false,postBits G⟩ post [] q ht,tickR_pre G q ht]
      exact (bits q ht).symm
    · have hr : q∉wires tickR := fun h => ht (List.mem_toFinset.mp (tickR_wires h))
      have hf : q∉wires tickF := fun h => ht (List.mem_toFinset.mp (tickF_wires h))
      rw [run_preserves_outside tickR [] t5 q hr,last,run_preserves_outside tickF [] a q hf]
  have z := Rolling1588.Integer.stage_zero true x 511 (by omega) a.basis aStage
  have move : pullState (sig 511) (run tickR [] t5)=pullState (sig 510) (run tickR [] t5) :=
    (OB5.pull_step 511 (by omega) _
      ((uAgree _ (StackOB5Base.base_pool _ (by omega))).trans z.1)
      (fun big => (uAgree _ (StackOB5Base.base_pool _ (by omega))).trans (z.2 big))).symm
  have hu : ∀ q ∈ skywalkPoolWires base, (run tickR [] t5).basis q =
      (run (Rolling1588.Integer.regularForward base true 1 510) M s1).basis q := by
    intro q hq
    rw [uAgree q hq, ← whole]
  have cn : measurementCount (renameProgram (sig 511) tickR)=0 :=
    (renameProgram_counts (sig 511) tickR).2.trans tickR_counts.2
  have co : measurementCount (renameProgram (sig 511) (W.ReverseCarry.compactReceiverTick base 511))=1 := by
    rw [(renameProgram_counts (sig 511) (W.ReverseCarry.compactReceiverTick base 511)).2,
      receiver511_explicit]
    exact tickExR_counts.2
  -- left side: peel `tickR`
  have lhs : run (revHead ++ step505) mD (pullState (sig 511) t5) =
      run (P1 ++ step505) mD (pullState (sig 510) (run tickR [] t5)) := by
    have e : revHead ++ step505 = renameProgram (sig 511) tickR ++ (P1 ++ step505) := by
      simp only [revHead, P1, List.append_assoc]
    rw [e, run_append, cn]
    simp only [List.take_zero, List.drop_zero]
    rw [OB5.run_rename 511 (by omega), move]
  -- right side: the regular reverse 505 .. 511
  have rhs : run (Rolling1588.Integer.reverse true 505 7) (false :: mD) (pullState (sig 511) t5) =
      run (Rolling1588.Integer.reverse true 505 6) mD (pullState (sig 510) (run tickR [] t5)) := by
    rw [Rolling1588.Integer.reverse_snoc true 505 6, show (505:Nat)+6=511 by rfl,
      Rolling1588.Integer.unpack511, List.nil_append, run_append, co]
    simp only [List.take_succ_cons, List.take_zero, List.drop_succ_cons, List.drop_zero]
    rw [OB5.run_rename 511 (by omega), receiver511_forced G t5 post, move]
  rw [lhs, mid_chain x hx0 hx s1 first M _ hu mD, ← rhs]
  have agreeT : ∀ q ∈ skywalkPoolWires base, t5.basis q =
      (run (Rolling1588.Integer.regularForward base true 505 7)
        (M.drop (measurementCount (Rolling1588.Integer.regularForward base true 1 504)))
        (run (Rolling1588.Integer.regularForward base true 1 504)
          (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 504))) s1)).basis q := by
    intro q hq
    rw [← hT, hsplit, run_append]
  have rg := (Rolling1588.Integer.reverse_gen true x hx0 hx 7 505 (by omega) (by omega) _ _ t5
    (false :: mD) st5 agreeT).1
  refine rg.trans ?_
  have rt := Rolling1588.Integer.regularReverse_roundtrip base true base_pool_nodup StackOB5.historyAbove
    x p hp0 hx0 hpo hp hgap hx cop 7 505 (by omega) _
    (M.drop (measurementCount (Rolling1588.Integer.regularForward base true 1 504))) (false :: mD) st5
  have t5eq : t5 = run (Rolling1588.Integer.regularForward base true 505 7)
      (M.drop (measurementCount (Rolling1588.Integer.regularForward base true 1 504)))
      (run (Rolling1588.Integer.regularForward base true 1 504)
        (M.take (measurementCount (Rolling1588.Integer.regularForward base true 1 504))) s1) := by
    rw [← hT, hsplit, run_append]
  rw [t5eq, rt]

/-! ## The record terminal round trip -/



/-- **Terminal round trip, record coordinates.**  On the record state at tick
505 of any stage-1 trajectory, the record terminal blocks (with the clear),
then the record reverse blocks (with the clear) and the record untick 505,
give back the state, for all tapes. -/
theorem terminal_record_trip (x : Nat) (hx0 : 0 < x) (hx : x < p) (s1 : State)
    (first : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis)
    (m c a : List Bool) :
    run (StairTerminalV3.reverseRecord ++ step505) a
        (run StairTerminalV3.forwardRecord c (run (Rolling1588TickGap.forward true 1 504) m s1)) =
      run (Rolling1588TickGap.forward true 1 504) m s1 := by
  have ef : StairTerminalV3.forwardRecord = fwdBlocks ++ skywalkArithmeticClear base := rfl
  have er : StairTerminalV3.reverseRecord ++ step505 =
      skywalkArithmeticClear base ++ (revHead ++ step505) := by
    simp only [StairTerminalV3.reverseRecord, revHead, List.append_assoc]
