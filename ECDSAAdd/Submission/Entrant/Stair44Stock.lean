/-- New branches (first argument: the hole list; only members in pool 725..750 are renamed). -/
def newBrC (hs : List Wire) (C : Program) : Program := branchC2 (psOf hs) K0 E0 G0 C

theorem recBrC_eq (C : Program) : recBrC C=SumSavedCBranch.branch K0 E0 G0 C := rfl
theorem newBrC_eq (hs : List Wire) (C : Program) : newBrC hs C=branchC2 (psOf hs) K0 E0 G0 C := rfl

/-! ## run equalities (proofs first rewrite to the generic programs, so all unification is syntactic) -/

theorem kC_run_eq (hs : List Wire) (hsub : ∀ q∈hs, q∈holes39) (body : Program) (hb : BodyCOK body)
    (hav : ∀ q∈hs, q∉wires body) (t : State) (m : List Bool) (pre : BranchPre t) :
    run (newBrC hs body) m t=run (recBrC body) m t := by
  have p := B3CarryPort.pool1540_facts L0 hw0 hn0
  have bound := low_sum_bound K0 hwK t pre.sum0
  rw [newBrC_eq,recBrC_eq]
  exact branchC_run_eq K0 hwK E0 G0 controlND extOK0 (psOf hs) (psOf_sub hs)
    (regValue K0.core.low t.basis) (regValue K0.core.sum t.basis) (regValue K0.core.out t.basis) pre.outLt t m
    rfl rfl bound rfl pre.prod0 pre.clean pre.ext0 D0 p.1 p.2.1 pre.d0 body hb.support hb.frame
    (fun ab h => hav _ (psOf_mem hs ab h))



/-! ## avoidance (all of `hs`, kernel holes and tail holes) -/

theorem kC_avoids (hs : List Wire) (hsub : ∀ q∈hs, q∈holes39) (body : Program) (hb : BodyCOK body)
    (hav : ∀ q∈hs, q∉wires body) : ∀ q∈hs, q∉wires (newBrC hs body) := by
  rw [newBrC_eq]
  intro q hq
  rcases holes39_cases q (hsub q hq) with hk|⟨k,k1,k2,k3,rfl⟩
  · exact branchC_avoids K0 hwK E0 G0 controlND extOK0 (psOf hs) (psOf_sub hs) body
      (fun ab h => hav _ (psOf_mem hs ab h)) q (psOf_holes hs q hq hk)
  · exact branchC_tail K0 hwK E0 G0 controlND extOK0 (psOf hs) (psOf_sub hs) k k1 k2 k3 body (hav _ hq)



/-! ## counts, physicality, support -/

theorem kC_counts (hs : List Wire) (body : Program) :
    toffoliCount (newBrC hs body)=toffoliCount (recBrC body) ∧
    measurementCount (newBrC hs body)=measurementCount (recBrC body) ∧
    Challenge.gateSlots (newBrC hs body)=Challenge.gateSlots (recBrC body) := by
  rw [newBrC_eq,recBrC_eq]
  exact branchC_counts K0 E0 G0 (psOf hs) body



theorem kC_physical (hs : List Wire) (body : Program) (h : GatePhysical (recBrC body)) :
    GatePhysical (newBrC hs body) := by
  rw [recBrC_eq] at h
  rw [newBrC_eq]
  exact branchC_physical K0 E0 G0 (psOf hs) body h



theorem kC_support (hs : List Wire) (body : Program) :
    wires (newBrC hs body)⊆wires (recBrC body)∪hostsK.toFinset := by
  rw [newBrC_eq,recBrC_eq]
  have w := branchC_wires K0 hwK E0 G0 controlND extOK0 (psOf hs) (psOf_sub hs) body
  intro q u
  rcases Finset.mem_union.mp (w u) with h|h
  · exact Finset.mem_union_left _ h
  · exact Finset.mem_union_right _ (psOf_hosts hs q h)




