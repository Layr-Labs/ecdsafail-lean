  have select : v.basis 1613 = false := (a.frame _ (layout j h0 (by omega)).separate).trans selP
  have u13 : u.basis 1613 = (((!s.basis (Shadow7.e0P (start j) + 6)) ^^ s.basis 1596) ^^
