private instance instNeZeroNatP : NeZero p := ⟨by norm_num [p]⟩

private theorem sub_val (x y : Fp) : (x - y).val = (x.val + p - y.val) % p := by
  rw [sub_eq_add_neg, ZMod.val_add, ZMod.neg_val', Nat.add_mod_mod]
  rw [← Nat.add_sub_assoc (le_of_lt (ZMod.val_lt y))]

/-! ## Generic (variable-layout) square chain

Everything heavy is proved for a variable `L`, exactly as in the record, and only instantiated at `L0`. -/



theorem fastG_boundary (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) (P : Program)
    (hP : CoreOK L P) (X Y : Fp) (G : Bool) (origin : BasisState) (s : State) (m : List Bool)
    (v : PointDialogValues L X Y G origin s.basis) :
    (run P m s).phase = s.phase ∧
    regValue L.point.x (run P m s).basis =
      p - 1 - (X - (if G then Y * Y else 0) + (if G then (C163Low4Offsets.squareK : Fp) else 0)).val ∧
    ∀ q, q ∉ L.point.x → (run P m s).basis q = s.basis q := by
  have fresh := fastG_correct L hw hn P hP X.val Y.val G X.isLt s m v.generic v.x v.y v.clean
  refine ⟨fresh.1, ?_, fresh.2.2⟩
  have hK : ((C163Low4Offsets.squareK : Nat) : Fp).val = C163Low4Offsets.squareK :=
    ZMod.val_natCast_of_lt (by
      have hp : SquareReduction.p = p := by
        norm_num [SquareReduction.p, SquareReduction.B, SquareReduction.c, p]
      simpa only [hp] using C163Low4Offsets.squareK_lt)
  rw [ZMod.val_add, sub_val]
  cases G
  · simpa using fresh.2.1
  · simpa [ZMod.val_mul, hK] using fresh.2.1

theorem placeG_boundary (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) (P : Program)
    (hP : CoreOK L P) (X Y : Fp) (G : Bool) (origin : BasisState) (s : State) (m : List Bool)
    (v : PointDialogValues L X Y G origin s.basis) :
    (run (SquareCarryLoan719BF.place L P) m s).phase = s.phase ∧
    regValue L.point.x (run (SquareCarryLoan719BF.place L P) m s).basis =
      p - 1 - (X - (if G then Y * Y else 0) + (if G then (C163Low4Offsets.squareK : Fp) else 0)).val ∧
    ∀ q, q ∉ L.point.x → (run (SquareCarryLoan719BF.place L P) m s).basis q = s.basis q := by
  have result := fastG_boundary L hw hn P hP X Y G origin s m v
  obtain ⟨out, heq⟩ : ∃ out : State, run P m s = out := ⟨_, rfl⟩
  rw [heq] at result
  have clean : regValue L.dialogPool out.basis = 0 := by
    rw [regValue_congr _ _ s.basis
      (fun q hq => result.2.2 q (SumSavedB95Square.pool_away_x L hn q hq)), v.clean]
  have eq := ReflectionE1Square.place_run_eq L hw P s m v.clean (by rw [heq]; exact clean)
  rw [eq, heq]
  exact result


theorem squareG_base (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup) (P : Program)
    (hP : CoreOK L P) (T : Fp → Program) (hT : TailOK L T)
    (k X Y : Fp) (G : Bool) (origin : BasisState) (s : State) (m1 m2 : List Bool)
    (v : PointDialogValues L X Y G origin s.basis) :
    run (SquareCarryLoan719BF.place L P ++ T (k - (C163Low4Offsets.delta : Fp))) m1 s =
      run (SquareCarryLoan719BF.program L ++ fastConstAdd L L.point.x k ++ E1QubitPlacement.tickF L)
        m2 s := by
  let n1 := measurementCount (SquareCarryLoan719BF.place L P)
  let n2 := measurementCount (SquareCarryLoan719BF.program L)
  obtain ⟨a, ha⟩ : ∃ a : State, run (SquareCarryLoan719BF.place L P) (m1.take n1) s = a := ⟨_, rfl⟩
  obtain ⟨r, hr⟩ : ∃ r : State, run (SquareCarryLoan719BF.program L) (m2.take n2) s = r := ⟨_, rfl⟩
  have fresh := placeG_boundary L hw hn P hP X Y G origin s (m1.take n1) v
  have prior := SquareCarryLoan719BF.step L hw hn X Y G origin s (m2.take n2) v
  rw [ha] at fresh
  rw [hr] at prior
  let D : Fp := C163Low4Offsets.delta
  let Z := X - (if G then Y * Y else 0) + (if G then (SquareCarryLoan719BF.K : Fp) else 0)
  let Znew := Z + (if G then D else 0)
  let R := p - 1 - Znew.val
  have zform : X - (if G then Y * Y else 0) + (if G then (C163Low4Offsets.squareK : Fp) else 0) = Znew := by
    dsimp only [Znew, Z, D, C163Low4Offsets.squareK, SquareCarryLoan719BF.K]
    rw [Nat.cast_add]
    cases G <;> simp only [Bool.false_eq_true, if_false, if_true, add_zero]; ring
  have ppos : 0 < p := by norm_num [p]
  have rp : R < p := by dsimp only [R]; omega
  have ax : regValue L.point.x a.basis = R := by
    rw [zform] at fresh
    exact fresh.2.1
  have ag : a.basis L.core.generic = G :=
    (fresh.2.2 _ (((E1QubitPlacement.lay L hw hn _).2.2 rfl).1)).trans v.generic
  have ac : regValue L.dialogPool a.basis = 0 := by
    rw [regValue_congr _ _ s.basis
      (fun q hq => fresh.2.2 q (((E1QubitPlacement.lay L hw hn q).2.1 hq).1)), v.clean]
  have rd := fastConstAdd_correct L hw hn L.point.x (Or.inl rfl) D Z.val G Z.isLt r [] prior.2.generic
    prior.2.x prior.2.clean
  let rnew := run (fastConstAdd L L.point.x D) [] r
  have zval : (Z.val + (if G then D.val else 0)) % p = Znew.val := by
    dsimp only [Znew]
    cases G
    · simpa only [Bool.false_eq_true, if_false, add_zero] using (Nat.mod_eq_of_lt Z.isLt)
    · simpa only [if_true] using (ZMod.val_add Z D).symm
  have involution (n : Nat) (bound : n < p) : n = p - 1 - (p - 1 - n) := by omega
  have rx : regValue L.point.x rnew.basis = p - 1 - R :=
    rd.2.1.trans (zval.trans (involution Znew.val Znew.isLt))
  have outside (q : Wire) (hq : q ∉ L.point.x) : rnew.basis q = a.basis q := by
    have oldFrame : r.basis q = s.basis q := by
      by_cases hy : q ∈ L.point.y
      · exact (regValue_eq_iff _ _ _).mp (prior.2.y.trans v.y.symm) q hy
      · have away : q ∉ L.point.x ++ L.point.y := by
          simp only [List.mem_append, not_or]; exact ⟨hq, hy⟩
        exact (prior.2.rest q away).trans (v.rest q away).symm
    exact (rd.2.2 q hq).trans (oldFrame.trans (fresh.2.2 q hq).symm)
  have phaseEq : rnew.phase = a.phase := rd.1.trans (prior.1.trans fresh.1.symm)
  have eq := E1ReflectedPlacement.entryR_eq L hw hn (k - D) a rnew R rp G ax ag ac phaseEq rx outside
    (m1.drop n1) (m2.drop n2)
  have hrun := hT (k - D) a rnew R rp G ax ag ac phaseEq rx outside (m1.drop n1)
  have ct1 := fastConstAdd_counts L hw L.point.x (Or.inl rfl) (k - D)
  have ct2 := fastConstAdd_counts L hw L.point.x (Or.inl rfl) k
  have tail : run (fastConstAdd L L.point.x (k - D) ++ E1QubitPlacement.tickF L) (m2.drop n2) rnew =
      run (fastConstAdd L L.point.x k ++ E1QubitPlacement.tickF L) (m2.drop n2) r := by
    simp only [run_append, ct1.2, ct2.2]
    rw [A161Const.compose L hw hn k D Z.val G Z.isLt r _ _ prior.2.generic prior.2.x prior.2.clean]
  have both := hrun.trans (eq.trans tail)
  simpa only [run_append, n1, n2, ha, hr, List.append_assoc, D] using both


section Core

variable (A' B' C' brC brB brA : Program) (hA : BodyAOK A') (hB : BodyBOK B') (hC : BodyCOK C')
  (kC : ∀ (t : State) (m : List Bool), BranchPre t → run brC m t = run (recBrC C') m t)
  (kB : ∀ (t : State) (m : List Bool), BranchPre t → run brB m t = run (recBrB B') m t)
  (kA : ∀ (t : State) (m : List Bool), BranchPre t → run brA m t = run (recBrA A') m t)
include hA hB hC kC kB kA

theorem coreN_correct (Y O : Nat) (hO : O < SquareReduction.p) (s : State) (records : List Bool)
    (hy : regValue K0.core.y s.basis = Y) (ho : regValue K0.core.out s.basis = O)
    (hp0 : regValue K0.core.product s.basis = 0) (hs0 : s.basis K0.core.sumCarry = false)
    (hc : K0.PairClean s.basis) (hz : regValue E0 s.basis = 0) (hd0 : s.basis D0 = false) :
    (run (coreN brC brB brA) records s).phase = s.phase ∧
    regValue K0.core.out (run (coreN brC brB brA) records s).basis =
      SquareReduction.p - 1 -
        (((O + SquareReduction.p - (if s.basis G0 then Y^2 else 0) % SquareReduction.p) %
            SquareReduction.p +
          (if s.basis G0 then C163Low4Offsets.squareK else 0)) % SquareReduction.p) ∧
    ∀ q, q ∉ K0.core.out → (run (coreN brC brB brA) records s).basis q = s.basis q := by
  have hw := hwK
  have hn := controlND
  have he := hext
  have nd := (List.nodup_cons.mp hn).2
  have disInput := K0.measured_input_out_disjoint nd
  have disProduct := K0.product_out_disjoint nd
  have ctrlAway : G0 ∉ K0.core.out := by
    intro bad
    exact (List.nodup_cons.mp hn).1 (by
      simp [CuccaroStreamedSquareWideLayout.wires, CuccaroStreamedSquareLayout.wires, bad])
  let A := regValue K0.core.low s.basis
  let B := regValue K0.core.high s.basis
  let enabled := s.basis G0
  let PA := (if enabled then A else 0)^2
  let PB := (if enabled then B else 0)^2
  let PC := (if enabled then A+B else 0)^2
  let OC := C163Low4Offsets.resCFlow enabled PC O
  let OB := ControlLoan1589BFFold.resBF PB OC enabled
  let OA := A161Low4Offsets.resAFlow PA OB enabled
  have lowAway (q : Wire) (hq : q ∈ K0.core.low) : q ∉ K0.core.out :=
    List.disjoint_left.mp disInput (List.mem_append_left _ (List.mem_of_mem_take hq))
  have highAway (q : Wire) (hq : q ∈ K0.core.high) : q ∉ K0.core.out :=
    List.disjoint_left.mp disInput
      (List.mem_append_left _ (List.mem_of_mem_drop (List.mem_of_mem_take hq)))
  have sumAway (q : Wire) (hq : q ∈ K0.core.sum) : q ∉ K0.core.out :=
    List.disjoint_left.mp (K0.measured_sum_disjoint nd).2 hq
  have sumB : regValue K0.core.sum s.basis = B := by
    simp [CuccaroStreamedSquareLayout.sum, regValue_append, regValue, hs0, B]
  have ab : A < 2^128 := by
    simpa [A, K0.core.low_length hw.core] using regValue_lt K0.core.low s.basis
  have bb : B < 2^128 := by
    simpa [B, K0.core.high_length hw.core] using regValue_lt K0.core.high s.basis
  have sumBound : A + B < 2^129 := by norm_num at ab bb ⊢; omega
  have low (X : Nat) (t : BasisState) (hf : SquareFrame K0.core.out s.basis X t) :
      regValue K0.core.low t = A := regValue_congr _ _ _ (fun q hq => hf.2 q (lowAway q hq))
  have high (X : Nat) (t : BasisState) (hf : SquareFrame K0.core.out s.basis X t) :
      regValue K0.core.high t = B := regValue_congr _ _ _ (fun q hq => hf.2 q (highAway q hq))
  have sum (X : Nat) (t : BasisState) (hf : SquareFrame K0.core.out s.basis X t) :
      regValue K0.core.sum t = B :=
    (regValue_congr _ _ _ (fun q hq => hf.2 q (sumAway q hq))).trans sumB
  have prod (X : Nat) (t : BasisState) (hf : SquareFrame K0.core.out s.basis X t) :
      regValue K0.core.product t = 0 :=
    (regValue_congr _ _ _ (fun q hq => hf.2 q (List.disjoint_left.mp disProduct hq))).trans hp0
  have extZ (X : Nat) (t : BasisState) (hf : SquareFrame K0.core.out s.basis X t) :
      regValue E0 t = 0 :=
    (regValue_congr _ _ _ (fun q hq => hf.2 q (ECDSAAdd.Entrant.ext_out K0 G0 E0 he q hq))).trans hz
  have dAway : D0 ∉ K0.core.out := fun bad => hdW (List.mem_cons_of_mem G0 (by
    simp [CuccaroStreamedSquareWideLayout.wires, CuccaroStreamedSquareLayout.wires, bad]))
  have sumOff : K0.core.sumCarry ∉ K0.core.out := (ParkCarryDevelop.sumCarry_off_regs K0 nd).1
  have dT (X : Nat) (t : BasisState) (hf : SquareFrame K0.core.out s.basis X t) : t D0 = false :=
    (hf.2 D0 dAway).trans hd0
  have pre (X : Nat) (hX : X < SquareReduction.p) (t : State)
      (hf : SquareFrame K0.core.out s.basis X t.basis) : BranchPre t :=
    ⟨by rw [hf.1]; exact hX, prod _ _ hf, K0.squareFrame_clean nd s.basis t.basis X hf hc,
      (hf.2 _ sumOff).trans hs0, extZ _ _ hf, dT _ _ hf⟩
  have stepC : Triple (SquareFrame K0.core.out s.basis O) brC (SquareFrame K0.core.out s.basis OC) := by
    intro t m hf
    have e := kC t m (pre O hO t hf)
    have h := SumSavedCBranch.branch_correct K0 hw E0 G0 hn A B O hO t m
      (low _ _ hf) (sum _ _ hf) sumBound hf.1 (prod _ _ hf)
      (K0.squareFrame_clean nd s.basis t.basis O hf hc) he (extZ _ _ hf)
      D0 hdW hdE (dT _ _ hf) C' hC.support hC.frame
    simp only [recBrC] at e
    rw [← e, hf.2 G0 ctrlAway] at h
    exact ⟨h.1, h.2.1, fun q hq => (h.2.2 q hq).trans (hf.2 q hq)⟩
  have ocLt : OC < SquareReduction.p := by
    dsimp only [OC, C163Low4Offsets.resCFlow, C163Low4Body.resCFK]; exact ofCast_lt _ _
  have stepB : Triple (SquareFrame K0.core.out s.basis OC) brB (SquareFrame K0.core.out s.basis OB) := by
    intro t m hf
    have e := kB t m (pre OC ocLt t hf)
    have h := recBrB_correct B' hB B OC ocLt t m (high _ _ hf) hf.1 (prod _ _ hf)
      (K0.squareFrame_clean nd s.basis t.basis OC hf hc) ((hf.2 _ sumOff).trans hs0) (extZ _ _ hf)
    rw [← e, hf.2 G0 ctrlAway] at h
    exact ⟨h.1, h.2.1, fun q hq => (h.2.2 q hq).trans (hf.2 q hq)⟩
  have obLt : OB < SquareReduction.p := ofCast_lt _ _
  have stepA : Triple (SquareFrame K0.core.out s.basis OB) brA (SquareFrame K0.core.out s.basis OA) := by
    intro t m hf
    have e := kA t m (pre OB obLt t hf)
    have h := A161Low4Branch.swapped_correct K0 hw E0 G0 hn A OB obLt t m (low _ _ hf) hf.1
      (prod _ _ hf) (K0.squareFrame_clean nd s.basis t.basis OB hf hc)
      ((hf.2 _ sumOff).trans hs0) he (extZ _ _ hf) D0 hdW hdE (dT _ _ hf)
      A' hA.support hA.eUfree hA.frame
    simp only [recBrA] at e
    rw [← e, hf.2 G0 ctrlAway] at h
    exact ⟨h.1, h.2.1, fun q hq => (h.2.2 q hq).trans (hf.2 q hq)⟩
  have all := (stepC.seq stepB).seq stepA
  obtain ⟨phase, value, frame⟩ := all s records ⟨ho, fun _ _ => rfl⟩
  have split : A + 2^128 * B = Y := by
    have highEq : K0.core.high = K0.core.y.drop 128 := by
      simp [CuccaroStreamedSquareLayout.high, hw.core.y]
    have value := regValue_append (K0.core.y.take 128) (K0.core.y.drop 128) s.basis
    rw [List.take_append_drop, hy, List.length_take, hw.core.y] at value
    simpa only [A, B, CuccaroStreamedSquareLayout.low, highEq, show min 128 256 = 128 by decide] using
      value.symm
  have exactResult := C163Low4Offsets.complete_exact enabled A B O
  rw [split] at exactResult
  unfold subModValue at exactResult
  have oaLt : OA < SquareReduction.p := ofCast_lt _ _
  have reflected : OA = SquareReduction.p - 1 -
      (((O + SquareReduction.p - (if s.basis G0 then Y^2 else 0) % SquareReduction.p) %
          SquareReduction.p +
        (if s.basis G0 then C163Low4Offsets.squareK else 0)) % SquareReduction.p) := by
    change SquareReduction.p - 1 - OA =
      (((O + SquareReduction.p - (if s.basis G0 then Y^2 else 0) % SquareReduction.p) %
          SquareReduction.p +
        (if s.basis G0 then C163Low4Offsets.squareK else 0)) % SquareReduction.p) at exactResult
    omega
  exact ⟨phase, value.trans reflected, frame⟩

/-- The new core satisfies the core-level hypothesis of `fastG_correct` at `L0`. -/
theorem coreN_coreOK : CoreOK L0 (coreN brC brB brA) :=
  fun Y O hO s records hy ho hp0 hs0 hc hz hd0 =>
    coreN_correct A' B' C' brC brB brA hA hB hC kC kB kA Y O hO s records hy ho hp0 hs0 hc hz hd0

theorem squareN_base (k X Y : Fp) (G : Bool) (origin : BasisState) (s : State) (m1 m2 : List Bool)
    (v : PointDialogValues L0 X Y G origin s.basis) :
    run (squareN brC brB brA k) m1 s =
      run (SquareCarryLoan719BF.program L0 ++ fastConstAdd L0 L0.point.x k ++ E1QubitPlacement.tickF L0)
        m2 s :=
  squareG_base L0 hw0 hn0 (coreN brC brB brA)
    (coreN_coreOK A' B' C' brC brB brA hA hB hC kC kB kA)
    StairSquareEntryR.entryRH entryRH_tailOK k X Y G origin s m1 m2 v


end Core

/-! ## Counts and physicality -/

theorem recordSquare_eq (k : Fp) :
    A161Generic.squareEntry L0 k =
      SumSavedB95Square.program L0 A109SignResearch.body C105SignResearch.body ++
        E1ReflectedPlacement.entryR L0 (k - (C163Low4Offsets.delta : Fp)) := by
  unfold A161Generic.squareEntry KnownSelect.squareEntry
  exact if_pos rfl

/-- Swapping the body of a record wrapper changes its counts by the body's counts. -/
theorem recBrC_counts (X Y : Program) :
    toffoliCount (recBrC X) + toffoliCount Y = toffoliCount (recBrC Y) + toffoliCount X ∧
      measurementCount (recBrC X) + measurementCount Y = measurementCount (recBrC Y) + measurementCount X := by
  simp only [recBrC, SumSavedCBranch.branch, SumSavedPark.withLowK2S, ParkCopyS.pB, bodySwap,
    toffoliCount_append, measurementCount_append, (renameProgram_counts _ _).1,
