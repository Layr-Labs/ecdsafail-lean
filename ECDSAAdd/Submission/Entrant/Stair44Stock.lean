      ReorderedRecordPadding.program 4 LB.core.cin := rfl

/-- Same statement as `B95PaddedResearch.frame` (= `B95SelectorResearch.actual_frame`). -/
theorem bodyBG_frame (hl : List Wire) (hsub : hl.Sublist holes) (EF : Program) (hEF : EFoldOK EF)
    (base : BasisState) (M : Nat) (hM : M<2^128)
    (hP : regValue LB.core.product base=M^2) (hc : LB.PairClean base)
    (hsum : base LB.core.sumCarry=false) (O : Nat) (hO : O<SquareReduction.p)
    (hg : base cB=false → M=0) (hSource : M=if base cB then regValue LB.core.high base else 0) :
    Triple (SquareFrame LB.core.out base O) (bodyBG hl EF)
      (SquareFrame LB.core.out base (bO4 (M^2) (base cB) O)) := by
  have hw : LB.Widths := LowAccCarryDevelop.layout_widths
  have hn : LB.wires.Nodup := LowAccCarryDevelop.layout_nodup
  have hb : M^2<2^256 := by simpa using square_bound M 128 hM
  have views := accA_views LB hw base M hM hP
  have v1 : LB.MeasuredFoldView base (negP LB) := views (.inl (negP LB)) (by simp [accAMix])
  have v2 : LB.MeasuredFoldView base (rot128F LB) := views (.inl (rot128F LB)) (by simp [accAMix])
  have pay1 : measuredFoldPayload base (negP LB)=M^2 := by
    simp only [measuredFoldPayload,negP,pow_zero,Nat.mul_one]
    rw [LB.product_take_value hw base (M^2) hP 256 (by omega),Nat.mod_eq_of_lt hb]
  have pay2 : measuredFoldPayload base (rot128F LB)=(M^2/2^128)%2^128+2^128*(M^2%2^128) := by
    simp only [measuredFoldPayload,rot128F,pow_zero,Nat.mul_one]
    exact LB.rotated128_value hw base (M^2) hP
  have f1 : ∀ O0, O0<SquareReduction.p → Triple (SquareFrame LB.core.out base O0) dF1
      (SquareFrame LB.core.out base ((M^2+(SquareReduction.p-1-O0))%SquareReduction.p)) := by
    intro O0 hO0
    have h := directFoldQ_frameTq LB hw hn base (negP LB) v1 rfl hc (negP_length LB hw) rfl O0 hO0
    rwa [pay1] at h
  have f2 : ∀ O0, O0<SquareReduction.p → Triple (SquareFrame LB.core.out base O0) dF2
      (SquareFrame LB.core.out base
        (((M^2/2^128)%2^128+2^128*(M^2%2^128)+(SquareReduction.p-1-O0))%SquareReduction.p)) := by
    intro O0 hO0
    have h := directFoldQ_frameTq LB hw hn base (rot128F LB) v2 rfl hc (rot128F_length LB hw) rfl O0 hO0
    rwa [pay2] at h
  have raw := StairSquareBBody.frameG LB hw hn cB LowAccCarryDevelop.control_outside (StairSqLoopB.loopB hl)
    (fun b clean hs O0 E0 O1 he mid => StairSqLoopB.loopB_frame hl hsub b clean hs O0 E0 O1 he mid)
    EF (fun b clean O0 E0 hO0 => hEF.1 b clean O0 E0 hO0)
    LocalRebuild.improved
    (fun b outB clean O0 E0 B0 hb old => LocalRebuildLift.transfer b outB clean O0 E0 B0 hb old)
    base M hM hP hc hsum O hO hg hSource dF1 dF2 f1 f2
  show Triple _ (StairSquareBBody.bodyG LB dF1 dF2 (StairSqLoopB.loopB hl) EF LocalRebuild.improved ++
    ReorderedRecordPadding.program 4 LB.core.cin) _
  apply raw.seq
  intro t r ht
  have hz : t.basis LB.core.cin=false :=
    (ht.2 LB.core.cin (LB.pairAuxAway hn _ (by simp)).2).trans hc.cin
  rw [ReorderedRecordPadding.run_zero 4 LB.core.cin t r hz]
  exact ⟨rfl,ht⟩


theorem bodyBG_frame44 (hl : List Wire) (hsub : hl.Sublist StairSqLoopA.hostDomain) (EF : Program) (hEF : EFoldOK EF)
    (base : BasisState) (M : Nat) (hM : M<2^128)
    (hP : regValue LB.core.product base=M^2) (hc : LB.PairClean base)
    (hsum : base LB.core.sumCarry=false) (O : Nat) (hO : O<SquareReduction.p)
    (hg : base cB=false → M=0) (hSource : M=if base cB then regValue LB.core.high base else 0) :
    Triple (SquareFrame LB.core.out base O) (bodyBG hl EF)
      (SquareFrame LB.core.out base (bO4 (M^2) (base cB) O)) := by
