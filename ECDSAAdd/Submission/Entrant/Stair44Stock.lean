/-- Independent-tape replay is stable under a common prefix and suffix. -/
theorem append_replayD (P Q Q₀ S : Program) (pre : State → Prop)
    (middle : ∀ s, pre s → ∀ fresh,
      ∃ old, run Q fresh s = run Q₀ old s) :
    ∀ s fresh, (∀ prefixTape, pre (run P prefixTape s)) → ∃ old,
      run (P ++ (Q ++ S)) fresh s = run (P ++ (Q₀ ++ S)) old s := by
  intro s fresh reachable
  let prefixTape := fresh.take (measurementCount P)
  let restTape := fresh.drop (measurementCount P)
  let middleTape := restTape.take (measurementCount Q)
  let suffixTape := restTape.drop (measurementCount Q)
  obtain ⟨oldMiddle, middleEq⟩ :=
    middle (run P prefixTape s) (reachable prefixTape) middleTape
  let oldTape :=
    FlagEntry.pfx (measurementCount P) prefixTape ++
      (FlagEntry.pfx (measurementCount Q₀) oldMiddle ++ suffixTape)
  refine ⟨oldTape, ?_⟩
  have freshSplit :
      run (P ++ (Q ++ S)) fresh s =
        run S suffixTape (run Q middleTape (run P prefixTape s)) := by
    simp only [run_append]
    rfl
  have oldSplit :
      run (P ++ (Q₀ ++ S)) oldTape s =
        run S suffixTape (run Q₀ oldMiddle (run P prefixTape s)) := by
    simpa only [oldTape] using
      (ControlTapeDevelop.run_three_tapes P Q₀ S prefixTape oldMiddle
        suffixTape s)
  calc
    run (P ++ (Q ++ S)) fresh s =
        run S suffixTape (run Q middleTape (run P prefixTape s)) := freshSplit
    _ = run S suffixTape (run Q₀ oldMiddle (run P prefixTape s)) := by
      rw [middleEq]
    _ = run (P ++ (Q₀ ++ S)) oldTape s := oldSplit.symm


