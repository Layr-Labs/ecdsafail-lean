/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSchedule_at_Main` -/
section Merge_StairSchedule_at_Main

/-!
**CANON v3 (LT6, 2026-11-17, coordinator decision 15:40): the k = 44 re-plan.**
Six checkpoints (letters 425/450/465/480/490/500, budgets 87/62/47/32/22/12),
group deficits 0/14/23/31/37/42 and terminal 44.  The junction pieces that
depend on the physical placement (the phase-context first row and the two
terminal blocks) are fields of `StairPrimitives`, supplied by the concrete
instance in `StairConcreteAssembly`.

(Previous header:) The eight-checkpoint field schedule from PK2, isolated from the codec, moved-walk,
and loan implementations.  Programs supplied by `StairPrimitives` are already
placed in the coordinates at the `Rolling1588.entryTail` / `exitHead` boundary.
Programs supplied by `StairLoans` are still in the ordinary packet coordinates;
`placedGroups` and `placedEndPacket` apply the existing `OB5.sig 511` wrapper.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSchedule

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed DirectSkywalk

/-- Codec and moved-walk programs furnished by LT1 and LT2.  Every field is in
the coordinates of `Rolling1588.entryTail`; in particular no `Prefix1590.borrow`,
`HostOB5.hostSwap`, or parity-host transport has yet been applied. -/
structure StairPrimitives where
  pack : Nat → Program
  unpack : Nat → Program
  orient : Nat → Program
  /-- Orientation used by the reverse (multiplication) segments.  Default: `orient`. -/
  orientR : Nat → Program := orient
  tickForward : Nat → Program
  tickReverse : Nat → Program
  /-- Placed ordinary ticks together with their due packet writes. -/
  middleForward : Nat → Nat → Program
  /-- Placed mirror ticks together with their due packet reads. -/
  middleReverse : Nat → Nat → Program
  /-- First-row checkpoint after the record ticks `1 .. 424` (division
  forward pass, phase context).  Default: the unrelabelled pieces. -/
  firstPack : Program :=
    orient 425 ++
      renameProgram (OB5.sig 425) (Rolling1588.Integer.packFirst base true 425) ++
      pack 87
  /-- Mirror of `firstPack` before the record unticks `424 .. 1`. -/
  firstUnpack : Program :=
    unpack 87 ++
      renameProgram (OB5.sig 425) (Rolling1588.unpackAtTick true 425) ++
      orient 425
  /-- Terminal division blocks after the moved ticks `500 .. 504`
  (junction D/E of LT14's audit; default: the record blocks). -/
  forwardTerminal : Program :=
    Six505.merged6 ++ Six505.packP true ++ ForwardSixPlacement.after true
  /-- Terminal multiplication blocks before the moved unticks `504 .. 500`
  (default: the record blocks). -/
  reverseTerminal : Program :=
    renameProgram (OB5.sig 511) tickR ++
      renameProgram (OB5.sig 510)
        (Rolling1588.unpackAtTick true 510 ++ InverseFive23.candidate15)










/-- A nonterminal division segment.  The history packet due at `finish` is
written before the next compact checkpoint is packed. -/
def forwardSegment (p : StairPrimitives) (budget nextBudget start finish : Nat) : Program :=
  p.unpack budget ++
    p.tickForward start ++
    p.middleForward (start + 1) (finish - start - 1) ++
    p.orient finish ++
    renameProgram (OB5.sig finish) (Rolling1588.Integer.packFirst base true finish) ++
    p.pack nextBudget

/-- The mirror of `forwardSegment`.  The packet at `finish` is opened before
the walk is reversed, while the compact state at `start` is packed last. -/
def reverseSegment (p : StairPrimitives) (budget nextBudget start finish : Nat) : Program :=
  p.unpack nextBudget ++
    renameProgram (OB5.sig finish) (Rolling1588.unpackAtTick true finish) ++
    p.orientR finish ++
    p.middleReverse (start + 1) (finish - start - 1) ++
    p.tickReverse start ++
    p.pack budget

/-- Terminal division segment; the terminal blocks are a primitive field. -/
def forwardLast (p : StairPrimitives) : Program :=
  p.unpack 12 ++
    p.tickForward 500 ++
    p.middleForward 501 4 ++
    p.forwardTerminal

/-- Terminal multiplication segment, retaining the selected 22-Toffoli inverse
bridge from the current record. -/
def reverseLast (p : StairPrimitives) : Program :=
  p.reverseTerminal ++
    p.middleReverse 501 5 ++
    p.tickReverse 500 ++ p.pack 12

/-- Prefix of the division field through `SegLast`.  Parity setup and the
hosted-X intentionally do not occur in this prefix. -/
def entryTailPrefix (p : StairPrimitives) (loans : StairLoans) : Program :=
  placedGroups loans true 0 1 84 ++
    forwardSegment p 87 62 425 450 ++
    placedGroups loans true 13 85 5 ++
    forwardSegment p 62 47 450 465 ++
    placedGroups loans true 22 90 3 ++
    forwardSegment p 47 32 465 480 ++
    placedGroups loans true 30 93 3 ++
    forwardSegment p 32 22 480 490 ++
    placedGroups loans true 36 96 2 ++
    forwardSegment p 22 12 490 500 ++
    placedGroups loans true 41 98 2 ++
    forwardLast p




/-- Multiplication suffix beginning with `RSegLast`, followed by the exact
reverse staircase and packets 76 down to 1. -/
def exitHeadSuffix (p : StairPrimitives) (loans : StairLoans) : Program :=
  reverseLast p ++
    placedGroups loans false 41 98 2 ++
    reverseSegment p 22 12 490 500 ++
    placedGroups loans false 36 96 2 ++
    reverseSegment p 32 22 480 490 ++
    placedGroups loans false 30 93 3 ++
    reverseSegment p 47 32 465 480 ++
    placedGroups loans false 22 90 3 ++
    reverseSegment p 62 47 450 465 ++
    placedGroups loans false 13 85 5 ++
    reverseSegment p 87 62 425 450 ++
    placedGroups loans false 0 1 84


/-- The new division integer prefix, replacing `Six505.stackForward6 true`. -/
def stackForward6 (p : StairPrimitives) : Program :=
  Rolling1588TickGap.forward true 1 424 ++ p.firstPack

/-- The new multiplication integer suffix, replacing
`InverseFive23.stackReverse15 true`. -/
def stackReverse15 (p : StairPrimitives) : Program :=
  p.firstUnpack ++ Rolling1588.reverse true 1 424





/-- Low-level division pieces on the two sides of the moved setup/X boundary. -/
def entryLowPrefix (p : StairPrimitives) (loans : StairLoans) : Program :=
  Rolling1588.placedFirstPacket true ++ FourScratchWindow.clearProgram ++
    renameProgram Prefix1590.borrow (entryTailPrefix p loans) ++ FourScratchWindow.unprefix


/-- `ParityField1591.program` and `FrontierEntry1591Field.hosted` flattened so
their leading setup/X can be moved to the checkpoint boundary. -/
def entryFieldHosted (p : StairPrimitives) (loans : StairLoans) : Program :=
  fieldRename (entryLowPrefix p loans) ++
    paritySetup ++ hostedX ++
    fieldRename (entryLowSuffix loans) ++ hostedX ++ paritySetup


def exitLowSuffix (p : StairPrimitives) (loans : StairLoans) : Program :=
  FourScratchWindow.clearProgram ++
    renameProgram Prefix1590.borrow (exitHeadSuffix p loans) ++
    FourScratchWindow.unprefix ++ Rolling1588.placedFirstPacket false

/-- Multiplication retains the leading setup/X, moves the trailing setup and a
fresh X before `RSegLast`, and has no trailing hosted-X. -/
def exitFieldHosted (p : StairPrimitives) (loans : StairLoans) : Program :=
  paritySetup ++ hostedX ++
    fieldRename (exitLowPrefix loans) ++
    paritySetup ++ hostedX ++
    fieldRename (exitLowSuffix p loans)

/-- v3.1: the terminal clear (defect F) now runs inside `p.forwardTerminal`
(after `SegLast`), so the first phase has no clear. -/
def firstPhase (p : StairPrimitives) : Program :=
  FrontierEntry1591Native.forward base ++ stackForward6 p


/-- The selected multiplication caller merges the reverse pass with the parked
exit flag circuit.  This is the replacement point used by the final record. -/
def lastXN (p : StairPrimitives) (k : Nat) : Program :=
  stackReverse15 p ++ ParityXExitInverse23Kernel.x1N k

/-- Logical division kernel with the selected final forward wrapper replaced. -/
def entryKernel (p : StairPrimitives) (loans : StairLoans) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost (firstPhase p) ++
    entryFieldHosted p loans ++
    renameProgram Rolling1588Lifetime.phaseHost (InverseFive23.lastPhase15 false)

/-- Logical multiplication kernel with the selected final reverse wrapper replaced. -/
def exitKernel (p : StairPrimitives) (loans : StairLoans) (k : Nat) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost (Rolling1588TickGap.firstPhase false) ++
    exitFieldHosted p loans ++
    renameProgram Rolling1588Lifetime.phaseHost (lastXN p k)















/-- Semantic interface discharged by the LT1 codec, LT2 segment theorem, and
LT4 loan/frame results.  The tapes are intentionally independent. -/
structure ReplayInterface (p : StairPrimitives) (loans : StairLoans) (k : Nat)
    (entryPre exitPre : State → Prop) : Prop where
  entry : ∀ s, entryPre s → ∀ fresh old,
    run (entryKernel p loans) fresh s = run InverseFiveEntry23.entryKernel15 old s
  exit : ∀ s, exitPre s → ∀ fresh old,
    run (exitKernel p loans k) fresh s =
      run (ParityXExitInverse23Kernel.kernelXN k) old s




end ECDSAAdd.Entrant.StairSchedule

end
end Merge_StairSchedule_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairReplayPlan_at_Main` -/
section Merge_StairReplayPlan_at_Main

/-!
Exact integration boundary for `StairSchedule.ReplayInterface`.

The loan proof and primitive proof are kept separate by using the schedule with
`recordLoans` as the intermediate program.  Both relations quantify over
independent measurement tapes, matching the record replay contract.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairReplayPlan

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open StairSchedule

/-- LT4's aggregate obligation after its local half/group/end-point lemmas are
composed through the exact LT3 schedule. -/
structure LoanReplay (p : StairPrimitives) (loans : StairLoans) (k : Nat)
    (entryPre exitPre : State → Prop) : Prop where
  entry : ∀ s, entryPre s → ∀ fresh old,
    run (entryKernel p loans) fresh s =
      run (entryKernel p recordLoans) old s
  exit : ∀ s, exitPre s → ∀ fresh old,
    run (exitKernel p loans k) fresh s =
      run (exitKernel p recordLoans k) old s

/-- LT1+LT2's aggregate obligation after codec round trips and placed segment
round trips are threaded through the record groups. -/
structure PrimitiveReplay (p : StairPrimitives) (k : Nat)
    (entryPre exitPre : State → Prop) : Prop where
  entry : ∀ s, entryPre s → ∀ fresh old,
    run (entryKernel p recordLoans) fresh s =
      run InverseFiveEntry23.entryKernel15 old s
  exit : ∀ s, exitPre s → ∀ fresh old,
    run (exitKernel p recordLoans k) fresh s =
      run (ParityXExitInverse23Kernel.kernelXN k) old s

/-- The two independently checkable peer interfaces imply LT3's transfer
interface without synchronizing any measurement records. -/
theorem replayInterface_of_parts (p : StairPrimitives) (loans : StairLoans)
    (k : Nat) (entryPre exitPre : State → Prop)
    (loan : LoanReplay p loans k entryPre exitPre)
    (primitive : PrimitiveReplay p k entryPre exitPre) :
    ReplayInterface p loans k entryPre exitPre := by
  constructor
  · intro s hs fresh old
    calc
      run (entryKernel p loans) fresh s =
          run (entryKernel p recordLoans) [] s := loan.entry s hs fresh []
      _ = run InverseFiveEntry23.entryKernel15 old s :=
        primitive.entry s hs [] old
  · intro s hs fresh old
    calc
      run (exitKernel p loans k) fresh s =
          run (exitKernel p recordLoans k) [] s := loan.exit s hs fresh []
      _ = run (ParityXExitInverse23Kernel.kernelXN k) old s :=
        primitive.exit s hs [] old

