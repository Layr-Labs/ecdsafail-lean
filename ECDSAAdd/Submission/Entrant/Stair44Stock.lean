/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanField7_at_Main` -/
section Merge_StairLoanField7_at_Main

/-!
# Field 7 from the record-level loan replay

`StairLoanRecordKernel.shapeEntryKernel_run_eq` and
`StairLoanRecordExitKernel.shapeExitKernel_run_eq` prove, from the compiled
half interface and field 6 only, that the record kernels with their nine
packet-group slices and endpoint taken from `bestLoans` equal the record
kernels (`InverseFiveEntry23.entryKernel15`,
`ParityXExitInverse23Kernel.kernelXN k`) on `EntryPre` / `ExitPre k`.

Field 7 compares the two staircase kernels.  With

* `LoanedCommutation`: the staircase kernel with `bestLoans` equals the
  record-shaped loaned kernel (the loans analogue of field 2's commutation
  core; the record-loan instance is field 2 itself, because
  `entryFieldHostedShape recordLoans = Rolling1588.entryFieldHosted` and
  `exitFieldHostedShape recordLoans = Rolling1588.exitFieldHosted`), and
* field 2's exact statement (`CheckpointReplaySpec concreteAssembly`),

the exact field-7 type follows by transitivity.  No hypothesis mentions
`recordLoans` and `bestLoans` together.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanField7

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

/-- The staircase kernels with `bestLoans` equal the record-shaped kernels
with the same loaned slices/endpoints (independent tapes). -/
structure LoanedCommutation : Prop where
  entry : ∀ t, StairConcreteAssembly.EntryPre t → ∀ fresh old,
    run (StairSchedule.entryKernel StairConcreteAssembly.checkpointPrimitives
        StairConcrete.bestLoans) fresh t =
      run (InverseFiveEntry23.kernel15 true false
        (StairLoanRecordSupport.entryFieldHostedShape StairConcrete.bestLoans))
        old t
  exit : ∀ k s, StairConcreteAssembly.ExitPre k s → ∀ fresh old,
    run (StairSchedule.exitKernel StairConcreteAssembly.checkpointPrimitives
        StairConcrete.bestLoans k) fresh s =
      run (StairLoanRecordExitKernel.exitKernelShape k) old s

/-- The record-loan instance of the same commutation is exactly field 2's
kernel shape (`StairSchedule.entryKernel … recordLoans` against the record
kernels). -/
theorem recordShape_entry_record :
    InverseFiveEntry23.kernel15 true false
        (StairLoanRecordSupport.entryFieldHostedShape
          StairSchedule.recordLoans) =
      InverseFiveEntry23.entryKernel15 := by
  rw [StairLoanRecordSupport.entryFieldHostedShape_record]
  rfl

/-- Exact field 7 from the loaned commutation and field 2. -/
theorem loanReplaySpec_of_commutation
    (half : StairLoanRecordShape.HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44)
    (commute : LoanedCommutation)
    (field2 : StairCertificate.CheckpointReplaySpec
      StairConcreteAssembly.concreteAssembly) :
    StairCertificate.LoanReplaySpec StairConcreteAssembly.concreteAssembly := by
  intro k
  constructor
  · intro s hs fresh old
    have a := commute.entry s hs fresh []
    have b := StairLoanRecordKernel.shapeEntryKernel_run_eq half s hs [] []
    have c := (field2 k).entry s hs old []
    exact a.trans (b.trans c.symm)
  · intro s hs fresh old
    have a := commute.exit k s hs fresh []
    have b := StairLoanRecordExitKernel.shapeExitKernel_run_eq half endpoint k s
      hs [] []
    have c := (field2 k).exit s hs old []
    exact a.trans (b.trans c.symm)

/-- The `StairOpen.loan_composition` field type, given the loaned commutation
and field 2 (field 2 itself consumes field 1, which is closed). -/
theorem loan_composition_of_commutation (commute : LoanedCommutation)
    (field2 : StairCertificate.CheckpointReplaySpec
      StairConcreteAssembly.concreteAssembly) :
    StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) →
      StairEndpointLoan44.MultiplicationRunSpec44 →
      StairCertificate.LoanReplaySpec StairConcreteAssembly.concreteAssembly :=
  fun half endpoint => loanReplaySpec_of_commutation half endpoint commute field2

/-! ## Loans-generic form: one commutation proof for fields 2 and 7 -/

/-- The record-shaped multiplication kernel for an arbitrary loan provider. -/
def exitKernelShapeFor (loans : StairSchedule.StairLoans) (k : Nat) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
      (Rolling1588TickGap.firstPhase false) ++
    (StairLoanRecordExit.exitFieldHostedShape loans ++
      renameProgram Rolling1588Lifetime.phaseHost
        (ParityXExitInverse23Kernel.lastXN k))

/-- Commutation of the staircase kernels with loan provider `loans` into the
record-shaped kernels with the same loan pieces. -/
structure CommutationFor (loans : StairSchedule.StairLoans) : Prop where
  entry : ∀ t, StairConcreteAssembly.EntryPre t → ∀ fresh old,
    run (StairSchedule.entryKernel StairConcreteAssembly.checkpointPrimitives
        loans) fresh t =
      run (InverseFiveEntry23.kernel15 true false
        (StairLoanRecordSupport.entryFieldHostedShape loans)) old t
  exit : ∀ k s, StairConcreteAssembly.ExitPre k s → ∀ fresh old,
    run (StairSchedule.exitKernel StairConcreteAssembly.checkpointPrimitives
        loans k) fresh s =
      run (exitKernelShapeFor loans k) old s

theorem exitKernelShapeFor_record (k : Nat) :
    exitKernelShapeFor StairSchedule.recordLoans k =
      ParityXExitInverse23Kernel.kernelXN k := by
  unfold exitKernelShapeFor
  rw [StairLoanRecordExit.exitFieldHostedShape_record]
  rfl

/-- The record-loan instance of the commutation IS field 2. -/
theorem checkpointReplaySpec_of_commutation
    (commute : CommutationFor StairSchedule.recordLoans) :
    StairCertificate.CheckpointReplaySpec
      StairConcreteAssembly.concreteAssembly := by
  intro k
  constructor
  · intro s hs fresh old
    have a := commute.entry s hs fresh old
    rw [recordShape_entry_record] at a
    exact a
  · intro s hs fresh old
    have a := commute.exit k s hs fresh old
    rw [exitKernelShapeFor_record] at a
    exact a

theorem loanedCommutation_of (commute : CommutationFor StairConcrete.bestLoans) :
    LoanedCommutation where
  entry := commute.entry
  exit := commute.exit

/-- Fields 2 and 7 together from the two instances of one loans-generic
commutation theorem. -/
theorem loan_composition_of_commutations
    (best : CommutationFor StairConcrete.bestLoans)
    (record : CommutationFor StairSchedule.recordLoans) :
    StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) →
      StairEndpointLoan44.MultiplicationRunSpec44 →
      StairCertificate.LoanReplaySpec StairConcreteAssembly.concreteAssembly :=
  loan_composition_of_commutation (loanedCommutation_of best)
    (checkpointReplaySpec_of_commutation record)

end ECDSAAdd.Entrant.StairLoanField7

end
end Merge_StairLoanField7_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanField7Cores_at_Main` -/
section Merge_StairLoanField7Cores_at_Main

/-!
# Field 7 in the core shape of field 2 (one proof for both)

LT21's field 2 (`StairField2V3Core.field2_of_cores`) consumes two cores on the
four named kernel boundaries: the division arithmetic on `EntryPre` and the
multiplication remainder on `ExitMiddle k`.  This module states the same two
cores for an arbitrary loan provider (`CoresFor loans`; bodies of the four
programs are LT21's with `recordLoans` replaced by `loans` on the staircase
side and by the record-shaped loaned field on the reference side) and proves

* `commutationFor_of_cores : CoresFor loans → … → StairLoanField7.CommutationFor loans`
  (the unchanged entry closing / exit opening are tape-free on the reached
  states; both facts are proved here for `bestLoans` and `recordLoans`);
* `loan_composition_of_cores (best : CoresFor bestLoans) (record : CoresFor recordLoans)`
  = the exact `StairOpen.loan_composition` type.

The record instance of `CoresFor` is literally LT21's pair of cores
(`entryReferenceArithmeticFor_record`, `exitReferenceRemainderFor_record`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairLoanField7Cores

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField

/-! ## Tape algebra (generic) -/








/-! ## The four kernel boundaries, for any loan provider -/

/-- LT21's `entrySelectedArithmetic` with `loans` (staircase division arithmetic). -/
def entrySelectedArithmeticFor (loans : StairSchedule.StairLoans) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
      (StairSchedule.firstPhase StairConcreteAssembly.checkpointPrimitives) ++
    StairSchedule.entryFieldHosted StairConcreteAssembly.checkpointPrimitives loans


/-- The unchanged division closing (LT21's `entryReferenceClosing`). -/
def entryClosing : Program :=
  renameProgram Rolling1588Lifetime.phaseHost (InverseFive23.lastPhase15 false)


/-- LT21's `exitSelectedRemainder` with `loans`. -/
def exitSelectedRemainderFor (loans : StairSchedule.StairLoans) (k : Nat) : Program :=
  StairSchedule.exitFieldHosted StairConcreteAssembly.checkpointPrimitives loans ++
    renameProgram Rolling1588Lifetime.phaseHost
      (StairSchedule.lastXN StairConcreteAssembly.checkpointPrimitives k)

/-- LT21's `exitReferenceRemainder` with the record-shaped loaned field. -/
def exitReferenceRemainderFor (loans : StairSchedule.StairLoans) (k : Nat) : Program :=
  StairLoanRecordExit.exitFieldHostedShape loans ++
    renameProgram Rolling1588Lifetime.phaseHost (ParityXExitInverse23Kernel.lastXN k)


/-- The two cores of field 2, for the loan provider `loans`. -/
structure CoresFor (loans : StairSchedule.StairLoans) : Prop where
  entry : ∀ s, StairConcreteAssembly.EntryPre s → ∀ fresh old,
    run (entrySelectedArithmeticFor loans) fresh s =
      run (entryReferenceArithmeticFor loans) old s
  exit : ∀ k t, ExitMiddle k t → ∀ fresh old,
    run (exitSelectedRemainderFor loans k) fresh t =
      run (exitReferenceRemainderFor loans k) old t

/-! ## Record instances are LT21's programs -/


theorem exitReferenceRemainderFor_record (k : Nat) :
    exitReferenceRemainderFor StairSchedule.recordLoans k =
      Rolling1588.exitFieldHosted ++
        renameProgram Rolling1588Lifetime.phaseHost (ParityXExitInverse23Kernel.lastXN k) := by
  unfold exitReferenceRemainderFor
  rw [StairLoanRecordExit.exitFieldHostedShape_record]

/-! ## Kernel splits -/

theorem entryKernel_split (loans : StairSchedule.StairLoans) :
    StairSchedule.entryKernel StairConcreteAssembly.checkpointPrimitives loans =
      entrySelectedArithmeticFor loans ++ entryClosing := by
  simp only [StairSchedule.entryKernel, entrySelectedArithmeticFor, entryClosing,
    List.append_assoc]

theorem shapeKernel_split (loans : StairSchedule.StairLoans) :
    InverseFiveEntry23.kernel15 true false
        (StairLoanRecordSupport.entryFieldHostedShape loans) =
      entryReferenceArithmeticFor loans ++ entryClosing := by
  simp only [InverseFiveEntry23.kernel15, entryReferenceArithmeticFor, entryClosing,
    List.append_assoc]

theorem exitKernel_split (loans : StairSchedule.StairLoans) (k : Nat) :
    StairSchedule.exitKernel StairConcreteAssembly.checkpointPrimitives loans k =
      exitOpening ++ exitSelectedRemainderFor loans k := by
  simp only [StairSchedule.exitKernel, exitOpening, exitSelectedRemainderFor,
    List.append_assoc]

theorem exitShapeKernel_split (loans : StairSchedule.StairLoans) (k : Nat) :
    StairLoanField7.exitKernelShapeFor loans k =
      exitOpening ++ exitReferenceRemainderFor loans k := rfl

/-! ## Cores give the commutation -/

theorem commutationFor_of_cores (loans : StairSchedule.StairLoans)
    (cores : CoresFor loans)
    (closingFree : ∀ s, StairConcreteAssembly.EntryPre s → ∀ records,
      TapeFree entryClosing (run (entryReferenceArithmeticFor loans) records s))
    (openingFree : ∀ k s, StairConcreteAssembly.ExitPre k s → TapeFree exitOpening s) :
    StairLoanField7.CommutationFor loans where
  entry := by
    intro t ht fresh old
    rw [entryKernel_split, shapeKernel_split, run_append, run_append,
      cores.entry t ht (fresh.take (measurementCount (entrySelectedArithmeticFor loans)))
        (old.take (measurementCount (entryReferenceArithmeticFor loans)))]
    exact closingFree t ht _ _ _
  exit := by
    intro k s hs fresh old
    rw [exitKernel_split, exitShapeKernel_split, run_append, run_append,
      openingFree k s hs (fresh.take (measurementCount exitOpening))
        (old.take (measurementCount exitOpening))]
    exact cores.exit k _ ⟨s, hs, _, rfl⟩ _ _

/-! ## The two side conditions, proved -/


/-- A tape-free kernel makes its closing tape-free after the arithmetic part. -/
theorem closingFree_of_kernel (loans : StairSchedule.StairLoans) (s : State)
    (free : TapeFree (InverseFiveEntry23.kernel15 true false
      (StairLoanRecordSupport.entryFieldHostedShape loans)) s) (records : List Bool) :
    TapeFree entryClosing (run (entryReferenceArithmeticFor loans) records s) := by
  rw [shapeKernel_split] at free
  intro m n
  exact nested_tapeFree _ _ s free records m records n

/-- The record division kernel is tape-free on `EntryPre`. -/
theorem entryKernel15_tapeFree (s : State) (hs : StairConcreteAssembly.EntryPre s) :
    TapeFree InverseFiveEntry23.entryKernel15 s := by
  rcases hs with ⟨f⟩
  intro m n
  have hm := InverseFiveEntry23.entry_correct15 f.sharedNodup f.historyAbove
    f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt f.source s m f.input
    f.selectorG_zero f.selectorS_zero f.phase f.outsideNumerator f.numerator
  have hn := InverseFiveEntry23.entry_correct15 f.sharedNodup f.historyAbove
    f.selectorsAway f.transcript f.x f.Y f.x_pos f.x_lt f.source s n f.input
    f.selectorG_zero f.selectorS_zero f.phase f.outsideNumerator f.numerator
  apply State.extensionality
  · exact hm.1.trans hn.1.symm
  · exact run_basis_records _ s s m n rfl

theorem closingFree_record (s : State) (hs : StairConcreteAssembly.EntryPre s)
    (records : List Bool) :
    TapeFree entryClosing
      (run (entryReferenceArithmeticFor StairSchedule.recordLoans) records s) := by
  apply closingFree_of_kernel _ s _ records
  rw [StairLoanField7.recordShape_entry_record]
  exact entryKernel15_tapeFree s hs

theorem closingFree_best (half : StairLoanRecordShape.HalfReplayHypothesis)
    (s : State) (hs : StairConcreteAssembly.EntryPre s) (records : List Bool) :
    TapeFree entryClosing
      (run (entryReferenceArithmeticFor StairConcrete.bestLoans) records s) := by
  apply closingFree_of_kernel _ s _ records
  intro m n
  rw [StairLoanRecordKernel.shapeEntryKernel_run_eq half s hs m [],
    StairLoanRecordKernel.shapeEntryKernel_run_eq half s hs n []]

/-! ## Field 7 from the two instances of the cores -/

theorem commutationFor_record (record : CoresFor StairSchedule.recordLoans) :
    StairLoanField7.CommutationFor StairSchedule.recordLoans :=
  commutationFor_of_cores _ record closingFree_record exitOpening_tapeFree


/-- **Field 7** (exact `StairOpen.loan_composition` type) from the cores for
`bestLoans` and for `recordLoans`. -/
theorem loan_composition_of_cores (best : CoresFor StairConcrete.bestLoans)
    (record : CoresFor StairSchedule.recordLoans) :
    StairReplay.Half760LoanHypothesis
        (fun divide d => StairLoan.half760Loan d divide) →
      StairEndpointLoan44.MultiplicationRunSpec44 →
