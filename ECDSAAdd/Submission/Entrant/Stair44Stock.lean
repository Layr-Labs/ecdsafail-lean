/-- First-row round trip from the four primitive trips. -/
theorem firstTrip (σ : State)
    (h : TripChain firstPieces (pullState Rolling1588Lifetime.phaseHost σ)) :
    ∀ c a, run FU a (run FP c σ) = σ := by
  have e1 : FU = renameProgram Rolling1588Lifetime.phaseHost (invOf firstPieces) := by
    rw [FU, firstUnpack_eq]
  have e2 : FP = renameProgram Rolling1588Lifetime.phaseHost (fwdOf firstPieces) := by
    rw [FP, firstPack_eq]
  rw [e1, e2]
