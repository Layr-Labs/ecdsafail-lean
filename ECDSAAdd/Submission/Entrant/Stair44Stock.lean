section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSlotsPlan

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed DirectSkywalk Secp256k1 BalancedField Baselines

/-! ## 3. Outer lift -/

/-- LT40's square never has more slots than the record square (on every layout). -/
theorem squareEntryHL_slots_le (hl : List Wire) (L : ControlledPointLayout) (k : Fp) :
    gateSlots (StairSquareFinal.squareEntryHL hl L k) ≤ gateSlots (A161Generic.squareEntry L k) := by
  by_cases h : L = Baselines.layout
  · subst h
    rw [StairSquareFinal.squareEntryHL_layout]
    exact StairSquareFinal.square_slots_le hl k
  · have e : StairSquareFinal.squareEntryHL hl L k = A161Generic.squareEntry L k := by
      unfold StairSquareFinal.squareEntryHL StairSquareAssembly.squareEntryH
      exact if_neg h
    rw [e]

def outerSecondStage (X : ControlledPointLayout → Nat → Program)
    (L : ControlledPointLayout) (k cy cx : Fp) : Program :=
  StairSquareFinal.squareEntryHL StairSqLoopA.holes L k ++
    X L cx.val ++ ParityUniform.exitYAll L cy

def outerGeneric (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program)
    (L : ControlledPointLayout) (cx cy : Fp) : Program :=
  ((ParityUniform.entryYAll L (-cy) ++
      FlagEntry.entryXNew L (FlagEntry.pkW L) (-cx)) ++
    E L) ++
    outerSecondStage X L (ReflectionE1.correction cx) cy cx

def outerGenericBlock (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (cx cy : Fp) : Program :=
  renameProgram (FlagTop.rho Baselines.layout)
    (outerGeneric E X Baselines.layout cx cy)

def outerBorrowGeneric (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (cx cy : Fp) : Program :=
  renameProgram
    (Equiv.swap Baselines.layout.doubleSelect Baselines.layout.control)
    (outerGenericBlock E X cx cy)

def outerMiddle (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (C : Point) (cx cy : Fp) : Program :=
  AboveFieldPointDevelop.encode C ++ AboveFieldPointDevelop.eraseB ++
    outerBorrowGeneric E X cx cy ++ AboveFieldPointDevelop.loadB ++
    AboveFieldPointDevelop.decode C

def outerFinite (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (C : Point) (cx cy : Fp) : Program :=
  FlagTop.stageNew Baselines.layout C
      (FlagEntry.pkW Baselines.layout) ++
    outerMiddle E X C cx cy ++ ControlPointEncodingDevelop.borrowOut C

def outerWrapper (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (C : Point) (cx cy : Fp) : Program :=
  renameProgram (Wrapper5.U Baselines.layout) (outerFinite E X C cx cy)

/-- The concrete outer program with its two arithmetic rests as parameters
(`StairConcreteAssembly.concreteProgram` is `outerProgram hostedEntryRest
hostedExitRest`, checked by `rfl` in `StairSlotsV3`). -/
def outerProgram (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (C : Point) : Program :=
  match C with
  | .zero => []
  | @WeierstrassCurve.Affine.Point.some _ _ _ cx cy hc =>
      outerWrapper E X (.some hc) cx cy

theorem outerGeneric_slots_le (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (dE dX : Nat)
    (hE : ∀ L, gateSlots (E L) ≤
      gateSlots (ParityStageBothInverse23.restEntry L) + dE)
    (hX : ∀ L k, gateSlots (X L k) ≤
      gateSlots (ParityXExitInverse23Kernel.restXXN L k) + dX)
    (L : ControlledPointLayout) (cx cy : Fp) :
    gateSlots (outerGeneric E X L cx cy) ≤
      gateSlots (FlagExit.genericN L cx cy) + (dE + dX) := by
  have he := hE L
  have hx := hX L cx.val
  have hq := squareEntryHL_slots_le StairSqLoopA.holes L (ReflectionE1.correction cx)
  simp only [outerGeneric, outerSecondStage, FlagExit.genericN,
    FlagExit.secondStageN, gateSlots_append]
  omega

theorem outerWrapper_slots_le (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (dE dX : Nat)
    (hE : ∀ L, gateSlots (E L) ≤
      gateSlots (ParityStageBothInverse23.restEntry L) + dE)
    (hX : ∀ L k, gateSlots (X L k) ≤
      gateSlots (ParityXExitInverse23Kernel.restXXN L k) + dX)
    {cx cy : Fp} (hc : curve.toAffine.Nonsingular cx cy) :
    gateSlots (outerWrapper E X (.some hc) cx cy) ≤
      gateSlots (AboveFieldPointDevelop.wrapperBorrow (.some hc) cx cy) +
        (dE + dX) := by
  have h := outerGeneric_slots_le E X dE dX hE hX Baselines.layout cx cy
  simp only [outerWrapper, outerFinite, outerMiddle, outerBorrowGeneric,
    outerGenericBlock,
    AboveFieldPointDevelop.wrapperBorrow,
    AboveFieldPointDevelop.finiteBorrow,
    AboveFieldPointDevelop.middle,
    ControlPointEncodingDevelop.borrowGeneric,
    ControlPointEncodingDevelop.genericBlock,
    gateSlots_append, rename_gateSlots]
  omega

/-- The outer lift in the exact `StairOpen.slot_composition` shape. -/
theorem outerProgram_slots_le (E : ControlledPointLayout → Program)
    (X : ControlledPointLayout → Nat → Program) (dE dX : Nat)
    (hE : ∀ L, gateSlots (E L) ≤
      gateSlots (ParityStageBothInverse23.restEntry L) + dE)
    (hX : ∀ L k, gateSlots (X L k) ≤
      gateSlots (ParityXExitInverse23Kernel.restXXN L k) + dX) :
    ∀ C, gateSlots (outerProgram E X C) ≤
      gateSlots (AboveFieldPointDevelop.programQ C) + (dE + dX) := by
  intro C
  cases C with
  | zero =>
      simp [outerProgram, AboveFieldPointDevelop.programQ, gateSlots]
  | @some cx cy hc =>
      have h := outerWrapper_slots_le E X dE dX hE hX hc
      simp only [outerProgram, AboveFieldPointDevelop.programQ] at ⊢
      omega

/-- Field 11 for the outer program built from the parametric rests. -/
theorem slot_composition_of_rests (p : StairSchedule.StairPrimitives)
    (h : StairHostsSchedule.HostPlan) (c : Costs) (b : Boundary)
    (hw : WalkFacts p c) (hg : GroupFacts h c) (hb : BoundaryFacts h b) : ∀ C,
    gateSlots (outerProgram (entryRestOf p h) (exitRestOf p h) C) ≤
      gateSlots (AboveFieldPointDevelop.programQ C) + v3Plan.slotDelta c b := by
  have hE : ∀ L, gateSlots (entryRestOf p h L) ≤
      gateSlots (ParityStageBothInverse23.restEntry L) + v3Plan.entryDelta c b :=
    entryRestOf_slots_le p h c b hw hg hb
  have hX : ∀ L k, gateSlots (exitRestOf p h L k) ≤
      gateSlots (ParityXExitInverse23Kernel.restXXN L k) + v3Plan.exitDelta c b :=
    exitRestOf_slots_le p h c b hw hg hb
  exact outerProgram_slots_le (entryRestOf p h) (exitRestOf p h) _ _ hE hX

/-! ## Bridges to the CANON v3 assembly (all `rfl`) -/



theorem concreteProgram_eq_outer :
    StairConcreteAssembly.concreteProgram =
      outerProgram
        (entryRestOf StairConcreteAssembly.checkpointPrimitives
          StairConcreteAssembly.hostPlan)
        (exitRestOf StairConcreteAssembly.checkpointPrimitives
          StairConcreteAssembly.hostPlan) := by
  funext C
  cases C <;> rfl

end ECDSAAdd.Entrant.StairSlotsPlan

