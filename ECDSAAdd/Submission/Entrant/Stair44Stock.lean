def rowPieces (B B' s f : Nat) : List (Program × Program) :=
  [(P.unpack B, P.pack B), (P.tickForward s, P.tickReverse s),
    (P.middleForward (s + 1) (f - s - 1), P.middleReverse (s + 1) (f - s - 1)),
