section Branch
variable (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (ext : List Wire) (control : Wire)
  (hn : (control::L.wires).Nodup) (he : ECDSAAdd.Entrant.ExtOK L control ext)
  (ps : List (Wire × Wire)) (hps : List.Sublist ps (pairs L))

/-! ### K1: A branch -/







/-! ### K2: B branch -/






/-! ### K3: C branch -/

include hw hn he hps in
theorem branchC_run_eq_of_frame (A Bv : Nat) (s : State) (records : List Bool)
    (ha : regValue L.core.low s.basis=A) (hb : regValue L.core.sum s.basis=Bv) (bound : A+Bv<2^129)
    (hp0 : regValue L.core.product s.basis=0) (hc : L.PairClean s.basis) (hz : regValue ext s.basis=0)
    (B : Program) (hB : ∀ ab∈ps, ab.1∉wires B)
    (frame : ∀ q, q∉L.core.out → (run (SumSavedCBranch.branch L ext control B) records s).basis q=s.basis q) :
    run (branchC2 ps L ext control B) records s=run (SumSavedCBranch.branch L ext control B) records s := by
  have nd := (List.nodup_cons.mp hn).2
  have hsl := L.core.sum_length hw.core
  have dis := L.measured_sum_disjoint nd
  have mEq : measurementCount (withLowK2S2 ps L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))=
      measurementCount (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B)) :=
    (withLowK2S2_counts L control ext L.core.sum L.core.product ps _).2.1
  have eOld : run (SumSavedCBranch.branch L ext control B) records s=
      run (OwnDiagAll12Square.gClear L)
        ((records.drop (measurementCount (OwnDiagAll12Square.gPrep L))).drop
          (measurementCount (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))))
        (run (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))
          ((records.drop (measurementCount (OwnDiagAll12Square.gPrep L))).take
            (measurementCount (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))))
          (run (OwnDiagAll12Square.gPrep L) (records.take (measurementCount (OwnDiagAll12Square.gPrep L))) s)) := by
    rw [show SumSavedCBranch.branch L ext control B=OwnDiagAll12Square.gPrep L++
      (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B)++
        OwnDiagAll12Square.gClear L) by simp only [SumSavedCBranch.branch,List.append_assoc],run_append,run_append]
  have eNew : run (branchC2 ps L ext control B) records s=
      run (OwnDiagAll12Square.gClear L)
        ((records.drop (measurementCount (OwnDiagAll12Square.gPrep L))).drop
          (measurementCount (withLowK2S2 ps L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))))
        (run (withLowK2S2 ps L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))
          ((records.drop (measurementCount (OwnDiagAll12Square.gPrep L))).take
            (measurementCount (withLowK2S2 ps L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))))
          (run (OwnDiagAll12Square.gPrep L) (records.take (measurementCount (OwnDiagAll12Square.gPrep L))) s)) := by
    rw [show branchC2 ps L ext control B=OwnDiagAll12Square.gPrep L++
      (withLowK2S2 ps L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B)++
        OwnDiagAll12Square.gClear L) by simp only [branchC2,List.append_assoc],run_append,run_append]
  have prep := OwnDiagAll12Square.gPrep_frame L hw nd s.basis A Bv ha bound (PairClean.corePad L s.basis hc) hc.cin
    hc.work s (records.take (measurementCount (OwnDiagAll12Square.gPrep L)))
    (show SquareFrame L.core.sum s.basis Bv s.basis from ⟨hb,fun _ _ => rfl⟩)
  obtain ⟨u,hu⟩ : ∃ u : State,
      run (OwnDiagAll12Square.gPrep L) (records.take (measurementCount (OwnDiagAll12Square.gPrep L))) s=u := ⟨_,rfl⟩
  rw [hu] at eOld eNew prep
  rw [mEq] at eNew
  -- the state after the sum preparation (as in `SumSavedCBranch.branch_correct`)
  have productU : regValue L.core.product u.basis=0 :=
    (regValue_congr _ _ _ (fun q hq => prep.2.2 q (fun bad => List.disjoint_left.mp dis.1 bad hq))).trans hp0
  have cleanU : L.PairClean u.basis := by
    have keep (q : Wire) (hq : q∈L.foldPad++L.core.work++[L.core.productHigh,L.core.outHigh,
        L.core.workHigh,L.core.cin,L.core.normFlag,L.core.modFlag]) : u.basis q=s.basis q :=
      prep.2.2 q (L.measured_sum_aux_away nd q hq)
    constructor
    · exact (regValue_congr _ _ _ (fun q hq => keep q (by simp [hq]))).trans hc.pad
    · exact (regValue_congr _ _ _ (fun q hq => keep q (by simp [hq]))).trans hc.work
    · exact (keep _ (by simp)).trans hc.productHigh
    · exact (keep _ (by simp)).trans hc.outHigh
    · exact (keep _ (by simp)).trans hc.workHigh
    · exact (keep _ (by simp)).trans hc.cin
    · exact (keep _ (by simp)).trans hc.normFlag
    · exact (keep _ (by simp)).trans hc.modFlag
  have hzU : regValue ext u.basis=0 :=
    (regValue_congr _ _ _ (fun q hq => prep.2.2 q
      (fun bad => he.away q hq (OwnDiagAll12Square.sum_in L control q bad)))).trans hz
  have tmp0 := tmp_zero L s hc
  have fin : ∀ q∈LowZero18LowK.ktmp L,
      (run (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product (R2SqEp760.bodySwap L ext B))
        ((records.drop (measurementCount (OwnDiagAll12Square.gPrep L))).take
          (measurementCount (SumSavedPark.withLowK2S L ext control L.core.sum L.core.product
            (R2SqEp760.bodySwap L ext B)))) u).basis q=false := by
    intro q hq
    have notOut : q∉L.core.out := fun ho => tmp_off L control hn ext L.core.sum L.core.product
      (sum_count L) (fun _ => le_rfl) he.nodup he.away q hq (out_out L control ext _ _ q ho)
    have f := frame q notOut
    rw [eOld,run_preserves_outside _ _ _ _ (ktmp_off_g L hw control hn q hq).2] at f
    rw [f]
    exact tmp0 q hq
  have mid := withLowK2S2_run_eq L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
    (by simp [hsl]) (by simp [hsl]) (by simp [hw.core.product,hsl]) he.nodup he.away he.len ps hps hsl
    _ (bodySwap_free L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
      he.nodup he.away he.len ps hps B hB) u _ cleanU productU hzU fin
  rw [eNew,eOld,mid]

include hw hn he hps in
/-- **K3.** The record C branch and its kernel-hosted version run identically, under the hypotheses of
`SumSavedCBranch.branch_correct` plus "the body avoids the hosted holes". -/
theorem branchC_run_eq (A Bv O : Nat) (hO : O<SquareReduction.p) (s : State) (records : List Bool)
    (ha : regValue L.core.low s.basis=A) (hb : regValue L.core.sum s.basis=Bv)
    (bound : A+Bv<2^129) (ho : regValue L.core.out s.basis=O)
    (hp0 : regValue L.core.product s.basis=0) (hc : L.PairClean s.basis) (hz : regValue ext s.basis=0)
    (d : Wire) (hdW : d∉control::L.wires) (hdE : d∉ext) (hd0 : s.basis d=false)
    (B : Program) (sup : wires B⊆insert d (control::L.wires).toFinset)
    (bodyFrame : ∀ (base : BasisState) (M : Nat), regValue L.core.product base=M^2 → L.PairClean base →
      (base control=false → M=0) → base d=false → ∀ O, O<SquareReduction.p →
      Triple (SquareFrame L.core.out base O) B
       (SquareFrame L.core.out base (C163Low4Offsets.resCFlow (base control) (M^2) O)))
    (hB : ∀ ab∈ps, ab.1∉wires B) :
    run (branchC2 ps L ext control B) records s=run (SumSavedCBranch.branch L ext control B) records s :=
  branchC_run_eq_of_frame L hw ext control hn he ps hps A Bv s records ha hb bound hp0 hc hz B hB
    (SumSavedCBranch.branch_correct L hw ext control hn A Bv O hO s records ha hb bound ho hp0 hc he hz
      d hdW hdE hd0 B sup bodyFrame).2.2

include hw hn he hps in
theorem branchC_avoids (B : Program) (hB : ∀ ab∈ps, ab.1∉wires B) :
    ∀ q∈holesOf ps, q∉wires (branchC2 ps L ext control B) := by
  have hsl := L.core.sum_length hw.core
  have mid := withLowK2S2_avoids L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
    (by simp [hsl]) (by simp [hsl]) (by simp [hw.core.product,hsl]) he.nodup he.away he.len ps hps hsl
    _ (bodySwap_free L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
      he.nodup he.away he.len ps hps B hB)
  intro q hq u
  obtain ⟨ab,h,e,hh⟩ := holesOf_mem L ps hps q hq
  have g := ktmp_off_g L hw control hn q (holes_sub_ktmp L q hh)
  simp only [branchC2,wires_append,Finset.mem_union] at u
  rcases u with (u|u)|u
  · exact g.1 u
  · exact mid q hq u
  · exact g.2 u

include hw hn he hps in
theorem branchC_wires (B : Program) :
    wires (branchC2 ps L ext control B)⊆wires (SumSavedCBranch.branch L ext control B)∪(hostsOf ps).toFinset := by
  have hsl := L.core.sum_length hw.core
  have mid := withLowK2S2_wires L hw control hn ext L.core.sum L.core.product (sum_count L) (fun _ => le_rfl)
    (by simp [hsl]) (by simp [hsl]) (by simp [hw.core.product,hsl]) he.nodup he.away he.len ps hps
    (R2SqEp760.bodySwap L ext B)
  intro q u
  simp only [branchC2,SumSavedCBranch.branch,wires_append,Finset.mem_union] at u ⊢
  rcases u with (u|u)|u
  · exact Or.inl (Or.inl (Or.inl u))
  · rcases Finset.mem_union.mp (mid u) with h|h
    · exact Or.inl (Or.inl (Or.inr h))
    · exact Or.inr h
  · exact Or.inl (Or.inr u)

theorem branchC_counts (B : Program) :
    toffoliCount (branchC2 ps L ext control B)=toffoliCount (SumSavedCBranch.branch L ext control B) ∧
    measurementCount (branchC2 ps L ext control B)=measurementCount (SumSavedCBranch.branch L ext control B) ∧
    Challenge.gateSlots (branchC2 ps L ext control B)=Challenge.gateSlots (SumSavedCBranch.branch L ext control B) := by
  have c := withLowK2S2_counts L control ext L.core.sum L.core.product ps (R2SqEp760.bodySwap L ext B)
  refine ⟨?_,?_,?_⟩
  · simp only [branchC2,SumSavedCBranch.branch,toffoliCount_append,c.1]
  · simp only [branchC2,SumSavedCBranch.branch,measurementCount_append,c.2.1]
  · simp only [branchC2,SumSavedCBranch.branch,Challenge.gateSlots_append,c.2.2]

theorem branchC_physical (B : Program) (h : GatePhysical (SumSavedCBranch.branch L ext control B)) :
    GatePhysical (branchC2 ps L ext control B) := by
  simp only [SumSavedCBranch.branch,gatePhysical_append] at h
  simp only [branchC2,gatePhysical_append]
  exact ⟨⟨h.1.1,withLowK2S2_physical L control ext L.core.sum L.core.product ps _ h.1.2⟩,h.2⟩

end Branch

