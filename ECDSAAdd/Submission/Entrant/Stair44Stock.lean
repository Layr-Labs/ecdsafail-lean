/-- `Partial.sig_box` on the shadow window, through block 22 (start 405). -/
theorem sig_box7 {s c : Nat} (h1 : 45 ≤ s) (h2 : s ≤ 405) (hc1 : 1044 ≤ c) (hc2 : c ≤ 1058) :
    leaveBox s (OB5.sig (s+14) (s+c)) := by
