    refine proper_append (a := [Gate.cx (e0P s + 6) (e0P s + 3)])
      (proper_cons (pr_cx (by ((try unfold Wire at *); omega))) proper_nil) ?_
    refine proper_adjustG _ _ _ _ (fun y hy => ?_) (fun hc => ?_) (pool_nodup s _ h1 h2 (le_refl _))
