/-- The encoded challenge input satisfies the record's point-dialog boundary. -/
theorem boundary_of_encodes (b : Bool) (R : Point) (t : State)
    (ht : Challenge.encodes b R t.basis) :
    PointDialogBoundary layout R b (fun _=>false) t.basis := by
  have hz : regValue layout.work t.basis = 0 :=
