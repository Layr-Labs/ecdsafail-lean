/-! ## Codec rows -/

theorem v3_pack_counts (B : Nat) (hB : B ∈ StairPhysicalLayout.budgets) :
    toffoliCount (checkpointPrimitives.pack B) = 2 * B - 4 ∧
      measurementCount (checkpointPrimitives.pack B) =
        3 * B - 3 + StairCodec.decoderCost (StairCodec.bitWidth B) := by
  have h3 := StairPhysicalPrimitives.budget_three B hB
  obtain ⟨h1, h2⟩ := StairCodec.pack_counts (StairPhysicalLayout.physicalLayout B) B h3
  obtain ⟨e1, e2⟩ := StairBridgeSign.signExtend_counts
    ((StairPhysicalLayout.physicalLayout B).D (B - 1)) (StairPhysicalLayout.bSite B)
  obtain ⟨r1, r2, -, -⟩ := StairPhysicalLayout.relocate_counts B hB
  change toffoliCount (StairPhysicalPrimitives.pack B) = _ ∧
    measurementCount (StairPhysicalPrimitives.pack B) = _
  rw [StairPhysicalPrimitives.pack, StairPhysicalPrimitives.signExt]
  simp only [toffoliCount_append, measurementCount_append]
  constructor <;> omega

theorem v3_unpack_counts (B : Nat) (hB : B ∈ StairPhysicalLayout.budgets) :
    toffoliCount (checkpointPrimitives.unpack B) =
        3 * B - 4 - StairCodec.unpackCutCount B + StairCodec.decoderCost (StairCodec.bitWidth B) - StairCodec.highSaving B ∧
      measurementCount (checkpointPrimitives.unpack B) = 2 * B - 3 := by
  have h3 := StairPhysicalPrimitives.budget_three B hB
  obtain ⟨h1, h2⟩ := StairCodec.unpack_counts (StairPhysicalLayout.physicalLayout B) B h3
  obtain ⟨e1, e2⟩ := StairBridgeSign.signExtend_counts
    ((StairPhysicalLayout.physicalLayout B).D (B - 1)) (StairPhysicalLayout.bSite B)
  obtain ⟨-, -, r1, r2⟩ := StairPhysicalLayout.relocate_counts B hB
  change toffoliCount (StairPhysicalPrimitives.unpack B) = _ ∧
    measurementCount (StairPhysicalPrimitives.unpack B) = _
  rw [StairPhysicalPrimitives.unpack, StairPhysicalPrimitives.signExt]
  simp only [toffoliCount_append, measurementCount_append]
  constructor <;> omega


/-- One codec row with its decoder constant `c`. -/
theorem v3_codec_row (B w c x : Nat) (hB : B ∈ StairPhysicalLayout.budgets)
    (hw : StairCodec.bitWidth B = w) (hc : StairCodec.decoderCost w = c)
    (hx : StairCodec.unpackCutCount B = x) :
    toffoliCount (checkpointPrimitives.pack B) = 2 * B - 4 ∧
      measurementCount (checkpointPrimitives.pack B) = 3 * B - 3 + c ∧
      toffoliCount (checkpointPrimitives.unpack B) = 3 * B - 4 - x + c - StairCodec.highSaving B ∧
      measurementCount (checkpointPrimitives.unpack B) = 2 * B - 3 := by
  obtain ⟨p1, p2⟩ := v3_pack_counts B hB
  obtain ⟨u1, u2⟩ := v3_unpack_counts B hB
  rw [hw, hc] at p2 u1
  rw [hx] at u1
  exact ⟨p1, p2, u1, u2⟩

