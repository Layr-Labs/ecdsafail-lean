  cases C with
  | zero => exact pieceOK_nil holes _
  | some hc =>
    rename_i cx cy
    show PieceOK holes (fun x => x) (hostedWrapper (.some hc) cx cy)
    unfold hostedWrapper
    apply ok_wrapper
    unfold hostedFinite
    refine (PieceOK.append (PieceOK.append (H.stage _) ?_) (H.borrowOut _))
    unfold hostedMiddle
    refine ((((H.encode _).append H.eraseB).append ?_).append H.loadB).append (H.decode _)
    unfold hostedBorrowGeneric hostedGenericBlock
    apply ok_generic
    unfold hostedGeneric
    refine PieceOK.append (PieceOK.append ((H.entryY _).append (H.entryX _)) ?_) ?_
    · rw [hostedEntryRest_eq]
      exact ok_kernel (entryInner_ok hsub H)
    · unfold hostedSecondStage
      refine ((H.square _).append ?_).append (H.exitY _)
      rw [hostedExitRest_eq]
      exact ok_kernel (exitInner_ok hsub H _)

/-- FIELD 12 (`site_avoidance`) for the v3 program, parametric in the proved
hole list: exactly LT7's `HolePlacement holes` for every point. -/
theorem site_avoidance (holes : List Wire)
    (hsub : ∀ q ∈ holes, q ∈ StairPhysicalInventory.physicalHoles)
    (H : OpenPieces holes) :
    ∀ C, StairCertificate.HolePlacement holes (concreteAssembly.program C) := fun C =>
  holePlacement_of_ok (concreteProgram_ok hsub H C)


end Composition

end ECDSAAdd.Entrant.StairSiteAvoidance

end
end Merge_StairSiteAvoidance_at_Main

