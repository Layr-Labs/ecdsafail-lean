      refine signedRegValue_map2 _ _ _ _ _ ?_
      intro k hk
      show Y0'.basis (bSite k) = raw.basis (OB5.sig 424 (base (770 + k)))
      rw [v1 _ (c83ne.2 k hk), hY0b, xD k hk]
      refine hlay (base (770 + k)) (List.mem_append_left _ (List.mem_append_right _ ?_))
