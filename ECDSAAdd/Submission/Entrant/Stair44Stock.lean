    rcases hs with rfl | rfl | rfl | rfl | rfl | rfl
    · exact sound_tickReverse_row 87 (by decide)
    · exact sound_tickReverse_row 62 (by decide)
    · exact sound_tickReverse_row 47 (by decide)
    · exact sound_tickReverse_row 32 (by decide)
    · exact sound_tickReverse_row 22 (by decide)
    · exact sound_tickReverse_row 12 (by decide)
  middleForward s f hsf := by
    rw [cp_middleForward]
    simp only [v3Segments, List.mem_cons, List.not_mem_nil, or_false,
      Prod.mk.injEq] at hsf
    rcases hsf with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact sound_middleForward_row 87 (by decide)
    · exact sound_middleForward_row 62 (by decide)
    · exact sound_middleForward_row 47 (by decide)
    · exact sound_middleForward_row 32 (by decide)
    · exact sound_middleForward_row 22 (by decide)
  middleReverse s f hsf := by
    rw [cp_middleReverse]
    simp only [v3Segments, List.mem_cons, List.not_mem_nil, or_false,
      Prod.mk.injEq] at hsf
    rcases hsf with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact sound_middleReverse_row 87 (by decide)
    · exact sound_middleReverse_row 62 (by decide)
    · exact sound_middleReverse_row 47 (by decide)
    · exact sound_middleReverse_row 32 (by decide)
    · exact sound_middleReverse_row 22 (by decide)
  middleForwardLast := by
    rw [cp_middleForward]
    exact sound_middleForward_row 12 (by decide)
  middleReverseLast := by
    rw [cp_middleReverse]
    exact sound_middleReverse_row 12 (by decide)
  firstPack := by
    rw [cp_firstPack]
    exact K.firstPack
  firstUnpack := by
    rw [cp_firstUnpack]
    exact K.firstUnpack
  forwardTerminal := by
    rw [cp_forwardTerminal]
    exact sound_forwardTerminalV3
  reverseTerminal := by
    rw [cp_reverseTerminal]
    exact sound_reverseTerminalV3

