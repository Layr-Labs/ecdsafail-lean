theorem xList_good : ∀ q ∈ xList, Good39 (UG (E1QubitPlacement.pmapR Baselines.layout q)) := by
  have key : ∀ q ∈ xList, good39B (StairPlaceFast.kernelPlaceB (e1B q)) = true := by
    intro q hq
