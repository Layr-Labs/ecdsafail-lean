    rawPorts i∉dst ∧ OB5.sig 420 (rawPorts i)=Shadow7.scratchX 420 (i.val-23) ∧ ∀v:Fin 10,rawPorts i≠NativePack4207.history v := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

