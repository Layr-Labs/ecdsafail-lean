theorem primitives_orientR (i : Nat) : primitives.orientR i = orient i := rfl

theorem primitives_firstPack : primitives.firstPack = firstPack := rfl

theorem primitives_firstUnpack : primitives.firstUnpack = firstUnpack := rfl

