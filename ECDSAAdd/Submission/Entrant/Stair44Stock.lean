section Merge_StairConcreteAssembly_at_Main

/-!
# Concrete staircase assembly (CANON v3: k = 44 re-plan, Q 1542)

This module fixes one program provider, one codec layout family, the concrete
host plan, and the state predicates used at the two arithmetic-kernel replay
boundaries.  The outer program is the current record wrapper with its two
arithmetic rests replaced by the hosted staircase rests.

The final section deliberately exposes the one remaining semantic boundary as
`ConcreteComposition concreteAssembly`.  Its fields refer to fixed, named
record programs; no caller-chosen decomposition or whole-replay premise is
hidden in `entryPre` or `exitPre`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairConcreteAssembly

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField

/-! ## Concrete checkpoint programs (CANON v3)

The k = 44 re-plan: LT13's physical codec layouts and primitives with LT14's
repaired orientation and first-row relocation (`StairV3Primitives`). -/


/-- The single concrete primitive provider selected by the assembly. -/
abbrev checkpointPrimitives : StairSchedule.StairPrimitives :=
  StairV3Primitives.primitives

/-! ## Hosted arithmetic rests and outer program -/


/-- Division rest after the caller's already-fused first tick. -/
def hostedEntryRest (L : ControlledPointLayout) : Program :=
  renameProgram (wireFn2 L)
    (renameProgram Rolling1588Lifetime.phaseHost
        (StairSchedule.stackForward6 checkpointPrimitives) ++
      StairHostsSchedule.entryFieldHosted checkpointPrimitives hostPlan ++
      renameProgram Rolling1588Lifetime.phaseHost
        (InverseFive23.lastPhase15 false))

/-- Multiplication rest after the caller's already-fused first tick. -/
def hostedExitRest (L : ControlledPointLayout) (k : Nat) : Program :=
  renameProgram (wireFn2 L)
    (renameProgram Rolling1588Lifetime.phaseHost
        (Rolling1588TickGap.tailPhase false) ++
      StairHostsSchedule.exitFieldHosted checkpointPrimitives hostPlan ++
      renameProgram Rolling1588Lifetime.phaseHost
        (StairHostsSchedule.lastXN checkpointPrimitives hostPlan k))

/-- Multiplication stage: LT40's hole-free square (`StairSquareFinal.squareEntryHL`, = the
record square `A161Generic.squareEntry L k` on every layout except `Baselines.layout`,
where it is the new square freeing all 39 holes `StairSqLoopA.holes`), then the hosted rest. -/
def hostedSecondStage (L : ControlledPointLayout)
    (k cy cx : Fp) : Program :=
  StairSquareFinal.squareEntryHL StairSqLoopA.holes L k ++
    hostedExitRest L cx.val ++ ParityUniform.exitYAll L cy

def hostedGeneric (L : ControlledPointLayout) (cx cy : Fp) : Program :=
  ((ParityUniform.entryYAll L (-cy) ++
      FlagEntry.entryXNew L (FlagEntry.pkW L) (-cx)) ++
    hostedEntryRest L) ++
    hostedSecondStage L (ReflectionE1.correction cx) cy cx

def hostedGenericBlock (cx cy : Fp) : Program :=
  renameProgram (FlagTop.rho Baselines.layout)
    (hostedGeneric Baselines.layout cx cy)

def hostedBorrowGeneric (cx cy : Fp) : Program :=
  renameProgram
    (Equiv.swap Baselines.layout.doubleSelect Baselines.layout.control)
    (hostedGenericBlock cx cy)

/-- The record's `AboveFieldPointDevelop.middle` with only `borrowGeneric`
replaced.  Its encoder/decoder are the record's own
`AboveFieldPointDevelop.encode`/`decode` (= `AboveFieldTagDevelop`), not the
legacy `ControlPointEncodingDevelop` pair (LT6 round 11 correction). -/
def hostedMiddle (C : Point) (cx cy : Fp) : Program :=
  AboveFieldPointDevelop.encode C ++ AboveFieldPointDevelop.eraseB ++
    hostedBorrowGeneric cx cy ++ AboveFieldPointDevelop.loadB ++
    AboveFieldPointDevelop.decode C

def hostedFinite (C : Point) (cx cy : Fp) : Program :=
  FlagTop.stageNew Baselines.layout C
      (FlagEntry.pkW Baselines.layout) ++
    hostedMiddle C cx cy ++ ControlPointEncodingDevelop.borrowOut C

def hostedWrapper (C : Point) (cx cy : Fp) : Program :=
  renameProgram (Wrapper5.U Baselines.layout) (hostedFinite C cx cy)

def concreteProgram (C : Point) : Program :=
  match C with
  | .zero => []
  | @WeierstrassCurve.Affine.Point.some _ _ _ cx cy hc =>
      hostedWrapper (.some hc) cx cy

/-! ## Exact record arithmetic preconditions -/





/-- The one concrete assembly selected for subsequent integration work. -/
def concreteAssembly : StairCertificate.Assembly where
  program := concreteProgram
  place := StairPhysicalInventory.place
  layout := codecLayout
  primitives := checkpointPrimitives
  hostPlan := hostPlan
