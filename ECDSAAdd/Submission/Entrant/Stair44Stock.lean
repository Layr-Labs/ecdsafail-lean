/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3EntryPlanR_at_Main` -/
section Merge_StairField2V3EntryPlanR_at_Main

/-!
# LT43g: the division plan with reachability and a pinned input

LT21's `EntryPlan` relates the two division runs by `Rel (Δv B) (Cv B)`, where
`Cv B` only knows *some* input consistent with the record transcript on
`futurePayload B`.  The last step, however, needs the history letter `s 510` of the
*genuine* input (LT43c, finding F3).  `EntryPlanR p x` is the pinned mirror of
`EntryPlan`, exactly as `ExitPlanR` on the multiplication side: the reference state is
reached from a division input of input `x` (`ReachEn x X t`), and the side condition
is `CvX x B`.

`entryArith_of_planR` / `entryCore_of_planR` turn one plan per input into the
division core of field 2.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3EntryPlanR

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry
open StairField2V3Delta StairField2V3Seg StairField2V3ExitPlanR
open StairPhysicalLayout StairOuterPlacement

/-! ## Division inputs with a pinned input -/











/-- Every remaining division obligation for input `x`. -/
structure EntryPlanR (p : StairSchedule.StairPrimitives) (x : Nat) where
  junction : CRel (J0X x) (RelX x 87) (selJ0 p) refJ0
  seg0 : CRel (RowRelEn x 87 R1) (RelX x 62) (seg p 87 62 425 450) []
  seg1 : CRel (RowRelEn x 62 R2) (RelX x 47) (seg p 62 47 450 465) []
  seg2 : CRel (RowRelEn x 47 R3) (RelX x 32) (seg p 47 32 465 480) []
  seg3 : CRel (RowRelEn x 32 R4) (RelX x 22) (seg p 32 22 480 490) []
  seg4 : CRel (RowRelEn x 22 R5) (RelX x 12) (seg p 22 12 490 500) []
  lastStep : CRel (RowRelEn x 12 R6) Eq (lastSeg p) []

/-! ## The chain -/




theorem junctionEn {p : StairSchedule.StairPrimitives} {x : Nat}
    (h : CRel (J0X x) (RelX x 87) (selJ0 p) refJ0) :
    CRel (J0X x) (RowRelEn x 87 R0) (selJ0 p) refJ0 :=
  junction_track_gen (EntryPreX x) prefixW h


theorem chain_of_planR {p : StairSchedule.StairPrimitives} {x : Nat} (plan : EntryPlanR p x) :
    CRel (fun s t => EntryPreX x s ∧ s = t) Eq
      (prefixW ++ (selJ0 p ++ (firstPkt ++ (grp 1 84 ++ (seg p 87 62 425 450 ++ (grp 85 5 ++
        (seg p 62 47 450 465 ++ (grp 90 3 ++ (seg p 47 32 465 480 ++ (grp 93 3 ++
        (seg p 32 22 480 490 ++ (grp 96 2 ++ (seg p 22 12 490 500 ++ (grp 98 2 ++
        (lastSeg p ++ tailP)))))))))))))))
      (prefixW ++ (refJ0 ++ (firstPkt ++ (grp 1 84 ++ (grp 85 5 ++ (grp 90 3 ++ (grp 93 3 ++
        (grp 96 2 ++ (grp 98 2 ++ tailP))))))))) := by
  have s0 : CRel (RowRelEn x 87 ((R0 ++ firstPkt) ++ grp 1 84)) (RelX x 62)
      (seg p 87 62 425 450) [] := plan.seg0
  have s1 : CRel (RowRelEn x 62 (R1 ++ grp 85 5)) (RelX x 47) (seg p 62 47 450 465) [] :=
    plan.seg1
  have s2 : CRel (RowRelEn x 47 (R2 ++ grp 90 3)) (RelX x 32) (seg p 47 32 465 480) [] :=
    plan.seg2
  have s3 : CRel (RowRelEn x 32 (R3 ++ grp 93 3)) (RelX x 22) (seg p 32 22 480 490) [] :=
    plan.seg3
  have s4 : CRel (RowRelEn x 22 (R4 ++ grp 96 2)) (RelX x 12) (seg p 22 12 490 500) [] :=
    plan.seg4
  have ls : CRel (RowRelEn x 12 (R5 ++ grp 98 2)) Eq (lastSeg p) [] := plan.lastStep
  refine crel_append (crel_prefixX x) (crel_append (junctionEn plan.junction)
    (crel_append (sharedEn x 87 firstPkt R0 fp_awayX)
    (crel_append (sharedEn x 87 _ (R0 ++ firstPkt) (grp_away 87 (by decide) 1 84 (by decide)))
    (crel_sel_cons (segEn s0)
    (crel_append (sharedEn x 62 _ R1 (grp_away 62 (by decide) 85 5 (by decide)))
    (crel_sel_cons (segEn s1)
    (crel_append (sharedEn x 47 _ R2 (grp_away 47 (by decide) 90 3 (by decide)))
    (crel_sel_cons (segEn s2)
    (crel_append (sharedEn x 32 _ R3 (grp_away 32 (by decide) 93 3 (by decide)))
    (crel_sel_cons (segEn s3)
    (crel_append (sharedEn x 22 _ R4 (grp_away 22 (by decide) 96 2 (by decide)))
    (crel_sel_cons (segEn s4)
    (crel_append (sharedEn x 12 _ R5 (grp_away 12 (by decide) 98 2 (by decide)))
    (crel_sel_cons ls (crel_eq_shared tailP)))))))))))))))

/-- **Division core from the plans** (one per input). -/
theorem entryArith_of_planR {p : StairSchedule.StairPrimitives}
    (plan : ∀ x, EntryPlanR p x) :
    RunEqOn StairConcreteAssembly.EntryPre (selArith p) entryReferenceArithmetic := by
  intro s hs fresh old
  obtain ⟨x, hx⟩ := entryPre_x s hs
  have h : RunEqOn (EntryPreX x) (selArith p) entryReferenceArithmetic := by
    rw [selArith_shape, refArith_shape]
    apply runEqOn_of_coupled (chain_of_planR (plan x))
    intro t ht
    have h := StairField2V3Core.entryReferenceArithmetic_tapeFree t (entryPre_of_x x t ht)
    rw [refArith_shape] at h
    exact h
  exact h s hx fresh old

/-- The division core of `concreteAssembly` from the pinned plans for its primitives. -/
theorem entryCore_of_planR
    (plan : ∀ x, EntryPlanR StairConcreteAssembly.checkpointPrimitives x) :
    StairCertificate.CodecFunctionalSpec StairField2V3Core.Assembly →
      RunEqOn StairConcreteAssembly.EntryPre
        (entrySelectedArithmetic StairField2V3Core.Assembly)
        entryReferenceArithmetic := fun _ => by
  rw [selArith_eq]
  exact entryArith_of_planR plan

/-! ## Segment steps from the pure spec and the record fact (pinned `seg_of_spec`) -/

theorem segX_of_spec (p : StairSchedule.StairPrimitives) (x B B' ℓ e : Nat) (X : Program)
    (sub : ∀ r ∈ futurePayload B', r ∈ futurePayload B)
    (spec : SegSpecT p B B' ℓ e) (rec : RecordScratch B B' X) :
    CRel (RowRelEn x B X) (RelX x B') (seg p B B' ℓ e) [] := by
  rintro s t ⟨⟨⟨hph, hout⟩, ⟨origin, hx, hv⟩⟩, hreachX⟩ fresh
  have hreach : Reach X t := reach_of_x x X t hreachX
  refine ⟨[], ?_⟩
  change RelX x B' (run (liftF (StairSchedule.forwardSegment p B B' ℓ e)) fresh s) t
  rw [liftF_run]
  have notFut : ∀ r ∈ scratchT B B', r ∉ futurePayload B := by
    intro r hr
    exact of_decide_eq_true (List.mem_filter.mp hr).2
  have pre1 : ∀ r ∈ futurePayload B, (pullIn s).basis r = cmpBits B x r :=
    fun r hr => (hv r hr).2
  have pre2 : ∀ r ∈ scratchT B B', (pullIn s).basis r = false := by
    intro r hr
    change s.basis (fieldPlace r) = false
    rw [hout _ (not_mem_Δv B r (notFut r hr))]
    exact rec t hreach r hr
  obtain ⟨sph, sout, sscr, scmp, srec⟩ := spec x origin hx (pullIn s) pre1 pre2 fresh
  set u' := run (StairSchedule.forwardSegment p B B' ℓ e) fresh (pullIn s) with hu'
  have pull : ∀ r, (pullOut u').basis (fieldPlace r) = u'.basis r := by
    intro r
    change u'.basis (fieldPlaceInv (fieldPlace r)) = u'.basis r
    rw [inv_fieldPlace]
  refine ⟨⟨?_, ?_⟩, origin, hx, ?_⟩
  · change u'.phase = t.phase
    rw [sph]
    exact hph
  · intro q hq
    rw [← fieldPlace_inv q, pull]
    set r := fieldPlaceInv q
    have hq' : fieldPlace r ∉ Δv B' := by rw [fieldPlace_inv]; exact hq
    by_cases hf : r ∈ futurePayload B
    · have hf' : r ∉ futurePayload B' := fun h => hq' (mem_Δv B' r h)
      rw [srec r hf hf']
      exact ((hv r hf).1).symm
    · by_cases hs : r ∈ scratchT B B'
      · rw [sscr r hs]
        exact (rec t hreach r hs).symm
      · rw [sout r hf hs]
        exact hout _ (not_mem_Δv B r hf)
  · intro r hr
    refine ⟨(hv r (sub r hr)).1, ?_⟩
    rw [pull]
    exact scmp r hr

/-- The last step from a pinned pure spec and a pinned record fact. -/
theorem lastX_of_spec (p : StairSchedule.StairPrimitives) (x : Nat) (Φ : BasisState → Prop)
    (spec : ∀ s t, AgreeOutside (Δv 12) s t → CvX x 12 s.basis t.basis → Φ t.basis →
      ∀ fresh, run (lastSeg p) fresh s = t)
    (rec : ∀ t, ReachEn x R6 t → Φ t.basis) :
    CRel (RowRelEn x 12 R6) Eq (lastSeg p) [] := by
  rintro s t ⟨⟨hagree, hC⟩, hreach⟩ fresh
  exact ⟨[], spec s t hagree hC (rec t hreach) fresh⟩

end ECDSAAdd.Entrant.StairField2V3EntryPlanR

end
end Merge_StairField2V3EntryPlanR_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitRSeg_at_Main` -/
section Merge_StairField2V3ExitRSeg_at_Main

/-!
# Exit reverse segments from the entry segment spec + the row round trip (LT24)

LT21 reduces each division segment to the pure staircase spec
`SegSpecT p B B' ℓ e` (`StairField2V3Seg`).  The multiplication segment is its
mirror:

* `RSegSpecT p B B' ℓ e` — from the compact checkpoint of row `B'`, the
  segment's encoded packets (`recVal`) and clean scratch, the reverse segment
  gives the compact checkpoint of row `B` with clean scratch, nothing else changed;
* `rspec_of_spec : SegSpecT → RowTripT → RSegSpecT` — the forward spec + the
  row round trip `W ∘ F = id` give the reverse spec, because every admissible
  reverse input is the forward image of an admissible forward input (state surgery
  on `futurePayload B`);
* `rseg_of_rspec` — the coupled step for the exit chain (mirror of `seg_of_spec`).
  The source relation `ExitRowRel` carries what the reference state must satisfy
  at the exit: the record transcript on `futurePayload B` and clean segment scratch.
  Plain `Cv B'` is not enough here: it fixes the reference only on `futurePayload B'`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24RSeg

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3Delta StairField2V3Seg
open StairPhysicalLayout StairOuterPlacement

/-- Row round trip in tail coordinates, on admissible forward inputs. -/
def RowTripT (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat) : Prop :=
  ∀ x origin, TraceOK x origin → ∀ (u : State),
    (∀ r ∈ futurePayload B, u.basis r = cmpBits B x r) →
    (∀ r ∈ scratchT B B', u.basis r = false) → ∀ c a,
      run (StairSchedule.reverseSegment p B B' ℓ e) a
        (run (StairSchedule.forwardSegment p B B' ℓ e) c u) = u

/-- Pure tail-level staircase spec of `reverseSegment p B B' ℓ e`. -/
def RSegSpecT (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat) : Prop :=
  ∀ x origin, TraceOK x origin → ∀ (v : State),
    (∀ r ∈ futurePayload B', v.basis r = cmpBits B' x r) →
    (∀ r ∈ futurePayload B, r ∉ futurePayload B' → v.basis r = recVal origin r) →
    (∀ r ∈ scratchT B B', v.basis r = false) → ∀ m,
      (run (StairSchedule.reverseSegment p B B' ℓ e) m v).phase = v.phase ∧
      (∀ r, r ∉ futurePayload B → r ∉ scratchT B B' →
        (run (StairSchedule.reverseSegment p B B' ℓ e) m v).basis r = v.basis r) ∧
      (∀ r ∈ scratchT B B', (run (StairSchedule.reverseSegment p B B' ℓ e) m v).basis r = false) ∧
      (∀ r ∈ futurePayload B, (run (StairSchedule.reverseSegment p B B' ℓ e) m v).basis r = cmpBits B x r)


/-- **Mirror.** The reverse spec from the forward spec and the row round trip. -/
theorem rspec_of_spec (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat)
    (spec : SegSpecT p B B' ℓ e) (trip : RowTripT p B B' ℓ e) : RSegSpecT p B B' ℓ e := by
  intro x origin hx v h1 h2 h3 m
  let u : State := ⟨v.phase, fun r => if r ∈ futurePayload B then cmpBits B x r else v.basis r⟩
  have uIn : ∀ r ∈ futurePayload B, u.basis r = cmpBits B x r := by
    intro r hr
    show (if r ∈ futurePayload B then cmpBits B x r else v.basis r) = _
    rw [if_pos hr]
  have uOut : ∀ r, r ∉ futurePayload B → u.basis r = v.basis r := by
    intro r hr
    show (if r ∈ futurePayload B then cmpBits B x r else v.basis r) = _
    rw [if_neg hr]
  have uScr : ∀ r ∈ scratchT B B', u.basis r = false := by
    intro r hr
    rw [uOut r (scratch_not_fut B B' r hr)]
    exact h3 r hr
  obtain ⟨sph, sout, sscr, scmp, srec⟩ := spec x origin hx u uIn uScr []
  have hF : run (StairSchedule.forwardSegment p B B' ℓ e) [] u = v := by
    apply State.extensionality
    · exact sph
    · funext r
      by_cases hB' : r ∈ futurePayload B'
      · rw [scmp r hB']
        exact (h1 r hB').symm
      · by_cases hB : r ∈ futurePayload B
        · rw [srec r hB hB']
          exact (h2 r hB hB').symm
        · by_cases hs : r ∈ scratchT B B'
          · rw [sscr r hs]
            exact (h3 r hs).symm
          · rw [sout r hB hs]
            exact uOut r hB
  have back : run (StairSchedule.reverseSegment p B B' ℓ e) m v = u := by
    rw [← hF]
    exact trip x origin hx u uIn uScr [] m
  rw [back]
  exact ⟨rfl, fun r hr _ => uOut r hr, uScr, uIn⟩





end ECDSAAdd.Entrant.StairExitLT24RSeg

end
end Merge_StairField2V3ExitRSeg_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitStepsR_at_Main` -/
section Merge_StairField2V3ExitStepsR_at_Main

/-!
# LT43: the steps of `ExitPlanR` from pure staircase facts and record facts

* `rsegR` — reverse segment `B' → B` from LT24's pure mirror spec `RSegSpecT`
  (= `rspec_of_spec` of LT21/LT42's `SegSpecT` and the row round trip `RowTripT`)
  and the record fact that the multiplication reference state carries the
  transcript on `futurePayload B` and is clean on `scratchT B B'`.
* `junctionR` — the exit junction from the division last step in LT21's
  "pure spec + record predicate" form (`lastSpec`), the terminal round trip on the
  same states, and the record fact that the multiplication reference state after
  `headE` satisfies the predicate and carries the transcript on `futurePayload 12`.
* `closeR` — the close from the generic row-425 junction (`selJ0` vs `refJ0` on
  any admissible tick-424 state), the first-row round trip, LT24's record round
  trip `close_record_trip`, and the record fact that the multiplication reference
  state at row 425 is a `refJ0` image of an admissible state.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3ExitStepsR

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairField2V3Delta StairField2V3Seg StairField2V3ExitPlanR
open StairPhysicalLayout StairOuterPlacement

/-! ## Reverse segments -/


theorem rsegR (p : StairSchedule.StairPrimitives) (k x B B' ℓ e : Nat) (Y : Program)
    (sub : ∀ r ∈ futurePayload B', r ∈ futurePayload B)
    (rspec : StairExitLT24RSeg.RSegSpecT p B B' ℓ e)
    (rec : RowRecE k x B B' Y) :
    CRel (RowRelE k x B' Y) (RelX x B) (rseg p B B' ℓ e) [] := by
  rintro s t ⟨⟨⟨hph, hout⟩, _, _, hv⟩, hreach⟩ fresh
  obtain ⟨origin, hx, hrec, hscr⟩ := rec t hreach
  refine ⟨[], ?_⟩
  change RelX x B (run (liftF (StairSchedule.reverseSegment p B B' ℓ e)) fresh s) t
  rw [liftF_run]
  have notB' : ∀ r, r ∉ futurePayload B → r ∉ futurePayload B' := fun r hr h => hr (sub r h)
  have h1 : ∀ r ∈ futurePayload B', (pullIn s).basis r = cmpBits B' x r := fun r hr => (hv r hr).2
  have h2 : ∀ r ∈ futurePayload B, r ∉ futurePayload B' → (pullIn s).basis r = recVal origin r := by
    intro r hr hr'
    change s.basis (fieldPlace r) = _
    rw [hout _ (not_mem_Δv B' r hr')]
    exact hrec r hr
  have h3 : ∀ r ∈ scratchT B B', (pullIn s).basis r = false := by
    intro r hr
    change s.basis (fieldPlace r) = _
    rw [hout _ (not_mem_Δv B' r (notB' r (StairExitLT24RSeg.scratch_not_fut B B' r hr)))]
    exact hscr r hr
  obtain ⟨sph, sout, sscr, scmp⟩ := rspec x origin hx (pullIn s) h1 h2 h3 fresh
  set v' := run (StairSchedule.reverseSegment p B B' ℓ e) fresh (pullIn s) with hv'
  have pull : ∀ r, (pullOut v').basis (fieldPlace r) = v'.basis r := by
    intro r
    change v'.basis (fieldPlaceInv (fieldPlace r)) = v'.basis r
    rw [inv_fieldPlace]
  refine ⟨⟨?_, ?_⟩, origin, hx, ?_⟩
  · change v'.phase = t.phase
    rw [sph]
    exact hph
  · intro q hq
    rw [← fieldPlace_inv q, pull]
    set r := fieldPlaceInv q
    have hq' : fieldPlace r ∉ Δv B := by rw [fieldPlace_inv]; exact hq
    have hr : r ∉ futurePayload B := fun h => hq' (mem_Δv B r h)
    by_cases hs : r ∈ scratchT B B'
    · rw [sscr r hs]
      exact (hscr r hs).symm
    · rw [sout r hr hs]
      exact hout _ (not_mem_Δv B' r (notB' r hr))
  · intro r hr
    exact ⟨hrec r hr, (pull r).trans (scmp r hr)⟩

/-! ## Exit junction -/


/-- Terminal round trip on the states of the last step (pure, same shape as
`EntryPlanV3d.lastSpec`). -/
def LastTrip (Φ : BasisState → Prop) : Prop :=
  ∀ s t, AgreeOutside (Δv 12) s t → Cv 12 s.basis t.basis → Φ t.basis →
    ∀ c a, run StairExitLT24.WT a (run StairExitLT24.FT c s) = s

/- LT47: the unpinned exit junction was removed: on the defect-2-fixed program the
selected setup sits between two windows and is not an unconditional involution; the
pinned junction is `StairField2V3Field2R.junctionRX`. -/

/-! ## Close -/

/-- The generic row-425 junction: on every admissible state, the selected first pack
and the record walk end + terminal + clear + setup + X are related at row 425. -/
def JunctionG (p : StairSchedule.StairPrimitives) (x : Nat) (Adm : State → Prop) : Prop :=
  ∀ t0, Adm t0 → ∀ c c', RelX x 87 (run (selJ0 p) c t0) (run refJ0 c' t0)

theorem closeR (p : StairSchedule.StairPrimitives) (k x : Nat) (Adm : State → Prop)
    (junc : JunctionG p x Adm)
    (firstTrip : ∀ t0, Adm t0 → ∀ c a, run (closeSel p) a (run (selJ0 p) c t0) = t0)
    (refTrip : ∀ t0, Adm t0 → ∀ c a, run closeRef a (run refJ0 c t0) = t0)
    (rec : ∀ t, ReachE k x YF t → ∃ t0 c, Adm t0 ∧ t = run refJ0 c t0) :
    CRel (RowRelE k x 87 YF) Eq (closeSel p) closeRef := by
  rintro s t ⟨hrel, hreach⟩ fresh
  obtain ⟨t0, c, h0, rfl⟩ := rec t hreach
  have hs : s = run (selJ0 p) [] t0 := relX_unique x 87 s _ _ hrel (junc t0 h0 [] c)
  refine ⟨[], ?_⟩
  rw [hs, firstTrip t0 h0 [] fresh, refTrip t0 h0 c []]


end ECDSAAdd.Entrant.StairField2V3ExitStepsR

end
end Merge_StairField2V3ExitStepsR_at_Main

