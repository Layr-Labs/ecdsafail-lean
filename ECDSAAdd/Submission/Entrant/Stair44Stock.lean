    have hD : StairExitLT24.xRelabelInv q ∉ fullD 87 := fun h =>
      hq (List.mem_map.mpr ⟨_, List.mem_append_right _ h, StairExitLT24.xRelabel_inv q⟩)
    rw [e1]
