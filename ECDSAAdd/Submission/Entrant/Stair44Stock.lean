    · have nw : ∀ x ∈ r, w ≠ x := fun x hx heq => wr (heq ▸ hx)
      have hout : (run (otailL tr yc y2c e xr1 xr2 y0 c f g O D H t1 t2 u h) m s).basis w = s.basis w :=
        L.2.2 w (fun q hq heq => wr (by
