* `tick_link` — the `tick` link of `rowPieces_chain` / `termPieces` (tick 500);
* `middle_link` — the nonterminal middle trip from the decoded checkpoint
  (through `middle_trip_local`, virtual stage from `StairFirstTickV3.middle_virtual_provider`);
* `rowPieces_chain_decoded` — `rowPieces_chain` with its two impossible
  premises (`tick`, genuine `middle` stage) replaced by `Decoded` after `unpack B`;
* `terminal_middle_link`, `termChain_of` — the terminal row: links 2 and 3 of
  `termPieces` are discharged; links 1 (codec) and 4 (terminal blocks) remain.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairFirstTickV3Exit

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField
open StairField2V3ExitAlgebra StairField2V3ExitRowTrips StairPhysicalLayout StairExitLT24
open StairFirstTickV3 (Decoded RealHyp budget_range)


/-- First-moved-tick round trip in the provider's names. -/
theorem tick_link (B : Nat) (hB : B ∈ budgets) (x : Nat) (hx0 : 0 < x) (hx : x < p)
    (hcop : x.Coprime p) (y : State) (hy : Decoded B x p y.basis) (c a : List Bool) :
    run (P.tickReverse (startFor B)) a (run (P.tickForward (startFor B)) c y) = y :=
  StairFirstTickV3.tick_trip B hB x p (realHyp x hx0 hx hcop) y hy c a

/-- Nonterminal moved middle trip right after the first moved tick. -/
theorem middle_link (B : Nat) (hB : B ∈ budgets) (hfix : B ≠ 12) (x : Nat) (hx0 : 0 < x)
    (hx : x < p) (hcop : x.Coprime p) (y : State) (hy : Decoded B x p y.basis)
    (c2 : List Bool) (n : Nat) (bound : startFor B + 1 + n ≤ 512) (c a : List Bool) :
    run (P.middleReverse (startFor B + 1) n) a
        (run (P.middleForward (startFor B + 1) n) c (run (P.tickForward (startFor B)) c2 y)) =
      run (P.tickForward (startFor B)) c2 y := by
  have hs := budget_range B hB
  obtain ⟨t', hph, hag, st⟩ := StairFirstTickV3.middle_virtual_provider B hB x p
    (realHyp x hx0 hx hcop) y hy c2 n bound
  have eR : P.middleReverse (startFor B + 1) n =
      StairPhysicalPrimitives.middleReverse (startFor B + 1) n := by
    show StairPhysicalPrimitivesFix505.middleReverseFix _ n = _
    exact StairPhysicalPrimitivesFix505.middleReverseFix_eq _ n
      (by rw [hs.2.2.2.2.2]; exact hfix)
  refine middle_trip_local B (startFor B + 1) n hB hs.2.2.2.2.2 (by omega) bound x hx0 hx hcop
    hfix _ ⟨t', hph, fun q hq => hag q ?_, st⟩ c a
  rw [eR] at hq
  exact hq

/-- `rowPieces_chain` at row start `s = startFor B`, with the first-moved-tick
and middle premises discharged from the decoded checkpoint after `unpack B`. -/
theorem rowPieces_chain_decoded (B B' f : Nat) (hB : B ∈ budgets) (hB' : B' ∈ budgets)
    (hfix : B ≠ 12) (bound : startFor B + 1 + (f - startFor B - 1) ≤ 512)
    (hf5 : 5 < f) (hfm : f % 5 = 0) (hf : f ≤ 511)
    (hn : (skywalkPoolWires base).Nodup)
    (specB : StairCodec.FunctionalSpec (physicalLayout B) B)
    (specB' : StairCodec.FunctionalSpec (physicalLayout B') B')
    (x : Nat) (hx0 : 0 < x) (hx : x < p) (hcop : x.Coprime p) (x0 : State)
    (code0 : ∃ u v sigma, StairCodec.CodecDomain B u v sigma ∧
      StairCodec.CompactCode (physicalLayout B) B u v sigma (run (unrelocate B) [] x0).basis)
    (dec : ∀ c1, Decoded B x p (run (P.unpack B) c1 x0).basis)
    (legal : ∀ c1 c2 c3 c4, MeasuredCodec5.legalAt (History5.historyMap base (f - 5))
      (pullState (OB5.sig f) (run (P.orient f) c4
        (run (P.middleForward (startFor B + 1) (f - startFor B - 1)) c3
        (run (P.tickForward (startFor B)) c2 (run (P.unpack B) c1 x0))))).basis)
    (code6 : ∀ c1 c2 c3 c4 c5, ∃ u v sigma, StairCodec.CodecDomain B' u v sigma ∧
      StairCodec.CodecInput (physicalLayout B') B' u v sigma
        (run (StairPhysicalPrimitives.signExt B') []
          (run (renameProgram (OB5.sig f) (Rolling1588.Integer.packFirst base true f)) c5
            (run (P.orient f) c4
              (run (P.middleForward (startFor B + 1) (f - startFor B - 1)) c3
              (run (P.tickForward (startFor B)) c2 (run (P.unpack B) c1 x0)))))).basis)
    (orientLink : ∀ c1 c2 c3 c a, run (P.orientR f) a (run (P.orient f) c
        (run (P.middleForward (startFor B + 1) (f - startFor B - 1)) c3
          (run (P.tickForward (startFor B)) c2 (run (P.unpack B) c1 x0)))) =
      run (P.middleForward (startFor B + 1) (f - startFor B - 1)) c3
        (run (P.tickForward (startFor B)) c2 (run (P.unpack B) c1 x0))) :
    TripChain (rowPieces B B' (startFor B) f) x0 := by
  obtain ⟨u0, v0, sg0, dom0, cc0⟩ := code0
  refine ⟨fun c a => unpack_trip B hB u0 v0 sg0 specB dom0 x0 c a cc0, fun c1 =>
    ⟨fun c a => tick_link B hB x hx0 hx hcop _ (dec c1) c a, fun c2 =>
      ⟨fun c a => middle_link B hB hfix x hx0 hx hcop _ (dec c1) c2 _ bound c a, fun c3 =>
        ⟨fun c a => orientLink c1 c2 c3 c a, fun c4 =>
          ⟨packet_trip f hf5 hfm hf hn _ (legal c1 c2 c3 c4), fun c5 =>
            ⟨?_, fun _ => trivial⟩⟩⟩⟩⟩⟩
  intro c a
  obtain ⟨u, v, sg, dom, inp⟩ := code6 c1 c2 c3 c4 c5
  exact pack_trip B' hB' u v sg specB' dom _ c a inp


/-- Terminal row, `termPieces` link 2 (tick 500). -/
theorem tick500_link (x : Nat) (hx0 : 0 < x) (hx : x < p) (hcop : x.Coprime p)
    (y : State) (hy : Decoded 12 x p y.basis) (c a : List Bool) :
    run (P.tickReverse 500) a (run (P.tickForward 500) c y) = y :=
  tick_link 12 budget12 x hx0 hx hcop y hy c a

/-- Terminal row, `termPieces` link 3 (moved middle 501..504). -/
theorem terminal_middle_link (x : Nat) (hx0 : 0 < x) (hx : x < p) (hcop : x.Coprime p)
    (y : State) (hy : Decoded 12 x p y.basis) (c2 c a : List Bool) :
    run (StairReplay.movedReverse wRev 501 4) a
        (run (P.middleForward 501 4) c (run (P.tickForward 500) c2 y)) =
      run (P.tickForward 500) c2 y := by
  obtain ⟨t', hph, hag, st⟩ := StairFirstTickV3.middle_virtual 12 budget12 x p
    (realHyp x hx0 hx hcop) y hy c2 4 (by decide)
  have eF : P.middleForward 501 4 =
      StairReplay.movedForward (StairPhysicalPrimitives.midSegmentMap 12) 501 4 := by
    show StairPhysicalPrimitives.middleForward 501 4 = _
    unfold StairPhysicalPrimitives.middleForward
    rw [segmentOf_501]
  refine terminal_middle_trip x hx0 hx hcop _ ⟨t', hph, fun q hq => hag q ?_, st⟩ c a
  rw [eF, terminal_middle_maps] at hq
  exact hq

/-- The terminal trip chain: links 2 and 3 discharged from `Decoded 12`; the
codec link and the terminal-block link stay explicit. -/
theorem termChain_of (x : Nat) (hx0 : 0 < x) (hx : x < p) (hcop : x.Coprime p) (x0 : State)
    (unpackTrip : ∀ c a, run (P.pack 12) a (run (P.unpack 12) c x0) = x0)
    (dec : ∀ c1, Decoded 12 x p (run (P.unpack 12) c1 x0).basis)
    (terminal : ∀ c1 c2 c3 c a,
      run (StairTerminalV3.reverseTerminalV3 ++ StairReplay.movedReverse wRev 505 1) a
        (run StairTerminalV3.forwardTerminalV3 c
          (run (P.middleForward 501 4) c3 (run (P.tickForward 500) c2 (run (P.unpack 12) c1 x0)))) =
        run (P.middleForward 501 4) c3 (run (P.tickForward 500) c2 (run (P.unpack 12) c1 x0))) :
    TripChain termPieces x0 :=
  ⟨unpackTrip, fun c1 => ⟨tick500_link x hx0 hx hcop _ (dec c1), fun c2 =>
    ⟨terminal_middle_link x hx0 hx hcop _ (dec c1) c2, fun c3 =>
      ⟨terminal c1 c2 c3, fun _ => trivial⟩⟩⟩⟩

end ECDSAAdd.Entrant.StairFirstTickV3Exit

end
end Merge_StairFirstTickV3Exit_at_Main

