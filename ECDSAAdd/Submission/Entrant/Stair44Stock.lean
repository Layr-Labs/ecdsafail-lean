/-- **Terminal row round trip in tail coordinates, arbitrary shadow labels.** -/
theorem trip_tail (x : Nat) (hx0 : 0 < x) (hxp : x < ECDSAAdd.p) (u : State)
    (pre1 : ∀ r ∈ futurePayload 12, u.basis r = cmpBits 12 x r)
    (preC : ∀ r ∈ CT, r ∉ futurePayload 12 → u.basis r = false) (c a : List Bool) :
    run (StairSchedule.reverseLast StairExitLT24.P) a
      (run (StairSchedule.forwardLast StairExitLT24.P) c u) = u := by
  obtain ⟨-, -, -, lC, lP⟩ := low12
  have zh : ∀ q, q < base 4000 → (zeroHigh u).basis q = u.basis q := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = u.basis q
    rw [if_neg (Nat.not_le.mpr hq)]
  have pre1' : ∀ r ∈ futurePayload 12, (zeroHigh u).basis r = cmpBits 12 x r :=
    fun r hr => (zh r (lP r hr)).trans (pre1 r hr)
  have preC' : ∀ r ∈ CT, r ∉ futurePayload 12 → (zeroHigh u).basis r = false :=
    fun r hr hf => (zh r (lC r hr)).trans (preC r hr hf)
  have hsh : ∀ q, base 4000 ≤ q → (zeroHigh u).basis q = false := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = false
    rw [if_pos hq]
  have trip0 := trip_clean x hx0 hxp (zeroHigh u) pre1' preC' hsh c a
  set F := StairSchedule.forwardLast StairExitLT24.P with hFdef
  set R := StairSchedule.reverseLast StairExitLT24.P with hRdef
  have hF : ∀ q ∈ wires F, q < base 4000 := by
    rw [hFdef]
    exact fwd_low
  have hR : ∀ q ∈ wires R, q < base 4000 := by
    rw [hRdef]
    exact rev_low
  obtain ⟨pA, aA, hA⟩ := StairField2V3TripLT42.low_pair F hF c u (zeroHigh u)
    (fun q hq => (zh q hq).symm)
  obtain ⟨pB, aB, hB⟩ := StairField2V3TripLT42.low_pair R hR a (run F c u)
    (run F c (zeroHigh u)) aA
  apply State.extensionality
  · have e1 : (run R a (run F c (zeroHigh u))).phase = u.phase := by
      have h := congrArg State.phase trip0
      exact h
    have pA' : ((run F c u).phase ^^ u.phase) = ((run F c (zeroHigh u)).phase ^^ u.phase) := pA
    revert pA' pB e1
    generalize (run R a (run F c u)).phase = r1
    generalize (run R a (run F c (zeroHigh u))).phase = r0
    generalize (run F c u).phase = a1
    generalize (run F c (zeroHigh u)).phase = a0
    generalize u.phase = w
    cases r1 <;> cases r0 <;> cases a1 <;> cases a0 <;> cases w <;> simp
  · funext q
    by_cases hq : base 4000 ≤ q
    · rw [hB q hq, hA q hq]
    · have hq' := Nat.not_le.mp hq
      rw [aB q hq', trip0]
      exact zh q hq'

