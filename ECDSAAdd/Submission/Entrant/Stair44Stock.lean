  have zh : ∀ q, q < base 4000 → (zeroHigh u).basis q = u.basis q := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = u.basis q
    rw [if_neg (Nat.not_le.mpr hq)]
