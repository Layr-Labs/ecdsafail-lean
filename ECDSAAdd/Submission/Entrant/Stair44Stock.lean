    rw [hFdef]
    exact seg_low B B' hpair
  have hR : ∀ q ∈ wires R, q < base 4000 := by
    rw [hRdef]
    exact rev_low B B' hpair
  obtain ⟨pA, aA, hA⟩ := low_pair F hF c u (zeroHigh u) (fun q hq => (zh q hq).symm)
  obtain ⟨pB, aB, hB⟩ := low_pair R hR a (run F c u) (run F c (zeroHigh u)) aA
