  rw [kbRSw_id (show x ≠ 527 by omega) (show x ≠ 741 by omega),
    kbRSw_id (show x ≠ 737 by omega) (show x ≠ 739 by omega),
    kbRSw_id (show x ≠ 738 by omega) (show x ≠ 740 by omega),
    kbRSw_id (show x ≠ 1813 by omega) (show x ≠ 527 by omega),
    kbRSw_id (show x ≠ 1042 by omega) (show x ≠ 737 by omega),
    kbRSw_id (show x ≠ 1557 by omega) (show x ≠ 738 by omega),
    kbRSw_id (show x ≠ 1558 by omega) (show x ≠ 736 by omega)]

