      (hist_facts 0 84 r (by omega) (by omega)).2)
  have legalRaw : ∀ i : Fin 5,
      (raw.basis (History5.historyMap base 420 ⟨2 * i.val, by omega⟩) &&
        raw.basis (History5.historyMap base 420 ⟨2 * i.val + 1, by omega⟩)) = false := by
    intro i
