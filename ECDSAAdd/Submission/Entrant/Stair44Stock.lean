        have ut : (u || !x.1) = true := by
          revert hu; cases u <;> cases x.1 <;> decide
        have noSwap : (xs.take n).any Prod.snd = false :=
          LeavePendingHistory.initialTrue xs (ut ▸ ok.2) n
        rw [noSwap, Bool.xor_false, Bool.or_false]

