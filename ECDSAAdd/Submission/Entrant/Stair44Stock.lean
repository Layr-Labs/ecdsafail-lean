/-- Record terminal clear followed by the record multiplication terminal
blocks (the `StairPrimitives.reverseTerminal` default). -/
def reverseRecord : Program :=
  skywalkArithmeticClear base ++
    (renameProgram (OB5.sig 511) tickR ++
      renameProgram (OB5.sig 510)
        (Rolling1588.unpackAtTick true 510 ++ InverseFive23.candidate15))



/-- `StairPrimitives.reverseTerminal` for CANON v3. -/
def reverseTerminalV3 : Program := renameProgram terminalPerm reverseRecord




/-! ## Helpers -/






/-! ## Exact counts (δT = 0, δM = 0 against the record terminal blocks) -/











/-- δT = δM = 0 for the multiplication terminal. -/
theorem reverseTerminalV3_counts_eq :
    toffoliCount reverseTerminalV3 =
        toffoliCount (renameProgram (OB5.sig 511) tickR ++
          renameProgram (OB5.sig 510)
            (Rolling1588.unpackAtTick true 510 ++ InverseFive23.candidate15)) ∧
