set_option maxHeartbeats 8000000 in
/-- Hosted `rest_pw` on the caller domain. -/
theorem hosted_rest_pwD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hX : ExitSupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (k cx X Y : Fp) (G : Bool) (origin : BasisState) (s : State)
    (hs : PointDialogValues L X Y G origin s.basis)
    (hx : X-(if G then Y*Y else 0)+(if G then (SquareCarryLoan719BF.K:Fp) else 0)+
      (if G then k else 0)≠0) (d r : List Bool) :
    run (StairConcreteAssembly.hostedExitRest L cx.val) r (run (squareEntry L k) d s) =
      put (run (restXX L cx.val) r (run (squareEntry L k) d s)) (pkW L)
        (G && decide (cx.val < (X-(if G then Y*Y else 0)+
          (if G then (SquareCarryLoan719BF.K:Fp) else 0)+(if G then k else 0)).val)) := by
  let Z:=X-(if G then Y*Y else 0)+(if G then (SquareCarryLoan719BF.K:Fp) else 0)
  have square:=SquareCarryLoan719BF.step L hw hn X Y G origin
  have add:=fastStep_addX L hw hn Z Y G origin k
  obtain ⟨-,vW⟩ := (square.seq add) s [] hs
  generalize hwd : run (SquareCarryLoan719BF.program L++fastConstAdd L L.point.x k) [] s = w at vW
  have eu : run (squareEntry L k) d s = run (E1QubitPlacement.tickF L) [] w := by
    rw [squareEntry_base L hw hn k X Y G origin s d [] hs, run_append, ← hwd]
    simp only [List.take_nil, List.drop_nil]
  have hpos : 0 < (Z+(if G then k else 0)).val :=
    Nat.pos_of_ne_zero (fun hz => hx ((ZMod.val_eq_zero _).mp hz))
  have e1 := hostedExitN_pwD H hX L hw hn cx.val cx.isLt (Z+(if G then k else 0)).val Y.val
    (ZMod.val_lt _) hpos (ZMod.val_lt _) w
    (pfx (measurementCount (E1QubitPlacement.tickF L)) [] ++ r) vW.x vW.y vW.clean
  rw [StairCallerReplay.hosted_exit_split, exit_splitX, run_pre, run_pre, ← eu, vW.generic,
    pk_wire] at e1
  exact e1

set_option maxHeartbeats 8000000 in
/-- The hosted and the record multiplication stages agree on every state the
record's generic stage reaches, for a constructed record tape (caller domain). -/
theorem secondStage_eqD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hX : ExitSupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (k cy cx X Y : Fp) (G : Bool) (origin : BasisState) (s : State)
    (hs : PointDialogValues L X Y G origin s.basis)
    (hx : X-(if G then Y*Y else 0)+(if G then (SquareCarryLoan719BF.K:Fp) else 0)+
      (if G then k else 0)≠0) (m : List Bool) :
    ∃ m', run (StairConcreteAssembly.hostedSecondStage L k cy cx) m s =
      run (secondStageN L k cy cx) m' s := by
  have h := StairCallerGeneric.mid_replay2
    (StairSquareFinal.squareEntryHL StairSqLoopA.holes L k) (squareEntry L k)
    (StairConcreteAssembly.hostedExitRest L cx.val)
    (restXXN L cx.val) (exitYAll L cy) s m (fun a b => by
      rw [StairSquareFinal.squareEntryHL_base StairSqLoopA.holes (List.Sublist.refl _) L hw hn k X Y G
          origin s a [] hs,
        squareEntry_base L hw hn k X Y G origin s b [] hs]) (by
      intro a b
      rw [hosted_rest_pwD H hX L hw hn k cx X Y G origin s hs hx a b,
        rest_pw L hw hn k cx X Y G origin s hs hx a b])
  simpa only [StairConcreteAssembly.hostedSecondStage, secondStageN, List.append_assoc]
    using h

end Second

