    exact (StairLoanRecordExitKernel.shapeExitKernel_run_eq half endpoint k s hs m []).trans
      (StairLoanRecordExitKernel.shapeExitKernel_run_eq half endpoint k s hs n []).symm
  intro m n
  rw [hr]
  exact nested_tapeFree _ _ s kfree r m r n


