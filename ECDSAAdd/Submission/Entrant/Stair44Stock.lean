/-- The new square never touches the control wire. -/
theorem square_control (hl : List Wire) (hsub : hl.Sublist StairSqLoopA.holes) (k : Fp) :
    Baselines.layout.control ∉ wires (squareEntryHL hl Baselines.layout k) := by
  rw [squareEntryHL_layout]
  obtain ⟨rC, rB, rA⟩ := record_branches_control
  have bA := (StairSquareBodyOK.bodyA_ok hl hsub).support
  have bB := (StairSqBodyB.bodyB_ok hl hsub).support
  have bC := (StairSquareBodyOK.bodyC_ok hl hsub).support
  have bB' : wires (StairSqBodyB.bodyB hl) ⊆ insert D0 (G0 :: K0.wires).toFinset :=
    fun q hq => Finset.mem_insert_of_mem (bB hq)
  intro h
  unfold square squareN placedN at h
  rw [wires_append, Finset.mem_union] at h
  rcases h with h | h
  · rw [placed_wires, Finset.mem_image] at h
    obtain ⟨y, hy, e⟩ := h
    have ey : y = L0.control := placeFn_inj (e.trans placeFn_control.symm)
    subst ey
    simp only [coreN, wires_append, Finset.mem_union] at hy
    rcases hy with (hy | hy) | hy
    · rcases Finset.mem_union.mp (StairSquareKernel26C.kC_support hl _ hy) with h' | h'
      · rcases Finset.mem_union.mp (recBrC_split _ C105SignResearch.body h') with h'' | h''
        · exact rC h''
        · exact control_not_bodyImage _ bC h''
      · exact hostsK_control h'
    · rcases Finset.mem_union.mp (StairSquareKernel26C.kB_support hl _ hy) with h' | h'
      · rcases Finset.mem_union.mp (recBrB_split' _ B95PaddedResearch.body h') with h'' | h''
        · exact rB h''
        · exact control_not_bodyImage _ bB' h''
      · exact hostsK_control h'
    · rcases Finset.mem_union.mp (StairSquareKernel26C.kA_support hl _ hy) with h' | h'
      · rcases Finset.mem_union.mp (recBrA_split _ A109SignResearch.body h') with h'' | h''
        · exact rA h''
        · exact control_not_bodyImage _ bA h''
      · exact hostsK_control h'
  · exact entryRH_control _ h

