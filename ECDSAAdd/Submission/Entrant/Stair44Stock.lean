      (MF base b0 0 Y 0 false false false false) := by
  intro G par H K Y
  have hn:=base_pool_nodup
  have hg:=E1QubitPlacement.g2400
  obtain ⟨a1,a2,a3,a5,a6,a7,a8⟩ := archX k X hk hX G
