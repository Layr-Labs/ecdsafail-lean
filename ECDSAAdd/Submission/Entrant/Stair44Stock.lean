      C105SignResearch.body) := by
    intro h
    apply sq.1
    change L0.control ∈ wires (SquareCarryLoan719BF.place L0 _)
    rw [placed_wires]
    exact Finset.mem_image.mpr ⟨_, h, placeFn_control⟩
  rw [fastCore_eq, branchBF760_rec] at core
  simp only [wires_append, Finset.mem_union, not_or] at core
  exact ⟨core.1.1, core.1.2, core.2⟩


