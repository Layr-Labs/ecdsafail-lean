  obtain ⟨Y0', hY0'⟩ : ∃ Y : State,
      Y = ⟨Y0.phase, fun q => if q = cSite 83 then false else Y0.basis q⟩ := ⟨_, rfl⟩
  have v1 : ∀ q, q ≠ cSite 83 → Y0'.basis q = Y0.basis q := by
    intro q h
    rw [hY0']
    show (if q = cSite 83 then false else Y0.basis q) = _
