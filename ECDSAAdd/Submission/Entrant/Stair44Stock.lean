    (k : Fp) : StairSiteAvoidance.PieceOK holes StairSiteAvoidance.UG (square StairSqLoopA.holes k) :=
  ⟨(square39_pieceOK k).1, fun x hx hh => (square39_pieceOK k).2 x hx (hsub _ hh)⟩

