set_option maxHeartbeats 8000000 in
theorem hostedEntryRest_controlD (hE : EntrySupportD) :
    layout.control ∉ wires (StairConcreteAssembly.hostedEntryRest layout) := by
  intro h
  have sub : wires (StairConcreteAssembly.hostedEntryRest layout) ⊆
      wires (FrontierEntry1591Callers.entry (StairHostsSchedule.entryKernel
        StairConcreteAssembly.checkpointPrimitives StairConcreteAssembly.hostPlan) layout) := by
    rw [StairCallerReplay.hosted_entry_split, wires_append]
    exact Finset.subset_union_right
  have hk := sub h
  rw [FrontierEntry1591Callers.entry, renameProgram_support] at hk
  obtain ⟨q, hq, he⟩ := Finset.mem_image.mp hk
  exact control_not_caller_image layout layout_widths layout_nodup q (hE hq) he

set_option maxHeartbeats 8000000 in
theorem hostedExitRest_controlD (hX : ExitSupportD) (k : Nat) :
    layout.control ∉ wires (StairConcreteAssembly.hostedExitRest layout k) := by
  intro h
  have sub : wires (StairConcreteAssembly.hostedExitRest layout k) ⊆
      wires (FrontierEntry1591Callers.exit (StairHostsSchedule.exitKernel
        StairConcreteAssembly.checkpointPrimitives StairConcreteAssembly.hostPlan k) layout) := by
    rw [StairCallerReplay.hosted_exit_split, wires_append]
    exact Finset.subset_union_right
  have hk := sub h
  rw [FrontierEntry1591Callers.exit, renameProgram_support] at hk
  obtain ⟨q, hq, he⟩ := Finset.mem_image.mp hk
  exact control_not_caller_image layout layout_widths layout_nodup q (hX k hq) he

set_option maxHeartbeats 8000000 in
theorem hostedGeneric_controlD (hE : EntrySupportD) (hX : ExitSupportD) (cx cy : Fp) :
    layout.control ∉ wires (StairConcreteAssembly.hostedGeneric layout cx cy) := by
  have hg := ControlSupportDevelop.genericN_control cx cy
  simp only [FlagExit.genericN, FlagExit.secondStageN, wires_append, Finset.mem_union,
    not_or] at hg
  simp only [StairConcreteAssembly.hostedGeneric, StairConcreteAssembly.hostedSecondStage,
    wires_append, Finset.mem_union, not_or]
  exact ⟨⟨hg.1.1, hostedEntryRest_controlD hE⟩, ⟨⟨StairSquareFinal.square_control _ (List.Sublist.refl _) _, hostedExitRest_controlD hX _⟩, hg.2.2⟩⟩

set_option maxHeartbeats 8000000 in
theorem hostedGenericBlock_controlD (hE : EntrySupportD) (hX : ExitSupportD) (cx cy : Fp) :
    layout.control ∉ wires (StairConcreteAssembly.hostedGenericBlock cx cy) := by
  unfold StairConcreteAssembly.hostedGenericBlock
  rw [renameProgram_support]
  intro h
  obtain ⟨q,hq,he⟩:=Finset.mem_image.mp h
  have hc:FlagTop.rho layout layout.control=layout.control:=by decide +kernel
  have eq:=FlagTop.rho_injective (he.trans hc.symm)
  exact hostedGeneric_controlD hE hX cx cy (eq ▸ hq)
end Control

