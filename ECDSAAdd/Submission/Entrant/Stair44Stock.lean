theorem refRem_best_tapeFree (half : StairLoanRecordShape.HalfReplayHypothesis)
    (endpoint : StairEndpointLoan44.MultiplicationRunSpec44) (k : Nat) (t : State)
    (ht : StairField2V3Core.ExitMiddle k t) :
