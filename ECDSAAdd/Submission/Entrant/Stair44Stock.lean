  rw [run_muxAnd aL el xlo U V heU hlU hlV hUV heV]
  rw [run_xorAcc a V mid (fun x hx => (tm x hx).2.1)]
  rw [run_muxAnd aH eh xhi V F hEV hhV hhF hVF hEF]
  rw [run_xorAcc a F top (fun x hx => (tt x hx).2.2)]
