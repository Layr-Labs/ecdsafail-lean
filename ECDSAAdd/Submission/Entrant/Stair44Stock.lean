theorem routed_counts (j : Fin 26) (a n : Nat) (bound : a+n≤15) :
    toffoliCount (Shadow7.routed j a n)=n*(2*(Shadow7.smallBits j+16)) ∧
    measurementCount (Shadow7.routed j a n)=n*(Shadow7.smallBits j+16) ∧
    toffoliCount (Shadow7.unrouted j a n)=n*(2*(Shadow7.smallBits j+16)-1) ∧
    measurementCount (Shadow7.unrouted j a n)=n*(Shadow7.smallBits j+16) := by
  obtain ⟨f,r⟩ := Shadow7.fixed_route j a n bound
  have hs := IntegerPacket.metrics (Shadow7.shape j) a n bound
  have hr := IntegerPacket.metricsR (Shadow7.shape j) a n bound
  have mid : (Shadow7.shape j).mid+1=Shadow7.smallBits j+16 := rfl
  rw [mid] at hs hr
  rw [f,r,(renameProgram_counts _ _).1,(renameProgram_counts _ _).2,(renameProgram_counts _ _).1,
    (renameProgram_counts _ _).2]
  exact ⟨hs.1, hs.2.1, hr.1, hr.2⟩

