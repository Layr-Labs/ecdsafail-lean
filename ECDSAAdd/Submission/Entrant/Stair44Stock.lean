 let t:=run (head++B95LowEraseResearch.clear) m s
 have te:t=B95LowEraseResearch.erase u:=prefix_erased s m hz hb hi ha
 have hH:H<2^128:=by simpa only [H,source_length] using regValue_lt src s.basis
