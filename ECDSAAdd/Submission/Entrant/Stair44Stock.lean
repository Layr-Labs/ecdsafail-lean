/-! ## Physicality -/


theorem reverseRecord_physical : GatePhysical reverseRecord := by
  have cl : GatePhysical (skywalkArithmeticClear base) := gatePhysical_of_all _ (by decide +kernel)
  have tr : GatePhysical (renameProgram (OB5.sig 511) tickR) :=
