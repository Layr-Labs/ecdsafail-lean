theorem apart_move {s : Nat} (w1 : 45 ≤ s) (w2 : s ≤ 405) : MoveChain.apart (e0P s + 6) (moveRows s) = true := by
  have cl := cell_lt w1 w2
  unfold MoveChain.apart
  rw [List.all_eq_true]; intro r hr
  obtain ⟨i, hi, rfl⟩ := mem_moveRows hr
