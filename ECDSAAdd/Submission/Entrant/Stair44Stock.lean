def PiOK (P : Program) : Prop := ∀ b ∈ wires P, PPI (ParityXExitInverse23Kernel.pi b)


theorem piOK_of_all {P : Program}
    (h : allSites (fun b => decide (PPI (ParityXExitInverse23Kernel.pi b))) P = true) :
    PiOK P :=
  fun b hb => of_decide_eq_true (allSites_sound h b hb)



