  set F := StairSchedule.forwardSegment StairConcreteAssembly.checkpointPrimitives B B'
    (startFor B) (startFor B') with hFdef
  set R := StairSchedule.reverseSegment StairConcreteAssembly.checkpointPrimitives B B'
    (startFor B) (startFor B') with hRdef
