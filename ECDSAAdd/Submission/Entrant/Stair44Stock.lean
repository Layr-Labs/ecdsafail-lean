    rw [h, fS_map]
    exact fa
  have hb : signedRegValue (fullD 87) Y0'.basis =
      (StairBridgeDomain.realRails x ECDSAAdd.p (startFor 87)).b := by
    have h : signedRegValue ((List.range 88).map bSite) Y0'.basis =
