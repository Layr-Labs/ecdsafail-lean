section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Pack

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack

/-! ## Moves -/




/-! ## Bits from register values -/



/-! ## Row data -/





/-! K6 (replay budget): the row facts as one Boolean pass per row (bit masks for the
memberships, `nodupMask` for the `Nodup`s), sound for every `B`; only the Boolean is decided. -/








/-! ## Codec input depends only on the declared sites -/



/-- **Packing at a row start stores `cmpBits`.** -/
theorem stored_after_pack (B : Nat) (hB : B ∈ budgets) (x : Nat)
    (hx0 : 0 < x) (hx : x < ECDSAAdd.p) (u : State)
    (hin : StairCodec.CodecInput (physicalLayout B) B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)) u.basis)
    (hext : u.basis (bSite B) = u.basis ((physicalLayout B).D (B - 1)))
    (hrest : ∀ r ∈ futurePayload B, r ∉ restLetters B → r ∉ aReg B → r ≠ bSite B →
      r ∉ cleanList B → u.basis r = false)
    (m : List Bool) :
    (run (StairPhysicalPrimitives.pack B) m u).phase = u.phase ∧
    (∀ r ∈ futurePayload B, (run (StairPhysicalPrimitives.pack B) m u).basis r = cmpBits B x r) ∧
    (run (StairPhysicalPrimitives.pack B) m u).basis (bSite B) = false ∧
    (∀ q ∈ cleanList B, (run (StairPhysicalPrimitives.pack B) m u).basis q = false) ∧
    (∀ i, i < B → (run (StairPhysicalPrimitives.pack B) m u).basis ((physicalLayout B).D i) = false) ∧
    (run (StairPhysicalPrimitives.pack B) m u).basis ((physicalLayout B).S (B - 1)) = false ∧
    (∀ q, q ∉ StairCodec.declaredSites (physicalLayout B) B → q ∉ moveSites (relocPairs B) →
      q ≠ bSite B → (run (StairPhysicalPrimitives.pack B) m u).basis q = u.basis q) := by
  obtain ⟨⟨h3, h87, hnod, hrest', hrestN, haN, hbS, hbD, hbA, hbC, hbM, hDb, hD2, hS1⟩,
    ⟨haF, hcM, hfp⟩⟩ := packFacts B hB
  have hdom := domain_row B hB x hx0 hx
  have hbDecl : bSite B ∉ StairCodec.declaredSites (physicalLayout B) B := by
    rw [declared_eq]
    intro h
    rcases h with h | h | h | h
    · exact hbS h
    · exact hbD h
    · exact hbA h
    · exact hbC h
  -- signExt
  unfold StairPhysicalPrimitives.pack StairPhysicalPrimitives.signExt
  rw [run_append, run_append]
  set m1 := m.take (measurementCount (StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B) ++
    StairCodec.pack (physicalLayout B) B))
  set m3 := m.drop (measurementCount (StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B) ++
    StairCodec.pack (physicalLayout B) B))
  set v1 := run (StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B))
    (m1.take (measurementCount (StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B)))) u
    with hv1
  obtain ⟨ph1, hb1, out1⟩ := StairBridgeSign.signExtend_run ((physicalLayout B).D (B - 1)) (bSite B) u
    (m1.take (measurementCount (StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B))))
  have b1 : v1.basis (bSite B) = false := by
    rw [hb1, hext]; simp
  have in1 : StairCodec.CodecInput (physicalLayout B) B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B)) v1.basis :=
    codecInput_congr _ _ _ _ _ _ _ (fun q hq => (out1 q (fun e => hbDecl (e ▸ hq))).symm) hin
  -- codec pack
  have functional : StairCodec.FunctionalSpec (physicalLayout B) B :=
    StairCodecFunctionalV3.codecFunctionalSpec B (budget_mem_checkpoints B hB)
  have spec := functional.2.2 _ _ _ hdom (physicalLayout_nodup B hB)
  set v2 := run (StairCodec.pack (physicalLayout B) B)
    (m1.drop (measurementCount (StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B)))) v1
    with hv2
  obtain ⟨ph2, cc⟩ := spec.1 v1 _ in1
  have out2 : ∀ q, q ∉ StairCodec.declaredSites (physicalLayout B) B → v2.basis q = v1.basis q :=
    fun q hq => run_preserves_outside _ _ _ q (fun h => hq (List.mem_toFinset.mp
      (StairCodec.pack_support _ _ h3 h)))
  obtain ⟨cA, cD, cD2, cD1, cS, cW⟩ := cc
  -- relocation
  have hS0 : ∀ i (hi : i < B), v2.basis ((physicalLayout B).S i) = false := by
    intro i hi
    have h := bits_of_regValue _ _ _ cS i (by rw [reg_length']; exact hi)
    rw [reg_getElem, Nat.zero_testBit] at h
    exact h
  have ok := moveOK_of_nodup _ hnod
  have targets : ∀ q ∈ relocPairs B, v2.basis q.2 = false := by
    intro q hq
    simp only [relocPairs, List.mem_append, List.mem_map, List.mem_range, List.mem_singleton] at hq
    rcases hq with ⟨i, hi, rfl⟩ | rfl
    · exact hS0 i (by omega)
    · exact hS0 (B - 2) (by omega)
  rw [relocate_eq]
