/-! ## Reverse segments -/


theorem rsegR (p : StairSchedule.StairPrimitives) (k x B B' ℓ e : Nat) (Y : Program)
    (sub : ∀ r ∈ futurePayload B', r ∈ futurePayload B)
    (rspec : StairExitLT24RSeg.RSegSpecT p B B' ℓ e)
    (rec : RowRecE k x B B' Y) :
    CRel (RowRelE k x B' Y) (RelX x B) (rseg p B B' ℓ e) [] := by
  rintro s t ⟨⟨⟨hph, hout⟩, _, _, hv⟩, hreach⟩ fresh
  obtain ⟨origin, hx, hrec, hscr⟩ := rec t hreach
  refine ⟨[], ?_⟩
  change RelX x B (run (liftF (StairSchedule.reverseSegment p B B' ℓ e)) fresh s) t
  rw [liftF_run]
  have notB' : ∀ r, r ∉ futurePayload B → r ∉ futurePayload B' := fun r hr h => hr (sub r h)
  have h1 : ∀ r ∈ futurePayload B', (pullIn s).basis r = cmpBits B' x r := fun r hr => (hv r hr).2
  have h2 : ∀ r ∈ futurePayload B, r ∉ futurePayload B' → (pullIn s).basis r = recVal origin r := by
    intro r hr hr'
    change s.basis (fieldPlace r) = _
    rw [hout _ (not_mem_Δv B' r hr')]
    exact hrec r hr
  have h3 : ∀ r ∈ scratchT B B', (pullIn s).basis r = false := by
    intro r hr
    change s.basis (fieldPlace r) = _
    rw [hout _ (not_mem_Δv B' r (notB' r (StairExitLT24RSeg.scratch_not_fut B B' r hr)))]
    exact hscr r hr
  obtain ⟨sph, sout, sscr, scmp⟩ := rspec x origin hx (pullIn s) h1 h2 h3 fresh
  set v' := run (StairSchedule.reverseSegment p B B' ℓ e) fresh (pullIn s) with hv'
  have pull : ∀ r, (pullOut v').basis (fieldPlace r) = v'.basis r := by
    intro r
    change v'.basis (fieldPlaceInv (fieldPlace r)) = v'.basis r
    rw [inv_fieldPlace]
  refine ⟨⟨?_, ?_⟩, origin, hx, ?_⟩
  · change v'.phase = t.phase
    rw [sph]
    exact hph
  · intro q hq
    rw [← fieldPlace_inv q, pull]
    set r := fieldPlaceInv q
    have hq' : fieldPlace r ∉ Δv B := by rw [fieldPlace_inv]; exact hq
    have hr : r ∉ futurePayload B := fun h => hq' (mem_Δv B r h)
    by_cases hs : r ∈ scratchT B B'
    · rw [sscr r hs]
      exact (hscr r hs).symm
    · rw [sout r hr hs]
      exact hout _ (not_mem_Δv B' r (notB' r hr))
  · intro r hr
    exact ⟨hrec r hr, (pull r).trans (scmp r hr)⟩

/-! ## Exit junction -/


/-- Terminal round trip on the states of the last step (pure, same shape as
`EntryPlanV3d.lastSpec`). -/
def LastTrip (Φ : BasisState → Prop) : Prop :=
  ∀ s t, AgreeOutside (Δv 12) s t → Cv 12 s.basis t.basis → Φ t.basis →
    ∀ c a, run StairExitLT24.WT a (run StairExitLT24.FT c s) = s

/- LT47: the unpinned exit junction was removed: on the defect-2-fixed program the
selected setup sits between two windows and is not an unconditional involution; the
pinned junction is `StairField2V3Field2R.junctionRX`. -/

/-! ## Close -/

/-- The generic row-425 junction: on every admissible state, the selected first pack
and the record walk end + terminal + clear + setup + X are related at row 425. -/
def JunctionG (p : StairSchedule.StairPrimitives) (x : Nat) (Adm : State → Prop) : Prop :=
  ∀ t0, Adm t0 → ∀ c c', RelX x 87 (run (selJ0 p) c t0) (run refJ0 c' t0)

theorem closeR (p : StairSchedule.StairPrimitives) (k x : Nat) (Adm : State → Prop)
    (junc : JunctionG p x Adm)
    (firstTrip : ∀ t0, Adm t0 → ∀ c a, run (closeSel p) a (run (selJ0 p) c t0) = t0)
    (refTrip : ∀ t0, Adm t0 → ∀ c a, run closeRef a (run refJ0 c t0) = t0)
    (rec : ∀ t, ReachE k x YF t → ∃ t0 c, Adm t0 ∧ t = run refJ0 c t0) :
    CRel (RowRelE k x 87 YF) Eq (closeSel p) closeRef := by
  rintro s t ⟨hrel, hreach⟩ fresh
  obtain ⟨t0, c, h0, rfl⟩ := rec t hreach
  have hs : s = run (selJ0 p) [] t0 := relX_unique x 87 s _ _ hrel (junc t0 h0 [] c)
  refine ⟨[], ?_⟩
  rw [hs, firstTrip t0 h0 [] fresh, refTrip t0 h0 c []]


end ECDSAAdd.Entrant.StairField2V3ExitStepsR

