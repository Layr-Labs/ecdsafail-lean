  have e1:(PortalValues.negative sg z.u).toNat≤1:=by cases PortalValues.negative sg z.u <;> decide
  have eu:(PortalValues.negative sg z.u).toNat≤z.u:=by
    by_cases hz:0<z.u
    · omega
