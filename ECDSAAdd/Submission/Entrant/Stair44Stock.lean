/-! # LT40 U6: arena half of field 12 for the new square

The record's site chain for the placed square is generic in the A and C bodies (given the record's
`coarse`/`fine` support shapes).  We re-run it for arbitrary bodies, add the bridge "record site and not an
old pool index ⇒ inside the arena and not an old omission after `UG`", and conclude the arena half of
`PieceOK` for the placed new core from a support inclusion into the record-shaped core plus explicit hosts. -/

section

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairSquareSites

open ECDSAAdd Arithmetic Arithmetic.CuccaroStreamedSquareWideLayout ControlledPointLayout Challenge Baselines
  StairSquareContract StairSquareAssembly

attribute [local irreducible] ECDSAAdd.run ECDSAAdd.wires

/-! ## Hole freedom of the placed new core -/

theorem UG_inj : Function.Injective StairSiteAvoidance.UG := by
  intro a b h
  unfold StairSiteAvoidance.UG at h
  exact FlagTop.rho_injective ((Equiv.swap _ _).injective ((Wrapper5.U Baselines.layout).injective h))

/-- Hole freedom of the placed core from hole avoidance of the unplaced core. -/
theorem placedN_holesFree (hs : List Wire) (hsub : ∀ q ∈ hs, q ∈ StairCertificate.holes39)
    (brC brB brA : Program) (hav : ∀ q ∈ hs, q ∉ wires (coreN brC brB brA)) :
    StairSiteAvoidance.HolesFree hs StairSiteAvoidance.UG (placedN brC brB brA) := by
  intro x hx hxh
  have hq := hsub _ hxh
  rw [StairSquareEntryR.holes39_eq] at hq
  have fx : StairSiteAvoidance.UG (StairSiteAvoidance.UG x) = StairSiteAvoidance.UG x :=
    StairSquareEntryR.UG_fixes_holes39 _ hq
  have ex : x = StairSiteAvoidance.UG x := UG_inj fx.symm
  unfold placedN at hx
  rw [placed_wires, Finset.mem_image] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  have e2 := placeFn_fixes _ hq
  have ey : y = StairSiteAvoidance.UG (placeFn y) := placeFn_inj (ex.trans e2.symm)
  rw [ey] at hy
  exact hav _ hxh hy

/-- Field 12 piece `square` for the new square, given the arena half for the placed core. -/
theorem squareN_pieceOK (hs : List Wire) (hsub : ∀ q ∈ hs, q ∈ StairCertificate.holes39)
    (brC brB brA : Program) (k : Fp) (hav : ∀ q ∈ hs, q ∉ wires (coreN brC brB brA))
    (harena : StairSiteAvoidance.ArenaOld StairSiteAvoidance.UG (placedN brC brB brA)) :
    StairSiteAvoidance.PieceOK hs StairSiteAvoidance.UG (squareN brC brB brA k) :=
  StairSiteAvoidance.PieceOK.append ⟨harena, placedN_holesFree hs hsub brC brB brA hav⟩
    (StairSquareEntryR.entryRH_pieceOK hs hsub _)

section Chain

variable (A C : Program)
  (ac : wires A ⊆ insert (layout.core.poolWire 1540)
    (layout.core.generic :: layout.dialogStreamedSquareWide.wires).toFinset)
  (af : wires A ⊆ insert (layout.core.poolWire 1540) (wires (InverseCarryDevelop.hostedADual
    layout.dialogStreamedSquareWide (LowZero18Square.foldPerm layout.dialogStreamedSquareWide
      (OwnDiagAll12Square.kext layout)) layout.core.generic)))
  (cf : wires C ⊆ insert C163Low4Middle.d
    (wires (OwnDiagAll12Square.bodyCKTq C163Low4Middle.L C163Low4Middle.g)))
include ac af cf





theorem sis_sites : wires (SumInnerSparseB95Square.program layout A C) ⊆ (OB5Support.sites layout).toFinset := by
  have h := SumInnerSparseB95Ledger.program_support layout layout_widths layout_nodup A C
  intro q hq
  rcases Finset.mem_union.mp (h hq) with used | extra
  · exact c163_sites A C ac af cf (B95ProgramBalanceResearch.program_subset _ _ _ used)
  · exact SumInnerSparseExtraFacts.within_sites extra

theorem sis_free (i : Nat) (hi : i ∈ [1800,766,765,767,770,1285,1286,769,768,718,719]) :
    layout.core.poolWire i ∉ wires (SumInnerSparseB95Square.program layout A C) := by
  have h := SumInnerSparseB95Ledger.program_support layout layout_widths layout_nodup A C
  have hret : i ∈ SumInnerSparseExtraFacts.retired := by
    simp only [SumInnerSparseExtraFacts.retired, List.mem_cons, List.not_mem_nil, or_false] at hi ⊢
    tauto
  intro hq
  rcases Finset.mem_union.mp (h hq) with used | extra
  · exact c163_free A C ac af cf i hi (B95ProgramBalanceResearch.program_subset _ _ _ used)
  · exact SumInnerSparseExtraFacts.free i hret extra

theorem sis_retired : layout.core.poolWire 760 ∉ wires (SumInnerSparseB95Square.program layout A C) := by
  have h := SumInnerSparseB95Ledger.program_support layout layout_widths layout_nodup A C
  intro hq
  rcases Finset.mem_union.mp (h hq) with used | extra
  · exact c163_retired A C ac af cf (B95ProgramBalanceResearch.program_subset _ _ _ used)
  · exact SumInnerSparseExtraFacts.free 760 (by simp [SumInnerSparseExtraFacts.retired]) extra

theorem ss_sites : wires (SumSavedB95Square.program layout A C) ⊆ (OB5Support.sites layout).toFinset := by
  have h := SumSavedB95Ledger.program_support layout layout_widths layout_nodup A C
  exact fun q hq => sis_sites A C ac af cf (h hq)

theorem ss_free (i : Nat) (hi : i ∈ [1800,766,765,767,770,1285,1286,769,768,718,719,760]) :
    layout.core.poolWire i ∉ wires (SumSavedB95Square.program layout A C) := by
  have h := SumSavedB95Ledger.program_support layout layout_widths layout_nodup A C
  by_cases h760 : i = 760
  · subst h760
    exact fun hq => sis_retired A C ac af cf (h hq)
  · have hi' : i ∈ [1800,766,765,767,770,1285,1286,769,768,718,719] := by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hi ⊢
      omega
    exact fun hq => sis_free A C ac af cf i hi' (h hq)

end Chain

/-! ## Bridge: record generic-level sites are good physical sites after `UG` -/

theorem bridge (y : Wire) (hy : y ∈ (OB5Support.sites layout).toFinset)
    (hb : ∀ i ∈ bad12, layout.core.poolWire i ≠ y) :
    StairSiteAvoidance.UG y ∈ StairHoleSupport.recordArena ∧
      StairSiteAvoidance.UG y ∉ StairHoleSupport.oldHoles := by
  have t := List.all_eq_true.mp bridge_all y (List.mem_toFinset.mp hy)
  have nb : ¬ y ∈ bad12.map layout.core.poolWire := by
    intro h
    obtain ⟨i, hi, e⟩ := List.mem_map.mp h
    exact hb i hi e
  simp only [bridgeB, nb, decide_false, Bool.false_or, Bool.and_eq_true, decide_eq_true_eq] at t
  rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq]
  exact t

/-- Arena half for any program whose wires are wires of a record-shaped placed square. -/
theorem arena_of_ss (A C : Program)
    (ac : wires A ⊆ insert (layout.core.poolWire 1540)
      (layout.core.generic :: layout.dialogStreamedSquareWide.wires).toFinset)
    (af : wires A ⊆ insert (layout.core.poolWire 1540) (wires (InverseCarryDevelop.hostedADual
      layout.dialogStreamedSquareWide (LowZero18Square.foldPerm layout.dialogStreamedSquareWide
        (OwnDiagAll12Square.kext layout)) layout.core.generic)))
    (cf : wires C ⊆ insert C163Low4Middle.d
      (wires (OwnDiagAll12Square.bodyCKTq C163Low4Middle.L C163Low4Middle.g)))
    (y : Wire) (hy : y ∈ wires (SumSavedB95Square.program layout A C)) :
    StairSiteAvoidance.UG y ∈ StairHoleSupport.recordArena ∧
      StairSiteAvoidance.UG y ∉ StairHoleSupport.oldHoles := by
  apply bridge y (ss_sites A C ac af cf hy)
  intro i hi e
  exact ss_free A C ac af cf i hi (e ▸ hy)

/-! ## Arena half for the placed new core -/






/-! ## B branch with a non-record body: absolute check of the body image -/


theorem bodyB_image_good (B : Program) (hsup : wires B ⊆ (G0 :: K0.wires).toFinset)
    (hnf : K0.core.normFlag ∉ wires B) :
    ∀ y ∈ ((wires B).image (R2SqEp760.sqSwap K0 E0)).image (LowZero18Square.foldPerm K0 E0),
      StairSiteAvoidance.UG (placeFn y) ∈ StairHoleSupport.recordArena ∧
        StairSiteAvoidance.UG (placeFn y) ∉ StairHoleSupport.oldHoles := by
  intro y hy
  simp only [Finset.mem_image] at hy
  obtain ⟨z, ⟨x, hx, rfl⟩, rfl⟩ := hy
  have t := List.all_eq_true.mp bodyGood_all x (List.mem_toFinset.mp (hsup hx))
  have nf : ¬ x = K0.core.normFlag := fun e => hnf (e ▸ hx)
  simp only [bodyGoodB, nf, decide_false, Bool.false_or, Bool.and_eq_true, decide_eq_true_eq] at t
  rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq]
  exact t

theorem host_good (n : Nat) (h1 : 654 ≤ n) (h2 : n < 685) :
    StairSiteAvoidance.UG (placeFn (L0.core.poolWire n)) ∈ StairHoleSupport.recordArena ∧
      StairSiteAvoidance.UG (placeFn (L0.core.poolWire n)) ∉ StairHoleSupport.oldHoles := by
  have t := List.all_eq_true.mp hosts_all n (by simp only [List.mem_range'_1]; omega)
  simp only [hostGoodB, Bool.and_eq_true, decide_eq_true_eq] at t
  rw [StairPhysicalLayout.recordArena_eq, StairPhysicalLayout.oldHoles_eq]
  exact t

/-- Arena half for the placed new core, B body checked absolutely. -/
theorem placedN_arenaB (A' B' C' brC brB brA : Program) (hosts : List Wire)
    (ac : wires A' ⊆ insert (layout.core.poolWire 1540)
      (layout.core.generic :: layout.dialogStreamedSquareWide.wires).toFinset)
    (af : wires A' ⊆ insert (layout.core.poolWire 1540) (wires (InverseCarryDevelop.hostedADual
      layout.dialogStreamedSquareWide (LowZero18Square.foldPerm layout.dialogStreamedSquareWide
        (OwnDiagAll12Square.kext layout)) layout.core.generic)))
    (cf : wires C' ⊆ insert C163Low4Middle.d
      (wires (OwnDiagAll12Square.bodyCKTq C163Low4Middle.L C163Low4Middle.g)))
    (bsup : wires B' ⊆ (G0 :: K0.wires).toFinset) (bnf : K0.core.normFlag ∉ wires B')
    (sC : wires brC ⊆ wires (recBrC C') ∪ hosts.toFinset)
    (sB : wires brB ⊆ wires (recBrB B') ∪ hosts.toFinset)
    (sA : wires brA ⊆ wires (recBrA A') ∪ hosts.toFinset)
    (hostsGood : ∀ h ∈ hosts, StairSiteAvoidance.UG (placeFn h) ∈ StairHoleSupport.recordArena ∧
      StairSiteAvoidance.UG (placeFn h) ∉ StairHoleSupport.oldHoles) :
    StairSiteAvoidance.ArenaOld StairSiteAvoidance.UG (placedN brC brB brA) := by
  intro x hx
  unfold placedN at hx
  rw [placed_wires, Finset.mem_image] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  have recG (z : Wire) (hz : z ∈ wires (SumSavedB95Square.fastCore L0 A' C')) :
      StairSiteAvoidance.UG (placeFn z) ∈ StairHoleSupport.recordArena ∧
        StairSiteAvoidance.UG (placeFn z) ∉ StairHoleSupport.oldHoles := by
    apply arena_of_ss A' C' ac af cf
    change placeFn z ∈ wires (SquareCarryLoan719BF.place L0 (SumSavedB95Square.fastCore L0 A' C'))
    rw [placed_wires]
    exact Finset.mem_image_of_mem _ hz
  have inCore {z : Wire} (hz : z ∈ wires (recBrC C') ∨
      z ∈ wires (B95PortResearch.branchBF760 K0 E0 G0) ∨ z ∈ wires (recBrA A')) :
      z ∈ wires (SumSavedB95Square.fastCore L0 A' C') := by
    simp only [SumSavedB95Square.fastCore, SumSavedB95Core.core, wires_append, Finset.mem_union]
    rcases hz with h | h | h
    · exact Or.inl (Or.inl h)
    · exact Or.inl (Or.inr h)
    · exact Or.inr h
  simp only [coreN, wires_append, Finset.mem_union] at hy
  rcases hy with (h | h) | h
  · rcases Finset.mem_union.mp (sC h) with h' | h'
    · exact recG y (inCore (Or.inl h'))
    · exact hostsGood y (List.mem_toFinset.mp h')
  · rcases Finset.mem_union.mp (sB h) with h' | h'
    · have hs := recBrB_split B' (B95SelectorResearch.hostedSelectedBody K0 (LowZero18Square.foldPerm K0 E0) G0) h'
      rcases Finset.mem_union.mp hs with h'' | h''
      · exact recG y (inCore (Or.inr (Or.inl h'')))
      · exact bodyB_image_good B' bsup bnf y h''
    · exact hostsGood y (List.mem_toFinset.mp h')
  · rcases Finset.mem_union.mp (sA h) with h' | h'
    · exact recG y (inCore (Or.inr (Or.inr h')))
    · exact hostsGood y (List.mem_toFinset.mp h')

end ECDSAAdd.Entrant.StairSquareSites

