/-! ## Multiplication -/

/-- LT47: the exit junction on the fixed program.  `firstSel = SXW ++ WT`; `SXW` takes
the record state to `sxState`, which is `FT` of the partner, and `WT` undoes `FT`. -/
theorem junctionRX (k x : Nat) (rec : JuncRecE k x (lastΦx x)) :
    CRel (JEX k x) (RelX x 12) (firstSel StairExitLT24.P) [] := by
  rintro s t ⟨hst, hR⟩ fresh
  subst hst
  obtain ⟨hΦ, origin, ho, hv⟩ := rec s hR
  have hσ := partner_rel x 12 s origin ho hv
  set σ := partner x 12 s
  have eF : firstSel StairExitLT24.P = StairField2V3Win.SXW ++ StairExitLT24.WT := by
    simp only [firstSel, StairField2V3Win.SXW, StairExitLT24.WT, StairExitLT24.wrap, liftF,
      List.append_assoc]
  have hFT : StairExitLT24.FT = liftF (StairSchedule.forwardLast StairExitLT24.P) := by
    simp only [StairExitLT24.FT, StairExitLT24.wrap, liftF]
  have ft : run StairExitLT24.FT [] σ = StairField2V3Win.sxState (StairField2V3LastSpec.s510 x) s := by
    rw [hFT]
    exact StairField2V3LastSpec.ftSpec_pinned x σ s hσ.1 hσ.2 hΦ []
  have key : run (StairField2V3Win.SXW ++ StairExitLT24.WT) fresh s = σ := by
