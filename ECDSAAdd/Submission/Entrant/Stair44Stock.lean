      run (SquareCarryLoan719BF.program L ++ fastConstAdd L L.point.x k ++ E1QubitPlacement.tickF L)
        m2 s := by
  by_cases h : L = Baselines.layout
  · subst h
    rw [squareEntryH_layout]
    exact squareN_base A' B' C' brC brB brA hA hB hC kC kB kA k X Y G origin s m1 m2 v
  · have e : squareEntryH brC brB brA L k = A161Generic.squareEntry L k := by
      unfold squareEntryH
      exact if_neg h
