theorem primitiveSlots_v3 (K : PrimitiveChecks) :
    PrimitiveSlots StairConcreteAssembly.checkpointPrimitives where
  pack B hB := by
    rw [cp_pack]
    exact ⟨K.packPhysical B hB, good_pack_row B hB⟩
  unpack B hB := by
    rw [cp_unpack]
    exact ⟨K.unpackPhysical B hB, good_unpack_row B hB⟩
  orient f hf := by
    rw [cp_orient]
    exact StairField2V3End.orientF_sound_f f hf (K.orient f hf)
  orientR f hf := by
    rw [cp_orientR]
    exact K.orient f hf
  tickForward s hs := by
    rw [cp_tickForward]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
    rcases hs with rfl | rfl | rfl | rfl | rfl | rfl
    · exact sound_tickForward_row 87 (by decide)
    · exact sound_tickForward_row 62 (by decide)
    · exact sound_tickForward_row 47 (by decide)
    · exact sound_tickForward_row 32 (by decide)
    · exact sound_tickForward_row 22 (by decide)
    · exact sound_tickForward_row 12 (by decide)
  tickReverse s hs := by
