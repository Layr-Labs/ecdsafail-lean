    generalize (run R a (run F c (zeroHigh u))).phase = r0
    generalize (run F c u).phase = a1
    generalize (run F c (zeroHigh u)).phase = a0
    generalize u.phase = w
    cases r1 <;> cases r0 <;> cases a1 <;> cases a0 <;> cases w <;> simp
