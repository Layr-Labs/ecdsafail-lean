  (ParityXEntry.evenTail_wires k).trans (tailX_tight base (base 2400) k)




/-- The placed x-tail map in closed form (`UG ∘ pmapR = kernelPlace ∘ sig ∘ rho`). -/
theorem xplace_fast (q : Wire) : UG (E1QubitPlacement.pmapR Baselines.layout q) =
    StairPlaceFast.kernelPlaceB (e1B q) := by
  rw [← e1_eq, ← StairPlaceFast.kernelPlace_eqB]; rfl


/-! K4-B (replay budget): `xList_good` by affine intervals.  On each interval of the x-tail labels
every literal exchange of `e1B` / `kernelPlaceB` is the identity and `pwB` is one interval shift,
so goodness is proved symbolically; only a dozen exceptional labels are evaluated. -/















/-- LT46 (replay budget): decided on the closed form (43 s → ≈ 2 s).  K4-B: symbolic on the
affine intervals (`kbXI1` .. `kbXI5`), only the exceptional labels are evaluated. -/
theorem xList_good : ∀ q ∈ xList, Good39 (UG (E1QubitPlacement.pmapR Baselines.layout q)) := by
  have key : ∀ q ∈ xList, good39B (StairPlaceFast.kernelPlaceB (e1B q)) = true := by
    intro q hq
    unfold xList tSites at hq
    rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · rcases List.mem_append.mp hq with hq | hq
        · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
          have hi' := List.mem_range'_1.mp hi
          exact kbXI1 i (by omega) (by omega)
        · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
          have hi' := List.mem_range'_1.mp hi
          rcases Nat.lt_or_ge i 1026 with h | h
          · exact kbXI2 i (by omega) h
          · rcases Nat.lt_or_ge i 1027 with h' | h'
            · obtain rfl : i = 1026 := by omega
              decide
            · exact kbXI3 i h' (by omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range'_1.mp hi
        rcases Nat.lt_or_ge i 1543 with h | h
        · have : i = 1540 ∨ i = 1541 ∨ i = 1542 := by omega
          rcases this with rfl | rfl | rfl <;> decide
        · rcases Nat.lt_or_ge i 1656 with h' | h'
          · exact kbXI4 i h h'
          · rcases Nat.lt_or_ge i 1657 with h'' | h''
            · obtain rfl : i = 1656 := by omega
              decide
            · rcases Nat.lt_or_ge i 1796 with h3 | h3
              · exact kbXI5 i h'' h3
              · have : i = 1796 ∨ i = 1797 := by omega
                rcases this with rfl | rfl <;> decide
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl | rfl <;> decide
  intro q hq
  rw [xplace_fast]
  exact good39_of_B (key q hq)

theorem pk_good : Good39 (UG (FlagEntry.pkW Baselines.layout)) := by
  -- K4-B (replay budget): on the closed form `ugB`
  have hu : UG (FlagEntry.pkW Baselines.layout) =
      StairPlaceFast.ugB (FlagEntry.pkW Baselines.layout) := StairPlaceFast.ug_eqB _
  rw [hu]
