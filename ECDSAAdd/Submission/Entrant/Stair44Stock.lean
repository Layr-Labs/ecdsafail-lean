     have hr:=masks_image_I (.some hc) s m h0 h1 h2 h3 hx hY
     simpa [-WeierstrassCurve.Affine.Point.neg_some,formatX,formatY,hH,ControlSentinelDevelop.tag,hn0,Ne.symm hcn,Ne.symm hen] using hr
   · subst R
     have hflags := hf
