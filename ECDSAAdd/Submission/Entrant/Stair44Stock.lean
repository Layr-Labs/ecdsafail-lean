/- m16-leave (margin 16, glue G2): the long latch with a program inside the chain. -/
section
namespace ECDSAAdd.Entrant.StairPacket.PortalAnd
open Arithmetic RecordedQuantum
open List

/-- Glue G2 as instructions (`GateMirror.forward` of `.ccx side top out, .make far rec tmp, .ccx tmp top out,
.pop far rec tmp`). -/
def orFlag (side far rec tmp top out : Wire) : Program :=
  [.CCX side top out, .CCX far rec tmp, .CCX tmp top out, .measureX tmp [] [.CZ far rec]]

/-- `chain` without enable, with `mid top` run right after the innermost target (`top` = the innermost AND wire). -/
def chainMid (inverted : Bool) (out a : Wire) (mid : Wire → Program) : List (Wire × Wire) → Program
  | [] => target inverted none a out ++ mid a
  | (x, t) :: rest => [.CCX a x t] ++ chainMid inverted out t mid rest ++ [.measureX t [] [.CZ a x]]

/-- `latch` with `mid` inside the chain. -/
def latchMid (reverseOrder : Bool) (out a : Wire) (ps : List (Wire × Wire)) (mid : Wire → Program) : Program :=
  let ds := digits a ps
  notRegister ds ++ chainMid true out a mid ps ++ notRegister (if reverseOrder then ds.reverse else ds)

set_option linter.unusedSimpArgs false in
set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
theorem run_orFlag (side far rec tmp top out : Wire)
    (sT : side ≠ tmp) (fT : far ≠ tmp) (rT : rec ≠ tmp) (sO : side ≠ out) (fO : far ≠ out) (rO : rec ≠ out)
    (tT : top ≠ tmp) (tO : top ≠ out) (oT : out ≠ tmp)
    (m : List Bool) (s : State) (clean : s.basis tmp = false) :
    run (orFlag side far rec tmp top out) m s =
      ⟨s.phase, writeBit s.basis out (s.basis out ^^ (s.basis top && (s.basis side ^^ (s.basis far && s.basis rec))))⟩ := by
  have key : ∀ o a f r t : Bool, (o ^^ (a && t) ^^ (f && r && t)) = (o ^^ (t && (a ^^ (f && r)))) := by decide
  have pk : ∀ p f r : Bool, (p ^^ (f && r) ^^ (f && r)) = p := by decide
  simp only [orFlag, run, measureAndCorrect, writeBit, Function.update_self, Function.update_of_ne oT.symm,
    Function.update_of_ne fO, Function.update_of_ne rO, Function.update_of_ne oT, Function.update_of_ne tT,
    Function.update_of_ne tO, Function.update_of_ne fT, Function.update_of_ne rT, Function.update_of_ne sO, clean,
    Bool.false_xor]
  cases m.headD false <;>
    simp only [Bool.false_eq_true, Bool.true_and, Bool.false_and, Bool.xor_false, ite_true, ite_false, ↓reduceIte, correct,
      Function.update_self, Function.update_of_ne fT, Function.update_of_ne rT, Function.update_of_ne fO,
      Function.update_of_ne rO, pk] <;>
    (congr 1; funext q; by_cases qt : q = tmp <;> by_cases qo : q = out <;>
      simp only [Function.update, qt, qo, dif_pos, dif_neg, not_false_eq_true, eq_self_iff_true, oT, oT.symm, clean,
        dite_true, dite_false, key] <;> (try subst qt) <;> (try subst qo) <;> simp_all [key])

set_option linter.unusedSimpArgs false in
set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
/-- The chain with G2 inside: the chain's own effect on `out`, plus G2 read at the innermost AND (= `cut`). -/
theorem run_chainMid (inverted : Bool) (out a side far rec tmp : Wire) (pairs : List (Wire × Wire))
    (hn : (out :: a :: sites pairs).Nodup)
    (hs : side ∉ out :: a :: sites pairs) (hf : far ∉ out :: a :: sites pairs) (hr : rec ∉ out :: a :: sites pairs)
    (ht : tmp ∉ out :: a :: sites pairs) (sT : side ≠ tmp) (fT : far ≠ tmp) (rT : rec ≠ tmp)
    (m : List Bool) (s : State) (hc : ∀ p ∈ pairs, s.basis p.2 = false) (clean : s.basis tmp = false) :
    run (chainMid inverted out a (fun top => orFlag side far rec tmp top out) pairs) m s =
      ⟨s.phase, writeBit s.basis out (s.basis out ^^ (inverted ^^ cut a pairs s.basis) ^^
        (cut a pairs s.basis && (s.basis side ^^ (s.basis far && s.basis rec))))⟩ := by
  induction pairs generalizing a s m with
  | nil =>
    have ao : a ≠ out := Ne.symm (by simpa [sites] using hn)
    simp only [List.mem_cons, not_or, sites, List.flatMap_nil, List.not_mem_nil, not_false_eq_true, and_true] at hs hf hr ht
    simp only [chainMid, run_append, run_take]
    have t0 : run (target inverted none a out) m s =
        ⟨s.phase, writeBit s.basis out (s.basis out ^^ (inverted ^^ s.basis a))⟩ := by
      cases inverted <;> simp [target, run, writeBit, Function.update, ao] <;> funext q <;> by_cases h : q = out <;>
        simp [h, Function.update]
    rw [t0, run_orFlag side far rec tmp a out sT fT rT hs.1 hf.1 hr.1 (fun e => ht.2 e.symm) ao (fun e => ht.1 e.symm) _ _
      (by simp [writeBit, Function.update_of_ne (fun e : tmp = out => ht.1 e), clean])]
    simp only [writeBit, Function.update_self, Function.update_of_ne ao, Function.update_of_ne hs.1,
      Function.update_of_ne hf.1, Function.update_of_ne hr.1, Function.update_idem, cut, List.all_nil, Bool.and_true,
      Bool.xor_assoc]
  | cons p rest ih =>
    obtain ⟨x, t⟩ := p
    change (out :: a :: x :: t :: sites rest).Nodup at hn
    obtain ⟨oA, oX, oT, oR, aX, aT, aR, xT, xR, tR, ns⟩ :
        out ≠ a ∧ out ≠ x ∧ out ≠ t ∧ out ∉ sites rest ∧ a ≠ x ∧ a ≠ t ∧ a ∉ sites rest ∧
          x ≠ t ∧ x ∉ sites rest ∧ t ∉ sites rest ∧ (sites rest).Nodup := by simpa [and_assoc] using hn
    change side ∉ out :: a :: x :: t :: sites rest at hs
    change far ∉ out :: a :: x :: t :: sites rest at hf
    change rec ∉ out :: a :: x :: t :: sites rest at hr
    change tmp ∉ out :: a :: x :: t :: sites rest at ht
    simp only [List.mem_cons, not_or] at hs hf hr ht
    have htt : s.basis t = false := hc (x, t) (by simp)
    let v : State := ⟨s.phase, writeBit s.basis t (s.basis a && s.basis x)⟩
    have enter : run ([.CCX a x t] : Program) m s = v := by simp [run, htt, v]
    have v_get (q : Wire) (hq : q ≠ t) : v.basis q = s.basis q := by simp [v, writeBit, hq]
    have vt : v.basis t = (s.basis a && s.basis x) := by simp [v, writeBit]
    have tailSites (p : Wire × Wire) (hp : p ∈ rest) : p.1 ∈ sites rest ∧ p.2 ∈ sites rest := by
      constructor <;> exact List.mem_flatMap.mpr ⟨p, hp, by simp⟩
    have next := ih t (by simp [oT, oR, tR, ns])
      (by simp only [List.mem_cons, not_or]; exact ⟨hs.1, hs.2.2.2.1, hs.2.2.2.2⟩)
      (by simp only [List.mem_cons, not_or]; exact ⟨hf.1, hf.2.2.2.1, hf.2.2.2.2⟩)
      (by simp only [List.mem_cons, not_or]; exact ⟨hr.1, hr.2.2.2.1, hr.2.2.2.2⟩)
      (by simp only [List.mem_cons, not_or]; exact ⟨ht.1, ht.2.2.2.1, ht.2.2.2.2⟩)
      m v (fun p hp => by
        rw [v_get p.2 (fun h => tR (h ▸ (tailSites _ hp).2))]
        exact hc p (by simp [hp]))
      (by rw [v_get tmp ht.2.2.2.1]; exact clean)
    have bits : rest.all (fun p => v.basis p.1) = rest.all (fun p => s.basis p.1) := by
      apply Bool.eq_iff_iff.mpr
      simp only [List.all_eq_true]
      constructor <;> intro h p hp
      · rw [← v_get p.1 (fun eq => tR (eq ▸ (tailSites _ hp).1))]
        exact h p hp
      · rw [v_get p.1 (fun eq => tR (eq ▸ (tailSites _ hp).1))]
        exact h p hp
    have answer : cut t rest v.basis = cut a ((x, t) :: rest) s.basis := by
      simp [cut, vt, bits, Bool.and_assoc]
    simp only [chainMid, run_append, run_take]
    rw [enter]
    change run ([.measureX t [] [.CZ a x]] : Program) _
      (run (chainMid inverted out t (fun top => orFlag side far rec tmp top out) rest) m v) = _
    rw [next, v_get out oT, answer, v_get side hs.2.2.2.1, v_get far hf.2.2.2.1, v_get rec hr.2.2.2.1]
    generalize (s.basis out ^^ (inverted ^^ cut a ((x, t) :: rest) s.basis) ^^
      (cut a ((x, t) :: rest) s.basis && (s.basis side ^^ (s.basis far && s.basis rec)))) = z
    simp only [run]
    generalize (List.drop _ m).headD false = measurementBit
    cases measurementBit <;> simp [v, correct, measureAndCorrect, writeBit, Function.update, oT.symm,
      oA.symm, oX.symm, aT, xT] <;>
      funext q <;> by_cases qt : q = t <;> by_cases qo : q = out <;>
        simp_all [Function.update, writeBit]

private theorem itemsM (ps : List (Wire × Wire)) : ps.map Prod.fst <+ sites ps ∧ ps.map Prod.snd <+ sites ps := by
  induction ps with
  | nil => exact ⟨.slnil, .slnil⟩
  | cons p rest ih =>
    change p.1 :: rest.map Prod.fst <+ p.1 :: p.2 :: sites rest ∧
      p.2 :: rest.map Prod.snd <+ p.1 :: p.2 :: sites rest
    exact ⟨(ih.1.cons _).cons₂ _, (ih.2.cons₂ _).cons _⟩

private theorem crossM (ps : List (Wire × Wire)) (hn : (sites ps).Nodup) :
    ∀ p ∈ ps, p.2 ∉ ps.map Prod.fst := by
  induction ps with
  | nil => simp
  | cons r rs ih =>
    change (r.1 :: r.2 :: sites rs).Nodup at hn
    have ⟨ab, ar, br, n⟩ : r.1 ≠ r.2 ∧ r.1 ∉ sites rs ∧ r.2 ∉ sites rs ∧ (sites rs).Nodup := by simpa [and_assoc] using hn
    intro p hp
    rcases List.mem_cons.mp hp with rfl | hp
    · simpa using And.intro ab.symm (fun h => br ((itemsM rs).1.subset h))
    · have hm : p.2 ∈ sites rs := (itemsM rs).2.subset (List.mem_map.mpr ⟨p, hp, rfl⟩)
      simpa using And.intro (fun (e : p.2 = r.1) => ar (e ▸ hm)) (ih n p hp)

set_option linter.unusedSimpArgs false in
set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
/-- The long latch with G2 inside: `out ^= any ds ^^ (!any ds && (side xor (far && rec)))`; for `out = 0` that is
`any ds || (side xor (far && rec))`. -/
theorem run_latchMid (rev : Bool) (out a side far rec tmp : Wire) (ps : List (Wire × Wire))
    (hn : (out :: a :: sites ps).Nodup)
    (hs : side ∉ out :: a :: sites ps) (hf : far ∉ out :: a :: sites ps) (hr : rec ∉ out :: a :: sites ps)
    (ht : tmp ∉ out :: a :: sites ps) (sT : side ≠ tmp) (fT : far ≠ tmp) (rT : rec ≠ tmp)
    (s : State) (m : List Bool) (clean : ∀ p ∈ ps, s.basis p.2 = false) (ct : s.basis tmp = false) :
    run (latchMid rev out a ps (fun top => orFlag side far rec tmp top out)) m s =
      ⟨s.phase, writeBit s.basis out (s.basis out ^^ (digits a ps).any s.basis ^^
        (!(digits a ps).any s.basis && (s.basis side ^^ (s.basis far && s.basis rec))))⟩ := by
  have ds : digits a ps <+ a :: sites ps := (itemsM ps).1.cons₂ a
  have hp0 := List.nodup_cons.mp hn
  have ha := List.nodup_cons.mp hp0.2
  have nd : (digits a ps).Nodup := hp0.2.sublist ds
  have oo : out ∉ digits a ps := fun h => hp0.1 (ds.subset h)
  have off (w : Wire) (hw : w ∉ out :: a :: sites ps) : w ∉ digits a ps := fun h => hw (List.mem_cons_of_mem _ (ds.subset h))
  let b : BasisState := fun q => if q ∈ digits a ps then !s.basis q else s.basis q
  have tz (p : Wire × Wire) (hp : p ∈ ps) : b p.2 = false := by
    have subset : p.2 ∈ sites ps := (itemsM ps).2.subset (List.mem_map.mpr ⟨p, hp, rfl⟩)
    have no : p.2 ∉ digits a ps := by
      simpa [digits] using And.intro (fun (eq : p.2 = a) => ha.1 (eq ▸ subset)) (crossM _ ha.2 p hp)
    simp [b, no, clean p hp]
  have orCut : (!cut a ps b) = (digits a ps).any s.basis := by
    simp only [cut, digits, List.any_cons, Bool.not_and]
    have head : b a = !s.basis a := by simp [b, digits]
    rw [head, Bool.not_not]
    congr 1
    apply Bool.eq_iff_iff.mpr
    simp only [Bool.not_eq_true', List.all_eq_false, List.any_eq_true, List.mem_map]
    constructor
    · rintro ⟨p, hp, h⟩
      have inc : p.1 ∈ digits a ps := List.mem_cons_of_mem _ (List.mem_map.mpr ⟨p, hp, rfl⟩)
      exact ⟨_, ⟨p, hp, rfl⟩, by simpa [b, inc] using h⟩
    · rintro ⟨q, ⟨p, hp, rfl⟩, h⟩
      have inc : p.1 ∈ digits a ps := List.mem_cons_of_mem _ (List.mem_map.mpr ⟨p, hp, rfl⟩)
      exact ⟨p, hp, by simp [b, inc, h]⟩
  have cutAny : cut a ps b = !(digits a ps).any s.basis := by rw [← orCut, Bool.not_not]
  have bs : b side = s.basis side := by simp [b, off side hs]
  have bf : b far = s.basis far := by simp [b, off far hf]
  have br : b rec = s.basis rec := by simp [b, off rec hr]
  have bt : b tmp = false := by simp [b, off tmp ht, ct]
  let v : State := ⟨s.phase, b⟩
  have middle := run_chainMid true out a side far rec tmp ps hn hs hf hr ht sT fT rT
    (m.drop (measurementCount (notRegister (digits a ps)))) v tz bt
  have ends : (if rev then (digits a ps).reverse else digits a ps).Nodup := by cases rev <;> simp [nd]
  simp only [latchMid, run_append, run_take]
  rw [notRegister_correct _ nd]
  change run (notRegister _) _ (run (chainMid true out a (fun top => orFlag side far rec tmp top out) ps) _ v) = _
  rw [middle, notRegister_correct _ ends]
  apply congrArg (State.mk s.phase)
  funext q
  have ord : q ∈ (if rev then (digits a ps).reverse else digits a ps) ↔ q ∈ digits a ps := by cases rev <;> simp
  change (if q ∈ _ then !_ else _) = _
  rw [if_congr ord rfl rfl]
  have outVal : v.basis out = s.basis out := by simp [v, b, oo]
  simp only [Bool.true_xor, orCut, cutAny, show v.basis = b by rfl, bs, bf, br] at *
  by_cases qm : q ∈ digits a ps <;> by_cases qo : q = out <;>
    simp_all [v, b, writeBit, Function.update]

end ECDSAAdd.Entrant.StairPacket.PortalAnd
end

namespace ECDSAAdd.Entrant.StairPacket.LeaveJ7
open Arithmetic Partial GateMirror PortalAnd
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unreachableTactic false
set_option linter.unusedTactic false
set_option maxHeartbeats 2000000

def longPairs (j : Fin 26) : List (Wire × Wire) := (List.range 16).map (fun i => (Shadow7.b0P (start j) + i, 1557 + i))
def fullA (j : Fin 26) : List Wire := (List.range 16).map (Shadow7.a0P (start j) + ·)
def fullM (j : Fin 26) : List Wire := (List.range 16).map (Shadow7.b0P (start j) + ·)
def fullC : List Wire := (List.range 15).map (1559 + ·)
/-- The dead top rows (staircase82: cell16 + companion row 15): the leave's long latch and companion erase run 15 bits
wide; the 17-wide lists above stay the leave's interface. Their top wires `a0P+16`, `b0P+16` are zero by
`inputTight17`; `b0P+15` is zero and `a0P+15` is zero whenever the copy is enabled, by `inputRow15`. -/
def longPairs15 (j : Fin 26) : List (Wire × Wire) := (List.range 14).map (fun i => (Shadow7.b0P (start j) + i, 1557 + i))
def fullA15 (j : Fin 26) : List Wire := (List.range 14).map (Shadow7.a0P (start j) + ·)
def fullM15 (j : Fin 26) : List Wire := (List.range 14).map (Shadow7.b0P (start j) + ·)
def fullC14 : List Wire := (List.range 13).map (1559 + ·)
def smallA (j : Fin 26) : List Wire := (List.range (Shadow7.lowsP (start j) - 1)).map (Shadow7.a0P (start j) + ·)
def smallM (j : Fin 26) : List Wire := (List.range (Shadow7.lowsP (start j) - 1)).map (Shadow7.b0P (start j) + ·)
def smallC (j : Fin 26) : List Wire := (List.range (Shadow7.lowsP (start j) - 1 - 1)).map (1559 + ·)
/-- dadon's `mask`: `[.X 1557, .CX (a0-1) 1557, .CCX (b0-1) 1557 1558]`. -/
def maskP (j : Fin 26) : Program := [.X 1557, .CX (Shadow7.a0P (start j) - 1) 1557, .CCX (Shadow7.b0P (start j) - 1) 1557 1558]

/-- `Shadow7.fix2P` = long latch ++ mask ++ companion erase (dadon's cuts 93/169/172/242). -/


theorem long_layout15 : ∀ j : Fin 26, 0 ≤ j.val → j.val ≤ 24 →
    (1556 :: (Shadow7.b0P (start j) - 1) :: PortalAnd.sites (longPairs15 j)).Nodup := by
  decide +kernel

theorem full_geometry15 : ∀ j : Fin 26, 0 ≤ j.val → j.val ≤ 24 →
    Companion.Geometry (fullA15 j) (fullM15 j) fullC14 1556 1558 := by
  intro j h0 h1
  constructor <;> revert j <;> decide +kernel

/-- dadon's `long_run`, 15 pairs. -/
theorem long_run15 (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (s : State) (m : List Bool)
    (clean : ∀ p ∈ longPairs15 j, s.basis p.2 = false) :
    run (latch true none 1556 (Shadow7.b0P (start j) - 1) (longPairs15 j)) m s =
      ⟨s.phase, writeBit s.basis 1556 (s.basis 1556 ^^ ((digits (Shadow7.b0P (start j) - 1) (longPairs15 j)).any s.basis))⟩ := by
  simpa only [active, Option.elim_none, Bool.true_and] using
    run_latch true none 1556 (Shadow7.b0P (start j) - 1) (longPairs15 j) (long_layout15 j h0 (by omega)) (by simp) s m clean

/-- dadon's `erase_run`, 15 bits. -/
theorem erase_run15 (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (s : State) (m : List Bool)
    (clean : ∀ q ∈ fullC14, s.basis q = false)
    (input : (regValue (fullM15 j) s.basis + (s.basis 1558).toNat) % 2^(fullM15 j).length =
      copyValue (some 1556) s.basis (regValue (fullA15 j) s.basis)) :
    let e := Companion.eraseM (fullA15 j) (fullM15 j) fullC14 1556 1558
    (run e m s).phase = s.phase ∧ (∀ q, q ∉ fullM15 j → (run e m s).basis q = s.basis q) ∧
      regValue (fullM15 j) (run e m s).basis = 0 :=
  Companion.clearM (fullA15 j) (fullM15 j) fullC14 1556 1558 (full_geometry15 j h0 (by omega)) s m clean input

theorem fullA_split (j : Fin 26) : fullA j = fullA15 j ++ [Shadow7.a0P (start j) + 14, Shadow7.a0P (start j) + 15] := by
  simp only [fullA, fullA15, List.range_succ, List.map_append, List.map_cons, List.map_nil, List.append_assoc,
    List.cons_append, List.nil_append]

theorem fullM_split (j : Fin 26) : fullM j = fullM15 j ++ [Shadow7.b0P (start j) + 14, Shadow7.b0P (start j) + 15] := by
  simp only [fullM, fullM15, List.range_succ, List.map_append, List.map_cons, List.map_nil, List.append_assoc,
    List.cons_append, List.nil_append]

theorem longPairs_split (j : Fin 26) : longPairs j = longPairs15 j ++
    [(Shadow7.b0P (start j) + 14, 1557 + 14), (Shadow7.b0P (start j) + 15, 1557 + 15)] := by
  simp only [longPairs, longPairs15, List.range_succ, List.map_append, List.map_cons, List.map_nil, List.append_assoc,
    List.cons_append, List.nil_append]

theorem fullC14_sub {q : Wire} (h : q ∈ fullC14) : q ∈ fullC := by
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp h
  rw [List.mem_range] at hi
  exact List.mem_map.mpr ⟨i, List.mem_range.mpr (by omega), rfl⟩

theorem fullM15_sub (j : Fin 26) {q : Wire} (h : q ∈ fullM15 j) : q ∈ fullM j := by
  rw [fullM_split]; exact List.mem_append_left _ h

theorem longPairs15_sub (j : Fin 26) {p : Wire × Wire} (h : p ∈ longPairs15 j) : p ∈ longPairs j := by
  rw [longPairs_split]; exact List.mem_append_left _ h

/-! The low-store restore (generic): `Shadow7.lowRest` = companion restore ++ release mask. -/

def releaseMaskP (j : Fin 26) : Program :=
  [.measureX 1558 [] [.CZ (Shadow7.b0P (start j) - 1) 1557], .CX (Shadow7.a0P (start j) - 1) 1557, .X 1557]

/-- Margin-16 glue G2 inside the long latch of `Shadow7.fix2P` (m16-leave). -/
def latchG2 (j : Fin 26) : Program :=
  PortalAnd.latchMid true 1556 (Shadow7.b0P (start j) - 1) (longPairs15 j)
    (fun top => PortalAnd.orFlag (Shadow7.e0P (start j) + 4) (Shadow7.e0P (start j) + 3) (OB5.sig (start j + 14) (start j + 1044))
      1571 top 1556)

/-- G4 as instructions: the borrow pair recomputed from the true bits before the companion restore. -/
def borrowG4 (j : Fin 26) : Program :=
  [.CX (Shadow7.a0P (start j) - 1) 1557, .X 1557, .CCX (Shadow7.b0P (start j) - 1) 1557 1558]

/-- The G2 wires sit off the latch chain (and off its temp 1571). -/
theorem glue_layout : ∀ j : Fin 26, 0 ≤ j.val → j.val ≤ 24 →
    (1556 :: (Shadow7.b0P (start j) - 1) :: PortalAnd.sites (longPairs15 j)).Nodup ∧
    Shadow7.e0P (start j) + 4 ∉ 1556 :: (Shadow7.b0P (start j) - 1) :: PortalAnd.sites (longPairs15 j) ∧
    Shadow7.e0P (start j) + 3 ∉ 1556 :: (Shadow7.b0P (start j) - 1) :: PortalAnd.sites (longPairs15 j) ∧
    OB5.sig (start j + 14) (start j + 1044) ∉ 1556 :: (Shadow7.b0P (start j) - 1) :: PortalAnd.sites (longPairs15 j) ∧
    (1571 : Wire) ∉ 1556 :: (Shadow7.b0P (start j) - 1) :: PortalAnd.sites (longPairs15 j) ∧
    Shadow7.e0P (start j) + 4 ≠ 1571 ∧ Shadow7.e0P (start j) + 3 ≠ 1571 ∧ OB5.sig (start j + 14) (start j + 1044) ≠ 1571 := by
  decide +kernel

theorem latchG2_run (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (s : State) (m : List Bool)
    (clean : ∀ p ∈ longPairs15 j, s.basis p.2 = false) (c71 : s.basis 1571 = false) :
    run (latchG2 j) m s = ⟨s.phase, writeBit s.basis 1556 (s.basis 1556 ^^
      (PortalAnd.digits (Shadow7.b0P (start j) - 1) (longPairs15 j)).any s.basis ^^
      (!(PortalAnd.digits (Shadow7.b0P (start j) - 1) (longPairs15 j)).any s.basis &&
        (s.basis (Shadow7.e0P (start j) + 4) ^^ (s.basis (Shadow7.e0P (start j) + 3) &&
          s.basis (OB5.sig (start j + 14) (start j + 1044))))))⟩ := by
  obtain ⟨gn, gs, gf, gr, gt, gsT, gfT, grT⟩ := glue_layout j h0 h1
  exact PortalAnd.run_latchMid true 1556 (Shadow7.b0P (start j) - 1) _ _ _ 1571 (longPairs15 j) gn gs gf gr gt gsT gfT grT s m clean c71

/-- `Shadow7.fix2P` with the glue: long latch with G2 inside ++ mask ++ companion erase ++ G1 (mask release). -/
theorem fix2_parts15 : ∀ j : Fin 26, 0 ≤ j.val → j.val ≤ 24 →
    GateMirror.forward (Shadow7.fix2P (start j) (Shadow7.sbP (start j))) =
      latchG2 j ++ (maskP j ++ (Companion.eraseM (fullA15 j) (fullM15 j) fullC14 1556 1558 ++ releaseMaskP j)) := by
  decide +kernel

theorem forward_xsG' (xs : List Wire) : GateMirror.forward (xsG xs) = notRegister xs := by
  simp only [xsG, GateMirror.forward, notRegister, List.map_map]; rfl

theorem copy_map (c : Wire) (f g : Nat → Wire) : ∀ xs : List Nat,
    copyRegister (some c) (xs.map f) (xs.map g) = xs.map (fun i => Instr.CCX c (f i) (g i))
  | [] => rfl
  | x::xs => by simp only [List.map_cons, copyRegister, copyGate, copy_map c f g xs]; rfl

theorem lowRest_parts (j : Fin 26) :
    GateMirror.forward (Shadow7.lowRest (start j)) =
      borrowG4 j ++ (Companion.restore (smallA j) (smallM j) (smallC j) 1556 1558 ++ releaseMaskP j) := by
  have hc : GateMirror.forward ((List.range (Shadow7.lowsP (start j) - 1)).map
      (fun i => Gate.make 1556 (Shadow7.a0P (start j) + i) (Shadow7.b0P (start j) + i))) =
      copyRegister (some 1556) (smallA j) (smallM j) := by
    rw [smallA, smallM, copy_map]; simp only [GateMirror.forward, List.map_map]; rfl
  simp only [Shadow7.lowRest, forward_app, forward_addG, forward_xsG', hc, Companion.restore, HighBankUnit.sub, mappedSub,
    smallM, smallC, List.append_assoc]
  rfl

theorem small_geometry : ∀ j : Fin 26, 0 ≤ j.val → j.val ≤ 24 →
    Companion.Geometry (smallA j) (smallM j) (smallC j) 1556 1558 := by
  intro j h0 h1
  constructor <;> revert j <;> decide +kernel

/-- dadon's `restore_run`. -/
theorem restore_run (j : Fin 26) (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) (s : State) (m : List Bool)
    (clean : ∀ q ∈ smallC j, s.basis q = false) (input : regValue (smallM j) s.basis = 0) :
    let r := Companion.restore (smallA j) (smallM j) (smallC j) 1556 1558
    (run r m s).phase = s.phase ∧ (∀ q, q ∉ smallM j → (run r m s).basis q = s.basis q) ∧
      regValue (smallM j) (run r m s).basis =
        (copyValue (some 1556) s.basis (regValue (smallA j) s.basis) + 2^(smallM j).length - (s.basis 1558).toNat) %
          2^(smallM j).length :=
  Companion.write (smallA j) (smallM j) (smallC j) 1556 1558 (small_geometry j h0 (by omega)) s m clean input

end ECDSAAdd.Entrant.StairPacket.LeaveJ7

