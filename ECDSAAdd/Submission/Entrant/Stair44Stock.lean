  have pkNot : pk ∉ wires (preOf tr xs work one U V F) := by
    apply pre_not
    · exact ⟨tmp1 pk mP, Ne.symm UP, Ne.symm VP, Ne.symm FP, (nx pk mP _ h1l).symm, (nx pk mP _ h1h).symm,
