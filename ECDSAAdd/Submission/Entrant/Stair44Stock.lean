 obtain ⟨a,a',as,b,b',bs,c,cs,t0,ts,eX,eY,eC,eT,amem,cmem⟩ := R.m4_shape w
 have old : wires R.m4⊆S := fun q hq=>Finset.mem_union_left _ (plain.2 hq)
