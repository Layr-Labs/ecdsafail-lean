section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairField2V3Replay

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1 BalancedField






/-- The division computation up to (but excluding) the unchanged inverse
integer close.  This is a fixed, named record program rather than a caller-
supplied list component. -/
def entrySelectedArithmetic (A : StairCertificate.Assembly) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
      (StairSchedule.firstPhase A.primitives) ++
    StairSchedule.entryFieldHosted A.primitives StairSchedule.recordLoans


def entrySelectedClosing (_A : StairCertificate.Assembly) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
    (InverseFive23.lastPhase15 false)

def entryReferenceClosing : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
    (InverseFive23.lastPhase15 false)

/-- The multiplication opening is unchanged; the named remainder contains
the reverse staircase and its concrete `k`-dependent close. -/
def exitSelectedOpening (_A : StairCertificate.Assembly) : Program :=
  renameProgram Rolling1588Lifetime.phaseHost
    (Rolling1588TickGap.firstPhase false)


def exitSelectedRemainder (A : StairCertificate.Assembly) (k : Nat) : Program :=
  StairSchedule.exitFieldHosted A.primitives StairSchedule.recordLoans ++
    renameProgram Rolling1588Lifetime.phaseHost
      (StairSchedule.lastXN A.primitives k)

def exitReferenceRemainder (k : Nat) : Program :=
  Rolling1588.exitFieldHosted ++
    renameProgram Rolling1588Lifetime.phaseHost
      (ParityXExitInverse23Kernel.lastXN k)

theorem entrySelected_shape (A : StairCertificate.Assembly) :
    entrySelectedArithmetic A ++ entrySelectedClosing A =
      StairSchedule.entryKernel A.primitives StairSchedule.recordLoans := by
  simp only [entrySelectedArithmetic, entrySelectedClosing,
    StairSchedule.entryKernel, List.append_assoc]

theorem entryReference_shape :
    entryReferenceArithmetic ++ entryReferenceClosing =
      InverseFiveEntry23.entryKernel15 := by
  simp only [entryReferenceArithmetic, entryReferenceClosing,
    InverseFiveEntry23.entryKernel15, InverseFiveEntry23.kernel15,
    List.append_assoc]

theorem exitSelected_shape (A : StairCertificate.Assembly) (k : Nat) :
    exitSelectedOpening A ++ exitSelectedRemainder A k =
      StairSchedule.exitKernel A.primitives StairSchedule.recordLoans k := by
  simp only [exitSelectedOpening, exitSelectedRemainder,
    StairSchedule.exitKernel, List.append_assoc]

theorem exitReference_shape (k : Nat) :
    exitReferenceOpening ++ exitReferenceRemainder k =
      ParityXExitInverse23Kernel.kernelXN k := by
  simp only [exitReferenceOpening, exitReferenceRemainder,
    ParityXExitInverse23Kernel.kernelXN, List.append_assoc]

/-- Replay obligations over the four named, real program boundaries above.
Unlike the former length-10 wrapper, no program list or shape equality is
provided by the caller, so a whole kernel cannot be hidden in one slot with
the remaining slots empty. -/
structure ConcreteComposition (A : StairCertificate.Assembly) where
  entryMiddle : State → Prop
  entryArithmetic : StairCertificate.CodecFunctionalSpec A →
    ReplayStep A.entryPre entryMiddle
      (entrySelectedArithmetic A) entryReferenceArithmetic
  entryClosing : ReplayStep entryMiddle (fun _ => True)
    (entrySelectedClosing A) entryReferenceClosing
  exitMiddle : Nat → State → Prop
  exitOpening : ∀ k, ReplayStep (A.exitPre k) (exitMiddle k)
    (exitSelectedOpening A) exitReferenceOpening
  exitRemainder : StairCertificate.CodecFunctionalSpec A → ∀ k,
    ReplayStep (exitMiddle k) (fun _ => True)
      (exitSelectedRemainder A k) (exitReferenceRemainder k)

/-- Exact `StairOpen.checkpoint_composition` result, derived only by composing
smaller replay steps and the explicit concrete program decompositions. -/
theorem checkpoint_composition {A : StairCertificate.Assembly}
    (concrete : ConcreteComposition A) :
    StairCertificate.CodecFunctionalSpec A →
      StairCertificate.CheckpointReplaySpec A := by
  intro functional k
  constructor
  · intro s hs fresh old
    rw [← entrySelected_shape A, ← entryReference_shape]
    let chain : ReplayChain A.entryPre (fun _ => True)
        [entrySelectedArithmetic A, entrySelectedClosing A]
        [entryReferenceArithmetic, entryReferenceClosing] :=
      .cons (concrete.entryArithmetic functional)
        (.cons concrete.entryClosing (.nil _))
    simpa only [concatPrograms, List.append_nil] using
      replayChain_run_eq chain s hs fresh old
  · intro s hs fresh old
    rw [← exitSelected_shape A k, ← exitReference_shape k]
    let chain : ReplayChain (A.exitPre k) (fun _ => True)
        [exitSelectedOpening A, exitSelectedRemainder A k]
        [exitReferenceOpening, exitReferenceRemainder k] :=
      .cons (concrete.exitOpening k)
        (.cons (concrete.exitRemainder functional k) (.nil _))
    simpa only [concatPrograms, List.append_nil] using
      replayChain_run_eq chain s hs fresh old


