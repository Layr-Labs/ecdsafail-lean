theorem inputNumber_bit (f : Wire→Wire) (s : BasisState) (q : Nat) (hq:q<5) :
 (inputNumber f s).val.testBit q=s (f q) := by
 have hg:(inputPorts f).getD q 0=f q := by
  rw [List.getD_eq_getElem _ _ (by simp [inputPorts];omega)]
  simp [inputPorts]
