  have p9 := counts_exchangeG G [(aBot, bBot), (aBot+1, bBot+1)]
  exact (((((((((((((⟨rfl, rfl, rfl, rfl⟩ : Counts [.cx (aBot + w - 1) sgn, .cx (bTopP t) sgn] 0 0 0 2).app
    p1).app p2).app p3).app
