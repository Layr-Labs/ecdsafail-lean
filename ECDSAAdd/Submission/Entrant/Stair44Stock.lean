theorem stillB {s : Nat} (w1 : 45 ≤ s) (w2 : s ≤ 405) :
    (moveRows s).all (fun r => (GateMirror.forward (moveB s)).all (MoveChain.quiet (e0P s + 6) r)) = true := by
