/-- Run equality is preserved by an injective rename fixing the parked wire. -/
theorem rename_put_eqD (f : Wire → Wire) (inj : Function.Injective f) (pk : Wire)
    (hfix : f pk = pk) (P Q : Program) (t : State) (e : Bool) (m n : List Bool)
    (same : run P m (put (pullState f t) pk e) = run Q n (put (pullState f t) pk e)) :
    run (renameProgram f P) m (put t pk e) = run (renameProgram f Q) n (put t pk e) := by
  refine ECDSAAdd.run_rename_eq_of_eq f (wires P ∪ wires Q) (fun a _ b _ eq => inj eq) P Q
    Finset.subset_union_left Finset.subset_union_right m n (put (pullState f t) pk e)
    (put t pk e) rfl ?_ same
  intro q _
  by_cases eq : q = pk
  · subst eq; simp [put, writeBit, hfix]
  · have ne : f q ≠ pk := fun E => eq (inj (E.trans hfix.symm))
    simp only [put, writeBit, Function.update_apply, eq, ne, if_false]
    rfl

