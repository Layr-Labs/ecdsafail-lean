theorem movedReverse_top (w : Nat → Wire) :
    ∀ (n i : Nat), StairReplay.movedReverse w i (n + 1) =
      StairReplay.movedReverse w (i + n) 1 ++ StairReplay.movedReverse w i n
  | 0, i => by simp [StairReplay.movedReverse]
  | n + 1, i => by
      have e1 : StairReplay.movedReverse w i (n + 1 + 1) =
          StairReplay.movedReverse w (i + 1) (n + 1) ++
            (Rolling1588.Integer.unpackFirst w true i ++ W.ReverseCarry.compactReceiverTick w i) := rfl
      have e2 : StairReplay.movedReverse w i (n + 1) =
          StairReplay.movedReverse w (i + 1) n ++
            (Rolling1588.Integer.unpackFirst w true i ++ W.ReverseCarry.compactReceiverTick w i) := rfl
      have h : i + 1 + n = i + (n + 1) := by omega
      rw [e1, e2, movedReverse_top w n (i + 1), List.append_assoc, h]


def termPieces : List (Program × Program) :=
  [(P.unpack 12, P.pack 12), (P.tickForward 500, P.tickReverse 500),
