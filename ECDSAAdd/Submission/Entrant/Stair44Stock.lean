/-!
# Terminal link of the terminal row, staircase coordinates (LT24, obligation 3(b))

`termTrip` (StairField2V3ExitTerminal) reduces the terminal row round trip
`WT ∘ FT = id` to four links.  The last one is the terminal-block link

`run (reverseTerminalV3 ++ movedReverse wRev 505 1) a (run forwardTerminalV3 c σ) = σ`.

All three programs are the record programs relabelled by `terminalPerm`
(`step505_moved`), so the link follows from the record round trip
`StairExitLT24Term.terminal_record_trip` on a *virtual* record state: the
state pulled back through `terminalPerm` has to agree with a record state at
tick 505 of some stage-1 trajectory, on the wires of the record blocks only.
No phase hypothesis is needed (the virtual trajectory's phase is adjusted).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1









/-- A run from a state with the same basis and any prescribed final phase. -/
theorem phase_shift (P : Program) (m : List Bool) (s : State) (b : Bool) :
    ∃ s' : State, s'.basis = s.basis ∧ (run P m s').phase = b ∧
      (run P m s').basis = (run P m s).basis := by
  refine ⟨⟨b ^^ (run P m s).phase ^^ s.phase, s.basis⟩, rfl, ?_, ?_⟩
  · have inc := (run_local_increment P ⟨b ^^ (run P m s).phase ^^ s.phase, s.basis⟩ s m
      (fun _ _ => rfl)).1
    revert inc
    generalize (run P m ⟨b ^^ (run P m s).phase ^^ s.phase, s.basis⟩).phase = y
    cases b <;> cases y <;> cases (run P m s).phase <;> cases s.phase <;> simp
  · have inc := (run_local_increment P ⟨b ^^ (run P m s).phase ^^ s.phase, s.basis⟩ s m
      (fun _ _ => rfl)).2
    funext q
    by_cases hq : q ∈ wires P
    · exact inc q hq
    · rw [run_preserves_outside P m _ q hq, run_preserves_outside P m s q hq]

abbrev linkR : Program := StairTerminalV3.reverseRecord ++ StairExitLT24Term.step505

/-- Virtual precondition, record carries only (the record form of the link). -/
def TermVirtualRec (x : Nat) (σ : State) : Prop :=
  ∃ (s1 : State) (m : List Bool),
    W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis ∧
    ∀ q, q ∈ wires linkF ∨ q ∈ wires linkR →
      σ.basis (StairTerminalV3.terminalPerm q) =
        (run (Rolling1588TickGap.forward true 1 504) m s1).basis q

/-- Terminal link with the record untick 505 (carries on the record bits). -/
theorem terminal_link_rec (x : Nat) (hx0 : 0 < x) (hx : x < p) (σ : State)
    (hv : TermVirtualRec x σ) (c a : List Bool) :
    run (StairTerminalV3.reverseTerminalV3 ++
        renameProgram StairTerminalV3.terminalPerm StairExitLT24Term.step505) a
      (run StairTerminalV3.forwardTerminalV3 c σ) = σ := by
  obtain ⟨s1, m, first, agree⟩ := hv
  obtain ⟨s1', hb, hph, hrun⟩ := phase_shift (Rolling1588TickGap.forward true 1 504) m s1 σ.phase
  have first' : W.CompactSkywalkStage base
      (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1'.basis := by
    rw [hb]; exact first
  have eR : StairTerminalV3.reverseTerminalV3 ++
      renameProgram StairTerminalV3.terminalPerm StairExitLT24Term.step505 =
      renameProgram StairTerminalV3.terminalPerm linkR := by
    simp only [StairTerminalV3.reverseTerminalV3, linkR, renameProgram, List.map_append]
  have eF : StairTerminalV3.forwardTerminalV3 = renameProgram StairTerminalV3.terminalPerm linkF := rfl
  rw [eR, eF]
  apply pull_inj StairTerminalV3.terminalPerm
  rw [run_rename _ StairTerminalV3.terminalPerm.injective linkR,
    run_rename _ StairTerminalV3.terminalPerm.injective linkF]
  have trip := StairExitLT24Term.terminal_record_trip x hx0 hx s1' first' m
  refine trip_of_local linkF linkR (pullState StairTerminalV3.terminalPerm σ)
    (run (Rolling1588TickGap.forward true 1 504) m s1') ?_ ?_ trip c a
  · exact (pull_phase _ _).trans hph.symm
  · intro q hq
    exact (StairExitLT24Term.pull_basis _ _ _).trans ((agree q hq).trans (congrFun hrun q).symm)

/-- Locality through two programs. -/
theorem two_step (F G : Program) (s t : State) (S : Wire → Prop)
    (hS : ∀ q, q ∈ wires F ∨ q ∈ wires G → S q) (h : ∀ q, S q → s.basis q = t.basis q)
    (c a : List Bool) :
    ∀ q, S q → (run G a (run F c s)).basis q = (run G a (run F c t)).basis q := by
  have incF := run_local_increment F s t c (fun q hq => h q (hS q (Or.inl hq)))
  have mid : ∀ q, S q → (run F c s).basis q = (run F c t).basis q := by
    intro q hq
    by_cases hF : q ∈ wires F
    · exact incF.2 q hF
    · rw [run_preserves_outside F c s q hF, run_preserves_outside F c t q hF]
      exact h q hq
  have incG := run_local_increment G (run F c s) (run F c t) a
    (fun q hq => mid q (hS q (Or.inr hq)))
  intro q hq
  by_cases hG : q ∈ wires G
  · exact incG.2 q hG
  · rw [run_preserves_outside G a _ q hG, run_preserves_outside G a (run F c t) q hG]
    exact mid q hq

/-- **Virtual precondition of the terminal link.** Pulled back through
`terminalPerm`, the state agrees with the record state at tick 505 of some
stage-1 trajectory: on the record blocks' wires and on the record carry bits
`base 1540 .. 1544`. The moved c-rail carries `cSite 0 .. 4` are clean. -/
def TermVirtual (x : Nat) (σ : State) : Prop :=
  ∃ (s1 : State) (m : List Bool),
    W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis ∧
    (∀ q, q ∈ wires linkF ∨ q ∈ wires linkR ∨ q ∈ carryR →
      σ.basis (StairTerminalV3.terminalPerm q) =
        (run (Rolling1588TickGap.forward true 1 504) m s1).basis q) ∧
    ∀ k, k < 5 → σ.basis (StairPhysicalLayout.cSite k) = false

/-- **Terminal link** (`termPieces`, last pair). -/
theorem terminal_link (x : Nat) (hx0 : 0 < x) (hx : x < p) (σ : State)
    (hv : TermVirtual x σ) (c a : List Bool) :
    run (StairTerminalV3.reverseTerminalV3 ++ StairReplay.movedReverse wRev 505 1) a
      (run StairTerminalV3.forwardTerminalV3 c σ) = σ := by
  obtain ⟨s1, m, first, agree, hA⟩ := hv
  have hrec := terminal_link_rec x hx0 hx σ
    ⟨s1, m, first, fun q hq => agree q (hq.elim Or.inl (fun h => Or.inr (Or.inl h)))⟩ c a
  have memR : ∀ k, k < 5 → base (1540 + k) ∈ carryR := fun k hk =>
    List.mem_map.mpr ⟨k, List.mem_range.mpr hk, rfl⟩
  -- the carries after the terminal blocks
  have yB : ∀ k, k < 5 → ∀ a1, (run StairTerminalV3.reverseTerminalV3 a1
      (run StairTerminalV3.forwardTerminalV3 c σ)).basis
        (StairTerminalV3.terminalPerm (base (1540 + k))) = false := by
    intro k hk a1
    have conj : pullState StairTerminalV3.terminalPerm (run StairTerminalV3.reverseTerminalV3 a1
        (run StairTerminalV3.forwardTerminalV3 c σ)) =
        run StairTerminalV3.reverseRecord a1 (run StairTerminalV3.forwardRecord c
          (pullState StairTerminalV3.terminalPerm σ)) := by
      rw [show StairTerminalV3.reverseTerminalV3 =
          renameProgram StairTerminalV3.terminalPerm StairTerminalV3.reverseRecord from rfl,
        show StairTerminalV3.forwardTerminalV3 =
          renameProgram StairTerminalV3.terminalPerm StairTerminalV3.forwardRecord from rfl,
        run_rename _ StairTerminalV3.terminalPerm.injective,
        run_rename _ StairTerminalV3.terminalPerm.injective]
    have e1 := congrFun (congrArg State.basis conj) (base (1540 + k))
    have e2 := two_step StairTerminalV3.forwardRecord StairTerminalV3.reverseRecord
      (pullState StairTerminalV3.terminalPerm σ) (run (Rolling1588TickGap.forward true 1 504) m s1)
      (fun q => q ∈ wires linkF ∨ q ∈ wires linkR ∨ q ∈ carryR)
      (fun q hq => hq.elim Or.inl (fun h => Or.inr (Or.inl (by
        show q ∈ wires (StairTerminalV3.reverseRecord ++ StairExitLT24Term.step505)
        rw [wires_append]; exact Finset.mem_union_left _ h))))
      (fun q hq => (StairExitLT24Term.pull_basis _ _ _).trans (agree q hq)) c a1 (base (1540 + k))
      (Or.inr (Or.inr (memR k hk)))
    exact (StairExitLT24Term.pull_basis _ _ _).symm.trans
      (e1.trans (e2.trans (StairExitLT24Term.blocks_carry x hx0 hx s1 first m c a1 k hk)))
  have yA : ∀ k, k < 5 → ∀ a1, (run StairTerminalV3.reverseTerminalV3 a1
      (run StairTerminalV3.forwardTerminalV3 c σ)).basis (StairPhysicalLayout.cSite k) = false := by
    intro k hk a1
    have fr := carry_sites_free k hk
    rw [run_preserves_outside _ a1 _ _ (fun h => fr.2 (List.mem_toFinset.mp
        (StairTerminalV3.reverseTerminalV3_wires h))),
      run_preserves_outside _ c _ _ (fun h => fr.1 (List.mem_toFinset.mp
        (StairTerminalV3.forwardTerminalV3_wires h)))]
    exact hA k hk
  have fixY : ∀ a1, pullState carrySwap (run StairTerminalV3.reverseTerminalV3 a1
      (run StairTerminalV3.forwardTerminalV3 c σ)) =
      run StairTerminalV3.reverseTerminalV3 a1 (run StairTerminalV3.forwardTerminalV3 c σ) := by
    intro a1
    apply State.extensionality
    · exact pull_phase _ _
    · funext w
      rw [StairExitLT24Term.pull_basis]
      apply swaps_fix carryPairs
      intro q hq
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hq
      have hk' := List.mem_range.mp hk
      exact (yA k hk' a1).trans (yB k hk' a1).symm
  have fixS : pullState carrySwap σ = σ := by
    apply State.extensionality
    · exact pull_phase _ _
    · funext w
      rw [StairExitLT24Term.pull_basis]
      apply swaps_fix carryPairs
      intro q hq
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hq
      have hk' := List.mem_range.mp hk
      refine (hA k hk').trans ?_
      exact ((agree _ (Or.inr (Or.inr (memR k hk')))).trans
        (StairExitLT24Term.rho_carry x hx0 hx s1 first m k hk')).symm
  rw [step505_moved, run_append StairTerminalV3.reverseTerminalV3]
  rw [run_append StairTerminalV3.reverseTerminalV3] at hrec
  apply pull_inj carrySwap
  rw [run_rename _ carrySwap.injective, fixY, hrec, fixS]

end ECDSAAdd.Entrant.StairExitLT24

end
end Merge_StairField2V3ExitTermLink_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitClose_at_Main` -/
section Merge_StairField2V3ExitClose_at_Main

/-!
# Obligation 3(c): the record round trip `closeRef ∘ refJ0 = id` (LT24)

LT21's division junction runs the record piece `refJ0` (record ticks 425..504,
terminal blocks, clear, setup, X) and the multiplication close runs `closeRef`
(X, setup, clear, record reverse terminal blocks, unticks 505..425).  On every
state whose `phaseHost` pull-back is the record trajectory state at tick 425
(`run (Rolling1588TickGap.forward true 1 424) m s1`, `s1` stage 1), the two
cancel for all tapes.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairExitLT24

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed Secp256k1


theorem closeRef_eq : StairField2V3ExitPlan.closeRef =
    XS ++ StairField2V3Entry.ph (StairTerminalV3.reverseRecord ++
      Rolling1588.Integer.reverse true 425 (506 - 425)) := by
  rw [Rolling1588.Integer.reverse_eq_packets]
  simp only [StairField2V3ExitPlan.closeRef, StairTerminalV3.reverseRecord, XS, List.append_assoc]

/-- **3(c)** `closeRef ∘ refJ0 = id` on the record trajectory at tick 425. -/
theorem close_record_trip (x : Nat) (hx0 : 0 < x) (hx : x < p) (s1 : State)
    (first : W.CompactSkywalkStage base (SkywalkRails.encode false false (x:Int) (p:Int)) 1 s1.basis)
    (m : List Bool) (t : State)
    (ht : pullState Rolling1588Lifetime.phaseHost t = run (Rolling1588TickGap.forward true 1 424) m s1)
    (c a : List Bool) :
    run StairField2V3ExitPlan.closeRef a (run StairField2V3Entry.refJ0 c t) = t := by
  rw [refJ0_eq, closeRef_eq, run_append XS _, run_append (StairField2V3Entry.ph _) SX,
    XS_measurements]
  simp only [List.take_zero, List.drop_zero]
  rw [run_of_noMeasure SX SX_measurements, XS_eq_SX, SX_invol]
  apply pull_inj Rolling1588Lifetime.phaseHost
  unfold StairField2V3Entry.ph
  rw [run_rename _ Rolling1588Lifetime.phaseHost.injective,
    run_rename _ Rolling1588Lifetime.phaseHost.injective, ht]
  exact StairExitLT24Term.record_trip_from 425 (by omega) (by omega) x hx0 hx s1 first m _ _

end ECDSAAdd.Entrant.StairExitLT24

end
end Merge_StairField2V3ExitClose_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3Seg_at_Main` -/
section Merge_StairField2V3Seg_at_Main

/-!
# LT21: segment obligations from a pure staircase spec and a record fact

Concrete side condition for a v3 row of budget `B` (start `ℓ = startFor B`):
`Cv B a b` — there are an input `x` and a record transcript `origin` with
`TraceOK x origin`, such that on every future payload site `r`
* the record state holds the A-encoded transcript: `b (fieldPlace r) = recVal origin r`,
* the staircase state holds the compact checkpoint of the walk at `ℓ`:
  `a (fieldPlace r) = cmpBits B x r`.

`Cv B` reads only `Δv B` (`cv_local`).  A segment obligation of `EntryPlanV3b`
follows (`seg_of_spec`) from
* `SegSpecT p B B' ℓ e` — a statement about the *tail-level* staircase program
  `forwardSegment p B B' ℓ e` alone (no record state): from the compact
  checkpoint of row `B` and clean scratch it writes the record's encoded packets
  of the segment, stores the compact checkpoint of row `B'`, leaves the scratch
  clean and touches nothing else; and
* `RecordScratch B B' X` — the genuine record state after the record prefix `X`
  is clean on the segment's scratch sites (`scratchT B B'`).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Seg

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3Delta
open StairPhysicalLayout StairOuterPlacement

/-! ## Values -/







/-! ## Field coordinates -/







/-! ## The two remaining statements per segment -/



/-- Pure tail-level staircase spec of `forwardSegment p B B' ℓ e`. -/
def SegSpecT (p : StairSchedule.StairPrimitives) (B B' ℓ e : Nat) : Prop :=
  ∀ x origin, TraceOK x origin → ∀ (u : State),
    (∀ r ∈ futurePayload B, u.basis r = cmpBits B x r) →
    (∀ r ∈ scratchT B B', u.basis r = false) → ∀ m,
      let u' := run (StairSchedule.forwardSegment p B B' ℓ e) m u
      u'.phase = u.phase ∧
      (∀ r, r ∉ futurePayload B → r ∉ scratchT B B' → u'.basis r = u.basis r) ∧
      (∀ r ∈ scratchT B B', u'.basis r = false) ∧
      (∀ r ∈ futurePayload B', u'.basis r = cmpBits B' x r) ∧
      (∀ r ∈ futurePayload B, r ∉ futurePayload B' → u'.basis r = recVal origin r)



end ECDSAAdd.Entrant.StairField2V3Seg

end
end Merge_StairField2V3Seg_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3ExitPlanR_at_Main` -/
section Merge_StairField2V3ExitPlanR_at_Main

/-!
# LT43: the multiplication plan with reachability and a pinned input

`ExitPlanV3` relates the two exit runs by `Rel (Δrow i) (C i)` only.  Every exit
step, however, needs a fact about the *reference* (multiplication record) state
that a `Δ`-local side condition cannot express: the reverse segments need the
record transcript on the whole `futurePayload B` (LT24's `ExitRowRel`), the exit
junction needs the last-step predicate of the record state, and the close needs
the record state at row 425 (for `close_record_trip`).

`ExitPlanR p k x` therefore carries, like the division plan, the reachability of the
reference state (`ReachE k x Y t`: reached from a multiplication middle state of
input `x` by the reference prefix `Y`), and pins the input `x` in the side
condition (`CvX x B`), so that the selected partner of a reference state is unique.

`field2_of_entryD_R` is field 2 from LT21's `EntryPlanV3d` and this plan.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3ExitPlanR

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry StairField2V3ExitPlan
open StairField2V3Delta StairField2V3Seg
open StairPhysicalLayout StairOuterPlacement

/-! ## Multiplication middle states with a pinned input -/





/-! ## Side condition with the input pinned -/












/-! ## Exit pieces of the reference prefix (left-nested, as produced by `crel_track`) -/



/-- Every remaining multiplication obligation for input `x`. -/
structure ExitPlanR (p : StairSchedule.StairPrimitives) (k x : Nat) where
  junction : CRel (JEX k x) (RelX x 12) (firstSel p) []
  rseg4 : CRel (RowRelE k x 12 YA) (RelX x 22) (rseg p 22 12 490 500) []
  rseg3 : CRel (RowRelE k x 22 YB) (RelX x 32) (rseg p 32 22 480 490) []
  rseg2 : CRel (RowRelE k x 32 YC) (RelX x 47) (rseg p 47 32 465 480) []
  rseg1 : CRel (RowRelE k x 47 YD) (RelX x 62) (rseg p 62 47 450 465) []
  rseg0 : CRel (RowRelE k x 62 YE) (RelX x 87) (rseg p 87 62 425 450) []
  close : CRel (RowRelE k x 87 YF) Eq (closeSel p) closeRef

/-! ## The chain -/




theorem junctionE {p : StairSchedule.StairPrimitives} {k x : Nat}
    (h : CRel (JEX k x) (RelX x 12) (firstSel p) []) :
    CRel (JEX k x) (RowRelE k x 12 headE) (firstSel p) [] := by
  have g := junction_track_gen (ExitMiddleX k x) headE h
  rw [List.append_nil] at g
  exact g



theorem chain_of_planR {p : StairSchedule.StairPrimitives} {k x : Nat} (plan : ExitPlanR p k x) :
    CRel (fun s t => ExitMiddleX k x s ∧ s = t) Eq
      (headE ++ (firstSel p ++ (grpF 98 2 ++ (rseg p 22 12 490 500 ++ (grpF 96 2 ++
        (rseg p 32 22 480 490 ++ (grpF 93 3 ++ (rseg p 47 32 465 480 ++ (grpF 90 3 ++
        (rseg p 62 47 450 465 ++ (grpF 85 5 ++ (rseg p 87 62 425 450 ++ (grpF 1 84 ++
        (lowTail ++ (closeSel p ++ closeTail k)))))))))))))))
      (headE ++ (grpF 98 2 ++ (grpF 96 2 ++ (grpF 93 3 ++ (grpF 90 3 ++ (grpF 85 5 ++
        (grpF 1 84 ++ (lowTail ++ (closeRef ++ closeTail k))))))))) := by
  have r4 : CRel (RowRelE k x 12 (headE ++ grpF 98 2)) (RelX x 22) (rseg p 22 12 490 500) [] :=
    plan.rseg4
  have r3 : CRel (RowRelE k x 22 (YA ++ grpF 96 2)) (RelX x 32) (rseg p 32 22 480 490) [] :=
    plan.rseg3
  have r2 : CRel (RowRelE k x 32 (YB ++ grpF 93 3)) (RelX x 47) (rseg p 47 32 465 480) [] :=
    plan.rseg2
  have r1 : CRel (RowRelE k x 47 (YC ++ grpF 90 3)) (RelX x 62) (rseg p 62 47 450 465) [] :=
    plan.rseg1
  have r0 : CRel (RowRelE k x 62 (YD ++ grpF 85 5)) (RelX x 87) (rseg p 87 62 425 450) [] :=
    plan.rseg0
  have cl : CRel (RowRelE k x 87 ((YE ++ grpF 1 84) ++ lowTail)) Eq (closeSel p) closeRef :=
    plan.close
  refine crel_append (crel_headX k x) (crel_sel_cons (junctionE plan.junction)
    (crel_append (sharedE k x 12 _ headE (grpF_away 12 (by decide) 98 2 (by decide)))
    (crel_sel_cons (segE r4)
    (crel_append (sharedE k x 22 _ YA (grpF_away 22 (by decide) 96 2 (by decide)))
    (crel_sel_cons (segE r3)
    (crel_append (sharedE k x 32 _ YB (grpF_away 32 (by decide) 93 3 (by decide)))
    (crel_sel_cons (segE r2)
    (crel_append (sharedE k x 47 _ YC (grpF_away 47 (by decide) 90 3 (by decide)))
    (crel_sel_cons (segE r1)
    (crel_append (sharedE k x 62 _ YD (grpF_away 62 (by decide) 85 5 (by decide)))
    (crel_sel_cons (segE r0)
    (crel_append (sharedE k x 87 _ YE (grpF_away 87 (by decide) 1 84 (by decide)))
    (crel_append (sharedE k x 87 _ (YE ++ grpF 1 84) low_away)
    (crel_append cl (crel_eq_shared (closeTail k))))))))))))))))

/-- **Multiplication core from the plans** (one per input). -/
theorem exitRem_of_planR {p : StairSchedule.StairPrimitives} {k : Nat}
    (plan : ∀ x, ExitPlanR p k x) :
    RunEqOn (StairField2V3Core.ExitMiddle k) (selRem p k) (exitReferenceRemainder k) := by
  intro s hs fresh old
  obtain ⟨x, hx⟩ := exitMiddle_x k s hs
  have h : RunEqOn (ExitMiddleX k x) (selRem p k) (exitReferenceRemainder k) := by
    rw [selRem_shape, refRem_shape]
    apply runEqOn_of_coupled (chain_of_planR (plan x))
    intro t ht
    have h := StairField2V3Core.exitReferenceRemainder_tapeFree k t (exitMiddle_of_x k x t ht)
      (StairField2V3ExitPlanFree.kernelXN_tapeFree k)
    rw [refRem_shape] at h
    exact h
  exact h s hx fresh old

theorem exitCore_of_planR
    (plan : ∀ k x, ExitPlanR StairConcreteAssembly.checkpointPrimitives k x) :
    StairCertificate.CodecFunctionalSpec StairField2V3Core.Assembly → ∀ k,
      RunEqOn (StairField2V3Core.ExitMiddle k)
        (exitSelectedRemainder StairField2V3Core.Assembly k)
        (exitReferenceRemainder k) := fun _ k => by
  rw [selRem_eq]
  exact exitRem_of_planR (plan k)


end ECDSAAdd.Entrant.StairField2V3ExitPlanR

end
end Merge_StairField2V3ExitPlanR_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3EntryPlanR_at_Main` -/
section Merge_StairField2V3EntryPlanR_at_Main

/-!
# LT43g: the division plan with reachability and a pinned input

LT21's `EntryPlan` relates the two division runs by `Rel (Δv B) (Cv B)`, where
`Cv B` only knows *some* input consistent with the record transcript on
`futurePayload B`.  The last step, however, needs the history letter `s 510` of the
*genuine* input (LT43c, finding F3).  `EntryPlanR p x` is the pinned mirror of
`EntryPlan`, exactly as `ExitPlanR` on the multiplication side: the reference state is
reached from a division input of input `x` (`ReachEn x X t`), and the side condition
is `CvX x B`.

`entryArith_of_planR` / `entryCore_of_planR` turn one plan per input into the
division core of field 2.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3EntryPlanR

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairField2V3Replay StairField2V3Couple StairField2V3Entry
open StairField2V3Delta StairField2V3Seg StairField2V3ExitPlanR
open StairPhysicalLayout StairOuterPlacement

/-! ## Division inputs with a pinned input -/











/-- Every remaining division obligation for input `x`. -/
structure EntryPlanR (p : StairSchedule.StairPrimitives) (x : Nat) where
  junction : CRel (J0X x) (RelX x 87) (selJ0 p) refJ0
  seg0 : CRel (RowRelEn x 87 R1) (RelX x 62) (seg p 87 62 425 450) []
  seg1 : CRel (RowRelEn x 62 R2) (RelX x 47) (seg p 62 47 450 465) []
  seg2 : CRel (RowRelEn x 47 R3) (RelX x 32) (seg p 47 32 465 480) []
  seg3 : CRel (RowRelEn x 32 R4) (RelX x 22) (seg p 32 22 480 490) []
  seg4 : CRel (RowRelEn x 22 R5) (RelX x 12) (seg p 22 12 490 500) []
  lastStep : CRel (RowRelEn x 12 R6) Eq (lastSeg p) []

/-! ## The chain -/




theorem junctionEn {p : StairSchedule.StairPrimitives} {x : Nat}
    (h : CRel (J0X x) (RelX x 87) (selJ0 p) refJ0) :
    CRel (J0X x) (RowRelEn x 87 R0) (selJ0 p) refJ0 :=
  junction_track_gen (EntryPreX x) prefixW h


theorem chain_of_planR {p : StairSchedule.StairPrimitives} {x : Nat} (plan : EntryPlanR p x) :
    CRel (fun s t => EntryPreX x s ∧ s = t) Eq
      (prefixW ++ (selJ0 p ++ (firstPkt ++ (grp 1 84 ++ (seg p 87 62 425 450 ++ (grp 85 5 ++
        (seg p 62 47 450 465 ++ (grp 90 3 ++ (seg p 47 32 465 480 ++ (grp 93 3 ++
        (seg p 32 22 480 490 ++ (grp 96 2 ++ (seg p 22 12 490 500 ++ (grp 98 2 ++
        (lastSeg p ++ tailP)))))))))))))))
      (prefixW ++ (refJ0 ++ (firstPkt ++ (grp 1 84 ++ (grp 85 5 ++ (grp 90 3 ++ (grp 93 3 ++
        (grp 96 2 ++ (grp 98 2 ++ tailP))))))))) := by
  have s0 : CRel (RowRelEn x 87 ((R0 ++ firstPkt) ++ grp 1 84)) (RelX x 62)
      (seg p 87 62 425 450) [] := plan.seg0
