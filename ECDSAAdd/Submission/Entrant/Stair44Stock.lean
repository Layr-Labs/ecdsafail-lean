/-! ## Division -/

theorem junctionX (x : Nat) : CRel (J0X x) (RelX x 87) (selJ0 P) refJ0 := by
  rintro s t ⟨hst, s0, m, ⟨f, hf⟩, hs⟩ fresh
  subst hst
  have ha : Adm ExtraSel f.x (run prefixW m s0) :=
    StairField2V3ExitRecClose.adm_frame ExtraSel StairField2V3JuncSel2.extraSel_genuine s0 f m
  rw [hf, ← hs] at ha
  exact ⟨[], StairField2V3JuncSel2.junc x s ha fresh []⟩

theorem lastStepX (lastRecX : LastRecX) (x : Nat) :
    CRel (RowRelEn x 12 R6) Eq (lastSeg P) [] := by
  refine lastX_of_spec P x (lastΦx x) (lastSpec_pinned x) ?_
  rintro t ⟨s0, m, ⟨f, hf⟩, ht⟩
  rw [ht]
  exact lastRecX x s0 f hf m

/-- **The pinned division plan.** -/
def entryPlanR (lastRecX : LastRecX) (x : Nat) : EntryPlanR P x where
  junction := junctionX x
  seg0 := segX_of_spec P x 87 62 425 450 R1 StairField2V3EntryC.sub62
    StairField2V3SegSpec.spec0 StairField2V3RecScratch.rec0
  seg1 := segX_of_spec P x 62 47 450 465 R2 StairField2V3EntryC.sub47
    StairField2V3SegSpec.spec1 StairField2V3RecScratch.rec1
  seg2 := segX_of_spec P x 47 32 465 480 R3 StairField2V3EntryC.sub32
    StairField2V3SegSpec.spec2 StairField2V3RecScratch.rec2
  seg3 := segX_of_spec P x 32 22 480 490 R4 StairField2V3EntryC.sub22
    StairField2V3SegSpec.spec3 StairField2V3RecScratch.rec3
  seg4 := segX_of_spec P x 22 12 490 500 R5 StairField2V3EntryC.sub12
    StairField2V3SegSpec.spec4 StairField2V3RecScratch.rec4
  lastStep := lastStepX lastRecX x

/-! ## Multiplication -/

/-- LT47: the exit junction on the fixed program.  `firstSel = SXW ++ WT`; `SXW` takes
the record state to `sxState`, which is `FT` of the partner, and `WT` undoes `FT`. -/
theorem junctionRX (k x : Nat) (rec : JuncRecE k x (lastΦx x)) :
    CRel (JEX k x) (RelX x 12) (firstSel StairExitLT24.P) [] := by
  rintro s t ⟨hst, hR⟩ fresh
  subst hst
  obtain ⟨hΦ, origin, ho, hv⟩ := rec s hR
  have hσ := partner_rel x 12 s origin ho hv
  set σ := partner x 12 s
  have eF : firstSel StairExitLT24.P = StairField2V3Win.SXW ++ StairExitLT24.WT := by
    simp only [firstSel, StairField2V3Win.SXW, StairExitLT24.WT, StairExitLT24.wrap, liftF,
      List.append_assoc]
  have hFT : StairExitLT24.FT = liftF (StairSchedule.forwardLast StairExitLT24.P) := by
    simp only [StairExitLT24.FT, StairExitLT24.wrap, liftF]
  have ft : run StairExitLT24.FT [] σ = StairField2V3Win.sxState (StairField2V3LastSpec.s510 x) s := by
    rw [hFT]
    exact StairField2V3LastSpec.ftSpec_pinned x σ s hσ.1 hσ.2 hΦ []
  have key : run (StairField2V3Win.SXW ++ StairExitLT24.WT) fresh s = σ := by
    rw [run_append, StairField2V3LastSpec.sx_pinned_bwd x s hΦ, ← ft]
    exact lastTrip_pinned x σ s hσ.1 (cvX_cv x 12 _ _ hσ.2) hΦ [] _
  refine ⟨[], ?_⟩
  show RelX x 12 (run (firstSel StairExitLT24.P) fresh s) s
  rw [eF, key]
  exact hσ

/-- **The multiplication plan.** -/
def exitPlanR (juncRecX : JuncRecX) (k x : Nat) : ExitPlanR P k x where
  junction := junctionRX k x (juncRecX k x)
  rseg4 := rsegR _ k x 22 12 490 500 YA StairField2V3EntryC.sub12
    (StairExitLT24RSeg.rspec_of_spec P 22 12 490 500 StairField2V3SegSpec.spec4
      StairField2V3TripLT42.trip4) (StairField2V3ExitRec.rr4 k x)
  rseg3 := rsegR _ k x 32 22 480 490 YB StairField2V3EntryC.sub22
    (StairExitLT24RSeg.rspec_of_spec P 32 22 480 490 StairField2V3SegSpec.spec3
      StairField2V3TripLT42.trip3) (StairField2V3ExitRec.rr3 k x)
  rseg2 := rsegR _ k x 47 32 465 480 YC StairField2V3EntryC.sub32
    (StairExitLT24RSeg.rspec_of_spec P 47 32 465 480 StairField2V3SegSpec.spec2
      StairField2V3TripLT42.trip2) (StairField2V3ExitRec.rr2 k x)
  rseg1 := rsegR _ k x 62 47 450 465 YD StairField2V3EntryC.sub47
    (StairExitLT24RSeg.rspec_of_spec P 62 47 450 465 StairField2V3SegSpec.spec1
      StairField2V3TripLT42.trip1) (StairField2V3ExitRec.rr1 k x)
  rseg0 := rsegR _ k x 87 62 425 450 YE StairField2V3EntryC.sub62
    (StairExitLT24RSeg.rspec_of_spec P 87 62 425 450 StairField2V3SegSpec.spec0
      StairField2V3TripLT42.trip0) (StairField2V3ExitRec.rr0 k x)
  close := closeR _ k x (Adm ExtraSel x) (StairField2V3JuncSel2.junc x)
    (StairField2V3JuncSel2.firstTrip_sel x) (refTrip_adm ExtraSel x)
    (StairField2V3ExitRecClose.closeRec_of ExtraSel StairField2V3JuncSel2.extraSel_genuine k x)

