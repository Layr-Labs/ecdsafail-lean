        have hin : (bs[k]'(hlenbs ▸ hk)).input = w it[k] := by
          have e1 : (bs.map ZeroBit.input)[k]'(by simpa using hlenbs ▸ hk) = (bs[k]'(hlenbs ▸ hk)).input := by
            simp
          have e2 : (it.map w)[k]'(by simpa using hk) = w it[k] := by simp
