    apply Classical.byContradiction
    intro h
    apply hne
    apply Nat.eq_of_testBit_eq
    intro i
    by_cases hi : i < 256
    · have : ¬ (a.testBit i != b.testBit i) = true := fun e =>
        h ⟨i, by simp [hi], e⟩
      simpa using this
    · exact hbig i (by omega)
  obtain ⟨j, hj, hjp⟩ := ex
