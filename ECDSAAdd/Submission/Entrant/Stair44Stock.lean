  · intro r hr
    obtain ⟨hfs, n1, n2⟩ := fp_class r hr
    rw [tv r hfs]
    rcases fs_class r hfs with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, -⟩ | ⟨h1, -⟩ | ⟨-, h2⟩
    · rw [h2]; exact onPk r h1 h2
