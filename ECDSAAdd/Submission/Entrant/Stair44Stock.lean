theorem evenBody_physical (K:MeasuredCanonicalModLayout) (g:Wire) (k:Nat) (hw:K.Widths 256)
    (hn:(g::K.wires).Nodup) (rest:List Wire) (hout:K.out=lowBit K::rest)
