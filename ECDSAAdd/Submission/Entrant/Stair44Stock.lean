/-- Replacing the middle program of a three-part composition by one with the
same run on every reached state preserves the run for a constructed tape. -/
theorem mid_replay (P Q Q₀ S : Program) (s : State) (m : List Bool)
    (h : ∀ a b, run Q b (run P a s) = run Q₀ b (run P a s)) :
    ∃ m', run (P ++ (Q ++ S)) m s = run (P ++ (Q₀ ++ S)) m' s := by
  let a := m.take (measurementCount P)
  let rest := m.drop (measurementCount P)
  let b := rest.take (measurementCount Q)
  let c := rest.drop (measurementCount Q)
  refine ⟨FlagEntry.pfx (measurementCount P) a ++
    (FlagEntry.pfx (measurementCount Q₀) b ++ c), ?_⟩
  have fresh : run (P ++ (Q ++ S)) m s = run S c (run Q b (run P a s)) := by
    simp only [run_append]
    rfl
  have old : run (P ++ (Q₀ ++ S))
      (FlagEntry.pfx (measurementCount P) a ++
        (FlagEntry.pfx (measurementCount Q₀) b ++ c)) s =
      run S c (run Q₀ b (run P a s)) :=
    ControlTapeDevelop.run_three_tapes P Q₀ S a b c s
  rw [fresh, old, h]

/-- `mid_replay` with two different first programs that run alike from `s`
(for every pair of tapes), e.g. LT40's square and the record square. -/
theorem mid_replay2 (P P₀ Q Q₀ S : Program) (s : State) (m : List Bool)
    (hP : ∀ a b, run P a s = run P₀ b s)
    (h : ∀ a b, run Q b (run P₀ a s) = run Q₀ b (run P₀ a s)) :
    ∃ m', run (P ++ (Q ++ S)) m s = run (P₀ ++ (Q₀ ++ S)) m' s := by
  let a := m.take (measurementCount P)
  let rest := m.drop (measurementCount P)
  let b := rest.take (measurementCount Q)
  let c := rest.drop (measurementCount Q)
  refine ⟨FlagEntry.pfx (measurementCount P₀) a ++
    (FlagEntry.pfx (measurementCount Q₀) b ++ c), ?_⟩
  have fresh : run (P ++ (Q ++ S)) m s = run S c (run Q b (run P a s)) := by
    simp only [run_append]
    rfl
  have old : run (P₀ ++ (Q₀ ++ S))
      (FlagEntry.pfx (measurementCount P₀) a ++
        (FlagEntry.pfx (measurementCount Q₀) b ++ c)) s =
      run S c (run Q₀ b (run P₀ a s)) :=
    ControlTapeDevelop.run_three_tapes P₀ Q₀ S a b c s
  rw [fresh, old, hP a a, h]

