theorem pcCore_eq(s:State)(m:List Bool)(hc:ExtraCarryDomain.Clean s.basis)
 (hz:∀q∈pad,s.basis q=false)(hb:∀q∈bank,s.basis q=false)(hi:s.basis cin=false)
