    fun r hr => fLow2 r (by simp only [List.mem_append, hr, true_or, or_true])
  have lowS : ∀ r ∈ scratchT B B', r < base 4000 :=
    fun r hr => fLow2 r (by simp only [List.mem_append, hr, or_true])
  have zh : ∀ q, q < base 4000 → (zeroHigh u).basis q = u.basis q := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = u.basis q
    rw [if_neg (Nat.not_le.mpr hq)]
  have pre1' : ∀ r ∈ futurePayload B, (zeroHigh u).basis r = cmpBits B x r :=
    fun r hr => (zh r (lowFP r hr)).trans (pre1 r hr)
  have pre2' : ∀ r ∈ scratchT B B', (zeroHigh u).basis r = false :=
    fun r hr => (zh r (lowS r hr)).trans (pre2 r hr)
  have hsh : ∀ q, base 4000 ≤ q → (zeroHigh u).basis q = false := by
    intro q hq
    show (if base 4000 ≤ q then false else u.basis q) = false
    rw [if_pos hq]
  have trip0 := trip_clean B B' hpair x origin hx (zeroHigh u) pre1' pre2' hsh c a
  set F := StairSchedule.forwardSegment StairConcreteAssembly.checkpointPrimitives B B'
    (startFor B) (startFor B') with hFdef
  set R := StairSchedule.reverseSegment StairConcreteAssembly.checkpointPrimitives B B'
    (startFor B) (startFor B') with hRdef
  have hF : ∀ q ∈ wires F, q < base 4000 := by
    rw [hFdef]
    exact seg_low B B' hpair
  have hR : ∀ q ∈ wires R, q < base 4000 := by
    rw [hRdef]
    exact rev_low B B' hpair
  obtain ⟨pA, aA, hA⟩ := low_pair F hF c u (zeroHigh u) (fun q hq => (zh q hq).symm)
  obtain ⟨pB, aB, hB⟩ := low_pair R hR a (run F c u) (run F c (zeroHigh u)) aA
  apply State.extensionality
  · have e1 : (run R a (run F c (zeroHigh u))).phase = u.phase := by
      have h := congrArg State.phase trip0
