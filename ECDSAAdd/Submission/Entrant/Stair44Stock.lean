  exitFirstUnpack := H.exitFirstUnpack
  exitTicks := H.exitTicks
  x1N := H.x1N
  firstPacketEntry := H.firstPacketEntry
  firstPacketExit := H.firstPacketExit
  scratchClear := ok_of_all hsub scratchClear_all
  scratchUnprefix := ok_of_all hsub scratchUnprefix_all
  groups := H.groups
  groupsExit := H.groupsExit
  endpointDiv := H.endpointDiv
  endpointMult := H.endpointMult
