        intro q hq
        have qx : q ∈ xs ∨ q ∈ work := by
          rcases hq with e | ⟨b, hb, e⟩
          · exact Or.inl (e ▸ p0x)
          · exact Or.inr (e ▸ bsW b hb)
        have ng : q ≠ W := by
