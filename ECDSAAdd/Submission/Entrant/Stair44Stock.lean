/-- The record's `merged_support`, restricted to the tail and to the tail's labels. -/
theorem tailX_tight (w : Nat → Wire) (g : Wire) (k : Nat) :
    wires (ParityXEntry.tailX w g k) ⊆ (tSites w g).toFinset := by
  have B := blk_tSites w g
