/-- The record B branch is the record wrapper around the record B body. -/
theorem branchBF760_eq :
    B95PortResearch.branchBF760 K0 E0 G0 =
      recBrB (B95SelectorResearch.hostedSelectedBody K0 (LowZero18Square.foldPerm K0 E0) G0) := rfl

theorem fastCore_eq :
    SumSavedB95Square.fastCore L0 A109SignResearch.body C105SignResearch.body =
      recBrC C105SignResearch.body ++ B95PortResearch.branchBF760 K0 E0 G0 ++
        recBrA A109SignResearch.body := rfl

/-- Counts of the new square against the record square, from the three branch deltas. -/
theorem squareN_counts (brC brB brA : Program) (dC dB dA : Nat) (k : Fp)
    (cC : toffoliCount brC = toffoliCount (recBrC C105SignResearch.body) + dC)
    (cB : toffoliCount brB = toffoliCount (B95PortResearch.branchBF760 K0 E0 G0) + dB)
    (cA : toffoliCount brA = toffoliCount (recBrA A109SignResearch.body) + dA)
    (mC : measurementCount brC = measurementCount (recBrC C105SignResearch.body))
    (mB : measurementCount brB = measurementCount (B95PortResearch.branchBF760 K0 E0 G0))
    (mA : measurementCount brA = measurementCount (recBrA A109SignResearch.body)) :
    toffoliCount (squareN brC brB brA k) = toffoliCount (A161Generic.squareEntry L0 k) + dC + dB + dA ∧
      measurementCount (squareN brC brB brA k) = measurementCount (A161Generic.squareEntry L0 k) := by
  rw [recordSquare_eq]
  have e1 : toffoliCount (StairSquareEntryR.entryRH (k - (C163Low4Offsets.delta : Fp))) =
        toffoliCount (E1ReflectedPlacement.entryR L0 (k - (C163Low4Offsets.delta : Fp))) ∧
      measurementCount (StairSquareEntryR.entryRH (k - (C163Low4Offsets.delta : Fp))) =
        measurementCount (E1ReflectedPlacement.entryR L0 (k - (C163Low4Offsets.delta : Fp))) :=
    StairSquareEntryR.entryRH_counts (k - (C163Low4Offsets.delta : Fp))
  have p1 := ReflectionE1Square.place_counts L0 (coreN brC brB brA)
  have p2 := ReflectionE1Square.place_counts L0
    (SumSavedB95Square.fastCore L0 A109SignResearch.body C105SignResearch.body)
  have q1 : toffoliCount (coreN brC brB brA) = toffoliCount brC + toffoliCount brB + toffoliCount brA ∧
      measurementCount (coreN brC brB brA) =
        measurementCount brC + measurementCount brB + measurementCount brA := by
    refine ⟨?_, ?_⟩ <;> simp only [coreN, toffoliCount_append, measurementCount_append]
  have q2 : toffoliCount (SumSavedB95Square.fastCore L0 A109SignResearch.body C105SignResearch.body) =
      toffoliCount (recBrC C105SignResearch.body) + toffoliCount (B95PortResearch.branchBF760 K0 E0 G0) +
        toffoliCount (recBrA A109SignResearch.body) ∧
      measurementCount (SumSavedB95Square.fastCore L0 A109SignResearch.body C105SignResearch.body) =
      measurementCount (recBrC C105SignResearch.body) +
        measurementCount (B95PortResearch.branchBF760 K0 E0 G0) +
        measurementCount (recBrA A109SignResearch.body) := by
    rw [fastCore_eq]; refine ⟨?_, ?_⟩ <;> simp only [toffoliCount_append, measurementCount_append]
  simp only [squareN, placedN, SumSavedB95Square.program, toffoliCount_append, measurementCount_append,
    p1.1, p1.2, p2.1, p2.2, e1.1, e1.2]
  constructor <;> omega



