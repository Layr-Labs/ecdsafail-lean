  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ph3, ph2, ph1]
  · intro r hr
    rw [cmpBits_eq]
    by_cases hrr : r ∈ restLetters B
    · obtain ⟨i, hi, hiq, hval⟩ := registerBasis_mem _ (restWord B x) r hrr
      rw [hval, registerBasis_not_mem _ _ _ (fun h => (haF _ h).1 hrr), Bool.or_false]
