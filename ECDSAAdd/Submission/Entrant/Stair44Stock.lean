    · exact ⟨hb A rA.1 rA.2, rB⟩
  have heq := narrowSkywalkTick_eq L hv L.half.length hn le_rfl A B G hp hr.1.1 hr.1.2 hr.2.1 hr.2.2 s m₁ hin
