set_option maxHeartbeats 8000000 in
/-- The hosted generic program and the record's `genericN` have equal runs
(constructed record tape) on every `PointDialogValues` start state. -/
theorem generic_eqD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hE : EntrySupportD)
    (hX : ExitSupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (cx cy X Y : Fp) (G : Bool) (s : State) (e : Bool)
    (hv : PointDialogValues L X Y G s.basis s.basis)
    (he : e = (if s.basis L.core.generic then
      decide (EntryFuseArithmetic.prime ≤ X.val + (-cx).val) else false))
    (hg : pkW L ≠ L.core.generic)
    (hx1 : X+(if G then -cx else 0)≠0)
    (hx2 : (X+(if G then -cx else 0))-
        (if G then ((Y+(if G then -cy else 0))/(X+(if G then -cx else 0)))*
          ((Y+(if G then -cy else 0))/(X+(if G then -cx else 0))) else 0)+
        (if G then (SquareCarryLoan719BF.K:Fp) else 0)+
        (if G then ReflectionE1.correction cx else 0)≠0)
    (m : List Bool) :
    ∃ m', run (StairConcreteAssembly.hostedGeneric L cx cy) m (put s (pkW L) e) =
      run (genericN L cx cy) m' (put s (pkW L) e) := by
  subst he
  have hEq := entryStage_eqD H hE L hw hn cx cy X Y G s hv hg hx1
    (m.take (measurementCount ((entryYAll L (-cy) ++ entryXNew L (pkW L) (-cx)) ++
      StairConcreteAssembly.hostedEntryRest L))) []
  have w0v := entryStageAll_step L hw hn X Y (-cx) (-cy) G s.basis hx1 s (padE L cy cx []) hv
  rw [← (head_pad L hw hn cx cy X Y s hv.x hv.y hv.clean hg).run_eq []] at w0v
  obtain ⟨m2, h2⟩ := secondStage_eqD H hX L hw hn
    (ReflectionE1.correction cx) cy cx _ _ G s.basis _ w0v.2 hx2
    (m.drop (measurementCount ((entryYAll L (-cy) ++ entryXNew L (pkW L) (-cx)) ++
      StairConcreteAssembly.hostedEntryRest L)))
  refine ⟨pfx (measurementCount ((entryYAll L (-cy) ++ entryXNew L (pkW L) (-cx)) ++
    restEntry L)) [] ++ m2, ?_⟩
  rw [StairConcreteAssembly.hostedGeneric, run_append, hEq, h2, genericN, run_pre]

set_option maxHeartbeats 8000000 in
/-- Hosted counterpart of `FlagExit.generic_padp_true` (same hypotheses). -/
theorem generic_eq_trueD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hE : EntrySupportD)
    (hX : ExitSupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (X Y cx cy : Fp) (s : State) (e : Bool)
    (hv : PointDialogValues L X Y true s.basis s.basis)
    (he : e = (if s.basis L.core.generic then
      decide (EntryFuseArithmetic.prime ≤ X.val + (-cx).val) else false))
    (hXc : X≠cx) (hd : cx-genericX X Y cx cy≠0) (hg : pkW L ≠ L.core.generic)
    (m : List Bool) :
    ∃ m', run (StairConcreteAssembly.hostedGeneric L cx cy) m (put s (pkW L) e) =
      run (genericN L cx cy) m' (put s (pkW L) e) := by
  let a:=genericSlope X Y cx cy
  let d:=cx-genericX X Y cx cy
  have hvv:=generic_inplace_values X Y cx cy hXc
  have ha : (Y-cy)/(X-cx)=a:=rfl
  have hd4 : (X-cx)-a*a+(SquareCarryLoan719BF.K:Nat)+ReflectionE1.correction cx=d := by
    have e:=hvv.2.1
    change (X-cx)-a*a+3*cx=d at e
    rw [←e]
    unfold ReflectionE1.correction
    ring
  apply generic_eqD H hE hX L hw hn cx cy X Y true s e hv he hg
  · simpa only [if_true,←sub_eq_add_neg] using sub_ne_zero.mpr hXc
  · simp only [if_true,←sub_eq_add_neg,ha]
    rw [hd4]
    exact hd

set_option maxHeartbeats 8000000 in
/-- Hosted counterpart of `FlagExit.generic_padp_false` (same hypotheses). -/
theorem generic_eq_falseD
    (H : ∀ k, StairSemanticComposition.HostedReplayInterface k)
    (hE : EntrySupportD)
    (hX : ExitSupportD)
    (L : ControlledPointLayout) (hw : L.Widths) (hn : L.wires.Nodup)
    (X Y cx cy : Fp) (s : State) (e : Bool)
    (hv : PointDialogValues L X Y false s.basis s.basis)
    (he : e = (if s.basis L.core.generic then
      decide (EntryFuseArithmetic.prime ≤ X.val + (-cx).val) else false))
    (hX0 : X≠0) (hg : pkW L ≠ L.core.generic) (m : List Bool) :
    ∃ m', run (StairConcreteAssembly.hostedGeneric L cx cy) m (put s (pkW L) e) =
      run (genericN L cx cy) m' (put s (pkW L) e) := by
  apply generic_eqD H hE hX L hw hn cx cy X Y false s e hv he hg
  · simpa only [Bool.false_eq_true,if_false,add_zero] using hX0
  · simpa only [Bool.false_eq_true,if_false,add_zero,sub_zero] using hX0

end Generic

