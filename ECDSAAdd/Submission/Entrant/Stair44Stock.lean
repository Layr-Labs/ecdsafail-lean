    simp only [InputSentinel.otail2,InputSentinel.leaves,if_true,wires_append,wires,Finset.mem_union]
    rcases hq with h|h|h|h|h|h|h <;> simp only [h,true_or,or_true]

theorem otail2_slots_delta (a1 s2 b2 yc y2c e:Bool) :
    gateSlots (otail2 a1 s2 b2 yc y2c e)≤gateSlots (InputSentinel.otail2 a1 s2 b2 yc y2c e)+12 := by
  cases e
  · unfold OutputOpt.otail2
    simp only [Bool.false_eq_true,ite_false]
    exact Nat.le_add_right _ _
  · cases a1 <;> cases s2 <;> cases b2 <;> cases yc <;> cases y2c <;> decide +kernel

