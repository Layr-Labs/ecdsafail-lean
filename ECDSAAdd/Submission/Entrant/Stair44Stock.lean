section Merge_StairField2V3Decode_at_Main

/-!
# LT21: the decoded checkpoint after `unpack B`

On a tail state holding the stored checkpoint `cmpBits B x` on the row's
future payload, clean on the row's scratch, and clean on the shadow labels
(`≥ base 4000`, never touched by any v3 primitive), the full `unpack B`
(unrelocation, codec unpack, sign copy) produces LT30's `Decoded` checkpoint
(`decoded_after_unpack`).  The zero sites are collected in `ZList B`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairField2V3Decode

open ECDSAAdd Arithmetic RecordedQuantum Challenge
open MappedCompressed
open StairPhysicalLayout StairField2V3Seg StairField2V3Codec StairField2V3Unpack StairField2V3Pack











/-! ## LT49 (replay budget): `ZList B` as a bit-mask literal

`ZList B` is a quadratic filter (`futurePayload` / `unpackSites` membership per site); the
kernel re-evaluated it for every fact.  Its bit mask is checked once per budget
(`zlMask_eq`) and membership becomes a `Nat.testBit` on a literal (`mem_zl`). -/








/-! ## K4C (replay budget): the `ZFacts*` range checks on their non-trivial parts only

Above label `513` (below `770`), between `858` and `1027`, and from `1627` on, `segMap` is the
shadow branch `base (4000 + q)`, so `base 4000 ≤ segmentMap B j` holds symbolically
(`k4d_hi`); the kernel only checks the remaining ids. -/











/-! ## The decoded checkpoint -/


/-- Everything `ZList` promises holds right after `unpack B`. -/
theorem zlist_zero (B : Nat) (hB : B ∈ budgets) (x : Nat) (hx0 : 0 < x) (hx : x < ECDSAAdd.p)
    (u : State) (pre1 : ∀ r ∈ futurePayload B, u.basis r = cmpBits B x r)
    (pre2 : ∀ r ∈ rowSites B ++ allBC, r ∉ futurePayload B → u.basis r = false) (m : List Bool) :
    (run (StairPhysicalPrimitives.unpack B) m u).phase = u.phase ∧
    StairCodec.CodecInput (physicalLayout B) B
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).u
      (StairBridgeDomain.realNatState x ECDSAAdd.p (startFor B)).v
      (StairBridgeDomain.realSign x ECDSAAdd.p (startFor B))
      (run (StairPhysicalPrimitives.unpack B) m u).basis ∧
    (run (StairPhysicalPrimitives.unpack B) m u).basis (bSite B) =
      StairBridgeDomain.realSign x ECDSAAdd.p (startFor B) ∧
    (∀ q ∈ ZList B, (run (StairPhysicalPrimitives.unpack B) m u).basis q = false) ∧
    (∀ q, q ∉ unpackSites B → (run (StairPhysicalPrimitives.unpack B) m u).basis q = u.basis q) := by
  obtain ⟨hbM, hbS, hbD, hbA, hbC, hbcase, _, _, hlow⟩ := zFacts B hB
  have pre2r : ∀ r ∈ rowSites B, r ∉ futurePayload B → u.basis r = false :=
    fun r hr hf => pre2 r (List.mem_append_left _ hr) hf
  rw [unpack_split, run_append]
  set k := measurementCount (unrelocate B ++ StairCodec.unpack (physicalLayout B) B)
  obtain ⟨ph1, ci, out1⟩ := codecInput_after_unpack B hB x hx0 hx u pre1 pre2r (m.take k)
  set u1 := run (unrelocate B ++ StairCodec.unpack (physicalLayout B) B) (m.take k) u
  obtain ⟨ph2, hb2, out2⟩ := StairBridgeSign.signExtend_run ((physicalLayout B).D (B - 1)) (bSite B) u1
    (m.drop k)
  have hbDecl : bSite B ∉ StairCodec.declaredSites (physicalLayout B) B := by
    rw [declared_eq]
    intro h
    rcases h with h | h | h | h
    · exact hbS h
    · exact hbD h
    · exact hbA h
    · exact hbC h
  have u1b : u1.basis (bSite B) = false := by
    rw [out1 _ hbM hbDecl]
    rcases hbcase with ⟨hr, hf⟩ | ⟨hf, hr, ha⟩
    · exact pre2r _ hr hf
    · rw [pre1 _ hf, cmpBits_eq, registerBasis_not_mem _ _ _ hr, registerBasis_not_mem _ _ _ ha]
      rfl
  have hdom := domain_row B hB x hx0 hx
  have top := StairField2V3Boundary.signedWord_topBit (physicalLayout B) B _ _ _ hdom u1.basis ci.2.1
  have hwb : ∀ q ∈ StairCodec.workSites (physicalLayout B) B, q ≠ bSite B := by
    intro q hq e
    rw [StairField2V3End.workSites_eq, List.mem_append] at hq
    rcases hq with hq | hq
    · exact hbA (e ▸ hq)
    · exact hbC (e ▸ hq)
  refine ⟨ph2.trans ph1, ?_, ?_, ?_, ?_⟩
  · refine StairField2V3Pack.codecInput_congr _ _ _ _ _ u1.basis _ ?_ ci
    intro q hq
    exact (out2 q (fun e => hbDecl (e ▸ hq))).symm
  · rw [hb2, u1b, top]
    simp
  · intro q hq
    unfold ZList at hq
    rcases List.mem_append.mp hq with hq12 | hq3
    · rcases List.mem_append.mp hq12 with hq1 | hw
      · obtain ⟨hrow, hpred⟩ := List.mem_filter.mp hq1
        rw [Bool.and_eq_true] at hpred
        have hf := of_decide_eq_true hpred.1
        have hu := of_decide_eq_true hpred.2
        have hqb : q ≠ bSite B := fun e => hu (by simp [unpackSites, e])
        have hqM : q ∉ moveSites (unrelocPairs B) := fun h => hu (by simp [unpackSites, h])
        have hqD : q ∉ StairCodec.declaredSites (physicalLayout B) B :=
          fun h => hu (by simp [unpackSites, h])
        rw [out2 q hqb, out1 q hqM hqD]
        exact pre2 q hrow hf
      · rw [out2 q (hwb q hw)]
        exact ci.2.2 q hw
    · obtain ⟨hf, hpred⟩ := List.mem_filter.mp hq3
      rw [Bool.and_eq_true, Bool.and_eq_true] at hpred
      have hr := of_decide_eq_true hpred.1.1
      have ha := of_decide_eq_true hpred.1.2
      have hu := of_decide_eq_true hpred.2
      have hqb : q ≠ bSite B := fun e => hu (by simp [unpackSites, e])
      have hqM : q ∉ moveSites (unrelocPairs B) := fun h => hu (by simp [unpackSites, h])
      have hqD : q ∉ StairCodec.declaredSites (physicalLayout B) B :=
        fun h => hu (by simp [unpackSites, h])
      rw [out2 q hqb, out1 q hqM hqD, pre1 q hf, cmpBits_eq, registerBasis_not_mem _ _ _ hr,
        registerBasis_not_mem _ _ _ ha]
      rfl
  · intro q hq
    have hqb : q ≠ bSite B := fun e => hq (by simp [unpackSites, e])
    have hqM : q ∉ moveSites (unrelocPairs B) := fun h => hq (by simp [unpackSites, h])
    have hqD : q ∉ StairCodec.declaredSites (physicalLayout B) B :=
      fun h => hq (by simp [unpackSites, h])
    rw [out2 q hqb, out1 q hqM hqD]

/-- **After `unpack B` the checkpoint is LT30's `Decoded`.** -/
theorem decoded_after_unpack (B : Nat) (hB : B ∈ budgets) (x : Nat) (hx0 : 0 < x)
    (hx : x < ECDSAAdd.p) (u : State) (pre1 : ∀ r ∈ futurePayload B, u.basis r = cmpBits B x r)
    (pre2 : ∀ r ∈ rowSites B ++ allBC, r ∉ futurePayload B → u.basis r = false)
    (hsh : ∀ q, base 4000 ≤ q → u.basis q = false) (m : List Bool) :
    StairFirstTickV3.Decoded B x ECDSAAdd.p (run (StairPhysicalPrimitives.unpack B) m u).basis := by
  obtain ⟨_, _, _, _, _, _, h512, h717, hlow⟩ := zFacts B hB
  obtain ⟨_, ci, hb, hz, hout⟩ := zlist_zero B hB x hx0 hx u pre1 pre2 m
  have zero_or : ∀ q, base 4000 ≤ q ∨ q ∈ ZList B →
      (run (StairPhysicalPrimitives.unpack B) m u).basis q = false := by
    rintro q (hq | hq)
    · rw [hout q (fun h => absurd (hlow q h) (Nat.not_lt.mpr hq))]
      exact hsh q hq
    · exact hz q hq
  apply StairFirstTickV3.decoded_of_codec B hB x ECDSAAdd.p (StairField2V3Walk.p_hyp x hx0 hx) _
    ci.1 ci.2.1 (zero_or _ (Or.inr h512)) hb (zero_or _ (Or.inr h717))
  · intro j h1 h2
    exact zero_or _ (zFactsA B hB j (List.mem_range'_1.mpr ⟨h1, by unfold pw; omega⟩))
  · intro j h1 h2
    exact zero_or _ (zFactsB B hB j (List.mem_range'_1.mpr ⟨h1, by unfold pw; omega⟩))
  · intro j h1 h2
    exact zero_or _ (zFactsS B hB j (List.mem_range'_1.mpr ⟨h1, by omega⟩))
  · have h := regValue_of_bits (wireBlock (segmentMap B) 1540 257)
      (run (StairPhysicalPrimitives.unpack B) m u).basis 0 (by
        intro i hi
        rw [Nat.zero_testBit]
        have hi' : i < 257 := by simpa [wireBlock] using hi
        have e : (wireBlock (segmentMap B) 1540 257)[i] = segmentMap B (1540 + i) := by
          simp [wireBlock, List.getElem_map, List.getElem_range']
        rw [e]
        exact zero_or _ (zFactsC B hB (1540 + i) (List.mem_range'_1.mpr ⟨by omega, by omega⟩)))
    rw [h, Nat.zero_mod]

end ECDSAAdd.Entrant.StairField2V3Decode

end
end Merge_StairField2V3Decode_at_Main

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairField2V3SegSpec_at_Main` -/
section Merge_StairField2V3SegSpec_at_Main

/-!
# LT42: the forward-segment spec `SegSpecT` for the five middle rows

Assembly of LT21's segment ingredients (codec unpack, LT30's first moved tick
and virtual middle stage, orientation at the row end, the closing packet, the
codec pack) into `StairField2V3Seg.SegSpecT` for the concrete CANON v3
