  obtain ⟨c,d,e,tail,rfl⟩ : ∃c d e tail,src=c::d::e::tail := by
    match src,hs with
    | c::d::e::tail,_ => exact ⟨c,d,e,tail,rfl⟩
    | [],h => simp at h
