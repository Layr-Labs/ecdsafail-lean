theorem loan2_run (g v u0 u1 u2 e0 e1 host : Wire)
 (hg:g≠host) (hv:v≠host) (h0:u0≠host) (h1:u1≠host) (h2:u2≠host)
 (he0:e0≠host) (he1:e1≠host) (s:State) (m:List Bool)
