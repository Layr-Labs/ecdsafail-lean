    have := fwdCCC_spec g cl u d hU hu32 ws2 cache cr cS cZ hCache (eU L) heR heS heZ (by omega) cache1 cr1 cS1 cZ1 cC1 hCache1 cache2 cr2 cS2 cZ2 cC2 hCache2
    rw [key] at this; exact this
