 (h:rho L.core.sumCarry=L.core.sumCarry)(hv:rho (bit1 L.core.high)=bit1 L.core.high):
 hostedBody L rho c=body L c:=by
 have iv:rho.symm (bit1 L.core.high)=bit1 L.core.high:=by
  apply rho.injective
