  have hT_lt : regValue cfgC.T u.basis < 2 ^ 130 := by
    rw [st.2.2.1, Nat.mul_assoc]; have : a * b < 2 ^ 64 * 2 ^ 65 := Nat.mul_lt_mul'' haLt hbLt; omega
  have bT130 : u.basis (E0.getD 130 0) = false := by
