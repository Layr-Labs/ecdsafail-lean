    exact ⟨by simp [DiagSq.cost, bA, bB, hA, hB], by simp [DiagSq.parR, loA, loB, hiA, hiB, sA, sB]⟩
  have eQ1 := c_eq c.Q1 (LowZero18LowK.iregs K0 E0 src dst) w1.1 wiOld 32 rfl rfl
