    (hkLen : keepBits + parkHosts.length = c.n)
    (hkPos : 0 < keepBits)
    (hsrcLen : c.src.length = c.n)
    (hParkNd : parkHosts.Nodup)
    (hParkIn : ∀ h ∈ parkHosts, h ∈ E0 ∨ h = ControlLoan1589BFFold.eU K0)
