theorem Inputs.roundtripMove {j : Fin 26} (h0 : 0 ≤ j.val) (h1 : j.val ≤ 24) {s : State} {z : SkywalkNat.State}
    {g0 s0 : Bool} (h : Inputs j s z g0 s0) (m n : List Bool) : run (Shadow7.leaveMoveInvP j) n (run (Shadow7.leaveMoveP j) m s) = s := by
