namespace ECDSAAdd.Entrant.StairPacket.Leave285FrameHistory
open Arithmetic IntegerPacket MappedCompressed WideReference SkywalkRails Partial LeaveSelector
set_option maxRecDepth 40000
set_option maxHeartbeats 3500000

theorem result (x p : Nat) (good:Bounds x p) (raw s:State) (m:List Bool) (g sg:Bool)
    (domain:Domain 285 x p raw)
    (input:InputAt 285 (encode g sg (unsigned 285 x p).u (unsigned 285 x p).v) raw)
    (record:physicalCells 14 s=SkywalkTrace.trace 15 (encode g sg (unsigned 285 x p).u (unsigned 285 x p).v))
    (kept:physicalCells 14 (run leave285 m s)=physicalCells 14 s)
    (extra:∀q:Wire,Leave285ReleasedOrigin.agreeSite q → (run leave285 m s).basis q=(origin 285 raw s).basis q) :
    ∀q,Leave285AssembleCut.leftovers q → q∉WideReference.foldSites285 → (run leave285 m s).basis q=(origin 285 raw s).basis q := by
  let out:=run leave285 m s
  let o:=origin 285 raw s
  have geo : ∀i:Fin 15,windowNet 14 (ports (shape 14) i.val).a0=301+i.val ∧
      windowNet 14 (ports (shape 14) i.val).history=Leave285Hit.swaps i.val := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have agree (i:Fin 15) : out.basis (301+i.val)=o.basis (301+i.val) ∧
      out.basis (Leave285Hit.swaps i.val)=o.basis (Leave285Hit.swaps i.val) := by
    have old:=recorded_equal _ _ _ _ (by decide) places285 good raw s domain g sg input record i
    have now:=congrArg (fun a=>StairArchiveRaw.read a i.val) kept
    change StairArchiveRaw.read (readCells (shape 14) 0 15 (mappedBasis 14 out.basis)) i.val =
      StairArchiveRaw.read (readCells (shape 14) 0 15 (mappedBasis 14 s.basis)) i.val at now
    rw [read_cells _ _ _ _ _ i.isLt,read_cells _ _ _ _ _ i.isLt,Nat.zero_add] at now
    have eq:=now.trans old
    change (out.basis (windowNet 14 (ports (shape 14) i.val).a0),out.basis (windowNet 14 (ports (shape 14) i.val).history)) =
      (o.basis (windowNet 14 (ports (shape 14) i.val).a0),o.basis (windowNet 14 (ports (shape 14) i.val).history)) at eq
    rw [(geo i).1,(geo i).2] at eq
    exact ⟨congrArg Prod.fst eq,congrArg Prod.snd eq⟩
  have previous : out.basis 300=o.basis 300 := by
    rw [show o.basis 300=s.basis 300 from inside _ _ _ _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))]
    have stable : ECDSAAdd.Entrant.StairPacket.LeaveSelector.parityAt 300 leave285=some false := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    simpa [out] using polarity _ _ _ stable s m
  let gs:=(List.finRange 15).map (fun i=>301+i.val)
  let ss:=(List.finRange 15).map (fun i=>Leave285Hit.swaps i.val)
  intro q residual unfolded
  by_cases prev:q=300
  · subst q;exact previous
  by_cases gg:q∈gs
  · obtain ⟨i,_,rfl⟩:=List.mem_map.mp gg;exact (agree i).1
  by_cases sw:q∈ss
  · obtain ⟨i,_,rfl⟩:=List.mem_map.mp sw;exact (agree i).2
  have census : ∀a:Fin 1813,Leave285AssembleCut.leftovers a.val → a.val≠300 → a.val∉gs → a.val∉ss → a.val∉WideReference.foldSites285 →
      Leave285ReleasedOrigin.agreeSite a.val := by
    unfold Leave285AssembleCut.leftovers; dsimp only [gs,ss];set_option synthInstance.maxSize 4096 in decide +kernel
  have bound:q<1813:=by unfold Leave285AssembleCut.leftovers at residual;simp only [Wire] at *;omega
  exact extra q (census ⟨q,bound⟩ residual prev gg sw unfolded)
end ECDSAAdd.Entrant.StairPacket.Leave285FrameHistory

