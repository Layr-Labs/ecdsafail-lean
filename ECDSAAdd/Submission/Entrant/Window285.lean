theorem inverts (s:State) (phase:∀m,(run Partial.leave300 m s).phase=s.phase)
    (initial:∀q, 1556≤q → q≤1679 → s.basis q=false)
    (extra:∀q, 1690≤q → q≤1741 → s.basis q=false)
