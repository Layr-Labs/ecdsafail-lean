    have eq:=now.trans old
    change (out.basis (windowNet 15 (ports (shape 15) i.val).a0),out.basis (windowNet 15 (ports (shape 15) i.val).history)) =
      (o.basis (windowNet 15 (ports (shape 15) i.val).a0),o.basis (windowNet 15 (ports (shape 15) i.val).history)) at eq
    rw [(geo i).1,(geo i).2] at eq
