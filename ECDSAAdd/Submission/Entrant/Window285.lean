    285+r.val+16+W.compactSkywalkTickPreWidth (285+r.val)≤529:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem placements (q:Nat) (ext:Exterior 285 529 q) (nf:¬(1301≤q ∧ q≤1328)) :
    (OB5.sig (285+14) q=q ∧ OB5.sig (285-1) q=q) ∧ ¬MayTouch idx (windowNet idx q):=by
