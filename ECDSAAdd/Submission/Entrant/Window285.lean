namespace ECDSAAdd.Entrant.StairPacket.EndTick
open Arithmetic MappedCompressed Secp256k1 ArchiveBoundary315 ParkEndpoint
set_option maxRecDepth 30000
set_option maxHeartbeats 3000000
attribute [local irreducible] run
theorem no_phase (d:Bool) (x:Nat) (hx0:0<x) (hx:x<p) (raw original:State) (read:Reads raw original)
    (stage:Rolling1588.Integer.Stage base d x p 315 original.basis) : (run canonical [] raw).phase=raw.phase := by
  obtain ⟨ref,hs,ag⟩:=local_reference 315 (by decide) d x original stage
  have ⟨hp0,hpo,hp,cop⟩:=StackOB5.prime_facts x hx0 hx
  have gap:p+2^32≤2^256:=by norm_num [p]
  have step:=(W.compactSkywalkStageStep base base_pool_nodup x p 315 hp0 hx0 hpo hp gap hx cop (by decide) ref [] hs).1
  have inc:=(run_local_increment canonical raw ref [] (fun q h=>by
    have mem:=(W.compactSkywalkTick_support base 315 (by decide) base_pool_nodup) h
    exact (read q mem).trans (ag q mem))).1
  change (run canonical [] ref).phase=ref.phase at step
  rw [step,Bool.xor_self] at inc
  cases h:(run canonical [] raw).phase <;> cases k:raw.phase <;> simp_all

theorem scratch_table : ∀i:Fin 157,23≤ i.val →
    rawPorts i∉dst ∧ OB5.sig 315 (rawPorts i)=1556+(i.val-23) ∧ ∀v:Fin 10,rawPorts i≠NativePack315.history v := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem coordinate (s raw:State) : (stash s (pullState (OB5.sig 315) raw)).basis 330=raw.basis 330 ∧
    (stash s (pullState (OB5.sig 314) raw)).basis 330=raw.basis 330 := ⟨rfl,rfl⟩

theorem stash_slots (raw after tags:State) (phase:after.phase=raw.phase) (same:after.basis 330=raw.basis 330)
    (zero:∀k:Fin 134,after.basis (1556+k.val)=false) :
    let start:=stash tags (pullState (OB5.sig 314) raw)
    let out:=stash tags (pullState (OB5.sig 315) after)
    out.phase=start.phase ∧ out.basis 330=start.basis 330 ∧
      ∀i:Fin 157,23≤ i.val → out.basis (rawPorts i)=false := by
  refine ⟨phase,(coordinate _ _).1.trans (same.trans (coordinate _ _).2.symm),?_⟩
  intro i hi
  have ⟨off,eq,_⟩:=scratch_table i hi
  simp only [stash,if_neg off]
  exact (congrArg after.basis eq).trans (zero ⟨i.val-23,by have h:=i.isLt;omega⟩)

theorem exposed (d:Bool) (x:Nat) (hx0:0<x) (hx:x<p) (raw original tags:State) (read:Reads raw original)
    (stage:Rolling1588.Integer.Stage base d x p 315 original.basis)
    (hist:raw.basis (base (1028+315))=false) (swapSlot:raw.basis (base (2053-315))=false) (m:List Bool) :
    let start:=stash tags (pullState (OB5.sig 314) raw)
    let out:=run physP m start
    out.phase=start.phase ∧ out.basis 330=start.basis 330 ∧
      ∀i:Fin 157,23≤ i.val → out.basis (rawPorts i)=false := by
  have out:=(physical d x hx0 hx raw original tags read stage hist swapSlot m).1
  have bits:=after_cells d x hx0 hx raw original read stage
  dsimp only
  rw [out]
  exact stash_slots raw (run canonical [] raw) tags (no_phase d x hx0 hx raw original read stage) bits.1 bits.2

end ECDSAAdd.Entrant.StairPacket.EndTick

