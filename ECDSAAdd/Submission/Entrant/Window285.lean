private theorem indexOfRange (q start count:Nat) (a:start≤q) (b:q<start+count) :
    ∃i:Fin count, start+i.val=q :=
  ⟨⟨q-start,by omega⟩,by change start+(q-start)=q;omega⟩

theorem result (s o : State) (neg far long : Bool)
    (phase : s.phase=o.phase) (sign : s.basis 1685=neg) (mode : s.basis 1683=far) (side : s.basis 1684=long)
    (low : ∀i:Fin 125, s.basis (316+i.val)=o.basis (316+i.val) ∧ s.basis (786+i.val)=o.basis (786+i.val))
    (high : ∀i:Fin 88, s.basis (441+i.val)=false ∧
      s.basis (911+i.val)=(if o.basis 315 then o.basis (911+i.val) else o.basis (441+i.val)))
    (ext : ∀q,Exterior 285 529 q → s.basis q=o.basis q)
    (left : ∀q,leftovers q → s.basis q=o.basis q)
    (clear : ∀q∈Leave285BoundaryClean.zeros,s.basis q=false)
    (carry : ∀q:Wire,1556≤q → q≤1769 → o.basis q=false) :
    PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long o (eraseSites Enter300.pending s) := by
  have loShape : Enter300.lowerPairs=(List.finRange 3).map (fun j=>(316+(122+j.val),786+(122+j.val))) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have hiShape : Enter300.upperPairs=(List.finRange 88).map (fun j=>(441+j.val,911+j.val)) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have away (q:Wire) (small:q<1556) : (eraseSites Enter300.pending s).basis q=s.basis q := by
    have no:q∉Enter300.pending:=by simp [Enter300.pending,Wire] at *;omega
    simp [eraseSites,no]
  refine ⟨phase,?_,?_,?_,?_,?_,?_⟩
  · simpa [eraseSites,Enter300.pending] using sign
  · simpa [eraseSites,Enter300.pending] using mode
  · simpa [eraseSites,Enter300.pending] using side
  · intro pair mem
    rw [loShape] at mem
    obtain ⟨j,_,rfl⟩:=List.mem_map.mp mem
    dsimp only
    have hj:=j.isLt
    rw [away (316+(122+j.val)) (by change 316+(122+j.val)<1556;omega),away (786+(122+j.val)) (by change 786+(122+j.val)<1556;omega)]
    exact low ⟨122+j.val,by omega⟩
  · intro pair mem
    rw [hiShape] at mem
    obtain ⟨j,_,rfl⟩:=List.mem_map.mp mem
    dsimp only
    have hj:=j.isLt
    rw [away (441+j.val) (by change 441+j.val<1556;omega),away (911+j.val) (by change 911+j.val<1556;omega)]
    exact high j
  · intro q notN notF notU _ notHi
    by_cases pending:q∈Enter300.pending
    · have range : ∀q∈Enter300.pending,1556≤q ∧ q≤1769 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
      obtain ⟨lo,hi⟩:=range q pending
      simp [eraseSites,pending,carry q lo hi]
    simp only [eraseSites,if_neg pending]
    by_cases external:Exterior 285 529 q
    · exact ext q external
    by_cases residual:leftovers q
    · exact left q residual
    have hiA (i:Fin 88) : 441+i.val∈sites Enter300.upperPairs := by
      exact (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀i:Fin 88,441+i.val∈sites Enter300.upperPairs) i
    have hiB (i:Fin 88) : 911+i.val∈sites Enter300.upperPairs := by
      exact (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀i:Fin 88,911+i.val∈sites Enter300.upperPairs) i
    have outside (start count:Nat) (h:∀i:Fin count,start+i.val∈sites Enter300.upperPairs) : ¬(start≤q ∧ q<start+count) := by
      rintro ⟨a,b⟩
      obtain ⟨i,eq⟩:=indexOfRange q start count a b
      exact notHi (eq ▸ h i)
    have notA:=outside _ _ hiA
    have notB:=outside _ _ hiB
    by_cases a:316≤q ∧ q<441
    · obtain ⟨l,r⟩:=a
      obtain ⟨i,eq⟩:=indexOfRange q 316 125 l r
      exact eq ▸ (low i).1
    by_cases b:786≤q ∧ q<911
    · obtain ⟨l,r⟩:=b
      obtain ⟨i,eq⟩:=indexOfRange q 786 125 l r
      exact eq ▸ (low i).2
    have bounds : 1556≤q ∧ q≤1769 := by
      unfold Exterior at external;unfold leftovers at residual
      simp only [Wire] at *
      omega
    rw [carry _ bounds.1 bounds.2]
    apply clear
    simp only [Leave285BoundaryClean.zeros,List.mem_append,List.mem_range'_1]
    simp [Enter300.pending,Wire] at pending
    simp only [Wire] at *
    omega
end ECDSAAdd.Entrant.StairPacket.Leave285AssembleCut

