theorem terminal (d:Bool) (x:Nat) (s:State) (dom:Domain 315 x p s) :
    ∃ref:State,Rolling1588.Integer.Stage base d x p 315 ref.basis ∧ EndTick.Reads s ref ∧
    s.basis (base (1028+315))=false ∧ s.basis (base (2053-315))=false ∧
    ∀q∈ParkEndpoint.dst,(pullState (OB5.sig 314) s).basis q=false := by
  obtain ⟨ref,stage,link⟩:=leaves_reference 315 x p (by decide) d s dom
  have bounds:∀q∈ParkEndpoint.dst,315+16<OB5.sig 314 q ∧ OB5.sig 314 q<1044:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  refine ⟨ref,stage,reads_now (by decide) link,future_history (Nat.le_refl _) (by decide) dom,?_,?_⟩
  · exact (link.2 _ (outside_above (by decide))).trans ((Rolling1588.Integer.stage_zero d x 315 (by decide) _ stage).2 (by decide))
  · intro q hit
    exact (link.2 _ (outside_between (bounds _ hit).1 (bounds _ hit).2)).trans (ParkEndpoint.clear_dest d x p ref stage q hit)
end ECDSAAdd.Entrant.StairPacket.WideReference

