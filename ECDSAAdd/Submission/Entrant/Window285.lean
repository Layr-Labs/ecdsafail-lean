namespace ECDSAAdd.Entrant.StairPacket.Leave285TrueMiddle
open Arithmetic SkywalkNat IntegerHigh Shadow HighBankSum HighBankBarrel
open Leave285Join Leave285Word Leave285High Leave285Barrel Leave285OutputPorts
set_option maxRecDepth 50000
set_option maxHeartbeats 5000000

abbrev r (z : SkywalkNat.State) := reduced 114 15 z
def key (z : SkywalkNat.State) : Fin 16 :=
  ⟨if 2^114≤z.u then 0 else wait 15 z.u,by have h:=wait_le 15 z.u;split <;> omega⟩
def X (z : SkywalkNat.State) := total (step^[15] (r z))/2^115
def F (z : SkywalkNat.State) := total (step^[15] z)/2^115
def d (z : SkywalkNat.State) := X z/2^(key z).val
def neg (z : SkywalkNat.State) := cross (d z) && (!(decide (2^114≤z.u)) && negative (oddBits (letters 15 (r z))))

/-- The actual word-update segment, from its physical input registers to every
    output bit of the true fifteen-tick sum and all retired column sites. -/
theorem actual (z : SkywalkNat.State) (s : ECDSAAdd.State) (m : List Bool)
    (small : min z.u z.v<2^114) (odd : z.v%2=1) (room : high 114 15 z+1<2^127)
    (clean : ∀q∈carries,s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀i:Nat,127 ≤ i → i<142 → s.basis (wire i)=false)
    (tag : ∀q∈tags,s.basis q=if far 114 15 z then hot (key z) q else false)
    (shadow : ∀i<18,s.basis (431+i)=(X z).testBit i)
    (bank : regValue ys s.basis=if far 114 15 z then high 114 15 z else 0)
    (cin : s.basis 1694=if far 114 15 z then cross (d z) else false)
    (sign : far 114 15 z → s.basis 1597=neg z) (scratch : s.basis 1614=false) :
    let u:=run Leave285Middle.middle m s
    u.phase=s.phase ∧ (∀i<142,u.basis (live i)=(F z).testBit i) ∧
      (∀i:Fin 18,u.basis (row i).free=false) ∧
      ∀q,q≠1613 → outside wire 142 q → (∀a∈columns,q≠a.shadow ∧ q≠a.tube) → u.basis q=s.basis q := by
  dsimp only
  by_cases f : far 114 15 z
  · simp only [if_pos f] at tag bank cin
    have law := LeaveShadowRails.far_result 114 127 z small f odd room
    change d z=(cross (d z)).toNat+2*(!neg z).toNat ∧ F z=2^(key z).val*HighBankAdjust.adjusted (high 114 15 z) 127 (cross (d z)) (neg z)+X z%2^(key z).val at law
    rw [←cin,←sign f,←bank] at law
    have out := Leave285Middle.result (key z) (X z) s m clean selectZero padding tag shadow law.1 scratch
    refine ⟨out.1,?_,fun i=>(out.2.1 i).2,out.2.2.2⟩
    rw [law.2]
    exact activeBits _ _ _ _ (fun i=>(out.2.1 i).1) out.2.2.1
  · simp only [if_neg f] at tag bank cin
    have law := LeaveShadowRails.near_result 114 z f
    have eq : X z=F z := by unfold X F r;rw [law.1]
    have bound : X z<2^18 := eq ▸ law.2
    have out := Leave285NearMiddle.result (X z) bound s m clean selectZero padding tag shadow bank cin scratch
    refine ⟨out.1,?_,fun i=>(out.2.1 i).2,out.2.2.2⟩
    rw [←eq]
    exact inactiveBits _ bound _ (fun i=>(out.2.1 i).1) out.2.2.1

end ECDSAAdd.Entrant.StairPacket.Leave285TrueMiddle

