instance (q:Wire) : Decidable (readOnly q) := by unfold readOnly;infer_instance
theorem observes (q:Wire) (h:readOnly q) (s:State) (m:List Bool) (prev:(run physP m s).basis 330=s.basis 330) : (run physP m s).basis q=s.basis q := by
  rcases h with h|rfl
  · exact run_preserves_outside _ _ _ _ (physical_free P supports.1 _ h)
  · exact prev
theorem oldPrefix : ∀i,readOnly (NativePack315.history i) := by ((try unfold ECDSAAdd.Entrant.StairPacket.EndTick.readOnly); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem oldBank : ∀i:Fin 23,readOnly (ArchiveBoundary315.rawPorts ⟨i,Nat.lt_trans i.isLt (by decide : 23<157)⟩) := by ((try unfold ECDSAAdd.Entrant.StairPacket.EndTick.readOnly); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
