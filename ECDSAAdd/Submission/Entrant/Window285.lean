namespace ECDSAAdd.Entrant.StairPacket.NativePackW285
open Arithmetic MappedCompressed IntegerPacket EnterProof PortalValues
attribute [local irreducible] run routed unrouted
set_option maxRecDepth 18000
set_option maxHeartbeats 3200000
def protectedSites:List Wire:=[1693, 1691, 1692]++Enter285.saved

theorem admin_cover (d:Bool) : wires (withArchive d)⊆(support++ArchiveBoundary285I.rawPortsList).toFinset:=by
  rw [withArchive,wires_append,List.toFinset_append]
  exact Finset.union_subset_union (packs d) (ArchiveBoundary285I.load_cover d)

theorem free_native : ∀q∈protectedSites,¬MayTouch idx (windowNet idx q):=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem free_admin : ∀q∈protectedSites,q∉(support++ArchiveBoundary285I.rawPortsList):=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem keeps_stored (d:Bool) (s:State) (m:List Bool) (q:Wire) (hq:q∈protectedSites) :
    (run (body idx (withArchive d)) m s).basis q=s.basis q:=
  body_cover idx (withArchive d) protectedSites (support++ArchiveBoundary285I.rawPortsList) free_native free_admin (admin_cover d) s m q hq
theorem source_tags (s:BasisState) (z:SkywalkNat.State) (G S:Bool)
    (hit:∀q∈wires EnterProof.forward,s (map285 q)=(shadowRow 114 15 z G S).testBit q) :
    s 1693=false ∧ s 1691=decide (Shadow.far 114 15 z) ∧ s 1692=decide (Shadow.far 114 15 z ∧ 2^114≤z.u):=
  (actual_tags ports285 s 114 15 z G S hit).2
theorem relay (d:Bool) (s:State) (m:List Bool) (h:Nat) (x y:Bool)
    (high:regValue Enter285.saved s.basis=h) (hn:s.basis 1693=false) (hf:s.basis 1691=x) (hu:s.basis 1692=y) :
    let out:=run (body idx (withArchive d)) m s
    regValue Enter285.saved out.basis=h ∧ out.basis 1693=false ∧ out.basis 1691=x ∧ out.basis 1692=y :=
  keep_values 1693 1691 1692 Enter285.saved s (run (body idx (withArchive d)) m s) h x y (keeps_stored d s m) high hn hf hu
theorem saved_at_leave (d:Bool) (raw cut:State) (z:SkywalkNat.State) (G S:Bool) (head ticks:List Bool)
    (small:min z.u z.v<2^114) (packed:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692
      (negative S z.u) (decide (Shadow.far 114 15 z)) (decide (Shadow.far 114 15 z ∧ 2^114≤z.u))
      (pullState (OB5.sig 284) raw) cut)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 285) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    let out:=run (body idx (withArchive d)) ticks (run Partial.enter285 head cut)
    regValue Enter285.saved out.basis=(if Shadow.far 114 15 z then Shadow.high 114 15 z else 0) ∧
      out.basis 1693=false ∧ out.basis 1691=decide (Shadow.far 114 15 z) ∧
      out.basis 1692=decide (Shadow.far 114 15 z ∧ 2^114≤z.u):=by
  let pre:=run Partial.enter285 head cut
  have high:=Enter285.high_from_cut raw cut z G S head small packed input
  have body:=Enter285.from_full raw cut z G S head small packed input
  have tags:=source_tags pre.basis z G S body.2.1
  exact relay d pre ticks (if Shadow.far 114 15 z then Shadow.high 114 15 z else 0) _ _ high tags.1 tags.2.1 tags.2.2

