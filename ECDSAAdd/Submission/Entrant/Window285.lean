namespace ECDSAAdd.Entrant.StairPacket.Leave285Admission
open Arithmetic Partial LeaveCompanion LeaveCompanion285 PortalValues Leave285Barrel Leave285High HighBankBarrel
open Leave285Front LeaveSelector Leave285Selector Leave285OutputPorts LeaveReadoutFrame IntegerHigh Leave285Close
open Leave285Relocated StairArchiveTrace
open IntegerPacket
open MappedCompressed IntegerPacket SkywalkRails
set_option maxRecDepth 20000
set_option exponentiation.threshold 1024
attribute [local irreducible] run SkywalkNat.step
structure Numeric (z:SkywalkNat.State):Prop where
  small:min z.u z.v<2^114
  odd:z.v%2=1
  room:Shadow.high 114 15 z+1<2^127
  nextSmall:min (SkywalkNat.step^[15] z).u (SkywalkNat.step^[15] z).v<2^106
  bound:Leave285TrueMiddle.F z<2^142

theorem actualNumbers (x p:Nat) (hp0:0<p) (odd:p%2=1) (hx:x<2^256) (hp:p<2^256):
    Numeric (SkywalkNat.step^[285] (SkywalkNat.init x p)):=by
  let z:=SkywalkNat.step^[285] (SkywalkNat.init x p)
  have env:z.u+z.v≤2^256+2^255:=LeaveBankEnvelope.after_first x p (2^256) hx.le hp.le 284
  have short:=true_small x p 300 hx hp (by decide)
  have it:SkywalkNat.step^[15] z=SkywalkNat.step^[300] (SkywalkNat.init x p):=by
    exact (Function.iterate_add_apply SkywalkNat.step 15 285 _).symm
  refine ⟨true_small x p 285 hx hp (by decide),(SkywalkNat.iter_valid 285 (SkywalkNat.init x p) hp0 odd).2.1,
    LeaveBankEnvelope.bounds285 z env,?_,LeaveBankEnvelope.outputs285 z (by omega) 15⟩
  rw [it];exact short

def flags (z:SkywalkNat.State) (g0 s0:Bool):Bool×Bool:=
  SharedSigned.flags g0 s0 (SkywalkTrace.trace 15 (encode g0 s0 z.u z.v))
structure Inputs (s:State) (z:SkywalkNat.State) (g0 s0:Bool):Prop extends Numeric z where
  ready:onRails 14 15 (encode (flags z g0 s0).1 (flags z g0 s0).2
    (SkywalkNat.step^[15] (Shadow.reduced 114 15 z)).u (SkywalkNat.step^[15] (Shadow.reduced 114 15 z)).v) s.basis
  fresh:s.basis 1693=false
  scratch:∀q∈1556::1557::1558::fullC,s.basis q=false
  temp:∀p∈longPairs,s.basis p.2=false
  clean:∀q∈carries,s.basis q=false
  padding:∀t:Nat,127≤t→t<142→s.basis (wire t)=false
  bank:regValue ys s.basis=if Shadow.far 114 15 z then Shadow.high 114 15 z else 0
  zero:∀q∈Leave285FrontReady.watched,s.basis q=false
  far:s.basis 1691=decide (Shadow.far 114 15 z)
  side:s.basis 1692=(decide (Shadow.far 114 15 z) && decide (2^114≤z.u))
  record:readCells (shape 14) 0 15 (mappedBasis 14 s.basis)=SkywalkTrace.trace 15 (encode g0 s0 z.u z.v)
  extra:∀q,1698≤q→q≤1733→s.basis q=false
def spare:List Wire:=[1694, 1695, 1698, 1699, 1700, 1701, 1702, 1703, 1704, 1705, 1706, 1707, 1708, 1709, 1710, 1711, 1712, 1713, 1714, 1715, 1716, 1717, 1718, 1719, 1720, 1721, 1722, 1723, 1724, 1725, 1726, 1727, 1728, 1729, 1730, 1731, 1732, 1733]
private def touch:= (1556::1557::1558::fullC) ++ longPairs.map Prod.snd ++ carries ++ ((List.range' 127 15).map wire) ++ Leave285FrontReady.watched
private theorem geometry:∀q∈touch,(1556≤q ∧ q≤1687) ∨ q∈spare:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem assemble (s:State) (z:SkywalkNat.State) (g0 s0:Bool) (numbers:Numeric z)
    (rails:onRails 14 15 (SkywalkTrace.next^[15] (encode g0 s0 (Shadow.reduced 114 15 z).u (Shadow.reduced 114 15 z).v)) s.basis)
    (record:readCells (shape 14) 0 15 (mappedBasis 14 s.basis)=SkywalkTrace.trace 15 (encode g0 s0 z.u z.v))
    (saved:regValue ys s.basis=(if Shadow.far 114 15 z then Shadow.high 114 15 z else 0) ∧
      s.basis 1693=false ∧ s.basis 1691=decide (Shadow.far 114 15 z) ∧ s.basis 1692=decide (Shadow.far 114 15 z ∧ 2^114≤z.u))
    (ex:∀q∈spare,s.basis q=false):Inputs s z g0 s0:=by
  have cl:=carry285 _ s rails
  have all (q:Wire) (hit:q∈touch):s.basis q=false:=by
    rcases geometry q hit with h|h
    · exact cl q h.1 h.2
    · exact ex q h
  refine ⟨numbers,?_,saved.2.1,?_,?_,?_,?_,saved.1,?_,saved.2.2.1,?_,record,?_⟩
  · exact (SharedSigned.same _ z numbers.small numbers.odd g0 s0).1 ▸ rails
  · intro q h;apply all;simp only [touch,List.mem_append];exact Or.inl (Or.inl (Or.inl (Or.inl h)))
  · intro t h;apply all;have mem:=List.mem_map_of_mem (f:=Prod.snd) h;simp only [touch,List.mem_append];exact Or.inl (Or.inl (Or.inl (Or.inr mem)))
  · intro q h;apply all;simp only [touch,List.mem_append];exact Or.inl (Or.inl (Or.inr h))
  · intro t lo hi
    have hit:t∈List.range' 127 15:=List.mem_range'_1.mpr ⟨lo,hi⟩
    apply all
    have mem:=List.mem_map_of_mem (f:=wire) hit
    simp only [touch,List.mem_append];exact Or.inl (Or.inr mem)
  · intro q h;apply all;simp only [touch,List.mem_append];exact Or.inr h
  · rw [saved.2.2.2]
    by_cases f:Shadow.far 114 15 z <;> simp [f]
  · intro q lo hi
    apply ex
    have inc:∀q∈List.range' 1698 36,q∈spare:=by decide
    exact inc q (List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩)
end ECDSAAdd.Entrant.StairPacket.Leave285Admission

