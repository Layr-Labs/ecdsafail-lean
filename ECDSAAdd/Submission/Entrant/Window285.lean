    (raw:State) (input:let a:=SkywalkNat.step^[15] z
       SkywalkIntegerInput Leave285WideWords.L (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis) :
    let o:=pullState (OB5.sig 299) raw
    let out:=run leave285 m s
    (∀i:Fin 125,out.basis (316+i.val)=o.basis (316+i.val) ∧ out.basis (786+i.val)=o.basis (786+i.val)) ∧
    ∀i:Fin 88,out.basis (441+i.val)=false ∧
      out.basis (911+i.val)=(if o.basis 315 then o.basis (911+i.val) else o.basis (441+i.val)) := by
  let a:=SkywalkNat.step^[15] z
  let h:=SkywalkNat.step^[15] (Shadow.reduced 114 15 z)
  let o:=pullState (OB5.sig 299) raw
  let out:=run leave285 m s
  have word:=Leave285EndWords.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound xs len historyOK first saved far side
  have whole:=Leave285Whole.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound xs len historyOK first saved far side
  have cleared:=Leave285HighZero.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events highZero nextSmall bound
  have orient:o.basis 315=G := by
    have geo:Leave285WideWords.L.previous=OB5.sig 299 315:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    change raw.basis (OB5.sig 299 315)=G
    rw [←geo];exact input.2.2.1
  have law:=LeaveShadowRails.retainedLow 114 z small sg
  constructor
  · intro i
    have fit:i.val<213:=by have h:=i.isLt;omega
    have ref:=Leave285WideWords.wide a G sg raw input ⟨i.val,fit⟩
    by_cases low:i.val<114
    · have hw:=Leave285WideWords.short h G sg s ready ⟨i.val,low⟩
      have untouched:=lowFrame ⟨i.val,low⟩ s m
      have spos:=LeaveSignedCoordinates.sharedDigit _ _ 114 i.val law.2.1 (Nat.le_of_lt low)
      have smag:=LeaveSignedCoordinates.sharedDigit _ _ 114 i.val law.2.2 (Nat.le_of_lt low)
