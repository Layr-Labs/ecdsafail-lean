theorem avoid_live : ∀q∈pending,q∉zeroSites idx := by decide +kernel

theorem ready_pending (raw pre:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^106)
    (cut:PackedCut lowerPairs upperPairs 315 1685 1683 1684 (PortalValues.negative S z.u)
