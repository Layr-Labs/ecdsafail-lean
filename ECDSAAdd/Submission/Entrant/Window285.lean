namespace ECDSAAdd.Entrant.StairPacket.Leave300ReleasedActual
open Arithmetic MappedCompressed IntegerPacket WideReference EnterProof NativePack300 Partial LeaveReadoutFrame
set_option maxRecDepth 32000
set_option maxHeartbeats 2700000

def mirrorSites:=List.range' 1329 15
def untouched:=529::(List.range' 1344 15)

theorem mirror (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 300 x p raw) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long
      (pullState (OB5.sig 299) raw) (eraseSites Enter300.pending s))
    (q:Wire) (lo:1329≤q) (hi:q≤1343) : (run (body idx (withArchive d)) b (run enter300 a s)).basis q=false := by
  have mem:q∈mirrorSites:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈mirrorSites,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary300.rawPortsList) ∧
      q∉ports300 ∧ q∉Enter300.pending ∧ OB5.sig 299 q=3113-q ∧ q≠1685 ∧ q≠1683 ∧ q≠1684 ∧
      q∉RailPair.sites Enter300.upperPairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no⟩:=marks q mem
  have normal:=ext_head enter300 idx (withArchive d) (support++ArchiveBoundary300.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter300.programCover h))) adminOff (admin_cover d)
  apply normal.trans
  have original:raw.basis (3113-q)=false:=by
    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 _ (outside_above (by change 1044+300≤3113-q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 300 (by decide) base_pool_nodup _).mp stage
    apply (regValue_zero _ _).mp fields.2.2.2.2.2.1
    exact List.mem_map.mpr ⟨(3113-q)-16,List.mem_range'_1.mpr (by simp only [Wire] at *;omega),by change ((3113-q)-16)+16=3113-q;simp only [Wire] at *;omega⟩
  have cleared:((eraseSites Enter300.pending s)).basis q=false:=
    (cut.unchanged q hn hf hu no).trans (by simpa only [pullState,source] using original)
  simpa [eraseSites,mask] using cleared

theorem clean (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 300 x p raw) (m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long
      (pullState (OB5.sig 299) raw) (eraseSites Enter300.pending s)) :
    ∀q:Wire,1329≤q → q≤1343 → (run (NativePack300.nextWindow d) m s).basis q=false := by
  intro q lo hi
  simp only [NativePack300.nextWindow,NativePack300.window,run_append,run_take]
  exact mirror d raw s x p dom _ _ neg far long cut q lo hi

theorem future (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 300 x p raw) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long
      (pullState (OB5.sig 299) raw) (eraseSites Enter300.pending s))
    (q:Wire) (lo:1344≤q) (hi:q≤1358) : (run (body idx (withArchive d)) b (run enter300 a s)).basis q=false := by
  have mem:q∈List.range' 1344 15:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈List.range' 1344 15,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary300.rawPortsList) ∧
      q∉ports300 ∧ q∉Enter300.pending ∧ OB5.sig 299 q=q ∧ q≠1685 ∧ q≠1683 ∧ q≠1684 ∧
      q∉RailPair.sites Enter300.upperPairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no⟩:=marks q mem
  have normal:=ext_head enter300 idx (withArchive d) (support++ArchiveBoundary300.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter300.programCover h))) adminOff (admin_cover d)
  apply normal.trans
  have original:raw.basis q=false:=by
    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 q (outside_above (by change 1044+300≤q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 300 (by decide) base_pool_nodup _).mp stage
    have qid:q=base (1028+(q-1044)):=by change q=1028+(q-1044)+16;simp only [Wire] at *;omega
    have jlo:300≤q-1044:=by simp only [Wire] at *;omega
    have jhi:q-1044<512:=by simp only [Wire] at *;omega
    exact qid ▸ (fields.2.2.2.2.1 _ jlo jhi).2
  have cleared:((eraseSites Enter300.pending s)).basis q=false:=
    (cut.unchanged q hn hf hu no).trans (by simpa only [pullState,source] using original)
  simpa [eraseSites,mask] using cleared

/-- The folded homes 1785..1812 hold the packed history of ticks 257..284 (windows 255, 270 and 285). Window 300
and `leave300` do not touch them; the cut reads them from `raw` at 3113-q (`OB5.sig 299`), and so does the reference
(`OB5.sig 314`, outside `sites 300`), because the stock span leaves an earlier history home alone. -/
theorem older (d:Bool) (raw s:State) (a b m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long
      (pullState (OB5.sig 299) raw) (eraseSites Enter300.pending s))
    (q:Wire) (lo:1785≤q) (hi:q≤1812) :
    (run leave300 m (run (body idx (withArchive d)) b (run enter300 a s))).basis q=
      (origin 300 raw (run (body idx (withArchive d)) b (run enter300 a s))).basis q := by
  have mem:q∈List.range' 1785 28:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
