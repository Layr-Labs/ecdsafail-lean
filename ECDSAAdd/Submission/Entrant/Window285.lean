namespace ECDSAAdd.Entrant.StairPacket.LeaveTerminalBound300
open SkywalkNat HighBankSum

/-- The stock stage at 300 has a narrower signed rail than the intermediate
    barrel. The fourteen sites above its physical destination contain zero. -/
theorem fit (x p : Nat) (xp:0<x) (pp:0<p) (odd:p%2=1) (bound:p<2^256)
    (small:x<p) (cop:x.Coprime p) :
    let z:=step^[285] (init x p)
    Leave285TrueMiddle.F z<2^98 := by
  have bounds:=iter_width p x 256 300 pp xp odd bound small cop (by decide)
  dsimp only at bounds
  change (step^[300] (init x p)).u<2^212 ∧ (step^[300] (init x p)).v<2^212 at bounds
  change total (step^[15] (step^[285] (init x p)))/2^115<2^98
  rw [←Function.iterate_add_apply]
  unfold total
  change ((step^[300] (init x p)).u+(step^[300] (init x p)).v)/2^115<2^98
  apply (Nat.div_lt_iff_lt_mul (by decide)).mpr
  omega


end ECDSAAdd.Entrant.StairPacket.LeaveTerminalBound300

