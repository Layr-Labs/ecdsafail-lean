      (SkywalkRails.encode route sg z.u z.v).b route raw.basis)
    (cut:PackedCut loPairs hiPairs 330 1678 1676 1677 (PortalValues.negative sg z.u)
      (decide (3*2^115≤z.u+z.v)) (decide (3*2^115≤z.u+z.v ∧ 2^99≤z.u))
