  apply Leave300Admission.assemble _ _ _ _ numbers all.2.1 all.2.2.1
  · simpa only [nextWindow,window,run_append,run_take,tape] using wide
  · intro q h
    have inc:∀q∈Leave300Admission.spare,(∃t:Fin 3,q=1686+t.val) ∨ q∈spares:=by decide
    rcases inc q h with ⟨t,rfl⟩|hm
    · exact tags t
    · have ex:=extra_clean d raw s m tape _ _ _ _ _ _ cut input q hm
      simpa only [nextWindow,window,run_append,run_take,tape] using ex
