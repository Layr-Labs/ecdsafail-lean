    exact mask_open 430 900 1557 1558 s m₀ (by decide) x y
  have kept (q:Wire) (h:q∈[430, 900, 1557, 1558]) : v.basis q=u.basis q :=
    preserved interior u m₁ q (layout q h)
  dsimp only
  rw [closeShape]
  apply mask_close _ _ _ _ _ _ (by decide)
  · change v.basis 1557= !v.basis 430
    rw [kept _ (by decide),kept _ (by decide),fresh]
    simp [writeBit]
  · change v.basis 1558=(v.basis 900 && v.basis 1557)
    rw [kept _ (by decide),kept _ (by decide),kept _ (by decide),fresh]
    simp [writeBit]
