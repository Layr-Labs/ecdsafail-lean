  have atSite (q src:Wire) (link:LeaveRelocation.source moves q=src) (clear:src≠1692):out.basis q=v.basis src := by
    rw [whole.2.2.2.2,link];simp [writeBit,clear,v]
  have flagAt (q src:Wire) (link:LeaveRelocation.source moves q=src)
      (outside:src≠1692 ∧ src∉RailPair.sites low ∧ src∉history):out.basis q=b.basis src :=
    (atSite q src link outside.1).trans (store.2.2.2 _ outside.2.1 outside.2.2)
  refine ⟨(flagAt 1683 1557 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by decide)).trans before.2.2.1,
    (flagAt 1684 1558 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by decide)).trans before.2.2.2.1,
    (flagAt 1685 1693 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by decide)).trans coords.1,?_,?_,?_⟩
  · intro q hq
    have intact:∀q∈history,LeaveRelocation.source moves q=q ∧ q≠1692:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    exact (atSite q q (intact q hq).1 (intact q hq).2).trans (store.2.1 q hq)
  · intro i
    have intact:∀j:Fin 11,LeaveRelocation.source moves (430+j.val)=430+j.val ∧
      LeaveRelocation.source moves (900+j.val)=900+j.val ∧ 430+j.val≠1692 ∧ 900+j.val≠1692 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    obtain ⟨hx,hy,dx,dy⟩:=intact i
    exact ⟨(atSite _ _ hx dx).trans (store.2.2.1 i).1,(atSite _ _ hy dy).trans (store.2.2.1 i).2⟩
  · intro i
    have geo:∀j:Fin 88,live (10+j.val)≠1692 ∧ live (10+j.val)∉RailPair.sites low ∧ live (10+j.val)∉history := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    have a:=flagAt _ _ (upperMap ⟨i.val,by have:=i.isLt;omega⟩).1 (geo i)
    have n:10+i.val<142 := by have h:=i.isLt;omega
    have hi:=(before.2.2.2.2.2.1 _ n)
    unfold Leave285TrueMiddle.F at hi
    rw [Nat.testBit_div_two_pow] at hi
    exact a.trans (by simpa only [show (10+i.val)+115=125+i.val by omega] using hi)
