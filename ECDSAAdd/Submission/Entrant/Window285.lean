    rw [WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part0 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part1 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part2 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part3 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part4 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part5 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part6 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part7 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part8 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part9 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part10 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part11 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part12 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part13 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part14 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part15 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part16 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part17 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part18 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part19 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part20 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part21 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part22 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part23 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part24 (by decide), WSlimSlice.drop_skip _ _ _ 96 WSlimLen.leave285Part25 (by decide)]
    rfl
  show (leave285.drop 334).take 2364 = (leave285.drop 334).take 2254 ++ (signBit ++ (leave285.drop 2590).take 108)
  rw [hs, ECDSAAdd.Entrant.WSlimV3.seg_merge_r _ 334 2254 2588 2 _ rfl, ECDSAAdd.Entrant.WSlimV3.seg_merge _ 334 _ 2590 108 rfl]

/-- Keep the semantic composition independent of the concrete prefix and suffix programs. -/
private theorem abstractMiddle (early late combined : Program)
    (parts : combined = early ++ (signBit ++ late))
    (highLaw : ∀ (s : State) (m : List Bool)
    (_clean : ∀ q ∈ carries, s.basis q=false) (_selectZero : s.basis 1613=false)
    (_padding : ∀ i : Nat, 127 ≤ i → i < 142 → s.basis (wire i)=false)
    (_off : ∀ q ∈ Leave285Join.tags, s.basis q=false),
    let x := adjusted (regValue ys s.basis) 127 (s.basis 1694) (s.basis 1597)
    Result wire 142 x s (run early m s))
    (wordLaw : ∀ (X : Nat) (_bound : X<2^18) (s : State) (m : List Bool)
    (_off : ∀ q ∈ tags, s.basis q=false)
    (_shadow : ∀ i < 18, s.basis (431+i)=X.testBit i)
    (_tube : ∀ i < 18, s.basis (wire i)=false)
    (_scratch : s.basis 1614=false),
    let out := run late m s
    out.phase=s.phase ∧
      (∀ i : Fin 18, out.basis (row i).keep=X.testBit i.val ∧ out.basis (row i).free=false) ∧
      ∀ q, (∀ r ∈ columns, q≠r.shadow ∧ q≠r.tube) → out.basis q=s.basis q)
    (X : Nat) (bound : X<2^18) (s : State) (m : List Bool)
    (clean : ∀ q ∈ carries, s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀ i : Nat, 127 ≤ i → i < 142 → s.basis (wire i)=false)
    (off : ∀ q ∈ tags, s.basis q=false)
    (shadow : ∀ i < 18, s.basis (431+i)=X.testBit i)
    (bank : regValue ys s.basis=0) (crossZero : s.basis 1694=false)
    (scratch : s.basis 1614=false) :
    let out := run combined m s
    out.phase=s.phase ∧
      (∀ i : Fin 18, out.basis (row i).keep=X.testBit i ∧ out.basis (row i).free=false) ∧
      (∀ i : Fin 142, 18 ≤ i.val → out.basis (wire i.val)=false) ∧
      (∀ q, q≠1613 → outside wire 142 q → (∀ r ∈ columns, q≠r.shadow ∧ q≠r.tube) → out.basis q=s.basis q) := by
  let v := run early m s
  let tape := m.drop (measurementCount early)
  let u := run signBit tape v
  have a := highLaw s m clean selectZero padding off
  have bankZero : adjusted (regValue ys s.basis) 127 (s.basis 1694) (s.basis 1597) = 0 := by
    rw [bank,crossZero]
    cases s.basis 1597 <;> decide
  have bits (i : Fin 142) : v.basis (wire i.val)=false := by
    simpa only [bankZero,Nat.zero_testBit] using a.bits i.val i.isLt
  have unchanged (q : Wire) (ne : q≠1613) : u.basis q = v.basis q := by simp [u,run,writeBit,Function.update,ne]
  have old (q : Wire) (ne : q≠1613) (ext : ∀ i : Fin 142, q≠wire i.val) : u.basis q=s.basis q :=
    (unchanged q ne).trans (a.frame q (fun i h => ext ⟨i,h⟩))
  have tagsOutside : ∀ q ∈ tags, q≠1613 ∧ ∀ i : Fin 142, q≠wire i.val := by decide +kernel
  have shadows : ∀ j : Fin 18, 431+j.val≠1613 ∧ ∀ i : Fin 142, 431+j.val≠wire i.val := by decide +kernel
  have stable (i : Fin 142) : 1613 ≠ wire i.val := Leave285Shift.layout3.separate i.val i.isLt
  have readTags (q : Wire) (hq : q∈tags) : u.basis q=false := (old q (tagsOutside q hq).1 (tagsOutside q hq).2).trans (off q hq)
  have readShadow (i : Nat) (hi : i<18) : u.basis (431+i)=X.testBit i := by
    let j : Fin 18 := ⟨i,hi⟩
    exact (old _ (shadows j).1 (shadows j).2).trans (shadow i hi)
  have readTube (i : Nat) (hi : i<18) : u.basis (wire i)=false := by
    let j : Fin 142 := ⟨i,by omega⟩
    exact (unchanged _ (stable j).symm).trans (bits j)
  have zero := (old 1614 (by decide) (by decide +kernel)).trans scratch
  have word := wordLaw X bound u tape readTags readShadow readTube zero
  dsimp only
  rw [parts,run_append,run_take,run_append,run_take,show measurementCount signBit=0 from rfl,List.drop_zero]
  refine ⟨word.1.trans a.phase,word.2.1,?_,?_⟩
  · intro i hi
    have outsideRows : ∀ i : Fin 142, 18 ≤ i.val → ∀ r ∈ columns, wire i.val≠r.shadow ∧ wire i.val≠r.tube := by decide +kernel
    exact (word.2.2 _ (outsideRows i hi)).trans ((unchanged _ (stable i).symm).trans (bits i))
  · intro q ne ext away
    exact (word.2.2 q away).trans ((unchanged q ne).trans (a.frame q ext))


theorem result (X : Nat) (bound : X<2^18) (s : State) (m : List Bool)
    (clean : ∀ q ∈ carries, s.basis q=false) (selectZero : s.basis 1613=false)
    (padding : ∀ i : Nat, 127 ≤ i → i < 142 → s.basis (wire i)=false)
    (off : ∀ q ∈ tags, s.basis q=false)
    (shadow : ∀ i < 18, s.basis (431+i)=X.testBit i)
    (bank : regValue ys s.basis=0) (crossZero : s.basis 1694=false)
    (scratch : s.basis 1614=false) :
    let out := run middle m s
    out.phase=s.phase ∧
      (∀ i : Fin 18, out.basis (row i).keep=X.testBit i ∧ out.basis (row i).free=false) ∧
      (∀ i : Fin 142, 18 ≤ i.val → out.basis (wire i.val)=false) ∧
      (∀ q, q≠1613 → outside wire 142 q → (∀ r ∈ columns, q≠r.shadow ∧ q≠r.tube) → out.basis q=s.basis q) :=
  abstractMiddle first lastPart middle split Leave285NearHigh.result Leave285NearWord.combine X bound s m clean selectZero padding off shadow bank crossZero scratch
end ECDSAAdd.Entrant.StairPacket.Leave285NearMiddle

