theorem decode (s : State) (u v sign : Nat) (magFit : (u-sign)/2^114<2^19)
    (bits : ∀i<19,s.basis (430+i)=((u+v)/2^114).testBit i ∧ s.basis (900+i)=((u-sign)/2^114).testBit i) :
    ((digits 900 longPairs).any s.basis = decide (2^114≤u-sign)) ∧
      (s.basis 900 && !s.basis 430).toNat=upperBorrow (2^114) u v sign ∧
      regValue fullA s.basis=((u+v)/2^115)%2^18 ∧
      regValue fullM s.basis=((u-sign)/2^115)%2^18 := by
  have mag := EnterProof.value_of_bits (digits 900 longPairs) s.basis ((u-sign)/2^114) (by
    intro i hi
    have geom : ∀j:Fin 19,(digits 900 longPairs).getD j 0=900+j.val := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    rw [geom ⟨i,hi⟩]
    exact (bits i hi).2)
  rw [show (digits 900 longPairs).length=19 from rfl,Nat.mod_eq_of_lt magFit] at mag
  refine ⟨?_,?_,?_,?_⟩
  · rw [any_positive,mag]
    simp only [Nat.div_pos_iff,show 0<2^114 by decide,true_and]
  · have bs := bits 0 (by decide)
    simpa only [Nat.add_zero,bs.1,bs.2] using borrowBit (2^114) u v sign (by decide)
  · apply EnterProof.value_of_bits fullA
    intro i hi
    have geom : ∀j:Fin 18,fullA.getD j 0=430+(j.val+1) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    rw [geom ⟨i,hi⟩,show (u+v)/2^115=((u+v)/2^114)/2^1 by rw [Nat.div_div_eq_div_mul];rfl,Nat.testBit_div_two_pow]
    have jj : i+1<19 := Nat.succ_lt_succ (show i<18 from hi)
    exact (bits (i+1) jj).1
  · apply EnterProof.value_of_bits fullM
    intro i hi
    have geom : ∀j:Fin 18,fullM.getD j 0=900+(j.val+1) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    rw [geom ⟨i,hi⟩,show (u-sign)/2^115=((u-sign)/2^114)/2^1 by rw [Nat.div_div_eq_div_mul];rfl,Nat.testBit_div_two_pow]
    have jj : i+1<19 := Nat.succ_lt_succ (show i<18 from hi)
    exact (bits (i+1) jj).2

end ECDSAAdd.Entrant.StairPacket.Leave285CompanionInput

