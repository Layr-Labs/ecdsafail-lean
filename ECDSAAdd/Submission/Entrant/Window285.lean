theorem ready_from_cut (raw v:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^114)
    (p:PackedCut lowerPairs upperPairs 300 1693 1691 1692 (PortalValues.negative S z.u)
        (decide (Shadow.far 114 15 z)) (decide (Shadow.far 114 15 z ∧ 2^114≤z.u)) (pullState (OB5.sig 284) raw) v)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 285) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (_hist:∀r:Fin 15,raw.basis (base (1028+285+r))=false) (endScratch:raw.basis 1784=false ∧ raw.basis 1783=false) :
    let t:=run Partial.enter285 m v
    let T:=Shadow.reduced 114 15 z
    t.phase=v.phase ∧ onRails idx 0 (SkywalkRails.encode G S T.u T.v) t.basis := by
  obtain ⟨ph,body,outer⟩:=from_full raw v z G S m small p input
  refine ⟨ph,complete live _ G S small raw v _ p input body outer ?_⟩
  intro r
  rcases hist_sources r with eq|eq|⟨lo,hi⟩
  · rw [eq];exact endScratch.1
  · rw [eq];exact endScratch.2
  · apply (regValue_zero _ _).mp input.2.2.2.2.2;rw [carry_range,List.mem_range'_1];simp only [Wire] at *;omega

