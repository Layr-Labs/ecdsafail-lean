namespace ECDSAAdd.Entrant.StairPacket.EndTick
open Arithmetic MappedCompressed Secp256k1
attribute [local irreducible] run
set_option maxRecDepth 30000
set_option maxHeartbeats 3500000
theorem physical (d:Bool) (x:Nat) (hx0:0<x) (hx:x<p) (raw original tags:State)
    (read:Reads raw original) (stage:Rolling1588.Integer.Stage base d x p 315 original.basis)
    (hist:raw.basis (base (1028+315))=false) (swapSlot:raw.basis (base (2053-315))=false)
    (m:List Bool) :
    let start:=ParkEndpoint.stash tags (pullState (OB5.sig 314) raw)
    let out:=run physP m start
    out=ParkEndpoint.stash tags (pullState (OB5.sig 315) (run canonical [] raw)) ∧
      ∀t,run physQ t out=start := by
  have pre:pullState (OB5.sig 314) raw=pullState (OB5.sig 315) raw:=
    OB5.pull_step 315 (by decide) raw hist (fun _=>swapSlot)
  have result:run physP m (ParkEndpoint.stash tags (pullState (OB5.sig 314) raw))=
      ParkEndpoint.stash tags (pullState (OB5.sig 315) (run canonical [] raw)):=by
    rw [ParkEndpoint.commutes _ stashP,pre,physP,OB5.run_rename _ (by decide),apply_old d x hx0 hx raw original read stage m []]
  refine ⟨result,?_⟩
  intro t
  rw [result,ParkEndpoint.commutes _ stashQ,physQ,OB5.run_rename _ (by decide),compact_undo d x hx0 hx raw original read stage,←pre]

end ECDSAAdd.Entrant.StairPacket.EndTick

