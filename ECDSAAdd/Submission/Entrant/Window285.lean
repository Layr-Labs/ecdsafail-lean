theorem ready_from_cut (raw v:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^114)
    (p:PackedCut lowerPairs upperPairs 300 1693 1691 1692 (PortalValues.negative S z.u)
        (decide (Shadow.far 114 15 z)) (decide (Shadow.far 114 15 z ∧ 2^114≤z.u)) (pullState (OB5.sig 284) raw) v)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 285) (SkywalkRails.encode G S z.u z.v).a
