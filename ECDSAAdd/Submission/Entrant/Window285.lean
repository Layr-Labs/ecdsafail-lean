namespace ArchiveBoundary300
def nextIdx : Fin 23 := ⟨15,by decide⟩
/-- The archive uses 134 scratch ports and stage 15 has 124 carry wires: the first 124 sit on the carry. -/
theorem scratch_carry : ∀i:Fin 157,23≤ i.val → i.val<147 → rawPorts i∈((ports (shape nextIdx) 1).carry.map (windowNet nextIdx)) := by decide +kernel
/-- The last ten sit on the extension wires of ticks 5..14, which are clear until those ticks run. -/
theorem scratch_ext : ∀i:Fin 157,147≤ i.val → rawPorts i=windowNet nextIdx (ports (shape nextIdx) (i.val-142)).ext := by decide +kernel
theorem scratch_zero (z:SkywalkRails.State) (s:State) (on:onRails nextIdx 1 z s.basis) :
    ∀i:Fin 157,23≤ i.val → s.basis (rawPorts i)=false := by
  intro i hi
  by_cases low:i.val<147
  · obtain ⟨c,hc,eq⟩:=List.mem_map.mp (scratch_carry i hi low)
    have fresh:rawPorts i=windowNet nextIdx c:=eq.symm
    have old:s.basis (rawPorts i)=false:=fresh ▸ (regValue_zero _ _).mp on.2.2.2.1 _ hc
    exact old
  · have top:147≤ i.val:=by omega
    have clean:s.basis (windowNet nextIdx (ports (shape nextIdx) (i.val-142)).ext)=false:=
      (on.2.2.2.2 (i.val-142) (by omega) (show i.val-142<15 by have lt:=i.isLt;omega)).1
    rw [scratch_ext i top]
    exact clean
theorem scratch_code : ∀i:Fin 157,23≤ i.val → rawPorts i=codePorts ⟨i.val-7,by omega⟩ := by decide +kernel
theorem past_only : ∀i:Fin 23,rawPorts ⟨i,by omega⟩∉watch nextIdx := by decide +kernel
theorem retain_watch (d:Bool) (z:SkywalkRails.State) (row:Nat) (s t:State)
    (on:onRails nextIdx 1 z s.basis) (frame:Frame codePorts (code d) row t)
    (outside:∀q,(∀i,rawPorts i≠q) → t.basis q=s.basis q) :
    ∀q∈watch nextIdx,t.basis q=s.basis q := by
  intro q h
  by_cases mem:∃i,rawPorts i=q
  · obtain ⟨i,rfl⟩:=mem
    have hi:23≤ i.val:=by
      by_contra! bad
      exact past_only ⟨i,bad⟩ h
    have old:s.basis (rawPorts i)=false:=scratch_zero z s on i hi
    rw [old,scratch_code i hi,frame,archive_blank _ _ (by dsimp;omega),Nat.zero_testBit]
  · exact outside _ (fun i eq=>mem ⟨i,eq⟩)
end ArchiveBoundary300
