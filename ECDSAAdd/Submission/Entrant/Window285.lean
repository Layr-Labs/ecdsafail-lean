theorem physicalTags : ∀k:Mode,∀q∈Leave285Join.tags,
    prior k q=.bit (enabled k && decide (q=Leave285Join.tags.getD (LeaveSelector.key k) 0)) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem tags (z:SkywalkNat.State) (v:BasisState) (q:Wire) (hq:q∈Leave285Join.tags) :
    (prior (actualMode 114 z) q).read v=
      if Shadow.far 114 15 z then Leave285Word.hot (Leave285TrueMiddle.key z) q else false := by
