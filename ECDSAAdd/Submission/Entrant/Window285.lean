theorem ready_from_cut (raw v:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^106)
    (p:PackedCut lowerPairs upperPairs 315 1685 1683 1684 (PortalValues.negative S z.u)
        (decide (Shadow.far 106 15 z)) (decide (Shadow.far 106 15 z ∧ 2^106≤z.u)) (pullState (OB5.sig 299) raw) v)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 300) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (_hist:∀r:Fin 15,raw.basis (base (1028+300+r))=false) (endScratch:raw.basis 1769=false ∧ raw.basis 1768=false) :
    let t:=run Partial.enter300 m v
    let T:=Shadow.reduced 106 15 z
    t.phase=v.phase ∧ onRails idx 0 (SkywalkRails.encode G S T.u T.v) t.basis := by
  obtain ⟨ph,body,outer⟩:=from_full raw v z G S m small p input
  refine ⟨ph,complete live _ G S small raw v _ p input body outer ?_⟩
  intro r
  rcases hist_sources r with eq|eq|⟨lo,hi⟩
  · rw [eq];exact endScratch.1
  · rw [eq];exact endScratch.2
  · apply (regValue_zero _ _).mp input.2.2.2.2.2;rw [carry_range,List.mem_range'_1];simp only [Wire] at *;omega

