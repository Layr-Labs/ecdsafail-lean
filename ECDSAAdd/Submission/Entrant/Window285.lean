def protectedSites:List Wire:=[1685, 1683, 1684]++Enter300.saved

theorem admin_cover (d:Bool) : wires (withArchive d)⊆(support++ArchiveBoundary300.rawPortsList).toFinset:=by
  rw [withArchive,wires_append,List.toFinset_append]
  exact Finset.union_subset_union (packs d) (ArchiveBoundary300.load_cover d)

theorem free_native : ∀q∈protectedSites,¬MayTouch idx (windowNet idx q):=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem free_admin : ∀q∈protectedSites,q∉(support++ArchiveBoundary300.rawPortsList):=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem keeps_stored (d:Bool) (s:State) (m:List Bool) (q:Wire) (hq:q∈protectedSites) :
    (run (body idx (withArchive d)) m s).basis q=s.basis q:=
  body_cover idx (withArchive d) protectedSites (support++ArchiveBoundary300.rawPortsList) free_native free_admin (admin_cover d) s m q hq
theorem source_tags (s:BasisState) (z:SkywalkNat.State) (G S:Bool)
    (hit:∀q∈wires EnterProof.forward,s (map300 q)=(shadowRow 106 15 z G S).testBit q) :
    s 1685=false ∧ s 1683=decide (Shadow.far 106 15 z) ∧ s 1684=decide (Shadow.far 106 15 z ∧ 2^106≤z.u):=
  (actual_tags ports300 s 106 15 z G S hit).2
theorem relay (d:Bool) (s:State) (m:List Bool) (h:Nat) (x y:Bool)
    (high:regValue Enter300.saved s.basis=h) (hn:s.basis 1685=false) (hf:s.basis 1683=x) (hu:s.basis 1684=y) :
    let out:=run (body idx (withArchive d)) m s
    regValue Enter300.saved out.basis=h ∧ out.basis 1685=false ∧ out.basis 1683=x ∧ out.basis 1684=y :=
  keep_values 1685 1683 1684 Enter300.saved s (run (body idx (withArchive d)) m s) h x y (keeps_stored d s m) high hn hf hu
theorem saved_at_leave (d:Bool) (raw cut:State) (z:SkywalkNat.State) (G S:Bool) (head ticks:List Bool)
    (small:min z.u z.v<2^106) (packed:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684
      (negative S z.u) (decide (Shadow.far 106 15 z)) (decide (Shadow.far 106 15 z ∧ 2^106≤z.u))
      (pullState (OB5.sig 299) raw) cut)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 300) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    let out:=run (body idx (withArchive d)) ticks (run Partial.enter300 head cut)
    regValue Enter300.saved out.basis=(if Shadow.far 106 15 z then Shadow.high 106 15 z else 0) ∧
      out.basis 1685=false ∧ out.basis 1683=decide (Shadow.far 106 15 z) ∧
      out.basis 1684=decide (Shadow.far 106 15 z ∧ 2^106≤z.u):=by
  let pre:=run Partial.enter300 head cut
  have high:=Enter300.high_from_cut raw cut z G S head small packed input
  have body:=Enter300.from_full raw cut z G S head small packed input
  have tags:=source_tags pre.basis z G S body.2.1
  exact relay d pre ticks (if Shadow.far 106 15 z then Shadow.high 106 15 z else 0) _ _ high tags.1 tags.2.1 tags.2.2

