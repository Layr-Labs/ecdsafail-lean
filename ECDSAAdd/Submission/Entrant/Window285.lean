  · simp [f,Expr.read,actualMode,farMode,ofFlags,enabled]

private theorem extract (p:Ports) (k:Mode) (s:Sym) (h:reads p s=controls p k) :
    s p.crossing=crossing p k ∧ s 1597=conj (crossing p k) (signExpr p k) := by
  simp only [reads,LeaveSelector.controls,List.cons.injEq,and_true,eq_self] at h
  exact ⟨h.2.1,h.2.2.2⟩

theorem controlsAt (k:Mode) :
    prior k 1694=crossing ports k ∧ prior k 1597=conj (crossing ports k) (signExpr ports k) :=
  extract ports k (prior k) (controlCert k)

theorem signed (z:SkywalkNat.State) (ref:BasisState)
    (small:min z.u z.v<2^114) (odd:z.v%2=1) (room:Shadow.high 114 15 z+1<2^127)
    (bits:∀i<16,ref (ports.u+i)=(Leave285TrueMiddle.X z).testBit i)
    (par:parityBits ports ref=oddBits (letters 15 (Shadow.reduced 114 15 z))) :
    let k:=actualMode 114 z
    let s:=fun q=>(prior k q).read ref
    s 1694=(if Shadow.far 114 15 z then HighBankSum.cross (Leave285TrueMiddle.d z) else false) ∧
    s 1597=(s 1694 && (signExpr ports k).read ref) ∧ (Shadow.far 114 15 z → s 1597=Leave285TrueMiddle.neg z) := by
  have h:=trueControls 114 127 z small odd room ports ref bits par
  obtain ⟨cx,gate⟩:=controlsAt (actualMode 114 z)
  dsimp only
  rw [cx,gate,read_conj]
  refine ⟨h.1,rfl,?_⟩
  intro f
  rw [h.1,h.2 f,if_pos f]
  rfl

