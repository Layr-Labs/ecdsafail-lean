def idx : Fin 23 := ⟨15,by decide⟩
def program (d:Bool) := renameProgram (OB5.sig 300) (Rolling1588.packAtTick d 290)
def reverse (d:Bool) := renameProgram (OB5.sig 300) (Rolling1588.unpackAtTick d 290)
def support := ((List.range' 285 5).flatMap fun v=>[OB5.sig 300 (base v),OB5.sig 300 (base (1028+v))])
theorem packs (d:Bool) : wires (program d)⊆support.toFinset := by
  cases d <;> exact ECDSAAdd.Entrant.WSlimMain.wires_subset_of_all (by decide +kernel)
theorem unpacks (d:Bool) : wires (reverse d)⊆support.toFinset := by
  cases d <;> exact ECDSAAdd.Entrant.WSlimMain.wires_subset_of_all (by decide +kernel)
theorem disjoint : ∀q∈support,q∉watch idx := by decide +kernel
theorem retains (d back:Bool) (s:State) (m:List Bool) :
    ∀q∈watch idx,(run (if back then reverse d else program d) m s).basis q=s.basis q:=by
  intro q hq
  apply run_preserves_outside
  intro used
  have seen:q∈support.toFinset:=by cases back
                                   · exact packs d used
                                   · exact unpacks d used
  exact disjoint _ (List.mem_toFinset.mp seen) hq
end NativePack300
