namespace ECDSAAdd.Entrant.StairPacket.Leave300AssembleCut
open Arithmetic WideReference RailPair
set_option maxRecDepth 35000
set_option maxHeartbeats 4000000

def leftovers (q : Wire) : Prop :=
  (315≤q ∧ q<331) ∨ (1344≤q ∧ q<1359) ∨ q=529 ∨ (984≤q ∧ q≤1042) ∨ (1755≤q ∧ q≤1812)

private theorem indexOfRange (q start count:Nat) (a:start≤q) (b:q<start+count) :
    ∃i:Fin count, start+i.val=q :=
  ⟨⟨q-start,by omega⟩,by change start+(q-start)=q;omega⟩

theorem result (s o : State) (neg far long : Bool)
    (phase : s.phase=o.phase) (sign : s.basis 1678=neg) (mode : s.basis 1676=far) (side : s.basis 1677=long)
    (low : ∀i:Fin 118, s.basis (331+i.val)=o.basis (331+i.val) ∧ s.basis (786+i.val)=o.basis (786+i.val))
    (high : ∀i:Fin 80, s.basis (449+i.val)=false ∧
      s.basis (904+i.val)=(if o.basis 330 then o.basis (904+i.val) else o.basis (449+i.val)))
    (ext : ∀q,Exterior 300 529 q → s.basis q=o.basis q)
    (left : ∀q,leftovers q → s.basis q=o.basis q)
    (clear : ∀q∈Leave300BoundaryClean.zeros,s.basis q=false)
    (carry : ∀q:Wire,1556≤q → q≤1754 → o.basis q=false) :
    PackedCut Portal315Flag.loPairs Portal315Flag.hiPairs 330 1678 1676 1677 neg far long o (eraseSites ParkEndpoint.src s) := by
  have loShape : Portal315Flag.loPairs=(List.finRange 3).map (fun j=>(331+(115+j.val),786+(115+j.val))) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have hiShape : Portal315Flag.hiPairs=(List.finRange 80).map (fun j=>(449+j.val,904+j.val)) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have away (q:Wire) (small:q<1556) : (eraseSites ParkEndpoint.src s).basis q=s.basis q := by
    have no:q∉ParkEndpoint.src:=by simp [ParkEndpoint.src,Wire] at *;omega
    simp [eraseSites,no]
  refine ⟨phase,?_,?_,?_,?_,?_,?_⟩
  · simpa [eraseSites,ParkEndpoint.src] using sign
  · simpa [eraseSites,ParkEndpoint.src] using mode
  · simpa [eraseSites,ParkEndpoint.src] using side
  · intro pair mem
    rw [loShape] at mem
    obtain ⟨j,_,rfl⟩:=List.mem_map.mp mem
    dsimp only
    have hj:=j.isLt
    rw [away (331+(115+j.val)) (by change 331+(115+j.val)<1556;omega),away (786+(115+j.val)) (by change 786+(115+j.val)<1556;omega)]
    exact low ⟨115+j.val,by omega⟩
  · intro pair mem
    rw [hiShape] at mem
    obtain ⟨j,_,rfl⟩:=List.mem_map.mp mem
    dsimp only
    have hj:=j.isLt
    rw [away (449+j.val) (by change 449+j.val<1556;omega),away (904+j.val) (by change 904+j.val<1556;omega)]
    exact high j
  · intro q notN notF notU _ notHi
    by_cases pending:q∈ParkEndpoint.src
    · have range : ∀q∈ParkEndpoint.src,1556≤q ∧ q≤1754 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
      obtain ⟨lo,hi⟩:=range q pending
      simp [eraseSites,pending,carry q lo hi]
    simp only [eraseSites,if_neg pending]
    by_cases external:Exterior 300 529 q
    · exact ext q external
    by_cases residual:leftovers q
    · exact left q residual
    have hiA (i:Fin 80) : 449+i.val∈sites Portal315Flag.hiPairs := by
      exact (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀i:Fin 80,449+i.val∈sites Portal315Flag.hiPairs) i
    have hiB (i:Fin 80) : 904+i.val∈sites Portal315Flag.hiPairs := by
      exact (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀i:Fin 80,904+i.val∈sites Portal315Flag.hiPairs) i
    have outside (start count:Nat) (h:∀i:Fin count,start+i.val∈sites Portal315Flag.hiPairs) : ¬(start≤q ∧ q<start+count) := by
      rintro ⟨a,b⟩
      obtain ⟨i,eq⟩:=indexOfRange q start count a b
      exact notHi (eq ▸ h i)
    have notA:=outside _ _ hiA
    have notB:=outside _ _ hiB
    by_cases a:331≤q ∧ q<449
    · obtain ⟨l,r⟩:=a
      obtain ⟨i,eq⟩:=indexOfRange q 331 118 l r
      exact eq ▸ (low i).1
    by_cases b:786≤q ∧ q<904
    · obtain ⟨l,r⟩:=b
      obtain ⟨i,eq⟩:=indexOfRange q 786 118 l r
      exact eq ▸ (low i).2
    have bounds : 1556≤q ∧ q≤1754 := by
      unfold Exterior at external;unfold leftovers at residual
      simp only [Wire] at *
      omega
    rw [carry _ bounds.1 bounds.2]
    apply clear
    simp only [Leave300BoundaryClean.zeros,List.mem_append,List.mem_range'_1]
    simp [ParkEndpoint.src,Wire] at pending
    simp only [Wire] at *
    omega
end ECDSAAdd.Entrant.StairPacket.Leave300AssembleCut

end
