    rw [split,run_append,run_take,preserved _ _ _ q (keptLayout q ok),prepared];rfl
  have h:=Leave285Front.result s m z G sg small ready fresh scratch temp
  have act:=Leave285EntryAction.upperBits _ a.basis h.2.2.2.2.2
  have math:=Leave285Loaded.signed z a.basis small odd room (fun i hi=>act i (Nat.lt_trans hi (by decide : 16<18)))
