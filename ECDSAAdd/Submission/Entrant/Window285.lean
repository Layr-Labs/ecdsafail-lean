set_option maxHeartbeats 2000000

theorem prepare (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^106)
    (ready:onRails 15 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).v) s.basis)
    (fresh:s.basis 1685=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false)
    (zero:∀q∈watched,s.basis q=false) (k:Mode) (smallU:Nat)
    (mode:k=farMode ((run entry m s).basis 1683) ((run entry m s).basis 1684) smallU)
    (exchange:right k=true → ∀i<15,i≤key k → (run entry m s).basis (swaps i)=decide (i=key k)) :
    let a:=run entry m s
    run (entry++fullPrefix false) m s=⟨a.phase,fun q=>(sim Leave300Selector.prepare (LeaveSelector.start ports false k) q).read a.basis⟩ := by
  let a:=run entry m s
  have keep:=Leave300FrontReady.frame s m z G sg small ready fresh scratch temp
  have clear (q:Wire) (h:q∈watched) : a.basis q=false := (keep q h).trans (zero q h)
  have cells (q:Nat) (lo:1561≤q) (hi:q≤1597) : q∈watched := by
    unfold watched
    apply List.mem_append_right
    rw [List.mem_range']; exact ⟨q-1559,by omega,by omega⟩
  rw [run_append,run_take]
  apply preparedState false a _ a.basis smallU k mode (clear _ (by decide)) (clear _ (by decide))
  · exact beforeFresh ports k a.basis (fun q lo hi=>clear q (cells q lo hi)) (clear _ (by decide)) (clear _ (by decide))
  · exact exchange


/-- R1: the state in front of the cross mux (same hypotheses as `prepare`). -/
theorem atCross (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^106)
    (ready:onRails 15 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).v) s.basis)
    (fresh:s.basis 1685=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false)
    (zero:∀q∈watched,s.basis q=false) (k:Mode) (smallU:Nat)
    (mode:k=farMode ((run entry m s).basis 1683) ((run entry m s).basis 1684) smallU)
    (exchange:right k=true → ∀i<15,i≤key k → (run entry m s).basis (swaps i)=decide (i=key k)) :
    (run (entry++crossPrefix) m s).basis 1686=false ∧
      ∀r∈Partial.leave300Rows,(run (entry++crossPrefix) m s).basis r.1=true → r.2=438+key k := by
  let a:=run entry m s
  have keep:=Leave300FrontReady.frame s m z G sg small ready fresh scratch temp
  have clear (q:Wire) (h:q∈watched) : a.basis q=false := (keep q h).trans (zero q h)
  have cells (q:Nat) (lo:1561≤q) (hi:q≤1597) : q∈watched := by
    unfold watched
    apply List.mem_append_right
    rw [List.mem_range']; exact ⟨q-1559,by omega,by omega⟩
  rw [run_append,run_take]
  apply crossReady a _ a.basis smallU k mode (clear _ (by decide)) (clear _ (by decide))
  · exact beforeFresh ports k a.basis (fun q lo hi=>clear q (cells q lo hi)) (clear _ (by decide)) (clear _ (by decide))
  · exact exchange
end ECDSAAdd.Entrant.StairPacket.Leave300FrontPrepare

