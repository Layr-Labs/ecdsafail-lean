namespace ECDSAAdd.Entrant.StairPacket.Leave300BoundaryRails
open Arithmetic Partial LeaveCompanion LeaveCompanion300 PortalValues Leave300Barrel Leave300High HighBankBarrel
open Leave300Front LeaveSelector Leave300Selector Leave300OutputPorts LeaveReadoutFrame IntegerHigh Leave300Close
open Leave300Relocated StairArchiveTrace
set_option maxRecDepth 50000
set_option maxHeartbeats 2000000

open MappedCompressed
attribute [local irreducible] run SkywalkNat.step

theorem lowFrame (i:Fin 106) (s:State) (m:List Bool) :
    let v:=run leave300 m s
    v.basis (331+i.val)=s.basis (331+i.val) ∧ v.basis (786+i.val)=s.basis (786+i.val) := by
  have cover:leave300.all (fun g=>decide ((destination g<331 ∨ 437≤destination g) ∧ (destination g<786 ∨ 892≤destination g)))=true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have safe (q:Nat) (inside:(331≤q ∧ q<437) ∨ (786≤q ∧ q<892)):q∉leave300.map destination := by
    intro h;obtain ⟨g,hg,rfl⟩:=List.mem_map.mp h
    obtain ⟨a,d⟩:=of_decide_eq_true (List.all_eq_true.mp cover g hg)
    rcases inside with ⟨l,r⟩|⟨l,r⟩
    · exact a.elim (Nat.not_lt_of_ge l) (Nat.not_le_of_lt r)
    · exact d.elim (Nat.not_lt_of_ge l) (Nat.not_le_of_lt r)
  have hi:=i.isLt
  exact ⟨preserved _ s m _ (safe _ (Or.inl ⟨by omega,by omega⟩)),
    preserved _ s m _ (safe _ (Or.inr ⟨by omega,by omega⟩))⟩

theorem result (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^106)
    (ready:onRails 15 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).v) s.basis)
    (fresh:s.basis 1685=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false)
    (odd:z.v%2=1) (room:Shadow.high 106 15 z+1<2^135)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,135 ≤ i → i<150 → s.basis (wire i)=false)
    (bank:regValue ys s.basis=if Shadow.far 106 15 z then Shadow.high 106 15 z else 0)
    (zero:∀q∈Leave300FrontReady.watched,s.basis q=false)
    (par:Leave300EntryAction.oddRead s.basis=oddBits (letters 15 (Shadow.reduced 106 15 z)))
    (mode:actualMode 106 z=farMode (s.basis 1683) (s.basis 1684) z.u)
    (events:right (actualMode 106 z)=true → ∀i<15,i≤key (actualMode 106 z) → s.basis (Leave300Hit.swaps i)=decide (i=key (actualMode 106 z)))
    (nextSmall:min (SkywalkNat.step^[15] z).u (SkywalkNat.step^[15] z).v<2^99)
    (bound:Leave300TrueMiddle.F z<2^150) (xs:List (Bool×Bool)) (len:xs.length=15)
    (historyOK:Shadow.far 106 15 z → chain (decide (2^106≤z.u)) xs)
    (first:Shadow.far 106 15 z → decide (2^106≤z.u)=false → ∀i(h:i<xs.length),i≤wait 15 z.u → xs[i].2=decide (i=wait 15 z.u))
    (saved:Leave300Close.events.map (fun p=>s.basis p.1)=(xs.take 5).map Prod.snd)
    (far:s.basis 1683=decide (Shadow.far 106 15 z))
    (side:s.basis 1684=(decide (Shadow.far 106 15 z) && decide (2^106≤z.u)))
    (highZero:∀q:Nat,456≤q → q≤528 → s.basis q=false)
    (raw:State) (input:let a:=SkywalkNat.step^[15] z
       SkywalkIntegerInput Leave300WideWords.L (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis) :
    let o:=pullState (OB5.sig 314) raw
    let out:=run leave300 m s
    (∀i:Fin 118,out.basis (331+i.val)=o.basis (331+i.val) ∧ out.basis (786+i.val)=o.basis (786+i.val)) ∧
    ∀i:Fin 80,out.basis (449+i.val)=false ∧
      out.basis (904+i.val)=(if o.basis 330 then o.basis (904+i.val) else o.basis (449+i.val)) := by
  let a:=SkywalkNat.step^[15] z
  let h:=SkywalkNat.step^[15] (Shadow.reduced 106 15 z)
  let o:=pullState (OB5.sig 314) raw
  let out:=run leave300 m s
  have word:=Leave300EndWords.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound xs len historyOK first saved far side
  have whole:=Leave300Whole.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound xs len historyOK first saved far side
  have cleared:=Leave300HighZero.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events highZero nextSmall bound
  have orient:o.basis 330=G := by
    have geo:Leave300WideWords.L.previous=OB5.sig 314 330:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    change raw.basis (OB5.sig 314 330)=G
    rw [←geo];exact input.2.2.1
  have law:=LeaveShadowRails.retainedLow 106 z small sg
  constructor
  · intro i
    have fit:i.val<198:=by have h:=i.isLt;omega
    have ref:=Leave300WideWords.wide a G sg raw input ⟨i.val,fit⟩
    by_cases low:i.val<106
    · have hw:=Leave300WideWords.short h G sg s ready ⟨i.val,low⟩
      have untouched:=lowFrame ⟨i.val,low⟩ s m
      have spos:=LeaveSignedCoordinates.sharedDigit _ _ 106 i.val law.2.1 (Nat.le_of_lt low)
      have smag:=LeaveSignedCoordinates.sharedDigit _ _ 106 i.val law.2.2 (Nat.le_of_lt low)
      dsimp only at ref hw
      rw [law.1,spos,smag] at ref
      exact ⟨untouched.1.trans (hw.1.trans ref.1.symm),untouched.2.trans (hw.2.trans ref.2.symm)⟩
    · let j:Fin 12:=⟨i.val-106,by have h:=i.isLt;omega⟩
      have eq:106+j.val=i.val:=by dsimp [j];omega
      have vals:=word.2.2.2.2.1 j
      dsimp only at ref vals
      rw [eq,show (437:Nat)+j.val=331+i.val by omega,show (892:Nat)+j.val=786+i.val by omega] at vals
      exact ⟨vals.1.trans ref.1.symm,vals.2.trans ref.2.symm⟩
  · intro i
    let j:Fin 198:=⟨118+i.val,by have h:=i.isLt;omega⟩
    have ref:=Leave300WideWords.wide a G sg raw input j
    dsimp only [j] at ref
    rw [show 331+(118+i.val)=449+i.val by omega,show 786+(118+i.val)=904+i.val by omega] at ref
    have free:(run leave300 m s).basis (449+i.val)=false := by
      rw [whole.2.2.2.2,(upperMap i).2]
      exact (Function.update_of_ne (by have h:=i.isLt;change (449:Nat)+i.val≠1684;omega) _ _).trans (cleared i)
    refine ⟨free,?_⟩
    change out.basis (904+i.val)=(if o.basis 330 then o.basis (904+i.val) else o.basis (449+i.val))
    rw [orient,word.2.2.2.2.2 i];cases G <;> simpa only [Bool.false_eq_true,ite_false,ite_true] using (by first | exact ref.1.symm | exact ref.2.symm)
end ECDSAAdd.Entrant.StairPacket.Leave300BoundaryRails

end
