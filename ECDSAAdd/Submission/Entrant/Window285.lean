theorem spare_unchanged (d:Bool) (s:State) (a b:List Bool) (q:Wire) (member:q∈spares) :
    (run (body idx (withArchive d)) b (run Partial.enter300 a s)).basis q=s.basis q:=by
  have first:=body_cover idx (withArchive d) spares (support++ArchiveBoundary300.rawPortsList) (fun v h=>(extra_geometry v h).1)
    (fun v h=>(extra_geometry v h).2.1) (admin_cover d) (run Partial.enter300 a s) b q member
  exact first.trans (run_preserves_outside _ a s q (fun mem=>(extra_geometry _ member).2.2.1 (List.mem_toFinset.mp (Enter300.programCover mem))))
theorem extra_clean (d:Bool) (raw s:State) (a b:List Bool) (neg far long G:Bool) (A B:Int)
    (cut:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long (pullState (OB5.sig 299) raw) (eraseSites Enter300.pending s))
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 300) A B G raw.basis) :
    ∀q∈spares,(run (body idx (withArchive d)) b (run Partial.enter300 a s)).basis q=false:=by
  intro q h
  obtain ⟨_,_,_,carry,hn,hf,hu,hi⟩:=extra_geometry q h
  have stored:=cut.unchanged q hn hf hu hi
  have same:∀q∈spares,q∉Enter300.pending:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have original:s.basis q=raw.basis (OB5.sig 299 q):=by simpa [eraseSites,same _ h] using stored
  exact (spare_unchanged d s a b q h).trans (original.trans ((regValue_zero _ _).mp input.2.2.2.2.2 _ carry))
def retiredTop:=List.range' 999 44
theorem retiredTop_geometry : ∀q∈retiredTop,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary300.rawPortsList) ∧ q∉ports300 ∧
    OB5.sig 299 q=q ∧ q≠1685 ∧ q≠1683 ∧ q≠1684 ∧ q∉RailPair.sites Enter300.upperPairs ∧ q∉Enter300.pending :=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem retiredTop_unchanged (d:Bool) (s:State) (a b:List Bool) (q:Wire) (member:q∈retiredTop) :
    (run (body idx (withArchive d)) b (run Partial.enter300 a s)).basis q=s.basis q:=by
  have first:=body_cover idx (withArchive d) retiredTop (support++ArchiveBoundary300.rawPortsList) (fun v h=>(retiredTop_geometry v h).1)
    (fun v h=>(retiredTop_geometry v h).2.1) (admin_cover d) (run Partial.enter300 a s) b q member
  exact first.trans (run_preserves_outside _ a s q (fun mem=>(retiredTop_geometry _ member).2.2.1 (List.mem_toFinset.mp (Enter300.programCover mem))))
theorem retiredTop_clean (d:Bool) (raw s:State) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter300.lowerPairs Enter300.upperPairs 315 1685 1683 1684 neg far long (pullState (OB5.sig 299) raw) (eraseSites Enter300.pending s))
    (zero:∀q∈retiredTop,raw.basis q=false) :
    ∀q∈retiredTop,(run (body idx (withArchive d)) b (run Partial.enter300 a s)).basis q=false:=by
  intro q h
  obtain ⟨_,_,_,fix,hn,hf,hu,hi,away⟩:=retiredTop_geometry q h
  have stored:=cut.unchanged q hn hf hu hi
  have original:s.basis q=raw.basis (OB5.sig 299 q):=by simpa [eraseSites,away] using stored
  rw [fix] at original
  exact (retiredTop_unchanged d s a b q h).trans (original.trans (zero q h))
theorem bank_of_saved (X:BasisState) (H:Nat) (h:regValue Enter300.saved X=H) (zero:∀q∈retiredTop,X q=false) :
    regValue Leave300High.ys X=H:=by
  have split:Leave300High.ys=Enter300.saved++retiredTop:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  rw [split,regValue_append,h,(regValue_zero _ _).mpr zero,Nat.mul_zero,Nat.add_zero]
