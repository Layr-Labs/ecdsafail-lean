theorem shape : program=Leave285BeforeStore.program++beforeTags := by simp only [ECDSAAdd.Entrant.WSlimV3.take_merge, eq_self, ECDSAAdd.Entrant.StairPacket.Leave285Close.beforeTags, ECDSAAdd.Entrant.StairPacket.Leave285BeforeStore.program, ECDSAAdd.Entrant.StairPacket.Leave285StoreMapped.program]
attribute [local irreducible] run SkywalkNat.step

private theorem store (s v:State) (m:List Bool) (G sign:Bool) (sum mag:Nat)
    (previous:s.basis 315=G) (hist:∀q∈history,v.basis q= !s.basis q) (signed:v.basis 1693=sign)
    (words:∀i:Fin 11,v.basis (430+i.val)=sum.testBit (114+i.val) ∧ v.basis (900+i.val)=mag.testBit (114+i.val)) :
    let out:=run beforeTags m v
    out.phase=v.phase ∧ (∀q∈history,out.basis q=s.basis q) ∧
    (∀i:Fin 11,let pos:=sum.testBit (114+i.val);let neg:=mag.testBit (114+i.val) ^^ sign
                   out.basis (430+i.val)=(if G then neg else pos) ∧ out.basis (900+i.val)=(if G then pos else neg)) ∧
    ∀q,q∉RailPair.sites low → q∉history → out.basis q=v.basis q := by
  have wrote:=lowResult v m
  let h:=fun q:Wire=>if q∈history then !v.basis q else v.basis q
  have ctrl:h 315=G := by simp only [h,if_pos (by decide : 315∈history),hist 315 (by decide),Bool.not_not,previous]
  have signBit:h 1693=sign := by simpa only [h,if_neg (by decide : 1693∉history)] using signed
  refine ⟨wrote.1,?_,?_,?_⟩
  · intro q hq
    have sep:∀a∈history,a∉RailPair.sites low:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    rw [wrote.2.1 q (sep q hq)];simp only [if_pos hq,hist q hq,Bool.not_not]
  · intro i
    let pair:Wire×Wire:=(430+i.val,900+i.val)
    have sites:∀j:Fin 11,(430+j.val,900+j.val)∈low ∧ 430+j.val∉history ∧ 900+j.val∉history:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    have l:=wrote.2.2 pair (sites i).1
    change _=(if h 315 then h pair.2 ^^ h 1693 else h pair.1) ∧ _=(if h 315 then h pair.1 else h pair.2 ^^ h 1693) at l
    have pos:h pair.1=sum.testBit (114+i.val):=by simpa only [h,pair,if_neg (sites i).2.1] using (words i).1
    have neg:h pair.2=mag.testBit (114+i.val):=by simpa only [h,pair,if_neg (sites i).2.2] using (words i).2
    rw [ctrl,signBit,pos,neg] at l
    exact l
  · intro q lo hn
    exact (wrote.2.1 q lo).trans (if_neg hn)

theorem result (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^114)
    (ready:onRails 14 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 114 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 114 15 z)).v) s.basis)
    (fresh:s.basis 1693=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false)
    (odd:z.v%2=1) (room:Shadow.high 114 15 z+1<2^127)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,127 ≤ i → i<142 → s.basis (wire i)=false)
    (bank:regValue ys s.basis=if Shadow.far 114 15 z then Shadow.high 114 15 z else 0)
    (zero:∀q∈Leave285FrontReady.watched,s.basis q=false)
    (par:Leave285EntryAction.oddRead s.basis=oddBits (letters 15 (Shadow.reduced 114 15 z)))
    (mode:actualMode 114 z=farMode (s.basis 1691) (s.basis 1692) z.u)
    (events:right (actualMode 114 z)=true → ∀i<15,i≤key (actualMode 114 z) → s.basis (Leave285Hit.swaps i)=decide (i=key (actualMode 114 z)))
    (nextSmall:min (SkywalkNat.step^[15] z).u (SkywalkNat.step^[15] z).v<2^106)
    (bound:Leave285TrueMiddle.F z<2^142) :
    let a:=SkywalkNat.step^[15] z
    let sign:=negative sg a.u
    let mag:=a.u-sign.toNat
    let before:=run Leave285BeforeStore.program m s
    let out:=run program m s
    out.phase=s.phase ∧ (∀q∈history,out.basis q=s.basis q) ∧
    (∀i:Fin 11,let pos:=(a.u+a.v).testBit (114+i.val);let neg:=mag.testBit (114+i.val) ^^ sign
                   out.basis (430+i.val)=(if G then neg else pos) ∧ out.basis (900+i.val)=(if G then pos else neg)) ∧
    ∀q,q∉RailPair.sites low → q∉history → out.basis q=before.basis q := by
  have coords:=Leave285StoreCoordinates.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound
  have prev:s.basis 315=G := by have h:=ready.2.2.1;cases G <;> exact h
  have phase:=(Leave285BeforeStore.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound).1
  have done:=store s _ (m.drop (measurementCount Leave285BeforeStore.program)) G _ _ _ prev coords.2.1 coords.1 coords.2.2
  dsimp only
  rw [shape,run_append,run_take]
  exact ⟨done.1.trans phase,done.2⟩
