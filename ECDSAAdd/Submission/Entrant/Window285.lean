  intro r
  rcases hist_sources r with eq|eq|⟨lo,hi⟩
  · rw [eq];exact endScratch.1
  · rw [eq];exact endScratch.2
  · apply (regValue_zero _ _).mp input.2.2.2.2.2;rw [carry_range,List.mem_range'_1];simp only [Wire] at *;omega

