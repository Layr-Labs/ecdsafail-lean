namespace ECDSAAdd.Entrant.StairPacket.Leave285WideWords
open Arithmetic MappedCompressed PortalValues LeaveSignedCoordinates
set_option maxRecDepth 60000
set_option maxHeartbeats 2000000

abbrev L:=W.compactSkywalkTickLayout base 300
abbrev shortL:=IntegerPacket.ports (shape 14) 15

theorem shortMapping (i:Fin 114):
    windowNet 14 (shortL.a.getD i.val 0)=316+i.val ∧
    windowNet 14 (shortL.b.getD i.val 0)=786+i.val := by
  have h1 : (shortL.a.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (shortL.b.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  revert i
  simp only [ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2]
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem wideMapping (i:Fin 213):
    L.a.getD i.val 0=OB5.sig 299 (316+i.val) ∧
    L.b.getD i.val 0=OB5.sig 299 (786+i.val) := by
  have h1 : (L.a.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (L.b.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  revert i
  simp only [ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2]
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem wide (a:SkywalkNat.State) (G sg:Bool) (raw:State)
    (input:SkywalkIntegerInput L (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis)
    (i:Fin 213) :
    let o:=pullState (OB5.sig 299) raw
    let e:=negative sg a.u
    let pos:=(a.u+a.v).testBit i.val
    let neg:=(a.u-e.toNat).testBit i.val ^^ e
    o.basis (316+i.val)=(if G then neg else pos) ∧ o.basis (786+i.val)=(if G then pos else neg) := by
  have maxA:213≤L.a.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have maxB:213≤L.b.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h:=pair L G sg a.u a.v i.val raw.basis input.1 input.2.1 input.2.2.1
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  rw [(wideMapping i).1,(wideMapping i).2] at h
  exact h

theorem short (a:SkywalkNat.State) (G sg:Bool) (s:State)
    (ready:onRails 14 15 (SkywalkRails.encode G sg a.u a.v) s.basis) (i:Fin 114) :
    let e:=negative sg a.u
    let pos:=(a.u+a.v).testBit i.val
    let neg:=(a.u-e.toNat).testBit i.val ^^ e
    s.basis (316+i.val)=(if G then neg else pos) ∧ s.basis (786+i.val)=(if G then pos else neg) := by
  have maxA:114≤shortL.a.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have maxB:114≤shortL.b.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have prev:mappedBasis 14 s.basis shortL.previous=G:=by cases G <;> exact ready.2.2.1
  have h:=pair shortL G sg a.u a.v i.val (mappedBasis 14 s.basis) ready.1 ready.2.1 prev
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  unfold mappedBasis at h
  dsimp only at h
  rw [(shortMapping i).1,(shortMapping i).2] at h
  exact h
end ECDSAAdd.Entrant.StairPacket.Leave285WideWords

