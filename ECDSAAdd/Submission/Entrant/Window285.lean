/-- Wires the exit at 300 hands back to the reference: the top a-wire, the released B pool above the moved bank and
the placed images 1329..1343 of the dead carries 1770..1784. -/
def releasedSite (q:Nat) := q=529 ∨ (999≤q ∧ q≤1042) ∨ (1329≤q ∧ q≤1343)
instance (q:Nat):Decidable (releasedSite q) := by unfold releasedSite;infer_instance
/-- Released sites plus the folded homes 1800..1812 of ticks 257..269, which window 285 never touches. -/
def agreeSite (q:Nat) := releasedSite q ∨ (1800≤q ∧ q≤1812)
instance (q:Nat):Decidable (agreeSite q) := by unfold agreeSite;infer_instance

theorem released (x p:Nat) (good:Bounds x p) (raw history:State) (dom:Domain 285 x p raw) (q:Nat)
    (site:releasedSite q) :
    (origin 285 raw history).basis q=false := by
  have off:∀i:Fin 1344,releasedSite i.val →
      i.val∉sites 285 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have bound:q<1344:=by unfold releasedSite at site;omega
  rw [outside _ _ _ _ (off ⟨q,bound⟩ site)]
  by_cases mirror:1329≤q ∧ q≤1343
  · have map:OB5.sig 299 q=3113-q:=by simp [OB5.sig,show 1301≤q by omega,show q≤1044+299 by omega]
    rw [show 285+14=299 by decide,map]
    exact full_carry 285 15 x p (by decide) good raw dom [] _ (by omega) (by omega)
  have small:q=529 ∨ (999≤q ∧ q≤1042):=by unfold releasedSite at site;omega
  have ident:OB5.sig (285+14) q=q:=by unfold OB5.sig;rw [if_neg];simp only [Wire] at *;omega
  rw [ident]
  obtain ⟨reference,same,stage⟩:=dom
  have finish:=full_span 285 15 x p (by decide) good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime reference [] stage
  have offHist:¬Earlier 285 q:=outside_between (by omega) (by omega)
  have link:=fixed_span 285 285 15 (Nat.le_refl _) (by decide) raw reference [] same
  apply (link.2 q offHist).trans
  rcases small with rfl|⟨lo,hi⟩
  · exact finish.2.1 _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  · have members : ∀i∈List.range' 999 44,i∈(W.compactSkywalkSignPoolB base 300).released := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    exact finish.2.2 q (members _ (List.mem_range'_1.mpr ⟨lo,by omega⟩))
end ECDSAAdd.Entrant.StairPacket.Leave285ReleasedOrigin

