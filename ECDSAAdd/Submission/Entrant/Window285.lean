  dsimp only
  rw [Leave300Join.emitted,run_append,run_take,show measurementCount digitPass=0 from (digits_counts _ _ _ _ _ _).2,List.drop_zero,none]
  exact ⟨v.1,fun i => by simpa only [Nat.mul_zero,Nat.zero_add,Nat.mod_eq_of_lt bound] using v.2.1 i.val i.isLt,v.2.2⟩

