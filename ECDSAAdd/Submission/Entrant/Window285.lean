theorem bounds300 (z : SkywalkNat.State) (h : z.u+z.v≤2^256+2^255) : Shadow.high 106 15 z+1 < 2^135 := by
  simp only [Shadow.high,Shadow.limb]
  norm_num1 at h ⊢
  omega
theorem outputs300 (z : SkywalkNat.State) (h : z.u+z.v<2^257) (k : Nat) :
