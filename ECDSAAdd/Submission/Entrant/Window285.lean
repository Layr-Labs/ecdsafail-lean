namespace ECDSAAdd.Entrant.StairPacket.Leave300PreservedRecords
open LeaveSelector LeaveReadoutFrame Arithmetic IntegerPacket Partial LeaveCompanion LeaveCompanion300 Leave300Front Leave300Selector
set_option maxRecDepth 30000
set_option maxHeartbeats 2500000

theorem swapPolarity : ∀i:Fin 15, ECDSAAdd.Entrant.StairPacket.LeaveSelector.parityAt (Leave300Hit.swaps i.val) leave300=some false := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem result (s : State) (m : List Bool)
    (previous : ∀q∈Leave300Close.history,(run leave300 m s).basis q=s.basis q) :
    readCells (shape 15) 0 15 (mappedBasis 15 (run leave300 m s).basis) =
      readCells (shape 15) 0 15 (mappedBasis 15 s.basis) := by
  let rows (v : BasisState) := (List.range 15).map (fun i=>(v (316+i),v (Leave300Hit.swaps i)))
  have geometry (v : BasisState) : readCells (shape 15) 0 15 (mappedBasis 15 v)=rows v := by rfl
  rw [geometry,geometry]
  apply List.map_congr_left
  intro i hi
  have port : ∀i∈List.range 15,316+i∈Leave300Close.history := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  exact Prod.ext (previous _ (port _ hi)) (by simpa using polarity _ _ _ (swapPolarity ⟨i,List.mem_range.mp hi⟩) s m)

end ECDSAAdd.Entrant.StairPacket.Leave300PreservedRecords

end
