    let a:=SkywalkNat.step^[15] (Shadow.reduced 106 15 z)
    let e:=negative sg a.u
    let out:=run entry m s
    out.phase=s.phase ∧ regValue fullM out.basis=0 ∧ out.basis 1685=e ∧
      out.basis 1556=decide (2^106≤a.u-e.toNat) ∧ (out.basis 1558).toNat=upperBorrow (2^106) a.u a.v e.toNat ∧
      ∀i<19,out.basis (437+i)=((a.u+a.v)/2^106).testBit i := by
  let a:=SkywalkNat.step^[15] (Shadow.reduced 106 15 z)
