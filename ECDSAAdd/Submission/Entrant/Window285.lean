namespace ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic
open Arithmetic Partial LeaveCompanion LeaveCompanion300 PortalValues Leave300Barrel Leave300High HighBankBarrel
open Leave300Front LeaveSelector Leave300Selector Leave300OutputPorts LeaveReadoutFrame IntegerHigh
set_option maxRecDepth 50000
set_option maxHeartbeats 3000000

def program:=leave300.take 2969
theorem shape : program=entry++(Leave300Routed.body++restore) := by simp only [ECDSAAdd.Entrant.WSlimV3.seg_merge, ECDSAAdd.Entrant.WSlimV3.take_merge, eq_self, ECDSAAdd.Entrant.StairPacket.LeaveCompanion300.restore, ECDSAAdd.Entrant.StairPacket.Leave300Front.entry, ECDSAAdd.Entrant.StairPacket.Leave300Routed.body, ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic.program]
def unmodified (q:Wire) := q∉entry.map destination
instance (q:Wire):Decidable (unmodified q) := inferInstanceAs (Decidable (q∉_))
attribute [local irreducible] run SkywalkNat.step

theorem result (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^106)
    (ready:onRails 15 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).v) s.basis)
    (fresh:s.basis 1685=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false)
    (odd:z.v%2=1) (room:Shadow.high 106 15 z+1<2^135)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,135 ≤ i → i<150 → s.basis (wire i)=false)
    (bank:regValue ys s.basis=if Shadow.far 106 15 z then Shadow.high 106 15 z else 0)
    (zero:∀q∈Leave300FrontReady.watched,s.basis q=false)
    (par:Leave300EntryAction.oddRead s.basis=oddBits (letters 15 (Shadow.reduced 106 15 z)))
    (mode:actualMode 106 z=farMode (s.basis 1683) (s.basis 1684) z.u)
    (events:right (actualMode 106 z)=true → ∀i<15,i≤key (actualMode 106 z) → s.basis (Leave300Hit.swaps i)=decide (i=key (actualMode 106 z))) :
    let a:=SkywalkNat.step^[15] z
    let mag:=a.u-(negative sg a.u).toNat
    let out:=run program m s
    out.phase=s.phase ∧ regValue smallM out.basis=(mag/2^107)%2^11 ∧
    out.basis 1556=decide (2^106≤mag) ∧ (∀i<150,out.basis (live i)=(Leave300TrueMiddle.F z).testBit i) := by
  let a:=run entry m s
  let n:=m.drop (measurementCount entry)
  let h:=SkywalkNat.step^[15] (Shadow.reduced 106 15 z)
  have front:=Leave300Front.result s m z G sg small ready fresh scratch temp
  have watched:=Leave300FrontReady.frame s m z G sg small ready fresh scratch temp
  have kept (q:Wire) (ok:unmodified q):a.basis q=s.basis q:=preserved entry s m q ok
  have cs:∀q∈carries,unmodified q:=by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic.unmodified); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have pad:∀i:Fin 150,135 ≤ i.val → unmodified (wire i):=by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic.unmodified); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have rawBank:∀q∈ys,unmodified q:=by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic.unmodified); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have sw:∀i:Fin 15,unmodified (Leave300Hit.swaps i):=by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic.unmodified); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have used:=Leave300Routed.result z a n small odd room (fun q hq=>(kept _ (cs q hq)).trans (clean q hq))
    (fun i lo hi=>(kept _ (pad ⟨i,hi⟩ lo)).trans (padding i lo hi))
    (Leave300EntryAction.upperBits h a.basis front.2.2.2.2.2)
    (((regValue_eq_iff _ _ _).mpr (fun q hq=>kept _ (rawBank _ hq))).trans bank)
    (fun q hq=>(watched _ hq).trans (zero _ hq))
    ((Leave300EntryAction.parity s m).trans par)
    (by rw [kept _ (by decide),kept _ (by decide)];exact mode)
    (fun on i hi hq=>(kept _ (sw ⟨i,hi⟩)).trans (events on i hi hq))
  have restored:=Leave300RoutedRestore.result z sg a n (n.drop (measurementCount Leave300Routed.body)) small
    front.2.1 ⟨front.2.2.2.1,front.2.2.2.2.1⟩ used.2.1 used.2.2.2.1
  dsimp only
  rw [shape,run_append,run_take,run_append,run_take]
  exact ⟨restored.1.trans (used.1.trans front.1),restored.2.2.1,restored.2.2.2⟩
end ECDSAAdd.Entrant.StairPacket.Leave300FullArithmetic

