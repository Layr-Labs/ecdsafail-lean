namespace ECDSAAdd.Entrant.StairPacket.WideReference
open Arithmetic MappedCompressed SkywalkRails
set_option maxRecDepth 20000
set_option maxHeartbeats 3500000
/-- Window 285: every history site of window 270's ticks (logical 1314..1328) is moved by the late-sign fold
`OB5.sig 299` to its placed home 1799..1785; the a-sites 286..300 are fixed. -/
theorem fold285 : ∀q∈sites 285,OB5.sig (285+14) q=q ∨ (1314≤q ∧ q≤1328) := by
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem fold285_wire (q:Nat) (lo:1314≤OB5.sig (285+14) q) (hi:OB5.sig (285+14) q≤1328) : 1785≤q ∧ q≤1799 := by
  have lo':1314≤OB5.sigNat (285+14) q:=lo
  have hi':OB5.sigNat (285+14) q≤1328:=hi
  unfold OB5.sigNat at lo' hi'
  split_ifs at lo' hi' <;> omega
/-- `after_coherent_fold` for the band 1314..1328. -/
theorem after_coherent_foldG (i:Nat) (lo:15≤ i) (hi:i+15≤512) (raw history ref:State)
    (same:Coherent i raw ref)
    (fold:∀q∈sites i,OB5.sig (i+14) q=q ∨ (1314≤q ∧ q≤1328))
    (clean:∀q:Wire,1314≤q → q≤1328 → history.basis q=false)
    (carries:∀q:Wire,1314≤OB5.sig (i+14) q → OB5.sig (i+14) q≤1328 → (run (span i 15) [] ref).basis q=false) :
    Coherent (i+15) (endRaw i raw history) (run (span i 15) [] ref) := by
  have c:=coherent_span i 15 hi raw ref same []
  refine ⟨c.1,?_⟩
  intro q off
  have invol:=OB5.sig_invol (i+14) (by omega) q
  change (origin i raw history).basis (OB5.sig (i+14) q)=_
  by_cases hit:OB5.sig (i+14) q∈sites i
  · rcases fold _ hit with h|⟨l,u⟩
    · rw [invol] at h
      exact absurd (h ▸ past_slot i _ lo hit) off
    · rw [inside i raw history _ hit,clean _ l u,carries q l u]
  · rw [outside i raw history _ hit,invol,c.2 q off]
/-- `advance` at 285: the folded sites carry the history value of 1314..1328, which must be clean; the reference
is clean on the matching placed homes 1785..1799. -/
theorem advance285 (x p:Nat) (hp0:0<p) (hx0:0<x) (odd:p%2=1) (hp:p<2^256)
    (gap:p+2^32≤2^256) (hx:x<p) (cop:x.Coprime p) (raw history:State)
    (clean:∀q:Wire,1314≤q → q≤1328 → history.basis q=false) (dom:Domain 285 x p raw) :
    Domain (285+15) x p (endRaw 285 raw history) := by
  obtain ⟨ref,same,valid⟩:=dom
  have fin:=full_span 285 15 x p (by decide) hp0 hx0 odd hp gap hx cop ref [] valid
  have fields:=(W.compactSkywalkStage_fields_iff base _ (285+15) (by decide) base_pool_nodup _).mp fin
  have zero:=(regValue_zero _ _).mp fields.2.2.2.2.2.1
  refine ⟨_,after_coherent_foldG 285 (by decide) (by decide) raw history ref same fold285 clean ?_,fin⟩
  intro q l u
  have qb:=fold285_wire q l u
  exact zero q (List.mem_map.mpr ⟨(q:Nat)-16,List.mem_range'_1.mpr (by omega),Nat.sub_add_cancel (by omega)⟩)
theorem advance_signed285 (b x p:Nat) (good:Bounds x p)
    (raw history:State) (clean:∀q:Wire,1314≤q → q≤1328 → history.basis q=false) (dom:Domain 285 x p raw) (G S:Bool)
    (input:InputAt 285 (encode G S (unsigned 285 x p).u (unsigned 285 x p).v) raw)
    (small:min (unsigned 285 x p).u (unsigned 285 x p).v<2^b) :
    let z:=unsigned 285 x p
    let t:=Shadow.reduced b 15 z
    let flags:=SharedSigned.flags G S (SkywalkTrace.trace 15 (encode G S z.u z.v))
    let endState:=unsigned (285+15) x p
    SkywalkTrace.next^[15] (encode G S t.u t.v)=encode flags.1 flags.2 (SkywalkNat.step^[15] t).u (SkywalkNat.step^[15] t).v ∧
      InputAt (285+15) (encode flags.1 flags.2 endState.u endState.v) (endRaw 285 raw history):=by
  let z:=unsigned 285 x p
  have odd:z.v%2=1:=(SkywalkNat.iter_valid 285 (SkywalkNat.init x p) good.positive good.odd).2.1
  obtain ⟨a,b'⟩:=SharedSigned.same b z small odd G S
  have eq:=unique_input input (fixed_input 285 x p (by decide) good raw dom)
  have stepRel:canonical (285+15) x p=SkywalkTrace.next^[15] (canonical 285 x p):=by rw [Nat.add_comm];exact Function.iterate_add_apply _ _ _ _
  have numRel:unsigned (285+15) x p=SkywalkNat.step^[15] z:=by rw [Nat.add_comm];exact Function.iterate_add_apply _ _ _ _
  have nextDom:=advance285 x p good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime raw history clean dom
  have active:=fixed_input (285+15) x p (by decide) good (endRaw 285 raw history) nextDom
  dsimp only
  refine ⟨a,?_⟩
  rw [stepRel,←eq,b'] at active
  simpa only [numRel] using active
/-- `Enter285.ready_from_cut`'s `endScratch` from the window-285 domain: 1784/1783 are stock carries and lie above
every earlier history site. -/
theorem endScratch285 {x p:Nat} {s:State} (dom:Domain 285 x p s) : s.basis 1784=false ∧ s.basis 1783=false := by
  obtain ⟨ref,same,stage⟩:=dom
  have fields:=(W.compactSkywalkStage_fields_iff base _ 285 (by decide) base_pool_nodup _).mp stage
  have zero:=(regValue_zero _ _).mp fields.2.2.2.2.2.1
  have off:∀q:Nat,1044+285≤q → ¬Earlier 285 q:=by
    rintro q hq ⟨t,ht,h|h⟩
    · change q=t+16 at h;omega
    · change q=1028+t+16 at h;omega
  exact ⟨(same.2 _ (off 1784 (by decide))).trans (zero _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))),
    (same.2 _ (off 1783 (by decide))).trans (zero _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)))⟩
/-! Fold-aware handoff (window 285 -> exit 300).  Window 285 packs/archives the histories of window 270's ticks
270..284, which the late-sign fold places at PHYSICAL 1799..1785.  `originG`/`endRawG` overlay the actual state at
those physical homes as well; they differ from `origin`/`endRaw` only at logical 1314..1328, which are
`Earlier (i+15)` for i ≥ 285. -/
def foldSitesG : List Wire := List.range' 1785 15
def sitesG (i:Nat) : List Wire := sites i ++ foldSitesG
def overlayG (i:Nat) (wide history:State) : State :=
  ⟨wide.phase,fun q=>if q∈sitesG i then history.basis q else wide.basis q⟩
def originG (i:Nat) (raw history:State) : State :=
  overlayG i (pullState (OB5.sig (i+14)) (run (span i 15) [] raw)) history
def endRawG (i:Nat) (raw history:State) : State := pullState (OB5.sig (i+14)) (originG i raw history)
theorem endpointG (i:Nat) (limit:i+14≤511) (raw history:State) :
    pullState (OB5.sig (i+14)) (endRawG i raw history)=originG i raw history :=
  OB5.pull_invol _ limit _
theorem outsideG (i:Nat) (raw history:State) (q:Wire) (h:q∉sitesG i) :
    (originG i raw history).basis q=(run (span i 15) [] raw).basis (OB5.sig (i+14) q) := by
  simp [originG,overlayG,h,pullState]
theorem insideG (i:Nat) (raw history:State) (q:Wire) (h:q∈sitesG i) :
    (originG i raw history).basis q=history.basis q := by simp [originG,overlayG,h]
theorem originG_phase (i:Nat) (raw history:State) : (originG i raw history).phase=(origin i raw history).phase := rfl
theorem endRawG_phase (i:Nat) (raw history:State) : (endRawG i raw history).phase=(endRaw i raw history).phase := rfl
/-- off the physical fold homes the two overlays agree -/
theorem originG_eq (i:Nat) (raw history:State) (q:Wire) (h:q∉foldSitesG) :
    (originG i raw history).basis q=(origin i raw history).basis q := by
  by_cases s:q∈sites i
  · have m:q∈sitesG i:=List.mem_append.mpr (Or.inl s)
    rw [insideG i raw history q m,inside i raw history q s]
  · have m:q∉sitesG i:=fun hm=>(List.mem_append.mp hm).elim s h
    rw [outsideG i raw history q m,outside i raw history q s]
theorem endRawG_eq (i:Nat) (raw history:State) (q:Wire) (h:OB5.sig (i+14) q∉foldSitesG) :
    (endRawG i raw history).basis q=(endRaw i raw history).basis q :=
  originG_eq i raw history _ h
/-- a placed fold home pulls back to a logical history home of window 270's ticks 270..284 -/
theorem fold_earlierG (q:Nat) (h:OB5.sig (285+14) q∈foldSitesG) : Earlier (285+15) q := by
  have b:=List.mem_range'_1.mp h
  have lo':1785≤OB5.sigNat (285+14) q:=b.1
  have hi':OB5.sigNat (285+14) q<1785+15:=b.2
  unfold OB5.sigNat at lo' hi'
  split_ifs at lo' hi' with c
  · exact ⟨q-1044,by omega,Or.inr (by simp only [base,Wire];omega)⟩
  · omega
/-- `advance285` for the fold-aware handoff state -/
theorem advance285G (x p:Nat) (hp0:0<p) (hx0:0<x) (odd:p%2=1) (hp:p<2^256)
    (gap:p+2^32≤2^256) (hx:x<p) (cop:x.Coprime p) (raw history:State)
    (clean:∀q:Wire,1314≤q → q≤1328 → history.basis q=false) (dom:Domain 285 x p raw) :
    Domain (285+15) x p (endRawG 285 raw history) :=
  domain_congr (advance285 x p hp0 hx0 odd hp gap hx cop raw history clean dom) (endRawG_phase 285 raw history)
    (fun q off=>endRawG_eq 285 raw history q (fun h=>off (fold_earlierG q h)))
/-- the tick-300 input does not read the fold homes -/
theorem inputG (raw history:State) (z:SkywalkRails.State) (input:InputAt (285+15) z (endRaw 285 raw history)) :
    InputAt (285+15) z (endRawG 285 raw history) := by
  have far:∀q∈(W.compactSkywalkTickLayout base (285+15)).wires,OB5.sig (285+14) q∉foldSitesG:=by
    (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  exact match_input _ _ _ _ _ _ (fun q h=>endRawG_eq 285 raw history q (far q (List.mem_toFinset.mp h))) input
end ECDSAAdd.Entrant.StairPacket.WideReference

