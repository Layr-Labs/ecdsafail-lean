namespace ECDSAAdd.Entrant.StairPacket.LeaveTerminalBound
open SkywalkNat HighBankSum
/-- The stock stage at 315 is 198 wide: window 300's middle has at most 91 bits, so the 59 register words above it
    (live 91..149, physical 984..1042 after the relocation) contain zero. -/
theorem fit (x p : Nat) (xp:0<x) (pp:0<p) (odd:p%2=1) (bound:p<2^256)
    (small:x<p) (cop:x.Coprime p) :
    let z:=step^[300] (init x p)
    Leave300TrueMiddle.F z<2^91 := by
  have bounds:=iter_width p x 256 315 pp xp odd bound small cop (by decide)
  dsimp only at bounds
  change (step^[315] (init x p)).u<2^197 ∧ (step^[315] (init x p)).v<2^197 at bounds
  change total (step^[15] (step^[300] (init x p)))/2^107<2^91
  rw [←Function.iterate_add_apply]
  unfold total
  change ((step^[315] (init x p)).u+(step^[315] (init x p)).v)/2^107<2^91
  apply (Nat.div_lt_iff_lt_mul (by decide)).mpr
  omega
end ECDSAAdd.Entrant.StairPacket.LeaveTerminalBound

