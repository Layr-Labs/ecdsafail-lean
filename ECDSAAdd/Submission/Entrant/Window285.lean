  have geo : MoveChain.apart 1694 Partial.leave285Rows = true := by decide +kernel
  have nd : MoveChain.lone Partial.leave285Rows = true := by decide +kernel
  have still : Partial.leave285Rows.all (fun r => ((Partial.leave285.drop 318).take 2272).all (MoveChain.quiet 1694 r)) = true := by
    decide +kernel
