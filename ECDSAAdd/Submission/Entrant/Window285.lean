  refine ⟨all.1.trans ready.1,all.2.1,all.2.2.1.trans (true_records 114 z small odd G S),?_⟩
  intro n
  rw [all.2.2.2 n]
  have free:∀q∈Enter285.pending,q∉wires Partial.enter285Inv:=by decide +kernel
  apply unmask Partial.enter285 Partial.enter285Inv Enter285.pending Enter285.avoid_enter free
  exact return_packed Enter285.layout map285 _ _ inc285 (fun _=>rfl) rfl emitted285 emitted285Inv raw _ z G S small cut input _ _
