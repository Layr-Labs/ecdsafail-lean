theorem result (z:SkywalkNat.State) (sg:Bool) (s:ECDSAAdd.State) (m:List Bool)
    (small:min z.u z.v<2^114) (clean:∀q∈smallC,s.basis q=false) (cleared:regValue smallM s.basis=0)
    (input:let r:=step^[15] (reduced 114 15 z)
           let F:=step^[15] z
           let e:=(negative sg r.u).toNat
           s.basis 1556=decide (2^114≤r.u-e) ∧ (s.basis 1558).toNat=upperBorrow (2^114) r.u r.v e ∧
             regValue smallA s.basis=((F.u+F.v)/2^115)%2^10) :
    let F:=step^[15] z
    let e:=(negative sg F.u).toNat
    let out:=run restore m s
    out.phase=s.phase ∧ (∀q,q∉smallM → out.basis q=s.basis q) ∧
      regValue smallM out.basis=((F.u-e)/2^115)%2^10 := by
  have hardware:=restore_run s m clean cleared
  refine ⟨hardware.1,hardware.2.1,hardware.2.2.trans ?_⟩
  dsimp only at input ⊢
  have math:=LeaveRestoreTruth.restored 114 10 z small sg
  have sign:=(LeaveRestoreTruth.truth 114 z small sg).2.2.2
