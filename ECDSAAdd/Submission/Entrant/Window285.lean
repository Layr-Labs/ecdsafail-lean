namespace ECDSAAdd.Entrant.StairPacket.Leave285Posted
open Leave285Close Leave285Relocated LeaveSelector StairArchiveTrace
set_option maxRecDepth 50000
set_option maxHeartbeats 3000000

theorem result (s:State) (m:List Bool) (f u c:Bool) (w:Fin 16) (xs:List (Bool×Bool))
    (len:xs.length=15) (chainOK:f=true → chain u xs)
    (first:f=true → u=false → ∀i(h:i<xs.length),i≤w.val → xs[i].2=decide (i=w.val))
    (swaps:events.map (fun p=>s.basis p.1)=(xs.take 5).map Prod.snd)
    (far:s.basis 1691=f) (old:s.basis 1692=(f && u)) (suffix:s.basis 1695=nearby (ofFlags f u w))
    (cross:s.basis 1694=(f && c)) (cold:∀p∈events,s.basis p.2=false) :
    let out:=run afterLow m s
    out.phase=s.phase ∧ out.basis 1686=f ∧ out.basis 1687=(f && afterFlags u (xs.take 5)) ∧
      out.basis 1688=(f && c) ∧
      ∀q,out.basis q=writeBit s.basis 1692 false (LeaveRelocation.source moves q) := by
  have vp:=LeavePendingHistory.pending f u xs w len chainOK first
  have ev:events.all (fun p=> !s.basis p.1)= !(xs.take 5).any Prod.snd := by
    have mapped:events.any (fun p=>s.basis p.1)=(xs.take 5).any Prod.snd := by
      simpa only [List.any_map,Function.comp_def,id_eq] using congrArg (List.any · id) swaps
    rw [←mapped]
    simp only [List.all_eq_not_any_not,Bool.not_not]
  have cleared: (s.basis 1692 ^^ (s.basis 1695 && events.all (fun p=> !s.basis p.1)))=false := by
    rw [old,suffix,ev];exact vp.2
  rw [after _ _ cold]
  dsimp only
  rw [cleared]
  have geom:LeaveRelocation.source moves 1686=1691 ∧ LeaveRelocation.source moves 1687=1695 ∧ LeaveRelocation.source moves 1688=1694 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  rw [geom.1,geom.2.1,geom.2.2]
  exact ⟨rfl,far,suffix.trans vp.1,cross,fun _=>rfl⟩

