namespace ECDSAAdd.Entrant.StairPacket.Leave300Core
open Arithmetic Partial Leave300SignClose Leave300Selector LeaveSelector Leave300Barrel Leave300High Leave300Word Leave300Join
open HighBankBarrel Leave300RetireActual Leave300OutputPorts
set_option maxRecDepth 50000
set_option maxHeartbeats 5000000

def work:=((leave300.drop 334).take 2571)
theorem shape : work=extended++fullPostfix false := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
def watched := (List.range' 1559 39)++paritySites++[1686, 1683, 1684]++(List.range 15).map Leave300Hit.swaps

theorem untouched : ∀q∈watched,q≠1613 ∧ (∀i:Fin 150,q≠wire i.val) ∧
    ∀a∈columns,q≠a.shadow ∧ q≠a.tube := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

attribute [local irreducible] run

private theorem finish (z:SkywalkNat.State) (s a t:State)
    (fix:t=⟨a.phase,writeBit a.basis 1613 false⟩) (clean:s.basis 1613=false)
    (ar:a.phase=s.phase ∧ (∀i<150,a.basis (live i)=(Leave300TrueMiddle.F z).testBit i) ∧
      (∀i:Fin 18,a.basis (row i).free=false) ∧
      ∀q,q≠1613 → outside wire 150 q → (∀r∈columns,q≠r.shadow ∧ q≠r.tube) → a.basis q=s.basis q) :
    t.phase=s.phase ∧ (∀i<150,(cleared t.basis) (live i)=(Leave300TrueMiddle.F z).testBit i) ∧
      (∀j:Fin 18,(cleared t.basis) (row j).free=false) ∧ (∀j:Fin 39,(cleared t.basis) (1559+j.val)=false) ∧
      (∀q,outside wire 150 q → (∀a∈columns,q≠a.shadow ∧ q≠a.tube) → (cleared t.basis) q=cleared s.basis q) := by
  have base (q:Wire) (diff:q≠1613) : t.basis q=a.basis q := by rw [fix];simp [writeBit,diff]
  have pass (q:Nat) (diff:q≠1613 ∧ ¬(1559≤q ∧ q≤1597)) : cleared t.basis q=a.basis q := by
    rw [cleared,if_neg diff.2];exact base _ diff.1
  refine ⟨(congrArg State.phase fix).trans ar.1,?_,?_,?_,?_⟩
  · intro i h
    have geom : ∀j:Fin 150,live j≠1613 ∧ ¬(1559≤live j ∧ live j≤1597) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    exact (pass _ (geom ⟨i,h⟩)).trans (ar.2.1 i h)
  · intro j
    have geom : ∀j:Fin 18,(row j).free≠1613 ∧ ¬(1559≤(row j).free ∧ (row j).free≤1597) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    exact (pass _ (geom j)).trans (ar.2.2.1 j)
  · intro j;have h:=j.isLt
    change (if 1559≤1559+j.val ∧ 1559+j.val≤1597 then _ else _)=_
    rw [if_pos (by omega)]
  · intro q out cols
    by_cases eq:q=1613
    · subst q
      change t.basis 1613=s.basis 1613
      rw [fix,clean]
      simp [writeBit]
    · unfold cleared
      split
      · rfl
      · exact (base _ eq).trans (ar.2.2.2 _ eq out cols)


theorem result (z:SkywalkNat.State) (s:State) (tape:List Bool) (k:Mode) (ref:BasisState)
    (small:min z.u z.v<2^106) (odd:z.v%2=1) (room:Shadow.high 106 15 z+1<2^135)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,135 ≤ i → i<150 → s.basis (wire i)=false)
    (tag:∀q∈Leave300Join.tags,s.basis q=if Shadow.far 106 15 z then Leave300Word.hot (Leave300TrueMiddle.key z) q else false)
    (shadow:∀i<18,s.basis (438+i)=(Leave300TrueMiddle.X z).testBit i)
    (bank:regValue ys s.basis=if Shadow.far 106 15 z then Shadow.high 106 15 z else 0)
    (cin:s.basis 1686=if Shadow.far 106 15 z then HighBankSum.cross (Leave300TrueMiddle.d z) else false)
    (sign:Shadow.far 106 15 z → s.basis 1597=Leave300TrueMiddle.neg z)
    (bits:∀j:Fin 38,s.basis (1559+j.val)=(prior k (1559+j.val)).read ref)
    (parity:∀q∈paritySites,ref q=s.basis q)
    (product:s.basis 1597=(s.basis 1686 && (signExpr ports k).read ref))
    (leftFlag:left k=(s.basis 1683 && s.basis 1684)) (rightFlag:right k=(s.basis 1683 && !s.basis 1684))
    (events:right k=true → ∀i<15,i≤LeaveSelector.key k → s.basis (Leave300Hit.swaps i)=decide (i=LeaveSelector.key k)) :
    let out:=run work tape s
    out.phase=s.phase ∧ (∀i<150,out.basis (live i)=(Leave300TrueMiddle.F z).testBit i) ∧
      (∀j:Fin 18,out.basis (row j).free=false) ∧ (∀j:Fin 39,out.basis (1559+j.val)=false) ∧
      (∀q,outside wire 150 q → (∀a∈columns,q≠a.shadow ∧ q≠a.tube) → out.basis q=cleared s.basis q) := by
  let a:=run Leave300Middle.middle tape s
  let t:=run extended tape s
  have ar:=Leave300TrueMiddle.actual z s tape small odd room clean (clean _ (by decide)) padding tag shadow bank cin sign (clean _ (by decide))
  have fix:=closed z s tape clean padding tag
  change t=⟨a.phase,writeBit a.basis 1613 false⟩ at fix
  have saved (q:Wire) (mem:q∈watched) : t.basis q=s.basis q := by
    obtain ⟨diff,out,cols⟩:=untouched _ mem
    rw [fix];simp only [writeBit,Function.update_of_ne diff]
    exact ar.2.2.2 q diff (fun i hi=>out ⟨i,hi⟩) cols
  have ctl : ∀j:Fin 39,1559+j.val∈watched := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have pa : ∀q∈paritySites,q∈watched := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have sw : ∀i:Fin 15,Leave300Hit.swaps i∈watched := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have retire:=Leave300RetireActual.result k ref t (tape.drop (measurementCount extended))
    (fun j=>(saved _ (ctl ⟨j.val,by have h:=j.isLt;omega⟩)).trans (bits j))
    (fun q h=>(parity q h).trans (saved _ (pa q h)).symm)
    (by rw [saved 1597 (by decide),saved 1686 (by decide)];exact product)
    (by rw [saved 1683 (by decide),saved 1684 (by decide)];exact leftFlag)
    (by rw [saved 1683 (by decide),saved 1684 (by decide)];exact rightFlag)
    (fun on i hi h=>(saved _ (sw ⟨i,hi⟩)).trans (events on i hi h))
  dsimp only
  rw [shape,run_append,run_take,retire]
  exact finish z s a t fix (clean _ (by decide)) ar

end ECDSAAdd.Entrant.StairPacket.Leave300Core

