    (scratch:∀i:Fin 157,23≤ i.val → s.basis (rawPorts i)=false) :
    let t:=run (Partial.archiveLoad285I d) m s
    ∃row<63145, t.phase=s.phase ∧ Frame codePorts (code d) row t ∧
