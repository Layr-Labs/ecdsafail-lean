theorem avoid_enter : ∀q∈pending,q∉wires Partial.enter285 := by decide +kernel
theorem avoid_live : ∀q∈pending,q∉zeroSites idx := by decide +kernel

theorem ready_pending (raw pre:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^114)
    (cut:PackedCut lowerPairs upperPairs 300 1693 1691 1692 (PortalValues.negative S z.u)
      (decide (Shadow.far 114 15 z)) (decide (Shadow.far 114 15 z ∧ 2^114≤z.u))
      (pullState (OB5.sig 284) raw) (eraseSites pending pre))
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 285) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (hist:∀r:Fin 15,raw.basis (base (1028+285+r))=false) (endScratch:raw.basis 1784=false ∧ raw.basis 1783=false) :
    let t:=run Partial.enter285 m pre
    let T:=Shadow.reduced 114 15 z
    t.phase=pre.phase ∧ onRails idx 0 (SkywalkRails.encode G S T.u T.v) t.basis ∧
      ∀q∈pending,t.basis q=pre.basis q := by
  have eq:=erase_run pending Partial.enter285 avoid_enter m pre
  have real:=ready_from_cut raw (eraseSites pending pre) z G S m small cut input hist endScratch
  rw [eq] at real
