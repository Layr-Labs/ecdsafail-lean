    (temp:∀p∈longPairs,s.basis p.2=false)
    (odd:z.v%2=1) (room:Shadow.high 114 15 z+1<2^127)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,127 ≤ i → i<142 → s.basis (wire i)=false)
    (bank:regValue ys s.basis=if Shadow.far 114 15 z then Shadow.high 114 15 z else 0)
    (zero:∀q∈Leave285FrontReady.watched,s.basis q=false)
    (par:Leave285EntryAction.oddRead s.basis=oddBits (letters 15 (Shadow.reduced 114 15 z)))
    (mode:actualMode 114 z=farMode (s.basis 1691) (s.basis 1692) z.u)
    (events:right (actualMode 114 z)=true → ∀i<15,i≤key (actualMode 114 z) → s.basis (Leave285Hit.swaps i)=decide (i=key (actualMode 114 z)))
    (nextSmall:min (SkywalkNat.step^[15] z).u (SkywalkNat.step^[15] z).v<2^106)
    (bound:Leave285TrueMiddle.F z<2^142) :
    let a:=SkywalkNat.step^[15] z
    let mag:=a.u-(negative sg a.u).toNat
    let out:=run Leave285BeforeStore.program m s
    out.basis 1693=negative sg a.u ∧ (∀q∈history,out.basis q= !s.basis q) ∧
    (∀i:Fin 11,out.basis (430+i.val)=(a.u+a.v).testBit (114+i.val) ∧
        out.basis (900+i.val)=mag.testBit (114+i.val)) := by
  let a:=SkywalkNat.step^[15] z
  let h:=SkywalkNat.step^[15] (Shadow.reduced 114 15 z)
  let out:=run Leave285BeforeStore.program m s
  have src:=Leave285Front.result s m z G sg small ready fresh scratch temp
  have stored:=Leave285BeforeStore.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode events nextSmall bound
  have lowMag:=( Leave285MaskCut.result s m z G sg small ready fresh scratch temp).1
  have raw (q:Wire) (ok:q∉afterFront.map destination):out.basis q=(run entry m s).basis q := by
    change (run Leave285BeforeStore.program m s).basis q=_
    rw [shape,run_append,run_take];exact preserved _ _ _ _ ok
  have truth:=LeaveShadowRails.retainedLow 114 z small sg
  have hist (q:Wire) (hq:q∈history):out.basis q= !s.basis q := by
    let sc:=run Leave285InputScan.scanPart m s
    let tape:=m.drop (measurementCount Leave285InputScan.scanPart)
    let v:=run flipHistory tape sc
    have inv:v=⟨sc.phase,fun q=>if q∈history then !sc.basis q else sc.basis q⟩ := by
      change run flipHistory tape sc=_
      rw [Leave285EntryAction.flipped,notRegister_correct _ (by decide)]
    have bounds:∀q∈history,301≤q ∧ q≤315 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    have all : afterFlip.all (fun g=>decide (destination g<301 ∨ 315<destination g))=true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    have ok:∀q∈history,q∉afterFlip.map destination := by
      intro q member bad
      obtain ⟨g,hg,rfl⟩:=List.mem_map.mp bad
      have hit := of_decide_eq_true (List.all_eq_true.mp all g hg)
      obtain ⟨l,r⟩:=bounds _ member
      exact hit.elim (Nat.not_lt_of_ge l) (Nat.not_lt_of_ge r)
    change (run Leave285BeforeStore.program m s).basis q=_
    rw [flippedShape,run_append,run_take,run_append,run_take]
    change (run _ _ v).basis q=_
    rw [preserved _ _ _ _ (ok q hq),inv]
    change (if _ then !sc.basis q else sc.basis q)=_
    rw [if_pos hq,preserved _ _ _ _ ((Leave285EntryAction.historyGeom _ hq).1)]
  refine ⟨(raw 1693 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))).trans (src.2.2.1.trans truth.1.symm),hist,?_⟩
  intro i
  cases ix:i.val with
  | zero =>
    simp only [Nat.add_zero]
    have same:=congrArg (fun n:Nat=>n.testBit 114) truth.2.1
    simp only [Nat.testBit_mod_two_pow,show decide (114<115)=true from rfl,Bool.true_and] at same
    have a0:=src.2.2.2.2.2 0 (by decide)
    rw [Nat.testBit_div_two_pow] at a0
    have bit:=thresholdBit (a.u-(negative sg a.u).toNat) (2^114) (by decide)
    rw [Nat.testBit_div_two_pow] at bit
    exact ⟨(raw 430 (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))).trans (a0.trans same.symm), (stored.2.2.2.2.2.2 _ (by decide) (by decide) (by decide)).trans (lowMag.trans bit.symm)⟩
  | succ j =>
    have hj:j<10:=by have lim:=i.isLt;omega
    have mapA : ∀u:Fin 10,live u.val=430+(u.val+1) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    have mapM : ∀u:Fin 10,smallM.getD u.val 0=900+(u.val+1) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    have pos:=stored.2.2.2.2.2.1 j (by omega)
    have signedBit:=HighBankAdjust.bit_read smallM j out.basis (by exact hj)
    rw [mapM ⟨j,hj⟩,stored.2.2.2.2.1,Nat.testBit_mod_two_pow,decide_eq_true_eq.mpr hj,Bool.true_and,Nat.testBit_div_two_pow] at signedBit
    change out.basis (live j)=((a.u+a.v)/2^115).testBit j at pos
    rw [mapA ⟨j,hj⟩,Nat.testBit_div_two_pow] at pos
    simpa only [show j+115=114+(j+1) by omega] using And.intro pos signedBit
