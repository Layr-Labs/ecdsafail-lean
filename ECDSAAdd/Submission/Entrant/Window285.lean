abbrev throughRestore := ((leave285.drop 2698).take 133)

theorem retained (s : State) (m : List Bool) (i : Fin 142) :
    (run throughRestore m s).basis (live i)=s.basis (live i) := by
  have layout : ∀j:Fin 142,live j∉throughRestore.map destination := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  exact preserved _ _ _ _ (layout i)

theorem nextFlag (s : State) (m m' : List Bool) (Z : Nat) (bound : Z<2^142)
    (bits : ∀i<142,s.basis (live i)=Z.testBit i)
    (fresh : (run throughRestore m s).basis 1558=false)
    (clean : ∀p∈pendingPairs,(run throughRestore m s).basis p.2=false) :
    let v:=run throughRestore m s
    run pending m' v=⟨v.phase,writeBit v.basis 1557 (v.basis 1557 ^^ decide (3 ≤ Z/2^7))⟩ := by
  let v:=run throughRestore m s
  have valid (i : Nat) (h : i<142) : v.basis (live i)=Z.testBit i :=
    (retained s m ⟨i,h⟩).trans (bits i h)
  have read := (outputRegisters v Z valid).2
  have fits : Z/2^7<2^135 := (Nat.div_lt_iff_lt_mul (by decide)).mpr bound
  rw [Nat.mod_eq_of_lt fits] at read
  dsimp only
  rw [←read]
  exact pending_three v m' fresh clean

end ECDSAAdd.Entrant.StairPacket.Leave285Readout

