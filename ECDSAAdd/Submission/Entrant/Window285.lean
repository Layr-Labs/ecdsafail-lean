namespace ECDSAAdd.Entrant.StairPacket.Leave300InputScan
open Partial Arithmetic RailPair PortalValues LeaveReadoutFrame
set_option maxRecDepth 50000
set_option maxHeartbeats 5000000
def pairs : List (Wire×Wire) := [(437, 892), (438, 893), (439, 894), (440, 895), (441, 896), (442, 897), (443, 898), (444, 899), (445, 900), (446, 901), (447, 902), (448, 903), (449, 904), (450, 905), (451, 906), (452, 907), (453, 908), (454, 909), (455, 910)]
def scanPart := (leave300.take 78)
abbrev L := IntegerPacket.ports (shape 15) 15
theorem emitted : scanPart=scan 455 910 330 1685 pairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem layout : ScanGeometry 455 910 330 1685 pairs := ⟨by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel),by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)⟩

theorem result (s : State) (tape : List Bool) (u v : Nat) (G sg : Bool)
    (ready : onRails 15 15 (SkywalkRails.encode G sg u v) s.basis) (fresh:s.basis 1685=false) :
    let t:=run scanPart tape s
    let e:=negative sg u
    t.phase=s.phase ∧ t.basis 1685=e ∧
      (∀i<19,t.basis (437+i)=((u+v)/2^106).testBit i ∧ t.basis (892+i)=((u-e.toNat)/2^106).testBit i) ∧
      ∀q,q≠1685 → q∉sites pairs → t.basis q=s.basis q := by
  rw [emitted]
  have out:=scanRouted 15 106 455 910 330 1685 pairs layout (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) s tape u v G sg ready fresh (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  have frame:=scan_run _ _ _ _ _ layout s tape fresh
  refine ⟨frame.1,out.1,?_,frame.2.2.1⟩
  intro i hi
  have geom : ∀j:Fin 19,(pairs.map Prod.fst).getD j 0=437+j.val ∧ (pairs.map Prod.snd).getD j 0=892+j.val := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  let ix:Fin 19:=⟨i,hi⟩
  rw [←(geom ix).1,←(geom ix).2,HighBankAdjust.bit_read (pairs.map Prod.fst) ix (run (scan 455 910 330 1685 pairs) tape s).basis hi,HighBankAdjust.bit_read (pairs.map Prod.snd) ix (run (scan 455 910 330 1685 pairs) tape s).basis hi,out.2.1,out.2.2]
  exact ⟨rfl,rfl⟩

end ECDSAAdd.Entrant.StairPacket.Leave300InputScan

