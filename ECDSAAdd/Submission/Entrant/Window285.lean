  let o:=run Leave285StoreMapped.program m s
  have selRaw (q:Wire) (ok:q∉entry.map destination):a.basis q=s.basis q := preserved entry s m q ok
  have sw:∀i:Fin 15,Leave285Hit.swaps i∉entry.map destination:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have prepared:=Leave285FrontPrepare.prepare s m z G sg small ready fresh scratch temp zero k z.u
    (by change k=farMode (a.basis _) (a.basis _) z.u;rw [selRaw _ (by decide),selRaw _ (by decide)];exact mode)
