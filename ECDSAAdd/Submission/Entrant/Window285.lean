open Arithmetic MappedCompressed Secp256k1
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
def L:=W.compactSkywalkTickLayout base 315
def P:=TickRanges.tick base 315
def Q:=W.ReverseCarry.compactReceiverTick base 315
def physP:=renameProgram (OB5.sig 315) P
def physQ:=renameProgram (OB5.sig 315) Q
theorem supports : wires P⊆L.wires.toFinset ∧ wires Q⊆L.wires.toFinset :=
  ⟨(TickRanges.tick_support base 315 (by decide) base_pool_nodup).trans
    (W.repairedTick_support base 315 (by decide) base_pool_nodup),
    W.ReverseCarry.compactReceiverTick_support base 315 (by decide) base_pool_nodup⟩
theorem physical_free (R:Program) (sub:wires R⊆L.wires.toFinset) (q:Wire)
    (off:OB5.sig 315 q∉L.wires) : q∉wires (renameProgram (OB5.sig 315) R) := by
  rw [JointForward1588.wires_rename_image]
  intro h
  obtain ⟨w,mem,rfl⟩:=Finset.mem_image.mp h
  rw [OB5.sig_invol 315 (by decide)] at off
  exact off (List.mem_toFinset.mp (sub mem))
theorem spared : ∀q∈ParkEndpoint.dst,OB5.sig 315 q∉L.wires := by decide +kernel
theorem stashP : ∀q∈ParkEndpoint.dst,q∉wires physP := fun q hit=>physical_free P supports.1 q (spared q hit)
theorem stashQ : ∀q∈ParkEndpoint.dst,q∉wires physQ := fun q hit=>physical_free Q supports.2 q (spared q hit)
end ECDSAAdd.Entrant.StairPacket.EndTick

end

