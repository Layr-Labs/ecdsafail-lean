  change StairArchiveRaw.legal (physicalCells sourceIdx before)
  rw [prior.records]
  exact legal_signed 15 past g sign (by omega) odd

theorem admits (d:Bool) (before:State) (et first pack:List Bool)
    (nowZ:SkywalkRails.State) (parity:(nowZ.a+nowZ.b)%2=1)
    (ready:onRails idx 0 nowZ (run Partial.enter285 et before).basis)
    (past:SkywalkNat.State) (g sign cross:Bool) (odd:past.v%2=1) (small:min past.u past.v<2^121)
    (prior:PastFacts sourceIdx rawPorts 121 past g sign cross before) :
