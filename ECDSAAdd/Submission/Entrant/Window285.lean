namespace ECDSAAdd.Entrant.StairPacket.Leave300MaskThrough
open Arithmetic Partial LeaveCompanion LeaveCompanion300 LeaveReadoutFrame
set_option maxRecDepth 50000
set_option maxHeartbeats 1000000

def openPart:Program := (leave300.drop 169).take 3
def interior:Program := (leave300.drop 172).take 2797
def closePart:Program := (leave300.drop 2969).take 3
theorem openShape : openPart=[.X 1557,.CX 437 1557,.CCX 892 1557 1558] := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem closeShape : closePart=[.measureX 1558 [] [.CZ 892 1557],.CX 437 1557,.X 1557] := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem layout : ∀q∈[437, 892, 1557, 1558],q∉interior.map destination := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem released (s:State) (m₀ m₁ m₂:List Bool) (x:s.basis 1557=false) (y:s.basis 1558=false) :
    let u:=run openPart m₀ s
    let v:=run interior m₁ u
    run closePart m₂ v=⟨v.phase,writeBit (writeBit v.basis 1557 false) 1558 false⟩ := by
  let u:=run openPart m₀ s
  let v:=run interior m₁ u
  have fresh:u=⟨s.phase,writeBit (writeBit s.basis 1557 (!s.basis 437)) 1558 (s.basis 892 && !s.basis 437)⟩ := by
    change run openPart m₀ s=_
    rw [openShape]
    exact mask_open 437 892 1557 1558 s m₀ (by decide) x y
  have kept (q:Wire) (h:q∈[437, 892, 1557, 1558]) : v.basis q=u.basis q :=
    preserved interior u m₁ q (layout q h)
  dsimp only
  rw [closeShape]
  apply mask_close _ _ _ _ _ _ (by decide)
  · change v.basis 1557= !v.basis 437
    rw [kept _ (by decide),kept _ (by decide),fresh]
    simp [writeBit]
  · change v.basis 1558=(v.basis 892 && v.basis 1557)
    rw [kept _ (by decide),kept _ (by decide),kept _ (by decide),fresh]
    simp [writeBit]
end ECDSAAdd.Entrant.StairPacket.Leave300MaskThrough

