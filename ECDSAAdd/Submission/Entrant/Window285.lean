def idx : Fin 23 := ⟨14,by decide⟩
def program (d:Bool) := renameProgram (OB5.sig 285) (Rolling1588.packAtTick d 275)
def reverse (d:Bool) := renameProgram (OB5.sig 285) (Rolling1588.unpackAtTick d 275)
def support := ((List.range' 270 5).flatMap fun v=>[OB5.sig 285 (base v),OB5.sig 285 (base (1028+v))])
theorem packs (d:Bool) : wires (program d)⊆support.toFinset := by
  cases d <;> exact ECDSAAdd.Entrant.WSlimMain.wires_subset_of_all (by decide +kernel)
theorem unpacks (d:Bool) : wires (reverse d)⊆support.toFinset := by
  cases d <;> exact ECDSAAdd.Entrant.WSlimMain.wires_subset_of_all (by decide +kernel)
