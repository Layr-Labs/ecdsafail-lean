  have mem:q∈List.range' 1301 13:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈List.range' 1301 13,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=3113-q ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧
      q∉RailPair.sites Enter285.upperPairs ∧ q∉sites 285 ∧ OB5.sig (285+14) q=3113-q := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no,noSite,folded⟩:=marks q mem
  have normal:=ext_head Partial.enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s m t q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  have original:raw.basis (3113-q)=false:=by
    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 _ (outside_above (by change 1044+285≤3113-q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 285 (by decide) base_pool_nodup _).mp stage
    apply (regValue_zero _ _).mp fields.2.2.2.2.2.1
    exact List.mem_map.mpr ⟨(3113-q)-16,List.mem_range'_1.mpr (by simp only [Wire] at *;omega),by change ((3113-q)-16)+16=3113-q;simp only [Wire] at *;omega⟩
  have cleared:((eraseSites Enter285.pending s)).basis q=false:=
