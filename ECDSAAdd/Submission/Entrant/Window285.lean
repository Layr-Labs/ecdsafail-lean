namespace ECDSAAdd.Entrant.StairPacket.Leave300Close
open Arithmetic Partial RailPair Leave300Relocated
set_option maxRecDepth 50000
set_option maxHeartbeats 5000000

def history : List Wire := [316, 317, 318, 319, 320, 321, 322, 323, 324, 325, 326, 327, 328, 329, 330]
def low : List (Wire×Wire) := [(437, 892), (438, 893), (439, 894), (440, 895), (441, 896), (442, 897), (443, 898), (444, 899), (445, 900), (446, 901), (447, 902), (448, 903)]
def events : List (Wire×Wire) := [(1769, 1556), (1768, 1559), (1767, 1560), (1766, 1561), (1765, 1562)]
def beforeTags := (leave300.drop 3591).take 63
def afterLow := leave300.drop 3654
def ending := leave300.drop 3591

theorem lowShape : beforeTags=notRegister history++store 330 1685 low [] := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem tailShape : afterLow=LeaveNoSwap.block 1687 1684 events++lastPart := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
theorem split : ending=beforeTags++afterLow := by simp only [ECDSAAdd.Entrant.WSlimV3.seg_drop, eq_self, ending, beforeTags, afterLow]

theorem lowResult (s:State) (m:List Bool) :
    let h:=fun q=>if q∈history then !s.basis q else s.basis q
    let t:=run beforeTags m s
    t.phase=s.phase ∧ (∀q,q∉sites low → t.basis q=h q) ∧
      ∀p∈low,t.basis p.1=(if h 330 then h p.2 ^^ h 1685 else h p.1) ∧
        t.basis p.2=(if h 330 then h p.1 else h p.2 ^^ h 1685) := by
  dsimp only
  rw [lowShape,run_append,run_take,notRegister_correct _ (by decide)]
  let h:State:=⟨s.phase,fun q=>if q∈history then !s.basis q else s.basis q⟩
  have geom : StoreGeometry 330 1685 low [] := by constructor <;> (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have act:=store_run 330 1685 low [] geom h (m.drop (measurementCount (notRegister history))) (by simp)
  exact ⟨act.1,fun q no=>act.2.1 q no (by simp [sites]),act.2.2.2⟩

theorem after (s:State) (m:List Bool) (cold:∀p∈events,s.basis p.2=false) :
    let toggled:=s.basis 1684 ^^ (s.basis 1687 && events.all (fun p=> !s.basis p.1))
    run afterLow m s=⟨s.phase,fun q=>(writeBit s.basis 1684 toggled) (LeaveRelocation.source moves q)⟩ := by
  rw [tailShape,run_append,run_take,LeaveNoSwap.action _ _ _ _ _ (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) cold,Leave300Relocated.forward]

end ECDSAAdd.Entrant.StairPacket.Leave300Close

