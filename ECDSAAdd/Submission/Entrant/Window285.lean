/-- R1: the gate list of the physical leave300Move, spliced from the reference list. -/
private def moveKept : List Gate := Partial.leave300Kept.map GateMirror.gateOf
private def opsMove : List Gate :=
  ops.take 302 ++ (GateMirror.rowGates 1686 Partial.leave300Rows ++ ((ops.drop 318).take 2408 ++ (moveKept ++ ops.drop 2758)))
private theorem opsShape : ops = ops.take 302 ++ ((ops.drop 302).take 16 ++ ((ops.drop 318).take 2408 ++
    ((ops.drop 2726).take 32 ++ ops.drop 2758))) := GateMirror.sameList_sound _ _ (by decide +kernel)
private theorem fMove : GateMirror.forward opsMove = Partial.leave300Move := GateMirror.sameList_sound _ _ (by decide +kernel)
private theorem bMove : GateMirror.inverse opsMove = Partial.leave300MoveInv := GateMirror.sameList_sound _ _ (by decide +kernel)
private theorem prefixEq : GateMirror.forward (ops.take 302) = Partial.leave300.take 302 := by decide +kernel
private theorem refShape : Partial.leave300 = Partial.leave300.take 302 ++ (MoveChain.mux 1686 Partial.leave300Rows ++
    ((Partial.leave300.drop 318).take 2408 ++ (MoveChain.weave 1686 Partial.leave300Rows Partial.leave300Kept ++
      Partial.leave300.drop 2758))) := GateMirror.sameList_sound _ _ (by decide +kernel)

/-- R1 bridge: the physical leave300Move runs exactly like the reference leave300 whenever, in front of the mux,
the crossing wire is clean and the hot tags select one cell. -/
theorem sameRun (s : State) (m : List Bool) (a0 : Wire)
    (clean : (run (Partial.leave300.take 302) m s).basis 1686 = false)
    (sel : ∀ r ∈ Partial.leave300Rows, (run (Partial.leave300.take 302) m s).basis r.1 = true → r.2 = a0) :
    run Partial.leave300Move m s = run Partial.leave300 m s := by
  have geo : MoveChain.apart 1686 Partial.leave300Rows = true := by decide +kernel
  have nd : MoveChain.lone Partial.leave300Rows = true := by decide +kernel
  have still : Partial.leave300Rows.all (fun r => ((Partial.leave300.drop 318).take 2408).all (MoveChain.quiet 1686 r)) = true := by
    decide +kernel
  have wv : MoveChain.woven 1686 Partial.leave300Rows Partial.leave300Kept = true := by decide +kernel
  have e := MoveChain.splice 1686 Partial.leave300Rows (Partial.leave300.take 302) ((Partial.leave300.drop 318).take 2408)
    (Partial.leave300.drop 2758) Partial.leave300Kept s m a0 geo nd still wv clean sel
  exact e.trans (congrArg (fun P => run P m s) refShape.symm)

/-- R1: the facts `inverts` derives about the reference gate list, exported. -/
theorem grounded (s:State)
    (initial:∀q, 1556≤q → q≤1679 → s.basis q=false)
    (extra:∀q, 1690≤q → q≤1741 → s.basis q=false)
    (core:zeros (run (Partial.leave300.take 2905) [] s) [1560,1576,1596,1613,1614])
    (post:(run (Partial.leave300.take 3654) [] s).basis 1556=false) :
    (∀g∈ops,proper g=true) ∧ Ready s ops:=by
  let s1:=run (GateMirror.forward group0) [] s
  let s2:=run (GateMirror.forward group1) [] s1
  have s2e:s2=run (GateMirror.forward (group0++group1)) [] s:=by
    simp [s2,s1,GateMirror.forward,List.map_append,run_append]
  have i0:Masked s (0x3ffffffffffffc00ffffffffffffffffffffeffffeffffe <<< 1556):=subMask (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (bothMasks (fromRange (lo:=1556) (width:=124) (fun q h1 h2=>initial q h1 (Nat.le_of_lt_succ h2))) (fromRange (lo:=1690) (width:=52) (fun q h1 h2=>extra q h1 (Nat.le_of_lt_succ h2))))
  obtain ⟨h0,r0,z0⟩:=bit_sound group0 s _ _ cert0 i0
  have kc:zeros s1 [1560,1576,1596,1613,1614]:=by simpa only [s1,pEq] using core
  have i1:Masked s1 (0xffffffffc00ffffffffffffffffe0003fffffffff8 <<< 1556):=subMask (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (bothMasks z0 (fromList kc))
  obtain ⟨h1,r1,z1⟩:=bit_sound group1 s1 _ _ cert1 i1
  have kp:zeros s2 [1556]:=by
    intro q hq
    obtain rfl: q=1556:=by simpa using hq
    rw [s2e,qEq];exact post
  have i2:Masked s2 (0x79 <<< 1556):=subMask (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (bothMasks z1 (fromList kp))
  obtain ⟨h2,r2,z2⟩:=bit_sound group2 s2 _ _ cert2 i2
  have phys:∀g∈ops,proper g=true:=by
    intro g hg
    rcases List.mem_append.mp hg with h|h
    · exact h0 g h
    · rcases List.mem_append.mp h with h|h
      · exact h1 g h
      · exact h2 g h
  have ready:Ready s ops:=ready_append _ _ _ r0 (ready_append _ _ _ r1 r2)
  exact ⟨phys,ready⟩
/-- R1: the physical inverse undoes the physical forward program (it is the mirror of the same gate list). -/
theorem invertsMove (s:State) (phase:∀m,(run Partial.leave300 m s).phase=s.phase)
    (initial:∀q, 1556≤q → q≤1679 → s.basis q=false)
    (extra:∀q, 1690≤q → q≤1741 → s.basis q=false)
    (core:zeros (run (Partial.leave300.take 2905) [] s) [1560,1576,1596,1613,1614])
    (post:(run (Partial.leave300.take 3654) [] s).basis 1556=false) (a0:Wire)
    (hot:∀o,(run (Partial.leave300.take 302) o s).basis 1686=false ∧
      ∀r∈Partial.leave300Rows,(run (Partial.leave300.take 302) o s).basis r.1=true → r.2=a0) (m n:List Bool):
    run Partial.leave300MoveInv n (run Partial.leave300Move m s)=s:=by
  obtain ⟨phys,ready⟩ := grounded s initial extra core post
  have same (o : List Bool) : run Partial.leave300Move o s = run Partial.leave300 o s := sameRun s o a0 (hot o).1 (hot o).2
  have physAll : opsMove.all proper = true := by decide +kernel
  have physM : ∀ g ∈ opsMove, proper g = true := List.all_eq_true.mp physAll
  have rd : Ready s (ops.take 302 ++ ((ops.drop 302).take 16 ++ ((ops.drop 318).take 2408 ++
      ((ops.drop 2726).take 32 ++ ops.drop 2758)))) := by
    rw [← opsShape]
    exact ready
  have readyM : Ready s opsMove :=
    GateMirror.ready_move 1686 Partial.leave300Rows (ops.take 302) ((ops.drop 318).take 2408) (ops.drop 2758)
      ((ops.drop 302).take 16) ((ops.drop 2726).take 32) moveKept s a0
      (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
      (by decide +kernel) (by decide +kernel) (by decide +kernel)
      (by rw [prefixEq]; exact (hot []).1) (by rw [prefixEq]; exact (hot []).2) rd
  rw [← bMove, ← fMove]
  exact invert opsMove s physM (all_prepared opsMove s physM (by intro o; rw [fMove, same o]; exact phase o)) readyM m n
end ECDSAAdd.Entrant.StairPacket.Leave300Mirror

