namespace ECDSAAdd.Entrant.StairPacket.Leave285ReleasedActual
open Arithmetic MappedCompressed IntegerPacket WideReference EnterProof NativePack285 Partial LeaveReadoutFrame
set_option maxRecDepth 32000
set_option maxHeartbeats 2700000

def mirrorSites:=List.range' 1314 15
def untouched:=529::(List.range' 1329 15)

/-- Window 285 leaves the placed homes 1314..1328 of the dead carries 1785..1799 clean (the history fold of
`WideReference.advance285`).  The entry state reads them through `OB5.sig 284`, which already folds all fifteen. -/
theorem mirror (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 285 x p raw) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (q:Wire) (lo:1314≤q) (hi:q≤1328) : (run (body idx (withArchive d)) b (run enter285 a s)).basis q=false := by
  have mem:q∈mirrorSites:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈mirrorSites,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=3113-q ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧
      q∉RailPair.sites Enter285.upperPairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no⟩:=marks q mem
  have normal:=ext_head enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  apply normal.trans
  have original:raw.basis (3113-q)=false:=by
    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 _ (outside_above (by change 1044+285≤3113-q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 285 (by decide) base_pool_nodup _).mp stage
    apply (regValue_zero _ _).mp fields.2.2.2.2.2.1
    exact List.mem_map.mpr ⟨(3113-q)-16,List.mem_range'_1.mpr (by simp only [Wire] at *;omega),by change ((3113-q)-16)+16=3113-q;simp only [Wire] at *;omega⟩
  have cleared:((eraseSites Enter285.pending s)).basis q=false:=
    (cut.unchanged q hn hf hu no).trans (by simpa only [pullState,source] using original)
  simpa [eraseSites,mask] using cleared

/-- `clean` for `WideReference.advance285`, on the window state after `NativePack285.nextWindow`. -/
theorem clean (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 285 x p raw) (m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s)) :
    ∀q:Wire,1314≤q → q≤1328 → (run (NativePack285.nextWindow d) m s).basis q=false := by
  intro q lo hi
  simp only [NativePack285.nextWindow,NativePack285.window,run_append,run_take]
  exact mirror d raw s x p dom _ _ neg far long cut q lo hi

/-- Window 285 never writes the homes 1329..1343 of the future history of ticks 285..299 (unfolded at tick 285). -/
theorem future (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 285 x p raw) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (q:Wire) (lo:1329≤q) (hi:q≤1343) : (run (body idx (withArchive d)) b (run enter285 a s)).basis q=false := by
  have mem:q∈List.range' 1329 15:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈List.range' 1329 15,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=q ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧
      q∉RailPair.sites Enter285.upperPairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no⟩:=marks q mem
  have normal:=ext_head enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  apply normal.trans
  have original:raw.basis q=false:=by
    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 q (outside_above (by change 1044+285≤q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 285 (by decide) base_pool_nodup _).mp stage
    have qid:q=base (1028+(q-1044)):=by change q=1028+(q-1044)+16;simp only [Wire] at *;omega
    have jlo:285≤q-1044:=by simp only [Wire] at *;omega
    have jhi:q-1044<512:=by simp only [Wire] at *;omega
    exact qid ▸ (fields.2.2.2.2.1 _ jlo jhi).2
  have cleared:((eraseSites Enter285.pending s)).basis q=false:=
    (cut.unchanged q hn hf hu no).trans (by simpa only [pullState,source] using original)
  simpa [eraseSites,mask] using cleared

/-- The folded homes 1800..1812 of ticks 257..269 hold what window 270 wrote. Window 285 and
`leave285` do not touch them; the cut reads them from `raw` at 3113-q (`OB5.sig 284`), and so does the reference
(`OB5.sig 299`, outside `sites 285`), because the stock span leaves an earlier history home alone. -/
theorem older (d:Bool) (raw s:State) (a b m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (q:Wire) (lo:1800≤q) (hi:q≤1812) :
    (run leave285 m (run (body idx (withArchive d)) b (run enter285 a s))).basis q=
      (origin 285 raw (run (body idx (withArchive d)) b (run enter285 a s))).basis q := by
  have mem:q∈List.range' 1800 13:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈List.range' 1800 13,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=3113-q ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧
      q∉RailPair.sites Enter285.upperPairs ∧ q∉leave285.map LeaveReadoutFrame.destination ∧ q∉sites 285 ∧
      OB5.sig (285+14) q=3113-q := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no,stable,noSite,folded⟩:=marks q mem
  have normal:=ext_head enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  have entry:((eraseSites Enter285.pending s)).basis q=raw.basis (3113-q):=
    (cut.unchanged q hn hf hu no).trans (by simp only [pullState,source])
  have window:(run (body idx (withArchive d)) b (run enter285 a s)).basis q=raw.basis (3113-q):=
    normal.trans (by simpa [eraseSites,mask] using entry)
  rw [preserved _ _ _ _ stable,window,WideReference.outside 285 raw _ q noSite,folded]
  exact (run_preserves_outside _ [] raw (3113-q) (span_off 285 15 (3113-q) (by decide) (older_earlier q lo hi))).symm

theorem agree (d:Bool) (raw s:State) (x p:Nat) (good:Bounds x p) (dom:Domain 285 x p raw)
    (a b m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (band:∀q:Wire,999≤q → q≤1042 → (run leave285 m (run (body idx (withArchive d)) b (run enter285 a s))).basis q=false) :
    let v:=run (body idx (withArchive d)) b (run enter285 a s)
    ∀q:Wire, Leave285ReleasedOrigin.agreeSite q → (run leave285 m v).basis q=(origin 285 raw v).basis q := by
  have stable : ∀q∈untouched,q∉leave285.map LeaveReadoutFrame.destination := by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave285ReleasedActual.untouched); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  dsimp only
  intro q site
  rcases site with site|⟨lo,hi⟩
  · rw [Leave285ReleasedOrigin.released _ _ good _ _ dom _ site]
    rcases site with rfl|⟨lo,hi⟩|⟨lo,hi⟩
    · rw [preserved _ _ _ _ (stable 529 (by decide))]
      exact upper_clear _ _ _ _ _ dom _ _ _ _ _ cut 529 (by decide) (by decide)
    · exact band q lo hi
    · have mem:q∈untouched:=List.mem_cons_of_mem _ (List.mem_range'_1.mpr ⟨lo,by omega⟩)
      rw [preserved _ _ _ _ (stable q mem)]
      exact future d raw s x p dom a b neg far long cut q lo hi
  · exact older d raw s a b m neg far long cut q lo hi

/-- leave285 never writes the physical fold homes 1785..1799. -/
theorem foldKept (s:State) (m:List Bool) (q:Wire) (h:q∈WideReference.foldSites285) : (run leave285 m s).basis q=s.basis q := by
  have stable : ∀q∈WideReference.foldSites285,q∉leave285.map LeaveReadoutFrame.destination := by
    ((try unfold WideReference.foldSites285); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  exact preserved _ _ _ _ (stable q h)
end ECDSAAdd.Entrant.StairPacket.Leave285ReleasedActual

