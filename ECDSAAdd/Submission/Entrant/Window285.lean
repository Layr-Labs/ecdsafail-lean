theorem lowFrame (i:Fin 114) (s:State) (m:List Bool) :
    let v:=run leave285 m s
    v.basis (316+i.val)=s.basis (316+i.val) ∧ v.basis (786+i.val)=s.basis (786+i.val) := by
  have cover:leave285.all (fun g=>decide ((destination g<316 ∨ 430≤destination g) ∧ (destination g<786 ∨ 900≤destination g)))=true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have safe (q:Nat) (inside:(316≤q ∧ q<430) ∨ (786≤q ∧ q<900)):q∉leave285.map destination := by
    intro h;obtain ⟨g,hg,rfl⟩:=List.mem_map.mp h
    obtain ⟨a,d⟩:=of_decide_eq_true (List.all_eq_true.mp cover g hg)
