namespace ECDSAAdd.Entrant.StairPacket.Leave300Selector
open Arithmetic RecordedQuantum HighBankFirstHit LeaveSelector Leave300Hit
set_option maxRecDepth 50000
set_option maxHeartbeats 8000000

theorem preparedState (inv : Bool) (s : State) (m : List Bool) (v : BasisState) (small : Nat)
    (k : Mode) (mode : k=farMode (s.basis 1683) (s.basis 1684) small)
    (a:s.basis 1559=false) (b:s.basis 1560=false)
    (input : ∀q,q≠1559 → q≠1560 → s.basis q=(before ports inv k q).read v)
    (exchange : right k=true → ∀i<15,i≤key k → s.basis (swaps i)=decide (i=key k)) :
    run (fullPrefix inv) m s = ⟨s.phase,fun q=>(sim (if inv then prepareInv else prepare) (LeaveSelector.start ports inv k) q).read v⟩ := by
  rw [fullShape]
  have sep : ∀i : Fin 15, swaps i≠1559 ∧ swaps i≠1560 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  exact allSites ports 1683 1684 inv _ swaps sites (fun i hi=>sep ⟨i,hi⟩) s m v small
    (by decide) (by decide) a b k mode input exchange

theorem tagCertificate : ∀k:Mode, ∀i:Fin 16,
    sim prepare (LeaveSelector.start ports false k) (Leave300Join.tags.getD i 0) = .bit (enabled k && decide (i.val=key k)) := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem selected (s : State) (m : List Bool) (v : BasisState) (small : Nat)
    (k : Mode) (mode : k=farMode (s.basis 1683) (s.basis 1684) small)
    (a:s.basis 1559=false) (b:s.basis 1560=false)
    (input : ∀q,q≠1559 → q≠1560 → s.basis q=(before ports false k q).read v)
    (exchange : right k=true → ∀i<15,i≤key k → s.basis (swaps i)=decide (i=key k)) (i:Fin 16) :
    (run (fullPrefix false) m s).basis (Leave300Join.tags.getD i 0)=
      (enabled k && decide (i.val=key k)) := by
  rw [preparedState false s m v small k mode a b input exchange]
  exact congrArg (Expr.read v) (tagCertificate k i)


/-- R1: the selector ops in front of the cross mux, and the program prefix that runs them. -/
def crossAt : List Op := far ++ zero ++ suffix ++ select
def crossPrefix := ((program false).drop (initPC false)).take 60
theorem crossShape : crossPrefix = withHits 1683 1684 false swaps (crossAt.map Op.enter) := by rfl
theorem crossCertificate : ∀k:Mode,
    sim crossAt (LeaveSelector.start ports false k) 1686 = .bit false ∧
    Partial.leave300Rows.all (fun r => decide (sim crossAt (LeaveSelector.start ports false k) r.1 =
      .bit (enabled k && decide (r.2 = 438 + key k)))) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
/-- R1 precondition: in front of the mux the crossing wire is clean and every hot tag selects the same cell. -/
theorem crossReady (s : State) (m : List Bool) (v : BasisState) (small : Nat)
    (k : Mode) (mode : k=farMode (s.basis 1683) (s.basis 1684) small)
    (a:s.basis 1559=false) (b:s.basis 1560=false)
    (input : ∀q,q≠1559 → q≠1560 → s.basis q=(before ports false k q).read v)
    (exchange : right k=true → ∀i<15,i≤key k → s.basis (swaps i)=decide (i=key k)) :
    (run crossPrefix m s).basis 1686=false ∧
      ∀r∈Partial.leave300Rows,(run crossPrefix m s).basis r.1=true → r.2=438+key k := by
  have sep : ∀i : Fin 15, swaps i≠1559 ∧ swaps i≠1560 := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have state : run crossPrefix m s = ⟨s.phase,fun q=>(sim crossAt (LeaveSelector.start ports false k) q).read v⟩ := by
    rw [crossShape]
    exact allSites ports 1683 1684 false _ swaps sites (fun i hi=>sep ⟨i,hi⟩) s m v small
      (by decide) (by decide) a b k mode input exchange
  obtain ⟨c0,tg⟩ := crossCertificate k
  rw [state]
  refine ⟨congrArg (Expr.read v) c0,?_⟩
  intro r hr on
  have e : sim crossAt (LeaveSelector.start ports false k) r.1 = .bit (enabled k && decide (r.2 = 438 + key k)) :=
    of_decide_eq_true (List.all_eq_true.mp tg r hr)
  have on' : (sim crossAt (LeaveSelector.start ports false k) r.1).read v = true := on
  rw [e] at on'
  have on'' : (enabled k && decide (r.2 = 438 + key k)) = true := on'
  exact of_decide_eq_true (Bool.and_eq_true_iff.mp on'').2
end ECDSAAdd.Entrant.StairPacket.Leave300Selector

