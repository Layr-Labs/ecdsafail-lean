  have off:¬Earlier 300 q:=by
    rintro ⟨t,ht,e|e⟩
    · change q=t+16 at e;omega
    · change q=1028+t+16 at e;omega
  exact (same.2 q off).trans (fields.2.2.2.2.2.2.2.2 q (inB q h))
