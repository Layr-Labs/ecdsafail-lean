  have window:(run (body idx (withArchive d)) t (run Partial.enter285 m s)).basis q=false:=
    normal.trans (by simpa [eraseSites,mask] using cleared)
  rw [window,WideReference.outside 285 raw _ q noSite,folded]
  exact (WideReference.full_carry 285 15 x p (by decide) good raw dom [] (3113-q) (by simp only [Wire] at *;omega)
    (by simp only [Wire] at *;omega)).symm
theorem agree_origin (d:Bool) (x p:Nat) (good:Bounds x p) (raw s:State) (dom:Domain 285 x p raw) (m t:List Bool) (neg far long:Bool)
    (packed:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s)) (q:Wire) (ext:Exterior 285 529 q) :
    let history:=run (body idx (withArchive d)) t (run Partial.enter285 m s)
