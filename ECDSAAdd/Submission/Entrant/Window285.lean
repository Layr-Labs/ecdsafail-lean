    let u:=run openPart m₀ s
    let v:=run interior m₁ u
    run closePart m₂ v=⟨v.phase,writeBit (writeBit v.basis 1557 false) 1558 false⟩ := by
  let u:=run openPart m₀ s
  let v:=run interior m₁ u
