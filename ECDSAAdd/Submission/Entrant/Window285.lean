    (nowZ:SkywalkRails.State) (parity:(nowZ.a+nowZ.b)%2=1)
    (ready:onRails idx 0 nowZ (run Partial.enter285 et before).basis)
    (past:SkywalkNat.State) (g sign cross:Bool) (odd:past.v%2=1) (small:min past.u past.v<2^121)
