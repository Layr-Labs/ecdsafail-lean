namespace ECDSAAdd.Entrant.StairPacket.Leave300ActualHistory
open Arithmetic Partial LeaveCompanion LeaveCompanion300 PortalValues Leave300Barrel Leave300High HighBankBarrel
open Leave300Front LeaveSelector Leave300Selector Leave300OutputPorts LeaveReadoutFrame IntegerHigh Leave300Close
open Leave300Relocated StairArchiveTrace
set_option maxRecDepth 50000
set_option maxHeartbeats 2000000

open IntegerPacket
attribute [local irreducible] run SkywalkNat.step

theorem result (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^106)
    (ready:onRails 15 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 106 15 z)).v) s.basis)
    (fresh:s.basis 1685=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false)
    (odd:z.v%2=1) (room:Shadow.high 106 15 z+1<2^135)
    (clean:∀q∈carries,s.basis q=false)
    (padding:∀i:Nat,135 ≤ i → i<150 → s.basis (wire i)=false)
    (bank:regValue ys s.basis=if Shadow.far 106 15 z then Shadow.high 106 15 z else 0)
    (zero:∀q∈Leave300FrontReady.watched,s.basis q=false)
    (nextSmall:min (SkywalkNat.step^[15] z).u (SkywalkNat.step^[15] z).v<2^99)
    (bound:Leave300TrueMiddle.F z<2^150)
    (far:s.basis 1683=decide (Shadow.far 106 15 z))
    (side:s.basis 1684=(decide (Shadow.far 106 15 z) && decide (2^106≤z.u))) (g0 s0 : Bool)
    (record : readCells (shape 15) 0 15 (mappedBasis 15 s.basis) =
      SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)) :
    let out:=run leave300 m s
    let cells:=readCells (shape 15) 0 15 (mappedBasis 15 out.basis)
    cells=SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v) ∧
      out.basis 1679=decide (Shadow.far 106 15 z) ∧
      out.basis 1680=(decide (Shadow.far 106 15 z) && afterFlags (decide (z.v<z.u)) (cells.take 5)) ∧
      out.basis 1681=(decide (Shadow.far 106 15 z) && HighBankSum.cross (Leave300TrueMiddle.d z)) := by
  let xs:=SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)
  have par:=Leave300RecordedParity.result s z g0 s0 small odd record
  have mode : actualMode 106 z=farMode (s.basis 1683) (s.basis 1684) z.u:=by
    rw [far,side];exact LeaveTraceHistory.flags _ _
  have ev:=Leave300RecordedEvents.result s z g0 s0 small odd record
  have all:=Leave300Whole.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode ev.2 nextSmall bound xs (SkywalkTrace.trace_length _ _) (LeaveTraceHistory.certifiedChain _ _ _ _ small odd) (LeaveTraceHistory.firstSwap _ _ _ _ small odd) ev.1 far side
  have words:=Leave300EndWords.result s m z G sg small ready fresh scratch temp odd room clean padding bank zero par mode ev.2 nextSmall bound xs (SkywalkTrace.trace_length _ _) (LeaveTraceHistory.certifiedChain _ _ _ _ small odd) (LeaveTraceHistory.firstSwap _ _ _ _ small odd) ev.1 far side
  have kept:=(Leave300PreservedRecords.result s m words.2.2.2.1).trans record
  refine ⟨kept,all.2.1,?_,all.2.2.2.1⟩
  rw [kept,all.2.2.1]
  by_cases active:Shadow.far 106 15 z
  · rw [LeaveTraceHistory.orient _ _ small active]
  · simp [active]
end ECDSAAdd.Entrant.StairPacket.Leave300ActualHistory

end
