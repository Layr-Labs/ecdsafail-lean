  by_cases fold:1314≤q ∧ q≤1328
  · have homes:∀w∈List.range' 1314 15,w∈sites 285:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    exact (inside 285 raw _ q (homes q (List.mem_range'_1.mpr ⟨fold.1,Nat.lt_succ_of_le fold.2⟩))).symm
  by_cases band:1301≤q ∧ q≤1313
  · exact oldBand_origin d x p good raw s dom m t neg far long packed q band.1 band.2
  have maps:=placements q ext (fun h=>(Nat.lt_or_ge q 1314).elim (fun l=>band ⟨h.1,Nat.le_of_lt_succ l⟩) (fun g=>fold ⟨g,h.2⟩))
  apply exterior_origin (by decide) (by decide) full_widths ext maps.1.1 maps.1.2
  intro prev
  have no:q∉ports285++[1693, 1691, 1692]++RailPair.sites Enter285.upperPairs++Enter285.pending:=fun h=>local_set q h ext
  have noPort : q∉ports285:=fun hit=>no (by simp [hit])
  have noHi : q∉RailPair.sites Enter285.upperPairs:=fun hit=>no (by simp [hit])
  have stay:=ext_head Partial.enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s m t q maps.2
    (fun used=>noPort (List.mem_toFinset.mp (Enter285.programCover used)))
    (fun hit=>(admin_set q hit).elim (fun bad=>bad ext) prev) (admin_cover d)
  have old:=packed.unchanged q (fun eq:q=1693=>no (by simp [eq])) (fun eq:q=1691=>no (by simp [eq])) (fun eq:q=1692=>no (by simp [eq])) noHi
  have unmasked:q∉Enter285.pending:=fun hit=>no (by simp [hit])
  exact stay.trans (by simpa [eraseSites,unmasked] using old)

