theorem shortMapping (i:Fin 106):
    windowNet 15 (shortL.a.getD i.val 0)=331+i.val ∧
    windowNet 15 (shortL.b.getD i.val 0)=786+i.val := by
  have h1 : (shortL.a.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (shortL.b.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  revert i
  simp only [ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2]
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem wideMapping (i:Fin 198):
    L.a.getD i.val 0=OB5.sig 314 (331+i.val) ∧
    L.b.getD i.val 0=OB5.sig 314 (786+i.val) := by
  have h1 : (L.a.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h2 : (L.b.all fun x => decide (x < 2 ^ 11)) = true := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  revert i
  simp only [ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h1, ECDSAAdd.Entrant.WSlimV3.tget_tpack' 11 _ h2]
  (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)

theorem wide (a:SkywalkNat.State) (G sg:Bool) (raw:State)
    (input:SkywalkIntegerInput L (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis)
    (i:Fin 198) :
    let o:=pullState (OB5.sig 314) raw
    let e:=negative sg a.u
    let pos:=(a.u+a.v).testBit i.val
    let neg:=(a.u-e.toNat).testBit i.val ^^ e
    o.basis (331+i.val)=(if G then neg else pos) ∧ o.basis (786+i.val)=(if G then pos else neg) := by
  have maxA:198≤L.a.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have maxB:198≤L.b.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have h:=pair L G sg a.u a.v i.val raw.basis input.1 input.2.1 input.2.2.1
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  rw [(wideMapping i).1,(wideMapping i).2] at h
  exact h

theorem short (a:SkywalkNat.State) (G sg:Bool) (s:State)
    (ready:onRails 15 15 (SkywalkRails.encode G sg a.u a.v) s.basis) (i:Fin 106) :
    let e:=negative sg a.u
    let pos:=(a.u+a.v).testBit i.val
    let neg:=(a.u-e.toNat).testBit i.val ^^ e
    s.basis (331+i.val)=(if G then neg else pos) ∧ s.basis (786+i.val)=(if G then pos else neg) := by
  have maxA:106≤shortL.a.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have maxB:106≤shortL.b.length:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have prev:mappedBasis 15 s.basis shortL.previous=G:=by cases G <;> exact ready.2.2.1
  have h:=pair shortL G sg a.u a.v i.val (mappedBasis 15 s.basis) ready.1 ready.2.1 prev
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  unfold mappedBasis at h
  dsimp only at h
  rw [(shortMapping i).1,(shortMapping i).2] at h
  exact h
end ECDSAAdd.Entrant.StairPacket.Leave300WideWords

