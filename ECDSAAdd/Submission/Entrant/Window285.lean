      (∀i:Fin 11,let pos:=(a.u+a.v).testBit (114+i.val);let neg:=mag.testBit (114+i.val) ^^ sign
                   out.basis (430+i.val)=(if G then neg else pos) ∧ out.basis (900+i.val)=(if G then pos else neg)) ∧
      ∀i:Fin 88,out.basis (911+i.val)=(a.u+a.v).testBit (125+i.val) := by
