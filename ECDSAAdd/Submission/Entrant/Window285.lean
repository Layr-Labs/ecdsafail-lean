theorem result (s : State) (z : SkywalkNat.State) (g sg : Bool)
    (small : min z.u z.v < 2^106) (odd : z.v % 2 = 1)
    (record : readCells (shape 15) 0 15 (mappedBasis 15 s.basis) =
      SkywalkTrace.trace 15 (encode g sg z.u z.v)) :
    Leave300EntryAction.oddRead s.basis = oddBits (letters 15 (Shadow.reduced 106 15 z)) := by
  have ports : Leave300EntryAction.oddRead s.basis =
      (readCells (shape 15) 0 15 (mappedBasis 15 s.basis)).map (fun pair => !pair.1) := by rfl
