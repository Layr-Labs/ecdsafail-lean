namespace ECDSAAdd.Entrant.StairPacket.Leave285Admission
open Arithmetic Partial LeaveCompanion LeaveCompanion285 PortalValues Leave285Barrel Leave285High HighBankBarrel
open Leave285Front LeaveSelector Leave285Selector Leave285OutputPorts LeaveReadoutFrame IntegerHigh Leave285Close
open Leave285Relocated StairArchiveTrace
open IntegerPacket
attribute [local irreducible] run SkywalkNat.step
theorem Inputs.roundtrip {s:State} {z:SkywalkNat.State} {g0 s0:Bool} (h:Inputs s z g0 s0) (m n:List Bool):
    run leave285Inv n (run leave285 m s)=s:=by
  let u:=flags z g0 s0
  let xs:=SkywalkTrace.trace 15 (SkywalkRails.encode g0 s0 z.u z.v)
  have par:=Leave285RecordedParity.result s z g0 s0 h.small h.odd h.record
  have mode : actualMode 114 z=farMode (s.basis 1691) (s.basis 1692) z.u:=by
    rw [h.far,h.side];exact LeaveTraceHistory.flags _ _
  have ev:=Leave285RecordedEvents.result s z g0 s0 h.small h.odd h.record
