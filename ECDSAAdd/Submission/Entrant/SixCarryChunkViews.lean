theorem split_flatten (xs : List (List α)) (i : Nat) (chunk : List α)
 (h : xs[i]?=some chunk) :
 xs.flatten=(xs.take i).flatten++(chunk++(xs.drop (i+1)).flatten) := by
 obtain ⟨hi,hg⟩ := List.getElem?_eq_some_iff.mp h
 have hd := List.drop_eq_getElem_cons hi
 rw [hg] at hd
 have hs := (List.take_append_drop i xs).symm.trans (congrArg (fun ys=>xs.take i++ys) hd)
 conv_lhs => rw [hs]
 simp only [List.flatten_append,List.flatten_cons]

theorem lookup_context (p pre chunk post : Program) (start off : Nat)
 (hs : p=pre++(chunk++post)) (hl : pre.length=start) (ho : off<chunk.length) :
 p[start+off]?=chunk[off]? := by
 rw [hs,List.getElem?_append_right (by omega),hl]
 simp only [Nat.add_sub_cancel_left]
 exact List.getElem?_append_left ho

