 (scatterState hs vs s).basis w=s.basis w:=by
 induction hs generalizing vs s with
 | nil=>rfl
 | cons h hs ih=>
  cases vs with
  | nil=>rfl
  | cons v vs=>
   rw[scatterState,ih vs (setWire s h v) (by simp_all)]
