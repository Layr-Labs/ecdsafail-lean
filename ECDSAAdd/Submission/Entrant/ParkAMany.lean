 · have lc:=lastCarry_mem n cs cin
   rw[←eq]at lc
   rcases List.mem_cons.mp lc with rfl|lc
   · exact fresh (by simp)
   · exact fresh (by simp[lc])
 · simp only[List.mem_append]at bad
   rcases bad with (bad|bad)|bad
   · exact fresh (by simp[List.mem_of_mem_drop bad])
   · exact fresh (by simp[List.mem_of_mem_drop bad])
   · exact fresh (by simp[List.mem_of_mem_drop bad])
