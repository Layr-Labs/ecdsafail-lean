   simp only[scatterState]
   have ne:w≠h:=by simp_all
   have comm:setWire (setWire s w v) h b=setWire (setWire s h b) w v:=by
    cases s with
    | mk phase basis=>
     simp only[setWire,writeBit]
     congr 1
     exact Function.update_comm ne v b basis
