 have hm:0<2^(n+1):=by positivity
 rw[borrow_value _ _ _ hm (Nat.mod_lt _ hm) (Nat.mod_lt _ hm)]at val
 exact bool_nat_injective _ _ (val.trans (cacheN_value (n+1) H).symm)

                                                                        
                                                         
                                                                                 
                                                                              
                                             
                                                                                                           
                                                     
                                                                                                       
                                               
                                 
                                                                                       
                                                                     
