theorem prefixAfter_off (n k:Nat) (xs ys cs:List Wire) (cin w:Wire)
 (fresh:w∉cin::(xs++ys++cs)):
 w∉wires (prefixAfter n k xs ys cs cin):=by
 apply carryPrefix_off
