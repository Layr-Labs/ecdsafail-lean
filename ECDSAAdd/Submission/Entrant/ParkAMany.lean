   (hf.2 _ (eReg_away L hn _ (spare_mem_eReg L hw)).1).trans hP
  have offP:=spare_off_dual L hw hn
  have eq:=cached_wloop_triple_eq (accReg L) (accZ L) (accBank L) L.core.cin (hiReg L)
