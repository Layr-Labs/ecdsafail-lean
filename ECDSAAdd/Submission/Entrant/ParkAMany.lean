theorem lastCarry_index (n:Nat) (cs:List Wire) (cin:Wire) (hc:n+1≤cs.length):
 lastCarry (n+1) cs cin=cs.getD n 0:=by
 induction n generalizing cs cin with
 | zero=>cases cs with
   | nil=>simp at hc
