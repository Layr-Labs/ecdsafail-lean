  simp only [R,LowZero18LowK.jregsH,LowZero18LowK.oregs,KRegs.hi,List.length_drop,List.length_take,hs]
  omega
 have idx (i : Nat)(hi : i<64) : R.bank.getD i 0=L.inputBank.getD (64+i) 0 := by
