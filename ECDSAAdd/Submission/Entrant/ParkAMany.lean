 have wq:cs.getD 6 0≠q:=by
  intro e
  apply qo.2.2.1
  simp[seventhMajority,majority,wires,Instr.wires,←e]
 have wr:cs.getD 6 0≠r:=by
  intro e
  apply ro.2.2.1
  simp[seventhMajority,majority,wires,Instr.wires,←e]
