 theorem program_slots_rel (xs dst pad carry : List Wire) (cin : Wire) :
    Challenge.gateSlots (program xs dst pad carry cin)≤Challenge.gateSlots (TrimSquare.tsqc2 xs dst pad carry cin) := by
  unfold program
  split_ifs with h
