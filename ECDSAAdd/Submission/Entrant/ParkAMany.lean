theorem spare_ne_product_i (L:CuccaroStreamedSquareWideLayout) (hw:L.Widths) (hn:L.wires.Nodup)
 (i:Nat) (hi:i<258) (h1:1≠i):spare L≠L.core.product.getD i 0:=by
 have nd:L.core.product.Nodup:=by
