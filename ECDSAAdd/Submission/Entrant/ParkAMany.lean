 u≠L.core.sumCarry ∧ u≠eV L ∧ u≠spare L ∧ hasWire (aBodyTriple L g) u=true
instance (L:CuccaroStreamedSquareWideLayout) (g u:Wire):Decidable (LoanReady L g u):=by
