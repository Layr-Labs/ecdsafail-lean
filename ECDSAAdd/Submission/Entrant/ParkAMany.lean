theorem cached_context_support (A M M0 E B A' C C0 : Program)
    (hm : wires M⊆wires M0) (hc : wires C⊆wires C0)
    (hp : wires A'⊆wires A∪wires M0) :
    wires (A++M++E++B++A'++C++E)⊆wires (A++M0++E++B++A++C0++E) := by
