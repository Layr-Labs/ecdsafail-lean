theorem body_refined (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (c : Wire) :
 wires (ParkCarry10Develop.body L c)⊆insert (L.core.high.headD 0) (wires (ParkCarry8Develop.body L c)) := by
 let v := L.core.high.headD 0
