theorem hasWire_iff (p:Program) (q:Wire):hasWire p q=true ↔ q∈wires p:=by
 induction p with
 | nil=>simp[hasWire,ECDSAAdd.wires]
 | cons i p ih=>simp_all[hasWire,ECDSAAdd.wires]

