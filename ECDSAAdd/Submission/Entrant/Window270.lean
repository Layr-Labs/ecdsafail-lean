-- ==== R1: constant-stack comparison of the spliced gate lists ====
section

namespace ECDSAAdd.Entrant.StairPacket.GateMirror

/-- Tail-recursive list comparison. A whole-list `decide` on `a = b` nests one kernel frame per element; this check
runs in constant stack, so the spliced gate lists (3,200 to 3,950 gates) are compared without deep recursion. -/
def sameList {α : Type} [DecidableEq α] : List α → List α → Bool
  | [], [] => true
  | a :: as, b :: bs => if a = b then sameList as bs else false
  | _, _ => false
theorem sameList_sound {α : Type} [DecidableEq α] : ∀ a b : List α, sameList a b = true → a = b := by
  intro a
  induction a with
  | nil =>
    intro b h
    cases b with
    | nil => rfl
    | cons y ys =>
      rw [show sameList ([] : List α) (y :: ys) = false from rfl] at h
      exact absurd h Bool.false_ne_true
  | cons x xs ih =>
    intro b h
    cases b with
    | nil =>
      rw [show sameList (x :: xs) ([] : List α) = false from rfl] at h
      exact absurd h Bool.false_ne_true
    | cons y ys =>
      rw [show sameList (x :: xs) (y :: ys) = (if x = y then sameList xs ys else false) from rfl] at h
      by_cases e : x = y
      · rw [if_pos e] at h
        subst e
        rw [ih ys h]
      · rw [if_neg e] at h
        exact absurd h Bool.false_ne_true

end ECDSAAdd.Entrant.StairPacket.GateMirror

end

