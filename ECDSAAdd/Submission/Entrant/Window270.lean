    simp [stash,eraseSites,dest,source,empty _ (toDst _ source)]
  · simp only [src,List.mem_cons,List.not_mem_nil,or_false,not_or] at source
    have nod:=dest
    simp only [dst,List.mem_cons,List.not_mem_nil,or_false,not_or] at nod
