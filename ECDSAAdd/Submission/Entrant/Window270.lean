/-- leave285 never writes the physical fold homes 1785..1812 (its wires stop at 1784). -/
theorem foldKept (s:State) (m:List Bool) (q:Wire) (h:q∈WideReference.foldSites285) : (run leave285 m s).basis q=s.basis q := by
  have stable : ∀q∈WideReference.foldSites285,q∉leave285.map LeaveReadoutFrame.destination := by
    ((try unfold WideReference.foldSites285); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
