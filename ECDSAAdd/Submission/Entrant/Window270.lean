theorem stable (i:Nat) (lo:300 ≤ i) (hi:i ≤ 511) (r:Nat) (old:r < 300) (sw:Bool):
    OB5.sig i (logical sw r)=site sw r:=by
  cases sw <;> simp only [logical,Bool.false_eq_true,if_false,if_true,site,
    StairField2V3JuncRefWalk.sig_base i hi,StairField2V3JuncRefWalk.sig_base 300 (by decide)]
  all_goals split_ifs <;> first | rfl | omega
