  have flags:=mode_flags (s.basis 1691) (s.basis 1692) (⟨IntegerHigh.wait 15 z.u, by have h:=IntegerHigh.wait_le 15 z.u;omega⟩:Fin 16)
  have leftOK:left k=(t.basis 1691 && t.basis 1692) := by rw [keep _ (by decide),keep _ (by decide),show k=_ from mode]; exact flags.1
  have rightOK:right k=(t.basis 1691 && !t.basis 1692) := by rw [keep _ (by decide),keep _ (by decide),show k=_ from mode]; exact flags.2.1
  have done:=Leave285Core.result z t (tape.drop (measurementCount (fullPrefix false))) k s.basis small odd room
