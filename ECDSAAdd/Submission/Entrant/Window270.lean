namespace ECDSAAdd.Entrant.StairPacket.Enter270
open Arithmetic MappedCompressed EnterProof PortalValues
set_option maxRecDepth 25000
set_option maxHeartbeats 4000000
attribute [local irreducible] run
def saved := [1695, 1696, 1697]++upperPairs.map Prod.snd
theorem high_from_cut (raw cut:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^121)
    (packed:PackedCut lowerPairs upperPairs 285 1700 1698 1699 (negative S z.u) (decide (Shadow.far 121 15 z))
      (decide (Shadow.far 121 15 z ∧ 2^121≤z.u)) (pullState (OB5.sig 269) raw) cut)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 270) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    regValue saved (run Partial.enter270 m cut).basis=if Shadow.far 121 15 z then Shadow.high 121 15 z else 0 :=by
  have high:=SavedHigh.stored 140 raw cut z G S packed input layout.g0
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  obtain ⟨_,bits,outer⟩:=from_full raw cut z G S m small packed input
  have live:∀q∈upperPairs.map Prod.snd,q∉ports270:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have bulk:=regValue_congr (upperPairs.map Prod.snd) (run Partial.enter270 m cut).basis cut.basis
    (fun q hit=>outer q (fun used=>live q hit (List.mem_toFinset.mp (programCover used))))
  apply SavedHigh.assemble 121 15 z G S _ 1695 1696 1697 _
  · exact bits 12 (by rw [forward_all];decide)
  · exact bits 13 (by rw [forward_all];decide)
  · exact bits 14 (by rw [forward_all];decide)
  · exact bulk.trans high

end ECDSAAdd.Entrant.StairPacket.Enter270

