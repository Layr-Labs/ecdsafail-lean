    intro q hq
    apply junction_data_erased retired L hn member q
    simp only [Finset.mem_insert,Finset.mem_singleton] at hq
    simp only [BalancedCleanup.Layout.r,List.mem_append,List.mem_cons,List.mem_singleton,
