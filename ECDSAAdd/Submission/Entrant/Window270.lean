    intro p h
    rw [same _ ((by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀p∈longPairs,p.2∉flipHistory.map destination ∧ p.2≠1693 ∧ p.2∉RailPair.sites pairs) p h)]
