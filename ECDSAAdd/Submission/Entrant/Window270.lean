  apply Leave225Mirror.invertsMove s phase initial  _ _ (401+key (actualMode 144 z)) hot m n
  · exact Leave225CoreCheckpoint.oracle s _ atCore.1 atCore.2.2.1 clean
  · exact (atPost.2.2.2.2 (1269,1556) (by decide)).2
