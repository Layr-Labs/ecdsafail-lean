  simp only [run_append,run_take]
  apply packed loPairs hiPairs 300 1693 1691 1692 _ far long origin v w x (run store t3 x)
    bankLayout scanned.1 neg scanned.2.2.1 scanned.2.2.2 wf
  · rw [hi_y];exact xe
