  have inputs : columnsRead columns u.basis X H key.val 0 := by
    intro i hi
    let ix : Fin 18 := ⟨i,hi⟩
    change u.basis (row ix).shadow = _ ∧ u.basis (row ix).tube = _
    rw [(geom ix).1,(geom ix).2]
