theorem result (s : State) (m : List Bool) (z : SkywalkNat.State) (G sg : Bool)
    (small:min z.u z.v<2^114)
    (ready:onRails 14 15 (SkywalkRails.encode G sg (SkywalkNat.step^[15] (Shadow.reduced 114 15 z)).u
        (SkywalkNat.step^[15] (Shadow.reduced 114 15 z)).v) s.basis)
    (fresh:s.basis 1693=false)
    (scratch:∀q∈1556::1557::1558::fullC,s.basis q=false)
    (temp:∀p∈longPairs,s.basis p.2=false) :
    let a:=SkywalkNat.step^[15] (Shadow.reduced 114 15 z)
    let e:=negative sg a.u
    let out:=run entry m s
    out.phase=s.phase ∧ regValue fullM out.basis=0 ∧ out.basis 1693=e ∧
      out.basis 1556=decide (2^114≤a.u-e.toNat) ∧ (out.basis 1558).toNat=upperBorrow (2^114) a.u a.v e.toNat ∧
      ∀i<19,out.basis (430+i)=((a.u+a.v)/2^114).testBit i := by
  let a:=SkywalkNat.step^[15] (Shadow.reduced 114 15 z)
  let e:=negative sg a.u
  let u:=run scanPart m s
  let t:=m.drop (measurementCount scanPart)
  let v:=run flipHistory t u
  let tape:=t.drop (measurementCount flipHistory)
  have scanActual:=Leave285InputScan.result s m a.u a.v G sg ready fresh
  have hist (q:Wire) (h:q∉flipHistory.map destination) : v.basis q=u.basis q := preserved _ _ _ _ h
  have phase : v.phase=u.phase := by rfl
  have outputBits (i:Nat) (hi:i<19) : v.basis (430+i)=((a.u+a.v)/2^114).testBit i ∧ v.basis (900+i)=((a.u-e.toNat)/2^114).testBit i := by
    have ok : ∀j:Fin 19,430+j.val∉flipHistory.map destination ∧ 900+j.val∉flipHistory.map destination := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
    rw [hist _ (ok ⟨i,hi⟩).1,hist _ (ok ⟨i,hi⟩).2];exact scanActual.2.2.1 i hi
  have same (q:Wire) (good:q∉flipHistory.map destination ∧ q≠1693 ∧ q∉RailPair.sites pairs) : v.basis q=s.basis q :=
    (hist _ good.1).trans (scanActual.2.2.2 _ good.2.1 good.2.2)
  have clean : ∀q∈1556::1557::1558::fullC,v.basis q=false := by
    intro q h
    rw [same _ ((by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel) : ∀q∈1556::1557::1558::fullC,q∉flipHistory.map destination ∧ q≠1693 ∧ q∉RailPair.sites pairs) q h)]
    exact scratch _ h
