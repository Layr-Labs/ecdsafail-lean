      (decide (3*2^122≤z.u+z.v)) (decide (3*2^122≤z.u+z.v ∧ 2^106≤z.u))
      origin (run Partial.portal300 m origin) := by
  obtain ⟨route,sg,input⟩:=real_input d seed p 300 hp0 hx0 hpo hp hq hx hc (by decide) raw h
  exact ⟨sg,physical_frame_for d seed p hp0 hx0 hpo hp hq hx hc raw m h route sg input⟩

