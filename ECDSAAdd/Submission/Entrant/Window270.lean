    · simp [f,u,far]
  have keep (q:Wire) (h:q≠1557 ∧ q≠1558) : b₂ q=s.basis q := by simp [b₂,b₁,writeBit,h.1,h.2]
  have turn (mm:List Bool):run nextU mm ⟨s.phase,b₁⟩=⟨s.phase,b₂⟩ := by
    rw [nextU_run _ _ (by simpa [b₁,writeBit] using y)]
