theorem selected_half_frame (P : Program) (divide : Bool) (wordIn wordOut : Fp → Nat)
    (law : HalfLaw P divide wordIn wordOut) (support : HalfSupport P)
    (j active : Nat) (hj : j<102) (ha : active<5) (X Y : Fp)
