                omega
              have tailApart : List.Disjoint (a'::xs) (c::((b'::ys)++cs)) := by
                apply List.disjoint_left.mpr
                intro q hq h
                apply List.disjoint_left.mp apart (List.mem_cons_of_mem _ hq)
