    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 q (outside_above (by change 1044+285≤q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 285 (by decide) base_pool_nodup _).mp stage
    have qid:q=base (1028+(q-1044)):=by change q=1028+(q-1044)+16;simp only [Wire] at *;omega
    have jlo:285≤q-1044:=by simp only [Wire] at *;omega
