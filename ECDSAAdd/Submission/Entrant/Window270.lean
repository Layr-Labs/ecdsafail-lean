  have fit : (a.u-e.toNat)/2^114 < 2^19 := lt_of_le_of_lt (Nat.div_le_div_right (show a.u-e.toNat≤a.u+a.v by omega)) cap.2
  have se : e.toNat≤1 := by cases e <;> decide
  have su : e.toNat≤a.u := by
    by_cases h : 0<a.u
    · omega
    · simp [e,negative,h]
  have done:=Leave285EraseActual.result v tape a.u a.v e.toNat se su cap.1 fit outputBits clean temps
  dsimp only
  rw [emitted,run_append,run_take,run_append,run_take]
  refine ⟨done.1.trans (phase.trans scanActual.1),done.2.1,?_,done.2.2.1,done.2.2.2.1,?_⟩
  · exact (done.2.2.2.2 _ (by decide)).trans ((hist _ (by decide)).trans scanActual.2.1)
  · intro i hi
    have clear : ∀j:Fin 19,430+j.val∉1556::1557::1558::fullM := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
