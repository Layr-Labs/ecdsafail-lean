    (fun i _ j _ eq => Nat.add_left_cancel eq) shadow digit
  have geom : ∀ i : Fin 18, (row i).shadow=423+i.val ∧ (row i).tube=wire i.val := by (open ECDSAAdd.Entrant.WSlimMac in decide +kernel)
  have hits : ∀ r ∈ columns, ∀ q ∈ r.hot, q∈tags := by (open ECDSAAdd.Entrant.WSlimMac in decide +kernel)
  have members : ∀ q ∈ tags, ∀ i : Fin 18, q≠423+i.val := by (open ECDSAAdd.Entrant.WSlimMac in decide +kernel)
  have tx : ∀ i j : Fin 18, wire i.val ≠ 423+j.val := by (open ECDSAAdd.Entrant.WSlimMac in decide +kernel)
  have cold : ∀ i : Fin 18, 1614 ≠ 423+i.val := by (open ECDSAAdd.Entrant.WSlimMac in decide +kernel)
  have ctrl : ∀ r∈columns, ∀ q∈r.hot, u.basis q=ref q := by
