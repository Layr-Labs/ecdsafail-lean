theorem ready_from_cut (raw v:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^121)
    (p:PackedCut lowerPairs upperPairs 285 1700 1698 1699 (PortalValues.negative S z.u)
        (decide (Shadow.far 121 15 z)) (decide (Shadow.far 121 15 z ∧ 2^121≤z.u)) (pullState (OB5.sig 269) raw) v)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 270) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (_hist:∀r:Fin 15,raw.basis (base (1028+270+r))=false) (endScratch:raw.basis 1799=false ∧ raw.basis 1798=false) :
    let t:=run Partial.enter270 m v
    let T:=Shadow.reduced 121 15 z
