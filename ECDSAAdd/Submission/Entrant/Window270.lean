/-- `clean` for `WideReference.advance285`, on the window state after `NativePack285.nextWindow`. -/
theorem clean (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 285 x p raw) (m:List Bool) (neg far long:Bool)
