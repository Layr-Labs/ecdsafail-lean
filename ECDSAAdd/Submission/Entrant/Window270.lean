def nextIdx : Fin 23 := ⟨14,by decide⟩
in
/-- Window 14's carry register (1556..1687) is two wires narrower than the archive's 134 scratch ports: the last two scratch
    ports are window 14's row-14 cells (ext, history), which are zero at row 1. -/
theorem scratch_carry : ∀i:Fin 157,23≤ i.val → rawPorts i∈((ports (shape nextIdx) 1).carry.map (windowNet nextIdx)) ∨
    rawPorts i∈[(ports (shape nextIdx) 14).ext,(ports (shape nextIdx) 14).history].map (windowNet nextIdx) := by decide +kernel
in
theorem scratch_code : ∀i:Fin 157,23≤ i.val → rawPorts i=codePorts ⟨i.val-7,by omega⟩ := by decide +kernel
in
theorem past_only : ∀i:Fin 23,rawPorts ⟨i,by omega⟩∉watch nextIdx := by decide +kernel
theorem retain_watch (d:Bool) (z:SkywalkRails.State) (row:Nat) (s t:State)
    (on:onRails nextIdx 1 z s.basis) (frame:Frame codePorts (code d) row t)
    (outside:∀q,(∀i,rawPorts i≠q) → t.basis q=s.basis q) :
    ∀q∈watch nextIdx,t.basis q=s.basis q := by
  intro q h
  by_cases mem:∃i,rawPorts i=q
  · obtain ⟨i,rfl⟩:=mem
    have hi:23≤ i.val:=by
      by_contra! bad
      exact past_only ⟨i,bad⟩ h
    have old:s.basis (rawPorts i)=false:=by
      rcases scratch_carry i hi with hc|hc
      · obtain ⟨c,hc,eq⟩:=List.mem_map.mp hc
        have fresh:rawPorts i=windowNet nextIdx c:=eq.symm
        exact fresh ▸ (regValue_zero _ _).mp on.2.2.2.1 _ hc
      · obtain ⟨c,hc,eq⟩:=List.mem_map.mp hc
        have fresh:rawPorts i=windowNet nextIdx c:=eq.symm
        have fut:=on.2.2.2.2 14 (by decide) (by decide)
        simp only [List.mem_cons,List.not_mem_nil,or_false] at hc
        rcases hc with rfl|rfl
        · exact fresh ▸ fut.1
        · exact fresh ▸ fut.2
    rw [old,scratch_code i hi,frame,archive_blank _ _ (by dsimp;omega),Nat.zero_testBit]
  · exact outside _ (fun i eq=>mem ⟨i,eq⟩)
end ArchiveBoundary285
