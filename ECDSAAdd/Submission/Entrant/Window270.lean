theorem agree (d:Bool) (raw s:State) (x p:Nat) (good:Bounds x p) (dom:Domain 285 x p raw)
    (a b m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (band:∀q:Wire,999≤q → q≤1042 → (run leave285 m (run (body idx (withArchive d)) b (run enter285 a s))).basis q=false) :
    let v:=run (body idx (withArchive d)) b (run enter285 a s)
    ∀q:Wire, Leave285ReleasedOrigin.releasedSite q → (run leave285 m v).basis q=(origin 285 raw v).basis q := by
  have stable : ∀q∈untouched,q∉leave285.map LeaveReadoutFrame.destination := by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave285ReleasedActual.untouched); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  dsimp only
  intro q site
  rw [Leave285ReleasedOrigin.released _ _ good _ _ dom _ site]
  rcases site with rfl|⟨lo,hi⟩|⟨lo,hi⟩
  · rw [preserved _ _ _ _ (stable 529 (by decide))]
    exact upper_clear _ _ _ _ _ dom _ _ _ _ _ cut 529 (by decide) (by decide)
  · exact band q lo hi
  · have mem:q∈untouched:=List.mem_cons_of_mem _ (List.mem_range'_1.mpr ⟨lo,by omega⟩)
    rw [preserved _ _ _ _ (stable q mem)]
    exact future d raw s x p dom a b neg far long cut q lo hi

