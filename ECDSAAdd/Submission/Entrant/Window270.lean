    (par:parityBits ports s.basis=oddBits (IntegerHigh.letters 15 (Shadow.reduced 114 15 z)))
    (mode:actualMode 114 z=farMode (s.basis 1691) (s.basis 1692) z.u)
    (events:right (actualMode 114 z)=true → ∀i<15,i≤LeaveSelector.key (actualMode 114 z) → s.basis (Leave285Hit.swaps i)=decide (i=LeaveSelector.key (actualMode 114 z))) :
    let out:=run body tape s
