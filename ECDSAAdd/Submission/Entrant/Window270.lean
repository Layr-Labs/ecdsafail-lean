  have ht := HighBankAdjust.correct ys carries 1701 1597 (ECDSAAdd.Entrant.WSlimMain.nodup_of_nodupB (by decide +kernel)) (by decide +kernel) (by decide) s m clean
  have coord : ∀ i : Fin 120, wire i = ys.getD i 0 := by decide +kernel
