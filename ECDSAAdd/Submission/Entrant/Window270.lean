/-- The physical homes 1800..1812 of the layer-1 wires 1301..1313 (OB5.sig 284 = OB5.sig 299 = 3113-q there) agree with the
origin: window 285 and leave285 never write them and the entry cut keeps them at raw (3113-q), an exterior wire of the span. -/
theorem layer1 (d:Bool) (raw s:State) (a b m:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (q:Wire) (lo:1800≤q) (hi:q≤1812) :
    (run leave285 m (run (body idx (withArchive d)) b (run enter285 a s))).basis q=
      (origin 285 raw (run (body idx (withArchive d)) b (run enter285 a s))).basis q := by
  have mem:q∈List.range' 1800 13:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈List.range' 1800 13,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=3113-q ∧ OB5.sig (285+14) q=3113-q ∧ q∉sites 285 ∧
      Exterior 285 529 (3113-q) ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧ q∉RailPair.sites Enter285.upperPairs ∧
      q∉leave285.map LeaveReadoutFrame.destination := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,target,away,far',hn,hf,hu,no,stable⟩:=marks q mem
  rw [preserved _ _ _ _ stable,WideReference.outside 285 raw _ q away,target,
    span_unchanged 285 15 (3113-q) (by decide) (raw_away (by decide) full_widths far')]
  have normal:=ext_head enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  refine normal.trans ?_
  have kept:=(cut.unchanged q hn hf hu no).trans
    (by simp only [pullState,source] : (pullState (OB5.sig 284) raw).basis q=raw.basis (3113-q))
  simpa [eraseSites,mask] using kept

