theorem scratch_code : ∀i:Fin 157,23≤ i.val → rawPorts i=codePorts ⟨i.val-7,by omega⟩ := by decide +kernel
theorem past_only : ∀i:Fin 23,rawPorts ⟨i,by omega⟩∉watch nextIdx := by decide +kernel
