    (q:Wire) (lo:1329≤q) (hi:q≤1343) : (run (body idx (withArchive d)) b (run enter285 a s)).basis q=false := by
  have mem:q∈List.range' 1329 15:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈List.range' 1329 15,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=q ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧
      q∉RailPair.sites Enter285.upperPairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no⟩:=marks q mem
  have normal:=ext_head enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  apply normal.trans
