  exact ⟨ref,hs,(W.compactSkywalkStageStep base base_pool_nodup x p 285 hp0 hx0 hpo hp gap hx cop (by decide) ref [] hs).2,r,
    canonical_reads 285 (by decide) ref raw r []⟩

