theorem triple_physical (a b c : Nat) (P : Program)
    (support : wires P⊆Finset.range 6)
    (injective : Function.Injective (fun i : Fin 6 => tripleMap a b c i.val))
    (physical : GatePhysical P) : GatePhysical (triple a b c P) := by
