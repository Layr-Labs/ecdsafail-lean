theorem outputRegisters (s : State) (Z : Nat) (bits : ∀i<135, s.basis (live i)=Z.testBit i) :
    regValue smallA s.basis=Z%2^11 ∧ regValue scanned s.basis=(Z/2^8)%2^127 := by
