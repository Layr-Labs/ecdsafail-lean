theorem high_from_cut (raw cut:State) (z:SkywalkNat.State) (G S:Bool) (m:List Bool) (small:min z.u z.v<2^114)
    (packed:PackedCut lowerPairs upperPairs 300 1693 1691 1692 (negative S z.u) (decide (Shadow.far 114 15 z))
      (decide (Shadow.far 114 15 z ∧ 2^114≤z.u)) (pullState (OB5.sig 284) raw) cut)
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 285) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    regValue saved (run Partial.enter285 m cut).basis=if Shadow.far 114 15 z then Shadow.high 114 15 z else 0 :=by
  have high:=SavedHigh.stored 133 raw cut z G S packed input layout.g0
    (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)) (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel))
  obtain ⟨_,bits,outer⟩:=from_full raw cut z G S m small packed input
  have live:∀q∈upperPairs.map Prod.snd,q∉ports285:=by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have bulk:=regValue_congr (upperPairs.map Prod.snd) (run Partial.enter285 m cut).basis cut.basis
    (fun q hit=>outer q (fun used=>live q hit (List.mem_toFinset.mp (programCover used))))
  apply SavedHigh.assemble 114 15 z G S _ 1688 1689 1690 _
  · exact bits 12 (by rw [forward_all];decide)
  · exact bits 13 (by rw [forward_all];decide)
