    (fun q h=>(sym q).trans (Leave285Loaded.tags z s.basis q h)) (fun i h=>(keep _ (sh ⟨i,h⟩)).trans (shadow i h))
    (((regValue_eq_iff _ _ _).mpr (fun q h=>keep _ (ysOK q h))).trans bank)
