/-- Window 285 never writes the homes 1329..1343 of the future history of ticks 285..299 (unfolded at tick 285). -/
theorem future (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 285 x p raw) (a b:List Bool) (neg far long:Bool)
