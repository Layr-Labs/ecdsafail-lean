        (carryValue constant cin s.basis).toNat)%2^(b::(y++[t,z])).length) (run p m s).basis := by
  let clear : Program := [.X b,.CX parity b]
  let body := renameProgram (Equiv.swap retired b) (Q6LifetimeResearch.addTop (x++[ta,ta]) (y++[t,z]) cs k)
