  by_cases h : i<18
  · simpa only [live,dif_pos h] using lo ⟨i,h⟩
  · rw [live,dif_neg h,hi ⟨i,bound⟩ (by simpa using h),Nat.testBit_lt_two_pow (lt_of_lt_of_le small (Nat.pow_le_pow_right (by decide) (by omega)))]

