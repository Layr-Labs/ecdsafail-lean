theorem outputRegisters (s : State) (Z : Nat) (bits : ∀i<142, s.basis (live i)=Z.testBit i) :
    regValue smallA s.basis=Z%2^10 ∧ regValue scanned s.basis=(Z/2^7)%2^135 := by
  constructor
  · apply EnterProof.value_of_bits smallA
    intro i hi
    have h : ∀i:Fin 10,smallA.getD i 0=live i := by decide +kernel
    rw [h ⟨i,hi⟩]
    exact bits i (by change i<10 at hi;omega)
  · apply EnterProof.value_of_bits scanned
    intro i hi
    have h : ∀i:Fin 135,scanned.getD i 0=live (7+i.val) := by decide +kernel
    rw [h ⟨i,hi⟩,Nat.testBit_div_two_pow,Nat.add_comm i 7]
