theorem result (d:Bool) (x p:Nat) (good:Bounds x p) (raw s:State) (a b m:List Bool)
    (neg far long g0 s0:Bool) (domain:Domain 225 x p raw)
    (cut:PackedCut Enter225.lowerPairs Enter225.upperPairs 240 1723 1721 1722
