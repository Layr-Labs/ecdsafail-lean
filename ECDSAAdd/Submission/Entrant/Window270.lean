  intro q away
  have safe (j : Fin 18) : q ≠ 423+j.val := by
    rw [← (geom j).1]
    exact (away _ (List.getElem_mem j.isLt)).1
  exact (word.2.2 q away).trans (z.2.2 _ (safe ⟨key.val,by omega⟩) (safe ⟨key.val+1,by omega⟩))

