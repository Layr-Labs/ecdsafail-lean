/-- Window 285 leaves the placed homes 1314..1328 of the dead carries 1785..1812 clean (the history fold of
`WideReference.advance285`). -/
theorem mirror (d:Bool) (raw s:State) (x p:Nat) (dom:Domain 285 x p raw) (a b:List Bool) (neg far long:Bool)
    (cut:PackedCut Enter285.lowerPairs Enter285.upperPairs 300 1693 1691 1692 neg far long
      (pullState (OB5.sig 284) raw) (eraseSites Enter285.pending s))
    (q:Wire) (lo:1314≤q) (hi:q≤1328) : (run (body idx (withArchive d)) b (run enter285 a s)).basis q=false := by
  have mem:q∈mirrorSites:=List.mem_range'_1.mpr ⟨lo,Nat.lt_succ_of_le hi⟩
  have marks : ∀q∈mirrorSites,¬MayTouch idx (windowNet idx q) ∧ q∉(support++ArchiveBoundary285.rawPortsList) ∧
      q∉ports285 ∧ q∉Enter285.pending ∧ OB5.sig 284 q=3113-q ∧ q≠1693 ∧ q≠1691 ∧ q≠1692 ∧
      q∉RailPair.sites Enter285.upperPairs := by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  obtain ⟨off,adminOff,enterOff,mask,source,hn,hf,hu,no⟩:=marks q mem
  have normal:=ext_head enter285 idx (withArchive d) (support++ArchiveBoundary285.rawPortsList) s a b q off
    (fun h=>enterOff (List.mem_toFinset.mp (Enter285.programCover h))) adminOff (admin_cover d)
  apply normal.trans
  have original:raw.basis (3113-q)=false:=by
    obtain ⟨ref,match',stage⟩:=dom
    apply (match'.2 _ (outside_above (by change 1044+285≤3113-q;simp only [Wire] at *;omega))).trans
    have fields:=(W.compactSkywalkStage_fields_iff base _ 285 (by decide) base_pool_nodup _).mp stage
    apply (regValue_zero _ _).mp fields.2.2.2.2.2.1
    exact List.mem_map.mpr ⟨(3113-q)-16,List.mem_range'_1.mpr (by simp only [Wire] at *;omega),by change ((3113-q)-16)+16=3113-q;simp only [Wire] at *;omega⟩
  have cleared:((eraseSites Enter285.pending s)).basis q=false:=
    (cut.unchanged q hn hf hu no).trans (by simpa only [pullState,source] using original)
  simpa [eraseSites,mask] using cleared

