  have ysOK : ∀q∈ys,untouched q := by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave285Routed.untouched); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
  have pa : ∀q∈paritySites,untouched q := by ((try unfold ECDSAAdd.Entrant.StairPacket.Leave285Routed.untouched); open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)
