namespace ECDSAAdd.Entrant.StairPacket
open Arithmetic MappedCompressed IntegerPacket SkywalkRails EnterProof
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option exponentiation.threshold 1024
attribute [local irreducible] run onRails routed unrouted
namespace NativePack270
open ArchiveBoundary270
def nextWindow (d:Bool) := Partial.enter270 ++ window d
def nextUnwind (d:Bool) := unwind d ++ Partial.enter270Inv

theorem next_window (d:Bool) (raw s:State) (m:List Bool)
    (z:SkywalkNat.State) (G S:Bool) (odd:z.v%2=1) (small:min z.u z.v<2^121)
    (cut:PackedCut Enter270.lowerPairs Enter270.upperPairs 285 1700 1698 1699 (PortalValues.negative S z.u)
      (decide (Shadow.far 121 15 z)) (decide (Shadow.far 121 15 z ∧ 2^121≤z.u))
      (pullState (OB5.sig 269) raw) (eraseSites Enter270.pending s))
    (input:SkywalkIntegerInput (W.compactSkywalkTickLayout base 270) (encode G S z.u z.v).a (encode G S z.u z.v).b G raw.basis)
    (hist:∀r:Fin 15,raw.basis (base (1028+270+r))=false) (endScratch:raw.basis 1799=false ∧ raw.basis 1798=false)
    (past:SkywalkNat.State) (pg ps cross:Bool) (po:past.v%2=1) (pm:min past.u past.v<2^129)
    (prior:PastFacts sourceIdx rawPorts 129 past pg ps cross s) :
    let out:=run (nextWindow d) m s
    let T:=Shadow.reduced 121 15 z
    out.phase=s.phase ∧ onRails idx 15 (SkywalkTrace.next^[15] (encode G S T.u T.v)) out.basis ∧
      readCells (shape idx) 0 15 (mappedBasis idx out.basis)=SkywalkTrace.trace 15 (encode G S z.u z.v) ∧
      ∀t,run (nextUnwind d) t out=s := by
  let pre:=run Partial.enter270 m s
  let tape:=m.drop (measurementCount Partial.enter270)
  let T:=Shadow.reduced 121 15 z
  let Z:=encode G S T.u T.v
  have to':T.v%2=1:=shadow_odd 121 z small odd
  have parity:(Z.a+Z.b)%2=1:=encode_odd_sum G S _ _ (by omega)
  have ready:=Enter270.ready_pending raw s z G S m small cut input hist endScratch
  obtain ⟨legal,row,limit,frame⟩:=admits d s m tape (tape.drop (measurementCount (routed idx 0 1))) Z parity ready.2.1 past pg ps cross po pm prior
  have all:=window_run d pre tape Z parity ready.2.1 legal row limit frame
  dsimp only [nextWindow,nextUnwind]
  simp only [run_append,run_take]
  refine ⟨all.1.trans ready.1,all.2.1,all.2.2.1.trans (true_records 121 z small odd G S),?_⟩
  intro n
  rw [all.2.2.2 n]
  have free:∀q∈Enter270.pending,q∉wires Partial.enter270Inv:=by decide +kernel
  apply unmask Partial.enter270 Partial.enter270Inv Enter270.pending Enter270.avoid_enter free
  exact return_packed Enter270.layout map270 _ _ inc270 (fun _=>rfl) rfl emitted270 emitted270Inv raw _ z G S small cut input _ _
end NativePack270
