    rw [same fullM (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)),same fullA (by (open ECDSAAdd.Entrant.WSlimV3 in decide +kernel)),d.2.2.1,d.2.2.2,borrow]
