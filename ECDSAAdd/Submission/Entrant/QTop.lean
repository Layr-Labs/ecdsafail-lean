def sub33 (R Z cs U : List Wire) (cin : Wire) : Program :=
  mixedSub true (mappedRead (U++Z.take 1) false) upper33 ((R.drop 0).take 33) (cs.take 32) cin

def sub43 (R Z cs U : List Wire) (cin : Wire) : Program :=
