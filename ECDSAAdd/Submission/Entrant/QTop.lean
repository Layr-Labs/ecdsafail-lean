/-! ### merged from `ECDSAAdd.Submission.Entrant.StairPhysicalLayout_at_QTop` -/
section Merge_StairPhysicalLayout_at_QTop

/-!
# Physical layout for the omittable-44 staircase

`StairPhysicalInventory` shows that only the 44 retired roles
`base 720 .. base 764` (without `base 760`) free physical sites, so the
staircase is re-planned at PK2's exact point `p1 = 17`
(`../redesign/PK2/price2_run.log`, EXACT model):
checkpoints `[17, 12, 9, 6, 4, 2]`, rows
`(425, 87), (450, 62), (465, 47), (480, 32), (490, 22), (500, 12)`,
`k = 44`, `Q = 1542`.

All coordinates below are field-tail labels (the argument level of
`StairOuterPlacement.outerPlace`).  The design:

* letters `g t` stay on their record labels (`g 511` on `base 2409`, the
  selector-host image), so the moved walk writes packets where the groups read
  them; history letters `s t` use their late-sign labels
  `sLetter t = OB5.sig 511 (base (1028 + t))`;
* the moved b-rail and carries use one fixed site per index (`bSite`,
  `cSite`): holes of the already encoded packets 1..84, four clean bank sites,
  and three terminal history letters that no moved tick writes;
* the previous-letter input of every first moved tick is the clean spare
  `base 717`;
* the codec length bits `A` are the first future payload letters of the row;
  `z`, `t`, and the decoder work use later history letters and the b/c sites of
  indices above the row's budget, all clean at pack and unpack time;
* at rest the merged field and sign are moved onto the letters of the row
  (`relocate`, 2 CX per bit, T-free), and the remaining future payload letters
  are the role hosts.

`segMap` is one injective map per segment, as required by
`StairReplay.movedForward`.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairPhysicalLayout

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairOuterPlacement StairPhysicalInventory

/-! ## Fast arena membership -/

/-- The record arena as explicit wire ranges. -/
def arenaNat : List Wire :=
  [1] ++ List.range' 2 256 ++ List.range' 258 256 ++ [0, 9815, 9814, 4112] ++
    List.range' 4115 515 ++ List.range' 4833 311 ++ List.range' 5399 257 ++ [5915]

/-- LT44 (replay budget): `StairHoleSupport.recordArena_eqN` (58 s → 1 s). -/
theorem recordArena_eq : StairHoleSupport.recordArena = arenaNat :=
  StairHoleSupport.recordArena_eqN

/-! ## Labels -/

/-- Field-tail label of history letter `s t`. -/
def sLetter (t : Nat) : Wire := OB5.sig 511 (base (1028 + t))


/-- Field-tail label of letter `g t`. -/
def letterSite (t : Nat) : Wire := if t = 511 then base 2409 else base t

def zeroWire : Wire := base 717

/-! ## The re-planned rows -/

def budgets : List Nat := [87, 62, 47, 32, 22, 12]

def startFor (B : Nat) : Nat := 512 - B

def endFor (B : Nat) : Nat :=
  if B = 87 then 450 else if B = 62 then 465 else if B = 47 then 480
  else if B = 32 then 490 else if B = 22 then 500 else 505

/-- Loaned retired roles at each row: `44 - deficit` roles are hosted. -/
def deficitFor (B : Nat) : Nat :=
  if B = 87 then 0 else if B = 62 then 14 else if B = 47 then 23
  else if B = 32 then 31 else if B = 22 then 37 else 42

/-! ## Fixed b-rail and carry sites -/

def bNum (k : Nat) : Nat :=
  if k < 50 then 1035 + 5 * k
  else if k < 84 then 2046 - 5 * k
  else if k = 84 then 514
  else if k = 85 then 1027
  else if k = 86 then 1544
  else 1545

def cNum (k : Nat) : Nat :=
  if k < 50 then 1037 + 5 * k
  else if k < 84 then 2044 - 5 * k
  else if k = 84 then 1540
  else if k = 85 then 1797
  else 1546

def bSite (k : Nat) : Wire := base (bNum k)
def cSite (k : Nat) : Wire := base (cNum k)




/-! ## One injective moved map per segment -/

def segMap (l e q : Nat) : Wire :=
  if q + 1 = l then zeroWire
  else if l ≤ q ∧ q ≤ 513 then (if q = 511 then base 2409 else base q)
  else if 770 ≤ q ∧ q ≤ 857 then base (bNum (q - 770))
  else if 1028 + l ≤ q ∧ q < 1028 + e then base (2053 - (q - 1028))
  else if 1540 ≤ q ∧ q ≤ 1626 then base (cNum (q - 1540))
  else base (4000 + q)

def segmentMap (B : Nat) : Nat → Wire := segMap (startFor B) (endFor B)

/-- K4-B (replay budget): a left inverse of `segMap` on its values (`base v = v + 16`), so
injectivity needs one case split of one side instead of the product of both sides. -/
def kbSegInv0 (v : Nat) : Nat :=
  if v < 514 then v else if v = 2409 then 511 else if 4000 ≤ v then v - 4000
  else if 1549 ≤ v ∧ v ≤ 1628 then 3081 - v
  else if v = 514 then 854 else if v = 1027 then 855 else if v = 1544 then 856
  else if v = 1545 then 857 else if v = 1540 then 1624 else if v = 1797 then 1625
  else if v = 1546 then 1626
  else if v ≤ 1282 then (if v % 5 = 0 then 770 + (v - 1035) / 5 else 1540 + (v - 1037) / 5)
  else (if v % 5 = 1 then 770 + (2046 - v) / 5 else 1540 + (2044 - v) / 5)

def kbSegInv (l v : Nat) : Nat := if v = 717 then l - 1 else kbSegInv0 v

theorem kbSegInv0_bNum : ∀ k, k < 88 → bNum k ≠ 717 ∧ kbSegInv0 (bNum k) = 770 + k := by
  decide +kernel

theorem kbSegInv0_cNum : ∀ k, k < 87 → cNum k ≠ 717 ∧ kbSegInv0 (cNum k) = 1540 + k := by
  decide +kernel

theorem kbSeg_linv (l e q : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500) (h2 : e ≤ 505) :
    kbSegInv l (segMap l e q - 16) = q := by
  unfold segMap zeroWire
  split_ifs
  all_goals simp only [base, Nat.add_sub_cancel]
  all_goals first
    | (unfold kbSegInv; rw [if_pos (by omega)]; omega)
    | (have hb := kbSegInv0_bNum (q - 770) (by omega)
       unfold kbSegInv; rw [if_neg hb.1, hb.2]; omega)
    | (have hc := kbSegInv0_cNum (q - 1540) (by omega)
       unfold kbSegInv; rw [if_neg hc.1, hc.2]; omega)
    | (unfold kbSegInv kbSegInv0; rw [if_neg (by omega), if_pos (by omega)])
    | (unfold kbSegInv kbSegInv0; rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
       omega)
    | (unfold kbSegInv kbSegInv0
       rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos (by omega)]; omega)
    | (unfold kbSegInv kbSegInv0
       rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
         if_pos (by omega)]; omega)

theorem segMap_injective (l e : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500)
    (h2 : e ≤ 505) : Function.Injective (segMap l e) := by
  intro x y eq
  have hx := kbSeg_linv l e x h0 h1 h2
  rw [eq] at hx
  exact hx.symm.trans (kbSeg_linv l e y h0 h1 h2)

theorem segmentMap_pool_nodup : ∀ B ∈ budgets,
    (skywalkPoolWires (segmentMap B)).Nodup := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  unfold skywalkPoolWires wireBlock segmentMap
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals
    exact List.Nodup.map (segMap_injective _ _ (by decide) (by decide)
      (by decide)) List.nodup_range'

/-- K4-B: row bounds used by the symbolic segment-map facts. -/
theorem kbSegBounds : ∀ B ∈ budgets, 425 ≤ startFor B ∧ startFor B ≤ 500 ∧ endFor B ≤ 505 := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

/-- K4-B (replay budget): symbolic in `t` instead of 512 evaluations per row. -/
theorem segmentMap_letters : ∀ B ∈ budgets, ∀ t, t < 512 → startFor B ≤ t →
    segmentMap B t = letterSite t := by
  intro B hB t h1 h2
  obtain ⟨b1, b2, b3⟩ := kbSegBounds B hB
  unfold segmentMap segMap letterSite
  rw [if_neg (by omega), if_pos (by omega)]

/-- K4-B (replay budget): decided only over the row's history range `[startFor B, endFor B)`
instead of every `t < endFor B`. -/
theorem segmentMap_history : ∀ B ∈ budgets, ∀ t, t < endFor B → startFor B ≤ t →
    segmentMap B (1028 + t) = sLetter t := by
  have fast : ∀ B ∈ budgets, ∀ i, i < endFor B - startFor B →
      segmentMap B (1028 + (startFor B + i)) = sLetter (startFor B + i) := by
    intro B hB
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
    all_goals decide +kernel
  intro B hB t h1 h2
  have h := fast B hB (t - startFor B) (by omega)
  rwa [show startFor B + (t - startFor B) = t by omega] at h

theorem segmentMap_previous : ∀ B ∈ budgets,
    segmentMap B (skywalkPoolPreviousId (startFor B)) = zeroWire := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

/-! ## Codec layouts -/

def payloadTick (l i : Nat) : Nat :=
  l + 5 * (i / 3) + (if i % 3 = 0 then 0 else if i % 3 = 1 then 1 else 3)

def holeTick (l i : Nat) : Nat :=
  l + 5 * (i / 2) + (if i % 2 = 0 then 2 else 4)

/-- Clean sites for `z`, `t`, and the two decoders of budget `B`. -/
def extraPool (B : Nat) : List Wire :=
  (List.range (2 * ((505 - startFor B) / 5))).map
      (fun i => sLetter (holeTick (startFor B) i)) ++
    (List.range (3 * ((505 - startFor B) / 5) - StairCodec.bitWidth B)).map
      (fun i => sLetter (payloadTick (startFor B) (StairCodec.bitWidth B + i))) ++
    (List.range (87 - B)).map (fun i => bSite (B + 1 + i)) ++
    (List.range (87 - B)).map (fun i => cSite (B + i))

def physicalLayout (B : Nat) : StairCodec.Layout where
  S i := segmentMap B (startFor B + i)
  D i := bSite i
  A i := sLetter (payloadTick (startFor B) i)
  C i := cSite i
  z := (extraPool B).getD 0 zeroWire
  t := (extraPool B).getD 1 zeroWire
  lowWork i := (extraPool B).getD (2 + i) zeroWire
  highWork i := (extraPool B).getD (34 + i) zeroWire






/-! ## Rest storage, hosts, and relocation -/

/-- Wires holding the compact word between groups: merged field and sign on
the row's letters, length bits on future payload letters. -/
def restSites (B : Nat) : List Wire :=
  (List.range (B - 1)).map (fun i => letterSite (startFor B + i)) ++
    StairCodec.reg (physicalLayout B).A (StairCodec.bitWidth B)

/-- Role hosts between groups: the remaining future payload letters. -/
def hosts (B : Nat) : List Wire :=
  ((List.range (3 * ((510 - startFor B) / 5) - StairCodec.bitWidth B)).map
    (fun i => sLetter (payloadTick (startFor B) (StairCodec.bitWidth B + i)))).take
      (44 - deficitFor B)

/-- Future packet payload at the row: packets `startFor B / 5 .. 101` and
`g 510`. -/
def futurePayload (B : Nat) : List Wire :=
  (List.range' (startFor B / 5) (102 - startFor B / 5)).flatMap
      (fun j => (List.range 5).map (fun k => letterSite (5 * j + k)) ++
        [sLetter (5 * j), sLetter (5 * j + 1), sLetter (5 * j + 3)]) ++
    [letterSite 510]





/-- Move the merged field and sign from the D rail onto the letters (after
`pack`); the inverse runs before `unpack`. -/
def moveWire (src dst : Wire) : Program := [.CX src dst, .CX dst src]

def relocate (B : Nat) : Program :=
  (List.range (B - 2)).flatMap (fun i =>
      moveWire ((physicalLayout B).D i) ((physicalLayout B).S i)) ++
    moveWire ((physicalLayout B).D (B - 1)) ((physicalLayout B).S (B - 2))

def unrelocate (B : Nat) : Program :=
  (moveWire ((physicalLayout B).S (B - 2)) ((physicalLayout B).D (B - 1))) ++
    (List.range (B - 2)).flatMap (fun i =>
      moveWire ((physicalLayout B).S i) ((physicalLayout B).D i))




/-! ## Physicality -/

/-- Every label used by the row's codec, sign extension, first moved tick,
moved histories, rest storage, and hosts. -/
def rowSites (B : Nat) : List Wire :=
  StairCodec.declaredSites (physicalLayout B) B ++
    [bSite B, base 512, base 513, zeroWire] ++
    (List.range B).map cSite ++
    (List.range (endFor B - startFor B)).map (fun i => sLetter (startFor B + i)) ++
    restSites B ++ hosts B

/-- The 15 old omissions as explicit wires. -/
def oldHolesNat : List Wire :=
  [5515, 5915, 4881, 4880, 4882, 5655, 4885, 5400, 5401, 4884, 4883, 4833, 4834,
    4875, 9815]

theorem oldHoles_eq : StairHoleSupport.oldHoles = oldHolesNat := by
  -- K4-B (replay budget): the pool wires in closed form (`poolWire_eq`) instead of list lookups
  unfold StairHoleSupport.oldHoles
  rw [StairHoleSupport.poolWire_eq 1400 (by omega), StairHoleSupport.poolWire_eq 1800 (by omega),
    StairHoleSupport.poolWire_eq 766 (by omega), StairHoleSupport.poolWire_eq 765 (by omega),
    StairHoleSupport.poolWire_eq 767 (by omega), StairHoleSupport.poolWire_eq 1540 (by omega),
    StairHoleSupport.poolWire_eq 770 (by omega), StairHoleSupport.poolWire_eq 1285 (by omega),
    StairHoleSupport.poolWire_eq 1286 (by omega), StairHoleSupport.poolWire_eq 769 (by omega),
    StairHoleSupport.poolWire_eq 768 (by omega), StairHoleSupport.poolWire_eq 718 (by omega),
    StairHoleSupport.poolWire_eq 719 (by omega), StairHoleSupport.poolWire_eq 760 (by omega)]
  decide +kernel

/-- The 44 new omissions as explicit wires. -/
def newHolesNat : List Wire := List.range' 4835 40 ++ List.range' 4876 4

theorem physicalHoles_eq_nat : physicalHoles = newHolesNat := by
  -- K4-B (replay budget): decided on the closed-form placement of the explicit sites
  have e : place = StairPlaceFast.outerPlaceB := funext StairPlaceFast.outerPlace_eqB
  rw [show physicalHoles = exclusiveSites.map place from rfl, exclusiveSites_eq, e]
  decide +kernel

/-- The good-site predicate: inside the final arena, not an old omission, and
not one of the 44 new omissions. -/
abbrev Good (q : Wire) : Prop :=
  place q ∈ arenaNat ∧ place q ∉ oldHolesNat ∧ place q ∉ newHolesNat

/-- LT41 (replay budget): `arenaNat` as an interval test (list membership was the cost of
`rowSites_good`: 374 s of kernel time → ≈ 38 s). -/
def arenaB (v : Nat) : Bool :=
  v == 1 || (decide (2 ≤ v) && decide (v < 514)) || v == 0 || v == 9815 || v == 9814 || v == 4112 ||
    (decide (4115 ≤ v) && decide (v < 4630)) || (decide (4833 ≤ v) && decide (v < 5144)) ||
    (decide (5399 ≤ v) && decide (v < 5656)) || v == 5915

/-- `newHolesNat` as an interval test. -/
def newB (v : Nat) : Bool :=
  (decide (4835 ≤ v) && decide (v < 4875)) || (decide (4876 ≤ v) && decide (v < 4880))

theorem mem_arenaNat_of (v : Nat) (h : arenaB v = true) : v ∈ arenaNat := by
  simp only [arenaB, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  simp only [arenaNat, List.mem_append, List.mem_cons, List.mem_range'_1, List.not_mem_nil, or_false]
  omega

theorem not_mem_newHolesNat_of (v : Nat) (h : newB v = false) : v ∉ newHolesNat := by
  simp only [newB, Bool.or_eq_false_iff, Bool.and_eq_false_iff, decide_eq_false_iff_not] at h
  simp only [newHolesNat, List.mem_append, List.mem_range'_1]
  omega

/-- The good-site test, Boolean. -/
def goodB (v : Nat) : Bool := arenaB v && !(oldHolesNat.contains v) && !(newB v)

theorem good_of_goodB (v : Nat) (h : goodB v = true) :
    v ∈ arenaNat ∧ v ∉ oldHolesNat ∧ v ∉ newHolesNat := by
  simp only [goodB, Bool.and_eq_true, Bool.not_eq_true'] at h
  obtain ⟨⟨ha, ho⟩, hn⟩ := h
  refine ⟨mem_arenaNat_of v ha, ?_, not_mem_newHolesNat_of v hn⟩
  intro hm
  have : oldHolesNat.contains v = true := List.contains_iff_mem.mpr hm
  rw [this] at ho
  exact absurd ho (by decide)

/-- K4-B (replay budget): `arenaB` with the kernel-primitive `Nat.beq` / `Nat.ble` tests only
(the `decide`/`==` instances of `goodB` cost ≈ 3 ms per site in the kernel). -/
def kbArenaF (v : Nat) : Bool :=
  Nat.beq v 1 || (Nat.ble 2 v && Nat.blt v 514) || Nat.beq v 0 || Nat.beq v 9815 ||
    Nat.beq v 9814 || Nat.beq v 4112 || (Nat.ble 4115 v && Nat.blt v 4630) ||
    (Nat.ble 4833 v && Nat.blt v 5144) || (Nat.ble 5399 v && Nat.blt v 5656) || Nat.beq v 5915

/-- `oldHolesNat.contains`, kernel-primitive. -/
def kbOldF (v : Nat) : Bool :=
  Nat.beq v 5515 || Nat.beq v 5915 || Nat.beq v 4881 || Nat.beq v 4880 || Nat.beq v 4882 ||
    Nat.beq v 5655 || Nat.beq v 4885 || Nat.beq v 5400 || Nat.beq v 5401 || Nat.beq v 4884 ||
    Nat.beq v 4883 || Nat.beq v 4833 || Nat.beq v 4834 || Nat.beq v 4875 || Nat.beq v 9815

/-- `newB`, kernel-primitive. -/
def kbNewF (v : Nat) : Bool :=
  (Nat.ble 4835 v && Nat.blt v 4875) || (Nat.ble 4876 v && Nat.blt v 4880)

def kbGoodF (v : Nat) : Bool := kbArenaF v && !kbOldF v && !kbNewF v

theorem kbGoodF_goodB (v : Nat) (h : kbGoodF v = true) : goodB v = true := by
  unfold kbGoodF at h
  rw [Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨⟨ha, ho⟩, hn⟩ := h
  have ha' : arenaB v = true := by
    unfold kbArenaF at ha
    unfold arenaB
    simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, Nat.ble_eq, Nat.blt_eq,
      decide_eq_true_eq, beq_iff_eq] at ha ⊢
    exact ha
  have hm : v ∉ oldHolesNat := by
    intro hm
    simp only [oldHolesNat, List.mem_cons, List.not_mem_nil, or_false] at hm
    revert ho
    rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl
    all_goals decide
  have hn' : newB v = false := by
    cases hc : newB v with
    | false => rfl
    | true =>
      have hk : kbNewF v = true := by
        unfold newB at hc
        unfold kbNewF
        simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq,
          decide_eq_true_eq] at hc ⊢
        exact hc
      rw [hk] at hn
      exact absurd hn (by decide)
  unfold goodB
  rw [ha', hn']
  cases hc : oldHolesNat.contains v with
  | false => rfl
  | true => exact absurd (List.contains_iff_mem.mp hc) hm

/-- K4-B: every label a row site can have (letters, b-rail and carry sites, late-sign history
letters, the selector-host letter, the zero wire). -/
def kbFamL : List Wire :=
  (List.range' 424 87).map base ++ [base 512, base 513, base 2409, zeroWire] ++
    (List.range 88).map bSite ++ (List.range 87).map cSite ++ (List.range' 425 85).map sLetter

theorem kbFam_letter (t : Nat) (h1 : 424 ≤ t) (h2 : t < 514) : letterSite t ∈ kbFamL := by
  unfold letterSite kbFamL
  split_ifs with h
  · simp only [List.mem_append, List.mem_cons, true_or, or_true]
  · by_cases h3 : t < 511
    · exact List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _
        (List.mem_append_left _ (List.mem_map.mpr ⟨t, List.mem_range'_1.mpr ⟨h1, by omega⟩, rfl⟩))))
    · have : t = 512 ∨ t = 513 := by omega
      rcases this with rfl | rfl
      · simp only [List.mem_append, List.mem_cons, true_or, or_true]
      · simp only [List.mem_append, List.mem_cons, true_or, or_true]

theorem kbFam_zero : zeroWire ∈ kbFamL := by
  unfold kbFamL
  simp only [List.mem_append, List.mem_cons, true_or, or_true]

theorem kbFam_b (k : Nat) (h : k < 88) : bSite k ∈ kbFamL :=
  List.mem_append_left _ (List.mem_append_left _ (List.mem_append_right _
    (List.mem_map.mpr ⟨k, List.mem_range.mpr h, rfl⟩)))

theorem kbFam_c (k : Nat) (h : k < 87) : cSite k ∈ kbFamL :=
  List.mem_append_left _ (List.mem_append_right _ (List.mem_map.mpr ⟨k, List.mem_range.mpr h, rfl⟩))

theorem kbFam_s (t : Nat) (h : 425 ≤ t ∧ t < 510) : sLetter t ∈ kbFamL :=
  List.mem_append_right _ (List.mem_map.mpr ⟨t, List.mem_range'_1.mpr ⟨h.1, by omega⟩, rfl⟩)

/-- Per-row index bounds of the payload and hole letters used by a row (small evaluations). -/
theorem kbRowFacts : ∀ B ∈ budgets,
    (∀ i, i < StairCodec.bitWidth B →
      425 ≤ payloadTick (startFor B) i ∧ payloadTick (startFor B) i < 510) ∧
    (∀ i, i < 3 * ((510 - startFor B) / 5) - StairCodec.bitWidth B →
      425 ≤ payloadTick (startFor B) (StairCodec.bitWidth B + i) ∧
        payloadTick (startFor B) (StairCodec.bitWidth B + i) < 510) ∧
    (∀ i, i < 2 * ((505 - startFor B) / 5) →
      425 ≤ holeTick (startFor B) i ∧ holeTick (startFor B) i < 510) ∧
    (∀ i, i < 3 * ((505 - startFor B) / 5) - StairCodec.bitWidth B →
      425 ≤ payloadTick (startFor B) (StairCodec.bitWidth B + i) ∧
        payloadTick (startFor B) (StairCodec.bitWidth B + i) < 510) ∧
    425 ≤ startFor B ∧ startFor B + B = 512 ∧ endFor B ≤ 505 ∧ B ≤ 87 ∧ 2 ≤ B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem kbPool_fam (B : Nat) (hB : B ∈ budgets) (q : Wire) (hq : q ∈ extraPool B) :
    q ∈ kbFamL := by
  obtain ⟨-, -, f3, f4, -, f6, -, f8, -⟩ := kbRowFacts B hB
  unfold extraPool at hq
  rcases List.mem_append.mp hq with hq | hq
  · rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        exact kbFam_s _ (f3 i (List.mem_range.mp hi))
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        exact kbFam_s _ (f4 i (List.mem_range.mp hi))
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
      have := List.mem_range.mp hi
      exact kbFam_b _ (by omega)
  · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
    have := List.mem_range.mp hi
    exact kbFam_c _ (by omega)

theorem kbGetD_fam (B : Nat) (hB : B ∈ budgets) (k : Nat) :
    (extraPool B).getD k zeroWire ∈ kbFamL := by
  rw [List.getD_eq_getElem?_getD]
  cases h : (extraPool B)[k]? with
  | none => exact kbFam_zero
  | some x => exact kbPool_fam B hB x (List.mem_of_getElem? h)

theorem kbOneHot_sites (fresh : Nat → Wire) :
    ∀ (bits : List Wire) (q : Wire), q ∈ (StairCodec.oneHot bits fresh).sites → ∃ k, q = fresh k
  | [], q, h => by
    simp only [StairCodec.oneHot, List.mem_singleton] at h
    exact ⟨0, h⟩
  | [_], q, h => by
    simp only [StairCodec.oneHot, List.mem_singleton] at h
    exact ⟨0, h⟩
  | _ :: b' :: bs, q, h => by
    simp only [StairCodec.oneHot, List.mem_append, List.mem_map] at h
    rcases h with (h | ⟨i, -, rfl⟩) | ⟨i, -, rfl⟩
    · exact kbOneHot_sites fresh (b' :: bs) q h
    · exact ⟨_, rfl⟩
    · exact ⟨_, rfl⟩

/-- K4-B: every row site is in the label family, structurally (no row is evaluated). -/
theorem kbRow_famS (B : Nat) (hB : B ∈ budgets) (q : Wire) (hq : q ∈ rowSites B) :
    q ∈ kbFamL := by
  obtain ⟨f1, f2, -, -, f5, f6, f7, f8, f9⟩ := kbRowFacts B hB
  have hS := kbSegBounds B hB
  unfold rowSites at hq
  rcases List.mem_append.mp hq with hq | hq
  · rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · rcases List.mem_append.mp hq with hq | hq
        · rcases List.mem_append.mp hq with hq | hq
          · -- declared sites
            unfold StairCodec.declaredSites at hq
            rcases List.mem_append.mp hq with hq | hq
            · rcases List.mem_append.mp hq with hq | hq
              · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                have hi' := List.mem_range.mp hi
                show segmentMap B (startFor B + i) ∈ kbFamL
                rw [segmentMap_letters B hB _ (by omega) (by omega)]
                exact kbFam_letter _ (by omega) (by omega)
              · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                have hi' := List.mem_range.mp hi
                exact kbFam_b i (by omega)
            · unfold StairCodec.workSites at hq
              rcases List.mem_append.mp hq with hq | hq
              · rcases List.mem_append.mp hq with hq | hq
                · rcases List.mem_append.mp hq with hq | hq
                  · rcases List.mem_append.mp hq with hq | hq
                    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                      exact kbFam_s _ (f1 i (List.mem_range.mp hi))
                    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                      have hi' := List.mem_range.mp hi
                      exact kbFam_c i (by omega)
                  · rcases List.mem_cons.mp hq with rfl | hq
                    · exact kbGetD_fam B hB 0
                    · rw [List.mem_singleton.mp hq]
                      exact kbGetD_fam B hB 1
                · obtain ⟨k, rfl⟩ := kbOneHot_sites _ _ q hq
                  exact kbGetD_fam B hB _
              · obtain ⟨k, rfl⟩ := kbOneHot_sites _ _ q hq
                exact kbGetD_fam B hB _
          · -- the four explicit sites
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
            rcases hq with rfl | rfl | rfl | rfl
            · exact kbFam_b B (by omega)
            · exact kbFam_letter 512 (by omega) (by omega)
            · exact kbFam_letter 513 (by omega) (by omega)
            · exact kbFam_zero
        · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
          have hi' := List.mem_range.mp hi
          exact kbFam_c i (by omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range.mp hi
        exact kbFam_s _ ⟨by omega, by omega⟩
    · unfold restSites at hq
      rcases List.mem_append.mp hq with hq | hq
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range.mp hi
        exact kbFam_letter _ (by omega) (by omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        exact kbFam_s _ (f1 i (List.mem_range.mp hi))
  · unfold hosts at hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_of_mem_take hq)
    exact kbFam_s _ (f2 i (List.mem_range.mp hi))

/-- K4-B: the good test once per family label (closed-form placement, primitive tests). -/
theorem kbFam_good : kbFamL.all (fun q => kbGoodF (StairPlaceFast.outerPlaceB q)) = true := by
  decide +kernel

/-- LT46 (replay budget): decided on the closed-form placement
(`StairPlaceFast.outerPlace_eqB`; 83 s → ≈ 8 s).  K4-B: row sites are checked against the
label family `kbFamL` (`kbRow_famS`, structural), and the kernel-primitive good test `kbGoodF` runs once per
family label (`kbFam_good`). -/
theorem rowSites_goodB : ∀ B ∈ budgets, (rowSites B).all (fun q => goodB (place q)) = true := by
  intro B hB
  rw [List.all_eq_true]
  intro q hq
  have hf : q ∈ kbFamL := kbRow_famS B hB q hq
  rw [show place q = outerPlace q from rfl, StairPlaceFast.outerPlace_eqB]
  exact kbGoodF_goodB _ (List.all_eq_true.mp kbFam_good q hf)

theorem rowSites_good : ∀ B ∈ budgets, ∀ q ∈ rowSites B, Good q :=
  fun B hB q hq => good_of_goodB _ (List.all_eq_true.mp (rowSites_goodB B hB) q hq)


/-! ## Phase context of the first budget

`pack 87` runs inside `Rolling1588Lifetime.phaseHost` (`stackForward6`) and
`unpack 87` inside `lastXN`.  There the record walk leaves the b-rail on the
x I/O word (`base 770 ..`).  The phase-side codec must be relabelled by
`phaseRelabel`, and the b-rail moved onto `bSite`, so that both contexts use
the same physical sites. -/

def phaseRelabel (q : Wire) : Wire := Rolling1588Lifetime.phaseHost (fieldPlace q)

/- LT6 (benchmark replay budget): the unreferenced diagnostic `phase_codec_agree`
(`∀ q ∈ StairCodec.declaredSites (physicalLayout 87) 87, phasePlace (phaseRelabel q) = place q`,
one `decide +kernel`, ≈ 250 s of kernel time — LT27 profile b14) is omitted; restore it from
CANON_OUT/Entrant_1823 if a field proof needs it. -/




end ECDSAAdd.Entrant.StairPhysicalLayout

end
end Merge_StairPhysicalLayout_at_QTop

