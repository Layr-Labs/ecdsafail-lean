private theorem retiredRoles_staticPool760_away (d : Nat) (hd : d ≤ 68) :
    ∀ r ∈ retiredRoles.take d, r ∉ staticPool760 := by
  intro r hr used
  have tail := retiredRoles_q6Tail760 d hd r hr
  have full := List.mem_of_mem_drop tail
  have dataAway := q6Tail760_pool_away r full
  have headAway := q6Head760_away_tail r full
  have lowerAway : r ≠ L760.lower := by
    intro eq
    exact norm760_roles_away69 r (List.mem_of_mem_take hr) (by simp [eq])
  simp only [staticPool760, List.mem_cons] at used
  rcases used with head | lower | data
  · exact headAway head
  · exact lowerAway lower
  · exact dataAway data

