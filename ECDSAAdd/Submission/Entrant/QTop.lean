    (hg : base c=false → M=0) :
    Triple (SquareFrame L.core.out base O) (aBody L c) (SquareFrame L.core.out base (resAF (M^2) O (base c))) := by
  have pmod : 0<SquareReduction.p := by norm_num [SquareReduction.p,SquareReduction.B,SquareReduction.c]
