theorem unnormalizeLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (unnormalizeLoan d L760) ⊆
      wires (unnormalizeLoan 0 L760) \ (retiredRoles.take d).toFinset := by
  have inner := literalConstAddLoan_support760 d hd BalancedCleanup.positiveLiteral
  have inner0 : wires (literalConstAddLoan d retiredRoles L760.low foldCarry760
      L760.lower L760.one BalancedCleanup.positiveLiteral) ⊆
      wires (literalConstAddLoan 0 retiredRoles L760.low foldCarry760
        L760.lower L760.one BalancedCleanup.positiveLiteral) \
        (retiredRoles.take d).toFinset := by
    rw [literalConstAddLoan_zero]
    exact inner
  have framed := framed_support_erase (retiredRoles.take d).toFinset
    [.X L760.lower] _ _ [.X L760.lower] inner0
    (lowerX760_away d hd) (lowerX760_away d hd)
  have moved := move_support_erase760 d L760.rmsb _ _ framed foldSwap760_fixed
