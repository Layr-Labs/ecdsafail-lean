theorem headFirstBase_sub (j : Nat) :
    wires (headFirstBase j)⊆wires (ECDSAAdd.Entrant.Rolling1588.basePacket true j) := by
  have cOdd := fun active => oddCell_sub j active 2
  have cStart := cellWith_sub _ dstart_support j 3 2
  simp only [headFirstBase,ECDSAAdd.Entrant.Rolling1588.basePacket,if_true]
  repeat (first
    | exact cOdd _
    | exact cStart
    | exact Finset.Subset.refl _
    | apply head_append_sub)

theorem headLastBase_sub (j : Nat) :
    wires (headLastBase j)⊆wires (ECDSAAdd.Entrant.Rolling1588.basePacket true j) := by
  have cOdd := fun active => oddCell_sub j active 2
  have cEnd := cellWith_sub _ dend_support j 4 2
  simp only [headLastBase,ECDSAAdd.Entrant.Rolling1588.basePacket,if_true]
  repeat (first
    | exact cOdd _
    | exact cEnd
    | exact Finset.Subset.refl _
    | apply head_append_sub)

theorem routeBasePacket_sub (j : Nat) :
    wires (basePacket true j)⊆wires (ECDSAAdd.Entrant.Rolling1588.basePacket true j) := by
  have cOdd := fun active => oddCell_sub j active 2
  have cEnd := cellWith_sub _ dend_support j 4 2
  by_cases terminal : j=101
  · simp only [basePacket,ECDSAAdd.Entrant.Rolling1588.basePacket,if_true,if_pos terminal]
    repeat (first
      | exact cOdd _
      | exact cEnd
      | exact Finset.Subset.refl _
      | apply head_append_sub)
  · simp only [basePacket,ECDSAAdd.Entrant.Rolling1588.basePacket,if_true,if_neg terminal]
    repeat (first
      | exact cOdd _
      | exact Finset.Subset.refl _
      | apply head_append_sub)

theorem routePacket_sub (j : Nat) :
    wires (packet true j)⊆wires (ECDSAAdd.Entrant.Rolling1588.packet true j) :=
  head_rename_sub _ _ _ (routeBasePacket_sub j)

/-- Every wire of the odd-word head is a wire of the record packets `1 .. 84`. -/
theorem oddHead_sub :
    wires oddHead⊆wires (ECDSAAdd.Entrant.Rolling1588.groups true 1 84) := by
  rw [record_head_split]
  exact head_append_sub _ _ _ _ (head_rename_sub _ _ _ (headFirstBase_sub 1))
    (head_append_sub _ _ _ _ (head_sequence_sub _ _ routePacket_sub 2 82)
