    · exact extra760 used
  have sets : ioWires∪wires witness=insert q (ioWires∪wires P) := by
    rw [ww,Finset.union_insert]
  change (ioWires∪wires witness).card≤1588 at bound
  rw [sets,Finset.card_insert_of_notMem fresh] at bound
