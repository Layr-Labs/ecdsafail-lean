    have c2 := pieces.2.2.2.2.2.1.trans rs
    simp only [OwnDiagLowK.kg,if_neg h,clearPrefix,OwnDiagLowK.kgS,wires_append,Finset.union_subset_iff]
    exact ⟨⟨⟨⟨⟨⟨smk,carry.1.1⟩,carry.1.2⟩,carry.2⟩,jc⟩,scl⟩,c2⟩

