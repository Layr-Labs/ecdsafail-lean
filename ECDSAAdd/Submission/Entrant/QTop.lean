  have newFree : ∀q∈[base 721,base 722],q∉wires (lastPhase isA) :=
    fun q hq=>last_hosts_free isA q (by
      simp only [phaseHosts,List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hq ⊢
