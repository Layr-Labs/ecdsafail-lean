  rw [CodexKnownOnesTail.program,wires_append,wires_append,notRegister_wires,
    old_add_wires low x y carry cin hx hc]
  ext q
  simp only [Finset.mem_union,List.mem_toFinset,List.mem_cons,List.mem_append]
