    have wa := KnownTopAdd.addInPlace_slots_eq (whiSrc L) (eReg L) (eBank L) L.core.cin l2.1 l2.2
    rw [eReg_length L hw] at wa
    simp only [wFoldTq, wRestoreT, wCoreK, wFold, wRestore, wFwdK, wInvK, wCoreTq, wCore, eAdd,
