    (delta : toffoliCount P+t=toffoliCount Q ∧ measurementCount P=measurementCount Q+m ∧
      gateSlots P≤gateSlots Q+sl) :
    toffoliCount HP+t=toffoliCount HQ ∧ measurementCount HP=measurementCount HQ+m ∧
