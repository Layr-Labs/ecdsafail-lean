def highWires (L : DecoderLayout) : List Wire :=
 [L.bias,L.Y 32,L.Y 33,L.Y 34,L.Y 35,L.Y 31,L.Y 30,L.Y 29,
 L.R 31,L.R 30,L.bias,L.sigma,L.h,L.bias,L.A 0]++(List.range' 32 4).map L.R
