    · exact junction_data_erased retired L hn (List.mem_of_mem_drop member) _ (by
        have h := bdata b bm; simp only [List.mem_append,List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at h ⊢; tauto)
