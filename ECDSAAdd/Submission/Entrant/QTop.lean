section Merge_StairCodecSweep_at_QTop

set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Arithmetic facts for the custom known-top carry-in adder. -/





/-! A circuit-independent statement of the descending Pack B sweep.  LT1 can
instantiate `d` and `s` with its private rail observations and combine the
step theorem with its private decoder transition lemmas. -/

structure SweepState where
  a : Nat
  z : Bool
  d : Nat → Bool
  s : Nat → Bool

def sweepMarker (w r : Nat) : Bool :=
  w.testBit (r - 1) && decide (w < 2 ^ r)

def halfBit (B v j : Nat) : Bool :=
  ((v - 1) / 2).testBit (B - 3 - j)

def trimmedBit (w j : Nat) : Bool :=
  if j + 1 = natBitLength w then false else w.testBit j

def payloadBit (B w v j : Nat) : Bool :=
  trimmedBit w j ^^ (if j < B - 2 then halfBit B v j else false)

def PackSweepInvariant (B u v : Nat) (sigma : Bool) (r : Nat)
    (st : SweepState) : Prop :=
  let w := u - sigma.toNat
  r ≤ B - 1 ∧
  st.z = decide (w < 2 ^ r) ∧
  st.a = (if r < natBitLength w then natBitLength w else 0) ∧
  (∀ i, i < B - 1 →
    st.d i = if i < r then w.testBit i else payloadBit B w v i) ∧
  (∀ i, i < B - 2 →
    st.s (B - 2 - i) = if i < r then halfBit B v i else false)

def packSweepStep (B r : Nat) (st : SweepState) : SweepState :=
  let j := r - 1
  let t := st.d j && st.z
  { a := if t then r else st.a
    z := st.z ^^ t
    d := fun i =>
      if i = j then
        st.d i ^^ t ^^ (if j < B - 2 then st.s (B - 2 - j) else false)
      else st.d i
    s := fun i =>
      if j < B - 2 && decide (i = B - 2 - j) then false else st.s i }

@[simp] theorem packSweepStep_a (B r : Nat) (st : SweepState) :
    (packSweepStep B r st).a =
      (if st.d (r - 1) && st.z then r else st.a) := by
  simp [packSweepStep]



theorem sweepMarker_eq (w r : Nat) (hr : 0 < r) :
    sweepMarker w r = decide (natBitLength w = r) := by
  by_cases hw : w = 0
  · subst w
    have hr0 : 0 ≠ r := by omega
    simp [sweepMarker, natBitLength, hr0]
  · have hr' : r - 1 + 1 = r := by omega
    by_cases heq : natBitLength w = r
    · have hlogeq : w.log2 = r - 1 := by
        simp only [natBitLength, hw, if_false] at heq
        omega
      have hbit : w.testBit (r - 1) = true := by
        simpa [hlogeq] using Nat.testBit_log2 hw
      have hpow : w < 2 ^ (w.log2 + 1) :=
        (Nat.log2_lt hw).mp (by omega)
      have hlt : w < 2 ^ r := by simpa [hlogeq, hr'] using hpow
      simp [sweepMarker, hbit, hlt, heq]
    · by_cases hlt : w < 2 ^ r
      · cases hbit : w.testBit (r - 1) with
        | false => simp [sweepMarker, hbit, hlt, heq]
        | true =>
            have hge : 2 ^ (r - 1) ≤ w := Nat.ge_two_pow_of_testBit hbit
            have hlogeq : w.log2 = r - 1 :=
              (Nat.log2_eq_iff hw).2 ⟨hge, by simpa [hr'] using hlt⟩
            have ha : natBitLength w = r := by
              simp [natBitLength, hw, hlogeq, hr']
            exact (heq ha).elim
      · simp [sweepMarker, hlt, heq]

theorem sweep_z_step (w r : Nat) (hr : 0 < r) :
    (decide (w < 2 ^ r) ^^ sweepMarker w r) = decide (w < 2 ^ (r - 1)) := by
  have hr' : r - 1 + 1 = r := by omega
  by_cases hlo : w < 2 ^ (r - 1)
  · have hpow : 2 ^ (r - 1) ≤ 2 ^ r :=
      Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (Nat.sub_le r 1)
    have hhi : w < 2 ^ r := lt_of_lt_of_le hlo hpow
    have hbit := Nat.testBit_lt_two_pow hlo
    simp [sweepMarker, hlo, hhi, hbit]
  · have hge : 2 ^ (r - 1) ≤ w := by omega
    by_cases hhi : w < 2 ^ r
    · have hbit : w.testBit (r - 1) = true :=
        Nat.testBit_of_two_pow_le_and_two_pow_add_one_gt hge
          (by simpa [hr'] using hhi)
      simp [sweepMarker, hlo, hhi, hbit]
    · simp [sweepMarker, hlo, hhi]

theorem sweep_a_step (w r : Nat) (hr : 0 < r) :
    (if sweepMarker w r then r
     else if r < natBitLength w then natBitLength w else 0) =
      (if r - 1 < natBitLength w then natBitLength w else 0) := by
  rw [sweepMarker_eq w r hr]
  by_cases heq : natBitLength w = r
  · simp [heq, hr]
  · by_cases hgt : r < natBitLength w
    · have hgt' : r - 1 < natBitLength w := by omega
      simp [heq, hgt, hgt']
    · have hgt' : ¬ r - 1 < natBitLength w := by omega
      simp [heq, hgt, hgt']

theorem sweep_trim_step (w r : Nat) (hr : 0 < r) :
    (w.testBit (r - 1) ^^ sweepMarker w r) = trimmedBit w (r - 1) := by
  have hr' : r - 1 + 1 = r := by omega
  by_cases heq : natBitLength w = r
  · have hm : sweepMarker w r = true := by
      rw [sweepMarker_eq w r hr]
      simp [heq]
    have hbit : w.testBit (r - 1) = true := by
      cases hb : w.testBit (r - 1) with
      | false => simp [sweepMarker, hb] at hm
      | true => rfl
    simp [trimmedBit, hr', heq, hm, hbit]
  · have hm : sweepMarker w r = false := by
      rw [sweepMarker_eq w r hr]
      simp [heq]
    have heq' : r ≠ natBitLength w := Ne.symm heq
    simp [trimmedBit, hr', heq', hm]




/-- All scalar equalities used by one descending Pack B step, including the
two measurement correction monomials. -/
theorem packSweep_arithmetic_step (B u v : Nat) (sigma : Bool) (r : Nat)
    (hd : CodecDomain B u v sigma) (hr : 0 < r) (hj : r - 1 < B - 2) :
    let w := u - sigma.toNat
    let t := sweepMarker w r
    ((decide (w < 2 ^ r) ^^ t) = decide (w < 2 ^ (r - 1))) ∧
    ((if t then r else if r < natBitLength w then natBitLength w else 0) =
      (if r - 1 < natBitLength w then natBitLength w else 0)) ∧
    ((w.testBit (r - 1) ^^ t) = trimmedBit w (r - 1)) ∧
    (halfBit B v (r - 1) =
      (payloadBit B w v (r - 1) && decide (w < 2 ^ r))) ∧
    (t = decide ((if t then r
      else if r < natBitLength w then natBitLength w else 0) = r)) := by
  dsimp only
  have hz := sweep_z_step (u - sigma.toNat) r hr
  have ha := sweep_a_step (u - sigma.toNat) r hr
  have htrim := sweep_trim_step (u - sigma.toNat) r hr
  have hfixS : halfBit B v (r - 1) =
      (payloadBit B (u - sigma.toNat) v (r - 1) &&
        decide (u - sigma.toNat < 2 ^ r)) := by
    by_cases hsmall : u - sigma.toNat < 2 ^ r
    · have htrimFalse : trimmedBit (u - sigma.toNat) (r - 1) = false := by
        rw [← htrim]
        cases hb : (u - sigma.toNat).testBit (r - 1) <;> simp [sweepMarker, hsmall, hb]
      simp [payloadBit, hj, hsmall, htrimFalse]
    · have hlarge : 2 ^ ((r - 1) + 1) ≤ u - sigma.toNat := by
        have : 2 ^ r ≤ u - sigma.toNat := by omega
        simpa [show r - 1 + 1 = r by omega] using this
      have hhalf := nonoverlap_half_zero B u v sigma (r - 1) hd hj hlarge
      have hhalf' : halfBit B v (r - 1) = false := by
        simpa only [halfBit] using hhalf
      simp [payloadBit, hj, hsmall, hhalf']
  have hfixT : sweepMarker (u - sigma.toNat) r =
      decide ((if sweepMarker (u - sigma.toNat) r then r
        else if r < natBitLength (u - sigma.toNat) then
          natBitLength (u - sigma.toNat) else 0) = r) := by
    rw [sweepMarker_eq (u - sigma.toNat) r hr]
    by_cases heq : natBitLength (u - sigma.toNat) = r
    · simp [heq]
    · by_cases hgt : r < natBitLength (u - sigma.toNat)
      · simp [heq, hgt]
      · have hr0 : 0 ≠ r := by omega
        simp [heq, hgt, hr0]
  exact ⟨hz, ha, htrim, hfixS, hfixT⟩








end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecSweep_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecUnsweep_at_QTop` -/
section Merge_StairCodecUnsweep_at_QTop

set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Circuit-independent semantics of the ascending sweep in `unpack`.  LT1's
private run lemmas can instantiate `d` and `s` with rail observations and use
the split-one-hot theorem below for the two decoder controls. -/

def splitDecoderMarker (lo value k : Nat) : Bool :=
  decide (k / 2 ^ lo = value / 2 ^ lo) &&
    decide (k % 2 ^ lo = value % 2 ^ lo)

/-- The product of the high- and low-half one-hot outputs selects exactly the
unsplit word. -/
theorem splitDecoderMarker_eq (lo value k : Nat) :
    splitDecoderMarker lo value k = decide (k = value) := by
  let p := 2 ^ lo
  have hp : 0 < p := by positivity
  by_cases hq : k / p = value / p
  · by_cases hr : k % p = value % p
    · have hk := Nat.mod_add_div k p
      have hv := Nat.mod_add_div value p
      have hkv : k = value := by
        calc
          k = k % p + p * (k / p) := hk.symm
          _ = value % p + p * (value / p) := by rw [hr, hq]
          _ = value := hv
      simp [splitDecoderMarker, p, hq, hr, hkv]
    · have hkv : k ≠ value := by
        intro h
        exact hr (congrArg (fun n => n % p) h)
      simp [splitDecoderMarker, p, hq, hr, hkv]
  · have hkv : k ≠ value := by
      intro h
      exact hq (congrArg (fun n => n / p) h)
    simp [splitDecoderMarker, p, hq, hkv]

def SplitOneHot (lo value : Nat) (low high : Nat → Bool) : Prop :=
  (∀ i, low i = decide (i = value % 2 ^ lo)) ∧
  (∀ i, high i = decide (i = value / 2 ^ lo))

/-- Public bridge from the two recursive one-hot output theorems to the CCX
control used at an unpack position. -/
theorem splitOneHot_selected (lo value k : Nat) (low high : Nat → Bool)
    (h : SplitOneHot lo value low high) :
    (high (k / 2 ^ lo) && low (k % 2 ^ lo)) = decide (k = value) := by
  rw [h.2, h.1]
  exact splitDecoderMarker_eq lo value k

















private theorem nat_lt_pow_natBitLength_unsweep (x : Nat) (hx : 0 < x) :
    x < 2 ^ natBitLength x := by
  have hlog : x.log2 < x.log2 + 1 := by omega
  have hpow := (Nat.log2_lt (by omega : x ≠ 0)).mp hlog
  simpa [natBitLength, ne_of_gt hx] using hpow

theorem domain_w_lt_top (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) : u - sigma.toNat < 2 ^ (B - 1) := by
  by_cases hu : u = 0
  · subst u
    simp
  · have hu0 : 0 < u := Nat.pos_of_ne_zero hu
    have hvl : 1 ≤ natBitLength v := by
      simp [natBitLength, ne_of_gt hd.2.1]
    have hul : natBitLength u ≤ B - 1 := by
      have := hd.2.2.2.2.1
      omega
    have hub := nat_lt_pow_natBitLength_unsweep u hu0
    have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hul
    exact lt_of_le_of_lt (Nat.sub_le u sigma.toNat) (lt_of_lt_of_le hub hp)

theorem domain_w_bitLength_le (B u v : Nat) (sigma : Bool)
    (hd : CodecDomain B u v sigma) :
    natBitLength (u - sigma.toNat) ≤ B - 1 := by
  by_cases hw : u - sigma.toNat = 0
  · simp [hw, natBitLength]
  · have hlog := (Nat.log2_lt hw).mpr (domain_w_lt_top B u v sigma hd)
    simp [natBitLength, hw]
    omega





end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecUnsweep_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecSpec_at_QTop` -/
section Merge_StairCodecSpec_at_QTop

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! Run-level integration of the generated codec with the public arithmetic
invariants.  This file is kept separate so the generator and its resource
proofs remain protected-import-only. -/









theorem nat_lt_pow_natBitLength_spec (x : Nat) (hx : 0 < x) :
    x < 2 ^ natBitLength x := by
  have hlog : x.log2 < x.log2 + 1 := by omega
  have hpow := (Nat.log2_lt (by omega : x ≠ 0)).mp hlog
  simpa [natBitLength, ne_of_gt hx] using hpow


def RealizesUnpackSweep (L : Layout) (B : Nat) (st : SweepState)
    (basis : BasisState) : Prop :=
  regValue (reg L.A (bitWidth B)) basis = st.a ∧
  basis L.z = st.z ∧ basis L.t = false ∧
  (∀ i, i < B - 1 → basis (L.D i) = st.d i) ∧
  (∀ i, i < B - 2 → basis (L.S (B - 2 - i)) = st.s (B - 2 - i)) ∧
  (∀ q ∈ (lowDecoder L B).sites, basis q =
    decoderBasis (lowDecoder L B) (lowBits L B)
      (st.a % 2 ^ (bitWidth B / 2)) q) ∧
  (∀ q ∈ (highDecoder L B).sites, basis q =
    decoderBasis (highDecoder L B) (highBits L B)
      (st.a / 2 ^ (bitWidth B / 2)) q)


def DecoderOneHotAt (d : Decoder) (value : Nat) (basis : BasisState) : Prop :=
  ∀ i, i < d.outputs.length →
    basis (d.outputs.getD i 0) = decide (i = value)

theorem run_basis_phase_irrelevant (p : Program) (hz : measurementCount p = 0)
    (m n : List Bool) (s t : State) (hb : s.basis = t.basis) :
    (run p m s).basis = (run p n t).basis := by
  induction p generalizing m n s t with
  | nil => exact hb
  | cons gate p ih =>
      cases gate <;> simp only [measurementCount, run] at hz ⊢
      · apply ih hz
        simp [hb]
      · apply ih hz
        simp [hb]
      · apply ih hz
        simp [hb]
      · omega


theorem cxInto_measurementCount (control : Wire) (targets : List Wire) :
    measurementCount (cxInto control targets) = 0 := by
  induction targets with
  | nil => rfl
  | cons q qs ih => simpa [cxInto, measurementCount] using ih

theorem oneHot_run_sites (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) (s : State) (m : List Bool)
    (x : Nat)
    (hbits : ∀ i, i < bits.length → s.basis (bits.getD i 0) = x.testBit i)
    (hclean : ∀ q ∈ (oneHot bits fresh).sites, s.basis q = false) :
    ∀ q ∈ (oneHot bits fresh).sites,
      (run (oneHot bits fresh).program m s).basis q =
        decoderBasis (oneHot bits fresh) bits x q := by
  let ideal : State := ⟨s.phase, registerBasis bits x⟩
  have hnBits : bits.Nodup := (List.nodup_append.mp hn).1
  have hagree : ∀ q ∈ (bits ++ (oneHot bits fresh).sites).toFinset,
      s.basis q = ideal.basis q := by
    intro q hq
    simp only [List.mem_toFinset, List.mem_append] at hq
    rcases hq with hbit | hsite
    · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hbit
      rw [← List.getD_eq_getElem bits 0 hi, hbits i hi]
      have hidx : bits.idxOf bits[i] = i := hnBits.idxOf_getElem i hi
      simp [ideal, registerBasis, hidx, hi]
    · rw [hclean q hsite]
      have hnot : q ∉ bits := by
        intro hbit
        exact (List.nodup_append.mp hn).2.2 q hbit q hsite rfl
      simp [ideal, registerBasis, List.idxOf_eq_length hnot]
  have hlocal := run_measured_locality (oneHot bits fresh).program
    (bits ++ (oneHot bits fresh).sites).toFinset
    (oneHot_program_support bits fresh) s ideal m rfl hagree
  have hphase :
      (run (oneHot bits fresh).program m ideal).basis =
        (run (oneHot bits fresh).program []
          ⟨false, registerBasis bits x⟩).basis := by
    apply run_basis_phase_irrelevant _ (oneHot_program_measurements bits fresh)
      m [] ideal ⟨false, registerBasis bits x⟩
    rfl
  intro q hq
  rw [hlocal.2 q (by simp [hq]), hphase]
  rfl

theorem oneHot_decoderBasis_output (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) (x : Nat)
    (hx : x < 2 ^ bits.length) :
    DecoderOneHotAt (oneHot bits fresh) x
      (decoderBasis (oneHot bits fresh) bits x) := by
  have hnBits : bits.Nodup := (List.nodup_append.mp hn).1
  have hbits : ∀ i, i < bits.length →
      registerBasis bits x (bits.getD i 0) = x.testBit i := by
    intro i hi
    rw [List.getD_eq_getElem _ _ hi]
    have hidx : bits.idxOf bits[i] = i := hnBits.idxOf_getElem i hi
    simp [registerBasis, hidx, hi]
  have hclean : ∀ q ∈ (oneHot bits fresh).sites,
      registerBasis bits x q = false := by
    intro q hq
    have hnot : q ∉ bits := by
      intro hbit
      exact (List.nodup_append.mp hn).2.2 q hbit q hq rfl
    simp [registerBasis, List.idxOf_eq_length hnot]
  have h := oneHot_run_output bits fresh hn
    ⟨false, registerBasis bits x⟩ [] x hx hbits hclean
  exact h.2.2

theorem oneHot_output_of_bits_sites (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) (x : Nat)
    (hx : x < 2 ^ bits.length) (basis : BasisState)
    (hbits : ∀ i, i < bits.length → basis (bits.getD i 0) = x.testBit i)
    (hsites : ∀ q ∈ (oneHot bits fresh).sites,
      basis q = decoderBasis (oneHot bits fresh) bits x q) :
    DecoderOneHotAt (oneHot bits fresh) x basis := by
  have hideal := oneHot_decoderBasis_output bits fresh hn x hx
  have hnBits : bits.Nodup := (List.nodup_append.mp hn).1
  have hregBits : ∀ i, i < bits.length →
      registerBasis bits x (bits.getD i 0) = x.testBit i := by
    intro i hi
    rw [List.getD_eq_getElem _ _ hi]
    have hidx : bits.idxOf bits[i] = i := hnBits.idxOf_getElem i hi
    simp [registerBasis, hidx, hi]
  have hregClean : ∀ q ∈ (oneHot bits fresh).sites,
      registerBasis bits x q = false := by
    intro q hq
    have hnot : q ∉ bits := by
      intro hbit
      exact (List.nodup_append.mp hn).2.2 q hbit q hq rfl
    simp [registerBasis, List.idxOf_eq_length hnot]
  have hrun := oneHot_run_output bits fresh hn
    ⟨false, registerBasis bits x⟩ [] x hx hregBits hregClean
  intro i hi
  let q := (oneHot bits fresh).outputs.getD i 0
  have hqOut : q ∈ (oneHot bits fresh).outputs := by
    dsimp only [q]
    rw [List.getD_eq_getElem _ _ hi]
    exact List.getElem_mem hi
  have hq := (oneHot_structural bits fresh).2.1 q hqOut
  have heq : basis q = decoderBasis (oneHot bits fresh) bits x q := by
    rcases List.mem_append.mp hq with hbit | hsite
    · obtain ⟨j, hj, hqeq⟩ := List.mem_iff_getElem.mp hbit
      rw [← hqeq]
      have hget : bits.getD j 0 = bits[j] := List.getD_eq_getElem _ _ hj
      have hnot : bits[j] ∉ (oneHot bits fresh).sites := by
        intro hsite
        exact (List.nodup_append.mp hn).2.2 bits[j]
          (List.getElem_mem hj) bits[j] hsite rfl
      calc
        basis bits[j] = x.testBit j := by rw [← hget]; exact hbits j hj
        _ = registerBasis bits x bits[j] := by rw [← hget]; exact (hregBits j hj).symm
        _ = decoderBasis (oneHot bits fresh) bits x bits[j] := by
          exact (hrun.2.1 bits[j] hnot).symm
    · exact hsites q hsite
  exact heq.trans (hideal i hi)



theorem regValue_getD_testBit (r : List Wire) (i : Nat) (fallback : Wire)
    (basis : BasisState) (hi : i < r.length) :
    basis (r.getD i fallback) = (regValue r basis).testBit i := by
  have h := regValue_bit r i fallback basis hi
  cases hb : basis (r.getD i fallback) <;>
    cases ht : (regValue r basis).testBit i <;>
    simp_all [Bool.toNat, Nat.testBit_eq_decide_div_mod_eq]

theorem lowBits_read (L : Layout) (B value i : Nat) (basis : BasisState)
    (hvalue : regValue (reg L.A (bitWidth B)) basis = value)
    (hi : i < (lowBits L B).length) :
    basis ((lowBits L B).getD i 0) = (value % 2 ^ (bitWidth B / 2)).testBit i := by
  have hiFull : i < (reg L.A (bitWidth B)).length := by
    simp only [lowBits, List.length_take, reg, List.length_map, List.length_range] at hi ⊢
    omega
  have hwire : (lowBits L B).getD i 0 = (reg L.A (bitWidth B)).getD i 0 := by
    rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hiFull]
    simp [lowBits]
  have hread := regValue_getD_testBit (reg L.A (bitWidth B)) i 0 basis hiFull
  rw [hwire, hread, hvalue]
  rw [Nat.testBit_mod_two_pow]
  have hilow : i < bitWidth B / 2 := by
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using hi
  simp [hilow]

theorem highBits_read (L : Layout) (B value i : Nat) (basis : BasisState)
    (hvalue : regValue (reg L.A (bitWidth B)) basis = value)
    (hi : i < (highBits L B).length) :
    basis ((highBits L B).getD i 0) = (value / 2 ^ (bitWidth B / 2)).testBit i := by
  let lo := bitWidth B / 2
  have hiFull : lo + i < (reg L.A (bitWidth B)).length := by
    simp only [highBits, List.length_drop, reg] at hi ⊢
    omega
  have hwire : (highBits L B).getD i 0 =
      (reg L.A (bitWidth B)).getD (lo + i) 0 := by
    rw [List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hiFull]
    simp [highBits, lo, Nat.add_comm]
  have hread := regValue_getD_testBit (reg L.A (bitWidth B)) (lo + i) 0 basis hiFull
  rw [hwire, hread, hvalue]
  simpa [lo, Nat.add_comm] using
    (Nat.testBit_div_two_pow (n := bitWidth B / 2) value i).symm

theorem lowDecoder_output (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hclean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false) :
    (run (lowDecoder L B).program m s).phase = s.phase ∧
    (∀ q, q ∉ (lowDecoder L B).sites →
      (run (lowDecoder L B).program m s).basis q = s.basis q) ∧
    DecoderOneHotAt (lowDecoder L B) (value % 2 ^ (bitWidth B / 2))
      (run (lowDecoder L B).program m s).basis := by
  have hx : value % 2 ^ (bitWidth B / 2) < 2 ^ (lowBits L B).length := by
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using
      Nat.mod_lt value hp
  have hbits : ∀ i, i < (lowBits L B).length →
      s.basis ((lowBits L B).getD i 0) =
        (value % 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact lowBits_read L B value i s.basis hvalue hi
  simpa [lowDecoder, DecoderOneHotAt] using
    oneHot_run_output (lowBits L B) L.lowWork (lowDecoder_nodup L B hn) s m
      (value % 2 ^ (bitWidth B / 2)) hx hbits hclean

theorem highDecoder_output (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hclean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false) :
    (run (highDecoder L B).program m s).phase = s.phase ∧
    (∀ q, q ∉ (highDecoder L B).sites →
      (run (highDecoder L B).program m s).basis q = s.basis q) ∧
    DecoderOneHotAt (highDecoder L B) (value / 2 ^ (bitWidth B / 2))
      (run (highDecoder L B).program m s).basis := by
  have hx : value / 2 ^ (bitWidth B / 2) < 2 ^ (highBits L B).length := by
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simp only [highBits, reg, List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul hp, ← pow_add]
    have hlo : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hlo, Nat.mul_comm] using hbound
  have hbits : ∀ i, i < (highBits L B).length →
      s.basis ((highBits L B).getD i 0) =
        (value / 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact highBits_read L B value i s.basis hvalue hi
  simpa [highDecoder, DecoderOneHotAt] using
    oneHot_run_output (highBits L B) L.highWork (highDecoder_nodup L B hn) s m
      (value / 2 ^ (bitWidth B / 2)) hx hbits hclean




def decoderValue (d : Decoder) (basis : BasisState) (i : Nat) : Bool :=
  if i < d.outputs.length then basis (outAt d i 0) else false

theorem decoderValue_eq (d : Decoder) (value : Nat) (basis : BasisState)
    (hvalue : DecoderOneHotAt d value basis) (hbound : value < d.outputs.length) :
    ∀ i, decoderValue d basis i = decide (i = value) := by
  intro i
  by_cases hi : i < d.outputs.length
  · simp only [decoderValue, hi, if_true, outAt]
    exact hvalue i hi
  · have hne : i ≠ value := by omega
    simp [decoderValue, hi, hne]

def PairDecoderOneHotAt (L : Layout) (B value : Nat) (basis : BasisState) : Prop :=
  SplitOneHot (bitWidth B / 2) value
    (decoderValue (lowDecoder L B) basis)
    (decoderValue (highDecoder L B) basis)

theorem pairDecoderOneHot_of_sites (L : Layout) (B value : Nat)
    (hn : L.Nodup B) (basis : BasisState)
    (hvalue : regValue (reg L.A (bitWidth B)) basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hlow : ∀ q ∈ (lowDecoder L B).sites, basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q)
    (hhigh : ∀ q ∈ (highDecoder L B).sites, basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) :
    PairDecoderOneHotAt L B value basis := by
  have hloBound : value % 2 ^ (bitWidth B / 2) <
      2 ^ (lowBits L B).length := by
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using
      Nat.mod_lt value hp
  have hhiBound : value / 2 ^ (bitWidth B / 2) <
      2 ^ (highBits L B).length := by
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simp only [highBits, reg, List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul hp, ← pow_add]
    have hloWidth : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hloWidth, Nat.mul_comm] using hbound
  have hloBits : ∀ i, i < (lowBits L B).length →
      basis ((lowBits L B).getD i 0) =
        (value % 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact lowBits_read L B value i basis hvalue hi
  have hhiBits : ∀ i, i < (highBits L B).length →
      basis ((highBits L B).getD i 0) =
        (value / 2 ^ (bitWidth B / 2)).testBit i := by
    intro i hi
    exact highBits_read L B value i basis hvalue hi
  have hloOne : DecoderOneHotAt (lowDecoder L B)
      (value % 2 ^ (bitWidth B / 2)) basis := by
    simpa [lowDecoder] using oneHot_output_of_bits_sites
      (lowBits L B) L.lowWork (lowDecoder_nodup L B hn)
      (value % 2 ^ (bitWidth B / 2)) hloBound basis hloBits (by
        simpa [lowDecoder] using hlow)
  have hhiOne : DecoderOneHotAt (highDecoder L B)
      (value / 2 ^ (bitWidth B / 2)) basis := by
    simpa [highDecoder] using oneHot_output_of_bits_sites
      (highBits L B) L.highWork (highDecoder_nodup L B hn)
      (value / 2 ^ (bitWidth B / 2)) hhiBound basis hhiBits (by
        simpa [highDecoder] using hhigh)
  have hloOutBound : value % 2 ^ (bitWidth B / 2) <
      (lowDecoder L B).outputs.length := by
    simpa [lowDecoder, oneHot_outputs_length] using hloBound
  have hhiOutBound : value / 2 ^ (bitWidth B / 2) <
      (highDecoder L B).outputs.length := by
    simpa [highDecoder, oneHot_outputs_length] using hhiBound
  exact ⟨decoderValue_eq _ _ _ hloOne hloOutBound,
    decoderValue_eq _ _ _ hhiOne hhiOutBound⟩

theorem pairDecoder_selected_of_sites (L : Layout) (B value k : Nat)
    (hn : L.Nodup B) (basis : BasisState)
    (hvalue : regValue (reg L.A (bitWidth B)) basis = value)
    (hvalueBound : value < 2 ^ bitWidth B) (hk : k < 2 ^ bitWidth B)
    (hlow : ∀ q ∈ (lowDecoder L B).sites, basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (value % 2 ^ (bitWidth B / 2)) q)
    (hhigh : ∀ q ∈ (highDecoder L B).sites, basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (value / 2 ^ (bitWidth B / 2)) q) :
    (basis (outAt (highDecoder L B) (k / 2 ^ (bitWidth B / 2)) L.z) &&
      basis (outAt (lowDecoder L B) (k % 2 ^ (bitWidth B / 2)) L.z)) =
        decide (k = value) := by
  have hp := pairDecoderOneHot_of_sites L B value hn basis hvalue hvalueBound hlow hhigh
  have hs := splitOneHot_selected (bitWidth B / 2) value k
    (decoderValue (lowDecoder L B) basis)
    (decoderValue (highDecoder L B) basis) hp
  have hlo : k % 2 ^ (bitWidth B / 2) < (lowDecoder L B).outputs.length := by
    rw [lowDecoder, oneHot_outputs_length]
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using
      Nat.mod_lt k hp
  have hhi : k / 2 ^ (bitWidth B / 2) < (highDecoder L B).outputs.length := by
    rw [highDecoder, oneHot_outputs_length]
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simp only [highBits, reg, List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul hp, ← pow_add]
    have hloWidth : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hloWidth, Nat.mul_comm] using hk
  simpa [decoderValue, hlo, hhi, outAt, List.getD_eq_getElem] using hs















/-- Running the two generated halves in sequence gives the split one-hot word
used by every unpack-step decoder product. -/
theorem decoderPair_output (L : Layout) (B value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value)
    (hbound : value < 2 ^ bitWidth B)
    (hlClean : ∀ q ∈ (lowDecoder L B).sites, s.basis q = false)
    (hhClean : ∀ q ∈ (highDecoder L B).sites, s.basis q = false) :
    let lowState := run (lowDecoder L B).program m s
    let out := run (highDecoder L B).program m lowState
    out.phase = s.phase ∧ PairDecoderOneHotAt L B value out.basis ∧
      (∀ q, q ∉ (lowDecoder L B).sites → q ∉ (highDecoder L B).sites →
        out.basis q = s.basis q) := by
  let lowState := run (lowDecoder L B).program m s
  have hlo := lowDecoder_output L B value hn s m hvalue hbound hlClean
  have hAFrame : ∀ q ∈ reg L.A (bitWidth B), lowState.basis q = s.basis q := by
    intro q hq
    apply hlo.2.1 q
    intro hsite
    exact sep_A_rest L B hn hq (by simp [hsite]) rfl
  have hAValue : regValue (reg L.A (bitWidth B)) lowState.basis = value := by
    exact (regValue_congr _ _ _ hAFrame).trans hvalue
  have hhClean' : ∀ q ∈ (highDecoder L B).sites, lowState.basis q = false := by
    intro q hq
    rw [hlo.2.1 q]
    · exact hhClean q hq
    · intro hlq
      exact sep_low_high L B hn hlq hq rfl
  have hhi := highDecoder_output L B value hn lowState m hAValue hbound hhClean'
  let out := run (highDecoder L B).program m lowState
  have lowBound : value % 2 ^ (bitWidth B / 2) <
      (lowDecoder L B).outputs.length := by
    rw [lowDecoder, oneHot_outputs_length]
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simpa [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)] using
      Nat.mod_lt value hp
  have highBound : value / 2 ^ (bitWidth B / 2) <
      (highDecoder L B).outputs.length := by
    rw [highDecoder, oneHot_outputs_length]
    have hp : 0 < 2 ^ (bitWidth B / 2) := by positivity
    simp only [highBits, reg, List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul hp, ← pow_add]
    have hloWidth : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hloWidth, Nat.mul_comm] using hbound
  have hlowFinal : DecoderOneHotAt (lowDecoder L B)
      (value % 2 ^ (bitWidth B / 2)) out.basis := by
    intro i hi
    rw [hhi.2.1]
    · exact hlo.2.2 i hi
    · intro hsite
      have hmem : (lowDecoder L B).outputs.getD i 0 ∈
          (lowDecoder L B).outputs := by
        rw [List.getD_eq_getElem _ _ hi]
        exact List.getElem_mem hi
      have houtMem := (oneHot_structural (lowBits L B) L.lowWork).2.1
        ((lowDecoder L B).outputs.getD i 0) (by simpa [lowDecoder] using hmem)
      simp only [lowDecoder] at houtMem
      rcases List.mem_append.mp houtMem with hbit | hlow
      · have hA := List.mem_of_mem_take hbit
        have hsite' : (oneHot (lowBits L B) L.lowWork).outputs.getD i 0 ∈
            (highDecoder L B).sites := by simpa [lowDecoder] using hsite
        exact sep_A_rest L B hn hA (by
          simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
          exact Or.inr hsite') rfl
      · exact sep_low_high L B hn hlow hsite rfl
  refine ⟨hhi.1.trans hlo.1, ?_, ?_⟩
  · constructor
    · exact decoderValue_eq _ _ _ hlowFinal lowBound
    · exact decoderValue_eq _ _ _ hhi.2.2 highBound
  · intro q hlq hhq
    exact (hhi.2.1 q hhq).trans (hlo.2.1 q hlq)









/-! The shortened unpack adder is most convenient to expose recursively.  A
`fuel` of `n` allocates carries at positions `j, ..., j+n-1`; the terminal
position `j+n` writes its outgoing carry directly into the following S bit. -/

































theorem decoderInit_clear_full (d : Decoder) (bits : List Wire)
    (hsites : d.sites.Nodup) (s : State) (m : List Bool)
    (hcurrent : ∀ q ∈ d.sites, s.basis q = decoderBasis d bits 0 q) :
    let out := run (decoderInit d bits) m s
    out.phase = s.phase ∧
    (∀ q ∈ d.sites, out.basis q = false) ∧
    (∀ q ∉ d.sites, out.basis q = s.basis q) := by
  have htrue : (decoderTrue d bits 0).Nodup := hsites.filter _
  rw [decoderInit, xOn_run _ htrue]
  refine ⟨rfl, ?_, ?_⟩
  · intro q hq
    have hcur := hcurrent q hq
    cases hb : decoderBasis d bits 0 q <;> simp_all [decoderTrue]
  · intro q hq
    simp [decoderTrue, hq]











end ECDSAAdd.Entrant.StairCodec
end Merge_StairCodecSpec_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairBridgeSign_at_QTop` -/
section Merge_StairBridgeSign_at_QTop

/-!
# Signed codec-to-walk rail extension

The compact codec stores two `B`-bit rails.  A compact Skywalk tick consumes
signed `(B+1)`-bit rails.  The sum rail has a clean zero extension; the signed
difference rail needs one physical CX from its retained sign bit.  The same CX
clears that extension before packing in the opposite direction.
-/

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairBridgeSign

open ECDSAAdd Arithmetic RecordedQuantum

/-- The missing sign-extension step.  It is its own inverse. -/
def signExtend (sign extension : Wire) : Program := [.CX sign extension]


theorem signExtend_support (sign extension : Wire) :
    wires (signExtend sign extension) = [sign, extension].toFinset := by
  simp [signExtend, wires, Instr.wires]


/-- Exact run semantics, including the full outside frame. -/
theorem signExtend_run (sign extension : Wire) (s : State) (m : List Bool) :
    (run (signExtend sign extension) m s).phase = s.phase ∧
      (run (signExtend sign extension) m s).basis extension =
        (s.basis extension ^^ s.basis sign) ∧
      (∀ q, q ≠ extension →
        (run (signExtend sign extension) m s).basis q = s.basis q) := by
  refine ⟨rfl, ?_, ?_⟩
  · simp [signExtend, run, writeBit]
  · intro q hq
    simp [signExtend, run, writeBit, hq]




end ECDSAAdd.Entrant.StairBridgeSign
end Merge_StairBridgeSign_at_QTop

/-! ### merged from `ECDSAAdd.Submission.Entrant.StairCodecPackA_at_QTop` -/
section Merge_StairCodecPackA_at_QTop

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

namespace ECDSAAdd.Entrant.StairCodec.PackA

open ECDSAAdd Arithmetic
open Arithmetic.RecordedRailCarry Arithmetic.RecordedRailRipple

/-! Run-level correctness of the forward checkpoint codec.  The first part
exposes the private known-top ripple ladder through a public, structurally
identical program and proves its exact frame. -/

def aMask (L : Layout) (B k : Nat) : List Wire :=
  ((List.range (bitWidth B)).filter (fun i => k.testBit i)).map L.A

theorem A_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.A (bitWidth B)).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have hall := List.nodup_iff_count.mp hn q
  simp only [Layout.Nodup, declaredSites, workSites, reg,
    List.count_append] at hall ⊢
  omega

theorem aMask_nodup (L : Layout) (B k : Nat) (hn : L.Nodup B) :
    (aMask L B k).Nodup := by
  have hreg := A_nodup L B hn
  exact hreg.sublist (by
    simpa only [aMask, reg] using
      (List.filter_sublist.map L.A : List.Sublist
        (((List.range (bitWidth B)).filter (fun i => k.testBit i)).map L.A)
        ((List.range (bitWidth B)).map L.A)))

theorem aMask_mem (L : Layout) (B k i : Nat) (hn : L.Nodup B)
    (hi : i < bitWidth B) :
    L.A i ∈ aMask L B k ↔ k.testBit i = true := by
  constructor
  · intro hm
    simp only [aMask, List.mem_map, List.mem_filter, List.mem_range] at hm
    rcases hm with ⟨j, ⟨hj, hbit⟩, heq⟩
    have hji : j = i := by
      apply List.inj_on_of_nodup_map (by simpa [reg] using A_nodup L B hn)
      · exact List.mem_range.mpr hj
      · exact List.mem_range.mpr hi
      · exact heq
    simpa [hji] using hbit
  · intro hbit
    simp only [aMask, List.mem_map, List.mem_filter, List.mem_range]
    exact ⟨i, ⟨hi, hbit⟩, rfl⟩

theorem t_not_aMask (L : Layout) (B k : Nat) (hn : L.Nodup B) :
    L.t ∉ aMask L B k := by
  intro hm
  simp only [aMask, List.mem_map, List.mem_filter, List.mem_range] at hm
  rcases hm with ⟨i, ⟨hi, _⟩, heq⟩
  have hA : L.A i ∈ reg L.A (bitWidth B) := reg_mem L.A _ i hi
  exact (sep_A_rest L B hn hA (by simp)) heq

theorem run_aMask_value (L : Layout) (B k value : Nat) (hn : L.Nodup B)
    (s : State) (m : List Bool)
    (hk : k < 2 ^ bitWidth B)
    (hvalue : regValue (reg L.A (bitWidth B)) s.basis = value) :
    let out := run (cxInto L.t (aMask L B k)) m s
    out.phase = s.phase ∧
    regValue (reg L.A (bitWidth B)) out.basis =
      (if s.basis L.t then value ^^^ k else value) ∧
    (∀ q, q ∉ aMask L B k → out.basis q = s.basis q) := by
  let out := run (cxInto L.t (aMask L B k)) m s
  rw [cxInto_run L.t (aMask L B k) (aMask_nodup L B k hn)
    (t_not_aMask L B k hn)]
  refine ⟨rfl, ?_, ?_⟩
  · subst out
    split
    next ht =>
      rw [← hvalue]
      apply Nat.eq_of_testBit_eq
      intro i
      by_cases hi : i < bitWidth B
      · have hget : (reg L.A (bitWidth B)).getD i 0 = L.A i := by
          rw [List.getD_eq_getElem _ _ (by simpa [reg] using hi)]
          simp [reg]
        have houtBit := regValue_getD_testBit (reg L.A (bitWidth B)) i 0
          (fun q => if s.basis L.t && decide (q ∈ aMask L B k) then !s.basis q
            else s.basis q) (by simpa [reg] using hi)
        have hinBit := regValue_getD_testBit (reg L.A (bitWidth B)) i 0
          s.basis (by simpa [reg] using hi)
        rw [← houtBit, Nat.testBit_xor, ← hinBit, hget]
        have hm := aMask_mem L B k i hn hi
        cases hb : s.basis (L.A i) <;> cases hkbit : k.testBit i <;>
          simp [ht, hb, hkbit, hm]
      · have houtBound := regValue_lt (reg L.A (bitWidth B))
          (fun q => if s.basis L.t && decide (q ∈ aMask L B k) then !s.basis q
            else s.basis q)
        have hinBound := regValue_lt (reg L.A (bitWidth B)) s.basis
        have hxoBound : regValue (reg L.A (bitWidth B)) s.basis ^^^ k <
            2 ^ bitWidth B := Nat.xor_lt_two_pow (by simpa [reg] using hinBound) hk
        have hp : 2 ^ bitWidth B ≤ 2 ^ i :=
          Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (by omega)
        rw [Nat.testBit_lt_two_pow
          (lt_of_lt_of_le (by simpa [reg] using houtBound) hp)]
        rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le hxoBound hp)]
    next ht =>
      have ht' : s.basis L.t = false := by
        cases h : s.basis L.t <;> simp_all
      exact (regValue_congr _ _ _ (by
        intro q hq
        simp [ht'])).trans hvalue
  · intro q hq
    simp [hq]
























def xOnA (targets : List Wire) : Program := targets.map Instr.X


theorem xOn_frameA (r : List Wire) (hn : r.Nodup)
    (s : State) (m : List Bool) :
    let out := run (xOnA r) m s
    out.phase = s.phase ∧
      regValue r out.basis = 2 ^ r.length - 1 - regValue r s.basis ∧
      (∀ q, q ∉ r → out.basis q = s.basis q) := by
  dsimp only
  have hx := xOn_run r hn s m
  change run (xOnA r) m s = _ at hx
  rw [hx]
  refine ⟨rfl, ?_, ?_⟩
  · change regValue r (fun q => if q ∈ r then !s.basis q else s.basis q) = _
    rw [regValue_congr r _ (fun q => !s.basis q) (by
      intro q hq
      simp [hq]), regValue_complement]
  · intro q hq
    simp [hq]











/-! Circuit-independent descending-sweep induction. -/

theorem packSweep_marker_eqA (B u v r : Nat) (sigma : Bool)
    (st : SweepState) (hinv : PackSweepInvariant B u v sigma r st)
    (hr : 0 < r) :
    (st.d (r - 1) && st.z) = sweepMarker (u - sigma.toNat) r := by
  change r ≤ B - 1 ∧
    st.z = decide (u - sigma.toNat < 2 ^ r) ∧
    st.a = (if r < natBitLength (u - sigma.toNat) then
      natBitLength (u - sigma.toNat) else 0) ∧
    (∀ i, i < B - 1 → st.d i = if i < r then
      (u - sigma.toNat).testBit i
      else payloadBit B (u - sigma.toNat) v i) ∧ _ at hinv
  rw [hinv.2.2.2.1 (r - 1) (by omega), if_pos (by omega), hinv.2.1]
  rfl

theorem packSweep_marker_forces_zero_aA (B u v r : Nat) (sigma : Bool)
    (st : SweepState) (hinv : PackSweepInvariant B u v sigma r st)
    (hr : 0 < r)
    (hmarker : (st.d (r - 1) && st.z) = true) : st.a = 0 := by
  have hm := packSweep_marker_eqA B u v r sigma st hinv hr
  rw [hm, sweepMarker_eq (u - sigma.toNat) r hr] at hmarker
  have hlen : natBitLength (u - sigma.toNat) = r := by simpa using hmarker
  change r ≤ B - 1 ∧
    st.z = decide (u - sigma.toNat < 2 ^ r) ∧
    st.a = (if r < natBitLength (u - sigma.toNat) then
      natBitLength (u - sigma.toNat) else 0) ∧ _ at hinv
  rw [hinv.2.2.1, hlen]
  simp

theorem packSweepStep_invariantA (B u v r : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (st : SweepState)
    (hr : 0 < r) (hinv : PackSweepInvariant B u v sigma r st) :
    PackSweepInvariant B u v sigma (r - 1) (packSweepStep B r st) := by
  let w := u - sigma.toNat
  let j := r - 1
  have hjr : j < r := by simp [j]; omega
  change r ≤ B - 1 ∧ st.z = decide (w < 2 ^ r) ∧
    st.a = (if r < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 →
      st.d i = if i < r then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 → st.s (B - 2 - i) =
      if i < r then halfBit B v i else false) at hinv
  rcases hinv with ⟨hrange, hz, ha, hd, hs⟩
  have hmarker : (st.d j && st.z) = sweepMarker w r := by
    rw [hd j (by omega), if_pos hjr, hz]
    rfl
  have hzStep := sweep_z_step w r hr
  have haStep := sweep_a_step w r hr
  change r - 1 ≤ B - 1 ∧
    (packSweepStep B r st).z = decide (w < 2 ^ (r - 1)) ∧
    (packSweepStep B r st).a =
      (if r - 1 < natBitLength w then natBitLength w else 0) ∧
    (∀ i, i < B - 1 → (packSweepStep B r st).d i =
      if i < r - 1 then w.testBit i else payloadBit B w v i) ∧
    (∀ i, i < B - 2 → (packSweepStep B r st).s (B - 2 - i) =
      if i < r - 1 then halfBit B v i else false)
  refine ⟨by omega, ?_, ?_, ?_, ?_⟩
  · change (st.z ^^ (st.d j && st.z)) = decide (w < 2 ^ (r - 1))
    rw [hmarker, hz]
    exact hzStep
  · rw [packSweepStep_a, hmarker, ha]
    exact haStep
  · intro i hi
    by_cases hij : i = j
    · subst i
      simp only [packSweepStep]
      rw [if_pos rfl]
      rw [hmarker, hd j (by omega), if_pos hjr]
      rw [if_neg (by omega : ¬j < r - 1)]
      by_cases hj : j < B - 2
      · rw [if_pos hj, hs j hj, if_pos hjr]
        simp only [payloadBit]
        rw [sweep_trim_step w r hr]
        simp [j, hj]
      · rw [if_neg hj]
        simp only [payloadBit, hj, if_false, Bool.xor_false]
        exact sweep_trim_step w r hr
    · simp only [packSweepStep]
      rw [if_neg hij, hd i hi]
      have hthreshold : i < r ↔ i < r - 1 := by
        constructor <;> omega
      by_cases hir : i < r
      · rw [if_pos hir, if_pos (hthreshold.mp hir)]
      · rw [if_neg hir, if_neg (fun h => hir (hthreshold.mpr h))]
  · intro i hi
    by_cases hij : i = j
    · subst i
      have hj : j < B - 2 := hi
      simp [packSweepStep, hj, j]
    · have hmirror : B - 2 - i ≠ B - 2 - j := by omega
      change (if j < B - 2 && decide (B - 2 - i = B - 2 - j)
        then false else st.s (B - 2 - i)) = _
      rw [show (j < B - 2 && decide (B - 2 - i = B - 2 - j)) = false by
        simp [hmirror], hs i hi]
      have hthreshold : i < r ↔ i < r - 1 := by
        constructor <;> omega
      by_cases hir : i < r
      · rw [if_pos hir, if_pos (hthreshold.mp hir)]
        simp
      · rw [if_neg hir, if_neg (fun h => hir (hthreshold.mpr h))]
        simp


theorem decoderDelta_run_forward_selectedA (d : Decoder) (bits : List Wire)
    (current x : Nat) (control : Wire) (hsites : d.sites.Nodup)
    (hc : control ∉ d.sites) (s : State) (m : List Bool)
    (hcurrent : ∀ q ∈ d.sites,
      s.basis q = decoderBasis d bits current q)
    (hselected : s.basis control = true → current = 0) :
    (run (cxInto control (decoderDelta d bits x)) m s).phase = s.phase ∧
    (∀ q ∈ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        decoderBasis d bits (if s.basis control then x else current) q) ∧
    (∀ q ∉ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        s.basis q) := by
  cases hctrl : s.basis control
  · have hdelta : (decoderDelta d bits x).Nodup := hsites.filter _
    have hc' : control ∉ decoderDelta d bits x := by
      intro hm
      exact hc (List.mem_of_mem_filter hm)
    rw [cxInto_run control _ hdelta hc']
    refine ⟨rfl, ?_, ?_⟩
    · intro q hq
      simpa [hctrl] using hcurrent q hq
    · intro q hq
      simp [hctrl]
  · have hzero := hselected hctrl
    subst current
    simpa [hctrl] using decoderDelta_run d bits x control hsites hc
      s m hctrl hcurrent

def RealizesPackFrontA (L : Layout) (B : Nat) (st next : SweepState)
    (marker : Bool) (basis : BasisState) : Prop :=
  regValue (reg L.A (bitWidth B)) basis = next.a ∧
  basis L.z = st.z ∧ basis L.t = marker ∧
  (∀ i, i < B - 1 → basis (L.D i) = st.d i) ∧
  (∀ i, i < B - 2 → basis (L.S (B - 2 - i)) = st.s (B - 2 - i)) ∧
  (∀ q ∈ (lowDecoder L B).sites, basis q =
    decoderBasis (lowDecoder L B) (lowBits L B)
      (next.a % 2 ^ (bitWidth B / 2)) q) ∧
  (∀ q ∈ (highDecoder L B).sites, basis q =
    decoderBasis (highDecoder L B) (highBits L B)
      (next.a / 2 ^ (bitWidth B / 2)) q)

def packStepFrontA (L : Layout) (B r : Nat) : Program :=
  let j := r - 1
  [.CCX (L.D j) L.z L.t] ++
    cxInto L.t (aMask L B r) ++
    cxInto L.t (decoderDelta (lowDecoder L B) (lowBits L B)
      (r % 2 ^ (bitWidth B / 2))) ++
    cxInto L.t (decoderDelta (highDecoder L B) (highBits L B)
      (r / 2 ^ (bitWidth B / 2)))

theorem packStepFront_correctA (L : Layout) (B u v r : Nat) (sigma : Bool)
    (hn : L.Nodup B) (hr : 0 < r) (hrB : r ≤ B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma r st)
    (hreal : RealizesUnpackSweep L B st s.basis) :
    let marker := st.d (r - 1) && st.z
    let next := packSweepStep B r st
    let out := run (packStepFrontA L B r) m s
    out.phase = s.phase ∧
      RealizesPackFrontA L B st next marker out.basis := by
  let j := r - 1
  let marker := st.d j && st.z
  let next := packSweepStep B r st
  let p0 : Program := [.CCX (L.D j) L.z L.t]
  let pA := cxInto L.t (aMask L B r)
  let pLow := cxInto L.t (decoderDelta (lowDecoder L B) (lowBits L B)
    (r % 2 ^ (bitWidth B / 2)))
  let pHigh := cxInto L.t (decoderDelta (highDecoder L B) (highBits L B)
    (r / 2 ^ (bitWidth B / 2)))
  let s0 := run p0 [] s
  let sA := run pA [] s0
  let sLow := run pLow [] sA
  let out := run pHigh m sLow
  rcases hreal with ⟨ha, hz, ht, hdrail, hsrail, hlow, hhigh⟩
  have hDj : s.basis (L.D j) = st.d j := hdrail j (by omega)
  have hDmem : L.D j ∈ reg L.D B := reg_mem L.D B j (by omega)
  have hDt : L.D j ≠ L.t := sep_D_work L B hn hDmem (by simp [workSites])
  have hDz : L.D j ≠ L.z := sep_D_work L B hn hDmem (by simp [workSites])
  have hzt := sep_z_t L B hn
  have hs0Phase : s0.phase = s.phase := rfl
  have hs0t : s0.basis L.t = marker := by
    simp [s0, p0, run, writeBit, Function.update, ht, hDj, hz, marker,
      hDt, hDz, hzt, Ne.symm hDt, Ne.symm hDz, Ne.symm hzt]
  have hs0Frame : ∀ q, q ≠ L.t → s0.basis q = s.basis q := by
    intro q hq
    simp [s0, p0, run, writeBit, Function.update, hq]
  have hrPow : r < 2 ^ bitWidth B :=
    lt_of_lt_of_le (by omega : r < B) (bitWidth_bound B (by omega))
  have hmarkerZero : marker = true → st.a = 0 := by
    intro hm
    apply packSweep_marker_forces_zero_aA B u v r sigma st hinv hr
    simpa only [marker, j] using hm
  have hA := run_aMask_value L B r st.a hn s0 [] hrPow (by
    rw [regValue_congr (reg L.A (bitWidth B)) s0.basis s.basis]
    · exact ha
    · intro q hq
      apply hs0Frame q
      intro heq
      subst q
      exact sep_A_rest L B hn hq (by simp [workSites]) rfl)
  change sA.phase = s0.phase ∧
    regValue (reg L.A (bitWidth B)) sA.basis =
      (if s0.basis L.t then st.a ^^^ r else st.a) ∧
    (∀ q, q ∉ aMask L B r → sA.basis q = s0.basis q) at hA
  have hnextA : next.a = if marker then r else st.a := by
    simp [next, packSweepStep, j, marker]
  have hsAa : regValue (reg L.A (bitWidth B)) sA.basis = next.a := by
    rw [hA.2.1, hs0t, hnextA]
    cases hm : marker
    · simp [hm]
    · have hzA := hmarkerZero hm
      simp [hm, hzA]
  have htNotMask := t_not_aMask L B r hn
  have hsAt : sA.basis L.t = marker :=
    (hA.2.2 L.t htNotMask).trans hs0t
  have hLowCurrent : ∀ q ∈ (lowDecoder L B).sites, sA.basis q =
      decoderBasis (lowDecoder L B) (lowBits L B)
        (st.a % 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hA.2.2 q]
    · rw [hs0Frame q]
      · exact hlow q hq
      · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
          (List.mem_append_left (highDecoder L B).sites hq))
    · intro hm
      simp only [aMask, List.mem_map] at hm
      rcases hm with ⟨i, hi, rfl⟩
      have hAi : L.A i ∈ reg L.A (bitWidth B) :=
        reg_mem L.A _ i (List.mem_range.mp (List.mem_filter.mp hi).1)
      exact sep_A_rest L B hn hAi (by simp [workSites, hq]) rfl
  have htLow : L.t ∉ (lowDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hq) rfl
  have hLowSelected : sA.basis L.t = true →
      st.a % 2 ^ (bitWidth B / 2) = 0 := by
    intro hm
    have hm' : marker = true := hsAt.symm.trans hm
    simp [hmarkerZero hm']
  have hLow := decoderDelta_run_forward_selectedA
    (lowDecoder L B) (lowBits L B)
    (st.a % 2 ^ (bitWidth B / 2))
    (r % 2 ^ (bitWidth B / 2)) L.t
    (List.nodup_append.mp (lowDecoder_nodup L B hn)).2.1 htLow
    sA [] hLowCurrent hLowSelected
  change sLow.phase = sA.phase ∧ _ at hLow
  have hsLowt : sLow.basis L.t = marker :=
    (hLow.2.2 L.t htLow).trans hsAt
  have hHighCurrent : ∀ q ∈ (highDecoder L B).sites, sLow.basis q =
      decoderBasis (highDecoder L B) (highBits L B)
        (st.a / 2 ^ (bitWidth B / 2)) q := by
    intro q hq
    rw [hLow.2.2 q]
    · rw [hA.2.2 q]
      · rw [hs0Frame q]
        · exact hhigh q hq
        · exact Ne.symm (sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right (lowDecoder L B).sites hq))
      · intro hm
        simp only [aMask, List.mem_map] at hm
        rcases hm with ⟨i, hi, rfl⟩
        have hAi : L.A i ∈ reg L.A (bitWidth B) :=
          reg_mem L.A _ i (List.mem_range.mp (List.mem_filter.mp hi).1)
        exact sep_A_rest L B hn hAi (by simp [workSites, hq]) rfl
    · intro hlq
      exact sep_low_high L B hn hlq hq rfl
  have htHigh : L.t ∉ (highDecoder L B).sites := by
    intro hq
    exact sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hq) rfl
  have hHighSelected : sLow.basis L.t = true →
      st.a / 2 ^ (bitWidth B / 2) = 0 := by
    intro hm
    have hm' : marker = true := hsLowt.symm.trans hm
    simp [hmarkerZero hm']
  have hHigh := decoderDelta_run_forward_selectedA
    (highDecoder L B) (highBits L B)
    (st.a / 2 ^ (bitWidth B / 2))
    (r / 2 ^ (bitWidth B / 2)) L.t
    (List.nodup_append.mp (highDecoder_nodup L B hn)).2.1 htHigh
    sLow m hHighCurrent hHighSelected
  change out.phase = sLow.phase ∧ _ at hHigh
  have hrun : run (packStepFrontA L B r) m s = out := by
    have hp0 : measurementCount p0 = 0 := by simp [p0, measurementCount]
    have hpA : measurementCount pA = 0 := by
      simp [pA, cxInto_measurementCount]
    have hpLow : measurementCount pLow = 0 := by
      simp [pLow, cxInto_measurementCount]
    simp only [packStepFrontA, j, p0, pA, pLow, pHigh, s0, sA, sLow,
      out, run_append, measurementCount_append, hp0, hpA, hpLow,
      List.take_zero, List.drop_zero, zero_add]
  rw [hrun]
  refine ⟨hHigh.1.trans (hLow.1.trans (hA.1.trans hs0Phase)), ?_⟩
  change RealizesPackFrontA L B st next marker out.basis
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [regValue_congr (reg L.A (bitWidth B)) out.basis sA.basis]
    · exact hsAa
    · intro q hq
      rw [hHigh.2.2 q, hLow.2.2 q]
      · intro hm
        exact sep_A_rest L B hn hq (by simp [hm]) rfl
      · intro hm
        exact sep_A_rest L B hn hq (by simp [hm]) rfl
  · rw [hHigh.2.2 L.z, hLow.2.2 L.z, hA.2.2 L.z, hs0Frame L.z]
    · exact hz
    · exact sep_z_t L B hn
    · intro hm
      simp only [aMask, List.mem_map] at hm
      rcases hm with ⟨i, hi, heq⟩
      exact sep_A_rest L B hn
        (reg_mem L.A _ i (List.mem_range.mp (List.mem_filter.mp hi).1))
        (by simp [workSites]) heq
    · intro hq
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_left (highDecoder L B).sites hq) rfl
    · intro hq
      exact sep_ZT_decoders L B hn (by simp)
        (List.mem_append_right (lowDecoder L B).sites hq) rfl
  · exact (hHigh.2.2 L.t htHigh).trans hsLowt
  · intro i hi
    rw [hHigh.2.2 _, hLow.2.2 _, hA.2.2 _, hs0Frame _]
    · exact hdrail i hi
    · exact sep_D_work L B hn (reg_mem L.D B i (by omega))
        (by simp [workSites])
    · intro hm
      simp only [aMask, List.mem_map] at hm
      rcases hm with ⟨a, ha', heq⟩
      exact sep_D_work L B hn (reg_mem L.D B i (by omega))
        (by simp [workSites, reg_mem L.A _ a
          (List.mem_range.mp (List.mem_filter.mp ha').1)]) heq.symm
    · intro hq
      exact sep_D_work L B hn (reg_mem L.D B i (by omega))
        (by simp [workSites, hq]) rfl
    · intro hq
      exact sep_D_work L B hn (reg_mem L.D B i (by omega))
        (by simp [workSites, hq]) rfl
  · intro i hi
    let q := L.S (B - 2 - i)
    have hSmem : q ∈ reg L.S B := reg_mem L.S B (B - 2 - i) (by omega)
    have hSt : q ≠ L.t := sep_S_rest L B hn hSmem
      (List.mem_append_right (reg L.D B) (by simp [workSites]))
    have hSmask : q ∉ aMask L B r := by
      intro hm
      simp only [aMask, List.mem_map] at hm
      rcases hm with ⟨a, ha', heq⟩
      have hAmem : L.A a ∈ workSites L B := by
        simp [workSites, reg_mem L.A _ a
          (List.mem_range.mp (List.mem_filter.mp ha').1)]
      exact sep_S_rest L B hn hSmem
        (List.mem_append_right (reg L.D B) hAmem) heq.symm
    have hSlow : q ∉ (lowDecoder L B).sites := by
      intro hq
      exact sep_S_rest L B hn hSmem
        (List.mem_append_right (reg L.D B) (by simp [workSites, hq])) rfl
    have hShigh : q ∉ (highDecoder L B).sites := by
      intro hq
      exact sep_S_rest L B hn hSmem
        (List.mem_append_right (reg L.D B) (by simp [workSites, hq])) rfl
    calc
      out.basis q = sLow.basis q := hHigh.2.2 q hShigh
      _ = sA.basis q := hLow.2.2 q hSlow
      _ = s0.basis q := hA.2.2 q hSmask
      _ = s.basis q := hs0Frame q hSt
      _ = st.s (B - 2 - i) := hsrail i hi
  · intro q hq
    rw [hHigh.2.2 q]
    · rw [hLow.2.1 q hq]
      rw [hsAt, hnextA]
      cases marker <;> rfl
    · intro hhq
      exact sep_low_high L B hn hq hhq rfl
  · intro q hq
    rw [hHigh.2.1 q hq]
    rw [hsLowt, hnextA]
    cases marker <;> rfl

theorem measureCZ_resetA (target left right : Wire) (s : State) (m : List Bool)
    (hlt : left ≠ target) (hrt : right ≠ target)
    (hvalue : s.basis target = (s.basis left && s.basis right)) :
    run [.measureX target [] [.CZ left right]] m s =
      ⟨s.phase, writeBit s.basis target false⟩ := by
  apply State.extensionality
  · cases hm : m.headD false <;> cases hp : s.phase <;>
      cases hl : s.basis left <;> cases hr : s.basis right <;>
      simp_all [run, measureAndCorrect, ECDSAAdd.correct,
        writeBit, Function.update]
  · funext q
    simp [run, measureAndCorrect, ECDSAAdd.correct]

theorem decoderOutputBoundsA (L : Layout) (B k : Nat) (hk : k < B)
    (hB : 3 ≤ B) :
    k % 2 ^ (bitWidth B / 2) < (lowDecoder L B).outputs.length ∧
    k / 2 ^ (bitWidth B / 2) < (highDecoder L B).outputs.length := by
  have hkpow : k < 2 ^ bitWidth B :=
    lt_of_lt_of_le hk (bitWidth_bound B (by omega))
  constructor
  · simp only [lowDecoder, oneHot_outputs_length, lowBits, reg,
      List.length_take, List.length_map, List.length_range]
    rw [Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)]
    exact Nat.mod_lt _ (by positivity)
  · simp only [highDecoder, oneHot_outputs_length, highBits, reg,
      List.length_drop, List.length_map, List.length_range]
    rw [Nat.div_lt_iff_lt_mul (by positivity), ← pow_add]
    have hlo : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hlo] using hkpow

theorem lowOutput_ne_tA (L : Layout) (B i : Nat) (hn : L.Nodup B)
    (hi : i < (lowDecoder L B).outputs.length) :
    outAt (lowDecoder L B) i L.z ≠ L.t := by
  have hm : outAt (lowDecoder L B) i L.z ∈
      lowBits L B ++ (lowDecoder L B).sites := by
    rw [outAt, List.getD_eq_getElem _ _ hi]
    exact (oneHot_structural (lowBits L B) L.lowWork).2.1 _
      (List.getElem_mem _)
  rcases List.mem_append.mp hm with hm | hm
  · have ha := List.mem_of_mem_take hm
    exact sep_A_rest L B hn ha (by simp [workSites])
  · exact (sep_ZT_decoders L B hn (by simp)
      (List.mem_append_left (highDecoder L B).sites hm)).symm

theorem highOutput_ne_tA (L : Layout) (B i : Nat) (hn : L.Nodup B)
    (hi : i < (highDecoder L B).outputs.length) :
    outAt (highDecoder L B) i L.z ≠ L.t := by
  have hm : outAt (highDecoder L B) i L.z ∈
      highBits L B ++ (highDecoder L B).sites := by
    rw [outAt, List.getD_eq_getElem _ _ hi]
    exact (oneHot_structural (highBits L B) L.highWork).2.1 _
      (List.getElem_mem _)
  rcases List.mem_append.mp hm with hm | hm
  · have ha := List.mem_of_mem_drop hm
    exact sep_A_rest L B hn ha (by simp [workSites])
  · exact (sep_ZT_decoders L B hn (by simp)
      (List.mem_append_right (lowDecoder L B).sites hm)).symm

def packStepTailA (L : Layout) (B r : Nat) : Program :=
  let j := r - 1
  [.CX L.t (L.D j)] ++
    (if j < B - 2 then
      [.CX (L.S (B - 2 - j)) (L.D j),
       .measureX (L.S (B - 2 - j)) [] [.CZ (L.D j) L.z]]
     else []) ++
    [.CX L.t L.z,
     .measureX L.t []
       [.CZ
        (outAt (highDecoder L B) (r / 2 ^ (bitWidth B / 2)) L.z)
        (outAt (lowDecoder L B) (r % 2 ^ (bitWidth B / 2)) L.z)]]

theorem packStepTail_correctA (L : Layout) (B u v r : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (hr : 0 < r) (hrB : r ≤ B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma r st)
    (hfront : RealizesPackFrontA L B st (packSweepStep B r st)
      (st.d (r - 1) && st.z) s.basis) :
    let next := packSweepStep B r st
    let out := run (packStepTailA L B r) m s
    out.phase = s.phase ∧ RealizesUnpackSweep L B next out.basis := by
  let j := r - 1
  let marker := st.d j && st.z
  let next := packSweepStep B r st
  rcases hfront with ⟨ha, hz, ht, hd, hs, hlow, hhigh⟩
  have hnextInv := packSweepStep_invariantA B u v r sigma hdomain st hr hinv
  have hABound : next.a < 2 ^ bitWidth B := by
    change r - 1 ≤ B - 1 ∧ _ ∧
      next.a = (if r - 1 < natBitLength (u - sigma.toNat) then
        natBitLength (u - sigma.toNat) else 0) ∧ _ at hnextInv
    have hlen := domain_w_bitLength_le B u v sigma hdomain
    have hltB : next.a < B := by
      rw [hnextInv.2.2.1]
      split <;> omega
    exact lt_of_lt_of_le hltB (bitWidth_bound B (by omega))
  have hrPow : r < 2 ^ bitWidth B :=
    lt_of_lt_of_le (by omega : r < B) (bitWidth_bound B (by omega))
  have houtBounds := decoderOutputBoundsA L B r (by omega) hdomain.1
  let highOut := outAt (highDecoder L B)
    (r / 2 ^ (bitWidth B / 2)) L.z
  let lowOut := outAt (lowDecoder L B)
    (r % 2 ^ (bitWidth B / 2)) L.z
  have hhighT : highOut ≠ L.t :=
    highOutput_ne_tA L B _ hn houtBounds.2
  have hlowT : lowOut ≠ L.t :=
    lowOutput_ne_tA L B _ hn houtBounds.1
  have hinvZ : st.z = decide (u - sigma.toNat < 2 ^ r) := by
    change r ≤ B - 1 ∧
      st.z = decide (u - sigma.toNat < 2 ^ r) ∧ _ at hinv
    exact hinv.2.1
  have hinvS : ∀ i, i < B - 2 → st.s (B - 2 - i) =
      if i < r then halfBit B v i else false := by
    change r ≤ B - 1 ∧ _ ∧ _ ∧ _ ∧
      (∀ i, i < B - 2 → st.s (B - 2 - i) =
        if i < r then halfBit B v i else false) at hinv
    exact hinv.2.2.2.2
  have hmarkerNext : marker = decide (next.a = r) := by
    have hnextA : next.a = if marker then r else st.a := by
      simp [next, packSweepStep, marker, j]
    change r ≤ B - 1 ∧
      st.z = decide (u - sigma.toNat < 2 ^ r) ∧
      st.a = (if r < natBitLength (u - sigma.toNat) then
        natBitLength (u - sigma.toNat) else 0) ∧ _ at hinv
    cases hm : marker
    · rw [hnextA, hm, hinv.2.2.1]
      by_cases hgt : r < natBitLength (u - sigma.toNat)
      · simp [hgt]
        omega
      · have hr0 : (0 : Nat) ≠ r := by omega
        simp [hgt, hr0]
    · simp [hnextA, hm]
  have hselected : (s.basis highOut && s.basis lowOut) = marker := by
    have hp := pairDecoder_selected_of_sites L B next.a r hn s.basis
      ha hABound hrPow hlow hhigh
    rw [show highOut = outAt (highDecoder L B)
        (r / 2 ^ (bitWidth B / 2)) L.z by rfl,
      show lowOut = outAt (lowDecoder L B)
        (r % 2 ^ (bitWidth B / 2)) L.z by rfl, hp]
    rw [hmarkerNext]
    simp [eq_comm]
  dsimp only
  by_cases hj : j < B - 2
  · let d1 := run [.CX L.t (L.D j)] [] s
    let sw := L.S (B - 2 - j)
    let d2 := run [.CX sw (L.D j)] [] d1
    let d3 := run [.measureX sw [] [.CZ (L.D j) L.z]] m d2
    let d4 := run [.CX L.t L.z] [] d3
    let out := run [.measureX L.t [] [.CZ highOut lowOut]] m.tail d4
    have hDmem : L.D j ∈ reg L.D B := reg_mem L.D B j (by omega)
    have hDt : L.D j ≠ L.t :=
      sep_D_work L B hn hDmem (by simp [workSites])
    have hDz : L.D j ≠ L.z :=
      sep_D_work L B hn hDmem (by simp [workSites])
    have hSmem : sw ∈ reg L.S B := reg_mem L.S B (B - 2 - j) (by omega)
    have hSD : sw ≠ L.D j :=
      sep_S_rest L B hn hSmem (List.mem_append_left _ hDmem)
    have hSz : sw ≠ L.z :=
      sep_S_rest L B hn hSmem
        (List.mem_append_right _ (by simp [workSites]))
    have hSt : sw ≠ L.t :=
      sep_S_rest L B hn hSmem
        (List.mem_append_right _ (by simp [workSites]))
    have hTD := Ne.symm hDt
    have hzD := Ne.symm hDz
    have hDS := Ne.symm hSD
    have hzS := Ne.symm hSz
    have hTS := Ne.symm hSt
    have hd1D : d1.basis (L.D j) = (st.d j ^^ marker) := by
      simp [d1, run, writeBit, Function.update, ht, hd j (by omega), hDt, hTD,
        marker, j]
    have hd1S : d1.basis sw = st.s (B - 2 - j) := by
      have hsIn : s.basis sw = st.s (B - 2 - j) := by
        dsimp only [sw]
        exact hs j hj
      change writeBit s.basis (L.D j)
        (s.basis (L.D j) ^^ s.basis L.t) sw = st.s (B - 2 - j)
      simp [writeBit, Function.update, hSD, hsIn]
    have hd1z : d1.basis L.z = st.z := by
      simp [d1, run, writeBit, Function.update, hDz, hzD, hz, marker, j]
    have hd1t : d1.basis L.t = marker := by
      simp [d1, run, writeBit, Function.update, hDt, hTD, ht, marker, j]
    have hd2D : d2.basis (L.D j) = next.d j := by
      change writeBit d1.basis (L.D j)
        (d1.basis (L.D j) ^^ d1.basis sw) (L.D j) = next.d j
      rw [show writeBit d1.basis (L.D j)
          (d1.basis (L.D j) ^^ d1.basis sw) (L.D j) =
        (d1.basis (L.D j) ^^ d1.basis sw) by simp [writeBit]]
      rw [hd1D, hd1S]
      simp [next, packSweepStep, j, marker, hj, sw, Bool.xor_assoc]
    have hd2S : d2.basis sw = st.s (B - 2 - j) := by
      simp [d2, run, writeBit, Function.update, hSD, hDS, hd1S, sw]
    have hd2z : d2.basis L.z = st.z := by
      simp [d2, run, writeBit, Function.update, hDz, hzD, hd1z, sw]
    have hd2t : d2.basis L.t = marker := by
      simp [d2, run, writeBit, Function.update, hDt, hTD, hd1t, sw]
    have harith := packSweep_arithmetic_step B u v sigma r hdomain hr hj
    have hsJ : st.s (B - 2 - j) = halfBit B v j := by
      rw [hinvS j hj, if_pos (by omega)]
    have hsafeS : d2.basis sw =
        (d2.basis (L.D j) && d2.basis L.z) := by
      rw [hd2S, hsJ, hd2D, hd2z]
      have hnextD : next.d j = payloadBit B (u - sigma.toNat) v j := by
        have h := hnextInv.2.2.2.1 j (by omega)
        rw [if_neg (by omega)] at h
        exact h
      rw [hnextD, hinvZ]
      simpa only [j] using harith.2.2.2.1
    have hd3eq := measureCZ_resetA sw (L.D j) L.z d2 m
      (Ne.symm hSD) (Ne.symm hSz) hsafeS
    have hd3 : d3 = ⟨d2.phase, writeBit d2.basis sw false⟩ := hd3eq
    have hd4t : d4.basis L.t = marker := by
      have hzt := sep_z_t L B hn
      calc
        d4.basis L.t = d3.basis L.t := by
          simp [d4, run, writeBit, Function.update, hzt, Ne.symm hzt]
        _ = d2.basis L.t := by rw [hd3]; simp [writeBit, hTS]
        _ = marker := hd2t
    have hd4z : d4.basis L.z = next.z := by
      have hz3 : d3.basis L.z = st.z := by
        rw [hd3]
        simp [writeBit, hzS, hd2z]
      have ht3 : d3.basis L.t = marker := by
        rw [hd3]
        simp [writeBit, hTS, hd2t]
      simp [d4, run, writeBit, Function.update, hz3, ht3,
        next, packSweepStep, j, marker]
    have hHighMem : highOut ∈ highBits L B ++ (highDecoder L B).sites := by
      dsimp only [highOut]
      rw [outAt, List.getD_eq_getElem _ _ houtBounds.2]
      exact (oneHot_structural (highBits L B) L.highWork).2.1 _
        (List.getElem_mem _)
    have hLowMem : lowOut ∈ lowBits L B ++ (lowDecoder L B).sites := by
      dsimp only [lowOut]
      rw [outAt, List.getD_eq_getElem _ _ houtBounds.1]
      exact (oneHot_structural (lowBits L B) L.lowWork).2.1 _
        (List.getElem_mem _)
    have hHighWork : highOut ∈ workSites L B := by
      rcases List.mem_append.mp hHighMem with hA | hsite
      · simp [workSites, List.mem_of_mem_drop hA]
      · simp [workSites, hsite]
    have hLowWork : lowOut ∈ workSites L B := by
      rcases List.mem_append.mp hLowMem with hA | hsite
      · simp [workSites, List.mem_of_mem_take hA]
      · simp [workSites, hsite]
    have hDHigh : L.D j ≠ highOut := sep_D_work L B hn hDmem hHighWork
    have hDLow : L.D j ≠ lowOut := sep_D_work L B hn hDmem hLowWork
    have hSHigh : sw ≠ highOut :=
      sep_S_rest L B hn hSmem (List.mem_append_right _ hHighWork)
    have hSLow : sw ≠ lowOut :=
      sep_S_rest L B hn hSmem (List.mem_append_right _ hLowWork)
    have hzHigh : highOut ≠ L.z := high_output_ne_z L B _ hn houtBounds.2
    have hzLow : lowOut ≠ L.z := low_output_ne_z L B _ hn houtBounds.1
    have hd4High : d4.basis highOut = s.basis highOut := by
      simp [d4, hd3, d2, d1, run, writeBit, Function.update,
        hhighT, hDHigh, Ne.symm hDHigh, hSHigh, Ne.symm hSHigh,
        hzHigh, highOut]
    have hd4Low : d4.basis lowOut = s.basis lowOut := by
      simp [d4, hd3, d2, d1, run, writeBit, Function.update,
        hlowT, hDLow, Ne.symm hDLow, hSLow, Ne.symm hSLow,
        hzLow, lowOut]
    have hsafeT : d4.basis L.t = (d4.basis highOut && d4.basis lowOut) := by
      rw [hd4t, hd4High, hd4Low, hselected]
    have houtEq := measureCZ_resetA L.t highOut lowOut d4 m.tail
      hhighT hlowT hsafeT
    have houtState : out = ⟨d4.phase, writeBit d4.basis L.t false⟩ := houtEq
    have houtBasis : out.basis = writeBit d4.basis L.t false :=
      congrArg State.basis houtState
    have houtFrame : ∀ q, q ≠ L.D j → q ≠ sw → q ≠ L.z → q ≠ L.t →
        out.basis q = s.basis q := by
      intro q hqD hqS hqz hqt
      rw [houtBasis]
      simp [d4, hd3, d2, d1, run, writeBit, Function.update,
        hqD, hqS, hqz, hqt]
    have houtD : out.basis (L.D j) = next.d j := by
      calc
        out.basis (L.D j) = d4.basis (L.D j) := by
          rw [houtBasis]
          simp [writeBit, hDt]
        _ = d3.basis (L.D j) := by
          simp [d4, run, writeBit, hDz]
        _ = d2.basis (L.D j) := by
          rw [hd3]
          simp [writeBit, hDS]
        _ = next.d j := hd2D
    have houtS : out.basis sw = false := by
      calc
        out.basis sw = d4.basis sw := by
          rw [houtBasis]
          simp [writeBit, hSt]
        _ = d3.basis sw := by simp [d4, run, writeBit, hSz]
        _ = false := by rw [hd3]; simp [writeBit]
    have houtZ : out.basis L.z = next.z := by
      rw [houtBasis]
      simp [writeBit, hd4z, sep_z_t L B hn]
    have houtT : out.basis L.t = false := by
      rw [houtBasis]
      simp [writeBit]
    have hrun : run (packStepTailA L B r) m s = out := by
      simp [packStepTailA, j, hj, d1, sw, d2, d3, d4, out,
        highOut, lowOut, run]
    rw [hrun]
    refine ⟨?_, ?_⟩
    · rw [houtState]
      simp [d4, hd3, d2, d1, run]
    · change RealizesUnpackSweep L B next out.basis
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [regValue_congr (reg L.A (bitWidth B)) out.basis s.basis]
        · exact ha
        · intro q hq
          apply houtFrame q
          · exact (sep_D_work L B hn hDmem
              (by simp [workSites, hq])).symm
          · exact (sep_S_rest L B hn hSmem
              (List.mem_append_right _ (by simp [workSites, hq]))).symm
          · exact sep_A_rest L B hn hq (by simp [workSites])
          · exact sep_A_rest L B hn hq (by simp [workSites])
      · exact houtZ
      · exact houtT
      · intro i hi
        by_cases hij : i = j
        · subst i
          exact houtD
        · calc
            out.basis (L.D i) = s.basis (L.D i) := houtFrame (L.D i)
              (reg_ne L.D B i j (D_nodup L B hn) (by omega) (by omega) hij)
              ((sep_S_rest L B hn hSmem
                (List.mem_append_left _ (reg_mem L.D B i (by omega)))).symm)
              (sep_D_work L B hn (reg_mem L.D B i (by omega))
                (by simp [workSites]))
              (sep_D_work L B hn (reg_mem L.D B i (by omega))
                (by simp [workSites]))
            _ = next.d i := by
              rw [hd i hi]
              simp [next, packSweepStep, j, hij]
      · intro i hi
        by_cases hij : i = j
        · subst i
          rw [houtS]
          simp [next, packSweepStep, j, hj]
        · have hmirror : L.S (B - 2 - i) ≠ sw := by
            intro heq
            have hSn := S_nodup L B hn
            have hiB : B - 2 - i < B := by omega
            have hjB : B - 2 - j < B := by omega
            have := reg_ne L.S B (B - 2 - i) (B - 2 - j) hSn hiB hjB
              (by omega)
            exact this heq
          calc
            out.basis (L.S (B - 2 - i)) = s.basis (L.S (B - 2 - i)) :=
              houtFrame (L.S (B - 2 - i))
                (sep_S_rest L B hn
                  (reg_mem L.S B (B - 2 - i) (by omega))
                  (List.mem_append_left _ hDmem)) hmirror
                (sep_S_rest L B hn
                  (reg_mem L.S B (B - 2 - i) (by omega))
                  (List.mem_append_right _ (by simp [workSites])))
                (sep_S_rest L B hn
                  (reg_mem L.S B (B - 2 - i) (by omega))
                  (List.mem_append_right _ (by simp [workSites])))
            _ = next.s (B - 2 - i) := by
              have hindex : B - 2 - i ≠ B - 2 - j := by omega
              rw [hs i hi]
              simp [next, packSweepStep, j, hij, hindex]
      · intro q hq
        exact (houtFrame q
          ((sep_D_work L B hn hDmem (by simp [workSites, hq])).symm)
          ((sep_S_rest L B hn hSmem
            (List.mem_append_right _ (by simp [workSites, hq]))).symm)
          ((sep_ZT_decoders L B hn (by simp)
            (List.mem_append_left _ hq)).symm)
          ((sep_ZT_decoders L B hn (by simp)
            (List.mem_append_left _ hq)).symm)).trans (hlow q hq)
      · intro q hq
        exact (houtFrame q
          ((sep_D_work L B hn hDmem (by simp [workSites, hq])).symm)
          ((sep_S_rest L B hn hSmem
            (List.mem_append_right _ (by simp [workSites, hq]))).symm)
          ((sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right _ hq)).symm)
          ((sep_ZT_decoders L B hn (by simp)
            (List.mem_append_right _ hq)).symm)).trans (hhigh q hq)
  · have hjTop : j = B - 2 := by omega
    let d1 := run [.CX L.t (L.D j)] [] s
    let d2 := run [.CX L.t L.z] [] d1
    let out := run [.measureX L.t [] [.CZ highOut lowOut]] m d2
    have hDmem : L.D j ∈ reg L.D B := reg_mem L.D B j (by omega)
    have hDt : L.D j ≠ L.t :=
      sep_D_work L B hn hDmem (by simp [workSites])
    have hDz : L.D j ≠ L.z :=
      sep_D_work L B hn hDmem (by simp [workSites])
    have hTD := Ne.symm hDt
    have hzD := Ne.symm hDz
    have hd1t : d1.basis L.t = marker := by
      simp [d1, run, writeBit, Function.update, hDt, hTD, ht, marker, j]
    have hd1D : d1.basis (L.D j) = (st.d j ^^ marker) := by
      simp [d1, run, writeBit, Function.update, ht, hd j (by omega),
        hDt, hTD, marker, j]
    have hd1z : d1.basis L.z = st.z := by
      simp [d1, run, writeBit, Function.update, hDz, hzD, hz]
    have hd2t : d2.basis L.t = marker := by
      have hzt := sep_z_t L B hn
      calc
        d2.basis L.t = d1.basis L.t := by
          simp [d2, run, writeBit, Function.update, hzt, Ne.symm hzt]
        _ = marker := hd1t
    have hd2D : d2.basis (L.D j) = (st.d j ^^ marker) := by
      simp [d2, run, writeBit, Function.update, hDz, hzD, hd1D]
    have hd2z : d2.basis L.z = (st.z ^^ marker) := by
      simp [d2, run, writeBit, Function.update, sep_z_t L B hn,
        hd1z, hd1t]
    have hHighMem : highOut ∈ highBits L B ++ (highDecoder L B).sites := by
      dsimp only [highOut]
      rw [outAt, List.getD_eq_getElem _ _ houtBounds.2]
      exact (oneHot_structural (highBits L B) L.highWork).2.1 _
        (List.getElem_mem _)
    have hLowMem : lowOut ∈ lowBits L B ++ (lowDecoder L B).sites := by
      dsimp only [lowOut]
      rw [outAt, List.getD_eq_getElem _ _ houtBounds.1]
      exact (oneHot_structural (lowBits L B) L.lowWork).2.1 _
        (List.getElem_mem _)
    have hHighWork : highOut ∈ workSites L B := by
      rcases List.mem_append.mp hHighMem with hA | hsite
      · simp [workSites, List.mem_of_mem_drop hA]
      · simp [workSites, hsite]
    have hLowWork : lowOut ∈ workSites L B := by
      rcases List.mem_append.mp hLowMem with hA | hsite
      · simp [workSites, List.mem_of_mem_take hA]
      · simp [workSites, hsite]
    have hDHigh : L.D j ≠ highOut := sep_D_work L B hn hDmem hHighWork
    have hDLow : L.D j ≠ lowOut := sep_D_work L B hn hDmem hLowWork
    have hzHigh : highOut ≠ L.z := high_output_ne_z L B _ hn houtBounds.2
    have hzLow : lowOut ≠ L.z := low_output_ne_z L B _ hn houtBounds.1
    have hd2High : d2.basis highOut = s.basis highOut := by
      simp [d2, d1, run, writeBit, Function.update, hhighT, hDHigh,
        Ne.symm hDHigh, hzHigh, highOut]
    have hd2Low : d2.basis lowOut = s.basis lowOut := by
      simp [d2, d1, run, writeBit, Function.update, hlowT, hDLow,
        Ne.symm hDLow, hzLow, lowOut]
    have hsafeT : d2.basis L.t = (d2.basis highOut && d2.basis lowOut) := by
      rw [hd2t, hd2High, hd2Low, hselected]
    have houtEq := measureCZ_resetA L.t highOut lowOut d2 m
      hhighT hlowT hsafeT
    have houtState : out = ⟨d2.phase, writeBit d2.basis L.t false⟩ := houtEq
    have houtBasis : out.basis = writeBit d2.basis L.t false :=
      congrArg State.basis houtState
    have houtFrame : ∀ q, q ≠ L.D j → q ≠ L.z → q ≠ L.t →
        out.basis q = s.basis q := by
      intro q hqD hqz hqt
      rw [houtBasis]
      simp [d2, d1, run, writeBit, Function.update, hqD, hqz, hqt]
    have houtD : out.basis (L.D j) = next.d j := by
      rw [houtBasis]
      simp [writeBit, Function.update, hDt, hTD, hd2D,
        next, packSweepStep, marker, j, hj]
    have houtZ : out.basis L.z = next.z := by
      rw [houtBasis]
      simp [writeBit, Function.update, sep_z_t L B hn,
        Ne.symm (sep_z_t L B hn), hd2z, next, packSweepStep, marker, j]
    have houtT : out.basis L.t = false := by
      rw [houtBasis]
      simp [writeBit]
    have hrun : run (packStepTailA L B r) m s = out := by
      simp [packStepTailA, j, hj, d1, d2, out, highOut, lowOut, run]
    rw [hrun]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [houtState]
      simp [d2, d1, run]
    · rw [regValue_congr (reg L.A (bitWidth B)) out.basis s.basis]
      · exact ha
      · intro q hq
        apply houtFrame q
        · exact (sep_D_work L B hn hDmem (by simp [workSites, hq])).symm
        · exact sep_A_rest L B hn hq (by simp [workSites])
        · exact sep_A_rest L B hn hq (by simp [workSites])
    · exact houtZ
    · exact houtT
    · intro i hi
      by_cases hij : i = j
      · subst i
        exact houtD
      · calc
          out.basis (L.D i) = s.basis (L.D i) := houtFrame (L.D i)
            (reg_ne L.D B i j (D_nodup L B hn) (by omega) (by omega) hij)
            (sep_D_work L B hn (reg_mem L.D B i (by omega))
              (by simp [workSites]))
            (sep_D_work L B hn (reg_mem L.D B i (by omega))
              (by simp [workSites]))
          _ = next.d i := by
            rw [hd i hi]
            simp [next, packSweepStep, j, hij]
    · intro i hi
      calc
        out.basis (L.S (B - 2 - i)) = s.basis (L.S (B - 2 - i)) :=
          houtFrame (L.S (B - 2 - i))
            (sep_S_rest L B hn
              (reg_mem L.S B (B - 2 - i) (by omega))
              (List.mem_append_left _ hDmem))
            (sep_S_rest L B hn
              (reg_mem L.S B (B - 2 - i) (by omega))
              (List.mem_append_right _ (by simp [workSites])))
            (sep_S_rest L B hn
              (reg_mem L.S B (B - 2 - i) (by omega))
              (List.mem_append_right _ (by simp [workSites])))
        _ = next.s (B - 2 - i) := by
          rw [hs i hi]
          simp [next, packSweepStep, j, hj]
    · intro q hq
      exact (houtFrame q
        ((sep_D_work L B hn hDmem (by simp [workSites, hq])).symm)
        ((sep_ZT_decoders L B hn (by simp)
          (List.mem_append_left _ hq)).symm)
        ((sep_ZT_decoders L B hn (by simp)
          (List.mem_append_left _ hq)).symm)).trans (hlow q hq)
    · intro q hq
      exact (houtFrame q
        ((sep_D_work L B hn hDmem (by simp [workSites, hq])).symm)
        ((sep_ZT_decoders L B hn (by simp)
          (List.mem_append_right _ hq)).symm)
        ((sep_ZT_decoders L B hn (by simp)
          (List.mem_append_right _ hq)).symm)).trans (hhigh q hq)

theorem packStep_eq_front_tailA (L : Layout) (B r : Nat) (hr : 0 < r) :
    packStep L B (r - 1) =
      packStepFrontA L B r ++ packStepTailA L B r := by
  have hrj : r - 1 + 1 = r := by omega
  simp [packStep, packStepFrontA, packStepTailA, aMask, hrj,
    List.append_assoc]

theorem packStep_correctA (L : Layout) (B u v r : Nat) (sigma : Bool)
    (hdomain : CodecDomain B u v sigma) (hn : L.Nodup B)
    (hr : 0 < r) (hrB : r ≤ B - 1)
    (st : SweepState) (s : State) (m : List Bool)
    (hinv : PackSweepInvariant B u v sigma r st)
    (hreal : RealizesUnpackSweep L B st s.basis) :
    let next := packSweepStep B r st
    let out := run (packStep L B (r - 1)) m s
    out.phase = s.phase ∧
      PackSweepInvariant B u v sigma (r - 1) next ∧
      RealizesUnpackSweep L B next out.basis := by
  let front := packStepFrontA L B r
  let tail := packStepTailA L B r
  let mid := run front [] s
  have hfrontCount : measurementCount front = 0 := by
    simp [front, packStepFrontA, cxInto_measurementCount, measurementCount]
  have hfront := packStepFront_correctA L B u v r sigma hn hr hrB st s []
    hinv hreal
  change mid.phase = s.phase ∧
    RealizesPackFrontA L B st (packSweepStep B r st)
      (st.d (r - 1) && st.z) mid.basis at hfront
  have htail := packStepTail_correctA L B u v r sigma hdomain hn hr hrB
    st mid m hinv hfront.2
  let next := packSweepStep B r st
  let out := run tail m mid
  change out.phase = mid.phase ∧ RealizesUnpackSweep L B next out.basis at htail
  have hrun : run (packStep L B (r - 1)) m s = out := by
    rw [packStep_eq_front_tailA L B r hr, run_append, hfrontCount,
      List.take_zero, List.drop_zero]
  rw [hrun]
  exact ⟨htail.1.trans hfront.1,
    packSweepStep_invariantA B u v r sigma hdomain st hr hinv, htail.2⟩











def cxToA (target : Wire) (controls : List Wire) : Program :=
  controls.map (fun control => Instr.CX control target)

def eraseEntryA : EraseEntry → Program
  | .affine target sources negated =>
      (if negated then [.X target] else []) ++ cxToA target sources.reverse
  | .andGate target left right =>
      [.measureX target [] [.CZ left right]]

def eraseDecoderA (d : Decoder) : Program :=
  d.log.reverse.flatMap eraseEntryA

set_option maxHeartbeats 800000 in
theorem eraseDecoderA_run (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup)
    (s : State) (m : List Bool) (x : Nat) (hx : x < 2 ^ bits.length)
    (hbits : ∀ i, i < bits.length → s.basis (bits.getD i 0) = x.testBit i)
    (hsites : ∀ q ∈ (oneHot bits fresh).sites,
      s.basis q = decoderBasis (oneHot bits fresh) bits x q) :
    run (eraseDecoderA (oneHot bits fresh)) m s =
      ⟨s.phase, fun q => if q ∈ (oneHot bits fresh).sites then false
        else s.basis q⟩ := by
  let preBasis : BasisState := fun q =>
    if q ∈ (oneHot bits fresh).sites then false else s.basis q
  let pre : State := ⟨s.phase, preBasis⟩
  have hdisjoint : ∀ q ∈ bits, q ∉ (oneHot bits fresh).sites := by
    intro q hqb hqs
    exact (List.nodup_append.mp hn).2.2 q hqb q hqs rfl
  have hbitsPre : ∀ i, i < bits.length →
      pre.basis (bits.getD i 0) = x.testBit i := by
    intro i hi
    have hm : bits.getD i 0 ∈ bits := by
      rw [List.getD_eq_getElem _ _ hi]
      exact List.getElem_mem hi
    change (if bits.getD i 0 ∈ (oneHot bits fresh).sites then false
      else s.basis (bits.getD i 0)) = x.testBit i
    rw [if_neg (hdisjoint _ hm)]
    exact hbits i hi
  have hclean : ∀ q ∈ (oneHot bits fresh).sites, pre.basis q = false := by
    intro q hq
    simp [pre, preBasis, hq]
  have hout := oneHot_run_output bits fresh hn pre [] x hx hbitsPre hclean
  have hsiteRun := oneHot_run_sites bits fresh hn pre [] x hbitsPre hclean
  have hforward : run (oneHot bits fresh).program [] pre = s := by
    apply State.extensionality
    · exact hout.1
    · funext q
      by_cases hq : q ∈ (oneHot bits fresh).sites
      · exact (hsiteRun q hq).trans (hsites q hq).symm
      · rw [hout.2.1 q hq]
        simp [pre, preBasis, hq]
  have herase := oneHot_erase_run bits fresh hn pre hclean [] m
  change run (eraseDecoderA (oneHot bits fresh)) m
    (run (oneHot bits fresh).program [] pre) = pre at herase
  rw [hforward] at herase
  simpa only [pre, preBasis] using herase












end ECDSAAdd.Entrant.StairCodec.PackA
end Merge_StairCodecPackA_at_QTop

