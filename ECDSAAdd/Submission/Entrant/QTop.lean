    (cntP : ∀f∈a.pre,∀q,f.src.count q≤L.core.product.count q) (okP : ∀f∈a.pre,TermOK33 f) :
    ECDSAAdd.wires (accFoldQFTq L g a)⊆(g::L.wires).toFinset := by
  have full := accFoldQ_supportTq L hw hn g a cnt ok cntP okP
