    (by rw [mappedRead_wires];exact geo.2)
    (by intro q hq;exact geo.2 q (List.mem_append_left _ (desired_source src q hq)))
    (geo.2 _ (List.mem_append_left _ (extra_mem src (by omega))))
    hl (by omega) hc s m hcarry ready
