    run (sub x y cs cin) m s=run (subInPlace x y cs cin) m s := by
  obtain ⟨a,a',as,rfl⟩:=shape x (by omega)
  obtain ⟨b,b',bs,rfl⟩:=shape y (by omega)
  cases cs with
  | nil => simp at lc
  | cons c cs => exact sub_eq a a' b b' c cin as bs cs hn ly v u hbit s m hc hx hy

                                                         
                                                                                  
                                                
                                                                          
                                                                                
                                                                                          
                                                                                          
                                          
                                          
               
                     
                
                                                        
                      
              
                   
                                                                   
                                 
           
                      
              
                   
                                                                   
                                 
           
                                                                                           
                                                      
                                                                    
                                         

