theorem tailFirstBase_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord (j+1) origin X Y) (tailFirstBase j)
      (fun state => let V := directionalPayload true (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame P1Life.oddWord P1Life.oddWord j origin V.1 V.2 state) := by
  have nonzero : j≠0 := by omega
  intro state records input
  apply cut_window_frame centerWord centerWord P1Life.oddWord P1Life.oddWord (j+1) j j hj origin X Y _ _ (tailFirstBase j)
    (otherEncodeCut_step base j 102).symm
    (otherEncodeCut_body_disjoint (j+1) j hj origin ctx _
      (tailFirstBase_read_support j hj)) _ state records input
  intro current tape frame
  have normalized : CodeFrame centerWord centerWord (codeEncodeAt false (History5.historyMap base (5*j)))
      origin X Y current := by
    simpa [encodeGroup,nonzero,show ¬j+1≤j from by omega] using frame
  have result := tailFirstBase_frame j hj origin ctx enabled X Y current tape normalized
  simpa [regularPayload_eq false j hj origin enabled,encodeGroup,nonzero,
    show ¬j+1≤j from by omega] using result

theorem tailLastBase_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame P1Life.oddWord P1Life.oddWord (j+1) origin X Y) (tailLastBase j)
      (fun state => let V := directionalPayload true (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame centerWord centerWord j origin V.1 V.2 state) := by
  have nonzero : j≠0 := by omega
  intro state records input
  apply cut_window_frame P1Life.oddWord P1Life.oddWord centerWord centerWord (j+1) j j hj origin X Y _ _ (tailLastBase j)
    (otherEncodeCut_step base j 102).symm
    (otherEncodeCut_body_disjoint (j+1) j hj origin ctx _
      (tailLastBase_read_support j hj)) _ state records input
  intro current tape frame
  have normalized : CodeFrame P1Life.oddWord P1Life.oddWord (codeEncodeAt false (History5.historyMap base (5*j)))
      origin X Y current := by
    simpa [encodeGroup,nonzero,show ¬j+1≤j from by omega] using frame
  have result := tailLastBase_frame j hj origin ctx enabled X Y current tape normalized
  simpa [regularPayload_eq false j hj origin enabled,encodeGroup,nonzero,
    show ¬j+1≤j from by omega] using result

theorem tailFirstPacket_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord (j+1) origin X Y) (tailFirstPacket j)
      (fun state => let V := directionalPayload true (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame P1Life.oddWord P1Life.oddWord j origin V.1 V.2 state) := by
  intro state records input
  have raw := tailFirstBase_cut_frame j first hj origin ctx enabled X Y state records input
  have same := Replay5.placed_eq (Placement5.pi j) (tailFirstBase j)
    (fun q hq => Placement5.pi_outside j q hj hq) state records
    (cutFrame_zero_region centerWord centerWord _ origin ctx X Y state input)
    (cutFrame_zero_region P1Life.oddWord P1Life.oddWord _ origin ctx _ _ _ raw.2)
  change run (tailFirstPacket j) records state=run (tailFirstBase j) records state at same
  rw [same]
  exact raw

theorem tailLastPacket_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame P1Life.oddWord P1Life.oddWord (j+1) origin X Y) (tailLastPacket j)
      (fun state => let V := directionalPayload true (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame centerWord centerWord j origin V.1 V.2 state) := by
  intro state records input
  have raw := tailLastBase_cut_frame j first hj origin ctx enabled X Y state records input
  have same := Replay5.placed_eq (Placement5.pi j) (tailLastBase j)
    (fun q hq => Placement5.pi_outside j q hj hq) state records
    (cutFrame_zero_region P1Life.oddWord P1Life.oddWord _ origin ctx X Y state input)
    (cutFrame_zero_region centerWord centerWord _ origin ctx _ _ _ raw.2)
  change run (tailLastPacket j) records state=run (tailLastBase j) records state at same
  rw [same]
  exact raw

theorem tail_payload_snoc {α : Type} (step : Nat→α→α) (j n : Nat) (V : α) :
    PacketSequence.payload false step j (n+1) V=
      PacketSequence.payload false step j n (step (j+n) V) := by
  induction n generalizing j V with
  | zero => simp only [PacketSequence.payload,Bool.false_eq_true,if_false,Nat.add_zero]
  | succ n ih =>
    rw [PacketSequence.payload,if_neg Bool.false_ne_true,ih (j+1) V,PacketSequence.payload,
      if_neg Bool.false_ne_true]
    rw [show j+1+n=j+(n+1) from by omega]

/-- The odd-word tail has the cut frame of the record packets `84 .. 1`. -/
theorem oddTail_cut_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord 85 origin X Y) oddTail
      (fun state => let V := Replay5.groupsPayload false origin 1 84 (X,Y)
        CutFrame centerWord centerWord 1 origin V.1 V.2 state) := by
  let step := fun k (V : Fp×Fp) =>
    directionalPayload true (mixedTranscriptControls origin (base 2400) (Replay5.letters k)) V
  have head := tailFirstPacket_cut_frame 84 (by decide) (by decide) origin ctx enabled X Y
  have middle := groups_cut_frame false 2 82 (by decide) (by decide) origin ctx enabled
    (step 84 (X,Y)).1 (step 84 (X,Y)).2
  have last := tailLastPacket_cut_frame 1 (by decide) (by decide) origin ctx enabled
    (Replay5.groupsPayload false origin 2 82 (step 84 (X,Y))).1
    (Replay5.groupsPayload false origin 2 82 (step 84 (X,Y))).2
  have whole := head.seq (middle.seq last)
  have unfoldPayload : Replay5.groupsPayload false origin 1 84 (X,Y)=
      step 1 (Replay5.groupsPayload false origin 2 82 (step 84 (X,Y))) := by
    show PacketSequence.payload false step 1 (83+1) (X,Y)=
      step 1 (PacketSequence.payload false step 2 82 (step 84 (X,Y)))
    rw [PacketSequence.payload,if_neg Bool.false_ne_true]
    show step 1 (PacketSequence.payload false step 2 (82+1) (X,Y))=_
    rw [tail_payload_snoc step 2 82 (X,Y)]
  intro state records input
  have result := whole state records input
  refine ⟨result.1,?_⟩
  simpa only [oddTail,Bool.false_eq_true,if_false,unfoldPayload,Prod.mk.eta,step,
    show (2:Nat)+82=84 from rfl,show (84:Nat)+1=85 from rfl,show (1:Nat)+1=2 from rfl] using result.2

end ECDSAAdd.Entrant.RouteA.Rolling1588
