namespace ECDSAAdd.Entrant.StairOddHead
open Arithmetic MappedCompressed Secp256k1 BalancedField

/-- The odd-word tail has the record cut frame of `Rolling1588.groups false 1 84`. -/
theorem oddTail_cut_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Rolling1588.StateTriple (Rolling1588.CutFrame 85 origin X Y) RouteA.Rolling1588.oddTail
      (fun state => let V := Replay5.groupsPayload false origin 1 84 (X,Y)
        Rolling1588.CutFrame 1 origin V.1 V.2 state) := by
  intro state records input
  have result := RouteA.Rolling1588.oddTail_cut_frame origin ctx enabled X Y state records
    ((cutFrame_iff 85 origin X Y state).mpr input)
  exact ⟨result.1,(cutFrame_iff 1 origin _ _ _).mp result.2⟩

/-- Run equality of the odd-word tail with the record packets `84 .. 1` on the record cut
frame, for independent measurement tapes. -/
theorem oddTail_run_eq (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : Rolling1588.CutFrame 85 origin X Y s) :
    run RouteA.Rolling1588.oddTail fresh s = run (Rolling1588.groups false 1 84) old s := by
  have odd := oddTail_cut_frame origin ctx enabled X Y s fresh input
  have record := Rolling1588.groups_cut_frame false 1 84 (by decide) (by decide) origin ctx
    enabled X Y s old input
  exact cutFrame_unique 1 origin
    (Replay5.groupsPayload false origin 1 84 (X, Y)).1
    (Replay5.groupsPayload false origin 1 84 (X, Y)).2 _ _ odd.2 record.2
    (odd.1.trans record.1.symm)

