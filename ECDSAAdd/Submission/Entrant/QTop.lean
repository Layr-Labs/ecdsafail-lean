 [true,b (L.Y 32),b (L.Y 33),b (L.Y 34),b (L.Y 35),b (L.Y 31),b (L.Y 30),b (L.Y 29),
 b (L.R 31),b (L.R 30),false,b L.sigma,b L.h,false,b (L.A 0)]++
