    (hn:(cin::q::v::z::k::(x++y++cs)).Nodup)
    (lx:x.length=32) (ly:y.length=32) (lc:cs.length=31)
    (a u : Nat) (ha:a<2^32) (hbit:a/2%2=0) (s : State) (m : List Bool)
