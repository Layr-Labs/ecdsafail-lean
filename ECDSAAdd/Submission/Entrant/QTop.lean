          | cons c cs =>
            have it:=ih (low:=low-1) (x:=a'::as) (carry:=cs) (cin:=c)
              (by simp only [List.length_cons] at hx ⊢;omega)
              (by simp only [List.length_cons] at hc ⊢;omega)
            rw [CodexKnownOnesTail.addTail]
