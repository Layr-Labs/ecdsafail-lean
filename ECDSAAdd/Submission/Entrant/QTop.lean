/-! ### merged from `ECDSAAdd.Submission.Entrant.StairSegment_at_QTop` -/
section Merge_StairSegment_at_QTop

/-!
Checkpoint-local integer walk segments for the stair schedule.

Unlike the full-walk invariant, `Stage` is re-rooted at `start`.  Thus the
first predecessor can be a clean zero and no already-materialized transcript
prefix is required.  The placement map `w` is otherwise arbitrary.
-/

set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.StairSegment

open Arithmetic Secp256k1

abbrev railAt (r : SkywalkRails.State) (j : Nat) : SkywalkRails.State :=
  SkywalkTrace.next^[j] r

/-- The value-level obligations needed by one compact tick. -/
structure Fits (i : Nat) (r : SkywalkRails.State) : Prop where
  odd : (r.a+r.b)%2=1
  halfMin : -((2^(W.compactSkywalkTickPostWidth i-1):Nat):Int) ≤
    (SkywalkRails.route r.a r.b).1/2
  halfMax : (SkywalkRails.route r.a r.b).1/2 <
    ((2^(W.compactSkywalkTickPostWidth i-1):Nat):Int)
  otherMin : -((2^(W.compactSkywalkTickPostWidth i-1):Nat):Int) ≤
    (SkywalkRails.route r.a r.b).2
  otherMax : (SkywalkRails.route r.a r.b).2 <
    ((2^(W.compactSkywalkTickPostWidth i-1):Nat):Int)

/-- All tick-fit obligations for a segment. -/
def FitsThrough (start n : Nat) (r : SkywalkRails.State) : Prop :=
  ∀ j, j<n → Fits (start+j) (railAt r j)

/-- A compact physical stage whose mathematical trace starts at `start`.
The two future word tails, future `s` sites, and the complete carry bank are
explicitly clean, so the invariant can advance without an external oracle. -/
structure Stage (w : Nat → Wire) (start : Nat) (r : SkywalkRails.State)
    (i : Nat) (bits : BasisState) : Prop where
  start_le : start ≤ i
  valueA : signedRegValue (W.compactSkywalkTickLayout w i).a bits =
    (railAt r (i-start)).a
  valueB : signedRegValue (W.compactSkywalkTickLayout w i).b bits =
    (railAt r (i-start)).b
  previous : bits (w (skywalkPoolPreviousId i)) = (railAt r (i-start)).g
  letters : ∀ j, start ≤ j → j < i →
    (bits (w j)=(SkywalkTrace.code (railAt r (j-start))).1 ∧
    bits (w (1028+j))=(SkywalkTrace.code (railAt r (j-start))).2)
  futureA : ∀ j, i+W.compactSkywalkTickPreWidth i ≤ j → j < 770 → bits (w j)=false
  futureB : ∀ j, 770+W.compactSkywalkTickPreWidth i ≤ j → j < 1028 → bits (w j)=false
  futureS : ∀ j, i ≤ j → j < 512 → bits (w (1028+j))=false
  carry : regValue (wireBlock w 1540 257) bits=0


private theorem blockPrefix (w : Nat → Wire) (first len n : Nat) (hn : n≤len) :
    (wireBlock w first len).take n=wireBlock w first n := by
  have h := wireBlock_append w first n (len-n)
  rw [show n+(len-n)=len by omega] at h
  rw [←h]
  have ht : (wireBlock w first n++wireBlock w (first+n) (len-n)).take
      (wireBlock w first n).length=wireBlock w first n := List.take_left
  simpa only [wireBlock_length] using ht

private theorem entryViews (w : Nat → Wire) (i : Nat) (hi : i<512) :
    (W.compactSkywalkSignPoolA w i).retained=(W.compactSkywalkTickLayout w i).a ∧
    (W.compactSkywalkSignPoolB w i).retained=(W.compactSkywalkTickLayout w i).b := by
  have hw := W.compactSkywalkTick_width_bounds i hi
  have na : W.narrowSkywalkRouteWidth i ≤ (skywalkPoolA w i).length := by
    simpa only [skywalkPoolA,wireBlock_length] using hw.2.2.2.1
  have nb : W.narrowSkywalkRouteWidth i ≤ (skywalkPoolB w).length := by
    simpa only [skywalkPoolB,wireBlock_length] using hw.2.2.2.1
  have hpos : 0<W.narrowSkywalkRouteWidth i := by
    change 0<W.compactSkywalkTickPreWidth i
    omega
  have va := compactSkywalkSignWord_retained (skywalkPoolA w i)
    (W.narrowSkywalkRouteWidth i) hpos na
  have vb := compactSkywalkSignWord_retained (skywalkPoolB w)
    (W.narrowSkywalkRouteWidth i) hpos nb
  constructor
  · change (compactSkywalkSignWord (skywalkPoolA w i)
      (W.narrowSkywalkRouteWidth i)).retained=_
    rw [va,skywalkPoolA,W.compactSkywalkTick_a w i hi]
    exact blockPrefix w i 258 _ hw.2.2.2.1
  · change (compactSkywalkSignWord (skywalkPoolB w)
      (W.narrowSkywalkRouteWidth i)).retained=_
    rw [vb,skywalkPoolB,W.compactSkywalkTick_b w i hi]
    exact blockPrefix w 770 258 _ hw.2.2.2.1

theorem local_input (w : Nat → Wire) (start i : Nat) (r : SkywalkRails.State)
    (hi : i<512) (bits : BasisState) (h : Stage w start r i bits) :
    SkywalkIntegerInput (W.compactSkywalkTickLayout w i)
      (railAt r (i-start)).a (railAt r (i-start)).b
      (railAt r (i-start)).g bits := by
  refine ⟨h.valueA,h.valueB,h.previous,?_,?_,?_⟩
  · exact h.futureA _ (Nat.le_refl _) (by
      have b := W.compactSkywalkTick_width_bounds i hi
      omega)
  · exact h.futureS i (Nat.le_refl _) hi
  · apply (regValue_zero _ _).mpr
    intro q hq
    change q∈wireBlock w 1540 (W.compactSkywalkTickPreWidth i-1) at hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    have b := W.compactSkywalkTick_width_bounds i hi
    have hm : w j∈wireBlock w 1540 257 := List.mem_map.mpr
      ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    exact (regValue_zero _ _).mp h.carry (w j) hm

private theorem step_clean_tails (w : Nat → Wire) (start i : Nat)
    (r : SkywalkRails.State) (hi : i<512) (hn : (skywalkPoolWires w).Nodup)
    (s : State) (m : List Bool) (hs : Stage w start r i s.basis)
    (ho : W.CompactSkywalkTickOutput w i (railAt r (i-start)).a
      (railAt r (i-start)).b (railAt r (i-start)).g
      (run (W.compactSkywalkTick w i) m s).basis) :
    (∀j, i+1+W.compactSkywalkTickPreWidth (i+1)≤j → j < 770 →
      (run (W.compactSkywalkTick w i) m s).basis (w j)=false) ∧
    (∀j, 770+W.compactSkywalkTickPreWidth (i+1)≤j → j < 1028 →
      (run (W.compactSkywalkTick w i) m s).basis (w j)=false) := by
  have width := W.compactSkywalkTick_width_bounds i hi
  have views := W.compactSkywalkStageStep_tail_views w i hi
  constructor
  · intro j hj h770
    rw [←width.2.2.2.2.2] at hj
    by_cases current : j < i+1+W.compactSkywalkTickPreWidth i
    · apply ho.2.2.2.2.2.2.1
      rw [views.1]
      apply List.mem_map.mpr
      exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    · have keep := W.compactSkywalkStage_tick_keep w i hi hn j (by omega)
        (by unfold skywalkPoolPreviousId; split_ifs <;> omega)
        (by omega) (by omega) (by omega) (by omega)
        (by omega) (by omega) (by omega) s m
      exact keep.trans (hs.futureA j (by omega) h770)
  · intro j hj h1028
    rw [←width.2.2.2.2.2] at hj
    by_cases current : j < 770+W.compactSkywalkTickPreWidth i
    · apply ho.2.2.2.2.2.2.2
      rw [views.2.1]
      apply List.mem_map.mpr
      exact ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    · have keep := W.compactSkywalkStage_tick_keep w i hi hn j (by omega)
        (by unfold skywalkPoolPreviousId; split_ifs <;> omega)
        (by omega) (by omega) (by omega) (by omega)
        (by omega) (by omega) (by omega) s m
      exact keep.trans (hs.futureB j (by omega) h1028)

/-- One reference compact tick advances the checkpoint-local exact trace. -/
theorem compact_step (w : Nat → Wire) (start i : Nat) (r : SkywalkRails.State)
    (hi : i+1<512) (hn : (skywalkPoolWires w).Nodup) (s : State) (m : List Bool)
    (hs : Stage w start r i s.basis) (fit : Fits i (railAt r (i-start))) :
    (run (W.compactSkywalkTick w i) m s).phase=s.phase ∧
      Stage w start r (i+1) (run (W.compactSkywalkTick w i) m s).basis := by
  let ri := railAt r (i-start)
  let t := SkywalkRails.step ri
  let out := run (W.compactSkywalkTick w i) m s
  have hi0 : i<512 := by omega
  have input := local_input w start i r hi0 s.basis hs
  have result := W.compactSkywalkTickOutput_spec w i hi0 hn ri.a ri.b ri.g
    fit.odd fit.halfMin fit.halfMax fit.otherMin fit.otherMax s m input
  have ho : W.CompactSkywalkTickOutput w i ri.a ri.b ri.g out.basis := result.2
  have tails := step_clean_tails w start i r hi0 hn s m hs ho
  have retained := W.compactSkywalkStageStep_retained w i hi0
  have nextViews := entryViews w (i+1) (by omega)
  have hsle := hs.start_le
  have nextRail : railAt r (i+1-start)=SkywalkRails.railsOf t := by
    have e : i+1-start=(i-start)+1 := by omega
    rw [e]
    change (SkywalkTrace.next^[(i-start)+1]) r =
      SkywalkRails.railsOf (SkywalkRails.step ((SkywalkTrace.next^[i-start]) r))
    rw [Function.iterate_succ_apply']
    rfl
  refine ⟨result.1,{
    start_le := by omega
    valueA := ?_
    valueB := ?_
    previous := ?_
    letters := ?_
    futureA := tails.1
    futureB := tails.2
    futureS := ?_
    carry := ?_ }⟩
  · rw [←nextViews.1,retained.1,nextRail]
    exact ho.1
  · rw [←nextViews.2,retained.2,nextRail]
    exact ho.2.1
  · change out.basis (w (skywalkPoolPreviousId (i+1)))=(railAt r (i+1-start)).g
    rw [skywalkPoolPreviousId,if_neg (by omega : i+1≠0),nextRail]
    simpa only [Nat.add_sub_cancel,SkywalkRails.railsOf] using ho.2.2.1
  · intro j hj0 hj
    by_cases now : j=i
    · subst j
      rw [show i-start=i-start from rfl]
      exact ⟨ho.2.2.1,ho.2.2.2.1⟩
    · have old : j < i := by omega
      have letter := hs.letters j hj0 old
      have keepG : out.basis (w j)=s.basis (w j) := by
        by_cases last : j+1=i
        · have hkeep := W.compactSkywalkStageMetadata_previousG w i (by omega)
            ri.a ri.b ri.g s.basis out.basis input ho
          have he : i-1=j := by omega
          simpa only [he] using hkeep
        · exact W.compactSkywalkStageMetadata_pastG w i hi0 hn j (by omega) s m
      have keepS := W.compactSkywalkStageMetadata_pastS w i hi0 hn j old s m
      exact ⟨keepG.trans letter.1,keepS.trans letter.2⟩
  · intro j hj hj512
    exact (W.compactSkywalkStageMetadata_futureS w i hi0 hn j (by omega) hj512 s m).trans
      (hs.futureS j (by omega) hj512)
  · apply (regValue_zero _ _).mpr
    intro q hq
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hq
    simp only [List.mem_range'_1] at hj
    by_cases used : j < 1540+(W.compactSkywalkTickPreWidth i-1)
    · have clean := (regValue_zero _ _).mp ho.2.2.2.2.2.1
      apply clean
      change w j∈wireBlock w 1540 (W.compactSkywalkTickPreWidth i-1)
      exact List.mem_map.mpr ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩
    · have keep := W.compactSkywalkStageMetadata_carryTail w i hi0 hn j
        (by omega) (by omega) s m
      exact keep.trans ((regValue_zero _ _).mp hs.carry (w j)
        (List.mem_map.mpr ⟨j,by simp only [List.mem_range'_1]; omega,rfl⟩))












/-- Total scheduled saving against the reference compact reverse tick. -/
def reverseDue (i : Nat) : Nat :=
  1 + (if W.trimTick i then 1 else 0)






theorem reverseDue_eq_one (i : Nat) (hi0 : 385 ≤ i) : reverseDue i=1 := by
  have nt : ¬W.trimTick i := by unfold W.trimTick; omega
  simp only [reverseDue,if_neg nt,Nat.add_zero]


theorem reverse_tick_counts (w : Nat → Wire) (i : Nat)
    (hi0 : 385 ≤ i) (hi1 : i ≤ 509) (hn : (skywalkPoolWires w).Nodup) :
    toffoliCount (W.ReverseCarry.compactReceiverTick w i)=
        (W.compactSkywalkTickPreWidth i-1)+
          (W.compactSkywalkTickPostWidth i-1)-reverseDue i ∧
    measurementCount (W.ReverseCarry.compactReceiverTick w i)=
        W.compactSkywalkTickPostWidth i-1 := by
  have a := W.ReverseCarry.compactReceiverTick_counts w i (by omega) hn
  have b := W.compactSkywalkReverseTick_counts w i (by omega) hn
  have widths := W.compactSkywalkTick_width_bounds i (by omega)
  have due := reverseDue_eq_one i hi0
  have nt : ¬W.trimTick i := by unfold W.trimTick; omega
  simp only [nt,if_false,Nat.add_zero] at a
  rw [due]
  constructor <;> omega











