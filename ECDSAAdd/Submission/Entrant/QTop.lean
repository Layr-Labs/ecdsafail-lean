theorem p1_mod_lift (M a V : Nat) (pos : 0<M) (small : a<8) :
    (a+8*V)%(8*M)=a+8*(V%M) := by
  have bound : a+8*(V%M)<8*M := by have h := Nat.mod_lt V pos; omega
  calc
    (a+8*V)%(8*M)=(a+8*(V%M)+(8*M)*(V/M))%(8*M) := by
