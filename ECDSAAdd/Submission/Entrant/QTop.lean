    exact ⟨⟨⟨⟨⟨⟨smk,carry.1.1⟩,carry.1.2⟩,carry.2⟩,c5⟩,scl⟩,jc⟩
  · have wj := OwnDiagLowK.jregsS_W L hw ext src dst (by omega) hlen he
