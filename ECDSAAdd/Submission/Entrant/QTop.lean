/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoanDivEndpointSupport_at_QTop` -/
section Merge_StairLoanDivEndpointSupport_at_QTop

/-!
# The loaned division endpoint stays inside the record endpoint

LT8's `CompareDecoder.BoundaryLoan.endPacket760DivLoan` (division endpoint with
the 44 exclusive roles hosted on ladder carries 11–54) has the same wrappers as
`R2SqEp760.endPacket760 true`.  This module proves

* `cellDecoderLoan_sub : wires cellDecoderLoan ⊆ wires CompareDecoder.cellDecoderNext`
* `endPacket760DivLoan_sub :
    wires endPacket760DivLoan ⊆ wires (R2SqEp760.endPacket760 true)`

without evaluating either decoder.  Every wire of the loaned comparison window
is a comparison input (`xs`, restored by `restoreSource`), a ladder carry
(`cs`, inverted by `invertCarry` inside `cmpFront`), the carry-in `cin`, or a
wire of the record's `lowBlock` / `cmpBack` middle block.  The ladder facts are
generic in the literal bits; the only concrete check is that the 44 roles are
ladder carries (`holes_in_carry_check`, 44 × 255 comparisons).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.CompareDecoder.BoundaryLoan.Inclusion

open Arithmetic TerminalGraph DirectDecoder DecoderCells5 DecoderMeasuredTail DecoderBiasReuse
open Challenge MappedCompressed

attribute [local irreducible] wires

/-! ## Variable-program helpers -/

theorem mem_nine {P1 P2 P3 P4 P5 P6 P7 P8 P9 : Program} {q : Wire}
    (h : q ∈ wires P1 ∨ q ∈ wires P2 ∨ q ∈ wires P3 ∨ q ∈ wires P4 ∨
      q ∈ wires P5 ∨ q ∈ wires P6 ∨ q ∈ wires P7 ∨ q ∈ wires P8 ∨ q ∈ wires P9) :
    q ∈ wires (P1 ++ P2 ++ P3 ++ P4 ++ P5 ++ P6 ++ P7 ++ P8 ++ P9) := by
  simp only [wires_append, Finset.mem_union, or_assoc]
  exact h

theorem mem_four {P1 P2 P3 P4 : Program} {q : Wire}
    (h : q ∈ wires P1 ∨ q ∈ wires P2 ∨ q ∈ wires P3 ∨ q ∈ wires P4) :
    q ∈ wires (P1 ++ P2 ++ P3 ++ P4) := by
  simp only [wires_append, Finset.mem_union, or_assoc]
  exact h

theorem append_sub (P Q P0 Q0 : Program)
    (hp : wires P ⊆ wires P0) (hq : wires Q ⊆ wires Q0) :
    wires (P ++ Q) ⊆ wires (P0 ++ Q0) := by
  rw [wires_append, wires_append]
  exact Finset.union_subset_union hp hq

theorem rename_sub (f : Wire → Wire) (P Q : Program)
    (sub : wires P ⊆ wires Q) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) := by
  rw [renameProgram_support, renameProgram_support]
  exact Finset.image_mono f sub

theorem mem_map_X (l : List Wire) (q : Wire) (h : q ∈ wires (l.map Instr.X)) :
    q ∈ l := by
  induction l with
  | nil => simp [wires] at h
  | cons a l ih =>
      simp only [List.map_cons, wires, Instr.wires, Finset.mem_union,
        Finset.mem_singleton] at h
      rcases h with h | h
      · exact List.mem_cons.mpr (Or.inl h)
      · exact List.mem_cons.mpr (Or.inr (ih h))

theorem map_X_mem (l : List Wire) (q : Wire) (h : q ∈ l) :
    q ∈ wires (l.map Instr.X) := by
  induction l with
  | nil => simp at h
  | cons a l ih =>
      simp only [List.map_cons, wires, Instr.wires, Finset.mem_union,
        Finset.mem_singleton]
      rcases List.mem_cons.mp h with h | h
      · exact Or.inl h
      · exact Or.inr (ih h)

theorem map_CX_mem (c : Wire) (l : List Wire) (q : Wire) (h : q ∈ l) :
    q ∈ wires (l.map (fun t => Instr.CX c t)) := by
  induction l with
  | nil => simp at h
  | cons a l ih =>
      simp only [List.map_cons, wires, Finset.mem_union]
      rcases List.mem_cons.mp h with h | h
      · left
        simp [Instr.wires, h]
      · exact Or.inr (ih h)

/-! ## Literal-bit carry layers touch only their inputs, carries and carry-in -/

theorem gate_wires (b : MappedBit) (y c0 c : Wire) (hw : b.wire = none) (q : Wire)
    (hq : q ∈ wires (mappedMajority b y c0 c) ∨ q ∈ wires (mappedEraseCarry b y c0 c)) :
    q = y ∨ q = c0 ∨ q = c := by
  cases hf : b.flip <;>
    simp [mappedMajority, mappedEraseCarry, hw, hf, wires, Instr.wires,
      correctionWires] at hq <;> tauto

theorem layer_facts (bits : List MappedBit) :
    ∀ (ys hs : List Wire) (c0 : Wire), (∀ b ∈ bits, b.wire = none) →
      ∀ l ∈ StairLoan.mappedLayers bits ys hs c0,
        l.host ∈ hs ∧
          ∀ q, q ∈ wires l.up ∨ q ∈ wires l.erase → q ∈ ys ∨ q ∈ hs ∨ q = c0 := by
  induction bits with
  | nil =>
      intro ys hs c0 _ l hl
      simp [StairLoan.mappedLayers] at hl
  | cons b bits ih =>
      intro ys hs c0 hb l hl
      rcases bits with _ | ⟨b', bits'⟩
      · simp [StairLoan.mappedLayers] at hl
      rcases ys with _ | ⟨y, _ | ⟨y', ys'⟩⟩
      · simp [StairLoan.mappedLayers] at hl
      · simp [StairLoan.mappedLayers] at hl
      rcases hs with _ | ⟨c, hs'⟩
      · simp [StairLoan.mappedLayers] at hl
      simp only [StairLoan.mappedLayers, List.mem_cons] at hl
      rcases hl with rfl | hl
      · refine ⟨List.mem_cons.mpr (Or.inl rfl), ?_⟩
        intro q hq
        rcases gate_wires b y c0 c (hb b (List.mem_cons.mpr (Or.inl rfl))) q hq with
          h | h | h
        · exact Or.inl (List.mem_cons.mpr (Or.inl h))
        · exact Or.inr (Or.inr h)
        · exact Or.inr (Or.inl (List.mem_cons.mpr (Or.inl h)))
      · have r := ih (y' :: ys') hs' c
          (fun x hx => hb x (List.mem_cons.mpr (Or.inr hx))) l hl
        refine ⟨List.mem_cons.mpr (Or.inr r.1), ?_⟩
        intro q hq
        rcases r.2 q hq with h | h | h
        · exact Or.inl (List.mem_cons.mpr (Or.inr h))
        · exact Or.inr (Or.inl (List.mem_cons.mpr (Or.inr h)))
        · exact Or.inr (Or.inl (List.mem_cons.mpr (Or.inl h)))

/-- The comparison ladder: hosts are carries, no sum writes, and every wire of
an up/erase step is an input, a carry, or the carry-in. -/
theorem ladder_facts : ∀ l ∈ ladder,
    l.host ∈ cs ∧ l.finish = [] ∧
      ∀ q, q ∈ wires l.up ∨ q ∈ wires l.erase → q ∈ xs ∨ q ∈ cs ∨ q = cin := by
  intro l hl
  unfold ladder at hl
  obtain ⟨l0, h0, rfl⟩ := List.mem_map.mp hl
  have bitsNone : ∀ b ∈ borrowBits, b.wire = none := by
    intro b hb
    unfold borrowBits at hb
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hb
    rfl
  have f := layer_facts borrowBits (xs ++ [cin]) cs cin bitsNone l0 h0
  refine ⟨f.1, rfl, ?_⟩
  intro q hq
  rcases f.2 q hq with h | h | h
  · rcases List.mem_append.mp h with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (List.mem_singleton.mp h))
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr h)

theorem emitUps_all (ls : List StairLoan.CarryLayer) (P : Wire → Prop)
    (h : ∀ l ∈ ls, ∀ q ∈ wires l.up, P q) :
    ∀ q ∈ wires (StairLoan.emitUps ls), P q := by
  induction ls with
  | nil =>
      intro q hq
      simp [StairLoan.emitUps, wires] at hq
  | cons l ls ih =>
      intro q hq
      simp only [StairLoan.emitUps, wires_append, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact h l (List.mem_cons.mpr (Or.inl rfl)) q hq
      · exact ih (fun l' hl' => h l' (List.mem_cons.mpr (Or.inr hl'))) q hq

theorem emitDowns_all (ls : List StairLoan.CarryLayer) (P : Wire → Prop)
    (h : ∀ l ∈ ls, ∀ q ∈ wires l.down, P q) :
    ∀ q ∈ wires (StairLoan.emitDowns ls), P q := by
  induction ls with
  | nil =>
      intro q hq
      simp [StairLoan.emitDowns, wires] at hq
  | cons l ls ih =>
      intro q hq
      simp only [StairLoan.emitDowns, wires_append, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact ih (fun l' hl' => h l' (List.mem_cons.mpr (Or.inr hl'))) q hq
      · exact h l (List.mem_cons.mpr (Or.inl rfl)) q hq

theorem ups_ladder (ls : List StairLoan.CarryLayer) (sub : ∀ l ∈ ls, l ∈ ladder) :
    ∀ q ∈ wires (StairLoan.emitUps ls), q ∈ xs ∨ q ∈ cs ∨ q = cin :=
  emitUps_all ls _ (fun l hl q hq => (ladder_facts l (sub l hl)).2.2 q (Or.inl hq))

theorem downs_ladder (ls : List StairLoan.CarryLayer) (sub : ∀ l ∈ ls, l ∈ ladder) :
    ∀ q ∈ wires (StairLoan.emitDowns ls), q ∈ xs ∨ q ∈ cs ∨ q = cin := by
  apply emitDowns_all ls
  intro l hl q hq
  have f := ladder_facts l (sub l hl)
  unfold StairLoan.CarryLayer.down at hq
  rw [wires_append, f.2.1] at hq
  rcases Finset.mem_union.mp hq with hq | hq
  · exact f.2.2 q (Or.inr hq)
  · simp [wires] at hq

theorem head_ladder : ∀ l ∈ headL, l ∈ ladder :=
  fun _ hl => List.mem_of_mem_take hl

theorem tail_ladder : ∀ l ∈ tailL, l ∈ ladder :=
  fun _ hl => List.mem_of_mem_drop hl

/-- The only concrete check: the 44 roles are ladder carries (positions
208–252 without 248 of `base 512 ..`). -/
theorem holes_in_carry_check :
    StairBoundaryLoan.exclusiveHoles.all (fun q => decide (q ∈ cs)) = true := by
  decide +kernel

theorem holes_in_carry : ∀ q ∈ StairBoundaryLoan.exclusiveHoles, q ∈ cs := by
  intro q hq
  exact of_decide_eq_true (List.all_eq_true.mp holes_in_carry_check q hq)

/-! ## Membership in the record decoder -/

theorem ladder_in_record (q : Wire) (h : q ∈ xs ∨ q ∈ cs ∨ q = cin) :
    q ∈ wires CompareDecoder.cellDecoderNext := by
  unfold CompareDecoder.cellDecoderNext
  rcases h with h | h | h
  · apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_)))))))
    unfold TerminalGraph.restoreSource
    exact map_CX_mem _ _ q h
  · apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))
    unfold CompareDecoder.cmpFront
    apply mem_four
    refine Or.inr (Or.inr (Or.inr ?_))
    unfold CompareDecoder.invertCarry
    exact map_X_mem _ q h
  · apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))
    unfold CompareDecoder.cmpFront
    apply mem_four
    refine Or.inl ?_
    subst h
    simp [wires, Instr.wires, cin]

theorem top760_in_record : ∀ q ∈ wires top760, q ∈ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  unfold top760 at hq
  simp only [wires_append, Finset.mem_union, or_assoc] at hq
  rcases hq with hn | hx | hl | hb | hl' | hk | hn'
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn))
  · refine ladder_in_record q (Or.inr (Or.inr ?_))
    simpa [wires, Instr.wires] using hx
  · have h : q ∈ (cs.drop 5).take 6 := mem_map_X _ q hl
    exact ladder_in_record q (Or.inr (Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h))))
  · unfold CompareDecoder.cellDecoderNext
    apply mem_nine
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hb)))))
  · have h : q ∈ (cs.drop 5).take 6 := mem_map_X _ q hl'
    exact ladder_in_record q (Or.inr (Or.inl (List.mem_of_mem_drop (List.mem_of_mem_take h))))
  · unfold CompareDecoder.cellDecoderNext
    apply mem_nine
    refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))))
    unfold CompareDecoder.cmpBack
    apply mem_four
    exact Or.inr (Or.inl hk)
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn'))

theorem emitLoan_in_record :
    ∀ q ∈ wires (StairLoan.emitLoan 44 StairBoundaryLoan.exclusiveHoles tailL top760),
      q ∈ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  have env := StairLoanSupport.emitLoan_support_envelope 44
    StairBoundaryLoan.exclusiveHoles tailL top760 hq
  simp only [Finset.mem_union, List.mem_toFinset] at env
  rcases env with (sweep | role) | host
  · unfold StairLoan.emitSweep at sweep
    simp only [wires_append, Finset.mem_union] at sweep
    rcases sweep with (up | top) | down
    · exact ladder_in_record q (ups_ladder tailL tail_ladder q up)
    · exact top760_in_record q top
    · exact ladder_in_record q (downs_ladder tailL tail_ladder q down)
  · exact ladder_in_record q (Or.inr (Or.inl (holes_in_carry q (List.mem_of_mem_take role))))
  · unfold StairLoan.layerHosts at host
    obtain ⟨l, hl, rfl⟩ := List.mem_map.mp host
    exact ladder_in_record _
      (Or.inr (Or.inl (ladder_facts l (tail_ladder l (List.mem_of_mem_take hl))).1))

theorem window_in_record : ∀ q ∈ wires (window760 44),
    q ∈ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  unfold window760 at hq
  simp only [wires_append, Finset.mem_union, or_assoc] at hq
  rcases hq with hn | hu | hl | hd | hn'
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn))
  · exact ladder_in_record q (ups_ladder headL head_ladder q hu)
  · exact emitLoan_in_record q hl
  · exact ladder_in_record q (downs_ladder headL head_ladder q hd)
  · exact ladder_in_record q (Or.inl (mem_map_X _ q hn'))

/-! ## The loaned decoder and endpoint -/

theorem cellDecoderLoan_sub :
    wires cellDecoderLoan ⊆ wires CompareDecoder.cellDecoderNext := by
  intro q hq
  unfold cellDecoderLoan at hq
  simp only [wires_append, Finset.mem_union, or_assoc] at hq
  rcases hq with h | h | h | h | h | h | h | h | h
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inl h)
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inl h))
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inl h)))
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inr (Or.inl h))))
  · refine ladder_in_record q (Or.inr (Or.inr ?_))
    simpa [wires, Instr.wires] using h
  · exact window_in_record q h
  · simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_singleton] at h
    rcases h with h | h | h
    · subst h
      unfold CompareDecoder.cellDecoderNext
      apply mem_nine
      refine Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ?_))))))
      unfold CompareDecoder.cmpBack
      apply mem_four
      refine Or.inr (Or.inl ?_)
      simp [wires, Instr.wires]
    · exact ladder_in_record q (Or.inr (Or.inr h))
    · simp at h
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  · unfold CompareDecoder.cellDecoderNext
    exact mem_nine (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))))))

theorem endPacket760_true_shape :
    R2SqEp760.endPacket760 true =
      renameProgram (Equiv.swap (base 760) (base 717))
        (renameProgram (shifted Placement5.pi0)
          (ControlLoan1589.loanWindow (base 510) (base 2409) (base 719)
            (CompareDecoder.cellDecoderNext ++
              List.replicate 507 (Instr.measureX (base 512) [] [])))) := by
  unfold R2SqEp760.endPacket760 Rolling1588Lifetime.endPacket
