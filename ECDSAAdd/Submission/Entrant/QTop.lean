theorem old_program_slots131 (x y carry : List Wire) (cin : Wire)
    (hy : y.length=131) (hx : x.length=y.length) (hc : carry.length+1=y.length) :
    Challenge.gateSlots (CodexKnownOnesTail.program 124 x y carry cin)=1803 := by
