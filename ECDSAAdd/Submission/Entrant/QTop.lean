theorem swap_roleBack_of_fixed (d : Nat) (host : Wire)
    (fixed : ∀ r ∈ retiredRoles, Equiv.swap (base 760) host r = r) :
    ∀ q, Equiv.swap (base 760) host q ∈ (retiredRoles.take d).toFinset →
      q ∈ (retiredRoles.take d).toFinset := by
  intro q hq
  have member : Equiv.swap (base 760) host q ∈ retiredRoles.take d := by
    exact List.mem_toFinset.mp hq
  have eq := fixed (Equiv.swap (base 760) host q)
    (List.mem_of_mem_take member)
  have involution : Equiv.swap (base 760) host
      (Equiv.swap (base 760) host q) = q :=
    Equiv.swap_apply_self (base 760) host q
  have back : q = Equiv.swap (base 760) host q := by
    calc
      q = Equiv.swap (base 760) host
          (Equiv.swap (base 760) host q) := involution.symm
      _ = Equiv.swap (base 760) host q := eq
  exact List.mem_toFinset.mpr (back ▸ member)

