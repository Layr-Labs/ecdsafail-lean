private theorem inverseU2_away (d : Nat) (hd : d ≤ 68) :
    ∀ q ∈ wires inverseU2, q ∉ (retiredRoles.take d).toFinset := by
  apply support_away_of_staticPool760 d hd inverseU2
  intro q hq
  simp only [inverseU2, wires_append, wires_reverse, Finset.mem_union] at hq
  rcases hq with (exposure | compare) | unbias
  · exact exposure_staticPool760 exposure
  · exact prepareCompare_staticPool760 compare
  · simp only [BiasedInverse.unbiasView, wires_append, wires_reverse,
      Finset.mem_union] at unbias
    rcases unbias with front | sign
    · simp [wires, Instr.wires] at front
      subst q
      have bound : 254 < L760.r.length := by
        have w := BalancedCleanup.widths L760.toLayout
          (Q6EndpointCell.ports_widths base (base 2409))
        omega
      have member : L760.r.getD 254 0 ∈ L760.r := by
        rw [List.getD_eq_getElem _ _ bound]
        exact List.getElem_mem bound
      exact r_staticPool760 (List.mem_toFinset.mpr member)
    · exact prepareSign_staticPool760 sign
