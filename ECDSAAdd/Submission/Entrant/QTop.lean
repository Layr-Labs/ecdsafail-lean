  have a:=copyRegister_counts none S (R.drop 10) (by simp [hr,hs])
  simpa only [copyHigh] using a

                                                             
                                                                  
                                                                                                  
                                                                                       
                                                                      
                                                     
                                                    

                                                           
                                                                  
                                                                                               
                                   
                                                       
                                                       
                                                                                    

                                                           
                                                                  
                                                                                               
                                   
                                                       
                                                 
                                                                                    
                            
                            
