  head b' desired extra y' c ++ mappedAdd (b'::bs) (y'::ys) cs c ++
    mappedEraseCarry b y cin c ++ mappedSum b y cin

                                                                                          
                                                                                 
                                                     
                                                                                 
                               
                                                   
                                                             
                                                 
                                                             
                                                                   
                                                                            
                                             
                                      
                                                                                   
                                  
                

                                                                                              
                                                                                 
                                                           
                                                                             
                                                                                       
                                           
                                                                               
                                    
                                                                                 
                                                                                  
                              
             
           
             

