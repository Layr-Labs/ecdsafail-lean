private theorem q1_support (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths)
    (ext src dst : List Wire) (h128 : 128≤src.length) (hsmax : src.length≤129)
    (hlen : dst.length=2*src.length) (he : 300≤ext.length) :
