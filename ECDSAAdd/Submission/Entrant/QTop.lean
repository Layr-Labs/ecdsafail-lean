-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplaySupportBits =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588CodecCounts

/-! Bit and safety locality for compact checked circuit components. -/
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitsOf bitRun bitStep safe safeStep sim corrSim)

theorem sim_basis (P : Program) (m : List Bool) (ph : Bool) (x : Nat) :
    (sim P m ph x).2=bitRun P x := by
  induction P generalizing m ph x with
  | nil => rfl
  | cons i P ih =>
    cases i <;> simp only [sim,bitRun,bitStep] <;> apply ih

theorem bitRun_congr (P : Program) (S : Finset Wire) (support : wires P⊆S)
    (x y : Nat) (agree : ∀q∈S,x.testBit q=y.testBit q) :
    ∀q∈S,(bitRun P x).testBit q=(bitRun P y).testBit q := by
  have same := pool_run_agrees P S support [] ⟨false,bitsOf x⟩ ⟨false,bitsOf y⟩ rfl agree
  intro q hq
  simpa only [MeasuredCodec5.run_sim,sim_basis,bitsOf] using same.2 q hq

theorem bitRun_outside (P : Program) (x q : Nat) (off : q∉wires P) :
    (bitRun P x).testBit q=x.testBit q := by
  have same := run_preserves_outside P [] ⟨false,bitsOf x⟩ q off
  simpa only [MeasuredCodec5.run_sim,sim_basis,bitsOf] using same

private theorem corrSim_congr (cs : List Correction) (S : Finset Wire) (x y : Nat)
    (agree : ∀q∈S,x.testBit q=y.testBit q) :
    ∀ph,correctionWires cs⊆S → corrSim cs ph x=corrSim cs ph y := by
  induction cs with
  | nil => intro ph support; rfl
  | cons c cs ih =>
    intro ph support
    cases c with
    | Z t =>
      have ht := support (Finset.mem_union_left _ (Finset.mem_singleton_self t))
      have tail : correctionWires cs⊆S := fun _ h => support (Finset.mem_union_right _ h)
      simp only [corrSim]
      rw [agree t ht]
      exact ih _ tail
    | CZ a b =>
      have ha := support (Finset.mem_union_left _ (by simp : a∈({a,b} : Finset Wire)))
      have hb := support (Finset.mem_union_left _ (by simp : b∈({a,b} : Finset Wire)))
      have tail : correctionWires cs⊆S := fun _ h => support (Finset.mem_union_right _ h)
      simp only [corrSim]
      rw [agree a ha,agree b hb]
      exact ih _ tail

private theorem safeStep_congr (i : Instr) (S : Finset Wire) (support : i.wires⊆S)
    (x y : Nat) (agree : ∀q∈S,x.testBit q=y.testBit q) : safeStep i x=safeStep i y := by
  cases i with
  | X t => rfl
  | CX c t => rfl
  | CCX a b t => rfl
  | measureX t c0 c1 =>
    have ht : t∈S := support (Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_singleton_self t)))
    have h0 : correctionWires c0⊆S := fun _ h => support
      (Finset.mem_union_left _ (Finset.mem_union_right _ h))
    have h1 : correctionWires c1⊆S := fun _ h => support (Finset.mem_union_right _ h)
    have singleton : wires [Instr.measureX t c0 c1]⊆S := by
      simpa only [wires,Finset.union_empty] using support
    have cleared := bitRun_congr [Instr.measureX t c0 c1] S singleton x y agree
    simp only [bitRun,bitStep] at cleared
    simp only [safeStep]
    rw [corrSim_congr c0 S _ _ cleared false h0,corrSim_congr c1 S _ _ cleared false h1,
      agree t ht]

theorem safe_congr (P : Program) (S : Finset Wire) (x y : Nat) :
    wires P⊆S → (∀q∈S,x.testBit q=y.testBit q) → safe P x=safe P y := by
  induction P generalizing x y with
  | nil => intro support agree; rfl
  | cons i P ih =>
    intro support agree
    have head : i.wires⊆S := fun _ h => support (Finset.mem_union_left _ h)
    have tail : wires P⊆S := fun _ h => support (Finset.mem_union_right _ h)
    have singleton : wires [i]⊆S := by simpa only [wires,Finset.union_empty] using head
    have next := bitRun_congr [i] S singleton x y agree
    simp only [bitRun] at next
    simp only [safe]
    rw [safeStep_congr i S head x y agree,ih _ _ tail next]

theorem bitRun_lt (P : Program) (n : Nat) (support : wires P⊆Finset.range n)
    (x : Nat) (hx : x<2^n) : bitRun P x<2^n := by
  have modEq : (bitRun P x)%2^n=bitRun P x := by
    apply Nat.eq_of_testBit_eq
    intro q
    by_cases low : q<n
    · simp only [Nat.testBit_mod_two_pow,low,decide_true,Bool.true_and]
    · have off : q∉wires P := fun used => low (Finset.mem_range.mp (support used))
      have zero : x.testBit q=false := Nat.testBit_lt_two_pow
        (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by decide) (Nat.le_of_not_gt low)))
      simp only [Nat.testBit_mod_two_pow,low,decide_false,Bool.false_and,
        bitRun_outside P x q off,zero]
  rw [←modEq]
  exact Nat.mod_lt _ (pow_pos (by decide) _)

theorem bitRun_commute (P Q : Program) (apart : Disjoint (wires P) (wires Q)) (x : Nat) :
    bitRun Q (bitRun P x)=bitRun P (bitRun Q x) := by
  have pInput : ∀q∈wires P,(bitRun Q x).testBit q=x.testBit q := by
    intro q hq
    exact bitRun_outside Q x q (fun used => Finset.disjoint_left.mp apart hq used)
  have qInput : ∀q∈wires Q,(bitRun P x).testBit q=x.testBit q := by
    intro q hq
    exact bitRun_outside P x q (fun used => Finset.disjoint_left.mp apart used hq)
  have pSame := bitRun_congr P (wires P) (Finset.Subset.refl _) _ _ pInput
  have qSame := bitRun_congr Q (wires Q) (Finset.Subset.refl _) _ _ qInput
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases hp : q∈wires P
  · rw [bitRun_outside Q _ q (fun hq => Finset.disjoint_left.mp apart hp hq)]
    exact (pSame q hp).symm
  · rw [bitRun_outside P _ q hp]
    by_cases hq : q∈wires Q
    · exact qSame q hq
    · rw [bitRun_outside Q _ q hq,bitRun_outside Q _ q hq,bitRun_outside P _ q hp]

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplayPermutations =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayBits
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplaySupportBits

/-! Symbolic port views for the regular-stage trit permutations. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitRun bitsOf)

theorem swapBit_testBit (a b x q : Nat) (away : a≠b) :
    (bitRun (swapBit a b) x).testBit q=
      if q=a then x.testBit b else if q=b then x.testBit a else x.testBit q := by
  have value : (run (swapBit a b) [] ⟨false,bitsOf x⟩).basis q=
      if q=a then x.testBit b else if q=b then x.testBit a else x.testBit q := by
    by_cases qa : q=a <;> by_cases qb : q=b <;>
      cases ha : x.testBit a <;> cases hb : x.testBit b <;>
      simp_all [swapBit,run,writeBit,Function.update,bitsOf]
  simpa only [MeasuredCodec5.run_sim,sim_basis,bitsOf] using value

theorem mid_support : wires midPerm⊆Finset.range 10 ∧ wires midInv⊆Finset.range 10 := by
  decide +kernel

theorem mid_legal (x : Nat) :
    MeasuredCodec5.legalNat (bitRun midPerm x)=MeasuredCodec5.legalNat x := by
  simp [MeasuredCodec5.legalNat,midPerm,swapTrit,bitRun_append,swapBit_testBit,
    Bool.and_assoc,Bool.and_comm,-Nat.testBit_zero]

theorem permA_legal (x : Nat) :
    MeasuredCodec5.legalNat (bitRun permA x)=MeasuredCodec5.legalNat x := by
  simp [MeasuredCodec5.legalNat,permA,swapTrit,bitRun_append,swapBit_testBit,
    Bool.and_assoc,Bool.and_left_comm,Bool.and_comm,-Nat.testBit_zero]

theorem permB_legal (x : Nat) :
    MeasuredCodec5.legalNat (bitRun permB x)=MeasuredCodec5.legalNat x := by
  simp [MeasuredCodec5.legalNat,permB,swapTrit,bitRun_append,swapBit_testBit,
    Bool.and_assoc,Bool.and_left_comm,Bool.and_comm,-Nat.testBit_zero]

theorem mid_inverse (x : Nat) : bitRun midInv (bitRun midPerm x)=x := by
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases low : q<10
  · interval_cases q <;> simp [midPerm,midInv,swapTrit,bitRun_append,swapBit_testBit,-Nat.testBit_zero]
  · rw [bitRun_outside midInv _ q (fun used => low (Finset.mem_range.mp (mid_support.2 used))),
      bitRun_outside midPerm _ q (fun used => low (Finset.mem_range.mp (mid_support.1 used)))]

theorem permA_view (x : Nat) :
    (bitRun permA x).testBit 6=x.testBit 0 ∧ (bitRun permA x).testBit 7=x.testBit 1 ∧
    (bitRun permA x).testBit 8=x.testBit 2 ∧ (bitRun permA x).testBit 9=x.testBit 3 := by
  simp [permA,swapTrit,bitRun_append,swapBit_testBit,-Nat.testBit_zero]

theorem permB_view (x : Nat) :
    (bitRun permB x).testBit 8=x.testBit 8 ∧ (bitRun permB x).testBit 9=x.testBit 9 := by
  simp [permB,swapTrit,bitRun_append,swapBit_testBit,-Nat.testBit_zero]

theorem permMid_view (x : Nat) :
    (bitRun (permA++midPerm) x).testBit 6=x.testBit 6 ∧
    (bitRun (permA++midPerm) x).testBit 7=x.testBit 7 ∧
    (bitRun (permA++midPerm) x).testBit 8=x.testBit 4 ∧
    (bitRun (permA++midPerm) x).testBit 9=x.testBit 5 := by
  simp [permA,midPerm,swapTrit,bitRun_append,swapBit_testBit,-Nat.testBit_zero]

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588CodecDefs =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayPermutations

/-! Full-State codec laws. Every record list is allowed, including empty lists. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Rolling1588
open Arithmetic Challenge RecordedQuantum Baselines
open MeasuredCodec5 (bitsOf legal legalNat bitRun safe run_sim sim_safe)


private theorem code_permutation_support (isA : Bool) :
    wires (if isA then permA else permB)⊆Finset.range 10 := by
  intro q used
  rw [←(code_support isA).1,codeEncode,wires_append]
  exact Finset.mem_union_left _ used

private theorem code_inverse_support (isA : Bool) :
    wires (if isA then invA else invB)⊆Finset.range 10 := by
  intro q used
  rw [←(code_support isA).2,codeDecode,wires_append]
  exact Finset.mem_union_right _ used

private theorem code_permutation_legal (isA : Bool) (x : Nat) :
    legalNat (bitRun (if isA then permA else permB) x)=legalNat x := by
  cases isA
  · exact Replay.permB_legal x
  · exact Replay.permA_legal x

private theorem code_permutation_parity (isA : Bool) (x : Nat) :
    ParityCodec5New.rawParity (bitsOf x)=
      ParityCodec5New.rawParity (bitsOf (bitRun (if isA then permA else permB) x)) := by
  cases isA <;> simp [ParityCodec5New.rawParity,bitsOf,permA,permB,swapTrit,
    Replay.bitRun_append,Replay.swapBit_testBit,Bool.xor_assoc,Bool.xor_left_comm,Bool.xor_comm,
    -Nat.testBit_zero]

private theorem code_permutation_inverse (isA : Bool) (x : Nat) :
    bitRun (if isA then invA else invB) (bitRun (if isA then permA else permB) x)=x := by
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases low : q<10
  · cases isA <;> interval_cases q <;>
      simp [invA,invB,permA,permB,swapTrit,Replay.bitRun_append,Replay.swapBit_testBit,
        -Nat.testBit_zero]
  · rw [Replay.bitRun_outside (if isA then invA else invB) _ q
      (fun used => low (Finset.mem_range.mp (code_inverse_support isA used))),
      Replay.bitRun_outside (if isA then permA else permB) x q
      (fun used => low (Finset.mem_range.mp (code_permutation_support isA used)))]

private theorem code_permutation_facts (isA : Bool) (x : Nat) (hx : x<1024) :
    bitRun (if isA then permA else permB) x<1024 ∧
    legalNat (bitRun (if isA then permA else permB) x)=legalNat x ∧
    ParityCodec5New.rawParity (bitsOf x)=
      ParityCodec5New.rawParity (bitsOf (bitRun (if isA then permA else permB) x)) ∧
    bitRun (if isA then invA else invB) (bitRun (if isA then permA else permB) x)=x :=
  ⟨Replay.bitRun_lt (if isA then permA else permB) 10 (code_permutation_support isA) x hx,
    code_permutation_legal isA x,code_permutation_parity isA x,code_permutation_inverse isA x⟩

private theorem code_twist_support : wires ParityCodec5New.twist⊆Finset.range 10 := by
  intro q used
  rw [←ParityCodec5New.support_exact.1,ParityCodec5New.encode,wires_append]
  exact Finset.mem_union_left _ used

private theorem code_twist_bit (x q : Nat) :
    (bitRun ParityCodec5New.twist x).testBit q=
      if q=9 then !x.testBit 9 ^^ x.testBit 8 else x.testBit q := by
  have view := congrArg (fun b : BasisState => b q)
    (ParityCodec5New.twist_basis ⟨false,bitsOf x⟩ [])
  simpa only [run_sim,Replay.sim_basis,bitsOf,writeBit,Function.update_apply] using view

private theorem code_twist_legal (x : Nat) :
    legalNat (bitRun ParityCodec5New.twist x)=legalNat x := by
  cases a : x.testBit 8 <;> cases b : x.testBit 9 <;>
    simp [legalNat,code_twist_bit,a,b,-Nat.testBit_zero]

private theorem code_twist_inverse (x : Nat) :
    bitRun ParityCodec5New.untwist (bitRun ParityCodec5New.twist x)=x := by
  apply Nat.eq_of_testBit_eq
  intro q
  have same := congrArg (fun s : State => s.basis q)
    (ParityCodec5New.twist_roundtrip ⟨false,bitsOf x⟩ [] [])
  simpa only [run_sim,Replay.sim_basis,bitsOf] using same

private theorem code_twist_facts (x : Nat) (hx : x<1024) :
    bitRun ParityCodec5New.twist x<1024 ∧
    legalNat (bitRun ParityCodec5New.twist x)=legalNat x ∧
    bitRun ParityCodec5New.untwist (bitRun ParityCodec5New.twist x)=x :=
  ⟨Replay.bitRun_lt ParityCodec5New.twist 10 code_twist_support x hx,
    code_twist_legal x,code_twist_inverse x⟩

private theorem code_parity_facts (x : Nat) (hx : x<1024) (hl : legalNat x=true) :
    safe ParityCodec5New.encode x=true ∧
    (bitRun ParityCodec5New.encode x).testBit 5=false ∧
    (bitRun ParityCodec5New.encode x).testBit 9=false ∧
    safe ParityCodec5New.decode (bitRun ParityCodec5New.encode x)=true ∧
    bitRun ParityCodec5New.decode (bitRun ParityCodec5New.encode x)=x := by
  have tw := code_twist_facts x hx
  have legalTwist := tw.2.1.trans hl
  have enc := MeasuredCodec5.finite_encode _ tw.1 legalTwist
  have dec := MeasuredCodec5.finite_decode _ tw.1 legalTwist
  have bitEncode : bitRun ParityCodec5New.encode x=
      bitRun MeasuredCodec5.encode (bitRun ParityCodec5New.twist x) :=
    Replay.bitRun_append ParityCodec5New.twist MeasuredCodec5.encode x
  have safeEncode : safe ParityCodec5New.encode x=true :=
    Replay.safe_append_of ParityCodec5New.twist MeasuredCodec5.encode x
      (Replay.safe_of_no_measurements ParityCodec5New.twist (by rfl) x) enc.1
  have oldDecode : bitRun MeasuredCodec5.decode (bitRun ParityCodec5New.encode x)=
      bitRun ParityCodec5New.twist x :=
    (congrArg (bitRun MeasuredCodec5.decode) bitEncode).trans dec.2
  have safeOldDecode : safe MeasuredCodec5.decode (bitRun ParityCodec5New.encode x)=true :=
    (congrArg (safe MeasuredCodec5.decode) bitEncode).trans dec.1
  have safeDecode : safe ParityCodec5New.decode (bitRun ParityCodec5New.encode x)=true :=
    Replay.safe_append_of MeasuredCodec5.decode ParityCodec5New.untwist _ safeOldDecode
      (Replay.safe_of_no_measurements ParityCodec5New.untwist (by rfl) _)
  have bitDecode : bitRun ParityCodec5New.decode (bitRun ParityCodec5New.encode x)=x :=
    (Replay.bitRun_append MeasuredCodec5.decode ParityCodec5New.untwist _).trans
      ((congrArg (bitRun ParityCodec5New.untwist) oldDecode).trans tw.2.2)
  exact ⟨safeEncode,(congrArg (fun n : Nat => n.testBit 5) bitEncode).trans enc.2.1,
    (congrArg (fun n : Nat => n.testBit 9) bitEncode).trans enc.2.2,safeDecode,bitDecode⟩


theorem finite_code_encode (isA : Bool) : ∀x<1024,legalNat x=true →
    safe (codeEncode isA) x=true ∧
    (bitRun (codeEncode isA) x).testBit 5=false ∧
    (bitRun (codeEncode isA) x).testBit 9=false ∧
    ParityCodec5New.rawParity (bitsOf x)=
      ParityCodec5New.payloadParity (bitsOf (bitRun (codeEncode isA) x)) := by
  intro x hx hl
  have perm := code_permutation_facts isA x hx
  have valid := perm.2.1.trans hl
  have facts := code_parity_facts _ perm.1 valid
  have bitEncode : bitRun (codeEncode isA) x=
      bitRun ParityCodec5New.encode (bitRun (if isA then permA else permB) x) :=
    Replay.bitRun_append (if isA then permA else permB) ParityCodec5New.encode x
  have safePerm := Replay.safe_of_no_measurements (if isA then permA else permB)
    (by cases isA <;> rfl) x
  have safeEncode : safe (codeEncode isA) x=true :=
    Replay.safe_append_of (if isA then permA else permB) ParityCodec5New.encode x
      safePerm facts.1
  exact ⟨safeEncode,(congrArg (fun n : Nat => n.testBit 5) bitEncode).trans facts.2.1,
    (congrArg (fun n : Nat => n.testBit 9) bitEncode).trans facts.2.2.1,
    perm.2.2.1.trans ((ParityCodec5New.finite_parity _ perm.1 valid).trans
      (congrArg (fun n : Nat => ParityCodec5New.payloadParity (bitsOf n)) bitEncode).symm)⟩

theorem finite_code_roundtrip (isA : Bool) : ∀x<1024,legalNat x=true →
    safe (codeDecode isA) (bitRun (codeEncode isA) x)=true ∧
      bitRun (codeDecode isA) (bitRun (codeEncode isA) x)=x := by
  intro x hx hl
  have perm := code_permutation_facts isA x hx
  have facts := code_parity_facts _ perm.1 (perm.2.1.trans hl)
  have bitEncode : bitRun (codeEncode isA) x=
      bitRun ParityCodec5New.encode (bitRun (if isA then permA else permB) x) :=
    Replay.bitRun_append (if isA then permA else permB) ParityCodec5New.encode x
  have safeDecode : safe ParityCodec5New.decode (bitRun (codeEncode isA) x)=true :=
    (congrArg (safe ParityCodec5New.decode) bitEncode).trans facts.2.2.2.1
  have bitDecode : bitRun ParityCodec5New.decode (bitRun (codeEncode isA) x)=
      bitRun (if isA then permA else permB) x :=
    (congrArg (bitRun ParityCodec5New.decode) bitEncode).trans facts.2.2.2.2
  have safeInv := Replay.safe_of_no_measurements (if isA then invA else invB)
    (by cases isA <;> rfl) (bitRun ParityCodec5New.decode (bitRun (codeEncode isA) x))
  exact ⟨Replay.safe_append_of ParityCodec5New.decode (if isA then invA else invB)
      (bitRun (codeEncode isA) x) safeDecode safeInv,
    (Replay.bitRun_append ParityCodec5New.decode (if isA then invA else invB) _).trans
      ((congrArg (bitRun (if isA then invA else invB)) bitDecode).trans perm.2.2.2)⟩

end ECDSAAdd.Entrant.Rolling1588
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588CodecCore =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588CodecDefs

/-! Full-State codec laws. Every record list is allowed, including empty lists. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Rolling1588
open Arithmetic Challenge RecordedQuantum Baselines
open MeasuredCodec5 (bitsOf legal legalNat bitRun safe run_sim sim_safe)



theorem composition_eq (P Q R : Program)
    (pSupport : wires P⊆Finset.range 10) (qSupport : wires Q⊆Finset.range 10)
    (rSupport : wires R⊆Finset.range 10)
    (finite : ∀x<1024,legalNat x=true →
      safe P x=true ∧ safe Q (bitRun P x)=true ∧ safe R x=true ∧
        bitRun Q (bitRun P x)=bitRun R x)
    (s : State) (mP mQ mR : List Bool) (h : legal s.basis) :
    run Q mQ (run P mP s)=run R mR s := by
  obtain ⟨x,hx,lx,hb⟩ := MeasuredCodec5.local_word s h
  let t : State := ⟨s.phase,bitsOf x⟩
  have pp := pool_run_agrees P (Finset.range 10) pSupport mP s t rfl hb
  have qq := pool_run_agrees Q (Finset.range 10) qSupport mQ
    (run P mP s) (run P mP t) pp.1 pp.2
  have rr := pool_run_agrees R (Finset.range 10) rSupport mR s t rfl hb
  have f := finite x hx lx
  have modeled : run Q mQ (run P mP t)=run R mR t := by
    dsimp only [t]
    rw [run_sim,sim_safe P x f.1,run_sim,sim_safe Q _ f.2.1,
      run_sim,sim_safe R x f.2.2.1,f.2.2.2]
  apply State.extensionality
  · exact qq.1.trans ((congrArg State.phase modeled).trans rr.1.symm)
  · funext q
    by_cases hq : q∈Finset.range 10
    · exact (qq.2 q hq).trans
        ((congrArg (fun z : State => z.basis q) modeled).trans (rr.2 q hq).symm)
    · exact (run_preserves_outside Q mQ (run P mP s) q (fun h => hq (qSupport h))).trans
        ((run_preserves_outside P mP s q (fun h => hq (pSupport h))).trans
          (run_preserves_outside R mR s q (fun h => hq (rSupport h))).symm)

theorem code_encode_correct (isA : Bool) (s : State) (m : List Bool)
    (h : legal s.basis) :
    (run (codeEncode isA) m s).phase=s.phase ∧
      (run (codeEncode isA) m s).basis 5=false ∧
      (run (codeEncode isA) m s).basis 9=false := by
  obtain ⟨x,hx,lx,hb⟩ := MeasuredCodec5.local_word s h
  have support : wires (codeEncode isA)⊆Finset.range 10 := by
    simpa only [(code_support isA).1] using (Finset.Subset.refl (Finset.range 10))
  have agree := pool_run_agrees (codeEncode isA) (Finset.range 10) support m
    s ⟨s.phase,bitsOf x⟩ rfl hb
  have finite := finite_code_encode isA x hx lx
  have modeled := run_sim (codeEncode isA) m s.phase x
  rw [sim_safe (codeEncode isA) x finite.1] at modeled
  refine ⟨agree.1.trans ?_,(agree.2 5 (by decide)).trans ?_,(agree.2 9 (by decide)).trans ?_⟩
  · rw [modeled]
  · rw [modeled];exact finite.2.1
  · rw [modeled];exact finite.2.2.1

theorem code_encode_parity (isA : Bool) (s : State) (m : List Bool)
    (h : legal s.basis) :
    ParityCodec5New.rawParity s.basis=
      ParityCodec5New.payloadParity (run (codeEncode isA) m s).basis := by
  obtain ⟨x,hx,lx,hb⟩ := MeasuredCodec5.local_word s h
  have support : wires (codeEncode isA)⊆Finset.range 10 := by
    simpa only [(code_support isA).1] using (Finset.Subset.refl (Finset.range 10))
  have agree := pool_run_agrees (codeEncode isA) (Finset.range 10) support m
    s ⟨s.phase,bitsOf x⟩ rfl hb
  have finite := finite_code_encode isA x hx lx
  have modeled := run_sim (codeEncode isA) m s.phase x
  rw [sim_safe (codeEncode isA) x finite.1] at modeled
  have out (q : Nat) (hq : q<10) :
      (run (codeEncode isA) m s).basis q=bitsOf (bitRun (codeEncode isA) x) q :=
    (agree.2 q (Finset.mem_range.mpr hq)).trans (congrArg (fun z : State => z.basis q) modeled)
  have rawEq : ParityCodec5New.rawParity s.basis=ParityCodec5New.rawParity (bitsOf x) := by
    simp only [ParityCodec5New.rawParity,hb 1 (by decide),hb 3 (by decide),
      hb 5 (by decide),hb 7 (by decide),hb 9 (by decide)]
  rw [rawEq,finite.2.2.2]
  simp only [ParityCodec5New.payloadParity,out 0 (by decide),out 1 (by decide),
    out 2 (by decide),out 3 (by decide),out 4 (by decide),out 6 (by decide),
    out 7 (by decide),out 8 (by decide)]

theorem code_roundtrip (isA : Bool) (s : State) (mE mD : List Bool)
    (h : legal s.basis) : run (codeDecode isA) mD (run (codeEncode isA) mE s)=s := by
  have emptySupport : wires ([] : Program)⊆Finset.range 10 := by simp [wires]
  have result := composition_eq (codeEncode isA) (codeDecode isA) []
    (by simpa only [(code_support isA).1] using (Finset.Subset.refl (Finset.range 10)))
    (by simpa only [(code_support isA).2] using (Finset.Subset.refl (Finset.range 10))) emptySupport
    (by
      intro x hx lx
      have e := finite_code_encode isA x hx lx
      have d := finite_code_roundtrip isA x hx lx
      exact ⟨e.1,d.1,rfl,d.2⟩) s mE mD [] h
  exact result





end ECDSAAdd.Entrant.Rolling1588
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplayC3 =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplaySupportBits

/-! Check the C3 codec on its six ports and preserve every other input bit. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 3000000
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitRun safe)

def legal3 (x : Nat) : Bool :=
  !(x.testBit 0 && x.testBit 1) && !(x.testBit 2 && x.testBit 3) &&
    !(x.testBit 4 && x.testBit 5)

private theorem small_c3 : ∀x<64,legal3 x=true →
    safe e3 x=true ∧ (bitRun e3 x).testBit 5=false ∧
    safe d3 (bitRun e3 x)=true ∧ bitRun d3 (bitRun e3 x)=x := by
  decide +kernel

theorem legal3_of_legalNat (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    legal3 x=true := by
  simp only [MeasuredCodec5.legalNat,Bool.and_eq_true] at legal
  simpa only [legal3,Bool.and_eq_true] using legal.1.1

private theorem low_agree (x q : Nat) (hq : q∈Finset.range 6) :
    (x%64).testBit q=x.testBit q := by
  have low := Finset.mem_range.mp hq
  change (x%2^6).testBit q=x.testBit q
  simp only [Nat.testBit_mod_two_pow,low,decide_true,Bool.true_and]

theorem c3_facts (x : Nat) (legal : legal3 x=true) :
    safe e3 x=true ∧ (bitRun e3 x).testBit 5=false ∧
    safe d3 (bitRun e3 x)=true ∧ bitRun d3 (bitRun e3 x)=x := by
  have lowLegal : legal3 (x%64)=true := by
    simpa only [legal3,low_agree x 0 (by decide),low_agree x 1 (by decide),
      low_agree x 2 (by decide),low_agree x 3 (by decide),low_agree x 4 (by decide),
      low_agree x 5 (by decide)] using legal
  have finite := small_c3 (x%64) (Nat.mod_lt _ (by decide)) lowLegal
  have before : ∀q∈Finset.range 6,x.testBit q=(x%64).testBit q :=
    fun q hq => (low_agree x q hq).symm
  have encoded := bitRun_congr e3 (Finset.range 6) c3_support.1 x (x%64) before
  have decoded := bitRun_congr d3 (Finset.range 6) c3_support.2.1 _ _ encoded
  refine ⟨(safe_congr e3 _ x (x%64) c3_support.1 before).trans finite.1,
    (encoded 5 (by decide)).trans finite.2.1,
    (safe_congr d3 _ _ _ c3_support.2.1 encoded).trans finite.2.2.1,?_⟩
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases hq : q∈Finset.range 6
  · exact (decoded q hq).trans
      ((congrArg (fun z : Nat => z.testBit q) finite.2.2.2).trans (low_agree x q hq))
  · rw [bitRun_outside d3 _ q (fun used => hq (c3_support.2.1 used)),
      bitRun_outside e3 _ q (fun used => hq (c3_support.1 used))]

private theorem small_tail_ready : ∀x<64,legal3 x=true →
    !((bitRun e3 x).testBit 0 && (bitRun e3 x).testBit 3 &&
      (bitRun e3 x).testBit 4)=true := by decide +kernel

theorem c3_tail_ready (x : Nat) (legal : legal3 x=true) :
    !((bitRun e3 x).testBit 0 && (bitRun e3 x).testBit 3 &&
      (bitRun e3 x).testBit 4)=true := by
  have lowLegal : legal3 (x%64)=true := by
    simpa only [legal3,low_agree x 0 (by decide),low_agree x 1 (by decide),
      low_agree x 2 (by decide),low_agree x 3 (by decide),low_agree x 4 (by decide),
      low_agree x 5 (by decide)] using legal
  have before : ∀q∈Finset.range 6,x.testBit q=(x%64).testBit q :=
    fun q hq => (low_agree x q hq).symm
  have same := bitRun_congr e3 (Finset.range 6) c3_support.1 x (x%64) before
  have localReady := small_tail_ready (x%64) (Nat.mod_lt _ (by decide)) lowLegal
  simpa only [same 0 (by decide),same 3 (by decide),same 4 (by decide)] using localReady

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588StageData =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588CodecCore
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayC3
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayPermutations

/-! Compact history representations at the five selected-cell boundaries. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Rolling1588
open Arithmetic MappedCompressed Challenge RecordedQuantum Baselines
open MeasuredCodec5 (bitsOf legalNat bitRun safe)

def stageCode (divide : Bool) (k : Nat) : Program :=
  (if k=0 then (if divide then permA else permB)
    else if k=1 then permA++midPerm
    else (if divide then permB else permA)) ++ e3

def activeSlots (divide : Bool) (k : Nat) : List (Nat×Nat) :=
  if divide then
    if k=0 then [(0,3),(1,4)] else if k=1 then [(2,4),(3,3)] else [(4,4)]
  else
    if k=0 then [(4,4)] else if k=1 then [(3,3),(2,4)] else [(1,4),(0,3)]

def stageOpen : Program := dp++ParityCodec5New.untwist
def stageClose : Program := ParityCodec5New.twist++ep
def stageTransition (divide : Bool) (k : Nat) : Program :=
  if k=0 then (if divide then bridge7 else bridge5)
  else (if divide then bridge5 else bridge7inv)

def activeWord (divide : Bool) (k x : Nat) : Bool :=
  (activeSlots divide k).all fun pair =>
    ((bitRun (stageCode divide k) x).testBit (2*pair.2)==x.testBit (2*pair.1)) &&
    ((bitRun (stageCode divide k) x).testBit (2*pair.2+1)==x.testBit (2*pair.1+1))

theorem stageCode_support (divide : Bool) (k : Nat) (hk : k<3) :
    wires (stageCode divide k)⊆Finset.range 10 := by
  cases divide <;> interval_cases k <;> decide +kernel

theorem activeSlots_bound (divide : Bool) (k : Nat) (hk : k<3) :
    ∀pair∈activeSlots divide k,pair.1<5 ∧ pair.2<5 := by
  cases divide <;> interval_cases k <;> decide +kernel

def stagePermutation (divide : Bool) (k : Nat) : Program :=
  if k=0 then (if divide then permA else permB)
  else if k=1 then permA++midPerm else (if divide then permB else permA)

theorem stageCode_split (divide : Bool) (k : Nat) :
    stageCode divide k=stagePermutation divide k++e3 := rfl

theorem stagePermutation_safe (divide : Bool) (k : Nat) (hk : k<3) (x : Nat) :
    safe (stagePermutation divide k) x=true := by
  apply Replay.safe_of_no_measurements
  cases divide <;> interval_cases k <;> decide +kernel

theorem stagePermutation_legal (divide : Bool) (k : Nat) (hk : k<3)
    (x : Nat) (_hx : x<1024) (legal : legalNat x=true) :
    legalNat (bitRun (stagePermutation divide k) x)=true := by
  have a := (Replay.permA_legal x).trans legal
  have b := (Replay.permB_legal x).trans legal
  cases divide <;> interval_cases k <;>
    simp [stagePermutation,Replay.bitRun_append,Replay.mid_legal,a,b]

private def stageRawActive (divide : Bool) (k x : Nat) : Bool :=
  (activeSlots divide k).all fun pair =>
    ((bitRun (stagePermutation divide k) x).testBit (2*pair.2)==x.testBit (2*pair.1)) &&
    ((bitRun (stagePermutation divide k) x).testBit (2*pair.2+1)==x.testBit (2*pair.1+1))

private theorem stageRawActive_true (divide : Bool) (k : Nat) (hk : k<3) (x : Nat) :
    stageRawActive divide k x=true := by
  have a := Replay.permA_view x
  have b := Replay.permB_view x
  have m := Replay.permMid_view x
  cases divide <;> interval_cases k <;>
    simp [stageRawActive,stagePermutation,activeSlots,a.1,a.2.1,a.2.2.1,a.2.2.2,
      b.1,b.2,m.1,m.2.1,m.2.2.1,m.2.2.2]

private theorem activeSlots_high (divide : Bool) (k : Nat) (hk : k<3) :
    ∀pair∈activeSlots divide k,3≤pair.2 := by
  cases divide <;> interval_cases k <;> decide +kernel

theorem finite_stageCode (divide : Bool) (k : Nat) (hk : k<3) :
    ∀x,x<1024 → legalNat x=true →
      safe (stageCode divide k) x=true ∧
      (bitRun (stageCode divide k) x).testBit 5=false ∧ activeWord divide k x=true := by
  intro x hx legal
  have rawLegal := stagePermutation_legal divide k hk x hx legal
  have codec := Replay.c3_facts _ (Replay.legal3_of_legalNat _ rawLegal)
  refine ⟨?_,?_,?_⟩
  · rw [stageCode_split,Replay.safe_append,stagePermutation_safe divide k hk x,codec.1]
    rfl
  · rw [stageCode_split,Replay.bitRun_append]
    exact codec.2.1
  · apply List.all_eq_true.mpr
    intro pair used
    have high := activeSlots_high divide k hk pair used
    have off0 : 2*pair.2∉wires e3 := fun member =>
      (by have low:=Finset.mem_range.mp (c3_support.1 member);omega)
    have off1 : 2*pair.2+1∉wires e3 := fun member =>
      (by have low:=Finset.mem_range.mp (c3_support.1 member);omega)
    have raw := (List.all_eq_true.mp (stageRawActive_true divide k hk x)) pair used
    simpa only [stageCode_split,Replay.bitRun_append,
      Replay.bitRun_outside e3 (bitRun (stagePermutation divide k) x) (2*pair.2) off0,
      Replay.bitRun_outside e3 (bitRun (stagePermutation divide k) x) (2*pair.2+1) off1] using raw

theorem stageCode_correct (divide : Bool) (k : Nat) (hk : k<3)
    (state : State) (records : List Bool) (legal : MeasuredCodec5.legal state.basis) :
    (run (stageCode divide k) records state).phase=state.phase ∧
    (run (stageCode divide k) records state).basis 5=false ∧
    ∀logical physical,(logical,physical)∈activeSlots divide k →
      (run (stageCode divide k) records state).basis (2*physical)=state.basis (2*logical) ∧
      (run (stageCode divide k) records state).basis (2*physical+1)=state.basis (2*logical+1) := by
  obtain ⟨x,hx,lx,hb⟩ := MeasuredCodec5.local_word state legal
  have agree := pool_run_agrees (stageCode divide k) (Finset.range 10)
    (stageCode_support divide k hk) records state ⟨state.phase,bitsOf x⟩ rfl hb
  have finite := finite_stageCode divide k hk x hx lx
  have modeled := MeasuredCodec5.run_sim (stageCode divide k) records state.phase x
  rw [MeasuredCodec5.sim_safe (stageCode divide k) x finite.1] at modeled
  have modeledPhase := congrArg State.phase modeled
  have output (q : Nat) (hq : q<10) :
      (run (stageCode divide k) records state).basis q=
        (bitRun (stageCode divide k) x).testBit q :=
    (agree.2 q (Finset.mem_range.mpr hq)).trans (congrArg (fun s : State => s.basis q) modeled)
  refine ⟨agree.1.trans modeledPhase,?_,?_⟩
  · exact (output 5 (by decide)).trans finite.2.1
  · intro logical physical used
    have bounds := activeSlots_bound divide k hk (logical,physical) used
    have word := (List.all_eq_true.mp finite.2.2) (logical,physical) used
    have values :
        (bitRun (stageCode divide k) x).testBit (2*physical)=x.testBit (2*logical) ∧
        (bitRun (stageCode divide k) x).testBit (2*physical+1)=x.testBit (2*logical+1) := by
      simpa only [activeWord,Bool.and_eq_true,beq_iff_eq] using word
    exact ⟨(output _ (by omega)).trans
        (values.1.trans (hb _ (Finset.mem_range.mpr (by omega))).symm),
      (output _ (by omega)).trans
        (values.2.trans (hb _ (Finset.mem_range.mpr (by omega))).symm)⟩

end ECDSAAdd.Entrant.Rolling1588
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplayTail =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayC3
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayBits

/-! The outer codec tail depends on seven data bits and one clean hole. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitRun safe)

private def tailPorts : Finset Wire := {0,3,4,5,6,7,8,9}

def tailReady (x : Nat) : Bool :=
  !(x.testBit 0 && x.testBit 3 && x.testBit 4) &&
    !(x.testBit 6 && x.testBit 7) && !(x.testBit 8 && x.testBit 9)

private theorem tail_support : wires ep⊆tailPorts ∧ wires dp⊆tailPorts := by
  decide +kernel

private def tailView (x : Nat) : Nat :=
  MeasuredCodec5.pack10 (x.testBit 0) false false (x.testBit 3) (x.testBit 4)
    false (x.testBit 6) (x.testBit 7) (x.testBit 8) (x.testBit 9)

private theorem tailView_agree (x q : Nat) (hole : x.testBit 5=false)
    (hq : q∈tailPorts) : x.testBit q=(tailView x).testBit q := by
  have low : q<10 := by
    simp only [tailPorts,Finset.mem_insert,Finset.mem_singleton] at hq
    omega
  rw [tailView,MeasuredCodec5.pack10_bits _ _ _ _ _ _ _ _ _ _ q low]
  interval_cases q <;> simp_all [tailPorts,MeasuredCodec5.raw]

private theorem small_tail : ∀a b c u v w z : Bool,
    let x:=MeasuredCodec5.pack10 a false false b c false u v w z
    tailReady x=true → safe ep x=true ∧ safe dp (bitRun ep x)=true ∧
      bitRun dp (bitRun ep x)=x := by
  decide +kernel

theorem tail_facts (x : Nat) (hole : x.testBit 5=false) (ready : tailReady x=true) :
    safe ep x=true ∧ safe dp (bitRun ep x)=true ∧ bitRun dp (bitRun ep x)=x := by
  have before := tailView_agree x
  have readyView : tailReady (tailView x)=true := by
    simpa only [tailReady,←before 0 hole (by decide),←before 3 hole (by decide),
      ←before 4 hole (by decide),←before 6 hole (by decide),←before 7 hole (by decide),
      ←before 8 hole (by decide),←before 9 hole (by decide)] using ready
  have finite := small_tail (x.testBit 0) (x.testBit 3) (x.testBit 4)
    (x.testBit 6) (x.testBit 7) (x.testBit 8) (x.testBit 9) readyView
  have encoded := bitRun_congr ep tailPorts tail_support.1 x (tailView x)
    (fun q hq => before q hole hq)
  have decoded := bitRun_congr dp tailPorts tail_support.2 _ _ encoded
  refine ⟨(safe_congr ep tailPorts _ _ tail_support.1
      (fun q hq => before q hole hq)).trans finite.1,
    (safe_congr dp tailPorts _ _ tail_support.2 encoded).trans finite.2.1,?_⟩
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases hq : q∈tailPorts
  · exact (decoded q hq).trans
      ((congrArg (fun y : Nat => y.testBit q) finite.2.2).trans (before q hole hq).symm)
  · rw [bitRun_outside dp _ q (fun used => hq (tail_support.2 used)),
      bitRun_outside ep _ q (fun used => hq (tail_support.1 used))]

theorem c3_tail_facts (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe ep (bitRun e3 x)=true ∧
    safe dp (bitRun ep (bitRun e3 x))=true ∧
    bitRun dp (bitRun ep (bitRun e3 x))=bitRun e3 x := by
  have raw := legal3_of_legalNat x legal
  have codec := c3_facts x raw
  have ready := c3_tail_ready x raw
  simp only [Bool.decide_eq_true] at ready
  have high6 : 6∉wires e3 := fun h => by have low:=Finset.mem_range.mp (c3_support.1 h);omega
  have high7 : 7∉wires e3 := fun h => by have low:=Finset.mem_range.mp (c3_support.1 h);omega
  have high8 : 8∉wires e3 := fun h => by have low:=Finset.mem_range.mp (c3_support.1 h);omega
  have high9 : 9∉wires e3 := fun h => by have low:=Finset.mem_range.mp (c3_support.1 h);omega
  apply tail_facts _ codec.2.1
  rw [tailReady,bitRun_outside e3 x 6 high6,bitRun_outside e3 x 7 high7,
    bitRun_outside e3 x 8 high8,bitRun_outside e3 x 9 high9]
  simp only [MeasuredCodec5.legalNat,Bool.and_eq_true] at legal
  simp only [Bool.and_eq_true]
  exact ⟨⟨ready,legal.1.2⟩,legal.2⟩

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplayOuter =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayTail

/-! Cancel the outer codec tail and the fifth-trit twist. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitRun safe bitsOf)

private theorem twist_bit (x q : Nat) :
    (bitRun ParityCodec5New.twist x).testBit q=
      if q=9 then !x.testBit 9 ^^ x.testBit 8 else x.testBit q := by
  have value := congrFun (ParityCodec5New.twist_basis (⟨false,bitsOf x⟩ : State) []) q
  by_cases h : q=9
  · subst q
    simpa [MeasuredCodec5.run_sim,sim_basis,bitsOf,writeBit,Function.update,
      -Nat.testBit_zero] using value
  · simpa [MeasuredCodec5.run_sim,sim_basis,bitsOf,writeBit,Function.update,h,
      -Nat.testBit_zero] using value

theorem twist_legal (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    MeasuredCodec5.legalNat (bitRun ParityCodec5New.twist x)=true := by
  cases h8 : x.testBit 8 <;> cases h9 : x.testBit 9 <;>
    simp_all [MeasuredCodec5.legalNat,twist_bit,-Nat.testBit_zero]

private theorem twist_inverse (x : Nat) :
    bitRun ParityCodec5New.untwist (bitRun ParityCodec5New.twist x)=x := by
  apply Nat.eq_of_testBit_eq
  intro q
  have value := congrArg (fun s : State => s.basis q)
    (ParityCodec5New.twist_roundtrip (⟨false,bitsOf x⟩ : State) [] [])
  simpa only [MeasuredCodec5.run_sim,sim_basis,bitsOf] using value

private theorem twist_e3_apart : Disjoint (wires e3) (wires ParityCodec5New.twist) := by
  exact Finset.disjoint_of_subset_left c3_support.1 (by decide +kernel)

private theorem untwist_e3_apart : Disjoint (wires e3) (wires ParityCodec5New.untwist) := by
  exact Finset.disjoint_of_subset_left c3_support.1 (by decide +kernel)

private theorem outer_encode_split : MeasuredCodec5.encode=e3++ep := by
  symm
  exact List.take_append_drop 112 MeasuredCodec5.encode

theorem outer_open (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe (dp++ParityCodec5New.untwist)
      (bitRun (ParityCodec5New.twist++MeasuredCodec5.encode) x)=true ∧
    bitRun (dp++ParityCodec5New.untwist)
      (bitRun (ParityCodec5New.twist++MeasuredCodec5.encode) x)=bitRun e3 x := by
  have tail := c3_tail_facts _ (twist_legal x legal)
  have undo : safe ParityCodec5New.untwist
      (bitRun dp (bitRun ep (bitRun e3 (bitRun ParityCodec5New.twist x))))=true :=
    safe_of_no_measurements _ rfl _
  simp only [outer_encode_split,bitRun_append,safe_append]
  refine ⟨by rw [tail.2.1,undo];rfl,?_⟩
  rw [tail.2.2,bitRun_commute e3 ParityCodec5New.untwist untwist_e3_apart,
    twist_inverse]

theorem outer_close (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe (ParityCodec5New.twist++ep) (bitRun e3 x)=true ∧
    bitRun (ParityCodec5New.twist++ep) (bitRun e3 x)=
      bitRun (ParityCodec5New.twist++MeasuredCodec5.encode) x := by
  have tail := c3_tail_facts _ (twist_legal x legal)
  have commute := bitRun_commute e3 ParityCodec5New.twist twist_e3_apart x
  simp only [outer_encode_split,bitRun_append,safe_append]
  refine ⟨?_,?_⟩
  · rw [safe_of_no_measurements ParityCodec5New.twist rfl,commute,tail.1]
    rfl
  · rw [commute]

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplayRawH =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayBits
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplaySupportBits

/-! The cancelled Toffoli is one raw transvection on the retained two trits. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitRun safe)

private def head : Program := e3.take 15
private def rest : Program := e3.drop 16
private def front : Program := d3.take 96
private def tail : Program := d3.drop 97
private def K : Program := [.CCX 0 1 2]

def c3RawH : Program :=
  [.CX 4 3,.CX 5 3,.X 3,.X 2,.CCX 3 2 5,.X 2,.X 3,.CX 5 3,.CX 4 3]

theorem c3RawH_support : wires c3RawH⊆({2,3,4,5} : Finset Wire) := by decide +kernel

private theorem small : ∀x<64,
    bitRun (head++K) x=bitRun (c3RawH++head) x ∧
    bitRun (K++tail) x=bitRun (tail++c3RawH) x ∧
    bitRun (c3RawH++c3RawH) x=x := by decide +kernel

private theorem eq_of_small (P Q : Program)
    (hp : wires P⊆Finset.range 6) (hq : wires Q⊆Finset.range 6)
    (finite : ∀x<64,bitRun P x=bitRun Q x) (x : Nat) : bitRun P x=bitRun Q x := by
  have before : ∀q∈Finset.range 6,x.testBit q=(x%64).testBit q := by
    intro q hq
    have low := Finset.mem_range.mp hq
    change x.testBit q=(x%2^6).testBit q
    simp only [Nat.testBit_mod_two_pow,low,decide_true,Bool.true_and]
  have p := bitRun_congr P _ hp x (x%64) before
  have q := bitRun_congr Q _ hq x (x%64) before
  have localEq := finite (x%64) (Nat.mod_lt _ (by decide))
  apply Nat.eq_of_testBit_eq
  intro bit
  by_cases used : bit∈Finset.range 6
  · exact (p bit used).trans
      ((congrArg (fun z : Nat => z.testBit bit) localEq).trans (q bit used).symm)
  · rw [bitRun_outside P _ bit (fun h => used (hp h)),
      bitRun_outside Q _ bit (fun h => used (hq h))]

private theorem head_move (x : Nat) :
    bitRun K (bitRun head x)=bitRun head (bitRun c3RawH x) := by
  have equal := eq_of_small (head++K) (c3RawH++head)
    (by decide +kernel) (by decide +kernel) (fun x hx => (small x hx).1) x
  simpa only [bitRun_append] using equal

private theorem tail_move (x : Nat) :
    bitRun tail (bitRun K x)=bitRun c3RawH (bitRun tail x) := by
  have equal := eq_of_small (K++tail) (tail++c3RawH)
    (by decide +kernel) (by decide +kernel) (fun x hx => (small x hx).2.1) x
  simpa only [bitRun_append] using equal

theorem c3RawH_involution (x : Nat) : bitRun c3RawH (bitRun c3RawH x)=x := by
  have equal := eq_of_small (c3RawH++c3RawH) []
    (by decide +kernel) (by simp [wires]) (fun x hx => (small x hx).2.2) x
  simpa only [bitRun_append,bitRun] using equal

theorem c3RawH_safe (x : Nat) : safe c3RawH x=true :=
  safe_of_no_measurements c3RawH rfl x

private theorem encode_split : e3=(head++K)++rest := by decide +kernel
private theorem decode_split : d3=front++(K++tail) := by decide +kernel

theorem e3short_factor_bits (x : Nat) :
    bitRun e3 x=bitRun e3short (bitRun c3RawH x) := by
  rw [encode_split]
  change bitRun ((head++K)++rest) x=bitRun (head++rest) (bitRun c3RawH x)
  simp only [bitRun_append,head_move]

theorem e3short_factor_safe (x : Nat) :
    safe e3 x=safe e3short (bitRun c3RawH x) := by
  rw [encode_split]
  change safe ((head++K)++rest) x=safe (head++rest) (bitRun c3RawH x)
  simp only [safe_append,bitRun_append,safe_of_no_measurements head (by decide +kernel),
    safe_of_no_measurements K rfl,
    Bool.true_and,head_move]

theorem d3short_factor_bits (x : Nat) :
    bitRun d3 x=bitRun c3RawH (bitRun d3short x) := by
  rw [decode_split]
  change bitRun (front++(K++tail)) x=bitRun c3RawH (bitRun (front++tail) x)
  simp only [bitRun_append,tail_move]

theorem d3short_factor_safe (x : Nat) : safe d3 x=safe d3short x := by
  rw [decode_split]
  change safe (front++(K++tail)) x=safe (front++tail) x
  simp only [safe_append,safe_of_no_measurements tail (by decide +kernel),
    safe_of_no_measurements K rfl,Bool.and_true]

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588FirstTransitions =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayBits

/-! Abstract model composition keeps concrete C3 lists outside equality transport. -/
set_option autoImplicit false
namespace ECDSAAdd.Entrant.Rolling1588FirstReplay
open Arithmetic RecordedQuantum Rolling1588
open MeasuredCodec5 (bitRun safe)

theorem full_transition (D E : Program) (input raw : Nat)
    (decoded : bitRun D input=raw) (decodeSafe : safe D input=true)
    (encodeSafe : safe E raw=true) :
    safe (D++E) input=true ∧ bitRun (D++E) input=bitRun E raw := by
  constructor
  · apply Replay.safe_append_of D E input decodeSafe
    exact (congrArg (safe E) decoded).trans encodeSafe
  · exact (Replay.bitRun_append D E input).trans (congrArg (bitRun E) decoded)

theorem short_transition (D DS E ES H : Program) (input raw : Nat)
    (decoded : bitRun D input=raw) (decodeSafe : safe D input=true)
    (encodeSafe : safe E raw=true)
    (decodeBits : bitRun D input=bitRun H (bitRun DS input))
    (decodeSafety : safe D input=safe DS input)
    (encodeBits : bitRun E raw=bitRun ES (bitRun H raw))
    (encodeSafety : safe E raw=safe ES (bitRun H raw))
    (involution : ∀x,bitRun H (bitRun H x)=x) :
    safe (DS++ES) input=true ∧ bitRun (DS++ES) input=bitRun E raw := by
  have handoff : bitRun DS input=bitRun H raw :=
    (involution _).symm.trans (congrArg (bitRun H) (decodeBits.symm.trans decoded))
  have tailSafe : safe ES (bitRun DS input)=true :=
    (congrArg (safe ES) handoff).trans (encodeSafety.symm.trans encodeSafe)
  refine ⟨Replay.safe_append_of DS ES input (decodeSafety.symm.trans decodeSafe) tailSafe,?_⟩
  exact (Replay.bitRun_append DS ES input).trans
    ((congrArg (bitRun ES) handoff).trans encodeBits.symm)

end ECDSAAdd.Entrant.Rolling1588FirstReplay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588ReplayBridges =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayC3
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayRawH
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayPermutations
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588FirstTransitions

/-! Replace the regular short bridge by its complete decode/swap/encode model. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.Rolling1588.Replay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitRun safe)

theorem midInv_legal (x : Nat) :
    MeasuredCodec5.legalNat (bitRun midInv x)=MeasuredCodec5.legalNat x := by
  simp [MeasuredCodec5.legalNat,midInv,swapTrit,bitRun_append,swapBit_testBit,
    Bool.and_assoc,Bool.and_left_comm,Bool.and_comm,-Nat.testBit_zero]

theorem swap04_legal (x : Nat) :
    MeasuredCodec5.legalNat (bitRun (swapTrit 0 4) x)=MeasuredCodec5.legalNat x := by
  simp [MeasuredCodec5.legalNat,swapTrit,bitRun_append,swapBit_testBit,
    Bool.and_assoc,Bool.and_left_comm,Bool.and_comm,-Nat.testBit_zero]

private theorem rawH_swap_apart : Disjoint (wires c3RawH) (wires (swapTrit 0 4)) := by
  decide +kernel

theorem full_bridge (P : Program) (pure : measurementCount P=0) (x : Nat)
    (legal : MeasuredCodec5.legalNat x=true)
    (afterLegal : MeasuredCodec5.legalNat (bitRun P x)=true) :
    safe (d3++P++e3) (bitRun e3 x)=true ∧
    bitRun (d3++P++e3) (bitRun e3 x)=bitRun e3 (bitRun P x) := by
  have codec := c3_facts x (legal3_of_legalNat x legal)
  have after := c3_facts _ (legal3_of_legalNat _ afterLegal)
  have encoded : safe (P++e3) x=true :=
    safe_append_of P e3 x (safe_of_no_measurements P pure x) after.1
  have result := Rolling1588FirstReplay.full_transition d3 (P++e3) (bitRun e3 x) x
    codec.2.2.2 codec.2.2.1 encoded
  simpa only [bitRun_append] using result

theorem short_bridge (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe bridge5 (bitRun e3 x)=true ∧
    bitRun bridge5 (bitRun e3 x)=bitRun e3 (bitRun (swapTrit 0 4) x) := by
  have codec := c3_facts x (legal3_of_legalNat x legal)
  have swapPure : measurementCount (swapTrit 0 4)=0 := by decide +kernel
  have swapSafe := safe_of_no_measurements (swapTrit 0 4) swapPure
  have targetLegal := (swap04_legal x).trans legal
  have after := c3_facts _ (legal3_of_legalNat _ targetLegal)
  have decoded : bitRun (d3++swapTrit 0 4) (bitRun e3 x)=bitRun (swapTrit 0 4) x := by
    rw [bitRun_append,codec.2.2.2]
  have decodeSafe : safe (d3++swapTrit 0 4) (bitRun e3 x)=true :=
    safe_append_of _ _ _ codec.2.2.1 (swapSafe _)
  have decodeBits : bitRun (d3++swapTrit 0 4) (bitRun e3 x)=
      bitRun c3RawH (bitRun (d3short++swapTrit 0 4) (bitRun e3 x)) := by
    simp only [bitRun_append,d3short_factor_bits,
      bitRun_commute c3RawH (swapTrit 0 4) rawH_swap_apart]
  have decodeSafety : safe (d3++swapTrit 0 4) (bitRun e3 x)=
      safe (d3short++swapTrit 0 4) (bitRun e3 x) := by
    simp only [safe_append,swapSafe,Bool.and_true,d3short_factor_safe]
  have result := Rolling1588FirstReplay.short_transition
    (d3++swapTrit 0 4) (d3short++swapTrit 0 4) e3 e3short c3RawH
    (bitRun e3 x) (bitRun (swapTrit 0 4) x) decoded decodeSafe after.1
    decodeBits decodeSafety (e3short_factor_bits _) (e3short_factor_safe _)
    c3RawH_involution
  simpa only [bridge5,List.append_assoc] using result

private theorem permutation_ext (P Q : Program)
    (hp : wires P⊆Finset.range 10) (hq : wires Q⊆Finset.range 10)
    (view : ∀x q,q<10 → (bitRun P x).testBit q=(bitRun Q x).testBit q)
    (x : Nat) : bitRun P x=bitRun Q x := by
  apply Nat.eq_of_testBit_eq
  intro q
  by_cases low : q<10
  · exact view x q low
  · rw [bitRun_outside P _ q (fun used => low (Finset.mem_range.mp (hp used))),
      bitRun_outside Q _ q (fun used => low (Finset.mem_range.mp (hq used)))]

theorem swap_mid_to_B (x : Nat) :
    bitRun (swapTrit 0 4) (bitRun (permA++midPerm) x)=bitRun permB x := by
  have view : ∀y q,q<10 →
      (bitRun ((permA++midPerm)++swapTrit 0 4) y).testBit q=(bitRun permB y).testBit q := by
    intro y q low
    interval_cases q <;> simp [permA,midPerm,permB,swapTrit,bitRun_append,swapBit_testBit,-Nat.testBit_zero]
  have equal := permutation_ext ((permA++midPerm)++swapTrit 0 4) permB
    (by decide +kernel) (by decide +kernel) view x
  simpa only [bitRun_append] using equal

theorem swap_B_to_mid (x : Nat) :
    bitRun (swapTrit 0 4) (bitRun permB x)=bitRun (permA++midPerm) x := by
  have view : ∀y q,q<10 →
      (bitRun (permB++swapTrit 0 4) y).testBit q=
        (bitRun (permA++midPerm) y).testBit q := by
    intro y q low
    interval_cases q <;> simp [permA,midPerm,permB,swapTrit,bitRun_append,swapBit_testBit,-Nat.testBit_zero]
  have equal := permutation_ext (permB++swapTrit 0 4) (permA++midPerm)
    (by decide +kernel) (by decide +kernel) view x
  simpa only [bitRun_append] using equal

end ECDSAAdd.Entrant.Rolling1588.Replay
end -- original module boundary

