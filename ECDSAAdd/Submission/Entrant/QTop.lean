-- R2 speed helpers: Bool-scan bridges for `wires` facts (avoid building `Finset` unions in the kernel)
section
set_option maxHeartbeats 400000
namespace ECDSAAdd.Entrant.RS2Wires
open ECDSAAdd

theorem rs2_mem_wires (P : Program) (q : Wire) : q ∈ wires P ↔ ∃ i ∈ P, q ∈ i.wires := by
  induction P with
  | nil => simp [wires]
  | cons i P ih => simp [wires, ih]

theorem rs2_instr_mem (i : Instr) (x : Wire) : (match i with
   | .X t => decide (x = t) | .CX c t => decide (x = c) || decide (x = t)
   | .CCX a b t => decide (x = a) || (decide (x = b) || decide (x = t))
   | .measureX t c0 c1 => decide (x ∈ (Instr.measureX t c0 c1).wires)) = decide (x ∈ i.wires) := by
  cases i <;> simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton, Bool.decide_or]

theorem rs2_not_mem_wires (P : Program) (x : Wire) (h : P.any (fun i => match i with
   | .X t => decide (x = t) | .CX c t => decide (x = c) || decide (x = t)
   | .CCX a b t => decide (x = a) || (decide (x = b) || decide (x = t))
   | .measureX t c0 c1 => decide (x ∈ (Instr.measureX t c0 c1).wires)) = false) : x ∉ wires P := by
  rw [rs2_mem_wires]
  rintro ⟨i, hi, hx⟩
  have := List.any_eq_false.mp h i hi
  rw [rs2_instr_mem] at this
  exact this (decide_eq_true hx)

theorem rs2_mem_wires_of (P : Program) (x : Wire) (h : P.any (fun i => match i with
   | .X t => decide (x = t) | .CX c t => decide (x = c) || decide (x = t)
   | .CCX a b t => decide (x = a) || (decide (x = b) || decide (x = t))
   | .measureX t c0 c1 => decide (x ∈ (Instr.measureX t c0 c1).wires)) = true) : x ∈ wires P := by
  rw [rs2_mem_wires]
  obtain ⟨i, hi, hx⟩ := List.any_eq_true.mp h
  rw [rs2_instr_mem] at hx
  exact ⟨i, hi, of_decide_eq_true hx⟩

theorem rs2_wires_sub_range (P : Program) (n : Nat) (h : P.all (fun i => match i with
   | .X t => decide (t < n) | .CX c t => decide (c < n) && decide (t < n)
   | .CCX a b t => decide (a < n) && (decide (b < n) && decide (t < n))
   | .measureX t c0 c1 => decide ((Instr.measureX t c0 c1).wires ⊆ Finset.range n)) = true) :
    wires P ⊆ Finset.range n := by
  intro q hq
  rw [rs2_mem_wires] at hq
  obtain ⟨i, hi, hq⟩ := hq
  have h1 := List.all_eq_true.mp h i hi
  cases i with
  | X t =>
    simp only [Instr.wires, Finset.mem_singleton] at hq
    simp only [decide_eq_true_eq] at h1
    exact Finset.mem_range.mpr (hq ▸ h1)
  | CX c t =>
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
    rcases hq with rfl | rfl
    · exact Finset.mem_range.mpr h1.1
    · exact Finset.mem_range.mpr h1.2
  | CCX a b t =>
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
    rcases hq with rfl | rfl | rfl
    · exact Finset.mem_range.mpr h1.1
    · exact Finset.mem_range.mpr h1.2.1
    · exact Finset.mem_range.mpr h1.2.2
  | measureX t c0 c1 => exact (of_decide_eq_true h1) hq

theorem rs2_wires_sub_list (P : Program) (l : List Wire) (h : P.all (fun i => match i with
   | .X t => decide (t ∈ l) | .CX c t => decide (c ∈ l) && decide (t ∈ l)
   | .CCX a b t => decide (a ∈ l) && (decide (b ∈ l) && decide (t ∈ l))
   | .measureX t c0 c1 => decide ((Instr.measureX t c0 c1).wires ⊆ l.toFinset)) = true) :
    wires P ⊆ l.toFinset := by
  intro q hq
  rw [rs2_mem_wires] at hq
  obtain ⟨i, hi, hq⟩ := hq
  have h1 := List.all_eq_true.mp h i hi
  cases i with
  | X t =>
    simp only [Instr.wires, Finset.mem_singleton] at hq
    simp only [decide_eq_true_eq] at h1
    exact List.mem_toFinset.mpr (hq ▸ h1)
  | CX c t =>
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
    rcases hq with rfl | rfl
    · exact List.mem_toFinset.mpr h1.1
    · exact List.mem_toFinset.mpr h1.2
  | CCX a b t =>
    simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
    rcases hq with rfl | rfl | rfl
    · exact List.mem_toFinset.mpr h1.1
    · exact List.mem_toFinset.mpr h1.2.1
    · exact List.mem_toFinset.mpr h1.2.2
  | measureX t c0 c1 => exact (of_decide_eq_true h1) hq

theorem rs2_range_sub_wires (P : Program) (n : Nat) (h : (List.range n).all (fun x => P.any (fun i => match i with
   | .X t => decide (x = t) | .CX c t => decide (x = c) || decide (x = t)
   | .CCX a b t => decide (x = a) || (decide (x = b) || decide (x = t))
   | .measureX t c0 c1 => decide (x ∈ (Instr.measureX t c0 c1).wires))) = true) :
    Finset.range n ⊆ wires P := by
  intro x hx
  exact rs2_mem_wires_of P x (List.all_eq_true.mp h x (List.mem_range.mpr (Finset.mem_range.mp hx)))

end ECDSAAdd.Entrant.RS2Wires
end

