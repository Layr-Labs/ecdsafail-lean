-- ===== ECDSAAdd.Submission.Entrant.Rolling1588FirstRename =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplaySupportBits

/-! Pool-local model transport for the first packet, including correction ports. -/
set_option autoImplicit false
namespace ECDSAAdd.Entrant.Rolling1588FirstReplay
open Arithmetic RecordedQuantum
open MeasuredCodec5 (bitsOf bitRun bitStep safe safeStep corrSim)

private theorem mapped_support (f : Wire→Wire) (P : Program) (S : Finset Wire)
    (support : wires P⊆S) : wires (renameProgram f P)⊆S.image f := by
  rw [renameProgram_support]
  exact Finset.image_mono _ support

theorem bitRun_rename_pool (f : Wire→Wire) (S : Finset Wire)
    (injective : ∀a∈S,∀b∈S,f a=f b → a=b) (P : Program) (support : wires P⊆S)
    (small large : Nat) (agree : ∀q∈S,small.testBit q=large.testBit (f q)) :
    ∀q∈S,(bitRun (renameProgram f P) large).testBit (f q)=(bitRun P small).testBit q := by
  have result := ECDSAAdd.run_rename_pool f S injective P support []
    ⟨false,bitsOf small⟩ ⟨false,bitsOf large⟩ rfl agree
  intro q hq
  simpa only [MeasuredCodec5.run_sim,Rolling1588.Replay.sim_basis,bitsOf] using result.2 q hq

private theorem corrSim_rename (f : Wire→Wire) (cs : List Correction) (S : Finset Wire)
    (small large : Nat) (agree : ∀q∈S,small.testBit q=large.testBit (f q)) :
    ∀ph,correctionWires cs⊆S →
      corrSim (cs.map (renameCorrection f)) ph large=corrSim cs ph small := by
  induction cs with
  | nil => intro ph support; rfl
  | cons c cs ih =>
    intro ph support
    cases c with
    | Z t =>
      have tail : correctionWires cs⊆S := fun _ used => support (Finset.mem_union_right _ used)
      have ht := support (Finset.mem_union_left _ (Finset.mem_singleton_self t))
      simp only [List.map_cons,renameCorrection,corrSim]
      rw [←agree t ht]
      exact ih _ tail
    | CZ a b =>
      have tail : correctionWires cs⊆S := fun _ used => support (Finset.mem_union_right _ used)
      have ha := support (Finset.mem_union_left _ (by simp : a∈({a,b} : Finset Wire)))
      have hb := support (Finset.mem_union_left _ (by simp : b∈({a,b} : Finset Wire)))
      simp only [List.map_cons,renameCorrection,corrSim]
      rw [←agree a ha,←agree b hb]
      exact ih _ tail

private theorem safeStep_rename (f : Wire→Wire) (S : Finset Wire)
    (injective : ∀a∈S,∀b∈S,f a=f b → a=b) (i : Instr) (support : i.wires⊆S)
    (small large : Nat) (agree : ∀q∈S,small.testBit q=large.testBit (f q)) :
    safeStep (renameInstr f i) large=safeStep i small := by
  cases i with
  | X t => rfl
  | CX c t => rfl
  | CCX a b t => rfl
  | measureX t c0 c1 =>
    have ht : t∈S := support (Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_singleton_self t)))
    have h0 : correctionWires c0⊆S := fun _ used => support
      (Finset.mem_union_left _ (Finset.mem_union_right _ used))
    have h1 : correctionWires c1⊆S := fun _ used => support (Finset.mem_union_right _ used)
    have singleton : wires [Instr.measureX t c0 c1]⊆S := by
      simpa only [wires,Finset.union_empty] using support
    have next := bitRun_rename_pool f S injective [Instr.measureX t c0 c1] singleton small large agree
    simp only [renameProgram,List.map_cons,List.map_nil,renameInstr,bitRun,bitStep] at next
    have cleared : ∀q∈S,(MeasuredCodec5.clear small t).testBit q=
        (MeasuredCodec5.clear large (f t)).testBit (f q) := fun q hq => (next q hq).symm
    simp only [renameInstr,safeStep]
    rw [corrSim_rename f c0 S _ _ cleared false h0,
      corrSim_rename f c1 S _ _ cleared false h1,←agree t ht]

theorem safe_rename_pool (f : Wire→Wire) (S : Finset Wire)
    (injective : ∀a∈S,∀b∈S,f a=f b → a=b) (P : Program) (support : wires P⊆S)
    (small large : Nat) (agree : ∀q∈S,small.testBit q=large.testBit (f q)) :
    safe (renameProgram f P) large=safe P small := by
  induction P generalizing small large with
  | nil => rfl
  | cons i P ih =>
    have head : i.wires⊆S := fun _ used => support (Finset.mem_union_left _ used)
    have tail : wires P⊆S := fun _ used => support (Finset.mem_union_right _ used)
    have singleton : wires [i]⊆S := by simpa only [wires,Finset.union_empty] using head
    have next := bitRun_rename_pool f S injective [i] singleton small large agree
    simp only [renameProgram,List.map_cons,List.map_nil,bitRun] at next
    change (safeStep (renameInstr f i) large &&
      safe (renameProgram f P) (bitStep (renameInstr f i) large))=
      (safeStep i small && safe P (bitStep i small))
    rw [safeStep_rename f S injective i head small large agree,
      ih tail _ _ (fun q hq => (next q hq).symm)]

theorem rename_law (f : Wire→Wire) (S : Finset Wire)
    (injective : ∀a∈S,∀b∈S,f a=f b → a=b) (P Q : Program)
    (pSupport : wires P⊆S) (qSupport : wires Q⊆S)
    (small large : Nat) (agree : ∀q∈S,small.testBit q=large.testBit (f q))
    (law : safe P small=safe Q small ∧ bitRun P small=bitRun Q small) :
    safe (renameProgram f P) large=safe (renameProgram f Q) large ∧
      bitRun (renameProgram f P) large=bitRun (renameProgram f Q) large := by
  have p := bitRun_rename_pool f S injective P pSupport small large agree
  have q := bitRun_rename_pool f S injective Q qSupport small large agree
  refine ⟨(safe_rename_pool f S injective P pSupport small large agree).trans
    (law.1.trans (safe_rename_pool f S injective Q qSupport small large agree).symm),?_⟩
  apply Nat.eq_of_testBit_eq
  intro port
  by_cases inside : port∈S.image f
  · obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp inside
    exact (p i hi).trans ((congrArg (fun n : Nat => n.testBit i) law.2).trans (q i hi).symm)
  · rw [Rolling1588.Replay.bitRun_outside _ large port
        (fun used => inside (mapped_support f P S pSupport used)),
      Rolling1588.Replay.bitRun_outside _ large port
        (fun used => inside (mapped_support f Q S qSupport used))]

theorem rename_roundtrip (f : Wire→Wire) (S : Finset Wire)
    (injective : ∀a∈S,∀b∈S,f a=f b → a=b) (P Q : Program)
    (pSupport : wires P⊆S) (qSupport : wires Q⊆S)
    (small large : Nat) (agree : ∀q∈S,small.testBit q=large.testBit (f q))
    (pSafe : safe P small=true) (qSafe : safe Q (bitRun P small)=true)
    (inverse : bitRun Q (bitRun P small)=small) :
    safe (renameProgram f P) large=true ∧
      safe (renameProgram f Q) (bitRun (renameProgram f P) large)=true ∧
      bitRun (renameProgram f Q) (bitRun (renameProgram f P) large)=large := by
  have encoded := bitRun_rename_pool f S injective P pSupport small large agree
  have after : ∀q∈S,(bitRun P small).testBit q=
      (bitRun (renameProgram f P) large).testBit (f q) := fun q hq => (encoded q hq).symm
  have decoded := bitRun_rename_pool f S injective Q qSupport _ _ after
  refine ⟨(safe_rename_pool f S injective P pSupport small large agree).trans pSafe,
    (safe_rename_pool f S injective Q qSupport _ _ after).trans qSafe,?_⟩
  apply Nat.eq_of_testBit_eq
  intro port
  by_cases inside : port∈S.image f
  · obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp inside
    exact (decoded i hi).trans
      ((congrArg (fun n : Nat => n.testBit i) inverse).trans (agree i hi))
  · rw [Rolling1588.Replay.bitRun_outside _ _ port
        (fun used => inside (mapped_support f Q S qSupport used)),
      Rolling1588.Replay.bitRun_outside _ large port
        (fun used => inside (mapped_support f P S pSupport used))]

end ECDSAAdd.Entrant.Rolling1588FirstReplay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588FirstC3 =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588FirstRename
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayC3

/-! One six-port C3 law supplies all four first-packet port choices. -/
set_option autoImplicit false
namespace ECDSAAdd.Entrant.Rolling1588FirstReplay
open Arithmetic RecordedQuantum Rolling1588
open MeasuredCodec5 (bitRun safe)

private def localWord (f : Wire→Wire) (x : Nat) : Nat :=
  MeasuredCodec5.pack10 (x.testBit (f 0)) (x.testBit (f 1)) (x.testBit (f 2))
    (x.testBit (f 3)) (x.testBit (f 4)) (x.testBit (f 5)) false false false false

private theorem localWord_agree (f : Wire→Wire) (x q : Nat) (hq : q<6) :
    (localWord f x).testBit q=x.testBit (f q) := by
  dsimp only [localWord]
  rw [MeasuredCodec5.pack10_bits _ _ _ _ _ _ _ _ _ _ q (by omega)]
  interval_cases q <;> simp [MeasuredCodec5.raw]

private theorem localTriple_views (a b c : Nat) :
    localTriple a b c 0=2*a ∧ localTriple a b c 1=2*a+1 ∧
    localTriple a b c 2=2*b ∧ localTriple a b c 3=2*b+1 ∧
    localTriple a b c 4=2*c ∧ localTriple a b c 5=2*c+1 :=
  ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩

theorem localTriple_injective (a b c : Nat) (ab : a≠b) (ac : a≠c) (bc : b≠c) :
    ∀i∈Finset.range 6,∀j∈Finset.range 6,localTriple a b c i=localTriple a b c j → i=j := by
  intro i hi j hj same
  have ib := Finset.mem_range.mp hi
  have jb := Finset.mem_range.mp hj
  have view := localTriple_views a b c
  interval_cases i <;> interval_cases j
  all_goals
    first
    | rfl
    | (simp only [view.1,view.2.1,view.2.2.1,view.2.2.2.1,view.2.2.2.2.1,
        view.2.2.2.2.2] at same
       change @Eq Nat _ _ at same
       change @Eq Nat _ _
       omega)

private theorem legal_pair (x : Nat) (legal : MeasuredCodec5.legalNat x=true)
    (t : Nat) (ht : t<5) : Bool.not (x.testBit (2*t) && x.testBit (2*t+1))=true := by
  simp only [MeasuredCodec5.legalNat,Bool.and_eq_true] at legal
  interval_cases t
  · exact legal.1.1.1.1
  · exact legal.1.1.1.2
  · exact legal.1.1.2
  · exact legal.1.2
  · exact legal.2

private theorem localWord_legal (a b c : Nat) (ha : a<5) (hb : b<5) (hc : c<5)
    (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    Replay.legal3 (localWord (localTriple a b c) x)=true := by
  have pairs := And.intro (And.intro (legal_pair x legal a ha) (legal_pair x legal b hb))
    (legal_pair x legal c hc)
  have view := localTriple_views a b c
  simpa only [Replay.legal3,localWord_agree _ x 0 (by decide),
    localWord_agree _ x 1 (by decide),localWord_agree _ x 2 (by decide),
    localWord_agree _ x 3 (by decide),localWord_agree _ x 4 (by decide),
    localWord_agree _ x 5 (by decide),view.1,view.2.1,view.2.2.1,view.2.2.2.1,
    view.2.2.2.2.1,view.2.2.2.2.2,Bool.and_eq_true] using pairs

theorem triple_facts (a b c : Nat) (ha : a<5) (hb : b<5) (hc : c<5)
    (ab : a≠b) (ac : a≠c) (bc : b≠c) (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe (renameProgram (localTriple a b c) e3) x=true ∧
      (bitRun (renameProgram (localTriple a b c) e3) x).testBit (localTriple a b c 5)=false ∧
      safe (renameProgram (localTriple a b c) d3)
        (bitRun (renameProgram (localTriple a b c) e3) x)=true ∧
      bitRun (renameProgram (localTriple a b c) d3)
        (bitRun (renameProgram (localTriple a b c) e3) x)=x := by
  let f := localTriple a b c
  let small := localWord f x
  have injective := localTriple_injective a b c ab ac bc
  have agree : ∀q∈Finset.range 6,small.testBit q=x.testBit (f q) :=
    fun q hq => localWord_agree f x q (Finset.mem_range.mp hq)
  have facts := Replay.c3_facts small (localWord_legal a b c ha hb hc x legal)
  have round := rename_roundtrip f (Finset.range 6) injective e3 d3
    c3_support.1 c3_support.2.1 small x agree facts.1 facts.2.2.1 facts.2.2.2
  have encoded := bitRun_rename_pool f (Finset.range 6) injective e3 c3_support.1 small x agree
  exact ⟨round.1,(encoded 5 (by decide)).trans facts.2.1,round.2.1,round.2.2⟩

theorem triple_law (a b c : Nat) (ab : a≠b) (ac : a≠c) (bc : b≠c)
    (P Q : Program) (pSupport : wires P⊆Finset.range 6) (qSupport : wires Q⊆Finset.range 6)
    (law : ∀y,safe P y=safe Q y ∧ bitRun P y=bitRun Q y) (x : Nat) :
    safe (renameProgram (localTriple a b c) P) x=safe (renameProgram (localTriple a b c) Q) x ∧
      bitRun (renameProgram (localTriple a b c) P) x=bitRun (renameProgram (localTriple a b c) Q) x :=
  rename_law (localTriple a b c) (Finset.range 6) (localTriple_injective a b c ab ac bc)
    P Q pSupport qSupport (localWord (localTriple a b c) x) x
    (fun q hq => localWord_agree _ x q (Finset.mem_range.mp hq)) (law _)

end ECDSAAdd.Entrant.Rolling1588FirstReplay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588FirstShort =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588FirstC3
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588FirstTransitions
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588ReplayRawH

/-! The two first-packet short bridges cancel the same retained-port operation. -/
set_option autoImplicit false
namespace ECDSAAdd.Entrant.Rolling1588FirstReplay
open Arithmetic RecordedQuantum Rolling1588
open MeasuredCodec5 (bitRun safe)

private abbrev H : Program := renameProgram (localTriple 1 3 4) Replay.c3RawH

private theorem rename_append (f : Wire→Wire) (P Q : Program) :
    renameProgram f (P++Q)=renameProgram f P++renameProgram f Q := by
  simp only [renameProgram,List.map_append]

private theorem H_ports (a : Nat) : renameProgram (localTriple a 3 4) Replay.c3RawH=H := by
  simp [H,Replay.c3RawH,renameProgram,renameInstr,localTriple]

private theorem H_range : wires Replay.c3RawH⊆Finset.range 6 :=
  Replay.c3RawH_support.trans (by decide)

private theorem H_safe (x : Nat) : safe H x=true :=
  Replay.safe_of_no_measurements H
    ((renameProgram_counts (localTriple 1 3 4) Replay.c3RawH).2.trans rfl) x

private theorem H_involution (x : Nat) : bitRun H (bitRun H x)=x := by
  have localLaw (y : Nat) : safe (Replay.c3RawH++Replay.c3RawH) y=safe [] y ∧
      bitRun (Replay.c3RawH++Replay.c3RawH) y=bitRun [] y := by
    constructor
    · rw [Replay.safe_append,Replay.c3RawH_safe,Replay.c3RawH_safe]
      rfl
    · rw [Replay.bitRun_append,Replay.c3RawH_involution]
      rfl
  have result := triple_law 1 3 4 (by decide) (by decide) (by decide)
    (Replay.c3RawH++Replay.c3RawH) []
    (by simpa only [wires_append,Finset.union_subset_iff] using And.intro H_range H_range)
    (by simp [wires]) localLaw x
  have bits := result.2
  rw [rename_append] at bits
  change bitRun (H++H) x=x at bits
  exact (Replay.bitRun_append H H x).symm.trans bits

private theorem mapped_encode_factor (a : Nat) (a3 : a≠3) (a4 : a≠4) (x : Nat) :
    safe (renameProgram (localTriple a 3 4) e3) x=
      safe (renameProgram (localTriple a 3 4) e3short) (bitRun H x) ∧
    bitRun (renameProgram (localTriple a 3 4) e3) x=
      bitRun (renameProgram (localTriple a 3 4) e3short) (bitRun H x) := by
  have law (y : Nat) : safe e3 y=safe (Replay.c3RawH++e3short) y ∧
      bitRun e3 y=bitRun (Replay.c3RawH++e3short) y := by
    constructor
    · rw [Replay.safe_append,Replay.c3RawH_safe,Bool.true_and]
      exact Replay.e3short_factor_safe y
    · rw [Replay.bitRun_append]
      exact Replay.e3short_factor_bits y
  have result := triple_law a 3 4 a3 a4 (by decide) e3 (Replay.c3RawH++e3short)
    c3_support.1 (by
      simpa only [wires_append,Finset.union_subset_iff] using And.intro H_range c3_support.2.2.1)
    law x
  rw [rename_append] at result
  simpa only [Replay.safe_append,Replay.bitRun_append,H_ports a,H_safe,Bool.true_and] using result

private theorem mapped_decode_factor (a : Nat) (a3 : a≠3) (a4 : a≠4) (x : Nat) :
    safe (renameProgram (localTriple a 3 4) d3) x=
      safe (renameProgram (localTriple a 3 4) d3short) x ∧
    bitRun (renameProgram (localTriple a 3 4) d3) x=
      bitRun H (bitRun (renameProgram (localTriple a 3 4) d3short) x) := by
  have law (y : Nat) : safe d3 y=safe (d3short++Replay.c3RawH) y ∧
      bitRun d3 y=bitRun (d3short++Replay.c3RawH) y := by
    constructor
    · rw [Replay.safe_append,Replay.c3RawH_safe,Bool.and_true]
      exact Replay.d3short_factor_safe y
    · rw [Replay.bitRun_append]
      exact Replay.d3short_factor_bits y
  have result := triple_law a 3 4 a3 a4 (by decide) d3 (d3short++Replay.c3RawH)
    c3_support.2.1 (by
      simpa only [wires_append,Finset.union_subset_iff] using And.intro c3_support.2.2.2 H_range)
    law x
  rw [rename_append] at result
  simpa only [Replay.safe_append,Replay.bitRun_append,H_ports a,H_safe,Bool.and_true] using result

theorem first_short_bridge (a b : Nat) (ha : a=1 ∨ a=2) (hb : b=1 ∨ b=2)
    (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe (renameProgram (localTriple a 3 4) d3short++renameProgram (localTriple b 3 4) e3short)
      (bitRun (renameProgram (localTriple a 3 4) e3) x)=true ∧
    bitRun (renameProgram (localTriple a 3 4) d3short++renameProgram (localTriple b 3 4) e3short)
      (bitRun (renameProgram (localTriple a 3 4) e3) x)=
        bitRun (renameProgram (localTriple b 3 4) e3) x := by
  have a3 : a≠3 := by omega
  have a4 : a≠4 := by omega
  have b3 : b≠3 := by omega
  have b4 : b≠4 := by omega
  have before := triple_facts a 3 4 (by omega) (by decide) (by decide)
    a3 a4 (by decide) x legal
  have after := triple_facts b 3 4 (by omega) (by decide) (by decide)
    b3 b4 (by decide) x legal
  have decoder := mapped_decode_factor a a3 a4 (bitRun (renameProgram (localTriple a 3 4) e3) x)
  have encoder := mapped_encode_factor b b3 b4 x
  exact short_transition (renameProgram (localTriple a 3 4) d3)
    (renameProgram (localTriple a 3 4) d3short) (renameProgram (localTriple b 3 4) e3)
    (renameProgram (localTriple b 3 4) e3short) H _ x
    before.2.2.2 before.2.2.1 after.1 decoder.2 decoder.1 encoder.2 encoder.1 H_involution

private abbrev H12 : Program := renameProgram (localTriple 3 1 2) Replay.c3RawH

private theorem H12_ports (a : Nat) : renameProgram (localTriple a 1 2) Replay.c3RawH=H12 := by
  simp [H12,Replay.c3RawH,renameProgram,renameInstr,localTriple]

private theorem H12_safe (x : Nat) : safe H12 x=true :=
  Replay.safe_of_no_measurements H12
    ((renameProgram_counts (localTriple 3 1 2) Replay.c3RawH).2.trans rfl) x

private theorem H12_involution (x : Nat) : bitRun H12 (bitRun H12 x)=x := by
  have localLaw (y : Nat) : safe (Replay.c3RawH++Replay.c3RawH) y=safe [] y ∧
      bitRun (Replay.c3RawH++Replay.c3RawH) y=bitRun [] y := by
    constructor
    · rw [Replay.safe_append,Replay.c3RawH_safe,Replay.c3RawH_safe]
      rfl
    · rw [Replay.bitRun_append,Replay.c3RawH_involution]
      rfl
  have result := triple_law 3 1 2 (by decide) (by decide) (by decide)
    (Replay.c3RawH++Replay.c3RawH) []
    (by simpa only [wires_append,Finset.union_subset_iff] using And.intro H_range H_range)
    (by simp [wires]) localLaw x
  have bits := result.2
  rw [rename_append] at bits
  change bitRun (H12++H12) x=x at bits
  exact (Replay.bitRun_append H12 H12 x).symm.trans bits

private theorem mapped_encode_factor12 (a : Nat) (a1 : a≠1) (a2 : a≠2) (x : Nat) :
    safe (renameProgram (localTriple a 1 2) e3) x=
      safe (renameProgram (localTriple a 1 2) e3short) (bitRun H12 x) ∧
    bitRun (renameProgram (localTriple a 1 2) e3) x=
      bitRun (renameProgram (localTriple a 1 2) e3short) (bitRun H12 x) := by
  have law (y : Nat) : safe e3 y=safe (Replay.c3RawH++e3short) y ∧
      bitRun e3 y=bitRun (Replay.c3RawH++e3short) y := by
    constructor
    · rw [Replay.safe_append,Replay.c3RawH_safe,Bool.true_and]
      exact Replay.e3short_factor_safe y
    · rw [Replay.bitRun_append]
      exact Replay.e3short_factor_bits y
  have result := triple_law a 1 2 a1 a2 (by decide) e3 (Replay.c3RawH++e3short)
    c3_support.1 (by
      simpa only [wires_append,Finset.union_subset_iff] using And.intro H_range c3_support.2.2.1)
    law x
  rw [rename_append] at result
  simpa only [Replay.safe_append,Replay.bitRun_append,H12_ports a,H12_safe,Bool.true_and] using result

private theorem mapped_decode_factor12 (a : Nat) (a1 : a≠1) (a2 : a≠2) (x : Nat) :
    safe (renameProgram (localTriple a 1 2) d3) x=
      safe (renameProgram (localTriple a 1 2) d3short) x ∧
    bitRun (renameProgram (localTriple a 1 2) d3) x=
      bitRun H12 (bitRun (renameProgram (localTriple a 1 2) d3short) x) := by
  have law (y : Nat) : safe d3 y=safe (d3short++Replay.c3RawH) y ∧
      bitRun d3 y=bitRun (d3short++Replay.c3RawH) y := by
    constructor
    · rw [Replay.safe_append,Replay.c3RawH_safe,Bool.and_true]
      exact Replay.d3short_factor_safe y
    · rw [Replay.bitRun_append]
      exact Replay.d3short_factor_bits y
  have result := triple_law a 1 2 a1 a2 (by decide) d3 (d3short++Replay.c3RawH)
    c3_support.2.1 (by
      simpa only [wires_append,Finset.union_subset_iff] using And.intro c3_support.2.2.2 H_range)
    law x
  rw [rename_append] at result
  simpa only [Replay.safe_append,Replay.bitRun_append,H12_ports a,H12_safe,Bool.and_true] using result

theorem first_short_bridge12 (a b : Nat) (ha : a=3 ∨ a=4) (hb : b=3 ∨ b=4)
    (x : Nat) (legal : MeasuredCodec5.legalNat x=true) :
    safe (renameProgram (localTriple a 1 2) d3short++renameProgram (localTriple b 1 2) e3short)
      (bitRun (renameProgram (localTriple a 1 2) e3) x)=true ∧
    bitRun (renameProgram (localTriple a 1 2) d3short++renameProgram (localTriple b 1 2) e3short)
      (bitRun (renameProgram (localTriple a 1 2) e3) x)=
        bitRun (renameProgram (localTriple b 1 2) e3) x := by
  have a1 : a≠1 := by omega
  have a2 : a≠2 := by omega
  have b1 : b≠1 := by omega
  have b2 : b≠2 := by omega
  have before := triple_facts a 1 2 (by omega) (by decide) (by decide)
    a1 a2 (by decide) x legal
  have after := triple_facts b 1 2 (by omega) (by decide) (by decide)
    b1 b2 (by decide) x legal
  have decoder := mapped_decode_factor12 a a1 a2 (bitRun (renameProgram (localTriple a 1 2) e3) x)
  have encoder := mapped_encode_factor12 b b1 b2 x
  exact short_transition (renameProgram (localTriple a 1 2) d3)
    (renameProgram (localTriple a 1 2) d3short) (renameProgram (localTriple b 1 2) e3)
    (renameProgram (localTriple b 1 2) e3short) H12 _ x
    before.2.2.2 before.2.2.1 after.1 decoder.2 decoder.1 encoder.2 encoder.1 H12_involution

end ECDSAAdd.Entrant.Rolling1588FirstReplay
end -- original module boundary

-- ===== ECDSAAdd.Submission.Entrant.Rolling1588FirstStages =====
section
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588CodecCore
-- consolidated import: import ECDSAAdd.Submission.Entrant.Rolling1588FirstShort

/-! The four C3 representations used only inside packet zero. -/
set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
namespace ECDSAAdd.Entrant.Rolling1588First
open Arithmetic Challenge RecordedQuantum Baselines Rolling1588
open MeasuredCodec5 (bitsOf legalNat bitRun safe)
attribute [local irreducible] run wires

def mappedTriple (a b c : Nat) (P : Program) : Program :=
  renameProgram (localTriple a b c) P

def pack (k : Nat) : Program :=
  if k=0 then mappedTriple 2 3 4 e3
  else if k=1 then mappedTriple 1 3 4 e3
  else if k=2 then mappedTriple 4 1 2 e3
  else mappedTriple 3 1 2 e3

def unpack (k : Nat) : Program :=
  if k=0 then mappedTriple 2 3 4 d3
  else if k=1 then mappedTriple 1 3 4 d3
  else if k=2 then mappedTriple 4 1 2 d3
  else mappedTriple 3 1 2 d3

def stageIndex (divide : Bool) (k : Nat) : Nat := if divide then k else 3-k

def stageCode (divide : Bool) (k : Nat) : Program :=
  if k<4 then pack (stageIndex divide k) else []

def active (divide : Bool) (k : Nat) : Nat := stageIndex divide k+1

def hole (divide : Bool) (k : Nat) : Nat := if 2≤stageIndex divide k then 2 else 4

def transition (divide : Bool) (k : Nat) : Program :=
  if k<3 then
    if divide then
      if k=0 then mappedTriple 2 3 4 d3short++mappedTriple 1 3 4 e3short
      else if k=1 then mappedTriple 1 3 4 d3++mappedTriple 4 1 2 e3
      else mappedTriple 4 1 2 d3short++mappedTriple 3 1 2 e3short
    else
      if k=0 then mappedTriple 3 1 2 d3short++mappedTriple 4 1 2 e3short
      else if k=1 then mappedTriple 4 1 2 d3++mappedTriple 1 3 4 e3
      else mappedTriple 1 3 4 d3short++mappedTriple 2 3 4 e3short
  else unpack (if divide then 3 else 0)

theorem indices (divide : Bool) (k : Nat) (hk : k<4) :
    0<active divide k ∧ active divide k<5 ∧ hole divide k<5 := by
  cases divide <;> interval_cases k <;> decide +kernel

theorem stage_support (divide : Bool) (k : Nat) (hk : k≤4) :
    wires (stageCode divide k)⊆Finset.range 10 := by
  cases divide <;> interval_cases k <;> decide +kernel

theorem transition_support (divide : Bool) (k : Nat) (hk : k<4) :
    wires (transition divide k)⊆Finset.range 10 := by
  cases divide <;> interval_cases k <;> decide +kernel

theorem stage_neutral (divide : Bool) (k : Nat) (hk : k≤4) :
    MeasuredCodec5.zeroNeutral (stageCode divide k)=true := by
  cases divide <;> interval_cases k <;> decide +kernel





private theorem mapped_pair_free (a b c d : Nat) (da : d≠a) (db : d≠b) (dc : d≠c) :
    2*d∉wires (mappedTriple a b c e3) ∧ 2*d+1∉wires (mappedTriple a b c e3) := by
  have off (q : Nat) (hq : q=2*d ∨ q=2*d+1) : q∉wires (mappedTriple a b c e3) := by
    intro used
    rw [mappedTriple,renameProgram_support] at used
    obtain ⟨i,hi,equal⟩ := Finset.mem_image.mp used
    have bound := Finset.mem_range.mp (c3_support.1 hi)
    rcases hq with rfl|rfl <;> interval_cases i <;> simp [localTriple] at equal
    all_goals
      change @Eq Nat _ _ at equal
      omega
  exact ⟨off _ (Or.inl rfl),off _ (Or.inr rfl)⟩

private theorem pack_active_free (k : Nat) (hk : k<4) :
    2*(k+1)∉wires (pack k) ∧ 2*(k+1)+1∉wires (pack k) := by
  interval_cases k
  · simpa [pack] using mapped_pair_free 2 3 4 1 (by decide) (by decide) (by decide)
  · simpa [pack] using mapped_pair_free 1 3 4 2 (by decide) (by decide) (by decide)
  · simpa [pack] using mapped_pair_free 4 1 2 3 (by decide) (by decide) (by decide)
  · simpa [pack] using mapped_pair_free 3 1 2 4 (by decide) (by decide) (by decide)

private theorem pack_facts (k : Nat) (hk : k<4) (x : Nat) (legal : legalNat x=true) :
    safe (pack k) x=true ∧
      (bitRun (pack k) x).testBit (2*(if 2≤k then 2 else 4)+1)=false ∧
      safe (unpack k) (bitRun (pack k) x)=true ∧ bitRun (unpack k) (bitRun (pack k) x)=x := by
  interval_cases k
  · simpa [pack,unpack,mappedTriple] using Rolling1588FirstReplay.triple_facts
      2 3 4 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x legal
  · simpa [pack,unpack,mappedTriple] using Rolling1588FirstReplay.triple_facts
      1 3 4 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x legal
  · simpa [pack,unpack,mappedTriple] using Rolling1588FirstReplay.triple_facts
      4 1 2 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x legal
  · simpa [pack,unpack,mappedTriple] using Rolling1588FirstReplay.triple_facts
      3 1 2 (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x legal

private theorem finite_pack (k : Nat) (hk : k<4) :
    ∀x,x<1024 → legalNat x=true →
      safe (pack k) x=true ∧
      (bitRun (pack k) x).testBit (2*(if 2≤k then 2 else 4)+1)=false ∧
      (bitRun (pack k) x).testBit (2*(k+1))=x.testBit (2*(k+1)) ∧
      (bitRun (pack k) x).testBit (2*(k+1)+1)=x.testBit (2*(k+1)+1) := by
  intro x _ legal
  have facts := pack_facts k hk x legal
  have free := pack_active_free k hk
  exact ⟨facts.1,facts.2.1,Replay.bitRun_outside (pack k) x _ free.1,
    Replay.bitRun_outside (pack k) x _ free.2⟩

/-- All legal words are checked. No trace sample is used. -/
theorem finite_stage (divide : Bool) (k : Nat) (hk : k<4) :
    ∀x,x<1024 → legalNat x=true →
      safe (stageCode divide k) x=true ∧
      (bitRun (stageCode divide k) x).testBit (2*hole divide k+1)=false ∧
      (bitRun (stageCode divide k) x).testBit (2*active divide k)=x.testBit (2*active divide k) ∧
      (bitRun (stageCode divide k) x).testBit (2*active divide k+1)=x.testBit (2*active divide k+1) := by
  have bound : stageIndex divide k<4 := by
    cases divide <;> simp only [stageIndex,Bool.false_eq_true,if_false,if_true] <;> omega
  simpa only [stageCode,if_pos hk,active,hole] using finite_pack (stageIndex divide k) bound

private theorem stage_safe (divide : Bool) (k : Nat) (hk : k≤4)
    (x : Nat) (hx : x<1024) (legal : legalNat x=true) :
    safe (stageCode divide k) x=true := by
  by_cases small : k<4
  · exact (finite_stage divide k small x hx legal).1
  · have last : k=4 := by omega
    subst k
    rfl

private theorem full_bridge (before after : Nat) (hb : before<4) (ha : after<4)
    (x : Nat) (legal : legalNat x=true) :
    safe (unpack before++pack after) (bitRun (pack before) x)=true ∧
      bitRun (unpack before++pack after) (bitRun (pack before) x)=bitRun (pack after) x := by
  have first := pack_facts before hb x legal
  have last := pack_facts after ha x legal
  exact Rolling1588FirstReplay.full_transition (unpack before) (pack after) _ x
    first.2.2.2 first.2.2.1 last.1

private theorem finite_transition_result (divide : Bool) (k : Nat) (hk : k<4) :
    ∀x,x<1024 → legalNat x=true →
      safe (transition divide k) (bitRun (stageCode divide k) x)=true ∧
      bitRun (transition divide k) (bitRun (stageCode divide k) x)=
        bitRun (stageCode divide (k+1)) x := by
  intro x _ legal
  cases divide
  · interval_cases k
    · simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        Rolling1588FirstReplay.first_short_bridge12 3 4 (Or.inl rfl) (Or.inr rfl) x legal
    · simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        full_bridge 2 1 (by decide) (by decide) x legal
    · simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        Rolling1588FirstReplay.first_short_bridge 1 2 (Or.inl rfl) (Or.inr rfl) x legal
    · have facts := pack_facts 0 (by decide) x legal
      simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        And.intro facts.2.2.1 facts.2.2.2
  · interval_cases k
    · simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        Rolling1588FirstReplay.first_short_bridge 2 1 (Or.inr rfl) (Or.inl rfl) x legal
    · simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        full_bridge 1 2 (by decide) (by decide) x legal
    · simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        Rolling1588FirstReplay.first_short_bridge12 4 3 (Or.inr rfl) (Or.inl rfl) x legal
    · have facts := pack_facts 3 (by decide) x legal
      simpa [stageCode,stageIndex,transition,pack,unpack,mappedTriple] using
        And.intro facts.2.2.1 facts.2.2.2

theorem finite_transition (divide : Bool) (k : Nat) (hk : k<4) :
    ∀x,x<1024 → legalNat x=true →
      safe (stageCode divide k) x=true ∧
      safe (transition divide k) (bitRun (stageCode divide k) x)=true ∧
      safe (stageCode divide (k+1)) x=true ∧
      bitRun (transition divide k) (bitRun (stageCode divide k) x)=
        bitRun (stageCode divide (k+1)) x := by
  intro x hx legal
  have result := finite_transition_result divide k hk x hx legal
  exact ⟨(finite_stage divide k hk x hx legal).1,result.1,
    stage_safe divide (k+1) (by omega) x hx legal,result.2⟩

theorem stage_correct (divide : Bool) (k : Nat) (hk : k<4)
    (state : State) (records : List Bool) (legal : MeasuredCodec5.legal state.basis) :
    (run (stageCode divide k) records state).phase=state.phase ∧
    (run (stageCode divide k) records state).basis (2*hole divide k+1)=false ∧
    (run (stageCode divide k) records state).basis (2*active divide k)=state.basis (2*active divide k) ∧
    (run (stageCode divide k) records state).basis (2*active divide k+1)=state.basis (2*active divide k+1) := by
  obtain ⟨x,hx,lx,hb⟩ := MeasuredCodec5.local_word state legal
  have agree := pool_run_agrees (stageCode divide k) (Finset.range 10)
    (stage_support divide k (by omega)) records state ⟨state.phase,bitsOf x⟩ rfl hb
  have finite := finite_stage divide k hk x hx lx
  have modeled := MeasuredCodec5.run_sim (stageCode divide k) records state.phase x
  rw [MeasuredCodec5.sim_safe (stageCode divide k) x finite.1] at modeled
  have modeledPhase := congrArg State.phase modeled
  have output (q : Nat) (hq : q<10) :
      (run (stageCode divide k) records state).basis q=
        (bitRun (stageCode divide k) x).testBit q :=
    (agree.2 q (Finset.mem_range.mpr hq)).trans (congrArg (fun s : State => s.basis q) modeled)
  have bounds := indices divide k hk
  refine ⟨agree.1.trans modeledPhase,?_,?_,?_⟩
  · exact (output _ (by omega)).trans finite.2.1
  · exact (output _ (by omega)).trans
      (finite.2.2.1.trans (hb _ (Finset.mem_range.mpr (by omega))).symm)
  · exact (output _ (by omega)).trans
      (finite.2.2.2.trans (hb _ (Finset.mem_range.mpr (by omega))).symm)

theorem transition_run (divide : Bool) (k : Nat) (hk : k<4)
    (state : State) (mE mT mO : List Bool) (legal : MeasuredCodec5.legal state.basis) :
    run (transition divide k) mT (run (stageCode divide k) mE state)=
      run (stageCode divide (k+1)) mO state :=
  Rolling1588.composition_eq _ _ _ (stage_support divide k (by omega))
    (transition_support divide k hk) (stage_support divide (k+1) (by omega))
    (finite_transition divide k hk) state mE mT mO legal

theorem zeroNeutral_rename (f : Wire→Wire) (P : Program) :
    MeasuredCodec5.zeroNeutral (renameProgram f P)=MeasuredCodec5.zeroNeutral P := by
  induction P with
  | nil => rfl
  | cons i P ih =>
    cases i with
    | X q => simpa only [renameProgram,List.map_cons,renameInstr,MeasuredCodec5.zeroNeutral] using ih
    | CX a b => simpa only [renameProgram,List.map_cons,renameInstr,MeasuredCodec5.zeroNeutral] using ih
    | CCX a b c => simpa only [renameProgram,List.map_cons,renameInstr,MeasuredCodec5.zeroNeutral] using ih
    | measureX q c0 c1 =>
      cases c0 with
      | nil => simpa only [renameProgram,List.map_cons,List.map_nil,renameInstr,
          MeasuredCodec5.zeroNeutral] using ih
      | cons c cs => rfl

end ECDSAAdd.Entrant.Rolling1588First
end -- original module boundary


/-! Generic opaque proof boundaries. No concrete replay, codec, or field program. -/
namespace ECDSAAdd.Entrant.JointStageTransport
open ECDSAAdd ECDSAAdd.Arithmetic

 theorem registers {r y r' y' : List Wire} (hr : r=r') (hy : y=y')
    {origin output : BasisState} {A B : Nat}
    (frame : PairFrame r y origin A B output) : PairFrame r' y' origin A B output := by
  cases hr
  cases hy
  exact frame

 theorem pair_rebase (r y : List Wire) (origin middle output : BasisState)
    (A B C D : Nat) (first : PairFrame r y origin A B middle)
    (second : PairFrame r y middle C D output) : PairFrame r y origin C D output :=
  ⟨second.1,second.2.1,fun q qr qy => (second.2.2 q qr qy).trans (first.2.2 q qr qy)⟩

 theorem phase_pair_compose (r y : List Wire) (input middle output : State)
    (A B C D : Nat) (firstPhase : middle.phase=input.phase) (secondPhase : output.phase=middle.phase)
    (first : PairFrame r y input.basis A B middle.basis)
    (second : PairFrame r y middle.basis C D output.basis) :
    output.phase=input.phase ∧ PairFrame r y input.basis C D output.basis :=
  ⟨secondPhase.trans firstPhase,pair_rebase r y input.basis middle.basis output.basis A B C D first second⟩

 theorem append_states (P Q : Program) (records : List Bool) (input middle output : State)
    (first : run P (records.take (measurementCount P)) input=middle)
    (second : run Q (records.drop (measurementCount P)) middle=output) :
    run (P++Q) records input=output := by
  rw [run_append,first,second]

 theorem close_run (F : State→Prop) (P : Program) (records : List Bool) (input output : State)
    (same : run P records input=output) (phase : output.phase=input.phase) (frame : F output) :
    (run P records input).phase=input.phase ∧ F (run P records input) := by
  rw [same]
  exact ⟨phase,frame⟩

end ECDSAAdd.Entrant.JointStageTransport

