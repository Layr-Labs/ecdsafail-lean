  dp ++ ParityCodec5New.untwist ++
    (if divide then bridge7 ++ bridge5 else bridge5 ++ bridge7inv) ++
    ParityCodec5New.twist ++ ep

def localTriple (a b c : Nat) (i : Wire) : Wire :=
  let t := if i/2=0 then a else if i/2=1 then b else c
  2*t+i%2

