/-! ### merged from `ECDSAAdd.Submission.Entrant.StairS2Core_at_QTop` -/
section Merge_StairS2Core_at_QTop

/-!
# S2: generic lemmas for the caller re-host of pool 724 / 723 (variable programs only)

* `zt_rename_on`: the static zero tracker `StairField13V3Clean.zt` is invariant under a rename
  that is injective on the program's wires (for the tracked wire);
* `zt_meas_mid`: a program `A ++ measureX w … :: B` with `w ∉ wires B` resets `w`;
* `zero_of_zt`: soundness in the form used at window ends;
* single-swap window facts (`swap_run_eq`, `swap_avoids`, `swap_support`): a window renamed by
  `swap a h` runs exactly like the window if both wires are zero before it, the host is untouched by
  it and `a` is zero after it (0 T: counts, slots and physicality are rename-invariant).
-/

section

set_option autoImplicit false

namespace ECDSAAdd.Entrant.StairS2

open ECDSAAdd Arithmetic
open StairField13V3Clean

theorem zt_rename_on (f : Wire → Wire) (w : Wire) :
    ∀ (P : Program) (b : Bool), (∀ q ∈ wires P, f q = f w → q = w) →
      zt (f w) b (renameProgram f P) = zt w b P := by
  intro P
  induction P with
  | nil => intro b _; rfl
  | cons i p ih =>
    intro b h
    have hp : ∀ q ∈ wires p, f q = f w → q = w := fun q hq => h q (Finset.mem_union_right _ hq)
    have hi : f (tgt i) = f w → tgt i = w := h _ (Finset.mem_union_left _ (tgt_mem_wires i))
    show zt (f w) b (renameInstr f i :: renameProgram f p) = zt w b (i :: p)
    simp only [zt, tgt_rename, isMeas_rename]
    by_cases ht : tgt i = w
    · rw [if_pos (by rw [ht]), if_pos ht]
      exact ih _ hp
    · rw [if_neg (fun e => ht (hi e)), if_neg ht]
      exact ih _ hp

theorem zt_cons_meas (w : Wire) (c0 c1 : List Correction) (B : Program) (b : Bool) :
    zt w b (Instr.measureX w c0 c1 :: B) = zt w true B := by
  simp [zt, tgt, isMeas]

theorem zt_meas_mid (w : Wire) (A B : Program) (c0 c1 : List Correction) (b : Bool)
    (hB : w ∉ wires B) : zt w b (A ++ (Instr.measureX w c0 c1 :: B)) = true := by
  rw [zt_append, zt_cons_meas]
  exact zt_of_not_mem w B true hB

theorem zero_of_zt (w : Wire) (P : Program) (h : zt w false P = true) (m : List Bool)
    (s : State) : (run P m s).basis w = false :=
  zt_sound w P false m s h (fun hf => by simp at hf)


/-! ## Single-swap windows -/

theorem pullState_symm_pull (f : Equiv.Perm Wire) (t : State) :
    pullState f.symm (pullState f t) = t := by
  apply State.extensionality
  · rfl
  · funext q
    change t.basis (f (f.symm q)) = t.basis q
    rw [Equiv.apply_symm_apply]

theorem run_perm_conj (f : Equiv.Perm Wire) (P : Program) (m : List Bool) (s : State) :
    run (renameProgram f P) m s = pullState f.symm (run P m (pullState f s)) := by
  rw [← run_rename f f.injective P m s, pullState_symm_pull]

/-- Exact run equality of a single-swap re-host: both wires zero before the window, the host
untouched by the window, the moved wire zero after it. -/
theorem swap_run_eq (a h : Wire) (P : Program) (m : List Bool) (s : State)
    (free : h ∉ wires P) (ain : s.basis a = false) (hin : s.basis h = false)
    (aout : (run P m s).basis a = false) :
    run (renameProgram (Equiv.swap a h) P) m s = run P m s := by
  rw [run_perm_conj, Equiv.symm_swap, pullState_zero_swap a h s ain hin]
  apply pullState_zero_swap a h _ aout
  rw [run_preserves_outside P m s h free]
  exact hin

/-- The re-hosted window avoids the moved wire. -/
theorem swap_avoids (a h : Wire) (P : Program) (free : h ∉ wires P) :
    a ∉ wires (renameProgram (Equiv.swap a h) P) := by
  intro hw
  rw [renameProgram_support, Finset.mem_image] at hw
  obtain ⟨r, hr, e⟩ := hw
  have : r = h := by
    have := congrArg (Equiv.swap a h) e
    rw [Equiv.swap_apply_self, Equiv.swap_apply_left] at this
    exact this
  subst this
  exact free hr

/-- Every wire of the re-hosted window is a wire of the window or the host. -/
theorem swap_support (a h : Wire) (P : Program) (free : h ∉ wires P) (q : Wire)
    (hq : q ∈ wires (renameProgram (Equiv.swap a h) P)) : q ∈ wires P ∨ q = h := by
  rw [renameProgram_support, Finset.mem_image] at hq
  obtain ⟨r, hr, rfl⟩ := hq
  rw [Equiv.swap_apply_def]
  split_ifs with h1 h2
  · exact Or.inr rfl
  · subst h2
    exact absurd hr free
  · exact Or.inl hr

end ECDSAAdd.Entrant.StairS2

end
end Merge_StairS2Core_at_QTop

