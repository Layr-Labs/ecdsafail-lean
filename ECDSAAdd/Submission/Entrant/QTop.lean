  · exact (regValue_congr _ _ _ (fun q hq => keep q (away q (by simp [hq])))).trans ys
  · refine ⟨(keep _ (away _ (by simp))).trans parity,?_,(keep _ (away _ (by simp))).trans one⟩
    simp [run,writeBit,lower]
