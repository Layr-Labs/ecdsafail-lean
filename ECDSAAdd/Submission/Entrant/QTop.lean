theorem compareChain_support (forward : Bool) (as bs cs : List Wire)
    (cin target : Wire) :
    wires (Q6LifetimeResearch.compareChain forward as bs cs cin target)⊆
      (as++bs++cs++[cin,target]).toFinset := by
  induction as generalizing bs cs cin with
  | nil => simp [Q6LifetimeResearch.compareChain,wires]
  | cons a as ih =>
      cases as with
      | nil =>
          cases bs with
          | nil => simp [Q6LifetimeResearch.compareChain,wires]
          | cons b bs =>
              cases bs <;> cases cs <;> cases forward <;> intro q hq <;>
                simp [Q6LifetimeResearch.compareChain,Q6LifetimeResearch.compareLeaf,
                  majority,eraseCarry,wires,Instr.wires,correctionWires] at hq ⊢ <;>
                tauto
      | cons a' as =>
          cases bs with
          | nil => simp [Q6LifetimeResearch.compareChain,wires]
          | cons b bs =>
              cases bs with
              | nil => simp [Q6LifetimeResearch.compareChain,wires]
              | cons b' bs =>
                  cases cs with
                  | nil => simp [Q6LifetimeResearch.compareChain,wires]
                  | cons c cs =>
                      intro q hq
                      simp only [Q6LifetimeResearch.compareChain,wires_append,
                        Finset.mem_union] at hq
                      rcases hq with (head|tail)|down
                      · simp [majority,wires,Instr.wires] at head
                        simp only [List.mem_toFinset,List.mem_append,List.mem_cons,
                          List.not_mem_nil,or_false]
                        tauto
                      · have used := ih (b'::bs) cs c tail
                        simp only [List.mem_toFinset,List.mem_append,List.mem_cons,
                          List.not_mem_nil,or_false] at used ⊢
                        tauto
                      · rw [eraseCarry_wires] at down
                        simp only [Finset.mem_insert,Finset.mem_singleton] at down
                        simp only [List.mem_toFinset,List.mem_append,List.mem_cons,
                          List.not_mem_nil,or_false]
                        tauto

/-! Semantic lifts for the three nonuniform recursive tops.  These are kept
    below the structural identities so their proofs can use exactly the same
    split as `emitLoan_mapped_prefix_run_eq`. -/


theorem renameProgram_run_eq_of (e : Equiv.Perm Nat) (P Q : Program)
    (s : State) (m n : List Bool)
    (h : run P m (pullState e s)=run Q n (pullState e s)) :
    run (renameProgram e P) m s=run (renameProgram e Q) n s := by
  apply MappedCompressed.pullState_perm_injective e
  rw [ECDSAAdd.run_rename e e.injective P m s,
    ECDSAAdd.run_rename e e.injective Q n s,h]

theorem run_sandwich_independent (A P Q R : Program) (s : State)
    (m n : List Bool) (headZero : measurementCount A=0)
    (middle : ∀x y,run P x (run A [] s)=run Q y (run A [] s))
    (tail : ∀x y,run R x (run P [] (run A [] s))=
      run R y (run P [] (run A [] s))) :
    run (A++P++R) m s=run (A++Q++R) n s := by
  rw [run_append,run_take,run_append,run_take,
    run_append,run_take,run_append,run_take]
  rw [FifthCarry.no_records A headZero s m [],
    FifthCarry.no_records A headZero s n []]
  have left := middle (m.drop (measurementCount A)) []
  have right := middle [] (n.drop (measurementCount A))
  have center := middle [] []
  rw [left,←right,←center]
  exact tail _ _

