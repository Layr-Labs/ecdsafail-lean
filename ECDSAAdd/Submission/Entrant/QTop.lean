theorem park_step (L : CuccaroStreamedSquareWideLayout) (hw:L.Widths) (hn:L.wires.Nodup)
    (base : BasisState) (hb:base L.core.sumCarry=false) (O E A : Nat) (hE:E<2^128) (kap : Bool) :
