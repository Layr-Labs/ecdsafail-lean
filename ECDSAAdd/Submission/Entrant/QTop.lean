namespace ECDSAAdd.Entrant.StairCodec

open ECDSAAdd Arithmetic

/-! A generated, budget-parametric checkpoint codec.  The construction is the
low-space sweep circuit from `PK2`: `S=u+v`, `D=±u`, and the compact word is
`bitlen (u-σ)`, the merged low word `F`, and `σ`. -/

def bitWidth (B : Nat) : Nat := (B - 1).log2 + 1

def oneHotCost : Nat → Nat
  | 0 => 0
  | 1 => 0
  | n + 2 => oneHotCost (n + 1) + 2 ^ (n + 1) - 1

def decoderCost (n : Nat) : Nat :=
  oneHotCost (n / 2) + oneHotCost (n - n / 2)

def reg (f : Nat → Wire) (n : Nat) : List Wire := (List.range n).map f

structure Layout where
  S : Nat → Wire
  D : Nat → Wire
  A : Nat → Wire
  C : Nat → Wire
  z : Wire
  t : Wire
  lowWork : Nat → Wire
  highWork : Nat → Wire

inductive EraseEntry where
  | affine (target : Wire) (sources : List Wire) (negated : Bool)
  | andGate (target left right : Wire)

structure Decoder where
  program : Program
  outputs : List Wire
  log : List EraseEntry
  used : Nat
  sites : List Wire

private def interleave : List Wire → List Wire → List Wire
  | a :: as, b :: bs => a :: b :: interleave as bs
  | _, _ => []

def cxInto (control : Wire) (targets : List Wire) : Program :=
  targets.map (Instr.CX control)

private def cxTo (target : Wire) (controls : List Wire) : Program :=
  controls.map (fun control => Instr.CX control target)

private def xOn (targets : List Wire) : Program := targets.map Instr.X

def oneHot (bits : List Wire) (fresh : Nat → Wire) : Decoder :=
  match bits with
  | [] =>
      { program := [.X (fresh 0)]
        outputs := [fresh 0]
        log := [.affine (fresh 0) [] true]
        used := 1
        sites := [fresh 0] }
  | [b] =>
      { program := [.CX b (fresh 0), .X (fresh 0)]
        outputs := [fresh 0, b]
        log := [.affine (fresh 0) [b] true]
        used := 1
        sites := [fresh 0] }
  | b :: b' :: bs =>
      let r := oneHot (b' :: bs) fresh
      let n := r.outputs.length
      let ones := (List.range n).map (fun i => fresh (r.used + i))
      let zeros := (List.range n).map (fun i => fresh (r.used + n + i))
      let andPart := (List.range (n - 1)).flatMap (fun i =>
        [.CCX b (r.outputs.getD i b) (ones.getD i b)])
      let last := ones.getD (n - 1) b
      let lastPart := [.CX b last] ++ cxTo last (ones.take (n - 1))
      let zeroPart := (List.range n).flatMap (fun i =>
        [.CX (r.outputs.getD i b) (zeros.getD i b),
         .CX (ones.getD i b) (zeros.getD i b)])
      let andLog := (List.range (n - 1)).map (fun i =>
        EraseEntry.andGate (ones.getD i b) b (r.outputs.getD i b))
      let zeroLog := (List.range n).map (fun i =>
        EraseEntry.affine (zeros.getD i b)
          [r.outputs.getD i b, ones.getD i b] false)
      { program := r.program ++ andPart ++ lastPart ++ zeroPart
        outputs := interleave zeros ones
        log := r.log ++ andLog ++
          [.affine last (b :: ones.take (n - 1)) false] ++ zeroLog
        used := r.used + 2 * n
        sites := r.sites ++ ones ++ zeros }
termination_by bits.length

private def eraseEntry : EraseEntry → Program
  | .affine target sources negated =>
      (if negated then [.X target] else []) ++
        cxTo target sources.reverse
  | .andGate target left right =>
      [.measureX target [] [.CZ left right]]

private def eraseDecoder (d : Decoder) : Program :=
  d.log.reverse.flatMap eraseEntry

/-! The decoder log is also a factorization of its forward unitary.  Keeping
this small algebraic view separate from the generated circuit makes the
measured cleanup proof independent of the recursive decoder shape. -/
private def computeEntry : EraseEntry → Program
  | .affine target sources negated =>
      cxTo target sources ++ (if negated then [.X target] else [])
  | .andGate target left right => [.CCX left right target]

private def entryTarget : EraseEntry → Wire
  | .affine target _ _ => target
  | .andGate target _ _ => target

private theorem getD_range_eq { α : Type } (xs : List α) (fallback : α) :
    (List.range xs.length).map (fun i => xs.getD i fallback) = xs := by
  apply List.ext_getElem
  · simp
  · intro i hi hj
    simp only [List.getElem_map, List.getElem_range]
    exact List.getD_eq_getElem _ _ hj

private theorem getD_range_take { α : Type } (xs : List α) (fallback : α)
    (k : Nat) (hk : k ≤ xs.length) :
    (List.range k).map (fun i => xs.getD i fallback) = xs.take k := by
  apply List.ext_getElem
  · simp [List.length_take, hk]
  · intro i hi hj
    simp only [List.getElem_map, List.getElem_range]
    have hi' : i < xs.length := by
      exact lt_of_lt_of_le (by simpa [List.length_take, hk] using hj) hk
    rw [List.getD_eq_getElem _ _ hi']
    rw [List.getElem_take]

private theorem oneHot_program_eq_log_compute (bits : List Wire) (fresh : Nat → Wire) :
    (oneHot bits fresh).program = (oneHot bits fresh).log.flatMap computeEntry := by
  induction bits with
  | nil => simp [oneHot, computeEntry, cxTo]
  | cons b bits ih =>
      cases bits with
      | nil => simp [oneHot, computeEntry, cxTo]
      | cons b' bs =>
          simp only [oneHot, List.flatMap_append, ih]
          simp [computeEntry, cxTo, List.flatMap_map]

private def andCount : List EraseEntry → Nat
  | [] => 0
  | .andGate _ _ _ :: es => andCount es + 1
  | _ :: es => andCount es

@[simp] private theorem cxInto_counts (c : Wire) (xs : List Wire) :
    toffoliCount (cxInto c xs) = 0 ∧ measurementCount (cxInto c xs) = 0 := by
  induction xs with
  | nil => simp [cxInto, toffoliCount, measurementCount]
  | cons x xs ih =>
      change toffoliCount (.CX c x :: cxInto c xs) = 0 ∧
        measurementCount (.CX c x :: cxInto c xs) = 0
      simpa [toffoliCount, measurementCount] using ih

@[simp] private theorem cxTo_counts (t : Wire) (xs : List Wire) :
    toffoliCount (cxTo t xs) = 0 ∧ measurementCount (cxTo t xs) = 0 := by
  induction xs with
  | nil => simp [cxTo, toffoliCount, measurementCount]
  | cons x xs ih =>
      change toffoliCount (.CX x t :: cxTo t xs) = 0 ∧
        measurementCount (.CX x t :: cxTo t xs) = 0
      simpa [toffoliCount, measurementCount] using ih

@[simp] private theorem xOn_counts (xs : List Wire) :
    toffoliCount (xOn xs) = 0 ∧ measurementCount (xOn xs) = 0 := by
  induction xs with
  | nil => simp [xOn, toffoliCount, measurementCount]
  | cons x xs ih =>
      change toffoliCount (.X x :: xOn xs) = 0 ∧
        measurementCount (.X x :: xOn xs) = 0
      simpa [toffoliCount, measurementCount] using ih

private theorem interleave_length (xs ys : List Wire) (h : xs.length = ys.length) :
    (interleave xs ys).length = 2 * xs.length := by
  induction xs generalizing ys with
  | nil =>
      have hy : ys = [] := List.eq_nil_of_length_eq_zero h.symm
      subst ys
      rfl
  | cons x xs ih =>
      cases ys with
      | nil => simp at h
      | cons y ys =>
          have h' : xs.length = ys.length := by simpa using h
          simp only [interleave, List.length_cons, ih ys h']
          omega

private theorem interleave_getD (xs ys : List Wire) (h : xs.length = ys.length)
    (i : Nat) (hi : i < xs.length) (fallback : Wire) :
    (interleave xs ys).getD (2 * i) fallback = xs.getD i fallback ∧
    (interleave xs ys).getD (2 * i + 1) fallback = ys.getD i fallback := by
  induction xs generalizing ys i with
  | nil => simp at hi
  | cons x xs ih =>
      cases ys with
      | nil => simp at h
      | cons y ys =>
          have hlen : xs.length = ys.length := by simpa using h
          cases i with
          | zero => simp [interleave]
          | succ i =>
              have hi' : i < xs.length := by simp at hi; omega
              have hr := ih ys hlen i hi'
              simpa [interleave, Nat.mul_succ] using hr

theorem oneHot_outputs_length (bits : List Wire) (fresh : Nat → Wire) :
    (oneHot bits fresh).outputs.length = 2 ^ bits.length := by
  induction bits with
  | nil => simp [oneHot]
  | cons b bits ih =>
      cases bits with
      | nil => simp [oneHot]
      | cons b' bs =>
          simp only [oneHot]
          rw [interleave_length]
          · simp [ih, pow_succ, Nat.mul_comm]
          · simp

private theorem oneHot_log_targets (bits : List Wire) (fresh : Nat → Wire) :
    (oneHot bits fresh).log.map entryTarget = (oneHot bits fresh).sites := by
  induction bits with
  | nil => simp [oneHot, entryTarget]
  | cons b bits ih =>
      cases bits with
      | nil => simp [oneHot, entryTarget]
      | cons b' bs =>
          let r := oneHot (b' :: bs) fresh
          let n := r.outputs.length
          let ones := (List.range n).map (fun i => fresh (r.used + i))
          let zeros := (List.range n).map (fun i => fresh (r.used + n + i))
          have hn : 0 < n := by
            dsimp only [n, r]
            rw [oneHot_outputs_length]
            positivity
          have honesLen : ones.length = n := by simp [ones]
          have hzerosLen : zeros.length = n := by simp [zeros]
          have hand : (List.range (n - 1)).map (fun i => ones.getD i b) =
              ones.take (n - 1) := getD_range_take ones b (n - 1) (by omega)
          have hzero : (List.range n).map (fun i => zeros.getD i b) = zeros := by
            simpa [hzerosLen] using getD_range_eq zeros b
          have hlast : ones.take (n - 1) ++ [ones.getD (n - 1) b] = ones := by
            have hi : n - 1 < ones.length := by omega
            have h := List.take_concat_get (l := ones) (i := n - 1) hi
            rw [← List.getD_eq_getElem ones b hi] at h
            have hlen : n - 1 + 1 = ones.length := by omega
            simpa [List.concat_eq_append, hlen] using h
          simp only [oneHot, List.map_append, ih]
          have htail : (List.range (n - 1)).map (fun i => ones.getD i b) ++
              [ones.getD (n - 1) b] ++
              (List.range n).map (fun i => zeros.getD i b) = ones ++ zeros
              := by
            rw [hand, hzero]
            simpa only [List.append_assoc] using congrArg (fun xs => xs ++ zeros) hlast
          simpa only [r, n, ones, zeros, List.map_map, Function.comp_apply, entryTarget,
            List.map_singleton, ← List.append_assoc] using
            congrArg (fun tail => r.sites ++ tail) htail


private theorem eraseList_counts (es : List EraseEntry) :
    toffoliCount (es.flatMap eraseEntry) = 0 ∧
    measurementCount (es.flatMap eraseEntry) = andCount es := by
  induction es with
  | nil => simp [andCount, toffoliCount, measurementCount]
  | cons e es ih =>
      cases e with
      | affine target sources negated =>
          cases negated <;> simp [andCount, eraseEntry, ih, toffoliCount, measurementCount]
      | andGate target left right =>
          simp [andCount, eraseEntry, ih, toffoliCount, measurementCount, Nat.add_comm]

private theorem andCount_append (xs ys : List EraseEntry) :
    andCount (xs ++ ys) = andCount xs + andCount ys := by
  induction xs with
  | nil => simp [andCount]
  | cons x xs ih =>
      cases x <;> simp [andCount, ih]
      omega

private theorem andCount_reverse (es : List EraseEntry) : andCount es.reverse = andCount es := by
  induction es with
  | nil => rfl
  | cons e es ih =>
      rw [List.reverse_cons, andCount_append, ih]
      cases e <;> simp [andCount, Nat.add_comm]

private theorem ccxRange_counts (n : Nat) (a b t : Nat → Wire) :
    toffoliCount ((List.range n).flatMap (fun i => [.CCX (a i) (b i) (t i)])) = n ∧
    measurementCount ((List.range n).flatMap (fun i => [.CCX (a i) (b i) (t i)])) = 0 := by
  induction n with
  | zero => exact ⟨rfl, rfl⟩
  | succ n ih =>
      rw [List.range_succ, List.flatMap_append, toffoliCount_append, measurementCount_append]
      simpa [toffoliCount, measurementCount] using ih

private theorem cxPairRange_counts (n : Nat) (a b c d : Nat → Wire) :
    toffoliCount ((List.range n).flatMap (fun i => [.CX (a i) (b i), .CX (c i) (d i)])) = 0 ∧
    measurementCount ((List.range n).flatMap (fun i => [.CX (a i) (b i), .CX (c i) (d i)])) = 0 := by
  induction n with
  | zero => exact ⟨rfl, rfl⟩
  | succ n ih =>
      rw [List.range_succ, List.flatMap_append, toffoliCount_append, measurementCount_append]
      simpa [toffoliCount, measurementCount] using ih

private theorem andCount_andRange (n : Nat) (t a b : Nat → Wire) :
    andCount ((List.range n).map (fun i => EraseEntry.andGate (t i) (a i) (b i))) = n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [List.range_succ, List.map_append, andCount_append, ih]; simp [andCount]

private theorem andCount_affineRange (n : Nat) (t : Nat → Wire) (s : Nat → List Wire) :
    andCount ((List.range n).map (fun i => EraseEntry.affine (t i) (s i) false)) = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => rw [List.range_succ, List.map_append, andCount_append, ih]; rfl

private theorem eraseDecoder_counts (d : Decoder) :
    toffoliCount (eraseDecoder d) = 0 ∧
    measurementCount (eraseDecoder d) = andCount d.log := by
  rw [eraseDecoder, (eraseList_counts d.log.reverse).1,
    (eraseList_counts d.log.reverse).2, andCount_reverse]
  exact ⟨rfl, rfl⟩

private theorem oneHot_counts (bits : List Wire) (fresh : Nat → Wire) :
    toffoliCount (oneHot bits fresh).program = oneHotCost bits.length ∧
    measurementCount (oneHot bits fresh).program = 0 ∧
    andCount (oneHot bits fresh).log = oneHotCost bits.length := by
  induction bits with
  | nil => simp [oneHot, oneHotCost, toffoliCount, measurementCount, andCount]
  | cons b bits ih =>
      cases bits with
      | nil => simp [oneHot, oneHotCost, toffoliCount, measurementCount, andCount]
      | cons b' bs =>
          have hout := oneHot_outputs_length (b' :: bs) fresh
          have hpow : 0 < 2 ^ bs.length := by positivity
          have hpow' : 0 < 2 ^ (bs.length + 1) := by positivity
          have hand := ccxRange_counts ((oneHot (b' :: bs) fresh).outputs.length - 1)
            (fun _ => b) (fun i => (oneHot (b' :: bs) fresh).outputs.getD i b)
            (fun i => ((List.range (oneHot (b' :: bs) fresh).outputs.length).map
              (fun i => fresh ((oneHot (b' :: bs) fresh).used + i))).getD i b)
          have hzero := cxPairRange_counts (oneHot (b' :: bs) fresh).outputs.length
            (fun i => (oneHot (b' :: bs) fresh).outputs.getD i b)
            (fun i => ((List.range (oneHot (b' :: bs) fresh).outputs.length).map
              (fun i => fresh ((oneHot (b' :: bs) fresh).used +
                (oneHot (b' :: bs) fresh).outputs.length + i))).getD i b)
            (fun i => ((List.range (oneHot (b' :: bs) fresh).outputs.length).map
              (fun i => fresh ((oneHot (b' :: bs) fresh).used + i))).getD i b)
            (fun i => ((List.range (oneHot (b' :: bs) fresh).outputs.length).map
              (fun i => fresh ((oneHot (b' :: bs) fresh).used +
                (oneHot (b' :: bs) fresh).outputs.length + i))).getD i b)
          simp only [oneHot]
          simp only [toffoliCount_append, measurementCount_append]
          rw [ih.1, ih.2.1]
          constructor
          · rw [hand.1, hzero.1]
            simp [cxTo_counts, toffoliCount, hout, oneHotCost]
            omega
          · constructor
            · rw [hand.2, hzero.2]
              simp [cxTo_counts, measurementCount]
            · simp only [andCount_append, ih.2.2, andCount_andRange,
                andCount_affineRange]
              simp [andCount, hout, oneHotCost]
              omega

theorem oneHot_program_measurements (bits : List Wire) (fresh : Nat → Wire) :
    measurementCount (oneHot bits fresh).program = 0 :=
  (oneHot_counts bits fresh).2.1

private def eraseSites : EraseEntry → List Wire
  | .affine target sources _ => target :: sources
  | .andGate target left right => [target, left, right]

theorem getD_mem_or_eq { α : Type } (xs : List α) (i : Nat) (fallback : α) :
    xs.getD i fallback ∈ xs ∨ xs.getD i fallback = fallback := by
  induction xs generalizing i with
  | nil => simp
  | cons x xs ih =>
      cases i with
      | zero => simp
      | succ i =>
          rcases ih i with hm | hm
          · exact Or.inl (by simpa using List.mem_cons_of_mem x hm)
          · exact Or.inr (by simpa using hm)

private theorem interleave_mem {q : Wire} {xs ys : List Wire}
    (h : q ∈ interleave xs ys) : q ∈ xs ∨ q ∈ ys := by
  induction xs generalizing ys with
  | nil => simp [interleave] at h
  | cons x xs ih =>
      cases ys with
      | nil => simp [interleave] at h
      | cons y ys =>
          simp only [interleave, List.mem_cons] at h ⊢
          rcases h with rfl | rfl | h
          · exact Or.inl (Or.inl rfl)
          · exact Or.inr (Or.inl rfl)
          · rcases ih h with hx | hy
            · exact Or.inl (Or.inr hx)
            · exact Or.inr (Or.inr hy)

theorem cxInto_support (c : Wire) (xs : List Wire) :
    wires (cxInto c xs) ⊆ (c :: xs).toFinset := by
  induction xs with
  | nil => simp [cxInto, wires]
  | cons x xs ih =>
      intro q hq
      simp only [cxInto, List.map_cons, wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton, List.mem_toFinset, List.mem_cons] at hq ⊢
      rcases hq with (rfl | rfl) | hq
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
      · have hm := ih hq
        simp only [List.mem_toFinset, List.mem_cons] at hm
        tauto

private theorem cxTo_support (t : Wire) (xs : List Wire) :
    wires (cxTo t xs) ⊆ (t :: xs).toFinset := by
  induction xs with
  | nil => simp [cxTo, wires]
  | cons x xs ih =>
      intro q hq
      simp only [cxTo, List.map_cons, wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton, List.mem_toFinset, List.mem_cons] at hq ⊢
      rcases hq with (rfl | rfl) | hq
      · exact Or.inr (Or.inl rfl)
      · exact Or.inl rfl
      · have hm := ih hq
        simp only [List.mem_toFinset, List.mem_cons] at hm
        tauto

theorem xOn_support (xs : List Wire) :
    wires (xOn xs) ⊆ xs.toFinset := by
  induction xs with
  | nil => simp [xOn, wires]
  | cons x xs ih =>
      intro q hq
      simp only [xOn, List.map_cons, wires, Instr.wires, Finset.mem_union, Finset.mem_singleton,
        List.mem_toFinset, List.mem_cons] at hq ⊢
      rcases hq with rfl | hq
      · exact Or.inl rfl
      · exact Or.inr (List.mem_toFinset.mp (ih hq))

private theorem eraseEntry_support (e : EraseEntry) :
    wires (eraseEntry e) ⊆ (eraseSites e).toFinset := by
  cases e with
  | affine target sources negated =>
      cases negated with
      | false =>
        simp only [eraseEntry, eraseSites, Bool.false_eq_true, if_false,
          List.nil_append]
        intro q hq
        have hm := cxTo_support target sources.reverse hq
        simpa only [List.mem_toFinset, List.mem_cons, List.mem_reverse] using hm
      | true =>
        simp only [eraseEntry, eraseSites, if_true, wires_append,
          Finset.union_subset_iff]
        constructor
        · simp [wires, Instr.wires]
        · intro q hq
          have hm := cxTo_support target sources.reverse hq
          simpa only [List.mem_toFinset, List.mem_cons, List.mem_reverse] using hm
  | andGate target left right =>
      intro q hq
      simp [eraseEntry, eraseSites, wires, Instr.wires, correctionWires] at hq ⊢
      tauto

private theorem eraseList_support (es : List EraseEntry) :
    wires (es.flatMap eraseEntry) ⊆ (es.flatMap eraseSites).toFinset := by
  induction es with
  | nil => simp [wires]
  | cons e es ih =>
      intro q hq
      simp only [List.flatMap_cons, wires_append, Finset.mem_union,
        List.mem_toFinset, List.mem_append] at hq ⊢
      rcases hq with hq | hq
      · exact Or.inl (List.mem_toFinset.mp (eraseEntry_support e hq))
      · exact Or.inr (List.mem_toFinset.mp (ih hq))

private theorem wires_flatMap_subset {S : Finset Wire} (xs : List Nat)
    (f : Nat → Program) (h : ∀ i ∈ xs, wires (f i) ⊆ S) :
    wires (xs.flatMap f) ⊆ S := by
  induction xs with
  | nil => simp [wires]
  | cons i xs ih =>
      intro q hq
      simp only [List.flatMap_cons, wires_append, Finset.mem_union] at hq
      rcases hq with hq | hq
      · exact h i (by simp) hq
      · exact ih (fun j hj => h j (by simp [hj])) hq

theorem oneHot_structural (bits : List Wire) (fresh : Nat → Wire) :
    wires (oneHot bits fresh).program ⊆ (bits ++ (oneHot bits fresh).sites).toFinset ∧
    (∀ q ∈ (oneHot bits fresh).outputs, q ∈ bits ++ (oneHot bits fresh).sites) ∧
    (∀ e ∈ (oneHot bits fresh).log,
      ∀ q ∈ eraseSites e, q ∈ bits ++ (oneHot bits fresh).sites) := by
  induction bits with
  | nil =>
      simp [oneHot, wires, Instr.wires, eraseSites]
  | cons b bits ih =>
      cases bits with
      | nil =>
          simp [oneHot, wires, Instr.wires, eraseSites]
      | cons b' bs =>
          simp only [oneHot]
          let r := oneHot (b' :: bs) fresh
          let n := r.outputs.length
          let ones := (List.range n).map (fun i => fresh (r.used + i))
          let zeros := (List.range n).map (fun i => fresh (r.used + n + i))
          have hr := ih
          have hout (q : Wire) (hq : q ∈ r.outputs) :
              q ∈ b' :: bs ++ r.sites := hr.2.1 q hq
          have hi : ∀ q ∈ interleave zeros ones, q ∈ zeros ∨ q ∈ ones := by
            intro q hq
            exact interleave_mem hq
          have hout' (i : Nat) :
              r.outputs.getD i b ∈ b :: b' :: bs ++ (r.sites ++ ones ++ zeros) := by
            rcases getD_mem_or_eq r.outputs i b with hm | hm
            · have ht := hout _ hm
              simp only [List.mem_cons, List.mem_append] at ht ⊢
              tauto
            · rw [hm]
              simp
          have hones (i : Nat) :
              ones.getD i b ∈ b :: b' :: bs ++ (r.sites ++ ones ++ zeros) := by
            rcases getD_mem_or_eq ones i b with hm | hm
            · simp only [List.mem_cons, List.mem_append]
              tauto
            · rw [hm]
              simp
          have hzeros (i : Nat) :
              zeros.getD i b ∈ b :: b' :: bs ++ (r.sites ++ ones ++ zeros) := by
            rcases getD_mem_or_eq zeros i b with hm | hm
            · simp only [List.mem_cons, List.mem_append]
              tauto
            · rw [hm]
              simp
          have hprog :
              wires (r.program ++
                (List.range (n - 1)).flatMap (fun i =>
                  [.CCX b (r.outputs.getD i b) (ones.getD i b)]) ++
                ([.CX b (ones.getD (n - 1) b)] ++ cxTo (ones.getD (n - 1) b) (ones.take (n - 1))) ++
                (List.range n).flatMap (fun i =>
                  [.CX (r.outputs.getD i b) (zeros.getD i b),
                   .CX (ones.getD i b) (zeros.getD i b)])) ⊆
                (b :: b' :: bs ++ (r.sites ++ ones ++ zeros)).toFinset := by
            intro q hq
            simp only [wires_append, Finset.mem_union] at hq
            rcases hq with ((hq | hq) | hq) | hq
            · have hm := hr.1 hq
              simp only [List.mem_toFinset, List.mem_cons, List.mem_append] at hm ⊢
              tauto
            · apply wires_flatMap_subset (List.range (n - 1)) _ _ hq
              intro i hiN q hq
              simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
                Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
              simp only [List.mem_toFinset]
              rcases hq with rfl | rfl | rfl
              · simp
              · exact hout' i
              · exact hones i
            · rcases hq with hq | hq
              · simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
                  Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
                rcases hq with hq | hq
                · rw [hq]; simp
                · rw [hq]; exact List.mem_toFinset.mpr (hones (n - 1))
              · have hm := cxTo_support (ones.getD (n - 1) b) (ones.take (n - 1)) hq
                simp only [List.mem_toFinset, List.mem_cons] at hm
                rcases hm with hm | hm
                · rw [hm]
                  exact List.mem_toFinset.mpr (hones (n - 1))
                · have hm' := List.mem_of_mem_take hm
                  simp only [List.mem_toFinset, List.mem_cons, List.mem_append]
                  tauto
            · apply wires_flatMap_subset (List.range n) _ _ hq
              intro i hiN q hq
              simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
                Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
              simp only [List.mem_toFinset]
              rcases hq with (rfl | rfl) | rfl | rfl
              · exact hout' i
              · exact hzeros i
              · exact hones i
              · exact hzeros i
          refine ⟨hprog, ?_, ?_⟩
          · intro q hq
            have hm := hi q hq
            simp only [List.mem_cons, List.mem_append]
            tauto
          · intro e he q hq
            rcases List.mem_append.mp he with he | heZero
            rcases List.mem_append.mp he with he | heAff
            rcases List.mem_append.mp he with heR | heAnd
            · have hm := hr.2.2 e heR q hq
              simp only [List.mem_cons, List.mem_append] at hm ⊢
              tauto
            · simp only [List.mem_map, List.mem_range] at heAnd
              rcases heAnd with ⟨i, hiN, rfl⟩
              simp only [eraseSites, List.mem_cons, List.not_mem_nil, or_false] at hq
              rcases hq with hq | hq | hq
              · rw [hq]; exact hones i
              · rw [hq]; simp
              · rw [hq]; exact hout' i
            · have heq := List.mem_singleton.mp heAff
              subst e
              change q ∈ eraseSites (.affine (ones.getD (n - 1) b)
                (b :: ones.take (n - 1)) false) at hq
              simp only [eraseSites, List.mem_cons] at hq
              rcases hq with hq | hq
              · rw [hq]; exact hones (n - 1)
              · rcases hq with hq | hq
                · rw [hq]; simp
                · have hm := List.mem_of_mem_take hq
                  simp only [List.mem_cons, List.mem_append]
                  tauto
            · simp only [List.mem_map, List.mem_range] at heZero
              rcases heZero with ⟨i, hiN, rfl⟩
              simp only [eraseSites, List.mem_cons, List.not_mem_nil, or_false] at hq
              rcases hq with hq | hq
              · rw [hq]; exact hzeros i
              · rcases hq with rfl | hq
                · exact hout' i
                · rw [hq]; exact hones i

theorem oneHot_program_support (bits : List Wire) (fresh : Nat → Wire) :
    wires (oneHot bits fresh).program ⊆ (bits ++ (oneHot bits fresh).sites).toFinset :=
  (oneHot_structural bits fresh).1

private theorem eraseDecoder_support (bits : List Wire) (fresh : Nat → Wire) :
    wires (eraseDecoder (oneHot bits fresh)) ⊆
      (bits ++ (oneHot bits fresh).sites).toFinset := by
  intro q hq
  have hflat := eraseList_support (oneHot bits fresh).log.reverse hq
  simp only [eraseDecoder, List.mem_toFinset, List.mem_flatMap, List.mem_reverse] at hflat ⊢
  rcases hflat with ⟨e, he, hq⟩
  exact (oneHot_structural bits fresh).2.2 e he q hq

private theorem gatePhysical_flatMap {α : Type} (xs : List α) (f : α → Program)
    (h : ∀ x ∈ xs, GatePhysical (f x)) : GatePhysical (xs.flatMap f) := by
  induction xs with
  | nil => simp [GatePhysical]
  | cons x xs ih =>
      rw [List.flatMap_cons, gatePhysical_append]
      exact ⟨h x (by simp), ih (fun y hy => h y (by simp [hy]))⟩

private theorem cxInto_physical (control : Wire) (targets : List Wire)
    (h : ∀ q ∈ targets, control ≠ q) : GatePhysical (cxInto control targets) := by
  induction targets with
  | nil => simp [cxInto, GatePhysical]
  | cons q qs ih =>
      change GatePhysical (.CX control q :: cxInto control qs)
      intro i hi
      simp only [List.mem_cons] at hi
      rcases hi with rfl | hi
      · simpa [RecordedQuantum.PhysicalInstr, ProperGate] using h q (by simp)
      · exact ih (fun r hr => h r (by simp [hr])) i hi

private theorem cxTo_physical (target : Wire) (controls : List Wire)
    (h : ∀ q ∈ controls, q ≠ target) : GatePhysical (cxTo target controls) := by
  induction controls with
  | nil => simp [cxTo, GatePhysical]
  | cons q qs ih =>
      change GatePhysical (.CX q target :: cxTo target qs)
      intro i hi
      simp only [List.mem_cons] at hi
      rcases hi with rfl | hi
      · simpa [RecordedQuantum.PhysicalInstr, ProperGate] using h q (by simp)
      · exact ih (fun r hr => h r (by simp [hr])) i hi

private theorem xOn_physical (targets : List Wire) : GatePhysical (xOn targets) := by
  induction targets with
  | nil => simp [xOn, GatePhysical]
  | cons q qs ih =>
      change GatePhysical (.X q :: xOn qs)
      intro i hi
      simp only [List.mem_cons] at hi
      rcases hi with rfl | hi
      · simp [RecordedQuantum.PhysicalInstr, ProperGate]
      · exact ih i hi

theorem xOn_run (targets : List Wire) (hn : targets.Nodup)
    (s : State) (m : List Bool) :
    run (xOn targets) m s =
      ⟨s.phase, fun q => if q ∈ targets then !s.basis q else s.basis q⟩ := by
  induction targets generalizing s with
  | nil => simp [xOn, run]
  | cons x xs ih =>
      have hx := (List.nodup_cons.mp hn).1
      have hxs := (List.nodup_cons.mp hn).2
      change run (xOn xs) m (run [.X x] m s) = _
      rw [ih hxs]
      congr 1
      funext q
      by_cases hqx : q = x
      · subst q
        simp [run, writeBit, Function.update, hx]
      · simp [run, writeBit, Function.update, hqx]

theorem cxInto_run (control : Wire) (targets : List Wire)
    (hn : targets.Nodup) (hc : control ∉ targets) (s : State) (m : List Bool) :
    run (cxInto control targets) m s =
      ⟨s.phase, fun q =>
        if s.basis control && decide (q ∈ targets) then !s.basis q else s.basis q⟩ := by
  induction targets generalizing s with
  | nil => simp [cxInto, run]
  | cons x xs ih =>
      have hnx := (List.nodup_cons.mp hn).1
      have hnxs := (List.nodup_cons.mp hn).2
      have hc' := hc
      simp only [List.mem_cons, not_or] at hc'
      have hcx : control ≠ x := hc'.1
      have hcxs := hc'.2
      change run (cxInto control xs) m (run [.CX control x] m s) = _
      rw [ih hnxs hcxs]
      congr 1
      funext q
      by_cases hqx : q = x
      · subst q
        cases hb : s.basis control <;>
          simp [run, writeBit, Function.update, hcx, hnx, hb]
      · cases hb : s.basis control <;>
          simp [run, writeBit, Function.update, hcx, hqx, hb]

private theorem cxTo_run (target : Wire) (controls : List Wire)
    (hc : target ∉ controls) (s : State) (m : List Bool) :
    (run (cxTo target controls) m s).phase = s.phase ∧
    (∀ q, q ≠ target → (run (cxTo target controls) m s).basis q = s.basis q) ∧
    (run (cxTo target controls) m s).basis target =
      controls.foldl (fun v q => v ^^ s.basis q) (s.basis target) := by
  induction controls generalizing s with
  | nil => simp [cxTo, run]
  | cons c cs ih =>
      have hct : target ≠ c := by
        exact (by simpa [List.mem_cons] using hc : target ≠ c ∧ target ∉ cs).1
      have hrest : target ∉ cs := by
        exact (by simpa [List.mem_cons] using hc : target ≠ c ∧ target ∉ cs).2
      let u := run [.CX c target] m s
      have huPhase : u.phase = s.phase := by simp [u, run]
      have huOutside : ∀ q, q ≠ target → u.basis q = s.basis q := by
        intro q hq
        simp [u, run, writeBit, hq]
      have huTarget : u.basis target = (s.basis target ^^ s.basis c) := by
        change (writeBit s.basis target (s.basis target ^^ s.basis c)) target = _
        simp [writeBit]
      change (run (cxTo target cs) m u).phase = s.phase ∧
        (∀ q, q ≠ target → (run (cxTo target cs) m u).basis q = s.basis q) ∧
        (run (cxTo target cs) m u).basis target =
          List.foldl (fun v q => v ^^ s.basis q) (s.basis target ^^ s.basis c) cs
      have hr := ih hrest u
      refine ⟨hr.1.trans huPhase, ?_, ?_⟩
      · intro q hq
        exact (hr.2.1 q hq).trans (huOutside q hq)
      · have hfold (xs : List Wire) (hxs : ∀ q ∈ xs, q ≠ target) (v : Bool) :
            xs.foldl (fun a q => a ^^ u.basis q) v =
              xs.foldl (fun a q => a ^^ s.basis q) v := by
          induction xs generalizing v with
          | nil => rfl
          | cons q qs ihxs =>
              have hqt : q ≠ target := hxs q (by simp)
              simp only [List.foldl_cons, huOutside q hqt]
              exact ihxs (fun a ha => hxs a (by simp [ha])) _
        have hcs : ∀ q ∈ cs, q ≠ target := by
          intro q hq heq
          subst q
          exact hrest hq
        rw [hr.2.2, hfold cs hcs, huTarget]

private theorem ccxRange_run (n : Nat) (control : Wire)
    (source target : Nat → Wire)
    (hinj : ∀ i, i < n → ∀ j, j < n → target i = target j → i = j)
    (hcontrol : ∀ i, i < n → control ≠ target i)
    (hsource : ∀ i, i < n → ∀ j, j < n → source i ≠ target j)
    (s : State) (m : List Bool) :
    let p := (List.range n).flatMap
      (fun i => ([Instr.CCX control (source i) (target i)] : Program))
    (run p m s).phase = s.phase ∧
    (∀ q, (∀ i, i < n → q ≠ target i) → (run p m s).basis q = s.basis q) ∧
    (∀ i, i < n → (run p m s).basis (target i) =
      (s.basis (target i) ^^ (s.basis control && s.basis (source i)))) := by
  induction n generalizing s m with
  | zero => simp [run]
  | succ n ih =>
      let p := (List.range n).flatMap
        (fun i => ([Instr.CCX control (source i) (target i)] : Program))
      have hp0 : measurementCount p = 0 :=
        (ccxRange_counts n (fun _ => control) source target).2
      have hprev := ih
        (fun i hi j hj h => hinj i (by omega) j (by omega) h)
        (fun i hi => hcontrol i (by omega))
        (fun i hi j hj => hsource i (by omega) j (by omega)) s
        (m.take (measurementCount p))
      let u := run p (m.take (measurementCount p)) s
      have huPhase : u.phase = s.phase := hprev.1
      have huOutside : ∀ q, (∀ i, i < n → q ≠ target i) →
          u.basis q = s.basis q := hprev.2.1
      have huTarget : ∀ i, i < n → u.basis (target i) =
          (s.basis (target i) ^^ (s.basis control && s.basis (source i))) := hprev.2.2
      simp only [List.range_succ, List.flatMap_append, List.flatMap_singleton, run_append,
        hp0, List.take_zero, List.drop_zero]
      change (run [.CCX control (source n) (target n)] m u).phase = s.phase ∧
        (∀ q, (∀ i, i < n + 1 → q ≠ target i) →
          (run [.CCX control (source n) (target n)] m u).basis q = s.basis q) ∧
        (∀ i, i < n + 1 →
          (run [.CCX control (source n) (target n)] m u).basis (target i) =
            (s.basis (target i) ^^ (s.basis control && s.basis (source i))))
      have hnewOld : ∀ i, i < n → target n ≠ target i := by
        intro i hi heq
        have := hinj n (by omega) i (by omega) heq
        omega
      have huControl : u.basis control = s.basis control := by
        apply huOutside
        intro i hi
        exact hcontrol i (by omega)
      have huSource : u.basis (source n) = s.basis (source n) := by
        apply huOutside
        intro i hi
        exact hsource n (by omega) i (by omega)
      have huNew : u.basis (target n) = s.basis (target n) := by
        apply huOutside
        exact hnewOld
      refine ⟨by simpa [run] using huPhase, ?_, ?_⟩
      · intro q hq
        have hqn : q ≠ target n := hq n (by omega)
        rw [show (run [.CCX control (source n) (target n)] m u).basis q = u.basis q by
          simp [run, writeBit, hqn]]
        apply huOutside
        intro i hi
        exact hq i (by omega)
      · intro i hi
        by_cases hin : i = n
        · subst i
          simp [run, writeBit, huNew, huControl, huSource]
        · have hil : i < n := by omega
          have hti : target i ≠ target n := by
            intro heq
            exact hin (hinj i (by omega) n (by omega) heq)
          rw [show (run [.CCX control (source n) (target n)] m u).basis (target i) =
              u.basis (target i) by simp [run, writeBit, hti]]
          exact huTarget i hil

private theorem cxPairRange_run (n : Nat) (source₁ source₂ target : Nat → Wire)
    (hinj : ∀ i, i < n → ∀ j, j < n → target i = target j → i = j)
    (hsource₁ : ∀ i, i < n → ∀ j, j < n → source₁ i ≠ target j)
    (hsource₂ : ∀ i, i < n → ∀ j, j < n → source₂ i ≠ target j)
    (s : State) (m : List Bool) :
    let p := (List.range n).flatMap (fun i =>
      ([Instr.CX (source₁ i) (target i), Instr.CX (source₂ i) (target i)] : Program))
    (run p m s).phase = s.phase ∧
    (∀ q, (∀ i, i < n → q ≠ target i) → (run p m s).basis q = s.basis q) ∧
    (∀ i, i < n → (run p m s).basis (target i) =
      (s.basis (target i) ^^ s.basis (source₁ i) ^^ s.basis (source₂ i))) := by
  induction n generalizing s m with
  | zero => simp [run]
  | succ n ih =>
      let p := (List.range n).flatMap (fun i =>
        ([Instr.CX (source₁ i) (target i), Instr.CX (source₂ i) (target i)] : Program))
      have hp0 : measurementCount p = 0 :=
        (cxPairRange_counts n source₁ target source₂ target).2
      have hprev := ih
        (fun i hi j hj h => hinj i (by omega) j (by omega) h)
        (fun i hi j hj => hsource₁ i (by omega) j (by omega))
        (fun i hi j hj => hsource₂ i (by omega) j (by omega)) s
        (m.take (measurementCount p))
      let u := run p (m.take (measurementCount p)) s
      have huPhase : u.phase = s.phase := hprev.1
      have huOutside : ∀ q, (∀ i, i < n → q ≠ target i) →
          u.basis q = s.basis q := hprev.2.1
      have huTarget : ∀ i, i < n → u.basis (target i) =
          (s.basis (target i) ^^ s.basis (source₁ i) ^^ s.basis (source₂ i)) :=
        hprev.2.2
      simp only [List.range_succ, List.flatMap_append, List.flatMap_singleton,
        run_append, hp0, List.take_zero, List.drop_zero]
      change (run [.CX (source₁ n) (target n), .CX (source₂ n) (target n)] m u).phase =
          s.phase ∧
        (∀ q, (∀ i, i < n + 1 → q ≠ target i) →
          (run [.CX (source₁ n) (target n), .CX (source₂ n) (target n)] m u).basis q =
            s.basis q) ∧
        (∀ i, i < n + 1 →
          (run [.CX (source₁ n) (target n), .CX (source₂ n) (target n)] m u).basis
              (target i) =
            (s.basis (target i) ^^ s.basis (source₁ i) ^^ s.basis (source₂ i)))
      have hnewOld : ∀ i, i < n → target n ≠ target i := by
        intro i hi heq
        have := hinj n (by omega) i (by omega) heq
        omega
      have huSource₁ : u.basis (source₁ n) = s.basis (source₁ n) := by
        apply huOutside
        intro i hi
        exact hsource₁ n (by omega) i (by omega)
      have huSource₂ : u.basis (source₂ n) = s.basis (source₂ n) := by
        apply huOutside
        intro i hi
        exact hsource₂ n (by omega) i (by omega)
      have huNew : u.basis (target n) = s.basis (target n) := by
        apply huOutside
        exact hnewOld
      have hs₁New : source₁ n ≠ target n := hsource₁ n (by omega) n (by omega)
      have hs₂New : source₂ n ≠ target n := hsource₂ n (by omega) n (by omega)
      refine ⟨by simpa [run] using huPhase, ?_, ?_⟩
      · intro q hq
        have hqn : q ≠ target n := hq n (by omega)
        rw [show
          (run [.CX (source₁ n) (target n), .CX (source₂ n) (target n)] m u).basis q =
            u.basis q by simp [run, writeBit, hqn]]
        apply huOutside
        intro i hi
        exact hq i (by omega)
      · intro i hi
        by_cases hin : i = n
        · subst i
          simp [run, writeBit, huNew, huSource₁, huSource₂,
            hs₁New, hs₂New, Ne.symm hs₁New, Ne.symm hs₂New]
        · have hil : i < n := by omega
          have hti : target i ≠ target n := by
            intro heq
            exact hin (hinj i (by omega) n (by omega) heq)
          rw [show
            (run [.CX (source₁ n) (target n), .CX (source₂ n) (target n)] m u).basis
                (target i) = u.basis (target i) by simp [run, writeBit, hti]]
          exact huTarget i hil

private theorem foldl_xor_eq_index (k y : Nat) (initial : Bool) :
    (List.range k).foldl (fun a i => a ^^ decide (i = y)) initial =
      if y < k then !initial else initial := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [List.range_succ, List.foldl_append, ih]
      simp only [List.foldl]
      by_cases hy : y < k
      · have hne : k ≠ y := by omega
        have hy' : y < k + 1 := by omega
        simp [hy, hy', hne]
      · by_cases heq : y = k
        · subst y
          simp
        · have hgt : k + 1 ≤ y := by omega
          have hky : k ≠ y := by omega
          simp [hy, hky, show ¬ y < k + 1 by omega]

private theorem foldl_xor_selected (n y : Nat) (hy : y < n) (selected : Bool) :
    (List.range (n - 1)).foldl
        (fun a i => a ^^ (selected && decide (i = y))) selected =
      (selected && decide (y = n - 1)) := by
  cases selected with
  | false =>
      simp only [Bool.false_and, Bool.xor_false]
      have hz (xs : List Nat) : xs.foldl (fun a _ => a) false = false := by
        induction xs with
        | nil => rfl
        | cons _ xs ih => simpa only [List.foldl] using ih
      exact hz _
  | true =>
      simp only [Bool.true_and]
      rw [foldl_xor_eq_index]
      by_cases hlt : y < n - 1
      · have hne : y ≠ n - 1 := by omega
        simp [hlt, hne]
      · have heq : y = n - 1 := by omega
        simp [hlt, heq]

private theorem cross_ne_of_nodup {α : Type} {xs ys : List α} {x y : α}
    (hn : (xs ++ ys).Nodup) (hx : x ∈ xs) (hy : y ∈ ys) : x ≠ y := by
  exact (List.nodup_append.mp hn).2.2 x hx y hy

private theorem eraseEntry_physical_of (e : EraseEntry)
    (h : match e with
      | .affine target sources _ => ∀ q ∈ sources, q ≠ target
      | .andGate _ _ _ => True) : GatePhysical (eraseEntry e) := by
  cases e with
  | affine target sources negated =>
      cases negated with
      | false =>
          simp only [eraseEntry, Bool.false_eq_true, if_false, List.nil_append]
          apply cxTo_physical
          intro q hq
          exact h q (List.mem_reverse.mp hq)
      | true =>
          rw [eraseEntry, if_pos rfl, gatePhysical_append]
          refine ⟨by simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate], ?_⟩
          apply cxTo_physical
          intro q hq
          exact h q (List.mem_reverse.mp hq)
  | andGate target left right =>
      simp [eraseEntry, GatePhysical, RecordedQuantum.PhysicalInstr]

/-- The measured inverse of a clean AND restores phase for either measurement
record and clears only its target. -/
theorem erase_and_correct (target left right : Wire)
    (hlt : left ≠ target) (hrt : right ≠ target) (s : State)
    (ht : s.basis target = (s.basis left && s.basis right)) (m : List Bool) :
    run [.measureX target [] [.CZ left right]] m s =
      ⟨s.phase, writeBit s.basis target false⟩ := by
  cases s with
  | mk phase basis =>
      simp only [] at ht ⊢
      congr 1
      · cases m with
        | nil =>
            cases hl : basis left <;> cases hr : basis right <;>
              simp_all [run, measureAndCorrect, correct, writeBit, Function.update]
        | cons bit m =>
            cases bit <;> cases hl : basis left <;> cases hr : basis right <;>
              simp_all [run, measureAndCorrect, correct, writeBit, Function.update]

private theorem computeEntry_outside (e : EraseEntry) (s : State) (m : List Bool)
    (q : Wire) (hq : q ≠ entryTarget e) :
    (run (computeEntry e) m s).basis q = s.basis q := by
  cases e with
  | affine target sources negated =>
      have hqt : q ≠ target := by simpa [entryTarget] using hq
      induction sources generalizing s with
      | nil =>
          cases negated <;> simp [computeEntry, cxTo, run, writeBit, hqt]
      | cons c cs ih =>
          change (run (computeEntry (.affine target cs negated)) m
            (run [.CX c target] m s)).basis q = s.basis q
          rw [ih _ (by simpa [entryTarget] using hqt)]
          simp [run, writeBit, hqt]
  | andGate target left right =>
      have hqt : q ≠ target := by simpa [entryTarget] using hq
      simp [computeEntry, run, writeBit, hqt]

private theorem computeEraseEntry_correct (e : EraseEntry)
    (hp : ProperProgram (computeEntry e)) (s : State)
    (hclean : s.basis (entryTarget e) = false) (m n : List Bool) :
    run (eraseEntry e) n (run (computeEntry e) m s) = s := by
  cases e with
  | affine target sources negated =>
      have heq : eraseEntry (.affine target sources negated) =
          (computeEntry (.affine target sources negated)).reverse := by
        cases negated <;> simp [eraseEntry, computeEntry, List.reverse_append, cxTo]
      rw [heq]
      exact run_reverse_proper _ hp s m n
  | andGate target left right =>
      have hne : left ≠ target ∧ right ≠ target := by
        simpa [ProperProgram, computeEntry, ProperGate] using hp
      have hct : s.basis target = false := by simpa [entryTarget] using hclean
      have hc : run (computeEntry (.andGate target left right)) m s =
          ⟨s.phase, writeBit s.basis target (s.basis left && s.basis right)⟩ := by
        simp [computeEntry, run, hct]
      rw [hc]
      change run [.measureX target [] [.CZ left right]] n
        ⟨s.phase, writeBit s.basis target (s.basis left && s.basis right)⟩ = s
      have ht : (writeBit s.basis target (s.basis left && s.basis right)) target =
          ((writeBit s.basis target (s.basis left && s.basis right)) left &&
            (writeBit s.basis target (s.basis left && s.basis right)) right) := by
        simp [writeBit, hne.1, hne.2]
      rw [erase_and_correct target left right hne.1 hne.2 _ ht n]
      cases s with
      | mk phase basis =>
          congr 1
          funext q
          by_cases hq : q = target
          · subst q
            simp [writeBit] at hct ⊢
            exact hct
          · simp [writeBit, hq]

private theorem computeEraseLog_correct (es : List EraseEntry)
    (hp : ProperProgram (es.flatMap computeEntry))
    (hn : (es.map entryTarget).Nodup) (s : State)
    (hclean : ∀ q ∈ es.map entryTarget, s.basis q = false) (m n : List Bool) :
    run (es.reverse.flatMap eraseEntry) n
      (run (es.flatMap computeEntry) m s) = s := by
  induction es generalizing s m n with
  | nil => simp [run]
  | cons e es ih =>
      have hproper : ProperProgram (computeEntry e) ∧
          ProperProgram (es.flatMap computeEntry) := by
        simpa only [List.flatMap_cons, properProgram_append] using hp
      have htargets := List.nodup_cons.mp hn
      rw [List.flatMap_cons, run_append]
      let u := run (computeEntry e) (m.take (measurementCount (computeEntry e))) s
      have hrest : ∀ q ∈ es.map entryTarget, u.basis q = false := by
        intro q hq
        have hne : q ≠ entryTarget e := by
          intro heq
          apply htargets.1
          simpa [heq] using hq
        exact (computeEntry_outside e s _ q hne).trans
          (hclean q (by simp [hq]))
      have hmid := ih hproper.2 htargets.2 u hrest
        (m.drop (measurementCount (computeEntry e)))
        (n.take (measurementCount (es.reverse.flatMap eraseEntry)))
      simp only [List.reverse_cons, List.flatMap_append, List.flatMap_singleton,
        run_append]
      rw [hmid]
      apply computeEraseEntry_correct e hproper.1 s
        (hclean (entryTarget e) (by simp))

private theorem oneHot_physical_core (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) :
    GatePhysical (oneHot bits fresh).program ∧
    (∀ e ∈ (oneHot bits fresh).log, GatePhysical (eraseEntry e)) := by
  induction bits with
  | nil =>
      constructor
      · simp [oneHot, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate]
      · intro e he
        simp only [oneHot, List.mem_singleton] at he
        subst e
        apply eraseEntry_physical_of
        simp
  | cons b bits ih =>
      cases bits with
      | nil =>
          have hne : b ≠ fresh 0 := by
            have hcross : ([b] ++ [fresh 0]).Nodup := by simpa [oneHot] using hn
            exact cross_ne_of_nodup hcross (by simp) (by simp)
          constructor
          · simp [oneHot, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hne]
          · intro e he
            simp only [oneHot, List.mem_singleton] at he
            subst e
            apply eraseEntry_physical_of
            simpa using hne
      | cons b' bs =>
          simp only [oneHot] at hn ⊢
          let r := oneHot (b' :: bs) fresh
          let n := r.outputs.length
          let ones := (List.range n).map (fun i => fresh (r.used + i))
          let zeros := (List.range n).map (fun i => fresh (r.used + n + i))
          let pre := b :: b' :: bs ++ r.sites
          have hnAll : (pre ++ ones ++ zeros).Nodup := by
            simpa only [pre, r, n, ones, zeros, List.append_assoc] using hn
          have hnPrefix : pre.Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have hq := List.nodup_iff_count.mp hnAll q
            simp only [List.count_append] at hq
            omega
          have hnPrefixOnes : (pre ++ ones).Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have hq := List.nodup_iff_count.mp hnAll q
            simp only [List.count_append] at hq ⊢
            omega
          have hnOnes : ones.Nodup := (List.nodup_append.mp hnPrefixOnes).2.1
          have hnZeros : zeros.Nodup := (List.nodup_append.mp hnAll).2.1
          have hrecN : (b' :: bs ++ r.sites).Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have hq := List.nodup_iff_count.mp hnPrefix q
            simp only [pre, List.count_cons, List.count_append] at hq ⊢
            omega
          have hrec := ih hrecN
          have hnPos : 0 < n := by
            dsimp only [n, r]
            rw [oneHot_outputs_length]
            positivity
          have honesLen : ones.length = n := by simp [ones]
          have hzerosLen : zeros.length = n := by simp [zeros]
          have houtMem (i : Nat) (hi : i < n) : r.outputs.getD i b ∈ pre := by
            rw [List.getD_eq_getElem _ _ hi]
            have hm := List.getElem_mem hi
            have hs := (oneHot_structural (b' :: bs) fresh).2.1 _ hm
            simpa only [pre, r] using List.mem_cons_of_mem b hs
          have honesMem (i : Nat) (hi : i < n) : ones.getD i b ∈ ones := by
            rw [List.getD_eq_getElem _ _ (by simpa [honesLen] using hi)]
            exact List.getElem_mem _
          have hzerosMem (i : Nat) (hi : i < n) : zeros.getD i b ∈ zeros := by
            rw [List.getD_eq_getElem _ _ (by simpa [hzerosLen] using hi)]
            exact List.getElem_mem _
          have hprefixOnes (x : Wire) (hx : x ∈ pre) (y : Wire) (hy : y ∈ ones) :
              x ≠ y := cross_ne_of_nodup hnPrefixOnes hx hy
          have hallZeros (x : Wire) (hx : x ∈ pre ++ ones)
              (y : Wire) (hy : y ∈ zeros) : x ≠ y :=
            cross_ne_of_nodup hnAll hx hy
          have hand : GatePhysical ((List.range (n - 1)).flatMap (fun i =>
              [.CCX b (r.outputs.getD i b) (ones.getD i b)])) := by
            apply gatePhysical_flatMap
            intro i hi
            have hi' : i < n - 1 := List.mem_range.mp hi
            have hb : b ∈ pre := by simp [pre]
            have ho := houtMem i (by omega)
            have ht := honesMem i (by omega)
            have hbt := hprefixOnes b hb _ ht
            have hot := hprefixOnes _ ho _ ht
            intro g hg
            simp only [List.mem_singleton] at hg
            subst g
            simpa [RecordedQuantum.PhysicalInstr, ProperGate] using And.intro hbt hot
          have hlastMem : ones.getD (n - 1) b ∈ ones := honesMem _ (by omega)
          have hlastB : b ≠ ones.getD (n - 1) b :=
            hprefixOnes b (by simp [pre]) _ hlastMem
          have htakeLast : ∀ q ∈ ones.take (n - 1), q ≠ ones.getD (n - 1) b := by
            intro q hq
            obtain ⟨i, hi, heq⟩ := List.mem_take_iff_getElem.mp hq
            have hiN : i < ones.length := by omega
            have hlastN : n - 1 < ones.length := by omega
            rw [List.getD_eq_getElem _ _ hlastN]
            intro he
            have hidx := (List.Nodup.getElem_inj_iff hnOnes).mp (heq ▸ he)
            omega
          have hlast : GatePhysical
              ([.CX b (ones.getD (n - 1) b)] ++
                cxTo (ones.getD (n - 1) b) (ones.take (n - 1))) := by
            rw [gatePhysical_append]
            refine ⟨?_, cxTo_physical _ _ htakeLast⟩
            intro g hg
            simp only [List.mem_singleton] at hg
            subst g
            simpa [RecordedQuantum.PhysicalInstr, ProperGate] using hlastB
          have hzero : GatePhysical ((List.range n).flatMap (fun i =>
              [.CX (r.outputs.getD i b) (zeros.getD i b),
               .CX (ones.getD i b) (zeros.getD i b)])) := by
            apply gatePhysical_flatMap
            intro i hi
            have hi' := List.mem_range.mp hi
            have ho := houtMem i hi'
            have hw := honesMem i hi'
            have hz := hzerosMem i hi'
            have hoz := hallZeros _ (List.mem_append_left ones ho) _ hz
            have hwz := hallZeros _ (List.mem_append_right pre hw) _ hz
            intro g hg
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
            rcases hg with hg | hg
            · subst g
              simpa [RecordedQuantum.PhysicalInstr, ProperGate] using hoz
            · subst g
              simpa [RecordedQuantum.PhysicalInstr, ProperGate] using hwz
          constructor
          · rw [gatePhysical_append]
            refine ⟨?_, hzero⟩
            rw [gatePhysical_append]
            refine ⟨?_, hlast⟩
            rw [gatePhysical_append]
            exact ⟨hrec.1, hand⟩
          · intro e he
            rcases List.mem_append.mp he with he | heZero
            rcases List.mem_append.mp he with he | heAff
            rcases List.mem_append.mp he with heR | heAnd
            · exact hrec.2 e heR
            · simp only [List.mem_map, List.mem_range] at heAnd
              rcases heAnd with ⟨i, hi, rfl⟩
              exact eraseEntry_physical_of _ trivial
            · have heq := List.mem_singleton.mp heAff
              subst e
              apply eraseEntry_physical_of
              intro q hq
              simp only [List.mem_cons] at hq
              rcases hq with rfl | hq
              · exact hlastB
              · exact htakeLast q hq
            · simp only [List.mem_map, List.mem_range] at heZero
              rcases heZero with ⟨i, hi, rfl⟩
              apply eraseEntry_physical_of
              intro q hq
              simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
              rcases hq with rfl | rfl
              · exact hallZeros _ (List.mem_append_left ones (houtMem i hi)) _
                  (hzerosMem i hi)
              · exact hallZeros _ (List.mem_append_right pre (honesMem i hi)) _
                  (hzerosMem i hi)

private theorem proper_of_gatePhysical_zero (p : Program) (hp : GatePhysical p)
    (hz : measurementCount p = 0) : ProperProgram p := by
  induction p with
  | nil => simp [ProperProgram]
  | cons i p ih =>
      have head : ProperGate i := by
        have h := hp i (by simp)
        cases i <;> simp_all [RecordedQuantum.PhysicalInstr, measurementCount]
      have tail : GatePhysical p := by
        intro j hj
        exact hp j (by simp [hj])
      have zero : measurementCount p = 0 := by
        cases i <;> simp_all [measurementCount]
      intro j hj
      rcases List.mem_cons.mp hj with rfl | hj
      · exact head
      · exact ih tail zero j hj

theorem oneHot_erase_run (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) (s : State)
    (hclean : ∀ q ∈ (oneHot bits fresh).sites, s.basis q = false)
    (m n : List Bool) :
    run (eraseDecoder (oneHot bits fresh)) n
      (run (oneHot bits fresh).program m s) = s := by
  have hp := (oneHot_physical_core bits fresh hn).1
  have hproper : ProperProgram (oneHot bits fresh).program :=
    proper_of_gatePhysical_zero _ hp (oneHot_counts bits fresh).2.1
  have htargets : ((oneHot bits fresh).log.map entryTarget).Nodup := by
    rw [oneHot_log_targets]
    exact (List.nodup_append.mp hn).2.1
  have htargetsClean : ∀ q ∈ (oneHot bits fresh).log.map entryTarget,
      s.basis q = false := by
    intro q hq
    apply hclean q
    rwa [← oneHot_log_targets]
  have hproperLog : ProperProgram ((oneHot bits fresh).log.flatMap computeEntry) := by
    rw [← oneHot_program_eq_log_compute]
    exact hproper
  rw [oneHot_program_eq_log_compute]
  exact computeEraseLog_correct _ hproperLog htargets s htargetsClean m n

theorem oneHot_run_output (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) (s : State) (m : List Bool)
    (x : Nat) (hx : x < 2 ^ bits.length)
    (hbits : ∀ i, i < bits.length → s.basis (bits.getD i 0) = x.testBit i)
    (hclean : ∀ q ∈ (oneHot bits fresh).sites, s.basis q = false) :
    (run (oneHot bits fresh).program m s).phase = s.phase ∧
    (∀ q, q ∉ (oneHot bits fresh).sites →
      (run (oneHot bits fresh).program m s).basis q = s.basis q) ∧
    (∀ i, i < (oneHot bits fresh).outputs.length →
      (run (oneHot bits fresh).program m s).basis
        ((oneHot bits fresh).outputs.getD i 0) = decide (i = x)) := by
  induction bits generalizing s m x with
  | nil =>
      have hx0 : x = 0 := by simpa using hx
      have hf := hclean (fresh 0) (by simp [oneHot])
      subst x
      simp [oneHot, run, writeBit, hf]
      constructor
      · intro q hq
        exact Function.update_of_ne hq _ _
      · simp [List.getD, Function.update]
  | cons b bits ih =>
      cases bits with
      | nil =>
          have hb := hbits 0 (by simp)
          have hf := hclean (fresh 0) (by simp [oneHot])
          have hx2 : x < 2 := by simpa using hx
          interval_cases x <;>
            simp_all [oneHot, run, writeBit, Nat.testBit_eq_decide_div_mod_eq] <;>
            intro i hi <;> interval_cases i <;> simp_all [writeBit]
      | cons b' bs =>
          let r := oneHot (b' :: bs) fresh
          let n := r.outputs.length
          let ones := (List.range n).map (fun i => fresh (r.used + i))
          let zeros := (List.range n).map (fun i => fresh (r.used + n + i))
          let pre := b :: b' :: bs ++ r.sites
          have hnAll : (pre ++ ones ++ zeros).Nodup := by
            simpa only [pre, r, n, ones, zeros, oneHot, List.append_assoc] using hn
          have hnPrefix : pre.Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have hq := List.nodup_iff_count.mp hnAll q
            simp only [List.count_append] at hq
            omega
          have hnPrefixOnes : (pre ++ ones).Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have hq := List.nodup_iff_count.mp hnAll q
            simp only [List.count_append] at hq ⊢
            omega
          have hnOnes : ones.Nodup := (List.nodup_append.mp hnPrefixOnes).2.1
          have hnZeros : zeros.Nodup := (List.nodup_append.mp hnAll).2.1
          have hrecN : (b' :: bs ++ r.sites).Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have hq := List.nodup_iff_count.mp hnPrefix q
            simp only [pre, List.count_cons, List.count_append] at hq ⊢
            omega
          have hrecClean : ∀ q ∈ r.sites, s.basis q = false := by
            intro q hq
            apply hclean q
            have hm : q ∈ r.sites ++ ones ++ zeros :=
              List.mem_append_left zeros (List.mem_append_left ones hq)
            simpa only [oneHot, r, n, ones, zeros] using hm
          have htailBits : ∀ i, i < (b' :: bs).length →
              s.basis ((b' :: bs).getD i 0) = (x / 2).testBit i := by
            intro i hi
            have h := hbits (i + 1) (by simp at hi ⊢; omega)
            simpa [Nat.testBit_succ] using h
          have hxTail : x / 2 < 2 ^ (b' :: bs).length := by
            rw [Nat.div_lt_iff_lt_mul (by decide : 0 < 2)]
            simpa [pow_succ, Nat.mul_comm, Nat.mul_left_comm] using hx
          have hrec := ih hrecN s m (x / 2) hxTail htailBits hrecClean
          have hnPos : 0 < n := by
            dsimp only [n, r]
            rw [oneHot_outputs_length]
            positivity
          have honesLen : ones.length = n := by simp [ones]
          have hzerosLen : zeros.length = n := by simp [zeros]
          have houtMem (i : Nat) (hi : i < n) : r.outputs.getD i b ∈ pre := by
            rw [List.getD_eq_getElem _ _ hi]
            have hm := List.getElem_mem hi
            have hs := (oneHot_structural (b' :: bs) fresh).2.1 _ hm
            simpa only [pre, r] using List.mem_cons_of_mem b hs
          have honesMem (i : Nat) (hi : i < n) : ones.getD i b ∈ ones := by
            rw [List.getD_eq_getElem _ _ (by simpa [honesLen] using hi)]
            exact List.getElem_mem _
          have hzerosMem (i : Nat) (hi : i < n) : zeros.getD i b ∈ zeros := by
            rw [List.getD_eq_getElem _ _ (by simpa [hzerosLen] using hi)]
            exact List.getElem_mem _
          have hprefixOnes (a : Wire) (ha : a ∈ pre) (c : Wire) (hc : c ∈ ones) :
              a ≠ c := cross_ne_of_nodup hnPrefixOnes ha hc
          have hallZeros (a : Wire) (ha : a ∈ pre ++ ones)
              (c : Wire) (hc : c ∈ zeros) : a ≠ c :=
            cross_ne_of_nodup hnAll ha hc
          let andPart := (List.range (n - 1)).flatMap (fun i =>
            ([Instr.CCX b (r.outputs.getD i b) (ones.getD i b)] : Program))
          let last := ones.getD (n - 1) b
          let lastPart : Program := [.CX b last] ++ cxTo last (ones.take (n - 1))
          let zeroPart := (List.range n).flatMap (fun i =>
            ([Instr.CX (r.outputs.getD i b) (zeros.getD i b),
             Instr.CX (ones.getD i b) (zeros.getD i b)] : Program))
          let u := run r.program m s
          have huPhase : u.phase = s.phase := hrec.1
          have huOutside : ∀ q, q ∉ r.sites → u.basis q = s.basis q := hrec.2.1
          have huOutput : ∀ i, i < n →
              u.basis (r.outputs.getD i b) = decide (i = x / 2) := by
            intro i hi
            have hv := hrec.2.2 i (by simpa [n, r] using hi)
            have hi' : i < r.outputs.length := by simpa [n] using hi
            rw [List.getD_eq_getElem _ _ hi'] at hv
            rw [List.getD_eq_getElem _ _ hi']
            simpa [u, r] using hv
          have hand := ccxRange_run (n - 1) b
            (fun i => r.outputs.getD i b) (fun i => ones.getD i b)
            (by
              intro i hi j hj heq
              have hi' : i < ones.length := by omega
              have hj' : j < ones.length := by omega
              change ones.getD i b = ones.getD j b at heq
              rw [List.getD_eq_getElem _ _ hi', List.getD_eq_getElem _ _ hj'] at heq
              exact (List.Nodup.getElem_inj_iff hnOnes).mp heq)
            (by
              intro i hi
              exact hprefixOnes b (by simp [pre]) _ (honesMem i (by omega)))
            (by
              intro i hi j hj
              exact hprefixOnes _ (houtMem i (by omega)) _ (honesMem j (by omega)))
            u m
          have hsOnes : ∀ q ∈ ones, s.basis q = false := by
            intro q hq
            apply hclean q
            have hm : q ∈ r.sites ++ ones ++ zeros :=
              List.mem_append_left zeros (List.mem_append_right r.sites hq)
            simpa only [oneHot, r, n, ones, zeros] using hm
          have huOnes : ∀ q ∈ ones, u.basis q = false := by
            intro q hq
            rw [huOutside q]
            · exact hsOnes q hq
            · intro hrq
              exact (hprefixOnes q (by simp [pre, hrq]) q hq) rfl
          have hub : u.basis b = s.basis b := by
            apply huOutside
            intro hrb
            have hp : (b :: (b' :: bs ++ r.sites)).Nodup := by
              simpa [pre] using hnPrefix
            exact (List.nodup_cons.mp hp).1 (by simp [hrb])
          let v := run andPart m u
          have hvPhase : v.phase = u.phase := by simpa [v, andPart] using hand.1
          have hvOutside : ∀ q, (∀ i, i < n - 1 → q ≠ ones.getD i b) →
              v.basis q = u.basis q := by
            simpa [v, andPart] using hand.2.1
          have hvOne : ∀ i, i < n - 1 →
              v.basis (ones.getD i b) = (s.basis b && decide (i = x / 2)) := by
            intro i hi
            have hv : v.basis (ones.getD i b) =
                (u.basis (ones.getD i b) ^^
                  (u.basis b && u.basis (r.outputs.getD i b))) := by
              simpa [v, andPart] using hand.2.2 i hi
            have hzero := huOnes (ones.getD i b) (honesMem i (by omega))
            have hout := huOutput i (by omega)
            rw [hzero, hub, hout] at hv
            simpa using hv
          have hlastMem : ones.getD (n - 1) b ∈ ones := honesMem _ (by omega)
          have hlastNe : ∀ i, i < n - 1 →
              ones.getD (n - 1) b ≠ ones.getD i b := by
            intro i hi heq
            have hi' : i < ones.length := by omega
            have hlast' : n - 1 < ones.length := by omega
            rw [List.getD_eq_getElem _ _ hlast', List.getD_eq_getElem _ _ hi'] at heq
            have he := (List.Nodup.getElem_inj_iff hnOnes).mp heq
            omega
          have hvLast : v.basis (ones.getD (n - 1) b) = false := by
            rw [hvOutside]
            · exact huOnes _ hlastMem
            · exact hlastNe
          have hvControl : v.basis b = s.basis b := by
            exact (hvOutside b (by
              intro i hi
              exact hprefixOnes b (by simp [pre]) _ (honesMem i (by omega)))).trans hub
          have hvRecursive : ∀ i, i < n →
              v.basis (r.outputs.getD i b) = decide (i = x / 2) := by
            intro i hi
            rw [hvOutside]
            · exact huOutput i hi
            · intro j hj
              exact hprefixOnes _ (houtMem i hi) _ (honesMem j (by omega))
          let a := run ([.CX b (ones.getD (n - 1) b)] : Program) m v
          have haPhase : a.phase = v.phase := by simp [a, run]
          have haLast : a.basis (ones.getD (n - 1) b) = s.basis b := by
            dsimp only [a]
            simp only [run]
            rw [show writeBit v.basis (ones.getD (n - 1) b)
                (v.basis (ones.getD (n - 1) b) ^^ v.basis b)
                (ones.getD (n - 1) b) =
                (v.basis (ones.getD (n - 1) b) ^^ v.basis b) by simp [writeBit]]
            change (v.basis (ones.getD (n - 1) b) ^^ v.basis b) = s.basis b
            rw [hvLast, hvControl]
            cases s.basis b <;> rfl
          have haOutside : ∀ q, q ≠ ones.getD (n - 1) b → a.basis q = v.basis q := by
            intro q hq
            simp only [a, run, writeBit, Function.update]
            split <;> simp_all
          have htakeLast : ones.getD (n - 1) b ∉ ones.take (n - 1) := by
            intro hm
            obtain ⟨i, hi, heq⟩ := List.mem_take_iff_getElem.mp hm
            have hi' : i < ones.length := by omega
            have hlast' : n - 1 < ones.length := by omega
            rw [List.getD_eq_getElem _ _ hlast'] at heq
            exact (by
              have := (List.Nodup.getElem_inj_iff hnOnes).mp heq.symm
              omega)
          have hlastRun := cxTo_run (ones.getD (n - 1) b) (ones.take (n - 1))
            htakeLast a m
          let w := run lastPart m v
          have hwEq : w = run (cxTo (ones.getD (n - 1) b) (ones.take (n - 1))) m a := by
            change run (cxTo last (ones.take (n - 1))) m
                (run ([.CX b last] : Program) m v) = _
            dsimp only [last, a]
          have hwPhase : w.phase = v.phase := by
            rw [hwEq, hlastRun.1, haPhase]
          have hwOutside : ∀ q, q ≠ ones.getD (n - 1) b → w.basis q = v.basis q := by
            intro q hq
            rw [hwEq, hlastRun.2.1 q hq, haOutside q hq]
          have hwLast : w.basis (ones.getD (n - 1) b) =
              (s.basis b && decide (n - 1 = x / 2)) := by
            rw [hwEq, hlastRun.2.2, haLast]
            have hfold :
                (ones.take (n - 1)).foldl (fun value q => value ^^ a.basis q) (s.basis b) =
                  (List.range (n - 1)).foldl
                    (fun value i => value ^^ (s.basis b && decide (i = x / 2)))
                    (s.basis b) := by
              have htake : ones.take (n - 1) =
                  (List.range (n - 1)).map (fun i => ones.getD i b) := by
                symm
                exact getD_range_take ones b (n - 1) (by omega)
              rw [htake, List.foldl_map]
              have haux (indices : List Nat)
                  (hindices : ∀ i ∈ indices, i < n - 1) (initial : Bool) :
                  indices.foldl
                      (fun value i => value ^^ a.basis (ones.getD i b)) initial =
                    indices.foldl
                      (fun value i => value ^^ (s.basis b && decide (i = x / 2))) initial := by
                induction indices generalizing initial with
                | nil => rfl
                | cons i indices ihIndices =>
                    simp only [List.foldl_cons]
                    rw [haOutside, hvOne i (hindices i (by simp))]
                    · apply ihIndices
                      intro j hj
                      exact hindices j (by simp [hj])
                    · exact Ne.symm (hlastNe i (hindices i (by simp)))
              exact haux _ (by intro i hi; exact List.mem_range.mp hi) _
            rw [hfold]
            have hy : x / 2 < n := by
              dsimp only [n, r]
              rw [oneHot_outputs_length]
              exact hxTail
            simpa [eq_comm] using foldl_xor_selected n (x / 2) hy (s.basis b)
          have hwOne : ∀ i, i < n →
              w.basis (ones.getD i b) = (s.basis b && decide (i = x / 2)) := by
            intro i hi
            by_cases hilast : i = n - 1
            · subst i
              exact hwLast
            · rw [hwOutside]
              · exact hvOne i (by omega)
              · intro heq
                have hi' : i < ones.length := by omega
                have hlast' : n - 1 < ones.length := by omega
                rw [List.getD_eq_getElem _ _ hi', List.getD_eq_getElem _ _ hlast'] at heq
                exact hilast ((List.Nodup.getElem_inj_iff hnOnes).mp heq)
          have hwRecursive : ∀ i, i < n →
              w.basis (r.outputs.getD i b) = decide (i = x / 2) := by
            intro i hi
            rw [hwOutside]
            · exact hvRecursive i hi
            · exact hprefixOnes _ (houtMem i hi) _ hlastMem
          have hwZeros : ∀ q ∈ zeros, w.basis q = false := by
            intro q hq
            rw [hwOutside]
            · rw [hvOutside]
              · rw [huOutside]
                · exact hclean q (by
                    have hm : q ∈ r.sites ++ ones ++ zeros :=
                      List.mem_append_right (r.sites ++ ones) hq
                    simpa only [oneHot, r, n, ones, zeros] using hm)
                · intro hrq
                  exact hallZeros q (by simp [pre, hrq]) q hq rfl
              · intro i hi
                have hm : ones.getD i b ∈ pre ++ ones :=
                  List.mem_append_right pre (honesMem i (by omega))
                exact (hallZeros _ hm _ hq).symm
            · have hm : ones.getD (n - 1) b ∈ pre ++ ones :=
                List.mem_append_right pre hlastMem
              exact (hallZeros _ hm _ hq).symm
          have hzero := cxPairRange_run n
            (fun i => r.outputs.getD i b) (fun i => ones.getD i b)
            (fun i => zeros.getD i b)
            (by
              intro i hi j hj heq
              change zeros.getD i b = zeros.getD j b at heq
              have hi' : i < zeros.length := by simpa [hzerosLen] using hi
              have hj' : j < zeros.length := by simpa [hzerosLen] using hj
              rw [List.getD_eq_getElem _ _ hi', List.getD_eq_getElem _ _ hj'] at heq
              exact (List.Nodup.getElem_inj_iff hnZeros).mp heq)
            (by
              intro i hi j hj
              exact hallZeros _ (List.mem_append_left ones (houtMem i hi)) _
                (hzerosMem j hj))
            (by
              intro i hi j hj
              exact hallZeros _ (List.mem_append_right pre (honesMem i hi)) _
                (hzerosMem j hj))
            w m
          let out := run zeroPart m w
          have houtPhase : out.phase = s.phase := by
            calc
              out.phase = w.phase := by simpa [out, zeroPart] using hzero.1
              _ = v.phase := hwPhase
              _ = u.phase := hvPhase
              _ = s.phase := huPhase
          have houtOutsideZeros : ∀ q, q ∉ zeros → out.basis q = w.basis q := by
            intro q hq
            apply hzero.2.1
            intro i hi heq
            apply hq
            exact heq ▸ hzerosMem i hi
          have houtZero : ∀ i, i < n →
              out.basis (zeros.getD i b) =
                (decide (i = x / 2) ^^ (s.basis b && decide (i = x / 2))) := by
            intro i hi
            have hz := hzero.2.2 i hi
            change out.basis (zeros.getD i b) = _
            rw [hz, hwZeros _ (hzerosMem i hi), hwRecursive i hi, hwOne i hi]
            simp
          have hcontrol : s.basis b = x.testBit 0 := by
            simpa using hbits 0 (by simp)
          have hselected : 2 * (x / 2) + (x.testBit 0).toNat = x := by
            cases hb : x.testBit 0 <;> simp [Nat.testBit_zero] at hb ⊢
            · have hm := Nat.mod_lt x (by omega : 0 < 2)
              omega
            · have hm := Nat.mod_lt x (by omega : 0 < 2)
              omega
          have houtValue : ∀ i, i < 2 * n →
              out.basis ((interleave zeros ones).getD i 0) = decide (i = x) := by
            intro i hi
            have hindex : i / 2 < n := by omega
            rcases Nat.mod_two_eq_zero_or_one i with heven | hodd
            · have heq : (interleave zeros ones).getD i 0 = zeros.getD (i / 2) b := by
                have hp := (interleave_getD zeros ones (by omega) (i / 2)
                  (by simpa [hzerosLen] using hindex) 0).1
                have hiEq : i = 2 * (i / 2) := by
                  have := Nat.mod_add_div i 2
                  omega
                calc
                  (interleave zeros ones).getD i 0 =
                      (interleave zeros ones).getD (2 * (i / 2)) 0 :=
                        congrArg (fun k => (interleave zeros ones).getD k 0) hiEq
                  _ = zeros.getD (i / 2) 0 := hp
                  _ = zeros.getD (i / 2) b := by
                    rw [List.getD_eq_getElem _ _ (by simpa [hzerosLen] using hindex),
                      List.getD_eq_getElem _ _ (by simpa [hzerosLen] using hindex)]
              rw [heq, houtZero (i / 2) hindex, hcontrol]
              cases hb0 : x.testBit 0
              · simp only [Bool.false_and, Bool.xor_false]
                simp [hb0] at hselected
                by_cases hq : i / 2 = x / 2
                · have : i = x := by omega
                  simp [hq, this]
                · have : i ≠ x := by omega
                  simp [hq, this]
              · simp only [Bool.true_and, Bool.xor_self]
                simp [hb0] at hselected
                have hne : i ≠ x := by omega
                simp [hne]
            · have heq : (interleave zeros ones).getD i 0 = ones.getD (i / 2) b := by
                have hp := (interleave_getD zeros ones (by omega) (i / 2)
                  (by simpa [hzerosLen] using hindex) 0).2
                have hiEq : i = 2 * (i / 2) + 1 := by
                  have := Nat.mod_add_div i 2
                  omega
                calc
                  (interleave zeros ones).getD i 0 =
                      (interleave zeros ones).getD (2 * (i / 2) + 1) 0 :=
                        congrArg (fun k => (interleave zeros ones).getD k 0) hiEq
                  _ = ones.getD (i / 2) 0 := hp
                  _ = ones.getD (i / 2) b := by
                    rw [List.getD_eq_getElem _ _ (by simpa [honesLen] using hindex),
                      List.getD_eq_getElem _ _ (by simpa [honesLen] using hindex)]
              have hnotzero : ones.getD (i / 2) b ∉ zeros := by
                intro hm
                have hone : ones.getD (i / 2) b ∈ pre ++ ones :=
                  List.mem_append_right pre (honesMem (i / 2) hindex)
                exact hallZeros _ hone _ hm rfl
              rw [heq, houtOutsideZeros _ hnotzero, hwOne (i / 2) hindex, hcontrol]
              cases hb0 : x.testBit 0
              · simp only [Bool.false_and]
                simp [hb0] at hselected
                have hne : i ≠ x := by omega
                simp [hne]
              · simp only [Bool.true_and]
                simp [hb0] at hselected
                by_cases hq : i / 2 = x / 2
                · have : i = x := by omega
                  simp [hq, this]
                · have : i ≠ x := by omega
                  simp [hq, this]
          have houtFrame : ∀ q, q ∉ r.sites ++ ones ++ zeros →
              out.basis q = s.basis q := by
            intro q hq
            rw [houtOutsideZeros]
            · rw [hwOutside]
              · rw [hvOutside]
                · apply huOutside q
                  intro hr
                  exact hq (List.mem_append_left zeros (List.mem_append_left ones hr))
                · intro i hi heq
                  apply hq
                  rw [heq]
                  exact List.mem_append_left zeros
                    (List.mem_append_right r.sites (honesMem i (by omega)))
              · intro heq
                exact hq (List.mem_append_left zeros
                  (List.mem_append_right r.sites (heq ▸ hlastMem)))
            · intro hm
              exact hq (List.mem_append_right (r.sites ++ ones) hm)
          have hrZero : measurementCount r.program = 0 := by
            simpa only [r] using (oneHot_counts (b' :: bs) fresh).2.1
          have handZero : measurementCount andPart = 0 := by
            simpa only [andPart] using
              (ccxRange_counts (n - 1) (fun _ => b) (fun i => r.outputs.getD i b)
                (fun i => ones.getD i b)).2
          have hlastZero : measurementCount lastPart = 0 := by
            simp [lastPart, cxTo_counts, measurementCount]
          have hzeroZero : measurementCount zeroPart = 0 := by
            simpa only [zeroPart] using
              (cxPairRange_counts n (fun i => r.outputs.getD i b)
                (fun i => zeros.getD i b) (fun i => ones.getD i b)
                (fun i => zeros.getD i b)).2
          have run_append_zero_left (p q : Program) (hp : measurementCount p = 0)
              (state : State) (tape : List Bool) :
              run (p ++ q) tape state = run q tape (run p tape state) := by
            rw [run_append, hp, List.take_zero, List.drop_zero]
            have ht := run_take p tape state
            simpa only [hp, List.take_zero] using congrArg (run q tape) ht
          have hprogram : (oneHot (b :: b' :: bs) fresh).program =
              r.program ++ andPart ++ lastPart ++ zeroPart := by
            simp [oneHot, r, n, ones, zeros, andPart, last, lastPart, zeroPart]
          have hrun : run (oneHot (b :: b' :: bs) fresh).program m s = out := by
            rw [hprogram]
            have hRA : measurementCount (r.program ++ andPart) = 0 := by
              rw [measurementCount_append, hrZero, handZero]
            have hRAL : measurementCount (r.program ++ andPart ++ lastPart) = 0 := by
              rw [measurementCount_append, hRA, hlastZero]
            rw [run_append_zero_left (r.program ++ andPart ++ lastPart) zeroPart hRAL,
              run_append_zero_left (r.program ++ andPart) lastPart hRA,
              run_append_zero_left r.program andPart hrZero]
          rw [hrun]
          refine ⟨houtPhase, ?_, ?_⟩
          · intro q hq
            apply houtFrame q
            simpa only [oneHot, r, n, ones, zeros] using hq
          · intro i hi
            have houtputs : (oneHot (b :: b' :: bs) fresh).outputs =
                interleave zeros ones := by
              simp [oneHot, r, n, ones, zeros]
            rw [houtputs] at hi ⊢
            apply houtValue i
            have hlen : (interleave zeros ones).length = 2 * n :=
              by simpa only [hzerosLen] using interleave_length zeros ones (by omega)
            simpa only [hlen] using hi

private theorem eraseDecoder_physical_core (bits : List Wire) (fresh : Nat → Wire)
    (hn : (bits ++ (oneHot bits fresh).sites).Nodup) :
    GatePhysical (eraseDecoder (oneHot bits fresh)) := by
  apply gatePhysical_flatMap
  intro e he
  exact (oneHot_physical_core bits fresh hn).2 e (List.mem_reverse.mp he)

def lowBits (L : Layout) (B : Nat) : List Wire :=
  (reg L.A (bitWidth B)).take (bitWidth B / 2)

def highBits (L : Layout) (B : Nat) : List Wire :=
  (reg L.A (bitWidth B)).drop (bitWidth B / 2)

def lowDecoder (L : Layout) (B : Nat) : Decoder :=
  oneHot (lowBits L B) L.lowWork

def highDecoder (L : Layout) (B : Nat) : Decoder :=
  oneHot (highBits L B) L.highWork

def registerBasis (bits : List Wire) (x : Nat) : BasisState := fun q =>
  if bits.idxOf q < bits.length then x.testBit (bits.idxOf q) else false

def decoderBasis (d : Decoder) (bits : List Wire) (x : Nat) : BasisState :=
  (run d.program [] ⟨false, registerBasis bits x⟩).basis

def decoderTrue (d : Decoder) (bits : List Wire) (x : Nat) : List Wire :=
  d.sites.filter (fun q => decoderBasis d bits x q)

def decoderDelta (d : Decoder) (bits : List Wire) (x : Nat) : List Wire :=
  d.sites.filter (fun q => decoderBasis d bits 0 q ^^ decoderBasis d bits x q)

def decoderInit (d : Decoder) (bits : List Wire) : Program :=
  xOn (decoderTrue d bits 0)

def outAt (d : Decoder) (i : Nat) (fallback : Wire) : Wire :=
  d.outputs.getD i fallback

theorem decoderInit_run (d : Decoder) (bits : List Wire) (hsites : d.sites.Nodup)
    (s : State) (m : List Bool) (hclean : ∀ q ∈ d.sites, s.basis q = false) :
    (run (decoderInit d bits) m s).phase = s.phase ∧
    (∀ q ∈ d.sites, (run (decoderInit d bits) m s).basis q = decoderBasis d bits 0 q) ∧
    (∀ q ∉ d.sites, (run (decoderInit d bits) m s).basis q = s.basis q) := by
  have htrue : (decoderTrue d bits 0).Nodup := hsites.filter _
  rw [decoderInit, xOn_run _ htrue]
  constructor
  · rfl
  · constructor
    · intro q hq
      by_cases hb : decoderBasis d bits 0 q
      · simp [decoderTrue, hq, hb, hclean q hq]
      · simp [decoderTrue, hq, hb, hclean q hq]
    · intro q hq
      simp [decoderTrue, hq]

theorem decoderDelta_run (d : Decoder) (bits : List Wire) (x : Nat)
    (control : Wire) (hsites : d.sites.Nodup) (hc : control ∉ d.sites)
    (s : State) (m : List Bool) (hcontrol : s.basis control = true)
    (hcurrent : ∀ q ∈ d.sites, s.basis q = decoderBasis d bits 0 q) :
    (run (cxInto control (decoderDelta d bits x)) m s).phase = s.phase ∧
    (∀ q ∈ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q =
        decoderBasis d bits x q) ∧
    (∀ q ∉ d.sites,
      (run (cxInto control (decoderDelta d bits x)) m s).basis q = s.basis q) := by
  have hdelta : (decoderDelta d bits x).Nodup := hsites.filter _
  have hc' : control ∉ decoderDelta d bits x := by
    intro hm
    exact hc (List.mem_of_mem_filter hm)
  rw [cxInto_run control _ hdelta hc']
  constructor
  · rfl
  · constructor
    · intro q hq
      have hcur := hcurrent q hq
      cases h0 : decoderBasis d bits 0 q <;> cases hx : decoderBasis d bits x q <;>
        simp_all [decoderDelta]
    · intro q hq
      have hnot : q ∉ decoderDelta d bits x := by
        intro hm
        exact hq (List.mem_of_mem_filter hm)
      simp [hcontrol, hnot]



def adderMiddle (L : Layout) (j : Nat) : Program :=
  [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
   .CCX (L.S j) (L.D j) (L.C j), .CX (L.C (j - 1)) (L.C j)]

def adderDown (L : Layout) (j : Nat) : Program :=
  [.CX (L.C (j - 1)) (L.C j),
   .measureX (L.C j) [] [.CZ (L.S j) (L.D j)],
   .CX (L.C (j - 1)) (L.D j), .CX (L.D j) (L.S j)]

def adderTopDown (L : Layout) (B : Nat) : Program :=
  let j := B - 2
  [.CX (L.C (j - 1)) (L.D j), .CX (L.D j) (L.S j)]

private def packAdder (L : Layout) (B : Nat) : Program :=
  let sig := L.D (B - 1)
  let first :=
    [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
     .CX sig (L.C 0)]
  let middle := (List.range (B - 3)).flatMap (fun r => adderMiddle L (r + 1))
  let j := B - 2
  let top :=
    [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
     .X (L.S (B - 1)),
     .measureX (L.S (B - 1)) [] [.Z (L.C (j - 1)), .CZ (L.S j) (L.D j)],
     .X (L.S (B - 1))]
  let down := adderTopDown L B ++
    ((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)
  first ++ middle ++ top ++ down ++
    [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
     .CX sig (L.D 0), .CX (L.D 0) (L.S 0)]

def unpackAdder (L : Layout) (B : Nat) : Program :=
  let sig := L.D (B - 1)
  let first :=
    [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
     .CX sig (L.C 0)]
  let middle := (List.range (B - 3)).flatMap (fun r => adderMiddle L (r + 1))
  let j := B - 2
  let top :=
    [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
     .CX (L.C (j - 1)) (L.S (B - 1)),
     .CCX (L.S j) (L.D j) (L.S (B - 1))]
  let down := adderTopDown L B ++
    ((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)
  first ++ middle ++ top ++ down ++
    [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
     .CX sig (L.D 0), .CX (L.D 0) (L.S 0)]

def packStep (L : Layout) (B j : Nat) : Program :=
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  [.CCX (L.D j) L.z L.t] ++
    cxInto L.t ((List.range nb).filter (fun b => k.testBit b) |>.map L.A) ++
    cxInto L.t (decoderDelta ld (lowBits L B) (k % 2 ^ lo)) ++
    cxInto L.t (decoderDelta hd (highBits L B) (k / 2 ^ lo)) ++
    [.CX L.t (L.D j)] ++
    (if j < B - 2 then
      [.CX (L.S (B - 2 - j)) (L.D j),
       .measureX (L.S (B - 2 - j)) [] [.CZ (L.D j) L.z]]
     else []) ++
    [.CX L.t L.z,
     .measureX L.t []
       [.CZ (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z)]]

def packFirstStep (L : Layout) (B : Nat) : Program :=
  .CX (L.D (B - 2)) L.t :: (packStep L B (B - 2)).tail

theorem packFirstStep_support (L : Layout) (B : Nat) :
    wires (packFirstStep L B) ⊆ wires (packStep L B (B - 2)) := by
  let rest := (packStep L B (B - 2)).tail
  have he : packStep L B (B - 2) =
      .CCX (L.D (B - 2)) L.z L.t :: rest := rfl
  change wires (.CX (L.D (B - 2)) L.t :: rest) ⊆ wires (packStep L B (B - 2))
  rw [he]
  change ({L.D (B - 2), L.t} : Finset Wire) ∪ wires rest ⊆
    {L.D (B - 2), L.z, L.t} ∪ wires rest
  apply Finset.union_subset_union _ (Finset.Subset.refl _)
  intro q hq
  rcases Finset.mem_insert.mp hq with hq | hq
  · exact hq ▸ Finset.mem_insert_self _ _
  · exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hq)

theorem packFirstStep_physical (L : Layout) (B : Nat)
    (hp : GatePhysical (packStep L B (B - 2))) : GatePhysical (packFirstStep L B) := by
  have he : packStep L B (B - 2) =
      .CCX (L.D (B - 2)) L.z L.t :: (packStep L B (B - 2)).tail := rfl
  rw [he] at hp
  simp only [GatePhysical, List.mem_cons, forall_eq_or_imp,
    RecordedQuantum.PhysicalInstr, ProperGate] at hp
  simpa only [packFirstStep, GatePhysical, List.mem_cons, forall_eq_or_imp,
    RecordedQuantum.PhysicalInstr, ProperGate] using And.intro hp.1.1 hp.2

theorem packFirstStep_run_suffix (L : Layout) (B : Nat) (rest : Program)
    (s : State) (m : List Bool) (hz : s.basis L.z = true) :
    run (packFirstStep L B ++ rest) m s =
      run (packStep L B (B - 2) ++ rest) m s := by
  have he : packStep L B (B - 2) =
      .CCX (L.D (B - 2)) L.z L.t :: (packStep L B (B - 2)).tail := rfl
  unfold packFirstStep
  conv_rhs => rw [he]
  simp only [List.cons_append, run, hz, Bool.and_true]

def pack (L : Layout) (B : Nat) : Program :=
  let ld := lowDecoder L B
  let hd := highDecoder L B
  cxInto (L.D (B - 1)) (reg L.D (B - 1)) ++
  xOn (reg L.S B) ++ packAdder L B ++ xOn (reg L.S B) ++ [.X (L.S 0)] ++
  [.X L.z] ++ decoderInit ld (lowBits L B) ++ decoderInit hd (highBits L B) ++
  packFirstStep L B ++
  ((List.range (B - 2)).reverse.flatMap (packStep L B)) ++
  [.measureX L.z [] [.CZ (outAt hd 0 L.z) (outAt ld 0 L.z)]] ++
  eraseDecoder hd ++ eraseDecoder ld

def unpackStep (L : Layout) (B j : Nat) : Program :=
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  [.CCX (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z) L.t,
   .CX L.t L.z] ++
  (if j < B - 2 then
    [.CCX (L.D j) L.z (L.S (B - 2 - j)),
     .CX (L.S (B - 2 - j)) (L.D j)]
   else []) ++
  [.CX L.t (L.D j)] ++
  cxInto L.t (decoderDelta ld (lowBits L B) (k % 2 ^ lo)) ++
  cxInto L.t (decoderDelta hd (highBits L B) (k / 2 ^ lo)) ++
  cxInto L.t ((List.range nb).filter (fun b => k.testBit b) |>.map L.A) ++
  [.measureX L.t [] [.CZ (L.D j) L.z]]

def unpack (L : Layout) (B : Nat) : Program :=
  let ld := lowDecoder L B
  let hd := highDecoder L B
  ld.program ++ hd.program ++
  [.CCX (outAt hd 0 L.z) (outAt ld 0 L.z) L.z] ++
  (List.range (B - 2)).flatMap (unpackStep L B) ++
  unpackStep L B (B - 2) ++
  [.X L.z] ++ decoderInit ld (lowBits L B) ++ decoderInit hd (highBits L B) ++
  [.X (L.S 0)] ++ unpackAdder L B ++
  cxInto (L.D (B - 1)) (reg L.D (B - 1))

/-- The checkpoint boundary uses exactly one Fredkin per signed rail bit. -/
def orient (letter : Wire) (L : Layout) (B : Nat) : Program :=
  swapRegisters letter (reg L.S B) (reg L.D B)

def workSites (L : Layout) (B : Nat) : List Wire :=
  reg L.A (bitWidth B) ++ reg L.C (B - 2) ++ [L.z, L.t] ++
    (lowDecoder L B).sites ++ (highDecoder L B).sites

def declaredSites (L : Layout) (B : Nat) : List Wire :=
  reg L.S B ++ reg L.D B ++ workSites L B

def Layout.Nodup (L : Layout) (B : Nat) : Prop := (declaredSites L B).Nodup

private theorem layout_nodup_normal (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.S B ++ (reg L.D B ++
      (reg L.A (bitWidth B) ++ (reg L.C (B - 2) ++
        ([L.z, L.t] ++ ((lowDecoder L B).sites ++ (highDecoder L B).sites)))))).Nodup := by
  simpa only [Layout.Nodup, declaredSites, workSites, List.append_assoc] using hn

theorem sep_S_rest (L : Layout) (B : Nat) (hn : L.Nodup B)
    {x y : Wire} (hx : x ∈ reg L.S B)
    (hy : y ∈ reg L.D B ++ workSites L B) : x ≠ y := by
  have h := layout_nodup_normal L B hn
  apply cross_ne_of_nodup h hx
  simpa only [workSites, List.append_assoc] using hy

theorem sep_D_work (L : Layout) (B : Nat) (hn : L.Nodup B)
    {x y : Wire} (hx : x ∈ reg L.D B) (hy : y ∈ workSites L B) : x ≠ y := by
  have h := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  apply cross_ne_of_nodup h hx
  simpa only [workSites, List.append_assoc] using hy

theorem sep_A_rest (L : Layout) (B : Nat) (hn : L.Nodup B)
    {x y : Wire} (hx : x ∈ reg L.A (bitWidth B))
    (hy : y ∈ reg L.C (B - 2) ++ [L.z, L.t] ++
      (lowDecoder L B).sites ++ (highDecoder L B).sites) : x ≠ y := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h := (List.nodup_append.mp h0).2.1
  apply cross_ne_of_nodup h hx
  simpa only [List.append_assoc] using hy

theorem sep_C_rest (L : Layout) (B : Nat) (hn : L.Nodup B)
    {x y : Wire} (hx : x ∈ reg L.C (B - 2))
    (hy : y ∈ [L.z, L.t] ++ (lowDecoder L B).sites ++
      (highDecoder L B).sites) : x ≠ y := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  have h := (List.nodup_append.mp h1).2.1
  apply cross_ne_of_nodup h hx
  simpa only [List.append_assoc] using hy

theorem sep_ZT_decoders (L : Layout) (B : Nat) (hn : L.Nodup B)
    {x y : Wire} (hx : x ∈ [L.z, L.t])
    (hy : y ∈ (lowDecoder L B).sites ++ (highDecoder L B).sites) : x ≠ y := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  have h2 := (List.nodup_append.mp h1).2.1
  have h := (List.nodup_append.mp h2).2.1
  exact cross_ne_of_nodup h hx hy

theorem sep_low_high (L : Layout) (B : Nat) (hn : L.Nodup B)
    {x y : Wire} (hx : x ∈ (lowDecoder L B).sites)
    (hy : y ∈ (highDecoder L B).sites) : x ≠ y := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  have h2 := (List.nodup_append.mp h1).2.1
  have h3 := (List.nodup_append.mp h2).2.1
  have h := (List.nodup_append.mp h3).2.1
  exact cross_ne_of_nodup h hx hy

theorem sep_z_t (L : Layout) (B : Nat) (hn : L.Nodup B) : L.z ≠ L.t := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  have h2 := (List.nodup_append.mp h1).2.1
  have h3 := (List.nodup_append.mp h2).2.1
  have hzt := (List.nodup_append.mp h3).1
  simpa using (List.nodup_cons.mp hzt).1

theorem reg_mem (f : Nat → Wire) (n i : Nat) (hi : i < n) :
    f i ∈ reg f n := by
  simp only [reg, List.mem_map, List.mem_range]
  exact ⟨i, hi, rfl⟩

theorem reg_ne (f : Nat → Wire) (n i j : Nat) (hn : (reg f n).Nodup)
    (hi : i < n) (hj : j < n) (hij : i ≠ j) : f i ≠ f j := by
  intro heq
  apply hij
  apply List.inj_on_of_nodup_map (by simpa only [reg] using hn)
  · simp [hi]
  · simp [hj]
  · exact heq

theorem S_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.S B).Nodup := (List.nodup_append.mp (layout_nodup_normal L B hn)).1

theorem D_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.D B).Nodup :=
  (List.nodup_append.mp (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1).1

theorem A_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.A (bitWidth B)).Nodup := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  exact (List.nodup_append.mp h1).1

theorem C_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (reg L.C (B - 2)).Nodup := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  have h2 := (List.nodup_append.mp h1).2.1
  exact (List.nodup_append.mp h2).1

theorem lowDecoder_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (lowBits L B ++ (lowDecoder L B).sites).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have hall := List.nodup_iff_count.mp hn q
  have htake := (List.take_sublist (bitWidth B / 2) (reg L.A (bitWidth B))).count_le q
  simp only [declaredSites, workSites, List.count_append] at hall
  simp only [lowBits, List.count_append] at htake ⊢
  omega

theorem highDecoder_nodup (L : Layout) (B : Nat) (hn : L.Nodup B) :
    (highBits L B ++ (highDecoder L B).sites).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have hall := List.nodup_iff_count.mp hn q
  have hdrop := (List.drop_sublist (bitWidth B / 2) (reg L.A (bitWidth B))).count_le q
  simp only [declaredSites, workSites, List.count_append] at hall
  simp only [highBits, List.count_append] at hdrop ⊢
  omega

private theorem lowBits_length' (L : Layout) (B : Nat) :
    (lowBits L B).length = bitWidth B / 2 := by
  simp [lowBits, reg, Nat.min_eq_left (Nat.div_le_self (bitWidth B) 2)]

private theorem highBits_length' (L : Layout) (B : Nat) :
    (highBits L B).length = bitWidth B - bitWidth B / 2 := by
  simp [highBits, reg]

theorem bitWidth_bound (B : Nat) (hB : 1 ≤ B) : B ≤ 2 ^ bitWidth B := by
  by_cases h1 : B = 1
  · subst B
    decide
  · have hn : B - 1 ≠ 0 := by omega
    have hlt : B - 1 < 2 ^ ((B - 1).log2 + 1) :=
      (Nat.log2_lt hn).mp (by omega)
    calc
      B = (B - 1) + 1 := by omega
      _ ≤ 2 ^ bitWidth B := by
        apply Nat.succ_le_iff.mpr
        simpa only [bitWidth] using hlt

private theorem decoder_index_bounds (L : Layout) (B k : Nat) (hB : 3 ≤ B)
    (hk : k < B) :
    k % 2 ^ (bitWidth B / 2) < (lowDecoder L B).outputs.length ∧
    k / 2 ^ (bitWidth B / 2) < (highDecoder L B).outputs.length := by
  have hkpow : k < 2 ^ bitWidth B := lt_of_lt_of_le hk (bitWidth_bound B (by omega))
  constructor
  · simp only [lowDecoder, oneHot_outputs_length, lowBits_length']
    exact Nat.mod_lt _ (by positivity)
  · simp only [highDecoder, oneHot_outputs_length, highBits_length']
    rw [Nat.div_lt_iff_lt_mul (by positivity), ← pow_add]
    have hlo : bitWidth B / 2 ≤ bitWidth B := Nat.div_le_self _ _
    simpa only [Nat.sub_add_cancel hlo] using hkpow

private theorem outAt_low_mem (L : Layout) (B i : Nat)
    (hi : i < (lowDecoder L B).outputs.length) :
    outAt (lowDecoder L B) i L.z ∈ lowBits L B ++ (lowDecoder L B).sites := by
  rw [outAt, List.getD_eq_getElem _ _ hi]
  exact (oneHot_structural (lowBits L B) L.lowWork).2.1 _ (List.getElem_mem _)

private theorem outAt_high_mem (L : Layout) (B i : Nat)
    (hi : i < (highDecoder L B).outputs.length) :
    outAt (highDecoder L B) i L.z ∈ highBits L B ++ (highDecoder L B).sites := by
  rw [outAt, List.getD_eq_getElem _ _ hi]
  exact (oneHot_structural (highBits L B) L.highWork).2.1 _ (List.getElem_mem _)

theorem low_output_ne_z (L : Layout) (B i : Nat) (hn : L.Nodup B)
    (hi : i < (lowDecoder L B).outputs.length) : outAt (lowDecoder L B) i L.z ≠ L.z := by
  rcases List.mem_append.mp (outAt_low_mem L B i hi) with hm | hm
  · have ha := List.mem_of_mem_take hm
    exact sep_A_rest L B hn ha (by simp)
  · exact (sep_ZT_decoders L B hn (by simp) (by simp [hm])).symm

private theorem low_output_ne_t (L : Layout) (B i : Nat) (hn : L.Nodup B)
    (hi : i < (lowDecoder L B).outputs.length) : outAt (lowDecoder L B) i L.z ≠ L.t := by
  rcases List.mem_append.mp (outAt_low_mem L B i hi) with hm | hm
  · have ha := List.mem_of_mem_take hm
    exact sep_A_rest L B hn ha (by simp)
  · exact (sep_ZT_decoders L B hn (by simp) (by simp [hm])).symm

theorem high_output_ne_z (L : Layout) (B i : Nat) (hn : L.Nodup B)
    (hi : i < (highDecoder L B).outputs.length) : outAt (highDecoder L B) i L.z ≠ L.z := by
  rcases List.mem_append.mp (outAt_high_mem L B i hi) with hm | hm
  · have ha := List.mem_of_mem_drop hm
    exact sep_A_rest L B hn ha (by simp)
  · exact (sep_ZT_decoders L B hn (by simp) (by simp [hm])).symm

private theorem high_output_ne_t (L : Layout) (B i : Nat) (hn : L.Nodup B)
    (hi : i < (highDecoder L B).outputs.length) : outAt (highDecoder L B) i L.z ≠ L.t := by
  rcases List.mem_append.mp (outAt_high_mem L B i hi) with hm | hm
  · have ha := List.mem_of_mem_drop hm
    exact sep_A_rest L B hn ha (by simp)
  · exact (sep_ZT_decoders L B hn (by simp) (by simp [hm])).symm

private theorem z_ne_t (L : Layout) (B : Nat) (hn : L.Nodup B) : L.z ≠ L.t := by
  have h0 := (List.nodup_append.mp (layout_nodup_normal L B hn)).2.1
  have h1 := (List.nodup_append.mp h0).2.1
  have h2 := (List.nodup_append.mp h1).2.1
  have h3 := (List.nodup_append.mp h2).2.1
  have h4 := (List.nodup_append.mp h3).1
  have hz := (List.nodup_cons.mp h4).1
  intro he
  exact hz (by simp [he])

private theorem declared_S (L : Layout) (B i : Nat) (hi : i < B) :
    L.S i ∈ (declaredSites L B).toFinset := by
  have hm : ∃ a < B, L.S a = L.S i := ⟨i, hi, rfl⟩
  simp only [declaredSites, workSites, reg, List.mem_toFinset, List.mem_append,
    List.mem_cons, List.mem_map, List.mem_range]
  exact Or.inl (Or.inl hm)

private theorem declared_D (L : Layout) (B i : Nat) (hi : i < B) :
    L.D i ∈ (declaredSites L B).toFinset := by
  have hm : ∃ a < B, L.D a = L.D i := ⟨i, hi, rfl⟩
  simp only [declaredSites, workSites, reg, List.mem_toFinset, List.mem_append,
    List.mem_cons, List.mem_map, List.mem_range]
  exact Or.inl (Or.inr hm)

private theorem declared_A (L : Layout) (B i : Nat) (hi : i < bitWidth B) :
    L.A i ∈ (declaredSites L B).toFinset := by
  have hm : ∃ a < bitWidth B, L.A a = L.A i := ⟨i, hi, rfl⟩
  simp only [declaredSites, workSites, reg, List.mem_toFinset, List.mem_append,
    List.mem_cons, List.mem_map, List.mem_range]
  exact Or.inr (Or.inl (Or.inl (Or.inl (Or.inl hm))))

private theorem declared_C (L : Layout) (B i : Nat) (hi : i < B - 2) :
    L.C i ∈ (declaredSites L B).toFinset := by
  have hm : ∃ a < B - 2, L.C a = L.C i := ⟨i, hi, rfl⟩
  simp only [declaredSites, workSites, reg, List.mem_toFinset, List.mem_append,
    List.mem_cons, List.mem_map, List.mem_range]
  exact Or.inr (Or.inl (Or.inl (Or.inl (Or.inr hm))))

private theorem declared_z (L : Layout) (B : Nat) :
    L.z ∈ (declaredSites L B).toFinset := by
  simp [declaredSites, workSites]

private theorem declared_t (L : Layout) (B : Nat) :
    L.t ∈ (declaredSites L B).toFinset := by
  simp [declaredSites, workSites]

private theorem lowBits_declared (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ lowBits L B) : q ∈ (declaredSites L B).toFinset := by
  have hm := List.mem_of_mem_take hq
  simp only [reg, List.mem_map, List.mem_range] at hm
  rcases hm with ⟨i, hi, rfl⟩
  exact declared_A L B i hi

private theorem highBits_declared (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ highBits L B) : q ∈ (declaredSites L B).toFinset := by
  have hm := List.mem_of_mem_drop hq
  simp only [reg, List.mem_map, List.mem_range] at hm
  rcases hm with ⟨i, hi, rfl⟩
  exact declared_A L B i hi

private theorem lowSite_declared (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ (lowDecoder L B).sites) : q ∈ (declaredSites L B).toFinset := by
  simp only [declaredSites, workSites, List.mem_toFinset, List.mem_append,
    List.mem_cons]
  tauto

private theorem highSite_declared (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ (highDecoder L B).sites) : q ∈ (declaredSites L B).toFinset := by
  simp only [declaredSites, workSites, List.mem_toFinset, List.mem_append,
    List.mem_cons]
  tauto

private theorem decoderDelta_declared_low (L : Layout) (B x : Nat) {q : Wire}
    (hq : q ∈ decoderDelta (lowDecoder L B) (lowBits L B) x) :
    q ∈ (declaredSites L B).toFinset := by
  exact lowSite_declared L B (List.mem_of_mem_filter hq)

private theorem decoderDelta_declared_high (L : Layout) (B x : Nat) {q : Wire}
    (hq : q ∈ decoderDelta (highDecoder L B) (highBits L B) x) :
    q ∈ (declaredSites L B).toFinset := by
  exact highSite_declared L B (List.mem_of_mem_filter hq)

private theorem outAt_declared_low (L : Layout) (B i : Nat) :
    outAt (lowDecoder L B) i L.z ∈ (declaredSites L B).toFinset := by
  rcases getD_mem_or_eq (lowDecoder L B).outputs i L.z with hm | hm
  · have hs := (oneHot_structural (lowBits L B) L.lowWork).2.1 _ hm
    simp only [lowDecoder] at hs
    rcases List.mem_append.mp hs with hs | hs
    · exact lowBits_declared L B hs
    · exact lowSite_declared L B hs
  · rw [outAt, hm]
    exact declared_z L B

private theorem outAt_declared_high (L : Layout) (B i : Nat) :
    outAt (highDecoder L B) i L.z ∈ (declaredSites L B).toFinset := by
  rcases getD_mem_or_eq (highDecoder L B).outputs i L.z with hm | hm
  · have hs := (oneHot_structural (highBits L B) L.highWork).2.1 _ hm
    simp only [highDecoder] at hs
    rcases List.mem_append.mp hs with hs | hs
    · exact highBits_declared L B hs
    · exact highSite_declared L B hs
  · rw [outAt, hm]
    exact declared_z L B

private theorem support_append {p q : Program} {S : Finset Wire}
    (hp : wires p ⊆ S) (hq : wires q ⊆ S) : wires (p ++ q) ⊆ S := by
  simpa only [wires_append, Finset.union_subset_iff] using And.intro hp hq

private theorem cxInto_declared (L : Layout) (B : Nat) (c : Wire) (xs : List Wire)
    (hc : c ∈ (declaredSites L B).toFinset)
    (hxs : ∀ q ∈ xs, q ∈ (declaredSites L B).toFinset) :
    wires (cxInto c xs) ⊆ (declaredSites L B).toFinset := by
  intro q hq
  have hm := cxInto_support c xs hq
  simp only [List.mem_toFinset, List.mem_cons] at hm
  rcases hm with rfl | hm
  · exact hc
  · exact hxs q hm

private theorem xOn_declared (L : Layout) (B : Nat) (xs : List Wire)
    (hxs : ∀ q ∈ xs, q ∈ (declaredSites L B).toFinset) :
    wires (xOn xs) ⊆ (declaredSites L B).toFinset := by
  intro q hq
  exact hxs q (List.mem_toFinset.mp (xOn_support xs hq))

private theorem lowDecoder_program_declared (L : Layout) (B : Nat) :
    wires (lowDecoder L B).program ⊆ (declaredSites L B).toFinset := by
  intro q hq
  have hm := oneHot_program_support (lowBits L B) L.lowWork hq
  rcases List.mem_toFinset.mp hm |> List.mem_append.mp with hm | hm
  · exact lowBits_declared L B hm
  · exact lowSite_declared L B hm

private theorem highDecoder_program_declared (L : Layout) (B : Nat) :
    wires (highDecoder L B).program ⊆ (declaredSites L B).toFinset := by
  intro q hq
  have hm := oneHot_program_support (highBits L B) L.highWork hq
  rcases List.mem_toFinset.mp hm |> List.mem_append.mp with hm | hm
  · exact highBits_declared L B hm
  · exact highSite_declared L B hm

private theorem lowDecoder_erase_declared (L : Layout) (B : Nat) :
    wires (eraseDecoder (lowDecoder L B)) ⊆ (declaredSites L B).toFinset := by
  intro q hq
  have hm := eraseDecoder_support (lowBits L B) L.lowWork hq
  rcases List.mem_toFinset.mp hm |> List.mem_append.mp with hm | hm
  · exact lowBits_declared L B hm
  · exact lowSite_declared L B hm

private theorem highDecoder_erase_declared (L : Layout) (B : Nat) :
    wires (eraseDecoder (highDecoder L B)) ⊆ (declaredSites L B).toFinset := by
  intro q hq
  have hm := eraseDecoder_support (highBits L B) L.highWork hq
  rcases List.mem_toFinset.mp hm |> List.mem_append.mp with hm | hm
  · exact highBits_declared L B hm
  · exact highSite_declared L B hm

private theorem decoderInit_declared_low (L : Layout) (B : Nat) :
    wires (decoderInit (lowDecoder L B) (lowBits L B)) ⊆
      (declaredSites L B).toFinset := by
  apply xOn_declared
  intro q hq
  exact lowSite_declared L B (List.mem_of_mem_filter hq)

private theorem decoderInit_declared_high (L : Layout) (B : Nat) :
    wires (decoderInit (highDecoder L B) (highBits L B)) ⊆
      (declaredSites L B).toFinset := by
  apply xOn_declared
  intro q hq
  exact highSite_declared L B (List.mem_of_mem_filter hq)

private theorem selectedA_declared (L : Layout) (B k : Nat) :
    ∀ q ∈ ((List.range (bitWidth B)).filter (fun b => k.testBit b) |>.map L.A),
      q ∈ (declaredSites L B).toFinset := by
  intro q hq
  simp only [List.mem_map] at hq
  rcases hq with ⟨i, hi, rfl⟩
  have hi' := (List.mem_filter.mp hi).1
  exact declared_A L B i (List.mem_range.mp hi')

private theorem packStep_support (L : Layout) (B j : Nat) (hj : j < B - 1) :
    wires (packStep L B j) ⊆ (declaredSites L B).toFinset := by
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  have hdj : L.D j ∈ (declaredSites L B).toFinset := declared_D L B j (by omega)
  have hz := declared_z L B
  have ht := declared_t L B
  have h0 : wires [.CCX (L.D j) L.z L.t] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl | rfl
    · exact hdj
    · exact hz
    · exact ht
  have h1 := cxInto_declared L B L.t
    ((List.range nb).filter (fun b => k.testBit b) |>.map L.A) ht
    (selectedA_declared L B k)
  have h2 := cxInto_declared L B L.t
    (decoderDelta ld (lowBits L B) (k % 2 ^ lo)) ht (by
      intro q hq
      exact decoderDelta_declared_low L B _ hq)
  have h3 := cxInto_declared L B L.t
    (decoderDelta hd (highBits L B) (k / 2 ^ lo)) ht (by
      intro q hq
      exact decoderDelta_declared_high L B _ hq)
  have h4 : wires [.CX L.t (L.D j)] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl
    · exact ht
    · exact hdj
  have h5 : wires (if j < B - 2 then
      [.CX (L.S (B - 2 - j)) (L.D j),
       .measureX (L.S (B - 2 - j)) [] [.CZ (L.D j) L.z]]
     else []) ⊆ (declaredSites L B).toFinset := by
    split_ifs with hnormal
    · have hs : L.S (B - 2 - j) ∈ (declaredSites L B).toFinset :=
        declared_S L B _ (by omega)
      intro q hq
      simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
        Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
      rcases hq with (rfl | rfl) | rfl | rfl | rfl
      · exact hs
      · exact hdj
      · exact hs
      · exact hdj
      · exact hz
    · simp [wires]
  have h6 : wires [.CX L.t L.z,
      .measureX L.t []
        [.CZ (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z)]] ⊆
      (declaredSites L B).toFinset := by
    have hho := outAt_declared_high L B (k / 2 ^ lo)
    have hlo := outAt_declared_low L B (k % 2 ^ lo)
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with (rfl | rfl) | rfl | rfl | rfl
    · exact ht
    · exact hz
    · exact ht
    · exact hho
    · exact hlo
  simpa only [packStep] using
    support_append (support_append (support_append (support_append
      (support_append (support_append h0 h1) h2) h3) h4) h5) h6

/-- Exact wire pool used by the inverse-sweep prefix.  In particular this
omits the carry bank, the sign wire, and both boundary S wires. -/
def unpackSweepSites (L : Layout) (B : Nat) : List Wire :=
  reg L.A (bitWidth B) ++ reg L.D (B - 1) ++
    (List.range (B - 2)).map (fun i => L.S (i + 1)) ++ [L.z, L.t] ++
    (lowDecoder L B).sites ++ (highDecoder L B).sites

private theorem unpackSweep_active_A (L : Layout) (B i : Nat)
    (hi : i < bitWidth B) :
    L.A i ∈ (unpackSweepSites L B).toFinset := by
  simp only [List.mem_toFinset, unpackSweepSites, List.mem_append]
  exact Or.inl (Or.inl (Or.inl (Or.inl
    (Or.inl (reg_mem L.A (bitWidth B) i hi)))))

private theorem unpackSweep_active_D (L : Layout) (B i : Nat)
    (hi : i < B - 1) :
    L.D i ∈ (unpackSweepSites L B).toFinset := by
  simp only [List.mem_toFinset, unpackSweepSites, List.mem_append]
  exact Or.inl (Or.inl (Or.inl (Or.inl
    (Or.inr (reg_mem L.D (B - 1) i hi)))))

private theorem unpackSweep_active_S (L : Layout) (B i : Nat)
    (hi0 : 0 < i) (hi : i < B - 1) :
    L.S i ∈ (unpackSweepSites L B).toFinset := by
  have hm : i - 1 ∈ List.range (B - 2) := by simp; omega
  have heq : i - 1 + 1 = i := by omega
  simp only [List.mem_toFinset, unpackSweepSites, List.mem_append]
  exact Or.inl (Or.inl (Or.inl (Or.inr
    (List.mem_map.mpr ⟨i - 1, hm, by rw [heq]⟩))))

private theorem unpackSweep_active_z (L : Layout) (B : Nat) :
    L.z ∈ (unpackSweepSites L B).toFinset := by
  simp [unpackSweepSites]

private theorem unpackSweep_active_t (L : Layout) (B : Nat) :
    L.t ∈ (unpackSweepSites L B).toFinset := by
  simp [unpackSweepSites]

private theorem unpackSweep_active_lowSite (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ (lowDecoder L B).sites) :
    q ∈ (unpackSweepSites L B).toFinset := by
  simp [unpackSweepSites, hq]

private theorem unpackSweep_active_highSite (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ (highDecoder L B).sites) :
    q ∈ (unpackSweepSites L B).toFinset := by
  simp [unpackSweepSites, hq]

private theorem unpackSweep_active_lowBit (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ lowBits L B) : q ∈ (unpackSweepSites L B).toFinset := by
  have hm := List.mem_of_mem_take hq
  simp only [reg, List.mem_map, List.mem_range] at hm
  rcases hm with ⟨i, hi, rfl⟩
  exact unpackSweep_active_A L B i hi

private theorem unpackSweep_active_highBit (L : Layout) (B : Nat) {q : Wire}
    (hq : q ∈ highBits L B) : q ∈ (unpackSweepSites L B).toFinset := by
  have hm := List.mem_of_mem_drop hq
  simp only [reg, List.mem_map, List.mem_range] at hm
  rcases hm with ⟨i, hi, rfl⟩
  exact unpackSweep_active_A L B i hi

private theorem unpackSweep_active_outLow (L : Layout) (B i : Nat) :
    outAt (lowDecoder L B) i L.z ∈ (unpackSweepSites L B).toFinset := by
  rcases getD_mem_or_eq (lowDecoder L B).outputs i L.z with hm | hm
  · have hs := (oneHot_structural (lowBits L B) L.lowWork).2.1 _ hm
    simp only [lowDecoder] at hs
    rcases List.mem_append.mp hs with hs | hs
    · exact unpackSweep_active_lowBit L B hs
    · exact unpackSweep_active_lowSite L B hs
  · rw [outAt, hm]
    exact unpackSweep_active_z L B

private theorem unpackSweep_active_outHigh (L : Layout) (B i : Nat) :
    outAt (highDecoder L B) i L.z ∈ (unpackSweepSites L B).toFinset := by
  rcases getD_mem_or_eq (highDecoder L B).outputs i L.z with hm | hm
  · have hs := (oneHot_structural (highBits L B) L.highWork).2.1 _ hm
    simp only [highDecoder] at hs
    rcases List.mem_append.mp hs with hs | hs
    · exact unpackSweep_active_highBit L B hs
    · exact unpackSweep_active_highSite L B hs
  · rw [outAt, hm]
    exact unpackSweep_active_z L B

/-- The literal inverse-sweep step only touches `unpackSweepSites`. -/
theorem unpackStep_support_active (L : Layout) (B j : Nat) (hj : j < B - 1) :
    wires (unpackStep L B j) ⊆ (unpackSweepSites L B).toFinset := by
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  have hdj := unpackSweep_active_D L B j hj
  have hz := unpackSweep_active_z L B
  have ht := unpackSweep_active_t L B
  have hho := unpackSweep_active_outHigh L B (k / 2 ^ lo)
  have hlo := unpackSweep_active_outLow L B (k % 2 ^ lo)
  have h0 : wires
      [.CCX (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z) L.t,
       .CX L.t L.z] ⊆ (unpackSweepSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with (rfl | rfl | rfl) | rfl | rfl
    · exact hho
    · exact hlo
    · exact ht
    · exact ht
    · exact hz
  have h1 : wires (if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)]
     else []) ⊆ (unpackSweepSites L B).toFinset := by
    split_ifs with hnormal
    · have hs := unpackSweep_active_S L B (B - 2 - j) (by omega) (by omega)
      intro q hq
      simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
      rcases hq with (rfl | rfl | rfl) | rfl | rfl
      · exact hdj
      · exact hz
      · exact hs
      · exact hs
      · exact hdj
    · simp [wires]
  have h2 : wires [.CX L.t (L.D j)] ⊆ (unpackSweepSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl
    · exact ht
    · exact hdj
  have h3 : wires (cxInto L.t
      (decoderDelta ld (lowBits L B) (k % 2 ^ lo))) ⊆
      (unpackSweepSites L B).toFinset := by
    intro q hq
    have hm := cxInto_support L.t _ hq
    simp only [List.mem_toFinset, List.mem_cons] at hm
    rcases hm with rfl | hm
    · exact ht
    · exact unpackSweep_active_lowSite L B (List.mem_of_mem_filter hm)
  have h4 : wires (cxInto L.t
      (decoderDelta hd (highBits L B) (k / 2 ^ lo))) ⊆
      (unpackSweepSites L B).toFinset := by
    intro q hq
    have hm := cxInto_support L.t _ hq
    simp only [List.mem_toFinset, List.mem_cons] at hm
    rcases hm with rfl | hm
    · exact ht
    · exact unpackSweep_active_highSite L B (List.mem_of_mem_filter hm)
  have h5 : wires (cxInto L.t
      ((List.range nb).filter (fun b => k.testBit b) |>.map L.A)) ⊆
      (unpackSweepSites L B).toFinset := by
    intro q hq
    have hm := cxInto_support L.t _ hq
    simp only [List.mem_toFinset, List.mem_cons] at hm
    rcases hm with rfl | hm
    · exact ht
    · simp only [List.mem_map] at hm
      rcases hm with ⟨i, hi, rfl⟩
      exact unpackSweep_active_A L B i (by
        exact List.mem_range.mp (List.mem_of_mem_filter hi))
  have h6 : wires [.measureX L.t [] [.CZ (L.D j) L.z]] ⊆
      (unpackSweepSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl | rfl
    · exact ht
    · exact hdj
    · exact hz
  simpa only [unpackStep] using
    support_append (support_append (support_append (support_append
      (support_append (support_append h0 h1) h2) h3) h4) h5) h6

/-- Literal generated prefix ending after the complete ascending inverse
sweep, before `z` and the decoders are cleared. -/
def unpackSweepPrefix (L : Layout) (B : Nat) : Program :=
  (lowDecoder L B).program ++ (highDecoder L B).program ++
    [.CCX (outAt (highDecoder L B) 0 L.z)
      (outAt (lowDecoder L B) 0 L.z) L.z] ++
    (List.range (B - 2)).flatMap (unpackStep L B) ++
    unpackStep L B (B - 2)

/-- The whole literal decoder/inverse-sweep prefix stays in the exact active
pool and hence preserves every omitted boundary wire. -/
theorem unpackSweepPrefix_support_active (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    wires (unpackSweepPrefix L B) ⊆ (unpackSweepSites L B).toFinset := by
  have hlow : wires (lowDecoder L B).program ⊆
      (unpackSweepSites L B).toFinset := by
    intro q hq
    have hm := oneHot_program_support (lowBits L B) L.lowWork hq
    rcases List.mem_toFinset.mp hm |> List.mem_append.mp with hm | hm
    · exact unpackSweep_active_lowBit L B hm
    · exact unpackSweep_active_lowSite L B hm
  have hhigh : wires (highDecoder L B).program ⊆
      (unpackSweepSites L B).toFinset := by
    intro q hq
    have hm := oneHot_program_support (highBits L B) L.highWork hq
    rcases List.mem_toFinset.mp hm |> List.mem_append.mp with hm | hm
    · exact unpackSweep_active_highBit L B hm
    · exact unpackSweep_active_highSite L B hm
  have hinit : wires
      [.CCX (outAt (highDecoder L B) 0 L.z)
        (outAt (lowDecoder L B) 0 L.z) L.z] ⊆
      (unpackSweepSites L B).toFinset := by
    have hho := unpackSweep_active_outHigh L B 0
    have hlo := unpackSweep_active_outLow L B 0
    have hz := unpackSweep_active_z L B
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl | rfl
    · exact hho
    · exact hlo
    · exact hz
  have hsteps : wires ((List.range (B - 2)).flatMap (unpackStep L B)) ⊆
      (unpackSweepSites L B).toFinset := by
    apply wires_flatMap_subset
    intro j hj
    exact unpackStep_support_active L B j (by
      have := List.mem_range.mp hj
      omega)
  have htop := unpackStep_support_active L B (B - 2) (by omega)
  simpa only [unpackSweepPrefix] using
    support_append (support_append (support_append (support_append hlow hhigh)
      hinit) hsteps) htop

private theorem unpackStep_support (L : Layout) (B j : Nat) (hj : j < B - 1) :
    wires (unpackStep L B j) ⊆ (declaredSites L B).toFinset := by
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  have hdj : L.D j ∈ (declaredSites L B).toFinset := declared_D L B j (by omega)
  have hz := declared_z L B
  have ht := declared_t L B
  have hho := outAt_declared_high L B (k / 2 ^ lo)
  have hlo := outAt_declared_low L B (k % 2 ^ lo)
  have h0 : wires
      [.CCX (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z) L.t,
       .CX L.t L.z] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with (rfl | rfl | rfl) | rfl | rfl
    · exact hho
    · exact hlo
    · exact ht
    · exact ht
    · exact hz
  have h1 : wires (if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)]
     else []) ⊆ (declaredSites L B).toFinset := by
    split_ifs with hnormal
    · have hs : L.S (B - 2 - j) ∈ (declaredSites L B).toFinset :=
        declared_S L B _ (by omega)
      intro q hq
      simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
      rcases hq with (rfl | rfl | rfl) | rfl | rfl
      · exact hdj
      · exact hz
      · exact hs
      · exact hs
      · exact hdj
    · simp [wires]
  have h2 : wires [.CX L.t (L.D j)] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl
    · exact ht
    · exact hdj
  have h3 := cxInto_declared L B L.t
    (decoderDelta ld (lowBits L B) (k % 2 ^ lo)) ht (by
      intro q hq
      exact decoderDelta_declared_low L B _ hq)
  have h4 := cxInto_declared L B L.t
    (decoderDelta hd (highBits L B) (k / 2 ^ lo)) ht (by
      intro q hq
      exact decoderDelta_declared_high L B _ hq)
  have h5 := cxInto_declared L B L.t
    ((List.range nb).filter (fun b => k.testBit b) |>.map L.A) ht
    (selectedA_declared L B k)
  have h6 : wires [.measureX L.t [] [.CZ (L.D j) L.z]] ⊆
      (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    rcases hq with rfl | rfl | rfl
    · exact ht
    · exact hdj
    · exact hz
  simpa only [unpackStep] using
    support_append (support_append (support_append (support_append
      (support_append (support_append h0 h1) h2) h3) h4) h5) h6

private theorem adderMiddle_support (L : Layout) (B j : Nat)
    (hj0 : 0 < j) (hj : j < B - 2) :
    wires (adderMiddle L j) ⊆ (declaredSites L B).toFinset := by
  have hc0 := declared_C L B (j - 1) (by omega)
  have hc1 := declared_C L B j hj
  have hs := declared_S L B j (by omega)
  have hd := declared_D L B j (by omega)
  intro q hq
  simp only [adderMiddle, wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
    Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
  aesop

private theorem adderDown_support (L : Layout) (B j : Nat)
    (hj0 : 0 < j) (hj : j < B - 2) :
    wires (adderDown L j) ⊆ (declaredSites L B).toFinset := by
  have hc0 := declared_C L B (j - 1) (by omega)
  have hc1 := declared_C L B j hj
  have hs := declared_S L B j (by omega)
  have hd := declared_D L B j (by omega)
  intro q hq
  simp only [adderDown, wires, Instr.wires, correctionWires, Finset.mem_union,
    Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
  aesop

private theorem adderTopDown_support (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    wires (adderTopDown L B) ⊆ (declaredSites L B).toFinset := by
  let j := B - 2
  have hc := declared_C L B (j - 1) (by dsimp [j]; omega)
  have hs := declared_S L B j (by dsimp [j]; omega)
  have hd := declared_D L B j (by dsimp [j]; omega)
  intro q hq
  simp only [adderTopDown, wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
    Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
  aesop

private theorem packAdder_support (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    wires (packAdder L B) ⊆ (declaredSites L B).toFinset := by
  let sig := L.D (B - 1)
  let j := B - 2
  have hsig : sig ∈ (declaredSites L B).toFinset := declared_D L B _ (by omega)
  have hs0 := declared_S L B 0 (by omega)
  have hd0 := declared_D L B 0 (by omega)
  have hc0 := declared_C L B 0 (by omega)
  have hcj := declared_C L B (j - 1) (by dsimp [j]; omega)
  have hsj := declared_S L B j (by dsimp [j]; omega)
  have hdj := declared_D L B j (by dsimp [j]; omega)
  have hst := declared_S L B (B - 1) (by omega)
  have hfirst : wires
      [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
       .CX sig (L.C 0)] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  have hmiddle : wires ((List.range (B - 3)).flatMap
      (fun r => adderMiddle L (r + 1))) ⊆ (declaredSites L B).toFinset := by
    apply wires_flatMap_subset
    intro r hr
    apply adderMiddle_support
    · omega
    · have := List.mem_range.mp hr
      omega
  have htop : wires
      [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
       .X (L.S (B - 1)),
       .measureX (L.S (B - 1)) [] [.Z (L.C (j - 1)), .CZ (L.S j) (L.D j)],
       .X (L.S (B - 1))] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  have hdowns : wires
      (((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)) ⊆
      (declaredSites L B).toFinset := by
    apply wires_flatMap_subset
    intro i hi
    have hm := List.mem_reverse.mp hi
    simp only [List.mem_map, List.mem_range] at hm
    rcases hm with ⟨r, hr, rfl⟩
    apply adderDown_support
    · omega
    · omega
  have hdown := support_append (adderTopDown_support L B hB) hdowns
  have hlast : wires
      [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
       .CX sig (L.D 0), .CX (L.D 0) (L.S 0)] ⊆
      (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  simpa only [packAdder] using support_append
    (support_append (support_append (support_append hfirst hmiddle) htop) hdown) hlast

private theorem unpackAdder_support (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    wires (unpackAdder L B) ⊆ (declaredSites L B).toFinset := by
  let sig := L.D (B - 1)
  let j := B - 2
  have hsig : sig ∈ (declaredSites L B).toFinset := declared_D L B _ (by omega)
  have hs0 := declared_S L B 0 (by omega)
  have hd0 := declared_D L B 0 (by omega)
  have hc0 := declared_C L B 0 (by omega)
  have hcj := declared_C L B (j - 1) (by dsimp [j]; omega)
  have hsj := declared_S L B j (by dsimp [j]; omega)
  have hdj := declared_D L B j (by dsimp [j]; omega)
  have hst := declared_S L B (B - 1) (by omega)
  have hfirst : wires
      [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
       .CX sig (L.C 0)] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  have hmiddle : wires ((List.range (B - 3)).flatMap
      (fun r => adderMiddle L (r + 1))) ⊆ (declaredSites L B).toFinset := by
    apply wires_flatMap_subset
    intro r hr
    apply adderMiddle_support
    · omega
    · have := List.mem_range.mp hr
      omega
  have htop : wires
      [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
       .CX (L.C (j - 1)) (L.S (B - 1)),
       .CCX (L.S j) (L.D j) (L.S (B - 1))] ⊆
      (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_insert,
      Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  have hdowns : wires
      (((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)) ⊆
      (declaredSites L B).toFinset := by
    apply wires_flatMap_subset
    intro i hi
    have hm := List.mem_reverse.mp hi
    simp only [List.mem_map, List.mem_range] at hm
    rcases hm with ⟨r, hr, rfl⟩
    apply adderDown_support <;> omega
  have hdown := support_append (adderTopDown_support L B hB) hdowns
  have hlast : wires
      [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
       .CX sig (L.D 0), .CX (L.D 0) (L.S 0)] ⊆
      (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  simpa only [unpackAdder] using support_append
    (support_append (support_append (support_append hfirst hmiddle) htop) hdown) hlast

private theorem adderMiddle_physical (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj0 : 0 < j) (hj : j < B - 2) : GatePhysical (adderMiddle L j) := by
  have hs : L.S j ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hd : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hc0r : L.C (j - 1) ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hc1r : L.C j ∈ reg L.C (B - 2) := reg_mem _ _ _ hj
  have hc0 : L.C (j - 1) ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hc1 : L.C j ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hcs0 := (sep_S_rest L B hn hs (List.mem_append_right _ hc0)).symm
  have hcd0 := (sep_D_work L B hn hd hc0).symm
  have hsc1 := sep_S_rest L B hn hs (List.mem_append_right _ hc1)
  have hdc1 := sep_D_work L B hn hd hc1
  have hcc := reg_ne L.C (B - 2) (j - 1) j (C_nodup L B hn)
    (by omega) hj (by omega)
  simp [adderMiddle, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
    hcs0, hcd0, hsc1, hdc1, hcc]

private theorem adderDown_physical (L : Layout) (B j : Nat) (hn : L.Nodup B)
    (hj0 : 0 < j) (hj : j < B - 2) : GatePhysical (adderDown L j) := by
  have hs : L.S j ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hd : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hc0r : L.C (j - 1) ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hc0 : L.C (j - 1) ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hcd0 := (sep_D_work L B hn hd hc0).symm
  have hds := (sep_S_rest L B hn hs (List.mem_append_left _ hd)).symm
  have hcc := reg_ne L.C (B - 2) (j - 1) j (C_nodup L B hn)
    (by omega) hj (by omega)
  simp [adderDown, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
    hcd0, hds, hcc]

private theorem adderTopDown_physical (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : GatePhysical (adderTopDown L B) := by
  let j := B - 2
  have hd : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hs : L.S j ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hcr : L.C (j - 1) ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hc : L.C (j - 1) ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hcd := (sep_D_work L B hn hd hc).symm
  have hds := (sep_S_rest L B hn hs (List.mem_append_left _ hd)).symm
  dsimp only [j] at hcd hds
  simpa [adderTopDown, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate] using
    And.intro hcd hds

private theorem packAdder_physical (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : GatePhysical (packAdder L B) := by
  let sig := L.D (B - 1)
  let j := B - 2
  have hsig : sig ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hs0 : L.S 0 ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hd0 : L.D 0 ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hc0r : L.C 0 ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hc0 : L.C 0 ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hsigS := (sep_S_rest L B hn hs0 (List.mem_append_left _ hsig)).symm
  have hsigD := reg_ne L.D B (B - 1) 0 (D_nodup L B hn)
    (by omega) (by omega) (by omega)
  have hsD := sep_S_rest L B hn hs0 (List.mem_append_left _ hd0)
  have hsC := sep_S_rest L B hn hs0 (List.mem_append_right _ hc0)
  have hdC := sep_D_work L B hn hd0 hc0
  have hsigC := sep_D_work L B hn hsig hc0
  have hfirst : GatePhysical
      [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
       .CX sig (L.C 0)] := by
    simp [sig, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
      hsigS, hsigD, hsC, hdC, hsigC]
  have hmiddle : GatePhysical ((List.range (B - 3)).flatMap
      (fun r => adderMiddle L (r + 1))) := by
    apply gatePhysical_flatMap
    intro r hr
    apply adderMiddle_physical L B _ hn <;> simp only [List.mem_range] at hr <;> omega
  have hcjr : L.C (j - 1) ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hcj : L.C (j - 1) ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hsj : L.S j ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hdj : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hcS := (sep_S_rest L B hn hsj (List.mem_append_right _ hcj)).symm
  have hcD := (sep_D_work L B hn hdj hcj).symm
  have htop : GatePhysical
      [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
       .X (L.S (B - 1)),
       .measureX (L.S (B - 1)) [] [.Z (L.C (j - 1)), .CZ (L.S j) (L.D j)],
       .X (L.S (B - 1))] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hcS, hcD]
  have hdowns : GatePhysical
      (((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)) := by
    apply gatePhysical_flatMap
    intro i hi
    have hm := List.mem_reverse.mp hi
    simp only [List.mem_map, List.mem_range] at hm
    rcases hm with ⟨r, hr, rfl⟩
    apply adderDown_physical L B _ hn <;> omega
  have hdown : GatePhysical (adderTopDown L B ++
      ((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)) := by
    rw [gatePhysical_append]
    exact ⟨adderTopDown_physical L B hB hn, hdowns⟩
  have hD0S0 := (sep_S_rest L B hn hs0 (List.mem_append_left _ hd0)).symm
  have hlast : GatePhysical
      [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
       .CX sig (L.D 0), .CX (L.D 0) (L.S 0)] := by
    simp [sig, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
      hsigC, hsigD, hD0S0]
  have h01 : GatePhysical
      ([.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
        .CX sig (L.C 0)] ++
       (List.range (B - 3)).flatMap (fun r => adderMiddle L (r + 1))) := by
    rw [gatePhysical_append]
    exact ⟨hfirst, hmiddle⟩
  have h02 := (gatePhysical_append _ _).mpr ⟨h01, htop⟩
  have h03 := (gatePhysical_append _ _).mpr ⟨h02, hdown⟩
  have h04 := (gatePhysical_append _ _).mpr ⟨h03, hlast⟩
  simpa only [packAdder] using h04

private theorem unpackAdder_physical (L : Layout) (B : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) : GatePhysical (unpackAdder L B) := by
  let sig := L.D (B - 1)
  let j := B - 2
  have hsig : sig ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hs0 : L.S 0 ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hd0 : L.D 0 ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hc0r : L.C 0 ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hc0 : L.C 0 ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hsigS := (sep_S_rest L B hn hs0 (List.mem_append_left _ hsig)).symm
  have hsigD := reg_ne L.D B (B - 1) 0 (D_nodup L B hn)
    (by omega) (by omega) (by omega)
  have hsC := sep_S_rest L B hn hs0 (List.mem_append_right _ hc0)
  have hdC := sep_D_work L B hn hd0 hc0
  have hsigC := sep_D_work L B hn hsig hc0
  have hfirst : GatePhysical
      [.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
       .CX sig (L.C 0)] := by
    simp [sig, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
      hsigS, hsigD, hsC, hdC, hsigC]
  have hmiddle : GatePhysical ((List.range (B - 3)).flatMap
      (fun r => adderMiddle L (r + 1))) := by
    apply gatePhysical_flatMap
    intro r hr
    apply adderMiddle_physical L B _ hn <;> simp only [List.mem_range] at hr <;> omega
  have hcjr : L.C (j - 1) ∈ reg L.C (B - 2) := reg_mem _ _ _ (by omega)
  have hcj : L.C (j - 1) ∈ workSites L B := by
    simp only [workSites, List.mem_append]
    tauto
  have hsj : L.S j ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hdj : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hst : L.S (B - 1) ∈ reg L.S B := reg_mem _ _ _ (by omega)
  have hcS := (sep_S_rest L B hn hsj (List.mem_append_right _ hcj)).symm
  have hcD := (sep_D_work L B hn hdj hcj).symm
  have hcSt := (sep_S_rest L B hn hst (List.mem_append_right _ hcj)).symm
  have hsSt := reg_ne L.S B j (B - 1) (S_nodup L B hn)
    (by omega) (by omega) (by dsimp [j]; omega)
  have hdSt := sep_S_rest L B hn hst (List.mem_append_left _ hdj) |>.symm
  have htop : GatePhysical
      [.CX (L.C (j - 1)) (L.S j), .CX (L.C (j - 1)) (L.D j),
       .CX (L.C (j - 1)) (L.S (B - 1)),
       .CCX (L.S j) (L.D j) (L.S (B - 1))] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
      hcS, hcD, hcSt, hsSt, hdSt]
  have hdowns : GatePhysical
      (((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)) := by
    apply gatePhysical_flatMap
    intro i hi
    have hm := List.mem_reverse.mp hi
    simp only [List.mem_map, List.mem_range] at hm
    rcases hm with ⟨r, hr, rfl⟩
    apply adderDown_physical L B _ hn <;> omega
  have hdown : GatePhysical (adderTopDown L B ++
      ((List.range (B - 3)).map (fun r => r + 1)).reverse.flatMap (adderDown L)) := by
    rw [gatePhysical_append]
    exact ⟨adderTopDown_physical L B hB hn, hdowns⟩
  have hD0S0 := (sep_S_rest L B hn hs0 (List.mem_append_left _ hd0)).symm
  have hlast : GatePhysical
      [.CX sig (L.C 0), .measureX (L.C 0) [] [.CZ (L.S 0) (L.D 0)],
       .CX sig (L.D 0), .CX (L.D 0) (L.S 0)] := by
    simp [sig, GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
      hsigC, hsigD, hD0S0]
  have h01 : GatePhysical
      ([.CX sig (L.S 0), .CX sig (L.D 0), .CCX (L.S 0) (L.D 0) (L.C 0),
        .CX sig (L.C 0)] ++
       (List.range (B - 3)).flatMap (fun r => adderMiddle L (r + 1))) := by
    rw [gatePhysical_append]
    exact ⟨hfirst, hmiddle⟩
  have h02 := (gatePhysical_append _ _).mpr ⟨h01, htop⟩
  have h03 := (gatePhysical_append _ _).mpr ⟨h02, hdown⟩
  have h04 := (gatePhysical_append _ _).mpr ⟨h03, hlast⟩
  simpa only [unpackAdder] using h04

private theorem packStep_physical (L : Layout) (B j : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) (hj : j < B - 1) : GatePhysical (packStep L B j) := by
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  have hdj : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have hDzt : L.D j ≠ L.t := sep_D_work L B hn hdj (by simp [workSites])
  have hzt := z_ne_t L B hn
  have h0 : GatePhysical [.CCX (L.D j) L.z L.t] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hDzt, hzt]
  have h1 : GatePhysical (cxInto L.t
      ((List.range nb).filter (fun b => k.testBit b) |>.map L.A)) := by
    apply cxInto_physical
    intro q hq
    simp only [List.mem_map] at hq
    rcases hq with ⟨i, hi, rfl⟩
    have hir := (List.mem_filter.mp hi).1
    have ha : L.A i ∈ reg L.A (bitWidth B) := reg_mem _ _ _ (List.mem_range.mp hir)
    exact (sep_A_rest L B hn ha (by simp)).symm
  have h2 : GatePhysical
      (cxInto L.t (decoderDelta ld (lowBits L B) (k % 2 ^ lo))) := by
    apply cxInto_physical
    intro q hq
    have hm : q ∈ (lowDecoder L B).sites := List.mem_of_mem_filter hq
    exact sep_ZT_decoders L B hn (by simp) (by simp [hm])
  have h3 : GatePhysical
      (cxInto L.t (decoderDelta hd (highBits L B) (k / 2 ^ lo))) := by
    apply cxInto_physical
    intro q hq
    have hm : q ∈ (highDecoder L B).sites := List.mem_of_mem_filter hq
    exact sep_ZT_decoders L B hn (by simp) (by simp [hm])
  have htD : L.t ≠ L.D j := hDzt.symm
  have h4 : GatePhysical [.CX L.t (L.D j)] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, htD]
  have h5 : GatePhysical (if j < B - 2 then
      [.CX (L.S (B - 2 - j)) (L.D j),
       .measureX (L.S (B - 2 - j)) [] [.CZ (L.D j) L.z]] else []) := by
    split_ifs with hjn
    · have hs : L.S (B - 2 - j) ∈ reg L.S B := reg_mem _ _ _ (by omega)
      have hsd := sep_S_rest L B hn hs (List.mem_append_left _ hdj)
      simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hsd]
    · simp [GatePhysical]
  have h6 : GatePhysical
      [.CX L.t L.z,
       .measureX L.t []
         [.CZ (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z)]] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hzt.symm]
  have h01 := (gatePhysical_append _ _).mpr ⟨h0, h1⟩
  have h02 := (gatePhysical_append _ _).mpr ⟨h01, h2⟩
  have h03 := (gatePhysical_append _ _).mpr ⟨h02, h3⟩
  have h04 := (gatePhysical_append _ _).mpr ⟨h03, h4⟩
  have h05 := (gatePhysical_append _ _).mpr ⟨h04, h5⟩
  have h06 := (gatePhysical_append _ _).mpr ⟨h05, h6⟩
  simpa only [packStep] using h06

private theorem unpackStep_physical (L : Layout) (B j : Nat) (hB : 3 ≤ B)
    (hn : L.Nodup B) (hj : j < B - 1) : GatePhysical (unpackStep L B j) := by
  let nb := bitWidth B
  let lo := nb / 2
  let k := j + 1
  let ld := lowDecoder L B
  let hd := highDecoder L B
  have hk : k < B := by dsimp only [k]; omega
  have hib := decoder_index_bounds L B k hB hk
  have hhot : outAt hd (k / 2 ^ lo) L.z ≠ L.t := by
    exact high_output_ne_t L B _ hn (by simpa only [hd, lo] using hib.2)
  have hlot : outAt ld (k % 2 ^ lo) L.z ≠ L.t := by
    exact low_output_ne_t L B _ hn (by simpa only [ld, lo] using hib.1)
  have hzt := z_ne_t L B hn
  have h0 : GatePhysical
      [.CCX (outAt hd (k / 2 ^ lo) L.z) (outAt ld (k % 2 ^ lo) L.z) L.t,
       .CX L.t L.z] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hhot, hlot, hzt.symm]
  have hdj : L.D j ∈ reg L.D B := reg_mem _ _ _ (by omega)
  have h1 : GatePhysical (if j < B - 2 then
      [.CCX (L.D j) L.z (L.S (B - 2 - j)),
       .CX (L.S (B - 2 - j)) (L.D j)] else []) := by
    split_ifs with hjn
    · have hs : L.S (B - 2 - j) ∈ reg L.S B := reg_mem _ _ _ (by omega)
      have hsd := sep_S_rest L B hn hs (List.mem_append_left _ hdj)
      have hzwork : L.z ∈ workSites L B := by simp [workSites]
      have hsz := sep_S_rest L B hn hs (List.mem_append_right _ hzwork)
      simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate,
        hsd, hsd.symm, hsz.symm]
    · simp [GatePhysical]
  have hDzt : L.D j ≠ L.t := sep_D_work L B hn hdj (by simp [workSites])
  have h2 : GatePhysical [.CX L.t (L.D j)] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr, ProperGate, hDzt.symm]
  have h3 : GatePhysical
      (cxInto L.t (decoderDelta ld (lowBits L B) (k % 2 ^ lo))) := by
    apply cxInto_physical
    intro q hq
    have hm : q ∈ (lowDecoder L B).sites := List.mem_of_mem_filter hq
    exact sep_ZT_decoders L B hn (by simp) (by simp [hm])
  have h4 : GatePhysical
      (cxInto L.t (decoderDelta hd (highBits L B) (k / 2 ^ lo))) := by
    apply cxInto_physical
    intro q hq
    have hm : q ∈ (highDecoder L B).sites := List.mem_of_mem_filter hq
    exact sep_ZT_decoders L B hn (by simp) (by simp [hm])
  have h5 : GatePhysical (cxInto L.t
      ((List.range nb).filter (fun b => k.testBit b) |>.map L.A)) := by
    apply cxInto_physical
    intro q hq
    simp only [List.mem_map] at hq
    rcases hq with ⟨i, hi, rfl⟩
    have hir := (List.mem_filter.mp hi).1
    have ha : L.A i ∈ reg L.A (bitWidth B) := reg_mem _ _ _ (List.mem_range.mp hir)
    exact (sep_A_rest L B hn ha (by simp)).symm
  have h6 : GatePhysical [.measureX L.t [] [.CZ (L.D j) L.z]] := by
    simp [GatePhysical, RecordedQuantum.PhysicalInstr]
  have h01 := (gatePhysical_append _ _).mpr ⟨h0, h1⟩
  have h02 := (gatePhysical_append _ _).mpr ⟨h01, h2⟩
  have h03 := (gatePhysical_append _ _).mpr ⟨h02, h3⟩
  have h04 := (gatePhysical_append _ _).mpr ⟨h03, h4⟩
  have h05 := (gatePhysical_append _ _).mpr ⟨h04, h5⟩
  have h06 := (gatePhysical_append _ _).mpr ⟨h05, h6⟩
  simpa only [unpackStep] using h06

/-- Every wire touched by the packing circuit belongs to its declared pool. -/
theorem pack_support (L : Layout) (B : Nat) (hB : 3 ≤ B) :
    wires (pack L B) ⊆ (declaredSites L B).toFinset := by
  let ld := lowDecoder L B
  let hd := highDecoder L B
  have hsig := declared_D L B (B - 1) (by omega)
  have hs0 := declared_S L B 0 (by omega)
  have hz := declared_z L B
  have hp0 := cxInto_declared L B (L.D (B - 1)) (reg L.D (B - 1)) hsig (by
    intro q hq
    simp only [reg, List.mem_map, List.mem_range] at hq
    rcases hq with ⟨i, hi, rfl⟩
    exact declared_D L B i (by omega))
  have hp1 := xOn_declared L B (reg L.S B) (by
    intro q hq
    simp only [reg, List.mem_map, List.mem_range] at hq
    rcases hq with ⟨i, hi, rfl⟩
    exact declared_S L B i hi)
  have hp2 := packAdder_support L B hB
  have hp3 := hp1
  have hp4 : wires [.X (L.S 0)] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_singleton,
      Finset.notMem_empty, or_false] at hq
    simpa [hq] using hs0
  have hp5 : wires [.X L.z] ⊆ (declaredSites L B).toFinset := by
    intro q hq
    simp only [wires, Instr.wires, Finset.mem_union, Finset.mem_singleton,
      Finset.notMem_empty, or_false] at hq
    simpa [hq] using hz
  have hp6 := decoderInit_declared_low L B
  have hp7 := decoderInit_declared_high L B
  have hp8 := (packFirstStep_support L B).trans
    (packStep_support L B (B - 2) (by omega))
  have hp9 : wires ((List.range (B - 2)).reverse.flatMap (packStep L B)) ⊆
      (declaredSites L B).toFinset := by
    apply wires_flatMap_subset
    intro j hj
    apply packStep_support
    have hj' := List.mem_range.mp (List.mem_reverse.mp hj)
    omega
  have hp10 : wires
      [.measureX L.z [] [.CZ (outAt hd 0 L.z) (outAt ld 0 L.z)]] ⊆
      (declaredSites L B).toFinset := by
    have hho := outAt_declared_high L B 0
    have hlo := outAt_declared_low L B 0
    intro q hq
    simp only [wires, Instr.wires, correctionWires, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, Finset.notMem_empty, or_false] at hq
    aesop
  have hp11 := highDecoder_erase_declared L B
  have hp12 := lowDecoder_erase_declared L B
  have hp01 := support_append hp0 hp1
  have hp02 := support_append hp01 hp2
