theorem headFirstBase_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord j origin X Y) (headFirstBase j)
      (fun state => let V := directionalPayload false (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame P1Life.oddWord P1Life.oddWord (j+1) origin V.1 V.2 state) := by
  have nonzero : j≠0 := by omega
  intro state records input
  apply cut_window_frame centerWord centerWord P1Life.oddWord P1Life.oddWord j (j+1) j hj origin X Y _ _ (headFirstBase j)
    (otherEncodeCut_step base j 102)
    (otherEncodeCut_body_disjoint j j hj origin ctx _
      (headFirstBase_read_support j hj)) _ state records input
  intro current tape frame
  have normalized : CodeFrame centerWord centerWord (codeEncodeAt true (History5.historyMap base (5*j)))
      origin X Y current := by
    simpa [encodeGroup,nonzero,show ¬j+1≤j from by omega] using frame
  have result := headFirstBase_frame j hj origin ctx enabled X Y current tape normalized
  simpa [regularPayload_eq true j hj origin enabled,encodeGroup,nonzero,
    show ¬j+1≤j from by omega] using result

theorem headLastBase_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame P1Life.oddWord P1Life.oddWord j origin X Y) (headLastBase j)
      (fun state => let V := directionalPayload false (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame centerWord centerWord (j+1) origin V.1 V.2 state) := by
  have nonzero : j≠0 := by omega
  intro state records input
  apply cut_window_frame P1Life.oddWord P1Life.oddWord centerWord centerWord j (j+1) j hj origin X Y _ _ (headLastBase j)
    (otherEncodeCut_step base j 102)
    (otherEncodeCut_body_disjoint j j hj origin ctx _
      (headLastBase_read_support j hj)) _ state records input
  intro current tape frame
  have normalized : CodeFrame P1Life.oddWord P1Life.oddWord (codeEncodeAt true (History5.historyMap base (5*j)))
      origin X Y current := by
    simpa [encodeGroup,nonzero,show ¬j+1≤j from by omega] using frame
  have result := headLastBase_frame j hj origin ctx enabled X Y current tape normalized
  simpa [regularPayload_eq true j hj origin enabled,encodeGroup,nonzero,
    show ¬j+1≤j from by omega] using result

theorem headFirstPacket_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord j origin X Y) (headFirstPacket j)
      (fun state => let V := directionalPayload false (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame P1Life.oddWord P1Life.oddWord (j+1) origin V.1 V.2 state) := by
  intro state records input
  have raw := headFirstBase_cut_frame j first hj origin ctx enabled X Y state records input
  have same := Replay5.placed_eq (Placement5.pi j) (headFirstBase j)
    (fun q hq => Placement5.pi_outside j q hj hq) state records
    (cutFrame_zero_region centerWord centerWord _ origin ctx X Y state input)
    (cutFrame_zero_region P1Life.oddWord P1Life.oddWord _ origin ctx _ _ _ raw.2)
  change run (headFirstPacket j) records state=run (headFirstBase j) records state at same
  rw [same]
  exact raw

theorem headLastPacket_cut_frame (j : Nat) (first : 1 ≤ j) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame P1Life.oddWord P1Life.oddWord j origin X Y) (headLastPacket j)
      (fun state => let V := directionalPayload false (mixedTranscriptControls origin (base 2400) (Replay5.letters j)) (X,Y)
        CutFrame centerWord centerWord (j+1) origin V.1 V.2 state) := by
  intro state records input
  have raw := headLastBase_cut_frame j first hj origin ctx enabled X Y state records input
  have same := Replay5.placed_eq (Placement5.pi j) (headLastBase j)
    (fun q hq => Placement5.pi_outside j q hj hq) state records
    (cutFrame_zero_region P1Life.oddWord P1Life.oddWord _ origin ctx X Y state input)
    (cutFrame_zero_region centerWord centerWord _ origin ctx _ _ _ raw.2)
  change run (headLastPacket j) records state=run (headLastBase j) records state at same
  rw [same]
  exact raw

/-- The odd-word head has the cut frame of the record packets `1 .. 84`. -/
theorem oddHead_cut_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple (CutFrame centerWord centerWord 1 origin X Y) oddHead
      (fun state => let V := Replay5.groupsPayload true origin 1 84 (X,Y)
        CutFrame centerWord centerWord 85 origin V.1 V.2 state) := by
  let step := fun k (V : Fp×Fp) =>
    directionalPayload false (mixedTranscriptControls origin (base 2400) (Replay5.letters k)) V
  have head := headFirstPacket_cut_frame 1 (by decide) (by decide) origin ctx enabled X Y
  have middle := groups_cut_frame true 2 82 (by decide) (by decide) origin ctx enabled
    (step 1 (X,Y)).1 (step 1 (X,Y)).2
  have last := headLastPacket_cut_frame 84 (by decide) (by decide) origin ctx enabled
    (Replay5.groupsPayload true origin 2 82 (step 1 (X,Y))).1
    (Replay5.groupsPayload true origin 2 82 (step 1 (X,Y))).2
  have whole := head.seq (middle.seq last)
  have unfoldPayload : Replay5.groupsPayload true origin 1 84 (X,Y)=
      step 84 (Replay5.groupsPayload true origin 2 82 (step 1 (X,Y))) := by
    have snoc := route_payload_snoc step 1 83 (X,Y)
    have headStep : PacketSequence.payload true step 1 83 (X,Y)=
        PacketSequence.payload true step 2 82 (step 1 (X,Y)) := by
      rw [show (83:Nat)=82+1 from rfl,PacketSequence.payload,if_pos rfl]
    simpa only [Replay5.groupsPayload,Bool.not_true,Prod.mk.eta,headStep,
      show (1:Nat)+83=84 from rfl,show (83:Nat)+1=84 from rfl] using snoc
  intro state records input
  have result := whole state records input
  refine ⟨result.1,?_⟩
  simpa only [oddHead,if_true,unfoldPayload,Prod.mk.eta,step,
    show (2:Nat)+82=84 from rfl,show (84:Nat)+1=85 from rfl,show (1:Nat)+1=2 from rfl] using result.2

end ECDSAAdd.Entrant.RouteA.Rolling1588
