private theorem move_support_erase760 (d : Nat) (host : Wire) (P Q : Program)
    (support : wires P ⊆ wires Q \ (retiredRoles.take d).toFinset)
    (fixed : ∀ r ∈ retiredRoles, Equiv.swap (base 760) host r = r) :
    wires (Q6LifetimeResearch.move (base 760) host P) ⊆
      wires (Q6LifetimeResearch.move (base 760) host Q) \
        (retiredRoles.take d).toFinset := by
  simpa only [Q6LifetimeResearch.move] using
    renameProgram_support_erase (retiredRoles.take d).toFinset
      (Equiv.swap (base 760) host) P Q support
      (swap_roleBack_of_fixed d host fixed)

theorem rawAddLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (rawAddLoan d L760) ⊆
      wires (rawAddLoan 0 L760) \ (retiredRoles.take d).toFinset := by
  have inner := rawAddInnerLoan_support760 d hd
  have inner0 : wires (addPrefixLoan d retiredRoles (L760.ylow.drop 1)
      (L760.low.drop 1) q6Tail760 L760.ymsb L760.rmsb L760.one q6Head760) ⊆
      wires (addPrefixLoan 0 retiredRoles (L760.ylow.drop 1)
        (L760.low.drop 1) q6Tail760 L760.ymsb L760.rmsb L760.one q6Head760) \
        (retiredRoles.take d).toFinset := by
    rw [addPrefixLoan_zero]
    exact inner
  have moved := move_support_erase760 d rawB760 _ _ inner0 rawSwap760_fixed
  have framed := framed_support_erase (retiredRoles.take d).toFinset
    rawAddPre760 _ _ rawAddPost760 moved
    (rawAddPre760_away d hd) (rawAddPost760_away d hd)
  simpa only [rawAddLoan, rawAddPre760, rawAddPost760, rawClear760,
    rawA760, rawB760, q6Tail760, q6Head760, q6Carry760,
    List.append_assoc] using framed

theorem foldLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (foldLoan d L760) ⊆
      wires (foldLoan 0 L760) \ (retiredRoles.take d).toFinset := by
  have inner := foldMappedLoan_supportExact760 d hd
  have inner0 : wires (mappedAddLoan d retiredRoles foldBits760 L760.low
      foldCarry760 L760.one) ⊆
      wires (mappedAddLoan 0 retiredRoles foldBits760 L760.low
        foldCarry760 L760.one) \ (retiredRoles.take d).toFinset := by
    rw [mappedAddLoan_zero]
    exact inner
  have moved := move_support_erase760 d L760.rmsb _ _ inner0 foldSwap760_fixed
  have framed := framed_support_erase (retiredRoles.take d).toFinset
    foldPre760 _ _ foldPost760 moved
    (foldPre760_away d hd) (foldPost760_away d hd)
  simpa only [foldLoan, foldPre760, foldPost760, foldBits760, foldCarry760,
    List.append_assoc] using framed

theorem unfoldLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (unfoldLoan d L760) ⊆
