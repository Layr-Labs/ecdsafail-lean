 s.basis (L.R (32+j.val))=phaseValue (highCorrections L j.val) s.basis := by
 rw [rs (32+j.val) (by have h:=j.isLt;omega),high_correction_value L s.basis j,
  highPhysical_eq L ref s src rs a0]
