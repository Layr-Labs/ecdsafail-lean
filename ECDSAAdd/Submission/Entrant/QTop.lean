/-! ## K4C (replay budget): role avoidance and `Nodup` on bit masks

`r ∉ l.toFinset` for 68 roles was a quadratic `List.dedup` plus 68 list scans, and the
`Nodup` facts were quadratic scans; both are now one linear mask evaluation. -/

private theorem k4c_away (R l : List Wire)
    (h : R.all (fun r => !(maskOf l).testBit r) = true) : ∀ r ∈ R, r ∉ l := by
  intro r hr hm
  have t := List.all_eq_true.mp h r hr
  rw [testBit_maskOf] at t
  simp [hm] at t

private theorem k4c_away_fs (R l : List Wire)
    (h : R.all (fun r => !(maskOf l).testBit r) = true) : ∀ r ∈ R, r ∉ l.toFinset := by
  intro r hr hm
  exact k4c_away R l h r hr (List.mem_toFinset.mp hm)



theorem emitErases_append (xs ys : List CarryLayer) :
    emitErases (xs ++ ys) = emitErases ys ++ emitErases xs := by
  induction xs with
  | nil => simp [emitErases]
  | cons x xs ih => simp [emitErases, ih, List.append_assoc]

theorem emitUps_take_support (n : Nat) (ls : List CarryLayer) :
    wires (emitUps (ls.take n)) ⊆ wires (emitUps ls) := by
  calc
    wires (emitUps (ls.take n)) ⊆
        wires (emitUps (ls.take n) ++ emitUps (ls.drop n)) := by
      rw [wires_append]
      intro q hq
      exact Finset.mem_union_left _ hq
    _ = wires (emitUps ls) := congrArg wires (by
      rw [← emitUps_append, List.take_append_drop])

theorem emitErases_take_support (n : Nat) (ls : List CarryLayer) :
    wires (emitErases (ls.take n)) ⊆ wires (emitErases ls) := by
  calc
    wires (emitErases (ls.take n)) ⊆
        wires (emitErases (ls.drop n) ++ emitErases (ls.take n)) := by
      rw [wires_append]
      intro q hq
      exact Finset.mem_union_right _ hq
    _ = wires (emitErases ls) := congrArg wires (by
      rw [← emitErases_append, List.take_append_drop])

theorem emitDowns_take_support (n : Nat) (ls : List CarryLayer) :
    wires (emitDowns (ls.take n)) ⊆ wires (emitDowns ls) := by
  calc
    wires (emitDowns (ls.take n)) ⊆
        wires (emitDowns (ls.drop n) ++ emitDowns (ls.take n)) := by
      rw [wires_append]
      intro q hq
      exact Finset.mem_union_right _ hq
    _ = wires (emitDowns ls) := congrArg wires (by
      rw [← emitDowns_append, List.take_append_drop])

theorem emitErases_support_downs (ls : List CarryLayer) :
    wires (emitErases ls) ⊆ wires (emitDowns ls) := by
  induction ls with
  | nil => simp [emitErases, emitDowns, wires]
  | cons l ls ih =>
      simp only [emitErases, emitDowns, CarryLayer.down, wires_append]
      intro q hq
      rcases Finset.mem_union.mp hq with hq | hq
      · exact Finset.mem_union_left _ (ih hq)
      · exact Finset.mem_union_right _ (Finset.mem_union_left _ hq)

theorem emitSweep_drop_support (n : Nat) (ls : List CarryLayer) (top : Program) :
    wires (emitSweep (ls.drop n) top) ⊆ wires (emitSweep ls top) := by
  calc
    wires (emitSweep (ls.drop n) top) ⊆
        wires (emitUps (ls.take n) ++ emitSweep (ls.drop n) top ++
          emitDowns (ls.take n)) := by
      simp only [wires_append]
      intro q hq
      exact Finset.mem_union_left _ (Finset.mem_union_right _ hq)
    _ = wires (emitSweep ls top) := congrArg wires (emitSweep_split n ls top).symm

theorem rebindMany_support_loose (roles hosts : List Wire) (P : Program) :
    wires (rebindMany roles hosts P) ⊆
      (wires P ∪ roles.toFinset) ∪ hosts.toFinset := by
  intro q hq
  by_cases old : q ∈ wires P
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ old)
  by_cases role : q ∈ roles
  · exact Finset.mem_union_left _ (Finset.mem_union_right _ (by simpa using role))
  by_cases host : q ∈ hosts
  · exact Finset.mem_union_right _ (by simpa using host)
  exact False.elim
    (rebindMany_preserves_fresh roles hosts P q (by simp [role, host]) old hq)

/-- No instruction-level expansion is needed for this envelope.  The only
possible additions to the old sweep are the renamed logical roles and the
borrowed carry hosts. -/
theorem emitLoan_support_envelope (d : Nat) (roles : List Wire)
    (ls : List CarryLayer) (top : Program) :
    wires (emitLoan d roles ls top) ⊆
      (wires (emitSweep ls top) ∪ (roles.take d).toFinset) ∪
        (layerHosts (ls.take d)).toFinset := by
  let boundary := ls.take (d + 1)
  let borrowed := ls.take d
  have upBoundary : wires (emitUps boundary) ⊆ wires (emitSweep ls top) := by
    exact (emitUps_take_support (d + 1) ls).trans (by
      intro q hq
      simp only [emitSweep, wires_append, Finset.mem_union]
      tauto)
  have eraseBorrowed : wires (emitErases borrowed) ⊆ wires (emitSweep ls top) := by
    exact (emitErases_take_support d ls |>.trans (emitErases_support_downs ls)).trans (by
      intro q hq
      simp only [emitSweep, wires_append, Finset.mem_union]
      tauto)
  have upper : wires (emitSweep (ls.drop (d + 1)) top) ⊆
      wires (emitSweep ls top) := emitSweep_drop_support (d + 1) ls top
  have rebound := rebindMany_support_loose (roles.take d)
    (layerHosts borrowed) (emitSweep (ls.drop (d + 1)) top)
  have rebound' : wires (rebindMany (roles.take d) (layerHosts borrowed)
      (emitSweep (ls.drop (d + 1)) top)) ⊆
      (wires (emitSweep ls top) ∪ (roles.take d).toFinset) ∪
        (layerHosts borrowed).toFinset := by
    intro q hq
    rcases Finset.mem_union.mp (rebound hq) with hq | hq
    · rcases Finset.mem_union.mp hq with hq | hq
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ (upper hq))
      · exact Finset.mem_union_left _ (Finset.mem_union_right _ hq)
    · exact Finset.mem_union_right _ hq
  have upBorrowed : wires (emitUps borrowed) ⊆ wires (emitSweep ls top) := by
    exact (emitUps_take_support d ls).trans (by
      intro q hq
      simp only [emitSweep, wires_append, Finset.mem_union]
      tauto)
  have downBoundary : wires (emitDowns boundary) ⊆ wires (emitSweep ls top) := by
    exact (emitDowns_take_support (d + 1) ls).trans (by
      intro q hq
      simp only [emitSweep, wires_append, Finset.mem_union]
      tauto)
  intro q hq
  simp only [emitLoan, boundary, borrowed, wires_append, Finset.mem_union] at hq
  rcases hq with (((up | erase) | moved) | recompute) | down
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ (upBoundary up))
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ (eraseBorrowed erase))
  · exact rebound' moved
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ (upBorrowed recompute))
  · exact Finset.mem_union_left _ (Finset.mem_union_left _ (downBoundary down))

/-- Conditional exact support form.  `outsideFree` is small: it concerns only
the first `d+1` layers, while `hostFree` concerns only the dropped upper sweep.
Concrete component lemmas discharge both from their layout nodup facts. -/
theorem emitLoan_support_erase (d : Nat) (roles : List Wire)
    (ls : List CarryLayer) (top : Program)
    (len : (roles.take d).length = (layerHosts (ls.take d)).length)
    (nd : (roles.take d ++ layerHosts (ls.take d)).Nodup)
    (hostFree : ∀ h ∈ layerHosts (ls.take d),
      h ∉ wires (emitSweep (ls.drop (d + 1)) top))
    (outsideFree : ∀ r ∈ roles.take d,
      r ∉ wires (emitUps (ls.take (d + 1)) ++ emitErases (ls.take d) ++
        emitUps (ls.take d) ++ emitDowns (ls.take (d + 1)))) :
    wires (emitLoan d roles ls top) ⊆
      (wires (emitSweep ls top) \ (roles.take d).toFinset) ∪
        (layerHosts (ls.take d)).toFinset := by
  have reboundFree := rebindMany_roles_free (roles.take d)
    (layerHosts (ls.take d)) (emitSweep (ls.drop (d + 1)) top)
    len nd hostFree
  have loanFree : ∀ r ∈ roles.take d, r ∉ wires (emitLoan d roles ls top) := by
    intro r hr used
    simp only [emitLoan, wires_append, Finset.mem_union] at used
    rcases used with (((up | erase) | rebound) | recompute) | down
    · exact outsideFree r hr (by
        simp only [wires_append, Finset.mem_union]
        tauto)
    · exact outsideFree r hr (by
        simp only [wires_append, Finset.mem_union]
        tauto)
    · exact reboundFree r hr rebound
    · exact outsideFree r hr (by
        simp only [wires_append, Finset.mem_union]
        tauto)
    · exact outsideFree r hr (by
        simp only [wires_append, Finset.mem_union]
        tauto)
  have envelope := emitLoan_support_envelope d roles ls top
  intro q hq
  have loanUsed := hq
  rcases Finset.mem_union.mp (envelope hq) with support | host
  · rcases Finset.mem_union.mp support with old | role
    · exact Finset.mem_union_left _
        (Finset.mem_sdiff.mpr ⟨old, fun h => loanFree q (by simpa using h) loanUsed⟩)
    · exact False.elim (loanFree q (by simpa using role) loanUsed)
  · exact Finset.mem_union_right _ host

/-- The first `n` mapped layers touch only the corresponding data/carry
prefix.  This is the small structural fact used to show that high retired
roles are absent from every non-rebound part of a mapped loan. -/
theorem mapped_prefix_support (n : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length) :
    let D := (mappedWires (bits.take n) ++ ys.take n ++ cs.take n ++ [cin]).toFinset
    wires (emitUps ((mappedLayers bits ys cs cin).take n)) ⊆ D ∧
      wires (emitErases ((mappedLayers bits ys cs cin).take n)) ⊆ D ∧
      wires (emitDowns ((mappedLayers bits ys cs cin).take n)) ⊆ D := by
  induction n generalizing bits ys cs cin with
  | zero => simp [emitUps, emitErases, emitDowns, wires]
  | succ n ih =>
      cases bits with
      | nil =>
          have ye : ys = [] := List.eq_nil_of_length_eq_zero hb.symm
          subst ys
          simp at hc
      | cons b bits =>
          cases bits with
          | nil =>
              have yl : ys.length = 1 := by simpa using hb.symm
              have ce : cs = [] := List.eq_nil_of_length_eq_zero (by omega)
              subst cs
              cases ys with
              | nil => simp at yl
              | cons y ys =>
                  have ye : ys = [] := List.eq_nil_of_length_eq_zero (by simpa using yl)
                  subst ys
                  simp [mappedLayers, emitUps, emitErases, emitDowns, wires]
          | cons b' bits =>
              cases ys with
              | nil => simp at hb
              | cons y ys =>
                  cases ys with
                  | nil => simp at hb
                  | cons y' ys =>
                      cases cs with
                      | nil => simp at hc
                      | cons c cs =>
                          have tail := ih (b'::bits) (y'::ys) cs c
                            (by simpa using hb) (by simpa using hc)
                          let D := (mappedWires ((b::b'::bits).take (n+1)) ++
                            (y::y'::ys).take (n+1) ++ (c::cs).take (n+1) ++
                            [cin]).toFinset
                          have liftTail :
                              (mappedWires ((b'::bits).take n) ++
                                (y'::ys).take n ++ cs.take n ++ [c]).toFinset ⊆ D := by
                            intro q hq
                            simp only [D, List.take_succ_cons, mappedWires,
                              List.flatMap_cons, List.mem_toFinset, List.mem_append,
                              List.mem_cons, List.not_mem_nil, or_false] at hq ⊢
                            tauto
                          have bit := mappedBit_wires b y cin c
                          have liftHead (q : Wire)
                              (hq : q ∈ (b.wire.toList ++ [y,cin,c]).toFinset) : q ∈ D := by
                            simp only [D, List.take_succ_cons, mappedWires,
                              List.flatMap_cons, List.mem_toFinset, List.mem_append,
                              List.mem_cons, List.not_mem_nil, or_false] at hq ⊢
                            tauto
                          have upHead : wires (mappedMajority b y cin c) ⊆ D :=
                            bit.1.trans liftHead
                          have eraseHead : wires (mappedEraseCarry b y cin c) ⊆ D :=
                            bit.2.1.trans liftHead
                          have finishHead : wires (mappedSum b y cin) ⊆ D := by
                            exact bit.2.2.trans (by
                              intro q hq
                              apply liftHead q
                              simp only [List.mem_toFinset, List.mem_append,
                                List.mem_cons, List.not_mem_nil, or_false] at hq ⊢
                              tauto)
                          have upTail := tail.1.trans liftTail
                          have eraseTail := tail.2.1.trans liftTail
                          have downTail := tail.2.2.trans liftTail
                          simp only [mappedLayers, List.take_succ_cons, emitUps,
                            emitErases, emitDowns, CarryLayer.down, wires_append]
                          exact ⟨Finset.union_subset upHead upTail,
                            Finset.union_subset eraseTail eraseHead,
                            Finset.union_subset downTail
                              (Finset.union_subset eraseHead finishHead)⟩

private theorem mappedWires_drop_subset (n : Nat) (bits : List MappedBit) :
    ∀ q ∈ mappedWires (bits.drop n), q ∈ mappedWires bits := by
  intro q hq
  simp only [mappedWires, List.mem_flatMap] at hq ⊢
  obtain ⟨b, hb, hq⟩ := hq
  exact ⟨b, List.mem_of_mem_drop hb, hq⟩

private theorem mappedWires_take_mono (n m : Nat) (bits : List MappedBit)
    (hnm : n ≤ m) : ∀ q ∈ mappedWires (bits.take n),
      q ∈ mappedWires (bits.take m) := by
  intro q hq
  simp only [mappedWires, List.mem_flatMap] at hq ⊢
  obtain ⟨b, hb, hq⟩ := hq
  exact ⟨b, List.take_subset_take_left bits hnm hb, hq⟩

private theorem carryAfter_succ_mem_drop (n : Nat) (cs : List Wire) (cin : Wire)
    (hn : n < cs.length) : carryAfter (n + 1) cs cin ∈ cs.drop n := by
  induction n generalizing cs cin with
  | zero =>
      cases cs with
      | nil => simp at hn
      | cons c cs => simp [carryAfter]
  | succ n ih =>
      cases cs with
      | nil => simp at hn
      | cons c cs =>
          simp only [List.length_cons] at hn
          simpa only [Nat.succ_eq_add_one, List.drop_succ_cons, carryAfter] using
            ih cs c (by omega)

private theorem nodup_take_away_drop (xs : List Wire) (d : Nat)
    (nd : xs.Nodup) (q : Wire) (hq : q ∈ xs.take d) : q ∉ xs.drop d := by
  rw [← List.take_append_drop d xs] at nd
  exact List.disjoint_left.mp (List.nodup_append'.mp nd).2.2 hq

theorem mapped_upper_hosts_free (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d + 1 ≤ cs.length) (nd : (cin::(ys++cs)).Nodup)
    (away : ∀ q ∈ mappedWires bits, q ∉ cin::(ys++cs)) :
    ∀ h ∈ cs.take d,
      h ∉ wires (emitSweep ((mappedLayers bits ys cs cin).drop (d + 1))
        (mappedTop bits ys cs cin)) := by
  intro h hh used
  rw [mapped_upper_sweep (d + 1) bits ys cs cin hb hc hd] at used
  have support := mappedAdd_wires_subset (bits.drop (d + 1))
    (ys.drop (d + 1)) (cs.drop (d + 1)) (carryAfter (d + 1) cs cin) used
  have hcs : h ∈ cs := List.mem_of_mem_take hh
  have tailND : (ys++cs).Nodup := (List.nodup_cons.mp nd).2
  have csND : cs.Nodup := (List.nodup_append'.mp tailND).2.1
  have hneCin : h ≠ cin := by
    intro e
    exact (List.nodup_cons.mp nd).1
      (List.mem_append_right ys (e ▸ hcs))
  have hneYs : h ∉ ys := by
    exact fun hy => List.disjoint_left.mp (List.nodup_append'.mp tailND).2.2 hy hcs
  have hneDrop : h ∉ cs.drop (d + 1) := by
    intro hdrop
    have hdrop' : h ∈ cs.drop d := by
      have htail : h ∈ (cs.drop d).drop 1 := by
        simpa only [List.drop_drop, Nat.add_comm, Nat.add_left_comm,
          Nat.add_assoc] using hdrop
      exact List.mem_of_mem_drop htail
    exact nodup_take_away_drop cs d csND h hh hdrop'
  have hneCarry : h ≠ carryAfter (d + 1) cs cin := by
    intro e
    have carryMem := carryAfter_succ_mem_drop d cs cin (by omega)
    exact nodup_take_away_drop cs d csND h hh (e ▸ carryMem)
  simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at support
  rcases support with ((source | target) | carry) | input
  · exact away h (mappedWires_drop_subset (d + 1) bits h source) (by simp [hcs])
  · exact hneYs (List.mem_of_mem_drop target)
  · exact hneDrop carry
  · exact hneCarry input

/-- Exact mapped-sweep lifting.  The right union names the physical carry
hosts explicitly; callers may absorb it into the old support when desired. -/
theorem mappedAddLoan_support_lift (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d + 1 ≤ cs.length) (hr : d ≤ roles.length)
    (nd : (cin::(ys++cs)).Nodup)
    (away : ∀ q ∈ mappedWires bits, q ∉ cin::(ys++cs))
    (banks : (roles.take d ++ cs.take d).Nodup)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    wires (mappedAddLoan d roles bits ys cs cin) ⊆
      (wires (mappedAdd bits ys cs cin) \ (roles.take d).toFinset) ∪
        (cs.take d).toFinset := by
  have hosts := layerHosts_mapped_take d bits ys cs cin hb hc
  have len : (roles.take d).length =
      (layerHosts ((mappedLayers bits ys cs cin).take d)).length := by
    rw [hosts, List.length_take, List.length_take]
    omega
  have hostFree : ∀ h ∈ layerHosts ((mappedLayers bits ys cs cin).take d),
      h ∉ wires (emitSweep ((mappedLayers bits ys cs cin).drop (d + 1))
        (mappedTop bits ys cs cin)) := by
    rw [hosts]
    exact mapped_upper_hosts_free d bits ys cs cin hb hc hd nd away
  have outsideFree : ∀ r ∈ roles.take d,
      r ∉ wires (emitUps ((mappedLayers bits ys cs cin).take (d + 1)) ++
        emitErases ((mappedLayers bits ys cs cin).take d) ++
        emitUps ((mappedLayers bits ys cs cin).take d) ++
        emitDowns ((mappedLayers bits ys cs cin).take (d + 1))) := by
    intro r rr used
    have large := mapped_prefix_support (d + 1) bits ys cs cin hb hc
    have small := mapped_prefix_support d bits ys cs cin hb hc
    have liftSmall :
        (mappedWires (bits.take d) ++ ys.take d ++ cs.take d ++ [cin]).toFinset ⊆
          (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
            cs.take (d + 1) ++ [cin]).toFinset := by
      intro q hq
      simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
        List.not_mem_nil, or_false] at hq ⊢
      rcases hq with ((source | target) | carry) | input
      · have h := mappedWires_take_mono d (d + 1) bits (by omega) q source
        tauto
      · have h := List.take_subset_take_left ys (by omega : d ≤ d + 1) target
        tauto
      · have h := List.take_subset_take_left cs (by omega : d ≤ d + 1) carry
        tauto
      · tauto
    simp only [wires_append, Finset.mem_union] at used
    rcases used with ((up | erase) | recompute) | down
    · exact roleAway r rr (large.1 up)
    · exact roleAway r rr (liftSmall (small.2.1 erase))
    · exact roleAway r rr (liftSmall (small.1 recompute))
    · exact roleAway r rr (large.2.2 down)
  have support := emitLoan_support_erase d roles
    (mappedLayers bits ys cs cin) (mappedTop bits ys cs cin)
    len (by simpa only [hosts] using banks) hostFree outsideFree
  rw [← mappedAdd_as_sweep, hosts] at support
  exact support

theorem mappedSubLoan_support_lift (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d + 1 ≤ cs.length) (hr : d ≤ roles.length)
    (nd : (cin::(ys++cs)).Nodup)
    (away : ∀ q ∈ mappedWires bits, q ∉ cin::(ys++cs))
    (banks : (roles.take d ++ cs.take d).Nodup)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset)
    (roleAwayYs : ∀ r ∈ roles.take d, r ∉ ys) :
    wires (mappedSubLoan d roles bits ys cs cin) ⊆
      (wires (mappedSub bits ys cs cin) \ (roles.take d).toFinset) ∪
        (cs.take d).toFinset := by
  have add := mappedAddLoan_support_lift d roles bits ys cs cin hb hc hd hr
    nd away banks roleAway
  intro q hq
  simp only [mappedSubLoan, wires_append, Finset.mem_union] at hq
  rcases hq with (left | middle) | right
  · have qy : q ∈ ys := by simpa only [notRegister_wires, List.mem_toFinset] using left
    apply Finset.mem_union_left
    apply Finset.mem_sdiff.mpr
    constructor
    · simp only [mappedSub, wires_append, Finset.mem_union]
      exact Or.inl (Or.inl left)
    · intro qr
      exact roleAwayYs q (by simpa using qr) qy
  · rcases Finset.mem_union.mp (add middle) with old | host
    · apply Finset.mem_union_left
      apply Finset.mem_sdiff.mpr
      exact ⟨by
        simp only [mappedSub, wires_append, Finset.mem_union]
        exact Or.inl (Or.inr (Finset.mem_sdiff.mp old).1), (Finset.mem_sdiff.mp old).2⟩
    · exact Finset.mem_union_right _ host
  · have qy : q ∈ ys := by simpa only [notRegister_wires, List.mem_toFinset] using right
    apply Finset.mem_union_left
    apply Finset.mem_sdiff.mpr
    constructor
    · simp only [mappedSub, wires_append, Finset.mem_union]
      exact Or.inr right
    · intro qr
      exact roleAwayYs q (by simpa using qr) qy

abbrev L760 : BalancedCircuit.Layout :=
  Q6EndpointCell.ports base (base 2409)

private theorem L760_nodup : L760.wires.Nodup := by
  exact Q6EndpointCell.ports_nodup_injective base (base 2409) base_injective (by
    intro member
    obtain ⟨i, hi, eq⟩ := List.mem_map.mp member
    have same := base_injective eq
    have bound := Q6EndpointCell.ids_bound i hi
    omega)

private theorem L760_cleanup_nodup : L760.toLayout.wires.Nodup := by
  exact (List.nodup_append'.mp L760_nodup).2.1

abbrev foldBits760 : List MappedBit := ShortBiasedFold.lowBits L760
abbrev foldCarry760 : List Wire := L760.carry.take 254

private theorem foldBits760_length : foldBits760.length = 255 := by
  exact ShortBiasedFold.lowBits_length L760

private theorem foldLow760_length : L760.low.length = 255 := by
  exact (BalancedCleanup.widths L760.toLayout
    (Q6EndpointCell.ports_widths base (base 2409))).1

private theorem foldCarry760_length : foldCarry760.length = 254 := by
  exact (BalancedCleanup.widths L760.toLayout
    (Q6EndpointCell.ports_widths base (base 2409))).2.2.2

private theorem fold760_nd :
    (L760.one::(L760.low++foldCarry760)).Nodup := by
  have nd := L760.toLayout.normND L760_cleanup_nodup
  have oneAway := (List.nodup_cons.mp nd).1
  have restND := (List.nodup_cons.mp (List.nodup_cons.mp nd).2).2
  exact List.nodup_cons.mpr ⟨fun h => oneAway (by simp [h]), restND⟩

private theorem fold760_sources_away :
    ∀ q ∈ mappedWires foldBits760, q ∉ L760.one::(L760.low++foldCarry760) := by
  decide +kernel

private theorem fold760_banks68 :
    (retiredRoles ++ foldCarry760.take 68).Nodup := nodup_of_mask _ (by decide +kernel)

private theorem fold760_roles_away69 :
    ∀ r ∈ retiredRoles,
      r ∉ (mappedWires foldBits760 ++ L760.low ++ foldCarry760.take 69 ++
        [L760.one]).toFinset :=
  k4c_away_fs _ _ (by decide +kernel)

private theorem fold760_roles_away_low :
    ∀ r ∈ retiredRoles, r ∉ L760.low := k4c_away _ _ (by decide +kernel)

private theorem fold760_banks (d : Nat) (hd : d ≤ 68) :
    (retiredRoles.take d ++ foldCarry760.take d).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have fixed := List.nodup_iff_count.mp fold760_banks68 q
  have roles := (List.take_sublist d retiredRoles).count_le q
  have carries := (List.take_sublist_take_left (l := foldCarry760) hd).count_le q
  simp only [List.count_append] at fixed ⊢
  omega

private theorem fold760_roleAway (d : Nat) (hd : d ≤ 68) :
    ∀ r ∈ retiredRoles.take d,
      r ∉ (mappedWires (foldBits760.take (d + 1)) ++
        L760.low.take (d + 1) ++ foldCarry760.take (d + 1) ++
        [L760.one]).toFinset := by
  intro r hr used
  apply fold760_roles_away69 r (List.mem_of_mem_take hr)
  simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at used ⊢
  rcases used with ((source | low) | carry) | one
  · have h := mappedWires_take_mono (d + 1) 255 foldBits760 (by omega) r source
    tauto
  · have h := (List.take_sublist (d + 1) L760.low).subset low
    tauto
  · have h := List.take_subset_take_left foldCarry760
      (by omega : d + 1 ≤ 69) carry
    tauto
  · tauto



/-! ## Tight support for the three nonuniform carry families -/

/-- A recomputed carry prefix touches only the first `d` source, target, and
carry entries, together with the original input carry.  Unlike the broad
`carryPrefix_support` theorem, this form is strong enough to separate the
retired upper roles from the physical lower window. -/
theorem carryPrefix_take_support (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) :
    wires (carryPrefix d bits ys cs cin) ⊆
      (mappedWires (bits.take d) ++ ys.take d ++ cs.take d ++ [cin]).toFinset := by
  induction d generalizing bits ys cs cin with
  | zero => simp [carryPrefix, wires]
  | succ d ih =>
      cases bits with
      | nil => simp [carryPrefix, wires]
      | cons b bits =>
          cases ys with
          | nil => simp [carryPrefix, wires]
          | cons y ys =>
              cases cs with
              | nil => simp [carryPrefix, wires]
              | cons c cs =>
                  rw [carryPrefix, wires_append]
                  apply Finset.union_subset
                  · exact (mappedBit_wires b y cin c).1.trans (by
                      intro q hq
                      simp [mappedWires] at hq ⊢
                      tauto)
                  · exact (ih bits ys cs c).trans (by
                      intro q hq
                      simp [mappedWires] at hq ⊢
                      aesop)

/-- The measured erasure of a carry prefix has the same tight support. -/
theorem erasePrefix_take_support (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) :
    wires (erasePrefix d bits ys cs cin) ⊆
      (mappedWires (bits.take d) ++ ys.take d ++ cs.take d ++ [cin]).toFinset := by
  induction d generalizing bits ys cs cin with
  | zero => simp [erasePrefix, wires]
  | succ d ih =>
      cases bits with
      | nil => simp [erasePrefix, wires]
      | cons b bits =>
          cases ys with
          | nil => simp [erasePrefix, wires]
          | cons y ys =>
              cases cs with
              | nil => simp [erasePrefix, wires]
              | cons c cs =>
                  rw [erasePrefix, wires_append]
                  apply Finset.union_subset
                  · exact (ih bits ys cs c).trans (by
                      intro q hq
                      simp [mappedWires] at hq ⊢
                      aesop)
                  · exact (mappedBit_wires b y cin c).2.1.trans (by
                      intro q hq
                      simp [mappedWires] at hq ⊢
                      tauto)

private theorem mappedRead_take_wires (d : Nat) (xs : List Wire) (flip : Bool) :
    mappedWires ((mappedRead xs flip).take d) = xs.take d := by
  rw [show (mappedRead xs flip).take d = mappedRead (xs.take d) flip by
    simp [mappedRead], mappedRead_wires]

/-- The coherent-prefix down pass is confined to its low prefix. -/
theorem prefix_downs_take_support (d : Nat) (xs ys cs : List Wire)
    (a t z cin : Wire) (hy : ys.length = xs.length)
    (hc : cs.length = xs.length) (hd : d ≤ cs.length) :
    wires (emitDowns ((prefixLayers xs ys cs a t z cin).take d)) ⊆
      (xs.take d ++ ys.take d ++ cs.take d ++ [cin]).toFinset := by
  induction d generalizing xs ys cs cin with
  | zero => simp [emitDowns, wires]
  | succ d ih =>
      cases xs with
      | nil => simp_all
      | cons x xs =>
          cases ys with
          | nil => simp at hy
          | cons y ys =>
              cases cs with
              | nil => simp at hd
              | cons c cs =>
                  have tail := ih xs ys cs c (by simpa using hy)
                    (by simpa using hc) (by simpa using hd)
                  intro q hq
                  simp only [prefixLayers, List.take_succ_cons, emitDowns,
                    CarryLayer.down, wires_append, Finset.mem_union] at hq
                  simp only [List.take_succ_cons, List.mem_toFinset,
                    List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
                  rcases hq with tailUsed | erase | finish
                  · have h := List.mem_toFinset.mp (tail tailUsed)
                    simp only [List.mem_append, List.mem_cons,
                      List.not_mem_nil, or_false] at h
                    tauto
                  · rw [eraseCarry_wires] at erase
                    simp only [Finset.mem_insert, Finset.mem_singleton] at erase
                    tauto
                  · simp [wires, Instr.wires] at finish
                    tauto

/-- The comparison down pass is confined to its low prefix. -/
theorem compare_downs_take_support (d : Nat) (forward : Bool)
    (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length = bs.length) (hc : cs.length + 1 = bs.length)
    (hd : d ≤ cs.length) :
    wires (emitDowns ((compareLayers forward as bs cs cin target).take d)) ⊆
      (as.take d ++ bs.take d ++ cs.take d ++ [cin]).toFinset := by
  induction d generalizing as bs cs cin with
  | zero => simp [emitDowns, wires]
  | succ d ih =>
      cases as with
      | nil =>
          have be : bs = [] := List.eq_nil_of_length_eq_zero hab.symm
          subst bs
          simp at hc
      | cons a as =>
          cases as with
          | nil => simp_all
          | cons a' as =>
              cases bs with
              | nil => simp at hab
              | cons b bs =>
                  cases bs with
                  | nil => simp at hab
                  | cons b' bs =>
                      cases cs with
                      | nil => simp at hd
                      | cons c cs =>
                          have tail := ih (a' :: as) (b' :: bs) cs c
                            (by simpa using hab) (by simpa using hc)
                            (by simpa using hd)
                          intro q hq
                          simp only [compareLayers, List.take_succ_cons, emitDowns,
                            CarryLayer.down, wires_append, Finset.mem_union] at hq
                          simp only [List.take_succ_cons, List.mem_toFinset,
                            List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
                          rcases hq with tailUsed | erase
                          · have h := List.mem_toFinset.mp (tail tailUsed)
                            simp only [List.mem_append, List.mem_cons,
                              List.not_mem_nil, or_false] at h
                            tauto
                          · rw [eraseCarry_wires] at erase
                            simp only [Finset.mem_insert, Finset.mem_singleton] at erase
                            tauto

/-- The dependent-top down pass is confined to its low prefix. -/
theorem addTop_downs_take_support (d : Nat) (as bs cs : List Wire) (cin : Wire)
    (hab : as.length = bs.length) (hc : cs.length + 2 = as.length)
    (hd : d ≤ cs.length) :
    wires (emitDowns ((addTopLayers as bs cs cin).take d)) ⊆
      (as.take d ++ bs.take d ++ cs.take d ++ [cin]).toFinset := by
  induction d generalizing as bs cs cin with
  | zero => simp [emitDowns, wires]
  | succ d ih =>
      cases cs with
      | nil => simp at hd
      | cons c cs =>
          cases as with
          | nil => simp at hc
          | cons a as =>
              cases as with
              | nil => simp at hc
              | cons a' as =>
                  cases bs with
                  | nil => simp at hab
                  | cons b bs =>
                      cases bs with
                      | nil => simp at hab
                      | cons b' bs =>
                          cases as with
                          | nil => simp at hc
                          | cons a'' as =>
                              have tail := ih (a' :: a'' :: as) (b' :: bs) cs c
                                (by simpa using hab) (by simpa using hc)
                                (by simpa using hd)
                              intro q hq
                              simp only [addTopLayers, List.take_succ_cons, emitDowns,
                                CarryLayer.down, wires_append, Finset.mem_union] at hq
                              simp only [List.take_succ_cons, List.mem_toFinset,
                                List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
                              rcases hq with tailUsed | erase | finish
                              · have h := List.mem_toFinset.mp (tail tailUsed)
                                simp only [List.mem_append, List.mem_cons,
                                  List.not_mem_nil, or_false] at h
                                tauto
                              · rw [eraseCarry_wires] at erase
                                simp only [Finset.mem_insert, Finset.mem_singleton] at erase
                                tauto
                              · simp [wires, Instr.wires] at finish
                                tauto

private theorem addTop_step (a a' b b' c cin : Wire) (as bs cs : List Wire)
    (notLast : ¬(as = [] ∧ bs = [])) :
    Q6LifetimeResearch.addTop (a :: a' :: as) (b :: b' :: bs) (c :: cs) cin =
      majority a b cin c ++
        Q6LifetimeResearch.addTop (a' :: as) (b' :: bs) cs c ++
        eraseCarry a b cin c ++ [.CX a b, .CX cin b] := by
  cases as <;> cases bs <;> first | rfl | exact (notLast ⟨rfl, rfl⟩).elim

/-- Public support form of the dependent-top recursion. -/
theorem addTop_support (as bs cs : List Wire) (cin : Wire) :
    wires (Q6LifetimeResearch.addTop as bs cs cin) ⊆
      (cin :: (as ++ bs ++ cs)).toFinset := by
  induction as generalizing bs cs cin with
  | nil => simp [Q6LifetimeResearch.addTop, wires]
  | cons a as ih =>
      cases as with
      | nil => cases bs <;> simp [Q6LifetimeResearch.addTop, wires]
      | cons a' as =>
          cases bs with
          | nil => simp [Q6LifetimeResearch.addTop, wires]
          | cons b bs =>
              cases bs with
              | nil => simp [Q6LifetimeResearch.addTop, wires]
              | cons b' bs =>
                  by_cases last : as = [] ∧ bs = []
                  · rcases last with ⟨rfl, rfl⟩
                    intro q used
                    simp [Q6LifetimeResearch.addTop, Q6LifetimeResearch.dependentTop,
                      wires, Instr.wires, correctionWires] at used ⊢
                    tauto
                  · cases cs with
                    | nil =>
                        cases as <;> cases bs <;>
                          simp_all [Q6LifetimeResearch.addTop, wires]
                    | cons c cs =>
                        have child := ih (b' :: bs) cs c
                        rw [addTop_step a a' b b' c cin as bs cs last]
                        intro q used
                        simp only [wires_append, Finset.mem_union] at used
                        simp only [List.mem_toFinset, List.mem_cons, List.mem_append]
                        rcases used with ((head | tail) | finish) | sum
                        · simp [majority, wires, Instr.wires] at head
                          tauto
                        · have h := List.mem_toFinset.mp (child tail)
                          simp only [List.mem_cons, List.mem_append] at h
                          tauto
                        · rw [eraseCarry_wires] at finish
                          simp only [Finset.mem_insert, Finset.mem_singleton] at finish
                          tauto
                        · simp [wires, Instr.wires] at sum
                          tauto

private theorem mappedMajority_host_mem (b : MappedBit) (y cin target : Wire) :
    target ∈ wires (mappedMajority b y cin target) := by
  cases hw : b.wire <;> cases hf : b.flip <;>
    simp [mappedMajority, hw, hf, majority, borrowMajority, wires, Instr.wires]

/-- Every declared host in a well-sized recompute prefix is actually present
in that prefix's support. -/
theorem carryPrefix_hosts_support (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : d ≤ bits.length) (hy : d ≤ ys.length) (hc : d ≤ cs.length) :
    (cs.take d).toFinset ⊆ wires (carryPrefix d bits ys cs cin) := by
  induction d generalizing bits ys cs cin with
  | zero => simp
  | succ d ih =>
      cases bits with
      | nil => simp at hb
      | cons b bits =>
          cases ys with
          | nil => simp at hy
          | cons y ys =>
              cases cs with
              | nil => simp at hc
              | cons c cs =>
                  have tail := ih bits ys cs c (by simpa using hb)
                    (by simpa using hy) (by simpa using hc)
                  intro q hq
                  simp only [List.take_succ_cons, List.mem_toFinset,
                    List.mem_cons] at hq
                  rw [carryPrefix, wires_append]
                  rcases hq with rfl | hq
                  · exact Finset.mem_union_left _ (mappedMajority_host_mem b y cin q)
                  · exact Finset.mem_union_right _ (tail (by simpa using hq))

/-- If the physical hosts already belonged to the old sweep, exact role
erasure absorbs the hosted union produced by `emitLoan_support_erase`. -/
theorem emitLoan_support_exact (d : Nat) (roles : List Wire)
    (ls : List CarryLayer) (top : Program)
    (len : (roles.take d).length = (layerHosts (ls.take d)).length)
    (nd : (roles.take d ++ layerHosts (ls.take d)).Nodup)
    (hostFree : ∀ h ∈ layerHosts (ls.take d),
      h ∉ wires (emitSweep (ls.drop (d + 1)) top))
    (outsideFree : ∀ r ∈ roles.take d,
      r ∉ wires (emitUps (ls.take (d + 1)) ++ emitErases (ls.take d) ++
        emitUps (ls.take d) ++ emitDowns (ls.take (d + 1))))
    (hostOld : (layerHosts (ls.take d)).toFinset ⊆ wires (emitSweep ls top)) :
    wires (emitLoan d roles ls top) ⊆
      wires (emitSweep ls top) \ (roles.take d).toFinset := by
  have support := emitLoan_support_erase d roles ls top len nd hostFree outsideFree
  have disjoint := (List.nodup_append'.mp nd).2.2
  intro q hq
  rcases Finset.mem_union.mp (support hq) with old | host
  · exact old
  · apply Finset.mem_sdiff.mpr
    constructor
    · exact hostOld host
    · intro role
      exact List.disjoint_left.mp disjoint (by simpa using role) (by simpa using host)

private theorem ordinary_window_outside_free (d : Nat) (roles : List Wire)
    (ls : List CarryLayer) (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire)
    (upLarge : emitUps (ls.take (d + 1)) =
      carryPrefix (d + 1) bits ys cs cin)
    (eraseSmall : emitErases (ls.take d) = erasePrefix d bits ys cs cin)
    (upSmall : emitUps (ls.take d) = carryPrefix d bits ys cs cin)
    (downLarge : wires (emitDowns (ls.take (d + 1))) ⊆
      (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    ∀ r ∈ roles.take d,
      r ∉ wires (emitUps (ls.take (d + 1)) ++ emitErases (ls.take d) ++
        emitUps (ls.take d) ++ emitDowns (ls.take (d + 1))) := by
  have upL := carryPrefix_take_support (d + 1) bits ys cs cin
  have eraseS := erasePrefix_take_support d bits ys cs cin
  have upS := carryPrefix_take_support d bits ys cs cin
  rw [← upLarge] at upL
  rw [← eraseSmall] at eraseS
  rw [← upSmall] at upS
  have liftSmall :
      (mappedWires (bits.take d) ++ ys.take d ++ cs.take d ++ [cin]).toFinset ⊆
        (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
          cs.take (d + 1) ++ [cin]).toFinset := by
    intro q hq
    simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
      List.not_mem_nil, or_false] at hq ⊢
    rcases hq with ((source | target) | carry) | input
    · have h := mappedWires_take_mono d (d + 1) bits (by omega) q source
      tauto
    · have h := List.take_subset_take_left ys (by omega : d ≤ d + 1) target
      tauto
    · have h := List.take_subset_take_left cs (by omega : d ≤ d + 1) carry
      tauto
    · tauto
  intro r hr used
  simp only [wires_append, Finset.mem_union] at used
  rcases used with ((up | erase) | recompute) | down
  · exact roleAway r hr (upL up)
  · exact roleAway r hr (liftSmall (eraseS erase))
  · exact roleAway r hr (liftSmall (upS recompute))
  · exact roleAway r hr (downLarge down)

private theorem ordinary_hosts_old (d : Nat) (ls : List CarryLayer)
    (top : Program) (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hostShape : layerHosts (ls.take d) = cs.take d)
    (upShape : emitUps (ls.take d) = carryPrefix d bits ys cs cin)
    (hb : d ≤ bits.length) (hy : d ≤ ys.length) (hc : d ≤ cs.length) :
    (layerHosts (ls.take d)).toFinset ⊆ wires (emitSweep ls top) := by
  have hosts := carryPrefix_hosts_support d bits ys cs cin hb hy hc
  rw [← upShape, ← hostShape] at hosts
  exact hosts.trans ((emitUps_take_support d ls).trans (by
    intro q hq
    simp only [emitSweep, wires_append, Finset.mem_union]
    tauto))

/-- The hosted mapped-add bound tightens to exact role erasure because every
borrow host already occurs in the old carry prefix. -/
theorem mappedAddLoan_support_exact_lift (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d + 1 ≤ cs.length) (hr : d ≤ roles.length)
    (nd : (cin::(ys++cs)).Nodup)
    (away : ∀ q ∈ mappedWires bits, q ∉ cin::(ys++cs))
    (banks : (roles.take d ++ cs.take d).Nodup)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    wires (mappedAddLoan d roles bits ys cs cin) ⊆
      wires (mappedAdd bits ys cs cin) \ (roles.take d).toFinset := by
  have hosted := mappedAddLoan_support_lift d roles bits ys cs cin hb hc hd hr
    nd away banks roleAway
  have hosts := ordinary_hosts_old d (mappedLayers bits ys cs cin)
    (mappedTop bits ys cs cin) bits ys cs cin
    (layerHosts_mapped_take d bits ys cs cin hb hc)
    (emitUps_mapped_take d bits ys cs cin hb hc)
    (by omega) (by omega) (by omega)
  rw [layerHosts_mapped_take d bits ys cs cin hb hc] at hosts
  rw [← mappedAdd_as_sweep] at hosts
  have disjoint := (List.nodup_append'.mp banks).2.2
  intro q hq
  rcases Finset.mem_union.mp (hosted hq) with old | host
  · exact old
  · apply Finset.mem_sdiff.mpr
    exact ⟨hosts host, fun role =>
      List.disjoint_left.mp disjoint (by simpa using role) (by simpa using host)⟩

/-- Exact mapped-subtract support follows by framing the exact mapped-add
middle with the two unchanged target negations. -/
theorem mappedSubLoan_support_exact_lift (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length = ys.length) (hc : cs.length + 1 = ys.length)
    (hd : d + 1 ≤ cs.length) (hr : d ≤ roles.length)
    (nd : (cin::(ys++cs)).Nodup)
    (away : ∀ q ∈ mappedWires bits, q ∉ cin::(ys++cs))
    (banks : (roles.take d ++ cs.take d).Nodup)
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset)
    (roleAwayYs : ∀ r ∈ roles.take d, r ∉ ys) :
    wires (mappedSubLoan d roles bits ys cs cin) ⊆
      wires (mappedSub bits ys cs cin) \ (roles.take d).toFinset := by
  have middle := mappedAddLoan_support_exact_lift d roles bits ys cs cin
    hb hc hd hr nd away banks roleAway
  intro q hq
  simp only [mappedSubLoan, wires_append, Finset.mem_union] at hq
  apply Finset.mem_sdiff.mpr
  rcases hq with (left | loan) | right
  · exact ⟨by
      simp only [mappedSub, wires_append, Finset.mem_union]
      tauto, fun role => roleAwayYs q (by simpa using role)
        (by simpa only [notRegister_wires, List.mem_toFinset] using left)⟩
  · have old := Finset.mem_sdiff.mp (middle loan)
    exact ⟨by
      simp only [mappedSub, wires_append, Finset.mem_union]
      exact Or.inl (Or.inr old.1), old.2⟩
  · exact ⟨by
      simp only [mappedSub, wires_append, Finset.mem_union]
      tauto, fun role => roleAwayYs q (by simpa using role)
        (by simpa only [notRegister_wires, List.mem_toFinset] using right)⟩

theorem foldMappedLoan_supportExact760 (d : Nat) (hd : d ≤ 68) :
    wires (mappedAddLoan d retiredRoles foldBits760 L760.low
      foldCarry760 L760.one) ⊆
      wires (mappedAdd foldBits760 L760.low foldCarry760 L760.one) \
        (retiredRoles.take d).toFinset := by
  refine mappedAddLoan_support_exact_lift d retiredRoles foldBits760 L760.low
    foldCarry760 L760.one ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
  · rw [foldBits760_length, foldLow760_length]
  · rw [foldCarry760_length, foldLow760_length]
  · rw [foldCarry760_length]
    omega
  · rw [retiredRoles_length]
    exact hd
  · exact fold760_nd
  · exact fold760_sources_away
  · exact fold760_banks d hd
  · exact fold760_roleAway d hd

theorem unfoldMappedLoan_supportExact760 (d : Nat) (hd : d ≤ 68) :
    wires (mappedSubLoan d retiredRoles foldBits760 L760.low
      foldCarry760 L760.one) ⊆
      wires (mappedSub foldBits760 L760.low foldCarry760 L760.one) \
        (retiredRoles.take d).toFinset := by
  refine mappedSubLoan_support_exact_lift d retiredRoles foldBits760 L760.low
    foldCarry760 L760.one ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
  · rw [foldBits760_length, foldLow760_length]
  · rw [foldCarry760_length, foldLow760_length]
  · rw [foldCarry760_length]
    omega
  · rw [retiredRoles_length]
    exact hd
  · exact fold760_nd
  · exact fold760_sources_away
  · exact fold760_banks d hd
  · exact fold760_roleAway d hd
  · intro r hr
    exact fold760_roles_away_low r (List.mem_of_mem_take hr)

/-- Exact erasure support composes pointwise through program append. -/
theorem append_support_erase (roles : Finset Wire) (P P' Q Q' : Program)
    (hp : wires P ⊆ wires P' \ roles)
    (hq : wires Q ⊆ wires Q' \ roles) :
    wires (P ++ Q) ⊆ wires (P' ++ Q') \ roles := by
  intro q used
  simp only [wires_append, Finset.mem_union] at used ⊢
  apply Finset.mem_sdiff.mpr
  rcases used with left | right
  · have old := Finset.mem_sdiff.mp (hp left)
    exact ⟨Finset.mem_union_left _ old.1, old.2⟩
  · have old := Finset.mem_sdiff.mp (hq right)
    exact ⟨Finset.mem_union_right _ old.1, old.2⟩

theorem unchanged_support_erase (roles : Finset Wire) (P : Program)
    (away : ∀ q ∈ wires P, q ∉ roles) :
    wires P ⊆ wires P \ roles := by
  intro q used
  exact Finset.mem_sdiff.mpr ⟨used, away q used⟩

theorem framed_support_erase (roles : Finset Wire) (pre body body' post : Program)
    (hbody : wires body ⊆ wires body' \ roles)
    (preAway : ∀ q ∈ wires pre, q ∉ roles)
    (postAway : ∀ q ∈ wires post, q ∉ roles) :
    wires (pre ++ body ++ post) ⊆ wires (pre ++ body' ++ post) \ roles := by
  simpa only [List.append_assoc] using
    append_support_erase roles pre pre (body ++ post) (body' ++ post)
      (unchanged_support_erase roles pre preAway)
      (append_support_erase roles body body' post post hbody
        (unchanged_support_erase roles post postAway))

/-- A wire rename preserves exact erasure when membership in the protected
role set reflects through the renaming map. -/
theorem renameProgram_support_erase (roles : Finset Wire) (f : Wire → Wire)
    (P Q : Program) (support : wires P ⊆ wires Q \ roles)
    (roleBack : ∀ q, f q ∈ roles → q ∈ roles) :
    wires (renameProgram f P) ⊆ wires (renameProgram f Q) \ roles := by
  intro q used
  simp only [renameProgram_support, Finset.mem_image] at used
  obtain ⟨a, ha, rfl⟩ := used
  have old := Finset.mem_sdiff.mp (support ha)
  apply Finset.mem_sdiff.mpr
  constructor
  · simp only [renameProgram_support, Finset.mem_image]
    exact ⟨a, old.1, rfl⟩
  · intro role
    exact old.2 (roleBack a role)

private theorem mappedConstantMajority_support (bit : Bool)
    (y cin target _one : Wire) :
    wires (mappedMajority (mappedConstantBit none bit) y cin target) ⊆
      wires (literalConstStep bit y cin target) := by
  cases bit <;> intro q hq <;>
    simp [mappedConstantBit, mappedMajority, literalConstStep,
      literalConstSum, literalConstCarry, wires, Instr.wires] at hq ⊢ <;> tauto

private theorem mappedConstantErase_support (bit : Bool)
    (y cin target one : Wire) :
    wires (mappedEraseCarry (mappedConstantBit none bit) y cin target) ⊆
      wires (literalConstErase bit y cin target one) := by
  cases bit <;> intro q hq <;>
    simp [mappedConstantBit, mappedEraseCarry, literalConstErase,
      wires, Instr.wires, correctionWires] at hq ⊢ <;> tauto

private theorem mappedConstantSum_support (bit : Bool)
    (y cin target : Wire) :
    wires (mappedSum (mappedConstantBit none bit) y cin) ⊆
      wires (literalConstStep bit y cin target) := by
  cases bit <;> intro q hq <;>
    simp [mappedConstantBit, mappedSum, literalConstStep,
      literalConstSum, literalConstCarry, wires, Instr.wires] at hq ⊢ <;> tauto

private theorem mappedConstantSum_support_literalSum (bit : Bool)
    (y cin : Wire) :
    wires (mappedSum (mappedConstantBit none bit) y cin) ⊆
      wires (literalConstSum bit y cin) := by
  cases bit <;> intro q hq <;>
    simp [mappedConstantBit, mappedSum, literalConstSum,
      wires, Instr.wires] at hq ⊢ <;> tauto

/-- The source-free mapped constant adder omits only uses of the clean `one`
wire, so all of its support is already present in the literal constant adder. -/
theorem mappedConstantAdd_support_literal (xs cs : List Wire)
    (cin one : Wire) (k : Nat) :
    wires (mappedAdd (mappedConstant none xs.length k) xs cs cin) ⊆
      wires (literalConstAdd xs cs cin one k) := by
  induction xs generalizing cs cin k with
  | nil => simp [mappedConstant, mappedAdd, literalConstAdd, wires]
  | cons x xs ih =>
      cases xs with
      | nil =>
          simpa only [List.length_cons, List.length_nil, mappedConstant,
            mappedAdd, literalConstAdd] using
            mappedConstantSum_support_literalSum (decide (k % 2 = 1)) x cin
      | cons x' xs =>
          cases cs with
          | nil => simp [mappedConstant, mappedAdd, literalConstAdd, wires]
          | cons c cs =>
              have tail := ih cs c (k / 2)
              intro q used
              simp only [List.length_cons, mappedConstant, mappedAdd, literalConstAdd,
                wires_append, Finset.mem_union] at used ⊢
              rcases used with ((up | middle) | erase) | finish
              · exact Or.inl (Or.inl
                  (mappedConstantMajority_support (decide (k % 2 = 1))
                    x cin c one up))
              · exact Or.inl (Or.inr (tail middle))
              · exact Or.inr
                  (mappedConstantErase_support (decide (k % 2 = 1))
                    x cin c one erase)
              · exact Or.inl (Or.inl
                  (mappedConstantSum_support (decide (k % 2 = 1)) x cin c finish))

theorem addPrefixLoan_support_lift (d : Nat) (roles xs ys cs : List Wire)
    (a t z cin : Wire) (hy : ys.length = xs.length)
    (hc : cs.length = xs.length) (hd : d + 1 ≤ cs.length)
    (hr : d ≤ roles.length)
    (banks : (roles.take d ++ cs.take d).Nodup)
    (hostFree : ∀ h ∈ cs.take d,
      h ∉ wires (CoherentTail.addPrefix (xs.drop (d + 1))
        (ys.drop (d + 1)) (cs.drop (d + 1)) a t z
        (carryAfter (d + 1) cs cin)))
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (xs.take (d + 1) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    wires (addPrefixLoan d roles xs ys cs a t z cin) ⊆
      wires (CoherentTail.addPrefix xs ys cs a t z cin) \
        (roles.take d).toFinset := by
  let ls := prefixLayers xs ys cs a t z cin
  let top := prefixTop xs ys cs a t z cin
  let bits := mappedRead xs false
  have large := prefix_prefix_shapes (d + 1) xs ys cs a t z cin hy hc hd
  have small := prefix_prefix_shapes d xs ys cs a t z cin hy hc (by omega)
  have down := prefix_downs_take_support (d + 1) xs ys cs a t z cin
    hy hc hd
  have down' : wires (emitDowns (ls.take (d + 1))) ⊆
      (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset := by
    simpa only [ls, bits, mappedRead_take_wires] using down
  have roleAway' : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ ys.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset := by
    simpa only [bits, mappedRead_take_wires] using roleAway
  have outside := ordinary_window_outside_free d roles ls bits ys cs cin
    large.1 small.2.1 small.1 down' roleAway'
  have upper : emitSweep (ls.drop (d + 1)) top =
      CoherentTail.addPrefix (xs.drop (d + 1)) (ys.drop (d + 1))
        (cs.drop (d + 1)) a t z (carryAfter (d + 1) cs cin) := by
    exact prefix_upper_sweep (d + 1) xs ys cs a t z cin hy hc hd
  have hosts := ordinary_hosts_old d ls top bits ys cs cin small.2.2 small.1
    (by simp [bits, mappedRead_length]; omega) (by omega) (by omega)
  have len : (roles.take d).length = (layerHosts (ls.take d)).length := by
    rw [small.2.2, List.length_take, List.length_take]
    omega
  have bankLs : (roles.take d ++ layerHosts (ls.take d)).Nodup := by
    change (roles.take d ++
      layerHosts ((prefixLayers xs ys cs a t z cin).take d)).Nodup
    rw [small.2.2]
    exact banks
  have hostFreeLs : ∀ h ∈ layerHosts (ls.take d),
      h ∉ wires (emitSweep (ls.drop (d + 1)) top) := by
    intro h hh used
    change h ∈ layerHosts ((prefixLayers xs ys cs a t z cin).take d) at hh
    rw [small.2.2] at hh
    rw [upper] at used
    exact hostFree h hh used
  have exactSupport := emitLoan_support_exact d roles ls top len
    bankLs hostFreeLs outside hosts
  rw [← addPrefix_as_sweep] at exactSupport
  exact exactSupport

theorem compareLoan_support_lift (d : Nat) (roles : List Wire)
    (forward : Bool) (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length = bs.length) (hc : cs.length + 1 = bs.length)
    (hd : d + 1 ≤ cs.length) (hr : d ≤ roles.length)
    (banks : (roles.take d ++ cs.take d).Nodup)
    (hostFree : ∀ h ∈ cs.take d,
      h ∉ wires (Q6LifetimeResearch.compareChain forward (as.drop (d + 1))
        (bs.drop (d + 1)) (cs.drop (d + 1))
        (carryAfter (d + 1) cs cin) target))
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (as.take (d + 1) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    wires (compareLoan d roles forward as bs cs cin target) ⊆
      wires (Q6LifetimeResearch.compareChain forward as bs cs cin target) \
        (roles.take d).toFinset := by
  let ls := compareLayers forward as bs cs cin target
  let top := compareTop forward as bs cs cin target
  let bits := mappedRead as false
  have large := compare_prefix_shapes (d + 1) forward as bs cs cin target
    hab hc hd
  have small := compare_prefix_shapes d forward as bs cs cin target
    hab hc (by omega)
  have down := compare_downs_take_support (d + 1) forward as bs cs cin target
    hab hc hd
  have down' : wires (emitDowns (ls.take (d + 1))) ⊆
      (mappedWires (bits.take (d + 1)) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset := by
    simpa only [ls, bits, mappedRead_take_wires] using down
  have roleAway' : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset := by
    simpa only [bits, mappedRead_take_wires] using roleAway
  have outside := ordinary_window_outside_free d roles ls bits bs cs cin
    large.1 small.2.1 small.1 down' roleAway'
  have upper : emitSweep (ls.drop (d + 1)) top =
      Q6LifetimeResearch.compareChain forward (as.drop (d + 1))
        (bs.drop (d + 1)) (cs.drop (d + 1))
        (carryAfter (d + 1) cs cin) target := by
    exact compare_upper_sweep (d + 1) forward as bs cs cin target hab hc hd
  have hosts := ordinary_hosts_old d ls top bits bs cs cin small.2.2 small.1
    (by simp [bits, mappedRead_length]; omega) (by omega) (by omega)
  have len : (roles.take d).length = (layerHosts (ls.take d)).length := by
    rw [small.2.2, List.length_take, List.length_take]
    omega
  have bankLs : (roles.take d ++ layerHosts (ls.take d)).Nodup := by
    change (roles.take d ++
      layerHosts ((compareLayers forward as bs cs cin target).take d)).Nodup
    rw [small.2.2]
    exact banks
  have hostFreeLs : ∀ h ∈ layerHosts (ls.take d),
      h ∉ wires (emitSweep (ls.drop (d + 1)) top) := by
    intro h hh used
    change h ∈ layerHosts
      ((compareLayers forward as bs cs cin target).take d) at hh
    rw [small.2.2] at hh
    rw [upper] at used
    exact hostFree h hh used
  have exactSupport := emitLoan_support_exact d roles ls top len
    bankLs hostFreeLs outside hosts
  rw [← compareChain_as_sweep] at exactSupport
  exact exactSupport

/-- Sweep-form interface for concrete callers.  Keeping the unreduced sweep
on the right avoids elaborating a fixed 254-cell `compareChain` merely to
check definitional equality. -/
theorem compareLoan_support_sweep_lift (d : Nat) (roles : List Wire)
    (forward : Bool) (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length = bs.length) (hc : cs.length + 1 = bs.length)
    (hd : d + 1 ≤ cs.length) (hr : d ≤ roles.length)
    (banks : (roles.take d ++ cs.take d).Nodup)
    (hostFree : ∀ h ∈ cs.take d,
      h ∉ wires (Q6LifetimeResearch.compareChain forward (as.drop (d + 1))
        (bs.drop (d + 1)) (cs.drop (d + 1))
        (carryAfter (d + 1) cs cin) target))
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (as.take (d + 1) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    wires (compareLoan d roles forward as bs cs cin target) ⊆
      wires (emitSweep (compareLayers forward as bs cs cin target)
        (compareTop forward as bs cs cin target)) \
        (roles.take d).toFinset := by
  rw [← compareChain_as_sweep]
  exact compareLoan_support_lift d roles forward as bs cs cin target
    hab hc hd hr banks hostFree roleAway

theorem addTopLoan_support_lift (d : Nat) (roles as bs cs : List Wire)
    (cin : Wire) (hab : as.length = bs.length)
    (hc : cs.length + 2 = as.length) (hd : d + 1 ≤ cs.length)
    (hr : d ≤ roles.length)
    (banks : (roles.take d ++ cs.take d).Nodup)
    (hostFree : ∀ h ∈ cs.take d,
      h ∉ wires (Q6LifetimeResearch.addTop (as.drop (d + 1))
        (bs.drop (d + 1)) (cs.drop (d + 1))
        (carryAfter (d + 1) cs cin)))
    (roleAway : ∀ r ∈ roles.take d,
      r ∉ (as.take (d + 1) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset) :
    wires (addTopLoan d roles as bs cs cin) ⊆
      wires (Q6LifetimeResearch.addTop as bs cs cin) \
        (roles.take d).toFinset := by
  let ls := addTopLayers as bs cs cin
  let top := addTopTop as bs cs cin
  let bits := mappedRead as false
  have large := addTop_prefix_shapes (d + 1) as bs cs cin hab hc hd
  have small := addTop_prefix_shapes d as bs cs cin hab hc (by omega)
  have down := addTop_downs_take_support (d + 1) as bs cs cin hab hc hd
  have down' : wires (emitDowns (ls.take (d + 1))) ⊆
      (mappedWires (bits.take (d + 1)) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset := by
    simpa only [ls, bits, mappedRead_take_wires] using down
  have roleAway' : ∀ r ∈ roles.take d,
      r ∉ (mappedWires (bits.take (d + 1)) ++ bs.take (d + 1) ++
        cs.take (d + 1) ++ [cin]).toFinset := by
    simpa only [bits, mappedRead_take_wires] using roleAway
  have outside := ordinary_window_outside_free d roles ls bits bs cs cin
    large.1 small.2.1 small.1 down' roleAway'
  have upper : emitSweep (ls.drop (d + 1)) top =
      Q6LifetimeResearch.addTop (as.drop (d + 1)) (bs.drop (d + 1))
        (cs.drop (d + 1)) (carryAfter (d + 1) cs cin) := by
    exact addTop_upper_sweep (d + 1) as bs cs cin hab hc hd
  have hosts := ordinary_hosts_old d ls top bits bs cs cin small.2.2 small.1
    (by simp [bits, mappedRead_length]; omega) (by omega) (by omega)
  have len : (roles.take d).length = (layerHosts (ls.take d)).length := by
    rw [small.2.2, List.length_take, List.length_take]
    omega
  have bankLs : (roles.take d ++ layerHosts (ls.take d)).Nodup := by
    change (roles.take d ++ layerHosts ((addTopLayers as bs cs cin).take d)).Nodup
    rw [small.2.2]
    exact banks
  have hostFreeLs : ∀ h ∈ layerHosts (ls.take d),
      h ∉ wires (emitSweep (ls.drop (d + 1)) top) := by
    intro h hh used
    change h ∈ layerHosts ((addTopLayers as bs cs cin).take d) at hh
    rw [small.2.2] at hh
    rw [upper] at used
    exact hostFree h hh used
  have exactSupport := emitLoan_support_exact d roles ls top len
    bankLs hostFreeLs outside hosts
  rw [← addTop_as_sweep] at exactSupport
  exact exactSupport

/-! ### Closed 760-bit nonuniform instantiations -/

abbrev q6Carry760 : List Wire := (Q6Structural.q6Carry L760).take 255
abbrev q6Tail760 : List Wire := q6Carry760.drop 1
abbrev q6Head760 : Wire := q6Carry760.getD 0 0

private theorem q6Carry760_length : q6Carry760.length = 255 := by
  have ql : (Q6Structural.q6Carry L760).length = 256 :=
    (Q6StructuralCell.carry_widths L760
      (Q6EndpointCell.ports_widths base (base 2409))).2.2
  simp [q6Carry760, List.length_take, ql]

private theorem q6Tail760_length : q6Tail760.length = 254 := by
  change (q6Carry760.drop 1).length = 254
  rw [List.length_drop, q6Carry760_length]

private theorem q6Banks68 :
    (retiredRoles ++ q6Tail760.take 68).Nodup := nodup_of_mask _ (by decide +kernel)

private theorem q6Banks (d : Nat) (hd : d ≤ 68) :
    (retiredRoles.take d ++ q6Tail760.take d).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have fixed := List.nodup_iff_count.mp q6Banks68 q
  have roles := (List.take_sublist d retiredRoles).count_le q
  have carries := (List.take_sublist_take_left (l := q6Tail760) hd).count_le q
  simp only [List.count_append] at fixed ⊢
  omega

private theorem q6Tail760_nodup : q6Tail760.Nodup := nodup_of_mask _ (by decide +kernel)

private theorem q6Tail760_work (q : Wire) (hq : q ∈ q6Tail760) :
    q = L760.lower ∨ q ∈ L760.carry := by
  have inTake : q ∈ (Q6Structural.q6Carry L760).take 255 :=
    List.mem_of_mem_drop hq
  have inCarry := List.mem_of_mem_take inTake
  simp only [Q6Structural.q6Carry, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at inCarry
  rcases inCarry with (front | lower) | back
  · exact Or.inr (List.mem_of_mem_take front)
  · exact Or.inl lower
  · exact Or.inr (List.mem_of_mem_drop back)

private theorem q6Tail760_pool_away :
    ∀ q ∈ q6Tail760,
      q ∉ [L760.parity, L760.sign, L760.one, L760.rmsb,
        L760.ymsb, L760.r0] ++ L760.rtail ++ L760.ylow := by
  intro q hq data
  have work := q6Tail760_work q hq
  have all := List.nodup_iff_count.mp
    (L760.toLayout.allND L760_cleanup_nodup) q
  have dataPos := List.count_pos_iff.mpr data
  simp only [BalancedCleanup.Layout.r, BalancedCleanup.Layout.low,
    BalancedCleanup.Layout.y, List.count_append, List.count_cons,
    List.count_nil] at all dataPos
  rcases work with rfl | carry
  · simp only [beq_self_eq_true, if_true] at all
    omega
  · have carryPos := List.count_pos_iff.mpr carry
    omega

private theorem q6Head760_away_tail : ∀ q ∈ q6Tail760, q ≠ q6Head760 := by
  decide +kernel

private theorem retiredRoles_q6Tail760 (d : Nat) (hd : d ≤ 68) :
    ∀ q ∈ retiredRoles.take d, q ∈ q6Tail760.drop (d + 1) := by
  simpa only [q6Tail760, q6Carry760] using retiredRoles_q6Tail d hd

private theorem rawRoleAway760 (d : Nat) (hd : d ≤ 68) :
    ∀ r ∈ retiredRoles.take d,
      r ∉ ((L760.ylow.drop 1).take (d + 1) ++
        (L760.low.drop 1).take (d + 1) ++ q6Tail760.take (d + 1) ++
        [q6Head760]).toFinset := by
  intro r hr used
  have tail := retiredRoles_q6Tail760 d hd r hr
  have full := List.mem_of_mem_drop tail
  have poolAway := q6Tail760_pool_away r full
  have headAway := q6Head760_away_tail r full
  simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at used
  rcases used with ((source | target) | carry) | head
  · apply poolAway
    have h := List.mem_of_mem_drop (List.mem_of_mem_take source)
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    tauto
  · apply poolAway
    have h := List.mem_of_mem_drop (List.mem_of_mem_take target)
    simp only [BalancedCleanup.Layout.low, List.mem_append, List.mem_cons,
      List.not_mem_nil, or_false] at h ⊢
    tauto
  · exact List.disjoint_left.mp
      (List.disjoint_take_drop q6Tail760_nodup (Nat.le_refl (d + 1)))
      carry tail
  · exact headAway head

private theorem compareRoleAway760 (d : Nat) (hd : d ≤ 68) :
    ∀ r ∈ retiredRoles.take d,
      r ∉ ((L760.y.drop 1).take (d + 1) ++
        (L760.r.drop 1).take (d + 1) ++ q6Tail760.take (d + 1) ++
        [q6Head760]).toFinset := by
  intro r hr used
  have tail := retiredRoles_q6Tail760 d hd r hr
  have full := List.mem_of_mem_drop tail
  have poolAway := q6Tail760_pool_away r full
  have headAway := q6Head760_away_tail r full
  simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at used
  rcases used with ((source | target) | carry) | head
  · apply poolAway
    have h := List.mem_of_mem_drop (List.mem_of_mem_take source)
    simp only [BalancedCleanup.Layout.y, List.mem_append, List.mem_cons,
      List.mem_singleton, List.not_mem_nil, or_false] at h ⊢
    tauto
  · apply poolAway
    have h := List.mem_of_mem_drop (List.mem_of_mem_take target)
    simp only [BalancedCleanup.Layout.r, BalancedCleanup.Layout.low,
      List.mem_append, List.mem_cons, List.mem_singleton,
      List.not_mem_nil, or_false] at h ⊢
    tauto
  · exact List.disjoint_left.mp
      (List.disjoint_take_drop q6Tail760_nodup (Nat.le_refl (d + 1)))
      carry tail
  · exact headAway head

private theorem addTopRoleAway760 (d : Nat) (hd : d ≤ 68) :
    ∀ r ∈ retiredRoles.take d,
      r ∉ (((GuardCompression.source L760).drop 1).take (d + 1) ++
        ((BalancedCircuit.rawTarget L760).drop 1).take (d + 1) ++
        q6Tail760.take (d + 1) ++ [q6Head760]).toFinset := by
  intro r hr used
  have tail := retiredRoles_q6Tail760 d hd r hr
  have full := List.mem_of_mem_drop tail
  have poolAway := q6Tail760_pool_away r full
  have headAway := q6Head760_away_tail r full
  simp only [List.mem_toFinset, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at used
  rcases used with ((source | target) | carry) | head
  · apply poolAway
    have h := List.mem_of_mem_drop (List.mem_of_mem_take source)
    simp only [GuardCompression.source, BalancedCleanup.Layout.y,
      List.mem_append, List.mem_cons, List.mem_singleton,
      List.not_mem_nil, or_false] at h ⊢
    tauto
  · apply poolAway
    have h := List.mem_of_mem_drop (List.mem_of_mem_take target)
    simp only [BalancedCircuit.rawTarget, BalancedCleanup.Layout.r,
      BalancedCleanup.Layout.low, List.mem_append, List.mem_cons,
      List.mem_singleton, List.not_mem_nil, or_false] at h ⊢
    tauto
  · exact List.disjoint_left.mp
      (List.disjoint_take_drop q6Tail760_nodup (Nat.le_refl (d + 1)))
      carry tail
  · exact headAway head

private theorem q6LowAwayUpper (d : Nat) (hd : d ≤ 68) :
    ∀ h ∈ q6Tail760.take d,
      h ∉ q6Tail760.drop (d + 1) ∧
        h ≠ carryAfter (d + 1) q6Tail760 q6Head760 := by
  intro h hh
  have bound : d + 1 ≤ q6Tail760.length := by
    rw [q6Tail760_length]
    omega
  constructor
  · intro tail
    have low : h ∈ q6Tail760.take (d + 1) :=
      List.take_subset_take_left q6Tail760 (by omega) hh
    exact List.disjoint_left.mp
      (List.disjoint_take_drop q6Tail760_nodup (Nat.le_refl (d + 1)))
      low tail
  · intro eq
    have boundary := carryAfter_succ_mem_drop d q6Tail760 q6Head760 (by omega)
    exact nodup_take_away_drop q6Tail760 d q6Tail760_nodup h hh (eq ▸ boundary)

private theorem rawUpperAway760 (d : Nat) (hd : d ≤ 68) :
    ∀ h ∈ q6Tail760.take d,
      h ∉ (L760.ylow.drop 1).drop (d + 1) ++
        (L760.low.drop 1).drop (d + 1) ++ q6Tail760.drop (d + 1) ++
        [L760.ymsb, L760.rmsb, L760.one,
          carryAfter (d + 1) q6Tail760 q6Head760] := by
  intro h hh used
  have full := List.mem_of_mem_take hh
  have poolAway := q6Tail760_pool_away h full
  have upperAway := q6LowAwayUpper d hd h hh
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at used
  simp only [or_assoc] at used
  rcases used with source | (target | (carry | (ymsb | (rmsb | (one | boundary)))))
  · apply poolAway
    have hs := List.mem_of_mem_drop (List.mem_of_mem_drop source)
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    tauto
  · apply poolAway
    have ht := List.mem_of_mem_drop (List.mem_of_mem_drop target)
    simp only [BalancedCleanup.Layout.low, List.mem_append, List.mem_cons,
      List.not_mem_nil, or_false] at ht ⊢
    tauto
  · exact upperAway.1 carry
  · exact poolAway (by simp [ymsb])
  · exact poolAway (by simp [rmsb])
  · exact poolAway (by simp [one])
  · exact upperAway.2 boundary

private theorem compareUpperAway760 (d : Nat) (hd : d ≤ 68) :
