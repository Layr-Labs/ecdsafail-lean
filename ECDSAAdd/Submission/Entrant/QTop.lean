  · simp only [Bool.not_true,Bool.toNat_true,Bool.toNat_false,Nat.mul_zero,Nat.add_zero,
      Nat.mul_one]
    rw [show a+4+8*u+(4+8*k)=a+8*(u+k+1) by ring]
