  simpa only [run_append,new,eq] using result

theorem rowClear_on_image (control top pad : Wire) (xs low carry : List Wire)
    (hn : (control::xs++(low++[top])++[pad]++carry).Nodup)
    (hl : low.length=xs.length) (hc : carry.length=xs.length)
