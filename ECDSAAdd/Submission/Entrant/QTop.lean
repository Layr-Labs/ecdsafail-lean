 (bias : b L.bias=(b (L.Y 255) && !b L.sigma))
 (scalar : regValue L.r b=
      ((if b L.sigma then regValue (L.y.take 255) b else 3*regValue (L.y.take 255) b)+
        2*(b L.bias).toNat+(b L.h).toNat*(2^32+977))%2^256) :
