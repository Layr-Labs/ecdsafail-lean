  · exact mem_oldE L hw q h
  · exact oldE_mem L hw q (Or.inr (Or.inr (Or.inr (Or.inl (h ▸ (eK_mem L hw).2.1)))))

theorem kw_counts (L : CuccaroStreamedSquareWideLayout) : toffoliCount (kw L) = 0 ∧ measurementCount (kw L) = 0 := by
