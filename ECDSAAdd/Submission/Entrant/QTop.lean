theorem accFoldQ4_countsTq (L : CuccaroStreamedSquareWideLayout) (hw : L.Widths) (a : AccItem) :
    toffoliCount (accFoldQ4Tq L a)+8=toffoliCount (accFoldQTq L a) ∧
