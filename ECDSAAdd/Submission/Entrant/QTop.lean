  | nil => simp at hc
  | cons y ys ih =>
    cases bits with
    | nil => simp at hl
    | cons b bs =>
      cases sums with
      | nil => simp [program]
      | cons d ds =>
        cases ds with
        | nil => simp [program]
        | cons d' ds =>
          cases ys with
          | nil => simp at hs
          | cons y' ys =>
            cases bs with
            | nil => simp at hl
            | cons b' bs =>
              cases carry with
              | nil => simp at hc
              | cons c cs =>
                have it:=ih (b'::bs) (d'::ds) cs c (by simpa using hl)
