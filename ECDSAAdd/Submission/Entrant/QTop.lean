    (head_append_sub _ _ _ _ (Finset.Subset.refl _)
      (head_append_sub _ _ _ _ (head_append_sub _ _ _ _ (head_append_sub _ _ _ _
        (head_append_sub _ _ _ _ (head_append_sub _ _ _ _ (head_append_sub _ _ _ _ h1 h2) h3)
          h4) h5) h6) h7))
    (Finset.Subset.refl _)

theorem tailFirstBase_sub (j : Nat) :
    wires (tailFirstBase j)⊆wires (ECDSAAdd.Entrant.Rolling1588.basePacket false j) := by
  have cOdd := fun active => oddCell_subF j active 2
  have cStart := cellWith_subF _ mstart_support j 4 2
  simp only [tailFirstBase,ECDSAAdd.Entrant.Rolling1588.basePacket,Bool.false_eq_true,if_false]
  exact seven_parts_sub (onPacket j (dp++ParityCodec5New.untwist))
    (onPacket j (ParityCodec5New.twist++ep))
    (cellWith false (P1Life.mstart (base 760) base (base 2409)) j 4 2) (onPacket j bridge5)
    (cell false j 3 2) (cell false j 4 2) (onPacket j bridge7inv) (cell false j 4 2)
    (cell false j 3 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2) (onPacket j bridge5)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 3 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2) (onPacket j bridge7inv)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 3 2)
    cStart (Finset.Subset.refl _) (cOdd 3) (cOdd 4) (Finset.Subset.refl _) (cOdd 4) (cOdd 3)

theorem tailLastBase_sub (j : Nat) :
    wires (tailLastBase j)⊆wires (ECDSAAdd.Entrant.Rolling1588.basePacket false j) := by
  have cOdd := fun active => oddCell_subF j active 2
  have cEnd := cellWith_subF _ mend_support j 3 2
  simp only [tailLastBase,ECDSAAdd.Entrant.Rolling1588.basePacket,Bool.false_eq_true,if_false]
  exact seven_parts_sub (onPacket j (dp++ParityCodec5New.untwist))
    (onPacket j (ParityCodec5New.twist++ep))
    (cell false j 4 2) (onPacket j bridge5)
    (cell false j 3 2) (cell false j 4 2) (onPacket j bridge7inv) (cell false j 4 2)
    (cellWith false (P1Life.mend (base 760) base (base 2409)) j 3 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2) (onPacket j bridge5)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 3 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2) (onPacket j bridge7inv)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 3 2)
    (cOdd 4) (Finset.Subset.refl _) (cOdd 3) (cOdd 4) (Finset.Subset.refl _) (cOdd 4) cEnd

theorem routeBasePacket_subF (j : Nat) :
    wires (basePacket false j)⊆wires (ECDSAAdd.Entrant.Rolling1588.basePacket false j) := by
  have cOdd := fun active => oddCell_subF j active 2
  simp only [basePacket,ECDSAAdd.Entrant.Rolling1588.basePacket,Bool.false_eq_true,if_false]
  exact seven_parts_sub (onPacket j (dp++ParityCodec5New.untwist))
    (onPacket j (ParityCodec5New.twist++ep))
    (cell false j 4 2) (onPacket j bridge5)
    (cell false j 3 2) (cell false j 4 2) (onPacket j bridge7inv) (cell false j 4 2)
    (cell false j 3 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2) (onPacket j bridge5)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 3 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2) (onPacket j bridge7inv)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 4 2)
    (ECDSAAdd.Entrant.Rolling1588.cell false j 3 2)
    (cOdd 4) (Finset.Subset.refl _) (cOdd 3) (cOdd 4) (Finset.Subset.refl _) (cOdd 4) (cOdd 3)

theorem routePacket_subF (j : Nat) :
    wires (packet false j)⊆wires (ECDSAAdd.Entrant.Rolling1588.packet false j) :=
  head_rename_sub _ _ _ (routeBasePacket_subF j)

/-- Every wire of the odd-word tail is a wire of the record packets `84 .. 1`. -/
theorem oddTail_sub :
    wires oddTail⊆wires (ECDSAAdd.Entrant.Rolling1588.groups false 1 84) := by
  rw [record_tail_split]
  exact head_append_sub _ _ _ _ (head_rename_sub _ _ _ (tailFirstBase_sub 84))
    (head_append_sub _ _ _ _ (tail_sequence_sub _ _ routePacket_subF 2 82)
      (head_rename_sub _ _ _ (tailLastBase_sub 1)))

/-! ## Both directions -/

/-- The deficit-zero packets `1 .. 84` in the odd-word code: the division head or the
multiplication tail. -/
def oddBlock (divide : Bool) : Program := if divide then oddHead else oddTail

theorem oddBlock_true : oddBlock true=oddHead := if_pos rfl

theorem oddBlock_false : oddBlock false=oddTail := if_neg Bool.false_ne_true

theorem oddBlock_sub (divide : Bool) :
    wires (oddBlock divide)⊆wires (ECDSAAdd.Entrant.Rolling1588.groups divide 1 84) := by
  cases divide
  · rw [oddBlock_false]
    exact oddTail_sub
  · rw [oddBlock_true]
    exact oddHead_sub

end ECDSAAdd.Entrant.RouteA.Rolling1588
end

section
set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000

namespace ECDSAAdd.Entrant.RouteA.Rolling1588
open Arithmetic MappedCompressed
attribute [local irreducible] wires run toffoliCount measurementCount Challenge.gateSlots GatePhysical oddHead oddTail




end ECDSAAdd.Entrant.RouteA.Rolling1588

namespace ECDSAAdd.Entrant.StairOddHead
open Arithmetic MappedCompressed Secp256k1 BalancedField

/-- Run equality of either odd-word block with the record packets on the record cut frame. -/
theorem oddBlock_run_eq (divide : Bool) (origin : BasisState)
    (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : Rolling1588.CutFrame (if divide then 1 else 85) origin X Y s) :
    run (RouteA.Rolling1588.oddBlock divide) fresh s =
      run (Rolling1588.groups divide 1 84) old s := by
  cases divide
  · have input' : Rolling1588.CutFrame 85 origin X Y s := by simpa using input
    rw [RouteA.Rolling1588.oddBlock_false]
    exact oddTail_run_eq origin ctx enabled X Y s fresh old input'
  · have input' : Rolling1588.CutFrame 1 origin X Y s := by simpa using input
    rw [RouteA.Rolling1588.oddBlock_true]
    exact oddHead_run_eq origin ctx enabled X Y s fresh old input'

end ECDSAAdd.Entrant.StairOddHead
end
