theorem head_append_sub (P Q P0 Q0 : Program)
    (hp : wires P⊆wires P0) (hq : wires Q⊆wires Q0) :
    wires (P++Q)⊆wires (P0++Q0) := by
  rw [wires_append,wires_append]
  exact Finset.union_subset_union hp hq

theorem head_rename_sub (f : Wire→Wire) (P Q : Program) (sub : wires P⊆wires Q) :
    wires (renameProgram f P)⊆wires (renameProgram f Q) := by
  rw [renameProgram_support,renameProgram_support]
  exact Finset.image_mono f sub

theorem head_loanWindow_sub (g flag c : Wire) (P Q : Program) (sub : wires P⊆wires Q) :
    wires (ControlLoan1589.loanWindow g flag c P)⊆
      wires (ControlLoan1589.loanWindow g flag c Q) := by
  unfold ControlLoan1589.loanWindow
  exact head_append_sub _ _ _ _ (head_append_sub _ _ _ _ (Finset.Subset.refl _)
    (head_rename_sub _ _ _ sub)) (Finset.Subset.refl _)

theorem head_sequence_sub (p r : Nat→Program) (same : ∀j,wires (p j)⊆wires (r j)) :
    ∀j n,wires (PacketSequence.program true p j n)⊆wires (PacketSequence.program true r j n) := by
  intro j n
  induction n generalizing j with
  | zero =>
    intro q hq
    exact hq
  | succ n ih =>
    simp only [PacketSequence.program,if_true]
    exact head_append_sub _ _ _ _ (same j) (ih (j+1))

/-- The record half mentions every wire of the cell footprint except the retired carry. -/
theorem footprint_sub :
    (P1Life.junctionFootprint (Q6EndpointCell.ports base (base 2409))).erase (base 760)⊆
      wires (R2Life760.half760 true) := by
  intro q hq
  obtain ⟨ne,mem⟩ := Finset.mem_erase.mp hq
  apply StairOddHead.footprint_touch q
  unfold StairOddHead.footprintList
  rw [List.mem_filter]
  refine ⟨?_,by simpa using ne⟩
  simpa only [P1Life.junctionFootprint,List.mem_toFinset] using mem

theorem cellWith_sub (P : Program) (support : HalfSupport P) (j active hole : Nat) :
    wires (cellWith true P j active hole)⊆
      wires (ECDSAAdd.Entrant.Rolling1588.cell true j active hole) := by
  have inner : wires P⊆wires (R2Life760.half760 true) :=
    fun q hq => footprint_sub (support hq)
  simp only [cellWith,ECDSAAdd.Entrant.Rolling1588.cell,if_true,halfWindowWith,
    ECDSAAdd.Entrant.Rolling1588.halfWindow]
  exact head_append_sub _ _ _ _
    (head_loanWindow_sub _ _ _ _ _ (head_rename_sub _ _ _ inner)) (Finset.Subset.refl _)

