  have framed := framed_support_erase (retiredRoles.take d).toFinset
    unfoldPre760 _ _ unfoldPost760 moved
    (unfoldPre760_away d hd) (unfoldPost760_away d hd)
  simpa only [unfoldLoan, unfoldPre760, unfoldPost760, foldBits760, foldCarry760,
    List.append_assoc] using framed

theorem compareBlockLoan_support760 (d : Nat) (forward : Bool) (hd : d ≤ 68) :
    wires (compareBlockLoan d forward L760) ⊆
      wires (compareBlockLoan 0 forward L760) \
        (retiredRoles.take d).toFinset := by
  have inner := compareInnerLoan_support760_chain d forward hd
  have inner0 : wires (compareLoan d retiredRoles forward (L760.y.drop 1)
      (L760.r.drop 1) q6Tail760 q6Head760 L760.parity) ⊆
      wires (compareLoan 0 retiredRoles forward (L760.y.drop 1)
        (L760.r.drop 1) q6Tail760 q6Head760 L760.parity) \
        (retiredRoles.take d).toFinset := by
    rw [compareLoan_zero]
    exact inner
  have moved := move_support_erase760 d L760.one _ _ inner0 compareSwap760_fixed
  have framed := framed_support_erase (retiredRoles.take d).toFinset
    comparePre760 _ _ comparePost760 moved
    (comparePre760_away d hd) (comparePost760_away d hd)
  simpa only [compareBlockLoan, comparePre760, comparePost760, compareA760,
    compareB760, q6Tail760, q6Head760, q6Carry760, List.append_assoc] using framed

theorem normalizeLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (normalizeLoan d L760) ⊆
