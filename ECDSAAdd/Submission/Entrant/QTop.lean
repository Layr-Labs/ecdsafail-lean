/-- The loaned division endpoint touches no wire outside the record's. -/
theorem endPacket760DivLoan_sub :
    wires endPacket760DivLoan ⊆ wires (R2SqEp760.endPacket760 true) := by
  rw [endPacket760_true_shape]
  unfold endPacket760DivLoan
