section Merge_StairPhysicalPrimitives_at_QTop

/-!
# Physical primitive provider for the omittable-44 staircase

The checkpoint codec, its sign extension and rest relocation, the first
moved tick, and the moved middle segments, all placed by
`StairPhysicalLayout`.  `physicalPrimitives_good` proves that every wire of
every primitive of every row is a good site: its final placement is in the
record arena and is neither one of the 15 old omissions nor one of the 44 new
omissions.  This is the moved-segment/codec part of the final `insideArena`,
`oldFree`, and `newFree` obligations.

The packet writes inside a moved segment are bounded exactly by their ten
history wires (`MeasuredCodec5.support_exact`), not by the whole Skywalk pool.
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairPhysicalPrimitives

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairOuterPlacement StairPhysicalInventory StairPhysicalLayout

/-! ## Exact packet support -/

theorem encode_wires (w : Nat → Wire) (start : Nat) (q : Wire)
    (hq : q ∈ wires (History5.encode w start)) :
    ∃ k : Fin 10, q = History5.historyMap w start k := by
  unfold History5.encode MeasuredCodec5.encodeAt at hq
  rw [renameProgram_support, MeasuredCodec5.support_exact.1] at hq
  obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hq
  have hr' : r < 10 := Finset.mem_range.mp hr
  exact ⟨⟨r, hr'⟩, by simp [MeasuredCodec5.label, hr']⟩

theorem decode_wires (w : Nat → Wire) (start : Nat) (q : Wire)
    (hq : q ∈ wires (History5.decode w start)) :
    ∃ k : Fin 10, q = History5.historyMap w start k := by
  unfold History5.decode MeasuredCodec5.decodeAt at hq
  rw [renameProgram_support, MeasuredCodec5.support_exact.2] at hq
  obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hq
  have hr' : r < 10 := Finset.mem_range.mp hr
  exact ⟨⟨r, hr'⟩, by simp [MeasuredCodec5.label, hr']⟩

theorem packFirst_wires (w : Nat → Wire) (i : Nat) (hi : i ≠ 5) (q : Wire)
    (hq : q ∈ wires (Rolling1588.Integer.packFirst w true i)) :
    History5.packDue i = true ∧
      ∃ k : Fin 10, q = History5.historyMap w (i - 5) k := by
  unfold Rolling1588.Integer.packFirst at hq
  rw [if_neg hi, Rolling1588.Integer.pack_support_eq] at hq
  unfold History5.packAfter at hq
  split at hq
  · rename_i due
    exact ⟨due, encode_wires w (i - 5) q hq⟩
  · simp [wires] at hq

theorem unpackFirst_wires (w : Nat → Wire) (i : Nat) (hi : i ≠ 5) (q : Wire)
    (hq : q ∈ wires (Rolling1588.Integer.unpackFirst w true i)) :
    History5.packDue i = true ∧
      ∃ k : Fin 10, q = History5.historyMap w (i - 5) k := by
  unfold Rolling1588.Integer.unpackFirst at hq
  rw [if_neg hi, Rolling1588.Integer.decodeBefore_support_eq] at hq
  unfold History5.decodeBefore at hq
  split at hq
  · rename_i due
    exact ⟨due, decode_wires w (i - 5) q hq⟩
  · simp [wires] at hq

/-! ## Fine support of moved segments -/


theorem receiver_layout (w : Nat → Wire) (i : Nat) (hi : i < 512)
    (hn : (skywalkPoolWires w).Nodup) (q : Wire)
    (hq : q ∈ wires (W.ReverseCarry.compactReceiverTick w i)) :
    q ∈ (W.compactSkywalkTickLayout w i).wires :=
  List.mem_toFinset.mp (W.ReverseCarry.compactReceiverTick_support w i hi hn hq)



/-! ## Middle-segment map

The first moved tick reads its previous letter from a zero wire (`segmentMap`).
The middle ticks never touch that id, but the record stage invariant used by
the middle replay (`Rolling1588.Integer.Stage`) locates the last record packet
through it, so the middle map sends `start - 1` to the real letter
`base (start - 1)` (LT14 audit item H). -/

def segMid (l e q : Nat) : Wire := if q + 1 = l then base (l - 1) else segMap l e q

def midSegmentMap (B : Nat) : Nat → Wire := segMid (startFor B) (endFor B)

/-- K4-B (replay budget): a left inverse of `segMid` on its values (`base v = v + 16`), so
injectivity needs one case split of one side instead of the product of both sides. -/
def kbMidInv (v : Nat) : Nat :=
  if v < 514 then v else if v = 2409 then 511 else if 4000 ≤ v then v - 4000
  else if 1549 ≤ v ∧ v ≤ 1628 then 3081 - v
  else if v = 514 then 854 else if v = 1027 then 855 else if v = 1544 then 856
  else if v = 1545 then 857 else if v = 1540 then 1624 else if v = 1797 then 1625
  else if v = 1546 then 1626
  else if v ≤ 1282 then (if v % 5 = 0 then 770 + (v - 1035) / 5 else 1540 + (v - 1037) / 5)
  else (if v % 5 = 1 then 770 + (2046 - v) / 5 else 1540 + (2044 - v) / 5)

theorem kbMidInv_bNum : ∀ k, k < 88 → kbMidInv (bNum k) = 770 + k := by
  decide +kernel

theorem kbMidInv_cNum : ∀ k, k < 87 → kbMidInv (cNum k) = 1540 + k := by
  decide +kernel

theorem kbMid_linv (l e q : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500) (h2 : e ≤ 505) :
    kbMidInv (segMid l e q - 16) = q := by
  unfold segMid segMap zeroWire
  split_ifs
  all_goals simp only [base, Nat.add_sub_cancel]
  all_goals first
    | (rw [kbMidInv_bNum _ (by omega)]; omega)
    | (rw [kbMidInv_cNum _ (by omega)]; omega)
    | (rw [show l - 1 = q by omega]; unfold kbMidInv; rw [if_pos (by omega)])
    | (unfold kbMidInv; rw [if_pos (by omega)])
    | (unfold kbMidInv; rw [if_neg (by omega), if_pos (by omega)]; omega)
    | (unfold kbMidInv; rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]; omega)
    | (unfold kbMidInv; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega),
        if_pos (by omega)]; omega)

theorem segMid_injective (l e : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500)
    (h2 : e ≤ 505) : Function.Injective (segMid l e) := by
  intro x y eq
  have hx := kbMid_linv l e x h0 h1 h2
  rw [eq] at hx
  exact hx.symm.trans (kbMid_linv l e y h0 h1 h2)

theorem midSegmentMap_pool_nodup : ∀ B ∈ budgets,
    (skywalkPoolWires (midSegmentMap B)).Nodup := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  unfold skywalkPoolWires wireBlock midSegmentMap
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals
    exact List.Nodup.map (segMid_injective _ _ (by decide) (by decide)
      (by decide)) List.nodup_range'

/- LT6 (benchmark replay budget): the unreferenced `midSegmentMap_previous`
(`∀ B ∈ budgets, midSegmentMap B (startFor B - 1) = base (startFor B - 1)`, six
`decide +kernel`, ≈ 150 s — LT27 profile b14) is omitted; restore it from
CANON_OUT/Entrant_1823 if needed. -/

theorem midSegmentMap_eq : ∀ B ∈ budgets, ∀ q, q + 1 ≠ startFor B →
    midSegmentMap B q = segmentMap B q := by
  intro B _ q hq
  simp [midSegmentMap, segmentMap, segMid, hq]

theorem base_ten (x : Nat) : 10 ≤ base x := by
  show 10 ≤ x + 16
  omega

theorem midSegmentMap_historyAbove : ∀ B ∈ budgets,
    History5.HistoryAbove (midSegmentMap B) := by
  intro B _ j _
  unfold midSegmentMap segMid segMap zeroWire
  split_ifs <;> exact base_ten _


/-! ## The provider -/

/-- Budget of the segment containing tick `i`. -/
def segmentOf (i : Nat) : Nat :=
  if i < 450 then 87 else if i < 465 then 62 else if i < 480 then 47
  else if i < 490 then 32 else if i < 500 then 22 else 12

def signExt (B : Nat) : Program :=
  StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B)

def pack (B : Nat) : Program :=
  signExt B ++ StairCodec.pack (physicalLayout B) B ++ relocate B

def unpack (B : Nat) : Program :=
  unrelocate B ++ StairCodec.unpack (physicalLayout B) B ++ signExt B

def orient (i : Nat) : Program :=
  StairCodec.orient (letterSite (i - 1)) (physicalLayout (512 - i)) (512 - i)


def tickReverse (i : Nat) : Program :=
  W.ReverseCarry.compactReceiverTick (segmentMap (512 - i)) i



/-! ## Static row facts -/

/-! K4-B (replay budget): the moved ticks and packets of a row only read pool ids in four
intervals (letters, b-rail, histories, carries); the row map sends each of them to a row site
(`kbSeg_row`, structural), so no tick or packet is evaluated. -/

theorem kbRail_rowSites (B i : Nat) (hi : i < B) :
    (physicalLayout B).S i ∈ rowSites B ∧ (physicalLayout B).D i ∈ rowSites B := by
  have hS : (physicalLayout B).S i ∈ StairCodec.reg (physicalLayout B).S B :=
    List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩
  have hD : (physicalLayout B).D i ∈ StairCodec.reg (physicalLayout B).D B :=
    List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩
  constructor
  · simp only [rowSites, StairCodec.declaredSites, List.mem_append, hS, true_or]
  · simp only [rowSites, StairCodec.declaredSites, List.mem_append, hD, true_or, or_true]

/-- The pool ids read by `W.compactSkywalkTickLayout w j`, in wire order. -/
def kbIdsOf (j : Nat) : List Nat :=
  skywalkPoolPreviousId j :: (1028 + j) :: (j + W.compactSkywalkTickPreWidth j) :: j :: 770 ::
    ((List.range' (j + 1) (W.compactSkywalkTickPreWidth j - 2) ++
        [j + W.compactSkywalkTickPreWidth j - 1]) ++
      (List.range' 771 (W.compactSkywalkTickPreWidth j - 2) ++
        [770 + W.compactSkywalkTickPreWidth j - 1]) ++
      List.range' 1540 (W.compactSkywalkTickPreWidth j - 1))

theorem kbTick_wires (w : Nat → Wire) (j : Nat) :
    (W.compactSkywalkTickLayout w j).wires = (kbIdsOf j).map w := by
  simp only [W.compactSkywalkTickLayout, SkywalkIntegerLayout.wires, SkywalkIntegerLayout.ah,
    SkywalkIntegerLayout.bh, kbIdsOf, wireBlock, List.map_cons, List.map_append, List.map_nil]

theorem kbWidth0 : ∀ i, i < 80 → W.compactSkywalkTickPreWidth (425 + i) = 88 - i := by
  decide +kernel

theorem kbWidth (j : Nat) (h1 : j < 505) (h2 : 425 ≤ j) :
    W.compactSkywalkTickPreWidth j = 513 - j := by
  have h := kbWidth0 (j - 425) (by omega)
  rw [show 425 + (j - 425) = j by omega] at h
  rw [h]
  omega

theorem kbIdsOf_mem (lo l e j id : Nat) (hl : 425 ≤ l) (he : e ≤ 505) (hlo : lo + 1 ≤ j)
    (hlj : l ≤ j) (hje : j < e) (hid : id ∈ kbIdsOf j) :
    (lo ≤ id ∧ id ≤ 513) ∨ (770 ≤ id ∧ id + l < 1283) ∨ (1028 + l ≤ id ∧ id < 1028 + e) ∨
      (1540 ≤ id ∧ id + l < 2052) := by
  have hn : W.compactSkywalkTickPreWidth j = 513 - j := kbWidth j (by omega) (by omega)
  have hp : skywalkPoolPreviousId j = j - 1 := by
    unfold skywalkPoolPreviousId
    rw [if_neg (by omega)]
  unfold kbIdsOf at hid
  rw [hn, hp] at hid
  clear hn hp
  simp only [List.mem_cons, List.mem_append, List.mem_range'_1, List.not_mem_nil,
    or_false] at hid
  rcases hid with h | h | h | h | h | h
  · exact Or.inl ⟨by omega, by omega⟩
  · exact Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩))
  · exact Or.inl ⟨by omega, by omega⟩
  · exact Or.inl ⟨by omega, by omega⟩
  · exact Or.inr (Or.inl ⟨by omega, by omega⟩)
  · rcases h with ((h | h) | (h | h)) | h
    · exact Or.inl ⟨by omega, by omega⟩
    · exact Or.inl ⟨by omega, by omega⟩
    · exact Or.inr (Or.inl ⟨by omega, by omega⟩)
    · exact Or.inr (Or.inl ⟨by omega, by omega⟩)
    · exact Or.inr (Or.inr (Or.inr ⟨by omega, by omega⟩))

theorem kbRow_bounds : ∀ B ∈ budgets,
    425 ≤ startFor B ∧ endFor B ≤ 505 ∧ startFor B % 5 = 0 ∧ 1 ≤ startFor B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

def kbFamP : List Wire :=
  (List.range' 424 87).map base ++ [base 512, base 513, base 2409, zeroWire] ++
    (List.range 88).map bSite ++ (List.range 87).map cSite ++ (List.range' 425 85).map sLetter

theorem kbPFam_letter (t : Nat) (h1 : 424 ≤ t) (h2 : t < 514) : letterSite t ∈ kbFamP := by
  unfold letterSite kbFamP
  split_ifs with h
  · simp only [List.mem_append, List.mem_cons, true_or, or_true]
  · by_cases h3 : t < 511
    · exact List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _
        (List.mem_append_left _ (List.mem_map.mpr ⟨t, List.mem_range'_1.mpr ⟨h1, by omega⟩, rfl⟩))))
    · have : t = 512 ∨ t = 513 := by omega
      rcases this with rfl | rfl
      · simp only [List.mem_append, List.mem_cons, true_or, or_true]
      · simp only [List.mem_append, List.mem_cons, true_or, or_true]

theorem kbPFam_zero : zeroWire ∈ kbFamP := by
  unfold kbFamP
  simp only [List.mem_append, List.mem_cons, true_or, or_true]

theorem kbPFam_b (k : Nat) (h : k < 88) : bSite k ∈ kbFamP :=
  List.mem_append_left _ (List.mem_append_left _ (List.mem_append_right _
    (List.mem_map.mpr ⟨k, List.mem_range.mpr h, rfl⟩)))

theorem kbPFam_c (k : Nat) (h : k < 87) : cSite k ∈ kbFamP :=
  List.mem_append_left _ (List.mem_append_right _ (List.mem_map.mpr ⟨k, List.mem_range.mpr h, rfl⟩))

theorem kbPFam_s (t : Nat) (h : 425 ≤ t ∧ t < 510) : sLetter t ∈ kbFamP :=
  List.mem_append_right _ (List.mem_map.mpr ⟨t, List.mem_range'_1.mpr ⟨h.1, by omega⟩, rfl⟩)

/-- Per-row index bounds of the payload and hole letters used by a row (small evaluations). -/
theorem kbPRowFacts : ∀ B ∈ budgets,
    (∀ i, i < StairCodec.bitWidth B →
      425 ≤ payloadTick (startFor B) i ∧ payloadTick (startFor B) i < 510) ∧
    (∀ i, i < 3 * ((510 - startFor B) / 5) - StairCodec.bitWidth B →
      425 ≤ payloadTick (startFor B) (StairCodec.bitWidth B + i) ∧
        payloadTick (startFor B) (StairCodec.bitWidth B + i) < 510) ∧
    (∀ i, i < 2 * ((505 - startFor B) / 5) →
      425 ≤ holeTick (startFor B) i ∧ holeTick (startFor B) i < 510) ∧
    (∀ i, i < 3 * ((505 - startFor B) / 5) - StairCodec.bitWidth B →
      425 ≤ payloadTick (startFor B) (StairCodec.bitWidth B + i) ∧
        payloadTick (startFor B) (StairCodec.bitWidth B + i) < 510) ∧
    425 ≤ startFor B ∧ startFor B + B = 512 ∧ endFor B ≤ 505 ∧ B ≤ 87 ∧ 2 ≤ B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem kbPPool_fam (B : Nat) (hB : B ∈ budgets) (q : Wire) (hq : q ∈ extraPool B) :
    q ∈ kbFamP := by
  obtain ⟨-, -, f3, f4, -, f6, -, f8, -⟩ := kbPRowFacts B hB
  unfold extraPool at hq
  rcases List.mem_append.mp hq with hq | hq
  · rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        exact kbPFam_s _ (f3 i (List.mem_range.mp hi))
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        exact kbPFam_s _ (f4 i (List.mem_range.mp hi))
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
      have := List.mem_range.mp hi
      exact kbPFam_b _ (by omega)
  · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
    have := List.mem_range.mp hi
    exact kbPFam_c _ (by omega)

theorem kbPGetD_fam (B : Nat) (hB : B ∈ budgets) (k : Nat) :
    (extraPool B).getD k zeroWire ∈ kbFamP := by
  rw [List.getD_eq_getElem?_getD]
  cases h : (extraPool B)[k]? with
  | none => exact kbPFam_zero
  | some x => exact kbPPool_fam B hB x (List.mem_of_getElem? h)

theorem kbPOneHot_sites (fresh : Nat → Wire) :
    ∀ (bits : List Wire) (q : Wire), q ∈ (StairCodec.oneHot bits fresh).sites → ∃ k, q = fresh k
  | [], q, h => by
    simp only [StairCodec.oneHot, List.mem_singleton] at h
    exact ⟨0, h⟩
  | [_], q, h => by
    simp only [StairCodec.oneHot, List.mem_singleton] at h
    exact ⟨0, h⟩
  | _ :: b' :: bs, q, h => by
    simp only [StairCodec.oneHot, List.mem_append, List.mem_map] at h
    rcases h with (h | ⟨i, -, rfl⟩) | ⟨i, -, rfl⟩
    · exact kbPOneHot_sites fresh (b' :: bs) q h
    · exact ⟨_, rfl⟩
    · exact ⟨_, rfl⟩

/-- K4-B: every row site is in the label family, structurally (no row is evaluated). -/
theorem kbPRow_famS (B : Nat) (hB : B ∈ budgets) (q : Wire) (hq : q ∈ rowSites B) :
    q ∈ kbFamP := by
  obtain ⟨f1, f2, -, -, f5, f6, f7, f8, f9⟩ := kbPRowFacts B hB
  unfold rowSites at hq
  rcases List.mem_append.mp hq with hq | hq
  · rcases List.mem_append.mp hq with hq | hq
    · rcases List.mem_append.mp hq with hq | hq
      · rcases List.mem_append.mp hq with hq | hq
        · rcases List.mem_append.mp hq with hq | hq
          · -- declared sites
            unfold StairCodec.declaredSites at hq
            rcases List.mem_append.mp hq with hq | hq
            · rcases List.mem_append.mp hq with hq | hq
              · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                have hi' := List.mem_range.mp hi
                show segmentMap B (startFor B + i) ∈ kbFamP
                rw [segmentMap_letters B hB _ (by omega) (by omega)]
                exact kbPFam_letter _ (by omega) (by omega)
              · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                have hi' := List.mem_range.mp hi
                exact kbPFam_b i (by omega)
            · unfold StairCodec.workSites at hq
              rcases List.mem_append.mp hq with hq | hq
              · rcases List.mem_append.mp hq with hq | hq
                · rcases List.mem_append.mp hq with hq | hq
                  · rcases List.mem_append.mp hq with hq | hq
                    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                      exact kbPFam_s _ (f1 i (List.mem_range.mp hi))
                    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
                      have hi' := List.mem_range.mp hi
                      exact kbPFam_c i (by omega)
                  · rcases List.mem_cons.mp hq with rfl | hq
                    · exact kbPGetD_fam B hB 0
                    · rw [List.mem_singleton.mp hq]
                      exact kbPGetD_fam B hB 1
                · obtain ⟨k, rfl⟩ := kbPOneHot_sites _ _ q hq
                  exact kbPGetD_fam B hB _
              · obtain ⟨k, rfl⟩ := kbPOneHot_sites _ _ q hq
                exact kbPGetD_fam B hB _
          · -- the four explicit sites
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
            rcases hq with rfl | rfl | rfl | rfl
            · exact kbPFam_b B (by omega)
            · exact kbPFam_letter 512 (by omega) (by omega)
            · exact kbPFam_letter 513 (by omega) (by omega)
            · exact kbPFam_zero
        · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
          have hi' := List.mem_range.mp hi
          exact kbPFam_c i (by omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range.mp hi
        exact kbPFam_s _ ⟨by omega, by omega⟩
    · unfold restSites at hq
      rcases List.mem_append.mp hq with hq | hq
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        have hi' := List.mem_range.mp hi
        exact kbPFam_letter _ (by omega) (by omega)
      · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq
        exact kbPFam_s _ (f1 i (List.mem_range.mp hi))
  · unfold hosts at hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp (List.mem_of_mem_take hq)
    exact kbPFam_s _ (f2 i (List.mem_range.mp hi))

/-- The row map sends every tick id of the row to a row site (structural, no evaluation). -/
theorem kbSeg_row (B : Nat) (hB : B ∈ budgets) (id : Nat)
    (h : (startFor B - 1 ≤ id ∧ id ≤ 513) ∨ (770 ≤ id ∧ id + startFor B < 1283) ∨
      (1028 + startFor B ≤ id ∧ id < 1028 + endFor B) ∨ (1540 ≤ id ∧ id + startFor B < 2052)) :
    segmentMap B id ∈ rowSites B := by
  obtain ⟨b1, b2, b3, b4⟩ := kbRow_bounds B hB
  clear b3
  have hl : startFor B + B = 512 ∧ B ≤ 87 := by
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    unfold startFor
    omega
  rcases h with h | h | h | h
  · by_cases hz : id + 1 = startFor B
    · show segMap (startFor B) (endFor B) id ∈ rowSites B
      unfold segMap
      rw [if_pos hz]
      simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]
    by_cases hs : id ≤ 511
    · have e1 : segmentMap B id = (physicalLayout B).S (id - startFor B) := by
        show _ = segmentMap B (startFor B + (id - startFor B))
        congr 1
        omega
      rw [e1]
      exact (kbRail_rowSites B _ (by omega)).1
    · show segMap (startFor B) (endFor B) id ∈ rowSites B
      unfold segMap
      rw [if_neg hz, if_pos (by omega), if_neg (by omega)]
      have : id = 512 ∨ id = 513 := by omega
      rcases this with rfl | rfl
      · simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]
      · simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]
  · show segMap (startFor B) (endFor B) id ∈ rowSites B
    unfold segMap
    rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
    by_cases hk : id - 770 < B
    · exact (kbRail_rowSites B _ hk).2
    · rw [show id - 770 = B by omega]
      show bSite B ∈ rowSites B
      simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]
  · obtain ⟨t, rfl⟩ : ∃ t, id = 1028 + t := ⟨id - 1028, by omega⟩
    rw [segmentMap_history B hB t (by omega) (by omega)]
    have hm : sLetter t ∈ (List.range (endFor B - startFor B)).map
        (fun i => sLetter (startFor B + i)) :=
      List.mem_map.mpr ⟨t - startFor B, List.mem_range.mpr (by omega), by
        show sLetter (startFor B + (t - startFor B)) = sLetter t
        congr 1
        omega⟩
    simp only [rowSites, List.mem_append, hm, true_or, or_true]
  · show segMap (startFor B) (endFor B) id ∈ rowSites B
    unfold segMap
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
      if_pos (by omega)]
    have hm : cSite (id - 1540) ∈ (List.range B).map cSite :=
      List.mem_map.mpr ⟨_, List.mem_range.mpr (by omega), rfl⟩
    show cSite (id - 1540) ∈ rowSites B
    simp only [rowSites, List.mem_append, hm, true_or, or_true]

theorem kbRow_mem (B : Nat) (hB : B ∈ budgets) (id : Nat)
    (h : (startFor B - 1 ≤ id ∧ id ≤ 513) ∨ (770 ≤ id ∧ id + startFor B < 1283) ∨
      (1028 + startFor B ≤ id ∧ id < 1028 + endFor B) ∨ (1540 ≤ id ∧ id + startFor B < 2052)) :
    (StairLoan.maskOf (rowSites B)).testBit (segmentMap B id) = true := by
  rw [StairLoan.testBit_maskOf]
  exact decide_eq_true (kbSeg_row B hB id h)

/-- Every site of `rowSitesL B` is in the label family `kbFamP` (structural). -/
theorem kbRowL_fam (B : Nat) (hB : B ∈ budgets) (q : Wire)
    (hq : q ∈ letterSite (startFor B - 1) :: rowSites B) : q ∈ kbFamP := by
  rcases List.mem_cons.mp hq with h | h
  · obtain ⟨-, -, -, -, f5, f6, -, -, -⟩ := kbPRowFacts B hB
    rw [h]
    exact kbPFam_letter _ (by omega) (by omega)
  · exact kbPRow_famS B hB q h

theorem kbPacket_mem (B : Nat) (hB : B ∈ budgets) (j : Nat) (h1 : j < endFor B)
    (h2 : startFor B < j) (due : History5.packDue j = true) (k : Fin 10) :
    (startFor B ≤ History5.historyId (j - 5) k ∧ History5.historyId (j - 5) k ≤ 513) ∨
      (770 ≤ History5.historyId (j - 5) k ∧ History5.historyId (j - 5) k + startFor B < 1283) ∨
      (1028 + startFor B ≤ History5.historyId (j - 5) k ∧
        History5.historyId (j - 5) k < 1028 + endFor B) ∨
      (1540 ≤ History5.historyId (j - 5) k ∧ History5.historyId (j - 5) k + startFor B < 2052) := by
  obtain ⟨b1, b2, b3, b4⟩ := kbRow_bounds B hB
  have hk := k.isLt
  simp only [History5.packDue, decide_eq_true_eq] at due
  have hj : startFor B + 5 ≤ j := by omega
  have hk2 : k.val / 2 ≤ 4 := by omega
  clear due b3
  unfold History5.historyId
  split_ifs with hc
  · clear hc
    exact Or.inl ⟨by omega, by omega⟩
  · clear hc
    exact Or.inr (Or.inr (Or.inl ⟨by omega, by omega⟩))

/-- LT44 (replay budget): row membership through a bit mask of the row (38 s → ≈ 6 s).
K4-B: from the tick-id lemma `kbIdsOf_mem` and the row-map lemma `kbSeg_row`. -/
private theorem tick_rowSitesB : ∀ B ∈ budgets, ∀ j, j < endFor B → startFor B ≤ j →
    (W.compactSkywalkTickLayout (segmentMap B) j).wires.all
      (fun q => (StairLoan.maskOf (rowSites B)).testBit q) = true := by
  intro B hB j h1 h2
  obtain ⟨b1, b2, b3, b4⟩ := kbRow_bounds B hB
  rw [List.all_eq_true, kbTick_wires]
  intro q hq
  obtain ⟨id, hid, rfl⟩ := List.mem_map.mp hq
  exact kbRow_mem B hB id
    (kbIdsOf_mem (startFor B - 1) (startFor B) (endFor B) j id b1 b2 (by omega) h2 h1 hid)

theorem tick_rowSites : ∀ B ∈ budgets, ∀ j, j < endFor B → startFor B ≤ j →
    ∀ q ∈ (W.compactSkywalkTickLayout (segmentMap B) j).wires, q ∈ rowSites B :=
  fun B hB j h1 h2 q hq =>
    StairLoan.mem_of_maskOf (List.all_eq_true.mp (tick_rowSitesB B hB j h1 h2) q hq)


/-- LT44 (replay budget): row membership through a bit mask of the row (33 s → ≈ 6 s).
K4-B: as `tick_rowSitesB`; above `startFor B - 1` the middle map is the row map. -/
private theorem midTick_rowSitesB : ∀ B ∈ budgets, ∀ j, j < endFor B → startFor B < j →
    (W.compactSkywalkTickLayout (midSegmentMap B) j).wires.all
      (fun q => (StairLoan.maskOf (rowSites B)).testBit q) = true := by
  intro B hB j h1 h2
  obtain ⟨b1, b2, b3, b4⟩ := kbRow_bounds B hB
  rw [List.all_eq_true, kbTick_wires]
  intro q hq
  obtain ⟨id, hid, rfl⟩ := List.mem_map.mp hq
  have m := kbIdsOf_mem (startFor B) (startFor B) (endFor B) j id b1 b2 (by omega) (by omega) h1 hid
  have hne : id + 1 ≠ startFor B := by
    rcases m with h | h | h | h <;> omega
  rw [midSegmentMap_eq B hB id hne]
  exact kbRow_mem B hB id (m.imp_left (fun h => ⟨by omega, h.2⟩))

theorem midTick_rowSites : ∀ B ∈ budgets, ∀ j, j < endFor B → startFor B < j →
    ∀ q ∈ (W.compactSkywalkTickLayout (midSegmentMap B) j).wires, q ∈ rowSites B :=
  fun B hB j h1 h2 q hq =>
    StairLoan.mem_of_maskOf (List.all_eq_true.mp (midTick_rowSitesB B hB j h1 h2) q hq)

theorem midPacket_rowSites : ∀ B ∈ budgets, ∀ j, j < endFor B → startFor B < j →
    History5.packDue j = true →
      ∀ k : Fin 10, History5.historyMap (midSegmentMap B) (j - 5) k ∈ rowSites B := by
  intro B hB j h1 h2 due k
  have m := kbPacket_mem B hB j h1 h2 due k
  have hne : History5.historyId (j - 5) k + 1 ≠ startFor B := by
    rcases m with h | h | h | h <;> omega
  show midSegmentMap B (History5.historyId (j - 5) k) ∈ rowSites B
  rw [midSegmentMap_eq B hB _ hne]
  exact StairLoan.mem_of_maskOf (kbRow_mem B hB _ (m.imp_left (fun h => ⟨by omega, h.2⟩)))

/-! K4-B (replay budget): `relocate` / `unrelocate` only move rail bits `D i ↔ S i`, `i < B`,
which are declared row sites; proved structurally instead of by evaluation. -/

theorem kbMem_wires_flatMap {α : Type} (l : List α) (f : α → Program) (q : Wire)
    (h : q ∈ wires (l.flatMap f)) : ∃ x ∈ l, q ∈ wires (f x) := by
  induction l with
  | nil => simp [wires] at h
  | cons a l ih =>
    rw [List.flatMap_cons, wires_append, Finset.mem_union] at h
    rcases h with h | h
    · exact ⟨a, List.mem_cons.mpr (Or.inl rfl), h⟩
    · obtain ⟨x, hx, hq⟩ := ih h
      exact ⟨x, List.mem_cons.mpr (Or.inr hx), hq⟩

theorem kbMem_wires_move (a b q : Wire) (h : q ∈ wires (moveWire a b)) : q = a ∨ q = b := by
  simp [moveWire, wires, Instr.wires] at h
  tauto

theorem signExt_rowSites : ∀ B ∈ budgets, ∀ q ∈ wires (signExt B), q ∈ rowSites B := by
  -- K4-B (replay budget): `signExt B` is one CX from the top D-rail bit onto `bSite B`
  intro B hB q hq
  have h2 : 2 ≤ B := by
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    omega
  rw [show signExt B = StairBridgeSign.signExtend ((physicalLayout B).D (B - 1)) (bSite B) from rfl,
    StairBridgeSign.signExtend_support, List.mem_toFinset] at hq
  rcases List.mem_cons.mp hq with h | h
  · rw [h]
    exact (kbRail_rowSites B (B - 1) (by omega)).2
  · rw [List.mem_singleton.mp h]
    simp only [rowSites, List.mem_append, List.mem_cons, true_or, or_true]

theorem relocate_rowSites : ∀ B ∈ budgets,
    (∀ q ∈ wires (relocate B), q ∈ rowSites B) ∧
      (∀ q ∈ wires (unrelocate B), q ∈ rowSites B) := by
  intro B hB
  have h2 : 2 ≤ B := by
    simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
    omega
  constructor
  · intro q hq
    unfold relocate at hq
    rw [wires_append, Finset.mem_union] at hq
    rcases hq with hq | hq
    · obtain ⟨i, hi, hq⟩ := kbMem_wires_flatMap _ _ q hq
      have hi' := List.mem_range.mp hi
      rcases kbMem_wires_move _ _ q hq with rfl | rfl
      · exact (kbRail_rowSites B i (by omega)).2
      · exact (kbRail_rowSites B i (by omega)).1
    · rcases kbMem_wires_move _ _ q hq with rfl | rfl
      · exact (kbRail_rowSites B (B - 1) (by omega)).2
      · exact (kbRail_rowSites B (B - 2) (by omega)).1
  · intro q hq
    unfold unrelocate at hq
    rw [wires_append, Finset.mem_union] at hq
    rcases hq with hq | hq
    · rcases kbMem_wires_move _ _ q hq with rfl | rfl
      · exact (kbRail_rowSites B (B - 2) (by omega)).1
      · exact (kbRail_rowSites B (B - 1) (by omega)).2
    · obtain ⟨i, hi, hq⟩ := kbMem_wires_flatMap _ _ q hq
      have hi' := List.mem_range.mp hi
      rcases kbMem_wires_move _ _ q hq with rfl | rfl
      · exact (kbRail_rowSites B i (by omega)).1
      · exact (kbRail_rowSites B i (by omega)).2

/-- K4-B (replay budget): decided on the closed-form placement and interval tests. -/
theorem orientLetter_good : ∀ B ∈ budgets, Good (letterSite (startFor B - 1)) := by
  have fast : budgets.all
      (fun B => goodB (StairPlaceFast.outerPlaceB (letterSite (startFor B - 1)))) = true := by
    decide +kernel
  intro B hB
  have h := good_of_goodB _ (List.all_eq_true.mp fast B hB)
  rw [← StairPlaceFast.outerPlace_eqB] at h
  exact h

theorem declared_rowSites (B : Nat) (q : Wire)
    (h : q ∈ StairCodec.declaredSites (physicalLayout B) B) : q ∈ rowSites B := by
  simp only [rowSites, List.mem_append, h, true_or]

theorem budget_three : ∀ B ∈ budgets, 3 ≤ B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  omega

theorem budget_shape : ∀ B ∈ budgets,
    512 - startFor B = B ∧ segmentOf (startFor B + 1) = B ∧
      startFor B + 1 + (endFor B - startFor B - 1) = endFor B ∧
      endFor B ≤ 512 ∧ 5 < startFor B + 1 ∧ startFor B < endFor B := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

/-! ## Every primitive wire is a row site -/

/-- Row sites plus the orientation letter of the row. -/
def rowSitesL (B : Nat) : List Wire := letterSite (startFor B - 1) :: rowSites B

theorem rowSitesL_good : ∀ B ∈ budgets, ∀ q ∈ rowSitesL B, Good q := by
  intro B hB q hq
  rcases List.mem_cons.mp hq with h | h
  · rw [h]
    exact orientLetter_good B hB
  · exact rowSites_good B hB q h

/-- LT11's caller domain (`StairCallerDomain.callerIndices.map base`), as a list. -/
def callerList : List Wire := (List.range' 0 2314 ++ [2400, 2409, 2410, 2411]).map base

/-- LT41 (replay budget): `callerList` as an interval test (`base q = q + 16`); list membership was
the cost of `rowSitesL_caller` (198 s of kernel time → ≈ 1 s). -/
def callerB (v : Nat) : Bool :=
  (decide (16 ≤ v) && decide (v < 2330)) || v == 2416 || v == 2425 || v == 2426 || v == 2427

theorem mem_callerList_of (v : Nat) (h : callerB v = true) : v ∈ callerList := by
  unfold callerList
  rw [List.mem_map]
  simp only [callerB, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  rcases h with (((⟨h1, h2⟩ | h3) | h4) | h5) | h6
  · exact ⟨v - 16, List.mem_append_left _ (List.mem_range'_1.mpr ⟨by omega, by omega⟩),
      by simp only [base]; omega⟩
  · exact ⟨2400, List.mem_append_right _ (by simp), by simp only [base]; omega⟩
  · exact ⟨2409, List.mem_append_right _ (by simp), by simp only [base]; omega⟩
  · exact ⟨2410, List.mem_append_right _ (by simp), by simp only [base]; omega⟩
  · exact ⟨2411, List.mem_append_right _ (by simp), by simp only [base]; omega⟩

/-- K4-B (replay budget): `callerB` with kernel-primitive tests only. -/
def kbCallerF (v : Nat) : Bool :=
  (Nat.ble 16 v && Nat.blt v 2330) || Nat.beq v 2416 || Nat.beq v 2425 || Nat.beq v 2426 ||
    Nat.beq v 2427

theorem kbCallerF_callerB (v : Nat) (h : kbCallerF v = true) : callerB v = true := by
  unfold kbCallerF at h
  unfold callerB
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, Nat.ble_eq, Nat.blt_eq,
    decide_eq_true_eq, beq_iff_eq] at h ⊢
  exact h

/-- The caller-domain test once for the whole label family `kbFamP`. -/
theorem kbFam_caller : kbFamP.all (fun q => kbCallerF (StairPlaceFast.fieldPlaceB q)) = true := by
  decide +kernel

/-- K4-B (replay budget): from the family test `kbFam_caller` and `kbRowL_fam`. -/
theorem rowSitesL_callerB :
    ∀ B ∈ budgets, (rowSitesL B).all (fun q => callerB (fieldPlace q)) = true := by
  intro B hB
  rw [List.all_eq_true]
  intro q hq
  rw [StairPlaceFast.fieldPlace_eqB]
  exact kbCallerF_callerB _ (List.all_eq_true.mp kbFam_caller q (kbRowL_fam B hB q hq))

/-- Kernel labels of all row sites are in the caller domain: no shadow label and
no metadata label other than the four selector/flag labels. -/
theorem rowSitesL_caller : ∀ B ∈ budgets, ∀ q ∈ rowSitesL B, fieldPlace q ∈ callerList :=
  fun B hB q hq => mem_callerList_of _ (List.all_eq_true.mp (rowSitesL_callerB B hB) q hq)

theorem pack_rows : ∀ B ∈ budgets, ∀ q ∈ wires (pack B), q ∈ rowSitesL B := by
  intro B hB q hq
  apply List.mem_cons_of_mem
  simp only [pack, wires_append, Finset.mem_union] at hq
  rcases hq with (sign | codec) | moved
  · exact signExt_rowSites B hB q sign
  · exact declared_rowSites B q (List.mem_toFinset.mp
      (StairCodec.pack_support _ B (budget_three B hB) codec))
  · exact (relocate_rowSites B hB).1 q moved

theorem unpack_rows : ∀ B ∈ budgets, ∀ q ∈ wires (unpack B), q ∈ rowSitesL B := by
  intro B hB q hq
  apply List.mem_cons_of_mem
  simp only [unpack, wires_append, Finset.mem_union] at hq
  rcases hq with (moved | codec) | sign
  · exact (relocate_rowSites B hB).2 q moved
  · exact declared_rowSites B q (List.mem_toFinset.mp
      (StairCodec.unpack_support _ B (budget_three B hB) codec))
  · exact signExt_rowSites B hB q sign

theorem orient_rows : ∀ B ∈ budgets, ∀ q ∈ wires (orient (startFor B)), q ∈ rowSitesL B := by
  intro B hB q hq
  obtain ⟨s1, -, -, -, -, -⟩ := budget_shape B hB
  unfold orient at hq
  rw [s1] at hq
  have mem := List.mem_toFinset.mp (StairCodec.orient_support _ _ B hq)
  simp only [List.mem_append, List.mem_cons] at mem
  rcases mem with (letter | sreg) | dreg
  · exact List.mem_cons.mpr (Or.inl letter)
  · apply List.mem_cons_of_mem
    apply declared_rowSites B q
    simp only [StairCodec.declaredSites, List.mem_append, sreg, true_or]
  · apply List.mem_cons_of_mem
    apply declared_rowSites B q
    simp only [StairCodec.declaredSites, List.mem_append, dreg, true_or, or_true]


theorem tickReverse_rows : ∀ B ∈ budgets,
    ∀ q ∈ wires (tickReverse (startFor B)), q ∈ rowSitesL B := by
  intro B hB q hq
  obtain ⟨s1, -, -, s4, -, s6⟩ := budget_shape B hB
  unfold tickReverse at hq
  rw [s1] at hq
  apply List.mem_cons_of_mem
  exact tick_rowSites B hB (startFor B) s6 le_rfl q
