private theorem halfE_free_ids (divide : Bool) (i : Nat)
    (hi : i < 512 ∨ (1027 < i ∧ i < 1540) ∨ (1541 < i ∧ i < 1797) ∨ (1797 < i ∧ i < 2056) ∨ (2312 < i ∧ i ≠ 2409)) :
