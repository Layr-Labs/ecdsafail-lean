def natBitLength (x : Nat) : Nat := if x = 0 then 0 else x.log2 + 1

def signedWord (B u : Nat) (sigma : Bool) : Nat :=
  if sigma then (2 ^ B - u) % 2 ^ B else u % 2 ^ B

def compactF (B w v : Nat) : Nat :=
  (List.range (B - 2)).foldl (fun acc j =>
    if ((if j + 1 = natBitLength w then false else w.testBit j) ^^
      ((v - 1) / 2).testBit (B - 3 - j))
    then acc + 2 ^ j else acc) 0

def CodecDomain (B u v : Nat) (sigma : Bool) : Prop :=
  3 ≤ B ∧ 0 < v ∧ v % 2 = 1 ∧ u + v < 2 ^ B ∧
  natBitLength u + natBitLength v ≤ B ∧
  (u = 0 → v = 1 ∧ sigma = false)

def cleanOn (qs : List Wire) (s : BasisState) : Prop := ∀ q ∈ qs, s q = false


def CompactCode (L : Layout) (B u v : Nat) (sigma : Bool) (s : BasisState) : Prop :=
  let w := u - sigma.toNat
  regValue (reg L.A (bitWidth B)) s = natBitLength w ∧
  regValue (reg L.D (B - 2)) s = compactF B w v ∧
  s (L.D (B - 2)) = false ∧ s (L.D (B - 1)) = sigma ∧
  regValue (reg L.S B) s = 0 ∧
  cleanOn (reg L.C (B - 2) ++ [L.z, L.t] ++
    (lowDecoder L B).sites ++ (highDecoder L B).sites) s



private theorem nat_lt_pow_bitLength (x : Nat) (hx : 0 < x) :
    x < 2 ^ natBitLength x := by
  have hlog : x.log2 < x.log2 + 1 := by omega
  have hpow := (Nat.log2_lt (by omega : x ≠ 0)).mp hlog
  simpa [natBitLength, ne_of_gt hx] using hpow

/-- Arithmetic non-overlap used by the descending sweep: once the magnitude
still reaches bit `j+1`, the mirrored `v` bit is outside its budget. -/
theorem nonoverlap_zero (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma)
    (hlarge : 2 ^ (j + 1) ≤ u - sigma.toNat) :
    v.testBit (B - 2 - j) = false := by
  have hu : u - sigma.toNat ≤ u := Nat.sub_le _ _
  have hw0 : 0 < u - sigma.toNat := lt_of_lt_of_le (by positivity) hlarge
  have hu0 : 0 < u := lt_of_lt_of_le hw0 hu
  have hub := nat_lt_pow_bitLength u hu0
  have hlen : j + 2 ≤ natBitLength u := by
    by_contra hbad
    have hle : natBitLength u ≤ j + 1 := by omega
    have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hle
    omega
  have hvb := nat_lt_pow_bitLength v hd.2.1
  have hvl : natBitLength v ≤ B - 2 - j := by
    have := hd.2.2.2.2.1
    omega
  have hp := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) hvl
  have hvpow : v < 2 ^ (B - 2 - j) := lt_of_lt_of_le hvb hp
  exact Nat.testBit_lt_two_pow hvpow

private theorem odd_half_testBit (v r : Nat) (hodd : v % 2 = 1) :
    ((v - 1) / 2).testBit r = v.testBit (r + 1) := by
  rw [Nat.testBit_succ]
  congr 1
  have hdiv := Nat.mod_add_div v 2
  omega

theorem nonoverlap_half_zero (B u v : Nat) (sigma : Bool) (j : Nat)
    (hd : CodecDomain B u v sigma) (hj : j < B - 2)
    (hlarge : 2 ^ (j + 1) ≤ u - sigma.toNat) :
    ((v - 1) / 2).testBit (B - 3 - j) = false := by
  rw [odd_half_testBit v (B - 3 - j) hd.2.2.1]
  have hz := nonoverlap_zero B u v sigma j hd hlarge
  have heq : B - 3 - j + 1 = B - 2 - j := by omega
  rwa [heq]

