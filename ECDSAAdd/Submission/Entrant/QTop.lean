/-! ### merged from `ECDSAAdd.Submission.Entrant.StairLoan_at_QTop` -/
section Merge_StairLoan_at_QTop

/-!
# Staircase carry loans

The local primitive used by the staircase field schedule is independent of the
arithmetic performed at the top of a carry sweep.  Once a prefix of carries has
been computed, `erasePrefix` erases it in the only safe order (high to low).
The same prefix is recomputed low to high by `carryPrefix` after the upper
program has returned the borrowed sites clean.

`loanWindow d ... upper` is therefore the common `+d` CCX / `+d` measurement
piece inserted at each of the four sweep tops of a regular half.  The sources
are `MappedBit`s, so the one construction covers ordinary, complemented, and
constant-source adders.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace ECDSAAdd.Entrant.StairLoan

open Arithmetic Challenge MappedCompressed Secp256k1 BalancedField

/-! ## LT44 (replay budget): linear list checks with a bit mask

`List.Nodup` and list membership by `decide` are quadratic / linear walks over unevaluated
wire lists (≈ 47 s of kernel time for one 770-wire `Nodup`).  With a `Nat` bit mask the kernel
does one GMP `|||` / `>>>` per element (< 1 s). -/

/-- Duplicate scan: `m` holds the wires already seen. -/
def nodupMask : List Nat → Nat → Bool
  | [], _ => true
  | x :: xs, m => !(m.testBit x) && nodupMask xs (m ||| 2 ^ x)

theorem nodupMask_sound : ∀ (l : List Nat) (m : Nat), nodupMask l m = true →
    l.Nodup ∧ ∀ x ∈ l, m.testBit x = false
  | [], _, _ => ⟨List.nodup_nil, fun _ h => absurd h List.not_mem_nil⟩
  | x :: xs, m, h => by
    simp only [nodupMask, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨hx, hr⟩ := h
    obtain ⟨nd, av⟩ := nodupMask_sound xs _ hr
    have key : ∀ y ∈ xs, y ≠ x ∧ m.testBit y = false := by
      intro y hy
      have t := av y hy
      rw [Nat.testBit_or, Bool.or_eq_false_iff] at t
      refine ⟨?_, t.1⟩
      rintro rfl
      rw [Nat.testBit_two_pow_self] at t
      exact absurd t.2 (by decide)
    refine ⟨List.nodup_cons.mpr ⟨fun hmem => (key x hmem).1 rfl, nd⟩, ?_⟩
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · exact hx
    · exact (key y hy).2

/-- `l.Nodup` from one linear kernel evaluation: `nodup_of_mask _ (by decide +kernel)`. -/
theorem nodup_of_mask (l : List Wire) (h : nodupMask l 0 = true) : l.Nodup :=
  (nodupMask_sound l 0 h).1

/-- The bit mask of a wire list. -/
def maskOf : List Nat → Nat
  | [] => 0
  | x :: xs => 2 ^ x ||| maskOf xs

theorem testBit_maskOf : ∀ (l : List Nat) (q : Nat), (maskOf l).testBit q = decide (q ∈ l)
  | [], q => by simp [maskOf]
  | x :: xs, q => by
    simp only [maskOf, Nat.testBit_or, testBit_maskOf xs q, Nat.testBit_two_pow,
      List.mem_cons, Bool.decide_or]
    congr 1
    exact decide_eq_decide.mpr eq_comm

theorem mem_of_maskOf {l : List Wire} {q : Wire} (h : (maskOf l).testBit q = true) : q ∈ l := by
  rw [testBit_maskOf] at h
  exact of_decide_eq_true h

theorem not_mem_of_maskOf {l : List Wire} {q : Wire} (h : (maskOf l).testBit q = false) :
    q ∉ l := by
  rw [testBit_maskOf] at h
  exact of_decide_eq_false h

/-- Compute the first `d` carries, from low to high. -/
def carryPrefix : Nat → List MappedBit → List Wire → List Wire → Wire → Program
  | d+1, b::bits, y::ys, c::cs, cin =>
      mappedMajority b y cin c ++ carryPrefix d bits ys cs c
  | _, _, _, _, _ => []

/-- Erase the first `d` already-computed carries, from high to low. -/
def erasePrefix : Nat → List MappedBit → List Wire → List Wire → Wire → Program
  | d+1, b::bits, y::ys, c::cs, cin =>
      erasePrefix d bits ys cs c ++ mappedEraseCarry b y cin c
  | _, _, _, _, _ => []


/-- High logical carry roles, in loan order.  CANON v3 (k = 44 re-plan): the
44 genuinely omittable roles `720 .. 759, 761 .. 764` come first, so that a
loan of depth `d ≤ 44` frees exactly the first `d` of them; the 24 roles
`696 .. 719` (which free no physical site) follow.  Same 68-element set as
before (`(List.range' 696 69).filter (· != 760)`), reordered. -/
def retiredRoleIndices : List Nat :=
  (List.range' 720 45).filter (fun i => i != 760) ++ List.range' 696 24


def retiredRoles : List Wire := retiredRoleIndices.map base

theorem retiredRoleIndices_length : retiredRoleIndices.length=68 := by decide +kernel
theorem retiredRoles_length : retiredRoles.length=68 := by
  simp [retiredRoles,retiredRoleIndices_length]

/-- Relabel matching logical roles into clean host sites.  Extra entries on
    either side are deliberately ignored. -/
def rebindMany : List Wire → List Wire → Program → Program
  | r::rs, h::hs, P => renameProgram (Equiv.swap r h) (rebindMany rs hs P)
  | _, _, P => P

theorem rebindMany_counts (roles hosts : List Wire) (P : Program) :
    toffoliCount (rebindMany roles hosts P)=toffoliCount P ∧
      measurementCount (rebindMany roles hosts P)=measurementCount P := by
  induction roles generalizing hosts with
  | nil => exact ⟨rfl,rfl⟩
  | cons r roles ih =>
      cases hosts with
      | nil => exact ⟨rfl,rfl⟩
      | cons h hosts =>
          have tail := ih hosts
          have renamed := renameProgram_counts (Equiv.swap r h)
            (rebindMany roles hosts P)
          exact ⟨renamed.1.trans tail.1,renamed.2.trans tail.2⟩

/-- Rebinding any finite collection of sites that is zero both before and
    after the upper block preserves the complete state and phase. -/
theorem rebindMany_run (roles hosts : List Wire) (P : Program)
    (s : State) (m : List Bool)
    (zeroIn : ∀q∈roles++hosts,s.basis q=false)
    (zeroOut : ∀q∈roles++hosts,(run P m s).basis q=false) :
    run (rebindMany roles hosts P) m s=run P m s := by
  induction roles generalizing hosts with
  | nil => rfl
  | cons r roles ih =>
      cases hosts with
      | nil => rfl
      | cons h hosts =>
          have tailIn : ∀q∈roles++hosts,s.basis q=false := by
            intro q hq
            exact zeroIn q (by simp only [List.mem_append,List.mem_cons] at hq ⊢; tauto)
          have tailOut : ∀q∈roles++hosts,(run P m s).basis q=false := by
            intro q hq
            exact zeroOut q (by simp only [List.mem_append,List.mem_cons] at hq ⊢; tauto)
          have tail := ih hosts tailIn tailOut
          have rin : s.basis r=false := zeroIn r (by simp)
          have hin : s.basis h=false := zeroIn h (by simp)
          have rout : (run (rebindMany roles hosts P) m s).basis r=false := by
            rw [tail]
            exact zeroOut r (by simp)
          have hout : (run (rebindMany roles hosts P) m s).basis h=false := by
            rw [tail]
            exact zeroOut h (by simp)
          exact (NewFieldFrameOB5.rebind_swap_run r h
            (rebindMany roles hosts P) s m rin hin rout hout).trans tail

theorem rebindMany_preserves_fresh (roles hosts : List Wire) (P : Program)
    (q : Wire) (freshMap : q∉roles++hosts) (freshP : q∉wires P) :
    q∉wires (rebindMany roles hosts P) := by
  induction roles generalizing hosts with
  | nil => exact freshP
  | cons r roles ih =>
      cases hosts with
      | nil => exact freshP
      | cons h hosts =>
          have qr : q≠r := by
            intro eq
            exact freshMap (by simp [eq])
          have qh : q≠h := by
            intro eq
            exact freshMap (by simp [eq])
          have tailFresh : q∉roles++hosts := by
            intro bad
            exact freshMap (by simp only [List.mem_append,List.mem_cons] at bad ⊢; tauto)
          rw [rebindMany,renameProgram_support]
          intro used
          obtain ⟨x,hx,eq⟩ := Finset.mem_image.mp used
          have xq : x=q := by
            apply (Equiv.swap r h).injective
            rw [eq,Equiv.swap_apply_of_ne_of_ne qr qh]
          exact (ih hosts tailFresh) (xq ▸ hx)

/-- If the role and host banks are disjoint and the original upper block does
    not touch hosts, every rebound logical role disappears from support. -/
theorem rebindMany_roles_free (roles hosts : List Wire) (P : Program)
    (len : roles.length=hosts.length) (nd : (roles++hosts).Nodup)
    (hostFree : ∀h∈hosts,h∉wires P) :
    ∀r∈roles,r∉wires (rebindMany roles hosts P) := by
  induction roles generalizing hosts with
  | nil => simp
  | cons r roles ih =>
      cases hosts with
      | nil => simp at len
      | cons h hosts =>
          have parts := List.nodup_append'.mp nd
          have rnd := List.nodup_cons.mp parts.1
          have hnd := List.nodup_cons.mp parts.2.1
          have dis : List.Disjoint (r::roles) (h::hosts) := parts.2.2
          have tailND : (roles++hosts).Nodup := by
            apply List.nodup_iff_count.mpr
            intro q
            have all := List.nodup_iff_count.mp nd q
            simp only [List.count_append,List.count_cons] at all ⊢
            omega
          have tailFree : ∀x∈hosts,x∉wires P := by
            intro x hx
            exact hostFree x (by simp [hx])
          have tailRoles := ih hosts (by simpa using len) tailND tailFree
          have hAwayRoles : h∉roles := by
            intro hh
            exact List.disjoint_left.mp dis (List.mem_cons_of_mem r hh)
              (List.mem_cons_self)
          have hAwayTail : h∉roles++hosts := by simp [hAwayRoles,hnd.1]
          have hFresh : h∉wires (rebindMany roles hosts P) :=
            rebindMany_preserves_fresh roles hosts P h hAwayTail
              (hostFree h (by simp))
          intro x hx
          rw [rebindMany,renameProgram_support]
          intro used
          obtain ⟨z,hz,eq⟩ := Finset.mem_image.mp used
          simp only [List.mem_cons] at hx
          rcases hx with eqx|hx
          · have xrEq : x=r := by simpa only [eq_comm] using eqx
            have zh : z=h := by
              apply (Equiv.swap r h).injective
              calc
                (Equiv.swap r h) z = x := eq
                _ = r := xrEq
                _ = (Equiv.swap r h) h := by simp
            exact hFresh (zh ▸ hz)
          · have xr : x≠r := by
              intro bad
              exact rnd.1 (bad ▸ hx)
            have xh : x≠h := by
              intro bad
              exact List.disjoint_left.mp dis (List.mem_cons_of_mem r hx) (by
                rw [←bad]
                exact List.mem_cons_self)
            have zx : z=x := by
              apply (Equiv.swap r h).injective
              rw [eq,Equiv.swap_apply_of_ne_of_ne xr xh]
            exact tailRoles x hx (zx ▸ hz)



/-- One level of a reversible carry sweep.  `up` computes `host`, `erase`
    measures it after the upper recursion, and `finish` contains the remaining
    Clifford sum updates. -/
structure CarryLayer where
  host : Wire
  up : Program
  erase : Program
  finish : Program

def CarryLayer.down (l : CarryLayer) : Program := l.erase++l.finish

def layerHosts (ls : List CarryLayer) : List Wire := ls.map CarryLayer.host

def emitUps : List CarryLayer → Program
  | [] => []
  | l::ls => l.up++emitUps ls

def emitErases : List CarryLayer → Program
  | [] => []
  | l::ls => emitErases ls++l.erase

def emitDowns : List CarryLayer → Program
  | [] => []
  | l::ls => emitDowns ls++l.down

def emitSweep (ls : List CarryLayer) (top : Program) : Program :=
  emitUps ls++top++emitDowns ls

/-- Compute through one boundary carry, erase `d` lower hosts, relocate the
    upper sweep, then restore the lower carries before its down-pass. -/
def emitLoan (d : Nat) (roles : List Wire) (ls : List CarryLayer)
    (top : Program) : Program :=
  let boundary := ls.take (d+1)
  let borrowed := ls.take d
  emitUps boundary ++ emitErases borrowed ++
    rebindMany (roles.take d) (layerHosts borrowed)
      (emitSweep (ls.drop (d+1)) top) ++
    emitUps borrowed ++ emitDowns boundary

def LayerUnit (l : CarryLayer) : Prop :=
  toffoliCount l.up=1 ∧ measurementCount l.up=0 ∧
  toffoliCount l.erase=0 ∧ measurementCount l.erase=1 ∧
  toffoliCount l.finish=0 ∧ measurementCount l.finish=0

theorem emitUps_counts (ls : List CarryLayer) (unit : ∀l∈ls,LayerUnit l) :
    toffoliCount (emitUps ls)=ls.length ∧ measurementCount (emitUps ls)=0 := by
  induction ls with
  | nil => exact ⟨rfl,rfl⟩
  | cons l ls ih =>
      have head := unit l (by simp)
      rcases head with ⟨huT,huM,heT,heM,hfT,hfM⟩
      have tail := ih (by
        intro x hx
        exact unit x (by simp [hx]))
      constructor
      · simp [emitUps,toffoliCount_append,huT,tail.1,Nat.add_comm]
      · simp [emitUps,measurementCount_append,huM,tail.2]

theorem emitErases_counts (ls : List CarryLayer) (unit : ∀l∈ls,LayerUnit l) :
    toffoliCount (emitErases ls)=0 ∧ measurementCount (emitErases ls)=ls.length := by
  induction ls with
  | nil => exact ⟨rfl,rfl⟩
  | cons l ls ih =>
      have head := unit l (by simp)
      rcases head with ⟨huT,huM,heT,heM,hfT,hfM⟩
      have tail := ih (by
        intro x hx
        exact unit x (by simp [hx]))
      constructor
      · simp [emitErases,toffoliCount_append,heT,tail.1]
      · simp [emitErases,measurementCount_append,heM,tail.2]

theorem emitDowns_counts (ls : List CarryLayer) (unit : ∀l∈ls,LayerUnit l) :
    toffoliCount (emitDowns ls)=0 ∧ measurementCount (emitDowns ls)=ls.length := by
  induction ls with
  | nil => exact ⟨rfl,rfl⟩
  | cons l ls ih =>
      have head := unit l (by simp)
      rcases head with ⟨huT,huM,heT,heM,hfT,hfM⟩
      have tail := ih (by
        intro x hx
        exact unit x (by simp [hx]))
      constructor
      · simp [emitDowns,CarryLayer.down,toffoliCount_append,heT,hfT,tail.1]
      · simp [emitDowns,CarryLayer.down,measurementCount_append,heM,hfM,tail.2]

theorem emitSweep_counts (ls : List CarryLayer) (top : Program)
    (unit : ∀l∈ls,LayerUnit l) :
    toffoliCount (emitSweep ls top)=toffoliCount top+ls.length ∧
    measurementCount (emitSweep ls top)=measurementCount top+ls.length := by
  have up := emitUps_counts ls unit
  have down := emitDowns_counts ls unit
  simp only [emitSweep,toffoliCount_append,measurementCount_append,
    up.1,up.2,down.1,down.2]
  omega

theorem emitLoan_counts (d : Nat) (roles : List Wire) (ls : List CarryLayer)
    (top : Program) (hd : d≤ls.length) (unit : ∀l∈ls,LayerUnit l) :
    toffoliCount (emitLoan d roles ls top)=toffoliCount (emitSweep ls top)+d ∧
    measurementCount (emitLoan d roles ls top)=measurementCount (emitSweep ls top)+d := by
  have boundaryUnit : ∀l∈ls.take (d+1),LayerUnit l := by
    intro l hl
    exact unit l (List.mem_of_mem_take hl)
  have borrowedUnit : ∀l∈ls.take d,LayerUnit l := by
    intro l hl
    exact unit l (List.mem_of_mem_take hl)
  have upperUnit : ∀l∈ls.drop (d+1),LayerUnit l := by
    intro l hl
    exact unit l (List.mem_of_mem_drop hl)
  have boundaryUp := emitUps_counts (ls.take (d+1)) boundaryUnit
  have boundaryDown := emitDowns_counts (ls.take (d+1)) boundaryUnit
  have borrowedUp := emitUps_counts (ls.take d) borrowedUnit
  have borrowedErase := emitErases_counts (ls.take d) borrowedUnit
  have upper := emitSweep_counts (ls.drop (d+1)) top upperUnit
  have rebound := rebindMany_counts (roles.take d) (layerHosts (ls.take d))
    (emitSweep (ls.drop (d+1)) top)
  have whole := emitSweep_counts ls top unit
  simp only [emitLoan,toffoliCount_append,measurementCount_append,
    boundaryUp.1,boundaryUp.2,boundaryDown.1,boundaryDown.2,
    borrowedUp.1,borrowedUp.2,borrowedErase.1,borrowedErase.2,
    rebound.1,rebound.2,upper.1,upper.2,whole.1,whole.2,
    List.length_take,List.length_drop]
  omega

theorem emitLoan_zero (roles : List Wire) (ls : List CarryLayer) (top : Program) :
    emitLoan 0 roles ls top=emitSweep ls top := by
  cases ls with
  | nil => simp [emitLoan,emitSweep,emitUps,emitErases,emitDowns,rebindMany]
  | cons l ls =>
      simp [emitLoan,emitSweep,emitUps,emitErases,emitDowns,rebindMany,
        layerHosts,CarryLayer.down,List.append_assoc]

theorem emitUps_append (xs ys : List CarryLayer) :
    emitUps (xs++ys)=emitUps xs++emitUps ys := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp [emitUps,ih,List.append_assoc]

theorem emitDowns_append (xs ys : List CarryLayer) :
    emitDowns (xs++ys)=emitDowns ys++emitDowns xs := by
  induction xs with
  | nil => simp [emitDowns]
  | cons x xs ih => simp [emitDowns,ih,List.append_assoc]

theorem emitSweep_split (n : Nat) (ls : List CarryLayer) (top : Program) :
    emitSweep ls top=
      emitUps (ls.take n)++emitSweep (ls.drop n) top++emitDowns (ls.take n) := by
  conv_lhs => rw [←List.take_append_drop n ls]
  simp only [emitSweep,emitUps_append,emitDowns_append,List.append_assoc]

/-- Tape-independent semantic compositor for a complete staircase sweep.  The
    hypotheses expose the six actual handoff states: computed boundary,
    cleared hosts, relocated upper output, recomputed carries, and down-pass
    output. -/
theorem emitLoan_run (d : Nat) (roles : List Wire) (ls : List CarryLayer)
    (top : Program) (s u uc vc v t : State) (m n : List Bool)
    (hprefix : ∀r,run (emitUps (ls.take (d+1))) r s=u)
    (herase : ∀r,run (emitErases (ls.take d)) r u=uc)
    (hupper : ∀r,run (emitSweep (ls.drop (d+1)) top) r u=v)
    (hmoved : ∀r,run (rebindMany (roles.take d)
      (layerHosts (ls.take d)) (emitSweep (ls.drop (d+1)) top)) r uc=vc)
    (hrecompute : ∀r,run (emitUps (ls.take d)) r vc=v)
    (hsuffix : ∀r,run (emitDowns (ls.take (d+1))) r v=t) :
    run (emitLoan d roles ls top) m s=t ∧ run (emitSweep ls top) n s=t := by
  constructor
  · simp only [emitLoan,run_append]
    rw [hprefix,herase,hmoved,hrecompute,hsuffix]
  · rw [emitSweep_split (d+1),run_append,run_append,hprefix,hupper,hsuffix]

def mappedLayers : List MappedBit → List Wire → List Wire → Wire → List CarryLayer
  | b::b'::bits, y::y'::ys, c::cs, cin =>
      { host:=c, up:=mappedMajority b y cin c,
        erase:=mappedEraseCarry b y cin c, finish:=mappedSum b y cin } ::
        mappedLayers (b'::bits) (y'::ys) cs c
  | _, _, _, _ => []

def mappedTop : List MappedBit → List Wire → List Wire → Wire → Program
  | _::b'::bits, _::y'::ys, c::cs, _ => mappedTop (b'::bits) (y'::ys) cs c
  | [b], [y], _, cin => mappedSum b y cin
  | _, _, _, _ => []

def mappedAddLoan (d : Nat) (roles : List Wire) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) : Program :=
  emitLoan d roles (mappedLayers bits ys cs cin) (mappedTop bits ys cs cin)

theorem mappedAdd_as_sweep (bits : List MappedBit) (ys cs : List Wire) (cin : Wire) :
    mappedAdd bits ys cs cin=
      emitSweep (mappedLayers bits ys cs cin) (mappedTop bits ys cs cin) := by
  induction bits generalizing ys cs cin with
  | nil => simp [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns]
  | cons b bits ih =>
      cases bits with
      | nil =>
          cases ys with
          | nil => simp [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns]
          | cons y ys =>
              cases ys <;> simp [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns]
      | cons b' bits =>
          cases ys with
          | nil => simp [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns]
          | cons y ys =>
              cases ys with
              | nil => simp [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns]
              | cons y' ys =>
                  cases cs with
                  | nil => simp [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns]
                  | cons c cs =>
                      rw [mappedAdd,mappedLayers,mappedTop,emitSweep,emitUps,emitDowns,
                        CarryLayer.down,ih (y'::ys) cs c]
                      simp [emitSweep,List.append_assoc]

theorem mappedLayers_unit (bits : List MappedBit) (ys cs : List Wire) (cin : Wire) :
    ∀l∈mappedLayers bits ys cs cin,LayerUnit l := by
  induction bits generalizing ys cs cin with
  | nil => simp [mappedLayers]
  | cons b bits ih =>
      cases bits with
      | nil => simp [mappedLayers]
      | cons b' bits =>
          cases ys with
          | nil => simp [mappedLayers]
          | cons y ys =>
              cases ys with
              | nil => simp [mappedLayers]
              | cons y' ys =>
                  cases cs with
                  | nil => simp [mappedLayers]
                  | cons c cs =>
                      intro l hl
                      simp only [mappedLayers,List.mem_cons] at hl
                      rcases hl with rfl|hl
                      · have k := mappedBit_counts b y cin c
                        exact ⟨k.1,k.2.1,k.2.2.1,k.2.2.2.1,k.2.2.2.2.1,k.2.2.2.2.2⟩
                      · exact ih (y'::ys) cs c l hl

theorem mappedLayers_length (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length) :
    (mappedLayers bits ys cs cin).length=cs.length := by
  induction bits generalizing ys cs cin with
  | nil =>
      have ye : ys=[] := List.eq_nil_of_length_eq_zero hb.symm
      subst ys
      simp at hc
  | cons b bits ih =>
      cases ys with
      | nil => simp at hb
      | cons y ys =>
          cases bits with
          | nil =>
              have yl : ys=[] := List.eq_nil_of_length_eq_zero (by simpa using hb)
              subst ys
              have cl : cs=[] := List.eq_nil_of_length_eq_zero (by
                simp only [List.length_cons,List.length_nil] at hc
                omega)
              subst cs
              rfl
          | cons b' bits =>
              cases ys with
              | nil => simp at hb
              | cons y' ys =>
                  cases cs with
                  | nil => simp at hc
                  | cons c cs =>
                      simp only [mappedLayers,List.length_cons]
                      rw [ih (y'::ys) cs c (by simpa using hb) (by simpa using hc)]

theorem mappedAddLoan_counts (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length)
    (hd : d≤cs.length) :
    toffoliCount (mappedAddLoan d roles bits ys cs cin)=
        toffoliCount (mappedAdd bits ys cs cin)+d ∧
    measurementCount (mappedAddLoan d roles bits ys cs cin)=
        measurementCount (mappedAdd bits ys cs cin)+d := by
  have len := mappedLayers_length bits ys cs cin hb hc
  have loan := emitLoan_counts d roles (mappedLayers bits ys cs cin)
    (mappedTop bits ys cs cin) (by omega) (mappedLayers_unit bits ys cs cin)
  rw [←mappedAdd_as_sweep] at loan
  simpa only [mappedAddLoan] using loan

def literalLayers : List Wire → List Wire → Wire → Wire → Nat → List CarryLayer
  | x::x'::xs, c::cs, cin, one, k =>
      { host:=c, up:=literalConstStep (decide (k%2=1)) x cin c,
        erase:=literalConstErase (decide (k%2=1)) x cin c one,
        finish:=[] } :: literalLayers (x'::xs) cs c one (k/2)
  | _, _, _, _, _ => []

def literalTop : List Wire → List Wire → Wire → Wire → Nat → Program
  | _::x'::xs, c::cs, _, one, k => literalTop (x'::xs) cs c one (k/2)
  | [x], _, cin, _, k => literalConstSum (decide (k%2=1)) x cin
  | _, _, _, _, _ => []

def literalConstAddLoan (d : Nat) (roles : List Wire) (xs carry : List Wire)
    (cin one : Wire) (k : Nat) : Program :=
  if d=0 then literalConstAdd xs carry cin one k
  else mappedAddLoan d roles (mappedConstant none xs.length k) xs carry cin

theorem literalConstAdd_as_sweep (xs carry : List Wire) (cin one : Wire) (k : Nat) :
    literalConstAdd xs carry cin one k=
      emitSweep (literalLayers xs carry cin one k)
        (literalTop xs carry cin one k) := by
  induction xs generalizing carry cin k with
  | nil => simp [literalConstAdd,literalLayers,literalTop,emitSweep,emitUps,emitDowns]
  | cons x xs ih =>
      cases xs with
      | nil =>
          cases carry <;>
            simp [literalConstAdd,literalLayers,literalTop,emitSweep,emitUps,emitDowns]
      | cons x' xs =>
          cases carry with
          | nil => simp [literalConstAdd,literalLayers,literalTop,emitSweep,emitUps,emitDowns]
          | cons c cs =>
              rw [literalConstAdd,literalLayers,literalTop,emitSweep,emitUps,emitDowns,
                CarryLayer.down,ih cs c (k/2)]
              simp [emitSweep,List.append_assoc]




def mappedSubLoan (d : Nat) (roles : List Wire) (bits : List MappedBit)
    (ys carry : List Wire) (cin : Wire) : Program :=
  notRegister ys++mappedAddLoan d roles bits ys carry cin++notRegister ys

theorem mappedSubLoan_counts (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys carry : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : carry.length+1=ys.length)
    (hd : d≤carry.length) :
    toffoliCount (mappedSubLoan d roles bits ys carry cin)=
        toffoliCount (mappedSub bits ys carry cin)+d ∧
    measurementCount (mappedSubLoan d roles bits ys carry cin)=
        measurementCount (mappedSub bits ys carry cin)+d := by
  have loan := mappedAddLoan_counts d roles bits ys carry cin hb hc hd
  simp only [mappedSubLoan,mappedSub,toffoliCount_append,measurementCount_append,
    loan.1,loan.2]
  omega

def compareLayers (forward : Bool) :
    List Wire → List Wire → List Wire → Wire → Wire → List CarryLayer
  | a::a'::as, b::b'::bs, c::cs, cin, target =>
      { host:=c, up:=majority a b cin c,
        erase:=eraseCarry a b cin c, finish:=[] } ::
        compareLayers forward (a'::as) (b'::bs) cs c target
  | _, _, _, _, _ => []

def compareTop (forward : Bool) :
    List Wire → List Wire → List Wire → Wire → Wire → Program
  | [a], [b], _, cin, target => Q6LifetimeResearch.compareLeaf forward a b cin target
  | _::a'::as, _::b'::bs, c::cs, _, target =>
      compareTop forward (a'::as) (b'::bs) cs c target
  | _, _, _, _, _ => []

def compareLoan (d : Nat) (roles : List Wire) (forward : Bool)
    (as bs cs : List Wire) (cin target : Wire) : Program :=
  emitLoan d roles (compareLayers forward as bs cs cin target)
    (compareTop forward as bs cs cin target)

theorem compareChain_as_sweep (forward : Bool) (as bs cs : List Wire)
    (cin target : Wire) :
    Q6LifetimeResearch.compareChain forward as bs cs cin target=
      emitSweep (compareLayers forward as bs cs cin target)
        (compareTop forward as bs cs cin target) := by
  induction as generalizing bs cs cin with
  | nil =>
      cases bs <;> cases cs <;>
        simp [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
          emitSweep,emitUps,emitDowns]
  | cons a as ih =>
      cases as with
      | nil =>
          cases bs with
          | nil =>
              cases cs <;> simp [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
                emitSweep,emitUps,emitDowns]
          | cons b bs =>
              cases bs <;> cases cs <;>
                simp [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
                  emitSweep,emitUps,emitDowns]
      | cons a' as =>
          cases bs with
          | nil =>
              cases cs <;> simp [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
                emitSweep,emitUps,emitDowns]
          | cons b bs =>
              cases bs with
              | nil =>
                  cases cs <;> simp [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
                    emitSweep,emitUps,emitDowns]
              | cons b' bs =>
                  cases cs with
                  | nil => simp [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
                      emitSweep,emitUps,emitDowns]
                  | cons c cs =>
                      rw [Q6LifetimeResearch.compareChain,compareLayers,compareTop,
                        emitSweep,emitUps,emitDowns,CarryLayer.down,ih (b'::bs) cs c]
                      simp [emitSweep,List.append_assoc]




def prefixLayers : List Wire → List Wire → List Wire →
    Wire → Wire → Wire → Wire → List CarryLayer
  | x::xs, y::ys, c::cs, a, t, z, cin =>
      { host:=c, up:=majority x y cin c, erase:=eraseCarry x y cin c,
        finish:=[.CX x y,.CX cin y] } ::
        prefixLayers xs ys cs a t z c
  | _, _, _, _, _, _, _ => []

def prefixTop : List Wire → List Wire → List Wire →
    Wire → Wire → Wire → Wire → Program
  | [], [], [], a, t, z, cin => CoherentTail.program a t cin z
  | _::xs, _::ys, c::cs, a, t, z, _ => prefixTop xs ys cs a t z c
  | _, _, _, _, _, _, _ => []

def addPrefixLoan (d : Nat) (roles : List Wire) (xs ys carry : List Wire)
    (a t z cin : Wire) : Program :=
  emitLoan d roles (prefixLayers xs ys carry a t z cin)
    (prefixTop xs ys carry a t z cin)

theorem addPrefix_as_sweep (xs ys carry : List Wire) (a t z cin : Wire) :
    CoherentTail.addPrefix xs ys carry a t z cin=
      emitSweep (prefixLayers xs ys carry a t z cin)
        (prefixTop xs ys carry a t z cin) := by
  induction xs generalizing ys carry cin with
  | nil =>
      cases ys <;> cases carry <;>
        simp [CoherentTail.addPrefix,prefixLayers,prefixTop,emitSweep,emitUps,emitDowns]
  | cons x xs ih =>
      cases ys with
      | nil =>
          cases carry <;>
            simp [CoherentTail.addPrefix,prefixLayers,prefixTop,emitSweep,emitUps,emitDowns]
      | cons y ys =>
          cases carry with
          | nil => simp [CoherentTail.addPrefix,prefixLayers,prefixTop,emitSweep,emitUps,emitDowns]
          | cons c cs =>
              rw [CoherentTail.addPrefix,prefixLayers,prefixTop,emitSweep,emitUps,emitDowns,
                CarryLayer.down,ih ys cs c]
              simp [emitSweep,List.append_assoc]




def addTopLayers : List Wire → List Wire → List Wire → Wire → List CarryLayer
  | [_,_], [_,_], _, _ => []
  | a::a'::as, b::b'::bs, c::cs, cin =>
      { host:=c, up:=majority a b cin c, erase:=eraseCarry a b cin c,
        finish:=[.CX a b,.CX cin b] } :: addTopLayers (a'::as) (b'::bs) cs c
  | _, _, _, _ => []

def addTopTop : List Wire → List Wire → List Wire → Wire → Program
  | [a,_], [b,z], _, cin => Q6LifetimeResearch.dependentTop a b cin z
  | _::a'::as, _::b'::bs, c::cs, _ => addTopTop (a'::as) (b'::bs) cs c
  | _, _, _, _ => []

def addTopLoan (d : Nat) (roles as bs cs : List Wire) (cin : Wire) : Program :=
  emitLoan d roles (addTopLayers as bs cs cin) (addTopTop as bs cs cin)

theorem addTop_as_sweep (as bs cs : List Wire) (cin : Wire) :
    Q6LifetimeResearch.addTop as bs cs cin=
      emitSweep (addTopLayers as bs cs cin) (addTopTop as bs cs cin) := by
  induction as generalizing bs cs cin with
  | nil =>
      cases bs <;> cases cs <;>
        simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,emitSweep,emitUps,emitDowns]
  | cons a as ih =>
      cases as with
      | nil =>
          cases bs <;> cases cs <;>
            simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,emitSweep,emitUps,emitDowns]
      | cons a' as =>
          cases bs with
          | nil =>
              cases cs <;> simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                emitSweep,emitUps,emitDowns]
          | cons b bs =>
              cases bs with
              | nil =>
                  cases cs <;> simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                    emitSweep,emitUps,emitDowns]
              | cons b' bs =>
                  cases as with
                  | nil =>
                      cases bs with
                      | nil =>
                          cases cs <;> simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                            emitSweep,emitUps,emitDowns]
                      | cons b'' bs =>
                          cases cs with
                          | nil => simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                              emitSweep,emitUps,emitDowns]
                          | cons c cs =>
                              rw [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                                emitSweep,emitUps,emitDowns,CarryLayer.down,
                                ih (b'::b''::bs) cs c]
                              simp_all [emitSweep,List.append_assoc]
                              all_goals simp_all
                  | cons a'' as =>
                      cases cs with
                      | nil => simp [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                          emitSweep,emitUps,emitDowns]
                      | cons c cs =>
                          rw [Q6LifetimeResearch.addTop,addTopLayers,addTopTop,
                            emitSweep,emitUps,emitDowns,CarryLayer.down,
                            ih (b'::bs) cs c]
                          simp_all [emitSweep,List.append_assoc]
                          all_goals simp_all




theorem mappedAddLoan_zero (roles : List Wire) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) :
    mappedAddLoan 0 roles bits ys cs cin=mappedAdd bits ys cs cin := by
  rw [mappedAddLoan,emitLoan_zero,←mappedAdd_as_sweep]

theorem mappedSubLoan_zero (roles : List Wire) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) :
    mappedSubLoan 0 roles bits ys cs cin=mappedSub bits ys cs cin := by
  simp [mappedSubLoan,mappedSub,mappedAddLoan_zero]

theorem literalConstAddLoan_zero (roles xs carry : List Wire)
    (cin one : Wire) (k : Nat) :
    literalConstAddLoan 0 roles xs carry cin one k=
      literalConstAdd xs carry cin one k := by
  simp [literalConstAddLoan]

theorem compareLoan_zero (roles : List Wire) (forward : Bool)
    (as bs cs : List Wire) (cin target : Wire) :
    compareLoan 0 roles forward as bs cs cin target=
      Q6LifetimeResearch.compareChain forward as bs cs cin target := by
  rw [compareLoan,emitLoan_zero,←compareChain_as_sweep]

theorem addPrefixLoan_zero (roles xs ys carry : List Wire)
    (a t z cin : Wire) :
    addPrefixLoan 0 roles xs ys carry a t z cin=
      CoherentTail.addPrefix xs ys carry a t z cin := by
  rw [addPrefixLoan,emitLoan_zero,←addPrefix_as_sweep]

theorem addTopLoan_zero (roles as bs cs : List Wire) (cin : Wire) :
    addTopLoan 0 roles as bs cs cin=Q6LifetimeResearch.addTop as bs cs cin := by
  rw [addTopLoan,emitLoan_zero,←addTop_as_sweep]

/-! Concrete loaned lifetime-half components. -/

def rawAddLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  let ys := L.ylow
  let rs := L.low
  let cs := (Q6Structural.q6Carry L).take 255
  let a := ys.getD 0 0
  let b := rs.getD 0 0
  let c := cs.getD 0 0
  let clear := [Instr.CX L.parity b, .CX a b, .CX L.sign b]
  signComplement L.sign L.y ++ majority a b L.sign c ++ clear ++
    Q6LifetimeResearch.move (base 760) b
      (addPrefixLoan d retiredRoles (ys.drop 1) (rs.drop 1) (cs.drop 1)
        L.ymsb L.rmsb L.one c) ++ clear.reverse ++
    eraseCarry a b L.sign c ++ [.CX a b, .CX L.sign b] ++
    signComplement L.sign L.y

def foldLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  [.CCX L.parity L.lower L.one, .CX L.lower L.rmsb] ++
    Q6LifetimeResearch.move (base 760) L.rmsb
      (mappedAddLoan d retiredRoles (ShortBiasedFold.lowBits L) L.low
        (L.carry.take 254) L.one) ++
    [.CX L.lower L.rmsb, .CX L.parity L.rmsb, .CX L.parity L.lower,
     .CX L.rmsb L.lower,
     .measureX L.one [] [.Z L.parity, .CZ L.parity L.rmsb]]

def unfoldLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  [.CX L.parity L.lower, .CX L.rmsb L.lower, .CCX L.parity L.lower L.one,
   .CX L.lower L.rmsb, .CX L.parity L.rmsb] ++
    Q6LifetimeResearch.move (base 760) L.rmsb
      (mappedSubLoan d retiredRoles (ShortBiasedFold.lowBits L) L.low
        (L.carry.take 254) L.one) ++
    [.CX L.parity L.rmsb, .CX L.lower L.rmsb,
     .CX L.parity L.rmsb, .CX L.rmsb L.lower,
     .measureX L.one [] [.CZ L.parity L.rmsb]]

def compareBlockLoan (d : Nat) (forward : Bool) (L : BalancedCircuit.Layout) : Program :=
  let a := L.y.getD 0 0
  let b := L.r.getD 0 0
  let cs := (Q6Structural.q6Carry L).take 255
  let c := cs.getD 0 0
  notRegister (L.one::L.r) ++ majority a b L.one c ++ [.X L.one] ++
    Q6LifetimeResearch.move (base 760) L.one
      (compareLoan d retiredRoles forward (L.y.drop 1) (L.r.drop 1)
        (cs.drop 1) c L.parity) ++
    [.X L.one] ++ eraseCarry a b L.one c ++ notRegister (L.one::L.r)

def normalizeLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  Q6LifetimeResearch.move (base 760) L.rmsb
    (literalConstAddLoan d retiredRoles L.low (L.carry.take 254)
      L.lower L.one BalancedCleanup.negativeLiteral)

def unnormalizeLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  Q6LifetimeResearch.move (base 760) L.rmsb
    ([.X L.lower]++literalConstAddLoan d retiredRoles L.low (L.carry.take 254)
      L.lower L.one BalancedCleanup.positiveLiteral++[.X L.lower])

def rawSubTailLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  let xs := GuardCompression.source L
  let ys := BalancedCircuit.rawTarget L
  let cs := (Q6Structural.q6Carry L).take 255
  let a := xs.getD 0 0
  let b := ys.getD 0 0
  let c := cs.getD 0 0
  signComplement L.sign L.y ++ notRegister ys ++ majority a b L.sign c ++
    [.X b, .CX L.parity b] ++
    Q6LifetimeResearch.move (base 760) b
      (addTopLoan d retiredRoles (xs.drop 1) (ys.drop 1) (cs.drop 1) c) ++
    [.CX L.parity b, .X b] ++ eraseCarry a b L.sign c ++
    [.CX a b, .CX L.sign b] ++ notRegister ys ++ signComplement L.sign L.y ++
    [.CX b L.parity, .CX (L.ylow.getD 0 0) L.parity, .CX L.rmsb L.one]








def forwardLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  GuardCompression.seed L ++ rawAddLoan d L ++ OneReuse.newPrepare L ++
    rotateRight (BalancedCircuit.rawTarget L) ++ foldLoan d L ++
    BalancedCleanup.prepareSign L.toLayout ++ BiasedCircuit.flipBias L ++
    BalancedCleanup.prepareCompare L.toLayout ++ Q6StructuralCell.exposure L ++
    compareBlockLoan d true L ++ (Q6StructuralCell.exposure L).reverse ++
    (BalancedCleanup.prepareCompare L.toLayout).reverse ++ unnormalizeLoan d L ++
    (BalancedCleanup.prepareSign L.toLayout).reverse ++ [.measureX L.one [] []]

def inverseLoan (d : Nat) (L : BalancedCircuit.Layout) : Program :=
  BalancedCleanup.prepareSign L.toLayout ++ normalizeLoan d L ++
    BalancedCleanup.prepareCompare L.toLayout ++ Q6StructuralCell.exposure L ++
    compareBlockLoan d false L ++ (Q6StructuralCell.exposure L).reverse ++
    (BalancedCleanup.prepareCompare L.toLayout).reverse ++ BiasedInverse.unbiasView L ++
    unfoldLoan d L ++ rotateLeft (BalancedCircuit.rawTarget L) ++
    [.CX L.parity L.r0] ++ rawSubTailLoan d L

def half760Loan (d : Nat) (divide : Bool) : Program :=
  let L := Q6EndpointCell.ports base (base 2409)
  ([.X (base 2409)] ++
    (if divide then forwardLoan d L else inverseLoan d L) ++
    [.X (base 2409)]) ++
    (if divide then [] else [.measureX (base 1027) [] []])

theorem rawAddLoan_zero (L : BalancedCircuit.Layout) :
    rawAddLoan 0 L=Q6LifetimeResearch.rawAdd (base 760) L := by
  simp only [rawAddLoan,Q6LifetimeResearch.rawAdd,addPrefixLoan_zero]

theorem foldLoan_zero (L : BalancedCircuit.Layout) :
    foldLoan 0 L=Q6LifetimeResearch.fold (base 760) L := by
  simp only [foldLoan,Q6LifetimeResearch.fold,mappedAddLoan_zero]

theorem unfoldLoan_zero (L : BalancedCircuit.Layout) :
    unfoldLoan 0 L=Q6LifetimeResearch.unfoldStep (base 760) L := by
  simp only [unfoldLoan,Q6LifetimeResearch.unfoldStep,mappedSubLoan_zero]

theorem compareBlockLoan_zero (forward : Bool) (L : BalancedCircuit.Layout) :
    compareBlockLoan 0 forward L=
      Q6LifetimeResearch.compare (base 760) forward L := by
  simp only [compareBlockLoan,Q6LifetimeResearch.compare,compareLoan_zero]

theorem normalizeLoan_zero (L : BalancedCircuit.Layout) :
    normalizeLoan 0 L=Q6LifetimeResearch.normalize (base 760) L := by
  simp only [normalizeLoan,Q6LifetimeResearch.normalize,BalancedCleanup.normalize,
    literalConstAddLoan_zero]

theorem unnormalizeLoan_zero (L : BalancedCircuit.Layout) :
    unnormalizeLoan 0 L=Q6LifetimeResearch.unnormalize (base 760) false L := by
  simp only [unnormalizeLoan,Q6LifetimeResearch.unnormalize,Bool.false_eq_true,
    if_false,BalancedCleanup.unnormalize,literalConstAddLoan_zero]

theorem rawSubTailLoan_zero (L : BalancedCircuit.Layout) :
    rawSubTailLoan 0 L=Q6LifetimeResearch.rawSubTail (base 760) L := by
  simp only [rawSubTailLoan,Q6LifetimeResearch.rawSubTail,addTopLoan_zero]

theorem forwardLoan_zero (L : BalancedCircuit.Layout) :
    forwardLoan 0 L=Q6LifetimeResearch.forward (base 760) false L := by
  simp only [forwardLoan,Q6LifetimeResearch.forward,rawAddLoan_zero,foldLoan_zero,
    compareBlockLoan_zero,unnormalizeLoan_zero]

theorem inverseLoan_zero (L : BalancedCircuit.Layout) :
    inverseLoan 0 L=Q6LifetimeResearch.inverse (base 760) L := by
  simp only [inverseLoan,Q6LifetimeResearch.inverse,normalizeLoan_zero,
    compareBlockLoan_zero,unfoldLoan_zero,rawSubTailLoan_zero]

theorem half760Loan_zero (divide : Bool) :
    half760Loan 0 divide=R2Life760.half760 divide := by
  cases divide <;>
    simp [half760Loan,R2Life760.half760,Q6LifetimeResearch.half,
      forwardLoan_zero,inverseLoan_zero]








/-- The first `d` carries have their recursively determined majority values. -/
def PrefixReady : Nat → List MappedBit → List Wire → List Wire → Wire → BasisState → Prop
  | 0, _, _, _, _, _ => True
  | d+1, b::bits, y::ys, c::cs, cin, s =>
      s c=carryBit (b.value s) (s y) (s cin) ∧ PrefixReady d bits ys cs c s
  | _, _, _, _, _, _ => False

/-- Set the first `d` sites of a carry bank to zero.  The recursive order
    matches the high-to-low erasure order. -/
def clearPrefix : Nat → List Wire → BasisState → BasisState
  | d+1, c::cs, s => writeBit (clearPrefix d cs s) c false
  | _, _, s => s

theorem clearPrefix_outside (d : Nat) (cs : List Wire) (s : BasisState)
    (q : Wire) (hq : q∉cs.take d) : clearPrefix d cs s q=s q := by
  induction d generalizing cs with
  | zero => rfl
  | succ d ih =>
      cases cs with
      | nil => rfl
      | cons c cs =>
          simp only [List.take_succ_cons,List.mem_cons,not_or] at hq
          simp [clearPrefix,writeBit,hq.1,ih cs hq.2]

theorem clearPrefix_zero (d : Nat) (cs : List Wire) (s : BasisState)
    (q : Wire) (hq : q∈cs.take d) : clearPrefix d cs s q=false := by
  induction d generalizing cs with
  | zero => simp at hq
  | succ d ih =>
      cases cs with
      | nil => simp at hq
      | cons c cs =>
          simp only [List.take_succ_cons,List.mem_cons] at hq
          by_cases qc : q=c
          · subst q
            simp [clearPrefix,writeBit]
          · have tail : q∈cs.take d := hq.resolve_left qc
            simp [clearPrefix,writeBit,qc,ih cs tail]

theorem restore_clearPrefix_head (d : Nat) (c : Wire) (cs : List Wire)
    (s : BasisState) (hc : c∉cs.take d) :
    writeBit (clearPrefix (d+1) (c::cs) s) c (s c)=clearPrefix d cs s := by
  funext q
  by_cases qc : q=c
  · subst q
    simp [clearPrefix,writeBit,clearPrefix_outside d cs s c hc]
  · simp [clearPrefix,writeBit,qc]

/-- A program avoiding the cleared sites commutes with `clearPrefix`. -/
theorem run_clearPrefix_away (P : Program) (d : Nat) (cs : List Wire)
    (phase : Bool) (base : BasisState) (m : List Bool)
    (away : ∀q∈wires P,q∉cs.take d) :
    let t := run P m ⟨phase,base⟩
    run P m ⟨phase,clearPrefix d cs base⟩=
      ⟨t.phase,clearPrefix d cs t.basis⟩ := by
  dsimp only
  have agree := pool_run_agrees P (wires P) (Finset.Subset.refl _) m
    ⟨phase,clearPrefix d cs base⟩ ⟨phase,base⟩ rfl (by
      intro q hq
      exact clearPrefix_outside d cs base q (away q hq))
  apply State.extensionality
  · exact agree.1
  · funext q
    change (run P m ⟨phase,clearPrefix d cs base⟩).basis q=
      clearPrefix d cs (run P m ⟨phase,base⟩).basis q
    by_cases used : q∈wires P
    · rw [clearPrefix_outside d cs (run P m ⟨phase,base⟩).basis q (away q used)]
      exact agree.2 q used
    · rw [run_preserves_outside P m ⟨phase,clearPrefix d cs base⟩ q used]
      change clearPrefix d cs base q=
        clearPrefix d cs (run P m ⟨phase,base⟩).basis q
      by_cases host : q∈cs.take d
      · rw [clearPrefix_zero d cs base q host,
          clearPrefix_zero d cs (run P m ⟨phase,base⟩).basis q host]
      · rw [clearPrefix_outside d cs base q host,
          clearPrefix_outside d cs (run P m ⟨phase,base⟩).basis q host,
          run_preserves_outside P m ⟨phase,base⟩ q used]

theorem carryPrefix_counts (d : Nat) (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire) (hb : d ≤ bits.length) (hy : d ≤ ys.length) (hc : d ≤ cs.length) :
    toffoliCount (carryPrefix d bits ys cs cin)=d ∧
      measurementCount (carryPrefix d bits ys cs cin)=0 := by
  induction d generalizing bits ys cs cin with
  | zero => exact ⟨rfl,rfl⟩
  | succ d ih =>
      cases bits with
      | nil => simp at hb
      | cons b bits =>
          cases ys with
          | nil => simp at hy
          | cons y ys =>
              cases cs with
              | nil => simp at hc
              | cons c cs =>
                  have tail := ih bits ys cs c (by simpa using hb) (by simpa using hy)
                    (by simpa using hc)
                  have one := mappedBit_counts b y cin c
                  constructor
                  · rw [carryPrefix,toffoliCount_append,one.1,tail.1]
                    omega
                  · rw [carryPrefix,measurementCount_append,one.2.1,tail.2]



private theorem bit_head_support (b : MappedBit) (bits : List MappedBit)
    (q : Wire) (hq : q∈b.wire) : q∈mappedWires (b::bits) := by
  cases h : b.wire with
  | none => simp [h] at hq
  | some a =>
      have e : a=q := by simpa [h] using hq
      subst a
      simp [mappedWires,h]

private theorem bit_tail_support (b : MappedBit) (bits : List MappedBit)
    (q : Wire) (hq : q∈mappedWires bits) : q∈mappedWires (b::bits) := by
  simp only [mappedWires,List.flatMap_cons,List.mem_append]
  exact Or.inr hq





private theorem local_nodup (b : MappedBit) (bits : List MappedBit)
    (y : Wire) (ys : List Wire) (c : Wire) (cs : List Wire) (cin : Wire)
    (hn : (cin::((y::ys)++(c::cs))).Nodup) : [y,cin,c].Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have h := List.nodup_iff_count.mp hn q
  simp only [List.count_cons,List.count_append,List.count_nil] at h ⊢
  omega

private theorem tail_nodup (y : Wire) (ys : List Wire) (c : Wire)
    (cs : List Wire) (cin : Wire)
    (hn : (cin::((y::ys)++(c::cs))).Nodup) : (c::(ys++cs)).Nodup := by
  apply List.nodup_iff_count.mpr
  intro q
  have h := List.nodup_iff_count.mp hn q
  simp only [List.count_cons,List.count_append] at h ⊢
  omega

private theorem local_source_away (b : MappedBit) (bits : List MappedBit)
    (y : Wire) (ys : List Wire) (c : Wire) (cs : List Wire) (cin : Wire)
    (ha : ∀q∈mappedWires (b::bits),q∉cin::((y::ys)++(c::cs))) :
    ∀q∈b.wire,q∉[y,cin,c] := by
  intro q hq bad
  apply ha q
  · cases h : b.wire with
    | none => simp [h] at hq
    | some a =>
        have e : a=q := by simpa [h] using hq
        subst q
        simp [mappedWires,h]
  · simp only [List.mem_cons,List.mem_append] at bad ⊢
    tauto

private theorem tail_source_away (b : MappedBit) (bits : List MappedBit)
    (y : Wire) (ys : List Wire) (c : Wire) (cs : List Wire) (cin : Wire)
    (ha : ∀q∈mappedWires (b::bits),q∉cin::((y::ys)++(c::cs))) :
    ∀q∈mappedWires bits,q∉c::(ys++cs) := by
  intro q hq bad
  apply ha q
  · exact bit_tail_support b bits q hq
  · simp only [List.mem_cons,List.mem_append] at bad ⊢
    tauto

private theorem head_away_tail (y : Wire) (ys : List Wire) (c : Wire)
    (cs : List Wire) (cin : Wire)
    (hn : (cin::((y::ys)++(c::cs))).Nodup) : y∉cs ∧ cin∉cs ∧ c∉cs := by
  have cnt := List.nodup_iff_count.mp hn
  constructor
  · intro hy
    have h := cnt y
    have p := List.count_pos_iff.mpr hy
    simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
    omega
  constructor
  · intro hi
    have h := cnt cin
    have p := List.count_pos_iff.mpr hi
    simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
    omega
  · intro hc
    have h := cnt c
    have p := List.count_pos_iff.mpr hc
    simp only [List.count_cons,List.count_append,beq_self_eq_true,if_true] at h
    omega

private theorem head_source_away_tail (b : MappedBit) (bits : List MappedBit)
    (y : Wire) (ys : List Wire) (c : Wire) (cs : List Wire) (cin : Wire)
    (ha : ∀q∈mappedWires (b::bits),q∉cin::((y::ys)++(c::cs))) :
    ∀q∈b.wire,q∉cs := by
  intro q hq hcs
  exact ha q (bit_head_support b bits q hq) (by simp [hcs])

/-- High-to-low erasure has the exact effect of zeroing the requested prefix. -/
theorem erasePrefix_run (d : Nat) (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire) (s : State) (m : List Bool)
    (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (ready : PrefixReady d bits ys cs cin s.basis) :
    run (erasePrefix d bits ys cs cin) m s=
      ⟨s.phase,clearPrefix d cs s.basis⟩ := by
  induction d generalizing bits ys cs cin s m with
  | zero => rfl
  | succ d ih =>
      cases bits with
      | nil => simp [PrefixReady] at ready
      | cons b bits =>
          cases ys with
          | nil => simp [PrefixReady] at ready
          | cons y ys =>
              cases cs with
              | nil => simp [PrefixReady] at ready
              | cons c cs =>
                  let t : State := ⟨s.phase,clearPrefix d cs s.basis⟩
                  have away := head_away_tail y ys c cs cin hn
                  have ckeep : clearPrefix d cs s.basis c=s.basis c :=
                    clearPrefix_outside d cs s.basis c
                      (fun h => away.2.2 (List.mem_of_mem_take h))
                  have ykeep : clearPrefix d cs s.basis y=s.basis y :=
                    clearPrefix_outside d cs s.basis y
                      (fun h => away.1 (List.mem_of_mem_take h))
                  have ikeep : clearPrefix d cs s.basis cin=s.basis cin :=
                    clearPrefix_outside d cs s.basis cin
                      (fun h => away.2.1 (List.mem_of_mem_take h))
                  have bkeep : b.value (clearPrefix d cs s.basis)=b.value s.basis := by
                    apply mappedBit_value_congr
                    intro q hq
                    apply clearPrefix_outside
                    intro htake
                    exact head_source_away_tail b bits y ys c cs cin ha q hq
                      (List.mem_of_mem_take htake)
                  have tail (rec : List Bool) :
                      run (erasePrefix d bits ys cs c) rec s=t := by
                    exact ih bits ys cs c s rec (tail_nodup y ys c cs cin hn)
                      (tail_source_away b bits y ys c cs cin ha) ready.2
                  have one (rec : List Bool) :
                      run (mappedEraseCarry b y cin c) rec t=
                        ⟨t.phase,writeBit t.basis c false⟩ := by
                    apply mappedEraseCarry_correct b y cin c
                      (local_nodup b bits y ys c cs cin hn)
                      (local_source_away b bits y ys c cs cin ha)
                    change clearPrefix d cs s.basis c=
                      carryBit (b.value (clearPrefix d cs s.basis))
                        (clearPrefix d cs s.basis y) (clearPrefix d cs s.basis cin)
                    rw [ckeep,bkeep,ykeep,ikeep,ready.1]
                  rw [erasePrefix,run_append,tail,one]
                  rfl

/-- Low-to-high recomputation restores a ready reference basis from its
    cleared prefix. -/
theorem carryPrefix_clear (d : Nat) (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire) (phase : Bool) (base : BasisState) (m : List Bool)
    (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (ready : PrefixReady d bits ys cs cin base) :
    run (carryPrefix d bits ys cs cin) m ⟨phase,clearPrefix d cs base⟩=
      ⟨phase,base⟩ := by
  induction d generalizing bits ys cs cin phase base m with
  | zero => rfl
  | succ d ih =>
      cases bits with
      | nil => simp [PrefixReady] at ready
      | cons b bits =>
          cases ys with
          | nil => simp [PrefixReady] at ready
          | cons y ys =>
              cases cs with
              | nil => simp [PrefixReady] at ready
              | cons c cs =>
                  let start : BasisState := clearPrefix (d+1) (c::cs) base
                  let t : State := ⟨phase,clearPrefix d cs base⟩
                  have away := head_away_tail y ys c cs cin hn
                  have three := local_nodup b bits y ys c cs cin hn
                  have yc : y≠c := fun eq => (List.nodup_cons.mp three).1 (by simp [eq])
                  have ic : cin≠c := fun eq =>
                    (List.nodup_cons.mp (List.nodup_cons.mp three).2).1 (by simp [eq])
                  have ycarry : y∉c::cs := by simp [yc,away.1]
                  have icarry : cin∉c::cs := by simp [ic,away.2.1]
                  have ykeep : start y=base y := clearPrefix_outside _ _ _ _ (by
                    intro h
                    exact ycarry (List.mem_of_mem_take h))
                  have ikeep : start cin=base cin := clearPrefix_outside _ _ _ _ (by
                    intro h
                    exact icarry (List.mem_of_mem_take h))
                  have bkeep : b.value start=b.value base := by
                    apply mappedBit_value_congr
                    intro q hq
                    apply clearPrefix_outside
                    intro htake
                    exact ha q (bit_head_support b bits q hq) (by
                      have hcarry : q∈c::cs := List.mem_of_mem_take htake
                      simp only [List.mem_cons,List.mem_append] at hcarry ⊢
                      tauto)
                  have czero : start c=false := clearPrefix_zero _ _ _ c (by simp)
                  have ctail : c∉cs.take d := fun h =>
                    away.2.2 (List.mem_of_mem_take h)
                  have one (rec : List Bool) :
                      run (mappedMajority b y cin c) rec ⟨phase,start⟩=t := by
                    rw [mappedMajority_correct b y cin c three
                      (local_source_away b bits y ys c cs cin ha)]
                    change (⟨phase,writeBit start c
                      (start c ^^ carryBit (b.value start) (start y) (start cin))⟩ : State)=t
                    rw [czero,bkeep,ykeep,ikeep,← ready.1]
                    simp only [Bool.false_xor]
                    exact congrArg (State.mk phase)
                      (restore_clearPrefix_head d c cs base ctail)
                  have tail (rec : List Bool) :
                      run (carryPrefix d bits ys cs c) rec t=⟨phase,base⟩ := by
                    exact ih bits ys cs c phase base rec
                      (tail_nodup y ys c cs cin hn)
                      (tail_source_away b bits y ys c cs cin ha) ready.2
                  rw [carryPrefix,run_append,one,tail]








theorem rebindMany_physical (roles hosts : List Wire) (P : Program)
    (hp : GatePhysical P) : GatePhysical (rebindMany roles hosts P) := by
  induction roles generalizing hosts with
  | nil => exact hp
  | cons r roles ih =>
      cases hosts with
      | nil => exact hp
      | cons h hosts =>
          exact gatePhysical_rename _ (Equiv.swap r h).injective _ (ih hosts)








/-! ## Structural replay identities

These identities expose the low prefix of a mapped carry sweep without
evaluating a concrete 255-bit program.  They are the bridge from the local
`PrefixReady` lemmas above to the four complete half sweeps. -/

theorem emitUps_mapped_take (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length) :
    emitUps ((mappedLayers bits ys cs cin).take d)=
      carryPrefix d bits ys cs cin := by
  induction d generalizing bits ys cs cin with
  | zero => rfl
  | succ d ih =>
      cases bits with
      | nil =>
          have ye : ys=[] := List.eq_nil_of_length_eq_zero hb.symm
          subst ys
          simp at hc
      | cons b bits =>
          cases bits with
          | nil =>
              have ye : ys.length=1 := by simpa using hb.symm
              have ce : cs=[] := List.eq_nil_of_length_eq_zero (by omega)
              subst cs
              cases ys with
              | nil => simp at ye
              | cons y ys =>
                  have tail : ys=[] := List.eq_nil_of_length_eq_zero (by simpa using ye)
                  subst ys
                  rfl
          | cons b' bits =>
              cases ys with
              | nil => simp at hb
              | cons y ys =>
                  cases ys with
                  | nil => simp at hb
                  | cons y' ys =>
                      cases cs with
                      | nil => simp at hc
                      | cons c cs =>
                          simp only [mappedLayers,List.take_succ_cons,emitUps,
                            carryPrefix,List.append_cancel_left_eq]
                          exact ih (b'::bits) (y'::ys) cs c
                            (by simpa using hb) (by simpa using hc)

theorem emitErases_mapped_take (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length) :
    emitErases ((mappedLayers bits ys cs cin).take d)=
      erasePrefix d bits ys cs cin := by
  induction d generalizing bits ys cs cin with
  | zero => rfl
  | succ d ih =>
      cases bits with
      | nil =>
          have ye : ys=[] := List.eq_nil_of_length_eq_zero hb.symm
          subst ys
          simp at hc
      | cons b bits =>
          cases bits with
          | nil =>
              have ye : ys.length=1 := by simpa using hb.symm
              have ce : cs=[] := List.eq_nil_of_length_eq_zero (by omega)
              subst cs
              cases ys with
              | nil => simp at ye
              | cons y ys =>
                  have tail : ys=[] := List.eq_nil_of_length_eq_zero (by simpa using ye)
                  subst ys
                  rfl
          | cons b' bits =>
              cases ys with
              | nil => simp at hb
              | cons y ys =>
                  cases ys with
                  | nil => simp at hb
                  | cons y' ys =>
                      cases cs with
                      | nil => simp at hc
                      | cons c cs =>
                          simp only [mappedLayers,List.take_succ_cons,emitErases,
                            erasePrefix,List.append_cancel_right_eq]
                          exact ih (b'::bits) (y'::ys) cs c
                            (by simpa using hb) (by simpa using hc)

theorem layerHosts_mapped_take (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length) :
    layerHosts ((mappedLayers bits ys cs cin).take d)=cs.take d := by
  induction d generalizing bits ys cs cin with
  | zero => rfl
  | succ d ih =>
      cases bits with
      | nil =>
          have ye : ys=[] := List.eq_nil_of_length_eq_zero hb.symm
          subst ys
          simp at hc
      | cons b bits =>
          cases bits with
          | nil =>
              have ye : ys.length=1 := by simpa using hb.symm
              have ce : cs=[] := List.eq_nil_of_length_eq_zero (by omega)
              subst cs
              simp [mappedLayers,layerHosts]
          | cons b' bits =>
              cases ys with
              | nil => simp at hb
              | cons y ys =>
                  cases ys with
                  | nil => simp at hb
                  | cons y' ys =>
                      cases cs with
                      | nil => simp at hc
                      | cons c cs =>
                          simp only [mappedLayers,List.take_succ_cons,layerHosts,
                            List.map_cons]
                          exact congrArg (List.cons c)
                            (ih (b'::bits) (y'::ys) cs c
                              (by simpa using hb) (by simpa using hc))

/-- Carry input seen after dropping the first `n` recursive layers. -/
def carryAfter : Nat → List Wire → Wire → Wire
  | 0, _, cin => cin
  | n+1, c::cs, _ => carryAfter n cs c
  | _+1, [], cin => cin

theorem mapped_upper_sweep (n : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length)
    (hn : n≤cs.length) :
    emitSweep ((mappedLayers bits ys cs cin).drop n)
        (mappedTop bits ys cs cin)=
      mappedAdd (bits.drop n) (ys.drop n) (cs.drop n)
        (carryAfter n cs cin) := by
  induction n generalizing bits ys cs cin with
  | zero => exact (mappedAdd_as_sweep bits ys cs cin).symm
  | succ n ih =>
      cases bits with
      | nil =>
          have ye : ys=[] := List.eq_nil_of_length_eq_zero hb.symm
          subst ys
          simp at hc
      | cons b bits =>
          cases bits with
          | nil =>
              have ye : ys.length=1 := by simpa using hb.symm
              have ce : cs=[] := List.eq_nil_of_length_eq_zero (by omega)
              subst cs
              simp at hn
          | cons b' bits =>
              cases ys with
              | nil => simp at hb
              | cons y ys =>
                  cases ys with
                  | nil => simp at hb
                  | cons y' ys =>
                      cases cs with
                      | nil => simp at hn
                      | cons c cs =>
                          simp only [mappedLayers,mappedTop,List.drop_succ_cons,
                            carryAfter]
                          exact ih (b'::bits) (y'::ys) cs c
                            (by simpa using hb) (by simpa using hc) (by simpa using hn)

theorem carryPrefix_frame (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) (s : State) (m : List Bool)
    (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (hb : d≤bits.length) (hy : d≤ys.length) (hc : d≤cs.length)
    (clean : ∀q∈cs.take d,s.basis q=false) :
    let t := run (carryPrefix d bits ys cs cin) m s
    t.phase=s.phase ∧ PrefixReady d bits ys cs cin t.basis ∧
      ∀q,q∉cs.take d → t.basis q=s.basis q := by
  induction d generalizing bits ys cs cin s m with
  | zero => exact ⟨rfl,True.intro,fun _ _ => rfl⟩
  | succ d ih =>
      cases bits with
      | nil => simp at hb
      | cons b bits =>
          cases ys with
          | nil => simp at hy
          | cons y ys =>
              cases cs with
              | nil => simp at hc
              | cons c cs =>
                  let u : State := ⟨s.phase,writeBit s.basis c
                    (carryBit (b.value s.basis) (s.basis y) (s.basis cin))⟩
                  have one (rec : List Bool) :
                      run (mappedMajority b y cin c) rec s=u := by
                    rw [mappedMajority_correct b y cin c
                      (local_nodup b bits y ys c cs cin hn)
                      (local_source_away b bits y ys c cs cin ha)]
                    rw [clean c (by simp)]
                    simp only [Bool.false_xor]
                    rfl
                  have ctail : c∉cs.take d := by
                    intro h
                    exact (head_away_tail y ys c cs cin hn).2.2
                      (List.mem_of_mem_take h)
                  have keepU (q : Wire) (hq : q≠c) : u.basis q=s.basis q := by
                    simp [u,writeBit,hq]
                  have tailClean : ∀q∈cs.take d,u.basis q=false := by
                    intro q hq
                    rw [keepU q (fun e => ctail (e ▸ hq))]
                    exact clean q (by simp [hq])
                  have tail := ih bits ys cs c u
                    (m.drop (measurementCount (mappedMajority b y cin c)))
                    (tail_nodup y ys c cs cin hn)
                    (tail_source_away b bits y ys c cs cin ha)
                    (by simpa using hb) (by simpa using hy) (by simpa using hc)
                    tailClean
                  let t := run (carryPrefix d bits ys cs c)
                    (m.drop (measurementCount (mappedMajority b y cin c))) u
                  change t.phase=u.phase ∧ PrefixReady d bits ys cs c t.basis ∧
                    ∀q,q∉cs.take d → t.basis q=u.basis q at tail
                  have away := head_away_tail y ys c cs cin hn
                  have keepT (q : Wire) (hq : q∉cs.take d) :
                      t.basis q=u.basis q := tail.2.2 q hq
                  have ykeep : t.basis y=s.basis y := by
                    rw [keepT y (fun h => away.1 (List.mem_of_mem_take h)),
                      keepU y (by
                        intro e
                        exact (List.nodup_cons.mp
                          (local_nodup b bits y ys c cs cin hn)).1 (by simp [e]))]
                  have ikeep : t.basis cin=s.basis cin := by
                    rw [keepT cin (fun h => away.2.1 (List.mem_of_mem_take h)),
                      keepU cin (by
                        intro e
                        have nd := local_nodup b bits y ys c cs cin hn
                        simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,
                          List.nodup_nil,not_or,not_false_eq_true,and_true] at nd
                        tauto)]
                  have ckeep : t.basis c=u.basis c := keepT c ctail
                  have bkeep : b.value t.basis=b.value s.basis := by
                    apply mappedBit_value_congr
                    intro q hq
                    rw [keepT q (by
                      intro h
                      exact head_source_away_tail b bits y ys c cs cin ha q hq
                        (List.mem_of_mem_take h)),
                      keepU q (by
                        intro e
                        exact (local_source_away b bits y ys c cs cin ha q hq)
                          (by simp [e]))]
                  simp only [carryPrefix,run_append,one]
                  change t.phase=s.phase ∧
                    (t.basis c=carryBit (b.value t.basis) (t.basis y)
                      (t.basis cin) ∧ PrefixReady d bits ys cs c t.basis) ∧
                    ∀q,q∉(c::cs).take (d+1) → t.basis q=s.basis q
                  refine ⟨tail.1,?_,?_⟩
                  · refine ⟨?_,tail.2.1⟩
                    rw [ckeep,bkeep,ykeep,ikeep]
                    simp [u,writeBit]
                  · intro q hq
                    have qtail : q∉cs.take d := by
                      intro h
                      exact hq (by simp [h])
                    have qc : q≠c := by
                      intro e
                      exact hq (by simp [e])
                    exact (keepT q qtail).trans (keepU q qc)

theorem mapped_drop_geometry (n : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire)
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length)
    (hn : n≤cs.length) (nd : (cin::(ys++cs)).Nodup)
    (away : ∀q∈mappedWires bits,q∉cin::(ys++cs)) :
    (carryAfter n cs cin::(ys.drop n++cs.drop n)).Nodup ∧
      ∀q∈mappedWires (bits.drop n),
        q∉carryAfter n cs cin::(ys.drop n++cs.drop n) := by
  induction n generalizing bits ys cs cin with
  | zero => exact ⟨nd,away⟩
  | succ n ih =>
      cases bits with
      | nil =>
          have ye : ys=[] := List.eq_nil_of_length_eq_zero hb.symm
          subst ys
          simp at hc
      | cons b bits =>
          cases ys with
          | nil => simp at hb
          | cons y ys =>
              cases cs with
              | nil => simp at hn
              | cons c cs =>
                  simp only [List.drop_succ_cons,carryAfter]
                  exact ih bits ys cs c (by simpa using hb) (by simpa using hc)
                    (by simpa using hn) (tail_nodup y ys c cs cin nd)
                    (tail_source_away b bits y ys c cs cin away)

theorem PrefixReady.congr (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) (a b : BasisState)
    (ready : PrefixReady d bits ys cs cin a)
    (same : ∀q∈mappedWires (bits.take d)++ys.take d++cs.take d++[cin],
      b q=a q) : PrefixReady d bits ys cs cin b := by
  induction d generalizing bits ys cs cin with
  | zero => trivial
  | succ d ih =>
      cases bits with
      | nil => simp [PrefixReady] at ready
      | cons bit bits =>
          cases ys with
          | nil => simp [PrefixReady] at ready
          | cons y ys =>
              cases cs with
              | nil => simp [PrefixReady] at ready
              | cons c cs =>
                  simp only [PrefixReady]
                  constructor
                  · rw [same c (by simp),same y (by simp),same cin (by simp),ready.1]
                    apply congrArg (fun z => carryBit z (a y) (a cin))
                    apply mappedBit_value_congr
                    intro q hq
                    have hm : q∈mappedWires (bit::bits.take d) :=
                      bit_head_support bit (bits.take d) q hq
                    apply (same q ?_).symm
                    simp only [List.take_succ_cons,List.mem_append]
                    tauto
                  · apply ih bits ys cs c ready.2
                    intro q hq
                    exact same q (by
                      simp only [List.take_succ_cons,mappedWires,List.flatMap_cons,
                        List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hq ⊢
                      tauto)

theorem PrefixReady.pred (d : Nat) (bits : List MappedBit)
    (ys cs : List Wire) (cin : Wire) (s : BasisState)
    (ready : PrefixReady (d+1) bits ys cs cin s) :
    PrefixReady d bits ys cs cin s := by
  induction d generalizing bits ys cs cin with
  | zero => trivial
  | succ d ih =>
      cases bits with
      | nil => simp [PrefixReady] at ready
      | cons b bits =>
          cases ys with
          | nil => simp [PrefixReady] at ready
          | cons y ys =>
              cases cs with
              | nil => simp [PrefixReady] at ready
              | cons c cs => exact ⟨ready.1,ih bits ys cs c ready.2⟩

theorem mappedAdd_records (bits : List MappedBit) (ys cs : List Wire)
    (cin : Wire) (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length)
    (s : State) (m n : List Bool) (clean : ∀q∈cs,s.basis q=false) :
    run (mappedAdd bits ys cs cin) m s=
      run (mappedAdd bits ys cs cin) n s := by
  have x := mappedAdd_correct bits ys cs cin hn ha hb hc s m clean
  have y := mappedAdd_correct bits ys cs cin hn ha hb hc s n clean
  apply State.extensionality
  · exact x.1.trans y.1.symm
  · funext q
    by_cases hq : q∈ys
    · exact (regValue_eq_iff ys _ _).mp (x.2.2.trans y.2.2.symm) q hq
    · exact (x.2.1 q hq).trans (y.2.1 q hq).symm

theorem suffix_run_of_split (P U S : Program) (s u v t : State)
    (prefixZero : measurementCount P=0)
    (prefixRun : ∀rec,run P rec s=u)
    (upperRun : ∀rec,run U rec u=v)
    (whole : ∀rec,run (P++(U++S)) rec s=t) :
    ∀rec,run S rec v=t := by
  intro rec
  let records := List.replicate (measurementCount U) false++rec
  have all := whole records
  rw [run_append,prefixZero,List.take_zero,List.drop_zero,prefixRun,
    run_append,run_take] at all
  have drop : records.drop (measurementCount U)=rec := by simp [records]
  rw [drop,upperRun] at all
  exact all

theorem carryAfter_succ_mem (d : Nat) (cs : List Wire) (cin : Wire)
    (h : d+1≤cs.length) : carryAfter (d+1) cs cin∈cs := by
  induction d generalizing cs cin with
  | zero =>
      cases cs with
      | nil => simp at h
      | cons c cs => simp [carryAfter]
  | succ d ih =>
      cases cs with
      | nil => simp at h
      | cons c cs =>
          simp only [carryAfter]
          exact List.mem_cons_of_mem c (ih cs c (by simpa using h))

theorem carryAfter_succ_take_mem (d : Nat) (cs : List Wire) (cin : Wire)
    (h : d+1≤cs.length) : carryAfter (d+1) cs cin∈cs.take (d+1) := by
  induction d generalizing cs cin with
  | zero =>
      cases cs with
      | nil => simp at h
      | cons c cs => simp [carryAfter]
  | succ d ih =>
      cases cs with
      | nil => simp at h
      | cons c cs =>
          simp only [carryAfter,List.take_succ_cons,List.mem_cons]
          exact Or.inr (ih cs c (by simpa using h))

theorem carryAfter_succ_away (d : Nat) (cs : List Wire) (cin : Wire)
    (nd : cs.Nodup) (h : d+1≤cs.length) :
    carryAfter (d+1) cs cin∉cs.take d := by
  induction d generalizing cs cin with
  | zero => simp
  | succ d ih =>
      cases cs with
      | nil => simp at h
      | cons c cs =>
          simp only [carryAfter,List.take_succ_cons,List.mem_cons,not_or]
          have tailLen : d+1≤cs.length := by simpa using h
          have member := carryAfter_succ_mem d cs c tailLen
          exact ⟨fun e => (List.nodup_cons.mp nd).1 (e ▸ member),
            ih cs c (List.nodup_cons.mp nd).2 tailLen⟩

theorem mappedWires_drop_mem (n : Nat) (bits : List MappedBit)
    (q : Wire) (h : q∈mappedWires (bits.drop n)) : q∈mappedWires bits := by
  induction n generalizing bits with
  | zero => exact h
  | succ n ih =>
      cases bits with
      | nil => simp [mappedWires] at h
      | cons b bits =>
          exact bit_tail_support b bits q (ih bits h)

theorem mappedWires_take_mem (n : Nat) (bits : List MappedBit)
    (q : Wire) (h : q∈mappedWires (bits.take n)) : q∈mappedWires bits := by
  induction n generalizing bits with
  | zero => simp [mappedWires] at h
  | succ n ih =>
      cases bits with
      | nil => simp [mappedWires] at h
      | cons b bits =>
          simp only [List.take_succ_cons,mappedWires,List.flatMap_cons,
            List.mem_append] at h ⊢
          exact h.elim Or.inl (fun tail => Or.inr (ih bits tail))

/-- A complete mapped carry loan is a full-State replay of the ordinary
    mapped adder when its logical high-carry roles lie above the borrowed
    prefix.  This is the reusable positive-depth theorem for both `fold` and
    `unfoldStep`. -/
theorem mappedAddLoan_run_eq (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (s : State) (m n : List Bool)
    (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length)
    (hd : d+1≤cs.length) (clean : ∀q∈cs,s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1)) :
    run (mappedAddLoan d roles bits ys cs cin) m s=
      run (mappedAdd bits ys cs cin) n s := by
  let layers := mappedLayers bits ys cs cin
  let P := emitUps (layers.take (d+1))
  let U := emitSweep (layers.drop (d+1)) (mappedTop bits ys cs cin)
  let S := emitDowns (layers.take (d+1))
  let u := run P [] s
  let v := run U [] u
  let uc : State := ⟨u.phase,clearPrefix d cs u.basis⟩
  let vc : State := ⟨v.phase,clearPrefix d cs v.basis⟩
  let t := run (mappedAdd bits ys cs cin) n s
  have csND : cs.Nodup :=
    (List.nodup_append'.mp (List.nodup_cons.mp hn).2).2.1
  have ysCs : List.Disjoint ys cs :=
    (List.nodup_append'.mp (List.nodup_cons.mp hn).2).2.2
  have pShape : P=carryPrefix (d+1) bits ys cs cin := by
    exact emitUps_mapped_take (d+1) bits ys cs cin hb hc
  have uFrame := carryPrefix_frame (d+1) bits ys cs cin s [] hn ha
    (by omega) (by omega) hd (fun q hq => clean q (List.mem_of_mem_take hq))
  rw [←pShape] at uFrame
  change u.phase=s.phase ∧ PrefixReady (d+1) bits ys cs cin u.basis ∧
    ∀q,q∉cs.take (d+1) → u.basis q=s.basis q at uFrame
  have prefixRun (rec : List Bool) : run P rec s=u := by
    change run P rec s=run P [] s
    rw [pShape]
    exact FifthCarry.no_records (carryPrefix (d+1) bits ys cs cin)
      (carryPrefix_counts (d+1) bits ys cs cin (by omega) (by omega) hd).2
      s rec []
  have tailClean : ∀q∈cs.drop (d+1),u.basis q=false := by
    intro q hq
    have away : q∉cs.take (d+1) := by
      intro low
      exact List.disjoint_left.mp
        (List.disjoint_take_drop csND (Nat.le_refl (d+1))) low hq
    exact (uFrame.2.2 q away).trans (clean q (List.mem_of_mem_drop hq))
  have geom := mapped_drop_geometry (d+1) bits ys cs cin hb hc hd hn ha
  have hbU : (bits.drop (d+1)).length=(ys.drop (d+1)).length := by
    simp only [List.length_drop]
    omega
  have hcU : (cs.drop (d+1)).length+1=(ys.drop (d+1)).length := by
    simp only [List.length_drop]
    omega
  have uShape : U=mappedAdd (bits.drop (d+1)) (ys.drop (d+1))
      (cs.drop (d+1)) (carryAfter (d+1) cs cin) := by
    exact mapped_upper_sweep (d+1) bits ys cs cin hb hc hd
  have upperRun (rec : List Bool) : run U rec u=v := by
    change run U rec u=run U [] u
    rw [uShape]
    exact (mappedAdd_records (bits.drop (d+1)) (ys.drop (d+1))
      (cs.drop (d+1)) (carryAfter (d+1) cs cin) geom.1 geom.2 hbU hcU
      u rec [] tailClean)
  have lowAwayUpper : ∀q∈wires U,q∉cs.take d := by
    intro q hq qlow
    rw [uShape] at hq
    have pool := mappedAdd_wires_subset (bits.drop (d+1)) (ys.drop (d+1))
      (cs.drop (d+1)) (carryAfter (d+1) cs cin) hq
    simp only [List.mem_toFinset,List.mem_append,List.mem_cons,
      List.not_mem_nil,or_false] at pool
    rcases pool with ((source|target)|carry)|boundary
    · exact ha q (mappedWires_drop_mem (d+1) bits q source) (by
        simp only [List.mem_cons,List.mem_append]
        exact Or.inr (Or.inr (List.mem_of_mem_take qlow)))
    · exact List.disjoint_left.mp ysCs (List.mem_of_mem_drop target)
        (List.mem_of_mem_take qlow)
    · have lowBoundary : q∈cs.take (d+1) := by
        rw [show cs.take d=(cs.take (d+1)).take d by
          simp [List.take_take]] at qlow
        exact List.mem_of_mem_take qlow
      exact List.disjoint_left.mp
        (List.disjoint_take_drop csND (Nat.le_refl (d+1))) lowBoundary carry
    · have eq : q=carryAfter (d+1) cs cin := by simpa using boundary
      subst q
      exact carryAfter_succ_away d cs cin csND hd qlow
  have eraseRun (rec : List Bool) :
      run (emitErases (layers.take d)) rec u=uc := by
    rw [emitErases_mapped_take d bits ys cs cin hb hc]
    exact erasePrefix_run d bits ys cs cin u rec hn ha
      (PrefixReady.pred d bits ys cs cin u.basis uFrame.2.1)
  have commute (rec : List Bool) : run U rec uc=vc := by
    have moved := run_clearPrefix_away U d cs u.phase u.basis rec lowAwayUpper
    change run U rec uc=⟨(run U rec u).phase,
      clearPrefix d cs (run U rec u).basis⟩ at moved
    rw [upperRun rec] at moved
    exact moved
  have zeroBefore : ∀q∈roles.take d++cs.take d,uc.basis q=false := by
    intro q hq
    simp only [List.mem_append] at hq
    rcases hq with role|host
    · have tail := roleTail q role
      change clearPrefix d cs u.basis q=false
      rw [clearPrefix_outside d cs u.basis q (by
        intro low
        have lowBoundary : q∈cs.take (d+1) := by
          rw [show cs.take d=(cs.take (d+1)).take d by
            simp [List.take_take]] at low
          exact List.mem_of_mem_take low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) lowBoundary tail)]
      exact tailClean q tail
    · exact clearPrefix_zero d cs u.basis q host
  have zeroAfter (rec : List Bool) :
      ∀q∈roles.take d++cs.take d,(run U rec uc).basis q=false := by
    rw [commute rec]
    change ∀q∈roles.take d++cs.take d,clearPrefix d cs v.basis q=false
    intro q hq
    simp only [List.mem_append] at hq
    rcases hq with role|host
    · have tail := roleTail q role
      have notTarget : q∉ys.drop (d+1) := by
        intro qy
        exact List.disjoint_left.mp ysCs (List.mem_of_mem_drop qy)
          (List.mem_of_mem_drop tail)
      have correct := mappedAdd_correct (bits.drop (d+1)) (ys.drop (d+1))
        (cs.drop (d+1)) (carryAfter (d+1) cs cin) geom.1 geom.2 hbU hcU
        u [] tailClean
      have vq : v.basis q=u.basis q := by
        change (run U [] u).basis q=u.basis q
        rw [uShape]
        exact correct.2.1 q notTarget
      rw [clearPrefix_outside d cs v.basis q (by
        intro low
        have lowBoundary : q∈cs.take (d+1) := by
          rw [show cs.take d=(cs.take (d+1)).take d by
            simp [List.take_take]] at low
          exact List.mem_of_mem_take low
        exact List.disjoint_left.mp
          (List.disjoint_take_drop csND (Nat.le_refl (d+1))) lowBoundary tail),
        vq]
      exact tailClean q tail
    · exact clearPrefix_zero d cs v.basis q host
  have movedRun (rec : List Bool) :
      run (rebindMany (roles.take d) (layerHosts (layers.take d)) U) rec uc=vc := by
    rw [layerHosts_mapped_take d bits ys cs cin hb hc]
    exact (rebindMany_run (roles.take d) (cs.take d) U uc rec zeroBefore
      (zeroAfter rec)).trans (commute rec)
  have readyV : PrefixReady d bits ys cs cin v.basis := by
    apply PrefixReady.congr d bits ys cs cin u.basis v.basis
      (PrefixReady.pred d bits ys cs cin u.basis uFrame.2.1)
    intro q hq
    have notTarget : q∉ys.drop (d+1) := by
      intro tail
      simp only [List.mem_append,List.mem_cons,List.mem_singleton] at hq
      rcases hq with ((source|frontY)|frontC)|input
      · exact ha q (mappedWires_take_mem d bits q source)
          (by simp [List.mem_of_mem_drop tail])
      · have dis := List.disjoint_take_drop
          ((List.nodup_append'.mp (List.nodup_cons.mp hn).2).1)
          (Nat.le_refl (d+1))
        have frontBig : q∈ys.take (d+1) := by
          rw [show ys.take d=(ys.take (d+1)).take d by simp [List.take_take]] at frontY
          exact List.mem_of_mem_take frontY
        exact List.disjoint_left.mp dis frontBig tail
      · exact List.disjoint_left.mp ysCs (List.mem_of_mem_drop tail)
          (List.mem_of_mem_take frontC)
      · have eq : q=cin := by simpa using input
        subst q
        exact (List.nodup_cons.mp hn).1 (by
          simp only [List.mem_append]
          exact Or.inl (List.mem_of_mem_drop tail))
    have correct := mappedAdd_correct (bits.drop (d+1)) (ys.drop (d+1))
      (cs.drop (d+1)) (carryAfter (d+1) cs cin) geom.1 geom.2 hbU hcU
      u [] tailClean
    change (run U [] u).basis q=u.basis q
    rw [uShape]
    exact correct.2.1 q notTarget
  have recomputeRun (rec : List Bool) :
      run (emitUps (layers.take d)) rec vc=v := by
    rw [emitUps_mapped_take d bits ys cs cin hb hc]
    exact carryPrefix_clear d bits ys cs cin v.phase v.basis rec hn ha readyV
  have wholeRun (rec : List Bool) : run (P++(U++S)) rec s=t := by
    change run (P++(U++S)) rec s=run (mappedAdd bits ys cs cin) n s
    have shape : P++(U++S)=mappedAdd bits ys cs cin := by
      rw [mappedAdd_as_sweep,emitSweep_split (d+1)]
      simp only [P,U,S,layers,List.append_assoc]
    rw [shape]
    exact mappedAdd_records bits ys cs cin hn ha hb hc s rec n clean
  have suffixRun : ∀rec,run S rec v=t :=
    suffix_run_of_split P U S s u v t
      (by rw [pShape]; exact (carryPrefix_counts (d+1) bits ys cs cin
        (by omega) (by omega) hd).2)
      prefixRun upperRun wholeRun
  have replay := emitLoan_run d roles layers (mappedTop bits ys cs cin)
    s u uc vc v t m n prefixRun eraseRun upperRun movedRun recomputeRun suffixRun
  rw [←mappedAdd_as_sweep bits ys cs cin] at replay
  exact replay.1.trans replay.2.symm

theorem mappedSubLoan_run_eq (d : Nat) (roles : List Wire)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (s : State) (m n : List Bool)
    (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (hb : bits.length=ys.length) (hc : cs.length+1=ys.length)
    (hd : d+1≤cs.length) (clean : ∀q∈cs,s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1)) :
    run (mappedSubLoan d roles bits ys cs cin) m s=
      run (mappedSub bits ys cs cin) n s := by
  let N := notRegister ys
  let u := run N [] s
  have ysND : ys.Nodup :=
    (List.nodup_append'.mp (List.nodup_cons.mp hn).2).1
  have ysCs : List.Disjoint ys cs :=
    (List.nodup_append'.mp (List.nodup_cons.mp hn).2).2.2
  have invert := notRegister_correct ys ysND s []
  have cleanU : ∀q∈cs,u.basis q=false := by
    intro q hq
    have away : q∉ys := by
      intro hy
      exact List.disjoint_left.mp ysCs hy hq
    change (run (notRegister ys) [] s).basis q=false
    rw [invert]
    simp only [if_neg away]
    exact clean q hq
  have middle (a b : List Bool) :=
    mappedAddLoan_run_eq d roles bits ys cs cin u a b hn ha hb hc
      hd cleanU roleTail
  have zero : measurementCount N=0 := notRegister_counts ys |>.2
  rw [mappedSubLoan,mappedSub,List.append_assoc,List.append_assoc,
    run_append,run_append,run_append,run_append]
  have first (r : List Bool) : run (notRegister ys) r s=u := by
    change run N r s=run N [] s
    exact FifthCarry.no_records N zero s r []
  rw [first,first]
  change run N _ (run (mappedAddLoan d roles bits ys cs cin) _ u)=
    run N _ (run (mappedAdd bits ys cs cin) _ u)
  rw [middle]
  exact FifthCarry.no_records N zero _ _ _




/-! Concrete high-carry geometry shared by all seven half components. -/



private theorem retiredRoles_q6Tail_all :
    ∀q∈retiredRoles,
      q∈(((Q6Structural.q6Carry
        (Q6EndpointCell.ports base (base 2409))).take 255).drop 1).drop 69 := by
  decide +kernel

theorem retiredRoles_q6Tail (d : Nat) (hd : d≤68) :
    ∀q∈retiredRoles.take d,
      q∈(((Q6Structural.q6Carry
        (Q6EndpointCell.ports base (base 2409))).take 255).drop 1).drop (d+1) := by
  intro q hq
  have h := retiredRoles_q6Tail_all q (List.mem_of_mem_take hq)
  have e : (69 : Nat) = (d+1)+(68-d) := by omega
  rw [e, ← List.drop_drop] at h
  exact List.mem_of_mem_drop h

/-- Family-independent semantic core.  A carry family need only expose its
    mapped-majority prefix and the frame of its upper recursion; the erasure,
    relocation, recomputation, and down-pass are then discharged here. -/
theorem emitLoan_mapped_prefix_run_eq (d : Nat) (roles : List Wire)
    (layers : List CarryLayer) (top : Program)
    (bits : List MappedBit) (ys cs : List Wire) (cin : Wire)
    (s u v t : State) (m n : List Bool)
    (hn : (cin::(ys++cs)).Nodup)
    (ha : ∀q∈mappedWires bits,q∉cin::(ys++cs))
    (prefixShape : emitUps (layers.take (d+1))=
      carryPrefix (d+1) bits ys cs cin)
    (eraseShape : emitErases (layers.take d)=erasePrefix d bits ys cs cin)
    (borrowShape : emitUps (layers.take d)=carryPrefix d bits ys cs cin)
    (hostShape : layerHosts (layers.take d)=cs.take d)
    (prefixZero : measurementCount (emitUps (layers.take (d+1)))=0)
    (prefixRun : ∀rec,run (emitUps (layers.take (d+1))) rec s=u)
    (prefixReady : PrefixReady (d+1) bits ys cs cin u.basis)
    (prefixOutside : ∀q,q∉cs.take (d+1) → u.basis q=s.basis q)
    (clean : ∀q∈cs,s.basis q=false)
    (roleTail : ∀q∈roles.take d,q∈cs.drop (d+1))
    (upperRun : ∀rec,run (emitSweep (layers.drop (d+1)) top) rec u=v)
    (upperAway : ∀q∈wires (emitSweep (layers.drop (d+1)) top),
      q∉cs.take d)
    (upperSame : ∀q∈mappedWires (bits.take d)++ys.take d++cs.take d++[cin],
      v.basis q=u.basis q)
    (upperRoleZero : ∀q∈roles.take d,v.basis q=false)
    (wholeRun : ∀rec,run (emitSweep layers top) rec s=t) :
    run (emitLoan d roles layers top) m s=run (emitSweep layers top) n s := by
  let U := emitSweep (layers.drop (d+1)) top
  let P := emitUps (layers.take (d+1))
  let S := emitDowns (layers.take (d+1))
  let uc : State := ⟨u.phase,clearPrefix d cs u.basis⟩
  let vc : State := ⟨v.phase,clearPrefix d cs v.basis⟩
  have csND : cs.Nodup :=
    (List.nodup_append'.mp (List.nodup_cons.mp hn).2).2.1
  have disjointRole (q : Wire) (tail : q∈cs.drop (d+1)) : q∉cs.take d := by
    intro low
    have boundary : q∈cs.take (d+1) := by
      rw [show cs.take d=(cs.take (d+1)).take d by simp [List.take_take]] at low
      exact List.mem_of_mem_take low
    exact List.disjoint_left.mp
      (List.disjoint_take_drop csND (Nat.le_refl (d+1))) boundary tail
  have eraseRun (rec : List Bool) :
      run (emitErases (layers.take d)) rec u=uc := by
    rw [eraseShape]
    exact erasePrefix_run d bits ys cs cin u rec hn ha
      (PrefixReady.pred d bits ys cs cin u.basis prefixReady)
  have commute (rec : List Bool) : run U rec uc=vc := by
    have moved := run_clearPrefix_away U d cs u.phase u.basis rec upperAway
    change run U rec uc=⟨(run U rec u).phase,
      clearPrefix d cs (run U rec u).basis⟩ at moved
    rw [upperRun rec] at moved
    exact moved
  have zeroBefore : ∀q∈roles.take d++cs.take d,uc.basis q=false := by
    intro q hq
    simp only [List.mem_append] at hq
    rcases hq with role|host
    · have tail := roleTail q role
      change clearPrefix d cs u.basis q=false
      rw [clearPrefix_outside d cs u.basis q (disjointRole q tail),
        prefixOutside q (by
          intro boundary
          exact List.disjoint_left.mp
            (List.disjoint_take_drop csND (Nat.le_refl (d+1))) boundary tail)]
      exact clean q (List.mem_of_mem_drop tail)
    · exact clearPrefix_zero d cs u.basis q host
  have zeroAfter (rec : List Bool) :
      ∀q∈roles.take d++cs.take d,(run U rec uc).basis q=false := by
    rw [commute rec]
    change ∀q∈roles.take d++cs.take d,clearPrefix d cs v.basis q=false
    intro q hq
    simp only [List.mem_append] at hq
    rcases hq with role|host
    · rw [clearPrefix_outside d cs v.basis q
          (disjointRole q (roleTail q role))]
      exact upperRoleZero q role
    · exact clearPrefix_zero d cs v.basis q host
  have movedRun (rec : List Bool) :
      run (rebindMany (roles.take d) (layerHosts (layers.take d)) U) rec uc=vc := by
    rw [hostShape]
    exact (rebindMany_run (roles.take d) (cs.take d) U uc rec zeroBefore
      (zeroAfter rec)).trans (commute rec)
  have readyV : PrefixReady d bits ys cs cin v.basis :=
    PrefixReady.congr d bits ys cs cin u.basis v.basis
      (PrefixReady.pred d bits ys cs cin u.basis prefixReady) upperSame
  have recomputeRun (rec : List Bool) :
      run (emitUps (layers.take d)) rec vc=v := by
    rw [borrowShape]
    exact carryPrefix_clear d bits ys cs cin v.phase v.basis rec hn ha readyV
  have splitRun (rec : List Bool) : run (P++(U++S)) rec s=t := by
    have shape : P++(U++S)=emitSweep layers top := by
      rw [emitSweep_split (d+1)]
      simp only [P,U,S,List.append_assoc]
    rw [shape]
    exact wholeRun rec
  have suffixRun : ∀rec,run S rec v=t :=
    suffix_run_of_split P U S s u v t prefixZero prefixRun upperRun splitRun
  have replay := emitLoan_run d roles layers top s u uc vc v t m n
    prefixRun eraseRun upperRun movedRun recomputeRun suffixRun
  exact replay.1.trans replay.2.symm

theorem compare_prefix_shapes (d : Nat) (forward : Bool)
    (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length=bs.length) (hc : cs.length+1=bs.length)
    (hd : d≤cs.length) :
    emitUps ((compareLayers forward as bs cs cin target).take d)=
        carryPrefix d (mappedRead as false) bs cs cin ∧
      emitErases ((compareLayers forward as bs cs cin target).take d)=
        erasePrefix d (mappedRead as false) bs cs cin ∧
      layerHosts ((compareLayers forward as bs cs cin target).take d)=cs.take d := by
  induction d generalizing as bs cs cin with
  | zero => exact ⟨rfl,rfl,rfl⟩
  | succ d ih =>
      cases as with
      | nil =>
          have be : bs=[] := List.eq_nil_of_length_eq_zero hab.symm
          subst bs
          simp at hc
      | cons a as =>
          cases as with
          | nil =>
              have bl : bs.length=1 := by simpa using hab.symm
              have cl : cs=[] := List.eq_nil_of_length_eq_zero (by omega)
              subst cs
              simp at hd
          | cons a' as =>
              cases bs with
              | nil => simp at hab
              | cons b bs =>
                  cases bs with
                  | nil => simp at hab
                  | cons b' bs =>
                      cases cs with
                      | nil => simp at hd
                      | cons c cs =>
                          have tail := ih (a'::as) (b'::bs) cs c
                            (by simpa using hab) (by simpa using hc) (by simpa using hd)
                          rcases tail with ⟨up,erase,hosts⟩
                          constructor
                          · simpa [compareLayers,emitUps,carryPrefix,mappedRead,
                              mappedMajority,List.append_assoc] using
                              congrArg (fun P => majority a b cin c++P) up
                          constructor
                          · simpa [compareLayers,emitErases,erasePrefix,mappedRead,
                              mappedEraseCarry,List.append_assoc] using
                              congrArg (fun P => P++eraseCarry a b cin c) erase
                          · simpa [compareLayers,layerHosts] using
                              congrArg (List.cons c) hosts

theorem compare_upper_sweep (n : Nat) (forward : Bool)
    (as bs cs : List Wire) (cin target : Wire)
    (hab : as.length=bs.length) (hc : cs.length+1=bs.length)
