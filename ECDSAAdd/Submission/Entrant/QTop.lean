theorem shape (x : List Wire) (h:2≤x.length) : ∃a b xs,x=a::b::xs := by
  cases x with
  | nil => simp at h
  | cons a xs =>
    cases xs with
    | nil => simp at h
    | cons b xs => exact ⟨a,b,xs,rfl⟩

theorem lists_eq (x y cs : List Wire) (cin : Wire)
    (hn:(cin::x++y++cs).Nodup) (lx:x.length=32) (ly:y.length=32) (lc:cs.length=31)
