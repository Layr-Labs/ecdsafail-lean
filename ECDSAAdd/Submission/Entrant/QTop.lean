    DeltaSub (gen L cx cy) (ControlLoan1589BFFinal.gen L cx cy) 754 212 (128627+Rolling1588.slotGrowth) := by
  have squareCounts:=SquareCarryLoan719BF.counts_eq L
  have squareSlots:=SquareCarryLoan719BF.slots_eq L
