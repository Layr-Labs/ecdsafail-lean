/-! ### merged from `ECDSAAdd.Submission.Entrant.StairOddHead_at_QTop` -/
section Merge_StairOddHead_at_QTop

/-!
# Odd-word head of the division walk

The deficit-zero packets `1 .. 84` of the division field walk, run in the odd-word code of
submission 63c218c5: packet `1` starts with the junction half `P1Life.dstart` (standard words
in, odd words out), packets `2 .. 83` are ordinary odd-word packets, and packet `84` ends with
the junction half `P1Life.dend` (odd words in, standard words out).  The block has the cut frame
of the record block `Rolling1588.groups true 1 84`, so the two have equal runs on that frame.
-/

section
set_option autoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
set_option linter.unusedSimpArgs false

namespace ECDSAAdd.Entrant.RouteA.Rolling1588
open Arithmetic MappedCompressed DirectSkywalk Secp256k1 BalancedField OffsetBorrowedCanonical CompressedFieldSupport
open ECDSAAdd.Entrant.Rolling1588
attribute [local irreducible] run wires

/-- A division packet whose first half is the junction `dstart`. -/
def headFirstBase (j : Nat) : Program :=
  onPacket j (dp ++ ParityCodec5New.untwist) ++
    (cellWith true (P1Life.dstart (base 760) base (base 2409)) j 3 2 ++ cell true j 4 2 ++
      onPacket j bridge7 ++
      cell true j 4 2 ++ cell true j 3 2 ++ onPacket j bridge5 ++
      cell true j 4 2) ++
    onPacket j (ParityCodec5New.twist ++ ep)

/-- A division packet whose last half is the junction `dend`. -/
def headLastBase (j : Nat) : Program :=
  onPacket j (dp ++ ParityCodec5New.untwist) ++
    (cell true j 3 2 ++ cell true j 4 2 ++ onPacket j bridge7 ++
      cell true j 4 2 ++ cell true j 3 2 ++ onPacket j bridge5 ++
      cellWith true (P1Life.dend (base 760) base (base 2409)) j 4 2) ++
    onPacket j (ParityCodec5New.twist ++ ep)

def headFirstPacket (j : Nat) : Program :=
  renameProgram (shifted (Placement5.pi j)) (headFirstBase j)

def headLastPacket (j : Nat) : Program :=
  renameProgram (shifted (Placement5.pi j)) (headLastBase j)

/-- Packets `1 .. 84` of the division walk in the odd-word code. -/
def oddHead : Program :=
  headFirstPacket 1 ++ (groups true 2 82 ++ headLastPacket 84)

theorem headFirstBase_frame (j : Nat) (hj : j < 102)
    (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    StateTriple
      (CodeFrame centerWord centerWord (codeEncodeAt true (History5.historyMap base (5*j))) origin X Y)
      (headFirstBase j)
      (fun state => let V := regularPayload true j origin (X,Y)
        CodeFrame P1Life.oddWord P1Life.oddWord (codeEncodeAt false (History5.historyMap base (5*j))) origin V.1 V.2 state) := by
  let Frame (d : Bool) (k : Nat) (V : Fp×Fp) :=
    CodeFrame P1Life.oddWord P1Life.oddWord (stageCodeAt d k (History5.historyMap base (5*j))) origin V.1 V.2
  have opening (d : Bool) (V : Fp×Fp) : StateTriple
      (CodeFrame centerWord centerWord (codeEncodeAt d (History5.historyMap base (5*j))) origin V.1 V.2)
      (onPacket j stageOpen)
      (CodeFrame centerWord centerWord (stageCodeAt d 0 (History5.historyMap base (5*j))) origin V.1 V.2) := by
    intro state records input
    exact regular_open_frame centerWord centerWord d j hj origin ctx V.1 V.2 state records input
  have firstStep (V : Fp×Fp) : StateTriple
      (CodeFrame centerWord centerWord (stageCodeAt true 0 (History5.historyMap base (5*j))) origin V.1 V.2)
      (cellWith true (P1Life.dstart (base 760) base (base 2409)) j 3 2)
      (Frame true 0 (regularStep true j origin 0 V)) := by
    intro state records input
    exact regular_cellWith_frame _ true centerWord P1Life.oddWord dstart_law dstart_support
      j 0 0 3 hj (by decide) (by decide) origin ctx enabled V.1 V.2 state records input
  have step (d : Bool) (k logical physical : Nat) (hk : k < 3)
