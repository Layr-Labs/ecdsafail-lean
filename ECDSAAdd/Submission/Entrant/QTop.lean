/-! ### merged from `ECDSAAdd.Submission.Entrant.StairPhysicalPrimitivesFix505_at_QTop` -/
section Merge_StairPhysicalPrimitivesFix505_at_QTop

/-!
# Terminal-row reverse middle segment on the extended map (s505 fix)

`StairSchedule.reverseLast` runs `middleReverse 501 5`, i.e. the moved unticks
`505 .. 501` of the terminal row (budget 12).  Its first untick, tick 505, reads
the history letter `s 505` at its moved id `1028 + 505`.  LT13's row map
`midSegmentMap 12 = segMid 500 505` covers histories only through tick 504, so
that id falls to the shadow branch `base (4000 + 1533)`; the multiplication
terminal (`StairTerminalV3.reverseTerminalV3`) leaves `s 505` on `base 1548`
(= `sLetter 505`, the record's wire).

The fix keeps every program except this one segment: the reverse middle map of
a row is `segMid (startFor B) (reverseEnd B)` with `reverseEnd 12 = 506` and
`reverseEnd B = endFor B` for every other row.  The two maps differ only at the
id `1028 + 505` (`revSegmentMap_agree`), which now goes to `base 1548`
(`revSegmentMap_s505`).  Injectivity, pool nodup, history-above, row-site and
caller-domain facts are re-proved for `e ≤ 506`; `physicalPrimitivesFix_good`
and `physicalPrimitivesFix_caller` are LT13's `physicalPrimitives_good` /
`physicalPrimitives_caller` with the terminal reverse segment at its actual
length `reverseEnd B - startFor B - 1` (= 5 for the terminal row).
-/

section

set_option autoImplicit false
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairPhysicalPrimitivesFix505

open ECDSAAdd Arithmetic Challenge
open MappedCompressed Secp256k1 BalancedField Baselines
open StairOuterPlacement StairPhysicalInventory StairPhysicalLayout StairPhysicalPrimitives

/-! ## The extended reverse map -/

/-- Last moved untick + 1 of a row's reverse middle segment: the terminal row
also unticks tick 505 (its forward tick is inside the terminal blocks). -/
def reverseEnd (B : Nat) : Nat := if B = 12 then 506 else endFor B

/-- Reverse middle-segment map of a row. -/
def revSegmentMap (B : Nat) : Nat → Wire := segMid (startFor B) (reverseEnd B)

/-! ## K4-D (replay budget): injectivity through one left inverse

`segMap l e` and `segMid l e` are decoded by `D505.dec l` (an if-chain on the wire value); the decoding
identity needs one leaf per branch of `segMap` instead of one omega proof per pair of branches. -/
namespace D505

/-- Decoder of the fixed b-rail / carry-site values (`base (bNum k)`, `base (cNum k)`). -/
def tinv (w : Nat) : Nat :=
  if w = 530 then 854 else if w = 1043 then 855 else if w = 1560 then 856 else if w = 1561 then 857
  else if w = 1556 then 1624 else if w = 1813 then 1625 else if w = 1562 then 1626
  else if w < 1300 then (if w % 5 = 1 then 770 + (w - 1051) / 5 else 1540 + (w - 1053) / 5)
  else (if w % 5 = 2 then 770 + (2062 - w) / 5 else 1540 + (2060 - w) / 5)

/-- The part of the decoder that does not depend on the segment bounds. -/
def dec0 (w : Nat) : Nat :=
  if 4016 ≤ w then w - 4016
  else if w ≤ 529 then w - 16
  else if w = 2425 then 511
  else if 1564 ≤ w ∧ w ≤ 1644 then 3097 - w
  else tinv w

/-- Left inverse of `segMap l e` and of `segMid l e` (for `425 ≤ l ≤ 500`, `e ≤ 506`). -/
def dec (l w : Nat) : Nat := if w = 733 then l - 1 else dec0 w

theorem tabB : ∀ k, k < 88 → base (bNum k) ≠ 733 ∧ dec0 (base (bNum k)) = 770 + k := by
  decide +kernel

theorem tabC : ∀ k, k < 87 → base (cNum k) ≠ 733 ∧ dec0 (base (cNum k)) = 1540 + k := by
  decide +kernel

theorem dec_b (l k : Nat) (hk : k < 88) : dec l (base (bNum k)) = 770 + k :=
  (if_neg (tabB k hk).1).trans (tabB k hk).2

theorem dec_c (l k : Nat) (hk : k < 87) : dec l (base (cNum k)) = 1540 + k :=
  (if_neg (tabC k hk).1).trans (tabC k hk).2

theorem dec_zero (l : Nat) : dec l (base 717) = l - 1 := if_pos rfl

theorem dec_2409 (l : Nat) : dec l (base 2409) = 511 :=
  (if_neg (by decide : base 2409 ≠ 733)).trans (by decide : dec0 (base 2409) = 511)

theorem dec_hi (l q : Nat) : dec l (base (4000 + q)) = q := by
  unfold dec dec0 base
  rw [if_neg (by omega), if_pos (by omega)]
  omega

theorem dec_low (l x : Nat) (h : x ≤ 513) : dec l (base x) = x := by
  unfold dec dec0 base
  rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  omega

theorem dec_mid (l x : Nat) (h0 : 1548 ≤ x) (h1 : x ≤ 1628) : dec l (base x) = 3081 - x := by
  unfold dec dec0 base
  rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  omega

theorem dec_segMap (l e q : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500) (h2 : e ≤ 506) :
    dec l (segMap l e q) = q := by
  unfold segMap zeroWire
  split_ifs
  · rw [dec_zero]; omega
  · rw [dec_2409]; omega
  · exact dec_low l q (by omega)
  · rw [dec_b l (q - 770) (by omega)]; omega
  · rw [dec_mid l (2053 - (q - 1028)) (by omega) (by omega)]; omega
  · rw [dec_c l (q - 1540) (by omega)]; omega
  · exact dec_hi l q

theorem dec_segMid (l e q : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500) (h2 : e ≤ 506) :
    dec l (segMid l e q) = q := by
  unfold segMid
  by_cases h : q + 1 = l
  · rw [if_pos h, dec_low l (l - 1) (by omega)]; omega
  · rw [if_neg h]
    exact dec_segMap l e q h0 h1 h2

end D505


/-- `segMid_injective` for history ranges through tick 505. -/
theorem segMid_injective' (l e : Nat) (h0 : 425 ≤ l) (h1 : l ≤ 500)
    (h2 : e ≤ 506) : Function.Injective (segMid l e) := by
  intro x y eq
  have hx := D505.dec_segMid l e x h0 h1 h2
  rw [eq, D505.dec_segMid l e y h0 h1 h2] at hx
  exact hx.symm


theorem reverseEnd_le : ∀ B ∈ budgets, reverseEnd B ≤ 506 ∧ 425 ≤ startFor B ∧ startFor B ≤ 500 := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

theorem revSegmentMap_injective : ∀ B ∈ budgets, Function.Injective (revSegmentMap B) := by
  intro B hB
  obtain ⟨h2, h0, h1⟩ := reverseEnd_le B hB
  exact segMid_injective' _ _ h0 h1 h2

theorem revSegmentMap_pool_nodup : ∀ B ∈ budgets,
    (skywalkPoolWires (revSegmentMap B)).Nodup := by
  intro B hB
  unfold skywalkPoolWires wireBlock
  exact List.Nodup.map (revSegmentMap_injective B hB) List.nodup_range'



/-- Off the terminal row the reverse map is LT13's middle map. -/
theorem revSegmentMap_eq_mid (B : Nat) (h : B ≠ 12) : revSegmentMap B = midSegmentMap B := by
  simp only [revSegmentMap, midSegmentMap, reverseEnd, if_neg h]



/-! ## The fixed reverse middle program -/



/-! ## Row facts for the extended segment -/

theorem revTick_rowSites : ∀ B ∈ budgets, ∀ j, j < reverseEnd B → startFor B < j →
    ∀ q ∈ (W.compactSkywalkTickLayout (revSegmentMap B) j).wires, q ∈ rowSites B := by
  intro B hB
  by_cases h12 : B = 12
  · subst h12
    decide +kernel
  · intro j h1 h2
    have e1 : reverseEnd B = endFor B := by
      unfold reverseEnd
      exact if_neg h12
    rw [revSegmentMap_eq_mid B h12]
    rw [e1] at h1
    exact midTick_rowSites B hB j h1 h2

theorem revPacket_rowSites : ∀ B ∈ budgets, ∀ j, j < reverseEnd B → startFor B < j →
    History5.packDue j = true →
      ∀ k : Fin 10, History5.historyMap (revSegmentMap B) (j - 5) k ∈ rowSites B := by
  intro B hB
  by_cases h12 : B = 12
  · subst h12
    decide +kernel
  · intro j h1 h2 due
    have e1 : reverseEnd B = endFor B := by
      unfold reverseEnd
      exact if_neg h12
    rw [revSegmentMap_eq_mid B h12]
    rw [e1] at h1
    exact midPacket_rowSites B hB j h1 h2 due

theorem budget_shape_rev : ∀ B ∈ budgets,
    segmentOf (startFor B + 1) = B ∧
      startFor B + 1 + (reverseEnd B - startFor B - 1) = reverseEnd B ∧
      reverseEnd B ≤ 512 ∧ 5 < startFor B + 1 := by
  intro B hB
  simp only [budgets, List.mem_cons, List.not_mem_nil, or_false] at hB
  rcases hB with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide +kernel

/-- The terminal row's reverse middle call of `StairSchedule.reverseLast` is
exactly the row's full fixed segment. -/
theorem terminal_reverse_call :
    startFor 12 + 1 = 501 ∧ reverseEnd 12 - startFor 12 - 1 = 5 := by
  decide


/-! ## Good sites and caller domain with the fixed segment -/






