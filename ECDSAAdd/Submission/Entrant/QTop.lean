  have e := kcnt_take (OwnDiagLowK.oregs L ext src dst).z 31 q
  simp only [KG.all,KG.X,OwnDiagLowK.kgS,KRegs.all,OwnDiagLowK.jregsS,List.count_append,List.count_cons,List.count_nil] at c e ⊢
