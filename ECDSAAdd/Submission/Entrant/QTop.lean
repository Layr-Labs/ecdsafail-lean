private theorem placedExtra_avoids (L : ControlledPointLayout) (hw : L.Widths)
    (hn : L.wires.Nodup) (k : Nat) (hk : k<2613) (h1 : k≠719) (h2 : k≠914) (h3 : k≠978) :
