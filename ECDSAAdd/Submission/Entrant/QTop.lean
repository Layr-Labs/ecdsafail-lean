namespace ECDSAAdd.Entrant.StairOddHead
open Arithmetic MappedCompressed Secp256k1 BalancedField

/-- The standard-code instance of the route cut frame is the record cut frame. -/
theorem cutFrame_iff (cut : Nat) (origin : BasisState) (X Y : Fp) (state : State) :
    RouteA.Rolling1588.CutFrame centerWord centerWord cut origin X Y state ↔
      Rolling1588.CutFrame cut origin X Y state := Iff.rfl

/-- The odd-word head has the record cut frame of `Rolling1588.groups true 1 84`. -/
theorem oddHead_cut_frame (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) :
    Rolling1588.StateTriple (Rolling1588.CutFrame 1 origin X Y) RouteA.Rolling1588.oddHead
      (fun state => let V := Replay5.groupsPayload true origin 1 84 (X,Y)
        Rolling1588.CutFrame 85 origin V.1 V.2 state) := by
  intro state records input
  have result := RouteA.Rolling1588.oddHead_cut_frame origin ctx enabled X Y state records
    ((cutFrame_iff 1 origin X Y state).mpr input)
  exact ⟨result.1,(cutFrame_iff 85 origin _ _ _).mp result.2⟩

theorem cutFrame_unique (cut : Nat) (origin : BasisState) (X Y : Fp)
    (a b : State) (ha : Rolling1588.CutFrame cut origin X Y a)
    (hb : Rolling1588.CutFrame cut origin X Y b)
    (phase : a.phase = b.phase) : a = b := by
  obtain ⟨rawA, phaseA, frameA, encodedA⟩ := ha
  obtain ⟨rawB, phaseB, frameB, encodedB⟩ := hb
  have rawEq : rawA = rawB := by
    apply State.extensionality
    · exact phaseA.trans (phase.trans phaseB.symm)
    · exact PairFrame.unique _ _ origin _ _ _ _ frameA frameB
  rw [encodedA, encodedB, rawEq]

/-- Run equality of the odd-word head with the record packets `1 .. 84` on the record cut
frame, for independent measurement tapes. -/
theorem oddHead_run_eq (origin : BasisState) (ctx : FrontierReplay1591.Context origin)
    (enabled : origin (base 2400)=true) (X Y : Fp) (s : State) (fresh old : List Bool)
    (input : Rolling1588.CutFrame 1 origin X Y s) :
    run RouteA.Rolling1588.oddHead fresh s = run (Rolling1588.groups true 1 84) old s := by
  have odd := oddHead_cut_frame origin ctx enabled X Y s fresh input
  have record := Rolling1588.groups_cut_frame true 1 84 (by decide) (by decide) origin ctx
    enabled X Y s old input
  exact cutFrame_unique 85 origin
    (Replay5.groupsPayload true origin 1 84 (X, Y)).1
    (Replay5.groupsPayload true origin 1 84 (X, Y)).2 _ _ odd.2 record.2
    (odd.1.trans record.1.symm)

end ECDSAAdd.Entrant.StairOddHead
