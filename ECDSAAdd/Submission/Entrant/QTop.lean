  have alen : A.length=256 := by cases exchange <;> simp [A,widths.2.1,widths.2.2.1]
  have blen : B.length=256 := by cases exchange <;> simp [B,widths.2.1,widths.2.2.1]
  have clen : cs.length=255 := p1_active_length L hw
