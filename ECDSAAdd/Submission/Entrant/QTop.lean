theorem pieceAdd (x y c : List Wire) (hx : x.length = y.length) (hc : c.length + 1 = y.length)
    (hm : ∀ q ∈ x ++ y ++ c, Mem R S Z cs U cin q) :
    ∀ q ∈ wires (addInPlace x y c cin), Mem R S Z cs U cin q := by
