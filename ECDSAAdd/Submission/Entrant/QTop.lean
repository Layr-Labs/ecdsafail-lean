/-- The complete forward half removes the borrowed carry roles from support. -/
theorem forwardLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (forwardLoan d L760) ⊆
      wires (forwardLoan 0 L760) \ (retiredRoles.take d).toFinset := by
  have u0 := unchanged_support_erase (retiredRoles.take d).toFinset
    forwardU0 (forwardU0_away d hd)
  have u1 := unchanged_support_erase (retiredRoles.take d).toFinset
    forwardU1 (forwardU1_away d hd)
  have u2 := unchanged_support_erase (retiredRoles.take d).toFinset
    forwardU2 (forwardU2_away d hd)
  have u3 := unchanged_support_erase (retiredRoles.take d).toFinset
    forwardU3 (forwardU3_away d hd)
  have u4 := unchanged_support_erase (retiredRoles.take d).toFinset
    forwardU4 (forwardU4_away d hd)
  have h0 := append_support_erase (retiredRoles.take d).toFinset
    forwardU0 forwardU0 (rawAddLoan d L760) (rawAddLoan 0 L760)
    u0 (rawAddLoan_support760 d hd)
  have h1 := append_support_erase (retiredRoles.take d).toFinset
    (forwardU0 ++ rawAddLoan d L760) (forwardU0 ++ rawAddLoan 0 L760)
    forwardU1 forwardU1 h0 u1
  have h2 := append_support_erase (retiredRoles.take d).toFinset
    ((forwardU0 ++ rawAddLoan d L760) ++ forwardU1)
    ((forwardU0 ++ rawAddLoan 0 L760) ++ forwardU1)
    (foldLoan d L760) (foldLoan 0 L760) h1 (foldLoan_support760 d hd)
  have h3 := append_support_erase (retiredRoles.take d).toFinset
    (((forwardU0 ++ rawAddLoan d L760) ++ forwardU1) ++ foldLoan d L760)
    (((forwardU0 ++ rawAddLoan 0 L760) ++ forwardU1) ++ foldLoan 0 L760)
    forwardU2 forwardU2 h2 u2
  have h4 := append_support_erase (retiredRoles.take d).toFinset
    ((((forwardU0 ++ rawAddLoan d L760) ++ forwardU1) ++ foldLoan d L760) ++
      forwardU2)
    ((((forwardU0 ++ rawAddLoan 0 L760) ++ forwardU1) ++ foldLoan 0 L760) ++
      forwardU2)
    (compareBlockLoan d true L760) (compareBlockLoan 0 true L760)
    h3 (compareBlockLoan_support760 d true hd)
  have h5 := append_support_erase (retiredRoles.take d).toFinset
    (((((forwardU0 ++ rawAddLoan d L760) ++ forwardU1) ++ foldLoan d L760) ++
      forwardU2) ++ compareBlockLoan d true L760)
    (((((forwardU0 ++ rawAddLoan 0 L760) ++ forwardU1) ++ foldLoan 0 L760) ++
      forwardU2) ++ compareBlockLoan 0 true L760)
    forwardU3 forwardU3 h4 u3
  have h6 := append_support_erase (retiredRoles.take d).toFinset
    ((((((forwardU0 ++ rawAddLoan d L760) ++ forwardU1) ++ foldLoan d L760) ++
      forwardU2) ++ compareBlockLoan d true L760) ++ forwardU3)
    ((((((forwardU0 ++ rawAddLoan 0 L760) ++ forwardU1) ++ foldLoan 0 L760) ++
      forwardU2) ++ compareBlockLoan 0 true L760) ++ forwardU3)
    (unnormalizeLoan d L760) (unnormalizeLoan 0 L760)
    h5 (unnormalizeLoan_support760 d hd)
  have h7 := append_support_erase (retiredRoles.take d).toFinset
    (((((((forwardU0 ++ rawAddLoan d L760) ++ forwardU1) ++ foldLoan d L760) ++
      forwardU2) ++ compareBlockLoan d true L760) ++ forwardU3) ++
      unnormalizeLoan d L760)
    (((((((forwardU0 ++ rawAddLoan 0 L760) ++ forwardU1) ++ foldLoan 0 L760) ++
      forwardU2) ++ compareBlockLoan 0 true L760) ++ forwardU3) ++
      unnormalizeLoan 0 L760)
    forwardU4 forwardU4 h6 u4
  simpa only [forwardLoan, forwardU0, forwardU1, forwardU2, forwardU3,
    forwardU4, List.append_assoc] using h7

/-- The complete inverse half removes the borrowed carry roles from support. -/
theorem inverseLoan_support760 (d : Nat) (hd : d ≤ 68) :
    wires (inverseLoan d L760) ⊆
      wires (inverseLoan 0 L760) \ (retiredRoles.take d).toFinset := by
  have u0 := unchanged_support_erase (retiredRoles.take d).toFinset
    inverseU0 (inverseU0_away d hd)
  have u1 := unchanged_support_erase (retiredRoles.take d).toFinset
    inverseU1 (inverseU1_away d hd)
  have u2 := unchanged_support_erase (retiredRoles.take d).toFinset
    inverseU2 (inverseU2_away d hd)
  have u3 := unchanged_support_erase (retiredRoles.take d).toFinset
    inverseU3 (inverseU3_away d hd)
  have h0 := append_support_erase (retiredRoles.take d).toFinset
    inverseU0 inverseU0 (normalizeLoan d L760) (normalizeLoan 0 L760)
    u0 (normalizeLoan_support760 d hd)
  have h1 := append_support_erase (retiredRoles.take d).toFinset
    (inverseU0 ++ normalizeLoan d L760) (inverseU0 ++ normalizeLoan 0 L760)
    inverseU1 inverseU1 h0 u1
  have h2 := append_support_erase (retiredRoles.take d).toFinset
    ((inverseU0 ++ normalizeLoan d L760) ++ inverseU1)
    ((inverseU0 ++ normalizeLoan 0 L760) ++ inverseU1)
    (compareBlockLoan d false L760) (compareBlockLoan 0 false L760)
    h1 (compareBlockLoan_support760 d false hd)
  have h3 := append_support_erase (retiredRoles.take d).toFinset
    (((inverseU0 ++ normalizeLoan d L760) ++ inverseU1) ++
      compareBlockLoan d false L760)
    (((inverseU0 ++ normalizeLoan 0 L760) ++ inverseU1) ++
      compareBlockLoan 0 false L760)
    inverseU2 inverseU2 h2 u2
  have h4 := append_support_erase (retiredRoles.take d).toFinset
    ((((inverseU0 ++ normalizeLoan d L760) ++ inverseU1) ++
      compareBlockLoan d false L760) ++ inverseU2)
    ((((inverseU0 ++ normalizeLoan 0 L760) ++ inverseU1) ++
      compareBlockLoan 0 false L760) ++ inverseU2)
    (unfoldLoan d L760) (unfoldLoan 0 L760) h3 (unfoldLoan_support760 d hd)
  have h5 := append_support_erase (retiredRoles.take d).toFinset
    (((((inverseU0 ++ normalizeLoan d L760) ++ inverseU1) ++
      compareBlockLoan d false L760) ++ inverseU2) ++ unfoldLoan d L760)
    (((((inverseU0 ++ normalizeLoan 0 L760) ++ inverseU1) ++
      compareBlockLoan 0 false L760) ++ inverseU2) ++ unfoldLoan 0 L760)
    inverseU3 inverseU3 h4 u3
  have h6 := append_support_erase (retiredRoles.take d).toFinset
    ((((((inverseU0 ++ normalizeLoan d L760) ++ inverseU1) ++
      compareBlockLoan d false L760) ++ inverseU2) ++ unfoldLoan d L760) ++
      inverseU3)
    ((((((inverseU0 ++ normalizeLoan 0 L760) ++ inverseU1) ++
      compareBlockLoan 0 false L760) ++ inverseU2) ++ unfoldLoan 0 L760) ++
      inverseU3)
    (rawSubTailLoan d L760) (rawSubTailLoan 0 L760)
    h5 (rawSubTailLoan_support760 d hd)
  simpa only [inverseLoan, inverseU0, inverseU1, inverseU2, inverseU3,
    List.append_assoc] using h6

/-- The inverse wrapped half as an explicit append chain. -/
theorem half760Loan_false_eq (d : Nat) :
    half760Loan d false =
      ([.X (base 2409)] ++ inverseLoan d L760 ++ [.X (base 2409)]) ++
        [.measureX (base 1027) [] []] := by
  simp only [half760Loan, Bool.false_eq_true, if_false]

/-- The forward wrapped half as an explicit append chain. -/
theorem half760Loan_true_eq (d : Nat) :
    half760Loan d true =
      [.X (base 2409)] ++ forwardLoan d L760 ++ [.X (base 2409)] := by
  simp only [half760Loan, if_true, List.append_nil]

/-- Exact support erasure for the wrapped staircase half, before comparing the
record lifetime implementation with the original endpoint half. -/
theorem half760Loan_support760 (d : Nat) (divide : Bool) (hd : d ≤ 68) :
    wires (half760Loan d divide) ⊆
      wires (half760Loan 0 divide) \ (retiredRoles.take d).toFinset := by
  have signAway := away_take_of_away [.X (base 2409)] signX760_away d
  cases divide with
  | false =>
      have measureAway := away_take_of_away
        [.measureX (base 1027) [] []] inverseMeasure760_away d
      rw [half760Loan_false_eq d, half760Loan_false_eq 0]
      apply append_support_erase
      · apply framed_support_erase
        · exact inverseLoan_support760 d hd
        · exact signAway
        · exact signAway
      · exact unchanged_support_erase _ _ measureAway
  | true =>
      rw [half760Loan_true_eq d, half760Loan_true_eq 0]
      apply framed_support_erase
      · exact forwardLoan_support760 d hd
      · exact signAway
      · exact signAway


end ECDSAAdd.Entrant.StairLoanSupport
end Merge_StairLoanSupportHalf_at_QTop

