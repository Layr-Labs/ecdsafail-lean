def parityToggles (d xm tm : Nat) : Program :=
  ((selected d xm).map (fun i => Instr.CX i 16)) ++
  ((selected 16 tm).map (fun k => Instr.CX (18+k) 17))

def productGates (d previousX previousTag : Nat) : List (Nat × Nat × Nat) → Program
  | [] => parityToggles d previousX previousTag
  | (xm,tm,om) :: rest =>
    let update := match selected d om with
      | [] => []
      | head :: tail =>
        let fan := tail.map (fun i => Instr.CX (8+head) (8+i))
        fan ++ [Instr.CCX 16 17 (8+head)] ++ fan.reverse
    parityToggles d (previousX ^^^ xm) (previousTag ^^^ tm) ++ update ++ productGates d xm tm rest

