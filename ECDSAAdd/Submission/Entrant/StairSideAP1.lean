namespace ECDSAAdd.Entrant.StairArchiveRelease
open Arithmetic CodecBitSliceVerify StairArchiveGates ArchiveFieldScratch

inductive Stage where
  | enter0
  | switch0
  | leave0
  | enter1
  | switch1
  | leave1

def program : Stage → Program
  | .enter0 => ReducedWindowArchives.enter0
  | .switch0 => ReducedWindowArchives.switch0
  | .leave0 => ReducedWindowArchives.leave0
  | .enter1 => ReducedWindowArchives.enter1
  | .switch1 => ReducedWindowArchives.switch1
  | .leave1 => ReducedWindowArchives.leave1

def inputCols : Stage → Cols
  | .enter0 => ReducedWindowArchives.enter0StoredIn
  | .switch0 => switch0Trace0In
  | .leave0 => leave0Trace0In
  | .enter1 => ReducedWindowArchives.enter1StoredIn
  | .switch1 => switch1Trace0In
  | .leave1 => leave1Trace0In

def outputCols : Stage → Cols
  | .enter0 => enter0Trace3Out
  | .switch0 => switch0Trace2Out
  | .leave0 => ReducedWindowArchives.leave0StoredOut
  | .enter1 => enter1Trace3Out
  | .switch1 => switch1Trace2Out
  | .leave1 => ReducedWindowArchives.leave1StoredOut

set_option maxRecDepth 20000
set_option exponentiation.threshold 100000
set_option maxHeartbeats 3000000

theorem sub (op : Stage) : wires (program op) ⊆ Finset.range 121 := by
  cases op with
  | enter0 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.enter0_scope _ h) (by decide))
  | switch0 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.switch0_scope _ h) (by decide))
  | leave0 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.leave0_scope _ h) (by decide))
  | enter1 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.enter1_scope _ h) (by decide))
  | switch1 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.switch1_scope _ h) (by decide))
  | leave1 =>
    exact fun _ h => Finset.mem_range.mpr (Nat.lt_trans (ReducedWindowArchives.leave1_scope _ h) (by decide))

def placed (j : Nat) (op : Stage) := renameProgram (port j) (program op)

private theorem row_run (op : Stage) (row x : Nat) (hr : row < 63145)
    (m : List Bool) (s : State) (bitrow : Rel (inputCols op) x row)
    (data : ∀ q ∈ wires (program op), s.basis q = x.testBit q) :
    (run (program op) m s).phase = s.phase ∧
    (∀ q ∈ wires (program op), (run (program op) m s).basis q = (get (outputCols op) q).testBit row) ∧
    (∀ q ∉ wires (program op), (run (program op) m s).basis q = s.basis q) := by
  have active : (2^63145-1 : Nat).testBit row = true := by
    rw [Nat.testBit_two_pow_sub_one]
    exact decide_eq_true hr
  cases op with
  | enter0 => exact ReducedWindowArchives.enter0_run row x m s active bitrow data
  | switch0 => exact ReducedWindowArchives.switch0_run row x m s active bitrow data
  | leave0 => exact ReducedWindowArchives.leave0_run row x m s active bitrow data
  | enter1 => exact ReducedWindowArchives.enter1_run row x m s active bitrow data
  | switch1 => exact ReducedWindowArchives.switch1_run row x m s active bitrow data
  | leave1 => exact ReducedWindowArchives.leave1_run row x m s active bitrow data

theorem placed_run (j : Nat) (hj : j ∈ List.range' 1 83) (op : Stage)
    (row x : Nat) (hr : row < 63145) (m : List Bool) (s : State)
    (bitrow : Rel (inputCols op) x row)
    (data : ∀ q ∈ wires (program op), s.basis (port j q) = x.testBit q) :
    (run (placed j op) m s).phase = s.phase ∧
    (∀ q ∈ wires (program op), (run (placed j op) m s).basis (port j q) =
      (get (outputCols op) q).testBit row) ∧
    (∀ q ∉ wires (placed j op), (run (placed j op) m s).basis q = s.basis q) := by
  have core := row_run op row x hr m (pullState (port j) s) bitrow data
  have lifted := transfer j hj (program op) (sub op) m s
  exact ⟨lifted.1.trans core.1, fun q hq => (lifted.2 q (sub op hq)).trans (core.2.1 q hq),
    fun q hq => run_preserves_outside _ _ _ q hq⟩

end ECDSAAdd.Entrant.StairArchiveRelease

end

