namespace ECDSAAdd.Entrant.StairPacket

/-- In floor((M+j)/U), the one-bit carry can be read directly from the two
most significant *retained* low bits when 0≤j≤U/2. The integer host never
needs a comparison across the full low registers. -/
theorem half_limb_borrow (half M j : Nat) (pos : 0 < half) (gap : j ≤ half) :
    let U := 2*half
    let X := M+j
    X/U = M/U + (if half≤M%U ∧ X%U<half then 1 else 0) := by
  dsimp only
  let U:=2*half
  have up:0<U:=by dsimp [U];omega
  have rm:M%U<U:=Nat.mod_lt _ up
  have eqn:=Nat.mod_add_div M U
  have decomp : M+j=(M%U+j)+U*(M/U) := by omega
  change (M+j)/U=M/U+(if half≤M%U ∧ (M+j)%U<half then 1 else 0)
  rw [decomp,Nat.add_mul_div_left _ _ up]
  rw [Nat.add_mul_mod_self_left]
  by_cases low:M%U+j<U
  · rw [Nat.mod_eq_of_lt low,Nat.div_eq_of_lt low]
    have impossible : ¬(half≤M%U ∧ M%U+j<half) := by omega
    simp [impossible]
  · have base : M%U+j= (M%U+j-U)+U*1 := by omega
    have high : M%U+j-U < U := by dsimp [U] at *;omega
    have sign : half≤M%U ∧ M%U+j-U<half := by dsimp [U] at *;omega
    conv_lhs => rw [base,Nat.add_mul_div_left _ _ up,Nat.div_eq_of_lt high]
    conv_rhs => rw [base,Nat.add_mul_mod_self_left,Nat.mod_eq_of_lt high]
    simp only [if_pos sign,Nat.zero_add]
    omega

/-- The second signed rail has magnitude M=u−e, with e its sign bit. The
positive rail always holds u+v. A short u contributes no upper digit at all. -/
theorem companion_upper (half u v e : Nat) (hp:0<half) (en:e≤1) (eu:e≤u)
    (bound:min u v<half) :
    let M:=u-e
    let X:=u+v
    let U:=2*half
    let borrow:Nat:=if half≤M%U ∧ X%U<half then 1 else 0
    if half≤M then X/U=M/U+borrow else M/U=0 := by
  dsimp only
  split
  · rename_i h
    have hv:v<half:=by omega
    have eqn : u+v=(u-e)+(v+e) := by omega
    rw [eqn]
    exact half_limb_borrow _ _ _ hp (by omega)
  · apply Nat.div_eq_of_lt
    omega


end ECDSAAdd.Entrant.StairPacket

end

