theorem enter1_run (row x : Nat) (m : List Bool) (s : State)
    (active : StairArchiveColumns.col312.testBit row = true)
    (input : Rel enter1StoredIn x row) (state : ∀ q ∈ wires enter1, s.basis q = x.testBit q) :
    (run enter1 m s).phase = s.phase ∧
    (∀ q ∈ wires enter1, (run enter1 m s).basis q = (get enter1Trace3Out q).testBit row) ∧
    (∀ q ∉ wires enter1, (run enter1 m s).basis q = s.basis q) :=
  StairArchiveRows.run_row enter1 _ row x m s enter1StoredIn enter1Trace3Out active
    (WSlimBlock.targets_sound _ _ (by decide +kernel)) input enter1_checked state

