private theorem adjust20_targets (j : Fin 9) :
    ∀ g ∈ leaveAdjust20 (start20 j),
      GateMirror.target g ≠ a0P20 (start20 j) - 1 + 21 ∧
      GateMirror.target g ≠ 1559 ∧
      GateMirror.target g ≠ e0P20 (start20 j) + 4 := by
  have hg := geom20_facts j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hbank : ∀ y ∈ (List.range (wpP20 (start20 j))).map (bankW20 (start20 j)),
      True ∧ (y ≠ a0P20 (start20 j) - 1 + 21 ∧ y ≠ 1559 ∧ y ≠ e0P20 (start20 j) + 4) := by
    intro y hy; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hy; rw [List.mem_range] at hi
    refine ⟨trivial, ?_⟩
    rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
      (rw [eb]; refine ⟨by unfold Wire at *; omega, by unfold Wire at *; omega, by unfold Wire at *; omega⟩)
  have hpool : ∀ c ∈ (List.range (wpP20 (start20 j) - 1)).map (poolW20 (start20 j)),
      True ∧ (c ≠ a0P20 (start20 j) - 1 + 21 ∧ c ≠ 1559 ∧ c ≠ e0P20 (start20 j) + 4) := by
    intro c hc; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hc; rw [List.mem_range] at hi
    refine ⟨trivial, ?_⟩
    rcases pool20_cases j i with ⟨_, ep⟩ | ⟨_, ep⟩ <;>
      (rw [ep]; refine ⟨by unfold Wire at *; omega, by unfold Wire at *; omega, by unfold Wire at *; omega⟩)
  have h : AllAT (fun _ => True)
      (fun q => q ≠ a0P20 (start20 j) - 1 + 21 ∧ q ≠ 1559 ∧ q ≠ e0P20 (start20 j) + 4)
      (leaveAdjust20 (start20 j)) := by
    unfold leaveAdjust20 leaveAdjustCore20
    refine allAT_append (allAT_cons ⟨fun _ _ => trivial,
      ⟨by simp only [GateMirror.target, e0P20, a0P20, Wire]; omega,
       by simp only [GateMirror.target, e0P20, Wire]; omega,
       by simp only [GateMirror.target, e0P20, Wire]; omega⟩⟩ allAT_nil)
      (allAT_adjustG _ _ _ _ hbank hpool trivial trivial)
  intro g hg'; exact (h g hg').2

private theorem barrel20_away (j : Fin 9) (q : Wire)
    (hq : q = a0P20 (start20 j) - 1 + 21 ∨ q = 1559 ∨ q = e0P20 (start20 j) + 4) :
    q ∉ wires (barrel20 (start20 j) false) := by
  have hg := geom20_facts j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  intro hm
  rcases barrel20_wires j false q hm with ⟨i, hi, e⟩ | ⟨r, hr, e⟩ | ht
  · rcases bank20_cases j (i := i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
      (rw [eb] at e; rcases hq with rfl | rfl | rfl <;> (unfold Wire at *; omega))
  · have hp : poolW20 (start20 j) (22 + r) = 1625 + r := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp] at e; rcases hq with rfl | rfl | rfl <;> (unfold Wire at *; omega)
  · have tr := tagsP20_range q ht
    rcases hq with rfl | rfl | rfl <;> (unfold Wire at *; omega)

private theorem lowRest20_1558 (s : Nat) (t : State) :
    (run (GateMirror.forward (lowRest20_pub s)) [] t).basis 1558 = false := by
