      (allAT_cons (ok_x (A := fun _ => True) (T := fun q => q ≠ 1558) (by decide)) allAT_nil)
  have h := allAT_chainG (A := fun _ => True) (T := fun q => q ≠ 1558) (storeWire20 s)
    (fun i => if i = 0 then a0P20 s + lowsP20 s - 2 else bankW20 s (lowsP20 s + i - 1)) _ hb
    1 (liveW20 s - lowsP20 s)
    (fun k h1 _ => ⟨trivial, fun hgt hk => by
      unfold storeWire20 at hk; dsimp only at hk; split_ifs at hk <;> (unfold Wire at *; omega)⟩)
    (fun _ _ _ => trivial)
  intro g hg; exact (h g hg).2

private theorem red20_preFlag_eq (sc : Nat) :
    let b := sbP20 sc
    firstRows20 sc b ++ (cell21_20 sc b ++ (headEnd20 sc b ++
      ([.ccx (sc + 35) (b + 807) (sc + b + 57)] ++ headA1_20 sc))) = entryLeave20 sc := by
  unfold entryLeave20 headA1_20; dsimp only; conv_rhs => rw [fix0P20_split5 sc (sbP20 sc)]
