/-! ### Section 1: Tail Definitions & Structural Decomposition -/

def smallA20 (j : Fin 9) : List Wire :=
  (List.range (lowsP20 (start20 j) - 1)).map (a0P20 (start20 j) + ·)

def smallM20 (j : Fin 9) : List Wire :=
  (List.range (lowsP20 (start20 j) - 1)).map (b0P20 (start20 j) + ·)

def smallC20 (j : Fin 9) : List Wire :=
  (List.range (lowsP20 (start20 j) - 1 - 1)).map (1559 + ·)

def pendingPairs20 (j : Fin 9) : List (Wire × Wire) :=
  let s := start20 j
  let L := lowsP20 s
  let H := liveW20 s - L
  (List.range (H + 1)).map fun k =>
    (if k = 0 then a0P20 s + L - 2 else bankW20 s (L + k - 1), storeWire20 s (k + 1))

def clearFlagPairs20 (j : Fin 9) : List (Wire × Wire) :=
  (List.range (lowsP20 (start20 j))).map fun k => (b0P20 (start20 j) - 1 + k, 1559 + k)

def low20 (j : Fin 9) : List (Wire × Wire) :=
  (List.range (lowsP20 (start20 j))).map fun i => (a0P20 (start20 j) - 1 + i, b0P20 (start20 j) - 1 + i)

def events20 (j : Fin 9) : List (Wire × Wire) :=
  ([(0, 1556), (1, 1559), (2, 1560), (3, 1561), (4, 1562),
    (5, 1563), (6, 1564), (7, 1565), (8, 1566), (9, 1567)]).map fun p => (swaps20 j p.1, p.2)

def nextLen20 (j : Fin 9) : Nat := if j.val < 8 then 20 else 15

/-- G4 (margin 21): the borrow pair recomputed from the true bits before the companion restore. -/
def borrowG4_20 (j : Fin 9) : Program :=
  [.CX (a0P20 (start20 j) - 1) 1557, .X 1557, .CCX (b0P20 (start20 j) - 1) 1557 1558]

def fullProg20 (j : Fin 9) : Program :=
  core20Prog j ++ (borrowG4_20 j ++ Companion.restore (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558)

def beforeStore20 (j : Fin 9) : Program :=
  fullProg20 j ++ (releaseMaskP20 j ++ GateMirror.forward (leaveStoreMapped20 (start20 j)))

def storeMapped20 (j : Fin 9) : Program :=
  beforeStore20 j ++ GateMirror.forward (leaveLowClose20 (start20 j))

private theorem forward_chainG20 (c seq : Nat → Wire) (out : Wire) : ∀ (i n : Nat),
    GateMirror.forward (chainG c seq [.cx (c (i + n)) out, .x out] i n) =
      PortalAnd.chain true none out (c i) ((List.range n).map fun k => (seq (i + k), c (i + k + 1)))
  | i, 0 => by simp [chainG, PortalAnd.chain, PortalAnd.target, GateMirror.forward, front]
  | i, n + 1 => by
    have ih := forward_chainG20 c seq out (i + 1) n
    rw [show i + 1 + n = i + (n + 1) by omega] at ih
    have el : (List.range (n + 1)).map (fun k => (seq (i + k), c (i + k + 1))) =
        (seq i, c (i + 1)) :: (List.range n).map (fun k => (seq (i + 1 + k), c (i + 1 + k + 1))) := by
      rw [List.range_succ_eq_map, List.map_cons, List.map_map]
      refine congrArg₂ List.cons rfl (List.map_congr_left fun k _ => ?_)
      show (seq (i + (k + 1)), c (i + (k + 1) + 1)) = (seq (i + 1 + k), c (i + 1 + k + 1))
      rw [show i + (k + 1) = i + 1 + k by omega]
    show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) ::
      (chainG c seq [.cx (c (i + (n + 1))) out, .x out] (i + 1) n ++ [.pop (c i) (seq i) (c (i + 1))])) = _
    rw [show GateMirror.forward (.make (c i) (seq i) (c (i + 1)) :: _) =
      front (.make (c i) (seq i) (c (i + 1))) :: GateMirror.forward _ from rfl,
      forward_app, ih, el]
    rfl

private theorem forward_eventsG20 : ∀ (ps : List (Wire × Wire)) (a out : Wire),
    GateMirror.forward (eventsG a out ps) = LeaveNoSwap.block a out ps
  | [], _, _ => rfl
  | (x, t) :: ps, a, out => by
    show GateMirror.forward ([.x x, .make a x t] ++ (eventsG t out ps ++ [.pop a x t, .x x])) = _
    rw [forward_app, forward_app, forward_eventsG20 ps t out]; rfl

private theorem forward_swapsG20 : ∀ ps : List (Wire × Wire),
    GateMirror.forward (swapsG ps) = LeaveRelocation.program ps
  | [] => rfl
  | (a, b) :: ps => by
    show GateMirror.forward ([.cx a b, .cx b a, .cx a b] ++ swapsG ps) =
      [.CX a b, .CX b a, .CX a b] ++ LeaveRelocation.program ps
    rw [forward_app, forward_swapsG20 ps]; rfl

private theorem storeWire20_zero (s : Nat) : storeWire20 s 0 = 1558 := by
  unfold storeWire20 e0P20; dsimp only
  split_ifs <;> ((try unfold Wire at *); omega)

private theorem pending20_fst (j : Fin 9) :
    (pendingPairs20 j).map Prod.fst =
      (a0P20 (start20 j) + lowsP20 (start20 j) - 2) ::
        (List.range (liveW20 (start20 j) - lowsP20 (start20 j))).map (fun i => bankW20 (start20 j) (lowsP20 (start20 j) + i)) := by
  simp only [pendingPairs20, List.map_map, Function.comp]
  rw [List.range_succ_eq_map, List.map_cons, List.map_map]
  simp only [Function.comp, if_pos, Nat.succ_ne_zero, if_false]
  congr 1

private theorem clearFlag20_fst (j : Fin 9) :
    (clearFlagPairs20 j).map Prod.fst = (List.range (lowsP20 (start20 j))).map (b0P20 (start20 j) - 1 + ·) := by
  simp only [clearFlagPairs20, List.map_map]; rfl

theorem lowStore20_parts (j : Fin 9) :
    GateMirror.forward (leaveLowStore20 (start20 j)) =
      GateMirror.forward (lowSign20 (start20 j)) ++
      (borrowG4_20 j ++ (Companion.restore (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558 ++ releaseMaskP20 j)) := by
  have hc : GateMirror.forward ((List.range (lowsP20 (start20 j) - 1)).map
      fun i => Gate.make 1556 (a0P20 (start20 j) + i) (b0P20 (start20 j) + i)) =
      copyRegister (some 1556) (smallA20 j) (smallM20 j) := by
    rw [smallA20, smallM20, LeaveJ7.copy_map]; simp only [GateMirror.forward, List.map_map]; rfl
  simp only [leaveLowStore20, forward_app, forward_addG, LeaveJ7.forward_xsG', hc,
    Companion.restore, HighBankUnit.sub, mappedSub, smallM20, smallC20, List.append_assoc]
  rfl

theorem storeMapped20_parts (j : Fin 9) :
    GateMirror.forward (leaveStoreMapped20 (start20 j)) =
      latch true none 1557 1558 (pendingPairs20 j) ++
        ([.CCX 1556 1557 1558] ++ latch true none 1556 1558 (clearFlagPairs20 j)) := by
  have ch1 : GateMirror.forward (chainG (storeWire20 (start20 j))
      (fun i => if i = 0 then a0P20 (start20 j) + lowsP20 (start20 j) - 2 else bankW20 (start20 j) (lowsP20 (start20 j) + i - 1))
      [.cx (storeWire20 (start20 j) (liveW20 (start20 j) - lowsP20 (start20 j) + 1)) 1557, .x 1557]
      0 (liveW20 (start20 j) - lowsP20 (start20 j) + 1)) =
      PortalAnd.chain true none 1557 1558 (pendingPairs20 j) := by
    have h := forward_chainG20 (storeWire20 (start20 j))
      (fun i => if i = 0 then a0P20 (start20 j) + lowsP20 (start20 j) - 2 else bankW20 (start20 j) (lowsP20 (start20 j) + i - 1))
      1557 0 (liveW20 (start20 j) - lowsP20 (start20 j) + 1)
    simp only [Nat.zero_add, storeWire20_zero] at h
    exact h
  have ch2 : GateMirror.forward (chainG (fun i => (1558 + i : Wire)) (fun i => b0P20 (start20 j) - 1 + i)
      [.cx (1558 + lowsP20 (start20 j)) 1556, .x 1556] 0 (lowsP20 (start20 j))) =
      PortalAnd.chain true none 1556 1558 (clearFlagPairs20 j) := by
    have h := forward_chainG20 (fun i => (1558 + i : Wire)) (fun i => b0P20 (start20 j) - 1 + i)
      1556 0 (lowsP20 (start20 j))
    simp only [Nat.zero_add] at h
    have e : (List.range (lowsP20 (start20 j))).map (fun k => (b0P20 (start20 j) - 1 + k, (1558 + (k + 1) : Wire))) =
        clearFlagPairs20 j := by
      simp only [clearFlagPairs20]; apply List.map_congr_left; intro k _
      simp only [Prod.mk.injEq, true_and]; unfold Wire; omega
    rw [← e]; exact h
  have fc (g : Gate) (gs : List Gate) : GateMirror.forward (g :: gs) = front g :: GateMirror.forward gs := rfl
  have fn : GateMirror.forward [] = [] := rfl
  simp only [leaveStoreMapped20, forward_app, LeaveJ7.forward_xsG', ch1, ch2, PortalAnd.latch, PortalAnd.digits,
    pending20_fst, clearFlag20_fst, fc, fn, front, GateMirror.erase, notRegister, List.map_cons, List.map_nil,
    List.map_append, List.reverse_cons, List.append_assoc, List.cons_append, List.singleton_append, List.nil_append,
    if_true, ↓reduceIte]

theorem lowClose20_parts (j : Fin 9) :
    GateMirror.forward (leaveLowClose20 (start20 j)) =
      notRegister (history20 j) ++ RailPair.store (start20 j + 35) (e0P20 (start20 j) + 5) (low20 j) [] := by
  have e1 : GateMirror.forward ((List.range (lowsP20 (start20 j))).map
      fun i => Gate.cx (e0P20 (start20 j) + 5) (b0P20 (start20 j) - 1 + i)) =
      signComplement (e0P20 (start20 j) + 5) ((low20 j).map Prod.snd) := by
    simp only [GateMirror.forward, signComplement, low20, List.map_map]; rfl
  have e2 : GateMirror.forward ((List.range (lowsP20 (start20 j))).flatMap
      fun i => cswapG (start20 j + 35) (b0P20 (start20 j) - 1 + i) (a0P20 (start20 j) - 1 + i)) =
      exchange (start20 j + 35) (low20 j) := by
    simp only [GateMirror.forward, exchange, low20, List.map_flatMap, List.flatMap_map]; rfl
  simp only [leaveLowClose20, forward_app, LeaveJ7.forward_xsG', e1, e2, RailPair.store, RailPair.transfer,
    List.flatMap_nil, List.nil_append, List.append_assoc]
  rfl

theorem close20_parts (j : Fin 9) :
    GateMirror.forward (leaveClose20 (start20 j)) =
      GateMirror.forward (closeFlag20 (start20 j)) ++
        LeaveRelocation.program (movesP20 (start20 j)) := by
  unfold leaveClose20
  rw [forward_app, forward_swapsG20]

theorem leaveP20_split (j : Fin 9) :
    leaveP20 j = storeMapped20 j ++ GateMirror.forward (leaveClose20 (start20 j)) := by
  have h1 := lowStore20_parts j
  unfold leaveP20 leaveBefore20 leaveAfter20 storeMapped20 beforeStore20 fullProg20 core20Prog work20Prog
    entryLeave20 selPrefix20
  simp only [forward_app, List.append_assoc]
  rw [h1]
  simp only [List.append_assoc]

/-! ### Section 2: Layout & Geometry Facts -/

private theorem sites_perm20 : ∀ ps : List (Wire × Wire), (PortalAnd.sites ps).Perm (ps.map Prod.fst ++ ps.map Prod.snd)
  | [] => by simp [PortalAnd.sites]
  | p :: ps => by
    have ih := sites_perm20 ps
    change (p.1 :: p.2 :: PortalAnd.sites ps).Perm (p.1 :: (ps.map Prod.fst ++ p.2 :: ps.map Prod.snd))
    exact List.Perm.cons _ ((List.Perm.cons _ ih).trans List.perm_middle.symm)

theorem small20_geometry : ∀ j : Fin 9,
    Companion.Geometry (smallA20 j) (smallM20 j) (smallC20 j) 1556 1558 := by
  intro j; constructor <;> revert j <;> decide +kernel

theorem pending20_layout (j : Fin 9) :
    (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs20 j)).Nodup := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hperm : (1557 :: (1558 : Wire) :: PortalAnd.sites (pendingPairs20 j)).Perm
      (1557 :: (1558 : Wire) :: ((pendingPairs20 j).map Prod.fst ++ (pendingPairs20 j).map Prod.snd)) :=
    List.Perm.cons _ (List.Perm.cons _ (sites_perm20 _))
  rw [hperm.nodup_iff]
  have hfst_nd : ((pendingPairs20 j).map Prod.fst).Nodup := by
    rw [pending20_fst, List.nodup_cons]
    refine ⟨?_, List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range⟩
    · intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := lowsP20 (start20 j) + i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩ <;>
        (rw [eb] at e; unfold Wire at *; omega)
    · rw [List.mem_range] at ha hb
      have := bank20_inj j (by omega) (by omega) e; omega
  have hsnd_nd : ((pendingPairs20 j).map Prod.snd).Nodup := by
    simp only [pendingPairs20, List.map_map, Function.comp]
    refine List.Nodup.map_on (fun a ha b hb e => ?_) List.nodup_range
    simp only [Function.comp_apply] at e
    dsimp only [storeWire20] at e
    split_ifs at e <;> ((try unfold Wire at *); omega)
  have hfst_range : ∀ q ∈ (pendingPairs20 j).map Prod.fst,
      (q : Nat) ≤ 1043 ∨ (1603 ≤ (q : Nat) ∧ (q : Nat) ≤ 1622) := by
    intro q hq; rw [pending20_fst, List.mem_cons] at hq
    rcases hq with rfl | hm
    · left; unfold Wire; omega
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi
      rcases bank20_cases j (i := lowsP20 (start20 j) + i) (by omega) with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
      · omega
      · left; unfold Wire at *; omega
      · right; rw [eb]; unfold Wire at *; omega
  have hsnd_range : ∀ q ∈ (pendingPairs20 j).map Prod.snd,
      (1559 ≤ (q : Nat) ∧ (q : Nat) ≤ 1602) ∨ 1623 ≤ (q : Nat) := by
    intro q hq
    simp only [pendingPairs20, List.map_map, Function.comp, List.mem_map, List.mem_range] at hq
    obtain ⟨k, hk, rfl⟩ := hq
    dsimp only [storeWire20]
    split_ifs <;> ((try unfold Wire at *); omega)
  have hdisj : ∀ a ∈ (pendingPairs20 j).map Prod.fst, ∀ b ∈ (pendingPairs20 j).map Prod.snd, a ≠ b := by
    intro a ha b hb eq; subst eq
    rcases hfst_range a ha with x | x <;> rcases hsnd_range a hb with y | y <;> unfold Wire at * <;> omega
  rw [List.nodup_cons, List.nodup_cons]
  refine ⟨?_, ?_, List.nodup_append.mpr ⟨hfst_nd, hsnd_nd, hdisj⟩⟩
  · intro hm; simp only [List.mem_cons, List.mem_append] at hm
    rcases hm with h | h | h
    · exact (by decide : (1557 : Wire) ≠ 1558) h
    · rcases hfst_range 1557 h with a | a <;> unfold Wire at * <;> omega
    · rcases hsnd_range 1557 h with a | a <;> unfold Wire at * <;> omega
  · intro hm; simp only [List.mem_append] at hm
    rcases hm with h | h
    · rcases hfst_range 1558 h with a | a <;> unfold Wire at * <;> omega
    · rcases hsnd_range 1558 h with a | a <;> unfold Wire at * <;> omega

