      constructor <;> intro P hP <;> simp only [block20F, block20R, h0, ↓reduceDIte, List.mem_cons, List.not_mem_nil, or_false] at hP
      · rcases hP with rfl | rfl | rfl | rfl | rfl | rfl | rfl
