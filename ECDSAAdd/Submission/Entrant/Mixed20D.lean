  GateMirror.forward (fix8P20 (start20 j) ++ glueG3_20 (start20 j) ++ leaveJoinMove20 (start20 j) ++ fix10P20 (start20 j) ++
    leaveFix11_20 (start20 j) ++ leaveFix12_20 (start20 j) ++ lowSign20 (start20 j))

