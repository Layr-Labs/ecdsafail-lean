  have untouched := retain_watch345 d row p a clean arr.2.1 arr.2.2
  dsimp only [withArchive345, fromArchive345]
  simp only [run_append, run_take]
  refine ⟨⟨arr.1.trans old.1, fun q h => (untouched _ h).trans (stay _ h), ?_⟩, arr.2.1⟩
  intro n
  rw [run_append, run_take]
  change run (packRev345 d) _ (run (archiveRestoreP20 k8 d) _ a) = s
  rw [ArchiveJ20.roundtrip k8 d row limit p tape _ raw]
  exact old.2 _

