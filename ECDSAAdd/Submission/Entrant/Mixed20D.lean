def longPairs20 (j : Fin 9) : List (Wire × Wire) := (List.range 21).map fun i => (b0P20 (start20 j) + i, 1557 + i)
def longPairs21 (j : Fin 9) : List (Wire × Wire) := (List.range 20).map fun i => (b0P20 (start20 j) + i, 1557 + i)
