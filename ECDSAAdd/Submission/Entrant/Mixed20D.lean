attribute [local irreducible] run SkywalkNat.step barrel20 leaveBefore20 leaveAfter20 beforeRow20 afterRow20
  fix0P20 leaveFix1_20 fix2P20 leaveFix3_20 leaveFix4_20 leaveFix5Pre20 leaveFix5Post20 leaveFix5Move20 leaveAdjust20
  firstRows20 headEnd20 headA1_20 headC0_20 headC1_20 tailD0_20 tailD1_20 lowRest20_pub storeHead20 tailE0_20 chainMid20 tailE1_20 pairGM in
theorem leaveP20Red_pair (j : Fin 9) (s : State) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0) :
    (∀ m, run (leaveP20Red j) m s = run (leaveP20 j) m s) ∧
    (∀ m n, run (leaveInvP20Red j) n (run (leaveP20Red j) m s) = s) := by
  let sc := start20 j; let b := sbP20 sc; let top := a0P20 sc + lowsP20 sc - 2
  have hg := geom20_facts j; dsimp only at hg
  have hsc_eq : sc = start20 j := rfl
  have hb_eq : b = sbP20 (start20 j) := rfl
  have ha0 : a0P20 sc = sc + b + 37 := rfl
  have hb0 : b0P20 sc = 787 + b := rfl
  have he0 : e0P20 sc = 1579 + b := rfl
  have htags0 : tagsP20.getD 0 0 = 1581 := rfl
  have hL : lowsP20 sc ≤ 21 := by
    have : ∀ k : Fin 9, lowsP20 (start20 k) ≤ 21 := by decide
    exact this j
  -- 1. Valid for leaveBefore20 and leaveAfter20
  obtain ⟨hbf_ready, _, hbf_prep⟩ := leaveBefore20_valid j s z g0 s0 h
  have vBef : Valid s (leaveBefore20 sc) := ⟨(leaveBefore20_ok j).1, hbf_prep, hbf_ready⟩
  let uB := run (GateMirror.forward (leaveBefore20 sc)) [] s
  have hbar := barrel20_mid_rt j s [] z g0 s0 h
  simp only [List.drop_nil] at hbar
  have hbar_def (t : List Bool) : run (barrel20 sc false) t uB = run (barrel20 sc false) [] uB :=
    state_eq_of_phase_basis ((hbar t).2.trans (hbar []).2.symm) (run_basis_any20 _ t [] uB uB rfl)
  let uA := run (barrel20 sc false) [] uB
  obtain ⟨haf_prep, haf_ready⟩ := leaveAfter20_valid j s [] z g0 s0 h
  simp only [List.drop_nil] at haf_prep haf_ready
  have vAft : Valid uA (leaveAfter20 sc) := ⟨(leaveAfter20_ok j).1, haf_prep, haf_ready⟩
  -- 2. Scan facts from inputScan20_result + inputTight22 + inputRow20
  let u := flags20 z g0 s0
  have hflag := recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side
  have hscan := inputScan20_result j s [] _ _ u.1 u.2 h.ready h.fresh
  have htight := inputTight21 b z h.small.1
  have hrow20 := inputRow19 b z h.small.1
  have htb := red20_targets_before j; dsimp only at htb
  have hta := red20_targets_after j; dsimp only at hta
  -- Row 21 companion = sign (for ScanRow21)
  have h21_zero : (run (GateMirror.forward (fix0P20 sc b)) [] s).basis (b + 806) = false := by
    have hbit := (hscan.2.2.1 20 (by decide)).2
    rw [show b0P20 sc - 1 + 20 = b + 806 by unfold b0P20; omega] at hbit
    rw [hbit]; apply Nat.testBit_lt_two_pow
    exact (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos b)).mpr (lt_of_le_of_lt (Nat.sub_le _ _) hrow20.1)
  have hcomp21 :
      (run (GateMirror.forward (cell21_20 sc b)) [] (run (GateMirror.forward (firstRows20 sc b)) [] s)).basis (b + 806) =
        (run (GateMirror.forward (firstRows20 sc b)) [] s).basis (b + 1584) := by
    rw [fix0P20_scanSplit, run_nil_append, run_nil_append, run_nil_append] at h21_zero
    have hlt := lastTwo20_zero b _ h21_zero
    have ks1 := keeps_of_targets (suffix21_20 sc b) (b + 806)
      (fun g hg' => (of_decide_eq_true (List.all_eq_true.mp htb.1 g hg')).1) []
    have ks2 := keeps_of_targets (suffix21_20 sc b) (b + 1584)
      (fun g hg' => (of_decide_eq_true (List.all_eq_true.mp htb.1 g hg')).2) []
    have kc := keeps_of_targets (cell21_20 sc b) (b + 1584)
      (fun g hg' => of_decide_eq_true (List.all_eq_true.mp htb.2.1 g hg')) []
    exact (ks1 _).symm.trans (hlt.trans ((ks2 _).trans (kc _)))
  have oldPlaced21 : renameProgram (scanPort20 sc b) (GateMirror.forward ScanRow16.oldRow) = GateMirror.forward (cell21_20 sc b) := by
    unfold cell21_20; rfl
  have newPlaced21 : renameProgram (scanPort20 sc b) (GateMirror.forward ScanRow16.newRow) = GateMirror.forward (shortCell20 sc b) := by
    unfold shortCell20; rfl
  have invPlaced21 : renameProgram (scanPort20 sc b) (GateMirror.inverse ScanRow16.newRow) = inverse (shortCell20 sc b) := by
    unfold shortCell20; rfl
  have hphys21 : (run (renameProgram (scanPort20 sc b) (GateMirror.forward ScanRow16.oldRow)) [] (run (GateMirror.forward (firstRows20 sc b)) [] s)).basis (scanPort20 sc b 2) =
      (run (GateMirror.forward (firstRows20 sc b)) [] s).basis (scanPort20 sc b 3) := by
    rw [oldPlaced21]; exact hcomp21
  obtain ⟨hscan21_f, hscan21_r⟩ := ScanRow16.placed_pair (scanPort20 sc b)
    (fun a ha b' hb' e => congrArg Fin.val (scanPort20_inj j ⟨a, Finset.mem_range.mp ha⟩ ⟨b', Finset.mem_range.mp hb'⟩ e))
    (run (GateMirror.forward (firstRows20 sc b)) [] s) hphys21
  rw [oldPlaced21, newPlaced21] at hscan21_f
  rw [oldPlaced21, invPlaced21] at hscan21_r
  -- Row 22 zero after fix0P20 (for beforeC4_20 & afterPartC2_20)
  have h22_zero : (run (GateMirror.forward (fix0P20 sc b)) [] s).basis (sc + b + 57) = false := by
    have hbit := (hscan.2.2.1 21 (by decide)).1
    rw [show a0P20 sc - 1 + 21 = sc + b + 57 by unfold a0P20; omega] at hbit
    rw [hbit]; exact Nat.testBit_eq_false_of_lt htight
  have hv22 :
      let u1 := run (GateMirror.forward (firstRows20 sc b ++ (cell21_20 sc b ++ headEnd20 sc b))) [] s
      u1.basis (sc + b + 57) = (u1.basis (sc + 35) && u1.basis (b + 807)) := by
    have h0 := h22_zero
    rw [fix0P20_split5, show firstRows20 sc b ++ (cell21_20 sc b ++ (headEnd20 sc b ++
        ([.ccx (sc + 35) (b + 807) (sc + b + 57)] ++ (fix0P20 sc b).drop 67))) =
      (firstRows20 sc b ++ (cell21_20 sc b ++ headEnd20 sc b)) ++
        ([.ccx (sc + 35) (b + 807) (sc + b + 57)] ++ (fix0P20 sc b).drop 67) by simp [List.append_assoc],
      run_nil_append, run_nil_append] at h0
    rw [keeps_of_targets _ _ (fun g hg' => of_decide_eq_true (List.all_eq_true.mp htb.2.2.1 g hg'))] at h0
    change (run [.CCX (sc + 35) (b + 807) (sc + b + 57)] [] _).basis _ = false at h0
    exact ccx_basis_false _ _ _ _ h0
  -- Flag implication (side -> far) for beforeC_20 & make_flag
  have imp0 : s.basis (b + 1583) = true → s.basis (b + 1582) = true := by
    rw [show b + 1583 = e0P20 sc + 4 by unfold e0P20; omega,
        show b + 1582 = e0P20 sc + 3 by unfold e0P20; omega, h.side, h.far]
    intro hs'; exact ((Bool.and_eq_true _ _).mp hs').1
  have hpreFlag_eq := red20_preFlag_eq sc
  have imp1 : (run (GateMirror.forward (entryLeave20 sc)) [] s).basis (b + 1583) = true →
      (run (GateMirror.forward (entryLeave20 sc)) [] s).basis (b + 1582) = true := by
    rw [keeps_of_targets _ _ (fun g hg' => (of_decide_eq_true (List.all_eq_true.mp htb.2.2.2.1 g hg')).2),
        keeps_of_targets _ _ (fun g hg' => (of_decide_eq_true (List.all_eq_true.mp htb.2.2.2.1 g hg')).1)]
    exact imp0
  -- Row 0 partner e0P20+6 is 0 before moveRows20 (for beforeC5_20)
  have hpreRow0_eq := red20_preRow0_eq sc
  have hyR : (run (GateMirror.forward (entryLeave20 sc ++ leaveFix3_20 b ++ leaveFix4_20 sc ++ leaveFix5Pre20 sc)) [] s).basis (e0P20 sc + 6) = false :=
    (keeps_of_targets _ _ (fun g hg' => of_decide_eq_true (List.all_eq_true.mp htb.2.2.2.2 g hg')) [] s).trans
      (h.zero _ (by simp [watched20]))
  -- 3. Apply FlagCut4.replace4 to leaveBefore20 -> beforeRow20!
  have vBef4 : Valid s (firstRows20 sc b ++ (cell21_20 sc b ++ (headEnd20 sc b ++
      ([.ccx (sc + 35) (b + 807) (sc + b + 57)] ++ (headA1_20 sc ++
        ([.make (b + 1582) (b + 1583) 1559] ++ (headC0_20 sc ++
          ([.cx (a0P20 sc - 1 + 0) (e0P20 sc + 6), .ccx (tagsP20.getD 0 0) (e0P20 sc + 6) (a0P20 sc - 1 + 0),
            .cx (a0P20 sc - 1 + 0) (e0P20 sc + 6)] ++ headC1_20 sc)))))))) :=
    leaveBefore20_split4 sc ▸ vBef
  have hbef_rep := replace4
    (firstRows20 sc b) (cell21_20 sc b) (headEnd20 sc b) [.ccx (sc + 35) (b + 807) (sc + b + 57)]
    (headA1_20 sc) [.make (b + 1582) (b + 1583) 1559] (headC0_20 sc)
    [.cx (a0P20 sc - 1 + 0) (e0P20 sc + 6), .ccx (tagsP20.getD 0 0) (e0P20 sc + 6) (a0P20 sc - 1 + 0),
