private theorem red20_1558_make (j : Fin 9) (t : State) :
    (run (GateMirror.forward (tailE0_20 (start20 j))) [] t).basis 1558 = true := by
  have hta := red20_targets_after j; dsimp only at hta
  have he : storeHead20 (start20 j) = [.x 1558] ++ (storeHead20 (start20 j)).drop 1 := rfl
  rw [tailE0_20, run_nil_append, he, run_nil_append,
      keeps_of_targets _ _ (fun g hg' => of_decide_eq_true (List.all_eq_true.mp hta.2.2 g hg'))]
  have hz := lowRest20_1558 (start20 j) t
  generalize run (GateMirror.forward (lowRest20_pub (start20 j))) [] t = w at hz ⊢
  obtain ⟨ph, f⟩ := w; simp only at hz
  simp [GateMirror.forward, front, run, writeBit, Function.update_apply, hz]

