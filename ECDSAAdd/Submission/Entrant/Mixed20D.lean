        ([.ccx (sc + 35) (sbP20 sc + 807) (sc + sbP20 sc + 57)] ++ headA1_20 sc)))) ++
      ([.make (sbP20 sc + 1582) (sbP20 sc + 1583) 1559] ++ headC0_20 sc) by simp [List.append_assoc],
    red20_preFlag_eq sc]
