/-! ### Section 1: Wide/Short Words, `highZero20`, and `boundaryRails20` -/

def L20 (j : Fin 9) : SkywalkIntegerLayout :=
  W.compactSkywalkTickLayout base (start20 j + 20)

def shortL20 (j : Fin 9) : SkywalkIntegerLayout :=
  IntegerPacket.ports (shape20 j) 20

theorem width20 (j : Fin 9) : W.compactSkywalkTickPreWidth (start20 j + 20) = railP (start20 j + 20) := by
  have hg := geom20_facts j; dsimp only at hg
  unfold W.compactSkywalkTickPreWidth W.narrowSkywalkRouteWidth railP
  split_ifs <;> omega

theorem wideMapping20 (j : Fin 9) (i : Nat) (hi : i < railP (start20 j + 20)) :
    (L20 j).a.getD i 0 = OB5.sig (start20 j + 19) (start20 j + 36 + i) ∧
    (L20 j).b.getD i 0 = OB5.sig (start20 j + 19) (786 + i) := by
  have hg := geom20_facts j; dsimp only at hg
  have hw := width20 j
  have r : railP (start20 j + 20) ≤ 258 := by unfold railP; split_ifs <;> omega
  have hi' : i < W.compactSkywalkTickPreWidth (start20 j + 20) := by omega
  rw [L20, W.compactSkywalkTick_a base (start20 j + 20) (by omega),
    W.compactSkywalkTick_b base (start20 j + 20) (by omega),
    W.wireBlock_getD base (start20 j + 20) _ i hi', W.wireBlock_getD base 770 _ i hi']
  unfold OB5.sig base
  constructor
  · rw [if_neg (by unfold Wire; omega)]; unfold Wire; omega
  · rw [if_neg (by unfold Wire; omega)]; unfold Wire; omega

theorem shortMapping20 (j : Fin 9) (i : Nat) (hi : i < sbP20 (start20 j)) :
    windowNet20 j ((shortL20 j).a.getD i 0) = start20 j + 36 + i ∧
    windowNet20 j ((shortL20 j).b.getD i 0) = 786 + i := by
  have hg := geom20_facts j; dsimp only at hg
  have hm : i < smallBits20 j + 20 + 1 := by unfold smallBits20; omega
  have ga : (shortL20 j).a.getD i 0 = start20 j + 36 + i := by
    show ((start20 j + 20 + 16) :: (List.range' (start20 j + 20 + 16 + 1) (smallBits20 j + 20) ++
      [start20 j + 20 + 16 + (smallBits20 j + 20 + 1)])).getD i 0 = _
    rcases i with _ | i
    · simp only [List.getD_cons_zero]
    · have hlen : i < (List.range' (start20 j + 20 + 16 + 1) (smallBits20 j + 20)).length := by
        rw [List.length_range']; unfold smallBits20; omega
      rw [List.getD_cons_succ, List.getD_append _ _ _ _ hlen, List.getD_eq_getElem?_getD,
        List.getElem?_range' (by unfold smallBits20; omega), Option.getD_some]
      omega
  have gb : (shortL20 j).b.getD i 0 = 786 + i := by
    show (786 :: (List.range' 787 (smallBits20 j + 20) ++ [786 + (smallBits20 j + 20 + 1)])).getD i 0 = _
    rcases i with _ | i
    · simp only [List.getD_cons_zero]
    · have hlen : i < (List.range' 787 (smallBits20 j + 20)).length := by
        rw [List.length_range']; unfold smallBits20; omega
      rw [List.getD_cons_succ, List.getD_append _ _ _ _ hlen, List.getD_eq_getElem?_getD,
        List.getElem?_range' (by unfold smallBits20; omega), Option.getD_some]
      omega
  rw [ga, gb]
  unfold windowNet20 OB5.sig
  constructor
  · rw [if_neg (by unfold Wire; omega)]
  · rw [if_neg (by unfold Wire; omega)]

theorem wide20 (j : Fin 9) (a : SkywalkNat.State) (G sg : Bool) (raw : State)
    (input : SkywalkIntegerInput (L20 j) (SkywalkRails.encode G sg a.u a.v).a (SkywalkRails.encode G sg a.u a.v).b G raw.basis)
    (i : Fin (railP (start20 j + 20))) :
    let o := pullState (OB5.sig (start20 j + 19)) raw
    let e := PortalValues.negative sg a.u
    let pos := (a.u + a.v).testBit i.val
    let neg := (a.u - e.toNat).testBit i.val ^^ e
    o.basis (start20 j + 36 + i.val) = (if G then neg else pos) ∧ o.basis (786 + i.val) = (if G then pos else neg) := by
  have hg := geom20_facts j; dsimp only at hg
  have hw := width20 j
  have maxA : railP (start20 j + 20) ≤ (L20 j).a.length := by
    rw [L20, W.compactSkywalkTick_a base (start20 j + 20) (by omega), wireBlock_length]; omega
  have maxB : railP (start20 j + 20) ≤ (L20 j).b.length := by
    rw [L20, W.compactSkywalkTick_b base (start20 j + 20) (by omega), wireBlock_length]; omega
  have h := LeaveSignedCoordinates.pair (L20 j) G sg a.u a.v i.val raw.basis input.1 input.2.1 input.2.2.1
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  rw [(wideMapping20 j i.val i.isLt).1, (wideMapping20 j i.val i.isLt).2] at h
  exact h

theorem short20 (j : Fin 9) (a : SkywalkNat.State) (G sg : Bool) (s : State)
    (ready : onRails20 j 20 (SkywalkRails.encode G sg a.u a.v) s.basis) (i : Fin (sbP20 (start20 j))) :
    let e := PortalValues.negative sg a.u
    let pos := (a.u + a.v).testBit i.val
    let neg := (a.u - e.toNat).testBit i.val ^^ e
    s.basis (start20 j + 36 + i.val) = (if G then neg else pos) ∧ s.basis (786 + i.val) = (if G then pos else neg) := by
  have hg := geom20_facts j; dsimp only at hg
  have maxA : sbP20 (start20 j) ≤ (shortL20 j).a.length := by
    show sbP20 (start20 j) ≤ ((start20 j + 20 + 16) :: (List.range' (start20 j + 20 + 16 + 1) (smallBits20 j + 20) ++
      [start20 j + 20 + 16 + (smallBits20 j + 20 + 1)])).length
    simp only [List.length_cons, List.length_append, List.length_range', List.length_singleton]
    unfold smallBits20; omega
  have maxB : sbP20 (start20 j) ≤ (shortL20 j).b.length := by
    show sbP20 (start20 j) ≤ (786 :: (List.range' 787 (smallBits20 j + 20) ++ [786 + (smallBits20 j + 20 + 1)])).length
    simp only [List.length_cons, List.length_append, List.length_range', List.length_singleton]
    unfold smallBits20; omega
  have prev : mappedBasis20 j s.basis (shortL20 j).previous = G := by cases G <;> exact ready.2.2.1
  have h := LeaveSignedCoordinates.pair (shortL20 j) G sg a.u a.v i.val (mappedBasis20 j s.basis) ready.1 ready.2.1 prev
    (Nat.lt_of_lt_of_le i.isLt maxA) (Nat.lt_of_lt_of_le i.isLt maxB)
  unfold mappedBasis20 at h; dsimp only at h
  rw [(shortMapping20 j i.val i.isLt).1, (shortMapping20 j i.val i.isLt).2] at h
  exact h

/-- `LeaveSignedCoordinates.sharedDigit` for a congruence mod `2^b` (margin 21: `retainedLow21_shadow7`). -/
private theorem sharedDigitLow20 (x y b i : Nat) (modEq : x % 2 ^ b = y % 2 ^ b) (hi : i < b) :
    x.testBit i = y.testBit i := by
  have h := congrArg (Nat.testBit · i) modEq
  simpa only [Nat.testBit_mod_two_pow, decide_eq_true_eq.mpr hi, Bool.true_and] using h

attribute [local irreducible] run SkywalkNat.step barrel20 core20Prog fullProg20 beforeStore20 storeMapped20 leaveP20 in
theorem highZero20 (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0)
    (top : ∀ q : Nat, a0P20 (start20 j) + 21 ≤ q → q ≤ start20 j + 35 + railP (start20 j + 20) → s.basis q = false) :
    ∀ i : Fin (nextWp20 (start20 j) - 2),
      (run (leaveP20 j) m s).basis (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) = false := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  let u := flags20 z g0 s0
  let xs := SkywalkTrace.trace 20 (SkywalkRails.encode g0 s0 z.u z.v)
  have par := recordedParity20 j s z g0 s0 h.small h.odd h.record
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have w := whole20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
    xs (SkywalkTrace.trace_length _ _) (certifiedChain20 _ _ _ _ h.small h.odd)
    (firstSwap20 _ _ _ _ h.small h.odd) ev.1 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hcrt : ∀ k < 10, s.basis (poolW20 (start20 j) (22 + k)) = false := fun k hk => by
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp]; exact h.cPool _ (by omega) (by omega)
  have hc := core20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.ready
    h.fresh h.scratch h.temp h.clean (h.cPool 1623 (by decide) (by omega)) (h.cPool 1624 (by decide) (by omega)) hcrt
    h.padding h.bank h.zero par h.far h.side ev.2 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hbs := beforeStore20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hprev : s.basis (start20 j + 35) = u.1 := by
    have hr := h.ready.2.2.1
    have hp : start20 j + 35 = windowNet20 j (IntegerPacket.ports (shape20 j) 20).previous := by
      have : ∀ k : Fin 9, start20 k + 35 = windowNet20 k (IntegerPacket.ports (shape20 k) 20).previous := by
        decide +kernel
      exact this j
    rw [hp]; change mappedBasis20 j s.basis _ = _ at hr
    cases hu : (flags20 z g0 s0).1 <;> simpa only [u, hu, mappedBasis20, SkywalkRails.encode] using hr
  have hlc := lowClose20_result j s (run (beforeStore20 j) m s)
    (m.drop (measurementCount (beforeStore20 j))) u.1 (PortalValues.negative u.2 (step^[20] z).u)
    ((step^[20] z).u + (step^[20] z).v) ((step^[20] z).u - (PortalValues.negative u.2 (step^[20] z).u).toNat)
    hprev hbs.2.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.2.2.1
  intro i
  have hi := i.isLt
  by_cases h22 : lowsP20 (start20 j) + i.val < 22
  · have hwb := w.2.2.2.2.2.2.2.2.2.2 (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val)
    rw [(reloc20_upper j i).2, writeBit, Function.update_of_ne (by unfold Wire; omega)] at hwb
    rw [hwb, show run (storeMapped20 j) m s =
        run (GateMirror.forward (leaveLowClose20 (start20 j))) (m.drop (measurementCount (beforeStore20 j)))
          (run (beforeStore20 j) m s) by simp only [storeMapped20, run_append, run_take]]
    have hnotLow : (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val : Wire) ∉ RailPair.sites (low20 j) := by
      intro hm; obtain ⟨p, hp, hq⟩ := List.mem_flatMap.mp hm
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with e | e <;> (unfold Wire at *; omega)
    have hnotHist : (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val : Wire) ∉ history20 j := by
      intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
    have hnotSM : (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val : Wire) ∉ smallM20 j := by
      intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
    rw [hlc.2.2.2 _ hnotLow hnotHist,
      hbs.2.2.2.2.2.2.2.2.2.1 _ (by unfold Wire; omega) (by unfold Wire; omega) (by unfold Wire; omega),
      hbs.2.2.2.2.2.2.2.2.2.2 _ (by unfold Wire at *; omega) (by unfold Wire at *; omega) hnotSM]
    have hfr : ((columnsP20 (start20 j))[lowsP20 (start20 j) + i.val]'(by simp [columnsP20]; exact h22)).free =
        a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val := by
      simp only [columnsP20, List.getElem_map, List.getElem_range, HighBankJoin.Column.free, decide_eq_true_eq]
      rw [if_neg (by omega)]; unfold Wire; omega
    have hcf := hc.2.2.1 ⟨lowsP20 (start20 j) + i.val, h22⟩
    dsimp only at hcf
    rw [hfr] at hcf; exact hcf
  · have hout : ¬ leaveBox20 (start20 j) (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) := by
      unfold leaveBox20; unfold Wire; omega
    rw [leave20_keeps j _ hout m s]
    exact top _ (by omega) (by omega)

attribute [local irreducible] run SkywalkNat.step leaveP20 in
theorem boundaryRails20 (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0)
    (top : ∀ q : Nat, a0P20 (start20 j) + 21 ≤ q → q ≤ start20 j + 35 + railP (start20 j + 20) → s.basis q = false)
    (raw : State)
    (input : let a := step^[20] z; let u := flags20 z g0 s0
      SkywalkIntegerInput (L20 j) (SkywalkRails.encode u.1 u.2 a.u a.v).a
        (SkywalkRails.encode u.1 u.2 a.u a.v).b u.1 raw.basis) :
    let o := pullState (OB5.sig (start20 j + 19)) raw
    let out := run (leaveP20 j) m s
    (∀ i : Fin (sbP20 (start20 j) + lowsP20 (start20 j)),
      out.basis (start20 j + 36 + i.val) = o.basis (start20 j + 36 + i.val) ∧
      out.basis (786 + i.val) = o.basis (786 + i.val)) ∧
    ∀ i : Fin (nextWp20 (start20 j) - 2),
      out.basis (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) = false ∧
      out.basis (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val) =
        (if o.basis (start20 j + 35) then o.basis (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val)
         else o.basis (a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val)) := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  let a := step^[20] z
  let r20 := step^[20] (TrueMiddle20.r j z)
  let u := flags20 z g0 s0
  let xs := SkywalkTrace.trace 20 (SkywalkRails.encode g0 s0 z.u z.v)
  let o := pullState (OB5.sig (start20 j + 19)) raw
  have par := recordedParity20 j s z g0 s0 h.small h.odd h.record
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have w := whole20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
    xs (SkywalkTrace.trace_length _ _) (certifiedChain20 _ _ _ _ h.small h.odd)
    (firstSwap20 _ _ _ _ h.small h.odd) ev.1 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hz := highZero20 j s m z g0 s0 h top
  have orient : o.basis (start20 j + 35) = u.1 := by
    have geo : (L20 j).previous = OB5.sig (start20 j + 19) (start20 j + 35) := by
      show base (skywalkPoolPreviousId (start20 j + 20)) = _
      unfold skywalkPoolPreviousId base OB5.sig
      rw [if_neg (by omega), if_neg (by unfold Wire; omega)]; unfold Wire; omega
    change raw.basis (OB5.sig (start20 j + 19) (start20 j + 35)) = u.1
    rw [← geo]; exact input.2.2.1
  have law := retainedLow21_shadow7 (sbP20 (start20 j)) z h.small.1 u.2
  dsimp only
  constructor
  · intro i
    have fit : i.val < railP (start20 j + 20) := by have := i.isLt; omega
    have ref := wide20 j a u.1 u.2 raw input ⟨i.val, fit⟩
    by_cases low : i.val < sbP20 (start20 j)
    · have hw := short20 j r20 u.1 u.2 s h.ready ⟨i.val, low⟩
      have u1 : (run (leaveP20 j) m s).basis (start20 j + 36 + i.val) = s.basis (start20 j + 36 + i.val) :=
        leave20_keeps j _ (by unfold leaveBox20; unfold Wire; omega) m s
      have u2 : (run (leaveP20 j) m s).basis (786 + i.val) = s.basis (786 + i.val) :=
        leave20_keeps j _ (by unfold leaveBox20; unfold Wire; omega) m s
      have spos := sharedDigitLow20 _ _ (sbP20 (start20 j)) i.val law.2.1 low
      have smag := sharedDigitLow20 _ _ (sbP20 (start20 j)) i.val law.2.2 low
      dsimp only at ref hw
      rw [law.1, spos, smag] at ref
      exact ⟨u1.trans (hw.1.trans ref.1.symm), u2.trans (hw.2.trans ref.2.symm)⟩
    · have hk : i.val - sbP20 (start20 j) < lowsP20 (start20 j) := by have := i.isLt; omega
      have vals := w.2.2.2.2.2.2.2.2.1 ⟨i.val - sbP20 (start20 j), hk⟩
      dsimp only at ref vals
      rw [show sbP20 (start20 j) + (i.val - sbP20 (start20 j)) = i.val by omega,
        show a0P20 (start20 j) - 1 + (i.val - sbP20 (start20 j)) = start20 j + 36 + i.val by omega,
        show b0P20 (start20 j) - 1 + (i.val - sbP20 (start20 j)) = 786 + i.val by omega] at vals
      exact ⟨vals.1.trans ref.1.symm, vals.2.trans ref.2.symm⟩
  · intro i
    have hi := i.isLt
    have ref := wide20 j a u.1 u.2 raw input ⟨sbP20 (start20 j) + lowsP20 (start20 j) + i.val, by omega⟩
    dsimp only at ref
    rw [show start20 j + 36 + (sbP20 (start20 j) + lowsP20 (start20 j) + i.val) =
          a0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val by omega,
      show 786 + (sbP20 (start20 j) + lowsP20 (start20 j) + i.val) =
          b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i.val by omega] at ref
    refine ⟨hz i, ?_⟩
    rw [orient, w.2.2.2.2.2.2.2.2.2.1 i]
    cases hu : u.1 <;> rw [hu] at ref <;>
      simpa only [Bool.false_eq_true, ite_false, ite_true] using (by first | exact ref.1.symm | exact ref.2.symm)

/-! ### Section 2: Symbolic 20-Stride Relocation Inverse & `boundaryClean20` -/

private def bankPair20 (s i : Nat) : Wire × Wire :=
  (bankW20 s (lowsP20 s + i), bTopP (s + 20) + 3 + i - nextWp20 s)

private def flagPairs20 (s : Nat) : List (Wire × Wire) :=
  [(1557, nextE0_20 s + 3), (1558, nextE0_20 s + 4),
   (e0P20 s + 5, nextE0_20 s + 5), (e0P20 s + 3, nextE0_20 s + 6),
   (e0P20 s + 7, nextE0_20 s + 7), (e0P20 s + 6, nextE0_20 s + 8)]

private theorem moves20_split (s : Nat) :
    movesP20 s = (List.range (nextWp20 s - 2)).map (bankPair20 s) ++ flagPairs20 s := rfl

private theorem flip20_fst {a b : Wire} : LeaveRelocation.flip a b a = b := by
  simp [LeaveRelocation.flip]

private theorem flip20_snd {a b : Wire} (h : a ≠ b) : LeaveRelocation.flip a b b = a := by
  simp [LeaveRelocation.flip, Ne.symm h]

private theorem flip20_ne {a b q : Wire} (h1 : q ≠ a) (h2 : q ≠ b) : LeaveRelocation.flip a b q = q := by
  simp [LeaveRelocation.flip, h1, h2]

private theorem src20_succ (f : Nat → Wire × Wire) (i : Nat) (q : Wire) :
    LeaveRelocation.source ((List.range (i + 1)).map f) q =
      LeaveRelocation.source ((List.range i).map f) (LeaveRelocation.flip (f i).1 (f i).2 q) := by
  rw [List.range_succ, List.map_append, List.map_singleton, LeaveRelocation.append]; rfl

private theorem src20_untouched (f : Nat → Wire × Wire) (n : Nat) (q : Wire)
    (h : ∀ k < n, q ≠ (f k).1 ∧ q ≠ (f k).2) :
    LeaveRelocation.source ((List.range n).map f) q = q := by
  apply LeaveRelocation.outside; intro p hp
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk; exact h k hk

private theorem src20_above (f : Nat → Wire × Wire) (i : Nat) (q : Wire) (n : Nat) (hi : i ≤ n)
    (h : ∀ k, i ≤ k → k < n → q ≠ (f k).1 ∧ q ≠ (f k).2) :
    LeaveRelocation.source ((List.range n).map f) q = LeaveRelocation.source ((List.range i).map f) q := by
  have sp : List.range n = List.range i ++ List.range' i (n - i) := by
    rw [List.range_eq_range', List.range_eq_range']
    conv_lhs => rw [show n = i + (n - i) by omega]
    rw [← List.range'_append_1, Nat.zero_add]
  rw [sp, List.map_append, LeaveRelocation.append]
  congr 1; apply LeaveRelocation.outside; intro p hp
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range'_1] at hk; exact h k hk.1 (by omega)

private theorem chain20_geo (j : Fin 9) :
    let s := start20 j
    let D0 := b0P20 s + lowsP20 s - 1
    let n := nextWp20 s - 2
    let m := wpP20 s - lowsP20 s
    (∀ i, (bankPair20 s i).2 = D0 + i) ∧
    (∀ i, i < m → (bankPair20 s i).1 = D0 + 20 + i) ∧
    (∀ i, m ≤ i → (bankPair20 s i).1 = 1603 + i - m) ∧
    m ≤ n ∧ n ≤ m + 20 ∧ 20 ≤ n ∧
    D0 + 19 + m = bTopP s ∧ D0 + n = bTopP (s + 20) + 1 ∧
    bTopP s ≤ 1043 ∧ bTopP (s + 20) ≤ bTopP s ∧
    1623 ≤ nextE0_20 s ∧ nextE0_20 s + 8 < e0P20 s ∧
    e0P20 s ≤ nextE0_20 s + 15 ∧
    lowsP20 s + 3 ≤ wpP20 s ∧ bTopP s + 1 - wpP20 s = b0P20 s + 19 := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  have hnum : ∀ k : Fin 9,
      let s := start20 k
      let D0 := b0P20 s + lowsP20 s - 1
      let n := nextWp20 s - 2
      let m := wpP20 s - lowsP20 s
      m ≤ n ∧ n ≤ m + 20 ∧ 20 ≤ n ∧
      D0 + 19 + m = bTopP s ∧ D0 + n = bTopP (s + 20) + 1 ∧
      bTopP s ≤ 1043 ∧ bTopP (s + 20) ≤ bTopP s ∧
      1623 ≤ nextE0_20 s ∧ nextE0_20 s + 8 < e0P20 s ∧
      e0P20 s ≤ nextE0_20 s + 15 ∧
      lowsP20 s + 3 ≤ wpP20 s ∧ bTopP s + 1 - wpP20 s = b0P20 s + 19 ∧
      nextWp20 s ≤ bTopP (s + 20) + 3 := by decide +kernel
  have hn := hnum j; dsimp only at hn
  refine ⟨fun i => ?_, fun i hi => ?_, fun i hi => ?_,
    hn.1, hn.2.1, hn.2.2.1, hn.2.2.2.1, hn.2.2.2.2.1, hn.2.2.2.2.2.1, hn.2.2.2.2.2.2.1,
    hn.2.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2.2.2.1, hn.2.2.2.2.2.2.2.2.2.2.1,
    hn.2.2.2.2.2.2.2.2.2.2.2.1⟩
  · unfold bankPair20; dsimp only; unfold Wire; omega
  · unfold bankPair20 bankW20; dsimp only
    rw [if_neg (by omega), if_pos (by omega)]; unfold Wire; omega
  · unfold bankPair20 bankW20; dsimp only
    rw [if_neg (by omega), if_neg (by omega)]; unfold Wire; omega

private theorem src20_chain (j : Fin 9) :
    ∀ i, i < nextWp20 (start20 j) - 2 →
      LeaveRelocation.source ((List.range i).map (bankPair20 (start20 j))) (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i) =
        b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i % 20 := by
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have ab (k : Nat) :
      ((bankPair20 (start20 j) k).1 = b0P20 (start20 j) + lowsP20 (start20 j) - 1 + 20 + k ∧ k < wpP20 (start20 j) - lowsP20 (start20 j)) ∨
      ((bankPair20 (start20 j) k).1 = 1603 + k - (wpP20 (start20 j) - lowsP20 (start20 j)) ∧ wpP20 (start20 j) - lowsP20 (start20 j) ≤ k) := by
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · exact Or.inl ⟨hB k b, b⟩
    · exact Or.inr ⟨hP k (by omega), by omega⟩
  intro i
  induction i using Nat.strong_induction_on with
  | _ i ih =>
    intro hi
    by_cases small : i < 20
    · rw [src20_untouched (bankPair20 (start20 j)) i _ (by
        intro k hk; rw [hd k]
        rcases ab k with ⟨e, ek⟩ | ⟨e, ek⟩ <;> rw [e] <;> constructor <;> (unfold Wire; omega))]
      rw [Nat.mod_eq_of_lt small]
    · have kB : i - 20 < wpP20 (start20 j) - lowsP20 (start20 j) := by omega
      rw [src20_above (bankPair20 (start20 j)) (i - 20 + 1) _ i (by omega) (by
        intro k a b; rw [hd k]
        rcases ab k with ⟨e, ek⟩ | ⟨e, ek⟩ <;> rw [e] <;> constructor <;> (unfold Wire; omega))]
      rw [src20_succ, show (b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i : Wire) = (bankPair20 (start20 j) (i - 20)).1 by
        rw [hB _ kB]; unfold Wire; omega, flip20_fst, hd (i - 20), ih (i - 20) (by omega) (by omega)]
      congr 1; omega

private theorem src20_top (j : Fin 9) (i : Nat) (hi : i < nextWp20 (start20 j) - 2)
    (top : lowsP20 (start20 j) + i < wpP20 (start20 j) → nextWp20 (start20 j) - 2 ≤ i + 20) :
    LeaveRelocation.source (movesP20 (start20 j)) (bankW20 (start20 j) (lowsP20 (start20 j) + i)) =
      b0P20 (start20 j) + lowsP20 (start20 j) - 1 + i % 20 := by
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have ab (k : Nat) :
      ((bankPair20 (start20 j) k).1 = b0P20 (start20 j) + lowsP20 (start20 j) - 1 + 20 + k ∧ k < wpP20 (start20 j) - lowsP20 (start20 j)) ∨
      ((bankPair20 (start20 j) k).1 = 1603 + k - (wpP20 (start20 j) - lowsP20 (start20 j)) ∧ wpP20 (start20 j) - lowsP20 (start20 j) ≤ k) := by
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · exact Or.inl ⟨hB k b, b⟩
    · exact Or.inr ⟨hP k (by omega), by omega⟩
  have top' : nextWp20 (start20 j) - 2 ≤ i + 20 ∨ wpP20 (start20 j) - lowsP20 (start20 j) ≤ i := by
    by_cases b : lowsP20 (start20 j) + i < wpP20 (start20 j)
    · exact Or.inl (top b)
    · exact Or.inr (by omega)
  have ai : bankW20 (start20 j) (lowsP20 (start20 j) + i) = (bankPair20 (start20 j) i).1 := rfl
  rw [moves20_split, LeaveRelocation.append, ai]
  rw [LeaveRelocation.outside (flagPairs20 (start20 j)) (bankPair20 (start20 j) i).1 (by
    intro p hp; simp only [flagPairs20, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases ab i with ⟨e, ei⟩ | ⟨e, ei⟩ <;> rw [e] <;>
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩)]
  rw [src20_above (bankPair20 (start20 j)) (i + 1) _ (nextWp20 (start20 j) - 2) (by omega) (by
    intro k a b; rw [hd k]
    rcases ab k with ⟨e, ek⟩ | ⟨e, ek⟩ <;> rcases ab i with ⟨e', ei⟩ | ⟨e', ei⟩ <;> rw [e, e'] <;>
      exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩)]
  rw [src20_succ, flip20_fst, hd i]
  exact src20_chain j i hi

private theorem src20_flags_back (j : Fin 9) :
    let s := start20 j
    LeaveRelocation.source (movesP20 s) 1557 = nextE0_20 s + 3 ∧
    LeaveRelocation.source (movesP20 s) 1558 = nextE0_20 s + 4 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 5) = nextE0_20 s + 5 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 3) = nextE0_20 s + 6 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 7) = nextE0_20 s + 7 ∧
    LeaveRelocation.source (movesP20 s) (e0P20 s + 6) = nextE0_20 s + 8 := by
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have bankOut (x : Wire) (hx : nextE0_20 (start20 j) ≤ x) :
      LeaveRelocation.source ((List.range (nextWp20 (start20 j) - 2)).map (bankPair20 (start20 j))) x = x := by
    apply src20_untouched; intro k hk; rw [hd k]
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · rw [hB k b]; exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩
    · rw [hP k (by omega)]; exact ⟨by unfold Wire; omega, by unfold Wire; omega⟩
  have fl : ∀ x, LeaveRelocation.source (flagPairs20 (start20 j)) x =
      LeaveRelocation.flip 1557 (nextE0_20 (start20 j) + 3)
        (LeaveRelocation.flip 1558 (nextE0_20 (start20 j) + 4)
          (LeaveRelocation.flip (e0P20 (start20 j) + 5) (nextE0_20 (start20 j) + 5)
            (LeaveRelocation.flip (e0P20 (start20 j) + 3) (nextE0_20 (start20 j) + 6)
              (LeaveRelocation.flip (e0P20 (start20 j) + 7) (nextE0_20 (start20 j) + 7)
                (LeaveRelocation.flip (e0P20 (start20 j) + 6) (nextE0_20 (start20 j) + 8) x))))) := fun _ => rfl
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · rw [moves20_split, LeaveRelocation.append, fl]
    simp (disch := (unfold Wire; omega)) only [flip20_ne, flip20_fst, flip20_snd]
    exact bankOut _ (by unfold Wire; omega)

private theorem src20_out (j : Fin 9) (q : Wire)
    (bank : q < b0P20 (start20 j) + lowsP20 (start20 j) - 1 ∨ (bTopP (start20 j) < q ∧ q < 1603) ∨
      1603 + (nextWp20 (start20 j) - 2) - (wpP20 (start20 j) - lowsP20 (start20 j)) ≤ q)
    (flags : q ≠ 1557 ∧ q ≠ 1558 ∧ q ≠ e0P20 (start20 j) + 3 ∧ q ≠ e0P20 (start20 j) + 5 ∧
      q ≠ e0P20 (start20 j) + 6 ∧ q ≠ e0P20 (start20 j) + 7 ∧
      (q < nextE0_20 (start20 j) + 3 ∨ nextE0_20 (start20 j) + 8 < q)) :
    LeaveRelocation.source (movesP20 (start20 j)) q = q := by
  have hg := geom20_facts j; dsimp only at hg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  apply LeaveRelocation.outside; intro p hp
  rw [moves20_split, List.mem_append] at hp
  rcases hp with hp | hp
  · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk; rw [hd k]
    by_cases b : k < wpP20 (start20 j) - lowsP20 (start20 j)
    · rw [hB k b]; exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega⟩
    · rw [hP k (by omega)]; exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega⟩
  · simp only [flagPairs20, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega⟩

/-- All scratch and freed B-top wires returned to `false` by `leaveP20 j`. -/
def zeros20 (j : Fin 9) : List Nat :=
  List.range' 1556 (nextE0_20 (start20 j) + 3 - 1556) ++
  List.range' (nextE0_20 (start20 j) + 9) (min 1813 (2050 - start20 j) - (nextE0_20 (start20 j) + 9)) ++
  List.range' (bTopP (start20 j + 20) + 1) (bTopP (start20 j) - bTopP (start20 j + 20))

attribute [local irreducible] run SkywalkNat.step barrel20 core20Prog fullProg20 beforeStore20 storeMapped20 leaveP20 in
theorem boundaryClean20 (j : Fin 9) (s : State) (m : List Bool) (z : SkywalkNat.State) (g0 s0 : Bool)
    (h : Inputs20 j s z g0 s0)
    (quiet : ∀ q : Nat, e0P20 (start20 j) + 8 ≤ q → q < min 1813 (2050 - start20 j) → s.basis q = false) :
    ∀ q ∈ zeros20 j, (run (leaveP20 j) m s).basis q = false := by
  have hg := geom20_facts j; dsimp only at hg
  have tg := tail20_geom j; dsimp only at tg
  obtain ⟨hd, hB, hP, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12⟩ := chain20_geo j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  let u := flags20 z g0 s0
  let xs := SkywalkTrace.trace 20 (SkywalkRails.encode g0 s0 z.u z.v)
  have par := recordedParity20 j s z g0 s0 h.small h.odd h.record
  have ev := recordedEvents20 j s z g0 s0 h.small h.odd h.record
  have w := whole20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2
    xs (SkywalkTrace.trace_length _ _) (certifiedChain20 _ _ _ _ h.small h.odd)
    (firstSwap20 _ _ _ _ h.small h.odd) ev.1 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hcrt : ∀ k < 10, s.basis (poolW20 (start20 j) (22 + k)) = false := fun k hk => by
    have hp : poolW20 (start20 j) (22 + k) = 1625 + k := by unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
    rw [hp]; exact h.cPool _ (by omega) (by omega)
  have hc := core20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.ready
    h.fresh h.scratch h.temp h.clean (h.cPool 1623 (by decide) (by omega)) (h.cPool 1624 (by decide) (by omega)) hcrt
    h.padding h.bank h.zero par h.far h.side ev.2 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hbs := beforeStore20_result j s m z u.1 u.2 h.small h.odd h.room h.fit h.nextFarSmall h.ready
    h.fresh h.scratch h.temp h.clean h.cPool h.padding h.bank h.zero par h.far h.side ev.2 (recordedFlag20 j s z g0 s0 h.small h.odd h.record h.far h.side)
  have hprev : s.basis (start20 j + 35) = u.1 := by
    have hr := h.ready.2.2.1
    have hp : start20 j + 35 = windowNet20 j (IntegerPacket.ports (shape20 j) 20).previous := by
      have : ∀ k : Fin 9, start20 k + 35 = windowNet20 k (IntegerPacket.ports (shape20 k) 20).previous := by
        decide +kernel
      exact this j
    rw [hp]; change mappedBasis20 j s.basis _ = _ at hr
    cases hu : (flags20 z g0 s0).1 <;> simpa only [u, hu, mappedBasis20, SkywalkRails.encode] using hr
  have hlc := lowClose20_result j s (run (beforeStore20 j) m s)
    (m.drop (measurementCount (beforeStore20 j))) u.1 (PortalValues.negative u.2 (step^[20] z).u)
    ((step^[20] z).u + (step^[20] z).v) ((step^[20] z).u - (PortalValues.negative u.2 (step^[20] z).u).toNat)
    hprev hbs.2.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.1 hbs.2.2.2.2.2.2.2.2.1
  let v := run (storeMapped20 j) m s
  have hv_eq : v = run (GateMirror.forward (leaveLowClose20 (start20 j)))
      (m.drop (measurementCount (beforeStore20 j))) (run (beforeStore20 j) m s) := by
    simp only [v, storeMapped20, run_append, run_take]
  have notLow (p : Wire) (hp : (p < a0P20 (start20 j) - 1 ∨ a0P20 (start20 j) + lowsP20 (start20 j) - 1 ≤ p) ∧
      (p < b0P20 (start20 j) - 1 ∨ b0P20 (start20 j) + lowsP20 (start20 j) - 1 ≤ p)) : p ∉ RailPair.sites (low20 j) := by
    intro hm; obtain ⟨pr, hpr, hq'⟩ := List.mem_flatMap.mp hm
    obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hpr; rw [List.mem_range] at hk
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq'
    rcases hq' with e | e <;> (unfold Wire at *; omega)
  have notHist (p : Wire) (hp : p < start20 j + 16 ∨ start20 j + 35 < p) : p ∉ history20 j := by
    intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
  have notSM (p : Wire) (hp : p < b0P20 (start20 j) ∨ b0P20 (start20 j) + lowsP20 (start20 j) - 1 ≤ p) : p ∉ smallM20 j := by
    intro hm; obtain ⟨k, hk, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hk; unfold Wire at *; omega
  have clean_core (p : Nat)
      (hp : (1559 ≤ p ∧ p ≤ 1602) ∨ (1623 ≤ p ∧ p < e0P20 (start20 j) + 3) ∨
        (e0P20 (start20 j) + 8 ≤ p ∧ p < min 1813 (2050 - start20 j)) ∨
