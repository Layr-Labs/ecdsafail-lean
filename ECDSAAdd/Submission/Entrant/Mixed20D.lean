  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have he0 : e0P20 (start20 j) = 1579 + sbP20 (start20 j) := rfl
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hnd : (history20 j).Nodup := List.Nodup.map (fun _ _ e => Nat.add_left_cancel e) List.nodup_range
  have act := RailPair.store_run (start20 j + 35) (e0P20 (start20 j) + 5) (low20 j) [] (low20_geometry j)
    ⟨v.phase, fun q => if q ∈ history20 j then !v.basis q else v.basis q⟩
    (m.drop (measurementCount (notRegister (history20 j)))) (by simp)
  have inHist : (start20 j + 35 : Wire) ∈ history20 j :=
    List.mem_map.mpr ⟨19, List.mem_range.mpr (by decide), rfl⟩
  have notHist (q : Nat) (hq : q < start20 j + 16 ∨ start20 j + 35 < q) : (q : Wire) ∉ history20 j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi; unfold Wire at *; omega
  have sep : ∀ a ∈ history20 j, a ∉ RailPair.sites (low20 j) := by
    intro a ha hm; obtain ⟨i, hi, rfl⟩ := List.mem_map.mp ha; rw [List.mem_range] at hi
    obtain ⟨p, hp, hq⟩ := List.mem_flatMap.mp hm; obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hp; rw [List.mem_range] at hk
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with e | e <;> (unfold Wire at *; omega)
  dsimp only
  rw [lowClose20_parts j, run_append, run_take, notRegister_correct _ hnd]
  refine ⟨act.1, ?_, ?_, fun q lo hn => (act.2.1 q lo (by simp [RailPair.sites])).trans (if_neg hn)⟩
  · intro q hq; rw [act.2.1 q (sep q hq) (by simp [RailPair.sites])]; dsimp only; rw [if_pos hq, hist q hq, Bool.not_not]
  · intro i
    have mem : (a0P20 (start20 j) - 1 + i.val, b0P20 (start20 j) - 1 + i.val) ∈ low20 j :=
      List.mem_map.mpr ⟨i.val, List.mem_range.mpr i.isLt, rfl⟩
