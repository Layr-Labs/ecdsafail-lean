  [.cx (h + 1582) 1560, .cx 1559 1560] ++ leaveFix4_20 s ++ leaveFix5Pre20 s

def headC1_20 (s : Nat) : List Gate :=
  rowGates (e0P20 s + 6) ((moveRows20 s).drop 1) ++ leaveFix5Post20 s ++ leaveAdjust20 s

def beforeRow20 (s : Nat) : List Gate :=
