  have hleg : StairArchiveRaw.legal (physicalCells20 k8 before) := by
    rw [prior.records]; exact legal_signed 20 past g sign (by omega) odd
  have hkeptA : ∀ i, (run (Shadow7.routed j20 0 1) first (run (Shadow7.enterP j20) et before)).basis (histA345 i) =
      before.basis (histA345 i) := fun i =>
    (Shadow7.first_preserves j20 _ parity _ first ready _ (firstFree345 (heads345_ok.2.1 i).1)).trans
      (run_preserves_outside _ _ _ _ (EnterJ7.notWire j20 (heads345_ok.2.1 i).2.1))
  have hkeptB : ∀ i, (run (Shadow7.routed j20 0 1) first (run (Shadow7.enterP j20) et before)).basis (histB345 i) =
      before.basis (histB345 i) := fun i =>
    (Shadow7.first_preserves j20 _ parity _ first ready _ (firstFree345 (heads345_ok.2.1 i).2.2.1)).trans
      (run_preserves_outside _ _ _ _ (EnterJ7.notWire j20 (heads345_ok.2.1 i).2.2.2))
  have okA : MeasuredCodec5.legalAt histA345 (run (Shadow7.routed j20 0 1) first (run (Shadow7.enterP j20) et before)).basis := by
    apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
    rw [hkeptA, hkeptA, (heads345_ok.1 i).1, (heads345_ok.1 i).2.1]
    have good := hleg _ (member_cell (shape20 k8) 20 0 i.val (mappedBasis20 k8 before.basis) (by omega))
    apply not_both; simpa only [Nat.zero_add, cell, mappedBasis20] using good
  have okB : MeasuredCodec5.legalAt histB345 (run (Shadow7.routed j20 0 1) first (run (Shadow7.enterP j20) et before)).basis := by
    apply (MeasuredCodec5.legalAt_iff _ _).mpr; intro i
    rw [hkeptB, hkeptB, (heads345_ok.1 i).2.2.1, (heads345_ok.1 i).2.2.2]
    have good := hleg _ (member_cell (shape20 k8) 20 0 (5 + i.val) (mappedBasis20 k8 before.basis) (by omega))
    apply not_both; simpa only [Nat.zero_add, cell, mappedBasis20] using good
  refine ⟨okA, okB, ?_⟩
  have bk := bank_kept345 d before et first pack nowZ parity ready
  let cells := physicalCells20 k8 before
  let f := decide (Shadow.far (sbP20 325) 20 past)
  let u := f && afterFlags (decide (past.v < past.u)) (cells.take 10)
  let c := f && cross
