def shortCell20 (s h : Nat) : List Gate :=
  let a := s + h + 56
  let b := h + 806
  let z := h + 1584
  [.cx a b, .cx b a, .cx z a, .pop (s + 35) b a, .cx z a, .cx b a, .cx a b]

def headEnd20 (s h : Nat) : List Gate := [.cx (s + h + 57) (h + 807)]

def headA1_20 (s : Nat) : List Gate :=
