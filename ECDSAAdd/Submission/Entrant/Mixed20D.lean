  refine ⟨all.1.trans ready.1, all.2.1, all.2.2.1.trans (true_records_shadow7 (Shadow7.sbP 345) z small odd G S), ?_⟩
  intro n
  rw [all.2.2.2 n]
  have free : ∀ q ∈ EnterJ7.pending j20, q ∉ wires (Shadow7.enterInvP j20) := by
    intro q hq used
