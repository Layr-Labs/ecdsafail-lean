      hbs.2.2.2.2.2.2.2.2.2.2 p (by unfold Wire at *; omega) (by unfold Wire at *; omega) (notSM p (by unfold Wire; omega))]
    rcases hp with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact hc.2.2.2.1 p h1 h2
    · by_cases hlt : p < e0P20 (start20 j)
