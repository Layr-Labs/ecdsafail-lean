    (entryLeave20 s ++ leaveFix3_20 h ++ leaveFix4_20 s ++ leaveFix5Pre20 s).all
      (fun g => decide (GateMirror.target g ≠ e0P20 s + 6)) = true := by
  decide +kernel

private theorem red20_targets_after : ∀ j : Fin 9,
    let s := start20 j; let h := sbP20 s
    (leaveFix1_20 s ++ fix2P20 s h ++ leaveFix3_20 h ++ leaveFix4_20 s ++ leaveFix5Move20 s ++ tailD0_20 s).all
      (fun g => decide (GateMirror.target g ≠ a0P20 s - 1 + 21)) = true ∧
    ([Gate.cx (h + 1582) 1560, Gate.cx 1559 1560] ++ leaveFix4_20 s ++ leaveFix5Move20 s ++
      tailD0_20 s ++ pairGM false 1624 (a0P20 s - 1 + 21) (bankW20 s 21) ++ tailD1_20 s).all
      (fun g => decide (GateMirror.target g ≠ 1559 ∧ GateMirror.target g ≠ e0P20 s + 4)) = true ∧
    ((storeHead20 s).drop 1).all (fun g => decide (GateMirror.target g ≠ 1558)) = true := by
  decide +kernel

private theorem lastTwo20_zero (h : Nat) (t : State)
    (clean : (run (GateMirror.forward (lastTwo20 h)) [] t).basis (h + 806) = false) :
    t.basis (h + 806) = t.basis (h + 1584) := by
