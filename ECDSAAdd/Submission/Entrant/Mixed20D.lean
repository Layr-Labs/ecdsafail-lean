  have notHist (q : Wire) (hq : q < start20 j + 16 ∨ start20 j + 35 < q) : q ∉ history20 j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi; unfold Wire at *; omega
  have notSM (q : Wire) (hq : q < b0P20 (start20 j) ∨ b0P20 (start20 j) + lowsP20 (start20 j) - 1 ≤ q) : q ∉ smallM20 j := by
    intro hm; obtain ⟨i, hi, e⟩ := List.mem_map.mp hm; rw [List.mem_range] at hi; unfold Wire at *; omega
  have hv_bs (q : Wire) (hl : (q < a0P20 (start20 j) - 1 ∨ a0P20 (start20 j) + lowsP20 (start20 j) - 1 ≤ q) ∧
      (q < b0P20 (start20 j) - 1 ∨ b0P20 (start20 j) + lowsP20 (start20 j) - 1 ≤ q))
