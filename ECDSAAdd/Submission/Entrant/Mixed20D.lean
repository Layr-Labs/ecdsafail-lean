/-- Margin-21 glue: `entry20_core`'s `hK` for `K := far ∧ farKey20 = 0` (`key0EraseBound20`). -/
theorem glueBound20 (j : Fin 9) (z : SkywalkNat.State) (sg : Bool) (small : Small20 (sbP20 (start20 j)) z) :
    (far (sbP20 (start20 j)) 20 z ∧ farKey20 (sbP20 (start20 j)) z = 0) →
      ¬ 2 ^ sbP20 (start20 j) ≤ (step^[20] (reduced (sbP20 (start20 j)) 20 z)).u -
        (PortalValues.negative sg (step^[20] (reduced (sbP20 (start20 j)) 20 z)).u).toNat →
      (step^[20] (reduced (sbP20 (start20 j)) 20 z)).u + (step^[20] (reduced (sbP20 (start20 j)) 20 z)).v <
        2 * 2 ^ sbP20 (start20 j) := by
  intro K low
  exact key0EraseBound20 _ z (small.1 K.1) K.1 K.2 _
    (by cases PortalValues.negative sg (step^[20] (reduced (sbP20 (start20 j)) 20 z)).u <;> decide) low

/-- G3 arithmetic: the B row -1 bit of the reduced walk, corrected by the G3 glue in the farKey-0 corner, is the
bit `b` of the TRUE `u - e` (20-tick copy of the 15-tick margin-16 `g3_math`). -/
theorem g3_math20 (b w : Nat) (z : SkywalkNat.State) (sg : Bool) (small : far b 20 z → min z.u z.v < 2 ^ b)
    (hw : 1 ≤ w) (c n : Bool) :
    ((((step^[20] (reduced b 20 z)).u - (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat) / 2 ^ b).testBit 0 ^^
      (decide (far b 20 z ∧ farKey20 b z = 0) &&
        ((HighBankAdjust.adjusted (high b 20 z) w c n).testBit 0 ^^ !c))) =
      (((step^[20] z).u - (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat) / 2 ^ b).testBit 0 := by
  have he : (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat ≤ (step^[20] (reduced b 20 z)).u := by
    by_cases p : 0 < (step^[20] (reduced b 20 z)).u
    · have : (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat ≤ 1 := by
        cases PortalValues.negative sg (step^[20] (reduced b 20 z)).u <;> decide
      omega
    · have n0 : PortalValues.negative sg (step^[20] (reduced b 20 z)).u = false := by
        simp only [PortalValues.negative, decide_eq_false p, Bool.and_false]
      rw [n0]; exact Nat.zero_le _
  have lo22 : ¬(far b 20 z ∧ farKey20 b z = 0) → ∀ f : far b 20 z,
      ((step^[20] z).u - (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat) % 2 ^ (b + 1) =
        ((step^[20] (reduced b 20 z)).u - (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat) % 2 ^ (b + 1) :=
    fun K f => (retainedLow22 b z (small f) sg K).2.2
  generalize (PortalValues.negative sg (step^[20] (reduced b 20 z)).u).toNat = e at he lo22 ⊢
  simp only [Nat.testBit_zero]
  have W0 : 2 ^ w % 2 = 0 := by
    obtain ⟨k, hk⟩ : ∃ k, w = k + 1 := ⟨w - 1, by omega⟩
    rw [hk, pow_succ]; omega
  have W2 : 2 ≤ 2 ^ w := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ w := Nat.pow_le_pow_right (by norm_num) hw
  have adj : (HighBankAdjust.adjusted (high b 20 z) w c n) % 2 = (high b 20 z + c.toNat) % 2 := by
    unfold HighBankAdjust.adjusted
    have dv : 2 ∣ 2 ^ w := Nat.dvd_of_mod_eq_zero W0
    cases n <;> cases c <;> simp only [Bool.toNat_false, Bool.toNat_true, if_true, if_false, Bool.false_eq_true] <;>
      rw [Nat.mod_mod_of_dvd _ dv] <;> omega
  by_cases K : far b 20 z ∧ farKey20 b z = 0
  · obtain ⟨f, k0⟩ := K
    have bits := (key0Bits20 b z (small f) f k0 e he).1
    have h2 : 2 ≤ high b 20 z := f
    simp only [decide_eq_true (And.intro f k0), Bool.true_and]
    rw [bits, adj]
    generalize ((step^[20] (reduced b 20 z)).u - e) / 2 ^ b = A
    generalize high b 20 z = Q at h2 ⊢
    have e2 : (A + (Q - 1)) % 2 = (A % 2 + Q % 2 + 1) % 2 := by omega
    have e1 : (Q + c.toNat) % 2 = (Q % 2 + c.toNat) % 2 := by omega
    rw [e1, e2]
    have hα : A % 2 < 2 := Nat.mod_lt _ (by norm_num)
    have hκ : Q % 2 < 2 := Nat.mod_lt _ (by norm_num)
    generalize A % 2 = α at hα ⊢
    generalize Q % 2 = κ at hκ ⊢
    interval_cases α <;> interval_cases κ <;> cases c <;> decide
  · simp only [decide_eq_false K, Bool.false_and, Bool.xor_false]
    by_cases f : far b 20 z
    · have key2 : ∀ x : Nat, x / 2 ^ b % 2 = x % 2 ^ (b + 1) / 2 ^ b := fun x => by
        rw [pow_succ, Nat.mod_mul_right_div_self]
      rw [key2 ((step^[20] (reduced b 20 z)).u - e), key2 ((step^[20] z).u - e), lo22 K f]
    · have same : reduced b 20 z = z := by unfold reduced; rw [if_neg f]
      rw [same]

theorem entry20_parity (j : Fin 9) (s : State) (m : List Bool) :
    parityBits20 (ports20 j) (run (GateMirror.forward (entryLeave20 (start20 j))) m s).basis = oddRead20 j s.basis := by
  have hg := geom20_facts j; dsimp only at hg
  have h1 : ∀ q ∈ history20 j, q ∉ (GateMirror.forward (fix0P20 (start20 j) (sbP20 (start20 j)))).map destination ∧
      q ∉ (GateMirror.forward (fix2P20 (start20 j) (sbP20 (start20 j)))).map destination := by
    have hall : ∀ k : Fin 9, (fix0P20 (start20 k) (sbP20 (start20 k)) ++ fix2P20 (start20 k) (sbP20 (start20 k))).all
        (fun g => decide (GateMirror.target g < start20 k + 16 ∨ start20 k + 35 < GateMirror.target g)) = true := by
      decide +kernel
    intro q hq
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hq; rw [List.mem_range] at hi
    constructor <;> (intro hm; rw [forward_map_dest] at hm; obtain ⟨g, hg', e⟩ := List.mem_map.mp hm)
    · have := of_decide_eq_true (List.all_eq_true.mp (hall j) g (List.mem_append_left _ hg'))
      rw [e] at this; unfold Wire at *; omega
    · have := of_decide_eq_true (List.all_eq_true.mp (hall j) g (List.mem_append_right _ hg'))
      rw [e] at this; unfold Wire at *; omega
  unfold parityBits20 oddRead20
  apply List.map_congr_left
  intro i hi; rw [List.mem_range] at hi
  have hq : (ports20 j).g + i ∈ history20 j := List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩
  unfold entryLeave20
  rw [forward_app, run_append, run_take, preserved _ _ _ _ (h1 _ hq).2,
    forward_app, run_append, run_take, fix1_20_forward, notRegister_correct _ (history20_nodup j)]
  simp only [if_pos hq]
  rw [preserved _ _ _ _ (h1 _ hq).1]

private theorem erase21_away : ∀ j : Fin 9,
    ∀ q ∈ [a0P20 (start20 j) - 1, b0P20 (start20 j) - 1, (1557 : Wire), 1558],
      q ∉ (Companion.eraseM (fullA20s j) (fullM20s j) fullC19 1556 1558).map destination := by
  decide +kernel

/-! ### Section 2: 20-Tick Selector Physical Lifting & `MoveChain.moved` -/

open Selector20

def actualMode20 (b : Nat) (z : SkywalkNat.State) : Mode20 :=
  if far b 20 z then
    if 2 ^ b ≤ z.u then 1 else ⟨2 + wait 20 z.u, by have := wait_le 20 z.u; omega⟩
  else 0

def farMode20 (f u : Bool) (small : Nat) : Mode20 :=
  if f then if u then 1 else ⟨2 + wait 20 small, by have := wait_le 20 small; omega⟩ else 0

theorem mode20_flags (f u : Bool) (small : Nat) :
    left20 (farMode20 f u small) = (f && u) ∧
    right20 (farMode20 f u small) = (f && !u) ∧
    enabled20 (farMode20 f u small) = f ∧
    (f && !u = true → key20 (farMode20 f u small) = wait 20 small) := by
  cases f <;> cases u <;> simp [left20, right20, enabled20, key20, farMode20]
  omega

/-- Wire renaming from `canonPorts` (`g=100..119`, `u=200..220`, `crossing=300`, `near=301`) to `ports20 j`. -/
def σ20 (j : Fin 9) (q : Wire) : Wire :=
  if 100 ≤ q ∧ q < 120 then start20 j + 16 + (q - 100)
  else if 200 ≤ q ∧ q < 221 then a0P20 (start20 j) - 1 + (q - 200)
  else if q = 300 then e0P20 (start20 j) + 6
  else if q = 301 then e0P20 (start20 j) + 7
  else q

abbrev inDom20 (q : Wire) : Prop :=
  (100 ≤ q ∧ q < 120) ∨ (200 ≤ q ∧ q < 221) ∨ q = 300 ∨ q = 301 ∨ (1559 ≤ q ∧ q ≤ 1602)

theorem σ20_inj (j : Fin 9) {a b : Wire} (ha : inDom20 a) (hb : inDom20 b) (e : σ20 j a = σ20 j b) : a = b := by
  have hg := geom20_facts j; dsimp only at hg
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  unfold inDom20 at ha hb
  unfold σ20 at e
  unfold Wire at *
  split_ifs at e <;> omega

def mapOp (f : Wire → Wire) : Op → Op
  | .xor a t => .xor (f a) (f t)
  | .mix a b t => .mix (f a) (f b) (f t)
  | .save a b t => .save (f a) (f b) (f t)

theorem op_in_dom :
    (prepOps20 canonPorts ++ retireOps20 canonPorts).all (fun o =>
      decide (inDom20 o.dst) && o.args.all (fun a => decide (inDom20 a))) = true := by
  decide +kernel

theorem prep_map_eq (j : Fin 9) :
    (prepOps20 canonPorts).map (mapOp (σ20 j)) = prepOps20 (ports20 j) ∧
    (retireOps20 canonPorts).map (mapOp (σ20 j)) = retireOps20 (ports20 j) := by
  revert j; decide +kernel

theorem trace_congr {P : Wire → Prop} (l : List Op) (b1 b2 : BasisState)
    (hdom : ∀ o ∈ l, P o.dst ∧ ∀ a ∈ o.args, P a)
    (heq : ∀ x, P x → b1 x = b2 x) :
    ∀ x, P x → trace l b1 x = trace l b2 x := by
  induction l generalizing b1 b2 with
  | nil => intro x hx; exact heq x hx
  | cons hd tl iht =>
    intro x hx
    apply iht _ _ (fun o' h => hdom o' (List.mem_cons_of_mem _ h)) (fun y hy => ?_) x hx
    have hh := hdom hd List.mem_cons_self
    cases hd with
    | xor a t =>
      simp only [Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : y = t
      · subst e; simp [heq y hy, heq a (hh.2 a (by simp [Op.args]))]
      · simp [e, heq y hy]
    | mix a b t =>
      simp only [Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : y = t
      · subst e; simp [heq y hy, heq a (hh.2 a (by simp [Op.args])), heq b (hh.2 b (by simp [Op.args]))]
      · simp [e, heq y hy]
    | save a b t =>
      simp only [Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : y = t
      · subst e; simp [heq y hy, heq a (hh.2 a (by simp [Op.args])), heq b (hh.2 b (by simp [Op.args]))]
      · simp [e, heq y hy]

theorem enter_mapOp (f : Wire → Wire) (P : Wire → Prop) (inj : ∀ x y, P x → P y → f x = f y → x = y)
    (ops : List Op) (hdom : ∀ o ∈ ops, P o.dst ∧ ∀ a ∈ o.args, P a)
    (v : BasisState) (q : Wire) (hq : P q) :
    trace (ops.map (mapOp f)) v (f q) = trace ops (fun w => v (f w)) q := by
  induction ops generalizing v with
  | nil => rfl
  | cons o os ih =>
    have ho := hdom o List.mem_cons_self
    have hrest : ∀ o' ∈ os, P o'.dst ∧ ∀ a ∈ o'.args, P a := fun o' h => hdom o' (List.mem_cons_of_mem _ h)
    change trace (os.map (mapOp f)) ((mapOp f o).step v) (f q) = trace os (o.step (fun w => v (f w))) q
    rw [ih hrest]
    refine trace_congr os _ _ hrest (fun x hx => ?_) q hq
    cases o with
    | xor a t =>
      simp only [mapOp, Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : x = t
      · subst e; simp
      · have ne : f x ≠ f t := fun h => e (inj x t hx ho.1 h)
        simp [e, ne]
    | mix a b t =>
      simp only [mapOp, Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : x = t
      · subst e; simp
      · have ne : f x ≠ f t := fun h => e (inj x t hx ho.1 h)
        simp [e, ne]
    | save a b t =>
      simp only [mapOp, Op.step, Op.dst, Op.val, writeBit, Function.update]
      by_cases e : x = t
      · subst e; simp
      · have ne : f x ≠ f t := fun h => e (inj x t hx ho.1 h)
        simp [e, ne]

theorem exit_mapOp (f : Wire → Wire) (P : Wire → Prop) (inj : ∀ x y, P x → P y → f x = f y → x = y)
    (ops : List Op) (hdom : ∀ o ∈ ops, P o.dst ∧ ∀ a ∈ o.args, P a)
    (v : BasisState) (g : Sym) (hv : validExit ops g = true) (s : State) (m : List Bool)
    (matchDom : ∀ q, P q → s.basis (f q) = (g q).read (fun w => v (f w))) :
    let out := run ((ops.map (mapOp f)).map Op.exit) m s
    out.phase = s.phase ∧
    (∀ q, P q → out.basis (f q) = (erased ops g q).read (fun w => v (f w))) ∧
    (∀ q, (∀ o ∈ ops, q ≠ f o.dst) → out.basis q = s.basis q) := by
  induction ops generalizing g s m with
  | nil => exact ⟨rfl, matchDom, fun _ _ => rfl⟩
  | cons o os ih =>
    obtain ⟨hc, ht⟩ := Bool.and_eq_true_iff.mp hv
    have ho := hdom o List.mem_cons_self
    have hrest : ∀ o' ∈ os, P o'.dst ∧ ∀ a ∈ o'.args, P a := fun o' h => hdom o' (List.mem_cons_of_mem _ h)
    have hstep :
        let st1 := run [(mapOp f o).exit] m s
        st1.phase = s.phase ∧
        (∀ q, P q → st1.basis (f q) = (LeaveSelector.erase o g q).read (fun w => v (f w))) ∧
        (∀ q, q ≠ f o.dst → st1.basis q = s.basis q) := by
      cases o with
      | save a b t =>
        obtain ⟨ta, tb, heq⟩ : t ≠ a ∧ t ≠ b ∧ g t = conj (g a) (g b) := by simpa [checkExit] using hc
        have fta : f t ≠ f a := fun e => ta (inj t a ho.1 (ho.2 a (by simp [Op.args])) e)
        have ftb : f t ≠ f b := fun e => tb (inj t b ho.1 (ho.2 b (by simp [Op.args])) e)
        have ha : s.basis (f a) = (g a).read (fun w => v (f w)) := matchDom a (ho.2 a (by simp [Op.args]))
        have hb : s.basis (f b) = (g b).read (fun w => v (f w)) := matchDom b (ho.2 b (by simp [Op.args]))
        have ht0 : s.basis (f t) = (s.basis (f a) && s.basis (f b)) := by
          rw [matchDom t ho.1, heq, read_conj, ha, hb]
        cases hm : m.headD false
        · simp only [mapOp, Op.exit, run, measureAndCorrect, hm, Bool.false_eq_true, ↓reduceIte, correct,
            Bool.false_and, Bool.xor_false, Op.dst, writeBit]
          refine ⟨trivial, fun q hq => ?_, fun q hne => by simp [Function.update, hne]⟩
          by_cases e : q = t
          · subst e; simp [LeaveSelector.erase, Expr.read]
          · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
            simp [LeaveSelector.erase, e, ne, matchDom q hq]
        · simp only [mapOp, Op.exit, run, measureAndCorrect, hm, ↓reduceIte, correct,
            Bool.true_and, Op.dst, writeBit, ht0, Function.update_of_ne fta.symm, Function.update_of_ne ftb.symm]
          refine ⟨by cases s.phase <;> cases s.basis (f a) <;> cases s.basis (f b) <;> rfl,
            fun q hq => ?_, fun q hne => by simp [Function.update, hne]⟩
          by_cases e : q = t
          · subst e; simp [LeaveSelector.erase, Expr.read]
          · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
            simp [LeaveSelector.erase, e, ne, matchDom q hq]
      | xor a t =>
        refine ⟨rfl, fun q hq => ?_, fun q hne => by
          dsimp only [Op.dst] at hne
          simp [mapOp, Op.exit, Op.enter, run, writeBit, Function.update, hne]⟩
        simp only [mapOp, Op.exit, Op.enter, run, writeBit, Function.update]
        by_cases e : q = t
        · subst e; simp [LeaveSelector.erase, symbolic, Op.dst, read_xor,
            matchDom q hq, matchDom a (ho.2 a (by simp [Op.args]))]
        · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
          simp [LeaveSelector.erase, symbolic, Op.dst, e, ne, matchDom q hq]
      | mix a b t =>
        refine ⟨rfl, fun q hq => ?_, fun q hne => by
          dsimp only [Op.dst] at hne
          simp [mapOp, Op.exit, Op.enter, run, writeBit, Function.update, hne]⟩
        simp only [mapOp, Op.exit, Op.enter, run, writeBit, Function.update]
        by_cases e : q = t
        · subst e; simp [LeaveSelector.erase, symbolic, Op.dst, read_xor, read_conj,
            matchDom q hq, matchDom a (ho.2 a (by simp [Op.args])), matchDom b (ho.2 b (by simp [Op.args]))]
        · have ne : f q ≠ f t := fun h => e (inj q t hq ho.1 h)
          simp [LeaveSelector.erase, symbolic, Op.dst, e, ne, matchDom q hq]
    dsimp only at hstep ⊢
    have hrun : run (((o :: os).map (mapOp f)).map Op.exit) m s =
        run ((os.map (mapOp f)).map Op.exit) (m.drop (measurementCount [(mapOp f o).exit]))
          (run [(mapOp f o).exit] m s) := by
      rw [List.map_cons, List.map_cons, ← List.singleton_append, run_append, run_take]
    rw [hrun]
