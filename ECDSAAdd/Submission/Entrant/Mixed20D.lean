  generalize hE : run (Companion.eraseM (fullA20s j) (fullM20s j) fullC19 1556 1558)
    (tp1.drop (measurementCount (maskP20 j))) w = E at er
  have zero21 : regValue (fullM20 j) E.basis = 0 := by
    rw [fMsp, fMsp20, regValue_append, regValue_append, er.2.2]
    simp [regValue, (er.2.1 _ topOut19).trans wM19, (er.2.1 _ topOut20).trans wM]
  have mOut' : ∀ q, q ∈ [1556, 1557, 1558] → q ∉ fullM20s j := fun q hq hm => mOut q (m20sSub q hm) hq
  have E57 : E.basis 1557 = w.basis 1557 := er.2.1 1557 (mOut' 1557 (by simp))
  have E58 : E.basis 1558 = w.basis 1558 := er.2.1 1558 (mOut' 1558 (by simp))
  have nA : a0P20 (start20 j) - 1 ∉ fullM20s j := by
    intro h; obtain ⟨i, hi, hx⟩ := List.mem_map.mp h; rw [List.mem_range] at hi; unfold Wire at *; omega
  have nB : b0P20 (start20 j) - 1 ∉ fullM20s j := by
    intro h; obtain ⟨i, hi, hx⟩ := List.mem_map.mp h; rw [List.mem_range] at hi; unfold Wire at *; omega
  have EA : E.basis (a0P20 (start20 j) - 1) = w.basis (a0P20 (start20 j) - 1) := er.2.1 _ nA
  have EB : E.basis (b0P20 (start20 j) - 1) = w.basis (b0P20 (start20 j) - 1) := er.2.1 _ nB
  have hA57 : (a0P20 (start20 j) - 1 : Wire) ≠ 1557 := by unfold Wire; omega
  have hA58 : (a0P20 (start20 j) - 1 : Wire) ≠ 1558 := by unfold Wire; omega
  have hB57 : (b0P20 (start20 j) - 1 : Wire) ≠ 1557 := by unfold Wire; omega
  have hB58 : (b0P20 (start20 j) - 1 : Wire) ≠ 1558 := by unfold Wire; omega
  have wA1 : w.basis (a0P20 (start20 j) - 1) = l.basis (a0P20 (start20 j) - 1) := by
    simp only [w, writeBit, Function.update_of_ne hA58, Function.update_of_ne hA57]
  have wB1 : w.basis (b0P20 (start20 j) - 1) = l.basis (b0P20 (start20 j) - 1) := by
    simp only [w, writeBit, Function.update_of_ne hB58, Function.update_of_ne hB57]
  have w57 : w.basis 1557 = !l.basis (a0P20 (start20 j) - 1) := by
    simp only [w, writeBit, Function.update_of_ne (show (1557:Wire) ≠ 1558 by decide), Function.update_self]
  have w58 : w.basis 1558 = (l.basis (b0P20 (start20 j) - 1) && !l.basis (a0P20 (start20 j) - 1)) := by
    simp only [w, writeBit, Function.update_self]
  have rel := mask_close (a0P20 (start20 j) - 1) (b0P20 (start20 j) - 1) 1557 1558 E
    ((tp1.drop (measurementCount (maskP20 j))).drop
      (measurementCount (Companion.eraseM (fullA20s j) (fullM20s j) fullC19 1556 1558)))
    ndM (by rw [E57, EA, w57, wA1]) (by rw [E58, EB, E57, w57, w58, wB1])
  rw [show releaseMaskP20 j = [.measureX 1558 [] [.CZ (b0P20 (start20 j) - 1) 1557],
    .CX (a0P20 (start20 j) - 1) 1557, .X 1557] from rfl, rel]
  have relQ (q : Wire) (n7 : q ≠ 1557) (n8 : q ≠ 1558) :
      (writeBit (writeBit E.basis 1557 false) 1558 false) q = E.basis q := by
    simp [writeBit, Function.update, n7, n8]
  refine ⟨er.1.trans (vphase.trans scanActual.1), ?_, ?_, ?_, ⟨by simp [writeBit], by simp [writeBit]⟩, ?_, ?_⟩
  · dsimp only
    rw [show regValue (fullM20 j) (writeBit (writeBit E.basis 1557 false) 1558 false) = regValue (fullM20 j) E.basis from
      (regValue_eq_iff _ _ _).mpr (fun q h => relQ q (fun e => mOut q h (by simp [e])) (fun e => mOut q h (by simp [e])))]
    exact zero21
  · dsimp only
    rw [relQ (e0P20 (start20 j) + 5) (by unfold Wire; omega) (by unfold Wire; omega)]
    exact (er.2.1 _ (notInM20s _ (fun h => by
      obtain ⟨i, hi, e'⟩ := List.mem_map.mp h; rw [List.mem_range] at hi; unfold Wire at e'; omega))).trans
      ((keptW _ (by simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]; unfold Wire; omega)).trans
