private theorem bankW20_inBox (j : Fin 9) (i : Nat) (hi : i < wpP20 (start20 j) + 20) :
    leaveBox20 (start20 j) (bankW20 (start20 j) i) := by
  have hg := geom20_facts j; dsimp only at hg
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
  have hbt := (bTop20_bounds j).2
  rcases bank20_cases j hi with ⟨_, eb⟩ | ⟨_, _, eb, _, _⟩ | ⟨_, eb, _, _⟩
  · rw [eb]; unfold leaveBox20; right; right; right; left; unfold Wire at *; omega
  · unfold leaveBox20; right; right; left; unfold Wire at *; omega
  · rw [eb]; unfold leaveBox20; right; right; right; left; unfold Wire at *; omega

private theorem leaveBefore20_inBox (j : Fin 9) : inBox20 j (leaveBefore20 (start20 j)) := by
  have hg := geom20_facts j; dsimp only at hg
  have hfix : inBox20 j (entryLeave20 (start20 j) ++ selPrefix20 (start20 j)) := fun g hg' q hq => by
    unfold leaveBox20
    exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp (fixedBefore20_box j) g hg') q hq)
  have hadj : inBox20 j (leaveAdjust20 (start20 j)) := by
    unfold leaveAdjust20 leaveAdjustCore20 adjustG
    have hys : ∀ q ∈ (List.range (wpP20 (start20 j))).map (bankW20 (start20 j)), leaveBox20 (start20 j) q := by
