theorem admits345 (d : Bool) (before : State) (et first pack : List Bool)
    (nowZ : SkywalkRails.State) (parity : (nowZ.a + nowZ.b) % 2 = 1)
    (ready : Shadow7.onRails j20 0 nowZ (run (Shadow7.enterP j20) et before).basis)
    (scratch : ∀ k : Fin 157, 23 ≤ k.val →
      (run (packProg345 d) pack (run (Shadow7.routed j20 0 1) first (run (Shadow7.enterP j20) et before))).basis
        (ArchiveJ20.rawPorts k8 k) = false)
    (past : SkywalkNat.State) (g sign cross : Bool) (odd : past.v % 2 = 1) (small : Shadow7.SmallIfFar (sbP20 325) 20 past)
    (prior : PastFacts20 k8 (ArchiveJ20.rawPorts k8) past g sign cross before) :
    let src := run (Shadow7.routed j20 0 1) first (run (Shadow7.enterP j20) et before)
    let out := run (packProg345 d) pack src
