/-- A program that never touches wire `t` commutes with a write to `t` (VAST3, margin 21 G3). -/
private theorem run_writeBit_off20 (P : Program) (t : Wire) (ht : t ∉ wires P) (s : State) (m : List Bool) (b : Bool) :
    run P m ⟨s.phase, writeBit s.basis t b⟩ = ⟨(run P m s).phase, writeBit (run P m s).basis t b⟩ := by
  have agree : ∀ q ∈ wires P, (⟨s.phase, writeBit s.basis t b⟩ : State).basis q = s.basis q := by
    intro q hq
    have hne : q ≠ t := fun e => ht (e ▸ hq)
    simp [writeBit, Function.update_of_ne hne]
  obtain ⟨hph, hw⟩ := ECDSAAdd.Arithmetic.run_local_increment P _ s m agree
  have hphase : (run P m ⟨s.phase, writeBit s.basis t b⟩).phase = (run P m s).phase := by
    revert hph
    cases (run P m ⟨s.phase, writeBit s.basis t b⟩).phase <;> cases (run P m s).phase <;> cases s.phase <;> simp
  apply congrArg₂ State.mk hphase
  funext q
  by_cases hq : q = t
  · subst hq
    rw [run_preserves_outside _ _ _ _ ht]
    simp [writeBit]
  · by_cases hqP : q ∈ wires P
    · rw [hw q hqP]; simp [writeBit, Function.update_of_ne hq]
    · have h1 := run_preserves_outside P m ⟨s.phase, writeBit s.basis t b⟩ q hqP
      have h2 := run_preserves_outside P m s q hqP
      rw [h1]
      simp only [writeBit, Function.update_of_ne hq]
      exact h2.symm

