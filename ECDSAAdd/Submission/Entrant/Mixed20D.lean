        a0P20 (start20 m) + 21 ≤ start20 m + 35 + railP (start20 m + 19) ∧
        a0P20 (start20 m) + 21 ≤ 529 ∧
        bTopP (start20 m) = 785 + railP (start20 m) := by decide +kernel
    exact this j
  have ha0 : a0P20 (start20 j) = start20 j + sbP20 (start20 j) + 37 := rfl
  have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl
