private theorem chainMid20_targets (s : Nat) : ∀ g ∈ chainMid20 s, GateMirror.target g ≠ 1558 := by
  have hb : AllAT (fun _ => True) (fun q => q ≠ 1558)
      [GateMirror.Gate.cx (storeWire20 s (liveW20 s - lowsP20 s + 1)) 1557, GateMirror.Gate.x 1557] :=
