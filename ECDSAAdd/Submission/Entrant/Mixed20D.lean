  obtain ⟨row, lim, matchRow⟩ := interrupted_row20 (sbP20 325) past small odd g sign cross _
    (prior.records.trans (true_records20 _ _ small odd _ _).symm)
  exact ⟨row, lim, starting_frame (ArchiveJ20.rawPorts k8) _ row data matchRow record scratch⟩

