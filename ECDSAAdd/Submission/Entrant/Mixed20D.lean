/-- Shifted enter coordinate `sbP20 (start20 j) + 5` matching `enterFix17`. -/
def h20 (j : Fin 9) : Nat := sbP20 (start20 j) + 5

def railA (j : Fin 9) : List Wire :=
  [start20 j + h20 j + 31, start20 j + h20 j + 32]

def railB (j : Fin 9) : List Wire :=
  [h20 j + 801, h20 j + 802]

def gate (j : Fin 9) : Wire := start20 j + 15
def flagN (j : Fin 9) : Wire := h20 j + 1579
def flagF (j : Fin 9) : Wire := h20 j + 1577
def flagU (j : Fin 9) : Wire := h20 j + 1578
def parked (j : Fin 9) : Wire := h20 j + 803

def clear (j : Fin 9) : List Wire :=
  [h20 j + 1574, h20 j + 1575, h20 j + 1576, 1556]

def ports (j : Fin 9) : List Wire :=
  [start20 j + h20 j + 31, start20 j + h20 j + 32,
   h20 j + 801, h20 j + 802, start20 j + 15,
   h20 j + 1579, h20 j + 1577, h20 j + 1578, h20 j + 803,
   h20 j + 1574, h20 j + 1575, h20 j + 1576, 1556]

def map (j : Fin 9) (q : Wire) : Wire := (ports j).getD q 0

def lowerPairs (j : Fin 9) : List (Wire × Wire) :=
  [(start20 j + h20 j + 31, h20 j + 801), (start20 j + h20 j + 32, h20 j + 802)]

def upperPairs (j : Fin 9) : List (Wire × Wire) :=
  (List.range (wpP20 (start20 j) - 2)).map fun i =>
    (start20 j + h20 j + 33 + i, h20 j + 803 + i)

def upperTail (j : Fin 9) : List (Wire × Wire) :=
  (List.range (wpP20 (start20 j) - 3)).map fun i =>
    (start20 j + h20 j + 34 + i, h20 j + 804 + i)

def saved (j : Fin 9) : List Wire :=
  [h20 j + 1574, h20 j + 1575, h20 j + 1576] ++ (upperTail j).map Prod.snd

def pending (j : Fin 9) : List Wire :=
  [h20 j + 1580, h20 j + 1581, h20 j + 1582]

def lowA (j : Fin 9) : List Wire := List.range' (start20 j + 16) (sbP20 (start20 j) + 20)
def lowB (j : Fin 9) : List Wire := List.range' 786 (sbP20 (start20 j) + 20)

def safe (j : Fin 9) (q : Wire) : Prop :=
  (q < start20 j + 16 ∨ start20 j + h20 j + 31 ≤ q) ∧ (q < 786 ∨ h20 j + 801 ≤ q)

def lay (j : Fin 9) : SkywalkIntegerLayout := W.compactSkywalkTickLayout base (start20 j)
def pull (j : Fin 9) : Wire → Wire := OB5.sig (start20 j - 1)
def carryPorts (j : Fin 9) : List Wire :=
  ((IntegerPacket.ports (shape20 j) 0).carry).map (windowNet20 j)
def rest (j : Fin 9) : List Wire := (carryPorts j).drop 1
def guarded (j : Fin 9) : List Wire :=
  ports j ++ [flagN j, flagF j, flagU j] ++ RailPair.sites (upperPairs j)

theorem ports_length (j : Fin 9) : (ports j).length = EnterProof17.width := rfl

theorem inc_all : ∀ j : Fin 9, ∀ a b : Fin EnterProof17.width, map j a = map j b → a = b := by
  decide +kernel

theorem inc (j : Fin 9) : ∀ a b : Fin EnterProof17.width, map j a = map j b → a = b := inc_all j

theorem emitted (j : Fin 9) : enterP20 j = renameProgram (map j) EnterProof17.forward := rfl
theorem emittedInv (j : Fin 9) : enterInvP20 j = renameProgram (map j) EnterProof17.backward := rfl

theorem frame (j : Fin 9) :
    start20 j = 165 + 20 * j.val ∧ j.val < 9 ∧
    2 * sbP20 (start20 j) + start20 j ≤ 492 ∧
    491 ≤ 2 * sbP20 (start20 j) + start20 j ∧
    70 < wpP20 (start20 j) ∧ wpP20 (start20 j) + h20 j ≤ 243 := by
  have arith : ∀ k : Fin 9,
      2 * sbP20 (start20 k) + start20 k ≤ 492 ∧
      491 ≤ 2 * sbP20 (start20 k) + start20 k ∧
      70 < wpP20 (start20 k) ∧ wpP20 (start20 k) + h20 k ≤ 243 := by
    decide +kernel
  exact ⟨rfl, j.isLt, arith j⟩

theorem upperSites (j : Fin 9) {q : Wire} (h : q ∈ RailPair.sites (upperPairs j)) :
    (start20 j + h20 j + 33 ≤ q ∧ q + 2 < start20 j + h20 j + 33 + wpP20 (start20 j)) ∨
    (h20 j + 803 ≤ q ∧ q + 2 < h20 j + 803 + wpP20 (start20 j)) := by
  simp only [RailPair.sites, upperPairs, List.mem_flatMap, List.mem_map, List.mem_range,
    List.mem_cons, List.not_mem_nil, or_false] at h
  obtain ⟨p, ⟨i, hi, rfl⟩, hp⟩ := h
  simp only [Wire] at *
  rcases hp with rfl | rfl <;> omega

theorem portsRegion (j : Fin 9) {q : Wire} (h : q ∈ ports j) :
    (start20 j + h20 j + 31 ≤ q ∧ q ≤ start20 j + h20 j + 32) ∨
    (h20 j + 801 ≤ q ∧ q ≤ h20 j + 803) ∨
    q = start20 j + 15 ∨
    (h20 j + 1574 ≤ q ∧ q ≤ h20 j + 1579) ∨
    q = 1556 := by
  simp only [ports, List.mem_cons, List.not_mem_nil, or_false] at h
  simp only [Wire] at *
  omega

private theorem aperture_all : ∀ j : Fin 9,
    pull j (gate j) = (lay j).previous ∧
    (railA j).map (pull j) = ((lay j).a.drop (sbP20 (start20 j) + 20)).take 2 ∧
    (railB j).map (pull j) = ((lay j).b.drop (sbP20 (start20 j) + 20)).take 2 ∧
    sbP20 (start20 j) + 20 + 3 ≤ (lay j).a.length ∧
    sbP20 (start20 j) + 20 + 3 ≤ (lay j).b.length ∧
    pull j (start20 j + h20 j + 33) = (lay j).a.getD (sbP20 (start20 j) + 20 + 2) 0 ∧
    pull j (h20 j + 803) = (lay j).b.getD (sbP20 (start20 j) + 20 + 2) 0 ∧
    (∀ q ∈ clear j, pull j q ∈ (lay j).carry) := by
  decide +kernel

theorem park_mem (j : Fin 9) : (start20 j + h20 j + 33, h20 j + 803) ∈ upperPairs j := by
  have f := frame j
  unfold upperPairs
  exact List.mem_map.mpr ⟨0, List.mem_range.mpr (by omega), rfl⟩

theorem protected0 (j : Fin 9) : ∀ q ∈ gate j :: (railA j ++ railB j ++ clear j),
    q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧ q ∉ RailPair.sites (upperPairs j) := by
  have f := frame j
  intro q hq
  simp only [gate, railA, railB, clear, flagN, flagF, flagU, List.mem_cons, List.mem_append,
    List.not_mem_nil, or_false] at hq ⊢
  refine ⟨by simp only [Wire] at *; omega, by simp only [Wire] at *; omega,
    by simp only [Wire] at *; omega, fun hs => ?_⟩
  have u := upperSites j hs
  simp only [Wire] at *
  omega

def layout (j : Fin 9) :
    EnterProof17.Aperture (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (ports j) (lay j) (pull j) (sbP20 (start20 j) + 20) where
  a := railA j
  b := railB j
  park := (start20 j + h20 j + 33, h20 j + 803)
  spec := ⟨rfl, rfl, clear j, rfl⟩
  g0 := (aperture_all j).1
  xa := (aperture_all j).2.1
  xb := (aperture_all j).2.2.1
  na := (aperture_all j).2.2.2.1
  nb := (aperture_all j).2.2.2.2.1
  parked := park_mem j
  pa := (aperture_all j).2.2.2.2.2.1
  pb := (aperture_all j).2.2.2.2.2.2.1
  protected0 := protected0 j
  temps := (aperture_all j).2.2.2.2.2.2.2

theorem from_full (j : Fin 9) (raw v : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (sbP20 (start20 j)) 20 z)
    (p : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (sbP20 (start20 j)) 20 z))
      (decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
      (pullState (pull j) raw) v)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    let next := run (enterP20 j) m v
    next.phase = v.phase ∧
    (∀ q ∈ wires EnterProof17.forward,
      next.basis (map j q) = (EnterProof17.shadowRow (sbP20 (start20 j)) 20 z G S).testBit q) ∧
    ∀ q ∉ wires (enterP20 j), next.basis q = v.basis q := by
  have src := EnterProof17.read_packed (layout j) raw v z G S p input
  apply EnterProof17.actual_shadow (map j) (enterP20 j) false (sbP20 (start20 j)) 20 z G S small
    (inc j) (emitted j) v m
  intro q h
  have lim : wires EnterProof17.forward ⊆ Finset.range 13 := by
    apply ArchiveFieldScratch.bounded; decide +kernel
  have hv := EnterProof.bitAt (ports j) v.basis q
    ((show (ports j).length = 13 from rfl) ▸ Finset.mem_range.mp (lim h))
  rw [src] at hv
  exact hv

theorem programCover (j : Fin 9) : wires (enterP20 j) ⊆ (ports j).toFinset := by
  rw [emitted j, renameProgram_support, EnterProof17.forward_all]
  intro q hq
  obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
  have lt : w < (ports j).length := Finset.mem_range.mp hw
  rw [List.mem_toFinset, map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem lt, Option.getD_some]
  exact List.getElem_mem lt

theorem notWire (j : Fin 9) {q : Wire} (h : q ∉ ports j) : q ∉ wires (enterP20 j) :=
  fun m => h (List.mem_toFinset.mp (programCover j m))

theorem noLow (j : Fin 9) : ∀ q ∈ guarded j, safe j q := by
  have f := frame j
  intro q hq
  simp only [guarded, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hq
  unfold safe
  rcases hq with (hp | hn) | hs
  · have r := portsRegion j hp; simp only [Wire] at *; omega
  · simp only [flagN, flagF, flagU, Wire] at *; omega
  · have u := upperSites j hs; simp only [Wire] at *; omega

theorem lowUnsafe (j : Fin 9) : ∀ w ∈ lowA j ++ lowB j, ¬ safe j w := by
  intro w h
  simp only [lowA, lowB, safe, h20, List.mem_append, List.mem_range'_1, Wire] at *
  omega

private theorem lowX_all : ∀ j : Fin 9,
    (lowA j).map (pull j) = (lay j).a.take (sbP20 (start20 j) + 20) ∧
    (lowB j).map (pull j) = (lay j).b.take (sbP20 (start20 j) + 20) := by
  decide +kernel

theorem protects (j : Fin 9) (q : Wire) (h : q ∈ lowA j ++ lowB j) :
    q ∉ wires (enterP20 j) ∧ q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧
      q ∉ RailPair.sites (upperPairs j) := by
  have bad := lowUnsafe j q h
  have gone : q ∉ guarded j := fun mem => bad (noLow j q mem)
  simp only [guarded, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or] at gone
  exact ⟨notWire j gone.1.1, gone.1.2.1, gone.1.2.2.1, gone.1.2.2.2, gone.2⟩

def placement (j : Fin 9) :
    EnterProof17.WordPlacement (b := sbP20 (start20 j)) (k := 20) (layout j) (enterP20 j) where
  lowA := lowA j
  lowB := lowB j
  al := List.length_range'
  bl := List.length_range'
  xa := (lowX_all j).1
  xb := (lowX_all j).2
  aTop := rfl
  bTop := rfl
  protected0 := protects j
  portsCount := rfl

/-- 20-tick version of `EnterProof17.FramePorts`. -/
structure FramePorts20 {lo hi g n f u rs L net b P} {A : Aperture lo hi g n f u rs L net (b + 20)}
    (place : WordPlacement (b := b) (k := 20) A P) (j : Fin 9) : Prop where
  a : (IntegerPacket.ports (shape20 j) 0).a.map (windowNet20 j) = place.lowA ++ A.a
  bSites : (IntegerPacket.ports (shape20 j) 0).b.map (windowNet20 j) = place.lowB ++ A.b
  prev : windowNet20 j (IntegerPacket.ports (shape20 j) 0).previous = rs.getD 4 0
  carry : ∀ q ∈ (IntegerPacket.ports (shape20 j) 0).carry, let v := windowNet20 j q
    v ∈ rs.drop 12 ∨ (v ∉ wires P ∧ net v ∈ L.carry ∧ v ≠ n ∧ v ≠ f ∧ v ≠ u ∧ v ∉ RailPair.sites hi)
  ext : ∀ r : Fin 20, let q := windowNet20 j (IntegerPacket.ports (shape20 j) r).ext
    q ∉ wires P ∧ (q ∈ hi.map Prod.fst ∨ (net q = L.ext ∧ q ≠ n ∧ q ≠ f ∧ q ≠ u ∧ q ∉ RailPair.sites hi))
  hist : ∀ r : Fin 20, let q := windowNet20 j (IntegerPacket.ports (shape20 j) r).history
    q ∉ wires P ∧ q ≠ n ∧ q ≠ f ∧ q ≠ u ∧ q ∉ RailPair.sites hi

theorem complete20 {lo hi g n f u rs L net b P} {A : Aperture lo hi g n f u rs L net (b + 20)}
    {place : WordPlacement (b := b) (k := 20) A P} {j : Fin 9} (frame : FramePorts20 place j)
    (z : SkywalkNat.State) (G S : Bool) (small : Shadow7.SmallIfFar b 20 z)
    (raw pre post : State)
    (cut : PackedCut lo hi g n f u (PortalValues.negative S z.u) (decide (Shadow.far b 20 z))
      (decide (Shadow.far b 20 z ∧ 2 ^ b ≤ z.u)) (pullState net raw) pre)
    (input : SkywalkIntegerInput L (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (data : ∀ q ∈ wires EnterProof17.forward, post.basis (rs.getD q 0) = (shadowRow b 20 z G S).testBit q)
    (save : ∀ q ∉ wires P, post.basis q = pre.basis q)
    (history : ∀ r : Fin 20, raw.basis (net (windowNet20 j (IntegerPacket.ports (shape20 j) r).history)) = false) :
    let T := Shadow.reduced b 20 z
    onRails20 j 0 (SkywalkRails.encode G S T.u T.v) post.basis := by
  let T := Shadow.reduced b 20 z
  let Z := SkywalkRails.encode G S T.u T.v
  have values := EnterProof17.short_rails P place z G S small raw pre post cut input data save
  have move (qs : List Wire) :
      signedRegValue qs (mappedBasis20 j post.basis) = signedRegValue (qs.map (windowNet20 j)) post.basis := by
    simp only [signedRegValue, List.length_map, PortalValues.unroute]; rfl
  have gval := EnterProof17.actual_tags rs post.basis b 20 z G S data
  have sc := EnterProof17.output_values rs post.basis b 20 z G S place.portsCount data
  have clean := (regValue_zero _ _).mp sc.2.2
  have retain (q : Wire) (no : q ∉ wires P) (n0 : q ≠ n) (f0 : q ≠ f) (u0 : q ≠ u)
      (hi0 : q ∉ RailPair.sites hi) : post.basis q = raw.basis (net q) :=
    (save _ no).trans (cut.unchanged _ n0 f0 u0 hi0)
  refine ⟨(move _).trans (frame.a ▸ values.1), (move _).trans (frame.bSites ▸ values.2), ?_, ?_, ?_⟩
  · change post.basis (windowNet20 j (IntegerPacket.ports (shape20 j) 0).previous) = Z.g
    rw [frame.prev, gval.1]; cases G <;> rfl
  · apply (regValue_zero _ _).mpr
    intro q hq
    rcases frame.carry q hq with hs | ⟨no, qc, n0, f0, u0, hi0⟩
    · exact clean _ hs
    · exact (retain _ no n0 f0 u0 hi0).trans ((regValue_zero _ _).mp input.2.2.2.2.2 _ qc)
  · intro r _ lt
    have bound : r < 20 := lt
    let i : Fin 20 := ⟨r, bound⟩
    obtain ⟨no, mem⟩ := frame.ext i
    obtain ⟨nh, h0, h1, h2, hr⟩ := frame.hist i
    refine ⟨?_, (retain _ nh h0 h1 h2 hr).trans (history i)⟩
    rcases mem with mem | ⟨eqe, e0, e1, e2, eh⟩
    · obtain ⟨p, hp, eq⟩ := List.mem_map.mp mem
      exact (save _ no).trans (eq ▸ (cut.upper _ hp).1)
    · exact (retain _ no e0 e1 e2 eh).trans (by rw [eqe]; exact input.2.2.2.1)

theorem carryPorts_eq (j : Fin 9) : carryPorts j = List.range' 1556 (sbP20 (start20 j) + 21) := by
  have hj := j.isLt
  have hc : (IntegerPacket.ports (shape20 j) 0).carry = List.range' 1556 (sbP20 (start20 j) + 21) := rfl
  unfold carryPorts
  rw [hc]
  conv => rhs; rw [← List.map_id (List.range' 1556 _)]
  apply List.map_congr_left
  intro q hq
  rw [List.mem_range'_1] at hq
  simp only [windowNet20, OB5.sig, start20, sbP20, id, Wire] at hq ⊢
  split <;> omega

theorem rest_eq (j : Fin 9) : rest j = List.range' 1557 (sbP20 (start20 j) + 20) := by
  rw [rest, carryPorts_eq, List.drop_range']
  congr 1

theorem parts (j : Fin 9) : carryPorts j = ((ports j).drop 12) ++ rest j := by
  rw [rest_eq, carryPorts_eq]
  have e : sbP20 (start20 j) + 21 = 1 + (sbP20 (start20 j) + 20) := by omega
  rw [e, ← List.range'_append_1]
  rfl

private theorem frame_checks_all : ∀ j : Fin 9,
    (lay j).carry = List.range' 1556 (W.compactSkywalkTickPreWidth (start20 j) - 1) ∧
    sbP20 (start20 j) + 23 ≤ W.compactSkywalkTickPreWidth (start20 j) ∧
    (∀ q ∈ guarded j, q < 1557 ∨ h20 j + 1574 ≤ q) ∧
    (IntegerPacket.ports (shape20 j) 0).a.map (windowNet20 j) = lowA j ++ railA j ∧
    (IntegerPacket.ports (shape20 j) 0).b.map (windowNet20 j) = lowB j ++ railB j ∧
    windowNet20 j (IntegerPacket.ports (shape20 j) 0).previous = (ports j).getD 4 0 ∧
    (∀ r : Fin 20, let q := windowNet20 j (IntegerPacket.ports (shape20 j) r).ext
      q ∉ ports j ∧ (q ∈ (upperPairs j).map Prod.fst ∨
        (pull j q = (lay j).ext ∧ q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧ q ∉ RailPair.sites (upperPairs j)))) := by
  decide +kernel

theorem clearCover (j : Fin 9) : ∀ q ∈ guarded j, q ∉ rest j := by
  intro q hq mem
  rw [rest_eq, List.mem_range'_1] at mem
  have := (frame_checks_all j).2.2.1 q hq
  simp only [h20, Wire] at *
  omega

theorem sourceCover (j : Fin 9) : ∀ q ∈ rest j, pull j q ∈ (lay j).carry := by
  intro q hq
  rw [rest_eq, List.mem_range'_1] at hq
  have w := (frame_checks_all j).2.1
  have hj := j.isLt
  rw [(frame_checks_all j).1, List.mem_range'_1]
  have fix : pull j q = q := by
    have hq' := hq
    simp only [pull, OB5.sig, start20, sbP20, Wire] at hq' ⊢
    split <;> omega
  rw [fix]
  simp only [Wire] at *
  omega

theorem histPort (j : Fin 9) (r : Fin 20) :
    let q := windowNet20 j (IntegerPacket.ports (shape20 j) r).history
    (q = start20 j + r.val + 1044 ∧ start20 j + r.val + 1044 < 1301) ∨
    (q = 2069 - start20 j - r.val ∧ 1301 ≤ start20 j + r.val + 1044) := by
  have hr := r.isLt
  have f := frame j
  simp only [windowNet20, OB5.sig, IntegerPacket.ports, shape20, Wire] at *
  split <;> omega

theorem frameHist (j : Fin 9) : ∀ r : Fin 20,
    let q := windowNet20 j (IntegerPacket.ports (shape20 j) r).history
    q ∉ ports j ∧ q ≠ flagN j ∧ q ≠ flagF j ∧ q ≠ flagU j ∧ q ∉ RailPair.sites (upperPairs j) := by
  intro r
  have f := frame j
  have hr := r.isLt
  have hp := histPort j r
  dsimp only at hp ⊢
  refine ⟨fun m => ?_, ?_, ?_, ?_, fun m => ?_⟩
  · have x := portsRegion j m; simp only [h20, Wire] at *; omega
  · simp only [flagN, h20, Wire] at *; omega
  · simp only [flagF, h20, Wire] at *; omega
  · simp only [flagU, h20, Wire] at *; omega
  · have x := upperSites j m; simp only [h20, Wire] at *; omega

theorem live (j : Fin 9) : FramePorts20 (placement j) j where
  a := (frame_checks_all j).2.2.2.1
  bSites := (frame_checks_all j).2.2.2.2.1
  prev := (frame_checks_all j).2.2.2.2.2.1
  carry := by
    intro q hq
    let v := windowNet20 j q
    have h : v ∈ carryPorts j := List.mem_map.mpr ⟨q, hq, rfl⟩
    rw [parts j, List.mem_append] at h
    rcases h with h | h
    · exact Or.inl h
    · have absent : v ∉ guarded j := fun inc => clearCover j v inc h
      simp only [guarded, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or] at absent
      exact Or.inr ⟨notWire j absent.1.1, sourceCover j _ h, absent.1.2.1, absent.1.2.2.1,
        absent.1.2.2.2, absent.2⟩
  ext := fun r => ⟨notWire j ((frame_checks_all j).2.2.2.2.2.2 r).1, ((frame_checks_all j).2.2.2.2.2.2 r).2⟩
  hist := fun r => let h := frameHist j r; ⟨notWire j h.1, h.2⟩

theorem ready_from_cut_at (j : Fin 9) (raw v : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (sbP20 (start20 j)) 20 z)
    (p : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (sbP20 (start20 j)) 20 z))
      (decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
      (pullState (pull j) raw) v)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (hist : ∀ r : Fin 20, raw.basis (pull j (windowNet20 j (IntegerPacket.ports (shape20 j) r).history)) = false) :
    let t := run (enterP20 j) m v
    let T := Shadow.reduced (sbP20 (start20 j)) 20 z
    t.phase = v.phase ∧ onRails20 j 0 (SkywalkRails.encode G S T.u T.v) t.basis := by
  obtain ⟨ph, body, outer⟩ := from_full j raw v z G S m small p input
  exact ⟨ph, complete20 (live j) z G S small raw v _ p input body outer hist⟩

def zeroSites20 (j : Fin 9) : List Wire :=
  let p := shape20 j
  let L := IntegerPacket.ports p 0
  (L.a ++ L.b ++ [L.previous] ++ L.carry ++
    ((List.range' 0 20).flatMap fun r => [(IntegerPacket.ports p r).ext, (IntegerPacket.ports p r).history]) ++
    [(IntegerPacket.ports p 0).a0, (IntegerPacket.ports p 0).history]).map (windowNet20 j)

theorem zero_congr20 (j : Fin 9) (s t : State) (agree : ∀ q ∈ zeroSites20 j, t.basis q = s.basis q)
    (z : SkywalkRails.State) (active : onRails20 j 0 z s.basis) :
    onRails20 j 0 z t.basis ∧
    cell (shape20 j) 0 (mappedBasis20 j t.basis) = cell (shape20 j) 0 (mappedBasis20 j s.basis) := by
  let p := shape20 j
  let L := IntegerPacket.ports p 0
  let S := mappedBasis20 j s.basis
  let T := mappedBasis20 j t.basis
  have locality (q : Wire)
      (mem : q ∈ L.a ++ L.b ++ [L.previous] ++ L.carry ++
        ((List.range' 0 20).flatMap fun r => [(IntegerPacket.ports p r).ext, (IntegerPacket.ports p r).history]) ++
        [(IntegerPacket.ports p 0).a0, (IntegerPacket.ports p 0).history]) :
      T q = S q := agree _ (List.mem_map.mpr ⟨q, mem, rfl⟩)
  have add (xs : List Wire) (incl : ∀ q ∈ xs, T q = S q) : signedRegValue xs T = signedRegValue xs S := by
    unfold signedRegValue; rw [regValue_congr _ _ _ incl]
  obtain ⟨a, b, prev, carry, free⟩ := active
  refine ⟨⟨(add _ (fun q h => locality _ (by simp [L, p, h]))).trans a,
    (add _ (fun q h => locality _ (by simp [L, p, h]))).trans b,
    (locality _ (by simp [L, p])).trans prev,
    (regValue_congr _ _ _ (fun q h => locality _ (by simp [L, p, h]))).trans carry, ?_⟩, ?_⟩
  · intro r hr last
    have inRange : r ∈ List.range' 0 20 := by rw [List.mem_range'_1]; exact ⟨hr, last⟩
    obtain ⟨e, h⟩ := free r hr last
    exact ⟨(locality _ (by simp only [List.mem_append]; left; right; apply List.mem_flatMap.mpr; exact ⟨r, inRange, by simp [p]⟩)).trans e,
      (locality _ (by simp only [List.mem_append]; left; right; apply List.mem_flatMap.mpr; exact ⟨r, inRange, by simp [p]⟩)).trans h⟩
  · exact Prod.ext (locality _ (by simp [L, p])) (locality _ (by simp [L, p]))

theorem avoid_enter (j : Fin 9) : ∀ q ∈ pending j, q ∉ wires (enterP20 j) := by
  have f := frame j
  intro q hq
  apply notWire j
  intro hp
  have r := portsRegion j hp
  simp only [pending, List.mem_cons, List.not_mem_nil, or_false] at hq
  simp only [Wire] at *
  omega

private theorem zeroBand_all : ∀ j : Fin 9,
    (zeroSites20 j).all (fun q => decide (q < h20 j + 1580 ∨ h20 j + 1583 ≤ q)) = true := by
  decide +kernel

theorem avoid_live (j : Fin 9) : ∀ q ∈ pending j, q ∉ zeroSites20 j := by
  intro q hq hz
  have b := of_decide_eq_true (List.all_eq_true.mp (zeroBand_all j) q hz)
  simp only [pending, List.mem_cons, List.not_mem_nil, or_false] at hq
  simp only [Wire] at *
  omega

theorem ready_pending_at (j : Fin 9) (raw pre : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (sbP20 (start20 j)) 20 z)
    (cut : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (sbP20 (start20 j)) 20 z))
      (decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
      (pullState (pull j) raw) (eraseSites (pending j) pre))
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (hist : ∀ r : Fin 20, raw.basis (pull j (windowNet20 j (IntegerPacket.ports (shape20 j) r).history)) = false) :
    let t := run (enterP20 j) m pre
    let T := Shadow.reduced (sbP20 (start20 j)) 20 z
    t.phase = pre.phase ∧ onRails20 j 0 (SkywalkRails.encode G S T.u T.v) t.basis ∧
      ∀ q ∈ pending j, t.basis q = pre.basis q := by
  have eq := erase_run (pending j) (enterP20 j) (avoid_enter j) m pre
  have real := ready_from_cut_at j raw (eraseSites (pending j) pre) z G S m small cut input hist
  rw [eq] at real
  refine ⟨real.1, (zero_congr20 j _ _ ?_ _ real.2).1,
    fun q mem => run_preserves_outside _ m pre _ (avoid_enter j _ mem)⟩
  intro q used
  have absent : q ∉ pending j := fun h => avoid_live j _ h used
  simp [eraseSites, absent]

private theorem high_all : ∀ j : Fin 9,
    ((upperTail j).map Prod.fst).map (pull j) = (lay j).a.drop (sbP20 (start20 j) + 23) ∧
    ((upperTail j).map Prod.snd).map (pull j) = (lay j).b.drop (sbP20 (start20 j) + 23) ∧
    sbP20 (start20 j) + 23 ≤ (lay j).a.length ∧
    sbP20 (start20 j) + 23 ≤ (lay j).b.length := by
  decide +kernel

theorem tail_sub (j : Fin 9) : ∀ p ∈ upperTail j, p ∈ upperPairs j := by
  intro p hp
  unfold upperTail at hp; unfold upperPairs
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp
  rw [List.mem_range] at hi
  refine List.mem_map.mpr ⟨i + 1, List.mem_range.mpr (by omega), ?_⟩
  exact congrArg₂ Prod.mk (by (try simp only [Wire] at *); omega) (by (try simp only [Wire] at *); omega)

theorem savedLive (j : Fin 9) : ∀ q ∈ (upperTail j).map Prod.snd, q ∉ ports j := by
  have f := frame j
  intro q hq hp
  simp only [upperTail, List.map_map, List.mem_map, List.mem_range, Function.comp] at hq
  obtain ⟨i, hi, rfl⟩ := hq
  have r := portsRegion j hp
  simp only [Wire] at *
  omega

attribute [local irreducible] run in
theorem high_from_cut (j : Fin 9) (raw cut : State) (z : SkywalkNat.State) (G S : Bool) (m : List Bool)
    (small : Shadow7.SmallIfFar (sbP20 (start20 j)) 20 z)
    (packed : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (sbP20 (start20 j)) 20 z))
      (decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
      (pullState (pull j) raw) cut)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis) :
    regValue (saved j) (run (enterP20 j) m cut).basis =
      if Shadow.far (sbP20 (start20 j)) 20 z then Shadow.high (sbP20 (start20 j)) 20 z else 0 := by
  have high := EnterProof17.stored_sub (upperTail j) (tail_sub j) (sbP20 (start20 j) + 23)
    raw cut z G S packed input (layout j).g0
    (high_all j).1 (high_all j).2.1 (high_all j).2.2.1 (high_all j).2.2.2
  obtain ⟨_, bits, outer⟩ := from_full j raw cut z G S m small packed input
  have bulk := regValue_congr ((upperTail j).map Prod.snd) (run (enterP20 j) m cut).basis cut.basis
    (fun q hit => outer q (notWire j (savedLive j q hit)))
  apply EnterProof17.assemble (sbP20 (start20 j)) 20 z G S _ (h20 j + 1574) (h20 j + 1575) (h20 j + 1576) _
  · exact bits 9 (by rw [EnterProof17.forward_all]; decide)
  · exact bits 10 (by rw [EnterProof17.forward_all]; decide)
  · exact bits 11 (by rw [EnterProof17.forward_all]; decide)
  · exact bulk.trans high

attribute [local irreducible] run in
theorem return_packed (j : Fin 9) (raw cut : State) (z : SkywalkNat.State) (G S : Bool)
    (small : Shadow7.SmallIfFar (sbP20 (start20 j)) 20 z)
    (packed : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (sbP20 (start20 j)) 20 z))
      (decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
      (pullState (pull j) raw) cut)
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (m t : List Bool) :
    run (enterInvP20 j) t (run (enterP20 j) m cut) = cut :=
  EnterProof17.return_packed (layout j) (map j) (enterP20 j) (enterInvP20 j)
    (inc j) (fun _ => rfl) (ports_length j) (emitted j) (emittedInv j)
    raw cut z G S small packed input m t

theorem avoid_enterInv (j : Fin 9) : ∀ q ∈ pending j, q ∉ wires (enterInvP20 j) := by
  have sup : wires EnterProof17.forward = wires EnterProof17.backward := by decide +kernel
  have wsame : wires (enterInvP20 j) = wires (enterP20 j) := by
    rw [emittedInv j, emitted j, renameProgram_support, renameProgram_support, sup]
  rw [wsame]
  exact avoid_enter j

attribute [local irreducible] run in
theorem return_pending (j : Fin 9) (raw pre : State) (z : SkywalkNat.State) (G S : Bool)
    (small : Shadow7.SmallIfFar (sbP20 (start20 j)) 20 z)
    (packed : PackedCut (lowerPairs j) (upperPairs j) (gate j) (flagN j) (flagF j) (flagU j)
      (PortalValues.negative S z.u) (decide (Shadow.far (sbP20 (start20 j)) 20 z))
      (decide (Shadow.far (sbP20 (start20 j)) 20 z ∧ 2 ^ sbP20 (start20 j) ≤ z.u))
      (pullState (pull j) raw) (eraseSites (pending j) pre))
    (input : SkywalkIntegerInput (lay j) (SkywalkRails.encode G S z.u z.v).a
      (SkywalkRails.encode G S z.u z.v).b G raw.basis)
    (m t : List Bool) :
    run (enterInvP20 j) t (run (enterP20 j) m pre) = pre := by
  have hret := return_packed j raw (eraseSites (pending j) pre) z G S small packed input m t
  rw [erase_run (pending j) (enterP20 j) (avoid_enter j) m pre,
    erase_run (pending j) (enterInvP20 j) (avoid_enterInv j) t _] at hret
  apply State.extensionality _ _ (by simpa [eraseSites] using congrArg State.phase hret)
  funext q
  by_cases hp : q ∈ pending j
  · rw [run_preserves_outside _ t _ q (avoid_enterInv j q hp),
      run_preserves_outside _ m _ q (avoid_enter j q hp)]
  · have hq := congrArg (fun st : State => st.basis q) hret
    simpa only [eraseSites, if_neg hp] using hq

end EnterJ20

/-! ### Section 2: 20-Tick Archive Codec (`ArchiveJ20`) -/

namespace ArchiveJ20

open ECDSAAdd.Entrant.StairArchiveIntegerHook
open ECDSAAdd.Entrant.CodecBitSliceVerify
open ECDSAAdd.Entrant.StairPacket.ArchiveJ

set_option maxRecDepth 30000
set_option maxHeartbeats 5000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def endTick (j : Fin 9) : Nat := start20 j + 20
def flagBase (j : Fin 9) : Nat := nextE0_20 (start20 j) + 6

def rawHead (j : Fin 9) : List Wire :=
  cellsLoadP (endTick j) ++ [flagBase j, flagBase j + 1, flagBase j + 2]

def scratch (j : Fin 9) : List Wire :=
  (List.range 134).map (archScratch20 (start20 j))

def rawPortsList (j : Fin 9) : List Wire :=
  loadPorts20 (start20 j) ++ [archScratch20 (start20 j) 132, archScratch20 (start20 j) 133]

def rawPorts (j : Fin 9) (q : Fin 157) : Wire := (rawPortsList j).getD q 0

def codeTail (j : Fin 9) : List Wire :=
  [OB5.sig (endTick j) (endTick j + 1036), OB5.sig (endTick j) (endTick j + 1038),
   OB5.sig (endTick j) (endTick j + 1041), OB5.sig (endTick j) (endTick j + 1043),
   flagBase j, flagBase j + 1, flagBase j + 2]

def codePortsList (j : Fin 9) : List Wire :=
  restorePorts20 (start20 j) ++ codeTail j

def codePorts (j : Fin 9) (q : Fin 157) : Wire := (codePortsList j).getD q 0

def loadMap (j : Fin 9) (q : Wire) : Wire := (loadPorts20 (start20 j)).getD q 0
def restoreMap (j : Fin 9) (q : Wire) : Wire := (restorePorts20 (start20 j)).getD q 0

def loadMoves (j : Fin 9) : List (Wire × Wire) := (moveLoadPairs (endTick j)).map Prod.swap
def restoreMoves (j : Fin 9) : List (Wire × Wire) := (moveRestorePairs (endTick j) (flagBase j)).map Prod.swap

def Band (j : Fin 9) (q : Nat) : Prop :=
  q < 1556 ∨ 1700 ≤ q ∨ (nextE0_20 (start20 j) ≤ q ∧ q < nextE0_20 (start20 j) + 10)

instance (j : Fin 9) (q : Nat) : Decidable (Band j q) := by unfold Band; infer_instance

private theorem scratch_inj (j : Fin 9) {a b : Nat}
    (e : archScratch20 (start20 j) a = archScratch20 (start20 j) b) : a = b := by
  unfold archScratch20 at e; dsimp only at e; split_ifs at e <;> (unfold Wire at *; omega)

theorem band_off (j : Fin 9) {q k : Nat} (hk : k < 134) (h : Band j q) :
    archScratch20 (start20 j) k ≠ q := by
  unfold archScratch20; dsimp only
  rcases h with h | h | ⟨h1, h2⟩ <;> split_ifs <;> (unfold Wire at *; omega)

theorem rawLength (j : Fin 9) : (rawPortsList j).length = 157 := by
  simp [rawPortsList, loadPorts20, cellsLoadP]

theorem codeLength (j : Fin 9) : (codePortsList j).length = 157 := by
  simp [codePortsList, restorePorts20, cellsRestoreP, codeTail]

theorem raw_split (j : Fin 9) : rawPortsList j = rawHead j ++ scratch j := by
  simp only [rawPortsList, rawHead, scratch, loadPorts20, endTick, flagBase, List.append_assoc]
  rw [range_two]

theorem code_split (j : Fin 9) : codePortsList j = cellsRestoreP (endTick j) ++ scratch j ++ codeTail j := by
  simp only [codePortsList, restorePorts20, scratch, endTick]

theorem raw_scratch (j : Fin 9) {k : Nat} (hk : k < 134) :
    (rawPortsList j).getD (23 + k) 0 = archScratch20 (start20 j) k := by
  rw [raw_split, List.getD_append_right _ _ _ _ (by simp [rawHead, cellsLoadP]), scratch]
  have e : 23 + k - (rawHead j).length = k := by simp [rawHead, cellsLoadP]
  rw [e, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk]; rfl

theorem code_scratch (j : Fin 9) {k : Nat} (hk : k < 134) :
    (codePortsList j).getD (16 + k) 0 = archScratch20 (start20 j) k := by
  rw [code_split, List.append_assoc, List.getD_append_right _ _ _ _ (by simp [cellsRestoreP])]
  have e : 16 + k - (cellsRestoreP (endTick j)).length = k := by simp [cellsRestoreP]
  rw [e, List.getD_append _ _ _ _ (by simp [scratch]; exact hk), scratch,
    List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk]; rfl

theorem rawIndex (j : Fin 9) {q : Wire} (h : q ∈ rawPortsList j) : ∃ k : Fin 157, rawPorts j k = q := by
  obtain ⟨n, hn, eq⟩ := List.getElem_of_mem h
  refine ⟨⟨n, (rawLength j) ▸ hn⟩, ?_⟩
  rw [rawPorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hn, Option.getD_some]; exact eq

theorem codeIndex (j : Fin 9) {q : Wire} (h : q ∈ codePortsList j) : ∃ k : Fin 157, codePorts j k = q := by
  obtain ⟨n, hn, eq⟩ := List.getElem_of_mem h
  refine ⟨⟨n, (codeLength j) ▸ hn⟩, ?_⟩
  rw [codePorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hn, Option.getD_some]; exact eq

theorem scratch_nodup (j : Fin 9) : (scratch j).Nodup :=
  List.Nodup.map_on (fun _ _ _ _ h => scratch_inj j h) List.nodup_range

private theorem heads_all : ∀ j : Fin 9,
    (rawHead j).Nodup ∧ (∀ q ∈ rawHead j, Band j q) ∧
    (cellsRestoreP (endTick j) ++ codeTail j).Nodup ∧
    (∀ q ∈ cellsRestoreP (endTick j) ++ codeTail j, Band j q) ∧
    (∀ q ∈ cellsRestoreP (endTick j) ++ codeTail j, q ∈ rawHead j) ∧
    (∀ p ∈ loadMoves j, p.1 ∈ rawHead j ∧ p.2 ∈ rawHead j ∧ p.1 ≠ p.2) ∧
    (∀ p ∈ restoreMoves j, p.1 ≠ p.2 ∧
      (p.1 ∈ cellsRestoreP (endTick j) ++ codeTail j ∨ ∃ c < 7, p.1 = archScratch20 (start20 j) c) ∧
      (p.2 ∈ cellsRestoreP (endTick j) ++ codeTail j ∨ ∃ c < 7, p.2 = archScratch20 (start20 j) c)) := by
  decide +kernel

private theorem routes_head_all : ∀ j : Fin 9, ∀ k : Fin 157,
    ((k.val < 16 ∨ 150 ≤ k.val) → backMap (loadMoves j) (codePorts j k) = rawPorts j (loadRoute k)) ∧
    (k.val < 30 → backMap (restoreMoves j) (rawPorts j k) = codePorts j (restoreRoute k)) := by
  decide +kernel

theorem rawNodup (j : Fin 9) : (rawPortsList j).Nodup := by
  obtain ⟨hn, hb, -⟩ := heads_all j
  rw [raw_split, List.nodup_append]
  refine ⟨hn, scratch_nodup j, fun a ha b hb' eq => ?_⟩
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb'
  exact band_off j (List.mem_range.mp hk) (hb a ha) eq.symm

theorem codeNodup (j : Fin 9) : (codePortsList j).Nodup := by
  obtain ⟨-, -, hn, hb, -⟩ := heads_all j
  rw [code_split, List.nodup_append, List.nodup_append]
  rw [List.nodup_append] at hn
  refine ⟨⟨hn.1, scratch_nodup j, fun a ha b hb' eq => ?_⟩, hn.2.1, fun a ha b hb' eq => ?_⟩
  · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb'
    exact band_off j (List.mem_range.mp hk) (hb a (List.mem_append_left _ ha)) eq.symm
  · rcases List.mem_append.mp ha with ha | ha
    · exact hn.2.2 a ha b hb' eq
    · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp ha
      exact band_off j (List.mem_range.mp hk) (hb b (List.mem_append_right _ hb')) eq

theorem load_unique (j : Fin 9) : Function.Injective (rawPorts j) :=
  injective_list (rawPortsList j) (rawLength j) (rawNodup j)

theorem restore_unique (j : Fin 9) : Function.Injective (codePorts j) :=
  injective_list (codePortsList j) (codeLength j) (codeNodup j)

theorem load_map (j : Fin 9) : ∀ q : Fin 155, loadMap j q = rawPorts j ⟨q, by omega⟩ := by
  intro q; simp only [loadMap, rawPorts, rawPortsList]
  rw [List.getD_append _ _ _ _ (by simp [loadPorts20, cellsLoadP])]

theorem restore_map (j : Fin 9) : ∀ q : Fin 150, restoreMap j q = codePorts j ⟨q, by omega⟩ := by
  intro q; simp only [restoreMap, codePorts, codePortsList]
  rw [List.getD_append _ _ _ _ (by simp [restorePorts20, cellsRestoreP])]

theorem load_route (j : Fin 9) : ∀ k, backMap (loadMoves j) (codePorts j k) = rawPorts j (loadRoute k) := by
  intro k
  by_cases h : k.val < 16 ∨ 150 ≤ k.val
  · exact (routes_head_all j k).1 h
  · have m := (routes_mid k).1 (by omega) (by omega)
    have hc : codePorts j k = archScratch20 (start20 j) (k.val - 16) := by
      have e := code_scratch j (k := k.val - 16) (by omega); rw [show 16 + (k.val - 16) = k.val by omega] at e; exact e
    have hr : rawPorts j (loadRoute k) = archScratch20 (start20 j) (k.val - 16) := by
      have e := raw_scratch j (k := k.val - 16) (by omega); rw [show 23 + (k.val - 16) = k.val + 7 by omega, ← m] at e; exact e
    rw [hc, hr]
    apply backMap_outside
    intro p hp
    obtain ⟨h1, h2, -⟩ := (heads_all j).2.2.2.2.2.1 p hp
    have b := (heads_all j).2.1
    exact ⟨band_off j (by omega) (b _ h1), band_off j (by omega) (b _ h2)⟩

theorem restore_route (j : Fin 9) : ∀ k, backMap (restoreMoves j) (rawPorts j k) = codePorts j (restoreRoute k) := by
  intro k
  by_cases h : k.val < 30
  · exact (routes_head_all j k).2 h
  · have m := (routes_mid k).2 (by omega)
    have hr : rawPorts j k = archScratch20 (start20 j) (k.val - 23) := by
      have e := raw_scratch j (k := k.val - 23) (by omega); rw [show 23 + (k.val - 23) = k.val by omega] at e; exact e
    have hc : codePorts j (restoreRoute k) = archScratch20 (start20 j) (k.val - 23) := by
      have e := code_scratch j (k := k.val - 23) (by omega); rw [show 16 + (k.val - 23) = (restoreRoute k).val by omega] at e; exact e
    rw [hr, hc]
    apply backMap_outside
    intro p hp
    obtain ⟨-, h1, h2⟩ := (heads_all j).2.2.2.2.2.2 p hp
    have b := (heads_all j).2.2.2.1
    have off (q : Wire) (hq : q ∈ cellsRestoreP (endTick j) ++ codeTail j ∨ ∃ c < 7, q = archScratch20 (start20 j) c) :
        archScratch20 (start20 j) (k.val - 23) ≠ q := by
      rcases hq with hq | ⟨c, hc, rfl⟩
      · exact band_off j (by omega) (b _ hq)
      · intro eq; have := scratch_inj j eq; omega
    exact ⟨off _ h1, off _ h2⟩

theorem load_scope (j : Fin 9) : ∀ p ∈ loadMoves j, (∃ k, rawPorts j k = p.1) ∧ (∃ k, rawPorts j k = p.2) := by
  intro p hp
  obtain ⟨h1, h2, -⟩ := (heads_all j).2.2.2.2.2.1 p hp
  exact ⟨rawIndex j (raw_split j ▸ List.mem_append_left _ h1), rawIndex j (raw_split j ▸ List.mem_append_left _ h2)⟩

theorem restore_scope (j : Fin 9) : ∀ p ∈ restoreMoves j, (∃ k, codePorts j k = p.1) ∧ (∃ k, codePorts j k = p.2) := by
  intro p hp
  obtain ⟨-, h1, h2⟩ := (heads_all j).2.2.2.2.2.2 p hp
  have mem (q : Wire) (hq : q ∈ cellsRestoreP (endTick j) ++ codeTail j ∨ ∃ c < 7, q = archScratch20 (start20 j) c) :
      q ∈ codePortsList j := by
    rw [code_split]
    rcases hq with hq | ⟨c, hc, rfl⟩
    · rcases List.mem_append.mp hq with hq | hq
      · exact List.mem_append_left _ (List.mem_append_left _ hq)
      · exact List.mem_append_right _ hq
    · exact List.mem_append_left _ (List.mem_append_right _ (List.mem_map.mpr ⟨c, List.mem_range.mpr (by omega), rfl⟩))
  exact ⟨codeIndex j (mem _ h1), codeIndex j (mem _ h2)⟩

theorem load_program (j : Fin 9) (d : Bool) :
    archiveLoadP20 j d = placed (loadMap j) (op true d) ++ moves (loadMoves j) := by
  cases d <;> rfl

theorem restore_program (j : Fin 9) (d : Bool) :
    archiveRestoreP20 j d = placed (restoreMap j) (op false d) ++ moves (restoreMoves j) := by
  cases d <;> rfl

theorem load_run (j : Fin 9) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame (rawPorts j) (startCols true d) row s) :
    let t := run (archiveLoadP20 j d) m s
    t.phase = s.phase ∧ Frame (codePorts j) (endCols true d) row t ∧
      ∀ q, (∀ k, rawPorts j k ≠ q) → t.basis q = s.basis q := by
  rw [load_program]
  apply packet true d (rawPorts j) (codePorts j) (loadMap j) (loadMoves j) loadRoute
    (load_unique j) _ (fun p hp => ((heads_all j).2.2.2.2.2.1 p hp).2.2)
    (load_route j) load_sort (load_scope j) row hr s m ready
  intro q h
  have lim : q < 155 := by cases d <;> exact h
  exact ⟨⟨q, by omega⟩, rfl, load_map j ⟨q, lim⟩⟩

theorem restore_run (j : Fin 9) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame (codePorts j) (startCols false d) row s) :
    let t := run (archiveRestoreP20 j d) m s
    t.phase = s.phase ∧ Frame (rawPorts j) (endCols false d) row t ∧
      ∀ q, (∀ k, codePorts j k ≠ q) → t.basis q = s.basis q := by
  rw [restore_program]
  apply packet false d (codePorts j) (rawPorts j) (restoreMap j) (restoreMoves j) restoreRoute
    (restore_unique j) _ (fun p hp => ((heads_all j).2.2.2.2.2.2 p hp).1)
    (restore_route j) restore_sort (restore_scope j) row hr s m ready
  intro q h
  have lim : q < 150 := by cases d <;> exact h
  exact ⟨⟨q, by omega⟩, rfl, restore_map j ⟨q, lim⟩⟩

theorem code_from_raw (j : Fin 9) : ∀ k, ∃ m, rawPorts j m = codePorts j k := by
  intro k
  have sub := (heads_all j).2.2.2.2.1
  have mem : codePorts j k ∈ codePortsList j := by
    rw [codePorts, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem ((codeLength j).symm ▸ k.isLt), Option.getD_some]
    exact List.getElem_mem _
  apply rawIndex j; rw [raw_split]; rw [code_split] at mem
  rcases List.mem_append.mp mem with mem | mem
  · rcases List.mem_append.mp mem with mem | mem
    · exact List.mem_append_left _ (sub _ (List.mem_append_left _ mem))
    · exact List.mem_append_right _ mem
  · exact List.mem_append_left _ (sub _ (List.mem_append_right _ mem))

theorem roundtrip (j : Fin 9) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m n : List Bool)
    (ready : Frame (rawPorts j) raw row s) :
    run (archiveRestoreP20 j d) n (run (archiveLoadP20 j d) m s) = s := by
  have f := load_run j d row hr s m ready
  have b := restore_run j d row hr _ n f.2.1
  apply state_eq
  · exact b.1.trans f.1
  · intro q
    by_cases h : ∃ k, rawPorts j k = q
    · obtain ⟨k, rfl⟩ := h
      exact (b.2.1 k).trans (ready k).symm
    · have no : ∀ k, rawPorts j k ≠ q := fun k eq => h ⟨k, eq⟩
      have noc : ∀ k, codePorts j k ≠ q := fun k => by obtain ⟨m, eq⟩ := code_from_raw j k; exact eq ▸ no m
      exact (b.2.2 q noc).trans (f.2.2 q no)

theorem head_port_eq (j : Fin 9) (i : Fin 16) :
    codePorts j ⟨i.val, by omega⟩ = (cellsRestoreP (endTick j)).getD i.val 0 := by
  rw [codePorts, code_split, List.append_assoc,
    List.getD_append _ _ _ _ (by simp [cellsRestoreP])]

theorem kept_of_frame (j : Fin 9) (d : Bool) (row : Nat) (s : State)
    (h : Frame (codePorts j) (endCols true d) row s) :
    Kept (codePorts j) d row s :=
  fun i => by cases d <;> exact h ⟨i.val, by omega⟩

end ArchiveJ20

/-! ### Section 3: Transition Archive `s = 150 -> 165` (`Archive150`) -/

namespace Archive150

open ECDSAAdd.Entrant.StairArchiveIntegerHook
open ECDSAAdd.Entrant.CodecBitSliceVerify
open ECDSAAdd.Entrant.StairPacket.ArchiveJ

set_option maxRecDepth 30000
set_option maxHeartbeats 5000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

def flagBase : Nat := e0P20 165 + 6

def rawHead : List Wire := cellsLoadP 165 ++ [flagBase, flagBase + 1, flagBase + 2]
def scratch : List Wire := (List.range 134).map archScratch150
def rawPortsList : List Wire := loadPorts150 ++ [archScratch150 132, archScratch150 133]
def rawPorts (q : Fin 157) : Wire := rawPortsList.getD q 0

def codeTail : List Wire :=
  [OB5.sig 165 (165 + 1036), OB5.sig 165 (165 + 1038),
   OB5.sig 165 (165 + 1041), OB5.sig 165 (165 + 1043),
   flagBase, flagBase + 1, flagBase + 2]

def codePortsList : List Wire := restorePorts150 ++ codeTail
def codePorts (q : Fin 157) : Wire := codePortsList.getD q 0

def loadMap (q : Wire) : Wire := loadPorts150.getD q 0
def restoreMap (q : Wire) : Wire := restorePorts150.getD q 0
def loadMoves : List (Wire × Wire) := (moveLoadPairs 165).map Prod.swap
def restoreMoves : List (Wire × Wire) := (moveRestorePairs 165 flagBase).map Prod.swap

private theorem arch150_band (k : Nat) (hk : k < 134) : archScratch150 k = 1556 + k := by
  unfold archScratch150 e0P20 sbP20; rw [if_pos (by omega)]

theorem rawLength : rawPortsList.length = 157 := by simp [rawPortsList, loadPorts150, cellsLoadP]
theorem codeLength : codePortsList.length = 157 := by simp [codePortsList, restorePorts150, cellsRestoreP, codeTail]

theorem raw_split : rawPortsList = rawHead ++ scratch := by
  simp only [rawPortsList, rawHead, scratch, loadPorts150, flagBase, List.append_assoc]; rw [range_two]

theorem code_split : codePortsList = cellsRestoreP 165 ++ scratch ++ codeTail := by
  simp only [codePortsList, restorePorts150, scratch]

theorem raw_scratch {k : Nat} (hk : k < 134) : rawPortsList.getD (23 + k) 0 = archScratch150 k := by
  rw [raw_split, List.getD_append_right _ _ _ _ (by simp [rawHead, cellsLoadP]), scratch]
  have e : 23 + k - rawHead.length = k := by simp [rawHead, cellsLoadP]
  rw [e, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk]; rfl

theorem code_scratch {k : Nat} (hk : k < 134) : codePortsList.getD (16 + k) 0 = archScratch150 k := by
  rw [code_split, List.append_assoc, List.getD_append_right _ _ _ _ (by simp [cellsRestoreP])]
  have e : 16 + k - (cellsRestoreP 165).length = k := by simp [cellsRestoreP]
  rw [e, List.getD_append _ _ _ _ (by simp [scratch]; exact hk), scratch,
    List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk]; rfl

private theorem heads_ok :
    rawHead.Nodup ∧ (∀ q ∈ rawHead, q < 1556 ∨ 1700 ≤ q) ∧
    (cellsRestoreP 165 ++ codeTail).Nodup ∧
    (∀ q ∈ cellsRestoreP 165 ++ codeTail, q < 1556 ∨ 1700 ≤ q) ∧
    (∀ q ∈ cellsRestoreP 165 ++ codeTail, q ∈ rawHead) ∧
    (∀ p ∈ loadMoves, p.1 ∈ rawHead ∧ p.2 ∈ rawHead ∧ p.1 ≠ p.2) ∧
    (∀ p ∈ restoreMoves, p.1 ≠ p.2 ∧
      (p.1 ∈ cellsRestoreP 165 ++ codeTail ∨ ∃ c < 7, p.1 = archScratch150 c) ∧
      (p.2 ∈ cellsRestoreP 165 ++ codeTail ∨ ∃ c < 7, p.2 = archScratch150 c)) := by
  decide +kernel

private theorem routes_head_ok : ∀ k : Fin 157,
    ((k.val < 16 ∨ 150 ≤ k.val) → backMap loadMoves (codePorts k) = rawPorts (loadRoute k)) ∧
    (k.val < 30 → backMap restoreMoves (rawPorts k) = codePorts (restoreRoute k)) := by
  decide +kernel

theorem rawNodup : rawPortsList.Nodup := by
  obtain ⟨hn, hb, -⟩ := heads_ok
  rw [raw_split, List.nodup_append]
  refine ⟨hn, List.Nodup.map_on (fun a ha b hb' e => by
      rw [arch150_band a (List.mem_range.mp ha), arch150_band b (List.mem_range.mp hb')] at e
      unfold Wire at *; omega) List.nodup_range,
    fun a ha b hb' eq => ?_⟩
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb'
  have hlt := List.mem_range.mp hk
  have eb := arch150_band k hlt
  have ha' := hb a ha
  rw [eb] at eq; unfold Wire at *; omega

theorem codeNodup : codePortsList.Nodup := by
  obtain ⟨-, -, hn, hb, -⟩ := heads_ok
  rw [code_split, List.nodup_append, List.nodup_append]
  rw [List.nodup_append] at hn
  have snd : scratch.Nodup := List.Nodup.map_on (fun a ha b hb' e => by
      rw [arch150_band a (List.mem_range.mp ha), arch150_band b (List.mem_range.mp hb')] at e
      unfold Wire at *; omega) List.nodup_range
  refine ⟨⟨hn.1, snd, fun a ha b hb' eq => ?_⟩, hn.2.1, fun a ha b hb' eq => ?_⟩
  · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hb'
    have hlt := List.mem_range.mp hk
    have eb := arch150_band k hlt
    have ha' := hb a (List.mem_append_left _ ha)
    rw [eb] at eq; unfold Wire at *; omega
  · rcases List.mem_append.mp ha with ha | ha
    · exact hn.2.2 a ha b hb' eq
    · obtain ⟨k, hk, rfl⟩ := List.mem_map.mp ha
      have hlt := List.mem_range.mp hk
      have eb := arch150_band k hlt
      have hb' := hb b (List.mem_append_right _ hb')
      rw [eb] at eq; unfold Wire at *; omega

theorem load_unique : Function.Injective rawPorts := injective_list rawPortsList rawLength rawNodup
theorem restore_unique : Function.Injective codePorts := injective_list codePortsList codeLength codeNodup

theorem rawIndex {q : Wire} (h : q ∈ rawPortsList) : ∃ k : Fin 157, rawPorts k = q := by
  obtain ⟨n, hn, eq⟩ := List.getElem_of_mem h
  refine ⟨⟨n, rawLength ▸ hn⟩, ?_⟩
  rw [rawPorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hn, Option.getD_some]; exact eq

theorem codeIndex {q : Wire} (h : q ∈ codePortsList) : ∃ k : Fin 157, codePorts k = q := by
  obtain ⟨n, hn, eq⟩ := List.getElem_of_mem h
  refine ⟨⟨n, codeLength ▸ hn⟩, ?_⟩
  rw [codePorts, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hn, Option.getD_some]; exact eq

theorem load_route : ∀ k, backMap loadMoves (codePorts k) = rawPorts (loadRoute k) := by
  intro k
  by_cases h : k.val < 16 ∨ 150 ≤ k.val
  · exact (routes_head_ok k).1 h
  · have m := (routes_mid k).1 (by omega) (by omega)
    have hc : codePorts k = archScratch150 (k.val - 16) := by
      have e := code_scratch (k := k.val - 16) (by omega); rw [show 16 + (k.val - 16) = k.val by omega] at e; exact e
    have hr : rawPorts (loadRoute k) = archScratch150 (k.val - 16) := by
      have e := raw_scratch (k := k.val - 16) (by omega); rw [show 23 + (k.val - 16) = k.val + 7 by omega, ← m] at e; exact e
    rw [hc, hr, arch150_band _ (by omega)]
    apply backMap_outside
    intro p hp
    obtain ⟨h1, h2, -⟩ := heads_ok.2.2.2.2.2.1 p hp
    have b1 := heads_ok.2.1 _ h1; have b2 := heads_ok.2.1 _ h2
    exact ⟨by unfold Wire at *; omega, by unfold Wire at *; omega⟩

theorem restore_route : ∀ k, backMap restoreMoves (rawPorts k) = codePorts (restoreRoute k) := by
  intro k
  by_cases h : k.val < 30
  · exact (routes_head_ok k).2 h
  · have m := (routes_mid k).2 (by omega)
    have hr : rawPorts k = archScratch150 (k.val - 23) := by
      have e := raw_scratch (k := k.val - 23) (by omega); rw [show 23 + (k.val - 23) = k.val by omega] at e; exact e
    have hc : codePorts (restoreRoute k) = archScratch150 (k.val - 23) := by
      have e := code_scratch (k := k.val - 23) (by omega); rw [show 16 + (k.val - 23) = (restoreRoute k).val by omega] at e; exact e
    rw [hr, hc, arch150_band _ (by omega)]
    apply backMap_outside
    intro p hp
    obtain ⟨-, h1, h2⟩ := heads_ok.2.2.2.2.2.2 p hp
    have off (q : Wire) (hq : q ∈ cellsRestoreP 165 ++ codeTail ∨ ∃ c < 7, q = archScratch150 c) :
        (1556 + (k.val - 23) : Wire) ≠ q := by
      rcases hq with hq | ⟨c, hc, rfl⟩
      · have b := heads_ok.2.2.2.1 _ hq; unfold Wire at *; omega
      · rw [arch150_band c (by omega)]; unfold Wire at *; omega
    exact ⟨off _ h1, off _ h2⟩

theorem load_run (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame rawPorts (startCols true d) row s) :
    let t := run (archiveLoad150To20 d) m s
    t.phase = s.phase ∧ Frame codePorts (endCols true d) row t ∧
      ∀ q, (∀ k, rawPorts k ≠ q) → t.basis q = s.basis q := by
  have hprog : archiveLoad150To20 d = placed loadMap (op true d) ++ moves loadMoves := by cases d <;> rfl
  rw [hprog]
  apply packet true d rawPorts codePorts loadMap loadMoves loadRoute load_unique _
    (fun p hp => (heads_ok.2.2.2.2.2.1 p hp).2.2) load_route load_sort
    (fun p hp => by
      obtain ⟨h1, h2, -⟩ := heads_ok.2.2.2.2.2.1 p hp
      exact ⟨rawIndex (raw_split ▸ List.mem_append_left _ h1), rawIndex (raw_split ▸ List.mem_append_left _ h2)⟩)
    row hr s m ready
  intro q h
  have lim : q < 155 := by cases d <;> exact h
  refine ⟨⟨q, by omega⟩, rfl, ?_⟩
  simp only [loadMap, rawPorts, rawPortsList]
  rw [List.getD_append _ _ _ _ (by simp [loadPorts150, cellsLoadP]; exact lim)]

theorem restore_run (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame codePorts (startCols false d) row s) :
    let t := run (archiveRestore150To20 d) m s
    t.phase = s.phase ∧ Frame rawPorts (endCols false d) row t ∧
      ∀ q, (∀ k, codePorts k ≠ q) → t.basis q = s.basis q := by
  have hprog : archiveRestore150To20 d = placed restoreMap (op false d) ++ moves restoreMoves := by cases d <;> rfl
  rw [hprog]
  apply packet false d codePorts rawPorts restoreMap restoreMoves restoreRoute restore_unique _
    (fun p hp => (heads_ok.2.2.2.2.2.2 p hp).1) restore_route restore_sort
    (fun p hp => by
      obtain ⟨-, h1, h2⟩ := heads_ok.2.2.2.2.2.2 p hp
      have mem (q : Wire) (hq : q ∈ cellsRestoreP 165 ++ codeTail ∨ ∃ c < 7, q = archScratch150 c) :
          q ∈ codePortsList := by
        rw [code_split]
        rcases hq with hq | ⟨c, hc, rfl⟩
        · rcases List.mem_append.mp hq with hq | hq
          · exact List.mem_append_left _ (List.mem_append_left _ hq)
          · exact List.mem_append_right _ hq
        · exact List.mem_append_left _ (List.mem_append_right _ (List.mem_map.mpr ⟨c, List.mem_range.mpr (by omega), rfl⟩))
      exact ⟨codeIndex (mem _ h1), codeIndex (mem _ h2)⟩)
    row hr s m ready
  intro q h
  have lim : q < 150 := by cases d <;> exact h
  refine ⟨⟨q, by omega⟩, rfl, ?_⟩
  simp only [restoreMap, codePorts, codePortsList]
  rw [List.getD_append _ _ _ _ (by simp [restorePorts150, cellsRestoreP]; exact lim)]

theorem code_from_raw : ∀ k, ∃ m, rawPorts m = codePorts k := by
  intro k
  have sub := heads_ok.2.2.2.2.1
  have mem : codePorts k ∈ codePortsList := by
    rw [codePorts, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem (codeLength.symm ▸ k.isLt), Option.getD_some]
    exact List.getElem_mem _
  apply rawIndex; rw [raw_split]; rw [code_split] at mem
  rcases List.mem_append.mp mem with mem | mem
  · rcases List.mem_append.mp mem with mem | mem
    · exact List.mem_append_left _ (sub _ (List.mem_append_left _ mem))
    · exact List.mem_append_right _ mem
  · exact List.mem_append_left _ (sub _ (List.mem_append_right _ mem))

theorem roundtrip (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m n : List Bool)
    (ready : Frame rawPorts raw row s) :
    run (archiveRestore150To20 d) n (run (archiveLoad150To20 d) m s) = s := by
  have f := load_run d row hr s m ready
  have b := restore_run d row hr _ n f.2.1
  apply state_eq
  · exact b.1.trans f.1
  · intro q
    by_cases h : ∃ k, rawPorts k = q
    · obtain ⟨k, rfl⟩ := h
      exact (b.2.1 k).trans (ready k).symm
    · have no : ∀ k, rawPorts k ≠ q := fun k eq => h ⟨k, eq⟩
      have noc : ∀ k, codePorts k ≠ q := fun k => by obtain ⟨m, eq⟩ := code_from_raw k; exact eq ▸ no m
      exact (b.2.2 q noc).trans (f.2.2 q no)

theorem head_port_eq (i : Fin 16) : codePorts ⟨i.val, by omega⟩ = (cellsRestoreP 165).getD i.val 0 := by
  rw [codePorts, code_split, List.append_assoc,
    List.getD_append _ _ _ _ (by simp [cellsRestoreP])]

theorem kept_of_frame (d : Bool) (row : Nat) (s : State)
    (h : Frame codePorts (endCols true d) row s) :
    Kept codePorts d row s :=
  fun i => by cases d <;> exact h ⟨i.val, by omega⟩

end Archive150

end ECDSAAdd.Entrant.StairPacket.Shadow20
end

section

/-!
# 22-Bank Mixed-Window Stock & Field Geometry (`MixedGeo`, `MixedArchiveSuffix`)

Replaces uniform 25-bank `StockWindowGeo` / `ArchiveStockSuffixW` geometry for the
mixed 15/20-tick window over ticks `[45, 420]`:
- **22 field archive banks**:
  `bankList = [10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 70, 73, 76, 79, 82]`
  covering `44` archived 5-tick groups (`packed`) and `32` plain 5-tick groups (`plain`)
  partitioning all `76` five-tick groups in `[40, 420)`.
- Every bank `b : Fin 22` has:
  - `groupId b = bankList.getD b.val 0`,
  - `bankTick b = 5 * groupId b - 5` (chronology start tick for `ArchiveStockRows.Chronology`),
  - `endTick b = 5 * groupId b + 10` (archive tick; 10 archived ticks `[5 * groupId b, endTick b)`),
  - `bankSite b j = (Partial.cellsRestoreP (endTick b)).getD j 0`,
  - exact port identity with `StairArchiveRelease.fieldPort (groupId b)`, `ArchiveJ7`/`Archive150`/`ArchiveJ20`/`ExitPorts420`,
    `Stair44WalkMap.rest`, `Rolling1588Lifetime.phaseHost`, and `NewHistory5.payloadWire`.
- `MixedArchiveSuffix`: proves all 22 archive banks (`352` cells) are untouched by the stock
  forward/reverse suffix ticks `[421, 512)`.
-/

namespace ECDSAAdd.Entrant.StairPacket.Shadow20.MixedGeo

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Partial
open ECDSAAdd.Entrant.StairPacket.ArchivePortAction

set_option maxRecDepth 25000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

/-- The 22 active field archive banks for the mixed 15/20-tick `[45, 420]` window. -/
def bankList : List Nat :=
  [10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 70, 73, 76, 79, 82]

abbrev Bank := Fin 22

def groupId (b : Bank) : Nat := bankList.getD b.val 0

/-- Chronology start tick (`5 * groupId b - 5`) matching `ArchiveStockRows.Chronology`. -/
def bankTick (b : Bank) : Nat := 5 * groupId b - 5

/-- Archive restoration tick (`5 * groupId b + 10`; archived 10 ticks are `[5 * groupId b, endTick b)`). -/
def endTick (b : Bank) : Nat := 5 * groupId b + 10

/-- Start tick of 5-tick pack group `i ∈ 0..75` over `[40, 420)`. -/
def gstart (i : Nat) : Nat := 40 + 5 * i

def slot (i : Nat) : Fin 10 → Wire := History5.historyMap base (gstart i)

/-- The 44 archived 5-tick groups (2 per bank: `groupId b - 8` and `groupId b - 7`). -/
def packed : List Nat :=
  (List.finRange 22).flatMap fun b => [groupId b - 8, groupId b - 7]

/-- The 32 plain 5-tick groups packed natively by the mixed window. -/
def plain : List Nat :=
  (List.range 76).filter fun i => !packed.contains i

/-- The 88 erased B-side hole wires (letters 5 and 9 of each archived group). -/
def holes : List Wire :=
  packed.flatMap fun i => [base (1028 + gstart i + 2), base (1028 + gstart i + 4)]

def logical (sw : Bool) (r : Nat) : Wire := if sw then base (1028 + r) else base r
def site (e : Nat) (sw : Bool) (r : Nat) : Wire := OB5.sig e (logical sw r)
def offset (j : Fin 16) : Nat := 5 * (j.val / 8) + [0, 0, 1, 1, 2, 3, 3, 4].getD (j.val % 8) 0
def swap (j : Fin 16) : Bool := j.val % 8 ∈ [1, 3, 6]
def index (j : Fin 16) : Fin 10 := ⟨if j.val % 8 < 5 then j.val % 8 else j.val % 8 + 1, by split <;> omega⟩

def groupOf (b : Bank) (j : Fin 16) : Nat := groupId b - 8 + j.val / 8

/-- Lookup bank index `b : Bank` owning archived group `i ∈ packed`. -/
def bankOf (i : Nat) : Bank :=
  match (List.finRange 22).find? (fun b => i == groupId b - 8 || i == groupId b - 7) with
  | some b => b
  | none => ⟨0, by decide⟩

def packet (i : Nat) : Nat := bankTick (bankOf i)
def high (i : Nat) : Bool := decide (i = groupId (bankOf i) - 7)
def tile (k : Nat) (hi : Bool) : Nat := k + 5 + (if hi then 5 else 0)

/-- Code cell `j` of bank `b` (`cellsRestoreP (endTick b)`). -/
def bankSite (b : Bank) (j : Fin 16) : Wire := (Partial.cellsRestoreP (endTick b)).getD j 0

/-- All `22 × 16 = 352` archive code cells of the mixed window. -/
def archives : List Wire :=
  (List.finRange 22).flatMap fun b => (List.finRange 16).map (bankSite b)

/-- Unified 157-port descriptor for bank `b : Fin 22`. -/
def bankPorts (exitPorts : Ports) (b : Bank) : Ports :=
  if h1 : b.val < 7 then ArchiveJ7.codePorts ⟨b.val, by omega⟩
  else if h2 : b.val = 7 then Archive150.codePorts
  else if h3 : b.val < 17 then ArchiveJ20.codePorts ⟨b.val - 8, by omega⟩
  else if h4 : b.val < 21 then ArchiveJ7.codePorts ⟨b.val + 3, by omega⟩
  else exitPorts

def siteAt (exitPorts : Ports) (b : Bank) (j : Fin 16) : Wire :=
  bankPorts exitPorts b ⟨j.val, by omega⟩

theorem stable (i e r : Nat) (hi : i ≤ 511) (he : e ≤ 511) (ri : r < i) (re : r < e) (sw : Bool) :
    OB5.sig i (logical sw r) = site e sw r := by
  show OB5.sigNat i (logical sw r) = OB5.sigNat e (logical sw r)
  cases sw <;> simp only [logical, base, Bool.false_eq_true, if_false, if_true, OB5.sigNat] <;>
    split_ifs with h1 h2 h2 <;> (try rcases h1 with h1 | h1) <;> (try rcases h2 with h2 | h2) <;> omega

theorem cells (t : Nat) (lo : 10 ≤ t) (hi : t ≤ 511) (j : Fin 16) :
    (Partial.cellsRestoreP t).getD j 0 = OB5.sig t (logical (swap j) (t - 10 + offset j)) := by
  show _ = OB5.sigNat t (logical (swap j) (t - 10 + offset j))
  rcases j with ⟨j, hj⟩
  interval_cases j <;>
    simp only [Partial.cellsRestoreP, List.getD_cons_zero, List.getD_cons_succ, logical, swap, offset, base,
      OB5.sig_nat, List.mem_cons, List.not_mem_nil, or_false, List.getD, List.getElem?_cons_zero,
      List.getElem?_cons_succ, Option.getD_some] <;>
    first | rfl | (simp only [OB5.sigNat]; split_ifs with h1 h2 <;> (try rcases h1 with h1 | h1) <;>
      (try rcases h2 with h2 | h2) <;> omega) | (norm_num [OB5.sigNat]; split_ifs <;> omega)

private theorem bank_bounds : ∀ b : Bank,
    10 ≤ groupId b ∧ groupId b ≤ 82 ∧
    endTick b ≤ 420 ∧
    endTick b = bankTick b + 15 ∧
    bankOf (groupId b - 8) = b ∧
    bankOf (groupId b - 7) = b := by
  decide +kernel

theorem bank_site (b : Bank) (j : Fin 16) :
    bankSite b j = site 420 (swap j) (bankTick b + 5 + offset j) ∧ bankTick b + 5 + offset j < 420 := by
  have hb := bank_bounds b
  have ho : offset j ≤ 9 := by rcases j with ⟨j, hj⟩; interval_cases j <;> simp [offset]
  refine ⟨?_, by omega⟩
  rw [bankSite, cells _ (by unfold endTick; omega) (by omega)]
  rw [show endTick b - 10 + offset j = bankTick b + 5 + offset j by omega]
  exact stable _ 420 _ (by omega) (by decide) (by omega) (by omega) _

theorem chart (b : Bank) (j : Fin 16) :
    bankSite b j = OB5.sig 420 (slot (groupOf b j) (index j)) ∧
    packet (groupOf b j) = bankTick b ∧
    groupOf b j ∈ packed ∧
    high (groupOf b j) = decide (8 ≤ j.val) := by
  have hb := bank_bounds b
  have bs := (bank_site b j).1
  have hdiv : j.val / 8 = 0 ∨ j.val / 8 = 1 := by have := j.isLt; omega
  have hbo : bankOf (groupOf b j) = b := by
    unfold groupOf
    rcases hdiv with h0 | h1
    · rw [h0, Nat.add_zero]; exact hb.2.2.2.2.1
    · rw [h1, show groupId b - 8 + 1 = groupId b - 7 by omega]; exact hb.2.2.2.2.2
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [bs, site]; congr 1
    have hgt : bankTick b + 5 = 5 * groupId b := by unfold bankTick; omega
    rcases j with ⟨j, hj⟩
    interval_cases j <;>
      simp [logical, swap, offset, slot, History5.historyMap, History5.historyId, index, groupOf, gstart, base] <;>
      omega
  · simp only [packet, hbo]
  · simp only [packed, groupOf, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false]
    exact ⟨b, by rcases hdiv with h0 | h1 <;> omega⟩
  · unfold high; rw [hbo]; unfold groupOf
    congr 1; apply propext; have := j.isLt; omega

theorem bank_mem (b : Bank) (j : Fin 16) : bankSite b j ∈ archives := by
  simp only [archives, List.mem_flatMap, List.mem_finRange, List.mem_map, true_and]
  exact ⟨b, j, rfl⟩

theorem archive_old : ∀ q ∈ archives, ∃ sw r, r < 420 ∧ q = site 420 sw r := by
  intro q hq
  simp only [archives, List.mem_flatMap, List.mem_finRange, List.mem_map, true_and] at hq
  obtain ⟨b, j, rfl⟩ := hq
  obtain ⟨eq, lt⟩ := bank_site b j
  exact ⟨_, _, lt, eq⟩

theorem sparse : ∀ i ∈ packed, ∀ j : Fin 10,
    (j = 5 ∨ j = 9) ∧ slot i j ∈ holes ∨ OB5.sig 420 (slot i j) ∈ archives := by
  intro i hi j
  have hi' := hi
  simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false] at hi'
  obtain ⟨b, hib⟩ := hi'
  have hb := bank_bounds b
  by_cases hole : j = 5 ∨ j = 9
  · left
    refine ⟨hole, ?_⟩
    simp only [holes, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false]
    refine ⟨i, hi, ?_⟩
    rcases hole with rfl | rfl
    · left; simp [slot, History5.historyMap, History5.historyId, base]
    · right; simp [slot, History5.historyMap, History5.historyId, base]
  · right
    let hiBit : Nat := if i = groupId b - 8 then 0 else 1
    let k : Nat := 8 * hiBit + (if j.val < 5 then j.val else j.val - 1)
    have hk : k < 16 := by have := j.isLt; simp only [k, hiBit]; split <;> split <;> omega
    have gi : groupOf b ⟨k, hk⟩ = i := by
      have hjlt := j.isLt
      have h9 : j.val ≠ 9 := fun h => hole (Or.inr (Fin.ext h))
      simp only [groupOf, k, hiBit]
      rcases hib with rfl | rfl <;> (split_ifs <;> omega)
    have ij : index ⟨k, hk⟩ = j := by
      apply Fin.ext; simp only [index, k, hiBit]
      have := j.isLt
      have h5 : j.val ≠ 5 := fun h => hole (Or.inl (Fin.ext h))
      have h9 : j.val ≠ 9 := fun h => hole (Or.inr (Fin.ext h))
      split <;> split <;> split <;> omega
    have c := (chart b ⟨k, hk⟩).1
    rw [gi, ij] at c
    rw [← c]
    exact bank_mem b _

theorem hole_slot : ∀ q ∈ holes, ∃ i ∈ packed, ∃ j : Fin 10, q = slot i j := by
  intro q hq
  simp only [holes, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hq
  obtain ⟨i, hi, e | e⟩ := hq
  · exact ⟨i, hi, 5, by simp [e, slot, History5.historyMap, History5.historyId, base]⟩
  · exact ⟨i, hi, 9, by simp [e, slot, History5.historyMap, History5.historyId, base]⟩

theorem distinct (i h : Nat) (hi : gstart i + 5 ≤ 1028) (hh : gstart h + 5 ≤ 1028)
    (ne : i ≠ h) (a b : Fin 10) : slot i a ≠ slot h b := by
  have := a.isLt; have := b.isLt
  intro eq
  have e2 : History5.historyId (gstart i) a + 16 = History5.historyId (gstart h) b + 16 := eq
  simp only [History5.historyId, gstart] at e2 hi hh
  split_ifs at e2 <;> omega

theorem split_all (i : Nat) (hi : i < 76) : i ∈ plain ∨ i ∈ packed := by
  by_cases hp : packed.contains i
  · right; exact List.contains_iff_mem.mp hp
  · left
    simp only [plain, List.mem_filter, List.mem_range, Bool.not_eq_true', Bool.eq_false_iff]
    exact ⟨hi, hp⟩

theorem plain_nodup : plain.Nodup := List.Nodup.filter _ List.nodup_range

theorem packed_lt {i : Nat} (h : i ∈ packed) : i < 76 := by
  simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false] at h
  obtain ⟨b, hb⟩ := h
  have bnd := bank_bounds b
  omega

theorem plain_lt {i : Nat} (h : i ∈ plain) : i < 76 :=
  List.mem_range.mp (List.mem_filter.mp h).1

theorem packed_chart {i : Nat} (hi : i ∈ packed) :
    gstart i = tile (packet i) (high i) ∧
    45 ≤ packet i ∧ packet i + 15 ≤ 420 ∧
    ∃ b : Bank, packet i = bankTick b := by
  simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false] at hi
  obtain ⟨b, rfl | rfl⟩ := hi
  · have hb := bank_bounds b
    refine ⟨?_, ?_, ?_, b, ?_⟩
    · simp only [gstart, tile, packet, high, hb.2.2.2.2.1, bankTick]
      rw [decide_eq_false (by omega), if_neg Bool.false_ne_true]; omega
    · simp only [packet, hb.2.2.2.2.1, bankTick]; omega
    · simp only [packet, hb.2.2.2.2.1]; omega
    · simp only [packet, hb.2.2.2.2.1]
  · have hb := bank_bounds b
    refine ⟨?_, ?_, ?_, b, ?_⟩
    · simp only [gstart, tile, packet, high, hb.2.2.2.2.2, bankTick, decide_true, if_true]; omega
    · simp only [packet, hb.2.2.2.2.2, bankTick]; omega
    · simp only [packet, hb.2.2.2.2.2]; omega
    · simp only [packet, hb.2.2.2.2.2]

theorem site_eq (exitPorts : Ports)
    (exitCells : ∀ j : Fin 16, exitPorts ⟨j.val, by omega⟩ = (Partial.cellsRestoreP 420).getD j 0)
    (b : Bank) (j : Fin 16) : siteAt exitPorts b j = bankSite b j := by
  simp only [siteAt, bankPorts, bankSite]
  split_ifs with h1 h2 h3 h4
  · have hw : ArchiveJ7.codePorts ⟨b.val, by omega⟩ ⟨j.val, by omega⟩ =
        (Partial.cellsRestoreP (start ⟨b.val, by omega⟩ + 15)).getD j 0 := by
      rw [ArchiveJ7.codePorts, ArchiveJ7.code_split, List.append_assoc,
        List.getD_append _ _ _ _ (by simp [Partial.cellsRestoreP])]
    rw [hw]; congr 2
    rcases b with ⟨bv, hbv⟩; interval_cases bv <;> rfl
  · rw [Archive150.head_port_eq j]; congr 2
    rcases b with ⟨bv, hbv⟩; subst h2; rfl
  · rw [ArchiveJ20.head_port_eq ⟨b.val - 8, by omega⟩ j]; congr 2
    rcases b with ⟨bv, hbv⟩; simp only at h1 h2 h3; interval_cases bv <;> first | rfl | omega
  · have hw : ArchiveJ7.codePorts ⟨b.val + 3, by omega⟩ ⟨j.val, by omega⟩ =
        (Partial.cellsRestoreP (start ⟨b.val + 3, by omega⟩ + 15)).getD j 0 := by
      rw [ArchiveJ7.codePorts, ArchiveJ7.code_split, List.append_assoc,
        List.getD_append _ _ _ _ (by simp [Partial.cellsRestoreP])]
    rw [hw]; congr 2
    rcases b with ⟨bv, hbv⟩; simp only at h1 h2 h3 h4; interval_cases bv <;> rfl
  · rw [exitCells j]; congr 2
    have hb21 : b.val = 21 := by have := b.isLt; omega
    rcases b with ⟨bv, hbv⟩; subst hb21; rfl

theorem bank_rep (exitPorts : Ports)
    (exitCells : ∀ j : Fin 16, exitPorts ⟨j.val, by omega⟩ = (Partial.cellsRestoreP 420).getD j 0)
    (q : Wire) (h : q ∈ archives) : ∃ (b : Bank) (j : Fin 16), siteAt exitPorts b j = q := by
  simp only [archives, List.mem_flatMap, List.mem_finRange, List.mem_map, true_and] at h
  obtain ⟨b, j, rfl⟩ := h
  exact ⟨b, j, site_eq exitPorts exitCells b j⟩

/-- Port-by-port identity with field banks, walk maps, parity ports, and pool bounds. -/
theorem field_ports : ∀ (b : Bank) (i : Fin 16),
    StairArchiveRelease.fieldPort (groupId b) i.val = bankSite b i := by
  decide +kernel

theorem parity_ports : ∀ (b : Bank) (i : Fin 16),
    OB5.sig 511 (NewHistory5.payloadWire base (8 * groupId b + i.val)) = bankSite b i := by
  decide +kernel

theorem fixed_rest : ∀ (b : Bank) (i : Fin 16),
    Stair44WalkMap.rest (bankSite b i) = bankSite b i := by
  decide +kernel

theorem fixed_phaseHost : ∀ (b : Bank) (i : Fin 16),
    Rolling1588Lifetime.phaseHost (bankSite b i) = bankSite b i := by
  decide +kernel

theorem fixed_fieldPlace : ∀ (b : Bank) (i : Fin 16),
    StairOuterPlacement.fieldPlace (bankSite b i) = bankSite b i := by
  decide +kernel

theorem sites_in_pool : ∀ (b : Bank) (i : Fin 16),
    16 ≤ bankSite b i ∧ bankSite b i ≤ 1812 := by
  decide +kernel

/-- Field-bank index set (`Finset Nat`) and inverse lookup from `groupId`. -/
def bankIds : Finset Nat :=
  {10, 13, 16, 19, 22, 25, 28, 31, 35, 39, 43, 47, 51, 55, 59, 63, 67, 70, 73, 76, 79, 82}

def bankOfGroup (j : Nat) : Bank :=
  match (List.finRange 22).find? (fun b => groupId b == j) with
  | some b => b
  | none => ⟨0, by decide⟩

def fieldRows (r : Bank → Nat) (j : Nat) : Nat := r (bankOfGroup j)

theorem rowsAt (r : Bank → Nat) (b : Bank) : fieldRows r (groupId b) = r b := by
  have h : ∀ k : Bank, bankOfGroup (groupId k) = k := by decide +kernel
  rw [fieldRows, h b]

theorem idAt : ∀ j ∈ bankIds, ∃ b : Bank, groupId b = j := by decide +kernel

theorem mem_bankIds : ∀ b : Bank, groupId b ∈ bankIds := by decide +kernel

theorem whole_iff (q : Wire) :
    q ∈ bankIds.biUnion (fun j => (Finset.range 16).image (StairArchiveRelease.fieldPort j)) ↔
      q ∈ archives := by
  simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_range, archives,
    List.mem_flatMap, List.mem_finRange, List.mem_map, true_and]
  constructor
  · rintro ⟨j, hj, i, hi, rfl⟩
    obtain ⟨b, rfl⟩ := idAt j hj
    exact ⟨b, ⟨i, hi⟩, (field_ports b ⟨i, hi⟩).symm⟩
  · rintro ⟨b, i, rfl⟩
    exact ⟨groupId b, mem_bankIds b, i.val, i.isLt, field_ports b i⟩

/-- History cells of ticks `[t, t + 10)` for census proofs. -/
def cells10 (t : Nat) : List Wire := (List.range' t 10).flatMap fun r => [base r, base (1028 + r)]

theorem cell_letter (b : Bank) (a : Nat) (ha : a < 10) :
    base (bankTick b + 5 + a) = slot (groupId b - 8 + a / 5) ⟨2 * (a % 5), by omega⟩ ∧
    base (1028 + (bankTick b + 5 + a)) = slot (groupId b - 8 + a / 5) ⟨2 * (a % 5) + 1, by omega⟩ := by
  have hb := bank_bounds b
  have hgt : bankTick b + 5 = 5 * groupId b := by unfold bankTick; omega
  simp only [slot, History5.historyMap, History5.historyId, gstart, Fin.val_mk]
  constructor
  · rw [if_pos (by omega)]; congr 1; omega
  · rw [if_neg (by omega)]; congr 1; omega

theorem cells_census (b : Bank) :
    ∀ w ∈ cells10 (endTick b - 10), w ∈ holes ∨ OB5.sig 420 w ∈ archives := by
  have hb := bank_bounds b
  intro w hw
  simp only [cells10, List.mem_flatMap, List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false] at hw
  obtain ⟨r, ⟨r1, r2⟩, e⟩ := hw
  have hstart : endTick b - 10 = bankTick b + 5 := by omega
  let a := r - (bankTick b + 5)
  have ha : a < 10 := by omega
  have hr : bankTick b + 5 + a = r := by omega
  have hi : groupId b - 8 + a / 5 ∈ packed := by
    simp only [packed, List.mem_flatMap, List.mem_finRange, true_and, List.mem_cons, List.not_mem_nil, or_false]
    exact ⟨b, by omega⟩
  have cl := cell_letter b a ha
  rw [hr] at cl
  have sp := sparse _ hi
  rcases e with rfl | rfl
  · rw [cl.1]
    rcases sp ⟨2 * (a % 5), by omega⟩ with ⟨_, h⟩ | h
    · exact Or.inl h
    · exact Or.inr h
  · rw [cl.2]
    rcases sp ⟨2 * (a % 5) + 1, by omega⟩ with ⟨_, h⟩ | h
    · exact Or.inl h
    · exact Or.inr h

end ECDSAAdd.Entrant.StairPacket.Shadow20.MixedGeo

namespace ECDSAAdd.Entrant.StairPacket.Shadow20.MixedArchiveSuffix

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Shadow20.MixedGeo

set_option maxRecDepth 15000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false

private theorem no_pack (i : Nat) (lo : 421 ≤ i) (hi : i < 512) (r : Nat) (old : r < 420) (d sw : Bool) :
    logical sw r ∉ wires (Rolling1588.Integer.packFirst base d i) ∧
    logical sw r ∉ wires (Rolling1588.unpackAtTick d i) := by
  have disjoint (due : History5.packDue i = true) (j : Fin 10) :
      logical sw r ≠ History5.historyMap base (i - 5) j := by
    simp only [History5.packDue, decide_eq_true_eq] at due
    have lim := j.isLt
    cases sw <;> simp only [logical, Bool.false_eq_true, if_false, if_true,
      History5.historyMap, History5.historyId, base, Wire]
    all_goals split_ifs <;> omega
  constructor
  · intro h
    rw [Rolling1588.Integer.packFirst, if_neg (show i ≠ 5 by omega),
      Rolling1588.Integer.pack_support_eq] at h
    unfold History5.packAfter at h
    split at h
    · rename_i due
      obtain ⟨j, eq⟩ := History5.history_gate_mem base (i - 5) _ (Or.inl rfl) _ h
      exact disjoint due j eq
    · simp [wires] at h
  · intro h
    rw [← Rolling1588.Integer.unpackFirst_base, Rolling1588.Integer.unpackFirst,
      if_neg (show i ≠ 5 by omega), Rolling1588.Integer.decodeBefore_support_eq] at h
    unfold History5.decodeBefore at h
    split at h
    · rename_i due
      obtain ⟨j, eq⟩ := History5.history_gate_mem base (i - 5) _ (Or.inr rfl) _ h
      exact disjoint due j eq
    · simp [wires] at h

private theorem one (d sw : Bool) (r i : Nat) (old : r < 420) (lo : 421 ≤ i) (hi : i < 512) :
    site 420 sw r ∉ wires (renameProgram (OB5.sig i) (TickRanges.tick base i ++ Rolling1588.Integer.packFirst base d i)) ∧
    site 420 sw r ∉ wires (renameProgram (OB5.sig i) (Rolling1588.unpackAtTick d i ++ W.ReverseCarry.compactReceiverTick base i)) := by
  have past : WideReference.Earlier i (logical sw r) := ⟨r, by omega, by cases sw <;> simp [logical]⟩
  have off := WideReference.away hi past
  have pack := no_pack i lo hi r old d sw
  have pre (q : Wire) (eq : OB5.sig i q = site 420 sw r) : q = logical sw r := by
    rw [← MixedGeo.stable i 420 r (by omega) (by decide) (by omega) old sw] at eq
    exact OB5.sig_injective i (by omega) eq
  constructor <;> intro h <;> rw [renameProgram_support] at h <;>
    obtain ⟨q, mem, eq⟩ := Finset.mem_image.mp h <;> rw [pre q eq, wires_append, Finset.mem_union] at mem
  · rcases mem with tick | packet
    · exact off (List.mem_toFinset.mp (W.repairedTick_support base i hi base_pool_nodup
        (TickRanges.tick_support base i hi base_pool_nodup tick)))
    · exact pack.1 packet
  · rcases mem with packet | tick
    · exact pack.2 packet
    · exact off (List.mem_toFinset.mp (W.ReverseCarry.compactReceiverTick_support base i hi base_pool_nodup tick))

theorem suffix (d sw : Bool) (r i n : Nat) (old : r < 420) (lo : 421 ≤ i) (hi : i + n ≤ 512) :
    site 420 sw r ∉ wires (Rolling1588TickGap.forward d i n) ∧
    site 420 sw r ∉ wires (Rolling1588.reverse d i n) := by
  induction n generalizing i with
  | zero => simp [Rolling1588TickGap.forward, Rolling1588.reverse, wires]
  | succ n ih =>
    have a := one d sw r i old lo (by omega)
    have b := ih (i + 1) (by omega) (by omega)
    simp only [Rolling1588TickGap.forward, Rolling1588.reverse, wires_append, Finset.mem_union, not_or]
    exact ⟨⟨a.1, b.1⟩, ⟨b.2, a.2⟩⟩

theorem safe (d : Bool) (i n : Nat) (lo : 421 ≤ i) (hi : i + n ≤ 512) (q : Wire) (mem : q ∈ archives) :
    q ∉ wires (Rolling1588TickGap.forward d i n) ∧ q ∉ wires (Rolling1588.reverse d i n) := by
  obtain ⟨sw, r, old, rfl⟩ := archive_old q mem
  exact suffix d sw r i n old lo hi

def Same (a b : State) : Prop := a.phase = b.phase ∧ ∀ q, q ∉ archives → a.basis q = b.basis q

theorem independent (P : Program) (off : ∀ q ∈ archives, q ∉ wires P)
    (m : List Bool) (s t : State) (same : Same s t) :
    Same (run P m s) (run P m t) ∧ ∀ q ∈ archives, (run P m s).basis q = s.basis q := by
  have eqs := pool_run_agrees P (wires P) (Finset.Subset.refl _) m s t same.1
    (fun q h => same.2 q (fun mem => off q mem h))
  refine ⟨⟨eqs.1, ?_⟩, fun q mem => run_preserves_outside _ m s _ (off q mem)⟩
  intro q ext
  by_cases use : q ∈ wires P
  · exact eqs.2 q use
  · rw [run_preserves_outside _ m s _ use, run_preserves_outside _ m t _ use]
    exact same.2 q ext

end ECDSAAdd.Entrant.StairPacket.Shadow20.MixedArchiveSuffix
end

section

/-!
# 20-Tick Shadow Window Body, Reference Overlay, and Native Block Heads

1. **`WideReference20`**: generalized `origin20` / `endRaw20` / `Box20` / `advance20` / `stepInput20`
   supporting both 20-tick blocks (`curLen = 20`, `prevLen ∈ {15, 20}`) and the 15-tick re-entry block
   at tick `345` (`curLen = 15`, `prevLen = 20`).
2. **20-Tick Window Body**: `body20`, `unbody20`, `watch20`, `MayTouch20`, `firstUnchanged20`,
   `PastFacts20`, `RowTruth20`, and `row_truth20_chronology`.
3. **`NativeJ20`**: window head semantics for all 9 twenty-tick blocks (`j : Fin 9`, `s = 165..325`),
   including `next_window20`, `saved_with_pending20`, `real_receipt20`, `cleared_holes20`,
   `tail_clean20`, `top_clean20`, `parked_clean20`, `upper_clear20`, `scratch_raw_clean20`, and
   `agree_origin20`.
4. **`Reentry345`**: window head semantics for the `s = 345` re-entry block (`j20`), bridging from
   20-tick block `8` (`s = 325`) back into standard 15-tick `CRTBarrel.leave j20`.
-/

namespace ECDSAAdd.Entrant.StairPacket.Shadow20

open ECDSAAdd.Arithmetic
open ECDSAAdd.Arithmetic.MappedCompressed
open ECDSAAdd.Entrant.IntegerPacket
open ECDSAAdd.Entrant.StairPacket
open ECDSAAdd.Entrant.StairPacket.Partial
open ECDSAAdd.Entrant.StairPacket.ArchivePortAction
open ECDSAAdd.Entrant.StairArchiveRaw
open ECDSAAdd.Entrant.StairArchiveTrace
open ECDSAAdd.Entrant.StairArchiveIntegerHook
open SkywalkRails
open ECDSAAdd.Entrant.StairPacket.EnterProof
open ECDSAAdd.Entrant.StairPacket.WideReference

/-! ### Section 1: Generalized Reference Overlay (`WideReference20`) -/

namespace WideReference20

set_option maxRecDepth 25000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
attribute [local irreducible] run SkywalkNat.step

def oldSites (s prevLen : Nat) : List Wire :=
  (List.range' (s - prevLen) prevLen).flatMap fun r => [base r, base (1028 + r)]

def sites (s prevLen curLen : Nat) : List Wire :=
  (oldSites s prevLen).map (OB5.sig (s + curLen - 1))

def overlay (s prevLen curLen : Nat) (wide history : State) : State :=
  ⟨wide.phase, fun q => if q ∈ sites s prevLen curLen then history.basis q else wide.basis q⟩

def origin (s prevLen curLen : Nat) (raw history : State) : State :=
  overlay s prevLen curLen (pullState (OB5.sig (s + curLen - 1)) (run (span s curLen) [] raw)) history

def endRaw (s prevLen curLen : Nat) (raw history : State) : State :=
  pullState (OB5.sig (s + curLen - 1)) (origin s prevLen curLen raw history)

theorem endpoint (s prevLen curLen : Nat) (lim : s + curLen - 1 ≤ 511) (raw history : State) :
    pullState (OB5.sig (s + curLen - 1)) (endRaw s prevLen curLen raw history) =
      origin s prevLen curLen raw history :=
  OB5.pull_invol _ lim _

theorem outside (s prevLen curLen : Nat) (raw history : State) (q : Wire)
    (h : q ∉ sites s prevLen curLen) :
    (origin s prevLen curLen raw history).basis q =
      (run (span s curLen) [] raw).basis (OB5.sig (s + curLen - 1) q) := by
  simp [origin, overlay, h, pullState]

theorem inside (s prevLen curLen : Nat) (raw history : State) (q : Wire)
    (h : q ∈ sites s prevLen curLen) :
    (origin s prevLen curLen raw history).basis q = history.basis q := by
  simp [origin, overlay, h]

theorem mem_sites {s prevLen curLen : Nat} (bound : s + curLen - 1 ≤ 511) (q : Wire) :
    q ∈ sites s prevLen curLen ↔ OB5.sig (s + curLen - 1) q ∈ oldSites s prevLen := by
  unfold sites
  constructor
  · intro h
    obtain ⟨c, hc, e⟩ := List.mem_map.mp h
    rw [← e, OB5.sig_invol _ bound]
    exact hc
  · intro h
    exact List.mem_map.mpr ⟨_, h, OB5.sig_invol _ bound q⟩

theorem old_cell {s prevLen q : Nat} (member : q ∈ oldSites s prevLen) :
    ∃ r, s - prevLen ≤ r ∧ r < s - prevLen + prevLen ∧ (q = r + 16 ∨ q = r + 1044) := by
  obtain ⟨r, hr, he⟩ := List.mem_flatMap.mp member
  have lim := List.mem_range'_1.mp hr
  refine ⟨r, lim.1, lim.2, ?_⟩
  rcases List.mem_cons.mp he with h | h
  · exact Or.inl h
  · right
    have h' := List.mem_singleton.mp h
    change q = 1028 + r + 16 at h'
    omega

theorem endRaw_inside {s prevLen curLen : Nat} (bound : s + curLen - 1 ≤ 511)
    (raw history : State) (q : Wire) (member : q ∈ oldSites s prevLen) :
    (endRaw s prevLen curLen raw history).basis q = history.basis (OB5.sig (s + curLen - 1) q) := by
  change (origin s prevLen curLen raw history).basis (OB5.sig (s + curLen - 1) q) = _
  apply inside
  rw [mem_sites bound, OB5.sig_invol _ bound]
  exact member

theorem endRaw_outside {s prevLen curLen : Nat} (bound : s + curLen - 1 ≤ 511)
    (raw history : State) (q : Wire) (off : q ∉ oldSites s prevLen) :
    (endRaw s prevLen curLen raw history).basis q = (run (span s curLen) [] raw).basis q := by
  have invol := OB5.sig_invol (s + curLen - 1) bound q
  have out : OB5.sig (s + curLen - 1) q ∉ sites s prevLen curLen := by
    rw [mem_sites bound, invol]; exact off
  change (origin s prevLen curLen raw history).basis (OB5.sig (s + curLen - 1) q) = _
  rw [outside s prevLen curLen raw history _ out, invol]

theorem past_slot {s prevLen curLen q : Nat} (hprev : prevLen ≤ s) (hcur : 2 ≤ curLen)
    (hit : q ∈ oldSites s prevLen) : Earlier (s + curLen) q := by
  obtain ⟨r, _, lt, h | h⟩ := old_cell hit
  · exact ⟨r, by omega, Or.inl h⟩
  · exact ⟨r, by omega, Or.inr (by change q = 1028 + r + 16; omega)⟩

theorem after_coherent (s prevLen curLen : Nat) (hprev : prevLen ≤ s) (hcur : 2 ≤ curLen)
    (hi : s + curLen ≤ 512) (raw history ref : State) (same : Coherent s raw ref) :
    Coherent (s + curLen) (endRaw s prevLen curLen raw history) (run (span s curLen) [] ref) := by
  have c := coherent_span s curLen hi raw ref same []
  refine ⟨c.1, ?_⟩
  intro q off
  have invol := OB5.sig_invol (s + curLen - 1) (by omega) q
  have out : OB5.sig (s + curLen - 1) q ∉ sites s prevLen curLen := by
    rw [mem_sites (by omega), invol]
    exact fun hit => off (past_slot hprev hcur hit)
  change (origin s prevLen curLen raw history).basis (OB5.sig (s + curLen - 1) q) = _
  rw [outside s prevLen curLen raw history _ out, invol, c.2 q off]

theorem advance (s prevLen curLen x p : Nat) (hprev : prevLen ≤ s) (hcur : 2 ≤ curLen)
    (hi : s + curLen ≤ 512) (good : Bounds x p) (raw history : State) (dom : Domain s x p raw) :
    Domain (s + curLen) x p (endRaw s prevLen curLen raw history) := by
  obtain ⟨ref, same, valid⟩ := dom
  exact ⟨_, after_coherent s prevLen curLen hprev hcur hi raw history ref same,
    full_span s curLen x p hi good.positive good.nonzero good.odd good.cap good.gap good.small good.coprime ref [] valid⟩

theorem same_shadow20 (b : Nat) (z : SkywalkNat.State) (small : Shadow7.SmallIfFar b 20 z)
    (odd : z.v % 2 = 1) (G S : Bool) :
    let t := Shadow.reduced b 20 z
    let pair := SharedSigned.flags G S (SkywalkTrace.trace 20 (encode G S z.u z.v))
    SkywalkTrace.next^[20] (encode G S t.u t.v) =
      encode pair.1 pair.2 (SkywalkNat.step^[20] t).u (SkywalkNat.step^[20] t).v ∧
    SkywalkTrace.next^[20] (encode G S z.u z.v) =
      encode pair.1 pair.2 (SkywalkNat.step^[20] z).u (SkywalkNat.step^[20] z).v := by
  have shadow := SharedSigned.lift 20 G S (Shadow.reduced b 20 z) (shadow_odd20 b z small odd)
  rw [true_records20 b z small odd G S] at shadow
  exact ⟨shadow, SharedSigned.lift 20 G S z odd⟩

theorem stepInput20 (s prevLen b x p : Nat) (hprev : prevLen ≤ s) (hi : s + 20 < 512)
    (good : Bounds x p) (raw history : State) (g sg : Bool) (dom : Domain s x p raw)
    (input : InputAt s (StockWindowTicket.signedAt s x p g sg) raw)
    (small : Shadow7.SmallIfFar b 20 (unsigned s x p)) :
    let next := SharedSigned.flags g sg (SkywalkTrace.trace 20 (StockWindowTicket.signedAt s x p g sg))
    Domain (s + 20) x p (endRaw s prevLen 20 raw history) ∧
    InputAt (s + 20) (StockWindowTicket.signedAt (s + 20) x p next.1 next.2) (endRaw s prevLen 20 raw history) := by
  let z := unsigned s x p
  have odd : z.v % 2 = 1 := (SkywalkNat.iter_valid s (SkywalkNat.init x p) good.positive good.odd).2.1
  obtain ⟨_, b'⟩ := same_shadow20 b z small odd g sg
  have eq := unique_input input (fixed_input s x p (by omega) good raw dom)
  have stepRel : WideReference.canonical (s + 20) x p = SkywalkTrace.next^[20] (WideReference.canonical s x p) := by
    rw [Nat.add_comm]; exact Function.iterate_add_apply _ _ _ _
  have numRel : unsigned (s + 20) x p = SkywalkNat.step^[20] z := by
    rw [Nat.add_comm]; exact Function.iterate_add_apply _ _ _ _
  have nextDom := advance s prevLen 20 x p hprev (by decide) (by omega) good raw history dom
  have active := fixed_input (s + 20) x p hi good (endRaw s prevLen 20 raw history) nextDom
  dsimp only
  refine ⟨nextDom, ?_⟩
  rw [stepRel, ← eq] at active
  unfold StockWindowTicket.signedAt at active
  rw [b'] at active
  simpa only [StockWindowTicket.signedAt, numRel] using active

theorem stepInput15 (s prevLen b x p : Nat) (hprev : prevLen ≤ s) (hi : s + 15 < 512)
    (good : Bounds x p) (raw history : State) (g sg : Bool) (dom : Domain s x p raw)
    (input : InputAt s (StockWindowTicket.signedAt s x p g sg) raw)
    (small : Shadow7.SmallIfFar b 15 (unsigned s x p)) :
    let next := SharedSigned.flags g sg (SkywalkTrace.trace 15 (StockWindowTicket.signedAt s x p g sg))
    Domain (s + 15) x p (endRaw s prevLen 15 raw history) ∧
    InputAt (s + 15) (StockWindowTicket.signedAt (s + 15) x p next.1 next.2) (endRaw s prevLen 15 raw history) := by
  let z := unsigned s x p
  have odd : z.v % 2 = 1 := (SkywalkNat.iter_valid s (SkywalkNat.init x p) good.positive good.odd).2.1
  obtain ⟨_, b'⟩ := SharedSigned.same_shadow7 b z small odd g sg
  have eq := unique_input input (fixed_input s x p (by omega) good raw dom)
  have stepRel : WideReference.canonical (s + 15) x p = SkywalkTrace.next^[15] (WideReference.canonical s x p) := by
    rw [Nat.add_comm]; exact Function.iterate_add_apply _ _ _ _
  have numRel : unsigned (s + 15) x p = SkywalkNat.step^[15] z := by
    rw [Nat.add_comm]; exact Function.iterate_add_apply _ _ _ _
  have nextDom := advance s prevLen 15 x p hprev (by decide) (by omega) good raw history dom
  have active := fixed_input (s + 15) x p hi good (endRaw s prevLen 15 raw history) nextDom
  dsimp only
  refine ⟨nextDom, ?_⟩
  rw [stepRel, ← eq] at active
  unfold StockWindowTicket.signedAt at active
  rw [b'] at active
  simpa only [StockWindowTicket.signedAt, numRel] using active

def Box20 (s curLen q : Nat) : Prop :=
  (s + 15 ≤ q ∧ q ≤ s + curLen + 15 + W.narrowSkywalkRouteWidth (s + curLen - 1) ∧ q ≤ 529) ∨
  (786 ≤ q ∧ q ≤ 785 + W.narrowSkywalkRouteWidth s) ∨
  (1556 ≤ q ∧ q ≤ 1812 ∧ q + s ≤ 2069) ∨
  (1044 + s ≤ q ∧ q < 1044 + s + curLen)

instance (s curLen q : Nat) : Decidable (Box20 s curLen q) := by unfold Box20; infer_instance

theorem box20_away {s curLen : Nat} (lo : 0 < s) (hc : 1 ≤ curLen) (hi : s + curLen ≤ 511)
    {q : Wire} (out : ¬ Box20 s curLen q) : ∀ a < curLen, ¬ RawRead (s + a) q := by
  intro a ha hit
  apply out
  have pos : s + a ≠ 0 := by omega
  have w := route_width (s + a) (by omega)
  have w' := route_width (s + curLen - 1) (by omega)
  have w0 := route_width s (by omega)
  unfold RawRead at hit
  simp only [W.compactSkywalkTickPreWidth, skywalkPoolPreviousId, if_neg pos, base, Wire] at hit
  unfold Box20
  omega

theorem box_origin20 {s prevLen curLen : Nat} (lo : 1 ≤ s) (hc : 1 ≤ curLen) (hi : s + curLen ≤ 440)
    {q : Wire} (out : ¬ Box20 s curLen q) (raw history : State)
    (same : q ∉ sites s prevLen curLen → history.basis q = (pullState (OB5.sig (s - 1)) raw).basis q) :
    history.basis q = (origin s prevLen curLen raw history).basis q := by
  by_cases h : q ∈ sites s prevLen curLen
  · exact (inside s prevLen curLen raw history q h).symm
  rw [same h, outside s prevLen curLen raw history q h]
  change raw.basis (OB5.sig (s - 1) q) = _
  have box := out
  unfold Box20 at box
  have w0 := route_width s (by omega)
  have agree : OB5.sig (s - 1) q = OB5.sig (s + curLen - 1) q := by
    rw [OB5.sig_nat, OB5.sig_nat]; unfold OB5.sigNat
    split_ifs <;> first | rfl | omega
  have away : ¬ Box20 s curLen (OB5.sig (s + curLen - 1) q) := by
    rw [OB5.sig_nat]; unfold Box20 OB5.sigNat
    split_ifs <;> omega
  rw [agree, span_unchanged s curLen _ (by omega) (box20_away (by omega) hc (by omega) away)]

theorem carry_origin20 {s prevLen curLen upper x p : Nat} (hprev : prevLen ≤ s) (hc : 1 ≤ curLen)
    (limit : s + curLen ≤ 512) (upper_ok : upper ≤ 1812) (good : Bounds x p) (raw history : State)
    (domain : Domain s x p raw)
    (fixed : ∀ q : Nat, 1556 ≤ q → q ≤ upper → OB5.sig (s + curLen - 1) q = q)
    (q : Nat) (low : 1556 ≤ q) (high : q ≤ upper) :
    (origin s prevLen curLen raw history).basis q = false := by
  have clear : q ∉ sites s prevLen curLen := by
    intro hit
    have old := (mem_sites (by omega) q).mp hit
    rw [fixed _ low high] at old
    obtain ⟨r, _, lt, h | h⟩ := old_cell old <;> omega
  rw [outside s prevLen curLen raw history q clear, fixed _ low high]
  exact full_carry s curLen x p limit good raw domain [] q low (Nat.le_trans high upper_ok)

theorem pulled_history20 (j : Fin 9) {x p : Nat} {raw : State} (dom : Domain (start20 j) x p raw) :
    ∀ r : Fin 20, raw.basis (EnterJ20.pull j (windowNet20 j (IntegerPacket.ports (shape20 j) r).history)) = false := by
  intro r
  have hj := j.isLt
  have hr := r.isLt
  have st : start20 j = 165 + 20 * j.val := rfl
  have w : EnterJ20.pull j (windowNet20 j (IntegerPacket.ports (shape20 j) r).history) =
      (if start20 j + r.val < 257 then 1044 + (start20 j + r.val) else 2069 - (start20 j + r.val) : Nat) := by
    change OB5.sigNat (start20 j - 1) (OB5.sigNat (start20 j + 19) (start20 j + r.val + 16 + 1028)) = _
    unfold OB5.sigNat
    split_ifs <;> omega
  rw [w]
  split_ifs
  · have old := future_history (j := start20 j + r.val) (Nat.le_add_right _ _) (by omega) dom
    change raw.basis (1028 + (start20 j + r.val) + 16) = false at old
    rwa [show 1028 + (start20 j + r.val) + 16 = 1044 + (start20 j + r.val) by omega] at old
  · exact domain_carry (by omega) dom _ (by omega) (by omega)

theorem sig_rail20 (j : Fin 9) (q : Wire) (top : (q : Nat) ≤ 529) (i : Nat) (hi : i ≤ start20 j + 19) :
    OB5.sig i q = q := by
  have hj := j.isLt
  refine sig_fixed ?_ ?_
  · intro h; simp only [Wire] at *; omega
  · intro h; simp only [start20, Wire] at *; omega

end WideReference20

/-! ### Section 2: 20-Tick Window Body, Watch Frame, and Archive Facts -/

section Body20

set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
attribute [local irreducible] run unrouted20

def body20 (j : Fin 9) (admin : Program) : Program :=
  routed20 j 0 1 ++ (admin ++ routed20 j 1 19)

def unbody20 (j : Fin 9) (reverse : Program) : Program :=
  unrouted20 j 1 19 ++ (reverse ++ unrouted20 j 0 1)

def watch20 (j : Fin 9) : List Wire :=
  let p := shape20 j
  let L := IntegerPacket.ports p 1
  (L.a ++ L.b ++ [L.previous] ++ L.carry ++
    ((List.range' 1 19).flatMap fun r => [(IntegerPacket.ports p r).ext, (IntegerPacket.ports p r).history]) ++
    [(IntegerPacket.ports p 0).a0, (IntegerPacket.ports p 0).history]).map (windowNet20 j)

theorem split_run20 (j : Fin 9) (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1) (s : State) (m n : List Bool)
    (ready : onRails20 j 0 z s.basis) (v : State)
    (active : onRails20 j 1 (SkywalkTrace.next z) v.basis)
    (first : cell (shape20 j) 0 (mappedBasis20 j v.basis) =
      cell (shape20 j) 0 (mappedBasis20 j (run (routed20 j 0 1) m s).basis)) :
    let out := run (routed20 j 1 19) n v
    onRails20 j 20 (SkywalkTrace.next^[20] z) out.basis ∧
    readCells (shape20 j) 0 20 (mappedBasis20 j out.basis) = SkywalkTrace.trace 20 z := by
  have post := route20_frame j 1 19 (by decide) (SkywalkTrace.next z) (nextOdd z odd) v n active
  have back := route20_records j 1 19 (by decide) (SkywalkTrace.next z) (nextOdd z odd) v n active
  have front := (route20_records j 0 1 (by decide) z odd s m ready).1
  have firstValue := congrArg List.head? front
  simp only [readCells, SkywalkTrace.trace, List.head?_cons, Option.some.injEq] at firstValue
  exact ⟨post.2, congr (congrArg List.cons ((back.2 0 (by decide)).trans (first.trans firstValue))) back.1⟩

theorem watch20_congr (j : Fin 9) (s t : State) (agree : ∀ q ∈ watch20 j, t.basis q = s.basis q)
    (z : SkywalkRails.State) (active : onRails20 j 1 z s.basis) :
    onRails20 j 1 z t.basis ∧
      cell (shape20 j) 0 (mappedBasis20 j t.basis) = cell (shape20 j) 0 (mappedBasis20 j s.basis) := by
  let p := shape20 j
  let L := IntegerPacket.ports p 1
  let S := mappedBasis20 j s.basis
  let T := mappedBasis20 j t.basis
  have locality (q : Wire) (mem : q ∈ L.a ++ L.b ++ [L.previous] ++ L.carry ++
      ((List.range' 1 19).flatMap fun r => [(IntegerPacket.ports p r).ext, (IntegerPacket.ports p r).history]) ++
      [(IntegerPacket.ports p 0).a0, (IntegerPacket.ports p 0).history]) :
      T q = S q := agree _ (List.mem_map.mpr ⟨q, mem, rfl⟩)
  have add (xs : List Wire) (incl : ∀ q ∈ xs, T q = S q) : signedRegValue xs T = signedRegValue xs S := by
    unfold signedRegValue; rw [regValue_congr _ _ _ incl]
  obtain ⟨a, b, prev, carry, free⟩ := active
  refine ⟨⟨(add _ (fun q h => locality _ (by simp [L, p, h]))).trans a,
    (add _ (fun q h => locality _ (by simp [L, p, h]))).trans b,
    (locality _ (by simp [L, p])).trans prev,
    (regValue_congr _ _ _ (fun q h => locality _ (by simp [L, p, h]))).trans carry, ?_⟩, ?_⟩
  · intro r hr last
    have inRange : r ∈ List.range' 1 19 := by rw [List.mem_range'_1]; exact ⟨hr, last⟩
    obtain ⟨e, h⟩ := free r hr last
    exact ⟨(locality _ (by simp only [List.mem_append]; left; right; apply List.mem_flatMap.mpr; exact ⟨r, inRange, by simp [p]⟩)).trans e,
      (locality _ (by simp only [List.mem_append]; left; right; apply List.mem_flatMap.mpr; exact ⟨r, inRange, by simp [p]⟩)).trans h⟩
  · exact Prod.ext (locality _ (by simp [L, p])) (locality _ (by simp [L, p]))

structure AdminResult20 (j : Fin 9) (reverse : Program) (src out : State) : Prop where
  phase : out.phase = src.phase
  unchanged : ∀ q ∈ watch20 j, out.basis q = src.basis q
  undo : ∀ m, run reverse m out = src

theorem body20_run (j : Fin 9) (admin reverse : Program) (s : State) (m : List Bool)
    (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1) (active : onRails20 j 0 z s.basis)
    (mid : let src := run (routed20 j 0 1) m s
      AdminResult20 j reverse src (run admin (m.drop (measurementCount (routed20 j 0 1))) src)) :
    let out := run (body20 j admin) m s
    out.phase = s.phase ∧ onRails20 j 20 (SkywalkTrace.next^[20] z) out.basis ∧
      readCells (shape20 j) 0 20 (mappedBasis20 j out.basis) = SkywalkTrace.trace 20 z ∧
      ∀ n, run (unbody20 j reverse) n out = s := by
  let src := run (routed20 j 0 1) m s
  let t := m.drop (measurementCount (routed20 j 0 1))
  let pre := run admin t src
  let n := t.drop (measurementCount admin)
  have head := route20_frame j 0 1 (by decide) z odd s m active
  have valid : onRails20 j 1 (SkywalkTrace.next z) src.basis := head.2
  have pass := watch20_congr j src pre mid.unchanged _ valid
  have span := split_run20 j z odd s m n active pre pass.1 pass.2
  have last := route20_frame j 1 19 (by decide) (SkywalkTrace.next z) (nextOdd z odd) pre n pass.1
  dsimp only [body20, unbody20]
  simp only [run_append, run_take]
  refine ⟨last.1.trans (mid.phase.trans head.1), span.1, span.2, ?_⟩
  intro r
  have endBack := route20_undo j 1 19 (by decide) (SkywalkTrace.next z) (nextOdd z odd) pre n r pass.1
  change run (unrouted20 j 0 1) _ (run reverse _ (run (unrouted20 j 1 19) r (run (routed20 j 1 19) n pre))) = s
  rw [endBack, mid.undo]
  exact route20_undo j 0 1 (by decide) z odd s m _ active

theorem ready_after_head20 (j : Fin 9) (P : Program) (s : State) (a b : List Bool) (z : SkywalkRails.State)
    (odd : (z.a + z.b) % 2 = 1) (active : onRails20 j 0 z s.basis)
    (preserve : ∀ t : State, ∀ q ∈ watch20 j, (run P b t).basis q = t.basis q) :
    onRails20 j 1 (SkywalkTrace.next z) (run P b (run (routed20 j 0 1) a s)).basis :=
  (watch20_congr j _ _ (preserve _) _ (route20_frame j 0 1 (by decide) z odd s a active).2).1

def tickSites20 (j : Fin 9) (a : Nat) : List Wire :=
  (IntegerPacket.ports (shape20 j) a).wires.map (windowNet20 j)

def spanSites20 (j : Fin 9) (a n : Nat) : List Wire :=
  (List.range' a n).flatMap (tickSites20 j)

theorem route20_sites (j : Fin 9) (a n : Nat) (lim : a + n ≤ 20) (q : Wire)
    (inP : q ∈ wires (routed20 j a n)) : q ∈ spanSites20 j a n := by
  induction n generalizing a with
  | zero => simp [routed20, wires] at inP
  | succ n ih =>
    rw [routed20, wires_append, Finset.mem_union] at inP
    rw [spanSites20, List.range'_succ, List.flatMap_cons, List.mem_append]
    rcases inP with h | h
    · rw [renameProgram_support, Finset.mem_image] at h
      obtain ⟨t, used, eq⟩ := h
      have ht : a < 20 := by omega
      have inside := List.mem_toFinset.mp ((skywalkIntegerTick_wires_subset _ (IntegerPacket.ok (shape20 j) ⟨a, ht⟩)).1 used)
      exact Or.inl (List.mem_map.mpr ⟨t, inside, (stable20 ht inside).symm.trans eq⟩)
    · exact Or.inr (ih (a + 1) (by omega) h)

theorem route20_outside (j : Fin 9) (a n : Nat) (lim : a + n ≤ 20) (q : Wire)
    (free : q ∉ spanSites20 j a n) (s : State) (m : List Bool) :
    (run (routed20 j a n) m s).basis q = s.basis q :=
  run_preserves_outside _ _ _ _ (fun used => free (route20_sites j a n lim q used))

theorem old_clear20 {j : Fin 9} {a n q : Nat} (lim : a + n ≤ 20)
    (old : oldRange (start20 j + a) (windowNet20 j q)) : q ∉ spanSites20 j a n := by
  intro mem
  obtain ⟨r, hr, inside⟩ := List.mem_flatMap.mp mem
  rw [List.mem_range'_1] at hr
  obtain ⟨w, hw, eq⟩ := List.mem_map.mp inside
  rw [← eq, net20_invol j w] at old
  have hj := j.isLt
  simp only [IntegerPacket.ports, shape20, smallBits20, sbP20, start20, SkywalkIntegerLayout.wires,
    SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh, List.mem_cons, List.mem_append,
    List.mem_range'_1, List.not_mem_nil, or_false] at hw
  simp only [oldRange, start20] at old
  repeat' first | cases_type Or | cases_type And
  all_goals try simp only [Wire] at *
  all_goals omega

def MayTouch20 (j : Fin 9) (w : Wire) : Prop :=
  (start20 j + 15 ≤ w ∧ w ≤ start20 j + 19 + 16 + (shape20 j).mid + 2) ∨
  (786 ≤ w ∧ w ≤ 787 + (shape20 j).mid) ∨
  (1556 ≤ w ∧ w ≤ 1556 + (shape20 j).mid) ∨
  (1044 + start20 j ≤ w ∧ w < 1044 + start20 j + 20)

instance (j : Fin 9) (w : Wire) : Decidable (MayTouch20 j w) := by unfold MayTouch20; infer_instance

theorem named_range20 (j : Fin 9) (a n q : Nat) (lim : a + n ≤ 20)
    (outside : ¬ MayTouch20 j (windowNet20 j q)) : q ∉ spanSites20 j a n := by
  intro mem
  obtain ⟨r, hr, inside⟩ := List.mem_flatMap.mp mem
  rw [List.mem_range'_1] at hr
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp inside
  rw [net20_invol j w] at outside
  apply outside
  simp only [IntegerPacket.ports, SkywalkIntegerLayout.wires, SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh,
    List.mem_cons, List.mem_append, List.mem_range'_1, List.not_mem_nil, or_false,
    shape20, smallBits20, start20] at hw
  simp only [MayTouch20, shape20, smallBits20, start20]
  repeat' first | cases_type Or | cases_type And
  all_goals try simp only [Wire] at *
  all_goals omega

theorem through_body20 (j : Fin 9) (P : Program) (s : State) (m : List Bool) (q : Nat)
    (free : ¬ MayTouch20 j (windowNet20 j q))
    (admin : let a := run (routed20 j 0 1) m s
      (run P (m.drop (measurementCount (routed20 j 0 1))) a).basis q = a.basis q) :
    (run (body20 j P) m s).basis q = s.basis q := by
  simp only [body20, run_append, run_take]
  exact (route20_outside j 1 19 (by decide) q (named_range20 j 1 19 q (by decide) free) _ _).trans
    (admin.trans (route20_outside j 0 1 (by decide) q (named_range20 j 0 1 q (by decide) free) s m))

theorem body20_cover (j : Fin 9) (P : Program) (controls effects : List Wire)
    (clean : ∀ q ∈ controls, ¬ MayTouch20 j (windowNet20 j q))
    (apart : ∀ q ∈ controls, q ∉ effects) (cover : wires P ⊆ effects.toFinset)
    (s : State) (m : List Bool) (q : Wire) (hit : q ∈ controls) :
    (run (body20 j P) m s).basis q = s.basis q :=
  through_body20 j P s m q (clean q hit) (run_preserves_outside P _ _ q
    (fun used => apart q hit (List.mem_toFinset.mp (cover used))))

theorem ext_head20 (P : Program) (j : Fin 9) (Q : Program) (effects : List Wire)
    (s : State) (m n : List Bool) (q : Wire) (native : ¬ MayTouch20 j (windowNet20 j q))
    (enter : q ∉ wires P) (admin : q ∉ effects) (cover : wires Q ⊆ effects.toFinset) :
    (run (body20 j Q) n (run P m s)).basis q = s.basis q :=
  (through_body20 j Q _ n q native (run_preserves_outside Q _ _ q
    (fun used => admin (List.mem_toFinset.mp (cover used))))).trans (run_preserves_outside P _ _ q enter)

theorem sig_tail20 (j : Fin 9) (q : Wire)
    (lo : e0P20 (start20 j) + 6 ≤ q) (hi : q + start20 j ≤ 2049)
    (i : Nat) (ile : i ≤ start20 j + 19) : OB5.sig i q = q := by
  have hj := j.isLt
  have top : start20 j ≤ 325 := by simp only [start20]; omega
  apply sig_fixed
  · intro band
    simp only [e0P20, Wire] at lo band
    omega
  · intro mirror
    simp only [Wire] at hi mirror
    omega

def firstUnchanged20 (j : Fin 9) (q : Wire) : Prop :=
  let r := windowNet20 j q
  r = (IntegerPacket.ports (shape20 j) 0).previous ∨ r ∉ (IntegerPacket.ports (shape20 j) 0).wires

instance (j : Fin 9) (q : Wire) : Decidable (firstUnchanged20 j q) := by unfold firstUnchanged20; infer_instance

theorem first_preserves20 (j : Fin 9) (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1)
    (s : State) (m : List Bool) (ready : onRails20 j 0 z s.basis)
    (q : Wire) (free : firstUnchanged20 j q) : (run (routed20 j 0 1) m s).basis q = s.basis q := by
  let p := shape20 j
  let L := IntegerPacket.ports p 0
  let virt := pullState (windowNet20 j) s
  let v := windowNet20 j q
  have first : 0 < p.length := by change 0 < 20; decide
  have inv : windowNet20 j v = q := net20_invol j q
  have step := pull_routed20 j 0 1 (by decide) m s
  simp only [IntegerPacket.seq, List.append_nil] at step
  have at_q := congrArg (fun x : State => x.basis v) step
  change (run (routed20 j 0 1) m s).basis (windowNet20 j v) =
    (run (skywalkIntegerTick L) m virt).basis v at at_q
  rw [inv] at at_q
  refine at_q.trans (Eq.trans ?_ (show virt.basis v = s.basis q from congrArg s.basis inv))
  rcases free with e | e
  · change v = L.previous at e
    rw [e]
    obtain ⟨ha, hb, hg, hc, hnew⟩ := ready
    obtain ⟨he, hh⟩ := hnew 0 (by decide) first
    obtain ⟨_, _, _, _, _, prev, _⟩ :=
      IntegerPacket.executed p ⟨0, first⟩ _ _ _ odd virt m ⟨ha, hb, hg, he, hh, hc⟩
    exact prev.trans hg.symm
  · apply run_preserves_outside
    exact fun used => e (List.mem_toFinset.mp ((skywalkIntegerTick_wires_subset _ (IntegerPacket.ok p ⟨0, first⟩)).1 used))

def FirstFree20 (j : Fin 9) (r : Wire) : Prop :=
  r = start20 j + 15 ∨
  ¬ (r = start20 j + 1044 ∨ (start20 j + 16 ≤ r ∧ r ≤ start20 j + sbP20 (start20 j) + 39) ∨
     (786 ≤ r ∧ r ≤ sbP20 (start20 j) + 808) ∨ (1556 ≤ r ∧ r ≤ sbP20 (start20 j) + 1576))

instance (j : Fin 9) (r : Wire) : Decidable (FirstFree20 j r) := by unfold FirstFree20; infer_instance

theorem firstFree20 (j : Fin 9) {q : Wire} (h : FirstFree20 j (windowNet20 j q)) : firstUnchanged20 j q := by
  unfold firstUnchanged20
  by_cases hp : (windowNet20 j q : Nat) = start20 j + 15
  · left
    rw [hp]
    show start20 j + 15 = start20 j + 0 + 16 - 1
    omega
  · right
    intro mem
    rcases h with h | h
    · exact hp h
    · apply h
      simp only [IntegerPacket.ports, shape20, smallBits20, sbP20, SkywalkIntegerLayout.wires,
        SkywalkIntegerLayout.ah, SkywalkIntegerLayout.bh, List.mem_cons, List.mem_append,
        List.mem_range'_1, List.not_mem_nil, or_false] at mem
      simp only [sbP20, Wire] at *
      omega

theorem body20_keeps (j : Fin 9) (P : Program) (ps : Ports) (d : Bool) (row : Nat)
    (s : State) (m : List Bool) (off : ∀ i : Fin 16, ps ⟨i.val, by omega⟩ ∉ spanSites20 j 1 19)
    (hold : Frame ps (code d) row (run P (m.drop (measurementCount (routed20 j 0 1)))
      (run (routed20 j 0 1) m s))) : Kept ps d row (run (body20 j P) m s) := by
  intro i
  simp only [body20, run_append, run_take]
  exact (route20_outside j 1 19 (by decide) _ (off i) _ _).trans (hold ⟨i.val, by omega⟩)

theorem after_encoded20 (j : Fin 9) (P : Program) (outPorts : Ports) (d : Bool) (row : Nat)
    (src : State) (m : List Bool)
    (final : Frame outPorts (code d) row (run P (m.drop (measurementCount (routed20 j 0 1)))
      (run (routed20 j 0 1) m src)))
    (i : Fin 157) (hi : 16 ≤ i.val) (q : Wire) (slot : outPorts i = q)
    (free : ¬ MayTouch20 j (windowNet20 j q)) : (run (body20 j P) m src).basis q = false := by
  simp only [body20, run_append, run_take]
  apply (route20_outside j 1 19 (by decide) q (named_range20 j 1 19 q (by decide) free) _ _).trans
  rw [← slot, final, archive_blank _ _ hi, Nat.zero_testBit]

/-- Native raw archive port `q ∈ 0..19` of 20-tick block `j`: reads suffix ticks `10..19`. -/
def nativeRawPort20 (j : Fin 9) (q : Nat) : Wire :=
  let r := 10 + q / 2
  windowNet20 j (if q % 2 = 0 then (IntegerPacket.ports (shape20 j) r).a0 else (IntegerPacket.ports (shape20 j) r).history)

private theorem readCells_drop (p : Shape) (i n k : Nat) (b : BasisState) (hk : k ≤ n) :
    (readCells p i n b).drop k = readCells p (i + k) (n - k) b := by
  induction k generalizing i n with
  | zero => simp
  | succ k ih =>
    cases n with
    | zero => omega
    | succ n =>
      simp only [readCells, List.drop_succ_cons]
      rw [ih (i + 1) n (by omega), show i + 1 + k = i + (k + 1) by omega, Nat.succ_sub_succ_eq_sub]

private theorem readCells_getD (p : Shape) (i n k : Nat) (b : BasisState) (hk : k < n) :
    (readCells p i n b).getD k (false, false) = cell p (i + k) b := by
  induction k generalizing i n with
  | zero =>
    cases n with
    | zero => omega
    | succ n => simp [readCells]
  | succ k ih =>
    cases n with
    | zero => omega
    | succ n =>
      simp only [readCells, List.getD_cons_succ]
      rw [ih (i + 1) n (by omega), show i + 1 + k = i + (k + 1) by omega]

theorem native_raw_read20 (j : Fin 9) (s : State) (q : Nat) (h : q < 20) :
    s.basis (nativeRawPort20 j q) =
      letterBit (StairArchiveRaw.read ((physicalCells20 j s).drop 10) (q / 2)) q := by
  unfold physicalCells20
  rw [readCells_drop _ 0 20 10 _ (by decide)]
  unfold StairArchiveRaw.read
  rw [← List.getD_eq_getElem?_getD, readCells_getD _ (0 + 10) (20 - 10) (q / 2) _ (by omega)]
  simp only [Nat.zero_add, nativeRawPort20, letterBit, cell, mappedBasis20]
  split_ifs <;> rfl

/-- Archive hand-off facts for a completed 20-tick block `j : Fin 9`. -/
structure PastFacts20 (j : Fin 9) (rawPorts : Ports) (z : SkywalkNat.State)
    (g sign cross : Bool) (s : State) : Prop where
  records : physicalCells20 j s = SkywalkTrace.trace 20 (encode g sign z.u z.v)
  far : s.basis (rawPorts 20) = decide (Shadow.far (sbP20 (start20 j)) 20 z)
  suffix : s.basis (rawPorts 21) =
    (decide (Shadow.far (sbP20 (start20 j)) 20 z) && afterFlags (decide (z.v < z.u)) ((physicalCells20 j s).take 10))
  crossed : s.basis (rawPorts 22) = (decide (Shadow.far (sbP20 (start20 j)) 20 z) && cross)

/-- Archive row truth for the 10-tick suffix `[s+10, s+20)` of a 20-tick block. -/
def RowTruth20 (past : SkywalkNat.State) (g sg : Bool) (row : Nat) : Prop :=
  ∀ q : Fin 20, (rawCol q).testBit row =
    letterBit (StairArchiveRaw.read ((SkywalkTrace.trace 20 (encode g sg past.u past.v)).drop 10) (q.val / 2)) q

theorem row_truth20 (j : Fin 9) (ps : Ports) (chron : ∀ i : Fin 20, ps ⟨i, by omega⟩ = nativeRawPort20 j i)
    (row : Nat) (past : SkywalkNat.State) (g sg : Bool) (before out : State)
    (rec : physicalCells20 j before = SkywalkTrace.trace 20 (encode g sg past.u past.v))
    (bk : ∀ i : Fin 23, out.basis (ps ⟨i, by omega⟩) = before.basis (ps ⟨i, by omega⟩))
    (frame : Frame ps raw row out) : RowTruth20 past g sg row := by
  intro q
  let i : Fin 157 := ⟨q, by omega⟩
  have eq : (rawCol q).testBit row = out.basis (ps i) :=
    (congrArg (fun n : Nat => n.testBit row) (io true true i).1).trans (frame i).symm
  have h := native_raw_read20 j before q q.isLt
  rw [rec] at h
  exact eq.trans ((bk ⟨q, by omega⟩).trans ((congrArg before.basis (chron q)).trans h))

private theorem trace_drop_gen (n k : Nat) (z : SkywalkRails.State) :
    (SkywalkTrace.trace (k + n) z).drop k = SkywalkTrace.trace n (SkywalkTrace.next^[k] z) := by
  induction k generalizing z with
  | zero => simp
  | succ k ih =>
    rw [show k + 1 + n = (k + n) + 1 by omega, SkywalkTrace.trace, List.drop_succ_cons,
      Function.iterate_succ_apply]
    exact ih (SkywalkTrace.next z)

theorem row_truth20_chronology (s x p row : Nat) (g sg : Bool)
    (canon : StockWindowTicket.signedAt s x p g sg = WideReference.canonical s x p)
    (h : RowTruth20 (unsigned s x p) g sg row) :
    ArchiveStockRows.Chronology (s + 5) x p row := by
  intro q
  have hq := h q
  change (rawCol q).testBit row =
    letterBit (read ((SkywalkTrace.trace 20 (StockWindowTicket.signedAt s x p g sg)).drop 10) (q.val / 2)) q at hq
  rw [canon] at hq
  have h1 : (SkywalkTrace.trace 20 (WideReference.canonical s x p)).drop 10 =
      SkywalkTrace.trace 10 (SkywalkTrace.next^[10] (WideReference.canonical s x p)) :=
    trace_drop_gen 10 10 (WideReference.canonical s x p)
  have h2 : (SkywalkTrace.trace 15 (WideReference.canonical (s + 5) x p)).drop 5 =
      SkywalkTrace.trace 10 (SkywalkTrace.next^[5] (WideReference.canonical (s + 5) x p)) :=
    trace_drop_gen 10 5 (WideReference.canonical (s + 5) x p)
  have h3 : SkywalkTrace.next^[5] (WideReference.canonical (s + 5) x p) =
      SkywalkTrace.next^[10] (WideReference.canonical s x p) := by
    unfold WideReference.canonical
    rw [← Function.iterate_add_apply, ← Function.iterate_add_apply,
      show 5 + (s + 5) = 10 + s by omega]
  rw [h1, ← h3, ← h2] at hq
  exact hq

end Body20

/-! ### Section 3: Native Heads for All 9 Twenty-Tick Blocks (`NativeJ20`) -/

namespace NativeJ20

set_option maxRecDepth 30000
set_option maxHeartbeats 5000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
attribute [local irreducible] run unrouted20 onRails20 measurementCount

def prev20 (j : Fin 9) : Fin 9 := ⟨j.val - 1, by omega⟩

def packProg20 (j : Fin 9) (d : Bool) : Program :=
  if j.val = 0 then MixedWindow.packW d 165 155
  else MixedWindow.packW d (start20 j) (start20 j - 15) ++ MixedWindow.packW d (start20 j) (start20 j - 10)

def packRev20 (j : Fin 9) (d : Bool) : Program :=
  if j.val = 0 then MixedWindow.unpackW d 165 155
  else MixedWindow.unpackW d (start20 j) (start20 j - 10) ++ MixedWindow.unpackW d (start20 j) (start20 j - 15)

def support20 (j : Fin 9) : List Wire :=
  let r0 := if j.val = 0 then 150 else start20 j - 20
  let cnt := if j.val = 0 then 5 else 10
  (List.range' r0 cnt).flatMap fun v => [OB5.sig (start20 j) (base v), OB5.sig (start20 j) (base (1028 + v))]

def hist20 (s t : Nat) (q : Fin 10) : Wire :=
  OB5.sig s (History5.historyMap base t q)

def archLoad20 (j : Fin 9) (d : Bool) : Program :=
  if j.val = 0 then archiveLoad150To20 d else archiveLoadP20 (prev20 j) d

def archRestore20 (j : Fin 9) (d : Bool) : Program :=
  if j.val = 0 then archiveRestore150To20 d else archiveRestoreP20 (prev20 j) d

def prevRawHead20 (j : Fin 9) : List Wire :=
  if j.val = 0 then Archive150.rawHead else ArchiveJ20.rawHead (prev20 j)

def prevScratch20 (j : Fin 9) : List Wire :=
  if j.val = 0 then Archive150.scratch else ArchiveJ20.scratch (prev20 j)

def prevRawPortsList20 (j : Fin 9) : List Wire :=
  if j.val = 0 then Archive150.rawPortsList else ArchiveJ20.rawPortsList (prev20 j)

def prevRawPorts20 (j : Fin 9) : Ports :=
  if j.val = 0 then Archive150.rawPorts else ArchiveJ20.rawPorts (prev20 j)

def prevCodeTail20 (j : Fin 9) : List Wire :=
  if j.val = 0 then Archive150.codeTail else ArchiveJ20.codeTail (prev20 j)

def prevCodePorts20 (j : Fin 9) : Ports :=
  if j.val = 0 then Archive150.codePorts else ArchiveJ20.codePorts (prev20 j)

def withArchive20 (j : Fin 9) (d : Bool) : Program := packProg20 j d ++ archLoad20 j d
def fromArchive20 (j : Fin 9) (d : Bool) : Program := archRestore20 j d ++ packRev20 j d
def window20 (j : Fin 9) (d : Bool) : Program := body20 j (withArchive20 j d)
def unwind20 (j : Fin 9) (d : Bool) : Program := unbody20 j (fromArchive20 j d)
def nextWindow20 (j : Fin 9) (d : Bool) : Program := enterP20 j ++ window20 j d
def nextUnwind20 (j : Fin 9) (d : Bool) : Program := unwind20 j d ++ enterInvP20 j

theorem block20F_eq (d : Bool) (j : Fin 9) :
    (MixedWindow.block20F d j).flatten = nextWindow20 j d ++ leaveP20Red j := by
  unfold MixedWindow.block20F nextWindow20 window20 body20 withArchive20 packProg20 archLoad20 prev20
  split_ifs <;> simp [List.append_assoc]

theorem block20R_eq (d : Bool) (j : Fin 9) :
    (MixedWindow.block20R d j).flatten = leaveInvP20Red j ++ nextUnwind20 j d := by
  unfold MixedWindow.block20R nextUnwind20 unwind20 unbody20 fromArchive20 packRev20 archRestore20 prev20
  split_ifs <;> simp [List.append_assoc]

private theorem packW_eq (s t : Nat) (hs : s ≤ 511) (ht1 : t ≠ 5) (ht2 : History5.packDue t = true) (d : Bool) :
    MixedWindow.packW d s t = Rolling1588.codeEncodeAt d (hist20 s (t - 5)) ∧
    MixedWindow.unpackW d s t = Rolling1588.codeDecodeAt d (hist20 s (t - 5)) := by
  have lab : ∀ q ∈ Finset.range 10,
      (OB5.sig s ∘ MeasuredCodec5.label (History5.historyMap base (t - 5))) q =
        MeasuredCodec5.label (hist20 s (t - 5)) q := by
    intro q hq
    have lt := Finset.mem_range.mp hq
    simp only [Function.comp, MeasuredCodec5.label, hist20, dif_pos lt]
  constructor
  · unfold MixedWindow.packW Rolling1588.packAtTick Rolling1588.codeEncodeAt
    rw [if_neg ht1, if_pos ht2, renameProgram_comp]
    exact renameProgram_congr_support _ _ _ (fun q hq => lab q ((Rolling1588.code_support d).1 ▸ hq))
  · unfold MixedWindow.unpackW Rolling1588.unpackAtTick Rolling1588.codeDecodeAt
    rw [if_neg ht1, if_pos ht2, renameProgram_comp]
    exact renameProgram_congr_support _ _ _ (fun q hq => lab q ((Rolling1588.code_support d).2 ▸ hq))

private theorem hist20_inj (s t : Nat) (hs : s ≤ 511) (ht : t + 5 ≤ 1028) :
    Function.Injective (hist20 s t) := by
  intro a b eq
  have inv := OB5.sig_invol s hs
  have e := congrArg (OB5.sig s) eq
  simp only [hist20, inv, History5.historyMap, History5.historyId, base] at e
  have ha := a.isLt; have hb := b.isLt
  apply Fin.ext
  split at e <;> split at e <;> simp only [Wire] at * <;> omega

private theorem packW_support (s t : Nat) (hs : s ≤ 511) (ht1 : t ≠ 5) (ht2 : History5.packDue t = true) (d : Bool)
    (sup : List Wire) (hmem : ∀ q : Fin 10, hist20 s (t - 5) q ∈ sup) :
    wires (MixedWindow.packW d s t) ⊆ sup.toFinset ∧ wires (MixedWindow.unpackW d s t) ⊆ sup.toFinset := by
  rw [(packW_eq s t hs ht1 ht2 d).1, (packW_eq s t hs ht1 ht2 d).2,
    Rolling1588.codeEncodeAt, Rolling1588.codeDecodeAt, renameProgram_support, renameProgram_support,
    (Rolling1588.code_support d).1, (Rolling1588.code_support d).2]
  have img : Finset.image (MeasuredCodec5.label (hist20 s (t - 5))) (Finset.range 10) ⊆ sup.toFinset := by
    intro q hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
    have lt := Finset.mem_range.mp hw
    simp only [MeasuredCodec5.label, dif_pos lt, List.mem_toFinset]
    exact hmem ⟨w, lt⟩
  exact ⟨img, img⟩

private theorem hist20_in_support (j : Fin 9) {t : Nat} (ht1 : (if j.val = 0 then 150 else start20 j - 20) ≤ t)
    (ht2 : t + 5 ≤ (if j.val = 0 then 150 else start20 j - 20) + (if j.val = 0 then 5 else 10)) (q : Fin 10) :
    hist20 (start20 j) t q ∈ support20 j := by
  have hq := q.isLt
  simp only [hist20, support20, History5.historyMap, History5.historyId, List.mem_flatMap,
    List.mem_range'_1, List.mem_cons, List.not_mem_nil, or_false]
  refine ⟨t + q.val / 2, ⟨by omega, by omega⟩, ?_⟩
  split
  · exact Or.inl rfl
  · right; congr 2; omega

theorem pack_codes20 (j : Fin 9) (d : Bool) :
    wires (packProg20 j d) ⊆ (support20 j).toFinset ∧ wires (packRev20 j d) ⊆ (support20 j).toFinset := by
  have hj := j.isLt
  unfold packProg20 packRev20
  by_cases h0 : j.val = 0
  · simp only [h0, ↓reduceIte]
    have hs : start20 j = 165 := by simp [start20, h0]
    rw [← hs]
    exact packW_support (start20 j) 155 (by omega) (by decide) (by decide) d (support20 j)
      (fun q => hist20_in_support j (by simp [h0]) (by simp [h0]) q)
  · simp only [h0, ↓reduceIte, wires_append, Finset.union_subset_iff]
    have hdue1 : History5.packDue (start20 j - 15) = true := by
      simp only [History5.packDue, start20, decide_eq_true_eq]; omega
    have hdue2 : History5.packDue (start20 j - 10) = true := by
      simp only [History5.packDue, start20, decide_eq_true_eq]; omega
    have p1 := packW_support (start20 j) (start20 j - 15) (by simp [start20]; omega)
      (by simp [start20]; omega) hdue1 d (support20 j)
      (fun q => hist20_in_support j (by simp [h0]; omega) (by simp [h0]; omega) q)
    have p2 := packW_support (start20 j) (start20 j - 10) (by simp [start20]; omega)
      (by simp [start20]; omega) hdue2 d (support20 j)
      (fun q => hist20_in_support j (by simp [h0]; omega) (by simp [h0]; omega) q)
    exact ⟨⟨p1.1, p2.1⟩, ⟨p2.2, p1.2⟩⟩

private theorem watch20_disj_all : ∀ j : Fin 9,
    (watch20 j).all (fun q => decide (q ∉ support20 j)) = true ∧
    (watch20 j).all (fun q => decide (q ∉ prevRawHead20 j)) = true := by
  decide +kernel

theorem pack_retains20 (j : Fin 9) (d back : Bool) (s : State) (m : List Bool) :
    ∀ q ∈ watch20 j, (run (if back then packRev20 j d else packProg20 j d) m s).basis q = s.basis q := by
  intro q hq
  apply run_preserves_outside
  intro used
  have seen : q ∈ (support20 j).toFinset := by
    cases back
    · exact (pack_codes20 j d).1 used
    · exact (pack_codes20 j d).2 used
  exact (of_decide_eq_true (List.all_eq_true.mp (watch20_disj_all j).1 q hq)) (List.mem_toFinset.mp seen)

def PackLegal20 (j : Fin 9) (b : BasisState) : Prop :=
  if j.val = 0 then MeasuredCodec5.legalAt (hist20 165 150) b
  else MeasuredCodec5.legalAt (hist20 (start20 j) (start20 j - 20)) b ∧
       MeasuredCodec5.legalAt (hist20 (start20 j) (start20 j - 15)) b

theorem pack_source_law20 (j : Fin 9) (d : Bool) (s : State) (m : List Bool) (ok : PackLegal20 j s.basis) :
    (run (packProg20 j d) m s).phase = s.phase ∧
    ∀ t, run (packRev20 j d) t (run (packProg20 j d) m s) = s := by
  have hj := j.isLt
  simp only [packProg20, packRev20, PackLegal20] at ok ⊢
  by_cases h0 : j.val = 0
  · simp only [h0, ↓reduceIte] at ok ⊢
    obtain ⟨e1, e2⟩ := packW_eq 165 155 (by decide) (by decide) (by decide) d
    rw [e1, e2]
    exact ⟨(Rolling1588.codeEncodeAt_correct d _ (hist20_inj 165 150 (by decide) (by decide)) s m ok).1,
      fun t => Rolling1588.codeRoundtripAt d _ (hist20_inj 165 150 (by decide) (by decide)) s m t ok⟩
  · simp only [h0, ↓reduceIte] at ok ⊢
    have hs : start20 j ≤ 511 := by simp [start20]; omega
    have hdue1 : History5.packDue (start20 j - 15) = true := by
      simp only [History5.packDue, start20, decide_eq_true_eq]; omega
    have hdue2 : History5.packDue (start20 j - 10) = true := by
      simp only [History5.packDue, start20, decide_eq_true_eq]; omega
    obtain ⟨e1f, e1r⟩ := packW_eq (start20 j) (start20 j - 15) hs (by simp [start20]; omega) hdue1 d
    obtain ⟨e2f, e2r⟩ := packW_eq (start20 j) (start20 j - 10) hs (by simp [start20]; omega) hdue2 d
    have hsub1 : start20 j - 15 - 5 = start20 j - 20 := by omega
    have hsub2 : start20 j - 10 - 5 = start20 j - 15 := by omega
    rw [hsub1] at e1f e1r; rw [hsub2] at e2f e2r
    have inj1 := hist20_inj (start20 j) (start20 j - 20) hs (by simp [start20]; omega)
    have inj2 := hist20_inj (start20 j) (start20 j - 15) hs (by simp [start20]; omega)
    have hdisj : ∀ a b : Fin 10, hist20 (start20 j) (start20 j - 20) a ≠ hist20 (start20 j) (start20 j - 15) b := by
      intro a b eq
      have inv := OB5.sig_invol (start20 j) hs
      have e := congrArg (OB5.sig (start20 j)) eq
      simp only [hist20, inv, History5.historyMap, History5.historyId, base] at e
      have ha := a.isLt; have hb := b.isLt
      split at e <;> split at e <;> simp only [start20, Wire] at * <;> omega
    let mid := run (MixedWindow.packW d (start20 j) (start20 j - 15)) m s
    have hkeep2 : ∀ q : Fin 10, mid.basis (hist20 (start20 j) (start20 j - 15) q) =
        s.basis (hist20 (start20 j) (start20 j - 15) q) := by
      intro q
      apply run_preserves_outside
      rw [e1f, Rolling1588.codeEncodeAt, renameProgram_support, (Rolling1588.code_support d).1]
      intro hmem
      obtain ⟨w, hw, heq⟩ := Finset.mem_image.mp hmem
      have lt := Finset.mem_range.mp hw
      simp only [MeasuredCodec5.label, dif_pos lt] at heq
      exact hdisj ⟨w, lt⟩ q heq
    have ok2 : MeasuredCodec5.legalAt (hist20 (start20 j) (start20 j - 15)) mid.basis :=
      legal_congr hkeep2 ok.2
    have p1 := Rolling1588.codeEncodeAt_correct d _ inj1 s m ok.1
    have p2 := Rolling1588.codeEncodeAt_correct d _ inj2 mid
      (m.drop (measurementCount (MixedWindow.packW d (start20 j) (start20 j - 15)))) ok2
    rw [run_append, run_take]
    refine ⟨?_, fun t => ?_⟩
    · rw [e2f]; exact p2.1.trans (by simpa [mid, e1f] using p1.1)
    · rw [run_append, run_take]
      have r2 := Rolling1588.codeRoundtripAt d _ inj2 mid
        (m.drop (measurementCount (MixedWindow.packW d (start20 j) (start20 j - 15)))) t ok2
      rw [← e2f, ← e2r] at r2
      have r1 := Rolling1588.codeRoundtripAt d _ inj1 s m
        (t.drop (measurementCount (MixedWindow.unpackW d (start20 j) (start20 j - 10)))) ok.1
      rw [← e1f, ← e1r] at r1
      change run (MixedWindow.unpackW d (start20 j) (start20 j - 15)) _
        (run (MixedWindow.unpackW d (start20 j) (start20 j - 10)) t
          (run (MixedWindow.packW d (start20 j) (start20 j - 10)) _ mid)) = s
      rw [r2, r1]

private theorem moves_wires20 (ps : List (Wire × Wire)) :
    ∀ q ∈ wires (moves ps), ∃ p ∈ ps, q = p.1 ∨ q = p.2 := by
  induction ps with
  | nil => intro q h; simp [moves, wires] at h
  | cons p ps ih =>
    intro q h
    obtain ⟨a, b⟩ := p
    simp only [moves, List.flatMap_cons, wires_append, Finset.mem_union] at h
    rcases h with h | h
    · refine ⟨(a, b), List.mem_cons_self, ?_⟩
      simp [swapBits, wires, Instr.wires] at h ⊢; tauto
    · obtain ⟨p', hp', e⟩ := ih q (by simpa [moves] using h)
      exact ⟨p', List.mem_cons_of_mem _ hp', e⟩

theorem prevArch_load_cover (j : Fin 9) (d : Bool) :
    wires (archLoad20 j d) ⊆ (prevRawPortsList20 j).toFinset := by
  unfold archLoad20 prevRawPortsList20
  by_cases h0 : j.val = 0
  · simp only [h0, ↓reduceIte]
    have hprog : archiveLoad150To20 d =
        placed Archive150.loadMap (ArchivePortAction.op true d) ++
        moves Archive150.loadMoves := by cases d <;> rfl
    rw [hprog, wires_append, Finset.union_subset_iff]
    constructor
    · rw [StairArchiveIntegerHook.placed, renameProgram_support]
      intro q hq
      obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      have small : w < 155 := by cases d; exact Partial.load1_ports w hw; exact Partial.load0_ports w hw
      rw [List.mem_toFinset]
      have eq : Archive150.loadMap w = Archive150.rawPortsList.getD w 0 := by
        simp only [Archive150.loadMap, Archive150.rawPortsList]
        rw [List.getD_append _ _ _ _ (by simp [loadPorts150, cellsLoadP]; exact small)]
      rw [eq, List.getD_eq_getElem?_getD,
        List.getElem?_eq_getElem (by rw [Archive150.rawLength]; unfold Wire at *; omega), Option.getD_some]
      exact List.getElem_mem _
    · intro q hq
      obtain ⟨p, hp, e⟩ := moves_wires20 _ q hq
      have hm : ∀ r ∈ Archive150.loadMoves, r.1 ∈ Archive150.rawHead ∧ r.2 ∈ Archive150.rawHead := by decide +kernel
      obtain ⟨h1, h2⟩ := hm p hp
      rw [List.mem_toFinset, Archive150.raw_split]
      rcases e with rfl | rfl
      · exact List.mem_append_left _ h1
      · exact List.mem_append_left _ h2
  · simp only [h0, ↓reduceIte]
    rw [ArchiveJ20.load_program, wires_append, Finset.union_subset_iff]
    constructor
    · rw [StairArchiveIntegerHook.placed, renameProgram_support]
      intro q hq
      obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      have small : w < 155 := by cases d; exact Partial.load1_ports w hw; exact Partial.load0_ports w hw
      rw [ArchiveJ20.load_map (prev20 j) ⟨w, small⟩, List.mem_toFinset, ArchiveJ20.rawPorts,
        List.getD_eq_getElem?_getD,
        List.getElem?_eq_getElem (by rw [ArchiveJ20.rawLength]; omega), Option.getD_some]
      exact List.getElem_mem _
    · intro q hq
      obtain ⟨p, hp, e⟩ := moves_wires20 _ q hq
      have hm : ∀ k : Fin 9, ∀ r ∈ ArchiveJ20.loadMoves k,
          r.1 ∈ ArchiveJ20.rawHead k ∧ r.2 ∈ ArchiveJ20.rawHead k := by decide +kernel
      obtain ⟨h1, h2⟩ := hm (prev20 j) p hp
      rw [List.mem_toFinset, ArchiveJ20.raw_split]
      rcases e with rfl | rfl
      · exact List.mem_append_left _ h1
      · exact List.mem_append_left _ h2

theorem prevRaw_split (j : Fin 9) : prevRawPortsList20 j = prevRawHead20 j ++ prevScratch20 j := by
  unfold prevRawPortsList20 prevRawHead20 prevScratch20
  split_ifs
  · exact Archive150.raw_split
  · exact ArchiveJ20.raw_split (prev20 j)

theorem prevRawHead_mem (j : Fin 9) (k : Fin 157) (hk : k.val < 23) :
    prevRawPorts20 j k ∈ prevRawHead20 j := by
  unfold prevRawPorts20 prevRawHead20
  split_ifs
  · have e : Archive150.rawPorts k = Archive150.rawHead.getD k 0 := by
      rw [Archive150.rawPorts, Archive150.raw_split, List.getD_append _ _ _ _ (by simp [Archive150.rawHead, cellsLoadP]; omega)]
    rw [e, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem (by simp [Archive150.rawHead, cellsLoadP]; omega), Option.getD_some]
    exact List.getElem_mem _
  · have e : ArchiveJ20.rawPorts (prev20 j) k = (ArchiveJ20.rawHead (prev20 j)).getD k 0 := by
      rw [ArchiveJ20.rawPorts, ArchiveJ20.raw_split,
        List.getD_append _ _ _ _ (by simp [ArchiveJ20.rawHead, cellsLoadP]; omega)]
    rw [e, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem (by simp [ArchiveJ20.rawHead, cellsLoadP]; omega), Option.getD_some]
    exact List.getElem_mem _

theorem prevScratch_code (j : Fin 9) (k : Fin 157) (hk : 23 ≤ k.val) :
    prevRawPorts20 j k = prevCodePorts20 j ⟨k.val - 7, by omega⟩ := by
  unfold prevRawPorts20 prevCodePorts20
  split_ifs
  · have a := Archive150.raw_scratch (k := k.val - 23) (by omega)
    have b := Archive150.code_scratch (k := k.val - 23) (by omega)
    rw [show 23 + (k.val - 23) = k.val by omega] at a
    rw [show 16 + (k.val - 23) = k.val - 7 by omega] at b
    exact a.trans b.symm
  · have a := ArchiveJ20.raw_scratch (prev20 j) (k := k.val - 23) (by omega)
    have b := ArchiveJ20.code_scratch (prev20 j) (k := k.val - 23) (by omega)
    rw [show 23 + (k.val - 23) = k.val by omega] at a
    rw [show 16 + (k.val - 23) = k.val - 7 by omega] at b
    exact a.trans b.symm

theorem prevArch_load_run (j : Fin 9) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m : List Bool)
    (ready : Frame (prevRawPorts20 j) raw row s) :
    let t := run (archLoad20 j d) m s
    t.phase = s.phase ∧ Frame (prevCodePorts20 j) (code d) row t ∧
      ∀ q, (∀ k, prevRawPorts20 j k ≠ q) → t.basis q = s.basis q := by
  simp only [archLoad20, prevRawPorts20, prevCodePorts20] at ready ⊢
  split_ifs at ready ⊢
  · exact Archive150.load_run d row hr s m ready
  · exact ArchiveJ20.load_run (prev20 j) d row hr s m ready

theorem prevArch_roundtrip (j : Fin 9) (d : Bool) (row : Nat) (hr : row < 63145) (s : State) (m n : List Bool)
    (ready : Frame (prevRawPorts20 j) raw row s) :
    run (archRestore20 j d) n (run (archLoad20 j d) m s) = s := by
  simp only [archLoad20, archRestore20, prevRawPorts20] at ready ⊢
  split_ifs at ready ⊢
  · exact Archive150.roundtrip d row hr s m n ready
  · exact ArchiveJ20.roundtrip (prev20 j) d row hr s m n ready

theorem retain_watch20 (j : Fin 9) (d : Bool) (row : Nat) (s t : State)
    (clean : ∀ k : Fin 157, 23 ≤ k.val → prevRawPorts20 j k ∈ watch20 j → s.basis (prevRawPorts20 j k) = false)
    (frame : Frame (prevCodePorts20 j) (code d) row t)
    (outside : ∀ q, (∀ k, prevRawPorts20 j k ≠ q) → t.basis q = s.basis q) :
    ∀ q ∈ watch20 j, t.basis q = s.basis q := by
  intro q h
  by_cases mem : ∃ k, prevRawPorts20 j k = q
  · obtain ⟨k, rfl⟩ := mem
    have hk : 23 ≤ k.val := by
      by_contra! bad
      exact (of_decide_eq_true (List.all_eq_true.mp (watch20_disj_all j).2 _ h)) (prevRawHead_mem j k bad)
    rw [clean k hk h, prevScratch_code j k hk, frame, archive_blank _ _ (by dsimp; omega), Nat.zero_testBit]
  · exact outside _ (fun k eq => mem ⟨k, eq⟩)

theorem admin20 (j : Fin 9) (d : Bool) (s : State) (m : List Bool) (z : SkywalkRails.State)
    (active : onRails20 j 1 z s.basis) (ok : PackLegal20 j s.basis)
    (row : Nat) (limit : row < 63145)
    (raw0 : Frame (prevRawPorts20 j) raw row (run (packProg20 j d) m s))
    (clean : ∀ k : Fin 157, 23 ≤ k.val → prevRawPorts20 j k ∈ watch20 j →
      (run (packProg20 j d) m s).basis (prevRawPorts20 j k) = false) :
    let out := run (withArchive20 j d) m s
    AdminResult20 j (fromArchive20 j d) s out ∧ Frame (prevCodePorts20 j) (code d) row out := by
  let p := run (packProg20 j d) m s
  let tape := m.drop (measurementCount (packProg20 j d))
  let a := run (archLoad20 j d) tape p
  have old := pack_source_law20 j d s m ok
  have stay := pack_retains20 j d false s m
  have arr := prevArch_load_run j d row limit p tape raw0
  have untouched := retain_watch20 j d row p a clean arr.2.1 arr.2.2
  dsimp only [withArchive20, fromArchive20]
  simp only [run_append, run_take]
  refine ⟨⟨arr.1.trans old.1, fun q h => (untouched _ h).trans (stay _ h), ?_⟩, arr.2.1⟩
  intro n
  rw [run_append, run_take]
  change run (packRev20 j d) _ (run (archRestore20 j d) _ a) = s
  rw [prevArch_roundtrip j d row limit p tape _ raw0]
  exact old.2 _

theorem window20_run (j : Fin 9) (d : Bool) (s : State) (m : List Bool) (z : SkywalkRails.State)
    (odd : (z.a + z.b) % 2 = 1) (start0 : onRails20 j 0 z s.basis)
    (legal : PackLegal20 j (run (routed20 j 0 1) m s).basis)
    (row : Nat) (limit : row < 63145)
    (frame : Frame (prevRawPorts20 j) raw row
      (run (packProg20 j d) (m.drop (measurementCount (routed20 j 0 1))) (run (routed20 j 0 1) m s)))
    (clean : ∀ k : Fin 157, 23 ≤ k.val → prevRawPorts20 j k ∈ watch20 j →
      (run (packProg20 j d) (m.drop (measurementCount (routed20 j 0 1))) (run (routed20 j 0 1) m s)).basis
        (prevRawPorts20 j k) = false) :
    let out := run (window20 j d) m s
    out.phase = s.phase ∧ onRails20 j 20 (SkywalkTrace.next^[20] z) out.basis ∧
      readCells (shape20 j) 0 20 (mappedBasis20 j out.basis) = SkywalkTrace.trace 20 z ∧
      ∀ n, run (unwind20 j d) n out = s := by
  apply body20_run _ _ _ _ _ z odd start0
  exact (admin20 j d _ _ (SkywalkTrace.next z) (route20_frame j 0 1 (by decide) z odd s m start0).2
    legal row limit frame clean).1

private theorem forwardTargets20 : ∀ g ∈ EnterProof17.forward,
    CodecBitSliceVerify.target g ≠ 4 ∧ CodecBitSliceVerify.target g < EnterProof17.width := by
  decide +kernel

theorem enterTargets20 (j : Fin 9) : ∀ g ∈ enterP20 j,
    CodecBitSliceVerify.target g ≠ EnterJ20.gate j ∧ CodecBitSliceVerify.target g ∈ EnterJ20.ports j := by
  intro g hg
  rw [EnterJ20.emitted j, renameProgram, List.mem_map] at hg
  obtain ⟨g0, h0, rfl⟩ := hg
  have t : CodecBitSliceVerify.target (renameInstr (EnterJ20.map j) g0) =
      EnterJ20.map j (CodecBitSliceVerify.target g0) := by cases g0 <;> rfl
  obtain ⟨n4, lt⟩ := forwardTargets20 g0 h0
  rw [t]
  refine ⟨fun e => n4 ?_, ?_⟩
  · have same := EnterJ20.inc j ⟨_, lt⟩ ⟨4, by decide⟩ (e.trans (rfl : EnterJ20.gate j = EnterJ20.map j 4))
    exact congrArg Fin.val same
  · rw [EnterJ20.map, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem (by rw [EnterJ20.ports_length]; exact lt), Option.getD_some]
    exact List.getElem_mem _

theorem enter20_readonly (j : Fin 9) {q : Wire} (h : q ∉ EnterJ20.ports j ∨ q = EnterJ20.gate j) :
    ∀ g ∈ enterP20 j, CodecBitSliceVerify.target g ≠ q := by
  intro g hg eq
  obtain ⟨ng, mp⟩ := enterTargets20 j g hg
  rcases h with h | h
  · exact h (eq ▸ mp)
  · exact ng (eq.trans h)

private theorem heads20_all : ∀ j : Fin 9,
    (∀ q ∈ prevRawHead20 j, FirstFree20 j (windowNet20 j q) ∧
      (q ∉ EnterJ20.ports j ∨ q = EnterJ20.gate j) ∧ q ∉ support20 j) ∧
    (j.val = 0 →
      (∀ r : Fin 5, hist20 165 150 ⟨2 * r.val, by omega⟩ =
          windowNet MixedWindow.j7 (IntegerPacket.ports (Shadow7.shape MixedWindow.j7) r).a0 ∧
        hist20 165 150 ⟨2 * r.val + 1, by omega⟩ =
          windowNet MixedWindow.j7 (IntegerPacket.ports (Shadow7.shape MixedWindow.j7) r).history) ∧
      (∀ i : Fin 10, FirstFree20 j (windowNet20 j (hist20 165 150 i)) ∧ hist20 165 150 i ∉ EnterJ20.ports j) ∧
      (∀ k : Fin 20, Archive150.rawPorts ⟨k, by omega⟩ = nativeRawPort MixedWindow.j7 k)) ∧
    (0 < j.val →
      (∀ r : Fin 5, hist20 (start20 j) (start20 j - 20) ⟨2 * r.val, by omega⟩ =
          windowNet20 (prev20 j) (IntegerPacket.ports (shape20 (prev20 j)) r).a0 ∧
        hist20 (start20 j) (start20 j - 20) ⟨2 * r.val + 1, by omega⟩ =
          windowNet20 (prev20 j) (IntegerPacket.ports (shape20 (prev20 j)) r).history) ∧
      (∀ r : Fin 5, hist20 (start20 j) (start20 j - 15) ⟨2 * r.val, by omega⟩ =
          windowNet20 (prev20 j) (IntegerPacket.ports (shape20 (prev20 j)) (r.val + 5)).a0 ∧
        hist20 (start20 j) (start20 j - 15) ⟨2 * r.val + 1, by omega⟩ =
          windowNet20 (prev20 j) (IntegerPacket.ports (shape20 (prev20 j)) (r.val + 5)).history) ∧
      (∀ i : Fin 10, FirstFree20 j (windowNet20 j (hist20 (start20 j) (start20 j - 20) i)) ∧
        hist20 (start20 j) (start20 j - 20) i ∉ EnterJ20.ports j) ∧
      (∀ i : Fin 10, FirstFree20 j (windowNet20 j (hist20 (start20 j) (start20 j - 15) i)) ∧
        hist20 (start20 j) (start20 j - 15) i ∉ EnterJ20.ports j) ∧
      (∀ k : Fin 20, ArchiveJ20.rawPorts (prev20 j) ⟨k, by omega⟩ = nativeRawPort20 (prev20 j) k)) := by
  decide +kernel

theorem bank_kept20 (j : Fin 9) (d : Bool) (s : State) (e t p : List Bool)
    (z : SkywalkRails.State) (odd : (z.a + z.b) % 2 = 1)
    (active : onRails20 j 0 z (run (enterP20 j) e s).basis) :
    let now := run (packProg20 j d) p (run (routed20 j 0 1) t (run (enterP20 j) e s))
    ∀ i : Fin 23, now.basis (prevRawPorts20 j ⟨i, by omega⟩) = s.basis (prevRawPorts20 j ⟨i, by omega⟩) := by
  dsimp only
  intro i
  obtain ⟨f, no, sup⟩ := (heads20_all j).1 _ (prevRawHead_mem j ⟨i, by omega⟩ i.isLt)
  exact (run_preserves_outside _ _ _ _ (fun h => sup (List.mem_toFinset.mp ((pack_codes20 j d).1 h)))).trans
    ((first_preserves20 j _ odd _ t active _ (firstFree20 j f)).trans
      (preserve_readonly _ _ (enter20_readonly j no) s e))

/-- Unified previous-block archive facts (15-tick `j7` for `j = 0`, 20-tick `prev20 j` for `j > 0`). -/
def PrevPast20 (j : Fin 9) (past : SkywalkNat.State) (pg ps cross : Bool) (s : State) : Prop :=
  if j.val = 0 then
    PastFacts MixedWindow.j7 Archive150.rawPorts (Shadow7.sbP 150) past pg ps cross s
  else
    PastFacts20 (prev20 j) (ArchiveJ20.rawPorts (prev20 j)) past pg ps cross s

def PrevSmall20 (j : Fin 9) (past : SkywalkNat.State) : Prop :=
  if j.val = 0 then Shadow7.SmallIfFar (Shadow7.sbP 150) 15 past
  else Shadow7.SmallIfFar (sbP20 (start20 (prev20 j))) 20 past

def PrevRowTruth20 (j : Fin 9) (past : SkywalkNat.State) (pg ps : Bool) (row : Nat) : Prop :=
  if j.val = 0 then RowTruth past pg ps row
  else RowTruth20 past pg ps row

theorem admits20 (j : Fin 9) (d : Bool) (before : State) (et first pack : List Bool)
    (nowZ : SkywalkRails.State) (parity : (nowZ.a + nowZ.b) % 2 = 1)
    (ready : onRails20 j 0 nowZ (run (enterP20 j) et before).basis)
    (scratch : ∀ k : Fin 157, 23 ≤ k.val →
      (run (packProg20 j d) pack (run (routed20 j 0 1) first (run (enterP20 j) et before))).basis
        (prevRawPorts20 j k) = false)
    (past : SkywalkNat.State) (pg ps cross : Bool) (odd : past.v % 2 = 1)
    (small : PrevSmall20 j past) (prior : PrevPast20 j past pg ps cross before) :
    let src := run (routed20 j 0 1) first (run (enterP20 j) et before)
    let out := run (packProg20 j d) pack src
    PackLegal20 j src.basis ∧
    ∃ row < 63145, PrevRowTruth20 j past pg ps row ∧ Frame (prevRawPorts20 j) raw row out := by
  dsimp only
  have bk := bank_kept20 j d before et first pack nowZ parity ready
  simp only [PackLegal20, PrevSmall20, PrevPast20, PrevRowTruth20, prevRawPorts20] at small prior bk scratch ⊢
  by_cases h0 : j.val = 0
  · simp only [h0, ↓reduceIte] at small prior bk scratch ⊢
    obtain ⟨hcells, hfree, hchron⟩ := (heads20_all j).2.1 h0
    have hleg : MeasuredCodec5.legalAt (hist20 165 150) (run (routed20 j 0 1) first (run (enterP20 j) et before)).basis := by
      apply (MeasuredCodec5.legalAt_iff _ _).mpr
      intro i
      obtain ⟨f1, no1⟩ := hfree ⟨2 * i.val, by omega⟩
      obtain ⟨f2, no2⟩ := hfree ⟨2 * i.val + 1, by omega⟩
      have k1 := (first_preserves20 j _ parity _ first ready _ (firstFree20 j f1)).trans
        (run_preserves_outside _ _ _ _ (EnterJ20.notWire j no1))
      have k2 := (first_preserves20 j _ parity _ first ready _ (firstFree20 j f2)).trans
        (run_preserves_outside _ _ _ _ (EnterJ20.notWire j no2))
      rw [k1, k2, (hcells i).1, (hcells i).2]
      have legal15 : StairArchiveRaw.legal (readCells (Shadow7.shape MixedWindow.j7) 0 15
          (mappedBasis MixedWindow.j7 before.basis)) := by
        rw [Shadow7.readCells_eq, show readCells (StairPacket.shape MixedWindow.j7) 0 15 _ =
            StairPacket.physicalCells MixedWindow.j7 before from rfl, prior.records]
        exact legal_signed 15 past pg ps (by omega) odd
      have good := legal15 _ (member_cell (Shadow7.shape MixedWindow.j7) 15 0 i _ (by have := i.isLt; omega))
      apply not_both; simpa only [Nat.zero_add, cell, mappedBasis] using good
    let cells := Shadow7.physicalCells MixedWindow.j7 before
    let f := decide (Shadow.far (Shadow7.sbP 150) 15 past)
    let u := f && afterFlags (decide (past.v < past.u)) (cells.take 5)
    let c := f && cross
    let data := rawBit (read (cells.drop 5)) f u c
    obtain ⟨row, lim, matchRow⟩ := interrupted_row_shadow7 (Shadow7.sbP 150) past small odd pg ps cross _
      ((Shadow7.physicalCells_eq MixedWindow.j7 before).trans (prior.records.trans (true_records_shadow7 _ _ small odd _ _).symm))
    have hrec : ∀ i : Fin 157, i.val < 23 →
        (run (packProg20 j d) pack (run (routed20 j 0 1) first (run (enterP20 j) et before))).basis
          (Archive150.rawPorts i) = data i := by
      intro k hk
      by_cases y : k.val < 20
      · refine (bk ⟨k, hk⟩).trans ?_
        rw [hchron ⟨k, y⟩]
        exact (Shadow7.native_raw_read MixedWindow.j7 before k y).trans (by simp [data, cells, Shadow7.physicalCells, rawBit, y])
      · have eq : k = 20 ∨ k = 21 ∨ k = 22 := by omega
        rcases eq with rfl | rfl | rfl
        · exact (bk 20).trans prior.far
        · exact (bk 21).trans (by simpa [u, cells, Shadow7.physicalCells_eq] using prior.suffix)
        · exact (bk 22).trans prior.crossed
    have fr := starting_frame Archive150.rawPorts _ row data matchRow hrec scratch
    have rt := row_truth MixedWindow.j7 Archive150.rawPorts hchron row past pg ps before _ prior.records bk fr
    exact ⟨hleg, row, lim, rt, fr⟩
  · simp only [h0, ↓reduceIte] at small prior bk scratch ⊢
    obtain ⟨hc1, hc2, hf1, hf2, hchron⟩ := (heads20_all j).2.2 (by omega)
    have legal20 : StairArchiveRaw.legal (physicalCells20 (prev20 j) before) := by
      rw [prior.records]; exact legal_signed 20 past pg ps (by omega) odd
    have mkLeg : ∀ (t off : Nat) (hoff : off + 5 ≤ 20)
        (hc : ∀ r : Fin 5, hist20 (start20 j) t ⟨2 * r.val, by omega⟩ =
            windowNet20 (prev20 j) (IntegerPacket.ports (shape20 (prev20 j)) (r.val + off)).a0 ∧
          hist20 (start20 j) t ⟨2 * r.val + 1, by omega⟩ =
            windowNet20 (prev20 j) (IntegerPacket.ports (shape20 (prev20 j)) (r.val + off)).history)
        (hf : ∀ i : Fin 10, FirstFree20 j (windowNet20 j (hist20 (start20 j) t i)) ∧
          hist20 (start20 j) t i ∉ EnterJ20.ports j),
        MeasuredCodec5.legalAt (hist20 (start20 j) t)
          (run (routed20 j 0 1) first (run (enterP20 j) et before)).basis := by
      intro t off hoff hc hf
      apply (MeasuredCodec5.legalAt_iff _ _).mpr
      intro i
      obtain ⟨f1, no1⟩ := hf ⟨2 * i.val, by omega⟩
      obtain ⟨f2, no2⟩ := hf ⟨2 * i.val + 1, by omega⟩
      have k1 := (first_preserves20 j _ parity _ first ready _ (firstFree20 j f1)).trans
