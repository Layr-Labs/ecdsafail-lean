theorem entry20_bm1 (j : Fin 9) (s : State) (m : List Bool) (a : SkywalkNat.State) (G sg : Bool)
    (ready : onRails20 j 20 (SkywalkRails.encode G sg a.u a.v) s.basis)
    (fresh : s.basis (e0P20 (start20 j) + 5) = false)
    (scratch : ∀ q ∈ 1556 :: 1557 :: 1558 :: fullC20, s.basis q = false)
    (temp : ∀ p ∈ longPairs20 j, s.basis p.2 = false) :
    (run (GateMirror.forward (entryLeave20 (start20 j))) m s).basis (b0P20 (start20 j) - 1) =
      ((a.u - (PortalValues.negative sg a.u).toNat) / 2 ^ sbP20 (start20 j)).testBit 0 := by
