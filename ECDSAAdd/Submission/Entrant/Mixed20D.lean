  have c76 : v.basis 1576 = false := by
    obtain ⟨a1, a2, a3⟩ := away 1576 (by omega)
    rw [same _ a1 a2 a3]
    exact scratch _ (by
      simp only [List.mem_cons, fullC20, List.mem_map, List.mem_range]; right; right; right; exact ⟨17, by omega, rfl⟩)
  have h0 := (scanActual.2.2.1 0 (by decide)).2
