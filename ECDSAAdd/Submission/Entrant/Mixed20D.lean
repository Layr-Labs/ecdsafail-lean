    (past : SkywalkNat.State) (pg ps cross : Bool) (po : past.v % 2 = 1) (pm : Shadow7.SmallIfFar (sbP20 325) 20 past)
    (prior : PastFacts20 k8 (ArchiveJ20.rawPorts k8) past pg ps cross s) :
