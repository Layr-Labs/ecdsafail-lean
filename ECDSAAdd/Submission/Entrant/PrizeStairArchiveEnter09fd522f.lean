set_option maxHeartbeats 5000000

theorem leave1_checked : eval  leave1 leave1Trace0In = (true, leave1Trace2Out) := by
  have shape : leave1 = ((leave1Block0 ++ leave1Block1 ++ leave1Block2 ++ leave1Block3 ++ leave1Block4 ++ leave1Block5 ++ leave1Block6 ++ leave1Block7) ++ ((leave1Block8 ++ leave1Block9 ++ leave1Block10 ++ leave1Block11 ++ leave1Block12 ++ leave1Block13 ++ leave1Block14 ++ leave1Block15) ++ (leave1Block16 ++ leave1Block17 ++ leave1Block18 ++ leave1Block19 ++ leave1Block20))) := by
    simp only [leave1, List.append_assoc]
  rw [shape]
  exact (StairArchiveRows.combine _ _ _ _ _ _ leave1Trace0_checked (StairArchiveRows.combine _ _ _ _ _ _ leave1Trace1_checked leave1Trace2_checked))

private theorem leave1_target : ∀ i ∈ leave1, target i < 113 := by decide +kernel

theorem leave1_run (row x : Nat) (m : List Bool) (s : State)
    (active : ( : Nat).testBit row = true)
    (input : Rel leave1Trace0In x row) (state : ∀ q ∈ wires leave1, s.basis q = x.testBit q) :
    (run leave1 m s).phase = s.phase ∧
    (∀ q ∈ wires leave1, (run leave1 m s).basis q = (get leave1Trace2Out q).testBit row) ∧
    (∀ q ∉ wires leave1, (run leave1 m s).basis q = s.basis q) :=
  StairArchiveRows.run_row leave1 _ row x m s leave1Trace0In leave1Trace2Out active leave1_target input leave1_checked state

end ECDSAAdd.Entrant.StairArchiveGates

end

