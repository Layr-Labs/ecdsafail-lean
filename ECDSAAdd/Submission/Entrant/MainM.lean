theorem signBracket_sub :
    wires signBracket ⊆ insert signHost (tagSites.toFinset ∪ signPayload.toFinset) := by
  have localSupport : wires prefixSignCircuit ⊆ Finset.range 13 := by decide +kernel
  have small : wires prefixParity ⊆ insert signHost tagSites.toFinset := by
    intro q hq
    rw [prefixParity, renameProgram_support] at hq
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hq
    have bound : i < 13 := Finset.mem_range.mp (localSupport hi)
    by_cases eq : i = 12
    · simp [eq]
    · simp only [if_neg eq]
      exact Finset.mem_insert_of_mem (List.mem_toFinset.mpr (prefixLoanPort_mem i (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ bound) eq)))
  intro q hq
  rw [signBracket, wires_append, Finset.mem_union] at hq
  rcases hq with h | h
  · rcases Finset.mem_insert.mp (small h) with hs | ht
    · exact Finset.mem_insert.mpr (Or.inl hs)
    · exact Finset.mem_insert_of_mem (Finset.mem_union_left _ ht)
  · rcases Finset.mem_insert.mp (xorIntoSign_sub _ h) with hs | hp
    · exact Finset.mem_insert.mpr (Or.inl hs)
    · exact Finset.mem_insert_of_mem (Finset.mem_union_right _ hp)

