private theorem sw_in_range {a b z lo hi : Nat}
    (h : lo ≤ StairPlaceFast.sw a b z ∧ StairPlaceFast.sw a b z ≤ hi)
    (ha : ¬(lo ≤ a ∧ a ≤ hi)) (hb : ¬(lo ≤ b ∧ b ≤ hi)) :
    StairPlaceFast.sw a b z = z := by
