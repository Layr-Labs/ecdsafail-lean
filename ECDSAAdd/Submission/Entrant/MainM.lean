    simp only [List.mem_cons, not_or] at hr hh
    simp only [StairArchiveInactive.rebinder, Equiv.trans_apply]
    rw [sign_rebinder_fix rs hs x hr.2 hh.2]
    exact Equiv.swap_apply_of_ne_of_ne hr.1 hh.1
