theorem midF_rel : Rel 38 nmF (tlF ++ rtF) where
  run_eq m s := (mid_fwd m s).symm
  mc_eq := by decide +kernel
  tc_eq := by decide +kernel
  wires_sub := MixedFredCut.sub_of_check _ _ (by decide +kernel)
  slots_le := by decide +kernel
