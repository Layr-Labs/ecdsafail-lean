            cases s.basis (pkWire k 3) <;> cases s.basis (pkWire k 4) <;> rfl
        · simp [writeBit, wp4, wfB, w104]
  rw [h2]
  rw [run_measureX_CZ fA 104 (pkWire k 4) (by omega) (by dsimp only [pkWire, Wire] at *; omega) _ _
