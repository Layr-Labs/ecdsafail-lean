theorem group84Sign_ok (d : Bool) : Sound (group84Sign d) := by
  refine ⟨?_, ?_⟩
  · have hbody := gatePhysical_rename _ tagSwap.injective _ (signBody_physical d)
    have hnl := egroup_physical d 1 9 (by decide) (by decide)
