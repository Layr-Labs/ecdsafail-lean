  have ft := (fwdRel d).tc_eq
  have fm := (fwdRel d).mc_eq
  have rt := (revRel d).tc_eq
  have rm := (revRel d).mc_eq
  cases d <;> simp only [Bool.false_eq_true, ↓reduceIte] at old ⊢ <;>
    exact ⟨by omega, by omega, by omega, by omega⟩

