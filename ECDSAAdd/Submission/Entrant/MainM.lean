    rw [oddPk_end]
    have h0 := OddFullPass.P1LifeLoan.packet_wires_sub d 0 84 (by decide)
    simpa only [StairGroups.packet_zero] using h0
  · intro q hq
    unfold oddPk at hq
    rwa [if_neg h12,if_neg h3] at hq

