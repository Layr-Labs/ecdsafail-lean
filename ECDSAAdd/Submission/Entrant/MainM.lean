theorem oddPk_sub (d : Bool) (k : Nat) : wires (oddPk d k) ⊆ wires (ECDSAAdd.Entrant.Rolling1588.packet d k) := by
  by_cases h12 : 1≤k ∧ k<84
  · rw [oddPk_mid d k h12.1 h12.2]
    cases d
    · exact StairLoanGroupSupport.c45_oddPacket_sub_false k
