/-- Temporarily form two XORs on their pivot wires. Neither list uses either pivot. -/
private def parityProduct (a b target : Wire) (left right : List Wire) (erase : Bool) : Program :=
  let prep := left.map (fun q => Instr.CX q a) ++ right.map (fun q => Instr.CX q b)
  let gate : Instr := if erase then .measureX target [] [.CZ a b] else .CCX a b target
  prep ++ [gate] ++ prep.reverse

/-- Five products in the XOR of the decoder outputs. Only four are kept as workspace.
    During cleanup each CZ sees the same two parities as the corresponding CCX. -/
def prefixSignCircuit : Program :=
  let first := parityProduct 3 6 0 [1,2,4] [1,2,4]
  let second := parityProduct 2 3 5 [1,8] [1,4,8]
  let third := parityProduct 2 4 9 [1,3,7,0,5] [1,8,0,5]
  let fourth := parityProduct 3 1 10 [5] [2,4,7,8,0,5,9]
  first false ++ second false ++ third false ++ fourth false ++
    parityProduct 3 2 12 [8,5] [4,8,5,10] false ++
    [.X 12, .CX 3 12, .CX 4 12, .CX 6 12, .CX 7 12, .CX 8 12] ++
    fourth true ++ third true ++ second true ++ first true

def prefixParity : Program :=
  renameProgram (fun q => if q = 12 then signHost else prefixLoanPort q) prefixSignCircuit

def signBracket : Program := prefixParity ++ xorIntoSign signPayload

def spk (d : Bool) (k : Nat) : Program :=
