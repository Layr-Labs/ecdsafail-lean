private theorem pair_delta2 {a b x y g h i j t1 t2 f1 f2 r : Nat}
    (l : a+g+h+t1=x+f1) (rr : b+i+j+t2=y+f2) (v : g+h+t1+i+j+t2=r+f1+f2) : a+b+r=x+y := by omega
attribute [local irreducible] Stair44Outer.divide Stair44Outer.multiply divide multiply
  finite Stair44Outer.finite WindowWalkCosts.forward WindowWalkCosts.backward
  WindowFieldCosts.group84Sign WindowFieldCosts.group Stair44WalkRun.forward Stair44WalkRun.backward
  toffoliCount measurementCount

theorem tc_div : tc.measure divide+39828+39957+682=tc.measure Stair44Outer.divide+809 := by
  have k := kernels tc 39828 39957 617 809 (WindowWalkCosts.inst true 4 409 39828 39979 rfl rfl rfl).1
    (WindowWalkCosts.inst false 85 490 39828 39957 rfl rfl rfl).2.1 (field_delta_tc_div 809 fieldTcDiv)
  have e : tc.measure Rolling1588.ep + tc.measure Rolling1588.dp = 13 := by
    show toffoliCount Rolling1588.ep + toffoliCount Rolling1588.dp = 13
    rw [PackCutCounts.tc_ep, PackCutCounts.tc_dp]
  omega

theorem tc_mul (k : Nat) : tc.measure (multiply k)+39828+39979+729=tc.measure (Stair44Outer.multiply k)+721 :=
  kernelsM tc k 39828 39979 729 721 (WindowWalkCosts.inst false 84 489 39828 39957 rfl rfl rfl).1
    (WindowWalkCosts.inst true 4 409 39828 39979 rfl rfl rfl).2.1 (field_delta_tc_mul 721 fieldTcMul)

theorem mc_div : mc.measure divide+17960+17708+1406=mc.measure Stair44Outer.divide+641 := by
  have k := kernels mc 17960 17708 1381 641 (WindowWalkCosts.instMeasurements true 4 409 17960 17730 rfl rfl rfl).1
    (WindowWalkCosts.instMeasurements false 85 490 17938 17708 rfl rfl rfl).2 (field_delta_mc_div 641 fieldMcDiv)
  have e : mc.measure Rolling1588.ep + mc.measure Rolling1588.dp = 5 := by
    show measurementCount Rolling1588.ep + measurementCount Rolling1588.dp = 5
    exact PackCutCounts.mc_epdp
  omega

theorem mc_mul (k : Nat) : mc.measure (multiply k)+17938+17730+1707=mc.measure (Stair44Outer.multiply k)+531 :=
  kernelsM mc k 17938 17730 1707 531 (WindowWalkCosts.instMeasurements false 84 489 17938 17708 rfl rfl rfl).1
    (WindowWalkCosts.instMeasurements true 4 409 17960 17730 rfl rfl rfl).2 (field_delta_mc_mul 531 fieldMcMul)

theorem deltas (C : Point) (cx cy : Fp) :
    toffoliCount (finite C cx cy)+159473=toffoliCount (Stair44Outer.finite C cx cy) ∧
    measurementCount (finite C cx cy)+73277=measurementCount (Stair44Outer.finite C cx cy) :=
  ⟨finite_delta tc C cx cy 159473
      (OddOuterBridge.entryYAllOdd_tc_eq layout layout_widths (-cy))
      (OddOuterBridge.exitYAllOdd_tc_eq layout layout_widths cy)
      (pair_delta2 tc_div (tc_mul _) rfl),
    finite_delta mc C cx cy 73277
      (OddOuterBridge.entryYAllOdd_mc_eq layout layout_widths (-cy))
      (OddOuterBridge.exitYAllOdd_mc_eq layout layout_widths cy)
      (pair_delta2 mc_div (mc_mul _) rfl)⟩

theorem totals (C : Point) : toffoliCount (program C) ≤ 2008122 ∧
    measurementCount (program C) ≤ 1446309 := by
  have h := Stair44Resources.totals C
  cases C with
  | zero => change toffoliCount [] ≤ _ ∧ measurementCount [] ≤ _; simp [toffoliCount,measurementCount]
  | @some cx cy hc =>
    have d := deltas (.some hc) cx cy
    simp only [program,Stair44Outer.program,(renameProgram_counts _ _).1,
      (renameProgram_counts _ _).2] at h ⊢
    exact ⟨by omega,by omega⟩

