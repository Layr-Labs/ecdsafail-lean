theorem forwardLCM_eq (d : Bool) : forwardLCM d = forwardPreX d ++
    [MixedFredCut.leave15C jL, Shadow7.parkP 420, portalInvM, tickWM, MixedWindow.packW d 420 410,
     Shadow7.exitLoadP 420 d] := by
