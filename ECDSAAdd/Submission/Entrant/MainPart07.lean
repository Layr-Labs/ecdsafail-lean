def checkInput (uv : Nat × Nat) : Bool :=
  [false,true].all fun g => [false,true].all fun s =>
    decide (encN_t8 (MorningFour.pre507 g s uv.1 uv.2) sites12 ∈ rowInputs)
theorem inputTable : MorningFour.pairs.all checkInput=true := by decide +kernel

theorem sample_run (g s : Bool) (uv : Nat × Nat) (h : uv∈MorningFour.pairs) (m : List Bool) :
    run candidate12 m ⟨false,MorningFour.pre507 g s uv.1 uv.2⟩=
      run MorningFour.forward13 m ⟨false,MorningFour.pre507 g s uv.1 uv.2⟩ := by
  have ht := inputTable
  simp only [List.all_eq_true] at ht
  have row := ht uv h
  simp only [checkInput,List.all_eq_true,decide_eq_true_eq] at row
  have mem := row g (by cases g <;> simp) s (by cases s <;> simp)
  have sub : MorningFour.sites⊆sites12 := by decide +kernel
  have supp : ∀q : Wire,MorningFour.pre507 g s uv.1 uv.2 q=true → q∈sites12 := by
    intro q yes
    apply sub
    by_contra no
    rw [MorningFour.pre_supp g s uv.1 uv.2 q no] at yes
    contradiction
  have same := allRows _ mem m
  rw [← tb_enc_t8 _ sites12 supp] at same
  exact same

def physB : Instr → Bool
  | .X _ => true
  | .CX c t => decide (c≠t)
  | .CCX a b t => decide (a≠t ∧ b≠t)
  | .measureX _ _ _ => true

theorem physical_of_all (P : Program) (h : P.all physB=true) : GatePhysical P := by
  intro i hi
  have v := List.all_eq_true.mp h i hi
  cases i <;> simp_all [physB,RecordedQuantum.PhysicalInstr,ProperGate]
