def oldA (L:ControlledPointLayout) : Program :=
 FullASelectedDevelop.hostedASelected L.dialogStreamedSquareWide
  (LowZero18Square.foldPerm L.dialogStreamedSquareWide (OwnDiagAll12Square.kext L)) L.core.generic

