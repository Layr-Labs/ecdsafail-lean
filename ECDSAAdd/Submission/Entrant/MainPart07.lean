theorem curve_not_matches {x y : Fp} (hc : curve.toAffine.Nonsingular x y) :
    ¬ matchesXY x.val y.val := by
  rintro ⟨hx,hy⟩
  have yes := highX_curve_parity hc hx
  rw [yes] at hy
  contradiction

