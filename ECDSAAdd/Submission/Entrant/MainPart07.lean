  · subst e
    simp [OB5Support.sites,OB5Support.poolSites,wireBlock]
    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨1363,⟨by omega,by omega⟩,rfl⟩)))))
