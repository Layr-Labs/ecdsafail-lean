theorem rename_ins (e : Equiv.Perm Wire) (h : Wire) (P Q : Program)
    (sub : wires P⊆insert h (wires Q)) (fix : e h=h) :
    wires (renameProgram e P)⊆insert h (wires (renameProgram e Q)) := by
