      j=721 ∨ j=722 ∨ j=2400) :
    sw (rhoN j)∉[2312,766,765,767,1026,1541,1542,1797,768,718,719] := by
  have range:=rhoN_range j hj
  generalize rhoN j=i at range ⊢
  simp only [List.mem_cons,List.not_mem_nil,or_false]
