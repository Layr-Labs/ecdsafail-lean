  else if q=786 then decide ((SkywalkRails.encode g s (u:Int) (v:Int)).b / 1 % 2 = 1)
  else if q=787 then decide ((SkywalkRails.encode g s (u:Int) (v:Int)).b / 2 % 2 = 1)
