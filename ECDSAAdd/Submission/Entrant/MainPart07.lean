  if q=521 then g
  else if q=522 then decide ((SkywalkRails.encode g s (u:Int) (v:Int)).a / 1 % 2 = 1)
  else if q=523 then decide ((SkywalkRails.encode g s (u:Int) (v:Int)).a / 2 % 2 = 1)
