theorem on_site (g s : Bool) (uv : Nat × Nat) (mem : uv∈MorningFour.pairs)
    (st : State) (bits : ∀q∈sites12,st.basis q=MorningFour.pre507 g s uv.1 uv.2 q)
    (m : List Bool) : run candidate12 m st=run MorningFour.forward13 m st := by
  apply forced_eqN candidate12 MorningFour.forward13 sites12 (MorningFour.pre507 g s uv.1 uv.2) 14
    (recsUpTo 14) (take_recsUpTo 14) support old_support
    (by have h:=resources.2.1; omega) (by have h:=MorningFour.resources.2.2.1; omega) _ st bits m
  intro tape _
  have eq := sample_run g s uv mem tape
  exact ⟨congrArg State.phase eq,fun q _=>congrArg (fun v : State=>v.basis q) eq⟩

