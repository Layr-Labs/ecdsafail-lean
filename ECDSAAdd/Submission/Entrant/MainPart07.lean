set_option maxRecDepth 30000
set_option maxHeartbeats 12000000
set_option linter.unusedSimpArgs false
def canonical0 : Program := [
 .CCX 0 2 10,
 .X 1,
 .CCX 10 1 5,
 .X 1,
 .CX 10 0,
 .CCX 4 0 11,
 .CX 10 0,
 .CX 7 8,
 .X 1,
 .measureX 9 [] [.CZ 11 1, .CZ 8 1],
 .measureX 7 [] [.CZ 8 1],
 .X 1,
 .X 3,
 .measureX 8 [] [.CZ 11 3],
 .X 3,
 .measureX 11 [] [.CZ 4 0, .CZ 4 10],
 .measureX 6 [] [.CZ 4 5],
 .measureX 10 [] [.CZ 0 2],
 .X 5,
 .measureX 10 [] [],
 .measureX 11 [] []
]

def canonical1 : Program := [
 .CCX 0 2 10,
 .X 1,
 .CCX 10 1 5,
 .X 1,
 .CX 10 0,
 .CCX 4 0 11,
 .CX 10 0,
 .CX 9 8,
 .X 1,
