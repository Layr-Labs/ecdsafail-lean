theorem logicalR_omits (k i : Nat)
    (hi : i∈[2312,766,765,767,1026,1541,1542,1797,768,718,719]) :
    base i∉wires (renameProgram sig (renameProgram rho
      (E1Reflected.merged base (base 2400) k))) := by
