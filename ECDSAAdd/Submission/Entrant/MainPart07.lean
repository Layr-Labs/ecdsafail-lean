  have h := gen_counts L hw cx cy
  have s := gen_slots L hw cx cy
  simp only [Edges.wrapper,Edges.finiteProgram,toffoliCount_append,measurementCount_append,
    gateSlots_append,renameProgram_counts,rename_gateSlots]
  omega

                                                 
                                                                    
                                                                   
                                                   
                                                                                              
                                                        

                                    
              
               
                                                        
                                                       

                                                                    
                                                                

                                                                  
                                                                                               
              
           
                
                                                                                      
                                          
                     
                                                                   
                                                                                   
                                                                            
                                     
                                                                            
                                                                  
                                                                    

                                                                            
              
                                       
                     
                                                                        
                                                                          
                                                           
                                                                                            
         

                                                                                     
              
                                           
                     
                                                                          
                                                                            
                                                                
                                                                                                
         

                                                                  
              
                                                            
                     
                                                                     
                                                                                                
                                       

                                                                     
              
                                       
                     
                                                                              
                                                            

                                                                            
              
                          
                     
                                                                          
                                                                            
                                                                 
                                                     
                      
                                                                                          
         

                                                              
                                                                                   
                                                         
                                                                 
                         
                                                                  
                                                             
                   
                                                     
                                                 
                      
                                                            
                                                   

