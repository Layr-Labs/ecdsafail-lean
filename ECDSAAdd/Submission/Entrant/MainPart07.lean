  · exact Or.inl (Or.inr h)
  · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inl (Or.inl (Or.inl h))))))
  · rcases Finset.mem_union.mp (rx h) with h'|h'
    · exact Or.inl (Or.inl (Or.inr (Or.inr (Or.inl (Or.inl (Or.inr h'))))))
