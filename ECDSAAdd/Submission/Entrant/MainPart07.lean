    simp [writeBit, this]
  · intro q hq
    show writeBit s.basis L.point.finite _ q = writeBit base L.point.finite _ q
    by_cases hqf : q = L.point.finite
    · subst hqf; simp [writeBit, hfs, v.x]
    · simp [writeBit, hqf, v.rest q hq]

