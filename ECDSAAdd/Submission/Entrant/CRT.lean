private theorem correction_tags : ∀ (slot : Fin 17) (i : Fin 3),
    CRTBarrel.xorAt (CRTBarrel.flags 61 slot.val) (tags i) = decide (i.val < slot.val - 1) := by decide +kernel

def Flags (slot : Fin 17) (s : State) : Prop :=
  ∀ q, 61 ≤ q → s.basis q = CRTBarrel.flags 61 slot.val q

def corrected (slot : Fin 17) (i : Fin 3) (s : State) : State :=
