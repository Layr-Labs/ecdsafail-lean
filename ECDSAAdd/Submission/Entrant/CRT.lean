namespace PackedBasis

open CRTBarrel.Packed

/-- One spill followed by the three CNOTs of the original swap, if required. -/
private def steps (n : Nat) (v : (Nat × Nat) × Nat) : List ((Nat × Nat) × Nat) :=
  let ((j,mask),i) := v
  [((n,mask),i)] ++ (if i = j then [] else [((i,0),j),((j,0),i),((i,0),j)])

private def emit (n : Nat) (v : (Nat × Nat) × Nat) : List (Wire × Wire) :=
  (CRTBarrel.elimStep n v.2 v.1).reverse

private def rowSteps : List ((Nat × Nat) × Nat) := pivotPlan.zipIdx.reverse.flatMap (steps 54)

private theorem emit_pivot (j mask i : Nat) (hj : j < 54) (hi : i < 54) :
    (steps 54 ((j,mask),i)).flatMap (emit 54) = (reversePivot (j,mask) i).reverse := by
  by_cases h : i = j
  · subst j
    simp [steps,emit,reversePivot,CRTBarrel.elimStep,CRTBarrel.selected]
  · simp [steps,emit,reversePivot,CRTBarrel.elimStep,CRTBarrel.selected,
      h,Ne.symm h,hj,hi,List.append_assoc]

private theorem emit_rows : rowSteps.flatMap (emit 54) = outerOps := by
  have fold (xs : List ((Nat × Nat) × Nat))
      (bounds : ∀ v ∈ xs, v.1.1 < 54 ∧ v.2 < 54) :
      (xs.flatMap (steps 54)).flatMap (emit 54) =
        xs.flatMap (fun (row,i) => (reversePivot row i).reverse) := by
    induction xs with
    | nil => rfl
    | cons v tail ih =>
      obtain ⟨⟨j,mask⟩,i⟩ := v
      obtain ⟨hj,hi⟩ := bounds ((j,mask),i) (List.mem_cons_self ..)
      rw [List.flatMap_cons,List.flatMap_append,List.flatMap_cons,emit_pivot j mask i hj hi]
      rw [ih (fun v hv => bounds v (List.mem_cons_of_mem _ hv))]
  unfold rowSteps outerOps
  rw [fold _ (fun v hv => ⟨(pivot_bounds v (List.mem_reverse.mp hv)).1,
    (pivot_bounds v (List.mem_reverse.mp hv)).2.1⟩)]
  exact (List.reverse_flatMap ..).symm

/-- The grouped packed reflection, generalized from a zip-indexed plan to exact row steps. -/
private theorem coordinates_steps (n : Nat) (xs : List ((Nat × Nat) × Nat))
    (good : ∀ v ∈ xs, v.2 < n ∧ v.1.2.testBit v.2 = false)
    (target : CRTBarrel.Matrix.Rows) (size : target.size = n) (narrow : n ≤ width) (word : Nat)
    (receipt : xs.foldl (quickStep n) (identityWord width n) = word)
    (rows : ∀ j : Fin n, digit width word j.val = CRTBarrel.Matrix.read target j.val) :
    CRTBarrel.Matrix.applyOps (xs.flatMap (emit n)) (CRTBarrel.Matrix.units n) = target := by
  have carry (xs : List ((Nat × Nat) × Nat)) (x : Nat) (r : CRTBarrel.Matrix.Rows)
      (size : r.size = n) (agree : Matches x r)
      (good : ∀ v ∈ xs, v.2 < n ∧ v.1.2.testBit v.2 = false) :
      Matches (xs.foldl (quickStep n) x) (CRTBarrel.Matrix.applyOps (xs.flatMap (emit n)) r) := by
    induction xs generalizing x r with
    | nil => exact agree
    | cons v xs ih =>
      obtain ⟨⟨donor,mask⟩,i⟩ := v
      have use := good ((donor,mask),i) (by simp)
      rw [List.foldl_cons,List.flatMap_cons]
      unfold CRTBarrel.Matrix.applyOps
      rw [List.foldl_append]
      change Matches (xs.foldl _ _) (CRTBarrel.Matrix.applyOps _
        (CRTBarrel.Matrix.applyOps (CRTBarrel.elimStep n i (donor,mask)).reverse r))
      rw [CRTBarrel.backward_row n i donor mask r size use.2]
      apply ih _ _ ((pivotBack_size ..).trans size) _
        (fun v hv => good v (List.mem_cons_of_mem _ hv))
      rw [CRTBarrel.Packed.quickStep_eq]
      exact matches_step n x r ((donor,mask),i) size use.1 agree
  have base : Matches (identityWord width n) (CRTBarrel.Matrix.units n) := by
    intro q hq
    have sq : q < n := by simpa [CRTBarrel.Matrix.units] using hq
    simpa [CRTBarrel.Matrix.units,CRTBarrel.Matrix.read,sq,identityWord] using
      (digit_units width n 0 q (by simpa using narrow) sq).symm
  have matched := carry xs (identityWord width n) (CRTBarrel.Matrix.units n)
    (by simp [CRTBarrel.Matrix.units]) base good
  rw [receipt] at matched
  have os : (CRTBarrel.Matrix.applyOps (xs.flatMap (emit n)) (CRTBarrel.Matrix.units n)).size = n := by
    simp [CRTBarrel.Matrix.units]
  apply Array.ext (os.trans size.symm)
  intro q ho ht
  have eq := (matched q ho).trans (rows ⟨q,os ▸ ho⟩)
  simpa only [CRTBarrel.Matrix.read,Array.getElem?_eq_getElem ho,Array.getElem?_eq_getElem ht,
    Option.getD_some] using eq

set_option maxRecDepth 5000 in
private theorem step_shape : ∀ v ∈ rowSteps, v.2 < 54 ∧ v.1.2.testBit v.2 = false := by
  decide +kernel

set_option maxRecDepth 8000 in
private theorem packed_receipt : rowSteps.foldl (quickStep 54) (identityWord width 54) = packedRowsWord := by
  decide +kernel

set_option maxRecDepth 8000 in
private theorem packed_digits : ∀ q : Fin 54,
    digit width packedRowsWord q.val = CRTBarrel.Matrix.read outerRows q.val := by
  decide +kernel

end PackedBasis

/-- Exact coordinates of the original swap and spill basis tape. -/
theorem basis_certificate : BasisCertificate := by
  have proved := PackedBasis.coordinates_steps 54 PackedBasis.rowSteps PackedBasis.step_shape outerRows
    (by rfl) (by decide) packedRowsWord PackedBasis.packed_receipt PackedBasis.packed_digits
  rw [PackedBasis.emit_rows] at proved
  exact proved

