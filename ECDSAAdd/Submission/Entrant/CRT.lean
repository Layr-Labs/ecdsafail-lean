  infer_instance

def UsedWidth (n : Nat) : Prop :=
  n = 38 ∨ n = 45 ∨ n = 53 ∨ n = 60 ∨ n = 68 ∨ n = 75 ∨ n = 83 ∨ n = 90 ∨ n = 98 ∨ n = 105 ∨ n = 112 ∨ n = 119 ∨ n = 127

instance (n : Nat) : Decidable (UsedWidth n) := by
  unfold UsedWidth
  infer_instance

theorem usedWidth : ∀ j : Fin 25, 0 ≤ j.val → j.val ≤ 23 → UsedWidth (barrelWidth (start j)) := by
  decide +kernel

theorem schedule_fields (n : Nat) (hn : UsedWidth n) :
    ∀ pair ∈ schedule n, UsedField pair.1 := by
  have h : (schedule n).all (fun x => decide (UsedField x.1)) = true := by
    rcases hn with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel
  intro pair hp
  exact of_decide_eq_true (List.all_eq_true.mp h pair hp)

end ECDSAAdd.Entrant.StairPacket.CRTBarrel

