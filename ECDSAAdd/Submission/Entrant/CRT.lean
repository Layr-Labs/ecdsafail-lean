  unfold UsedField
  infer_instance

def UsedWidth (n : Nat) : Prop :=
  n = 39 ∨ n = 46 ∨ n = 54 ∨ n = 61 ∨ n = 69 ∨ n = 76 ∨ n = 84 ∨ n = 91 ∨ n = 99 ∨ n = 106 ∨ n = 113 ∨ n = 114 ∨ n = 120 ∨ n = 121 ∨ n = 128

