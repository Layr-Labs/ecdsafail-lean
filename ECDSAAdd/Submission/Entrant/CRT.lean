def clipShift (n k a : Nat) : Nat := (a >>> k) &&& (2^(n-15)-1)

theorem clip_zero (n k : Nat) : clipShift n k 0 = 0 := by simp [clipShift]

theorem clip_xor (n k a b : Nat) : clipShift n k (a ^^^ b) = clipShift n k a ^^^ clipShift n k b := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [clipShift,Nat.testBit_and,Nat.testBit_shiftRight,Nat.testBit_xor]
  cases (2^(n-15)-1).testBit i <;> simp

def plain (n k : Nat) : Rows := (units n).map (clipShift n k)
def coded (n k : Nat) : Rows := (encoded n).map (clipShift n k)

@[simp] theorem plain_size (n k : Nat) : (plain n k).size = n := by simp [plain,units]

theorem encode_of_receipt (n k : Nat) (h : applyOps (basisNetwork n) (units n) = encoded n) :
    applyOps (basisNetwork n) (plain n k) = coded n k := by
  rw [plain,apply_map _ _ (clip_zero n k) (clip_xor n k),h,coded]

end ECDSAAdd.Entrant.StairPacket.CRTBarrel

