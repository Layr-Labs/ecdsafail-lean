-- ==== begin SelectorReceiver semantics (credited to spariev 59c20890) ====
namespace ECDSAAdd.Entrant.StairPacket.DI7Affine
open Arithmetic Partial GateMirror DeadJoin
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxHeartbeats 2000000
theorem clear_valid (c : Bool) (qs : List Wire) (t : Wire) (away : ∀ q∈qs,q≠t) (s : State) :
    RawValid s (clear c qs t) := by
  have phys : Proper (clear c qs t) := by
    intro g hg
    simp only [clear,List.mem_append] at hg
    rcases hg with hx | hc
    · cases c <;> simp_all [proper]
    · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp hc
      simpa [proper] using away q hq
  have plain : ∀ g∈clear c qs t,plainGate g=true := by
    intro g hg
    simp only [clear,List.mem_append] at hg
    rcases hg with hx | hc
    · cases c <;> simp_all [plainGate]
    · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp hc
      rfl
  exact ⟨phys,all_prepared _ s phys (fun m => by simp only [clear_run c qs t away]),ready_plain _ (List.all_eq_true.mpr plain) s⟩

/-- Replace a prepared pop with its preserved XOR receiver, transporting the
whole basis, phase, and both independent inverse measurement tapes. -/
theorem raw_replace_pop (a b : List Gate) (x y t : Wire) (c : Bool) (qs : List Wire)
    (s : State) (v : RawValid s (a ++ (Gate.pop x y t :: b)))
    (away : ∀ q∈qs,q≠t)
    (rel : eval (c,t::qs) (run (GateMirror.forward a) [] s).basis=false) :
    RawValid s (a ++ (clear c qs t ++ b)) ∧
    (∀ m,run (GateMirror.forward (a ++ (clear c qs t ++ b))) m s=
      run (GateMirror.forward (a ++ (Gate.pop x y t :: b))) m s) := by
  let u := run (GateMirror.forward a) [] s
  have va := v.parts.1
  have vb := v.parts.2.tail
  have e : run (GateMirror.forward (clear c qs t)) [] u = transition (Gate.pop x y t) u := by
    rw [clear_run c qs t away]
    have z : (u.basis t ^^ (c ^^ parity qs u.basis))=false := by
      change (c ^^ (u.basis t ^^ parity qs u.basis))=false at rel
      have shuffle (c t p : Bool) : (c ^^ (t ^^ p)) = (t ^^ (c ^^ p)) := by
        cases c <;> cases t <;> cases p <;> rfl
      rw [←shuffle]; exact rel
    simp only [z,transition,front,erase,run,measureAndCorrect,ECDSAAdd.correct,
      List.headD,Bool.false_and,Bool.xor_false,Bool.false_eq_true,if_false]
  rw [←e] at vb
  have w := raw_append va (raw_append (clear_valid c qs t away u) vb)
  refine ⟨w,?_⟩
  intro m
  rw [w.default_run m,v.default_run m]
  simp only [forward_app,run_append,run_take,List.drop_nil]
  change run (GateMirror.forward b) [] (run (GateMirror.forward (clear c qs t)) [] u) =
    run (GateMirror.forward b) [] (transition (Gate.pop x y t) u)
  rw [e]

theorem linkRun (x y t u : Wire) (w : State) (ht : w.basis t = false) (hu : w.basis u = false)
    (tu : t ≠ u) :
    run (GateMirror.forward [.make x y u, .x u]) [] w =
      run (GateMirror.forward [.make x y t, .cx t u, .x u, .pop x y t]) [] w := by
  obtain ⟨ph, f⟩ := w
  simp only at ht hu
  simp only [GateMirror.forward, List.map_cons, List.map_nil, front, erase, run, measureAndCorrect,
    writeBit, List.headD]
  show _ = (⟨_, _⟩ : State)
  congr 1
  simp [ht, hu, tu, Ne.symm tu]
  funext q
  by_cases h1 : q = t <;> by_cases h2 : q = u <;> simp_all [Function.update_apply]

/-- Chain top: replace `make x y t, cx t u, x u, pop x y t` by `make x y u, x u` on a clean `u`. -/
theorem rawReplaceLink (a b : List Gate) (x y t u : Wire) (s : State)
    (v : RawValid s (a ++ ([.make x y t, .cx t u, .x u, .pop x y t] ++ b)))
    (hu : (run (GateMirror.forward a) [] s).basis u = false)
    (xu : x ≠ u) (yu : y ≠ u) (tu : t ≠ u) :
    RawValid s (a ++ ([.make x y u, .x u] ++ b)) ∧
    run (GateMirror.forward [.make x y u, .x u]) [] (run (GateMirror.forward a) [] s) =
      run (GateMirror.forward [.make x y t, .cx t u, .x u, .pop x y t]) [] (run (GateMirror.forward a) [] s) := by
  obtain ⟨va, vrest⟩ := v.parts
  obtain ⟨vold, vb⟩ := vrest.parts
  have ht : (run (GateMirror.forward a) [] s).basis t = false := vold.ready.1
  have e := linkRun x y t u _ ht hu tu
  have vnew : RawValid (run (GateMirror.forward a) [] s) [.make x y u, .x u] :=
    ⟨fun g hg => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl <;> simp [proper, xu, yu],
     ⟨trivial, trivial, trivial⟩, ⟨hu, trivial, trivial⟩⟩
  rw [← e] at vb
  exact ⟨raw_append va (raw_append vnew vb), e⟩

end ECDSAAdd.Entrant.StairPacket.DI7Affine

namespace ECDSAAdd.Entrant.StairPacket.DI7Affine
open Arithmetic Partial GateMirror DeadJoin
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxHeartbeats 2000000
set_option linter.unnecessarySeqFocus false

/-- Low chain top (mirror of `linkRun`): when `u = !(x && y)` and `t` is clean,
`x u, pop x y u` has the same run as `make x y t, cx t u, x u, pop x y t`. -/
theorem linkRunLow (x y t u : Wire) (w : State) (ht : w.basis t = false)
    (hu : w.basis u = !(w.basis x && w.basis y))
    (tu : t ≠ u) (xu : x ≠ u) (yu : y ≠ u) (xt : x ≠ t) (yt : y ≠ t) :
    run (GateMirror.forward [.x u, .pop x y u]) [] w =
      run (GateMirror.forward [.make x y t, .cx t u, .x u, .pop x y t]) [] w := by
  obtain ⟨ph, f⟩ := w
  simp only at ht hu
  simp only [GateMirror.forward, List.map_cons, List.map_nil, front, erase, run, measureAndCorrect,
    writeBit, List.headD, ECDSAAdd.correct, Bool.false_eq_true, ↓reduceIte, Bool.false_and, Bool.xor_false]
  congr 1
  funext q
  by_cases h1 : q = t <;> by_cases h2 : q = u <;>
    simp_all [Function.update_apply, Ne.symm tu, Ne.symm xu, Ne.symm yu, Ne.symm xt, Ne.symm yt] <;>
    (cases f x <;> cases f y <;> simp)

/-- Low chain top: replace `make x y t, cx t u, x u, pop x y t` by `x u, pop x y u`
when `u` is clean right after the old link. -/
theorem rawReplaceLinkLow (a b : List Gate) (x y t u : Wire) (s : State)
    (v : RawValid s (a ++ ([.make x y t, .cx t u, .x u, .pop x y t] ++ b)))
    (hu : (run (GateMirror.forward (a ++ [.make x y t, .cx t u, .x u, .pop x y t])) [] s).basis u = false)
    (xu : x ≠ u) (yu : y ≠ u) (tu : t ≠ u) (xt : x ≠ t) (yt : y ≠ t) :
    RawValid s (a ++ ([.x u, .pop x y u] ++ b)) ∧
    run (GateMirror.forward [.x u, .pop x y u]) [] (run (GateMirror.forward a) [] s) =
      run (GateMirror.forward [.make x y t, .cx t u, .x u, .pop x y t]) [] (run (GateMirror.forward a) [] s) := by
  obtain ⟨va, vrest⟩ := v.parts
  obtain ⟨vold, vb⟩ := vrest.parts
  have ht : (run (GateMirror.forward a) [] s).basis t = false := vold.ready.1
  have hpre : (run (GateMirror.forward a) [] s).basis u =
      !((run (GateMirror.forward a) [] s).basis x && (run (GateMirror.forward a) [] s).basis y) := by
    have hu' : (run (GateMirror.forward [.make x y t, .cx t u, .x u, .pop x y t]) []
        (run (GateMirror.forward a) [] s)).basis u = false := by
      simp only [forward_app, run_append, run_take, List.drop_nil] at hu; exact hu
    generalize run (GateMirror.forward a) [] s = w at hu' ht ⊢
    obtain ⟨ph, f⟩ := w
    simp only at ht ⊢
    simp only [GateMirror.forward, List.map_cons, List.map_nil, front, erase, run, measureAndCorrect,
      writeBit, List.headD, ECDSAAdd.correct, Bool.false_eq_true, ↓reduceIte, Bool.false_and,
      Bool.xor_false] at hu'
    simp only [Function.update_apply, Ne.symm tu, Ne.symm xu, Ne.symm yu, Ne.symm xt, Ne.symm yt,
      if_true, if_false, ht, Bool.false_xor, tu, xu, yu, xt, yt] at hu'
    revert hu'; cases f x <;> cases f y <;> cases f u <;> simp
  have e := linkRunLow x y t u _ ht hpre tu xu yu xt yt
  have vnew : RawValid (run (GateMirror.forward a) [] s) [.x u, .pop x y u] := by
    refine ⟨fun g hg => ?_, ⟨trivial, ?_, trivial⟩, ⟨trivial, trivial, trivial⟩⟩
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl <;> simp [proper, xu, yu]
    · have hp := hpre
      generalize run (GateMirror.forward a) [] s = w at hp ⊢
      obtain ⟨ph, f⟩ := w
      simp only at hp
      simp [ValueOK, transition, front, run, writeBit, Function.update_apply, xu, yu, hp]
  rw [← e] at vb
  exact ⟨raw_append va (raw_append vnew vb), e⟩

end ECDSAAdd.Entrant.StairPacket.DI7Affine

namespace ECDSAAdd.Entrant.StairPacket.DeadJoin
open Arithmetic Partial GateMirror HighBankJoin Challenge DI7Affine
set_option maxHeartbeats 10000000
set_option maxRecDepth 30000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
theorem keeps_targets (gs : List Gate) (q : Wire) (h : ∀ g∈gs,target g≠q) (s : State) :
    (run (GateMirror.forward gs) [] s).basis q=s.basis q := by
  apply LeaveReadoutFrame.preserved
  rw [dest_forward]
  rintro hit
  obtain ⟨g,hg,eq⟩ := List.mem_map.mp hit
  exact h g hg eq

theorem expr_kept (gs : List Gate) (e : Expr)
    (h : gs.all (fun g => !e.2.contains (target g))=true) (s : State) :
    eval e (run (GateMirror.forward gs) [] s).basis=eval e s.basis := by
  unfold eval
  rw [parity_congr e.2 _ _]
  intro q hq
  apply keeps_targets
  intro g hg eq
  have hh := List.all_eq_true.mp h g hg
  simp only [Bool.not_eq_true'] at hh
  have mem : e.2.contains (target g)=true := List.contains_iff_mem.mpr (eq ▸ hq)
  rw [mem] at hh
  contradiction

theorem sel_pre_pull : ∀ j : Fin 26, j.val ≤ 24 →
    pull (keptHead (start j) ++ (KeptParity.placed (start j) ++ selPre (start j))) (selectorExpr (start j)) =
      some (selectorExpr (start j)) := by decide +kernel

private def selectorPrefixLocal (s : Nat) : List Gate :=
  let h := Shadow7.sbP s
  DeadScan.fix0M s h ++ leaveFix1 s h ++ Shadow7.fix2P s h ++ leaveFix3 s h ++ leaveFix4 s h

private def selectorFirstSix (s : Nat) : List Gate :=
  [1559, 1561, 1562, 1563, 1564, 1565].map (fun q => Gate.cx q (Shadow7.sbP s + 1581))

private def selectorRemainder (s : Nat) : List Gate :=
  ((Shadow7.fix5P s (Shadow7.sbP s)).take 27).drop 6

private def selectorPostLocal (s : Nat) : List Gate :=
  selectorRemainder s ++ row0New s ++ rowGates (Shadow7.e0P s + 6) ((Shadow7.moveRows s).drop 1) ++
    (Shadow7.fix5P s (Shadow7.sbP s)).drop 43

private theorem pull_append_of_some (a b : List Gate) (e out : Expr) (h : pull b e = some out) :
    pull (a ++ b) e = pull a out := by
  induction a with
  | nil => exact h
  | cons g a ih => simp only [List.cons_append, pull, ih]

private theorem pull_without_targets (gs : List Gate) (e : Expr)
    (h : ∀ g ∈ gs, target g ∉ e.2) : pull gs e = some e := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    have tail := ih (fun k hk => h k (List.mem_cons_of_mem _ hk))
    have absent : e.2.contains (target g) ≠ true :=
      fun hit => h g List.mem_cons_self (List.contains_iff_mem.mp hit)
    rw [pull, tail]
    change step g e = some e
    simp only [step, if_neg absent]

-- The six gates are the only part that changes this affine expression.
private theorem selector_local_checks : ∀ j : Fin 26, j.val ≤ 24 →
    let s := start j
    let q := Shadow7.e0P s + 7
    (selectorPrefixLocal s).all (fun g => g.wires.all (fun w => decide (w ≠ q))) = true ∧
    (selectorPostLocal s).all (fun g => decide (target g ∉ (selectorExpr s).2)) = true ∧
    ((selectorFirstSix s ++ selectorRemainder s).filter
      (FlagLeave.hit (Shadow7.e0P s + 3) (Shadow7.e0P s + 4) 1559)) = [] ∧
    pull (selectorFirstSix s) (selectorExpr s) = some (false, [q]) := by
  decide +kernel

private theorem selector_adjust_checks : ∀ j : Fin 26, j.val ≤ 24 →
    let s := start j
    let avoid := fun q => q ∉ (selectorExpr s).2
    decide (avoid (Shadow7.e0P s + 3)) = true ∧
    (List.range (Shadow7.wpP s)).all (fun i => decide (avoid (Shadow7.bankW s i))) = true ∧
    (List.range (Shadow7.wpP s - 1)).all (fun i => decide (avoid (Shadow7.poolW s i))) = true := by
  decide +kernel

theorem sel_before_pull : ∀ j : Fin 26, j.val ≤ 24 →
    pull (before5 (start j)) (selectorExpr (start j)) = some (false,[Shadow7.e0P (start j)+7]) := by
  intro j hi
  let s := start j
  let q := Shadow7.e0P s + 7
  let e := selectorExpr s
  let f := Shadow7.e0P s + 3
  let u := Shadow7.e0P s + 4
  obtain ⟨pre, post, nohit, six⟩ := selector_local_checks j hi
  obtain ⟨first, bank, pool⟩ := selector_adjust_checks j hi
  have headSplit :
      (Shadow7.fix5P s (Shadow7.sbP s)).take 27 = selectorFirstSix s ++ selectorRemainder s := rfl
  have prefixShape : beforePre5 s = selectorPrefixLocal s ++ (selectorFirstSix s ++ selectorRemainder s) := by
    simp only [beforePre5, selectorPrefixLocal, headSplit, List.append_assoc]
  have noHitLocal :
      (selectorFirstSix s ++ selectorRemainder s).filter (FlagLeave.hit f u 1559) = [] := nohit
  have noCut (n : Nat) :
      FlagLeave.cut f u 1559 n (selectorFirstSix s ++ selectorRemainder s) =
        selectorFirstSix s ++ selectorRemainder s := by
    apply FlagLeave.cut_of_removed_nil
    simp only [removed_filter, noHitLocal, List.take_nil]
  have shape : before5 s =
      FlagLeave.cut f u 1559 2 (selectorPrefixLocal s) ++
        (selectorFirstSix s ++ (selectorPostLocal s ++ Shadow7.leaveAdjust s)) := by
    rw [before5, beforePre5Cut, prefixShape, FlagLeave.cut_append, noCut]
    simp only [f, u, selectorPostLocal, beforePost5, List.append_assoc]
  have prefixOff : AllW (· ≠ q) (selectorPrefixLocal s) :=
    fun g hg w hw => of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp pre g hg) w hw)
  have cutOff := FlagLeave.cut_allW f u 1559 2 (selectorPrefixLocal s) prefixOff
  have prefixPull : pull (FlagLeave.cut f u 1559 2 (selectorPrefixLocal s)) (false, [q]) =
      some (false, [q]) := by
    apply pull_without_targets
    intro g hg hit
    have targetIn : target g ∈ g.wires := by rw [Gate.wires_eq]; simp
    exact (cutOff g hg _ targetIn) (List.mem_singleton.mp hit)
  have adjustCore : AllAT (fun _ => True) (· ∉ e.2) (Shadow7.leaveAdjustCore s) := by
    unfold Shadow7.leaveAdjustCore
    apply allAT_adjustG
    · intro w hw
      obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hw
      exact ⟨trivial, of_decide_eq_true (List.all_eq_true.mp bank i hi)⟩
    · intro w hw
      obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hw
      exact ⟨trivial, of_decide_eq_true (List.all_eq_true.mp pool i hi)⟩
    · trivial
    · trivial
  have restPull : pull (selectorPostLocal s ++ Shadow7.leaveAdjust s) e = some e := by
    apply pull_without_targets
    intro g hg
    rcases List.mem_append.mp hg with h | h
    · exact of_decide_eq_true (List.all_eq_true.mp post g h)
    · rw [Shadow7.leaveAdjust, List.singleton_append, List.mem_cons] at h
      rcases h with rfl | h
      · exact of_decide_eq_true first
      · exact (adjustCore g h).2
  have suffixPull : pull (selectorFirstSix s ++ (selectorPostLocal s ++ Shadow7.leaveAdjust s)) e =
      some (false, [q]) :=
    (pull_append_of_some _ _ _ _ restPull).trans six
  exact (congrArg (fun p => pull p e) shape).trans
    ((pull_append_of_some _ _ _ _ suffixPull).trans prefixPull)

theorem sel_barrel_quiet : ∀ j : Fin 26, j.val ≤ 24 →
    (Shadow7.leaveBarrel (start j)).all (fun g => !(selectorExpr (start j)).2.contains (target g)) = true := by
  decide +kernel

theorem sel_away : ∀ j : Fin 26, j.val ≤ 24 → (selectorSources (start j)).all (fun q => decide (q ≠ 1565)) = true := by
  decide +kernel

/-- The selector relation in front of the selector pop of the CRT chain: `1565 ⊕ 1559 ⊕ 1561..1564 ⊕ e0P+7 = 0`. -/
theorem sel_rel (j : Fin 26) (hi : j.val ≤ 24) (s : State) (zero7 : s.basis (Shadow7.e0P (start j)+7) = false) :
    eval (selectorExpr (start j))
      (run (GateMirror.forward (before5 (start j) ++ (Shadow7.leaveBarrel (start j) ++
        (keptHead (start j) ++ (KeptParity.placed (start j) ++ selPre (start j)))))) [] s).basis = false := by
  rw [forward_app, run_append, run_take, List.drop_nil, forward_app, run_append, run_take, List.drop_nil]
  rw [← pull_sound _ _ _ (sel_pre_pull j hi), expr_kept _ _ (sel_barrel_quiet j hi),
    ← pull_sound _ _ _ (sel_before_pull j hi)]
  simpa [eval, parity] using zero7

/-- `before5` without its adjust segment. -/
def before5Core (s : Nat) : List Gate :=
  let b := Shadow7.sbP s
  beforePre5Cut s ++ (row0New s ++ (rowGates (Shadow7.e0P s + 6) ((Shadow7.moveRows s).drop 1) ++
    (Shadow7.fix5P s b).drop 43))

theorem before5_core (s : Nat) : before5 s = before5Core s ++ Shadow7.leaveAdjust s := by
  simp only [before5, before5Core, beforePost5, List.append_assoc]

/-- Chain top (15-tick): `1557` is clean in front of the innermost store-chain link. The pull through the
after part leaves `1557`, the barrel and the adjust never write it, and the rest of `before5` erases it. -/
theorem link7_checked : ∀ j : Fin 26, j.val ≤ 24 →
    let s := start j
    pull (linkPre7 s) (false, [1557]) = some (false, [1557]) ∧
    pull (before5Core s) (false, [1557]) = some (false, []) ∧
    (List.range (Shadow7.wpP s + 15)).all (fun i => decide (Shadow7.bankW s i ≠ 1557)) = true ∧
    (List.range (Shadow7.wpP s - 1)).all (fun i => decide (Shadow7.poolW s i ≠ 1557)) = true := by
  decide +kernel

theorem link7_zero (j : Fin 26) (hi : j.val ≤ 24) (s : State) :
    (run (GateMirror.forward (before5 (start j) ++ (Shadow7.leaveBarrel (start j) ++ linkPre7 (start j)))) [] s).basis
      1557 = false := by
  obtain ⟨pA, pB, bank, pool⟩ := link7_checked j hi
  let st := start j
  have bankT (i : Nat) (h : i < Shadow7.wpP st + 15) : Shadow7.bankW st i ≠ 1557 :=
    of_decide_eq_true (List.all_eq_true.mp bank i (List.mem_range.mpr h))
  have barrelSafe : AllAT (fun _ => True) (· ≠ 1557) (Shadow7.leaveBarrel st) := by
    have stage (xs : List Wire) (d n : Nat) (bound : n + d ≤ Shadow7.wpP st + 15) :
        AllAT (fun _ => True) (· ≠ 1557) (stageG 1613 (Shadow7.bankW st) xs d n) :=
      allAT_stageG _ _ _ _ _ ⟨trivial, by decide⟩ (fun _ _ => trivial)
        (fun i used => ⟨⟨trivial, bankT i (by omega)⟩, ⟨trivial, bankT (i + d) (by omega)⟩⟩)
    unfold Shadow7.leaveBarrel
    exact allAT_append (allAT_append (allAT_append (stage _ _ _ (by omega))
      (stage _ _ _ (by omega))) (stage _ _ _ (by omega))) (stage _ _ _ (by omega))
  have adjustSafe : AllAT (fun _ => True) (· ≠ 1557) (Shadow7.leaveAdjust st) := by
    unfold Shadow7.leaveAdjust Shadow7.leaveAdjustCore
    refine allAT_append (allAT_cons ⟨fun _ _ => trivial, ?_⟩ allAT_nil) ?_
    · simp only [target, Shadow7.e0P, Wire]; omega
    · apply allAT_adjustG
      · intro w hw
        obtain ⟨i, index, rfl⟩ := List.mem_map.mp hw
        rw [List.mem_range] at index
        exact ⟨trivial, bankT i (by omega)⟩
      · intro w hw
        obtain ⟨i, index, rfl⟩ := List.mem_map.mp hw
        exact ⟨trivial, of_decide_eq_true (List.all_eq_true.mp pool i index)⟩
      · trivial
      · trivial
  have e1 := pull_sound _ _ _ pA
    (run (GateMirror.forward (Shadow7.leaveBarrel st)) [] (run (GateMirror.forward (before5 st)) [] s))
  have e2 := pull_sound _ _ _ pB s
  have k1 := keeps_targets (Shadow7.leaveBarrel st) 1557 (fun g hg => (barrelSafe g hg).2)
    (run (GateMirror.forward (before5 st)) [] s)
  have k2 := keeps_targets (Shadow7.leaveAdjust st) 1557 (fun g hg => (adjustSafe g hg).2)
    (run (GateMirror.forward (before5Core st)) [] s)
  have r : ∀ t : State, eval (false, [1557]) t.basis = t.basis 1557 := fun t => by simp [eval, parity]
  let X := run (GateMirror.forward (Shadow7.leaveBarrel st)) [] (run (GateMirror.forward (before5 st)) [] s)
  have v : (run (GateMirror.forward (before5 st ++ (Shadow7.leaveBarrel st ++ linkPre7 st))) [] s).basis 1557 =
      eval (false, [1557]) (run (GateMirror.forward (before5Core st)) [] s).basis :=
    calc (run (GateMirror.forward (before5 st ++ (Shadow7.leaveBarrel st ++ linkPre7 st))) [] s).basis 1557
        = (run (GateMirror.forward (linkPre7 st)) [] X).basis 1557 := by
          rw [forward_app, run_append, run_take, List.drop_nil, forward_app, run_append, run_take, List.drop_nil]
      _ = eval (false, [1557]) X.basis := (r _).symm.trans e1.symm
      _ = (run (GateMirror.forward (before5 st)) [] s).basis 1557 := (r X).trans k1
      _ = (run (GateMirror.forward (before5Core st)) [] s).basis 1557 := by
          rw [before5_core, forward_app, run_append, run_take, List.drop_nil]; exact k2
      _ = eval (false, [1557]) (run (GateMirror.forward (before5Core st)) [] s).basis := (r _).symm
  rw [v, ← e2]
  rfl

end ECDSAAdd.Entrant.StairPacket.DeadJoin
