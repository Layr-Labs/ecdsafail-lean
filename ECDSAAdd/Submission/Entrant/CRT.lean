def circuit (n D tags scratch : Nat) (pivots : List (Nat × Nat)) (sources : List (List Nat))
    (field : Bool → Program) (mir : Bool) : Program :=
  let p := basisProgram n pivots
  let c := correctionProgram n D tags scratch sources mir
  if mir then p ++ (c ++ (field true ++ p.reverse))
  else p ++ (field false ++ (c ++ p.reverse))

