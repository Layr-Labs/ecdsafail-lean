private theorem prefix_table : residueTable 76 outerRows 0 factors = true := by
  decide +kernel

private theorem extent : extent factors = 72 := by decide +kernel

private theorem scalar_direction (slot : Fin 17) (mirror : Bool) :
    let input := if mirror then scalarFrame slot else coded slot 0
    let output := if mirror then coded slot 0 else scalarFrame slot
    componentRows mirror slot.val 0 factors input = output := by
  intro input output
  have inputSize : input.size = 76 := by cases mirror <;> simp [input,coded_size,scalar_size]
  have outputSize : output.size = 76 := by cases mirror <;> simp [output,coded_size,scalar_size]
  apply componentRows_split 76 72 (dim slot) slot mirror outerRows input output outer_size
    inputSize outputSize (by decide) (Nat.le_refl _) (by decide) factors extent prefix_table
  · intro q hq
    cases mirror
    · simpa [input,entryShift] using coded_read slot q hq
    · exact scalar_read slot q hq
  · intro q hq
    cases mirror
    · exact scalar_read slot q hq
    · simpa [output,exitShift] using coded_read slot q hq

theorem scalar_action : ScalarAction := fun slot =>
  ⟨scalar_direction slot false,scalar_direction slot true⟩

