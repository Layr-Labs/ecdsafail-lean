def pulseCorrection (width retained tagCount scratch : Nat) (paritiesList : List (List Wire))
    (mir : Bool) (i : Nat) : Program :=
  let ps := paritySources paritiesList i
  let a := ps.headD 0
  let q := retained+i
  let prep : Program := (CRTResidueThreshold.sites width tagCount i).map (fun w => .CX w scratch) ++
    ps.tail.map (fun w => .CX w a)
  prep ++ [if mir then .measureX q [] [.CZ scratch a] else .CCX scratch a q] ++ prep.reverse

