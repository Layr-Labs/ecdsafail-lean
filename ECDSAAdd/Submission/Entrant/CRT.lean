open CRTBarrel.Packed

private theorem outer_size : outerRows.size = 54 := rfl

private theorem coded_size (slot : Fin 17) : (coded slot 0).size = 54 := by
  simp [coded,outer_size]

private theorem scalar_size (slot : Fin 17) : (scalarFrame slot).size = 54 := by
  simp [scalarFrame]

private theorem coded_read (slot : Fin 17) (q : Nat) (low : q < 54) :
    read (coded slot 0) q = clip slot 0 q := by
  simp [coded,clip,Matrix.read,outer_size,low]

private theorem scalar_read (slot : Fin 17) (q : Nat) (low : q < 54) :
    read (scalarFrame slot) q = clip slot (if q < 52 then shift slot else 0) q := by
