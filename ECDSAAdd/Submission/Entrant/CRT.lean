    have hx2 : x = q := (R2SqEp760.sqSwap K0 E0).injective (hx1.trans hfix.2.symm)
    exact hba q hq (hx2 ▸ hx)
  · exact hs_not_allowed q hq (List.mem_toFinset.mp hA)

