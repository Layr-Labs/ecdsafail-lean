namespace ECDSAAdd.Entrant.StairPacket.CRTResidueEarlyLogic
open Arithmetic CRTBarrel CRTBarrel.Matrix CRTBarrel.Packed CRTResidueCorrection CRTResidueGroupedBasis

private theorem run_four (a b c d : Program) (s0 s1 s2 s3 s4 : State)
    (tape : List Bool) (ha : ∀ m, run a m s0 = s1) (hb : ∀ m, run b m s1 = s2)
    (hc : ∀ m, run c m s2 = s3) (hd : ∀ m, run d m s3 = s4) :
    run (a ++ (b ++ (c ++ d))) tape s0 = s4 := by
  simp only [run_append,ha,hb,hc,hd]

/-- The two directions restore phase and all flag and scratch cells on every tape. -/
theorem run_circuit (n D tags scratch : Nat) (pivots : List (Nat × Nat)) (sources : List (List Nat))
    (rows : Rows) (size : rows.size=n) (lives : D < n) (pool : n+tags ≤ scratch)
    (good : Good n pivots) (coord : applyOps (ops n pivots) (units n) = rows)
    (parities : ∀ i : Fin (n-D), (paritySources sources i.val).Nodup ∧
      paritySources sources i.val ≠ [] ∧ ∀ q ∈ paritySources sources i.val, q < D)
    (masks : MaskOK n D sources rows)
    (slot : Fin (tags+1)) (dim : Nat) (fit : dim ≤ D) (field : Bool → Program)
    (word : Nat → Bool) (phase : Bool) (tape : List Bool) (mir : Bool)
    (fieldRun : ∀ b m, run (field b) m
      (frameTagged tags (windowRows (keepPrefix rows D) dim (entryShift b slot.val)) word dim slot.val phase) =
      frameTagged tags (windowRows (keepPrefix rows D) dim (exitShift b slot.val)) word dim slot.val phase) :
    run (circuit n D tags scratch pivots sources field mir) tape
      (frameTagged tags (plain n dim (entryShift mir slot.val)) word dim slot.val phase) =
      frameTagged tags (plain n dim (exitShift mir slot.val)) word dim slot.val phase := by
  let k := slot.val-1
  let O := ops n pivots
  let P := cnotProgram O
  let encodeRows (h : Nat) := windowRows rows dim h
  let slimRows (h : Nat) := windowRows (keepPrefix rows D) dim h
  let S (r : Rows) := frameTagged tags r word dim slot.val phase
  let inFlags := CRTResidueThreshold.flags n tags slot.val
  have outSize (h : Nat) : (encodeRows h).size=n := (windowRows_size ..).trans size
  have slimSize (h : Nat) : (slimRows h).size=n := (windowRows_size ..).trans ((keepPrefix_size ..).trans size)
  have inputFrame (h : Nat) : S (plain n dim h) = ⟨phase,Matrix.basis (plain n dim h) word dim inFlags⟩ := by
    unfold S frameTagged inFlags
    rw [plain_size]
  have encodeFrame (h : Nat) : S (encodeRows h) = ⟨phase,Matrix.basis (encodeRows h) word dim inFlags⟩ := by
    unfold S frameTagged inFlags
    rw [outSize]
  have fwd (h : Nat) (m : List Bool) : run P m (S (plain n dim h)) = S (encodeRows h) := by
    rw [inputFrame,encodeFrame]
    have bounds : ∀ p ∈ O, p.1 < (plain n dim h).size ∧ p.2 < (plain n dim h).size := by
      intro p hp
      rw [plain_size]
      have t := ops_bounds n pivots good p hp
      exact ⟨t.1,t.2.1⟩
    have move := run_ops O (plain n dim h) word dim inFlags phase m bounds
    have coordinates : applyOps O (plain n dim h) = encodeRows h := encode n dim h pivots rows coord
    rw [coordinates] at move
    exact move
  have rev (h : Nat) (m : List Bool) : run P.reverse m (S (encodeRows h)) = S (plain n dim h) := by
    have apart : ∀ p ∈ O, p.1 ≠ p.2 := fun p hp => (ops_bounds n pivots good p hp).2.2
    have undo := reverse_cnots O apart (S (plain n dim h)) [] m
    have reverseProgram : cnotProgram O.reverse = P.reverse := List.map_reverse
    rw [reverseProgram,show cnotProgram O = P from rfl,fwd] at undo
    exact undo
  have front : encodeRows 0 = slimRows 0 := unshifted_core n D sources rows size dim fit masks
  have clean := correction_boundary n D sources rows size (by omega) dim slot.val fit masks
  have prepared (i : Fin (n-D)) : Matrix.read (encodeRows k) (D+i.val) =
      if i.val < k then parityRow sources (encodeRows k) i.val else 0 :=
    shifted_quotient n D sources rows size dim k fit i (masks i).1 (masks i).2.1 (masks i).2.2
  cases mir
  · have first (m : List Bool) : run P m (S (plain n dim 0)) = S (slimRows 0) :=
      (fwd 0 m).trans (congrArg S front)
    have second (m : List Bool) : run (field false) m (S (slimRows 0)) = S (slimRows k) := fieldRun false m
    have third (m : List Bool) : run (correctionProgram n D tags scratch sources false) m
        (S (slimRows k)) = S (encodeRows k) :=
      (corrections_run lives pool parities _ (slimSize k) slot false word dim phase m (by intro impossible; cases impossible)).trans
        (congrArg S clean.2)
    exact run_four _ _ _ _ _ _ _ _ _ tape first second third (rev k)
  · have second (m : List Bool) : run (correctionProgram n D tags scratch sources true) m
        (S (encodeRows k)) = S (slimRows k) :=
      (corrections_run lives pool parities _ (outSize k) slot true word dim phase m (fun _ => prepared)).trans
        (congrArg S clean.1)
    have third (m : List Bool) : run (field true) m (S (slimRows k)) = S (slimRows 0) := fieldRun true m
    have last (m : List Bool) : run P.reverse m (S (slimRows 0)) = S (plain n dim 0) :=
      (congrArg (run P.reverse m) (congrArg S front.symm)).trans (rev 0 m)
    exact run_four _ _ _ _ _ _ _ _ _ tape (fwd k) second third last

/-- Unitary `d = 1` descending residue circuit: identity when `slot ≤ 1`, residue+quotient shift when `slot ≥ 2`. -/
theorem run_circuitDesc (n D tags scratch : Nat) (pivots : List (Nat × Nat)) (sources : List (List Nat))
    (rows : Rows) (size : rows.size = n) (hD : D = n - 1) (lives : D < n) (pool : n + tags ≤ scratch)
    (good : Good n pivots) (coord : applyOps (ops n pivots) (units n) = rows)
    (parities : ∀ i : Fin (n - D), (paritySources sources i.val).Nodup ∧
      paritySources sources i.val ≠ [] ∧ ∀ q ∈ paritySources sources i.val, q < D)
    (masks : MaskOK n D sources rows)
    (slot : Fin (tags + 1)) (field : Bool → Program)
    (word : Nat → Bool) (phase : Bool) (tape : List Bool) (mir : Bool)
    (fieldRun : ∀ (_ : 2 ≤ slot.val) b m, run (field b) m
      (frameTagged tags (windowRows (keepPrefix rows D) (n - (slot.val - 1)) (entryShift b slot.val)) word (n - (slot.val - 1)) slot.val phase) =
      frameTagged tags (windowRows (keepPrefix rows D) (n - (slot.val - 1)) (exitShift b slot.val)) word (n - (slot.val - 1)) slot.val phase)
    (fieldRunZero : ∀ (_ : slot.val ≤ 1) b m, run (field b) m
      (frameTagged tags (windowRows rows (n - (slot.val - 1)) 0) word (n - (slot.val - 1)) slot.val phase) =
      frameTagged tags (windowRows rows (n - (slot.val - 1)) 0) word (n - (slot.val - 1)) slot.val phase) :
    run (circuitDesc n D tags scratch pivots sources field mir) tape
      (frameTagged tags (plain n (n - (slot.val - 1)) (entryShift mir slot.val)) word (n - (slot.val - 1)) slot.val phase) =
      frameTagged tags (plain n (n - (slot.val - 1)) (exitShift mir slot.val)) word (n - (slot.val - 1)) slot.val phase := by
  let dim := n - (slot.val - 1)
  let k := slot.val - 1
  let O := ops n pivots
  let P := cnotProgram O
  let encodeRows (h : Nat) := windowRows rows dim h
  let slimRows (h : Nat) := windowRows (keepPrefix rows D) dim h
  let S (r : Rows) := frameTagged tags r word dim slot.val phase
  let inFlags := CRTResidueThreshold.flags n tags slot.val
  have outSize (h : Nat) : (encodeRows h).size = n := (windowRows_size ..).trans size
  have slimSize (h : Nat) : (slimRows h).size = n := (windowRows_size ..).trans ((keepPrefix_size ..).trans size)
  have inputFrame (h : Nat) : S (plain n dim h) = ⟨phase, Matrix.basis (plain n dim h) word dim inFlags⟩ := by
    unfold S frameTagged inFlags; rw [plain_size]
  have encodeFrame (h : Nat) : S (encodeRows h) = ⟨phase, Matrix.basis (encodeRows h) word dim inFlags⟩ := by
    unfold S frameTagged inFlags; rw [outSize]
  have fwd (h : Nat) (m : List Bool) : run P m (S (plain n dim h)) = S (encodeRows h) := by
    rw [inputFrame, encodeFrame]
    have bounds : ∀ p ∈ O, p.1 < (plain n dim h).size ∧ p.2 < (plain n dim h).size := by
      intro p hp; rw [plain_size]; have t := ops_bounds n pivots good p hp; exact ⟨t.1, t.2.1⟩
    have move := run_ops O (plain n dim h) word dim inFlags phase m bounds
    have coordinates : applyOps O (plain n dim h) = encodeRows h := encode n dim h pivots rows coord
    rw [coordinates] at move; exact move
  have rev (h : Nat) (m : List Bool) : run P.reverse m (S (encodeRows h)) = S (plain n dim h) := by
    have apart : ∀ p ∈ O, p.1 ≠ p.2 := fun p hp => (ops_bounds n pivots good p hp).2.2
    have undo := reverse_cnots O apart (S (plain n dim h)) [] m
    have reverseProgram : cnotProgram O.reverse = P.reverse := List.map_reverse
    rw [reverseProgram, show cnotProgram O = P from rfl, fwd] at undo
    exact undo
  by_cases hz : slot.val ≤ 1
  · have he : entryShift mir slot.val = 0 := by cases mir <;> simp [entryShift] <;> omega
    have hx : exitShift mir slot.val = 0 := by cases mir <;> simp [exitShift] <;> omega
    have corrId : correctionRows n D sources (encodeRows 0) slot.val = encodeRows 0 :=
      correction_zero n D sources (encodeRows 0) (outSize 0) slot.val hz
    have corrStep (m : List Bool) : run (correctionProgram n D tags scratch sources false) m (S (encodeRows 0)) = S (encodeRows 0) :=
      (corrections_run lives pool parities _ (outSize 0) slot false word dim phase m (by intro h; cases h)).trans (congrArg S corrId)
    rw [he, hx]
    cases mir
    · exact run_four _ _ _ _ _ _ _ _ _ tape (fwd 0) (fieldRunZero hz false) corrStep (rev 0)
    · exact run_four _ _ _ _ _ _ _ _ _ tape (fwd 0) corrStep (fieldRunZero hz true) (rev 0)
  · have hge : 2 ≤ slot.val := by omega
    have fit : dim ≤ D := by dsimp only [dim]; omega
    have front : encodeRows 0 = slimRows 0 := unshifted_core n D sources rows size dim fit masks
    have clean := correction_boundary n D sources rows size (by omega) dim slot.val fit masks
    cases mir
    · have first (m : List Bool) : run P m (S (plain n dim 0)) = S (slimRows 0) :=
        (fwd 0 m).trans (congrArg S front)
      have second (m : List Bool) : run (field false) m (S (slimRows 0)) = S (slimRows k) := fieldRun hge false m
      have third (m : List Bool) : run (correctionProgram n D tags scratch sources false) m (S (slimRows k)) = S (encodeRows k) :=
        (corrections_run lives pool parities _ (slimSize k) slot false word dim phase m (by intro h; cases h)).trans (congrArg S clean.2)
      exact run_four _ _ _ _ _ _ _ _ _ tape first second third (rev k)
    · have second (m : List Bool) : run (correctionProgram n D tags scratch sources false) m (S (encodeRows k)) = S (slimRows k) :=
        (corrections_run lives pool parities _ (outSize k) slot false word dim phase m (by intro h; cases h)).trans (congrArg S clean.1)
      have third (m : List Bool) : run (field true) m (S (slimRows k)) = S (slimRows 0) := fieldRun hge true m
      have last (m : List Bool) : run P.reverse m (S (slimRows 0)) = S (plain n dim 0) :=
        (congrArg (run P.reverse m) (congrArg S front.symm)).trans (rev 0 m)
      exact run_four _ _ _ _ _ _ _ _ _ tape (fwd k) second third last

end ECDSAAdd.Entrant.StairPacket.CRTResidueEarlyLogic


