section
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.StairPacket.CRTBarrel
open Placement ECDSAAdd.RecordedQuantum

private theorem lateNineBasis_bounds (width : Nat) (plan : List (Nat × Nat))
    (checked : ∀ v ∈ plan.zipIdx,
      v.1.1 < width ∧ v.2 < width ∧ v.1.2.testBit v.2 = false) :
    ∀ pair ∈ lateNineOps width plan, pair.1 < width ∧ pair.2 < width ∧ pair.1 ≠ pair.2 := by
  intro pair hp
  obtain ⟨⟨⟨j,mask⟩,i⟩,listed,step⟩ := List.mem_flatMap.mp (List.mem_reverse.mp hp)
  have ⟨hj,hi,clear⟩ := checked _ listed
  change pair ∈ (if j = i then [] else [(i,j),(j,i),(i,j)]) ++
    (selected width mask).map (fun q => (i,q)) at step
  rcases List.mem_append.mp step with swap | spill
  · by_cases same : j = i
    · simp [same] at swap
    · simp only [if_neg same, List.mem_cons, List.not_mem_nil, or_false] at swap
      rcases swap with rfl | rfl | rfl
      · exact ⟨hi,hj,Ne.symm same⟩
      · exact ⟨hj,hi,same⟩
      · exact ⟨hi,hj,Ne.symm same⟩
  · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp spill
    change q ∈ (List.range width).filter mask.testBit at hq
    obtain ⟨within,bit⟩ := List.mem_filter.mp hq
    refine ⟨hi,List.mem_range.mp within,?_⟩
    intro eq
    change i = q at eq
    subst q
    change mask.testBit i = false at clear
    simp [clear] at bit

private theorem lateNineBasis_fits (width bound : Nat) (room : width ≤ bound)
    (plan : List (Nat × Nat))
    (checked : ∀ v ∈ plan.zipIdx,
      v.1.1 < width ∧ v.2 < width ∧ v.1.2.testBit v.2 = false) :
    Fits (· < bound) (lateNineBasis width plan) := by
  intro instr hi
  change instr ∈ (lateNineOps width plan).map (fun (a, b) => Instr.CX a b) at hi
  obtain ⟨pair, member, rfl⟩ := List.mem_map.mp hi
  have bounds := lateNineBasis_bounds width plan checked pair member
  obtain ⟨a, b⟩ := pair
  refine ⟨bounds.2.2, ?_⟩
  intro q hq
  simp only [Instr.wires, Finset.mem_insert, Finset.mem_singleton] at hq
  rcases hq with rfl | rfl
  · exact lt_of_lt_of_le bounds.1 room
  · exact lt_of_lt_of_le bounds.2.1 room

private theorem lateNineCoherent_fits {bound : Nat} {program : Program}
    (checked : (program.all fun i => physicalBit i && decide (∀ q ∈ i.wires, q < bound)) = true) :
    Fits (· < bound) program := by
  intro i hi
  have ok := List.all_eq_true.mp checked i hi
  simp only [Bool.and_eq_true] at ok
  obtain ⟨physical, cover⟩ := ok
  refine ⟨?_, of_decide_eq_true cover⟩
  cases i <;> simp_all [physicalBit, PhysicalInstr, ProperGate]

end ECDSAAdd.Entrant.StairPacket.CRTBarrel
end

