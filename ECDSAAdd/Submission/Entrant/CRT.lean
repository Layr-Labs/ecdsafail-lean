section

open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Entrant.StairPacket

section
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000
namespace ECDSAAdd.Entrant.LateQuotientShift

open ECDSAAdd MeasuredCodec5

def quotientWidth (four : Bool) : Nat := if four then 4 else 3

/-- The quotient lanes come first, then tags 1 through `r−1`, then one scratch. -/
def ports (four : Bool) : Finset Wire := Finset.range (2 * quotientWidth four)

def scratch (four : Bool) : Wire := 2 * quotientWidth four - 1

private def exchange (control a b : Wire) : Program :=
  [.CX a b, .CCX control b a, .CX a b]

private def sharedExchange (tagA tagB temp a b : Wire) : Program :=
  [.CX tagA temp, .CX tagB temp] ++ exchange temp a b ++
    [.CX tagB temp, .CX tagA temp]

/-- The shared schedules use exactly the gate order in `shared.json`. -/
def forward (four : Bool) : Program :=
  if four then
    exchange 5 1 3 ++ exchange 4 0 1 ++
      sharedExchange 4 5 7 0 2 ++ sharedExchange 4 6 7 0 3
  else
    exchange 3 0 1 ++ sharedExchange 3 4 5 0 2

def program (four mirror : Bool) : Program :=
  if mirror then (forward four).reverse else forward four

/-- Larger shifts have the same local effect as shift 4. The input quotient is zero. -/
def capShift (k : Nat) : Fin 5 := ⟨min k 4, by omega⟩

theorem capShift_width (four : Bool) (k : Nat) :
    quotientWidth four - (capShift k).val = quotientWidth four - k := by
  by_cases h : k ≤ 4
  · simp [capShift, Nat.min_eq_left h]
  · have h' : 4 ≤ k := by omega
    cases four <;> simp [capShift, Nat.min_eq_right h', quotientWidth] <;> omega

theorem capShift_tag (k i : Nat) (hi : i < 4) : (capShift k).val = i ↔ k = i := by
  by_cases h : k ≤ 4
  · simp [capShift, Nat.min_eq_left h]
  · have h' : 4 ≤ k := by omega
    simp [capShift, Nat.min_eq_right h', show 4 ≠ i by omega, show k ≠ i by omega]

def tagWord (four : Bool) (k : Fin 5) : Nat :=
  if 0 < k.val ∧ k.val < quotientWidth four then 2 ^ (quotientWidth four + k.val - 1)
  else 0

/-- The `W−k` input bound leaves `r−k` usable low quotient bits. -/
def frameWord (four shifted : Bool) (k : Fin 5) (word : Fin 16) : Nat :=
  let admitted := word.val % 2 ^ (quotientWidth four - k.val)
  (if shifted then admitted <<< k.val else admitted) ||| tagWord four k

theorem frameWord_of_small (four shifted : Bool) (k : Fin 5) (word : Fin 16)
    (small : word.val < 2 ^ (quotientWidth four - k.val)) :
    frameWord four shifted k word =
      (if shifted then word.val <<< k.val else word.val) ||| tagWord four k := by
  simp [frameWord, Nat.mod_eq_of_lt small]

def Frame (four shifted : Bool) (f : Wire → Wire) (k : Fin 5) (word : Fin 16)
    (s : State) : Prop :=
  ∀ q ∈ ports four, s.basis (f q) = (frameWord four shifted k word).testBit q

def admittedBit (four shifted : Bool) (k : Fin 5) (word : Fin 16) (q : Wire) : Bool :=
  if q < quotientWidth four then
    (if shifted then word.val <<< k.val else word.val).testBit q
  else if q < scratch four then
    decide (k.val = q + 1 - quotientWidth four)
  else false

set_option maxRecDepth 4000 in
private theorem finite_frame : ∀ (four shifted : Bool) (k : Fin 5) (word : Fin 16)
    (q : Fin 8), word.val < 2 ^ (quotientWidth four - k.val) →
    q.val ∈ ports four →
    (frameWord four shifted k word).testBit q.val = admittedBit four shifted k word q.val := by
  decide +kernel

private theorem quotientWidth_le (four : Bool) : quotientWidth four ≤ 4 := by
  cases four <;> decide

/-- The finite action uses the caller's small quotient, the one-hot tags and clean scratch. -/
theorem frame_iff (four shifted : Bool) (f : Wire → Wire) (k : Fin 5) (word : Fin 16)
    (s : State) (small : word.val < 2 ^ (quotientWidth four - k.val)) :
    Frame four shifted f k word s ↔
      ∀ q ∈ ports four, s.basis (f q) = admittedBit four shifted k word q := by
  have width (q : Wire) (hq : q ∈ ports four) : q < 8 := by
    have h : q < 2 * quotientWidth four := Finset.mem_range.mp hq
    exact lt_of_lt_of_le h (Nat.mul_le_mul_left 2 (quotientWidth_le four))
  constructor
  · intro h q hq
    exact (h q hq).trans (finite_frame four shifted k word ⟨q, width q hq⟩ small hq)
  · intro h q hq
    exact (h q hq).trans (finite_frame four shifted k word ⟨q, width q hq⟩ small hq).symm

private theorem finite_shift : ∀ (four mirror : Bool) (k : Fin 5) (word : Fin 16),
    bitRun (program four mirror) (frameWord four mirror k word) =
      frameWord four (!mirror) k word := by
  decide +kernel

set_option maxRecDepth 4000 in
theorem support (four mirror : Bool) : wires (program four mirror) ⊆ ports four := by
  cases four <;> cases mirror <;> decide

private theorem safe_coherent (four mirror : Bool) (word : Nat) :
    safe (program four mirror) word = true := by
  cases four <;> cases mirror <;> rfl

private theorem local_run (four mirror : Bool) (k : Fin 5) (word : Fin 16)
    (phase : Bool) (m : List Bool) :
    run (program four mirror) m ⟨phase, bitsOf (frameWord four mirror k word)⟩ =
      ⟨phase, bitsOf (frameWord four (!mirror) k word)⟩ := by
  rw [run_sim, sim_safe _ _ (safe_coherent four mirror _) m phase,
    finite_shift four mirror k word]

/-- Transports the local action to a finite injective wire placement and any record tape. -/
theorem placed_run (four mirror : Bool) (f : Wire → Wire)
    (injective : ∀ a ∈ ports four, ∀ b ∈ ports four, f a = f b → a = b)
    (k : Fin 5) (word : Fin 16) (s : State) (m : List Bool)
    (input : Frame four mirror f k word s) :
    let out := run (renameProgram f (program four mirror)) m s
    out.phase = s.phase ∧ Frame four (!mirror) f k word out ∧
      ∀ q, q ∉ (ports four).image f → out.basis q = s.basis q := by
  let t : State := ⟨s.phase, bitsOf (frameWord four mirror k word)⟩
  have agree : ∀ q ∈ ports four, t.basis q = s.basis (f q) :=
    fun q hq => (input q hq).symm
  have rel := run_rename_pool f (ports four) injective (program four mirror)
    (support four mirror) m t s rfl agree
  have small : run (program four mirror) m t =
      ⟨s.phase, bitsOf (frameWord four (!mirror) k word)⟩ :=
    local_run four mirror k word s.phase m
  rw [small] at rel
  exact ⟨rel.1, rel.2, fun q hq => run_rename_pool_outside f (ports four)
    (program four mirror) (support four mirror) m s q hq⟩

end ECDSAAdd.Entrant.LateQuotientShift

