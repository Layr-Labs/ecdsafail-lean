  rw [small] at rel
  exact ⟨rel.1, rel.2, fun q hq => run_rename_pool_outside f (ports four)
    (program four mirror) (support four mirror) m s q hq⟩

end ECDSAAdd.Entrant.LateQuotientShiftTwo

namespace ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed

open Matrix Placement

private theorem clip_twice (dim k value : Nat) :
    clipShift dim 0 (clipShift dim k value) = clipShift dim k value := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [clipShift,Nat.testBit_shiftRight,Nat.zero_add,Nat.testBit_and]
  cases (2^dim-1).testBit i <;> simp

/-- Apply the checked prototype prefix to split coordinates. The high rows use
shift zero in both directions and are preserved by the scalar. -/
theorem componentRows_split (n D dim : Nat) (slot : Fin 17) (mir : Bool)
    (rs input output : Rows) (size : rs.size = n) (inputSize : input.size = n) (outputSize : output.size = n)
    (high : n ≤ 135) (fit : dim ≤ n-(slot.val-1)) (bound : D ≤ n)
    (parts : List (Nat × Nat)) (extent_eq : extent parts = D)
    (table : residueTable n rs 0 parts = true)
    (inputSpec : ∀ q < n, read input q = clipShift dim (if q < D then entryShift mir slot.val else 0) (read rs q))
    (outputSpec : ∀ q < n, read output q = clipShift dim (if q < D then exitShift mir slot.val else 0) (read rs q)) :
    componentRows mir slot.val 0 parts input = output := by
  let src := residueWord input dim 0
  let originalSrc := residueWord rs dim (entryShift mir slot.val)
  let originalDst := residueWord rs dim (exitShift mir slot.val)
  have room : dim ≤ width := by unfold width; omega
  have matched : Matches src input := by
    intro q hq
    have inside : q < n := inputSize ▸ hq
    change read input q = digit width (residueWord input dim 0) q
    rw [residue_word_digit input dim 0 q room hq,inputSpec q inside,clip_twice]
  have front (q : Nat) (low : q < D) : digit width src q = digit width originalSrc q := by
    have inside : q < n := lt_of_lt_of_le low bound
    have old := residue_word_digit rs dim (entryShift mir slot.val) q room (size.symm ▸ inside)
    have current := matched q (inputSize.symm ▸ inside)
    rw [inputSpec q inside,if_pos low] at current
    exact current.symm.trans old.symm
  have align (ps : List (Nat × Nat)) (off : Nat) (endp : off + extent ps ≤ D)
      (old : PrefixAligned dim slot.val mir originalSrc originalDst off ps) :
      PrefixAligned dim slot.val mir src originalDst off ps := by
    induction ps generalizing off with
    | nil => exact True.intro
    | cons pair tail ih =>
      obtain ⟨p,m⟩ := pair
      change off+(fieldDegree p*m+extent tail) ≤ D at endp
      obtain ⟨use,readIn,readOut,more⟩ := old
      refine ⟨use,?_,readOut,ih (off+fieldDegree p*m) (by omega) more⟩
      intro j hj
      exact (front (off+j) (by omega)).trans (readIn j hj)
  have original : PrefixAligned dim slot.val mir originalSrc originalDst 0 parts :=
    residue_table_aligned n dim slot mir rs size high fit parts 0 (by rw [Nat.zero_add,extent_eq]; exact bound) table
  have aligned := align parts 0
    (by simpa only [Nat.zero_add,extent_eq] using (Nat.le_refl D)) original
  let actual := componentRows mir slot.val 0 parts input
  have actualSize : actual.size = n := (componentRows_size ..).trans inputSize
  have agree : Matches (componentWord n mir slot.val 0 parts src) actual :=
    components_match n src 0 slot.val mir parts input inputSize
      (by rw [Nat.zero_add,extent_eq]; exact bound) matched
  change actual = output
  apply Array.ext (actualSize.trans outputSize.symm)
  intro q ha ho
  have inside : q < n := actualSize ▸ ha
  have readEq : read actual q = read output q := by
    rw [agree q ha,prefix_action n dim slot mir src originalDst parts aligned q,extent_eq,outputSpec q inside]
    by_cases low : q < D
    · simp only [if_pos low]
      exact residue_word_digit rs dim (exitShift mir slot.val) q room (size.symm ▸ inside)
    · simp only [if_neg low]
      rw [← matched q (inputSize.symm ▸ inside),inputSpec q inside,if_neg low]
  simpa only [Matrix.read,Array.getElem?_eq_getElem ha,Array.getElem?_eq_getElem ho,Option.getD_some] using readEq

end ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed

namespace ECDSAAdd.Entrant.StairPacket.LateResidue345

open ECDSAAdd CRTBarrel CRTBarrel.Matrix CRTBarrel.Placement

def prep (tags taps : List Wire) (a b : Wire) : Program :=
  CRTBarrel.toggles tags a ++ CRTBarrel.toggles taps b

def coherentStep (tags taps : List Wire) (a b target : Wire) : Program :=
  prep tags taps a b ++ ([Instr.CCX a b target] ++ (prep tags taps a b).reverse)

private theorem xorAt_agree (u v : BasisState) (xs : List Wire)
    (h : ∀ q ∈ xs, u q = v q) : CRTBarrel.xorAt u xs = CRTBarrel.xorAt v xs := by
  induction xs with
  | nil => rfl
  | cons q qs ih =>
    rw [CRTBarrel.xorAt, CRTBarrel.xorAt, h q (by simp), ih (fun j hj => h j (List.mem_cons_of_mem _ hj))]

private theorem toggles_proper (xs : List Wire) (q : Wire) (fresh : q ∉ xs) :
    ProperProgram (CRTBarrel.toggles xs q) := by
  intro i hi
  change i ∈ xs.map (fun p => Instr.CX p q) at hi
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hi
  exact fun eq => fresh (eq ▸ hp)

private def prepared (tags taps : List Wire) (a b : Wire) (bits : BasisState) : BasisState :=
  writeBit (writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags)) b (bits b ^^ CRTBarrel.xorAt bits taps)

private theorem prep_run (tags taps : List Wire) (a b : Wire)
    (ab : a ≠ b) (atags : a ∉ tags) (btaps : b ∉ taps) (ataps : a ∉ taps)
    (s : State) (m : List Bool) :
    run (prep tags taps a b) m s = ⟨s.phase, prepared tags taps a b s.basis⟩ := by
  cases s with
  | mk ph bits =>
    rw [prep, run_append, CRTBarrel.run_toggles _ _ atags, CRTBarrel.run_toggles _ _ btaps]
    have keep : CRTBarrel.xorAt (writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags)) taps = CRTBarrel.xorAt bits taps :=
      xorAt_agree _ _ _ (fun q hq => by
        have ne : q ≠ a := fun e => ataps (e ▸ hq)
        simp [writeBit, Function.update_of_ne ne])
    have pivotKeep : writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags) b = bits b := by
      simp [writeBit, Function.update_of_ne ab.symm]
    simp only [prepared, pivotKeep, keep]

/-- Compute the two parities, use a single Toffoli, and undo the preparation. -/
theorem coherent_run (tags taps : List Wire) (a b target : Wire)
    (ab : a ≠ b) (ta : target ≠ a) (tb : target ≠ b)
    (atags : a ∉ tags) (btaps : b ∉ taps) (ataps : a ∉ taps)
    (ttags : target ∉ tags) (ttaps : target ∉ taps) (s : State) (m : List Bool) :
    run (coherentStep tags taps a b target) m s =
      ⟨s.phase, writeBit s.basis target
        (s.basis target ^^ ((s.basis a ^^ CRTBarrel.xorAt s.basis tags) &&
          (s.basis b ^^ CRTBarrel.xorAt s.basis taps)))⟩ := by
  let selector := s.basis a ^^ CRTBarrel.xorAt s.basis tags
  let parity := s.basis b ^^ CRTBarrel.xorAt s.basis taps
  let value := s.basis target ^^ (selector && parity)
  let next : State := ⟨s.phase, writeBit s.basis target value⟩
  let ready : State := ⟨s.phase, prepared tags taps a b s.basis⟩
  let toggled : State := ⟨s.phase, writeBit ready.basis target value⟩
  have first (tape : List Bool) : run (prep tags taps a b) tape s = ready :=
    prep_run tags taps a b ab atags btaps ataps s tape
  have middle (tape : List Bool) : run [Instr.CCX a b target] tape ready = toggled := by
    have ha : ready.basis a = selector := by
      simp only [ready, prepared, writeBit, Function.update_of_ne ab, Function.update_self, selector]
    have hb : ready.basis b = parity := by
      simp only [ready, prepared, writeBit, Function.update_self, parity]
    have ht : ready.basis target = s.basis target := by
      simp only [ready, prepared, writeBit, Function.update_of_ne ta, Function.update_of_ne tb]
    change (⟨ready.phase, writeBit ready.basis target
      (ready.basis target ^^ (ready.basis a && ready.basis b))⟩ : State) = toggled
    rw [ha, hb, ht]
  have move : run (prep tags taps a b) [] next = toggled := by
    rw [prep_run tags taps a b ab atags btaps ataps]
    have same (xs : List Wire) (h : target ∉ xs) :
        CRTBarrel.xorAt next.basis xs = CRTBarrel.xorAt s.basis xs := by
      apply xorAt_agree
      intro q hq
      have ne : q ≠ target := fun e => h (e ▸ hq)
      simp [next, writeBit, Function.update_of_ne ne]
    rw [show next.phase = s.phase from rfl]
    apply congrArg (State.mk s.phase)
    unfold prepared
    rw [same tags ttags, same taps ttaps,
      show next.basis a = s.basis a by simp [next, writeBit, Function.update_of_ne ta.symm],
      show next.basis b = s.basis b by simp [next, writeBit, Function.update_of_ne tb.symm]]
    change Function.update (Function.update (Function.update s.basis target value) a selector) b parity =
      Function.update (Function.update (Function.update s.basis a selector) b parity) target value
    have firstSwap : Function.update (Function.update s.basis target value) a selector =
        Function.update (Function.update s.basis a selector) target value :=
      Function.update_comm ta value selector s.basis
    have secondSwap :
        Function.update (Function.update (Function.update s.basis a selector) target value) b parity =
          Function.update (Function.update (Function.update s.basis a selector) b parity) target value :=
      Function.update_comm tb value parity (Function.update s.basis a selector)
    exact (congrArg (fun bits : BasisState => Function.update bits b parity) firstSwap).trans secondSwap
  have proper : ProperProgram (prep tags taps a b) :=
    (properProgram_append _ _).mpr ⟨toggles_proper _ _ atags, toggles_proper _ _ btaps⟩
  have undo (tape : List Bool) : run (prep tags taps a b).reverse tape toggled = next := by
    rw [← move]
    exact run_reverse_proper _ proper next [] tape
  change run (coherentStep tags taps a b target) m s = next
  rw [coherentStep, run_append, run_append, first, middle, undo]

/-! The data below is the selected option for window 345 in `shared.json`. -/

def factors : List (Nat × Nat) :=
  [(11,1), (13,1), (19,1), (21,1), (25,1), (31,1), (73,1), (257,1), (313,1), (471,1), (1193,1), (1571,1)]

def mask (i : Fin 4) : Nat :=
  if i.val = 0 then 841926185640904790271
  else if i.val = 1 then 1683852371191346848246
  else if i.val = 2 then 3367704724823793911781
  else 2013042966773379222410

def taps (i : Fin 4) : List Wire := selected 72 (mask i)
def tags (i : Fin 4) : List Wire := List.range' (77 + i.val) (15 - i.val)
def pivot (i : Fin 4) : Wire := (taps i).headD 0
def dest (i : Fin 4) : Wire := 72 + i.val

def correction (i : Fin 4) : Program := coherentStep (tags i) (taps i).tail 100 (pivot i) (dest i)

set_option maxRecDepth 4000 in
private theorem separate : ∀ i : Fin 4,
    (100 : Wire) ≠ pivot i ∧ dest i ≠ 100 ∧ dest i ≠ pivot i ∧
    100 ∉ tags i ∧ pivot i ∉ (taps i).tail ∧ 100 ∉ (taps i).tail ∧
    dest i ∉ tags i ∧ dest i ∉ (taps i).tail := by decide +kernel

set_option maxRecDepth 4000 in
private theorem correction_tags : ∀ (slot : Fin 17) (i : Fin 4),
    CRTBarrel.xorAt (CRTBarrel.flags 76 slot.val) (tags i) = decide (i.val < slot.val - 1) := by decide +kernel

def Flags (slot : Fin 17) (s : State) : Prop :=
  ∀ q, 76 ≤ q → s.basis q = CRTBarrel.flags 76 slot.val q

def corrected (slot : Fin 17) (i : Fin 4) (s : State) : State :=
  ⟨s.phase, writeBit s.basis (dest i)
    (s.basis (dest i) ^^ (decide (i.val < slot.val - 1) && CRTBarrel.xorAt s.basis (taps i)))⟩

theorem correction_run (slot : Fin 17) (i : Fin 4) (s : State) (m : List Bool)
    (h : Flags slot s) : run (correction i) m s = corrected slot i s := by
  obtain ⟨ab, ta, tb, atags, btaps, ataps, ttags, ttaps⟩ := separate i
  have hot : CRTBarrel.xorAt s.basis (tags i) = decide (i.val < slot.val - 1) := by
    rw [← correction_tags slot i]
    apply xorAt_agree
    intro q hq
    change q ∈ List.range' (77 + i.val) (15 - i.val) at hq
    have lower : 77 + i.val ≤ q := (List.mem_range'_1.mp hq).1
    exact h q (le_trans (le_trans (by decide : 76 ≤ 77) (Nat.le_add_right 77 i.val)) lower)
  have size : ∀ j : Fin 4, taps j = pivot j :: (taps j).tail := by decide +kernel
  rw [correction, coherent_run _ _ _ _ _ ab ta tb atags btaps ataps ttags ttaps,
    h 100 (by decide), hot]
  have zero : CRTBarrel.flags 76 slot.val 100 = false := by simp [CRTBarrel.flags]
  have parity : CRTBarrel.xorAt s.basis (taps i) = (s.basis (pivot i) ^^ CRTBarrel.xorAt s.basis (taps i).tail) := by
    exact congrArg (CRTBarrel.xorAt s.basis) (size i)
  simp only [corrected, zero, Bool.false_xor, parity]

private theorem factors_used : ∀ pair ∈ factors, UsedField pair.1 := by
  intro pair hp
  unfold UsedField
  simp only [factors, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

theorem factors_extent : extent factors = 72 := by decide +kernel

theorem scalar_run (r : Rows) (size : r.size = 76) (mirror : Bool) (slot : Fin 17)
    (x : Nat → Bool) (dim : Nat) (ph : Bool) (m : List Bool) :
    run (components 76 mirror 0 factors) m (CRTBarrel.frame r x dim slot.val ph) =
      CRTBarrel.frame (componentRows mirror slot.val 0 factors r) x dim slot.val ph := by
  rw [← size]
  exact frame_components r mirror 0 slot.val dim factors
    (lt_trans slot.isLt (by decide)) (by simp [size, factors_extent]) factors_used x ph m

def shiftPort (q : Wire) : Wire := [72,73,74,75,77,78,79,100][q]?.getD 0

def shiftProgram (mirror : Bool) : Program :=
  renameProgram shiftPort (LateQuotientShift.program true mirror)

abbrev QuotientFrame (mirror : Bool) (slot : Fin 17) (word : Fin 16) (s : State) : Prop :=
  LateQuotientShift.Frame true mirror shiftPort (LateQuotientShift.capShift (slot.val-1)) word s

private theorem shift_fit : ∀ a ∈ LateQuotientShift.ports true,
    ∀ b ∈ LateQuotientShift.ports true, shiftPort a = shiftPort b → a = b := by
  have finite : ∀ a b : Fin 8, shiftPort a.val = shiftPort b.val → a = b := by decide +kernel
  intro a ha b hb eq
  exact congrArg Fin.val (finite ⟨a, Finset.mem_range.mp ha⟩ ⟨b, Finset.mem_range.mp hb⟩ eq)

theorem shift_run (mirror : Bool) (slot : Fin 17) (word : Fin 16) (s : State) (m : List Bool)
    (input : QuotientFrame mirror slot word s) :
    let out := run (shiftProgram mirror) m s
    out.phase = s.phase ∧ QuotientFrame (!mirror) slot word out ∧
    ∀ q, q ∉ (LateQuotientShift.ports true).image shiftPort → out.basis q = s.basis q :=
  LateQuotientShift.placed_run true mirror shiftPort shift_fit _ _ s m input

theorem placement_inj (a b : Wire) (ha : a < 102) (hb : b < 102)
    (eq : CRTBarrel.place 345 a = CRTBarrel.place 345 b) : a = b := by
  let j : Fin 26 := ⟨20, by decide⟩
  have start : ECDSAAdd.Entrant.StairPacket.start j = 345 := rfl
  have bound : CRTBarrel.barrelWidth (ECDSAAdd.Entrant.StairPacket.start j) + 26 = 102 := by
    rw [start]
    decide
  have ha' : a < CRTBarrel.barrelWidth (ECDSAAdd.Entrant.StairPacket.start j) + 26 := by
    simpa only [bound] using ha
  have hb' : b < CRTBarrel.barrelWidth (ECDSAAdd.Entrant.StairPacket.start j) + 26 := by
    simpa only [bound] using hb
  exact CRTBarrel.Placement.place_inj j (by decide) (by decide) a ha' b hb' (by simpa only [start] using eq)

theorem shift_eq_of_frames (mirror : Bool) (slot : Fin 17) (word : Fin 16)
    (s t : State) (m : List Bool) (input : QuotientFrame mirror slot word s)
    (out : QuotientFrame (!mirror) slot word t) (phase : t.phase = s.phase)
    (agree : ∀ q, q ∉ (LateQuotientShift.ports true).image shiftPort → t.basis q = s.basis q) :
    run (shiftProgram mirror) m s = t := by
  obtain ⟨hp, result, outside⟩ := shift_run mirror slot word s m input
  apply State.extensionality
  · exact hp.trans phase.symm
  · funext q
    by_cases inside : q ∈ (LateQuotientShift.ports true).image shiftPort
    · obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp inside
      exact (result i hi).trans (out i hi).symm
    · exact (outside q inside).trans (agree q inside).symm

def order (mirror : Bool) : List (Fin 4) := if mirror then [3,2,1,0] else [0,1,2,3]
def corrections (mirror : Bool) : Program := (order mirror).flatMap correction

private theorem correction_reverse (i : Fin 4) : (correction i).reverse = correction i := by
  simp [correction, coherentStep, List.reverse_append, List.append_assoc]

theorem corrections_reverse : (corrections false).reverse = corrections true := by
  simp [corrections, order, List.flatMap_cons, List.reverse_append, correction_reverse, List.append_assoc]

private theorem corrected_flags (slot : Fin 17) (i : Fin 4) (s : State) (h : Flags slot s) :
    Flags slot (corrected slot i s) := by
  intro q hq
  have below : dest i < (76 : Nat) := by
    change 72 + i.val < 76
    exact Nat.add_lt_add_left i.isLt 72
  have ne : q ≠ dest i := Nat.ne_of_gt (lt_of_lt_of_le below hq)
  simpa [corrected, writeBit, Function.update_of_ne ne] using h q hq

private theorem correction_list (xs : List (Fin 4)) (slot : Fin 17) (s : State) (m : List Bool)
    (flags : Flags slot s) : run (xs.flatMap correction) m s =
      xs.foldl (fun u i => corrected slot i u) s := by
  induction xs generalizing s m with
  | nil => rfl
  | cons i tail ih =>
    rw [List.flatMap_cons, run_append, correction_run slot i s _ flags]
    exact ih _ _ (corrected_flags slot i s flags)

theorem corrections_run (mirror : Bool) (slot : Fin 17) (s : State) (m : List Bool)
    (flags : Flags slot s) : run (corrections mirror) m s =
      (order mirror).foldl (fun u i => corrected slot i u) s :=
  correction_list _ slot s m flags

/-- The middle omits only the outer basis changes. The inverse uses the existing inverse scalar emitter. -/
def middle (mirror : Bool) : Program :=
  if mirror then corrections true ++ (shiftProgram true ++ components 76 true 0 factors)
  else components 76 false 0 factors ++ (shiftProgram false ++ corrections false)

