theorem parity (k : Nat) (z : SkywalkNat.State) (g s : Bool) (odd : z.v % 2 = 1) :
    (SkywalkTrace.trace k (encode g s z.u z.v)).map (fun pair => !pair.1) =
      oddBits (letters k z) := by
