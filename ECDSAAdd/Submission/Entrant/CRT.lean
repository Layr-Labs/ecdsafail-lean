@[simp] private theorem scalar_size (slot : Fin 17) : (scalarFrame slot).size = 46 := by
  simp [scalarFrame]
@[simp] private theorem layer_size (slot : Fin 17) (done : Nat) : (layer slot done).size = 46 := by
  simp [layer]

private theorem coded_read (slot : Fin 17) (k q : Nat) (h : q < 46) :
    read (coded slot k) q = clip slot k q := by
  simp [coded, clip, Matrix.read, rows_size, h]

private theorem scalar_read (slot : Fin 17) (q : Nat) (h : q < 46) :
    read (scalarFrame slot) q = clip slot (if q < 44 then shift slot else 0) q := by
