theorem logicalAt_fits (j : Fin 26) (lo : 0 ≤ j.val) (hi : j.val ≤ 24) (mir : Bool) :
    Fits (· < barrelWidth (start j)+26) (logicalAt (start j) mir) := by
  by_cases hit : start j = 45
