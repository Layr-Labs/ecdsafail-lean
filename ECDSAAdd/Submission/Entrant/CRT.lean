  intro q hq
  rcases CRTBarrel.barrel_wires j h0 h1 mir q hq with ⟨i, hi, rfl⟩ | ⟨k, hk, rfl⟩ | ht
  · have bc := Shadow7.bank_cases w1 (by omega) hi
