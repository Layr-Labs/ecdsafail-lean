private theorem step_shape : ∀ v ∈ rowSteps, v.2 < 61 ∧ v.1.2.testBit v.2 = false := by
  decide +kernel

set_option maxRecDepth 8000 in
private theorem packed_receipt : rowSteps.foldl (quickStep 61) (identityWord width 61) = packedRowsWord := by
  decide +kernel

set_option maxRecDepth 8000 in
private theorem packed_digits : ∀ q : Fin 61,
    digit width packedRowsWord q.val = CRTBarrel.Matrix.read outerRows q.val := by
  decide +kernel

end PackedBasis

/-- Exact coordinates of the original swap and spill basis tape. -/
theorem basis_certificate : BasisCertificate := by
  have proved := PackedBasis.coordinates_steps 61 PackedBasis.rowSteps PackedBasis.step_shape outerRows
    (by rfl) (by decide) packedRowsWord PackedBasis.packed_receipt PackedBasis.packed_digits
  rw [PackedBasis.emit_rows] at proved
  exact proved

namespace ScalarPremise

open CRTBarrel.Packed

private theorem outer_size : outerRows.size = 61 := rfl

private theorem coded_size (slot : Fin 17) : (coded slot 0).size = 61 := by
  simp [coded,outer_size]

private theorem scalar_size (slot : Fin 17) : (scalarFrame slot).size = 61 := by
  simp [scalarFrame]

private theorem coded_read (slot : Fin 17) (q : Nat) (low : q < 61) :
    read (coded slot 0) q = clip slot 0 q := by
  simp [coded,clip,Matrix.read,outer_size,low]

private theorem scalar_read (slot : Fin 17) (q : Nat) (low : q < 61) :
    read (scalarFrame slot) q = clip slot (if q < 58 then shift slot else 0) q := by
  simp [scalarFrame,Matrix.read,low]

set_option maxRecDepth 5000 in
private theorem prefix_table : residueTable 61 outerRows 0 factors = true := by
  decide +kernel

private theorem extent : extent factors = 58 := by decide +kernel

private theorem scalar_direction (slot : Fin 17) (mirror : Bool) :
    let input := if mirror then scalarFrame slot else coded slot 0
    let output := if mirror then coded slot 0 else scalarFrame slot
    componentRows mirror slot.val 0 factors input = output := by
  intro input output
  have inputSize : input.size = 61 := by cases mirror <;> simp [input,coded_size,scalar_size]
  have outputSize : output.size = 61 := by cases mirror <;> simp [output,coded_size,scalar_size]
  apply componentRows_split 61 58 (dim slot) slot mirror outerRows input output outer_size
    inputSize outputSize (by decide) (Nat.le_refl _) (by decide) factors extent prefix_table
  · intro q hq
    cases mirror
    · simpa [input,entryShift] using coded_read slot q hq
    · exact scalar_read slot q hq
  · intro q hq
    cases mirror
    · exact scalar_read slot q hq
    · simpa [output,exitShift] using coded_read slot q hq

theorem scalar_action : ScalarAction := fun slot =>
  ⟨scalar_direction slot false,scalar_direction slot true⟩

end ScalarPremise

theorem basis_bounds : BasisBounds := by
  intro pair hp
  obtain ⟨⟨⟨j,mask⟩,i⟩,listed,step⟩ := List.mem_flatMap.mp (List.mem_reverse.mp hp)
  have ⟨hj,hi,clear⟩ := pivot_bounds _ listed
  change pair ∈ (if j = i then [] else [(i,j),(j,i),(i,j)]) ++
    (selected 61 mask).map (fun q => (i,q)) at step
  rcases List.mem_append.mp step with swap | spill
  · by_cases same : j = i
    · simp [same] at swap
    · simp only [if_neg same, List.mem_cons, List.not_mem_nil, or_false] at swap
      rcases swap with rfl | rfl | rfl
      · exact ⟨hi,hj,Ne.symm same⟩
      · exact ⟨hj,hi,same⟩
      · exact ⟨hi,hj,Ne.symm same⟩
  · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp spill
    change q ∈ (List.range 61).filter mask.testBit at hq
    obtain ⟨within,bit⟩ := List.mem_filter.mp hq
    refine ⟨hi,List.mem_range.mp within,?_⟩
    intro eq
    change i = q at eq
    subst q
    change mask.testBit i = false at clear
    simp [clear] at bit

private theorem append_scope {p q : Program}
    (hp : wires p ⊆ Finset.range 87) (hq : wires q ⊆ Finset.range 87) :
    wires (p ++ q) ⊆ Finset.range 87 := by
  rw [wires_append]
  exact Finset.union_subset hp hq

private theorem cnot_scope (pairs : List (Wire × Wire))
    (bounds : ∀ pair ∈ pairs, pair.1 < 61 ∧ pair.2 < 61 ∧ pair.1 ≠ pair.2) :
    wires (cnotProgram pairs) ⊆ Finset.range 87 := by
  have fits : Fits (· < 87) (cnotProgram pairs) := by
    intro gate hg
    obtain ⟨⟨a,b⟩,hpair,rfl⟩ := List.mem_map.mp hg
    obtain ⟨ha,hb,sep⟩ := bounds (a,b) hpair
    refine ⟨sep,?_⟩
    intro q hq
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact Nat.lt_trans ha (by decide : 61 < 87)
    · exact Nat.lt_trans hb (by decide : 61 < 87)
  exact fun q hq => Finset.mem_range.mpr (CRTBarrel.Placement.support fits q hq)

private theorem basis_scope : wires (cnotProgram outerOps) ⊆ Finset.range 87 :=
  cnot_scope outerOps basis_bounds

private theorem factors_used : ∀ pair ∈ factors, UsedField pair.1 := by
  intro pair hp
  unfold UsedField
  simp only [factors, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

private theorem scalar_scope (mirror : Bool) : wires (components 61 mirror 0 factors) ⊆ Finset.range 87 := by
  have fits := CRTBarrel.components_fits 61 mirror 0 factors (by decide +kernel) factors_used
  exact fun q hq => Finset.mem_range.mpr (CRTBarrel.Placement.support fits q hq)

private theorem shift_scope (mirror : Bool) : wires (shiftProgram mirror) ⊆ Finset.range 87 := by
  cases mirror <;> decide +kernel

set_option maxRecDepth 7000 in
private theorem correction_scope_forward : wires (corrections false) ⊆ Finset.range 87 := by
  decide +kernel

private theorem correction_scope (mirror : Bool) : wires (corrections mirror) ⊆ Finset.range 87 := by
  cases mirror
  · exact correction_scope_forward
  · simpa only [← corrections_reverse, wires_reverse] using correction_scope_forward

/-- Scope of both emitted gate orders, including the scalar correction wires. -/
theorem logical_scope (mirror : Bool) : Scope mirror := by
  have rev : wires (cnotProgram outerOps).reverse ⊆ Finset.range 87 := by
    rw [wires_reverse]
    exact basis_scope
  have body : wires (middle mirror) ⊆ Finset.range 87 := by
    cases mirror
    · exact append_scope (scalar_scope false) (append_scope (shift_scope false) (correction_scope false))
    · exact append_scope (correction_scope true) (append_scope (shift_scope true) (scalar_scope true))
  change wires ((cnotProgram outerOps ++ middle mirror) ++ (cnotProgram outerOps).reverse) ⊆ Finset.range 87
  exact append_scope (append_scope basis_scope body) rev

private def parityRow (i : Fin 3) : Nat := [2017612633061982209,1729382256910270467,1152921504606846983][i.val]?.getD 0

private def raised (slot : Fin 17) (i : Nat) : Nat :=
  if shift slot ≤ i then clip slot 0 (58 + (i - shift slot)) else 0

private def layer (slot : Fin 17) (done : Nat) : Rows :=
  Array.ofFn (fun q : Fin 61 =>
    if q.val < 58 ∨ q.val - 58 < done then clip slot (shift slot) q.val
    else raised slot (q.val - 58))

private theorem rows_size : outerRows.size = 61 := rfl
@[simp] private theorem coded_size (slot : Fin 17) (k : Nat) : (coded slot k).size = 61 := by
  simp [coded, rows_size]
@[simp] private theorem scalar_size (slot : Fin 17) : (scalarFrame slot).size = 61 := by
  simp [scalarFrame]
@[simp] private theorem layer_size (slot : Fin 17) (done : Nat) : (layer slot done).size = 61 := by
  simp [layer]

private theorem coded_read (slot : Fin 17) (k q : Nat) (h : q < 61) :
    read (coded slot k) q = clip slot k q := by
  simp [coded, clip, Matrix.read, rows_size, h]

private theorem scalar_read (slot : Fin 17) (q : Nat) (h : q < 61) :
    read (scalarFrame slot) q = clip slot (if q < 58 then shift slot else 0) q := by
  simp [scalarFrame, Matrix.read, h]

private theorem layer_read (slot : Fin 17) (done q : Nat) (h : q < 61) :
    read (layer slot done) q =
      if q < 58 ∨ q - 58 < done then clip slot (shift slot) q else raised slot (q - 58) := by
  simp [layer, Matrix.read, h]

private theorem layer_done (slot : Fin 17) : layer slot 3 = coded slot (shift slot) := by
  apply Array.ext (by simp)
  intro q hq hc
  have inBank : q < 61 := by simpa only [layer_size] using hq
  have done : q < 58 ∨ q - 58 < 3 := Or.inr (by omega)
  have eq := (layer_read slot 3 q inBank).trans (by simp only [if_pos done]; exact (coded_read slot _ q inBank).symm)
  simpa only [Matrix.read, Array.getElem?_eq_getElem hq, Array.getElem?_eq_getElem hc, Option.getD_some] using eq

set_option maxRecDepth 5000 in
private theorem parity_certificate : ∀ i : Fin 3,
    (taps i).foldr (fun q z => read outerRows q ^^^ z) 0 = parityRow i := by
  decide +kernel

set_option maxRecDepth 5000 in
private theorem quotient_certificate : ∀ (slot : Fin 17) (i : Fin 3),
    (3 - shift slot ≤ i.val → clip slot 0 (58 + i.val) = 0) ∧
    clip slot (shift slot) (58 + i.val) = raised slot i.val ^^^
      (if i.val < shift slot then clipShift (dim slot) (shift slot) (parityRow i) else 0) := by
  decide +kernel

private theorem flags (rs : Rows) (sz : rs.size = 61) (slot : Fin 17)
    (x : Nat → Bool) (ph : Bool) : Flags slot (CRTBarrel.frame rs x (dim slot) slot.val ph) := by
  intro q hq
  simp [CRTBarrel.frame, Matrix.basis, sz, Nat.not_lt_of_ge hq]

private theorem taps_low (i : Fin 3) (q : Wire) (mem : q ∈ taps i) : q < 58 := by
  change q ∈ (List.range 58).filter (fun q => (mask i).testBit q) at mem
  exact List.mem_range.mp (List.mem_filter.mp mem).1

private theorem layer_parity (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (done : Nat) (i : Fin 3) :
    CRTBarrel.xorAt (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis (taps i) =
      rowValue x (clipShift (dim slot) (shift slot) (parityRow i)) (dim slot) := by
  have eval (xs : List Wire) (low : ∀ q ∈ xs, q < 58) :
      CRTBarrel.xorAt (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis xs =
        rowValue x (clipShift (dim slot) (shift slot) (xs.foldr (fun q z => read outerRows q ^^^ z) 0)) (dim slot) := by
    induction xs with
    | nil => simp [CRTBarrel.xorAt, clip_zero, CRTBarrel.Field.rowValue_zero]
    | cons q qs ih =>
      have hlow : q < (58 : Nat) := low q (by simp)
      have hbank : q < (61 : Nat) := Nat.lt_trans hlow (by decide : 58 < 61)
      rw [CRTBarrel.xorAt, List.foldr_cons, clip_xor, rowValue_xor, ih (fun r hr => low r (List.mem_cons_of_mem _ hr))]
      simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos hbank, layer_read slot done q hbank,
        if_pos (Or.inl hlow)]
  exact (eval (taps i) (taps_low i)).trans
    (congrArg (fun z => rowValue x (clipShift (dim slot) (shift slot) z) (dim slot)) (parity_certificate i))

private theorem adjacent_layers (q i : Nat) (apart : q ≠ 58 + i) :
    (q < 58 ∨ q - 58 < i) ↔ (q < 58 ∨ q - 58 < i + 1) := by
  omega

private theorem layer_step (mirror : Bool) (slot : Fin 17) (i : Fin 3) (x : Nat → Bool) (ph : Bool) :
    corrected slot i (CRTBarrel.frame (layer slot (if mirror then i.val + 1 else i.val)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot (if mirror then i.val else i.val + 1)) x (dim slot) slot.val ph := by
  let current := if mirror then i.val + 1 else i.val
  let next := if mirror then i.val else i.val + 1
  have target : dest i = 58 + i.val := rfl
  apply State.extensionality
  · rfl
  · funext q
    by_cases hit : q = dest i
    · subst q
      have bank : dest i < 61 := Nat.add_lt_add_left i.isLt 58
      have low : ¬ dest i < 58 := Nat.not_lt_of_ge (Nat.le_add_right 58 i.val)
      have index : dest i - 58 = i.val := Nat.add_sub_cancel_left 58 i.val
      have bit (done : Nat) : (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis (dest i) =
          rowValue x (if i.val < done then clip slot (shift slot) (dest i) else raised slot i.val) (dim slot) := by
        simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos bank, layer_read slot done _ bank, low,
          false_or, index]
      have row := (quotient_certificate slot i).2
      change writeBit (CRTBarrel.frame (layer slot current) x (dim slot) slot.val ph).basis (dest i) _ (dest i) =
        (CRTBarrel.frame (layer slot next) x (dim slot) slot.val ph).basis (dest i)
      rw [writeBit, Function.update_self, layer_parity, bit current, bit next, target, row]
      by_cases active : i.val < shift slot
      · cases mirror <;>
          simp [current, next, active, rowValue_xor]
      · cases mirror <;>
          simp [current, next, active]
    · change writeBit (CRTBarrel.frame (layer slot current) x (dim slot) slot.val ph).basis (dest i) _ q =
        (CRTBarrel.frame (layer slot next) x (dim slot) slot.val ph).basis q
      rw [writeBit, Function.update_of_ne hit]
      by_cases bank : q < 61
      · have apart : q ≠ 58 + i.val := fun eq => hit (eq.trans target.symm)
        have adjacent := adjacent_layers q i.val apart
        have same : (q < 58 ∨ q - 58 < current) ↔ (q < 58 ∨ q - 58 < next) := by
          cases mirror
          · exact adjacent
          · exact adjacent.symm
        simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos bank, layer_read slot current q bank,
          layer_read slot next q bank, same]
      · simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_neg bank]

private theorem layer_step_forward (slot : Fin 17) (i : Fin 3) (x : Nat → Bool) (ph : Bool) :
    corrected slot i (CRTBarrel.frame (layer slot i.val) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot (i.val + 1)) x (dim slot) slot.val ph :=
  layer_step false slot i x ph

private theorem layer_step_inverse (slot : Fin 17) (i : Fin 3) (x : Nat → Bool) (ph : Bool) :
    corrected slot i (CRTBarrel.frame (layer slot (i.val + 1)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot i.val) x (dim slot) slot.val ph :=
  layer_step true slot i x ph

private theorem correction_forward (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (corrections false) t (CRTBarrel.frame (layer slot 0) x (dim slot) slot.val ph) =
      CRTBarrel.frame (coded slot (shift slot)) x (dim slot) slot.val ph := by
  rw [corrections_run _ _ _ _ (flags _ (layer_size ..) _ _ _)]
  change corrected slot ⟨2, by decide⟩ (corrected slot ⟨1, by decide⟩
    (corrected slot ⟨0, by decide⟩ _)) = _
  rw [layer_step_forward slot ⟨0, by decide⟩ x ph, layer_step_forward slot ⟨1, by decide⟩ x ph,
    layer_step_forward slot ⟨2, by decide⟩ x ph, layer_done]

private theorem correction_inverse (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (corrections true) t (CRTBarrel.frame (coded slot (shift slot)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot 0) x (dim slot) slot.val ph := by
  rw [← layer_done, corrections_run _ _ _ _ (flags _ (layer_size ..) _ _ _)]
  change corrected slot ⟨0, by decide⟩ (corrected slot ⟨1, by decide⟩
    (corrected slot ⟨2, by decide⟩ _)) = _
  rw [layer_step_inverse slot ⟨2, by decide⟩ x ph, layer_step_inverse slot ⟨1, by decide⟩ x ph,
    layer_step_inverse slot ⟨0, by decide⟩ x ph]

private def quotientWord (slot : Fin 17) (x : Nat → Bool) : Fin 16 :=
  ⟨fieldWord (3 - shift slot) (fun i => rowValue x (clip slot 0 (58 + i)) (dim slot)),
    lt_of_lt_of_le (fieldWord_small ..) (by
      simpa using Nat.pow_le_pow_right (by decide : 0 < 2) (show 3 - shift slot ≤ 4 by omega))⟩

private theorem word_small (slot : Fin 17) (x : Nat → Bool) :
    (quotientWord slot x).val < 2 ^ (3 - shift slot) :=
  fieldWord_small ..

private theorem word_bit (slot : Fin 17) (x : Nat → Bool) (i : Nat) (hi : i < 3) :
    (quotientWord slot x).val.testBit i = rowValue x (clip slot 0 (58 + i)) (dim slot) := by
  by_cases low : i < 3 - shift slot
  · exact fieldWord_bit _ _ _ low
  · have high : 3 - shift slot ≤ i := Nat.le_of_not_lt low
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (word_small slot x)
      (Nat.pow_le_pow_right (by decide : 0 < 2) high)), (quotient_certificate slot ⟨i,hi⟩).1 high]
    exact (CRTBarrel.Field.rowValue_zero ..).symm

private theorem word_raised (slot : Fin 17) (x : Nat → Bool) (i : Nat) (hi : i < 3) :
    ((quotientWord slot x).val <<< (LateQuotientShift.capShift (shift slot)).val).testBit i =
      rowValue x (raised slot i) (dim slot) := by
  have uncapped : ((quotientWord slot x).val <<< (LateQuotientShift.capShift (shift slot)).val) =
      (quotientWord slot x).val <<< shift slot := by
    by_cases within : shift slot ≤ 4
    · simp [LateQuotientShift.capShift, Nat.min_eq_left within]
    · have z : 3 - shift slot = 0 := by omega
      have small := word_small slot x
      rw [z, Nat.pow_zero] at small
      rw [show (quotientWord slot x).val = 0 by omega]
      simp
  rw [uncapped, Nat.testBit_shiftLeft]
  by_cases moved : shift slot ≤ i
  · simp only [raised, moved, decide_true, Bool.true_and]
    exact word_bit slot x _ (by omega)
  · simp [raised, moved, CRTBarrel.Field.rowValue_zero]

private theorem shiftPort_low : ∀ i : Fin 3, shiftPort i.val = 58 + i.val := by decide

private theorem selector_projection : ∀ (slot : Fin 17) (q : Fin 6), 3 ≤ q.val →
    61 ≤ shiftPort q.val ∧
    CRTBarrel.flags 61 slot.val (shiftPort q.val) =
      LateQuotientShift.admittedBit false false (LateQuotientShift.capShift (shift slot)) 0 q.val := by
  decide +kernel

private theorem quotient_admission (shifted : Bool) (slot : Fin 17) (rs : Rows) (sz : rs.size = 61)
    (x : Nat → Bool) (ph : Bool)
    (qRows : ∀ i : Fin 3, read rs (58 + i.val) =
      if shifted then raised slot i.val else clip slot 0 (58 + i.val)) :
    QuotientFrame shifted slot (quotientWord slot x) (CRTBarrel.frame rs x (dim slot) slot.val ph) := by
  have small : (quotientWord slot x).val <
      2 ^ (LateQuotientShift.quotientWidth false - (LateQuotientShift.capShift (shift slot)).val) := by
    rw [LateQuotientShift.capShift_width]
    exact word_small ..
  apply (LateQuotientShift.frame_iff false shifted shiftPort _ _ _ small).mpr
  intro q hq
  have bound : q < 6 := Finset.mem_range.mp hq
  by_cases low : q < 3
  · have bank : 58 + q < 61 := Nat.add_lt_add_left low 58
    rw [shiftPort_low ⟨q,low⟩]
    simp only [CRTBarrel.frame, Matrix.basis, sz, if_pos bank, qRows ⟨q,low⟩,
      LateQuotientShift.admittedBit, LateQuotientShift.quotientWidth, Bool.false_eq_true, if_false,
      if_pos low]
    cases shifted
    · exact (word_bit slot x q low).symm
    · exact (word_raised slot x q low).symm
  · have projection := selector_projection slot ⟨q,bound⟩ (Nat.le_of_not_lt low)
    have independent : LateQuotientShift.admittedBit false shifted
        (LateQuotientShift.capShift (shift slot)) (quotientWord slot x) q =
        LateQuotientShift.admittedBit false false (LateQuotientShift.capShift (shift slot)) 0 q := by
      simp only [LateQuotientShift.admittedBit, LateQuotientShift.quotientWidth,
        Bool.false_eq_true, if_false, if_neg low]
    exact (flags rs sz slot x ph (shiftPort q) projection.1).trans
      (projection.2.trans independent.symm)

private theorem shift_pair (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    let left := CRTBarrel.frame (scalarFrame slot) x (dim slot) slot.val ph
    let right := CRTBarrel.frame (layer slot 0) x (dim slot) slot.val ph
    run (shiftProgram false) t left = right ∧ run (shiftProgram true) t right = left := by
  intro left right
  have l : QuotientFrame false slot (quotientWord slot x) left := by
    apply quotient_admission false slot _ (scalar_size slot)
    intro i
    change read (scalarFrame slot) (58 + i.val) = clip slot 0 (58 + i.val)
    rw [scalar_read slot _ (Nat.add_lt_add_left i.isLt 58),
      if_neg (Nat.not_lt_of_ge (Nat.le_add_right 58 i.val))]
  have r : QuotientFrame true slot (quotientWord slot x) right := by
    apply quotient_admission true slot _ (layer_size slot 0)
    intro i
    change read (layer slot 0) (58 + i.val) = raised slot i.val
    have non : ¬ (58 + i.val < 58 ∨ 58 + i.val - 58 < 0) := by omega
    rw [layer_read slot 0 _ (Nat.add_lt_add_left i.isLt 58), if_neg non, Nat.add_sub_cancel_left]
  have agree : ∀ q, q ∉ (LateQuotientShift.ports false).image shiftPort → right.basis q = left.basis q := by
    intro q free
    by_cases known : q < 61
    · have below : q < 58 := by
        by_contra! above
        have eq : 58 + (q - 58) = q := Nat.add_sub_of_le above
        have within : 58 + (q - 58) < 58 + 3 := eq.symm ▸ known
        have high : q - 58 < 3 := Nat.lt_of_add_lt_add_left within
        have port : q - 58 ∈ LateQuotientShift.ports false :=
          Finset.mem_range.mpr (Nat.lt_trans high (by decide : 3 < 6))
        exact free (Finset.mem_image.mpr ⟨q - 58, port, (shiftPort_low ⟨q - 58,high⟩).trans eq⟩)
      simp only [right, left, CRTBarrel.frame, Matrix.basis, layer_size, scalar_size, if_pos known,
        layer_read slot 0 q known, scalar_read slot q known, if_pos below, if_pos (Or.inl below)]
    · have ge := Nat.le_of_not_lt known
      exact (flags _ (layer_size ..) _ _ _ q ge).trans ((flags _ (scalar_size ..) _ _ _ q ge).symm)
  have samePhase : right.phase = left.phase := by
    simp only [right, left, CRTBarrel.frame]
  have forwardOut : QuotientFrame (!false) slot (quotientWord slot x) right := by
    change QuotientFrame true slot (quotientWord slot x) right
    exact r
  have inverseOut : QuotientFrame (!true) slot (quotientWord slot x) left := by
    change QuotientFrame false slot (quotientWord slot x) left
    exact l
  have forward : run (shiftProgram false) t left = right :=
    shift_eq_of_frames false slot (quotientWord slot x) left right t l forwardOut samePhase agree
  have inverse : run (shiftProgram true) t right = left :=
    shift_eq_of_frames true slot (quotientWord slot x) right left t r inverseOut samePhase.symm
      (fun q free => (agree q free).symm)
  exact ⟨forward,inverse⟩

private theorem middle_run (scalar : ScalarAction) (slot : Fin 17) (mirror : Bool)
    (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (middle mirror) t (CRTBarrel.frame (coded slot (entryShift mirror slot.val)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (coded slot (exitShift mirror slot.val)) x (dim slot) slot.val ph := by
  cases mirror
  · simp only [middle, Bool.false_eq_true, if_false, entryShift, exitShift, run_append]
    rw [scalar_run _ (coded_size ..), (scalar slot).1, (shift_pair slot x ph _).1,
      correction_forward]
  · simp only [middle, if_true, entryShift, exitShift, run_append]
    rw [correction_inverse, (shift_pair slot x ph _).2, scalar_run _ (scalar_size _),
      (scalar slot).2]

private theorem encode_run (coordinates : BasisCertificate) (bounds : BasisBounds) (slot : Fin 17)
    (k : Nat) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (cnotProgram outerOps) t (CRTBarrel.frame (CRTBarrel.plain 61 (dim slot) k) x (dim slot) slot.val ph) =
      CRTBarrel.frame (coded slot k) x (dim slot) slot.val ph := by
  have mapped : applyOps outerOps (CRTBarrel.plain 61 (dim slot) k) = coded slot k := by
    rw [CRTBarrel.plain, apply_map outerOps (clipShift (dim slot) k) (clip_zero (dim slot) k)
      (clip_xor (dim slot) k) (units 61), coordinates, coded]
  have step := run_ops outerOps (CRTBarrel.plain 61 (dim slot) k) x (dim slot) (CRTBarrel.flags 61 slot.val) ph t
    (fun pair hp => by simpa only [plain_size] using ⟨(bounds pair hp).1,(bounds pair hp).2.1⟩)
  rw [mapped] at step
  simpa only [CRTBarrel.frame, plain_size, coded_size] using step

private theorem decode_run (coordinates : BasisCertificate) (bounds : BasisBounds) (slot : Fin 17)
    (k : Nat) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (cnotProgram outerOps).reverse t (CRTBarrel.frame (coded slot k) x (dim slot) slot.val ph) =
      CRTBarrel.frame (CRTBarrel.plain 61 (dim slot) k) x (dim slot) slot.val ph := by
  have step := reverse_cnots outerOps (fun pair hp => (bounds pair hp).2.2)
    (CRTBarrel.frame (CRTBarrel.plain 61 (dim slot) k) x (dim slot) slot.val ph) [] t
  rw [show cnotProgram outerOps.reverse = (cnotProgram outerOps).reverse from List.map_reverse,
    encode_run coordinates bounds] at step
  exact step

/-- All measurement outcomes are allowed. The outer basis is the exact original 1,776-gate model. -/
theorem logical_run (coordinates : BasisCertificate) (bounds : BasisBounds) (scalar : ScalarAction)
    (slot : Fin 17) (mirror : Bool) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (logical mirror) t
      (CRTBarrel.frame (CRTBarrel.plain 61 (dim slot) (entryShift mirror slot.val)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (CRTBarrel.plain 61 (dim slot) (exitShift mirror slot.val)) x (dim slot) slot.val ph := by
  rw [logical, run_append, run_append, encode_run coordinates bounds, middle_run scalar,
    decode_run coordinates bounds]

theorem emitted_eq (mir : Bool) : CRTBarrel.LateNine375.logical mir = logical mir := by
  have basis : CRTBarrel.lateNineBasis 61 CRTBarrel.LateNine375.pivotPlan = cnotProgram outerOps := rfl
  have shift_f : CRTBarrel.LateNine375.shift = shiftProgram false := by decide +kernel
  have shift_r : CRTBarrel.LateNine375.shift.reverse = shiftProgram true := by decide +kernel
  have corr_f : CRTBarrel.LateNine375.correction = corrections false := by decide +kernel
  have corr_r : CRTBarrel.LateNine375.correction.reverse = corrections true := by decide +kernel
  have factor_eq : CRTBarrel.LateNine375.factors = factors := rfl
  have scalar_eq (mirror : Bool) :
      components 61 mirror 0 CRTBarrel.LateNine375.factors = components 61 mirror 0 factors :=
    congrArg (components 61 mirror 0) factor_eq
  have back := congrArg List.reverse basis
  cases mir
  · unfold CRTBarrel.LateNine375.logical logical middle
    have centre := congrArg₂ List.append (scalar_eq false) (congrArg₂ List.append shift_f corr_f)
    exact congrArg₂ List.append (congrArg₂ List.append basis centre) back
  · unfold CRTBarrel.LateNine375.logical logical middle
    have centre := congrArg₂ List.append corr_r (congrArg₂ List.append shift_r (scalar_eq true))
    exact congrArg₂ List.append (congrArg₂ List.append basis centre) back

end ECDSAAdd.Entrant.StairPacket.LateResidue375.Caller

namespace ECDSAAdd.Entrant.StairPacket.LateResidue390

open ECDSAAdd CRTBarrel CRTBarrel.Matrix CRTBarrel.Placement

def prep (tags taps : List Wire) (a b : Wire) : Program :=
  CRTBarrel.toggles tags a ++ CRTBarrel.toggles taps b

def coherentStep (tags taps : List Wire) (a b target : Wire) : Program :=
  prep tags taps a b ++ ([Instr.CCX a b target] ++ (prep tags taps a b).reverse)

private theorem xorAt_agree (u v : BasisState) (xs : List Wire)
    (h : ∀ q ∈ xs, u q = v q) : CRTBarrel.xorAt u xs = CRTBarrel.xorAt v xs := by
  induction xs with
  | nil => rfl
  | cons q qs ih =>
    rw [CRTBarrel.xorAt, CRTBarrel.xorAt, h q (by simp), ih (fun j hj => h j (List.mem_cons_of_mem _ hj))]

private theorem toggles_proper (xs : List Wire) (q : Wire) (fresh : q ∉ xs) :
    ProperProgram (CRTBarrel.toggles xs q) := by
  intro i hi
  change i ∈ xs.map (fun p => Instr.CX p q) at hi
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hi
  exact fun eq => fresh (eq ▸ hp)

private def prepared (tags taps : List Wire) (a b : Wire) (bits : BasisState) : BasisState :=
  writeBit (writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags)) b (bits b ^^ CRTBarrel.xorAt bits taps)

private theorem prep_run (tags taps : List Wire) (a b : Wire)
    (ab : a ≠ b) (atags : a ∉ tags) (btaps : b ∉ taps) (ataps : a ∉ taps)
    (s : State) (m : List Bool) :
    run (prep tags taps a b) m s = ⟨s.phase, prepared tags taps a b s.basis⟩ := by
  cases s with
  | mk ph bits =>
    rw [prep, run_append, CRTBarrel.run_toggles _ _ atags, CRTBarrel.run_toggles _ _ btaps]
    have keep : CRTBarrel.xorAt (writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags)) taps = CRTBarrel.xorAt bits taps :=
      xorAt_agree _ _ _ (fun q hq => by
        have ne : q ≠ a := fun e => ataps (e ▸ hq)
        simp [writeBit, Function.update_of_ne ne])
    have pivotKeep : writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags) b = bits b := by
      simp [writeBit, Function.update_of_ne ab.symm]
    simp only [prepared, pivotKeep, keep]

/-- Compute the two parities, use a single Toffoli, and undo the preparation. -/
theorem coherent_run (tags taps : List Wire) (a b target : Wire)
    (ab : a ≠ b) (ta : target ≠ a) (tb : target ≠ b)
    (atags : a ∉ tags) (btaps : b ∉ taps) (ataps : a ∉ taps)
    (ttags : target ∉ tags) (ttaps : target ∉ taps) (s : State) (m : List Bool) :
    run (coherentStep tags taps a b target) m s =
      ⟨s.phase, writeBit s.basis target
        (s.basis target ^^ ((s.basis a ^^ CRTBarrel.xorAt s.basis tags) &&
          (s.basis b ^^ CRTBarrel.xorAt s.basis taps)))⟩ := by
  let selector := s.basis a ^^ CRTBarrel.xorAt s.basis tags
  let parity := s.basis b ^^ CRTBarrel.xorAt s.basis taps
  let value := s.basis target ^^ (selector && parity)
  let next : State := ⟨s.phase, writeBit s.basis target value⟩
  let ready : State := ⟨s.phase, prepared tags taps a b s.basis⟩
  let toggled : State := ⟨s.phase, writeBit ready.basis target value⟩
  have first (tape : List Bool) : run (prep tags taps a b) tape s = ready :=
    prep_run tags taps a b ab atags btaps ataps s tape
  have middle (tape : List Bool) : run [Instr.CCX a b target] tape ready = toggled := by
    have ha : ready.basis a = selector := by
      simp only [ready, prepared, writeBit, Function.update_of_ne ab, Function.update_self, selector]
    have hb : ready.basis b = parity := by
      simp only [ready, prepared, writeBit, Function.update_self, parity]
    have ht : ready.basis target = s.basis target := by
      simp only [ready, prepared, writeBit, Function.update_of_ne ta, Function.update_of_ne tb]
    change (⟨ready.phase, writeBit ready.basis target
      (ready.basis target ^^ (ready.basis a && ready.basis b))⟩ : State) = toggled
    rw [ha, hb, ht]
  have move : run (prep tags taps a b) [] next = toggled := by
    rw [prep_run tags taps a b ab atags btaps ataps]
    have same (xs : List Wire) (h : target ∉ xs) :
        CRTBarrel.xorAt next.basis xs = CRTBarrel.xorAt s.basis xs := by
      apply xorAt_agree
      intro q hq
      have ne : q ≠ target := fun e => h (e ▸ hq)
      simp [next, writeBit, Function.update_of_ne ne]
    rw [show next.phase = s.phase from rfl]
    apply congrArg (State.mk s.phase)
    unfold prepared
    rw [same tags ttags, same taps ttaps,
      show next.basis a = s.basis a by simp [next, writeBit, Function.update_of_ne ta.symm],
      show next.basis b = s.basis b by simp [next, writeBit, Function.update_of_ne tb.symm]]
    change Function.update (Function.update (Function.update s.basis target value) a selector) b parity =
      Function.update (Function.update (Function.update s.basis a selector) b parity) target value
    have firstSwap : Function.update (Function.update s.basis target value) a selector =
        Function.update (Function.update s.basis a selector) target value :=
      Function.update_comm ta value selector s.basis
    have secondSwap :
        Function.update (Function.update (Function.update s.basis a selector) target value) b parity =
          Function.update (Function.update (Function.update s.basis a selector) b parity) target value :=
      Function.update_comm tb value parity (Function.update s.basis a selector)
    exact (congrArg (fun bits : BasisState => Function.update bits b parity) firstSwap).trans secondSwap
  have proper : ProperProgram (prep tags taps a b) :=
    (properProgram_append _ _).mpr ⟨toggles_proper _ _ atags, toggles_proper _ _ btaps⟩
  have undo (tape : List Bool) : run (prep tags taps a b).reverse tape toggled = next := by
    rw [← move]
    exact run_reverse_proper _ proper next [] tape
  change run (coherentStep tags taps a b target) m s = next
  rw [coherentStep, run_append, run_append, first, middle, undo]

/-! The data below is the selected option for window 390 in `shared.json`. -/

def factors : List (Nat × Nat) :=
  [(11,1), (13,1), (19,1), (21,1), (25,1), (31,1), (73,1), (257,1), (313,1), (471,1)]

def mask (i : Fin 2) : Nat :=
  if i.val = 0 then 3929981129770403
  else 3373954545601295

def taps (i : Fin 2) : List Wire := selected 52 (mask i)
def tags (i : Fin 2) : List Wire := List.range' (55 + i.val) (15 - i.val)
def pivot (i : Fin 2) : Wire := (taps i).headD 0
def dest (i : Fin 2) : Wire := 52 + i.val

def correction (i : Fin 2) : Program := coherentStep (tags i) (taps i).tail 78 (pivot i) (dest i)

set_option maxRecDepth 4000 in
private theorem separate : ∀ i : Fin 2,
    (78 : Wire) ≠ pivot i ∧ dest i ≠ 78 ∧ dest i ≠ pivot i ∧
    78 ∉ tags i ∧ pivot i ∉ (taps i).tail ∧ 78 ∉ (taps i).tail ∧
    dest i ∉ tags i ∧ dest i ∉ (taps i).tail := by decide +kernel

set_option maxRecDepth 4000 in
private theorem correction_tags : ∀ (slot : Fin 17) (i : Fin 2),
    CRTBarrel.xorAt (CRTBarrel.flags 54 slot.val) (tags i) = decide (i.val < slot.val - 1) := by decide +kernel

def Flags (slot : Fin 17) (s : State) : Prop :=
  ∀ q, 54 ≤ q → s.basis q = CRTBarrel.flags 54 slot.val q

def corrected (slot : Fin 17) (i : Fin 2) (s : State) : State :=
  ⟨s.phase, writeBit s.basis (dest i)
    (s.basis (dest i) ^^ (decide (i.val < slot.val - 1) && CRTBarrel.xorAt s.basis (taps i)))⟩

theorem correction_run (slot : Fin 17) (i : Fin 2) (s : State) (m : List Bool)
    (h : Flags slot s) : run (correction i) m s = corrected slot i s := by
  obtain ⟨ab, ta, tb, atags, btaps, ataps, ttags, ttaps⟩ := separate i
  have hot : CRTBarrel.xorAt s.basis (tags i) = decide (i.val < slot.val - 1) := by
    rw [← correction_tags slot i]
    apply xorAt_agree
    intro q hq
    change q ∈ List.range' (55 + i.val) (15 - i.val) at hq
    have lower : 55 + i.val ≤ q := (List.mem_range'_1.mp hq).1
    exact h q (le_trans (le_trans (by decide : 54 ≤ 55) (Nat.le_add_right 55 i.val)) lower)
  have size : ∀ j : Fin 2, taps j = pivot j :: (taps j).tail := by decide +kernel
  rw [correction, coherent_run _ _ _ _ _ ab ta tb atags btaps ataps ttags ttaps,
    h 78 (by decide), hot]
  have zero : CRTBarrel.flags 54 slot.val 78 = false := by simp [CRTBarrel.flags]
  have parity : CRTBarrel.xorAt s.basis (taps i) = (s.basis (pivot i) ^^ CRTBarrel.xorAt s.basis (taps i).tail) := by
    exact congrArg (CRTBarrel.xorAt s.basis) (size i)
  simp only [corrected, zero, Bool.false_xor, parity]

private theorem factors_used : ∀ pair ∈ factors, UsedField pair.1 := by
  intro pair hp
  unfold UsedField
  simp only [factors, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

theorem factors_extent : extent factors = 52 := by decide +kernel

theorem scalar_run (r : Rows) (size : r.size = 54) (mirror : Bool) (slot : Fin 17)
    (x : Nat → Bool) (dim : Nat) (ph : Bool) (m : List Bool) :
    run (components 54 mirror 0 factors) m (CRTBarrel.frame r x dim slot.val ph) =
      CRTBarrel.frame (componentRows mirror slot.val 0 factors r) x dim slot.val ph := by
  rw [← size]
  exact frame_components r mirror 0 slot.val dim factors
    (lt_trans slot.isLt (by decide)) (by simp [size, factors_extent]) factors_used x ph m

def shiftPort (q : Wire) : Wire := [52,53,55,78][q]?.getD 0

def shiftProgram (mirror : Bool) : Program :=
  renameProgram shiftPort (LateQuotientShiftTwo.program false mirror)

abbrev QuotientFrame (mirror : Bool) (slot : Fin 17) (word : Fin 16) (s : State) : Prop :=
  LateQuotientShiftTwo.Frame false mirror shiftPort (LateQuotientShiftTwo.capShift (slot.val-1)) word s

private theorem shift_fit : ∀ a ∈ LateQuotientShiftTwo.ports false,
    ∀ b ∈ LateQuotientShiftTwo.ports false, shiftPort a = shiftPort b → a = b := by
  have finite : ∀ a b : Fin 4, shiftPort a.val = shiftPort b.val → a = b := by decide +kernel
  intro a ha b hb eq
  exact congrArg Fin.val (finite ⟨a, Finset.mem_range.mp ha⟩ ⟨b, Finset.mem_range.mp hb⟩ eq)

theorem shift_run (mirror : Bool) (slot : Fin 17) (word : Fin 16) (s : State) (m : List Bool)
    (input : QuotientFrame mirror slot word s) :
    let out := run (shiftProgram mirror) m s
    out.phase = s.phase ∧ QuotientFrame (!mirror) slot word out ∧
    ∀ q, q ∉ (LateQuotientShiftTwo.ports false).image shiftPort → out.basis q = s.basis q :=
  LateQuotientShiftTwo.placed_run false mirror shiftPort shift_fit _ _ s m input

theorem placement_inj (a b : Wire) (ha : a < 80) (hb : b < 80)
    (eq : CRTBarrel.place 390 a = CRTBarrel.place 390 b) : a = b := by
  let j : Fin 26 := ⟨23, by decide⟩
  have start : ECDSAAdd.Entrant.StairPacket.start j = 390 := rfl
  have bound : CRTBarrel.barrelWidth (ECDSAAdd.Entrant.StairPacket.start j) + 26 = 80 := by
    rw [start]
    decide
  have ha' : a < CRTBarrel.barrelWidth (ECDSAAdd.Entrant.StairPacket.start j) + 26 := by
    simpa only [bound] using ha
  have hb' : b < CRTBarrel.barrelWidth (ECDSAAdd.Entrant.StairPacket.start j) + 26 := by
    simpa only [bound] using hb
  exact CRTBarrel.Placement.place_inj j (by decide) (by decide) a ha' b hb' (by simpa only [start] using eq)

theorem shift_eq_of_frames (mirror : Bool) (slot : Fin 17) (word : Fin 16)
    (s t : State) (m : List Bool) (input : QuotientFrame mirror slot word s)
    (out : QuotientFrame (!mirror) slot word t) (phase : t.phase = s.phase)
    (agree : ∀ q, q ∉ (LateQuotientShiftTwo.ports false).image shiftPort → t.basis q = s.basis q) :
    run (shiftProgram mirror) m s = t := by
  obtain ⟨hp, result, outside⟩ := shift_run mirror slot word s m input
  apply State.extensionality
  · exact hp.trans phase.symm
  · funext q
    by_cases inside : q ∈ (LateQuotientShiftTwo.ports false).image shiftPort
    · obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp inside
      exact (result i hi).trans (out i hi).symm
    · exact (outside q inside).trans (agree q inside).symm

def order (mirror : Bool) : List (Fin 2) := if mirror then [1,0] else [0,1]
def corrections (mirror : Bool) : Program := (order mirror).flatMap correction

private theorem correction_reverse (i : Fin 2) : (correction i).reverse = correction i := by
  simp [correction, coherentStep, List.reverse_append, List.append_assoc]

theorem corrections_reverse : (corrections false).reverse = corrections true := by
  simp [corrections, order, List.flatMap_cons, List.reverse_append, correction_reverse]

private theorem corrected_flags (slot : Fin 17) (i : Fin 2) (s : State) (h : Flags slot s) :
    Flags slot (corrected slot i s) := by
  intro q hq
  have below : dest i < (54 : Nat) := by
    change 52 + i.val < 54
    exact Nat.add_lt_add_left i.isLt 52
  have ne : q ≠ dest i := Nat.ne_of_gt (lt_of_lt_of_le below hq)
  simpa [corrected, writeBit, Function.update_of_ne ne] using h q hq

private theorem correction_list (xs : List (Fin 2)) (slot : Fin 17) (s : State) (m : List Bool)
    (flags : Flags slot s) : run (xs.flatMap correction) m s =
      xs.foldl (fun u i => corrected slot i u) s := by
  induction xs generalizing s m with
  | nil => rfl
  | cons i tail ih =>
    rw [List.flatMap_cons, run_append, correction_run slot i s _ flags]
    exact ih _ _ (corrected_flags slot i s flags)

theorem corrections_run (mirror : Bool) (slot : Fin 17) (s : State) (m : List Bool)
    (flags : Flags slot s) : run (corrections mirror) m s =
      (order mirror).foldl (fun u i => corrected slot i u) s :=
  correction_list _ slot s m flags

/-- The middle omits only the outer basis changes. The inverse uses the existing inverse scalar emitter. -/
def middle (mirror : Bool) : Program :=
  if mirror then corrections true ++ (shiftProgram true ++ components 54 true 0 factors)
  else components 54 false 0 factors ++ (shiftProgram false ++ corrections false)

end ECDSAAdd.Entrant.StairPacket.LateResidue390

