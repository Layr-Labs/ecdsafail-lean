private theorem correction_scope_forward : wires (corrections false) ⊆ Finset.range 95 := by
  decide +kernel

private theorem correction_scope (mirror : Bool) : wires (corrections mirror) ⊆ Finset.range 95 := by
  cases mirror
  · exact correction_scope_forward
  · simpa only [← corrections_reverse, wires_reverse] using correction_scope_forward

/-- Scope of both emitted gate orders, including the scalar correction wires. -/
theorem logical_scope (mirror : Bool) : Scope mirror := by
  have rev : wires (cnotProgram outerOps).reverse ⊆ Finset.range 95 := by
    rw [wires_reverse]
    exact basis_scope
  have body : wires (middle mirror) ⊆ Finset.range 95 := by
    cases mirror
    · exact append_scope (scalar_scope false) (append_scope (shift_scope false) (correction_scope false))
    · exact append_scope (correction_scope true) (append_scope (shift_scope true) (scalar_scope true))
  change wires ((cnotProgram outerOps ++ middle mirror) ++ (cnotProgram outerOps).reverse) ⊆ Finset.range 95
  exact append_scope (append_scope basis_scope body) rev

private def parityRow (i : Fin 3) : Nat := [516508834063867445249,442721857769029238787,295147905179352825863][i.val]?.getD 0

private def raised (slot : Fin 17) (i : Nat) : Nat :=
  if shift slot ≤ i then clip slot 0 (66 + (i - shift slot)) else 0

private def layer (slot : Fin 17) (done : Nat) : Rows :=
  Array.ofFn (fun q : Fin 69 =>
    if q.val < 66 ∨ q.val - 66 < done then clip slot (shift slot) q.val
    else raised slot (q.val - 66))

private theorem rows_size : outerRows.size = 69 := rfl
@[simp] private theorem coded_size (slot : Fin 17) (k : Nat) : (coded slot k).size = 69 := by
  simp [coded, rows_size]
@[simp] private theorem scalar_size (slot : Fin 17) : (scalarFrame slot).size = 69 := by
  simp [scalarFrame]
@[simp] private theorem layer_size (slot : Fin 17) (done : Nat) : (layer slot done).size = 69 := by
  simp [layer]

private theorem coded_read (slot : Fin 17) (k q : Nat) (h : q < 69) :
    read (coded slot k) q = clip slot k q := by
  simp [coded, clip, Matrix.read, rows_size, h]

private theorem scalar_read (slot : Fin 17) (q : Nat) (h : q < 69) :
    read (scalarFrame slot) q = clip slot (if q < 66 then shift slot else 0) q := by
  simp [scalarFrame, Matrix.read, h]

private theorem layer_read (slot : Fin 17) (done q : Nat) (h : q < 69) :
    read (layer slot done) q =
      if q < 66 ∨ q - 66 < done then clip slot (shift slot) q else raised slot (q - 66) := by
  simp [layer, Matrix.read, h]

private theorem layer_done (slot : Fin 17) : layer slot 3 = coded slot (shift slot) := by
  apply Array.ext (by simp)
  intro q hq hc
  have inBank : q < 69 := by simpa only [layer_size] using hq
  have done : q < 66 ∨ q - 66 < 3 := Or.inr (by omega)
  have eq := (layer_read slot 3 q inBank).trans (by simp only [if_pos done]; exact (coded_read slot _ q inBank).symm)
  simpa only [Matrix.read, Array.getElem?_eq_getElem hq, Array.getElem?_eq_getElem hc, Option.getD_some] using eq

set_option maxRecDepth 5000 in
private theorem parity_certificate : ∀ i : Fin 3,
    (taps i).foldr (fun q z => read outerRows q ^^^ z) 0 = parityRow i := by
  decide +kernel

set_option maxRecDepth 5000 in
private theorem quotient_certificate : ∀ (slot : Fin 17) (i : Fin 3),
    (3 - shift slot ≤ i.val → clip slot 0 (66 + i.val) = 0) ∧
    clip slot (shift slot) (66 + i.val) = raised slot i.val ^^^
      (if i.val < shift slot then clipShift (dim slot) (shift slot) (parityRow i) else 0) := by
  decide +kernel

private theorem flags (rs : Rows) (sz : rs.size = 69) (slot : Fin 17)
    (x : Nat → Bool) (ph : Bool) : Flags slot (CRTBarrel.frame rs x (dim slot) slot.val ph) := by
  intro q hq
  simp [CRTBarrel.frame, Matrix.basis, sz, Nat.not_lt_of_ge hq]

private theorem taps_low (i : Fin 3) (q : Wire) (mem : q ∈ taps i) : q < 66 := by
  change q ∈ (List.range 66).filter (fun q => (mask i).testBit q) at mem
  exact List.mem_range.mp (List.mem_filter.mp mem).1

private theorem layer_parity (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (done : Nat) (i : Fin 3) :
    CRTBarrel.xorAt (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis (taps i) =
      rowValue x (clipShift (dim slot) (shift slot) (parityRow i)) (dim slot) := by
  have eval (xs : List Wire) (low : ∀ q ∈ xs, q < 66) :
      CRTBarrel.xorAt (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis xs =
        rowValue x (clipShift (dim slot) (shift slot) (xs.foldr (fun q z => read outerRows q ^^^ z) 0)) (dim slot) := by
    induction xs with
    | nil => simp [CRTBarrel.xorAt, clip_zero, CRTBarrel.Field.rowValue_zero]
    | cons q qs ih =>
      have hlow : q < (66 : Nat) := low q (by simp)
      have hbank : q < (69 : Nat) := Nat.lt_trans hlow (by decide : 66 < 69)
      rw [CRTBarrel.xorAt, List.foldr_cons, clip_xor, rowValue_xor, ih (fun r hr => low r (List.mem_cons_of_mem _ hr))]
      simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos hbank, layer_read slot done q hbank,
        if_pos (Or.inl hlow)]
  exact (eval (taps i) (taps_low i)).trans
    (congrArg (fun z => rowValue x (clipShift (dim slot) (shift slot) z) (dim slot)) (parity_certificate i))

private theorem adjacent_layers (q i : Nat) (apart : q ≠ 66 + i) :
    (q < 66 ∨ q - 66 < i) ↔ (q < 66 ∨ q - 66 < i + 1) := by
  omega

private theorem layer_step (mirror : Bool) (slot : Fin 17) (i : Fin 3) (x : Nat → Bool) (ph : Bool) :
    corrected slot i (CRTBarrel.frame (layer slot (if mirror then i.val + 1 else i.val)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot (if mirror then i.val else i.val + 1)) x (dim slot) slot.val ph := by
  let current := if mirror then i.val + 1 else i.val
  let next := if mirror then i.val else i.val + 1
  have target : dest i = 66 + i.val := rfl
  apply State.extensionality
  · rfl
  · funext q
    by_cases hit : q = dest i
    · subst q
      have bank : dest i < 69 := Nat.add_lt_add_left i.isLt 66
      have low : ¬ dest i < 66 := Nat.not_lt_of_ge (Nat.le_add_right 66 i.val)
      have index : dest i - 66 = i.val := Nat.add_sub_cancel_left 66 i.val
      have bit (done : Nat) : (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis (dest i) =
          rowValue x (if i.val < done then clip slot (shift slot) (dest i) else raised slot i.val) (dim slot) := by
        simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos bank, layer_read slot done _ bank, low,
          false_or, index]
      have row := (quotient_certificate slot i).2
      change writeBit (CRTBarrel.frame (layer slot current) x (dim slot) slot.val ph).basis (dest i) _ (dest i) =
        (CRTBarrel.frame (layer slot next) x (dim slot) slot.val ph).basis (dest i)
      rw [writeBit, Function.update_self, layer_parity, bit current, bit next, target, row]
      by_cases active : i.val < shift slot
      · cases mirror <;>
          simp [current, next, active, rowValue_xor]
      · cases mirror <;>
          simp [current, next, active]
    · change writeBit (CRTBarrel.frame (layer slot current) x (dim slot) slot.val ph).basis (dest i) _ q =
        (CRTBarrel.frame (layer slot next) x (dim slot) slot.val ph).basis q
      rw [writeBit, Function.update_of_ne hit]
      by_cases bank : q < 69
      · have apart : q ≠ 66 + i.val := fun eq => hit (eq.trans target.symm)
        have adjacent := adjacent_layers q i.val apart
        have same : (q < 66 ∨ q - 66 < current) ↔ (q < 66 ∨ q - 66 < next) := by
          cases mirror
          · exact adjacent
          · exact adjacent.symm
        simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos bank, layer_read slot current q bank,
          layer_read slot next q bank, same]
      · simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_neg bank]

private theorem layer_step_forward (slot : Fin 17) (i : Fin 3) (x : Nat → Bool) (ph : Bool) :
    corrected slot i (CRTBarrel.frame (layer slot i.val) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot (i.val + 1)) x (dim slot) slot.val ph :=
  layer_step false slot i x ph

private theorem layer_step_inverse (slot : Fin 17) (i : Fin 3) (x : Nat → Bool) (ph : Bool) :
    corrected slot i (CRTBarrel.frame (layer slot (i.val + 1)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot i.val) x (dim slot) slot.val ph :=
  layer_step true slot i x ph

private theorem correction_forward (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (corrections false) t (CRTBarrel.frame (layer slot 0) x (dim slot) slot.val ph) =
      CRTBarrel.frame (coded slot (shift slot)) x (dim slot) slot.val ph := by
  rw [corrections_run _ _ _ _ (flags _ (layer_size ..) _ _ _)]
  change corrected slot ⟨2, by decide⟩ (corrected slot ⟨1, by decide⟩
    (corrected slot ⟨0, by decide⟩ _)) = _
  rw [layer_step_forward slot ⟨0, by decide⟩ x ph, layer_step_forward slot ⟨1, by decide⟩ x ph,
    layer_step_forward slot ⟨2, by decide⟩ x ph, layer_done]

private theorem correction_inverse (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (corrections true) t (CRTBarrel.frame (coded slot (shift slot)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (layer slot 0) x (dim slot) slot.val ph := by
  rw [← layer_done, corrections_run _ _ _ _ (flags _ (layer_size ..) _ _ _)]
  change corrected slot ⟨0, by decide⟩ (corrected slot ⟨1, by decide⟩
    (corrected slot ⟨2, by decide⟩ _)) = _
  rw [layer_step_inverse slot ⟨2, by decide⟩ x ph, layer_step_inverse slot ⟨1, by decide⟩ x ph,
    layer_step_inverse slot ⟨0, by decide⟩ x ph]

private def quotientWord (slot : Fin 17) (x : Nat → Bool) : Fin 16 :=
  ⟨fieldWord (3 - shift slot) (fun i => rowValue x (clip slot 0 (66 + i)) (dim slot)),
    lt_of_lt_of_le (fieldWord_small ..) (by
      simpa using Nat.pow_le_pow_right (by decide : 0 < 2) (show 3 - shift slot ≤ 4 by omega))⟩

private theorem word_small (slot : Fin 17) (x : Nat → Bool) :
    (quotientWord slot x).val < 2 ^ (3 - shift slot) :=
  fieldWord_small ..

private theorem word_bit (slot : Fin 17) (x : Nat → Bool) (i : Nat) (hi : i < 3) :
    (quotientWord slot x).val.testBit i = rowValue x (clip slot 0 (66 + i)) (dim slot) := by
  by_cases low : i < 3 - shift slot
  · exact fieldWord_bit _ _ _ low
  · have high : 3 - shift slot ≤ i := Nat.le_of_not_lt low
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (word_small slot x)
      (Nat.pow_le_pow_right (by decide : 0 < 2) high)), (quotient_certificate slot ⟨i,hi⟩).1 high]
    exact (CRTBarrel.Field.rowValue_zero ..).symm

private theorem word_raised (slot : Fin 17) (x : Nat → Bool) (i : Nat) (hi : i < 3) :
    ((quotientWord slot x).val <<< (LateQuotientShift.capShift (shift slot)).val).testBit i =
      rowValue x (raised slot i) (dim slot) := by
  have uncapped : ((quotientWord slot x).val <<< (LateQuotientShift.capShift (shift slot)).val) =
      (quotientWord slot x).val <<< shift slot := by
    by_cases within : shift slot ≤ 4
    · simp [LateQuotientShift.capShift, Nat.min_eq_left within]
    · have z : 3 - shift slot = 0 := by omega
      have small := word_small slot x
      rw [z, Nat.pow_zero] at small
      rw [show (quotientWord slot x).val = 0 by omega]
      simp
  rw [uncapped, Nat.testBit_shiftLeft]
  by_cases moved : shift slot ≤ i
  · simp only [raised, moved, decide_true, Bool.true_and]
    exact word_bit slot x _ (by omega)
  · simp [raised, moved, CRTBarrel.Field.rowValue_zero]

private theorem shiftPort_low : ∀ i : Fin 3, shiftPort i.val = 66 + i.val := by decide

private theorem selector_projection : ∀ (slot : Fin 17) (q : Fin 6), 3 ≤ q.val →
    69 ≤ shiftPort q.val ∧
    CRTBarrel.flags 69 slot.val (shiftPort q.val) =
      LateQuotientShift.admittedBit false false (LateQuotientShift.capShift (shift slot)) 0 q.val := by
  decide +kernel

private theorem quotient_admission (shifted : Bool) (slot : Fin 17) (rs : Rows) (sz : rs.size = 69)
    (x : Nat → Bool) (ph : Bool)
    (qRows : ∀ i : Fin 3, read rs (66 + i.val) =
      if shifted then raised slot i.val else clip slot 0 (66 + i.val)) :
    QuotientFrame shifted slot (quotientWord slot x) (CRTBarrel.frame rs x (dim slot) slot.val ph) := by
  have small : (quotientWord slot x).val <
      2 ^ (LateQuotientShift.quotientWidth false - (LateQuotientShift.capShift (shift slot)).val) := by
    rw [LateQuotientShift.capShift_width]
    exact word_small ..
  apply (LateQuotientShift.frame_iff false shifted shiftPort _ _ _ small).mpr
  intro q hq
  have bound : q < 6 := Finset.mem_range.mp hq
  by_cases low : q < 3
  · have bank : 66 + q < 69 := Nat.add_lt_add_left low 66
    rw [shiftPort_low ⟨q,low⟩]
    simp only [CRTBarrel.frame, Matrix.basis, sz, if_pos bank, qRows ⟨q,low⟩,
      LateQuotientShift.admittedBit, LateQuotientShift.quotientWidth, Bool.false_eq_true, if_false,
      if_pos low]
    cases shifted
    · exact (word_bit slot x q low).symm
    · exact (word_raised slot x q low).symm
  · have projection := selector_projection slot ⟨q,bound⟩ (Nat.le_of_not_lt low)
    have independent : LateQuotientShift.admittedBit false shifted
        (LateQuotientShift.capShift (shift slot)) (quotientWord slot x) q =
        LateQuotientShift.admittedBit false false (LateQuotientShift.capShift (shift slot)) 0 q := by
      simp only [LateQuotientShift.admittedBit, LateQuotientShift.quotientWidth,
        Bool.false_eq_true, if_false, if_neg low]
    exact (flags rs sz slot x ph (shiftPort q) projection.1).trans
      (projection.2.trans independent.symm)

private theorem shift_pair (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    let left := CRTBarrel.frame (scalarFrame slot) x (dim slot) slot.val ph
    let right := CRTBarrel.frame (layer slot 0) x (dim slot) slot.val ph
    run (shiftProgram false) t left = right ∧ run (shiftProgram true) t right = left := by
  intro left right
  have l : QuotientFrame false slot (quotientWord slot x) left := by
    apply quotient_admission false slot _ (scalar_size slot)
    intro i
    change read (scalarFrame slot) (66 + i.val) = clip slot 0 (66 + i.val)
    rw [scalar_read slot _ (Nat.add_lt_add_left i.isLt 66),
      if_neg (Nat.not_lt_of_ge (Nat.le_add_right 66 i.val))]
  have r : QuotientFrame true slot (quotientWord slot x) right := by
    apply quotient_admission true slot _ (layer_size slot 0)
    intro i
    change read (layer slot 0) (66 + i.val) = raised slot i.val
    have non : ¬ (66 + i.val < 66 ∨ 66 + i.val - 66 < 0) := by omega
    rw [layer_read slot 0 _ (Nat.add_lt_add_left i.isLt 66), if_neg non, Nat.add_sub_cancel_left]
  have agree : ∀ q, q ∉ (LateQuotientShift.ports false).image shiftPort → right.basis q = left.basis q := by
    intro q free
    by_cases known : q < 69
    · have below : q < 66 := by
        by_contra! above
        have eq : 66 + (q - 66) = q := Nat.add_sub_of_le above
        have within : 66 + (q - 66) < 66 + 3 := eq.symm ▸ known
        have high : q - 66 < 3 := Nat.lt_of_add_lt_add_left within
        have port : q - 66 ∈ LateQuotientShift.ports false :=
          Finset.mem_range.mpr (Nat.lt_trans high (by decide : 3 < 6))
        exact free (Finset.mem_image.mpr ⟨q - 66, port, (shiftPort_low ⟨q - 66,high⟩).trans eq⟩)
      simp only [right, left, CRTBarrel.frame, Matrix.basis, layer_size, scalar_size, if_pos known,
        layer_read slot 0 q known, scalar_read slot q known, if_pos below, if_pos (Or.inl below)]
    · have ge := Nat.le_of_not_lt known
      exact (flags _ (layer_size ..) _ _ _ q ge).trans ((flags _ (scalar_size ..) _ _ _ q ge).symm)
  have samePhase : right.phase = left.phase := by
    simp only [right, left, CRTBarrel.frame]
  have forwardOut : QuotientFrame (!false) slot (quotientWord slot x) right := by
    change QuotientFrame true slot (quotientWord slot x) right
    exact r
  have inverseOut : QuotientFrame (!true) slot (quotientWord slot x) left := by
    change QuotientFrame false slot (quotientWord slot x) left
    exact l
  have forward : run (shiftProgram false) t left = right :=
    shift_eq_of_frames false slot (quotientWord slot x) left right t l forwardOut samePhase agree
  have inverse : run (shiftProgram true) t right = left :=
    shift_eq_of_frames true slot (quotientWord slot x) right left t r inverseOut samePhase.symm
      (fun q free => (agree q free).symm)
  exact ⟨forward,inverse⟩

private theorem middle_run (scalar : ScalarAction) (slot : Fin 17) (mirror : Bool)
    (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (middle mirror) t (CRTBarrel.frame (coded slot (entryShift mirror slot.val)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (coded slot (exitShift mirror slot.val)) x (dim slot) slot.val ph := by
  cases mirror
  · simp only [middle, Bool.false_eq_true, if_false, entryShift, exitShift, run_append]
    rw [scalar_run _ (coded_size ..), (scalar slot).1, (shift_pair slot x ph _).1,
      correction_forward]
  · simp only [middle, if_true, entryShift, exitShift, run_append]
    rw [correction_inverse, (shift_pair slot x ph _).2, scalar_run _ (scalar_size _),
      (scalar slot).2]

private theorem encode_run (coordinates : BasisCertificate) (bounds : BasisBounds) (slot : Fin 17)
    (k : Nat) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (cnotProgram outerOps) t (CRTBarrel.frame (CRTBarrel.plain 69 (dim slot) k) x (dim slot) slot.val ph) =
      CRTBarrel.frame (coded slot k) x (dim slot) slot.val ph := by
  have mapped : applyOps outerOps (CRTBarrel.plain 69 (dim slot) k) = coded slot k := by
    rw [CRTBarrel.plain, apply_map outerOps (clipShift (dim slot) k) (clip_zero (dim slot) k)
      (clip_xor (dim slot) k) (units 69), coordinates, coded]
  have step := run_ops outerOps (CRTBarrel.plain 69 (dim slot) k) x (dim slot) (CRTBarrel.flags 69 slot.val) ph t
    (fun pair hp => by simpa only [plain_size] using ⟨(bounds pair hp).1,(bounds pair hp).2.1⟩)
  rw [mapped] at step
  simpa only [CRTBarrel.frame, plain_size, coded_size] using step

private theorem decode_run (coordinates : BasisCertificate) (bounds : BasisBounds) (slot : Fin 17)
    (k : Nat) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (cnotProgram outerOps).reverse t (CRTBarrel.frame (coded slot k) x (dim slot) slot.val ph) =
      CRTBarrel.frame (CRTBarrel.plain 69 (dim slot) k) x (dim slot) slot.val ph := by
  have step := reverse_cnots outerOps (fun pair hp => (bounds pair hp).2.2)
    (CRTBarrel.frame (CRTBarrel.plain 69 (dim slot) k) x (dim slot) slot.val ph) [] t
  rw [show cnotProgram outerOps.reverse = (cnotProgram outerOps).reverse from List.map_reverse,
    encode_run coordinates bounds] at step
  exact step

/-- All measurement outcomes are allowed. The outer basis is the exact original 2,319-gate model. -/
theorem logical_run (coordinates : BasisCertificate) (bounds : BasisBounds) (scalar : ScalarAction)
    (slot : Fin 17) (mirror : Bool) (x : Nat → Bool) (ph : Bool) (t : List Bool) :
    run (logical mirror) t
      (CRTBarrel.frame (CRTBarrel.plain 69 (dim slot) (entryShift mirror slot.val)) x (dim slot) slot.val ph) =
      CRTBarrel.frame (CRTBarrel.plain 69 (dim slot) (exitShift mirror slot.val)) x (dim slot) slot.val ph := by
  rw [logical, run_append, run_append, encode_run coordinates bounds, middle_run scalar,
    decode_run coordinates bounds]

theorem emitted_eq (mir : Bool) : CRTBarrel.LateNine360.logical mir = logical mir := by
  have basis : CRTBarrel.lateNineBasis 69 CRTBarrel.LateNine360.pivotPlan = cnotProgram outerOps := rfl
  have shift_f : CRTBarrel.LateNine360.shift = shiftProgram false := by decide +kernel
  have shift_r : CRTBarrel.LateNine360.shift.reverse = shiftProgram true := by decide +kernel
  have corr_f : CRTBarrel.LateNine360.correction = corrections false := by decide +kernel
  have corr_r : CRTBarrel.LateNine360.correction.reverse = corrections true := by decide +kernel
  have factor_eq : CRTBarrel.LateNine360.factors = factors := rfl
  have scalar_eq (mirror : Bool) :
      components 69 mirror 0 CRTBarrel.LateNine360.factors = components 69 mirror 0 factors :=
    congrArg (components 69 mirror 0) factor_eq
  have back := congrArg List.reverse basis
  cases mir
  · unfold CRTBarrel.LateNine360.logical logical middle
    have centre := congrArg₂ List.append (scalar_eq false) (congrArg₂ List.append shift_f corr_f)
    exact congrArg₂ List.append (congrArg₂ List.append basis centre) back
  · unfold CRTBarrel.LateNine360.logical logical middle
    have centre := congrArg₂ List.append corr_r (congrArg₂ List.append shift_r (scalar_eq true))
    exact congrArg₂ List.append (congrArg₂ List.append basis centre) back

end ECDSAAdd.Entrant.StairPacket.LateResidue360.Caller

namespace ECDSAAdd.Entrant.StairPacket.LateResidue375

open ECDSAAdd CRTBarrel CRTBarrel.Matrix CRTBarrel.Placement

def prep (tags taps : List Wire) (a b : Wire) : Program :=
  CRTBarrel.toggles tags a ++ CRTBarrel.toggles taps b

def coherentStep (tags taps : List Wire) (a b target : Wire) : Program :=
  prep tags taps a b ++ ([Instr.CCX a b target] ++ (prep tags taps a b).reverse)

private theorem xorAt_agree (u v : BasisState) (xs : List Wire)
    (h : ∀ q ∈ xs, u q = v q) : CRTBarrel.xorAt u xs = CRTBarrel.xorAt v xs := by
  induction xs with
  | nil => rfl
  | cons q qs ih =>
    rw [CRTBarrel.xorAt, CRTBarrel.xorAt, h q (by simp), ih (fun j hj => h j (List.mem_cons_of_mem _ hj))]

private theorem toggles_proper (xs : List Wire) (q : Wire) (fresh : q ∉ xs) :
    ProperProgram (CRTBarrel.toggles xs q) := by
  intro i hi
  change i ∈ xs.map (fun p => Instr.CX p q) at hi
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hi
  exact fun eq => fresh (eq ▸ hp)

private def prepared (tags taps : List Wire) (a b : Wire) (bits : BasisState) : BasisState :=
  writeBit (writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags)) b (bits b ^^ CRTBarrel.xorAt bits taps)

private theorem prep_run (tags taps : List Wire) (a b : Wire)
    (ab : a ≠ b) (atags : a ∉ tags) (btaps : b ∉ taps) (ataps : a ∉ taps)
    (s : State) (m : List Bool) :
    run (prep tags taps a b) m s = ⟨s.phase, prepared tags taps a b s.basis⟩ := by
  cases s with
  | mk ph bits =>
    rw [prep, run_append, CRTBarrel.run_toggles _ _ atags, CRTBarrel.run_toggles _ _ btaps]
    have keep : CRTBarrel.xorAt (writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags)) taps = CRTBarrel.xorAt bits taps :=
      xorAt_agree _ _ _ (fun q hq => by
        have ne : q ≠ a := fun e => ataps (e ▸ hq)
        simp [writeBit, Function.update_of_ne ne])
    have pivotKeep : writeBit bits a (bits a ^^ CRTBarrel.xorAt bits tags) b = bits b := by
      simp [writeBit, Function.update_of_ne ab.symm]
    simp only [prepared, pivotKeep, keep]

/-- Compute the two parities, use a single Toffoli, and undo the preparation. -/
theorem coherent_run (tags taps : List Wire) (a b target : Wire)
    (ab : a ≠ b) (ta : target ≠ a) (tb : target ≠ b)
    (atags : a ∉ tags) (btaps : b ∉ taps) (ataps : a ∉ taps)
    (ttags : target ∉ tags) (ttaps : target ∉ taps) (s : State) (m : List Bool) :
    run (coherentStep tags taps a b target) m s =
      ⟨s.phase, writeBit s.basis target
        (s.basis target ^^ ((s.basis a ^^ CRTBarrel.xorAt s.basis tags) &&
          (s.basis b ^^ CRTBarrel.xorAt s.basis taps)))⟩ := by
  let selector := s.basis a ^^ CRTBarrel.xorAt s.basis tags
  let parity := s.basis b ^^ CRTBarrel.xorAt s.basis taps
  let value := s.basis target ^^ (selector && parity)
  let next : State := ⟨s.phase, writeBit s.basis target value⟩
  let ready : State := ⟨s.phase, prepared tags taps a b s.basis⟩
  let toggled : State := ⟨s.phase, writeBit ready.basis target value⟩
  have first (tape : List Bool) : run (prep tags taps a b) tape s = ready :=
    prep_run tags taps a b ab atags btaps ataps s tape
  have middle (tape : List Bool) : run [Instr.CCX a b target] tape ready = toggled := by
    have ha : ready.basis a = selector := by
      simp only [ready, prepared, writeBit, Function.update_of_ne ab, Function.update_self, selector]
    have hb : ready.basis b = parity := by
      simp only [ready, prepared, writeBit, Function.update_self, parity]
    have ht : ready.basis target = s.basis target := by
      simp only [ready, prepared, writeBit, Function.update_of_ne ta, Function.update_of_ne tb]
    change (⟨ready.phase, writeBit ready.basis target
      (ready.basis target ^^ (ready.basis a && ready.basis b))⟩ : State) = toggled
    rw [ha, hb, ht]
  have move : run (prep tags taps a b) [] next = toggled := by
    rw [prep_run tags taps a b ab atags btaps ataps]
    have same (xs : List Wire) (h : target ∉ xs) :
        CRTBarrel.xorAt next.basis xs = CRTBarrel.xorAt s.basis xs := by
      apply xorAt_agree
      intro q hq
      have ne : q ≠ target := fun e => h (e ▸ hq)
      simp [next, writeBit, Function.update_of_ne ne]
    rw [show next.phase = s.phase from rfl]
    apply congrArg (State.mk s.phase)
    unfold prepared
    rw [same tags ttags, same taps ttaps,
      show next.basis a = s.basis a by simp [next, writeBit, Function.update_of_ne ta.symm],
      show next.basis b = s.basis b by simp [next, writeBit, Function.update_of_ne tb.symm]]
    change Function.update (Function.update (Function.update s.basis target value) a selector) b parity =
      Function.update (Function.update (Function.update s.basis a selector) b parity) target value
    have firstSwap : Function.update (Function.update s.basis target value) a selector =
        Function.update (Function.update s.basis a selector) target value :=
      Function.update_comm ta value selector s.basis
    have secondSwap :
        Function.update (Function.update (Function.update s.basis a selector) target value) b parity =
          Function.update (Function.update (Function.update s.basis a selector) b parity) target value :=
      Function.update_comm tb value parity (Function.update s.basis a selector)
    exact (congrArg (fun bits : BasisState => Function.update bits b parity) firstSwap).trans secondSwap
  have proper : ProperProgram (prep tags taps a b) :=
    (properProgram_append _ _).mpr ⟨toggles_proper _ _ atags, toggles_proper _ _ btaps⟩
  have undo (tape : List Bool) : run (prep tags taps a b).reverse tape toggled = next := by
    rw [← move]
    exact run_reverse_proper _ proper next [] tape
  change run (coherentStep tags taps a b target) m s = next
  rw [coherentStep, run_append, run_append, first, middle, undo]

