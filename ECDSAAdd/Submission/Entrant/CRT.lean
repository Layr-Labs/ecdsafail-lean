namespace ECDSAAdd.Entrant.StairPacket.CRTResidueGroupedBasis
open CRTBarrel

def ops (n : Nat) (pivots : List (Nat × Nat)) : List (Nat × Nat) :=
  (pivots.zipIdx.flatMap (fun (row,i) => elimStep n i row)).reverse

abbrev Good (n : Nat) (pivots : List (Nat × Nat)) : Prop :=
  ∀ v ∈ pivots.zipIdx,
    v.2 < n ∧ (v.1.1 < n → v.1.1 ≠ v.2) ∧ v.1.2.testBit v.2 = false

theorem ops_bounds (n : Nat) (pivots : List (Nat × Nat)) (good : Good n pivots) :
    ∀ pair ∈ ops n pivots, pair.1 < n ∧ pair.2 < n ∧ pair.1 ≠ pair.2 := by
  intro pair hp
  obtain ⟨⟨⟨donor,mask⟩,i⟩,hit,hlist⟩ := List.mem_flatMap.mp (List.mem_reverse.mp hp)
  have h := good ((donor,mask),i) hit
  change pair ∈ (if donor < n then [(donor,i)] else []) ++ (selected n mask).map (fun j => (i,j)) at hlist
  rcases List.mem_append.mp hlist with hd | ht
  · split at hd
    · rename_i within
      simp only [List.mem_singleton] at hd
      subst pair
      exact ⟨within,h.1,h.2.1 within⟩
    · simp at hd
  · obtain ⟨j,hj,rfl⟩ := List.mem_map.mp ht
    obtain ⟨bound,bit⟩ := List.mem_filter.mp hj
    refine ⟨h.1,List.mem_range.mp bound,?_⟩
    change i ≠ j
    rintro rfl
    simp [h.2.2] at bit

end ECDSAAdd.Entrant.StairPacket.CRTResidueGroupedBasis


