private theorem cfgA_fast : cfgA = cfgAF := by rw [cfgA, cfgAF, cleanRem, cleanRemF, workTA_lit, K0_eq, E0_eq]
private theorem cfgB_fast : cfgB = cfgBF := by rw [cfgB, cfgBF, cleanRem, cleanRemF, workTB_lit, K0_eq, E0_eq]
