    rw [logicalAt,if_pos hit,hit,geom]
    exact CRTResidueEarly45.program_fits mir
  · by_cases e60 : start j = 60
    · have geom : barrelWidth 60 = 39 := by decide +kernel
      rw [logicalAt,if_neg hit,extraLogical,if_pos e60,e60,geom]
      exact CRTResidueEarly60.program_fits mir
    ·
      by_cases e75 : start j = 75
      · have geom : barrelWidth 75 = 46 := by decide +kernel
        rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_pos e75,e75,geom]
        exact CRTResidueEarly75.program_fits mir
      ·
        by_cases e90 : start j = 90
        · have geom : barrelWidth 90 = 54 := by decide +kernel
          rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_pos e90,e90,geom]
          exact CRTResidueEarly90.program_fits mir
        ·
          by_cases e105 : start j = 105
          · have geom : barrelWidth 105 = 61 := by decide +kernel
            rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_pos e105,e105,geom]
            exact CRTResidueEarly105.program_fits mir
          ·
            by_cases e120 : start j = 120
            · have geom : barrelWidth 120 = 69 := by decide +kernel
              rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_pos e120,e120,geom]
              exact CRTResidueEarly120.program_fits mir
            ·
              by_cases e135 : start j = 135
              · have geom : barrelWidth 135 = 76 := by decide +kernel
                rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_pos e135,e135,geom]
                exact CRTResidueEarly135.program_fits mir
              ·
                by_cases e150 : start j = 150
                · have geom : barrelWidth 150 = 84 := by decide +kernel
                  rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_pos e150,e150,geom]
                  exact CRTResidueEarly150.program_fits mir
                ·
                  by_cases e345 : start j = 345
                  · rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_pos e345, e345, CRTBarrel.LateNine345.width_at_start]
                    exact CRTBarrel.LateNine345.program_fits mir
                  ·
                    by_cases e360 : start j = 360
                    · rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_pos e360, e360, CRTBarrel.LateNine360.width_at_start]
                      exact CRTBarrel.LateNine360.program_fits mir
                    ·
                      by_cases e375 : start j = 375
                      · rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_neg e360, if_pos e375, e375, CRTBarrel.LateNine375.width_at_start]
                        exact CRTBarrel.LateNine375.program_fits mir
                      ·
                        by_cases e390 : start j = 390
                        · rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_neg e360, if_neg e375, if_pos e390, e390, CRTBarrel.LateNine390.width_at_start]
                          exact CRTBarrel.LateNine390.program_fits mir
                        ·
                          by_cases e405 : start j = 405
                          · rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_neg e360, if_neg e375, if_neg e390, if_pos e405, e405, CRTBarrel.LateNine405.width_at_start]
                            exact CRTBarrel.LateNine405.program_fits mir
                          ·
                            simpa only [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_neg e360, if_neg e375, if_neg e390, if_neg e405] using logical_fits _ (usedWidth j lo hi) mir

theorem barrel_phys (j : Fin 26) (lo : 0 ≤ j.val) (hi : j.val ≤ 24) (mir : Bool) :
    GatePhysical (barrel (start j) mir) := by
  have logicalOK := logicalAt_fits j lo hi mir
  have physicalOK := fits_rename (T := fun _ => True) (place (start j)) _ logicalOK
    (fun _ _ => trivial) (place_inj j lo hi)
  exact fun i hit => (physicalOK i hit).1

