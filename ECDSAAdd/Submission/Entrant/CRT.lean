private theorem prefix_table : residueTable 46 outerRows 0 factors = true := by
  decide +kernel

private theorem extent : extent factors = 44 := by decide +kernel

private theorem scalar_direction (slot : Fin 17) (mirror : Bool) :
    let input := if mirror then scalarFrame slot else coded slot 0
    let output := if mirror then coded slot 0 else scalarFrame slot
    componentRows mirror slot.val 0 factors input = output := by
  intro input output
  have inputSize : input.size = 46 := by cases mirror <;> simp [input,coded_size,scalar_size]
  have outputSize : output.size = 46 := by cases mirror <;> simp [output,coded_size,scalar_size]
  apply componentRows_split 46 44 (dim slot) slot mirror outerRows input output outer_size
    inputSize outputSize (by decide) (Nat.le_refl _) (by decide) factors extent prefix_table
  · intro q hq
    cases mirror
    · simpa [input,entryShift] using coded_read slot q hq
    · exact scalar_read slot q hq
  · intro q hq
    cases mirror
    · exact scalar_read slot q hq
    · simpa [output,exitShift] using coded_read slot q hq

theorem scalar_action : ScalarAction := fun slot =>
  ⟨scalar_direction slot false,scalar_direction slot true⟩

end ScalarPremise

theorem basis_bounds : BasisBounds := by
  intro pair hp
  obtain ⟨⟨⟨j,mask⟩,i⟩,listed,step⟩ := List.mem_flatMap.mp (List.mem_reverse.mp hp)
  have ⟨hj,hi,clear⟩ := pivot_bounds _ listed
  change pair ∈ (if j = i then [] else [(i,j),(j,i),(i,j)]) ++
    (selected 46 mask).map (fun q => (i,q)) at step
  rcases List.mem_append.mp step with swap | spill
  · by_cases same : j = i
    · simp [same] at swap
    · simp only [if_neg same, List.mem_cons, List.not_mem_nil, or_false] at swap
      rcases swap with rfl | rfl | rfl
      · exact ⟨hi,hj,Ne.symm same⟩
      · exact ⟨hj,hi,same⟩
      · exact ⟨hi,hj,Ne.symm same⟩
  · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp spill
    change q ∈ (List.range 46).filter mask.testBit at hq
    obtain ⟨within,bit⟩ := List.mem_filter.mp hq
    refine ⟨hi,List.mem_range.mp within,?_⟩
    intro eq
    change i = q at eq
    subst q
    change mask.testBit i = false at clear
    simp [clear] at bit

private theorem append_scope {p q : Program}
    (hp : wires p ⊆ Finset.range 72) (hq : wires q ⊆ Finset.range 72) :
    wires (p ++ q) ⊆ Finset.range 72 := by
  rw [wires_append]
  exact Finset.union_subset hp hq

private theorem cnot_scope (pairs : List (Wire × Wire))
    (bounds : ∀ pair ∈ pairs, pair.1 < 46 ∧ pair.2 < 46 ∧ pair.1 ≠ pair.2) :
    wires (cnotProgram pairs) ⊆ Finset.range 72 := by
  have fits : Fits (· < 72) (cnotProgram pairs) := by
    intro gate hg
    obtain ⟨⟨a,b⟩,hpair,rfl⟩ := List.mem_map.mp hg
    obtain ⟨ha,hb,sep⟩ := bounds (a,b) hpair
    refine ⟨sep,?_⟩
    intro q hq
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact Nat.lt_trans ha (by decide : 46 < 72)
    · exact Nat.lt_trans hb (by decide : 46 < 72)
  exact fun q hq => Finset.mem_range.mpr (CRTBarrel.Placement.support fits q hq)

private theorem basis_scope : wires (cnotProgram outerOps) ⊆ Finset.range 72 :=
  cnot_scope outerOps basis_bounds

private theorem factors_used : ∀ pair ∈ factors, UsedField pair.1 := by
  intro pair hp
  unfold UsedField
  simp only [factors, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

private theorem scalar_scope (mirror : Bool) : wires (components 46 mirror 0 factors) ⊆ Finset.range 72 := by
  have fits := CRTBarrel.components_fits 46 mirror 0 factors (by decide +kernel) factors_used
  exact fun q hq => Finset.mem_range.mpr (CRTBarrel.Placement.support fits q hq)

private theorem shift_scope (mirror : Bool) : wires (shiftProgram mirror) ⊆ Finset.range 72 := by
  cases mirror <;> decide +kernel

set_option maxRecDepth 7000 in
private theorem correction_scope_forward : wires (corrections false) ⊆ Finset.range 72 := by
  decide +kernel

private theorem correction_scope (mirror : Bool) : wires (corrections mirror) ⊆ Finset.range 72 := by
  cases mirror
  · exact correction_scope_forward
  · simpa only [← corrections_reverse, wires_reverse] using correction_scope_forward

/-- Scope of both emitted gate orders, including the scalar correction wires. -/
theorem logical_scope (mirror : Bool) : Scope mirror := by
  have rev : wires (cnotProgram outerOps).reverse ⊆ Finset.range 72 := by
    rw [wires_reverse]
    exact basis_scope
  have body : wires (middle mirror) ⊆ Finset.range 72 := by
    cases mirror
    · exact append_scope (scalar_scope false) (append_scope (shift_scope false) (correction_scope false))
    · exact append_scope (correction_scope true) (append_scope (shift_scope true) (scalar_scope true))
  change wires ((cnotProgram outerOps ++ middle mirror) ++ (cnotProgram outerOps).reverse) ⊆ Finset.range 72
  exact append_scope (append_scope basis_scope body) rev

private def parityRow (i : Fin 2) : Nat := [52776558133249,35184372088835][i.val]?.getD 0

private def raised (slot : Fin 17) (i : Nat) : Nat :=
  if shift slot ≤ i then clip slot 0 (44 + (i - shift slot)) else 0

private def layer (slot : Fin 17) (done : Nat) : Rows :=
  Array.ofFn (fun q : Fin 46 =>
    if q.val < 44 ∨ q.val - 44 < done then clip slot (shift slot) q.val
    else raised slot (q.val - 44))

private theorem rows_size : outerRows.size = 46 := rfl
@[simp] private theorem coded_size (slot : Fin 17) (k : Nat) : (coded slot k).size = 46 := by
