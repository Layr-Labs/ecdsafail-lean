def UsedField (p : Nat) : Prop :=
  p = 7 ∨ p = 11 ∨ p = 13 ∨ p = 19 ∨ p = 25 ∨ p = 31 ∨ p = 37 ∨ p = 41 ∨ p = 47 ∨ p = 55 ∨ p = 59 ∨ p = 61 ∨ p = 67 ∨ p = 73 ∨ p = 87 ∨ p = 91 ∨ p = 97 ∨ p = 103 ∨ p = 109 ∨ p = 115 ∨ p = 117 ∨ p = 255 ∨ p = 257 ∨ p = 313 ∨ p = 21 ∨ p = 471

