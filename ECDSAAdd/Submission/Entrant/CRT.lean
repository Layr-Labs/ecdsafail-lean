        (s.basis 1558).toNat = LeaveCompanion.upperBorrow (2^(sbP (start j))) r.u r.v e ∧
        regValue (smallA j) s.basis = ((F.u+F.v)/2^(sbP (start j) + 1)) % 2^(lowsP (start j))) :
