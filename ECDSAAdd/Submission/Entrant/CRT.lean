private theorem quotientMasksCheck : ∀ i : Fin 20,
    let sites := paritySourcesTable.getD i.val []
    let q := CRTBarrel.Matrix.read encodedRows (84+i.val)
    let mix := sites.foldl (fun x j => x ^^^ CRTBarrel.Matrix.read encodedRows j) 0
    sites ≠ [] ∧ PeakNodup.nodupMask sites 0 = true ∧ (∀ j ∈ sites, j < 84) ∧
      q &&& (2^(84+i.val)-1) = 0 ∧ q ^^^ mix < 2^(i.val+1) := by
  decide +kernel

theorem quotientMasks : ∀ i : Fin 20,
    let sites := paritySourcesTable.getD i.val []
    let q := CRTBarrel.Matrix.read encodedRows (84+i.val)
    let mix := sites.foldl (fun x j => x ^^^ CRTBarrel.Matrix.read encodedRows j) 0
    sites ≠ [] ∧ sites.Nodup ∧ (∀ j ∈ sites, j < 84) ∧
      q &&& (2^(84+i.val)-1) = 0 ∧ q ^^^ mix < 2^(i.val+1) := by
  intro i
  have h := quotientMasksCheck i
  exact ⟨h.1, PeakNodup.nodup_of_mask _ h.2.1, h.2.2⟩

