/-- The forward barrel shifts every bank word with clear high padding, and its measured mirror
restores every forward image. Both preserve the exterior and the incoming phase on every tape. -/
theorem barrel_result (j : Fin 26) (lo : 0 ≤ j.val) (hi : j.val ≤ 24) (mir : Bool)
    (slot : Fin 17) (v : Nat) (s : State) (tape : List Bool)
    (_admitted : v < 2^Shadow7.wpP (start j))
    (short : start j ≤ 150 → v < 2^(Shadow7.wpP (start j)-1))
    (small : v < 2^(barrelWidth (start j) - (slot.val - 1)))
    (input : HighBankBarrel.holds (Shadow7.bankW (start j)) (barrelWidth (start j))
      (v <<< entryShift mir slot.val) s)
    (tag : ∀ k : Fin 16, s.basis (tagsP.getD k.val 1560) = decide (slot.val = k.val+1))
    (scratch : ∀ k < 10, s.basis (Shadow7.poolW (start j) (17+k)) = false) :
    HighBankBarrel.Result (Shadow7.bankW (start j)) (barrelWidth (start j))
      (v <<< exitShift mir slot.val) s (run (barrel (start j) mir) tape s) := by
  let n := barrelWidth (start j)
  have hn : UsedWidth n := usedWidth j lo hi
  by_cases hit : start j = 45
  · have hw : barrelWidth 45 = 31 := by decide +kernel
    have hd : Shadow7.wpP 45 = 17 := by decide +kernel
    have inlet : v < 2^16 := by
      simpa only [hit,hd] using short (by omega)
    have padding : v < 2^(31-(slot.val-1)) := by simpa only [hit,hw] using small
    have liveFit : v < 2^(CRTResidueEarly45.liveDim slot) := by
      unfold CRTResidueEarly45.liveDim
      rcases Nat.le_total 16 (31-(slot.val-1)) with h | h
      · simpa only [Nat.min_eq_left h] using inlet
      · simpa only [Nat.min_eq_right h] using padding
    refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
    rw [logicalAt,if_pos hit,hit,hw]
    exact CRTResidueEarly45.logical_run slot mir v.testBit s.phase tape
  · by_cases e60 : start j = 60
    · have hw : barrelWidth 60 = 39 := by decide +kernel
      have hd : Shadow7.wpP 60 = 25 := by decide +kernel
      have inlet : v < 2^24 := by simpa only [e60,hd] using short (by omega)
      have padding : v < 2^(39-(slot.val-1)) := by simpa only [e60,hw] using small
      have liveFit : v < 2^(CRTResidueEarly60.liveDim slot) := by
        unfold CRTResidueEarly60.liveDim
        rcases Nat.le_total 24 (39-(slot.val-1)) with h | h
        · simpa only [Nat.min_eq_left h] using inlet
        · simpa only [Nat.min_eq_right h] using padding
      refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
      rw [logicalAt,if_neg hit,extraLogical,if_pos e60,e60,hw]
      exact CRTResidueEarly60.logical_run slot mir v.testBit s.phase tape
    ·
      by_cases e75 : start j = 75
      · have hw : barrelWidth 75 = 46 := by decide +kernel
        have hd : Shadow7.wpP 75 = 32 := by decide +kernel
        have inlet : v < 2^31 := by simpa only [e75,hd] using short (by omega)
        have padding : v < 2^(46-(slot.val-1)) := by simpa only [e75,hw] using small
        have liveFit : v < 2^(CRTResidueEarly75.liveDim slot) := by
          unfold CRTResidueEarly75.liveDim
          rcases Nat.le_total 31 (46-(slot.val-1)) with h | h
          · simpa only [Nat.min_eq_left h] using inlet
          · simpa only [Nat.min_eq_right h] using padding
        refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
        rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_pos e75,e75,hw]
        exact CRTResidueEarly75.logical_run slot mir v.testBit s.phase tape
      ·
        by_cases e90 : start j = 90
        · have hw : barrelWidth 90 = 54 := by decide +kernel
          have hd : Shadow7.wpP 90 = 40 := by decide +kernel
          have inlet : v < 2^39 := by simpa only [e90,hd] using short (by omega)
          have padding : v < 2^(54-(slot.val-1)) := by simpa only [e90,hw] using small
          have liveFit : v < 2^(CRTResidueEarly90.liveDim slot) := by
            unfold CRTResidueEarly90.liveDim
            rcases Nat.le_total 39 (54-(slot.val-1)) with h | h
            · simpa only [Nat.min_eq_left h] using inlet
            · simpa only [Nat.min_eq_right h] using padding
          refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
          rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_pos e90,e90,hw]
          exact CRTResidueEarly90.logical_run slot mir v.testBit s.phase tape
        ·
          by_cases e105 : start j = 105
          · have hw : barrelWidth 105 = 61 := by decide +kernel
            have hd : Shadow7.wpP 105 = 47 := by decide +kernel
            have inlet : v < 2^46 := by simpa only [e105,hd] using short (by omega)
            have padding : v < 2^(61-(slot.val-1)) := by simpa only [e105,hw] using small
            have liveFit : v < 2^(CRTResidueEarly105.liveDim slot) := by
              unfold CRTResidueEarly105.liveDim
              rcases Nat.le_total 46 (61-(slot.val-1)) with h | h
              · simpa only [Nat.min_eq_left h] using inlet
              · simpa only [Nat.min_eq_right h] using padding
            refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
            rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_pos e105,e105,hw]
            exact CRTResidueEarly105.logical_run slot mir v.testBit s.phase tape
          ·
            by_cases e120 : start j = 120
            · have hw : barrelWidth 120 = 69 := by decide +kernel
              have hd : Shadow7.wpP 120 = 55 := by decide +kernel
              have inlet : v < 2^54 := by simpa only [e120,hd] using short (by omega)
              have padding : v < 2^(69-(slot.val-1)) := by simpa only [e120,hw] using small
              have liveFit : v < 2^(CRTResidueEarly120.liveDim slot) := by
                unfold CRTResidueEarly120.liveDim
                rcases Nat.le_total 54 (69-(slot.val-1)) with h | h
                · simpa only [Nat.min_eq_left h] using inlet
                · simpa only [Nat.min_eq_right h] using padding
              refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
              rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_pos e120,e120,hw]
              exact CRTResidueEarly120.logical_run slot mir v.testBit s.phase tape
            ·
              by_cases e135 : start j = 135
              · have hw : barrelWidth 135 = 76 := by decide +kernel
                have hd : Shadow7.wpP 135 = 62 := by decide +kernel
                have inlet : v < 2^61 := by simpa only [e135,hd] using short (by omega)
                have padding : v < 2^(76-(slot.val-1)) := by simpa only [e135,hw] using small
                have liveFit : v < 2^(CRTResidueEarly135.liveDim slot) := by
                  unfold CRTResidueEarly135.liveDim
                  rcases Nat.le_total 61 (76-(slot.val-1)) with h | h
                  · simpa only [Nat.min_eq_left h] using inlet
                  · simpa only [Nat.min_eq_right h] using padding
                refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
                rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_pos e135,e135,hw]
                exact CRTResidueEarly135.logical_run slot mir v.testBit s.phase tape
              ·
                by_cases e150 : start j = 150
                · have hw : barrelWidth 150 = 84 := by decide +kernel
                  have hd : Shadow7.wpP 150 = 70 := by decide +kernel
                  have inlet : v < 2^69 := by simpa only [e150,hd] using short (by omega)
                  have padding : v < 2^(84-(slot.val-1)) := by simpa only [e150,hw] using small
                  have liveFit : v < 2^(CRTResidueEarly150.liveDim slot) := by
                    unfold CRTResidueEarly150.liveDim
                    rcases Nat.le_total 69 (84-(slot.val-1)) with h | h
                    · simpa only [Nat.min_eq_left h] using inlet
                    · simpa only [Nat.min_eq_right h] using padding
                  refine barrel_result_of_rows j lo hi mir slot v s tape _ liveFit ?_ input tag scratch
                  rw [logicalAt,if_neg hit,extraLogical,if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_pos e150,e150,hw]
                  exact CRTResidueEarly150.logical_run slot mir v.testBit s.phase tape
                ·
                  by_cases e345 : start j = 345
                  · refine barrel_result_of_rows j lo hi mir slot v s tape _ small ?_ input tag scratch
                    rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_pos e345, LateResidue345.Caller.emitted_eq, e345, CRTBarrel.LateNine345.width_at_start]
                    exact LateResidue345.Caller.logical_run LateResidue345.Caller.basis_certificate LateResidue345.Caller.basis_bounds
                      LateResidue345.Caller.ScalarPremise.scalar_action slot mir v.testBit s.phase tape
                  ·
                    by_cases e360 : start j = 360
                    · refine barrel_result_of_rows j lo hi mir slot v s tape _ small ?_ input tag scratch
                      rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_pos e360, LateResidue360.Caller.emitted_eq, e360, CRTBarrel.LateNine360.width_at_start]
                      exact LateResidue360.Caller.logical_run LateResidue360.Caller.basis_certificate LateResidue360.Caller.basis_bounds
                        LateResidue360.Caller.ScalarPremise.scalar_action slot mir v.testBit s.phase tape
                    ·
                      by_cases e375 : start j = 375
                      · refine barrel_result_of_rows j lo hi mir slot v s tape _ small ?_ input tag scratch
                        rw [logicalAt, if_neg hit, extraLogical, if_neg e60, if_neg e75, if_neg e90, if_neg e105, if_neg e120, if_neg e135, if_neg e150, if_neg e345, if_neg e360, if_pos e375, LateResidue375.Caller.emitted_eq, e375, CRTBarrel.LateNine375.width_at_start]
                        exact LateResidue375.Caller.logical_run LateResidue375.Caller.basis_certificate LateResidue375.Caller.basis_bounds
                          LateResidue375.Caller.ScalarPremise.scalar_action slot mir v.testBit s.phase tape
                      ·
