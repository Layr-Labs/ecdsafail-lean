    cfgC_geom.1 (by decide) cfgC_geom.2.1 cfgC_geom.2.2.1 (fun h hh => (cfgC_geom.2.2.2.2.1 h hh).1)
    cfgC_geom.2.2.2.2.2.2.1 (by simp only [cfgC_fast, SplitCfg.bank_fast, K0_eq]; decide +kernel)⟩, hr.2⟩

