    unfold leaveBox; ((try unfold Wire at *); omega)
  · have pc := Shadow7.pool_cases (i := 17+k) w1 (by omega)
    unfold leaveBox; ((try unfold Wire at *); omega)
  · have t : ∀ q ∈ tagsP, 1556 ≤ q ∧ q ≤ 1576 := by decide
    have := t q ht; unfold leaveBox; ((try unfold Wire at *); omega)

