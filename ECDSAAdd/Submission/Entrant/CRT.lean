    T1 := (E0.drop 132).take 66, T2 := (E0.drop 232).take 68,
    T5 := (E0.drop 198).take 34 ++ workTC }

/-! ### Fast `K4DQ.LBF` / `E0F` / literal mirrors for kernel evaluation -/

