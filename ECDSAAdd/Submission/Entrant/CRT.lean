section

namespace ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed
open Matrix Placement

private theorem prototype_digit (p m dim k : Nat) (use : UsedPrimary p m) (hd : dim ≤ width) (q : Nat) (hq : q < fieldDegree p*m) :
    digit width (prototypeWord p m dim k) q = clipShift dim k (Matrix.read (prototype p) q) := by
  let xs := ((prototype p).toList.take (fieldDegree p*m)).map (clipShift dim k)
  have bound : ∀ a ∈ xs, a < 2^width := by
    intro a ha
    obtain ⟨b,_,rfl⟩ := List.mem_map.mp ha
    exact lt_of_le_of_lt Nat.and_le_right (lt_of_lt_of_le (Nat.sub_lt (Nat.two_pow_pos _) (by decide : 0<1))
      (Nat.pow_le_pow_right (by decide) hd))
  have len : xs.length = fieldDegree p*m := by simp [xs,Nat.min_eq_left (prototype_size p m use)]
  have h := digit_pack xs q (len ▸ hq) bound
  have inList : q < (prototype p).size := lt_of_lt_of_le hq (prototype_size p m use)
  simpa [xs,prototypeWord,Matrix.read,List.getElem?_map,List.getElem?_take,hq,inList] using h

private theorem clip_factor (n sh k v : Nat) (high : n ≤ 135) (hk : k ≤ sh) :
    clipShift (n-sh) k (v &&& (2^n-1)) = clipShift (n-sh) 0 (clipShift (135-sh) k v) := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [clipShift,Nat.testBit_and,Nat.testBit_two_pow_sub_one,Nat.testBit_shiftRight, Nat.zero_add]
  by_cases h : i < n-sh
  · simp [h,show k+i<n by omega,show i<135-sh by omega]
  · simp [h]

private theorem shift_le_slot (mir : Bool) (slot : Fin 17) :
    entryShift mir slot.val ≤ slot.val - 1 ∧ exitShift mir slot.val ≤ slot.val - 1 := by
  cases mir <;> simp [entryShift,exitShift]

private theorem digits_source (n sh off p m k : Nat) (use : UsedPrimary p m) (high : n ≤ 135)
    (sk : k ≤ sh) (size : (coded n (n-sh) k).size = n) (endp : off+fieldDegree p*m ≤ n)
    (table : ∀ j < fieldDegree p*m, Matrix.read (encoded n) (off+j) = (Matrix.read (prototype p) j &&& (2^n-1))) :
    ∀ j < fieldDegree p*m, digit width (codedWord n (n-sh) k) (off+j) = clipShift (n-sh) 0 (digit width (prototypeWord p m (135-sh) k) j) := by
  intro j hj
  have inner : off+j < n := by omega
  have sz : (encoded n).size = n := by simpa only [coded, Array.size_map] using size
  have h := (coded_matches n (n-sh) k (by unfold width; omega) (off+j) (by rwa [size])).symm
  rw [h,prototype_digit p m (135-sh) k use (by unfold width; omega) j hj]
  have readMap : Matrix.read (coded n (n-sh) k) (off+j) = clipShift (n-sh) k (Matrix.read (encoded n) (off+j)) := by
    simp [Matrix.read,coded,show off+j < (encoded n).size by rwa [sz]]
  rw [readMap,table j hj,clip_factor n sh k _ high sk]

theorem template_action (n : Nat) (hn : UsedWidth n) (slot : Fin 17) (mir : Bool) : ActionOK n slot.val mir := by
  obtain ⟨_low,high,checked⟩ := table_checked n hn
  let sh := slot.val - 1
  let dim := n - sh
  let pdim := 135 - sh
  let a := entryShift mir slot.val
  let b := exitShift mir slot.val
  let src := codedWord n dim a
  let dst := codedWord n dim b
  let crop := clipShift dim 0
  have sz (k : Nat) : (coded n dim k).size = n := by
    rw [←encode_of_receipt n dim k (coordinates_checked n hn),applyOps_size,plain_size]
  have ks := shift_le_slot mir slot
  have sweep (ps : List (Nat × Nat)) (off bank : Nat) (endp : off+extent ps = n) (hc : tableOK n off ps = true)
      (inv : ∀ q<n, digit width bank q = if q<off then digit width dst q else digit width src q) :
      ∀ q<n, digit width (componentWord n mir slot.val off ps bank) q = digit width dst q := by
    induction ps generalizing off bank with
    | nil =>
      change off+0 = n at endp
      intro q hq
      simpa only [componentWord,if_pos (show q<off by omega)] using inv q hq
    | cons pair tail ih =>
      obtain ⟨p,m⟩ := pair
      let len := fieldDegree p*m
      change off+(len+extent tail) = n at endp
      have endHead : off+len ≤ n := by omega
      simp only [tableOK,Bool.and_eq_true] at hc
      obtain ⟨⟨ok,tbl⟩,rest⟩ := hc
      have valid : UsedPrimary p m := of_decide_eq_true ok
      have rows (j : Nat) (hj : j<len) := beq_iff_eq.mp (List.all_eq_true.mp tbl j (List.mem_range.mpr hj))
      have left := digits_source n sh off p m a valid high ks.1 (sz _) endHead rows
      have right := digits_source n sh off p m b valid high ks.2 (sz _) endHead rows
      have before : Slice crop off len bank bank (prototypeWord p m pdim a) := by
        refine ⟨?_,fun _ _ => rfl⟩
        intro j hj
        rw [inv _ (by omega),if_neg (by omega)]
        exact left j hj
      have after := primary_slice crop (clip_zero dim 0) (clip_xor dim 0) n off p m slot.val bank bank _ mir before
      have expected : primaryWord len (prototypeWord p m pdim a) 0 p m slot.val mir = prototypeWord p m pdim b :=
        beq_iff_eq.mp (prototype_checked p m valid slot mir)
      rw [expected] at after
      change ∀ q<n, digit width (componentWord n mir slot.val (off+len) tail _) q = digit width dst q
      apply ih _ _ (by omega) rest
      intro q hq
      by_cases earlier : q < off
      · rw [after.exterior q (Or.inl earlier),inv q hq,if_pos earlier,if_pos (by omega)]
      · by_cases contained : q < off+len
        · have j : q-off < len := by omega
          have pos : off+(q-off) = q := Nat.add_sub_of_le (Nat.le_of_not_lt earlier)
          rw [if_pos contained,←pos,after.same _ j,right _ j]
        · rw [after.exterior q (Or.inr (Nat.le_of_not_lt contained)),inv q hq,if_neg earlier,if_neg contained]
  apply action_of_digits n slot.val hn (by unfold width; omega) mir
  exact sweep (schedule n) 0 src (by rw [schedule_extent n hn]; omega) checked (by simp [src])

end ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed

end
-- ==== end CRTTemplateAction ====

section
open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Entrant.StairPacket
namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open Arithmetic Challenge CRTBarrel CRTBarrel.Matrix
set_option maxRecDepth 30000
set_option maxHeartbeats 3000000
set_option linter.unusedSimpArgs false
theorem selectorIsThreshold : ∀ (slot : Fin 17) (i : Fin 14),
    CRTBarrel.xorAt (CRTBarrel.flags width slot.val) (selectorSites i.val) =
      decide (i.val < slot.val - 1) := by
  decide +kernel

theorem coordinateWires :
    (∀ a ∈ encoding, a.1 < width ∧ a.2 < width ∧ a.1 ≠ a.2) ∧
    (∀ i : Fin 14, (paritySites i.val).Nodup ∧ (paritySites i.val).length > 0 ∧
      ∀ q ∈ paritySites i.val, q < retained) := by decide +kernel

def dim (slot : Nat) := min retained (width - (slot - 1))
def coded (slot k : Nat) : Rows := applyOps encoding (CRTBarrel.plain width (dim slot) k)
def rowParity (rs : Rows) (i : Nat) : Nat :=
  (paritySites i).foldl (fun a q => a ^^^ Matrix.read rs q) 0

def boundaryRows (rs : Rows) (slot : Nat) : Rows :=
  (List.range quotientBits).foldl
    (fun a i => a.setIfInBounds (retained + i)
      (Matrix.read rs (retained + i) ^^^ (if i < slot - 1 then rowParity rs i else 0))) rs

def encodedRows : Rows := #[1840700269, 920350134, 490370281, 659463482, 1318926964, 1662567985, 623462994, 692736660, 831283992, 2147483647, 715827882, 1288490188, 143165576, 1894838512, 547397792, 1086374080, 8421504, 629276672, 1258553344, 369623040, 739246080, 1478492160, 809500672, 1619001344, 1090519040, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824]

private theorem encodedRows_check :
    applyOps encoding (CRTBarrel.Matrix.units width) = encodedRows := by
  apply Array.toList_inj.mp
  decide +kernel

def fastCoded (slot k : Nat) : Rows :=
  encodedRows.map (CRTBarrel.clipShift (dim slot) k)

private theorem coded_fast (slot k : Nat) : coded slot k = fastCoded slot k := by
  unfold coded CRTBarrel.plain fastCoded
  rw [CRTBarrel.Matrix.apply_map _ _ (CRTBarrel.clip_zero ..) (CRTBarrel.clip_xor (dim slot) k), encodedRows_check]

private theorem fastZeroInput : ∀ (slot : Fin 17) (i : Fin 14),
    Matrix.read (fastCoded slot.val 0) (retained+i.val) = 0 := by decide +kernel

private theorem fastReversePrepared : ∀ (slot : Fin 17) (i : Fin 14),
    let r := fastCoded slot.val (slot.val - 1)
    Matrix.read r (retained + i.val) =
      if i.val < slot.val - 1 then rowParity r i.val else 0 := by
  decide +kernel

theorem zeroInput : ∀ (slot : Fin 17) (i : Fin 14),
    Matrix.read (coded slot.val 0) (retained+i.val) = 0 := by
  intro slot i
  simpa only [coded_fast] using fastZeroInput slot i

theorem reversePrepared : ∀ (slot : Fin 17) (i : Fin 14),
    let r := coded slot.val (slot.val - 1)
    Matrix.read r (retained + i.val) =
      if i.val < slot.val - 1 then rowParity r i.val else 0 := by
  intro slot i
  simpa only [coded_fast] using fastReversePrepared slot i

-- Equivalent scalar matrix step. The arithmetic reads only the active selector.
def fastField (rs : Rows) (p : Nat) (mir : Bool) (slot off : Nat) : Rows :=
  Array.ofFn fun q : Fin rs.size =>
    if off ≤ q.val ∧ q.val < off + CRTBarrel.fieldDegree p then
      CRTBarrel.fastScalar p mir slot (fun j => Matrix.read rs (off+j)) (q.val-off)
    else Matrix.read rs q.val

private theorem scalar_eq_fast (rs : Rows) (p : Nat) (mir : Bool) (slot off : Nat) :
    CRTBarrel.scalarRows rs p mir slot off = fastField rs p mir slot off := by
  simp only [CRTBarrel.scalarRows,fastField,CRTBarrel.scalar_fast]

private theorem primary_one_fast (r : Rows) (off p slot : Nat) (mir : Bool) :
    CRTBarrel.primaryRows r off p 1 slot mir = fastField r p mir slot off := by
  cases mir <;> simp [CRTBarrel.primaryRows,CRTBarrel.scalars,CRTBarrel.triRows,
    CRTBarrel.stageRows,CRTBarrel.oriented,show List.range 4 = [0,1,2,3] from rfl,
    show List.range 1 = [0] from rfl,scalar_eq_fast]

def fastComponents (mir : Bool) (slot : Nat) (r : Rows) : Rows :=
  fastField (fastField (fastField (fastField r 7 mir slot 0) 11 mir slot 2) 31 mir slot 5)
    257 mir slot 9

private theorem components_eq_fast (mir : Bool) (slot : Nat) (r : Rows) :
    CRTBarrel.componentRows mir slot 0 factors r = fastComponents mir slot r := by
  have h7 : CRTBarrel.fieldDegree 7 = 2 := by decide +kernel
  have h11 : CRTBarrel.fieldDegree 11 = 3 := by decide +kernel
  have h31 : CRTBarrel.fieldDegree 31 = 4 := by decide +kernel
  simp [factors,CRTBarrel.componentRows,primary_one_fast,fastComponents,h7,h11,h31]

end ECDSAAdd.Entrant.StairPacket.CRTResidueS45
end

namespace ECDSAAdd.Entrant.StairPacket.CRTResiduePulse
open Arithmetic CRTBarrel

private theorem xor_write (bits : BasisState) (xs : List Wire) (t : Wire) (b : Bool)
    (apart : t ∉ xs) :
    xorAt (writeBit bits t b) xs = xorAt bits xs := by
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    have ha : a ≠ t := fun e => apart (by simp [e])
    have ht : t ∉ xs := fun hh => apart (List.mem_cons_of_mem _ hh)
    simp only [xorAt,writeBit,Function.update_of_ne ha]
    exact congrArg (Bool.xor (bits a)) (ih ht)

private theorem xor_append (bits : BasisState) (a b : List Wire) :
    xorAt bits (a ++ b) = (xorAt bits a ^^ xorAt bits b) := by
  induction a with
  | nil => simp [xorAt]
  | cons h t ih => simp [xorAt,ih]

private theorem xor_reverse (bits : BasisState) (xs : List Wire) :
    xorAt bits xs.reverse = xorAt bits xs := by
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    rw [List.reverse_cons,xor_append,ih]
    simp [xorAt,Bool.xor_comm]

private theorem selector_restored (bits : BasisState) (t a q : Wire)
    (ta : t ≠ a) (tq : t ≠ q) (aq : a ≠ q) (x y z : Bool) :
    writeBit (writeBit (writeBit (writeBit (writeBit bits t x) a y) q z) a (bits a))
      t (bits t) = writeBit bits q z := by
  funext k
  by_cases ht : k = t
  · subst k; simp [writeBit,Function.update_of_ne tq]
  by_cases ha : k = a
  · subst k; simp [writeBit,Function.update_of_ne ta.symm,Function.update_of_ne aq]
  by_cases hq : k = q
  · subst k; simp [writeBit,Function.update_of_ne tq.symm,Function.update_of_ne aq.symm]
  simp [writeBit,Function.update_of_ne ht,Function.update_of_ne ha,Function.update_of_ne hq]

private theorem erase_eq_ccx (a b q : Wire) (s : State) (tape : List Bool)
    (ha : a ≠ q) (hb : b ≠ q)
    (prepared : s.basis q = (s.basis a && s.basis b)) :
    run [.measureX q [] [.CZ a b]] tape s = run [.CCX a b q] [] s := by
  change run [GateMirror.front (.pop a b q)] tape s = _
  rw [GateMirror.head_default (.pop a b q) s prepared (by simp [GateMirror.proper, ha, hb]) tape]
  simp [GateMirror.transition,GateMirror.front,GateMirror.erase,run,measureAndCorrect,ECDSAAdd.correct,prepared]

/-- A selector parity and a data parity act on a separate quotient bit.
The reverse gate erases a prepared bit and preserves the incoming phase on every tape. -/
theorem run_pulse (tags data : List Wire) (t a q : Wire) (mir : Bool)
    (ph : Bool) (bits : BasisState) (tape : List Bool)
    (ta : t ≠ a) (tq : t ≠ q) (aq : a ≠ q)
    (tt : t ∉ tags) (atags : a ∉ tags) (qt : q ∉ tags)
    (td : t ∉ data) (ad : a ∉ data) (qd : q ∉ data)
    (clear : bits t = false)
    (prepared : mir = true → bits q = (xorAt bits tags && (bits a ^^ xorAt bits data))) :
    run ((toggles tags t ++ toggles data a) ++
        [if mir then .measureX q [] [.CZ t a] else .CCX t a q] ++
        (toggles tags t ++ toggles data a).reverse) tape ⟨ph,bits⟩ =
      ⟨ph, writeBit bits q (bits q ^^ (xorAt bits tags && (bits a ^^ xorAt bits data)))⟩ := by
  let sel := xorAt bits tags
  let val := bits a ^^ xorAt bits data
  let out := bits q ^^ (sel && val)
  let s1 := writeBit bits t sel
  let s2 := writeBit s1 a val
  let s3 := writeBit s2 q out
  let s4 := writeBit s3 a (bits a)
  have sa : s1 a = bits a := by simp [s1,writeBit,Function.update_of_ne ta.symm]
  have st : s2 t = sel := by simp [s2,s1,writeBit,Function.update_of_ne ta]
  have pa : s2 a = val := by simp [s2,writeBit]
  have sq : s2 q = bits q := by
    simp [s2,s1,writeBit,Function.update_of_ne aq.symm,Function.update_of_ne tq.symm]
  have forward (m : List Bool) :
      run (toggles tags t ++ toggles data a) m ⟨ph,bits⟩ = ⟨ph,s2⟩ := by
    rw [run_append,run_take,run_toggles _ _ tt,clear,Bool.false_xor]
    change run (toggles data a) _ ⟨ph,s1⟩ = _
    rw [run_toggles _ _ ad,sa]
    simp only [s1,s2,sel,val,xor_write _ _ _ _ td]
  have center (m : List Bool) :
      run [if mir then .measureX q [] [.CZ t a] else .CCX t a q] m ⟨ph,s2⟩ = ⟨ph,s3⟩ := by
    cases hm : mir
    · simp [run,s3,out,sq,st,pa]
    · have hp : s2 q = (s2 t && s2 a) := by rw [sq,st,pa]; exact prepared hm
      simpa [hm,run,s3,out,sq,st,pa] using erase_eq_ccx t a q ⟨ph,s2⟩ m tq aq hp
  have data_parity : xorAt s3 data = xorAt bits data := by
    simp only [s3,s2,s1,xor_write _ _ _ _ qd,xor_write _ _ _ _ ad,xor_write _ _ _ _ td]
  have tags_parity : xorAt s4 tags = sel := by
    simp only [s4,s3,s2,s1,sel,xor_write _ _ _ _ atags,xor_write _ _ _ _ qt,xor_write _ _ _ _ tt]
  have unwind (m : List Bool) :
      run (toggles tags t ++ toggles data a).reverse m ⟨ph,s3⟩ =
        ⟨ph,writeBit bits q out⟩ := by
    rw [List.reverse_append]
    simp only [toggles,←List.map_reverse]
    change run (toggles data.reverse a ++ toggles tags.reverse t) _ _ = _
    have ad' : a ∉ data.reverse := by simpa using ad
    have tt' : t ∉ tags.reverse := by simpa using tt
    rw [run_append,run_take,run_toggles _ _ ad',xor_reverse,data_parity]
    have sv : s3 a = val := by simp [s3,writeBit,Function.update_of_ne aq,pa]
    have restored : (val ^^ xorAt bits data) = bits a := by
      change ((bits a ^^ xorAt bits data) ^^ xorAt bits data) = bits a
      rw [Bool.xor_assoc,Bool.xor_self]
      exact Bool.xor_false _
    rw [sv,restored]
    change run (toggles tags.reverse t) _ ⟨ph,s4⟩ = _
    rw [run_toggles _ _ tt',xor_reverse,tags_parity]
    have sw : s4 t = sel := by
      simp [s4,s3,writeBit,Function.update_of_ne ta,Function.update_of_ne tq,st]
    rw [sw,Bool.xor_self,← clear]
    exact congrArg (State.mk ph) (selector_restored _ _ _ _ ta tq aq _ _ _)
  rw [List.append_assoc,run_append,run_take,forward,run_append,run_take,center,unwind]

end ECDSAAdd.Entrant.StairPacket.CRTResiduePulse

section
open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Entrant.StairPacket
namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open Arithmetic Challenge CRTBarrel CRTBarrel.Matrix
set_option maxRecDepth 30000
set_option maxHeartbeats 120000
-- Insert in the witness namespace after the closed finite row checks.
open CRTBarrel.Placement CRTBarrel.Matrix

-- Insert in the witness namespace after the closed finite row checks.
open CRTBarrel.Placement CRTBarrel.Matrix

-- Insert in the witness namespace after the closed finite row checks.
open CRTBarrel.Placement CRTBarrel.Matrix

private theorem coded_size (slot k : Nat) : (coded slot k).size = width := by
  simp [coded]

private theorem boundary_size (initial : Rows) (slot : Nat) :
    (boundaryRows initial slot).size = initial.size := by
  let step := fun (r : Rows) i => r.setIfInBounds (retained+i)
    (Matrix.read initial (retained+i) ^^^ (if i < slot-1 then rowParity initial i else 0))
  have sizes (todo : List Nat) (r : Rows) : (todo.foldl step r).size = r.size := by
    induction todo generalizing r with
    | nil => rfl
    | cons i tail ih =>
      simp only [List.foldl_cons,ih,step,Array.size_setIfInBounds]
  exact sizes (List.range quotientBits) initial

private theorem parity_row_eval (rs : Rows) (word : Nat → Bool) (d slot : Nat) (ph : Bool)
    (xs : List Wire) (within : ∀ q ∈ xs, q < rs.size) (initial : Nat) :
    rowValue word (xs.foldl (fun z q => z ^^^ Matrix.read rs q) initial) d =
      (rowValue word initial d ^^ xorAt (frame rs word d slot ph).basis xs) := by
  induction xs generalizing initial with
  | nil => simp [xorAt]
  | cons a tail ih =>
    have ha := within a (by simp)
    have ht : ∀ q ∈ tail, q < rs.size := fun q h => within q (List.mem_cons_of_mem _ h)
    simp only [List.foldl_cons,xorAt]
    rw [ih ht, rowValue_xor]
    simp only [frame,Matrix.basis,if_pos ha,Bool.xor_assoc]

private theorem read_set_away (rs : Rows) (i j y : Nat) (away : i ≠ j) :
    Matrix.read (rs.setIfInBounds i y) j = Matrix.read rs j := by
  simp [Matrix.read,away]

private theorem parity_read_agree (a b : Rows) (i : Nat)
    (same : ∀ q ∈ paritySites i, Matrix.read a q = Matrix.read b q) :
    rowParity a i = rowParity b i := by
  have eqFold (qs : List Wire) (z : Nat) (agree : ∀ q ∈ qs, Matrix.read a q = Matrix.read b q) :
      qs.foldl (fun x q => x ^^^ Matrix.read a q) z =
        qs.foldl (fun x q => x ^^^ Matrix.read b q) z := by
    induction qs generalizing z with
    | nil => rfl
    | cons q qs ih =>
      simp only [List.foldl_cons]
      rw [agree q (by simp)]
      exact ih _ (fun w h => agree w (List.mem_cons_of_mem _ h))
  exact eqFold _ 0 same

private theorem frame_set (rs : Rows) (x : Nat → Bool) (d slot q row : Nat) (ph : Bool)
    (hq : q < rs.size) :
    frame (rs.setIfInBounds q row) x d slot ph =
      ⟨ph,writeBit (frame rs x d slot ph).basis q (rowValue x row d)⟩ := by
  apply congrArg (State.mk ph)
  funext k
  by_cases eq : k = q
  · subst k
    simp [frame,Matrix.basis,Matrix.read,writeBit,hq]
  · simp [frame,Matrix.basis,Matrix.read,writeBit,
      Function.update_of_ne eq,Ne.symm eq]

private theorem selector_bounds (i : Nat) :
    ∀ k ∈ selectorSites i, width ≤ k ∧ k < width+16 := by
  intro q hq
  obtain ⟨k,hk,rfl⟩ := List.mem_map.mp hq
  have lt := List.mem_range.mp (List.mem_of_mem_drop hk)
  exact ⟨Nat.le_add_right 31 k,Nat.add_lt_add_left lt 31⟩

private theorem selector_parity (rs : Rows) (sz : rs.size = width)
    (slot : Fin 17) (i : Fin 14) (word : Nat → Bool) (d : Nat) (ph : Bool) :
    xorAt (frame rs word d slot.val ph).basis (selectorSites i.val) = decide (i.val < slot.val - 1) := by
  have agrees : ∀ k ∈ selectorSites i.val,
      (frame rs word d slot.val ph).basis k = flags width slot.val k := fun k hk => by
    have outside := Nat.not_lt.mpr (selector_bounds _ k hk).1
    simp [frame,Matrix.basis,sz,outside]
  have same (xs : List Wire) (sameBits : ∀ k ∈ xs,
      (frame rs word d slot.val ph).basis k = flags width slot.val k) :
      xorAt (frame rs word d slot.val ph).basis xs = xorAt (flags width slot.val) xs := by
    induction xs with
    | nil => rfl
    | cons a t ih =>
      exact congrArg₂ Bool.xor (sameBits a (by simp))
        (ih (fun q h => sameBits q (List.mem_cons_of_mem _ h)))
  rw [same _ agrees,selectorIsThreshold]


attribute [local irreducible] run

private theorem correction_run (rs : Rows) (sz : rs.size = width) (slot : Fin 17)
    (i : Fin 14) (mir : Bool) (word : Nat → Bool) (d : Nat) (ph : Bool) (tape : List Bool)
    (prepared : mir = true → Matrix.read rs (retained+i.val) =
      if i.val < slot.val-1 then rowParity rs i.val else 0) :
    run (correction mir i.val) tape (frame rs word d slot.val ph) =
      frame (rs.setIfInBounds (retained+i.val)
        (Matrix.read rs (retained+i.val) ^^^
          (if i.val < slot.val-1 then rowParity rs i.val else 0))) word d slot.val ph := by
  let q : Wire := retained+i.val
  let ps := paritySites i.val
  let a : Wire := ps.headD 0
  let ts := selectorSites i.val
  obtain ⟨nodup,nonempty,low⟩ := coordinateWires.2 i
  change ps.length > 0 at nonempty
  have coords : ps = a :: ps.tail := by
    cases h : ps with
    | nil => simp [h] at nonempty
    | cons u us => simp [a,h]
  have aqSites : a ∈ ps := by rw [coords]; simp
  have lowA : a < retained := low a aqSites
  have lowD : ∀ k ∈ ps.tail, k < retained := fun k h => low k (List.mem_of_mem_tail h)
  have tagB : ∀ k ∈ ts, width ≤ k ∧ k < width+16 := selector_bounds i.val
  have hi := i.isLt
  have qBound : q < rs.size := by
    rw [sz]
    change 17 + i.val < 31
    omega
  have aApart : a ≠ q :=
    Nat.ne_of_lt (Nat.lt_of_lt_of_le lowA (Nat.le_add_right retained i.val))
  have apartData : a ∉ ps.tail := by
    change ps.Nodup at nodup
    have fixed : (a :: ps.tail).Nodup := coords ▸ nodup
    exact (List.nodup_cons.mp fixed).1
  have clear : (frame rs word d slot.val ph).basis 55 = false := by
    simp [frame,Matrix.basis,flags,sz,width]
  have reg (k : Nat) (hk : k < rs.size) :
      (frame rs word d slot.val ph).basis k = rowValue word (Matrix.read rs k) d := by
    simp [frame,Matrix.basis,hk]
  have parity : ((frame rs word d slot.val ph).basis a ^^
      xorAt (frame rs word d slot.val ph).basis ps.tail) = rowValue word (rowParity rs i.val) d := by
    have inside : ∀ k ∈ ps, k < rs.size := fun k h => by
      rw [sz]
      exact Nat.lt_trans (low k h) (by decide : retained < width)
    have check := parity_row_eval rs word d slot.val ph ps inside 0
    rw [CRTBarrel.Field.rowValue_zero,Bool.false_xor] at check
    change rowValue word (rowParity rs i.val) d = _ at check
    let bits := (frame rs word d slot.val ph).basis
    have expose : xorAt bits ps = (bits a ^^ xorAt bits ps.tail) :=
      (congrArg (xorAt bits) coords).trans rfl
    exact expose.symm.trans check.symm
  have on := selector_parity rs sz slot i word d ph
  have enables : (xorAt (frame rs word d slot.val ph).basis ts &&
    ((frame rs word d slot.val ph).basis a ^^ xorAt (frame rs word d slot.val ph).basis ps.tail)) =
      rowValue word (if i.val < slot.val-1 then rowParity rs i.val else 0) d := by
    rw [on,parity]
    by_cases h : i.val < slot.val-1 <;> simp [h,CRTBarrel.Field.rowValue_zero]
  have prep : mir = true → (frame rs word d slot.val ph).basis q =
      (xorAt (frame rs word d slot.val ph).basis ts &&
         ((frame rs word d slot.val ph).basis a ^^ xorAt (frame rs word d slot.val ph).basis ps.tail)) := by
    intro hm
    rw [reg q qBound,enables]
    exact congrArg (fun z => rowValue word z d) (prepared hm)
  have q31 : q < width := by simpa only [sz] using qBound
  have tq1 : (55 : Wire) ≠ q := Nat.ne_of_gt (Nat.lt_trans q31 (by decide : width < 55))
  have ta1 : (55 : Wire) ≠ a := Nat.ne_of_gt (Nat.lt_trans lowA (by decide : retained < 55))
  have pulse := CRTResiduePulse.run_pulse ts ps.tail 55 a q mir ph
      (frame rs word d slot.val ph).basis tape
      ta1 tq1 aApart
      (fun h => Nat.not_lt_of_ge (by decide : width+16 ≤ 55) (tagB 55 h).2)
      (fun h => Nat.not_lt_of_ge (tagB a h).1 (Nat.lt_trans lowA (by decide : retained < width)))
      (fun h => Nat.not_lt_of_ge (tagB q h).1 q31)
      (fun h => Nat.not_lt_of_ge (by decide : retained ≤ 55) (lowD 55 h))
      apartData (fun h => Nat.not_lt_of_ge (Nat.le_add_right retained i.val) (lowD q h))
      clear prep
  let bits := (frame rs word d slot.val ph).basis
  let delta := if i.val < slot.val-1 then rowParity rs i.val else 0
  let result (bit : Bool) := State.mk ph (writeBit bits q bit)
  have resultBit : (bits q ^^ (xorAt bits ts && (bits a ^^ xorAt bits ps.tail))) =
      rowValue word (Matrix.read rs q ^^^ delta) d :=
    (congrArg₂ Bool.xor (reg q qBound) enables).trans (rowValue_xor word (Matrix.read rs q) delta d).symm
  have stateEq := congrArg result resultBit
  have matrixEq := frame_set rs word d slot.val q (Matrix.read rs q ^^^ delta) ph qBound
  exact pulse.trans (stateEq.trans matrixEq.symm)



private theorem corrections_run (initial : Rows) (sz : initial.size = width) (slot : Fin 17)
    (mir : Bool) (x : Nat → Bool) (d : Nat) (ph : Bool) (tape : List Bool)
    (prepared : mir = true → ∀ i : Fin 14, Matrix.read initial (retained+i.val) =
      if i.val < slot.val-1 then rowParity initial i.val else 0) :
    run (corrections mir) tape (frame initial x d slot.val ph) =
      frame (boundaryRows initial slot.val) x d slot.val ph := by
  let update := fun (rs : Rows) (i : Nat) =>
    rs.setIfInBounds (retained+i)
      (Matrix.read initial (retained+i) ^^^
        if i < slot.val-1 then rowParity initial i else 0)
  have go (xs : List Nat) (rs : Rows) (tape : List Bool) (nd : xs.Nodup)
      (bound : ∀ i ∈ xs, i < 14) (size : rs.size = width)
      (lower : ∀ q < retained, Matrix.read rs q = Matrix.read initial q)
      (upper : ∀ i ∈ xs, Matrix.read rs (retained+i) = Matrix.read initial (retained+i)) :
      run (xs.flatMap (correction mir)) tape (frame rs x d slot.val ph) =
        frame (xs.foldl update rs) x d slot.val ph := by
    induction xs generalizing rs tape with
    | nil => simp only [List.flatMap_nil,List.foldl_nil,run]
    | cons i todo ih =>
      have hi := bound i (by simp)
      have parity : rowParity rs i = rowParity initial i :=
        parity_read_agree _ _ _ (fun q h => lower q ((coordinateWires.2 ⟨i,hi⟩).2.2 _ h))
      have top := upper i (by simp)
      have correct := correction_run rs size slot ⟨i,hi⟩ mir x d ph tape
        (fun hm => by
          simpa only [top,parity] using prepared hm ⟨i,hi⟩)
      simp only [top,parity] at correct
      change run (correction mir i) tape (frame rs x d slot.val ph) =
        frame (update rs i) x d slot.val ph at correct
      simp only [List.flatMap_cons,List.foldl_cons,run_append,run_take]
      rw [correct]
      refine ih (update rs i) _ (List.nodup_cons.mp nd).2
        (fun k hk => bound k (List.mem_cons_of_mem _ hk)) (by simp [update,size]) ?_ ?_
      · intro q hq
        have sep : retained+i ≠ q := Nat.ne_of_gt (Nat.lt_of_lt_of_le hq (Nat.le_add_right retained i))
        simpa only [update,read_set_away _ _ _ _ sep] using lower q hq
      · intro j hj
        have away : i ≠ j := fun e => (List.nodup_cons.mp nd).1 (e ▸ hj)
        have sep : retained+i ≠ retained+j := fun e => away (Nat.add_left_cancel e)
        simpa only [update,read_set_away _ _ _ _ sep] using
          upper j (List.mem_cons_of_mem _ hj)
  exact go (List.range quotientBits) initial tape List.nodup_range
    (fun _ h => List.mem_range.mp h) sz (fun _ _ => rfl) (fun _ _ => rfl)



end ECDSAAdd.Entrant.StairPacket.CRTResidueS45
end

namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open Arithmetic CRTBarrel CRTBarrel.Matrix
set_option maxHeartbeats 100000
attribute [local irreducible] run

theorem encode_run (slot : Fin 17) (shift : Nat) (x : Nat → Bool)
    (ph : Bool) (tape : List Bool) :
    run (cnotProgram encoding) tape
      (frame (CRTBarrel.plain width (dim slot.val) shift) x (dim slot.val) slot.val ph) =
      frame (coded slot.val shift) x (dim slot.val) slot.val ph := by
  let d := dim slot.val
  let src := CRTBarrel.plain width d shift
  let dst := coded slot.val shift
  have srcSize : src.size = width := CRTBarrel.plain_size width d shift
  have codedByOps : applyOps encoding src = dst := rfl
  have dstSize : dst.size = width :=
    codedByOps ▸ (applyOps_size encoding src).trans srcSize
  let mkState (rs : Rows) (n : Nat) := State.mk ph (Matrix.basis rs x d (flags n slot.val))
  have entry : frame src x d slot.val ph = mkState src width :=
    congrArg (mkState src) srcSize
  have output : frame dst x d slot.val ph = mkState dst width :=
    congrArg (mkState dst) dstSize
  have fit (pair : Wire × Wire) (h : pair ∈ encoding) :
      pair.1 < src.size ∧ pair.2 < src.size := by
    rw [srcSize]
    exact ⟨(coordinateWires.1 pair h).1,(coordinateWires.1 pair h).2.1⟩
  have action :
      run (cnotProgram encoding) tape (mkState src width) = mkState (applyOps encoding src) width :=
    Matrix.run_ops encoding src x d (flags width slot.val) ph tape fit
  have inputRun := congrArg (run (cnotProgram encoding) tape) entry
  exact inputRun.trans (action.trans ((congrArg (fun r => mkState r width) codedByOps).trans output.symm))


theorem decode_run (slot : Fin 17) (shift : Nat) (x : Nat → Bool)
    (ph : Bool) (tape : List Bool) :
    run (cnotProgram encoding).reverse tape
      (frame (coded slot.val shift) x (dim slot.val) slot.val ph) =
      frame (CRTBarrel.plain width (dim slot.val) shift) x (dim slot.val) slot.val ph := by
  let s := frame (CRTBarrel.plain width (dim slot.val) shift) x (dim slot.val) slot.val ph
  have encoded := encode_run slot shift x ph []
  have undo := reverse_cnots encoding (fun a h => (coordinateWires.1 a h).2.2) s [] tape
  have rev : cnotProgram encoding.reverse = (cnotProgram encoding).reverse := List.map_reverse
  have preserved := congrArg (run (cnotProgram encoding).reverse tape) encoded
  rw [rev] at undo
  exact preserved.symm.trans undo


end ECDSAAdd.Entrant.StairPacket.CRTResidueS45

namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open Arithmetic CRTBarrel CRTBarrel.Matrix CRTBarrel.Placement
set_option maxHeartbeats 100000
attribute [local irreducible] run

theorem fields_run (r : Rows) (sz : r.size = width) (mir : Bool) (slot : Fin 17)
    (d : Nat) (x : Nat → Bool) (ph : Bool) (tape : List Bool) :
    run (components width mir 0 factors) tape (frame r x d slot.val ph) =
      frame (componentRows mir slot.val 0 factors r) x d slot.val ph := by
  have support : extent factors ≤ width := by decide +kernel
  have bound : 0+extent factors ≤ r.size := by
    rw [sz,Nat.zero_add]
    exact support
  have used : ∀ pm ∈ factors, CRTBarrel.UsedField pm.1 := by decide +kernel
  have small : slot.val < 32 := Nat.lt_trans slot.isLt (by decide)
  let inlet := frame r x d slot.val ph
  have eqProgram : components width mir 0 factors = components r.size mir 0 factors :=
    congrArg (fun n => components n mir 0 factors) sz.symm
  have transport := congrArg (fun p => run p tape inlet) eqProgram
  exact transport.trans (frame_components r mir 0 slot.val d factors small bound used x ph tape)


end ECDSAAdd.Entrant.StairPacket.CRTResidueS45

section
open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Arithmetic ECDSAAdd.Entrant.StairPacket
set_option maxRecDepth 30000
set_option maxHeartbeats 3000000

namespace ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed
open Matrix Placement

/-- Across a factor slice, all bank digits agree with the same cropped certified
prototype in the applicable input or output orientation. -/
def PrefixAligned (dim slot : Nat) (mir : Bool) (src dst : Nat) :
    Nat → List (Nat × Nat) → Prop
  | _, [] => True
  | off, (p,m) :: tail =>
    let len := fieldDegree p * m
    let psize := 135 - (slot - 1)
    UsedPrimary p m ∧
      (∀ j < len, digit width src (off+j) =
        clipShift dim 0 (digit width (prototypeWord p m psize (entryShift mir slot)) j)) ∧
      (∀ j < len, digit width dst (off+j) =
        clipShift dim 0 (digit width (prototypeWord p m psize (exitShift mir slot)) j)) ∧
      PrefixAligned dim slot mir src dst (off+len) tail

/-- Use the stock primary proofs for the residue prefix, while preserving every
quotient digit from the source. This avoids running a bank for each selector in
the kernel checker. -/
theorem prefix_action (n dim : Nat) (slot : Fin 17) (mir : Bool) (src dst : Nat)
    (parts : List (Nat × Nat)) (aligned : PrefixAligned dim slot.val mir src dst 0 parts) (q : Nat) :
    digit width (componentWord n mir slot.val 0 parts src) q =
      if q < extent parts then digit width dst q else digit width src q := by
  let crop := clipShift dim 0
  let D := extent parts
  have run (ps : List (Nat × Nat)) (off bank : Nat) (last : off+extent ps = D)
      (ok : PrefixAligned dim slot.val mir src dst off ps)
      (inv : ∀ q, digit width bank q =
        if q < off then digit width dst q else digit width src q) :
      ∀ q, digit width (componentWord n mir slot.val off ps bank) q =
        if q < D then digit width dst q else digit width src q := by
    induction ps generalizing off bank with
    | nil =>
      intro q
      change off+0 = D at last
      simp only [Nat.add_zero] at last
      simpa only [componentWord,last] using inv q
    | cons pair tail ih =>
      obtain ⟨p,m⟩ := pair
      let len := fieldDegree p*m
      change off+(len+extent tail) = D at last
      rcases ok with ⟨factor,inputRows,outputRows,next⟩
      let pdim := 135 - (slot.val - 1)
      let input := prototypeWord p m pdim (entryShift mir slot.val)
      let output := prototypeWord p m pdim (exitShift mir slot.val)
      have before : Slice crop off len bank bank input := by
        refine ⟨?_,fun _ _ => rfl⟩
        intro j hj
        rw [inv,if_neg (by omega)]
        exact inputRows j hj
      have after := primary_slice crop (clip_zero dim 0) (clip_xor dim 0)
        n off p m slot.val bank bank input mir before
      have action : primaryWord len input 0 p m slot.val mir = output :=
        beq_iff_eq.mp (prototype_checked p m factor slot mir)
      rw [action] at after
      change ∀ q, digit width (componentWord n mir slot.val (off+len) tail _) q = _
      apply ih _ _ (by omega) next
      intro q
      by_cases earlier : q < off
      · rw [after.exterior q (Or.inl earlier),inv,if_pos earlier,if_pos (by omega)]
      · by_cases contains : q < off+len
        · have localIdx : q-off < len := by omega
          have place : off+(q-off) = q := Nat.add_sub_of_le (Nat.le_of_not_lt earlier)
          rw [if_pos contains,←place,after.same _ localIdx,outputRows _ localIdx]
        · rw [after.exterior q (Or.inr (Nat.le_of_not_lt contains)),inv,if_neg earlier,if_neg contains]
  exact run parts 0 src (Nat.zero_add _) aligned (by intro i; simp) q

/-- The closed check visits the residue rows once. The quotient rows can be arbitrary. -/
def residueTable (n : Nat) (rs : Rows) : Nat → List (Nat × Nat) → Bool
  | _, [] => true
  | off, (p,m) :: tail =>
    (decide (UsedPrimary p m) &&
      (List.range (fieldDegree p*m)).all (fun j =>
        Matrix.read rs (off+j) == (Matrix.read (prototype p) j &&& (2^n-1)))) &&
    residueTable n rs (off+fieldDegree p*m) tail

def residueWord (rs : Rows) (dim k : Nat) : Nat :=
  pack width (rs.toList.map (clipShift dim k))

private theorem residue_clip_bound (dim k v : Nat) (room : dim ≤ width) :
    clipShift dim k v < 2^width :=
  lt_of_le_of_lt Nat.and_le_right
    (lt_of_lt_of_le (Nat.sub_lt (Nat.two_pow_pos _) (by decide : 0<1))
      (Nat.pow_le_pow_right (by decide) room))

private theorem residue_word_digit (rs : Rows) (dim k q : Nat)
    (room : dim ≤ width) (hq : q < rs.size) :
    digit width (residueWord rs dim k) q = clipShift dim k (Matrix.read rs q) := by
  let xs := rs.toList.map (clipShift dim k)
  have small : ∀ a ∈ xs, a < 2^width := by
    intro a ha
    obtain ⟨b,_,rfl⟩ := List.mem_map.mp ha
    exact residue_clip_bound dim k b room
  have h := digit_pack xs q (by simpa [xs] using hq) small
  simpa [xs,residueWord,Matrix.read,List.getElem?_map,hq] using h

private theorem residue_prototype_digit (p m dim k : Nat)
    (use : UsedPrimary p m) (room : dim ≤ width) (q : Nat) (hq : q < fieldDegree p*m) :
    digit width (prototypeWord p m dim k) q = clipShift dim k (Matrix.read (prototype p) q) := by
  let xs := ((prototype p).toList.take (fieldDegree p*m)).map (clipShift dim k)
  have small : ∀ a ∈ xs, a < 2^width := by
    intro a ha
    obtain ⟨b,_,rfl⟩ := List.mem_map.mp ha
    exact residue_clip_bound dim k b room
  have len : xs.length = fieldDegree p*m := by simp [xs,Nat.min_eq_left (prototype_size p m use)]
  have h := digit_pack xs q (len ▸ hq) small
  have inside : q < (prototype p).size := lt_of_lt_of_le hq (prototype_size p m use)
  simpa [xs,prototypeWord,Matrix.read,List.getElem?_map,List.getElem?_take,hq,inside] using h

private theorem residue_clip_factor (n sh dim k v : Nat)
    (high : n ≤ 135) (fit : dim ≤ n-sh) (hk : k ≤ sh) :
    clipShift dim k (v &&& (2^n-1)) = clipShift dim 0 (clipShift (135-sh) k v) := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [clipShift,Nat.testBit_and,Nat.testBit_two_pow_sub_one,Nat.testBit_shiftRight,Nat.zero_add]
  by_cases h : i < dim
  · simp [h,show k+i<n by omega,show i<135-sh by omega]
  · simp [h]

private theorem residue_table_aligned (n dim : Nat) (slot : Fin 17) (mir : Bool)
    (rs : Rows) (size : rs.size = n) (high : n ≤ 135) (fit : dim ≤ n-(slot.val-1))
    (parts : List (Nat × Nat)) (off : Nat) (endp : off+extent parts ≤ n)
    (checked : residueTable n rs off parts = true) :
    PrefixAligned dim slot.val mir
      (residueWord rs dim (entryShift mir slot.val))
      (residueWord rs dim (exitShift mir slot.val)) off parts := by
  induction parts generalizing off with
  | nil => trivial
  | cons pair tail ih =>
    obtain ⟨p,m⟩ := pair
    let len := fieldDegree p*m
    change off+(len+extent tail) ≤ n at endp
    simp only [residueTable,Bool.and_eq_true] at checked
    obtain ⟨⟨used,table⟩,rest⟩ := checked
    have valid : UsedPrimary p m := of_decide_eq_true used
    have word (k : Nat) (fits : k ≤ slot.val-1) (j : Nat) (hj : j < len) :
        digit width (residueWord rs dim k) (off+j) =
          clipShift dim 0 (digit width (prototypeWord p m (135-(slot.val-1)) k) j) := by
      have rn : dim ≤ width := by unfold width; omega
      have hn : 135-(slot.val-1) ≤ width := by unfold width; omega
      have inside : off+j < rs.size := by rw [size]; omega
      have row := beq_iff_eq.mp (List.all_eq_true.mp table j (List.mem_range.mpr hj))
      rw [residue_word_digit rs dim k (off+j) rn inside, row,
          residue_prototype_digit p m (135-(slot.val-1)) k valid hn j hj,
          residue_clip_factor n (slot.val-1) dim k _ high fit fits]
    have shifts : entryShift mir slot.val ≤ slot.val-1 ∧ exitShift mir slot.val ≤ slot.val-1 := by
      cases mir <;> simp [entryShift,exitShift]
    exact ⟨valid,word _ shifts.1,word _ shifts.2,ih (off+len) (by omega) rest⟩

theorem residue_table_action (n dim : Nat) (slot : Fin 17) (mir : Bool) (rs : Rows)
    (size : rs.size = n) (high : n ≤ 135) (fit : dim ≤ n-(slot.val-1))
    (parts : List (Nat × Nat)) (extent_le : extent parts ≤ n)
    (checked : residueTable n rs 0 parts = true) (q : Nat) :
    digit width (componentWord n mir slot.val 0 parts
      (residueWord rs dim (entryShift mir slot.val))) q =
      if q < extent parts then digit width (residueWord rs dim (exitShift mir slot.val)) q
      else digit width (residueWord rs dim (entryShift mir slot.val)) q :=
  prefix_action n dim slot mir _ _ parts
    (residue_table_aligned n dim slot mir rs size high fit parts 0 (by simpa only [Nat.zero_add] using extent_le) checked) q


open Matrix

/-- The array kept between the scalar field circuit and the quotient correction. -/
def keepPrefix (rs : Rows) (D : Nat) : Rows :=
  Array.ofFn (fun q : Fin rs.size => if q.val < D then Matrix.read rs q else 0)

@[simp] theorem keepPrefix_size (rs : Rows) (D : Nat) : (keepPrefix rs D).size = rs.size := by
  simp [keepPrefix]

theorem read_keepPrefix (rs : Rows) (D q : Nat) (hq : q < rs.size) :
    Matrix.read (keepPrefix rs D) q = if q < D then Matrix.read rs q else 0 := by
  simp [Matrix.read,keepPrefix,hq]

def windowRows (rs : Rows) (d k : Nat) : Rows := rs.map (clipShift d k)

@[simp] theorem windowRows_size (rs : Rows) (d k : Nat) : (windowRows rs d k).size = rs.size := by
  simp [windowRows]

theorem read_windowRows (rs : Rows) (dim k q : Nat) (hq : q < rs.size) :
    Matrix.read (windowRows rs dim k) q = clipShift dim k (Matrix.read rs q) := by
  simp [Matrix.read,windowRows,hq]

/-- Zeroing the quotient preserves the one check of the certified prototype prefix. -/
theorem table_keepPrefix (n : Nat) (rs : Rows) (size : rs.size = n)
    (D : Nat) (fits : D ≤ n) (parts : List (Nat × Nat)) (off : Nat)
    (within : off+extent parts ≤ D) (tested : residueTable n rs off parts = true) :
    residueTable n (keepPrefix rs D) off parts = true := by
  induction parts generalizing off with
  | nil => rfl
  | cons pair tail ih =>
    obtain ⟨p,m⟩ := pair
    change off+(fieldDegree p*m+extent tail) ≤ D at within
    simp only [residueTable,Bool.and_eq_true] at tested ⊢
    refine ⟨⟨tested.1.1,?_⟩,ih (off+fieldDegree p*m) (by omega) tested.2⟩
    apply List.all_eq_true.mpr
    intro j hj
    have bound := List.mem_range.mp hj
    rw [read_keepPrefix rs D (off+j) (by omega),if_pos (by omega)]
    exact List.all_eq_true.mp tested.1.2 j hj

/-- Lift the proved digit action to the array used by the circuit semantics. -/
theorem componentRows_keepPrefix (n dim D : Nat) (slot : Fin 17) (mir : Bool)
    (rs : Rows) (size : rs.size = n) (high : n ≤ 135) (fit : dim ≤ n-(slot.val-1))
    (parts : List (Nat × Nat)) (extent_eq : extent parts = D) (bound : D ≤ n)
    (test : residueTable n rs 0 parts = true) :
    componentRows mir slot.val 0 parts (windowRows (keepPrefix rs D) dim (entryShift mir slot.val)) =
      windowRows (keepPrefix rs D) dim (exitShift mir slot.val) := by
  let core := keepPrefix rs D
  have coreSize : core.size = n := (keepPrefix_size rs D).trans size
  have accepted : residueTable n core 0 parts = true :=
    table_keepPrefix n rs size D bound parts 0 (by omega) test
  have room : dim ≤ width := by unfold width; omega
  have matchRows (k : Nat) : Matches (residueWord core dim k) (windowRows core dim k) := by
    intro q hq
    have inCore : q < core.size := by simpa only [windowRows_size] using hq
    rw [read_windowRows core dim k q inCore]
    exact (residue_word_digit core dim k q room inCore).symm
  let left := windowRows core dim (entryShift mir slot.val)
  let right := windowRows core dim (exitShift mir slot.val)
  let out := componentRows mir slot.val 0 parts left
  have leftSize : left.size = n := (windowRows_size ..).trans coreSize
  have rightSize : right.size = n := (windowRows_size ..).trans coreSize
  have outSize : out.size = n := (componentRows_size ..).trans leftSize
  have agree := components_match n _ 0 slot.val mir parts left leftSize (by omega)
    (matchRows (entryShift mir slot.val))
  change out = right
  apply Array.ext (outSize.trans rightSize.symm)
  intro q ho hr
  have testBit := residue_table_action n dim slot mir core coreSize high fit parts (by omega) accepted q
  have result : Matrix.read out q = Matrix.read right q := by
    rw [agree q ho,testBit]
    by_cases kept : q < D
    · rw [if_pos (by omega)]
      exact (matchRows (exitShift mir slot.val) q hr).symm
    · have inside : q < core.size := coreSize ▸ (outSize ▸ ho)
      have eq (k : Nat) : digit width (residueWord core dim k) q = 0 := by
        rw [residue_word_digit core dim k q room inside]
        change clipShift dim k (Matrix.read (keepPrefix rs D) q) = 0
        rw [read_keepPrefix rs D q (by omega),if_neg kept,clip_zero]
      rw [if_neg (by omega),eq]
      exact (matchRows (exitShift mir slot.val) q hr).trans (eq _) |>.symm
  simpa only [Matrix.read,Array.getElem?_eq_getElem ho,Array.getElem?_eq_getElem hr,Option.getD_some] using result

theorem componentRows_zero (n dim D : Nat) (slot : Fin 17) (hz : slot.val ≤ 1) (mir : Bool)
    (rs : Rows) (size : rs.size = n) (high : n ≤ 135) (fit : dim ≤ n-(slot.val-1))
    (parts : List (Nat × Nat)) (extent_eq : extent parts = D) (bound : D ≤ n)
    (test : residueTable n rs 0 parts = true) :
    componentRows mir slot.val 0 parts (windowRows rs dim 0) = windowRows rs dim 0 := by
  have he : entryShift mir slot.val = 0 := by cases mir <;> simp [entryShift] <;> omega
  have hx : exitShift mir slot.val = 0 := by cases mir <;> simp [exitShift] <;> omega
  have room : dim ≤ width := by unfold width; omega
  have matchRows : Matches (residueWord rs dim 0) (windowRows rs dim 0) := by
    intro q hq
    have inRs : q < rs.size := by simpa only [windowRows_size] using hq
    rw [read_windowRows rs dim 0 q inRs]
    exact (residue_word_digit rs dim 0 q room inRs).symm
  let left := windowRows rs dim 0
  let out := componentRows mir slot.val 0 parts left
  have leftSize : left.size = n := (windowRows_size ..).trans size
  have outSize : out.size = n := (componentRows_size ..).trans leftSize
  have agree := components_match n _ 0 slot.val mir parts left leftSize (by omega) matchRows
  change out = left
  apply Array.ext (outSize.trans leftSize.symm)
  intro q ho hr
  have testBit := residue_table_action n dim slot mir rs size high fit parts (by omega) test q
  rw [he, hx] at testBit
  have result : Matrix.read out q = Matrix.read left q := by
    rw [agree q ho, testBit]
    split <;> exact (matchRows q hr).symm
  simpa only [Matrix.read,Array.getElem?_eq_getElem ho,Array.getElem?_eq_getElem hr,Option.getD_some] using result

end ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed

namespace ECDSAAdd.Entrant.StairPacket.CRTResidueMasks
open CRTBarrel

private theorem testBit_clearBelow (row bound i : Nat)
    (clear : row &&& (2^bound-1) = 0) (hi : i < bound) :
    row.testBit i = false := by
  have h := congrArg (fun n : Nat => n.testBit i) clear
  simpa [Nat.testBit_and,Nat.testBit_two_pow_sub_one,hi] using h

private theorem clip_false (row dim k : Nat)
    (off : ∀ i < dim, row.testBit (k+i) = false) :
    clipShift dim k row = 0 := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [clipShift,Nat.testBit_and,Nat.testBit_shiftRight,Nat.testBit_two_pow_sub_one]
  by_cases hi : i < dim
  · simp [hi,off i hi]
  · simp [hi]

/-- Quotient coefficients of index at least the shift are zero. Smaller
coefficients equal their residue parity on every input of degree below dim. -/
theorem admitted_quotient (q parity D i k dim : Nat) (live : dim ≤ D)
    (empty : q &&& (2^(D+i)-1) = 0)
    (parity_mask : (q ^^^ parity) < 2^(i+1)) :
    clipShift dim k q = if i < k then clipShift dim k parity else 0 := by
  by_cases hot : i < k
  · rw [if_pos hot]
    have short : q ^^^ parity < 2^k :=
      lt_of_lt_of_le parity_mask (Nat.pow_le_pow_right (by decide : 0 < 2) (by omega))
    have clean := clip_false (q ^^^ parity) dim k
      (fun j _ => Nat.testBit_lt_two_pow (lt_of_lt_of_le short
        (Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : k ≤ k+j))))
    rw [clip_xor] at clean
    have h := congrArg (fun x => x ^^^ clipShift dim k parity) clean
    simpa only [Nat.xor_assoc,Nat.xor_self,Nat.xor_zero,Nat.zero_xor] using h
  · rw [if_neg hot]
    exact clip_false q dim k (fun j hj => testBit_clearBelow q _ (k+j) empty (by omega))

theorem clip_parity (k dim : Nat) (rows : List Nat) :
    clipShift dim k (rows.foldl Nat.xor 0) =
      (rows.map (clipShift dim k)).foldl Nat.xor 0 := by
  have same (rows : List Nat) (acc : Nat) :
      clipShift dim k (rows.foldl Nat.xor acc) =
        (rows.map (clipShift dim k)).foldl Nat.xor (clipShift dim k acc) := by
    induction rows generalizing acc with
    | nil => rfl
    | cons a tail ih =>
      simp only [List.foldl_cons,List.map_cons,ih]
      exact congrArg (fun v : Nat => (tail.map (clipShift dim k)).foldl Nat.xor v)
        (clip_xor dim k acc a)
  simpa only [clip_zero] using same rows 0

end ECDSAAdd.Entrant.StairPacket.CRTResidueMasks


namespace ECDSAAdd.Entrant.StairPacket.CRTResidueThreshold
open CRTBarrel

theorem sites_membership (width tags i q : Nat) :
    q ∈ sites width tags i ↔ width+i+1 ≤ q ∧ q < width+tags := by
  simp only [sites,List.range_eq_range',List.drop_range',Nat.mul_one,Nat.zero_add,List.mem_map,List.mem_range'_1]
  constructor
  · rintro ⟨j, ⟨lo,hi⟩, rfl⟩
    omega
  · rintro ⟨lo,hi⟩
    exact ⟨q-width,⟨by omega,by omega⟩,by omega⟩

private theorem xor_congr (xs : List Nat) (a b : BasisState)
    (agree : ∀ q ∈ xs, a q = b q) : xorAt a xs = xorAt b xs := by
  induction xs with
  | nil => rfl
  | cons q tail ih =>
    exact congrArg₂ Bool.xor (agree q (by simp)) (ih (fun j h => agree j (List.mem_cons_of_mem _ h)))

private theorem xor_select (xs : List Nat) (nd : xs.Nodup) (q : Nat) :
    xorAt (fun j => decide (j=q)) xs = decide (q ∈ xs) := by
  induction xs with
  | nil => rfl
  | cons h t ih =>
    have clean := (List.nodup_cons.mp nd).1
    simp only [xorAt,ih (List.nodup_cons.mp nd).2,List.mem_cons]
    by_cases eq : h = q
    · subst q; simp [clean]
    · simp [eq,Ne.symm eq]

theorem hot (width tags i slot : Nat) (slotBound : slot < tags+1) :
    xorAt (flags width tags slot) (sites width tags i) = decide (i < slot-1) := by
  by_cases hz : slot = 0
  · subst slot
    have eq : xorAt (flags width tags 0) (sites width tags i) =
        xorAt (fun _ => false) (sites width tags i) := by
      apply xor_congr
      intro q _
      simp [flags]
    rw [eq]
    have zero (xs : List Nat) : xorAt (fun _ => false) xs = false := by
      induction xs with
      | nil => rfl
      | cons q tail ih => simp only [xorAt,Bool.false_xor,ih]
    rw [zero]
    simp
  · let choice := width+(slot-1)
    have sameBits (q : Nat) (hq : q ∈ sites width tags i) :
        flags width tags slot q = decide (q = choice) := by
      have bounds := (sites_membership width tags i q).mp hq
      unfold flags choice
      exact decide_eq_decide.mpr (by omega)
    rw [xor_congr _ _ _ sameBits,xor_select]
    · apply decide_eq_decide.mpr
      rw [sites_membership]
      unfold choice
      omega
    · unfold sites
      rw [List.range_eq_range',List.drop_range']
      exact List.Nodup.map (fun _ _ e => Nat.add_left_cancel e) (List.nodup_range' 1)

end ECDSAAdd.Entrant.StairPacket.CRTResidueThreshold

namespace ECDSAAdd.Entrant.StairPacket.CRTResidueCorrection
open Arithmetic Challenge CRTBarrel CRTBarrel.Matrix
set_option maxRecDepth 30000
set_option maxHeartbeats 120000

variable {width retained tagCount scratch : Nat} {paritiesList : List (List Wire)}

def frameTagged (tagCount : Nat) (rs : Rows) (x : Nat → Bool) (dim slot : Nat) (ph : Bool) : State :=
  ⟨ph,Matrix.basis rs x dim (CRTResidueThreshold.flags rs.size tagCount slot)⟩

def parityRow (paritiesList : List (List Wire)) (rs : Rows) (i : Nat) : Nat :=
  (paritySources paritiesList i).foldl (fun a q => a ^^^ Matrix.read rs q) 0

def correctionRows (width retained : Nat) (paritiesList : List (List Wire)) (rs : Rows) (slot : Nat) : Rows :=
  (List.range (width-retained)).foldl
    (fun a i => a.setIfInBounds (retained+i)
      (Matrix.read rs (retained+i) ^^^ (if i < slot-1 then parityRow paritiesList rs i else 0))) rs

theorem boundary_size (initial : Rows) (slot : Nat) :
    ((correctionRows width retained paritiesList) initial slot).size = initial.size := by
  let step := fun (r : Rows) i => r.setIfInBounds (retained+i)
    (Matrix.read initial (retained+i) ^^^ (if i < slot-1 then (parityRow paritiesList) initial i else 0))
  have sizes (todo : List Nat) (r : Rows) : (todo.foldl step r).size = r.size := by
    induction todo generalizing r with
    | nil => rfl
    | cons i tail ih =>
      simp only [List.foldl_cons,ih,step,Array.size_setIfInBounds]
  exact sizes (List.range (width-retained)) initial

private theorem parity_row_eval (rs : Rows) (word : Nat → Bool) (d slot : Nat) (ph : Bool)
    (xs : List Wire) (within : ∀ q ∈ xs, q < rs.size) (initial : Nat) :
    rowValue word (xs.foldl (fun z q => z ^^^ Matrix.read rs q) initial) d =
      (rowValue word initial d ^^ xorAt ((frameTagged tagCount) rs word d slot ph).basis xs) := by
  induction xs generalizing initial with
  | nil => simp [xorAt]
  | cons a tail ih =>
    have ha := within a (by simp)
    have ht : ∀ q ∈ tail, q < rs.size := fun q h => within q (List.mem_cons_of_mem _ h)
    simp only [List.foldl_cons,xorAt]
    rw [ih ht, rowValue_xor]
    simp only [frameTagged,Matrix.basis,if_pos ha,Bool.xor_assoc]

private theorem read_set_away (rs : Rows) (i j y : Nat) (away : i ≠ j) :
    Matrix.read (rs.setIfInBounds i y) j = Matrix.read rs j := by
  simp [Matrix.read,away]

private theorem parity_read_agree (a b : Rows) (i : Nat)
    (same : ∀ q ∈ (paritySources paritiesList) i, Matrix.read a q = Matrix.read b q) :
    (parityRow paritiesList) a i = (parityRow paritiesList) b i := by
  have eqFold (qs : List Wire) (z : Nat) (agree : ∀ q ∈ qs, Matrix.read a q = Matrix.read b q) :
      qs.foldl (fun x q => x ^^^ Matrix.read a q) z =
        qs.foldl (fun x q => x ^^^ Matrix.read b q) z := by
    induction qs generalizing z with
    | nil => rfl
    | cons q qs ih =>
      simp only [List.foldl_cons]
      rw [agree q (by simp)]
      exact ih _ (fun w h => agree w (List.mem_cons_of_mem _ h))
  exact eqFold _ 0 same

private theorem frame_set (rs : Rows) (x : Nat → Bool) (d slot q row : Nat) (ph : Bool)
    (hq : q < rs.size) :
    (frameTagged tagCount) (rs.setIfInBounds q row) x d slot ph =
      ⟨ph,writeBit ((frameTagged tagCount) rs x d slot ph).basis q (rowValue x row d)⟩ := by
  apply congrArg (State.mk ph)
  funext k
  by_cases eq : k = q
  · subst k
    simp [frameTagged,Matrix.basis,Matrix.read,writeBit,hq]
  · simp [frameTagged,Matrix.basis,Matrix.read,writeBit,
      Function.update_of_ne eq,Ne.symm eq]

private theorem selector_bounds (i : Nat) :
    ∀ k ∈ (CRTResidueThreshold.sites width tagCount) i, width ≤ k ∧ k < width+tagCount := by
  intro q hq
  obtain ⟨k,hk,rfl⟩ := List.mem_map.mp hq
  have lt := List.mem_range.mp (List.mem_of_mem_drop hk)
  exact ⟨Nat.le_add_right width k,Nat.add_lt_add_left lt width⟩

private theorem selector_parity (rs : Rows) (sz : rs.size = width)
    (slot : Fin (tagCount+1)) (i : Fin (width-retained)) (word : Nat → Bool) (d : Nat) (ph : Bool) :
    xorAt ((frameTagged tagCount) rs word d slot.val ph).basis ((CRTResidueThreshold.sites width tagCount) i.val) = decide (i.val < slot.val - 1) := by
  have agrees : ∀ k ∈ (CRTResidueThreshold.sites width tagCount) i.val,
      ((frameTagged tagCount) rs word d slot.val ph).basis k = (fun n => CRTResidueThreshold.flags n tagCount) width slot.val k := fun k hk => by
    have outside := Nat.not_lt.mpr (selector_bounds _ k hk).1
    simp [frameTagged,Matrix.basis,sz,outside]
  have same (xs : List Wire) (sameBits : ∀ k ∈ xs,
      ((frameTagged tagCount) rs word d slot.val ph).basis k = (fun n => CRTResidueThreshold.flags n tagCount) width slot.val k) :
      xorAt ((frameTagged tagCount) rs word d slot.val ph).basis xs = xorAt ((fun n => CRTResidueThreshold.flags n tagCount) width slot.val) xs := by
    induction xs with
    | nil => rfl
    | cons a t ih =>
      exact congrArg₂ Bool.xor (sameBits a (by simp))
        (ih (fun q h => sameBits q (List.mem_cons_of_mem _ h)))
  rw [same _ agrees]
  exact CRTResidueThreshold.hot width tagCount i.val slot.val slot.isLt


attribute [local irreducible] run

variable (bankRoom : retained < width) (scratchRoom : width+tagCount ≤ scratch)
  (parities : ∀ i : Fin (width-retained), ((paritySources paritiesList) i.val).Nodup ∧
    (paritySources paritiesList) i.val ≠ [] ∧ ∀ q ∈ (paritySources paritiesList) i.val, q < retained)

include bankRoom scratchRoom parities

private theorem correction_run (rs : Rows) (sz : rs.size = width) (slot : Fin (tagCount+1))
    (i : Fin (width-retained)) (mir : Bool) (word : Nat → Bool) (d : Nat) (ph : Bool) (tape : List Bool)
    (prepared : mir = true → Matrix.read rs (retained+i.val) =
      if i.val < slot.val-1 then (parityRow paritiesList) rs i.val else 0) :
    run ((pulseCorrection width retained tagCount scratch paritiesList) mir i.val) tape ((frameTagged tagCount) rs word d slot.val ph) =
      (frameTagged tagCount) (rs.setIfInBounds (retained+i.val)
        (Matrix.read rs (retained+i.val) ^^^
          (if i.val < slot.val-1 then (parityRow paritiesList) rs i.val else 0))) word d slot.val ph := by
  let q : Wire := retained+i.val
  let ps := (paritySources paritiesList) i.val
  let a : Wire := ps.headD 0
  let ts := (CRTResidueThreshold.sites width tagCount) i.val
  obtain ⟨nodup,nonempty,low⟩ := parities i
  change ps ≠ [] at nonempty
  have coords : ps = a :: ps.tail := by
    cases h : ps with
    | nil => exact False.elim (nonempty h)
    | cons u us => simp [a,h]
  have aqSites : a ∈ ps := by rw [coords]; simp
  have lowA : a < retained := low a aqSites
  have lowD : ∀ k ∈ ps.tail, k < retained := fun k h => low k (List.mem_of_mem_tail h)
  have tagB : ∀ k ∈ ts, width ≤ k ∧ k < width+tagCount := selector_bounds i.val
  have hi := i.isLt
  have qBound : q < rs.size := by
    rw [sz]
    change retained+i.val < width
    omega
  have aApart : a ≠ q :=
    Nat.ne_of_lt (Nat.lt_of_lt_of_le lowA (Nat.le_add_right retained i.val))
  have apartData : a ∉ ps.tail := by
    change ps.Nodup at nodup
    have fixed : (a :: ps.tail).Nodup := coords ▸ nodup
    exact (List.nodup_cons.mp fixed).1
  have clear : ((frameTagged tagCount) rs word d slot.val ph).basis scratch = false := by
    simp [frameTagged,Matrix.basis,CRTResidueThreshold.flags,sz,
      Nat.not_lt.mpr (by omega : width ≤ scratch),Nat.not_lt.mpr scratchRoom]
  have reg (k : Nat) (hk : k < rs.size) :
      ((frameTagged tagCount) rs word d slot.val ph).basis k = rowValue word (Matrix.read rs k) d := by
    simp [frameTagged,Matrix.basis,hk]
  have parity : (((frameTagged tagCount) rs word d slot.val ph).basis a ^^
      xorAt ((frameTagged tagCount) rs word d slot.val ph).basis ps.tail) = rowValue word ((parityRow paritiesList) rs i.val) d := by
    have inside : ∀ k ∈ ps, k < rs.size := fun k h => by
      rw [sz]
      exact Nat.lt_trans (low k h) bankRoom
    have check := parity_row_eval (tagCount := tagCount) rs word d slot.val ph ps inside 0
    rw [CRTBarrel.Field.rowValue_zero,Bool.false_xor] at check
    change rowValue word ((parityRow paritiesList) rs i.val) d = _ at check
    let bits := ((frameTagged tagCount) rs word d slot.val ph).basis
    have expose : xorAt bits ps = (bits a ^^ xorAt bits ps.tail) :=
      (congrArg (xorAt bits) coords).trans rfl
    exact expose.symm.trans check.symm
  have on := selector_parity (width := width) (retained := retained) (tagCount := tagCount) rs sz slot i word d ph
  have enables : (xorAt ((frameTagged tagCount) rs word d slot.val ph).basis ts &&
    (((frameTagged tagCount) rs word d slot.val ph).basis a ^^ xorAt ((frameTagged tagCount) rs word d slot.val ph).basis ps.tail)) =
      rowValue word (if i.val < slot.val-1 then (parityRow paritiesList) rs i.val else 0) d := by
    rw [on,parity]
    by_cases h : i.val < slot.val-1 <;> simp [h,CRTBarrel.Field.rowValue_zero]
  have prep : mir = true → ((frameTagged tagCount) rs word d slot.val ph).basis q =
      (xorAt ((frameTagged tagCount) rs word d slot.val ph).basis ts &&
         (((frameTagged tagCount) rs word d slot.val ph).basis a ^^ xorAt ((frameTagged tagCount) rs word d slot.val ph).basis ps.tail)) := by
    intro hm
    rw [reg q qBound,enables]
    exact congrArg (fun z => rowValue word z d) (prepared hm)
  have q31 : q < width := by simpa only [sz] using qBound
  have tq1 : (scratch : Wire) ≠ q := Nat.ne_of_gt (Nat.lt_of_lt_of_le q31 (by omega : width ≤ scratch))
  have ta1 : (scratch : Wire) ≠ a := Nat.ne_of_gt (Nat.lt_trans lowA (by omega : retained < scratch))
  have pulse := CRTResiduePulse.run_pulse ts ps.tail scratch a q mir ph
      ((frameTagged tagCount) rs word d slot.val ph).basis tape
      ta1 tq1 aApart
      (fun h => Nat.not_lt_of_ge scratchRoom (tagB scratch h).2)
      (fun h => Nat.not_lt_of_ge (tagB a h).1 (Nat.lt_trans lowA bankRoom))
      (fun h => Nat.not_lt_of_ge (tagB q h).1 q31)
      (fun h => Nat.not_lt_of_ge (by omega : retained ≤ scratch) (lowD scratch h))
      apartData (fun h => Nat.not_lt_of_ge (Nat.le_add_right retained i.val) (lowD q h))
      clear prep
  let bits := ((frameTagged tagCount) rs word d slot.val ph).basis
  let delta := if i.val < slot.val-1 then (parityRow paritiesList) rs i.val else 0
  let result (bit : Bool) := State.mk ph (writeBit bits q bit)
  have resultBit : (bits q ^^ (xorAt bits ts && (bits a ^^ xorAt bits ps.tail))) =
      rowValue word (Matrix.read rs q ^^^ delta) d :=
    (congrArg₂ Bool.xor (reg q qBound) enables).trans (rowValue_xor word (Matrix.read rs q) delta d).symm
  have stateEq := congrArg result resultBit
  have matrixEq := frame_set (tagCount := tagCount) rs word d slot.val q (Matrix.read rs q ^^^ delta) ph qBound
  exact pulse.trans (stateEq.trans matrixEq.symm)



theorem corrections_run (initial : Rows) (sz : initial.size = width) (slot : Fin (tagCount+1))
    (mir : Bool) (x : Nat → Bool) (d : Nat) (ph : Bool) (tape : List Bool)
    (prepared : mir = true → ∀ i : Fin (width-retained), Matrix.read initial (retained+i.val) =
      if i.val < slot.val-1 then (parityRow paritiesList) initial i.val else 0) :
    run ((correctionProgram width retained tagCount scratch paritiesList) mir) tape ((frameTagged tagCount) initial x d slot.val ph) =
      (frameTagged tagCount) ((correctionRows width retained paritiesList) initial slot.val) x d slot.val ph := by
  let update := fun (rs : Rows) (i : Nat) =>
    rs.setIfInBounds (retained+i)
      (Matrix.read initial (retained+i) ^^^
        if i < slot.val-1 then (parityRow paritiesList) initial i else 0)
  have go (xs : List Nat) (rs : Rows) (tape : List Bool) (nd : xs.Nodup)
      (bound : ∀ i ∈ xs, i < (width-retained)) (size : rs.size = width)
      (lower : ∀ q < retained, Matrix.read rs q = Matrix.read initial q)
      (upper : ∀ i ∈ xs, Matrix.read rs (retained+i) = Matrix.read initial (retained+i)) :
      run (xs.flatMap ((pulseCorrection width retained tagCount scratch paritiesList) mir)) tape ((frameTagged tagCount) rs x d slot.val ph) =
        (frameTagged tagCount) (xs.foldl update rs) x d slot.val ph := by
    induction xs generalizing rs tape with
    | nil => simp only [List.flatMap_nil,List.foldl_nil,run]
    | cons i todo ih =>
      have hi := bound i (by simp)
      have parity : (parityRow paritiesList) rs i = (parityRow paritiesList) initial i :=
        parity_read_agree (paritiesList := paritiesList) _ _ _ (fun q h => lower q ((parities ⟨i,hi⟩).2.2 _ h))
      have top := upper i (by simp)
      have correct := correction_run (paritiesList := paritiesList) bankRoom scratchRoom parities rs size slot ⟨i,hi⟩ mir x d ph tape
        (fun hm => by
          simpa only [top,parity] using prepared hm ⟨i,hi⟩)
      simp only [top,parity] at correct
      change run ((pulseCorrection width retained tagCount scratch paritiesList) mir i) tape ((frameTagged tagCount) rs x d slot.val ph) =
        (frameTagged tagCount) (update rs i) x d slot.val ph at correct
      simp only [List.flatMap_cons,List.foldl_cons,run_append,run_take]
      rw [correct]
      refine ih (update rs i) _ (List.nodup_cons.mp nd).2
        (fun k hk => bound k (List.mem_cons_of_mem _ hk)) (by simp [update,size]) ?_ ?_
      · intro q hq
        have sep : retained+i ≠ q := Nat.ne_of_gt (Nat.lt_of_lt_of_le hq (Nat.le_add_right retained i))
        simpa only [update,read_set_away _ _ _ _ sep] using lower q hq
      · intro j hj
        have away : i ≠ j := fun e => (List.nodup_cons.mp nd).1 (e ▸ hj)
        have sep : retained+i ≠ retained+j := fun e => away (Nat.add_left_cancel e)
        simpa only [update,read_set_away _ _ _ _ sep] using
          upper j (List.mem_cons_of_mem _ hj)
  exact go (List.range (width-retained)) initial tape List.nodup_range
    (fun _ h => List.mem_range.mp h) sz (fun _ _ => rfl) (fun _ _ => rfl)



end ECDSAAdd.Entrant.StairPacket.CRTResidueCorrection


namespace ECDSAAdd.Entrant.StairPacket.CRTResidueGroupedBasis
open CRTBarrel CRTBarrel.Matrix CRTBarrel.Packed

/-- Read the one packed pivot certificate as an equality of coordinate arrays. -/
theorem coordinates (n : Nat) (pivots : List (Nat × Nat)) (good : Good n pivots)
    (target : Rows) (size : target.size = n) (narrow : n ≤ width) (word : Nat)
    (receipt : pivots.zipIdx.reverse.foldl (quickStep n) (identityWord width n) = word)
    (rows : ∀ j : Fin n, digit width word j.val = Matrix.read target j.val) :
    applyOps (ops n pivots) (units n) = target := by
  have carry (xs : List ((Nat × Nat) × Nat)) (x : Nat) (r : Rows) (size : r.size = n)
      (agree : Matches x r)
      (good : ∀ v ∈ xs, v.2 < n ∧ v.1.2.testBit v.2 = false) :
      Matches (xs.foldl (quickStep n) x)
        (applyOps (xs.flatMap (fun (row,i) => (elimStep n i row).reverse)) r) := by
    induction xs generalizing x r with
    | nil => exact agree
    | cons v xs ih =>
      obtain ⟨⟨donor,mask⟩,i⟩ := v
      have use := good ((donor,mask),i) (by simp)
      rw [List.foldl_cons,List.flatMap_cons]
      unfold applyOps
      rw [List.foldl_append]
      change Matches (xs.foldl _ _) (applyOps _ (applyOps (elimStep n i (donor,mask)).reverse r))
      rw [backward_row n i donor mask r size use.2]
      apply ih _ _ ((pivotBack_size ..).trans size) _
        (fun v hv => good v (List.mem_cons_of_mem _ hv))
      rw [quickStep_eq]
      exact matches_step n x r ((donor,mask),i) size use.1 agree
  have base : Matches (identityWord width n) (units n) := by
    intro q hq
    have sq : q < n := by simpa [units] using hq
    simpa [units,Matrix.read,sq,identityWord] using (digit_units width n 0 q (by simpa using narrow) sq).symm
  have all (v : (Nat × Nat) × Nat) (hv : v ∈ pivots.zipIdx.reverse) :
      v.2 < n ∧ v.1.2.testBit v.2 = false :=
    ⟨(good v (List.mem_reverse.mp hv)).1,(good v (List.mem_reverse.mp hv)).2.2⟩
  have matched := carry pivots.zipIdx.reverse (identityWord width n) (units n) (by simp [units]) base all
  rw [receipt] at matched
  have matchOps : Matches word (applyOps (ops n pivots) (units n)) := by
    simpa only [ops,List.reverse_flatMap,Function.comp_def] using matched
  have os : (applyOps (ops n pivots) (units n)).size = n := by simp [units]
  apply Array.ext (os.trans size.symm)
  intro q ho ht
  have eq := (matchOps q ho).trans (rows ⟨q,os ▸ ho⟩)
  simpa only [Matrix.read,Array.getElem?_eq_getElem ho,Array.getElem?_eq_getElem ht,Option.getD_some] using eq

theorem encode (n dim k : Nat) (pivots : List (Nat × Nat)) (target : Rows)
    (receipt : applyOps (ops n pivots) (units n) = target) :
    applyOps (ops n pivots) (plain n dim k) = target.map (clipShift dim k) := by
  rw [plain,apply_map _ _ (clip_zero dim k) (clip_xor dim k),receipt]

end ECDSAAdd.Entrant.StairPacket.CRTResidueGroupedBasis

namespace ECDSAAdd.Entrant.StairPacket.CRTResidueCorrection
open CRTBarrel CRTBarrel.Matrix CRTBarrel.Packed

private theorem choose_read (rs : Rows) (D n q : Nat) (size : rs.size = n) (hq : q < n) :
    Matrix.read (keepPrefix rs D) q = if q < D then Matrix.read rs q else 0 :=
  read_keepPrefix rs D q (size ▸ hq)

private theorem read_set (rs : Rows) (q i row : Nat) (inside : i < rs.size) :
    Matrix.read (rs.setIfInBounds i row) q = if q=i then row else Matrix.read rs q := by
  by_cases same : q=i
  · subst q; simp [Matrix.read,inside]
  · simp [Matrix.read,same,Ne.symm same]

/-- Every lane is updated at most in its own quotient iteration. -/
theorem correctionRows_read (n D : Nat) (sources : List (List Nat)) (rs : Rows)
    (sz : rs.size = n) (slot q : Nat) (hq : q < n) :
    Matrix.read (correctionRows n D sources rs slot) q =
      if q < D then Matrix.read rs q else
        Matrix.read rs q ^^^ (if q-D < slot-1 then parityRow sources rs (q-D) else 0) := by
  let val := fun i => Matrix.read rs (D+i) ^^^ (if i < slot-1 then parityRow sources rs i else 0)
  let set := fun (r : Rows) i => r.setIfInBounds (D+i) (val i)
  have fold (xs : List Nat) (r : Rows) (size : r.size=n) (bound : ∀ i ∈ xs, D+i < n) :
      Matrix.read (xs.foldl set r) q =
        if D ≤ q ∧ q-D ∈ xs then val (q-D) else Matrix.read r q := by
    induction xs generalizing r with
    | nil => simp
    | cons i tail ih =>
      have valid : D+i < r.size := size ▸ bound i (by simp)
      have setSize : (set r i).size = n := by simp [set,size]
      rw [List.foldl_cons,ih (set r i) setSize (fun j h => bound j (List.mem_cons_of_mem _ h))]
      have changeRead := read_set r q (D+i) (val i) valid
      change Matrix.read (set r i) q = _ at changeRead
      rw [changeRead]
      by_cases head : q = D+i
      · subst q
        simp
      · have different : q-D ≠ i ∨ q < D := by omega
        rcases different with h | h
        · simp [head,h]
        · simp [head,Nat.not_le.mpr h]
  have result := fold (List.range (n-D)) rs sz (fun i hi => by have := List.mem_range.mp hi; omega)
  change Matrix.read (correctionRows n D sources rs slot) q = _ at result
  rw [result]
  by_cases low : q < D
  · simp [low,Nat.not_le.mpr low]
  · have within : D ≤ q ∧ q-D ∈ List.range (n-D) := ⟨by omega,List.mem_range.mpr (by omega)⟩
    simp [within,low,val,show D+(q-D)=q by omega]

private theorem foldl_congr_read (xs : List Nat) (r s : Rows) (acc : Nat)
    (same : ∀ q ∈ xs, Matrix.read r q = Matrix.read s q) :
    xs.foldl (fun a q => a ^^^ Matrix.read r q) acc =
      xs.foldl (fun a q => a ^^^ Matrix.read s q) acc := by
  induction xs generalizing acc with
  | nil => rfl
  | cons q tail ih =>
    rw [List.foldl_cons,List.foldl_cons,same q (by simp)]
    exact ih _ (fun j h => same j (List.mem_cons_of_mem _ h))

theorem parityRow_keepPrefix (rs : Rows) (D : Nat) (fits : D ≤ rs.size)
    (sources : List (List Nat)) (dim k i : Nat)
    (lower : ∀ q ∈ paritySources sources i, q < D) :
    parityRow sources (windowRows (keepPrefix rs D) dim k) i =
      parityRow sources (windowRows rs dim k) i := by
  unfold parityRow
  apply foldl_congr_read _ _ _ _
  intro q hq
  have inside : q < rs.size := Nat.lt_of_lt_of_le (lower q hq) fits
  rw [read_windowRows _ _ _ _ (by simpa only [keepPrefix_size] using inside),read_windowRows _ _ _ _ inside,
    read_keepPrefix _ _ _ inside,if_pos (lower q hq)]

private theorem clip_parityRow (rs : Rows) (sources : List (List Nat)) (dim k i : Nat)
    (fits : ∀ q ∈ paritySources sources i, q < rs.size) :
    clipShift dim k (parityRow sources rs i) = parityRow sources (windowRows rs dim k) i := by
  let xs := paritySources sources i
  have h := CRTResidueMasks.clip_parity k dim (xs.map (Matrix.read rs))
  rw [List.map_map,List.foldl_map,List.foldl_map] at h
  have left : clipShift dim k (parityRow sources rs i) =
      clipShift dim k (xs.foldl (fun a q => Nat.xor a (Matrix.read rs q)) 0) := rfl
  rw [left,h]
  unfold parityRow
  have replace (tail : List Nat) (acc : Nat) (ok : ∀ q ∈ tail, q < rs.size) :
      tail.foldl (fun a q => Nat.xor a (clipShift dim k (Matrix.read rs q))) acc =
        tail.foldl (fun a q => a ^^^ Matrix.read (windowRows rs dim k) q) acc := by
    induction tail generalizing acc with
    | nil => rfl
    | cons q t ih =>
      simp only [List.foldl_cons,read_windowRows _ _ _ _ (ok q (by simp))]
      exact ih _ (fun j hj => ok j (List.mem_cons_of_mem _ hj))
  exact replace xs 0 fits

/-- The quotient mask is enough to prove preparation for every selector. -/
theorem shifted_quotient (n D : Nat) (sources : List (List Nat)) (rs : Rows)
    (size : rs.size = n) (dim k : Nat) (fit : dim ≤ D) (i : Fin (n-D))
    (lower : ∀ q ∈ paritySources sources i, q < D)
    (empty : Matrix.read rs (D+i.val) &&& (2^(D+i.val)-1) = 0)
    (mask : Matrix.read rs (D+i.val) ^^^ parityRow sources rs i.val < 2^(i.val+1)) :
    Matrix.read (windowRows rs dim k) (D+i.val) =
      if i.val < k then parityRow sources (windowRows rs dim k) i.val else 0 := by
  rw [read_windowRows _ _ _ _ (by have := i.isLt; omega)]
  have h := CRTResidueMasks.admitted_quotient _ _ D i.val k dim fit empty mask
  have dimension : D ≤ n := Nat.le_of_lt (Nat.sub_pos_iff_lt.mp (Nat.zero_lt_of_lt i.isLt))
  have inside (q : Nat) (hq : q ∈ paritySources sources i) : q < rs.size := by
    rw [size]
    exact Nat.lt_of_lt_of_le (lower q hq) dimension
  exact h.trans (if_congr Iff.rfl (clip_parityRow rs sources dim k i.val inside) rfl)

private theorem of_read_eq (left right : Rows) (n : Nat) (ls : left.size=n) (rs : right.size=n)
    (readEq : ∀ q < n, Matrix.read left q = Matrix.read right q) : left = right := by
  apply Array.ext (ls.trans rs.symm)
  intro q hl hr
  simpa only [Matrix.read,Array.getElem?_eq_getElem hl,Array.getElem?_eq_getElem hr,Option.getD_some]
    using readEq q (ls ▸ hl)

/-- Closed support and parity tests of the encoded quotient rows. -/
def MaskOK (n D : Nat) (sources : List (List Nat)) (rs : Rows) : Prop :=
  ∀ i : Fin (n-D),
    (∀ q ∈ paritySources sources i, q < D) ∧
    Matrix.read rs (D+i.val) &&& (2^(D+i.val)-1) = 0 ∧
    Matrix.read rs (D+i.val) ^^^ parityRow sources rs i.val < 2^(i.val+1)

theorem unshifted_core (n D : Nat) (sources : List (List Nat)) (rs : Rows)
    (size : rs.size=n) (dim : Nat) (fit : dim ≤ D) (tested : MaskOK n D sources rs) :
    windowRows rs dim 0 = windowRows (keepPrefix rs D) dim 0 := by
  have inputSize := (windowRows_size rs dim 0).trans size
  have coreSize (k : Nat) := (windowRows_size (keepPrefix rs D) dim k).trans ((keepPrefix_size rs D).trans size)
  apply of_read_eq _ _ n inputSize (coreSize 0)
  intro q hq
  have inside : q < rs.size := size ▸ hq
  rw [read_windowRows (keepPrefix rs D) _ _ q (by simpa only [keepPrefix_size] using inside),
    choose_read rs D n q size hq]
  by_cases low : q < D
  · rw [if_pos low,read_windowRows _ _ _ _ inside]
  · let i : Fin (n-D) := ⟨q-D,by omega⟩
    obtain ⟨lower,empty,mask⟩ := tested i
    have pos : D+i.val = q := by dsimp [i]; omega
    rw [if_neg low,clip_zero,←pos]
    exact (shifted_quotient n D sources rs size dim 0 fit i lower empty mask).trans (if_neg (Nat.not_lt_zero _))

/-- Correction maps between the encoded shifted bank and its cleared-quotient frame. -/
theorem correction_boundary (n D : Nat) (sources : List (List Nat)) (rs : Rows)
    (size : rs.size=n) (fits : D ≤ n) (dim slot : Nat) (fit : dim ≤ D)
    (tested : MaskOK n D sources rs) :
    let k := slot-1
    (correctionRows n D sources (windowRows rs dim k) slot = windowRows (keepPrefix rs D) dim k) ∧
    (correctionRows n D sources (windowRows (keepPrefix rs D) dim k) slot = windowRows rs dim k) := by
  let k := slot-1
  let full := windowRows rs dim k
  let core := windowRows (keepPrefix rs D) dim k
  have fullSize : full.size = n := (windowRows_size ..).trans size
  have coreSize : core.size = n := (windowRows_size ..).trans ((keepPrefix_size ..).trans size)
  have parity_size : D ≤ rs.size := size ▸ fits
  have coreRead (q : Nat) (hq : q < n) : Matrix.read core q = if q < D then Matrix.read full q else 0 := by
    have inside : q < rs.size := size ▸ hq
    change Matrix.read (windowRows (keepPrefix rs D) dim k) q = _
    rw [read_windowRows (keepPrefix rs D) _ _ q (by simpa only [keepPrefix_size] using inside),
    choose_read rs D n q size hq]
    by_cases low : q < D
    · simp only [low,if_true,full,read_windowRows _ _ _ _ inside]
    · simp only [low,if_false,clip_zero]
  change correctionRows n D sources full slot = core ∧ correctionRows n D sources core slot = full
  have clean (q : Nat) (hq : q < n) (high : ¬ q < D) :
      Matrix.read full q = (if q-D < slot-1 then parityRow sources full (q-D) else 0) ∧
      parityRow sources core (q-D) = parityRow sources full (q-D) := by
    let i : Fin (n-D) := ⟨q-D,by omega⟩
    obtain ⟨lower,empty,mask⟩ := tested i
    have pos : D+i.val = q := by dsimp [i]; omega
    have probe := shifted_quotient n D sources rs size dim k fit i lower empty mask
    rw [pos] at probe
    exact ⟨probe, parityRow_keepPrefix rs D parity_size sources dim k i.val lower⟩
  constructor
  · have fs : (correctionRows n D sources full slot).size=n := (boundary_size ..).trans fullSize
    apply of_read_eq _ _ n fs coreSize
    intro q hq
    rw [correctionRows_read n D sources full fullSize slot q hq, coreRead q hq]
    by_cases low : q < D
    · rw [if_pos low,if_pos low]
    · rw [if_neg low,if_neg low,← (clean q hq low).1,Nat.xor_self]
  · have cs : (correctionRows n D sources core slot).size=n := (boundary_size ..).trans coreSize
    apply of_read_eq _ _ n cs fullSize
    intro q hq
    rw [correctionRows_read n D sources core coreSize slot q hq, coreRead q hq]
    by_cases low : q < D
    · rw [if_pos low,if_pos low]
    · rw [if_neg low,if_neg low,(clean q hq low).2,Nat.zero_xor]
      exact (clean q hq low).1.symm

theorem correction_zero (n D : Nat) (sources : List (List Nat)) (rs : Rows)
    (size : rs.size = n) (slot : Nat) (hz : slot ≤ 1) :
    correctionRows n D sources rs slot = rs := by
  have cs : (correctionRows n D sources rs slot).size = n := (boundary_size ..).trans size
  apply of_read_eq _ _ n cs size
  intro q hq
  rw [correctionRows_read n D sources rs size slot q hq]
  have hsub : slot - 1 = 0 := by omega
  rw [hsub]
  by_cases low : q < D
  · rw [if_pos low]
  · simp [low]

end ECDSAAdd.Entrant.StairPacket.CRTResidueCorrection




section
namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Entrant.StairPacket
open CRTBarrel CRTBarrel.Matrix
set_option maxRecDepth 30000
set_option maxHeartbeats 1200000

private theorem encoded_size_reusable : encodedRows.size = width := rfl

private theorem reusable_prefix :
    CRTBarrel.Packed.residueTable width encodedRows 0 factors = true := by
  decide +kernel

private theorem quotientMasksReusable : ∀ i : Fin 14,
    let sites := quotientParity.getD i.val []
    let q := CRTBarrel.Matrix.read encodedRows (17+i.val)
    let mix := sites.foldl (fun x j => x ^^^ CRTBarrel.Matrix.read encodedRows j) 0
    sites ≠ [] ∧ sites.Nodup ∧ (∀ j ∈ sites, j < 17) ∧
      q &&& (2^(17+i.val)-1) = 0 ∧ q ^^^ mix < 2^(i.val+1) := by
  decide +kernel

private theorem reusable_masks : CRTResidueCorrection.MaskOK width retained quotientParity encodedRows := by
  intro i
  have h := quotientMasksReusable i
  exact ⟨h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩

private theorem coded_as_window (slot k : Nat) :
    coded slot k = _root_.ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed.windowRows encodedRows (dim slot) k :=
  coded_fast slot k

private theorem boundary_as_correction (rs : Rows) (slot : Nat) :
    boundaryRows rs slot = CRTResidueCorrection.correctionRows width retained quotientParity rs slot := rfl

attribute [local irreducible] coded boundaryRows componentRows encodedRows in
private theorem reusable_row_motion (slot : Fin 17) :
    (boundaryRows (componentRows false slot.val 0 factors (coded slot.val 0)) slot.val =
      coded slot.val (slot.val-1)) ∧
    (componentRows true slot.val 0 factors (boundaryRows (coded slot.val (slot.val-1)) slot.val) =
      coded slot.val 0) := by
  let k := slot.val-1
  let d := dim slot.val
  let core (h : Nat) := _root_.ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed.windowRows (_root_.ECDSAAdd.Entrant.StairPacket.CRTBarrel.Packed.keepPrefix encodedRows retained) d h
  have size : encodedRows.size = width := encoded_size_reusable
  have inDim : d ≤ retained := Nat.min_le_left ..
  have fits : d ≤ width-k := Nat.min_le_right ..
  have factorExtent : CRTBarrel.Placement.extent factors = retained := by decide +kernel
  have retained_le : retained ≤ width := by decide
  have prefixF : componentRows false slot.val 0 factors (core 0) = core k :=
    CRTBarrel.Packed.componentRows_keepPrefix width d retained slot false
      encodedRows size (by decide) fits factors factorExtent retained_le reusable_prefix
  have prefixR : componentRows true slot.val 0 factors (core k) = core 0 :=
    CRTBarrel.Packed.componentRows_keepPrefix width d retained slot true
      encodedRows size (by decide) fits factors factorExtent retained_le reusable_prefix
  have inlet : coded slot.val 0 = core 0 :=
    (coded_as_window slot.val 0).trans
      (CRTResidueCorrection.unshifted_core width retained quotientParity encodedRows size d inDim reusable_masks)
  have boundary := CRTResidueCorrection.correction_boundary width retained quotientParity encodedRows
    size retained_le d slot.val inDim reusable_masks
  have cleared : boundaryRows (coded slot.val k) slot.val = core k := by
    rw [boundary_as_correction, coded_as_window]
    exact boundary.1
  have filled : boundaryRows (core k) slot.val = coded slot.val k := by
    rw [boundary_as_correction, coded_as_window]
    exact boundary.2
  have stepF := congrArg (fun r => boundaryRows (componentRows false slot.val 0 factors r) slot.val) inlet
  have scalarF := congrArg (fun r => boundaryRows r slot.val) prefixF
  have stepR := congrArg (componentRows true slot.val 0 factors) cleared
  exact ⟨stepF.trans (scalarF.trans filled), stepR.trans (prefixR.trans inlet.symm)⟩

theorem forward_rows_export (slot : Fin 17) :
    boundaryRows (componentRows false slot.val 0 factors (coded slot.val 0)) slot.val =
      coded slot.val (slot.val-1) :=
  (reusable_row_motion slot).1

theorem reverse_rows_export (slot : Fin 17) :
    componentRows true slot.val 0 factors (boundaryRows (coded slot.val (slot.val-1)) slot.val) =
      coded slot.val 0 :=
  (reusable_row_motion slot).2
end ECDSAAdd.Entrant.StairPacket.CRTResidueS45
end

namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open Arithmetic CRTBarrel CRTBarrel.Matrix
set_option maxHeartbeats 100000
attribute [local irreducible] run frame components componentRows CRTResidueS45.coded
  CRTBarrel.plain corrections boundaryRows cnotProgram

def residueFrame (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (rows : Rows) : State :=
  frame rows x (dim slot.val) slot.val ph

private theorem run_four (a b c d : Program) (s0 s1 s2 s3 s4 : State)
    (tape : List Bool) (ha : ∀ m, run a m s0 = s1) (hb : ∀ m, run b m s1 = s2)
    (hc : ∀ m, run c m s2 = s3) (hd : ∀ m, run d m s3 = s4) :
    run (a ++ (b ++ (c ++ d))) tape s0 = s4 := by
  simp only [run_append,ha,hb,hc,hd]

private theorem forward_rows (slot : Fin 17) :
    boundaryRows (componentRows false slot.val 0 factors (coded slot.val 0)) slot.val =
      coded slot.val (slot.val-1) :=
  forward_rows_export slot


private theorem forward_program :
    logicalResidue false =
      cnotProgram encoding ++ (components width false 0 factors ++
        (corrections false ++ (cnotProgram encoding).reverse)) := by
  simp only [logicalResidue,cnotProgram,Bool.false_eq_true,if_false,List.append_assoc]


theorem logical_forward_stages (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (tape : List Bool)
    (encode : ∀ m, run (cnotProgram encoding) m
      (residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) 0)) =
      residueFrame slot x ph (coded slot.val 0))
    (scalar : ∀ m, run (components width false 0 factors) m (residueFrame slot x ph (coded slot.val 0)) =
      residueFrame slot x ph (componentRows false slot.val 0 factors (coded slot.val 0)))
    (correct : ∀ m, run (corrections false) m
      (residueFrame slot x ph (componentRows false slot.val 0 factors (coded slot.val 0))) =
      residueFrame slot x ph (boundaryRows (componentRows false slot.val 0 factors (coded slot.val 0)) slot.val))
    (decode : ∀ m, run (cnotProgram encoding).reverse m
      (residueFrame slot x ph (coded slot.val (slot.val-1))) =
      residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) (slot.val-1))) :
    run (logicalResidue false) tape (residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) 0)) =
      residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) (slot.val-1)) := by
  have corrected (m : List Bool) := (correct m).trans (congrArg (residueFrame slot x ph) (forward_rows slot))
  have stages := run_four _ _ _ _ _ _ _ _ _ tape encode scalar corrected decode
  have shape := congrArg (fun p =>
    run p tape (residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) 0))) forward_program
  exact shape.trans stages


private theorem reverse_program :
    logicalResidue true =
      cnotProgram encoding ++ (corrections true ++
        (components width true 0 factors ++ (cnotProgram encoding).reverse)) := by
  simp only [logicalResidue,cnotProgram,if_true,List.append_assoc]


theorem logical_reverse_stages (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (tape : List Bool)
    (encode : ∀ m, run (cnotProgram encoding) m
      (residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) (slot.val-1))) =
      residueFrame slot x ph (coded slot.val (slot.val-1)))
    (correct : ∀ m, run (corrections true) m (residueFrame slot x ph (coded slot.val (slot.val-1))) =
      residueFrame slot x ph (boundaryRows (coded slot.val (slot.val-1)) slot.val))
    (scalar : ∀ m, run (components width true 0 factors) m
      (residueFrame slot x ph (boundaryRows (coded slot.val (slot.val-1)) slot.val)) =
      residueFrame slot x ph (componentRows true slot.val 0 factors (boundaryRows (coded slot.val (slot.val-1)) slot.val)))
    (decode : ∀ m, run (cnotProgram encoding).reverse m (residueFrame slot x ph (coded slot.val 0)) =
      residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) 0)) :
    run (logicalResidue true) tape (residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) (slot.val-1))) =
      residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) 0) := by
  have reduced (m : List Bool) := (scalar m).trans (congrArg (residueFrame slot x ph) (reverse_rows_export slot))
  have stages := run_four _ _ _ _ _ _ _ _ _ tape encode correct reduced decode
  have shape := congrArg (fun p =>
    run p tape (residueFrame slot x ph (CRTBarrel.plain width (dim slot.val) (slot.val-1)))) reverse_program
  exact shape.trans stages


end ECDSAAdd.Entrant.StairPacket.CRTResidueS45

section
open ECDSAAdd ECDSAAdd.Entrant ECDSAAdd.Entrant.StairPacket
namespace ECDSAAdd.Entrant.StairPacket.CRTResidueS45
open Arithmetic CRTBarrel CRTBarrel.Matrix
attribute [local irreducible] run frame components componentRows CRTResidueS45.coded
  CRTBarrel.plain corrections boundaryRows cnotProgram
theorem logical_run (slot : Fin 17) (mir : Bool) (x : Nat → Bool)
    (ph : Bool) (tape : List Bool) :
    run (logicalResidue mir) tape (frame (CRTBarrel.plain width (dim slot.val) (entryShift mir slot.val))
      x (dim slot.val) slot.val ph) =
      frame (CRTBarrel.plain width (dim slot.val) (exitShift mir slot.val))
        x (dim slot.val) slot.val ph := by
  let k := slot.val - 1
  let unshifted := coded slot.val 0
  let shifted := coded slot.val k
  have uSize : unshifted.size = width := coded_size slot.val 0
  have sSize : shifted.size = width := coded_size slot.val k
  cases mir
  · have enters : entryShift false slot.val = 0 := rfl
    have exits : exitShift false slot.val = k := rfl
    rw [enters,exits]
    let core := componentRows false slot.val 0 factors unshifted
    have coreSize : core.size = width := (componentRows_size ..).trans uSize
    exact logical_forward_stages slot x ph tape (encode_run slot 0 x ph)
      (fields_run unshifted uSize false slot (dim slot.val) x ph)
      (fun m => corrections_run core coreSize slot false x (dim slot.val) ph m (by
        intro impossible
        cases impossible))
      (decode_run slot k x ph)
  · have enters : entryShift true slot.val = k := rfl
    have exits : exitShift true slot.val = 0 := rfl
    rw [enters,exits]
    let clear := boundaryRows shifted slot.val
    have clearSize : clear.size = width := (boundary_size ..).trans sSize
    exact logical_reverse_stages slot x ph tape (encode_run slot k x ph)
      (fun t => corrections_run shifted sSize slot true x (dim slot.val) ph t
        (fun _ => reversePrepared slot))
      (fields_run clear clearSize true slot (dim slot.val) x ph)
      (decode_run slot 0 x ph)
end ECDSAAdd.Entrant.StairPacket.CRTResidueS45
