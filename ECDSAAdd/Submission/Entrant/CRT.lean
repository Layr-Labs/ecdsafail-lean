private theorem layer_read (slot : Fin 17) (done q : Nat) (h : q < 46) :
    read (layer slot done) q =
      if q < 44 ∨ q - 44 < done then clip slot (shift slot) q else raised slot (q - 44) := by
  simp [layer, Matrix.read, h]

private theorem layer_done (slot : Fin 17) : layer slot 2 = coded slot (shift slot) := by
  apply Array.ext (by simp)
  intro q hq hc
  have inBank : q < 46 := by simpa only [layer_size] using hq
  have done : q < 44 ∨ q - 44 < 2 := Or.inr (by omega)
  have eq := (layer_read slot 2 q inBank).trans (by simp only [if_pos done]; exact (coded_read slot _ q inBank).symm)
  simpa only [Matrix.read, Array.getElem?_eq_getElem hq, Array.getElem?_eq_getElem hc, Option.getD_some] using eq

