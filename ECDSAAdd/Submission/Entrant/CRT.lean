namespace ECDSAAdd.Entrant.StairPacket.Shadow20
open ECDSAAdd.Arithmetic ECDSAAdd.Arithmetic.MappedCompressed ECDSAAdd.Entrant.IntegerPacket
open ECDSAAdd.Entrant.StairPacket ECDSAAdd.Entrant.StairPacket.Partial ECDSAAdd.Entrant.StairPacket.GateMirror
open ECDSAAdd.Baselines ECDSAAdd.Challenge

theorem place20_inj (j : Fin 9) :
    ∀ a < liveW20 (start20 j) + 31, ∀ b < liveW20 (start20 j) + 31,
      place20 (start20 j) a = place20 (start20 j) b → a = b := by
  have hg := geom20_facts j
  have hbt : bTopP (start20 j) ≤ 1043 := by unfold bTopP railP; split_ifs <;> omega
  have hscr : ∀ k < 10, poolW20 (start20 j) (22 + k) = 1625 + k := by
    intro k hk; unfold poolW20; rw [if_pos (by omega)]; unfold Wire; omega
  have hbank_rng : ∀ i < liveW20 (start20 j),
      (1662 ≤ bankW20 (start20 j) i ∧ bankW20 (start20 j) i ≤ 1744) ∨
      (870 ≤ bankW20 (start20 j) i ∧ bankW20 (start20 j) i ≤ 1043) ∨
      (1603 ≤ bankW20 (start20 j) i ∧ bankW20 (start20 j) i ≤ 1622) := by
    intro i hi
    rcases bank20_cases j (i := i) (by omega) with ⟨_, e⟩ | ⟨_, _, e, _, _⟩ | ⟨_, e, _, _⟩
    · left; rw [e]; unfold Wire at *; omega
    · right; left; have hb0 : b0P20 (start20 j) = 787 + sbP20 (start20 j) := rfl; unfold Wire at *; omega
    · right; right; unfold Wire at *; omega
  intro a ha b hb eq
  unfold place20 at eq
  by_cases ha1 : a < liveW20 (start20 j) <;> by_cases hb1 : b < liveW20 (start20 j)
  · simp only [ha1, hb1, if_true] at eq
    exact bank20_inj j (by omega) (by omega) eq
  · simp only [ha1, hb1, if_true, if_false] at eq
    have ba := hbank_rng a ha1
    by_cases hb2 : b < liveW20 (start20 j) + 21
    · rw [if_pos hb2] at eq
      have tb := tagsP20_getD_range (k := b - liveW20 (start20 j)) (by omega)
      unfold Wire at *; omega
    · rw [if_neg hb2, hscr (b - liveW20 (start20 j) - 21) (by omega)] at eq
      unfold Wire at *; omega
  · simp only [ha1, hb1, if_true, if_false] at eq
    have bb := hbank_rng b hb1
    by_cases ha2 : a < liveW20 (start20 j) + 21
    · rw [if_pos ha2] at eq
      have ta := tagsP20_getD_range (k := a - liveW20 (start20 j)) (by omega)
      unfold Wire at *; omega
    · rw [if_neg ha2, hscr (a - liveW20 (start20 j) - 21) (by omega)] at eq
      unfold Wire at *; omega
  · simp only [ha1, hb1, if_false] at eq
    by_cases ha2 : a < liveW20 (start20 j) + 21 <;> by_cases hb2 : b < liveW20 (start20 j) + 21
    · simp only [ha2, hb2, if_true] at eq
      have := tagsP20_inj (a := a - liveW20 (start20 j)) (b := b - liveW20 (start20 j)) (by omega) (by omega) eq
      omega
    · simp only [ha2, hb2, if_true, if_false] at eq
      have ta := tagsP20_getD_range (k := a - liveW20 (start20 j)) (by omega)
      rw [hscr (b - liveW20 (start20 j) - 21) (by omega)] at eq
      unfold Wire at *; omega
    · simp only [ha2, hb2, if_true, if_false] at eq
      have tb := tagsP20_getD_range (k := b - liveW20 (start20 j)) (by omega)
      rw [hscr (a - liveW20 (start20 j) - 21) (by omega)] at eq
      unfold Wire at *; omega
    · simp only [ha2, hb2, if_false] at eq
      rw [hscr (a - liveW20 (start20 j) - 21) (by omega), hscr (b - liveW20 (start20 j) - 21) (by omega)] at eq
      unfold Wire at *; omega
end ECDSAAdd.Entrant.StairPacket.Shadow20

section
set_option maxRecDepth 30000
set_option maxHeartbeats 4000000

namespace ECDSAAdd.Entrant.StairPacket.CRTBarrel20.Packed20

open Matrix20

private theorem clip_twice (dim k value : Nat) :
    clipShift dim 0 (clipShift dim k value) = clipShift dim k value := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [clipShift,Nat.testBit_shiftRight,Nat.zero_add,Nat.testBit_and]
  cases (2^dim-1).testBit i <;> simp

/-- Apply the checked prototype prefix to split coordinates. The high rows use
shift zero in both directions and are preserved by the scalar. -/
theorem componentRows_split (n D dim : Nat) (slot : Fin 22) (mir : Bool)
    (rs input output : Rows) (size : rs.size = n) (inputSize : input.size = n) (outputSize : output.size = n)
    (high : n ≤ 135) (fit : dim ≤ n-(slot.val-1)) (bound : D ≤ n)
    (parts : List (Nat × Nat)) (extent_eq : extent20 parts = D)
    (table : residueTable n rs 0 parts = true)
    (inputSpec : ∀ q < n, read input q = clipShift dim (if q < D then entryShift mir slot.val else 0) (read rs q))
    (outputSpec : ∀ q < n, read output q = clipShift dim (if q < D then exitShift mir slot.val else 0) (read rs q)) :
    componentRows20 mir slot.val 0 parts input = output := by
  let src := residueWord input dim 0
  let originalSrc := residueWord rs dim (entryShift mir slot.val)
  let originalDst := residueWord rs dim (exitShift mir slot.val)
  have room : dim ≤ width := by unfold width; omega
  have matched : Matches src input := by
    intro q hq
    have inside : q < n := inputSize ▸ hq
    change read input q = digit width (residueWord input dim 0) q
    rw [residue_word_digit input dim 0 q room hq,inputSpec q inside,clip_twice]
  have front (q : Nat) (low : q < D) : digit width src q = digit width originalSrc q := by
    have inside : q < n := lt_of_lt_of_le low bound
    have old := residue_word_digit rs dim (entryShift mir slot.val) q room (size.symm ▸ inside)
    have current := matched q (inputSize.symm ▸ inside)
    rw [inputSpec q inside,if_pos low] at current
    exact current.symm.trans old.symm
  have align (ps : List (Nat × Nat)) (off : Nat) (endp : off + extent20 ps ≤ D)
      (old : PrefixAligned dim slot.val mir originalSrc originalDst off ps) :
      PrefixAligned dim slot.val mir src originalDst off ps := by
    induction ps generalizing off with
    | nil => exact True.intro
    | cons pair tail ih =>
      obtain ⟨p,m⟩ := pair
      change off+(fieldDegree p*m+extent20 tail) ≤ D at endp
      obtain ⟨use,readIn,readOut,more⟩ := old
      refine ⟨use,?_,readOut,ih (off+fieldDegree p*m) (by omega) more⟩
      intro j hj
      exact (front (off+j) (by omega)).trans (readIn j hj)
  have original : PrefixAligned dim slot.val mir originalSrc originalDst 0 parts :=
    residue_table_aligned n dim slot mir rs size high fit parts 0 (by rw [Nat.zero_add,extent_eq]; exact bound) table
  have aligned := align parts 0
    (by simpa only [Nat.zero_add,extent_eq] using (Nat.le_refl D)) original
  let actual := componentRows20 mir slot.val 0 parts input
  have actualSize : actual.size = n := (componentRows20_size ..).trans inputSize
  have agree : Matches (componentWord20 n mir slot.val 0 parts src) actual :=
    components20_match n src 0 slot.val mir parts input inputSize
      (by rw [Nat.zero_add,extent_eq]; exact bound) matched
  change actual = output
  apply Array.ext (actualSize.trans outputSize.symm)
  intro q ha ho
  have inside : q < n := actualSize ▸ ha
  have readEq : read actual q = read output q := by
    rw [agree q ha,prefix_action n dim slot mir src originalDst parts aligned q,extent_eq,outputSpec q inside]
    by_cases low : q < D
    · simp only [if_pos low]
      exact residue_word_digit rs dim (exitShift mir slot.val) q room (size.symm ▸ inside)
    · simp only [if_neg low]
      rw [← matched q (inputSize.symm ▸ inside),inputSpec q inside,if_neg low]
  simpa only [Matrix20.read,Array.getElem?_eq_getElem ha,Array.getElem?_eq_getElem ho,Option.getD_some] using readEq

end ECDSAAdd.Entrant.StairPacket.CRTBarrel20.Packed20


namespace ECDSAAdd.Entrant.StairPacket.CRTBarrel20
open ECDSAAdd.RecordedQuantum

theorem lateResidueFits {bound : Nat} {program : Program}
    (checked : (program.all fun i =>
      CRTBarrel.Placement.physicalBit i && decide (∀ q ∈ i.wires, q < bound)) = true) :
    Fits (· < bound) program := by
  intro i hi
  have ok := List.all_eq_true.mp checked i hi
  simp only [Bool.and_eq_true] at ok
  obtain ⟨physical, cover⟩ := ok
  refine ⟨?_, of_decide_eq_true cover⟩
  cases i <;> simp_all [CRTBarrel.Placement.physicalBit, PhysicalInstr, ProperGate]

end ECDSAAdd.Entrant.StairPacket.CRTBarrel20

