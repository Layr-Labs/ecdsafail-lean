      have right := digits_source n off p m b valid low high ks.2 (sz _) endHead rows
      have before : Slice crop off len bank bank (prototypeWord p m a) := by
        refine ⟨?_,fun _ _ => rfl⟩
        intro j hj
        rw [inv _ (by omega),if_neg (by omega)]
        exact left j hj
      have after := primary_slice crop (clip_zero n 0) (clip_xor n 0) n off p m slot.val bank bank _ mir before
      have expected : primaryWord len (prototypeWord p m a) 0 p m slot.val mir = prototypeWord p m b :=
