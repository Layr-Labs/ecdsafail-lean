theorem work_T_geometry :
    workTA.length = 32 ∧ workTA.Nodup ∧
    workTB.length = 32 ∧ workTB.Nodup ∧
    workTC.length = 34 ∧ workTC.Nodup ∧
    efSwapB.length = 20 ∧
