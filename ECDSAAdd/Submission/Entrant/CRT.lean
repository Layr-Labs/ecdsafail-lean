private def reversePivot (row : Nat × Nat) (i : Nat) : List (Wire × Wire) :=
  (if row.1 = i then [] else [(i,row.1),(row.1,i),(i,row.1)]) ++
    (selected 69 row.2).map (fun q => (i,q))

def outerOps : List (Wire × Wire) :=
  (pivotPlan.zipIdx.flatMap (fun (row,i) => reversePivot row i)).reverse

/-- Supply this equality from a packed receipt for the same gate order. -/
abbrev BasisCertificate : Prop := applyOps outerOps (units 69) = outerRows

abbrev BasisBounds : Prop :=
  ∀ pair ∈ outerOps, pair.1 < 69 ∧ pair.2 < 69 ∧ pair.1 ≠ pair.2

private abbrev shift (slot : Fin 17) : Nat := slot.val - 1
private abbrev dim (slot : Fin 17) : Nat := 69 - shift slot
private abbrev clip (slot : Fin 17) (k q : Nat) : Nat :=
  clipShift (dim slot) k (read outerRows q)

private def coded (slot : Fin 17) (k : Nat) : Rows :=
  outerRows.map (clipShift (dim slot) k)

private def scalarFrame (slot : Fin 17) : Rows :=
  Array.ofFn (fun q : Fin 69 => clip slot (if q.val < 66 then shift slot else 0) q.val)

/-- The shared wide primary action supplies these exact row equalities. -/
abbrev ScalarAction : Prop := ∀ slot : Fin 17,
  componentRows false slot.val 0 factors (coded slot 0) = scalarFrame slot ∧
  componentRows true slot.val 0 factors (scalarFrame slot) = coded slot 0

def logical (mirror : Bool) : Program :=
  cnotProgram outerOps ++ middle mirror ++ (cnotProgram outerOps).reverse

abbrev CoordinateAction : Prop := BasisCertificate → BasisBounds → ScalarAction →
  ∀ (slot : Fin 17) (mirror : Bool) (x : Nat → Bool) (ph : Bool) (t : List Bool),
