open CRTBarrel.Packed

private theorem outer_size : outerRows.size = 69 := rfl

private theorem coded_size (slot : Fin 17) : (coded slot 0).size = 69 := by
  simp [coded,outer_size]

private theorem scalar_size (slot : Fin 17) : (scalarFrame slot).size = 69 := by
  simp [scalarFrame]

private theorem coded_read (slot : Fin 17) (q : Nat) (low : q < 69) :
    read (coded slot 0) q = clip slot 0 q := by
  simp [coded,clip,Matrix.read,outer_size,low]

private theorem scalar_read (slot : Fin 17) (q : Nat) (low : q < 69) :
    read (scalarFrame slot) q = clip slot (if q < 66 then shift slot else 0) q := by
  simp [scalarFrame,Matrix.read,low]

set_option maxRecDepth 5000 in
private theorem prefix_table : residueTable 69 outerRows 0 factors = true := by
  decide +kernel

private theorem extent : extent factors = 66 := by decide +kernel

private theorem scalar_direction (slot : Fin 17) (mirror : Bool) :
    let input := if mirror then scalarFrame slot else coded slot 0
    let output := if mirror then coded slot 0 else scalarFrame slot
    componentRows mirror slot.val 0 factors input = output := by
  intro input output
  have inputSize : input.size = 69 := by cases mirror <;> simp [input,coded_size,scalar_size]
  have outputSize : output.size = 69 := by cases mirror <;> simp [output,coded_size,scalar_size]
  apply componentRows_split 69 66 (dim slot) slot mirror outerRows input output outer_size
    inputSize outputSize (by decide) (Nat.le_refl _) (by decide) factors extent prefix_table
  · intro q hq
    cases mirror
    · simpa [input,entryShift] using coded_read slot q hq
    · exact scalar_read slot q hq
  · intro q hq
    cases mirror
    · exact scalar_read slot q hq
    · simpa [output,exitShift] using coded_read slot q hq

theorem scalar_action : ScalarAction := fun slot =>
  ⟨scalar_direction slot false,scalar_direction slot true⟩

end ScalarPremise

theorem basis_bounds : BasisBounds := by
  intro pair hp
  obtain ⟨⟨⟨j,mask⟩,i⟩,listed,step⟩ := List.mem_flatMap.mp (List.mem_reverse.mp hp)
  have ⟨hj,hi,clear⟩ := pivot_bounds _ listed
  change pair ∈ (if j = i then [] else [(i,j),(j,i),(i,j)]) ++
    (selected 69 mask).map (fun q => (i,q)) at step
  rcases List.mem_append.mp step with swap | spill
  · by_cases same : j = i
    · simp [same] at swap
    · simp only [if_neg same, List.mem_cons, List.not_mem_nil, or_false] at swap
      rcases swap with rfl | rfl | rfl
      · exact ⟨hi,hj,Ne.symm same⟩
      · exact ⟨hj,hi,same⟩
      · exact ⟨hi,hj,Ne.symm same⟩
  · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp spill
    change q ∈ (List.range 69).filter mask.testBit at hq
    obtain ⟨within,bit⟩ := List.mem_filter.mp hq
    refine ⟨hi,List.mem_range.mp within,?_⟩
    intro eq
    change i = q at eq
    subst q
    change mask.testBit i = false at clear
    simp [clear] at bit

private theorem append_scope {p q : Program}
    (hp : wires p ⊆ Finset.range 95) (hq : wires q ⊆ Finset.range 95) :
    wires (p ++ q) ⊆ Finset.range 95 := by
  rw [wires_append]
  exact Finset.union_subset hp hq

private theorem cnot_scope (pairs : List (Wire × Wire))
    (bounds : ∀ pair ∈ pairs, pair.1 < 69 ∧ pair.2 < 69 ∧ pair.1 ≠ pair.2) :
    wires (cnotProgram pairs) ⊆ Finset.range 95 := by
  have fits : Fits (· < 95) (cnotProgram pairs) := by
    intro gate hg
    obtain ⟨⟨a,b⟩,hpair,rfl⟩ := List.mem_map.mp hg
    obtain ⟨ha,hb,sep⟩ := bounds (a,b) hpair
    refine ⟨sep,?_⟩
    intro q hq
    simp only [Instr.wires,Finset.mem_insert,Finset.mem_singleton] at hq
    rcases hq with rfl | rfl
    · exact Nat.lt_trans ha (by decide : 69 < 95)
    · exact Nat.lt_trans hb (by decide : 69 < 95)
  exact fun q hq => Finset.mem_range.mpr (CRTBarrel.Placement.support fits q hq)

private theorem basis_scope : wires (cnotProgram outerOps) ⊆ Finset.range 95 :=
  cnot_scope outerOps basis_bounds

private theorem factors_used : ∀ pair ∈ factors, UsedField pair.1 := by
  intro pair hp
  unfold UsedField
  simp only [factors, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

private theorem scalar_scope (mirror : Bool) : wires (components 69 mirror 0 factors) ⊆ Finset.range 95 := by
  have fits := CRTBarrel.components_fits 69 mirror 0 factors (by decide +kernel) factors_used
  exact fun q hq => Finset.mem_range.mpr (CRTBarrel.Placement.support fits q hq)

private theorem shift_scope (mirror : Bool) : wires (shiftProgram mirror) ⊆ Finset.range 95 := by
  cases mirror <;> decide +kernel

