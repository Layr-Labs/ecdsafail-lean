private theorem layer_parity (slot : Fin 17) (x : Nat → Bool) (ph : Bool) (done : Nat) (i : Fin 4) :
    CRTBarrel.xorAt (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis (taps i) =
      rowValue x (clipShift (dim slot) (shift slot) (parityRow i)) (dim slot) := by
  have eval (xs : List Wire) (low : ∀ q ∈ xs, q < 72) :
      CRTBarrel.xorAt (CRTBarrel.frame (layer slot done) x (dim slot) slot.val ph).basis xs =
        rowValue x (clipShift (dim slot) (shift slot) (xs.foldr (fun q z => read outerRows q ^^^ z) 0)) (dim slot) := by
    induction xs with
    | nil => simp [CRTBarrel.xorAt, clip_zero, CRTBarrel.Field.rowValue_zero]
    | cons q qs ih =>
      have hlow : q < (72 : Nat) := low q (by simp)
      have hbank : q < (76 : Nat) := Nat.lt_trans hlow (by decide : 72 < 76)
      rw [CRTBarrel.xorAt, List.foldr_cons, clip_xor, rowValue_xor, ih (fun r hr => low r (List.mem_cons_of_mem _ hr))]
      simp only [CRTBarrel.frame, Matrix.basis, layer_size, if_pos hbank, layer_read slot done q hbank,
        if_pos (Or.inl hlow)]
