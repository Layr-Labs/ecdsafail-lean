  let current := if mirror then i.val + 1 else i.val
  let next := if mirror then i.val else i.val + 1
  have target : dest i = 72 + i.val := rfl
  apply State.extensionality
  · rfl
  · funext q
    by_cases hit : q = dest i
    · subst q
      have bank : dest i < 76 := Nat.add_lt_add_left i.isLt 72
      have low : ¬ dest i < 72 := Nat.not_lt_of_ge (Nat.le_add_right 72 i.val)
      have index : dest i - 72 = i.val := Nat.add_sub_cancel_left 72 i.val
