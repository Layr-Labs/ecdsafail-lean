import ECDSAAdd.Arithmetic.Paper935.Repack

namespace ECDSAAdd.Arithmetic.Paper935

/-- Public metadata retirement. This is not a reset; `planMove_sound` proves
that the compiled physical move makes the corresponding release legal. -/
def Arena.retire (A : Arena) (old : Wire) : Arena :=
  ⟨A.live\{old},Finset.Subset.trans Finset.sdiff_subset A.bounded⟩

/-- Requests and allocation choices are public compiler data, independent of
basis values. A missing source or exhausted destination bands fail explicitly. -/
def planMove (A : Arena) (old : Wire) (pools : List (Finset Wire)) :
    Option (Arena × Wire) :=
  if old∈A.live then
    (A.borrowFirst pools).map fun r => (r.1.retire old,r.2)
  else none

theorem planMove_sound (A B : Arena) (old fresh : Wire) (pools : List (Finset Wire))
    (h : planMove A old pools=some (B,fresh)) :
    old≠fresh ∧ old∈arenaWires ∧ fresh∈arenaWires ∧
    ∃ during, A.borrowFirst pools=some (during,fresh) ∧
      wires (rehome old fresh)⊆during.live ∧ during.live.card≤935 ∧
      ∀ s m, A.Ready s.basis →
        during.release {old} (run (rehome old fresh) m s).basis=some B ∧
        B.Ready (run (rehome old fresh) m s).basis := by
  unfold planMove at h
  split at h
  next ho =>
    cases hb : A.borrowFirst pools with
    | none => simp [hb] at h
    | some r =>
      rcases r with ⟨during,q⟩
      simp only [hb,Option.map_some,Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      obtain ⟨pool,_,hp⟩ := A.borrowFirst_contract during pools q hb
      have hc := A.borrowFrom_contract during pool q hp
      have hn : old≠q := fun he => hc.2.1 (he ▸ ho)
      have hv := (A.reserve_success {q}).mp ⟨during,hc.2.2⟩
      have hd : during.live=A.live∪{q} := by
        have hh := hc.2.2
        simp only [Arena.reserve,dif_pos hv,Option.some.injEq] at hh
        cases hh
        rfl
      refine ⟨hn,A.bounded ho,by simpa using hv.1, during,rfl,?_,during.peak_bound,?_⟩
      · rw [rehome_support,hd]
        intro x hx
        simp only [Finset.mem_insert,Finset.mem_singleton] at hx
        rcases hx with rfl | rfl
        · exact Finset.mem_union_left _ ho
        · simp
      · intro s m hr
        obtain ⟨C,hrc,hready,_,_⟩ := rehome_selected A during pools old q s m ho hr hb
        have he : C=during.retire old := by
          unfold Arena.release at hrc
          split at hrc
          · cases hrc; rfl
          · simp at hrc
        subst C
        exact ⟨hrc,hready⟩
  next ho => simp at h

/-- Compile an entire relocation request list, threading the actual live set
through each choice. No basis state is consulted by the compiler. -/
def planJournal (A : Arena) : List (Wire × List (Finset Wire)) →
    Option (Arena × List (Wire × Wire))
  | [] => some (A,[])
  | (old,pools)::requests => do
    let (B,fresh) ← planMove A old pools
    let (C,moves) ← planJournal B requests
    pure (C,(old,fresh)::moves)

/-- The allocation decisions generated by the compiler certify every physical
move. The transient arena is retained as evidence, including both sites. -/
inductive AllocatedJournal : Arena → List (Wire × Wire) → Arena → Prop
  | nil (A) : AllocatedJournal A [] A
  | cons {A B C : Arena} {old fresh : Wire} {moves : List (Wire × Wire)}
      (pools : List (Finset Wire)) (choice : planMove A old pools=some (B,fresh))
      (tail : AllocatedJournal B moves C) : AllocatedJournal A ((old,fresh)::moves) C

theorem planJournal_sound (requests : List (Wire × List (Finset Wire)))
    (A C : Arena) (moves : List (Wire × Wire))
    (h : planJournal A requests=some (C,moves)) : AllocatedJournal A moves C := by
  induction requests generalizing A C moves with
  | nil =>
    simp only [planJournal,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact .nil A
  | cons r rs ih =>
    rcases r with ⟨old,pools⟩
    cases hm : planMove A old pools with
    | none => simp [planJournal,hm] at h
    | some b =>
      rcases b with ⟨B,fresh⟩
      cases ht : planJournal B rs with
      | none => simp [planJournal,hm,ht] at h
      | some c =>
        rcases c with ⟨D,tail⟩
        simp [planJournal,hm,ht] at h
        rcases h with ⟨rfl,rfl⟩
        exact .cons pools hm (ih B D tail ht)

theorem AllocatedJournal.valid {A C : Arena} {moves : List (Wire × Wire)}
    (h : AllocatedJournal A moves C) :
    ∀ p∈moves,p.1≠p.2 ∧ p.1∈arenaWires ∧ p.2∈arenaWires := by
  induction h with
  | nil => simp
  | @cons A B C old fresh moves pools choice tail ih =>
    intro p hp
    rcases List.mem_cons.mp hp with rfl | hp
    · have hs := planMove_sound A B old fresh pools choice
      exact ⟨hs.1,hs.2.1,hs.2.2.1⟩
    · exact ih p hp

theorem AllocatedJournal.ready {A C : Arena} {moves : List (Wire × Wire)}
    (h : AllocatedJournal A moves C) (s : State) (m : List Bool) (hr : A.Ready s.basis) :
    C.Ready (run (repack moves) m s).basis := by
  induction h generalizing s with
  | nil => exact hr
  | @cons A B C old fresh moves pools choice tail ih =>
    obtain ⟨during,_,_,_,hs⟩ := (planMove_sound A B old fresh pools choice).2.2.2
    simp only [repack,run_append,(rehome_cost old fresh).2,List.take_zero,List.drop_zero]
    exact ih _ (hs s [] hr).2

theorem planJournal_correct (requests : List (Wire × List (Finset Wire)))
    (A C : Arena) (moves : List (Wire × Wire))
    (h : planJournal A requests=some (C,moves)) (s : State) (m n : List Bool)
    (hr : A.Ready s.basis) (row : List Wire) :
    C.Ready (run (repack moves) m s).basis ∧
    signedRegValue (repackView moves row) (run (repack moves) m s).basis=
      signedRegValue row s.basis ∧
    run (unpack moves) n (run (repack moves) m s)=s ∧
    qubitCount (repack moves)≤935 := by
  have hj := planJournal_sound requests A C moves h
  have hv := hj.valid
  have hn := fun p hp => (hv p hp).1
  exact ⟨hj.ready s m hr,repack_rows moves hn row s m,
    repack_roundtrip moves hn s m n,
    arena_program_qubits _ (repack_in_arena moves (fun p hp => (hv p hp).2))⟩

/-- A whole-arena fallback makes a single move possible whenever its source
exists and a transient destination is available. -/
theorem planMove_fallback (A : Arena) (old : Wire) (pools : List (Finset Wire))
    (ho : old∈A.live) (hp : arenaWires∈pools) (hc : A.live.card<935) :
    ∃ B fresh,planMove A old pools=some (B,fresh) := by
  obtain ⟨during,fresh,hb⟩ := A.borrowFirst_fallback pools hp hc
  exact ⟨during.retire old,fresh,by simp [planMove,ho,hb]⟩

theorem planMove_missing (A : Arena) (old : Wire) (pools : List (Finset Wire))
    (ho : old∉A.live) : planMove A old pools=none := by
  simp [planMove,ho]

/-- Each prefix also has the clean-state invariant: the inductive certificate
can be split at any chosen public boundary. -/
theorem AllocatedJournal.split {A C : Arena} {xs ys : List (Wire × Wire)}
    (h : AllocatedJournal A (xs++ys) C) :
    ∃ B,AllocatedJournal A xs B ∧ AllocatedJournal B ys C := by
  induction xs generalizing A with
  | nil => exact ⟨A,.nil A,h⟩
  | cons x xs ih =>
    cases h with
    | cons pools choice tail =>
      obtain ⟨B,hx,hy⟩ := ih tail
      exact ⟨B,.cons pools choice hx,hy⟩

theorem planJournal_prefix_ready (requests : List (Wire × List (Finset Wire)))
    (A C : Arena) (xs ys : List (Wire × Wire))
    (h : planJournal A requests=some (C,xs++ys)) (s : State) (m : List Bool)
    (hr : A.Ready s.basis) :
    ∃ B,B.Ready (run (repack xs) m s).basis ∧ B.live.card≤935 ∧
      AllocatedJournal B ys C := by
  obtain ⟨B,hx,hy⟩ := (planJournal_sound requests A C (xs++ys) h).split
  exact ⟨B,hx.ready s m hr,B.peak_bound,hy⟩

end ECDSAAdd.Arithmetic.Paper935
